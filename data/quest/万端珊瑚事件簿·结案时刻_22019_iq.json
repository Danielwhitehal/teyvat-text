{
  "quest_id": 22019,
  "chapter_num": null,
  "chapter_title": "万端珊瑚事件簿·结案时刻",
  "type": "iq",
  "route": "Bantan Sango Case File: Case-Closing Time",
  "stories": [
    {
      "story_id": 22019,
      "title": "万端珊瑚事件簿·结案时刻",
      "description": "关于稻妻城内的连环盗窃案，终于要向结案的时刻迈进了。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与珊瑚对话"
        },
        {
          "role": "珊瑚",
          "text": "…那么，就拜托两位了。"
        },
        {
          "role": "安藤",
          "text": "就交给我们了，放心吧，珊瑚小姐。"
        },
        {
          "role": "天野",
          "text": "居然在我们眼皮底下藏了这么久，真是胆大包天的家伙。"
        },
        {
          "role": "天野",
          "text": "而且，还用…那种身份。"
        },
        {
          "role": "珊瑚",
          "text": "不管怎么样，他犯案的日子今天就要到头了。龙二，我交代你的事你记住了吧？"
        },
        {
          "role": "龙二",
          "text": "是，社长。"
        },
        {
          "role": "珊瑚",
          "text": "那就好…旅行者，你也来了啊，那太好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是要去抓犯人了吗？",
              "dialogues": []
            },
            {
              "text": "是要结案了吗？",
              "dialogues": [
                {
                  "role": "珊瑚",
                  "text": "嗯，只要一切顺利，今天就可以结案了。"
                }
              ]
            }
          ]
        },
        {
          "role": "珊瑚",
          "text": "证据已经搜集充足，犯人的行为我也已经摸清了。"
        },
        {
          "role": "珊瑚",
          "text": "旅行者，你就和龙二，还有安藤先生和天野先生同行，让那个犯人伏法吧。"
        },
        {
          "role": "珊瑚",
          "text": "那家伙应该有不少同伙，有你在的话，行动成功的把握就更大了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我要做什么？",
              "dialogues": [
                {
                  "role": "珊瑚",
                  "text": "用你那无敌的气势震慑住犯人就好，免得他做出什么…不太明智的举动。"
                },
                {
                  "role": "珊瑚",
                  "text": "不过，我想这种只会偷偷摸摸的盗贼，应该也没有做出什么激烈举动的气魄。"
                }
              ]
            },
            {
              "text": "你不一起去吗？",
              "dialogues": [
                {
                  "role": "珊瑚",
                  "text": "对我来说，这桩案子已经结束了，剩下的事我就不参与了。"
                },
                {
                  "role": "珊瑚",
                  "text": "旅行者，你就去用你那无敌的气势震慑住犯人吧。免得他做出什么…不太明智的举动。"
                },
                {
                  "role": "珊瑚",
                  "text": "不过，我想这种只会偷偷摸摸的盗贼，应该也没有做出什么激烈举动的气魄。"
                }
              ]
            }
          ]
        },
        {
          "role": "珊瑚",
          "text": "如果我估计得没错，现在那家伙应该已经去了野外，准备把新一批的赃物埋在地里。"
        },
        {
          "role": "珊瑚",
          "text": "你们现在过去，应该刚好可以人赃并获。快出发吧，我在这里等你们的好消息。"
        },
        {
          "type": "subtitle",
          "text": "前往犯人所在地"
        },
        {
          "type": "subtitle",
          "text": "与龙二对话"
        },
        {
          "role": "龙二",
          "text": "发现那家伙了，果然正在埋自己的赃物…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们上！",
              "dialogues": [
                {
                  "role": "龙二",
                  "text": "等一下，旅行者，现在…还不是我们该上的时候。"
                }
              ]
            },
            {
              "text": "要上吗？",
              "dialogues": [
                {
                  "role": "龙二",
                  "text": "稍等一下，现在还不是我们该上的时候。"
                }
              ]
            }
          ]
        },
        {
          "role": "龙二",
          "text": "再等一下…嗯…应该差不多了…"
        },
        {
          "role": "安藤",
          "text": "你这家伙，在做什么！"
        },
        {
          "role": "天野",
          "text": "放下手里的东西，别动！"
        },
        {
          "role": "石川八郎",
          "text": "你、你们是怎么…"
        },
        {
          "role": "石川八郎",
          "text": "可恶…别看着了！一起上！解决掉这两个家伙，我们就远走高飞！"
        },
        {
          "role": "天野",
          "text": "几个盗宝团，居然敢这么嚣张…"
        },
        {
          "role": "龙二",
          "text": "安藤先生，天野先生，我们来帮你！"
        },
        {
          "role": "安藤",
          "text": "哦！就拜托你们了！"
        },
        {
          "role": "龙二",
          "text": "旅行者，现在我们可以上场了。"
        },
        {
          "role": "旅行者",
          "text": "搞这么麻烦…"
        },
        {
          "role": "龙二",
          "text": "这都是社长的嘱咐。"
        },
        {
          "role": "龙二",
          "text": "好了，我们上吧。"
        },
        {
          "type": "subtitle",
          "text": "打倒所有盗宝团"
        },
        {
          "type": "subtitle",
          "text": "与龙二对话"
        },
        {
          "role": "安藤",
          "text": "这下子可算是人赃并获了，多谢了龙二，还有旅行者，你也辛苦了。"
        },
        {
          "role": "安藤",
          "text": "我和天野现在就把这些盗宝团带回奉行所，剩下的事就交给我们吧。"
        },
        {
          "role": "天野",
          "text": "不过，珊瑚还真是神了，居然能这么准确地找到犯人…"
        },
        {
          "role": "安藤",
          "text": "毕竟是珊瑚嘛，这种案件，怎么想也难不住她。"
        },
        {
          "role": "安藤",
          "text": "龙二，那我们就先回奉行所了。等处理好了这家伙，我们会再登门拜谢的。"
        },
        {
          "role": "龙二",
          "text": "客气了，请慢走。"
        },
        {
          "role": "龙二",
          "text": "好了，旅行者，我们也回去向社长报告一下吧。"
        },
        {
          "type": "subtitle",
          "text": "与珊瑚对话"
        },
        {
          "role": "珊瑚",
          "text": "你们现在过去，应该刚好可以人赃并获。快出发吧，我在这里等你们的好消息。"
        },
        {
          "role": "珊瑚",
          "text": "怎么，还有什么事吗？旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你看上去情绪好像不高。",
              "dialogues": [
                {
                  "role": "珊瑚",
                  "text": "一桩没什么意思的案子，一个没什么意思的犯罪者，犯罪的手法也称不上精致，只不过是一些小机灵。"
                },
                {
                  "role": "珊瑚",
                  "text": "如果要我评价这桩案子的话…应该只能称得上「无聊」吧。"
                },
                {
                  "role": "珊瑚",
                  "text": "不过，再怎么说这也是一桩罪案，能了结掉也是好事吧。"
                }
              ]
            },
            {
              "text": "你不一起去吗？",
              "dialogues": [
                {
                  "role": "珊瑚",
                  "text": "对我来说，这桩案子已经结束了，剩下的事我就不参与了。"
                },
                {
                  "role": "珊瑚",
                  "text": "再说了，以我的身手和体格，要是被犯人反过来制服住，然后用来要挟你们就糟糕了。"
                },
                {
                  "role": "珊瑚",
                  "text": "我对自己可是有着很清醒的认知。所以，对付犯人的事就交给你们了。"
                }
              ]
            }
          ]
        },
        {
          "role": "龙二",
          "text": "…安藤和天野应该已经带着犯人回奉行所了。事情就是这样，社长。"
        },
        {
          "role": "珊瑚",
          "text": "嗯，知道了，这样解决了就好。"
        },
        {
          "role": "珊瑚",
          "text": "旅行者，你也回来了啊，这次辛苦你了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就…这么完了？",
              "dialogues": []
            },
            {
              "text": "没什么结束的实感…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珊瑚",
          "text": "毕竟人是天野和安藤带走的，有这种感觉也正常。拿着这些报酬吧，这样你多少会有点「实感」吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你的报酬呢？",
              "dialogues": [
                {
                  "role": "珊瑚",
                  "text": "我？能够帮助奉行所的大人们侦破案件，让这条街恢复平静，对我来说就是最大的报酬。"
                }
              ]
            },
            {
              "text": "你什么都不要吗？",
              "dialogues": [
                {
                  "role": "珊瑚",
                  "text": "我已经收获了「正义」，除此之外，我也不需要什么了。"
                },
                {
                  "role": "珊瑚",
                  "text": "…我是不是应该这么说比较好？"
                }
              ]
            }
          ]
        },
        {
          "role": "珊瑚",
          "text": "但老实说，这次我确实能算是「一无所获」。"
        },
        {
          "role": "珊瑚",
          "text": "既没有见识到新奇的犯罪手法，也没有听见新奇的犯罪理念。"
        },
        {
          "role": "珊瑚",
          "text": "只不过是毫无趣味的一般犯罪而已，还好没有费太大的功夫。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "珊瑚社长…",
              "dialogues": [
                {
                  "role": "珊瑚",
                  "text": "怎么？你第一次见到我这种对「犯罪」感兴趣的人吗？"
                }
              ]
            },
            {
              "text": "这就是「侦探」吗…",
              "dialogues": [
                {
                  "role": "珊瑚",
                  "text": "也不能这么一概而论。但就我个人而言，是对「犯罪」很感兴趣的。"
                }
              ]
            }
          ]
        },
        {
          "role": "珊瑚",
          "text": "这种对于「犯罪」的兴趣，也是我成为侦探的原因。"
        },
        {
          "role": "旅行者",
          "text": "…你也想「犯罪」吗？"
        },
        {
          "role": "珊瑚",
          "text": "对啊。我可是很想「犯罪」的。我想进行一场完美的，毫无破绽的「犯罪」。"
        },
        {
          "role": "珊瑚",
          "text": "但可惜的是…人在犯下罪案的时候，几乎都会留下痕迹。只要留下了痕迹，这桩罪案被侦破也是早晚的事。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "如果不是人犯的罪呢？",
              "dialogues": []
            },
            {
              "text": "如果犯人不存在呢？",
              "dialogues": []
            },
            {
              "text": "怎么清除全部痕迹呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珊瑚",
          "text": "你瞧，你也不由自主地开始思考起「犯罪」了，对不？"
        },
        {
          "role": "珊瑚",
          "text": "没什么好不安的，你也只不过是思考一下而已。"
        },
        {
          "role": "珊瑚",
          "text": "我也经常对「犯罪」进行思考，比如犯罪的手法啦，犯罪的理由啦…"
        },
        {
          "role": "旅行者",
          "text": "你思考这些做什么？"
        },
        {
          "role": "珊瑚",
          "text": "当然是为了能更好地侦办案件啦。最近我接手的案件越来越复杂，不思考可不行啊。"
        },
        {
          "role": "珊瑚",
          "text": "不过，那些案件里倒是也没有一桩能称得上是「完美犯罪」啦。"
        },
        {
          "role": "旅行者",
          "text": "那你见过「完美犯罪」吗？"
        },
        {
          "role": "珊瑚",
          "text": "见过喔。那桩「完美犯罪」…我到现在也没能找出真正的犯人。"
        },
        {
          "role": "珊瑚",
          "text": "不过，我还是相信，只要是人犯下的案件，就一定会留下痕迹，我只不过是…还没有发现那些痕迹而已。"
        },
        {
          "role": "珊瑚",
          "text": "好了，这些报酬给你，谢谢你帮我的忙，旅行者。"
        },
        {
          "role": "珊瑚",
          "text": "以后有空了记得多来转转，没空的话…嗯…也没关系。"
        },
        {
          "role": "珊瑚",
          "text": "我的直觉告诉我，我们还会有机会再一起联手的。"
        }
      ]
    }
  ]
}