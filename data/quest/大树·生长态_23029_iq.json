{
  "quest_id": 23029,
  "chapter_num": null,
  "chapter_title": "大树·生长态",
  "type": "iq",
  "route": "The Great Tree: State of Growth",
  "stories": [
    {
      "story_id": 23029,
      "title": "大树·生长态",
      "description": "雅丝敏似乎准备做什么事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与雅丝敏对话"
        },
        {
          "role": "雅丝敏",
          "text": "也差不多是时候了…"
        },
        {
          "role": "旅行者",
          "text": "你还在研究圣树根系吗？"
        },
        {
          "role": "雅丝敏",
          "text": "旅行者，每次你都来得这么巧。"
        },
        {
          "role": "雅丝敏",
          "text": "非常感谢你之前的帮助，圣树的情况非常好。"
        },
        {
          "role": "雅丝敏",
          "text": "我和拉德普讨论过后，认为这种好情况还会保持很长一段时间。"
        },
        {
          "role": "雅丝敏",
          "text": "这下我们终于可以腾出手来，为我们的论文做一些准备工作了。"
        },
        {
          "role": "雅丝敏",
          "text": "瞧，我从法尔希那边借来了一部「留影机」，正准备去记录一下圣树的情况。"
        },
        {
          "role": "雅丝敏",
          "text": "旅行者，你也帮我去一个地方记录一下圣树的全貌吧，我把地点给你标在地图上。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "你怎么不自己去？",
              "dialogues": [
                {
                  "role": "雅丝敏",
                  "text": "呃，那边…那边…太高了…"
                },
                {
                  "role": "雅丝敏",
                  "text": "我每次一个人去到很高的地方都会很害怕…总觉得会有一股风把我…或者我的文稿给吹走…"
                },
                {
                  "role": "雅丝敏",
                  "text": "平时都是法尔希去那边记录，但今天他似乎有别的事要忙，所以就只能拜托你了，旅行者。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "在指定地点，记录圣树全貌"
        },
        {
          "role": "雅丝敏",
          "text": "记录圣树全貌的事就拜托你了，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "记录圣树全貌"
        },
        {
          "type": "subtitle",
          "text": "向雅丝敏回报"
        },
        {
          "role": "雅丝敏",
          "text": "怎么样，你们记录到圣树的全貌了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经记录到了。"
        },
        {
          "role": "雅丝敏",
          "text": "喔！让我看看…"
        },
        {
          "role": "雅丝敏",
          "text": "真不错，角度很好，记录得也很清晰。"
        },
        {
          "role": "雅丝敏",
          "text": "这些报酬给你，谢谢你帮忙，旅行者。"
        },
        {
          "role": "雅丝敏",
          "text": "主干没有问题…周围的枝干轮廓也没有变…"
        },
        {
          "role": "雅丝敏",
          "text": "剩下的就等拉德普和法尔希搜集好数据，我们就可以继续下一个课题了…"
        }
      ]
    }
  ]
}