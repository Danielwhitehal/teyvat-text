{
  "quest_id": 71038,
  "chapter_num": null,
  "chapter_title": "勇气的余晖·日落当归",
  "type": "wq",
  "route": "Valor's Afterglow: Return by Sundown",
  "stories": [
    {
      "story_id": 71038,
      "title": "勇气的余晖·日落当归",
      "description": "瑾武似乎有什么紧急之事要委托，好像是和志琼相关的…",
      "dialogues": [
        {
          "role": "瑾武",
          "text": "旅行者！请你过来一下，我有件急事要拜托你！"
        },
        {
          "type": "subtitle",
          "text": "与焦急的瑾武对话"
        },
        {
          "role": "瑾武",
          "text": "又是志琼那家伙，她去回收信标了…但现在还没回来。"
        },
        {
          "role": "瑾武",
          "text": "本来我也知道她那喜欢到处乱跑的臭毛病，给她多预留了三个小时回程…可现在都已经至少五六个小时了…"
        },
        {
          "role": "瑾武",
          "text": "那个孩子很尊敬你，还请你帮忙找找她吧。我可不希望再有人在我眼皮底下出事了。"
        },
        {
          "role": "派蒙",
          "text": "嗨呀！这家伙怎么回事啦！怎么又跑丢了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好的，我这就去。",
              "dialogues": []
            },
            {
              "text": "她可能会在哪里？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑾武",
          "text": "啊，对了！真是的，最重要的信息忘记告诉你了。"
        },
        {
          "role": "瑾武",
          "text": "她可能不会走太远，但会去哪里呢…"
        },
        {
          "role": "派蒙",
          "text": "好啦，瑾武姐不要着急，我们去昨天布置信标的地方看看吧！"
        },
        {
          "role": "旅行者",
          "text": "派蒙说的没错。"
        },
        {
          "role": "瑾武",
          "text": "嗯…就这么办。如果找到那孩子的话…请尽快告诉我。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（瑾武）"
        },
        {
          "role": "瑾武",
          "text": "志琼她怎么样？你找到她了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还在找。",
              "dialogues": []
            },
            {
              "text": "还没有找到她。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑾武",
          "text": "嗯…还请尽快找到她为好，如果出什么事的话…"
        },
        {
          "type": "subtitle",
          "text": "去信标放置处寻找志琼"
        },
        {
          "type": "subtitle",
          "text": "巨柱岩宫高处"
        },
        {
          "role": "派蒙",
          "text": "志琼不在这里！"
        },
        {
          "type": "subtitle",
          "text": "荧光狭道"
        },
        {
          "role": "派蒙",
          "text": "这里没有人呢！"
        },
        {
          "type": "subtitle",
          "text": "西北遗迹附近"
        },
        {
          "role": "派蒙",
          "text": "志琼不在这里！这个急人的家伙，怎么回事呀！"
        },
        {
          "type": "subtitle",
          "text": "颠倒古城下方"
        },
        {
          "role": "派蒙",
          "text": "唔…志琼不在这里呢…"
        },
        {
          "type": "subtitle",
          "text": "击败志琼周围的怪物"
        },
        {
          "type": "subtitle",
          "text": "与志琼对话"
        },
        {
          "role": "派蒙",
          "text": "哇啊！这家伙状态太不妙啦！我们快把她带回去吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还能走路吗？",
              "dialogues": []
            },
            {
              "text": "别害怕，我带你回去。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "志琼",
          "text": "对不起…对不起…瑾武姐…还有…咳咳…"
        },
        {
          "role": "志琼",
          "text": "请你们不要…咳咳…哈…不要这样看着我…请不要对我们失望…"
        },
        {
          "role": "志琼",
          "text": "金色的城…黑色的高阙…咳咳…！天上下来的使者们离开了…"
        },
        {
          "role": "派蒙",
          "text": "不要说胡话啦！你这个人呀…"
        },
        {
          "type": "subtitle",
          "text": "与瑾武对话"
        },
        {
          "type": "subtitle",
          "text": "你们废了好大力气，才将志琼扶回营地。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "瑾武",
          "text": "海迪夫给她开了些药…志琼恢复了一点意识，但她什么也不愿意跟我说。"
        },
        {
          "role": "瑾武",
          "text": "你们知道她是怎么回事吗？好好的一个人，怎么会变成这样？"
        },
        {
          "role": "旅行者",
          "text": "我们发现她时，她被困在了黑泥里。"
        },
        {
          "role": "派蒙",
          "text": "对呀对呀，幸好我们及时把她救出来了。"
        },
        {
          "role": "瑾武",
          "text": "……"
        },
        {
          "role": "瑾武",
          "text": "算了，志琼现在最需要休息。请替我把这碗汤趁热递给她吧。"
        },
        {
          "role": "瑾武",
          "text": "虽然不太会做饭，照顾矿工的事情反正我也没少做过。还没人敢嫌弃我的手艺。"
        },
        {
          "role": "瑾武",
          "text": "好了，去吧，看看志琼好些了吗。"
        },
        {
          "role": "瑾武",
          "text": "我需要跟沐宁反映一下，志琼不能留在地下了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（瑾武）"
        },
        {
          "role": "瑾武",
          "text": "……"
        },
        {
          "role": "瑾武",
          "text": "…？啊，抱歉，我在想事情。抱歉…"
        },
        {
          "role": "瑾武",
          "text": "志琼那孩子，我要好好和她谈谈才行…"
        },
        {
          "role": "瑾武",
          "text": "我在矿上工作很久了，不是没有见过这样的孩子…"
        },
        {
          "role": "瑾武",
          "text": "有太多不成熟的孩子，把冒险当做了不得的目标去追逐，最终却落得愿望破碎离散的下场…为此追悔莫及。"
        },
        {
          "role": "瑾武",
          "text": "但我又能评判什么呢？唉…扎根在石缝里，长在岩间的琉璃袋，怎么去评价鸟儿的活法呢？"
        },
        {
          "role": "瑾武",
          "text": "但是，我怎么放心…咳咳，或许阻拦她终究是不对的…她已经是能照顾自己的大人了，是吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没错，她不会有事的。",
              "dialogues": []
            },
            {
              "text": "她不会为自己的选择后悔的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑾武",
          "text": "是啊…希望如此，希望如此。"
        },
        {
          "type": "subtitle",
          "text": "将瑾武的汤交给志琼"
        },
        {
          "role": "志琼",
          "text": "咳咳…！咳咳…抱歉…"
        },
        {
          "role": "派蒙",
          "text": "你也知道抱歉哇！到处乱跑的时候怎么就没想过要麻烦我们呢！"
        },
        {
          "role": "旅行者",
          "text": "好了，派蒙…"
        },
        {
          "role": "志琼",
          "text": "咳咳…哈…是…失足，是不小心…失足了…有点好笑…哈哈…对吧？"
        },
        {
          "role": "派蒙",
          "text": "好笑什么啦！你就不拿自己的生命当回事吗！"
        },
        {
          "role": "旅行者",
          "text": "你需要休息，瑾武姐给你做了汤。"
        },
        {
          "type": "subtitle",
          "text": "交付{{图标|瑾武的汤}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "志琼",
          "text": "是瑾武姐的手艺…？谢谢你们…请替我谢谢瑾武姐她们。"
        },
        {
          "role": "志琼",
          "text": "没事的，我睡一觉就会好多了…"
        },
        {
          "role": "志琼",
          "text": "实在对不起…咳咳…请你们过一阵子再回来吧…"
        }
      ],
      "collapse_ranges": [
        [
