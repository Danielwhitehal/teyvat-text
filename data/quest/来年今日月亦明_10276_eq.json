{
  "quest_id": 10276,
  "chapter_num": "",
  "chapter_title": "来年今日月亦明",
  "type": "eq",
  "route": "Next Year's Moon, Just as Bright",
  "stories": [
    {
      "story_id": 40252,
      "title": "来年今日月亦明",
      "description": "节日尚未结束，蓝砚也终于有时间带你们逛一逛了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后（12:00-16:00）"
        },
        {
          "type": "subtitle",
          "text": "前往拜访蓝砚"
        },
        {
          "role": "派蒙",
          "text": "呀，蓝砚被长辈们围起来了！"
        },
        {
          "role": "凝光",
          "text": "我昨天刚刚收到战报，在璃月各地作乱的邪祟突然受到了无形的压制，驱除它们的过程比之前轻松了许多。"
        },
        {
          "role": "凝光",
          "text": "有此助力，派遣到各处的千岩军迅速完成了任务，因此也可以提前回家，享受节日。"
        },
        {
          "role": "凝光",
          "text": "多方询问之后，我才了解到这份助力是源于蓝砚施展的奇术，因此我特地来道谢。"
        },
        {
          "role": "凝光",
          "text": "蓝氏不愧为方士世家，真是人才辈出。"
        },
        {
          "role": "蓝舆",
          "text": "凝光大人过奖了，这是蓝氏一族分内的事。"
        },
        {
          "role": "蓝家大姑",
          "text": "话说回来，这孩子以前总是贪玩，最近是开了窍吗？"
        },
        {
          "role": "蓝家大叔",
          "text": "也该让她到宗家去认真学习一下了。"
        },
        {
          "role": "蓝砚",
          "text": "其实，是胡堂主和重云在帮我。"
        },
        {
          "role": "凝光",
          "text": "我知道，胡堂主和重云那边，我也已登门道谢。他们都对我说，多亏了蓝砚的点子，此奇术才能被成功施放。"
        },
        {
          "role": "凝光",
          "text": "这份赞誉，你当得起。"
        },
        {
          "role": "蓝砚",
          "text": "这份赞誉要把我拉进学堂了…"
        },
        {
          "role": "派蒙",
          "text": "那个…不好意思，我们是蓝砚的朋友，想找她谈一些事，现在方便吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯…也算是比较重要的事啦。"
        },
        {
          "role": "蓝舆",
          "text": "既然是比较重要的事…凝光大人，可否让蓝砚暂且离席？"
        },
        {
          "role": "蓝家大姑",
          "text": "这不合适吧？凝光大人专程来拜访，能这样中途离席吗？"
        },
        {
          "role": "凝光",
          "text": "无妨，我刚刚已经向蓝砚表达了谢意。"
        },
        {
          "role": "凝光",
          "text": "另外，来请蓝砚的可是那位旅行者，他们要谈的事肯定相当重要，耽搁了可不好。"
        },
        {
          "role": "蓝家大叔",
          "text": "那就请您多担待了。"
        },
        {
          "role": "蓝砚",
          "text": "多谢大伯，大姑，大叔，还有凝光小姐！"
        },
        {
          "role": "蓝砚",
          "text": "呼…嘻嘻，你们来的真及时，多谢了。"
        },
        {
          "role": "派蒙",
          "text": "我当时好紧张…"
        },
        {
          "role": "蓝砚",
          "text": "我也很紧张，宗家的长辈大多是一些十分严肃的人，我一直不擅长和他们相处…"
        },
        {
          "role": "钟离",
          "text": "蓝氏宗家的成员大多很看重「责任」二字，难免行事严肃，谁又能料想到他们的祖师爷是一个放荡不羁的人呢？"
        },
        {
          "role": "派蒙",
          "text": "钟离？"
        },
        {
          "role": "旅行者",
          "text": "你怎么来这里了？"
        },
        {
          "role": "钟离",
          "text": "偶然路过，叨扰各位了。"
        },
        {
          "role": "蓝砚",
          "text": "怎么会呢，钟离先生。听上去，您很了解我家祖师爷？"
        },
        {
          "role": "钟离",
          "text": "略有耳闻罢了。正巧，我有个好消息要讲给蓝砚姑娘听。"
        },
        {
          "role": "钟离",
          "text": "昨晚你施术之后，璃月各地的燕子似乎都受到了影响，不再像之前那样行色匆匆了。"
        },
        {
          "role": "钟离",
          "text": "虽然仍旧难以被人看见，但假以时日，肯定会有更多燕子回到沉玉谷，重新筑巢。"
        },
        {
          "role": "蓝砚",
          "text": "真的？这确实是个好消息！我一开始也只是想看燕子筑巢而已，没想到后来做成这么多事。"
        },
        {
          "role": "钟离",
          "text": "想来那万象风角灵官也是如此吧，最初他只是喜欢玄鸟仙子的眼眸。"
        },
        {
          "role": "钟离",
          "text": "然而看久了那双眼眸，便连那倒映其中的璃月山水也难以忘怀了。"
        },
        {
          "role": "蓝砚",
          "text": "钟离先生，您怎么知道燕子的事？"
        },
        {
          "role": "钟离",
          "text": "是旅行者向我提起了你的事，我对璃月的飞鸟族类略知一二，于是便留意了一下。"
        },
        {
          "role": "蓝砚",
          "text": "那您真是有心了。"
        },
        {
          "role": "钟离",
          "text": "那就先别过了，我还要到附近的集市采购一些茶叶。堂主近日心情不错，准我多花一些摩拉。"
        },
        {
          "role": "派蒙",
          "text": "那你可要珍惜这次机会。"
        },
        {
          "role": "蓝砚",
          "text": "刚刚没问，旅行者和派蒙找我有什么事？"
        },
        {
          "role": "派蒙",
          "text": "这不是终于有机会享受节日了吗？我们就想找蓝砚再带我们逛一逛。"
        },
        {
          "role": "蓝砚",
          "text": "也对，上一次想带着你们逛一逛时，碰上了自家祖师爷…不如先去美食街看看，派蒙最喜欢这个吧？"
        },
        {
          "role": "派蒙",
          "text": "当然，对了，下次逐月节还办这个活动吗？"
        },
        {
          "role": "蓝砚",
          "text": "那就不一定了，经历过这几天的事，你应该知道逐月节的活动一直在变化。保不准，将来的某年就跟美食完全没关系了。"
        },
        {
          "role": "派蒙",
          "text": "怎么能这样？那还算是逐月节吗？"
        },
        {
          "role": "蓝砚",
          "text": "嗯…那怎样才算是逐月节呢？"
        },
        {
          "role": "派蒙",
          "text": "这个…反正好吃的和好朋友总得都有吧？"
        },
        {
          "role": "蓝砚",
          "text": "那派蒙只要记得来遗珑埠就好，香菱和爱可菲已经约定好，每年都来遗珑埠切磋厨艺。"
        },
        {
          "role": "蓝砚",
          "text": "到时候，无论过不过节，好吃的和好朋友都不会缺。"
        },
        {
          "role": "派蒙",
          "text": "这还差不多。"
        },
        {
          "role": "蓝砚",
          "text": "来吧，节日还没结束呢！"
        }
      ]
    }
  ]
}