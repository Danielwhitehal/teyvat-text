{
  "quest_id": 74675,
  "chapter_num": null,
  "chapter_title": "进站！",
  "type": "wq",
  "route": "The Arrival of a...!",
  "stories": [
    {
      "story_id": 74675,
      "title": "进站！",
      "description": "小露米埃尔先生似乎对映影有着独到的见解…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与工作人员对话"
        },
        {
          "role": "小露米埃尔",
          "text": "美好的一天，不是吗？"
        },
        {
          "role": "小露米埃尔",
          "text": "出名到你们这种程度，应该不断会有人向你们递名片吧。"
        },
        {
          "role": "派蒙",
          "text": "唔…你认识我们？旅行者，这个孩子好老成啊。"
        },
        {
          "role": "小露米埃尔",
          "text": "仅仅因为对面年纪尚轻就轻视别人，是无知者才会犯的毛病，我想两位不至于如此肤浅。"
        },
        {
          "role": "小露米埃尔",
          "text": "尽管我无意自夸，但我和兄长是本地小有名气的映影导演，大家更习惯称呼我为小露米埃尔先生。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好。",
              "dialogues": []
            },
            {
              "text": "你也要给我们名片吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "小露米埃尔",
          "text": "没错，我对你们的冒险经历很感兴趣。在我们这行里，非凡的故事永远都会受到追捧。"
        },
        {
          "role": "小露米埃尔",
          "text": "既然你们还不认识我，那我就先做个自我介绍吧。"
        },
        {
          "role": "小露米埃尔",
          "text": "我和我的兄长已经合作拍摄映影很久了，也有过几部比较出名的片子，或许你们看过《工厂大门》（卢米埃尔兄弟拍摄的历史上第一部被公开放映的电影）…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "小露米埃尔",
          "text": "哦，没关系，那么《进站》呢？"
        },
        {
          "role": "派蒙",
          "text": "也没有。"
        },
        {
          "role": "小露米埃尔",
          "text": "……"
        },
        {
          "role": "小露米埃尔",
          "text": "啊，这样啊。"
        },
        {
          "role": "小露米埃尔",
          "text": "…那也不足为奇，我们兄弟作为影人的道路还很长，以后会拍出更多家喻户晓的映影。"
        },
        {
          "role": "小露米埃尔",
          "text": "映影的制作，从构思故事、演员表演、摄影师和导演合作拍摄，再到处理成片，都是相当有趣的过程。"
        },
        {
          "role": "小露米埃尔",
          "text": "在这其中，我认为拍摄过程是最具有技术性的部分。"
        },
        {
          "role": "小露米埃尔",
          "text": "拍摄重点的取舍，决定了观者将得到怎样的信息、感受到怎样的氛围…"
        },
        {
          "role": "小露米埃尔",
          "text": "虽然旁白也很重要，但我们不能指望只靠旁白来构成一个故事。"
        },
        {
          "role": "小露米埃尔",
          "text": "四个镜头！我一直相信，只要四个镜头就可以构成一个最小的叙事单元。"
        },
        {
          "role": "小露米埃尔",
          "text": "在这四个镜头之内，天才可以创造奇迹。"
        },
        {
          "role": "小露米埃尔",
          "text": "两位想试试看吗？借这个机会，来感受一下映影的魅力吧！"
        },
        {
          "role": "派蒙",
          "text": "那我们该怎么做？"
        },
        {
          "role": "小露米埃尔",
          "text": "很简单。我可以为你们提供一些已经成形的短幅情节作为拍摄主题。"
        },
        {
          "role": "小露米埃尔",
          "text": "重点是尝试镜头与旁白的多种处理方式，从而完成几部短篇映影的拍摄。二位有兴趣吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来很有趣。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "小露米埃尔",
          "text": "太好了！那么二位准备好之后，随时可以前往我挑好的拍摄地点尝试拍摄，我也会针对拍摄好的成片提出反馈。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（小露米埃尔）"
        },
        {
          "role": "小露米埃尔",
          "text": "怎么样，要尝试拍摄映影吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要试试。",
              "dialogues": [
                {
                  "role": "小露米埃尔",
                  "text": "很好，我已经挑好拍摄场景，演员也已经就位，就等两位去片场开拍了。"
                }
              ]
            },
            {
              "text": "关于你的兄长…",
              "dialogues": [
                {
                  "role": "小露米埃尔",
                  "text": "露米埃尔年长我很多，不过这不是问题，我们兄弟俩合作无间。"
                },
                {
                  "role": "小露米埃尔",
                  "text": "拍摄《进站》和《工厂大门》的时候，我们还没什么名气。"
                },
                {
                  "role": "小露米埃尔",
                  "text": "所有的事情都是我们兄弟俩一起完成的，因为当时没人愿意给不出名的电影爱好者做助手，哈哈。"
                },
                {
                  "role": "小露米埃尔",
                  "text": "如果你有兴趣的话，可以去看看这两部映影。"
                }
              ]
            },
            {
              "text": "还没准备好。",
              "dialogues": [
                {
                  "role": "小露米埃尔",
                  "text": "没关系，我能理解，好的作品需要时间沉淀。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          28,
          30
        ]
      ]
    }
  ]
}