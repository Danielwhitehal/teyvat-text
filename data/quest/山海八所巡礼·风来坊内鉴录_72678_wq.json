{
  "quest_id": 72678,
  "chapter_num": null,
  "chapter_title": "山海八所巡礼·风来坊内鉴录",
  "type": "wq",
  "route": "Eight Locales Over Mountains and Seas: Wanderer's Appraisal",
  "stories": [
    {
      "story_id": 72678,
      "title": "山海八所巡礼·风来坊内鉴录",
      "description": "与吉法师的旅行接近尾声了。之前答应了五百藏「带吉法师去八个地方修行」的请求，最后一站就去「风龙废墟」吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往风龙废墟"
        },
        {
          "role": "「吉法师」",
          "text": "好大的城市，但是…感觉，好荒凉。"
        },
        {
          "role": "派蒙",
          "text": "以前，我和旅行者、还有很多同伴一起，曾经在这里和「风魔龙」战斗呢。"
        },
        {
          "role": "「吉法师」",
          "text": "是那种，身体大大，翅膀飞飞、牙齿尖尖，很可怕的龙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "其实没有那么可怕。",
            "其实也很漂亮。"
          ]
        },
        {
          "role": "派蒙",
          "text": "吉法师还记得，之前我们在蒙德城看到的风神像吗？"
        },
        {
          "role": "「吉法师」",
          "text": "风神像…？"
        },
        {
          "role": "派蒙",
          "text": "就是那个，好高好高的石头像啦。"
        },
        {
          "role": "「吉法师」",
          "text": "呶！记得。风神的手好大。"
        },
        {
          "role": "派蒙",
          "text": "「风魔龙」是风神的好朋友呢！以前，风神也是从这个「城市」来的…"
        },
        {
          "role": "「吉法师」",
          "text": "喔！"
        },
        {
          "role": "「吉法师」",
          "text": "但是，如果风风龙很大，那要怎么进来呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "以前好像也有谁问过一样的问题…",
            "是「风魔龙」啦。"
          ]
        },
        {
          "role": "派蒙",
          "text": "啊，这个派蒙知道！因为它不用像我们这样，从那边走…"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师想到了。风风龙会飞，所以不用走进来。"
        },
        {
          "role": "派蒙",
          "text": "可、可恶…"
        },
        {
          "role": "「吉法师」",
          "text": "呶？派蒙，好像有点不开心？"
        },
        {
          "role": "派蒙",
          "text": "嗯…这些之后再说，先在这里拍照纪念吧！吉法师，不要乱动喔！"
        },
        {
          "type": "subtitle",
          "text": "为吉法师拍照"
        },
        {
          "type": "subtitle",
          "text": "与吉法师对话"
        },
        {
          "role": "派蒙",
          "text": "吉法师站好！"
        },
        {
          "role": "「吉法师」",
          "text": "呶…很好看…"
        },
        {
          "role": "派蒙",
          "text": "吉法师，你怎么啦？"
        },
        {
          "role": "「吉法师」",
          "text": "这个城市很荒凉，感觉有点难过，不知道为什么。奇怪。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我也觉得。",
            "吉法师真奇怪！"
          ]
        },
        {
          "role": "派蒙",
          "text": "接下来，我们就向「城市」的中心前进吧。"
        },
        {
          "type": "subtitle",
          "text": "向风龙废墟的高塔前进"
        },
        {
          "role": "「吉法师」",
          "text": "呜呶呶…风好大…"
        },
        {
          "role": "派蒙",
          "text": "这里的风墙，是过不去的喔！要绕路走才行。"
        },
        {
          "role": "派蒙",
          "text": "吉法师，跟着我们慢慢从旁边绕上去吧。"
        },
        {
          "type": "subtitle",
          "text": "沿着风龙废墟的高塔前进"
        },
        {
          "role": "派蒙",
          "text": "终于上来了！"
        },
        {
          "role": "派蒙",
          "text": "这里的视线，比下面好多了。你看，那边就是我们来的地方。"
        },
        {
          "role": "「吉法师」",
          "text": "派蒙很喜欢高的地方？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在高的地方视野很好，滑翔也方便。",
              "dialogues": []
            },
            {
              "text":  "「笨蛋和烟…」",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "喂！才不是这么回事啦。在高的地方，视野很好，而且空气也比较清新。"
        }
              ]
            }     
          ]
        },
        {
          "role": "「吉法师」",
          "text": "风风龙睡在这个塔里面吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯，在里面睡了好久好久。"
        },
        {
          "role": "派蒙",
          "text": "虽然旅行者和「风魔龙」战斗，但是它不是坏龙。"
        },
        {
          "role": "派蒙",
          "text": "只是遇到了难过的事情，受了伤害，又被坏人骗了，所以以为，风神朋友不要它了。"
        },
        {
          "role": "「吉法师」",
          "text": "呶…后来呢？"
        },
        {
          "role": "派蒙",
          "text": "后来呀…旅行者，你还记得吗？"
        },
        {
          "role": "旅行者",
          "text": "我们在战斗中，净化了「毒血」。"
        },
        {
          "role": "派蒙",
          "text": "但是，战斗的平台也坍塌了。本来，我们，还有风神都要掉到好深好深、好黑好黑的地方去…"
        },
        {
          "role": "「吉法师」",
          "text": "呶！好可怕…那么，派蒙和旅行者怎么办？飞出来？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text":  "特瓦林救了我们。载着我们飞走了。",
              "dialogues": [
                {
          "role": "「吉法师」",
          "text": "特…？"
        },
        {
          "role": "派蒙",
          "text": "就是「风魔龙」啦。"
        }
              ]
            },
            {
              "text": "风魔龙救了我们。载着我们飞走了。",
              "dialogues": []
            }     
           
            
          ]
        },
        
        {
          "role": "派蒙",
          "text": "「风魔龙」是有自己的名字的喔，就像吉法师、派蒙和旅行者一样。它叫特瓦林。"
        },
        {
          "role": "派蒙",
          "text": "开始，特瓦林受了伤害、又被坏人骗了，非常非常生气，还到蒙德城去大闹了一场。大家都觉得它是坏龙，所以叫它「风魔龙」。"
        },
        {
          "role": "派蒙",
          "text": "后来，我们打倒了坏人，又和风神一起净化了污染它的毒血，它才知道，风神其实没有抛弃它。"
        },
        {
          "role": "「吉法师」",
          "text": "喔！特…风风龙就变好了。"
        },
        {
          "role": "派蒙",
          "text": "没错！所以说呀…派蒙今天带吉法师到这里来修行，就是想告诉吉法师特瓦林的故事。"
        },
        {
          "role": "派蒙",
          "text": "吉法师长大以后，也会遇到误解、遇到伤害、遇到难过的事情。"
        },
        {
          "role": "派蒙",
          "text": "但是，也一定不能变成坏人。因为，「风向是会转变的」…"
        },
        {
          "role": "旅行者",
          "text": "总有一天，会吹向更光明的方向。"
        },
        {
          "role": "「吉法师」",
          "text": "呶？"
        },
        {
          "role": "旅行者",
          "text": "对吉法师来说，会不会太难懂？"
        },
        {
          "role": "「吉法师」",
          "text": "好像懂了，但又不太懂呶…"
        },
        {
          "role": "「吉法师」",
          "text": "不过，吉法师知道是很重要的事情。派蒙和旅行者说的事情，不会忘记的。"
        },
        {
          "role": "派蒙",
          "text": "嗯！那就没辜负我花了好长好长时间想的故事！"
        },
        {
          "role": "派蒙",
          "text": "不过，吉法师也不要太贪玩、太调皮，被人封印起来喔。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "吉法师这次的修行也告一段落了。",
            "五百藏的委托也算是完成了吧。"
          ]
        },
        {
          "role": "「吉法师」",
          "text": "呜呶呶…"
        },
        {
          "role": "派蒙",
          "text": "别这么难过嘛！要笑着回去，这样五百藏才会高兴！"
        },
        {
          "role": "派蒙",
          "text": "好啦，派蒙和旅行者也要完成好向导最后的职责啦…"
        },
        {
          "role": "派蒙",
          "text": "那就是，把吉法师送回五百藏身边。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我们走吧。",
            "我们走吧，吉法师。"
          ]
        },
        {
          "role": "旅行者",
          "text": "我们走吧。"
        },
        {
          "role": "「吉法师」",
          "text": "呶。"
        },
        {
          "type": "subtitle",
          "text": "回到镇守之森，拜访五百藏"
        },
        {
          "role": "派蒙",
          "text": "五百藏，我们回来啦！"
        },
        {
          "role": "五百藏",
          "text": "喔，回来啦！吉法师，修行的成果如何？"
        },
        {
          "role": "「吉法师」",
          "text": "咔嚓咔嚓，砰砰！"
        },
        {
          "role": "五百藏",
          "text": "呶哈哈哈，真不错！"
        },
        {
          "role": "派蒙",
          "text": "呜哇，又听不懂吉法师说的话了…"
        },
        {
          "role": "派蒙",
          "text": "我们还拍了好多好多照片。五百藏，你看…"
        },
        {
          "type": "subtitle",
          "text": "将这段时间一同旅行时，为吉法师拍的照片，一张张交给了五百藏。连同旅行中遇到的事情，也说给了五百藏听。"
        },
        {
          "role": "派蒙",
          "text": "…就这样，我们完成了五百藏「带吉法师去八个地方修行」的要求。"
        },
        {
          "role": "五百藏",
          "text": "嗯！不愧是吾辈看上的人，真不错。假如你们这些小辈是狸子，那想必也能成为名震天下的大妖狸。可能加起来有吾辈一半强吧！"
        },
        {
          "role": "派蒙",
          "text": "（听起来也没有很强嘛…）"
        },
        {
          "role": "派蒙",
          "text": "不过，既然任务完成了，我们也该走了。"
        },
        {
          "role": "「吉法师」",
          "text": "呜呶呶。"
        },
        {
          "role": "派蒙",
          "text": "好啦好啦，别这样。派蒙再教吉法师一件事！"
        },
        {
          "role": "派蒙",
          "text": "和朋友告别的时候，要笑着告别！这样的话，下次再见的时候，会更加开心！"
        },
        {
          "role": "五百藏",
          "text": "…唔？好的，没问题。交给吾辈吧。"
        },
        {
          "role": "五百藏",
          "text": "吉法师说，「知道了。白毛。」"
        },
        {
          "role": "派蒙",
          "text": "欸？难道…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "吉法师又不能说话了？",
            "我们又听不懂吉法师说的话了？"
          ]
        },
        {
          "role": "五百藏",
          "text": "过了这么久时间，妖狸饭的效果也该消退了嘛。"
        },
        {
          "role": "五百藏",
          "text": "哼，吾辈要是没被封印在石头里的话，想要让你们一直都能听懂妖狸说的话，也是易如…"
        },
        {
          "role": "五百藏",
          "text": "…嗯？好，吾辈帮你传达一下。"
        },
        {
          "role": "五百藏",
          "text": "「吉法师要努力修行。」"
        },
        {
          "role": "五百藏",
          "text": "「变成像五百藏那样的大妖狸。」"
        },
        {
          "role": "五百藏",
          "text": "…呶？你这家伙，口气不小。呶哈哈哈，有吾辈当年的气魄。"
        },
        {
          "role": "五百藏",
          "text": "「那样，白毛、黄毛不用吃妖狸的饭，也可以听懂吉法师说话。」"
        },
        {
          "role": "派蒙",
          "text": "…嗯！我会等着，下次和吉法师一起修行。"
        },
        {
          "role": "旅行者",
          "text": "吉法师要加油。"
        },
        {
          "role": "旅行者",
          "text": "不要被人封印了喔。"
        },
        {
          "role": "五百藏",
          "text": "呶？！"
        },
        {
          "role": "「吉法师」",
          "text": "呶！"
        },
        {
          "role": "五百藏",
          "text": "算了，看你们这些人类带吉法师修行的份上，吾辈就不计较了。"
        },
        {
          "role": "五百藏",
          "text": "对了。之前有个叫歌麿的家伙，在镇守之森里画被封印的狸子，还留下了一些画稿。"
        },
        {
          "role": "五百藏",
          "text": "就给你们吧。如果想念我们妖狸一族的俊朗模样，就看看这些画像吧！"
        },
        {
          "role": "五百藏",
          "text": "唉，如果你们是妖狸就好了…"
        },
        {
          "role": "旅行者",
          "text": "…那我们早该变成石头了。"
        },
        {
          "role": "五百藏",
          "text": "哼，也对。没啥事就快走吧，吾辈，还要教吉法师法术呢。"
        }
      ]
    }
  ]
}