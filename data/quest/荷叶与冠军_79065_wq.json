{
  "quest_id": 79065,
  "chapter_num": null,
  "chapter_title": "荷叶与冠军",
  "type": "wq",
  "route": "The Lotus Leaf and the Champion",
  "stories": [
    {
      "story_id": 79065,
      "title": "荷叶与冠军",
      "description": "雨歌塘里，似乎正在举办一场盛大的比赛…",
      "dialogues": [
        {
          "role": "奥雷卢",
          "text": "…好啊！各位后腿健壮的先生小姐们，太好了！跳跃比赛真是如火如荼！"
        },
        {
          "role": "奥雷卢",
          "text": "刚才咱们看到无畏的埃斯唐普展现出了自己的实力！"
        },
        {
          "role": "奥雷卢",
          "text": "这位先生着实厉害，跳得又稳又远！不愧是冠军的热门候选！"
        },
        {
          "role": "奥雷卢",
          "text": "但接下来…是万众期待！无与伦比的…"
        },
        {
          "role": "奥雷卢",
          "text": "福罗贝尔！"
        },
        {
          "role": "奥雷卢",
          "text": "…咳…到底谁能夺得冠军，担下迎接公主的殊荣与重担呢？"
        },
        {
          "type": "subtitle",
          "text": "未完成任务「森林与公主」"
        },
        {
          "type": "subtitle",
          "text": "完成任务「森林与公主」"
        },
        {
          "role": "派蒙",
          "text": "他们要迎接公主？等等…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道西梅公主要找的其实是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不、不会这么巧吧？但是…如果真是这样，那西梅公主殿下就可以省下好多功夫了！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们也算是尽到了「铃风卫士」的职责呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "总之，先看看情况吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！我们两个都集中精神，好好观察一下吧。"
        },
        {
          "role": "奥雷卢",
          "text": "在最终的决赛开始前，让咱们稍事休息，给两位选手一些休息时间。"
        },
        {
          "role": "奥雷卢",
          "text": "周围的比赛场地也会暂时向各位开放，尽情去跳跃吧，这就是雨歌塘存在的意义！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（奥雷卢&福罗贝尔&埃斯唐普）"
        },
        {
          "role": "奥雷卢",
          "text": "福罗贝尔，我懂你现在的紧张心情，但这可是众蛙瞩目的总决赛，你…"
        },
        {
          "role": "福罗贝尔",
          "text": "抱歉，奥雷卢先生。但是我…我…"
        },
        {
          "role": "埃斯唐普",
          "text": "请别责怪他。先生，我请您给他一些休息时间。"
        },
        {
          "role": "埃斯唐普",
          "text": "毕竟，福罗贝尔可要好好想想，用什么姿态来给所有人一个惊喜。"
        },
        {
          "role": "福罗贝尔",
          "text": "埃斯唐普…你跳得足够好了，我觉得…"
        },
        {
          "role": "埃斯唐普",
          "text": "得了吧老兄，收住你嘴边的话。你待会一定能跳出一个新纪录，相信我。"
        },
        {
          "role": "埃斯唐普",
          "text": "至于现在，就好好休息吧。你需要时间。"
        },
        {
          "role": "福罗贝尔",
          "text": "好吧…你说的对，好朋友。我的确需要时间…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（好心的纸蛙）"
        },
        {
          "role": "好心的纸蛙",
          "text": "唉，只希望大家都能跳出自己最好的成绩，就算是落进水塘也不要气馁…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（忧郁的纸蛙）"
        },
        {
          "role": "忧郁的纸蛙",
          "text": "跳跃到最高处的纸蛙，必然向下坠落…希望他们已经做好了准备…"
        },
        {
          "type": "subtitle",
          "text": "分支——兴奋的纸蛙"
        },
        {
          "type": "subtitle",
          "text": "与兴奋的纸蛙对话"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "你们好呀，尊敬的客人，你们看着并不像蛙。"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "但是…欢迎你们来雨歌塘，祝您的腿好！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于这场比赛…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兴奋的纸蛙",
          "text": "如您所见和所听的，这场比赛旨在选拔出最擅长跳跃的纸蛙。"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "参赛的选手们会经过预选赛，小组赛和淘汰赛，只有闯过所有比赛的纸蛙，才能在总决赛中竞争冠军头衔。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…听起来好复杂…"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "不复杂，只要你踏上赛场，除却面前的挑战外，其他都不复杂！"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "二位客人，如果你们愿意，也可以在这里体验一下「弹跳竞赛」！"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "这场比赛意在测试选手们跳跃时的稳定性和前进速度。我正想在这里练习一下，再参加下次的比赛呢。"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "不过…我的实力还不够，单凭我自己跳不了多好。二位客人，你们愿意协助我吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里没有比赛了吗？",
              "dialogues": [
                {
                  "role": "兴奋的纸蛙",
                  "text": "当然，现在赛程已经到了总决赛，其余赛场都开放给我们练习了。"
                },
                {
                  "role": "兴奋的纸蛙",
                  "text": "保持练习，保持跳跃，保持竞赛。哈！这样才能跳得更好！"
                }
              ]
            },
            {
              "text": "我、我不太会跳跃…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我…我会飞。我不用跳来跳去啦。"
                },
                {
                  "role": "兴奋的纸蛙",
                  "text": "不，不。重点不在于擅长与否，或者是需不需要。"
                },
                {
                  "role": "兴奋的纸蛙",
                  "text": "重点在于「竞赛」。保持竞争精神，这样才能时刻保持活力。"
                }
              ]
            }
          ]
        },
        {
          "role": "兴奋的纸蛙",
          "text": "来吧客人！你们肯定也会喜欢「弹跳竞赛」， 我保证！"
        },
        {
          "type": "subtitle",
          "text": "与兴奋的纸蛙一同练习"
        },
        {
          "role": "纸蛙（气泡文字）",
          "text": "先来这边吧！"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "马上就要到终点了！"
        },
        {
          "type": "subtitle",
          "text": "与兴奋的纸蛙对话"
        },
        {
          "role": "派蒙",
          "text": "呼啊，这游戏还挺好玩的，嘿嘿…搞得我也想要跳一跳了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那派蒙来吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我…我在空中也能做出跳跃的动作！差不多也是一样的嘛…"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "哈哈哈，我就知道你们一定会喜欢「弹跳竞赛」的！"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "但咱们刚才只是在做「游戏」，距离真正的「竞赛」还差得远。"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "能够参加「竞赛」的纸蛙，无一不是好手中的好手，冠军中的冠军。"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "而这次比赛，会决定他们谁更出色，谁更适合去迎接公主…太让我兴奋了！"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "哦！抱歉，两位客人，真是不好意思…每次提起福罗贝尔，我就会不由自主地说个不停。"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "毕竟我们举办这么多比赛，就是为了选出跳得最稳，最远，最高，最厉害的纸蛙去迎接公主！"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "距离总决赛开始应该还有一段时间，您可以再去周围看看。"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "开赛时，奥雷卢会用他的大嗓门提醒所有人，请务必留心，到时候去占个好位置。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（兴奋的纸蛙）"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "福罗贝尔一定会拿下总决赛的冠军，我相信他！"
        },
        {
          "type": "subtitle",
          "text": "分支——沉稳的纸蛙"
        },
        {
          "type": "subtitle",
          "text": "与沉稳的纸蛙对话"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "欢迎，两位客人。想必您也是来观赛的，欢迎来到雨歌塘。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "您来得很巧，但也不巧。比赛已经到了尾声，只剩下了毫无悬念的决赛。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "您一定听说过福罗贝尔和埃斯唐普，他们的跳跃技巧都十分高超。但按照我的经验，福罗贝尔定会夺下冠军。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "福罗贝尔在跳跃上的造诣远超其他纸蛙，也夺下了无数冠军，是无可置疑的最强选手。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "他有着最健壮的双腿，最灵活的头脑，最坚韧的精神…最重要的是，他一直不断将自己的跳跃技巧慷慨地分享给所有蛙。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "而埃斯唐普和我一样，也是随他学习的纸蛙之一…我们尊敬他，信任他，也愿意相信他，能够在这次的跳跃比赛里再创佳绩。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "趁着决赛还没开始，我还想要在这里继续练习一会，准备参加下次比赛。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "如果二位愿意的话，我们可以一起训练。也许您还能想出些好主意，帮助我跳得更好呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在选出迎接公主的纸蛙后…",
              "dialogues": []
            },
            {
              "text": "你们还会接着举办比赛吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "沉稳的纸蛙",
          "text": "当然。这场比赛的意义，并不仅仅是选拔出迎接公主的纸蛙。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "更重要的是「竞赛」本身，和它教会我们的那些品德。比如自信、坚韧、勇敢…"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "只有理解并且贯彻那些品德的纸蛙，才能够夺得「冠军」。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "来吧，二位客人。呵呵…看看您能不能感受到这些运动中所蕴含着的「品德」。"
        },
        {
          "type": "subtitle",
          "text": "与沉稳的纸蛙一同练习"
        },
        {
          "role": "沉稳的纸蛙（气泡文字）",
          "text": "让我先来！"
        },
        {
          "role": "纸蛙（气泡文字）",
          "text": "真，真的？可是你上次…"
        },
        {
          "type": "subtitle",
          "text": "静观纸蛙的再次挑战",
          "narration": true
        },
        {
          "role": "沉稳的纸蛙（气泡文字）",
          "text": "这下撞得真糟糕…"
        },
        {
          "role": "纸蛙（气泡文字）",
          "text": "打起精神来啊，老兄。"
        },
        {
          "role": "沉稳的纸蛙（气泡文字）",
          "text": "再来一次，这次准能行。"
        },
        {
          "type": "subtitle",
          "text": "挑战失败"
        },
        {
          "role": "沉稳的纸蛙（气泡文字）",
          "text": "噢…老兄…"
        },
        {
          "type": "subtitle",
          "text": "与沉稳的纸蛙对话"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "不错，您做这项运动真是一把好手。如果您有空的话，我愿意将您举荐给比赛委员会。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "等到下次跳跃比赛开始，我们就可以较量一番了。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "在那之前，我就不耽误您的时间了。总决赛马上就会开始。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们可得好好看看那位福罗贝尔究竟有多厉害。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "他的发挥一定超乎您的想象！虽然…我最近见到福罗贝尔的时候，他显得有些…过于紧张了。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "他一直不断地练习着那些最基础的动作…然后，被那些基础动作弄得心烦意乱。"
        },
        {
          "role": "派蒙",
          "text": "总决赛之前大家都会紧张一点啦，这没什么奇怪的呀。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕竟是总决赛。",
              "dialogues": []
            },
            {
              "text": "谨慎一点也无可厚非。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "沉稳的纸蛙",
          "text": "我也这么想，但…"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "不，我还是愿意相信福罗贝尔，他不是那种会轻易被自己击败的蛙。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "我要继续去练习了。两位客人，如果您有兴趣的话，可以继续去四周逛逛。"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "但决赛应该马上就会开始，请您千万别错过了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（沉稳的纸蛙）"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "福罗贝尔…希望你调整好状态了…"
        },
        {
          "type": "subtitle",
          "text": "观看总决赛"
        },
        {
          "role": "奥雷卢",
          "text": "瞧啊！看吧！各位后腿健壮的先生小姐们，无与伦比的福罗贝尔起跳了！他…"
        },
        {
          "role": "奥雷卢",
          "text": "…跳出了…三个荷叶的距离后…落入水中…"
        },
        {
          "role": "奥雷卢",
          "text": "本、本次的冠军，和迎接公主的重任…由健壮的埃斯唐普担当…！恭喜…"
        },
        {
          "role": "埃斯唐普",
          "text": "不！奥雷卢先生，这太可笑了，我绝不可能就这么接受冠军。"
        },
        {
          "role": "奥雷卢",
          "text": "天哪，看在露珠的份上…你当着所有蛙的面胜过了福罗贝尔。"
        },
        {
          "role": "埃斯唐普",
          "text": "福罗贝尔只是失误了，他…他的状态不对，没发挥出全力…"
        },
        {
          "role": "奥雷卢",
          "text": "这说辞不仅无法说服我，也无法说服其他纸蛙！无论如何，先让福罗贝尔自己静静…我们稍后再谈，有客人来了。"
        },
        {
          "role": "奥雷卢",
          "text": "欢迎！欢迎来到雨歌塘，我能帮您什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们这是举办什么比赛？",
              "dialogues": [
                {
                  "role": "奥雷卢",
                  "text": "如您所见，这是一场跳跃竞赛。"
                },
                {
                  "role": "奥雷卢",
                  "text": "只有最擅长跳跃的蛙才能夺得冠军，从而承担起迎接公主的重任…这也是我们举办如此之多比赛的意义所在。"
                },
                {
                  "role": "奥雷卢",
                  "text": "刚才您…应该看见了一位跃起的蛙，他是福罗贝尔，参赛的选手之一，也是原本塘中最擅长跳跃的蛙…原本如此。"
                }
              ]
            },
            {
              "text": "刚才有一只蛙跳得又高又远！",
              "dialogues": [
                {
                  "role": "奥雷卢",
                  "text": "噢，您注意到福罗贝尔了。他是参加本次竞赛的选手之一，也是原本塘中最擅长跳跃的蛙…原本如此。"
                },
                {
                  "role": "派蒙",
                  "text": "竞赛？唔…我知道！肯定是那种，比赛谁跳得最好的比赛吧。"
                },
                {
                  "role": "奥雷卢",
                  "text": "敏锐的小姐。不错，我们正举办一场跳跃竞赛。"
                },
                {
                  "role": "奥雷卢",
                  "text": "只有最擅长跳跃的蛙才能夺得冠军，从而承担起迎接公主的重任。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "听着好有意思！可惜我们完全错过了所有赛程…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不然的话，我就能参赛了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "咦？你很擅长跳远吗？除了被魔物追的时候…我都没有见过你跳过多远。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "重在参与啦，说不定还有纪念奖…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "不要一开始就冲着纪念奖去啊！"
                }
              ]
            },
            {
              "text": "好遗憾，不然就能让派蒙参赛了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我？为、为什么要我去？我平时都是飞的，从来不跳欸。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "飞肯定比跳快，冠军非你莫属啦。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "这不是作弊吗？跳远比赛就好好用腿跳啦！"
                },
                {
                  "role": "派蒙",
                  "text": "要是真要参赛，也只能你去啦。不过，除了被魔物追的时候…我都没有见过你跳过多远就是了…"
                }
              ]
            }
          ]
        },
        {
          "role": "埃斯唐普",
          "text": "……"
        },
        {
          "role": "奥雷卢",
          "text": "哈哈哈…那您可得和我身边这位冠军先生多多请教了。"
        },
        {
          "role": "埃斯唐普",
          "text": "…抱歉，二位客人，还有奥雷卢先生！我说过了，我并不是冠军，我绝不能是冠军。"
        },
        {
          "role": "奥雷卢",
          "text": "看在荷叶杆的份上…按照赛程规章，你就是冠军！"
        },
        {
          "role": "埃斯唐普",
          "text": "我才是那个要说「不」的！这场比赛必须选出最优秀，最擅长跳跃的蛙去迎接公主。这事关所有蛙的荣誉。"
        },
        {
          "role": "埃斯唐普",
          "text": "福罗贝尔是我们之中最优秀的那个，你知道，所有蛙都知道！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那位福罗贝尔，之前很厉害吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…我们之前倒是听其他纸蛙说过很多关于他的事，那么多厉害的事迹，都是真的？"
        },
        {
          "role": "埃斯唐普",
          "text": "是的。福罗贝尔是…曾经是，我们塘里最优秀的蛙。"
        },
        {
          "role": "埃斯唐普",
          "text": "他能轻松跳过十二片荷叶的距离，落在第十三片荷叶上时，连上面的露珠都不会打翻。"
        },
        {
          "role": "埃斯唐普",
          "text": "他甚至能在河流上的荷叶之间来回跳跃，无论底下的河流多么湍急，他都绝不会落水。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但是，我们刚才看见他…",
              "dialogues": []
            },
            {
              "text": "他现在…状态并不好？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯。看起来那位福罗贝尔好像没有劲头的样子，刚才离开的时候，看上去也好难过。"
        },
        {
          "role": "埃斯唐普",
          "text": "…他只是暂时心态失衡，才出现了那种失误。"
        },
        {
          "role": "埃斯唐普",
          "text": "尊敬的奥雷卢先生，为了这场竞赛，也为了我们的使命，我申请重赛。"
        },
        {
          "role": "埃斯唐普",
          "text": "如果需要的话，你也可以召来所有蛙，我相信他们也会同意我的做法。"
        },
        {
          "role": "奥雷卢",
          "text": "听着，埃斯唐普，我知道你的心肠很好，头脑也清晰，品德更是没得谈。"
        },
        {
          "role": "奥雷卢",
          "text": "但你难道不知道福罗贝尔的状态吗？他甚至连第二次复跳的机会都没用，就直接离开了…"
        },
        {
          "role": "埃斯唐普",
          "text": "我会去和他谈谈！我和福罗贝尔一直共同训练，我明白他的心思，他也一定明白我的。"
        },
        {
          "role": "奥雷卢",
          "text": "看在荷叶与露珠的份上…好吧，我会和你一起去见见福罗贝尔。"
        },
        {
          "role": "派蒙",
          "text": "我们也一起去！我们…那个，可会劝人啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "而且也很会跳跃！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸？你难道之前一直瞒着我…悄悄地练习跳远？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我很擅长衬托出他蛙的跳跃距离。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥雷卢",
          "text": "哈哈哈哈哈，您真是位幽默有礼貌的好人，谢谢您的好意，那咱们就一起去吧。"
        },
        {
          "role": "奥雷卢",
          "text": "希望您的幽默感，能让福罗贝尔的心缓和回来…池塘保佑。也不知道那位先生是吃软还是吃硬。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（兴奋的纸蛙）"
        },
        {
          "role": "兴奋的纸蛙",
          "text": "怎么…怎么会这样…福罗贝尔居然跳出了这么大的失误…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（沉稳的纸蛙）"
        },
        {
          "role": "沉稳的纸蛙",
          "text": "福罗贝尔…你到底怎么了？唉…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（忧郁的纸蛙）"
        },
        {
          "role": "忧郁的纸蛙",
          "text": "失败是幽深的池塘，疑虑是纠缠的水藻，逃避是陷蹼的淤泥。"
        },
        {
          "role": "忧郁的纸蛙",
          "text": "福罗贝尔，福罗贝尔，你该如何从中跃出…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（好心的纸蛙）"
        },
        {
          "role": "好心的纸蛙",
          "text": "可怜的福罗贝尔，一定是咱们给他的期望太大，把这可怜蛙压垮了。"
        },
        {
          "role": "好心的纸蛙",
          "text": "唉，要我说，总是夺着第一也并不是好事，长得最高的莲蓬，总是最先折断。"
        },
        {
          "type": "subtitle",
          "text": "追上福罗贝尔"
        },
        {
          "role": "埃斯唐普",
          "text": "他就在这里！"
        },
        {
          "role": "福罗贝尔",
          "text": "你们来了。看来颁奖仪式已经结束了。"
        },
        {
          "role": "埃斯唐普",
          "text": "恰恰相反，我和奥雷卢先生认为，这场比赛都尚未结束。"
        },
        {
          "role": "奥雷卢",
          "text": "我现在以裁判的身份发言。福罗贝尔先生，在首跳结束后，你还有一次复跳机会。"
        },
        {
          "role": "奥雷卢",
          "text": "出于比赛公正性，和对使命的负责性考虑，你必须要去进行一次复跳。"
        },
        {
          "role": "福罗贝尔",
          "text": "我以选手的身份发言，尊敬的奥雷卢先生，基于比赛规章中，比赛行为可能有害于选手自身及部落之条款…"
        },
        {
          "role": "福罗贝尔",
          "text": "我主动放弃复跳机会…我不想让大家失望第二次，也不想毁了我们的使命，这才是真正的负责任。"
        },
        {
          "role": "派蒙",
          "text": "好、好专业的发言！而且还有具体的条款！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "而且还补了一句人情话…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥雷卢",
          "text": "好吧！他不吃硬的，露珠与荷叶啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但你没有离开赛场。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "福罗贝尔",
          "text": "…我没明白您的意思，客人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里是附近最适合观望赛场的地方。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这么一说…真的！从这里可以把跳远比赛的现场看得一清二楚！"
                },
                {
                  "role": "派蒙",
                  "text": "如果他真的对比赛灰心丧气，完全不想搭理和比赛有关的事…又为什么会待在这里呢？"
                }
              ]
            },
            {
              "text": "如果你真想弃赛，就不会待在这里。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对…对喔。从这里可以把跳远比赛的现场看得一清二楚！"
                },
                {
                  "role": "派蒙",
                  "text": "如果他真的灰心丧气，完全不想搭理和比赛有关的事…又为什么会待在这里呢？"
                }
              ]
            }
          ]
        },
        {
          "role": "福罗贝尔",
          "text": "……"
        },
        {
          "role": "福罗贝尔",
          "text": "我不想再谈这件事了，我说的很清楚了…抱歉，埃斯唐普。还有两位客人。"
        },
        {
          "type": "subtitle",
          "text": "再次追上福罗贝尔"
        },
        {
          "role": "派蒙",
          "text": "就这么跳走了，我们话还没说完呢！快追上去！"
        },
        {
          "role": "埃斯唐普",
          "text": "等等！福罗贝尔！看在池塘的份上，我…"
        },
        {
          "role": "奥雷卢",
          "text": "…你也等等，埃斯唐普先生，我有一个主意。"
        },
        {
          "role": "派蒙",
          "text": "呼…呼…呼…好累…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你…你等一下！",
              "dialogues": []
            },
            {
              "text": "你…听我…听我说…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "福罗贝尔",
          "text": "两位客人还有什么事么？你们刚才应该已经见过我的丑态了。"
        },
        {
          "role": "福罗贝尔",
          "text": "…你们和埃斯唐普同来，我差不多能猜到你们要说什么。"
        },
        {
          "role": "福罗贝尔",
          "text": "我的回答是「不」，也永远是「不」。"
        },
        {
          "role": "福罗贝尔",
          "text": "瞧瞧我的脚蹼…这绝不是一双能够担上如此重任的脚蹼。它们也绝对无法拯救公主。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是一双强劲的脚蹼！",
              "dialogues": []
            },
            {
              "text": "我没见过比这更优秀的脚蹼！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没…没错！我们也没见过比你更厉害的蛙！"
        },
        {
          "role": "福罗贝尔",
          "text": "但我犯了错…不，我一直在犯错。抱歉，两位…但我不能再去比赛了。"
        },
        {
          "type": "subtitle",
          "text": "再一次追上福罗贝尔"
        },
        {
          "role": "派蒙",
          "text": "你…你先别跳走，我们就说一句，最后一句。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "蛙蛙都会犯错。",
              "dialogues": []
            },
            {
              "text": "只要克服它就好！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "福罗贝尔",
          "text": "客人，你们不明白。我…最开始以为错误只是清晨坠落在我们头顶上的露珠，没有蛙会被一滴露珠压倒。"
        },
        {
          "role": "福罗贝尔",
          "text": "但我错了。也许错误从来都不是露珠，它是池塘底的卵石，是斜插在水底的枯木，是藏在淤泥下的喷流口。"
        },
        {
          "role": "福罗贝尔",
          "text": "我们可以忽视它，埋藏它，跨过它，或者权当它压根不存在。"
        },
        {
          "role": "福罗贝尔",
          "text": "但错误绝不会忍气吞声，我的好朋友。它们会一直等着机会，为自个发声扬威。"
        },
        {
          "role": "福罗贝尔",
          "text": "走吧，求你放我走。我现在只是一株被摘走所有莲子的枯干莲蓬。"
        },
        {
          "role": "福罗贝尔",
          "text": "只要有一丝风吹过，我心上的孔洞就会带着我的整个身子齐齐颤抖。"
        },
        {
          "role": "福罗贝尔",
          "text": "我无法承担重任。这是我心里的声音…我让所有蛙失望，也让我自己失望。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还有一次复跳的机会。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对、对啊，你还有一次机会证明自己。"
        },
        {
          "role": "福罗贝尔",
          "text": "…我不想再品尝一次失败了。我的脚蹼和心，都不能……"
        },
        {
          "role": "派蒙",
          "text": "呜哇！荷叶怎么突然动起来了，发生什么了！"
        },
        {
          "role": "福罗贝尔",
          "text": "什么？这片荷叶应该是被固定住的…"
        },
        {
          "role": "福罗贝尔",
          "text": "…不行，荷叶要往前走了。两位客人站稳，我来操作荷叶！"
        },
        {
          "type": "subtitle",
          "text": "稳住！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！荷叶晃晃悠悠的，要翻…翻叶啦！"
        },
        {
          "role": "派蒙",
          "text": "再被这些水柱冲击几下，我们就要落水了！"
        },
        {
          "role": "福罗贝尔",
          "text": "小心水柱！荷叶撑不住冲击！"
        },
        {
          "role": "福罗贝尔",
          "text": "…没、没关系！这段水道很短，尽头有蛙来拦住荷叶！"
        },
        {
          "role": "派蒙",
          "text": "呼啊…这应该就到尽头了吧。刚才确实有一点点惊险。还好有你在。"
        },
        {
          "role": "福罗贝尔",
          "text": "我之前在这里训练过。操作得还算是熟练吧。"
        },
        {
          "role": "福罗贝尔",
          "text": "好了，我们马上就会在前面靠岸…"
        },
        {
          "role": "福罗贝尔",
          "text": "等等，岸上的那两只蛙是…奥雷卢和埃斯唐普？他们想做什么…"
        },
        {
          "role": "福罗贝尔",
          "text": "呜哇！荷叶又被撞开了！"
        },
        {
          "role": "福罗贝尔",
          "text": "看来暂时是没法靠岸了…"
        },
        {
          "role": "福罗贝尔",
          "text": "我…我应该这样…不对，这样不对！我操作不过来…"
        },
        {
          "role": "派蒙",
          "text": "别管那么多了！这里只有你会操作这个荷叶…真的要翻啦！"
        },
        {
          "role": "福罗贝尔",
          "text": "…呼…我能搞定…我能搞定…"
        },
        {
          "role": "派蒙",
          "text": "水流…好像越来越急了？"
        },
        {
          "role": "福罗贝尔",
          "text": "…只，只能由我控制了！{{颜色|蓝|接下来交给我}}！，各位站稳了！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！前面是悬崖！只能跳了！"
        },
        {
          "role": "福罗贝尔",
          "text": "跳？我跳不过去！"
        },
        {
          "type": "subtitle",
          "text": "与奥雷卢对话"
        },
        {
          "role": "奥雷卢",
          "text": "瞧啊！看吧！不屈的福罗贝尔，勇敢的福罗贝尔！他把握住了复跳的机会，漂亮的远跳！"
        },
        {
          "role": "奥雷卢",
          "text": "绝无仅有的奇迹！他是…他是唯一一只能跳过这悬崖的纸蛙！"
        },
        {
          "role": "埃斯唐普",
          "text": "我就知道你可以，福罗贝尔，我一直相信你可以。"
        },
        {
          "role": "福罗贝尔",
          "text": "那片突然动起来的荷叶，是你们干的？"
        },
        {
          "role": "埃斯唐普",
          "text": "是奥雷卢先生和我一起想的主意。抱歉，两位客人，我们对您隐瞒了这件事。"
        },
        {
          "type": "choice",
