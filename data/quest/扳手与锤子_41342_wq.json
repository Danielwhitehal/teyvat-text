{
  "quest_id": 41342,
  "chapter_num": null,
  "chapter_title": "扳手与锤子",
  "type": "wq",
  "route": "Hammer and Wrench",
  "stories": [
    {
      "story_id": 41342,
      "title": "扳手与锤子",
      "description": "",
      "dialogues": [
        {
          "role": "思妤",
          "text": "果然，还是送盏霄灯过去吧…"
        },
        {
          "role": "旅行者",
          "text": "送霄灯？"
        },
        {
          "role": "思妤",
          "text": "是旅行者啊，是这样。从小扳子哥就一直很照顾我，平时也帮了我很多忙，他就和我亲哥哥一样。"
        },
        {
          "role": "思妤",
          "text": "但是大过节的，他似乎还在工作个不停…"
        },
        {
          "role": "思妤",
          "text": "我就想给他送一盏霄灯，嘿嘿，我们俩是从小玩到大的，小时候他最喜欢看霄灯了。"
        },
        {
          "role": "思妤",
          "text": "现在送一盏霄灯过去，他肯定会高兴的。旅行者，能拜托你帮我把这盏霄灯送给他吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你自己不去送吗？",
            "你去送会好一点…"
          ]
        },
        {
          "role": "旅行者",
          "text": "你自己不去送吗？"
        },
        {
          "role": "思妤",
          "text": "我也想自己去送啦，但家里还有很多事要做…"
        },
        {
          "role": "思妤",
          "text": "我现在出来买东西，家里的事都是我老公一个人在忙，我得赶紧回去帮帮他才行。"
        },
        {
          "role": "思妤",
          "text": "所以霄灯的事就拜托你啦，等稍微有空了，我会和我老公一起去看扳子哥的。"
        },
        {
          "role": "思妤",
          "text": "希望那时候扳子哥也能稍微闲一些…"
        },
        {
          "role": "王扳子",
          "text": "哦，这样就可以了，多谢。"
        },
        {
          "role": "王扳子",
          "text": "还有点零碎工作…能不能请你帮我去港口清点一下新到的物资？"
        },
        {
          "role": "王扳子",
          "text": "应该就是三个箱子，就堆在港口上了。"
        },
        {
          "role": "旅行者",
          "text": "交给我了。"
        },
        {
          "role": "王扳子",
          "text": "那就拜托你了，我得赶紧把这些活给收尾…"
        },
        {
          "role": "王扳子",
          "text": "嗯？旅行者，你找我有事吗？我现在正忙着呢。"
        },
        {
          "role": "旅行者",
          "text": "关于思妤送你的霄灯…"
        },
        {
          "role": "王扳子",
          "text": "思妤？她…她送我的霄灯？我…我看看！"
        },
        {
          "role": "王扳子",
          "text": "哈哈哈，这愿望是她帮我写的吧，我小时候确实最想实现这个愿望…"
        },
        {
          "role": "王扳子",
          "text": "一转眼都过去了这么多年了，时间过得可真快啊…"
        },
        {
          "role": "王扳子",
          "text": "不过，她怎么让你把这盏霄灯送来？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "她家里还有事要忙…",
            "她说要回家帮老公…"
          ]
        },
        {
          "role": "旅行者",
          "text": "她家里还有事要忙…"
        },
        {
          "role": "王扳子",
          "text": "是吗，是这样…也好，也好，很不错啊。"
        },
        {
          "role": "王扳子",
          "text": "思妤现在过得肯定很不错吧，这样就好了…哈哈…哈。"
        },
        {
          "role": "王扳子",
          "text": "这样挺好的…不好意思…我还有很多工作要做，先走了…"
        },
        {
          "role": "李锤子",
          "text": "那个霄灯是思妤送给他的，对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你刚才听见了？",
            "你怎么知道的？"
          ]
        },
        {
          "role": "旅行者",
          "text": "你刚才听见了？"
        },
        {
          "role": "李锤子",
          "text": "他那么点事，我猜都不用猜。"
        },
        {
          "role": "李锤子",
          "text": "去年他也是这样，出去了一趟之后，回来一个人杵在船边上敲了一晚上的钉子。"
        },
        {
          "role": "李锤子",
          "text": "我知道他这么做的意思，但是，唉…"
        },
        {
          "role": "李锤子",
          "text": "旅行者，能不能请你去帮他一下？大过节的，这么折腾自己也不是个事…"
        },
        {
          "role": "旅行者",
          "text": "好的…"
        },
        {
          "role": "李锤子",
          "text": "唉…麻烦你了。"
        },
        {
          "role": "李锤子",
          "text": "估计他这会儿就去船上干活了…你赶紧去吧。"
        },
        {
          "role": "李锤子",
          "text": "我等会去置办点吃食，你们弄完了之后就过来吧，我们一起吃点。"
        },
        {
          "role": "王扳子",
          "text": "久等了吧，我都搞定了。"
        },
        {
          "role": "李锤子",
          "text": "怎么，事情全都弄完了？"
        },
        {
          "role": "王扳子",
          "text": "弄完了，那么点小事，还有这个旅行者帮忙，轻轻松松就都解决了。"
        },
        {
          "role": "李锤子",
          "text": "你这个人啊…唉…"
        },
        {
          "role": "王扳子",
          "text": "行了行了，大过节的，别这副表情嘛。"
        },
        {
          "role": "李锤子",
          "text": "行，你说什么就是什么，霄灯你准备好了没有？"
        },
        {
          "role": "王扳子",
          "text": "霄灯…哎哟！我给忘了，你说我这记性…"
        },
        {
          "role": "王扳子",
          "text": "没事没事，不就是个霄灯嘛，不放也没什么…"
        },
        {
          "role": "李锤子",
          "text": "你少来这套，大过节的，不放霄灯像话吗？"
        },
        {
          "role": "李锤子",
          "text": "旅行者，能拜托你再帮我兄弟弄个霄灯？"
        },
        {
          "role": "旅行者",
          "text": "交给我了。"
        },
        {
          "role": "李锤子",
          "text": "谢谢，我们就在这等着你。"
        },
        {
          "role": "王扳子",
          "text": "耽搁了这么久，落下了不少活，得加把劲干活才行。"
        },
        {
          "role": "旅行者",
          "text": "你、你还好吧…"
        },
        {
          "role": "王扳子",
          "text": "嗨！我能有啥事啊，没事没事。"
        },
        {
          "role": "王扳子",
          "text": "我还得赶紧干完这些活儿，干完了之后…嗨，干完了活再说吧。"
        },
        {
          "role": "旅行者",
          "text": "我也来帮忙吧。"
        },
        {
          "role": "王扳子",
          "text": "哦？那敢情好，那就麻烦你先帮我拿些木板来吧。"
        },
        {
          "role": "王扳子",
          "text": "木板拿来了吗？"
        },
        {
          "role": "王扳子",
          "text": "数量都对上了吗。"
        },
        {
          "role": "旅行者",
          "text": "都对上了。"
        },
        {
          "role": "王扳子",
          "text": "真是多谢你了！"
        },
        {
          "role": "王扳子",
          "text": "呼——这样子，今天的急活应该就算是干完了。"
        },
        {
          "role": "旅行者",
          "text": "李锤子说给你准备了些吃的。"
        },
        {
          "role": "王扳子",
          "text": "咦？他…费这个劲，他这人就是瞎操心。"
        },
        {
          "role": "王扳子",
          "text": "算了，既然都准备好了，我们还是去找他吧。"
        },
        {
          "role": "王扳子",
          "text": "而且你帮了我这么多忙，也多少要给你点东西做报酬。"
        },
        {
          "role": "李锤子",
          "text": "行了，谢谢你了。"
        },
        {
          "role": "王扳子",
          "text": "你看你还这么麻烦…谢谢你了啊，旅行者，大过节的还要你跑东跑西的…"
        },
        {
          "role": "王扳子",
          "text": "我想想我要写什么愿望…"
        },
        {
          "role": "王扳子",
          "text": "嗯…就写「新年新气象」吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "听起来不错。",
            "挺好的愿望。"
          ]
        },
        {
          "role": "旅行者",
          "text": "听起来不错。"
        },
        {
          "role": "王扳子",
          "text": "是吗？哈哈哈，那就好，哎呀…希望我这愿望，真的能实现…"
        },
        {
          "role": "李锤子",
          "text": "唉…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "李锤子",
          "text": "他去年，也是许的这个愿望…"
        },
        {
          "role": "李锤子",
          "text": "你把霄灯拿来了吗？"
        },
        {
          "role": "旅行者",
          "text": "拿来了。"
        }
      ]
    }
  ]
}