{
  "quest_id": 10100,
  "chapter_num": "智巧灵蕈大竞逐 第一幕",
  "chapter_title": "前所未闻的奇妙比赛？",
  "type": "eq",
  "route": "The Most Fantastic Tournament You've Never Heard Of?",
  "stories": [
    {
      "story_id": 40081,
      "title": "前所未闻的奇妙比赛？",
      "description": "须弥的人们正在逐渐返回平静的日常生活，你和派蒙却在寻求委托任务的途中，发现了一块奇怪的告示牌…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "在须弥城附近转一转"
        },
        {
          "role": "派蒙",
          "text": "说起来，须弥的风波已经告一段落了。这种时候，大家经常有奇思妙想呢。"
        },
        {
          "role": "派蒙",
          "text": "我们可以在须弥城附近转一转，看看有没有人需要帮忙？我的直觉告诉我，肯定会有收获的！"
        },
        {
          "role": "派蒙",
          "text": "咦，这里怎么多出了一个公告板？上面还画着…蕈兽？"
        },
        {
          "type": "subtitle",
          "text": "活动公告"
        },
        {
          "type": "subtitle",
          "text": "想捕捉性格温顺的蕈兽，和它们近距离接触吗？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "想体验指挥多种蕈兽，击败强敌的快感吗？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "想组建只属于你自己的蕈兽队伍，和其他「驯兽师」开展激动人心的对决吗？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "首届「月莲杯驯兽师大赛」即将在奥摩斯港拉开帷幕，期待着各位的到来！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "只需报名参赛，小试身手，就有机会赢得海量奖金！",
          "narration": true
        },
        {
          "role": "宣传板",
          "text": "首届「月莲杯驯兽师大赛」即将在奥摩斯港拉开帷幕，期待着各位的到来！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "训练蕈兽，进行比赛？",
              "dialogues": []
            },
            {
              "text": "未曾设想的娱乐活动…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "蕈兽可是魔物啊！这种事情不管怎么想都很危险…"
        },
        {
          "role": "派蒙",
          "text": "我们先去比赛现场看看吧？假如真的有危险，至少我们能防止他们把事态搞得不可收拾。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（留言板）"
        },
        {
          "role": "留言板",
          "text": "「『月莲杯驯兽师大赛』现已开幕！上百位参赛选手正在捕捉蕈兽，组建强而有力的队伍！」"
        },
        {
          "role": "留言板",
          "text": "「准备阶段结束后，工作人员将确认选手们是否集齐了四只蕈兽，并随机决出预赛的赛程。」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "查阅大赛规则…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔，这里写了好多好多条目！还有什么免责声明？"
                },
                {
                  "role": "派蒙",
                  "text": "好难懂啦，不想读，我们都跳过吧，最重要的是奖金…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "派蒙…",
                      "dialogues": []
                    },
                    {
                      "text": "你有露馅了…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "不对不对！是有关蕈兽的内容，比如说，能不能让蕈兽在公开场合露面什么的…"
                },
                {
                  "role": "派蒙",
                  "text": "诶嘿嘿，我们找找看吧！"
                },
                {
                  "role": "留言板",
                  "text": "「赛事奖励·八强级：总量可观的摩拉、首届厂月莲杯」大赛限定荣誉称号，以及保留王牌蕈兽的资格…」"
                },
                {
                  "role": "派蒙",
                  "text": "总量可观的摩拉？原来没有写清楚具体的数额啊…倒是这个保留王牌蕈兽的资格，说的是可以选一只蕈兽，带回家里去生活吗？"
                },
                {
                  "role": "派蒙",
                  "text": "我们再看看吧…"
                },
                {
                  "role": "留言板",
                  "text": "「蕈兽活动规范·第三条：经过『意智宝珠』控制，并登记在册的蕈兽，可以在赛场周围活动，但请驯兽师们注意行动的边界。」"
                },
                {
                  "role": "留言板",
                  "text": "「可活动的区域仅限于赛场周围、奥摩斯港的主要道路，切勿将蕈兽带入以下公共场所：维卡拉商栈、所有商店、餐馆。」"
                },
                {
                  "role": "留言板",
                  "text": "「目前，本赛事尚未被所有民众接受，若是蕈兽突然出现在不知情的民众面前，可能引起恐慌和混乱，建议大家谨慎行事。」"
                },
                {
                  "role": "留言板",
                  "text": "「『三十人团』将监督参赛选手，一旦违规，将取消选手的参赛资格，情节严重者，可能会被追究责任，受到教令院的惩罚」"
                },
                {
                  "role": "派蒙",
                  "text": "呜啊…规矩好严格！我们也一定要小心！"
                }
              ]
            },
            {
              "text": "关于留言活动…",
              "dialogues": [
                {
                  "role": "留言板",
                  "text": "「预赛结果揭晓后，观众们可以在这块赛事公告板上留言，尽情声援自己支持的选手，或是发表对于蕈兽的见解！」"
                },
                {
                  "role": "留言板",
                  "text": "「出于多种考量，所有留言将由工作人员审核后发表，也请各位观众不要发表太过激烈的言论友善地留言！」"
                }
              ]
            },
            {
              "text": "离去。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往「月莲杯」赛场"
        },
        {
          "type": "subtitle",
          "text": "分支对话（贝尔福内心）"
        },
        {
          "role": "贝尔福",
          "text": "（工作这么简单，却能拿到超高的薪水…我实在太走运了，跟了埃尔欣根这么个好老板！）"
        },
        {
          "type": "subtitle",
          "text": "分支对话（海泥耶内心）"
        },
        {
          "role": "海泥耶",
          "text": "（要牢记当年的事，不能动摇，不能被他们影响。）"
        },
        {
          "role": "考特里亚",
          "text": "庆贺吧，各位参赛者！欢迎来到「月莲杯驯兽师大赛」！我是大赛负责人，生论派资深学者考特里亚。"
        },
        {
          "role": "考特里亚",
          "text": "各位想必对「指挥蕈兽作战」的概念很感兴趣，抑或期待着丰厚的奖励，但同时对比赛的安全措施不太放心。"
        },
        {
          "role": "考特里亚",
          "text": "我向各位保证！我们为本次大赛专门准备的「意智宝珠」运用了生论派最先进的「理性增幅」技术，绝对安全可靠！"
        },
        {
          "role": "考特里亚",
          "text": "请大家放下顾虑，大胆参与赛事！"
        },
        {
          "role": "考特里亚",
          "text": "此外，本次大赛还得到了枫丹大商人埃尔欣根先生的赞助，他为本次大赛提供了所有的奖金，总计六千万摩拉！"
        },
        {
          "role": "考特里亚",
          "text": "如果有人能在决赛之后，通过「最终考验」，证明自己有能力贯彻埃尔欣根先生的理念，他甚至愿意出让自己的全部资产！"
        },
        {
          "role": "考特里亚",
          "text": "此外附加的唯一要求是，这位选手必须接过埃尔欣根先生的衣钵，将这「月莲杯驯兽师大赛」继续举办下去…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！那个富商随随便便就能投资六千万摩拉？还有，只需要继续支持这个驯兽师大赛…就能拿到他的全部财产？"
        },
        {
          "role": "派蒙",
          "text": "不对不对，主办方居然有教令院的学者站台，那我们二话不说就直接阻止，好像有点不太合适呢。"
        },
        {
          "role": "派蒙",
          "text": "要不然…我们先去参加比赛，试试他们说的「意智宝珠」到底管不管用吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙…",
              "dialogues": []
            },
            {
              "text": "你是不是对奖励心动了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "才没有啦！毕竟须弥好不容易才安定下来，现在这种时候，我们还和教令院对着干的话，也太不给纳西妲面子了嘛…"
        },
        {
          "role": "派蒙",
          "text": "而且听他说得信心满满，我也想见识一下能把蕈兽驯服的东西有多神奇！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "如果这个道具很管用呢？",
              "dialogues": []
            },
            {
              "text": "你要怎么对待那些蕈兽？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…虽然蕈兽以前给我们造成过麻烦，但也不全是穷凶极恶的坏东西吧？更像是…脾气不太好的野生生物？"
        },
        {
          "role": "派蒙",
          "text": "没有安全问题的话，我们就不用害怕了，还可以试着和蕈兽做朋友，应该会很有意思！"
        },
        {
          "role": "派蒙",
          "text": "再说了，如果能拿到不错的名次，还可以顺带赚点苦劳费，一举两得嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就一边尝试新鲜的比赛…",
              "dialogues": []
            },
            {
              "text": "一边保持警惕，以防意外…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好！这才是我们的作风嘛！"
        },
        {
          "role": "派蒙",
          "text": "那边应该就是报名的地方了！我们也去领取「意智宝珠」，报名参加比赛吧！"
        },
        {
          "type": "subtitle",
          "text": "领取「意智宝珠」"
        },
        {
          "role": "派蒙",
          "text": "咦，之前的人还没登记完吗？我们再等等吧。"
        },
        {
          "role": "？？？",
          "text": "「黄金流星」旅行者和「白银伴星」派蒙…你们也要参加这场比赛？"
        },
        {
          "role": "派蒙",
          "text": "咦，你认识我们？突然就报出了从没听过的称号…"
        },
        {
          "role": "？？？",
          "text": "你们很强，从你们手下逃过一劫的佣兵画了你们的像，警告其他人别惹你们。"
        },
        {
          "role": "派蒙",
          "text": "呃我们应该说「谢谢夸奖」，还是解释我们没有传闻中那么恐怖呢…"
        },
        {
          "role": "？？？",
          "text": "可惜，根据这场大赛的规则，驯兽师被禁止携带武器，不可以直接出手，你们无可挑剔的战斗力是不管用的。"
        },
        {
          "role": "？？？",
          "text": "比赛的重点是捕捉和训练蕈兽，指挥这些「棋子」去战斗，你们也未必能掌握指挥蕈兽的关键技巧。"
        },
        {
          "role": "派蒙",
          "text": "说得也有道理呢…我们还没试过捕捉蕈兽，也不知道指挥蕈兽战斗的要点。"
        },
        {
          "role": "派蒙",
          "text": "等等，你也不像工作人员啊？为什么你一副把握十足的样子在说教，你到底是什么人？"
        },
        {
          "role": "海泥耶",
          "text": "我叫海妮耶。曾为镀金旅团工作，负责驯服暴躁的驮兽，在此之前就被称为「驯兽师」，也因此参与了「意智宝珠」的初期测试。"
        },
        {
          "role": "海泥耶",
          "text": "不过，我这种不识字的粗人只能给佣兵们打杂，报出名号也没什么意义，你们就把我当成普通的参赛选手好了。"
        },
        {
          "role": "海泥耶",
          "text": "在驯兽这一行，我有不少心得，你们需要我指点一下吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你想和我们结成同盟？",
              "dialogues": []
            },
            {
              "text": "你想试探我们的实力？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海泥耶",
          "text": "无论作为盟友还是对手，你们都能在比赛中帮我排除阻碍，是值得结交的对象。当然，我个人希望是前者。"
        },
        {
          "role": "派蒙",
          "text": "说得好直白…不过还挺诚实的。"
        },
        {
          "role": "派蒙",
          "text": "有个懂行的人来指导，总归是比我们自己摸索要强的吧？不如先答应她？"
        },
        {
          "role": "海泥耶",
          "text": "那就收好这个「意智宝珠」吧，我们现在就启程，去主办方指定的区域捕捉蕈兽。"
        },
        {
          "role": "派蒙",
          "text": "真是个雷厉风行的人啊…"
        },
        {
          "type": "subtitle",
          "text": "跟随海妮耶，前往了捕捉蕈兽的区域。",
          "narration": true
        },
        {
          "role": "海泥耶",
          "text": "这里就是捕捉区域了，这一带的蕈兽和「意智宝珠」的匹配度较高，适合训练与比赛。"
        },
        {
          "role": "海泥耶",
          "text": "「意智宝珠」能捕捉和收纳蕈兽，本身也是一个操纵装置。"
        },
        {
          "role": "海泥耶",
          "text": "我建议你们为每只蕈兽确认一个代号，这样便于指挥它们。比如我身边的这只，它叫「火一」代表「火元素蕈兽一号」。"
        },
        {
          "role": "派蒙",
          "text": "元素种类加编号？总觉得这样的名字有点单薄呢…海妮耶的这只蕈兽看起来很有活力，不如就叫「蹦蹦开心菇」好了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙最擅长起名了。",
              "dialogues": []
            },
            {
              "text": "我也有一些好点子。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海泥耶",
          "text": "多此一…多谢了。我有自己习惯的起名方式，重要的是简单直观，便于指挥。"
        },
        {
          "role": "派蒙",
          "text": "也对哦，你大概已经习惯叫它「火一」了我们就不给你出主意了。不过，听到我们起的厉害名字后，你也许会回心转意！"
        },
        {
          "type": "subtitle",
          "text": "前往捕捉区域"
        },
        {
          "type": "subtitle",
          "text": "捕捉蕈兽"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，这些名字都很不错吧？在赛场上大声喊出来的时候，肯定很威风！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "第二只是怎么回事…",
              "dialogues": []
            },
            {
              "text": "三个建议明明都一样…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这种蕈兽头顶圆圆的帽子很像-个小小的鼓吧！我早就这么觉得了，敲它的脑袋时，肯定会发出咚咚锵锵的声音！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "它的脑袋应该不会「咚咚」响。",
              "dialogues": []
            },
            {
              "text": "敲上去的动静应该是「噗噗」~",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你看你看，它很开心的样子，说明它喜欢这个名字！就决定是「咚咚小圆帽」了！"
        },
        {
          "role": "派蒙",
          "text": "「咚咚小圆帽」好乖欸，和小猫小狗一样…原来蕈兽也有这样的一面啊。"
        },
        {
          "role": "派蒙",
          "text": "以后我们就要互相关照啦，「咚咚小圆帽」！"
        },
        {
          "role": "派蒙",
          "text": "我们就一鼓作气捕捉剩下的蕈兽，为「咚咚小圆帽」组建一支队伍吧！"
        },
        {
          "type": "subtitle",
          "text": "前往下个捕捉区域"
        },
        {
          "type": "subtitle",
          "text": "捕捉蕈兽"
        },
        {
          "role": "海泥耶",
          "text": "很好，四只蕈兽集齐了，下一步是用主办方提供的「花花琼脂」激发蕈兽们的能力，以便在比赛中使出强力的招式…"
        },
        {
          "role": "派蒙",
          "text": "进展比想象中要快得多呢！谢谢你啦，海妮耶！我们现在就回赛场吧…"
        },
        {
          "role": "派蒙",
          "text": "欸？你们快看，那边有个人在晃荡，身边还有个蕈兽围着她打转…难道是被攻击了？"
        },
        {
          "role": "派蒙",
          "text": "她突然倒地了！我们快过去看看吧！"
        },
        {
          "role": "？？？",
          "text": "呃…实在没有力气了，一步都挪不动…"
        },
        {
          "role": "派蒙",
          "text": "你受伤了吗？要不要紧？"
        },
        {
          "role": "旅行者",
          "text": "危险！"
        },
        {
          "role": "海泥耶",
          "text": "拿下它，「火一」。"
        },
        {
          "role": "？？？",
          "text": "等等！它不是敌人，是我的伙伴！"
        },
        {
          "role": "？？？",
          "text": "我只是有点累，走不动了而已…还要找到余下三个蘑菇伙伴，才能获得参赛的资格…"
        },
        {
          "role": "旅行者",
          "text": "蘑菇伙伴？"
        },
        {
          "role": "派蒙",
          "text": "莫非你也是参赛选手？"
        },
        {
          "role": "？？？",
          "text": "我也没想到会在这里碰见竞争对手…也许真的到此为止了，只凭「转转悠悠兽」也对付不了你们…"
        },
        {
          "role": "？？？",
          "text": "「转转悠悠兽」就拜托你们了，你们要带着它拿到好名次啊！"
        },
        {
          "role": "派蒙",
          "text": "不要自暴自弃啦！我们又不是拦路的镀金旅团，不会抢走你的蕈兽…蘑菇伙伴的，我们才没有那么卑鄙！"
        },
        {
          "role": "派蒙",
          "text": "就算你要和我们分个高下，也要等到上了赛场，堂堂正正地比试！"
        },
        {
          "role": "派蒙",
          "text": "就像我们身边这位驯兽师，海妮耶，她明知道我们可能成为强劲的对手，还是给了我们好多指导！"
        },
        {
          "role": "海泥耶",
          "text": "…这是在夸我吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你就当成夸奖收下吧。",
              "dialogues": []
            },
            {
              "text": "派蒙完全进入状态了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "报上你的名号和目标来吧，「黄金流星」旅行者和我「白银伴星」派蒙可以帮你哦！"
        },
        {
          "role": "？？？",
          "text": "真，真的吗？帮我集齐四个蘑菇伙伴？厄运突然倒转，变成好运了？"
        },
        {
          "role": "莱依拉",
          "text": "我…我叫莱依拉，是梨多梵谛学院的普通学员，没什么厉害的名号…我的目标是…打进这场比赛的八强赛。"
        },
        {
          "role": "莱依拉",
          "text": "要是能进入八强，我就可以把蘑菇伙伴带回家，让它们为我分担一些体力活了。当然，我会好好照顾它们的。"
        },
        {
          "role": "派蒙",
          "text": "唔，规则上好像确实有说过，所有进入八强赛的选手都能把想要的蕈兽带回家来着…"
        },
        {
          "role": "派蒙",
          "text": "不过，体力活？学员的日常不就是课业和论文么？"
        },
        {
          "role": "莱依拉",
          "text": "说出来有点难为情…我好像天生就有睡眠障碍，每天都休息不好，体力也很差。"
        },
        {
          "role": "莱依拉",
          "text": "平常我随便运动一下…就会像刚才那样累到虛脱，我说的体力活只不过是搬搬书，出门买点…"
        },
        {
          "role": "派蒙",
          "text": "只是这点事吗？那就没什么啦！我也总是把杂活扔给旅行者！"
        },
        {
          "role": "海泥耶",
          "text": "不止把蕈兽当成伙伴，还想和它们一起生活…这种荒谬的想法…和埃尔欣根完全一样。"
        },
        {
          "role": "旅行者",
          "text": "（海妮耶的脸色不太好看？）"
        },
        {
          "role": "海泥耶",
          "text": "你们很快就理解了窍门，还有余力帮助别人，我为你们感到高兴。"
        },
        {
          "role": "海泥耶",
          "text": "祝你们一切顺利，我先失陪了。"
        },
        {
          "role": "派蒙",
          "text": "咦？海妮耶怎么突然就要走了？"
        },
        {
          "role": "派蒙",
          "text": "海妮耶，我们还没感谢你和「火一」呢！至少-起去吃好吃的…"
        },
        {
          "role": "莱依拉",
          "text": "没关系吗？怎么感觉那位驯兽师…好像生气了？"
        },
        {
          "role": "派蒙",
          "text": "唔…应该不会吧？海妮耶说话的方式很直接，确实给人一种不好亲近的感觉，不过，她的性格肯定不坏！否则怎么会帮我们呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也许她要去忙自己的事了…",
              "dialogues": []
            },
            {
              "text": "还会在比赛的时候再见的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，之后我们还会再见的，到时候，我们给她准备一些回礼吧！"
        },
        {
          "role": "派蒙",
          "text": "现在我们就要延续海妮耶的美德，堂堂正正地参加比赛，帮助其他选手，为莱依拉获取参赛资格。"
        },
        {
          "role": "莱依拉",
          "text": "呜…实在太感谢你们了！我也会尽力活动的，不能全都麻烦你们！"
        },
        {
          "type": "subtitle",
          "text": "帮助莱依拉找到了余下三位蘑菇伙伴…",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "大功告成，这样莱依拉的队伍也成形了，我们现在就回赛场去确认参赛资格吧。"
        },
        {
          "type": "subtitle",
          "text": "返回「月莲杯」赛场"
        },
        {
          "role": "派蒙",
          "text": "我看看我看看，预赛的安排…太好了！我们和莱依拉不在同一个小组里。这样就不至于早早对决了！"
        },
        {
          "role": "莱依拉",
          "text": "其实我希望…最后也不用和你们对抗啦…"
        },
        {
          "role": "八重神子",
          "text": "啊呀？这不是小家伙们吗？"
        },
        {
          "role": "八重神子",
          "text": "果然，你们又一次出现在了热点的前沿，还真是轻小说主角般的人物呢。"
        },
        {
          "role": "派蒙",
          "text": "神、神神神神子？我是不是眼花了？你为什么会在这里！"
        },
        {
          "role": "八重神子",
          "text": "呵呵，这场比赛的广告都打到稻妻来了呢，还特意在八重堂门口发了传单。"
        },
        {
          "role": "八重神子",
          "text": "你们不觉得，这样的比赛和轻小说是绝配吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实是不错的题材。",
              "dialogues": []
            },
            {
              "text": "确实有很多故事可写。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "八重堂正在筹划「风靡下个五十年的杰作」，主题也是「伙伴和竞技」，所以我们就带上新锐作者左右加到现场来取材了。"
        },
        {
          "role": "八重神子",
          "text": "当然，为了更好地对作者们的稿子把关，我也会参加比赛，稍微体验一下身为选手的感觉。"
        },
        {
          "role": "八重神子",
          "text": "这位就是我的搭档，左右加为它起了个名字一「百雷遮罗」，我觉得还不错，有股独特的气势。"
        },
        {
          "role": "派蒙",
          "text": "没想到这次的阵仗这么大，连神子都被吸引过来了…"
        },
        {
          "role": "八重神子",
          "text": "左右加，来认识一下小家伙们吧，她们一定会成为你最强的对手，可以把她们写成小说中举足轻重的角色哦。"
        },
        {
          "role": "左右加",
          "text": "是是是是是，主编大人！"
        },
        {
          "role": "左右加",
          "text": "为为为了写出深入人心的作品，我绝绝绝不会退缩，一定会会会击败你们的！"
        },
        {
          "role": "旅行者",
          "text": "那就在赛场上一决胜负吧！"
        },
        {
          "role": "派蒙",
          "text": "对…就算你是神子的心腹，我们也不会手下留情哦…"
        },
        {
          "role": "八重神子",
          "text": "就是这种气势！你找到那种感觉了吗，左右加在比赛之前向最有分量的对手下战书，可是渲染气氛的关键桥段！"
        },
        {
          "role": "左右加",
          "text": "完完完全没感觉到！想到到到要和「陪伴将军视察花见坂的密友」对抗，我就超超超紧张…"
        },
        {
          "role": "八重神子",
          "text": "那你就先回旅馆吧，抓紧时间，把现在这种紧张的心情记录下来，这也是很好的素材哦。"
        },
        {
          "role": "莱依拉",
          "text": "这个人一好可怕但好像很厉害，好想试着和她交个朋友…"
        },
        {
          "role": "八重神子",
          "text": "这位恬静的朋友是？"
        },
        {
          "role": "派蒙",
          "text": "她是我们在捕捉蕈兽时遇上的新同伴，莱依拉。"
        },
        {
          "role": "派蒙",
          "text": "莱依拉想把训练有素的蕈兽带回家里，和它们一起生活，所以才参加了这场比赛，她的目标是打进八强赛！"
        },
        {
          "role": "八重神子",
          "text": "训练蕈兽，作为生活中的伙伴？"
        },
        {
          "role": "八重神子",
          "text": "真有意思…你的身上似乎蕴藏着不少秘密，肯定能发掘出很有灵气的故事。"
        },
        {
          "role": "八重神子",
          "text": "我叫八重神子，一个兴趣使然的轻小说编辑。现在，对你就挺感兴趣的…还请多多关照哦。"
        },
        {
          "role": "莱依拉",
          "text": "呜…完全不知道该怎么回应…"
        },
        {
          "role": "莱依拉",
          "text": "两位！之前太感谢你们了！"
        },
        {
          "role": "莱依拉",
          "text": "我想好好了解四位蘑菇伙伴，为预赛做好准备…就先去训练了！"
        },
        {
          "role": "派蒙",
          "text": "注意体能啊，莱依拉，可别像上次一样累倒哦！"
        },
        {
          "role": "派蒙",
          "text": "感觉你的气势吓到她了啦，神子…"
        },
        {
          "role": "八重神子",
          "text": "哦？我有这么可怕吗？那我可得和她再多做一些交流，化解误会呐…"
        },
        {
          "role": "八重神子",
          "text": "不过，看你的眼神，似乎还有什么事想和我说呢，小家伙？"
