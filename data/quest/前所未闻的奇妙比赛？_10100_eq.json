        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于你来须弥的真实目的…",
              "dialogues": []
            },
            {
              "text": "关于这场比赛的幕后情况…",
              "dialogues": []
            }
