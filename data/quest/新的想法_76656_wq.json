  "chapter_title": "新的想法",
  "type": "wq",
  "route": "New Idea",
  "stories": [
    {
      "story_id": 76656,
      "title": "新的想法",
      "description": "茜涅特对上次找回的机器人进行了调试，而她的研究也出现了一种新的可能…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与茜涅特对话"
        },
        {
          "role": "茜涅特",
          "text": "和派蒙。多亏了你们的帮助，上次找回来的机器人已经调试好了。"
        },
        {
          "role": "派蒙",
          "text": "哦哦，它们都在这里呢。"
        },
        {
          "role": "茜涅特",
          "text": "目前没有出现新的故障，但我忽然有了一个新的想法…"
        },
        {
          "role": "茜涅特",
          "text": "旅行者，你们去找回其他的机器人时，能不能帮我留意下它们的一些特殊表现？"
        },
        {
          "role": "派蒙",
          "text": "具体是指什么样的表现呢？"
        },
        {
          "role": "茜涅特",
          "text": "大概就是…彼此之间的交互？等找回的机器人足够多了之后，或许就会更明显一些。"
        },
        {
          "role": "派蒙",
          "text": "哦…交给我们吧！"
        },
        {
          "role": "茜涅特",
          "text": "真是辛苦了，非常感谢！我这就把下一片区域标在地图上。"
        }
      ]
    }
  ]
}