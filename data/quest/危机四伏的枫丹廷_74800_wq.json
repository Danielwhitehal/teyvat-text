{
  "quest_id": 74800,
  "chapter_num": null,
  "chapter_title": "危机四伏的枫丹廷",
  "type": "wq",
  "route": "Danger Lurks Everywhere in Fontaine",
  "stories": [
    {
      "story_id": 74800,
      "title": "危机四伏的枫丹廷",
      "description": "在枫丹廷的水道旁边，你遇见了一位奇怪的人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和吉雅罗对话"
        },
        {
          "type": "subtitle",
          "text": "前往巡轨船附近"
        },
        {
          "role": "吉雅罗",
          "text": "旁边就是巡轨船了…等会我们一起上去吧。"
        },
        {
          "type": "subtitle",
          "text": "和吉雅罗对话"
        },
        {
          "role": "派蒙",
          "text": "…我说啊。为什么你一直蹲在地上？还抱着头。"
        },
        {
          "role": "派蒙",
          "text": "难道你是怕被撞到头吗？但这里连顶都没有啊。"
        },
        {
          "role": "吉雅罗",
          "text": "嘘，快过来，你们快和我一起趴下！这里很危险…"
        },
        {
          "role": "派蒙",
          "text": "这个人又开始了…"
        },
        {
          "role": "吉雅罗",
          "text": "这条巡轨船的顶上没有任何遮挡，如果在两侧立起两根竖杆，中间再挂上一根钓鱼线…"
        },
        {
          "role": "吉雅罗",
          "text": "只要巡轨船路过那两根竖杆之间，那根钓鱼线就会瞬间切向…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！别说啦！"
        },
        {
          "role": "吉雅罗",
          "text": "不、不，甚至不需要两根竖杆，只需要一根…"
        },
        {
          "role": "吉雅罗",
          "text": "只要在上面挂上一根带鱼钩的鱼线，让它垂在半空…"
        },
        {
          "role": "吉雅罗",
          "text": "巡轨船上的人，就会自然而然地被鱼钩勾住，然后…"
        },
        {
          "role": "派蒙",
          "text": "我不听我不听我不听我不听…"
        },
        {
          "role": "派蒙",
          "text": "听她说了一路，连我都有点害怕了…"
        },
        {
          "role": "派蒙",
          "text": "等到站了之后，我们就快下去吧…"
        },
        {
          "type": "subtitle",
          "text": "前往咖啡馆"
        },
        {
          "role": "派蒙",
          "text": "你怎么又躲起来了，这周围什么也没有啊？"
        },
        {
          "role": "吉雅罗",
          "text": "你没看见那台警卫机关吗？就在我们面前！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "它…怎么了？",
              "dialogues": []
            },
            {
              "text": "呃…然后呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "吉雅罗",
          "text": "嘘，快点离开那边，这警卫机关要是失控了怎么办？"
        },
        {
          "role": "吉雅罗",
          "text": "或者它…它的能源核心突然发生爆炸，或者是被人遥控着攻击我们！"
        },
        {
          "role": "旅行者",
          "text": "但它一切正常。"
        },
        {
          "role": "吉雅罗",
          "text": "这正是我害怕的。一个原本正常的机关突然失控，让某个倒霉蛋丢了命…"
        },
        {
          "role": "吉雅罗",
          "text": "这件事不会有任何人为其负责，说不定连作案主使都找不到…实在是太危险了！"
        },
        {
          "role": "派蒙",
          "text": "它已经走了喔，你可以出来了。"
        },
        {
          "role": "吉雅罗",
          "text": "喔，它真的没有失控，真是出乎预料。我们又捡了一条命啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "根本就不可能出现这种意外。",
              "dialogues": []
            },
            {
              "text": "它从一开始就不可能失控好吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "吉雅罗",
          "text": "我所想要构想的，就是一场「人为营造的纯粹意外」。"
        },
        {
          "role": "吉雅罗",
          "text": "等等。没有主使…不会由任何人单独为其负责的案件…"
        },
        {
          "role": "吉雅罗",
          "text": "对！我有灵感了，快，快，我们去咖啡馆，我必须得快点写下来！"
        },
        {
          "role": "派蒙",
          "text": "喂！跑慢点啊，你不怕有人突然丢块石头绊倒你吗？"
        },
        {
          "type": "subtitle",
          "text": "前往咖啡馆"
        },
        {
          "role": "吉雅罗",
          "text": "对，没错…就是这样…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "咖啡要凉了。",
              "dialogues": []
            },
            {
              "text": "我都已经喝完了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "吉雅罗",
          "text": "好的，谢谢你，旅行者。多谢一路护送我过来。"
        },
        {
          "role": "派蒙",
          "text": "说是护送…其实我们只是跟着你走了一路而已，什么也没做啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么坏事也没发生。",
              "dialogues": []
            },
            {
              "text": "你也没遇见什么危险。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "吉雅罗",
          "text": "是的。看来我的确是想太多了。"
        },
        {
          "role": "吉雅罗",
          "text": "这咖啡味道真不错，哈哈…哈…"
        },
        {
          "role": "吉雅罗",
          "text": "…你说，会不会有人在里面下毒啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…咳。",
              "dialogues": []
            },
            {
              "text": "你、你少说两句！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "胡说，我们都喝完了，一点事也没有啊？"
        },
        {
          "role": "吉雅罗",
          "text": "不不不，也许是一种…特别的下毒方式。"
        },
        {
          "role": "吉雅罗",
          "text": "首先，下毒的人在我们喝的咖啡里倒入了第一种药物。"
        },
        {
          "role": "吉雅罗",
          "text": "单独服用这种药物，不会对服用者造成任何影响。"
        },
        {
          "role": "吉雅罗",
          "text": "当我们全部服下了这种药，离开这里回家的时候，下毒者就会偷偷尾随我们…"
        },
        {
          "role": "吉雅罗",
          "text": "等我们睡着，他们就潜入房里，在我们的水壶里倒入第二种药。"
        },
        {
          "role": "吉雅罗",
          "text": "这样，等我们第二天带着水壶出行，并且喝下水壶里的水时，两种药物就会起反应。"
        },
        {
          "role": "吉雅罗",
          "text": "我们就会…"
        },
        {
          "role": "阿鲁埃",
          "text": "这位客人，你到底在说什么？"
        },
        {
          "role": "阿鲁埃",
          "text": "咖啡？下毒？请不要在我的店里开这种玩笑。"
        },
        {
          "role": "阿鲁埃",
          "text": "如果影响到其他客人，我就要请你出去了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "店长，我来解释…",
              "dialogues": []
            },
            {
              "text": "她是我的朋友。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "向阿鲁埃讲述了吉雅罗的事。听完后，阿鲁埃无奈地离开了…"
        },
        {
          "role": "？？？",
          "text": "为了道歉，吉雅罗又买了三杯咖啡…"
        },
        {
          "role": "派蒙",
          "text": "这次的咖啡，可是你看着店长做的喔，绝对不会有问题了吧。"
        },
        {
          "role": "旅行者",
          "text": "不要再胡思乱想了。"
        },
        {
          "role": "吉雅罗",
          "text": "我知道了…不过，这一路上我确实找到了很多灵感。"
        },
        {
          "role": "吉雅罗",
          "text": "只要稍加整理，我一定能找到一种不留痕迹的完美手法！"
        },
        {
          "role": "吉雅罗",
          "text": "等我写好了那本小说，一定会马上寄给你看的。"
        },
        {
          "role": "吉雅罗",
          "text": "但在那之前，我要先喝完这杯咖啡，这杯…咖啡…"
        },
        {
          "role": "吉雅罗",
          "text": "呃，旅行者，你说…有没有可能…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你给我住嘴！",
              "dialogues": []
            },
            {
              "text": "别往下说了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "吉雅罗",
          "text": "这个杯子，本身就是有毒的？！"
        },
        {
          "role": "吉雅罗",
          "text": "对，没错…就是这样…"
        },
        {
