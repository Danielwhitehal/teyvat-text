{
  "quest_id": 77651,
  "chapter_num": null,
  "chapter_title": "曙光的一缕",
  "type": "wq",
  "route": "A Thread of Dawn-Light",
  "stories": [
    {
      "story_id": 77651,
      "title": "曙光的一缕",
      "description": "你在一座车站附近偶遇了阿罗夏，他似乎想为这座车站做一些事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与阿罗夏对话"
        },
        {
          "role": "派蒙",
          "text": "那不是阿罗夏吗？"
        },
        {
          "role": "阿罗夏",
          "text": "旅行者还有派蒙？有段时间没见了，派蒙的身体还好吗？"
        },
        {
          "role": "派蒙",
          "text": "不用担心啦，我的病已经痊愈了。阿罗夏在这边做什么呢？"
        },
        {
          "role": "阿罗夏",
          "text": "我想把这座废弃的车站修缮一下。"
        },
        {
          "role": "派蒙",
          "text": "那不是阿罗夏吗？"
        },
        {
          "role": "阿罗夏",
          "text": "旅行者还有派蒙？有段时间没见了，派蒙的身体还好吗？"
        },
        {
          "role": "派蒙",
          "text": "不用担心啦，我的病已经痊愈了。阿罗夏在这边做什么呢？"
        },
        {
          "role": "阿罗夏",
          "text": "我想把这座废弃的车站修缮一下。"
        },
        {
          "role": "派蒙",
          "text": "你也想修缮这座车站啊？"
        },
        {
          "role": "阿罗夏",
          "text": "看来你们已经和奥黛塔或者沃雅妮莎来过一趟了。"
        },
        {
          "role": "阿罗夏",
          "text": "修缮这座车站的想法本来是沃雅妮莎在一次聚会时随口提起的，我被她拉过来帮忙。"
        },
        {
          "role": "派蒙",
          "text": "不用担心，阿罗夏就先处理呼啸社那边的事，让我和旅行者去调查那些帮派成员。"
        },
        {
          "role": "旅行者",
          "text": "交给我们就好。"
        },
        {
          "role": "阿罗夏",
          "text": "…看来我准备的报酬要更多一些。"
        },
        {
          "role": "阿罗夏",
          "text": "辛苦你们了，等你们找到了那种供能核心，就在这里会合吧。"
        },
        {
          "role": "派蒙",
          "text": "其实，那些帮派的事我们已经调查过了。"
        },
        {
          "role": "派蒙",
          "text": "对了，我们最后不是拿到了一种特殊的晶体吗？它会不会就是这种炉子的供能核心？"
        },
        {
          "role": "阿罗夏",
          "text": "真是巧了，能给我看一下吗？"
        },
        {
          "role": "派蒙",
          "text": "阿罗夏，好久不见！"
        },
        {
          "role": "派蒙",
          "text": "我们从妖精帮派那里拿到了一种特殊的晶体，你看下它是不是我们要找的东西？"
        },
        {
          "role": "阿罗夏",
          "text": "那真是辛苦你们了，先给我看一下吧。"
        },
        {
          "role": "阿罗夏",
          "text": "如果这座车站能够重新运作起来，附近的居民都能够受益。"
        },
        {
          "role": "阿罗夏",
          "text": "可惜政府正忙于执行一个更宏大的计划，注意不到这座小小的车站，只能靠我这样的公民自发出力了。"
        },
        {
          "role": "阿罗夏",
          "text": "不过我觉得这样也不错，不需要瞄准和开枪，同样也能践行呼啸社的理念。"
        },
        {
          "role": "旅行者",
          "text": "我和派蒙也来帮忙吧。"
        },
        {
          "role": "派蒙",
          "text": "对啊，类似这样的事我和旅行者做过不少呢。"
        },
        {
          "role": "阿罗夏",
          "text": "好啊，不过不能让你们白白帮忙，我还是会好好准备报酬的。"
        },
        {
          "role": "旅行者",
          "text": "你想从哪里开始修缮？"
        },
        {
          "role": "阿罗夏",
          "text": "我想先修好这座车站的暖源，不过…"
        },
        {
          "role": "阿罗夏",
          "text": "我请呼啸社的技术人员来检查过，说是这种炉子缺少一种供能核心，没办法启动。"
        },
        {
          "role": "派蒙",
          "text": "供能核心？该去哪里找？"
        },
        {
          "role": "阿罗夏",
          "text": "我现在也没有头绪，总之它和白沙皇时期发掘的影域科技有关。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这样的话…",
            "妖精帮派那边…"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "确实，之前我和你发现那座地底遗迹的时候遇到过不少帮派成员。"
        },
        {
          "role": "阿罗夏",
          "text": "我记得他们说过，妖精帮派正在秘密挖掘各种影域科技造物，他们手里很可能有我们要找的东西。"
        },
        {
          "role": "阿罗夏",
          "text": "我听呼啸社的朋友讲，距离这里不远的地方就有帮派成员在活动。"
        },
        {
          "role": "阿罗夏",
          "text": "不过，从头开始调查的话，谁知道什么时候才能找到我们需要的东西？最近，呼啸社那边的事务也不少…"
        },
        {
          "role": "阿罗夏",
          "text": "看来得先推迟一下这座车站的修缮工作了，等以后有机会吧。"
        },
        {
          "role": "阿罗夏",
          "text": "辛苦你们了，等你们找到了那种供能核心，就在这里会合吧。"
        },
        {
          "role": "阿罗夏",
          "text": "能把那种晶体给我看一下吗？"
        },
        {
          "role": "派蒙",
          "text": "真的修好了！这种炉子真厉害，我已经有暖洋洋的感觉了。"
        },
        {
          "role": "阿罗夏",
          "text": "这一步总算完成了，多亏了你们，请好好收下我的报酬。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿…还有其他需要帮忙的事吗？"
        },
        {
          "role": "阿罗夏",
          "text": "之前我还说过要挑几只可爱的小狗来这里做看护，不过这就不用劳烦你们了。"
        },
        {
          "role": "阿罗夏",
          "text": "等修缮工作全部完成后，这座车站作为一个临时聚会的场所应该很不错。"
        },
        {
          "role": "阿罗夏",
          "text": "旅行者还有派蒙，有空的话一定要赏光啊。"
        },
        {
          "role": "派蒙",
          "text": "嗯，一定！"
        }
      ]
    }
  ]
}