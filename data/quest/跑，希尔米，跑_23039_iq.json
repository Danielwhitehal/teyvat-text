{
  "quest_id": 23039,
  "chapter_num": null,
  "chapter_title": "跑，希尔米，跑",
  "type": "iq",
  "route": "Run, Hilmi, Run!",
  "stories": [
    {
      "story_id": 23039,
      "title": "跑，希尔米，跑",
      "description": "感受到孩子们热切且急迫的视线…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与奥贝德对话"
        },
        {
          "role": "奥贝德",
          "text": "大哥哥！请等一下！"
        },
        {
          "role": "奥贝德",
          "text": "请问…你是冒险家吗？就是那种去过很多地方冒险，很擅长战斗的冒险家！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "算是吧。",
              "dialogues": []
            },
            {
              "text": "这么说倒也没问题…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥贝德",
          "text": "你看！希尔米，我就说这位大哥哥一定是冒险家！"
        },
        {
          "role": "希尔米",
          "text": "但是冒险家不都是穿那种绿绿的衣服吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我比较厉害，不用那么穿。",
              "dialogues": []
            },
            {
              "text": "我比较特别，不用那么穿。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希尔米",
          "text": "喔——"
        },
        {
          "role": "奥贝德",
          "text": "喔——"
        },
        {
          "role": "奥贝德",
          "text": "那大哥哥！你肯定能帮我们这个忙啦！"
        },
        {
          "role": "奥贝德",
          "text": "你看见村子里那个大大的仓库了吗？哈巴奇哥哥说，里面装着很重要的东西，必须要好好防守。"
        },
        {
          "role": "希尔米",
          "text": "他还和我们说，如果有坏蛋来攻击村子，他就要先去把升降梯停掉，然后切断吊桥…"
        },
        {
          "role": "奥贝德",
          "text": "可那个仓库离升降梯还有好一段距离呢，哈巴奇哥哥要是想停掉升降梯，还得拼命跑过去。"
        },
        {
          "role": "奥贝德",
          "text": "我们就提出，我们可以陪他练习，但哈巴奇哥哥都不搭理我们…"
        },
        {
          "role": "希尔米",
          "text": "明明每次我们想去打水漂的时候，他都反应那么大，嘁…"
        },
        {
          "role": "奥贝德",
          "text": "咳，总之！如果坏人来攻击村里，哈巴奇哥哥又跑不动了，那就只能由我们去停掉升降梯啦。"
        },
        {
          "role": "奥贝德",
          "text": "大哥哥，你是个冒险家，肯定很擅长跑步吧，就请你陪我们训练一下吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我就陪你们跑一段。",
              "dialogues": [
                {
                  "role": "奥贝德",
                  "text": "好耶！谢谢大哥哥！"
                }
              ]
            },
            {
              "text": "可以相信哈巴奇的…",
              "dialogues": [
                {
                  "role": "奥贝德",
                  "text": "欸…就陪我们玩…"
                },
                {
                  "role": "奥贝德",
                  "text": "陪，陪我们训练一下吧，大哥哥，拜托啦！"
                },
                {
                  "role": "旅行者",
                  "text": "好吧…"
                },
                {
                  "role": "奥贝德",
                  "text": "好耶！谢谢大哥哥！"
                }
              ]
            }
          ]
        },
        {
          "role": "希尔米",
          "text": "我们已经选好起点了，我们去那边吧，大哥哥。"
        },
        {
          "role": "希尔米",
          "text": "嘿嘿，这次就由我来和你对决。先说好，我可是很擅长跑步的喔。"
        },
        {
          "type": "subtitle",
          "text": "参与赛跑"
        },
        {
          "type": "subtitle",
          "text": "与希尔米对话"
        },
        {
          "role": "希尔米",
          "text": "呼…呼…我赢啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "恭…恭喜你…",
              "dialogues": []
            },
            {
              "text": "跑…跑这么快…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希尔米",
          "text": "嘿嘿，我说了很擅长跑步的，大哥哥难道是轻敌了吗？"
        },
        {
          "role": "奥贝德",
          "text": "不过，就算是跑这么快，哈巴奇哥哥还是会抓住我们，到底是为什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也许是抄了近路。",
              "dialogues": []
            },
            {
              "text": "也许是有什么诀窍…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥贝德",
          "text": "是这样吗？唔…但是这周围好像也没什么近路啊…"
        },
        {
          "role": "希尔米",
          "text": "不然，我们下次请大哥哥来陪我们玩…"
        },
        {
          "role": "希尔米",
          "text": "陪我们训练！那个…训练那个「野外匿踪」吧！"
        },
        {
          "role": "奥贝德",
          "text": "对喔，既然跑不过哈巴奇哥哥，那我们就绕开他…"
        },
        {
          "role": "希尔米",
          "text": "我们之前不都绕过了吗？但是无论如何都会被哈巴奇哥哥发现的啦…"
        },
        {
          "type": "subtitle",
          "text": "与希尔米对话"
        },
        {
          "role": "希尔米",
          "text": "呼…呼…大哥哥…跑得好快…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我…我是冒险家嘛…",
              "dialogues": []
            },
            {
              "text": "跑…跑得多了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥贝德",
          "text": "以这种速度，肯定还是会被哈巴奇哥哥赶上的，这可怎么办…"
        },
        {
          "role": "希尔米",
          "text": "而且每次哈巴奇哥哥抓住我们的时候都一副很轻松的模样，都根本不像是跑过步的样子。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也许是抄了近路。",
              "dialogues": []
            },
            {
              "text": "也许是有什么诀窍…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥贝德",
          "text": "是这样吗？唔…但是这周围好像也没什么近路啊…"
        },
        {
          "role": "希尔米",
          "text": "不然，我们下次请大哥哥来陪我们玩…"
        },
        {
          "role": "希尔米",
          "text": "陪我们训练！那个…训练那个「野外匿踪」吧！"
        },
        {
          "role": "奥贝德",
          "text": "对喔，既然跑不过哈巴奇哥哥，那我们就绕开他…"
        },
        {
          "role": "希尔米",
          "text": "我们之前不都绕过了吗？但是无论如何都会被哈巴奇哥哥发现的啦…"
        }
      ]
    }
  ]
}