{
  "quest_id": 76129,
  "chapter_num": null,
  "chapter_title": "协力之委托",
  "type": "wq",
  "route": "Collaborative Commission",
  "stories": [
    {
      "story_id": 76129,
      "title": "协力之委托",
      "description": "凯瑟琳似乎有话想说…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与凯瑟琳对话"
        },
        {
          "role": "凯瑟琳",
          "text": "再次感谢您对协会的帮助，奈芙尔老板，雅珂达小姐。"
        },
        {
          "role": "奈芙尔",
          "text": "合作而已，无需这么客气。"
        },
        {
          "role": "萨林",
          "text": "话是这么说，但我还是要感谢奈芙尔老板，愿意帮助协会进行一些…复杂的调查工作。"
        },
        {
          "role": "奈芙尔",
          "text": "冒险家协会也分出了不少人手来协助我们的工作，算是合作共赢。"
        },
        {
          "role": "奈芙尔",
          "text": "希望我们之后，也能合作得这么愉快，萨林先生。"
        },
        {
          "role": "萨林",
          "text": "请奈芙尔老板放心，我们冒险家协会…"
        },
        {
          "role": "萨林",
          "text": "噢，我得严谨点。我们挪德卡莱冒险家协会分部，绝对是一个值得信赖的合作对象。"
        },
        {
          "role": "奈芙尔",
          "text": "呵呵，看得出来。"
        },
        {
          "role": "雅珂达",
          "text": "（好好好，就这么聊，奈姐奈姐，亲爱的奈姐，别看我别看我别看我…）"
        },
        {
          "role": "奈芙尔",
          "text": "雅珂达，你怎么不说话？"
        },
        {
          "role": "雅珂达",
          "text": "（还是看我了啊！那别看委托板别看委托板别看委托板——）"
        },
        {
          "role": "雅珂达",
          "text": "啊？我、我没什么要说的呀？谢谢…给我委托…？"
        },
        {
          "role": "萨林",
          "text": "噗，也要感谢雅珂达小姐的协助，要是没了您，协会的事务怕是要堆成山了。"
        },
        {
          "role": "雅珂达",
          "text": "不客气不客气…我都拿钱了，肯定要好好做呀…"
        },
        {
          "role": "奈芙尔",
          "text": "（唉，之前教她的话术，只怕又忘光了…）"
        },
        {
          "role": "奈芙尔",
          "text": "对了，既然来都来了…"
        },
        {
          "role": "雅珂达",
          "text": "（不要啊！气氛这么好，老板你就放过我吧！）"
        },
        {
          "role": "奈芙尔",
          "text": "麻烦萨林先生，把最新的一批委托拿过来吧。"
        },
        {
          "role": "奈芙尔",
          "text": "雅珂达，你来选一个，你觉得最应该做的委托。"
        },
        {
          "role": "奈芙尔",
          "text": "好好想，慢慢选，好吗？"
        },
        {
          "role": "雅珂达",
          "text": "是…是，老板…"
        },
        {
          "role": "雅珂达",
          "text": "（呜哇——完！蛋！啦——）"
        }
      ]
    }
  ]
}