{
  "quest_id": 10059,
  "chapter_num": "",
  "chapter_title": "厄瑞玻斯的秘密",
  "type": "wq",
  "route": "Erebos' Secret",
  "stories": [
    {
      "story_id": 72268,
      "title": "八衢彦之试炼",
      "description": "你接受了试炼，准备前往狭间之街寻找「天光流泻之处」…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆前往「天光流泻之处」"
        },
        {
          "type": "subtitle",
          "text": "◆在「常夜」时调查池水"
        },
        {
          "type": "subtitle",
          "text": "◆和封印前的残魂对话"
        },
        {
          "role": "宇陀",
          "text": "我乃末代地走官·宇陀。珊瑚宫之勇者，我认可你挑战的荣誉。"
        },
        {
          "role": "宇陀",
          "text": "我将主持「智慧」之试炼。请你动身去解开所有的谜题，让「高门之火」归位。"
        },
        {
          "role": "宇陀",
          "text": "如果没有足够的智慧，勇往直前并不能称为勇敢，只是鲁莽罢了！"
        },
        {
          "role": "宇陀",
          "text": "我将在上方三界塔处等候你完成挑战。"
        },
        {
          "type": "subtitle",
          "text": "◆解放所有「高门之火」（4/4）"
        },
        {
          "type": "subtitle",
          "text": "◆和宇陀对话"
        },
        {
          "role": "宇陀",
          "text": "我乃末代地走官·宇陀，于此认可你的勇武。"
        },
        {
          "role": "宇陀",
          "text": "你的智慧，可称得上「智圆行方」了。"
        },
        {
          "role": "派蒙",
          "text": "怎么从这种的试炼看出来人品德的？"
        },
        {
          "role": "宇陀",
          "text": "这其实是以前历史里现人神巫女夸青年才俊的话，后来变成了地走官部门里每年流动的小锦旗。"
        },
        {
          "type": "subtitle",
          "text": "过场动画：光柱升起",
          "narration": true,
          "color": "描述"
        }
      ]
    },
    {
      "story_id": 72269,
      "title": "八衢姬之试炼",
      "description": "你接受了试炼，准备前往常夜灵庙寻找「天光流泻之处」…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆前往「天光流泻之处」"
        },
        {
          "type": "subtitle",
          "text": "◆在「常夜」时调查池水"
        },
        {
          "type": "subtitle",
          "text": "◆和封印前的残魂对话"
        },
        {
          "role": "江木",
          "text": "我乃末代地走官·江木。珊瑚宫之勇者，我认可你挑战的荣誉。"
        },
        {
          "role": "江木",
          "text": "我将主持「明察」之试炼。请你动身去解开所有的谜题，让「高门之火」归位。"
        },
        {
          "role": "江木",
          "text": "战场瞬息万变。唯有耳观八方、眼观六路才能把握情况，把握一切变数。"
        },
        {
          "type": "subtitle",
          "text": "◆解放所有「高门之火」（4/4）"
        },
        {
          "type": "subtitle",
          "text": "◆和江木对话"
        },
        {
          "role": "江木",
          "text": "利落地完成了试炼。我，末代地走官·江木，于此认可你的勇武。"
        },
        {
          "role": "江木",
          "text": "你的明察，可称得上「微察冬鳗」了。"
        },
        {
          "role": "派蒙",
          "text": "这又是什么意思？"
        },
        {
          "role": "江木",
          "text": "繁殖时节的小陆鳗鳗鱼苗真的非常非常小哦。要集中注意力眯起眼睛才能看到。"
        },
        {
          "type": "subtitle",
          "text": "过场动画：光柱升起",
          "narration": true,
          "color": "描述"
        }
      ]
    },
    {
      "story_id": 72270,
      "title": "歧之试炼",
      "description": "你接受了试炼，准备前往蛇心之地寻找「天光流泻之处」…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "'''常夜'''",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往「天光流泻之处」"
        },
        {
          "type": "subtitle",
          "text": "在「常夜」时调查池水"
        },
        {
          "type": "subtitle",
          "text": "和封印前的残魂对话"
        },
        {
          "role": "大门",
          "text": "我乃末代地走官·大门。珊瑚宫之勇者，我认可你挑战的荣誉。"
        },
        {
          "role": "大门",
          "text": "勇武即是不择手段战胜一切敌人的能力。你只要打败所有敌人解放「高门之火」就可以了。"
        },
        {
          "role": "大门",
          "text": "顺带一提，此处的敌人皆是虚像。乃是阳炎幻法与你自己内心所知晓的强敌之印象互摄而成的。"
        },
        {
          "role": "大门",
          "text": "尽管如此，稍有不慎还是会受伤甚至被打垮的。"
        },
        {
          "role": "大门",
          "text": "我将在上方三界塔处等候你完成挑战。"
        },
        {
          "type": "subtitle",
          "text": "解放所有「高门之火」（4/4）"
        },
        {
          "type": "subtitle",
          "text": "和大门对话"
        },
        {
          "role": "大门",
          "text": "漂亮漂亮！把一切强敌都粉碎了！"
        },
        {
          "role": "大门",
          "text": "如此威武，可称「常世无双」！我，末代地走官·大门，于此认可你的勇武。"
        },
        {
          "type": "subtitle",
          "text": "过场动画：光柱升起",
          "narration": true,
          "color": "描述"
        }
      ]
    },
    {
      "story_id": 72275,
      "title": "三隅道大演武",
      "description": "听闻了乌帽子巫女的介绍，你觉得前往渊下宫边陲三角进行试炼也无不可。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆与残影对话"
        },
        {
          "role": "？？？",
          "text": "此身既然已经显现，那血枝珊瑚应该已入海祇之手。让人欣慰。"
        },
        {
          "role": "？？？",
          "text": "我名厄伯斯，稻妻式名字是乌帽子。乃是珊瑚宫之辅弼，渊下宫巫女中的一位。"
        },
        {
          "role": "乌帽子",
          "text": "您应该就是取得珊瑚枝的勇者吧？"
        },
        {
          "role": "旅行者",
          "text": "是我没错。"
        },
        {
          "role": "乌帽子",
          "text": "实在抱歉，我要讲述之事可能过于复杂，不知应该如何说起。"
        },
        {
          "role": "派蒙",
          "text": "你可以从头开始说，我们会听的。"
        },
        {
          "role": "乌帽子",
          "text": "非常感谢。那么，就请容我为您稍事介绍吧。这要从海祇大御神打通海渊之门说起。"
        },
        {
          "role": "乌帽子",
          "text": "渊下宫的深处有一处天然溶洞，便是通往海祇岛之路。也是海祇所许诺的地上乐土。"
        },
        {
          "role": "乌帽子",
          "text": "我们在大御神的授意下，学习了鸣神文化，并且曾与诸方土地建立了外交。"
        },
        {
          "role": "乌帽子",
          "text": "鸣神岛还称赞我们的「海祇美人」呢。因为我们海祇人肤质细嫩，可以令七种难隐的污痕都不再显眼。"
        },
        {
          "role": "乌帽子",
          "text": "这种说法的来由呢，是因为我们和祖先都在渊下宫生活得不到日照…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说重点。",
              "dialogues": []
            },
            {
              "text": "怎么又是这话。说重点。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "乌帽子",
          "text": "啊，抱歉。以前日子与诸国外交，我作为珊瑚宫之辅弼，经常担任向导。一不小心就…"
        },
        {
          "role": "乌帽子",
          "text": "话说回来吧。我与珊瑚宫大人产生了分歧，在海祇大御神的调停之下，我们有了现在的这个方案。"
        },
        {
          "role": "乌帽子",
          "text": "因为渊下宫有「罪影」这种现象，「过去」、「历史」、「真相」这种东西，放着不管也会永世长存。"
        },
        {
          "role": "乌帽子",
          "text": "所以我们费心尽力，并不是为了铭记，而是为了「遗忘」。很明显，珊瑚宫大人就是这么想的。"
        },
        {
          "role": "派蒙",
          "text": "（她说的珊瑚宫，应该是很久以前的珊瑚宫巫女吧…）"
        },
        {
          "role": "乌帽子",
          "text": "取珊瑚枝的试炼，就是尽可能少地让后人接触事件全貌的设计。"
        },
        {
          "role": "乌帽子",
          "text": "而我则支持留下真相。因此海祇大御神许可我在此追加一道试炼，通过的话，就可以知晓秘密。"
        },
        {
          "role": "乌帽子",
          "text": "请您接受这个挑战吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我接受挑战。",
              "dialogues": []
            },
            {
              "text": "我对秘密很感兴趣。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "乌帽子",
          "text": "如此甚好，那么我来为你启动追加的试炼。"
        },
        {
          "type": "subtitle",
          "text": "过场动画：岛屿显现",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "乌帽子",
          "text": "边陲三角的试炼之地已经准备好了。"
        },
        {
          "role": "乌帽子",
          "text": "那么我来传达剩下三场试炼的线索吧。"
        },
        {
          "role": "乌帽子",
          "text": "请你在常夜之中，远望白夜国的边疆吧。"
        },
        {
          "role": "乌帽子",
          "text": "——「于昏冥的常世之夜中，于奔流的冥河之外，于无罪的天光流泻之处。」"
        },
        {
          "role": "乌帽子",
          "text": "请你解开天光流泻之处的封印，升入天之门扉到达试炼之处。"
        },
        {
          "role": "旅行者",
          "text": "天光流泻之处?"
        },
        {
          "role": "乌帽子",
          "text": "在夜晚可以看到自穹顶落下的三道光柱，这些光柱指向了天光流泻之处。"
        },
        {
          "role": "派蒙",
          "text": "你说的有点太模糊了。"
        },
        {
          "role": "乌帽子",
          "text": "抱歉，海祇大御神它写的台本就是这样的。语焉不详的指示也是试炼的老传统了嘛。"
        },
        {
          "role": "乌帽子",
          "text": "总之试炼之处的地走官们都是怪人。没有通过传送门过去的话，他们是不会和气说话的。"
        },
        {
          "role": "乌帽子",
          "text": "我唯有在这里恭候你踏破所有阻碍，取得所有认可之后归来。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "乌帽子",
          "text": "请您向地走官的常世之灵证明自己的勇武吧。"
        },
        {
          "role": "乌帽子",
          "text": "当你完成了所有挑战，我才能告诉你所有的秘密。"
        },
        {
          "role": "乌帽子",
          "text": "…唉，我像是个知道了点小秘密就忍不住想找人说的小姑娘似的。"
        },
        {
          "type": "subtitle",
          "text": "◆完成挑战（3/3）"
        },
        {
          "type": "subtitle",
          "text": "◆与乌帽子对话"
        },
        {
          "role": "乌帽子",
          "text": "如此您已经获得了所有地走官的认可。他们代行海祇之意志，因此你也获得了知道一切的权力。"
        },
        {
          "role": "乌帽子",
          "text": "您是拯救海祇万民的救主，亦是海祇认可之人。您有权知晓任何您关心的问题。"
        },
        {
          "role": "乌帽子",
          "text": "但是请您遵守规矩，一定不要将这些真相带离海渊。"
        },
        {
          "role": "乌帽子",
          "text": "你还有什么想知道的呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于深海龙蜥…",
              "dialogues": [
                {
                  "role": "乌帽子",
                  "text": "深海龙蜥是原始的元素生物，因为久居深海，所以并没有被天上降临的力量降伏。"
                },
                {
                  "role": "乌帽子",
                  "text": "它们其实非常聪明，而且擅长进化。在和我们战斗的历史里，甚至进化出了其他元素的品种。"
                },
                {
                  "role": "乌帽子",
                  "text": "如果它们学会了语言，甚至进化出蜥蜴人这种东西我都不会奇怪的。"
                },
                {
                  "role": "乌帽子",
                  "text": "「圣土化」的本质，其实就是它们宜居环境的拓张。也就是三界中的原始元素力量变得强势。"
                },
                {
                  "role": "乌帽子",
                  "text": "我们唯有使用海祇大御神生命力，唤醒它的第二眷属，将荒蛮的元素力转化掉。"
                }
              ]
            },
            {
              "text": "关于海祇大御神…",
              "dialogues": [
                {
                  "role": "乌帽子",
                  "text": "海祇大御神因为它的厄运，落入了「天之秩序」管辖之外的此处。"
                },
                {
                  "role": "乌帽子",
                  "text": "这件事毫无疑问是我等白夜国民的好运。它真的为了我们做了许多事情。"
                },
                {
                  "role": "乌帽子",
                  "text": "只不过也因为接触了我们，触碰了甚至在它诞生之前的真相。于是它被天京敕令，必须舍身成仁。"
                },
                {
                  "role": "乌帽子",
                  "text": "此番献头，必须做到无人怀疑。唯有此法，白夜之民才能被允许活在新的「七之秩序」之下。"
                }
              ]
            },
            {
              "text": "关于日月之前的事…",
              "dialogues": [
                {
                  "role": "乌帽子",
                  "text": "白夜国落入海渊之前，确实整个世界都在统一的文化之下。"
                },
                {
                  "role": "乌帽子",
                  "text": "后来发生了一场大战，天也倾覆，地也崩裂。这片土地在那时落下了漆黑的海渊。"
                },
                {
                  "role": "乌帽子",
                  "text": "而后，天之秩序似乎并不想让记得这一切的人残留在大地之上。我们寻找归途，却怎么也找不到。"
                },
                {
                  "role": "乌帽子",
                  "text": "直到很久以后，天之禁令的力量逐渐减弱了。海祇大御神掉入了这里。"
                }
              ]
            },
            {
              "text": "关于大日御舆…",
              "dialogues": [
                {
                  "role": "乌帽子",
                  "text": "大日御舆是贤人·阿布拉克设计的建筑。它拥有为海渊之下带来光的力量。"
                },
                {
                  "role": "乌帽子",
                  "text": "除此以外，还集成了很多功能。"
                },
                {
                  "role": "乌帽子",
                  "text": "总之很厉害。"
                }
              ]
            },
            {
              "text": "没有其他的事了。",
              "dialogues": [
                {
                  "role": "乌帽子",
                  "text": "那么好的。请你务必记住，渊下宫所遇之事，请当成永远的秘密吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "乌帽子",
          "text": "我名厄伯斯，稻妻式名字是乌帽子。"
        },
        {
          "role": "乌帽子",
          "text": "你于此证明了自己是无双的勇者，同时也是拯救海只万民的救主。您有权知晓任何您关心的问题。"
        },
        {
          "role": "乌帽子",
          "text": "但是请您遵守规矩，一定不要将这些真相带离海渊。"
        },
        {
          "role": "乌帽子",
          "text": "你还有什么想知道的呢？"
        },
        {
          "type": "subtitle",
          "text": "（提问选项与上同）",
          "narration": true
        }
      ],
      "collapse_ranges": [
        [
          35,
          38
        ],
        [
          46,
          51
        ]
      ]
    }
  ]
}