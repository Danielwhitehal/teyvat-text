{
  "quest_id": 70533,
  "chapter_num": null,
  "chapter_title": "恒动械画·七圣之篇",
  "type": "wq",
  "route": "Evermotion Mechanical Painting: Invoker",
  "stories": [
    {
      "story_id": 70533,
      "title": "恒动械画·七圣之篇",
      "description": "蒙德城的菲利斯·尤格似乎正在为某事而忙碌…",
      "dialogues": [
        {
          "role": "菲利斯·尤格",
          "text": "没想到，我的发明居然还有这种用处…"
        },
        {
          "role": "菲利斯·尤格",
          "text": "喔！你好，旅行者，没想到咱们又见面了…咳…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还以为你离开蒙德了。",
              "dialogues": [
                {
                  "role": "菲利斯·尤格",
                  "text": "我是有这个计划，不过嘛…万事万物总是变化无穷啊…"
                }
              ]
            },
            {
              "text": "你的发明又出问题了？",
              "dialogues": [
                {
                  "role": "菲利斯·尤格",
                  "text": "没有！这次没有，呃…不如说一开始就没有。"
                },
                {
                  "role": "菲利斯·尤格",
                  "text": "之前我请您帮忙那次，纯粹是因为魔物的问题，和我的发明没有关系嘛。"
                }
              ]
            }
          ]
        },
        {
          "role": "菲利斯·尤格",
          "text": "咳，这些暂时不提了，咱们说正事。"
        },
        {
          "role": "菲利斯·尤格",
          "text": "这次，我是接受了蒙德城冒险家协会的邀请，专门以一种卡牌的牌面为原型，用齿轮和机关创作了好几幅可以拆解再拼接的「械画」。"
        },
        {
          "role": "菲利斯·尤格",
          "text": "那个卡牌叫什么来着…对！「七圣召唤」，没错，就是这个名字。"
        },
        {
          "role": "菲利斯·尤格",
          "text": "据他们说，这几幅「械画」会分别送去这次「召唤王大奖赛」的举办区域，再做个什么小活动，让大奖赛的氛围更热闹一点…"
        },
        {
          "role": "菲利斯·尤格",
          "text": "唉，这些事对我来说实在是太复杂了。我还是专注于我的发明吧。"
        },
        {
          "role": "菲利斯·尤格",
          "text": "对了，蒙德的「械画」就在我身边，如果您想要试试拼接它的话，就请来体验一下吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "菲利斯·尤格",
          "text": "旅行者，怎么样？你是想来尝试拼接一下这幅「械画」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要试试。",
              "dialogues": [
                {
                  "role": "菲利斯·尤格",
                  "text": "哈哈哈，好，我相信以您的聪明才智，这幅「械画」绝对难不倒您。"
                },
                {
                  "role": "菲利斯·尤格",
                  "text": "「械画」就放在旁边，您可以直接去试试。"
                }
              ]
            },
            {
              "text": "还有别的事。",
              "dialogues": [
                {
                  "role": "菲利斯·尤格",
                  "text": "呃…没问题，等您有空了再来玩也行，反正我最近要一直呆在这…"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          9,
          11
        ]
      ]
    }
  ]
}