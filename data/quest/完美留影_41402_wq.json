{
  "quest_id": 41402,
  "chapter_num": null,
  "chapter_title": "完美留影",
  "type": "wq",
  "route": "Perfect Shot",
  "stories": [
    {
      "story_id": 41402,
      "title": "完美留影",
      "description": "璃月港的季同似乎找到了维修他那台「留影机」的方法…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与季同对话"
        },
        {
          "role": "季同",
          "text": "这位旅行者，请你留步。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么事吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "季同",
          "text": "虽然有点突然…但是，请问你对「留影机」有兴趣吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有一点兴趣…",
              "dialogues": []
            },
            {
              "text": "没什么兴趣…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "季同",
          "text": "哎，我这台「留影机」可不是一般的「留影机」，这可是枫丹的最新技术。"
        },
        {
          "role": "季同",
          "text": "从这台「留影机」里印出来的画，能有一种普通「留影机」没有的色调。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是怎么做到的…",
              "dialogues": []
            },
            {
              "text": "真的假的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "季同",
          "text": "哎！你怎么一副不相信的样子，你不信的话，就去冒险家协会那边问问去。"
        },
        {
          "role": "季同",
          "text": "之前我也不相信，摆弄了这台「留影机」半天没摆弄好，还是协会里的一位冒险家帮了我的忙。"
        },
        {
          "role": "季同",
          "text": "这「留影机」啊，和普通的「留影机」不一样的地方，就是在它里面多了个小结构。"
        },
        {
          "role": "季同",
          "text": "这个结格里填着一种特别的药剂，能让印出来的画带有特别的效果，可比普通「留影机」拍出来的画好看多了。"
        },
        {
          "role": "季同",
          "text": "怎么样？有兴趣的话，您先拿着这个玩玩？虽然这台里面的药剂种类不太多，但体验体验还是足够了。"
        },
        {
          "role": "季同",
          "text": "我之后还会枫丹去进一批全新的药剂，要是您有兴趣，欢迎来光顾。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那…谢谢了…",
              "dialogues": []
            },
            {
              "text": "那些药剂多少钱？",
              "dialogues": [
                {
                  "role": "季同",
                  "text": "这个…咳，您别担心，单支非常便宜。如果您买得多，到时候也能商量着优惠点…"
                }
              ]
            }
          ]
        },
        {
          "role": "季同",
          "text": "那这台「留影机」就送给您玩了，如果觉得不错，以后记得多多光顾我的生意。"
        }
      ]
    }
  ]
}