{
  "quest_id": 10208,
  "chapter_num": "彩糖与蔷薇的幻色颂 第二份礼物",
  "chapter_title": "赠予她甜蜜",
  "type": "eq",
  "route": "Give Her Sweetness",
  "stories": [
    {
      "story_id": 40167,
      "title": "赠予她甜蜜",
      "description": "有人在节日期间蠢蠢欲动，可不能让他们破坏了这份惊喜…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至第二天早上（8-10点）"
        },
        {
          "role": "派蒙",
          "text": "我们去多莉那边看看吧！"
        },
        {
          "role": "派蒙",
          "text": "坎蒂丝！原来你已经到了呀，多莉呢？"
        },
        {
          "type": "subtitle",
          "text": "寻找多莉"
        },
        {
          "role": "派蒙",
          "text": "坎蒂丝！原来你已经到了呀，多莉呢？"
        },
        {
          "role": "坎蒂丝",
          "text": "她刚走。多莉小姐好像今天一大早就在这边做生意了，我来得早，已经和她完成了交易。"
        },
        {
          "role": "坎蒂丝",
          "text": "她一拿到阿如村的通行证和税款减免证明，就马不停蹄地往城外去了。"
        },
        {
          "role": "派蒙",
          "text": "这家伙还真是一点时间都不浪费啊…"
        },
        {
          "role": "派蒙",
          "text": "所以结果如何？搞清楚那块宝石的来历了吗？"
        },
        {
          "role": "坎蒂丝",
          "text": "她说听须弥的宝石商人所言，这石头几个月前出自一处沙漠的无名遗迹。遗迹早已破败不堪，连墙上字迹都难以辨认。"
        },
        {
          "role": "坎蒂丝",
          "text": "但更令我在意的，是多莉小姐说还有一块与它相似的宝石。"
        },
        {
          "role": "派蒙",
          "text": "还有一块？"
        },
        {
          "role": "坎蒂丝",
          "text": "宝石被发现的时候已经从中间裂开，加工者判断无从修复，干脆就将它切割成了形状相似的两份。"
        },
        {
          "role": "派蒙",
          "text": "那另一块宝石现在在哪儿呢？"
        },
        {
          "role": "坎蒂丝",
          "text": "这也是我所关心的问题。若宝石真有预示未来的能力，那万一落入不法之徒手中的话，后果不堪设想。"
        },
        {
          "role": "坎蒂丝",
          "text": "恰好，我听闻今早沙漠里有商队被劫，事情发生在一处偏僻的小道上。"
        },
        {
          "role": "派蒙",
          "text": "这和另一块宝石的下落有联系吗？"
        },
        {
          "role": "坎蒂丝",
          "text": "我还无法准确判断。但一般会走小路的商队，不是做小本生意，就是在运输重要货物，行程计划较为保密…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你的意思是…",
            "犯人「预判」了商队行踪…"
          ]
        },
        {
          "role": "坎蒂丝",
          "text": "存在这种可能。"
        },
        {
          "role": "派蒙",
          "text": "听起来是要去实地调查一番了呢…花神诞祭的准备工作怎么办？"
        },
        {
          "role": "坎蒂丝",
          "text": "迪希雅说晚些时候在奥摩斯港见面就行。动作加快些的话，应该不会耽搁正事。"
        },
        {
          "role": "坎蒂丝",
          "text": "噢，当然，你们若是有其他安排，就不必随我一起前往沙漠了。"
        },
        {
          "role": "派蒙",
          "text": "说什么呢，不都答应坎蒂丝一起调查了吗？不用那么见外啦。"
        },
        {
          "role": "旅行者",
          "text": "现在就出发吧。"
        },
        {
          "role": "坎蒂丝",
          "text": "好，恕我多虑了。感谢你们的无私相助。"
        },
        {
          "type": "subtitle",
          "text": "前往案发地点"
        },
        {
          "role": "坎蒂丝",
          "text": "事发地点应该就在这附近了。"
        },
        {
          "role": "派蒙",
          "text": "还真是荒无人烟的小路呢…"
        },
        {
          "role": "坎蒂丝",
          "text": "旅行者，派蒙，你们来看这边。"
        },
        {
          "role": "坎蒂丝",
          "text": "感觉到了吗？"
        },
        {
          "role": "旅行者",
          "text": "有元素力的痕迹…"
        },
        {
          "role": "坎蒂丝",
          "text": "嗯，沙漠部落和镀金旅团中会用元素力的人也不少，其中也有人借此力量袭击商队，赚取不义之财。"
        },
        {
          "role": "派蒙",
          "text": "咦？那边是…破碎的木板？"
        },
        {
          "role": "坎蒂丝",
          "text": "是商队运输车碎裂后散落的木板，还有些…焦黑的痕迹？发生了爆炸吗？"
        },
        {
          "role": "坎蒂丝",
          "text": "那边有一些不久前留下的痕迹，我们沿路看看。"
        },
        {
          "type": "subtitle",
          "text": "向商队询问情况"
        },
        {
          "role": "雅库普",
          "text": "哎，你说这都什么个事儿，专门挑了条偏僻的路走，怎么还是被劫了？"
        },
        {
          "role": "坎蒂丝",
          "text": "各位好，抱歉打扰你们了…"
        },
        {
          "role": "雅库普",
          "text": "呃…！谁！"
        },
        {
          "role": "坎蒂丝",
          "text": "我是阿如村的守护者，坎蒂丝，想来了解一下今早发生的劫案。"
        },
        {
          "role": "海兹尔",
          "text": "守…守护者？！"
        },
        {
          "role": "雅库普",
          "text": "你慌什么慌？守护者是来守护咱的，又不是来抢咱的！"
        },
        {
          "role": "海兹尔",
          "text": "哦…对，也对…"
        },
        {
          "role": "雅库普",
          "text": "抱歉，让您见笑了，兄弟们刚被抢了一遭，还有些没缓过来…"
        },
        {
          "role": "坎蒂丝",
          "text": "没事的，请不用紧张，我很同情你们的遭遇。不过…各位是打算在此安营吗？明明喀万驿就在不远处…"
        },
        {
          "role": "雅库普",
          "text": "哎，东西全被抢光，我们实在咽不下这口气，本来打算叫上几个兄弟去和那劫匪拼了，再不济也能夺回些货来的…"
        },
        {
          "role": "坎蒂丝",
          "text": "你们的食粮看起来所剩无几，还请千万冷静。冲动与松懈，乃是沙漠中送命的第一步…"
        },
        {
          "role": "坎蒂丝",
          "text": "我能问问你们运的是什么货吗？"
        },
        {
          "role": "海兹尔",
          "text": "都是危险品。"
        },
        {
          "role": "坎蒂丝",
          "text": "嗯？"
        },
        {
          "role": "雅库普",
          "text": "你怎么说话的？那叫烟花爆竹！"
        },
        {
          "role": "海兹尔",
          "text": "可箱子上写的就是危险品。"
        },
        {
          "role": "雅库普",
          "text": "烟花爆竹不写危险品写啥？可食用品吗！"
        },
        {
          "role": "雅库普",
          "text": "哎，如您所见，兄弟有些不会说话，你别往心里记。这要是报告给喀万驿卫兵的话，免不了又是一顿盘问…"
        },
        {
          "role": "旅行者",
          "text": "（所以那些木片的焦痕…是因为火药的缘故？）"
        },
        {
          "role": "坎蒂丝",
          "text": "烟花爆竹…是要送去哪里呢？"
        },
        {
          "role": "雅库普",
          "text": "送给沙漠里的一些部落营地，最近不是花神诞祭嘛，谁都想庆祝一下，这类订单特多。"
        },
        {
          "role": "雅库普",
          "text": "就连我们这些做小本生意的，也能捞到些别人不想送的偏远单子。"
        },
        {
          "role": "坎蒂丝",
          "text": "原来是这样…我明白了。能再麻烦您描述下事件发生时的情况吗？"
        },
        {
          "role": "雅库普",
          "text": "哦，是这样…我们绕道小路，好端端走在路上的时候…"
        },
        {
          "role": "海兹尔",
          "text": "突然就被一片藤蔓荆棘拦住了！"
        },
        {
          "role": "派蒙",
          "text": "藤蔓？"
        },
        {
          "role": "雅库普",
          "text": "什么藤蔓？沙漠里哪来那么多藤蔓？只是推车突然陷地里不走了！肯定是中了陷阱！"
        },
        {
          "role": "雅库普",
          "text": "再然后啊…"
        },
        {
          "role": "海兹尔",
          "text": "天上突然开始下炸弹！"
        },
        {
          "role": "派蒙",
          "text": "炸弹？"
        },
        {
          "role": "雅库普",
          "text": "你能不能不说话？我看你是脑子被吓得要完蛋！"
        },
        {
          "role": "雅库普",
          "text": "你们别听他瞎说，他这明显就是惊吓过度…胡话停不下来了。"
        },
        {
          "role": "雅库普",
          "text": "困住我们之后，那劫匪就开始朝我们射火箭，还引燃了不少烟花。搞得我们人仰马翻，然后他们趁乱抢走了剩下的东西…"
        },
        {
          "role": "坎蒂丝",
          "text": "您看见那伙人的模样了吗？"
        },
        {
          "role": "雅库普",
          "text": "哎哟…这还真没看清。我们光顾着自己逃命，沙漠上又全是沙尘…"
        },
        {
          "role": "雅库普",
          "text": "不过我记得那人一直拿着块绿色的石头…"
        },
        {
          "role": "坎蒂丝",
          "text": "……"
        },
        {
          "role": "坎蒂丝",
          "text": "外形颜色是不是和这颗类似？"
        },
        {
          "role": "雅库普",
          "text": "欸，是的！还真像！我还纳闷呢，都有那种看起来值钱的东西了，干嘛来抢我们的这些破爆竹…"
        },
        {
          "role": "旅行者",
          "text": "（除非抢夺危险品不是为了钱，而是为了…）"
        },
        {
          "role": "坎蒂丝",
          "text": "我差不多了解了。谢谢各位提供的情报。"
        },
        {
          "role": "坎蒂丝",
          "text": "不过我还是劝你们尽早去喀万驿，向卫兵们报备情况。安全为上，别因为一时动怒而做出有勇无谋之举。"
        },
        {
          "role": "雅库普",
          "text": "好…好吧，那我们再休整休整就回去…"
        },
        {
          "role": "坎蒂丝",
          "text": "嗯。旅行者，我们走吧。"
        },
        {
          "role": "坎蒂丝",
          "text": "这个距离应该听不见了…旅行者，你怎么看？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "货物有些可疑…",
            "商队有些可疑…"
          ]
        },
        {
          "role": "坎蒂丝",
          "text": "嗯，我也这么觉得。那位商队首领对我们有所隐瞒。恐怕他们运送的货物远不止烟花爆竹那么简单。"
        },
        {
          "role": "坎蒂丝",
          "text": "而现在，「危险品」落到了另一批来历不明的劫匪手中…"
        },
        {
          "role": "派蒙",
          "text": "是黑吃黑吗？"
        },
        {
          "role": "坎蒂丝",
          "text": "很有可能。眼下更大的问题是，那一群抢走了「危险品」的劫匪，目的究竟是什么。"
        },
        {
          "role": "旅行者",
          "text": "最近是「花神诞祭」…"
        },
        {
          "role": "坎蒂丝",
          "text": "我理解你的担忧。从这精准的埋伏和高效的行动来看，对方很可能也见到了宝石的「预示」。"
        },
        {
          "role": "坎蒂丝",
          "text": "情况或许比我们想象的更危险。嗯…已经不是该瞒着大家的时候了，我们先回一趟喀万驿，向卫兵们说明情况吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（雅库普&海兹尔）"
        },
        {
          "role": "心声（雅库普）",
          "text": "（运货已经够累了…结果商队里还有个「蠢货」…哎，累上加累…）"
        },
        {
          "role": "心声（海兹尔）",
          "text": "（明明天上就是在掉炸弹…）"
        },
        {
          "role": "雅库普",
          "text": "不会说话可以不说话，下次不要抢我的话头！"
        },
        {
          "role": "海兹尔",
          "text": "但我没说错嘛…"
        },
        {
          "role": "雅库普",
          "text": "哎，真是服了…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿鲁吉）"
        },
        {
          "role": "心声（阿鲁吉）",
          "text": "（好疼…）"
        },
        {
          "role": "阿鲁吉",
          "text": "呃啊…我的腿…"
        },
        {
          "type": "subtitle",
          "text": "回到喀万驿"
        },

        {
          "role": "坎蒂丝",
          "text": "二位先在这里稍作休息吧，我去和卫兵们打个招呼就过来。"
        },
        {
          "role": "派蒙",
          "text": "事情还真是往意想不到的地方发展了呢…希望这次花神诞祭能平安度过。"
        },
        {
          "role": "赛诺",
          "text": "嗯？我隐约从你们口中听到了一些令「大风纪官」我在意的词语。"
        },
        {
          "role": "派蒙",
          "text": "赛诺！你怎么在这里！"
        },
        {
          "role": "赛诺",
          "text": "因公外出罢了。我正在调查一桩奇怪的抢劫案。"
        },
        {
          "role": "派蒙",
          "text": "欸？难道就是我们刚才遇到的那个！"
        },
        {
          "role": "旅行者",
          "text": "辛苦你了…"
        },
        {
          "role": "赛诺",
          "text": "不辛苦，我在路上买了个帕蒂沙兰布丁，准备放凉了吃，你们要吗？"
        },
        {
          "role": "派蒙",
          "text": "真的可以吗！谢谢你！"
        },
        {
          "role": "赛诺",
          "text": "怎么样？冷不丁吃到一块冷布丁的感觉。"
        },
        {
          "role": "派蒙",
          "text": "咳咳…！你呛到我了…干嘛冷不丁讲一个冷笑话…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "感觉好冷…",
            "你不会就为了说这个才买的…"
          ]
        },
        {
          "role": "赛诺",
          "text": "说回刚才的话题，你们遇到的抢劫案是…"
        },
        {
          "role": "赛诺",
          "text": "…是这样吗？你们和坎蒂丝已经先一步调查过了。"
        },
        {
          "role": "派蒙",
          "text": "嗯，具体的等坎蒂丝回来后再补充吧，总之那个被抢的商队也很可疑。"
        },
        {
          "role": "赛诺",
          "text": "我明白了，接下来交给我就好。"
        },
        {
          "role": "赛诺",
          "text": "对了，你们待会儿有安排吗？"
        },
        {
          "role": "派蒙",
          "text": "哦，我们可能会和坎蒂丝一起回去吧，和大家集合后准备惊…"
        },
        {
          "role": "旅行者",
          "text": "…派、派蒙！"
        },
        {
          "role": "派蒙",
          "text": "啊！准备惊…今天的晚饭！"
        },
        {
          "role": "旅行者",
          "text": "（赛诺的工作区域离纳西妲还挺近的…提纳里有告诉他「生日惊喜」的事吗？）"
        },
        {
          "role": "赛诺",
          "text": "…不对劲。你们难道有事瞒我？"
        },
        {
          "role": "派蒙",
          "text": "欸？没…没有吧！没有啦！我们绝没做什么见不得人的事！"
        },
        {
          "role": "赛诺",
          "text": "……"
        },
        {
          "role": "赛诺",
          "text": "你们知道为什么沙漠中的赤念果从不骗人吗？"
        },
        {
          "role": "派蒙",
          "text": "啊？为…为什么？"
        },
        {
          "role": "赛诺",
          "text": "因为…它的花瓣向来只有五片，绝不可能存在「七片」！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": [
                {
          "role": "赛诺",
          "text": "听懂了就说出秘密，没听懂的话，我给你解释一下…"
        },
        {
          "role": "派蒙",
          "text": "不用解释了啦！"
        }
              ]
            },
            {
              "text":  "哈哈，真好笑。",
              "dialogues": [
                {
          "role": "赛诺",
          "text": "真的吗？那就顺带将你的秘密一起说出来吧！"
        }
              ]
            }     
          ]
        },
        
        {
          "role": "派蒙",
          "text": "我们…我们真没藏什么了不得的秘密！"
        },
        {
          "role": "赛诺",
          "text": "是吗。那你敢对湖里的鲈鱼们发誓吗？"
        },
        {
          "role": "派蒙",
          "text": "对谁…？"
        },
        {
          "role": "赛诺",
          "text": "湖里的鲈鱼，它们可从不食「盐」。"
        },
        {
          "role": "旅行者",
          "text": "我撑不住了…"
        },
        {
          "role": "派蒙",
          "text": "我也不行了…原来被大风纪官审讯是这么痛苦的事吗…"
        },
        {
          "role": "坎蒂丝",
          "text": "嗯？什么审讯？我错过了什么？"
        },
        {
          "role": "派蒙",
          "text": "坎蒂丝！你可算回来了！快救救我们啊！"
        },
        {
          "role": "坎蒂丝",
          "text": "出什么事了？赛诺先生看起来倒是一脸愉快。"
        },
        {
          "role": "赛诺",
          "text": "别来无恙。"
        },
        {
          "role": "赛诺",
          "text": "旅行者已经和我说了事情经过，这件事放心交给我处理。"
        },
        {
          "role": "赛诺",
          "text": "但刚才问到下午的安排之后，{M他俩}{F她俩}就开始搪塞躲闪。"
        },
        {
          "role": "坎蒂丝",
          "text": "下午…不是要去奥摩斯港准备「惊喜」吗？"
        },
        {
          "role": "派蒙",
          "text": "欸！坎蒂丝！你…你怎么说出来了！"
        },
        {
          "role": "坎蒂丝",
          "text": "没有关系，赛诺先生原本也是计划中的一员。"
        },
        {
          "role": "派蒙",
          "text": "什么！赛诺你怎么不早说！"
        },
        {
          "role": "赛诺",
          "text": "本来打算说的。听到案件经过后，我还想让你们代我向大家请个假，谁知你们突然终止了谈话进度。"
        },
        {
          "role": "派蒙",
          "text": "我的天啊！居然白白挨了两个冷笑话…"
        },
        {
          "role": "旅行者",
          "text": "其实是三个…"
        },
        {
          "role": "坎蒂丝",
          "text": "原来一直没告诉你们计划中具体有哪些人吗…抱歉，是我们的疏忽…"
        },
        {
          "role": "赛诺",
          "text": "不论如何，误会解除就好，也麻烦你们帮忙带话了。"
        },
        {
          "role": "赛诺",
          "text": "还有，这是今天我负责采购的部分，同样辛苦你们带回去。"
        },
        {
          "role": "派蒙",
          "text": "行，包在我们身上。"
        },
        {
          "role": "赛诺",
          "text": "嗯，这包赤念果的确在你们身上。"
        },
        {
          "role": "派蒙",
          "text": "你够了啦！"
        },
        {
          "type": "subtitle",
          "text": "回到奥摩斯港集合"
        },
        {
          "role": "派蒙",
          "text": "呼…总算回来了，身子都暖和了点…"
        },
        {
          "role": "坎蒂丝",
          "text": "哈哈，我很少在工作之外的场合遇见赛诺先生。见到朋友回须弥来过花神诞祭，他一定也很开心吧。"
        },
        {
          "role": "派蒙",
          "text": "怪不得明明是工作状态还囤了一肚子的冷笑话…我真服了他…难道就不会冷到肚子痛吗？"
        },
        {
          "role": "坎蒂丝",
          "text": "啊…！呃…"
        },
        {
          "role": "派蒙",
          "text": "坎蒂丝？难道说…你又看到了有关未来的景象？"
        },
        {
          "role": "坎蒂丝",
          "text": "对…我看到…有两个人不久后会出现在那边的小巷里…"
        },
        {
          "role": "坎蒂丝",
          "text": "他们行迹可疑…似乎在聊一些危险的话题…"
        },
        {
          "role": "派蒙",
          "text": "危险的话题？难道说是那些抢了危险品的家伙！"
        },
        {
          "role": "旅行者",
          "text": "看得清对方面貌吗？"
        },
        {
          "role": "坎蒂丝",
          "text": "不…很遗憾，预示中的景象一直都很模糊，总共也只有三言两语…还都是片段…"
        },
        {
          "role": "派蒙",
          "text": "那我们赶快躲起来！如果是想要在花神诞祭上捣乱的坏人，就当场抓他们个现行！"
        },
        {
          "role": "艾尔海森",
          "text": "…并不清楚…"
        },
        {
          "role": "卡维",
          "text": "…暗号…"
        },
        {
          "role": "卡维",
          "text": "…爆炸发生…"
        },
        {
          "role": "派蒙",
          "text": "喂你们听到没有…那边好像有人在说很恐怖的事…"
        },
        {
          "role": "坎蒂丝",
          "text": "靠近点听听。"
        },
        {
          "role": "卡维",
          "text": "…等到…花车经过…我们就把那个推出去…"
        },
        {
          "role": "艾尔海森",
          "text": "…确定方向和…"
        },
        {
          "role": "卡维",
          "text": "…万无一失。"
        },
        {
          "role": "坎蒂丝",
          "text": "请停止你们正在谋划的事情！"
        },
        {
          "role": "卡维",
          "text": "欸？什么…发生什么事了？"
        },
        {
          "role": "派蒙",
          "text": "怎么是你们？你们到底在说什么可怕计划啊！"
        },
        {
          "role": "派蒙",
          "text": "什么爆炸啊，花车啊…"
        },
        {
          "role": "艾尔海森",
          "text": "一个人的联想便是他思想的证明。你可怕的联想来源于你的思维本身。"
        },
        {
          "role": "卡维",
          "text": "天啊派蒙，你在想什么呢…我们在讨论花神诞祭的惊喜。"
        },
        {
          "type": "subtitle",
          "text": "不久之前……",
          "narration": true,
          "color": "介绍"
        },
        {
          "role": "卡维",
          "text": "都说了问题根本不在那里，我和它的关系不是冰冷而社会化的…你这想法太过分了吧！"
        },
        {
          "role": "艾尔海森",
          "text": "好像是你先说它一整天没出现了，可能意识到你应当支付它薪水却始终未履行责任。"
        },
        {
          "role": "卡维",
          "text": "我这是丧气话啊！还不是从上次让它去买咖啡开始的吗！"
        },
        {
          "role": "艾尔海森",
          "text": "也许它发现院里有些新人也会自告奋勇去买咖啡，进而产生联想，对自身处境感到不满。"
        },
        {
          "role": "卡维",
          "text": "听听你说的什么话，我可没觉得它是实习生。唔，难道它独自买咖啡的过程很不顺利，受到打击就离家出走了？"
        },
        {
          "role": "卡维",
          "text": "然后回忆自己迄今为止的机械生涯，越想越生气…决定再也不回来！"
        },
        {
          "role": "艾尔海森",
          "text": "想象力丰富得很啊。"
        },
        {
          "role": "卡维",
          "text": "不可能啊，梅赫拉克是我造的，才不会这么冷血，怎么说我也每个星期都在用心保养它…"
        },
        {
          "role": "艾尔海森",
          "text": "然后你就一路找到奥摩斯港，偶遇在这里查收公务文件的我。"
        },
        {
          "role": "卡维",
          "text": "真巧，这不是正好要找你嘛。我的方案完工了，帮我看看吧。"
        },
        {
          "role": "艾尔海森",
          "text": "还以为你对自己的专业水平足够有信心。"
        },
        {
          "role": "卡维",
          "text": "不是啦，是让你确认这条路线是否符合预期。"
        },
        {
          "role": "艾尔海森",
          "text": "但很遗憾，我并不清楚当天花车的行进路线。"
        },
        {
          "role": "卡维",
          "text": "什么？你真就完全不管这些？院里没能说动你出点力？"
        },
        {
          "role": "艾尔海森",
          "text": "不是分内工作，我不知道也正常。他们说得动我吗？"
        },
        {
          "role": "卡维",
          "text": "说得也是…那好吧，请你帮忙参谋一下最后这个爆炸。"
        },
        {
          "role": "艾尔海森",
          "text": "爆炸？"
        },
        {
          "role": "卡维",
          "text": "对，根据需要，我设计的糖塔会准时撞到花车上，然后爆开，里面的装置将糖果发射到四面八方。"
        },
        {
          "role": "卡维",
          "text": "啊啊当然啦，不是那种很严重的爆炸，就像礼花那样。"
        },
        {
          "role": "卡维",
          "text": "我查了很多食品工程论文，确定糖料足够柔软，飞散的外壳也像霓裳花织出的布料一样软，不会有任何损伤。"
        },
        {
          "role": "卡维",
          "text": "等到暗号出现，我就让梅赫拉克从远处发动机关，确保爆炸发生在指定位置。"
        },
        {
          "role": "艾尔海森",
          "text": "打算选在什么时候引爆？"
        },
        {
          "role": "卡维",
          "text": "等到草神大人乘坐的花车经过时，会有人给暗号，到时我们就把那个推出去，然后——「嘭」！"
        },
        {
          "role": "艾尔海森",
          "text": "还得确定方向和湿度。"
        },
        {
          "role": "卡维",
          "text": "没错，都考虑到了，糖塔内部设置的机关就是用来控制对抗这些的。应该万无一失。"
        },
        {
          "type": "subtitle",
          "text": "回到话题……",
          "narration": true,
          "color": "介绍"
        },
        {
          "role": "派蒙",
          "text": "呼…什么啊…搞半天是这么回事…"
        },
        {
          "role": "艾尔海森",
          "text": "你们似乎从一开始就认定事实是另一种模样了。"
        },
        {
          "role": "派蒙",
          "text": "呃…这个…因为…"
        },
        {
          "role": "坎蒂丝",
          "text": "还是由我来说明吧。"
        },
        {
          "role": "卡维",
          "text": "看见「未来」的能力？这还真是玄乎…"
        },
        {
          "role": "艾尔海森",
          "text": "有意思。"
        },
        {
          "role": "艾尔海森",
          "text": "基于这种能力，你们为某类未知现象赋予「假设」，结果却有偏差。"
        },
        {
          "role": "艾尔海森",
          "text": "目前看来，问题未必出在结果上。"
        },
        {
          "role": "派蒙",
          "text": "什么意思？给个好理解的结论吧。"
        },
        {
          "role": "艾尔海森",
          "text": "假如坎蒂丝看到的景象不是「未来」而是「过去」，先前的情况也同样能够成立。"
        },
        {
          "role": "派蒙",
          "text": "过去？"
        },
        {
          "role": "艾尔海森",
          "text": "贾汉吉尔提到他的鼓风机之前也坏过一次。小型机械的损毁，场面应该不会相差太多。听他口气也是那样。"
        },
        {
          "role": "艾尔海森",
          "text": "最近又是花神诞祭，奥摩斯港繁忙的时候常有人将货物堆放在道路两旁。"
        },
        {
          "role": "艾尔海森",
          "text": "选择隐蔽场所谈话，这种事更是常见。"
        },
        {
          "role": "坎蒂丝",
          "text": "艾尔海森先生的意思是…我们恰好经历了某些往日发生过的事件？"
        },
        {
          "role": "艾尔海森",
          "text": "许多事看似稀奇，但也只是看似。"
        },
        {
          "role": "卡维",
          "text": "唔，一种可能是未来发生了偏差，另一种可能是看到了过去…两者相比，后面那种设想更让人好接受一些。"
        },
        {
          "role": "艾尔海森",
          "text": "可以这么说，但这种推论并不是为了照顾人的感受。我只是客观提供另一个思考角度。"
        },
        {
          "role": "派蒙",
          "text": "好像的确有那么些道理…"
        },
        {
          "role": "艾尔海森",
          "text": "触发这种现象的条件和原因，目前尚不清楚。如果要调查，两方面都留意一下吧。"
        },
        {
          "role": "卡维",
          "text": "另一个思考角度…等等，你提醒我了，也许梅赫拉克是受不了你才离家出走的？"
        },
        {
          "role": "艾尔海森",
          "text": "好一个天才的想法。说得像它第一天认识我一样。"
        },
        {
          "role": "卡维",
          "text": "我给它做过预设，让它能够识别你的声音，它确实认识你挺久了…难道另有隐情？嗯？"
        },
        {
          "role": "派蒙",
          "text": "卡维，梅赫拉克真失踪了吗？那正朝我们飞过来的那个是…"
        },
        {
          "role": "卡维",
          "text": "嗯？欸？！你跑哪儿去了啊！"
        },
        {
          "role": "梅赫拉克",
          "text": "哔哔——"
        },
        {
          "role": "卡维",
          "text": "店里咖啡豆不够了所以你去帮忙找货？呃…买不到也没关系的，不用做到这一步…"
        },
        {
          "role": "旅行者",
          "text": "（梅赫拉克还真是锲而不舍啊…）"
        },
        {
          "role": "派蒙",
          "text": "坎蒂丝？怎么了，在想什么？"
        },
        {
          "role": "坎蒂丝",
          "text": "我只是在想，虽然艾尔海森先生的假设有一定道理，但如此一来，沙漠中被劫的商队又该作何解释呢…"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "提纳里",
          "text": "哟，大家都来了？你们怎么愁眉苦脸的？"
        },
        {
          "role": "卡维",
          "text": "碰到了一些谜题而已。哦对，已经到集合的时间了是吧？我们干脆边走边说。"
        },
        {
          "role": "艾尔海森",
          "text": "我得去趟智慧宫，再见。"
        },
        {
          "role": "派蒙",
          "text": "好吧好吧，再见啦！"
        },
        {
          "role": "提纳里",
          "text": "…嗯？"
        },
        {
          "type": "subtitle",
          "text": "前往集合地点"
        },
        {
          "role": "珐露珊",
          "text": "我还以为你们不来了呢，一个两个身强力壮的年轻人，还不如一个老前辈到得早。"
        },
        {
          "role": "提纳里",
          "text": "哦，是这样的，珐露珊前辈，我们刚才在讨论一个问题…"
        },
        {
          "role": "珐露珊",
          "text": "什么问题能有堆糖塔紧急？之前不是一直因为找不到合适的糖料，都要赶不上花车巡游了吗？"
        },
        {
          "role": "珐露珊",
          "text": "说到这个，你找到解决办法了吗？"
        },
        {
          "role": "卡维",
          "text": "找到了，几十篇论文没白看。"
        },
        {
          "role": "珐露珊",
          "text": "这个年纪的小伙子手脚就是麻利。好，你们也别偷懒，再不快点就真来不及了。"
        },
        {
          "role": "提纳里",
          "text": "嗯…那边的问题就交给赛诺处理吧，我们光是在这里想也是浪费时间。"
        },
        {
          "role": "珐露珊",
          "text": "明白了就快点动起来，都多大了还要前辈在这儿催。"
        },
        {
          "role": "珐露珊",
          "text": "对了，卡维，你之前不是拜托我做一个模拟花车巡游的机关吗？我已经做好了。"
        },
        {
          "role": "卡维",
          "text": "这么快？不愧是珐露珊前辈。"
        },
        {
          "role": "珐露珊",
          "text": "哼！这点小事放在从前——我是说一百年前的从前，就和知论派的课后习题一样简单！"
        },
        {
          "role": "珐露珊",
          "text": "喏，拿去吧，试试看好不好用。"
        },
        {
          "role": "卡维",
          "text": "多谢多谢！"
        },
        {
          "role": "卡维",
          "text": "唔…旅行者，要不然你来试试吧？我更想在旁边着重观察一下花车的姿态，配合它的状态调整糖塔。"
        },
        {
          "role": "旅行者",
          "text": "行，交给我吧。"
        },
        {
          "type": "subtitle",
          "text": "与珐露珊对话"
        },
        {
          "role": "珐露珊",
          "text": "哦！不错，你模拟得还挺有几分模样。"
        },
        {
          "role": "卡维",
          "text": "嗯，多亏旅行者和珐露珊前辈，我已经能确定糖塔的结构图了。"
        },
        {
          "role": "珐露珊",
          "text": "接下来就是实际制作阶段了吧？你先画你的草图，我们在旁边做些糖果的准备工作。"
        },
        {
          "role": "珐露珊",
          "text": "柯莱和迪希雅呢？"
        },
        {
          "role": "坎蒂丝",
          "text": "她们最近都在迪娜泽黛小姐家里，忙着做糖果的装饰。她们都挺能干，不用担心。"
        },
        {
          "role": "派蒙",
          "text": "咦？说到这个，我们为什么不在须弥城里集合呀？那不是更方便吗？"
        },
        {
          "role": "卡维",
          "text": "因为那里离草神大人近了些，要是她出来散步，很可能碰上我们。"
        },
        {
          "role": "卡维",
          "text": "这里离须弥城有段距离，遇到她的风险低得多。"
        },
        {
          "role": "卡维",
          "text": "毕竟，要是精心准备的惊喜被草神大人看见…"
        },
        {
          "role": "纳西妲",
          "text": "嗯？你们在这里做什么呀？刚才好像提到了关于我的话题？"
        },
        {
          "role": "提纳里",
          "text": "……！"
        },
        {
          "role": "纳西妲",
          "text": "…嗯？"
        },
        {
          "role": "珐露珊",
          "text": "卡、卡、卡…卡维！！"
        },
        {
          "role": "卡维",
          "text": "欸？怎怎怎么了？"
        },
        {
          "role": "珐露珊",
          "text": "你…你看你做的都是什么设计啊！居然想在房顶采用这种材料！"
        },
        {
          "role": "卡维",
          "text": "啊…啊？"
        },
        {
          "role": "珐露珊",
          "text": "（演啊！）"
        },
        {
          "role": "珐露珊",
          "text": "这种设计，简直是要颠覆须弥几百年以来的传统呀！草神大人看到了都会伤心的！"
        },
        {
          "role": "卡维",
          "text": "我…我…啊哈哈也是啊，这个，这个立面，现在看看也不太能接受…"
        },
        {
          "role": "珐露珊",
          "text": "是你的话一定能很快改出新版的，对吧！"
        },
        {
          "role": "卡维",
          "text": "对对，我今晚就改出来！"
        },
        {
          "role": "纳西妲",
          "text": "原来是和建筑有关的话题吗？唔…我觉得有些创新也不错哟。"
        },
        {
          "role": "珐露珊",
          "text": "草神大人别在意，我们的这位后辈，什么都好，就是想法太跳脱，偶尔有些天马行空的设计也不奇怪。改改就行。"
        },
        {
          "role": "纳西妲",
          "text": "这样吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "别在意，别在意…",
            "让他改，让他改…"
          ]
        },
        
        {
          "role": "纳西妲",
          "text": "好吧，既然你也这么说的话…"
        },
        {
          "role": "纳西妲",
          "text": "不过，可以给我看看设计图吗？说不定我能帮上忙呢？"
        },
        {
          "role": "珐露珊",
          "text": "……！"
        },
        {
          "role": "纳西妲",
          "text": "咦？是不太方便吗？"
        },
        {
          "role": "卡维",
          "text": "这个…图纸…"
        },
        {
          "role": "纳西妲",
          "text": "（他们表情很不自然呢…是不好意思给我看吗？还是遇到了不方便说出口的麻烦？）"
        },
        {
          "role": "卡维",
          "text": "图纸被…呃，被朋友拿走了！对对，想起来了，我等会儿就去找他拿，啊哈哈，这家伙。"
        },
        {
          "role": "纳西妲",
          "text": "（唔…好在意…）"
        },
        {
          "role": "旅行者",
          "text": "（…！是妮露！）"
        },
        {
          "role": "妮露",
          "text": "…嗯？"
        },
        {
          "role": "旅行者",
          "text": "（救——命——啊——！）"
        },
        {
          "role": "妮露",
          "text": "呃…"
        },
        {
          "type": "subtitle",
          "text": "旅行者指了指纳西妲……"
        },
        {
          "role": "妮露",
          "text": "…啊！"
        },
        {
          "role": "妮露",
          "text": "草神大人！"
        },
        {
          "role": "纳西妲",
          "text": "嗯？妮露？怎么了？找我有事吗？"
        },
        {
          "role": "妮露",
          "text": "嗯！找了您好久呢。关于花神诞祭上要表演的节目，祖拜尔剧场的大家有些问题想要问您。"
        },
        {
          "role": "纳西妲",
          "text": "是这样吗？好吧，那我马上就过去。辛苦妮露跑这么远了。"
        },
        {
          "role": "妮露",
          "text": "没事没事，草神大人您能匀出时间来到大巴扎一趟，大家高兴还来不及呢。"
