{
  "quest_id": 75659,
  "chapter_num": null,
  "chapter_title": "来自英雄的认证！",
  "type": "wq",
  "route": "A Hero's Approval!",
  "stories": [
    {
      "story_id": 75659,
      "title": "来自英雄的认证！",
      "description": "在圣火竞技场的话事处，一位「战备联络人」正等待着你们的支援…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与「战备联络人」对话"
        },
        {
          "role": "伊拉德",
          "text": "您终于来了，英雄大人。"
        },
        {
          "role": "伊拉德",
          "text": "卑职在此等候多时，见到您的身影，疲惫竟一扫而空！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没错，我来得真好。",
              "dialogues": []
            },
            {
              "text": "有…有什么事？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "气氛突然变得好正式！我，我也要用正经的语气说话么？"
        },
        {
          "role": "伊拉德",
          "text": "啊，请别紧张，英雄大人和尊贵的向导，我简单介绍一下情况。"
        },
        {
          "role": "伊拉德",
          "text": "卑职是话事处的员工，战备联络人伊拉德，负责协助火神大人处理各部族巡逻队的训练事务。"
        },
        {
          "role": "伊拉德",
          "text": "根据传统，每过一段时间，各部族都会从年轻人中选拔新的战士，加入巡逻队。"
        },
        {
          "role": "伊拉德",
          "text": "同时，还要为老成员们设计较高难度的考核，以便他们挑战自我，不断进步。"
        },
        {
          "role": "伊拉德",
          "text": "相关的选拔与考核关卡，就是由战备联络人联合各部族的优秀战士一同设计的…"
        },
        {
          "role": "派蒙",
          "text": "哦呀，我听懂了！"
        },
        {
          "role": "派蒙",
          "text": "聊到战斗、竞速之类的挑战，玩家的确是专家，应该能帮你设计很多有意思的关卡。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你要给我发需求吗？",
              "dialogues": []
            },
            {
              "text": "你想成为我的甲方吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊拉德",
          "text": "不至于，不至于！卑职怎敢让英雄大人来做我份内的工作！那既是我的失职，又是对英雄大人的怠慢！"
        },
        {
          "role": "伊拉德",
          "text": "所有的考核关卡已经设计完毕了，我只是想请求英雄大人对这些关卡予以「认证」，同时，也是为战士们树立一个榜样。"
        },
        {
          "role": "伊拉德",
          "text": "就如书面考试需要满分，人们修习技艺也需要目标。强大的战士们率先通过这些考核关卡，会给后辈们无尽的动力。"
        },
        {
          "role": "伊拉德",
          "text": "比如，「回声之子」相关的考核关卡，就由「巴莱卡」的希诺宁大师认证…"
        },
        {
          "role": "伊拉德",
          "text": "「悬木人」和「花羽会」的关卡则分别请到了「马力卜」基尼奇大师和「武卡」恰斯卡大师，让许多战士满怀热情地挑战…"
        },
        {
          "role": "派蒙",
          "text": "原来是这个意思…那这次玩家岂不是成了…那句话怎么说的来着？"
        },
        {
          "role": "派蒙",
          "text": "「永远追不上的地平线」！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好，我来给大家当榜样。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊拉德",
          "text": "这气魄，不愧是英雄大人！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谦虚点，提瓦特遍地是高手。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊拉德",
          "text": "这气度，赞美英雄大人的品德！"
        },
        {
          "role": "伊拉德",
          "text": "那么，请容卑职在地图上标出几个考核关卡的位置，英雄大人随时可以前去大展身手！"
        }
      ]
    }
  ]
}