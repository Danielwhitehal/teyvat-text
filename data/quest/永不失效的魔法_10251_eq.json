{
  "quest_id": 10251,
  "chapter_num": "幻友绮旅 其三",
  "chapter_title": "永不失效的魔法",
  "type": "eq",
  "route": "The Magic That Never Fails",
  "stories": [
    {
      "story_id": 40241,
      "title": "永不失效的魔法",
      "description": "在众人的努力下，拯救幻想朋友的行动有了新进展…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至第二天8-10点"
        },
        {
          "type": "subtitle",
          "text": "前往秘密基地"
        },
        {
          "role": "百日白白音",
          "text": "我们也已经准备就绪了，食梦貘们饿了一整晚，今天一定能顺利完成任务。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是我们收集到的噩梦碎片。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "百日白白音",
          "text": "跟我们最初找到的那枚气味一样，错不了。那…我们就不客气了。"
        },
        {
          "role": "派蒙",
          "text": "看起来爆米花已经恢复正常了？"
        },
        {
          "role": "爆米花",
          "text": "哈…头不晕了。"
        },
        {
          "role": "爆米花",
          "text": "我想起来了…全都想起来了！谢谢你们这几天陪着我，还帮小焰解决了她的噩梦！"
        },
        {
          "role": "派蒙",
          "text": "嘻嘻不客气，话说你是怎么跟小焰走散的呀？幻想朋友不是应该生活在小朋友的脑海里吗？"
        },
        {
          "role": "爆米花",
          "text": "其实，小焰已经长大了…"
        },
        {
          "role": "爆米花",
          "text": "她工作很忙也很累，经常失眠。最近好不容易挤出时间到郊外散散心，却连打个盹都会做噩梦…"
        },
        {
          "role": "爆米花",
          "text": "「至少让她睡个好觉吧…」抱着这样的念头，我试着驱散噩梦，在梦里捣乱，将坏东西全部揍一遍，揍扁了为止！"
        },
        {
          "role": "爆米花",
          "text": "可事实是…我被卷进噩梦里的巨大风暴中。小焰醒了后，打盹的地方留下一个可恶的，不好的东西！"
        },
        {
          "role": "布伦妮",
          "text": "是噩梦碎片。"
        },
        {
          "role": "爆米花",
          "text": "我当然要第一时间把那种玩意砸坏！"
        },
        {
          "role": "派蒙",
          "text": "爆米花应该本来就挺暴躁的吧？"
        },
        {
          "role": "百日白白音",
          "text": "噩梦碎片更是加剧了它本身的性格。"
        },
        {
          "role": "爆米花",
          "text": "结果…又失败了！在那以后就变得晕晕乎乎的…再后来的事，你们也知道了。"
        },
        {
          "role": "布伦妮",
          "text": "现在噩梦碎片都被吃掉了，问题是不是都解决了？"
        },
        {
          "role": "百日白白音",
          "text": "小焰暂时摆脱了噩梦的困扰，但她的心理机制还没恢复正常…甚至可以说，问题有些严重。"
        },
        {
          "role": "百日白白音",
          "text": "刚刚食梦貘在消化噩梦碎片时，察觉到碎片里的情绪全都没被主动干预过…这是内心麻木的信号。"
        },
        {
          "role": "爆米花",
          "text": "她已经很久没有真正发自内心地笑了，也不再像小时候那样，漫无边际地畅想…脑子里再也没有古怪又有趣的画面…"
        },
        {
          "role": "爆米花",
          "text": "所以我也没办法随着她的想象力出现在她身边鼓励她…只能干着急。"
        },
        {
          "role": "百日白白音",
          "text": "如果连自己都放弃去感受和寻找快乐，任由负面情绪侵蚀…"
        },
        {
          "role": "派蒙",
          "text": "会怎么样？！"
        },
        {
          "role": "百日白白音",
          "text": "在日常的心理诊疗委托中，我们接待过这种类型的患者，在旁人看来他们或许并无异样。"
        },
        {
          "role": "百日白白音",
          "text": "但对本人而言，他们会逐渐感到空虚，失去感知美好的能力。"
        },
        {
          "role": "百日白白音",
          "text": "就像某位患者说的，「我还坐在这，但心里那个快乐的小孩再也不会回来了。」"
        },
        {
          "role": "爆米花",
          "text": "不行不行！绝对不行！我得帮她！"
        },
        {
          "role": "七七",
          "text": "那个小孩要去哪里？还回来吃饭吗？"
        },
        {
          "role": "瑶瑶",
          "text": "七七，这是一种比喻啦。呃…是比喻吧…还是拟人呢…"
        },
        {
          "role": "可莉",
          "text": "没关系，会回来！有时可莉刚从禁闭室放出来，会一口气跑很远很远，连琴团长都追不上我！"
        },
        {
          "role": "可莉",
          "text": "这时嘟嘟可就会跟我说，「再跑又要马上进禁闭室啦！」于是可莉就会乖乖地往回走。"
        },
        {
          "role": "派蒙",
          "text": "虽然可莉说的跟现在讨论的情况不太一样，但我觉得道理是相通的！"
        },
        {
          "role": "布伦妮",
          "text": "我懂你的意思。爆米花是小焰的幻想朋友，它说的话小焰一定会听的吧，让爆米花来开解小焰可行吗？"
        },
        {
          "role": "百日白白音",
          "text": "嗯。其实比起后期的心理诊疗，当事人能自我排解烦恼是最好的。"
        },
        {
          "role": "派蒙",
          "text": "可是爆米花说了，小焰已经很久没想起它了，所以看不见它也听不见它讲话吧？"
        },
        {
          "role": "布伦妮",
          "text": "所以当务之急，要让小焰想起爆米花…"
        },
        {
          "role": "爆米花",
          "text": "我要去找小焰！得去帮她！"
        },
        {
          "role": "布伦妮",
          "text": "喂别冲动——"
        },
        {
          "role": "可莉",
          "text": "小魔女会也要帮忙！"
        },
        {
          "type": "subtitle",
          "text": "前往稻妻城"
        },
        {
          "role": "派蒙",
          "text": "爆米花在那里！我们快靠近看看。"
        },
        {
          "role": "老板",
          "text": "小焰啊，你交上来的策划方案还差点意思，没什么创意啊，也没有爆点，再改改吧。"
        },
        {
          "role": "老板",
          "text": "其实你刚来工作时想法还不错，怎么越来越普通了…总之这次的比稿对我们很重要，公司也很看重你，你多上点心。"
        },
        {
          "role": "小焰",
          "text": "可是…这已经是第12稿…哎，收到。"
        },
        {
          "role": "派蒙",
          "text": "那不是…我们前几天在秋沙钱汤门口遇到的女孩吗？原来她就是小焰啊！"
        },
        {
          "role": "早柚",
          "text": "爆米花一直冲撞的那个人是她的老板吧。他们好像都看不见爆米花？"
        },
        {
          "role": "七七",
          "text": "小焰还是没想起爆米花…看不见。"
        },
        {
          "role": "瑶瑶",
          "text": "她长大后不爱扎小辫子了吗？"
        },
        {
          "role": "布伦妮",
          "text": "长头发打理起来太费时间了。"
        },
        {
          "role": "可莉",
          "text": "也不穿花裙子了？"
        },
        {
          "role": "布伦妮",
          "text": "我老妈总说「穿裤子方便干活」。但没关系，怎么舒服怎么穿。"
        },
        {
          "role": "老板",
          "text": "过两天还有个线下展会，你抽空陪客户去逛逛吧，招待好这个客户，我们明年的订单就靠他了！"
        },
        {
          "role": "老板",
          "text": "还有，设计图也顺手画了吧，你不是喜欢涂涂画画吗，虽然单看着一般但放在展示方案上还算能唬人。"
        },
        {
          "role": "老板",
          "text": "先画个草图，内容不重要，把样子做好看点，回头看客户意见再改改。"
        },
        {
          "role": "早柚",
          "text": "工作好多…好想逃…"
        },
        {
          "role": "派蒙",
          "text": "小焰，快拒绝他呀！"
        },
        {
          "role": "小焰",
          "text": "…好的。"
        },
        {
          "role": "派蒙",
          "text": "哎呀！气死我了！拿出你小时候火爆脾气来，像你写的顺口溜一样！"
        },
        {
          "role": "布伦妮",
          "text": "有了，我们可以用顺口溜让她想起小时候的事，想起爆米花。"
        },
        {
          "role": "布伦妮&可莉",
          "text": "撞翻眼泪虫，踢飞鼻涕怪…"
        },
        {
          "role": "瑶瑶&七七",
          "text": "管它多么凶和坏，一拳打到太空外！"
        },
        {
          "role": "派蒙",
          "text": "凶神恶煞都打败…下一句是什么啊早柚？"
        },
        {
          "role": "早柚",
          "text": "打败之后…完蛋了，爆米花念的时候我都在打瞌睡没记住…"
        },
        {
          "role": "小焰",
          "text": "凶神恶煞都打败…统统…统统装进大麻袋！"
        },
        {
          "role": "小焰",
          "text": "我现在立刻马上就要把你装进麻袋！"
        },
        {
          "role": "小焰",
          "text": "喂！站住！"
        },
        {
          "role": "老板",
          "text": "怎么了？还有什么不清楚的地方吗？"
        },
        {
          "role": "小焰",
          "text": "是你有点不清楚。你的修改意见一会要这样一会要那样，自己都不知道想要什么却希望我知道，麻烦想清楚再发话。"
        },
        {
          "role": "小焰",
          "text": "如果实在需要我来想，行，那就不要外行指导内行。别做完你又不满意，改了又说不合心意，你给不出高见还要赖我没创意。"
        },
        {
          "role": "小焰",
          "text": "口口声声说公司很看重我，我谢谢公司。我也很重视这份工作，每天都自费买咖啡提神，公司谢谢我了吗？"
        },
        {
          "role": "老板",
          "text": "公司对你是有激励方案的…"
        },
        {
          "role": "小焰",
          "text": "你别插嘴，让我说完。难不成是奖励我更多的工作？现在不归我管的活都归我来干了。"
        },
        {
          "role": "小焰",
          "text": "我又不是什么机关，不是拧紧发条就能一直运转的。"
        },
        {
          "role": "小焰",
          "text": "我的工作量已经严重超标了，睡眠严重不足，这样的状态不可能把工作做好。"
        },
        {
          "role": "小焰",
          "text": "作为老板，如果你做不到在专业上指导我，那就为我创造一个适合工作的环境。"
        },
        {
          "role": "小焰",
          "text": "最后，画画是我的私人爱好，不许你指手画脚，你最好把嘴闭牢！"
        },
        {
          "role": "老板",
          "text": "这…请你别生气！我反思我认错…对不起！是我考虑不周了。"
        },
        {
          "role": "老板",
          "text": "这样吧，你先放三个月带薪假，好好休息，恢复能量！"
        },
        {
          "role": "小焰",
          "text": "哈？"
        },
        {
          "role": "老板",
          "text": "我懂我懂，奖励不应该只停在表面，再发你三个月奖金，感谢你过往的贡献，你看还满意吗？"
        },
        {
          "role": "老板",
          "text": "三个月奖金…三个月奖金…三个月奖金…三个月奖金…"
        },
        {
          "role": "小焰",
          "text": "哈…哈哈…哈哈哈哈哈哈哈哈！"
        },
        {
          "role": "老板",
          "text": "你…没事吧？"
        },
        {
          "role": "小焰",
          "text": "哈哈…啊…欸？没、没。"
        },
        {
          "role": "老板",
          "text": "真的没事？"
        },
        {
          "role": "小焰",
          "text": "……"
        },
        {
          "role": "小焰",
          "text": "其实…有！"
        },
        {
          "role": "小焰",
          "text": "上次提交的方案还是很有竞争力的，我可以跟你详细说明，听完后你再判断有没有必要改。"
        },
        {
          "role": "小焰",
          "text": "但…我想先休两天假，回来再谈。"
        },
        {
          "role": "小焰",
          "text": "可…可以吗？"
        },
        {
          "role": "老板",
          "text": "不是说过非特殊情况最好不要请假吗？最近任务比较紧，辛苦坚持下…"
        },
        {
          "role": "小焰",
          "text": "对不起…但真的坚持不下去了…工作太多了，身体已经开始吃不消了。辛苦理解下…"
        },
        {
          "role": "老板",
          "text": "你一直没跟我提过，也总是按时完成工作，我以为你能处理过来。"
        },
        {
          "role": "小焰",
          "text": "按时完成工作是基本的职业素养吧。只是那些不太合理的、临时的、额外的工作…是全靠加班才能完成的…"
        },
        {
          "role": "小焰",
          "text": "最近都在加班…可以的话辛苦你重新调整一下我的工作安排？"
        },
        {
          "role": "老板",
          "text": "可客户这两天就会到，突然这么说也很难临时安排人手啊。"
        },
        {
          "role": "小焰",
          "text": "事实上…接待客户好像本来就不是我的工作职责…"
        },
        {
          "role": "小焰",
          "text": "哎…如果假期实在批不下来，其实我也已经准备好了说辞…"
        },
        {
          "role": "老板",
          "text": "先不要冲动！不要说那两个字！这样吧，你先休息，尽快调整好状态尽快返岗，好吗？尽、尽快吧！"
        },
        {
          "role": "小焰",
          "text": "好、好的…尽快。"
        },
        {
          "type": "subtitle",
          "text": "与小焰对话"
        },
        {
          "role": "小焰",
          "text": "呼…好险。我其实想说准备好了说辞去接待客户了…"
        },
        {
          "role": "小焰",
          "text": "……"
        },
        {
          "role": "小焰",
          "text": "爆米花…？爆米花真的是你！还有…欸？"
        },
        {
          "role": "瑶瑶",
          "text": "小焰姐姐好，我们都是爆米花的朋友哦！"
        },
        {
          "role": "小焰",
          "text": "等会…我的幻想朋友交到了除我以外的现实里的朋友？莫非我还在幻想中…"
        },
        {
          "type": "subtitle",
          "text": "爆米花将事件经过告诉了小焰，小魔女们在一旁七嘴八舌地补充细节…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "小焰",
          "text": "原来是这样…谢谢你们。抱歉，我想是我最近状态太差了才一直做噩梦，给大家添麻烦了。"
        },
        {
          "role": "早柚",
          "text": "别担心，噩梦已经被吃掉了，从现在开始你可以睡个好觉了！"
        },
        {
          "role": "七七",
          "text": "但面团大王说，你心理有问题。"
        },
        {
          "role": "布伦妮",
          "text": "喂！说话太直接了！大人会接受不了的！"
        },
        {
          "role": "派蒙",
          "text": "啊啊，听爆米花说，你最近工作很忙？"
        },
        {
          "role": "小焰",
          "text": "嗯…这是我第一份工作，刚开始我充满期待，想着一定要闯出一片天地。但很快就发现事情并不是我想象的那样…"
        },
        {
          "role": "小焰",
          "text": "做不完的工作，处理不好的关系，实现不了的计划…手上的难题还没解决，更大的难题就已经冒出来了。"
        },
        {
          "role": "小焰",
          "text": "乱七八糟的事压得人喘不过气来。每天下班后，我都累得不想说话，原本感兴趣的事也没力气做了，只想找个地方躺下。"
        },
        {
          "role": "布伦妮",
          "text": "理解，大人的世界不好玩，很冰冷，很残酷。"
        },
        {
          "role": "派蒙",
          "text": "你在理解什么啦！你又不是大人！"
        },
        {
          "role": "可莉",
          "text": "可莉听不懂，大人和小朋友不都在同一个世界上吗？妈妈说过，大人是长大的小孩，是穿着大人衣服的小孩。"
        },
        {
          "role": "小焰",
          "text": "欸？"
        },
        {
          "role": "早柚",
          "text": "我做过很多情报收集工作，有的大人私底下喜欢玩玩具，给小人偶配音，还会拿树叶和石子玩做饭游戏！{{#info:[[九条裟罗]]}}"
        },
        {
          "role": "早柚",
          "text": "但我不能说是谁哦…"
        },
        {
          "role": "爆米花",
          "text": "我们也可以跟小时候一样随时随地玩打怪兽游戏，或者踩着家具躲避岩浆，只要你愿意想，就能做到！"
        },
        {
          "role": "小焰",
          "text": "就像刚才在脑海里把想做的事幻想一遍那样吗…虽然不是真的，但想象的过程却很解压。"
        },
        {
          "role": "布伦妮",
          "text": "不够，还不够。小孩子很纯粹，美好的想象总信以为真，所以会获得真正的快乐。"
        },
        {
          "role": "布伦妮",
          "text": "成年人在明知幻想不是现实的情况下，还用想象来哄骗自己，本质上是一种心态逃跑。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你想说的会不会是…",
