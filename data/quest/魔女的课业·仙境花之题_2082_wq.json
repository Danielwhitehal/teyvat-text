{
  "quest_id": 2082,
  "chapter_num": "",
  "chapter_title": "魔女的课业·仙境花之题",
  "type": "wq",
  "route": "Witch's Homework: Of Wonderland Flowers",
  "stories": [
    {
      "story_id": 10009,
      "title": "界限的法则",
      "description": "砂糖在炼制新的炼金药剂，不过，似乎炼制的药剂始终无法达到预期…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往蒙德的合成台"
        },
        {
          "role": "砂糖",
          "text": "嗯…根据之前的结果，调整一下实验计划吧，然后，得检查器材和实验用的素材…"
        },
        {
          "role": "砂糖",
          "text": "对了，今天要做的炼金药…咦，旅行者和派蒙，你们怎么来了？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们是来帮助你完成「课题」的，想看看我们有什么能帮得上忙…"
        },
        {
          "role": "砂糖",
          "text": "「课题」…啊，你是说阿贝多先生曾经提过的，和魔女会相关的「课题」吗？"
        },
        {
          "role": "砂糖",
          "text": "真巧，今天正好有周期性实验的安排。"
        },
        {
          "role": "派蒙",
          "text": "周期性？那岂不是说砂糖一直在做这个实验？"
        },
        {
          "role": "砂糖",
          "text": "是的，不过因为跟我研究的其他内容有方向性的一致，所以对于持续这个「课题」的实验，并没有太大的负担。"
        },
        {
          "role": "砂糖",
          "text": "不过…"
        },
        {
          "role": "派蒙",
          "text": "怎么了，是实验遇到了什么困难吗？"
        },
        {
          "role": "砂糖",
          "text": "嗯，实验一直「没能成功」。"
        },
        {
          "role": "派蒙",
          "text": "啊，也就是说已经失败了很多次了…"
        },
        {
          "role": "砂糖",
          "text": "不能简单地认为那是「失败」，这个「课题」背后所蕴含的原理要比想象中复杂一些…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以到底是什么课题呢…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦，说了半天，具体到底是要做什么样的实验呢？"
        },
        {
          "role": "砂糖",
          "text": "能令甜甜花变成「十六倍大甜甜花」的药剂配置的实验…"
        },
        {
          "role": "砂糖",
          "text": "也就是炼金药剂「肆式植株倍化剂柒型」的配置，顺便一提之所以是「柒型」，是因为今天是第七次进行这个实验。"
        },
        {
          "role": "派蒙",
          "text": "十、十六倍大！总之，听懂了，我们要做的就是「变大药」第七版！"
        },
        {
          "role": "砂糖",
          "text": "「变大药」第七版…是、是的！"
        },
        {
          "role": "砂糖",
          "text": "不过虽然是第七版，但是配方并没有做太多的调整，因为无论是原理还是实验过程的产物都证明没有问题。"
        },
        {
          "role": "派蒙",
          "text": "可是一直「没能成功」？"
        },
        {
          "role": "砂糖",
          "text": "嗯，所以我在想，是不是…需要别的要素介入。"
        },
        {
          "role": "派蒙",
          "text": "哼哼…很显然，这个别的要素…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就让我们来帮忙实验吧！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯嗯，我们本来就是来看看能帮上什么忙的嘛！"
                }
              ]
            },
            {
              "text": "就让派蒙以身入药…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那肯定能做出了不起的炼金药剂…才不对！什么叫让我入药啦！"
                },
                {
                  "role": "砂糖",
                  "text": "加入派蒙的话，原本的材料配比就得做出调整，效果说不定不如之前已经稳定的配方…"
                },
                {
                  "role": "派蒙",
                  "text": "我才不要变成材料，快把正常的配方拿出来啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "就在这里。"
        },
        {
          "role": "砂糖",
          "text": "不过，还缺少两个材料。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，那就包在我们身上了，是什么呀？"
        },
        {
          "role": "砂糖",
          "text": "作为配置底料的清泉镇的泉水，还有有点麻烦的是，狂风之核的碎片。"
        },
        {
          "role": "派蒙",
          "text": "好，我们这就出发吧！"
        },
        {
          "type": "subtitle",
          "text": "前往风起地"
        },
        {
          "role": "砂糖",
          "text": "那我们先去收集狂风之核的碎片吧…"
        },
        {
          "type": "subtitle",
          "text": "击败狂风之核"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|狂风之核|1}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "好，第一个材料得到了。"
        },
        {
          "role": "砂糖",
          "text": "不愧是你们，效率真的很高，平时总得在这一步花上太多时间…"
        },
        {
          "role": "砂糖",
          "text": "下面是清泉镇的泉水…"
        },
        {
          "type": "subtitle",
          "text": "前往清泉镇"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "取水",
              "dialogues": []
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "清泉镇的水质一直都很好，作为材料来说，十分稳定。"
        },
        {
          "role": "派蒙",
          "text": "现在材料都齐全了吧！"
        },
        {
          "role": "砂糖",
          "text": "嗯，我们回去吧！"
        },
        {
          "type": "subtitle",
          "text": "前往蒙德的合成台"
        },
        {
          "role": "砂糖",
          "text": "材料也全都准备好了，炼制用的炼金釜就在那边…随时可以开始，嗯…不过…"
        },
        {
          "role": "派蒙",
          "text": "还有什么困难吗？"
        },
        {
          "role": "砂糖",
          "text": "不不，只是，为了能够精确记录，所以能让我观看你们炼制的过程吗…"
        },
        {
          "role": "砂糖",
          "text": "其实有很多人做实验的时候不喜欢被看着…我就…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那当然没问题啦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "谢谢。那准备好的话，我们就开始吧，我一定会好好做好记录，不会放过任何细节。"
        },
        {
          "role": "砂糖",
          "text": "怎么样，要现在开始炼制吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，现在开始吧…",
              "dialogues": []
            },
            {
              "text": "稍等，我再看看配方…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "炼制倍化药剂"
        },
        {
          "type": "subtitle",
          "text": "额外对话（砂糖）"
        },
        {
          "role": "砂糖",
          "text": "…嗯，旅行者…要开始炼制药剂了吗？不用担心，我会全程记录下来的。"
        },
        {
          "type": "subtitle",
          "text": "显示教程：药剂配置",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "与砂糖对话"
        },
        {
          "role": "砂糖",
          "text": "完成了…过程非常完美。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？"
        },
        {
          "role": "砂糖",
          "text": "嗯，从药剂转化的过程来看，没有丝毫的瑕疵…我提取一点去试验一下成分，稍等…"
        },
        {
          "type": "subtitle",
          "text": "砂糖从炼制完成的药剂中提取了一点，用一旁的试验用器仔细做了成分的勘验…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "砂糖",
          "text": "嗯，炼制的过程很完美，所以得到的也是完美的结果，很符合理性直觉的过程。"
        },
        {
          "role": "派蒙",
          "text": "所以我们炼制出的「变大药」第七版…"
        },
        {
          "role": "砂糖",
          "text": "就跟「肆式植株倍化剂」的前六个版本一模一样。"
        },
        {
          "role": "派蒙",
          "text": "唔…那结果不是也会一模一样吗？"
        },
        {
          "role": "砂糖",
          "text": "不，每一次实验，即使一切都相似，也会有不同的差别，在完成之前，没人会知道结果，所以实验才有意义。"
        },
        {
          "role": "砂糖",
          "text": "走吧，我们去进行实验的场地吧，那里有事先移植的甜甜花。"
        },
        {
          "role": "砂糖",
          "text": "把「肆式植株倍化剂第七版」浇灌在甜甜花上就好。"
        },
        {
          "type": "subtitle",
          "text": "前往龙脊雪山"
        },
        {
          "role": "派蒙",
          "text": "「变大药」已经灌下去了…这样就可以了吗？"
        },
        {
          "role": "砂糖",
          "text": "嗯，这样就可以了，甜甜花要吸收炼金药剂的物质，在植株的内部进行消化和反应，这需要一点点时间。"
        },
        {
          "role": "派蒙",
          "text": "然后呢？"
        },
        {
          "role": "砂糖",
          "text": "然后甜甜花会保持原状但是进行膨胀式的生长，只不过在生长至十二倍至十四倍大小的时候会「无法承受」…"
        },
        {
          "role": "砂糖",
          "text": "就像是触摸到了不可触碰的界限，会以非自然的形式枯萎和朽败，变成一地的汁液。"
        },
        {
          "role": "派蒙",
          "text": "怎么会这样，是「变大药」有问题吗？"
        },
        {
          "role": "砂糖",
          "text": "不，「变大药」经过了许多调整，通过精密控制，解决了小型灌丛植株体型变大时会产生的诸多问题…"
        },
        {
          "role": "砂糖",
          "text": "比如草叶的大小不会过大，增强了根茎的直径和承受能力，仔细计算了表面积增大后的日照和营养供给问题…"
        },
        {
          "role": "派蒙",
          "text": "那为什么会失败呢？"
        },
        {
          "role": "砂糖",
          "text": "因为无法超越…正如同「如其在上，如其在下」，炼金术追求掌握的「万能物质」在这个世界中有其局限。"
        },
        {
          "role": "砂糖",
          "text": "正如…「规格」是一种刻写在万物之中的法则，所以反复的实验也是为了确认「规格」界限的稳定。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以「实验失败」也是结果…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "对，证明界限的「始终存在」。"
        },
        {
          "role": "派蒙",
          "text": "唔，有点没听明白，总之，正是因为「实验失败」，所以才能证明边界的稳定？"
        },
        {
          "role": "派蒙",
          "text": "好奇怪的实验…咦，甜甜花有反应了？"
        },
        {
          "role": "派蒙",
          "text": "…不对！这个动静，呜，这不是甜甜花！"
        },
        {
          "role": "砂糖",
          "text": "小心，这是…这是骗骗花，可是以往就算不小心被骗骗花吸收，也不会到达这样的大小规格…究竟是…"
        },
        {
          "role": "派蒙",
          "text": "以前也有被骗骗花吸收过哦…啊，不是说这些的时间了，先解决这个大家伙再说！"
        },
        {
          "type": "subtitle",
          "text": "击败过度生长的骗骗花"
        },
        {
          "type": "subtitle",
          "text": "击败'''超规格倍化骗骗花'''",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与砂糖对话"
        },
        {
          "role": "派蒙",
          "text": "终、终于解决掉了，虽然变大了，但是还好只是骗骗花。"
        },
        {
          "role": "砂糖",
          "text": "…嗯。"
        },
        {
          "role": "派蒙",
          "text": "刚才的那只骗骗花…"
        },
        {
          "role": "砂糖",
          "text": "虽然只是战斗中粗浅的目测，但是肯定已经达到…甚至超过了「十六倍大」的规格。"
        },
        {
          "role": "砂糖",
          "text": "实验…成功了。"
        },
        {
          "role": "派蒙",
          "text": "实验成功难道不是好事吗？"
        },
        {
          "role": "砂糖",
          "text": "还不能确定这个实验成功的结果究竟会有什么样的影响，但是，如果此后真的能够一直成功复现…"
        },
        {
          "role": "砂糖",
          "text": "那就说明有什么产生了变化…也许，法则的「界限」因为什么，正在发生变动…"
        },
        {
          "role": "砂糖",
          "text": "虽然不知道这种变化是好是坏，不过，只是从炼金术研究的角度来说，被扩展的边界会带来更多的可能性。"
        },
        {
          "role": "砂糖",
          "text": "那么，关于界限的「课题」，也就告一段落了。"
        },
        {
          "role": "派蒙",
          "text": "是呢…"
        },
        {
          "role": "砂糖",
          "text": "唔，说不定其实做药剂的人也有一定的影响？还是说这只骗骗花是特殊的个体…"
        },
        {
          "role": "砂糖",
          "text": "「课题」之后的「课题」，还有好多要确认的方向呢…"
        },
        {
          "role": "派蒙",
          "text": "是嘛，那如果有需要的话，我和旅行者一定会来帮忙的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「变大药」能给派蒙用吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "吃了「变大药」，说不定我也能变成「十六倍大派蒙」，一拳打倒来抢东西的盗宝团！"
        },
        {
          "role": "砂糖",
          "text": "大概不行，骗骗花能够成功，完全是因为它体内结构有和甜甜花的相似之处…派蒙吃了以后…"
        },
        {
          "role": "砂糖",
          "text": "可能会变成「十六倍大植物人派蒙」。"
        },
        {
          "role": "派蒙",
          "text": "啊，那不行，我才不要变成那样…"
        },
        {
          "role": "派蒙",
          "text": "对了，我…我还有好奇的事，为什么砂糖一直在做甜甜花呀，日落果的研究呀…"
        },
        {
          "role": "砂糖",
          "text": "嗯…那当然是因为，不管是日落果吃起来…还是甜甜花提取出来的糖，都是甜甜的。"
        },
        {
          "role": "砂糖",
          "text": "从这个角度来看，这次「十六倍大骗骗花」的实验还有额外的收获，因为骗骗花的花蜜…"
        },
        {
          "role": "派蒙",
          "text": "尝起来就和甜甜花差不多呢！"
        },
        {
          "role": "砂糖",
          "text": "是的。等从这些花蜜里提取出糖，也送给你们一份吧。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，一言为定！"
        },
        {
          "type": "subtitle",
          "text": "解锁额外天赋「魔女的前夜礼·七循之理」",
          "narration": true,
          "color": "描述"
        }
      ],
      "collapse_ranges": [
        [
          51,
          52
        ]
      ]
    }
  ]
}