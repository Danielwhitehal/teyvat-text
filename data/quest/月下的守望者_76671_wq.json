{
  "quest_id": 76671,
  "chapter_num": null,
  "chapter_title": "月下的守望者",
  "type": "wq",
  "route": "The Moonlit Watcher",
  "stories": [
    {
      "story_id": 76671,
      "title": "月下的守望者",
      "description": "驻守在望崖营壁的执灯人似乎遇到了什么麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与叶洛亚对话"
        },
        {
          "role": "叶洛亚",
          "text": "居然还没到吗？这下可真是伤脑筋了。"
        },
        {
          "role": "安莱夫",
          "text": "怎么办，老大！且不说灯塔那边的兄弟们正等着开工，要是燃料也供给不上，整个营垒怕是都要熄火了。"
        },
        {
          "role": "伊捷莉",
          "text": "是啊，队长，得赶紧想想办法啊。"
        },
        {
          "role": "叶洛亚",
          "text": "我知道了，你们不用太担心。"
        },
        {
          "role": "叶洛亚",
          "text": "先回去自己的岗位上吧，这件事就交给我来处理…"
        },
        {
          "role": "叶洛亚",
          "text": "旅行者，派蒙，是你们来了。"
        },
        {
          "role": "派蒙",
          "text": "你好呀，叶洛亚，大家怎么都聚在门口？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你看起来好像很忙。",
              "dialogues": []
            },
            {
              "text": "出什么事了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "没事，一点小状况而已，不是什么大事，我已经在想办法处理了。"
        },
        {
          "role": "派蒙",
          "text": "叶洛亚每次遇到事情总想着偷偷一个人解决，也说给我们听听嘛。"
        },
        {
          "role": "派蒙",
          "text": "该不会是不好意思说吧？"
        },
        {
          "role": "叶洛亚",
          "text": "哈哈，怎么会呢。只是这种我自己能解决的事情，就不太想让大家为此操心了。"
        },
        {
          "role": "叶洛亚",
          "text": "不过你们现在也算是调查分队「魇夜之莺」的成员，作为队长我是不会见外的。"
        },
        {
          "role": "叶洛亚",
          "text": "这里说话有些不太方便，我们先进去再慢慢说吧。"
        },
        {
          "type": "subtitle",
          "text": "与叶洛亚同行"
        },
        {
          "role": "罗洛",
          "text": "队长，目前我们还能掌握的据点的情况我已经整理好档案，放在指挥所了。"
        },
        {
          "role": "叶洛亚",
          "text": "嗯嗯，辛苦你了。"
        },
        {
          "role": "弗莱库",
          "text": "队长，东边的兄弟们和愚人众起了点小摩擦，对方好像说要派人过来。"
        },
        {
          "role": "叶洛亚",
          "text": "知道了，我稍后就来。"
        },
        {
          "role": "派蒙",
          "text": "天啊，叶洛亚，你们这里每天都这么忙吗？"
        },
        {
          "role": "叶洛亚",
          "text": "最近确实有一点…毕竟现在正是百废待兴的时候嘛。"
        },
        {
          "type": "subtitle",
          "text": "与叶洛亚对话"
        },
        {
          "role": "派蒙",
          "text": "之前看到就很好奇了，为什么执灯人的营地里会有这种像是餐车一样的小车呢？"
        },
        {
          "role": "派蒙",
          "text": "虽然要是能在上面做饭的话看起来是很方便啦，但感觉应该不会有这么简单。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许能做更复杂的料理。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那我可要尝尝啦…不对吧，我不是在说这种不简单啦！"
                }
              ]
            },
            {
              "text": "或许能变形成战斗机器人。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "真的假的，难道说是那种，如果你说不喜欢它做的菜，它就会拿勺子攻击你的料理机器人？"
                }
              ]
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "它们嘛，正式一点的称呼应该叫作「月厢车」，是我们执灯人用至冬的机关车改造而成的运输工具。"
        },
        {
          "role": "叶洛亚",
          "text": "你们可以把它们当作可移动的灯塔，同样也是依靠月矩力的燃料驱动的。"
        },
        {
          "role": "叶洛亚",
          "text": "虽然移动的速度不是很快，但相比起在运输物资上消耗宝贵的人力，有了它们的帮助也算给我们省了不少事。"
        },
        {
          "role": "叶洛亚",
          "text": "至于派蒙说的料理嘛，之前我倒是没有考虑过，但如果在里面装上烤面包机的话…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙的话不用那么当真。",
              "dialogues": []
            },
            {
              "text": "餐车的事情是开玩笑的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "不不，能及时填饱肚子对于执勤的执灯士来说也是很重要的，派蒙的话倒是提醒我了。"
        },
        {
          "role": "叶洛亚",
          "text": "如果我们能配置一辆专门的餐车的话，大家就不用再为了吃口热饭而在野外垒石做灶了。"
        },
        {
          "role": "派蒙",
          "text": "对吧对吧，然后大家还可以用它来做各种各样好吃的东西，一起在这里开篝火晚会！"
        },
        {
          "role": "派蒙",
          "text": "唔，不过营地里的大家看起来都很忙的样子，应该也没有这种心情…"
        },
        {
          "role": "叶洛亚",
          "text": "其实我也希望有一天能够放下心来，和大家坐在一起吃吃喝喝，想想就会觉得很幸福。"
        },
        {
          "role": "叶洛亚",
          "text": "不过眼下还不是放松的时候。"
        },
        {
          "role": "派蒙",
          "text": "果然是这样啊…是因为狂猎的原因吗？"
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务：空月之歌·第四幕「回望湮灭的月光」"
        },
        {
          "role": "叶洛亚",
          "text": "嗯，你们也看到了，最近狂猎的活动越来越频繁，因此我们不得不加强戒备。"
        },
        {
          "type": "subtitle",
          "text": "完成魔神任务：空月之歌·第四幕「回望湮灭的月光」"
        },
        {
          "role": "叶洛亚",
          "text": "虽然菲林斯最近从南方传来消息，最强大的那股狂猎已经在你们的帮助下被消灭了。"
        },
        {
          "role": "叶洛亚",
          "text": "但分散在各地的狂猎仍然在持续造成破坏，一点也不能懈怠啊。"
        },
        {
          "role": "叶洛亚",
          "text": "为此需要对据点进行整备，定时派出执灯士调查巡逻，保证来往的道路畅通无阻…"
        },
        {
          "role": "派蒙",
          "text": "唔，光是听你说，我就已经开始累了…执灯人的工作还真是辛苦啊。"
        },
        {
          "role": "叶洛亚",
          "text": "这只是一些基础的工作罢了。"
        },
        {
          "role": "叶洛亚",
          "text": "像是更危险的，比如对付那些不知道会在何时何地出现的狂猎，这样的职责都是[[尼基塔|老爷子]]，还有菲林斯、[[奥拉维]]他们在承担着。"
        },
        {
          "role": "叶洛亚",
          "text": "我想也不能事事都让老爷子操心，就把这些最基础的工作接过来了。"
        },
        {
          "role": "叶洛亚",
          "text": "其实相比起筹备物资，眼下最棘手的还是人力的问题，实在是巧妇难为无米之炊啊。"
        },
        {
          "role": "叶洛亚",
          "text": "因为执灯人曾经的据点大多年久失修，没办法作为长久的栖身之地。"
        },
        {
          "role": "叶洛亚",
          "text": "现在大家只能不停地在野外的营地与总部之间疲于奔命，久而久之能作为战力的人就更少了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么解决的办法吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "想要解决的话，就必须把这里改建成永久性据点。而作为执灯人的营垒，最重要的就是要有一座灯塔。"
        },
        {
          "role": "派蒙",
          "text": "意思就是说，你们要在这里建一座灯塔？"
        },
        {
          "role": "叶洛亚",
          "text": "没错，只有建起了灯塔，才能在狂猎袭击时有所凭依。"
        },
        {
          "role": "叶洛亚",
          "text": "不过说起来容易，实际上嘛…你们刚才也看到了，目前的进展并不是很顺利。"
        },
        {
          "role": "派蒙",
          "text": "对哦，我都快忘了我们是要来帮忙的了。所以到底是遇到什么问题了呀？"
        },
        {
          "role": "叶洛亚",
          "text": "是这样的，为了建造营垒需要大量的燃料和物资，它们都是用月厢车从皮拉米达城源源不断地运输过来的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就地取材不行吗。",
              "dialogues": []
            },
            {
              "text": "我看旁边的木材就挺多。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "要是那么简单的话就好了。我们需要的不是普通的燃料，而是用月矩力精炼而成的特殊油料。"
        },
        {
          "role": "叶洛亚",
          "text": "虽然附近植物里的月矩力是很丰富，采集过来也不是不能勉强撑一会…但要用它们来供应灯塔的话，就完全是杯水车薪了。"
        },
        {
          "role": "叶洛亚",
          "text": "原本昨晚运送燃料与物资的运输车就该到了，但直到现在都没看到影子。"
        },
        {
          "role": "叶洛亚",
          "text": "负责运输的瓦蒂什做事一向严谨，我想他应该不会大意到连时间都搞错。"
        },
        {
          "role": "叶洛亚",
          "text": "因此我才担心会不会是路上遇到了什么麻烦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "停停，你别总往坏处想。",
              "dialogues": []
            },
            {
              "text": "别急，这种事情我碰得多了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，就算是被骗得钻进了酒桶出不来，又或者是被人埋进土里只剩下个脑袋，最后也总有办法嘛！"
        },
        {
          "role": "派蒙",
          "text": "反正也不会比这些还糟吧？"
        },
        {
          "role": "叶洛亚",
          "text": "噗嗤，这些该不会都是你们在冒险途中遇到过的情况吧？看来我还是低估你们的实力了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "其实还有更夸张的…",
              "dialogues": []
            },
            {
              "text": "梅洛彼得堡也不是没待过…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "总之，我们先在附近找找看吧，说不定他只是迷路了呢。"
        },
        {
          "role": "叶洛亚",
          "text": "确实，你们说得对。事不宜迟，那就拜托你们和我一起了。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，那是当然，我们现在就出发吧！"
        },
        {
          "type": "subtitle",
          "text": "寻找失踪的运输车"
        },
        {
          "role": "叶洛亚",
          "text": "奇怪，我似乎听见有什么声音，就像是…"
        },
        {
          "role": "派蒙",
          "text": "欸？叶洛亚你发现什么了吗？"
        },
        {
          "role": "叶洛亚",
          "text": "嗯…先不管这个，我好像看到那辆失踪的运输车了，就在那边！"
        },
        {
          "role": "派蒙",
          "text": "唔，车子是在这里没错，但是却没看到有人在，好奇怪…"
        },
        {
          "role": "？？？",
          "text": "欸？是有人来了吗，救命啊！我在这里，快来救救我！"
        },
        {
          "type": "subtitle",
          "text": "查看正在呼救的人"
        },
        {
          "role": "瓦蒂什",
          "text": "队、队长！太好了，终于有人来了。救命啊，队长！"
        },
        {
          "role": "叶洛亚",
          "text": "瓦蒂什，你怎么会在这里。"
        },
        {
          "role": "瓦蒂什",
          "text": "这就说来话长了…这些曼陀草制造的壁障从里面根本解除不了，我已经快被困在里面一天了。"
        },
        {
          "role": "叶洛亚",
          "text": "等一下，那可就奇怪了。按理来说这里不在皮拉米达城过来的大道上，也算不上是什么捷径。"
        },
        {
          "role": "叶洛亚",
          "text": "至于这些曼陀草，它们通常不会主动攻击路人，除非是有人入侵了它们的领地。"
        },
        {
          "role": "叶洛亚",
          "text": "所以，你到底是怎么被它们困在这里的，要是不能给我一个合理的解释，我就只能让你在里面多待一会了。"
        },
        {
          "role": "派蒙",
          "text": "哇，很少看到叶洛亚生气的样子，我都有点害怕了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕竟是队长，需要有威严的一面。",
              "dialogues": []
            },
            {
              "text": "执灯人也有自己的纪律。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是哦，果然还是当冒险家比较轻松…幸好我们只是编外的队员，不然也要被叶洛亚管教了。"
        },
        {
          "role": "瓦蒂什",
          "text": "呃啊…好吧，事情的经过是这样的。昨天夜里，我在前往营地的路上被一大群曼陀草挡住了去路。"
        },
        {
          "role": "瓦蒂什",
          "text": "队长你也知道我平常喜欢研究一些昆虫啊、植物啊什么的，这么多曼陀草聚在一起，是很少见的事情。"
        },
        {
          "role": "瓦蒂什",
          "text": "我想着不能错过研究的机会，就跟着它们一路来到了这里，结果…"
        },
        {
          "role": "瓦蒂什",
          "text": "非常抱歉！我会承担起责任的，接下来一个星期的值夜就由我…不，一个月，这一个月的值夜就由我承担了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还是先救人吧。",
              "dialogues": [
                {
                  "role": "叶洛亚",
                  "text": "你说得对，违反纪律的事情就等回去再说。我们先想办法把人弄出来吧。"
                }
              ]
            },
            {
              "text": "反正物资已经拿到了，不如…",
              "dialogues": [
                {
                  "role": "瓦蒂什",
                  "text": "欸，什么意思，该不会是要丢下我不管吧？不要啊，求求你们了，我已经知道错了！"
                },
                {
                  "role": "派蒙",
                  "text": "看他这么可怜，我们还是先把他救出来吧。反正等回了营地，他也会接受应得的惩罚的。"
                },
                {
                  "role": "叶洛亚",
                  "text": "派蒙说得对，违反纪律的事情就等回去再说。我们先想办法把人弄出来吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "旅行者，又得麻烦你们了。"
        },
        {
          "role": "瓦蒂什",
          "text": "呜呜，谢谢你们…"
        },
        {
          "type": "subtitle",
          "text": "解救瓦蒂什"
        },
        {
          "role": "派蒙",
          "text": "呜啊，这些魔物是从哪冒出来的啊！"
        },
        {
          "role": "叶洛亚",
          "text": "可恶，大意了…各位，准备迎战。"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|深黯钓客|3}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|荒野狂狩士|1}}{{图标|荒野幽徒|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与瓦蒂什对话"
        },
        {
          "role": "派蒙",
          "text": "呼，总算是把那些魔物击退了…"
        },
        {
          "role": "派蒙",
          "text": "这到底是怎么回事呀，这些家伙该不会是一直在这里埋伏我们吧。"
        },
        {
          "role": "叶洛亚",
          "text": "狂猎…曼陀草…我知道了。"
        },
        {
          "role": "派蒙",
          "text": "嗯？你想到什么啦，叶洛亚？"
        },
        {
          "role": "叶洛亚",
          "text": "我想这些曼陀草之所以会制造屏障把瓦蒂什困在里面，其实是想要保护他。"
        },
        {
          "role": "叶洛亚",
          "text": "曼陀草对环境的变化非常敏感，我过来的时候就听到这附近有奇怪的窃窃私语的声音。"
        },
        {
          "role": "叶洛亚",
          "text": "现在想来，应该就是尚未显形的狂猎魔物发出的。"
        },
        {
          "role": "叶洛亚",
          "text": "而这些曼陀草早就发现了它们，所以才会拦住瓦蒂什，不让他继续前进。"
        },
        {
          "role": "叶洛亚",
          "text": "结果没想到他反而跟了上来，它们就只能制造出这个屏障来保护他。"
        },
        {
          "role": "瓦蒂什",
          "text": "原来是这样…怪不得这些小家伙一直围在这附近不肯离开，这真的是…"
        },
        {
          "role": "叶洛亚",
          "text": "或许也是因为瓦蒂什平时就喜欢和它们待在一起，身上有花草的气味，它们才会保护你吧。"
        },
        {
          "role": "叶洛亚",
          "text": "总之谢谢你们啦，现在已经没有危险了。"
        },
        {
          "role": "派蒙",
          "text": "哇，这就钻走了。真是些可爱的小家伙，助人为乐还不要报酬。"
        },
        {
          "role": "派蒙",
          "text": "要是平常有它们在，就不用担心开宝箱的时候被人从背后袭击了。"
        },
        {
          "role": "派蒙",
          "text": "这样一想，也不是不能理解瓦蒂什想跟着它们走的心情…"
        },
        {
          "role": "瓦蒂什",
          "text": "对吧对吧，终于有人能理解我了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你怎么给个台阶就下。",
              "dialogues": []
            },
            {
              "text": "那也不是你玩忽职守的理由。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瓦蒂什",
          "text": "呜呜，对不起，我会老老实实接受惩罚的…"
        },
        {
          "role": "叶洛亚",
          "text": "好了，既然人已经救出来了，我们就快回去吧。大家还在等我们，说不定有人已经要开始担心了。"
        },
        {
          "type": "subtitle",
          "text": "返回望崖营壁"
        },
        {
          "role": "叶洛亚",
          "text": "事情总算是解决了，营垒的燃料也供应上了，这次真是谢谢你们。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，毕竟我们也是你的队员嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说到队员，瓦蒂什怎么样了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "嗯，虽然瓦蒂什在押运的途中玩忽职守，已经违反了执灯人的纪律。"
        },
        {
          "role": "叶洛亚",
          "text": "但毕竟是遇到了狂猎这种难以应付的事，最后也总算没有造成什么损失。"
        },
        {
          "role": "叶洛亚",
          "text": "所以按照他自己的愿望，接下来一个月他都会负责保护那座还在建设中的灯塔。"
        },
        {
          "role": "派蒙",
          "text": "那希望他不要再找机会偷懒了，作为队员，我可要经常过来检查他的工作，监督灯塔的完成情况。"
        },
        {
          "role": "派蒙",
          "text": "说来也不知道这里的灯塔建好之后会是什么样子。"
        },
        {
          "role": "叶洛亚",
          "text": "虽然比不过终夜长茔的那一座，不过等它建好之后，应该也能在夜幕到来时，成为往来之人的指路明灯。"
        },
        {
          "role": "叶洛亚",
          "text": "能帮助大家免受狂猎或者其它危险之物的困扰，我们的努力就不会白费。"
        },
        {
          "role": "叶洛亚",
          "text": "好了，我也该继续整理执灯人的档案了。上面说的那些事，光靠嘴说可是永远都做不到的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一刻也闲不下来啊。",
              "dialogues": []
            },
            {
              "text": "可别忙过头哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "没关系，也不会一直这么忙的。等到把这座营垒建好，就可以稍微休息一会了。"
        },
        {
          "role": "派蒙",
          "text": "既然如此，那我们也来帮忙吧，这样就能快一点建好了！"
        },
        {
          "role": "叶洛亚",
          "text": "欢迎欢迎！啊…不过你们应该也有自己要忙的事情吧，让你们专程过来帮忙总感觉有些不好意思。"
        },
        {
          "role": "叶洛亚",
          "text": "对了，不如这样，如果你们在冒险途中收集到了什么有用的材料，把它们带来这边就好。"
        },
        {
          "role": "派蒙",
          "text": "说好了不见外的，我们可是你的队员，给队长帮这点小忙不算什么啦。"
        },
        {
          "role": "派蒙",
          "text": "对吧，旅行者。"
        },
        {
          "role": "叶洛亚",
          "text": "哈哈，能有你们这样的队员，是我的荣幸。"
        },
        {
          "type": "subtitle",
          "text": "解锁功能「共建聚所·望崖营壁」",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}