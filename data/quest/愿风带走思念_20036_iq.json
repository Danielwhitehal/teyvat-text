{
  "quest_id": 20036,
  "chapter_num": null,
  "chapter_title": "愿风带走思念",
  "type": "iq",
  "route": "Whispers in the Wind",
  "stories": [
    {
      "story_id": 20036,
      "title": "愿风带走思念",
      "description": "双目失明的葛罗丽思念着远游的男友，正在寻找传递自己心愿的方式…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往询问葛罗丽"
        },
        {
          "type": "subtitle",
          "text": "与葛罗丽对话"
        },
        {
          "role": "葛罗丽",
          "text": "…古德温…到底什么时候能回来呢…"
        },
        {
          "role": "旅行者",
          "text": "你好…"
        },
        {
          "role": "葛罗丽",
          "text": "这个声音…是远方来的旅行者吗？感谢风神大人，一定是他的风将您带来的…请您听听我的请求吧。"
        },
        {
          "role": "葛罗丽",
          "text": "我的…唔，男朋友，西风骑士古德温离开蒙德城已经很久了。"
        },
        {
          "role": "葛罗丽",
          "text": "这么久了，我一直没有收到他的消息。"
        },
        {
          "role": "葛罗丽",
          "text": "我很担心古德温。他要和那些难缠的丘丘人，还有他和我说过的深渊教团战斗，要是他受了伤怎么办，而且离开那么久，要是他遇见了哪位温柔的女骑士…"
        },
        {
          "role": "葛罗丽",
          "text": "抱，抱歉！我，我自顾自说太多了！我听我母亲说，蒲公英能够带着人们的思念，被风一直带到很远。"
        },
        {
          "role": "葛罗丽",
          "text": "所以我的请求是…能不能请您帮我去风起地搜集三份蒲公英籽？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "葛罗丽",
                  "text": "太感谢您了，愿风神保佑您。"
                }
              ]
            },
            {
              "text": "还有别的事。",
              "dialogues": [
                {
                  "role": "葛罗丽",
                  "text": "等一下！求您了，对您这样的旅行者来说，这肯定只是举手之劳…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找三份蒲公英籽"
        },
        {
          "role": "葛罗丽",
          "text": "您已经做好了吗？"
        },
        {
          "role": "旅行者",
          "text": "顶上的风真大…"
        },
        {
          "role": "葛罗丽",
          "text": "这样子才好，能让蒲公英飞得更远。"
        },
        {
          "role": "葛罗丽",
          "text": "这样子，古德温说不定就能收到，我对他说的话了吧。"
        },
        {
          "role": "葛罗丽",
          "text": "您伸出手来吧，让我能碰到…请拿好了，这些谢礼是给您的。"
        },
        {
          "role": "葛罗丽",
          "text": "我还有很多话想要和古德温说，之后，说不定也要多多麻烦您啦。"
        },
        {
          "type": "subtitle",
          "text": "将蒲公英籽交给葛罗丽"
        },
        {
          "role": "葛罗丽",
          "text": "您回来了，蒲公英搜集到了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经搜集好了。"
        },
        {
          "role": "葛罗丽",
          "text": "谢谢您，请您把蒲公英籽放在我手上，好吗？我看不见，怕把它们都弄撒了"
        },
        {
          "role": "旅行者",
          "text": "这些够了吗？"
        },
        {
          "role": "葛罗丽",
          "text": "请您先把蒲公英籽放在我手上吧，这样我才能感受一下它们…"
        },
        {
          "role": "葛罗丽",
          "text": "这些就够了，我要把想和古德温说的话都告诉它们才行…"
        },
        {
          "role": "葛罗丽",
          "text": "唔——请您捂住耳朵，别偷听，这是恋人之间的悄悄话哦。您肯定也…嘻嘻，您有过这种体验吗？"
        },
        {
          "role": "葛罗丽",
          "text": "好啦。请您带着这些蒲公英籽去风神像上，然后把它们洒在风中，让风神大人带走它们吧。"
        },
        {
          "role": "葛罗丽",
          "text": "希望风神大人，能够把它们带到古德温身边。"
        },
        {
          "type": "subtitle",
          "text": "前往风神像顶端播撒蒲公英籽"
        },
        {
          "type": "subtitle",
          "text": "与葛罗丽对话"
        }
      ]
    }
  ]
}