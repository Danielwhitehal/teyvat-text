{
  "quest_id": 72176,
  "chapter_num": null,
  "chapter_title": "「手鞠游戏」",
  "type": "wq",
  "route": "Temaria Game",
  "stories": [
    {
      "story_id": 72176,
      "title": "「手鞠游戏」",
      "description": "鲸井小弟有什么事情想要分享…",
      "dialogues": [
        {
          "role": "鲸井小弟",
          "text": "嗨！大哥哥，我这有好东西…"
        },
        {
          "role": "旅行者",
          "text": "谢谢，没有兴趣。"
        },
        {
          "role": "派蒙",
          "text": "好可怜，年纪这么小就被人逼着干可疑的行当。"
        },
        {
          "role": "鲸井小弟",
          "text": "不是啦！我是想和大哥哥玩手鞠。"
        },
        {
          "role": "派蒙",
          "text": "「手鞠」？"
        },
        {
          "role": "鲸井小弟",
          "text": "简单来说，我会把手鞠藏在附近的某个地方。在一首手鞠歌的时间内，如果大哥哥能找到，那大哥哥就赢了。"
        },
        {
          "role": "旅行者",
          "text": "手鞠是这样玩的吗？"
        },
        {
          "role": "鲸井小弟",
          "text": "咦？是一个很厉害的大姐姐冒险家教我的。她还说…"
        },
        {
          "role": "鲸井小弟",
          "text": "「鲸井，好好记住。你一定要说，『如果你赢了，就可以得到好东西』。」"
        },
        {
          "role": "鲸井小弟",
          "text": "所以，大哥哥，如果你赢了，就可以得到好东西。"
        },
        {
          "role": "派蒙",
          "text": "是好东西！旅行者，我觉得陪小孩子玩是天经地义的事情！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可我还是觉得手鞠不是这么玩的…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "可能是只有当地人才知道的玩法，不要在意这种细节嘛。"
                },
                {
                  "role": "派蒙",
                  "text": "是鲸井小弟对吧？我们陪你玩！"
                }
              ]
            },
            {
              "text": "好吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鲸井小弟",
          "text": "好耶！"
        },
        {
          "type": "subtitle",
          "text": "找到手鞠"
        },
        {
          "type": "subtitle",
          "text": "与鲸井小弟对话"
        },
        {
          "role": "鲸井小弟",
          "text": "欸，太难了吗…"
        },
        {
          "role": "派蒙",
          "text": "刚刚只是状态不好而已！"
        },
        {
          "role": "鲸井小弟",
          "text": "大哥哥，你们要再试一次吗？"
        },
        {
          "role": "派蒙",
          "text": "当然了！旅行者，我们要让鲸井小弟见识一下我们的厉害才行！"
        },
        {
          "role": "旅行者",
          "text": "再来一次！"
        },
        {
          "role": "鲸井小弟",
          "text": "好耶！目标是在限制时间内，找到手鞠哦！"
        },
        {
          "type": "subtitle",
          "text": "与鲸井小弟对话"
        },
        {
          "role": "鲸井小弟",
          "text": "大哥哥好厉害，一下就找到了！"
        },
        {
          "role": "派蒙",
          "text": "哼哼，旅行者可是身经百战，去过很多国度的旅行者。"
        },
        {
          "role": "鲸井小弟",
          "text": "哇！难道，「蒙德」也去过？"
        },
        {
          "role": "旅行者",
          "text": "当然。"
        },
        {
          "role": "鲸井小弟",
          "text": "好厉害！听那个大姐姐说，蒙德有很多很漂亮的地方，像是有好高好高的塔的「风龙遗迹」…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是风龙废墟。",
              "dialogues": []
            },
            {
              "text": "是吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鲸井小弟",
          "text": "嗯，不知道是那座塔比较高，还是将军大人的天守比较高呢…"
        },
        {
          "role": "派蒙",
          "text": "鲸井小弟，你为什么一个人在野外呢？"
        },
        {
          "role": "鲸井小弟",
          "text": "因为姐姐钓鱼的时候，嫌我会把鱼吓跑，就让我自己出去玩了。"
        },
        {
          "role": "鲸井小弟",
          "text": "有一次，遇到了那个冒险家大姐姐。她看我无聊，就送了好多手鞠，让我「找贪心的旅行者一起玩」。"
        },
        {
          "role": "旅行者",
          "text": "贪心的旅行者…"
        },
        {
          "role": "派蒙",
          "text": "才不是贪心！是担心！担心鲸井小弟一个人很无聊！"
        },
        {
          "role": "鲸井小弟",
          "text": "是呀，我也觉得大哥哥你们好好心，我很开心哦。"
        },
        {
          "role": "旅行者",
          "text": "一个人呆在野外…"
        },
        {
          "role": "派蒙",
          "text": "你一个小孩子呆在野外，不怕遇到危险吗？而且身上还带着好东西。"
        },
        {
          "role": "鲸井小弟",
          "text": "大哥哥真好心。不过不用担心，那个冒险家大姐姐教我，只要特别操作一下，手鞠就可以变成炸弹。"
        },
        {
          "role": "派蒙",
          "text": "好危险！"
        },
        {
          "role": "鲸井小弟",
          "text": "不危险哦！丘丘人呀，史莱姆呀，坏蛋呀，我都炸跑好多了。"
        },
        {
          "role": "派蒙",
          "text": "危险的是你！"
        },
        {
          "role": "鲸井小弟",
          "text": "对了，大哥哥如果想要跟别的朋友玩手鞠的话…"
        },
        {
          "role": "鲸井小弟",
          "text": "我留个手鞠放在这里！它的规则是这样的…"
        },
        {
          "role": "鲸井小弟",
          "text": "藏手鞠的时候，要在一首手鞠歌的时间内藏好。找的人呢，也在一首歌的时间内找到。这样才公平嘛。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "派蒙",
          "text": "一想到我们玩的居然是炸弹，就觉得好害怕…"
        },
        {
          "role": "鲸井小弟",
          "text": "大哥哥不用怕，她还跟我说过「只会炸坏人。大概」。"
        },
        {
          "role": "派蒙",
          "text": "「大概」？！"
        },
        {
          "role": "鲸井小弟",
          "text": "那么，我去别的地方玩喽！大哥哥再见！"
        }
      ]
    }
  ]
}