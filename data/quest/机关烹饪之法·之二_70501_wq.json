{
  "quest_id": 70501,
  "chapter_num": null,
  "chapter_title": "机关烹饪之法·之二",
  "type": "wq",
  "route": "Contraption-Contrived Cooking Course: Part II",
  "stories": [
    {
      "story_id": 70501,
      "title": "机关烹饪之法·之二",
      "description": "留云借风真君似乎想再用「机关烹饪神机」制作一道新菜…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与留云借风真君对话"
        },
        {
          "role": "留云借风真君",
          "text": "不知道这机关能不能制作甜品…"
        },
        {
          "role": "旅行者",
          "text": "这次要做什么菜？"
        },
        {
          "role": "留云借风真君",
          "text": "旅行者，你来得正好。本仙刚刚想好这次要做的菜色，其名为「布丁」。"
        },
        {
          "role": "留云借风真君",
          "text": "这种叫做「布丁」的菜色，是我从最近流行的食谱里看来的。据说香软可口，是款不错的甜品。"
        },
        {
          "role": "留云借风真君",
          "text": "本仙在其原有做法上稍加改造…"
        },
        {
          "role": "留云借风真君",
          "text": "此外，加入了「稻米」。"
        },
        {
          "role": "留云借风真君",
          "text": "改造后的这道菜理应由本仙亲自赐名，唔…就叫它「米饭布丁」吧。"
        },
        {
          "role": "旅行者",
          "text": "怎么听着这么管饱…"
        },
        {
          "role": "留云借风真君",
          "text": "这道甜品重在「稻米」的品质，本仙当即启动「机关烹饪神机」，令它寻找上等稻米。一路奔波，来到了此地。"
        },
        {
          "role": "留云借风真君",
          "text": "旅行者，来得早不如来得巧，再为本仙跑一趟，取来上等稻米吧。据机关显示，那种稻米应该离这里不远。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "为什么又是我去…",
            "您自己不是会飞吗…"
          ]
        },
        {
          "role": "留云借风真君",
          "text": "调整机关费时，本仙暂时分身乏术。"
        },
        {
          "role": "留云借风真君",
          "text": "你手脚麻利，是不可多得的帮手。你就再替本仙跑一趟吧，等「米饭布丁」做出来，自然少不了你的份。"
        },
        {
          "role": "留云借风真君",
          "text": "总之，就有劳你了。"
        },
        {
          "role": "留云借风真君",
          "text": "机关烹饪神机…启！"
        },
        {
          "role": "留云借风真君",
          "text": "旅行者，本仙已启动机关，你快循着气息的踪迹，去把本仙要的那种稻米拿回来吧。"
        },
        
         {
          "type": "subtitle",
          "text": "跟随气息的踪迹，寻找食材"
        },
         {
          "type": "subtitle",
          "text": "解救被魔物围困的人"
        },
        {
          "role": "布伦",
          "text": "谢谢你们，谢谢你们救了我…我叫布伦，是个商人。"
        },
        {
          "role": "布伦",
          "text": "唉…真是倒霉。我本来正在运一批货物…"
        },
        {
          "role": "布伦",
          "text": "但没想到…才走到半路，突然被一群魔物袭击了。"
        },
        {
          "role": "布伦",
          "text": "我一个劲地向前跑，顾不上车里的货物，也来不及辨认方向…一直跑到了这里。"
        },
        {
          "role": "布伦",
          "text": "到了这里之后，我还以为彻底甩掉它们了，就想要下车清点一下货物。"
        },
        {
          "role": "布伦",
          "text": "但是它们突然又不知道从哪钻了出来…幸好有你们帮忙。"
        },
        {
          "role": "旅行者",
          "text": "你运的是什么货物？"
        },
        {
          "role": "布伦",
          "text": "我运的是一批食材，稻米之类的东西…"
        },
        {
          "role": "留云借风真君",
          "text": "看来这就是那位仙人要我们找的稻米了，但是，看起来好像也没剩下多少…"
        },
        {
          "role": "旅行者",
          "text": "能卖一些稻米给我吗？"
        },
        {
          "role": "布伦",
          "text": "你要买稻米？不是我不卖，只是…我在逃跑的时候，车上的货物基本上都丢在路上了。"
        },
        {
          "role": "布伦",
          "text": "现在那些魔物只怕是把这些货物当做战利品，搬回它们的营地里去了。"
        },
        {
          "role": "布伦",
          "text": "我也正在头疼，怎么才能把那些货物拿回来，要是拿不回来的话，这趟生意我可就亏惨了…"
        },
        {
          "role": "布伦",
          "text": "旅行者…我看你刚才的身手很好，你能帮我去拿回这些货物吗？"
        },
        {
          "role": "布伦",
          "text": "要、要是你愿意帮我的话！你要的稻米，你要多少我就送给你多少！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "交给我吧。",
            "我应该拿不动那么多货物…"
          ]
        },
        {
          "role": "布伦",
          "text": "谢谢你！那就拜托你了！"
        },
        {
          "role": "布伦",
          "text": "你带着我的货运热气球去吧，把那些货物放在这上面就好了。"
        },
        {
          "role": "布伦",
          "text": "那就拜托你了，旅行者，我就在这等着你，拿到货物之后，就拿回来给我吧。"
        },
        {
          "role": "派蒙",
          "text": "这应该就是那些货物了，呜哇…居然有这么多…"
        },
        {
          "role": "派蒙",
          "text": "还好有这架货运热气球…我们快点把货物运回去吧。"
        },
        {
          "role": "布伦",
          "text": "那就拜托你了，旅行者，我就在这等着你，拿到货物之后，就拿回来给我吧。"
        },
        {
          "role": "布伦",
          "text": "你把货物拿回来了吗？谢谢你，旅行者！"
        },
        {
          "role": "布伦",
          "text": "你之前说…想要稻米，对吧？请你稍等一下，我挑一些品质比较好的给你…"
        },
        {
          "role": "布伦",
          "text": "好了！这些稻米给你，应该足够你用了。"
        },
        {
          "role": "布伦",
          "text": "再次谢谢你帮忙，旅行者，我接着赶路了。"
        },
        {
          "role": "布伦",
          "text": "希望别再遇见什么魔物了…"
        },
        {
          "type": "subtitle",
          "text": "与留云借风真君对话"
        },
        {
          "role": "留云借风真君",
          "text": "旅行者，你拿到本仙要的那种稻米了吗？"
        },
        {
          "role": "留云借风真君",
          "text": "不错，正是本仙所需之物…品质上乘。"
        },
        {
          "role": "留云借风真君",
          "text": "既然食材备齐，本仙马上就去开启机关。"
        },
        {
          "role": "留云借风真君",
          "text": "和上次一样，照看火候的事就交给你了，旅行者。"
        },
        {
          "role": "留云借风真君",
          "text": "你准备好之后，速来知会本仙。"
        },
        {
          "role": "旅行者",
          "text": "准备好了。"
        },
        {
          "role": "留云借风真君",
          "text": "那我们就开始吧。"
        },
        {
          "role": "留云借风真君",
          "text": "机关烹饪神机…启！"
        },
        {
          "role": "留云借风真君",
          "text": "怎么样？「米饭布丁」已经做好了吗？"
        },
        {
          "role": "留云借风真君",
          "text": "火候似乎控制得不太成功…"
        },
        {
          "role": "留云借风真君",
          "text": "无妨。还有备用食材，随我再试一次吧。"
        },
        {
          "role": "旅行者",
          "text": "还没准备好。"
        },
        {
          "role": "留云借风真君",
          "text": "唔…那你准备好之后，再来告诉本仙吧。"
        },
        {
          "role": "留云借风真君",
          "text": "旅行者，你快循着气息的踪迹，去把本仙要的那种稻米拿回来吧。"
        },
        {
          "role": "留云借风真君",
          "text": "如此清香…闻起来真不错。不愧是本仙，不愧是本仙的「机关烹饪神机」，哈哈哈！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "您悠着点…",
            "这机关怎么什么都能做…"
          ]
        },
        {
          "role": "留云借风真君",
          "text": "这回也有劳你了，旅行者。本仙已备好给你的食谱，拿好了。"
        },
        {
          "role": "留云借风真君",
          "text": "唔，已经做了两道菜，下一道做什么好呢…"
        }
      ]
    }
  ]
}