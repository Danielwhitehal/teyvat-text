{
  "quest_id": 10235,
  "chapter_num": "和旋舞剧·尾声",
  "chapter_title": "一帆风顺的美愿",
  "type": "eq",
  "route": "A Wish For Smooth Sailing",
  "stories": [
    {
      "story_id": 40197,
      "title": "一帆风顺的美愿",
      "description": "经过大家的努力，映影欢乐城经营得热火朝天。你终于得闲，准备和伙伴们闲聊一番…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到第二天上午（8点-10点）"
        },
        {
          "type": "subtitle",
          "text": "在映影欢乐城与大家会合"
        },
        {
          "role": "芙宁娜",
          "text": "我认为，当事情发展到如此地步，我们应当加入——"
        },
        {
          "role": "爱可菲",
          "text": "盐？"
        },
        {
          "role": "芙宁娜",
          "text": "不。胡椒。"
        },
        {
          "role": "爱可菲",
          "text": "哦！精妙！"
        },
        {
          "role": "派蒙",
          "text": "嗯？"
        },
        {
          "role": "派蒙",
          "text": "二位这是在研究什么，新的甜品菜单吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "甜品里不该有胡椒吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱可菲",
          "text": "不是甜品哦。"
        },
        {
          "role": "芙宁娜",
          "text": "是剧本。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "欸？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芙宁娜",
          "text": "我亲爱的伙伴，摄影师，新人导演！在映影爱好者们满溢的爱中，创作永远不会停止。"
        },
        {
          "role": "芙宁娜",
          "text": "我的舞台上，平淡的剧本禁止登场。转折应如漫天落下的胡椒粉，让观众们连连打上喷嚏才对。"
        },
        {
          "role": "爱可菲",
          "text": "不只是映影，餐盘亦是舞台！"
        },
        {
          "role": "爱可菲",
          "text": "之前听艾梅莉埃小姐说过，胡椒是可以应用在调香技艺中的…那么，或许甜品也可以…"
        },
        {
          "role": "芙宁娜",
          "text": "喔！胡椒的刺激，也许更能衬托奶油的甜美呢？"
        },
        {
          "role": "派蒙",
          "text": "呜哇，总觉得她们两个在创作上很合得来呢…"
        },
        {
          "role": "派蒙",
          "text": "虽然我是想象不出胡椒蛋糕会是什么味道啦！"
        },
        {
          "role": "娜维娅",
          "text": "什么什么？爱可菲要做新蛋糕了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "胡椒蛋糕，糊糊焦焦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "娜维娅",
          "text": "这么刺激！等做出来了，请务必给我尝尝！"
        },
        {
          "role": "派蒙",
          "text": "是我的错觉吗？总觉得工作完成之后，大家的热情反而更加高涨了？"
        },
        {
          "role": "娜维娅",
          "text": "为什么不呢？努力有了成果，才正是最应该开心的时刻呀。"
        },
        {
          "role": "娜维娅",
          "text": "就像新鲜出炉的马卡龙，不要因为畏惧甜度而不舍得加料。"
        },
        {
          "role": "娜维娅",
          "text": "马卡龙，就是要狠狠放糖！"
        },
        {
          "role": "芙宁娜",
          "text": "狠狠放糖！"
        },
        {
          "role": "乐平波琳",
          "text": "狠狠放糖！"
        },
        {
          "role": "乐平波琳",
          "text": "…呃，是要放什么糖？"
        },
        {
          "role": "娜维娅",
          "text": "乐平波琳，你来啦！东西完成了吗？"
        },
        {
          "role": "乐平波琳",
          "text": "当然当然，一切顺利！"
        },
        {
          "role": "派蒙",
          "text": "欸？乐平波琳是去做什么重要任务了吗？"
        },
        {
          "role": "乐平波琳",
          "text": "对的对的，这个给你，请务必收下！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "活动任务-一帆风顺的美愿-纪念图-荧.png|500px|center]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "活动任务-一帆风顺的美愿-纪念图-空.png|500px|center]]"
        },
        {
          "role": "派蒙",
          "text": "哇，好厉害！是展会的全景图，上面还有大家的图案呢！"
        },
        {
          "role": "娜维娅",
          "text": "嘿嘿，鉴于映影欢乐城大获成功，我们一起商量着，想要制作一份独特的纪念品。"
        },
        {
          "role": "娜维娅",
          "text": "这座欢乐城是由大家一砖一瓦搭建成功的，就像大家一笔一划画出的这份地图一样。"
        },
        {
          "role": "爱可菲",
          "text": "虽然主要都是由擅长绘图的乐平波琳小姐完成的啦，但我们每个人也都尽力在上面加了自己的笔墨哦。"
        },
        {
          "role": "芙宁娜",
          "text": "没错。"
        },
        {
          "role": "芙宁娜",
          "text": "而且不仅如此，旅行者，我要给你一份特权。"
        },
        {
          "role": "芙宁娜",
          "text": "——你将拥有给我的头像上添加胡子的权利！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真棒，我要画{{颜色|#C4D6EAFF|白色的}}。",
              "dialogues": [
                {
                  "role": "芙宁娜",
                  "text": "奶油味胡子吗…非常传统，但非常好吃。嗯，我准许了。"
                },
                {
                  "type": "subtitle",
                  "text": "荧"
                },
                {
                  "role": "[[file",
                  "text": "活动任务-一帆风顺的美愿-海薇玛乐园全景纪念图白-荧.png|500px|center]]"
                },
                {
                  "type": "subtitle",
                  "text": "空"
                },
                {
                  "role": "[[file",
                  "text": "活动任务-一帆风顺的美愿-海薇玛乐园全景纪念图白-空.png|500px|center]]"
                }
              ]
            },
            {
              "text": "真棒，我要画{{颜色|#E77E70FF|红色的}}。",
              "dialogues": [
                {
                  "role": "芙宁娜",
                  "text": "番茄肉酱味道的吗…意想不到的展开啊，这局你赢。"
                },
                {
                  "type": "subtitle",
                  "text": "荧"
                },
                {
                  "role": "[[file",
                  "text": "活动任务-一帆风顺的美愿-海薇玛乐园全景纪念图红-荧.png|500px|center]]"
                },
                {
                  "type": "subtitle",
                  "text": "空"
                },
                {
                  "role": "[[file",
                  "text": "活动任务-一帆风顺的美愿-海薇玛乐园全景纪念图红-空.png|500px|center]]"
                }
              ]
            }
          ]
        },
        {
          "role": "娜维娅",
          "text": "好啦，既然这份纪念地图已经是旅行者的所有物，那你想画多少不同口味的胡子都可以。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，听起来是很好吃的地图，我们会好好收藏的！"
        },
        {
          "role": "娜维娅",
          "text": "你们喜欢就再好不过啦。"
        },
        {
          "role": "娜维娅",
          "text": "乐园各方面的情况都已经很完善了，接下来就请忘记工作的疲惫，尽情游玩吧！"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|海薇玛乐园全景纪念图}}",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}