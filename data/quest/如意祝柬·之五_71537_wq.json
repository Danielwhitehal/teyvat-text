  "stories": [
    {
      "story_id": 71537,
      "title": "如意祝柬·之五",
      "description": "似乎有人对制作祝柬产生了兴趣…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至次日的8时至18时"
        },
        {
          "type": "subtitle",
          "text": "与诺艾尔对话"
        },
        {
          "role": "诺艾尔",
          "text": "荣誉骑士前辈，居然能在这里遇见你！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你在做「祝柬」么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "诺艾尔",
          "text": "嗯，好不容易趁着休假来了璃月港，我正在采购礼物，准备带回去送给骑士团的各位。"
        },
        {
          "role": "诺艾尔",
          "text": "然后我听说，在海灯节期间，璃月人送礼物时一般会写一封「祝柬」附在里面…"
        },
        {
          "role": "诺艾尔",
          "text": "所以，我就想要效仿一下。也做几封漂亮的「祝柬」。但怎么做，似乎都不太好看…"
        },
        {
          "role": "诺艾尔",
          "text": "荣誉骑士前辈，你知道怎么做的「祝柬」最好看么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "放心，包在我身上。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "和诺艾尔一同完成祝柬"
        },
        {
          "type": "subtitle",
          "text": "退出时"
        },
        {
          "role": "诺艾尔",
          "text": "荣誉骑士前辈，你知道怎么做的「祝柬」最好看么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "放心，包在我身上。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "诺艾尔",
          "text": "唔…有没有类似于{{颜色|描述3|「气球」}}或{{颜色|描述3|「云彩」}}的纹样呢…"
        },
        {
          "type": "subtitle",
          "text": "提交不符合建议"
        },
        {
          "role": "诺艾尔",
          "text": "前辈，那个…也许加上一些{{颜色|描述3|「气球」}}或{{颜色|描述3|「云彩」}}图案会更好？"
        },
        {
          "role": "诺艾尔",
          "text": "这样装饰…嗯！很合适。"
        },
        {
          "role": "诺艾尔",
          "text": "这个图案…确实有一种轻飘飘的感觉。"
        },
        {
          "role": "诺艾尔",
          "text": "呜哇…好漂亮的祝柬。谢谢你帮忙，荣誉骑士前辈！"
        },
        {
          "type": "subtitle",
          "text": "与诺艾尔对话"
        },
        {
          "role": "诺艾尔",
          "text": "原来是这样…不愧是前辈！果然什么都很懂啊！"
        },
        {
          "role": "诺艾尔",
          "text": "谢谢前辈的指导，这封「祝柬」我会好好珍藏的。"
        },
        {
          "role": "诺艾尔",
          "text": "等下次蒙德举办「风花节」，你可一定要来啊。"
        },
        {
          "role": "诺艾尔",
          "text": "到时候，我一定给你写一封和这份「祝柬」一样漂亮的贺卡。"
        }
      ],
      "collapse_ranges": [
