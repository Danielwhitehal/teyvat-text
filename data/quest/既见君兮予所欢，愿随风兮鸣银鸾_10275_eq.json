{
  "quest_id": 10275,
  "chapter_num": "银翎溯月，玄鸟结璘·其三",
  "chapter_title": "既见君兮予所欢，愿随风兮鸣银鸾",
  "type": "eq",
  "route": "Having Met You, My Heart is Gladdened",
  "stories": [
    {
      "story_id": 40251,
      "title": "既见君兮予所欢，愿随风兮鸣银鸾",
      "description": "你们终于知晓了万象风角灵官与玄鸟仙子的约定，然而这么多年过去后，玄鸟仙子早已杳无音信。你们想再试一次，帮助万象风角灵官重新完成当年的约定…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后（20:00-22:00）"
        },
        {
          "type": "subtitle",
          "text": "前往遗珑埠"
        },
        {
          "role": "蓝砚",
          "text": "天暖燕子么搭窝窝，升雷扯闪么我家躲~"
        },
        {
          "role": "派蒙",
          "text": "蓝砚是在唱歌吗？听上去和燕子有关。"
        },
        {
          "role": "蓝砚",
          "text": "嘻嘻，只是在念叨两句童谣啦。"
        },
        {
          "role": "蓝砚",
          "text": "不过我确实跟长辈学过一首和燕子有关的山歌，据说它开始被传唱的时候，沉玉谷还有很多燕子，可惜现在…"
        },
        {
          "role": "派蒙",
          "text": "看来蓝砚真的很想让燕子们回来啊…对于之前研究的那种奇术，蓝砚有灵感了吗？"
        },
        {
          "role": "蓝砚",
          "text": "其实我刚刚就在尝试那种奇术，前两天听完祖师爷的故事后，我隐隐有种想法。"
        },
        {
          "role": "蓝砚",
          "text": "祖师爷说到的那种奇术，是要送燕子离开，我研习的这种奇术，则是想迎燕子回来，它们本质上很有可能是同一种奇术。"
        },
        {
          "role": "旅行者",
          "text": "确实如此…"
        },
        {
          "role": "派蒙",
          "text": "那不是说明蓝砚很厉害？没有人传授，独自领悟了祖师爷的绝学！"
        },
        {
          "role": "蓝砚",
          "text": "也不算是领悟吧，我现在还没想通自己遭遇的瓶颈是什么。"
        },
        {
          "role": "蓝砚",
          "text": "将奇术和燕子身上的仙力进行结合，哪怕是祖师爷也要和玄鸟仙子合作才能办到，我却想仅凭自己就…"
        },
        {
          "role": "蓝砚",
          "text": "也罢，至少我能帮祖师爷了却心愿，这也是一件非常值得开心的事。"
        },
        {
          "role": "派蒙",
          "text": "蓝砚果然不会和自己闹别扭。"
        },
        {
          "role": "蓝舆",
          "text": "蓝砚，你在这里啊。"
        },
        {
          "role": "蓝砚",
          "text": "大伯？"
        },
        {
          "role": "派蒙",
          "text": "这位是？"
        },
        {
          "role": "蓝砚",
          "text": "向你们介绍一下，这位是我的大伯，蓝氏一族的族长。"
        },
        {
          "role": "蓝舆",
          "text": "这两位就不用向我介绍了，他们的大名，我早有耳闻。"
        },
        {
          "role": "蓝砚",
          "text": "大伯，您现在不应该还忙着配合千岩军行动的事吗？怎么来这里了？"
        },
        {
          "role": "蓝舆",
          "text": "前两天，有一些年轻人使用奇策一举解决了从望舒客栈到石门之间的所有邪祟，多亏了他们，我才能抽空回来看看。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿…"
        },
        {
          "role": "蓝舆",
          "text": "蓝砚，我可没想到有一天你会对宗族事务感兴趣，能不能跟大伯讲讲？"
        },
        {
          "role": "蓝砚",
          "text": "现在正好有机会，晚辈这边确实有些事情需要向您交代一下。"
        },
        {
          "role": "蓝舆",
          "text": "…竟是如此吗？"
        },
        {
          "role": "蓝砚",
          "text": "祖师爷特别交代了，他不想被一群宗家的长辈围起来。"
        },
        {
          "role": "蓝舆",
          "text": "哈哈…我们这位祖师爷果真跟祖上讲的差不多。"
        },
        {
          "role": "蓝砚",
          "text": "大伯，您能和我们详细讲一讲与祖师爷有关的事吗？"
        },
        {
          "role": "蓝砚",
          "text": "小时候长辈向我讲的大多是他身为八奇之一的英雄事迹，至于他后来如何，倒很少讲起。"
        },
        {
          "role": "蓝舆",
          "text": "你大概是好奇他和蓝氏一族之间的关系吧？"
        },
        {
          "role": "派蒙",
          "text": "对啊，我也好奇！"
        },
        {
          "role": "旅行者",
          "text": "我也是。"
        },
        {
          "role": "蓝舆",
          "text": "其实他终身未婚，当今蓝氏一族的祖先是他的胞兄和胞弟。哈哈，你我称呼他为祖师爷，确实更合适些。"
        },
        {
          "role": "蓝舆",
          "text": "祖师爷他早年游历山水，极少关心世事。而后来他年事渐高，却又开始挂念这方山水，想要留下些什么。"
        },
        {
          "role": "蓝舆",
          "text": "于是他返回家乡，将毕生领悟倾囊相授。我们的祖先是他的嫡亲，在奇术方面也很有天赋，成功将他的衣钵继承下来。"
        },
        {
          "role": "蓝舆",
          "text": "说起来，那时的他仍旧很随性。有族人不想学，他不强求。外人上门求学，他也愿意传授。"
        },
        {
          "role": "蓝舆",
          "text": "这种理念，多多少少也被我们蓝氏一族继承下来。"
        },
        {
          "role": "蓝砚",
          "text": "原来族外人也会来学…"
        },
        {
          "role": "派蒙",
          "text": "听上去虽然平时总是一副什么都不在乎的样子，但他心里还是关心璃月这片土地的嘛。"
        },
        {
          "role": "蓝舆",
          "text": "所以他才会和那位仙子立下这样的约定吧…说到这个，我忽然想起来小时候长辈跟我讲过一件怪事。"
        },
        {
          "role": "蓝舆",
          "text": "从我们蓝氏成为沉玉谷的望族开始，逐月节期间，偶尔会有一名怪人到遗珑埠的街上到处找人问话。"
        },
        {
          "role": "蓝舆",
          "text": "一开始他还自称是我们家祖师爷，后来渐渐连自己是谁都不知道。"
        },
        {
          "role": "蓝舆",
          "text": "不过，这个怪人的行踪很不规律，不是每年都会出现。另外只要逐月节一过，他就会从街上消失。"
        },
        {
          "role": "蓝舆",
          "text": "因此族里的人很难接触到他，只当是坊间轶闻。"
        },
        {
          "role": "派蒙",
          "text": "那不就是…"
        },
        {
          "role": "蓝砚",
          "text": "也就是说，今年不是祖师爷的第一次苏醒？"
        },
        {
          "role": "蓝舆",
          "text": "嗯…如果是为了赴约，那祖师爷应该会设法让这种傀儡每年逐月节都苏醒一次。"
        },
        {
          "role": "蓝舆",
          "text": "当然，这注定无法持久，随着时间流逝，术式逐渐衰弱，后来恐怕要隔很多年才能苏醒一次。"
        },
        {
          "role": "蓝舆",
          "text": "不过即使如此，祖师爷之前也应该苏醒过很多次了，但却一次都没完成过约定吗？真奇怪…"
        },
        {
          "role": "蓝砚",
          "text": "这是不是意味着，祖师爷身上的术式已经运作了很多次，早已逼近极限了？"
        },
        {
          "role": "蓝舆",
          "text": "这是当然，能支撑到现在已经是奇迹了。"
        },
        {
          "role": "派蒙",
          "text": "这么说来，如果今天晚上不能成功解除术式的话…"
        },
        {
          "role": "蓝砚",
          "text": "…大伯，我们要尽快出发了。"
        },
        {
          "role": "蓝舆",
          "text": "去吧，有困难记得来找大伯。"
        },
        {
          "type": "subtitle",
          "text": "前往约定之地"
        },
        {
          "role": "派蒙",
          "text": "就是前面了吧？"
        },
        {
          "role": "胡桃",
          "text": "你们来啦！"
        },
        {
          "role": "派蒙",
          "text": "呀！不要吓我啊，胡桃…大家都在？"
        },
        {
          "role": "胡桃",
          "text": "说了要帮忙，当然得帮忙啊。只是可惜了香菱和嘉明，一个要处理美食街的事务，一个要继续押镖。"
        },
        {
          "role": "胡桃",
          "text": "不过没关系，有本堂主，蓝砚还有重云在，璃月方士三大派系的佼佼者直接联手，肯定没问题！"
        },
        {
          "role": "重云",
          "text": "璃月方士的三大派系？什么时候有这种说法？"
        },
        {
          "role": "胡桃",
          "text": "就当今天刚有咯，本堂主觉得很酷。"
        },
        {
          "role": "行秋",
          "text": "不用管我，昨天的战报上交后，在总务司的规划里，我就是一名跟随重云大师行动的剑士。"
        },
        {
          "role": "重云",
          "text": "不是我要求这样安排的…"
        },
        {
          "role": "胡桃",
          "text": "说吧，蓝砚，需要帮什么忙？"
        },
        {
          "role": "蓝砚",
          "text": "如果祖师爷他能如愿和玄鸟仙子见面的话，其实并不需要大家帮什么忙，只是…"
        },
        {
          "role": "蓝砚",
          "text": "就请大家先在附近等候吧，如果有需要帮忙的地方，我再和大家商议。"
        },
        {
          "type": "subtitle",
          "text": "与蓝君明对话"
        },
        {
          "role": "蓝君明",
          "text": "你们来啦，老朽正看月亮呢。"
        },
        {
          "role": "蓝砚",
          "text": "祖师爷，我们来帮你。"
        },
        {
          "role": "蓝君明",
          "text": "只是等她前来，没什么需要劳烦你们的地方。"
        },
        {
          "role": "蓝砚",
          "text": "干等着，恐怕玄鸟仙子不会来，毕竟您已经失约这么久了。得想个办法，让她知道您重新来赴约了。"
        },
        {
          "role": "蓝君明",
          "text": "也对，老朽这脑子，一坐到亭子里，就以为回到了当年…"
        },
        {
          "role": "蓝君明",
          "text": "确实有个法子，当年老朽想要联系她时，就会用术法在这附近的水面上映出一种燕子的纹样。"
        },
        {
          "role": "蓝君明",
          "text": "这种纹样蕴含着她的仙力，她会感应到，前来与老朽相见。"
        },
        {
          "role": "蓝砚",
          "text": "这件事就交给晚辈来做吧，您的残魂之前就不太稳定，不能随便使用奇术。"
        },
        {
          "role": "派蒙",
          "text": "还有我们！"
        },
        {
          "role": "蓝君明",
          "text": "也好…这种术法不难学，只是得让你听老朽唠叨一下。"
        },
        {
          "role": "蓝砚",
          "text": "没关系，这个术法晚辈很想学！"
        },
        {
          "role": "？？？",
          "text": "祖师爷将施术方法传授给了蓝砚。"
        },
        {
          "type": "subtitle",
          "text": "协助蓝砚施放术法"
        },
        {
          "role": "蓝砚",
          "text": "按照祖师爷传授的方法，我们要收集玄鸟仙子遗留在附近的仙力。"
        },
        {
          "role": "蓝砚",
          "text": "之后再将收集的仙力汇聚到湖面上，就可以让纹样显示出来了。"
        },
        {
          "type": "subtitle",
          "text": "听蓝砚讲解施术方法"
        },
        {
          "role": "蓝砚",
          "text": "这应该就是最后一处了，我们启动机关吧。"
        },
        {
          "type": "subtitle",
          "text": "利用术法映出第一段纹样"
        },
        {
          "type": "subtitle",
          "text": "触碰符箓"
        },
        {
          "role": "蓝砚",
          "text": "小心，这里有碍事的魔物。"
        },
        {
          "role": "蓝砚",
          "text": "机关被干扰了，无法启动，只能先把它们消灭掉。"
        },
        {
          "type": "subtitle",
          "text": "观察第一段纹样"
        },
        {
          "role": "蓝砚",
          "text": "这部分纹样已经显示出来了，我们去下一处吧。"
        },
        {
          "role": "派蒙",
          "text": "这是燕子的哪一部分？"
        },
        {
          "type": "subtitle",
          "text": "协助蓝砚施放术法"
        },
        {
          "type": "subtitle",
          "text": "利用术法映出第二段纹样"
        },
        {
          "role": "胡桃",
          "text": "蓝砚具体想让我们帮什么？"
        },
        {
          "role": "重云",
          "text": "是与奇门术法相关吧？蓝砚似乎总有好点子。"
        },
        {
          "role": "行秋",
          "text": "我不是方士，但如果有用到我的地方，也请直说。"
        },
        {
          "role": "蓝砚",
          "text": "多谢大家，等安顿好祖师爷之后，我就向大家讲明。"
        },
        {
          "type": "subtitle",
          "text": "前往第二处机关所在的地点"
        },
        {
          "role": "蓝砚",
          "text": "使用这种符箓，就能将仙力汇聚到湖面上了。"
        },
        {
          "type": "subtitle",
          "text": "击退碍事的魔物"
        },
        {
          "type": "subtitle",
          "text": "触碰符箓"
        },
        {
          "type": "subtitle",
          "text": "观察第二段纹样"
        },
        {
          "role": "蓝君明",
          "text": "既见君兮予所欢…"
        },
        {
          "role": "蓝君明",
          "text": "…愿随风兮鸣银鸾。"
        },
        {
          "role": "蓝君明",
          "text": "当初我许下那一诺，大抵不是出于家国大义。"
        },
        {
          "role": "蓝君明",
          "text": "放浪如我，只是贪恋她的回眸罢了。"
        },
        {
          "role": "蓝君明",
          "text": "只是不知从何时起，倒映在她眼中的山水，也成了我的牵挂之物。"
        },
        {
          "role": "蓝君明",
          "text": "我害怕她眼中没了这山清水秀，就只剩下哀闷忧愁。"
        },
        {
          "role": "蓝君明",
          "text": "于是舍不得，放不下，就算要把自己折腾成这个样子。"
        },
        {
          "role": "蓝君明",
          "text": "我也早就明白，这一切终究…"
        },
        {
          "role": "蓝君明",
          "text": "我确实不曾料想到，千百年后，这路边的茶驿竟又能聚集起一群惊才绝艳的年轻人。"
        },
        {
          "role": "蓝君明",
          "text": "如我们当年那样，提携三尺，涤荡邪祟。"
        },
        {
          "role": "蓝君明",
          "text": "护得住这山清水秀，一如她所愿。"
        },
        {
          "role": "蓝君明",
          "text": "我这痴人何苦自扰，这璃月，不从来都是如此吗？"
        },
        {
          "role": "蓝君明",
          "text": "月轮起兮送秋燕，沐风雨兮路漫漫。"
        },
        {
          "role": "蓝君明",
          "text": "你们何曾是我们，你们何必是我们。"
        },
        {
          "role": "蓝砚",
          "text": "这里也好了。"
        },
        {
          "role": "派蒙",
          "text": "我好像看出来了，是翅膀吗？"
        },
        {
          "type": "subtitle",
          "text": "协助蓝砚施放术法"
        },
        {
          "type": "subtitle",
          "text": "利用术法映出第三段纹样"
        },
        {
          "type": "subtitle",
          "text": "前往第三处机关所在的地点"
        },
        {
          "type": "subtitle",
          "text": "寻找机关的位置"
        },
        {
          "role": "蓝君明",
          "text": "风灵玄鸟逐秋月…"
        },
        {
          "role": "派蒙",
          "text": "我们还是先去找蓝砚他们吧。"
        },
        {
          "role": "蓝砚",
          "text": "应该就在这附近…"
        },
        {
          "type": "subtitle",
          "text": "推开玉璜龟"
        },
        {
          "type": "subtitle",
          "text": "触碰符箓"
        },
        {
          "role": "胡桃",
          "text": "风儿追着鸟儿，鸟儿追着月亮，月亮映在酒杯中，嘬完一口唱小曲儿。"
        },
        {
          "role": "胡桃",
          "text": "刚刚有感而发，即兴作诗一首，如何？"
        },
        {
          "type": "subtitle",
          "text": "映出燕子的纹样"
        },
        {
          "role": "蓝砚",
          "text": "全部的纹样应该都显示出来了。"
        },
        {
          "role": "派蒙",
          "text": "我看到了，是一只燕子！"
        },
        {
          "type": "subtitle",
          "text": "静候故人赴约"
        },
        {
          "role": "蓝君明",
          "text": "老朽先谢过了。"
        },
        {
          "role": "胡桃",
          "text": "怎么样，都准备好了吗？"
        },
        {
          "role": "蓝砚",
          "text": "接下来只要等待就好。"
        },
        {
          "role": "行秋",
          "text": "真期待，那位传说中的玄鸟仙子会是什么模样呢？"
        },
        {
          "role": "重云",
          "text": "那种术法生效后，会是怎样的景象呢？"
        },
        {
          "role": "蓝砚",
          "text": "只能先等待了…"
        },
        {
          "role": "派蒙",
          "text": "哈…"
        },
        {
          "role": "派蒙",
          "text": "…嗯？"
        },
        {
          "role": "派蒙",
          "text": "大家都醒醒，已经早上了！"
        },
        {
          "role": "胡桃",
          "text": "太阳出来我晒太阳…不对，月亮呢？"
        },
        {
          "role": "行秋",
          "text": "昨天到底等到多晚？"
        },
        {
          "role": "重云",
          "text": "该不会大家都睡过去了吧？"
        },
        {
          "role": "旅行者",
          "text": "蓝砚呢？"
        },
        {
          "role": "派蒙",
          "text": "那边！"
        },
        {
          "role": "蓝君明",
          "text": "咳咳…"
        },
        {
          "role": "派蒙",
          "text": "昨晚到底怎么样？"
        },
        {
          "role": "蓝君明",
          "text": "她没有来…咳咳…"
        },
        {
          "role": "派蒙",
          "text": "这…"
        },
        {
          "role": "胡桃",
          "text": "那今晚再试试？实在不行的话还有来年的逐月节！"
        },
        {
          "role": "蓝砚",
          "text": "行不通的，祖师爷身上的术式早已逼近极限，别说来年，就是再支撑几天，也不太可能了。"
        },
        {
          "role": "派蒙",
          "text": "那现在该怎么办？"
        },
        {
          "role": "行秋",
          "text": "这种结局我可不喜欢…有没有什么办法能直接找到那位玄鸟仙子？"
        },
        {
          "role": "胡桃",
          "text": "仙人大多来去无踪，靠我们很难找得到。"
        },
        {
          "role": "重云",
          "text": "非要说的话，昨天行秋拉我去逛国际美食街，正好遇到在那边帮忙的小姨。"
        },
        {
          "role": "重云",
          "text": "听她说，璃月的仙人们今天会在奥藏山聚会。有关仙人的事，直接找仙人问更合适。"
        },
        {
          "role": "蓝砚",
          "text": "我需要留下来帮助祖师爷稳定残魂。"
        },
        {
          "role": "派蒙",
          "text": "没关系，让我和旅行者去就好，我们和仙人们很熟的！"
        },
        {
          "role": "蓝砚",
          "text": "那真是有劳你们了，另外，我想劳烦胡堂主和重云也留下来，仅凭我一人，越来越难以稳定祖师爷的残魂了…"
        },
        {
          "role": "胡桃",
          "text": "客气了，直说就好。"
        },
        {
          "role": "旅行者",
          "text": "我们也该抓紧时间了。"
        },
        {
          "role": "派蒙",
          "text": "嗯，我们出发吧！"
        },
        {
          "type": "subtitle",
          "text": "前往奥藏山"
        },
        {
          "role": "闲云",
          "text": "嗯…唉…"
        },
        {
          "role": "削月筑阳真君",
          "text": "刚刚品到歌尘浪市带来的好茶，何故唉声叹气？"
        },
        {
          "role": "闲云",
          "text": "这个时节，璃月各地的邪祟会集中作乱，各位都知晓吧？"
        },
        {
          "role": "理水叠山真君",
          "text": "何必为此事担忧？那璃月总务司早早就派遣千岩军，召集民间方士，已然处理妥当，无需我等仙家出手。"
        },
        {
          "role": "闲云",
          "text": "正因如此，才有些感叹。以往，每当黎民百姓遭难，我等仙家总要忙碌一番。"
        },
        {
          "role": "闲云",
          "text": "而如今，这璃月在凡人治下安康太平，让我等有了这聚会品茶的闲暇，欣慰之余，又莫名有种寂寥之感。"
        },
        {
          "role": "理水叠山真君",
          "text": "我和削月特地前来相陪，你何必如此啊？"
        },
        {
          "role": "闲云",
          "text": "有你两位，只是平添聒噪罢了。"
        },
        {
          "role": "削月筑阳真君",
          "text": "慎言，这几日，她那两个徒弟一个在总务司，一个在遗珑埠，都十分忙碌，怕是没时间去看望她。"
        },
        {
          "role": "理水叠山真君",
          "text": "不是还新收了一个徒弟吗？"
        },
        {
          "role": "削月筑阳真君",
          "text": "新徒弟也快到需要独自历练的时候了吧？不会一直待在她身边的。"
        },
        {
          "role": "理水叠山真君",
          "text": "倒也难怪…留云啊，你若真想消磨这独居时光，就该多找几个爱好，不要总是盯着那机关之术。"
        },
        {
          "role": "理水叠山真君",
          "text": "园艺就不错，我看你这洞府外山清水秀，很适合开辟几处苗圃。"
        },
        {
          "role": "闲云",
          "text": "放肆！理水叠山，你又想在本仙这里种薄荷？"
        },
        {
          "role": "萍姥姥",
          "text": "哈哈…留云他们之间的「薄荷之争」是近年才有，但我又莫名觉得，这三位故交吵架的方式与百年前相比也并无不同。"
        },
        {
          "role": "钟离",
          "text": "璃月数千年，世间许多事，都莫不如此。"
        },
        {
          "role": "兹白",
          "text": "摩拉克斯，对于受赐于你的仙人来说，种植薄荷是僭越之事吗？"
        },
        {
          "role": "钟离",
          "text": "…惭愧，我一时不知该如何讲明此事。"
        },
        {
          "role": "派蒙",
          "text": "钟离！还有仙人们也都在，太好了！"
        },
        {
          "role": "闲云",
          "text": "旅行者和派蒙？莫非是恰逢佳节，你们专门来拜访我？"
        },
        {
          "role": "派蒙",
          "text": "其实…我们有急事！请问各位仙人，有谁认识玄鸟仙子吗？"
        },
        {
          "role": "兹白",
          "text": "你说的是「银翎翦玉玄鸟」吧？莫不是与那蓝疯子有关？"
        },
        {
          "role": "旅行者",
          "text": "他想要见玄鸟仙子。"
        },
        {
          "role": "兹白",
          "text": "倒也合理，我就说他如此折腾自己，不可能只是为了来过节。"
        },
        {
          "role": "派蒙",
          "text": "兹白知道玄鸟仙子现在在哪里吗？"
        },
        {
          "role": "兹白",
          "text": "这…我只记得她与蓝疯子结伴游历山水，成就了一段佳话，那之后的事，我也不太清楚。"
        },
        {
          "role": "兹白",
          "text": "桃都之事了却后，我的下尸并没有和其他的「八奇」常伴同游，而是游逸去了别处。"
        },
        {
          "role": "派蒙",
          "text": "这…"
        },
        {
          "role": "闲云",
          "text": "说起来，我们与那位玄鸟仙子有萍水之缘。"
        },
        {
          "role": "削月筑阳真君",
          "text": "我记得，彼时帝君与诸魔神之间的战争尚未结束，那位玄鸟仙子和我们一样，都尽力做着能庇护民众的事。"
        },
        {
          "role": "闲云",
          "text": "只是后来忽然失了联系…不过，我飞跃群山时偶尔还能看到燕群，才稍稍放心了些。燕群还在，至少说明她无恙。"
        },
        {
          "role": "理水叠山真君",
          "text": "既然是一位故人要见她，我们也该帮上一帮，只是…惭愧，我也不知道她如今身在何处。"
        },
        {
          "role": "萍姥姥",
          "text": "应该通过燕子能与她取得联系，然而我见到的燕子都行色匆匆，不肯驻足，不知是何原因…"
        },
        {
          "role": "萍姥姥",
          "text": "如果还能联系上，如今这聚会，肯定也要把她请来啊。"
        },
        {
          "role": "兹白",
          "text": "说来也怪，她的下落，那蓝疯子反倒要来问我们？"
        },
        {
          "role": "派蒙",
          "text": "所以仙人们也不知道她在哪里吗？"
        },
        {
          "role": "钟离",
          "text": "旅行者，那万象风角灵官还剩多少时日？"
        },
        {
          "role": "派蒙",
          "text": "如果这次逐月节还是见不到玄鸟仙子的话，他就没机会了…"
        },
        {
          "role": "钟离",
          "text": "那位玄鸟仙子的「下落」，我算是知晓，只是三言两语难以向你们讲明。"
        },
        {
          "role": "旅行者",
          "text": "你果然知道！我们真的要尽快找到她！"
        },
        {
          "role": "钟离",
          "text": "且先听我讲起…"
        },
        {
          "type": "subtitle",
          "text": "似曾相识燕归来"
        },
        {
          "type": "subtitle",
          "text": "似曾相识燕归来"
        },
        {
          "role": "萍姥姥",
          "text": "这玄鸟仙子的经历，莫名让我想起很多故人。"
        },
        {
          "role": "削月筑阳真君",
          "text": "歌尘浪市，你在尘世居留太久，沾染了太多凡人的情愫，开始伤春悲秋啦。"
        },
        {
          "role": "理水叠山真君",
          "text": "所以啊，学一学园艺，开辟一个苗圃…"
        },
        {
          "role": "闲云",
          "text": "看吧，这两位又开始聒噪了。"
        },
        {
          "role": "钟离",
          "text": "那玄鸟仙子是天地灵气汇聚而生的仙人，天上的燕群，既是她自己的化身，也是她的仙力来源。"
        },
        {
          "role": "钟离",
          "text": "魔神战争期间，从沉玉谷到孤云阁的这段路途异常凶险。虽然燕群可以跨越这段路途，但总会有不少燕子折损在路上。"
        },
        {
          "role": "玄鸟仙子",
          "text": "终于到璃月港了，还差最后一程…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那这不就相当于…",
              "dialogues": []
            },
            {
              "text": "玄鸟仙子受了很重的伤？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "钟离",
          "text": "确实如此，但她不曾停下。"
        },
        {
          "role": "派蒙",
          "text": "玄鸟仙子…"
        },
        {
          "role": "钟离",
          "text": "不过，身为仙人，她也不是没有应对之法。"
        },
        {
          "type": "subtitle",
          "text": "似曾相识燕归来"
        },
        {
          "role": "兹白",
          "text": "对于这尘世来说，「时间」竟是这样的存在吗？"
        },
        {
          "role": "钟离",
          "text": "你觉得如何？"
        },
        {
          "role": "兹白",
          "text": "我倒觉得，总好过月亮上那种清冷的恒久。"
        },
        {
          "role": "钟离",
          "text": "只要得到休憩，燕群总会繁衍生息，恢复种群数量。如此，玄鸟仙子的仙力就可以恢复如初。"
        },
        {
          "role": "钟离",
          "text": "这正是她能飞跃凶险路途的倚仗。"
        },
        {
          "role": "玄鸟仙子",
          "text": "是时候返程了，他还在等我。回去后，也得让燕子们把沉玉谷的巢整修一下了。"
        },
        {
          "role": "派蒙",
          "text": "太好了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但如此反复…",
              "dialogues": []
            },
            {
              "text": "真的没问题吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "钟离",
          "text": "起初，玄鸟仙子并未察觉到什么异样。"
        },
        {
          "role": "派蒙",
          "text": "起初？"
        },
        {
          "type": "subtitle",
          "text": "似曾相识燕归来"
        },
        {
          "role": "蓝君明",
          "text": "终究还是…"
        },
        {
          "role": "钟离",
          "text": "彼时，那场大战迁延日久，但仍旧看不到尽头。"
        },
        {
          "role": "钟离",
          "text": "玄鸟仙子的这场苦旅，已经持续了数十年。"
        },
        {
          "role": "玄鸟仙子",
          "text": "必须回去，回…向北飞，去见他…"
        },
        {
          "role": "玄鸟仙子",
          "text": "只有这样…才能…"
        },
        {
          "role": "派蒙",
          "text": "玄鸟仙子的样子有些奇怪…"
        },
        {
          "role": "钟离",
          "text": "正如我之前所言，这燕群是玄鸟仙子的化身。有燕子折损在路上，消耗的不仅是她的仙力，亦是她的灵智。"
        },
        {
          "role": "钟离",
          "text": "新生的燕子可以补充仙力，但无法补回这部分失去的灵智。"
        },
        {
          "role": "派蒙",
          "text": "什么…那她还是没有停下吗？"
        },
        {
          "role": "钟离",
          "text": "是因为和故人有约？还是因为放不下被邪祟侵扰的民众？总之，她没有停下。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "如此持续下去…",
              "dialogues": []
            },
            {
              "text": "最后会怎样？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "钟离",
          "text": "最后…"
        },
        {
          "type": "subtitle",
          "text": "似曾相识燕归来"
        },
        {
          "role": "蓝砚",
          "text": "接下来应该就是最后一部分了。"
        },
        {
          "role": "派蒙",
          "text": "玄鸟仙子…"
        },
        {
          "role": "玄鸟仙子",
          "text": "……"
        },
        {
          "role": "钟离",
          "text": "大战终结，璃月也终于迎来了平和的时光。"
        },
        {
          "role": "钟离",
          "text": "但彼时的燕子们，已经忘了还与一个凡人有约定，也忘了沉玉谷是它们的另一个家乡，甚至忘了要停留下来筑巢。"
        },
        {
          "role": "钟离",
          "text": "只是被某种惯性驱使着，仍旧往来于璃月的南北之间，行色匆匆，很少停留，因此也很难被人看到了。"
        },
        {
          "role": "派蒙",
          "text": "所以玄鸟仙子最后还是…"
        },
        {
          "role": "钟离",
          "text": "仙逝吗？并非如此。只要璃月的燕子还在，玄鸟仙子就没有逝去，只是…"
        },
        {
          "role": "钟离",
          "text": "据说许久之前，有一位哲人曾如此思索——"
        },
        {
          "role": "钟离",
          "text": "一众水手采伐良木，建造新船，扬帆出港。"
        },
        {
          "role": "钟离",
          "text": "然而海上风浪甚急，船身屡遭损毁。于是每当靠岸之时，水手们便采买木料，修补破损之处。"
        },
        {
          "role": "钟离",
          "text": "甲板、栏楯、桅樯、布帆…船上的种种部件依次被替换。及至归返母港，最初用来建造这艘船的旧材，几乎无一留存。"
        },
        {
          "role": "钟离",
          "text": "试问，这归港之船与那离港之船，可否算作同一艘船？"
        },
        {
          "role": "派蒙",
          "text": "这…"
        },
        {
          "role": "钟离",
          "text": "这便是玄鸟仙子的「下落」，其实燕子年年都会回来，只是不再是当年的燕子了。"
        },
        {
          "type": "subtitle",
          "text": "似曾相识燕归来"
        },
        {
          "role": "蓝砚",
          "text": "准备好了我们就继续吧。"
        },
        {
          "role": "兹白",
          "text": "那「银翎翦玉玄鸟」的最后，竟是如此…"
        },
        {
          "role": "钟离",
          "text": "古时，璃月的诗人常常以「燕子归来，故人不再」为意象，感叹时光匆匆。"
        },
        {
          "role": "钟离",
          "text": "然而凡人的寿数尚不是时间最残酷的那一面，面对漫长的时光，即便是仙人，也往往无法遵守一个长久的约定。"
        },
        {
          "role": "派蒙",
          "text": "那璃月的燕子最后会怎么样？"
        },
        {
          "role": "钟离",
          "text": "假以时日，燕群当中应该会诞生新的灵智，不过，正如我之前提出的那个问题。"
        },
        {
          "role": "钟离",
          "text": "那万象风角灵官，是否认可这是当年与他一同游历山水的玄鸟仙子呢？"
        },
        {
          "role": "派蒙",
          "text": "我…我也不知道该怎么讲。"
        },
        {
          "role": "钟离",
          "text": "无可奈何花落去，似曾相识燕归来，终究是似曾相识燕归来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是该告诉他…",
              "dialogues": []
            },
            {
              "text": "还是不告诉他？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "闲云",
          "text": "如今看来，他知与不知，都算不得圆满，无非是两种不同的遗憾罢了。"
        },
        {
          "role": "钟离",
          "text": "不过正因如此，倒更适合放手去做。若是足够尽心，从这两种遗憾中寻得一种圆满，倒也不是不可能。"
        },
        {
          "role": "钟离",
          "text": "旅行者，这件事就无需交给我们定夺了。"
        },
        {
          "role": "派蒙",
          "text": "嗯，我们回去找蓝砚吧。"
        },
        {
          "type": "subtitle",
          "text": "前往遗珑埠"
        },
        {
          "role": "派蒙",
          "text": "大家都在！"
        },
        {
          "role": "旅行者",
          "text": "蓝砚祖师爷还好吗？"
        },
        {
          "role": "蓝砚",
          "text": "多亏大家帮忙，我稳定了他的残魂。他现在非常需要休息，我就拜托大伯安排了一间客房，让他先睡下了。"
        },
        {
          "role": "胡桃",
          "text": "快来说说，找到玄鸟仙子的下落了吗？"
        },
        {
          "role": "派蒙",
          "text": "这个嘛…"
        },
        {
          "role": "？？？",
          "text": "你向大家转述了玄鸟仙子的经历。"
        },
        {
          "role": "胡桃",
          "text": "这样的结局，当真是…唉…"
        },
        {
          "role": "重云",
          "text": "这样的话，蓝砚祖师爷身上的禁制岂不是无法解开了？"
        },
        {
          "role": "行秋",
          "text": "还轮不到考虑这个，首先，我们该如何向他讲？"
        },
        {
          "role": "蓝砚",
          "text": "其实，这已经不是祖师爷的第一次苏醒了。过去的上千年间，他苏醒过很多次，只是…"
        },
        {
          "role": "蓝砚",
          "text": "只怕他很早就知道了玄鸟仙子无法再来赴约，心绪大乱，几乎无法维系残魂的存在。"
        },
        {
          "role": "蓝砚",
          "text": "于是就只能利用拘魂术的特性，让自己忘掉玄鸟仙子的失约，再次沉睡，寄希望于来年能有转机。"
        },
        {
          "role": "胡桃",
          "text": "蓝砚，你说过他身上的拘魂术已经到极限了，那要是再来一次，岂不是直接…"
        },
        {
          "role": "蓝砚",
          "text": "看来只能试一试了…"
        },
        {
          "role": "蓝砚",
          "text": "无论是告知他实情，还是解开他身上的禁制，我都想试一试！"
        },
        {
          "role": "派蒙",
          "text": "蓝砚…"
        },
        {
          "role": "蓝砚",
          "text": "其实，之前宗家的长辈们外出尽责，而我闲居在家时，我也忍不住想过，什么都不做真的可以吗？"
        },
        {
          "role": "蓝砚",
          "text": "我只是个贪玩的孩子罢了，最留恋的就是能放风筝的山坡。"
        },
        {
          "role": "蓝砚",
          "text": "如今，我忽然觉得，我的这份留恋和长辈们肩负重担时所持有的信念，本质上或许并无不同。"
        },
        {
          "role": "蓝砚",
          "text": "只是我还没找到属于我的那份「责任」。"
        },
        {
          "role": "蓝砚",
          "text": "我想要让燕子重新回来筑巢，也想要让祖师爷能了却遗憾，更想让佳节期间仍在四处奔波的长辈能早日与家人团圆。"
        },
        {
          "role": "蓝砚",
          "text": "这是我想做的事，也是我该做的事。"
        },
        {
          "role": "旅行者",
          "text": "蓝砚，你似乎想到了可行的办法，告诉我们该怎么做吧。"
        },
        {
          "role": "胡桃",
          "text": "嗯，不要犹豫，我们都可以帮你。"
        },
        {
          "role": "蓝砚",
          "text": "那么就再次劳烦各位了。"
        },
        {
          "role": "？？？",
          "text": "蓝砚向大家说明了她的计划，并约定等待到入夜时分。"
        },
        {
          "type": "subtitle",
          "text": "风灵玄鸟逐秋月"
        },
        {
          "role": "蓝砚",
          "text": "祖师爷，您果然又来这里了。"
        },
        {
          "role": "蓝君明",
          "text": "今天早些时候，你说过老朽身上的术式已经快到极限了，对吧？"
        },
        {
          "role": "蓝砚",
          "text": "确实如此。"
        },
        {
          "role": "蓝君明",
          "text": "你不必如此顾忌，大可早些讲明，老朽对此早有预感。"
        },
        {
          "role": "蓝君明",
          "text": "用了这拘魂术，老朽当然不是奢求永恒。或许老朽只是不想让她在某次赴约后孤守整夜，落寞而归。"
        },
        {
          "role": "蓝君明",
          "text": "老朽想的是最后至少能再见她一面，正式与她道别。这样一来，老朽也就不算失约了吧？"
        },
        {
          "role": "蓝砚",
          "text": "祖师爷，如果失约的不是您呢？"
        },
        {
          "role": "蓝君明",
          "text": "何意？"
        },
        {
          "role": "蓝砚",
          "text": "请听晚辈向您讲明…"
        },
        {
          "role": "蓝砚",
          "text": "…如此，便是玄鸟仙子的结局。"
        },
        {
          "role": "蓝君明",
          "text": "原来失约的不是老朽，失约的竟不是老朽吗？咳咳…"
        },
        {
          "role": "蓝君明",
          "text": "看来老朽是必然得不到解脱了，痴妄之人，终究是如此下场。"
        },
        {
          "role": "蓝砚",
          "text": "不该如此！"
        },
        {
          "role": "蓝君明",
          "text": "你如此费力帮老朽，又是何苦啊？"
        },
        {
          "role": "蓝砚",
          "text": "祖师爷，您教导晚辈要像鸟儿一样，可是晚辈最喜欢的鸟儿，就是燕子。"
        },
        {
          "role": "蓝砚",
          "text": "燕子就是这样，即便能飞上天去，也总是会衔着泥草回来，编织些什么。"
        },
        {
          "role": "蓝砚",
          "text": "晚辈觉得这不该是您的结局，所以想拼上自己学的这些「皮毛」，从那两种遗憾当中，为您寻得一种圆满。"
        },
        {
          "role": "蓝君明",
          "text": "这是…"
        },
        {
          "role": "蓝砚",
          "text": "有了您的指点，再加上朋友们的帮助，我终于知道我的术式中缺少的部分是什么了。"
        },
        {
          "role": "蓝砚",
          "text": "如今璃月方士人人都能学会的「辟邪之术」，正是当年只有您才能掌握的「绝学」。"
        },
        {
          "role": "蓝砚",
          "text": "蓝氏一族继承了您的理念，有外族方士来求学，也从不拒绝。"
        },
        {
          "role": "蓝砚",
          "text": "您和玄鸟仙子合力完成的术法，早已通过另一种方式被重新布设到璃月全境。"
        },
        {
          "role": "蓝砚",
          "text": "而晚辈重现的这种术法，就当作是为您送别的演出吧。"
        },
        {
          "role": "派蒙",
          "text": "他走了吗？"
        },
        {
          "role": "蓝砚",
          "text": "施术完成后，我成功解开了拘魂术的禁制，祖师爷的残魂应该已经回归地脉了。"
        },
        {
          "role": "派蒙",
          "text": "那他了却心愿了吗？"
        },
        {
          "role": "蓝砚",
          "text": "我希望是。"
        },
        {
          "role": "兹白",
          "text": "你是不是早就知道蓝疯子的事，却还是让他们奔波这一场？"
        },
        {
          "role": "钟离",
          "text": "我不是没有尝试过向他讲述玄鸟仙子的事，但他始终没有放下，如此往复了许多年，直到残烛将尽。"
        },
        {
          "role": "钟离",
          "text": "但今年有新的面孔出现，我觉得这或许能带来转机。"
        },
        {
          "role": "兹白",
          "text": "也好，这蓝疯子总归是解脱了。"
        },
        {
          "role": "钟离",
          "text": "现在，你又如何看待这位故交？"
        },
        {
          "role": "兹白",
          "text": "细想一番，也算是一个妙人。"
        },
        {
          "role": "行秋",
          "text": "失约千年后再次相见…真是个不错的写作素材。"
        },
        {
          "role": "重云",
          "text": "能够布设到璃月全境…这样的奇术该有多厉害？真想学。"
        },
        {
          "role": "行秋",
          "text": "重点完全错了吧？"
        },
        {
          "role": "重云",
          "text": "你的重点才错了吧？"
        }
      ]
    }
  ]
}