{
  "quest_id": 10217,
  "chapter_num": "流灰之国的迷旅人·尾声",
  "chapter_title": "受选者的诺言",
  "type": "wq",
  "route": "The Chosen One's Promise",
  "stories": [
    {
      "story_id": 75138,
      "title": "受选者的诺言",
      "description": "回去天蛇船与伙伴会合吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "返回天蛇船"
        },
        {
          "type": "subtitle",
          "text": "与小嵴锋龙伙伴对话"
        },
        {
          "role": "派蒙",
          "text": "小家伙，你没事吧？"
        },
        {
          "role": "小家伙",
          "text": "呀！"
        },
        {
          "role": "派蒙",
          "text": "真是太好了，旅行者在那个…呃，好难解释，总之就是他在梦里看到你和奇怪的人在一起。"
        },
        {
          "role": "派蒙",
          "text": "你在天蛇船上有遇到什么奇怪的人吗？"
        },
        {
          "role": "小家伙",
          "text": "呀…呀！"
        },
        {
          "role": "派蒙",
          "text": "欸？那到底是有还是没有啦？"
        },
        {
          "role": "小家伙",
          "text": "呜…呀！呀！"
        },
        {
          "type": "subtitle",
          "text": "完成系列任务「在应许与遗忘之间」"
        },
        {
          "role": "派蒙",
          "text": "哇，完全搞不懂你想说什么啦！"
        },
        {
          "type": "subtitle",
          "text": "未完成系列任务「在应许与遗忘之间」"
        },
        {
          "role": "派蒙",
          "text": "我已经完全搞不懂啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "既然小家伙没事就好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是哦，不过玻娜呢，玻娜去哪啦？"
        },
        {
          "role": "小家伙",
          "text": "唔…"
        },
        {
          "role": "派蒙",
          "text": "难道你们走散了吗？还是说玻娜她真的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许玻娜只是故事中的角色。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯…你说的也是呢，普通人是没办法活几百年的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但至少我们完成了她未完的冒险。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是哦，我们也答应了她，要好好宣传这段冒险经历。等大伙都知道我们找到了天蛇船，玻娜也会成为大名鼎鼎的冒险家吧。"
        },
        {
          "type": "subtitle",
          "text": "完成系列任务「在应许与遗忘之间」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "接下来就该…",
              "dialogues": []
            },
            {
              "text": "接下来就该去火山找「那个人」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这样说来，那个家伙该不会就是「盗火贤者」吧？一路上都是他留下来的讯息，我是越来越好奇了！"
        },
        {
          "type": "subtitle",
          "text": "未完成系列任务「在应许与遗忘之间」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "接下来就该去火山找「那个人」…",
              "dialogues": []
            },
            {
              "text": "把事情弄清楚了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你是说你在记忆里见到的那个奇怪的「人」吗？"
        },
        {
          "role": "派蒙",
          "text": "这样说来，那个家伙到底是谁啊？该不会就是一路上留下那个金色花纹的人？我是越来越好奇了！"
        },
        {
          "role": "派蒙",
          "text": "而且那家伙还说自己会假扮成不同的身份，就算遇到了我们也不一定能认得出来吧…"
        },
        {
          "role": "小家伙",
          "text": "呀！"
        },
        {
          "role": "派蒙",
          "text": "果然你也很好奇吧，小家伙。"
        },
        {
          "type": "subtitle",
          "text": "完成系列任务「在应许与遗忘之间」"
        },
        {
          "role": "派蒙",
          "text": "既然信物也已经找齐了，接下来我们就和小家伙一起去火山吧，解开所有的秘密，然后帮小家伙解除诅咒。"
        },
        {
          "type": "subtitle",
          "text": "未完成系列任务「在应许与遗忘之间」"
        },
        {
          "role": "派蒙",
          "text": "既然已经找到了一个信物，接下来我们就趁热打铁，想办法再找到另一个吧。"
        },
        {
          "role": "派蒙",
          "text": "然后和小家伙一起去火山吧，在那里一定能解开所有的秘密，再帮小家伙解除诅咒。"
        },
        {
          "role": "派蒙",
          "text": "对不起喔，玻娜，「通牒金盘」我们要先带走咯。等到我们把所有事情都搞清楚之后，再把一切告诉你吧！"
        }
      ]
    }
  ]
}