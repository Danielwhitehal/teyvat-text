{
  "quest_id": 25029,
  "chapter_num": null,
  "chapter_title": "龙与山",
  "type": "iq",
  "route": "Saurian Versus Mountain",
  "stories": [
    {
      "story_id": 25029,
      "title": "龙与山",
      "description": "在「回声之子」部族中，特拉忒正在为某事而发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与特拉忒对话"
        },
        {
          "role": "特拉忒",
          "text": "乖乖喔，不要灰心，只要你身体好了，然后…加油学习！一定能很快爬到山顶的！"
        },
        {
          "role": "奇卡",
          "text": "呜呜…呜…"
        },
        {
          "role": "特拉忒",
          "text": "你是不是肚子饿了？嗯…那我去给你拿点吃的喔。"
        },
        {
          "role": "奇卡",
          "text": "呜…呜…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么呢？"
        },
        {
          "role": "特拉忒",
          "text": "我在陪我的伙伴奇卡玩呢。虽然它还很小，但我妈妈说，它长大后，肯定会和其他匿叶龙一样厉害！"
        },
        {
          "role": "奇卡",
          "text": "呜…呜呜…"
        },
        {
          "role": "特拉忒",
          "text": "别难过啦。你只是身子太弱了，之前还受过伤。"
        },
        {
          "role": "特拉忒",
          "text": "妈妈说，只要你多吃好吃的，然后和我一起多多锻炼，肯定会好起来的。"
        },
        {
          "role": "奇卡",
          "text": "呜？呜呜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（摸摸奇卡。）",
              "dialogues": [
                {
                  "role": "奇卡",
                  "text": "呜呜…呜…"
                }
              ]
            },
            {
              "text": "它是怎么受伤的？",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "我不知道…也许妈妈知道！但妈妈把奇卡带回来的时候，它就生着病呢。"
                },
                {
                  "role": "特拉忒",
                  "text": "奇卡吃不下东西，也没力气动。我只能每天把药化在水里，然后喂它喝下去。"
                },
                {
                  "role": "特拉忒",
                  "text": "虽然奇卡最后病好了，但是…它的身体很弱。没办法像其他的匿叶龙一样，在悬崖旁边窜来窜去。"
                },
                {
                  "role": "特拉忒",
                  "text": "它因为这件事一直很难过，所以我想要帮它！让它恢复健康，然后…变得比其他匿叶龙还要强！"
                },
                {
                  "role": "奇卡",
                  "text": "呜！"
                }
              ]
            }
          ]
        },
        {
          "role": "特拉忒",
          "text": "哎呀，说了这么多话，马上就要锻炼了，先吃点东西好了。"
        },
        {
          "role": "特拉忒",
          "text": "这可是我妈妈特制的果干，先在大锅里炒啊炒，然后加入很多香香的调料…"
        },
        {
          "role": "特拉忒",
          "text": "而且还要加好多糖和花瓣…总之，味道可好了！我这就给你欸？…"
        },
        {
          "role": "特拉忒",
          "text": "我的果干呢？明明放在包里的…"
        },
        {
          "role": "奇卡",
          "text": "…呜，呜…"
        },
        {
          "role": "特拉忒",
          "text": "呜哇！奇卡！难道都被你偷吃了？都说了不要馋嘴，吃多了就跑不动啦！"
        },
        {
          "role": "奇卡",
          "text": "唔唔，呜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有食欲是好事。",
              "dialogues": []
            },
            {
              "text": "吃得多长得壮。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奇卡",
          "text": "呜呜，呜呜呜！"
        },
        {
          "role": "特拉忒",
          "text": "是这样吗？那…我也要和奇卡一样。吃好多东西，快快长大，然后帮妈妈的忙。"
        },
        {
          "role": "特拉忒",
          "text": "好，那我们就开始锻炼吧，奇卡！"
        },
        {
          "role": "奇卡",
          "text": "呜！"
        },
        {
          "role": "特拉忒",
          "text": "我看看喔…那今天就训练一下登山吧。"
        },
        {
          "role": "奇卡",
          "text": "呜，呜…"
        },
        {
          "role": "特拉忒",
          "text": "还是和上次一样，不会很难的。打起劲来呀，奇卡。"
        },
        {
          "role": "奇卡",
          "text": "…呜！"
        },
        {
          "role": "特拉忒",
          "text": "对了，亚瓦尔叔叔上次和我说，如果想要正经训练的话，就需要找到一个合理的「训练目标」…"
        },
        {
          "role": "特拉忒",
          "text": "要是我能找到一个很厉害的冒险家，让他帮我制订目标就好了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我是比较厉害的冒险家。",
              "dialogues": []
            },
            {
              "text": "厉害的冒险家就在你身边。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特拉忒",
          "text": "真的？那…大哥哥，你愿意帮我吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要我带着你们爬山吗？",
              "dialogues": []
            },
            {
              "text": "好，跟着我，现在就开始！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特拉忒",
          "text": "不是不是，如果大哥哥真的那么厉害，我们可追不上啦。"
        },
        {
          "role": "特拉忒",
          "text": "我们会在地上看着大哥哥，算好时间的。"
        },
        {
          "role": "特拉忒",
          "text": "拜托大哥哥用出全力，以最快的速度爬上山顶吧！"
        },
        {
          "role": "奇卡",
          "text": "呜！呜！"
        },
        {
          "role": "特拉忒",
          "text": "乖乖喔，今天吃饱了吗？有没有力气训练呀？"
        },
        {
          "role": "奇卡",
          "text": "呜，呜呜，呜！"
        },
        {
          "role": "特拉忒",
          "text": "呜哇，这么有活力？好！那今天可要加把劲了！"
        },
        {
          "role": "旅行者",
          "text": "一起加把劲吧！"
        },
        {
          "role": "特拉忒",
          "text": "欸？您好呀，大哥哥！我们正在进行爬山训练呢。"
        },
        {
          "role": "奇卡",
          "text": "呜呜！呜呜！"
        },
        {
          "role": "奇卡",
          "text": "呜呜，呜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "训练得怎么样？",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "那个…至少能说「有进步」吧。这次奇卡爬的比上次高多了。"
                },
                {
                  "role": "特拉忒",
                  "text": "就是在爬山的时候，奇卡的动作有些不熟练…"
                }
              ]
            },
            {
              "text": "看起来它恢复得不错。",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "当然啦。妈妈都说，我可擅长照料奇卡了。"
                },
                {
                  "role": "特拉忒",
                  "text": "奇卡的进步可大了，爬的高度也比上次高很多。"
                },
                {
                  "role": "特拉忒",
                  "text": "就是在爬山的时候，奇卡的动作有些不熟练…"
                }
              ]
            }
          ]
        },
        {
          "role": "特拉忒",
          "text": "大哥哥，你能再为我们示范一遍吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "谢谢你！这次我一定能看清大哥哥的动作。"
                },
                {
                  "role": "特拉忒",
                  "text": "奇卡，你也要睁大眼睛喔。"
                },
                {
                  "role": "奇卡",
                  "text": "呜！"
                }
              ]
            },
            {
              "text": "这次可要看清我的动作。",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "当然啦。我和奇卡都会睁大眼睛仔细看的，这次一定能看清！"
                }
              ]
            }
          ]
        },
        {
          "role": "特拉忒",
          "text": "那就拜托你啦，大哥哥。"
        },
        {
          "role": "特拉忒",
          "text": "我们会在地上看着大哥哥，算好时间的。"
        },
        {
          "role": "奇卡",
          "text": "呜，呜呜…"
        },
        {
          "role": "特拉忒",
          "text": "那就拜托你啦，大哥哥。我们会在地上仔细看着你的动作，算好时间的。"
        },
        {
          "type": "subtitle",
          "text": "爬上山顶"
        },
        {
          "role": "特拉忒",
          "text": "嘿嘿，那就拜托大哥哥啦，我们会在底下算好时间的。"
        },
        {
          "role": "奇卡",
          "text": "呜，呜？呜呜…"
        },
        {
          "type": "subtitle",
          "text": "与特拉忒对话"
        },
        {
          "role": "特拉忒",
          "text": "大哥哥好厉害！爬得和马伊塔一样快！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有，有点失误…",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "失误？难道大哥哥还能爬得更快？这就是超厉害冒险家的实力吗…"
                }
              ]
            },
            {
              "text": "马伊塔是谁？",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "他是我的朋友，特别擅长攀岩。除了洛娅姐姐之外，几乎没人能在攀岩这个项目里胜过他。"
                }
              ]
            }
          ]
        },
        {
          "role": "特拉忒",
          "text": "把这个爬山时间作为目标的话…嗯…"
        },
        {
          "role": "奇卡",
          "text": "呜，呜呜…"
        },
        {
          "role": "特拉忒",
          "text": "…哈哈，好像还是有些难为你了呢。"
        },
        {
          "role": "特拉忒",
          "text": "没关系，我等下拿着大哥哥的爬山时间去找马伊塔。说不定，他能帮我制订一个…合理的训练计划。"
        },
        {
          "role": "特拉忒",
          "text": "大哥哥，谢谢你帮忙，这枚「苦种」给你。"
        },
        {
          "role": "特拉忒",
          "text": "这是我们刚摘下来的，可新鲜了，做成巧克力一定好吃！"
        },
        {
          "role": "奇卡",
          "text": "呜呜，呜呜！"
        },
        {
          "role": "特拉忒",
          "text": "那我们就出发吧，不知道马伊塔在不在部族里。他不会又出去攀岩了吧…"
        },
        {
          "role": "特拉忒",
          "text": "大哥哥好厉害！我都没能看清你爬上去的动作…但是你爬山的速度，比马伊塔还要快！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "发挥得一般。",
              "dialogues": []
            },
            {
              "text": "马伊塔是谁？",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "他是我的朋友，特别擅长攀岩。除了洛娅姐姐之外，几乎没人能在攀岩这个项目里胜过他。"
                }
              ]
            }
          ]
        },
        {
          "role": "特拉忒",
          "text": "但是，这么短的登山时间…奇卡应该暂时没法做到啦…"
        },
        {
          "role": "奇卡",
          "text": "呜，呜呜…"
        },
        {
          "role": "特拉忒",
          "text": "没关系，我等下拿着大哥哥的爬山时间去找马伊塔。说不定，他能帮我制订一个…合理的训练计划。"
        },
        {
          "role": "特拉忒",
          "text": "大哥哥，谢谢你帮忙，这些「苦种」给你。"
        },
        {
          "role": "特拉忒",
          "text": "这是我们刚摘下来的，可新鲜了，做成巧克力一定好吃！"
        },
        {
          "role": "奇卡",
          "text": "呜呜，呜呜！"
        },
        {
          "role": "特拉忒",
          "text": "那我们就出发吧，不知道马伊塔在不在部族里。他不会又出去攀岩了吧…"
        }
      ]
    }
  ]
}