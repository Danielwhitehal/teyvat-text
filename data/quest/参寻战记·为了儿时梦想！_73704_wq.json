{
  "quest_id": 73704,
  "chapter_num": null,
  "chapter_title": "参寻战记·为了儿时梦想！",
  "type": "wq",
  "route": "Search Chronicle: For Childhood Dreams!",
  "stories": [
    {
      "story_id": 73704,
      "title": "参寻战记·为了儿时梦想！",
      "description": "前两次碰壁并没有让兰吉特萌生退意，他能在须弥扳回一城吗？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往翠翎恐蕈的巢窟"
        },
        {
          "role": "兰吉特",
          "text": "今天也是充满全新希望的一天！两位，我们这就出发？"
        },
        {
          "role": "派蒙",
          "text": "全新希望…这么说来，和古岩龙蜥的交流算是失败了吧。"
        },
        {
          "role": "兰吉特",
          "text": "怎么能说是失败呢，搏斗也算是一种交流。"
        },
        {
          "role": "兰吉特",
          "text": "从这个角度来说，我们算是进行了坦率且深入的交流，并且在此过程中充分了解了对方的立场。"
        },
        {
          "role": "兰吉特",
          "text": "那话怎么说的来着，「不打不相识」嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "早料到会这样了…",
              "dialogues": [
                {
                  "role": "兰吉特",
                  "text": "但我还是要说，凡事总得试试！"
                }
              ]
            },
            {
              "text": "在搏斗的根本就是我。",
              "dialogues": [
                {
                  "role": "兰吉特",
                  "text": "不愧是正牌的冒险家，哪怕是我也看得出来，搏斗的经验相当丰富！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "所以你还不打算放弃吗？"
        },
        {
          "role": "兰吉特",
          "text": "实不相瞒，我小时候的梦想之一就是骑着翠翎恐蕈游遍须弥…"
        },
        {
          "role": "兰吉特",
          "text": "但是当时大人们只会跟我说别傻了，去问巡林官，他们也是面露难色，让我不要冒险。"
        },
        {
          "role": "兰吉特",
          "text": "于是我就放弃了不切实际的梦想，和其他孩子一样普通地长大了，唯一的小小冒险也只是在食材的选择上…"
        },
        {
          "role": "兰吉特",
          "text": "偶尔想起来，原来自己儿时还有过这样的梦想，有种遥远又陌生的感觉，就像传说中的兰那罗一样。"
        },
        {
          "role": "兰吉特",
          "text": "如果他们真的存在，我也曾经见过他们，那我是从何时起不再能看到他们，也不再记得他们的呢？"
        },
        {
          "role": "兰吉特",
          "text": "在纳塔的时候我听说了一个故事，讲的是一个叫昆图尔的倒霉家伙，因为父亲犯的过错，甚至被太阳厌弃了。"
        },
        {
          "role": "兰吉特",
          "text": "「不受太阳喜爱的昆图尔」在部族里也不受待见，当然也没有龙愿意当他的伙伴。"
        },
        {
          "role": "兰吉特",
          "text": "但他没有气馁，没有埋怨父亲，也没有埋怨命运，而是用努力证明了自己并不输给一族里最强悍的战士。"
        },
        {
          "role": "兰吉特",
          "text": "最后，他凭借勇气和智慧做了一件了不起的事，不仅获得了暝视龙伙伴的认可，也成了一族的英雄。"
        },
        {
          "role": "兰吉特",
          "text": "听了他的故事之后，我也有了勇气重拾儿时的梦想。"
        },
        {
          "role": "派蒙",
          "text": "还有这样的理由啊…"
        },
        {
          "role": "兰吉特",
          "text": "所以跟翠翎恐蕈正面「交涉」的事就拜托两位了！"
        },
        {
          "role": "派蒙",
          "text": "结果还是要交给我们啊！"
        },
        {
          "role": "兰吉特",
          "text": "以我现在的实力，实在不是翠翎恐蕈的对手…但我会做好辅助工作的，有需要随时叫我！"
        },
        {
          "role": "兰吉特",
          "text": "话不多说，咱们这就走吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "走吧。",
              "dialogues": []
            },
            {
              "text": "还有别的事，稍候。",
              "dialogues": [
                {
                  "role": "兰吉特",
                  "text": "没问题，我就在这儿等你。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（兰吉特）"
        },
        {
          "role": "兰吉特",
          "text": "准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好了，走吧。",
              "dialogues": []
            },
            {
              "text": "关于昆图尔的故事…",
              "dialogues": [
                {
                  "role": "兰吉特",
                  "text": "说起来朋友只给我讲了后半的故事，并没有讲前半。他父亲到底犯了什么错才会让太阳这么痛恨呢？"
                },
                {
                  "role": "兰吉特",
                  "text": "太阳用金箭刺瞎了他父亲的眼睛作为惩罚还不够，凡是昆图尔所到的地方，太阳都会躲在云层后边。"
                },
                {
                  "role": "兰吉特",
                  "text": "听说也有壁画记录了他的故事，不过我没有亲眼见过。"
                },
                {
                  "role": "兰吉特",
                  "text": "说起来，纳塔的壁画也很独特，不仅漂亮，也很有趣！有时想想，如果我去纳塔时带的不是锅而是留影机就好了…"
                }
              ]
            },
            {
              "text": "还有别的事，稍候。",
              "dialogues": [
                {
                  "role": "兰吉特",
                  "text": "没问题，我就在这儿等你。"
                }
              ]
            }
          ]
        },
        {
          "role": "兰吉特（心声）",
          "text": "（儿时的梦想成真…也是不错的故事题材？）"
        }
      ],
      "collapse_ranges": [
        [
          24,
          27
        ]
      ]
    }
  ]
}