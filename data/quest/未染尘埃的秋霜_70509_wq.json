{
  "quest_id": 70509,
  "chapter_num": null,
  "chapter_title": "未染尘埃的秋霜",
  "type": "wq",
  "route": "Untainted Autumn Frost",
  "stories": [
    {
      "story_id": 70509,
      "title": "未染尘埃的秋霜",
      "description": "「你说，那位路过的那位白头发女人，是不是璃月那边的仙人啊。」「我不懂，你懂吗？」「我也不懂…」",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与申鹤对话"
        },
        {
          "role": "申鹤",
          "text": "旅行者，你好。"
        },
        {
          "role": "派蒙",
          "text": "你好呀！唉，要不是连续见了那么多朋友，我肯定会很惊讶，连你都来了呢…"
        },
        {
          "role": "派蒙",
          "text": "不…不对，这不是申鹤嘛！我果然还是被惊讶到了！"
        },
        {
          "role": "申鹤",
          "text": "嗯…这里确实不好找。「天使的馈赠」…名字拗口。"
        },
        {
          "role": "申鹤",
          "text": "多亏热心的钟离先生帮忙指路。"
        },
        {
          "role": "派蒙",
          "text": "还让人指路了啊…我猜猜看，你是专程赶来喝东西的？"
        },
        {
          "role": "申鹤",
          "text": "嗯。"
        },
        {
          "role": "申鹤",
          "text": "因为是…朋友。"
        },
        {
          "role": "旅行者",
          "text": "想喝点什么？"
        },
        {
          "role": "派蒙",
          "text": "来，这里有菜单！"
        },
        {
          "role": "申鹤",
          "text": "北风之望…北风，是凉嗖嗖的吗？"
        },
        {
          "role": "派蒙",
          "text": "唔，这个名字里的北风应该是指北风狼吧？冷…的确挺冷的…"
        },
        {
          "role": "申鹤",
          "text": "焦糖松果…为什么能拿来喝？"
        },
        {
          "role": "派蒙",
          "text": "啊，这个我尝过。是焦糖味的咖啡，松果…松果说的应该是颜色！"
        },
        {
          "role": "申鹤",
          "text": "……"
        },
        {
          "role": "申鹤",
          "text": "看名字，完全无法理解。"
        },
        {
          "role": "申鹤",
          "text": "交给你们吧。类似清心、琉璃袋…那种味道的就好。"
        },
        {
          "role": "派蒙",
          "text": "这里的土壤不长这些药材啦，想喝苦的东西，就只有咖啡…"
        },
        {
          "role": "旅行者",
          "text": "要不要试试甜味的？"
        },
        {
          "role": "申鹤",
          "text": "…好。"
        },
        {
          "role": "派蒙",
          "text": "也对，修行久了是该换换口味！"
        },
        {
          "role": "派蒙",
          "text": "我们给申鹤来一杯覆雪之吻吧！看名字就跟她很搭。"
        },
        {
          "type": "subtitle",
          "text": "为申鹤调制指定饮品"
        },
        {
          "role": "申鹤",
          "text": "很甜，口感顺滑，不苦涩。这是什么？"
        },
        {
          "role": "派蒙",
          "text": "它叫「覆雪之吻」！把牛奶打成细密的奶泡轻轻倒在果汁上，看起来就像是覆盖着积雪一样哦。"
        },
        {
          "role": "派蒙",
          "text": "至于为什么要叫吻什么的…我也不懂…可能是商家的花招吧，为了让它更好卖！"
        },
        {
          "role": "申鹤",
          "text": "更好卖？"
        },
        {
          "role": "派蒙",
          "text": "欸？不是吗？我、我乱说的…那、那它是一种…浪漫的形容！"
        },
        {
          "role": "申鹤",
          "text": "浪漫…？"
        },
        {
          "role": "派蒙",
          "text": "呜…好难解释啊！不要逼我编故事。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "奶泡没有太多味道…",
              "dialogues": []
            },
            {
              "text": "就像山顶的积雪…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是这样没错…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "喝到果汁的那一刻很甜…",
              "dialogues": []
            },
            {
              "text": "如同嫩芽破冰，亲吻了你…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "申鹤",
          "text": "…啊。"
        },
        {
          "role": "申鹤",
          "text": "这样啊…我似乎明白了。"
        },
        {
          "role": "派蒙",
          "text": "欸？欸——"
        },
        {
          "role": "派蒙",
          "text": "等一下，为什么啊！现在换我不明白了！"
        },
        {
          "role": "申鹤",
          "text": "我在山间走动时，偶尔会嚼食仙草，也曾亲眼目睹幼芽破土的刹那。"
        },
        {
          "role": "申鹤",
          "text": "心中那份悸动…的确，与此刻很是相似。"
        },
        {
          "role": "申鹤",
          "text": "旅行者，谢谢你能让我明白这些…难懂的名字。"
        },
        {
          "role": "申鹤",
          "text": "往后，或许也要麻烦你了。"
        }
      ]
    }
  ]
}