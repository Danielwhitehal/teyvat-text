{
  "quest_id": 70528,
  "chapter_num": null,
  "chapter_title": "万风逐花",
  "type": "wq",
  "route": "Floral Pursuit",
  "stories": [
    {
      "story_id": 70528,
      "title": "万风逐花",
      "description": "冒险家协会的卜劳恩似乎正在为某事而忙碌着…",
      "dialogues": [
        {
          "role": "卜劳恩",
          "text": "协会到底忙不忙得过来，唉…"
        },
        {
          "role": "卜劳恩",
          "text": "旅行者！不好意思，我刚才在想一些协会里的事务，走了一会神…"
        },
        {
          "role": "卜劳恩",
          "text": "你来蒙德城，应该是来参加风花节的吧。"
        },
        {
          "role": "卜劳恩",
          "text": "我们冒险家协会正好推出了一个小游戏，保证轻松有趣，参与就有奖励！"
        },
        {
          "role": "卜劳恩",
          "text": "怎么样，你要不要来试试看啊？"
        },
        {
          "role": "卜劳恩",
          "text": "我先为你介绍一下这个小游戏。协会里设计这个游戏的人，把它取名叫做「逐花棋」。"
        },
        {
          "role": "卜劳恩",
          "text": "他说自己的灵感是来自于飘飞的花瓣，还有追逐着花瓣的风…"
        },
        {
          "role": "卜劳恩",
          "text": "整个游戏的感觉，也是想要模拟那种追逐花瓣的…浪漫感…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "挺，挺有故事性…",
            "这，这么复杂吗…"
          ]
        },
        {
          "role": "旅行者",
          "text": "挺，挺有故事性…"
        },
        {
          "role": "卜劳恩",
          "text": "这老兄是个吟游诗人…比较富有那个…想象力…"
        },
        {
          "role": "卜劳恩",
          "text": "简单来说，玩这种棋的时候，玩家需要去尽可能多地搜集棋盘内分布的「风花球」。"
        },
        {
          "role": "卜劳恩",
          "text": "在搜集的同时，还要规避各种阻碍…当然啦，棋盘里还有各种辅助性的道具…"
        },
        {
          "role": "卜劳恩",
          "text": "那位老兄可是专门写了一整本详细的游玩手册，等会你可以看看。"
        },
        {
          "role": "卜劳恩",
          "text": "如果有兴趣的话，欢迎你来试玩啊，参与就有奖励！"
        }
      ]
    }
  ]
}