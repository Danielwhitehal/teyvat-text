{
  "quest_id": 41146,
  "chapter_num": null,
  "chapter_title": "猎鹿急送",
  "type": "eq",
  "route": "Good Hunter Express",
  "stories": [
    {
      "story_id": 41146,
      "title": "猎鹿急送",
      "description": "蒙德城的猎鹿人餐馆里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "",
          "text": "欸？但…好吧，我去找其他人帮忙…"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "",
          "text": "那就拜托你啦，那地方太远了，我们实在是分不出人手来了。"
        },
        {
          "role": "",
          "text": "对了，送的时候千万小心，不要跑得太快，也不要用风之翼，更不要去爬山什么的…"
        },
        {
          "role": "",
          "text": "要是路上被撞了一下，肉酱和面说不定就会完全分开了…那样的话，客人肯定不会收下这份餐的。"
        },
        {
          "role": "",
          "text": "好不容易找到了这么个舒服的地方…我订的餐怎么还没送来…"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "",
          "text": "对，那个…安杰洛先生在我们这订了一份火火肉酱面，钱已经付好了。"
        },
        {
          "role": "",
          "text": "然后他让我们晚些时候送去明冠峡附近的一个地方，那个地方还挺远的，我正愁没人有空能送过去…"
        },
        {
          "role": "",
          "text": "如果你愿意帮忙的话，就把这份餐给送过去吧。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "",
          "text": "总算送到了，再等一会我就要睡着了。"
        },
        {
          "role": "",
          "text": "谢谢你啊，这道菜我就收下了。"
        }
      ]
    }
  ]
}