{
  "quest_id": 2052,
  "chapter_num": "尤潘基的回火 第一幕",
  "chapter_title": "维茨特兰的神秘访客",
  "type": "lq",
  "route": "A Mysterious Visitor From Huitztlan",
  "stories": [
    {
      "story_id": 15000,
      "title": "维茨特兰的神秘访客",
      "description": "在悬木人部族外的山崖下偶遇了两位小朋友，他们看起来需要帮助…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往悬木人部族外的山崖下"
        },
        {
          "role": "胡妮",
          "text": "哥哥姐姐/两位姐姐好！我是胡妮，你们是来找龙宝宝的吧？"
        },
        {
          "role": "多巴",
          "text": "我是多巴，如果我没猜错的话，帮手就是你们！"
        },
        {
          "role": "派蒙",
          "text": "咦？小朋友，见到你们很高兴，但我们只是路过…"
        },
        {
          "role": "胡妮",
          "text": "可山下叔叔说，他派了朋友过来帮忙…不是你们吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们是有些朋友，但都不叫山下。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "…虽然不知道具体情况，但你们好像搞错了。"
        },
        {
          "role": "胡妮",
          "text": "搞错了？"
        },
        {
          "role": "多巴",
          "text": "完蛋，胡妮，我们一定是被骗了，那个眼镜仔果然是个骗子…"
        },
        {
          "role": "胡妮",
          "text": "那龙宝宝该怎么办…时间要不够了…"
        },
        {
          "role": "派蒙",
          "text": "小朋友，你先别急，你说的龙宝宝怎么了？"
        },
        {
          "role": "胡妮",
          "text": "最近族里不太平，我爸爸的龙伙伴出事了，它叫南娜，有三个宝宝。"
        },
        {
          "role": "胡妮",
          "text": "南娜出事后，宝宝们很害怕，就躲了起来，我很担心，就想来找找它们。"
        },
        {
          "role": "派蒙",
          "text": "你爸爸的龙伙伴啊…那他自己不管吗？"
        },
        {
          "role": "胡妮",
          "text": "爸爸是族里的长老，正忙着筹备回火夜，那个很重要，至少比这件事重要。我也是瞒着他偷跑出来的…"
        },
        {
          "role": "胡妮",
          "text": "本来以为不会花很久，可刚才那个叔叔缠着我们给他讲了很多故事，浪费了好多时间。"
        },
        {
          "role": "多巴",
          "text": "真可恶，眼镜仔的心里没有一点爱！"
        },
        {
          "role": "派蒙",
          "text": "别生气啦，要不我们来帮忙找吧！听起来也不麻烦，我们心里可是很有爱的，对吧？旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当然。龙宝宝在附近吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡妮",
          "text": "应该是的，我已经发现了一些痕迹，它们应该就躲在附近的山崖上…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我和派蒙吧，不会很久。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡妮",
          "text": "真的吗？那…那谢谢旅行者哥哥，谢谢派蒙姐姐！"
        },
        {
          "role": "多巴",
          "text": "哇！哥哥姐姐/两位姐姐要注意安全哦，山崖很陡，族里的大人也没那么容易爬上去。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（胡妮）"
        },
        {
          "role": "胡妮",
          "text": "要注意安全呀！我们就在这里等着。"
        },
        {
          "type": "subtitle",
          "text": "寻找走失的龙宝宝"
        },
        {
          "role": "派蒙",
          "text": "龙宝宝们就在崖壁上吧，我们找个办法上去吧。"
        },
        {
          "type": "subtitle",
          "text": "附魂龙对话"
        },
        {
          "role": "波尼尼",
          "text": "好高！害怕！"
        },
        {
          "type": "subtitle",
          "text": "未附魂龙对话"
        },
        {
          "role": "波尼尼",
          "text": "哇哇！哇哇！"
        },
        {
          "type": "subtitle",
          "text": "附魂龙对话"
        },
        {
          "role": "波吉吉",
          "text": "山王…"
        },
        {
          "type": "subtitle",
          "text": "未附魂龙对话"
        },
        {
          "role": "波吉吉",
          "text": "咕咕…"
        },
        {
          "role": "波奇奇",
          "text": "嗷呜…"
        },
        {
          "role": "派蒙",
          "text": "龙宝宝在这里！咦？旁边有一个…阿乔？"
        },
        {
          "role": "阿乔",
          "text": "这不是吾那仆从的两位劣友吗？是在山下窥见了吾的英姿，特地爬上来供奉的吧？看来日前一见，吾的伟岸已深嵌汝等心灵了。"
        },
        {
          "role": "阿乔",
          "text": "真是拿下人没办法，来吧，亲吻吾的脚背，伟大圣龙库胡勒阿乔允许汝等献上朝拜。"
        },
        {
          "role": "派蒙",
          "text": "你…你不是基尼奇的那个小跟班吗？在自说自话什么？居然比上次更讨厌了。"
        },
        {
          "role": "阿乔",
          "text": "胡言乱语！什么小跟班？吾乃无上之龙！烈焰之国的至高领主！"
        },
        {
          "role": "阿乔",
          "text": "上次要不是基尼奇三拜九叩，吾才不会恩施汝等丝毫言语的仁慈！"
        },
        {
          "role": "派蒙",
          "text": "什么嘛，明明就是被基尼奇关起来了吧，你还挺会装模做样的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "领主大人，你在这山上干嘛？",
              "dialogues": [
                {
                  "role": "阿乔",
                  "text": "哼哼，这还差不多。"
                }
              ]
            },
            {
              "text": "小跟班，，你在这山上干嘛？",
              "dialogues": [
                {
                  "role": "阿乔",
                  "text": "是领主大人！你想气死伟大圣龙库胡勒阿乔吗？你的罪行将遭回火焚烧千年！"
                }
              ]
            }
          ]
        },
        {
          "role": "阿乔",
          "text": "近日吾应许了吾那仆从的祈求，为其调查维茨特兰附近的深渊事件。"
        },
        {
          "role": "派蒙",
          "text": "深渊事件？！"
        },
        {
          "role": "阿乔",
          "text": "看见这小爬虫了吗？它的母亲——一只中爬虫，被深渊力量侵蚀，错乱地攻击了吾那仆从的族人，甚至还攻击了自己的后裔。"
        },
        {
          "role": "派蒙",
          "text": "天哪…那它现在怎么样了？"
        },
        {
          "role": "阿乔",
          "text": "低等的爬虫如何能与深渊久斗？自然是去了夜神之国。"
        },
        {
          "role": "阿乔",
          "text": "弱小的生灵啊…听说是自我了断，从高崖上一跃而下。"
        },
        {
          "role": "派蒙",
          "text": "跳崖…？！"
        },
        {
          "role": "阿乔",
          "text": "白色小飞蚁，别再露出还有一百个问题的愚蠢表情，伟大的圣龙库胡勒阿乔可不是谁人的许愿灵泉啊。"
        },
        {
          "role": "派蒙",
          "text": "谁是白色小飞蚁？！你…我一定要给你想个难听的绰号！"
        },
        {
          "role": "阿乔",
          "text": "哼，吾探查到附近有微弱的深渊气息，必有擅于隐藏的邪恶术士存在。要是遇见了可疑的外地人，汝等需细细盘问。"
        },
        {
          "role": "派蒙",
          "text": "可疑的外地人…你不是在指深渊骂我们吧？"
        },
        {
          "role": "阿乔",
          "text": "呸！下人之心度领主之腹！汝等若非吾那仆从的劣友，吾早就打打打打打打！"
        },
        {
          "role": "阿乔",
          "text": "既然不是来朝拜，就速速退去！伟大的圣龙库胡勒阿乔要去办正事了。"
        },
        {
          "role": "派蒙",
          "text": "什么啊！这家伙说话真是让人生气！不过没想到，附近居然也有深渊的威胁…"
        },
        {
          "role": "派蒙",
          "text": "…算了，我们还是先把胡妮的事解决吧。"
        },
        {
          "type": "subtitle",
          "text": "回去找胡妮与多巴"
        },
        {
          "role": "多巴",
          "text": "哇！哥哥姐姐/两位姐姐好厉害！这么快就回来了！"
        },
        {
          "role": "胡妮",
          "text": "龙宝宝没事真是太好了，这下我们可以放心地回家啦。谢谢哥哥姐姐/两位姐姐！"
        },
        {
          "role": "派蒙",
          "text": "不用客气啦，我们根本没费什么工夫。"
        },
        {
          "role": "胡妮",
          "text": "你们爬了好高的山呢，肯定很辛苦，看哥哥姐姐/两位姐姐的打扮，应该也不是本地人吧？来我家歇歇脚吧！"
        },
        {
          "role": "多巴",
          "text": "没错，给个机会吧，让我们展现一下悬木人的热情好客！你们这么好心，跟之前那个眼镜仔完全不一样。"
        },
        {
          "role": "派蒙",
          "text": "听你们说的，那家伙也是外地人吗？"
        },
        {
          "role": "胡妮",
          "text": "他的衣服不是纳塔款式…现在想想，真是可疑！"
        },
        {
          "role": "派蒙",
          "text": "可疑的外地人？该不会是阿乔说的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能详细说说那个人的情况吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡妮",
          "text": "哥哥姐姐/两位姐姐对那个叔叔感兴趣吗？那我想想，事情是这样的…"
        },
        {
          "role": "胡妮",
          "text": "这位叔叔，我已经讲了好几个故事了…什么时候才能帮我去找龙宝宝啊？"
        },
        {
          "role": "？？？",
          "text": "再讲一个吧，再讲讲那团火的故事吧？"
        },
        {
          "role": "？？？",
          "text": "叔叔听说，有一团巨大的透明的火，燃烧在过去五百年、一千年甚至更多不计其数的时间里。"
        },
        {
          "role": "多巴",
          "text": "那个叫回火！古名「马力卜（回火）」就是从这个传说里诞生的！"
        },
        {
          "role": "？？？",
          "text": "哇哦，是古名的起源吗？这么厉害？"
        },
        {
          "role": "胡妮",
          "text": "嗯呢，所有的古名都有起源传说。在传说里，回火出现在纳塔大联盟的年代，被暴君奥奇坎拿来统治纳塔，镇压反对他的人。"
        },
        {
          "role": "胡妮",
          "text": "回火和普通火焰最不同的就是，被它点燃的人虽然会觉得背后灼痛难忍，但不会马上死掉，这时候千万不能回头检查！"
        },
        {
          "role": "？？？",
          "text": "不可以回头？"
        },
        {
          "role": "多巴",
          "text": "一回头就完蛋了，立刻就会被烧成灰！"
        },
        {
          "role": "？？？",
          "text": "哇哦，烧衣服烧行头就算了，烧人可真是残暴。"
        },
        {
          "role": "胡妮",
          "text": "是吧，怎么可以烧人家后背还不许人家回头看呢？奥奇坎真是个暴君。"
        },
        {
          "role": "？？？",
          "text": "按照传说的惯例，接着该有人挺身而出了吧？"
        },
        {
          "role": "多巴",
          "text": "眼镜大叔，你还挺懂行的嘛。确实是这样，那个人就是我们悬木人的祖先，尤潘基大人。"
        },
        {
          "role": "胡妮",
          "text": "嗯，尤潘基大人和暴君奥奇坎还有最初的火神希巴拉克大人都是朋友，他是当时大联盟的军械官。"
        },
        {
          "role": "胡妮",
          "text": "他不认同奥奇坎的残酷统治，就为人们偷出了回火，并把它抛向了暴君的军队。没有人能抵挡，士兵们全被烧成了灰。"
        },
        {
          "role": "胡妮",
          "text": "就这样，祖先解放了人们，但就在逃出城的时候，他好像听到奥奇坎的呼唤从背后传来，于是鬼使神差地回了头。"
        },
        {
          "role": "多巴",
          "text": "但他却只看到了焦黑的城市、枯萎的士兵、冲天的火焰…"
        },
        {
          "role": "胡妮",
          "text": "再下一刻，映在眼底的火舌突然从他瞳孔中钻出来，把祖先吞没了。"
        },
        {
          "role": "多巴",
          "text": "只回头看了一眼哦！就也被烧成了灰。"
        },
        {
          "role": "？？？",
          "text": "这是窃火…还是回头的代价呢？"
        },
        {
          "role": "多巴",
          "text": "不知道，但尤潘基大人身上的火比别处的都要凶，烧了整整一百天，最后连地脉都被烧开了个大洞！"
        },
        {
          "role": "多巴",
          "text": "然后火光「噼咻」一下就掉进了黑黢黢的夜神之国，一直烧到现在。"
        },
        {
          "role": "胡妮",
          "text": "大人都说，它照亮了往生之路，但也要亡者接受它的灼烧，这样才能纯净地迎接来世。"
        },
        {
          "role": "胡妮",
          "text": "就像是对一生的回顾与审问…所以人们就叫它尤潘基的回火。"
        },
        {
          "role": "？？？",
          "text": "噢…多么富有诗意的故事！所以在夜神之国真的可以见到这团火吗？"
        },
        {
          "role": "胡妮",
          "text": "不知道欸…这只是个传说吧？"
        },
        {
          "role": "？？？",
          "text": "所以后来你们有人继承了这个古名吧？"
        },
        {
          "role": "多巴",
          "text": "当然，比如「回火夜」祭祀的英雄布基纳，不过他是五百年前的人了。"
        },
        {
          "role": "胡妮",
          "text": "嗯，现在这个古名属于基尼奇哥哥…「马力卜（回火）」的基尼奇。"
        },
        {
          "role": "？？？",
          "text": "基尼奇…"
        },
        {
          "role": "多巴",
          "text": "好了，眼镜大叔，我们已经说了很多故事了，你该去找龙宝宝了！"
        },
        {
          "role": "？？？",
          "text": "啊…但回火的传说不是教导我们不要回头看吗？所以，不要再提前面说过的部分了。"
        },
        {
          "role": "？？？",
          "text": "请再讲一讲这个基尼奇吧，从现在开始的才算数。"
        },
        {
          "role": "？？？",
          "text": "咦？多巴，你怎么露出了那种想要骂人的眼神？不可以哦，那是大人的特权。"
        },
        {
          "role": "胡妮",
          "text": "叔叔…要是你骗我们…死了之后会被回火烧得很惨的！"
        },
        {
          "role": "？？？",
          "text": "本地火怎么会烧外地人呢？叔叔可不是你们的老乡啊。"
        },
        {
          "role": "胡妮",
          "text": "啊…？"
        },
        {
          "role": "？？？",
          "text": "等等…那是…"
        },
        {
          "role": "？？？",
          "text": "好了孩子们，叔叔不会白听故事的，叔叔派了两个朋友过来，嗯…他们会来付报酬的…"
        },
        {
          "role": "？？？",
          "text": "你们一定要狠狠使唤他们。千万别顾忌叔叔我的面子。"
        },
        {
          "role": "多巴",
          "text": "真的吗？那眼镜大叔，你叫什么？"
        },
        {
          "role": "山下",
          "text": "我们在这山崖下相遇，大叔自然叫「山下」了。"
        },
        {
          "role": "胡妮",
          "text": "真的假的…"
        },
        {
          "role": "山下",
          "text": "不信回头看看，他们已经来了。"
        },
        {
          "role": "胡妮",
          "text": "嗯？哪有啊…"
        },
        {
          "role": "胡妮",
          "text": "叔叔…你人呢？！"
        },
        {
          "role": "派蒙",
          "text": "听下来这家伙真的有点可疑呢…他好像在打听关于古名的事！"
        },
        {
          "role": "多巴",
          "text": "是吧！这个可恶的眼镜仔，他背叛了我们！他会付出代价的！"
        },
        {
          "role": "胡妮",
          "text": "但也只是听走了一些故事，应该不会怎么样吧？"
        },
        {
          "role": "派蒙",
          "text": "唔…旅行者，我们是不是该让基尼奇知道一下？虽然那个臭屁阿乔已经在调查了，但总觉得它不怎么靠谱。"
        },
        {
          "role": "胡妮",
          "text": "欸？你们也认识基尼奇哥哥吗？"
        },
        {
          "role": "派蒙",
          "text": "其实也不算很熟，我们只是见过面，还一起吃过饭。"
        },
        {
          "role": "多巴",
          "text": "好羡慕！我都没有和基尼奇哥哥说过话。他是族里的猎龙人，还有很厉害的古名，真是太酷了。"
        },
        {
          "role": "胡妮",
