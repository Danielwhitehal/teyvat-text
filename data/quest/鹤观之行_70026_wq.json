{
  "quest_id": 70026,
  "chapter_num": null,
  "chapter_title": "鹤观之行",
  "type": "wq",
  "route": "Journey to Tsurumi",
  "stories": [
    {
      "story_id": 70026,
      "title": "鹤观之行",
      "description": "冒险家协会的凯瑟琳小姐正在为一项委托犯愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与凯瑟琳对话"
        },
        {
          "role": "凯瑟琳",
          "text": "你好，旅行者，我们又见面了。"
        },
        {
          "role": "凯瑟琳",
          "text": "你最近的委托接取和完成记录都非常漂亮，说是冒险家协会的明星会员也不为过。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哪里哪里。",
              "dialogues": [
                {
          "role": "凯瑟琳",
          "text": "我们冒险家协会稻妻分会和其他分会平时就有交流，你在蒙德和璃月的事迹我们都听说了，你就不用谦虚了。"
        }
              ]
            },
            {
              "text": "有话直说。",
              "dialogues": [
                {
          "role": "凯瑟琳",
          "text": "你果然和传说中的一样，是个爽快的人呀。"
        }
              ]
            }
          ]
        },
        
        {
          "role": "凯瑟琳",
          "text": "这次请你过来，其实是想请你考虑一份比较简单的调查委托，需要调查的区域位于鹤观。"
        },
        {
          "role": "凯瑟琳",
          "text": "虽说鹤观地区的天气比较特别，经常有大雾笼罩，但只是进行调查任务的话，应该不会有太大危险。"
        },
        {
          "role": "凯瑟琳",
          "text": "协会曾经将这份委托分派给一位比较有经验的冒险家，但这位冒险家前往鹤观后，很快就回来取消了委托。"
        },
        {
          "role": "凯瑟琳",
          "text": "他也未做过多说明，只是匆忙说明自己能力有限，放弃了这个委托。"
        },
        {
          "role": "凯瑟琳",
          "text": "可是在他之后，这份委托挂了很久也没有人接，委托人也来问了很多次…"
        },
        {
          "role": "凯瑟琳",
          "text": "所以我想，如果请一位生存能力优更优秀、冒险经验也更丰富的冒险家，应该能完美解决这份委托。"
        },
        {
          "role": "凯瑟琳",
          "text": "于是我想到了你。旅行者，你觉得怎么样呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉有些可疑。",
              "dialogues": [
                {
          "role": "凯瑟琳",
          "text": "你这么想我也能够理解，那位冒险家的放弃也在我们意料之外…"
        },
        {
          "role": "凯瑟琳",
          "text": "鹤观向来人迹罕至，协会对那里的情况了解的不多。"
        }
              ]
            },
            {
              "text": "我想想…",
              "dialogues": [
                {
          "role": "凯瑟琳",
          "text": "你犹豫的理由是委托有未知的危险吗？"
        },
        {
          "role": "凯瑟琳",
          "text": "实话说，其实也有其他的冒险家以相同的原因拒绝过…"
        }
              ]
            }
          ]
        },
        
        {
          "role": "凯瑟琳",
          "text": "嗯，既然如此，我们可以变通一下，稍微降低一下要求。"
        },
        {
          "role": "凯瑟琳",
          "text": "你在调查区域遇到难以处理的危险时，可以立即返回协会要求协助，不必执着于完整地调查。"
        },
        {
          "role": "凯瑟琳",
          "text": "说起来，委托人是一位从须弥「教令院」来的学者，据说原本是想来研究鹤观的气候的，但在调研过程中遇到了一些困难。"
        },
        {
          "role": "凯瑟琳",
          "text": "所以才会在这里发布调查任务，这位学者似乎是拿出了一大半的研究经费，委托的报酬是很丰厚的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我接了。",
            "要试试也不是不行…"
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "你愿意接受委托真是太好了，我现在就来帮你把调查地点标记出来。"
        },
        {
          "role": "凯瑟琳",
          "text": "调查的时候请务必注意安全，那么，祝你一切顺利。"
        },
        {
          "role": "凯瑟琳",
          "text": "向着星辰与深渊！"
        },
        {
          "type": "subtitle",
          "text": "前往指定区域进行调查"
        },
        {
          "type": "subtitle",
          "text": "向凯瑟琳回报"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，你回来了啊，情况怎么样？"
        },
        {
          "role": "旅行者",
          "text": "关于「会复活的遗迹重机」…"
        },
        {
          "role": "凯瑟琳",
          "text": "出现在调查区域的奇怪遗迹重机，不管打倒多少次都会重新站起来…这个情况委托人完全没有提过。"
        },
        {
          "role": "凯瑟琳",
          "text": "难怪之前那位冒险家一副不想多提的样子，应该是在那个奇怪的遗迹重机那里吃了亏吧。"
        },
        {
          "role": "凯瑟琳",
          "text": "这种严重影响冒险家生命安全的事，应该早点跟我们说明才是。"
        },
        {
          "role": "凯瑟琳",
          "text": "明明在填写委托内容说明的时候还特别讲了要坦诚清晰的，胡塞尼先生怎么能这样？"
        },
        {
          "role": "凯瑟琳",
          "text": "语焉不详、内容错漏，最近越来越多委托内容说明都是这样，这样叫协会怎么给冒险家分配任务呢，真是的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你辛苦了…",
              "dialogues": [
                {
          "role": "凯瑟琳",
          "text": "我倒还好了，只是希望委托人在前期发布委托时，能够跟协会沟通清楚吧。"
        }
              ]
            },
            {
              "text": "这也是冒险的一部分吧。",
              "dialogues": [
                {
          "role": "凯瑟琳",
          "text": "代表协会和委托人们沟通毕竟是我的工作内容之一，这也是冒险的一部分…吧。"
        }
              ]
            }
          ]
        },
        
        {
          "role": "凯瑟琳",
          "text": "不好意思，没忍住就说了这些多余的话。"
        },
        {
          "role": "凯瑟琳",
          "text": "总之，我认为合理的处理办法是由你直接和委托人沟通，直接把「会复活的遗迹重机」的情况告诉他本人，降低沟通成本。"
        },
        {
          "role": "凯瑟琳",
          "text": "看看他是否能接受这样的调查结果，这样还要继续调查的话，委托人本人也应该一起想想解决办法。"
        },
        {
          "role": "凯瑟琳",
          "text": "我这里也会做好情况登记工作，如果这个委托还要继续的话，协会随时都可以为你提供援助。"
        },
        {
          "role": "旅行者",
          "text": "我明白了。"
        },
        {
          "role": "凯瑟琳",
          "text": "那就辛苦你去和委托人胡塞尼先生谈一谈了。"
        },
        {
          "type": "subtitle",
          "text": "询问胡塞尼"
        },
        {
          "role": "胡塞尼",
          "text": "鹤观的研究工作…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你好。",
            "我们又见面了。"
          ]
        },
        {
          "role": "胡塞尼",
          "text": "哦哦，我刚收到冒险家协会的情况说明时，就在猜接委托的是不是你，果然是你啊。"
        },
        {
          "role": "旅行者",
          "text": "这次的调查委托…"
        },
        {
          "role": "胡塞尼",
          "text": "唉，我知道你要说什么，凯瑟琳小姐刚刚跟我发了好大一通牢骚，我已经大致明白情况了。"
        },
        {
          "role": "胡塞尼",
          "text": "在我委托你们调查的区域，出现了「会复活的遗迹重机」对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "没错。",
            "你完全不知情吗？"
          ]
        },
        {
          "role": "胡塞尼",
          "text": "我的确是见过那台遗迹重机，但我真的不知道它能够「复活」呀。"
        },
        {
          "role": "胡塞尼",
          "text": "我来到稻妻之后，对传闻中大雾弥漫的鹤观产生了兴趣，曾经自己去调查过。"
        },
        {
          "role": "胡塞尼",
          "text": "鹤观的迷雾诚不我欺，非常有研究价值。不过，我每次深入鹤观的尝试都失败了，完全没有取得任何进展…"
        },
        {
          "role": "胡塞尼",
          "text": "正当我这么想的时候，我发现了这个不被雾气笼罩的岛屿，以及那台遗迹重机。"
        },
        {
          "role": "胡塞尼",
          "text": "不过因为准备不足，我匆匆登岛之后没能停留太久就离开了，虽然看到过那台遗迹重机，但是没能仔细观察。"
        },
        {
          "role": "胡塞尼",
          "text": "的确不是我故意隐瞒，说实话，冒险和研究一样，总是会有你意料之外的情况出现，不是吗？"
        },
        {
          "role": "胡塞尼",
          "text": "不过，我想了想，我对这次的意外情况并不是完全没有头绪。"
        },
        {
          "role": "胡塞尼",
          "text": "我的推测是：这台遗迹重机搭载有自我修复功能模块，并且有充足的外部能源供应保证它各项功能运转正常。"
        },
        {
          "role": "胡塞尼",
          "text": "它和常见的遗迹重机相比先进了不少，应该是遗迹重机中的特异型号。"
        },
        {
          "role": "胡塞尼",
          "text": "遗迹重机一类的自律机关是通过混沌炉心提供能源的，混沌炉心一旦受损，机体动力不足自然就无法运转了。"
        },
        {
          "role": "胡塞尼",
          "text": "但这台特异体不同，它的能源供应来自外部…这个外部能源我认为极有可能是地脉能量。"
        },
        {
          "role": "胡塞尼",
          "text": "我在古代文明对能源的应用方面还是有些研究的，据文献记载，曾经有能够永远行动下去的自律机关存在。"
        },
        {
          "role": "胡塞尼",
          "text": "如果这个记载可靠，这台特异体很有可能就是古代文明在能源研究方面的重要产物。"
        },
        {
          "role": "胡塞尼",
          "text": "我们得想办法让它停下来，对它进行详细的研究才行。"
        },
        {
          "role": "旅行者",
          "text": "你有办法吗？"
        },
        {
          "role": "胡塞尼",
          "text": "解决办法有…嗯，至少三种，不过其中两种效率太低。"
        },
        {
          "role": "胡塞尼",
          "text": "我想想，啊，对了，这不是正好吗！"
        },
        {
          "role": "胡塞尼",
          "text": "在来稻妻之前，我新开了几个课题，从院里申请了几件文物作为研究材料。"
        },
        {
          "role": "胡塞尼",
          "text": "这不，你来之前，我的同乡刚刚帮忙把它们送到我手上。"
        },
        {
          "role": "胡塞尼",
          "text": "这其中有几组叫做「普尔希娜光钉」的古代仪器，理论上能够释放扰乱地脉的力量，正好可以用来切断这台特异体的能源供应。"
        },
        {
          "role": "胡塞尼",
          "text": "不过不知道怎么回事，这组「普尔希娜光钉」的功能好像都有点问题，不知道是不是在运输过程中被磕碰了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那怎么办？",
            "……"
          ]
        },
        {
          "role": "胡塞尼",
          "text": "搞科研就是会遇到这种意外情况嘛…哈哈，习惯就好。"
        },
        {
          "role": "胡塞尼",
          "text": "所以我想，既然我们都需要用「普尔希娜光钉」，我们可以尝试合作，一起修好它。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉被利用了。",
              "dialogues": [
                {
          "role": "胡塞尼",
          "text": "话可不能这么说呀，我们这是恰好目的一致不是吗？"
        },
        {
          "role": "胡塞尼",
          "text": "而且，损人利己的事我是不会干的，有辱「教令院」的名声。"
        }
              ]
            },
            {
              "text": "真的会有用吗？",
              "dialogues": [
                {
          "role": "胡塞尼",
          "text": "虽然我还没有实际使用过「普尔希娜光钉」，但驱动它运行的基本原理是经过学术界验证的，理论上不会出错。"
        },
        {
          "role": "胡塞尼",
          "text": "你可以不相信我，但你要相信科技的力量。"
        }
              ]
            }
          ]
        },
        
        {
          "role": "旅行者",
          "text": "好吧，我相信你。"
        },
        {
          "role": "胡塞尼",
          "text": "太好了，那我们的合作就成立了。"
        },
        {
          "role": "胡塞尼",
          "text": "「普尔希娜光钉」的维修难点在于维修所需的元件材质特殊，很难大量生产。"
        },
        {
          "role": "胡塞尼",
          "text": "一般采取的办法都是以旧修旧，也就是说我们需要收集使用同种元件的古代遗物，利用其中的元件去修复光钉。"
        },
        {
          "role": "胡塞尼",
          "text": "好在这种元件在古代遗物中非常常见，哪里的地下埋藏有古代遗物群，哪里就能找到这种元件。"
        },
        {
          "role": "胡塞尼",
          "text": "当然，你也不用担心找不到古代遗物群，我们有现成的工具来提升效率。"
        },
        {
          "role": "胡塞尼",
          "text": "我交给你的这件工具叫做「阿叶夏混沌勘探器」，具体的运作原理比较复杂，我就不一一解释了。"
        },
        {
          "role": "胡塞尼",
          "text": "总之，「阿叶夏混沌勘探器」会在探测到古代遗物群或者地脉能量异常点时发出提示，勘测准确率…还是比较高的。"
        },
        {
          "role": "胡塞尼",
          "text": "我们的当务之急就是借它来寻找埋藏于地下深处的元件，找到了足够数量的元件我就可以开始维修校准了。"
        },
        {
          "role": "胡塞尼",
          "text": "这项收集工作可能会花费几天时间，但我们要有耐心，要有稳扎稳打的科研精神。"
        },
        {
          "role": "胡塞尼",
          "text": "好了，你理解了的话就可以尝试使用一下这件伟大的工具了。"
        }
      ]
    }
  ]
}