{
  "quest_id": 72215,
  "chapter_num": null,
  "chapter_title": "寝子是只猫·叮当的铁球",
  "type": "wq",
  "route": "Neko Is a Cat: Ding-a-Ling Metal Ball",
  "stories": [
    {
      "story_id": 72215,
      "title": "寝子是只猫·叮当的铁球",
      "description": "「浅濑神社代宫司」寝子似乎有事找你…",
      "dialogues": [
        {
          "role": "「寝子」",
          "text": "唔喵，这块石头，什么时候能变得和奴家一样呢…"
        },
        {
          "role": "旅行者",
          "text": "雕像怎么样了？"
        },
        {
          "role": "「寝子」",
          "text": "那个石头人类说，再过段时间，石头就可以完全敲好了。"
        },
        {
          "role": "「寝子」",
          "text": "等阿响回来的时候，她一定会很高兴的。"
        },
        {
          "role": "「寝子」",
          "text": "对了，可不能只是把那块石头敲好，还得再把神社周围打扮打扮才行呐。"
        },
        {
          "role": "「寝子」",
          "text": "请你们帮奴家去把这些圆圆的，会响的铁球挂在神社周围吧。"
        },
        {
          "role": "「寝子」",
          "text": "这些东西是阿响之前准备的，记得是说百目鬼看她喜欢奴家和别的孩子们，特地送给她的。奴家好不容易才找到。"
        },
        {
          "role": "旅行者",
          "text": "这是…铃铛？"
        },
        {
          "role": "「寝子」",
          "text": "「铃铛」？奴家不清楚…但阿响之前，经常和奴家一起玩这种铁球。"
        },
        {
          "role": "「寝子」",
          "text": "阿响把铁球放在地上，然后打到远处。铁球动的时候，会叮叮当当地响。"
        },
        {
          "role": "「寝子」",
          "text": "不知道这些铁球有什么力量，奴家和别的猫一听到，就忍不住想要过去。"
        },
        {
          "role": "「寝子」",
          "text": "所以，奴家想明白了。现在来神社的人这么少，一定是因为没有铁球。"
        },
        {
          "role": "「寝子」",
          "text": "所以奴家要汝帮忙，把这些铁球挂在高处。"
        },
        {
          "role": "「寝子」",
          "text": "这样的话，人类听到铁球的声音，就会来神社，也不会走错路。"
        },
        {
          "role": "「寝子」",
          "text": "那就会给「塞钱箱」塞很多钱，神社会变得很热闹。阿响回来就会很高兴。"
        },
        {
          "role": "「寝子」",
          "text": "所以，去帮奴家把这些铁球挂在神社周围吧。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "「寝子」",
          "text": "那就拜托你了，喵喵。"
        },
        {
          "type": "subtitle",
          "text": "将铃铛挂在神社周围"
        },
        {
          "role": "「寝子」",
          "text": "有了这些铁球，一定会有很多人来的。阿响一定会高兴的。"
        },
        {
          "type": "subtitle",
          "text": "将铃铛挂在神社周围"
        },
        {
          "type": "subtitle",
          "text": "将铃铛挂在神社周围"
        },
        {
          "type": "subtitle",
          "text": "向寝子回报"
        },
        {
          "role": "「寝子」",
          "text": "都挂上去了吗？"
        },
        {
          "role": "旅行者",
          "text": "都挂好了。"
        },
        {
          "role": "「寝子」",
          "text": "喵喵，太好了，这样子神社就会热闹一些了。"
        },
        {
          "role": "「寝子」",
          "text": "……"
        },
        {
          "role": "「寝子」",
          "text": "咦？怎么还没有好多好多人类来？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "应该不会这么快…",
              "dialogues": []
            },
            {
              "text": "应该没有这么简单…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "哎，人类好难懂啊。当然，汝不一样，汝很有悟性。"
        },
        {
          "role": "「寝子」",
          "text": "虽然暂时还没人…但有了铁球的叮当声，至少那些小家伙就不会迷路了，喵喵。"
        },
        {
          "role": "「寝子」",
          "text": "那个石头人类说，石头奴家很快就能好，一定要来。"
        },
        {
          "role": "「寝子」",
          "text": "啊，对了。还有件怪事。"
        },
        {
          "role": "「寝子」",
          "text": "奴家去问了那两个绿绿的人类，阿响和百目鬼的事情。"
        },
        {
          "role": "「寝子」",
          "text": "但那两个绿绿的人类，都说不认识阿响，也不记得和阿响有关的事。"
        },
        {
          "role": "「寝子」",
          "text": "但高高的绿绿的人类说，他读到过「赤穗百目鬼」的事。"
        },
        {
          "role": "「寝子」",
          "text": "不过他说什么…「贼」、什么「讨伐」来着…意思好像说，百目鬼是个坏人。"
        },
        {
          "role": "「寝子」",
          "text": "肯定是弄错了。阿响和他经常在一起玩。所以，百目鬼也是很好的人。"
        },
        {
          "role": "「寝子」",
          "text": "一定是那个人类悟性不行。归根到底，还是汝比较可靠哪。"
        },
        {
          "role": "「寝子」",
          "text": "阿响…到底什么时候才会回来呢…"
        }
      ]
    }
  ]
}