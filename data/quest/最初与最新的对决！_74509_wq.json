{
  "quest_id": 74509,
  "chapter_num": null,
  "chapter_title": "最初与最新的对决！",
  "type": "wq",
  "route": "A Clash Between the First and the Latest!",
  "stories": [
    {
      "story_id": 74509,
      "title": "最初与最新的对决！",
      "description": "熟悉的老朋友左右加回到了「小小灵蕈大幻戏」的现场，并提议你们与海妮耶来一场久违的对决…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与摊位旁的两人对话"
        },
        {
          "type": "subtitle",
          "text": "一段时间后，你与派蒙来到了「小小灵蕈大幻戏」的摊位前…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "左右加",
          "text": "呀吼！「智巧勇武双连星」，你们又来玩「小小灵蕈大幻戏」啦！"
        },
        {
          "role": "左右加",
          "text": "昂吉安妮小姐接到了任务，先回执律庭去了，之后就由我来陪你们玩！"
        },
        {
          "role": "派蒙",
          "text": "左右加，你回来了！"
        },
        {
          "role": "派蒙",
          "text": "虽然之前见到海妮耶的时候，已经大大吃惊过一次了，但你更夸张，我都觉得你这套衣服都有点精神过头了…"
        },
        {
          "role": "左右加",
          "text": "有精神是好事，我的活儿还有很多，干劲可不能早早用完。"
        },
        {
          "role": "左右加",
          "text": "要像挥舞斧子一样，把难题一个一个都劈开，嘿嘿！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "报社那边的事忙得怎么样了？",
              "dialogues": []
            },
            {
              "text": "活动的广告投放还算顺利吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "左右加",
          "text": "计划正在稳步推进，这种新奇的活动能吸引不少目光，报社也不会放过大肆宣传的机会！"
        },
        {
          "role": "左右加",
          "text": "虽然我们没有拿到最重要的版面，但显而易见，最近活动受欢迎的程度一直在上升。"
        },
        {
          "role": "海妮耶",
          "text": "的确，这段时间来摊位试玩「小小灵蕈大幻戏」的普通市民在不断增加。"
        },
        {
          "role": "海妮耶",
          "text": "不少人开始讨论，如何搭配「小小灵蕈」的队伍，才能最快赢下游戏。"
        },
        {
          "role": "海妮耶",
          "text": "我也有听说，大家都想找到「黄金流星」和「白银伴星」，和你们好好较量一番，见识一下高手的玩法。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哈哈！大师可不会随便出手！",
              "dialogues": []
            },
            {
              "text": "哎吔！为什么要急着挨打呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "除非海妮耶和左右加亲自出手，你们两位老朋友已经非常了解我们的策略了。"
        },
        {
          "role": "派蒙",
          "text": "我们之间的对局，才算是…技术含量最高的对局！"
        },
        {
          "role": "左右加",
          "text": "话都说到这份上了，我们确实也该友情切磋一下了吧？"
        },
        {
          "role": "左右加",
          "text": "仔细一想，上次我们直接较量，还是在第一次「月莲杯驯兽师大赛」的时候，我两下子就被你们打垮了。"
        },
        {
          "role": "左右加",
          "text": "有点怀念呀…从那以后，我和海妮耶经历了很多事，有了很多变化，你们肯定也一样吧…"
        },
        {
          "role": "左右加",
          "text": "但你们身上那股…清澈干练的勇气，无所畏惧的豪气，还是像水晶一样坚定、牢固！"
        },
        {
          "role": "左右加",
          "text": "单凭这一点来看，我们在筹备「灵蕈棋阵」后就决定跟着你混，真是选对老大了！"
        },
        {
          "role": "派蒙",
          "text": "左右加怎么突然开始感慨了？这难道是…作家特有的状态吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也很怀念开心的往事！",
              "dialogues": []
            },
            {
              "text": "我们还能创造新的回忆！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "左右加",
          "text": "好！真是漂亮的台词。"
        },
        {
          "role": "左右加",
          "text": "那就看好啦，作为游戏的设计者之一，我可是准备了很强力的底牌的！"
        },
        {
          "role": "海妮耶",
          "text": "要用那个吗，左右加？"
        },
        {
          "role": "左右加",
          "text": "没错，我来暖暖场，就由海妮耶指挥强劲的对手，来和你们再次打出一场精彩的对决吧！"
        },
        {
          "role": "海妮耶",
          "text": "那就请多关照了，「黄金流星」和「白银伴星」！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好哦好哦！",
              "dialogues": []
            },
            {
              "text": "开打开打！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "时隔这么久，旅行者又要和海妮耶较量一番…我也激动起来了，"
        },
        {
          "role": "派蒙",
          "text": "不过这次是友好纯粹的对局，要玩得开开心心！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（左右加）"
        },
        {
          "role": "左右加",
          "text": "「天守阁的座上宾」，「三千贼匪七日斩」、「智巧勇武双连星」、还有「金山银山大老板」…"
        },
        {
          "role": "左右加",
          "text": "不管是和你们聊天，还是玩游戏，我都很开心，感觉轻轻松松聊聊天，就能得到超多写作灵感！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就再玩两局！",
              "dialogues": [
                {
                  "role": "左右加",
                  "text": "好呀！请多指教了！"
                }
              ]
            },
            {
              "text": "那不打扰你总结灵感了…",
              "dialogues": [
                {
                  "role": "左右加",
                  "text": "哎呀！不用这么见外啦！想和我聊天，或是再玩两局游戏的话，随时可以来找我哦！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          32,
          35
        ]
      ]
    }
  ]
}