{
  "quest_id": 24001,
  "chapter_num": null,
  "chapter_title": "枫丹廷，二三事",
  "type": "iq",
  "route": "Tales From the Court",
  "stories": [
    {
      "story_id": 24001,
      "title": "枫丹廷，二三事",
      "description": "诗黛小姐似乎遇见了麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与诗黛对话"
        },
        {
          "role": "诗黛",
          "text": "请您帮帮忙吧，我刚才正在想着小说的情节，一个不留神，巴里亚就跑没影了…"
        },
        {
          "role": "布蕾莘",
          "text": "您确定巴里亚没有被您留在歌剧院的席位上，或者是拴在卫生间门口吗？"
        },
        {
          "role": "诗黛",
          "text": "这些地方我都找过了。就连座位底下我都找了个遍，可就是没见着巴里亚。"
        },
        {
          "role": "诗黛",
          "text": "我的小巴里亚，不会是被谁给拐走，或者是和谁一见钟情，懵懵懂懂地就跟着走了吧…"
        },
        {
          "role": "布蕾莘",
          "text": "诗黛小姐，我很确信巴里亚不会在这种事情上犯第二次错误。"
        },
        {
          "role": "诗黛",
          "text": "但巴里亚还那么小…年纪小就会不断地犯相同的错误，说不定巴里亚还会以此为乐啊。"
        },
        {
          "role": "布蕾莘",
          "text": "巴里亚的年纪一定没有您认知中的那么小。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "巴里亚是…",
              "dialogues": []
            },
            {
              "text": "有什么麻烦事吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布蕾莘",
          "text": "诗黛小姐的小狗…"
        },
        {
          "role": "诗黛",
          "text": "我的家人。"
        },
        {
          "role": "布蕾莘",
          "text": "她的家人，刚刚走失了，她正在寻求我的帮助。"
        },
        {
          "role": "布蕾莘",
          "text": "…诗黛小姐，这周围已经被咱们找了个遍，巴里亚大概已经跑去了野外。"
        },
        {
          "role": "诗黛",
          "text": "那咱们就去野外吧！"
        },
        {
          "role": "布蕾莘",
          "text": "我请求您待在城里，看看您的裙子，就算找到了巴里亚，您也是追不上它的。"
        },
        {
          "role": "诗黛",
          "text": "胡说，只要听见我说话，巴里亚准会马上跑过来！"
        },
        {
          "role": "布蕾莘",
          "text": "那咱们之前围着歌剧院嚷嚷了那么久，想必它是没听见了。"
        },
        {
          "role": "布蕾莘",
          "text": "让巴里亚乖乖回到诗黛小姐身边，不是我一个人能做到的事…"
        },
        {
          "role": "布蕾莘",
          "text": "考虑到我的工作职责，我不可能离开岗位太久，也不可能让另外一位同事和我一起暂时离岗。"
        },
        {
          "role": "布蕾莘",
          "text": "旅行者，如果您愿意的话，可以帮助一下我和诗黛小姐吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "倒是没问题…",
              "dialogues": []
            },
            {
              "text": "警官还管这事啊…",
              "dialogues": [
                {
                  "role": "布蕾莘",
                  "text": "枫丹廷的市民向我请求帮助，我没有拒绝的理由。"
                }
              ]
            }
          ]
        },
        {
          "role": "布蕾莘",
          "text": "那这件事就这么定了，请您和我一起去野外找找吧。"
        },
        {
          "role": "布蕾莘",
          "text": "考虑到巴里亚的体重和体力，它想必跑不太远。"
        },
        {
          "role": "诗黛",
          "text": "巴里亚可是很健康的！"
        },
        {
          "role": "布蕾莘",
          "text": "如果您是指巴里亚的精神生活的话，我十分赞同。"
        },
        {
          "role": "布蕾莘",
          "text": "那我们就出发吧，如果让巴里亚体会到了在野外的好处，它说不定就要跑得更远了。"
        },
        {
          "role": "诗黛",
          "text": "喂！"
        },
        {
          "type": "subtitle",
          "text": "跟随布蕾莘"
        },
        {
          "type": "subtitle",
          "text": "跟随布蕾莘"
        },
        {
          "role": "布蕾莘",
          "text": "果然在这里，看来它的情况还不错。"
        },
        {
          "role": "布蕾莘",
          "text": "诗黛小姐什么时候才能意识到，小狗不喜欢歌剧，也不喜欢听她的小说呢？"
        },
        {
          "role": "布蕾莘",
          "text": "我们回去吧，诗黛小姐肯定等急了。"
        },
        {
          "type": "subtitle",
          "text": "向诗黛回报"
        },
        {
          "role": "诗黛",
          "text": "巴里亚！我的宝贝，天哪，你去哪里了？"
        },
        {
          "role": "布蕾莘",
          "text": "它只是找了个清净的地方待了一会，给自己稍微放了个假。"
        },
        {
          "role": "诗黛",
          "text": "我真是担心得要命，谢谢你，布蕾莘警官，我的下一部小说一定会提到您！"
        },
        {
          "role": "布蕾莘",
          "text": "感谢您的好意，但还是请您省下这些笔墨吧，没人会对一名警官的日常生活感兴趣的。"
        },
        {
          "role": "诗黛",
          "text": "那我就将您的故事写得跌宕起伏…保证有趣！"
        },
        {
          "role": "布蕾莘",
          "text": "您这句有趣的承诺就足够让我的心情跌宕起伏了。"
        },
        {
          "role": "诗黛",
          "text": "结尾还得发人深省！让我想想，给您安排个什么队友好呢…"
        }
      ]
    }
  ]
}