{
  "quest_id": 76676,
  "chapter_num": null,
  "chapter_title": "下回再舞！",
  "type": "wq",
  "route": "We'll Dance Together Again!",
  "stories": [
    {
      "story_id": 76676,
      "title": "下回再舞！",
      "description": "经过一段时间的「舞术交流」，纳塔和须弥的朋友们都颇有收获…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和努斯妲对话"
        },
        {
          "role": "努斯妲",
          "text": "鼓掌鼓掌！活动进行到现在，可以说，已经到了完美境界！"
        },
        {
          "role": "努斯妲",
          "text": "好几位须弥朋友们学会了纳塔风格的舞蹈，我看到了我们的舞蹈走向全提瓦特的潜力！"
        },
        {
          "role": "努斯妲",
          "text": "期待之后，我们两边的「舞术交流」常态化，每隔一段时间，都稳定互访！"
        },
        {
          "role": "派蒙",
          "text": "那，纳塔的龙龙们也能像「镀金旅团」一样大耍刀舞了嘛？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有传说中的战舞…",
              "dialogues": []
            },
            {
              "text": "能吓退赤鹫的那种…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔拉内",
          "text": "啊？说的难道是…努斯妲她们最初见到弯刀叔叔时，弯刀叔叔他们用来吓退那些圣骸赤鹫的示威动作？"
        },
        {
          "role": "塔拉内",
          "text": "弯刀叔叔没和你们说明吗？那些动作的来源？"
        },
        {
          "role": "努斯妲",
          "text": "有说啊，那支舞不是叫…「炽鬃之狮与苍鹭之守的二重奏」来着吗？是个优美与力量感并重的名字！"
        },
        {
          "role": "派蒙",
          "text": "好，好熟悉两个称号！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "似乎想起了两位朋友…",
              "dialogues": []
            },
            {
              "text": "好像能猜到来龙去脉…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔拉内",
          "text": "旅行者和派蒙应该已经料到了。"
        },
        {
          "role": "塔拉内",
          "text": "你们遭遇圣骸赤鹫的那片区域，正好在「炽光猎兽」驮兽车队常走的一条路附近。"
        },
        {
          "role": "塔拉内",
          "text": "有些日子之前，车队载着迪希雅大姐和坎蒂丝大姐一起回阿如村时，就遭遇了那群赤鹫。"
        },
        {
          "role": "塔拉内",
          "text": "结果，两位大姐正觉得之前出门没好好活动筋骨，就把劲头全甩在了那群赤鹫身上。"
        },
        {
          "role": "塔拉内",
          "text": "从那以后，只要「炽光猎兽」的成员们开始模仿她们两位出招的动作，那群赤鹫就会识相地逃开。"
        },
        {
          "role": "派蒙",
          "text": "果然…"
        },
        {
          "role": "派蒙",
          "text": "该说那群圣骸赤鹫也是倒霉吗？居然被迪希雅和坎蒂丝来了个混合双打…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "它们是自讨苦吃。",
              "dialogues": []
            },
            {
              "text": "迪希雅和坎蒂丝干得漂亮！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "努斯妲",
          "text": "好家伙！上次居然错过了和这两位高手交流的机会…"
        },
        {
          "role": "努斯妲",
          "text": "等我们再去须弥的时候，请务必将我引见给她们！"
        },
        {
          "role": "努斯妲",
          "text": "我很想向她们请教拳法，尤其是高速狂猛出拳时，从脚底至大腿，从大腿到腰背，再倾注力量到手臂与拳的节拍！"
        },
        {
          "role": "塔拉内",
          "text": "啊哈，到时候，你们应该还会喝个痛快…"
        },
        {
          "role": "塔拉内",
          "text": "我得提前给你们准备好醒酒汤！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（玛拉妮&妮露）"
        },
        {
          "role": "玛拉妮",
          "text": "「快乐的时光总是短暂的…」"
        },
        {
          "role": "玛拉妮",
          "text": "哎呀，我才不会说这样的话！以后，我们要把这次这样的聚会变成常态！"
        },
        {
          "role": "妮露",
          "text": "嗯！我也会期待，有一天，玛拉妮突然出现在祖拜尔剧场，从背后捂住我双眼，让我猜猜是谁…"
        },
        {
          "role": "派蒙",
          "text": "到时候可别忘了叫上我们哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看你们一起在舞台上表演。",
              "dialogues": []
            },
            {
              "text": "带你们好好逛几圈大巴扎。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛拉妮",
          "text": "哈哈，一言为定，旅行者和派蒙！"
        },
        {
          "role": "妮露",
          "text": "玛拉妮还送了我一些「流泉之众」附近的花卉种子，我会好好栽培它们，把舞台装点得更加漂亮！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「弯刀大叔」）"
        },
        {
          "role": "「弯刀大叔」",
          "text": "接下来，我就要准备返程的护送事务了。"
        },
        {
          "role": "「弯刀大叔」",
          "text": "回头见，旅行者大哥/大姐！"
        }
      ],
      "collapse_ranges": [
