{
  "quest_id": 74500,
  "chapter_num": null,
  "chapter_title": "开火！玩具战争",
  "type": "wq",
  "route": "The Toy War: Shots Fired",
  "stories": [
    {
      "story_id": 74500,
      "title": "开火！玩具战争",
      "description": "收到了莱舒的发条工坊的特殊委托，那是枫丹廷的一家发条玩具专营店，他们遇到什么麻烦了吗？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往莱舒的发条工坊"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卡隆）"
        },
        {
          "role": "卡隆",
          "text": "两位客人你们好啊，我是小店店主卡隆，请问有什么需要吗？"
        },
        {
          "role": "派蒙",
          "text": "老板你们这里好多人哦，是在办什么活动吗？"
        },
        {
          "role": "卡隆",
          "text": "呵呵，算不上什么活动，只是小店最近新推出了一款新品玩具。就是店门口那个。两位如果有兴趣，可以随时过来体验。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿尔芒）"
        },
        {
          "role": "阿尔芒",
          "text": "两…两…两位好，我叫…阿…阿…阿尔芒…"
        },
        {
          "type": "subtitle",
          "text": "与发条工坊店员交谈"
        },
        {
          "role": "阿尔邦",
          "text": "真讨厌啊。"
        },
        {
          "role": "阿尔贝",
          "text": "就是，太讨厌了。"
        },
        {
          "role": "阿尔邦",
          "text": "这岂不是芙宁娜大人坐审判桌？"
        },
        {
          "role": "阿尔贝",
          "text": "一点都没错。"
        },
        {
          "role": "派蒙",
          "text": "芙宁娜大人坐审判桌？那是什么意思呀？"
        },
        {
          "role": "阿尔邦",
          "text": "哦！来客人了，看打扮，两位老爷是外地人吧？听不懂枫丹俗语很正常，且听小人问一句，审判桌该是给谁坐的？"
        },
        {
          "role": "阿尔贝",
          "text": "当然是审判官大人咯。"
        },
        {
          "role": "阿尔邦",
          "text": "那咱们的最高审判官是谁呢？"
        },
        {
          "role": "阿尔贝",
          "text": "当然是那维莱特大人咯。"
        },
        {
          "role": "阿尔邦",
          "text": "哎呀，那维莱特大人的位置，怎么被水神芙宁娜大人坐了去啊？两位老爷，这让堂下被审判的可怜人该作何感想啊。"
        },
        {
          "role": "阿尔贝",
          "text": "要是我绝对会感到被欺骗了啊，水神大人哪里懂审判嘛！"
        },
        {
          "role": "派蒙",
          "text": "呃…这样说，好像有种挂羊头卖狗肉的感觉…"
        },
        {
          "role": "阿尔贝",
          "text": "一点都没错！挂羊头卖狗肉，就是这个意思。"
        },
        {
          "role": "派蒙",
          "text": "原来那句话是这个意思啊。欸？！等等，你们拿自己的神明这样开玩笑没关系吗？！"
        },
        {
          "role": "阿尔邦",
          "text": "当然有关系啊，水神大人最喜欢这样的玩笑了。"
        },
        {
          "role": "阿尔邦",
          "text": "如果被她听见，一定会把小人绑上石头沉入深湖，然后兴致勃勃地在旁边观赏。"
        },
        {
          "role": "阿尔贝",
          "text": "但两位老爷，你们猜怎么着，原来阿尔邦这下人的嘴皮子太油滑，最后根本沉不下去嘛。"
        },
        {
          "role": "阿尔贝",
          "text": "「得救了！」水神大人肯定会激动地鼓起掌，兴许还会流下几滴眼泪，「真是太浪漫了！」"
        },
        {
          "role": "阿尔邦",
          "text": "搞不好还给小人颁发「枫丹浪漫市民」的勋章呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是太浪漫了！",
              "dialogues": []
            },
            {
              "text": "这就是枫丹人的浪漫吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我、我有点不知道该说什么…"
        },
        {
          "role": "阿尔邦",
          "text": "那么言归正传，两位老爷今天来小店有什么需要呢？"
        },
        {
          "role": "阿尔贝",
          "text": "话说回来，阿尔邦，你有没有觉得两位老爷的打扮…有点像是老板之前交代的著名冒险家啊？"
        },
        {
          "role": "阿尔邦",
          "text": "哦！确实有点，如同金子和银子般耀眼的头发…哦哦哦哦——所以两位老爷是…旅行者先生/女士，和派蒙女士？"
        },
        {
          "role": "派蒙",
          "text": "呜哇，你们认识我们吗？"
        },
        {
          "role": "阿尔邦",
          "text": "老板先前在冒险家协会打听了最近在枫丹活动的冒险家，协会告知了两位老爷的信息，言称是一对十分厉害的搭档。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，旅行者先生/女士，看来我们名气越来越大了呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，你是托我的福。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼，就算是这样，你也可以谦虚点嘛。"
                }
              ]
            },
            {
              "text": "派蒙女士，我是托您的福。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘿嘿嘿，你说话也越来越好听了哦，以后我的福气都分你一份。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "所以说，两位小哥，你们老板找我们有什么事吗？"
        },
        {
          "role": "阿尔邦",
          "text": "真不凑巧，老板他现在不在店里，就先由我们来讲讲吧。"
        },
        {
          "role": "阿尔贝",
          "text": "那就简单讲两句。"
        },
        {
          "role": "阿尔邦",
          "text": "一句话来说，老板的「决斗代理人企划」想请两位老爷来帮忙收集数据。"
        },
        {
          "role": "派蒙",
          "text": "「决斗代理人企划」？"
        },
        {
          "role": "阿尔邦",
          "text": "就是以决斗代理人为故事主角、为研发重心、为宣传方向的一项全新发条玩具企划。哦，小店是买卖玩具的。"
        },
        {
          "role": "阿尔邦",
          "text": "说起来，两位老爷听过「决斗代理人」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道，请继续讲。",
              "dialogues": []
            },
            {
              "text": "没听过，能解释一下吗？",
              "dialogues": [
                {
                  "role": "阿尔邦",
                  "text": "那是枫丹的一种特殊制度，假如您犯了什么事，面临审判时，您可以申请与「决斗代理人」进行「决斗」。"
                },
                {
                  "role": "阿尔邦",
                  "text": "若是战胜了「决斗代理人」，您就能摆脱罪名，维护自己的名誉，无需再被审判。当然，想战胜「决斗代理人」可不是什么轻松的事。"
                },
                {
                  "role": "阿尔贝",
                  "text": "肯定比卖玩具难。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿尔邦",
          "text": "老板认为这是一个绝佳的枫丹文化符号，如果制作一款这个题材的玩具，说不定能够大火。"
        },
        {
          "role": "阿尔贝",
          "text": "万一火到了其他国家，还能提升国民荣誉感，一举两得！芙宁娜大人直接给我们发勋章！"
        },
        {
          "role": "派蒙",
          "text": "原来是这样…可是你们要做「决斗代理人」玩具，找我们冒险家干嘛呢？"
        },
        {
          "role": "阿尔邦",
          "text": "研发嘛，总需要一些数据来支撑。「决斗代理人」的强大，是通过深入各种危险的地方锤炼武艺得来的，拿到他们的数据可不简单。"
        },
        {
          "role": "阿尔贝",
          "text": "但是听说冒险家中的厉害角色，也会干类似的事，不如就请冒险家来…"
        },
        {
          "role": "派蒙",
          "text": "啊！我好像有点听明白了…打着「决斗代理人」旗号的玩具，却让冒险家来提供数据，是这样吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "挂羊头卖狗肉！",
              "dialogues": []
            },
            {
              "text": "芙宁娜大人坐审判桌！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔邦",
          "text": "哪有到那个地步嘛，顶多就是移朵海露花，接棵悬铃木。"
        },
        {
          "role": "阿尔贝",
          "text": "偷根木房梁，换条大石柱！"
        },
        {
          "role": "派蒙",
          "text": "那不都是差不多的意思嘛，明明你们自己一开始都在讨论，我们都听见啦。"
        },
        {
          "role": "阿尔邦",
          "text": "噢——那个啊，那是在说隔壁的隔壁的那家勒波特钟表店，他们可比我们过分多了。"
        },
        {
          "role": "阿尔邦",
          "text": "明明招牌写着钟表店，却偷偷卖起了玩具，大家说说，这像话吗？"
        },
        {
          "role": "阿尔贝",
          "text": "太不像话了。"
        },
        {
          "role": "派蒙",
          "text": "钟表店卖玩具？"
        },
        {
          "role": "阿尔邦",
          "text": "对啊，您不觉得这很可恶吗？不如拿您来说好了，请问您最中意的是什么？"
        },
        {
          "role": "派蒙",
          "text": "我最中意的…？那当然、那当然是我最好的伙伴旅行者啦！"
        },
        {
          "role": "阿尔邦",
          "text": "那假如有一家店名叫「旅行者玩偶商店」，结果您跋山涉水跑去一看，发现店里卖的根本不是旅行者玩偶，只有一大堆阿尔邦玩偶。"
        },
        {
          "role": "阿尔邦",
          "text": "一想到买到好伙伴的期待落空，是不是气从心来，大哭大闹，想要一拳把老板打飞？"
        },
        {
          "role": "阿尔贝",
          "text": "太生气啦！谁要买阿尔邦玩偶啦！是我就一拳把老板打进梅洛彼得堡啦！"
        },
        {
          "role": "派蒙",
          "text": "啊呀呀，被你们这样一说，好像确实有点生气…怎么办，旅行者，我可不想你的玩偶突然就买不到了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等等，他们是在偷换概念。",
              "dialogues": []
            },
            {
              "text": "人家是多卖东西，不是少卖东西。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦！我差点被你们绕进去了！"
        },
        {
          "role": "阿尔邦",
          "text": "哎呀，只是个比喻而已，比喻难免有点失真…而且我说的那种情况也不是没有，晶螺糕里不就没有晶螺吗？"
        },
        {
          "role": "阿尔贝",
          "text": "就是，这种事肯定会越来越多，钟表店不卖钟表迟早也会发生。除非改名成勒波特玩具工坊，否则绝不原谅他们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这次又在预设立场了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你们可真是歪理大王！再聊这些肯定被越绕越远，还是说正事啦，我们要怎么帮你们收集数据呢？"
        },
        {
          "role": "阿尔邦",
          "text": "这个嘛，其实在这之前，还有一件小事想要拜托两位：能否移步隔壁的隔壁，去勒波特钟表店帮我们打探一下消息？"
        },
        {
          "role": "阿尔邦",
          "text": "虽说本业是发条钟表，但新品玩具却很热门，人气都被吸跑了。据说那玩具是他们老板在蒙德得到的灵感，真想知道是什么。"
        },
        {
          "role": "阿尔贝",
          "text": "搞不好是什么炼金术玩具呢，散发着比日落果还要甜蜜四倍的气味，让附近的人一下着迷，听说蒙德有这样的炼金术大师对吧？"
        },
        {
          "role": "派蒙",
          "text": "四倍甜日落果？那不会是…{{黑幕|砂糖}}"
        },
        {
          "role": "阿尔邦",
          "text": "所以，请两位老爷帮我们去打听一下那个玩具，老板很在乎这个。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们为什么不自己去看？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔邦",
          "text": "老爷，生意人哪有不要面子的嘛，哪能这么光明正大地过去。"
        },
        {
          "role": "阿尔贝",
          "text": "是面子啊！面子大过天！"
        },
        {
          "role": "阿尔邦",
          "text": "刚好两位老爷登门的事，我得去跟老板汇报下，所以这件事求您帮帮忙啦。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，这么说我也有点好奇，从蒙德得到灵感的枫丹玩具长什么样呢，难道真的和炼金术有关系？要不我们先去看看吧？"
        },
        {
          "role": "阿尔邦",
          "text": "真是太感谢了，我们就在这等着两位凯旋！"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "阿尔邦",
          "text": "我得去和老板说一下，他请来的两位老爷上门了。"
        },
        {
          "role": "阿尔贝",
          "text": "快点去快点回啦，我一个人看店会很无聊。"
        },
        {
          "type": "subtitle",
          "text": "前往勒波特钟表店"
        },
        {
          "role": "派蒙",
          "text": "呜哇，这边人真是很多哦，看来确实是很受欢迎呢。"
        },
        {
          "type": "subtitle",
          "text": "与店主卡隆交谈"
        },
        {
          "type": "subtitle",
          "text": "尚未与店主卡隆对话过"
        },
        {
          "role": "卡隆",
          "text": "两位客人你们好啊，我是小店店主卡隆，请问有什么需要吗？"
        },
        {
          "role": "派蒙",
          "text": "卡隆老板你好，我们听说这里有一个超级厉害的玩具，想要来了解一下啦。"
        },
        {
          "type": "subtitle",
          "text": "先前有与店主卡隆对话过"
        },
        {
          "role": "卡隆",
          "text": "这不是刚刚见过的两位客人吗？请问有什么需要吗？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，是我们哦。我们刚才听说老板你那个玩具超级厉害，想要来了解一下啦。"
        },
        {
          "role": "卡隆",
          "text": "呵呵，当然可以，不过…两位是大哥请来打探情报的吧？"
        },
        {
          "role": "派蒙",
          "text": "欸？大哥？不对不对…你怎么一下就知道我们是来打探情报的？！"
        },
        {
          "role": "卡隆",
          "text": "我刚才看到，你们从发条工坊那边过来，那家店的店主是我大哥，所以我立刻就知道怎么回事了，这完全是他会做的事。"
        },
        {
          "role": "派蒙",
          "text": "怎么…一下就露馅了，这算什么，出师未捷什么来着…"
        },
        {
          "role": "派蒙",
          "text": "哎呀，我们应该做更多准备再来的，谁知道你们是兄弟啊，原本以为是同行相争，没想到是…是…是手足相残！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，不要乱用词语。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不好意思老板…我卡脑壳了。"
        },
        {
          "role": "卡隆",
          "text": "别在意，再好的玩具，零件偶尔也会卡住，人也是一样，所以要好好保养。"
        },
        {
          "role": "卡隆",
          "text": "而且…在大哥眼里，我们大概就是那种情况吧。算了，不说这个耽误两位时间了，我来介绍一下玩具吧。"
        },
        {
          "role": "派蒙",
          "text": "欸，老板不介意吗？我们…我们可算是商业间谍哦！"
        },
        {
          "role": "卡隆",
          "text": "哈哈，商业间谍，客人真有意思，小店真正的商品是那些钟表，是祖上传下来的手艺。"
        },
        {
          "role": "卡隆",
          "text": "但玩具只是我个人的爱好，这是带来快乐的东西，让更多人知道，不就相当于把快乐传递到更远的地方吗？"
        },
        {
          "role": "派蒙",
          "text": "哇，老板的说法很温柔呢！"
        },
        {
          "role": "卡隆",
          "text": "哈哈，如果是我大哥，他一定会说这是缺乏冒险精神…言归正传，两位不如试试玩具吧，希望你们喜欢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我听说老板是在蒙德得到的灵感？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡隆",
          "text": "没错，我从小就向往蒙德，直到前段时间有机会过去旅游，果然收获不少。"
        },
        {
          "role": "卡隆",
          "text": "我把在蒙德遇见的一位冒险家的故事融入了里面。不过两位也不要有太高期待，说到底它也只是个简单的发条玩具而已。"
        },
        {
          "role": "派蒙",
          "text": "冒险家？原来不是什么炼金术玩具啊。"
        },
        {
          "role": "卡隆",
          "text": "炼金术玩具？听起来很有意思。不过这位冒险家，也是一位让人印象深刻的朋友，有机会我再好好讲讲他的故事吧。"
        },
        {
          "role": "卡隆",
          "text": "现在两位不如先试试这个玩具？说一千句不如亲手试一局。"
        },
        {
          "role": "派蒙",
          "text": "虽然很想，但是那边还等着我们回复呢，旅行者，要不我们快去快回吧！好想立刻体验到这个冒险家玩具！"
        },
        {
          "role": "卡隆",
          "text": "那也好，小店随时欢迎二位。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卡隆）"
        },
        {
          "role": "卡隆",
          "text": "嗯…阿尔芒最近的情况看起来好很多了。"
        },
        {
          "type": "subtitle",
          "text": "返回莱舒的发条工坊"
        },
        {
          "role": "阿尔邦",
          "text": "老板，两位老爷回来了。"
        },
        {
          "role": "利弗",
          "text": "不愧是冒险家协会大力推荐的人，二位办事果然迅速。我是店主利弗，欢迎欢迎。"
        },
        {
          "role": "派蒙",
          "text": "利弗老板，你好你好，原来那边的卡隆老板和你是兄弟啊，我们都不知道这个事，一下就被他认出来了。"
        },
        {
          "role": "阿尔邦",
          "text": "阿尔贝，你怎么回事？这么重要的事情都忘记和贵客交代了。"
        },
        {
          "role": "阿尔贝",
          "text": "好你个阿尔邦！不是说你来说的吗？老板你要扣就扣这家伙的工资。"
        },
        {
          "role": "派蒙",
          "text": "喂，你们俩不会也是兄弟吧？"
        },
        {
          "role": "阿尔邦＆阿尔贝",
          "text": "我没有这样的兄弟！"
        },
        {
          "role": "利弗",
          "text": "咳咳…两位的意思是…任务失败了？什么也没打探到？"
        },
        {
          "role": "派蒙",
          "text": "没有没有，卡隆老板是个很温柔的人，即使知道了也不介意，还欢迎我们随时去试玩呢。"
        },
        {
          "role": "利弗",
          "text": "呵呵，那小子…所以那真是炼金术玩具？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不是，是一个冒险家玩具。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利弗",
          "text": "哼，原来还是老掉牙的冒险家玩具。他是不是还说，把什么冒险家的故事融入了里面？"
        },
        {
          "role": "派蒙",
          "text": "对对对，老板你怎么知道？你不会已经偷偷调查过吧？"
        },
        {
          "role": "利弗",
          "text": "那小子我太了解了，他总是把一些感性的东西放进玩具里，一点都不考虑市场。冒险家故事已经不适合这个时代了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可是他们店人气很旺。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利弗",
          "text": "正常的经营波动而已，等我们的「决斗代理人」企划完成，绝对会打得他们人仰马翻。"
        },
        {
          "role": "派蒙",
          "text": "又不是真的「决斗代理人」，是我们这种「过时」的冒险家假扮的啦。"
        },
        {
          "role": "利弗",
          "text": "这就是两位不懂了，这叫包装，市场就吃这套，没人管你们到底怎么做的。"
        },
        {
          "role": "利弗",
          "text": "只要拿到数据，再把它放进一些热门的玩具原型，再宣称这是一段关于「决斗代理人」成长的故事，事情就成了。"
        },
        {
          "role": "派蒙",
          "text": "就这样吗？总觉得这种故事会有问题…"
        },
        {
          "role": "利弗",
          "text": "故事有问题不重要，有噱头就可以了。"
        },
        {
          "role": "利弗",
          "text": "如果我说，阿尔邦和阿尔贝其实就是以「双人喜剧」为题材制作的仿真玩具魔偶，您怎么想？"
        },
        {
          "role": "派蒙",
          "text": "什么？！玩具魔偶？！真的…真的有这么逼真的玩具魔偶吗？"
        },
        {
          "role": "阿尔邦",
          "text": "当然，就是这么逼真。"
        },
        {
          "role": "阿尔贝",
          "text": "「双人喜剧」的世界，骗人也能骗得这么逼真哦！"
        },
        {
          "role": "利弗",
          "text": "看到了吧？这就是包装的力量，即使是噱头，但只要这样说了，就会有人产生兴趣。"
        },
        {
          "role": "派蒙",
          "text": "呜哇！原来是骗人的，你也太狡猾了吧…跟你弟弟之间的差别真大！"
        },
        {
          "role": "利弗",
          "text": "那小子不好好经营自己的发条钟表，非要插手玩具这个行当，我这个当大哥的，当然要好好教育他。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你确实有一手啊。",
              "dialogues": []
            },
            {
              "text": "果然是无奸不商。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利弗",
          "text": "承蒙夸奖。那么，接下来就请二位贵客多多上心了，数据收集的事，由阿尔邦和阿尔贝具体负责。"
        },
        {
          "role": "派蒙",
          "text": "哼哼，你们的兄弟之争我们才管不着啦，不要少了我们的摩拉哦。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿尔邦&阿尔贝）"
        },
        {
          "role": "阿尔邦",
          "text": "你听说了吗？阿尔芒最近状态好像好多了，虽然人多的时候还会紧张，不过至少能表达意思了。"
        },
        {
          "role": "阿尔贝",
          "text": "那还不错。要是话都说不完整，想当喜剧演员肯定没戏的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "阿尔芒？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔邦",
          "text": "就是勒波特钟表店门口的那个店员。老爷您没见过他吗？"
        },
        {
          "role": "阿尔贝",
          "text": "他跟我们是同一个村庄的，也是个想当喜剧演员的好小伙子，可惜，他有严重的口吃。"
        },
        {
          "role": "阿尔邦",
          "text": "据说是小时候观看一场喜剧的时候，意外从看台摔了下来，脑袋落下了后遗症。"
        },
        {
          "role": "阿尔贝",
          "text": "那场喜剧我本来很喜欢，名字叫「审判」。但现在总觉得有点爱不起来了。"
        },
        {
          "role": "阿尔邦",
          "text": "志向成为喜剧演员的孩子在名为「审判」的喜剧中被审判了，惩罚是他再也当不了喜剧演员。"
        },
        {
          "role": "阿尔贝",
          "text": "可怜的阿尔芒，他犯了什么罪？谁是审判官？"
        },
        {
          "role": "阿尔邦",
          "text": "谁知道呢？"
        }
