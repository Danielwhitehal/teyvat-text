{
  "quest_id": 72163,
  "chapter_num": null,
  "chapter_title": "清籁旧忆",
  "type": "wq",
  "route": "Reminiscence of Seirai",
  "stories": [
    {
      "story_id": 72163,
      "title": "清籁旧忆",
      "description": "在清籁岛上，你挖掘出了一张奇怪的画片…",
      "dialogues": [
        {
          "role": "太田太郎",
          "text": "你回来了，怎么样？你记录到画片了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经记录到了。"
        },
        {
          "role": "太田太郎",
          "text": "太好了，我来看看…"
        },
        {
          "role": "太田太郎",
          "text": "呃…"
        },
        {
          "role": "太田太郎",
          "text": "哈哈哈，完全看不出来是什么地方…"
        },
        {
          "role": "太田太郎",
          "text": "不过，那三张画上的景致，还真是变了不少啊。"
        },
        {
          "role": "太田太郎",
          "text": "不知道那位藤原俊子小姐…能不能认出这些地方。"
        },
        {
          "role": "太田太郎",
          "text": "不过…哈哈，我想她应该也很难能认出来…"
        },
        {
          "role": "旅行者",
          "text": "她也是从清籁岛来的？"
        },
        {
          "role": "太田太郎",
          "text": "准确地说，是和我一样，祖上曾经在清籁岛上居住过。"
        },
        {
          "role": "太田太郎",
          "text": "哎呀，其实稻妻城里还有很多祖上曾经住在清籁岛上的人。"
        },
        {
          "role": "旅行者",
          "text": "你们为什么从清籁岛搬走？"
        },
        {
          "role": "太田太郎",
          "text": "我记不太清楚了…毕竟是好久之前的事了。"
        },
        {
          "role": "太田太郎",
          "text": "好像是因为雷暴太猛了，还是为了预防偷渡和走私什么的…"
        },
        {
          "role": "太田太郎",
          "text": "总之，在幕府的统一安排下，清籁岛上的人基本上都迁到了鸣神岛上。"
        },
        {
          "role": "太田太郎",
          "text": "哦，先不说闲话了，这些东西给你，收下吧，谢谢你帮我跑这一趟。"
        },
        {
          "role": "太田太郎",
          "text": "唉，我到底什么时候才能亲自去一趟清籁岛呢？"
        },
        {
          "role": "太田太郎",
          "text": "还是先忙完手上这一单生意吧…"
        },
        {
          "type": "subtitle",
          "text": "询问冒险家"
        },
        {
          "role": "古谷升",
          "text": "真是头疼啊…"
        },
        {
          "role": "旅行者",
          "text": "关于这张图…"
        },
        {
          "role": "古谷升",
          "text": "这张图上的地形，看起来像是清籁岛的某处呢…"
        },
        {
          "role": "旅行者",
          "text": "你是怎么看出来的？"
        },
        {
          "role": "古谷升",
          "text": "毕竟协会也发布过一些和清籁岛有关的探索委托。"
        },
        {
          "role": "古谷升",
          "text": "那些接下了委托的冒险家，回来协会报告的时候，也带回来了一些和清籁岛有关的情报。"
        },
        {
          "role": "古谷升",
          "text": "但因为人手问题，我们暂时也没办法组织大规模的探索，只能每隔一段时间派遣几位冒险家过去探索。"
        },
        {
          "role": "古谷升",
          "text": "所以，我手里关于清籁岛的情报也有限，没办法再帮你继续解读这张图了。"
        },
        {
          "role": "古谷升",
          "text": "不过，我倒是知道城里有一位和清籁岛有关的人。"
        },
        {
          "role": "古谷升",
          "text": "他叫太田太郎，据他说…他的祖先曾经居住在清籁岛，后来因为各种原因才移居到了这里。"
        },
        {
          "role": "古谷升",
          "text": "前段时间，他还来过协会，说是想雇佣几位冒险家，陪他回去清籁岛看看…"
        },
        {
          "role": "古谷升",
          "text": "你可以拿着这张图去找太田太郎先生问问，说不定他会知道些什么。"
        },
        {
          "type": "subtitle",
          "text": "询问太田太郎"
        },
        {
          "role": "太田太郎",
          "text": "唉，什么时候才能找到人陪我回去看看呢…"
        },
        {
          "role": "旅行者",
          "text": "关于这张图…"
        },
        {
          "role": "太田太郎",
          "text": "你是…冒险家协会的冒险家吗？他们终于抽出人手了？"
        },
        {
          "role": "旅行者",
          "text": "我只是个路过的旅行者啦。"
        },
        {
          "role": "太田太郎",
          "text": "好吧…你想给我看什么图？"
        },
        {
          "role": "太田太郎",
          "text": "我看看…"
        },
        {
          "role": "太田太郎",
          "text": "这、这！难道这是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你看出什么了？",
              "dialogues": []
            },
            {
              "text": "这是你家吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "太田太郎",
          "text": "这不是清籁岛吗！？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是。",
              "dialogues": []
            },
            {
              "text": "你说得很对…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "太田太郎",
          "text": "哈哈哈，真是清籁岛吗？我也是猜的啦。"
        },
        {
          "role": "太田太郎",
          "text": "虽然我祖上曾经住在清籁岛上，但那已经是很久之前的事了。"
        },
        {
          "role": "太田太郎",
          "text": "到了我这一代，对清籁岛就基本上都没什么印象了。"
        },
        {
          "role": "太田太郎",
          "text": "家里和清籁岛有关的东西…也只有三张清籁岛的景致画了。"
        },
        {
          "role": "旅行者",
          "text": "那你为什么想回去？"
        },
        {
          "role": "太田太郎",
          "text": "这个嘛…怎么说呢，那里毕竟也算是我的「故乡」。"
        },
        {
          "role": "太田太郎",
          "text": "我总有一种…无论如何都得去看看的感觉。"
        },
        {
          "role": "太田太郎",
          "text": "不过现在我的生意忙得不行，一时间抽不开身。"
        },
        {
          "role": "太田太郎",
          "text": "而且…我也找不到能护送我去清籁岛的冒险家。"
        },
        {
          "role": "太田太郎",
          "text": "所以，我就退而求其次，在冒险家协会那边挂了一个委托。"
        },
        {
          "role": "太田太郎",
          "text": "希望有冒险家可以代我去清籁岛上，找到那三张画里的地点，用「留影机」记录几张画片回来。"
        },
        {
          "role": "太田太郎",
          "text": "但是到现在也没有冒险家接下这个委托，唉…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "我可以帮你跑这一趟。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "太田太郎",
          "text": "是、是吗？！你愿意帮忙的话那就太好了！"
        },
        {
          "role": "太田太郎",
          "text": "报酬的事不用担心，我一定给你准备齐全。"
        },
        {
          "role": "太田太郎",
          "text": "那就拜托你了。算上你拿过来的那一张图，总共四张图…"
        },
        {
          "role": "太田太郎",
          "text": "请你去清籁岛上，在这四个地点，分别记录一张画片回来给我吧。"
        },
        {
          "type": "subtitle",
          "text": "前往清籁岛，拍摄画片"
        },
        {
          "type": "subtitle",
          "text": "前往清籁岛，拍摄画片"
        },
        {
          "type": "subtitle",
          "text": "前往清籁岛，拍摄画片"
        },
        {
          "role": "太田太郎",
          "text": "清籁岛…唉，真想亲自过去看看。"
        },
        {
          "role": "太田太郎",
          "text": "但是，怎么才能挤出时间呢…"
        },
        {
          "type": "subtitle",
          "text": "前往清籁岛，拍摄画片"
        },
        {
          "type": "subtitle",
          "text": "将画片带回给太田太郎"
        }
      ]
    }
  ]
}