{
  "quest_id": 73353,
  "chapter_num": null,
  "chapter_title": "梦与现实的映射",
  "type": "wq",
  "route": "Mapping Dreams and Reality",
  "stories": [
    {
      "story_id": 73353,
      "title": "梦与现实的映射",
      "description": "某位生论派学者正在为她的心理疗法实验寻找志愿者…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与陀罗诘利对话"
        },
        {
          "type": "subtitle",
          "text": "心声（陀罗诘利）"
        },
        {
          "role": "陀罗诘利",
          "text": "（拜托了，这次的临床试验一定要顺利，我都豁出去请人帮忙了，千万要得到好结果！）"
        },
        {
          "role": "陀罗诘利",
          "text": "打扰一下，请问是旅行者吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是我。",
              "dialogues": []
            },
            {
              "text": "有什么事吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "陀罗诘利",
          "text": "你好你好，幸好没有认错人。"
        },
        {
          "role": "陀罗诘利",
          "text": "自我介绍一下，我是生论派的陀裟多，名字是陀罗诘利。"
        },
        {
          "role": "陀罗诘利",
          "text": "之前虽然听说过您的事情，但我们其实并不了解您本人。"
        },
        {
          "role": "陀罗诘利",
          "text": "正好我们最近在做与梦境相关的研究，草神大人便告诉我们您在辨别梦与现实方面，比她见过的所有人都要冷静。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "过奖过奖…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "陀罗诘利",
          "text": "您太谦虚了，我们项目处理的就是梦与现实的问题，数据告诉我，入眠后能主动醒来是件很难的事。"
        },
        {
          "role": "陀罗诘利",
          "text": "我们的研究是利用梦境对人的心理影响，调节人们的各种心理障碍。"
        },
        {
          "role": "陀罗诘利",
          "text": "具体来说，我们会根据每个病人的情况，通过针对性的环境暗示与引导，塑造一个合适的梦境。"
        },
        {
          "role": "陀罗诘利",
          "text": "进入共同梦境的这部分技术还不成熟，中间依靠草神大人做了许多改进，简单来说我们的目标是在梦境中调整病人的认知，以改善心理问题。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来好复杂。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "陀罗诘利",
          "text": "啊，不好意思，说到自己项目的事就变得话多了起来，是有些复杂。"
        },
        {
          "role": "陀罗诘利",
          "text": "说白了，我们在做梦境影响心理的医学研究，比较糟的是，现在卡在了实践这一步…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们要我帮忙？",
              "dialogues": []
            },
            {
              "text": "帮忙的报酬怎么算？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "陀罗诘利",
          "text": "被您一下子猜到了，真是不好意思。"
        },
        {
          "role": "陀罗诘利",
          "text": "我们项目组的成员都没办法在梦境中保持清醒的认知，本来沮丧得不行，知道有您这样的人存在才燃起了希望。"
        },
        {
          "role": "陀罗诘利",
          "text": "还得感谢草神大人，要不是她听完我们的汇报之后建议我们找您商量，这个项目大概就得搁浅了。"
        },
        {
          "role": "陀罗诘利",
          "text": "我有信心，如果能把这套心理疗法推广开的话…教令院的年度心理疾病统计数能降不少。"
        },
        {
          "role": "陀罗诘利",
          "text": "所以您刚才的意思是愿意帮忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "陀罗诘利",
          "text": "太好了！我马上就整理安排病人的资料，您方便的时候可以来找我。"
        },
        {
          "role": "陀罗诘利",
          "text": "实验流程是这样的，您只需要放松，和病人一起进入梦境就完成了一半。"
        },
        {
          "role": "陀罗诘利",
          "text": "接下来只需要根据资料中的指示，找到梦中与病人有关的扭曲异常之处，纠正它们，再离开梦境就可以了。"
        },
        {
          "role": "陀罗诘利",
          "text": "放心，我们准备了脱离梦境的应急措施，比起实验成功，志愿者和病人的安全更重要。"
        },
        {
          "role": "陀罗诘利",
          "text": "每一位病人的情况各有不同，需要酌情应对。只要您有空，请随时来找我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "明白了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "陀罗诘利",
          "text": "感谢您的慷慨，我们稍后见！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（陀罗诘利）"
        },
        {
          "role": "陀罗诘利",
          "text": "感谢您的协助，这次的临床试验很重要。如果您准备好了话，请随时告诉我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": []
            },
            {
              "text": "还没准备好。",
              "dialogues": [
                {
                  "role": "陀罗诘利",
                  "text": "没关系，等您做好全盘准备我们再开始。"
                },
                {
                  "role": "陀罗诘利",
                  "text": "待到您和患者们从梦中醒来之后，我们会坚持长期回访，试验效果好的话应该能观察到良好的长期影响。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
