  "chapter_title": "替丘丘行道！",
  "type": "wq",
  "route": "Hilichurl Justice",
  "stories": [
    {
      "story_id": 70013,
      "title": "替丘丘行道！",
      "description": "与艾拉·马斯克一同前去为被欺负的丘丘人打抱不平，或许能够借此得到新的线索？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与另一个愿意交流的丘丘人对话"
        },
        {
          "role": "丘丘人",
          "text": "Olah! Odomu tomo?"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Mimi tomo! Mosi mita?"
        },
        {
          "role": "丘丘人",
          "text": "Tomo mosi mita! Tomo mani mimi?"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Mimi mani ye! Plata odomu?"
        },
        {
          "role": "丘丘人",
          "text": "Plata odomu! Zido mi! mi muhe yeye! Mi mita yeye!"
        },
        {
          "role": "派蒙",
          "text": "他们两个聊得很开心的样子呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不愧是马斯克小姐。",
              "dialogues": []
            },
            {
              "text": "对话进行得很顺利呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾拉·马斯克",
          "text": "它需要我们帮它打倒敌人，还帮我们指出了位置。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "接下来就交给你们啦！"
        },
        {
          "role": "丘丘人",
          "text": "Dada, Valo!"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点战斗"
        },
        {
          "type": "subtitle",
          "text": "向丘丘人回复"
        },
        {
          "role": "丘丘人",
          "text": "Dada! Dada tomo!"
        },
        {
          "role": "丘丘人",
          "text": "Yeye dada! Mosi mita!"
        },
        {
          "role": "丘丘人",
          "text": "Odomu tomo zido mi! <color=#00E1FFFF>Unta mosi dada</color>！"
        },
        {
          "role": "派蒙",
          "text": "<color=#00E1FFFF>Unta mosi dada</color>…是什么意思来着…不管怎样还是谢谢啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "Mosi mita dada!",
              "dialogues": []
            },
            {
              "text": "Tomo, valo!",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丘丘人",
          "text": "Valo, mi tomo!"
        },
        {
          "role": "派蒙",
          "text": "Valo,mi tomo!"
        }
      ]
    }
  ]
}