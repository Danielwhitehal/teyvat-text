{
  "quest_id": 25034,
  "chapter_num": null,
  "chapter_title": "龙与山",
  "type": "iq",
  "route": "Saurian Versus Mountain",
  "stories": [
    {
      "story_id": 25034,
      "title": "龙与山",
      "description": "在「回声之子」部族中，特拉忒正在为某事而发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与特拉忒对话"
        },
        {
          "role": "特拉忒",
          "text": "它不喜欢你们，走开！"
        },
        {
          "role": "不耐烦的贼匪",
          "text": "臭小子…你认识这只龙吗？它和你什么关系？"
        },
        {
          "role": "奇卡",
          "text": "呜…呜呜！"
        },
        {
          "role": "不耐烦的贼匪",
          "text": "瞧瞧，这只龙都不耐烦了。小子，滚一边去，我们不打小孩。"
        },
        {
          "role": "不耐烦的贼匪",
          "text": "哥几个，把袋子拿过来。哼哼，这只小龙肯定能卖个好价钱。"
        },
        {
          "role": "特拉忒",
          "text": "不许过来！再过来我可要动手了！"
        },
        {
          "role": "不耐烦的贼匪",
          "text": "动，动手？你？哈哈哈哈哈哈，哥几个，他要和我们动手！"
        },
        {
          "role": "不耐烦的贼匪",
          "text": "我好怕啊，小子。但既然你都放出话了，那可别怪我了。"
        },
        {
          "role": "奇卡",
          "text": "呜！呜呜！呜！"
        },
        {
          "role": "不耐烦的贼匪",
          "text": "啧，这小龙还挺凶的…小子，你就好好睡一觉…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要睡一觉的是你们。",
              "dialogues": []
            },
            {
              "text": "那你们也别怪我了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特拉忒",
          "text": "大哥哥！他们是坏蛋！想要抢走奇卡！"
        },
        {
          "role": "奇卡",
          "text": "呜呜！呜呜！"
        },
        {
          "role": "不耐烦的贼匪",
          "text": "…过路的好汉。只要你不管这件事，哥们承你的情，事成后分你一份钱。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不许伤害奇卡。",
              "dialogues": []
            },
            {
              "text": "谁要你的情？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "不耐烦的贼匪",
          "text": "那就是没得谈了。行啊，那还是道上规矩。咱们手上见真章。"
        },
        {
          "role": "不耐烦的贼匪",
          "text": "嘿嘿…兄弟们给我上！"
        },
        {
          "type": "subtitle",
          "text": "打倒所有敌人"
        },
        {
          "type": "subtitle",
          "text": "与特拉忒对话"
        },
        {
          "role": "特拉忒",
          "text": "大哥哥，谢谢你救了我们。"
        },
        {
          "role": "奇卡",
          "text": "呜，呜呜…"
        },
        {
          "role": "特拉忒",
          "text": "这里离部族太远，我都没办法通知伊莱帕姐姐。要是你没来，奇卡肯定会被抓走的。"
        },
        {
          "role": "旅行者",
          "text": "你来这里做什么？"
        },
        {
          "role": "特拉忒",
          "text": "我们还是来这里训练爬山。但训练到一半的时候，我们肚子都饿了。"
        },
        {
          "role": "特拉忒",
          "text": "所以，我就和奇卡去摘果子。没想到一边摘果子，一边走了太远…"
        },
        {
          "role": "特拉忒",
          "text": "等到我们吃饱的时候，已经走了好远。回去肯定又要被妈妈念叨了…"
        },
        {
          "role": "特拉忒",
          "text": "再次谢谢你救了我，大哥哥，这些「苦种」给你，都是我刚摘下来的！"
        },
        {
          "role": "特拉忒",
          "text": "我们快点回去吧，奇卡，走吧！"
        },
        {
          "role": "奇卡",
          "text": "呜！呜呜！呜呜！"
        }
      ]
    }
  ]
}