{
  "quest_id": 72213,
  "chapter_num": null,
  "chapter_title": "寝子是只猫·石头人类的麻烦",
  "type": "wq",
  "route": "Neko Is a Cat: Stone Human's Troubles",
  "stories": [
    {
      "story_id": 72213,
      "title": "寝子是只猫·石头人类的麻烦",
      "description": "「浅濑神社代宫司」寝子似乎有事找你…",
      "dialogues": [
        {
          "role": "「寝子」",
          "text": "「抱愁」…"
        },
        {
          "role": "旅行者",
          "text": "雕像如何了？"
        },
        {
          "role": "「寝子」",
          "text": "那个石头人类可真厉害啊，喵喵喵。"
        },
        {
          "role": "旅行者",
          "text": "已经做好了吗？"
        },
        {
          "role": "「寝子」",
          "text": "不是，只是转眼间就弄来了一块好大好大的石头。"
        },
        {
          "role": "「寝子」",
          "text": "然后念叨着，「宫前」、「抱愁」之类的东西，然后一边对着石头咚咚咚。"
        },
        {
          "role": "「寝子」",
          "text": "说起来，请汝回答奴家吧。「宫前」、「抱愁」到底是什么呢？"
        },
        {
          "role": "旅行者",
          "text": "是「工钱」、「报酬」吧。"
        },
        {
          "role": "派蒙",
          "text": "也就是为了报答他的劳动，给他的好东西。"
        },
        {
          "role": "「寝子」",
          "text": "是这样吗？人类原来讲究这个啊…那好吧，奴家就恩准他摸奴家的耳朵好了。"
        },
        {
          "role": "派蒙",
          "text": "可、可能不太够…"
        },
        {
          "role": "「寝子」",
          "text": "不够吗？那，汝给他…吃的东西好了。"
        },
        {
          "role": "旅行者",
          "text": "可能他想要的是钱…"
        },
        {
          "role": "「寝子」",
          "text": "钱？这种东西不是用来放进「塞钱箱」的吗？真奇怪，人类竟然中意这个。"
        },
        {
          "role": "旅行者",
          "text": "工钱是很重要的。"
        },
        {
          "role": "「寝子」",
          "text": "哼，汝姑且也帮奴家做了不少事，奴家相信汝便是。回头，奴家再跟他谈谈。"
        },
        {
          "role": "「寝子」",
          "text": "不过，石头人类现在没有咚咚咚了。看他拿着好短的木头棍子，不知道在做什么。"
        },
        {
          "role": "派蒙",
          "text": "木头棍子？雕塑不是要用锤子、凿子之类的东西吗？"
        },
        {
          "role": "旅行者",
          "text": "难不成工具坏了…"
        },
        {
          "role": "派蒙",
          "text": "那旅行者，我们去找大岛先生吧！说不定我们能帮上什么忙！"
        },
        {
          "type": "subtitle",
          "text": "询问大岛纯平"
        },
        {
          "role": "「寝子」",
          "text": "「抱愁」对人类来说很重要，奴家记住了。"
        },
        {
          "role": "大岛纯平",
          "text": "唉，这没锤子，没凿子，怎么干活呢…"
        },
        {
          "role": "旅行者",
          "text": "遇见什么难题了吗？"
        },
        {
          "role": "大岛纯平",
          "text": "喔，是你们啊。哎呀…真是大意了，来的时候没检查工具，结果工作的时候太入神，不小心把锤子和凿子都弄坏了…"
        },
        {
          "role": "大岛纯平",
          "text": "虽然我也想回去鸣神岛买点工具，但是…"
        },
        {
          "role": "大岛纯平",
          "text": "怎么说呢…雕刻雕像这种事情，我习惯一口气做好。"
        },
        {
          "role": "大岛纯平",
          "text": "虽然锤子和凿子坏了，但我还能稍微比划一下，想一想后面怎么雕刻。"
        },
        {
          "role": "大岛纯平",
          "text": "要是现在离开这座雕像，去鸣神岛买工具的话…回来之后，我又要从头回忆雕刻的手感了…"
        },
        {
          "role": "大岛纯平",
          "text": "而且，这块石头的质地也太硬了，用一般的工具雕刻的话，工具肯定还是会很快坏掉。"
        },
        {
          "role": "大岛纯平",
          "text": "唔…没办法了…"
        },
        {
          "role": "大岛纯平",
          "text": "旅行者，能请你们去帮我找三份铁块回来吗？"
        },
        {
          "role": "大岛纯平",
          "text": "我得想个办法，自己亲手造几份可靠的工具才行。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "喔！那就拜托你们了！"
                }
              ]
            },
            {
              "text": "你…自己开始铸造？",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "我好歹也是在踏鞴砂做工的，锻冶当然也会一些。"
                },
                {
                  "role": "大岛纯平",
                  "text": "不过，我可不能在神社开炉，不然代宫司大人准会生气…嘿嘿，毕竟它是猫嘛。"
                },
                {
                  "role": "大岛纯平",
                  "text": "总之，请你先找三份铁块给我吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "将三份铁矿石交给大岛纯平"
        },
        {
          "type": "subtitle",
          "text": "将三份铁矿石交给大岛纯平"
        },
        {
          "role": "大岛纯平",
          "text": "太好了，有这些铁块就足够了。"
        },
        {
          "role": "大岛纯平",
          "text": "等会我就去外面找个合适的位置搭炉，然后制作工具。"
        },
        {
          "role": "大岛纯平",
          "text": "请你们代我去向代宫司大人说一声吧，我先在这里收拾收拾。"
        },
        {
          "type": "subtitle",
          "text": "向寝子回报"
        },
        {
          "role": "大岛纯平",
          "text": "怎么样，你们找到三份铁块了吗？"
        },
        {
          "role": "「寝子」",
          "text": "喵喵喵，有什么事吗？奴家会准备充足的「抱愁」的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是「报酬」。",
              "dialogues": []
            },
            {
              "text": "有多少？",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "啊？多少是什么意思？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "总之，石头人…大岛先生的工具坏了。不过我们已经给他维修的材料了，应该没什么问题！"
        },
        {
          "role": "「寝子」",
          "text": "问题？有什么问题吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "……"
                }
              ]
            },
            {
              "text": "没有问题，一切正常。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "那就好。奴家很期待哪，那个奴家的石头。"
        },
        {
          "role": "「寝子」",
          "text": "阿响说，那个石头的奴家做好了以后，一定会发生什么好事。"
        },
        {
          "role": "「寝子」",
          "text": "奴家很期待哪。到底是什么好事呢…难道，阿响会回来么…"
        }
      ]
    }
  ]
}