  "quest_id": 72691,
  "chapter_num": null,
  "chapter_title": "容彩诗镜·其一",
  "type": "wq",
  "route": "Irodori Poetry: Part I",
  "stories": [
    {
      "story_id": 72691,
      "title": "容彩诗镜·其一",
      "description": "蒙德来的吟游诗人莱内正在与稻妻诗人大伴热烈地讨论诗歌创作…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与大伴对话"
        },
        {
          "role": "大伴",
          "text": "小哥，我看你在这会场上徘徊了很久，应该也是懂得欣赏文艺的风雅之人。"
        },
        {
          "role": "大伴",
          "text": "现在有件风雅之事想请你帮忙，不知道你意下如何？"
        },
        {
          "role": "旅行者",
          "text": "请讲。"
        },
        {
          "role": "大伴",
          "text": "我和这位蒙德来的吟游诗人，莱内先生，一见如故。"
        },
        {
          "role": "莱内",
          "text": "大伴先生说的很对，虽然我和他认识才几天，但他的学识涵养让我非常钦佩。"
        },
        {
          "role": "大伴",
          "text": "呵呵，莱内先生客气了。总之，我们二人决定以诗会友，趁着这段时间一起创作一些作品。"
        },
        {
          "role": "大伴",
          "text": "既然风尘仆仆来到了稻妻，那么莱内先生也很想在作品中加入一些有稻妻特色的内容。"
        },
        {
          "role": "莱内",
          "text": "对，只可惜这次来稻妻的行程太紧，没有时间到处游览采风。"
        },
        {
          "role": "旅行者",
          "text": "所以，我能做些什么？"
        },
        {
          "role": "莱内",
          "text": "朋友，我正在写一首主题是「乡愁」的诗。"
        },
        {
          "role": "莱内",
          "text": "游子看到异乡的风景，往往不自觉地回忆起故乡，所以我想在诗里加入一些异乡独有的意象。"
        },
        {
          "role": "莱内",
          "text": "不知道你能否用留影机拍摄一些画片，帮助我寻找创作灵感呢？"
        },
        {
          "role": "莱内",
          "text": "稻妻应该有许多独特的风物吧？比方说，一提到蒙德，大家就会想起「蒲公英」和「风车菊」…"
        },
        {
          "role": "派蒙",
          "text": "哦哦，我明白啦，既然这样，去拍摄一些稻妻区域特产的画片就可以了吧。"
        },
        {
          "role": "莱内",
          "text": "嗯，那就拜托你们了！我把目前这首创作到一半的诗，也抄一份留给你们做参考。"
        },
        {
          "role": "莱内",
          "text": "至于拍摄数量，我想有四张内容不同的画片就差不多了，我也会为你们提供相应的旅费报酬的。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，既然莱内先生的要求已经都清楚了，那我们就出发吧。"
        },
        {
          "role": "莱内",
          "text": "是你们啊，画片已经拍好了吗？"
        },
        {
          "role": "旅行者",
          "text": "还没有…"
        },
        {
          "role": "莱内",
          "text": "拜托了，要四张稻妻区域特产的画片就好。"
        },
        {
          "role": "大伴",
          "text": "嗯，紫色是大御所大人的代表色，这两句诗确实很有稻妻的氛围。"
        },
        {
          "role": "大伴",
          "text": "嗯，这两句隐含的意义是「风带来花的芬芳」，和下文也连接得很紧密。"
        },
        {
          "role": "大伴",
          "text": "小哥，你的眼光很好啊。"
        },
        {
          "role": "莱内",
          "text": "既然大伴先生和这位朋友都很中意这两句，诗句的正式内容就选它吧。"
        },
        {
          "role": "莱内",
          "text": "朋友，再次感谢你的帮助！"
        }
      ]
    }
  ]
}