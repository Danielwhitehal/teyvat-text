{
  "quest_id": 10115,
  "chapter_num": "决斗！召唤之巅！ 第三回合",
  "chapter_title": "牌出！旧怨弭散",
  "type": "eq",
  "route": "Cards Out! Grievances Begone",
  "stories": [
    {
      "story_id": 40109,
      "title": "牌出！旧怨弭散",
      "description": "（世纪之战！决赛桌前雷雨翻腾，古今纷争于此作结！）",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到第二天白天（8-10点）"
        },
        {
          "role": "派蒙",
          "text": "昨晚玩得好开心，大家聊得都很愉快呢！不知道稻妻那边会不会有人请客呢？"
        },
        {
          "role": "夏洛蒂",
          "text": "派蒙昨晚一直都在吃呢。"
        },
        {
          "role": "派蒙",
          "text": "我，我才没有！…嗝。"
        },
        {
          "type": "subtitle",
          "text": "前往离岛调查「怪盗」的线索"
        },
        {
          "role": "派蒙",
          "text": "哇，居然从码头开始就有这么多宣传画！"
        },
        {
          "role": "派蒙",
          "text": "唔…真是对这两位发明人的真实身份越来越感兴趣了呢。"
        },
        {
          "role": "夏洛蒂",
          "text": "嗯，因为传闻很少，大家对他俩的猜测反倒一发不可收拾。"
        },
        {
          "role": "夏洛蒂",
          "text": "有人说他俩是得到了智慧之神的启示，有人说根本没有什么发明者…"
        },
        {
          "role": "夏洛蒂",
          "text": "对了，你们看过《召唤王》这本书吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没看过…",
              "dialogues": []
            },
            {
              "text": "知道个大概…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏洛蒂",
          "text": "嗯，被「鳄之王」附身的神奇少年变为传奇牌手的故事…挺有趣的，来之前我特地读了一下。"
        },
        {
          "role": "夏洛蒂",
          "text": "甚至有人猜测《召唤王》的作者就是故事中的少年牌手，而发明了「七圣召唤」的，就是传说中的「鳄之王」和「鹮之王」…"
        },
        {
          "role": "派蒙",
          "text": "怎么越来越离谱了？"
        },
        {
          "role": "夏洛蒂",
          "text": "是啊，所以原作者很快出来否认了这件事。"
        },
        {
          "role": "夏洛蒂",
          "text": "结果人们讨论得更激烈了，就连书也卖得更快了些。"
        },
        {
          "role": "夏洛蒂",
          "text": "不可否认，「七圣召唤」风靡提瓦特，有一部分是那本轻小说《召唤王》的功劳。"
        },
        {
          "role": "夏洛蒂",
          "text": "看看这阵仗，都赶得上一场祭典了吧？书肯定又会卖出不少。"
        },
        {
          "role": "派蒙",
          "text": "哦，这一看就是那个[[八重神子|狐狸女人]]搞出来的。"
        },
        {
          "role": "夏洛蒂",
          "text": "狐狸女人？"
        },
        {
          "role": "派蒙",
          "text": "就是八重神子啦，八重堂的总编。她肯定一边吃着油豆腐，一边叫手下趁这机会加大轻小说的销量。"
        },
        {
          "role": "夏洛蒂",
          "text": "哦，这场面我熟。只要把油豆腐换成咖啡，轻小说换成报纸…"
        },
        {
          "role": "派蒙",
          "text": "看来哪儿的老板都是一个样…"
        },
        {
          "type": "subtitle",
          "text": "在离岛寻找线索"
        },
        {
          "role": "夏洛蒂",
          "text": "这每个地方的景色还真不一样。出来一趟还挺赚的。"
        },
        {
          "role": "派蒙",
          "text": "你倒也乐观，明明是受到了不公正的待遇…"
        },
        {
          "role": "派蒙",
          "text": "咦？站在那儿的是…影！"
        },
        {
          "role": "影",
          "text": "旅行者、派蒙？又见面了。"
        },
        {
          "role": "夏洛蒂",
          "text": "这位姐姐是？"
        },
        {
          "role": "派蒙",
          "text": "哦，我来介绍一下。咦…奇怪，这几天我怎么老是在做介绍人的工作…"
        },
        {
          "role": "派蒙",
          "text": "这位是夏洛蒂，枫丹来的记者。这位是影，呃…稻妻的神明。"
        },
        {
          "role": "夏洛蒂",
          "text": "欸？！是…御…御建鸣神主尊大御所大人？！您好您好，失敬失敬…"
        },
        {
          "role": "影",
          "text": "远道而来的客人，无需多礼。"
        },
        {
          "role": "夏洛蒂",
          "text": "是…啊，我是说，好的。"
        },
        {
          "role": "夏洛蒂",
          "text": "呼…你们的熟人…还真是一位比一位了不得。"
        },
        {
          "role": "影",
          "text": "我此番也是受神子之邀，体验一下市井游乐的氛围，和各位并无二致。"
        },
        {
          "role": "派蒙",
          "text": "哦，我懂我懂。会场又热闹，还有好多好吃的对吧？"
        },
        {
          "role": "夏洛蒂",
          "text": "那…那既然几位赶上了话头，我就不打扰了。还是老样子，之后再汇合吧。"
        },
        {
          "role": "派蒙",
          "text": "好，那待会儿见！"
        },
        {
          "role": "影",
          "text": "难道是我的身份吓到她了？"
        },
        {
          "role": "派蒙",
          "text": "还好吧，我们之前也是分头打听消息的。"
        },
        {
          "role": "派蒙",
          "text": "影还喜欢「七圣召唤」吗？看选手们比赛很刺激吧？"
        },
        {
          "role": "影",
          "text": "嗯…我也是此次的参赛者之一。"
        },
        {
          "role": "派蒙",
          "text": "欸？影？"
        },
        {
          "role": "影",
          "text": "为何如此惊讶？以牌为乐，古来有之。我也好奇如今的牌戏变成什么样了。"
        },
        {
          "role": "旅行者",
          "text": "比赛如何？"
        },
        {
          "role": "影",
          "text": "进到了半决赛。"
        },
        {
          "role": "派蒙",
          "text": "半决赛！好厉害…那，难道说决赛也…"
        },
        {
          "role": "影",
          "text": "很遗憾，我已止步于此。因为…"
        },
        {
          "role": "八重神子",
          "text": "因为她在半决赛上输给了我。输得可惨了，简直是完败呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好可怜…",
              "dialogues": []
            },
            {
              "text": "好意外…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "呵呵，刚才的话我都听见了。"
        },
        {
          "role": "影",
          "text": "不过是被一些小伎俩骗了而已。"
        },
        {
          "role": "八重神子",
          "text": "小伎俩怎么了？规则范围内的伎俩都是智慧的体现。我看是某些人整天蹲在天守阁里，才没有机会掌握这些吧？"
        },
        {
          "role": "派蒙",
          "text": "这俩人关系还真好呢。"
        },
        {
          "role": "影",
          "text": "哈…你说得对。我是该多出来看看。"
        },
        {
          "role": "影",
          "text": "如今稻妻和平安治，与之前相比多了不少变化。不过…有些人对「天光」的畏惧仍未改变。"
        },
        {
          "role": "影",
          "text": "有一两局比赛，我看对方突然双手颤抖，迟迟不敢下牌。现在想来，许是不敢打出制胜一招…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "影…",
              "dialogues": []
            },
            {
              "text": "多少能理解…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "哎…别人都是输了牌后捶胸顿足，你倒好，明明赢了却在这儿沮丧。"
        },
        {
          "role": "八重神子",
          "text": "叫你出来是让你开开心心享受牌戏的。算了，我也知道你就这习惯。"
        },
        {
          "role": "八重神子",
          "text": "你还是乖乖学学我怎么用「小伎俩」，赢下海祇岛那位现人神巫女吧。"
        },
        {
          "role": "派蒙",
          "text": "咦？原来决赛的对手是心海？"
        },
        {
          "role": "八重神子",
          "text": "嗯哼，一边是曾经并肩作战的海祇岛领袖，一边是兼具智慧与美貌的八重神子大人。小家伙，你会支持哪边呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "珊瑚宫心海大人。",
              "dialogues": [
                {
                  "role": "八重神子",
                  "text": "好啊，敢在我和影的面前说这话，是想看看我们谁劈下的雷更快吗？"
                }
              ]
            },
            {
              "text": "八重神子大人。",
              "dialogues": [
                {
                  "role": "八重神子",
                  "text": "嗯，这才对嘛。"
                }
              ]
            },
            {
              "text": "这个…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "影",
          "text": "神子…别为难人家。"
        },
        {
          "role": "八重神子",
          "text": "哈哈哈，我知道，就想看看小家伙的反应嘛。"
        },
        {
          "role": "八重神子",
          "text": "会场就在那边，你们可以先过去逛逛。记得代我向决赛对手问个好哟。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（影&八重神子）"
        },
        {
          "role": "影",
          "text": "神子…臣民对我的畏惧…"
        },
        {
          "role": "八重神子",
          "text": "怕你不是自然的吗？你一道雷下来我的毛也得变焦。"
        },
        {
          "role": "影",
          "text": "我不会那么做…"
        },
        {
          "role": "八重神子",
          "text": "我还不会吃人呢！但有个作家老觉得不交稿我就会变成妖狐吃掉他，你说这有道理吗？"
        },
        {
          "role": "八重神子",
          "text": "哦，不过知道这事之后，我就经常这么吓他了。现在挺好，稿子交的一次比一次快。"
        },
        {
          "role": "影",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "额外对话（秋月）"
        },
        {
          "role": "秋月",
          "text": "雷电将军大人竟然亲自来到离岛，参加「召唤王大奖赛」活动。"
        },
        {
          "role": "秋月",
          "text": "托她的福，之后在离岛的生意也会越变越好吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（瓦希德）"
        },
        {
          "role": "瓦希德",
          "text": "早知道，用「丰沃之惠」无偿赞助「召唤王大奖赛」就好了，一定能提升知名度！"
        },
        {
          "role": "瓦希德",
          "text": "好像也不对。有谁会喜欢奖品里送一份肥料啊，唉…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卡琵莉亚）"
        },
        {
          "role": "卡琵莉亚",
          "text": "那位就是稻妻的雷神？还真是难得一见。"
        },
        {
          "role": "卡琵莉亚",
          "text": "不对…这么想来，我反倒一次没见过风神大人。"
        },
        {
          "role": "卡琵莉亚",
          "text": "咳咳，不论如何，风神大人保佑，让店里的生意越来越好吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（枫）"
        },
        {
          "role": "枫",
          "text": "那真的是将军大人？"
        },
        {
          "role": "枫",
          "text": "唔…店里的塑像果然无法展现将军大人英姿。"
        },
        {
          "role": "枫",
          "text": "是不是该推出新品了呢…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（西西）"
        },
        {
          "role": "西西",
          "text": "最近大家都在打牌…我是不是也该学学？唉…但脑力劳动会让人更困吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（久利须）"
        },
        {
          "role": "久利须",
          "text": "将军大人的牌技，真是令人叹为观止。我虽败犹荣，虽败犹荣啊。"
        },
        {
          "role": "久利须",
          "text": "现在的日子已经好起来了。相信在将军大人的带领下，「万国商会」的未来也会更加明亮吧。"
        },
        {
          "type": "subtitle",
          "text": "前往离岛比赛会场，寻找珊瑚宫心海"
        },
        {
          "type": "subtitle",
          "text": "与一斗对话"
        },
        {
          "role": "荒泷一斗",
          "text": "喂！挚友！矮堇瓜！"
        },
        {
          "role": "派蒙",
          "text": "放牛的！别在这么多人面前叫我矮堇瓜！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好久不见。",
              "dialogues": []
            },
            {
              "text": "二位也参加了比赛？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈！这大赛怎么可能少了我荒泷天下打牌第一斗！"
        },
        {
          "role": "荒泷一斗",
          "text": "我们荒泷派全体出动，目标就是拿下大赛的所有奖金！"
        },
        {
          "role": "久岐忍",
          "text": "结果只有老大在预选赛就被刷了下去。"
        },
        {
          "role": "荒泷一斗",
          "text": "这、这不重要！我只是运气不好，第一轮就遇到了强手而已！"
        },
        {
          "role": "荒泷一斗",
          "text": "再怎么说，我也是和对面打得有来有回。"
        },
        {
          "role": "久岐忍",
          "text": "被对方三回合拿下可不叫有来有回。"
        },
        {
          "role": "荒泷一斗",
          "text": "喂，阿忍，在挚友面前你多少给我留点面子吧？你不也半决赛输给了那个什么宫的什么海吗？"
        },
        {
          "role": "久岐忍",
          "text": "毕竟是那位海祇岛的军师，我输得心服口服。"
        },
        {
          "role": "荒泷一斗",
          "text": "其实我早就观察过了，要想打牌打得厉害，你牌背首先得好看！我就是输在牌背太普通了！"
        },
        {
          "role": "派蒙",
          "text": "牌背的花样和牌手的技术应该没什么必然联系…"
        },
        {
          "role": "荒泷一斗",
          "text": "不不不不！这就是矮堇瓜你不懂了。"
        },
        {
          "role": "荒泷一斗",
          "text": "就像厉害的鬼兜虫背部颜色更鲜艳一样，只要牌背好看，那我抽到的手牌肯定也更厉害！"
        },
        {
          "role": "久岐忍",
          "text": "老大，这打牌和斗虫可不一样，凭的是自己的本事。"
        },
        {
          "role": "荒泷一斗",
          "text": "我和你们争也争不明白，干脆让挚友来评评理！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "阿忍说的有道理…",
              "dialogues": [
                {
                  "role": "久岐忍",
                  "text": "喏，他也这么想。"
                },
                {
                  "role": "荒泷一斗",
                  "text": "不行…还是来场实战更有说服力！"
                }
              ]
            },
            {
              "text": "一斗说的有道理…",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "就知道你懂我！"
                },
                {
                  "role": "荒泷一斗",
                  "text": "机会难得，我们来场实战，验证一下我的说法！"
                }
              ]
            },
            {
              "text": "不如来一局试试…",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "欸对哦，这个办法好！"
                }
              ]
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "这样吧，阿忍你的牌借我，你那牌背就挺好看的！"
        },
        {
          "role": "荒泷一斗",
          "text": "但旅行者的牌背肯定不一般…好看程度不一定比得上。这样吧，不如你用我的牌！"
        },
        {
          "role": "久岐忍",
          "text": "不是我说…老大你组的那套牌，放谁手里都赢不了。"
        },
        {
          "role": "荒泷一斗",
          "text": "别说这么多了。挚友，现在有空吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "接受挑战。",
              "dialogues": []
            },
            {
              "text": "还有别的事…",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "若不与一斗打牌则可以直接向九条裟罗打听珊瑚宫心海的去向",
                  "narration": true,
                  "color": "描述"
                },
                {
                  "role": "荒泷一斗",
                  "text": "是这样吗？那我们先不打了。"
                },
                {
                  "role": "荒泷一斗",
                  "text": "你什么时候有空了，来找我就行！"
                },
                {
                  "role": "派蒙",
                  "text": "我们想和心海打个招呼来着，你们看到她了吗？"
                },
                {
                  "role": "派蒙",
                  "text": "就是荒泷天下笨蛋一斗口中的「什么宫的什么海」。"
                },
                {
                  "role": "荒泷一斗",
                  "text": "好你个矮堇瓜…"
                },
                {
                  "role": "久岐忍",
                  "text": "待会儿就是她的比赛了，应该不会走远…"
                },
                {
                  "role": "久岐忍",
                  "text": "你们可以找那边的九条裟罗问问。会场秩序和人员出入都是天领奉行的人在管。"
                },
                {
                  "role": "荒泷一斗",
                  "text": "欸，挚友，别忘了我在这儿等你啊！"
                },
                {
                  "type": "subtitle",
                  "text": "再次与一斗对话"
                },
                {
                  "role": "荒泷一斗",
                  "text": "哎，挚友，咱们来一局？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那就来一局。",
                      "dialogues": []
                    },
                    {
                      "text": "再等一会儿…",
                      "dialogues": [
                        {
                          "role": "荒泷一斗",
                          "text": "没问题！我荒泷天下打牌第一斗是不会临阵脱逃的！"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与一斗进行「七圣召唤」对局"
        },
        {
          "type": "subtitle",
          "text": "若不与一斗打牌则可以直接向九条裟罗打听珊瑚宫心海的去向",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "荒泷一斗",
          "text": "好！不愧是我的挚友，够义气！哈哈哈哈…"
        },
        {
          "role": "久岐忍",
          "text": "唉，好吧。那我来当裁判。"
        },
        {
          "role": "久岐忍",
          "text": "两位放轻松，这不是什么大不了的牌局。输赢无所谓。"
        },
        {
          "role": "荒泷一斗",
          "text": "你们听到了吗，我的卡牌已经在风中呐喊了！"
        },
        {
          "role": "久岐忍",
          "text": "…是我的卡牌。"
        },
        {
          "type": "subtitle",
          "text": "华丽的牌背，究竟是否会影响牌局的胜负呢？",
          "narration": true
        },
        {
          "role": "久岐忍",
          "text": "老大的牌组…恐怕谁都痛快不起来吧。"
        },
        {
          "role": "久岐忍",
          "text": "是我牌组的实力…"
        },
        {
          "role": "荒泷一斗",
          "text": "慌…慌什么？看好了，我荒泷一斗给你来个九死一生！"
        },
        {
          "role": "久岐忍",
          "text": "是起死回生吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（对局胜利）",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "居然，这都能输？"
                },
                {
                  "role": "久岐忍",
                  "text": "居然，这都能赢？旅行者…果然厉害。"
                }
              ]
            },
            {
              "text": "（对局失败）",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "哈哈哈哈！果然我的理论是对的嘛！"
                },
                {
                  "role": "久岐忍",
                  "text": "别在意…老大这牌…你知道的。"
                }
              ]
            }
          ]
        },
        {
          "role": "久岐忍",
          "text": "说回来，二位是有什么事吗？"
        },
        {
          "role": "派蒙",
          "text": "我们想和心海打个招呼来着，你们看到她了吗？"
        },
        {
          "role": "派蒙",
          "text": "就是荒泷天下笨蛋一斗口中的「什么宫的什么海」。"
        },
        {
          "role": "荒泷一斗",
          "text": "好你个矮堇瓜…"
        },
        {
          "role": "久岐忍",
          "text": "待会儿就是她的比赛了，应该不会走远…"
        },
        {
          "role": "久岐忍",
          "text": "你们可以找那边的九条裟罗问问。会场秩序和人员出入都是天领奉行的人在管。"
        },
        {
          "role": "荒泷一斗",
          "text": "欸，挚友，要是还想打牌的话，随时来找我！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（荒泷一斗）"
        },
        {
          "role": "荒泷一斗",
          "text": "怎么了？挚友，还想再来一局吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "再来一局！",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "好！今天就打个痛快！"
                }
              ]
            },
            {
              "text": "暂时不了…",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "嗯，你忙你的，我们回头见！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "向九条裟罗打听珊瑚宫心海的去向"
        },
        {
          "type": "subtitle",
          "text": "大赛公告"
        },
        {
          "role": "大赛公告",
          "text": "稻妻赛区的决赛，将由鸣神大社宫司八重神子，对阵海祇岛现人神巫女珊瑚宫心海！"
        },
        {
          "role": "大赛公告",
          "text": "这道倨傲的惊雷，是否能在那深不可测的海底鸣响？"
        },
        {
          "role": "大赛公告",
          "text": "全新修订版精装《召唤王》正在各大会场售卖，现在购买的话还送书中同款「禁忌骰」周边一枚！"
        },
        {
          "role": "留言",
          "text": "我永远支持八重神子大人！"
        },
        {
          "role": "回复",
          "text": "别想了，最后胜利的肯定是我们海祇岛的珊瑚宫心海大人。"
        },
        {
          "role": "回复",
          "text": "痴心妄想！敢不敢来打赌？"
        },
        {
          "role": "回复",
          "text": "来就来！输了的晚上请客吃饭！"
        },
        {
          "role": "天领奉行回复",
          "text": "请各位遵守会场秩序，理性观赛。"
        },
        {
          "role": "派蒙",
          "text": "裟罗！我们在找心海，你有见到过她吗？"
        },
        {
          "role": "九条裟罗",
          "text": "之前半决赛后我见她出了会场，没再回来。"
        },
        {
          "role": "五郎",
          "text": "珊瑚宫大人的话，应该是去离岛西边的海岸了。"
        },
        {
          "role": "派蒙",
          "text": "五郎！好久不见！"
        },
        {
          "role": "五郎",
          "text": "二位好。有什么要紧事吗？"
        },
        {
          "role": "派蒙",
          "text": "没什么，就是想打个招呼。"
        },
        {
          "role": "九条裟罗",
          "text": "这么说来…决赛的对手可不好对付。"
        },
        {
          "role": "派蒙",
          "text": "裟罗会支持哪边呢？"
        },
        {
          "role": "九条裟罗",
          "text": "我本应全力支持将军大人。如今将军大人的战斗已经结束，嗯…老实说，我无所谓。"
        },
        {
          "role": "派蒙",
          "text": "我还以为你一定会支持神子呢。"
        },
        {
          "role": "九条裟罗",
          "text": "换作以前，或许吧。"
        },
        {
          "role": "九条裟罗",
          "text": "如今鸣神岛与海祇岛互结友谊，大家皆是朋友。"
        },
        {
          "role": "五郎",
          "text": "嗯，这也是珊瑚宫大人的想法。朋友间打牌，重在交流牌技，分享快乐，而非胜败争斗。她希望今后的稻妻也能如此。"
        },
        {
          "role": "九条裟罗",
          "text": "嗯，很有见地。"
        },
        {
          "role": "九条裟罗",
          "text": "她的对手善用骗术。如果看到对面满脸愁容，千万不能大意，那可能是在诱人入套。"
        },
        {
          "role": "派蒙",
          "text": "以前在战场上交手的两位大将互相关心，这感觉可真好呢。"
        },
        {
          "role": "九条裟罗",
          "text": "别误会。这是为了公平。"
        },
        {
          "role": "九条裟罗",
          "text": "自从在参赛名单上看到那位军师的名字起，我就知道她多半会进入决赛，成为将军大人的对手。"
        },
        {
          "role": "九条裟罗",
          "text": "她的每场比赛我都看了，这位军师战术多变，也擅用奇策。"
        },
        {
          "role": "九条裟罗",
          "text": "将军大人惜败后，这些情报恐怕也已落入宫司大人耳中。"
        },
        {
          "role": "派蒙",
          "text": "哇…所以才不想让心海吃情报的亏？这正直的做派，不愧是裟罗…"
        },
        {
          "role": "五郎",
          "text": "多谢九条小姐的提醒！我会转告给珊瑚宫大人。"
        },
        {
          "role": "九条裟罗",
          "text": "没什么。"
        },
        {
          "role": "九条裟罗",
          "text": "时候不早，差不多去叫那位军师回来吧。"
        },
        {
          "role": "五郎",
          "text": "嗯，先告辞了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（九条裟罗）"
        },
        {
          "role": "九条裟罗",
          "text": "希望比赛一切顺利。"
        },
        {
          "role": "九条裟罗",
          "text": "只要那边那只鬼不捣乱的话。"
        },
        {
          "type": "subtitle",
          "text": "寻找珊瑚宫心海"
        },
        {
          "role": "派蒙",
          "text": "心海！"
        },
        {
          "role": "珊瑚宫心海",
          "text": "派蒙？还有旅行者。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，很惊喜吗？我们是来给你加油的！"
        },
        {
          "role": "派蒙",
          "text": "心海在这里干嘛呀？是过来看大海的吗？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯，舒缓的浪声能让人心情平静。我来这儿，原本是想看看海祇岛。"
        },
        {
          "role": "派蒙",
          "text": "咦？这里还能望到海祇岛吗？我看看…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "怎么样？看到了吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…那边好像是神无冢，再远些是八酝岛…唔…"
        },
        {
          "role": "派蒙",
          "text": "…看不到。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "如此晴好天气，都无法从鸣神岛这边望见遥远的海祇岛。更别说之前雷暴还在的时候了。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "如今两边虽然交好，但战争的阴云仍留在一些人心中。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "熟人吵架尚且需要时间原谅对方，更何况互相望不见的人呢？"
        },
        {
          "role": "派蒙",
          "text": "心海…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "啊，抱歉，不知不觉就想到些严肃的话题。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这次参赛不只是玩牌…",
              "dialogues": []
            },
            {
              "text": "还另有其意…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯，你果然了解我。"
        },
        {
          "role": "派蒙",
          "text": "咦？什么意思？"
        },
        {
          "role": "五郎",
          "text": "胜负不是最重要的。"
        },
        {
          "role": "五郎",
          "text": "重要的是珊瑚宫大人在人们的瞩目下，到这里来玩牌的这一举动。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯，今后会有更多的人在海祇岛与鸣神岛间往来。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "我想传达的无外乎一点——"
        },
        {
          "role": "珊瑚宫心海",
          "text": "「尽管信仰的神明不同，但大家都是能在一张桌上玩牌的朋友了，今后还应互相帮助。」"
        },
        {
          "role": "珊瑚宫心海",
          "text": "这算是一种…「以牌解怨」吧。"
        },
        {
          "role": "旅行者",
          "text": "小牌局带动大牌局…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "我喜欢你的说法。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "况且，我一直都对兵法策略感兴趣。比拼计策的牌戏，怎么能少得了我呢？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，小私心呢。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "呵呵…二八成吧。"
        },
        {
          "role": "派蒙",
          "text": "你可要小心那个狐狸女人，连裟罗都提醒你她诡计多端。"
        },
        {
          "role": "五郎",
          "text": "我想不止是珊瑚宫大人有「以牌解怨」的想法。那位大将确实说了这话。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯，那真是太好了。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "派蒙放心吧。至于牌局，我早就想好了各种情况的对策。"
        },
        {
          "role": "派蒙",
          "text": "哇，感觉越来越期待了呢。"
        },
        {
          "role": "派蒙",
          "text": "不行不行，这场比赛我说什么都要看！什么事都拉不走我！小吃摊的香气也不行！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也很期待。",
              "dialogues": []
            },
            {
              "text": "决赛加油。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯，谢谢你们。我们走吧。"
        },
        {
          "type": "subtitle",
          "text": "返回离岛比赛会场，观看决赛"
        },
        {
          "type": "subtitle",
          "text": "与绮良良对话"
        },
        {
          "role": "夏洛蒂",
          "text": "「稻妻神明仗其威光杀入半决赛，没想到对手狡黠一笑」…"
        },
        {
          "role": "绮良良",
          "text": "…哇！这标题好！"
        },
        {
          "role": "夏洛蒂",
          "text": "稻妻的雷，应该劈不到枫丹吧？"
        },
        {
          "role": "绮良良",
          "text": "那位雷神不会为这种事生气的啦。"
        },
        {
          "role": "派蒙",
          "text": "欸，你俩怎么聊上了？"
        },
        {
          "role": "派蒙",
          "text": "不对…应该说我们怎么又又又遇上了绮良良？"
        },
        {
          "role": "绮良良",
          "text": "我也觉得巧得很呢！明明才刚见过面。"
        },
        {
          "role": "夏洛蒂",
          "text": "我离岛附近的人采访过一遍了，没打听出「卡牌怪盗」的情报。后来倒是遇上了这位绮良良小姐，聊着聊着发现她和你们见过。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "「卡牌怪盗」？"
        },
        {
          "role": "派蒙",
          "text": "哦，是这么回事…"
        },
        {
          "type": "subtitle",
          "text": "向心海讲述了这几天的所见所闻…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯…这事件的真相，我已经有些头绪了。"
        },
        {
          "role": "派蒙",
          "text": "欸？这么快？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "三言两语可能说不清，决赛也要开始了…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "这么说吧，这次事件的关键线索——"
        },
        {
          "role": "珊瑚宫心海",
          "text": "就在绮良良小姐身上。"
        },
        {
          "role": "绮良良",
          "text": "嗯？欸？等等…欸？我？？？"
        },
        {
          "role": "夏洛蒂",
          "text": "和绮良良小姐聊完之后，我倒也有了点推测。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "没时间展开了。抱歉，各位，剩下的就比赛结束后再聊吧。"
        },
        {
          "role": "旅行者",
          "text": "安心比赛吧。"
        },
        {
          "role": "派蒙",
          "text": "唔…怎、怎么办？我脑子绕不过来。"
        },
        {
          "role": "派蒙",
          "text": "明明是我讲的经过，但完全不知道哪里能看出真相。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我不会真的笨得像堇瓜吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没事，先看比赛吧。",
              "dialogues": []
            },
            {
              "text": "待会儿再想吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "…唔，好吧。"
        },
        {
          "role": "赛场司仪",
          "text": "各位观众朋友！欢迎来到「召唤王大奖赛」的决赛现场！"
        },
        {
          "role": "赛场司仪",
          "text": "本场比赛将由鸣神大社的宫司八重神子，对阵海祇岛现人神巫女珊瑚宫心海！"
        },
        {
          "role": "赛场司仪",
          "text": "我宣布，现在，比赛正式开始！"
        },
        {
          "role": "派蒙",
          "text": "哦！开始了开始了！"
        },
        {
          "role": "赛场司仪",
          "text": "双方掷先后手！"
        },
        {
          "role": "八重神子",
          "text": "这么晚才到，我还以为是在海底散步迷路了呢，「深海舌鲆鱼」小姐。"
        },
        {
          "role": "八重神子",
          "text": "来岸上一趟也不容易，要不要我把先手的机会让给你呀？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "这就不必了。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "听说「玲珑油豆腐」冷得快，如果不趁热端上来的话，恐怕就要变成冰凉凉油腻腻的了。"
        },
        {
          "role": "赛场司仪",
          "text": "…第一回合，开始！"
        },
        {
          "type": "subtitle",
          "text": "双方你来我往，对局分外焦灼…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "赛场司仪",
          "text": "决赛的胜者是——"
        },
        {
          "role": "赛场司仪",
          "text": "海祇岛现人神巫女珊瑚宫心海！"
        },
        {
          "role": "派蒙",
          "text": "赢了赢了！心海赢了！"
        },
        {
          "role": "绮良良",
          "text": "哇…那位狐妖大人居然…看得我尾巴上的毛都竖起来了。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "几位，久等了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "恭喜获胜。",
              "dialogues": []
            },
            {
              "text": "赢得漂亮。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珊瑚宫心海",
          "text": "谢谢你"
        },
        {
          "role": "派蒙",
          "text": "心海！我刚才真是为你捏一把汗！"
        },
        {
          "role": "派蒙",
          "text": "神子也太狡猾了，装作无计可施的样子，让心海解决掉自己的一张牌。"
        },
        {
          "role": "派蒙",
          "text": "结果她居然连用两张以此为前提才能打出的手牌！差点就翻盘了呢！"
        },
        {
          "role": "八重神子",
          "text": "哎呀，这里好热闹，都在背着我说什么有趣的事呢？"
        },
        {
          "role": "派蒙",
          "text": "呃啊！我、我不是，我没说什么！我说神子你输了真可惜！"
        },
        {
          "role": "八重神子",
          "text": "哈哈哈，这有什么好可惜的？一场小比赛而已。"
        },
        {
          "role": "八重神子",
          "text": "下一次还说不定是谁赢呢。怎么样？「深海舌鲆鱼」小姐。要再来一局吗？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "「玲珑油豆腐」小姐有意的话，我愿意奉陪。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "只不过，旅行者这边有个谜题还在等我解答。"
        },
        {
          "role": "八重神子",
          "text": "是吗？那我就不打扰你们了。"
        },
        {
          "role": "八重神子",
          "text": "刚好去找五郎玩玩，那双毛茸茸的耳朵，我可是好久都没见到了。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "我们说回刚才的话题。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "绮良良小姐，你这几天都在各国之间送货对吗？"
        },
        {
          "role": "绮良良",
          "text": "嗯，最近货物还挺多的，但这和「怪盗」的「线索」有什么关系？"
        },
        {
          "role": "夏洛蒂",
          "text": "奇怪的点在于，绮良良小姐的足迹，与我们一路追寻的「怪盗」不谋而合。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "没错，要点就在此处。"
        },
        {
          "role": "派蒙",
          "text": "难道说…绮良良就是「怪盗」？"
        },
        {
          "role": "绮良良",
          "text": "欸？这，这可不能乱说！我只是个普普通通的快递员而已，你们不能冤枉好人，不对…不能冤枉好妖怪啊！"
        },
        {
          "role": "珊瑚宫心海",
          "text": "两位别急，我并非此意。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "绮良良小姐，这几天收到的快递里，有没有多个货物是同一寄件人，或是发往同一地点的呢？"
        },
        {
          "role": "绮良良",
          "text": "我想想…寄件人倒是都不一样，不过每个地区的确都有一份快递收件地址是相同的。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？收件地址是哪儿？"
        },
        {
          "role": "绮良良",
          "text": "这个…具体的我不能说，只能告诉大家那是在须弥。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "这些货物是不是都很轻巧，最多也就只有信封大小？"
        },
        {
          "role": "绮良良",
          "text": "欸？你…你难道是那种会做预知梦的大妖怪吗？我以前在奶奶腿上趴着睡觉的时候听说过…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "哈哈，我只是海祇岛现人神巫女，平时喜欢读小说和看兵书而已。"
        },
        {
          "type": "subtitle",
          "text": "在珊瑚宫心海的帮助下进行推理"
        },
        {
          "role": "珊瑚宫心海",
          "text": "怎么样？旅行者。听完这些，你是否和我想到了一样的答案了？"
        },
        {
          "role": "旅行者",
          "text": "我试试…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "货物的收件地址",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "（每个地区都有一份快递寄到须弥…）"
                }
              ]
            },
            {
              "text": "货物的模样",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "（货物都很轻巧，最多只有信封大小…）"
                },
                {
                  "type": "subtitle",
                  "text": "出现新的关键词：货物是卡牌",
                  "narration": true,
                  "color": "描述"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "货物是卡牌",
                      "dialogues": [
                        {
                          "role": "旅行者",
                          "text": "（这些货物应该就是「七圣召唤」卡牌…）"
                        },
                        {
                          "type": "subtitle",
                          "text": "与“「怪盗」在利用「狛荷屋」”进行联想出现新的关键词：货物的真相",
                          "narration": true,
                          "color": "描述"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "货物的真相",
                              "dialogues": [
                                {
                                  "role": "旅行者",
                                  "text": "（绮良良手里的货物，就是「宝箱牌背」！）"
                                },
                                {
                                  "type": "subtitle",
                                  "text": "选择该选项提交",
                                  "narration": true,
                                  "color": "描述"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "绮良良的行动",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "（绮良良一直在旅途中和我们碰上…）"
                },
                {
                  "type": "subtitle",
                  "text": "与“「卡牌怪盗」的行动”进行联想出现新的关键词：「怪盗」在利用「狛荷屋」",
                  "narration": true,
                  "color": "描述"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "「怪盗」在利用「狛荷屋」",
                      "dialogues": [
                        {
                          "role": "旅行者",
                          "text": "（「怪盗」很可能在利用「狛荷屋」传递货物…）"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "「卡牌怪盗」的行动",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "（我们是追着「怪盗」的足迹来到了稻妻…）"
                }
              ]
            }
          ]
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯，非常完美的答案。"
        },
        {
          "role": "派蒙",
          "text": "欸？原来追了半天，「怪盗」收集的牌背一直都在我们眼皮底下！"
        },
        {
          "role": "夏洛蒂",
          "text": "但是，这其中还有疑点。"
        },
        {
          "role": "夏洛蒂",
          "text": "绮良良小姐在蒙德是先拿走了货物，我们再碰到的「怪盗」。时间对不上。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "关于这个，我的想法是——「怪盗」不止一人。"
        },
        {
          "role": "旅行者",
          "text": "「牌之怪盗团」？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯，你们在追的这位，应该是「怪盗团」的一员。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "其他人恐怕先一步收集好了牌背，统一寄送出去了。"
        },
        {
          "role": "夏洛蒂",
          "text": "这么一想的话…要在那么多国家收集那么多牌背，的确不是一个人能完成的工作。"
        },
        {
          "role": "派蒙",
          "text": "可是，我们追的这位为什么不用「狛荷屋」的服务呢？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "手脚慢了，错过了组织约定的交货时间…我想大概是这样的理由。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "毕竟听你们描述，他只有过一次「偷盗」行为，还被人看到了。再之后，就都是用「交易」和「打赌」的方式获得牌背。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "我猜这人其实不擅长偷盗。原本应该付给「狛荷屋」的委托费，也被他拿来做交易资金了。"
        },
        {
          "role": "夏洛蒂",
          "text": "那这又有了新的问题。其他人为什么不把牌带在身上，自己回须弥呢？"
        },
        {
          "role": "夏洛蒂",
          "text": "除非…他们有一定要留在当地的理由…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯，这也是我仍未明了的问题。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "「怪盗团」的目的究竟是什么？这套牌背究竟藏着怎样的秘密？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "这恐怕…只有亲眼见到那副牌背才会知道吧…"
        },
        {
          "role": "绮良良",
          "text": "你…你们干什么？别这样看着我，客户的包裹，我是绝对不会开的！"
        },
        {
          "role": "绮良良",
          "text": "这…这要是被公司知道了，我可是会被开除的！"
        },
        {
          "role": "绮良良",
          "text": "我才不要回稻妻的荒山野岭做什么大妖怪呢！"
        },
        {
          "role": "珊瑚宫心海",
          "text": "我们自然没有要为难绮良良小姐的意思。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "事情到了这一步…唔，不如就让大家陪绮良良小姐一起去须弥吧？"
        },
        {
          "role": "派蒙",
          "text": "对呀对呀，多余的信息我们是不会打听的。"
        },
        {
          "role": "派蒙",
          "text": "就怕万一对方是坏人，绮良良你会有危险。一起去的话，旅行者也能保护你。"
        },
        {
          "role": "旅行者",
          "text": "我很能打的。"
        },
        {
          "role": "绮良良",
          "text": "我也很能打呀！从入职到现在我还一个包裹都没丢过呢！"
        },
        {
          "role": "绮良良",
          "text": "那些看我好欺负就来抢东西的家伙，全都被我给打跑了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还是有些担心你…",
              "dialogues": []
            },
            {
              "text": "还是对谜底很好奇…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "绮良良",
          "text": "唔…你们让我想想…"
        },
        {
          "role": "绮良良",
          "text": "…好吧，我可以让你们一起去须弥送货。"
        },
        {
          "role": "绮良良",
          "text": "但是有条件！"
        },
        {
          "role": "绮良良",
          "text": "你们得躲得远远的，不能让客户看见！哪有带着一群人上门送货的道理？"
        },
        {
          "role": "派蒙",
          "text": "没问题，答应你了！"
        },
        {
          "role": "绮良良",
          "text": "另外，就算客户真的偷过东西，或者真的是个坏人，那也得交给当地的卫兵解决！"
        },
        {
          "role": "旅行者",
          "text": "一言为定。"
        },
        {
          "role": "派蒙",
          "text": "看来下一站是须弥了，我们这次还真是走了好多地方呢。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "祝你们顺利。这次的谜底，就留到下次见面时再告诉我吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（珊瑚宫心海&九条裟罗）"
        },
        {
          "role": "珊瑚宫心海",
          "text": "九条小姐，有空聊上几句吗？"
        },
        {
          "role": "九条裟罗",
          "text": "祝贺你获胜，珊瑚宫心海。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "正是多亏了九条小姐此前的提醒，非常感谢。"
        },
        {
          "role": "九条裟罗",
          "text": "你说笑了。明眼人都明白，左右胜负的是彼此的技艺与策略。无论如何，它都是一场精彩的较量。珊瑚宫心海：这次九条小姐没有报名实在可惜。"
        },
        {
          "role": "九条裟罗",
          "text": "我恐怕赢不了你。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "哪里的话。我猜九条小姐也像我一样，期待着在牌局中磨炼技艺，思考对策，和他人如朋友般切磋吧。"
        },
        {
          "role": "九条裟罗",
          "text": "…或许吧。"
        },
        {
          "role": "九条裟罗",
          "text": "我明白了。既然如此，在你离开鸣神岛之前，我们就来上一局「七圣召唤」吧。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "乐意之至。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（荒泷一斗&久岐忍）"
        },
        {
          "role": "荒泷一斗",
          "text": "狐狸女人和什么宫的什么海的比赛，看得我热血沸腾，脑门的汗就像烧开的水一样！"
        },
        {
          "role": "久岐忍",
          "text": "是是是。老大，整个离岛都知道你的激动之情了。但荒泷派大家还在等着，差不多该回去了。"
        },
        {
          "role": "荒泷一斗",
          "text": "再等等，不差这一会儿。至少也让我和挚友最后来上一局…这愿望不过分吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就来一局。",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "挚友啊！你真的是我的挚友！我这熊熊燃烧的卡牌之魂，只有你才能懂！"
                },
                {
                  "role": "久岐忍",
                  "text": "…真拿你们没办法。"
                }
              ]
            },
            {
              "text": "这次不打了。",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "…好吧。"
                },
                {
                  "role": "荒泷一斗",
                  "text": "男子汉有泪不轻弹。我是不会责怪你的，挚友！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（夏洛蒂&绮良良）"
        },
        {
          "role": "夏洛蒂",
          "text": "我听你叫她「狐妖大人」，这里面有什么来由吗？"
        },
        {
          "role": "夏洛蒂",
          "text": "和我具体讲讲吧，说不定写稿用得上呢！"
        },
        {
          "role": "绮良良",
          "text": "欸？真要我讲，我反倒怕说错话了，毕竟我作为妖怪的资历还很浅嘛。"
        },
        {
          "role": "夏洛蒂",
          "text": "好吧，那油豆腐和狐狸有什么关系？"
        },
        {
          "role": "绮良良",
          "text": "哎呀，被你问得肚子都饿了。"
        },
        {
          "role": "绮良良",
          "text": "不如我带你吃稻妻的油豆腐拉面吧，边吃边跟你解释。"
        }
      ],
