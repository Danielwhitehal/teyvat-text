{
  "quest_id": 77676,
  "chapter_num": null,
  "chapter_title": "冒险就要朝着远方",
  "type": "wq",
  "route": "Another Horizon of Adventure",
  "stories": [
    {
      "story_id": 77676,
      "title": "冒险就要朝着远方",
      "description": "在至冬，你们又看见了熟悉的冒险家协会…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与凯瑟琳对话"
        },
        {
          "role": "凯瑟琳",
          "text": "欢迎来到至冬堡，旅行者，冒险家协会已经准备好了为您服务。"
        },
        {
          "role": "凯瑟琳",
          "text": "无论是冒险、探宝，还是想要寻求足以磨砺武艺的强敌，我们都可以提供帮助。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哦…哦。",
              "dialogues": []
            },
            {
              "text": "冒险家协会果然还是一样的感觉啊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "呵呵，那还是会有些许不一样的。您也看到了，至冬非常辽阔，地貌也十分复杂。"
        },
        {
          "role": "凯瑟琳",
          "text": "在这种情况下，如果至冬各地的冒险家们还要赶回协会汇报委托，想必会非常麻烦。"
        },
        {
          "role": "凯瑟琳",
          "text": "所以，我们开发了这台「臻冰通话器」，只要通过它，您就可以便捷地向协会汇报委托了。"
        },
        {
          "role": "凯瑟琳",
          "text": "——至于报酬，协会也会通过各种方式正常地送到您手上。"
        },
        {
          "role": "旅行者",
          "text": "呃，各种方式是指…"
        },
        {
          "role": "凯瑟琳",
          "text": "总之请您放心，我们冒险家协会，不会让任何一场冒险——和委托——落空的！"
        },
        {
          "role": "凯瑟琳",
          "text": "从热情如火的纳塔，直到寒似坚冰的至冬，冒险家协会永远是冒险家们最坚实的后盾。"
        },
        {
          "role": "凯瑟琳",
          "text": "向着星辰与深渊，旅行者，请尽情地冒险吧！"
        }
      ]
    }
  ]
}