{
  "quest_id": 74501,
  "chapter_num": null,
  "chapter_title": "白热化！玩具战争",
  "type": "wq",
  "route": "The Toy War: Heating Up",
  "stories": [
    {
      "story_id": 74501,
      "title": "白热化！玩具战争",
      "description": "再次收到了发条工坊的来信，他们的进展似乎十分不顺利…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至两天后"
        },
        {
          "type": "subtitle",
          "text": "前往莱舒的发条工坊"
        },
        {
          "role": "阿尔邦",
          "text": "怎么感觉留言板上的评价不太对劲呢，不应该全都是猛烈赞美吗？以前可不是这样啊。"
        },
        {
          "role": "阿尔贝",
          "text": "不符预期，肯定是有人在抹黑咱们。"
        },
        {
          "role": "阿尔邦",
          "text": "还好老板高明，早就准备了应对预案。"
        },
        {
          "role": "阿尔贝",
          "text": "那当然，不然人能当老板吗？"
        },
        {
          "role": "派蒙",
          "text": "阿尔邦，阿尔贝，利弗老板在吗？他找我们有事。"
        },
        {
          "role": "阿尔邦",
          "text": "太好了，应对预案来了。"
        },
        {
          "role": "旅行者",
          "text": "什么应对预案？"
        },
        {
          "role": "阿尔邦",
          "text": "两位老爷就是应对预案，哦，这也是老板的主意，不过他现在不在店里，还是我们来讲讲吧。"
        },
        {
          "role": "阿尔贝",
          "text": "那就再简单讲两句。"
        },
        {
          "role": "阿尔邦",
          "text": "这两天我们店把「决斗代理人」企划对外放出了，广告发遍了全城。"
        },
        {
          "role": "阿尔邦",
          "text": "预购也开放了，只要交纳一半的定金就能获得抢鲜体验的资格。"
        },
        {
          "role": "阿尔邦",
          "text": "除此之外还设置了评价栏目，就是店门口那块留言板，大家可以在上面留下自己的赞美。"
        },
        {
          "role": "阿尔贝",
          "text": "哎，这叫造势。"
        },
        {
          "role": "阿尔邦",
          "text": "一开始跟老板想的一样，店里的人气一下就旺了起来，可就是参加预购的人没几个，评价栏目也没有收到什么赞美。"
        },
        {
          "role": "阿尔贝",
          "text": "什么「诚意不足」啊，「内核缺乏」啊，「时代变了」啊，都是这样的评论。"
        },
        {
          "role": "派蒙",
          "text": "看来市场也不是像你们想的那样嘛！"
        },
        {
          "role": "阿尔邦",
          "text": "没这么简单，枫丹有句老话：没有火就没有烟。意思是事情不会凭空而起。"
        },
        {
          "role": "阿尔邦",
          "text": "也就是说，有人在造谣生事！"
        },
        {
          "role": "阿尔贝",
          "text": "恶意抹黑！"
        },
        {
          "role": "阿尔邦",
          "text": "信口雌黄！"
        },
        {
          "role": "阿尔贝",
          "text": "无事生非！"
        },
        {
          "role": "阿尔邦",
          "text": "老板说，肯定是他弟弟雇人抹黑咱们，没有别人了，「决斗代理人」企划要是成功，最着急的就是勒波特钟表店。"
        },
        {
          "role": "派蒙",
          "text": "那你们想怎么样，不会是雇我们去抹黑他们吧？"
        },
        {
          "role": "阿尔邦",
          "text": "芙宁娜大人在上！您怎么会这么想呢？"
        },
        {
          "role": "阿尔邦",
          "text": "再怎么说，我们老板也是卡隆老板的大哥，就算他们用了这种手段，我们也得堂堂正正地击败他们！"
        },
        {
          "role": "阿尔贝",
          "text": "就是，这才能达到哥哥教育弟弟的目的。"
        },
        {
          "role": "旅行者",
          "text": "那要我们做什么呢？"
        },
        {
          "role": "阿尔邦",
          "text": "让他们坦白一下诚意和内核！"
        },
        {
          "role": "派蒙",
          "text": "坦白？"
        },
        {
          "role": "阿尔贝",
          "text": "这样才公平不是吗？枫丹是讲公平的国度。"
        },
        {
          "role": "派蒙",
          "text": "公平不是这个意思吧！"
        },
        {
          "role": "阿尔邦",
          "text": "老板说了，既然大家觉得别人包装的东西有诚意，那我们也可以跟人家保持一致嘛。"
        },
        {
          "role": "阿尔邦",
          "text": "他们怎么包装冒险家，我们就怎么包装决斗代理人，这样再加上我们在数据的丰富度上的优势，一定能反败为胜。"
        },
        {
          "role": "派蒙",
          "text": "他们哪有什么包装啊，就是单纯地把一个冒险家的故事做成了玩具而已。"
        },
        {
          "role": "阿尔邦",
          "text": "那个故事！去问问是什么故事，求您了，那个故事一定就是包装。"
        },
        {
          "role": "阿尔贝",
          "text": "我也听到过小道消息，卡隆老板有天在喝酒的时候无意中说了，这个玩具是因为某人而做的。"
        },
        {
          "role": "阿尔邦",
          "text": "能说出这种话，他和那个冒险家是不是经历了什么不得了的故事？"
        },
        {
          "role": "派蒙",
          "text": "哦？！卡隆老板和那个冒险家？我突然一下就好想知道是什么故事哦，旅行者，不如我们再去问问看吧？"
        },
        {
          "role": "阿尔邦",
          "text": "太棒了！派蒙女士，旅行者先生/女士，就交给你们了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "阿尔邦",
          "text": "老爷们有问到是什么故事吗？"
        },
        {
          "role": "阿尔贝",
          "text": "拜托了。"
        },
        {
          "type": "subtitle",
          "text": "与店主卡隆交谈"
        },
        {
          "role": "卡隆",
          "text": "又见面了，两位客人，不知道最近怎么样？有试玩过冒险家玩具吗？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，卡隆老板好呀，其实我们就是有点事想来咨询一下，刚好就是关于那个玩具的。"
        },
        {
          "role": "卡隆",
          "text": "哦——刚好，我喜欢刚好，想睡懒觉刚好休息，想买东西刚好买得起。所以，有什么你们尽管问吧。"
        },
        {
          "role": "旅行者",
          "text": "想知道关于这个玩具的故事。"
        },
        {
          "role": "派蒙",
          "text": "没错！我们听说卡隆老板是因为某人而做的玩具，一定就是那个作为主角的冒险家吧？"
        },
        {
          "role": "卡隆",
          "text": "哈哈，原来是这个啊，那位冒险家确实是让我印象深刻的人。"
        },
        {
          "role": "卡隆",
          "text": "那是我快要离开蒙德的时候，在清泉镇外面遇见的一位冒险家，当时他好像搞砸了一个委托，叫什么餐品订单。"
        },
        {
          "role": "卡隆",
          "text": "据说是路途上连续遇到了好几波魔物，一来耽误了时间，二来还碰洒了餐品，我略懂厨艺，就主动帮他重新做了一份。"
        },
        {
          "role": "派蒙",
          "text": "卡隆老板真热心！"
        },
        {
          "role": "卡隆",
          "text": "哈哈，但这点热心完全不够看，你们肯定很难想象，只是做份料理而已，为什么会有那么多意外。"
        },
        {
          "role": "卡隆",
          "text": "生火的柴被打湿啦…锅底被铲了个大洞啦…装盘时被不明飞石砸中啦这些…有一个还弹到了我的脑袋上，挺痛的！"
        },
        {
          "role": "卡隆",
          "text": "虽说最后勉强完成了委托，但还是被客人投诉了，理由是吃到了崩掉大牙的石子。"
        },
        {
          "role": "卡隆",
          "text": "芙宁娜大人在上，不会就是砸中我们脑袋的那个吧？"
        },
        {
          "role": "旅行者",
          "text": "这个冒险家，是不是叫…"
        },
        {
          "role": "卡隆",
          "text": "叫班尼特，该不会…两位客人也认识他吧？这家伙真是太神奇了。"
        },
        {
          "role": "卡隆",
          "text": "后来他为了感谢我，带我去了蒙德各种人迹罕至的地方，虽然路很难走，但风景格外美丽。"
        },
        {
          "role": "卡隆",
          "text": "我还以为他兼职什么资深旅游爱好者，没想到他告诉我，他要么就是冒险时失足跌落，要么就是不小心迷路误闯过去的。"
        },
        {
          "role": "卡隆",
          "text": "我返程的那天，他来与我告别，我问他，这种倒霉的体质是不是很麻烦。"
        },
        {
          "role": "卡隆",
          "text": "结果他笑着竖起了大拇指，说：「世上就是有各种各样的人，也许我就是最倒霉的那个。」"
        },
        {
          "role": "卡隆",
          "text": "「但正因为这样，我刚好又成了最有勇气的那个。所以这是世上独属于我的风景哦。」"
        },
        {
          "role": "卡隆",
          "text": "真是厉害的说法。走在不幸铺就的路上，却还是大笑着向前，也许这就是真正的冒险家吧？"
        },
        {
          "role": "派蒙",
          "text": "没错！班尼特就是最冒险家的冒险家！"
        },
        {
          "role": "卡隆",
          "text": "呵呵，我想要是霉运会传染，那这种冒险精神一定也能传染，而且能传染到更远的地方。"
        },
        {
          "role": "卡隆",
          "text": "不知道这个故事，够不够让你们回去交差啊。"
        },
        {
          "role": "派蒙",
          "text": "啊…卡隆老板，你怎么又知道了呀…"
        },
        {
          "role": "卡隆",
          "text": "没有火就没有烟，这就是枫丹人的生活。"
        },
        {
          "role": "卡隆",
          "text": "你们如果很想知道这个故事，第一天就会问了，今天才来问，估计是受我大哥之托吧？"
        },
        {
          "role": "派蒙",
          "text": "真是一下就被看穿了！明明卡隆老板温柔又有智慧，好难相信利弗老板会对这样的弟弟有偏见。"
        },
        {
          "role": "卡隆",
          "text": "那是因为大哥在生气吧，觉得我背叛了他，他肯定到现在还在生气。"
        },
        {
          "role": "派蒙",
          "text": "欸？！背叛？！"
        },
        {
          "role": "卡隆",
          "text": "我们家祖上就是以发条手艺闻名的，我从小就很擅长做些发条玩具，虽然这方面大哥不如我，但他在商业上很有头脑。"
        },
        {
          "role": "卡隆",
          "text": "因为都喜欢玩具，我们就约定，长大了要开一家最厉害的玩具店。但是长大了才知道，家业是必须有人来继承的，就是这家钟表店。"
        },
        {
          "role": "卡隆",
          "text": "大哥和父亲大吵了一架，出去自立门户了，但我被说服了，没有跟随大哥，这是背叛吧？"
        },
        {
          "role": "派蒙",
          "text": "唔…这算什么背叛啦！"
        },
        {
          "role": "卡隆",
          "text": "至少也是没有冒险精神的体现了，我也担心没有闯出什么名堂，又得灰溜溜地回来，把爱好当作事业，那样的压力我承受不了。"
        },
        {
          "role": "卡隆",
          "text": "从小我就是这样的，遇到找麻烦的混混我第一个哭，但大哥就会把我挡在后面说，「看大哥把他们一拳打飞！」"
        },
        {
          "role": "派蒙",
          "text": "你们的兄弟关系好像还有点复杂呢…"
        },
        {
          "role": "卡隆",
          "text": "呵呵，刚好就是这样啦。"
        },
        {
          "role": "卡隆",
          "text": "总而言之，如果还有什么疑问，我就在这里，随时欢迎二位光临。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "卡隆",
          "text": "客人还有什么疑问吗？"
        },
        {
          "type": "subtitle",
          "text": "返回莱舒的发条工坊"
        },
        {
          "role": "阿尔邦",
          "text": "老板，两位老爷回来了。"
        },
        {
          "role": "利弗",
          "text": "两位还是这么迅速啊，这次一定也是收获满满吧？"
        },
        {
          "role": "派蒙",
          "text": "利弗老板，你怎么总在第二时间出现啊？"
        },
        {
          "role": "利弗",
          "text": "怠慢了，下次我保证第一时间出现。嘿嘿，关于那个玩具的事…"
        },
        {
          "type": "subtitle",
          "text": "将班尼特的故事告诉了利弗，他的眉头蹙了起来。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "利弗",
          "text": "为一个名叫做班尼特的冒险家而制作的玩具？原来如此…"
        },
        {
          "role": "派蒙",
          "text": "利弗老板，还有一件事哦，虽然没有问，但我觉得你弟弟没有抹黑你们店啦，他肯定不会做这种事。"
        },
        {
          "role": "利弗",
          "text": "此话怎讲？"
        },
        {
          "role": "旅行者",
          "text": "他好像对利弗老板心怀歉意。"
        },
        {
          "type": "subtitle",
          "text": "将卡隆的话转述了出来，利弗的眼神渐渐穿过你们，望向了忽远忽近的飘渺处，如同一台正在调试焦点的留影机。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "过了好一会，他才从胸膛挤出了一声小小的不满。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "利弗",
          "text": "哼…"
        },
        {
          "role": "利弗",
          "text": "真要说的话，我也没觉得那臭小子会做这种事…"
        },
        {
          "role": "派蒙",
          "text": "什么嘛，那还搞什么应对预案？"
        },
        {
          "role": "阿尔邦",
          "text": "老板是在找借口啦，给自己提前开脱一下，顺便找个了解那个故事的借口。"
        },
        {
          "role": "阿尔贝",
          "text": "我看八成也是。"
        },
        {
          "role": "阿尔邦",
          "text": "生意人嘛，哪有不要面子的。"
        },
        {
          "role": "阿尔贝",
          "text": "而且还是大哥，大哥的面子大过天，所以才叫大哥。"
        },
        {
          "role": "利弗",
          "text": "再多嘴就把你们一拳打飞。"
        },
        {
          "role": "派蒙",
          "text": "利弗老板还真是像卡隆老板说的那样呢。"
        },
        {
          "role": "利弗",
          "text": "两位贵客，我刚刚在想，我也许应该去见那臭小子一面。"
        },
        {
          "role": "派蒙",
          "text": "哇！卡隆老板这是要放下哥哥的架子，虚心请教弟弟了吗？"
        },
        {
          "role": "利弗",
          "text": "当然不是，我的意思是，要不要给他一个当面跟我道歉的机会，他不是也说觉得背叛我了吗？他不是对我心怀歉意吗？"
        },
        {
          "role": "派蒙",
          "text": "呃…虽然是这么说了…但总觉得不是那种应该道歉的背叛啊…"
        },
        {
          "role": "利弗",
          "text": "那…就先这么决定了。阿尔邦，把之后的预购都取消了，定金该退的退，评价板也先收起来。"
        },
        {
          "role": "阿尔邦",
          "text": "什么？老板！难道企划不做了吗？那之后的数据收集怎么办？"
        },
        {
          "role": "旅行者",
          "text": "其实也有调整修改的余地。"
        },
        {
          "role": "利弗",
          "text": "不，数据收集工作还要继续，我另有打算。而且至少要让你们把酬劳拿完，对吧？我做生意很讲诚信。"
        },
        {
          "role": "派蒙",
          "text": "噫，老板的诚信出现在了奇怪的地方！"
        },
        {
          "role": "阿尔贝",
          "text": "老板不愧是老板啊，连任性的样子都那么老板。"
        },
        {
          "role": "利弗",
          "text": "哼，那小子对玩具的态度，也不是完全没有可取的地方。"
        },
        {
          "role": "利弗",
          "text": "等过两天数据收集的事结了，我就登门拜访一下勒波特钟表店，希望两位贵客那天也能来一趟。"
        },
        {
          "role": "利弗",
          "text": "今天店里还有点事，就先失陪了。"
        },
        {
          "type": "subtitle",
          "text": "利弗转身走进了店里。",
          "narration": true,
          "color": "gray"
        },
        {
          "role": "派蒙",
          "text": "啊…利弗老板的脾气可真怪啊…不会真是要求人家道歉吧？"
        },
        {
          "role": "阿尔邦",
          "text": "哎呀，这样看，这回又是第三人带来了转机。"
        },
        {
          "role": "派蒙",
          "text": "什么？什么第三人？"
        },
        {
          "role": "阿尔邦",
          "text": "就是两位老爷啦，因为你们的出现，利弗老板和卡隆老板的矛盾又有缓和的迹象了，以前也是这样。"
        },
        {
          "role": "旅行者",
          "text": "以前也是？"
        },
        {
          "role": "阿尔邦",
          "text": "嗯，老爷们有注意到吗？我们店和勒波特钟表店中间隔了一个北国银行。"
        },
        {
          "role": "阿尔邦",
          "text": "最早老板其实是想把店开在勒波特钟表店隔壁的，和他们针锋相对。"
        },
        {
          "role": "阿尔贝",
          "text": "但后来那个位置被北国银行预定走了，虽然他们大概不知道老板的事，但某种意义上，就像变成了中间调停的第三人吧？"
        },
        {
          "role": "派蒙",
          "text": "真有意思，虽然愚人众很喜欢插手别人的事，不过这样的好像还是头一回！"
        },
        {
          "role": "阿尔邦",
          "text": "所以说，第三人很重要，就像双人喜剧还需要至少一个观众那么重要。"
        },
        {
          "role": "阿尔贝",
          "text": "那单人喜剧呢？一个演员加一个观众就可以了吧？"
        },
        {
          "role": "阿尔邦",
          "text": "说什么呢？你小子也要背叛我吗？小心我一拳把你打飞！"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "阿尔邦",
          "text": "你看见留言板了吗？好像有人看上了那个发条企鹅。"
        },
        {
          "role": "阿尔贝",
          "text": "看到了，是想要认识下菲米尼的那条吧？听口气，感觉还有点想进一步合作的意思。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "菲米尼？",
              "dialogues": [
                {
                  "role": "阿尔邦",
                  "text": "哦，就是摆在那边桌子上的发条玩具企鹅，是一个叫做菲米尼的潜水员做的。他放在我们店寄售。"
                },
                {
                  "role": "阿尔贝",
                  "text": "他是个好小伙子，有一张漂亮的脸蛋，说话轻声细语，做玩具的手艺还很棒。"
                },
                {
                  "role": "阿尔邦",
                  "text": "唯一就是，他看起来有点忧伤，就好像缺少了什么本该属于他的东西。"
                },
                {
                  "role": "阿尔贝",
                  "text": "那眼神我太清楚啦，和阿尔邦看他那空荡荡的钱包的眼神一模一样，他绝对是缺钱。"
                }
              ]
            },
            {
              "text": "发条企鹅？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔邦",
          "text": "别胡说，你忘了他来谈寄售的那天，都没说分成的事。这一看就不是冲着摩拉来的。"
        },
        {
          "role": "阿尔贝",
          "text": "这倒也是，但这种年纪的小伙子还能烦恼什么呢？"
        },
        {
          "role": "阿尔邦",
          "text": "话说回来，他确实挺讨人喜欢的，老板这还是头一回答应了寄售。"
        },
        {
          "role": "阿尔邦",
          "text": "不仅给安排了户外的摊位，也没占人便宜，主动提出了五五分成。"
        },
        {
          "role": "阿尔贝",
          "text": "可惜啊，最后卖的情况，只能说一般般吧。看的人不少，买的人不多。"
        },
        {
          "role": "阿尔贝",
          "text": "那个玩具的设计确实精巧，但可能正因为这样，上手的门槛也变高了，维修起来也不容易。"
        },
        {
          "role": "阿尔邦",
          "text": "没想到这次居然有人特地在留言板上留言。搞不好碰上大客户了呢。"
        },
        {
          "role": "阿尔贝",
          "text": "总之，回头记得提醒一下老板，好买卖可别弄丢了。"
        }
      ],
