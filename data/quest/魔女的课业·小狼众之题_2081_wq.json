{
  "quest_id": 2081,
  "chapter_num": "",
  "chapter_title": "魔女的课业·小狼众之题",
  "type": "wq",
  "route": "Witch's Homework: Of the Little Wolf Pack",
  "stories": [
    {
      "story_id": 10008,
      "title": "和「卢皮卡」一起",
      "description": "根据魔女所赠予的辞典的引导，这次的「课题」似乎需要在奔狼领进行，去奔狼领看看这次的「课题」是什么样的吧…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往奔狼领"
        },
        {
          "role": "派蒙",
          "text": "啊，雷泽在那边，还有…哇，北风的王狼…"
        },
        {
          "role": "派蒙",
          "text": "他们在商量什么事吗？"
        },
        {
          "type": "subtitle",
          "text": "与雷泽交谈"
        },
        {
          "role": "派蒙",
          "text": "雷泽——"
        },
        {
          "role": "雷泽",
          "text": "闻到了，熟悉的气味，原来是你们。"
        },
        {
          "role": "雷泽",
          "text": "最近，还好吗？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，一切都好，对了，雷泽，怎么王狼一见到我们就消失了，你们在讨论什么秘密呢？"
        },
        {
          "role": "雷泽",
          "text": "要开始狩猎，我在说服…领主。"
        },
        {
          "role": "派蒙",
          "text": "打猎？"
        },
        {
          "role": "派蒙",
          "text": "（对了，旅行者，难道这就是雷泽的「课题」吗？）"
        },
        {
          "role": "派蒙",
          "text": "雷泽，难道是狼群又没有吃的东西，所以大家要开始打猎…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请给我捕兽夹…",
              "dialogues": []
            },
            {
              "text": "林猪长得够大了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "雷泽",
          "text": "不，不是…这次的打猎，不是为了填饱肚子。"
        },
        {
          "role": "雷泽",
          "text": "而是为了，杀死敌人。漆黑的狼群，侵占的领土…发出奇怪的臭味，越来越浓…"
        },
        {
          "role": "雷泽",
          "text": "要净化森林…狩猎敌人。"
        },
        {
          "role": "派蒙",
          "text": "所以，王狼答应了吗，我还记得那个时候，王狼还说…"
        },
        {
          "role": "派蒙",
          "text": "我想想，是怎么说的来着…咳咳，「雷泽，你不准参与讨伐。因为这是狼的问题。」"
        },
        {
          "role": "雷泽",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "啊，我不是故意的…对不起，雷泽…"
        },
        {
          "role": "雷泽",
          "text": "没关系，因为我和「卢皮卡」在一起，而且，师父告诉了我，和领主说话的方法。"
        },
        {
          "role": "派蒙",
          "text": "丽莎说的…和领主说话的方法？"
        },
        {
          "role": "派蒙",
          "text": "啊，我明白了，是说服王狼的办法吧，所以你刚才已经说服王狼了吗！"
        },
        {
          "role": "雷泽",
          "text": "嗯，说话很累，可是，成功了。"
        },
        {
          "role": "派蒙",
          "text": "居然能够说服那个顽固的大家伙，了不起！"
        },
        {
          "role": "雷泽",
          "text": "漆黑的狼，是世界的敌人。师父说，这不是狼的问题，而是世界的问题…师父是对的，领主也承认了。"
        },
        {
          "role": "雷泽",
          "text": "不过，因此，狼群不会参与，是「我」与「漆黑狼群」的战争…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，那就让我们也一起帮忙吧！那些奇怪的兽境猎犬，我们也早就看不顺眼啦！"
        },
        {
          "role": "雷泽",
          "text": "谢、谢谢…如果，有你们的帮助，一定能顺利。"
        },
        {
          "role": "派蒙",
          "text": "不过，要怎么开始狩猎呢？"
        },
        {
          "role": "雷泽",
          "text": "我们要，像把猎物赶到陷阱，把漆黑狼群，赶到这里…"
        },
        {
          "role": "雷泽",
          "text": "领主会，困住他们，我们来…把它们解决掉。"
        },
        {
          "role": "雷泽",
          "text": "…准备好，跟我说一声，就开始，狩猎。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "现在就出发吧！",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "狩猎深渊魔物"
        },
        {
          "role": "派蒙",
          "text": "好，一鼓作气，把它们全都赶跑！"
        },
        {
          "role": "雷泽",
          "text": "嗯。"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|嗜雷·兽境猎犬|1}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "雷泽",
          "text": "解决了…"
        },
        {
          "type": "subtitle",
          "text": "继续前进"
        },
        {
          "type": "subtitle",
          "text": "保护狼群"
        },
        {
          "role": "雷泽",
          "text": "咦，「卢皮卡」们，为什么会在…"
        },
        {
          "role": "派蒙",
          "text": "唔，兽境猎犬在攻击他们，快把兽境猎犬解决掉！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|嗜雷·兽境猎犬|1}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "好险！幸好有狼群的帮忙！"
        },
        {
          "role": "雷泽",
          "text": "嗯…"
        },
        {
          "role": "派蒙",
          "text": "它们也拖住了很多兽境猎犬…甚至，在帮我们驱赶敌人？"
        },
        {
          "role": "雷泽",
          "text": "可是，这不是狼的事…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，就像雷泽想要帮助「卢皮卡」，「卢皮卡」又怎么会让你陷入危险呢！"
        },
        {
          "role": "派蒙",
          "text": "也许它们向北风的王狼说，「哼哼，这不是『卢皮卡』的问题，这是世界的问题！」然后就跑过来帮忙啦。"
        },
        {
          "role": "雷泽",
          "text": "嗯，「卢皮卡」，就是，「卢皮卡」…"
        },
        {
          "role": "雷泽",
          "text": "我是人类中的「卢皮卡」，我不用是狼，但是…只要是能够帮到「卢皮卡」，就是好的。"
        },
        {
          "role": "派蒙",
          "text": "说得对，雷泽！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许王狼会答应…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是因为雷泽的这份心意。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "雷泽",
          "text": "是吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯！一定是这样！好，我们就和狼群一鼓作气，把坏蛋们全都赶跑吧！"
        },
        {
          "type": "subtitle",
          "text": "继续前进"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|嗜雷·兽境幼兽|5}}（可不击败）",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "消灭黑色的狼群"
        },
        {
          "role": "派蒙",
          "text": "好，所有没解决的「漆黑狼群」就在前面！"
        },
        {
          "role": "派蒙",
          "text": "准备好就上吧！"
        },
        {
          "role": "雷泽",
          "text": "…为了「卢皮卡」。"
        },
        {
          "role": "派蒙",
          "text": "为了「卢皮卡」！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|嗜岩·兽境猎犬|1}}{{图标|嗜雷·兽境幼兽|3}}{{图标|嗜岩·兽境幼兽|1}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与雷泽对话"
        },
        {
          "role": "派蒙",
          "text": "成功了！"
        },
        {
          "role": "雷泽",
          "text": "谢谢，谢谢你们…我一直以为，只要我保护「卢皮卡」就够了。"
        },
        {
          "role": "雷泽",
          "text": "其实「卢皮卡」也…"
        },
        {
          "role": "派蒙",
          "text": "正是因为心意相通，「卢皮卡」才是「卢皮卡」嘛！"
        },
        {
          "role": "雷泽",
          "text": "派蒙说得对…这点，永远不会变。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，这下奔狼领就不会出现「外来的狼群」了吧。"
        },
        {
          "role": "雷泽",
          "text": "不…那些家伙，撕开空间…也许还会来。"
        },
        {
          "role": "雷泽",
          "text": "不过，有我和「卢皮卡」们，我们会一起…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…还有我和派蒙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对对，要是需要帮助，一定要告诉我们，我们也会帮忙的！"
        },
        {
          "role": "雷泽",
          "text": "嗯，有你们，真好。"
        },
        {
          "role": "远处的狼嚎",
          "text": "啊呜——"
        },
        {
          "role": "雷泽",
          "text": "他们，在呼唤我。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，看来他们在担心着你的安危呢。"
        },
        {
          "role": "雷泽",
          "text": "那我，要离开了，谢谢，你们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用谢，这是「卢皮卡」该做的。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "奔狼领获得了短暂但久违的平静，雷泽与你作了简单的告别，步入了奔狼领的丛林之中。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "你看到，树叶的薮影之中，那里有许多期待他的，温柔的眼眸。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "解锁额外天赋「魔女的前夜礼·苍雷奔涌」",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}