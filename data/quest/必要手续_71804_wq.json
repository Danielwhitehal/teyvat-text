{
  "quest_id": 71804,
  "chapter_num": null,
  "chapter_title": "必要手续",
  "type": "wq",
  "route": "Necessary Procedures",
  "stories": [
    {
      "story_id": 71804,
      "title": "必要手续",
      "description": "在璃月港的风波过去后，城里的一切事情似乎都在慢慢发生变化…而伊凡诺维奇先生，正在努力让自己适应这种变化…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "抄写有关新经营许可证的公告"
        },
        {
          "role": "公告板",
          "text": "此乃绯云坡公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于总务司人事调动的说明…",
              "dialogues": [
                {
                  "role": "公告板",
                  "text": "「总务司人事调动公示如下…」"
                },
                {
                  "role": "派蒙",
                  "text": "等一下，总务司的人事调动应该跟经营许可证没有关系吧。"
                }
              ]
            },
            {
              "text": "关于绯云坡水源污染问题的情况通报…",
              "dialogues": [
                {
                  "role": "公告板",
                  "text": "「关于绯云坡近来水源污染一事…」"
                },
                {
                  "role": "派蒙",
                  "text": "伊凡诺维奇先生急着办事呢，我们没有时间关心水源污染问题啦。"
                }
              ]
            },
            {
              "text": "关于新版经营许可证的申请…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "关于新版经营许可证的申请…"
        },
        {
          "role": "公告板",
          "text": "「如需申请新版经营许可证，需有如下手续…」"
        },
        {
          "role": "派蒙",
          "text": "这应该就是伊凡诺维奇先生想要申请的新版经营许可证了，我们赶快抄下来吧。"
        },
        {
          "type": "subtitle",
          "text": "与伊凡诺维奇对话"
        },
        {
          "role": "伊凡诺维奇",
          "text": "你找到关于新版经营许可证的公告了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经抄下来了。"
        },
        {
          "role": "伊凡诺维奇",
          "text": "太好了，我来仔细看看…"
        },
        {
          "role": "伊凡诺维奇",
          "text": "出海申请批复件，经营场所证明及经营安全许诺书和…还有旧的经营许可证…"
        },
        {
          "role": "伊凡诺维奇",
          "text": "还好，还好，这几份文件我前几天刚刚跑去签好了，可把我跑得够呛。"
        },
        {
          "role": "伊凡诺维奇",
          "text": "旅行者，麻烦你再帮我跑一趟，把这些文件分别交上去吧。"
        },
        {
          "role": "伊凡诺维奇",
          "text": "咳咳…可能要交的人有点多…"
        },
        {
          "role": "伊凡诺维奇",
          "text": "呃，首先，<color=#00E1FFFF>出海申请批复件</color>交给小安，<color=#00E1FFFF>经营场所证明及经营安全许诺书</color>交给千岩军嘉义…"
        },
        {
          "role": "伊凡诺维奇",
          "text": "还有<color=#00E1FFFF>旧的经营许可</color>，去交给小昭就可以了。"
        },
        {
          "role": "伊凡诺维奇",
          "text": "旅行者，就拜托你再帮我跑跑了，我一定会准备好足够的报酬。"
        },
        {
          "role": "旅行者",
          "text": "好吧，好吧…"
        },
        {
          "role": "伊凡诺维奇",
          "text": "希望跑完这些手续之后，我就不用再跑了…"
        },
        {
          "role": "旅行者",
          "text": "希望以后不用跑了。"
        },
        {
          "role": "伊凡诺维奇",
          "text": "你之后应该不用跑这种手续了，但是我嘛…在这里做生意，之后免不了还得跑。"
        },
        {
          "role": "伊凡诺维奇",
          "text": "唉，虽然这种办事方式确实让人安心，但如果能再简化一些就更好了。"
        },
        {
          "type": "subtitle",
          "text": "将相应材料交给小安"
        },
        {
          "role": "小安",
          "text": "这份材料的手续怎么又不全…"
        },
        {
          "role": "旅行者",
          "text": "关于伊凡诺维奇的新版经营许可证…"
        },
        {
          "role": "小安",
          "text": "伊凡诺维奇…哦，之前他来过几趟，我有印象。"
        },
        {
          "role": "小安",
          "text": "他是在跑新版经营许可证的手续吗？哈哈…那他估计跑得够呛…"
        },
        {
          "role": "小安",
          "text": "你是来帮他代办的吧，<color=#00E1FFFF>出海申请批复件</color>带来了吗？我上次和他说了，他的手续不全，得去其他地方补一下…"
        },
        {
          "type": "subtitle",
          "text": "将相应材料交给小安"
        },
        {
          "role": "小安",
          "text": "我看看…这材料不对啊，我这里只处理海事司负责的业务，其他的材料不归我管。"
        },
        {
          "type": "subtitle",
          "text": "将相应材料交给小安"
        },
        {
          "role": "小安",
          "text": "我看看…这材料不对啊，我这里只处理海事司负责的业务，其他的材料不归我管。"
        },
        {
          "type": "subtitle",
          "text": "将相应材料交给小安"
        },
        {
          "role": "小安",
          "text": "我看看…嗯，这样应该就可以了，那这份文件我收下了。"
        },
        {
          "type": "subtitle",
          "text": "将相应材料交给嘉义"
        },
        {
          "role": "嘉义",
          "text": "请保持秩序，保持秩序！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于伊凡诺维奇的新版经营许可证…",
              "dialogues": [
                {
                  "role": "嘉义",
                  "text": "啊？你是来帮人代办的吧，那你把经营场所证明…和那什么来着？哦…经营安全许诺书，都带来了吗？"
                }
              ]
            },
            {
              "text": "你在负责经营许可证的事？",
              "dialogues": [
                {
                  "role": "嘉义",
                  "text": "没有，没有。我只是临时过来帮忙的，小昭那边文件收不过来了，我暂时先来帮忙收一下，归个档。"
                },
                {
                  "role": "嘉义",
                  "text": "嗨，这活干得真是头晕…好了，你把经营场所证明，还有经营安全许诺书带来了吗？"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "将相应材料交给嘉义"
        },
        {
          "role": "嘉义",
          "text": "你交的这个不对啊，我这边只收经营场所证明及经营安全许诺书。"
        },
        {
          "type": "subtitle",
          "text": "将相应材料交给嘉义"
        },
        {
          "role": "嘉义",
          "text": "行，我先把这些文件收着吧。等会我就交给小昭去。"
        },
        {
          "type": "subtitle",
          "text": "请在白天工作时间找小昭办理业务"
        },
        {
          "type": "subtitle",
          "text": "将相应材料交给小昭"
        },
        {
          "role": "小昭",
          "text": "你好，有什么要提交的材料，或者有什么要问的吗？"
        },
        {
          "role": "旅行者",
          "text": "关于伊凡诺维奇的新版经营许可证…"
        },
        {
          "role": "小昭",
          "text": "你是帮他代办新的经营许可证吧，那伊凡诺维奇的<color=#00E1FFFF>旧经营许可证</color>带来了吗？"
        },
        {
          "role": "小昭",
          "text": "带来的话就给我吧，要换成新经营许可证的话，旧的那张必须回收才行。"
        },
        {
          "type": "subtitle",
          "text": "将相应材料交给小昭"
        },
        {
          "role": "小昭",
          "text": "嗯，没错，那这张旧经营许可证我就收下了。"
        },
        {
          "role": "小昭",
          "text": "还有其他的相关文件和材料，你都提交好了吗？如果没提交好的话，说不定过几天你又得再跑一趟了。"
        },
        {
          "role": "旅行者",
          "text": "都提交了。"
        },
        {
          "role": "小昭",
          "text": "好，如果材料齐全合规的话，新版经营许可证应该很快就能办下来了。"
        },
        {
          "role": "小昭",
          "text": "办下来了之后，我会让人去通知伊凡诺维奇过来取的。"
        },
        {
          "type": "subtitle",
          "text": "向伊凡诺维奇回报"
        },
        {
          "role": "伊凡诺维奇",
          "text": "你把材料都提交好了吗？"
        },
        {
          "role": "旅行者",
          "text": "都提交好了。"
        },
        {
          "role": "伊凡诺维奇",
          "text": "呼，那太好了，只要新版经营许可证批下来，我就能接着在这做生意了。"
        },
        {
          "role": "伊凡诺维奇",
          "text": "谢谢你帮我跑这一趟，实在是太感谢了，这是给你的报酬。"
        },
        {
          "role": "伊凡诺维奇",
          "text": "希望以后不用再跑这么多手续了，真是…太让人疲惫了…"
        }
      ]
    }
  ]
}