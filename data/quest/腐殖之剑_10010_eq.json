{
  "quest_id": 10010,
  "chapter_num": "白垩与黑龙 第一幕",
  "chapter_title": "腐殖之剑",
  "type": "eq",
  "route": "Festering Desire",
  "stories": [
    {
      "story_id": 41210,
      "title": "腐殖之剑",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "经历了雪山之旅以后，你与派蒙准备再去山脚下的冒险家营地见识一番。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往冒险家营地"
        },
        {
          "type": "subtitle",
          "text": "与砂糖对话"
        },
        {
          "role": "派蒙",
          "text": "呀，是砂糖！"
        },
        {
          "role": "派蒙",
          "text": "你也来雪山探险吗？"
        },
        {
          "role": "砂糖",
          "text": "呜哇！吓我一跳…请不要在我思考研究报告的时候突然吓唬我！"
        },
        {
          "role": "派蒙",
          "text": "可你看上去只是呆呆地站着而已呀…"
        },
        {
          "role": "砂糖",
          "text": "没、没有这种事，我明明是在为新研发的四倍大种子甜甜花取名。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：四倍大种子甜甜花一定好吃。",
              "dialogues": [
                {
                  "role": "砂糖",
                  "text": "哦哦？你感兴趣吗！太好了，下次请务必给我向你展示新成果的机会！"
                }
              ]
            },
            {
              "text": "旅行者：这是可以吃的东西吗？",
              "dialogues": [
                {
                  "role": "砂糖",
                  "text": "哦哦？你感兴趣吗！太好了，下次请务必给我向你展示新成果的机会！"
                }
              ]
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "好可惜，要不是来雪山，我一般都会把成品带在身边的…"
        },
        {
          "role": "派蒙",
          "text": "对哦，你不是在城里做研究吗？怎么跑到这里来啦？"
        },
        {
          "role": "砂糖",
          "text": "我和蒂玛乌斯在帮阿贝多先生整理实验数据哦。蒂玛乌斯刚走，你们没遇到他吗？"
        },
        {
          "role": "派蒙",
          "text": "没有哎。"
        },
        {
          "role": "砂糖",
          "text": "他说自己对数据不够敏锐，比阿贝多先生差了太多。"
        },
        {
          "role": "砂糖",
          "text": "有些东西先生一眼就能看出来，我们却要想很久。恐怕这就是学识与经验的差距吧…"
        },
        {
          "role": "砂糖",
          "text": "因为沮丧，他就说要去别处散散步，我一个人先做剩余的工作。"
        },
        {
          "role": "旅行者",
          "text": "（总觉得蒂玛乌斯是不是故意的…）"
        },
        {
          "role": "砂糖",
          "text": "本想做完手上的事四处转转，没想到从报告里找到了一些有趣数据！"
        },
        {
          "role": "砂糖",
          "text": "唉…我的探秘之旅，又要延后了呀…"
        },
        {
          "role": "派蒙",
          "text": "探秘？什么秘？！"
        },
        {
          "role": "砂糖",
          "text": "啊…这么说来，你们现在有空吗？"
        },
        {
          "role": "派蒙",
          "text": "有呀！我们正在到处闲逛呢！"
        },
        {
          "role": "砂糖",
          "text": "能请你们帮我一个忙吗？事实上，我总觉得…阿贝多先生有事瞒着我和蒂玛乌斯。"
        },
        {
          "role": "派蒙",
          "text": "阿贝多不是你们的老师吗？老师能有什么事瞒着学生呀。"
        },
        {
          "role": "砂糖",
          "text": "是啊，可他似乎一直在掩藏某件东西…我猜，一定是与炼金术有关的厉害东西！"
        },
        {
          "role": "派蒙",
          "text": "明明不知道实情，为什么还能这么肯定啊！"
        },
        {
          "role": "砂糖",
          "text": "因为我和蒂玛乌斯都是炼金术的狂热研究者，如果是别的东西，阿贝多先生没必要瞒着我们才对。"
        },
        {
          "role": "派蒙",
          "text": "啊…这么一说确实很有道理…"
        },
        {
          "role": "砂糖",
          "text": "能帮我调查一下阿贝多先生到底藏着什么吗？我实在是太好奇了！拜托拜托！"
        },
        {
          "role": "派蒙",
          "text": "唔…你觉得呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：如果砂糖想知道，我可以一探究竟。",
              "dialogues": [
                {
                  "role": "砂糖",
                  "text": "哇啊——！太好了，谢谢你！"
                }
              ]
            },
            {
              "text": "旅行者：我也想知道阿贝多的秘密收藏。",
              "dialogues": [
                {
                  "role": "砂糖",
                  "text": "哇啊——！太好了，谢谢你！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧好吧，那就让我们走一趟吧！"
        },
        {
          "type": "subtitle",
          "text": "找到阿贝多，了解他的秘密"
        },
        {
          "role": "砂糖",
          "text": "阿贝多先生的秘密一定很厉害吧，否则，为什么要保密呢？"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "派蒙",
          "text": "阿贝多——！"
        },
        {
          "role": "旅行者",
          "text": "嗨，又是我们哦。"
        },
        {
          "role": "阿贝多",
          "text": "嗯？你们怎么回来了？"
        },
        {
          "role": "阿贝多",
          "text": "迷路了吗？"
        },
        {
          "role": "派蒙",
          "text": "不是啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：在路上接了砂糖的委托，来调查你的秘密。",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "哦？秘密？"
                }
              ]
            },
            {
              "text": "旅行者：砂糖说你有些不可告人的小秘密。",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "哦？秘密？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "啊啊啊，你在干什么呀！"
        },
        {
          "role": "派蒙",
          "text": "这种时候不是应该悄悄调查吗？怎么就说出来了！"
        },
        {
          "role": "旅行者",
          "text": "反正也瞒不过阿贝多吧。"
        },
        {
          "role": "派蒙",
          "text": "呜…就算你这么说…"
        },
        {
          "role": "阿贝多",
          "text": "来得正好，我也有事要找你，旅行者。"
        },
        {
          "role": "阿贝多",
          "text": "接着！"
        },
        {
          "role": "派蒙",
          "text": "咦，这是什么？"
        },
        {
          "role": "阿贝多",
          "text": "如你所见，一把单手剑。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：原来你会锻造？",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "剑不是我打的，不过，我刚才在上面施了炼金术。"
                }
              ]
            },
            {
              "text": "旅行者：炼金术士也要兼职铁匠吗？",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "剑不是我打的，不过，我刚才在上面施了炼金术。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "想试试吗？"
        },
        {
          "role": "旅行者",
          "text": "哎？要把它给我吗？"
        },
        {
          "role": "阿贝多",
          "text": "根据我的研究，这把剑情况特殊，只有你能使用。"
        },
        {
          "role": "阿贝多",
          "text": "但我现在迫切需要它的数据，麻烦你拿着它多多战斗。"
        },
        {
          "role": "派蒙",
          "text": "喂喂，等一下，怎么会有只给一个人使用的剑呀？"
        },
        {
          "role": "旅行者",
          "text": "该不会有什么副作用吧？"
        },
        {
          "role": "阿贝多",
          "text": "很敏锐嘛。这把剑确实不同寻常，它受到了某种诅咒。"
        },
        {
          "role": "阿贝多",
          "text": "寻常人完全无法使用这把单手剑，但你不一样。"
        },
        {
          "role": "派蒙",
          "text": "哎…？"
        },
        {
          "role": "阿贝多",
          "text": "可以说，这把被诅咒的剑唯独对你没有害处。既然如此，除了你我还能找谁帮忙呢？"
        },
        {
          "role": "阿贝多",
          "text": "多说无益，到附近找几只怪物吧。有些事，一试便知。"
        },
        {
          "type": "subtitle",
          "text": "带上神秘的剑去战斗"
        },
        {
          "type": "subtitle",
          "text": "击败史莱姆"
        },
        {
          "role": "凶恶的男人",
          "text": "找到了！就是那个小兔崽子拿着！"
        },
        {
          "role": "凶恶的男人",
          "text": "把东西交出来，小偷！"
        },
        {
          "role": "派蒙",
          "text": "盗宝团？这么冷的地方也会有盗宝团吗？"
        },
        {
          "role": "凶恶的男人",
          "text": "少废话！给我！"
        },
        {
          "role": "阿贝多",
          "text": "小心！"
        },
        {
          "type": "subtitle",
          "text": "击败盗宝团"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "派蒙",
          "text": "盗宝团居然叫我们小偷，明明他们自己才是小偷！"
        },
        {
          "role": "阿贝多",
          "text": "这些人来得可真快啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：阿贝多，你是小偷吗？",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "怎么可能。"
                }
              ]
            },
            {
              "text": "旅行者：不会是你偷了他们的东西吧？",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "怎么可能。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "他们说的东西，好像就是这把剑，到底是怎么回事呀？"
        },
        {
          "role": "阿贝多",
          "text": "你那是什么表情？我当然不可能去偷剑了。"
        },
        {
          "role": "阿贝多",
          "text": "不久前，骑士团在蒙德城外抓捕了一批盗宝团，他们非法搬运的赃物也被全数收缴。"
        },
        {
          "role": "阿贝多",
          "text": "这把剑就是其中之一。说是赃物，却没人认领，也不知从哪儿来的，一直丢在仓库里。"
        },
        {
          "role": "阿贝多",
          "text": "我去仓库拿东西的时候意外注意到了它。说真的，旧成这样的剑除了拿来做炼金材料恐怕别无他用。"
        },
        {
          "role": "派蒙",
          "text": "噫，怎么能把赃物说成是自己的东西呀！"
        },
        {
          "role": "派蒙",
          "text": "然后呢？你就把它拿走了？"
        },
        {
          "role": "阿贝多",
          "text": "嗯，我拿这把剑是想做实验用，却没想到，在调查过程中发现了它的真实来历。"
        },
        {
          "role": "阿贝多",
          "text": "这把看似老旧的武器出自某位已故铁匠之手，是传说中的魔剑。"
        },
        {
          "role": "派蒙",
          "text": "魔剑？！"
        },
        {
          "role": "阿贝多",
          "text": "据说，铁匠在铸剑后不久便失踪，剑也下落不明。"
        },
        {
          "role": "阿贝多",
          "text": "根据赃物来源反推，它多半是被盗宝团偷走，由此失传至今。"
        },
        {
          "role": "派蒙",
          "text": "啊！造剑的人失踪了？！好可怕！"
        },
        {
          "role": "派蒙",
          "text": "怪不得是被诅咒的魔剑！"
        },
        {
          "role": "阿贝多",
          "text": "没错。"
        },
        {
          "role": "旅行者",
          "text": "人类竟然能造出这样的魔剑…"
        },
        {
          "role": "阿贝多",
          "text": "你知道关于「杜林」和这座雪山的事吗？"
        },
        {
          "role": "阿贝多",
          "text": "「杜林」，就是数百年前「风神巴巴托斯」与「特瓦林」联手击败的、威胁蒙德的黑龙。"
        },
        {
          "role": "阿贝多",
          "text": "激战最后，被打败的杜林从空中坠落，跌入了茫茫白雪。"
        },
        {
          "role": "阿贝多",
          "text": "雪山上的积雪终年不化，是一件非常奇妙的事。杜林落在这里，究竟是偶然还是必然？"
        },
        {
          "role": "派蒙",
          "text": "还能是必然吗？"
        },
        {
          "role": "阿贝多",
          "text": "选择雪山作为坟场，说不定是想利用这种冰封一切的力量来抑制杜林身上的腐殖之毒。"
        },
        {
          "role": "阿贝多",
          "text": "巴巴托斯那样的神明，应该能想到这一办法才对。"
        },
        {
          "role": "派蒙",
          "text": "哇…巴巴托斯那么厉害的吗…"
        },
        {
          "role": "阿贝多",
          "text": "这些只是我的猜测，并没有依据。但可以确定，这座雪山与杜林有着千丝万缕的瓜葛。"
        },
        {
          "role": "阿贝多",
          "text": "而你手中这把剑的材料里，应该就有杜林的残骸。"
        },
        {
          "role": "派蒙",
          "text": "龙的残骸？！"
        },
        {
          "role": "阿贝多",
          "text": "嗯。将死去的龙的眼睛、指甲、鳞片……磨成粉末涂抹到剑身上。"
        },
        {
          "role": "阿贝多",
          "text": "这样一来，杜林的污秽与毒便能融入剑中，成为剑的威力来源。"
        },
        {
          "role": "阿贝多",
          "text": "这是非常高超的工艺，铁匠在铸剑成功后，一定会因为喜悦而亲自试剑。"
        },
        {
          "role": "阿贝多",
          "text": "只要他使用这把剑来战斗，剑上的污秽之力就会顺着剑柄传入他体内。"
        },
        {
          "role": "阿贝多",
          "text": "常人无法抵抗这种力量，因诅咒而精神错乱的铁匠四处疯逃，说不定，就在某处遭遇了不测。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "阿贝多",
          "text": "你净化过特瓦林的泪滴，有着极为罕见的力量。"
        },
        {
          "role": "阿贝多",
          "text": "这份力量确保了你不仅不会被污秽和毒性腐蚀，还能彻底消除它们的危险性。"
        },
        {
          "role": "阿贝多",
          "text": "所以，只有你能好好地使用这把剑了。"
        },
        {
          "role": "派蒙",
          "text": "话虽如此，这把剑果然还是太…呀！"
        },
        {
          "role": "派蒙",
          "text": "它、它好像在发光？"
        },
        {
          "role": "阿贝多",
          "text": "对我来说，这正是实验开始的信号。"
        },
        {
          "role": "阿贝多",
          "text": "这把剑现在还很弱，可它能吸收力量，通过这种方法，它会不断增强自身。"
        },
        {
          "role": "阿贝多",
          "text": "从某种意义上说，也算是「活物」。"
        },
        {
          "role": "阿贝多",
          "text": "旅行者，拿着它尽情冒险吧，我需要你来让它不断成长。"
        },
        {
          "role": "阿贝多",
          "text": "相信在不久的将来，一切推论都会得到验证。"
        }
      ]
    }
  ]
}