{
  "quest_id": 71815,
  "chapter_num": null,
  "chapter_title": "轻策来客",
  "type": "wq",
  "route": "Guests in Qingce",
  "stories": [
    {
      "story_id": 71815,
      "title": "轻策来客",
      "description": "",
      "dialogues": [
        {
          "role": "望雅",
          "text": "这下就准备得差不多了…"
        },
        {
          "role": "旅行者",
          "text": "你要去做什么？"
        },
        {
          "role": "望雅",
          "text": "咦？旅行者，你怎么来这里了…"
        },
        {
          "role": "望雅",
          "text": "你还记得，上次我请了清昼和伯桓子同去轻策庄的事吧。"
        },
        {
          "role": "望雅",
          "text": "清昼和伯桓子已经先去轻策庄了，如果你想去看看的话就过去吧。"
        },
        {
          "role": "望雅",
          "text": "我还要在这里处理最后一件事，处理好了之后，我也会去轻策庄的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "总感觉，你有处理不完的事…",
            "总感觉，你海灯节忙个不停…"
          ]
        },
        {
          "role": "旅行者",
          "text": "总感觉，你有处理不完的事…"
        },
        {
          "role": "望雅",
          "text": "啊…这也是没办法的事，海灯节期间，总务司要处理的事格外多。"
        },
        {
          "role": "望雅",
          "text": "今天是因为总务司要往另外一个地方发节日物资，要在望舒客栈做中转。"
        },
        {
          "role": "望雅",
          "text": "我正好在这里，就帮他们盯一会…"
        },
        {
          "role": "望雅",
          "text": "你先去轻策庄吧，等他们来了，我帮他们把物资清点一下就过来，应该花不了太多时间。"
        },
        {
          "role": "若心",
          "text": "嗯…不错，这字真不错，您这一手字，是我见过最好的了。"
        },
        {
          "role": "伯桓子",
          "text": "哈哈哈，您客气了，我也只会这么一手而已…您还要写什么？"
        },
        {
          "role": "旅行者",
          "text": "你已经在写了吗？"
        },
        {
          "role": "伯桓子",
          "text": "是你啊，我才刚过来不久。要我帮忙写字的人还挺多的，我得抓紧点时间。"
        },
        {
          "role": "伯桓子",
          "text": "清昼也过来了，你来的时候看见他了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "没有看见…",
            "他没和你一起吗？"
          ]
        },
        {
          "role": "旅行者",
          "text": "没有看见…"
        },
        {
          "role": "伯桓子",
          "text": "唔…我们俩一起来的轻策庄，但他一直是一副发愁的样子。"
        },
        {
          "role": "伯桓子",
          "text": "我问他有什么烦心事，他只是说没有灵感，还一个劲地叹气。"
        },
        {
          "role": "伯桓子",
          "text": "进了轻策庄之后，我去帮人写字，他说想自己四处逛逛，我们两个就分开了。"
        },
        {
          "role": "伯桓子",
          "text": "你要是想找他的话，就去找其他人问问吧。"
        },
        {
          "role": "伯桓子",
          "text": "然后你再顺便帮我送几盏写好了字的霄灯吧，要送的人我给你标好…"
        },
        {
          "role": "伯桓子",
          "text": "我接着在这里写字，这些霄灯就拜托你了。"
        },
        {
          "role": "鬼伯伯",
          "text": "你好，年轻人，有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于伯桓子写好字的霄灯…"
        },
        {
          "role": "鬼伯伯",
          "text": "噢…对，我是拜托那位先生写了一盏霄灯，这就是吗？"
        },
        {
          "role": "鬼伯伯",
          "text": "真不错…谢谢你帮忙拿过来，等会我也要去谢谢那位先生去。"
        },
        {
          "role": "旅行者",
          "text": "请问你看见清昼了吗？"
        },
        {
          "role": "鬼伯伯",
          "text": "清昼…你是说那大诗人吗？我看见了，他之前来过这里，皱着眉头，不知道在想什么呢。"
        },
        {
          "role": "鬼伯伯",
          "text": "唔…再多我就不知道了，你再去找别人问问吧。"
        },
        {
          "role": "路爷",
          "text": "欢迎来到「范木堂」，有什么要定制的吗？"
        },
        {
          "role": "旅行者",
          "text": "关于伯桓子写好字的霄灯…"
        },
        {
          "role": "路爷",
          "text": "已经写好了？我看看…"
        },
        {
          "role": "路爷",
          "text": "哎哟，真不错，这字写得真不错…"
        },
        {
          "role": "旅行者",
          "text": "请问你看见清昼了吗？"
        },
        {
          "role": "路爷",
          "text": "你说那个诗人啊，我之前遇见他了，我记得…他是和几个孩子出去了。"
        },
        {
          "role": "路爷",
          "text": "再具体的事我就不清楚了，你要找他的话，再去问问别人吧。"
        },
        {
          "role": "寒锋",
          "text": "你好，你找我有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于伯桓子写好字的霄灯…"
        },
        {
          "role": "寒锋",
          "text": "已经写好了？我看看…"
        },
        {
          "role": "寒锋",
          "text": "哎，真好，那位先生写字可真有一手…"
        },
        {
          "role": "旅行者",
          "text": "请问你看见清昼了吗？"
        },
        {
          "role": "寒锋",
          "text": "清昼？我看见了，他刚才和几个孩子路过这里。"
        },
        {
          "role": "寒锋",
          "text": "说是…要出去玩点什么，我还奇怪了，这个大诗人能和孩子们玩什么…"
        },
        {
          "role": "寒锋",
          "text": "你往那边走走吧，应该很容易就能找到他。"
        },
        {
          "role": "清昼",
          "text": "如此…不行，要再精巧点才是…"
        },
        {
          "role": "清昼",
          "text": "不对…不对不对，太晦涩了些，只怕看着没有半点趣味…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么呢？"
        },
        {
          "role": "清昼",
          "text": "是你啊，我正在给这些孩子们想「灯谜」呢。"
        },
        {
          "role": "旅行者",
          "text": "灯…什么？"
        },
        {
          "role": "清昼",
          "text": "你不知道吗？唔，算是一个小游戏吧。"
        },
        {
          "role": "清昼",
          "text": "就是在每盏霄灯上写一小段谜语，谁猜对了谜语，这盏霄灯就归谁。"
        },
        {
          "role": "清昼",
          "text": "我正在想这三首灯谜，那些孩子们还非要给这些灯谜加点「彩头」…"
        },
        {
          "role": "清昼",
          "text": "呵呵，「彩头」…也不知道这个词是谁教他们的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那你和梵米尔的比试怎么办？",
            "你还记得你和梵米尔约定的比试吗？"
          ]
        },
        {
          "role": "旅行者",
          "text": "那你和梵米尔的比试怎么办？"
        },
        {
          "role": "清昼",
          "text": "比试…唉，说来惭愧，从约定好比试的那一天起，我就在不停思索…"
        },
        {
          "role": "清昼",
          "text": "到底什么样的诗，才能同时概括璃月港和海灯节，我无论如何都找不到一丝灵感…"
        },
        {
          "role": "清昼",
          "text": "我之所以接受了望雅的邀请，也是因为想要来这里再取取材，看看能不能找到灵感。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你要用猜灯谜来取材吗？",
            "在这里真的能取到材吗…"
          ]
        },
        {
          "role": "旅行者",
          "text": "你要用猜灯谜来取材吗？"
        },
        {
          "role": "清昼",
          "text": "哈哈哈，不需为我担心，如果写不出来，那就是我诗才有限。"
        },
        {
          "role": "清昼",
          "text": "不过，这些灯谜倒是和取材没有关系。"
        },
        {
          "role": "清昼",
          "text": "我看这群孩子们没有亲人陪伴，也没有机会外出游玩，明明是海灯节，这里却始终缺了点节日气息…"
        },
        {
          "role": "清昼",
          "text": "所以我就想要写几段灯谜，来陪他们玩玩，这样也算是有些过节的氛围。"
        },
        {
          "role": "清昼",
          "text": "先不说这些了，我刚才已经想好了三首灯谜，现在要做三盏霄灯才好…"
        },
        {
          "role": "清昼",
          "text": "旅行者，能拜托你帮我取三份做霄灯的材料来吗？"
        },
        {
          "role": "清昼",
          "text": "你搜集好三份制作霄灯的材料了吗？"
        },
        {
          "role": "清昼",
          "text": "嗯，不错，稍等…我把霄灯做好，再把灯谜写上。"
        },
        {
          "role": "清昼",
          "text": "好了，这样就可以了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这霄灯…",
            "你还有这手艺…"
          ]
        },
        {
          "role": "旅行者",
          "text": "这霄灯…"
        },
        {
          "role": "清昼",
          "text": "嗨…璃月人谁不会编个霄灯，我这编霄灯的手艺也只能算是一般水平…"
        },
        {
          "role": "清昼",
          "text": "那群孩子们已经过去猜灯谜了，你要有兴趣的话，也过去看看吧。"
        },
        {
          "role": "灯谜",
          "text": "「竹骨石肌一身轻，不听菱歌听衡经。」"
        },
        {
          "role": "灯谜",
          "text": "「莫道此生沉黑海，身中自有大光明。」"
        },
        {
          "role": "派蒙",
          "text": "这、这就是灯谜吗？好难…你有什么头绪吗？"
        },
        {
          "role": "灯谜",
          "text": "「竹骨石肌一身轻，不听菱歌听衡经。」"
        },
        {
          "role": "灯谜",
          "text": "「莫道此生沉黑海，身中自有大光明。」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "水煮鱼。",
            "霄灯。",
            "派蒙。"
          ]
        },
        {
          "role": "旅行者",
          "text": "水煮鱼。"
        },
        {
          "role": "清昼",
          "text": "唔…猜得不对，还是再想想吧。"
        },
        {
          "role": "灯谜",
          "text": "「本由竹胎石胆造，登天照夜如日归。」"
        },
        {
          "role": "灯谜",
          "text": "「一声震得人方恐，回首相看已化灰。」"
        },
        {
          "role": "派蒙",
          "text": "咦？这个感觉还挺简单的，好好想想吧。"
        },
        {
          "role": "灯谜",
          "text": "「本由竹胎石胆造，登天照夜如日归。」"
        },
        {
          "role": "灯谜",
          "text": "「一声震得人方恐，回首相看已化灰。」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "霄灯。",
            "兔兔伯爵。",
            "爆竹。"
          ]
        },
        {
          "role": "旅行者",
          "text": "霄灯。"
        },
        {
          "role": "清昼",
          "text": "唔…猜得不对，还是再想想吧。"
        },
        {
          "role": "灯谜",
          "text": "「岩上万民仰能见，裹挟东风上云间。」"
        },
        {
          "role": "灯谜",
          "text": "「游丝一断浑无力，扑棱坠地懒拾捡。」"
        },
        {
          "role": "派蒙",
          "text": "呃，这个该怎么解啊…"
        },
        {
          "role": "灯谜",
          "text": "「岩上万民仰能见，裹挟东风上云间。」"
        },
        {
          "role": "灯谜",
          "text": "「游丝一断浑无力，扑棱坠地懒拾捡。」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "蒲公英。",
            "正在用风之翼滑翔的冒险家…",
            "风筝。"
          ]
        },
        {
          "role": "旅行者",
          "text": "蒲公英。"
        },
        {
          "role": "清昼",
          "text": "唔…猜得不对，还是再想想吧。"
        },
        {
          "role": "清昼",
          "text": "你能把三个灯谜都猜对，看来你确实也算得上才思敏捷。"
        },
        {
          "role": "清昼",
          "text": "啊…对了，虽然一般来说，要把霄灯送给猜对了灯谜的人，但这几盏霄灯我可不能送你…"
        },
        {
          "role": "清昼",
          "text": "要是我再编三盏霄灯，手非得废了不可，咳…这些东西给你，收下吧。"
        },
        {
          "role": "清昼",
          "text": "看那些孩子们意犹未尽的样子，看起来三个灯谜不够啊…我得再想几个灯谜才行。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那首诗的灵感…",
            "梵米尔说不定已经…"
          ]
        },
        {
          "role": "旅行者",
          "text": "那首诗的灵感…"
        },
        {
          "role": "清昼",
          "text": "……"
        },
        {
          "role": "清昼",
          "text": "不需担心，那首诗…只能算是我心中一点小意气，虚无缥缈。"
        },
        {
          "role": "清昼",
          "text": "但是这群孩子们，可是实打实地在等着我给他们出灯谜。"
        },
        {
          "role": "清昼",
          "text": "我先陪着这群孩子们玩个够，等那个画家来了，我会和他说的。"
        },
        {
          "role": "清昼",
          "text": "哦对了，看看时间，望雅应该也快到了，请你帮我去接一下她吧，我接着在这里给这群孩子们出灯谜。"
        },
        {
          "role": "望雅",
          "text": "总算是到了…旅行者？你看见清昼和伯桓子了吗？"
        },
        {
          "role": "旅行者",
          "text": "关于清昼和伯桓子…"
        },
        {
          "role": "望雅",
          "text": "这样啊…那太好了，我还担心我不来没人安排呢。"
        },
        {
          "role": "望雅",
          "text": "总务司那边要转运的货物实在是有点多，我帮忙点了半天才点好。"
        },
        {
          "role": "望雅",
          "text": "点好之后，我就马上往这边赶了，没想到还是到了这个时间才到…"
        },
        {
          "role": "望雅",
          "text": "不过听你说的，好像也不需要我安排什么了。"
        },
        {
          "role": "望雅",
          "text": "我等会再去找他们，我们先慢慢往上散会步吧。"
        },
        {
          "role": "望雅",
          "text": "轻策庄…其实我小时候也来过几次。"
        },
        {
          "role": "望雅",
          "text": "我还记得这里的豆腐很好吃，还有各种好玩的小木雕。"
        },
        {
          "role": "望雅",
          "text": "这周围的景色也很不错，之前不少人都觉得，在这里生活是一件不错的事。"
        },
        {
          "role": "旅行者",
          "text": "那为什么这里会…"
        },
        {
          "role": "望雅",
          "text": "对于…老人们来说，轻策庄确实是一个很闲适的地方，周围都是认识的人和熟悉的事物，不会怎么改变。"
        },
        {
          "role": "望雅",
          "text": "在这里呆着的时候，你有时候甚至会怀疑，时间是不是静止了。"
        },
        {
          "role": "望雅",
          "text": "不过，这里也许不是那么适合年轻人吧…"
        },
        {
          "role": "望雅",
          "text": "因为各种各样的原因，轻策庄里的年轻人大部分都去了璃月港里，只有老人和孩子们留在了这里。"
        },
        {
          "role": "旅行者",
          "text": "这到底是因为…"
        },
        {
          "role": "望雅",
          "text": "这件事的原因…可不是一两句话就能说清楚的。"
        },
        {
          "role": "望雅",
          "text": "我们再往前走走吧。"
        },
        {
          "role": "望雅",
          "text": "总之，不管原因是什么，轻策庄里逐渐只剩下了老人和孩子们。"
        },
        {
          "role": "望雅",
          "text": "逢年过节的时候，他们也很难真正地置办起节日的氛围，虽然总务司年年都会派人送物资过来，但是…"
        },
        {
          "role": "望雅",
          "text": "但是我们作为外人，能够为他们做的，也仅仅就到此为止了。"
        },
        {
          "role": "望雅",
          "text": "我想，他们真正需要的…也许是家人的陪伴吧。"
        },
        {
          "role": "望雅",
          "text": "如果没有亲人陪伴，那再多的娱乐和物资也…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "……",
            "亲人…"
          ]
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "望雅",
          "text": "啊！抱歉，因为我一直在接触这方面的事，不由自主地就感慨了起来，说了这么多沉重的事！"
        },
        {
          "role": "望雅",
          "text": "不管怎么说，有清昼、伯桓子还有你帮忙，今年的轻策庄可是热闹了不少呢。"
        },
        {
          "role": "望雅",
          "text": "再次感谢你愿意帮忙，旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那你怎么不回家去？",
            "那你家里的人…"
          ]
        },
        {
          "role": "旅行者",
          "text": "那你怎么不回家去？"
        },
        {
          "role": "望雅",
          "text": "我？我…我没办法啦，总务司在海灯节期间还要向很多地方分发物资，我还要再负责一部分…"
        },
        {
          "role": "望雅",
          "text": "有些偏远地方的名字，说不定你都没有听过呢。"
        },
        {
          "role": "望雅",
          "text": "而且不仅是我，我的很多同事现在也在「送霄灯」的路上呢。"
        },
        {
          "role": "望雅",
          "text": "把「霄灯」送出去，让所有人都能够感受到节日的氛围，这就是我们的愿望和职责。"
        },
        {
          "role": "望雅",
          "text": "至于我自己…哈哈哈，节日期间我是回不了家啦。"
        },
        {
          "role": "望雅",
          "text": "顶多是在海灯节快要结束的时候，追着节日的尾巴请几天假，回去陪陪家里人。"
        },
        {
          "role": "望雅",
          "text": "还好家里人都还算理解我，但这次回去，估计我妈妈又要唠叨我了…"
        },
        {
          "role": "望雅",
          "text": "好啦旅行者，我等会还要接着去工作，请你好好享受海灯节吧。"
        },
        {
          "role": "望雅",
          "text": "祝你海灯节玩得开心！"
        }
      ]
    }
  ]
}