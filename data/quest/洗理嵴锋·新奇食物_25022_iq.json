{
  "quest_id": 25022,
  "chapter_num": null,
  "chapter_title": "洗理嵴锋·新奇食物",
  "type": "iq",
  "route": "Tending to a Tepetlisaurus: In Search of a Recipe",
  "stories": [
    {
      "story_id": 25022,
      "title": "洗理嵴锋·新奇食物",
      "description": "卡兹加似乎正在尝试用全新的方法来照顾霍莱…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与卡兹加对话"
        },
        {
          "role": "卡兹加",
          "text": "嗯…看来是得换一个食谱了…"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜呜呜！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你又有什么主意了？",
              "dialogues": []
            },
            {
              "text": "（摸摸霍莱。）",
              "dialogues": [
                {
                  "role": "霍莱",
                  "text": "呜，呜！"
                }
              ]
            }
          ]
        },
        {
          "role": "卡兹加",
          "text": "呜，呜！"
        },
        {
          "role": "卡兹加",
          "text": "平时霍莱都能吃完一整盆果子，吃完之后能疯玩一整天。"
        },
        {
          "role": "卡兹加",
          "text": "现在它一盆水果只能吃一半多，而且吃完之后，就坐在旁边一动也不动…"
        },
        {
          "role": "卡兹加",
          "text": "我还以为它生病了，吓得连夜去找医生帮忙。"
        },
        {
          "role": "卡兹加",
          "text": "我们俩折腾了一整夜，终于确定霍莱什么病也没有，它就是…挑食了。"
        },
        {
          "role": "卡兹加",
          "text": "医生说，最好的解决方法就是给霍莱换一道新菜谱。"
        },
        {
          "role": "卡兹加",
          "text": "他还说，我也可以试试在霍莱吃饭的时候放点音乐。也许这样可以有助于霍莱提起食欲…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来还不错啊。",
              "dialogues": []
            },
            {
              "text": "还有这种唱片。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡兹加",
          "text": "哈哈哈…是啊，我当时确实找到了一张唱片，里面的音乐霍莱也很喜欢。"
        },
        {
          "role": "卡兹加",
          "text": "不过，当霍莱跳起来，一口咬掉了一半唱片之后…我就被迫放弃了这个计划。"
        },
        {
          "role": "卡兹加",
          "text": "毕竟对于嵴锋龙霍莱来说，用黑曜石和燃素做的唱片，本身就足够好吃了…"
        },
        {
          "role": "卡兹加",
          "text": "我现在也只能去「悬木人」那边找人帮忙，看能不能拿到一些新奇的食材了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我去帮你找些食材。",
              "dialogues": []
            },
            {
              "text": "我可太擅长找食材了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡兹加",
          "text": "你愿意帮忙？那再好不过了！「悬木人」的老兄也只能在纳塔找食材，你肯定能去纳塔外！"
        },
        {
          "role": "卡兹加",
          "text": "等会啊，我看看医生给我列的食材建议表，这位医生真是见多识广，对纳塔外的事都有些了解…"
        },
        {
          "role": "卡兹加",
          "text": "唔…上面写着，可以尝试<color=#00E1FFFF>「虹彩蔷薇」，「堇瓜」</color>和<color=#00E1FFFF>「清心」</color>。"
        },
        {
          "role": "卡兹加",
          "text": "那就拜托你了，找到新奇的食材之后，就直接拿过来给我吧。"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜呜！"
        },
        {
          "type": "subtitle",
          "text": "将食材带给霍莱"
        },
        {
          "type": "subtitle",
          "text": "与卡兹加对话"
        },
        {
          "role": "卡兹加",
          "text": "这花可真好看。名字也挺好听的…霍莱，你想试吃一下吗？"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜！"
        },
        {
          "role": "霍莱",
          "text": "（霍莱小心翼翼地嚼了嚼，仔细品尝着花瓣的味道。）"
        },
        {
          "role": "霍莱",
          "text": "呜，呜…"
        },
        {
          "role": "卡兹加",
          "text": "喔！看霍莱的样子，它还挺喜欢吃这个的。不过吃花可不能吃饱啊…"
        },
        {
          "role": "卡兹加",
          "text": "而且，这种花看上去就不太便宜啊…总之我先记下来好了。"
        },
        {
          "role": "卡兹加",
          "text": "花怎么做成食物呢？唔，要不然，把花包在饼里…？"
        },
        {
          "role": "卡兹加",
          "text": "对了！这些东西给你，就当做是谢礼吧。"
        },
        {
          "role": "卡兹加",
          "text": "有了你帮忙，我肯定能研究出一份最适合霍莱的食谱。"
        },
        {
          "role": "卡兹加",
          "text": "霍莱，你可要好好吃饱，好好长大喔。"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜呜，呜呜呜！"
        },
        {
          "type": "subtitle",
          "text": "与卡兹加对话"
        },
        {
          "role": "卡兹加",
          "text": "嗬！这果子还不小，看着就能吃饱。霍莱，你想试试吗？"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜！"
        },
        {
          "role": "霍莱",
          "text": "（霍莱大口地嚼着堇瓜，一会就全吃光了。）"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜呜呜！"
        },
        {
          "role": "卡兹加",
          "text": "哈哈哈，一下子就吃光了，你很喜欢这个吗？霍莱？"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜！呜呜——"
        },
        {
          "role": "卡兹加",
          "text": "好！那我过会就去找人问问，哪里有稻妻来的商人，得多买点堇瓜才行…"
        },
        {
          "type": "subtitle",
          "text": "与卡兹加对话"
        },
        {
          "role": "卡兹加",
          "text": "唔，这花闻着倒是不错，有一股清香…"
        },
        {
          "role": "卡兹加",
          "text": "霍莱？你…呜哇！已经吃下去了啊！"
        },
        {
          "role": "霍莱",
          "text": "（霍莱一口气吞下了清心，对着你们眨了眨眼…）"
        },
        {
          "role": "？？？",
          "text": "霍莱突然转过了身子，一口气吃完了旁边的半盆水果…"
        },
        {
          "role": "卡兹加",
          "text": "霍莱的食欲怎么突然这么好了？这种叫清心的东西，效果有这么好吗？"
        },
        {
          "role": "卡兹加",
          "text": "我，我得找医生去商量一下…"
        }
      ]
    }
  ]
}