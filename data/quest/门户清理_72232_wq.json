{
  "quest_id": 72232,
  "chapter_num": null,
  "chapter_title": "门户清理",
  "type": "wq",
  "route": "Clean House",
  "stories": [
    {
      "story_id": 72232,
      "title": "门户清理",
      "description": "珊瑚宫的巫女思鹤似乎有一份紧急委托，非旅行者不能完成…",
      "dialogues": [
        {
          "role": "思鹤",
          "text": "您好，旅行者。请问方便谈一些事情吗？"
        },
        {
          "role": "思鹤",
          "text": "实在抱歉打扰您，但事关重大…现人神巫女大人吩咐我一定要找到您才行。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕竟我是「剑鱼」二番队队长嘛。",
              "dialogues": [
                {
                  "role": "思鹤",
                  "text": "是这样没错，所以这件事情，相信您一定也能够漂亮完成。"
                }
              ]
            },
            {
              "text": "发生什么事了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "思鹤",
          "text": "多亏了您的倾力帮助，我们在与幕府的战争中逆转了劣势…按照当前的局面，长期停战应该是大势所趋。"
        },
        {
          "role": "思鹤",
          "text": "我们赢回了和平，扫除了「眼狩令」，而一直盘剥我们的恶奉行终于倒台…大御神的遗骨也获得了宁静，这些都多亏了您的努力。请容我再次感谢…"
        },
        {
          "role": "思鹤",
          "text": "但残余的愚人众势力仍然没有放弃在八酝岛四处探查。尽管他们在战争中失去了一个「执行官」，另一个「执行官」也不知所踪…"
        },
        {
          "role": "旅行者",
          "text": "关于愚人众…"
        },
        {
          "role": "思鹤",
          "text": "海祇岛长期信息闭塞，这场战争可以说制造了我们与这些家伙接触的缘由。以这样的方式相识，还真是糟糕…"
        },
        {
          "role": "思鹤",
          "text": "他们似乎是想要将这场战争拖成持久战，并且意图煽动起双方民众的仇恨，以此提升战争烈度…相比起幕府军，他们是更加危险的敌人。"
        },
        {
          "role": "思鹤",
          "text": "假如战争迁延日久，它所造成的严重经济匮乏与社会紧张，就会极大地方便「愚人众」在两方的夹缝中扩张自己的影响力。"
        },
        {
          "role": "思鹤",
          "text": "幸好现人神巫女大人及时发觉了他们的阴谋，以及您和许许多多将士们的奋战…我们才得以及时制止愚人众的计划。"
        },
        {
          "role": "旅行者",
          "text": "我需要做什么？"
        },
        {
          "role": "思鹤",
          "text": "根据我们的情报，仍有一些被愚人众渗透的幕府军军士潜伏在八酝岛，正搜集信息、密谋着什么。"
        },
        {
          "role": "思鹤",
          "text": "向您提出这样的请求实在是迫不得已，但现人神巫女大人认为您是处理此事最为保险的人选…所以还得劳烦您随我一同前往大御神殉身之处找那些家伙。"
        },
        {
          "role": "思鹤",
          "text": "首先由我进行言语沟通劝阻。如果他们仍执意挑起纷争、不愿悔改，那便烦请您使用武力说服。"
        },
        {
          "role": "旅行者",
          "text": "就这么简单？"
        },
        {
          "role": "思鹤",
          "text": "简单么？啊…不愧是您，对您而言，这或许就是举手之劳吧。"
        },
        {
          "role": "思鹤",
          "text": "但唯一的难点是…您太出名了，对方可能一眼就能认出来。事出突然，我们也没时间易容了…"
        },
        {
          "role": "旅行者",
          "text": "我有这个。"
        },
        {
          "role": "思鹤",
          "text": "好平直的伪装！"
        },
        {
          "role": "思鹤",
          "text": "唔…不过不知为什么，我也险些没认出来您呢。和作为「剑鱼」二番队队长的旅行者相比，确实在气质上有明显的不同…"
        },
        {
          "role": "思鹤",
          "text": "那就这样吧，准备好了就请随我出发。"
        },
        {
          "type": "subtitle",
          "text": "前往蛇骨矿洞，同幕府武士交涉。"
        },
        {
          "role": "蛮横的武士",
          "text": "留步，庶民！幕府辖地，无关人士速速离去！"
        },
        {
          "role": "思鹤",
          "text": "庶民？...我是珊瑚宫特使思鹤，来此巡查大御神殉身之所的现状。你的上司没有通知过你吗？"
        },
        {
          "role": "蛮横的武士",
          "text": "珊瑚宫的人…？没有，我从来没有接到过通知。请你们立刻离开！"
        },
        {
          "role": "思鹤",
          "text": "这与我们双方先前的停战协定不符，武士先生。请你报上名来，我会让你的上司知道你的无理。"
        },
        {
          "role": "蛮横的武士",
          "text": "抱歉，我不觉得有那个必要，珊瑚宫的小姐。"
        },
        {
          "role": "蛮横的武士",
          "text": "倒是你，最好不要再靠近矿洞了，如若继续挑衅…"
        },
        {
          "role": "蛮横的武士",
          "text": "那么，破坏停战的罪名不是一般人能承受的。"
        },
        {
          "role": "思鹤",
          "text": "没错，破坏停战的罪名不是一般人能承受得了的…正因如此，我才希望你们能停止亵渎神体，体面且安全地离开大御神殉身之地。"
        },
        {
          "role": "蛮横的武士",
          "text": "哈！「神体」！「殉身之地」！呸！"
        },
        {
          "role": "思鹤",
          "text": "没错。我们已经给了你们足够的时间，可以有组织地逐步撤离这里。"
        },
        {
          "role": "蛮横的武士",
          "text": "呵，你们海祇岛的人，说话太好笑了。"
        },
        {
          "role": "蛮横的武士",
          "text": "这就是你们打仗的目的吗？为了死去的神？但是你们的大蛇早就成了矿洞里那些亮晶晶的石头，成了我们的剑了！"
        },
        {
          "role": "蛮横的武士",
          "text": "曾经你们俯首大蛇，后来你们俯首在它的遗骨熔炼打造成的剑下，两种命运不都是差不多嘛？"
        },
        {
          "role": "思鹤",
          "text": "请注意你的言辞，武士。"
        },
        {
          "role": "蛮横的武士",
          "text": "既然不乐意追随将军殿下，我们也给了你们选择，对吧？作为听话的庶民活下去不好吗？"
        },
        {
          "role": "蛮横的武士",
          "text": "当年是将军殿下一时怜悯才留你们存活的，如此大恩不谢，如今居然还要对抗幕府…你们真的以为一时反逆能给你们带来什么好下场？"
        },
        {
          "role": "思鹤",
          "text": "……"
        },
        {
          "role": "蛮横的武士",
          "text": "哼，瞧瞧你们干的好事吧…借推翻「眼狩令」，你们夺去了多少人的生路？夺去了多少税源！没有了税源，你们又让我们吃什么！"
        },
        {
          "role": "蛮横的武士",
          "text": "如果不是柊大人因为你们而被废黜，我们这些体面武士怎会沦落至此！"
        },
        {
          "role": "蛮横的武士",
          "text": "我和你说这么多干什么…你们这些小岛上的穷酸乡巴佬，什么也不懂。"
        },
        {
          "role": "蛮横的武士",
          "text": "总之，我见到你们就烦，赶紧滚吧…除非你成心挑事。"
        },
        {
          "role": "思鹤",
          "text": "「柊大人」，是么…呵呵，我是不会破坏停战协议的…"
        },
        {
          "role": "思鹤",
          "text": "相反，现人神巫女大人交给我的任务，是清理掉企图破坏和平的家伙。"
        },
        {
          "role": "思鹤",
          "text": "旅行者，您可以动手了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "蛮横的武士",
                  "text": "什么…你怎么…敌袭！！"
                }
              ]
            },
            {
              "text": "可是…",
              "dialogues": [
                {
                  "role": "思鹤",
                  "text": "就是他了，总之请先将他制服！"
                },
                {
                  "role": "蛮横的武士",
                  "text": "果然，你…敌袭、敌袭！！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "击败蛮横的武士。"
        },
        {
          "type": "subtitle",
          "text": "阅读武士落下的字条。"
        },
        {
          "role": "工整的字条",
          "text": "（似乎是从账表中撕下的纸条，上面用工整的手写字体记录着蛇骨矿洞的勘察报告。）"
        },
        {
          "role": "工整的字条",
          "text": "（大部分内容与矿产分布状况、工业生产应用可行性和在此地建立前哨基地的可能性相关。）"
        },
        {
          "role": "工整的字条",
          "text": "（除此之外的内容则是有关雷电将军留下的雷元素镇物系统，与魔神残渣一旦泄漏可能造成的后果，并且附有对绯木村患者的观察记录。）"
        },
        {
          "role": "工整的字条",
          "text": "（最后部分记录了「特殊作战」的完成情况，以及落款：由一位化名为「内森」的愚人众成员所留。）"
        },
        {
          "role": "工整的字条",
          "text": "（在纸条的一侧还有一些细小文字：）"
        },
        {
          "role": "工整的字条",
          "text": "「…前来寻回此报告的愚人众新募人员，须尽快前往岛屿西侧港口，与接洽情报官会合。」"
        },
        {
          "role": "工整的字条",
          "text": "「口令为：『笑死我了』。」"
        },
        {
          "type": "subtitle",
          "text": "前往港口调查愚人众的踪迹。"
        },
        {
          "role": "？？？",
          "text": "止步！平民，为了你自己的安全，请离开这里。"
        },
        {
          "role": "思鹤",
          "text": "不好意思，我们不是平民。而且我们来这里是有原因的。"
        },
        {
          "role": "旅行者",
          "text": "我们是来接洽愚人众情报官的。"
        },
        {
          "role": "？？？",
          "text": "我不知道你们在说什么…这里是私人领地，请不要和我们搭话了。"
        },
        {
          "role": "思鹤",
          "text": "穿着这样过分浮夸的衣服，手里拿的武器既不像幕府军的装备、也不像珊瑚宫军的…"
        },
        {
          "role": "思鹤",
          "text": "看起来随时要跑路，一副不怀好意的样子…"
        },
        {
          "role": "思鹤",
          "text": "你们还是多在意一下伪装比较好。"
        },
        {
          "role": "？？？",
          "text": "我看起来像是会开玩笑的人吗？"
        },
        {
          "role": "思鹤",
          "text": "好了，不说笑了。我们是从蛇骨矿洞那边来的。旅行者，请证明给他看。"
        },
        {
          "role": "旅行者",
          "text": "笑死我了。"
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "role": "思鹤",
          "text": "……"
        },
        {
          "role": "？？？",
          "text": "欢迎加入愚人众，我是你们的接应人，海务准尉鲍连卡。今后你们要叫我「长官」，听懂了吗？"
        },
        {
          "role": "？？？",
          "text": "他们和我说，勘定奉行那些丢了官职、没了俸禄的前部属很快就会取到我们想要的东西…没想到只有你们两个。我还以为会有很多人呢。"
        },
        {
          "role": "？？？",
          "text": "一个是说话很不客气的巫女，还有一个是…外国人？"
        },
        {
          "role": "？？？",
          "text": "你们都不是武士吗？哼，柊慎介那家伙的用人眼光还真是有意思。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实如此。",
              "dialogues": []
            },
            {
              "text": "很难和你解释。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "…长官。"
        },
        {
          "role": "思鹤",
          "text": "我们之前进行了一些…管理层变动。所以你也明白，从结果上讲，有的人可以赢得新工作，有的人就只能落进海里，什么也留不下咯。"
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "role": "思鹤",
          "text": "…长官。"
        },
        {
          "role": "？？？",
          "text": "嗯，你说得对。我不关心你们之前发生了什么，我想要的只有结果。"
        },
        {
          "role": "？？？",
          "text": "把「内森」留下的报告交给我，然后上船。这是一个简单的命令，希望你们能够好好执行。"
        },
        {
          "role": "旅行者",
          "text": "就在这里了…长官。"
        },
        {
          "role": "？？？",
          "text": "很好。你们在这里的工作结束了，还有什么问题吗？"
        },
        {
          "role": "思鹤",
          "text": "我们之后还有什么任务吗，长官？"
        },
        {
          "role": "？？？",
          "text": "与我何干？我只负责把你们运回至冬国，之后的行动就要听从上面的意思了。"
        },
        {
          "role": "思鹤",
          "text": "上面没有透露任何消息吗，长官？"
        },
        {
          "role": "？？？",
          "text": "与你何干？"
        },
        {
          "role": "思鹤",
          "text": "你说得对，长官。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（可以动手了吗？）",
              "dialogues": []
            },
            {
              "text": "（我们还要继续和他过家家吗？）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "思鹤",
          "text": "（请您再等一会儿，我想试试看套些情报。）"
        },
        {
          "role": "？？？",
          "text": "我还在这里呢，你们两个在鬼鬼祟祟说什么呢？"
        },
        {
          "role": "思鹤",
          "text": "抱歉，关于将来需要我们执行的任务，许多细节我们还不清楚，请问长官可不可以为我们讲解？"
        },
        {
          "role": "？？？",
          "text": "我没有义务给你们讲解命令，留给你们的选择只有执行，或者被我教训一顿，然后执行！"
        },
        {
          "role": "思鹤",
          "text": "抱歉，或许你没有听明白。我的意思是…咳咳，请问你可不可以把你所知道的，全都毫无保留地告诉我们？"
        },
        {
          "role": "？？？",
          "text": "你是不是忘了什么，新兵…？"
        },
        {
          "role": "思鹤",
          "text": "我什么也没有忘记。"
        },
        {
          "role": "思鹤",
          "text": "相反，我什么都记得清清楚楚。我相信我身边的这位珊瑚宫将领也是如此。"
        },
        {
          "role": "？？？",
          "text": "你…珊瑚宫？！我就知道…！"
        },
        {
          "role": "思鹤",
          "text": "是啊，你可真了不起…不过我已经听烦你的话了！"
        },
        {
          "role": "思鹤",
          "text": "你们在八酝岛的秘密行动、你们煽动海祇岛激进派破坏镇物的罪证，你们勾结失主武士的证据…"
        },
        {
          "role": "思鹤",
          "text": "以及刚刚对一位珊瑚宫巫女的羞辱，我都记录在案。"
        },
        {
          "role": "思鹤",
          "text": "前面几个问题或许会作为外交事件进入珊瑚宫的备忘录。而最后的那个问题，我希望你能够亲自负责，「长官」。"
        },
        {
          "role": "思鹤",
          "text": "顺便，我一开始就忠告过了，你们还是多在意一下伪装比较好。"
        },
        {
          "role": "思鹤",
          "text": "请您动手吧，旅行者！"
        },
        {
          "type": "subtitle",
          "text": "击败鲍连卡与他的喽啰。"
        },
        {
          "role": "鲍连卡的「指令」",
          "text": "「…请务必尽快撤离，将寻回『内森』秘密报告的稻妻新兵交予首席执行官大人。」"
        },
        {
          "role": "鲍连卡的「指令」",
          "text": "「以此断绝后患，不可将八酝岛事件之内幕向任何方面透露。」"
        },
        {
          "role": "鲍连卡的「指令」",
          "text": "「新兵本身于『愚人众』之共同目标或无价值，亦无甚培养必要。但作为活体样本，于科学研究甚为方便。」"
        },
        {
          "type": "subtitle",
          "text": "与思鹤对话。"
        },
        {
          "role": "思鹤",
          "text": "有趣…他们竟然不惜牺牲掉任何知道这件事内情的人。「愚人众」是这样的组织吗…"
        },
        {
          "role": "旅行者",
          "text": "这一点也不有趣。"
        },
        {
          "role": "思鹤",
          "text": "和我们想法不同的外人，我都觉得是有趣的。只不过有的在好的意义上有趣，有的就不那么妙咯。"
        },
        {
          "role": "思鹤",
          "text": "啊，感谢您百忙之中抽出时间，帮现人神巫女大人解决这件小事。"
        },
        {
          "role": "思鹤",
          "text": "这位「内森」的把柄已经被我们完全掌握了，对「愚人众」的作战，我们算是扳下了一城。"
        },
        {
          "role": "旅行者",
          "text": "关于「内森」…"
        },
        {
          "role": "思鹤",
          "text": "那家伙自称蒙德人…或许真的是生在蒙德的愚人众成员也说不定。"
        },
        {
          "role": "思鹤",
          "text": "他就是「愚人众」可怕之处的最佳例证——并非通过正面作战，而是通过精明的内部分化来搅乱局面，从乱局中攫取利益。"
        },
        {
          "role": "思鹤",
          "text": "他们深知我们最急需克服的障碍就在我们自己之中…即使再有意抑制，以血复仇的恶念也是难以消灭的。"
        },
        {
          "role": "思鹤",
          "text": "于是，借着「义军」的伪装，容易引人共情的口号…和一颗冷酷的心，这位内森把军中最激进的圈子引向了绝路…"
        },
        {
          "role": "思鹤",
          "text": "而他自己却全身而退…我是说，险些。那家伙终究还是受到了惩罚…哼，就我个人而言，仅仅把他扔进暗牢里，这惩罚还太轻了。"
        },
        {
          "role": "旅行者",
          "text": "还有八酝岛的住民…"
        },
        {
          "role": "思鹤",
          "text": "还有八酝岛的住民。您也看过内森的报告了。在他眼中，住民的性命只是报表里简单的数据而已…"
        },
        {
          "role": "思鹤",
          "text": "这场灾难…说来惭愧，打乱了现人神巫女大人的规划，也让加剧冲突变得不可避免。"
        },
        {
          "role": "思鹤",
          "text": "但我们还是想办法挽回了人心，赢得了和平，幸存的我们所有人，都没有辜负那些牺牲者的意志…并且得以站在坚实的地面上亡羊补牢。"
        },
        {
          "role": "思鹤",
          "text": "「战争是苦泪之川，无舟可渡，纵横奔流。」"
        },
        {
          "role": "思鹤",
          "text": "这是我们氏族岛歌中的一句…现人神巫女大人之所以不喜欢战争，或许也是因为如此吧。"
        },
        {
          "role": "思鹤",
          "text": "可惜呀，哲平那小子没有福气同我们一起来见证这些…太可惜了。"
        },
        {
          "role": "思鹤",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "思鹤",
          "text": "咳咳…愚人众短期内或许还会来调查他们失踪的前哨，但应该不会蠢到随随便便来找珊瑚宫的麻烦了…"
        },
        {
          "role": "思鹤",
          "text": "当然，这种事情，还是现人神巫女大人比我看得更远些。"
        },
        {
          "role": "思鹤",
          "text": "总之…不说那些伤心事了，愚人众残党事件解决！"
        },
        {
          "role": "思鹤",
          "text": "啊，我知道有一处蒲烧鳗鱼不错，有时间一起去尝尝如何…「剑鱼」二番队的「长官」？"
        }
      ]
    }
  ]
}