{
  "quest_id": 71803,
  "chapter_num": null,
  "chapter_title": "冒险家协会的诸多事宜",
  "type": "wq",
  "route": "The Adventurers' Guild's Affairs",
  "stories": [
    {
      "story_id": 71803,
      "title": "冒险家协会的诸多事宜",
      "description": "岚姐似乎正因为冒险家协会承接的一些委托而发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "打倒丘丘岩盔王"
        },
        {
          "role": "岚姐",
          "text": "<color=#00E1FFFF>灰灰</color>…特征描述倒是很详细，但走失在野外，肯定也不好找了…"
        },
        {
          "type": "subtitle",
          "text": "与奇怪的小猫交流"
        },
        {
          "role": "灰灰",
          "text": "喵…"
        },
        {
          "role": "派蒙",
          "text": "咦？怎么有只小猫在这里，难道刚才的叫声是它发出来的？"
        },
        {
          "role": "灰灰",
          "text": "喵…喵…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "灰色的小猫…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "灰色的小猫…走失在野外…"
                },
                {
                  "role": "派蒙",
                  "text": "啊！岚姐之前提到了一个找猫的委托…难道它就是那只猫？好像是叫灰灰还是什么的…"
                },
                {
                  "role": "派蒙",
                  "text": "没想到会在这里找到它…它难道一直躲在这附近吗？"
                }
              ]
            },
            {
              "text": "难道它就是灰灰…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "灰色的小猫…走失在野外…"
                },
                {
                  "role": "派蒙",
                  "text": "啊！是岚姐之前提到的那个委托，居然会在这里发现它…难道它一直躲在这附近？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "因为丘丘岩盔王在这里的原因，也没有人敢过来找它…它也不敢出去，只能一直躲在这里。"
        },
        {
          "role": "派蒙",
          "text": "还好我们过来了，不然它不知道还要在这里待到什么时候。"
        },
        {
          "role": "灰灰",
          "text": "喵…喵喵！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "喵…喵…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂，你在做什么啊，这样子它也听不懂的吧？"
                },
                {
                  "role": "派蒙",
                  "text": "我们把它带回去给岚姐好了，让她把灰灰还给委托人吧。"
                }
              ]
            },
            {
              "text": "带回去给岚姐吧…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，也只有这样了。把灰灰带回去给岚姐，让岚姐把它还给委托人吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "灰灰",
          "text": "喵…喵！喵！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "喵…喵！喵！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你再怎么学它，它也听不懂啦！我们快点把它带回去吧。"
                }
              ]
            },
            {
              "text": "它好像也答应了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你是怎么听懂的啦…算了，那我们快点把它带回去吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "将灰灰带给岚姐"
        },
        {
          "role": "岚姐",
          "text": "你把丘丘岩盔王打倒了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "已经打倒了。",
              "dialogues": [
                {
                  "role": "岚姐",
                  "text": "辛苦你了，完成了这项委托，应该就能证明协会的实力…"
                }
              ]
            },
            {
              "text": "已经打倒了，还找到了灰灰…",
              "dialogues": [
                {
                  "role": "岚姐",
                  "text": "辛苦你…什么？"
                }
              ]
            }
          ]
        },
        {
          "role": "灰灰",
          "text": "喵喵…喵？"
        },
        {
          "role": "岚姐",
          "text": "这只猫是…"
        },
        {
          "role": "旅行者",
          "text": "也许是灰灰。"
        },
        {
          "role": "岚姐",
          "text": "稍等，我把那份委托拿出来，对比一下特征。"
        },
        {
          "role": "岚姐",
          "text": "我看看…"
        },
        {
          "role": "岚姐",
          "text": "大部分都符合…看来它确实是那份委托要找的猫。"
        },
        {
          "role": "旅行者",
          "text": "委托人会很高兴的。"
        },
        {
          "role": "岚姐",
          "text": "呼…兜兜转转一大圈，居然又转回了找猫这种委托。"
        },
        {
          "role": "岚姐",
          "text": "真是让人不知道说什么好…"
        },
        {
          "role": "岚姐",
          "text": "我会把这两份委托分别向委托人报告，辛苦你了，这是报酬，请收下。"
        },
        {
          "role": "岚姐",
          "text": "但那份找猫的委托…委托人似乎已经搬家了，联系到他们也许还需要一点时间。"
        },
        {
          "role": "岚姐",
          "text": "在委托人过来之前，这个小家伙，就由我先照顾着吧。"
        },
        {
          "role": "灰灰",
          "text": "喵喵，喵！"
        }
      ]
    }
  ]
}