{
  "quest_id": 75247,
  "chapter_num": null,
  "chapter_title": "欢聚总在寻觅后",
  "type": "wq",
  "route": "All Good Reunions Follow a Search",
  "stories": [
    {
      "story_id": 75247,
      "title": "欢聚总在寻觅后",
      "description": "经过一番寻找，你与派蒙来到了画片所指的地点…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "看来画片上的地方就是这里了，他俩都在呢！"
        },
        {
          "role": "派蒙",
          "text": "你们好——！"
        },
        {
          "role": "欧洛伦",
          "text": "听声调是「高兴」的派蒙，太好了，不用警惕。"
        },
        {
          "role": "旅行者",
          "text": "「生气」的派蒙也不用警惕。"
        },
        {
          "role": "派蒙",
          "text": "可恶！瞧不起谁呢！"
        },
        {
          "role": "旅行者",
          "text": "喂她点好吃的就行了。"
        },
        {
          "role": "派蒙",
          "text": "哼，这还差不多嘛…不对，怎么说得我跟咔库库似的！"
        },
        {
          "role": "派蒙",
          "text": "算了，派蒙今天是「高兴」的派蒙，不跟你们计较啦。"
        },
        {
          "role": "派蒙",
          "text": "说到这个，咔库库呢？不会被豚兽大王吃掉了吧？"
        },
        {
          "role": "伊法",
          "text": "怎么可能。哥们，听听你说的…"
        },
        {
          "role": "欧洛伦",
          "text": "咔库库正在和敌方联手欺负我们。"
        },
        {
          "role": "派蒙",
          "text": "哈哈哈，说是咔库库在「欺负」他们呢，欧洛伦又在说笑…"
        },
        {
          "role": "欧洛伦",
          "text": "我不是在开玩笑。"
        },
        {
          "role": "派蒙",
          "text": "欸？"
        },
        {
          "role": "旅行者",
          "text": "那么敌方是…？"
        },
        {
          "role": "欧洛伦",
          "text": "它说它叫「咔阿夏」。"
        },
        {
          "role": "派蒙",
          "text": "谁？真的吗？阿夏会说话？"
        },
        {
          "role": "伊法",
          "text": "停停，你们别听他胡编，还是我来说吧。"
        },
        {
          "role": "伊法",
          "text": "咔库库呢…呃，正在和这里遇到的阿夏一起玩捉迷藏。"
        },
        {
          "role": "欧洛伦",
          "text": "准确来说，是和「咔阿夏」结盟一起对付我俩。"
        },
        {
          "role": "欧洛伦",
          "text": "咔库库行动很快，「咔阿夏」又很会伪装，是棘手的敌人。"
        },
        {
          "role": "伊法",
          "text": "你俩出现前，我们都陪这两个小东西玩过好多好多轮了。"
        },
        {
          "role": "伊法",
          "text": "咔库库的确很厉害，但我的心情已经从一开始的骄傲，变得不那么精神了…"
        },
        {
          "role": "欧洛伦",
          "text": "只能怪你自己不去上伊安珊的健身课。"
        },
        {
          "role": "伊法",
          "text": "哎呦，一直得上上下下地寻找，我腰很痛欸！"
        },
        {
          "role": "欧洛伦",
          "text": "对啊，这就是要怪你自己不去上伊安珊的健身课。"
        },
        {
          "role": "伊法",
          "text": "…好好，结束这里的工作我就去，好吧！"
        },
        {
          "role": "派蒙",
          "text": "停停，你俩谁也别说谁了！说到底，现在是谁在负责抓咔库库和「咔阿夏」呢？"
        },
        {
          "role": "欧洛伦",
          "text": "哦！这就要说到我们眼前这个完美的台阶…"
        },
        {
          "role": "旅行者",
          "text": "又我是吧？"
        },
        {
          "role": "欧洛伦",
          "text": "嗯嗯。"
        },
        {
          "role": "旅行者",
          "text": "行，我行我上。"
        },
        {
          "role": "欧洛伦",
          "text": "爷爷一定能行！派蒙奶奶也行！"
        },
        {
          "role": "伊法",
          "text": "不用勉强哦，要帮忙的话叫我们。"
        },
        {
          "role": "欧洛伦",
          "text": "欸，我以为我俩要做阿夏的？"
        },
        {
          "role": "派蒙",
          "text": "做阿夏…意思是你们也要躲起来等我们去找吗？"
        },
        {
          "role": "欧洛伦",
          "text": "嗯！从现在开始我是欧阿夏，他是伊阿夏。走咯，加油！"
        },
        {
          "role": "伊法",
          "text": "欸你这…！"
        },
        {
          "role": "伊法",
          "text": "抱歉啦，就配合他们一下吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小事，还挺好玩的。",
              "dialogues": []
            },
            {
              "text": "别担心，我精力充沛。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊法",
          "text": "那就拜托二位了，不胜感激。"
        },
        {
          "type": "subtitle",
          "text": "玩一场惊险刺激的捉迷藏"
        },
        {
          "type": "subtitle",
          "text": "与众人会合"
        },
        {
          "role": "派蒙",
          "text": "呼啊…结束了结束了，还真是挺辛苦的呢。"
        },
        {
          "role": "「咔阿夏」",
          "text": "♪"
        },
        {
          "role": "派蒙",
          "text": "是咔阿夏对吧？你和咔库库真的很厉害哦，这是来自对手的肯定！"
        },
        {
          "role": "咔库库",
          "text": "厉害啊，哥们！"
        },
        {
          "role": "欧洛伦",
          "text": "你看，我没说错吧，它俩联起手来真的很难对付。"
        },
        {
          "role": "欧洛伦",
          "text": "咔库库，现在给你颁发「隐身术」毕业证书，以后你就是一位成熟的欺诈师了。"
        },
        {
          "role": "咔库库",
          "text": "天哪哥们！还是你最好，哥们！"
        },
        {
          "role": "伊法",
          "text": "那我呢，我呢？我可是陪你玩了最多次数的人。"
        },
        {
          "role": "咔库库",
          "text": "你也好，哥们！"
        },
        {
          "role": "「咔阿夏」",
          "text": "♪~"
        },
        {
          "role": "伊法",
          "text": "唔…好像是有什么东西要给我们…"
        },
        {
          "role": "？？？",
          "text": "在众人和龙的瞩目中，「咔阿夏」翻出了一颗「闪闪礼蛋」…"
        },
        {
          "role": "伊法",
          "text": "喔！又是「闪闪礼蛋」和新的画片。这个标志，好像在悠悠集市见过…"
        },
        {
          "role": "伊法",
          "text": "嗯…我开始觉得这是什么接力挑战了。"
        },
        {
          "role": "欧洛伦",
          "text": "是度假村的隐藏玩法吗？我必须加入。"
        },
        {
          "role": "咔库库",
          "text": "哥们加入！"
        },
        {
          "role": "派蒙",
          "text": "看起来咔库库玩得超开心呢。"
        },
        {
          "role": "派蒙",
          "text": "好嘛，既然如此，肯定也不能少了我和旅行者！怎么样，我们也去看看？"
        },
        {
          "role": "旅行者",
          "text": "必须加入！"
        },
        {
          "role": "伊法",
          "text": "好，那就这么办。"
        },
        {
          "type": "subtitle",
          "text": "前往悠悠集市"
        },
        {
          "role": "欧洛伦",
          "text": "找到了，真的在悠悠集市！"
        },
        {
          "role": "咔库库",
          "text": "悠悠集市！！"
        },
        {
          "role": "伊法",
          "text": "冷静，哥们，虽然能看出你是真的很开心，但我们还是得先搞清楚状况…"
        },
        {
          "role": "察尔瓦",
          "text": "咳咳…尊贵的客人请留步，「闪闪礼蛋」，好运相伴！"
        },
        {
          "role": "察尔瓦",
          "text": "诸位可以免费体验，要不要试试手运？"
        },
        {
          "role": "派蒙",
          "text": "原来是给我们指引到了「闪闪礼蛋」的发源地呀。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，不知道好运的祝福还能不能持续到现在，我们试试看吧！"
        },
        {
          "role": "察尔瓦",
          "text": "请、请务必！礼蛋都已经准备好了。"
        },
        {
          "role": "欧洛伦",
          "text": "唔？"
        },
        {
          "role": "欧洛伦",
          "text": "你先来。"
        },
        {
          "role": "伊法",
          "text": "哥们，你不会真以为第一个吃螃蟹的人会吃亏吧。我来就我来。"
        },
        {
          "role": "伊法",
          "text": "阿夏保佑，好运连连！"
        },
        {
          "role": "派蒙",
          "text": "哇，是美味的龙龙饼干！"
        },
        {
          "role": "伊法",
          "text": "呃…"
        },
        {
          "role": "欧洛伦",
          "text": "噗…！"
        },
        {
          "role": "派蒙",
          "text": "欸，伊法不喜欢龙龙饼干吗？"
        },
        {
          "role": "欧洛伦",
          "text": "龙龙饼干非常好，伊法和我都很喜欢。但在「闪闪礼蛋」里，只能算是比较普通的奖品。"
        },
        {
          "role": "伊法",
          "text": "算啦算啦，只要好吃就是合格的饼干，大家一起分一分。"
        },
        {
          "role": "伊法",
          "text": "你也别光顾着看我的笑话，等下小心自己开到奇怪的乌乌黑蛋。我可不会救你！"
        },
        {
          "role": "欧洛伦",
          "text": "不可能，你忍不住的。"
        },
        {
          "role": "欧洛伦",
          "text": "嗯…开「闪闪礼蛋」前，需要什么特殊的仪式吗？"
        },
        {
          "role": "旅行者",
          "text": "用你觉得会带来好运的方式。"
        },
        {
          "role": "欧洛伦",
          "text": "明白了。「花羽会巡逻队，开门！」"
        },
        {
          "role": "伊法",
          "text": "？"
        },
        {
          "role": "派蒙",
          "text": "天哪，是花羽会特产「纵声欢唱」…他的祈祷仪式竟然奏效了…"
        },
        {
          "role": "欧洛伦",
          "text": "真走运。其实只要不是奇瑰之汤对我来说都算赢，那个实在喝腻了…"
        },
        {
          "role": "欧洛伦",
          "text": "好大一罐糖啊，大家也分一分吧。"
        },
        {
          "role": "咔库库",
          "text": "还是你最好，哥们！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "吃完饼干又吃糖，咔库库嚼得嘎嘣响。",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "甜度确实有些超标，大家都有点精神亢奋…"
                }
              ]
            },
            {
              "text": "该我啦该我啦！想想我该说点什么…有了有了！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "咳咳…「开大奖，怎么想都能开大奖吧！」"
                },
                {
                  "role": "派蒙",
                  "text": "咦…啊！是欧洛伦不想要的「奇瑰之汤」…"
                },
                {
                  "role": "欧洛伦",
                  "text": "太好了，派蒙！这杯都是你的了！"
                },
                {
                  "role": "派蒙",
                  "text": "也是哦？嘿嘿，那我不客气啦。"
                },
                {
                  "role": "派蒙",
                  "text": "凉凉的甜甜的，在这个季节喝正好呢！"
                },
                {
                  "role": "伊法",
                  "text": "好，接下来…你俩谁先？"
                },
                {
                  "role": "咔库库",
                  "text": "不急，哥们！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "我来吧。",
                      "dialogues": []
                    },
                    {
                      "text": "请咔库库压轴。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "上啊！快想个运气超好的口号来！"
                },
                {
                  "role": "旅行者",
                  "text": "（说到运气超好…）"
                },
                {
                  "role": "旅行者",
                  "text": "（吸气——）"
                },
                {
                  "role": "旅行者",
                  "text": "「班尼冒险团，出发！」"
                },
                {
                  "role": "派蒙",
                  "text": "「宝石闪闪」…我的天，又是甜甜的东西呢！"
                },
                {
                  "role": "旅行者",
                  "text": "嘿嘿，仿佛又回到了收徒的那天…"
                },
                {
                  "role": "欧洛伦",
                  "text": "看来运气不错，爷爷完全沉浸在了美好回忆里…"
                },
                {
                  "role": "伊法",
                  "text": "好了咔库库，来吧，是时候展现你的实力了。"
                },
                {
                  "role": "欧洛伦",
                  "text": "不要输，哥们！至少不要输给伊法。"
                },
                {
                  "role": "伊法",
                  "text": "什么意思嘛。"
                },
                {
                  "role": "咔库库",
                  "text": "来了，哥们！「幸会，哥们！」"
                },
                {
                  "role": "派蒙",
                  "text": "哇…这是什么！"
                },
                {
                  "role": "咔库库",
                  "text": "砰砰，砰砰！"
                },
                {
                  "role": "察尔瓦",
                  "text": "哦我的天哪！"
                },
                {
                  "role": "察尔瓦",
                  "text": "咳咳…「闪闪礼蛋」，好运相伴！恭喜这位咔库库先生成为了今天第三位抽到大奖的客人！"
                },
                {
                  "role": "察尔瓦",
                  "text": "除了这份最稀有的「小小阿夏包」，我们还将为咔库库先生奉上「闪闪礼蛋」里能开出的所有品种料理各一份！"
                },
                {
                  "role": "咔库库",
                  "text": "不会吧哥们！"
                },
                {
                  "role": "派蒙",
                  "text": "不会吧哥们！咔库库难道才是我们之中潜在的好运大王吗？"
                },
                {
                  "role": "伊法",
                  "text": "哈哈。祝贺你啊，哥们。"
                },
                {
                  "role": "欧洛伦",
                  "text": "咔库库哥们，先生，实不相瞒，我有个不情之请。"
                },
                {
                  "role": "欧洛伦",
                  "text": "听说握住手就可以沾上对方的好运，我们能不能…"
                },
                {
                  "role": "咔库库",
                  "text": "哈哈！没问题，哥们！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "在欧洛伦的带领下，大家纷纷握住了咔库库的翅膀。",
                      "dialogues": [
                        {
                          "role": "？？？",
                          "text": "因为手感太好，事情逐渐演变成了抚摸咔库库的头。"
                        },
                        {
                          "role": "？？？",
                          "text": "圆圆的，软软的，名不虚传，令你流连忘返。"
                        }
                      ]
                    },
                    {
                      "text": "天哪，真是摸了个够，感觉今年剩下的日子都会走运的…",
                      "dialogues": [
                        {
                          "role": "欧洛伦",
                          "text": "一定会的。因为派蒙有非常好的伙伴，就像咔库库一样。"
                        },
                        {
                          "role": "伊法",
                          "text": "看、看我干嘛…"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "你的计划已经圆满达成，也该跟大家说实话了吧。"
                        },
                        {
                          "role": "伊法",
                          "text": "……"
                        },
                        {
                          "role": "派蒙",
                          "text": "欸、欸？什么意思？"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "难道说咔库库的好运…",
                              "dialogues": []
                            },
                            {
                              "text": "都是哥们你…",
                              "dialogues": []
                            }
                          ]
                        },
                        {
                          "role": "伊法",
                          "text": "好啦，好啦，也没什么关系吧。能有我这样的哥们，的确是咔库库的好运之一啊。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "不要诡辩，你老实交代。从一开始的钓鱼起，就都是你安排的吧？"
                        },
                        {
                          "role": "伊法",
                          "text": "…嗯…"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "那位蒙德冒险家，你之前就认识？"
                        },
                        {
                          "role": "伊法",
                          "text": "没有，也就比你早认识了一天吧。只是提前拜托他，让他帮忙指个路。"
                        },
                        {
                          "role": "伊法",
                          "text": "麻烦豚兽和阿夏拿出画片，陪咔库库一路游玩，还有那些「闪闪礼蛋」，都是我提前准备的。"
                        },
                        {
                          "role": "咔库库",
                          "text": "哦天哪，哥们…"
                        },
                        {
                          "role": "伊法",
                          "text": "哈哈…就是人果然没法完全让动物理解自己的意思，结果被豚兽大王误会了…"
                        },
                        {
                          "role": "伊法",
                          "text": "我猜它可能以为我带了其他人来抢回本来给咔库库准备的东西，所以才心情不好的吧。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "原来它真的叫「豚兽大王」啊。"
                        },
                        {
                          "role": "伊法",
                          "text": "当然不，我只是在顺着你说。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "天哪哥们，我感动了。"
                        },
                        {
                          "role": "伊法",
                          "text": "…哎呀总之就是这样啦！最近正好要到咔库库和我们认识的纪念日了，我就想着要给它准备点小礼物。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "因为不知道咔库库的生日究竟是哪天，所以我们一直把这当成咔库库的生日庆祝。"
                        },
                        {
                          "role": "伊法",
                          "text": "咔库库虽然一直装作一副和大伙称兄道弟的成熟样子，但本身还只是一条贪玩的小龙嘛。"
                        },
                        {
                          "role": "伊法",
                          "text": "那小龙就该有小龙的样子，给我尽情地玩，懂吗？"
                        },
                        {
                          "role": "咔库库",
                          "text": "哥们，哥们…"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "哦？咔库库有话要说？"
                        },
                        {
                          "role": "咔库库",
                          "text": "哥们，不是…"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "嗯嗯，我懂的，你不用说了，我们都爱你。"
                        },
                        {
                          "role": "伊法",
                          "text": "是啊是啊，不用不好意思。在度假村的这些天，就请你像任何一只自由的绒翼龙一样，好好玩耍吧。"
                        },
                        {
                          "role": "旅行者",
                          "text": "纪念日快乐，咔库库！"
                        },
                        {
                          "role": "咔库库",
                          "text": "哥们，哥们！"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}