  "chapter_title": "冒险就要大步向前",
  "type": "wq",
  "route": "Adventure Takes Courage!",
  "stories": [
    {
      "story_id": 73802,
      "title": "冒险就要大步向前",
      "description": "在须弥城里，你发现了一个很熟悉的地方…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "对话凯瑟琳"
        },
        {
          "role": "凯瑟琳",
          "text": "向着星辰与深渊！欢迎来到冒险家协会。"
        },
        {
          "role": "派蒙",
          "text": "你好呀，凯瑟琳小姐。"
        },
        {
          "role": "旅行者",
          "text": "你好，凯瑟琳…"
        },
        {
          "role": "凯瑟琳",
          "text": "你们好，看起来两位今天的状态很不错啊。请问您是来接取委托的吗？还是来处理其他事务的呢？"
        },
        {
          "role": "凯瑟琳",
          "text": "嗯…两位为什么一直盯着我？是…有什么事要问我吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有！",
              "dialogues": []
            },
            {
              "text": "只，只是想要接点委托…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "这样啊…看您的样子，冒险的经验应该很丰富了吧？"
        },
        {
          "role": "旅行者",
          "text": "算是吧。"
        },
        {
          "role": "凯瑟琳",
          "text": "那么，想必你也已经很熟悉冒险家协会的运作模式了，我就不多赘述，以免耽误您的时间。"
        },
        {
          "role": "凯瑟琳",
          "text": "如果您对协会内的事务有任何疑问，都欢迎来找我。"
        },
        {
          "role": "凯瑟琳",
          "text": "在须弥城里，也请您多多完成委托吧。像您这样实力强大的冒险家，一定能帮上人们不少忙。"
        },
        {
          "role": "凯瑟琳",
          "text": "请继续勇敢冒险吧，向着星辰与深渊！"
        }
      ]
    }
  ]
}