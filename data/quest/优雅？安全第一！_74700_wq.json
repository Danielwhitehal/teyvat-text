  "stories": [
    {
      "story_id": 74700,
      "title": "优雅？安全第一！",
      "description": "桑多涅似乎有事找我们…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往下层水族馆附近…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我觉得装点水族箱明明还是很有趣的嘛！"
        },
        {
          "role": "派蒙",
          "text": "既然桑多涅不介意，我们以后不如也多下去捞点，让这里变得漂漂亮亮的！"
        },
        {
          "role": "「木偶」",
          "text": "喂，你们两个，过来一下。"
        },
        {
          "role": "派蒙",
          "text": "嗯？怎么了吗？"
        },
        {
          "role": "「木偶」",
          "text": "喏，这个给你们。"
        },
        {
          "role": "派蒙",
          "text": "这是…？"
        },
        {
          "role": "「木偶」",
          "text": "我帮你们改良的水下行动装置。"
        },
        {
          "role": "派蒙",
          "text": "欸？！真的吗？谢谢你桑多涅！你人真好！"
        },
        {
          "role": "「木偶」",
          "text": "小机械装置而已，举手之劳。主要还是你们上次捕鱼，怎么说呢…很…原始…真让人有些看不下去…"
        },
        {
          "role": "派蒙",
          "text": "有…有这么不堪吗…"
        },
        {
          "role": "「木偶」",
          "text": "效率低下，毫无技巧可言，而且一点都不优雅。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "让你见笑了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「木偶」",
          "text": "算了，你们有你们的习惯，我不多说什么。但既然你们想继续装饰这水族馆，最好带上我给的东西。"
        },
        {
          "role": "「木偶」",
          "text": "枫丹水下不只有温和好看的小鱼，还有很多具有攻击性的危险大鱼。这既是为你们的成功率着想，也是为了安全着想。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "非常感谢。",
              "dialogues": []
            },
            {
              "text": "我会带上它的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「木偶」",
          "text": "哼，行了，要下水就快去吧。回来后记得告诉我装置的使用感受，我可以根据你们的反馈进行调试。"
        },
        {
          "type": "subtitle",
          "text": "可跳过任务阶段"
        },
        {
          "type": "subtitle",
          "text": "尝试完成一次水下探险"
        },
        {
          "type": "subtitle",
          "text": "击败目标敌人（3/3）"
        },
        {
          "type": "subtitle",
          "text": "打开宝箱（1/1）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "搜索",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "向前继续探索（1/1）"
        },
        {
          "type": "subtitle",
          "text": "击败强敌（1/1）"
        },
        {
          "type": "subtitle",
          "text": "前往接应点（1/1）"
        },
        {
          "type": "subtitle",
          "text": "折叠内容"
        }
      ],
