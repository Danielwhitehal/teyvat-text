{
  "quest_id": 77132,
  "chapter_num": null,
  "chapter_title": "为她所颂轻柔之歌",
  "type": "wq",
  "route": "The Soft Song She Sang",
  "stories": [
    {
      "story_id": 77132,
      "title": "为她所颂轻柔之歌",
      "description": "冰雪的巨人似乎想要用胸口的火焰点亮影域中浮现的灯塔。看来，得融化灯塔上的冰雪，他才可能做到这一点…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往灯塔附近"
        },
        {
          "role": "派蒙",
          "text": "…那个大家伙，被锁链捆在那里，但是其实一直想要到这个灯塔这儿来吧。"
        },
        {
          "role": "派蒙",
          "text": "可是那个少女，那个影子，她只是个人类，应该没有办法活这么久…"
        },
        {
          "role": "派蒙",
          "text": "那个影子到底是什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许是少女的愿望…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，说不定呢…只要一直想做某件事，想得非常努力，也许身体也会在不经意间往愿望行动。"
                },
                {
                  "role": "派蒙",
                  "text": "那个影子可能…也是想要怀抱着再见一次大家伙的想法，才能够留下来的吧…"
                }
              ]
            },
            {
              "text": "或许是那只雪精的愿望…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是大家伙的愿望？你是说…少女最后其实没有等到，他也没有见到少女…"
                },
                {
                  "role": "派蒙",
                  "text": "那个影子只是他的一缕想象？"
                },
                {
                  "role": "派蒙",
                  "text": "唔…不过，即使如此，在他的想象中，他最后也…拥有了一切，对吧？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "大家伙…他走入了海面之下…总觉得以后再也见不到他了。"
        },
        {
          "role": "派蒙",
          "text": "再见啊！大家伙！"
        },
        {
          "role": "派蒙",
          "text": "…虽然也不知道他能不能听见。"
        },
        {
          "role": "旅行者",
          "text": "他会听见的。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，希望如此吧！"
        },
        {
          "type": "subtitle",
          "text": "爬上灯塔的顶端"
        },
        {
          "type": "subtitle",
          "text": "融化灯室周围的冰雪"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        }
      ]
    }
  ]
}