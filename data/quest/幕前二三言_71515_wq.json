{
  "quest_id": 71515,
  "chapter_num": null,
  "chapter_title": "幕前二三言",
  "type": "wq",
  "route": "A Few Words in the Foreground",
  "stories": [
    {
      "story_id": 71515,
      "title": "幕前二三言",
      "description": "港内北码头现有演出，有意观赏者请尽早前来，过时不候。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往北码头"
        },
        {
          "role": "派蒙",
          "text": "「港内北码头现有演出。」唔，这个通知也写得太模糊了吧，既没说是什么演出，也没说是谁演。"
        },
        {
          "role": "派蒙",
          "text": "我们还是自己找找演出的地方吧，实在不行，还可以问路人。"
        },
        {
          "role": "旅行者",
          "text": "那里有好多人。"
        },
        {
          "role": "派蒙",
          "text": "啊，我看到了。这么多人都聚集在这里，说不定就是来看演出的。"
        },
        {
          "role": "旅行者",
          "text": "我们去问问看吧。"
        },
        {
          "type": "subtitle",
          "text": "询问路人"
        },
        {
          "role": "庆兴",
          "text": "「如意康宁，平安吉庆…♪」"
        },
        {
          "role": "旅行者",
          "text": "你好。"
        },
        {
          "role": "派蒙",
          "text": "请问这里是不是马上要有演出啦？"
        },
        {
          "role": "庆兴",
          "text": "对呀，马上就要演纸映剧了，你们也是来看纸映剧的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来这场戏叫《纸映剧》。",
              "dialogues": []
            },
            {
              "text": "是璃月戏吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "庆兴",
          "text": "不是啦，纸映剧和璃月戏不是一回事…"
        },
        {
          "role": "和声",
          "text": "庆兴庆兴，戏快开场了，你们别说话了，会影响大叔表演的。"
        },
        {
          "role": "庆兴",
          "text": "哦哦，纸映剧什么样，反正你们两个看了就知道了。"
        },
        {
          "role": "应公",
          "text": "…列位小看官们，咱们今天演的是虬髯公的故事。"
        },
        {
          "role": "应公",
          "text": "话说在前头，有想上厕所的，要买糖水的，大可先去。待到角儿们出场，戏就不等人喽。"
        },
        {
          "role": "派蒙",
          "text": "（所以这出戏叫《虬髯公》，是完全没听说过的故事欸。）"
        },
        {
          "role": "和声",
          "text": "嘘，就算小声说话，我们还是听得到，你安安静静听啦，后面点戏的时候才可以说话。"
        },
        {
          "role": "派蒙",
          "text": "唔…对不起。"
        },
        {
          "role": "旅行者",
          "text": "点戏？"
        },
        {
          "role": "庆兴",
          "text": "虬髯公的故事特别长，全都演完就太长了，所以每次大叔都会让大家选想看哪个部分…"
        },
        {
          "role": "和声",
          "text": "庆兴！我听不清大叔念戏文了！"
        },
        {
          "role": "庆兴",
          "text": "哦哦，这次我真的不插嘴了。"
        },
        {
          "role": "应公",
          "text": "看官们，今天大家想品鉴《全本虬髯公》里的哪段故事呢？"
        },
        {
          "role": "应公",
          "text": "是想看《投山》呢，还是《拜仙》？是《缚鬼》还是《登天》？"
        },
        {
          "role": "应公",
          "text": "只有小看官们报不出名儿的，没有我不会演的。"
        },
        {
          "role": "庆兴",
          "text": "我想看虬髯公和妖魔打架，他特别帅，每次都能赢。"
        },
        {
          "role": "和声",
          "text": "《拜仙》和《缚鬼》都看了好多遍了，你不腻吗？我选虬髯公回家看妹妹那段。"
        },
        {
          "role": "庆兴",
          "text": "虬髯公还有妹妹吗？我怎么不知道，这个我没看过欸。"
        },
        {
          "role": "应公",
          "text": "这位小看官是行家啊，《奔乡》这段啊点的人不多，不是老剧迷都不知道有这出。"
        },
        {
          "role": "应公",
          "text": "好，恰逢海灯佳节，咱们不演什么妖魔鬼怪，来瞧瞧有情人怎么终成眷属。"
        },
        {
          "role": "应公",
          "text": "这一场上要出现的角儿有三人，除了咱们的熟面孔虬髯公，还有一位伶仃孤女，名叫意冰，一位志诚君子，唤作南风。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你听明白了吗？我怎么还是云里雾里的。"
        },
        {
          "role": "派蒙",
          "text": "现在要演的，好像是一个叫虬髯公的人的事？但听起来，除了男主角，还有其他配角啊。"
        },
        {
          "role": "派蒙",
          "text": "可我们面前只有一个演员…呃，还有一架…屏风？这怎么演戏啊。"
        },
        {
          "role": "和声",
          "text": "哎呀，这儿有个人没看过纸映剧。"
        },
        {
          "role": "应公",
          "text": "哦？后面一位小看官问了，我应公只有人一个，又没有分身化形的本事，这戏怎么演呢？"
        },
        {
          "role": "应公",
          "text": "您有所不知，我们这纸映剧虽不及璃月戏讲究，也自有一番特色。"
        },
        {
          "role": "应公",
          "text": "演璃月戏的那些个角儿们都是血肉之躯，但咱们纸映剧的演员却是纸糊绢裱的。"
        },
        {
          "role": "应公",
          "text": "人家的戏台是木头搭的，咱们的戏台是一张薄纸蒙在木架子上，说来说去都是纸，所以叫做纸映剧。"
        },
        {
          "role": "应公",
          "text": "旁白是我，演戏的却不是我，您一会儿就能见到那三位纸演员啦。"
        },
        {
          "role": "和声",
          "text": "大叔，他们应该也不认识虬髯公，给他们说说虬髯公的事行不行，就是每次开头都有的那个…"
        },
        {
          "role": "庆兴",
          "text": "那个叫定场话，我也喜欢听，大叔给我们念念吧。"
        },
        {
          "role": "和声",
          "text": "定场话！定场话！"
        },
        {
          "role": "应公",
          "text": "如此听了，雄心欲把天纲正，无奈人间鬼气高。"
        },
        {
          "role": "应公",
          "text": "只说一位公子桓光，受尽人间不平气，投入山川苍莽间。"
        },
        {
          "role": "应公",
          "text": "机缘巧合，他拜入一位仙人座下，便改换了形貌，蓄起一部乌黑胡须，号称虬髯公。"
        },
        {
          "role": "应公",
          "text": "他奉仙人之命，一剑东来，把那魑魅荡平，唬得魍魉屏迹。"
        },
        {
          "role": "应公",
          "text": "虬髯公辗转修行多年，终于得悟大道，正待要返归仙家洞府时，才由仙人点拨，忆起前尘往事。"
        },
        {
          "role": "应公",
          "text": "原来他尘缘未尽，家中尚有一妹。可怜妹子意冰如今孤苦伶仃，无可依靠。"
        },
        {
          "role": "应公",
          "text": "她本以为兄长这一生襟抱送凄凉，如何能想到不日旧人返归乡。欲知后事如何…"
        },
        {
          "role": "应公",
          "text": "马上为您分解！"
        },
        {
          "role": "和声",
          "text": "好欸！别愣着啊，这里该鼓掌了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好！",
              "dialogues": []
            },
            {
              "text": "（跟着鼓掌）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "什么时候鼓掌也有规定吗？好、好吧。"
        },
        {
          "role": "应公",
          "text": "多谢捧场。话说到这里，本该请出演员开戏，但我看这两位还有些疑惑。"
        },
        {
          "role": "应公",
          "text": "我看不如请两位看官上前来，与我做个帮手，指挥布景。"
        },
        {
          "role": "应公",
          "text": "既能让您二位看个清楚明白，也能帮助演员在这方寸舞台上前行。你们意下如何？"
        },
        {
          "role": "庆兴",
          "text": "哇，怎么不叫我，我很熟悉纸映剧的，叫我叫我！"
        },
        {
          "role": "和声",
          "text": "你都上去过多少回了，别起哄了，好好看。"
        },
        {
          "role": "旅行者",
          "text": "我没问题。"
        },
        {
          "role": "派蒙",
          "text": "帮忙指挥布景吗？听起来好新鲜，我也没问题！"
        },
        {
          "role": "应公",
          "text": "那就请两位看官稍事准备，待您二人就位，我们戏就开演。"
        },
        {
          "type": "subtitle",
          "text": "开启纸映成戏活动任务",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}