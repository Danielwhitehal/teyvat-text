{
  "quest_id": 73801,
  "chapter_num": null,
  "chapter_title": "代价",
  "type": "wq",
  "route": "The Price",
  "stories": [
    {
      "story_id": 73801,
      "title": "代价",
      "description": "在奥摩斯港里，你注意到了两个奇怪的人…",
      "dialogues": [
        {
          "role": "普热瓦",
          "text": "…新生意谈好了吗？"
        },
        {
          "role": "亚历山德拉",
          "text": "旧货船刚刚卸好了货，放心吧。"
        },
        {
          "role": "普热瓦",
          "text": "船没漏吧？<color=#00E1FFFF>上面的货…</color>都藏好了？"
        },
        {
          "role": "亚历山德拉",
          "text": "都藏好了，藏得严严实实的。"
        },
        {
          "role": "亚历山德拉",
          "text": "但是…换下来的老物件怎么办？"
        },
        {
          "role": "普热瓦",
          "text": "今天就作废掉。新货到了手…老物件就可以丢了。"
        },
        {
          "role": "亚历山德拉",
          "text": "真，真的没问题吗…"
        },
        {
          "type": "subtitle",
          "text": "获得神秘道具后与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "喔！箱子打开了！意外地不算困难呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来看看…",
              "dialogues": []
            },
            {
              "text": "这箱子难道和那两个愚人众有关…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔唔唔，总之…先看看里面装着什么东西吧。"
        },
        {
          "role": "派蒙",
          "text": "这里面…看起来都是一些旧衣服，还有一摞信纸。"
        },
        {
          "role": "派蒙",
          "text": "上面写着…"
        },
        {
          "role": "派蒙",
          "text": "「降诸魔山南，旧船离港。」"
        },
        {
          "role": "派蒙",
          "text": "这都是什么呀？明明是在山里，怎么会有船呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也许是什么密语…",
              "dialogues": []
            },
            {
              "text": "愚人众在谋划着什么。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…那我们也只能去看看了。"
        },
        {
          "role": "派蒙",
          "text": "这个箱子里装着…一些旧衣服，还有一摞信纸。"
        },
        {
          "role": "旅行者",
          "text": "信纸上写着什么？"
        },
        {
          "role": "派蒙",
          "text": "我看看喔…"
        },
        {
          "role": "派蒙",
          "text": "上面写着「降诸魔山南，旧船离港。」"
        },
        {
          "role": "派蒙",
          "text": "这都是什么呀？明明是在山里，怎么会有船呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是宝藏的线索吧。",
              "dialogues": []
            },
            {
              "text": "说不定是藏宝地。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "而且，也不知道是谁把箱子放在这里的。"
        },
        {
          "role": "派蒙",
          "text": "不管了，先过去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "去老地方探查"
        },
        {
          "role": "派蒙",
          "text": "降诸魔山的南方…这范围也太远了。"
        },
        {
          "role": "派蒙",
          "text": "这里视野不错，我们就在这里先等等，看会不会有人过来吧。"
        },
        {
          "role": "？？？",
          "text": "和派蒙在此等待…"
        },
        {
          "role": "派蒙",
          "text": "看，那边有人来了！"
        },
        {
          "role": "普热瓦",
          "text": "怎么来得这么晚，是遇见什么麻烦了吗？"
        },
        {
          "role": "亚历山德拉",
          "text": "…抱歉，箱子好像被人翻过了，我们的事…"
        },
        {
          "role": "普热瓦",
          "text": "啧，难道是被发现了？不对…最近上面也没来过人…"
        },
        {
          "role": "亚历山德拉",
          "text": "也许…也许是尼卡翻的呢？那群孩子最近总是过来央求我带他们出去玩…"
        },
        {
          "role": "普热瓦",
          "text": "唉…所以我说，除了必要的交际之外，不要和那些居民走太近。"
        },
        {
          "role": "亚历山德拉",
          "text": "可是，他们的父母总是不在家，我实在是…"
        },
        {
          "role": "普热瓦",
          "text": "算了，先不管这些，无论如何，今天我们都要离开这里。"
        },
        {
          "role": "派蒙",
          "text": "离开？他们的意思是…要离开须弥吗？"
        },
        {
          "role": "亚历山德拉",
          "text": "我们没有帮手，那个计划…真的会成功吗？要是被上面的人知道了的话…"
        },
        {
          "role": "普热瓦",
          "text": "管不了那么多了…你是还没有受够吗？"
        },
        {
          "role": "普热瓦",
          "text": "天天提心吊胆，时时刻刻都被人提防…"
        },
        {
          "role": "普热瓦",
          "text": "想要从愚人众里脱身，今天就是最后的机会！"
        },
        {
          "role": "亚历山德拉",
          "text": "我，我知道，但是…"
        },
        {
          "role": "派蒙",
          "text": "这两个人…想要脱离愚人众？"
        },
        {
          "role": "旅行者",
          "text": "出去看看。"
        },
        {
          "role": "派蒙",
          "text": "嗯，不过还是要小心，他们可是愚人众啊！"
        },
        {
          "type": "subtitle",
          "text": "与愚人众对峙"
        },
        {
          "role": "普热瓦",
          "text": "呵呵，终于还是有人来了。"
        },
        {
          "role": "旅行者",
          "text": "你发现我了？"
        },
        {
          "role": "普热瓦",
          "text": "你听的时间太久，一直没有动过位置。"
        },
        {
          "role": "普热瓦",
          "text": "刚才有一阵风吹过，你藏身的那丛灌木摆动的样子，明显和旁边的灌木不同。"
        },
        {
          "role": "派蒙",
          "text": "不，不愧是愚人众…"
        },
        {
          "role": "普热瓦",
          "text": "金发…还有旁边的奇异仙灵。看来你就是报告上提到的那位「旅行者」了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没错，就是我。",
              "dialogues": []
            },
            {
              "text": "你们是设下陷阱等我吗？",
              "dialogues": [
                {
                  "role": "普热瓦",
                  "text": "放心吧，我们可没有那个时间。"
                }
              ]
            }
          ]
        },
        {
          "role": "普热瓦",
          "text": "你既然来了这里，那就证明你已经看过了箱子里的东西了吧。"
        },
        {
          "role": "普热瓦",
          "text": "真没想到，亚历山德拉的小机灵居然真能派上用场。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们到底想做什么？",
              "dialogues": []
            },
            {
              "text": "刚才那些话，也是说给我听的？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "普热瓦",
          "text": "就和你听到的一样，我和亚历山德拉两个人，想要脱离愚人众。"
        },
        {
          "role": "普热瓦",
          "text": "别这么看着我，我们俩可不是大权在握的高层，也不是驻扎在前线的战斗人员。"
        },
        {
          "role": "普热瓦",
          "text": "充其量…只能算是被随便丢在一个地方等候调遣的「钉子」而已。"
        },
        {
          "role": "普热瓦",
          "text": "和我们一样身份的人有很多，但是…他们大部分都不会等到任何命令。"
        },
        {
          "role": "普热瓦",
          "text": "就这样抱着「愚人众」的身份，在人们的提防里度过余生。"
        },
        {
          "role": "普热瓦",
          "text": "我们可不想这样。与其待在这里浪费生命，不如拼上一把，从此离开愚人众。"
        },
        {
          "role": "亚历山德拉",
          "text": "但愚人众可不是那么好脱离的，如果被人知道了这件事，我们一定…不会有什么好下场。"
        },
        {
          "role": "亚历山德拉",
          "text": "所以，我们就制订了一份「假死」的计划，希望能以此脱身。"
        },
        {
          "role": "亚历山德拉",
          "text": "但我们的「死亡」，需要一个说话足够有说服力的人来作证才行。"
        },
        {
          "role": "普热瓦",
          "text": "旅行者，你在愚人众里可以说是大名鼎鼎，而且…呵呵，你也和愚人众有很大的过节。"
        },
        {
          "role": "普热瓦",
          "text": "让你见证两个「愚人众」的死亡，实在是再适合不过了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你就这么确定我会来？",
              "dialogues": [
                {
                  "role": "普热瓦",
                  "text": "我并不确定你会来，但我会等到你来为止。"
                },
                {
                  "role": "普热瓦",
                  "text": "耐心，是我为数不多的优点。"
                }
              ]
            },
            {
              "text": "如果今天不是我来…",
              "dialogues": [
                {
                  "role": "普热瓦",
                  "text": "那我们就会回去。直到你来为止，计划才会继续推进。"
                },
                {
                  "role": "普热瓦",
                  "text": "我们已经筹备了很久，不差这么一点时间。"
                }
              ]
            }
          ]
        },
        {
          "role": "普热瓦",
          "text": "旅行者，现在我们已经把事情都告诉你了，帮不帮忙，就由你来选择。"
        },
        {
          "role": "普热瓦",
          "text": "如果你愿意帮忙，我们也会给你一大笔报酬。"
        },
        {
          "role": "亚历山德拉",
          "text": "这些报酬是我和普热瓦去正经工作赚来的钱，你也不用有什么顾虑的，真的！"
        },
        {
          "role": "亚历山德拉",
          "text": "我…我去给那些孩子们做晚饭，帮他们缝衣服，讲故事，领她们出去玩…"
        },
        {
          "role": "亚历山德拉",
          "text": "普热瓦去帮人家打猎，还有处理猎物…"
        },
        {
          "role": "亚历山德拉",
          "text": "我们离开愚人众之后，也准备用这些手艺来谋生呢！还有…"
        },
        {
          "role": "普热瓦",
          "text": "亚历山德拉！少说几句！"
        },
        {
          "role": "亚历山德拉",
          "text": "喔…哦！好…"
        },
        {
          "role": "普热瓦",
          "text": "总之，选择权在你，旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我会帮忙。",
              "dialogues": [
                {
                  "role": "普热瓦",
                  "text": "谢谢你，旅行者，你会拿到丰厚的报酬。"
                }
              ]
            },
            {
              "text": "你们不怕我翻脸吗？",
              "dialogues": [
                {
                  "role": "普热瓦",
                  "text": "那我们也会尽力抵抗，最后…不敌身亡。"
                },
                {
                  "role": "普热瓦",
                  "text": "听上去差不多，对不对？"
                },
                {
                  "role": "旅行者",
                  "text": "你们的报酬最好够多。"
                },
                {
                  "role": "普热瓦",
                  "text": "放心吧，绝对是一个足够丰厚的数额。"
                }
              ]
            }
          ]
        },
        {
          "role": "普热瓦",
          "text": "那我们就说定了，事不宜迟，我们现在就去分头准备。"
        },
        {
          "role": "普热瓦",
          "text": "亚历山德拉，那边就拜托你了。"
        },
        {
          "role": "普热瓦",
          "text": "旅行者，请你随我过来。"
        },
        {
          "type": "subtitle",
          "text": "去埋伏点探查"
        },
        {
          "role": "普热瓦",
          "text": "就是这里了。旅行者，计划很简单。"
        },
        {
          "role": "普热瓦",
          "text": "我们是两个…呵呵，不怀好意的愚人众，前来这片树林里做一些不怀好意的事。"
        },
        {
          "role": "普热瓦",
          "text": "而你，无论是出于义愤，还是出于维护正义的态度，出手试图制止我们行恶。"
        },
        {
          "role": "普热瓦",
          "text": "在交手的过程中，我和亚历山德拉准备逃跑，但突然有一群魔物闯入，而我们也被那群魔物给打倒。"
        },
        {
          "role": "普热瓦",
          "text": "而你因为魔物的数量太多，也只好撤退，等带人过来的时候，我和亚历山德拉也已经不见了。"
        },
        {
          "role": "普热瓦",
          "text": "故事就是这样，你觉得怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你可真是熟练啊。",
              "dialogues": [
                {
                  "role": "普热瓦",
                  "text": "为了把这个故事讲圆，同时让我们被打倒得更自然一点，我可是花了很大的功夫。"
                }
              ]
            },
            {
              "text": "很像是愚人众会有的下场。",
              "dialogues": [
                {
                  "role": "普热瓦",
                  "text": "没错，愚人众里在外做情报的「钉子」，一般都会落到这种下场。"
                },
                {
                  "role": "普热瓦",
                  "text": "我们正是不想就这么消失，才做的这次计划。"
                }
              ]
            }
          ]
        },
        {
          "role": "普热瓦",
          "text": "不过，亚历山德拉怎么还没回来，就是布设一点魔物诱饵，至于用这么长时间吗？"
        },
        {
          "role": "尼卡",
          "text": "亚历山德拉姐姐！亚历山德拉姐姐！呜…"
        },
        {
          "role": "派蒙",
          "text": "那，那边有人的声音！"
        },
        {
          "role": "普热瓦",
          "text": "糟了，亚历山德拉出事了！"
        },
        {
          "role": "派蒙",
          "text": "喂！等等！你干什么去啊？！"
        },
        {
          "role": "旅行者",
          "text": "快追上去！"
        },
        {
          "role": "派蒙",
          "text": "到底发生了什么事…"
        },
        {
          "type": "subtitle",
          "text": "前往呼救声来源处探查"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "type": "subtitle",
          "text": "对话亚历山德拉"
        },
        {
          "role": "亚历山德拉",
          "text": "抱歉…咳咳…普热瓦…"
        },
        {
          "role": "普热瓦",
          "text": "少说废话。我先给你包扎。"
        },
        {
          "role": "尼卡",
          "text": "呜呜…呜…对不起…"
        },
        {
          "role": "旅行者",
          "text": "你来这里做什么？"
        },
        {
          "role": "尼卡",
          "text": "我…我是来这里摘蘑菇的…呜…"
        },
        {
          "role": "尼卡",
          "text": "因为亚历山德拉姐姐最近…最近好像很难过…"
        },
        {
          "role": "尼卡",
          "text": "所以我们就商量，要给亚历山德拉姐姐做好吃的，给她一个惊喜。"
        },
        {
          "role": "尼卡",
          "text": "之前亚历山德拉姐姐带我们来这里，摘了很多好吃的蘑菇，我就想要自己过来摘一点。"
        },
        {
          "role": "尼卡",
          "text": "但是，但是进了树林我就迷路了，然后就被好多蘑菇围住。"
        },
        {
          "role": "尼卡",
          "text": "亚历山德拉姐姐…亚历山德拉姐姐为了救我…呜…"
        },
        {
          "role": "亚历山德拉",
          "text": "咳…没…没事的，尼卡…姐姐没事…"
        },
        {
          "role": "普热瓦",
          "text": "…旅行者，看来计划要变更了。"
        },
        {
          "role": "普热瓦",
          "text": "亚历山德拉伤势太重，我们擅自离城应该已经被其他的愚人众发现了，现在我带着负伤的她回去，只怕会被抓着盘查。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你们的计划…",
              "dialogues": []
            },
            {
              "text": "那你们怎么办？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "普热瓦",
          "text": "呵呵…只能将计就计了。"
        },
        {
          "role": "普热瓦",
          "text": "我刚才在过来的时候，看见有一支镀金旅团的队伍正在往这边走。"
        },
        {
          "role": "普热瓦",
          "text": "旅行者，你把这个小鬼先送出树林，交给镀金旅团的人，我会带着亚历山德拉离开。"
        },
        {
          "role": "普热瓦",
          "text": "……"
        },
        {
          "role": "普热瓦",
          "text": "还记得我们商量好的话术吗？看来这次我们得假戏真做了。"
        },
        {
          "role": "普热瓦",
          "text": "镀金旅团的那个人一定会认为，我们这两个不怀好意的愚人众，是在这里进行某种不怀好意的计划，搭救尼卡只是一种掩饰。"
        },
        {
          "role": "普热瓦",
          "text": "至于我们被魔物群起攻之…那就是我们罪有应得了。"
        },
        {
          "role": "尼卡",
          "text": "呜…亚历山德拉姐姐…我再也不淘气了…"
        },
        {
          "role": "普热瓦",
          "text": "…好在这小鬼头现在应该也没有心思听我们说的话，不用担心他了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但你们是为了救人…",
              "dialogues": []
            },
            {
              "text": "但你们没有不怀好意…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "普热瓦",
          "text": "相信我，比起「愚人众英勇牺牲」…"
        },
        {
          "role": "普热瓦",
          "text": "他们更容易接受「不怀好意的愚人众们自食其果」。"
        },
        {
          "role": "普热瓦",
          "text": "还记得你初次偷听我和亚历山德拉讲话的地方吗？如果…我们成功逃脱了，我会留一封信在那里的。"
        },
        {
          "role": "旅行者",
          "text": "从一开始，你们就…"
        },
        {
          "role": "普热瓦",
          "text": "我们只有这么一次机会，不得不谨慎一点。"
        },
        {
          "role": "旅行者",
          "text": "现在应该先救亚历山德拉！"
        },
        {
          "role": "亚历山德拉",
          "text": "没关系的，旅行者…咳…我还撑得住。"
        },
        {
          "role": "亚历山德拉",
          "text": "…要是错过了这次机会，让我再回去做愚人众，我宁愿…咳…咳咳！"
        },
        {
          "role": "尼卡",
          "text": "亚历山德拉姐姐，你要去哪？我们一起回去吧！大家都在找你！"
        },
        {
          "role": "亚历山德拉",
          "text": "尼卡…听话，这位旅行者会带你出去…咳…"
        },
        {
          "role": "亚历山德拉",
          "text": "姐姐…要在这里休息一会，休息好了就会回去…"
        },
        {
          "role": "尼卡",
          "text": "可…可是…"
        },
        {
          "role": "亚历山德拉",
          "text": "姐姐什么时候骗过你？咳咳…听话，好吗？"
        },
        {
          "role": "尼卡",
          "text": "呜…呜呜…好…"
        },
        {
          "role": "亚历山德拉",
          "text": "旅行者，就拜托你了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我马上回来。",
              "dialogues": []
            },
            {
              "text": "交给我吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "普热瓦",
          "text": "那就拜托你了，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "将尼卡带去镀金旅团营地"
        },
        {
          "role": "贝拉特",
          "text": "没想到这趟差事要绕这么远，真是累死个人…"
        },
        {
          "role": "贝拉特",
          "text": "那边的，什么人！"
        },
        {
          "role": "贝拉特",
          "text": "尼卡…还有旅行者，你们怎么跑到这里来了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请照顾一下尼卡！",
              "dialogues": []
            },
            {
              "text": "前面有人遇袭了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我，我们在赶时间！尼卡就拜托你啦！"
        },
        {
          "role": "贝拉特",
          "text": "哈？什么乱七八糟的，你给我等会！"
        },
        {
          "type": "subtitle",
          "text": "回去原地查看亚历山德拉情况"
        },
        {
          "role": "派蒙",
          "text": "亚历山德拉应该就在这附近啊，他们…他们去哪了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "亚历山德拉！",
              "dialogues": []
            },
            {
              "text": "普热瓦！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你们在哪呀！"
        },
        {
          "role": "贝拉特",
          "text": "别叫了，再叫就把魔物引来了！"
        },
        {
          "role": "贝拉特",
          "text": "我都听尼卡说了，真没想到，亚历山德拉和普热瓦居然是愚人众。"
        },
        {
          "role": "贝拉特",
          "text": "平时我和他们打交道的时候，还觉得他们是好人呢…"
        },
        {
          "role": "尼卡",
          "text": "亚历山德拉姐姐就是好人！普热瓦哥哥很凶…但也是好人！"
        },
        {
          "role": "贝拉特",
          "text": "哎呀，但他们可是愚人众啊，谁知道是不是装成一副好人样，背地里打什么鬼主意。"
        },
        {
          "role": "贝拉特",
          "text": "愚人众的那些著名「事迹」，我可是听了不少啊。"
        },
        {
          "role": "贝拉特",
          "text": "说不定，他们就是在这里盘算着什么阴谋，搭救尼卡只不过是一种掩护呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他们…",
              "dialogues": []
            },
            {
              "text": "他们…不是坏人…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "贝拉特",
          "text": "那可不好说。不过，现在也找不到这两个人…"
        },
        {
          "role": "贝拉特",
          "text": "他们还带着一个伤员…以我的经验，大概已经被魔物给…呃…"
        },
        {
          "role": "尼卡",
          "text": "贝拉特哥哥！求求你了，再找找吧！"
        },
        {
          "role": "贝拉特",
          "text": "尼卡，如果我不是一个人过来，我保证会带着人搜遍森林。"
        },
        {
          "role": "贝拉特",
          "text": "但现在我只有一个人啊，先不说魔物，如果有其他的愚人众…"
        },
        {
          "role": "贝拉特",
          "text": "咳，总之…旅行者，我们先回去城里吧，我会向团长报告这件事，等他做出判断后，我会根据命令行事。"
        },
        {
          "role": "？？？",
          "text": "贝拉特带着尼卡离开了…"
        },
        {
          "role": "派蒙",
          "text": "他的反应和普热瓦说的一模一样…"
        },
        {
          "role": "派蒙",
          "text": "但他们…真的成功离开了吗？"
        },
        {
          "role": "派蒙",
          "text": "没办法，我们也回去吧。"
        },
        {
          "role": "派蒙",
          "text": "普热瓦说，如果他们成功离开了，就会在他们原来在的位置留下一封信。"
        },
        {
          "role": "派蒙",
          "text": "有时间的话，我们就过去看看吧。"
        }
      ]
    }
  ]
}