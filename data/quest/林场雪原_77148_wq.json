{
  "quest_id": 77148,
  "chapter_num": null,
  "chapter_title": "林场雪原",
  "type": "wq",
  "route": "Forested Snowfield",
  "stories": [
    {
      "story_id": 77148,
      "title": "林场雪原",
      "description": "在路过海屑镇南边的伐木场时，居然遇到了欺负当地伐木场工人的兽怪…好像又是帮派成员惹的事？看来是我们应该出手的时候了！",
      "dialogues": [
        {
          "role": "加廖波",
          "text": "别白费力气了，都是徒劳…"
        },
        {
          "role": "达什科夫",
          "text": "了不起的「契科塔」警探么，我当然知道。不过就像我反复重申的——"
        },
        {
          "role": "达什科夫",
          "text": "我们这儿没有违法的勾当，全都是合规合法、你情我愿的…喂，伊基塔！你说说看，我的话可有半分虚假？"
        },
        {
          "role": "达什科夫",
          "text": "对了，这厮是个老赌鬼，赌到除了家人和自己，再没有可以抵押的东西。"
        },
        {
          "role": "达什科夫",
          "text": "是我们「伊兹梅洛」给了他机会，让他可以用劳动来抵偿债务。只要还清了债，就可以和家人团聚了。"
        },
        {
          "role": "达什科夫",
          "text": "这要是换了别的帮派，难保不会上演骨肉分离的戏码呀，你说是不是啊，伊基塔？"
        },
        {
          "role": "伊基塔",
          "text": "是…我欠了「伊兹梅洛」的钱，我是自愿在这里劳作还债的…"
        },
        {
          "role": "达什科夫",
          "text": "警探，你可是亲耳听到了，咱们这儿没有问题。"
        },
        {
          "role": "多尼娅",
          "text": "我不信…他们各个脸上一丝活气都没有，这哪可能是正常的劳动环境？"
        },
        {
          "role": "多尼娅",
          "text": "我要单独询问这里的工人，你们「伊兹梅洛」的人不能在场。"
        },
        {
          "role": "达什科夫",
          "text": "唉，软的不行只能来硬的了么…警探，你的朋友一定抱怨过你是个不识相的家伙吧。"
        },
        {
          "role": "多尼娅",
          "text": "什么？从、从来没有人这么说过我！"
        },
        {
          "role": "达什科夫",
          "text": "哦，那就是连称得上是朋友的人也没有了，这倒不奇怪。"
        },
        {
          "role": "达什科夫",
          "text": "告诉你一个坏消息，在这儿的全都是我的「朋友」，而且他们有一个共享的优点——嘴都牢靠得很。"
        },
        {
          "role": "多尼娅",
          "text": "你在说什么…"
        },
        {
          "role": "达什科夫",
          "text": "意思就是，不管你在这儿遭遇了什么，都不会传出去！"
        },
        {
          "role": "多尼娅",
          "text": "刚才多谢了。我是「契科塔」的警探，你们可以叫我多尼娅。敢问两位尊姓大名？"
        },
        {
          "role": "派蒙",
          "text": "他是旅行者，我是派蒙，我们是…路见不平拔刀相助的冒险家！"
        },
        {
          "role": "多尼娅",
          "text": "原来如此，不过真是让两位见笑了，我真的很不擅长交涉，明明在来这里之前下定决心不要冲动行事，结果最后还是…"
        },
        {
          "role": "多尼娅",
          "text": "真是愧对各位前辈的教导，不过我也记得前辈曾说：「决定一个警探合格与否的关键便是于『关键时刻』挺身而出的勇气！」"
        },
        {
          "role": "多尼娅",
          "text": "我想至少在这一点上，我是「合格」的！对了，就当刚才是前辈们所说的「关键时刻」吧！"
        },
        {
          "role": "旅行者",
          "text": "只要出手就是「关键时刻」吗…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，就应该这样嘛！如果连挺身而出的勇气都没有，那还做什么警探…不过，嗯…你们的任务是来解救这里的伐木场工人吗？"
        },
        {
          "role": "多尼娅",
          "text": "说来惭愧…其实我的任务是前期的探查——就是在最终收网之前，暗中调查「伊兹梅洛」帮在这片区域的人员安排…"
        },
        {
          "role": "派蒙",
          "text": "暗中调查？可我们刚才已经把人揍了一顿欸！"
        },
        {
          "role": "多尼娅",
          "text": "是啊，已经打草惊蛇…不对，可以说是全面开战了吧。不过好在我已经摸清了据点的所在…"
        },
        {
          "role": "多尼娅",
          "text": "事到如今，只能由我来执行收网任务了！"
        },
        {
          "role": "旅行者",
          "text": "你要一个人包围他们所有人吗？"
        },
        {
          "role": "多尼娅",
          "text": "是的，看来在上一个「关键时刻」过后，马上又迎来了下一个「关键时刻」。"
        },
        {
          "role": "派蒙",
          "text": "呃，时不时刻的先放一边，我和旅行者也来帮忙吧。"
        },
        {
          "role": "多尼娅",
          "text": "多么热心的冒险家！要是其他冒险家也像你们这样热心就好了。"
        },
        {
          "role": "派蒙",
          "text": "总不能眼睁睁看你包围不成反被包围嘛。"
        },
        {
          "type": "subtitle",
          "text": "跟随多尼娅前往帮派的据点"
        },
        {
          "type": "subtitle",
          "text": "击败帮派成员"
        },
        {
          "type": "subtitle",
          "text": "与伐木工对话"
        },
        {
          "role": "格里克",
          "text": "有什么臻冰机关能将这么大的冰块融化…"
        },
        {
          "role": "萨尔沃夫",
          "text": "得、得救了！「契科塔」总算来解救我们了…"
        },
        {
          "role": "基耶塔",
          "text": "警探，他们人多势众，我们好不容易才找准时机突出重围，你们可要多加小心啊！"
        },
        {
          "role": "基耶塔",
          "text": "一支小队可能都够呛…警探，你的队伍呢？"
        },
        {
          "role": "多尼娅",
          "text": "执行任务的人都在这里了。"
        },
        {
          "role": "萨尔沃夫",
          "text": "才三个人？不对…两个半？"
        },
        {
          "role": "派蒙",
          "text": "的确，多尼娅怎么看都不像是能独当一面的警探所以只能算半个——"
        },
        {
          "role": "派蒙",
          "text": "才怪啦，你是把我看扁了对不对，真是没礼貌的家伙。"
        },
        {
          "role": "萨尔沃夫",
          "text": "抱歉抱歉…我只是担心光靠几位的话，实在不是「伊兹梅洛」 头领的对手呀。"
        },
        {
          "role": "萨尔沃夫",
          "text": "那个叫古萨罗夫的，就在据点把守…光是想到他，唉，就像一脚踩进了冻原上的冰窟窿，心脏都要停跳了。"
        },
        {
          "role": "旅行者",
          "text": "那你们是怎么逃出来的？"
        },
        {
          "role": "派蒙",
          "text": "是哦！既然据点有那么多那么强的家伙看守，你们几个是怎么逃出来的？除非…除非你们是被故意放出来的…我知道了！"
        },
        {
          "role": "派蒙",
          "text": "一定是「伊兹梅洛」 的阴谋！"
        },
        {
          "role": "多尼娅",
          "text": "停一停！我是警探，推理的部分应该交给我。"
        },
        {
          "role": "多尼娅",
          "text": "咳，你们根本不是普通的工人，而是「伊兹梅洛」 放出的鱼饵…"
        },
        {
          "role": "多尼娅",
          "text": "为的是将我们——越多越好——引入设好的口袋，再一网打尽！"
        },
        {
          "role": "多尼娅",
          "text": "老实交代，这就是你们的伎俩对吧！我可是经过训练的警探，耍花招对我可没用！"
        },
        {
          "role": "基耶塔",
          "text": "呃，不是的，警探，是我贿赂了看守。不过刚逃出来就被发现了，所以才会有追兵…"
        },
        {
          "role": "萨尔沃夫",
          "text": "我们是真的担心你们，毕竟要是你们折了，我们就得过比以前更苦的日子了…"
        },
        {
          "role": "多尼娅",
          "text": "呜哇，太丢人了…原本以为能像前辈们那样帅气地说出事情的真相，没想到是我误会了…"
        },
        {
          "role": "派蒙",
          "text": "等一下，你不是警探吗，这么轻信真的没问题吗！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不过他们说的也有道理。",
              "dialogues": []
            },
            {
              "text": "管他的，先打过去再说。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧，那就还是按原计划…先到据点再说吧！"
        },
        {
          "type": "subtitle",
          "text": "前往帮派据点"
        },
        {
          "type": "subtitle",
          "text": "与古萨罗夫对话"
        },
        {
          "role": "古萨罗夫",
          "text": "列科塔诺夫，近来常听闻工人不服管教，频频出逃，你可有什么借口。"
        },
        {
          "role": "列科塔诺夫",
          "text": "是小的办事不力。不过啊，老大，他们也是听信了那些风言风语，才越加张狂起来…"
        },
        {
          "role": "古萨罗夫",
          "text": "风言风语…是关于「小阁下」失势的传闻？"
        },
        {
          "role": "列科塔诺夫",
          "text": "是。而且听下面的弟兄们说，这几天还有「契科塔」的狗在附近嗅探，怕是很快就会有所行动。"
        },
        {
          "role": "列科塔诺夫",
          "text": "「小阁下」那边的援兵若是没有指望，光靠咱们，在这地界，怕是孤木难支呀。"
        },
        {
          "role": "列科塔诺夫",
          "text": "老大，要我说，既然没了靠山，不如咱们趁现在将那<color=#00E1FFFF>「大盗宝藏」</color>取了，不说潇洒快活，起码也好心里有底…"
        },
        {
          "role": "古萨罗夫",
          "text": "唔，就算没了「小阁下」，能源协会总归还在，日后定有用得到「伊兹梅洛」的时候。个中利弊，得谨慎权衡。"
        },
        {
          "role": "列科塔诺夫",
          "text": "老大说的是，但要是错过了这个时机…"
        },
        {
          "role": "凶神恶煞的「伊兹梅洛」",
          "text": "老、老大！「契科塔」打过来了！"
        },
        {
          "role": "古萨罗夫",
          "text": "什么？！这么快？他们来了多少人？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好，就三个人。",
              "dialogues": []
            },
            {
              "text": "「契科塔」的警探来包围你们了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "束手就擒吧！现在放弃抵抗的话还有酌情处理的余地！"
        },
        {
          "role": "多尼娅",
          "text": "派、派蒙！「契科塔」的警探不能和犯罪分子谈条件！"
        },
        {
          "role": "多尼娅",
          "text": "而且这明明是我的「关键时刻」，风头全被两位抢了，呜…"
        },
        {
          "role": "古萨罗夫",
          "text": "搞什么…就凭你们？我们「伊兹梅洛」还没落魄到这份上！"
        },
        {
          "role": "古萨罗夫",
          "text": "弟兄们，抄家伙，给他们点颜色瞧瞧！"
        },
        {
          "type": "subtitle",
          "text": "解决盘踞此处的帮派成员"
        },
        {
          "type": "subtitle",
          "text": "解决盘踞此处的帮派成员"
        },
        {
          "role": "古萨罗夫",
          "text": "唔…真有两下子。犯不着在这儿折了…我们改日再战！"
        },
        {
          "role": "多尼娅",
          "text": "啊！我的「关键时刻」要逃跑了！旅行者，我们快追！"
        },
        {
          "type": "subtitle",
          "text": "追上逃走的帮派成员"
        },
        {
          "type": "subtitle",
          "text": "解决盘踞此处的帮派成员"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "",
              "dialogues": []
            },
            {
              "text": "",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与多尼娅对话"
        },
        {
          "role": "？？？",
          "text": "费了一番功夫，将击败的「伊兹梅洛」成员塞进了一旁的小屋…"
        },
        {
          "role": "多尼娅",
          "text": "锁上了。之后通知同事来接管就好了。"
        },
        {
          "role": "多尼娅",
          "text": "也辛苦两位了。这还是我第一次独自执行任务呢，要是没有旅行者相助，不知会是什么下场…"
        },
        {
          "role": "派蒙",
          "text": "你是说，你第一次独自执行任务，就单枪匹马闹到和犯罪团伙全面开战的地步？"
        },
        {
          "role": "多尼娅",
          "text": "在「关键时刻」挺身而出，剿灭了黑恶势力，也算是立下了大功吧！嘿嘿。"
        },
        {
          "role": "派蒙",
          "text": "算、算吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "结果好就一切都好。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "话是这么说啦。但也不是所有事只要结果没问题，过程就可以不择手段的！"
                }
              ]
            },
            {
              "text": "组织不需要不服从命令的人！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "到底是哪种组织啦！不过的确，不管什么组织，规则都是很重要的吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "话说回来，现在那些工人该怎么办呢？"
        },
        {
          "role": "多尼娅",
          "text": "担心的话就去看看？我知道他们会在哪里，跟我来吧。"
        },
        {
          "type": "subtitle",
          "text": "与工人们对话"
        },
        {
          "role": "格里克",
          "text": "警探，是警探来了！"
        },
        {
          "role": "多尼娅",
          "text": "抱歉，任务出了点岔子，计划有变…"
        },
        {
          "role": "格里克",
          "text": "啊？难、难道是被察觉了？天哪，那我们该怎么办？"
        },
        {
          "role": "格里克",
          "text": "「伊兹梅洛」不会放过我们的…我们会死在这儿的！"
        },
        {
          "role": "格里克",
          "text": "不行，我们得现在就走，趁他们的打手还没来…唉，可惜了我的伐木场，我的产业…"
        },
        {
          "role": "派蒙",
          "text": "哇，你先别急！虽然多尼娅的任务出了岔子，但是问题已经解决了！"
        },
        {
          "role": "？？？",
          "text": "讲述了此前发生的事…"
        },
        {
          "role": "格里克",
          "text": "…也就是说，那群霸占我的伐木场的恶棍已经被绳之以法了？我们从今往后再也不用担惊受怕了？"
        },
        {
          "role": "派蒙",
          "text": "至少暂时是？虽然也不能保证他们之后不会卷土重来…"
        },
        {
          "role": "多尼娅",
          "text": "没关系，就算他们胆敢再来，我也会负起责任，以「契科塔」警探的名义，将他们再次绳之以法的！"
        },
        {
          "role": "格里克",
          "text": "哦哦，真可靠！那就全仰赖您了。"
        },
        {
          "role": "格里克",
          "text": "唉，不过那群「伊兹梅洛」之前在这儿为非作歹，不光是压榨打骂工人，工具和设施也被他们糟蹋得不像样子…"
        },
        {
          "role": "格里克",
          "text": "要重新投入使用，不知得花多少钱来修复，这笔资金也完全没有着落…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「关键时刻」呢？",
              "dialogues": []
            },
            {
              "text": "快用「关键时刻」救救！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "多尼娅",
          "text": "「关键时刻」做不到这种事啦，唔，不对，前辈曾经说过："
        },
        {
          "role": "多尼娅",
          "text": "「遇到决断，要冷静作出思考，然后行动，那就是『关键时刻』前的『关键时刻』！」"
        },
        {
          "role": "派蒙",
          "text": "「关键时刻」多到可以做成铁链了，而且…"
        },
        {
          "role": "派蒙",
          "text": "有这种冷静思考的「关键时刻」，不该早点拿出来吗！真是的，一路上都不知道冲动多少回了。"
        },
        {
          "role": "多尼娅",
          "text": "嗯…原来如此！「关键时刻」!"
        },
        {
          "role": "派蒙",
          "text": "怎么了，要把伐木场揍一顿让它恢复原样吗？"
        },
        {
          "role": "多尼娅",
          "text": "不、不是啦，这次是真的有头绪了，我记得，在和「伊兹梅洛」的头领战斗之前…"
        },
        {
          "role": "多尼娅",
          "text": "他曾经说过什么东西来着，唔…"
        },
        {
          "role": "旅行者",
          "text": "「大盗宝藏」！"
        },
        {
          "role": "派蒙",
          "text": "是哦，说起来，我们之前是不是拿到过一张有标记的地图…"
        },
        {
          "role": "格里克",
          "text": "咦，按照地图上的标记，应该是我们挖过的地方…等等，我们当时只从里面挖出好多凝结的冰…"
        },
        {
          "role": "格里克",
          "text": "难道说那个就是…呃，总之，我先带你们过去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "前往宝藏埋藏点"
        },
        {
          "role": "多尼娅",
          "text": "哇！好大的一块冰…唔，仔细一看，里面是不是有东西？"
        },
        {
          "role": "格里克",
          "text": "里面…啊，原来「大盗宝藏」被封在了里面，我们还以为里面只是一些石头…"
        },
        {
          "role": "派蒙",
          "text": "不过这个冰放这么久，都还没化。"
        },
        {
          "role": "多尼娅",
          "text": "至冬就是这样的天气嘛，这种冰在冻原上不管，只会越变越大。"
        },
        {
          "role": "旅行者",
          "text": "「关键时刻」…"
        },
        {
          "role": "多尼娅",
          "text": "再怎么关键，冰也破不了！"
        },
        {
          "role": "派蒙",
          "text": "用什么暖和的东西让它融化就好了吧。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我记得不是有那种奇怪的臻冰机关…说不定能用那个！"
        },
        {
          "role": "派蒙",
          "text": "来试试看吧！"
        },
        {
          "type": "subtitle",
          "text": "融化冰块以取得「大盗宝藏」"
        },
        {
          "type": "subtitle",
          "text": "与格里克对话"
        },
        {
          "role": "格里克",
          "text": "原来这就是那群「伊兹梅洛」想找的东西，他们就是为了这个才霸占了我的伐木场。"
        },
        {
          "role": "格里克",
          "text": "这么多摩拉，哪怕只用其中的一小部分，就能让伐木场恢复运转了。"
        },
        {
          "role": "格里克",
          "text": "不过我听说冒险家协会的规定是，野外无主的财宝，谁发现就归谁所有…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你很上道嘛，没错，全都归我了！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "没错没错！全都归我们了！"
                },
                {
                  "role": "派蒙",
                  "text": "…等等，这分明就是「伊兹梅洛」那群恶棍会说的台词吧！就算要拿，也应该给其他人留一些吧。"
                }
              ]
            },
            {
              "text": "见者有份，那我们平分吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "多尼娅",
          "text": "欸？我也有份？哇，到下次发薪日之前可以过得滋润一些了…"
        },
        {
          "role": "多尼娅",
          "text": "不、不对！多尼娅啊多尼娅，清醒一点！这可是考验你的「关键时刻」！怎么能这么轻易就被腐化呢！"
        },
        {
          "role": "多尼娅",
          "text": "…咳，这些财宝，就交给你们处置了。"
        },
        {
          "role": "格里克",
          "text": "那…承蒙各位的厚意，我只取一小份，用来修复伐木场的设施和工具，其他的就交给出力最多的冒险家吧。"
        },
        {
          "role": "多尼娅",
          "text": "我没有异议。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，好哦，那这事就算结了？不过多尼娅，你还得去联系同事来处理残局吧？"
        },
        {
          "role": "派蒙",
          "text": "不知道你的前辈们发现你一个人就把「伊兹梅洛」的据点清理干净了会说什么。"
        },
        {
          "role": "派蒙",
          "text": "说不定等着你的不是夸奖，而是责怪呢！"
        },
        {
          "role": "多尼娅",
          "text": "应、应该不会吧？不过仔细想想也不是完全没有这种可能…该怎么办…对了！"
        },
        {
          "role": "多尼娅",
          "text": "旅行者，这样，旅行者和派蒙就成为我的「关键时刻」吧，这样，前辈一定会谅解的！"
        },
        {
          "role": "旅行者",
          "text": "才不要啦！"
        },
        {
          "role": "派蒙",
          "text": "才不要啦，而且「关键时刻」到底是什么，越来越搞不明白了！"
        }
      ]
    }
  ]
}