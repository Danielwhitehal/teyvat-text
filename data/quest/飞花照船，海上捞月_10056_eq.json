{
  "quest_id": 10056,
  "chapter_num": "飞彩镌流年 沧浪覆遗珠",
  "chapter_title": "飞花照船，海上捞月",
  "type": "eq",
  "route": "Petal-Lit Ships Fish For the Moon",
  "stories": [
    {
      "story_id": 40039,
      "title": "飞花照船，海上捞月",
      "description": "凝光似乎正在思考某事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往群玉阁"
        },
        {
          "type": "subtitle",
          "text": "与凝光对话"
        },
        {
          "role": "凝光",
          "text": "还真是少了很多东西啊…"
        },
        {
          "role": "旅行者",
          "text": "什么东西？"
        },
        {
          "role": "凝光",
          "text": "与先前相比，如今这座群玉阁里少了许多东西。"
        },
        {
          "role": "凝光",
          "text": "我收藏的许多书籍，家具和小饰品，都随着那座群玉阁坠入海中…"
        },
        {
          "role": "凝光",
          "text": "这些物品大都在那场大难中毁坏了，少部分幸存的散落在海面上，极难回收。"
        },
        {
          "role": "凝光",
          "text": "只有擅长水上工作的人才能替我办到这件事。只是…不知道北斗能不能把它们都捞回来。"
        },
        {
          "role": "旅行者",
          "text": "捞回来？"
        },
        {
          "role": "派蒙",
          "text": "欸？你让北斗去捞那些东西了吗？"
        },
        {
          "role": "凝光",
          "text": "「让」这个字，不够精准。我们之间向来是公平交易。"
        },
        {
          "role": "旅行者",
          "text": "北斗拿钱办事？"
        },
        {
          "role": "凝光",
          "text": "除了「钱」之外，还有其他的「报酬」…呵呵，这些事复杂着呢。"
        },
        {
          "role": "凝光",
          "text": "总之，北斗现在正在孤云阁一带。"
        },
        {
          "role": "凝光",
          "text": "你们若有兴趣，可以去看看。说不定，你们也能帮到她的忙。"
        },
        {
          "type": "subtitle",
          "text": "事后对话"
        },
        {
          "role": "凝光",
          "text": "北斗正在孤云阁那边帮我打捞散落的群玉阁藏品。你们若有兴趣，可以去看看。"
        },
        {
          "type": "subtitle",
          "text": "前往「死兆星」号"
        },
        {
          "type": "subtitle",
          "text": "与北斗对话"
        },
        {
          "role": "北斗",
          "text": "那个麻烦的女人…"
        },
        {
          "role": "北斗",
          "text": "那座群玉阁在海上撞了个粉碎，里面的东西肯定也都被撞坏了，怎么可能捞得上来…"
        },
        {
          "role": "旅行者",
          "text": "打捞还顺利吗？"
        },
        {
          "role": "北斗",
          "text": "旅行者？你们怎么来了？"
        },
        {
          "role": "旅行者",
          "text": "我是来帮忙的。"
        },
        {
          "role": "北斗",
          "text": "哦！你来得正好，现在全船的人都出动了，人手实在是不够用。"
        },
        {
          "role": "北斗",
          "text": "你看，我连辛焱都拉来帮忙了。"
        },
        {
          "role": "旅行者",
          "text": "辛焱居然也来了？"
        },
        {
          "role": "派蒙",
          "text": "对喔，辛焱怎么会在船上？难道是有演出？"
        },
        {
          "role": "辛焱",
          "text": "是啊！虽然也算不上正式音乐演出啦，是北斗姐说想办宴会，请我来唱两首歌。"
        },
        {
          "role": "辛焱",
          "text": "但什么都还没开始，忽然有个自称是凝光秘书的人过来，把北斗姐叫走了。"
        },
        {
          "role": "北斗",
          "text": "是叫百闻还是百晓来着？唔…有些记不清了。"
        },
        {
          "role": "北斗",
          "text": "反正就是凝光又突发奇想，要我帮她到海上打捞藏品，作为交换她会支付一大笔劳务费。"
        },
        {
          "role": "北斗",
          "text": "哼…既然资金到位，这活儿我们接就接了。"
        },
        {
          "role": "北斗",
          "text": "打捞啊，必须得用小船。"
        },
        {
          "role": "北斗",
          "text": "船队里能动用的小船都出发了，不过眼下还缺一艘…"
        },
        {
          "role": "旅行者",
          "text": "我有一艘小船。"
        },
        {
          "role": "北斗",
          "text": "你有船？那正好，我们就坐你的船出海。"
        },
        {
          "role": "北斗",
          "text": "多一个人多一份力量嘛。早点忙完，我们才好回来办宴会庆祝过节啊！"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点，搭乘「浪船」"
        },
        {
          "type": "subtitle",
          "text": "在孤云阁附近的海面上打捞失物"
        },
        {
          "role": "北斗",
          "text": "旅行者，这就是…你的船？"
        },
        {
          "role": "北斗",
          "text": "真是…小巧啊，不错，不错…很适合捞海面上浮着的东西。"
        },
        {
          "role": "辛焱",
          "text": "就是有点挤，我的琴都摆不开了…"
        },
        {
          "role": "北斗",
          "text": "辛焱，你的琴离我太近了…"
        },
        {
          "role": "辛焱",
          "text": "哦…哦！我挪一下位置…"
        },
        {
          "role": "派蒙",
          "text": "咦？你的琴底下怎么还带着刃？"
        },
        {
          "role": "辛焱",
          "text": "当然是防身用的啦！它还会喷火呢，不过这大过节的，还是不演示了吧…"
        },
        {
          "role": "辛焱",
          "text": "俗话说得好，不怕一万就怕万一，可不能把你们的船给烧着了…"
        },
        {
          "role": "派蒙",
          "text": "这把琴用处可真多啊…"
        },
        {
          "type": "subtitle",
          "text": "打倒敌人，捞取失物"
        },
        {
          "type": "subtitle",
          "text": "来到失物旁",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "辛焱",
          "text": "等等，前面那是…盗宝团？！"
        },
        {
          "role": "北斗",
          "text": "这帮人在海上做什么，难道他们也在捞东西？"
        },
        {
          "role": "北斗",
          "text": "旅行者，我们靠近点看看吧。"
        },
        {
          "type": "subtitle",
          "text": "与北斗对话"
        },
        {
          "role": "辛焱",
          "text": "咦？那群盗宝团怎么去岸上了？"
        },
        {
          "role": "北斗",
          "text": "他们大概是想去和同伙会合吧。"
        },
        {
          "role": "北斗",
          "text": "旅行者，把船再开快些，我们追上去。"
        },
        {
          "type": "subtitle",
          "text": "追击盗宝团"
        },
        {
          "role": "盗宝团成员",
          "text": "这帮人怎么追这么紧，跑、跑不掉了！"
        },
        {
          "role": "盗宝团成员",
          "text": "快去把卡门哥叫来！"
        },
        {
          "role": "辛焱",
          "text": "卡门？这名字怎么这么奇怪？"
        },
        {
          "role": "北斗",
          "text": "我的老熟人了，没想到他也来了…"
        },
        {
          "type": "subtitle",
          "text": "与卡门对话"
        },
        {
          "role": "卡门",
          "text": "停手！都给我停手！"
        },
        {
          "role": "卡门",
          "text": "你们这帮不长眼的，连北斗大姐都不认识了吗？！"
        },
        {
          "role": "卡门",
          "text": "嘿嘿…北斗姐，这么长时间没见，您身手还是这么好…"
        },
        {
          "role": "北斗",
          "text": "卡门，一段时间不见，你怎么又胖了不少。"
        },
        {
          "role": "北斗",
          "text": "再胖下去，你躲在草丛里的时候可就要藏不住自己了。"
        },
        {
          "role": "卡门",
          "text": "您说笑了，说笑了…哈哈哈…"
        },
        {
          "role": "北斗",
          "text": "说正事吧，这些东西我要了。把东西放下，我不为难你们。"
        },
        {
          "role": "卡门",
          "text": "是是是，都听北斗姐的…把东西都放下！"
        },
        {
          "role": "卡门",
          "text": "东西都给您放在这了，那…那兄弟们就先告辞了。"
        },
        {
          "type": "subtitle",
          "text": "卡门带着盗宝团迅速离开了…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "居然答应得这么爽快…"
        },
        {
          "role": "旅行者",
          "text": "投降得很利落。"
        },
        {
          "role": "辛焱",
          "text": "跑得也很利落啊…"
        },
        {
          "role": "北斗",
          "text": "别在他们身上浪费时间了，我们快点去海上接着打捞吧。"
        },
        {
          "role": "北斗",
          "text": "对了，还得把这些东西搬上船才行…旅行者，过来搭把手。"
        },
        {
          "type": "subtitle",
          "text": "将失物搬运上「浪船」（3/3）"
        },
        {
          "type": "subtitle",
          "text": "搭乘「浪船」，继续打捞失物"
        },
        {
          "type": "subtitle",
          "text": "继续打捞失物（3/3）"
        },
        {
          "type": "subtitle",
          "text": "来到失物旁",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "辛焱",
          "text": "嗯？海面上好像漂着什么东西…"
        },
        {
          "role": "北斗",
          "text": "看不太清啊，捞上来再说。"
        },
        {
          "role": "北斗",
          "text": "来，换我掌舵。旅行者，辛焱，你们快去把那些东西捞上来吧。"
        },
        {
          "type": "subtitle",
          "text": "继续打捞失物（3/3）"
        },
        {
          "type": "subtitle",
          "text": "继续打捞失物（2/2）"
        },
        {
          "type": "subtitle",
          "text": "追踪盗宝团"
        },
        {
          "role": "辛焱",
          "text": "看前面，又是盗宝团的筏子。但是上面怎么没人？"
        },
        {
          "role": "北斗",
          "text": "应该是卡门那家伙把自己的人都撤走了吧。"
        },
        {
          "role": "北斗",
          "text": "算他识相，我们继续前进吧。"
        },
        {
          "type": "subtitle",
          "text": "盗宝团营地旁",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "？？？",
          "text": "收拾得再快点，零碎的小玩意就不要了，挑值钱的带走！"
        },
        {
          "role": "？？？",
          "text": "再去几个人，把船赶紧装好了！"
        },
        {
          "role": "北斗",
          "text": "都给我停下，东西也都放下。"
        },
        {
          "role": "？？？",
          "text": "北…北斗姐！您、您怎么来了？"
        },
        {
          "role": "北斗",
          "text": "溜溜，你在这里做什么？"
        },
        {
          "role": "溜溜",
          "text": "哎呀，兄弟们这不是…撞了大运，从海上捞到了点好东西吗?"
        },
        {
          "role": "溜溜",
          "text": "北斗姐喜欢什么，随便拿！就当是兄弟们孝敬您的，哈哈哈！"
        },
        {
          "role": "北斗",
          "text": "是吗？那这些东西就全都留下吧。"
        },
        {
          "role": "溜溜",
          "text": "这…这…您多少得讲点道上规矩…"
        },
        {
          "role": "溜溜",
          "text": "兄弟们忙前忙后，好歹得喝一口汤吧？"
        },
        {
          "role": "北斗",
          "text": "这东西不是你们能碰的。我再说一遍，把东西放下，然后有多远滚多远。"
        },
        {
          "role": "溜溜",
          "text": "这…不太好吧…北斗姐，不然我们再…"
        },
        {
          "role": "北斗",
          "text": "呼…看来你是在拖时间啊。"
        },
        {
          "role": "北斗",
          "text": "那也别废话了，来吧，我们过两招！"
        },
        {
          "type": "subtitle",
          "text": "打倒所有盗宝团"
        },
        {
          "role": "盗宝团成员",
          "text": "船都装好了，也下水了，老大，你看…"
        },
        {
          "role": "溜溜",
          "text": "哎哟，北斗姐下手够狠的…撤退！都撤退！"
        },
        {
          "role": "盗宝团成员",
          "text": "老大都撤了…咱们也该走了！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！他们要跑了！"
        },
        {
          "role": "溜溜",
          "text": "得罪北斗姐了！过段时间，我一定领着兄弟们去给您赔罪！"
        },
        {
          "type": "subtitle",
          "text": "与北斗对话"
        },
        {
          "role": "派蒙",
          "text": "这些家伙，跑得也太快了…"
        },
        {
          "role": "北斗",
          "text": "算了，反正他们也没带走多少东西。"
        },
        {
          "role": "北斗",
          "text": "但这里有这么多东西，你的那艘船应该也装不下了。"
        },
        {
          "role": "北斗",
          "text": "唔，这样吧。把你船上的那些东西也卸下来，都放在这里。"
        },
        {
          "role": "北斗",
          "text": "按照打捞计划，海龙他们的船应该会经过这里。到时候，我让他带我们回去。"
        },
        {
          "role": "北斗",
          "text": "旅行者，你先回群玉阁帮我给凝光带个话。"
        },
        {
          "role": "北斗",
          "text": "就说…东西已经捞得差不多了，让她把报酬都准备好。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "北斗",
          "text": "嗯，那就拜托你了。"
        },
        {
          "role": "北斗",
          "text": "卡门和溜溜都来了，难道那位盗宝团的「大姐头」也来了？"
        },
        {
          "role": "北斗",
          "text": "必须得让海龙他们提高警惕才行…"
        },
        {
          "type": "subtitle",
          "text": "事后对话"
        },
        {
          "role": "辛焱",
          "text": "盗宝团里也有各种各样性格的人啊…"
        },
        {
          "role": "北斗",
          "text": "海龙那家伙怎么还没来，难道他们也遇见盗宝团了？"
        },
        {
          "type": "subtitle",
          "text": "向凝光回报"
        },
        {
          "role": "凝光",
          "text": "你们回来了，如何，北斗打捞得可还顺利？"
        },
        {
          "role": "旅行者",
          "text": "是这样的…"
        },
        {
          "type": "subtitle",
          "text": "向凝光讲述了事情的经过…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "凝光",
          "text": "盗宝团也掺和进来了啊，确实有些麻烦。"
        },
        {
          "role": "凝光",
          "text": "你们这次能吓退他们，但只是一时，这群家伙不会善罢甘休。"
        },
        {
          "role": "凝光",
          "text": "不过，这件事就交给北斗吧，她擅长对付这些人。她的报酬，我也会准备好的。"
        },
        {
          "role": "凝光",
          "text": "多谢你们专程回来告知我这些事。我为你们也准备了一些酬劳，还请收下。"
        },
        {
          "role": "凝光",
          "text": "那我就先去处理别的事了，祝你们玩得尽兴。"
        }
      ],
      "collapse_ranges": [
        [
          15,
          16
        ],
        [
          125,
          127
        ]
      ]
    }
  ]
}