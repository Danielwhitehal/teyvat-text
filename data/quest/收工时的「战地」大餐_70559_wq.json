{
  "quest_id": 70559,
  "chapter_num": null,
  "chapter_title": "收工时的「战地」大餐",
  "type": "wq",
  "route": "A \"Battlefield\" Feast After Work",
  "stories": [
    {
      "story_id": 70559,
      "title": "收工时的「战地」大餐",
      "description": "几日紧张有序的测绘演练之后，分别的日子悄悄到来…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与特雷斯对话"
        },
        {
          "role": "派蒙",
          "text": "大家好呀！看起来，你们的精神都不错呢！"
        },
        {
          "role": "特雷斯",
          "text": "多谢关心，这几天收获很大，还要多多感谢米卡教官、埃洛雯，还有荣誉骑士和派蒙…"
        },
        {
          "role": "埃洛雯",
          "text": "唔，好像有点在发表什么获奖感言？不过好像也可以这么说，毕竟特雷斯的成果可算是大获成功！"
        },
        {
          "role": "米卡",
          "text": "没错…从骑士团任务的角度考虑，特雷斯目前的测绘技巧，已经足以应对九成以上的情景了。"
        },
        {
          "role": "米卡",
          "text": "当然，要不是荣誉骑士前辈挑战「测绘寻物」的思路带给了我们启发，这次的训练可能还需要三倍的时间…"
        },
        {
          "role": "派蒙",
          "text": "说明我们配合得好，有默契，对不对？旅行者觉得呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "本次体验相当新奇。",
              "dialogues": []
            },
            {
              "text": "寻物挑战也给了我灵感。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特雷斯",
          "text": "真、真的吗？荣誉骑士前辈这么说了之后，不知道为什么，好像紧张都消散一些了…"
        },
        {
          "role": "特雷斯",
          "text": "我总是担心如果我做不好，就会出现像米卡教官说那种情况——「结果往往影响的不仅仅是你自己」…"
        },
        {
          "role": "埃洛雯",
          "text": "可恶！但你已经获得了荣誉骑士的认可…如果我能等到这一句…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "埃洛雯也很棒！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "埃洛雯",
          "text": "欸…欸？！真的吗？我吗？我、我会好好记住的！"
        },
        {
          "role": "埃洛雯",
          "text": "…让我好好想想，要用什么方式来庆祝这一天呢…"
        },
        {
          "role": "特雷斯",
          "text": "说到庆祝。我倒是有个想法…有什么比一顿热气腾腾的美食更适合庆祝呢？听说埃洛雯的手艺…"
        },
        {
          "role": "埃洛雯",
          "text": "嗯？想尝尝我的手艺吗…之前我只在行军路上做过饭，因为我总是倒霉抽到坏签…当然，如果你们不嫌难吃的话…"
        },
        {
          "role": "特雷斯",
          "text": "怎么会？埃洛雯的手艺在骑士团里也算是远近闻名了吧。"
        },
        {
          "role": "米卡",
          "text": "确实…目前还没有听到过一句差评呢…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！那我更好奇了！埃洛雯，让我们尝尝你的手艺嘛！"
        },
        {
          "role": "埃洛雯",
          "text": "既然大家都这么说了，那就没问题！我想，我只需要一些准备…"
        },
        {
          "type": "subtitle",
          "text": "众人一起预处理食材、搭建临时灶台后，埃洛雯烹饪了许多看起来平平无奇，但香气却很诱人的美食…\n大家像野餐那样，围成一圈坐下，享用了这顿独特的饭菜…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "呼…吃饱了！真是吃了以后…又满足又暖洋洋的料理！"
        },
        {
          "role": "派蒙",
          "text": "我什么都尝了一口，现在马上快要飞不动了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这就是骑士的营地餐吗…",
              "dialogues": []
            },
            {
              "text": "连我都很久没吃这么撑过了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "米卡",
          "text": "毕竟是为了在雪山附近长期执勤而设计的料理，用料扎实，热量也不能少…"
        },
        {
          "role": "米卡",
          "text": "荣誉骑士前辈和派蒙，休息一下后，可以适当做做运动哦。"
        },
        {
          "role": "特雷斯",
          "text": "百闻不如一尝，这次，真是没有遗憾了！希望以后还能多和游击小队这样合作！"
        },
        {
          "role": "特雷斯",
          "text": "但吃饱了，就要到了要说再见的时间呢…"
        },
        {
          "role": "特雷斯",
          "text": "之前收到了同僚的信，队里建议我尽早返程，下轮定期训练又快来了。"
        },
        {
          "role": "特雷斯",
          "text": "现在想想，认真学点什么的时候，时间真得过得好快…"
        },
        {
          "role": "米卡",
          "text": "也正是验证学习成果的时候了，放轻松，你可以做得很好。"
        },
        {
          "role": "派蒙",
          "text": "恭喜特雷斯，从米卡这里毕业啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "课程大成功！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特雷斯",
          "text": "我一定会拿出全力，充分运用米卡教官传授给我的所有知识！"
        },
        {
          "role": "埃洛雯",
          "text": "等你也变得赫赫有名的时候，我就可以和别人说——"
        },
        {
          "role": "埃洛雯",
          "text": "欸，你知道那个骑士团里的特雷斯吗？他是我测绘课的同学哦！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（米卡）"
        },
        {
          "role": "米卡",
          "text": "这里…好像还有一些可以改进的地方…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是在回顾「测绘寻物」的结果吗？",
              "dialogues": [
                {
                  "role": "米卡",
                  "text": "是啊，这次交流学习，不仅特雷斯学到了测绘方面的技巧，我也有了不少新的收获…"
                },
                {
                  "role": "米卡",
                  "text": "这可能就是那些前辈说的情况吧——「当你教别人的时候，也是在帮助你自己学习…」"
                },
                {
                  "role": "米卡",
                  "text": "…我要趁现在赶紧记录下来，有些宝贵的想法真是过一会儿就捕捉不到了。"
                }
              ]
            },
            {
              "text": "不去休息一下吗？",
              "dialogues": [
                {
                  "role": "米卡",
                  "text": "…是、是啊，等我整理整理这段时间的收获，我就给自己好好放一个假。"
                },
                {
                  "role": "米卡",
                  "text": "或许出去走走，看看不一样的风景，走走不一样的道路，还会有别样的感悟呢。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（埃洛雯）"
        },
        {
          "role": "埃洛雯",
          "text": "欸？是还想体验一遍「测绘寻物」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是有些意犹未尽呢…",
              "dialogues": [
                {
                  "role": "埃洛雯",
                  "text": "是啊…只可惜这次准备的时间太少，我只草草做了几个标定物。"
                },
                {
                  "role": "埃洛雯",
                  "text": "如果下次有机会能够再组织上一场「测绘寻物」，我一定再多多设计几个，每个著名骑士的形象都要有…"
                }
              ]
            },
            {
              "text": "已经在期待下一次…",
              "dialogues": [
                {
                  "role": "埃洛雯",
                  "text": "下一次？没错，虽然大家还没相处几天，但是好像已经是拥有不俗默契的战友了！"
                },
                {
                  "role": "埃洛雯",
                  "text": "如果下一次还能有这样共同学习进步的机会，我一定不会错过。"
                },
                {
                  "role": "埃洛雯",
                  "text": "唔…下次我还要准备更多的食材，让大家尝上真正的「战地大餐」…"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          36,
          38
        ],
        [
          39,
          41
        ]
      ]
    }
  ]
}