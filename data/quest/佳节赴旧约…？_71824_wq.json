{
  "quest_id": 71824,
  "chapter_num": null,
  "chapter_title": "佳节赴旧约…？",
  "type": "wq",
  "route": "Promises Remembered as Lanterns Rise",
  "stories": [
    {
      "story_id": 71824,
      "title": "佳节赴旧约…？",
      "description": "望舒客栈的言笑似乎正忙得不可开交…",
      "dialogues": [
        {
          "role": "",
          "text": "得再加紧点了…"
        },
        {
          "role": "旅行者",
          "text": "生意这么好吗？"
        },
        {
          "role": "",
          "text": "没有。这不是正过节吗？客栈里一堆人回去过节了，干活的人少了一堆，活差不多都得我自己来做。"
        },
        {
          "role": "",
          "text": "还好，客人不算太多，我一个人还顶得住。"
        },
        {
          "role": "",
          "text": "咳，我还得谢谢你，上次帮我那个忙，要不是你，我现在估计都没法正常开工…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你最近还…",
            "那她最近…"
          ]
        },
        {
          "role": "旅行者",
          "text": "你最近还…"
        },
        {
          "role": "",
          "text": "没有！绝对没有，相信我，绝对没有！要再来一次，我绝对受不了了…"
        },
        {
          "role": "",
          "text": "你要是真想打听那件事…她的话，就去问问老板吧，我是真…真不知道…"
        },
        {
          "role": "",
          "text": "旅行者，有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于小冥…"
        },
        {
          "role": "",
          "text": "你说她啊，自从上次那件事之后，她就安稳很多了。"
        },
        {
          "role": "",
          "text": "不过，那孩子倒也可怜，之前逢年过节，客栈越是热闹，她就越落寞，所以才经常捣乱，吓坏了客人。"
        },
        {
          "role": "",
          "text": "但她应该也只是想有人陪着她玩吧，毕竟，她也只是个孩子而已…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "能送盏霄灯给她吗？",
            "不知道她喜不喜欢霄灯…"
          ]
        },
        {
          "role": "旅行者",
          "text": "能送盏霄灯给她吗？"
        },
        {
          "role": "",
          "text": "给她送霄灯？嗯…这个主意倒还不错，不过那孩子很难找…"
        },
        {
          "role": "",
          "text": "如果想找她的话，你就在晚上去旁边的树林里，把霄灯挂在树梢上吧。"
        },
        {
          "role": "",
          "text": "这样的话，她应该就能看到了。"
        },
        {
          "role": "",
          "text": "你要是真想打听那件事…她的话，就去问问老板吧，我是真…真不知道…"
        },
        {
          "role": "",
          "text": "如果想找她的话，你就去旁边的树林里，把霄灯挂在树梢上吧。"
        },
        {
          "role": "",
          "text": "这样的话，她应该就能看到了。"
        },
        {
          "role": "",
          "text": "应该就是在这了…不过，她在哪啊…"
        },
        {
          "role": "",
          "text": "呀，大哥哥/大姐姐，你来找我玩啦。"
        },
        {
          "role": "",
          "text": "嘻嘻，你还记得我上次说的话吗？"
        },
        {
          "role": "",
          "text": "那，大哥哥/大姐姐就陪我玩一下…捉迷藏吧。"
        },
        {
          "role": "",
          "text": "怎么样，你们把霄灯送过去了吗？"
        },
        {
          "role": "旅行者",
          "text": "应该…算是送过去了。"
        },
        {
          "role": "",
          "text": "嗯，这样就最好了，这样那孩子应该也会高兴一些吧。"
        },
        {
          "role": "",
          "text": "不知道…那孩子会许什么愿望…"
        }
      ]
    }
  ]
}