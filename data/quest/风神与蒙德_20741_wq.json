{
  "quest_id": 20741,
  "chapter_num": null,
  "chapter_title": "风神与蒙德",
  "type": "wq",
  "route": "Mondstadt and its Archon",
  "stories": [
    {
      "story_id": 20741,
      "title": "风神与蒙德",
      "description": "灾难过去了，葛瑞丝修女想要感谢护佑蒙德城度过这次危机的风之神…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与葛瑞丝对话"
        },
        {
          "type": "subtitle",
          "text": "将一份蒲公英带给葛瑞丝"
        },
        {
          "type": "subtitle",
          "text": "把蒲公英籽交给葛瑞丝"
        },
        {
          "role": "葛瑞丝",
          "text": "您搜集到蒲公英了吗？"
        },
        {
          "role": "旅行者",
          "text": "搜集到了。"
        },
        {
          "role": "葛瑞丝",
          "text": "这些就足够了，请您在这里稍等一下…"
        },
        {
          "role": "葛瑞丝",
          "text": "…巴巴托斯大人，请您聆听我…"
        },
        {
          "role": "派蒙",
          "text": "呜哇…她好虔诚啊，说了好多话。"
        },
        {
          "role": "派蒙",
          "text": "…也不知道那个「卖唱的」能不能听到…"
        },
        {
          "role": "葛瑞丝",
          "text": "好了，这些蒲公英籽交给您，请您帮我上去播撒一下吧。"
        },
        {
          "role": "葛瑞丝",
          "text": "其实是应该我自己去的，但是…以我的身手，就算能爬上去，应该也难得下来了…"
        },
        {
          "role": "葛瑞丝",
          "text": "所以，就拜托您了。"
        },
        {
          "type": "subtitle",
          "text": "在风神像手上播撒蒲公英"
        },
        {
          "type": "subtitle",
          "text": "与葛瑞丝对话"
        },
        {
          "role": "葛瑞丝",
          "text": "您把蒲公英播撒出去了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "已经播撒出去了。",
              "dialogues": []
            },
            {
              "text": "应该会随风飘很远的。",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "那样就太好了，巴巴托斯大人也会更容易注意到。"
                }
              ]
            }
          ]
        },
        {
          "role": "葛瑞丝",
          "text": "无论如何，希望巴巴托斯大人能够听到我的声音。"
        },
        {
          "role": "葛瑞丝",
          "text": "谢谢您愿意帮忙，这是谢礼，请收下吧。愿风神护佑您。"
        }
      ]
    }
  ]
}