{
  "quest_id": 74151,
  "chapter_num": null,
  "chapter_title": "勒鲁瓦·押解",
  "type": "wq",
  "route": "Leroy: Under Guard",
  "stories": [
    {
      "story_id": 74151,
      "title": "勒鲁瓦·押解",
      "description": "茉莉似乎还想前往伯努瓦家看看…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与茉莉对话"
        },
        {
          "role": "茉莉",
          "text": "哥哥姐姐，你们来啦？"
        },
        {
          "role": "派蒙",
          "text": "我叫派蒙，他叫旅行者，以后称呼我们的名字就好啦。"
        },
        {
          "role": "旅行者",
          "text": "茉莉来找伯努瓦吗？"
        },
        {
          "role": "茉莉",
          "text": "对，但我和勒鲁瓦先生都说不上话…唉，这下我的作文写不成了。"
        },
        {
          "role": "派蒙",
          "text": "作文？哦哦，我记起来了，茉莉是为了写家庭作业才做好人好事的。"
        },
        {
          "role": "茉莉",
          "text": "才不是呢，我本来就很喜欢伯努瓦先生，他很…嗯…滑滑的！对，就是滑滑的。"
        },
        {
          "role": "派蒙",
          "text": "噗，这是什么形容，这里该说擅长交际之类的才对吧。"
        },
        {
          "role": "茉莉",
          "text": "好派蒙姐姐，可不可以帮我想想办法？我的文章写不出来了呜。"
        },
        {
          "role": "茉莉",
          "text": "家庭教师小姐说我帮勒鲁瓦先生喂猫的文章「质噗又充满真情实感」，要我接着再写一篇。"
        },
        {
          "role": "派蒙",
          "text": "什么「质噗」啊，是质朴吧。哦，我懂了，难怪你要到伯努瓦家门口来。"
        },
        {
          "role": "茉莉",
          "text": "虽然我是为了家庭作业，但我真的也很喜欢勒鲁瓦先生！他要我向爸爸妈妈问好，我也问了。"
        },
        {
          "role": "茉莉",
          "text": "爸爸妈妈听到伯努瓦先生的名字很不开心，不让我来，我也不知道为什么…"
        },
        {
          "role": "派蒙",
          "text": "茉莉需要写作文的素材还不简单。就像上次一样，帮忙喂一喂猫就好了呀。"
        },
        {
          "role": "茉莉",
          "text": "这样只够写一行，太少了，不行的。"
        },
        {
          "role": "旅行者",
          "text": "我们陪你一起。"
        },
        {
          "role": "派蒙",
          "text": "对，对，就像之前那样。你喂猫，我们来把门口和屋后的污迹清理干净。"
        },
        {
          "role": "派蒙",
          "text": "好了之后我们一起敲门找伯努瓦说话，你不就有内容可以写了吗？"
        },
        {
          "role": "茉莉",
          "text": "对哦，可以这样！派蒙姐姐真聪明，我现在就去喂猫猫。"
        },
        {
          "role": "派蒙",
          "text": "这里可以了吗？现在能告诉我你在想什么了吧。"
        },
        {
          "type": "subtitle",
          "text": "清理门口"
        },
        {
          "type": "subtitle",
          "text": "清理门口"
        },
        {
          "type": "subtitle",
          "text": "和茉莉商量"
        },
        {
          "role": "茉莉",
          "text": "派蒙姐姐，旅行者哥哥，我喂过娜娜了。"
        },
        {
          "role": "派蒙",
          "text": "好了，我们一起去敲门找勒鲁瓦先生吧。"
        },
        {
          "role": "茉莉",
          "text": "但是我有点担心，他会不会不出来呢？最近我来找勒鲁瓦先生，他都不和我说话了。"
        },
        {
          "role": "茉莉",
          "text": "你们来之前我去敲过门，他刚出来，那个凶凶的女婿叔叔就把他拉回去了。"
        },
        {
          "role": "茉莉",
          "text": "很凶的叔叔给了我一点糖，让我回家找爸爸妈妈，然后就把门关上了。"
        },
        {
          "role": "派蒙",
          "text": "伯努瓦明明是很和气的人，他的家人怎么这么冷漠。"
        },
        {
          "role": "茉莉",
          "text": "女婿叔叔说勒鲁瓦先生生病了，不方便，但是我看他很健康啊，为什么不能跟我说话呢？"
        },
        {
          "role": "茉莉",
          "text": "派蒙姐姐，我觉得我的作文不写也没有关系，我更担心勒鲁瓦先生。"
        },
        {
          "role": "茉莉",
          "text": "他生病了的话，一定很难受的，我妈妈说人生病很可怜，要多关心生病的人。"
        },
        {
          "role": "茉莉",
          "text": "你们可不可以跟我一起问问女婿叔叔，勒鲁瓦先生得了什么病。"
        },
        {
          "role": "茉莉",
          "text": "是蛋糕吃太多还是睡觉没有盖好被子？我可以回家去问爸爸妈妈该怎么办。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一起去敲门吧。",
              "dialogues": []
            },
            {
              "text": "本来就约好了的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "茉莉",
          "text": "我就是有点怕女婿叔叔，你们帮我跟他说话好不好？他好凶。"
        },
        {
          "role": "派蒙",
          "text": "别怕，小茉莉，我们帮你问。"
        },
        {
          "type": "subtitle",
          "text": "敲门"
        },
        {
          "role": "？？？",
          "text": "先前见过的阿托斯打开大门，走了出来。"
        },
        {
          "role": "阿托斯",
          "text": "又是你们？你们到底有什么事？"
        },
        {
          "role": "派蒙",
          "text": "请问伯努瓦在家吗？我们听说他生病了，有点担心他的身体。"
        },
        {
          "role": "阿托斯",
          "text": "我父亲在家，但他身体不舒服，不适合出门见客人。"
        },
        {
          "role": "茉莉",
          "text": "可以告诉我他生了什么病吗？我可以请爸爸妈妈帮忙，给勒鲁瓦先生带药来。"
        },
        {
          "role": "阿托斯",
          "text": "不用了，药我们自己会买，更何况我父亲不缺药。"
        },
        {
          "role": "派蒙",
          "text": "我们只是想关心一下病人，干嘛这么冷淡…"
        },
        {
          "role": "派蒙",
          "text": "（这个阿托斯完全不让我们见伯努瓦！）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（冷淡得有点过分…）",
              "dialogues": []
            },
            {
              "text": "（冷淡得有点突然…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿托斯",
          "text": "别人的事情，你们关心得过多了。好了，你们还有别的事吗？没有我就回去了。"
        },
        {
          "role": "旅行者",
          "text": "等一下。"
        },
        {
          "role": "阿托斯",
          "text": "你要说什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "伯努瓦真的生病了吗？",
              "dialogues": [
                {
                  "role": "阿托斯",
                  "text": "当然生病了，他病得很严重，我和莫蒂西娅正在想办法。这一点用不着别人操心。"
                }
              ]
            },
            {
              "text": "为什么阻止我们见伯努瓦？",
              "dialogues": [
                {
                  "role": "阿托斯",
                  "text": "我为什么非要允许不相干的人跑去探望父亲呢？我都说了，他的身体状况不适合见客人。"
                }
              ]
            }
          ]
        },
        {
          "role": "莫蒂西娅",
          "text": "阿托斯，外面在吵什么？"
        },
        {
          "role": "阿托斯",
          "text": "没什么，莫蒂西娅，有几个孩子说要探望爸爸。"
        },
        {
          "role": "莫蒂西娅",
          "text": "……"
        },
        {
          "role": "莫蒂西娅",
          "text": "爸爸，你在小孩子中的人缘真好。"
        },
        {
          "role": "莫蒂西娅",
          "text": "既然有孩子想来看你，那你要不要出面打个招呼呢？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "…我去看看…可以吗？"
        },
        {
          "role": "莫蒂西娅",
          "text": "当然可以，你说了算，爸爸。"
        },
        {
          "role": "？？？",
          "text": "大门打开，伯努瓦从屋内缓缓走了出来。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "小客人们，你们又来了？"
        },
        {
          "role": "茉莉",
          "text": "勒鲁瓦先生，你还好吗？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我？…咳咳，我的身体状况不是很好。但你们不用担心，我正在尽力休养。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我的女儿和女婿待我很好，一切都好，你们回家去吧。"
        },
        {
          "role": "阿托斯",
          "text": "爸爸，你的身体没问题吗？觉得勉强的话，就回家去吧。"
        },
        {
          "role": "？？？",
          "text": "伯努瓦看着阿托斯的眼色，默默进了门。"
        },
        {
          "role": "阿托斯",
          "text": "好了，你们看到了吧，我父亲确实身体不舒服，这下你们满意了吧？没事我就回去了。"
        },
        {
          "role": "派蒙",
          "text": "我们…"
        },
        {
          "role": "？？？",
          "text": "阿托斯无视了你们。"
        },
        {
          "role": "茉莉",
          "text": "这次和勒鲁瓦先生说了两句话，唉，希望他的身体快点好起来。"
        },
        {
          "role": "茉莉",
          "text": "派蒙姐姐，我好像给别人带来麻烦了，其实我不想这样的。"
        },
        {
          "role": "派蒙",
          "text": "茉莉怎么会这么想？你才没有给别人带来麻烦呢，要我说，有问题的是那个阿托斯！"
        },
        {
          "role": "派蒙",
          "text": "哼…什么嘛，他从头到尾…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "茉莉先回家去吧。",
              "dialogues": []
            },
            {
              "text": "我和派蒙也要回去了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸，旅行者你怎么…"
        },
        {
          "role": "茉莉",
          "text": "嗯，我是该回去了。其实爸爸妈妈很不喜欢我到这里来，要是给他们知道我今天去哪儿了，他们会生气的。"
        },
        {
          "role": "茉莉",
          "text": "不知道还有没有机会见到勒鲁瓦先生了，我其实很想告诉他点心特别特别好吃。"
        },
        {
          "role": "茉莉",
          "text": "等他身体好了，如果你们能见到他，替我告诉他好吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "我答应你。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我也答应你。"
        },
        {
          "role": "茉莉",
          "text": "好，谢谢你，旅行者哥哥。"
        },
        {
          "role": "茉莉",
          "text": "我回家去啦，哥哥姐姐再见。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你是不是想到什么了？从刚才开始看你就是一副有话要说的样子。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们到一边去聊吧。",
              "dialogues": []
            },
            {
              "text": "别在这里大声说这些。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧，那我们到别处说。"
        },
        {
          "role": "茉莉",
          "text": "旅行者哥哥，你来敲门好不好？"
        },
        {
          "role": "旅行者",
          "text": "这对夫妇不对劲。"
        },
        {
          "role": "派蒙",
          "text": "我也觉得有点奇怪，他们一个话特别多，一个话特别少。"
        },
        {
          "role": "旅行者",
          "text": "他们出现的时机太巧合了。"
        },
        {
          "role": "派蒙",
          "text": "你的意思是，就在伯努瓦想要招募钟点工照顾自己的时候，他们出现了。"
        },
        {
          "role": "派蒙",
          "text": "记得欧芙小姐说过，大半年之前伯努瓦还需要招募钟点工照顾自己，仅仅是半年时间…"
        },
        {
          "role": "旅行者",
          "text": "这对夫妇成为了他的子女。"
        },
        {
          "role": "派蒙",
          "text": "你说的对。一切都好刻意，这么一想，这对夫妇很有问题欸！"
        },
        {
          "role": "旅行者",
          "text": "这对夫妇和伯努瓦的关系不对劲。"
        },
        {
          "role": "派蒙",
          "text": "前些天遇到的时候他们还和和睦睦的呢，今天看他们交谈的时候总觉得哪里有点别扭…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "伯努瓦在被女婿胁迫。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是因为他才说了两句话，那个女婿就使眼色让他进去吗？"
                }
              ]
            },
            {
              "text": "伯努瓦在被女儿胁迫。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我是没你想得这么远啦，只是觉得那个女儿说话的时候，我有点起鸡皮疙瘩…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "听你这么分析，我有点明白心里那个困惑的感觉是怎么回事了。"
        },
        {
          "role": "旅行者",
          "text": "这对夫妇对待外人的态度不对劲。"
        },
        {
          "role": "派蒙",
          "text": "就是就是，明明刚见面的时候他们都可亲切了，怎么没过多久就变成这副凶巴巴的样子了。"
        },
        {
          "role": "旅行者",
          "text": "他们只在父亲面前对我们友善。"
        },
        {
          "role": "派蒙",
          "text": "唔…我回忆一下。是哦，第一次见面的时候，伯努瓦刚进门，那个女婿就凶巴巴地让我们不要再来了。"
        },
        {
          "role": "旅行者",
          "text": "他们在伪装。"
        },
        {
          "role": "派蒙",
          "text": "他们为什么要在自己的父亲面前装出这副善良的样子呢？总得有个原因吧，为什么啊，想不明白。"
        },
        {
          "type": "subtitle",
          "text": "到一旁与派蒙讨论"
        },
        {
          "role": "茉莉",
          "text": "娜娜，娜娜，勒鲁瓦先生怎么不搭理我了？你知道为什么吗？"
        },
        {
          "role": "旅行者",
          "text": "暂时能想到的就是这些。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你说，伯努瓦他是不是陷入了什么危险？"
        },
        {
          "role": "旅行者",
          "text": "没错。"
        },
        {
          "role": "派蒙",
          "text": "我感觉很不好，我们要不要去报案啊？去和执律庭说一说吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有证据。",
              "dialogues": []
            },
            {
              "text": "事情还不明朗。",
              "dialogues": []
            },
            {
              "text": "不知道伯努瓦的态度。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这样啊，你说的也有道理。总之，我们是要帮助伯努瓦的对吧？"
        },
        {
          "role": "派蒙",
          "text": "小茉莉拜托过我们，要告诉伯努瓦，他给的点心非常好吃，我们答应过她的。"
        },
        {
          "role": "旅行者",
          "text": "我们会做到的。"
        },
        {
          "role": "派蒙",
          "text": "我就知道你说到做到，而且脑子好使，那我们接下来怎么做？"
        },
        {
          "role": "旅行者",
          "text": "去调查一番吧。"
        },
        {
          "role": "派蒙",
          "text": "就由我们来弄清楚到底发生了什么吧！唔…具体来说，我们要调查些什么啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这对夫妇的身份。",
              "dialogues": []
            },
            {
              "text": "这对夫妇的目的。",
              "dialogues": []
            },
            {
              "text": "伯努瓦对他们的态度。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对对对，真相就由我们来揭穿吧！名侦探派蒙、旅行者出动！"
        }
      ]
    }
  ]
}