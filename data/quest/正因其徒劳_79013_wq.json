{
  "quest_id": 79013,
  "chapter_num": null,
  "chapter_title": "正因其徒劳",
  "type": "wq",
  "route": "Thus Was the Work Done in Vain",
  "stories": [
    {
      "story_id": 79013,
      "title": "正因其徒劳",
      "description": "在危危岛上偶然发现了受困于岛上陷阱的冒险家留下的笔记，但已经是很久以前发生的不可更改的事。不过，既然此刻群岛在幻境的影响之下…会不会有，仅在幻境之中的稍稍帮助他的办法？",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "嗯，甜甜花酿鸡真的很好吃。"
        },
        {
          "role": "派蒙",
          "text": "确实能理解为什么这个叫「沃尔夫冈」的冒险家会念念不忘呢！"
        },
        {
          "role": "派蒙",
          "text": "不过被关在这里，最后连甜甜花酿鸡都吃不到，真是可怜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这本笔记很旧了…",
            "应该是很久之前的事…"
          ]
        },
        {
          "role": "派蒙",
          "text": "是哦…但是这么说来…旅行者，还记得我们从岛上的水池那样的东西进入另一边的岛吗…"
        },
        {
          "role": "派蒙",
          "text": "水池里岛上的建筑比起水池外的岛，看上去要完整很多。"
        },
        {
          "role": "派蒙",
          "text": "现在岛上的建筑跟那里的建筑比起来，就像遗迹一样…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "会不会水池里的建筑…",
            "水池里的建筑就是原本的样子…"
          ]
        },
        {
          "role": "派蒙",
          "text": "很有可能！说不定水池里岛上的建筑，就是水池外岛上遗迹很久以前的样子！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你说会不会…"
        },
        {
          "role": "旅行者",
          "text": "水池里的岛，是以前的岛？"
        },
        {
          "role": "派蒙",
          "text": "对！"
        },
        {
          "role": "派蒙",
          "text": "而且，你看…我们要是找到了以前的这个密室在哪，不就能够救到这个冒险家了吗！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "只是发生在幻境的影响里…",
            "是改变不了现实的…"
          ]
        },
        {
          "role": "派蒙",
          "text": "可是…就算一切都是假的，这个冒险家说不定也不存在，但看到他说的那么可怜，也是想帮一下的嘛…"
        },
        {
          "role": "派蒙",
          "text": "旅行者…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "确实，派蒙说得对。",
            "那就去看看…"
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！我就知道旅行者也会这样觉得的！"
        },
        {
          "role": "派蒙",
          "text": "我们这就去水池里的岛那儿看看吧！"
        },
        {
          "type": "subtitle",
          "text": "找到开门办法，与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "门打开了！真是有点麻烦的机关…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，这里好像还没有沃尔夫冈的笔记…"
        },
        {
          "role": "旅行者",
          "text": "说明他还没来过…"
        },
        {
          "role": "派蒙",
          "text": "那我们就算提前帮他解开密室了…这下他就不会被关起来了吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "若是反复触发的机关…",
            "就算这次解开了…"
          ]
        },
        {
          "role": "派蒙",
          "text": "那怎么办呀…唔，不如我们给他留言！"
        },
        {
          "role": "派蒙",
          "text": "我们用刻痕，把留言留在比较显眼的地方，告诉他解开机关的方法吧！"
        },
        {
          "role": "派蒙",
          "text": "嗯！就在这里留言吧，这下他应该能看得见了！"
        },
        {
          "role": "派蒙",
          "text": "我们现在回到水池外的岛上吧…说不定就没有那本笔记了！"
        },
        {
          "type": "subtitle",
          "text": "留下刻痕，返回查看笔记"
        },
        {
          "role": "派蒙",
          "text": "他居然真的从那个密室里逃出来了诶！居然还夸自己细心…留言的刻痕明明就是我们特意留在显眼处的！"
        },
        {
          "role": "派蒙",
          "text": "还有，这个人到底随身带着多少本笔记本啊…"
        },
        {
          "role": "派蒙",
          "text": "唉…没想到他被关密室，居然没有回去，还敢继续冒险…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "因为他解决了危机…",
            "因为他逃脱了密室…"
          ]
        },
        {
          "role": "派蒙",
          "text": "是哦，原本将他一直困着的密室，现在就变成了他轻易克服的困难之一啦…"
        },
        {
          "role": "派蒙",
          "text": "不过，他说的山上的遗迹，在水池外的岛上就看不见了。"
        },
        {
          "role": "旅行者",
          "text": "毕竟过了很久嘛…"
        },
        {
          "role": "派蒙",
          "text": "不会是崩塌了，然后落到海里去了吧…总觉得好像在外面的海面上看到过类似的建筑…"
        },
        {
          "role": "派蒙",
          "text": "我们有空的时候就到附近的海上看看吧！"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "这个笔记…啊，是「沃尔夫冈」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "又困在密室里了…",
            "没有吸取到教训呢…"
          ]
        },
        {
          "role": "派蒙",
          "text": "只有吃到苦头的人才能吸取到教训呢…"
        },
        {
          "role": "派蒙",
          "text": "这个海底的建筑…应该就是水池那一边岛上，山上的遗迹…旅行者，我们去水池里的岛上看看吧。"
        },
        {
          "role": "派蒙",
          "text": "这次也是一样，沃尔夫冈还没留下笔记，他还没有到这里来。"
        },
        {
          "role": "派蒙",
          "text": "我们这次也留下如何解开密室的提示吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这次解开密室的方法…",
            "如果不使用元素力量…"
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，如果沃尔夫冈没法使用元素力量的话…"
        },
        {
          "role": "派蒙",
          "text": "就算知道解法也没有用。那该怎么办呀…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "只要不让他进来…",
            "在门外留言吧！"
          ]
        },
        {
          "role": "派蒙",
          "text": "哦！原来如此，只要在门外给提示，说这里有密室！"
        },
        {
          "role": "派蒙",
          "text": "他就不会进来，也不会被困在遗迹里了！"
        },
        {
          "role": "派蒙",
          "text": "我们快点给他留言吧！"
        },
        {
          "role": "派蒙",
          "text": "留在这里应该够显眼了吧！"
        },
        {
          "role": "派蒙",
          "text": "希望沃尔夫冈能够看到，不要再跑到这个遗迹的密室里来了…"
        },
        {
          "role": "派蒙",
          "text": "我们回去看看吧，说不定这次笔记也会有变化啦。"
        },
        {
          "type": "subtitle",
          "text": "留下刻痕，返回查看笔记"
        },
        {
          "role": "派蒙",
          "text": "好歹他没有再进去啦，真是松了口气…"
        },
        {
          "role": "派蒙",
          "text": "但是不知道为什么看他洋洋得意的样子，总觉得有点生气呢！"
        },
        {
          "role": "旅行者",
          "text": "总觉得更得意了一点…"
        },
        {
          "role": "派蒙",
          "text": "不过他说高处的遗迹，应该就在上次掉落在海里的遗迹旁边…"
        },
        {
          "role": "派蒙",
          "text": "我们去看看吧…真不知道他能不能安全爬到那么高的地方…"
        },
        {
          "role": "刻痕",
          "text": "（老旧的刻痕，留下刻痕的人写着…）"
        },
        {
          "role": "刻痕",
          "text": "「风很大，就不用笔记本了。」"
        },
        {
          "role": "刻痕",
          "text": "「这里日出很美，历经艰险来到此处，心中十分满足。」"
        },
        {
          "role": "刻痕",
          "text": "「不知在我之后，是否有人能来这儿看到同样的景色呢。」"
        },
        {
          "role": "刻痕",
          "text": "「…如此险境我也来过了，下次，就去龙脊雪山吧！」"
        },
        {
          "role": "刻痕",
          "text": "「此处甚好，可惜没有甜甜花酿鸡…」"
        },
        {
          "role": "刻痕",
          "text": "「沃尔夫冈留。」"
        },
        {
          "role": "派蒙",
          "text": "就说怎么没有笔记本，原来是把留言刻在柱子上…这家伙成功到这儿啦。"
        },
        {
          "role": "派蒙",
          "text": "不过，他到底哪来的信心…要是没有我们帮他，他早就困在遗迹的密室里了。"
        },
        {
          "role": "派蒙",
          "text": "他去雪山，一定会被冻成「冷鲜肉」的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "「冷鲜肉」有点过分了…",
            "肯定会遇到危险吧…"
          ]
        },
        {
          "role": "派蒙",
          "text": "我、我是说，他去雪山，肯定会遭遇危险的啦。"
        },
        {
          "role": "派蒙",
          "text": "我们得告诉他，不能去雪山呀！"
        },
        {
          "role": "旅行者",
          "text": "那就再给他留一次言吧…"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，我也是这么想的…对了，这一次，再准备一份甜甜花酿鸡！"
        },
        {
          "role": "派蒙",
          "text": "说不定他吃了甜甜花酿鸡，就会想起蒙德的温暖，不会去雪山了！"
        },
        {
          "role": "旅行者",
          "text": "甜甜花酿鸡会坏掉的吧…"
        },
        {
          "role": "派蒙",
          "text": "嗯…只是一份心意啦！"
        },
        {
          "role": "派蒙",
          "text": "希望沃尔夫冈能够打消去雪山的念头…"
        },
        {
          "role": "派蒙",
          "text": "我们通过水池出去以后，就去刚才的遗迹看看吧…说不定就能读到他回心转意的刻痕了！"
        },
        {
          "type": "subtitle",
          "text": "留下刻痕，返回查看笔记"
        },
        {
          "role": "刻痕",
          "text": "（老旧的刻痕，留下刻痕的人写着…）"
        },
        {
          "role": "刻痕",
          "text": "「风很大，就不用笔记本了。」"
        },
        {
          "role": "刻痕",
          "text": "「上来发现尚有余温的甜甜花酿鸡，简直就是奇迹！」"
        },
        {
          "role": "刻痕",
          "text": "「先不提谁留的，竟然知道我想吃甜甜花酿鸡，虽觉得奇怪，但更多的仍是感谢之情。」"
        },
        {
          "role": "刻痕",
          "text": "「感谢留下刻痕的人，你的甜甜花酿鸡是我吃过的最好吃的甜甜花酿鸡。」"
        },
        {
          "role": "刻痕",
          "text": "「谢谢，我知道雪山危险，也有自知之明…但我还是想去雪山。」"
        },
        {
          "role": "刻痕",
          "text": "「我去雪山，耗尽生命，也许只能留下『此处有陷阱』的提示。」"
        },
        {
          "role": "刻痕",
          "text": "「可是若有人因此绕过危险，较之我所达到之处，再向前一步。于我而言，就是比吃甜甜花酿鸡还幸福之事了。」"
        },
        {
          "role": "刻痕",
          "text": "「谢谢你，留下刻痕之人，正是因为雪山危险，所以才有冒险家嘛。」"
        },
        {
          "role": "刻痕",
          "text": "「爱你的，沃尔夫冈留。」"
        },
        {
          "role": "派蒙",
          "text": "什么呀，这家伙只顾着说一些帅气的话…"
        },
        {
          "role": "派蒙",
          "text": "不行，我们得去雪山…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "幻境中的改变，改变不了过去…",
            "「沃尔夫冈」是到不了雪山的…"
          ]
        },
        {
          "role": "派蒙",
          "text": "…啊…对哦，金苹果群岛整个都被那个装置影响，沃尔夫冈才…"
        },
        {
          "role": "派蒙",
          "text": "所以我才以为沃尔夫冈已经被救出密室了…其实到最后，他都在最初的密室里没有出来吧…"
        },
        {
          "role": "派蒙",
          "text": "不过！不过这个「沃尔夫冈」还是让人生气…我们都那么帮助他了，他还觉得「帮别人踩坑」就不错…"
        },
        {
          "role": "派蒙",
          "text": "他就不能，更珍惜自己的生命一点吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "每个人都有追求之物…",
            "正是因为有他们…"
          ]
        },
        {
          "role": "派蒙",
          "text": "我明白啦，我知道…"
        },
        {
          "role": "派蒙",
          "text": "但是我还是觉得他们应该有更好的结局嘛，比如回到蒙德，成为大冒险家…然后还能去餐馆逗猫，尽情地吃甜甜花酿鸡…"
        },
        {
          "role": "派蒙",
          "text": "为什么他们就不能有个好结局呢。"
        }
      ]
    }
  ]
}