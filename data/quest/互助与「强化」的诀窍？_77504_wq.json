{
  "quest_id": 77504,
  "chapter_num": null,
  "chapter_title": "互助与「强化」的诀窍？",
  "type": "wq",
  "route": "The Way of Mutual Aid and Advancement?",
  "stories": [
    {
      "story_id": 77504,
      "title": "互助与「强化」的诀窍？",
      "description": "总算来到了至冬，你和派蒙打算抽空去海屑镇看看…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "说起来，达达利亚的家乡好像就在这附近来着？"
        },
        {
          "role": "派蒙",
          "text": "等到有空了，去那边看看怎么样？"
        },
        {
          "type": "subtitle",
          "text": "去海屑镇转转"
        },
        {
          "role": "？？？",
          "text": "咦？还有别的新人吗？"
        },
        {
          "role": "派蒙",
          "text": "欸？新人？在说我们俩？"
        },
        {
          "role": "？？？",
          "text": "你们穿得不像本地人，又在这附近转悠，难道是小松果和木头人的朋友？"
        },
        {
          "role": "？？？",
          "text": "不管那么多了，海屑镇的「强化互助会」欢迎你们！"
        },
        {
          "role": "琪琪科娃",
          "text": "就让我——得到了凯瑟琳大人的祝福，塔拉利欣大哥的肯定，还有「新锋」之眷顾的琪琪科娃，好好关照你们吧~"
        },
        {
          "role": "派蒙",
          "text": "强化…互助会？没听过的名字…"
        },
        {
          "role": "琪琪科娃",
          "text": "顾名思义，是帮助大家不断变强，成为高手的团队哦。"
        },
        {
          "role": "琪琪科娃",
          "text": "只要你有着闯出一片天地的志气，就能与我们同行！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好呀好呀，我当然有志气。",
              "dialogues": []
            },
            {
              "text": "没错，我们都是需要帮助的新人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "琪琪科娃",
          "text": "那就跟着我走吧，带你们去和大家碰面。"
        },
        {
          "role": "琪琪科娃",
          "text": "正好，我们也要开始这一期的活动了，你们赶上了好时候！"
        },
        {
          "role": "派蒙",
          "text": "喂喂，你怎么就顺着她的话说下去了？"
        },
        {
          "role": "派蒙",
          "text": "我知道你有谦虚的时候，不过，真的要装成新人吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "迎合一下有干劲的孩子也不错？",
              "dialogues": []
            },
            {
              "text": "偶尔也可以扮演普通人试试嘛。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呜啊，你是不是被尼可影响了，开始想着…体验体验轻小说式的情节？"
        },
        {
          "role": "派蒙",
          "text": "…搞得我也有点想试试看了。"
        },
        {
          "type": "subtitle",
          "text": "跟上了琪琪科娃，来到了车站旁不远的碰头地点。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "琪琪科娃",
          "text": "好啦，这里就是我们的据点了。"
        },
        {
          "role": "派蒙",
          "text": "喔，除了至冬本地人，也有纳塔和璃月的孩子？"
        },
        {
          "role": "「小松果」",
          "text": "嗯？木头人，怎么感觉，这个大哥哥看起来好眼熟？"
        },
        {
          "role": "「燃爆木头人」",
          "text": "等等，小松果，我应该没眼花啊？他是是是是是是…"
        },
        {
          "role": "「燃爆木头人」",
          "text": "杜杜杜杜杜杜杜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嘟嘟可超级可爱？",
              "dialogues": []
            },
            {
              "text": "嘟嘟大魔王好坏？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘘——"
        },
        {
          "role": "派蒙",
          "text": "该怎么说好呢，唔…旅行者现在还不想被知道真实身份。"
        },
        {
          "role": "「燃爆木头人」",
          "text": "难道是在…执行特殊任务？我好像明白了。"
        },
        {
          "role": "「小松果」",
          "text": "我们会保密的！"
        },
        {
          "role": "琪琪科娃",
          "text": "咦，你们说的话好难懂啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是接头暗号喔。",
              "dialogues": []
            },
            {
              "text": "是道上的行话。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "啊对，我们跟着小松果和木头人混，当然会有专业用语。"
        },
        {
          "role": "「燃爆木头人」",
          "text": "我？她？杜麦尼…跟着我们混？"
        },
        {
          "role": "「小松果」",
          "text": "我我我，我们赶紧去写信，告诉维热姐姐这件事！"
        },
        {
          "role": "琪琪科娃",
          "text": "没看出来，你们还挺专业的！难怪能从热热的纳塔翻越高山和大海，来到冰冰凉凉的至冬…"
        },
        {
          "role": "琪琪科娃",
          "text": "要吃点黑列巴配暖汤吗？恢复恢复精神，然后我们就可以开始正题啦？"
        },
        {
          "role": "派蒙",
          "text": "这么熟练…你很有姐姐的样子嘛。"
        },
        {
          "role": "琪琪科娃",
          "text": "当然，把互助会托付给我的两位大哥，可是专业的冒险者哦。我也会继承他们的精神，成为帮助大家的行家。"
        },
        {
          "role": "派蒙",
          "text": "聚在一起吃零食确实能快快恢复元气，不过，要变成行家只靠这点还不够…"
        },
        {
          "role": "派蒙",
          "text": "你还有什么计划吗？"
        },
        {
          "role": "琪琪科娃",
          "text": "哼哼，我们的诀窍在于「无上限分享」——"
        },
        {
          "role": "琪琪科娃",
          "text": "我们都知道，冒险家协会是一个比较松散的组织。凯瑟琳大人给大家派发任务，有能力的强者赢下一切。"
        },
        {
          "role": "琪琪科娃",
          "text": "但有的强者之间反而会互相提防，吝惜自己的诀窍，这就让一些经验没法在同行之中流通。"
        },
        {
          "role": "琪琪科娃",
          "text": "比如，明明有简单办法打赢某只魔物，却有好几拨人绕了不同的弯子，撞得头破血流。"
        },
        {
          "role": "派蒙",
          "text": "是这个道理…在其他领域，这样的案例好像也不少…"
        },
        {
          "role": "琪琪科娃",
          "text": "是啊！用一个枫丹大哥的话来说，「重复发明轮子的情节，每天都在全提瓦特各地上演。」"
        },
        {
          "role": "派蒙",
          "text": "可以理解，毕竟冒险家们不全都互相认识，也不会每干成一件委托，就聚在一起进行讨论吧？"
        },
        {
          "role": "琪琪科娃",
          "text": "不太明白他们的作风。反正，我们「强化互助会」要打破这种僵局。"
        },
        {
          "role": "琪琪科娃",
          "text": "互助会最重要的事，就是像分享好吃的东西一样，在内部共享各种心得和道具。"
        },
        {
          "role": "琪琪科娃",
          "text": "不限于标满重要地点的地图、写着独门诀窍的笔记、剑法古籍、绝世宝剑部件等各种好东西。"
        },
        {
          "role": "琪琪科娃",
          "text": "当然，成员们富余的装备和物资也会在这里共享，甚至还有互赠的礼物哦。"
        },
        {
          "role": "琪琪科娃",
          "text": "等到各种力量被汇聚起来，越来越多的人，就能越来越轻松地解决越来越广的问题！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有意思的想法。",
              "dialogues": []
            },
            {
              "text": "非常棒的目标。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那，现在的进展怎么样呢？"
        },
        {
          "role": "琪琪科娃",
          "text": "咳咳，这个嘛…因为我们最近才重新开始活动，所以目前成员也没恢复到最厉害那时候的水平。"
        },
        {
          "role": "琪琪科娃",
          "text": "我想先让大家熟悉至冬的环境，所以做了探索各种地点的计划。"
        },
        {
          "role": "琪琪科娃",
          "text": "只要抵达了指定的地方，好好考察那里的情况，用我们的留影机记录下来，再拿野外的一些陈设练练手，就算成功！"
        },
        {
          "role": "派蒙",
          "text": "也，也对，目前看来，你和成员们的年纪都不大，一开始就尝试非常难的挑战，也有点危险。"
        },
        {
          "role": "琪琪科娃",
          "text": "虽然我们现在还没有什么厉害的成就…但，互助会被交到我手里之前，的确帮过不少人。"
        },
        {
          "role": "琪琪科娃",
          "text": "我相信只要我们一起努力，每天互相敦促，就每天都能变强！"
        },
        {
          "role": "派蒙",
          "text": "好喔，真是干劲满满，态度值得肯定！"
        },
        {
          "role": "派蒙",
          "text": "我和旅行者最擅长探索不熟悉的地方了，就让我们也出一份力，给互助会提供一点支援？"
        },
        {
          "role": "派蒙",
          "text": "也是为了…感谢琪琪科娃的热情、还有黑列巴和浓汤。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "互相扶持的感觉很不错。",
              "dialogues": []
            },
            {
              "text": "看见新人成长很有意思。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "琪琪科娃",
          "text": "我准备准备，也要出发了！如果你们有收获的话，可以抽空回来看看，顺带检查一下据点里的收件箱？"
        },
        {
          "role": "琪琪科娃",
          "text": "没准会有惊喜的收获呢~"
        },
        {
          "type": "subtitle",
          "text": "额外对话（琪琪科娃）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「燃爆木头人」&「小松果」）"
        },
        {
          "role": "「燃爆木头人」",
          "text": "杜杜杜杜杜杜杜杜麦尼！您是不是有什么秘密任务？不方便透露身份？"
        },
        {
          "role": "「小松果」",
          "text": "需要我们做什么吗？虽然我们本领不强，但您交待的任务，我们一定全力以赴！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "任务是让大家一起变强。",
              "dialogues": [
                {
                  "role": "「燃爆木头人」",
                  "text": "那那那，我们已经开始锻炼了，不会让您失望的！"
                },
                {
                  "role": "「小松果」",
                  "text": "琪琪科娃姐姐让我们用留影机观察各种小动物，我们就去找猎人学习，不惊动它们..."
                },
                {
                  "role": "「小松果」",
                  "text": "这种本领，就是一些烟谜主勇士精通的「潜伏」吧？也可以用在竞技比赛里！"
                },
                {
                  "role": "「燃爆木头人」",
                  "text": "还有还有，对着手册到处转悠，路上都会碰到厚厚的积雪，还有厉害的风雪..."
                },
                {
                  "role": "「燃爆木头人」",
                  "text": "我们也要适应冷冷的环境，学会使用更多新鲜的冰雕！"
                }
              ]
            },
            {
              "text": "先说说你们的情况？",
              "dialogues": [
                {
                  "role": "「燃爆木头人」",
                  "text": "啊，我们...我们是来远游锻炼的。"
                },
                {
                  "role": "「燃爆木头人」",
                  "text": "「小松果」的爸爸，也就是「塞提阿德的砂刃」阿姆鲁叔叔，教了我们很多战斗的本领。"
                },
                {
                  "role": "「小松果」",
                  "text": "但是因为常年在纳塔待着，不了解其他地方的战士，也不太像话。"
                },
                {
                  "role": "「小松果」",
                  "text": "所以，爸爸就给了我们一大笔旅费，让我们来至冬好好锻炼一番。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "放你们两个小孩到国外玩吗...",
                      "dialogues": []
                    },
                    {
                      "text": "这么看来，你爸也是真心大...",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "「燃爆木头人」",
                  "text": "我，我们都不小了哦，我已经十二岁了，「小松果」也十岁了！"
                },
                {
                  "role": "「燃爆木头人」",
                  "text": "「沃陆之邦」的瓦雷莎姐姐在我们这么大的时候，好像都已经打败过几百只魔物了。"
                },
                {
                  "role": "「燃爆木头人」",
                  "text": "再过几年，我们也该像基尼奇哥哥和阿乔领主那样，成为部族的正式战士。"
                },
                {
                  "role": "「燃爆木头人」",
                  "text": "这回只是出国锻炼一下，跟着琪琪科娃姐姐，找了几只大白熊练了练拳击和摔跤而已。"
                },
                {
                  "role": "「燃爆木头人」",
                  "text": "完全没有招惹厉害的家伙，不会有事的！"
                },
                {
                  "role": "「小松果」",
                  "text": "爸爸说过，老是待在安逸的环境里，人会变呆变慢。"
                },
                {
                  "role": "「小松果」",
                  "text": "大喜儿姐姐也说，璃月人都抱着一种，怎么说的来着...那种心态，在努力锻炼。"
                },
                {
                  "role": "「燃爆木头人」",
                  "text": "...居安思危？"
                },
                {
                  "role": "「小松果」",
                  "text": "对的对的，居安思危！"
                },
                {
                  "role": "「小松果」",
                  "text": "随时做好坏家伙还会冒出来的准备，全力锻炼，碰见不妙的情况，就不会慌张。"
                },
                {
                  "role": "「小松果」",
                  "text": "等到下次，纳塔需要更多战士的时候，我和木头人都要站出来帮忙！"
                }
              ]
            },
            {
              "text": "没事，不打扰你们玩啦。",
              "dialogues": [
                {
                  "role": "「燃爆木头人」",
                  "text": "我我我，其实我还蛮想被杜麦尼打扰的..."
                },
                {
                  "role": "「小松果」",
                  "text": "感觉...杜麦尼还有事？等你不那么忙了，请和我们一起玩吧！几分钟也好！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（大喜儿）"
        }
      ],
      "collapse_ranges": [
        [
          67,
          67
        ],
