  "stories": [
    {
      "story_id": 71808,
      "title": "南天门之谜",
      "description": "璃月港的嘉义似乎又陷入了麻烦之中，正想找人帮忙…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "到南天门调查异常"
        },
        {
          "role": "阿鸠",
          "text": "待苏醒之时…"
        },
        {
          "role": "旅行者",
          "text": "你还好吗？"
        },
        {
          "role": "阿鸠",
          "text": "你是想要来见证「那位」的复苏吗？"
        },
        {
          "role": "阿鸠",
          "text": "你来得稍微早了些…不过，也不算太晚。"
        },
        {
          "role": "派蒙",
          "text": "她在说什么呀，完全听不懂…"
        },
        {
          "role": "旅行者",
          "text": "呃，你在说什么？"
        },
        {
          "role": "阿鸠",
          "text": "呵呵，你还没有意识到么…"
        },
        {
          "role": "阿鸠",
          "text": "对你来说，这样也不错。"
        },
        {
          "role": "阿鸠",
          "text": "回去吧，等到「那位」复苏的时候，你会明白一切的。"
        },
        {
          "type": "subtitle",
          "text": "到南天门调查异常"
        },
        {
          "type": "subtitle",
          "text": "到南天门调查异常"
        },
        {
          "role": "嘉义",
          "text": "唉，真是做不完的事…"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "这里也没什么奇怪的地方。"
        },
        {
          "role": "派蒙",
          "text": "咦？那里怎么有个小女孩…"
        },
        {
          "role": "派蒙",
          "text": "地，地震了！怎么回事？"
        },
        {
          "role": "派蒙",
          "text": "小心点，我总感觉有些不太妙…"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "type": "subtitle",
          "text": "到周围调查"
        },
        {
          "role": "阿鸠",
          "text": "等到「那位」复苏的时候，你会明白一切的。"
        },
        {
          "type": "subtitle",
          "text": "向嘉义回报"
        },
        {
          "role": "嘉义",
          "text": "你回来了，情况怎么样？"
        },
        {
          "role": "旅行者",
          "text": "关于南天门的情况…"
        },
        {
          "role": "嘉义",
          "text": "地震、魔物，还有个小女孩…是谁家孩子走失了吗？"
        },
        {
          "role": "旅行者",
          "text": "关于小女孩说的话…"
        },
        {
          "role": "嘉义",
          "text": "那个孩子说什么了？「那位」的复苏？见证？这都什么乱七八糟的…"
        },
        {
          "role": "嘉义",
          "text": "准是又看了什么奇奇怪怪的书…算了，我马上去安排人，把那孩子带回城里来。"
        },
        {
          "role": "嘉义",
          "text": "又是地震又是魔物，那孩子可别被伤着了。"
        },
        {
          "role": "嘉义",
          "text": "谢谢你，这些东西请你收下吧，辛苦你帮我跑这一趟了。"
        },
        {
          "role": "嘉义",
          "text": "唉，事情真是只多不少…"
        },
        {
          "type": "subtitle",
          "text": "向嘉义回报"
        },
        {
          "role": "嘉义",
          "text": "你回来了，情况怎么样？"
        },
        {
          "role": "旅行者",
          "text": "好像一切正常…"
        },
        {
          "role": "嘉义",
          "text": "一切正常？没有地震，也没有魔物？奇怪了…"
        },
        {
          "role": "嘉义",
          "text": "不过，一切正常才是好事。这些东西请你收下，辛苦你帮我跑这一趟了。"
        },
        {
          "role": "嘉义",
          "text": "唉，我去处理其他的事了，事情真是只多不少…"
        },
        {
          "type": "subtitle",
          "text": "向嘉义回报"
        },
        {
          "role": "嘉义",
          "text": "你回来了，情况怎么样？"
        },
        {
          "role": "旅行者",
          "text": "关于南天门的情况…"
        },
        {
          "role": "嘉义",
          "text": "你真的遇见地震了？还有突然出现的魔物…"
        },
        {
          "role": "嘉义",
          "text": "那里有魔物我倒是知道，但地震到底是怎么回事…"
        },
        {
          "role": "嘉义",
          "text": "算了，不管怎么样，还是小心为上吧。"
        },
        {
          "role": "嘉义",
          "text": "我会把这件事具体报告给总务司的，这些东西请你收下，辛苦你帮我跑这一趟了。"
        },
        {
          "role": "嘉义",
          "text": "唉，事情真是只多不少…"
        }
      ]
    }
  ]
}