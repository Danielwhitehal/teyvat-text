{
  "quest_id": 10095,
  "chapter_num": "山中好长日·第二章",
  "chapter_title": "地狱",
  "type": "wq",
  "route": "Hell",
  "stories": [
    {
      "story_id": 76148,
      "title": "狮子奋迅",
      "description": "找回了彩特琳德的失物，也顺便解放了三个区域，但问题还没有完全解决…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和彩特琳德一起离开"
        },
        {
          "type": "subtitle",
          "text": "你们准备离开时被梅兰塔阻碍，你们被红色方块转移到了不同的空间…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "向前…"
        },
        {
          "type": "subtitle",
          "text": "你发现自己身处最初的蒙德海岸…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "喂，快醒醒——喂——"
        },
        {
          "role": "派蒙",
          "text": "约好一起看日出，你怎么又睡过去了？"
        },
        {
          "role": "旅行者",
          "text": "（派蒙的声音？派蒙去哪里了？）"
        },
        {
          "role": "旅行者",
          "text": "（呃…）"
        },
        {
          "type": "subtitle",
          "text": "你来到了一片黑暗的空间，依次走过象征着「沙上楼阁」、麓阳书院和大方广的区域…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "须弥男性（气泡文字）",
          "text": "啊啊啊，我做不到啊！"
        },
        {
          "role": "梅兰塔（飘浮文字）",
          "text": "{{颜色|红|若不能放弃一切渴望，则不能进入此门。}}"
        },
        {
          "role": "阿罗逻（气泡文字）",
          "text": "我们须弥认为作无想定是要投生无想天的！"
        },
        {
          "role": "阿罗逻（气泡文字）",
          "text": "名为天堂，实为地狱啊！"
        },
        {
          "role": "梅兰塔（飘浮文字）",
          "text": "{{颜色|红|此处非天非狱，非有非无。}}"
        },
        {
          "role": "枫丹女性（气泡文字）",
          "text": "我已经放弃一切渴望了。"
        },
        {
          "role": "梅兰塔（飘浮文字）",
          "text": "{{颜色|红|永远记得此刻的心境。你与世界再无关系。}}"
        },
        {
          "role": "梅兰塔（飘浮文字）",
          "text": "{{颜色|红|永远，留在此处。}}"
        },
        {
          "role": "梅兰塔（飘浮文字）",
          "text": "{{颜色|红|因为你，无法放弃你的渴望。}}"
        },
        {
          "role": "派蒙",
          "text": "喂，快醒醒——喂——"
        },
        {
          "type": "subtitle",
          "text": "打破阻碍"
        },
        {
          "type": "subtitle",
          "text": "发起攻击，打破阻碍吧",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "向前探索"
        },
        {
          "role": "梅兰塔",
          "text": "你当静思，觉察念头如何升起，心如何工作…"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|辖域守护者|2}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "借助小右的力量，将其撕裂",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|辖域守护者|2}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "借助小右的力量，将其撕裂",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "击败'''{{图标|无想报真悟天障}}'''",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "与伊斯托利亚对话"
        },
        {
          "role": "伊斯托利亚",
          "text": "又回到这里了…"
        },
        {
          "role": "伊斯托利亚",
          "text": "上次来这里，按照人的寿命来算都是前前前前前前…世时候的事了吧。"
        },
        {
          "role": "伊斯托利亚",
          "text": "看来我们都被重新投入无想之间了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以我们应该怎么出去？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊斯托利亚",
          "text": "常规办法就是学习冥想，控制心和思绪。然后抛弃所有渴望的念头。"
        },
        {
          "role": "伊斯托利亚",
          "text": "保持什么都不想的状态。"
        },
        {
          "role": "伊斯托利亚",
          "text": "说着挺简单的。但是根据人的素质和渴望程度之不同，办到这一点从几年到几百年的都有。"
        },
        {
          "role": "伊斯托利亚",
          "text": "像你这种背负世界命运的人，渴望恐怕无法被自己割舍吧。何况也不应该被舍弃。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那怎么办？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊斯托利亚",
          "text": "先找到彩特琳德再想办法吧。"
        },
        {
          "role": "小右",
          "text": "！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你捡来了什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊斯托利亚",
          "text": "等等，小右也一起被拉进来了？"
        },
        {
          "role": "伊斯托利亚",
          "text": "那么这一切或许还有转机。"
        },
        {
          "role": "伊斯托利亚",
          "text": "同为守望者，或许小右可以利用这些碎片里的力量。强行开辟一条出路。"
        },
        {
          "role": "伊斯托利亚",
          "text": "这个碎片总归是需要个名字方便称呼的。"
        },
        {
          "role": "伊斯托利亚",
          "text": "这些过于夸张的棺材我略有耳闻，是神殿主人某个姐妹{{#info:[[若娜瓦]]}}的布置。好像是叫做「死随念棺」。"
        },
        {
          "role": "伊斯托利亚",
          "text": "那这些碎片就叫做「念亡碎片」吧。"
        },
        {
          "type": "subtitle",
          "text": "收集「念亡碎片」"
        },
        {
          "role": "伊斯托利亚",
          "text": "借助小右的力量拉伸方块。"
        },
        {
          "type": "subtitle",
          "text": "爬到高处去吧",
          "narration": true,
          "color": "蓝"
        },
        {
          "type": "subtitle",
          "text": "击败'''{{图标|无想报真悟天障}}'''",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "？？？",
          "text": "是谁？是谁！？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者。如今这个时代的人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿罗逻",
          "text": "虽然我不知道你们的时代，但是我叫阿罗逻，本是寂静期行者。"
        },
        {
          "role": "阿罗逻",
          "text": "来到这里已经记不得时间了。甚至这里把我的寂静之修行破掉了。"
        },
        {
          "role": "阿罗逻",
          "text": "果然，无念无想的修行会让人投生无想恶天啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "举手之劳。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "千万别谢谢我。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿罗逻",
          "text": "谢谢啊！"
        },
        {
          "role": "伊斯托利亚",
          "text": "虽然救你是顺手而为。不过我们准备找找冥想之外的办法离开这里。"
        },
        {
          "role": "阿罗逻",
          "text": "你们不擅长冥想吗？或者你们的时代不教授这种技术？"
        },
        {
          "role": "伊斯托利亚",
          "text": "我第一次离开这里花了数百年的岁月。我舍弃了我对真理的追求，舍弃了见到亲朋的渴爱。"
        },
        {
          "role": "伊斯托利亚",
          "text": "这一次我不愿意再放弃这些了。"
        },
        {
          "role": "阿罗逻",
          "text": "算我一个。"
        },
        {
          "role": "小右",
          "text": "！"
        },
        {
          "role": "伊斯托利亚",
          "text": "小右又捡到一个「念亡碎片」。"
        },
        {
          "role": "阿罗逻",
          "text": "念亡？哦，死随念这种冥想技术我也知道。它能让人锻炼面对死亡之时的心境。"
        },
        {
          "type": "subtitle",
          "text": "击败'''{{图标|无想报真悟天障}}'''",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "彩特琳德",
          "text": "咳咳咳。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你没事吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "彩特琳德",
          "text": "我…没事。我做了一个很长很长的噩梦。"
        },
        {
          "role": "彩特琳德",
          "text": "算了。上一句话当我没说。"
        },
        {
          "role": "彩特琳德",
          "text": "我忍不了了。为什么我要遇到这种事情。"
        },
        {
          "role": "彩特琳德",
          "text": "为什么我总要遇到这些事情。爸爸妈妈，然后是姐姐…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没事的，我在。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "彩特琳德",
          "text": "嗯。我没有生你们的气。"
        },
        {
          "role": "小右",
          "text": "♪~"
        },
        {
          "role": "彩特琳德",
          "text": "小右捡了个什么东西？"
        },
        {
          "role": "伊斯托利亚",
          "text": "我把这个叫做「念亡碎片」，或许是向死而生的出路。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一起走吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "彩特琳德",
          "text": "嗯。"
        },
        {
          "role": "伊斯托利亚",
          "text": "既然找到琳德了。我们就去找找出去的办法吧。"
        },
        {
          "role": "阿罗逻",
          "text": "这里真的可以靠实力出去吗？"
        },
        {
          "role": "伊斯托利亚",
          "text": "既然梅兰塔和尼西里塔可以自由往来，通常都还会带人出入。那小右应该也可以。"
        },
        {
          "role": "小右",
          "text": "♪~"
        },
        {
          "role": "伊斯托利亚",
          "text": "现在收集到了三枚「念亡碎片」。"
        },
        {
          "role": "伊斯托利亚",
          "text": "哦，这个是暂定名。因为我也不知道小右收集这个要做什么。"
        },
        {
          "role": "伊斯托利亚",
          "text": "小右，接下来怎么办？"
        },
        {
          "role": "小右",
          "text": "！"
        },
        {
          "role": "伊斯托利亚",
          "text": "跟着它指示的方向走吧。"
        },
        {
          "type": "subtitle",
          "text": "解除封印"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "解除封印",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿罗逻",
          "text": "有个什么东西浮出来了！"
        },
        {
          "role": "伊斯托利亚",
          "text": "小右、旅行者，麻烦你们了。"
        },
        {
          "type": "subtitle",
          "text": "借助小右的能力，打开通路"
        },
        {
          "role": "伊斯托利亚",
          "text": "虽然不确定是不是出路，但是好像只能先上去看看了。"
        },
        {
          "type": "subtitle",
          "text": "登上阶梯"
        },
        {
          "role": "阿罗逻",
          "text": "哦哦，天翻地覆了！"
        },
        {
          "type": "subtitle",
          "text": "逃离无想之间"
        },
        {
          "type": "subtitle",
          "text": "接触「喷喷羽球」",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "阿罗逻",
          "text": "前面的难道是出口吗？"
        },
        {
          "role": "伊斯托利亚",
          "text": "看起来没有翅膀确实有难度啊。"
        },
        {
          "role": "伊斯托利亚",
          "text": "穿越凡人不可跨过的叹息之墙，才能抵达英雄的极乐仙境。"
        },
        {
          "role": "伊斯托利亚",
          "text": "冲啊！"
        },
        {
          "role": "阿罗逻",
          "text": "糟了！不会前功尽弃吧？"
        },
        {
          "role": "伊斯托利亚",
          "text": "交给小右吧。"
        },
        {
          "type": "subtitle",
          "text": "进入「气流」",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "回到柱殿中心"
        },
        {
          "role": "阿罗逻",
          "text": "小心！"
        },
        {
          "role": "伊斯托利亚",
          "text": "小右似乎可以用它的力量暂时抵抗一下。"
        },
        {
          "type": "subtitle",
          "text": "被击中多次时"
        },
        {
          "role": "阿罗逻",
          "text": "撑住啊，小右！"
        },
        {
          "role": "阿罗逻",
          "text": "我们，这是出来了？"
        },
        {
          "role": "伊斯托利亚",
          "text": "看这熟悉的景色不就知道了。虽然也不再熟悉了。"
        },
        {
          "role": "伊斯托利亚",
          "text": "天空怎么变成这种颜色了。"
        },
        {
          "role": "阿罗逻",
          "text": "这…我其实一直没有从无想天里出来…"
        },
        {
          "role": "伊斯托利亚",
          "text": "我知道，我都没见过你。"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "派蒙",
          "text": "呜啊，你们刚才去哪里了！吓死我了。"
        },
        {
          "role": "派蒙",
          "text": "我一直在喊你的名字。"
        },
        {
          "role": "伊斯托利亚",
          "text": "为什么派蒙这个小家伙没有被拉入无想之间？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可能她除了吃和睡…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…本身就什么也不想吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊斯托利亚",
          "text": "有道理。"
        },
        {
          "role": "伊斯托利亚",
          "text": "看来梅兰塔真的生气了。"
        },
        {
          "role": "伊斯托利亚",
          "text": "送旅行者上去直面梅兰塔之事已是迫在眉睫了。"
        },
        {
          "role": "伊斯托利亚",
          "text": "换个地方说话吧。这里也不是很安全。"
        },
        {
          "role": "阿罗逻",
          "text": "那个，虽然没有人在意。但是大家好，我叫阿罗逻。"
        }
      ],
      "collapse_ranges": [
        [
          110,
          111
        ]
      ]
    }
  ]
}