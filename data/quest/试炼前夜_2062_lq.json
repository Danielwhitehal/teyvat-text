{
  "quest_id": 2062,
  "chapter_num": "花之归尘，羽之将坠 第二幕",
  "chapter_title": "试炼前夜",
  "type": "lq",
  "route": "The Night Before the Trial",
  "stories": [
    {
      "story_id": 15020,
      "title": "试炼前夜",
      "description": "解决完失翼者的问题后，你们又赶往试炼场地…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "去找场地工作人员"
        },
        {
          "role": "派蒙",
          "text": "「失翼者」们应该都通知完了吧？接下来是要去…"
        },
        {
          "role": "恰斯卡",
          "text": "飞行试炼场，离花羽会不远。"
        },
        {
          "role": "因卡纳克",
          "text": "欸，恰斯卡？是阿尔帕长老让你来的吗？"
        },
        {
          "role": "恰斯卡",
          "text": "嗯，她还有其他事要做，这边的情况怎么样？"
        },
        {
          "role": "因卡纳克",
          "text": "唔…根据调查结果，应该是过去的几次深渊入侵，导致了地脉紊乱，在试炼场地里形成了各种各样的「阻塞」。"
        },
        {
          "role": "因卡纳克",
          "text": "理论上只要清理掉这些阻塞，就能让气态燃素再次充盈，但实际操作起来却各有各的问题…"
        },
        {
          "role": "因卡纳克",
          "text": "具体情况，你们可以直接下去看看？也可以问问在场的工作人员。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（因卡纳克）"
        },
        {
          "role": "因卡纳克",
          "text": "具体情况，你们可以直接下去看看？也可以问问在场的工作人员。"
        },
        {
          "type": "subtitle",
          "text": "清理场地内的阻塞（4/4）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（谨慎的调查员）清理前"
        },
        {
          "role": "谨慎的调查员",
          "text": "嗯…看起来这个喷口，{{颜色|蓝|只要进行多次打击就能清理掉。}}"
        },
        {
          "role": "谨慎的调查员",
          "text": "不过这里头似乎有奇怪的生命活动迹象，不知道直接动手会不会有危险啊…"
        },
        {
          "role": "谨慎的调查员",
          "text": "呜哇！是怪物！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|熔岩游像·蚀土者|1}}",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "谨慎的调查员",
          "text": "哈哈…我还以为自己要完了！这儿的喷口已经没事了，多谢你们。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（疑惑的调查员&迷惑的调查员）清理前"
        },
        {
          "role": "疑惑的调查员",
          "text": "奇了怪了…这里怎么会出现那么多固态燃素？"
        },
        {
          "role": "迷惑的调查员",
          "text": "是不是因为地脉紊乱，把「回声之子」的什么东西给卷进来了？{{颜色|蓝|我刚刚在悬崖上就有看见奇怪的印记…}}"
        },
        {
          "role": "疑惑的调查员",
          "text": "不会吧？难道我们还得去「回声之子」借一头{{颜色|蓝|嵴锋龙}}来清理吗？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（疑惑的调查员&迷惑的调查员）清理后"
        },
        {
          "role": "疑惑的调查员",
          "text": "你！你看到了吗！刚刚有一头嵴锋龙突然出现了！"
        },
        {
          "role": "迷惑的调查员",
          "text": "难…难道是路过的…？不管了，喷口清理完了就好…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（好奇的调查员）清理前"
        },
        {
          "role": "好奇的调查员",
          "text": "奇怪…明明已经铆足了力气，怎么还是敲不破…"
        },
        {
          "role": "好奇的调查员",
          "text": "难道真像因卡纳克说的，固态燃素内部已经形成稳定结构…需要同时击中所有弱点才能清理？"
        },
        {
          "role": "好奇的调查员",
          "text": "——可是要怎么才能{{颜色|蓝|同时击中这些弱点}}呢？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（好奇的调查员）清理后"
        },
        {
          "role": "好奇的调查员",
          "text": "原来是用这种方式来解决的吗？太厉害了！"
        },
        {
          "role": "大胆的调查员",
          "text": "咦，你们是来帮忙的吗？谢天谢地！我正愁没人配合呢。"
        },
        {
          "role": "大胆的调查员",
          "text": "这里的「阻塞」要用特制的炸弹来清理，但是带着炸药爬上这么陡峭的山峰…"
        },
        {
          "role": "大胆的调查员",
          "text": "磕一下碰一下，一条小命就没了！所以我打算把炸药运到对面，再用热气球送过来…"
        },
        {
          "role": "大胆的调查员",
          "text": "只要有人能在这里{{颜色|蓝|看准时机击中热气球，让炸药刚刚好落在喷口上…}}问题就解决了！"
        },
        {
          "role": "大胆的调查员",
          "text": "怎么样？很简单易懂对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实挺简单的…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以上面那个热气球也是你放的？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "大胆的调查员",
          "text": "嗯？你说那个啊…我也不知道是谁放的，居然能升得这么高。"
        },
        {
          "role": "大胆的调查员",
          "text": "要是能飞上去看看它是用了什么技术就好了…不过现在修理场地的事更重要。"
        },
        {
          "role": "大胆的调查员",
          "text": "我这就去对面布置，你们准备好了，就喊我一声！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（大胆的调查员）对面山上"
        },
        {
          "role": "大胆的调查员",
          "text": "咦？你们怎么跑过来了？在这边可不好看清位置啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能重新说明一下计划吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "大胆的调查员",
          "text": "哦，我打算用热气球把炸药送到对面的喷口上空…"
        },
        {
          "role": "大胆的调查员",
          "text": "只要你{{颜色|蓝|看准时机击中热气球，让炸药刚刚好落在喷口上…}}问题就解决了！"
        },
        {
          "type": "subtitle",
          "text": "'''呼叫'''",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "大胆的调查员",
          "text": "好嘞！准备好——"
        },
        {
          "type": "subtitle",
          "text": "额外对话（大胆的调查员）清理后"
        },
        {
          "role": "大胆的调查员",
          "text": "从这边看过去，那只热气球飞得可真高啊…到底是谁放的？"
        },
        {
          "type": "subtitle",
          "text": "返回高处与因卡纳克对话"
        },
        {
          "role": "恰斯卡",
          "text": "气态燃素正在恢复…看来所有喷口都已经清理完了。我们先回高台上去吧。"
        },
        {
          "role": "因卡纳克",
          "text": "居然用这么短的时间就清理完了…真不愧是你们！"
        },
        {
          "role": "因卡纳克",
          "text": "接下来只要等气态燃素逐渐充盈，飞行试炼就能正常举办了。"
        },
        {
          "role": "恰斯卡",
          "text": "唔…因卡纳克，我想先试飞一下，看看还有没有遗漏，能帮我安排一下吗？"
        },
        {
          "role": "因卡纳克",
          "text": "欸？可是场地才刚刚清理完，万一有什么危险没发现…"
        },
        {
          "role": "恰斯卡",
          "text": "所以才更应该由我来检查吧。"
        },
        {
          "role": "因卡纳克",
          "text": "啊…也对，以你的飞行技巧，就算有什么遗漏，也不会是致命的危险…"
        },
        {
          "role": "恰斯卡",
          "text": "这片区域里的环境还不稳定，不亲自试飞一下，很难检查出问题。"
        },
        {
          "role": "因卡纳克",
          "text": "那我这就去安排。你准备好的话，就随时跟我说一声吧。"
        },
        {
          "type": "subtitle",
          "text": "与因卡纳克对话"
        },
        {
          "role": "因卡纳克",
          "text": "准备好了吗？虽然对恰斯卡来说不是什么难事，不过还是要注意安全。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我相信她！",
              "dialogues": [
                {
                  "role": "因卡纳克",
                  "text": "嗯，那就大胆地飞吧！"
                }
              ]
            },
            {
              "text": "最好再准备一下…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "完成飞行挑战"
        },
        {
          "type": "subtitle",
          "text": "与恰斯卡对话"
        },
        {
          "role": "派蒙",
          "text": "好精彩的飞行！我连眼睛都不舍得眨！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有什么遗漏吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "嗯…没什么大问题，只要再过几天，就能正常举行试炼了。"
        },
        {
          "role": "伊西多尔",
          "text": "救——救命啊——"
        },
        {
          "role": "伊西多尔",
          "text": "你们…你们是花羽会的人吧？快…快来帮帮我们！"
        },
        {
          "role": "恰斯卡",
          "text": "冷静点，出什么事了？"
        },
        {
          "role": "伊西多尔",
          "text": "有…有一只绒翼龙，突然袭击了我们！"
        },
        {
          "role": "伊西多尔",
          "text": "我的同伴跟货物都还在大道上…求求你们，快去救救他们吧！"
        },
        {
          "role": "派蒙",
          "text": "欸？绒翼龙…有这么凶猛吗？一只直接袭击了一群人？"
        },
        {
          "role": "恰斯卡",
          "text": "按理说应该不会…但凡事总有例外，先过去看看！"
        },
        {
          "type": "subtitle",
          "text": "前去救助商队"
        },
        {
          "role": "年轻的行商",
          "text": "哎哟…"
        },
        {
          "role": "年长的行商",
          "text": "怎么会有这么凶猛的绒翼龙…"
        },
        {
          "type": "subtitle",
          "text": "与阿尔帕对话"
        },
        {
          "role": "阿尔帕",
          "text": "嗯？恰斯卡、旅行者，你们也来了？"
        },
        {
          "role": "派蒙",
          "text": "阿尔帕长老？咦？他们说的绒翼龙呢？"
        },
        {
          "role": "阿尔帕",
          "text": "已经先我们一步飞走了，看来是知道救兵要到，率先撤退了。"
        },
        {
          "role": "恰斯卡",
          "text": "那它突然袭击人类的目的…是商队运送的食物吗？"
        },
        {
          "role": "阿尔帕",
          "text": "不，这支商队运送的不是食物…"
        },
        {
          "role": "年轻的行商",
          "text": "——哦！谢天谢地！「燃素翼」都还没事！"
        },
        {
          "role": "恰斯卡",
          "text": "…「燃素翼」？"
        },
        {
          "role": "伊西多尔",
          "text": "哎呀，太感谢了。这批「燃素翼」是我们最重要的货物，万一有什么闪失，可真不知道该怎么办！"
        },
        {
          "role": "阿尔帕",
          "text": "…你们就是之前瓦尔米说的，要来跟我们谈合作的商队？"
        },
        {
          "role": "伊西多尔",
          "text": "啊，没错没错，那…您就是阿尔帕长老咯？"
        },
        {
          "role": "阿尔帕",
          "text": "是我。各位舟车劳顿，又受了惊吓，就先跟我一起回花羽会好好休息吧，有什么事，可以之后再谈。"
        },
        {
          "role": "恰斯卡",
          "text": "阿尔帕长老，那绒翼龙袭击的事…"
        },
        {
          "role": "阿尔帕",
          "text": "唔，我看这些朋友并没有受重伤，货物也没什么损失…或许只是那只绒翼龙，偶然间受到了什么刺激吧。"
        },
        {
          "role": "阿尔帕",
          "text": "这附近的绒翼龙那么多，出现一两次意外也不奇怪，就不用费心去追查了…倒是飞行试炼那边，修整得怎么样了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "修理得差不多了。",
              "dialogues": []
            },
            {
              "text": "很快就能重启了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊西多尔",
          "text": "哦？飞行试炼？——那可真是巧了！阿尔帕长老，我们的「燃素翼」一定能在试炼上给您一个惊喜！"
        },
        {
          "role": "阿尔帕",
          "text": "是吗？…听起来倒是挺有趣的。"
        },
        {
          "role": "伊西多尔",
          "text": "嘿嘿，那绒翼龙的事就放一边…我们快回去谈谈「燃素翼」的合作吧！"
        },
        {
          "role": "恰斯卡",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "问题好像都解决了？还怪顺利的嘛…那我们也走吧…咦？恰斯卡？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你在看什么呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "……"
        },
        {
          "role": "[[文件",
          "text": "部族纪闻-试炼前夜-染血的羽毛.png|center|150px]]"
        },
        {
          "role": "恰斯卡",
          "text": "染血的…羽毛？"
        },
        {
          "type": "subtitle",
          "text": "这起风波最终不了了之，花羽会再次恢复了往日的平静。\n在波澜不惊的日常中，飞行试炼也在紧锣密鼓地筹备…",
          "narration": true,
          "color": "描述"
        }
