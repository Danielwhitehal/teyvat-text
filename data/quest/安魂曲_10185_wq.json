{
  "quest_id": 10185,
  "chapter_num": "谐律上的咏叙诗·终章",
  "chapter_title": "安魂曲",
  "type": "wq",
  "route": "Requiem",
  "stories": [
    {
      "story_id": 74196,
      "title": "哀悼命运之疮",
      "description": "为了呜斯先生，也为了镇上的大家，与波爱修斯展开最后的决战吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "释放灵露连通水道"
        },
        {
          "type": "subtitle",
          "text": "额外对话（斯库拉）"
        },
        {
          "role": "斯库拉",
          "text": "既然水道已经修好了，接下来只要释放储存在这里的灵露，航道便能连通了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "启动",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与斯库拉对话"
        },
        {
          "role": "斯库拉",
          "text": "何等耀眼的灵露啊，就像是数千年前一样…那么，时机已至…"
        },
        {
          "role": "斯库拉",
          "text": "就如当初那家伙的旋律从这里流淌到全地之时，当金色的水道奏响之时，黄金宫殿的大门便会打开。"
        },
        {
          "role": "斯库拉",
          "text": "啊，我已经听到了，那美妙的旋律。"
        },
        {
          "role": "斯库拉",
          "text": "旅行者，派蒙，我们一起共奏吧！然后你们便能进入黄金宫殿了。"
        },
        {
          "type": "subtitle",
          "text": "与斯库拉共奏"
        },
        {
          "type": "subtitle",
          "text": "进入「黄金宫殿」"
        },
        {
          "type": "subtitle",
          "text": "伴随着金色的旋律，你们穿过了黄金宫殿的大门…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "呼，终于进来了，真不容易啊！"
        },
        {
          "role": "派蒙",
          "text": "说是黄金的宫殿，不过看起来倒不像是宫殿，更像是某个巨大机器的内部呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这个地方…很熟悉。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，是你之前在雷穆斯的记忆里见到的地方吗？"
        },
        {
          "role": "派蒙",
          "text": "所以那个没礼貌的坏蛋才想在这里…要是让他得逞的话可就糟糕了！"
        },
        {
          "role": "派蒙",
          "text": "而且也不知道呜斯先生现在怎么样了…"
        },
        {
          "role": "派蒙",
          "text": "无论如何，我们也只能继续前进了。"
        },
        {
          "type": "subtitle",
          "text": "继续前进"
        },
        {
          "role": "波爱修斯",
          "text": "真是纠缠不休的杂碎…"
        },
        {
          "role": "波爱修斯",
          "text": "修好破碎的水道，是想以此庆贺我作为旧日之神的诞生吗？"
        },
        {
          "role": "波爱修斯",
          "text": "不过在我的新世界，是不需要水道，也不需要航船的…"
        },
        {
          "role": "波爱修斯",
          "text": "因为所有人都会在我的「乐章」中得到永恒的幸福。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们是来为你的乐章画上休止符的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没错，你最好老实认输，释放镇上大家的灵魂…还有，快把呜斯先生交出来！"
        },
        {
          "role": "波爱修斯",
          "text": "哼，卡西奥多他已经同意参与这伟大的仪式，重归雷穆利亚的怀抱了。"
        },
        {
          "role": "波爱修斯",
          "text": "属于雷穆利亚的全部意志都将融为一体，所谓友谊难道不是你们的自以为是吗？"
        },
        {
          "role": "呜斯先生",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "呜斯先生！"
        },
        {
          "role": "呜斯先生",
          "text": "（相信我…）"
        },
        {
          "type": "subtitle",
          "text": "打倒「波爱修斯」"
        },
        {
          "type": "subtitle",
          "text": "与{{图标|小||魔像督军}}'''波爱修斯'''战斗",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "波爱修斯",
          "text": "虽然这并不在我的计划当中，不过也好，我承认你们有这样的资格。"
        },
        {
          "role": "波爱修斯",
          "text": "就由你们来见证新世界的诞生吧！"
        },
        {
          "type": "subtitle",
          "text": "{{颜色|红|破坏谐振器}}以削减波爱修斯的护罩",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "波爱修斯",
          "text": "什么？！怎么会…"
        },
        {
          "role": "波爱修斯",
          "text": "为什么我会无法控制这具身体…卡西奥多，是你吗！"
        },
        {
          "type": "subtitle",
          "text": "魔像眼中的光芒变成了蓝色…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "卡西奥多",
          "text": "终于抓住你了，波爱修斯！你所有的意志，「福波斯」都在这里，这次你跑不掉了。"
        },
        {
          "role": "波爱修斯",
          "text": "为什么？！我是调律师，「乐章」的指挥者是我，你怎么可能…"
        },
        {
          "type": "subtitle",
          "text": "魔像将剑插入了胸口，随即瘫痪下去…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "卡西奥多",
          "text": "你忘了，在至尊将我从大乐章中分离之前，我也曾是调律师！现在我回到了「乐章」之中，你不再是唯一的演奏者了。"
        },
        {
          "role": "波爱修斯",
          "text": "哈，原来你答应加入我的计划，只是为了使我放下戒备。最后，你再次背叛了我，背叛了雷穆利亚！"
        },
        {
          "role": "波爱修斯",
          "text": "想想那些被囚禁在深水之下的可悲的同族，想想他们遭受的数千年的折磨…"
        },
        {
          "role": "波爱修斯",
          "text": "你却要为了那些低贱的地上之人，毁了我们的事业，浇灭我们唯一的希望。"
        },
        {
          "role": "卡西奥多",
          "text": "背叛了雷穆利亚的是你，囚禁他们的也是你。正是你的背叛，才使我们的国家遭致灭亡的命运。"
        },
        {
          "role": "卡西奥多",
          "text": "至尊…王上所赐予我们的正义，那个金色的理想，乃是希望我们能够遵从内心的旋律，掌握命运的自由。"
        },
        {
          "role": "卡西奥多",
          "text": "我们不愿接受「法图纳」的审判，更不应成为你的奴仆。"
        },
        {
          "role": "卡西奥多",
          "text": "「福波斯」破碎后，人们原本应当获得自由的机会。如果不是因为你当初的欺骗，他们的噩梦早就该结束了。"
        },
        {
          "role": "波爱修斯",
          "text": "雷穆利亚没有灭亡！在「福波斯」的指引下，它还会再度崛起…"
        },
        {
          "role": "卡西奥多",
          "text": "「无论这顽石与金属的重击如何轰鸣，没有了水和土，人类就没办法生存。」"
        },
        {
          "role": "卡西奥多",
          "text": "不管拥有多么强大的力量，但倘若因此便肆意践踏生命的价值，那这种力量也就毫无意义可言。"
        },
        {
          "role": "卡西奥多",
          "text": "波爱修斯，你不也是人类吗？所有的雷穆利亚人曾经都是普通的枫丹人啊。"
        },
        {
          "role": "卡西奥多",
          "text": "即便我们抛弃了苦弱的肉身，拥有了不朽的躯体，但我们仍然有着凡人的灵魂，也有着凡人的感情与弱点。"
        },
        {
          "role": "卡西奥多",
          "text": "而我们却忘记了这一点，忘记了自己的出身，自以为高踞于其他人之上，雷穆利亚就是因此才会灭亡的。"
        },
        {
          "role": "卡西奥多",
          "text": "旅行者，还记得我说过的话吗，就是现在了！"
        },
        {
          "type": "subtitle",
          "text": "红色的光芒重新亮起，魔像再度起身…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "打倒「波爱修斯」"
        },
        {
          "type": "subtitle",
          "text": "与{{图标|小||魔像督军}}'''波爱修斯'''战斗（失去护盾）",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "卡西奥多",
          "text": "放下你的妄念吧，波爱修斯，现在回头还来得及…"
        },
        {
          "role": "波爱修斯",
          "text": "为什么，卡西奥多，为什么？！你又一次背叛了我，背叛了雷穆利亚…"
        },
        {
          "type": "subtitle",
          "text": "波爱修斯的招式第二次被打断",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "卡西奥多",
          "text": "这个世界，需要前进，而不是毫无意义的循环！"
        },
        {
          "role": "波爱修斯",
          "text": "不…不，我不会承认…"
        },
        {
          "role": "派蒙",
          "text": "呜啊，感觉晕乎乎的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "卡西奥多…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡西奥多",
          "text": "旅行者，还有派蒙，没想到我们还能像这个样子见面。"
        },
        {
          "role": "派蒙",
          "text": "你是…是呜斯先生！"
        },
        {
          "role": "派蒙",
          "text": "哇，还有波爱修斯也在…这家伙该不会又想耍什么花招吧！"
        },
        {
          "type": "subtitle",
          "text": "刹那间，波爱修斯的身形化作竖琴，一闪而过…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "等等，不对！是我眼花了吗，飘在那里的是什么东西啦！"
        },
        {
          "role": "卡西奥多",
          "text": "你们也看到了吗？隐藏在「波爱修斯」的幻象之后的家伙。"
        },
        {
          "role": "？？？",
          "text": "哎呀，你发现我了！"
        },
        {
          "role": "？？？",
          "text": "可那并不是幻象，你们所见到的确实就是「波爱修斯」，因为，我就是「波爱修斯」啊！"
        },
        {
          "role": "？？？",
          "text": "当然，我并不只是「波爱修斯」，我也是「你」…"
        },
        {
          "role": "？？？",
          "text": "我是一切旋律，一切乐章，一切思绪…我是一切灵魂的总和！"
        },
        {
          "role": "「福波斯」",
          "text": "我就是「福波斯」。"
        },
        {
          "role": "「福波斯」",
          "text": "不过不包括你们这些外面来的孩子呢，你们可不属于「我们」。"
        },
        {
          "role": "卡西奥多",
          "text": "「福波斯」…统辖一切的大乐章，竟然拥有人格？"
        },
        {
          "role": "「福波斯」",
          "text": "「福波斯」，或者说原来的那个「西比尔」，原本是上一次洪水吞没大地后的幸存者。"
        },
        {
          "role": "「福波斯」",
          "text": "「西比尔」的愿望是为世界上所有被称为人类的存在送去幸福，但她没有人格，也没有足够的力量。"
        },
        {
          "role": "「福波斯」",
          "text": "为此，她将自己的智慧交给了雷穆斯，加上雷穆斯所拥有的力量，便创造出了「乐章（福波斯）」，也就是我。"
        },
        {
          "role": "卡西奥多",
          "text": "怎么会…"
        },
        {
          "role": "卡西奥多",
          "text": "我们一直以来所演奏的乐章，所接受的命运，都是来自于你…"
        },
        {
          "role": "「福波斯」",
          "text": "是「我」，但也是「你们」呀！因为「我」就是「你们」，是你们所有人的愿望的集合啊。"
        },
        {
          "role": "卡西奥多",
          "text": "排除异己，肆意地消灭其他生命，毁灭城镇与乡村，这些难道也是我们的愿望吗？"
        },
        {
          "role": "「福波斯」",
          "text": "是呀！因为「你们」这样希望，「我」才会如此回应。掠夺、仇恨、杀戮…这些也是「你们」愿望的一部分。"
        },
        {
          "role": "「福波斯」",
          "text": "要为「所有人」送去幸福，难道不应该实现这些愿望吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不可理喻…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这根本就是强词夺理吧！"
        },
        {
          "role": "卡西奥多",
          "text": "…不，那并不是我们真正的愿望！我们之中滋生的傲慢与仇恨扭曲了你，把你变成了可怕的怪物…"
        },
        {
          "role": "卡西奥多",
          "text": "没有人会因此获得幸福，不管是我们，还是我们之外的其他生灵。"
        },
        {
          "role": "卡西奥多",
          "text": "怪不得你会把我们引向毁灭的结局。就是因为察觉到了这一点，王上才会…"
        },
        {
          "role": "「福波斯」",
          "text": "雷穆斯…他的确曾试图消灭我。可是为什么呢？如果没有了我，「你们」一定会再度陷入迷茫与痛苦之中…"
        },
        {
          "role": "「福波斯」",
          "text": "啊啊…为了大家的幸福，我只好将他…"
        },
        {
          "role": "卡西奥多",
          "text": "什么？！难道说那个时候，波爱修斯就已经…"
        },
        {
          "role": "卡西奥多",
          "text": "没错，一定是这样…我们是不可能违抗至尊的命令的，除非背叛他的是「乐章」本身…波爱修斯怎么了，你到底对他做了什么？"
        },
        {
          "role": "「福波斯」",
          "text": "唔，他当然已经变成「我们」了啊，用你们能理解的说法：他被我吃掉了！"
        },
        {
          "role": "派蒙",
          "text": "吃掉…好可怕…"
        },
        {
          "role": "「福波斯」",
          "text": "嗯？但是这也是他的愿望哦，而只有我才能实现他的愿望…他一定也因此获得幸福了吧！"
        },
        {
          "role": "卡西奥多",
          "text": "所以从那之后，波爱修斯就变成你的傀儡了…所以他才会想尽办法，要让你重新降临于世。"
        },
        {
          "role": "「福波斯」",
          "text": "这都是为了「你们」的…为了「所有人」的幸福啊。"
        },
        {
          "role": "卡西奥多",
          "text": "哈哈…不！不！是时候该结束这一切了…"
        },
        {
          "role": "卡西奥多",
          "text": "你已经被我困在了这副躯体里无法逃脱，而我会将你彻底消灭。"
        },
        {
          "role": "「福波斯」",
          "text": "「你」的愿望是和「我」一同消失吗？这就是「你」的幸福吗？但是…我不能实现你的愿望。"
        },
        {
          "role": "卡西奥多",
          "text": "我既已不是雷穆利亚人，也做不了枫丹人。早在我答应要帮至尊实现他的愿望之时，便已经选择了自己的命运。"
        },
        {
          "role": "卡西奥多",
          "text": "所以，这就是我的愿望了，我之所以在世上徘徊了数千年，就是为了这一刻…"
        },
        {
          "role": "卡西奥多",
          "text": "为了终结这千年的噩梦！"
        },
        {
          "role": "卡西奥多",
          "text": "旅行者，就是现在，把我和「福波斯」一同消灭掉吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡西奥多",
          "text": "旅行者，我很开心啊！至尊曾经的计划与愿望，就在刚才我也已经知道了…"
        },
        {
          "role": "卡西奥多",
          "text": "王上想要通过自己的牺牲，将所有人从乐章中，也从仇恨与隔阂中解放出来。"
        },
        {
          "role": "卡西奥多",
          "text": "他直到最后一刻都想要拯救他的臣民…如今我将完成他未竟的心愿。这是我们最后的机会了，而这只有你才能做到。"
        },
        {
          "role": "卡西奥多",
          "text": "也就是因此，我的朋友，王上…命运才会让你来到这里的！"
        },
        {
          "type": "subtitle",
          "text": "打倒「波爱修斯」或是「卡西奥多」"
        },
        {
          "type": "subtitle",
          "text": "与{{图标|小||魔像督军}}'''福波斯'''战斗（瘫痪）",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "卡西奥多",
          "text": "旅行者，这是我们最后的机会了…"
        },
        {
          "role": "卡西奥多",
          "text": "不要犹豫了，就用你手中的剑，终结一切…"
        },
        {
          "role": "卡西奥多",
          "text": "这本就是我早已选择的命运…"
        },
        {
          "type": "subtitle",
          "text": "蓝光再度亮起，周围原本静止的魔像被同色的旋律控制，围上前来举剑斩下…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "呜斯先生…是你吗…"
        },
        {
          "type": "subtitle",
          "text": "青蓝色的光团缓缓飘起…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "卡西奥多",
          "text": "终于…结束了…"
        },
        {
          "role": "卡西奥多",
          "text": "看来，我也很快就要消失了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "呜斯先生…",
              "dialogues": []
            },
            {
              "text": "卡西奥多…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡西奥多",
          "text": "没关系，当行的道路我已经走完了，当尽的职责我也已尽了。从此世上再也没有卡西奥多，也再没有黄金猎人。"
        },
        {
          "role": "卡西奥多",
          "text": "现世之人，也会继续平凡且幸福地度过每一天吧…"
        },
        {
          "role": "派蒙",
          "text": "但是…但是…"
        },
        {
          "role": "卡西奥多",
          "text": "旅行者，还有派蒙，谢谢你们陪我走到这里…"
        },
        {
          "role": "卡西奥多",
          "text": "我的旅途已经到达了终点…"
        },
        {
          "role": "卡西奥多",
          "text": "但是，你们的旅途还没有结束。"
        },
        {
          "role": "卡西奥多",
          "text": "为了我，为了王上的愿望，请演奏最后的「安魂曲」吧。让我们所有人的灵魂，重新回归现世，回归大海…"
        },
        {
          "role": "卡西奥多",
          "text": "「水若是失了透彻，又如何让它再成水呢？树若是离了土地，又要去到哪里生根呢？」"
        },
        {
          "role": "卡西奥多",
          "text": "「无论这顽石与金属的重击如何轰鸣，没有了水和土，人类就没办法生存。」"
        },
        {
          "role": "卡西奥多",
          "text": "或许在未来的某天，我们还会在水土丰饶的地方再次相遇的…"
        },
        {
          "type": "subtitle",
          "text": "卡西奥多的形体最终消散了，「呜斯先生」也变回了普通的白猫…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "前往「黄金宫殿」上层"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "启动",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "已经不能再叫它「呜斯先生」了吧…"
        },
        {
          "role": "派蒙",
          "text": "小呜斯…至少可以叫它小呜斯…"
        },
        {
          "type": "subtitle",
          "text": "前往「演说台」"
        },
        {
          "role": "小呜斯",
          "text": "呜喵？！喵！"
        },
        {
          "role": "派蒙",
          "text": "哇！大家伙！你吓到小呜斯了！"
        },
        {
          "role": "斯库拉",
          "text": "卡西奥多？不…熟悉的气息消失了，卡西奥多去哪儿了？难道是又回到哪具石头躯体当中了吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "卡西奥多他…",
              "dialogues": []
            },
            {
              "text": "他已经不在这里了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "卡西奥多…呜斯先生他，已经和波爱修斯，和「福波斯」一起消失了…"
        },
        {
          "type": "subtitle",
          "text": "向斯库拉说明了事情的原委后，花了一段时间安抚小呜斯…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "就是这样，现在只有「小呜斯」…它还和我们一起…"
        },
        {
          "role": "小呜斯",
          "text": "喵喵？"
        },
        {
          "role": "派蒙",
          "text": "太好了，看来刚才只是被突然出现的大家伙吓了一跳，小呜斯说不定原本就是很胆大的猫咪呢！"
        },
        {
          "role": "斯库拉",
          "text": "不管怎么说，你们打败了那个妖鬼，而卡西奥多…至少他实现了自己的愿望。"
        },
        {
          "role": "斯库拉",
          "text": "想必他的灵魂，也已经回到了深水之中，和他的同胞们在一起了吧！"
        },
        {
          "role": "斯库拉",
          "text": "只要我们完成雷穆斯留下的最后的乐章，便能将他们的灵魂带去现世，带回高海之上…"
        },
        {
          "role": "斯库拉",
          "text": "生命如水流般循环不息，他们也会化为激流，并且迟早有一天，再度作为凡人诞生吧。"
        },
        {
          "role": "斯库拉",
          "text": "那么，我们开始吧。"
        },
        {
          "role": "斯库拉",
          "text": "奏响这最后的乐章，最后的「安魂曲」。"
        },
        {
          "type": "subtitle",
          "text": "使用竖琴开始演奏"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "开始演奏",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "回到佩特莉可镇"
        },
        {
          "type": "subtitle",
          "text": "顺着无数灵魂汇聚而成的洋流，你们离开了深水之下的国度。\n与引导魂灵的金蜂一起，不断上升，上升…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与斯库拉对话"
        },
        {
          "type": "subtitle",
          "text": "一切结束之后，你们回到了最初的起点，佩特莉可镇…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "是雷穆斯留给我们的乐章，终于结束了吗…"
        },
        {
          "role": "派蒙",
          "text": "我们完成了「安魂曲」，被禁锢在海底的灵魂看起来也全都离开了。"
        },
        {
          "role": "派蒙",
          "text": "镇上的大家应该也已经恢复正常了吧。"
        },
        {
          "role": "斯库拉",
          "text": "谢谢你们，完成了这最后的乐章，这延续数千年的愿望。"
        },
        {
          "role": "斯库拉",
          "text": "不论是老夫的，还是雷穆斯的，又或是所有守护现世安定之人的。"
        },
        {
          "role": "派蒙",
          "text": "说到这个就想起来呜斯先生…"
        },
        {
          "role": "小呜斯",
          "text": "喵呜！"
        },
        {
          "role": "派蒙",
          "text": "你也很喜欢这个名字吗？不过现在不是在说你哦。"
        },
        {
          "role": "斯库拉",
          "text": "他的灵魂已经回归高海…终于得享宁静了，对他来说这也是一种解脱吧。"
        },
        {
          "type": "subtitle",
          "text": "完成魔神任务：第四章·第五幕「罪人舞步旋」"
        },
        {
          "role": "斯库拉",
          "text": "而老夫的族裔们，看起来也已经有了新的、真正的龙诞生了。{{#info:[[那维莱特]]}}"
        },
        {
          "role": "斯库拉",
          "text": "虽然作为曾经水龙蜥的亲王，老夫也应该前去觐见…不过现在的老夫，究竟还能不能算作龙裔也很难说了。"
        },
        {
          "role": "斯库拉",
          "text": "时间已经过去太久了，久到这个世界也已经与老夫无关了。"
        },
        {
          "role": "派蒙",
          "text": "那么接下来大家伙要怎么办呢？"
        },
        {
          "role": "斯库拉",
          "text": "这个嘛，好不容易重获自由，老夫可得在水里好好畅游一番呢！"
        },
        {
          "role": "斯库拉",
          "text": "而且现在除了小东西们，也再没人能打扰老夫了吧！"
        },
        {
          "role": "派蒙",
          "text": "喂，什么叫打扰啦！"
        },
        {
          "role": "斯库拉",
          "text": "哈哈，开玩笑的。不过你们也该回到属于你们的地方去了吧，我们也要就此别过了。"
        },
        {
          "role": "斯库拉",
          "text": "虽然是这样说，但是你们可要多多回来看看老夫啊。毕竟大家都走了，老夫说不定会很寂寞呢！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，说到底大家伙还是很挂念我们的嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "再见了，大家伙。",
              "dialogues": []
            },
            {
              "text": "我们还会见面的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "哼，看到你们的样子，老夫也有些期待那些地上生灵的未来了！"
        },
        {
          "role": "斯库拉",
          "text": "那么，就有缘再见了。"
        },
        {
          "type": "subtitle",
          "text": "伴随着海浪的翻腾，斯库拉离开了…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "那么，接下来我们要去哪呢？"
        },
        {
          "role": "派蒙",
          "text": "哦对了，我们还没去找[[埃斯特]]先生告诉他事情已经解决了吧，明明说好去去就来的！"
        },
        {
          "role": "派蒙",
          "text": "还有「小呜斯」…唔，现在要怎么称呼它才好呢，好复杂…"
        },
        {
          "role": "派蒙",
          "text": "总之，我们还是先回镇上吧。"
        }
      ],
      "collapse_ranges": [
        [
