{
  "quest_id": 76031,
  "chapter_num": null,
  "chapter_title": "月光联系你我",
  "type": "wq",
  "route": "May the Moonlight Connect Us",
  "stories": [
    {
      "story_id": 76031,
      "title": "月光联系你我",
      "description": "在「银月之庭」，似乎有只小动物遇到了困难…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同「少女」见面"
        },
        {
          "role": "派蒙",
          "text": "咦？旅行者，你看那是什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一只…帔髦獾？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "它怎么一个人躲在这里呀，是来找「少女」的吗？"
        },
        {
          "role": "派蒙",
          "text": "看它的样子好像被什么东西吓到了，我们先带它进去吧。"
        },
        {
          "type": "subtitle",
          "text": "进入「银月之庭」"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅？"
        },
        {
          "role": "「少女」",
          "text": "呼…呼…"
        },
        {
          "role": "派蒙",
          "text": "啊！她在睡午觉呢，旅行者，要不我们待会儿再来。"
        },
        {
          "role": "帔髦獾",
          "text": "……！"
        },
        {
          "role": "派蒙",
          "text": "欸！你别去呀！"
        },
        {
          "type": "subtitle",
          "text": "「少女」被突然跑来的帔髦獾撞醒…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "「少女」",
          "text": "…唔！"
        },
        {
          "role": "「少女」",
          "text": "疼…"
        },
        {
          "role": "帔髦獾",
          "text": "……"
        },
        {
          "role": "「少女」",
          "text": "脚滑了一下？唔，没关系，我没事。嗯？你们也来了？"
        },
        {
          "role": "派蒙",
          "text": "原来「月神」还会被动物撞疼的吗…"
        },
        {
          "role": "「少女」",
          "text": "动物们散发的月矩力中没有「恶意」，我就没在意。"
        },
        {
          "role": "「少女」",
          "text": "你怎么了？为什么这么害怕？"
        },
        {
          "role": "帔髦獾",
          "text": "……"
        },
        {
          "role": "「少女」",
          "text": "嗯，嗯嗯。"
        },
        {
          "role": "派蒙",
          "text": "原来你也能听懂它们说了什么？"
        },
        {
          "role": "「少女」",
          "text": "挪德卡莱是月亮升起的国度，只要是在月矩力下长大的动物，都可以算「月神的眷属」。"
        },
        {
          "role": "派蒙",
          "text": "那它说了什么呀？"
        },
        {
          "role": "「少女」",
          "text": "它生活的地方出现了魔物，本来想找菈乌玛…但一路被魔物追到了这附近…"
        },
        {
          "role": "派蒙",
          "text": "哦，怪不得会那么害怕…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要送它回去吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "嗯，送去菈乌玛那里好了。她会处理的。"
        },
        {
          "role": "派蒙",
          "text": "好呀，看来又要出一趟门了呢。不过这次去的是「霜月之子」那边，你可真的要藏好啊！"
        },
        {
          "type": "subtitle",
          "text": "同菈乌玛见面"
        },
        {
          "role": "菈乌玛",
          "text": "…没错，之后再让[[库涅贡妲]]拿些水果过去，这两天她需要静养。"
        },
        {
          "role": "派蒙",
          "text": "哦，菈乌玛好像在忙欸。我们稍等一下。"
        },
        {
          "role": "「少女」",
          "text": "很久以前我就知道，「咏月使」是「霜月之子」中非常重要的存在。"
        },
        {
          "role": "「少女」",
          "text": "我有时会觉得，她们说不定比真正的「神明」还辛苦。"
        },
        {
          "role": "派蒙",
          "text": "哦！她闲下来了！快趁现在…"
        },
        {
          "role": "瓦娜莫",
          "text": "菈乌玛大人，这边有些工事需要您安排一下。"
        },
        {
          "role": "菈乌玛",
          "text": "好，我这就来。"
        },
        {
          "role": "派蒙",
          "text": "又被叫走了吗！真的一点空隙都不给欸！"
        },
        {
          "role": "派蒙",
          "text": "我们小心地跟上去吧！"
        },
        {
          "type": "subtitle",
          "text": "跟上菈乌玛"
        },
        {
          "role": "菈乌玛",
          "text": "…这样就好。辛苦你们了。"
        },
        {
          "role": "菈乌玛",
          "text": "月光联系着你我，不论日夜。"
        },
        {
          "role": "「少女」",
          "text": "…嗯？这和我以前听到的不一样了。"
        },
        {
          "role": "派蒙",
          "text": "啊！那人走了！我们上吧！"
        },
        {
          "role": "马西捷",
          "text": "菈乌玛大人！"
        },
        {
          "role": "派蒙",
          "text": "怎么没完了！"
        },
        {
          "role": "菈乌玛",
          "text": "……"
        },
        {
          "role": "菈乌玛",
          "text": "…辛苦了。我稍微出去一会儿，马上回来。"
        },
        {
          "role": "菈乌玛",
          "text": "……"
        },
        {
          "role": "菈乌玛",
          "text": "几位，周围没人了，可以出来了。"
        },
        {
          "role": "派蒙",
          "text": "原来你早就发现我们了！"
        },
        {
          "role": "菈乌玛",
          "text": "我怎么可能遗漏「库塔尔（月之少女）」散发出的月矩力呢。"
        },
        {
          "role": "菈乌玛",
          "text": "你们…怎么一直跟着我？简直像在…视察我的工作一样。"
        },
        {
          "role": "派蒙",
          "text": "呃…抱…抱歉，只是有件事需要找你，但一直找不到时机…没给你不必要的压力就好…"
        },
        {
          "role": "菈乌玛",
          "text": "这样吗…明白了，我会处理的。"
        },
        {
          "role": "派蒙",
          "text": "老实说，看完你一天的工作，我都有些不好意思再给你添麻烦了。"
        },
        {
          "role": "菈乌玛",
          "text": "这没什么，都是身为「咏月使」应该做的。"
        },
        {
          "role": "菈乌玛",
          "text": "……"
        },
        {
          "role": "「少女」",
          "text": "…嗯？"
        },
        {
          "role": "菈乌玛",
          "text": "…看过这些之后，「库塔尔（月之少女）」对如今的「霜月之子」怎么看？"
        },
        {
          "role": "「少女」",
          "text": "……"
        },
        {
          "role": "「少女」",
          "text": "和几百年前完全不一样的氛围。好的方面。"
        },
        {
          "role": "菈乌玛",
          "text": "是吗…谢谢你这么说。"
        },
        {
          "role": "「少女」",
          "text": "把手给我。"
        },
        {
          "role": "「少女」",
          "text": "你也是，旅行者。"
        },
        {
          "role": "菈乌玛",
          "text": "…欸？这是…为什么？"
        },
        {
          "role": "「少女」",
          "text": "我喜欢你现在的祷词。"
        },
        {
          "role": "「少女」",
          "text": "…月光联系着你我，不论日夜。"
        }
      ]
    }
  ]
}