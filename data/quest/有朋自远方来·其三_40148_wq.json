{
  "quest_id": 40148,
  "chapter_num": null,
  "chapter_title": "有朋自远方来·其三",
  "type": "wq",
  "route": "Receiver of Friends From Afar: Part III",
  "stories": [
    {
      "story_id": 40148,
      "title": "有朋自远方来·其三",
      "description": "根据言笑的说法，现在不管来再怎么麻烦的客人，都不成问题。但每次当他这么说的时候，似乎都有麻烦降临…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至次日的6时至8时"
        },
        {
          "type": "subtitle",
          "text": "与言笑对话"
        },
        {
          "role": "言笑",
          "text": "早，今天也有劳你咯，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "有了前几次的经验，你们越发得心应手…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "言笑",
          "text": "嗯…你越来越适应在店里掌勺了嘛，这下不管来再怎么麻烦的客人，都不成问题…"
        },
        {
          "role": "派蒙",
          "text": "——打住！我总感觉每次你一说这话，就会出现麻烦的事情！"
        },
        {
          "role": "言笑",
          "text": "嘿，哪有这回事儿！我又不是…"
        },
        {
          "role": "？？？",
          "text": "——啊哈哈哈哈！"
        },
        {
          "role": "荒泷一斗",
          "text": "哎呀，没想到能在璃月见到兄弟你啊！欸，那句俗话是怎么说的来着…"
        },
        {
          "role": "久岐忍",
          "text": "「他乡遇故知」，老大。"
        },
        {
          "role": "荒泷一斗",
          "text": "对对对，就是这个！你说是吧——绫人兄！"
        },
        {
          "role": "神里绫人",
          "text": "呵呵…"
        },
        {
          "role": "派蒙",
          "text": "——放牛的？怎么又是你！"
        },
        {
          "role": "荒泷一斗",
          "text": "嗯？飞行…「破空白铁小堇瓜」？还有挚友！怎么今天这么走运，能遇上这么多老朋友？"
        },
        {
          "role": "派蒙",
          "text": "你前阵子不是还说要回去好好攒钱吗…怎么又跑来了？"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈，以本大爷的身手，想赚钱还不是手到擒来的事？这趟出来，当然是吃香的喝辣的了！"
        },
        {
          "role": "荒泷一斗",
          "text": "咳…顺便再看看玉将在璃月过得怎么样…"
        },
        {
          "role": "旅行者",
          "text": "（阿忍在用眼神示意…现在先不要深究吧…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那绫人你又是？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫人",
          "text": "…我听说前阵子有人在璃月举办「斗虫试合」{{#info:[[「荒泷甲光烈烈斗虫大修行」]]}}，所以特意赶来看看。只可惜，似乎错过了时间。"
        },
        {
          "role": "荒泷一斗",
          "text": "什么？居然错过了那场大会！哎，那真是太可惜了…"
        },
        {
          "role": "神里绫人",
          "text": "是啊，幸好这趟出行遇见了一斗兄弟，可以听你讲讲那时的盛况。"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈，好说好说，我们边吃边聊。这店里的厨师呢？快喊厨师出来，我要给挚友们整顿硬菜！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我就是厨师。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "…啊？"
        },
        {
          "role": "派蒙",
          "text": "喂，放牛的是在学书里的情节啦，那种大手一挥，就有人跑出来的桥段…这里还是给他点面子吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…不过还有主厨。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "啊…哈哈，挚友真会开玩笑，那就快请那位主厨出来吧！"
        },
        {
          "type": "subtitle",
          "text": "你与派蒙回到后厨，向言笑说明原委，请他出面圆场…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "言笑",
          "text": "呃…那客官是要点什么？要宴请贵客的话，我们这儿有「金玉满堂」、「繁弦急管」…"
        },
        {
          "role": "久岐忍",
          "text": "…老大，注意预算。"
        },
        {
          "role": "荒泷一斗",
          "text": "嗯…嗯…那个…有没有更…实在一点儿的？"
        },
        {
          "role": "言笑",
          "text": "实在？呃…倒是有一道「知足常乐」，卤香四溢，回味无穷，是大快朵颐，物美价廉的首选…"
        },
        {
          "role": "荒泷一斗",
          "text": "「知足常乐」？好名字！一听就知道是道硬菜，就选它了！在座的都是朋友，就不整那些花里胡哨的了！"
        },
        {
          "role": "神里绫人",
          "text": "一斗兄好眼光，我也向来不喜欢过于精致的菜。嗯…这就是知己吧？"
        },
        {
          "role": "荒泷一斗",
          "text": "知己？哈哈，对，就是知己！"
        },
        {
          "role": "派蒙",
          "text": "真的假的…算了，你们俩开心就好…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（荒泷一斗&神里绫人）"
        },
        {
          "role": "荒泷一斗",
          "text": "…说时迟那时快！「赤红一杵」顶天踏地，直冲「花羽叶月机关」而去！"
        },
        {
          "role": "神里绫人",
          "text": "不愧是「真剑斗虫大鬼王」，真是一场精彩绝伦的战斗。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（久岐忍）"
        },
        {
          "role": "久岐忍",
          "text": "那边的空气太令人窒息了，所以我找借口溜了出来…总之刚才多谢你配合，具体情况回头再说吧。"
        },
        {
          "type": "subtitle",
          "text": "与言笑对话"
        },
        {
          "role": "言笑",
          "text": "你的朋友，还真有个性…不过这道「知足常乐」也不算难做，这回应该没啥问题。"
        },
        {
          "role": "派蒙",
          "text": "说起来，为什么要叫「知足常乐」呢？大快朵颐、大口吃肉…听起来完全不知足嘛！"
        },
        {
          "role": "言笑",
          "text": "我也没说大口吃肉吧…这菜只是看起来像肉而已，其实是用豆腐做出肉的色香味来，所以才叫「知足常乐」嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "豆腐？！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "啊！我记得放牛的…好像吃不了豆制品吧？怎么办，是不是该找他们换一样…"
        },
        {
          "role": "久岐忍",
          "text": "…你们遇上什么麻烦了吗？我刚刚好像听见「豆腐」什么的…"
        },
        {
          "role": "言笑",
          "text": "等等，厨房重地，闲人…唉，现在也不是计较这个的时候…能请你们老大换道菜吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "…哈哈！知绫人兄者，本大爷也！这道「知足常乐」，就是我们友情的证明！"
        },
        {
          "role": "荒泷一斗",
          "text": "…喂！还没好吗！快点儿快点儿，我的「赤红一杵冒险谭」都要讲完了！"
        },
        {
          "role": "久岐忍",
          "text": "…如你们所见，恐怕有难度。"
        },
        {
          "role": "派蒙",
          "text": "完蛋，这家伙上头了。在面子和肚子之间，他多半会选面子…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没办法，只能先做了…",
              "dialogues": []
            },
            {
              "text": "一会儿搭送点下酒菜吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "久岐忍",
          "text": "嗯，我先让老大多吃点下酒菜填饱肚子…到时候再见机行事吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（言笑&久岐忍）"
        },
        {
          "role": "言笑",
          "text": "没想到世上还有吃不了豆腐的人…下酒菜我来解决，你去做「知足常乐」吧。"
        },
        {
          "role": "久岐忍",
          "text": "我也会帮忙的。放心，璃月的「高级烹饪师」证书，我还是考过的。"
        },
        {
          "type": "subtitle",
          "text": "烹制「知足常乐」"
        },
        {
          "type": "subtitle",
          "text": "知足常乐"
        },
        {
          "type": "subtitle",
          "text": "◆'所需食材'：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "◆'菜肴简述'：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "卤香四溢，回味无穷的璃月菜式，是大快朵颐的首选。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "这道菜品需要以豆腐做出肉食的色香味，因此对厨师的调味能力要求极高。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "传说中这道菜是为牙口不佳，不能食肉老人准备的。让所有人都能在美食中感受到幸福，或许就是厨师的责任吧…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "为等待已久的稻妻一行人上菜"
        },
        {
          "role": "派蒙",
          "text": "菜…菜来咯…"
        },
        {
          "role": "荒泷一斗",
          "text": "嚯嚯，这就是「知足常乐」？果然量大管饱，很不错！"
        },
        {
          "role": "荒泷一斗",
          "text": "来来来，挚友你也坐。在座的都是朋友，谁都不要跟谁客气！我先来一块…"
        },
        {
          "role": "久岐忍",
          "text": "咳！老大，所谓「入乡随俗」，根据璃月的餐桌礼仪，这里应该让客人先尝。"
        },
        {
          "role": "荒泷一斗",
          "text": "嗯？阿忍你不是最讨厌这些条条框框吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我现在也算客人。",
              "dialogues": []
            },
            {
              "text": "我也想先吃一块。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "哦？连挚友也…哦哦，一定是太香了对不对？行，既然你们都这么说的话，本大爷就最后一个吃吧！"
        },
        {
          "role": "神里绫人",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "你与派蒙、绫人、阿忍依次吃了一圈，盘中的「肉块」也少了许多…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "神里绫人",
          "text": "…呵，原来如此。"
        },
        {
          "role": "荒泷一斗",
          "text": "——可算轮到本大爷啦，现在就来一块最大的！"
        },
        {
          "role": "派蒙",
          "text": "等、等一下！"
        },
        {
          "role": "荒泷一斗",
          "text": "嗯？又有什么事啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，这里就交给你了。",
              "dialogues": []
            },
            {
              "text": "能不能再表演一次那个…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我…我尽力吧…呃，刚刚我忘了给你们介绍这道菜的来历！"
        },
        {
          "role": "荒泷一斗",
          "text": "菜的来历？这有什么好听的，吃不就完了…"
        },
        {
          "role": "派蒙",
          "text": "呃呃…不听介绍就吃菜，就像不带导游去旅游！听完介绍再吃菜，口味一定更精彩…"
        },
        {
          "role": "神里绫人",
          "text": "确实，就像不同的茶有不同的品法，不听介绍就品尝，岂不是浪费了厨师的一片心意？"
        },
        {
          "role": "荒泷一斗",
          "text": "挚友的心意？那确实不能辜负…那就来吧，你说，我在听！"
        },
        {
          "role": "派蒙",
          "text": "对！我们先说它的原料…啊不，先讲讲望舒客栈…讲讲荻花洲的历史…"
        },
        {
          "role": "久岐忍",
          "text": "（旅行者，趁现在！）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（收到！）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "趁着派蒙吸引住一斗注意，你与阿忍开始风卷残云…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "荒泷一斗",
          "text": "…荻花洲…居然还发生过这么感人的故事…能有现在的生活，是该「知足常乐」啊…"
        },
        {
          "role": "派蒙",
          "text": "（糟糕，不能提到「豆腐」，不知不觉就跑偏了…还好只剩一点了！）"
        },
        {
          "role": "旅行者",
          "text": "（可是我们已经吃不下了…）"
        },
        {
          "role": "荒泷一斗",
          "text": "啊！阿忍，挚友！你们什么时候开始吃的？居然就剩最后几块了！"
        },
        {
          "role": "荒泷一斗",
          "text": "——现在我可说什么都不会再让了！"
        },
        {
          "role": "久岐忍",
          "text": "等等！老大，那其实是…"
        },
        {
          "role": "神里绫人",
          "text": "且慢，一斗兄，其实…我有一个不情之请，想请你割爱。"
        },
        {
          "role": "神里绫人",
          "text": "我这趟出门仓促，未能带上家眷。他们常闻你的大名，对荒泷派神往已久，可惜这次无缘同席…"
        },
        {
          "role": "神里绫人",
          "text": "不过你若是能将剩下的…「知足常乐」打包送给他们，嗯，他们一定会很开心。"
        },
        {
          "role": "荒泷一斗",
          "text": "这个…不太好吧…"
        },
        {
          "role": "久岐忍",
          "text": "老大，璃月还讲究「成人之美」…而且你等上菜的时候，不都吃了好几份烤鱼吗？"
        },
        {
          "role": "久岐忍",
          "text": "——连我跟绫人先生的份也吃了。"
        },
        {
          "role": "荒泷一斗",
          "text": "什么？那个原来是你们的份吗…故事讲得太投入，完全没有注意到…"
        },
        {
          "role": "荒泷一斗",
          "text": "…咳咳，那就有劳绫人兄，代我向他们问好了！店家，麻烦打包一下——"
        },
        {
          "type": "subtitle",
          "text": "额外对话（神里绫人）"
        },
        {
          "role": "神里绫人",
          "text": "「天崩石裂」、「不如一刀」…没想到璃月也有这么多斗虫强者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不会真是来看斗虫大会的吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫人",
          "text": "呵呵，那我这迟到得也未免太久了。只是在公事访问之余，出来散散心而已。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "海灯节的时候怎么没见着你…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫人",
          "text": "各种访问都有各自的讲究，有人喜欢借节日之由，那当然也会有人避开人群。"
        },
        {
          "role": "神里绫人",
          "text": "何况正是挑了这个时间，才有缘遇上如此趣事。至于打包好的豆腐…嗯，回头就交给托马解决吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（荒泷一斗&久岐忍）"
        },
        {
          "role": "荒泷一斗",
          "text": "吃完这顿饭，就得回港口上工了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以你们是为什么来璃月？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "这个嘛…"
        },
        {
          "role": "久岐忍",
          "text": "…还是我来说吧。老大最近特意找了一份水手的差事，能够跟船来璃月。"
        },
        {
          "role": "久岐忍",
          "text": "船只靠岸以后，有一段时间可以自由行动，就能去看望「花角玉将」了。"
        },
        {
          "role": "荒泷一斗",
          "text": "顺、顺便！只是顺便而已！"
        },
        {
          "type": "subtitle",
          "text": "与言笑对话"
        },
        {
          "role": "言笑",
          "text": "看起来算是安全度过了？好，整理一下精神，应付下一波客人吧。"
        },
        {
          "type": "subtitle",
          "text": "一天过去，安然无事…",
          "narration": true,
          "color": "描述"
        }
      ],
      "collapse_ranges": [
        [
          37,
          39
        ],
        [
          40,
          41
