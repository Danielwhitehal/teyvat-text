{
  "quest_id": 71531,
  "chapter_num": null,
  "chapter_title": "寻味纸影间",
  "type": "wq",
  "route": "Paper Shadow Ruminations",
  "stories": [
    {
      "story_id": 71531,
      "title": "寻味纸影间",
      "description": "璃月港热闹的街道上，一位制作「剪纸戏」的画家吸引了你和派蒙的注意力，她准备的道具之中，有着两个熟悉的形象…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与文寻对话"
        },
        {
          "role": "文寻",
          "text": "圆圆滚滚蓬蓬松松，软软弹弹蹦蹦跳跳…"
        },
        {
          "role": "文寻",
          "text": "呀！有客人来了，你们好你们好，我文寻先祝两位海灯节快乐！"
        },
        {
          "role": "派蒙",
          "text": "海灯节快乐，文寻小姐！"
        },
        {
          "role": "派蒙",
          "text": "刚才我们好像听见你念念有词，你在自言自语什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在想好吃的点心？",
              "dialogues": []
            },
            {
              "text": "还是什么新菜谱？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "文寻",
          "text": "猜得八九不离十了，我在想的是锅巴和月桂要做的美食哦！"
        },
        {
          "role": "派蒙",
          "text": "欸？突然就听到了熟悉的名字…你也认识锅巴和月桂吗？"
        },
        {
          "role": "文寻",
          "text": "嘿嘿！那是当然了，我可是万民堂的常客！"
        },
        {
          "role": "文寻",
          "text": "只要不出门旅行，我一周至少去万民堂吃七顿！"
        },
        {
          "role": "文寻",
          "text": "搭配我家常吃的菜式，一餐清淡，一餐香辣，好不爽快！"
        },
        {
          "role": "文寻",
          "text": "就算上火了，抓几味清火的药材，好好调理两天，就能继续大吃特吃了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听着好棒…",
              "dialogues": []
            },
            {
              "text": "你悠着点…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我我我，我也有点想试试这样的生活了…"
        },
        {
          "role": "文寻",
          "text": "总之，我差不多每个礼拜都能见到锅巴和香菱小姐，有时还会遇上瑶瑶小妹妹。"
        },
        {
          "role": "文寻",
          "text": "瑶瑶带着月桂来看望香菱小姐的时候，锅巴就会和月桂在一边玩。"
        },
        {
          "role": "文寻",
          "text": "真好真好，光是看着锅巴和月桂摇摇晃晃，工作的劳累就一扫而空了。"
        },
        {
          "role": "文寻",
          "text": "不能只有我被锅巴和月桂治愈！我要让大家都见证锅巴和月桂的可爱！"
        },
        {
          "role": "派蒙",
          "text": "说得好！这可是一项大事！不过，具体要怎么做呢？"
        },
        {
          "role": "派蒙",
          "text": "难道你桌上的这些东西就是…"
        },
        {
          "role": "文寻",
          "text": "答对啦！我刚刚完成了一部以锅巴和月桂为主角的「剪纸戏」，这个摊位上的东西，全都是「剪纸戏」的道具！"
        },
        {
          "role": "派蒙",
          "text": "「剪纸戏」…总觉得这个名字有点耳熟？是要在你后边的画板上观看的…映影吗？"
        },
        {
          "role": "文寻",
          "text": "你们可能听说过「纸映剧」，那是一种在璃月流传已久的艺术。灵活运用画片和灯具，就能让画面在幕布上「活」起来。"
        },
        {
          "role": "文寻",
          "text": "我从小就非常喜欢「纸映剧」，跟着应公师傅学了一些门道。长大后，我又成了画师，四处游学。"
        },
        {
          "role": "文寻",
          "text": "在枫丹旅行期间，我接触了几种新的绘画技巧，还有映影这门技术，有了不少灵感。"
        },
        {
          "role": "文寻",
          "text": "于是，我尝试在「纸映剧」的基础上，制作了一种更为新颖的互动游戏，就是你们面前的「剪纸戏」啦！"
        },
        {
          "role": "文寻",
          "text": "「剪纸戏」与「纸映剧」的风格不同，侧重于讲述简单明快的故事，让观众们会心一笑。"
        },
        {
          "role": "文寻",
          "text": "所以说，今年这第一场「剪纸戏」会给大家讲一个非常亲切的故事——锅巴和月桂共同寻找食材，共同制作美食！"
        },
        {
          "role": "派蒙",
          "text": "锅巴和月桂一起做饭？听起来很有意思！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吃的和好玩的！",
              "dialogues": []
            },
            {
              "text": "我也要仔细看看！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "文寻",
          "text": "嘿嘿，看见你们两位兴致高涨，我大受鼓舞！"
        },
        {
          "role": "文寻",
          "text": "那事不宜迟，就请两位放松心情，好好体验一下「剪纸戏」！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（文寻）"
        },
        {
          "role": "文寻",
          "text": "你好呀客人，要再来看看「剪纸戏」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "观赏「剪纸戏」",
              "dialogues": [
                {
                  "role": "文寻",
                  "text": "好嘞！请好好享受！"
                }
              ]
            },
            {
              "text": "关于最后要做的菜…",
              "dialogues": [
                {
                  "role": "文寻",
                  "text": "啊呀，客人你果然注意到了。这场「剪纸戏」里收集的食材，并没有「绝云椒椒」。"
                },
                {
                  "role": "文寻",
                  "text": "因为最后要做的美食，是一道很经典的「八宝福禄鸭」，并不辛辣。"
                },
                {
                  "role": "文寻",
                  "text": "我的家人习惯了清淡的饮食，至多吃一些咸口的菜，不太喜欢辣椒。"
                },
                {
                  "role": "文寻",
                  "text": "不过，我倒不觉得，一个人的饮食习惯应该定格在童年时期…毕竟人要慢慢发掘自己味蕾，慢慢学会「品」出菜肴的美味嘛。"
                },
                {
                  "role": "文寻",
                  "text": "世界那么大，还有好多好多好吃的！没事换换口味也很不错！有时，清淡和辛辣的菜肴换着吃还能让味觉更灵敏！"
                },
                {
                  "role": "文寻",
                  "text": "所以，我向大家宣传锅巴和月桂的可爱时，也顺带向大家推荐这道「八宝福禄鸭」，搭配各种菜肴都非常不错！"
                }
              ]
            },
            {
              "text": "辛苦啦，我先不打扰了哦！",
              "dialogues": [
                {
                  "role": "文寻",
                  "text": "多谢客人关心！如果我的「剪纸戏」能让大家开开心心，那我完全不会觉得累！记得下次再来玩玩哦！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          32,
          34
        ]
      ]
    }
  ]
}