  "route": "Custom Gift Envelope No. 4",
  "stories": [
    {
      "story_id": 71536,
      "title": "如意祝柬·之四",
      "description": "似乎有人对制作祝柬产生了兴趣…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至次日的8时至18时"
        },
        {
          "type": "subtitle",
          "text": "与坎蒂丝对话"
        },
        {
          "role": "坎蒂丝",
          "text": "旅行者？海灯节快乐，你帮迪希雅做「祝柬」的事，我已经听说了，很漂亮，谢谢你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "村里的事已经安排妥当了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "坎蒂丝",
          "text": "多亏了迪希雅她们帮忙，村里现在有人守着，我也能安心一些。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这段时间就好好休息吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "坎蒂丝",
          "text": "嗯，我会的。迪希雅还说，过几天想去「翘英庄」看看。"
        },
        {
          "role": "坎蒂丝",
          "text": "她说那边景色非常不错，还产出好茶，正好买一些带回去给村里的人。"
        },
        {
          "role": "坎蒂丝",
          "text": "我本来也想按照璃月的传统，做几张「祝柬」，附在礼物里送出去。"
        },
        {
          "role": "坎蒂丝",
          "text": "可是迪希雅的日程安排太满，我们俩到处跑，根本没什么空写「祝柬」…"
        },
        {
          "role": "坎蒂丝",
          "text": "我听迪希雅说，你很擅长做「祝柬」，能教我做一封么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好呀，交给我吧。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "和坎蒂丝一同完成祝柬"
        },
        {
          "type": "subtitle",
          "text": "退出时"
        },
        {
          "role": "坎蒂丝",
          "text": "我听迪希雅说，你很擅长做「祝柬」，能教我做一封么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好呀，交给我吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "坎蒂丝",
          "text": "如果能加入一些{{颜色|描述3|「绿色」}}的图案，也许会很好看。"
        },
        {
          "type": "subtitle",
          "text": "提交不符合建议"
        },
        {
          "role": "坎蒂丝",
          "text": "或许，加入一些{{颜色|描述3|「绿色」}}的图案会更好看。"
        },
        {
          "role": "坎蒂丝",
          "text": "嗯…我觉得很好看。"
        },
        {
          "role": "坎蒂丝",
          "text": "谢谢，我很喜欢这种设计。"
        },
        {
          "role": "坎蒂丝",
          "text": "真是一张独一无二的祝柬，多谢了。"
        },
        {
          "type": "subtitle",
          "text": "与坎蒂丝对话"
        },
        {
          "role": "坎蒂丝",
          "text": "原来是这样…这份「祝柬」真好看，谢谢你，旅行者。"
        },
        {
          "role": "坎蒂丝",
          "text": "我等会照着你教我的做法再做几份，随着礼物一起送给村里人，他们一定会很高兴的。"
        },
        {
          "role": "坎蒂丝",
          "text": "至于你做的这一封，我会好好珍藏的。"
        }
      ],
      "collapse_ranges": [
