{
  "quest_id": 10011,
  "chapter_num": "白垩与黑龙 第二幕",
  "chapter_title": "敌神者",
  "type": "eq",
  "route": "Archon's Rival",
  "stories": [
    {
      "story_id": 41211,
      "title": "敌神者",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "如阿贝多所想，这把剑通过吸收力量来进行疑似「成长」的行为。如此罕见的特性，让一些别有用心的人盯上了它。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与阿贝多会合"
        },
        {
          "role": "派蒙",
          "text": "阿贝多——！"
        },
        {
          "role": "阿贝多",
          "text": "回来啦。"
        },
        {
          "role": "派蒙",
          "text": "我们可是努力了好久，快看看剑的进展如何！"
        },
        {
          "role": "旅行者",
          "text": "你看。"
        },
        {
          "role": "阿贝多",
          "text": "唔…果然。"
        },
        {
          "role": "阿贝多",
          "text": "和我想的一样，这把剑会随着战斗成长。"
        },
        {
          "role": "派蒙",
          "text": "它又不是人！"
        },
        {
          "role": "阿贝多",
          "text": "所以这就是它的特殊之处了。"
        },
        {
          "role": "阿贝多",
          "text": "对了，先说一件比较重要的事。"
        },
        {
          "role": "阿贝多",
          "text": "我调查了附近的雪地，发现有不同寻常的痕迹。"
        },
        {
          "role": "派蒙",
          "text": "呀，不会是小偷吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不是说我们才是小偷吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "也对哦。"
                }
              ]
            },
            {
              "text": "盗宝团应该不这么想。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "也对哦。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "我认为那些痕迹并不寻常，有调查的必要。"
        },
        {
          "role": "阿贝多",
          "text": "是小偷，还是别的东西，调查完自然会有结论。"
        },
        {
          "type": "subtitle",
          "text": "前往调查地点"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "派蒙",
          "text": "确实有大量人类活动的痕迹。"
        },
        {
          "role": "派蒙",
          "text": "而且，看起来还不止一个人。"
        },
        {
          "role": "旅行者",
          "text": "看这些线索，像是盗宝团。"
        },
        {
          "role": "派蒙",
          "text": "盗宝团真的在雪山有营地呀…是来偷窃抢劫的吗？"
        },
        {
          "role": "阿贝多",
          "text": "山上有落单的冒险家，打劫起来很方便。"
        },
        {
          "role": "派蒙",
          "text": "真是弱肉强食的雪山呀。"
        },
        {
          "role": "派蒙",
          "text": "不过他们偷了这么多东西，却还是一贫如洗，真够寒碜的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "该不该同情呢…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼，叫我们小偷的人，我才不会同情呢！"
                }
              ]
            },
            {
              "text": "难道这就是他们的命运吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼，叫我们小偷的人，我才不会同情呢！"
                }
              ]
            }
          ]
        },
        {
          "role": "？？？",
          "text": "谁！竟敢在我们的营地里撒野！"
        },
        {
          "role": "派蒙",
          "text": "呀，被发现了！"
        },
        {
          "type": "subtitle",
          "text": "击败来袭的敌人"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "阿贝多",
          "text": "居然是愚人众？而且还选在盗宝团的营地里袭击我们…莫非他们是跟着我们来的？"
        },
        {
          "role": "派蒙",
          "text": "可是，为什么要跟着我们呢？"
        },
        {
          "role": "派蒙",
          "text": "啊！该不会是你背着我去犯了什么事吧！"
        },
        {
          "role": "阿贝多",
          "text": "你犯事了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么可能！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…那就不是我们的错了…"
                }
              ]
            },
            {
              "text": "我绝不可能做这种事。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…那就不是我们的错了…"
                }
              ]
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "我猜愚人众也在找这把剑。"
        },
        {
          "role": "派蒙",
          "text": "哎哎？可你不是把这把剑藏得很好吗，愚人众怎么会知道它的存在呢？"
        },
        {
          "role": "阿贝多",
          "text": "或许是你在雪山战斗的样子被他们看到了。"
        },
        {
          "role": "阿贝多",
          "text": "如果愚人众的人眼光够好，就会发现这把剑的与众不同之处。"
        },
        {
          "role": "派蒙",
          "text": "愚人众怎么什么都要啊！"
        },
        {
          "role": "阿贝多",
          "text": "这可不是什么都要哦。"
        },
        {
          "role": "旅行者",
          "text": "我记得我有听说过相关信息。"
        },
        {
          "role": "阿贝多",
          "text": "愚人众在搜集与神有关的东西，你们应该已经知道了。"
        },
        {
          "role": "派蒙",
          "text": "呀，这么一说，确实听迪卢克老爷提起过呢。"
        },
        {
          "role": "阿贝多",
          "text": "杜林是风神的仇敌，具有相当的力量。"
        },
        {
          "role": "阿贝多",
          "text": "说它是「能匹敌神的存在」也好，「与神有关的存在」也好，都不为过。"
        },
        {
          "role": "旅行者",
          "text": "难怪这把剑会被愚人众当成目标。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样啊…"
        },
        {
          "role": "阿贝多",
          "text": "不久前来附近写生，我有个新发现。"
        },
        {
          "role": "阿贝多",
          "text": "从这里向前，有一处较为特殊的土地。它的地脉流向与别处都不一样。"
        },
        {
          "role": "阿贝多",
          "text": "周边的怪物被它吸引，又受它影响，久而久之，身体素质会比同类更强。"
        },
        {
          "role": "派蒙",
          "text": "还有这种好事？"
        },
        {
          "role": "派蒙",
          "text": "我们是要帮助这把剑成长对吧？来都来了，不如去试试手！"
        },
        {
          "role": "阿贝多",
          "text": "没错。顺便还能观察不同敌人对这把剑造成的影响。"
        },
        {
          "type": "subtitle",
          "text": "调查地脉异常之地"
        },
        {
          "type": "subtitle",
          "text": "击败来袭的怪物"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "派蒙",
          "text": "有什么感觉吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "剑上的力量更强了。",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "我有一个推测。"
                }
              ]
            },
            {
              "text": "不同的呼应…却有着相同的流淌之力。",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "我有一个推测。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "这把剑从敌人身上吸收力量后，会与这座雪山深处暗藏的杜林亡骸发生共鸣。"
        },
        {
          "role": "派蒙",
          "text": "哇…好像很厉害呀！"
        },
        {
          "role": "阿贝多",
          "text": "如果这一猜想成立，那么这座雪山上的怪物也可能与杜林的亡骸共鸣。"
        },
        {
          "role": "旅行者",
          "text": "为什么会跟龙的亡骸共鸣呢？"
        },
        {
          "role": "阿贝多",
          "text": "恐怕与这一带怪物的力量来源有关。"
        },
        {
          "role": "阿贝多",
          "text": "杜林不是一般的怪物。哪怕在它已经死亡的现在，整座雪山也依然受到它亡骸的影响。"
        },
        {
          "role": "阿贝多",
          "text": "神秘的龙之力…或许也是某种诅咒。"
        },
        {
          "role": "阿贝多",
          "text": "信息还是不够。想了解更多，就需要更多数据。这也正是我找你的原因。"
        },
        {
          "role": "派蒙",
          "text": "没想到，听故事也成了体力活呢…"
        },
        {
          "role": "阿贝多",
          "text": "我有些研究工作要收尾，得和你们分开行动了。之后在断桥附近会合吧。"
        }
      ]
    }
  ]
}