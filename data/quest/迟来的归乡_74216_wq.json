{
  "quest_id": 74216,
  "chapter_num": null,
  "chapter_title": "迟来的归乡",
  "type": "wq",
  "route": "Latecoming Homecoming",
  "stories": [
    {
      "story_id": 74216,
      "title": "迟来的归乡",
      "description": "朱斯蒂诺下定了决心，想要回到家乡佩特莉可镇…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "再等一会儿…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "好的，当然没问题。"
        },
        {
          "role": "茱莉耶妲",
          "text": "难道两位恰好准备出海？如果是这样的话，能拜托两位送我一程，带我去拜达港吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我的浪船很小…",
              "dialogues": []
            },
            {
              "text": "抱歉，现在并没有出海的打算。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "茱莉耶妲",
          "text": "这样啊…哎呀，这下可难办了…"
        },
        {
          "role": "派蒙",
          "text": "欸？如果是什么紧急的事，我们也不是不能帮忙…"
        },
        {
          "role": "茱莉耶妲",
          "text": "哦！您真好心，事情是这样，我叫茱莉耶妲，是从事乐器贸易的商人。"
        },
        {
          "role": "茱莉耶妲",
          "text": "前不久，我与几位外国的先生签了一笔订单，向他们订购了一批材料——毕竟，就算是再优秀的工匠，也没法凭空变出乐器嘛！"
        },
        {
          "role": "茱莉耶妲",
          "text": "按照合约，这两天就是要去拜达港交款的日子了。谁能想到，因为我早上睡过了头，没赶上最后一班航船…"
        },
        {
          "role": "茱莉耶妲",
          "text": "哈啊…说不定是因为前几天做了太多噩梦，一直都没休息好…虽说是我自己的过失，但现在当务之急是尽快赶到拜达港。"
        },
        {
          "role": "茱莉耶妲",
          "text": "若两位愿意抽出时间帮我这么一个忙，我愿意出三倍的价钱。"
        },
        {
          "role": "派蒙",
          "text": "三、三倍？！"
        },
        {
          "role": "旅行者",
          "text": "出手这么阔绰吗？"
        },
        {
          "role": "茱莉耶妲",
          "text": "毕竟事关信誉，对经商的人来说，这可是死生问题。"
        },
        {
          "role": "派蒙",
          "text": "好、好像确实是这样…"
        },
        {
          "role": "旅行者",
          "text": "那还等什么，上船吧！"
        },
        {
          "role": "茱莉耶妲",
          "text": "感谢您，好心的先生！"
        },
        {
          "role": "旅行者",
          "text": "嗯，上船吧。"
        },
        {
          "role": "茱莉耶妲",
          "text": "那么，事不宜迟，我们快点去拜达港吧！"
        },
        {
          "role": "旅行者",
          "text": "我的浪船又快又稳，这就出发吧。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "那就有劳了。"
        },
        {
          "role": "旅行者",
          "text": "能不能等我一会儿？"
        },
        {
          "role": "朱斯蒂诺",
          "text": "当然，当然。"
        },
        {
          "role": "茱莉耶妲",
          "text": "哇！我们已经到啦！"
        },
        {
          "role": "茱莉耶妲",
          "text": "非常感谢两位！这样一来，我也能按时把约好的款项交给那些先生了——可不能让大家觉得我们枫丹人不守约定呀。"
        },
        {
          "role": "茱莉耶妲",
          "text": "来，这些是说好的报酬，还请两位收下！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，是亮闪闪的摩拉！只要有报酬，什么都好说嘛！"
        },
        {
          "role": "派蒙",
          "text": "不过，话说回来，旅行者，既然咱们都已经到拜达港了，不如在这里逛逛？反正就算现在回到佩特莉可镇…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "嗯？两位…是从佩特莉可镇来的？"
        },
        {
          "role": "派蒙",
          "text": "呜哇！你这家伙，不要突然从背后跟人搭话呀！吓了我一跳！"
        },
        {
          "role": "朱斯蒂诺",
          "text": "吓到你了？抱歉！唉，是我有些激动了，听到家乡的名字，情不自禁就…"
        },
        {
          "role": "派蒙",
          "text": "只是听人提到家乡的名字，也不用这么激动吧？"
        },
        {
          "role": "朱斯蒂诺",
          "text": "这个嘛…毕竟我少年时代离开家乡之后就再没回去过，在须弥经商，辗转十来年，一直没有听说多少有关家乡的消息…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "你们既然从佩特莉可镇来，能不能给我讲讲佩特莉可镇的近况呢？对了，还没有自我介绍，就叫我朱斯蒂诺吧。"
        },
        {
          "role": "派蒙",
          "text": "你好，朱斯蒂诺先生。我是派蒙，他是旅行者。说来也巧，我们对佩特莉可镇可是有很「深入」的了解呢！"
        },
        {
          "role": "派蒙",
          "text": "（不过…要是告诉他，我们跟着一只猫，破坏了一个古老的阴谋，解决了镇子的危机，只会被当作是在胡言乱语吧…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（虽然都是实际情况…）",
              "dialogues": []
            },
            {
              "text": "（听上去就像在胡说…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呃…佩特莉可镇挺好的！好在哪里呢…好在就和以前一样！和以前一样好！"
        },
        {
          "role": "朱斯蒂诺",
          "text": "是这样吗？和以前一样…和以前一样啊，那我就放心了…"
        },
        {
          "role": "派蒙",
          "text": "说起来，既然是朱斯蒂诺先生的家乡，与其问我们这些外人，自己回去看看不是更好吗？"
        },
        {
          "role": "朱斯蒂诺",
          "text": "唉，说得也是，是该回去了。当初将家乡抛在身后的时候，我没有一点犹豫，现在要回去了，反而畏畏缩缩。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "真奇怪啊，年纪大了，勇气却越来越少。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "要不是收拾行李时找到了这支笛子…"
        },
        {
          "role": "债务处理人",
          "text": "……"
        },
        {
          "role": "朱斯蒂诺",
          "text": "离开家乡的时候我两手空空，只有这支笛子傍身。其实当时家里人都反对我离家远行，这支笛子也是父亲最后偷偷塞给我的。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "哈，那可真是一段好时光，口袋里一个子儿也没有，但是有自由的笛声，有满腔的热情和梦想，好像全世界都是我的。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "后来，我在须弥结识了很多朋友，生意做得越来越大。唉，要是当时能写封信告诉他们就好了，可那时我把家人故乡全忘光了…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "咳，话说回来，我有个不情之请，你们返回佩特莉可镇的时候能捎我一程吗？"
        },
        {
          "role": "旅行者",
          "text": "你也要出三倍船费？"
        },
        {
          "role": "朱斯蒂诺",
          "text": "三倍船费？！"
        },
        {
          "role": "派蒙",
          "text": "是呀，刚才我们载的那位女士，因为有生意上的要紧事，所以出了三倍的船费来雇我们呢。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "三倍…差不多应该够了。好，那我也出三倍船费。俗话说，打铁要趁热，既然决定了要回家，就不应该再迟疑了。"
        },
        {
          "role": "派蒙",
          "text": "虽然想说我们也不是什么专门载客的船夫…可是居然接连接到报酬这么丰厚的委托，实在很难拒绝！"
        },
        {
          "type": "subtitle",
          "text": "与朱斯蒂诺对话"
        },
        {
          "role": "旅行者",
          "text": "稍等，我还有些事情要处理…"
        },
        {
          "role": "茱莉耶妲",
          "text": "您可要快些回来，毕竟时间不等人…"
        },
        {
          "role": "旅行者",
          "text": "走吧。"
        },
        {
          "type": "subtitle",
          "text": "与朱斯蒂诺对话"
        },
        {
          "role": "朱斯蒂诺",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "喂，你的脸色好像不是很好看…你没事吧？"
        },
        {
          "role": "朱斯蒂诺",
          "text": "我…我好像有点晕船，唔…抱歉！我、我去那边吐一会儿，马上就回来！"
        },
        {
          "role": "派蒙",
          "text": "欸？那…好吧，那你去吧，不过记得要快点回来喔！"
        },
        {
          "role": "？？？",
          "text": "过了好一阵子…"
        },
        {
          "role": "派蒙",
          "text": "感觉不对劲…朱斯蒂诺先生怎么还没回来？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不会是吐昏过去了吧？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？！这么严重吗？我觉得旅行者开船明明就很稳啊？哦，因为我都是飘着的…"
                }
              ]
            },
            {
              "text": "坏了，不会是赖账吧？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "啊？！可他不是说自己生意做得很大吗？难道那也是骗人的？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不管怎么说，我们得快点找到他才行！"
        },
        {
          "type": "subtitle",
          "text": "打探朱斯蒂诺的去向"
        },
        {
          "role": "旅行者",
          "text": "再等等吧，我还有别的事要做。"
        },
        {
          "role": "茱莉耶妲",
          "text": "唉，既然已经约好了，那还请您快些回来。"
        },
        {
          "role": "派蒙",
          "text": "你好，请问你有见到一个须弥装束的枫丹商人吗？"
        },
        {
          "role": "？？？",
          "text": "向对方简单说明了情况…"
        },
        {
          "role": "乔瓦尼",
          "text": "所以你们要找的这个自称佩特莉可镇出身的家伙叫「朱斯蒂诺」？"
        },
        {
          "role": "派蒙",
          "text": "对呀对呀，你有看到他吗？欸？该不会你和他以前就认识吧？"
        },
        {
          "role": "乔瓦尼",
          "text": "以前就认识？哈！岂止是认识！"
        },
        {
          "role": "乔瓦尼",
          "text": "不过就算我认得他，他还认得我这个弟弟吗？要知道他离开家这么多年却全无音信，我连墓碑都在镇子后面给他立好了！"
        },
        {
          "role": "乔瓦尼",
          "text": "现在突然回来…还欠了人家船费？这像话吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是不像话啊！",
              "dialogues": []
            },
            {
              "text": "我是外人不方便评价…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不、不管怎么说，我们也算是…算是受害者？而且万一朱斯蒂诺先生是真的身体不舒服晕倒在什么地方了…"
        },
        {
          "role": "乔瓦尼",
          "text": "唉…我和你们一起去找他吧，我是本地人，对附近的地形也更熟悉。他可能会去的地方…我有些头绪。"
        },
        {
          "type": "subtitle",
          "text": "跟随乔瓦尼"
        },
        {
          "role": "茱莉耶妲",
          "text": "啊，您回来了！我们现在可以出发了吗？"
        },
        {
          "type": "subtitle",
          "text": "跟随乔瓦尼"
        },
        {
          "role": "债务处理人",
          "text": "啊？你说什么？「对不起，但是我真的完全没有印象」？"
        },
        {
          "role": "债务处理人",
          "text": "你该不会不认识我这身制服吧？看到这身制服还什么都想不起来吗？"
        },
        {
          "role": "朱斯蒂诺",
          "text": "我、我当然知道你是干什么的，但是我应该不欠任何人任何债款了，除非…除非是我的朋友以我的名义…"
        },
        {
          "role": "债务处理人",
          "text": "你的朋友？谁管你有什么理由或者借口？我只认白纸黑字的契约，让违约者付出代价就是我的职责！"
        },
        {
          "role": "债务处理人",
          "text": "这可是我值得纪念的第一次工作！为了配得上这套制服，我甚至提前三天就到文件上指定的地点等待了！"
        },
        {
          "role": "债务处理人",
          "text": "在这三天的时间里，我一直在思考，要是你违约了，会用什么借口，而我又应该怎样回答应对…"
        },
        {
          "role": "债务处理人",
          "text": "可没想到你居然选择了直接逃跑！那我想好的应对方案不就全都白费了吗？事到如今，我也只好按手册上写的…"
        },
        {
          "role": "债务处理人",
          "text": "先让你吃点苦头，再把你带回去复命了！"
        },
        {
          "role": "朱斯蒂诺",
          "text": "不！我不想再离开佩特莉可了！救、救命啊——"
        },
        {
          "role": "乔瓦尼",
          "text": "住手！不管他欠了多少债款，有必要下这么狠的手吗？"
        },
        {
          "role": "乔瓦尼",
          "text": "旅行者，拜托了！不要让他伤害朱斯蒂诺！只有你能阻止他了！"
        },
        {
          "type": "subtitle",
          "text": "击败债务处理人"
        },
        {
          "type": "subtitle",
          "text": "与债务处理人对话"
        },
        {
          "role": "债务处理人",
          "text": "你、你也是他雇来的帮手？好家伙，宁可用摩拉雇佣这么强悍的保镖也不愿意遵守契约吗？真搞不懂你们这些商人…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不，只是看到你这身打扮就忍不住…",
              "dialogues": [
                {
                  "role": "债务处理人",
                  "text": "啊？"
                }
              ]
            },
            {
              "text": "其实我也是来讨债的。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对哦！说好的三倍船费他都还没付给我们呢！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哇，如果朱斯蒂诺先生其实还欠了一大笔债没还，那我们的船费岂不是…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "船费…船费还是有的，我算过了，应该正好够才对。"
        },
        {
          "role": "乔瓦尼",
          "text": "那他说的什么契约和债款呢？难道是你时隔十数年才回家，特意给我们准备的「伴手礼」吗？"
        },
        {
          "role": "朱斯蒂诺",
          "text": "乔瓦尼！怎么会，怎么会呢！我真的对他所说的契约全无印象，唉！真不知道该怎么说你们才肯相信我了。"
        },
        {
          "role": "债务处理人",
          "text": "呵，手册上说了，人会说谎，会想尽一切办法逃避债务，但契约白纸黑字写得清清楚楚，你可别想抵赖。"
        },
        {
          "role": "债务处理人",
          "text": "你还欠着我们十箱材料的款项，做你那倒霉的笛子…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "…等等，你说什么？笛子？"
        },
        {
          "role": "债务处理人",
          "text": "…都到这种时候了，你还有什么好装的，帕迪西帕齐亚？…该死，你们枫丹人的名字真是比账目还难记…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "帕迪西帕齐亚…是谁？我是朱斯蒂诺，朱斯蒂诺·帕斯夸莱…"
        },
        {
          "role": "债务处理人",
          "text": "…？"
        },
        {
          "role": "债务处理人",
          "text": "等、等一下，让我看看…朱·帕…茱莉耶妲·帕迪西帕齐亚，佩特莉可镇…"
        },
        {
          "role": "债务处理人",
          "text": "好像…是个女人？"
        },
        {
          "role": "派蒙",
          "text": "啊…"
        },
        {
          "role": "旅行者",
          "text": "啊…"
        },
        {
          "role": "债务处理人",
          "text": "不对，不对！你给我等等！你既然不是那个女人，那你刚才在拜达港念叨什么「笛子」？！"
        },
        {
          "role": "朱斯蒂诺",
          "text": "…我说的是…这柄笛子。"
        },
        {
          "role": "乔瓦尼",
          "text": "……"
        },
        {
          "role": "朱斯蒂诺",
          "text": "临行的前一天，父亲送给我的笛子…送给我的生日礼物。他希望我能够传承家族的乐器制造产业，但我…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "唉，过去的事就不提了。"
        },
        {
          "role": "债务处理人",
          "text": "等一下，既然这事跟你没关系，你刚才跑什么？"
        },
        {
          "role": "朱斯蒂诺",
          "text": "「对不起，但是我真的完全没有印象」，我不是这么说了吗？但你语气咄咄逼人，态度凶神恶煞，谁见了不得跑啊…"
        },
        {
          "role": "债务处理人",
          "text": "这可是我值得纪念的第一次工作，当然得拿出一倍的干劲来！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以甚至提前三天去蹲守？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "太心急了吧！"
                }
              ]
            },
            {
              "text": "从结果来看，职业生涯岌岌可危啊。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "债务处理人",
          "text": "坏事了…那关键的茱莉耶妲·帕迪西帕齐亚到底在哪里…"
        },
        {
          "role": "派蒙",
          "text": "说起来，我们一开始载的那位女士…她也是做乐器生意，而且差点误了交款时间，她好像就叫「茱莉耶妲」来着？"
        },
        {
          "role": "债务处理人",
          "text": "什么？！她现在已经在拜达港了吗？我得赶快找到她…"
        },
        {
          "role": "派蒙",
          "text": "她好像真的很重视信誉，应该不会拖欠债款吧…"
        },
        {
          "role": "债务处理人",
          "text": "有这样天真的想法，迟早会上当受骗！手册上说了，人都是会说谎的！没时间耽搁了，我得现在就去找她…"
        },
        {
          "role": "？？？",
          "text": "债务处理人离开了…"
        },
        {
          "role": "派蒙",
          "text": "真是的，犯错的明明是他自己吧？却用什么手册上的话来教训我…还一副了不起的样子！"
        },
        {
          "role": "乔瓦尼",
          "text": "真是一番闹剧…大哥还是老样子，闹出点什么事就会把周围的人全卷进去，最后人仰马翻！"
        },
        {
          "role": "乔瓦尼",
          "text": "我都不知道该生气还是该笑了。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "抱歉，乔瓦尼…"
        },
        {
          "role": "乔瓦尼",
          "text": "也给两位添了不少麻烦，不过这里不是什么聊天的好场所，还是先找个地方，让我招待几位吃些点心，坐下慢慢说吧。"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点"
        },
        {
          "role": "朱斯蒂诺",
          "text": "我们现在出发吗？"
        },
        {
          "role": "乔瓦尼",
          "text": "佩特莉可镇是个小地方，点心茶饮也都很普通，几位见多识广，或许看不上眼…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "乔瓦尼，为什么要说这样带刺的话呢？我的心和你的一样，也是血肉做的，也会受伤，也会痛。"
        },
        {
          "role": "乔瓦尼",
          "text": "是吗？我还以为完全不在乎家人的人，他的心肠理应跟石头一样硬，不管怎么敲打也无动于衷呢。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "我…"
        },
        {
          "role": "派蒙",
          "text": "（唔…没想到会变成这样，气氛好尴尬！）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别吵了，再吵下去点心都变难吃了。",
              "dialogues": []
            },
            {
              "text": "早知道我跟债务处理人一起走了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "总、总之，既然是时隔多年的兄弟重逢，不管以前发生了什么，现在应该高兴一点，对吧？"
        },
        {
          "role": "乔瓦尼",
          "text": "……"
        },
        {
          "role": "朱斯蒂诺",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "呜啊，旅行者，你也来劝劝他们吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真羡慕你们，至少你们兄弟重逢了。",
              "dialogues": []
            },
            {
              "text": "别人的家务事，劝了也没用。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "话是这么说啦…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔，其实旅行者还在寻找他失散的妹妹…"
        },
        {
          "role": "？？？",
          "text": "向兄弟二人简单说明了旅行的目的…"
        },
        {
          "role": "乔瓦尼",
          "text": "原来是这样…你年纪轻轻，要天南海北地寻找亲人，真辛苦啊。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "你的妹妹一定也有她的理由，不一定是把你给忘了，故意和你断绝联系，你不要因此记恨她。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "呃，谢谢？",
              "dialogues": []
            },
            {
              "text": "不，比起我的问题，还是你们俩…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "乔瓦尼",
          "text": "居然要这么年轻的少年来开导我们，作为年长者真是惭愧。"
        },
        {
          "role": "乔瓦尼",
          "text": "虽然过去也有不睦，但我们毕竟还是兄弟…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "乔瓦尼…谢谢你。"
        },
        {
          "role": "乔瓦尼",
          "text": "哼…大哥也不用谢得太早了，当初是你主动放弃继承家业的，现在帕斯夸莱家的法定继承人是我，就算你想主张自己的…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "别说了，乔瓦尼，我知道你的意思。但那些我失去的东西里，最珍贵的一件我已经重新得到了，其他的我都不需要。"
        },
        {
          "role": "乔瓦尼",
          "text": "那可说不准，刚才那个讨债的新手不是也说么，「人都是会说谎的」！"
        },
        {
          "role": "朱斯蒂诺",
          "text": "那就签契约，写声明！或者其他任何你觉得合适的方式，只要能让你再次相信我…"
        },
        {
          "role": "乔瓦尼",
          "text": "我可没说要做到那个份上…"
        },
        {
          "role": "朱斯蒂诺",
          "text": "啊，看来你也还是和以前一样。不过我已经变了，我不会再像过去那样了，让我在你的工坊工作吧。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "我给你当助手，就像小时候你给我当助手那样。"
        },
        {
          "role": "乔瓦尼",
          "text": "那你可要卖力些，我可不会因为你是大哥就放宽标准。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "当然，当然。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，那你们这样算是和好了吗？"
        },
        {
          "role": "朱斯蒂诺",
          "text": "谢谢你们帮了我这么多。现在我甚至觉得三倍船费太少了些！可惜我现在只有这些了…"
        },
        {
          "role": "乔瓦尼",
          "text": "你要是能安下心来在工坊努力工作，要还这个人情还是很容易的。"
        },
        {
          "role": "朱斯蒂诺",
          "text": "听到了吗？乔瓦尼会好好照顾我的。如果有机会再见面，那时请让我来招待你们吧！"
        }
      ]
    }
  ]
}