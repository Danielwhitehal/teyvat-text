{
  "quest_id": 75005,
  "chapter_num": null,
  "chapter_title": "将夜晚放还于夜晚",
  "type": "wq",
  "route": "To the Night, What is the Night's",
  "stories": [
    {
      "story_id": 75005,
      "title": "将夜晚放还于夜晚",
      "description": "在纳塔的野外，见到了一扇奇怪的大门…",
      "dialogues": [
        {
          "role": "雷格巴",
          "text": "不必客气，你们随意吧。要不要尝尝我的手艺？"
        },
        {
          "role": "雷格巴",
          "text": "如果想自己做的话，那边的箱子里有食谱。还有些我用不上的东西，你可以翻一翻。"
        },
        {
          "role": "派蒙",
          "text": "欸？你还随身准备着食谱吗？"
        },
        {
          "role": "雷格巴",
          "text": "我自己画的，画了好几份。说不定谁能用得上。如果遇到需要解救的人，也能拿来救命呢。你说是吧？"
        },
        {
          "role": "派蒙",
          "text": "哇，你想得还真周到…"
        },
        {
          "role": "雷格巴",
          "text": "毕竟在部族外面，你只能自己靠自己了。"
        },
        {
          "role": "旅行者",
          "text": "对了，我们还没问过你的名字？"
        },
        {
          "role": "雷格巴",
          "text": "我的名字？哈！雷格巴吧，叫我雷格巴就好。那么你们呢，朋友？"
        },
        {
          "role": "？？？",
          "text": "向雷格巴作了自我介绍。"
        },
        {
          "role": "雷格巴",
          "text": "派蒙，旅行者，还有小嵴锋龙旅行者…你们在纳塔相遇，真是奇妙的缘分。"
        },
        {
          "role": "雷格巴",
          "text": "话说回来，旅行者。你们在部族的禁地附近做什么？嗯？寻宝？打探秘密？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当然是寻宝啦。",
              "dialogues": [
                {
                  "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                  "text": "呀！"
                },
                {
                  "role": "派蒙",
                  "text": "嗯嗯！这种被保护得很好的地方，总有可能藏着宝贝吧！"
                }
              ]
            },
            {
              "text": "只是好奇而已。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对呀，看到一扇被封印着的大门，有谁不会好奇呢？"
                },
                {
                  "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                  "text": "呀！"
                },
                {
                  "role": "雷格巴",
                  "text": "正派人吧。"
                },
                {
                  "role": "派蒙",
                  "text": "喂！"
                }
              ]
            }
          ]
        },
        {
          "role": "雷格巴",
          "text": "总之，不要对那里动歪心思了，外来人。我是不会让你们进去的。"
        },
        {
          "role": "雷格巴",
          "text": "那里是古老的先人与夜晚重新建立起联系的地方，自那以后，越来越多的部族人才能步入「夜神之国」的门扉。"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "嗯?"
        },
        {
          "role": "派蒙",
          "text": "「夜神之国」到底是个什么样的地方啊？"
        },
        {
          "role": "雷格巴",
          "text": "哈哈，据说那是所有纳塔人在离开这个世界才会前往的地方…只有少数人有从那里返回的经历。"
        },
        {
          "role": "雷格巴",
          "text": "据说那是个流水犹如荧光，伫立着巨大黑曜石碑之处。比起部族的禁地，「夜神之国」才是你们最好不要好奇的地方…"
        },
        {
          "role": "派蒙",
          "text": "所以，你之前说的，下面的那个…和夜晚世界沟通的…"
        },
        {
          "role": "雷格巴",
          "text": "媒介，对，就是以前的人和「大灵」…也是来自「夜神之国」的使者接触的古老道具…"
        },
        {
          "role": "派蒙",
          "text": "哇，古老的道具…"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "呀！"
        },
        {
          "role": "雷格巴",
          "text": "…或许我说的有点多了。总之，在部族人与「夜神之国」建立稳定联系的现在，早已不用媒介，而且在我看来手段实在简陋。"
        },
        {
          "role": "雷格巴",
          "text": "但那好歹也是人类部族的圣物。"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔…嗯！"
        },
        {
          "role": "派蒙",
          "text": "好吧、好吧…我知道了！"
        },
        {
          "role": "雷格巴",
          "text": "对，不要去禁地，那样才是真正正确的做法。"
        },
        {
          "role": "雷格巴",
          "text": "哈！哈！你们的伙伴很聪明，是个非常聪明的孩子。"
        },
        {
          "role": "雷格巴",
          "text": "我曾经也有许多伙伴…许多很聪明的孩子。但现在，我孑然一身，离群索居已久了…"
        },
        {
          "role": "雷格巴",
          "text": "咳咳…啊，没想到天色已经如此之深了。"
        },
        {
          "role": "派蒙",
          "text": "哈啊…听了好多半懂不懂的东西，我也发困了呢…"
        },
        {
          "role": "雷格巴",
          "text": "哎，都怪我，偶尔遇见能说话的人，就变得喋喋不休了…这样，如果你们不嫌弃的话，就在这里休息一晚吧。"
        },
        {
          "role": "雷格巴",
          "text": "我来为你们准备床铺。反正夜里我也得在附近巡逻，不必担心安全的问题。"
        },
        {
          "role": "派蒙",
          "text": "哇，好贴心！那就谢谢你啦！"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔…"
        },
        {
          "role": "？？？",
          "text": "在温暖的草榻上躺下，伴着闪烁的营火，你很快便陷入了梦乡…\\n不过你总觉得耳边有细碎而嘈杂的声响，令你无法沉入深眠。"
        },
        {
          "role": "？？？",
          "text": "直到——\\n直到脸颊旁冰凉湿润的触感突然袭来，将你带离了粘稠黑暗的夜梦…"
        },
        {
          "role": "？？？",
          "text": "你睁开双眼，旅行者熟悉而友好的面孔占据了你的视野。\\n或许刚才是它在舔舐你，试图将你唤醒。\\n又过了片刻，你才注意到，它似乎正试图给你展示什么东西——一座奇特的黑曜石像…"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "呀！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是你找到的吗？",
              "dialogues": [
                {
                  "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                  "text": "呀…呀！"
                }
              ]
            },
            {
              "text": "你…你吐的？",
              "dialogues": [
                {
                  "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                  "text": "唔…"
                },
                {
                  "role": "派蒙",
                  "text": "怎么看都不是它吐出来的吧！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…这个东西看起来好瘆人，太不吉利啦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙还讲究吉利吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我只是照实说我的感觉啦…看着就不像什么好东西。"
                }
              ]
            },
            {
              "text": "看上去很值钱欸…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼…这么丑的东西，想也不会值太多钱吧…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不过，话说回来！旅行者一定是趁我们睡觉的时候出去乱跑了！我说的对不对呀？"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "呜呜…"
        },
        {
          "role": "派蒙",
          "text": "真难办，这个东西是从哪里捡来的…会不会是很危险、很脏的地方呀！"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔…"
        },
        {
          "role": "雷格巴",
          "text": "旅行者？旅行者！小派蒙！"
        },
        {
          "role": "派蒙",
          "text": "我们还在这里呢，怎么啦！"
        },
        {
          "role": "雷格巴",
          "text": "我听到旅行者的叫声就赶过来了。发生什么事了？"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "呀！"
        },
        {
          "role": "雷格巴",
          "text": "这个…这是…"
        },
        {
          "role": "雷格巴",
          "text": "天哪，这座黑曜石像，就是藏在那个被封印的大门后面，部族禁地深处，以前先民用来与「夜神之国」沟通的媒介…"
        },
        {
          "role": "雷格巴",
          "text": "这是你们让小嵴锋龙挖出来的？你们、你…异邦人，觊觎部族的圣物，亏我还为你们准备营地和休息的地方…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等等，我们可以解释…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这不是我们故意做的！"
                }
              ]
            },
            {
              "text": "被发现了，快跑！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "跑什么啦，这又不是故意挖出来的！"
                }
              ]
            },
            {
              "text": "既然都被你看到了…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "还没到要动手的程度吧，喂，好好解释一下呀！"
                }
              ]
            }
          ]
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔…"
        },
        {
          "role": "？？？",
          "text": "和雷格巴交代了前因后果…"
        },
        {
          "role": "雷格巴",
          "text": "居然是这样，唉，我居然忘了这个小家伙可以四处挖洞…倒是我有点疏忽了。"
        },
        {
          "role": "雷格巴",
          "text": "唉，这下可麻烦了，让我想想…虽然已经长久时间没有用过，但是这个媒介也是圣物，要是「大灵」生气就麻烦了。"
        },
        {
          "role": "派蒙",
          "text": "啊，那怎么办？"
        },
        {
          "role": "雷格巴",
          "text": "总之，就要麻烦你们，把这东西归还回它应该去的地方啦。"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔…"
        },
        {
          "role": "雷格巴",
          "text": "说的就是你，嘿嘿，小惹祸精！好了，我们出发吧！"
        },
        {
          "role": "雷格巴",
          "text": "事先警告你们一句…遗迹里道路曲折，机关众多。一定要小心危险哦。"
        },
        {
          "type": "subtitle",
          "text": "与奇怪的家伙对话"
        },
        {
          "role": "雷格巴",
          "text": "嗯…按照从前部族里流传的说法，要进入祭坛的话，就得…<color=#00E1FFFF>「让此处的灯相平齐」</color>…"
        },
        {
          "role": "雷格巴",
          "text": "虽然不是特别清楚，但是，大概是要让机关控制的灯，高度变得一致？"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你看，这里有一道被封印的大门！"
        },
        {
          "role": "派蒙",
          "text": "哼哼，我有种直觉，刚才我们在附近拿到的几个奇怪东西，一定和开启大门有关。"
        },
        {
          "role": "派蒙",
          "text": "真奇怪，这道门的背后会是什么地方呢？"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "呀！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也许是怪物的巢穴…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哇…有怪物的地方，一定会有宝藏的吧？"
                },
                {
                  "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                  "text": "呀！"
                },
                {
                  "role": "旅行者",
                  "text": "那可不一定哦。"
                },
                {
                  "role": "派蒙",
                  "text": "哼，少说丧气话啦，我们进去看看不就知道了！"
                }
              ]
            },
            {
              "text": "也许是藏宝的洞窟…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哇！我的直觉也是这样，里面一定是藏宝的洞窟没错啦！"
                },
                {
                  "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                  "text": "呀！"
                },
                {
                  "role": "旅行者",
                  "text": "不要太兴奋啦。"
                },
                {
                  "role": "派蒙",
                  "text": "里面有什么，进去看看就知道了！我们先把这道大门打开吧！嘿嘿，宝藏，宝藏，我们来咯！"
                }
              ]
            }
          ]
        },
        {
          "role": "雷格巴",
          "text": "喂，两位异邦人！唔…还有一只系着丝巾的小嵴锋龙。"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔？"
        },
        {
          "role": "雷格巴",
          "text": "哎呀，精神的小家伙，你没告诉他们：封印之所以是封印，就因为这里是「禁地」吗？"
        },
        {
          "role": "雷格巴",
          "text": "哦，除了深远的诅咒，你们在里面找不到任何东西的。"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔…"
        },
        {
          "role": "派蒙",
          "text": "也就是说…没有宝藏？"
        },
        {
          "role": "雷格巴",
          "text": "宝藏嘛…大概也是有的。"
        },
        {
          "role": "旅行者",
          "text": "大概？"
        },
        {
          "role": "雷格巴",
          "text": "不过那就不是异邦人该染指的东西了，那扇被封印的门后既是「禁地」也是「圣地」。"
        },
        {
          "role": "雷格巴",
          "text": "平时只有来经受考验的讯使在完成试炼，拿到资格之后才得以进入，据说里面存放着远古的先民与夜晚的世界沟通的媒介…"
        },
        {
          "role": "雷格巴",
          "text": "这么说来，我只是稍微有事离开了一小会儿，你们就取得了证明试炼完成的三枚钥石？这还真是不得了啊…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，爬高下低，找东西啊，这种活我们可擅长了！"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "呀！"
        },
        {
          "role": "雷格巴",
          "text": "即使是部族的讯使看来也没有你们这般矫健的身手。这样，虽然部族的禁地肯定是没法让你们进去，不过，我的营地就在附近。"
        },
        {
          "role": "雷格巴",
          "text": "就让我招待你们垫补下肚子，再休息一会儿，怎么样？"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们还不饿。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我也…！唔，我是有点饿啦…要不然，我们就去休息一下吧？"
                },
                {
                  "role": "旅行者",
                  "text": "真拿你没办法。"
                },
                {
                  "role": "派蒙",
                  "text": "嘿嘿…我还在长身体嘛！"
                }
              ]
            },
            {
              "text": "既然来都来了…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "没关系，你休息，我放哨！"
                },
                {
                  "role": "旅行者",
                  "text": "你只会睡得比我还熟吧…"
                },
                {
                  "role": "派蒙",
                  "text": "喂——！别太小看我啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "雷格巴",
          "text": "噗嗤…你们关系还真好呢。走吧，去我的营地那儿歇息一会儿。"
        },
        {
          "role": "雷格巴",
          "text": "我会准备些热乎的食物，远方的来客，说不定我们有很多话题可以聊聊。"
        },
        {
          "type": "subtitle",
          "text": "前往营地"
        },
        {
          "role": "派蒙",
          "text": "咦，刚才我们不是还在那个峡谷的遗迹里…这里是…？"
        },
        {
          "role": "「黑曜石碑的影像」",
          "text": "过来，来这里。"
        },
        {
          "role": "「黑曜石碑的影像」",
          "text": "「偶像」…「媒介」…归还…"
        },
        {
          "role": "「黑曜石碑的影像」",
          "text": "（轻柔而缥缈的声音仿佛来自极远之处，又仿佛随风间歇递至耳边的噫语…）"
        },
        {
          "role": "「黑曜石碑的影像」",
          "text": "（冰凉的意识似乎在不断地召唤你，通过…你手中的黑曜石像…）"
        },
        {
          "role": "「黑曜石碑的影像」",
          "text": "归还…归还…"
        },
        {
          "role": "派蒙",
          "text": "旅行者？"
        },
        {
          "role": "「黑曜石碑的影像」",
          "text": "……"
        },
        {
          "role": "「黑曜石碑的影像」",
          "text": "许久未有远方的来者，这里…太大了，太空了。"
        },
        {
          "role": "「黑曜石碑的影像」",
          "text": "污秽的黑暗是不速之客…污染了哪怕最晦暗的梦境…"
        },
        {
          "role": "「黑曜石碑的影像」",
          "text": "我们的国度再次遭到入侵…亡者若被不安的黑潮吞噬，生者的烈火，旦夕之际，亦将熄灭…"
        },
        {
          "role": "「黑曜石碑的影像」",
          "text": "莫轻信所谓「圣山」的愿景，要拒绝…他的承诺…"
        },
        {
          "type": "subtitle",
          "text": "与雷格巴对话"
        },
        {
          "type": "subtitle",
          "text": "打开大门"
        },
        {
          "type": "subtitle",
          "text": "探索遗迹"
        },
        {
          "role": "雷格巴",
          "text": "居然真的能够战胜「大灵」意志的显化…你们比我想象中还要强。"
        },
        {
          "role": "雷格巴",
          "text": "一般部族人看到它们，都会带着敬意远离…因为没有人知道「大灵」的意志究竟是因何显化。"
        },
        {
          "role": "雷格巴",
          "text": "运气好的时候它们会回应你，但是大部分时候都是为了「解决」某些东西才会出现。"
        },
        {
          "role": "派蒙",
          "text": "所以你们也不知道「大灵」要干什么？"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "嗯？"
        },
        {
          "role": "雷格巴",
          "text": "之前也说了，「大灵」集合了已逝守护者的意志…相比之下是伟大却混沌不清的，就如它们的居所，「夜神之国」也是一样。"
        },
        {
          "role": "雷格巴",
          "text": "传说，在拥有炽光羽翼的巨龙从火山中苏醒之后，可怜的人们只能在巨牙，利爪和如幡旗的巨翼之间艰难求生。"
        },
        {
          "role": "雷格巴",
          "text": "与此同时，深渊的影响也在不断加重…"
        },
        {
          "role": "雷格巴",
          "text": "听说就是在情况最危急的那会儿，有部族的人在一阵恍惚之中看到了最深沉的夜里仍然残留的曜石枝叶…"
        },
        {
          "role": "雷格巴",
          "text": "自那以后，越来越多的人才一起在冥冥之中感受到了「夜神之国」…呵呵，他们用图腾、地脉与元素的力量抵抗深渊。"
        },
        {
          "role": "雷格巴",
          "text": "这里就是古代时候的祭坛，部族的先人用黑曜石沟通夜晚的国度。"
        },
        {
          "role": "雷格巴",
          "text": "而「大灵」也在那个时代，作为各个部族生者与逝者集结一同的图腾与意识逐渐成型…"
        },
        {
          "role": "派蒙",
          "text": "原来是这样，所以刚才那个其实不是真的「大灵」，只是「大灵」的一部分？"
        },
        {
          "role": "雷格巴",
          "text": "是的，刚才你们看到的是「大灵」一缕意识的化身，据说「大灵」并不具备真正的实体和形象，这有点难解释，总之，呃…"
        },
        {
          "role": "雷格巴",
          "text": "要是你惹恼了「大灵」，刚才的那个家伙就会再出现！"
        },
        {
          "role": "派蒙",
          "text": "呜哇，那我们还是快点把那个黑曜石像放回祭坛上吧！"
        },
        {
          "type": "subtitle",
          "text": "设法前往遗迹更深处"
        },
        {
          "role": "雷格巴",
          "text": "好了，现在就是将东西物归原主的时刻了。"
        },
        {
          "type": "subtitle",
          "text": "击败「大灵」的意志"
        },
        {
          "type": "subtitle",
          "text": "与雷格巴对话"
        },
        {
          "type": "subtitle",
          "text": "将黑曜石像放回祭坛"
        },
        {
          "type": "subtitle",
          "text": "聆听遥远的低语"
        },
        {
          "type": "subtitle",
          "text": "与雷格巴对话"
        },
        {
          "role": "雷格巴",
          "text": "你们终于回来了！呼…刚刚你们靠近祭坛就「呼」地一下消失了！我还以为你们被「大灵」拘走了呢…可吓到我了。"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔…"
        },
        {
          "role": "派蒙",
          "text": "我们去了一个好可怕的地方！有一个大石碑在和我们说话呢！"
        },
        {
          "role": "派蒙",
          "text": "旅行者怎么了，是在担心我们吗？"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔…唔嗯…"
        },
        {
          "role": "雷格巴",
          "text": "你看，我说你的朋友们会平安归来的。"
        },
        {
          "role": "雷格巴",
          "text": "不过，大石碑？"
        },
        {
          "role": "旅行者",
          "text": "（向雷格巴述说所看到的…）"
        },
        {
          "role": "雷格巴",
          "text": "唉，能够战胜「大灵」意志的显化，听你的描述，又很像是进入了「夜神之国」…"
        },
        {
          "role": "雷格巴",
          "text": "看来你们也不是什么普通的异邦人啊，居然能够看见从夜神之国返还的人，我这辈子也算是值了，哈哈。"
        },
        {
          "role": "雷格巴",
          "text": "好啦，终于解决了这个「小风波」，我们快些上去吧，我还得想办法让封印恢复原状…"
        },
        {
          "role": "派蒙",
          "text": "呜哇…还说什么「小风波」！明明部族的「大灵」意志的显化都被我们…"
        },
        {
          "role": "雷格巴",
          "text": "没关系，它们会随时间从地脉重聚力量的。不用管它。"
        },
        {
          "role": "派蒙",
          "text": "哇…明明是部族人，对待自己的崇拜对象这么随意的吗…"
        },
        {
          "role": "雷格巴",
          "text": "那是你们的幸运，若是遇到个严格一点的部族人，你们可就要吃处罚咯！"
        },
        {
          "role": "派蒙",
          "text": "哇啊，我才不要！"
        },
        {
          "role": "雷格巴",
          "text": "还有你，小家伙，下次可不许再把这里的东西挖出来了！"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "唔…"
        },
        {
          "role": "雷格巴",
          "text": "嘿嘿，我们还是快点离开这里吧，趁还没有别的什么祖先被我们激怒！"
        }
      ]
    }
  ]
}