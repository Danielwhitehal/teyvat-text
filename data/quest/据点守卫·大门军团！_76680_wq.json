{
  "quest_id": 76680,
  "chapter_num": null,
  "chapter_title": "据点守卫·大门军团！",
  "type": "wq",
  "route": "Stronghold Guard: Hoard Guard Unit!",
  "stories": [
    {
      "story_id": 76680,
      "title": "据点守卫·大门军团！",
      "description": "在挪德卡莱，你们遇见了一位名为「青霆」的信使，她正忙着部署自己的独特军团…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与青霆对话"
        },
        {
          "role": "青霆",
          "text": "哦呦，旅行者和派蒙，你们好啊！"
        },
        {
          "role": "青霆",
          "text": "既然巧遇了，要不要来看看我青霆的鼬鼬？它叫洋葱尾巴，很可爱的！"
        },
        {
          "role": "洋葱尾巴",
          "text": "…喵？"
        },
        {
          "role": "青霆",
          "text": "喂喂，洋葱尾巴，你不是这样叫的！这两位应该不懂[[阿舍鲁]]老师的语言。"
        },
        {
          "role": "洋葱尾巴",
          "text": "…咕？"
        },
        {
          "role": "青霆",
          "text": "也不能用团雀语哦，[[拜希麦·五世|拜希麦]]小姐已经回须弥去休养了。"
        },
        {
          "role": "青霆",
          "text": "对不起啊，我家洋葱尾巴和别的动物交流太多，一时错乱了，暂时找不回自己的频道，哈哈…"
        },
        {
          "role": "青霆",
          "text": "先让它休息一下好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你也是动物专家？",
              "dialogues": []
            },
            {
              "text": "你也是动物朋友？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔，怎么感觉你和我们很熟，说话很自然的样子…难道以前调查过我们吗？"
        },
        {
          "role": "青霆",
          "text": "放松，放松，我是你们的自己人——"
        },
        {
          "role": "青霆",
          "text": "我为夜兰老板工作，而你们是夜兰老板最最重要的宾客，咱们关系有多铁，不用多说了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那确实是自己人。",
              "dialogues": []
            },
            {
              "text": "夜兰的朋友也是我们的朋友。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哎呀，早说嘛！害我紧张了一小下…"
        },
        {
          "role": "派蒙",
          "text": "话说回来，你和洋葱尾巴在这荒郊野岭呆站着，是在忙什么呢？"
        },
        {
          "role": "青霆",
          "text": "忙着看大门…或者说，检验我的「看大门军团」能不能好好上工。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看大门？",
              "dialogues": []
            },
            {
              "text": "军团？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "青霆",
          "text": "都是自己人，我悄悄告诉你们——"
        },
        {
          "role": "青霆",
          "text": "这附近的地下藏着我的一座物资据点，但最近，据点老是被各种魔物撬开大门。"
        },
        {
          "role": "青霆",
          "text": "于是我花费重金，请叮铃哐啷蛋卷工坊的天才机械师为我打造了看门的机关军团。"
        },
        {
          "role": "青霆",
          "text": "咳咳，准确描述，应该是安防系统。能够自行选择部署地点，多种功能组合搭配的防御体系。"
        },
        {
          "role": "青霆",
          "text": "我运气不错，再过不久，那位大师就要带着她的作品参加展会，卖给我的这套，就当成前期验证的款式了。"
        },
        {
          "role": "青霆",
          "text": "所以我在据点前方打造了一条复合防线，请君…不对，是请魔物入瓮。"
        },
        {
          "role": "青霆",
          "text": "这样，不仅能试出多个保护据点的方案，还能给大师提供许多数据，一举两得。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来你买到了爱诺的杰作。",
              "dialogues": []
            },
            {
              "text": "听起来还挺有意思的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "青霆",
          "text": "要来试试看吗？我已经借助它们搞定许多魔物了，感觉非常解压。"
        },
        {
          "role": "青霆",
          "text": "你们也来解压一下，顺带，让我参考参考你们的思路！"
        },
        {
          "role": "青霆",
          "text": "当然，酬劳好说。都是自己人，开价得是一般顾问的两倍才行。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "的确，都自己人，多给点！",
              "dialogues": []
            },
            {
              "text": "哎呀，这怎么好意思呢…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯…嗯嗯！考虑到帮你也是变相帮了夜兰，这事对大家都有好处…"
        },
        {
          "role": "派蒙",
          "text": "就让经验丰富的我们露两手好了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（青霆）"
        },
        {
          "role": "青霆",
          "text": "要聊两句吗，旅行者？还是说，你指挥军团的灵感满满，要多来几次试验战？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于洋葱尾巴…",
              "dialogues": [
                {
                  "role": "青霆",
                  "text": "可爱吧！洋葱尾巴可是夜兰老板托付给我的重要搭档！"
                },
                {
                  "role": "青霆",
                  "text": "虽然我一直没搞明白，为什么这只…生活在璃月地下的奇妙鼬鼬…会跟着夜兰老板，还那么听她的话。"
                },
                {
                  "role": "青霆",
                  "text": "但现在，洋葱尾巴和我的默契也很厉害了哦，说是心意相通也不为过！"
                },
                {
                  "role": "青霆",
                  "text": "在纳塔的时候，我的匿叶龙伙伴也和洋葱尾巴很合得来。"
                },
                {
                  "role": "青霆",
                  "text": "哪天回到纳塔了，再请你去我纳塔的小站坐一坐！"
                }
              ]
            },
            {
              "text": "关于夜兰…",
              "dialogues": [
                {
                  "role": "青霆",
                  "text": "老板吗？"
                },
                {
                  "role": "青霆",
                  "text": "前不久我才给她跑了好些个大单，绕了好大一圈路，避开各种威胁，把重要的样本送到璃月去。"
                },
                {
                  "role": "青霆",
                  "text": "遥想去年，我正是在绕大路躲开冤家的时候，才被老板赏识的。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "冤家？",
                      "dialogues": []
                    },
                    {
                      "text": "绕大路？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "青霆",
                  "text": "嗯…说是冤家有点过分了，我的错。"
                },
                {
                  "role": "青霆",
                  "text": "之前，我因为年轻气盛，不讲规矩乱抢单，被行业排挤在外…空有一身飞速送货的本领，没处使。"
                },
                {
                  "role": "青霆",
                  "text": "为了避嫌，从彩石顶去「花羽会」的领地，都要从「硫晶支脉」绕道。"
                },
                {
                  "role": "青霆",
                  "text": "结果选择避人耳目的习惯，对夜兰老板有用，算是误打误撞，在外地开辟了新的生意。"
                },
                {
                  "role": "青霆",
                  "text": "所以老板对我的鼓励，一直被我记在心中——"
                },
                {
                  "role": "青霆",
                  "text": "有时候，人生的辗转反复，可能会让你遇上前所未有的机会。无论如何，都不要失去对生活的热情！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "这话还挺热血的。",
                      "dialogues": []
                    },
                    {
                      "text": "原来夜兰会这么鼓励人？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "青霆",
                  "text": "哈哈，其实不是老板的原话，是我自己的理解，加强情感色彩后的总结！"
                },
                {
                  "role": "青霆",
                  "text": "你知道的，老板总是那么神秘，来去无踪，说话做事都冷静得像是一杯冰水。"
                },
                {
                  "role": "青霆",
                  "text": "老板说，我应该去向老前辈们赔个不是，恢复来往，我觉得的确要这么干才稳妥。"
                },
                {
                  "role": "青霆",
                  "text": "现在我的心态已经比以前好多了，干完这单就照她说的办！"
                }
              ]
            },
            {
              "text": "关于天才机械师…",
              "dialogues": [
                {
                  "role": "青霆",
                  "text": "那位大师啊…赞美她！"
                },
                {
                  "role": "青霆",
                  "text": "多亏老板提点，我在本地打下了不错的人脉基础，才有机会通过层层介绍与她搭上线。"
                },
                {
                  "role": "青霆",
                  "text": "确认我没有什么…利用机关去伤害好人的歪念头后，天才机械师就答应我的请求了！"
                },
                {
                  "role": "青霆",
                  "text": "而且，她家的蛋卷好吃得几乎无敌！"
                },
                {
                  "role": "青霆",
                  "text": "如果她有闲心，在纳塔开一家蛋卷分店…肯定能成为餐饮业的新兴巨头！"
                }
              ]
            },
            {
              "text": "回头再聊！",
              "dialogues": [
                {
                  "role": "青霆",
                  "text": "那就回见了！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（洋葱尾巴）"
        },
        {
          "role": "洋葱尾巴",
          "text": "？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好鼬鼬， 乖！",
              "dialogues": [
                {
                  "role": "洋葱尾巴",
                  "text": "……"
                },
                {
                  "role": "观察洋葱尾巴",
                  "text": "（这只鼬鼬似乎没被人这么夸过，眼神有些躲闪…）"
                }
              ]
            },
            {
              "text": "帅鼬鼬，一起加油！",
              "dialogues": [
                {
                  "role": "洋葱尾巴",
                  "text": "！！"
                },
                {
                  "role": "观察洋葱尾巴",
                  "text": "（这只鼬鼬似乎很受鼓舞，眼里闪烁出充满干劲的光芒…）"
                }
              ]
            },
            {
              "text": "下次再见，鼬鼬！",
              "dialogues": [
                {
                  "role": "观察洋葱尾巴",
                  "text": "（鼬鼬表现得相当平静，只是一动不动地看着你离去…）"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          32,
          34
        ],
        [
          35,
          37
        ]
      ]
    }
  ]
}