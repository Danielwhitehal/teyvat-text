{
  "quest_id": 10012,
  "chapter_num": "白垩与黑龙 第三幕",
  "chapter_title": "雪山上的贼影",
  "type": "eq",
  "route": "Raiders Amidst Snow Mist",
  "stories": [
    {
      "story_id": 41212,
      "title": "雪山上的贼影",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "一切似乎都很顺利。你打算找阿贝多聊聊这把剑的变化。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与阿贝多会合"
        },
        {
          "role": "派蒙",
          "text": "咦？丘丘人呢"
        },
        {
          "role": "阿贝多",
          "text": "唔..这边还有冒险家协会的人留下来的暖源"
        },
        {
          "role": "旅行者",
          "text": "哇！该不会是丘丘人在这边埋伏我们吧"
        },
        {
          "role": "派蒙",
          "text": "难道那个坏东西是故意勾引我们过来？！"
        },
        {
          "role": "阿贝多",
          "text": "竟然有这种事…"
        },
        {
          "role": "派蒙",
          "text": "哇！他们从山洞里出来了！"
        },
        {
          "role": "阿贝多",
          "text": "准备迎战"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "派蒙",
          "text": "阿贝多！我们回来啦！"
        },
        {
          "role": "派蒙",
          "text": "哎呀，是有客人吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：有点眼熟的客人呢。",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "让新人来雪山冒险，或许还是太心急了…"
                }
              ]
            },
            {
              "text": "旅行者：我是不是见过这张脸？",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "让新人来雪山冒险，或许还是太心急了…"
                }
              ]
            }
          ]
        },
        {
          "role": "塞琉斯",
          "text": "可是，冒险不就是挑战自我极限吗？没有磨难、没有刺激的旅途还有什么意思！"
        },
        {
          "role": "塞琉斯",
          "text": "哪怕这一带到处都有凶恶的丘丘人土匪与淹没到膝盖的积雪，冒险家们也绝不能停下脚步。"
        },
        {
          "role": "阿贝多",
          "text": "塞琉斯，说重点。"
        },
        {
          "role": "塞琉斯",
          "text": "哈哈哈，瞧你说的！聊天就跟探险一样，重在过程，哪有什么重点！"
        },
        {
          "role": "塞琉斯",
          "text": "嗯！被打劫到放弃据点，在冰冷的雪堆里生火做饭！"
        },
        {
          "role": "塞琉斯",
          "text": "雪山之旅对冒险家协会各位新人来说，一定是永生难忘的经历，哈哈哈！"
        },
        {
          "role": "阿贝多",
          "text": "嗯，对。"
        },
        {
          "role": "塞琉斯",
          "text": "哪怕此刻他们在心中埋怨我、憎恨我，未来也会为这份回忆感谢我，这就是冒险的传承啊。"
        },
        {
          "role": "阿贝多",
          "text": "嗯，你接着说。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…阿贝多老毛病又犯了，对不感兴趣的东西好冷淡呢…"
        },
        {
          "role": "旅行者",
          "text": "看来他对冒险家的兴趣实在不怎么大。"
        },
        {
          "role": "派蒙",
          "text": "是吗？我看他对你就很有兴趣啊。"
        },
        {
          "role": "塞琉斯",
          "text": "不过，该说是新人太弱，还是雪山太强呢？这次可真是损失惨重啊…"
        },
        {
          "role": "派蒙",
          "text": "为什么损失惨重？"
        },
        {
          "role": "塞琉斯",
          "text": "哦…！你是…！"
        },
        {
          "role": "旅行者",
          "text": "你好，塞琉斯先生。"
        },
        {
          "role": "派蒙",
          "text": "好久不见啦——！"
        },
        {
          "role": "塞琉斯",
          "text": "啊~年轻的冒险家和她的好伙伴，真高兴在这里见到你们。"
        },
        {
          "role": "塞琉斯",
          "text": "希望这片严寒的山脉没有给你们造成太多麻烦。"
        },
        {
          "role": "派蒙",
          "text": "能应付的都不是麻烦！"
        },
        {
          "role": "塞琉斯",
          "text": "哈哈哈，没错！我喜欢你自信的发言！"
        },
        {
          "role": "塞琉斯",
          "text": "特意顶着风雪到这里来，是有不得不办的工作吗？"
        },
        {
          "role": "阿贝多",
          "text": "我来这里采集丘丘人的最新数据，委托她做我的助手。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：（嗯？是这样吗？）",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "原来如此，都是为了理想汇聚在此的追梦者。"
                }
              ]
            },
            {
              "text": "旅行者：（他似乎不想让别人知道剑的事呢。）",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "原来如此，都是为了理想汇聚在此的追梦者。"
                }
              ]
            }
          ]
        },
        {
          "role": "塞琉斯",
          "text": "那就祝各位顺利完成计划。我得先去看看那帮新人，告辞了。"
        },
        {
          "role": "派蒙",
          "text": "哼哼，我好像发现了什么哦！"
        },
        {
          "role": "旅行者",
          "text": "阿贝多瞒着塞琉斯呢。"
        },
        {
          "role": "派蒙",
          "text": "毕竟是把魔剑嘛，不想让其他蒙德人知情也算是情有可原。"
        },
        {
          "role": "阿贝多",
          "text": "我都听见了。"
        },
        {
          "role": "旅行者",
          "text": "我是不是不该问？"
        },
        {
          "role": "阿贝多",
          "text": "没有「应该」与「不该」之分。你想知道的事，我都可以说。"
        },
        {
          "role": "阿贝多",
          "text": "——但不是现在。现在我手上还有些重要的事要办。"
        },
        {
          "role": "派蒙",
          "text": "办事？唔，说是办你自己的事，但我猜…也不会放过我们，对吧？"
        },
        {
          "role": "阿贝多",
          "text": "派蒙，你似乎越来越聪明了。"
        },
        {
          "role": "派蒙",
          "text": "什么话！我一直都很聪明啊！"
        },
        {
          "role": "阿贝多",
          "text": "我在附近发现了一些新栖息地。不同属性的怪物，能为我们提供不同的数据。"
        },
        {
          "role": "旅行者",
          "text": "你对实验的兴趣可真不小。"
        },
        {
          "role": "阿贝多",
          "text": "实验本就是需要毅力才能做成的事。对炼金术士而言，坚持是最基础的素养。"
        },
        {
          "role": "阿贝多",
          "text": "准备好了吗？那就走吧。"
        },
        {
          "type": "subtitle",
          "text": "前往山腰"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "阿贝多",
          "text": "嗯？似乎不在。"
        },
        {
          "role": "派蒙",
          "text": "怪物也会出去串门呀？"
        },
        {
          "role": "阿贝多",
          "text": "那么，在怪物出现之前，你想四处走走，还是休息一会儿？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：休息一会儿，聊聊天怎么样？",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "我也这么想。"
                }
              ]
            },
            {
              "text": "旅行者：正好，我有话想问你。",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "…"
                },
                {
                  "role": "阿贝多",
                  "text": "好吧，你想问什么？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "要聊天了吗？我也要听，给我留个位置！"
        },
        {
          "role": "阿贝多",
          "text": "我知道你对我、对这整件事都有不少问题。如先前所说，我会回答。"
        },
        {
          "role": "阿贝多",
          "text": "不过我也不打算欺骗你。有些还不能挑明的事，现阶段请容我略过。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…意外地是个很坦率的人呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：比我想的还要真诚呢！",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "Tiga plata！"
                }
              ]
            },
            {
              "text": "旅行者：比我想的还要潇洒呢！",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "Tiga plata！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯嗯！…咦？"
        },
        {
          "role": "？？？",
          "text": "Odomu Movo！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：是阿贝多在怪叫吗？",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "你觉得可能吗？"
                }
              ]
            },
            {
              "text": "是派蒙在怪叫吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "才不是！你怎么不说是阿贝多在怪叫呢！"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "啊！是丘丘人！"
        },
        {
          "type": "subtitle",
          "text": "击败来袭的丘丘人"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "派蒙",
          "text": "你们看到了吗？那只丘丘人抓着一本书一样的东西跑掉了！"
        },
        {
          "role": "阿贝多",
          "text": "麻烦了…是我的素描本。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：它也想做绘画大师吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我倒觉得它只是个普通的小偷啦。"
                }
              ]
            },
            {
              "text": "旅行者：它也想学习炼金术吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我倒觉得它只是个普通的小偷啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "竟敢偷我的素描本，哼，胆子不小。"
        },
        {
          "role": "派蒙",
          "text": "阿贝多，以一种很平静的方式生气了呢…"
        },
        {
          "role": "旅行者",
          "text": "我会帮忙的！"
        },
        {
          "type": "subtitle",
          "text": "跟随脚印追踪丘丘人"
        },
        {
          "type": "subtitle",
          "text": "跟随脚印追踪丘丘人"
        },
        {
          "type": "subtitle",
          "text": "跟随脚印追踪丘丘人"
        },
        {
          "type": "subtitle",
          "text": "跟随脚印追踪丘丘人"
        },
        {
          "role": "阿贝多",
          "text": "素描本上有画和笔记，一定要拿回来。"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "派蒙",
          "text": "前面没有路了，只有一个很大的山洞入口。"
        },
        {
          "role": "旅行者",
          "text": "是跑进去了吗？"
        },
        {
          "role": "阿贝多",
          "text": "从脚印的情况来看，它跑进去了。"
        },
        {
          "role": "派蒙",
          "text": "那我们也跟上去吧！不要让它跑远了！"
        },
        {
          "role": "阿贝多",
          "text": "等等。"
        },
        {
          "role": "阿贝多",
          "text": "这座雪山体积惊人，山腹内就算有路，也不会是一马平川的那种。"
        },
        {
          "role": "阿贝多",
          "text": "……"
        },
        {
          "role": "阿贝多",
          "text": "感觉到了吗？带着冰原和山石气味的风…还有回声，里面的空间一定很大。"
        },
        {
          "role": "派蒙",
          "text": "还真是！"
        },
        {
          "role": "阿贝多",
          "text": "所以，轻举妄动对我们没有好处。"
        },
        {
          "role": "派蒙",
          "text": "可是…都已经追到这里了，总不能让它白白跑掉吧！"
        },
        {
          "role": "旅行者",
          "text": "那本素描本对你很重要吧？"
        },
        {
          "role": "阿贝多",
          "text": "很重要，但也不能莽撞行事。"
        },
        {
          "role": "阿贝多",
          "text": "还有另一条路，只是要费些功夫。"
        },
        {
          "role": "阿贝多",
          "text": "没猜错的话，这个山洞的出口在山体另一侧。"
        },
        {
          "role": "阿贝多",
          "text": "你很擅长飞行，我的技术也还不错。做好准备吧，我们一口气飞过去。"
        },
        {
          "type": "subtitle",
          "text": "击碎风琥珀"
        },
        {
          "role": "阿贝多",
          "text": "我们能走的路，绝不只有肉眼能见的那些。"
        },
        {
          "type": "subtitle",
          "text": "利用风场追上丘丘人"
        },
        {
          "type": "subtitle",
          "text": "启动机关引出丘丘人"
        },
        {
          "type": "subtitle",
          "text": "击败敌人，夺回素描本"
        },
        {
          "type": "subtitle",
          "text": "回营地找阿贝多"
        },
        {
          "role": "派蒙",
          "text": "阿贝多，应急工作做得还顺利吗？"
        },
        {
          "role": "阿贝多",
          "text": "还行。有几页遭到破坏，但大部分完好无损。"
        },
        {
          "role": "阿贝多",
          "text": "雪山气温太低，尤其是那个山洞，附近的气温已经达到了极限…"
        },
        {
          "role": "阿贝多",
          "text": "何况丘丘人还把口水弄在了本子上。结冰的纸落在那样的低温里，真是不堪设想。"
        },
        {
          "role": "派蒙",
          "text": "结冰的纸那么脆，一碰就碎了吧？"
        },
        {
          "role": "旅行者",
          "text": "真亏你有办法把素描本救回来。"
        },
        {
          "role": "派蒙",
          "text": "不愧是炼金术士，心灵手巧呀。"
        },
        {
          "role": "派蒙",
          "text": "要是本子损坏严重的话，阿贝多一定会大发雷霆吧？"
        },
        {
          "role": "阿贝多",
          "text": "为什么你会这样想？"
        },
        {
          "role": "派蒙",
          "text": "因为你说过上面有很多图画和笔记。"
        },
        {
          "role": "阿贝多",
          "text": "确实如此，这本素描本一直被我带在身边。"
        },
        {
          "role": "阿贝多",
          "text": "不过，也不至于为这种事太过生气。"
        },
        {
          "role": "阿贝多",
          "text": "如果真的抢救不回来，重新画过就好。"
        },
        {
          "role": "派蒙",
          "text": "咦…这种时候倒很现实了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：我不这么想。",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "是吗？"
                }
              ]
            },
            {
              "text": "旅行者：这种时候应该生气一点哦！",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "是吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "不管怎么说，那都是你用心绘制的画。"
        },
        {
          "role": "派蒙",
          "text": "对呀对呀！"
        },
        {
          "role": "旅行者",
          "text": "画作承载的是记忆。"
        },
        {
          "role": "派蒙",
          "text": "是的！"
        },
        {
          "role": "旅行者",
          "text": "别轻易放弃与回忆有关的东西。"
        },
        {
          "role": "派蒙",
          "text": "#正是如此！哎呀，{NICKNAME}说得真不错，其实我想说的也是这些。"
        },
        {
          "role": "阿贝多",
          "text": "…也是。重画很麻烦，我不喜欢这样。"
        },
        {
          "role": "派蒙",
          "text": "我猜是因为阿贝多很天才吧？"
        },
        {
          "role": "派蒙",
          "text": "你看，你会那么多别人不会的技艺，懂得那么多别人不懂的道理！"
        },
        {
          "role": "派蒙",
          "text": "这样的人有时反而会忽略细节呢。难道说这就是聪明的弊端吗？"
        },
        {
          "role": "旅行者",
          "text": "阿贝多也说过派蒙聪明哦。"
        },
        {
          "role": "阿贝多",
          "text": "是的，派蒙是个很有趣的生物。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：派蒙也会忽略细节吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "啊——不要在我说大道理的时候扯上我自己啦！"
                }
              ]
            },
            {
              "text": "旅行者：派蒙该不会也有弊端吧！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "啊——不要在我说大道理的时候扯上我自己啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "那么，换个话题。之前塞琉斯说，雪山丘丘人会袭击冒险家，抢夺物资。"
        },
        {
          "role": "阿贝多",
          "text": "我们去的，应该就是这群丘丘人的据点之一。"
        },
        {
          "role": "旅行者",
          "text": "这里的丘丘人很强。"
        },
        {
          "role": "派蒙",
          "text": "对，这一带的丘丘人，比山脚下那些丘丘人强不少呢。"
        },
        {
          "role": "阿贝多",
          "text": "我也有同样的感觉。我想…这仍然是与「龙」有关吧。"
        },
        {
          "role": "阿贝多",
          "text": "杜林亡骸中的污秽之力会强化怪物。再加上严寒气候，一些雪山区域便成了无人区。"
        },
        {
          "role": "阿贝多",
          "text": "旅行者，能把剑拿出来吗？"
        },
        {
          "role": "阿贝多",
          "text": "在雪山的每一次战斗，这把剑都会吸收力量，储存在剑身之内。"
        },
        {
          "role": "阿贝多",
          "text": "并且，由于你的净化，那些原本被龙血污染的力量，似乎都被提纯了…"
        },
        {
          "role": "阿贝多",
          "text": "这是很有意思的现象。"
        },
        {
          "role": "派蒙",
          "text": "这种事我们可熟悉了，非常拿手的哦！"
        },
        {
          "role": "阿贝多",
          "text": "虽然知道你有这种力量，但…原来这就是净化，真是百闻不如一见。"
        },
        {
          "role": "旅行者",
          "text": "能储存力量的剑，很危险吧。"
        },
        {
          "role": "阿贝多",
          "text": "的确不能说是非常安全的武器。"
        },
        {
          "role": "派蒙",
          "text": "幸好没被那些丘丘人抢走，否则我们就完了！那群雪山丘丘人会变得多强啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：愚人众更危险吧？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "丘丘人也很危险呀！万一它们得到能量，变成…超级，不，究极丘丘人！"
                }
              ]
            },
            {
              "text": "旅行者：盗宝团更危险吧？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "丘丘人也很危险呀！万一它们得到能量，变成…超级，不，究极丘丘人！"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "丘丘魔人！"
        },
        {
          "role": "派蒙",
          "text": "丘丘恶魔人！"
        },
        {
          "role": "旅行者",
          "text": "丘丘恶魔雪人！"
        },
        {
          "role": "派蒙",
          "text": "为什么加了雪字，感觉一下就变得好弱…"
        },
        {
          "role": "派蒙",
          "text": "说起来，这把剑这么厉害的话，是不是也能吸收阿贝多的力量？"
        },
        {
          "role": "阿贝多",
          "text": "……"
        },
        {
          "role": "阿贝多",
          "text": "想试试吗？"
        },
        {
          "role": "派蒙",
          "text": "呜哇！眼神一下变得冰凉了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：派蒙是开玩笑…",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "不，我没有生气。总之，希望你能继续使用这把剑。"
                }
              ]
            },
            {
              "text": "旅行者：派蒙没有恶意…",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "不，我没有生气。总之，希望你能继续使用这把剑。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "就算这把剑那么危险，你仍然信任我们吗？好意外呀。"
        },
        {
          "role": "派蒙",
          "text": "阿贝多，看起来是这样，心里却好像是那样的！"
        },
        {
          "role": "阿贝多",
          "text": "这样、那样…是怎么样。"
        },
        {
          "role": "阿贝多",
          "text": "说起我信任你们的原因…那或许是因为…"
        },
        {
          "role": "阿贝多",
          "text": "「异类」之间的，某种共识吧。"
        },
        {
          "role": "旅行者",
          "text": "异类？"
        },
        {
          "role": "阿贝多",
          "text": "孤独的个体…与普通人不同的个体，就像…你和我。"
        },
