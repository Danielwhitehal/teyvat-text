{
  "quest_id": 20511,
  "chapter_num": null,
  "chapter_title": "奇药庐中来",
  "type": "iq",
  "route": "Miracle Medicine",
  "stories": [
    {
      "story_id": 20511,
      "title": "奇药庐中来",
      "description": "安东尼向璃月港的一位「神医」求到了一副药方，用来治疗安娜的病…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安东尼对话"
        },
        {
          "role": "安东尼",
          "text": "这药方，真会管用吗…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "安东尼",
          "text": "旅行者！你来得正好，我正发愁呢，"
        },
        {
          "role": "安东尼",
          "text": "是这样，你还记得我妹妹安娜吧，她一直生着病，之前怎么治也没起色…"
        },
        {
          "role": "安东尼",
          "text": "但是我听说璃月港里有一位神医，很擅长解决疑难杂症，就托人去求他开药方。"
        },
        {
          "role": "安东尼",
          "text": "虽然药方里的材料都很奇怪…但也只有试一试了…"
        },
        {
          "role": "安东尼",
          "text": "呃，我看看…你能帮我去找一份「被草史莱姆吞下去过的树莓」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真的有这种东西吗？",
              "dialogues": [
                {
                  "role": "安东尼",
                  "text": "我也不知道啊！草史莱姆真的会吃树莓吗…"
                },
                {
                  "role": "安东尼",
                  "text": "就，就拜托你了！我知道一个地方有草史莱姆出没，也长着树莓。"
                },
                {
                  "role": "安东尼",
                  "text": "拜托你去看看吧，希望能找到…"
                }
              ]
            },
            {
              "text": "庸医误事。",
              "dialogues": [
                {
                  "role": "安东尼",
                  "text": "果然你也这么觉得吗？但是，我也是真的没办法了。"
                },
                {
                  "role": "安东尼",
                  "text": "我知道一个地方有很多草史莱姆，也长着树莓，拜托你去看看吧。"
                },
                {
                  "role": "安东尼",
                  "text": "然后，做出来的药我会先吃下去试试。无论如何，不能让安娜的身体再坏下去了…"
                }
              ]
            },
            {
              "text": "找不到的话，我就抓个草史莱姆给你。",
              "dialogues": [
                {
                  "role": "安东尼",
                  "text": "咦…咦？你是要我亲手把树莓塞给草史莱姆吃吗…"
                },
                {
                  "role": "安东尼",
                  "text": "你就饶了我吧，我上次给安娜采药的时候，被一群草史莱姆一直追到了清泉镇里…"
                },
                {
                  "role": "安东尼",
                  "text": "我知道一个地方有很多草史莱姆，也长着树莓，拜托你去看看吧，希望会有发现…"
                },
                {
                  "role": "安东尼",
                  "text": "但是…如，如果实在不行，为了安娜…你，你就抓个草史莱姆回来吧！我能行！我一定能行…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "查看树莓的状况"
        },
        {
          "role": "安东尼",
          "text": "你找到东西了吗？"
        },
        {
          "role": "旅行者",
          "text": "还没有。"
        },
        {
          "role": "安东尼",
          "text": "拜托你了，请尽快找到吧，安娜的病不能再耽搁了…"
        },
        {
          "type": "subtitle",
          "text": "取得「被草史莱姆吞下去过的树莓」"
        },
        {
          "role": "安东尼",
          "text": "你找到东西了吗？"
        },
        {
          "role": "旅行者",
          "text": "还没有。"
        },
        {
          "role": "安东尼",
          "text": "拜托你了，请尽快找到吧，安娜的病不能再耽搁了…"
        },
        {
          "type": "subtitle",
          "text": "与安东尼对话"
        },
        {
          "role": "安东尼",
          "text": "你找到东西了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了。"
        },
        {
          "role": "安东尼",
          "text": "这就是吗？怎么看起来，没什么不一样…"
        },
        {
          "role": "安东尼",
          "text": "无论怎么看，这都是普通的树莓啊…"
        },
        {
          "role": "安东尼",
          "text": "算了，既然人家医生都这么开方子了，我就按照药方上面写的来做吧。"
        },
        {
          "role": "安东尼",
          "text": "谢谢你，这些是给你的辛苦费。"
        },
        {
          "role": "安东尼",
          "text": "以后说不定还会麻烦你，你可千万别推辞啊。"
        }
      ]
    }
  ]
}