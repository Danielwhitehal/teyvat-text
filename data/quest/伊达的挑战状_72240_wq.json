{
  "quest_id": 72240,
  "chapter_num": null,
  "chapter_title": "伊达的挑战状",
  "type": "wq",
  "route": "Date's Challenge",
  "stories": [
    {
      "story_id": 72240,
      "title": "伊达的挑战状",
      "description": "你决定接受这场迷宫挑战。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆完成解谜"
        },
        {
          "type": "subtitle",
          "text": "碑文"
        },
        {
          "type": "subtitle",
          "text": "（石碑上用能看懂的语言写着提示…）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "我的父亲告诉我，任何行为都应有背后的道义和人前的优雅。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "所以他说，要我用这样的语言记录我给出的迷宫提示。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "只有在常夜里，迷宫的墙壁和打开通路的机关，才会出现。因为他们沐浴着看不见的月光。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "而那被叫做谜底的机关，正藏在迷宫的四角。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "因为我写到最后并不押韵也没有修辞…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "我的父亲，欧律达特，用拐杖打我的屁股。",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "哦哦，迷宫只要在顶上往下看，不就什么难度都没有了吗？嗯嗯，就这么办吧。"
        },
        {
          "type": "subtitle",
          "text": "◆与残影对话"
        },
        {
          "role": "？？？",
          "text": "哦哦，你们也是来品尝我杰作的吗？"
        },
        {
          "role": "派蒙",
          "text": "你是渊下宫的大厨吗？"
        },
        {
          "role": "伊达",
          "text": "我叫伊达，原本名字是代达洛斯，欧律达忒之子，是个迷宫艺术家！你们刚才经历的谜题就是我的杰作。"
        },
        {
          "role": "派蒙",
          "text": "原来是你整出来的。再！见！"
        },
        {
          "role": "伊达",
          "text": "喂，等等等等！我可不是那种只会在纸上画图的小鬼头。我不仅是迷宫艺术家，还是白夜国历史第二好的建筑师！"
        },
        {
          "role": "派蒙",
          "text": "第一是谁啊？"
        },
        {
          "role": "伊达",
          "text": "那必定是阿倍良久之命大人啊。大日御舆算第二的话，没别的建筑敢称第一了。"
        },
        {
          "role": "伊达",
          "text": "能见到我说明你已经通关了我的第一处新感觉派迷宫。"
        },
        {
          "role": "伊达",
          "text": "怎么样，有没有兴趣挑战一下我另一处的反本格派迷宫啊。和只用墙的迷宫完全不同哦。"
        },
        {
          "role": "旅行者",
          "text": "不必。已经品鉴得够多了。"
        },
        {
          "role": "伊达",
          "text": "别、别这样啊。这件迷宫杰作，是在空间和时间、资金都充裕的情况下做出来的。"
        },
        {
          "role": "伊达",
          "text": "因为已经有一部分人去海面海祇岛生活了，所以地下的土地挺富余的。"
        },
        {
          "role": "伊达",
          "text": "我特地借来了《白夜国水文考》，研究了承重和地下空间的最大利用，避开了可能的渗水问题，甚至还兼顾了风水！"
        },
        {
          "role": "伊达",
          "text": "虽然对不起绘真，书不小心被我落在奖励密室里了…"
        },
        {
          "role": "派蒙",
          "text": "你在小声说什么？"
        },
        {
          "role": "伊达",
          "text": "没什么！我隆重邀请您挑战我的迷宫杰作。"
        },
        {
          "role": "伊达",
          "text": "总之先收下这个钥匙吧。用它可以开启谜题。"
        },
        {
          "role": "伊达",
          "text": "挑战成功还能拿到我亲自制作的认可状纪念章哦。"
        },
        {
          "role": "派蒙",
          "text": "并不是那么稀罕就是了。"
        },
        {
          "role": "伊达",
          "text": "我的宝藏也藏在前面的密室里了！拿到两个认可状就可以打开宝库哦。"
        },
        {
          "role": "派蒙",
          "text": "这、这样啊。有空有心情的话我们会去试试的。"
        },
        {
          "role": "伊达",
          "text": "好的呀。期待你们的反馈。"
        },
        {
          "role": "伊达",
          "text": "啊，对了，既然你们通关了第一处迷宫，应该已经拿到第一枚认可状了吧！"
        },
        {
          "role": "派蒙",
          "text": "哦，哦…"
        },
        {
          "role": "伊达",
          "text": "有什么反馈吗？"
        },
        {
          "role": "派蒙",
          "text": "怎么说呢。感觉…"
        },
        {
          "role": "伊达",
          "text": "感觉？"
        },
        {
          "role": "派蒙",
          "text": "感觉缺少一点「噼咔」的感觉。"
        },
        {
          "role": "伊达",
          "text": "「噼咔」，「噼咔」又是什么感觉？"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "伊达",
          "text": "怎么样，挑战过我的反本格派迷宫了吗？"
        },
        {
          "type": "subtitle",
          "text": "◆获得另一个「伊达的认可状」（1/1）"
        },
        {
          "type": "subtitle",
          "text": "很显眼的纸条"
        },
        {
          "type": "subtitle",
          "text": "给这个迷宫加了个锁，老爹总算不会找下来管我写啥了。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "迷宫是迷宫，迷路园是迷路园。迷宫的词源可是双刃斧，当然得对称了！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在常夜里，把这个迷宫的两侧变得对称。那么通路就自然地呈现于眼前。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "是不是在本格之中又有一点先锋。「最后解谜的人做成了迷宫」——很浪漫吧？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "这种浪漫，只会修辞和押韵的老爹这种顽固是不会理解的。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "◆与伊达的残影对话"
        },
        {
          "role": "伊达",
          "text": "那边的迷宫也通关了吗？不错不错。你们赢得了我的认可。"
        },
        {
          "role": "派蒙",
          "text": "哦，哦…"
        },
        {
          "role": "伊达",
          "text": "有什么评价吗？"
        },
        {
          "role": "派蒙",
          "text": "评价？这个嘛…"
        },
        {
          "role": "伊达",
          "text": "嗯嗯，是不是觉得非常精妙非常厉害？"
        },
        {
          "role": "派蒙",
          "text": "欸…欸嘿！"
        },
        {
          "role": "伊达",
          "text": "「欸嘿」是什么意思啊！"
        },
        {
          "role": "伊达",
          "text": "咳咳。既然你们已经收集了两枚认可状，密室的通道应该就打开了。"
        },
        {
          "role": "伊达",
          "text": "把认可状放进去就可以打开宝库门了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "伊达",
          "text": "其实迷宫终究只是手段，不是目的。像是阿倍良久大人那样福泽万民才是我想做的。"
        },
        {
          "type": "subtitle",
          "text": "◆开启伊达的密室，取得宝藏"
        },
        {
          "type": "subtitle",
          "text": "◆获得《白夜国地理水文考》"
        }
      ],
      "collapse_ranges": [
