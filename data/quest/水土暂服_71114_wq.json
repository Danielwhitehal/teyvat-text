{
  "quest_id": 71114,
  "chapter_num": null,
  "chapter_title": "水土暂服",
  "type": "wq",
  "route": "Temporary Acclimatization",
  "stories": [
    {
      "story_id": 71114,
      "title": "水土暂服",
      "description": "水文学家斡流似乎正在为了某事而苦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "帮助斡流安置仪器"
        },
        {
          "role": "派蒙",
          "text": "别、别往下看！太高了，安置好仪器之后就快走啦！"
        },
        {
          "type": "subtitle",
          "text": "帮助斡流安置仪器"
        },
        {
          "role": "派蒙",
          "text": "唔…这里能行吗？算了，我们就相信这台仪器的实力吧。"
        },
        {
          "type": "subtitle",
          "text": "向斡流回报"
        },
        {
          "role": "斡流",
          "text": "前面那个位置应该不错，唔…等一下去吊桥附近看看好了…"
        },
        {
          "role": "斡流",
          "text": "…这么调整应该没问题了。"
        },
        {
          "role": "斡流",
          "text": "旅行者，你们把仪器都安置好了？真是太感谢了。"
        },
        {
          "role": "斡流",
          "text": "等我把这台仪器也安置好，就把报酬结给你们。"
        },
        {
          "role": "旅行者",
          "text": "刚才直接让我一起安置就好啦。"
        },
        {
          "role": "斡流",
          "text": "多谢你的好意。不过，这台仪器有些特殊，需要调试的地方有些多，要是你来操作的话，实在太麻烦你了。"
        },
        {
          "role": "斡流",
          "text": "我们先去那边的悬崖上把这台仪器安置好，然后我就可以和你们结清报酬了。"
        },
        {
          "role": "派蒙",
          "text": "听起来好复杂…你一直都这样工作的吗？"
        },
        {
          "role": "斡流",
          "text": "现在我只用把仪器安置在陆地上…在有一次考察里，我还不得不想办法把仪器浸到一条大江的中央呢。"
        },
        {
          "role": "旅行者",
          "text": "不能直接坐船过去吗？"
        },
        {
          "role": "斡流",
          "text": "唉，如果只用把仪器沉进江水里，那我当然可以坐着船，过去把仪器丢进水里，然后就离开…"
        },
        {
          "role": "斡流",
          "text": "但那次考察我要勘测的是水流强度，所以必须把勘测用的特型仪器持续置于水流的中央，不能浮到顶，也不能沉到底…"
        },
        {
          "role": "斡流",
          "text": "还好那条河上面有一座吊桥，要是没吊桥的话，我就只能求人在两座山之间拉一条绳索…"
        },
        {
          "role": "斡流",
          "text": "再把这台仪器用绳索吊起来，用另一条绳索拉着，一直送到河流中心再放下。"
        },
        {
          "role": "斡流",
          "text": "咳…先不说这些了，现在我们也不用处理这种情况…虽然我们等会也要路过一座吊桥。"
        },
        {
          "role": "斡流",
          "text": "这边走吧，那座吊桥离我们不远。"
        },
        {
          "type": "subtitle",
          "text": "和斡流同行"
        },
        {
          "type": "subtitle",
          "text": "打倒所有盗宝团"
        },
        {
          "type": "subtitle",
          "text": "与被困的人对话"
        },
        {
          "role": "邱老板",
          "text": "谢谢，太谢谢你了，您…"
        },
        {
          "role": "旅行者",
          "text": "你是…邱老板？"
        },
        {
          "role": "邱老板",
          "text": "您、您是旅行者！怎么遇见您了，这真是…我又欠了您一笔大人情啊！"
        },
        {
          "role": "派蒙",
          "text": "你们不是在枫丹学怎么拍映影吗？怎么突然回璃月了呀？"
        },
        {
          "role": "旅行者",
          "text": "已经学成了？"
        },
        {
          "role": "弈丰",
          "text": "与其说是学成了…"
        },
        {
          "role": "兴晔",
          "text": "不如说是不得不「先赚钱」啦。"
        },
        {
          "role": "邱老板",
          "text": "你们两个人…"
        },
        {
          "role": "弈丰",
          "text": "热塞尔先生的确非常专业，为我们做出的各种指导也非常有用，但是…"
        },
        {
          "role": "兴晔",
          "text": "他所指导我们拍的映影，都太过注重表现意义和概念，至于具体的事物和情节嘛…"
        },
        {
          "role": "弈丰",
          "text": "用热塞尔先生的话来说，就「让他们退居幕后」了。"
        },
        {
          "role": "兴晔",
          "text": "但我们要拍的可是用来宣传翘英庄茶叶的映影，这么学下去，根本就是南辕北辙嘛，所以…"
        },
        {
          "role": "邱老板",
          "text": "所以！我就决定，暂停学习，先回来拍一部记录映影，用实际的练习来检验我们的学习成果！"
        },
        {
          "role": "弈丰",
          "text": "…也有一部分原因是，我们的资金快用差不多了啦。"
        },
        {
          "role": "邱老板",
          "text": "都、都说了，我已经把事情都计划好了，只要我们拍好这部映影，资金不就回来了吗？"
        },
        {
          "role": "弈丰",
          "text": "然后，就被盗宝团两头堵在了吊桥上，还好有旅行者搭救啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这里…是不是离翘英庄有点远？",
            "但你们拍翘英庄，来这里做什么？"
          ]
        },
        {
          "role": "邱老板",
          "text": "唉，我这不是想要取一些壮观的景色，放在映影里壮壮声势吗？"
        },
        {
          "role": "邱老板",
          "text": "谁知道拍得太入神，被这些盗宝团抓住了空档，我们一路跑到了这里，结果还是被堵住了…"
        },
        {
          "role": "派蒙",
          "text": "等等，难道斡流小姐之前说的那几位专业的留影师，就是…"
        },
        {
          "role": "斡流",
          "text": "没错，就是邱老板他们。"
        },
        {
          "role": "邱老板",
          "text": "斡流小姐，你、你是从哪冒出来的？我刚才都没见到你…"
        },
        {
          "role": "斡流",
          "text": "因为我藏得比较好。"
        },
        {
          "role": "旅行者",
          "text": "原来你们都认识啊…"
        },
        {
          "role": "邱老板",
          "text": "哎呀，斡流小姐是专业的水文学家，对这附近的地形了如指掌。"
        },
        {
          "role": "邱老板",
          "text": "关于取景点这个问题，我们也请教了她很多次。"
        },
        {
          "role": "邱老板",
          "text": "我们还想请斡流小姐加入我们的映影团队呢！可她说要等到自己有空的时候再考虑…"
        },
        {
          "role": "弈丰",
          "text": "老板，那个…我们刚才跑的时候，好像把装着画片和设备的箱子放在原地了…"
        },
        {
          "role": "兴晔",
          "text": "里面…好像还有我们拍了一部分的映影画片…"
        },
        {
          "role": "邱老板",
          "text": "……"
        },
        {
          "role": "邱老板",
          "text": "斡流小姐！旅行者，派蒙，多谢你们了啊！有…有空的话，就来翘英庄找我吧！"
        },
        {
          "role": "邱老板",
          "text": "无论怎么说…这救命之恩，多少得为你准备点报酬。"
        },
        {
          "role": "邱老板",
          "text": "我们就先告辞了啊！快快快！那个箱子放哪了！快走快走！"
        },
        {
          "type": "subtitle",
          "text": "邱老板一行人急匆匆地离开了…"
        },
        {
          "role": "派蒙",
          "text": "感觉…邱老板他们的箱子，真是多灾多难呢…"
        },
        {
          "role": "斡流",
          "text": "俗话说「好事多磨」，邱老板一定能拍出很不错的映影。"
        },
        {
          "role": "斡流",
          "text": "好了，我先把报酬结给你们吧。等一下我就去安置最后一台仪器，然后…我也会找个时间，去和邱老板聊聊。"
        },
        {
          "role": "斡流",
          "text": "不然，他们不知道又要跑去什么地方拍映影了。"
        },
        {
          "role": "斡流",
          "text": "唔，他们刚才说，可以去翘英庄找他们吧…等一下我先去那边找找好了。"
        },
        {
          "type": "subtitle",
          "text": "在翘英庄寻找邱老板"
        },
        {
          "role": "邱老板",
          "text": "唉，还是先把翘英庄里的景取了吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "一切都还好吗？",
            "看来你们没损失设备嘛。"
          ]
        },
        {
          "role": "邱老板",
          "text": "旅行者，派蒙，哎哟！托了你们的福，设备和画片一点没丢。"
        },
        {
          "role": "邱老板",
          "text": "不过，我们下次想要去那边取景，看来必须得去雇几个冒险家同行了…"
        },
        {
          "role": "派蒙",
          "text": "所以，你们那部关于茶的映影，到底拍得怎么样了呀？"
        },
        {
          "role": "邱老板",
          "text": "呃…这部片子处于…"
        },
        {
          "role": "兴晔",
          "text": "有一个良好的开头。"
        },
        {
          "role": "弈丰",
          "text": "和一个良好的趋势。"
        },
        {
          "role": "旅行者",
          "text": "这不就是才刚开始拍吗？！"
        },
        {
          "role": "邱老板",
          "text": "哎呀，我们现在的资金…有点紧张，热塞尔先生的收费就和他的学问一样高超…"
        },
        {
          "role": "邱老板",
          "text": "虽然我们也拍了几部小片，赚了几笔小钱，但这种大型记录映影，实在是太花钱了。"
        },
        {
          "role": "兴晔",
          "text": "特别是老板还拒绝了几家过来赞助的客商。"
        },
        {
          "role": "弈丰",
          "text": "和谢绝了一堆合作邀请。"
        },
        {
          "role": "邱老板",
          "text": "你们懂什么！这是为了我们能完全依照我们自己的审美，拍出一部好片。"
        },
        {
          "role": "兴晔",
          "text": "但是老板，我们最开始拍片的目的，不也是为了赚钱吗…"
        },
        {
          "role": "邱老板",
          "text": "我…你、你们别管这么多，先去把设备支起来！"
        },
        {
          "role": "邱老板",
          "text": "旅行者，这些报酬给你，多谢你帮我这么多次。"
        },
        {
          "role": "邱老板",
          "text": "等我拍出了好片，一定请你来看，然后再请你喝一顿好茶。"
        },
        {
          "role": "邱老板",
          "text": "弈丰，兴晔，找好光源角度！这次要一遍拍好！"
        },
        {
          "role": "兴晔",
          "text": "老板，这又不是拍人和人的对手戏…"
        },
        {
          "role": "弈丰",
          "text": "拍景物能不能一遍过，不都是全凭缘分嘛。"
        },
        {
          "role": "邱老板",
          "text": "总…总之先把设备架起来！先…先在这等着！"
        }
      ]
    }
  ]
}