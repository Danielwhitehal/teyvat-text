{
  "quest_id": 70814,
  "chapter_num": null,
  "chapter_title": "冒险家…该干嘛？",
  "type": "wq",
  "route": "...What Do Adventurers Do Again?",
  "stories": [
    {
      "story_id": 70814,
      "title": "冒险家…该干嘛？",
      "description": "在岚姐的指示下，璃月港冒险家协会的甜甜正负责分发各类委托，但是，她似乎不知道到底冒险家协会该发布何种委托…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与甜甜对话"
        },
        {
          "role": "甜甜",
          "text": "是，是冒险家吗？您是来接受委托的吗…"
        },
        {
          "role": "甜甜",
          "text": "呜…您，您稍等一下，我找找，我这里的委托有…「风之翼竞速」、「野外生存体验向导」，还有「自由攀岩教练」…"
        },
        {
          "role": "旅行者",
          "text": "完全不像冒险家协会…"
        },
        {
          "role": "甜甜",
          "text": "我知道啦！岚姐也这么说，可是我看书里的那些「冒险」不都是这些的吗？"
        },
        {
          "role": "甜甜",
          "text": "不发布这些委托，还能发布什么啊…"
        },
        {
          "role": "旅行者",
          "text": "比如，扫清魔物之类的…"
        },
        {
          "role": "甜甜",
          "text": "那，那也太危险了吧，虽然璃沙郊那边确实有很多魔物，也对行人很有威胁。"
        },
        {
          "role": "甜甜",
          "text": "但是，一般人肯定没办法对付他们的，说不定还会受伤…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "甜甜",
                  "text": "可以吗，那…就拜托你了，我待会回去会和岚姐商量，给你一个合适的报酬的。"
                }
              ]
            },
            {
              "text": "冒险家可不是一般人。",
              "dialogues": [
                {
                  "role": "甜甜",
                  "text": "是这样吗…那，那就拜托你了，我待会回去会和岚姐商量，给你一个合适的报酬的。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "扫清所有魔物并清除路障"
        },
        {
          "role": "岚姐",
          "text": "怎么，还有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "你找到那把剑了吗？"
        },
        {
          "role": "岚姐",
          "text": "…亏你还记得，很遗憾，还是没有任何线索。"
        },
        {
          "role": "岚姐",
          "text": "看来，我还处在「踏破铁鞋无觅处」的阶段。"
        },
        {
          "role": "岚姐",
          "text": "如果有什么相关的委托，我说不定也会找你的，到那时候，可就要拜托你了。"
        },
        {
          "type": "subtitle",
          "text": "与甜甜对话"
        },
        {
          "role": "甜甜",
          "text": "咦？你已经回来了，委托完成了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经完成了。"
        },
        {
          "role": "甜甜",
          "text": "你可真厉害…我刚才按照那个委托的标准，回去冒险家协会整理了一下委托。"
        },
        {
          "role": "甜甜",
          "text": "类似清扫魔物的委托有一大堆，原来冒险家们平时都在做这个吗…"
        },
        {
          "role": "甜甜",
          "text": "但是除了扫清魔物之外，还有报告说，有很多盗宝团在道路上盘踞。"
        },
        {
          "role": "甜甜",
          "text": "这个归冒险家管吗？感觉更像是千岩军的职责范围…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可以归。",
              "dialogues": [
                {
                  "role": "甜甜",
                  "text": "这样啊，冒险家简直像是无所不能呢。"
                }
              ]
            },
            {
              "text": "只要报酬足够…",
              "dialogues": [
                {
                  "role": "甜甜",
                  "text": "冒险家可真厉害…简直像是无所不能。"
                }
              ]
            }
          ]
        },
        {
          "role": "甜甜",
          "text": "那么，我会为你准备好合适的报酬，这个委托也拜托你了！"
        },
        {
          "role": "派蒙",
          "text": "怎么还有临时追加的委托呀！我们之前完全没有…"
        },
        {
          "role": "甜甜",
          "text": "会有更多的报酬的！我已经和岚姐说过了，只要你们再完成委托，就会有更多的报酬！"
        },
        {
          "role": "旅行者",
          "text": "这还差不多。"
        },
        {
          "role": "甜甜",
          "text": "那么，就拜托你啦。"
        },
        {
          "role": "甜甜",
          "text": "这下子，一次就发出了两个委托了。"
        },
        {
          "role": "甜甜",
          "text": "岚姐和我说的「让冒险家乖乖接受委托的秘诀」果然有用…"
        },
        {
          "type": "subtitle",
          "text": "打倒璃沙郊地区的盗宝团"
        },
        {
          "role": "甜甜",
          "text": "冒险家们，原来都要做这种危险的事情吗？"
        },
        {
          "role": "甜甜",
          "text": "要是受伤了可怎么办啊…"
        },
        {
          "type": "subtitle",
          "text": "与甜甜对话"
        },
        {
          "role": "甜甜",
          "text": "您完成委托了吗？"
        },
        {
          "role": "旅行者",
          "text": "完成了。"
        },
        {
          "role": "甜甜",
          "text": "好厉害…这就是冒险家的实力吗？"
        },
        {
          "role": "甜甜",
          "text": "那个，要是您不介意的话，能回答我几个关于冒险家和委托的问题吗？"
        },
        {
          "role": "甜甜",
          "text": "嗯…对冒险家来说，除了清扫怪物之外，他们还会接受什么委托？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "会帮人修理车辆和房屋。",
              "dialogues": []
            },
            {
              "text": "还会帮人采花和抓鱼。",
              "dialogues": []
            },
            {
              "text": "也会送餐和陪孩子们玩。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "甜甜",
          "text": "哇，这不是什么都会做吗，原来冒险家要这么全能。"
        },
        {
          "role": "甜甜",
          "text": "谢谢您！我先记下来…对了，这是您的报酬，请您收好，很丰厚的哦。"
        },
        {
          "role": "甜甜",
          "text": "下次您来我这里接受委托的时候，我一定会给您准备最好的委托的！"
        }
      ]
    }
  ]
}