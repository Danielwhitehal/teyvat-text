{
  "quest_id": 73680,
  "chapter_num": null,
  "chapter_title": "丰饶之箱",
  "type": "wq",
  "route": "Fecund Hamper",
  "stories": [
    {
      "story_id": 73680,
      "title": "丰饶之箱",
      "description": "佳酿节的美酒集市附近新安置了一块公告板，到底是做什么用的呢…",
      "dialogues": [
        {
          "role": "安内特",
          "text": "你们好，欢迎参加归风佳酿节，愿巴巴托斯大人祝福你们。"
        },
        {
          "role": "",
          "text": "咦，旅行者，你看，这里立着一块公告板，上面还贴了不少纸片，难道说是有什么委托吗？"
        },
        {
          "role": "安内特",
          "text": "呵呵，并不是委托哦，这些都是寻找「丰饶之箱」的线索。"
        },
        {
          "role": "",
          "text": "什么什么，「丰饶之箱」？是什么宝物吗？"
        },
        {
          "role": "安内特",
          "text": "唔，这么理解倒也没错啦。看起来你们是第一次参加佳酿节，如果有兴趣的话，我来稍微讲解一下怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "既然派蒙这么感兴趣…",
            "那就拜托你了。"
          ]
        },
        {
          "role": "旅行者",
          "text": "既然派蒙这么感兴趣…"
        },
        {
          "role": "安内特",
          "text": "好的。简单来说，「丰饶之箱」是蒙德居民在佳酿节期间，为幸运的陌生人准备的礼物。"
        },
        {
          "role": "安内特",
          "text": "因为佳酿节不仅是迎接巴巴托斯大人归来的节日，也是大家共同分享丰收喜悦，回顾美好往事的节日。"
        },
        {
          "role": "安内特",
          "text": "大家会把礼物放在橡木桶造型的木箱中，藏在某个对自己来说充满回忆的地方。"
        },
        {
          "role": "安内特",
          "text": "接下来，礼物的主人会留下线索，无论是谁，只要能最先找到箱子，就能获得礼物。"
        },
        {
          "role": "安内特",
          "text": "除了礼物，大家还会在箱子里留下给找到礼物人的赠言。这份诚挚的祝福，往往比礼物本身要更有价值呢。"
        },
        {
          "role": "",
          "text": "听起来好像挺有意思的！"
        },
        {
          "role": "安内特",
          "text": "怎么样，二位要来试试寻找「丰饶之箱」吗？只要对蒙德的风土人情有一定了解，应该能很容易破解线索。"
        },
        {
          "role": "",
          "text": "旅行者，那我们就来试试吧，说不定还能找到我们认识的人留下的礼物呢！"
        },
        {
          "role": "安内特",
          "text": "祝二位好运，在佳酿节玩得开心！"
        }
      ]
    }
  ]
}