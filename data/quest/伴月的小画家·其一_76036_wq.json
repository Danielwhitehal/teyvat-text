{
  "quest_id": 76036,
  "chapter_num": null,
  "chapter_title": "伴月的小画家·其一",
  "type": "wq",
  "route": "The Artist By the Moon's Side (I)",
  "stories": [
    {
      "story_id": 76036,
      "title": "伴月的小画家·其一",
      "description": "在「银月之庭」，「少女」似乎遇到了一些困难…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同「少女」见面"
        },
        {
          "role": "派蒙",
          "text": "上次来听到了很多「愚人众」的话题呢，不知道今天她心情怎么样，会聊些什么呢？"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅？"
        },
        {
          "role": "派蒙",
          "text": "欸？她看起来好不开心的样子！"
        },
        {
          "role": "「少女」",
          "text": "是这个吗？"
        },
        {
          "role": "「少女」",
          "text": "也不是这个？"
        },
        {
          "role": "「少女」",
          "text": "这个呢？"
        },
        {
          "role": "「少女」",
          "text": "不是这个蓝色吗？"
        },
        {
          "role": "月灵",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哥伦比娅？",
              "dialogues": []
            },
            {
              "text": "发生什么了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "嗯？是你们。"
        },
        {
          "role": "「少女」",
          "text": "帮帮我好吗？之后会给你们好处的。"
        },
        {
          "role": "派蒙",
          "text": "呃…你什么时候才能改掉这个习惯啦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你之前也帮过我们很多…",
              "dialogues": []
            },
            {
              "text": "你之前也给过我们赐福…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，就算没什么好处我们也会帮忙的啦。"
        },
        {
          "role": "派蒙",
          "text": "所以到底怎么了？"
        },
        {
          "role": "「少女」",
          "text": "唔…准确来说，是它需要帮助。"
        },
        {
          "role": "月灵",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "这只月灵？"
        },
        {
          "role": "「少女」",
          "text": "这孩子不知从哪里捡到了一支画笔，回来后在我周围开心地晃。"
        },
        {
          "role": "「少女」",
          "text": "我给它找了些画布和颜料，但画了一阵子后，它好像怎么也调不出心仪的颜色。"
        },
        {
          "role": "努昂诺塔",
          "text": "……！"
        },
        {
          "role": "派蒙",
          "text": "咦，你怎么出来了？"
        },
        {
          "role": "努昂诺塔",
          "text": "！！"
        },
        {
          "role": "月灵",
          "text": "？？"
        },
        {
          "role": "努昂诺塔",
          "text": "……！"
        },
        {
          "role": "派蒙",
          "text": "呃…就算你这么比划，我们也不知道你要什么啦…"
        },
        {
          "role": "努昂诺塔",
          "text": "……"
        },
        {
          "role": "努昂诺塔",
          "text": "！！"
        },
        {
          "role": "月灵",
          "text": "！！"
        },
        {
          "role": "派蒙",
          "text": "呀！它好像看上了你的背包。"
        },
        {
          "role": "「少女」",
          "text": "你们身上有带合适的颜料吗？"
        },
        {
          "role": "派蒙",
          "text": "我们不会随身带那种东西啦…话说回来，哥伦比娅是从哪里找到颜料的？你平时也不像会画画的样子。"
        },
        {
          "role": "「少女」",
          "text": "这孩子有些等不及，我就随手用身边带颜色的花朵给它做了些。"
        },
        {
          "role": "派蒙",
          "text": "哦！难道说，努昂诺塔也是想找一些色彩丰富的东西来做颜料吗？"
        },
        {
          "role": "派蒙",
          "text": "快快快，看看我们包里都有些什么。"
        },
        {
          "type": "subtitle",
          "text": "将一些色彩丰富的东西交给月灵"
        },
        {
          "role": "月灵",
          "text": "！！"
        },
        {
          "role": "派蒙",
          "text": "别急哦，我们找找，最好是挪德卡莱颜色丰富的植物，对吧？"
        },
        {
          "type": "subtitle",
          "text": "交付宿影花/白灵果/霜盏花/夏槲果",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这些就够了吧？"
        },
        {
          "role": "「少女」",
          "text": "嗯，它看起来很满意。"
        },
        {
          "role": "月灵",
          "text": "~！"
        },
        {
          "role": "派蒙",
          "text": "我以前都不知道月灵还会画画呢。"
        },
        {
          "role": "「少女」",
          "text": "它们其实和我们一样，有着各自的性格和爱好。"
        },
        {
          "role": "派蒙",
          "text": "欸？难道说挪德卡莱的每一只月灵你都认识？"
        },
        {
          "role": "「少女」",
          "text": "嗯，只要见过的话就认识。"
        },
        {
          "role": "派蒙",
          "text": "这么厉害？！在我看来除了努昂诺塔有些特殊之外，其他月灵几乎都长一个样…"
        },
        {
          "role": "派蒙",
          "text": "那这只会画画的小家伙叫什么名字呀？"
        },
        {
          "role": "「少女」",
          "text": "名字…？"
        },
        {
          "role": "派蒙",
          "text": "你该不会没给它们取名字吧…"
        },
        {
          "role": "「少女」",
          "text": "我认识它们，它们也认识我，不需要名字…我也没有名字呀。"
        },
        {
          "role": "派蒙",
          "text": "不要把不好的传统延续下去呀！"
        },
        {
          "role": "派蒙",
          "text": "呃…那，那我想想…「努昂诺塔」意思是月神赐福下诞生的生灵…"
        },
        {
          "role": "派蒙",
          "text": "那「画」在「霜月之子」的语言里是怎么说的？"
        },
        {
          "role": "「少女」",
          "text": "好像是…梅…娜？梅拉？是梅拉。"
        },
        {
          "role": "派蒙",
          "text": "听着还不错，那就叫它「梅拉」好了！"
        },
        {
          "role": "梅拉",
          "text": "？？"
        },
        {
          "role": "派蒙",
          "text": "怎么样，梅拉，你画好了吗？"
        },
        {
          "role": "梅拉",
          "text": "！！"
        },
        {
          "role": "派蒙",
          "text": "哦！我看看我看看…这！这…！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "[[file",
          "text": "伴月纪闻-伴月的小画家·其一-CG1.png|center|1100px]]"
        },
        {
          "role": "派蒙",
          "text": "这画得也太好了！"
        },
        {
          "role": "派蒙",
          "text": "我还以为画得会比较孩子气…或者…像美露莘那样…"
        },
        {
          "role": "「少女」",
          "text": "月灵很擅长感知周围的环境，在临摹所见之物的时候，倾向于将自己的感受原封不动地记录下来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "梅拉画的是…哥伦比娅？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梅拉",
          "text": "！！"
        },
        {
          "role": "「少女」",
          "text": "嗯？"
        },
        {
          "role": "派蒙",
          "text": "…看起来像是哥伦比娅刚诞生时的样子。"
        },
        {
          "role": "「少女」",
          "text": "欸？"
        },
        {
          "role": "派蒙",
          "text": "我记得菈乌玛也说过，你诞生的时候被「霜月之子」记录了下来，不过和这幅画似乎有些区别。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "而且月灵这种生物…",
              "dialogues": []
            },
            {
              "text": "应该是月神诞生后出现的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "这孩子…梅拉，是最初诞生的月灵之一。它或许是结合自己的感知，想象了当时的画面吧。"
        },
        {
          "role": "派蒙",
          "text": "哦！这么看来，梅拉在很努力地为我们介绍自己的神明呢。"
        },
        {
          "role": "梅拉",
          "text": "~！"
        },
        {
          "role": "「少女」",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "放心吧，我们会和哥伦比娅好好相处的。"
        },
        {
          "role": "梅拉",
          "text": "！！"
        },
        {
          "role": "派蒙",
          "text": "咦？这么快又画好一张？"
        },
        {
          "role": "「少女」",
          "text": "……？"
        },
        {
          "role": "[[file",
          "text": "伴月纪闻-伴月的小画家·其一-CG2.png|center|1100px]]"
        },
        {
          "role": "派蒙",
          "text": "这画的是…「霜月之子」将哥伦比娅奉为神明时候的事吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯？哥伦比娅在祭坛那边干什么呢？画得太小了有些看不清。"
        },
        {
          "role": "梅拉",
          "text": "~！"
        },
        {
          "role": "[[file",
          "text": "伴月纪闻-伴月的小画家·其一-CG3.png|center|1100px]]"
        },
        {
          "role": "派蒙",
          "text": "原来是在吃贡品吗！"
        },
        {
          "role": "「少女」",
          "text": "…不能吃吗？"
        },
        {
          "role": "派蒙",
          "text": "倒也不是说不能吃吧，只是…有些意外。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看你吃得很开心…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "因为…好吃嘛…"
        },
        {
          "role": "派蒙",
          "text": "也是…"
        },
        {
          "role": "梅拉",
          "text": "~！"
        },
        {
          "role": "「少女」",
          "text": "好，知道了。"
        },
        {
          "role": "「少女」",
          "text": "手给我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可以不要「回报」的…",
              "dialogues": []
            },
            {
              "text": "这个不能吃…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "不，这算是「相处」的证明。"
        }
      ]
    }
  ]
}