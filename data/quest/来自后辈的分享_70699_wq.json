{
  "quest_id": 70699,
  "chapter_num": null,
  "chapter_title": "来自后辈的分享",
  "type": "wq",
  "route": "A Message From the Junior",
  "stories": [
    {
      "story_id": 70699,
      "title": "来自后辈的分享",
      "description": "游击小队成员米卡似乎有了新的收获，正等待与你分享…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与米卡对话"
        },
        {
          "role": "米卡",
          "text": "能请到荣誉骑士前辈试玩游艺项目，实在是太幸运了，感觉安心了不少！"
        },
        {
          "role": "米卡",
          "text": "说实话，我还是第一次参与这种开发工作呢，有点紧张，感觉脑力常常不够用…"
        },
        {
          "role": "米卡",
          "text": "明明只是给一个成熟的机关装上外壳，却要顾及方方面面的设计，调试许多参数…"
        },
        {
          "role": "米卡",
          "text": "要是像阿贝多长官那样，从零开始制作专用装备，不知道会遇见多少难题！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "现在的成品已经很稳定了。",
              "dialogues": []
            },
            {
              "text": "相信自己，你会不断进步。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "米卡",
          "text": "呜啊…谢谢…谢谢荣誉骑士前辈的肯定！"
        },
        {
          "role": "米卡",
          "text": "我，我会加油的，争取以后能独自为游击小队开发出更多实用的东西…"
        },
        {
          "role": "米卡",
          "text": "之前我赢来了几只玩偶，这一只送给你…"
        },
        {
          "role": "米卡",
          "text": "我有一只一样的，以后，只要看到这个玩偶，我就能想起你给我的鼓励！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（米卡）"
        },
        {
          "role": "米卡",
          "text": "前辈，试飞「前哨龙迹」后，如果有什么想法，请尽管告诉我…严苛的批评也没关系！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "叫我前辈还是有点生分了哦。",
              "dialogues": [
                {
                  "role": "米卡",
                  "text": "生分的意思是？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "论骑士资历，你比我老哦。",
                      "dialogues": []
                    },
                    {
                      "text": "不论资历，我们是朋友嘛。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "米卡",
                  "text": "啊…以前确实没这么称呼过你，可能让你有些不适应，我尽快改正！"
                },
                {
                  "role": "米卡",
                  "text": "主要是，「国际越野赛」期间，我接触到了好几位纳塔朋友，以不一样的角度，听说了你在纳塔的传奇故事。"
                },
                {
                  "role": "米卡",
                  "text": "你战胜了那么恐怖的危机，成为了整个国度的大英雄，还和以前我想都不敢想的厉害人物顺利合作…"
                },
                {
                  "role": "米卡",
                  "text": "无论从冒险经历，还是为人处世的角度，你的经验和成就都已经绚烂得堪比星空，令我无比钦佩！"
                },
                {
                  "role": "米卡",
                  "text": "相比之下，最近的我似乎没有什么长进…"
                },
                {
                  "role": "米卡",
                  "text": "如果说，以前我是朝着你的背影努力，现在的你前进得有些迅猛，都快消失在地平线上了…"
                },
                {
                  "role": "米卡",
                  "text": "所以，下意识就对你使用了尊称…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "不要气馁，你也会变强的！",
                      "dialogues": []
                    },
                    {
                      "text": "有机会一起出门锻炼！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "米卡",
                  "text": "呜…谢谢！我肯定会继续磨练自己的本领，绝不能丧气！"
                },
                {
                  "role": "米卡",
                  "text": "单单埋头苦练，只凭勤奋，好像也不是个办法…需要换换思路。"
                },
                {
                  "role": "米卡",
                  "text": "我会尽量找机会，多接触一些新事物，打破固有思维…"
                },
                {
                  "role": "米卡",
                  "text": "这次合作改进「前哨龙龙」，就当是一种练习了！"
                }
              ]
            },
            {
              "text": "勘测机关不会抢你的工作吗？",
              "dialogues": [
                {
                  "role": "米卡",
                  "text": "机关和人的工作之争吗…这个问题我之前也思考过。"
                },
                {
                  "role": "米卡",
                  "text": "我在挪德卡莱停留的时候，读到了三本枫丹和璃月工程人员的著作，受到了不少启发。"
                },
                {
                  "role": "米卡",
                  "text": "拥有无限能源，能够从无限远的距离上遥控的机关，确实能替代我这种测绘员，甚至其他岗位的骑士。"
                },
                {
                  "role": "米卡",
                  "text": "之前，骑士团的同僚在考察枫丹的警卫机关后，也感慨过：「将来迟早要用无人机关打仗，完全不需要士兵上阵」。"
                },
                {
                  "role": "米卡",
                  "text": "但那只是理想条件，只谈供能和行动策略的问题，就不是机关能独立解决的。"
                },
                {
                  "role": "米卡",
                  "text": "大部分机关不可能直接从营地出发，抵达目标位置后开始行动，那样的话，在执行任务前，储备的能量就不知会损耗多少。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "确实…路上的不确定因素很多。",
                      "dialogues": []
                    },
                    {
                      "text": "让机关完全自主行动不保险。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "米卡",
                  "text": "是哦，一般还是由操作员们把机关带到合适的位置后，再将它们投入工作，工作过程也是人为可控的，以便随时应对意外。"
                },
                {
                  "role": "米卡",
                  "text": "要让机关完全脱离人运转，可能还需要好长好长的时间。"
                },
                {
                  "role": "米卡",
                  "text": "所以我的观点倾向于…目前在军事和冒险领域，机关依然是人的能力倍增器，而不是取代者。"
                },
                {
                  "role": "米卡",
                  "text": "我也想试着练习…一个人操作多台机关，同步测绘广大区域的新战法！"
                }
              ]
            },
            {
              "text": "这个先放一边，最近还忙吗？",
              "dialogues": [
                {
                  "role": "米卡",
                  "text": "啊…感谢关心！如你所见，我暂时闲下来了。"
                },
                {
                  "role": "米卡",
                  "text": "协助[[洛恩]]副队长的旧部适应新岗位后，我就来越野赛帮忙，下次远征队相关的人事协调工作，应该排到了两周后。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "…洛恩？",
                      "dialogues": []
                    },
                    {
                      "text": "…副队长？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "米卡",
                  "text": "嗯！洛恩前辈是第五小队的副队长，之前一直在远征队中，担任机动兵力的骨干成员。"
                },
                {
                  "role": "米卡",
                  "text": "最近随着任务变动，这支小队的部分成员正准备返回蒙德…"
                },
                {
                  "role": "米卡",
                  "text": "第五小队是一支比较特别的小队，最初组建时，以使用弓箭为主，随着技术进步，开始逐渐列装多种远程武器…"
                },
                {
                  "role": "米卡",
                  "text": "平时，他们会作为一支小队整体进行训练，执行任务时，则会按照预先分好的小单位，被分配给其他小队，加强火力。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "拆分开来作战？",
                      "dialogues": []
                    },
                    {
                      "text": "不集中使用火力吗？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "米卡",
                  "text": "大团长说，这样有助于提升火力运用的灵活性，让任何小队的骑士面对长手作战的敌人时，都不至于处于被动。"
                },
                {
                  "role": "米卡",
                  "text": "因此，第五小队的成员们处于一种…「随叫随到，哪里需要救火就去哪」的状态，战斗任务的强度相当高。"
                },
                {
                  "role": "米卡",
                  "text": "而洛恩前辈是第五小队中的佼佼者，他很喜欢在前线东奔西走，经常嫌魔物不够打，我很佩服他的战斗热情！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "好像是个狠人…他对你如何？",
                      "dialogues": []
                    },
                    {
                      "text": "这个…你和他相处得怎么样？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "米卡",
                  "text": "洛恩前辈对我非常非常好！每次我完成测绘，他都要第一时间和我一起校对结果，整理情报…"
                },
                {
                  "role": "米卡",
                  "text": "要是测绘内容存在疑点，洛恩前辈会主动前去「武力侦察」一番，帮我补充最精确的结果。"
                },
                {
                  "role": "米卡",
                  "text": "至于洛恩前辈的恶作剧…我觉得习惯以后，就能接受的。"
                },
                {
                  "role": "米卡",
                  "text": "受他影响，和他走得最近的同僚们，也倾向于使用非常凶猛的打击策略，有时不顾自己的安危…"
                },
                {
                  "role": "米卡",
                  "text": "所以，在考虑他们的人事协调时，除了岗位本身的适配程度，还要为他们找到足够稳重的搭档…"
                },
                {
                  "role": "米卡",
                  "text": "如此一来，就能让他们适当保持冷静，不至于在日常任务中，也打得过于激进了。"
                },
                {
                  "role": "米卡",
                  "text": "我想，等你见到洛恩前辈后，你就能明白他的作风了…"
                },
                {
                  "role": "米卡",
                  "text": "不知怎么，我有种感觉，你和洛恩前辈应该能顺利地熟悉彼此，配合得完美无缺！"
                }
              ]
            },
            {
              "text": "我先去琢磨琢磨。",
              "dialogues": [
                {
                  "role": "米卡",
                  "text": "那…我就静候佳音！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          10,
          12
        ]
      ]
    }
  ]
}