{
  "quest_id": 71052,
  "chapter_num": null,
  "chapter_title": "古代生物调查",
  "type": "wq",
  "route": "Paleontological Investigation in The Chasm",
  "stories": [
    {
      "story_id": 71052,
      "title": "古代生物调查",
      "description": "在层岩巨渊看到了纹路奇怪的岩石，不如先拍下来，不知道有没有人知道这是什么…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "第一次发现化石派蒙对话，待补",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与海迪夫对话"
        },
        {
          "role": "旅行者",
          "text": "关于奇怪的岩石…"
        },
        {
          "role": "海迪夫",
          "text": "拍到了奇怪的岩石的照片？"
        },
        {
          "role": "海迪夫",
          "text": "请务必给我看一眼！"
        },
        {
          "role": "旅行者",
          "text": "就是这个…"
        },
        {
          "role": "海迪夫",
          "text": "诶呀，这照片！真不愧是枫丹那边做出来的新机型，拍摄得相当清晰。"
        },
        {
          "role": "海迪夫",
          "text": "之前倒是买过一批试验机型，拍得很模糊，而且一台机子还要两个人抬，最后只能放在教令院积灰…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "积灰…",
              "dialogues": []
            },
            {
              "text": "有点浪费…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海迪夫",
          "text": "是啊，好歹也是我一顿饭的钱。嗯…看来是时候再买一批新的了。"
        },
        {
          "role": "海迪夫",
          "text": "说远了，我看看，这石头…"
        },
        {
          "role": "海迪夫",
          "text": "嗯，这是化石！"
        },
        {
          "role": "旅行者",
          "text": "化石？"
        },
        {
          "role": "海迪夫",
          "text": "是啊，而且有很多海洋生物…有趣。璃月有一句话叫做…「林园和田野，被茫茫的大海淹没」？说的就是这个。"
        },
        {
          "role": "海迪夫",
          "text": "层岩巨渊这边能够出现化石，就说明原本这些生物曾经被迅速埋藏在地下，骨骼才能保持如此完整的形状。"
        },
        {
          "role": "海迪夫",
          "text": "这么说来，听说这里也时常发生地震…这样就说得通了，活跃的地质活动是形成化石的必要条件之一。"
        },
        {
          "role": "海迪夫",
          "text": "这可对研究这一片区域的古生物类群很有帮助…"
        },
        {
          "role": "海迪夫",
          "text": "可是只有一张的话可不够。"
        },
        {
          "role": "海迪夫",
          "text": "这样你要是还有这样的化石，就拍下来给我吧。"
        },
        {
          "role": "旅行者",
          "text": "那要拍几张才行啊？"
        },
        {
          "role": "海迪夫",
          "text": "我想想，要放进报告里的话，类似的照片4、5张应该足够了…那就5张吧，给我5张类似岩石的照片。"
        },
        {
          "role": "海迪夫",
          "text": "我会给出合适的价钱买下的，这可是大发现啊。"
        },
        {
          "type": "subtitle",
          "text": "拍摄更多的化石照片"
        },
        {
          "type": "subtitle",
          "text": "将拍摄完成的化石照片交给海迪夫"
        },
        {
          "role": "旅行者",
          "text": "你要的化石照片…"
        },
        {
          "role": "海迪夫",
          "text": "不错不错，真是不可多得的好照片啊。"
        },
        {
          "role": "海迪夫",
          "text": "勘探队的那些开销，只要有这几张照片那就值回票价了。"
        },
        {
          "role": "海迪夫",
          "text": "你看，这些都是远古海生生物的骨骼，造型也非常清晰。"
        },
        {
          "role": "海迪夫",
          "text": "证明了层岩巨渊在形成以前，其实是海洋环境。"
        },
        {
          "role": "海迪夫",
          "text": "真可惜，如果是在须弥发现这样的化石，就能够直接搬回教令院进行研究了。"
        },
        {
          "role": "海迪夫",
          "text": "下次再和总务司接洽的时候，跟他们谈谈好了，我们这边出钱请人保护也行，得小心一些啊，不能让矿工把这些化石给敲坏了。"
        },
        {
          "role": "海迪夫",
          "text": "不过…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不过？",
              "dialogues": []
            },
            {
              "text": "难道是照片不够？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海迪夫",
          "text": "这些照片…勉强算是足够了。"
        },
        {
          "role": "海迪夫",
          "text": "之前说了吧，这么品相完好，结构完整的化石，它形成也是有条件的。"
        },
        {
          "role": "海迪夫",
          "text": "那就是被迅速埋藏入土中。"
        },
        {
          "role": "海迪夫",
          "text": "层岩巨渊的化石，基本上只出现在某个固定的高度区域。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "固定高度？",
              "dialogues": []
            },
            {
              "text": "上下高度差挺大的吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海迪夫",
          "text": "哎呀，从地质学的角度上来说，这个等级的差异可以忽略不计。"
        },
        {
          "role": "海迪夫",
          "text": "总之，这就说明形成化石的时期很短，而且都相当接近…说明在很短暂的时间段里发生了特别大的生态变化。"
        },
        {
          "role": "海迪夫",
          "text": "譬如说，巨大的冲击导致的…之类。"
        },
        {
          "role": "海迪夫",
          "text": "嗯，层岩巨渊，到底发生过什么呢？"
        }
      ]
    }
  ]
}