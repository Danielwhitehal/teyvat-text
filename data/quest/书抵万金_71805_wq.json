{
  "quest_id": 71805,
  "chapter_num": null,
  "chapter_title": "书抵万金",
  "type": "wq",
  "route": "Words Worth Their Weight in Mora",
  "stories": [
    {
      "story_id": 71805,
      "title": "书抵万金",
      "description": "在璃月港的那场风波过去后，璃月人对历史的兴趣突然浓厚了起来。「万文集舍」的生意十分红火，纪芳都有些应付不过来了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "帮纪芳送书"
        },
        {
          "role": "德安公",
          "text": "年轻人，你有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "这是纪芳给你的书。"
        },
        {
          "role": "德安公",
          "text": "这是《帝君尘游记·四》？我记得我早就订了这本书，怎么拖了这么久？"
        },
        {
          "role": "德安公",
          "text": "让我看看…咦？居然是初版，难怪现在才送来…"
        },
        {
          "role": "德安公",
          "text": "我还以为是因为客人太多，纪芳把这本书的事给忘了呢。"
        },
        {
          "role": "德安公",
          "text": "这本书我就收下了，谢谢你，年轻人。"
        },
        {
          "type": "subtitle",
          "text": "帮纪芳送书"
        },
        {
          "role": "天叔",
          "text": "年轻人，你有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "这是纪芳给你的书。"
        },
        {
          "role": "天叔",
          "text": "我想起来了，之前我跟「万文集舍」订了一本《玑衡经》。"
        },
        {
          "role": "天叔",
          "text": "没错没错，这就是我要的书，总算送来了。呵呵，我还以为客人太多，纪芳把这本书的事给忘了呢。"
        },
        {
          "role": "天叔",
          "text": "送来就好，送来就好…哦唷，这装帧还不错，纪芳有心了。"
        },
        {
          "role": "天叔",
          "text": "谢谢你年轻人，这本书我就收下了。"
        },
        {
          "type": "subtitle",
          "text": "向纪芳回报"
        },
        {
          "role": "旅行者",
          "text": "关于那两本书…"
        },
        {
          "role": "纪芳",
          "text": "书都送到了吗？"
        },
        {
          "role": "旅行者",
          "text": "都送到了。"
        },
        {
          "role": "纪芳",
          "text": "谢谢你。「万文集舍」能开到现在，都是多亏了这些老客人的支持。"
        },
        {
          "role": "纪芳",
          "text": "而且，这些老客人也都是真正爱书的人。能拿到好书，他们应该也会很开心的。"
        },
        {
          "role": "纪芳",
          "text": "旅行者，谢谢你帮我这个忙，这些报酬请你收下吧。"
        },
        {
          "role": "纪芳",
          "text": "如果你以后想买书的话，尽管来找我。"
        },
        {
          "role": "纪芳",
          "text": "关于那两本书…"
        },
        {
          "role": "纪芳",
          "text": "这两位是老客人了，他们订的书我一般都会早点准备。"
        },
        {
          "role": "纪芳",
          "text": "但突然来了那么多客人，我一下子应付不过来，把这两本书拖了这么久。"
        },
        {
          "role": "纪芳",
          "text": "他们一定都等得不耐烦了…"
        }
      ]
    }
  ]
}