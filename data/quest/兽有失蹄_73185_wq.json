{
  "quest_id": 73185,
  "chapter_num": null,
  "chapter_title": "兽有失蹄",
  "type": "wq",
  "route": "Even Beasts Stumble",
  "stories": [
    {
      "story_id": 73185,
      "title": "兽有失蹄",
      "description": "在须弥的郊外，你注意到似乎有人遇见了危险…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "关于这些货物…"
        },
        {
          "type": "subtitle",
          "text": "解救被魔物围攻的人"
        },
        {
          "type": "subtitle",
          "text": "与阿尔伯对话"
        },
        {
          "role": "阿尔伯",
          "text": "唉…真是不能在驮兽吃饭的时候打扰它们啊。"
        },
        {
          "role": "阿尔伯",
          "text": "呼…呼…谢谢你旅行者…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没事就好。",
              "dialogues": []
            },
            {
              "text": "小事而已。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔伯",
          "text": "我叫阿尔伯，是个商人，本来只是在这里休息一下…"
        },
        {
          "role": "阿尔伯",
          "text": "但没想到，却被那些丘丘人突然袭击了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你没有护卫吗？",
              "dialogues": []
            },
            {
              "text": "没有人保护你？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对呀，我们在城里听说，外出运货的商人们一般都会雇佣「镀金旅团」的人来帮忙呢。"
        },
        {
          "role": "阿尔伯",
          "text": "哎呀，我…我不是舍不得那些钱吗？"
        },
        {
          "role": "阿尔伯",
          "text": "那些「镀金旅团」的人出价时个个都是狮子大开口，要的数目一个比一个夸张。"
        },
        {
          "role": "阿尔伯",
          "text": "我本来做的就是小本生意，可付不起那么多钱…"
        },
        {
          "role": "阿尔伯",
          "text": "我就想，反正我也会一点武艺，运货的路程也不远，干脆直接出发算了。"
        },
        {
          "role": "阿尔伯",
          "text": "但没想到，那些丘丘人袭击的时候，把我的两只驮兽惊到了。"
        },
        {
          "role": "阿尔伯",
          "text": "我还没反应过来，就先被一只驮兽撞到了地上，站起来之后，又挨了另外一只驮兽一蹄。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…"
        },
        {
          "role": "阿尔伯",
          "text": "然后，两只驮兽夺路而跑，我则被那群丘丘人围攻…还好有你们帮忙。"
        },
        {
          "role": "阿尔伯",
          "text": "但我的全部身家都在那两头驮兽的身上…旅行者，能不能请你去帮我把它们带回来？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我，我不想被踢…",
              "dialogues": []
            },
            {
              "text": "我，我担心被撞…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔伯",
          "text": "没事，没事，不用担心。它们的性情本来很温和的，只是那些丘丘人把它们的食物给打翻了。"
        },
        {
          "role": "阿尔伯",
          "text": "它们驮着货物走了这么远，已经非常饿了，被打翻食物之后就变得格外暴躁…"
        },
        {
          "role": "派蒙",
          "text": "原来如此…在吃饭的时候被打扰，吃的东西还都被打翻了…"
        },
        {
          "role": "派蒙",
          "text": "唔唔唔，光是想想都很生气了！"
        },
        {
          "role": "旅行者",
          "text": "派蒙理解得可真快啊…"
        },
        {
          "role": "阿尔伯",
          "text": "这样好了…来，这些食物给你。"
        },
        {
          "role": "阿尔伯",
          "text": "你找到驮兽之后，就把这些食物喂给它们吧。"
        },
        {
          "role": "阿尔伯",
          "text": "只要有吃的，它们就不会乱发脾气了。"
        },
        {
          "role": "阿尔伯",
          "text": "我之前留意到，有一只驮兽撞开了那些丘丘人，自顾自地跑远…"
        },
        {
          "role": "阿尔伯",
          "text": "另外一只好像被那些丘丘人抓住带走了。"
        },
        {
          "role": "阿尔伯",
          "text": "我把那两只驮兽离开的方向大致给你标记一下…这件事就交给你了，旅行者。"
        },
        {
          "role": "阿尔伯",
          "text": "只要能把货物找回来，我一定会付给你一笔丰厚报酬的！"
        },
        {
          "type": "subtitle",
          "text": "寻找走失的驮兽"
        },
        {
          "type": "subtitle",
          "text": "打倒所有丘丘人"
        },
        {
          "type": "subtitle",
          "text": "安抚驮兽"
        },
        {
          "role": "派蒙",
          "text": "这只驮兽…好像心情不太好…"
        },
        {
          "role": "派蒙",
          "text": "呜哇，你看它的蹄子，感觉好结实的样子…"
        },
        {
          "role": "派蒙",
          "text": "要是被踢上一下，一般人应该会直接昏过去吧…"
        },
        {
          "role": "旅行者",
          "text": "派蒙把这些食物送过去吧…"
        },
        {
          "role": "派蒙",
          "text": "你，你去啦！快点快点！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请您慢用…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "它看起来好像没那么生气了。"
                },
                {
                  "role": "派蒙",
                  "text": "我们快把它带回去吧，小心啊！可别被踢到了…"
                },
                {
                  "role": "？？？",
                  "text": "驮兽缓缓地吞下了食物，蹄子似乎安分了一些…"
                },
                {
                  "role": "？？？",
                  "text": "和驮兽一同回到了阿尔伯身边…"
                },
                {
                  "role": "阿尔伯",
                  "text": "太好了…我还以为这只驮兽真跑丢了…"
                },
                {
                  "role": "阿尔伯",
                  "text": "谢谢你旅行者，真是太谢谢你了。"
                },
                {
                  "role": "阿尔伯",
                  "text": "我得赶紧检查一下这只驮兽的状况，希望它没有受什么伤…"
                },
                {
                  "role": "阿尔伯",
                  "text": "请你再帮我找找另外一只驮兽吧，旅行者。"
                }
              ]
            },
            {
              "text": "我无意冒犯您的蹄子…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔伯",
          "text": "太好了，这下两只驮兽都找回来了！太感谢你了，旅行者。"
        },
        {
          "role": "阿尔伯",
          "text": "等我把这些剩下的货物归整好之后，就回城里去。"
        },
        {
          "role": "阿尔伯",
          "text": "唉，下次运货的时候，我必须得请几个护卫了…"
        },
        {
          "role": "旅行者",
          "text": "关于捡到的货物…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！这只驮兽好大，被它撞一下肯定不好受…"
        },
        {
          "role": "派蒙",
          "text": "快把阿尔伯先生给我们的食物拿出来给它吧。"
        },
        {
          "role": "旅行者",
          "text": "请慢用…"
        },
        {
          "role": "旅行者",
          "text": "这些真的能吃饱吗…"
        },
        {
          "role": "派蒙",
          "text": "看起来，它好像心情不错呢。"
        },
        {
          "role": "派蒙",
          "text": "快，我们把它带回去吧。"
        },
        {
          "role": "？？？",
          "text": "和驮兽一同回到了阿尔伯身边…"
        },
        {
          "role": "？？？",
          "text": "驮兽飞快地吞下了食物，似乎心情变好了一些…"
        },
        {
          "role": "阿尔伯",
          "text": "太好了…我还以为这只驮兽真跑丢了…"
        },
        {
          "role": "阿尔伯",
          "text": "谢谢你旅行者，真是太谢谢你了。"
        },
        {
          "role": "阿尔伯",
          "text": "我得赶紧检查一下这只驮兽的状况，希望它没有受什么伤…"
        },
        {
          "role": "阿尔伯",
          "text": "请你再帮我找找另外一只驮兽吧，旅行者。"
        },
        {
          "role": "阿尔伯",
          "text": "太好了，这下两只驮兽都找回来了！太感谢你了，旅行者。"
        },
        {
          "role": "阿尔伯",
          "text": "等我把这些货物归整好之后，就回城里去。"
        },
        {
          "role": "阿尔伯",
          "text": "唉，下次运货的时候，我必须得请几个护卫了…"
        },
        {
          "role": "旅行者",
          "text": "关于捡到的货物…"
        },
        {
          "type": "subtitle",
          "text": "寻找走失的驮兽"
        },
        {
          "role": "阿尔伯",
          "text": "这下两只驮兽就都回来了…真是太感谢你了，旅行者。"
        },
        {
          "role": "旅行者",
          "text": "关于这些货物…"
        },
        {
          "type": "subtitle",
          "text": "安抚驮兽"
        },
        {
          "role": "阿尔伯",
          "text": "太好了！真是太感谢你了旅行者！"
        },
        {
          "role": "阿尔伯",
          "text": "这两只驮兽和货物要是全丢了，我今天非得破产不可。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用客气。",
              "dialogues": []
            },
            {
              "text": "关于报酬…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔伯",
          "text": "喔！对了，还得给你报酬，稍等一下…"
        },
        {
          "role": "阿尔伯",
          "text": "这些东西请你收下吧。看你的样子，肯定常年都在野外冒险。"
        },
        {
          "role": "阿尔伯",
          "text": "我做的正好就是和冒险用具相关的生意，这些东西你肯定都用得上。"
        },
        {
          "role": "阿尔伯",
          "text": "呼…驮兽找回来了，货物也基本上完好，我得赶紧离开这里了。"
        },
        {
          "role": "阿尔伯",
          "text": "再次谢谢你，旅行者。"
        },
        {
          "role": "阿尔伯",
          "text": "除了这只之外，还有一只驮兽不知道跑到哪里去了。"
        },
        {
          "role": "阿尔伯",
          "text": "这只驮兽的状态看起来还不错，真是万幸…"
        },
        {
          "role": "阿尔伯",
          "text": "旅行者，请你再帮我去找找那一只吧。"
        },
        {
          "type": "subtitle",
          "text": "将货物带给阿尔伯"
        },
        {
          "type": "subtitle",
          "text": "与阿尔伯对话"
        }
      ]
    }
  ]
}