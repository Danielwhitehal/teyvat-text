{
  "quest_id": 23031,
  "chapter_num": null,
  "chapter_title": "鱼钩上的绝景？",
  "type": "iq",
  "route": "Supreme Hookshot?",
  "stories": [
    {
      "story_id": 23031,
      "title": "鱼钩上的绝景？",
      "description": "渔师凯万似乎正在为某个目标不懈努力…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与凯万对话"
        },
        {
          "role": "凯万",
          "text": "哟，看你的样子…是旅行者吧？居然会来这种地方闲逛，很有闲情雅致啊。"
        },
        {
          "role": "凯万",
          "text": "还是说，你也是钓鱼客，相中了这片水域？"
        },
        {
          "role": "凯万",
          "text": "眼光不错！这里是附近最好的钓鱼点了。"
        },
        {
          "role": "派蒙",
          "text": "可这附近好像没有其他人在钓鱼啊？你怎么这么肯定？"
        },
        {
          "role": "凯万",
          "text": "那当然是因为我眼光独到了。"
        },
        {
          "role": "凯万",
          "text": "身为这一带最厉害的渔师，选择钓鱼点的方法当然也有讲究。"
        },
        {
          "role": "旅行者",
          "text": "真…真的吗？"
        },
        {
          "role": "派蒙",
          "text": "你好像没什么收获欸？"
        },
        {
          "role": "凯万",
          "text": "话都说到这份上了，就让你们见识一下「鱼钩上的绝景」吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "鱼钩上的…",
              "dialogues": []
            },
            {
              "text": "绝景？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯万",
          "text": "你给我特别的材料，我手制鱼饵，钓出你从没见过的「鱼」。"
        },
        {
          "role": "派蒙",
          "text": "怎么感觉有点可疑？手制鱼饵真的靠谱吗？"
        },
        {
          "role": "旅行者",
          "text": "试试也无妨。"
        },
        {
          "role": "凯万",
          "text": "爽快，我就喜欢和这样的人打交道！"
        },
        {
          "role": "凯万",
          "text": "我的手制鱼饵除了作为基底的日落果和小麦以外，还有一种赋予其灵性的材料。"
        },
        {
          "role": "旅行者",
          "text": "那你需要什么材料？"
        },
        {
          "role": "凯万",
          "text": "根据今天的直觉…就用墩墩桃好了。"
        },
        {
          "role": "凯万",
          "text": "虽然平时很常见，但很少有人把它当成鱼饵的材料。"
        },
        {
          "role": "凯万",
          "text": "麻烦你们帮我找找这种材料了。"
        },
        {
          "role": "旅行者",
          "text": "那你需要什么材料？"
        },
        {
          "role": "凯万",
          "text": "根据今天的直觉…就用刚从鸟巢中取出来没多久的鸟蛋好了。"
        },
        {
          "role": "凯万",
          "text": "我常用的鸟蛋就在附近的树上，我给你们说明一下方位。"
        },
        {
          "role": "旅行者",
          "text": "那你需要什么材料？"
        },
        {
          "role": "凯万",
          "text": "根据今天的直觉…就用我常采摘的一种蘑菇好了。"
        },
        {
          "role": "凯万",
          "text": "我经常使用的蘑菇生长在一片特别的地区，我给你们说明一下方位。"
        },
        {
          "role": "凯万",
          "text": "麻烦你们帮我找找这种材料了。"
        },
        {
          "type": "subtitle",
          "text": "将鱼饵的材料交给凯万"
        },
        {
          "type": "subtitle",
          "text": "与凯万对话"
        },
        {
          "role": "凯万",
          "text": "好极了，材料齐全了，看我制作独一无二的鱼饵。"
        },
        {
          "role": "？？？",
          "text": "凯万熟练地制作了鱼饵"
        },
        {
          "role": "凯万",
          "text": "好，开始钓鱼了。"
        },
        {
          "role": "凯万",
          "text": "鱼钩入水深度合格…水流速度适中…"
        },
        {
          "role": "凯万",
          "text": "你们要保持安静，水里的鱼可是很敏感的。"
        },
        {
          "role": "凯万",
          "text": "岸边的脚步声也有可能惊动到它们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我站着不动。",
              "dialogues": []
            },
            {
              "text": "派蒙脚不着地。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯万",
          "text": "那你们就沉住气，安心等待吧…"
        },
        {
          "role": "？？？",
          "text": "凯万钓到了一袋湿漉漉的东西"
        },
        {
          "role": "派蒙",
          "text": "这是什么嘛，根本不是鱼！"
        },
        {
          "role": "旅行者",
          "text": "确实没见过这种「鱼」。"
        },
        {
          "role": "凯万",
          "text": "果然还是这样啊，完全不意外。"
        },
        {
          "role": "凯万",
          "text": "咳咳，异乡人，心态放宽点，别太计较细节问题。"
        },
        {
          "role": "凯万",
          "text": "鱼钩带出水面的东西，都可以被看成是钓上来的「鱼」。"
        },
        {
          "role": "凯万",
          "text": "不瞒你说，我这最厉害的渔师可不是自封的。"
        },
        {
          "role": "凯万",
          "text": "毕竟每次都钓上这种不会咬钩的，不算活物的东西，也算是一种本事吧…"
        },
        {
          "role": "凯万",
          "text": "其他渔师也都赞叹过我，说我有着独一无二的才能。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他们可能是在安慰你…",
              "dialogues": []
            },
            {
              "text": "他们可能是在揶揄你…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "简单来说，就是除了鱼之外什么都钓的上来吧…"
        },
        {
          "role": "凯万",
          "text": "咳！不管他们怎么想都没关系！至，至少我钓鱼永不走空车！"
        },
        {
          "role": "凯万",
          "text": "今天不成就明天再来，总有一天，我肯定能钓上来鱼！"
        },
        {
          "role": "凯万",
          "text": "谢谢你们帮我去找材料，这些报酬给你，我要换个地方继续钓鱼了。"
        },
        {
          "role": "凯万",
          "text": "下次…下次我一定能钓到一条大鱼！一定！"
        },
        {
          "type": "subtitle",
          "text": "寻找凯万需要的材料"
        },
        {
          "type": "subtitle",
          "text": "将鱼饵的材料交给凯万"
        },
        {
          "role": "凯万",
          "text": "这次的鱼饵需要日落果，小麦和墩墩桃，你准备好了吗？"
        },
        {
          "type": "subtitle",
          "text": "与凯万对话"
        },
        {
          "type": "subtitle",
          "text": "寻找鱼饵材料"
        },
        {
          "role": "凯万",
          "text": "这次的鱼饵需要日落果，小麦和特别的鸟蛋，你准备好了吗？"
        },
        {
          "type": "subtitle",
          "text": "将鱼饵的材料交给凯万"
        },
        {
          "type": "subtitle",
          "text": "与凯万对话"
        },
        {
          "role": "凯万",
          "text": "这次的鱼饵需要日落果，小麦和特别的蘑菇，你准备好了吗？"
        }
      ]
    }
  ]
}