  "stories": [
    {
      "story_id": 70061,
      "title": "山有林猪粗嗅花",
      "description": "…在风车镇混乱的花田周围，看到了对着花田唉声叹气的女性，打听得知，原来是有一只林猪破坏了花田…",
      "dialogues": [
        {
          "role": "莉奥波汀",
          "text": "唉，又是这样，怎么花田又变成这个样子…真是的…"
        },
        {
          "role": "莉奥波汀",
          "text": "这样，花又不能按期交付，该怎么和收花的人说呢。"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "莉奥波汀",
          "text": "花田被毁了…唉你看看，本来多好的花呀，被祸害成了这样。"
        },
        {
          "role": "莉奥波汀",
          "text": "都是那个家伙干的！"
        },
        {
          "role": "旅行者",
          "text": "过分，真不是人！"
        },
        {
          "role": "莉奥波汀",
          "text": "是啊！真不是人…虽然这么说，但做出这种事的确实不是人，而是一只林猪。"
        },
        {
          "role": "莉奥波汀",
          "text": "不知道为什么，最近总是跑下来啃花，还在花田里滚来滚去。"
        },
        {
          "role": "莉奥波汀",
          "text": "又特别狡猾，每次弄出动静，一旦有人围过来，就会立刻逃跑，刚刚还差点把路过老人的腰撞坏…"
        },
        {
          "role": "莉奥波汀",
          "text": "过分，真不是…真不是好林猪！"
        },
        {
          "role": "莉奥波汀",
          "text": "唔，仔细一看…哦，你不是荣誉骑士吗，拯救蒙德的大英雄，就，就请帮帮我吧。"
        },
        {
          "role": "旅行者",
          "text": "好，我来赶跑它！"
        },
        {
          "role": "莉奥波汀",
          "text": "你愿意出手帮忙就太好了…我记得，它好像跑到山谷里去了。"
        },
        {
          "role": "莉奥波汀",
          "text": "但这家伙特别狡猾，说不定得用花才能把它引诱出来…可惜花田现在变成这样…"
        },
        {
          "role": "莉奥波汀",
          "text": "也许你能在路上采几朵风息花，把它骗出来，让它也知道被人捉弄的味道！"
        },
        {
          "type": "subtitle",
          "text": "采集风息花"
        },
        {
          "type": "subtitle",
          "text": "寻找林猪的踪迹"
        },
        {
          "type": "subtitle",
          "text": "寻找林猪的踪迹"
        },
        {
          "type": "subtitle",
          "text": "寻找林猪的踪迹"
        },
        {
          "type": "subtitle",
          "text": "检查洞穴"
        },
        {
          "type": "subtitle",
          "text": "等待林猪出现（等待至第二天八点）"
        },
        {
          "type": "subtitle",
          "text": "赶跑破坏花田的林猪"
        },
        {
          "type": "subtitle",
          "text": "告知莉奥波汀林猪被赶跑的消息"
        },
        {
          "role": "莉奥波汀",
          "text": "哦…你们回来了？怎么样？"
        },
        {
          "role": "旅行者",
          "text": "已经赶跑啦！"
        },
        {
          "role": "莉奥波汀",
          "text": "啊，真是太感谢你了，来，这是给你的酬劳。"
        },
        {
          "role": "莉奥波汀",
          "text": "付出了劳动，就应该拿到报酬。"
        },
        {
          "role": "莉奥波汀",
          "text": "这下也能重新修整花田了，希望这次不会再有什么不是人的家伙来捣乱…"
        }
      ]
    }
  ]
}