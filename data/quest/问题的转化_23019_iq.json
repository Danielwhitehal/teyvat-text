{
  "quest_id": 23019,
  "chapter_num": null,
  "chapter_title": "问题的转化",
  "type": "iq",
  "route": "Problem Conversion",
  "stories": [
    {
      "story_id": 23019,
      "title": "问题的转化",
      "description": "拉菲克正因为船只设计问题而苦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与拉菲克对话"
        },
        {
          "role": "拉菲克",
          "text": "果然，这样做会更花钱啊…"
        },
        {
          "role": "旅行者",
          "text": "你在说什么呢？"
        },
        {
          "role": "拉菲克",
          "text": "啊，你好，我正在研究一艘船只的设计问题呢，现在…遇到了一些瓶颈。"
        },
        {
          "role": "拉菲克",
          "text": "简单来说，就是我想在不提高造价的情况下，让船能装更多的东西。"
        },
        {
          "role": "拉菲克",
          "text": "一旦重量大了，结构会变得更容易破损，重量不均匀的情况下平衡也会出现问题…"
        },
        {
          "role": "拉菲克",
          "text": "解决这些问题的最好方法，就是用更好的材料，但这样…问题就又回到了造价问题上…"
        },
        {
          "role": "拉菲克",
          "text": "唉，其实说白了就是我没钱，但又想要造出一艘好船。"
        },
        {
          "role": "拉菲克",
          "text": "所以某些用钱就能砸通的问题，我只能想办法用一些技术性的手段绕过去。"
        },
        {
          "role": "旅行者",
          "text": "真的能这么做吗…"
        },
        {
          "role": "拉菲克",
          "text": "哈哈哈，说出来你可能不信，但其实有很多人都这么做。"
        },
        {
          "role": "拉菲克",
          "text": "毕竟我们造的船也都是不会遇见什么风浪的近海渔船。"
        },
        {
          "role": "拉菲克",
          "text": "大家都秉承着能省则省，修修补补的原则造船…凑合凑合，能用就行。"
        },
        {
          "role": "拉菲克",
          "text": "拜这原则所赐，我们修船的生意每天都好得不行。"
        },
        {
          "role": "拉菲克",
          "text": "旅行者，如果你愿意的话，就帮我去那边检查一下那艘刚回港的船吧，它貌似因为经常运载重物出了点问题。"
        },
        {
          "role": "拉菲克",
          "text": "我刚好就在研究这方面的问题，说不定能从它身上找到点灵感。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "拉菲克",
                  "text": "那就拜托你了！我得赶紧去修另外一艘船去了…"
                }
              ]
            },
            {
              "text": "你自己怎么不去？",
              "dialogues": [
                {
                  "role": "拉菲克",
                  "text": "我也想自己去，但我还被人拜托去维修另外一艘急着要再出海收网的船…"
                },
                {
                  "role": "拉菲克",
                  "text": "所以就只能拜托你了，旅行者！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往船只上调查"
        },
        {
          "role": "拉菲克",
          "text": "怎么每天都有这么多事要处理，唉…"
        },
        {
          "type": "subtitle",
          "text": "检查船体"
        },
        {
          "type": "subtitle",
          "text": "回去向拉菲克说明情况"
        },
        {
          "role": "拉菲克",
          "text": "怎么样，你检查完那艘船了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经检查完了…"
        },
        {
          "role": "？？？",
          "text": "在描述了船只情况之后…"
        },
        {
          "role": "拉菲克",
          "text": "原来如此，那些为了省钱而用了取巧功夫的结构果然出问题了啊…"
        },
        {
          "role": "拉菲克",
          "text": "但维修这种结构要花不少钱，那个船主人，我记得手头一直很拮据…"
        },
        {
          "role": "拉菲克",
          "text": "唉，我还是去和他谈谈吧，和钱相比，肯定是命更重要啊…"
        }
      ]
    }
  ]
}