{
  "quest_id": 10236,
  "chapter_num": "礁与浪的相逢·其二",
  "chapter_title": "枪弹与丝线的合围",
  "type": "eq",
  "route": "Encirclement of Bullets and Silk",
  "stories": [
    {
      "story_id": 40237,
      "title": "枪弹与丝线的合围",
      "description": "幕后的罪犯终于上钩，而来自璃月总务司的夜兰和来自枫丹执律庭的夏沃蕾则罕见地展开了合作。不过，对于她们来说，需要考虑的问题不仅仅是抓捕罪犯…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到两天后早上7点到10点"
        },
        {
          "role": "派蒙",
          "text": "说起来，已经过去两天了，不知道夜兰她们调查得怎么样了。"
        },
        {
          "role": "派蒙",
          "text": "我们去找她们了解一下情况吧。"
        },
        {
          "type": "subtitle",
          "text": "前往会场向夜兰等人了解情况"
        },
        {
          "role": "阿诺",
          "text": "哇，这种「贵重机」真的可以打那么远吗？"
        },
        {
          "role": "北斗",
          "text": "嗯，它确实又贵又重，不过它的名字叫「归终机」啦。"
        },
        {
          "role": "阿诺",
          "text": "隔那么远，真能打得准吗？"
        },
        {
          "role": "北斗",
          "text": "有远程引导就行，偷偷告诉你们，升级后的版本甚至可以不需要远程引导。"
        },
        {
          "role": "阿诺",
          "text": "我也可以试试吗？"
        },
        {
          "role": "北斗",
          "text": "哈哈哈，这可不行，这东西的威力不容小觑，说不好还会弄伤自己，等你们长大之后再尝试吧。"
        },
        {
          "role": "派蒙",
          "text": "你好啊，北斗！这是在？"
        },
        {
          "role": "北斗",
          "text": "是旅行者和派蒙啊，我在给这三位小客户介绍展品呢。"
        },
        {
          "role": "派蒙",
          "text": "呃…你不是来这里「钓鱼」的吗？难道这三个孩子…"
        },
        {
          "role": "北斗",
          "text": "怎么会？这只是三个好奇的孩子而已。"
        },
        {
          "role": "阿梵波谛",
          "text": "抱歉，阿提他们影响到你做生意了吧？我这就带他们离开。"
        },
        {
          "role": "阿诺",
          "text": "这就要走了吗？"
        },
        {
          "role": "北斗",
          "text": "没关系的，孩子们感兴趣，我可以多讲讲。"
        },
        {
          "role": "阿梵波谛",
          "text": "不不，刚刚已经打扰很久了。阿诺，不要给别人添麻烦。"
        },
        {
          "role": "阿诺",
          "text": "好吧…"
        },
        {
          "role": "北斗",
          "text": "嗯…没关系的。真感兴趣的话，等展会结束了可以去船上找我，带你们去看演示射击。"
        },
        {
          "role": "阿提",
          "text": "需要花钱吗？"
        },
        {
          "role": "北斗",
          "text": "免费参观！"
        },
        {
          "role": "阿诺",
          "text": "真的，一言为定！"
        },
        {
          "role": "阿梵波谛",
          "text": "阁下的船是一艘战舰吧？让小孩子上去参观真的合适吗？"
        },
        {
          "role": "北斗",
          "text": "怎么不合适？舰队旗舰回璃月港补给的时候，我也会让那里的孩子到船上玩，他们都很开心。"
        },
        {
          "role": "北斗",
          "text": "须弥沙漠来的孩子，不也一样是孩子？就让他们把战舰当成一个好玩的地方就行了。"
        },
        {
          "role": "阿梵波谛",
          "text": "把战舰当成一个好玩的地方…我听说璃月人会将威力强大的火药制作成烟花爆竹，分发给孩子们作为玩具。"
        },
        {
          "role": "阿梵波谛",
          "text": "也只有生活在那里的孩子，才会把战舰当成一个好玩的地方吧。"
        },
        {
          "role": "北斗",
          "text": "如果你实在担心…"
        },
        {
          "role": "阿梵波谛",
          "text": "不，我只是有些羡慕你们。如果有机会的话，我会安排孩子们赴约的。"
        },
        {
          "role": "北斗",
          "text": "看得出来，他确实是个关心孩子的家长…还是先谈正事吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯，我们来是想问一下调查的情况…呃，「大鱼」有没有上钩？"
        },
        {
          "role": "夜兰",
          "text": "「大鱼」早就游过来了，只是还没有咬钩。"
        },
        {
          "role": "派蒙",
          "text": "哇，你又突然出现…"
        },
        {
          "role": "夜兰",
          "text": "嘘——"
        },
        {
          "role": "探子",
          "text": "所以说，这东西还是在枫丹更好用。"
        },
        {
          "role": "娜维娅",
          "text": "但在枫丹反而就买不到了，所以机会难得哦！"
        },
        {
          "role": "探子",
          "text": "…打扰了。"
        },
        {
          "role": "派蒙",
          "text": "啊，他朝这边过来了…"
        },
        {
          "role": "夜兰",
          "text": "冷静些。"
        },
        {
          "role": "探子",
          "text": "哼，这个价格…"
        },
        {
          "role": "北斗",
          "text": "不买也行，那你去看别家。"
        },
        {
          "role": "探子",
          "text": "我没听说过这个展会不准砍价啊。"
        },
        {
          "role": "北斗",
          "text": "砍价？我还得给伏尼契商会抽成，这部分当然也要算到总价里。你觉得贵，就找伏尼契商会谈。"
        },
        {
          "role": "探子",
          "text": "我看得出来，阁下准备的确实是好东西，如果价格能再低一些，我愿意和阁下谈一笔大买卖。"
        },
        {
          "role": "北斗",
          "text": "我当然知道手里的是好东西，所以不打算贱卖。"
        },
        {
          "role": "探子",
          "text": "啧…或许也有两边都不亏的办法？"
        },
        {
          "role": "北斗",
          "text": "你到底想说什么？"
        },
        {
          "role": "探子",
          "text": "挪德卡莱这么大，也不一定非得在这个展会上做生意吧？"
        },
        {
          "role": "北斗",
          "text": "哦？"
        },
        {
          "role": "探子",
          "text": "不如找一个没有抽成的地方，谈一笔大生意，如何？"
        },
        {
          "role": "北斗",
          "text": "哼，离开展会的保护？要是你们只提货，不交钱，我该找谁说理？"
        },
        {
          "role": "探子",
          "text": "考虑到阁下手上的家伙，我这一边才更可能是被抢的一方吧？两边都有风险，但回报绝对足够丰厚。"
        },
        {
          "role": "北斗",
          "text": "…留个地址吧，不过我得另外安排人去找你谈。我是已经登记过的参展人员，可不想被商会的眼线看到。"
        },
        {
          "role": "探子",
          "text": "阁下想的果然周到，那就在这里见面吧。"
        },
        {
          "role": "夜兰",
          "text": "还算顺利，我们到一个保险的地方谈谈接下来的行动吧。"
        },
        {
          "type": "subtitle",
          "text": "与众人商议接下来的行动"
        },
        {
          "role": "娜维娅",
          "text": "最后咬的是北斗船长的钩…我的说服能力根本没展现出来。"
        },
        {
          "role": "克洛琳德",
          "text": "现实不是桌上剧团，想「说服」成功可不仅仅是扔个骰子那么简单。"
        },
        {
          "role": "夏沃蕾",
          "text": "我原本以为这个团伙只在枫丹境内活跃，因此才准备了那种非常适配枫丹环境的武器作为诱饵。"
        },
        {
          "role": "夏沃蕾",
          "text": "没想到对方是个跨国团伙，这样一来，自然是璃月方面准备的诱饵更有吸引力，这次办案真是多亏了邻国同仁的帮助。"
        },
        {
          "role": "北斗",
          "text": "也多亏了你们提供的情报，话说你怎么知道他们有绕开展会私下交易的倾向？"
        },
        {
          "role": "夏沃蕾",
          "text": "我查阅过这个团伙的卷宗，他们为了牟利已经到了不择手段的地步。"
        },
        {
          "role": "夏沃蕾",
          "text": "所谓展会的庇护，对他们来说，恐怕也只是一种生意上的阻碍，一如他们违反的那些律法。"
        },
        {
          "role": "派蒙",
          "text": "那现在只要在展会外抓住这个家伙就行了吧？"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯…"
        },
        {
          "role": "夜兰",
          "text": "刚刚那个明显只是被派过来打探消息的探子，而我们的目标是幕后的团伙头目。"
        },
        {
          "role": "夜兰",
          "text": "这两天等待探子上钩的时候，我一直在观察。除了这个明面上的探子，对方还在这边安插了不少暗哨。"
        },
        {
          "role": "夜兰",
          "text": "不难想象，只要探子一出事，这些暗哨就会立刻四散逃离，迅速通知藏在幕后的团伙头目。"
        },
        {
          "role": "派蒙",
          "text": "这样的话…"
        },
        {
          "role": "夏沃蕾",
          "text": "看来，只能对这些人同时动手了。在惊动团伙头目之前，从这些人嘴里挖出他的情报。"
        },
        {
          "role": "夜兰",
          "text": "恕我直言，以我们目前的人手几乎无法办到这一点。对方的暗哨很多，只要跑掉一个，所有的计划就都泡汤了。"
        },
        {
          "role": "夏沃蕾",
          "text": "我大概能猜到你的想法，你是想让交易推进下去，借此引出藏在幕后的人。"
        },
        {
          "role": "夏沃蕾",
          "text": "但凭我的经验，整个交易过程中，那些幕后的人都不会现身。"
        },
        {
          "role": "夜兰",
          "text": "只要交易能推进下去，这一点不会是问题。"
        },
        {
          "role": "夏沃蕾",
          "text": "是想追踪来提货的人？要让对方放松警惕，带你去找幕后的人，至少要真的把货物交出去吧？"
        },
        {
          "role": "夏沃蕾",
          "text": "但是你们准备的货物…能放心把这么危险的武器交给他们？"
        },
        {
          "role": "夜兰",
          "text": "具体有多危险，我们可以加以控制。但如果按照你的计划来，真的能保证一个都跑不掉？"
        },
        {
          "role": "夏沃蕾",
          "text": "…你们真的有反制这种武器的方法？"
        },
        {
          "role": "夜兰",
          "text": "…你们真的有在挪德卡莱组织大规模搜捕行动的能力？"
        },
        {
          "role": "派蒙",
          "text": "她们是要吵起来吗？"
        },
        {
          "role": "北斗",
          "text": "两个心眼都特别多的人聊起来，就会变成这样。"
        },
        {
          "role": "娜维娅",
          "text": "不用担心啦，我觉得聊得还不错。"
        },
        {
          "role": "夜兰",
          "text": "合作还是需要让步，看来我应该表达出足够的信任。"
        },
        {
          "role": "夜兰",
          "text": "这样如何？我按照原计划去与对方碰面，在我拖住对方的这段时间，由阁下完成对所有暗哨的收网。"
        },
        {
          "role": "夏沃蕾",
          "text": "感谢你的让步，我向你保证，一个都跑不掉的。"
        },
        {
          "role": "娜维娅",
          "text": "看吧！"
        },
        {
          "role": "夜兰",
          "text": "那么，就请旅行者和我一起去跟那个探子碰面吧，毕竟按照约定你需要全程参与调查。"
        },
        {
          "role": "派蒙",
          "text": "可是，旅行者的身份…"
        },
        {
          "role": "夜兰",
          "text": "旅行者可以藏在暗处，当我的后盾。万一对方想动手，就一起把他揍趴下。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "这一点我最擅长了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我已经摩拳擦掌了！"
        },
        {
          "type": "subtitle",
          "text": "与夜兰一同前往「旗舰」"
        },
        {
          "role": "派蒙",
          "text": "啊，来了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嘘。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "探子",
          "text": "真的不能再低了？"
        },
        {
          "role": "夜兰",
          "text": "最多就是从总价里减掉原本要给伏尼契商会的抽成。"
        },
        {
          "role": "探子",
          "text": "真是不肯松口…你们准备怎么交货？"
        },
        {
          "role": "夜兰",
          "text": "你们看上去不是当地人，需要装船吧？"
        },
        {
          "role": "探子",
          "text": "确实需要装船，不过这里的港口人多眼杂，可以将货物拆分成零件，装进常用的货箱里吗？"
        },
        {
          "role": "夜兰",
          "text": "嗯…有些麻烦，担心被看到就找个隐秘的海岸吧，我们直接用自己的船把货运过去。"
        },
        {
          "role": "探子",
          "text": "抱歉，我们还是希望能拆分后装进常用的货箱里。"
        },
        {
          "role": "夜兰",
          "text": "哦…看来你们转卖货物的地方也是公开的港口，所以才必须把货物藏进常用的货箱里，掩人耳目。"
        },
        {
          "role": "夜兰",
          "text": "那些武器基本上都是从遗珑埠或者柔灯港流散出来的，确实可以对应上。"
        },
        {
          "role": "探子",
          "text": "你…你到底是什么意思？"
        },
        {
          "role": "夜兰",
          "text": "没什么，只是想再次确认一下…时间差不多了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们上！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "探子",
          "text": "唔…"
        },
        {
          "role": "派蒙",
          "text": "哼，老实点！"
        },
        {
          "role": "夜兰",
          "text": "嗯？"
        },
        {
          "role": "暗哨",
          "text": "都闪开！"
        },
        {
          "role": "派蒙",
          "text": "是他们的暗哨，要跑掉了！"
        },
        {
          "role": "夜兰",
          "text": "到那位特巡队队长的表演时间了。"
        },
        {
          "type": "subtitle",
          "text": "制服暗哨"
        },
        {
          "role": "夏沃蕾",
          "text": "跑出来一个…看来明面上的那个已经被制服了。"
        },
        {
          "role": "夏沃蕾",
          "text": "附近还有孩子…得在尽量不见血的前提下解决问题。"
        },
        {
          "role": "夏沃蕾",
          "text": "哼，就让我帮你规划一下逃跑路线吧。"
        },
        {
          "type": "subtitle",
          "text": "阻止暗哨逃跑"
        },
        {
          "role": "夏沃蕾",
          "text": "此路不通。"
        },
        {
          "role": "夏沃蕾",
          "text": "识相的话就回头。"
        },
        {
          "role": "夏沃蕾",
          "text": "体力已经消耗得差不多了吧？不过，还得让你变得更老实一些。"
        },
        {
          "type": "subtitle",
          "text": "与夏沃蕾会合"
        },
        {
          "role": "暗哨",
          "text": "呜啊！我的腿…"
        },
        {
          "role": "夏沃蕾",
          "text": "安生些，再乱动的话，你这条腿可不一定保得住。"
        },
        {
          "role": "暗哨",
          "text": "执律庭特巡队的制服…哼，你以为抓住我就够了？你知道我们的暗哨有多少人吗？只要有一个能回去…"
        },
        {
          "role": "夏沃蕾",
          "text": "港口处五个，那夏镇外围十个，广场附近三个，再算上你和那个负责出面交易的，共计二十个。"
        },
        {
          "role": "夏沃蕾",
          "text": "你是第二十个。"
        },
        {
          "role": "暗哨",
          "text": "什么…"
        },
        {
          "role": "刺玫会分会成员",
          "text": "老实点！"
        },
        {
          "role": "克洛琳德",
          "text": "干得不错，我代表老板感谢诸位的协作。"
        },
        {
          "role": "刺玫会分会成员",
          "text": "这是我们的荣幸，当年我们来挪德卡莱打拼时，多亏了有刺玫会的帮助啊。"
        },
        {
          "role": "娜维娅",
          "text": "噗…"
        },
        {
          "role": "克洛琳德",
          "text": "怎么了？不是说好了吗？为了震慑当地的其他黑帮，需要我配合你表现出一些威压感。"
        },
        {
          "role": "娜维娅",
          "text": "这一点倒是没错，只是听到你喊我「老板」，还是觉得好有趣啊。"
        },
        {
          "role": "克洛琳德",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "哇，娜维娅好厉害…"
        },
        {
          "role": "夜兰",
          "text": "原来这就是你的倚仗吗？刺玫会在枫丹之外竟然也能动员起如此庞大的人力，那位大小姐还真是深藏不露啊。"
        },
        {
          "role": "夏沃蕾",
          "text": "这可没有违反任何规则，就算那位秘闻馆的主人亲自来了，我也不需要解释什么。"
        },
        {
          "role": "夜兰",
          "text": "不过，你刚刚打坏了伏尼契商会安置在镇里的宣传牌，这个至少要解释一下吧？"
        },
        {
          "role": "夏沃蕾",
          "text": "…事急从权。"
        },
        {
          "role": "夜兰",
          "text": "接下来，就该想办法让他们张嘴了吧？我听说枫丹执律庭掌握的审讯手段非常高效。"
        },
        {
          "role": "夏沃蕾",
          "text": "璃月密探对付嫌犯的手法，也是不遑多让啊。"
        },
        {
          "role": "探子",
          "text": "噫…"
        },
        {
          "role": "派蒙",
          "text": "这样一来，我们的行动算是圆满成功了吧？"
        },
        {
          "role": "夏沃蕾",
          "text": "等到把团伙头目的情报挖出来，还有很多必须要做的事。"
        },
        {
          "role": "夜兰",
          "text": "不过，那个家伙肯定藏在远离展会的地方。总的来说，我们和秘闻馆之间的协商可以告一段落了。"
        },
        {
          "role": "派蒙",
          "text": "那是不是该找奈芙尔交代一下结果？"
        },
        {
          "role": "夜兰",
          "text": "我明白，等审讯结果出来我会联系你们。到时候大家一起去秘闻馆，也算是给她一个交代。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好，就这么办。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "在娜维娅的帮助下，夜兰和夏沃蕾押送着嫌犯们离开了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "比我想象中顺利多了，一个都跑不掉！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "背后的故事…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你是想到了奈芙尔的那个委托吧？嗯…我觉得两国警探联手这件事本身就是一个很不错的故事了。"
        },
        {
          "role": "派蒙",
          "text": "你要是觉得还缺什么，兴许夜兰她们能审出一些更有趣的事。"
        },
        {
          "role": "塔尔诺",
          "text": "打扰下，这位就是旅行者吧？雅珂达有急事，希望阁下能尽快前往展会那边。"
        },
        {
          "role": "派蒙",
          "text": "展会那边出事了？"
        },
        {
          "role": "塔尔诺",
          "text": "抱歉，我不知道具体发生了什么，雅珂达只是说情况紧急。"
        },
        {
          "role": "派蒙",
          "text": "那我们快过去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "返回会场"
        },
        {
          "role": "雅珂达",
          "text": "（一边是商会的声誉，一边是佣兵巨头的货物，还有比这更糟糕的情况吗？）"
        },
        {
          "role": "雅珂达",
          "text": "（雅珂达，你要冷静！要是能够活过今天的话就奖励自己吃个热狗…好的，我冷静了！）"
        },
        {
          "role": "北斗",
          "text": "姑娘，你先冷静一下。"
        },
        {
          "role": "雅珂达",
          "text": "请放心，我一定会想办法的！"
        },
        {
          "role": "派蒙",
          "text": "发生什么事了？"
        },
        {
          "role": "雅珂达",
          "text": "你们终于来了！旅行者，我需要你帮帮忙，货柜失窃可是会影响到展会声誉的大事啊！"
        },
        {
          "role": "派蒙",
          "text": "有人来展会上偷东西？"
        },
        {
          "role": "雅珂达",
          "text": "明明已经专门安排了商会的人去盯守货柜，每天还要定时清点，怎么会失窃？偏偏失主还是那位…"
        },
        {
          "role": "派蒙",
          "text": "北斗？难道…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "归终机被偷了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "北斗",
          "text": "按照规定，参展方的展品要存放在展会提供的货柜里，我在里面存放了几台用来展示的样机。"
        },
        {
          "role": "北斗",
          "text": "今天清点的时候，我发现这几台样机全被偷了。"
        },
        {
          "role": "派蒙",
          "text": "以那种归终机的威力，要是落在一些坏蛋手上…"
        },
        {
          "role": "北斗",
          "text": "用来参展的样机都被设置了保险，普通人根本无法解开，所以情况还不算很糟，目前最要紧的是追回失窃的样机。"
        },
        {
          "role": "雅珂达",
          "text": "这一点由商会来想办法，还麻烦您不要声张。谢谢理解，谢谢理解…"
        },
        {
          "role": "阿诺",
          "text": "真的要说吗？"
        },
        {
          "role": "阿提",
          "text": "要诚实，这一点还是他教给我们的。"
        },
        {
          "role": "阿诺",
          "text": "我知道，可是…"
        },
        {
          "role": "阿娅",
          "text": "雅珂达姐姐…"
        },
        {
          "role": "雅珂达",
          "text": "你们怎么到这里来了？"
        },
        {
          "role": "北斗",
          "text": "你们是不是有什么事想对我讲？"
        },
        {
          "role": "阿娅",
          "text": "来到展会后，阿诺就对大姐姐的归终机很感兴趣。后来叔叔知道了，就鼓励我们一起来大姐姐这里参观。"
        },
        {
          "role": "阿娅",
          "text": "他还特别叮嘱我们要询问几种参数，看得出来，他也对大姐姐的归终机感兴趣…"
        },
        {
          "role": "阿娅",
          "text": "今天早些时候，我们忽然联系不上叔叔他了。本来想找雅珂达姐姐帮忙，结果就听到了归终机被偷走的事…"
        },
        {
          "role": "北斗",
          "text": "你们的意思是？"
        },
        {
          "role": "阿娅",
          "text": "我不觉得叔叔那样的人会偷东西，但是…"
        },
        {
          "role": "雅珂达",
          "text": "阿梵波谛是商会内部的人，他想要进入仓库的话是很容易的，盯守的人也不会怀疑他…"
        },
        {
          "role": "雅珂达",
          "text": "（等等，这对于商会的声誉来说岂不是更不利了？）"
        },
        {
          "role": "北斗",
          "text": "我记得这些孩子售卖的「玩具」都是他的作品，看似简陋，但技术水平肯定不低。"
        },
        {
          "role": "北斗",
          "text": "如果真的是他，样机上的那些保险可能就不太保险了…"
        },
        {
          "role": "雅珂达",
          "text": "所以，情况是变得更糟了吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这件事和那个团伙…",
              "dialogues": []
            },
            {
              "text": "会不会有关系？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "北斗",
          "text": "你的意思是…能让夜兰也看走眼的家伙可真不多见。"
        },
        {
          "role": "北斗",
          "text": "看来需要你带着这三个孩子去秘闻馆找其他人核对一些信息，展会这边就先交给我吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯，明白了。"
        },
        {
          "role": "雅珂达",
          "text": "稍等一下，总不能追究这些孩子的责任吧？"
        },
        {
          "role": "派蒙",
          "text": "不要误会，不过该怎么解释呢…"
        },
        {
          "role": "北斗",
          "text": "你想罩着这三个孩子？"
        },
        {
          "role": "雅珂达",
          "text": "…作为秘闻馆的一员，我确实说过这种话，而且他们明显是无辜的。"
        },
        {
          "role": "北斗",
          "text": "那就好，我也想罩着这三个孩子，所以才要尽快把他们的叔叔找回来。无论真相是怎样的，都不该让他们担心。"
        },
        {
          "role": "雅珂达",
          "text": "哦…那就好。"
        },
        {
          "role": "北斗",
          "text": "就有劳你们带这三个孩子去秘闻馆了，我会通知夜兰，让她也前往那里。"
        },
        {
          "role": "派蒙",
          "text": "交给我们就好！"
        },
        {
          "type": "subtitle",
          "text": "前往秘闻馆"
        },
        {
          "type": "subtitle",
          "text": "众人核对了彼此手中的情报。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "奈芙尔",
          "text": "没想到最后还能出现这样的插曲，我原本以为两位带来的麻烦事今天就能结束。"
        },
        {
          "role": "奈芙尔",
          "text": "不过也好，「故事」好像变得更有趣了。"
        },
        {
          "role": "夏沃蕾",
          "text": "亏你还能说得这么轻巧，出问题的可是你们伏尼契商会的人。"
        },
        {
          "role": "夏沃蕾",
          "text": "难道那些被抓住的人都只是用来转移注意力的？等我们抓人时，就从展会那边下手…"
        },
        {
          "role": "夜兰",
          "text": "目前还无法确认什么，关于这位阿梵波谛，可否请三位当事人仔细介绍一下？"
        },
        {
          "role": "阿提",
          "text": "…阿梵波谛叔叔是我们的监护人，不过，他和我们之间并没有血缘关系，在我们很小的时候，他就领养了我们。"
        },
        {
          "role": "阿提",
          "text": "听他说，我们都来自须弥沙漠中的一支镀金旅团，不过那支旅团已经不存在了…"
        },
        {
          "role": "阿提",
          "text": "从记事起，他就带着我们到处流浪，最近才来到这里。"
        },
        {
          "role": "奈芙尔",
          "text": "这些孩子的眼睛…"
        },
        {
          "role": "夜兰",
          "text": "你好像发现了什么？"
        },
        {
          "role": "奈芙尔",
          "text": "只是想起了一些往事。"
        },
        {
          "role": "奈芙尔",
          "text": "据我所知，在十几年前的须弥沙漠中，一支镀金旅团忽然获得了远超其他旅团的科技水平。"
        },
        {
          "role": "奈芙尔",
          "text": "利用这一点，他们制造了大量威力惊人的武器，并售卖给其他旅团。"
        },
        {
          "role": "奈芙尔",
          "text": "沙漠里的争斗因为他们售出的武器而愈发血腥，然而他们却从不参与任何争斗，只是坐收渔利。"
        },
        {
          "role": "奈芙尔",
          "text": "但很不幸，他们售出的武器最终还是变成了烧向自己的战火，这支旅团很快就覆灭了。"
        },
        {
          "role": "奈芙尔",
          "text": "血腥的争斗很快就耗尽了那些武器，沙漠也恢复到了之前的样子。"
        },
        {
          "role": "夏沃蕾",
          "text": "还有这种事？闻所未闻…"
        },
        {
          "role": "奈芙尔",
          "text": "为了私利制造杀戮的事在沙漠里太常见了。"
        },
        {
          "role": "奈芙尔",
          "text": "诚然，这种事如果发生在枫丹或者璃月，就会立刻被追查到底。但在沙漠里，没有多少人会留意。"
        },
        {
          "role": "奈芙尔",
          "text": "而这三个孩子，似乎就是那支旅团的遗孤。"
        },
        {
          "role": "夏沃蕾",
          "text": "他们的监护人自然也是那支旅团的幸存者，这么说的话…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那支旅团的幸存者…",
              "dialogues": []
            },
            {
              "text": "重操旧业了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "这个推断确实很合理。"
        },
        {
          "role": "阿诺",
          "text": "不可能的！叔叔他绝不会做你们说的那些事！"
        },
        {
          "role": "阿诺",
          "text": "我确实不知道他之前做过什么，但有一点我是最清楚的——叔叔他讨厌武器，非常讨厌！"
        },
        {
          "role": "阿诺",
          "text": "他的手明明很巧，但只会制作一些用来哄我们的玩具。如果他真的是你们说的那样，我…"
        },
        {
          "role": "夏沃蕾",
          "text": "很抱歉，我们最终还是要通过事实来做判断。"
        },
        {
          "role": "派蒙",
          "text": "那接下来该怎么办？"
        },
        {
          "role": "夏沃蕾",
          "text": "根据审讯结果，幕后的人和探子约好了，要在两天后到指定地点找他提货，这样我们可以到接头的地方埋伏对方。"
        },
        {
          "role": "夏沃蕾",
          "text": "但如果那个阿梵波谛也是他们的人，这些被抓住的家伙恐怕都会被当成弃子。两天后，我们不会见到任何来接头的人。"
        },
        {
          "role": "夜兰",
          "text": "不如转而追查那个阿梵波谛，这样我们一样可以找到幕后的人。"
        },
        {
          "role": "夜兰",
          "text": "如果他真的偷走了样机，一定会留下对应的痕迹。我可以想办法确认他的下落，只是需要一些时间。"
        },
        {
          "role": "夏沃蕾",
          "text": "有什么我可以帮忙的地方吗？"
        },
        {
          "role": "夜兰",
          "text": "我所使用的方法，大多只适用于密探。参与的人多了，反而可能不方便行事。"
        },
        {
          "role": "夜兰",
          "text": "不过，确认他的下落后，最终的抓捕行动还是可以仰仗特巡队的助力。"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯…那我就静候你的好消息了，这是目前最合适的方案。"
        },
        {
          "role": "阿提",
          "text": "抓捕…"
        },
        {
          "role": "派蒙",
          "text": "先不要担心，不管怎么说，先把你们叔叔找回来才是最重要的事情。"
        },
        {
          "role": "阿提",
          "text": "嗯…"
        },
        {
          "role": "奈芙尔",
          "text": "看来需要再劳烦你一段时间了，旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好报酬就行。",
              "dialogues": []
            },
            {
              "text": "没关系，我也更好奇了。",
              "dialogues": []
            }
          ]
        }
      ]
    }
  ]
}