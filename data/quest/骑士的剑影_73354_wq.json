{
  "quest_id": 73354,
  "chapter_num": null,
  "chapter_title": "骑士的剑影",
  "type": "wq",
  "route": "Shadow of the Knight's Blade",
  "stories": [
    {
      "story_id": 73354,
      "title": "骑士的剑影",
      "description": "为了讲述「花之骑士不为人知的战斗」，毗伽尔和学者萨费伊正在筹备一场特别的活动…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与为难的两人对话"
        },
        {
          "type": "subtitle",
          "text": "心声（毗伽尔）"
        },
        {
          "role": "毗伽尔",
          "text": "（虽说目前的综合表现接近完美，但似乎还有提升的空间…）"
        },
        {
          "role": "萨费伊",
          "text": "（为了再现花之骑士的英姿，要努力努力再努力啊！）"
        },
        {
          "role": "毗伽尔",
          "text": "灯光的色调和强度恰到好处，特效也相当华丽，综合表现的效果堪称完美。"
        },
        {
          "role": "毗伽尔",
          "text": "太棒了，萨费伊，多亏了你，我们才能将花之骑士传说中的英姿重现。"
        },
        {
          "role": "萨费伊",
          "text": "哎呀呀，又不是我一个人的功劳，你跑前跑后，比我这个只管书面工作的文职累多了。"
        },
        {
          "role": "萨费伊",
          "text": "现在最重要的问题是花之骑士的人选…需要演员拥有非凡身手，气质又与传说中的法里斯相似，条件似乎有些苛刻？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们在聊什么呢？",
              "dialogues": []
            },
            {
              "text": "好像遇上了难题？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "灯光？特效？你们在为演出的事发愁吗？"
        },
        {
          "role": "萨费伊",
          "text": "出现了！绝无仅有的大英雄，花之骑士扮演者的无上人选…"
        },
        {
          "role": "萨费伊",
          "text": "不，应该说您就是当之无愧的花之骑士本尊！"
        },
        {
          "role": "派蒙",
          "text": "噫，这个学者好激动！一看到旅行者，都眼里放光了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "欸呀，没那么夸张啦。",
              "dialogues": []
            },
            {
              "text": "说得好，再夸夸？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "毗伽尔",
          "text": "咳咳，很荣幸再次遇见您，旅行者先生/女士，这位是伐护末那学院的民俗学者萨费伊。"
        },
        {
          "role": "毗伽尔",
          "text": "最近他趁着「花神诞祭」的热潮，根据各种历史文献和民间传说，结合枫丹的新技术，设计了一部映影。"
        },
        {
          "role": "萨费伊",
          "text": "这部映影的重点是「花之骑士不为人知的战斗」，着重描绘了那位骑士为草神大人深入神秘幽邃的险境，斩除邪恶势力的故事…"
        },
        {
          "role": "派蒙",
          "text": "等等，我好像能猜到了…你们是不是没有擅长战斗的演员，拍不了战斗的桥段？"
        },
        {
          "role": "萨费伊",
          "text": "严格说来，无论文戏还是打戏，都没有比旅行者先生/女士更合适的演员。"
        },
        {
          "role": "萨费伊",
          "text": "要是旅行者愿意参演，这部映影有可能成为须弥历史上最出色的花之骑士艺术作品，上映后的收入相当乐观…"
        },
        {
          "role": "毗伽尔",
          "text": "当然，绝不会在分成上亏待两位。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，旅行者的形象，确实就该这么有人气！"
        },
        {
          "role": "派蒙",
          "text": "我们算是在「花神诞祭」度假，这段时间倒不怎么忙啦，拍几段戏的空闲应该是有的。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你觉得呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "演戏我不在行，战斗我很专业。",
              "dialogues": [
                {
                  "role": "萨费伊",
                  "text": "您愿意参演真是太好了，我们就只拍战斗戏！"
                },
                {
                  "role": "萨费伊",
                  "text": "同时，我们会以您的仪容为准，重新设计剧中花之骑士的形象，调整文戏演员的化妆和服装。"
                }
              ]
            },
            {
              "text": "打戏简简单单，文戏可以试试。",
              "dialogues": [
                {
                  "role": "萨费伊",
                  "text": "您愿意参演真是太好了，我们感激不尽！"
                },
                {
                  "role": "萨费伊",
                  "text": "不过，文戏的拍摄和打戏是分开的，前者要另定时间，到时候可能还要麻烦您了。"
                }
              ]
            }
          ]
        },
        {
          "role": "毗伽尔",
          "text": "事不宜迟，要是旅行者先生/女士准备好了，我们就直接开始吧？"
        },
        {
          "role": "派蒙",
          "text": "好，为了旅行者的大明星形象，还有花之骑士的热血传说，开演！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（毗伽尔&萨费伊）"
        },
        {
          "role": "毗伽尔",
          "text": "尊贵的花之骑士，有什么需要我们支援的吗？"
        },
        {
          "role": "萨费伊",
          "text": "每一幕打戏只需要遵循基本主题就行，动作都由专业的您自由发挥，不用在意我们原本的设计。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我多拍拍。",
              "dialogues": [
                {
                  "role": "萨费伊",
                  "text": "哈哈，请尽情施展您的战斗才华，隐藏在场地各处的留影机会将您的飒爽身姿全都记录下来！"
                },
                {
                  "role": "萨费伊",
                  "text": "我们的场地造型参考了冒险家传说中的危险秘境，说不定还能为您带来一些战斗的灵感呢！"
                }
              ]
            },
            {
              "text": "我以前是不是见过毗伽尔？",
              "dialogues": [
                {
                  "role": "毗伽尔",
                  "text": "您还记得我，真是我的荣幸。"
                },
                {
                  "role": "毗伽尔",
                  "text": "以往的花神诞祭上，我扮演过几次没有花车的花之骑士，主要负责给孩子们发糖。"
                },
                {
                  "role": "毗伽尔",
                  "text": "这次有比我更合适的花之骑士扮演者，我就本色出演一次「糖之骑士」好了。"
                },
                {
                  "role": "萨费伊",
                  "text": "也挺好的，我看孩子们都很喜欢这个称号，你多年来不懈发糖的形象已经深入人心了。"
                },
                {
                  "role": "毗伽尔",
                  "text": "那等到这部映影上映，我还能拿到…「映影骑士」之类的新称号吗？"
                },
                {
                  "role": "萨费伊",
                  "text": "导演的名字写你，制作人的名字写我，咱俩谁当「映影骑士」还不好说呢。"
                }
              ]
            },
            {
              "text": "关于映影的进度…",
              "dialogues": [
                {
                  "role": "毗伽尔",
                  "text": "如您所见，这才刚刚开始。"
                },
                {
                  "role": "毗伽尔",
                  "text": "由于「战斗」是这部映影的主题，我们决定先拍摄打戏，在能够实现的基础上确定关键的镜头语言、光影、调色等风格…"
                },
                {
                  "role": "毗伽尔",
                  "text": "然后再用这些确定了的事项，去确定文戏的拍摄细节，这样就能尽可能避免…「做不到」或「拍不出来」的问题了。"
                },
                {
                  "role": "萨费伊",
                  "text": "所以拍摄文戏要等到打戏的后期处理完毕，估计是很久以后的事了。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "真机灵！",
                      "dialogues": []
                    },
                    {
                      "text": "真保险！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "萨费伊",
                  "text": "哪里哪里，都是之前在枫丹考察时学到的小技巧，我们需要努力的事情还很多！"
                }
              ]
            },
            {
              "text": "下次再来！",
              "dialogues": [
                {
                  "role": "毗伽尔",
                  "text": "您慢走！麻烦您记得安排一些空闲时间，来把几个打戏桥段拍完…我们感激不尽！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          1,
          2
        ],
        [
