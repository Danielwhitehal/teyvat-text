{
  "quest_id": 72806,
  "chapter_num": null,
  "chapter_title": "「八重堂」的邀约",
  "type": "wq",
  "route": "Yae Publishing House's Invitation",
  "stories": [
    {
      "story_id": 72806,
      "title": "「八重堂」的邀约",
      "description": "「八重堂」的编辑荒谷似乎有什么事想要找人帮忙…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与荒谷对话"
        },
        {
          "type": "subtitle",
          "text": "与常九爷对话"
        },
        {
          "role": "常九爷",
          "text": "咦？旅行者，你今天过来是有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于「八重堂」的信件和礼物…"
        },
        {
          "role": "常九爷",
          "text": "「八重堂」的信？不会又是来让我改笔名的吧？"
        },
        {
          "role": "常九爷",
          "text": "我都说了，我署原名就好…"
        },
        {
          "role": "常九爷",
          "text": "算了，算了，我还是看看吧…"
        },
        {
          "role": "常九爷",
          "text": "小说比赛…评委，这…我也许没空去啊，但还是谢谢他们的好意…"
        },
        {
          "role": "常九爷",
          "text": "咦？这后面怎么还有这么多，这是…创作建议…"
        },
        {
          "role": "常九爷",
          "text": "呃，我、我会好好看看的，谢谢你，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "去万文集舍寻找「枕玉」"
        },
        {
          "type": "subtitle",
          "text": "与行秋对话"
        },
        {
          "role": "行秋",
          "text": "嗯…这里写得倒是不错，文笔颇为新颖…"
        },
        {
          "role": "旅行者",
          "text": "行秋。"
        },
        {
          "role": "行秋",
          "text": "原来如此，原来如此…"
        },
        {
          "role": "旅行者",
          "text": "行秋！"
        },
        {
          "role": "行秋",
          "text": "欸？是你啊，旅行者，好久不见。"
        },
        {
          "role": "行秋",
          "text": "听你刚才打招呼的语气，你还挺精神的嘛，不错，不错…找我有什么事吗？"
        },
        {
          "role": "派蒙",
          "text": "其实，我们是想向你打听一个人，你读得书多，说不定会知道。"
        },
        {
          "role": "行秋",
          "text": "一个人？你们莫不是要找哪位作者？唔…但说无妨。"
        },
        {
          "role": "旅行者",
          "text": "关于「枕玉」…"
        },
        {
          "role": "行秋",
          "text": "「枕玉」？你、你是从哪听到这名字的？"
        },
        {
          "role": "旅行者",
          "text": "这本《沉秋拾剑录》上写着呢…"
        },
        {
          "role": "派蒙",
          "text": "我们正在找这位「枕玉」，稻妻那边的「八重堂」拜托我们把一封信带给这位作者呢。"
        },
        {
          "role": "派蒙",
          "text": "你知道这位「枕玉」到底是谁吗？"
        },
        {
          "role": "行秋",
          "text": "嗯…这位「枕玉」…"
        },
        {
          "role": "行秋",
          "text": "说来惭愧，其实正是…我的笔名。"
        },
        {
          "role": "派蒙",
          "text": "欸？！"
        },
        {
          "role": "旅行者",
          "text": "之前没听你说过。"
        },
        {
          "role": "行秋",
          "text": "这件事…这件事也没什么好提起的。"
        },
        {
          "role": "行秋",
          "text": "当初在璃月时，负责的编辑说我写的这本书「设定过于离谱，剧情却意外地俗套，没人会喜欢」，然后就把我的稿给拒了。"
        },
        {
          "role": "行秋",
          "text": "我听了之后…咳，不太服气，就自己印了几本，偷偷放在「万文集舍」里，看有没有人喜欢。"
        },
        {
          "role": "行秋",
          "text": "结果，取阅者依然寥寥，我就没再把心放在这上面了。没想到，这本书在稻妻居然能受到如此好评。"
        },
        {
          "role": "行秋",
          "text": "但无论如何，我写的这书有人愿意看，自然是好事。"
        },
        {
          "role": "行秋",
          "text": "我会好好看看这封信的，谢谢你旅行者。"
        },
        {
          "type": "subtitle",
          "text": "向荒谷回报"
        },
        {
          "role": "荒谷",
          "text": "哎，您终于回来了！怎么样？有见到两位老师吗？"
        },
        {
          "role": "旅行者",
          "text": "信都送到了。"
        },
        {
          "role": "荒谷",
          "text": "太好了！谢谢你旅行者，那两位老师怎么说？"
        },
        {
          "role": "旅行者",
          "text": "他们说会好好看信的。"
        },
        {
          "role": "荒谷",
          "text": "那就好，那就好。唉…可惜这两位老师都远在璃月…平日里也没办法去拜访。"
        },
        {
          "role": "荒谷",
          "text": "特别是「枕玉」老师的那本《沉秋拾剑录》还不是他本人投的稿，是被一位客商带回的稻妻。"
        },
        {
          "role": "荒谷",
          "text": "然后，我们「八重堂」中的一位编辑读到了这本书，感觉到了这本书的价值，就准备亲自去璃月一趟，向「枕玉」老师正式约稿。"
        },
        {
          "role": "荒谷",
          "text": "但没想到…稻妻的局势骤变，我们没法派人去璃月，寄出去的信也始终杳无回音。"
        },
        {
          "role": "荒谷",
          "text": "我们就只能自己先印发了这本书，把稿酬都给「枕玉」老师记下，等取得联系之后，再一起付给他。"
        },
        {
          "role": "荒谷",
          "text": "不过，都这么长时间了，《沉秋拾剑录》的销量始终居高不下，稿酬也越堆越多。"
        },
        {
          "role": "荒谷",
          "text": "唉，「枕玉」老师可千万要出席这次比赛啊，这稿酬…这稿酬可不能再堆下去了…"
        },
        {
          "role": "荒谷",
          "text": "哎，您终于回来了！怎么样？有见到两位老师吗？"
        },
        {
          "role": "旅行者",
          "text": "信都送到了。"
        },
        {
          "role": "荒谷",
          "text": "太好了！谢谢你旅行者，那两位老师怎么说？"
        },
        {
          "role": "旅行者",
          "text": "他们说会好好看信的。"
        },
        {
          "role": "荒谷",
          "text": "那就好，那就好。唉…可惜这两位老师都远在璃月…平日里也没办法去拜访。"
        },
        {
          "role": "荒谷",
          "text": "特别是「枕玉」老师的那本《沉秋拾剑录》还不是他本人投的稿，是被一位客商带回的稻妻。"
        },
        {
          "role": "荒谷",
          "text": "然后，我们「八重堂」中的一位编辑读到了这本书，感觉到了这本书的价值，就准备亲自去璃月一趟，向「枕玉」老师正式约稿。"
        },
        {
          "role": "荒谷",
          "text": "但没想到…稻妻的局势多变，计划一拖再拖，寄出去的信也始终杳无回音。"
        },
        {
          "role": "荒谷",
          "text": "我们就只能自己先印发了这本书，把稿酬都给「枕玉」老师记下，等取得联系之后，再一起付给他。"
        },
        {
          "role": "荒谷",
          "text": "唉，「枕玉」老师可千万要出席这次比赛啊，这稿酬…这稿酬可不能再堆下去了…"
        }
      ]
    }
  ]
}