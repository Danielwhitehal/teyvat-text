{
  "quest_id": 23009,
  "chapter_num": null,
  "chapter_title": "凝成泥土的它用",
  "type": "iq",
  "route": "The Other Applications of Concresoil",
  "stories": [
    {
      "story_id": 23009,
      "title": "凝成泥土的它用",
      "description": "阿金似乎正在为某事而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与阿金对话"
        },
        {
          "role": "阿金",
          "text": "还得再去买些材料回来…"
        },
        {
          "role": "旅行者",
          "text": "你的「凝成泥土」怎么样了？"
        },
        {
          "role": "阿金",
          "text": "非常好！不如说，这种泥土的应用范围简直超乎我的想象。"
        },
        {
          "role": "阿金",
          "text": "它可以用来做瓶瓶罐罐，也能修补房屋的漏洞。"
        },
        {
          "role": "阿金",
          "text": "只要调整一下各种泥土的混合比例，直接用来搭建房屋也没有问题。"
        },
        {
          "role": "阿金",
          "text": "不过…因为大家都来找我订购这种泥土，我的材料又不够用了。"
        },
        {
          "role": "阿金",
          "text": "而且最关键的史莱姆凝液也用光了，旅行者，能请你再去帮我拿三份史莱姆凝液回来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "其他材料呢？",
              "dialogues": [
                {
                  "role": "阿金",
                  "text": "其他的材料我都已经从各种渠道订购，或者托人去找了。"
                },
                {
                  "role": "阿金",
                  "text": "但史莱姆凝液消耗得实在太快，出乎我的预料…"
                }
              ]
            }
          ]
        },
        {
          "role": "阿金",
          "text": "拜托你了，旅行者，请你帮我拿三份史莱姆凝液回来吧。"
        },
        {
          "type": "subtitle",
          "text": "将三个史莱姆凝液交给阿金"
        },
        {
          "role": "阿金",
          "text": "旅行者，你拿到史莱姆凝液了吗？"
        },
        {
          "type": "subtitle",
          "text": "继续与阿金对话"
        },
        {
          "role": "阿金",
          "text": "谢谢你，这样材料就暂时齐全了。"
        },
        {
          "role": "阿金",
          "text": "请你稍等一下，我现在就调配一下凝成泥土…"
        },
        {
          "role": "？？？",
          "text": "阿金开始调配泥土…"
        },
        {
          "role": "阿金",
          "text": "这样就可以了，旅行者，请你帮我把这份泥土带给尼姆吧。"
        },
        {
          "role": "阿金",
          "text": "他可是等着这泥土好久了，想必都等急了。"
        },
        {
          "role": "阿金",
          "text": "这孩子可是有着…嗯…非比寻常的想象力。"
        },
        {
          "role": "阿金",
          "text": "尼姆和我说，他想要做一群「泥罐战士」，这群战士们都是一个个会说话的泥罐，能够滚动着身子打倒敌人，还有各种神奇的能力。"
        },
        {
          "role": "阿金",
          "text": "而这群「泥罐战士」的能力，则根据他们塞进自己「罐体」里的材料而各不相同。"
        },
        {
          "role": "阿金",
          "text": "他还给「泥罐战士」取了名字呢，好像叫亚什么来着…"
        },
        {
          "role": "阿金",
          "text": "哈哈哈，虽然实现不了，但他的想法真的很有趣。"
        },
        {
          "role": "阿金",
          "text": "我就想，既然他有这么新奇的点子，不如就把这泥土当做玩具送给他。"
        },
        {
          "role": "阿金",
          "text": "这样，他就可以亲手铸造出他的「泥罐战士」们，正式当上「泥罐将军」了。"
        },
        {
          "role": "阿金",
          "text": "咳，先不说了，总之请你把这罐泥土送给尼姆吧。"
        },
        {
          "role": "阿金",
          "text": "等到他的「泥罐战士」正式出炉，说不定他也会封你和我一个「泥罐大将」的称号呢。"
        },
        {
          "type": "subtitle",
          "text": "将泥土交给尼姆"
        },
        {
          "role": "尼姆",
          "text": "你好，大哥哥，请问有什么事吗？"
        },
        {
          "type": "subtitle",
          "text": "继续与尼姆对话"
        },
        {
          "role": "尼姆",
          "text": "哇，这就是阿金叔叔说的，什么都能做的泥土吧！"
        },
        {
          "role": "尼姆",
          "text": "太好了，谢谢你，大哥哥！"
        },
        {
          "role": "尼姆",
          "text": "这下，我就可以把「亚德里」做出来了！"
        },
        {
          "role": "旅行者",
          "text": "「亚德里」是…"
        },
        {
          "role": "尼姆",
          "text": "大哥哥没听阿金叔叔说吗？"
        },
        {
          "role": "尼姆",
          "text": "我正在做「泥罐战士」呢。「亚德里」就是最初，也是最强的「泥罐战士」！"
        },
        {
          "role": "尼姆",
          "text": "他脾气很好，也很善良。作为「泥罐战士」苏醒的时候，第一件事就是向被他压在身子下面的草地道歉。"
        },
        {
          "role": "尼姆",
          "text": "他的能力是…能力是…"
        },
        {
          "role": "尼姆",
          "text": "我，我还没想好…等我想好了，第一个告诉你！"
        },
        {
          "role": "尼姆",
          "text": "做完了「亚德里」之后，我还要做他的副官「伊瓦尔」和徒弟「拉松」。"
        },
        {
          "role": "尼姆",
          "text": "他们三个人…不对，三个「泥罐战士」，会开始一场很长很长的旅行…"
        },
        {
          "type": "subtitle",
          "text": "与阿金对话"
        },
        {
          "role": "阿金",
          "text": "还得再去买些材料回来…"
        },
        {
          "role": "旅行者",
          "text": "你的「凝成泥土」怎么样了？"
        },
        {
          "role": "阿金",
          "text": "非常好！不如说，这种泥土的应用范围简直超乎我的想象。"
        },
        {
          "role": "阿金",
          "text": "它可以用来做瓶瓶罐罐，也能修补房屋的漏洞。"
        },
        {
          "role": "阿金",
          "text": "只要调整一下各个泥土的混合比例，直接用来搭建房屋也没有问题。"
        },
        {
          "role": "阿金",
          "text": "不过…因为大家都来找我订购这种泥土，我的材料又不够用了。"
        },
        {
          "role": "阿金",
          "text": "就连骗骗花根系上的泥土也用光了…旅行者，能请你再去帮我拿一份回来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "其他材料呢？",
              "dialogues": [
                {
                  "role": "阿金",
                  "text": "其他的材料我都已经从各种渠道订购，或者托人去找了。"
                },
                {
                  "role": "阿金",
                  "text": "但这种泥土都消耗完了，我之前的备货还是太少了…"
                }
              ]
            }
          ]
        },
        {
          "role": "阿金",
          "text": "那就拜托你了，请你帮我带回来一份骗骗花根系上的泥土吧。"
        },
        {
          "type": "subtitle",
          "text": "前往骗骗花出现的地点"
        },
        {
          "type": "subtitle",
          "text": "将样本带回给阿金"
        },
        {
          "role": "阿金",
          "text": "你们拿到那种泥土了吗？"
        },
        {
          "type": "subtitle",
          "text": "继续与阿金对话"
        },
        {
          "role": "阿金",
          "text": "谢谢你，这些应该足够我再用一段时间了。"
        },
        {
          "role": "阿金",
          "text": "我在想，这种「凝成泥土」，也许还有其他的改造方式…"
        },
        {
          "role": "阿金",
          "text": "比如，能够持续吸纳水分，本身富含营养…"
        },
        {
          "role": "阿金",
          "text": "唉，我这个脑瓜子真是不好使，如果是上层的那些聪明人，也许能想出更多的好办法吧…"
        },
        {
          "type": "subtitle",
          "text": "与阿金对话"
        },
        {
          "role": "阿金",
          "text": "旅行者！你来得正好，我正在发愁没有人帮忙呢。"
        },
        {
          "role": "旅行者",
          "text": "你的研究有进展了？"
        },
        {
          "role": "阿金",
          "text": "呃…也谈不上「进展」，只不过是有一位顾客给我提出了意见。"
        },
        {
          "role": "阿金",
          "text": "他说自己经常养花，最烦恼的事就是寻找合适的花土。"
        },
        {
          "role": "阿金",
          "text": "既要有透气性，营养又要好，不能太吸水，也不能太容易排水…"
        },
        {
          "role": "阿金",
          "text": "他看到了我的「凝成泥土」有这么多改进方案，就想要拜托我设计出一种专门养花用的「凝成花土」。"
        },
        {
          "role": "阿金",
          "text": "我觉得这是一个很有意思的方向，所以我正在寻找别的材料，来改进我的「凝成泥土」。"
        },
        {
          "role": "阿金",
          "text": "这一次，我想要拜托你帮我去挖一些肥沃的泥土回来。"
        },
        {
          "role": "阿金",
          "text": "我把那种泥土的所在位置给你标在地图上。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么这么远啊…",
              "dialogues": []
            },
            {
              "text": "这地方你是怎么找到的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿金",
          "text": "这地方是我找人打听来的，虽然有点远，但据说那边的泥土非常肥沃。"
        },
        {
          "role": "阿金",
          "text": "不过…呃…那边好像也有很多魔物，我自己可不敢去…"
        },
        {
          "role": "阿金",
          "text": "所以，我只能拜托你了！旅行者！"
        },
        {
          "type": "subtitle",
          "text": "前往阿金推荐的地点"
        },
        {
          "type": "subtitle",
          "text": "将样本带回给阿金"
        },
        {
          "role": "阿金",
          "text": "你们拿到那种泥土了吗？"
        },
        {
          "type": "subtitle",
          "text": "与阿金对话"
        },
        {
          "role": "阿金",
          "text": "就是这些！非常感谢。"
        },
        {
          "role": "阿金",
          "text": "这些是报酬，请你收下吧。"
        },
        {
          "role": "阿金",
          "text": "不过…这泥土肥沃是肥沃，但怎么这么重，感觉也不是很透气…"
        },
        {
          "role": "阿金",
          "text": "唔，还是要把它和其他泥土混合一下才行…"
        },
        {
          "type": "subtitle",
          "text": "与阿金对话"
        },
        {
          "role": "阿金",
          "text": "这下糟糕了，到底是哪里出了问题…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "阿金",
          "text": "啊！是，是你啊，旅行者…"
        },
        {
          "role": "阿金",
          "text": "别提了，我的「凝成泥土」出问题了…"
        },
        {
          "role": "阿金",
          "text": "不知道是我的配方出了问题，还是我没考虑到实际的使用情况…"
        },
        {
          "role": "阿金",
          "text": "不少用我的「凝成泥土」搭建厨房的人说，在用了一段时间后，泥土出现了不同程度的开裂。"
        },
        {
          "role": "阿金",
          "text": "也许是温度太高，导致泥土内部的什么成分失效了？"
        },
        {
          "role": "阿金",
          "text": "唉，总之我先去帮他们重新整修了坏掉的部分。"
        },
        {
          "role": "阿金",
          "text": "因为要修的人太多了，刮下来的「凝成泥土」我来不及带走，就让他们把泥土放在罐子里留着。唉…装了好几大罐…"
        },
        {
          "role": "阿金",
          "text": "旅行者，请你帮我去这一家回收一下废弃的「凝成泥土」吧，我去其他家回收。"
        },
        {
          "role": "阿金",
          "text": "唉，到底是哪里出了问题…"
        },
        {
          "type": "subtitle",
          "text": "前去回收泥土"
        },
        {
          "type": "subtitle",
          "text": "与阿金对话"
        },
        {
          "role": "阿金",
          "text": "唉…你们把那几罐「凝成泥土」拿回来了吗？"
        },
        {
          "type": "subtitle",
          "text": "继续与阿金对话"
        },
        {
          "role": "阿金",
          "text": "谢谢你，我会分析这一批泥土的情况。"
        },
        {
          "role": "阿金",
          "text": "怎么会发生这种事…难道我还要接着调整比例吗…"
        },
        {
          "role": "阿金",
          "text": "唉，做泥土怎么这么难…"
        }
      ]
    }
  ]
}