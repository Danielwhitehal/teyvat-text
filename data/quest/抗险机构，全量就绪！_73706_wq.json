{
  "quest_id": 73706,
  "chapter_num": null,
  "chapter_title": "抗险机构，全量就绪！",
  "type": "wq",
  "route": "Crisis Management Unit, Fully Operational!",
  "stories": [
    {
      "story_id": 73706,
      "title": "抗险机构，全量就绪！",
      "description": "在众人的协力下，「稳健知行」机构已趋于完善，走上了正轨，这段时间的忙碌总算告一段落…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与柯莱对话"
        },
        {
          "role": "柯莱",
          "text": "各位，好消息来了！"
        },
        {
          "role": "柯莱",
          "text": "我们为「稳健知行」机构打下的基础，已经得到了各学院权威学者们的高度认可…"
        },
        {
          "role": "柯莱",
          "text": "接下来，教令院派出的专门职工会正式入场，按照我们制定的标准和规则，继续将这个机构运转下去。"
        },
        {
          "role": "柯莱",
          "text": "这段时间实在有劳各位了，万分感谢各位的支持！"
        },
        {
          "role": "安柏",
          "text": "好耶！努力工作的成果得到了认可，柯莱大成功！"
        },
        {
          "role": "珐露珊",
          "text": "这次的交接工作也都让柯莱包圆了，真不错啊真不错…"
        },
        {
          "role": "珐露珊",
          "text": "希望新入学的年轻人们都能学学你的作风，踏踏实实，把每件小事都干得无可挑剔…"
        },
        {
          "role": "珐露珊",
          "text": "而不能只想着论文里的宏大目标，离开了书面推论就两眼一黑，两手一摊！"
        },
        {
          "role": "柯莱",
          "text": "我，我还是非常紧张的！在各个学院的代表之间跑来跑去，沟通协调，也有点晕头转向…"
        },
        {
          "role": "柯莱",
          "text": "当然，特别需要感谢旅行者和派蒙，他们帮我们完善了最关键的规则，提供了最宝贵的指导意见…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还行还行！",
              "dialogues": []
            },
            {
              "text": "功劳大家平分！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我们对这些工作都已经习以为常了，就像是…和大家一起来了场特别的野营！"
        },
        {
          "role": "派蒙",
          "text": "期间偶尔穿插一些解谜锻炼和健身活动，还挺有意思的！又有趣味又消食…"
        },
        {
          "role": "派蒙",
          "text": "消食…欸…饿了…"
        },
        {
          "role": "派蒙",
          "text": "既然工作万事大吉了，要不要一起吃顿饭，就当是庆祝了？"
        },
        {
          "role": "迪希雅",
          "text": "派蒙还真说到了点子上了——犒劳大家的大餐，我和坎蒂丝已经准备好了！"
        },
        {
          "role": "坎蒂丝",
          "text": "几位，这边请。"
        },
        {
          "role": "派蒙",
          "text": "是大餐！庆功宴！"
        },
        {
          "role": "安柏",
          "text": "来得正好！"
        },
        {
          "role": "派蒙",
          "text": "呜，好久没吃这么丰盛的须弥菜了，怎么感觉我…口味一换，肚量翻倍？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我们多来回走走。",
              "dialogues": []
            },
            {
              "text": "看你哪天一口一家饭店。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼哼，可别小瞧了我！"
        },
        {
          "role": "派蒙",
          "text": "当然，我也不会那么任性，还是要考虑你的钱包的。"
        },
        {
          "role": "珐露珊",
          "text": "嗯…嗯！好久没仔细品尝过沙漠地带的料理了…"
        },
        {
          "role": "珐露珊",
          "text": "记忆里的印象，居然被打破了？"
        },
        {
          "role": "珐露珊",
          "text": "原来我以前在沙漠里尝到的那些菜式…都是应付了事！"
        },
        {
          "role": "坎蒂丝",
          "text": "多谢您的认可，珐露珊女士。"
        },
        {
          "role": "坎蒂丝",
          "text": "如果来访阿如村的学者们都像您这样彬彬有礼，我们每次都会拿出最丰盛的餐食，尽力招待他们。"
        },
        {
          "role": "迪希雅",
          "text": "说起来，安柏小姐更是从遥远的蒙德来的…你有什么想参观的地方吗？"
        },
        {
          "role": "安柏",
          "text": "嘿，我都想好了！"
        },
        {
          "role": "安柏",
          "text": "听说在奥摩斯港西北，有一片长满参天大树的森林，每颗大树的树干，都比「猎鹿人」那栋房子的地基还宽…"
        },
        {
          "role": "安柏",
          "text": "我很好奇！那里的景色看起来究竟怎么样？"
        },
        {
          "role": "安柏",
          "text": "如果爬到树顶，从上边往下跳，再用风之翼滑翔，在巨树间穿梭，一定很有意思！"
        },
        {
          "role": "柯莱",
          "text": "那，我准备一些湿润的糕点、团子之类的零食。"
        },
        {
          "role": "柯莱",
          "text": "高处风大，不适合碎屑太多的食物。水袋也要选加厚款，防止一摔就坏…"
        },
        {
          "role": "派蒙",
          "text": "哦！软软糯糯的团子确实不错，柯莱很细心嘛！"
        },
        {
          "role": "安柏",
          "text": "沙漠这边的话，我对巨大的遗迹非常感兴趣，比如那座超厉害的，沙漏型的巨大建筑！"
        },
        {
          "role": "安柏",
          "text": "当然，说不定须弥这边有保护遗迹的规则，我不会贸然闯进去，远远观察一番就好了。"
        },
        {
          "role": "安柏",
          "text": "如果打扰到沉睡在里面的主人，也有点不讲礼貌，哈哈。"
        },
        {
          "role": "坎蒂丝",
          "text": "真是宝贵的守矩意识，安柏小姐，实在令我欣慰…"
        },
        {
          "role": "柯莱",
          "text": "嗯，以安柏平时习惯的环境，在列柱沙原长期旅行的话，肯定会觉得干燥难耐。"
        },
        {
          "role": "柯莱",
          "text": "所以必须准备一些保湿的药膏，还有滋润皮肤的植物精油…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "连面部护理都考虑到了吗…",
              "dialogues": []
            },
            {
              "text": "柯莱的体贴全方位进化了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "相比早有预期的旅行计划，这次参与「稳健知行」机构的建设，更让我惊喜！"
        },
        {
          "role": "安柏",
          "text": "托柯莱的福，认识了各位新朋友，我特别开心！"
        },
        {
          "role": "安柏",
          "text": "等到你们有空，也请来蒙德玩玩哦，我保证带你们吃个痛快，玩个尽兴！"
        },
        {
          "role": "迪希雅",
          "text": "那我可太期待了！"
        },
        {
          "role": "迪希雅",
          "text": "去枫丹的时候，我就尝到了进口的蒲公英酒，那种芳香和清甜实在让人沉醉，完全感受不到一点苦涩！"
        },
        {
          "role": "迪希雅",
          "text": "不过，毕竟被封在容器里，漂洋过海，口感还是受了点影响。"
        },
        {
          "role": "迪希雅",
          "text": "到了蒙德，就能喝到最正宗，最纯正的蒲公英酒了，我要畅饮好几桶！"
        },
        {
          "role": "坎蒂丝",
          "text": "偶尔也喝点酒以外的东西吧？比如，孩子们送你的赤念果荆棘粉冲泡的茶…"
        },
        {
          "role": "迪希雅",
          "text": "啊哈…啊哈哈，坎蒂丝…酌情，酌情尝一点而已，桶也可以是…三五个杯子那么大的小木桶嘛…"
        },
        {
          "role": "迪希雅",
          "text": "如果真去蒙德玩了，我一定会给你带纪念品回来的！"
        },
        {
          "role": "珐露珊",
          "text": "我倒是听说，西风骑士团图书馆的藏书有上万卷。"
        },
        {
          "role": "珐露珊",
          "text": "没准，有些机关相关的典籍，会从不同的角度分析工程问题，值得一看。"
        },
        {
          "role": "安柏",
          "text": "具体的数字我也不清楚啦，不过图书馆确实很大很大！"
        },
        {
          "role": "安柏",
          "text": "珐露珊女士对哪些书感兴趣？我现在就记一下，提前和丽莎小姐打个招呼，准备得妥妥当当。"
        },
        {
          "role": "安柏",
          "text": "总之，大家的旅行安排，都包在我身上！"
        },
        {
          "role": "珐露珊",
          "text": "丽莎…丽莎·敏兹？那个[[居勒什]]老和我炫耀的学生…居然在这儿埋伏着我？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，这种感觉真棒！"
        },
        {
          "role": "派蒙",
          "text": "原本没想过会有关联的朋友，通过我们也认识的中间人，建立起新的友谊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "世界是在动态发展的嘛。",
              "dialogues": []
            },
            {
              "text": "朋友遍大陆多好呀！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！以后也可以由我们来牵线搭桥，让性格一看上去就合拍的伙伴们互相认识！"
        },
        {
          "role": "派蒙",
          "text": "感觉会有聊不完的、异想天开的话题，一起能做的事情也乐趣多多！"
        },
        {
          "type": "subtitle",
          "text": "派蒙想象着欧洛伦和荒泷一斗、宵宫和娜维娅、胡桃和雅珂达见面的情形…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（哈贾娜德）"
        },
        {
          "role": "哈贾娜德",
          "text": "您好，我的恩人。接下来就由我来继续管理这个侦察伙伴的项目，并详尽记述资料。"
        },
        {
          "role": "哈贾娜德",
          "text": "有什么吩咐吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要再试试侦察伙伴…",
              "dialogues": [
                {
                  "role": "哈贾娜德",
                  "text": "没问题！这次，我会用更加准确的模型来分析您提供的数据！"
                }
              ]
            },
            {
              "text": "你好像是悉般多摩学院的？",
              "dialogues": [
                {
                  "role": "哈贾娜德",
                  "text": "没错，我的学院并不直接参与机关研究。"
                },
                {
                  "role": "哈贾娜德",
                  "text": "但是没关系，多亏你们之前完成了所有关键规则与操作手册的制定，只是管理摊位和继续运营，每个学者都能做到。"
                },
                {
                  "role": "哈贾娜德",
                  "text": "在无需专门人力的地方，就做出一定的节省，也符合我们最新的原则。"
                },
                {
                  "role": "哈贾娜德",
                  "text": "附近待命的学者中，不乏刹诃伐罗学院的优秀人士，如果侦察伙伴的机关需要调试，随时可以唤来他们。"
                },
                {
                  "role": "哈贾娜德",
                  "text": "不过，目前看来，侦察伙伴们的状态都很好，完全无需担心！"
                },
                {
                  "role": "哈贾娜德",
                  "text": "当然，等我干出了漂亮的成绩，一定专程来答谢您！"
                }
              ]
            },
            {
              "text": "你加油！",
              "dialogues": [
                {
                  "role": "哈贾娜德",
                  "text": "当然，等我干出了漂亮的成绩，一定专程来答谢您！"
                }
              ]
            }
          ]
        },
        {
          "role": "'心声",
          "text": "'''（嗯，柯莱小姐，蒙德客人和大恩人已经把主要事务都料理好了，工作压力还不到写论文时的十分之一，一切安稳！）"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（安柏&柯莱）"
        },
        {
          "role": "安柏",
          "text": "有了这次的经验，以后我来看望你，就轻车熟路啦。"
        },
        {
          "role": "安柏",
          "text": "当然，我还会再待一段时间，不过最近的工作让你累得不轻，我们就在家里悠悠哉哉休息几天吧？"
        },
        {
          "role": "柯莱",
          "text": "太好了，我觉得很合适！"
        },
        {
          "role": "柯莱",
          "text": "我之前就了不少食材和零食，还有一些有意思的收藏品，就等你来呢！"
        },
        {
          "role": "安柏",
          "text": "（终于闲下来了，余下的几天，都和柯莱独处吧，也不必出门。）"
        },
        {
          "role": "柯莱",
          "text": "（工作都处理好了，安柏应该还能待上一段时间，还有好多话题想聊…）"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（珐露珊）"
        },
        {
          "role": "珐露珊",
          "text": "尽兴了，这次确实尽兴了！"
        },
        {
          "role": "珐露珊",
          "text": "接下来，就去研究一下国外的典籍，列个清单，交给那个热情的小姑娘吧。"
        },
        {
          "role": "'心声",
          "text": "'''（丽莎·敏兹，这位久负盛名的学员，才能究竟如何呢…得从选书的品味上试她一番！）"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（迪希雅&坎蒂丝）"
        },
        {
          "role": "迪希雅",
          "text": "别担心，坎蒂丝，我绝对不会喝多的。"
        },
        {
          "role": "坎蒂丝",
          "text": "我倒是不担心你的酒量，但身体的韧性也很重要，多喝营养充足的茶，可以抵消酒的负面影响。"
        },
        {
          "role": "迪希雅",
          "text": "对的对的，我本来也不是酒鬼嘛！"
        },
        {
          "role": "迪希雅",
          "text": "不过，营养充足的茶，我这里还有很多很多。"
        },
        {
          "role": "迪希雅",
          "text": "不用再送我新的了，谢谢你，也谢谢孩子们！"
        },
        {
          "role": "迪希雅",
          "text": "（为了不让坎蒂丝和孩子们丧气，那罐赤念果荆棘粉，我一定要喝完…）"
        },
        {
          "role": "坎蒂丝",
          "text": "（听说赤念果荆棘粉的口感比较挑人…迪希雅完全没意见，看来很合她的口味了。）"
        }
      ],
      "collapse_ranges": [
        [
          66,
          70
        ],
        [
          71,
          77
        ],
        [
          78,
          81
        ],
        [
          82,
          89
        ]
      ]
    }
  ]
}