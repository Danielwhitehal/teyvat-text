{
  "quest_id": 70011,
  "chapter_num": null,
  "chapter_title": "替丘丘行道！",
  "type": "wq",
  "route": "Hilichurl Justice",
  "stories": [
    {
      "story_id": 70011,
      "title": "替丘丘行道！",
      "description": "与艾拉·马斯克一同前去为被欺负的丘丘人打抱不平，或许能够借此得到新的线索？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与丘丘人对话"
        },
        {
          "role": "丘丘人",
          "text": "Yaya dala! Kundala?"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Mimi nye odomu! Kundala nye!"
        },
        {
          "role": "丘丘人",
          "text": "Nye Odomu? Yoyo mani mi?"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Mimi tomo, mimi plata odomu! Mimi mani ye!"
        },
        {
          "role": "丘丘人",
          "text": "Mani…? Zido mi, mi dada. Nye kundala? Mi plata yeye!"
        },
        {
          "role": "派蒙",
          "text": "哇…这家伙脾气好差！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "马斯克小姐，小心…",
              "dialogues": []
            },
            {
              "text": "需要我们出手吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾拉·马斯克",
          "text": "请别冲动，没关系的。我完全理解了。"
        },
        {
          "role": "派蒙",
          "text": "欸…？"
        },
        {
          "role": "艾拉·马斯克",
          "text": "它想要我们帮忙打败敌人而已，就在地图的…这个位置。"
        },
        {
          "role": "旅行者",
          "text": "原来如此…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "那家伙的位置已经在地图上标好了，我就先回去啦！"
        },
        {
          "role": "丘丘人",
          "text": "Dada, Valo!"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点战斗"
        },
        {
          "type": "subtitle",
          "text": "向丘丘人回复"
        },
        {
          "role": "丘丘人",
          "text": "Yaya dala! Ah, Odomu nye!"
        },
        {
          "role": "丘丘人",
          "text": "Mosi mita!"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Mimi muhe du, du ya Wei zido dala si."
        },
        {
          "role": "丘丘人",
          "text": "Mi mito nye. Mi mito ya zido mito, beru ya!"
        },
        {
          "role": "艾拉·马斯克",
          "text": "它也不知道，不过我们可以找它认识的人问一问。"
        },
        {
          "role": "旅行者",
          "text": "Valo!"
        },
        {
          "role": "丘丘人",
          "text": "Valo, mimi tomo!"
        }
      ]
    }
  ]
}