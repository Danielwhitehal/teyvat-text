  "stories": [
    {
      "story_id": 74012,
      "title": "往事追迹·西",
      "description": "在枫丹科学院附近，似乎有一些奇怪的高塔…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "探索高塔"
        },
        {
          "type": "subtitle",
          "text": "前往附近的营地搜寻线索"
        },
        {
          "type": "subtitle",
          "text": "敲击烹饪用的锅"
        },
        {
          "type": "subtitle",
          "text": "击败愚人众"
        },
        {
          "type": "subtitle",
          "text": "继续探索高塔"
        },
        {
          "type": "subtitle",
          "text": "调查终端"
        },
        {
          "role": "研察终端",
          "text": "（控制台右侧的拉杆旁贴着一张便签，上面用整洁漂亮的字体写着：「千万不要动！」）"
        },
        {
          "role": "旅行者",
          "text": "拉动拉杆。"
        },
        {
          "role": "派蒙",
          "text": "呜哇！旅行者，你在干什么啦！"
        },
        {
          "role": "？？？",
          "text": "你毫不犹豫地拉动了拉杆。\\n下一个瞬间，伴随着宛若雷霆的震耳轰鸣，整座高塔开始剧烈地晃动起来，仿佛天为之崩、地为之裂…"
        },
        {
          "role": "？？？",
          "text": "然后…噗地一声，机器吐出了一叠纸带，正好掉在你的手中。\\n一切重归沉寂。"
        },
        {
          "role": "派蒙",
          "text": "就…就只是这样吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…完全看不懂上面刻了什么东西，但看上去好像挺重要的…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们还是先留着这些纸带吧？说不定之后会在什么地方用上…"
        },
        {
          "role": "派蒙",
          "text": "咦？是和之前在另外那座塔里一样的控制台…"
        },
        {
          "role": "旅行者",
          "text": "拉动拉杆。"
        },
        {
          "role": "？？？",
          "text": "你拉动了拉杆。\\n与之前一样，一阵轰鸣和晃动后，机器吐出了一叠纸带…"
        },
        {
          "role": "派蒙",
          "text": "唔，是和之前一样的纸带…"
        },
        {
          "role": "派蒙",
          "text": "虽然还是完全看不懂，但之后说不定会在什么地方用上，还是先带在身上吧？"
        },
        {
          "role": "派蒙",
          "text": "让我看看…嗯，应该就是这个啦，写着「千万不要动！」的拉杆！"
        },
        {
          "role": "旅行者",
          "text": "拉动拉杆。"
        },
        {
          "role": "？？？",
          "text": "你拉动了拉杆。\\n一阵轰鸣和晃动后，机器吐出了一叠纸带…"
        },
        {
          "role": "派蒙",
          "text": "好耶！这样一来，就拿到「桔桔薄饼站」的监测数据啦！"
        },
        {
          "role": "派蒙",
          "text": "接下来就只剩下「果果软糖站」那边了，旅行者，我们去那边吧！"
        },
        {
          "role": "派蒙",
          "text": "让我看看…嗯，应该就是这个啦，写着「千万不要动！」的拉杆！"
        },
        {
          "role": "旅行者",
          "text": "拉动拉杆。"
        },
        {
          "role": "？？？",
          "text": "你拉动了拉杆。\\n一阵轰鸣和晃动后，机器吐出了一叠纸带…"
        },
        {
          "role": "派蒙",
          "text": "好耶！这样一来，就拿到「果果软糖站」和「桔桔薄饼站」的监测数据啦！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们快点回去找布罗意吧！"
        }
      ]
    }
  ]
}