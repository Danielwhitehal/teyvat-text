{
  "quest_id": 76120,
  "chapter_num": null,
  "chapter_title": "伴月的小画家·其四",
  "type": "wq",
  "route": "The Artist By the Moon's Side (IV)",
  "stories": [
    {
      "story_id": 76120,
      "title": "伴月的小画家·其四",
      "description": "在「银月之庭」，哥伦比娅似乎遇到了一些困难…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同哥伦比娅见面"
        },
        {
          "role": "哥伦比娅",
          "text": "…来，给你，这样我的部分就可以了吧？"
        },
        {
          "role": "派蒙",
          "text": "哇！是画板！这么看来，难道说…！"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，你们来得正好。"
        },
        {
          "role": "梅拉",
          "text": "~！"
        },
        {
          "role": "派蒙",
          "text": "是梅拉大画家！好久不见了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来得正好指的是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "我刚刚带梅拉去了一趟月球。"
        },
        {
          "role": "派蒙",
          "text": "真羡慕你说这话的语气…轻松得就像说去隔壁花园逛了一圈一样。"
        },
        {
          "role": "派蒙",
          "text": "不过，你们去月球做什么呀？去采风吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "对了一半。我们还在月球上，选好了办「画展」的地方，你们记得的吧？"
        },
        {
          "role": "派蒙",
          "text": "哦！记得记得，大画家梅拉的月神主题展！到时候可一定要叫我们去啊！"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，当然。另外，梅拉这孩子，好像能体察到周围一些很细微的变化。"
        },
        {
          "role": "哥伦比娅",
          "text": "它说我从月球上回来之后，很明显变了不少。"
        },
        {
          "role": "哥伦比娅",
          "text": "所以想让我带它去看看，月球上到底有什么特殊的东西。"
        },
        {
          "role": "派蒙",
          "text": "哦！不愧是大艺术家…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以特殊的东西是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "我也不知道，我带梅拉逛了好多地方，它好像都不满意。"
        },
        {
          "role": "哥伦比娅",
          "text": "直到，我带它去了你的飞船附近。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "飞船？",
              "dialogues": []
            },
            {
              "text": "那倒的确有些特殊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "不过我带它走近一些后，却发现它感兴趣的并不是飞船。"
        },
        {
          "role": "派蒙",
          "text": "嗯？那是什么呀？"
        },
        {
          "role": "梅拉",
          "text": "~！！"
        },
        {
          "role": "派蒙",
          "text": "嗯？它在绕着哥伦比娅你飞欸。"
        },
        {
          "role": "哥伦比娅",
          "text": "哈哈，在那时它就这样。"
        },
        {
          "role": "哥伦比娅",
          "text": "我想，它真正感兴趣的，是我看到飞船后的样子。"
        },
        {
          "role": "派蒙",
          "text": "你的…样子？"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，我想起了和旅行者一起来到这里时的情景。"
        },
        {
          "role": "哥伦比娅",
          "text": "我们坐在船上，望着提瓦特。他找到了过去的真相，而我找到了自己的「家」。"
        },
        {
          "role": "哥伦比娅",
          "text": "仅仅只是回忆起这些，我就有了一种安心，或说，幸福的感觉。"
        },
        {
          "role": "梅拉",
          "text": "~！"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，你说得没错，这是我以前基本不曾有过的感受。"
        },
        {
          "role": "哥伦比娅",
          "text": "所以，我就把我们的故事，包括和你上月球后发生的事告诉了梅拉。"
        },
        {
          "role": "哥伦比娅",
          "text": "它听完后看起来很满意，像是找到了自己想要的灵感。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样，那现在就是大画家梅拉动笔的阶段了吧？"
        },
        {
          "role": "派蒙",
          "text": "你们当时没带我上去，我也很好奇梅拉到底会画出怎样的风景呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这次需要什么来做颜料？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "这次的有些特殊。"
        },
        {
          "role": "梅拉",
          "text": "~！"
        },
        {
          "role": "哥伦比娅",
          "text": "梅拉说，它想要只属于我们自己的颜料。"
        },
        {
          "role": "派蒙",
          "text": "欸？这是什么意思？"
        },
        {
          "role": "哥伦比娅",
          "text": "大概就是…当你看到这个东西的时候，就会想起这段旅程，心中浮现起它带给你的收获与欢喜。"
        },
        {
          "role": "哥伦比娅",
          "text": "不用担心，梅拉只是想看看那东西，感受一下而已。不会用这么珍贵的东西来做颜料的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哥伦比娅给了什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "月球的土壤，还有你们送给我的祈月之夜贺卡。"
        },
        {
          "role": "派蒙",
          "text": "哦~总之就是能代表这次冒险的东西吧？那就交给旅行者来选了！"
        },
        {
          "type": "subtitle",
          "text": "将代表这段旅程的东西交给月灵"
        },
        {
          "role": "旅行者",
          "text": "（代表这段旅程的颜色…）"
        },
        {
          "type": "subtitle",
          "text": "交付哥伦比娅赠予你的祈月之花",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "观看月灵的画作"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，不错的选择。"
        },
        {
          "role": "梅拉",
          "text": "~！"
        },
        {
          "role": "派蒙",
          "text": "它看起来很满意呢，已经开始画起来了欸！"
        },
        {
          "role": "派蒙",
          "text": "这么一想，梅拉的这些画，简直囊括了哥伦比娅从诞生到现在的故事呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "故事还不会结束。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！我也还没看够这位大画家的作品呢。"
        },
        {
          "role": "梅拉",
          "text": "！！"
        },
        {
          "role": "派蒙",
          "text": "哦！画好了吗？你的速度真是一如既往地快呢。"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "伴月纪闻-伴月的小画家·其四-CG1-空.png|center|1100px]]"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "伴月纪闻-伴月的小画家·其四-CG1-荧.png|center|1100px]]"
        },
        {
          "role": "派蒙",
          "text": "我看看…哇！好漂亮！"
        },
        {
          "role": "派蒙",
          "text": "原来在月球上看提瓦特，是这么美的吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "哈…我现在能明白，为什么梅拉会说我变得不同了。"
        },
        {
          "role": "派蒙",
          "text": "嗯？为什么？"
        },
        {
          "role": "哥伦比娅",
          "text": "看到这幅画后，我想起来了。"
        },
        {
          "role": "哥伦比娅",
          "text": "当时的我坐在月球上看着提瓦特，心里在想——以前的我，一直都在寻找属于自己的「家」。"
        },
        {
          "role": "哥伦比娅",
          "text": "但现在，我忽然有了两个「家」。而且它们都如此美丽。"
        },
        {
          "role": "哥伦比娅",
          "text": "那时我明白了，或许「家」是你珍视的东西、珍视的「家人」和朋友们所在的地方。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不错的感想。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "谢谢你，这之后，我想经常带月灵们去月亮上玩。"
        },
        {
          "role": "哥伦比娅",
          "text": "也欢迎你们，以后一起去我的「另一个家」看看。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（哥伦比娅）"
        },
        {
          "role": "梅拉",
          "text": "！！"
        },
        {
          "role": "哥伦比娅",
          "text": "想做月灵们的导游？好呀，这一行会很热闹吧。"
        }
      ],
      "collapse_ranges": [
        [
          73,
          75
        ]
      ]
    }
  ]
}