  "chapter_title": "桌上冒险家",
  "type": "wq",
  "route": "Tabletop Adventurer",
  "stories": [
    {
      "story_id": 74505,
      "title": "桌上冒险家",
      "description": "钟表店店员阿尔芒负责管理他们的玩具，去问问如何体验吧…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与店员阿尔芒交谈"
        },
        {
          "role": "阿尔芒",
          "text": "两…两…两位好，我是…是阿…阿…阿尔芒…"
        },
        {
          "role": "派蒙",
          "text": "你看起来好像有点紧张？"
        },
        {
          "role": "阿尔芒",
          "text": "对…对…对不起！人多…我…我…说话就…"
        },
        {
          "role": "派蒙",
          "text": "没关系没关系！你不用着急，我们只是来体验玩具的啦！"
        },
        {
          "role": "阿尔芒",
          "text": "好…我准…准…准备了一份说…说明！给…给你们…"
        },
        {
          "role": "派蒙",
          "text": "阿尔芒你真体贴！一会我们会认真看的。"
        },
        {
          "role": "阿尔芒",
          "text": "不…不…看也没事，这个很…很简单…又…又好玩，试…试…试试吧？"
        },
        {
          "role": "旅行者",
          "text": "谢谢，我一会试试。"
        },
        {
          "role": "阿尔芒",
          "text": "祝…祝…祝两位…玩开心。"
        }
      ]
    }
  ]
}