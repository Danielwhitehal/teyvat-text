{
  "quest_id": 10060,
  "chapter_num": "",
  "chapter_title": "许伯利翁哀歌",
  "type": "wq",
  "route": "Hyperion's Dirge",
  "stories": [
    {
      "story_id": 72241,
      "title": "许伯利翁哀歌",
      "description": "按名为阿倍良久的残魂的说法，要让他分于三处的魂魄归回归主体，才可获得安宁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆与残魂对话"
        },
        {
          "role": "阿倍良久",
          "text": "吾乃…"
        },
        {
          "role": "阿倍良久",
          "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！"
        },
        {
          "role": "派蒙",
          "text": "我、我是派蒙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在这里自我介绍？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "在对方报上名字的时候，你也要报上名字……"
                },
                {
                  "role": "派蒙",
                  "text": "据说是有这样的礼节的。"
                },
                {
                  "role": "阿倍良久",
                  "text": "无妨。汝等远道而来，吾以此狼狈姿态，亦无法进行接待，也是失礼之至。"
                },
                {
                  "role": "派蒙",
                  "text": "没有关系，旅行者和我也不会介意的。"
                }
              ]
            },
            {
              "text": "吾乃…",
              "dialogues": [
                {
                  "role": "阿倍良久",
                  "text": "……是么，竟是来自异乡的旅客啊。"
                },
                {
                  "role": "阿倍良久",
                  "text": "汝远道而来，吾以此狼狈姿态，亦无法进行接待。"
                },
                {
                  "role": "派蒙",
                  "text": "没关系的。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不过，这位残魂先生为什么会留在这里呢？"
        },
        {
          "role": "阿倍良久",
          "text": "吾…吾乃赫利俄斯的建造者，此处为…吾殒命之处。"
        },
        {
          "role": "阿倍良久",
          "text": "在黑暗冰冷之所，昏昏睡去便再无法醒来…吾怎可这样死去，吾可是，赫利俄斯之建造者！"
        },
        {
          "role": "派蒙",
          "text": "赫利俄斯的建造者？"
        },
        {
          "role": "派蒙",
          "text": "赫利俄斯是什么呀？"
        },
        {
          "role": "阿倍良久",
          "text": "啊…是了，赫利俄斯只是建造时吾私下的称谓。"
        },
        {
          "role": "阿倍良久",
          "text": "虽然不知汝等是否知晓，不过，白夜国民所熟知的名字是…"
        },
        {
          "role": "阿倍良久",
          "text": "大日御舆。"
        },
        {
          "role": "阿倍良久",
          "text": "赫利俄斯即大日御舆，运载「许伯利翁（白夜之光）」的太阳之车。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大日御舆的建造者？",
              "dialogues": []
            },
            {
              "text": "就是你？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿倍良久",
          "text": "正是吾。"
        },
        {
          "role": "阿倍良久",
          "text": "异乡的旅者啊…吾虽建造大日御舆，却被人幽禁，幽禁在了大日御舆之上。"
        },
        {
          "role": "阿倍良久",
          "text": "死去之后，魂魄离散于白夜国各地，甚至记忆也有所散佚。"
        },
        {
          "role": "阿倍良久",
          "text": "吾记得有很重要的东西…有很重要的东西在大日御舆之上…"
        },
        {
          "role": "阿倍良久",
          "text": "但吾忘记了，异乡的旅者啊，拜托汝…取回我被供奉于三处的衣、冠与骸骨。"
        },
        {
          "role": "阿倍良久",
          "text": "分别在狭间之街、灵庙之前与蛇心之地。"
        },
        {
          "role": "阿倍良久",
          "text": "将之供奉于三座祭台之上…这样，吾魂魄归一，即可打开通向大日御舆之上的道路…"
        },
        {
          "role": "阿倍良久",
          "text": "通往大日御舆之上，被隐藏于常夜帷幕的幽闭之间…"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "阿倍良久",
          "text": "啊…烦请汝取回位于狭间之街，灵庙之前与蛇心之地三处的供奉。这样，吾魂魄归一，即可打开大日御舆之上的道路…"
        },
        {
          "type": "subtitle",
          "text": "前往狭间之街，与残魂对话"
        },
        {
          "role": "派蒙",
          "text": "有、有什么东西出来了…"
        },
        {
          "role": "派蒙",
          "text": "看上去好像也是一个残影。"
        },
        {
          "role": "阿倍良久",
          "text": "吾乃…"
        },
        {
          "role": "阿倍良久",
          "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！"
        },
        {
          "role": "派蒙",
          "text": "这句话我听懂了。"
        },
        {
          "role": "派蒙",
          "text": "这句话的意思就是——"
        },
        {
          "role": "派蒙",
          "text": "他说自己的名字是赫利俄斯。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "根本就没懂吧！",
              "dialogues": []
            },
            {
              "text": "他的名字叫阿倍良久。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是这样吗……"
        },
        {
          "role": "派蒙",
          "text": "他的名字叫阿倍良久…真是奇怪的名字。"
        },
        {
          "role": "派蒙",
          "text": "不过，既然他的名字是阿倍良久，那赫利俄斯又是什么呢？"
        },
        {
          "role": "阿倍良久",
          "text": "赫利俄斯！赫利俄斯！！"
        },
        {
          "role": "阿倍良久",
          "text": "此乃吾亲手所造…赫利俄斯造成之日，万丈光芒自高天笼罩，如是众人不受龙兽侵扰。"
        },
        {
          "role": "阿倍良久",
          "text": "啊啊，正当时，诸民仰视，热泪盈眶，扬臂欢呼，难掩喜悦激动之情…可是现在怎么…"
        },
        {
          "role": "阿倍良久",
          "text": "不对，吾，吾为何在此…为何…为何吾魂迷梦土，不得安宁。"
        },
        {
          "role": "旅行者",
          "text": "派蒙听懂了吗？"
        },
        {
          "role": "派蒙",
          "text": "我懂了。"
        },
        {
          "role": "派蒙",
          "text": "这一定是个…精神不太正常的残魂。"
        },
        {
          "role": "阿倍良久",
          "text": "吾想起来了…吾魂魄不全，等吾魂归一处，即可重获安宁。"
        },
        {
          "role": "阿倍良久",
          "text": "转机就在汝身，吾且与汝言说…"
        },
        {
          "role": "派蒙",
          "text": "呃，我闻到了麻烦事的气息…"
        },
        {
          "role": "阿倍良久",
          "text": "此处本应供奉吾一部分骨殖，但是早已朽坏…算是吾托命于汝…"
        },
        {
          "role": "阿倍良久",
          "text": "将这些寄托吾念的供奉品拿去…不过，周围有困守吾魂的怪物，一旦吾魂魄寄寓之物离开…便会蜂拥而上。"
        },
        {
          "role": "阿倍良久",
          "text": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。"
        },
        {
          "type": "subtitle",
          "text": "开启残魂的试炼"
        },
        {
          "role": "阿倍良久",
          "text": "旅者啊，汝准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": [
                {
                  "role": "阿倍良久",
                  "text": "那就祝汝……武运昌隆。"
                }
              ]
            },
            {
              "text": "不，还需要准备一下。",
              "dialogues": [
                {
                  "role": "阿倍良久",
                  "text": "那就静候汝之佳音了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "从残魂处取得供奉之物"
        },
        {
          "role": "阿倍良久",
          "text": "看来汝等的实力完全足以…护送供奉之物…"
        },
        {
          "role": "阿倍良久",
          "text": "这样，吾也能够放心了…一定要将之送到，如此才能…"
        },
        {
          "role": "派蒙",
          "text": "如此才能什么呢？"
        },
        {
          "role": "阿倍良久",
          "text": "如此才能…如此才能…"
        },
        {
          "role": "派蒙",
          "text": "完了，完全是一副坏掉了的样子。"
        },
        {
          "role": "派蒙",
          "text": "不过他说的供奉品，就是这个吧…看上去也有点破破烂烂了。"
        },


        {
          "type": "subtitle",
          "text": "前往长夜灵庙，与残魂对话"
        },
        {
          "role": "派蒙",
          "text": "好像出现了一个残魂……"
        },
        {
          "role": "阿倍良久",
          "text": "吾乃…"
        },
        {
          "role": "阿倍良久",
          "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！"
        },
        {
          "role": "阿倍良久",
          "text": "吾怎么可能被你们这些妄语谗言所击倒，吾怎么会被你们操纵的稚童幽禁！"
        },
        {
          "role": "阿倍良久",
          "text": "吾…不对，吾…吾在幽禁之所度过了无尽岁月，此时已是…生后之身？"
        },
        {
          "role": "派蒙",
          "text": "生后之身？是说自己已经死去的意思吗？"
        },
        {
          "role": "派蒙",
          "text": "能够意识到这点的残魂很少见啊。"
        },
        {
          "role": "阿倍良久",
          "text": "说来惭愧，但为何而死，吾已回想不出…"
        },
        {
          "role": "阿倍良久",
          "text": "只是记忆之中，吾被一个孩子下令关押至死。"
        },
        {
          "role": "派蒙",
          "text": "一个孩子？"
        },
        {
          "role": "阿倍良久",
          "text": "正是，不过，时至今日，提起那个孩子吾也不觉得怨恨，只是觉得可怜。"
        },
        {
          "role": "阿倍良久",
          "text": "有错的，并不是他，有错的是将他视为掌中傀儡的…算了，不提也罢。"
        },
        {
          "role": "阿倍良久",
          "text": "那之后，吾就被幽禁…"
        },
        {
          "role": "阿倍良久",
          "text": "幽禁于一处…"
        },
        {
          "role": "派蒙",
          "text": "一处？"
        },
        {
          "role": "阿倍良久",
          "text": "一处很高的地方…"
        },
        {
          "role": "阿倍良久",
          "text": "虽然很高，但该处却黯淡无光，冷若冰窟。"
        },
        {
          "role": "阿倍良久",
          "text": "…咦，奇怪，为何呢？"
        },
        {
          "role": "阿倍良久",
          "text": "为何吾会觉得，高处本应是让人温暖舒畅的呢？"
        },
        {
          "role": "阿倍良久",
          "text": "为何…为何吾什么都想不起来？"
        },
        {
          "role": "派蒙",
          "text": "难道是因为肚子饿了？"
        },
        {
          "role": "派蒙",
          "text": "我肚子饿的时候，别说动脑想什么了，连话都说不顺。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我觉得不是因为这个…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "肯定就是嘛！你看他也话都说不清了。"
                }
              ]
            },
            {
              "text": "我这里有应急食…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "啊，旅行者，你可以找找看，万一贡品里面有能吃的东西呢？"
        },
        {
          "role": "阿倍良久",
          "text": "是了！贡品！"
        },
        {
          "role": "派蒙",
          "text": "怎么样，是想吃贡品了吗？"
        },
        {
          "role": "阿倍良久",
          "text": "不，吾只是想起了…"
        },
        {
          "role": "阿倍良久",
          "text": "吾在幽禁至死后，因铸造赫利俄斯之功，残躯与衣冠在各处享有供奉。"
        },
        {
          "role": "阿倍良久",
          "text": "也是因此而魂魄分离，致使灵魂难安。"
        },
        {
          "role": "阿倍良久",
          "text": "此处本应供奉吾之圣冠，但是早已朽坏…恐怕这也是为何吾念头滞涩的原因。"
        },
        {
          "role": "阿倍良久",
          "text": "长此以往，恐怕连保持现在的状态都相当困难…"
        },
        {
          "role": "阿倍良久",
          "text": "但好在这些供奉品——这些贡品能代替残躯与衣冠，承载吾一丝念想。"
        },
        {
          "role": "阿倍良久",
          "text": "劳烦汝将之取走。"
        },
        {
          "role": "阿倍良久",
          "text": "不过供奉之路上有多重险阻，虽有冒犯之嫌，但也希望汝能接受一次考验…"
        },
        {
          "role": "派蒙",
          "text": "考验？什么考验？"
        },
        {
          "role": "阿倍良久",
          "text": "就请汝击败周围这些困守吾残魂的怪物吧…"
        },
        {
          "role": "阿倍良久",
          "text": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。"
        },
        {
          "type": "subtitle",
          "text": "开启残魂的试炼"
        },
        {
          "role": "阿倍良久",
          "text": "旅者啊，汝准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": [
                {
                  "role": "阿倍良久",
                  "text": "那就祝汝……武运昌隆。"
                }
              ]
            },
            {
              "text": "不，还需要准备一下。",
              "dialogues": [
                {
                  "role": "阿倍良久",
                  "text": "那就静候汝之佳音了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "从残魂处取得供奉之物"
        },
        {
          "role": "阿倍良久",
          "text": "啊…若是当时白夜国有如汝这般的勇士，也不会…"
        },
        {
          "role": "阿倍良久",
          "text": "唉，此事若成，那吾也可了却心愿。"
        },
        {
          "role": "阿倍良久",
          "text": "一定要、一定要将这些寄托吾念的贡品拿去供奉，供奉在我幽禁之所。如此才能…"
        },
        {
          "role": "派蒙",
          "text": "如此才能什么？"
        },
        {
          "role": "阿倍良久",
          "text": "如此才能…如此才能…"
        },
        {
          "role": "派蒙",
          "text": "唔，这位残魂先生看上去失魂落魄，说什么都没反应了…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，那就先带上贡品吧。"
        },
        {
          "role": "派蒙",
          "text": "不过残魂先生被幽禁在的高处，到底是什么地方呢？"
        },



        {
          "type": "subtitle",
          "text": "前往蛇心之地，与残魂对话"
        },
        {
          "role": "阿倍良久",
          "text": "吾乃…"
        },
        {
          "role": "阿倍良久",
          "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！"
        },
        {
          "role": "派蒙",
          "text": "嗯，赫利俄斯？"
        },
        {
          "role": "派蒙",
          "text": "赫利俄斯是什么很了不起的东西吗？"
        },
        {
          "role": "阿倍良久",
          "text": "当然！吾当时主持建造赫利俄斯，举全国之力，以此抵御深海龙嗣。"
        },
        {
          "role": "阿倍良久",
          "text": "是整个白夜国，除吾之外，再无第二人能完成的伟业！"
        },
        {
          "role": "派蒙",
          "text": "啊，听上去真是了不起。"
        },
        {
          "role": "派蒙",
          "text": "可是这么了不起的大人物，为什么会被封在这里呢？"
        },
        {
          "role": "阿倍良久",
          "text": "吾…吾是被人背叛…"
        },
        {
          "role": "阿倍良久",
          "text": "当初天国塌落于无底深渊之下，诸民受龙嗣所害，是吾，吾掌持建造赫利俄斯，以此救众生于倒悬。"
        },
        {
          "role": "阿倍良久",
          "text": "可是那群贪鄙小人！一旦性命无虞，就行欺上瞒下之事…最后竟还，推举稚童作国首。可笑！"
        },
        {
          "role": "阿倍良久",
          "text": "就连吾也被他们陷害，身死囹圄之中！"
        },
        {
          "role": "阿倍良久",
          "text": "可恶！可恶！"
        },
        {
          "role": "阿倍良久",
          "text": "对了，汝。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是你。"
                }
              ]
            },
            {
              "text": "派蒙，在叫你！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸，他明明就在看着你嘛。"
                },
                {
                  "role": "派蒙",
                  "text": "（而且眼神还相当热切的样子。）"
                }
              ]
            }
          ]
        },
        {
          "role": "阿倍良久",
          "text": "就是汝！"
        },
        {
          "role": "阿倍良久",
          "text": "原本吾之圣服被放置于此，只可惜年月之久，仅余残丝败缕，已难以作为凭依。"
        },
        {
          "role": "阿倍良久",
          "text": "只要汝能通过考验，吾就将寄托意念的供奉之物托付于汝。"
        },
        {
          "role": "阿倍良久",
          "text": "希望汝能…成功通过…"
        },
        {
          "role": "阿倍良久",
          "text": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。"
        },
        {
          "type": "subtitle",
          "text": "开启残魂的试炼"
        },
        {
          "role": "阿倍良久",
          "text": "旅者啊，汝准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": [
                {
                  "role": "阿倍良久",
                  "text": "那就祝汝……武运昌隆。"
                }
              ]
            },
            {
              "text": "不，还需要准备一下。",
              "dialogues": [
                {
                  "role": "阿倍良久",
                  "text": "那就静候汝之佳音了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "从残魂处取得供奉之物"
        },
        {
          "role": "阿倍良久",
          "text": "好、好啊！如果是汝一定能做到…"
        },
        {
          "role": "阿倍良久",
          "text": "吾委命于汝，将、将这些供奉之物…这些供奉之物…一定要…"
        },
        {
          "role": "阿倍良久",
          "text": "一定要将之取走，拿到…"
        },
        {
          "role": "阿倍良久",
          "text": "拿到…"
        },
        {
          "role": "派蒙",
          "text": "怎么回事？"
        },
        {
          "role": "派蒙",
          "text": "残魂先生的声音怎么越来越模糊了。"
        },
        {
          "role": "阿倍良久",
          "text": "拿到…供奉之处…众魂归一，如此才能…"
        },
        {
          "role": "派蒙",
          "text": "残魂先生？"
        },
        {
          "role": "阿倍良久",
          "text": "如此才能…如此才能…"
        },
        {
          "role": "派蒙",
          "text": "如此才能什么呀？"
        },
        {
          "role": "阿倍良久",
          "text": "如此才能…"
        },
        {
          "role": "派蒙",
          "text": "唔，不清不楚的，不过刚才听残魂先生的意思，好像是要把这些供奉品拿到什么地方去。"
        },
        {
          "role": "派蒙",
          "text": "这供奉品放在这里这么久，不知道里面有没有吃的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你别偷吃哦…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我、我也不是什么东西都吃的！"
        },
        {
          "role": "派蒙",
          "text": "好了，旅行者，收下供奉之物吧。"
        },


        {
          "type": "subtitle",
          "text": "◆供奉阿倍良久残魂寄寓之物（3/3）"
        },
        {
          "type": "subtitle",
          "text": "◆到达「大日御舆」顶端"
        },
        {
          "role": "派蒙",
          "text": "供奉完成了…"
        },
        {
          "role": "派蒙",
          "text": "之前听残魂先生的说法，献祭能够打开大日御舆之上的道路…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，不如我们快上去看一下吧！"
        },
        {
          "type": "subtitle",
          "text": "◆与阿倍良久对话"
        },
        {
          "role": "阿倍良久",
          "text": "啊啊…异乡的旅者，是汝啊。"
        },
        {
          "role": "阿倍良久",
          "text": "托汝之福，吾现在魂魄完全，已回想起了一切，真是不可思议。"
        },
        {
          "role": "阿倍良久",
          "text": "可能汝已知晓，长久以前，白夜国仅有一片黑暗，生活在此处的诸民深受深海龙嗣侵扰之害。"
        },
        {
          "role": "阿倍良久",
          "text": "那时，由吾主持建造大日御舆，从此白夜国才有了昼夜之替，也有了「白夜」这一国名。"
        },
        {
          "role": "阿倍良久",
          "text": "寓示：「自大日御舆建成之后，虽此地只有常世之夜，亦可因分黑白。」"
        },
        {
          "role": "阿倍良久",
          "text": "真是令人汗颜，在离魂归位之前，竟连大日御舆建成之日，众人云集景从之时都已忘得一干二净。"
        },
        {
          "role": "阿倍良久",
          "text": "可悲啊，那本来应是吾铭记于心之景。"
        },
        {
          "role": "阿倍良久",
          "text": "只可惜…"
        },
        {
          "role": "派蒙",
          "text": "可惜？"
        },
        {
          "role": "阿倍良久",
          "text": "大日御舆建成，不熟悉光亮的龙嗣立刻溃败，白夜之民终于得以安养生息。"
        },
        {
          "role": "阿倍良久",
          "text": "只是一旦安定下来…人心难测，鸭胗难剥，谁也不知他人会生出何等丑恶念头。"
        },
        {
          "role": "阿倍良久",
          "text": "异乡的旅者啊，贪婪小人一有可乘之机，就想攫取…比应得之物多上太多的，财富，权力！"
        },
        {
          "role": "阿倍良久",
          "text": "这些人利用民众，开始推行大日御舆崇拜。将人心寄托于虚妄死物已是愚昧至极。"
        },
        {
          "role": "阿倍良久",
          "text": "到了最后…甚至推举「太阳之子（法厄同）」以统治白夜之国。"
        },
        {
          "role": "旅行者",
          "text": "太阳之子？"
        },
        {
          "role": "阿倍良久",
          "text": "正是，每一任，都会有一位稚童被选作太阳之子。"
        },
        {
          "role": "阿倍良久",
          "text": "理所当然，这些孩子尚且懵懂，根本不可能担任一国之君，如何行事，不过是一具棚头傀儡，顺从其背后那些龌龊小人们的意见。"
        },
        {
          "role": "阿倍良久",
          "text": "吾想要反对，却被他们指使的太阳之子判下谋逆大罪，终生监禁于此…"
        },
        {
          "role": "派蒙",
          "text": "啊，太阳之子…"
        },
        {
          "role": "派蒙",
          "text": "那岂不是总有一天，他会知道自己被人摆布…"
        },
        {
          "role": "阿倍良久",
          "text": "故，凡太阳之子，无人能长大。一旦长大，就不再那么容易被龌龊小人们操纵了。"
        },
        {
          "role": "阿倍良久",
          "text": "「太阳之子，诞辰御祝，至天马之架席，共烈日之飨…」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道说…",
              "dialogues": []
            },
            {
              "text": "在某个生日…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿倍良久",
          "text": "嗯，他们全都被送至了大日御舆内部，于诞生祭礼，盛装打扮，兴高采烈之时…"
        },
        {
          "role": "阿倍良久",
          "text": "…藏于此处的物件，就与他们有关。"
        },
        {
          "role": "阿倍良久",
          "text": "这是证明太阳之子正身的御辔，吾藏于此，想以后将之递出，可让世人警醒，只不过，时至今日已毫无意义了。"
        },
        {
          "role": "阿倍良久",
          "text": "异乡的旅者啊，那些孩子，这个国家，是吾无法保护完全的事物。"
        },
        {
          "role": "阿倍良久",
          "text": "吾乃…"
        },
        {
          "role": "阿倍良久",
          "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！"
        },
        {
          "role": "阿倍良久",
          "text": "吾主持建造大日御舆，于常夜之中高悬明亮之镜，已自以为天纵之才。"
        },
        {
          "role": "阿倍良久",
          "text": "吾有如此才能，如此才能啊！"
        },
        {
          "role": "阿倍良久",
          "text": "吾本以为可用大日御舆涤荡黑暗，但谁曾想大日御舆之上，人心之欲壑难填贪婪无餍，才是足以覆过一切的阴晦永夜。"
        },
        {
          "role": "阿倍良久",
          "text": "异乡的旅客，吾现在将此御辔交至汝之手中。"
        },
        {
          "role": "阿倍良久",
          "text": "这枚「神舆之辔」就是这段可笑至极的荒唐历史的见证…"
        },
        {
          "role": "阿倍良久",
          "text": "请务必好好留存…不，就随汝喜好处置吧。"
        },
        {
          "role": "旅行者",
          "text": "过于贵重了…"
        },
        {
          "role": "阿倍良久",
          "text": "此物本就已无甚意义，今日能魂魄归一，将此物交到汝手上，时也命也，对此物来说，或也算是一类善终了。"
        },
        {
          "role": "阿倍良久",
          "text": "如此才能…如此才能啊…"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "阿倍良久",
          "text": "如此才能，如此才能…又有何用？"
        }
      ],
      "collapse_ranges": [
        [
          23,
          24
        ],
        [
          195,
          196
        ]
      ]
    }


  ]
}