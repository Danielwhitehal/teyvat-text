{
  "quest_id": 76218,
  "chapter_num": null,
  "chapter_title": "淑女之邀",
  "type": "wq",
  "route": "A Lady's Invitation",
  "stories": [
    {
      "story_id": 76218,
      "title": "淑女之邀",
      "description": "你们收到了一封来自桑多涅的茶会邀请函…<br>提示：{{颜色|描述|推荐完成}}剧情「映夏！归乡？千灵节！」，以获得最佳体验。",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "好像是邀请我们去参加茶会呢！嘿嘿，你别说我还挺期待的。一起去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "查看邀请函"
        },
        {
          "type": "subtitle",
          "text": "邀请函"
        },
        {
          "type": "subtitle",
          "text": "致旅行者",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "近来可好？我最近正好有空，想邀请你和派蒙来参加我的茶会。茶和点心都由我来准备就好，来聊聊天吧。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往约定地点参加桑多涅的茶会"
        },
        {
          "role": "「木偶」",
          "text": "嗯？你们来了。"
        },
        {
          "role": "派蒙",
          "text": "你好呀！桑多涅。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你的邀请。",
              "dialogues": []
            },
            {
              "text": "希望没让你等太久。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "咦？你信里不是说要开茶会吗？怎么这里什么都没有，你该不会没准备好茶点吧？"
        },
        {
          "role": "「木偶」",
          "text": "哈，笑话。你还真是小看我了。"
        },
        {
          "role": "派蒙",
          "text": "哇！这…这桌子是怎么突然变出来的？！"
        },
        {
          "role": "「木偶」",
          "text": "哼哼，厉害吧？这是我新研制的便携式茶桌。"
        },
        {
          "role": "「木偶」",
          "text": "它不仅方便携带、易于收纳，甚至还加装了和法洁欧一样的悬浮装置。"
        },
        {
          "role": "「木偶」",
          "text": "更厉害的是…呃，算了，我就不自夸了，搞得像我在推销一样。你们自己感受吧。"
        },
        {
          "role": "「木偶」",
          "text": "来，这是我准备的茶和点心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我不客气了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…！真好吃！你手艺果然很好！"
        },
        {
          "role": "「木偶」",
          "text": "那是当然。"
        },
        {
          "role": "派蒙",
          "text": "不过，你怎么会想到要做这么一个装置呀？"
        },
        {
          "role": "「木偶」",
          "text": "当然是为了和朋友们在任何地方都能度过一段愉快的茶会时光啊。"
        },
        {
          "role": "「木偶」",
          "text": "之前我也说过。留住珍贵之物的方法并不只有坚守你已有的东西。"
        },
        {
          "role": "「木偶」",
          "text": "现在的我，变得想多出去走，多去见见朋友们了。"
        },
        {
          "role": "「木偶」",
          "text": "但让收到邀请的人准备茶点收拾茶桌，未免太不符合淑女的礼仪。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我倒是觉得朋友们不会在意啦。"
        },
        {
          "role": "「木偶」",
          "text": "我在意。而且这种简单的发明对我来说也不费力。"
        },
        {
          "role": "「木偶」",
          "text": "看你们这么喜欢，干脆就送你们一个好了。"
        },
        {
          "role": "派蒙",
          "text": "欸？！这怎么行？"
        },
        {
          "role": "「木偶」",
          "text": "没什么不行的。说了我很会做这些东西。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就谢谢了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「木偶」",
          "text": "别客气，你们千灵节的时候也帮了我不少忙，就当是淑女的回礼吧。"
        }
      ],
      "collapse_ranges": [
        [
          2,
          4
        ]
      ]
    }
  ]
}