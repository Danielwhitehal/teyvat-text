{
  "quest_id": 71020,
  "chapter_num": null,
  "chapter_title": "工作迫近",
  "type": "wq",
  "route": "Pressing Deadlines",
  "stories": [
    {
      "story_id": 71020,
      "title": "工作迫近",
      "description": "因为越来越多的工作，小昭忙得抽不开身，她正在寻找一位帮手…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与小昭对话"
        },
        {
          "type": "subtitle",
          "text": "将单据带给江舟"
        },
        {
          "role": "江舟",
          "text": "嗯…好吧，最后给我一点时间，我最后补全一些小问题。"
        },
        {
          "role": "江舟",
          "text": "等我补全了之后，我就把策划案总结一下交上去了。"
        },
        {
          "role": "江舟",
          "text": "希望璃月港的大家会喜欢这一届海灯节…"
        },
        {
          "role": "江舟",
          "text": "嗯…不行，璃月港的大家对于海灯节可是很期待的。"
        },
        {
          "role": "江舟",
          "text": "如果仅仅是和上一届海灯节一样的话，大家是不会满意的。"
        },
        {
          "role": "江舟",
          "text": "你别说了，我还要再改改，一定要拿出最完美的方案…"
        },
        {
          "type": "subtitle",
          "text": "将单据带给小安"
        },
        {
          "role": "小安",
          "text": "唉，我算了一下，实在不行…我再加把劲。"
        },
        {
          "role": "小安",
          "text": "拼几个晚上不睡觉，把港口船只情况的统计表给统计出来交上去。"
        },
        {
          "role": "小安",
          "text": "毕竟这张表我开始做的时间最早，如果最晚交的话，也确实有点不太像话…"
        },
        {
          "role": "小安",
          "text": "唉，你也看到了，我是真的忙不过来了。"
        },
        {
          "role": "小安",
          "text": "各种工作都搅在一起，而且每个还都差不多一样重要。"
        },
        {
          "role": "小安",
          "text": "没办法，这张港口船只情况统计表，只能再延一段时间了…"
        },
        {
          "type": "subtitle",
          "text": "向小昭回报"
        },
        {
          "role": "小昭",
          "text": "你回来了，实在太谢谢你了，小安和江舟刚刚都送了口信过来。"
        },
        {
          "role": "小昭",
          "text": "他们说，这次一定能够按时上交。"
        },
        {
          "role": "小昭",
          "text": "太好了…我总算可以睡个好觉了…"
        },
        {
          "role": "小昭",
          "text": "这些请你收下，就算是谢礼吧，实在是帮了大忙了。"
        },
        {
          "role": "小昭",
          "text": "有了这次的经验，他们以后应该不会重复一样的错误了吧…"
        },
        {
          "role": "小昭",
          "text": "什么？他们还不能按时上交？"
        },
        {
          "role": "小昭",
          "text": "这还要延期多久，这工作还做不做了？"
        },
        {
          "role": "小昭",
          "text": "没办法，我得找个时间自己去催催他们了…"
        },
        {
          "role": "小昭",
          "text": "对了，这些请你收下吧，谢谢你帮我忙。"
        },
        {
          "role": "小昭",
          "text": "你回来了，刚才小安和江舟送了口信过来。"
        },
        {
          "role": "小昭",
          "text": "虽然只有一个人答应按时上交，但是…能交一个是一个吧。"
        },
        {
          "role": "小昭",
          "text": "至于另外一个人，只有我自己去催催了…"
        },
        {
          "role": "小昭",
          "text": "对了，谢谢你帮忙，请收下这些吧，算是谢礼了。"
        },
        {
          "role": "小安",
          "text": "这下可麻烦了…"
        },
        {
          "role": "旅行者",
          "text": "小昭让我送这个给你…"
        },
        {
          "role": "小安",
          "text": "啊？港口里的船只情况统计表。"
        },
        {
          "role": "小安",
          "text": "这个，怎么说呢，虽然我其实最开始就准备好了…"
        },
        {
          "role": "小安",
          "text": "但是还有新入货物统计表、各种船只报上来的船员情况、出入港口的外国人…"
        },
        {
          "role": "小安",
          "text": "要统计的表实在是太多了，我做了这个，又做那个，压根忙不过来了。"
        },
        {
          "role": "旅行者",
          "text": "多招点人来帮忙…"
        },
        {
          "role": "小安",
          "text": "我也想啊，但是临时怎么可能招来马上就能帮忙的人…"
        },
        {
          "role": "旅行者",
          "text": "先把小昭要的表统计了。"
        },
        {
          "role": "小安",
          "text": "哈哈哈，我今天记起来的时候已经来不及了…"
        },
        {
          "role": "旅行者",
          "text": "先统计最重要的吧。"
        },
        {
          "role": "小安",
          "text": "这些表在我看来，呃…都差不多重要。"
        },
        {
          "role": "旅行者",
          "text": "时间不够了…"
        },
        {
          "role": "小安",
          "text": "我知道啊，所以我在努力，看能不能把所有的表格全部统计完毕。"
        },
        {
          "role": "旅行者",
          "text": "不如直接去说明…"
        },
        {
          "role": "小安",
          "text": "有那个时间，我不如再多努力统计好一些表格…"
        },
        {
          "role": "旅行者",
          "text": "我来帮你。"
        },
        {
          "role": "小安",
          "text": "谢谢你的好意，但是统计表格这个活，不是熟手的话只会帮倒忙。"
        },
        {
          "role": "旅行者",
          "text": "还要延期吗？"
        },
        {
          "role": "小安",
          "text": "我努努力吧，尽量不再延期了，但是看我手上的这些工作，哈哈…说实话，挺难的。"
        },
        {
          "role": "旅行者",
          "text": "那你只能自己想办法了…"
        },
        {
          "role": "小安",
          "text": "我知道啊，我自己的工作，难道还能指望别人吗？"
        },
        {
          "role": "旅行者",
          "text": "下次先划分优先级。"
        },
        {
          "role": "小安",
          "text": "哈哈哈，每次我都这么想，但每次工作一多我就开始手忙脚乱，分优先级的事不知道忘到哪去了。"
        },
        {
          "role": "江舟",
          "text": "这样还不行…还得改改…"
        },
        {
          "role": "旅行者",
          "text": "小昭让我送这个给你…"
        },
        {
          "role": "江舟",
          "text": "嗯？关于下届海灯节的策划案…"
        },
        {
          "role": "江舟",
          "text": "这个啊，我正在写了，可是一直觉得遗漏了什么地方，所以一直在修改。"
        },
        {
          "role": "江舟",
          "text": "海灯节这种重大节日，当然要尽善尽美啊，所以…这个策划案还交不上去啦。"
        },
        {
          "role": "旅行者",
          "text": "时间要来不及了…"
        },
        {
          "role": "江舟",
          "text": "我一定会整理出最好的方案的，只要再给我点时间…"
        },
        {
          "role": "旅行者",
          "text": "先交上去吧。"
        },
        {
          "role": "江舟",
          "text": "这怎么行，怎么能交一份随随便便的方案上去？这可是璃月最重要的节日啊。"
        },
        {
          "role": "旅行者",
          "text": "不会有完美的方案。"
        },
        {
          "role": "江舟",
          "text": "虽然话是这么说，但也要向完美努努力吧。"
        },
        {
          "role": "小安",
          "text": "港口的事太多了，我想想…"
        },
        {
          "role": "旅行者",
          "text": "有方案总比没有好。"
        },
        {
          "role": "江舟",
          "text": "话是这么说，但总不能交一份有问题的方案出去吧…"
        },
        {
          "role": "旅行者",
          "text": "你的方案没问题的。"
        },
        {
          "role": "江舟",
          "text": "嗯…你说得也有道理，但至少容我再完善一下。"
        },
        {
          "role": "旅行者",
          "text": "可以先交再改…"
        },
        {
          "role": "江舟",
          "text": "别开玩笑了，海灯节可不是这么随随便便的节日。"
        },
        {
          "role": "旅行者",
          "text": "参考上届海灯节…"
        },
        {
          "role": "江舟",
          "text": "我就是参考上届海灯节，虽然上一届市民们很喜欢，但是…我还是想要做出一点突破。"
        },
        {
          "role": "旅行者",
          "text": "相信自己…"
        },
        {
          "role": "江舟",
          "text": "相信自己有什么用，市民们不喜欢的话就全完了。"
        },
        {
          "role": "旅行者",
          "text": "那你再好好想想？"
        },
        {
          "role": "江舟",
          "text": "嗯！再给我一点时间，我一定能想出完美的方案。"
        }
      ]
    }
  ]
}