  "chapter_title": "影域的遗留",
  "type": "wq",
  "route": "Remnants of the Shadow Realm",
  "stories": [
    {
      "story_id": 77654,
      "title": "影域的遗留",
      "description": "持续升级权限卡的你开启了一个隐藏空间…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与塔佩兹尼科夫对话"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "原来如此，这座遗迹内部还有隐藏空间。"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "就我最近的观察来看，这座遗迹内部的造物都来自白沙皇时期。"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "有传言说，白沙皇在位期间，他手下有个神秘组织经常从影域中发掘科技造物，并加以利用。"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "这里竟然存放着这么多来自影域的科技造物，看来这座遗迹也和当年的发掘行动有关。"
        },
        {
          "role": "阿罗夏",
          "text": "我就说把他请过来能帮大忙，在这方面，他非常专业。"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "我本身就对这些很感兴趣…"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "话说回来，只要旅行者继续解锁权限，应该就能获取这里全部的科技造物。"
        },
        {
          "role": "阿罗夏",
          "text": "那能拿到东西还真不少…可惜看上去都不是我这把枪能用的。"
        }
      ]
    }
  ]
}