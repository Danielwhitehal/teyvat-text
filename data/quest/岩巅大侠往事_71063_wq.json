{
  "quest_id": 71063,
  "chapter_num": null,
  "chapter_title": "岩巅大侠往事",
  "type": "wq",
  "route": "A Cliff-Side Hero's Past",
  "stories": [
    {
      "story_id": 71063,
      "title": "岩巅大侠往事",
      "description": "一位站在层岩巨渊最高处的前盗宝团成员，竟自称古华派传人，是精神的失常还是人心的沦丧，难道其中还藏有什么隐情…",
      "dialogues": [
        {
          "role": "唐无仇",
          "text": "哼哼，怎么成天有人觊觎我的琉璃百合大花园，要是再有偷花贼胆敢靠近，我就必要让他们尝尝古华派武功的厉害！"
        },
        {
          "role": "唐无仇",
          "text": "你们是何方宵小之徒！可不知此处的这些花已是名花有主！岂可随意采撷？"
        },
        {
          "role": "唐无仇",
          "text": "还不速速住手。"
        },
        {
          "role": "派蒙",
          "text": "啊！难道说，这些花是你…"
        },
        {
          "role": "唐无仇",
          "text": "正是我慧眼发现，从三日前开始细心呵护的！"
        },
        {
          "role": "派蒙",
          "text": "原来不是你种的啊。"
        },
        {
          "role": "唐无仇",
          "text": "咳咳，虽然不是我所种，但是现在已经属于我了。"
        },
        {
          "role": "唐无仇",
          "text": "我甚至在心中暗中发誓，必要认真培育这些花，在此处打造一个美丽非凡的琉璃百合大花园。"
        },
        {
          "role": "派蒙",
          "text": "咦，琉璃百合大花园…靠这些花吗？"
        },
        {
          "role": "派蒙",
          "text": "可是…"
        },
        {
          "role": "唐无仇",
          "text": "怎么了？你以为本大侠是个不识风雅的庸人吗？"
        },
        {
          "role": "唐无仇",
          "text": "看来你也不过是个以貌取人之徒。"
        },
        {
          "role": "派蒙",
          "text": "你说要建一个琉璃百合大花园，可是这些花是清心，不是琉璃百合哦。"
        },
        {
          "role": "唐无仇",
          "text": "…啊？"
        },
        {
          "role": "唐无仇",
          "text": "……"
        },
        {
          "role": "唐无仇",
          "text": "…哼哼哼哼哼，哈哈哈哈哈。"
        },
        {
          "role": "唐无仇",
          "text": "我懂了，你们是想说这些假话来动摇我的意念。"
        },
        {
          "role": "唐无仇",
          "text": "我可是古华派第三百二十代传人唐无仇，你以为这样就能够骗过我吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "古华派有那么多代吗…",
              "dialogues": [
                {
                  "role": "唐无仇",
                  "text": "你竟敢质疑古华派的悠久历史，还不速速纳命来！"
                }
              ]
            },
            {
              "text": "明明穿着盗宝团的衣服…",
              "dialogues": [
                {
                  "role": "唐无仇",
                  "text": "哼，衣服不过是身外之物罢了，真正能够决定一个人的是他的内心。"
                },
                {
                  "role": "唐无仇",
                  "text": "我古华派弟子唐无仇，今天就要替天行道，将你这偷花贼击退，好教你们知道古华派的厉害！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "击败自称古华派弟子的唐无仇"
        },
        {
          "type": "subtitle",
          "text": "与唐无仇对话"
        },
        {
          "role": "唐无仇",
          "text": "怎么样，要是能拿出等价的事物，我要换给你，也不是不行。"
        },
        {
          "role": "旅行者",
          "text": "（那就给他一枚鸟蛋吧……）"
        },
        {
          "role": "唐无仇",
          "text": "痛痛痛痛痛，我错了我错了，别再打了。"
        },
        {
          "role": "派蒙",
          "text": "这个人的武功真是…"
        },
        {
          "role": "旅行者",
          "text": "十分稀烂。"
        },
        {
          "role": "唐无仇",
          "text": "没想到我苦修这么多载，还是不如你…"
        },
        {
          "role": "唐无仇",
          "text": "啊这个，正所谓好马配好鞍，好船配好帆…不对，呸呸呸…"
        },
        {
          "role": "唐无仇",
          "text": "正所谓宝剑配英雄，这朵琉璃百合就送给英雄您了。"
        },
        {
          "role": "派蒙",
          "text": "都说了这是清心啦…"
        },
        {
          "role": "唐无仇",
          "text": "对对对，是清心是清心，您说啥就是啥…"
        },
        {
          "role": "派蒙",
          "text": "你真的是古华派的吗…嗯，你认不认识一个人，名字叫行秋？"
        },
        {
          "role": "唐无仇",
          "text": "行秋此名…"
        },
        {
          "role": "唐无仇",
          "text": "我是闻所未闻啊，怎么，难道这个叫行秋的家伙自称古华派弟子吗？"
        },
        {
          "role": "唐无仇",
          "text": "那怎么能让他败坏我古华派的声名…"
        },
        {
          "role": "派蒙",
          "text": "（看来他真的不是古华派的人…而且，败坏古华派声名的人不就是他自己吗…）"
        },
        {
          "role": "派蒙",
          "text": "等等，等等，你口口声声说自己是古华派的人，有什么证据吗？"
        },
        {
          "role": "唐无仇",
          "text": "那当然是有证据的，看，我身上这枚玉佩…"
        },
        {
          "role": "派蒙",
          "text": "这枚玉佩…是古华派代代相传的宝物？"
        },
        {
          "role": "唐无仇",
          "text": "这枚玉佩我一位老友在分别时卖于我，我心中暗自决定，这以后就是我们古华派代代相传的宝物了。"
        },
        {
          "role": "唐无仇",
          "text": "带上这枚玉佩以来，每次我练武，脑内都会有隐约刺痛之感。"
        },
        {
          "role": "派蒙",
          "text": "呃…"
        },
        {
          "role": "派蒙",
          "text": "怎么想都是这枚玉佩有什么问题。"
        },
        {
          "role": "唐无仇",
          "text": "怎么可能，我佩戴这枚玉佩的第一天，就有仙人入梦，授我古华派绝学，说明我与这玉佩有缘。"
        },
        {
          "role": "唐无仇",
          "text": "而且脑内的刺痛感，是精神逐渐涨大成长之痛，小说里都写了，这是意念在逐渐加强的前兆，怎么会有问题？"
        },
        {
          "role": "唐无仇",
          "text": "难道…好啊，我明白了！"
        },
        {
          "role": "唐无仇",
          "text": "…哼哼哼哼哼，哈哈哈哈哈。"
        },
        {
          "role": "唐无仇",
          "text": "我明白了，你们其实想要这一块玉佩…只是不好意思开口，借口说这玉佩有问题，还真是道貌…咳咳…还真是委婉。"
        },
        {
          "role": "唐无仇",
          "text": "这块玉佩可是我古华派的至宝，即使是您二位，想要从我手中夺去此宝，那也得…"
        },
        {
          "role": "唐无仇",
          "text": "那也得拿什么价格相同的来换吧，比如什么鸽子蛋大小的宝石之类的…不然我这个古华派三百二十代传人面子上可挂不住。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，看来就是这块奇怪的玉佩让他以为自己是古华派传人，还这么疯疯癫癫的。"
        },
        {
          "role": "派蒙",
          "text": "要是他一直带着那个玉佩，还在那么高的地方，肯定会出事的。"
        },
        {
          "role": "派蒙",
          "text": "他不是要我们拿什么鸽子蛋大小的宝石换嘛，他这样看上去也没法分辨好坏…"
        },
        {
          "role": "派蒙",
          "text": "我们就，给他几个鸟蛋试试好了。"
        },
        {
          "type": "subtitle",
          "text": "将鸟蛋交给唐无仇以交换玉佩"
        },
        {
          "type": "subtitle",
          "text": "与唐无仇对话"
        },
        {
          "role": "派蒙",
          "text": "这个给你，换你那枚玉佩。"
        },
        {
          "role": "派蒙",
          "text": "这可是…这可是鸟蛋大小的宝石。"
        },
        {
          "role": "唐无仇",
          "text": "鸟蛋大小？我原本以为鸽子蛋大小的宝石已是登峰造极，没想到还有鸟蛋大小的宝石呢？"
        },
        {
          "role": "唐无仇",
          "text": "嘿嘿，拿一个玉佩换回如此大的一枚宝石，真是稳赚不赔啊！"
        },
        {
          "role": "唐无仇",
          "text": "这也多亏我古华派素有仁义之心…咳咳，看你们求宝心切，才愿意做这样的交易。"
        },
        {
          "role": "？？？",
          "text": "唐无仇将玉佩取下，递了过来…"
        },
        {
          "type": "subtitle",
          "text": "与唐无仇对话"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "这块玉佩你们就拿去吧，这么看来，你们也与我古华派有缘，得此至宝，也须小心珍重啊。"
        },
        {
          "role": "派蒙",
          "text": "刚才一脸不乐意的表情一瞬间就消失了。"
        },
        {
          "role": "派蒙",
          "text": "唔，这上面有很浓厚的岩元素之力…这不是「翠珏岩」吗！"
        },
        {
          "role": "派蒙",
          "text": "「翠珏岩」…我记得白术说过，说过，反正我原话记不住，总之就是说，会对人产生不好的影响。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "那不可能，这是我的朋友卖我的，我铁打的兄弟，啊，还能害我吗！"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "而且我那朋友还有很多玉石打制的首饰…"
        },
        {
          "role": "派蒙",
          "text": "你的朋友？"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "对啊，他叫老臭，一个做玉石生意的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他人在哪？",
              "dialogues": [
                {
                  "role": "自称「唐无仇」者",
                  "text": "他就在层岩巨渊这附近，最近据说也还帮着卖玉石打制的首饰呢…"
                }
              ]
            },
            {
              "text": "他还在卖首饰？",
              "dialogues": [
                {
                  "role": "自称「唐无仇」者",
                  "text": "我不知道他是不是还在卖，但是他就在层岩巨渊附近…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "旅行者，如果那个人还在卖用「翠珏岩」做的首饰之类的话，肯定会有很多人都受到影响的。"
        },
        {
          "role": "派蒙",
          "text": "我们还是去看一下吧！"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "这块玉佩你们就拿去吧，这么看来，你们也与我古华派有缘，得此至宝，也须小心珍重啊。"
        },
        {
          "role": "派蒙",
          "text": "刚才一脸不乐意的表情一瞬间就消失了。"
        },
        {
          "role": "派蒙",
          "text": "唔，这上面有很浓厚的岩元素之力…"
        },
        {
          "role": "派蒙",
          "text": "普通人日常并不会接触元素之力，要是有这么浓厚的元素之力长时间放在身边，肯定会产生不适。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "那不可能，这是我的朋友卖我的，我铁打的兄弟，啊，还能害我吗！"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "而且我那朋友还有很多玉石打制的首饰…"
        },
        {
          "role": "派蒙",
          "text": "你的朋友？"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "对啊，他叫老臭，一个做玉石生意的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他人在哪？",
              "dialogues": [
                {
                  "role": "自称「唐无仇」者",
                  "text": "他就在层岩巨渊这附近，听说最近也还帮着卖宝石呢…"
                }
              ]
            },
            {
              "text": "他还在卖首饰？",
              "dialogues": [
                {
                  "role": "自称「唐无仇」者",
                  "text": "我不知道他是不是还在卖，但是他就在这层岩巨渊附近…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "旅行者，如果那个人还在卖这样的玉石制品，肯定会有很多人都受到影响的。"
        },
        {
          "role": "派蒙",
          "text": "我们还是去看一下吧！"
        },
        {
          "type": "subtitle",
          "text": "前去寻找老臭"
        },
        {
          "role": "老臭",
          "text": "哎呀，两位，找我有什么事吗？"
        },
        {
          "role": "老臭",
          "text": "你们是不是也想来玩挖宝的游戏…"
        },
        {
          "role": "派蒙",
          "text": "哼，今天我们俩过来，是有别的事要找你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这枚玉佩…",
              "dialogues": [
                {
                  "role": "老臭",
                  "text": "啊，这枚玉佩…"
                },
                {
                  "role": "老臭",
                  "text": "确确实实是从我这里脱手卖出去的…来，让我仔细看，这质地，这水润，这透亮，这不是我卖给唐无仇的那一枚嘛！"
                },
                {
                  "role": "老臭",
                  "text": "这枚玉佩的材质，看上去就和别的货不一样。"
                },
                {
                  "role": "老臭",
                  "text": "我当时还想靠着这个大赚一笔呢，结果被唐无仇一眼看中，赖死赖活的，就便宜卖给他了。"
                },
                {
                  "role": "派蒙",
                  "text": "这种材质的只有这一个？"
                },
                {
                  "role": "老臭",
                  "text": "我倒是还想再翻出来第二个呢。"
                },
                {
                  "role": "派蒙",
                  "text": "唉…幸好只有这一个，这个材质的矿石富含元素力，如果是没有「神之眼」的人接触了，就会性格大变，满嘴胡话…"
                },
                {
                  "role": "派蒙",
                  "text": "唐无仇现在以为自己是古华派的大侠，每天疯疯癫癫的。"
                },
                {
                  "role": "老臭",
                  "text": "啊？怎、怎么会这样。"
                },
                {
                  "role": "老臭",
                  "text": "仔细一看，这确实和传说中会让佩戴之人产生不适的「翠珏岩」十分相像。"
                },
                {
                  "role": "老臭",
                  "text": "以前就曾听老一辈人说过，说是「翠珏岩」虽然宝贵，但要是长时间贴身携带，往往携带者都会遭受厄运，邪门的很。"
                },
                {
                  "role": "老臭",
                  "text": "是我害了老唐啊！"
                },
                {
                  "role": "老臭",
                  "text": "唉，我和唐无仇以前都是盗宝团的，之前在层岩巨渊干了一票，大家决定分道扬镳。"
                },
                {
                  "role": "老臭",
                  "text": "唐无仇不知道跑哪去了，可是我…唉，我被以前盗宝团的人找到，受他们胁迫，买他们在这做的劣质首饰在璃月转手卖出。"
                },
                {
                  "role": "老臭",
                  "text": "美其名曰帮忙销售，可是他们做的…是材料比得上「盛露厅」啊，还是造型打制比得上「明星斋」？"
                },
                {
                  "role": "老臭",
                  "text": "还不是要我给他们做出来的玩意儿兜底。"
                },
                {
                  "role": "老臭",
                  "text": "可怜我是低价再低价，赔了本，才卖得出去。"
                },
                {
                  "role": "老臭",
                  "text": "之前赚的钱全都赔了进去…好在那群爷可能醒悟过来，直接卖材料还卖得贵些，最近终于不来找我了。"
                },
                {
                  "role": "旅行者",
                  "text": "他们都被潜入的千岩军剿了。"
                },
                {
                  "role": "？？？",
                  "text": "向老臭告知千岩军捣毁走私窝点的始末…"
                },
                {
                  "role": "老臭",
                  "text": "剿得好啊！"
                },
                {
                  "role": "老臭",
                  "text": "说要向千岩军告我的案底，哼，这下自己进去了吧。"
                },
                {
                  "role": "老臭",
                  "text": "唉，说远了…唐无仇的事我也很抱歉，但是我现在值钱的东西，都、都被我埋在土堆里了，好做些小生意赚点钱。"
                },
                {
                  "role": "老臭",
                  "text": "不如这样，这次就让你们挖一次宝，挖出什么，就带给唐无仇算作赔礼吧。"
                }
              ]
            },
            {
              "text": "这是你这里卖的吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "老臭",
          "text": "怎么样，要不要听一下这个挖宝怎么玩？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用了，我知道…",
              "dialogues": []
            },
            {
              "text": "行啊，你说一下规则吧…",
              "dialogues": [
                {
                  "role": "老臭",
                  "text": "简而言之，就是每个土堆下面都有些好东西，但是也有炸药…不过不用担心，都是些长时间没人用的哑弹。"
                },
                {
                  "role": "老臭",
                  "text": "要是能挖到宝贝，就给你们，算作给老唐的赔礼，原本要是挖到炸弹就算输了，不过这次嘛…"
                },
                {
                  "role": "老臭",
                  "text": "算了，等你们挖到再说吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "老臭",
          "text": "那，不如现在就开始来一局吧！"
        },
        {
          "role": "老臭",
          "text": "哎呀，两位，找我有什么事吗？"
        },
        {
          "role": "老臭",
          "text": "你们是不是也想来玩挖宝的游戏…"
        },
        {
          "role": "派蒙",
          "text": "哼，今天我们俩过来，是有别的事要找你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这枚玉佩…",
              "dialogues": [
                {
                  "role": "老臭",
                  "text": "啊，这枚玉佩…"
                },
                {
                  "role": "老臭",
                  "text": "确确实实是从我这里脱手卖出去的…来，让我看看，这质地，这水润，这透亮，这不是我卖给唐无仇的那一枚嘛！"
                },
                {
                  "role": "老臭",
                  "text": "这枚玉佩的材质，看上去就和别的货不一样。"
                },
                {
                  "role": "老臭",
                  "text": "我当时还想靠着这个大赚一笔呢，结果被唐无仇一眼看中，赖死赖活地，就便宜卖给他了。"
                },
                {
                  "role": "派蒙",
                  "text": "这种材质的只有这一个？"
                },
                {
                  "role": "老臭",
                  "text": "我倒是还想再翻出来第二个呢。"
                },
                {
                  "role": "派蒙",
                  "text": "唉…幸好只有这一个，这个材质的矿石富含元素力，如果是没有「神之眼」的人接触了，就会性格大变，满嘴胡话…"
                },
                {
                  "role": "派蒙",
                  "text": "唐无仇现在以为自己是古华派的大侠，每天疯疯癫癫的。"
                },
                {
                  "role": "老臭",
                  "text": "啊？怎、怎么会这样。"
                },
                {
                  "role": "老臭",
                  "text": "仔细一看，这确实就是传说中会让佩戴之人产生不适的「翠珏岩」。"
                },
                {
                  "role": "老臭",
                  "text": "以前就曾听老一辈人说过，说是「翠珏岩」虽然宝贵，但要是长时间贴身携带，往往携带者都会遭受厄运，邪门的很。"
                },
                {
                  "role": "老臭",
                  "text": "是我害了老唐啊！"
                },
                {
                  "role": "老臭",
                  "text": "唉，我和老唐以前都是盗宝团的，之前在层岩巨渊干了一票，大家决定分道扬镳。"
                },
                {
                  "role": "老臭",
                  "text": "唐无仇不知道跑哪去了，可是我…唉，我被以前盗宝团的人找到，受他们胁迫，买他们在这做的劣质首饰在璃月转手卖出。"
                },
                {
                  "role": "老臭",
                  "text": "美其名曰帮忙销售，可是他们做的…是材料比得上「盛露厅」啊，还是造型打制比得上「明星斋」？"
                },
                {
                  "role": "老臭",
                  "text": "还不是要我给他们做出来的玩意儿兜底。"
                },
                {
                  "role": "老臭",
                  "text": "可怜我是低价再低价，赔了本，才卖得出去。"
                },
                {
                  "role": "老臭",
                  "text": "之前赚的钱全都赔了进去…好在那群爷可能醒悟过来，直接卖材料还卖得贵些，最近终于不来找我了。"
                },
                {
                  "role": "老臭",
                  "text": "唉，说远了…唐无仇的事我也很抱歉，但是我现在值钱的东西，都、都被我埋在土堆里了，好做些小生意赚点钱。"
                },
                {
                  "role": "老臭",
                  "text": "不如这样，这次就让你们挖一次宝，挖出什么，就带给唐无仇算作赔礼吧。"
                }
              ]
            },
            {
              "text": "这是你这里卖的吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "老臭",
          "text": "怎么样，要不要听一下这个挖宝怎么玩？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用了，我知道…",
              "dialogues": []
            },
            {
              "text": "行啊，你说一下规则吧…",
              "dialogues": [
                {
                  "role": "老臭",
                  "text": "简而言之，就是每个土堆下面都有些好东西，但是也有炸药…不过不用担心，都是些长时间没人用的哑弹。"
                },
                {
                  "role": "老臭",
                  "text": "要是能挖到宝贝，就给你们，算作给老唐的赔礼，原本要是挖到炸弹就算输了，不过这次嘛…"
                },
                {
                  "role": "老臭",
                  "text": "算了，等你们挖到再说吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "老臭",
          "text": "那，不如现在就开始来一局吧！"
        },
        {
          "type": "subtitle",
          "text": "进行一次「挖宝」挖出老臭的赔礼"
        },
        {
          "type": "subtitle",
          "text": "与老臭对话"
        },
        {
          "role": "老臭",
          "text": "来，让我看看你们都挖出了点啥？"
        },
        {
          "role": "老臭",
          "text": "哦，你们居然把这袋东西挖出来了…"
        },
        {
          "role": "派蒙",
          "text": "里面是什么呀…"
        },
        {
          "role": "派蒙",
          "text": "啊这些首饰，看上去真是…"
        },
        {
          "role": "旅行者",
          "text": "好丑。"
        },
        {
          "role": "老臭",
          "text": "就是盗宝团之前那些人做出来的，根本卖不出去。"
        },
        {
          "role": "老臭",
          "text": "不过好歹算是真材实料，把那上面的宝石抠下来也能值点钱…哎…"
        },
        {
          "role": "老臭",
          "text": "你们就把这个送给老唐吧。"
        },
        {
          "role": "派蒙",
          "text": "那我们就先走了！"
        },
        {
          "role": "老臭",
          "text": "嘿，要是有空的话，再来我这玩挖宝啊。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们现在就回去吗？"
        },
        {
          "role": "旅行者",
          "text": "嗯，马上回去交给唐无仇…"
        },
        {
          "role": "旅行者",
          "text": "待会儿再交给他吧…"
        },
        {
          "type": "subtitle",
          "text": "将老臭的事告知唐无仇"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "哎呀，这块宝石明明有鸟蛋大小，入手却如此轻盈。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "对光而照，居然隐约能看到中间夹层的影子，真是不可思议，不可思议啊…"
        },
        {
          "role": "派蒙",
          "text": "他居然还在看那个蛋…"
        },
        {
          "role": "派蒙",
          "text": "古华派大侠！"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "嗯？啊！古华派三百二十代传人唐无仇，正是本人，诸位肯定是听闻我的事迹前来…"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "唉，原来是你们啊，怎么样，你们找到老臭了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "找是找到了…",
              "dialogues": []
            },
            {
              "text": "整个事情吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "说明了「翠珏岩」一事，将老臭的赔礼递给唐无仇。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "这么一大袋呢…我看看里面都有些啥。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "我的天，这么多首饰，而且这些首饰真是…"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "好丑。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "拿这些东西就糊弄我了啊，这个老臭！"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "当初买那个「翠珏岩」做的玉佩，可花了我好多摩拉呢！而且这老臭在金盆洗手之后，还行那些跟盗宝团沾边的偷鸡摸狗之事！"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "真是新仇旧恨，哼，看我不一刀切了他。"
        },
        {
          "role": "派蒙",
          "text": "你还以为自己是大侠呢。"
        },
        {
          "role": "派蒙",
          "text": "更何况，那块玉佩，当初不是你自己想要买的嘛。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "……"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "…哼哼哼哼哼，哈哈哈哈哈。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "你说的有道理。"
        },
        {
          "role": "派蒙",
          "text": "而且老臭已经不跟盗宝团有关系了，现在正摆摊子让人挖宝玩呢。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "挖宝？哼，他又在搞那一套…以前就搞这套来骗买酒的钱。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "我跟你说啊…他那个挖宝，<color=#00E1FFFF>越是好东西，周围炸药桶就越多。东西越差，周围就越安全。</color>"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "比如那种空空如也的格子，周围必是一个炸药桶都没有，而最好的东西呢，周围四格里肯定全放着炸药桶。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "真是特别抠门，只要一挖出炸药桶就大喊游戏结束游戏结束，生怕被人把好东西挖走。"
        },
        {
          "role": "派蒙",
          "text": "可是这次就算我们挖到了炸药桶，他也让我们继续挖呢…"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "是、是嘛…看来他还是有点良心的。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "唉，也是。当初要是我在他身边，凭我的武功，他也不会被那群盗宝团的拿捏成那样。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的什么？",
              "dialogues": []
            },
            {
              "text": "你的…武功？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "自称「唐无仇」者",
          "text": "咳咳，我好歹以前也是走江湖的，虽然和真正的英雄有所差距，打几个盗宝团的小喽啰还是不成问题的。"
        },
        {
          "role": "自称「唐无仇」者",
          "text": "下次我还是提两壶酒去找他聊聊天吧。"
        }
      ]
    }
  ]
