{
  "quest_id": 71101,
  "chapter_num": null,
  "chapter_title": "扇底春秋",
  "type": "wq",
  "route": "The Tales Behind the Fan",
  "stories": [
    {
      "story_id": 71101,
      "title": "扇底春秋",
      "description": "从层岩巨渊回来后，你们决定到街头随意逛逛…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "到璃月港街头转转"
        },
        {
          "role": "派蒙",
          "text": "你看，真的在那里！"
        },
        {
          "role": "派蒙",
          "text": "喂——！钟离！"
        },
        {
          "role": "钟离",
          "text": "哦？二位。"
        },
        {
          "role": "派蒙",
          "text": "我们有话要问你！"
        },
        {
          "role": "钟离",
          "text": "可否稍待片刻？我正忙着。"
        },
        {
          "role": "派蒙",
          "text": "你在干嘛呀？"
        },
        {
          "role": "派蒙",
          "text": "话说回来，你居然这么快就回到城里了，可怕的速度…"
        },
        {
          "role": "田铁嘴",
          "text": "钟离兄，这两位是你朋友？好像常来我这里找你。"
        },
        {
          "role": "钟离",
          "text": "都是相熟的朋友了。"
        },
        {
          "role": "田铁嘴",
          "text": "甚好甚好，既然二位有空，也一起帮我看看，怎么才能说服钟离兄把他那块老石拿出来。"
        },
        {
          "role": "派蒙",
          "text": "老石？你要那个做什么？"
        },
        {
          "role": "田铁嘴",
          "text": "二位有所不知，老石现在是炙手可热的珍稀矿石，有市无价！"
        },
        {
          "role": "田铁嘴",
          "text": "今天我照常在此说书，钟离兄也照常溜达过来，坐下听书。聊着聊着，便聊到了我的拿手好戏「创龙点睛」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来是那个。",
              "dialogues": []
            },
            {
              "text": "我也有事没事常回味。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "田铁嘴",
          "text": "不错的说书吧？呵呵，钟离兄也说，我说书有一手。"
        },
        {
          "role": "田铁嘴",
          "text": "我只知道钟离兄见多识广，深谙民俗，却没想到，他对历史、神话也颇有研究。这不，有问题总是问他。"
        },
        {
          "role": "钟离",
          "text": "能帮上小忙便好。"
        },
        {
          "role": "田铁嘴",
          "text": "哪里哪里，可帮了我不少！不过啊，聊天本就要跟有趣的人聊。比如钟离兄，想法奇巧，牛自然也没少吹，啊哈哈！"
        },
        {
          "role": "田铁嘴",
          "text": "好比有一回我同他说：你瞧我这故事里，岩王帝君以灵石为本，雕刻出若陀龙王，日后又接那金戈铁马的桥段，过瘾！"
        },
        {
          "role": "田铁嘴",
          "text": "他却说，故事万般皆好，就是有些细节不对，例如有人考据过，岩王帝君或许手艺不佳，雕不出这么精美的作品。"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "田铁嘴",
          "text": "煞风景，是吧？上回我给他讲轻策庄的螭化身为山水，铸就一方美景。他也不认同，觉得天下哪有这种好事。"
        },
        {
          "role": "田铁嘴",
          "text": "唉你们说，人是不是见识多了就会缺乏诗意？瞧钟离兄，仪表堂堂，骨子里竟如此没有情调。"
        },
        {
          "role": "钟离",
          "text": "田兄批评得句句在理，我定当牢记于心，好好反思。"
        },
        {
          "role": "钟离",
          "text": "不过田兄编故事向来天马行空，我只是提出一些常人容易想到的意见，方便田兄参考。"
        },
        {
          "role": "钟离",
          "text": "说书的都是聪明人，以田兄眼力，不可能看不出我这般衷心的听众是为何而来。"
        },
        {
          "role": "田铁嘴",
          "text": "当然当然！钟离兄一番好意，我都明白。钟离兄一定是希望我成为璃月港最好的说书先生，对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（我倒觉得你不是很明白…）",
              "dialogues": []
            },
            {
              "text": "（他只是想说细节不对…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你说了这么多，老石呢？"
        },
        {
          "role": "田铁嘴",
          "text": "哎呀，言归正传言归正传。你们是不晓得，前几天我又给人说了一出《创龙点睛》。"
        },
        {
          "role": "派蒙",
          "text": "你这是炒冷饭，翻来覆去地炒呀…"
        },
        {
          "role": "田铁嘴",
          "text": "经典永流传，懂吗！"
        },
        {
          "role": "钟离",
          "text": "田兄的戏，总是要炒一遍冷饭的。说书是创作，编也要时间啊。"
        },
        {
          "role": "田铁嘴",
          "text": "还是钟离兄明白。正巧那天有个外出打工的矿工头子，路过我这儿，听见这段说书，就跟我说啊…"
        },
        {
          "role": "田铁嘴",
          "text": "层岩巨渊你们知道吗？那边有种石头，模样漂亮，色泽幽雅。"
        },
        {
          "role": "田铁嘴",
          "text": "而这种石头，就长在层岩巨渊里一条长长的过道上…欸，他是这么说的吗？过道？"
        },
        {
          "role": "钟离",
          "text": "应该是吧。"
        },
        {
          "role": "田铁嘴",
          "text": "嗨，层岩巨渊那般神秘，纵然是钟离兄这么有见识的人都没机会去。"
        },
        {
          "role": "田铁嘴",
          "text": "也就是最近那边矿业恢复了些，才陆陆续续有人员流动。我们都是听人说的。"
        },
        {
          "role": "钟离",
          "text": "对，对。确有此事。"
        },
        {
          "role": "田铁嘴",
          "text": "人说，石头长在过道上，过道又是怎么来的呢？没人清楚。只能看见那过道蜿蜒曲折，如同巨物拖行所留。"
        },
        {
          "role": "田铁嘴",
          "text": "阵仗惊人，见者无不为之震撼！有人说，那里恐怕是什么上古战场。"
        },
        {
          "role": "田铁嘴",
          "text": "可究竟是谁和谁打出来的，我们无从考证。我便想着，说不定，岩王帝君和若陀龙王也在那里打过架？"
        },
        {
          "role": "田铁嘴",
          "text": "不瞒各位说，我正在琢磨一段新说书，要是能把这个编进去，岂不是厉害了！"
        },
        {
          "role": "田铁嘴",
          "text": "所以啊，就叫来钟离兄，请他赐教。没想到，他手头刚巧有一块老石，是从集市的商人那儿淘来的。"
        },
        {
          "role": "田铁嘴",
          "text": "眼光好，自然会挑。我想着，这老石真能说是我故事的象征了，钟离兄要是愿意，我也想将这石头买来，做个纪念。"
        },
        {
          "role": "派蒙",
          "text": "钟离，你、你要把石头给他吗？"
        },
        {
          "role": "钟离",
          "text": "嗯…田兄本就是说书人里的佼佼者，我又是他的忠实听众。若能为田兄的创作尽一份绵力，我自当支持。"
        },
        {
          "role": "派蒙",
          "text": "欸？！"
        },
        {
          "role": "钟离",
          "text": "可若我将石头让出去，倒显得田兄的故事有纰漏。几位还请想想，岩王帝君不是将那若陀龙王封入地下了？"
        },
        {
          "role": "钟离",
          "text": "据专家称，层岩巨渊地下满是洞穴与矿道，若陀龙王封在那处，定会三天两头遭人打扰。如此场面，莫非，也是岩王帝君的考量？"
        },
        {
          "role": "派蒙",
          "text": "好有道理啊！"
        },
        {
          "role": "田铁嘴",
          "text": "倒也是…岩王帝君可不会做这般不周全的事。"
        },
        {
          "role": "旅行者",
          "text": "嗯嗯对对。"
        },
        {
          "role": "田铁嘴",
          "text": "唉，其实啊，我本想拿我最喜欢的这把扇子与钟离兄交换…"
        },
        {
          "role": "派蒙",
          "text": "嗯？上面画的是…"
        },
        {
          "role": "田铁嘴",
          "text": "正是本人说《创龙点睛》时最爱拿的扇子。游龙入云，纵横天下，志远心高，浩瀚无垠。"
        },
        {
          "role": "派蒙",
          "text": "哇…很少看到这样的扇子呢，说得我都想要了…"
        },
        {
          "role": "派蒙",
          "text": "对了，老石我们也有哦！"
        },
        {
          "role": "田铁嘴",
          "text": "什么？！那、那二位是否愿意将老石让给我？我愿以此扇交换！"
        },
        {
          "role": "钟离",
          "text": "哎，田兄此言差矣。老石珍贵，你的扇子也绝非俗物。如此交换，倒是折了双方仙气。"
        },
        {
          "role": "田铁嘴",
          "text": "这…这也行吗？我这扇子，倒是不止一把…"
        },
        {
          "role": "钟离",
          "text": "田兄亲手绘制，原是妙物。任何一个爱听你说书的人，都会为收到如此厚礼而欢喜。"
        },
        {
          "role": "田铁嘴",
          "text": "当真？…也是，高山流水遇知音，比起其他，我更想让人认可我说的故事。画这些扇子，也是盼着有朝一日能送给有缘人。"
        },
        {
          "role": "田铁嘴",
          "text": "既然如此，几位也与我有缘，这扇子理应送给你们！稍等片刻，我这就去取。"
        },
        {
          "role": "？？？",
          "text": "田铁嘴来去如风，飞快地取来两把扇子赠予听众…"
        },
        {
          "role": "旅行者",
          "text": "真的可以给我吗？"
        },
        {
          "role": "田铁嘴",
          "text": "当然，您听过我说书，自是缘分。再说我也画了不止一把扇子，不给你们，还能给谁呢。"
        },
        {
          "role": "田铁嘴",
          "text": "钟离兄也不要客气！自家制品，还请你别嫌弃。"
        },
        {
          "role": "钟离",
          "text": "……"
        },
        {
          "role": "钟离",
          "text": "田兄一番心意，我就不客气了。"
        },
        {
          "role": "钟离",
          "text": "…当真好扇，值得珍藏。"
        },
        {
          "role": "派蒙",
          "text": "啊对！我们是来找钟离的，还想跟他聊些别的事！"
        },
        {
          "role": "田铁嘴",
          "text": "那我岂不是耽搁你们了？哎呀，快请快请。"
        },
        {
          "role": "钟离",
          "text": "何来耽搁一说。田兄，多谢。"
        },
        {
          "role": "派蒙",
          "text": "钟离，你是不是去过层岩巨渊了？还救了我们大家。"
        },
        {
          "role": "旅行者",
          "text": "谢谢你。"
        },
        {
          "role": "派蒙",
          "text": "魈也说，要不是你特意出手相助，他恐怕无法逃生。"
        },
        {
          "role": "钟离",
          "text": "他竟这么说？有趣。"
        },
        {
          "role": "钟离",
          "text": "时光荏苒，他也变得直白些了。"
        },
        {
          "role": "派蒙",
          "text": "所以，你又为什么会去层岩巨渊？"
        },
        {
          "role": "钟离",
          "text": "唔？竟有此事？我也是第一次听说。"
        },
        {
          "role": "派蒙",
          "text": "欸？！你、你不要装傻啊！"
        },
        {
          "role": "钟离",
          "text": "哈哈，装傻又是什么说法。嗯，刚才那扇子，属实不错。"
        },
        {
          "role": "派蒙",
          "text": "钟离！！"
        },
        {
          "role": "钟离",
          "text": "…我是个闲人，四处逛逛本是应当。途中遇见什么，那也是缘分所致，何须言谢。"
        },
        {
          "role": "钟离",
          "text": "倒不如说，天下如此之大，到处逛逛，多走多看，才能常感怀念。"
        },
        {
          "role": "旅行者",
          "text": "你很想念过去吗？"
        },
        {
          "role": "钟离",
          "text": "怎么会。我现在是人，人总是活在当下。"
        },
        {
          "role": "钟离",
          "text": "游龙入云，纵横天下，志远心高，浩瀚无垠。…不无道理。"
        },
        {
          "role": "钟离",
          "text": "东西南北，何方不得意。天地山海，尽是玲珑处。以后有时间，还得多出去走走。"
        }
      ]
    }
  ]
}