{
  "quest_id": 74114,
  "chapter_num": null,
  "chapter_title": "三人行…先寻明师·之二",
  "type": "wq",
  "route": "In Expert Company? (II)",
  "stories": [
    {
      "story_id": 74114,
      "title": "三人行…先寻明师·之二",
      "description": "邱老板一行人似乎又遇见了麻烦…",
      "dialogues": [
        {
          "role": "邱老板",
          "text": "唉，那些映影画片不会被水泡坏吧…"
        },
        {
          "role": "弈丰",
          "text": "放心吧老板，这个箱子可牢靠了，水渗不进去。"
        },
        {
          "role": "兴晔",
          "text": "还好我们的映影机没有掉进水里，不然可就完蛋了…"
        },
        {
          "role": "邱老板",
          "text": "没关系，我们的那个箱子是防水的。现在我们只需要潜下去，把箱子捞上来…"
        },
        {
          "role": "兴晔",
          "text": "老板，但我们三个人里谁都不会潜水啊。"
        },
        {
          "role": "弈丰",
          "text": "我倒是会游泳，但潜水真的一窍不通啊。"
        },
        {
          "role": "邱老板",
          "text": "我们…上次去冒险家协会发布的委托，还挂在委托板上吗？"
        },
        {
          "role": "弈丰",
          "text": "老板，你上次不是说要我们赶紧去把那委托给撤了吗？"
        },
        {
          "role": "兴晔",
          "text": "我们昨天才把这件事给办了，协会那边说，今天就能把我们预付的委托费给退回来。"
        },
        {
          "role": "邱老板",
          "text": "呃…如果我们想重新发布委托，要交额外的手续费吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们拍好映影了吗？",
              "dialogues": []
            },
            {
              "text": "你们怎么在这里？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "邱老板",
          "text": "冒险家…旅行者，您真是我们的及时雨啊！"
        },
        {
          "role": "邱老板",
          "text": "您会潜水吗？或者说，您能帮忙找一位有空来帮忙的潜水员吗？"
        },
        {
          "role": "旅行者",
          "text": "你们要…到水下拍映影？"
        },
        {
          "role": "弈丰",
          "text": "我们可没那个本事，也买不起防水的映影设备。"
        },
        {
          "role": "兴晔",
          "text": "只是单纯因为，我们装映影画片的箱子掉进水里了。"
        },
        {
          "role": "邱老板",
          "text": "好了，你们俩可少说两句吧！旅行者，请您务必帮帮忙啊。"
        },
        {
          "role": "邱老板",
          "text": "报酬的事您不用担心，和上次一样，当面给您结清。"
        },
        {
          "type": "subtitle",
          "text": "取回装着「映影画片」的箱子"
        },
        {
          "type": "subtitle",
          "text": "向邱老板一行人回报"
        },
        {
          "role": "邱老板",
          "text": "哎哟，还是您靠谱，旅行者。还是您靠谱！"
        },
        {
          "role": "邱老板",
          "text": "要是没您帮忙，这一整箱的映影画片全得泡汤。"
        },
        {
          "role": "邱老板",
          "text": "我们得先回城里，把这些映影画片交给热塞尔先生。"
        },
        {
          "role": "邱老板",
          "text": "然后…再顺便吃顿饭。旅行者，如果您有兴趣的话，也请一起来吧。"
        },
        {
          "role": "邱老板",
          "text": "等吃完了饭，我再把报酬给您结清。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好啊。",
              "dialogues": []
            },
            {
              "text": "正好饿了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "邱老板",
          "text": "行！那事情就这么定了。"
        },
        {
          "role": "邱老板",
          "text": "弈丰，等会你去把这箱子映影画片带去交给热塞尔先生。"
        },
        {
          "role": "邱老板",
          "text": "兴晔，你…去周围买点好菜。我最近研究了一下那道白淞鲜汤，今天正好给热塞尔先生露一手。"
        },
        {
          "role": "兴晔",
          "text": "老板，我们都去饭馆吃饭了。您为什么非得自己上手？"
        },
        {
          "role": "邱老板",
          "text": "这不是…便宜吗…"
        },
        {
          "role": "邱老板",
          "text": "咳！事情就这么定了，赶紧出发。"
        },
        {
          "role": "邱老板",
          "text": "旅行者，您就跟着我走吧。"
        },
        {
          "type": "subtitle",
          "text": "与邱老板对话"
        },
        {
          "role": "邱老板",
          "text": "旅行者，您拿到茉洁草了吗？"
        },
        {
          "role": "旅行者",
          "text": "拿到了。"
        },
        {
          "role": "邱老板",
          "text": "这锅还真是奇特，唔…但用法应该和璃月的一样吧。"
        },
        {
          "role": "兴晔",
          "text": "老板，菜都买回来了，但那家店里的茉洁草都卖光了。"
        },
        {
          "role": "兴晔",
          "text": "我一时半会也找不到其他店卖这个…"
        },
        {
          "role": "邱老板",
          "text": "这…就差这一份食材。那个，旅行者…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我去拿点回来吧。",
              "dialogues": []
            },
            {
              "text": "一起算进报酬里。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "邱老板",
          "text": "多谢您帮忙。放心，我懂冒险家的规矩，绝不会让你白跑的。"
        },
        {
          "type": "subtitle",
          "text": "将茉洁草交给邱老板"
        },
        {
          "type": "subtitle",
          "text": "与邱老板对话"
        },
        {
          "role": "邱老板",
          "text": "好，我这就开始做菜。必须得快点，热塞尔先生也快到了…"
        },
        {
          "type": "subtitle",
          "text": "与邱老板对话"
        },
        {
          "role": "邱老板",
          "text": "旅行者，向您介绍，这就是那位映影大师，热塞尔先生。"
        },
        {
          "role": "邱老板",
          "text": "热塞尔先生，这是旅行者，一位身手高强的冒险家。"
        },
        {
          "role": "邱老板",
          "text": "您要是以后准备拍武打类的映影，旅行者绝对能做一号演员！"
        },
        {
          "role": "热塞尔",
          "text": "呵呵，邱老板也说得太夸张了，我并不是什么映影大师。"
        },
        {
          "role": "热塞尔",
          "text": "我只不过是对映影中的光影运用方式略有研究罢了。"
        },
        {
          "role": "邱老板",
          "text": "哎呀，您太谦虚了。您那些映影里的光影，简直都能开口说话啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "映影中的光影运用方式？",
              "dialogues": [
                {
                  "role": "热塞尔",
                  "text": "是的。在我的映影理论中，光影的运用，即是情绪的运用。"
                }
              ]
            },
            {
              "text": "光影在映影里很重要吗？",
              "dialogues": [
                {
                  "role": "热塞尔",
                  "text": "当然了。在我的映影理论中，光影是表达画面情绪的重要方式。"
                }
              ]
            }
          ]
        },
        {
          "role": "热塞尔",
          "text": "但是…怎么说呢，现在枫丹的映影界里，我的这种理论暂时没有受到重视。"
        },
        {
          "role": "热塞尔",
          "text": "大部分导演还是更喜欢用直接的动作，或者场景来表达映影故事。"
        },
        {
          "role": "热塞尔",
          "text": "我拍摄了好几部用纯粹的光影变化叙事的映影，几乎没有人感兴趣。"
        },
        {
          "role": "热塞尔",
          "text": "但是现在，总算有一位导演认为我的光影理论有价值了。"
        },
        {
          "role": "邱老板",
          "text": "导演？我？哈哈哈，您别开玩笑了，我之前只是个卖茶叶的。"
        },
        {
          "role": "热塞尔",
          "text": "谁说卖茶叶的商人不能做导演？我之前还只是一位记者呢。"
        },
        {
          "role": "邱老板",
          "text": "记者…那您之前，肯定也很擅长写报道？就是报纸上的那种。"
        },
        {
          "role": "热塞尔",
          "text": "算是吧。怎么了？"
        },
        {
          "role": "邱老板",
          "text": "嗯…那正好…"
        },
        {
          "role": "邱老板",
          "text": "啊！没什么！没什么！咱们之后合作的时间还多的是啊，哈哈哈！"
        },
        {
          "role": "？？？",
          "text": "在邱老板爽朗的笑声中，大家都入了座。"
        },
        {
          "role": "？？？",
          "text": "吃完饭后，邱老板又额外做了一份食物，打包完后，塞进了你的包里…"
        },
        {
          "type": "subtitle",
          "text": "等待到第二天上午（8:00-10:00）"
        }
      ]
    }
  ]
}