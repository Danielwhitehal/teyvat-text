  "stories": [
    {
      "story_id": 23021,
      "title": "问题的转化·负载问题",
      "description": "终于，拉菲克的设计来到了检验的阶段…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与拉菲克对话"
        },
        {
          "role": "拉菲克",
          "text": "旅行者！你来得正好，船刚刚下水，十分平稳。"
        },
        {
          "role": "拉菲克",
          "text": "我的计算果然没有任何问题！"
        },
        {
          "role": "绮珊",
          "text": "所以，我们说好的负载试验什么时候开始？"
        },
        {
          "role": "拉菲克",
          "text": "别着急嘛，旅行者都来了，我们马上开始。"
        },
        {
          "role": "旅行者",
          "text": "负载试验是什么？"
        },
        {
          "role": "拉菲克",
          "text": "简单来说，就是用重物来测试船的负载能力。"
        },
        {
          "role": "拉菲克",
          "text": "嗯…也就是说，需要有人和我一起把重物都搬到船上去…"
        },
        {
          "role": "拉菲克",
          "text": "旅行者，我上次就发现你身强体壮，力量充沛，非常擅长这种工作…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来这才是让我来的原因。",
              "dialogues": []
            },
            {
              "text": "生气。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "拉菲克",
          "text": "没、没有啦，我是真的没法一个人搞定这件事，只能拜托你来帮忙了。"
        },
        {
          "role": "拉菲克",
          "text": "而且报酬绝对不会少！放心吧，我前几天刚帮人去修好了一艘大船，拿了不少钱呢！"
        },
        {
          "role": "绮珊",
          "text": "哦…不少钱啊…"
        },
        {
          "role": "拉菲克",
          "text": "欸？那个，我几乎把钱都投入造船里了…"
        },
        {
          "role": "绮珊",
          "text": "全部？"
        },
        {
          "role": "拉菲克",
          "text": "还留着一点！哎呀，我会请你喝咖啡的啦…"
        },
        {
          "role": "拉菲克",
          "text": "旅行者，我们赶紧开始吧，快快快！"
        },
        {
          "type": "subtitle",
          "text": "收集重物"
        },
        {
          "type": "subtitle",
          "text": "收集重物"
        },
        {
          "type": "subtitle",
          "text": "把重物搬上船"
        },
        {
          "role": "绮珊",
          "text": "唉，这艘船真能载得动这么重的东西吗…"
        },
        {
          "type": "subtitle",
          "text": "回去和拉菲克对话"
        },
        {
          "role": "拉菲克",
          "text": "好…嘞！这样就可以了，让我们来看看会发生什…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！那边漏水了！"
        },
        {
          "role": "拉菲克",
          "text": "什么？！"
        },
        {
          "role": "派蒙",
          "text": "船，船都歪了！怎么回事呀！"
        },
        {
          "role": "拉菲克",
          "text": "快，快把东西搬下去，肯定是出问题了！"
        },
        {
          "role": "？？？",
          "text": "和拉菲克匆匆忙忙地把所有东西都搬下了船…"
        },
        {
          "role": "拉菲克",
          "text": "呼…呼…还好东西不多…"
        },
        {
          "role": "拉菲克",
          "text": "这到底…到底是哪里出问题了…"
        },
        {
          "role": "绮珊",
          "text": "我当初说什么来着？你计算的那些理论数据都太极限了，这样是不可靠的。"
        },
        {
          "role": "拉菲克",
          "text": "呼…我…我…好吧…"
        },
        {
          "role": "拉菲克",
          "text": "不应该啊，我都算得那么精确了…"
        },
        {
          "role": "拉菲克",
          "text": "旅行者，谢谢你帮忙，这些是报酬，请你收下吧 。"
        },
        {
          "role": "拉菲克",
          "text": "我要回去重新计算一遍…绮珊，能再帮我一下吗？"
        },
        {
          "role": "绮珊",
          "text": "…说得好像我都没帮忙似的。"
        },
        {
          "role": "绮珊",
          "text": "交给我吧，计算完了之后记得请我喝咖啡。"
        },
        {
          "type": "subtitle",
          "text": "回去和拉菲克对话"
        },
        {
          "role": "拉菲克",
          "text": "太棒了，非常成功！"
        },
        {
          "role": "拉菲克",
          "text": "船体的结构没有问题…吃水线也很稳定，也没有倾倒。"
        },
        {
          "role": "拉菲克",
          "text": "绮珊，你看看，我的设计和计算完美无缺！"
        },
        {
          "role": "绮珊",
          "text": "这才是负载试验的第一阶段，别高兴太早了。"
        },
        {
          "role": "绮珊",
          "text": "而且你还没有考虑到天气因素和航行时货物挪移导致的船体重心问题…"
        },
        {
          "role": "拉菲克",
          "text": "呃…呃，我会考虑的，你就先让我高兴一下嘛…"
        },
        {
          "role": "拉菲克",
          "text": "对了旅行者，这是你的报酬，请先收下吧。"
        },
        {
          "role": "拉菲克",
          "text": "绮珊啊，你就不能给我打打气吗？"
        },
        {
          "role": "绮珊",
          "text": "可是在造船这件事上，给人打气鼓劲没用啊。"
        },
        {
          "role": "绮珊",
          "text": "你还是好好想想，怎么给自己的钱包打气鼓劲吧。"
        },
        {
          "type": "subtitle",
          "text": "回去和拉菲克对话"
        },
        {
          "role": "拉菲克",
          "text": "这艘船的载重能力绝对不会有问题！放心吧！"
        }
      ]
    }
  ]
