{
  "quest_id": 72211,
  "chapter_num": null,
  "chapter_title": "寝子是只猫·神社食谱",
  "type": "wq",
  "route": "Neko Is a Cat: Shrine Recipe",
  "stories": [
    {
      "story_id": 72211,
      "title": "寝子是只猫·神社食谱",
      "description": "「浅濑神社代宫司」寝子似乎有事找你…",
      "dialogues": [
        {
          "role": "「寝子」",
          "text": "是汝啊，来得正好。正好奴家有事情要人帮忙。"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "「寝子」",
          "text": "多亏了汝，现在神社也比以前好了。很快很快就会有很多很多人来神社了。"
        },
        {
          "role": "「寝子」",
          "text": "奴家叮嘱小家伙们，到时候可不能像现在这样，一定要在人类面前保持风度。"
        },
        {
          "role": "「寝子」",
          "text": "但它们已经疯惯了，不爱听奴家的话。"
        },
        {
          "role": "「寝子」",
          "text": "不过奴家想到了一个办法。"
        },
        {
          "role": "旅行者",
          "text": "办法？"
        },
        {
          "role": "「寝子」",
          "text": "奴家还很小很小的时候，也喜欢到处玩。那时候，阿响为了让奴家和别的猫乖乖听话，会做很好吃的饭。"
        },
        {
          "role": "派蒙",
          "text": "好、好吃的！"
        },
        {
          "role": "「寝子」",
          "text": "那时候呀，只要那锅饭一端出来，猫们马上就会从树上、屋顶上下来。就算饭好烫好烫、舌头好热好热，也忍不住。"
        },
        {
          "role": "「寝子」",
          "text": "阿响每次都会做好大一锅，分给猫和人类一起吃，来神社的人也有份。"
        },
        {
          "role": "「寝子」",
          "text": "不过，百目鬼的食量可大了，每次吃好多好多。不像奴家这样有风度。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以说…",
              "dialogues": []
            },
            {
              "text": "我们帮你做饭？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "不错，很有悟性嘛。奴家要请汝等做饭。"
        },
        {
          "role": "旅行者",
          "text": "我不是怀疑寝子的智慧…"
        },
        {
          "role": "派蒙",
          "text": "不过寝子真的知道饭要怎么做吗？"
        },
        {
          "role": "「寝子」",
          "text": "喵喵？"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "「寝子」",
          "text": "这、这种东西，就交给汝等想办法了！难道什么都要奴家自己做吗？"
        },
        {
          "role": "「寝子」",
          "text": "哎呀，不过那个饭，真是太好吃了哪。那个味道，就算走了好远好远、过了好久好久，都可以闻到…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我觉得我们还是应该努力一下！毕竟，为了神社嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "饭里有什么？",
              "dialogues": []
            },
            {
              "text": "派蒙真好懂。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "什么嘛，我可是热心助猫！寝子，饭里有什么材料，还记得吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "奴家当然记得。有鱼的肉、动物的肉、水里长的草，还有白米。"
        },
        {
          "role": "派蒙",
          "text": "唔，就是鱼肉、兽肉、海草和稻米对吧…怎么做的还记得吗？"
        },
        {
          "role": "「寝子」",
          "text": "不记得。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看来得找个厨师问问。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "但是，哪个厨师会做猫饭呢…不如我们去问问大祐和悦子吧，他们说不定知道要怎么办。"
                }
              ]
            },
            {
              "text": "去找那两个冒险家问问看。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对喔，大祐和悦子是冒险家，说不定他们会知道些什么。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与大祐和悦子对话"
        },
        {
          "role": "大祐",
          "text": "悦子小姐，我们接着去哪里探索？"
        },
        {
          "role": "悦子",
          "text": "呼…先歇一歇吧…"
        },
        {
          "role": "悦子",
          "text": "嗯？是你们啊，你们找我们有事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于可靠的厨师…"
        },
        {
          "role": "大祐",
          "text": "在清籁岛的地方找厨师？"
        },
        {
          "role": "派蒙",
          "text": "事情是这样的。寝子她…"
        },
        {
          "role": "大祐",
          "text": "你说…寝子大人拜托你们帮忙准备食物吗？"
        },
        {
          "role": "大祐",
          "text": "啊…可恶！要是我有烹饪的才能就好了！"
        },
        {
          "role": "悦子",
          "text": "这么说，你们是想要找一个能帮你们搞明白…「怎么用这些食材，做出猫会喜欢的饭」的厨师，对吧？"
        },
        {
          "role": "悦子",
          "text": "我想想…厨师…厨师…"
        },
        {
          "role": "悦子",
          "text": "喔，你们不如去稻妻城，去找「木南料亭」的木南杏奈小姐吧。"
        },
        {
          "role": "悦子",
          "text": "木南小姐人很好，厨艺也很不错，应该能帮你们这个忙。"
        },
        {
          "role": "旅行者",
          "text": "谢谢，我们这就去看看。"
        },
        {
          "role": "悦子",
          "text": "不用谢，快点去吧，我和大祐还要继续制订探索计划。"
        },
        {
          "role": "悦子",
          "text": "呵呵，希望这个神社真的可以热闹起来。"
        },
        {
          "role": "悦子",
          "text": "这样，也不枉你和那位寝子忙前忙后这么长时间。"
        },
        {
          "type": "subtitle",
          "text": "向木南杏奈请教"
        },
        {
          "role": "木南杏奈",
          "text": "怎么样，你们找到三份海草了吗？"
        },
        {
          "role": "木南杏奈",
          "text": "你好，欢迎光临「木南料亭」，请问你们有什么需要的吗？"
        },
        {
          "role": "旅行者",
          "text": "关于寝子的饭…"
        },
        {
          "role": "木南杏奈",
          "text": "「寝子」？这个名字，难不成是猫吗？"
        },
        {
          "role": "派蒙",
          "text": "你认识寝子吗？"
        },
        {
          "role": "木南杏奈",
          "text": "哎呀，不是。我只是觉得，这个名字很适合猫呢。"
        },
        {
          "role": "旅行者",
          "text": "真是强大的直觉…"
        },
        {
          "role": "派蒙",
          "text": "先不说这些，事情是这样的…"
        },
        {
          "role": "木南杏奈",
          "text": "清籁岛上…有一座浅濑神社，神社里有一只会说话的猫？！那只猫还拜托你们做一道菜给它？"
        },
        {
          "role": "木南杏奈",
          "text": "欸？欸！真的吗？我从来都没听说过！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是、是真的…",
              "dialogues": []
            },
            {
              "text": "你可以自己过去看看。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "木南杏奈",
          "text": "在清籁岛上对吧？等有机会，我一定要自己去看看…"
        },
        {
          "role": "旅行者",
          "text": "那个…寝子的饭…"
        },
        {
          "role": "木南杏奈",
          "text": "啊…对哦，差点忘了正事…我想想。"
        },
        {
          "role": "木南杏奈",
          "text": "唔…猫也会喜欢的饭吗…"
        },
        {
          "role": "派蒙",
          "text": "很难吗？"
        },
        {
          "role": "木南杏奈",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "很、很难吗？"
        },
        {
          "role": "木南杏奈",
          "text": "这是对「木南」家名的挑战！我一定要克服！"
        },
        {
          "role": "木南杏奈",
          "text": "用鱼肉、兽肉、海草、稻米做出能让猫趋之若鹜的美食，就交给我吧。"
        },
        {
          "role": "派蒙",
          "text": "我、我也想吃！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也想吃…",
              "dialogues": []
            },
            {
              "text": "那就交给你了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "木南杏奈",
          "text": "没问题！"
        },
        {
          "role": "木南杏奈",
          "text": "我先构思一下食谱，你们先帮我准备三份海草。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "木南杏奈",
                  "text": "那就拜托你们了，只要三份海草就好，找到之后就拿来给我吧。"
                }
              ]
            },
            {
              "text": "你已经知道怎么做了？",
              "dialogues": [
                {
                  "role": "木南杏奈",
                  "text": "有了一点想法，但还没有完全想好…"
                },
                {
                  "role": "木南杏奈",
                  "text": "你先去帮我找三份海草过来吧，拜托你们了。"
                }
              ]
            }
          ]
        },
        {
          "role": "木南杏奈",
          "text": "你好，欢迎光临「木南料亭」，请问你们有什么需要的吗？"
        },
        {
          "role": "木南杏奈",
          "text": "你好…哎呀，是神里小姐的朋友！快请进，有什么我可以帮你们的吗？"
