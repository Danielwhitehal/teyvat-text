                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "将三份海草带给木南杏奈"
        },
        {
          "type": "subtitle",
          "text": "将三份海草带给木南杏奈"
        },
        {
          "role": "木南杏奈",
          "text": "太好了，你们稍等一下，我对于怎么做这道菜…已经有思路了！"
        },
        {
          "role": "木南杏奈",
          "text": "完成了！"
        },
        {
          "role": "派蒙",
          "text": "闻着好香啊！唔唔，好想尝尝看…"
        },
        {
          "role": "木南杏奈",
          "text": "名字就叫做…嗯…既然这道饭是给一只会说话的猫做的，那这道饭就叫做「活力喵饭」吧！"
        },
        {
          "role": "木南杏奈",
          "text": "总之，这份饭你们拿好。"
        },
        {
          "role": "木南杏奈",
          "text": "对了，食谱我也抄一份给你。"
        },
        {
          "role": "派蒙",
          "text": "太好了，那旅行者也能随时给我做…做「喵饭」了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是猫吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "真没礼貌！美食是全世界共通的，是我和寝子的共同语言。"
                },
                {
                  "role": "派蒙",
                  "text": "对了！要感谢木南小姐才行。"
                }
              ]
            },
            {
              "text": "谢谢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "木南杏奈",
          "text": "不用谢啦，这道饭和食谱，就当做给那位寝子的礼物啦。"
        },
        {
          "role": "木南杏奈",
          "text": "等我有空了，一定会去那座「浅濑神社」拜访的。"
        },
        {
          "role": "木南杏奈",
          "text": "好了，你们快回去吧，别让寝子等急啦。"
        },
        {
          "type": "subtitle",
          "text": "向寝子回报"
        },
        {
          "role": "「寝子」",
          "text": "好香…汝等，做好饭了吗？"
        },
        {
          "role": "旅行者",
          "text": "做好了。"
        },
        {
          "role": "「寝子」",
          "text": "喵喵！真厉害，快给奴家尝尝看。"
        },
        {
          "role": "「寝子」",
          "text": "……"
        },
        {
          "role": "「寝子」",
          "text": "看起来，和阿响做的饭有些不一样…"
        },
        {
          "role": "派蒙",
          "text": "应、应该很好吃的，我们先一起尝尝看吧！"
        },
        {
          "role": "派蒙",
          "text": "真好吃！"
        },
        {
          "role": "「寝子」",
          "text": "……喵。"
        },
        {
          "role": "派蒙",
          "text": "（寝子是因为饭和「阿响」做得不一样，不开心吗…）"
        },
        {
          "role": "「寝子」",
          "text": "很好吃，汝等，很可靠呢。"
        },
        {
          "role": "旅行者",
          "text": "那就好。"
        },
        {
          "role": "「寝子」",
          "text": "虽然，汝等做的饭，和阿响做的饭味道不一样。"
        },
        {
          "role": "「寝子」",
          "text": "但是，和汝等一起吃饭时的感觉，和之前奴家和阿响一起吃饭时的感觉，一模一样。"
        },
        {
          "role": "「寝子」",
          "text": "人类啊，这是为什么呢？汝等人类，难道会什么妖法不成？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很久没人给你做饭了吧。",
              "dialogues": []
            },
            {
              "text": "因为做的人很热心吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "…无论如何，谢谢汝等。好久没吃过这样好吃的饭了。"
        },
        {
          "role": "「寝子」",
          "text": "小家伙们肯定会喜欢的。汝再跑一趟，把这饭带给它们。"
        },
        {
          "role": "「寝子」",
          "text": "既然奴家喜欢，那它们肯定会喜欢。然后，吃了这么好吃的饭，一定也会愿意听奴家的了。"
        },
        {
          "type": "subtitle",
          "text": "将「美味的活力喵饭」带给小猫们"
        },
        {
          "role": "「寝子」",
          "text": "做饭的事就交给汝等了。"
        },
        {
          "role": "「寝子」",
          "text": "然后，做好了以后，和奴家、还有小家伙们一起吃吧。"
        },
        {
          "type": "subtitle",
          "text": "将「美味的活力喵饭」带给小猫们"
        },
        {
          "role": "悦子",
          "text": "怎么了？快去城里找木南杏奈小姐吧。"
        },
        {
          "type": "subtitle",
          "text": "将「美味的活力喵饭」带给小猫们"
        },
        {
          "role": "大祐",
          "text": "唉，要是我有烹饪的才能就好了…"
        },
        {
          "type": "subtitle",
          "text": "向寝子回报"
        },
        {
          "role": "「寝子」",
          "text": "汝等已经把饭带给那些小家伙了吗？"
        },
        {
          "role": "旅行者",
          "text": "都吃得很开心。"
        },
        {
          "role": "「寝子」",
          "text": "是吗？那样就好了，喵喵…"
        },
        {
          "role": "「寝子」",
          "text": "奴家已经很久没有吃过这样好吃的饭了。"
        },
        {
          "role": "「寝子」",
          "text": "喵喵喵…虽然奴家现在也不需要吃饭、不需要喝水了，但饭的滋味，真是让奴家欲罢不能呢…"
        },
        {
          "role": "「寝子」",
          "text": "有个小家伙叫「阿饭」，就是因为奴家想要用世界上最好的东西给她起名。"
        },
        {
          "role": "旅行者",
          "text": "阿响做的饭叫什么名字？"
        },
        {
          "role": "「寝子」",
          "text": "名字？饭还能有名字？"
        },
        {
          "role": "旅行者",
          "text": "这个饭叫「活力喵饭」。"
        },
        {
          "role": "「寝子」",
          "text": "名字好复杂。不过奴家不讨厌。"
        },
        {
          "role": "「寝子」",
          "text": "…汝说得也对。毕竟，饭是好东西。好东西都应该有名字才对。"
        },
        {
          "role": "「寝子」",
          "text": "喵喵，等阿响回来了，奴家再问她吧。然后，汝也可以做汝的饭给她吃…"
        },
        {
          "role": "「寝子」",
          "text": "然后，她再做她的饭给汝吃。然后，奴家可以吃两种不同的，又都很好吃的饭。"
        },
        {
          "role": "「寝子」",
          "text": "所以说，奴家得把神社打理得更好。等她回来了，就一起吃饭。"
        },
        {
          "role": "「寝子」",
          "text": "谢谢。很好吃。喵喵。"
        }
      ]
    }
  ]
}