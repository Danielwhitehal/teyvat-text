{
  "quest_id": 21004,
  "chapter_num": null,
  "chapter_title": "宝藏归离",
  "type": "iq",
  "route": "Treasure Lost, Treasure Found",
  "stories": [
    {
      "story_id": 21004,
      "title": "宝藏归离",
      "description": "一条奇怪的诫语，似乎隐藏着什么秘密…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与索拉雅对话"
        },
        {
          "role": "索拉雅",
          "text": "「归终四诫」…到底是在暗示什么呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我准备好了。",
              "dialogues": [
                {
                  "role": "索拉雅",
                  "text": "哈哈哈，你可真有干劲，那好吧，我们开始解读一下这个「归终四诫」。"
                }
              ]
            },
            {
              "text": "去找宝藏吧！",
              "dialogues": [
                {
                  "role": "索拉雅",
                  "text": "一说到宝藏，感觉你就精神焕发…算了，我们开始解读这个「归终四诫」吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "索拉雅",
          "text": "「教之以智、律之以德、坚其筋骨，众志一心，四者汇之而成『归离集』。」"
        },
        {
          "role": "索拉雅",
          "text": "从字面上来看，确实是类似于一种对于日常生活的「劝诫」。"
        },
        {
          "role": "索拉雅",
          "text": "不过，这句话哪里是在暗示着宝藏的线索呢…"
        },
        {
          "role": "索拉雅",
          "text": "…没办法了，还是用我们学者最笨，也是最自讨苦吃的方法吧。"
        },
        {
          "role": "索拉雅",
          "text": "先前，我们发现那七段话的地方，都是在各种形式的「遗迹」里。"
        },
        {
          "role": "索拉雅",
          "text": "既然现在我们不知道如何入手，那么，就继续去搜索「遗迹」看看吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "到哪里找…",
              "dialogues": [
                {
                  "role": "索拉雅",
                  "text": "嗯…搜索区域的话，就暂时划定在「归离原」里吧。"
                },
                {
                  "role": "索拉雅",
                  "text": "但是你看我这样的学者，一定跟不上你的步伐。"
                },
                {
                  "role": "索拉雅",
                  "text": "所以，搜索遗迹的事就拜托你了，如果找到线索的话，就回来告诉我吧。"
                }
              ]
            },
            {
              "text": "全，全部要找一遍吗…",
              "dialogues": [
                {
                  "role": "索拉雅",
                  "text": "当然不是，如果把搜索范围扩大到整片璃月的话，就凭我们两个人绝对搜索不完。"
                },
                {
                  "role": "索拉雅",
                  "text": "既然是「归离原」上「归离集」的宝藏，那么我们就缩小搜索范围。"
                },
                {
                  "role": "索拉雅",
                  "text": "搜索区域就暂定在这片「归离原」之内吧。"
                },
                {
                  "role": "索拉雅",
                  "text": "啊，对了，你看我这样的学者，一定跟不上你的步伐。"
                },
                {
                  "role": "索拉雅",
                  "text": "所以，搜索遗迹的事就拜托你了，如果找到线索的话，就回来告诉我吧。"
                }
              ]
            },
            {
              "text": "我这就去把璃月里的遗迹全部找一遍！",
              "dialogues": [
                {
                  "role": "索拉雅",
                  "text": "等一下！你别这么激动，璃月这么大，你想要找到什么时候去啊？！"
                },
                {
                  "role": "索拉雅",
                  "text": "听见宝藏就激动成这样…我到底该说你什么好…"
                },
                {
                  "role": "索拉雅",
                  "text": "既然宝藏来自于「归离原」上的「归离集」，那我们首先缩小一下搜索范围。"
                },
                {
                  "role": "索拉雅",
                  "text": "我想想…搜索范围就暂定在这片「归离原」之内…"
                },
                {
                  "role": "索拉雅",
                  "text": "喂，听我说完再走！记住了，一定要仔细搜索遗迹，如果有什么发现，就带回来告诉我。"
                },
                {
                  "role": "索拉雅",
                  "text": "记住了，在「归离原」之内搜索就好，别跑太远了！"
                }
              ]
            }
          ]
        },
        {
          "role": "索拉雅",
          "text": "这么说起来，我曾经在这附近发现过一处遗迹，而且，我还在里面发现了一个奇怪的圆盘，上面还有字迹…"
        },
        {
          "role": "索拉雅",
          "text": "不过，当时我也只是做了一些孤立的研究，没有再做发散…"
        },
        {
          "role": "索拉雅",
          "text": "现在回想起来，说不定那片遗迹里的那个圆盘，会和这「归终四诫」有所关系。"
        },
        {
          "role": "索拉雅",
          "text": "唔…这样，我给你在地图上标记出来，你可以去看一下，说不定真能发现什么线索。"
        },
        {
          "role": "派蒙",
          "text": "这圆盘上好像有字迹…不过，大部分都看不清了。"
        },
        {
          "role": "派蒙",
          "text": "说不定，是有什么特殊的含义呢。"
        },
        {
          "type": "subtitle",
          "text": "前往遗迹，寻找奇怪的圆盘"
        },
        {
          "type": "subtitle",
          "text": "前往遗迹，寻找奇怪的圆盘"
        },
        {
          "type": "subtitle",
          "text": "前往遗迹，寻找奇怪的圆盘"
        },
        {
          "type": "subtitle",
          "text": "前往遗迹，寻找奇怪的圆盘"
        },
        {
          "type": "subtitle",
          "text": "询问索拉雅"
        },
        {
          "role": "索拉雅",
          "text": "即使是魔神，也有着逃不脱的命运…"
        },
        {
          "role": "旅行者",
          "text": "在四个遗迹里找到了四条线索。"
        },
        {
          "role": "索拉雅",
          "text": "四个遗迹，四条线索…刚好和「归终四诫」的诫语数量一样。"
        },
        {
          "role": "索拉雅",
          "text": "不过，这四句话都是关于「归终四诫」中某一条的解释。"
        },
        {
          "role": "索拉雅",
          "text": "想要正确解读，「归终四诫」的原文应该才是关键，这四条都是辅助。"
        },
        {
          "role": "索拉雅",
          "text": "要把这五段话都结合起来，但是到底该怎么理解呢？"
        },
        {
          "role": "旅行者",
          "text": "「汇之而成」…"
        },
        {
          "role": "索拉雅",
          "text": "汇之而成…听起来像是在说，这四段话可以用某种方式结合起来…"
        },
        {
          "role": "索拉雅",
          "text": "等等，我记得，这四段「诫语」都各自存在于某一处遗迹之中…"
        },
        {
          "role": "索拉雅",
          "text": "唔…我有一个不成熟的猜测。如果想要解读这四段「诫语」，也许还需要借助一下这些「诫语」各自所在的<color=#00E1FFFF>「遗迹」</color>…"
        },
        {
          "role": "索拉雅",
          "text": "不过，具体的解读方式，我还要再思考一下…你也可以想想，如果有什么好想法，直接去付诸实施也可以。"
        },
        {
          "role": "索拉雅",
          "text": "毕竟你不像我这个「弱不禁风」的学者，跑几步就没劲了…唉，真羡慕你，有这么好的体力…"
        },
        {
          "role": "索拉雅",
          "text": "好了，我再在这里仔细思考一下，如果你有什么想法，或者发现的话，就来告诉我吧。"
        },
        {
          "type": "subtitle",
          "text": "找到最后的遗迹"
        },
        {
          "role": "索拉雅",
          "text": "根据我那个不成熟的猜测，想要解读这四段「诫语」，也许还需要借助每段「诫语」各自所在的「遗迹」。"
        },
        {
          "role": "索拉雅",
          "text": "至于具体如何「借助」，我还没有想好。而且…唉，我也没那么多力气，把我的每一个猜测都试一遍…"
        },
        {
          "role": "索拉雅",
          "text": "但是这么一直想下去，感觉也不会有什么突破啊…"
        },
        {
          "type": "subtitle",
          "text": "开启遗迹机关"
        },
        {
          "role": "索拉雅",
          "text": "你们找到宝藏了吗？"
        },
        {
          "type": "subtitle",
          "text": "击败遗迹守卫"
        },
        {
          "type": "subtitle",
          "text": "开启机关"
        },
        {
          "type": "subtitle",
          "text": "取得宝藏"
        },
        {
          "role": "索拉雅",
          "text": "你们找到宝藏了吗？"
        },
        {
          "type": "subtitle",
          "text": "与索拉雅对话"
        },
        {
          "role": "索拉雅",
          "text": "怎么样？你们找到宝藏了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了，确实是在「汇成之地」"
        },
        {
          "role": "索拉雅",
          "text": "原来如此…还真是和「归终四诫」里说的一样，宝藏在四诫的「汇成之地」啊。"
        },
        {
          "role": "索拉雅",
          "text": "设置谜题的那个人，一定很尊敬「归终」吧。"
        },
        {
          "role": "索拉雅",
          "text": "即使故乡被毁灭，也要以这种方式把「归终四诫」给流传下去。"
        },
        {
          "role": "索拉雅",
          "text": "而那位定下这四诫的「归终」，也一定深爱着她庇护着的子民。"
        },
        {
          "role": "索拉雅",
          "text": "她希望自己的子民们拥有智慧，用道德约束自己，祝福他们身体强健，而且团结一心，一同保护自己的家园「归离集」…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但是她还是失败了。",
              "dialogues": [
                {
                  "role": "索拉雅",
                  "text": "失败了？这么说也没错，她死去了…「归离集」被毁灭，她的子民们也流离失所。"
                },
                {
                  "role": "索拉雅",
                  "text": "不过，如今我们不是让她的「归终四诫」重见天日了吗？"
                },
                {
                  "role": "索拉雅",
                  "text": "这是那位「归终」为她的子民们亲手订下的诫语，和送上的祝福。"
                },
                {
                  "role": "索拉雅",
                  "text": "秉承着这份「归终四诫」，她曾经在这片大地上，和自己的子民们携手前进。"
                },
                {
                  "role": "索拉雅",
                  "text": "即使她已经死去了，但是她的信念和理想绝不会就此消失。"
                },
                {
                  "role": "索拉雅",
                  "text": "而且，那位崇敬着她的人可真是聪明，居然想到用「藏宝」的方式，把「归终四诫」给传下来。"
                },
                {
                  "role": "索拉雅",
                  "text": "不过，也不知道在那个人心中，真正的宝贝到底是金银珠宝，还是这份「归终四诫」呢…"
                },
                {
                  "role": "索拉雅",
                  "text": "哈哈，要我说，比起那些金银珠宝，这份「诫语」才是真正的宝物。"
                },
                {
                  "role": "索拉雅",
                  "text": "…但是，要真让人选，又有多少人会抛弃财宝，选这份「诫语」呢？唉…"
                }
              ]
            },
            {
              "text": "是一位温柔的魔神。",
              "dialogues": [
                {
                  "role": "索拉雅",
                  "text": "用「温柔」来形容一位「魔神」，真是感觉有点不搭边际…"
                },
                {
                  "role": "索拉雅",
                  "text": "在很久很久之前，在那些引导着人们的魔神之中，也许真有「温柔」的魔神吧。"
                },
                {
                  "role": "索拉雅",
                  "text": "保护着自己的子民，和他们一同在这片大地上漫步，一同携手前进。"
                },
                {
                  "role": "索拉雅",
                  "text": "…不过这样温柔的魔神，最终还是什么也没能保护下来。就连她给自己子民的诫语，都要借助「宝藏」这种东西才能流传下来。"
                }
              ]
            },
            {
              "text": "真想见她一面。",
              "dialogues": [
                {
                  "role": "索拉雅",
                  "text": "居然想要去见魔神，你还真是异想天开。"
                },
                {
                  "role": "索拉雅",
                  "text": "不过，如果你真见到了「归终」，你会做什么？"
                },
                {
                  "role": "索拉雅",
                  "text": "难道想要说「辛苦了」、「谢谢你」之类的话，来安慰她吗？"
                },
                {
                  "role": "索拉雅",
                  "text": "如果要我说的话，不如流利背诵一遍「归终四诫」吧。"
                },
                {
                  "role": "索拉雅",
                  "text": "然后告诉她，她的信念和理想还没有消失，这片大地上还有人牢记着她的教诲。"
                },
                {
                  "role": "索拉雅",
                  "text": "对于已经失去了一切的「归终」来说，也许…这才是最好的安慰吧。"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}