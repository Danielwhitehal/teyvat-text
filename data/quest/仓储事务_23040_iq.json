{
  "quest_id": 23040,
  "chapter_num": null,
  "chapter_title": "仓储事务",
  "type": "iq",
  "route": "Warehousing Business",
  "stories": [
    {
      "story_id": 23040,
      "title": "仓储事务",
      "description": "阿如村的纳杰特似乎遇见了麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与纳杰特对话"
        },
        {
          "role": "纳杰特",
          "text": "唉…这些赤鹫，真是没完没了…"
        },
        {
          "role": "旅行者",
          "text": "发生什么了？"
        },
        {
          "role": "纳杰特",
          "text": "你是…旅行者，对吧？我听奥贝德那孩子提起过你。"
        },
        {
          "role": "纳杰特",
          "text": "呵呵，居然会有旅行者造访我们这村子，我倒是真没想到。"
        },
        {
          "role": "纳杰特",
          "text": "喔，你见过哈巴奇了吗？他一直都很严肃…要是他和你说话时态度有些冲，还请你理解。"
        },
        {
          "role": "纳杰特",
          "text": "毕竟…我们村的许多物资都放在这个仓库里，不仅是粮食，还有衣物，武器，甚至一些财货…"
        },
        {
          "role": "纳杰特",
          "text": "村子里就那么些年轻人，既要守卫村子，又要帮村里人处理各种事…一直都只有哈巴奇一个人守着仓库。"
        },
        {
          "role": "纳杰特",
          "text": "我这除了记账和清点之外，也帮不上什么忙…"
        },
        {
          "role": "旅行者",
          "text": "你刚才说赤鹫…"
        },
        {
          "role": "纳杰特",
          "text": "唉，别提了，前段时间刚有一批干肉运进了仓库…"
        },
        {
          "role": "纳杰特",
          "text": "不知道是哪里漏出了气味，隔三差五就有几只赤鹫飞过来，停在仓库旁边的山上。"
        },
        {
          "role": "纳杰特",
          "text": "它们没法啄走仓库里的干肉，但只要有人在它们面前吃饭，这群赤鹫就会突然飞下来发动袭击。"
        },
        {
          "role": "纳杰特",
          "text": "村子里的守卫没空去解决掉它们，哈巴奇先生也抽不出身…"
        },
        {
          "role": "纳杰特",
          "text": "旅行者，如果你有空的话，能帮我们去解决掉那些赤鹫吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "纳杰特",
                  "text": "那就拜托你了，那些赤鹫很凶猛，最好不要靠近…如果你会用弓箭的话，应该能安全地解决掉它们。"
                }
              ]
            },
            {
              "text": "它们袭击过什么？",
              "dialogues": [
                {
                  "role": "纳杰特",
                  "text": "路过的货物，晾晒的干肉，还有哈巴奇先生的饭盒…"
                },
                {
                  "role": "纳杰特",
                  "text": "哈巴奇先生在站岗中吃饭时，习惯把菜放在一旁，那群赤鹫经常瞅准这个机会，飞下去把肉全都叼走。"
                },
                {
                  "role": "纳杰特",
                  "text": "因为还要站岗，他也不能去教训赤鹫，只能看着它们飞走，然后就着剩下的菜赶紧把饭吃完…"
                },
                {
                  "role": "纳杰特",
                  "text": "拜托你了，旅行者，快去把那些赤鹫都解决掉吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "打倒所有赤鹫"
        },
        {
          "role": "纳杰特",
          "text": "拜托你了，旅行者，快去把那些赤鹫都解决掉吧。"
        },
        {
          "type": "subtitle",
          "text": "向纳杰特回报"
        },
        {
          "role": "纳杰特",
          "text": "怎么样，你把那些赤鹫都解决掉了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "都搞定了。",
              "dialogues": []
            },
            {
              "text": "它们应该会消停一段时间了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "纳杰特",
          "text": "太感谢你了，这样哈巴奇先生总算能正常吃一顿饭了。"
        },
        {
          "role": "纳杰特",
          "text": "对了，这些报酬给你，请收下。"
        },
        {
          "role": "纳杰特",
          "text": "唔，今天还要入库什么货物来着…"
        },
        {
          "type": "subtitle",
          "text": "与纳杰特对话"
        },
        {
          "role": "纳杰特",
          "text": "唉，哈巴奇先生什么时候才能稍微休息一下呢…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "纳杰特",
          "text": "旅行者，你来得正好，请你帮我们一个忙吧。"
        },
        {
          "role": "纳杰特",
          "text": "刚才有一批风干的食物从外面送进村里，哈巴奇先生准备去把它们接入仓库里。"
        },
        {
          "role": "纳杰特",
          "text": "但一群赤鹫闻到了食物的气味，突然成群结队地冲了下来。"
        },
        {
          "role": "纳杰特",
          "text": "虽然其他守卫很快赶过来打跑了这些赤鹫，但那批风干的食物也被赤鹫们啄得到处都是。"
        },
        {
          "role": "纳杰特",
          "text": "其他人已经去警告其他运货的队伍了，哈巴奇先生也忙着去回收还完好的食物…旅行者，你能帮帮我们吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "纳杰特",
                  "text": "那就拜托你了，真是不好意思，我等会还要去帮忙接收货物，实在是忙不过来了。"
                }
              ]
            },
            {
              "text": "哈巴奇先生还好吗？",
              "dialogues": [
                {
                  "role": "纳杰特",
                  "text": "唉，我让他休息一下他也不肯，说搜集完食物之后，还要再清点一遍仓库，这样下去，他的身体怎么撑得住啊…"
                },
                {
                  "role": "纳杰特",
                  "text": "那些货物应该就在白之梯附近。旅行者，请你帮我们回收一下那些货物吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "回收货物"
        },
        {
          "role": "纳杰特",
          "text": "那些货物应该就在白之梯附近。旅行者，请你帮我们回收一下那些货物吧。"
        },
        {
          "type": "subtitle",
          "text": "向纳杰特回报"
        },
        {
          "role": "纳杰特",
          "text": "旅行者，你拿到那些货物了吗？"
        },
        {
          "role": "旅行者",
          "text": "拿到了。"
        },
        {
          "role": "纳杰特",
          "text": "太好了，就把货物放在那里吧，多谢你帮忙了。"
        },
        {
          "role": "纳杰特",
          "text": "哈巴奇先生已经去仓库里面清点其他货物了，这些食物就由我先看着吧。"
        },
        {
          "role": "纳杰特",
          "text": "唉，希望这批食物没有损失太多啊…"
        },
        {
          "type": "subtitle",
          "text": "与纳杰特对话"
        },
        {
          "role": "纳杰特",
          "text": "旅行者！你来得正好，请你快去帮帮哈巴奇先生吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "发生什么了？",
              "dialogues": []
            },
            {
              "text": "你怎么这么紧张？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "纳杰特",
          "text": "唉，有一批货物在村外被盗宝团截住，能出动的守卫都已经出去支援了。"
        },
        {
          "role": "纳杰特",
          "text": "哈巴奇说人手还是太少，所以他自己也抓着武器出了村子。"
        },
        {
          "role": "纳杰特",
          "text": "但据说那群盗宝团人数很多，哈巴奇先生一个人说不定对付不来。"
        },
        {
          "role": "纳杰特",
          "text": "旅行者，我把他要去的地方标在你的地图上，请你快去帮帮他吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我立即出发。",
              "dialogues": [
                {
                  "role": "纳杰特",
                  "text": "拜托你了旅行者，希望哈巴奇先生不要出事…"
                }
              ]
            },
            {
              "text": "他的武艺怎么样？",
              "dialogues": [
                {
                  "role": "纳杰特",
                  "text": "对付一两个盗宝团，对于哈巴奇先生来说应该不在话下。"
                },
                {
                  "role": "纳杰特",
                  "text": "但据说这次是有一整支盗宝团埋伏了运货队，要不是运货队里有个人腿脚快跑回村里报信，也许都没人能知道运货队被袭击了。"
                },
                {
                  "role": "纳杰特",
                  "text": "唉，要是坎蒂丝小姐没有外出的话，那些盗宝团一定不敢造次。"
                },
                {
                  "role": "纳杰特",
                  "text": "他们一定是看准了空档，才敢突然动手。"
                },
                {
                  "role": "纳杰特",
                  "text": "旅行者，拜托你了，请快去帮帮哈巴奇先生吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往帮助哈巴奇"
        },
        {
          "role": "纳杰特",
          "text": "旅行者，请你快去帮帮哈巴奇先生吧！我…我也得去找其他人帮忙…"
        },
        {
          "type": "subtitle",
          "text": "与哈巴奇对话"
        },
        {
          "role": "哈巴奇",
          "text": "…呼…呼…多谢你了，旅行者。要不是你出手，这些货物肯定保不住。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你身手不错。",
              "dialogues": [
                {
                  "role": "哈巴奇",
                  "text": "呵呵，多谢夸奖。但我一个人对付这么多盗宝团，多少还是有些吃力的。"
                }
              ]
            },
            {
              "text": "你一个人来的？",
              "dialogues": [
                {
                  "role": "哈巴奇",
                  "text": "还有其他守卫和我一起出村，但他们去了另外的地方寻找货物。"
                }
              ]
            }
          ]
        },
        {
          "role": "哈巴奇",
          "text": "唉，我还是武艺不精。要是坎蒂丝小姐来的话，这群盗宝团应该已经全部趴在地上了…"
        },
        {
          "role": "哈巴奇",
          "text": "抱歉，现在不是说这个的时候，我得先把这些货物送回村里。"
        },
        {
          "role": "哈巴奇",
          "text": "旅行者，这里不太安全，你也快点回去吧。"
        },
        {
          "role": "哈巴奇",
          "text": "不过这群盗宝团的消息，怎么这么灵通…"
        }
      ]
    }
  ]
}