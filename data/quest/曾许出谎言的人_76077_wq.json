{
  "quest_id": 76077,
  "chapter_num": null,
  "chapter_title": "曾许出谎言的人",
  "type": "wq",
  "route": "The Man Who Once Lied",
  "stories": [
    {
      "story_id": 76077,
      "title": "曾许出谎言的人",
      "description": "奈芙尔似乎在冒险家协会下达了某项委托…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与奈芙尔对话"
        },
        {
          "role": "萨林",
          "text": "这就是你要找的那本书，奈芙尔老板，请您看看吧。"
        },
        {
          "role": "奈芙尔",
          "text": "让我看看…哈，真是够巧的，这本书里记录的故事刚好是那篇《变成骡子的人》。"
        },
        {
          "role": "旅行者",
          "text": "奈芙尔？她也来做委托？"
        },
        {
          "role": "派蒙",
          "text": "怎么想奈芙尔都不像是做委托的人，她应该是那种给人发委托的人啦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "喔…确实是这样。",
              "dialogues": []
            },
            {
              "text": "那下次让她给我发点轻松的委托。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我说你啊，就别抢雅珂达的工作了…"
        },
        {
          "role": "派蒙",
          "text": "不过，奈芙尔到底是要给冒险家协会发什么委托呢？有点好奇…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等下再去问问吧。",
              "dialogues": []
            },
            {
              "text": "现在不太好打扰奈芙尔。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奈芙尔",
          "text": "不错，的确是我要找的故事书。不愧是冒险家协会，果然手眼通天，连这篇遗失已久的故事都能找到。"
        },
        {
          "role": "萨林",
          "text": "哈哈哈，这也是多亏了诸位冒险家们的努力。"
        },
        {
          "role": "萨林",
          "text": "虽然寻找的途中有许多波折，但最终，我们还是在至冬的某位收藏家手里找到了这篇故事的抄本。"
        },
        {
          "role": "奈芙尔",
          "text": "沙漠的故事，居然会流传到至冬去，真是有意思。"
        },
        {
          "role": "奈芙尔",
          "text": "多谢了，我会按照之前的约定，为这本书支付相应的报酬。"
        },
        {
          "role": "奈芙尔",
          "text": "另外，麻烦萨林先生继续维持这份委托的发布状态，优先级也调高一些。相应的费用，我会一并支付。"
        },
        {
          "role": "萨林",
          "text": "没问题。能和奈芙尔老板做生意，是我们冒险家协会的荣幸。我这就去协会协调相关事宜，先告辞了。"
        },
        {
          "role": "奈芙尔",
          "text": "旅行者，派蒙。我的事情已经谈好了，你们可以来满足自己的好奇心了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你早就发现我们了？",
              "dialogues": []
            },
            {
              "text": "你的眼神真好啊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "连我说的话也听见了？该说不愧是奈芙尔吗…"
        },
        {
          "role": "旅行者",
          "text": "所以，你是在发布委托么？"
        },
        {
          "role": "奈芙尔",
          "text": "差不多。但严格来说，这应该是我和冒险家协会的一项长期合作。"
        },
        {
          "role": "奈芙尔",
          "text": "走吧，去「秘闻馆」里一起喝杯茶，这里可不是一个适合听故事的地方。"
        },
        {
          "type": "subtitle",
          "text": "与奈芙尔一同回到「秘闻馆」"
        },
        {
          "role": "奈芙尔",
          "text": "…哎呀，雅珂达看样子还没回来。"
        },
        {
          "role": "奈芙尔",
          "text": "你们在这稍等，我去泡茶。"
        },
        {
          "role": "阿舍鲁",
          "text": "喵——"
        },
        {
          "role": "旅行者",
          "text": "阿舍鲁，摸摸。"
        },
        {
          "role": "阿舍鲁",
          "text": "喵，喵喵。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，阿舍鲁乖乖喔，来，握手。"
        },
        {
          "role": "阿舍鲁",
          "text": "喵？"
        },
        {
          "role": "奈芙尔",
          "text": "来吧，茶泡好了。奶和糖在那边，需要的话自己去加。"
        },
        {
          "role": "奈芙尔",
          "text": "看来阿舍鲁很亲近你们。想当初，我刚把阿舍鲁带回来的时候，它就像狮子一样凶狠。"
        },
        {
          "role": "奈芙尔",
          "text": "除了我之外，几乎没有人能碰它。那些擅自靠近它的人，基本上都被它用爪子和牙齿赶走了。"
        },
        {
          "role": "派蒙",
          "text": "阿舍鲁原来这么凶吗？看不出来啊。"
        },
        {
          "role": "阿舍鲁",
          "text": "喵，喵喵？喵…"
        },
        {
          "role": "奈芙尔",
          "text": "那是很久之前的事了，那时候我和它刚刚到挪德卡莱。"
        },
        {
          "role": "奈芙尔",
          "text": "我们无依无靠，想要在彼时的挪德卡莱拼杀出一片容身之所，就不得不露出爪牙。"
        },
        {
          "role": "奈芙尔",
          "text": "…现在，已经没那个必要了。"
        },
        {
          "role": "奈芙尔",
          "text": "好了，现在是满足你们好奇心的时间。我猜，你们应该是对我和冒险家协会的那项「长期合作」有兴趣，对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "奈芙尔居然会去委托冒险家协会…",
              "dialogues": []
            },
            {
              "text": "一定是要寻找很重要的东西吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "难道是连奈芙尔也没办法一个人找到并且带走的宝贝？"
        },
        {
          "role": "奈芙尔",
          "text": "重要的确是很重要。但是不是宝贝，那就要看个人的判断了。"
        },
        {
          "role": "奈芙尔",
          "text": "喏，我要冒险家协会帮我找的就是这本书，看看吧。"
        },
        {
          "role": "派蒙",
          "text": "读起来是一篇很有须弥风格的童话呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道是宝藏的线索？",
              "dialogues": []
            },
            {
              "text": "里面难道有什么谜语？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "啊？又要解谜寻宝了？旅行者你加油喔！我、我有点看不太懂…"
        },
        {
          "role": "奈芙尔",
          "text": "放心吧，这只是一篇流传在须弥沙漠人中的普通故事。既没有暗指藏宝地，也没有隐藏密语。"
        },
        {
          "role": "奈芙尔",
          "text": "我之所以费力寻找，只因为它和我的父亲有关。"
        },
        {
          "role": "旅行者",
          "text": "你的父亲…"
        },
        {
          "role": "奈芙尔",
          "text": "没错。我之前应该为你「引见」过他了。你们应该还记得他和我的命运。"
        },
        {
          "role": "奈芙尔",
          "text": "在带回那一桶裹挟着灾祸的「战利品」，让村子被黄沙吞没之前…他经常给我讲故事。"
        },
        {
          "role": "奈芙尔",
          "text": "当然了，你们也知道当时须弥的情况，那些温情脉脉又富有智慧的故事，只有雨林里的幸运儿才有特权聆听。"
        },
        {
          "role": "奈芙尔",
          "text": "而对于那些被防沙壁隔绝在外的沙漠人来说，智慧和温情是奢侈品。"
        },
        {
          "role": "奈芙尔",
          "text": "由他们口口相传的故事，唯一且最重要的作用，就是教会孩子们如何活下去。"
        },
        {
          "role": "奈芙尔",
          "text": "比如，浪费粮食的人会变成蝎子，不珍爱水源的人会失去舌头…"
        },
        {
          "role": "奈芙尔",
          "text": "再比如，善良是美德，但轻信别人只会招致灾祸，欺骗是可行的，但前提是别被发现。"
        },
        {
          "role": "奈芙尔",
          "text": "不过，我父亲似乎并不想让我被这些故事「感化」成「典型的沙漠人」。"
        },
        {
          "role": "奈芙尔",
          "text": "在搜集到故事之后，他会自己进行改编，把故事变得…更温情一些。"
        },
        {
          "role": "奈芙尔",
          "text": "在他说的那些故事里，骗子变成了骡子，杀人者跌下了悬崖，挑食的孩子最多只是牙痛…"
        },
        {
          "role": "派蒙",
          "text": "能够稍微理解一点他的想法，毕竟谁都想让自己的孩子好好长大啦…"
        },
        {
          "role": "旅行者",
          "text": "奈芙尔喜欢那些故事吗？"
        },
        {
          "role": "奈芙尔",
          "text": "我？"
        },
        {
          "role": "奈芙尔",
          "text": "当时的我喜欢的不得了。每天都期待着夜晚到来，父亲用故事哄我入睡。"
        },
        {
          "role": "奈芙尔",
          "text": "到了白天，我就会拿着父亲的故事本出去，把故事再讲给其他孩子听。"
        },
        {
          "role": "奈芙尔",
          "text": "他们可羡慕我了，无论我到哪，身后都跟着一堆小孩，只要能听故事，我让他们做什么就做什么。"
        },
        {
          "role": "奈芙尔",
          "text": "直到一切都迎来终结，我的父亲，朋友和部族，还有那些故事，都被掩盖在了黄沙之下。"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "奈芙尔",
          "text": "之后，我去了教令院。在那里，我才发现了一部分故事的「原版」。"
        },
        {
          "role": "奈芙尔",
          "text": "骗子们从未被惩罚，因为蠢人就活该被骗；杀人者总是得胜后扬长而去，因为只有他的手里有刀剑。"
        },
        {
          "role": "奈芙尔",
          "text": "至于挑食的孩子…则和那些浪费水的孩子一样，被变成了蜥蜴，永世蜷缩在岩石底下。"
        },
        {
          "role": "奈芙尔",
          "text": "直到那个时候，我才知道父亲一直在「欺骗」我，他用自己的笔，为我编织出了一个虚假的温情世界。"
        },
        {
          "role": "奈芙尔",
          "text": "但我的父亲离开了，那个虚假的世界也宣告毁灭，我不得不面对那些真相。"
        },
        {
          "role": "奈芙尔",
          "text": "幸运的是，我学得很好，很快就成了一个他努力不让我成为的「沙漠人」。"
        },
        {
          "role": "奈芙尔",
          "text": "之后，就是谎言、欺骗、复仇和毁灭，这些都是在沙漠中重复了一万遍的主题，你们应该很熟悉。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你搜集这些故事的原因…",
              "dialogues": []
            },
            {
              "text": "是为了看看原版故事究竟是怎样吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奈芙尔",
          "text": "算是吧。我只是想看看，他究竟对自己的女儿撒了多少谎。"
        },
        {
          "role": "奈芙尔",
          "text": "作为世界上唯一一个被他如此欺骗的人，我想我有义务把他的骗术记录下来，否则，他作为一个骗子也太过籍籍无名了。"
        },
        {
          "role": "奈芙尔",
          "text": "再说了，哼…「鹮之王」图特一定也对我的行动乐见其成吧。"
        },
        {
          "role": "奈芙尔",
          "text": "毕竟，是他让我去寻觅能够「厘定真伪」之物。"
        },
        {
          "role": "奈芙尔",
          "text": "在我年幼时，我父亲所编撰的那些故事，为我塑造了对于这个世界的认知。"
        },
        {
          "role": "奈芙尔",
          "text": "而那些故事的真实结局…呵，也让我更深地认识了这个真实的世界。"
        },
        {
          "role": "奈芙尔",
          "text": "对我来说，这些故事确确实实地帮助过我「厘定真伪」。"
        },
        {
          "role": "奈芙尔",
          "text": "将它们搜集起来，或许能帮助我寻找「鹮之王」所需要的那个答案。"
        },
        {
          "role": "奈芙尔",
          "text": "所以，在挪德卡莱扎下脚跟之后，我就开始用各种渠道打听起了父亲曾经讲述的那些故事。"
        },
        {
          "role": "奈芙尔",
          "text": "但这些故事大部分在沙漠人之中口口相传，几乎没有书面记录。"
        },
        {
          "role": "奈芙尔",
          "text": "我远在挪德卡莱，自然不可能自己跑去沙漠里到处寻访遗民。"
        },
        {
          "role": "奈芙尔",
          "text": "至于雅珂达…我这里本来就缺人手，想想还是算了。"
        },
        {
          "role": "奈芙尔",
          "text": "所以，我就和坐拥无数冒险家的冒险家协会达成了长期合作。"
        },
        {
          "role": "奈芙尔",
          "text": "只要为我带回沙漠人的故事，我就会付出相应的报酬，甚至…帮他们一点小忙。"
        },
        {
          "role": "奈芙尔",
          "text": "萨林先生很愿意接受我的条件，很快和我达成了共识。从结果上来说，我们合作得也很愉快。"
        },
        {
          "role": "旅行者",
          "text": "那…关于你刚刚搜集到的这篇故事…"
        },
        {
          "role": "奈芙尔",
          "text": "啊，这一篇啊。这是我父亲给我讲的最后一个故事。也是他唯一一篇没有修改结局的故事。"
        },
        {
          "role": "奈芙尔",
          "text": "说了一辈子谎的人，在唯一一次诚实地讲述故事后，就被黄沙掩埋了。"
        },
        {
          "role": "奈芙尔",
          "text": "哈，这故事里居然还写着：「他是打心眼里善良的，这是无上的智慧。」…真是够讽刺的。"
        },
        {
          "role": "奈芙尔",
          "text": "你们对这份故事感兴趣的话，我抄一份给你们就是。"
        },
        {
          "role": "奈芙尔",
          "text": "顺便一提，旅行者，你也是冒险家对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "呃…欸？对，对啊…",
              "dialogues": []
            },
            {
              "text": "怎么突然提起这个…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奈芙尔",
          "text": "我知道你常年在世界各地旅行，见多识广。"
        },
        {
          "role": "奈芙尔",
          "text": "有意向的话，我们也可以签署一个长期合作的…框架协议。"
        },
        {
          "role": "奈芙尔",
          "text": "如果你在旅途中取得了有关须弥沙漠人的故事，可以拿来给我，我会付给你一笔丰富的报酬。"
        },
        {
          "role": "派蒙",
          "text": "原、原来你让我们来，是为了最后这句话啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "奈芙尔果然是发委托的人啊…",
              "dialogues": []
            },
            {
              "text": "好吧，我果然是做委托的命啊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奈芙尔",
          "text": "很好，那预祝我们合作愉快。"
        },
        {
          "role": "奈芙尔",
          "text": "…不过，雅珂达为什么还没回来。"
        },
        {
          "role": "奈芙尔",
          "text": "她接的那项委托，有这么困难么？"
        }
      ]
    }
  ]
}