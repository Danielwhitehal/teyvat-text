{
  "quest_id": 74705,
  "chapter_num": null,
  "chapter_title": "水族箱里的…我们？",
  "type": "wq",
  "route": "Us... In the Aquarium?",
  "stories": [
    {
      "story_id": 74705,
      "title": "水族箱里的…我们？",
      "description": "朋友们似乎在欣赏水族箱…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往水族箱附近…"
        },
        {
          "role": "夏沃蕾",
          "text": "…我觉得是这条。"
        },
        {
          "role": "芙宁娜",
          "text": "有道理。"
        },
        {
          "role": "千织",
          "text": "为什么？"
        },
        {
          "role": "夏沃蕾",
          "text": "看看这尾摆的颜色，整个水族箱里没有比它更时髦的了。"
        },
        {
          "role": "千织",
          "text": "虽然颜色艳了点，但好吧，就当你是在夸我。"
        },
        {
          "role": "派蒙",
          "text": "哇！好多人呀！大家都是来逛水族馆的吗？"
        },
        {
          "role": "芙宁娜",
          "text": "嗯，刚拍完一个镜头，趁休息时间来欣赏一下。"
        },
        {
          "role": "派蒙",
          "text": "你们刚刚在聊什么？"
        },
        {
          "role": "夏沃蕾",
          "text": "哪条鱼和千织比较像。"
        },
        {
          "role": "派蒙",
          "text": "怎么你们也…？！"
        },
        {
          "role": "芙宁娜",
          "text": "啊…哈哈，好像是聊天时听哥伦比娅小姐提到类似的话题，觉得很有趣，我们不知不觉就也这么玩上了。"
        },
        {
          "role": "派蒙",
          "text": "原来这东西还能传染的…"
        },
        {
          "role": "千织",
          "text": "哦！那条像你，夏沃蕾。"
        },
        {
          "role": "夏沃蕾",
          "text": "怎么说？"
        },
        {
          "role": "千织",
          "text": "一闲下来就绕着水缸游圈，在锻炼呢。"
        },
        {
          "role": "夏沃蕾",
          "text": "…我在你心里就这形象吗？"
        }
      ]
    }
  ]
}