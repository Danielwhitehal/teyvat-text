{
  "quest_id": 72501,
  "chapter_num": null,
  "chapter_title": "画外旅照·青植之篇",
  "type": "wq",
  "route": "Outside the Canvas, Inside the Lens: Greenery Chapter",
  "stories": [
    {
      "story_id": 72501,
      "title": "画外旅照·青植之篇",
      "description": "一位名为朝雾的插画师，似乎正为某事而烦恼…",
      "dialogues": [
        {
          "role": "朝雾",
          "text": "森子小姐怎么总是分给我这种奇怪的稿件啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还在画插画吗？",
              "dialogues": []
            },
            {
              "text": "你又没灵感了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "朝雾",
          "text": "呀！旅行者，你怎么来了，好久没看到你，我还以为你已经去别的地方旅行了呢。"
        },
        {
          "role": "朝雾",
          "text": "唉…要是我身体能好点，我也想和你一样出去旅行。"
        },
        {
          "role": "朝雾",
          "text": "这样的话，就不用每天都被森子小姐当面催稿了…"
        },
        {
          "role": "朝雾",
          "text": "上次我画的那些稿件似乎很受好评，好多老师都专门要我给他们画插画。"
        },
        {
          "role": "朝雾",
          "text": "虽然森子小姐已经帮我推掉了很多约稿，但留下来的那一部分也还是太多了…"
        },
        {
          "role": "朝雾",
          "text": "我最开始以为他们除了稻妻之外，最多就写一写蒙德啦，璃月啦…"
        },
        {
          "role": "朝雾",
          "text": "但老师们笔下小说的题材…已经立足须弥，放眼枫丹啦。"
        },
        {
          "role": "朝雾",
          "text": "嗯…说回正事，旅行者啊，你手上的那台「留影机」还好吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我觉得它应该还挺好的…",
              "dialogues": []
            },
            {
              "text": "你又要我帮你拍画片吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "朝雾",
          "text": "你看，上次我给你开的报酬还不错吧？"
        },
        {
          "role": "朝雾",
          "text": "旅行者，就请你再帮我去世界各地拍一拍画片吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "唉，交给我吧…",
              "dialogues": [
                {
                  "role": "朝雾",
                  "text": "那就拜托你了！嘿嘿，我早就把笔记本准备好了。"
                },
                {
                  "role": "朝雾",
                  "text": "要是你不来找我呀，我可都要拜托森子小姐去找你了…"
                }
              ]
            },
            {
              "text": "你去冒险家协会挂个委托吧…",
              "dialogues": [
                {
                  "role": "朝雾",
                  "text": "呜哇！别呀！拜托你了，拜托你了嘛！我去冒险家协会挂过委托，但就是找不到会熟练使用留影机的冒险家啊！"
                },
                {
                  "role": "朝雾",
                  "text": "你就帮帮我吧旅行者，我要是交不出稿，森子小姐又要跑来和我一起住了！"
                },
                {
                  "role": "朝雾",
                  "text": "我可受不了她做的那种绯樱泡饭啊，旅行者！你就帮帮我吧！"
                },
                {
                  "role": "旅行者",
                  "text": "我知道了，我知道了"
                },
                {
                  "role": "朝雾",
                  "text": "呼…那就好，稍等一下啊，我找一下笔记本…"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}