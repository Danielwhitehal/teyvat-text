{
  "quest_id": 10031,
  "chapter_num": "",
  "chapter_title": "月浴之渊",
  "type": "wq",
  "route": "The Moon-Bathed Deep",
  "stories": [
    {
      "story_id": 72145,
      "title": "「海祇之眼」",
      "description": "为了做好进入渊下宫的准备，首先要解除海祇岛上的五处封印",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆前往「眼」之所在"
        },
        {
          "role": "派蒙",
          "text": "这里就是露子姐姐提到的「眼」吧！"
        },
        {
          "type": "subtitle",
          "text": "◆阅读「眼」处的石碑"
        },
        {
          "role": "古老的石碑",
          "text": "「…有谕大御神神使目有三瞳，一曰『灵』；一曰『镜』；一曰『实』…」"
        },
        {
          "role": "古老的石碑",
          "text": "「…自海渊蓁蓁而起，出于{{颜色|蓝|南}}，越于{{颜色|蓝|北}}，盘桓{{颜色|蓝|西}}岗…」"
        },
        {
          "role": "古老的石碑",
          "text": "「…三瞳灼灼而无所赦，是故龙嗣怪异等莫有敢敌…」"
        },
        {
          "role": "派蒙",
          "text": "唔…每个字都认得，连起来就完全不知在说什么了呢。"
        },
        {
          "role": "派蒙",
          "text": "附近看起来也没有线索…不如用{{颜色|蓝|「元素视野」}}试试看吧？"
        },
        {
          "type": "subtitle",
          "text": "◆解除神龛的封印"
        },
        {
          "type": "subtitle",
          "text": "解开第一处封印",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "解除了一个封印！"
        },
        {
          "type": "subtitle",
          "text": "解开第二处封印",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "糟糕，封印解除时散出的元素力引来了好多史莱姆！"
        },
        {
          "type": "subtitle",
          "text": "解开第三处封印",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "哪里来的漂浮灵？难道是被封印的元素力吸引来的吗！"
        },
        {
          "role": "派蒙",
          "text": "所有的封印都解除了…我们快回去看看神龛有什么变化吧！"
        },
        {
          "type": "subtitle",
          "text": "◆取得「御灵珠」"
        },
        {
          "role": "派蒙",
          "text": "拿到了一颗珍珠呢，这就是露子姐姐说的「御灵珠」吗？"
        }
      ]
    },
    {
      "story_id": 72146,
      "title": "「海祇之牙」",
      "description": "为了做好进入渊下宫的准备，首先要解除海祇岛上的五处封印…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆前往「牙」之所在"
        },
        {
          "role": "派蒙",
          "text": "这里就是「牙」吗…"
        },
        {
          "type": "subtitle",
          "text": "◆阅读「牙」处的石碑"
        },
        {
          "role": "古老的石碑",
          "text": "「…是故战衅起于前，有所守护，速而决之，则明珠可狩。是海祇爪牙之道也…」"
        },
        {
          "role": "派蒙",
          "text": "唔…碑文上能解读的部分几乎没有呢。似乎是要打架、还要守护什么东西…才能拿到「御灵珠」的样子…"
        },
        {
          "type": "subtitle",
          "text": "◆保护地脉镇石"
        },
        {
          "role": "派蒙",
          "text": "旅行者，小心呀！"
        },
        {
          "role": "派蒙",
          "text": "快看，好多丘丘人冲过来了！"
        },
        {
          "type": "subtitle",
          "text": "◆取得「御灵珠」"
        },
        {
          "role": "派蒙",
          "text": "又获得了一颗「御灵珠」！"
        }
      ]
    },
    {
      "story_id": 72147,
      "title": "「海祇之鳍」",
      "description": "为了做好进入渊下宫的准备，首先要解除海祇岛上的五处封印…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆前往「鳍」之所在"
        },
        {
          "role": "派蒙",
          "text": "露子姐姐说的「鳍」，就是这里吧！"
        },
        {
          "type": "subtitle",
          "text": "◆阅读「鳍」处的石碑"
        },
        {
          "role": "古老的石碑",
          "text": "「…是故他乡臣子悉往来投之…」"
        },
        {
          "role": "古老的石碑",
          "text": "「…两两相称，如鳞鳍，如股肱，中心相望，弼大御神殿陛之治…」"
        },
        {
          "role": "派蒙",
          "text": "唔…「两两相称」…什么的，会不会是要让来时遇到的那些鱼雕像配对朝向大盘子中央呢？"
        },
        {
          "role": "派蒙",
          "text": "突然好想吃鱼…"
        },
        {
          "type": "subtitle",
          "text": "◆解除「鳍」的封印"
        },
        {
          "type": "subtitle",
          "text": "触动机关",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "那边的鱼也一起动了！"
        },
        {
          "type": "subtitle",
          "text": "解开机关",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "快看，封印好像解开了！我们去吃鱼吧！"
        },
        {
          "type": "subtitle",
          "text": "◆取得「御灵珠」"
        },
        {
          "role": "派蒙",
          "text": "第三颗了，就快完成了呢！"
        }
      ]
    },
    {
      "story_id": 72148,
      "title": "「海祇之尾」",
      "description": "为了做好进入渊下宫的准备，首先要解除海祇岛上的五处封印…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆前往「尾」之所在"
        },
        {
          "role": "派蒙",
          "text": "五伤岩的「尾」，就是这里吧！"
        },
        {
          "type": "subtitle",
          "text": "◆阅读「尾」处的石碑"
        },
        {
          "role": "古老的石碑",
          "text": "「…圣觐则身怀神恩，轻履慢行，逐灯而进…忌奔跃急腾，忌喧哗哭闹，须以哀寂之心怀大御神之恩殉…」"
        },
        {
          "role": "派蒙",
          "text": "唔…似乎要我们带着虔敬之心慢慢来呢。"
        },
        {
          "role": "旅行者",
          "text": "不过，虔敬之心要怎么衡量呢…"
        },
        {
          "type": "subtitle",
          "text": "◆解除「尾」处的封印"
        },
        {
          "role": "愚人众",
          "text": "没想到你们比海祇人自己都虔诚呢，哈哈！"
        },
        {
          "role": "派蒙",
          "text": "神气个什么啦，跟踪狂！"
        },
        {
          "type": "subtitle",
          "text": "◆击败愚人众"
        },
        {
          "type": "subtitle",
          "text": "◆取得「御灵珠」"
        },
        {
          "role": "派蒙",
          "text": "第四颗「御灵珠」到手！我们回去找露子姐姐吧！"
        }
      ]
    },
    {
      "story_id": 72149,
      "title": "「海祇之心」",
      "description": "既然已经取得四枚「御灵珠」，是时候向露子回报成果了。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆返回珊瑚宫与露子对话"
        },
        {
          "role": "露子",
          "text": "欢迎回来，旅行者。请问有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于你的委托…"
        },
        {
          "role": "派蒙",
          "text": "我们已经取得四颗「御灵珠」啦！"
        },
        {
          "role": "露子",
          "text": "这样吗？真是太可靠了，非常感谢！那么接下来距离解开最后的「心」之封印就只有一步之遥了。"
        },
        {
          "role": "露子",
          "text": "接下来还要辛苦两位随我一同前去，希望您不要介意。"
        },
        {
          "role": "派蒙",
          "text": "既然都到这里了，我们也不在乎多走两步路啦！对吧，旅行者？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧。",
              "dialogues": []
            },
            {
              "text": "我没什么所谓。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "露子",
          "text": "那么事不宜迟，我们现在就出发吧！"
        },
        {
          "type": "subtitle",
          "text": "◆打开「海祇之心」的大门"
        },
        {
          "role": "露子",
          "text": "就是这里了！"
        },
        {
          "role": "露子",
          "text": "把你之前收集的「御灵珠」都拿出来吧，终于到用上的时候了。"
        },
        {
          "role": "「心」之封印",
          "text": "散发着磷光的奇妙封印，上面的图案是一条鱼…"
        },
        {
          "type": "subtitle",
          "text": "◆进入「心」之所在"
        },
        {
          "role": "派蒙",
          "text": "哇，这里就是「心」吗！"
        },
        {
          "role": "露子",
          "text": "是的，这里曾是大御神大人的栖身之地…如今却只余流水与回音，不免令人慨叹…"
        },
        {
          "role": "派蒙",
          "text": "哦…"
        },
        {
          "type": "subtitle",
          "text": "◆解除最后的封印"
        },
        {
          "type": "subtitle",
          "text": "接近机关",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "这些鱼雕像好眼熟…我们似乎在「鳍」那里遇到过呢！"
        },
        {
          "role": "露子",
          "text": "欸？原来你们之前破解过类似的封印吗？那么我也不需仔细讲解了。"
        },
        {
          "role": "露子",
          "text": "但看起来，这次应该要更复杂一些，需要{{颜色|蓝|每三座雕像}}对准中央、互相连通才行…"
        },
        {
          "type": "subtitle",
          "text": "解开三个机关前，接近最后一个机关",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "咦…这个雕像没有反应呢，是哪里卡住了吗？"
        },
        {
          "type": "subtitle",
          "text": "解开第一个机关",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "哇啊！有什么东西冒出来了，小心呀！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（解开四个机关后）"
        },
        {
          "role": "露子",
          "text": "（露子小姐似乎在思考着什么，或许这时不该打扰她。）"
        },
        {
          "type": "subtitle",
          "text": "◆获取「渊之钥」"
        },
        {
          "role": "派蒙",
          "text": "唔…这是什么东西呀？露子小姐认得吗？"
        },
        {
          "type": "subtitle",
          "text": "◆与露子对话"
        },
        {
          "role": "露子",
          "text": "嗯…"
        },
        {
          "role": "旅行者",
          "text": "露子小姐…？"
        },
        {
          "role": "露子",
          "text": "啊，抱歉，刚刚太入神了。"
        },
        {
          "role": "露子",
          "text": "多谢你们的帮助，终于取得「月浴渊之钥」了。"
        },
        {
          "role": "派蒙",
          "text": "「余哕鱼圆只月」…好拗口…那是什么啊？"
        },
        {
          "role": "露子",
          "text": "哈哈，简称「渊之钥」就好，我们不会强求外国人的读音准确与否的。"
        },
        {
          "role": "露子",
          "text": "这是打开渊下宫入口的必备之物，由大御神大人身上流出的血铸结而成…"
        },
        {
          "role": "露子",
          "text": "至少传说是这样的。"
        },
        {
          "role": "派蒙",
          "text": "哦…"
        },
        {
          "role": "旅行者",
          "text": "玄之又玄呢…"
        },
        {
          "role": "露子",
          "text": "一点也不玄啦，恰恰相反…"
        },
        {
          "role": "露子",
          "text": "接下来要上报现人神巫女大人，等她批准，再等灵脉的流动正确…"
        },
        {
          "role": "露子",
          "text": "之后，就可以进入渊下宫了。"
        },
        {
          "role": "派蒙",
          "text": "所以你在支使我们做什么啦！"
        },
        {
          "role": "露子",
          "text": "你们这趟又不是全无收获！对吧？"
        },
        {
          "role": "露子",
          "text": "比如…你们收获了珊瑚宫官方长久的友谊！海祇岛今后会一直欢迎你们的！"
        },
        {
          "role": "派蒙",
          "text": "什么啦！说得像真的一样！"
        },
        {
          "role": "露子",
          "text": "…"
        },
        {
          "role": "露子",
          "text": "记载中有说，「御灵珠」只会应正直纯良之辈的召唤，「月浴渊之钥」也只会为心灵清澈如水之人凝聚。"
        },
        {
          "role": "露子",
          "text": "虽然我不总是相信那些文书，但我相信您能给海祇岛带来转机。"
        },
        {
          "role": "露子",
          "text": "那么，待下渊下宫之刻到来…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们后会有期。",
              "dialogues": []
            },
            {
              "text": "你会再求一次签？",
              "dialogues": [
                {
                  "role": "露子",
                  "text": "呵呵，我签运很好的。我们一定还会再见面。"
                }
              ]
            }
          ]
        },
        {
          "role": "露子",
          "text": "那么，再见啦。"
        }
      ],
      "collapse_ranges": [
        [
          26,
          27
        ]
      ]
    }
  ]
}