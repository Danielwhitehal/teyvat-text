{
  "quest_id": 71035,
  "chapter_num": null,
  "chapter_title": "身后事·铜雀之迹",
  "type": "wq",
  "route": "Hereafter: The Trail of Pervases",
  "stories": [
    {
      "story_id": 71035,
      "title": "身后事·铜雀之迹",
      "description": "当你们闻到「烤吃虎鱼」的香气时，不禁想起了一位曾经帮助过你们的人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和卯师傅对话"
        },
        {
          "type": "subtitle",
          "text": "前往拜祭铜雀"
        },
        {
          "role": "王平安",
          "text": "谢谢仙师，谢谢英雄…真是巧了，又遇见您了。"
        },
        {
          "role": "派蒙",
          "text": "你认识我们？"
        },
        {
          "role": "王平安",
          "text": "我怎么敢忘了仙师的样子呢…"
        },
        {
          "role": "旅行者",
          "text": "你是…"
        },
        {
          "role": "王平安",
          "text": "哎呀，我叫王平安！您想起来了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「掇星攫辰天君」？",
              "dialogues": [
                {
                  "role": "王平安",
                  "text": "啊？！别别别千万别，什么「掇星攫辰」，您可别损我了，仙师还在这呢…"
                }
              ]
            },
            {
              "text": "我记得你。",
              "dialogues": [
                {
                  "role": "王平安",
                  "text": "多亏您还记着。"
                }
              ]
            }
          ]
        },
        {
          "role": "王平安",
          "text": "我正准备去山里的一座供奉着夜叉「铜雀」的庙看看呢。"
        },
        {
          "role": "王平安",
          "text": "但刚进山不久，就被那群盗宝团盯上了…多谢仙师相救。"
        },
        {
          "role": "派蒙",
          "text": "等一下，你去铜雀先生的庙做什么？"
        },
        {
          "role": "派蒙",
          "text": "难不成…你在打铜雀先生雕像的主意？"
        },
        {
          "role": "王平安",
          "text": "没有！我绝不会有这种想法！"
        },
        {
          "role": "旅行者",
          "text": "那你想做什么？"
        },
        {
          "role": "王平安",
          "text": "我是…想要重修一下那座庙。"
        },
        {
          "role": "王平安",
          "text": "我今天过来，本来是准备再仔细看看那座庙的情况，好回去购置材料。"
        },
        {
          "role": "王平安",
          "text": "没想到，半路上被盗宝团给盯上了，只能逃跑。"
        },
        {
          "role": "王平安",
          "text": "但我跑着跑着就…迷路了。后面的事，您都知道了。"
        },
        {
          "role": "旅行者",
          "text": "去庙那边详细说吧。"
        },
        {
          "role": "王平安",
          "text": "对，这里不是谈话的地方，我们先去庙那边。"
        },
        {
          "role": "王平安",
          "text": "有什么话，我们到那边再说。"
        },
        {
          "role": "魈",
          "text": "你们去吧，我还有事。"
        },
        {
          "role": "派蒙",
          "text": "欸！你要走吗？"
        },
        {
          "role": "派蒙",
          "text": "已经…走掉了啊…"
        },
        {
          "type": "subtitle",
          "text": "与魈对话"
        },
        {
          "role": "魈",
          "text": "你怎么来了？"
        },
        {
          "role": "旅行者",
          "text": "你也是来看铜雀的吗？"
        },
        {
          "role": "魈",
          "text": "只是路过此处，驻足片刻罢了。"
        },
        {
          "role": "魈",
          "text": "你们来，是有什么事吗？"
        },
        {
          "role": "派蒙",
          "text": "我们是来看铜雀先生的！"
        },
        {
          "role": "派蒙",
          "text": "不过，这周围还是和上次一样，简直是一团乱啊…"
        },
        {
          "role": "派蒙",
          "text": "明明建了庙，也做了雕像…怎么没人过来维护一下呢？"
        },
        {
          "role": "旅行者",
          "text": "也许是忘了吧。"
        },
        {
          "role": "派蒙",
          "text": "这也能忘记吗？夜叉明明是保护了璃月港的大英雄…"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "魈…你、你是不高兴了吗？"
        },
        {
          "role": "魈",
          "text": "没有，夜叉但行守护之责，本就无意寻求什么后人纪念。"
        },
        {
          "role": "派蒙",
          "text": "不说这些了，我们快点来吃烤吃虎鱼吧！"
        },
        {
          "role": "派蒙",
          "text": "唔…要是魈也想吃的话，我们可以各自把烤吃虎鱼切一半给你喔。"
        },
        {
          "role": "魈",
          "text": "不必了…"
        },
        {
          "role": "王平安",
          "text": "救命啊！救命啊！"
        },
        {
          "role": "派蒙",
          "text": "咦？我好像听见了什么声音…"
        },
        {
          "role": "魈",
          "text": "有人呼救，在那边！"
        },
        {
          "role": "旅行者",
          "text": "快走！"
        },
        {
          "role": "派蒙",
          "text": "欸？把烤吃虎鱼收好呀！我还没吃呢！"
        },
        {
          "type": "subtitle",
          "text": "前往救援遇到危险的人"
        },
        {
          "type": "subtitle",
          "text": "与王平安对话"
        },
        {
          "type": "subtitle",
          "text": "回到铜雀雕像所在地"
        },
        {
          "type": "subtitle",
          "text": "与王平安对话"
        },
        {
          "role": "王平安",
          "text": "这座庙还是这么破败…"
        },
        {
          "role": "派蒙",
          "text": "赶紧交代，你怎么突然想要来修庙的？"
        },
        {
          "role": "王平安",
          "text": "咳，那就说来话长了…"
        },
        {
          "role": "王平安",
          "text": "我之前为了假扮仙人，搜集了很多资料…"
        },
        {
          "role": "王平安",
          "text": "那次受了仙师教诲之后，我不是立下了从善的誓吗？回去之后，我就准备把那些资料全部毁掉。"
        },
        {
          "role": "王平安",
          "text": "但我转念一想…与其把这些资料毁掉，不如我把这些资料，还有我行骗时的手段编写成册，散发给其他人。"
        },
        {
          "role": "王平安",
          "text": "这样，说不定能帮助大家识破一些骗子…"
        },
        {
          "role": "王平安",
          "text": "没想到，我编写的这本册子还真帮不少人防了骗，连总务司的人都说我这个册子很有用。"
        },
        {
          "role": "王平安",
          "text": "除了我自己写的那部分内容之外，他们还拜托我加入一些其他的防骗内容…"
        },
        {
          "role": "王平安",
          "text": "为此，总务司还付了我不少钱呢。"
        },
        {
          "role": "王平安",
          "text": "除了那本小册子之外，我还在编写另外一本有关「护法夜叉」的书。"
        },
        {
          "role": "王平安",
          "text": "我想用这本书来向大家宣传一下「护法夜叉」的故事。"
        },
        {
          "role": "王平安",
          "text": "这样做，我的那些民俗学知识也算是用在了正道上。"
        },
        {
          "role": "王平安",
          "text": "这位「铜雀」的庙，我也是在编写有关「护法夜叉」的书的时候发现的。"
        },
        {
          "role": "王平安",
          "text": "上面记载说，那座庙本来是先民们为了纪念夜叉「铜雀」所建。"
        },
        {
          "role": "王平安",
          "text": "但我找到这座庙的时候，真没想到它居然如此破败…"
        },
        {
          "role": "王平安",
          "text": "回去之后我左思右想，最后还是决定…自己出钱，把这座庙重修一遍。"
        },
        {
          "role": "王平安",
          "text": "毕竟，我能重新走回正道，也是多亏了仙师教诲。"
        },
        {
          "role": "王平安",
          "text": "重修这座庙，也算是为我之前做的那些错事赎一些罪了。"
        },
        {
          "role": "派蒙",
          "text": "唔…听起来不像是假的…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你觉得呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉还挺真的。",
              "dialogues": [
                {
                  "role": "王平安",
                  "text": "什么叫感觉挺真的，这就是真的，千真万确！"
                }
              ]
            },
            {
              "text": "你之前是骗子欸…",
              "dialogues": [
                {
                  "role": "王平安",
                  "text": "我现在不是了啊！我现在可是个正经人，我不都在仙师面前立誓了吗！"
                }
              ]
            }
          ]
        },
        {
          "role": "王平安",
          "text": "唉，算了，您爱怎么想就怎么想吧…"
        },
        {
          "role": "王平安",
          "text": "您要是真不信，就等正式开工之后自己过来看看吧。"
        }
      ]
    }
  ]
}