{
  "quest_id": 10289,
  "chapter_num": "",
  "chapter_title": "又是一年明月夜",
  "type": "eq",
  "route": "Another Auspicious Moonlit Night Rolls Around",
  "stories": [
    {
      "story_id": 40248,
      "title": "又是一年明月夜",
      "description": "你们忽然收到了一封香菱寄来的信，她邀请你们去遗珑埠看看…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "香菱寄来了一封信，说是想邀请我们去遗珑埠看看，她还准备了惊喜。"
        },
        {
          "role": "派蒙",
          "text": "是新的料理吗？那我们可得马上去品尝品尝，嘿嘿…"
        },
        {
          "type": "subtitle",
          "text": "查看香菱寄来的信"
        },
        {
          "type": "subtitle",
          "text": "香菱寄来的信"
        },
        {
          "role": "[[文件",
          "text": "传说任务-又是一年明月夜-香菱寄来的信.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "旅行者，派蒙，有段时间没见了，我挺想念你们的！我专门写这封信，是因为遇到了好事情就一定要惦记着好朋友。有空闲的话，来遗珑埠一趟吧，我给你们准备了惊喜哦！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往遗珑埠"
        },
        {
          "type": "subtitle",
          "text": "额外对话（言笑）"
        },
        {
          "role": "言笑",
          "text": "枫丹人的把戏还挺多，不过口味倒也确实新奇…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么收获吗？",
              "dialogues": [
                {
                  "role": "言笑",
                  "text": "收获？厨子能好好卖几盘菜，听食客几句夸赞，就算有收获了。"
                },
                {
                  "role": "言笑",
                  "text": "不过…这回见了几个德波大饭店的同行…"
                },
                {
                  "role": "言笑",
                  "text": "烹饪方法差距大是一码事，食材倒是不妨互换着试试。"
                },
                {
                  "role": "言笑",
                  "text": "我从他们那搞到了点发酵果实汁，听说还挺贵。"
                },
                {
                  "role": "言笑",
                  "text": "所以就回了他们几盒上品豆腐，自己磨的。"
                },
                {
                  "role": "言笑",
                  "text": "这发酵果实汁很不错，适中的酸口，配上一点辣椒，肯定能让肉菜吃得更有劲儿。"
                },
                {
                  "role": "言笑",
                  "text": "先炒两盘自己尝尝，再整两盘给[[江雪]]那厮试试成色。"
                }
              ]
            },
            {
              "text": "你先忙，不打扰了。",
              "dialogues": [
                {
                  "role": "言笑",
                  "text": "咋还这么见外？有空再来啊，和我唠两句也不碍事。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（萍溪）"
        },
        {
          "role": "萍溪",
          "text": "真好，这美食街上的菜肴，不少都有「富贵相」啊…"
        },
        {
          "role": "萍溪",
          "text": "要不问问看，能不能买下食谱，之后再过节摆摊了，炒几盘菜摆出来招待客人？"
        },
        {
          "role": "萍溪",
          "text": "嗯，等报菲不那么忙了，带上她一起物色好了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（迭跃）"
        },
        {
          "role": "迭跃",
          "text": "多打包几盒，用冰雾花冻着…"
        },
        {
          "role": "迭跃",
          "text": "等[[嘉明]]回来，放蒸笼里热热，再沏壶松萝仙芽…"
        },
        {
          "role": "迭跃",
          "text": "在镖局院子里摆个桌儿，边赏月，边聊天，边慢慢吃…"
        },
        {
          "role": "迭跃",
          "text": "逍遥自在！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卢香香&梅悠余）"
        },
        {
          "role": "卢香香",
          "text": "喂，梅悠余，这枫丹常用的番茄酱，配上山珍热卤面和松鼠鱼，都别有一番滋味，要不要尝一口？"
        },
        {
          "role": "梅悠余",
          "text": "…你没事吧？吃炸鱼薯条吃中毒了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（继续听听看…）",
              "dialogues": [
                {
                  "role": "卢香香",
                  "text": "嘿？不试试看就觉得我在胡说？你还配当美食家吗你？"
                },
                {
                  "role": "梅悠余",
                  "text": "我倒不信了，真能好吃？我就尝尝看！"
                },
                {
                  "role": "梅悠余",
                  "text": "……"
                },
                {
                  "role": "梅悠余",
                  "text": "…不对劲…这鲜酸开胃的口感？"
                },
                {
                  "role": "卢香香",
                  "text": "就是吧，梅悠余？我卢香香还能骗你不成？"
                },
                {
                  "role": "梅悠余",
                  "text": "行吧，这回算你赢！"
                },
                {
                  "role": "梅悠余",
                  "text": "话又说回来了，这种甜口的酱汁可不是什么菜都能加的，你给我克制一点！"
                }
              ]
            },
            {
              "text": "（还是让他们吵架去吧…）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（喜儿&大喜儿）"
        },
        {
          "role": "喜儿",
          "text": "姐姐，至冬的料理好吃吗？比起这美食街上的饭菜怎么样？"
        },
        {
          "role": "大喜儿",
          "text": "嗯…我感觉，不能武断地做比较。"
        },
        {
          "role": "大喜儿",
          "text": "环境也是影响饭菜口感的一环嘛，寒冷地带的料理强调补充能量，在我们这里吃，可能口味显得有点重…"
        },
        {
          "role": "大喜儿",
          "text": "反之，我们这里湿润温热，菜肴原封不动地搬到至冬去，至冬人也许会觉得有点清淡？"
        },
        {
          "role": "喜儿",
          "text": "所以姐姐的意思是，因地制宜，各有千秋？"
        },
        {
          "role": "大喜儿",
          "text": "差不多吧！就像喜儿喜欢姐姐我，和喜欢[[独孤朔]]小兄弟一样，不必分出高下。"
        },
        {
          "role": "喜儿",
          "text": "唔…这个不一样！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（醉今朝）"
        },
        {
          "role": "醉今朝",
          "text": "枫丹的葡萄酒，倒也不错…只要不用那种带涩味的工艺，配上清蒸的河鲜…醇美！\""
        },
        {
          "role": "醉今朝",
          "text": "嗝…不能贪杯…要牢记，霍大师的教诲…不给歹人留任何偷袭的机会。"
        },
        {
          "role": "醉今朝",
          "text": "呃，这块儿也不会有歹人吧…"
        },
        {
          "role": "醉今朝",
          "text": "那就再品半杯，再去山里练剑。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（莎凡娜）"
        },
        {
          "role": "莎凡娜",
          "text": "爱可菲和那位万民堂的厨师，居然聊得那么投机？从没见过爱可菲那种开心的样子…"
        },
        {
          "role": "莎凡娜",
          "text": "可恶，这种感觉…我怎么会比不过…一个小馆子的小姑娘？"
        },
        {
          "role": "莎凡娜",
          "text": "明明最近也有探索出不少新食谱，完全超出以往的界限了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "爱可菲也算小馆子出身吧？",
              "dialogues": [
                {
                  "role": "莎凡娜",
                  "text": "你！什么时候！"
                },
                {
                  "role": "莎凡娜",
                  "text": "呃咳…倒也有几分道理…我一时言辞不当，有错，收回评价。"
                },
                {
                  "role": "莎凡娜",
                  "text": "再前面的部分，你就当什么都没听见吧！"
                }
              ]
            },
            {
              "text": "（还是让她自言自语吧…）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿尔方斯&加斯帕德）"
        },
        {
          "role": "阿尔方斯",
          "text": "哎，那个璃月厨师给我们的豆腐，简直细腻得像一团棉花糖，真的入口即化…"
        },
        {
          "role": "阿尔方斯",
          "text": "感觉都能在拍卖行卖个十万摩拉了！拿来做点什么好？"
        },
        {
          "role": "加斯帕德",
          "text": "…甜点和正菜对半分吧？"
        },
        {
          "role": "加斯帕德",
          "text": "一道用来替换咖啡芭芭露里的布丁，软嫩甘甜；一道加在港湾牛肚里，充分吸收酱汁…"
        },
        {
          "role": "阿尔方斯",
          "text": "挺有想法啊你小子！做完了送去给[[莎凡娜]]主厨，让她评价一下？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（埃德勒&沃特蒙泰涅）"
        },
        {
          "role": "埃德勒",
          "text": "胖了？"
        },
        {
          "role": "沃特蒙泰涅",
          "text": "没有！"
        },
        {
          "role": "埃德勒",
          "text": "我看胖了不少，在璃月可没少饱口福吧…让我捏捏腰？"
        },
        {
          "role": "沃特蒙泰涅",
          "text": "没门！你再这样，我就要写信向老师投诉你了！"
        },
        {
          "role": "埃德勒",
          "text": "哈哈哈，你还是没变，完全开不起玩笑嘛…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿绿）"
        },
        {
          "role": "阿绿",
          "text": "嗯呵呵~全都是收获，全都是收获~"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（继续听听看…）",
              "dialogues": [
                {
                  "role": "阿绿",
                  "text": "《阿绿美食指南·璃月篇》要更新的重点餐馆，就是望舒客栈。"
                },
                {
                  "role": "阿绿",
                  "text": "考虑到无可匹敌的风味和性价比，必须给满星！"
                },
                {
                  "role": "阿绿",
                  "text": "不过…这样会不会导致客流量激增，老顾客的习惯被扰乱，甚至排不上号？"
                },
                {
                  "role": "阿绿",
                  "text": "客流量的骤增也可能影响菜品的平均质量，毕竟厨师的数量有限，忙不过来…"
                },
                {
                  "role": "阿绿",
                  "text": "要和他们的老板好好商量一下啊，采取优先预约和开放等号交替运营的方法，能不能缓解这个问题呢…"
                }
              ]
            },
            {
              "text": "（还是不听了。）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（萝克珊）"
        },
        {
          "role": "萝克珊",
          "text": "好怪，再吃一口…"
        },
        {
          "role": "萝克珊",
          "text": "……"
        },
        {
          "role": "萝克珊",
          "text": "…好怪好怪，多吃几口…"
        },
        {
          "role": "萝克珊",
          "text": "好像也不那么怪了…习惯了还挺好吃的。"
        },
        {
          "role": "萝克珊",
          "text": "要不带点去给[[阿林|林上校]]？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（柴葉紫&百日白白音）"
        },
        {
          "role": "柴葉紫",
          "text": "记住了吗，白音？每个店家最厉害的菜品，制作的预算，还有拜师学徒的学费…"
        },
        {
          "role": "百日白白音",
          "text": "都记好了，姐姐！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在忙什么呢？",
              "dialogues": [
                {
                  "role": "百日白白音",
                  "text": "啊，居然是旅行者…看来我们的好运还在叠加？"
                },
                {
                  "role": "柴葉紫",
                  "text": "我们这不算忙哦，只不过是享受假期的途中，顺带记一些厉害的饭店和厨师…"
                },
                {
                  "role": "柴葉紫",
                  "text": "之后专门抽空，每家学上半个月，专攻一道招牌菜。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "为什么要学厨？",
                      "dialogues": []
                    },
                    {
                      "text": "你们也得做饭？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "柴葉紫",
                  "text": "食物疗法也是改善精神状态的一种嘛，我们还远没摸到这方面的天花板哦，当然要虚心请教专业人士。"
                },
                {
                  "role": "百日白白音",
                  "text": "而且，要是[[瑞希]]姐姐的娱乐集团计划真的开办了，我们也要对各种分店的料理把关！"
                }
              ]
            },
            {
              "text": "玩得开心哦！",
              "dialogues": [
                {
                  "role": "百日白白音",
                  "text": "啊，居然是旅行者…看来我们的好运还在叠加？"
                },
                {
                  "role": "柴葉紫",
                  "text": "谢谢，你也是哦！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（「怪力三十三」&「花角玉将」）"
        },
        {
          "role": "「怪力三十三」",
          "text": "玉将，你到底什么时候才回花见坂啊？都已经在璃月进修这么久了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（继续听听看…）",
              "dialogues": [
                {
                  "role": "「花角玉将」",
                  "text": "三十三哟，机关术的奥秘无穷无尽，在开发出完美的斗虫神机之前，我不能分心。"
                },
                {
                  "role": "「花角玉将」",
                  "text": "你们安心跟着[[荒泷一斗|鬼王]]混，等我的好消息！"
                },
                {
                  "role": "「怪力三十三」",
                  "text": "那，来这个美食街游玩算什么？这样就不分心了吗？"
                },
                {
                  "role": "「花角玉将」",
                  "text": "这…谁让我拿到教本后，就一直在遗珑埠租房进修呢？出门吃两口饭，才有体力继续钻研嘛。"
                },
                {
                  "role": "「花角玉将」",
                  "text": "不然，怎么有机会撞见你呢？"
                },
                {
                  "role": "「怪力三十三」",
                  "text": "…请我把所有好吃的都吃一遍，再带我去看看你现在的拿手成果，我就不计较了。"
                },
                {
                  "role": "「花角玉将」",
                  "text": "好！当然没问题！绝对可以！"
                }
              ]
            },
            {
              "text": "（还是不听了…）",
              "dialogues": [
                {
                  "role": "「花角玉将」",
                  "text": "三十三哟，你听我解释…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（松本）"
        },
        {
          "role": "松本",
          "text": "是错觉吗？这边的饭菜，调味五花八门啊。"
        },
        {
          "role": "松本",
          "text": "少了许多拘谨的感觉，在各种风味上都大胆许多…"
        },
        {
          "role": "松本",
          "text": "回去以后，和[[木南杏奈|杏奈]]好好说说看吧，多学多进步！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（冈崎陆斗&冈崎绘里香）"
        },
        {
          "role": "冈崎陆斗",
          "text": "好像找回了年轻时的感觉啊…真不错。"
        },
        {
          "role": "冈崎绘里香",
          "text": "是啊，我们有多久没这样一起出游了…"
        },
        {
          "role": "冈崎绘里香",
          "text": "就抓紧机会，再携手完成一百道料理，如何？"
        },
        {
          "role": "冈崎陆斗",
          "text": "不在话下，我来备菜。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（沙瓦玛）"
        },
        {
          "role": "沙瓦玛",
          "text": "是面饼！奥秘不止在馅料，还有面饼啊！"
        },
        {
          "role": "沙瓦玛",
          "text": "小麦粉的调配，擀面的手法，都能对面饼产生巨大的影响。"
        },
        {
          "role": "沙瓦玛",
          "text": "不过，去剧场里聚餐团建的客人喝了酒以后…能品出区别吗？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（艾依曼）"
        },
        {
          "role": "艾依曼",
          "text": "什么叫…自家酿的…没什么度数？"
        },
        {
          "role": "艾依曼",
          "text": "这，这对劲吗？"
        },
        {
          "role": "艾依曼",
          "text": "不应该加冰块喝的…要考察学习的事…全想不起来了。"
        },
        {
          "role": "艾依曼",
          "text": "璃月的风儿…力气怎么也这么大？快站不稳了…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊萨克）"
        },
        {
          "role": "伊萨克",
          "text": "嘿嘿，被夸啦，我的手艺确实进步了！"
        },
        {
          "role": "伊萨克",
          "text": "不过还不能骄傲，要多学多想…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么事这么高兴？",
              "dialogues": [
                {
                  "role": "伊萨克",
                  "text": "啊，是你！"
                },
                {
                  "role": "伊萨克",
                  "text": "我带了一箱自己做的椰炭饼过来，分给大家…"
                },
                {
                  "role": "伊萨克",
                  "text": "没想到，很快就分完了，好多人觉得很新奇很特别！"
                },
                {
                  "role": "伊萨克",
                  "text": "戴着高帽子穿厨师服的红发大姐姐，对其他厨师都很严格的那个，居然都夸我了！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "恭喜喔！",
                      "dialogues": []
                    },
                    {
                      "text": "很棒喔！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "伊萨克",
                  "text": "嘿嘿，谢谢你！下次我一定多留几份给你！"
                }
              ]
            },
            {
              "text": "你加油！",
              "dialogues": [
                {
                  "role": "伊萨克",
                  "text": "嗯，我会的！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（卡玛尔）"
        },
        {
          "role": "卡玛尔",
          "text": "哎呀，要不要问问那边的枫丹厨师，愿不愿意加入[[朱莉]]和[[芭尔瓦涅]]的队伍…"
        },
        {
          "role": "卡玛尔",
          "text": "唔，可能不太好？像是在挖人家的墙脚。谈太多摩拉的问题，又违背了芭尔瓦涅的意愿。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "挖墙脚？怎么回事？",
              "dialogues": [
                {
                  "role": "卡玛尔",
                  "text": "哎呀，这不是我们协会的皇牌吗？那我简单和你说说…"
                },
                {
                  "role": "卡玛尔",
                  "text": "我们协会有个年轻晚辈，叫朱莉，她和三个朋友组建了一支专门寻找和开发美味料理的神奇小队。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "有点印象。",
                      "dialogues": [
                        {
                          "role": "卡玛尔",
                          "text": "是吧，你应该也遇见过他们。"
                        }
                      ]
                    },
                    {
                      "text": "没听说过。",
                      "dialogues": [
                        {
                          "role": "卡玛尔",
                          "text": "正常，他们毕竟不是那种在一线闪光的强人。"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "卡玛尔",
                  "text": "总之，他们被卷入了一起商业纠纷，碰上了棘手的大麻烦…"
                },
                {
                  "role": "卡玛尔",
                  "text": "打官司嘛，你懂的，来来回回捣鼓捣鼓，就是好几年。"
                },
                {
                  "role": "卡玛尔",
                  "text": "中途，他们本来都去了一趟枫丹，旅馆都还没住上两天，就被这事缠着回了教令院。"
                },
                {
                  "role": "卡玛尔",
                  "text": "最近这事才有点结清的眉目，所以他们才要正式继续在枫丹的旅程。"
                },
                {
                  "role": "卡玛尔",
                  "text": "根据之前停留那几天的经验，他们发现，队伍里没有精通枫丹料理的成员，所以想要寻找这方面的能手…"
                },
                {
                  "role": "卡玛尔",
                  "text": "我就顺带帮忙物色一下人才了。当然，前提是不影响人家原本的职业规划！"
                }
              ]
            },
            {
              "text": "你是哪位来着…",
              "dialogues": [
                {
                  "role": "卡玛尔",
                  "text": "哟，你好久不见了，大名鼎鼎的皇牌冒险家。"
                },
                {
                  "role": "卡玛尔",
                  "text": "我是须弥分会的会长，但不算最强的那个。"
                },
                {
                  "role": "卡玛尔",
                  "text": "以后还请多多关照须弥这边的事务啊。"
                }
              ]
            },
            {
              "text": "（还是不打扰他了…）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（漱玉）"
        },
        {
          "role": "漱玉",
          "text": "吃一点枫丹的甜点，再尝一点须弥的烤肉…"
        },
        {
          "role": "漱玉",
          "text": "不过，师父给我的零花钱是不是有点多了…我吃到肚子圆圆也用不完。"
        },
        {
          "role": "漱玉",
          "text": "嗯，就存起来好了，以后买些机关能用上的小部件。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（埃洛雯&芙里达）"
        },
        {
          "role": "埃洛雯",
          "text": "等等，居然遇见了旅行者长官？"
        },
        {
          "role": "芙里达",
          "text": "别惊讶，荣誉骑士出现在哪里都有可能…"
        },
        {
          "role": "芙里达",
          "text": "后勤小队的芙里达和游击小队的埃洛雯向您报告！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "西风骑士也来美食街参展？",
              "dialogues": [
                {
                  "role": "芙里达",
                  "text": "没错，「国际美食街」的消息传到蒙德后，赫塔队长提出，可以借此机会宣传蒙德美食。"
                },
                {
                  "role": "芙里达",
                  "text": "经过骑士团内部的讨论，派出了我作为代表，埃洛雯作为后援，前来开设了这个展位。"
                },
                {
                  "role": "埃洛雯",
                  "text": "本来我们还想邀请猎鹿人的[[莎拉]]小姐，可惜店里的事务太忙，她一时走不开…"
                },
                {
                  "role": "埃洛雯",
                  "text": "清泉镇的[[布洛克]]小姐也是蒙德有名的肉类料理大师，她的菜肴很有代表性。"
                },
                {
                  "role": "埃洛雯",
                  "text": "但最近，她采摘慕风蘑菇试做配料的时候，不小心扭伤了脚，出不了远门，只能照常在清泉镇做饭。"
                },
                {
                  "role": "埃洛雯",
                  "text": "所以，我们就带着她们两位的招牌菜菜谱和心意过来了。"
                },
                {
                  "role": "芙里达",
                  "text": "阵仗确实不大，但胜在简洁明了，颇有骑士团的干练之风，也算一种特色，有助于快速体验蒙德风味。"
                }
              ]
            },
            {
              "text": "什么料理销路最好？",
              "dialogues": [
                {
                  "role": "埃洛雯",
                  "text": "是「国际美食街」特制版的西风加护堆高高，蜜酱胡萝卜煎肉，还有什锦烤肉排！"
                },
                {
                  "role": "埃洛雯",
                  "text": "调料的口味稍微减轻，好让油盐需求没那么强的客人适应。部分新鲜蔬菜也从本地采买。"
                },
                {
                  "role": "芙里达",
                  "text": "在收汁阶段，再加入我们标准配给口粮里的肉酱和番茄酱，增色增香，完美！"
                },
                {
                  "role": "埃洛雯",
                  "text": "欸？前辈，原来那两种酱汁是罐头里的吗？"
                },
                {
                  "role": "埃洛雯",
                  "text": "可我们做的都是新鲜的美食，也要用上罐头里的材料吗？"
                },
                {
                  "role": "芙里达",
                  "text": "没关系嘛，只要主要的食材够新鲜就好。"
                },
                {
                  "role": "芙里达",
                  "text": "总不至于，我们的香肠培根都要现做…黄油和盐都要当场提炼吧？"
                }
              ]
            },
            {
              "text": "那要加油哦。",
              "dialogues": [
                {
                  "role": "埃洛雯",
                  "text": "会的会的，请您放一万个心！"
                },
                {
                  "role": "芙里达",
                  "text": "我们一定全力以赴！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（捷悟&报菲）"
        },
        {
          "role": "捷悟",
          "text": "纸映剧准备得如何了？"
        },
        {
          "role": "报菲",
          "text": "快了，快了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（蓝颖&瑶露）"
        },
        {
          "role": "蓝颖",
          "text": "我还想再检查一下藤人内部的术法核心…"
        },
        {
          "role": "瑶露",
          "text": "不急哦，慢慢来吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（墨忘&文寻）"
        },
        {
          "role": "墨忘",
          "text": "内部光源…光路组件…一切正常。"
        },
        {
          "role": "文寻",
          "text": "那我待会儿先来试试看好了？"
        },
        {
          "role": "派蒙",
          "text": "哇，今天的遗珑埠好热闹啊，是在举办什么活动吗？"
        },
        {
          "role": "香菱",
          "text": "旅行者，派蒙，在这边！"
        },
        {
          "role": "派蒙",
          "text": "是香菱！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是什么活动？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "算算日子嘛，这是今年的逐月节。"
        },
        {
          "role": "派蒙",
          "text": "对哦，差点忘了！所以这是要办厨王争霸赛？"
        },
        {
          "role": "香菱",
          "text": "今年不太一样啦…"
        },
        {
          "role": "爱可菲",
          "text": "厨王争霸赛…璃月还有这么有趣的活动吗？"
        },
        {
          "role": "派蒙",
          "text": "爱可菲！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你怎么也在这里？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "难道是作为强大的外敌，被特邀参加厨王争霸赛，最后成为所有璃月厨师的终极对手？"
        },
        {
          "role": "爱可菲",
          "text": "听上去还不错…"
        },
        {
          "role": "香菱",
          "text": "哎呀不是啦，这次逐月节没有举办厨王争霸赛，而是改为举办一种叫做「国际美食街」的活动。"
        },
        {
          "role": "香菱",
          "text": "蒙德，枫丹和须弥都有代表来参加活动，爱可菲小姐就是作为枫丹料理界的代表来到这里的。"
        },
        {
          "role": "派蒙",
          "text": "国际美食街？"
        },
        {
          "role": "香菱",
          "text": "对，在这个活动里能同时品尝四个国家的美食哦！我觉得你们一定不愿意错过，就专门写了一封信。"
        },
        {
          "role": "派蒙",
          "text": "当然，这就是我最喜欢的活动！"
        },
        {
          "role": "香菱",
          "text": "活动已经开始了，我还要处理摊位那边的事，就不陪你们逛了。要是嘴馋了，欢迎来尝尝我的手艺！"
        },
        {
          "role": "爱可菲",
          "text": "我这次准备的料理也不容错过，欢迎来品尝。"
        },
        {
          "role": "派蒙",
          "text": "好耶！"
        },
        {
          "role": "爱可菲",
          "text": "香菱小姐，之前你讲到的厨艺心得对我很有启发，能允许我记录下来吗？"
        },
        {
          "role": "香菱",
          "text": "不要这么严肃啦，我只是随口说一说…"
        },
        {
          "role": "派蒙",
          "text": "哇，如果香菱和爱可菲合作…她们是不是能烹饪出更好吃的料理呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "话说回来…",
              "dialogues": []
            },
            {
              "text": "这次逐月节还真特别。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "确实，我来之前也没想到这次逐月节的活动是在遗珑埠举办，而且厨王争霸赛没了，还多了个国际美食街…"
        },
        {
          "role": "蓝砚",
          "text": "大概是宗家的长辈们觉得，遗珑埠四国通航，又恰逢佳节，正好可以借助逐月节的美食传统举办一种国际性的活动。"
        },
        {
          "role": "蓝砚",
          "text": "这样可以吸引各国游客，为遗珑埠的乡亲们多谋求一些财运。"
        },
        {
          "role": "派蒙",
          "text": "蓝砚，还有凝光！好久不见！"
        },
        {
          "role": "凝光",
          "text": "有段时间没见了，旅行者，派蒙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "蓝砚刚刚的意思是？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蓝砚",
          "text": "看来你们还不知道，这次逐月节的活动由沉玉谷的行会承办。"
        },
        {
          "role": "蓝砚",
          "text": "而我的宗家在行会中说话很有分量，这次活动的具体安排就是宗家的长辈们商量决定的。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样，那真是个好决定！"
        },
        {
          "role": "派蒙",
          "text": "不过，不办厨王争霸赛真的合适吗？我还以为厨王争霸赛是一种很重要的传统…"
        },
        {
          "role": "凝光",
          "text": "你们多虑了，逐月节自诞生之初就拥有非常浓厚的民间背景。"
        },
        {
          "role": "凝光",
          "text": "在璃月的历史中，许多新的习俗陆续被添加到逐月节的庆祝活动中来，然后才演变成一种「传统」，厨王争霸赛就是这样。"
        },
        {
          "role": "凝光",
          "text": "官方从来没有规定过逐月节要举办什么样的庆祝活动，大多都是民间自发。"
        },
        {
          "role": "凝光",
          "text": "或许，这次的国际美食街也会成为一种新的「传统」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来如此。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那凝光和蓝砚也是来过节的吧？嗯…为什么还带着千岩军呢？"
        },
        {
          "role": "凝光",
          "text": "其实，我这次来遗珑埠是为了公事。"
        },
        {
          "role": "凝光",
          "text": "每年的这个时节，璃月各处总有邪祟集中作乱。邪气会附身魔物，让它们变得比平时更危险。"
        },
        {
          "role": "凝光",
          "text": "千岩军已经开始行动，我这次来遗珑埠，是为了协调千岩军与蓝家之间的合作。"
        },
        {
          "role": "凝光",
          "text": "刚刚蓝砚正要带我去见她的族长，碰巧看到了你们。"
        },
        {
          "role": "派蒙",
          "text": "千岩军要和蓝砚的家族合作？"
        },
        {
          "role": "凝光",
          "text": "正是如此，蓝砚的宗家可是有名的方士世家，你们听说过璃月方士的事吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有所耳闻。",
              "dialogues": []
            },
            {
              "text": "还没了解过。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "在璃月民间有很多能人异士，他们修习着或是源自仙人或是自我领悟的奇门术法，并一代代传承下来。"
        },
        {
          "role": "凝光",
          "text": "这些人被称为「方士」，往生堂的祖师爷无妄童子和蓝家的先祖万象风角灵官正是其中的代表。"
        },
        {
          "role": "凝光",
          "text": "方士们掌握的奇门术法十分强大，因此，当风雨不调，邪祟作乱的时候，他们也会成为保境安民的一股重要力量。"
        },
        {
          "role": "派蒙",
          "text": "是这样啊，蓝砚的家族听上去好厉害！不过，说到邪祟作乱…"
        },
        {
          "role": "凝光",
          "text": "诚然，璃月各处都有仙人庇佑，但不是我等凡人不思进取的理由。"
        },
        {
          "role": "凝光",
          "text": "此外，这个时节的邪祟明显多于平日，饶是仙人，怕也会疲惫，我等就更应该出一份力。"
        },
        {
          "role": "凝光",
          "text": "在这个时节，千岩军和民间方士联手处理邪祟，早已是惯例。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实该这样。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "如果没有其他的事情，就恕不久陪了。如果有闲暇，不妨到群玉阁好好叙旧，我一定拿上好的茶点招待你们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "需要我帮忙吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，我们也来帮忙！"
        },
        {
          "role": "凝光",
          "text": "旅行者和派蒙的好意，我先谢过了，不过我还是希望你们能像普通民众那样好好享受节日。"
        },
        {
          "role": "凝光",
