{
  "quest_id": 41332,
  "chapter_num": null,
  "chapter_title": "勺起万民足",
  "type": "wq",
  "route": "Keeping Wanmin's Patrons Fed",
  "stories": [
    {
      "story_id": 41332,
      "title": "勺起万民足",
      "description": "正逢一年一度的海灯节，「万民堂」的卯师傅又忙活开了…",
      "dialogues": [
        {
          "role": "竺子",
          "text": "不知道，稻妻那边现在是什么情况…"
        },
        {
          "role": "卯师傅",
          "text": "还有几份来着…"
        },
        {
          "role": "旅行者",
          "text": "在忙些什么？"
        },
        {
          "role": "卯师傅",
          "text": "哈哈，我还能忙些什么，当然是「万民堂」的生意嘛。"
        },
        {
          "role": "卯师傅",
          "text": "最近赶上海灯节，出来下馆子的人特别多，还有不少凑热闹的外国游客。"
        },
        {
          "role": "卯师傅",
          "text": "虽然我闺女香菱也回来帮忙了，但她也是忙得脚后跟不沾地，这不，刚刚出去送菜去了…"
        },
        {
          "role": "卯师傅",
          "text": "别人家早挂上霄灯过节去了，咱家「万民堂」可是忙得连霄灯都没空编啊。"
        },
        {
          "role": "卯师傅",
          "text": "对了旅行者，如果你愿意的话，能帮我个忙吗？"
        },
        {
          "role": "卯师傅",
          "text": "你认识竺子吧？就是那个在码头上的小姑娘，从稻妻来的那个。"
        },
        {
          "role": "卯师傅",
          "text": "她在我们这里订了份吃的，请你帮我送过去吧，大过节的，我特意给她做的分量大了些。"
        },
        {
          "role": "卯师傅",
          "text": "还有总是在码头上忙的那几位，王扳子、李锤子、观海、志华…"
        },
        {
          "role": "卯师傅",
          "text": "这几位总是照顾我们店的生意，这大过节的他们也还在码头上，估计也是因为工作吧。"
        },
        {
          "role": "卯师傅",
          "text": "我也想给他们几位都准备点好吃的，也算是过个节。但我这店里太忙了，实在是抽不开身…"
        },
        {
          "role": "卯师傅",
          "text": "旅行者，你就顺便帮我去问问他们最想吃什么吧，我好给他们准备菜。"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "卯师傅",
          "text": "那就拜托你了，问到了之后就赶紧回来告诉我吧。"
        },
        {
          "role": "竺子",
          "text": "「万民堂」的餐怎么还没送来…"
        },
        {
          "role": "旅行者",
          "text": "你的餐到了。"
        },
        {
          "role": "竺子",
          "text": "啊！谢谢你，我还以为再过一会才能送到呢。"
        },
        {
          "role": "竺子",
          "text": "璃月这个海灯节的氛围，我都有点想家了，但是…稻妻我应该暂时回不去了吧…"
        },
        {
          "role": "竺子",
          "text": "不知道，稻妻那边现在是什么情况…"
        },
        {
          "role": "竺子",
          "text": "「万民堂」的餐怎么还没送来…"
        },
        {
          "role": "旅行者",
          "text": "你的餐到了。"
        },
        {
          "role": "竺子",
          "text": "总算来了，我都等好久了…不过在节日期间还给我外送餐品，真是麻烦你了。"
        },
        {
          "role": "竺子",
          "text": "璃月这个海灯节的氛围，我都有点想家了，但是…稻妻我应该暂时回不去了吧…"
        },
        {
          "role": "竺子",
          "text": "不知道，稻妻那边现在是什么情况…"
        },
        {
          "role": "旅行者",
          "text": "我推荐水煮黑背鲈。"
        },
        {
          "role": "观海",
          "text": "「万民堂」的招牌菜啊，早吃过很多次了，而且也不是酸甜口的，感觉不大想吃。"
        },
        {
          "role": "旅行者",
          "text": "我推荐水晶虾。"
        },
        {
          "role": "观海",
          "text": "这道菜里面没有鱼吧，而且味道也很寡淡，感觉不大想吃。"
        },
        {
          "role": "旅行者",
          "text": "我推荐松鼠鱼。"
        },
        {
          "role": "观海",
          "text": "哦，对对对，我怎么没想到松鼠鱼呢。"
        },
        {
          "role": "观海",
          "text": "酸甜酥脆，想着就觉得饿了，我等着品品卯师傅的手艺了。"
        },
        {
          "role": "旅行者",
          "text": "我推荐天枢肉。"
        },
        {
          "role": "志华",
          "text": "这道菜…有点太油了…"
        },
        {
          "role": "旅行者",
          "text": "我推荐烤吃虎鱼。"
        },
        {
          "role": "志华",
          "text": "这道菜好吃是好吃，但就是味道有点太重了，吃完之后身上总是有一股散不去的烤吃虎鱼味…"
        },
        {
          "role": "旅行者",
          "text": "我推荐莲花酥。"
        },
        {
          "role": "志华",
          "text": "哦？感觉不错，小巧精致，味道也很不错，很适合…"
        },
        {
          "role": "志华",
          "text": "咳…总之就是这道菜了。"
        },
        {
          "role": "旅行者",
          "text": "我推荐扣三丝。"
        },
        {
          "role": "李锤子",
          "text": "我听说书的讲过，扣三丝那菜只要嘬一口，汤就没了，我觉得不行。"
        },
        {
          "role": "王扳子",
          "text": "你什么时候去听的说书？怎么没叫我？"
        },
        {
          "role": "旅行者",
          "text": "我推荐来来菜。"
        },
        {
          "role": "李锤子",
          "text": "我听说书的讲过，来来菜讲究不小，不过这菜里面没笋，我觉得不行。"
        },
        {
          "role": "王扳子",
          "text": "说书的什么时候还讲上菜谱了？我完全没印象…"
        },
        {
          "role": "旅行者",
          "text": "我推荐腌笃鲜。"
        },
        {
          "role": "李锤子",
          "text": "这菜好，我听说书的讲——「文火细炖，滋味悠长」，肯定好吃。"
        },
        {
          "role": "王扳子",
          "text": "不错不错，那就它了。"
        },
        {
          "role": "卯师傅",
          "text": "餐送到了吗？"
        },
        {
          "role": "旅行者",
          "text": "送到了。"
        },
        {
          "role": "卯师傅",
          "text": "好，请你帮忙果然没错，王扳子、观海还有志华想吃的菜也都问到了吗？"
        },
        {
          "role": "旅行者",
          "text": "王扳子和李锤子想吃腌笃鲜。"
        },
        {
          "role": "卯师傅",
          "text": "哦？这哥俩口味倒一致，不过腌笃鲜可是费工夫的菜，我得早些准备。"
        },
        {
          "role": "旅行者",
          "text": "观海想吃松鼠鱼。"
        },
        {
          "role": "卯师傅",
          "text": "没问题，这菜我拿手。"
        },
        {
          "role": "旅行者",
          "text": "志华想吃莲花酥。"
        },
        {
          "role": "卯师傅",
          "text": "没想到志华喜欢吃这种小巧精致的点心，不过莲花酥也不难做，没问题。"
        },
        {
          "role": "卯师傅",
          "text": "谢谢你帮我去打听了，这点薄礼你可得收下，我得赶快去忙活了。"
        },
        {
          "role": "旅行者",
          "text": "你不挂霄灯吗？"
        },
        {
          "role": "卯师傅",
          "text": "嗨，哪有那时间，我忙着炒菜，香菱刚过来拿了新的餐送出去了…"
        },
        {
          "role": "卯师傅",
          "text": "我们这父女俩忙得脚不沾地，哪有那时间。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这事就交给我了。",
            "我做一盏霄灯给你吧。"
          ]
        },
        {
          "role": "旅行者",
          "text": "这事就交给我了。"
        },
        {
          "role": "卯师傅",
          "text": "你…你愿意帮忙？那就拜托你了，那我正发愁，店里没霄灯，没有过节的感觉呢。"
        },
        {
          "role": "卯师傅",
          "text": "这霄灯，看着真好。哎呀…我等会就把愿望写上，等那丫头回来了之后，我们父女俩一起把霄灯放了。"
        },
        {
          "role": "卯师傅",
          "text": "谢谢你旅行者，这些东西请收下，就当做是谢礼了。"
        }
      ]
    }
  ]
}