{
  "quest_id": 71115,
  "chapter_num": null,
  "chapter_title": "彩蝶翩然过谷中",
  "type": "wq",
  "route": "Silently the Butterfly Crosses the Valley",
  "stories": [
    {
      "story_id": 71115,
      "title": "彩蝶翩然过谷中",
      "description": "药蝶谷中似乎隐藏着尚不为人所知的秘密…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "抓住彩蝶"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "唔…嗯？尔等何人？扰我好梦…！"
        },
        {
          "role": "派蒙",
          "text": "欸？！什么东西在说话？好可怕！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "哇！"
        },
        {
          "role": "派蒙",
          "text": "哇啊啊！！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "哈哈哈哈哈！害怕就对咯！若我未被山石所困，你们早就进我肚子里啦！"
        },
        {
          "role": "派蒙",
          "text": "什么…？啊！原来只是会说话的石像呀…我还以为是什么怪物！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "哼，什么叫「只是会说话的石像」！石像会说话难道不可怕吗！"
        },
        {
          "role": "派蒙",
          "text": "呃，像这样的石像，我们在外面已经见过很多了…"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "什、什么！唉，好吧，那看来是吓不到你们了…"
        },
        {
          "role": "派蒙",
          "text": "为什么非要吓到别人呀，真是的！明明只是个石像而已！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "哼！就算我「只是个石像而已」，此地可是药君大人的洞府！药君大人还在的时候，就不喜欢别人随意打扰她的安宁！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "所以呀，我就要把讨厌的家伙全部吓跑！就算药君大人离开了也是一样！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "不过，你们的气息和那些普通的凡人好像也有些不同，而且也没有被我吓到…"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "可不可以拜托你们，帮我一个忙呢？"
        },
        {
          "role": "派蒙",
          "text": "哦？那你要我们帮什么忙呀？"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "咳咳，你们看这些彩色的蝴蝶！自从洞府的主人离开后，这些小家伙就散落得遍地都是，到处乱飞——"
        },
        {
          "role": "派蒙",
          "text": "嘘…先等一下，你头上就有一只呢！稍等一下，让我们帮你拿下来…"
        },
        
        {
          "role": "「慢悠悠仙像」",
          "text": "呼…对啦，就是这个！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "先前洞府药君曾引彩蝶点缀门户，后来洞府机关破败，这些彩蝶与药罐…原是用于滋养那棵仙树的。"
        },
        {
          "role": "派蒙",
          "text": "仙树？"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "哼哼，没错！想当初，这仙树乃是药君大人亲手栽下…"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "虽说现在已经枯萎，但药君大人说过，只要彩蝶还没有散尽，那棵树便可以复生！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "唉…自从无力维持人形之后，她很快便离开了，不知如今过得如何…"
        },
        {
          "role": "旅行者",
          "text": "「彩蝶汇坛中，复枯木逢生之貌…」"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "没错没错！只要…不对，你们是怎么知道的？"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "算了，总之就是这样！只要把那些彩蝶赶进罐子里，就能滋养那棵枯木啦！那就拜托你们了，好心的人类！"
        },
        {
          "type": "subtitle",
          "text": "将所有彩蝶赶进罐子"
        },
        {
          "role": "派蒙",
          "text": "喂！你这个坏家伙，我们已经把彩蝶全部赶回罐子里了，仙树的样子还是没变嘛！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "嗯…？尔等何人？扰我…啊，是你们，好心的人类…"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "哦哦！没想到你们还真把彩蝶都找到了！我就那么随便一说…"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "不、不！我的意思是…我也感受到仙力的悸动了！接下来只要念诵药君大人留下的口诀，就可以让仙树重现生机啦！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "等等，口诀是什么来着，我想想…"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "「…木生于冬，岁聿枯荣。我思逢春，又复芳雍…」"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "…蝶彩翩翻…翩翻…后面的我忘了，总之最后是万象回从！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！突、突然完全变了一副样子…！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "哼哼，既然药君大人将这棵树托付给了我，我总不能眼睁睁看着它枯败下去！谢谢你们啦，好心的人类！"
        },
        {
          "role": "派蒙",
          "text": "明明连口诀都不记得了！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "这种细节就不要在意啦！"
        },
        {
          "role": "「慢悠悠仙像」",
          "text": "对了，如果有兴趣的话，我还有一个小小的秘密告知你们！折下一根花枝，插在洞府门外的破药罐里，即可打开石门…"
        }
      ]
    }
  ]
}