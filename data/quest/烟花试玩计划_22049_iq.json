{
  "quest_id": 22049,
  "chapter_num": null,
  "chapter_title": "烟花试玩计划",
  "type": "iq",
  "route": "Playing With Fire... Works",
  "stories": [
    {
      "story_id": 22049,
      "title": "烟花试玩计划",
      "description": "长野原烟花店似乎又有了新型的烟花…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与长野原龙之介对话"
        },
        {
          "role": "长野原龙之介",
          "text": "哦呀，这不是丫头的新朋友吗？今天又来玩啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "今天的生意还好吗？",
              "dialogues": [
                {
                  "role": "长野原龙之介",
                  "text": "很好，很好！哈哈哈，都是我那丫头把烟花鼓捣得好啊！"
                },
                {
                  "role": "长野原龙之介",
                  "text": "你们今天，是来找她的吗？"
                }
              ]
            },
            {
              "text": "请问宵宫在吗？",
              "dialogues": [
                {
                  "role": "长野原龙之介",
                  "text": "哎呀，你们今天是来找她的吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "长野原龙之介",
          "text": "真不巧，那丫头说，她要去外面找做烟花的材料，已经出门去啦！"
        },
        {
          "role": "旅行者",
          "text": "那她去哪了？"
        },
        {
          "role": "长野原龙之介",
          "text": "什、什么？你说什么？"
        },
        {
          "role": "旅行者",
          "text": "宵宫，她去哪里了！"
        },
        {
          "role": "长野原龙之介",
          "text": "喔，哎呀…这个我可不太清楚哟，那丫头也许说过了，但我这耳朵啊，真是听不清…"
        },
        {
          "role": "长野原龙之介",
          "text": "你们找那丫头有什么事吗？是想要，买点烟花玩玩？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想找宵宫玩…",
              "dialogues": [
                {
                  "role": "长野原龙之介",
                  "text": "唔，这次你们估计是找不着她啦，那丫头每次出去鼓捣烟花，都不知道什么时候才回来。"
                },
                {
                  "role": "长野原龙之介",
                  "text": "这样，那丫头出门之前，做了一些新烟花放在店里，你们就先拿这些烟花去玩玩吧。"
                }
              ]
            },
            {
              "text": "想玩烟花…",
              "dialogues": [
                {
                  "role": "长野原龙之介",
                  "text": "哈哈，那好说啊。那丫头出门之前，做了一些新烟花放在店里，你们就拿这些烟花去玩玩吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "长野原龙之介",
          "text": "我把那些烟花放哪了…好像放屋里了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这样是不是不太好…",
              "dialogues": []
            },
            {
              "text": "也没告诉宵宫…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长野原龙之介",
          "text": "没关系，没关系，店里还备着很多货，你们拿一两个去玩玩，没什么大事。"
        },
        {
          "role": "长野原龙之介",
          "text": "再说了，我那丫头本来就打算找人来试玩这些新烟花的，你们今天过来，也正好来试玩一下。"
        },
        {
          "role": "长野原龙之介",
          "text": "你们就放心大胆地拿着这些烟花出去玩，玩好了之后，回来告诉我烟花怎么样。"
        },
        {
          "role": "长野原龙之介",
          "text": "等那丫头回来，我再转告她一下。"
        },
        {
          "role": "长野原龙之介",
          "text": "放心吧，那丫头要是知道那些烟花是你们拿去玩的，高兴还来不及呢。"
        },
        {
          "role": "长野原龙之介",
          "text": "快点去吧，你们放烟花的时候可要在城外放。在城里放烟花啊，又要招来好些人了…"
        },
        {
          "type": "subtitle",
          "text": "去城外试玩烟花"
        },
        {
          "role": "长野原龙之介",
          "text": "快点去吧，你们放烟花的时候可要在城外放。在城里放烟花啊，又要招来好些人了…"
        },
        {
          "type": "subtitle",
          "text": "向长野原龙之介回报"
        },
        {
          "role": "长野原龙之介",
          "text": "你们回来了，烟花怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很好看。",
              "dialogues": [
                {
                  "role": "长野原龙之介",
                  "text": "你们喜欢就好，哈哈哈。"
                }
              ]
            },
            {
              "text": "还没玩够…",
              "dialogues": [
                {
                  "role": "长野原龙之介",
                  "text": "你们很喜欢吗？那就好，下次你们再来拿点去玩吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "长野原龙之介",
          "text": "好了，我也该去打理打理店里了，最近来买烟花的人真是越来越多了。"
        },
        {
          "role": "长野原龙之介",
          "text": "那丫头怎么到现在还没回来，到底去哪鼓捣了…"
        }
      ]
    }
  ]
}