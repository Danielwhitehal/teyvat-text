  "chapter_title": "餐品订单",
  "type": "iq",
  "route": "Food Delivery",
  "stories": [
    {
      "story_id": 20006,
      "title": "餐品订单",
      "description": "为了满足顾客的需要，猎鹿人餐馆持续提供着送餐服务。但是因为顾客众多，餐馆里的人手严重不足，莎拉小姐想要找一个人来帮忙送餐。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往猎鹿人餐馆询问莎拉"
        },
        {
          "type": "subtitle",
          "text": "与莎拉对话"
        },
        {
          "role": "莎拉",
          "text": "餐品外送订单"
        },
        {
          "role": "莎拉",
          "text": "欢迎光临猎鹿人…旅行者？你来得正好。"
        },
        {
          "role": "莎拉",
          "text": "抱歉啦，我知道你饿着肚子，但是能请你帮我个忙吗？"
        },
        {
          "role": "莎拉",
          "text": "清泉镇里的欧琳小姐订了一份<color=#00E1FFFF>蜜酱胡萝卜煎肉</color>，但是我听说，清泉镇最近总是有史莱姆出来捣乱…"
        },
        {
          "role": "莎拉",
          "text": "我自己不敢过去…能请你帮我把餐品送给<color=#00E1FFFF>清泉镇的欧琳</color>吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧，但是…",
              "dialogues": [
                {
                  "role": "莎拉",
                  "text": "等你回来的时候，会有一顿大餐做回报的！"
                },
                {
                  "role": "莎拉",
                  "text": "拜托了！"
                }
              ]
            },
            {
              "text": "太饿了，我只是来吃饭的。",
              "dialogues": [
                {
                  "role": "莎拉",
                  "text": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "运送餐品给活跃的欧琳"
        },
        {
          "type": "subtitle",
          "text": "运送餐品给活跃的欧琳"
        },
        {
          "type": "subtitle",
          "text": "击退捣乱的史莱姆"
        },
        {
          "type": "subtitle",
          "text": "把餐费交给餐馆莎拉"
        },
        {
          "role": "莎拉",
          "text": "交付餐费"
        },
        {
          "role": "莎拉",
          "text": "你回来了，餐品送到了吗？"
        },
        {
          "role": "旅行者",
          "text": "这是餐费。"
        },
        {
          "role": "莎拉",
          "text": "我看看…没错，太感谢了！"
        },
        {
          "role": "莎拉",
          "text": "还有，这份<color=#00E1FFFF>美味的蟹黄火腿焗时蔬</color>给你，刚刚做好的，赶紧趁热吃了吧。"
        }
      ]
    }
  ]
}