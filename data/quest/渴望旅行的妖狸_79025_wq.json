{
  "quest_id": 79025,
  "chapter_num": null,
  "chapter_title": "渴望旅行的妖狸",
  "type": "wq",
  "route": "Bake-Danuki Wanderlust",
  "stories": [
    {
      "story_id": 79025,
      "title": "渴望旅行的妖狸",
      "description": "布丁岛上似乎有妖狸在寻求帮助…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "咦？岛上怎么会有妖狸？"
        },
        {
          "role": "豆助",
          "text": "呜呶呶…柴助…"
        },
        {
          "role": "派蒙",
          "text": "欸？妖狸是不是说话了？"
        },
        {
          "role": "豆助",
          "text": "咿！是黄毛人和…飞飞白毛？"
        },
        {
          "role": "派蒙",
          "text": "哇！怎么跟吉法师一样！我不是什么「飞飞白毛」，我叫「派蒙」啦！"
        },
        {
          "role": "豆助",
          "text": "「白毛拉」？白毛拉认识吉法师？白毛拉好强！"
        },
        {
          "role": "派蒙",
          "text": "不是「白毛拉」是「派——蒙——」。原来吉法师已经这么有名了吗？看来妖狸修行卓有成效呢！"
        },
        {
          "role": "豆助",
          "text": "「白——毛——」？"
        },
        {
          "role": "派蒙",
          "text": "唔…算了…等等！为什么突然能听懂妖狸的话了？"
        },
        {
          "role": "派蒙",
          "text": "五百藏说过，妖狸能听懂人类的语言，只是我们不懂妖狸的话。"
        },
        {
          "role": "派蒙",
          "text": "之前能听懂吉法师的话是因为吃了妖狸饭，而且妖狸饭的效力也没那么久…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "因为群岛的样子本来就很不寻常吧。",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "说的也是，感觉发生什么奇怪的事也不奇怪呢！"
        }
              ]
            },
            {
              "text": "什么？我只听到妖狸在「呶呶」啊。",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "我该不会是突然觉醒了什么奇异的能力吧？「狸语者派蒙」！…才不是啦！"
        }
              ]
            }      
            
            
          ]
        },

       
        {
          "role": "豆助",
          "text": "呜呶呶…柴助找不到…"
        },
        {
          "role": "派蒙",
          "text": "唔…我都糊涂了，意思是你是柴助，在找什么东西吗？"
        },
        {
          "role": "豆助",
          "text": "唔唔，白毛笨…"
        },
        {
          "role": "旅行者",
          "text": "是和叫「柴助」的同伴失散了吧？"
        },
        {
          "role": "豆助",
          "text": "呶！黄毛聪明！豆助谢谢！"
        },
        {
          "role": "派蒙",
          "text": "哼，这句我听懂了！它说它叫豆助！"
        },
        {
          "role": "旅行者",
          "text": "不愧是「白——毛——」。"
        },
        {
          "role": "派蒙",
          "text": "怎么连旅行者你也这样！"
        },
        {
          "role": "派蒙",
          "text": "话说回来，豆助是怎么到岛上来的呢？"
        },
        {
          "role": "豆助",
          "text": "看到没见过的船，和柴助在船上玩。"
        },
        {
          "role": "豆助",
          "text": "困了。醒了，有很多人！"
        },
        {
          "role": "豆助",
          "text": "拳头很多风。"
        },
        {
          "role": "豆助",
          "text": "人很大很冰。"
        },
        {
          "role": "旅行者",
          "text": "听起来像是愚人众呢。"
        },
        {
          "role": "豆助",
          "text": "…鱼人？"
        },
        {
          "role": "豆助",
          "text": "下了船，在洞穴等，鱼人走了。"
        },
        {
          "role": "豆助",
          "text": "柴助找回家的路，山哐哐！"
        },
        {
          "role": "派蒙",
          "text": "山哐哐？啊！难道是转换山体的时候…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，这可怎么办？柴助不见了该不会是我们的错吧？"
        },
        {
          "role": "旅行者",
          "text": "那就得负起责任帮豆助找到柴助了。"
        },
        {
          "role": "派蒙",
          "text": "嗯！可是该怎么找呢？对了！用元素视野看看有没有线索吧！"
        },
         {
          "type": "subtitle",
          "text": "开启元素视野"
        }, 
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "是带有风元素的叶子呢，说起带有风元素的叶子…"
        },
        {
          "role": "旅行者",
          "text": "是蒙德风格的山上的树叶吧…"
        },
        {
          "role": "派蒙",
          "text": "嗯，可是现在带有风元素的叶子到了稻妻风格的山上，柴助不见踪影，也就是说…"
        },
        {
          "role": "旅行者",
          "text": "柴助有可能在蒙德风格的山上。"
        },
        {
          "role": "派蒙",
          "text": "既然找到了线索，我们快回去找豆助吧！"
        },
         {
          "type": "subtitle",
          "text": "与柴助对话"
        },


       
        {
          "role": "豆助",
          "text": "呜…柴助…"
        },
        
        {
          "role": "派蒙",
          "text": "我们回来啦！"
        },
        {
          "role": "豆助",
          "text": "柴助？"
        },
        {
          "role": "派蒙",
          "text": "这个嘛…其实还没找到…"
        },
        {
          "role": "豆助",
          "text": "呜…"
        },
        {
          "role": "派蒙",
          "text": "哇！别那么沮丧嘛，虽说还没找到，但是我们已经掌握了线索！对吧，旅行者。"
        },
        {
          "role": "旅行者",
          "text": "对，只要再来一次山哐哐就好了。"
        },
        {
          "role": "豆助",
          "text": "山哐哐！"
        },
        {
          "role": "派蒙",
          "text": "唔…也不能让豆助独自留在这里，那就和我们一起过去吧！"
        },
        {
          "role": "豆助",
          "text": "呶！"
        },

        {
          "type": "subtitle",
          "text": "前往盆景处"
        },
        {
          "role": "柴助",
          "text": "黄毛砰砰…飞高高，学不会呶…"
        },
        {
          "role": "派蒙",
          "text": "学不会吗…确实，不过这也是进入风场的一种方法啦…"
        },
        {
          "role": "豆助",
          "text": "哇——不是紫色的堇瓜！"
        },
        {
          "role": "派蒙",
          "text": "这个叫「日落果」哦。说起来，同样是萃华木，在不同的地方也会结出不同的果子呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也许和土壤、气候有关吧。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "对啊，稻妻就经常打雷…"
        }
              ]
            },
            {
              "text": "也许和神的喜好有关吧。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "影也会喜欢吃堇瓜吗？很难想象呢…"
        }
              ]
            }       
          ]
        },
        {
          "role": "柴助",
          "text": "那边还有冒火草！白毛快来！"
        },
        {
          "role": "派蒙",
          "text": "冒火草…啊！说的是烈焰花吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "也有可能是着火的草史莱姆。",
            "说不定是火骗骗花。"
          ]
        },
        
        {
          "role": "派蒙",
          "text": "唔…的确有可能…我们过去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "将盆景右侧转换为优悠山石"
        },
        {
          "type": "subtitle",
          "text": "解救妖狸"
        },

        {
          "role": "豆助",
          "text": "山哐哐！…柴助？"
        },
        {
          "role": "派蒙",
          "text": "咦？这不是豆助吗？豆助怎么会在这里？"
        },
        {
          "role": "柴助",
          "text": "咿！白毛！走开！"
        },
        {
          "role": "派蒙",
          "text": "欸？难道这就是柴助？只看外观和豆助没什么分别…"
        },
        {
          "role": "旅行者",
          "text": "稻妻的妖狸都很难分辨…"
        },
        {
          "role": "派蒙",
          "text": "吉法师倒是很容易分辨呢！"
        },
        {
          "role": "柴助",
          "text": "吉法师？假的！"
        },
        {
          "role": "派蒙",
          "text": "我们当初可是带着吉法师四处修行过呢！五百藏对吉法师说「不能偏离狸道」的时候，我们当时就在旁边呢，哼哼。"
        },
        {
          "role": "柴助",
          "text": "五百藏？白毛骗！走开！"
        },
        {
          "role": "派蒙",
          "text": "唔…你就是柴助对吧？先别急着赶我们走嘛，是豆助让我们来找你的。"
        },
        {
          "role": "柴助",
          "text": "…豆助？真假？"
        },
        {
          "role": "派蒙",
          "text": "当然是真的啦，豆助还在等你呢，快跟我们一起回去吧！"
        },
        {
          "role": "柴助",
          "text": "哼，白毛，骗？"
        },
        {
          "role": "派蒙",
          "text": "啊！这家伙可真让人火大！要不是我们把它救出来，现在它都变狸汁啦！"
        },
        {
          "role": "派蒙",
          "text": "明明看起来和豆助没什么分别，可这孩子为什么就这么不懂事…"
        },
        {
          "role": "派蒙",
          "text": "呼——费了好一番力气，早知道就问豆助要点什么东西证明了。"
        },
        {
          "role": "柴助",
          "text": "抢？"
        },
        {
          "role": "派蒙",
          "text": "唔…柴助真是多疑。"
        },
        {
          "role": "旅行者",
          "text": "出门在外的确应该提高警惕。"
        },
        {
          "role": "派蒙",
          "text": "欸？我明明看起来这么友善！"
        },
        {
          "role": "派蒙",
          "text": "不过，稻妻的妖狸应该很擅长变化吧。既然如此，柴助刚才也可以变成蝴蝶之类的飞走嘛。"
        },
        {
          "role": "柴助",
          "text": "哼，白毛笨。妖狸变化不简单。"
        },
        {
          "role": "派蒙",
          "text": "咦？可是在稻妻能变木桶、灯台之类的妖狸在野外好像随处可见呢。"
        },
        {
          "role": "柴助",
          "text": "唔唔，不一样。"
        },
        {
          "role": "派蒙",
          "text": "怎么不一样呢？"
        },
        {
          "role": "柴助",
          "text": "唔…白毛多话！讲了，不懂。"
        },
        {
          "role": "柴助",
          "text": "想见豆助…"
        },
        {
          "role": "派蒙",
          "text": "看来柴助不愿意再多说了…我们还是快带它回去找豆助吧！"
        },
        
        {
          "type": "subtitle",
          "text": "与豆助汇合"
        },
        {
          "role": "派蒙",
          "text": "喂——豆助，我们把柴助带回来啦！"
        },
        {
          "role": "豆助",
          "text": "呶！柴助！"
        },
        {
          "role": "柴助",
          "text": "白毛没有骗！是豆助！耶！"
        },
        {
          "role": "派蒙",
          "text": "原来柴助到现在才肯相信我们没有骗它呢…"
        },
        {
          "role": "柴助",
          "text": "山上好玩！很多没见过的东西！不过没有堇瓜。"
        },
        {
          "role": "柴助",
          "text": "还有差点变狸汁，好险。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，多亏我和旅行者及时赶到。"
        },
        {
          "role": "柴助",
          "text": "哼。"
        },
        {
          "role": "豆助",
          "text": "呶！谢谢黄毛白毛！"
        },
        {
          "role": "柴助",
          "text": "豆助也去看看，毛毛草，噗——光秃秃！"
        },
        {
          "role": "豆助",
          "text": "哇！想看！"
        },
        {
          "role": "派蒙",
          "text": "毛毛草，是说蒲公英吗？"
        },
        {
          "role": "派蒙",
          "text": "欸？可是你们打算怎么回稻妻呢？愚人众的船…应该不能用来时同样的办法回去了吧？"
        },
        {
          "role": "豆助",
          "text": "…嗯？"
        },
        {
          "role": "派蒙",
          "text": "糟了，它们好像没想过这个问题。不过，旅行者，我们应该可以把它们带回稻妻吧？"
        },
        {
          "role": "旅行者",
          "text": "我们走的时候可以带它们一起回去。"
        },
        {
          "role": "柴助",
          "text": "等等再走？"
        },
        {
          "role": "派蒙",
          "text": "等等？"
        },
        {
          "role": "柴助",
          "text": "想和豆助去看毛毛草。"
        },
        {
          "role": "派蒙",
          "text": "嗯…那我们过段时间再来？"
        },
        {
          "role": "派蒙",
          "text": "虽然不知道它们在蒙德风格的海岛能体验到多少蒙德的风情…不过让两边的岛都变成蒙德风格，我们这也算是尽力了。"
        },
        {
          "role": "豆助",
          "text": "好耶！"
        },
        {
          "role": "柴助",
          "text": "嗯，白毛，懂事。"
        },
        {
          "role": "派蒙",
          "text": "总觉得被柴助夸懂事感觉怪怪的…不过，它们两个真的没问题吗？"
        },
        {
          "type": "subtitle",
          "text": "过了一段时间回来找豆助和柴助…"
        },
        {
          "role": "派蒙",
          "text": "喔！是豆助和柴助！"
        },
        {
          "role": "派蒙",
          "text": "看样子应该是在蒙德风格的山上玩得很开心呢！蒙德的风景和稻妻很不一样吧？"
        },
        {
          "role": "豆助",
          "text": "很多绿色！风很软，喜欢。"
        },
        {
          "role": "柴助",
          "text": "毛毛草，好玩！噗噗——"
        },
        {
          "role": "派蒙",
          "text": "对啊，如果说稻妻是电光似的紫色，那么蒙德…"
        },
        {
          "role": "旅行者",
          "text": "就是清风一般的绿色。"
        },
        {
          "role": "派蒙",
          "text": "欸嘿。"
        },
        {
          "role": "柴助",
          "text": "但是有不是紫色的堇瓜，看得到，拿不到。"
        },
        {
          "role": "派蒙",
          "text": "欸？那是什么？"
        },
        {
          "role": "柴助",
          "text": "白毛会飞，白毛拿得到？"
        },
        {
          "role": "豆助",
          "text": "豆助带路！来！"
        },
        {
          "role": "派蒙",
          "text": "它俩可真性急啊，我们快跟上它们吧。"
        },
        {
          "type": "subtitle",
          "text": "跟上豆助和柴助"
        },
       
        {
          "role": "豆助",
          "text": "看！不是紫色的堇瓜！想要，但是砰砰。"
        },
        {
          "role": "派蒙",
          "text": "原来是风的屏障啊！嘿嘿，我和旅行者在蒙德旅行的时候见过不少哦。"
        },
        {
          "role": "派蒙",
          "text": "说起来，为什么取走里面的东西以后屏障就会消失呢？"
        },
        {
          "role": "旅行者",
          "text": "毕竟想要守护的东西已经不在了…"
        },
        {
          "role": "派蒙",
          "text": "…这么说来有些伤感呢。"
        },
        {
          "role": "柴助",
          "text": "白毛会飞，白毛去拿？"
        },
        {
          "role": "派蒙",
          "text": "有道理…不对啦！不可以凡事都依靠别人呀，出门在外，应该学会自己想办法解决问题。"
        },
        {
          "role": "豆助",
          "text": "呜呶呶…"
        },
        {
          "role": "旅行者",
          "text": "看来这对于新手来说还是太难了。"
        },
        {
          "role": "派蒙",
          "text": "是这样吗？哼哼，那我和旅行者作为经验丰富的前辈，可要好好传授一下旅行的经验！"
        },
        {
          "role": "派蒙",
          "text": "这里正好有风琥珀呢，只要打破就会出现风场。请旅行者来示范一下吧！"
        },
        {
          "type": "subtitle",
          "text": "打破风琥珀"
        },
        {
          "type": "subtitle",
          "text": "与豆助和柴助对话"
        },
        {
          "role": "派蒙",
          "text": "啊！风场怎么这么快就消失了…虽然也不是没有别的办法…"
        },
        {
          "role": "柴助",
          "text": "白毛不怕！"
        },
        {
          "role": "派蒙",
          "text": "哇！柴助之前说妖狸变化不简单，还以为柴助不擅长变化呢。"
        },
        {
          "role": "豆助",
          "text": "柴助厉害，会变很多东西！但是害怕的话会不能变。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样！旅行者，那我们帮豆助和柴助拿到里面的日落果吧！"
        },
        
        {
          "role": "豆助",
          "text": "哐哐~"
        },
        {
          "role": "柴助",
          "text": "山哐哐~"
        },
       
        {
          "role": "派蒙",
          "text": "嘿嘿，果然是烈焰花。"
        },
        {
          "role": "豆助",
          "text": "冒火草好热。"
        },
        {
          "role": "派蒙",
          "text": "摘烈焰花也有小技巧呢！要安全地摘到烈焰花得先想办法把火熄灭。"
        },
        {
          "role": "派蒙",
          "text": "晴天需要用水或者冰把火浇灭，附近有水琥珀的话那就省事啦。如果是雨天，用风吹一吹让雨水打湿烈焰花也可以让火熄灭。"
        },
        {
          "role": "柴助",
          "text": "白毛懂好多，好强。"
        },
        {
          "role": "派蒙",
          "text": "那当然，我和旅行者一起旅行可是学到了不少呢。"
        },
        {
          "role": "柴助",
          "text": "风琥珀，水琥珀，一样？"
        },
        {
          "role": "派蒙",
          "text": "嗯…怎么说呢，长得倒是挺像的，只不过一个变出风场，一个变出雨水。"
        },
        {
          "role": "柴助",
          "text": "呶！"
        },
        {
          "role": "派蒙",
          "text": "哇！柴助变成水琥珀了！"
        },
        {
          "role": "旅行者",
          "text": "真希望派蒙也能想变就变…"
        },
        {
          "role": "派蒙",
          "text": "我怎么可能想变就变啦！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们来帮豆助和柴助摘烈焰花吧…"
        },
        {
          "role": "派蒙",
          "text": "…欸？天降史莱姆！"
        },
        {
          "role": "派蒙",
          "text": "火史莱姆会爆炸这点可比烈焰花危险多了。不过就像烈焰花一样，只要能让火焰熄灭就没问题啦。"
        },
        {
          "role": "柴助",
          "text": "呶！"
        },
        {
          "role": "派蒙",
          "text": "现在应该安全了，把烈焰花花蕊交给豆助和柴助吧！"
        },
        {
          "role": "柴助",
          "text": "谢谢！白毛好强，黄毛也好强。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，柴助也很厉害呢。"
        },
        {
          "role": "豆助",
          "text": "蒙德好玩，但是…"
        },
        {
          "role": "柴助",
          "text": "但是不够。"
        },
        {
          "role": "派蒙",
          "text": "意思是还想去其他地方玩吗？唔…旅行者，该怎么办呢？"
        },
        {
          "role": "旅行者",
          "text": "也许可以换成璃月风格的山体。"
        },
        {
          "role": "派蒙",
          "text": "对哦！豆助和柴助想看看璃月的景色吗？"
        },
        {
          "role": "豆助",
          "text": "璃月好玩？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "有被撞到就会痛不欲生的岩龙蜥。",
            "有吃了之后会喷火的绝云椒椒。"
          ]
        },
       
        {
          "role": "派蒙",
          "text": "喂！你这么说了还有谁会想去啊！"
        },
        {
          "role": "豆助",
          "text": "哇——好玩！"
        },
        {
          "role": "柴助",
          "text": "想去！"
        },
        {
          "role": "派蒙",
          "text": "欸？！"
        },
        {
          "role": "派蒙",
          "text": "唔…那就再来一次山哐哐吧！"
        },
        {
          "role": "豆助",
          "text": "柴助石，柴助石！ 噗噗——"
        },
        {
          "role": "豆助",
          "text": "堇瓜，白毛喜欢？"
        },
        {
          "role": "豆助",
          "text": "耶！再等等！"
        },
        {
          "role": "柴助",
          "text": "呶，再等等？"
        },
        {
          "role": "派蒙",
          "text": "和上次一样吗…"
        },
        {
          "type": "subtitle",
          "text": "过了一段时间回来找豆助和柴助…"
        },
        {
          "role": "派蒙",
          "text": "看豆助和柴助的样子，好像在璃月风格的山上也玩得很开心呢！"
        },
        {
          "role": "豆助",
          "text": "好玩！很红很黄！"
        },
        {
          "role": "柴助",
          "text": "石板板，很圆很平，很怪！"
        },
        {
          "role": "派蒙",
          "text": "欸？那是什么…"
        },
        {
          "role": "柴助",
          "text": "带白毛去看！"
        },
        {
          "role": "柴助",
          "text": "呶哈哈，蒙德！堇瓜砰砰！"
        },
        {
          "role": "派蒙",
          "text": "呼——它俩跑得可真够快的…"
        },
        {
          "role": "柴助",
          "text": "呶哈哈，白毛，不行。"
        },
        {
          "role": "派蒙",
          "text": "…总觉得柴助有点得寸进尺…"
        },
        {
          "role": "豆助",
          "text": "白毛看，怪板板！"
        },
        {
          "role": "派蒙",
          "text": "这个呀！这个是只要放上重物就能触发的机关！其实在稻妻偶尔也会碰到呢。"
        },
        {
          "role": "柴助",
          "text": "重物？"
        },
        {
          "role": "派蒙",
          "text": "唔…就是比较重的东西！比如——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text":  "比如派蒙。",
              "dialogues": [
                  {
          "role": "派蒙",
          "text": "我才没有那么重呢！"
        }
              ]
            },
            {
              "text": "比如荒星。",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "荒星确实很方便呢！"
        }
              ]
            }       
          ]
        },
       
       
        {
          "role": "豆助",
          "text": "呶…堇瓜？"
        },
        {
          "role": "派蒙",
          "text": "堇瓜也太轻了吧！"
        },
        {
          "role": "豆助",
          "text": "呶呜呜…水琥珀？"
        },
        {
          "role": "派蒙",
          "text": "唔…虽然没试过但是应该也不行吧…"
        },
        {
          "role": "柴助",
          "text": "呶！石头够重！"
        },
        {
          "role": "派蒙",
          "text": "柴助真的行动力很强呢！既然柴助都已经来帮忙了，旅行者，不如我们把这个机关解开吧！"
        },
        {
          "type": "subtitle",
          "text": "完成解谜"
        },
        {
          "type": "subtitle",
          "text": "与豆助和柴助对话"
        },



        {
          "role": "豆助",
          "text": "呶？"
        },
        {
          "role": "豆助",
          "text": "耶！箱子！"
        },
        {
          "role": "派蒙",
          "text": "耶！宝箱！"
        },
        {
          "role": "旅行者",
          "text": "幸好不是开启挑战。"
        },
        {
          "role": "派蒙",
          "text": "就算是挑战，有豆助和柴助帮忙，感觉也会很快乐呢！"
        },
        {
          "role": "豆助",
          "text": "呶！豆助来帮忙！"
        },
        {
          "role": "柴助",
          "text": "白毛不怕，柴助厉害。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，豆助和柴助都变可靠了呢！"
        },
        {
          "role": "旅行者",
          "text": "派蒙也要加油啊。"
        },
        {
          "role": "派蒙",
          "text": "我明明一直都很可靠的！"
        },
        {
          "type": "subtitle",
          "text": "远处似乎有什么动静…"
        },
        {
          "role": "柴助",
          "text": "那边有怪声，柴助去看！"
        },
        {
          "role": "豆助",
          "text": "呶！豆助也去！"
        },
        {
          "role": "派蒙",
          "text": "欸？什么怪声？我什么也没听到啊…啊！"
        },
        {
          "role": "派蒙",
          "text": "你们俩真的太性急啦！旅行者，我们快跟上它们吧。"
        },
          {
          "type": "subtitle",
          "text": "击败遗迹守卫"
        },
        {
          "type": "subtitle",
          "text": "与豆助和柴助对话"
        },
        {
          "role": "柴助",
          "text": "呶哈哈！"
        },
        {
          "role": "柴助",
          "text": "黄毛好强！哐哐！"
        },
        {
          "role": "豆助",
          "text": "好强！"
        },
        {
          "role": "派蒙",
          "text": "那当然！他可是大名鼎鼎的旅行者！"
        },
        {
          "role": "柴助",
          "text": "呶！大名鼎鼎！好强！"
        },
        {
          "role": "派蒙",
          "text": "说起来，刚才出现的风琥珀和水琥珀，是柴助和豆助想帮忙吗？"
        },
        {
          "role": "柴助",
          "text": "呶！"
        },
        {
          "role": "派蒙",
          "text": "欸？可是记得豆助之前说过，柴助如果害怕的话会不能变化…"
        },
        {
          "role": "柴助",
          "text": "害怕，但是白毛黄毛危险。"
        },
        {
          "role": "豆助",
          "text": "呶，柴助帮忙！"
        },
        {
          "role": "派蒙",
          "text": "呜呜…柴助…为了我们，居然…"
        },
        {
          "role": "柴助",
          "text": "呶哈哈，白毛脏兮兮！"
        },
        {
          "role": "旅行者",
          "text": "脏兮兮~"
        },
        {
          "role": "派蒙",
          "text": "唔！我这是感动！"
        },
        {
          "role": "柴助",
          "text": "呶哈哈！"
        },
        {
          "role": "派蒙",
          "text": "不过这下你们玩够了吧，现在想回稻妻了吗？"
        },
        {
          "role": "柴助",
          "text": "不想。"
        },
        {
          "role": "派蒙",
          "text": "欸？！"
        },
        {
          "role": "柴助",
          "text": "想去蒙德！璃月！"
        },
        {
          "role": "豆助",
          "text": "呶！不是岛和山的蒙德璃月。"
        },
        {
          "role": "派蒙",
          "text": "啊？难道是不想回稻妻了，想去真的蒙德和璃月吗？"
        },
        {
          "role": "豆助",
          "text": "白毛聪明！"
        },
        {
          "role": "派蒙",
          "text": "唔…这可怎么办…旅行者怎么想呢？"
        },
        {
          "role": "旅行者",
          "text": "回去的时候可以带它们走。"
        },
        {
          "role": "派蒙",
          "text": "果然还是先去蒙德比较好吧…那就去风起地吧！周遭地势比较平坦，离蒙德城也很近呢。"
        },
        {
          "role": "柴助",
          "text": "耶！蒙德！"
        },
        {
          "role": "派蒙",
          "text": "不过现在群岛的状况还不是很明朗呢！等问题全部解决之后我们再一起回去吧！"
        },
        {
          "role": "派蒙",
          "text": "豆助！柴助！我们现在可以去蒙德啦！"
        },
        {
          "role": "豆助",
          "text": "耶！蒙德！"
        },
        {
          "role": "柴助",
          "text": "呶！白毛黄毛好慢！"
        },
        {
          "role": "派蒙",
          "text": "那我们现在走吧！"
        },
         {
          "type": "subtitle",
          "text": "前往风起地"
        },
       
        {
          "role": "派蒙",
          "text": "这里就是蒙德了，怎么样？风景很不错吧！"
        },
        {
          "role": "豆助",
          "text": "呶！"
        },
        {
          "role": "柴助",
          "text": "呜呶呶！！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我和旅行者的旅途也是从蒙德开始的呢，不知不觉已经有了好多难忘的回忆…"
        },
        {
          "role": "柴助",
          "text": "呶！"
        },
        {
          "role": "派蒙",
          "text": "希望豆助和柴助也能像我和旅行者一样，在蒙德创造很多快乐的回忆…"
        },
        {
          "role": "豆助",
          "text": "呶呜呜…"
        },
        {
          "role": "派蒙",
          "text": "欸？难道…"
        },
        {
          "role": "派蒙",
          "text": "就像五百藏的妖狸饭失效之后的吉法师那样…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "它们又不能说话了…",
            "我们又听不懂它们说话了…"
          ]
        },
     
        {
          "role": "派蒙",
          "text": "感觉就像梦醒了一样呢…"
        },
        {
          "role": "旅行者",
          "text": "因为离开了群岛…"
        },
        {
          "role": "派蒙",
          "text": "不过看它们的样子，应该没问题吧…"
        },
        {
          "role": "柴助",
          "text": "呶哈哈！"
        },
        {
          "role": "派蒙",
          "text": "对啊，柴助已经是能够独当一面的妖狸了，一定没问题的！祝你们旅途愉快！"
        },
        {
          "type": "subtitle",
          "text": "一段时间后……"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，派蒙，你们见过两只妖狸吗？一只背着紫色包袱，一只背着黄色包袱…"
        },
        {
          "role": "派蒙",
          "text": "啊！一定是豆助和柴助！"
        },
        {
          "role": "凯瑟琳",
          "text": "看来你们的确知道它们，太好了。"
        },
        {
          "role": "派蒙",
          "text": "欸？难道它们出什么事了吗？"
        },
        {
          "role": "凯瑟琳",
          "text": "那倒不是。只是它们手舞足蹈地比划了一阵以后交给我这个…"
        },
        {
          "role": "凯瑟琳",
          "text": "听说之前你们和稻妻的妖狸去过猎鹿人，我猜这两只妖狸或许也是你们的朋友，它们大概是想让我转交给你们吧。"
        },
        {
          "role": "派蒙",
          "text": "哇！是豆助和柴助的礼物！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，看来它们的旅途有一个顺利的开始呢，不知道以后还有没有机会见到它们…"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，派蒙，你们见过两只妖狸吗？一只背着紫色包袱，一只背着黄色包袱…"
        },
        {
          "role": "派蒙",
          "text": "啊！一定是豆助和柴助！"
        },
        {
          "role": "凯瑟琳",
          "text": "看来你们的确知道它们，太好了。"
        },
        {
          "role": "派蒙",
          "text": "欸？难道它们出什么事了吗？"
        },
        {
          "role": "凯瑟琳",
          "text": "那倒不是。只是它们手舞足蹈地比划了一阵以后交给我这个…"
        },
        {
          "role": "凯瑟琳",
          "text": "看它们比划的样子，我猜这两只妖狸或许是你们的朋友，它们大概是想让我转交给你们吧。"
        },
        {
          "role": "派蒙",
          "text": "哇！是豆助和柴助的礼物！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，看来它们的旅途有一个顺利的开始呢，不知道以后还有没有机会见到它们…"
        }
      ]
    }
  ]
