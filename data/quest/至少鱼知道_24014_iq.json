  "stories": [
    {
      "story_id": 24014,
      "title": "至少鱼知道",
      "description": "女记者莉诺蕾娅似乎正在因为某事而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与莉诺蕾娅对话"
        },
        {
          "role": "莉诺蕾娅",
          "text": "…这里的鱼群又减少了，难道机关鱼又开始活跃了吗？"
        },
        {
          "role": "莉诺蕾娅",
          "text": "必须把鱼苗投入更深的水域才行，但潜水服怎么这个时候坏掉了…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么呢？"
        },
        {
          "role": "莉诺蕾娅",
          "text": "你好，初次见面，我叫莉诺蕾娅，是一名专职于报道环境问题的记者，正在这里…投放鱼苗。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "记者？",
              "dialogues": [
                {
                  "role": "莉诺蕾娅",
                  "text": "是的。就是你所理解的那种记者。但我和那些专注于公众人物花边新闻，或者是不断重复无聊消息的记者不同。"
                },
                {
                  "role": "莉诺蕾娅",
                  "text": "我所关注的问题，是一件枫丹廷内正在发生，危害着公众生活安全的严肃公共事件。"
                },
                {
                  "role": "莉诺蕾娅",
                  "text": "而这件事，也是我来这里投放鱼苗的原因。"
                }
              ]
            },
            {
              "text": "为什么要投放鱼苗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莉诺蕾娅",
          "text": "…您知道有关「机关鱼」的事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没听说过…",
              "dialogues": []
            },
            {
              "text": "这是枫丹廷特有的鱼类吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "我去深水区。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "那就拜托你了。看这潜水服的状态，我暂时没法帮忙…只能看你的了。"
        },
        {
          "role": "旅行者",
          "text": "我去浅水区。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "那就拜托你了。看这潜水服的状态，我暂时没法帮忙…只能看你的了。"
        },
        {
          "type": "subtitle",
          "text": "前往深水区投放鱼苗"
        },
        {
          "role": "莉诺蕾娅",
          "text": "…这里的鱼群又减少了，难道机关鱼又开始活跃了吗？"
        },
        {
          "role": "莉诺蕾娅",
          "text": "必须把鱼苗投入更深的水域才行，但潜水服怎么这个时候坏掉了…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么呢？"
        },
        {
          "role": "莉诺蕾娅",
          "text": "你好，初次见面，我叫莉诺蕾娅，是一名专职于报道环境问题的记者，正在这里…投放鱼苗。"
        },
        {
          "role": "派蒙",
          "text": "欸？我们上次见到瑟米安的时候，莉诺蕾娅小姐是不是就在旁边呀？"
        },
        {
          "role": "旅行者",
          "text": "你应该是瑟米安的…"
        },
        {
          "role": "莉诺蕾娅",
          "text": "你们认识瑟米安？难道…上次就是你们帮瑟米安拿来了那些礼物？真是太感谢你们了。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "上次看完歌剧回家之后，瑟米安才告诉我这件事，我还一直想请你们来家里吃饭呢。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "没想到会在这里遇见你们，但…现在的时机可真不巧…"
        },
        {
          "role": "派蒙",
          "text": "你刚才说，正在这里投放鱼苗？"
        },
        {
          "role": "旅行者",
          "text": "为什么要投放鱼苗？"
        },
        {
          "role": "莉诺蕾娅",
          "text": "…您知道有关「机关鱼」的事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没听说过…",
              "dialogues": []
            },
            {
              "text": "这是枫丹廷特有的鱼类吗？",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往浅水区投放鱼苗"
        },
        {
          "type": "subtitle",
          "text": "前往浅水区投放鱼苗"
        },
        {
          "role": "莉诺蕾娅",
          "text": "你帮我把鱼苗投入水里了吗？看这潜水服的状态，我暂时没法帮忙…只能看你的了。"
        },
        {
          "type": "subtitle",
          "text": "前往浅水区投放鱼苗"
        },
        {
          "type": "subtitle",
          "text": "向莉诺蕾娅回报"
        },
        {
          "role": "莉诺蕾娅",
          "text": "你帮我把鱼苗投入水里了吗？"
        },
        {
          "role": "旅行者",
          "text": "投放好了。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "太感谢您了。等我修好潜水服之后，就会回去继续工作。"
        },
        {
          "role": "旅行者",
          "text": "希望那些鱼能好好长大。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "放心吧。针对每一片水域不同的生态环境，我们准备了许多不同种类的鱼苗。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "刚才你投下去的那一批鱼苗，就是专门针对这片水域的情况专门选出来的。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "我等一下会再投放几个批次的鱼苗，然后，我们雇佣的冒险家就会过来，扫除这片区域里的「机关鱼」。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "我相信这批鱼苗，一定能好好长大，让这片水域的生态环境重新恢复。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "等到有足够多的水域生态得到恢复。我就会写一份长篇报道。让大众知道「枫丹科学院」究竟对自然环境做了什么。"
        },
        {
          "role": "莉诺蕾娅",
          "text": "等着吧，达梅婕。这次你一定不会再有机会搪塞我了！"
        }
      ]
    }
