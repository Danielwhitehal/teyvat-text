{
  "quest_id": 10223,
  "chapter_num": "三川游艺绮梦谭·终夜",
  "chapter_title": "如伴雷电",
  "type": "eq",
  "route": "As Though Surrounded by Thunder",
  "stories": [
    {
      "story_id": 40192,
      "title": "如伴雷电",
      "description": "「二重身」与「噩梦」的真相俱已水落石出。往日因果纷至沓来，今日种种亦真亦幻。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至次日13-15点"
        },
        {
          "type": "subtitle",
          "text": "额外对话（井上）"
        },
        {
          "role": "井上",
          "text": "终于不用再做这些奇奇怪怪的创意料理了…不知道为什么还挺不舍的…"
        },
        {
          "role": "井上",
          "text": "咳，要是不嫌弃的话，等到您和将军大人得胜归来，请再来吃一回「团子牛奶」吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（末须久）"
        },
        {
          "role": "末须久",
          "text": "听说是有噩梦捣乱，来玩的人才变少了？真是可恶！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（毅）"
        },
        {
          "role": "毅",
          "text": "情况我们已经听说，身为「奥诘众」一员，却只能看着您和将军大人迎敌，实在惭愧…"
        },
        {
          "role": "毅",
          "text": "我们会全力为两位祈祷——另外，如果要来碗狐狸拉面补充体力，还请尽管吩咐！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（仁美）"
        },
        {
          "role": "仁美",
          "text": "宫司大人已经吩咐我们去做好仪式的准备了。冲破黑暗的阴霾，后面就是光明的未来！"
        },
        {
          "role": "仁美",
          "text": "「试胆大会」的优胜者、「三川花祭」的代表与代表的代表…这一次也一定要拿下优胜呀。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（加目无）"
        },
        {
          "role": "加目无",
          "text": "赶跑了噩梦，「三川花祭」就会更热闹了吧！那老身也去要一份祷词吁~"
        },
        {
          "type": "subtitle",
          "text": "额外对话（矢田幸喜）"
        },
        {
          "role": "矢田幸喜",
          "text": "好，让天领奉行众都打起十二成的精神！这一次可不能再让九条裟罗大人失望了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（渡边）"
        },
        {
          "role": "渡边",
          "text": "这一回不用我敦促，新人们就自己鼓足干劲了，干脆就这么一鼓作气，把后面的训练也安排下来…"
        },
        {
          "role": "派蒙",
          "text": "终于到这天了！「三川花祭」会一切顺利吗？还有「游艺」的完成进度也很让人在意…快去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "与神子等人对话"
        },
        {
          "role": "神里绫人",
          "text": "…宫司大人交代的要点都已经刊印成册了。还有仪式上念诵的咒文，也一并分发了下去。"
        },
        {
          "role": "八重神子",
          "text": "办事效率挺高嘛，那天领奉行这边呢？"
        },
        {
          "role": "九条裟罗",
          "text": "天领奉行的布防也针对「噩梦残片」做了调整。没了「二重身」的顾虑之后，各种行动的效率都高了不少。"
        },
        {
          "role": "派蒙",
          "text": "啊，你们都在这了啊？"
        },
        {
          "role": "鹿野院平藏",
          "text": "哦，「代表」也到场了，那这下会场的防务工作应该是万无一失了？"
        },
        {
          "role": "九条裟罗",
          "text": "即便如此，也不能掉以轻心。我们各司其职，才能让将军大人和旅行者全力施为。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，有你们在可真让人放心！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说起来绫华呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫人",
          "text": "呵呵…「三川花祭」的准备工作已经告一段落，其他事务有我们足够，所以我就让她去更需要她的地方了。"
        },
        {
          "role": "派蒙",
          "text": "更需要她的地方？"
        },
        {
          "role": "神里绫人",
          "text": "眼下人手紧缺的，反而是负责完成游艺的那几组。除了绫华，也有别的生力军加入。"
        },
        {
          "role": "八重神子",
          "text": "你们在会场里到处转转，应该就能遇上了？哦，别忘了晚上还要评选「最佳游艺」呢。"
        },
        {
          "role": "八重神子",
          "text": "代表，记得多到处玩玩。毕竟这里的「喜乐」越盛，计划就能进行得越顺利。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不说都差点忘了这回事…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "之后…等你体会得差不多了，就去见见她吧。"
        },
        {
          "type": "subtitle",
          "text": "与各组选手对话（可选）"
        },
        {
          "role": "神里绫华",
          "text": "…这个谜题会不会有些难以理解？如果这样稍作调整…应该会更好传达？"
        },
        {
          "role": "早柚",
          "text": "真…真的欸…之前都没注意到…"
        },
        {
          "role": "宵宫",
          "text": "不愧是绫华！我就知道拉你进来准没错！"
        },
        {
          "role": "神里绫华",
          "text": "也是因为你们之前的框架就搭得很好，我才能马上上手…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫华",
          "text": "啊…旅行者！你什么时候到的…"
        },
        {
          "role": "派蒙",
          "text": "就在刚刚！嘿嘿，你融入得很快嘛？是不是心里其实早就想来做游艺了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "记得前天你也说过想要做游艺…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫华",
          "text": "你…还记得呀。兄长说他们那边的工作已经不成问题。所以我就冒昧问了宵宫，还缺不缺人手…"
        },
        {
          "role": "神里绫华",
          "text": "还好，没有给你们添太多麻烦。"
        },
        {
          "role": "宵宫",
          "text": "怎么会是麻烦呢？我们正在「卡关」呢，还好你来了！"
        },
        {
          "role": "「吉法师」",
          "text": "…「卡关」…是做不出「关卡」的意思呶？"
        },
        {
          "role": "早柚",
          "text": "应该不是这意思…不过算了，能做出来就好。"
        },
        {
          "role": "神里绫华",
          "text": "旅行者，听宫司大人说，对付「噩梦残片」凶险异常，寻常人等只能在外支援…"
        },
        {
          "role": "神里绫华",
          "text": "我们会全力为你「祈祷」…你也一定要小心啊。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（宵宫&早柚&神里绫华）"
        },
        {
          "role": "宵宫",
          "text": "好嘞，旅行者已经揽下最难的活了，我们也要拿出干劲来！"
        },
        {
          "role": "神里绫华",
          "text": "嗯，早柚，你昨晚睡得怎么样？还需要休息吗？"
        },
        {
          "role": "早柚",
          "text": "唔唔…就、就这一次的话，就算拿出干劲…应该也不影响长高！"
        },
        {
          "role": "「吉法师」",
          "text": "大貉妖…加油呶！"
        },
        {
          "role": "荒泷一斗",
          "text": "啊哈哈——托马兄弟！事情我们都已经听说了！「荒泷极上无双游艺制作组」，特来助阵！"
        },
        {
          "role": "阿守&阿晃&元太",
          "text": "——还得是我们荒泷派！"
        },
        {
          "role": "久岐忍",
          "text": "…那边那几个胡闹的家伙先不管，「游艺设计师」的资格证，我姑且还是有的。"
        },
        {
          "role": "托马",
          "text": "各位…实在惭愧，我一心做自己的游艺…居然没能发现身边的金阁银阁…"
        },
        {
          "role": "「证城」",
          "text": "不怪托马老大呶！妖狸厉害，证城也没闻出来呶！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是啊，我们当时也没察觉到。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "托马",
          "text": "旅行者…派蒙…"
        },
        {
          "role": "荒泷一斗",
          "text": "不要在意不要在意！如果真的在意得不得了…那就好好完成独眼小僧他们的「遗愿」，做好你的游艺。"
        },
        {
          "role": "久岐忍",
          "text": "老大…虽然你抄来的这句台词很帅，但「遗愿」真不是这么用的。"
        },
        {
          "role": "荒泷一斗",
          "text": "欸——不就是遗留下来的愿望吗？元太，你是从哪抄的——"
        },
        {
          "role": "「证城」",
          "text": "长角鬼，好笨…能做游艺呶？"
        },
        {
          "role": "托马",
          "text": "呵…好的，他们的「意志」，我会继承下来的。"
        },
        {
          "role": "派蒙",
          "text": "说起来…真正的独眼小僧他们在哪？还有铁之助他们呢？"
        },
        {
          "role": "托马",
          "text": "独眼小僧他们昏迷后，被铁之助藏在了自己的家园里保护着…尽管被噩梦残片影响，但妖狸的本性依旧善良。"
        },
        {
          "role": "托马",
          "text": "至于铁之助他们…好像是作为引起恐慌的惩罚，被抓去布置仪式了，说是也要让他们好好体会下「熬夜加班」…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一听就是神子干的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "托马",
          "text": "呵呵，等你解决了问题的根源，我打算再把所有人都召集起来，独眼小僧、狐妖、河童…"
        },
        {
          "role": "托马",
          "text": "还有金阁、银阁、铁之助…一起来一场酣畅淋漓的「秋津羽球」吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（托马&荒泷一斗&久岐忍）"
        },
        {
          "role": "荒泷一斗",
          "text": "嗯…关底最后的「砰砰大魔王」…果然还是得用我的形象吧？你看这两只角，多气派！"
        },
        {
          "role": "阿守&阿晃&元太",
          "text": "——老大英明！"
        },
        {
          "role": "派蒙",
          "text": "呃…我怎么感觉这群人起到的作用，跟金阁银阁铁之助没啥区别…"
        },
        {
          "role": "久岐忍",
          "text": "托马先生，如果你有什么碍于情面不好开口的事情。尽管跟我说，我会把他们「处理」掉。"
        },
        {
          "role": "「证城」",
          "text": "没角的鬼…还是那么可怕呶…"
        },
        {
          "role": "托马",
          "text": "哈哈，没事，只要一斗兄弟不介意「砰砰大魔王」最后会被羽球打坏打败就好。"
        },
        {
          "role": "幸德",
          "text": "啊，是队长！剑鱼二番队，全体行礼！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好久没见了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "五郎",
          "text": "是啊，一开始我想请他们出动的时候，还有些不情愿。但一听说是你出任代表，就来得比剑鱼还快了。"
        },
        {
          "role": "幸德",
          "text": "…说实在的，海祇岛内还是有一些人，并不在乎鸣神岛的祭典和安危。"
        },
        {
          "role": "嘉久",
          "text": "…但如果事关剑鱼二番队队长，我想大家都会愿意来的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说得我都有点不好意思了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珊瑚宫心海",
          "text": "请坦然接受他们的好意吧，旅行者。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "即使是现人神巫女，也无法只凭一句空洞的口号，就让海祇岛与鸣神岛完全放下过往。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "这需要漫长的时间，频繁的交流…以及最重要的，具体的「人」。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "由你代表的祭典，由瑞希开启的合作…都会成为海祇岛人，迈向外界的桥梁。"
        },
        {
          "role": "梦见月瑞希",
          "text": "原来你还有这层心思…虽然年纪差了不少，但论成熟，已经不输另一位「巫女」了。"
        },
        {
          "role": "派蒙",
          "text": "啊，瑞希！呃…你睡得还好吗？"
        },
        {
          "role": "梦见月瑞希",
          "text": "没问题哦，精神在超过极限之后，有时候反而会爆发出强大的潜力…就像我开导过的那些病患。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白你的意思了…",
              "dialogues": []
            },
            {
              "text": "回头好好睡一觉吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梦见月瑞希",
          "text": "不过还好，仪式最后也赶上了。这下不管是「三川花祭」，还是我们的「游艺」，都能顺利落地了。"
        },
        {
          "role": "梦见月瑞希",
          "text": "旅行者，「噩梦残片」现身后，我们就会启动仪式，但生效需要一段时间。"
        },
        {
          "role": "梦见月瑞希",
          "text": "那时能拖住它的，就只有你和将军大人了…你还记得，昨晚去秋沙钱汤之前，我说过的话吗？"
        },
        {
          "role": "梦见月瑞希",
          "text": "不管是人类、妖怪，还是神明，都有着情感丰富的心灵，自然有可能患上同样的心病。"
        },
        {
          "role": "梦见月瑞希",
          "text": "有些生灵看着坚强，其实只是习惯了与自己的心病共存…但那远远谈不上「无恙」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还记得。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梦见月瑞希",
          "text": "嗯，我相信有你在的话，将军她…就不必再独自承受了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（珊瑚宫心海&梦见月瑞希&五郎）"
        },
        {
          "role": "五郎",
          "text": "说起来，社奉行发下来的「小纸条」要怎么念啊？"
        },
        {
          "role": "梦见月瑞希",
          "text": "啊，那是神子写的，她从前就喜欢这种拗口的东西呢…要不你去问问她？"
        },
        {
          "role": "五郎",
          "text": "我…我还是问问别人吧！"
        },
        {
          "role": "「刑部小判」",
          "text": "大狗狗，在害怕呶？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "我来看看吧…「天尊雷祇，今我奏命」…"
        },
        {
          "type": "subtitle",
          "text": "与影对话"
        },
        {
          "role": "影",
          "text": "…你来了吗？入战之前，需抚平自己的心境。如果还有什么琐事，就先去做完吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有了。",
              "dialogues": [
                {
                  "role": "影",
                  "text": "嗯，那便随我入定吧。"
                }
              ]
            },
            {
              "text": "我一会来。",
              "dialogues": [
                {
                  "role": "影",
                  "text": "好…替我多看看。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "随影备战"
        },
        {
          "role": "影",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…心静不下来吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "影",
          "text": "…自从离开「一心净土」之后，似乎就经常遇上这样的时刻啊。不管是在稻妻市井，还是神樱树前…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "算起来我都有干系…抱歉。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "影",
          "text": "不，这或许并非坏事。身在「一心净土」，两眼不见因果，却不代表过往的因果俱已消散。"
        },
        {
          "role": "影",
          "text": "它们总会在未来的某一天卷土重来，即使是神明也无法斩断。"
        },
        {
          "role": "影",
          "text": "所以一昧不见、不听、不言…是无法抵达真正的「心净」的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "影",
          "text": "旅行者，这一次我不会斩出「梦想一刀」，只能从旁为你掠阵。"
        },
        {
          "role": "影",
          "text": "以梦换梦，以幻变幻，以美梦覆盖噩梦…此计是否能成，惟系于你了。"
        },
        {
          "role": "旅行者",
          "text": "（计划定得仓促，敌情多是猜测，计划或许赶不上变化…但是，至少有一件事可以确信。）"
        },
        {
          "role": "旅行者",
          "text": "…这一次，你不必再自己承受那一刀了。"
        },
        {
          "role": "早柚",
          "text": "做…做完了…？"
        },
        {
          "role": "五郎",
          "text": "居然真的赶上了…"
        },
        {
          "role": "托马",
          "text": "完成…"
        },
        {
          "role": "荒泷一斗",
          "text": "完成啦——啊哈哈哈！不愧是我们！"
        },
        {
          "role": "阿守&阿晃&元太",
          "text": "——还得是我们荒泷派！"
        },
        {
          "role": "「噩梦残片」",
          "text": "嗬——！"
        },
        {
          "role": "荒泷一斗",
          "text": "…什…什么鬼东西？"
        },
        {
          "role": "「噩梦残片」",
          "text": "…嗬…"
        },
        {
          "role": "九条裟罗",
          "text": "切莫惊慌！所有人，照预案行事！"
        },
        {
          "role": "影",
          "text": "旅行者，做好准备。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "早就准备好了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "影",
          "text": "好，随我出阵——"
        },
        {
          "type": "subtitle",
          "text": "击败「噩梦残片」"
        },
        {
          "role": "影",
          "text": "竟会有在「一心净土」与你并肩作战的一天…因果真是不可思议。"
        },
        {
          "role": "「噩梦残片」",
          "text": "——嗬！"
        },
        {
          "role": "影",
          "text": "旅行者，注意招架！"
        },
        {
          "role": "众人的祈祷",
          "text": "天尊雷祇，今我奏命。"
        },
        {
          "type": "subtitle",
          "text": "如雷的祈祷声中，敌人已露破綻！",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "敌人攻势凶猛，注意躲避",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "众人的祈祷",
          "text": "虚空作幻，蔽人真心。"
        },
        {
          "type": "subtitle",
          "text": "如雷的祈祷声中，敌人已现身形！",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "众人的祈祷",
          "text": "诚惶诚恐，愿请威灵。"
        },
        {
          "type": "subtitle",
          "text": "如雷的祈祷声中，敌人已显败相！",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "敌人进入守势，待影出手",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "影",
          "text": "——许你神威。"
        },
        {
          "type": "subtitle",
          "text": "已得神威襄助，施展破幻！",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "影",
          "text": "——凶将护佑。"
        },
        {
          "role": "影",
          "text": "破邪显正！"
        },
        {
          "role": "影",
          "text": "祛妄返真！"
        },
        {
          "role": "影",
          "text": "敌势已溃，乘胜追击！"
        },
        {
          "type": "subtitle",
          "text": "旅行者被打至残血时"
        },
        {
          "role": "八重神子",
          "text": "小家伙，这么不小心？还怎么守护「我的神明」？"
        },
        {
          "type": "subtitle",
          "text": "击败'''「噩梦残片」'''",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "以梦变幻"
        },
        {
          "role": "「噩梦残片」",
          "text": "——嗬——"
        },
        {
          "role": "梦见月瑞希",
          "text": "天尊雷祇，今我奏命。"
        },
        {
          "role": "「金阁」&「银阁」&「铁之助」",
          "text": "虚空作幻，蔽人真心！"
        },
        {
          "role": "八重神子",
          "text": "诚惶诚恐，愿请威灵——"
        },
        {
          "type": "subtitle",
          "text": "剧情PV（[https://www.bilibili.com/video/BV1ZgwoeJEph 「浮梦之诉」）]"
        },
        {
          "role": "幕府军",
          "text": "…醒醒！快醒醒！"
        },
        {
          "role": "幕府军",
          "text": "…御輿大人！御輿大人！"
        },
        {
          "role": "幕府军",
          "text": "您没事吧！"
        },
        {
          "role": "御舆千代",
          "text": "不…不要…"
        },
        {
          "role": "御舆长正",
          "text": "母亲！"
        },
        {
          "role": "御舆千代",
          "text": "为什么…连你们也被…"
        },
        {
          "role": "影",
          "text": "…全力救治！不计代价！"
        },
        {
          "role": "食梦貘族人",
          "text": "这般噩梦…我等也无能为力啊！"
        },
        {
          "role": "御舆千代",
          "text": "不…"
        },
        {
          "role": "御舆千代",
          "text": "…不！"
        },
        {
          "role": "御舆千代",
          "text": "…必须…救出…你们…！"
        },
        {
          "role": "御舆千代",
          "text": "…我好像…做了一个很长的噩梦啊…"
        },
        {
          "role": "影",
          "text": "安心去睡吧"
        },
        {
          "role": "影",
          "text": "这一次…一定会是个好梦"
        },
        {
          "role": "旅行者",
          "text": "影——！"
        },
        {
          "type": "subtitle",
          "text": "与神子等人对话"
        },
        {
          "type": "subtitle",
          "text": "日落西山，「游艺制作」告一段落，「三川花祭」正式开幕…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "八重神子",
          "text": "…想必这三天里，各位都经历了许多难忘的事，或是不安，或是疲倦…"
        },
        {
          "role": "八重神子",
          "text": "但在今夜，希望大家都能忘记往事，尽情享受最纯粹的游艺，最简单的喜乐。"
        },
        {
          "role": "八重神子",
          "text": "不过在这之前…还得先请我们的代表，宣布「最佳游艺」的归属。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "获得「最佳游艺」的是…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "貉貉分身帮帮忙、「分身幻梦」！",
              "dialogues": [
                {
                  "role": "「吉法师」&宵宫",
                  "text": "好耶——"
                },
                {
                  "role": "早柚",
                  "text": "赢…赢了？我没在做梦吧…"
                },
                {
                  "role": "神里绫华",
                  "text": "没在做梦哦，早柚只要愿意拿出干劲，就总能做到最好呢。"
                }
              ]
            },
            {
              "text": "以球会友乐无穷、「秋津羽球」！",
              "dialogues": [
                {
                  "role": "「证城」&荒泷派",
                  "text": "好耶——"
                },
                {
                  "role": "托马",
                  "text": "不知道独眼小僧他们知道，会露出什么表情…"
                },
                {
                  "role": "久岐忍",
                  "text": "嘛，他们也露不出什么表情吧。"
                }
              ]
            },
            {
              "text": "众里寻貘千百度、「小狐狸的白日梦」！",
              "dialogues": [
                {
                  "role": "「刑部小判」&剑鱼二番队",
                  "text": "好耶——"
                },
                {
                  "role": "珊瑚宫心海",
                  "text": "那瑞希小姐，我们后续的合作…"
                },
                {
                  "role": "梦见月瑞希",
                  "text": "…呼…吃不下了…"
                },
                {
                  "role": "珊瑚宫心海",
                  "text": "…就等你从梦里回来再谈吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "获奖队伍将得到社奉行准备的奖金，以及这只「金狸狸奖杯」。"
        },
        {
          "role": "八重神子",
          "text": "——另外，还有一个临时设立的「特别奖项」，会由特邀嘉宾亲自颁布。"
        },
        {
          "role": "影",
          "text": "…我宣布，将「特别奖项」——「身临其境奖」…"
        },
        {
          "role": "影",
          "text": "授予制作出「恐怖游艺」、「二重身怪谈梦」的金阁、银阁及铁之助。"
        },
        {
          "role": "「金阁」&「银阁」&「铁之助」",
          "text": "——呶？！"
        },
        {
          "role": "浅利",
          "text": "居然是这么回事…我还以为撞见鬼了，原来是「恐怖游艺」啊！"
        },
        {
          "role": "高村",
          "text": "这么一说还真是「身临其境」…妖狸真厉害！"
        },
        {
          "role": "鹿野院平藏",
          "text": "这么一来…人们就不必害怕妖怪作祟了。"
        },
        {
          "role": "九条裟罗",
          "text": "但宫司和将军大人，还希望妖怪，也不再害怕人类。"
        },
        {
          "role": "影",
          "text": "我以鸣神之名，许以嘉奖——我在此允诺，人类绝不会无端打扰你们的安宁。"
        },
        {
          "role": "「银阁」",
          "text": "将军大…好人！"
        },
        {
          "role": "金阁&铁之助",
          "text": "将军大好人！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那幕府的开发计划…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "呵，幕府组织调查队，本就是为了避免冲突。"
        },
        {
          "role": "八重神子",
          "text": "何况天下这么大…总能容得下人类和妖怪的。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（影）"
        },
        {
          "role": "影",
          "text": "…纵使一度误会、疏远，甚至敌对，也能迎来共飨盛会之时。"
        },
        {
          "role": "影",
          "text": "看着人类、妖怪、金阁、银阁、铁之助他们…不由得让人如此感慨。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说来金阁还有神子他们去哪了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "影",
          "text": "他们已随瑞希下去检查了，「噩梦碎片」的消失对妖狸们是否会有影响，需得细细查过才能放心。"
        },
        {
          "role": "影",
          "text": "…还是说，此前你们所言，贸然斩除噩梦，会牵连妖狸身上的因果…只是在打诳语？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没、没有哦…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "影",
          "text": "…呵。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（宏达&平野）"
        },
        {
          "role": "宏达",
          "text": "从各国送来了不少贺信和礼物啊，这些也都要好好记录下来。"
        },
        {
          "role": "平野",
          "text": "蒙德城的蒲公英酒、璃月港的石珀…咦？这份礼物……好像指名要送给社奉行和天目锻冶屋…"
        },
        {
          "role": "宏达",
          "text": "看起来是一些没见过的锻造图谱啊…全是稻妻样式的，难不成是以前失传的？"
        },
        {
          "role": "平野",
          "text": "估计是教令院的历史学者们搜集整理的吧？这要还原出来还真不容易。我看看落款是…伐护末那学院？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卓也）"
        },
        {
          "role": "卓也",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卓也",
          "text": "…咳，没错，是我，之前犯案被捕的青鬼后裔。没想到会在这种情况下再见。"
        },
        {
          "role": "卓也",
          "text": "奉行所里来了个狐狸女人，说这里发生了跟鬼族相关的事件，让我来看看有没有戴罪立功的机会。"
        },
        {
          "role": "卓也",
          "text": "结果我都还没过来，事情就已经全解决了…反倒是人类跟妖怪的祭典办得红红火火…"
        },
        {
          "role": "卓也",
          "text": "…该不会那个女人，只是想让我亲眼见到，妖怪也好鬼族也好，都能跟人类好好相处了吧…"
        },
        {
          "role": "卓也",
          "text": "咳！总之，我这趟出来的事，还是请你保密，尤其是向那个赤鬼后人。"
        },
        {
          "role": "卓也",
          "text": "免得他又嚷着让我加入荒泷派…这种事还是等我刑期结束，好好做人…做鬼之后吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他自己也会进奉行所看你的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卓也",
          "text": "…这个还是请你们多看着他一点吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（荒谷）"
        },
        {
          "role": "荒谷",
          "text": "嗯，都得好好回信呀…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这些信件是…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒谷",
          "text": "啊，刚刚社奉行送来了一些指名送给八重堂的贺信，有白垩老师的贺图、枕玉老师的亲笔信…"
        },
        {
          "role": "荒谷",
          "text": "还有这一封：「荒谷阿姨好！宫司大人大姐姐好！希望八重堂的祭典能办好，请帮我跟宵宫姐姐问好！」"
        },
        {
          "role": "荒谷",
          "text": "呵呵，虽然忘了写名字，不过我大概能猜到，是哪位小小姐写的呢。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「刑部小判」&五郎&珊瑚宫心海）"
        },
        {
          "role": "「刑部小判」",
          "text": "——呶！下次，砰砰！嚓嚓…"
        },
        {
          "role": "五郎",
          "text": "奇怪…刑部小判他说的话…我怎么有些听不懂了？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "似乎是某种法术的效果快要结束了…不过我大概能猜到他想说什么。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "「——下一次，还要一起玩呀。」"
        },
        {
          "type": "subtitle",
          "text": "额外对话（幸雄）"
        },
        {
          "role": "幸雄",
          "text": "呼…社奉行的人说，这几天他们会代为打理我的摊子…居然还真打理得不错？干干净净，简直像是没动过！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（早柚&宵宫&神里绫华&「吉法师」）"
        },
        {
          "role": "早柚",
          "text": "奇怪…明明做完了游艺很开心，但总觉得好像忘了什么事情…好像是最初的目标什么的…"
        },
        {
          "role": "宵宫",
          "text": "唔…既然想不起来，那会不会，也不是什么重要的事？"
        },
        {
          "role": "神里绫华",
          "text": "那不如就先放一下，来享受「三川花祭」吧？这次的「游艺」都很让人身临其境呢。"
        },
        {
          "role": "「吉法师」",
          "text": "呶哈哈！——妖狸法术，噼咔噼咔！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（托马&狐妖&河童&独眼小僧&「证城」）"
        },
        {
          "role": "托马",
          "text": "…你们感觉怎么样？没留下什么后遗症吧？"
        },
        {
          "role": "狐妖",
          "text": "没事啦！那位食梦貘姐姐已经帮我们看过啦。"
        },
        {
          "role": "河童",
          "text": "「噩梦碎片」消失后不久，我们就醒过来了…感觉就像做了一场梦。"
        },
        {
          "role": "独眼小僧",
          "text": "抱歉，没能遵守约定，来帮托马老大做游艺…"
        },
        {
          "role": "托马",
          "text": "没事没事，况且现在也不晚 ——一块来试试「秋津羽球」，多提点意见吧？"
        },
        {
          "role": "「证城」",
          "text": "大家，一块砰砰！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿守&阿晃&元太）"
        },
        {
          "role": "阿守",
