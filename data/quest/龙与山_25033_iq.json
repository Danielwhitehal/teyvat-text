      "story_id": 25033,
      "title": "龙与山",
      "description": "在「回声之子」部族中，特拉忒正在为某事而发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与特拉忒对话"
        },
        {
          "role": "特拉忒",
          "text": "乖乖喔，今天吃饱了吗？有没有力气训练呀？"
        },
        {
          "role": "奇卡",
          "text": "呜，呜呜，呜！"
        },
        {
          "role": "特拉忒",
          "text": "呜哇，这么有活力？好！那今天可要加把劲了！"
        },
        {
          "role": "旅行者",
          "text": "一起加把劲吧！"
        },
        {
          "role": "特拉忒",
          "text": "欸？您好呀，大哥哥！我们正在进行爬山训练呢。"
        },
        {
          "role": "奇卡",
          "text": "呜呜！呜呜！"
        },
        {
          "role": "奇卡",
          "text": "呜呜，呜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "训练得怎么样？",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "那个…至少能说「有进步」吧。这次奇卡爬的比上次高多了。"
                },
                {
                  "role": "特拉忒",
                  "text": "就是在爬山的时候，奇卡的攀爬动作有些不熟练…"
                }
              ]
            },
            {
              "text": "看起来它恢复得不错。",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "当然啦。妈妈都说，我可擅长照料奇卡了。"
                },
                {
                  "role": "特拉忒",
                  "text": "奇卡的进步可大了，爬的高度也比上次高很多。"
                },
                {
                  "role": "特拉忒",
                  "text": "就是在爬山的时候，奇卡的动作有些不熟练…"
                }
              ]
            }
          ]
        },
        {
          "role": "特拉忒",
          "text": "大哥哥，你能再为我们示范一遍吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "谢谢你！这次我一定能看清大哥哥的动作。"
                },
                {
                  "role": "特拉忒",
                  "text": "奇卡，你也要睁大眼睛喔。"
                },
                {
                  "role": "奇卡",
                  "text": "呜！"
                }
              ]
            },
            {
              "text": "这次可要看清我的动作。",
              "dialogues": [
                {
                  "role": "特拉忒",
                  "text": "当然啦。我和奇卡都会睁大眼睛仔细看的，这次一定能看清！"
                }
              ]
            }
          ]
        },
        {
          "role": "特拉忒",
          "text": "那就拜托你啦，大哥哥。"
        },
        {
          "role": "特拉忒",
          "text": "我们会在地上看着大哥哥，算好时间的。"
        },
        {
          "role": "奇卡",
          "text": "呜，呜呜…"
        },
        {
          "role": "？？？",
