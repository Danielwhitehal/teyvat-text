{
  "quest_id": 22028,
  "chapter_num": null,
  "chapter_title": "神龛啊，再次显灵吧！",
  "type": "iq",
  "route": "O Shrine, Show Your Power Once Again!",
  "stories": [
    {
      "story_id": 22028,
      "title": "神龛啊，再次显灵吧！",
      "description": "翔太似乎得到了神明的回应，期待着神龛的再次显灵…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与翔太对话"
        },
        {
          "role": "翔太",
          "text": "大哥哥！你听我说！你听我说！"
        },
        {
          "role": "翔太",
          "text": "上次供奉了神龛以后，我的愿望真的实现了…一小部分！虽然只有一部分…但这肯定是神明的回应吧！"
        },
        {
          "role": "旅行者",
          "text": "你许的是什么愿望？"
        },
        {
          "role": "翔太",
          "text": "呃…我上次许的愿望是，希望神明让我看的那册漫画的作者再画快点，最好两天一更。"
        },
        {
          "role": "翔太",
          "text": "然后，那个作者真的在一期里更新了两倍的量！"
        },
        {
          "role": "翔太",
          "text": "不过…据说接下来就要连续休刊三期了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这实现愿望的方式还挺均衡…",
              "dialogues": []
            },
            {
              "text": "感觉反倒是少更了一期啊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "翔太",
          "text": "唔…不管怎么说，神明应该是已经听见我的愿望了。之所以没有完全实现，肯定是因为我还供奉得不够！"
        },
        {
          "role": "翔太",
          "text": "所以今天，我们就把其他地方的神龛也供奉了吧！这样神明大人肯定会完全实现我的愿望。"
        },
        {
          "role": "翔太",
          "text": "我问过爸爸和妈妈了，这附近还有两个神龛，一个在木漏茶室附近，一个在出城的路上。"
        },
        {
          "role": "翔太",
          "text": "大哥哥，你觉得我们先去哪个神龛比较好？"
        },
        {
          "role": "翔太",
          "text": "好，我们现在就出发吧！"
        },
        {
          "role": "旅行者",
          "text": "先去木漏茶室的神龛吧。"
        },
        {
          "role": "旅行者",
          "text": "先去城外的神龛吧。"
        },
        {
          "type": "subtitle",
          "text": "前往木漏茶室附近的神龛"
        },
        {
          "role": "旅行者",
          "text": "供奉金平糖吧。"
        },
        {
          "role": "翔太",
          "text": "好！那我们就这么做吧。"
        },
        {
          "role": "翔太",
          "text": "真希望这一次，神明也会回应我。"
        },
        {
          "role": "翔太",
          "text": "明天我就来看看，有没有什么特别的迹象！"
        },
        {
          "role": "翔太",
          "text": "对了，谢谢你陪我到现在，这些东西给你！"
        },
        {
          "role": "翔太",
          "text": "希望神明大人真的能回应我的愿望…"
        },
        {
          "type": "subtitle",
          "text": "帮助翔太供奉神龛"
        },
        {
          "role": "翔太",
          "text": "就是这里了。"
        },
        {
          "role": "翔太",
          "text": "我听人说，很久以前，有一位同心大叔向这个神龛供奉了许多纸鹤，许愿花见坂的大家都能平平安安。"
        },
        {
          "role": "翔太",
          "text": "后来这附近发生了一场火灾，有一栋屋子着了火，但那栋屋子本来就是偷工减料建的，一下子就被火烧完塌掉了，火势根本没来得及向外蔓延…"
        },
        {
          "role": "翔太",
          "text": "大家都觉得，这是神明大人在保佑呢…嘿嘿，所以我还专门折了纸鹤带过来。"
        },
        {
          "role": "翔太",
          "text": "先不说这些了！这一次，我们供奉什么比较好呢？"
        },
        {
          "role": "翔太",
          "text": "和同心大叔一样，供奉纸鹤的话，或许也能得到回应。"
        },
        {
          "role": "翔太",
          "text": "不过我觉得，这个神龛既然是在茶室附近，那供奉抹茶味的金平糖会不会更有诚意呢？"
        },
        {
          "role": "翔太",
          "text": "唔，而且我还挺喜欢吃抹茶味金平糖的…"
        },
        {
          "role": "翔太",
          "text": "大哥哥，你觉得呢？"
        },
        {
          "role": "旅行者",
          "text": "供奉纸鹤吧。"
        },
        {
          "role": "翔太",
          "text": "好！那我们就这么做吧。"
        },
        {
          "role": "翔太",
          "text": "真希望这一次，神明也会回应我。"
        },
        {
          "role": "翔太",
          "text": "明天我就来看看，有没有什么特别的迹象！"
        },
        {
          "role": "翔太",
          "text": "对了，谢谢你陪我到现在，这些东西给你！"
        },
        {
          "role": "翔太",
          "text": "希望神明大人真的能回应我的愿望…"
        },
        {
          "type": "subtitle",
          "text": "前往城外的神龛"
        },
        {
          "role": "旅行者",
          "text": "小凉菜吧。"
        },
        {
          "role": "翔太",
          "text": "好！那我们就这么做吧。"
        },
        {
          "role": "翔太",
          "text": "真希望这一次，神明也会回应我。"
        },
        {
          "role": "翔太",
          "text": "明天我就来看看，有没有什么特别的迹象！"
        },
        {
          "role": "翔太",
          "text": "对了，谢谢你陪我到现在，这些东西给你！"
        },
        {
          "role": "翔太",
          "text": "希望神明大人真的能回应我的愿望…"
        },
        {
          "type": "subtitle",
          "text": "帮助翔太供奉神龛"
        },
        {
          "role": "翔太",
          "text": "就是这里了。"
        },
        {
          "role": "翔太",
          "text": "很久以前，有一个大伯向这个神龛供奉了锻刀用的铁矿石，希望自己的武艺能够快快进步。"
        },
        {
          "role": "翔太",
          "text": "后来那个大伯去参加比武，他的对手全都被他轻松打败了，他也被人家称赞说武艺高超。"
        },
        {
          "role": "翔太",
          "text": "不过，大伯说，他的那些对手似乎都有些身体上的…不适…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这神明怎么这么没谱呢…",
              "dialogues": []
            },
            {
              "text": "其他人退步，自己就算进步了吗…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "翔太",
          "text": "不过无论如何，大家都觉得这也是神明显灵了。所以向这个神龛许愿，我觉得应该也能得到回应。"
        },
        {
          "role": "翔太",
          "text": "先不说这些了！这一次，我们供奉什么比较好呢？"
        },
        {
          "role": "翔太",
          "text": "和那个大伯一样，供奉铁矿石的话，或许也能得到回应！"
        },
        {
          "role": "翔太",
          "text": "我在铁匠铺门口捡到过几块矿石，不过，它们的品质都不太好，铁匠师傅觉得送给我都无所谓。"
        },
        {
          "role": "翔太",
          "text": "还有…我之前在这附近采了些新鲜海草，然后把它们煮一煮，撒上糖…这么吃起来味道可好了。"
        },
        {
          "role": "翔太",
          "text": "就是不知道，神明大人喜不喜欢吃这种小凉菜…"
        },
        {
          "role": "翔太",
          "text": "大哥哥，你觉得呢？"
        },
        {
          "role": "旅行者",
          "text": "铁矿石吧。"
        },
        {
          "role": "翔太",
          "text": "好！那我们就这么做吧。"
        },
        {
          "role": "翔太",
          "text": "真希望这一次，神明也会回应我。"
        },
        {
          "role": "翔太",
          "text": "明天我就来看看，有没有什么特别的迹象！"
        },
        {
          "role": "翔太",
          "text": "对了，谢谢你陪我到现在，这些东西给你！"
        },
        {
          "role": "翔太",
          "text": "希望神明大人真的能回应我的愿望…"
        }
      ]
    }
  ]
}