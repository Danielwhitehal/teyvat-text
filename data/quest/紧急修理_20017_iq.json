{
  "quest_id": 20017,
  "chapter_num": null,
  "chapter_title": "紧急修理",
  "type": "iq",
  "route": "Urgent Repairs",
  "stories": [
    {
      "story_id": 20017,
      "title": "紧急修理",
      "description": "法拉正准备运货去醉汉峡附近，向路过的商队兜售货物，但是货车却被丘丘人袭击，货物和他自己都陷入了危险的境地…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "消灭所有魔物"
        },
        {
          "role": "法拉",
          "text": "别，别打我！别…咦？旅行者，那些家伙呢？已经被你赶跑了吗？"
        },
        {
          "role": "法拉",
          "text": "太好了！太谢谢你了…他们真的都走了？"
        },
        {
          "role": "法拉",
          "text": "呼…多亏了你，不过这么一耽搁，我肯定赶不上这趟商队了。"
        },
        {
          "role": "法拉",
          "text": "而且，车也被这群家伙给打坏了，得赶紧修好运回城里去，不然水果非烂在车里不可。"
        },
        {
          "role": "法拉",
          "text": "你绝对不想知道，这么多水果在车里烂掉之后，车上那股子洗不掉的味道…"
        },
        {
          "role": "法拉",
          "text": "我要在这把这些水果都检查一遍，我已经能闻到有不少水果坏掉了。"
        },
        {
          "role": "法拉",
          "text": "拜托你去周围帮我找找修车的材料吧，我觉得…一块<color=#00E1FFFF>结实的木板</color>就够用了。"
        },
        {
          "type": "subtitle",
          "text": "和法拉对话"
        },
        {
          "role": "法拉",
          "text": "树林里头肯定有不少<color=#00E1FFFF>结实的木板</color>，拜托了！再等下去，所有的水果都要报销了！"
        },
        {
          "role": "旅行者",
          "text": "我明白了。"
        },
        {
          "role": "法拉",
          "text": "太好了，那我就在这等你。呃，到底是哪些水果坏掉了啊——"
        },
        {
          "role": "旅行者",
          "text": "还有别的急事。"
        },
        {
          "role": "法拉",
          "text": "等会！你闻闻这味道，再不把这些水果送走，非全部烂在车里不可，拜托你了，就帮帮我吧。"
        },
        {
          "type": "subtitle",
          "text": "收集木材"
        },
        {
          "type": "subtitle",
          "text": "将结实的木板交给法拉"
        },
        {
          "role": "法拉",
          "text": "太谢谢了，旅行者。"
        },
        {
          "role": "法拉",
          "text": "不过，看来那群家伙压根不想走，我要快点离开这才行。"
        },
        {
          "role": "法拉",
          "text": "刚才车又挨了几下，看来想要完全修好是不可能了。算了，我就拿绳子先应急…呃，绳子跑哪去了？"
        },
        {
          "role": "法拉",
          "text": "可恶，肯定是被那群怪物丢到不知道哪去了。旅行者，帮我去周围找找<color=#00E1FFFF>绳索</color>吧。"
        },
        {
          "role": "法拉",
          "text": "这些就够用了，我要先去洗洗手，再把车给修好…"
        },
        {
          "role": "法拉",
          "text": "咦？又…又来了，旅行者！那群家伙又来了！"
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物"
        },
        {
          "role": "法拉",
          "text": "绳索应该就在附近，拜托你帮我找找吧。"
        },
        {
          "type": "subtitle",
          "text": "和法拉对话"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "法拉",
          "text": "那么就拜托你了，这群怪物怎么什么都要…"
        },
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "法拉",
          "text": "等等，等等，要，要是那群家伙又过来，我只能用水果砸他们了——"
        },
        {
          "role": "法拉",
          "text": "拜托了，这个忙只有你能帮我了！"
        },
        {
          "type": "subtitle",
          "text": "收集绳索"
        },
        {
          "type": "subtitle",
          "text": "将绳索交给法拉"
        },
        {
          "role": "法拉",
          "text": "这样就可以了，总之先把车弄回城里去。"
        },
        {
          "role": "法拉",
          "text": "谢谢你，旅行者，我们下次再见。"
        },
        {
          "role": "法拉",
          "text": "唉，这车子上的味道，可怎么洗掉啊…"
        },
        {
          "type": "subtitle",
          "text": "前去查看详情"
        }
      ]
    }
  ]
}