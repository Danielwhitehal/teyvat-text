{
  "quest_id": 72674,
  "chapter_num": null,
  "chapter_title": "山海八所巡礼",
  "type": "wq",
  "route": "Eight Locales Over Mountains and Seas",
  "stories": [
    {
      "story_id": 72674,
      "title": "山海八所巡礼",
      "description": "已经有些时日没有见到镇守之森的五百藏。或许是时候去拜访一下被封印在石像中的妖狸大王了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往镇守之森，拜访五百藏"
        },
        {
          "role": "派蒙",
          "text": "五百藏，你好！"
        },
        {
          "role": "五百藏",
          "text": "咿！居然被识破了！你们究竟是…这个气味…"
        },
        {
          "role": "五百藏",
          "text": "原来是你们这些小辈啊。有些时日没见，气味我都认不得了。"
        },
        {
          "role": "派蒙",
          "text": "五百藏倒是完全没变，还是看到人就害怕，而且还困在石头里呢！"
        },
        {
          "role": "五百藏",
          "text": "呶？！你这小辈，这话是什么意思？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "希望你的封印早点解除。",
            "派蒙的意思是，希望封印早点解除。"
          ]
        },
        {
          "role": "五百藏",
          "text": "区区人类的封印罢了！只要吾辈努力…"
        },
        {
          "role": "旅行者",
          "text": "咳咳。"
        },
        {
          "role": "五百藏",
          "text": "……"
        },
        {
          "role": "五百藏",
          "text": "哼。不管怎么说，孩子们受了你不少照顾。小狸子们总说，有个闻起来很香的黄毛叔叔经常陪他们玩，可开心了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "黄毛…",
            "闻起来很香…",
            "不是叔叔，是哥哥。"
          ]
        },
        {
          "role": "五百藏",
          "text": "吾辈本来还以为，人类都跟把吾辈妖狸一族封印的家伙一样，又坏、又可怕。看来，还是有些好人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "大部分人都是好人。",
            "谢谢。"
          ]
        },
        {
          "role": "派蒙",
          "text": "对呀，我和旅行者遇到的人，大部分都是好人。五百藏被封印还不是因为把梳子偷走了…"
        },
        {
          "role": "五百藏",
          "text": "哼，现在梳子已经给你们了。如果你们遇到那个跟灵善坊学法术的家伙，跟他说一声，让他把吾辈从石头里弄出来。"
        },
        {
          "role": "五百藏",
          "text": "吾辈在这里坐了这么久，都怪那个臭狐狸…"
        },
        {
          "role": "派蒙",
          "text": "（五百藏抱怨起来好像老头子哦。）"
        },
        {
          "role": "旅行者",
          "text": "（年纪确实应该很大吧。）"
        },
        {
          "role": "五百藏",
          "text": "小辈，你们手也不是石头，脚也不是石头，一定去过不少地方吧…？"
        },
        {
          "role": "派蒙",
          "text": "哼哼，我和旅行者，可是从海对面来的！"
        },
        {
          "type": "subtitle",
          "text": "向五百藏讲了一些璃月与蒙德的事情。"
        },
        {
          "role": "五百藏",
          "text": "…原来外面有这么多地方哪。真是了不得。"
        },
        {
          "role": "五百藏",
          "text": "一直以来，都只有小狸子跟吾辈报告，所以根本不知道外面是什么样的。"
        },
        {
          "role": "五百藏",
          "text": "以前在影向山上，吾等看到北边的海对面，有一座好高好高的山，可能比影向山还高，还一直想知道，那是什么地方呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
             {
              "text": "那边的话…",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "从方位来看，应该是龙脊雪山吧！"
        }
              ]
            },
            {
              "text": "从方位来看，应该是龙脊雪山。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "五百藏",
          "text": "呜呶呶，雪山…听着就觉得肚皮冷。真不知道那个家伙怎么想去这样的地方…"
        },
        {
          "role": "五百藏",
          "text": "……"
        },
        {
          "role": "五百藏",
          "text": "咳咳。之前也说了，你们是好人，所以…"
        },
        {
          "role": "派蒙",
          "text": "是请人帮忙的语气耶。"
        },
        {
          "role": "五百藏",
          "text": "呶！吾辈好歹是得了大御所大人的令，守护镇守之森的隐神保生司正，如果不是被封在石头里，吾辈一定要用八叠大的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么需要帮忙的？",
              "dialogues": []
            },
            {
              "text": "这个嘛…",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "嗯嗯，旅行者的意思我懂！有什么宝藏吗？"
        },
        {
          "role": "五百藏",
          "text": "宝藏？那当然了，吾辈可是五百五妖狸的统领，稻妻的宝藏，什么没见过。"
        }
              ]
            }
          ]
        },
        {
          "role": "五百藏",
          "text": "虽然吾辈没办法自由行动，不过孩子们没问题。吾辈想要拜托小辈你们，带小狸子去外面「修行」。"
        },
        {
          "role": "五百藏",
          "text": "就带「吉法师」去吧。上次和你们一起玩以后，他就一直念叨着，想要再见到你们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "可以是可以…",
            "还有个问题…"
          ]
        },

        {
          "role": "派蒙",
          "text": "嗯，毕竟我们和吉法师语言不通，一同旅行的话，多少会遇到困难吧？"
        },
        {
          "role": "五百藏",
          "text": "怎么可能。吾等妖狸一族，自然是明白人类的语言的。只不过是你们人不明白一般妖狸说的话罢了。"
        },
        {
          "role": "派蒙",
          "text": "什么！居然还有这样的事情！"
        },
        {
          "role": "旅行者",
          "text": "不过作为旅伴…"
        },
        {
          "role": "旅行者",
          "text": "还是希望能一边旅行、一边聊天。"
        },
        {
          "role": "派蒙",
          "text": "就像派蒙和旅行者那样！"
        },
        {
          "role": "五百藏",
          "text": "呶，真拿你没办法。之前不是有谁用吾等妖狸一族的法术，给你们做了吃食吗？"
        },
        {
          "role": "五百藏",
          "text": "别看吾辈现在是这个模样，做出让你们能听懂吉法师说话的「饭」，也不成问题。"
        },
        {
          "role": "派蒙",
          "text": "好耶！是好吃的！"
        },
        {
          "role": "旅行者",
          "text": "也不算是好吃的…"
        },
        {
          "role": "五百藏",
          "text": "哼，可别小看吾辈的手艺。"
        },
        {
          "type": "subtitle",
          "text": "虽然很难形容五百藏是从哪变出来的…\\n总之，和派蒙一起吃了放在五百藏肚皮上的「看上去很美味」的大餐。"
        },
        {
          "role": "派蒙",
          "text": "真好吃！"
        },
        {
          "role": "五百藏",
          "text": "那当然了。吾辈可是曾经用泥团子和狸子毛做成的刺身拼盘，把绪方的四鬼骗得团团转的五百藏。"
        },
        {
          "role": "派蒙",
          "text": "五百藏真厉害！不过，这么说来，刚刚给我们吃的到底是用什么做的呀？"
        },
        {
          "role": "旅行者",
          "text": "有的事情还是不问为好。"
        },
        {
          "role": "派蒙",
          "text": "？"
        },
        {
          "role": "派蒙",
          "text": "算了，我们去找吉法师聊聊看吧！"
        },
        {
          "type": "subtitle",
          "text": "与吉法师对话"
        },
        {
          "role": "派蒙",
          "text": "吉法师，好久不见啦！"
        },
        {
          "role": "吉法师",
          "text": "呶！白毛黄毛。"
        },
        {
          "role": "旅行者",
          "text": "黄毛是指我…？"
        },
        {
          "role": "派蒙",
          "text": "喂！你说谁是白毛呀！"
        },
        {
          "role": "吉法师",
          "text": "好强。能听懂。"
        },
        {
          "role": "旅行者",
          "text": "我叫旅行者，这位是派蒙。"
        },
        {
          "role": "派蒙",
          "text": "要好好记住喔！"
        },
        {
          "role": "吉法师",
          "text": "咔嚓咔嚓菫瓜。"
        },
        {
          "role": "派蒙",
          "text": "咦，菫瓜？咔嚓咔嚓又是什么？！"
        },
        {
          "role": "派蒙",
          "text": "无论如何，也算是勉强能说得上话吧…"
        },
        {
          "role": "旅行者",
          "text": "确实有够勉强的。"
        },
        {
          "role": "派蒙",
          "text": "不管怎么说，旅行者，我们去跟五百藏打声招呼吧！毕竟，要带吉法师一起远行了。"
        },
        {
          "type": "subtitle",
          "text": "与五百藏对话"
        },
        {
          "role": "吉法师",
          "text": "五百藏！耶！"
        },
        {
          "role": "派蒙",
          "text": "耶！"
        },
        {
          "role": "五百藏",
          "text": "呶！如何？"
        },
        {
          "role": "吉法师",
          "text": "呶！见到白毛黄毛，喜欢。菫瓜砰砰。"
        },
        {
          "role": "旅行者",
          "text": "菫瓜砰砰…"
        },
        {
          "role": "五百藏",
          "text": "呶？想不到，你这小辈，还挺上道嘛…？"
        },
        {
          "role": "吉法师",
          "text": "砰砰！"
        },
        {
          "role": "旅行者",
          "text": "所以说，菫瓜砰砰是什么意思…？"
        },
        {
          "role": "吉法师",
          "text": "砰砰是砰砰，菫瓜是菫瓜。"
        },
        {
          "role": "五百藏",
          "text": "看来你们交流没有任何问题了。吾辈的「烹饪」技术还是一样好哪。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "…姑且算是没问题吧？",
            "问题大着呢！"
          ]
        },
        {
          "role": "派蒙",
          "text": "不对！问题大着呢！吉法师说的话，基本都听不懂啦！"
        },
        {
          "role": "派蒙",
          "text": "是这样的…"
        },
        {
          "type": "subtitle",
          "text": "向五百藏传达了交流的效果。"
        },
        {
          "role": "五百藏",
          "text": "唔唔，原来是这样啊。不用担心，那是因为你们还没有适应吉法师的气味。"
        },
        {
          "role": "五百藏",
          "text": "慢慢适应吧！越适应吉法师的气息，就越能听明白吉法师说的话。"
        },
        {
          "role": "派蒙",
          "text": "「慢慢」是多久啦…"
        },
        {
          "role": "五百藏",
          "text": "这个啊，这个嘛…我想想…"
        },
        {
          "role": "五百藏",
          "text": "呶！稍安勿躁就是了，真是急性子。"
        },
        {
          "role": "吉法师",
          "text": "急性子不好。"
        },
        {
          "role": "旅行者",
          "text": "看来五百藏也不知道啊。"
        },
        {
          "role": "五百藏",
          "text": "哼！吾辈可是活了好久好久的妖狸大王隐神五百藏，怎么会像你们人类那样，对时间这么计较呢！"
        },
        {
          "role": "派蒙",
          "text": "（虽然大部分时间都被封印在石像里啦。）"
        },
        {
          "role": "旅行者",
          "text": "不过，为什么五百藏可以和人对话？"
        },
        {
          "role": "五百藏",
          "text": "呶，真没礼貌。应该是，为什么你们人类可以和吾辈对话才对。"
        },
        {
          "role": "五百藏",
          "text": "像吾辈这样活了好久好久、力量强大的妖狸，多少都和人类打过交道。"
        },
        {
          "role": "五百藏",
          "text": "好久好久以前，吾等经常和天狗、狐、鬼、妖怪与人打交道。人的故事虽然总在说人，其实有一半是妖狸伪装成的人类的历史。"
        },
        {
          "role": "五百藏",
          "text": "剩下一半的一半是人类自己的故事，另一半是天狗、狐、鬼和其他妖怪的故事。"
        },
        {
          "role": "五百藏",
          "text": "不过，这一半里面，也有一半是吾等妖狸伪装成他们的故事。然后，所有妖狸的故事里，有一半是吾辈五百藏的故事。"
        },
        {
          "role": "五百藏",
          "text": "所以，哼，吾辈可是最厉害的呶，能够和你们这些小辈说话自然不在话下。"
        },
        {
          "role": "旅行者",
          "text": "我懂了，十六分之五都是你的。"
        },
        {
          "role": "五百藏",
          "text": "呶？「十六分之五」…是什么好吃的吗？"
        },
        {
          "role": "派蒙",
          "text": "听起来，好吃。想吃。"
        },
        {
          "role": "派蒙",
          "text": "旅行者是说，依照五百藏的说法，五百藏在故事里的占比啦。"
        },
        {
          "role": "派蒙",
          "text": "五百藏。厉害。"
        },
        {
          "role": "五百藏",
          "text": "哼，那还用说。吾辈的厉害，你要好好学学。"
        },
        {
          "role": "派蒙",
          "text": "欸？仔细一想，好像能慢慢听明白吉法师说的话了…"
        },
        {
          "role": "吉法师",
          "text": "白毛聪明。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，被吉法师这样夸了，心里感觉很不是滋味…"
        },
        {
          "role": "五百藏",
          "text": "那就好。这个孩子就拜托你们了，带他到外边去修行吧。"
        },
        {
          "role": "五百藏",
          "text": "吾辈还是个幼狸的时候，也曾经巡礼稻妻十八所，寻访过去大妖狸「九百九」的名迹，绝不偏离狸道，才能达到今天的高度。"
        },
        {
          "role": "派蒙",
          "text": "欸！所以五百藏才被封印在石头里吗？"
        },
        {
          "role": "吉法师",
          "text": "呶哈哈，石头。"
        },
        {
          "role": "五百藏",
          "text": "呶？！吉法师，连你也…"
        },
        {
          "role": "派蒙",
          "text": "回到正题！那我们先去什么地方好呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刚刚五百藏提到了…",
              "dialogues": [
                
              ]
            },
            {
              "text": "龙脊雪山如何？",
              "dialogues": [
                
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯嗯！就去龙脊雪山吧！"
        },
        {
          "role": "派蒙",
          "text": "「因为，山就在那里」——终于有机会帅气地说这样的台词了！"
        },
        {
          "role": "吉法师",
          "text": "山就在那里！"
        },
        {
          "role": "五百藏",
          "text": "呜呶呶，听起来好冷…吉法师，肚皮不要着凉。不然，会感冒的。感冒的话，就不能表演腹鼓了。"
        },
        {
          "role": "五百藏",
          "text": "然后，要好好吃饭，在外面要乖乖跟着黄毛叔叔走。"
        },
        {
          "role": "吉法师",
          "text": "知道了！我跟黄毛叔叔走。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我们会照顾好吉法师。",
            "放心交给我们吧。",
            "不是叔叔，是哥哥！"
          ]
        },
        {
          "role": "派蒙",
          "text": "请多多关照啦，吉法师！"
        },
        {
          "role": "吉法师",
          "text": "呶，不用担心！吉法师关照你们！"
        },
        {
          "role": "派蒙",
          "text": "似乎还是没能完全互相理解…"
        }
      ]
    }
  ]
}