{
  "quest_id": 72661,
  "chapter_num": null,
  "chapter_title": "我本将心",
  "type": "wq",
  "route": "To Thee My Tender Grief Confide",
  "stories": [
    {
      "story_id": 72661,
      "title": "我本将心",
      "description": "没能成功邀请嘉玮加入队伍，楠塔克这边是否会顺利呢？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与蒙德渔师楠塔克对话"
        },
        {
          "role": "楠塔克",
          "text": "哦，年轻的钓鱼家，见到你可真高兴啊。怎么，遇上了麻烦吗？"
        },
        {
          "role": "楠塔克",
          "text": "来来来，我可是你的钓鱼领路人了，有什么事说给我听听。"
        },
        {
          "role": "楠塔克",
          "text": "居然是「海中月」啊，鲸井还在执着这件事，也难怪，毕竟她的愿望是…"
        },
        {
          "role": "楠塔克",
          "text": "唉，她要是知道了「海中月」的真相，一定会很失望吧。"
        },
        {
          "role": "旅行者",
          "text": "什么真相？"
        },
        {
          "role": "楠塔克",
          "text": "其实当年返航之后，我也没有停止关于「海中月」的调查，后来终于在一本古籍中找到了线索。"
        },
        {
          "role": "楠塔克",
          "text": "根据那些线索，我又去实地调研，终于发现了一些惊人的事。"
        },
        {
          "role": "楠塔克",
          "text": "我把这些发现都写进了我的作品里，最近似乎销路还不错呢。"
        },
        {
          "role": "楠塔克",
          "text": "来，刚好手边有编辑留下的赠本，给你们看看，关于「海中月」的真相全在里面了。"
        },
        {
          "role": "派蒙",
          "text": "我也要看，让我也看看！"
        },
        {
          "role": "派蒙",
          "text": "《关于「海中月」的真身其实是大海龟这件事》…好长的书名啊… 欸？！"
        },
        {
          "role": "派蒙",
          "text": "大海龟？「海中月」是大海龟？"
        },
        {
          "role": "楠塔克",
          "text": "没错，「海中月」就是一只大海龟。"
        },
        {
          "role": "楠塔克",
          "text": "当年那个晚上，我们看见的，就是一只背后长满了类似小灯草这种发光植物的大海龟。"
        },
        {
          "role": "楠塔克",
          "text": "它是一位怀孕的母亲，正在上岸产卵的路上，因此我们才得以找到回家的路。"
        },
        {
          "role": "楠塔克",
          "text": "所以，请回去把我的话转告鲸井吧。不论如何，人终究要面对现实。"
        },
        {
          "role": "旅行者",
          "text": "可是，虽然这也能说通..."
        },
        {
          "role": "楠塔克",
          "text": "看你的表情，还有点不相信吧？但我的研究是有证据的。"
        },
        {
          "role": "楠塔克",
          "text": "古籍中提到，「海中月」是一种古老的生物，在很久很久以前，很多生物还在陆地上生活的时候。"
        },
        {
          "role": "楠塔克",
          "text": "它们的祖先，就活跃在如今的龙脊雪山地区，现在还能够找到一些化石。"
        },
        {
          "role": "楠塔克",
          "text": "我上次就在眠龙谷西侧的矿堆里发现了一些，你们如果还不相信，可以去找找看。"
        },
        {
          "type": "subtitle",
          "text": "前往雪山寻找「海中月」化石"
        },
        {
          "role": "派蒙",
          "text": "这啥都没有嘛"
        },
        {
          "role": "派蒙",
          "text": "都是些破石头"
        },
        {
          "type": "subtitle",
          "text": "与派蒙讨论"
        },
        {
          "role": "派蒙",
          "text": "怎么都是些都是矿渣，感觉里面有东西被人取走了一样。"
        },
        {
          "role": "派蒙",
          "text": "咦？！那个人是...盗宝团？"
        },
        {
          "role": "派蒙",
          "text": "不会是他们拿走了矿石里的东西吧？"
        },
        {
          "role": "派蒙",
          "text": "快跟上他们，周围肯定有他们的营地，矿石里的东西一定都在那里！"
        },
        {
          "role": "旅行者",
          "text": "我们走。"
        },
        {
          "role": "派蒙",
          "text": "我们要偷偷的，偷偷的，别被发现了。"
        },
        {
          "type": "subtitle",
          "text": "前跟踪盗宝团"
        },
        {
          "role": "老黑七",
          "text": "嘿，你们说，这破石头值钱吗？居然藏在矿石里，真稀罕。"
        },
        {
          "role": "林逃山",
          "text": "笑死了，什么叫破石头，你读过书吗？这叫化石，化石懂吗？"
        },
        {
          "role": "林逃山",
          "text": "值钱死了，光这一颗就能买下半个璃月港！快回去多读点书吧！"
        },
        {
          "role": "巴子",
          "text": "真的吗？有这么值钱吗？那加上营地里的这些，我们岂不是要平步乌云了？！"
        },
        {
          "role": "林逃山",
          "text": "是平步青云！你也回去多读点书吧！"
        },
        {
          "role": "派蒙",
          "text": "喂！那边的家伙，把化石交出来！"
        },
        {
          "role": "林逃山",
          "text": "啊！是谁？！该死…被发现了，兄弟们上！"
        },
        {
          "type": "subtitle",
          "text": "击败盗宝团并拿到化石"
        },
        {
          "type": "subtitle",
          "text": "与鲸井椛对话"
        },
        {
          "role": "鲸井椛",
          "text": "你们终于回来了，欸？嘉玮没来吗?"
        },
        {
          "role": "旅行者",
          "text": "他掉进了温柔乡。"
        },
        {
          "role": "鲸井椛",
          "text": "啊？他成家了？哈哈！确实像他会做的事。"
        },
        {
          "role": "鲸井椛",
          "text": "毕竟之前他的愿望就是这个…好吧，既然是这个理由就原谅他了。"
        },
        {
          "role": "鲸井椛",
          "text": "那楠塔克呢？你们找到了吗？"
        },
        {
          "role": "旅行者",
          "text": "他写了本畅销书。"
        },
        {
          "role": "鲸井椛",
          "text": "欸？没想到他真的成了作家啊？还挺能的啊这老小子，写了什么？"
        },
        {
          "role": "派蒙",
          "text": "我知道我知道！书名叫作《关于「海中月」的真身其实是大海龟这件事》。"
        },
        {
          "role": "鲸井椛",
          "text": "哦，挺长的名字啊，是轻小说吗？不错…我也去买一本看看…嗯？等等。"
        },
        {
          "role": "鲸井椛",
          "text": "关于「海中月」的真身…「海中月」的真身？！"
        },
        {
          "role": "旅行者",
          "text": "嗯…其实是大海龟。"
        },
        {
          "role": "鲸井椛",
          "text": "这家伙在说什么呢？怎么可能是大海龟？他忘了我们当年亲眼看到了「海中月」吗？"
        },
        {
          "role": "派蒙",
          "text": "我们开始也不相信啦…然后就去雪山上找来了「海中月」的化石… 这本书，还有化石，喏，给你。"
        },
        {
          "role": "鲸井椛",
          "text": "不，我不相信，这不是真的…"
        },
        {
          "role": "鲸井椛",
          "text": "你们不知道，我们「鲸井」家是渔师世家，我的父亲也是稻妻闻名的渔师。"
        },
        {
          "role": "鲸井椛",
          "text": "他曾花费了数十年在大海上追捕「海中月」，有一次，他差点就成功了。"
        },
        {
          "role": "鲸井椛",
          "text": "虽然最后还是功亏一篑，但我父亲没有放弃，如果能够捕上传说中的「海中月」，对渔师来说是无上的荣耀。"
        },
        {
          "role": "鲸井椛",
          "text": "但就在下一次出海后…他就再没有回来。"
        },
        {
          "role": "鲸井椛",
          "text": "…"
        },
        {
          "role": "鲸井椛",
          "text": "所以，我不会轻易相信这种话的，请你帮我一把！"
        },
        {
          "role": "旅行者",
          "text": "那你打算怎么办？"
        },
        {
          "role": "鲸井椛",
          "text": "我现在回去找父亲留下的物品，他追逐「海中月」一生，留下了很多资料。一定能在里面找到办法。"
        },
        {
          "role": "鲸井椛",
          "text": "我为你准备了一些钓鱼训练，请等我的好消息吧，到时候还要拜托你。"
        }
      ]
    }
  ]
}