{
  "quest_id": 21028,
  "chapter_num": null,
  "chapter_title": "小小的远行·常备药",
  "type": "iq",
  "route": "The Littlest Journey: Medicine On-Hand",
  "stories": [
    {
      "story_id": 21028,
      "title": "小小的远行·常备药",
      "description": "小蒙开始为他的旅行做准备…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与小蒙对话"
        },
        {
          "role": "小蒙",
          "text": "大哥哥！你来得正好，我有事情想问你！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么事？",
              "dialogues": []
            },
            {
              "text": "旅行准备得怎么样了？",
              "dialogues": [
                {
                  "role": "小蒙",
                  "text": "大部分都是我爸爸和那群叔叔在准备啦…但是爸爸也交给我了一些任务！"
                }
              ]
            }
          ]
        },
        {
          "role": "小蒙",
          "text": "爸爸说，去须弥的路程很远，需要准备一些药物。"
        },
        {
          "role": "小蒙",
          "text": "治疗头痛的、防止腹泻的，防止中暑的…还有解酒的，消食的…好多好多。"
        },
        {
          "role": "派蒙",
          "text": "为什么还要准备解酒的药啦…"
        },
        {
          "role": "旅行者",
          "text": "谈生意的时候要用吧。"
        },
        {
          "role": "派蒙",
          "text": "欸？谈生意和解酒药有什么关系，难道喝酒喝得多，生意就会做得好吗？"
        },
        {
          "role": "小蒙",
          "text": "总之，爸爸要我去「不卜庐」问问，那些药物准备得怎么样了。"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，你能陪我去吗？有些事，我想要请你帮帮忙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "走吧。",
              "dialogues": []
            },
            {
              "text": "你…有什么事要我帮忙？",
              "dialogues": [
                {
                  "role": "小蒙",
                  "text": "到那边再说吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "小蒙",
          "text": "我们走吧，大哥哥。"
        },
        {
          "type": "subtitle",
          "text": "前往「不卜庐」"
        },
        {
          "role": "阿桂",
          "text": "你好，请问是来抓药的吗？"
        },
        {
          "role": "阿桂",
          "text": "咦？这不是小蒙吗？你怎么来了？"
        },
        {
          "role": "阿桂",
          "text": "噢…我知道了，你是来问那些药物的事吧？"
        },
        {
          "role": "阿桂",
          "text": "放心吧，那些药物我基本上都准备好了，会分批送去给你爸爸的。"
        },
        {
          "role": "阿桂",
          "text": "不过你爸爸要的药物量太大，店里囤的一些药材都快用完了，可能有一些药会做得慢一些。"
        },
        {
          "role": "阿桂",
          "text": "我看看啊，嗯…主要是薄荷没剩下多少，所以治疗中暑的药也没法做了。"
        },
        {
          "role": "阿桂",
          "text": "毕竟，除了制作你爸爸的药物订单之外，我们也要给其他人看病啊。"
        },
        {
          "role": "小蒙",
          "text": "那…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "轮到我出场了。",
              "dialogues": [
                {
                  "role": "小蒙",
                  "text": "嘿嘿，谢谢大哥哥！"
                }
              ]
            },
            {
              "text": "我可要收取报酬喔。",
              "dialogues": [
                {
                  "role": "小蒙",
                  "text": "嘿嘿，没问题！谢谢大哥哥！"
                }
              ]
            }
          ]
        },
        {
          "role": "小蒙",
          "text": "那药材的事就拜托你啦，我要留在这里仔细核查一下药物。这是爸爸特意叮嘱我的！"
        },
        {
          "role": "阿桂",
          "text": "这孩子还挺认真的…"
        },
        {
          "role": "阿桂",
          "text": "那你和我进来吧，我把这一批的药物清单给你看看。"
        },
        {
          "role": "小蒙",
          "text": "呜啊…怎么这么多…"
        },
        {
          "role": "阿桂",
          "text": "你先看这些，我把另外一批拿过来。"
        },
        {
          "role": "小蒙",
          "text": "欸？还有吗？！"
        },
        {
          "type": "subtitle",
          "text": "与小蒙对话"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，你找到薄荷了吗？"
        },
        {
          "type": "subtitle",
          "text": "将薄荷交给小蒙"
        },
        {
          "type": "subtitle",
          "text": "与小蒙对话"
        },
        {
          "role": "阿桂",
          "text": "嗯…我也得核查一下这些清单…"
        },
        {
          "role": "小蒙",
          "text": "谢谢大哥哥！"
        },
        {
          "role": "阿桂",
          "text": "嗯，这些应该够我做一些药了。"
        },
        {
          "role": "阿桂",
          "text": "那些治疗中暑的药物，我会放在下批药物里一起送过去。"
        },
        {
          "role": "小蒙",
          "text": "那就辛苦你啦，阿桂哥哥。"
        },
        {
          "role": "小蒙",
          "text": "这些东西给你，谢谢你帮忙，大哥哥，我们回去吧。"
        },
        {
          "role": "小蒙",
          "text": "嘿嘿，爸爸听到这个消息肯定会高兴…"
        },
        {
          "role": "阿桂",
          "text": "小蒙，你等一会。"
        },
        {
          "role": "小蒙",
          "text": "怎么了？"
        },
        {
          "role": "阿桂",
          "text": "你不是要核查药物吗？后面的清单你还没看完呢。"
        },
        {
          "role": "小蒙",
          "text": "欸…欸？我刚才不是核查了那么久…"
        },
        {
          "role": "阿桂",
          "text": "那才核查了多少，来吧小蒙，我们继续核查。"
        },
        {
          "role": "小蒙",
          "text": "呜…好…好吧…"
        }
      ]
    }
  ]
}