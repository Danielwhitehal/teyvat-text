{
  "quest_id": 22106,
  "chapter_num": null,
  "chapter_title": "港口驶过几艘船，二四六七八",
  "type": "iq",
  "route": "One Ship, Two Ships, Three Ships...",
  "stories": [
    {
      "story_id": 22106,
      "title": "港口驶过几艘船，二四六七八",
      "description": "霖铃因为忘记统计昨天港口的船只数量，正陷入着苦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与霖铃对话"
        },
        {
          "role": "霖铃",
          "text": "到底过了几艘…二…不对，四加七…不对不对…"
        },
        {
          "role": "霖铃",
          "text": "呜…这种麻烦事，简直是在浪费我的时间！"
        },
        {
          "role": "旅行者",
          "text": "你在数什么？"
        },
        {
          "role": "霖铃",
          "text": "我正在算昨天港口船只的出入情况…要是算不出来，肯定又要被念叨个不停了。"
        },
        {
          "role": "霖铃",
          "text": "昨天我忙着写诗，完全忘记了这回事…只能现在临时赶。"
        },
        {
          "role": "霖铃",
          "text": "真是的，每天出入港的船都呼啦啦那么一大片，数了这艘忘了那艘，怎么统计嘛。"
        },
        {
          "role": "霖铃",
          "text": "我还不得不在这浪费时间数来数去，一遍又一遍，诗都要写不出来了…真扫兴。"
        },
        {
          "role": "霖铃",
          "text": "咦…对了！如果你愿意的话，能帮我一起算算，昨天有多少艘船出入港吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "霖铃",
                  "text": "那就拜托你了！"
                }
              ]
            },
            {
              "text": "只要这些船不超过十艘…",
              "dialogues": [
                {
                  "role": "霖铃",
                  "text": "哎呀，没关系，就算二十艘也没问题，你不是还有脚趾吗。"
                },
                {
                  "role": "霖铃",
                  "text": "那么，就拜托你啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "霖铃",
          "text": "嗯…本来还应该有个同事和我一起统计，但是…"
        },
        {
          "role": "霖铃",
          "text": "我想想，对了！我记得，码头上经常有三个孩子在一起玩。"
        },
        {
          "role": "霖铃",
          "text": "说不定，他们记得昨天有几艘船出入过港口…"
        },
        {
          "role": "霖铃",
          "text": "但是他们毕竟是孩子，问一个不太保险，你把他们三个都问一问吧。"
        },
        {
          "role": "霖铃",
          "text": "问到了之后，就把昨天船只出入港的情况告诉我吧。"
        },
        {
          "type": "subtitle",
          "text": "询问璐璐"
        },
        {
          "role": "璐璐",
          "text": "今天玩什么好呢…"
        },
        {
          "role": "璐璐",
          "text": "咦？大哥哥，有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于昨天港口出入的船只…"
        },
        {
          "role": "璐璐",
          "text": "昨天港口过的船？我只记得，<color=#00E1FFFF>昨天早上有1艘很大的船开进了港口。</color>"
        },
        {
          "role": "璐璐",
          "text": "阿飞说肯定是千岩军的船，小蒙说应该是运货的。"
        },
        {
          "role": "璐璐",
          "text": "我觉得，那么气派，说不定是璃月七星的船呢。"
        },
        {
          "role": "璐璐",
          "text": "大哥哥，你记住了吗？唔…我还是<color=#00E1FFFF>写下来</color>给你吧。"
        },
        {
          "role": "璐璐",
          "text": "我写的字好看吗？大哥哥可要收好啦。"
        },
        {
          "type": "subtitle",
          "text": "询问璐璐"
        },
        {
          "role": "璐璐",
          "text": "男孩子们真麻烦…"
        },
        {
          "role": "璐璐",
          "text": "大哥哥，你们在做什么呢？"
        },
        {
          "role": "旅行者",
          "text": "关于昨天港口出入的船只…"
        },
        {
          "role": "璐璐",
          "text": "我记不太清了呢，嗯…<color=#00E1FFFF>早上的时候，我好像看见了2艘船开进来了。</color>"
        },
        {
          "role": "璐璐",
          "text": "那两艘船很小，而且看起来并不像是城里的船…"
        },
        {
          "role": "璐璐",
          "text": "大哥哥，你记住了吗？唔…我还是<color=#00E1FFFF>写下来</color>给你吧。"
        },
        {
          "role": "璐璐",
          "text": "我写的字好看吗？大哥哥可要收好啦。"
        },
        {
          "type": "subtitle",
          "text": "询问璐璐"
        },
        {
          "role": "璐璐",
          "text": "大哥哥，你是来陪我们玩的吗？"
        },
        {
          "role": "璐璐",
          "text": "嗯…看起来就不是呢。"
        },
        {
          "role": "旅行者",
          "text": "关于昨天港口出入的船只…"
        },
        {
          "role": "璐璐",
          "text": "昨天？<color=#00E1FFFF>昨天早上没有船进来也没有船出去</color>，码头上的叔叔们都很闲。"
        },
        {
          "role": "璐璐",
          "text": "但是，这些很闲的叔叔也没有回家，还是一直在码头上等着。"
        },
        {
          "role": "璐璐",
          "text": "既然没事做，为什么不回家呢？真奇怪呀…"
        },
        {
          "role": "璐璐",
          "text": "大哥哥，你记住了吗？唔…我还是<color=#00E1FFFF>写下来</color>给你吧。"
        },
        {
          "role": "璐璐",
          "text": "我写的字好看吗？大哥哥可要收好啦。"
        },
        {
          "type": "subtitle",
          "text": "询问阿飞"
        },
        {
          "role": "阿飞",
          "text": "反正，船长就是轮不到我来扮呗…"
        },
        {
          "role": "阿飞",
          "text": "大哥哥，有什么事找我吗？"
        },
        {
          "role": "旅行者",
          "text": "关于昨天港口出入的船只…"
        },
        {
          "role": "阿飞",
          "text": "我没怎么在意，只记得<color=#00E1FFFF>昨天中午的时候，有1艘大船开出港口去了。</color>"
        },
        {
          "role": "阿飞",
          "text": "为什么只记得中午的？"
        },
        {
          "role": "阿飞",
          "text": "小蒙和璐璐昨天中午上街去买莲蓬了，我就一个人守在这。"
        },
        {
          "role": "阿飞",
          "text": "当然要守着位置啊，不然有人把我们的位置抢走了怎么办？"
        },
        {
          "role": "阿飞",
          "text": "怎么？有什么不对的吗？"
        },
        {
          "role": "阿飞",
          "text": "我记得的情况差不多就是这样了…算了，我<color=#00E1FFFF>写下来</color>给你吧。"
        },
        {
          "role": "阿飞",
          "text": "不过，要是出错了可别找我，我的记性可不太好…"
        },
        {
          "type": "subtitle",
          "text": "询问阿飞"
        },
        {
          "role": "阿飞",
          "text": "今天玩什么呢？"
        },
        {
          "role": "阿飞",
          "text": "大哥哥，你有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于昨天港口出入的船只…"
        },
        {
          "role": "阿飞",
          "text": "<color=#00E1FFFF>中午吃饭的时候，我看见2艘船入港了。</color>"
        },
        {
          "role": "阿飞",
          "text": "那两艘船开得很快，一定是在运什么紧急的东西吧。"
        },
        {
          "role": "阿飞",
          "text": "我记得的情况差不多就是这样了…算了，我<color=#00E1FFFF>写下来</color>给你吧。"
        },
        {
          "role": "阿飞",
          "text": "不过，要是出错了可别找我，我的记性可不太好…"
        },
        {
          "type": "subtitle",
          "text": "询问阿飞"
        },
        {
          "role": "阿飞",
          "text": "到底什么时候才轮到我…"
        },
        {
          "role": "阿飞",
          "text": "大哥哥，你们是来找我的吗？"
        },
        {
          "role": "旅行者",
          "text": "关于昨天港口出入的船只…"
        },
        {
          "role": "阿飞",
          "text": "没什么印象了，就<color=#00E1FFFF>中午的时候留意了一下，有3艘船开进港口里面了。</color>"
        },
        {
          "role": "阿飞",
          "text": "然后过去了好多人，卸下了好多货…我们都被水手赶到一边去了。"
        },
        {
          "role": "阿飞",
          "text": "我记得的情况差不多就是这样了…算了，我<color=#00E1FFFF>写下来</color>给你吧。"
        },
        {
          "role": "阿飞",
          "text": "不过，要是出错了可别找我，我的记性可不太好…"
        },
        {
          "type": "subtitle",
          "text": "询问小蒙"
        },
        {
          "role": "小蒙",
          "text": "真想快点长大…"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，你好，你是找我的吗？"
        },
        {
          "role": "旅行者",
          "text": "关于昨天港口出入的船只…"
        },
        {
          "role": "小蒙",
          "text": "港口出入的船只啊，如果我没记错的话，<color=#00E1FFFF>昨天晚上没有船入港，也没有船出港。</color>"
        },
        {
          "role": "小蒙",
          "text": "我的记性还算不错的，大哥哥放心吧。"
        },
        {
          "role": "小蒙",
          "text": "这个<color=#00E1FFFF>便签</color>你收好，我把我记得的情况都写在上面了，可别弄丢了。"
        },
        {
          "role": "小蒙",
          "text": "我爸爸常说，好记性不如烂笔头…啊，这句话好像不是用在这的…"
        },
        {
          "type": "subtitle",
          "text": "询问小蒙"
        },
        {
          "role": "小蒙",
          "text": "真想到处去看看…"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，找我有什么事？"
        },
        {
          "role": "旅行者",
          "text": "关于昨天港口出入的船只…"
        },
        {
          "role": "小蒙",
          "text": "昨天的船只…对不起，我只记得<color=#00E1FFFF>晚上的时候，有1艘船开出了港口。</color>"
        },
        {
          "role": "小蒙",
          "text": "昨天早上，我想去外面摘点莲蓬回来，给璐璐和阿飞吃。"
        },
        {
          "role": "小蒙",
          "text": "结果我摘着摘着，就忘记了时间，晚上了才回来…"
        },
        {
          "role": "小蒙",
          "text": "不过，璐璐和阿飞总算还是吃到莲蓬了，我也没有白费力。"
        },
        {
          "role": "小蒙",
          "text": "这个<color=#00E1FFFF>便签</color>你收好，我把我记得的情况都写在上面了，可别弄丢了。"
        },
        {
          "role": "小蒙",
          "text": "我爸爸常说，好记性不如烂笔头…啊，这句话好像不是用在这的…"
        },
        {
          "type": "subtitle",
          "text": "询问小蒙"
        },
        {
          "role": "小蒙",
          "text": "要是能快点长大就好了…"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于昨天港口出入的船只…"
        },
        {
          "role": "小蒙",
          "text": "我想想…我只记得<color=#00E1FFFF>昨天晚上，有3艘船开进港口里了。</color>"
        },
        {
          "role": "小蒙",
          "text": "船上挂着很亮的灯，码头上也有很多人，好像都是在等这艘船。"
        },
        {
          "role": "小蒙",
          "text": "璐璐和阿飞都回家了，我看了那3艘船很久。"
        },
        {
          "role": "小蒙",
          "text": "如果能坐上这种船，无论是想去哪里，一定都会很轻松吧…"
        },
        {
          "role": "小蒙",
          "text": "这个<color=#00E1FFFF>便签</color>你收好，我把我记得的情况都写在上面了，可别弄丢了。"
        },
        {
          "role": "小蒙",
          "text": "我爸爸常说，好记性不如烂笔头…啊，这句话好像不是用在这的…"
        },
        {
          "type": "subtitle",
          "text": "向霖铃回报"
        },
        {
          "role": "霖铃",
          "text": "你问到昨天船只的情况了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经问到了。"
        },
        {
          "role": "霖铃",
          "text": "太好了，昨天港口的船只情况是什么样的？"
        },
        {
          "role": "旅行者",
          "text": "共驶入了7艘船。"
        },
        {
          "role": "霖铃",
          "text": "驶入7艘吗？嗯…好像和我的印象不太一样…"
        },
        {
          "role": "霖铃",
          "text": "不过算了，应该也差不多啦，这是给你的谢礼，请收下吧。"
        },
        {
          "role": "霖铃",
          "text": "这下子，我总算有空来创作新诗了。"
        },
        {
          "role": "旅行者",
          "text": "共驶入了6艘船。"
        },
        {
          "role": "霖铃",
          "text": "驶入6艘吗？嗯…好像和我的印象不太一样…"
        },
        {
          "role": "霖铃",
          "text": "不过算了，应该也差不多啦，这是给你的谢礼，请收下吧。"
        },
        {
          "role": "霖铃",
          "text": "这下子，我总算有空来创作新诗了。"
        }
      ]
    }
  ]
