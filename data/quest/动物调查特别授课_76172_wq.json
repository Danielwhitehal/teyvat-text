{
  "quest_id": 76172,
  "chapter_num": null,
  "chapter_title": "动物调查特别授课",
  "type": "wq",
  "route": "Fauna Investigation Special Lecture",
  "stories": [
    {
      "story_id": 76172,
      "title": "动物调查特别授课",
      "description": "「斯佩兰扎」附近似乎有什么活动…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往「斯佩兰扎」"
        },
        {
          "role": "米科",
          "text": "和摩拉一样金灿灿的，简直就是鳅鳅界的大黄金鳅鳅！"
        },
        {
          "role": "旅行者",
          "text": "摩拉？哪里有摩拉？"
        },
        {
          "role": "派蒙",
          "text": "好像还听到了黄金什么的…"
        },
        {
          "role": "莉奈娅",
          "text": "嗯！其实是前阵子在北边调查时发现了颜色独特的金鳅鳅，那一带就只有这么一只颜色不一样。"
        },
        {
          "role": "莉奈娅",
          "text": "它现在状态不错，我也找了更熟悉动物生态的医生看过，应该不是病理性的颜色改变。"
        },
        {
          "role": "派蒙",
          "text": "那它的颜色为什么会这么不一样呢？"
        },
        {
          "role": "莉奈娅",
          "text": "可能的原因有很多，比如栖息地的环境，包括水源和气候…对了，还有摄入的食物之类的。"
        },
        {
          "role": "莉奈娅",
          "text": "不过要问究竟是哪个特定的原因，我也答不上来了。"
        },
        {
          "role": "旅行者",
          "text": "你也有这种不求甚解的时候啊。"
        },
        {
          "role": "莉奈娅",
          "text": "因为是很偶然的现象嘛！光是能遇到就已经非常幸运了。"
        },
        {
          "role": "莉奈娅",
          "text": "能够记录发现，再作出一些推论和猜想，我就已经心满意足了。"
        },
        {
          "role": "玫熙",
          "text": "就像粉色的霜鳍鲸…"
        },
        {
          "role": "玫熙",
          "text": "大家都说如果能有机会看到粉色的霜鳍鲸，想要实现的愿望就能成真，可是真的真的很难遇到。"
        },
        {
          "role": "玫熙",
          "text": "不过我们有见到哦，和莉奈娅姐姐一起。我觉得，说不定是莉奈娅姐姐给我们带来的好运。"
        },
        {
          "role": "派蒙",
          "text": "哇，旅行者，我们有机会也去找找看吧！我有好多愿望呢，要先许哪个好呢…"
        },
        {
          "role": "旅行者",
          "text": "颜色不一样就有这么神奇的能力吗？"
        },
        {
          "role": "莉奈娅",
          "text": "只是一种美好的愿望吧。"
        },
        {
          "role": "派蒙",
          "text": "居然没有神奇能力吗！"
        },
        {
          "role": "莉奈娅",
          "text": "的确有这样的例子，颜色特殊的个体也有着特别的能力，不过那只霜鳍鲸多半不是。"
        },
        {
          "role": "莉奈娅",
          "text": "如果只是向它许愿还好…就怕有人因此而伤害它。"
        },
        {
          "role": "派蒙",
          "text": "欸？还有这种事吗？"
        },
        {
          "role": "米科",
          "text": "我知道！以前听卡嘉说过，有些很坏的宝藏猎人会捕猎颜色特别的动物卖给收藏家之类的。"
        },
        {
          "role": "莉奈娅",
          "text": "嗯，有段时间纳塔的动物在黑市上很受追捧，活物自不必说，骨头和皮毛也有相当的市场。"
        },
        {
          "role": "莉奈娅",
          "text": "有些商人为了将走私的货品卖出高价，甚至不惜加工和改造，将其包装成一种「幻想」再兜售给客户。"
        },
        {
          "role": "莉奈娅",
          "text": "曾经还发生过这样的事，盗猎者为了美观和方便运输，在制作绒翼龙的标本时去除了它们的脚…"
        },
        {
          "role": "莉奈娅",
          "text": "而从未见过绒翼龙的收藏家竟然以为这种龙天生就是没有脚的，它们一生都在空中翱翔，餐风饮露，并对此啧啧称奇。"
        },
        {
          "role": "莉奈娅",
          "text": "他们轻率的追捧也反过来助长了盗猎者的恶行，一个基于贪婪和谎言而生的走私链条，造成了多少伤害和痛苦…"
        },
        {
          "role": "露米",
          "text": "呀吼…"
        },
        {
          "role": "莉奈娅",
          "text": "在许多的恶行里，哪怕是比较轻度的染色，总归也是不好的。"
        },
        {
          "role": "玫熙",
          "text": "那…那我们要给它洗澡吗？那只银色的豚兽，它也是被坏人染成这个颜色的吗？"
        },
        {
          "role": "莉奈娅",
          "text": "不用不用，我发现它的时候，它正泡在丘丘人的锅里呢，不知道是不是当作泡温泉了。"
        },
        {
          "role": "莉奈娅",
          "text": "它应该是非常罕见的，天生就是这个毛色，也是因为这样才会被走私者抓住吧。"
        },
        {
          "role": "派蒙",
          "text": "感觉完全能想象豚兽泡在锅里的样子…"
        },
        {
          "role": "莉奈娅",
          "text": "是吧？虽然颜色很特别，但天性还是和其他豚兽一样。"
        },
        {
          "role": "米科",
          "text": "说起来，我们之前也抓到过白色的盗宝鼬。"
        },
        {
          "role": "派蒙",
          "text": "是摩拉小偷！对哦，它现在怎么样了？"
        },
        {
          "role": "莉奈娅",
          "text": "已经放归了。希望它也得到了教训，不要再靠近愚人众的研究设施了…"
        },
        {
          "role": "莉奈娅",
          "text": "和豚兽不同，它的毛色变化应该是后天的，很有可能是暴露在过高浓度的月矩力环境里导致的。"
        },
        {
          "role": "派蒙",
          "text": "居然是这样…"
        },
        {
          "role": "派蒙",
          "text": "这样看来，「特别」也不见得全是好事呢。"
        },
        {
          "role": "派蒙",
          "text": "一想到它们中有些可能因为「特别」而遭遇不幸，或者原本就是因为不幸的事而变得「特别」的…"
        },
        {
          "role": "莉奈娅",
          "text": "虽然这么说可能会有点自私，不过，如果不是因为露米也是「特别」的霜精，或许我们就不会结成伙伴了…"
        },
        {
          "role": "露米",
          "text": "呀吼！呀吼吼！"
        },
        {
          "role": "旅行者",
          "text": "可是它看起来好像没什么意见。"
        },
        {
          "role": "米科",
          "text": "所以也不全是坏事吧？"
        },
        {
          "role": "派蒙",
          "text": "如果「特别」带来的是美好的相遇，当然是好事了。"
        },
        {
          "role": "米科",
          "text": "而且我记得之前赫卡寄回来的信里说过，璃月有句什么古话，福什么祸什么…"
        },
        {
          "role": "玫熙",
          "text": "是「祸兮福之所倚，福兮祸之所伏」。"
        },
        {
          "role": "米科",
          "text": "哦哦，就是这句！话说回来，你可是老师呀，怎么能在上课的时候消沉，快打起精神来吧。"
        },
        {
          "role": "莉奈娅",
          "text": "没想到我也有被米科鼓励的一天…"
        },
        {
          "role": "米科",
          "text": "那、那也是看在你以前也是海螺帮的份上！哎，这些复杂的道理先放一边，还是给我们讲讲兽怪的事吧！"
        },
        {
          "role": "米科",
          "text": "他们真的那么强吗？和雪精还有树妖相比呢？"
        },
        {
          "role": "莉奈娅",
          "text": "嗯嗯，兽怪也有很多精彩的故事可以讲哦，不过嘛…就留到下次再说了。"
        },
        {
          "role": "米科",
          "text": "又是下次吗？那下次一定！"
        }
      ]
    }
  ]
}