{
  "quest_id": 75246,
  "chapter_num": null,
  "chapter_title": "邂逅总在悠闲时",
  "type": "wq",
  "route": "Encounters Always Happen on a Holiday",
  "stories": [
    {
      "story_id": 75246,
      "title": "邂逅总在悠闲时",
      "description": "在悠悠度假村闲逛时，你与派蒙见到了熟悉的身影…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "旅行者，快看那边，有人在呢！"
        },
        {
          "role": "旅行者",
          "text": "唔？这两个背影是…"
        },
        {
          "role": "派蒙",
          "text": "欧洛伦和伊法！"
        },
        {
          "role": "欧洛伦",
          "text": "熟悉的声音，是爷爷和派蒙。"
        },
        {
          "role": "咔库库",
          "text": "噢哥们！"
        },
        {
          "role": "伊法",
          "text": "好久不见，你们也来度假村了啊。"
        },
        {
          "role": "派蒙",
          "text": "恰斯卡说过你们来度假村工作的事，没想到突然就遇到啦。"
        },
        {
          "role": "伊法",
          "text": "是啊，这里氛围不错，听说大家都玩得很开心。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，希望这里办得越来越好、游客越来越多！"
        },
        {
          "role": "派蒙",
          "text": "你们呢？工作还顺利吗？"
        },
        {
          "role": "伊法",
          "text": "还不错，我们负责照顾的龙员工和蜜虫都很健康，活力十足。托这个的福，我们也有空到处转转。"
        },
        {
          "role": "欧洛伦",
          "text": "…员工。"
        },
        {
          "role": "伊法",
          "text": "啊？"
        },
        {
          "role": "欧洛伦",
          "text": "蜜虫员工。龙员工和蜜虫员工，你说漏了。"
        },
        {
          "role": "咔库库",
          "text": "没错哥们！"
        },
        {
          "role": "伊法",
          "text": "哎…抱歉啊。那么感谢所有的员工，以及积极为各位员工服务的欧洛伦先生。"
        },
        {
          "role": "欧洛伦",
          "text": "早到几天，为重要的事物奋斗。嗯，很好。"
        },
        {
          "role": "伊法",
          "text": "这哥们第一次接到如此正式的邀请函，可积极了，你别见怪。"
        },
        {
          "role": "旅行者",
          "text": "保持热情是好事。"
        },
        {
          "role": "欧洛伦",
          "text": "你看，爷爷也这么说。"
        },
        {
          "role": "欧洛伦",
          "text": "每一天都很重要，每一天的工作都是为守护重要的事物而战。这是咔库库教会我的。"
        },
        {
          "role": "咔库库",
          "text": "哈哈！"
        },
        {
          "role": "派蒙",
          "text": "可是…看样子你们是在钓鱼吧？钓鱼也算为重要的事而战？"
        },
        {
          "role": "咔库库",
          "text": "听听你说的话！"
        },
        {
          "role": "欧洛伦",
          "text": "很重要，因为钓鱼是一位朋友给我们的建议。他是蒙德有名的冒险家，运气极佳，听他的准没错。"
        },
        {
          "role": "旅行者",
          "text": "（啊…班尼特吗？）"
        },
        {
          "role": "伊法",
          "text": "那位哥们用树枝转了一圈，指向这片水池，欧洛伦说择运不如撞运，就过来钓鱼了。"
        },
        {
          "role": "派蒙",
          "text": "等一等等一等，我从刚才就想问了，这池子周围不都是豚兽嘛！真的能钓上鱼来？"
        },
        {
          "role": "欧洛伦",
          "text": "没问题的。豚兽性情温和，不太野，所以不需要警惕。有水就能野钓，这是奶奶的教诲。"
        },
        {
          "role": "伊法",
          "text": "奶奶还说有饭就吃，有台阶就下呢，你记住了没？"
        },
        {
          "role": "欧洛伦",
          "text": "我现在正在给出台阶。爷爷，派蒙，来都来了，要不要一起钓鱼？"
        },
        {
          "role": "伊法",
          "text": "顺便一提，钓到最大的鱼的人，可以得到这家伙的蜜酒。"
        },
        {
          "role": "派蒙",
          "text": "有这种好事怎么不早说！"
        },
        {
          "role": "派蒙",
          "text": "哼哼，看来你还不知道自己招惹了什么人…面对挑战、说干就干！遇到旅行者你可真是遇到对手啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "亲爱的哥们，一决胜负吧！",
              "dialogues": [
                {
                  "role": "伊法",
                  "text": "真有干劲，那我就奉陪了。"
                }
              ]
            },
            {
              "text": "亲爱的孙子，一起钓鱼吧。",
              "dialogues": [
                {
                  "role": "欧洛伦",
                  "text": "没问题。赌上鱼的一切和蜜虫员工的酒，一决高下吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "来一场惊心动魄的钓鱼赛"
        },
        {
          "role": "欧洛伦",
          "text": "有请辈分最高的爷爷先来。"
        },
        {
          "role": "旅行者",
          "text": "那我就不客气了。"
        },
        {
          "role": "派蒙",
          "text": "哇，一上来比赛就进入高潮！高手旅行者使出绝技，拉杆出水！甩出一条…"
        },
        {
          "role": "派蒙",
          "text": "呃…一只…一位…阿夏？"
        },
        {
          "role": "伊法",
          "text": "真不得了…一上来就钓到了意想不到的东西，直接对评分系统发起挑战。"
        },
        {
          "role": "欧洛伦",
          "text": "不愧是爷爷！如果其他人不能钓到更特别的嘉宾，我觉得这就是冠军。"
        },
        {
          "role": "旅行者",
          "text": "谢谢强大的对手们，谢谢亲爱的观众们！借乖孙吉言，本人有望成为冠军。"
        },
        {
          "role": "派蒙",
          "text": "真是太好了呢！旅行者旗开得胜，为另外两位选手带去压力了！"
        },
        {
          "role": "派蒙",
          "text": "伊法选手请就位！"
        },
        {
          "role": "咔库库",
          "text": "加油，哥们！搭把手哥们！"
        },
        {
          "role": "欧洛伦",
          "text": "抱歉，咔库库，现在不是互帮互助的时候。"
        },
        {
          "role": "伊法",
          "text": "你们消停点…等等，来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "伊法拼尽全力拉动钓竿，看起来像是钓到了大的。",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "然而浮出水面的却是…"
                }
              ]
            },
            {
              "text": "呃…伊法选手从池子里钓上来一条鳍游龙，后面还拖着一只豚兽？不知道它们为什么接在一起呢…",
              "dialogues": [
                {
                  "role": "欧洛伦",
                  "text": "真棒，还是这么受动物欢迎。"
                },
                {
                  "role": "伊法",
                  "text": "不对，这条鳍游龙的尾巴不对劲…难道是它被水底的石头卡住了，然后这只豚兽想要帮它？"
                },
                {
                  "role": "欧洛伦",
                  "text": "也有可能是豚兽想吃鳍游龙的尾巴。"
                },
                {
                  "role": "伊法",
                  "text": "不对吧哥们。咔库库，去问问看？"
                },
                {
                  "role": "咔库库",
                  "text": "嗯嗯…对的哥们！"
                },
                {
                  "role": "伊法",
                  "text": "你看，我猜对了吧…不对不对，当务之急是这个吗？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "伊法迅速检查了鳍游龙的尾巴。还好只是轻微擦伤，并无大碍。",
                      "dialogues": [
                        {
                          "role": "？？？",
                          "text": "简单消毒和上药后，鳍游龙和豚兽结伴离开了。"
                        }
                      ]
                    },
                    {
                      "text": "交到朋友了呢。看来今天也是它们的幸运日。",
                      "dialogues": [
                        {
                          "role": "伊法",
                          "text": "「也」？"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "嗯，我有赢的预感。轮到我奋斗了！"
                        },
                        {
                          "role": "咔库库",
                          "text": "搭把手吧！哥们！"
                        },
                        {
                          "role": "伊法",
                          "text": "到底从哪学来的…不会是在给我们加油的意思吧？"
                        },
                        {
                          "role": "旅行者",
                          "text": "「钓鱼鼓励大师」咔库库！"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "我们在奋斗，所以它应该叫「奋斗鼓励大师」，这样听起来更宏大…嗯？！"
                        },
                        {
                          "role": "伊法",
                          "text": "什么东西？！大家快闪开！"
                        },
                        {
                          "role": "派蒙",
                          "text": "虽然看起来有些特别…但怎么又是豚兽啊！不是说这种生物性格很温和的吗，今天居然这么有干劲…"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "一定也在为自己的重要之事奋斗吧，嗯，我能感觉到…"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "…唔，好像不对…"
                        },
                        {
                          "role": "豚兽",
                          "text": "——！"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "它现在心情不好，该奋斗的是我们。"
                        },
                        {
                          "role": "咔库库",
                          "text": "哦我亲爱的老伙计！"
                        },
                        {
                          "role": "豚兽",
                          "text": "——？"
                        },
                        {
                          "role": "咔库库",
                          "text": "哈哈！太棒了哥们！"
                        },
                        {
                          "role": "派蒙",
                          "text": "什、什么意思？咔库库在说服它吗？"
                        },
                        {
                          "role": "伊法",
                          "text": "应该是在安抚。别看咔库库这个样子，它在安抚患者情绪方面技术高超。"
                        },
                        {
                          "role": "派蒙",
                          "text": "原来如此，不过咔库库的词汇量够用吗？"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "派蒙，用人的词汇本来也无法和豚兽交流。"
                        },
                        {
                          "role": "派蒙",
                          "text": "啊？对哦！"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "在这种情况下，就得相信哥们。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "而且我认为，交流时比起内容，声调更重要，更具有说服力。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "比如像这样，「你好」。这是高兴的意思。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "「你好」…这是无奈的意思。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "「你好」！这是生气的意思，一般表示有危险靠近，要躲避。"
                        },
                        {
                          "role": "派蒙",
                          "text": "不能说完全没有道理，但怎么想都太难理解了…"
                        },
                        {
                          "role": "旅行者",
                          "text": "学到了，非常感谢。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "真的吗？为你开心。我一般都是这样跟蜜虫交流的。"
                        },
                        {
                          "role": "伊法",
                          "text": "「员工」。「蜜虫员工」。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "也有不想当员工的蜜虫，我理解它们的心情，尊重它们的选择。"
                        },
                        {
                          "role": "伊法",
                          "text": "…那能不能先理解一下我的心情？我现在心情很复杂。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "真的吗？我觉得你现在应该感到骄傲才对。看那边。"
                        },
                        {
                          "role": "豚兽",
                          "text": "——。"
                        },
                        {
                          "role": "咔库库",
                          "text": "哈哈！对吧？"
                        },
                        {
                          "role": "豚兽",
                          "text": "——。"
                        },
                        {
                          "role": "咔库库",
                          "text": "天哪天哪！"
                        },
                        {
                          "role": "派蒙",
                          "text": "聊得热火朝天的呢…"
                        },
                        {
                          "role": "伊法",
                          "text": "骄傲多少有点，但我觉得…欸？欧洛伦！"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "别担心，我有办法。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "你好，豚兽大王。要吃点零食吗？新鲜的饼干，伊法刚做的。"
                        },
                        {
                          "role": "豚兽",
                          "text": "呜…"
                        },
                        {
                          "role": "伊法",
                          "text": "豚兽大王？"
                        },
                        {
                          "role": "派蒙",
                          "text": "吃了！看起来很高兴的样子！"
                        },
                        {
                          "role": "咔库库",
                          "text": "哎呀！哎呀！"
                        },
                        {
                          "role": "派蒙",
                          "text": "话说回来，谁还记得我们是在比赛钓鱼啊？这里都快成动物乐园了。"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "不也挺好吗？",
                              "dialogues": []
                            },
                            {
                              "text": "气氛很融洽。",
                              "dialogues": []
                            }
                          ]
                        },
                        {
                          "role": "派蒙",
                          "text": "也是…那，这次钓鱼比赛的冠军，应该是欧洛伦对吧？"
                        },
                        {
                          "role": "派蒙",
                          "text": "因为他钓上了那个什么…豚兽大王。"
                        },
                        {
                          "role": "旅行者",
                          "text": "真是个好名字。"
                        },
                        {
                          "role": "伊法",
                          "text": "可以，就算他吧，反正大家钓上的都不是鱼。"
                        },
                        {
                          "role": "咔库库",
                          "text": "哈哈！"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "那蜜酒就归我了，真好！不过，东西本来就是我的…"
                        },
                        {
                          "role": "派蒙",
                          "text": "能留住手里的好东西也是一种好运呀。"
                        },
                        {
                          "role": "欧洛伦",
                          "text": "你说得对，而且我们还有额外收获。看，豚兽大王好像给我们拿了礼物。"
                        },
                        {
                          "role": "伊法",
                          "text": "「闪闪礼蛋」和一张画片？画片上拍到的地方有些眼熟呢…"
                        },
                        {
                          "role": "派蒙",
                          "text": "难道是豚兽大王要我们去这个地方吗？看上去是某种指引呢。"
                        },
                        {
                          "role": "旅行者",
                          "text": "不如找找看吧。"
                        },
                        {
                          "role": "伊法",
                          "text": "我也这么想，大家有空可以留意一下画片上的地方。"
                        },
                        {
                          "role": "旅行者",
                          "text": "希望豚兽大王准备了好东西。"
                        },
                        {
                          "role": "伊法",
                          "text": "说不定有什么呢…以防万一，大家带齐装备。"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "role": "欧洛伦",
          "text": "有请辈分最高的爷爷先来。"
        },
        {
          "role": "旅行者",
          "text": "那我就不客气了。"
        }
      ]
    }
  ]
}