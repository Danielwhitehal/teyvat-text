{
  "quest_id": 40239,
  "chapter_num": null,
  "chapter_title": "返乡吧，来自沙漠的孩子们",
  "type": "wq",
  "route": "Return Home, Children of the Desert",
  "stories": [
    {
      "story_id": 40239,
      "title": "返乡吧，来自沙漠的孩子们",
      "description": "事情终于告一段落，而至于如何处置阿梵波谛，大家似乎都有自己的想法…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到两天后早上7点到10点"
        },
        {
          "role": "派蒙",
          "text": "不知道大家最后是怎么处理阿梵波谛的，我们去找她们问问吧。"
        },
        {
          "type": "subtitle",
          "text": "前往会场查看大家的情况"
        },
        {
          "role": "派蒙",
          "text": "正好大家都在！"
        },
        {
          "role": "奈芙尔",
          "text": "事情终于要告一段落，大家最好把该聊明白的事情都聊明白。离开会场之后产生的纠纷，伏尼契商会概不负责哦。"
        },
        {
          "role": "夜兰",
          "text": "嗯…璃月方面受到的危害并不严重，打掉转卖渠道也达成了我此行的目的，那些人就全部交给枫丹方面处理吧。"
        },
        {
          "role": "夏沃蕾",
          "text": "多谢通融，因为要整理卷宗，我确实需要把那些人都抓回去。"
        },
        {
          "role": "夏沃蕾",
          "text": "至于你…"
        },
        {
          "role": "夏沃蕾",
          "text": "你毕竟是伏尼契商会名下的人，我要随随便便就把你带走，估计秘闻馆的主人也不会答应吧。"
        },
        {
          "role": "奈芙尔",
          "text": "那你有什么建议吗？夏沃蕾小姐。"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯…不久前，出于追捕犯人的需要，我毁坏了展会在那夏镇安置的广告牌。"
        },
        {
          "role": "奈芙尔",
          "text": "这是警探大人的「自首」？"
        },
        {
          "role": "夏沃蕾",
          "text": "我的意思是，我不带他走了，作为交换，那个广告牌的事情也一笔勾销，如何？"
        },
        {
          "role": "奈芙尔",
          "text": "成交。"
        },
        {
          "role": "派蒙",
          "text": "我原本以为这件事很难处理，结果是这样解决的吗？"
        },
        {
          "role": "阿提",
          "text": "叔叔，我们…"
        },
        {
          "role": "阿娅",
          "text": "你的事，大姐姐们跟我们讲了，但是…我们还是想让你当我们的叔叔。"
        },
        {
          "role": "阿梵波谛",
          "text": "可是我…"
        },
        {
          "role": "夏沃蕾",
          "text": "假如你当年没有轻信那些人的承诺，也给收留你的旅团留下了用来自保的武器，或许就不会招致那样的后果。"
        },
        {
          "role": "夏沃蕾",
          "text": "所以在我看来，你真正的罪过不是研究武器，而是没有用自己的知识保护好那些人。"
        },
        {
          "role": "阿梵波谛",
          "text": "你…说的是啊。"
        },
        {
          "role": "夏沃蕾",
          "text": "那么，一个真正能赎罪的机会就摆在你面前，你却还要犹豫吗？"
        },
        {
          "role": "阿梵波谛",
          "text": "我…"
        },
        {
          "role": "阿梵波谛",
          "text": "就让我好好赎罪吧，孩子们。"
        },
        {
          "role": "夏沃蕾",
          "text": "旅行者，还有璃月的夜兰小姐，这次合作很愉快，那么我就先别过了。"
        },
        {
          "role": "夜兰",
          "text": "旅行者，我手上也有不少公务，就恕不久陪了。"
        },
        {
          "role": "奈芙尔",
          "text": "看来你自由了。"
        },
        {
          "role": "阿梵波谛",
          "text": "就算她们不抓我…我为了自己的目的加入了商会，还差点毁掉你们的声誉，你真的不打算处理我吗？"
        },
        {
          "role": "奈芙尔",
          "text": "你刚加入商会的时候，我就知道你说了很多谎话。但当你声称沙漠是你的「故乡」时，我却发现你并没有在说谎。"
        },
        {
          "role": "奈芙尔",
          "text": "实不相瞒，我也是愿意把沙漠称为「故乡」的人，所以我对你背后的故事很感兴趣。"
        },
        {
          "role": "奈芙尔",
          "text": "有劳旅行者，你的故事我已经拿到了。这个故事还不错，所以你带来的那些麻烦就姑且算是这个故事的附赠品吧。"
        },
        {
          "role": "阿梵波谛",
          "text": "真的吗？"
        },
        {
          "role": "奈芙尔",
          "text": "不过，你毕竟触犯了商会的许多禁忌，我不能让你继续留在商会里。"
        },
        {
          "role": "阿梵波谛",
          "text": "我明白。"
        },
        {
          "role": "奈芙尔",
          "text": "我建议你带着这些孩子回到沙漠去。"
        },
        {
          "role": "阿梵波谛",
          "text": "为什么？"
        },
        {
          "role": "奈芙尔",
          "text": "从我记事起，沙漠里的争斗似乎就没有停止过，但了解过你的故事后，我觉得沙漠里的人也能拥有另一种生活方式。"
        },
        {
          "role": "奈芙尔",
          "text": "现在的须弥跟之前已经大不相同了，在那位小吉祥草王的治下，你帮助这三个孩子重建故乡也不是不可能。"
        },
        {
          "role": "阿梵波谛",
          "text": "感谢你的好意，但是已经过去了这么多年，那片绿洲肯定已经被风沙掩埋了。"
        },
        {
          "role": "阿梵波谛",
          "text": "就算重新搭起几个帐篷又能怎样？现实终究是很残酷的。"
        },
        {
          "role": "多莉",
          "text": "这位客人，要不要瞧一瞧？只要价钱公道，什么都能从咱这里买到！"
        },
        {
          "role": "阿梵波谛",
          "text": "只要有摩拉，什么都能买到？哼…那我能为这些孩子买回一个「故乡」吗？"
        },
        {
          "role": "派蒙",
          "text": "多莉她的叫卖风格就是这样的啦…"
        },
        {
          "role": "多莉",
          "text": "可以哦。"
        },
        {
          "role": "派蒙",
          "text": "欸？"
        },
        {
          "role": "多莉",
          "text": "锵锵！且看这枚充满魔力的宝石，那位大名鼎鼎的魔女艾莉丝的杰作！"
        },
        {
          "role": "多莉",
          "text": "只要把它种下去，即便是黄沙滚滚的地方，也能长出一眼泉水，造就一片绿洲！"
        },
        {
          "role": "阿梵波谛",
          "text": "什么…"
        },
        {
          "role": "奈芙尔",
          "text": "嗯…是真货。"
        },
        {
          "role": "阿梵波谛",
          "text": "挪德卡莱贸易展会果真就像它宣传的那样，什么都可以买到…不过这样的宝物肯定也是天价，我们无福消受就是了。"
        },
        {
          "role": "多莉",
          "text": "怎么说呢，委托我出手这枚宝石的魔女专门叮嘱过，它的定价应该是「孩子们的快乐」。"
        },
        {
          "role": "多莉",
          "text": "唉…明明有更赚钱的卖法，但这位魔女的要求还真不好回绝啊。"
        },
        {
          "role": "阿提",
          "text": "「孩子们的快乐」？那是多少摩拉呢？"
        },
        {
          "role": "多莉",
          "text": "嗯…有了！我只要这三个孩子在展会上挣到的钱，这样就可以看作是他们凭借自己的努力买回了「故乡」。"
        },
        {
          "role": "多莉",
          "text": "这肯定是一件非常快乐的事，对不对？"
        },
        {
          "role": "阿提",
          "text": "成交！"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[文件",
          "text": "活动任务-返乡吧，来自沙漠的孩子们-CG-空.png|center|1100px]]"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[文件",
          "text": "活动任务-返乡吧，来自沙漠的孩子们-CG-荧.png|center|1100px]]"
        },
        {
          "role": "多莉",
          "text": "好嘞！"
        },
        {
          "role": "派蒙",
          "text": "没想到最后还能遇到这样的惊喜。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不愧是多莉。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奈芙尔",
          "text": "今年的展会，确实比往年有趣了不少。"
        }
      ]
    }
  ]
}