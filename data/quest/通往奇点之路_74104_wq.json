        },
        {
          "type": "subtitle",
          "text": "与奎瑟尔对话"
        },
        {
          "role": "派蒙",
          "text": "奎瑟尔！找到你了！"
        },
        {
          "role": "派蒙",
          "text": "那旁边的…肯定就是奎瑟尔说的坏蛋研究伙伴库特罗了吧！"
        },
        {
          "role": "布里科勒",
          "text": "…什么？我叫布里科勒，他才是库特罗。"
        },
        {
          "role": "派蒙",
          "text": "欸？他不是奎瑟尔吗？"
        },
        {
          "role": "库特罗",
          "text": "奎瑟尔…只是一个方便的角色。两位突破了重重考验，我想现在没有必要对两位隐瞒了，我叫库特罗，是这座工坊真正的主人。"
        },
        {
          "role": "库特罗",
          "text": "哈，两位真是…作为素材来说再好不过了，如果两位愿意协助我的研究…"
        },
        {
          "role": "旅行者",
          "text": "什么研究，说来听听。"
        },
        {
          "role": "派蒙",
          "text": "不会吧？！难道你真要协助这种可疑的家伙？"
        },
        {
          "role": "派蒙",
          "text": "这里看起来一点也不像什么正规的工坊呀！而且你又是骗人又是让发条机关攻击我们…根本就是危险分子！"
        },
        {
          "role": "布里科勒",
          "text": "对！你们可千万别上当了！他…他是个穷凶极恶的歹徒！"
        },
        {
          "role": "布里科勒",
          "text": "我在调查时顺着线索找到了这里，没想到你在被除名之后仍在继续危险的研究，甚至还为此盗窃了枫丹科学院的资产…"
        },
        {
          "role": "布里科勒",
          "text": "你已经犯罪了！"
        },
        {
          "role": "库特罗",
          "text": "真多嘴啊，布里科勒，明明只是个不堪一用的庸才…等我评估完两位贵宾的真正价值之后再来料理你。"
        },
        {
          "role": "派蒙",
          "text": "两位贵宾…该不会是指我们吧？"
        },
        {
          "role": "库特罗",
          "text": "当然。距离两位证明自己真正的价值，还差最后一场考验…"
        },
        {
          "role": "库特罗",
          "text": "让我亲眼见识一下两位的本领吧！"
        },
        {
          "type": "subtitle",
          "text": "击败库特罗"
        },
        {
          "type": "subtitle",
          "text": "与布里科勒对话"
        },
        {
          "role": "库特罗",
          "text": "还是你们…技高一筹。是我见过的所有素材里最好的！但也远非我能驾驭的…是我输了。"
        },
        {
          "role": "派蒙",
          "text": "这人真是莫名其妙！"
        },
        {
          "role": "布里科勒",
          "text": "莫名其妙就对了，他之前就是因为做了一些…呃，做了一些「莫名其妙」的研究，才被枫丹科学院除名的。"
        },
        {
          "role": "库特罗",
          "text": "那不是什么莫名其妙的研究…"
        },
        {
          "role": "布里科勒",
          "text": "是啊，当初你和伦理委员会的人也是这么说的，你看有人信你吗？"
        },
        {
          "role": "旅行者",
          "text": "所以到底是什么研究？"
        },
        {
          "role": "布里科勒",
          "text": "咳，如果您希望获取这方面的信息，可以自行前往新枫丹科学院办理相关的合规手续。"
        },
        {
          "role": "派蒙",
          "text": "听起来就好麻烦…"
        },
        {
          "role": "布里科勒",
          "text": "这事真难办啊，虽然他已经被除名了，可我调查的资材失窃案又和他有关…"
        },
        {
          "role": "库特罗",
          "text": "哈，这次要把我送去梅洛彼得堡吗？"
        },
        {
          "role": "布里科勒",
          "text": "这不由我决定，而是由法律决定。很遗憾，这次可不会像上次那样只是简单的除名就能了事了。"
        },
        {
          "role": "布里科勒",
          "text": "不管怎么说，感谢两位的协助，如果只有我一个人恐怕没法制服他…之后的事就交给我吧，我保证，这次他会受到应有的惩罚。"
        },
        {
          "role": "布里科勒",
          "text": "唉，之后我恐怕还得回到这里继续善后工作，这么多资产，得写多少报告啊…"
        }
      ]
    }
  ]
}