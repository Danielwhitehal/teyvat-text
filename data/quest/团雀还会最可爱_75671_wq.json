{
  "quest_id": 75671,
  "chapter_num": null,
  "chapter_title": "团雀还会最可爱",
  "type": "wq",
  "route": "Finches Are Still the Cutest",
  "stories": [
    {
      "story_id": 75671,
      "title": "团雀还会最可爱",
      "description": "在安饶之野，你与派蒙遇见了一位开朗的学者、商人兼可爱动物专家，她正忙于抒发自己的情感，并邀请你们试玩某种游戏…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与学者对话"
        },
        {
          "role": "拜希麦·五世",
          "text": "啾啾，咕咕，啾啾啾！"
        },
        {
          "role": "派蒙",
          "text": "这是在…干什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "密，密文？",
              "dialogues": []
            },
            {
              "text": "暗，暗号？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "拜希麦·五世",
          "text": "是哦！是和可爱团雀沟通的技巧！"
        },
        {
          "role": "拜希麦·五世",
          "text": "哦，我好像忘了和你们打招呼了，还有那句必不可少的开场白。"
        },
        {
          "role": "拜希麦·五世",
          "text": "两位路过的好心人，生论派的学者、新星商人和可爱动物专家拜希麦五世向你们问好。"
        },
        {
          "role": "拜希麦·五世",
          "text": "请放松身体，放空思绪，听我说一件重要的事————"
        },
        {
          "role": "派蒙",
          "text": "团雀最可爱？"
        },
        {
          "role": "拜希麦·五世",
          "text": "完全正确！恭喜你被团雀的可爱感染，开始了抢答！"
        },
        {
          "role": "派蒙",
          "text": "奇怪，不知道为什么，好像看见桌上的游戏，脑袋里就冒出了这句话。"
        },
        {
          "role": "派蒙",
          "text": "你有印象吗，旅行者？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们和这位女士以前见过吧？",
              "dialogues": [
                {
                  "role": "拜希麦·五世",
                  "text": "没错！还不止一面之缘哦，看见你们还是如此活力满满，我感觉心里很温暖！"
                }
              ]
            },
            {
              "text": "现在开始「团雀最可爱」也行。",
              "dialogues": [
                {
                  "role": "拜希麦·五世",
                  "text": "对的！就算暂时想不起以前的事，也没关系，重要的是享受现在…"
                }
              ]
            }
          ]
        },
        {
          "role": "拜希麦·五世",
          "text": "总之，要不要来试试我身边这个游戏？第十七版，也就是第三世代的「哐哐当当雀雀球」！"
        },
        {
          "role": "拜希麦·五世",
          "text": "在轻松休闲的游玩之间，还可以了解大大的朱羽古团雀战胜贼鸥的故事！"
        },
        {
          "role": "派蒙",
          "text": "好哦好哦，轻松休闲的游戏，我们一直都很喜欢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "现在就玩！",
              "dialogues": []
            },
            {
              "text": "开局开局！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "拜希麦·五世",
          "text": "嗯！希望你们能找到最适合自己的玩法，发现独一无二的乐趣！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（拜希麦·五世）"
        },
        {
          "role": "拜希麦·五世",
          "text": "嗯哼哼~怎么样？体验过新版的「哐哐当当雀雀球」了吗？ 可爱团雀家族的新成员，朱羽古团雀~是不是很厉害？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来玩一局「雀雀球」！",
              "dialogues": [
                {
                  "role": "拜希麦·五世",
                  "text": "看来你也和我一样，喜欢看朱羽古团雀蹦蹦弹弹的模样！"
                }
              ]
            },
            {
              "text": "朱羽古团雀不怕疼吗？",
              "dialogues": [
                {
                  "role": "拜希麦·五世",
                  "text": "我刚开始也担心过哦！这次的弹球比以往更接近团雀本身，会不会让大家心疼？"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "我第一次来安饶之野时，犯了个错，身上没除掉的香辛料气味刺激到了一只棕鹿，让它生气地追打我…"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "结果，这只朱羽古团雀从路边跳了出来，撞了撞那只棕鹿，然后好像和它沟通了一番…"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "误会就这么解除了。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "好强力的团雀！",
                      "dialogues": []
                    },
                    {
                      "text": "好聪明的团雀！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "拜希麦·五世",
                  "text": "嗯！我也非常意外，担心这位团雀受了伤，就试着和这位团雀交朋友，领着它去看了医生…"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "检查结果是完全没事，它真是可爱又坚强！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "我不禁思考，我是不是犯了思维惯性的错误呢？"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "下意识将「可爱」与「柔弱」紧密联系在一起，觉得可爱之物就需要无微不至的呵护，甚至将保护变成了限制…"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "有着强大的力量，却性格温和，也可以是一种可爱嘛。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "我懂我懂！",
                      "dialogues": []
                    },
                    {
                      "text": "想起了很多例子！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "拜希麦·五世",
                  "text": "嘿呀，我就知道你的思路和我合拍！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "总而言之，朱羽古团雀启发我，找到了新的团雀可爱之道！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "这次从挪德卡莱回到安饶之野后，我也第一时间和我的朱羽古团雀朋友会合啦！"
                }
              ]
            },
            {
              "text": "看起来，游戏开发得很顺利！",
              "dialogues": [
                {
                  "role": "拜希麦·五世",
                  "text": "是的！多亏之前在挪德卡莱得到了贵人相助，那位贵人给了我大量资金支持，新版本的雀雀球在很多效果上更灵动了！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "那位贵人也只是要了几份新版雀雀球和适度改编的许可，甚至都不要求分红…真是太好心了！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "不过，也有还没实现的目标。"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "原本施放「多多出击」的雀雀弹球，是要召唤两位小团雀伙伴来一起打击贼鸥…"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "负责加工弹球的工匠说她爆单了，完全忙不过来，请求延期两周。"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "我就暂时用一样的朱羽古团雀弹球来顶替，等到另一种小团雀完工后，再迭代版本啦。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "看来是更丰富的表现效果？",
                      "dialogues": []
                    },
                    {
                      "text": "其实两个版本都可以保留？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "拜希麦·五世",
                  "text": "两种都保留的意思是？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "一种是不同团雀联手…",
                      "dialogues": []
                    },
                    {
                      "text": "一种是朱羽三联星合力？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "拜希麦·五世",
                  "text": "好像也有道理…这样甚至能满足不同喜好的客人的需求，不愧是你！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "如果以后，还有机会给你打工，还请允许我在不影响主要项目的情况下，向客人或工友们推荐我的雀雀球…"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "肯定能让大家的精神状态更加饱满，无比开心！"
                }
              ]
            },
            {
              "text": "待会儿再来看团雀~",
              "dialogues": [
                {
                  "role": "拜希麦·五世",
                  "text": "好的呀~空闲下来了，就能彻底轻松地来玩游戏，更加快乐~"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          18,
          20
        ]
      ]
    }
  ]
}