        },
        {
          "role": "萍姥姥",
          "text": "因为璃月啊，从来都是如此"
        },
        {
          "role": "萍姥姥",
          "text": "风雨犹祝，山海同欢，是承天地之佑"
        },
        {
          "role": "甘雨",
          "text": "星移斗转，沧海桑田，烟火人间依旧"
        },
        {
          "role": "凝光",
          "text": "功名在我，百岁千秋，毋忘秉烛夜游"
        },
        {
          "role": "刻晴",
          "text": "今古诸事，激荡中流，宏图待看新秀"
