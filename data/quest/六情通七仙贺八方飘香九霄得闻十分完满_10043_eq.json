          "text": "用以平息种种灾害"
        },
        {
          "role": "萍姥姥",
          "text": "耗尽力量的灶神知性大减"
        },
        {
          "role": "萍姥姥",
          "text": "身形也变得很小"
        },
        {
          "role": "萍姥姥",
          "text": "最终与我们告别时，已不足一人高"
        },
        {
          "role": "萍姥姥",
          "text": "他将带来幸福的菜式与炉火的奥妙告知帝君与我"
        },
        {
          "role": "萍姥姥",
          "text": "自己去往山林"
        },
        {
          "role": "萍姥姥",
          "text": "久久地睡去"
        },
        {
          "role": "萍姥姥",
          "text": "灶神辞行此世，锅巴便诞生了"
        },
        {
          "role": "萍姥姥",
          "text": "醒来那日，他吃到黄衣女孩做的辣肉窝窝头"
