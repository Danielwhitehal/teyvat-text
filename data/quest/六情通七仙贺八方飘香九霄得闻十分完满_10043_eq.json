{
  "quest_id": 10043,
  "chapter_num": "韶光抚月 其二",
  "chapter_title": "六情通七仙贺八方飘香九霄得闻十分完满",
  "type": "eq",
  "route": "Three to Get Ready, and Here We Go",
  "stories": [
    {
      "story_id": 40015,
      "title": "六情通七仙贺八方飘香九霄得闻十分完满",
      "description": "大赛在即，你和派蒙去万民堂找香菱…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往万民堂"
        },
        {
          "role": "派蒙",
          "text": "香菱，我们来啦！"
        },
        {
          "role": "香菱",
          "text": "旅行者，派蒙！你们听说了吗？我顺利通过厨王争霸赛的预选啦！"
        },
        {
          "role": "派蒙",
          "text": "真的？！太好啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕竟是你啊。",
              "dialogues": []
            },
            {
              "text": "因为香菱是最棒的嘛。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "嘿嘿，随便露了一手就通过了…啊啊好汉不提当年勇，我今天还有事要麻烦你们呢。"
        },
        {
          "role": "香菱",
          "text": "我试着做了一些菜品，想请大家试一试，给些意见。旅行者，你要先来一口吗？"
        },
        {
          "role": "旅行者",
          "text": "不巧，来之前我们吃过饭了。"
        },
        {
          "role": "派蒙",
          "text": "啊…啊对对！再说，我们经常吃你做的菜，可能不太客观。保险起见，多找几个人试菜比较好哦。"
        },
        {
          "role": "香菱",
          "text": "好主意！我想想…唔，第一个想请她试菜的人是北斗姐。"
        },
        {
          "role": "派蒙",
          "text": "北斗确实给人一种可靠的感觉，那赶快去找她吧！"
        },
        {
          "role": "香菱",
          "text": "这会儿她应该在码头上。我去把菜装进食盒，我们到码头看看。"
        },
        {
          "type": "subtitle",
          "text": "前往码头寻找北斗"
        },
        {
          "role": "派蒙",
          "text": "找到啦，北斗和辛焱在一起呢。"
        },
        {
          "role": "香菱",
          "text": "北斗姐，辛焱，打扰你们了吗？"
        },
        {
          "role": "北斗",
          "text": "香菱？来得正好，我们刚刚才聊到你。"
        },
        {
          "role": "辛焱",
          "text": "北斗姐说，让我俩有空一起去船上玩，兄弟们都很想我们！"
        },
        {
          "role": "派蒙",
          "text": "你们几个关系真好呀。"
        },
        {
          "role": "香菱",
          "text": "是啊是啊，北斗姐和辛焱都是我的老客户啦，我有时会去北斗姐船上帮厨，辛焱最近也说要去船上演奏呢！"
        },
        {
          "role": "辛焱",
          "text": "好的音乐就该大家一起分享，有空你们也一起来玩啊！"
        },
        {
          "role": "香菱",
          "text": "对了，我入围了本届厨王争霸赛的决赛，刚做了些预备拿去参赛的菜，能不能请你们试吃一下，给点意见？"
        },
        {
          "role": "北斗",
          "text": "好啊，刚好下酒。"
        },
        {
          "role": "辛焱",
          "text": "正好饿了，快让我试试！"
        },
        {
          "role": "辛焱",
          "text": "唔哦——！芙蓉鸡片好好吃啊！"
        },
        {
          "role": "北斗",
          "text": "这么好的菜拿来下酒，我可真有福气，哈哈哈。"
        },
        {
          "role": "派蒙",
          "text": "你有没有觉得，她们性格都好开朗啊…"
        },
        {
          "role": "旅行者",
          "text": "交朋友就要交这样的呢。"
        },
        {
          "role": "北斗",
          "text": "不过，这里一共三道菜，芙蓉鸡片、来来菜、水晶虾，整体口味好清爽啊。"
        },
        {
          "role": "派蒙",
          "text": "呃，能用清爽来形容这三道菜吗？"
        },
        {
          "role": "北斗",
          "text": "我们这些老在海上漂的人可没那么多选择，平日里行船，要是走得远了，口粮都得省着吃。"
        },
        {
          "role": "北斗",
          "text": "所以啊，一回到陆地上，就想吃些味重油重的热菜。"
        },
        {
          "role": "派蒙",
          "text": "北斗跟凝光小姐的口味，根本完全相反嘛！"
        },
        {
          "role": "辛焱",
          "text": "是啊！北斗姐的口味跟我和香菱比较像。"
        },
        {
          "role": "北斗",
          "text": "凝光…别提那女人了，唉。"
        },
        {
          "role": "北斗",
          "text": "我跟她口味差太多了，吃不到一个碗里。"
        },
        {
          "role": "派蒙",
          "text": "可上次看你们聊天，总觉得你们关系很好呢。"
        },
        {
          "role": "北斗",
          "text": "势均力敌也算是一种平衡吧。虽然我对她的开水白菜实在无话可说。"
        },
        {
          "role": "辛焱",
          "text": "我懂我懂！开水白菜上流是上流，可它看似精美，实际上无趣得很。哪像有些菜，一放进嘴巴就有爆裂的感觉！"
        },
        {
          "role": "香菱",
          "text": "辛焱，你也觉得这几道菜清淡了吗？"
        },
        {
          "role": "香菱",
          "text": "比起清淡，我觉得…似乎缺了点节奏。"
        },
        {
          "role": "北斗",
          "text": "没错，这几道菜美则美矣，但要拿去参加比赛，或许差了一点气势。"
        },
        {
          "role": "派蒙",
          "text": "节奏？气势？做饭也要这些吗？"
        },
        {
          "role": "香菱",
          "text": "节奏…气势…"
        },
        {
          "role": "辛焱",
          "text": "节奏嘛，香菱肯定明白。不过我只对音乐内行，做饭可远不及她。我的建议，你随便听听得了…"
        },
        {
          "role": "香菱",
          "text": "不不，辛焱和北斗姐说得没错，节奏…气势！对，是这样！"
        },
        {
          "role": "香菱",
          "text": "我下厨的时候也在想，虽然是全新搭配，但好像少了一些一锤定音的东西…少了那种，临门一脚的感觉！"
        },
        {
          "role": "派蒙",
          "text": "她好像很受启发，可厨艺和音乐真有共同点吗？"
        },
        {
          "role": "旅行者",
          "text": "像我和派蒙的共同点一样吧。"
        },
        {
          "role": "派蒙",
          "text": "啊——！完全不懂你的意思，总觉得是在欺负我！"
        },
        {
          "role": "香菱",
          "text": "好，我有改进的方向了。"
        },
        {
          "role": "派蒙",
          "text": "噢噢，好像很顺利呢！"
        },
        {
          "role": "辛焱",
          "text": "放开胆子尽情尝试吧！你这么厉害，绝对能拿第一的。整个璃月港哪有比你厉害的厨师啊！是吧北斗姐？"
        },
        {
          "role": "北斗",
          "text": "怎么说香菱也是我最看好的名厨，被我北斗看上的人，放眼天下都没有几个。"
        },
        {
          "role": "香菱",
          "text": "嘿嘿…我会加油的，谢谢你们！"
        },
        {
          "role": "北斗",
          "text": "那你先忙，我和辛焱去船上一趟。"
        },
        {
          "role": "派蒙",
          "text": "香菱，你刚才找的人口味都偏重欸，没关系吗？要不要再找个口味偏淡的问问？"
        },
        {
          "role": "香菱",
          "text": "说得也是，北斗姐喜欢重油热炒，辛焱能吃辣…嗯，的确应该再问问。"
        },
        {
          "role": "派蒙",
          "text": "口味偏清淡的人…旅行者，你有推荐的人选吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我又想起一个人。",
              "dialogues": []
            },
            {
              "text": "有一个口味比较清淡的人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "谁呀谁呀？"
        },
        {
          "role": "旅行者",
          "text": "你知道的，杏仁豆腐…"
        },
        {
          "role": "派蒙",
          "text": "对哦，居然是那个人，我们又要去望舒客栈了吗？"
        },
        {
          "role": "香菱",
          "text": "什么什么，谁呀？"
        },
        {
          "role": "派蒙",
          "text": "一个上次你差点见到的人哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用去望舒客栈。",
              "dialogues": []
            },
            {
              "text": "就在这里试试看。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯…？"
        },
        {
          "role": "派蒙",
          "text": "啊！我想起来了，他好像说过，只要喊他名字他就会来。"
        },
        {
          "role": "派蒙",
          "text": "不过…喊名字，真的能听见吗？要不然，我们找个僻静点的地方试试好了。"
        },
        {
          "type": "subtitle",
          "text": "前往僻静处"
        },
        {
          "role": "派蒙",
          "text": "好，我们三个轮流喊！"
        },
        {
          "role": "香菱",
          "text": "哎？我也要？"
        },
        {
          "role": "派蒙",
          "text": "我先来，咳咳！"
        },
        {
          "role": "派蒙",
          "text": "魈——！"
        },
        {
          "role": "香菱",
          "text": "好像没有反应…"
        },
        {
          "role": "派蒙",
          "text": "我再试一次，魈——！"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "不会吧，难道他不肯来？"
        },
        {
          "role": "香菱",
          "text": "所以，是有一个很厉害的人答应你们，一叫他就来？"
        },
        {
          "role": "派蒙",
          "text": "唔，好像…不是我们，而是跟我们中的某个人…"
        },
        {
          "role": "旅行者",
          "text": "跟我。"
        },
        {
          "role": "香菱",
          "text": "这样啊，那你来试就好了嘛。派蒙真是的，就爱凑热闹。"
        },
        {
          "role": "派蒙",
          "text": "呜呜…好吧…"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "魈，你在吗？"
        },
        {
          "role": "？？？",
          "text": "什么事？"
        },
        {
          "role": "香菱",
          "text": "呜哇！"
        },
        {
          "role": "派蒙",
          "text": "真的来了！"
        },
        {
          "role": "魈",
          "text": "你叫了我的名字，对吗？"
        },
        {
          "role": "旅行者",
          "text": "没想到你真的来了…"
        },
        {
          "role": "魈",
          "text": "答应你的事，我会做到。"
        },
        {
          "role": "派蒙",
          "text": "一眨眼就出现了，不愧是仙人…"
        },
        {
          "role": "香菱",
          "text": "居然是仙人！呃，你叫魈是吗？你好，是我拜托旅行者叫你过来的。我叫香菱，是个厨师。"
        },
        {
          "role": "香菱",
          "text": "我入围了本届厨王争霸赛的决赛，赛前做了些菜品，想请各种口味的食客尝一尝。"
        },
        {
          "role": "魈",
          "text": "食客…我也算？"
        },
        {
          "role": "香菱",
          "text": "嗯！旅行者说你口味偏清淡，是我需要找的人。可以的话，想请你尝尝我做的菜，给点意见。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请你帮帮香菱。",
              "dialogues": []
            },
            {
              "text": "魈的意见很重要。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "魈",
          "text": "既然是你的请求…好吧。"
        },
        {
          "role": "香菱",
          "text": "太好了！"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "怎、怎么样？能吃吗？不要勉强自己哦！"
        },
        {
          "role": "魈",
          "text": "…味道不错。"
        },
        {
          "role": "香菱",
          "text": "啊…真、真的？"
        },
        {
          "role": "香菱",
          "text": "天啊，仙人表扬我做的菜好吃…老爸知道了会不会哭啊！"
        },
        {
          "role": "魈",
          "text": "你精于此道，令我想起一个厨师。"
        },
        {
          "role": "魈",
          "text": "那个人能做出充实心灵的好菜，你也是。你们都是高手。"
        },
        {
          "role": "派蒙",
          "text": "你说，魈讲的这个人会不会是言笑啊？"
        },
        {
          "role": "旅行者",
          "text": "我觉得就是言笑！"
        },
        {
          "role": "魈",
          "text": "非要说的话…两道配菜风味对我而言偏重了些。若是稍加修改，能成点睛之笔。"
        },
        {
          "role": "魈",
          "text": "个人意见罢了…不必挂怀。参考与否，全看你。"
        },
        {
          "role": "香菱",
          "text": "嗯嗯嗯，配菜…我记下了。"
        },
        {
          "role": "香菱",
          "text": "谢谢你仙人，很高兴认识你！"
        },
        {
          "role": "魈",
          "text": "那我先回去了。"
        },
        {
          "role": "旅行者",
          "text": "谢谢你。"
        },
        {
          "role": "魈",
          "text": "回见。"
        },
        {
          "role": "派蒙",
          "text": "没想到他真的来了啊！"
        },
        {
          "role": "派蒙",
          "text": "你说我们现在再叫他，他会出现吗？"
        },
        {
          "role": "旅行者",
          "text": "派蒙，不能这样。"
        },
        {
          "role": "派蒙",
          "text": "我开玩笑的嘛…"
        },
        {
          "role": "香菱",
          "text": "旅行者，派蒙，经过两轮试菜我已经有想法了！"
        },
        {
          "role": "派蒙",
          "text": "那就好，不枉我们找了三个人。"
        },
        {
          "role": "香菱",
          "text": "趁现在有灵感，我先回去再试几次，谢谢你们啦！"
        },
        {
          "role": "香菱",
          "text": "对了，决赛会在玉京台举办，千万记得来看哦！"
        },
        {
          "role": "派蒙",
          "text": "嗯，你也加油哦！"
        },
        {
          "role": "旅行者",
          "text": "马到成功！"
        },
        {
          "role": "香菱",
          "text": "嘿嘿，一定！"
        },
        {
          "type": "subtitle",
          "text": "去万民堂看看香菱的情况"
        },
        {
          "role": "派蒙",
          "text": "她好像在忙呢，嘴里还念念有词…"
        },
        {
          "role": "香菱",
          "text": "唔…香嫩椒椒鸡、扣三丝、水晶虾…"
        },
        {
          "role": "派蒙",
          "text": "这些是她要做的菜吗？听得肚子都饿了…旅行者，我想吃，做给我吃吧！"
        },
        {
          "role": "旅行者",
          "text": "好吧好吧…"
        },
        {
          "role": "派蒙",
          "text": "不过，这些菜你会做吗？别是看着眼熟，其实不会吧！哼哼…"
        },
        {
          "role": "派蒙",
          "text": "要不然，看看附近有没有菜谱卖吧！"
        },
        {
          "type": "subtitle",
          "text": "购买并学习派蒙爱吃的菜的菜谱"
        },
        {
          "type": "subtitle",
          "text": "等候至比赛开始（次日10点-14点）"
        },
        {
          "type": "subtitle",
          "text": "前往赛场"
        },
        {
          "type": "subtitle",
          "text": "观看厨王争霸赛"
        },
        {
          "role": "派蒙",
          "text": "快露一手！让大家知道你的厉害！"
        },
        {
          "role": "旅行者",
          "text": "香菱！加油！"
        },
        {
          "role": "香菱",
          "text": "旅行者，派蒙！"
        },
        {
          "role": "香菱",
          "text": "嘿嘿…谢谢你们来看我比赛。放心吧，我会尽全力做出最好吃的东西！"
        },
        {
          "role": "烟绯",
          "text": "欢迎大家来到本届璃月厨王争霸赛决赛现场，我是受组委会邀请担任本届大赛公证员兼主持人的烟绯！"
        },
        {
          "role": "派蒙",
          "text": "是烟绯！她居然也来了！"
        },
        {
          "role": "烟绯",
          "text": "本届厨王争霸赛由璃月七星主办，多个单位承办，分为预选和决赛两个阶段。"
        },
        {
          "role": "烟绯",
          "text": "来自璃月各个地区的参赛选手首先进入预选流程，各显神通，最终决出的两名最强选手将入围本日决赛。"
        },
        {
          "role": "烟绯",
          "text": "稍后决赛就在此地，就在各位面前进行！"
        },
        {
          "role": "烟绯",
          "text": "作为公证员，我谨代表组委会与全体璃月人民对本届决赛进行公证。"
        },
        {
          "role": "烟绯",
          "text": "下面为大家介绍本场评委。评委分为场上评委与场下评委两部分，场上评委共三位，分别是——"
        },
        {
          "role": "烟绯",
          "text": "天权·凝光小姐！"
        },
        {
          "role": "烟绯",
          "text": "玉衡·刻晴小姐！"
        },
        {
          "role": "烟绯",
          "text": "以及资深美食家·天叔！"
        },
        {
          "role": "烟绯",
          "text": "除了这三位，组委会还会从在场观战的人群里选出十位品尝选手制作的菜肴，并进行投票。"
        },
        {
          "role": "烟绯",
          "text": "也就是说，场上场下共十三位评委，十三张有效票将分别投给两位选手。得票高者，就是今天的冠军！"
        },
        {
          "role": "派蒙",
          "text": "哇哦，有模有样的呢！"
        },
        {
          "role": "烟绯",
          "text": "下面就是万众瞩目的选手入场环节！有请两位！"
        },
        {
          "role": "烟绯",
          "text": "站在左边的是本次参赛选手，荻花洲赛区选送种子选手——刀下生香，快刀厨侠，言笑！"
        },
        {
          "role": "言笑",
          "text": "大家好大家好…"
        },
        {
          "role": "派蒙",
          "text": "哇，言笑也进决赛啦！不过怎么搞的，他看起来好紧张啊…"
        },
        {
          "role": "旅行者",
          "text": "毕竟是大场面。"
        },
        {
          "role": "派蒙",
          "text": "言笑——！拿出本事来，你是老板和掌柜的骄傲呀！"
        },
        {
          "role": "言笑",
          "text": "啊？！哦、哦…！"
        },
        {
          "role": "烟绯",
          "text": "站在右边的是本场参赛选手，璃月港赛区选送实力王者——急火如雨，妙手厨娘，香菱！"
        },
        {
          "role": "烟绯",
          "text": "——以及她的神秘帮工伙伴，不知道谁！"
        },
        {
          "role": "派蒙",
          "text": "是锅巴啦！"
        },
        {
          "role": "香菱",
          "text": "大家好！我会加油的！"
        },
        {
          "role": "烟绯",
          "text": "请两位选手跟着我宣誓：作为入围本届厨王争霸赛决赛的选手，我将全力以赴，公平地完成比赛流程。"
        },
        {
          "role": "香菱",
          "text": "作为入围本届厨王争霸赛决赛的选手，我将全力以赴，公平地完成比赛流程。"
        },
        {
          "role": "言笑",
          "text": "呃…作为入围本届厨王争霸赛决赛的选手，我、我将全力以赴，公平地完成比赛流程。"
        },
        {
          "role": "烟绯",
          "text": "而我也将本着公平公正公开的原则见证本届决赛。"
        },
        {
          "role": "烟绯",
          "text": "接下来，有请评委凝光小姐宣布本届决赛的对决主题！"
        },
        {
          "role": "凝光",
          "text": "感谢各位专程来到本届厨王争霸赛决赛现场，我是天权凝光。"
        },
        {
          "role": "凝光",
          "text": "我代表主办方为本届决赛提出的料理关键词是：「陆水之仪」。"
        },
        {
          "role": "派蒙",
          "text": "「食与山河」，「陆水之仪」…跟这次逐月节的主题好配啊。"
        },
        {
          "role": "派蒙",
          "text": "既有土地，又有水流，感觉很高深呢。"
        },
        {
          "role": "凝光",
          "text": "规则很简单，胜者为王。参赛菜品可以投评委所好，也可以凭本事争取场上所有人的心。"
        },
        {
          "role": "凝光",
          "text": "那么，期待两位的表现。"
        },
        {
          "role": "烟绯",
          "text": "本届决赛料理时间为一小时，双方使用主办方提供的各色食材完成菜品制作。没有问题吧。"
        },
        {
          "role": "烟绯",
          "text": "我宣布，本届璃月厨王争霸赛决赛——开始！"
        },
        {
          "type": "subtitle",
          "text": "与香菱对话"
        },
        {
          "type": "subtitle",
          "text": "点燃灶火"
        },
        {
          "type": "subtitle",
          "text": "选取适合的调料"
        },
        {
          "type": "subtitle",
          "text": "制作「美味的水晶虾」"
        },
        {
          "type": "subtitle",
          "text": "选取适合的调料"
        },
        {
          "type": "subtitle",
          "text": "制作「美味的扣三丝」"
        },
        {
          "type": "subtitle",
          "text": "选取适合的调料"
        },
        {
          "type": "subtitle",
          "text": "制作「美味的香嫩椒椒鸡」"
        },
        {
          "type": "subtitle",
          "text": "与言笑对话"
        },
        {
          "role": "烟绯",
          "text": "嗯嗯嗯？请等一等，场上似乎发生了令人惊讶的事件！"
        },
        {
          "role": "烟绯",
          "text": "香菱选手携带的那位神秘帮工似乎去帮对手了！评委团，请问这件事是合理的吗！"
        },
        {
          "role": "烟绯",
          "text": "虽然事前已得知这位神秘帮工是香菱小姐的伙伴，评委团也知晓她们两位一体的情况，但这样的情况到底是…！"
        },
        {
          "role": "凝光",
          "text": "我不反对。再说，那个所谓的帮工也没有出手啊。"
        },
        {
          "role": "天叔",
          "text": "哈哈…年轻人的赛场总是精彩纷呈，老头子我啊，看着就是了。"
        },
        {
          "role": "刻晴",
          "text": "咳…主持人，我来说明一下吧。"
        },
        {
          "role": "刻晴",
          "text": "本届决赛开始前，组委会已对两位参赛人员进行调查，可以确定双方的参赛形式及行为并不违规。"
        },
        {
          "role": "刻晴",
          "text": "香菱是一位非常优秀的厨师，她身边那位所谓的帮工，其实也是香菱的伙伴和家人。"
        },
        {
          "role": "刻晴",
          "text": "香菱的菜都是由她一人亲手制作的，只是偶尔用到这位帮工点火。以香菱本人的厨艺来说，使用帮工点火与使用柴禾点火没有区别。"
        },
        {
          "role": "刻晴",
          "text": "在座各位的忧虑我理解。帮工作为在一旁跳着神秘舞蹈给香菱选手打气的存在，是有一些突然。"
        },
        {
          "role": "刻晴",
          "text": "但此刻它也同样转向言笑选手，为言笑打气，恰恰证明了这位帮工毫不偏心。既鼓励己方，也鼓励对手，它是一名公平的协助者。"
        },
        {
          "role": "香菱",
          "text": "是啊！锅巴不是我的外援，锅巴只是喜欢看人做菜！我想，它肯定是想帮言笑消除紧张才过去的。"
        },
        {
          "role": "香菱",
          "text": "我可以向各位保证，锅巴不会干扰比赛。倒不如说…要是言笑不能正常发挥，才是本届决赛的损失！"
        },
        {
          "role": "香菱",
          "text": "我曾在望舒客栈吃过言笑做的菜，他是个非常厉害的厨师，我希望能与真正的他堂堂正正决出胜负。"
        },
        {
          "role": "凝光",
          "text": "原来如此…当真有趣。天叔，你怎么看？"
        },
        {
          "role": "天叔",
          "text": "没有意见。他们两位能有这么公平的竞技精神，着实令我敬佩。"
        },
        {
          "role": "烟绯",
          "text": "组委会与公证员均认可此番说明！比赛继续！"
        },
        {
          "role": "香菱",
          "text": "言笑，你没事吧？"
        },
        {
          "role": "言笑",
          "text": "我、我也不知道咋了，特别紧张…唉！你瞧我这手抖得…"
        },
        {
          "role": "香菱",
          "text": "放轻松呀，我也有过这种情况，我教你！你在心里默念绕口令，或者…回忆你的老爸！"
        },
        {
          "role": "言笑",
          "text": "老爸？怎么这么具体啊…"
        },
        {
          "role": "香菱",
          "text": "因为我就会回忆我老爸啊。"
        },
        {
          "role": "锅巴",
          "text": "♪~♪~"
        },
        {
          "role": "言笑",
          "text": "呃…那我回忆我老妈好了…哦对，你快去忙吧！我没事儿，总不能因为我出了问题就耽搁你比赛。"
        },
        {
          "role": "香菱",
          "text": "耽搁不了。我都做完了。"
        },
        {
          "role": "言笑",
          "text": "啊？！那我可不能输！"
        },
        {
          "role": "香菱",
          "text": "对对，就是这种气势！你不是很能干吗？拿出本事来言笑，你上回做的菜可好吃了！"
        },
        {
          "role": "言笑",
          "text": "我…对，没错，我可以的！"
        },
        {
          "role": "言笑",
          "text": "香菱，还有这位…呃…总之谢谢你们，我这就开工！"
        },
        {
          "role": "锅巴",
          "text": "♪！"
        },
        {
          "role": "烟绯",
          "text": "时间到！"
        },
        {
          "role": "烟绯",
          "text": "两位选手都已完成各自的料理。下面，请两位选手将菜品送至评委席，交由评委们品赏。"
        },
        {
          "role": "烟绯",
          "text": "根据完成顺序，先请香菱选手介绍她的料理！"
        },
        {
          "role": "香菱",
          "text": "我的菜是——"
        },
        {
          "role": "香菱",
          "text": "主菜「香嫩椒椒鸡」、配菜「扣三丝」、点心「水晶虾」。"
        },
        {
          "role": "香菱",
          "text": "料理题目是「陆水之仪」，包括了海陆两大区域，也就是说，兽肉、禽肉、鱼虾都是可选食材。"
        },
        {
          "role": "香菱",
          "text": "我的主菜，香嫩椒椒鸡，是禽肉与辣椒的组合，绝云椒椒长在山间，是高山的精华，禽肉则是天空的馈赠。"
        },
        {
          "role": "香菱",
          "text": "扣三丝的食材也用到了禽肉，另外还有火腿和竹笋。同为山中韵味，辣与鲜，热与凉，两两相配，能与椒椒鸡遥相呼应。"
        },
        {
          "role": "香菱",
          "text": "至于这道水晶虾，原料是稻米、虾仁和胡萝卜。薄透的外皮裹着胡萝卜丁与整只鲜虾仁，爽脆细嫩。"
        },
        {
          "role": "香菱",
          "text": "虾仁是海的馈赠，被稻米制成的外皮紧紧包住，海陆融合，鲜味钓出微甜。由它来作为整个菜单的尾声，再合适不过啦。"
        },
        {
          "role": "烟绯",
          "text": "好一张漂亮的答卷。接下来，言笑选手，请发言！"
        },
        {
          "role": "言笑",
          "text": "我的菜是…"
        },
        {
          "role": "言笑",
          "text": "「仙跳墙」、「凉拌薄荷」、「金丝虾球」。"
        },
        {
          "role": "言笑",
          "text": "就像香菱说的，陆水陆水，自然是大海与陆地。飞禽走兽，游鱼潜虾，我所用的素材也都在这个范围内。"
        },
        {
          "role": "言笑",
          "text": "仙跳墙是璃月名菜，我作为望舒客栈的厨师，也一直把这道菜视作本店的压轴保留大菜。"
        },
        {
          "role": "言笑",
          "text": "这道菜工艺复杂，用料讲究，用到了熏制的火腿、螃蟹、鲜虾仁和松茸。它就是我的主菜，代表我对我的工作与这次比赛的敬意。"
        },
        {
          "role": "言笑",
          "text": "配菜凉拌薄荷爽嫩清甜，搭配仙跳墙的重鲜浓香刚刚好。"
        },
        {
          "role": "言笑",
          "text": "金丝虾球则是大家都很喜欢的一道经典菜，喝完浓香醇厚的汤，来一口虾球，嘿嘿…别提有多快活了！"
        },
        {
          "role": "派蒙",
          "text": "呜哇…这么远都能闻到香味，我要疯了…"
        },
        {
          "role": "烟绯",
          "text": "请评委开始试吃！"
        },
        {
          "role": "刻晴",
          "text": "非常厉害。两边的菜都极费心思，巧妙又美味。我想再吃个金丝虾…不是！再品味一下双方的手艺。"
        },
        {
          "role": "天叔",
          "text": "香菱选手的构思很有意思，居然以凉菜为主菜，非常大胆。"
        },
        {
          "role": "天叔",
          "text": "这道香嫩椒椒鸡非常独特。菜虽是凉拌，里头的辣椒却翻炒过，内有余温。嚼在口里是辣中带热，热中带脆，还带些许胡椒味，妙极啊！"
        },
        {
          "role": "凝光",
          "text": "仙跳墙妙不可言，扣三丝咸鲜得当，口味高级，也是上品。嗯…水准颇佳。"
        },
        {
          "role": "烟绯",
          "text": "场上三位评委，请稍作思考，将你们的选择写下交给我！"
        },
        {
          "role": "烟绯",
          "text": "此外，组委会选拔出的场下评委也正在参与评审。有幸吃到菜品的各位，请独立判断并投票。"
        },
        {
          "role": "派蒙",
          "text": "可恶，怎么没抽到我们！他们为什么不请我做评委啊？"
        },
        {
          "role": "派蒙",
          "text": "我对吃很执着很精通，错过我是他们的损失！呜…"
        },
        {
          "role": "旅行者",
          "text": "冷静点，派蒙… 回头我做给你吃。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿…虽然这世上有那么多厨师，会做那么多美味佳肴，但对我最好的人，果然还是只有你嘛！"
        },
        {
          "role": "烟绯",
          "text": "各位久等啦！现在投票计票工作已经完成，结果已返还到凝光小姐处。"
        },
        {
          "role": "烟绯",
          "text": "有请凝光小姐宣布本届璃月厨王争霸赛的决赛结果！"
        },
        {
          "role": "凝光",
          "text": "我宣布，本届璃月厨王争霸赛的冠军是——"
        },
        {
          "role": "言笑",
          "text": "唔…"
        },
        {
          "role": "香菱",
          "text": "嗯嗯…"
        },
        {
          "role": "派蒙",
          "text": "呃啊…"
        },
        {
          "role": "凝光",
          "text": "以一票险胜的香菱选手。"
        },
        {
          "role": "香菱",
          "text": "哇！！"
        },
        {
          "role": "派蒙",
          "text": "哎哎哎哎追得这么紧？！"
        },
        {
          "role": "旅行者",
          "text": "言笑也很会做菜呢。"
        },
        {
          "role": "言笑",
          "text": "果然…唉，我就知道。"
        },
        {
          "role": "烟绯",
          "text": "经过激烈的角逐，本届冠军诞生了！璃月港赛区的香菱选手，以一票之差险胜荻花洲赛区的言笑选手！"
        },
        {
          "role": "烟绯",
          "text": "比赛虽有胜负之分，两位得票数却如此接近，可见无论哪一位都是很得人心的优秀厨师！感谢你们的倾情投入！"
        },
        {
          "role": "烟绯",
          "text": "各位观众朋友，各位璃月老乡，感谢你们的关注与观看。我以公证员身份宣布比赛结果公平有效，本届厨王争霸赛完美落幕！"
        },
        {
          "role": "凝光",
          "text": "感谢各位的参加，下次再会。"
        },
        {
          "role": "烟绯",
          "text": "请大家有序离开赛场，不要忘了随身物品哦！"
        },
        {
          "role": "派蒙",
          "text": "我们也过去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "找香菱和言笑聊聊"
        },
        {
          "role": "香菱",
          "text": "言笑，这次是我赢了哦。不过，我可以吃一口你做的菜吗？"
        },
        {
          "role": "言笑",
          "text": "好啊，我也试一下你做的菜吧。"
        },
        {
          "role": "言笑",
          "text": "呼…真是人间美味，我输得心服口服。"
        },
        {
          "role": "香菱",
          "text": "呜…这道仙跳墙真好吃，鲜得我都要流眼泪了…"
        },
        {
          "role": "言笑",
          "text": "哈哈，你喜欢它，说明你是个识货的好厨子！"
        },
        {
          "role": "香菱",
          "text": "不不！我家也是小饭店，我非常理解…民以食为天，食文化就是因为所有食客而存在。永远别小看民间菜啊！"
        },
        {
          "role": "锅巴",
          "text": "♪"
        },
        {
          "role": "言笑",
          "text": "嘿，我听人说你是出了名的奇思妙想，做的菜高端又特别，没想到也是小饭店出来的老手。高手果然就该在市井街巷里。"
        },
        {
          "role": "香菱",
          "text": "你不也是嘛！客栈的厨子永远心系食客，难怪能做出那么好的菜。"
        },
        {
          "role": "言笑",
          "text": "你真是个好对手。等有机会，我们再来切磋吧。"
        },
        {
          "role": "香菱",
          "text": "好！下次比赛时，我们都要比现在更厉害！"
        },
        {
          "role": "言笑",
          "text": "好嘞，一言为定！"
        },
        {
          "role": "香菱",
          "text": "旅行者，派蒙！久等啦！刚才的菜你们吃到没？"
        },
        {
          "role": "派蒙",
          "text": "气死我啦！不要提这事！"
        },
        {
          "role": "香菱",
          "text": "哈哈哈，怎么没抽到你们呀？没事没事，别生气啦，回去我再做给你们吃。"
        },
        {
          "role": "派蒙",
          "text": "真的？太好了！"
        },
        {
          "role": "香菱",
          "text": "啊对了，刚才主办方让我和言笑去登记收货地址，听说他们准备了极品食材套装和奖金，之后会送货上门的。我得走开一下！"
        },
        {
          "role": "香菱",
          "text": "一会儿再来找你们哦！"
        },
        {
          "role": "派蒙",
          "text": "走掉了呢，看她开心的样子，真好啊。"
        },
        {
          "role": "派蒙",
          "text": "说起来，刻晴刚才跟着凝光小姐一起走了，应该是去处理比赛相关的后续。去找她问问神像的事吧！"
        },
        {
          "type": "subtitle",
          "text": "寻找刻晴"
        },
        {
          "role": "派蒙",
          "text": "刻晴——！你在这里啊！"
        },
        {
          "role": "刻晴",
          "text": "你们来了啊。"
        },
        {
          "role": "派蒙",
          "text": "唔？怎么你看起来有心事呀？"
        },
        {
          "role": "旅行者",
          "text": "（刻晴似乎在想什么事…）"
        },
        {
          "role": "刻晴",
          "text": "……"
        },
        {
          "role": "刻晴",
          "text": "旅行者，我遇到一件棘手的事。"
        },
        {
          "role": "刻晴",
          "text": "这次比赛，我把我那一票投给了言笑。"
        },
        {
          "role": "派蒙",
          "text": "刻晴是在为没能把票投给香菱而烦恼吗？"
        },
        {
          "role": "刻晴",
          "text": "不，作为评委就该公正，这一票是我仔细思考后做出的决定，问心无愧。"
        },
        {
          "role": "刻晴",
          "text": "香菱是我朋友，于情于理，我都该跟她坦白这件事。"
        },
        {
          "role": "刻晴",
          "text": "但你也知道，我的想法终归只代表个人立场，香菱作为参赛选手未必能理解我。我又不擅长应付那种性格的人…唉，真不好开口。"
        },
        {
          "role": "派蒙",
          "text": "我倒觉得没关系啦，不用在意说辞，香菱一看就不会介意那些。再说，最终她也赢了啊！"
        },
        {
          "role": "香菱",
          "text": "你们在这里啊，找了我好半天呢！"
        },
        {
          "role": "刻晴",
          "text": "香菱，有件事…想跟你说。"
        },
        {
          "role": "香菱",
          "text": "嗯？怎么了呀？"
        },
        {
          "role": "刻晴",
          "text": "我祖父说过，「若以食为赛，必应随心。」就是说，为饮食而起争端或竞赛时，应当把票投给自己更在乎的一方。这件事应当顺从本心，不受外力影响。"
        },
        {
          "role": "刻晴",
          "text": "当然了，这只是祖父的个人看法。可我确实觉得他的话很有道理…"
        },
        {
          "role": "刻晴",
          "text": "所以…我虽然是你的朋友，却还是把票投给了言笑那道仙跳墙…"
        },
        {
          "role": "旅行者",
          "text": "是为了金丝虾球吧？"
        },
        {
          "role": "香菱",
          "text": "噗…"
        },
        {
          "role": "刻晴",
          "text": "对、对啊，怎么了！我就是喜欢吃金丝虾球不行吗！"
        },
        {
          "role": "旅行者",
          "text": "不敢不敢。"
        },
        {
          "role": "香菱",
          "text": "看你一脸严肃，还以为怎么了呢！没关系啦，我一点都不介意哦。"
        },
        {
          "role": "刻晴",
          "text": "哎？"
        },
        {
          "role": "香菱",
          "text": "刻晴做的只是投票给自己选择的一方，完全没问题呀，本来就该这样，否则比赛不就不公平了吗？"
        },
        {
          "role": "香菱",
          "text": "唔…你会特地告诉我这一点，是担心自己作为朋友不够意思吗？"
        },
        {
          "role": "刻晴",
          "text": "咳、咳咳…！怎么会呢…"
        },
        {
          "role": "香菱",
          "text": "哎，我说过吗？我就是特别欣赏刻晴这么认真的地方。因为对如今的我而言，不带着坚持的意见就没有意义。"
        },
        {
          "role": "香菱",
          "text": "追求舒适是新手做的事，我早就不是新手了。从今往后要做的菜，要走的路，都会比现在更具挑战，我很需要你这样的朋友。"
        },
        {
          "role": "香菱",
          "text": "倒是刻晴你，实在是太有责任心了，有时真的不用那么在乎责任。你是七星也是你自己，跟朋友在一块儿，不需要考虑那么周全。"
        },
        {
          "role": "香菱",
          "text": "你知道凝光小姐就是这样的吧？北斗姐跟我说过好几次，她和凝光可熟了，她俩还会在船上赌棋。"
        },
        {
          "role": "香菱",
          "text": "凝光小姐可是很敢玩的，不会端着身份与架子！你也学学她，该放松时就尽情放松吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "香菱说得很对哦。",
              "dialogues": []
            },
            {
              "text": "刻晴不用对自己太苛刻了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "刻晴",
          "text": "旅行者…香菱…"
        },
        {
          "role": "刻晴",
          "text": "对、对了，不能在这里傻站着，我们还得去看看灶神像的情况！"
        },
        {
          "role": "派蒙",
          "text": "呀，差点把那个给忘了，快去看看！"
        },
        {
          "type": "subtitle",
          "text": "前往玉京台"
        },
        {
          "type": "subtitle",
          "text": "与刻晴对话"
        },
        {
          "role": "派蒙",
          "text": "怪了，石头竟然没有任何变化？"
        },
        {
          "role": "香菱",
          "text": "怎么会这样…明明比赛那么热火朝天…"
        },
        {
          "role": "派蒙",
          "text": "难道说，那场比赛没能让灶神像苏醒吗…"
        },
        {
          "role": "刻晴",
          "text": "……"
        },
        {
          "role": "刻晴",
          "text": "看来…还是没有缘分吗。"
        },
        {
          "role": "旅行者",
          "text": "还有时间，别着急。"
        },
        {
          "role": "派蒙",
          "text": "对对，反正已经花了挺长时间，也不差这一会儿。"
        },
        {
          "role": "派蒙",
          "text": "是吧香菱？"
        },
        {
          "role": "香菱",
          "text": "嗯！还有时间，再等等吧，我们都陪着你呢。"
        },
        {
          "role": "香菱",
          "text": "说起来，刻晴，我有个好消息要告诉你，之前你跟我说的那张菜谱有眉目啦！"
        },
        {
          "role": "香菱",
          "text": "大师父在比赛前来了一趟，给我补好了菜谱上的字哦，我现在可以做这道菜了。"
        },
        {
          "role": "香菱",
          "text": "我马上找地方做给你吃，你等着我！"
        },
        {
          "role": "刻晴",
          "text": "香菱…"
        },
        {
          "role": "香菱",
          "text": "对了，旅行者也一起来，可以吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯？香菱这家伙，才战胜言笑，现在就要挑战我们了吗？"
        },
        {
          "role": "旅行者",
          "text": "趁这次机会我也交代了吧。"
        },
        {
          "role": "旅行者",
          "text": "其实我也是隐藏的厨神呢。"
        },
        {
          "role": "香菱",
          "text": "才不是！"
        },
        {
          "role": "香菱",
          "text": "你不是很喜欢收集菜谱吗？我看你出门在外四处旅行多半很需要这道菜，才想跟你分享的。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样，我们把人家想得太坏了…"
        },
        {
          "role": "旅行者",
          "text": "香菱真是伟大的厨师。"
        },
        {
          "role": "香菱",
          "text": "哈？现在倒知道拍马屁啦！"
        },
        {
          "role": "刻晴",
          "text": "噗…"
        },
        {
          "role": "刻晴",
          "text": "…看我干什么？不是要去做菜吗，快去啊。"
        },
        {
          "type": "subtitle",
          "text": "制作「美味的辣肉窝窝头」"
        },
        {
          "type": "subtitle",
          "text": "与刻晴对话"
        },
        {
          "role": "派蒙",
          "text": "我们回来啦！"
        },
        {
          "role": "香菱",
          "text": "我和旅行者的份都完成了，来，趁热品尝吧。"
        },
        {
          "role": "刻晴",
          "text": "那我就不客气了。"
        },
        {
          "role": "刻晴",
          "text": "……"
        },
        {
          "role": "刻晴",
          "text": "…………？！"
        },
        {
          "role": "派蒙",
          "text": "怎么了？怎么是这个表情？"
        },
        {
          "role": "刻晴",
          "text": "…我…"
        },
        {
          "role": "刻晴",
          "text": "（这就是…那个味道！）"
        },
        {
          "role": "旅行者",
          "text": "刻晴…？"
        },
        {
          "role": "刻晴",
          "text": "…失礼了。"
        },
        {
          "role": "刻晴",
          "text": "香菱，旅行者，谢谢你们，这就是我想要的味道。"
        },
        {
          "role": "刻晴",
          "text": "非常美味，而且…不可思议，我好像…回到了跟祖父一起的时光。"
        },
        {
          "role": "香菱",
          "text": "真的？太好了！"
        },
        {
          "role": "香菱",
          "text": "刚才没来得及说，其实啊，大师父给我补完菜谱的时候我就发现，这道菜我以前就会做。"
        },
        {
          "role": "派蒙",
          "text": "以前就会做的意思是…没有菜谱也会做？"
        },
        {
          "role": "香菱",
          "text": "嗯。老爸教过我这道菜的做法哦。"
        },
        {
          "role": "派蒙",
          "text": "可是，这道菜不是刻晴从她爷爷笔记上看来的吗？"
        },
        {
          "role": "刻晴",
          "text": "关于这道菜…我想，祖父应该不是菜谱的原作者。"
        },
        {
          "role": "刻晴",
          "text": "我的祖父是璃月著名的土地业大亨，也是一位学者。他酷爱搜集古籍，对很多失传的璃月传统文化也颇有了解。"
        },
        {
          "role": "刻晴",
          "text": "童年时我常陪祖父在书房读书，跟着看了很多典籍，还和他讨论岩王帝君究竟是不是真实存在的人物，这些古籍又有多少可信…"
        },
        {
          "role": "刻晴",
          "text": "祖父说：「书仅仅是桥梁，带我们走向历史。至于你问的那些，就是我们作为后人该去追寻、分辨的事物。」"
        },
        {
          "role": "刻晴",
          "text": "祖父去世后，我长大了，成为了七星的一员。自那时起，对岩王帝君的看法也从传说转化为实质。"
        },
        {
          "role": "刻晴",
          "text": "岩王帝君这个名号对我来说，有时会与祖父的名字连结在一起。看见帝君的名字，我总会想起祖父…想起他书房里那些笔记。"
        },
        {
          "role": "刻晴",
          "text": "这份菜肴的菜谱是我从祖父笔记里誊写下来的。是一道他想试着还原的古菜。可惜那时菜谱不全，他一直没能成功。"
        },
        {
          "role": "刻晴",
          "text": "每次他试作这道菜，都会让我趁热品尝…真怀念，就是这种味道啊。"
        },
        {
          "role": "派蒙",
          "text": "古菜？这道窝窝头，历史这么悠久吗？"
        },
        {
          "role": "香菱",
          "text": "我老爸也是从他老爸那里学来的，据说这道菜代代相传，已经在我们家流传好久了。"
        },
        {
          "role": "香菱",
          "text": "我们家管它叫辣肉窝窝头！是民间小菜，做起来方便又好携带，特别适合在旅途中吃。"
        },
        {
          "role": "锅巴",
          "text": "♪~♪~"
        },
        {
          "role": "香菱",
          "text": "哈哈，看到锅巴就想起来了，我遇到锅巴那天，做的就是这道菜哦！"
        },
        {
          "role": "刻晴",
          "text": "遇到锅巴？"
        },
        {
          "role": "香菱",
          "text": "嗯，我和锅巴是在一个山洞里遇到的！那天我到山洞里躲雨，看见里面有供桌，就放了随身带的辣肉窝窝头上去…"
        },
        {
          "role": "香菱",
          "text": "后来我不小心睡着了，醒来时发现锅巴把辣肉窝窝头全吃了。从那之后它就一直跟着我，变成我的家人啦。"
        },
        {
          "role": "派蒙",
          "text": "喂！别光顾着聊天，你们看那个、那个石头…！"
        },
        {
          "role": "派蒙",
          "text": "爆开了？！"
        },
        {
          "role": "刻晴",
          "text": "这、这是…？！"
        },
        {
          "role": "旅行者",
          "text": "这不是锅巴吗？"
        },
        {
          "role": "香菱",
          "text": "锅巴？！怎么是你！"
        },
        {
          "role": "锅巴",
          "text": "♪？"
        },
        {
          "role": "萍姥姥",
          "text": "看来，你们已经吃上辣肉窝窝头啦。"
        },
        {
          "role": "香菱",
          "text": "大师父！"
        },
        {
          "role": "派蒙",
          "text": "萍姥姥！快、快看啊，这个灶神像是锅巴的样子！"
        },
        {
          "role": "萍姥姥",
          "text": "呵呵，是啊。毕竟，锅巴就是你们要找的灶神——「炉灶之魔神」。"
        },
        {
          "role": "派蒙",
          "text": "锅巴…锅巴是，魔神？！！"
        },
        {
          "role": "锅巴",
          "text": "♪~"
        },
        {
          "role": "萍姥姥",
          "text": "你们问我，是不是足够热闹就能唤醒灶神。我得说，是，却也不是。"
        },
        {
          "role": "萍姥姥",
          "text": "灶神从来都是顺应人们的心愿而行动的亲民之神。对他而言，心愿与心血是不同的东西。"
        },
        {
          "role": "萍姥姥",
          "text": "心血，是技术，是才能，是经验。可唯有心愿，代表着人们心底最纯正的力量。"
        },
        {
          "role": "萍姥姥",
          "text": "厨王争霸赛固然精彩，其中包含的心血却多于心愿。只是心血，还不足以唤醒沉睡的灶神像。"
        },
        {
          "role": "萍姥姥",
          "text": "而刻晴方才吃到那道菜时，心中愿望得到满足。除去答案，她还得到了更为重要的，能让她仿佛与祖父并肩而立的美好回忆。"
        },
        {
          "role": "萍姥姥",
          "text": "这种愿望被满足而爆发出的巨大力量与灶神像共鸣，使得灶神像以从前的模样重现人间。"
        },
        {
          "role": "萍姥姥",
          "text": "当然啦，灶神本人肯定不在神像中。谁让真正的灶神就在大家身旁呢。"
        },
        {
          "role": "锅巴",
          "text": "♪…"
        },
        {
          "role": "萍姥姥",
          "text": "看见自己全盛时期的神像，感觉如何？你看他，还是那么威风凛凛啊。"
        },
        {
          "role": "香菱",
          "text": "全盛时期…等等，锅巴怎么了？难道锅巴以前和现在不一样吗？"
        },
        {
          "role": "萍姥姥",
          "text": "他呀，以前是璃月的土地公，如今是你的锅巴。"
        },
        {
          "role": "萍姥姥",
          "text": "只不过从前那个他所拥有的智慧与力量，全都献给了这片土地。"
        },
        {
          "role": "刻晴",
          "text": "魔神把力量献给土地…我听过这种说法，可是，到底要怎么做？"
        },
        {
          "role": "萍姥姥",
          "text": "一片土地所面临的危险与考验，远比你们想象中更多。大旱、洪涝、暴雨、飓风…地震、海啸、火灾、恶疾。"
        },
        {
          "role": "萍姥姥",
          "text": "璃月大地上，灾难从未彻底消失过。过去不曾出现的麻烦，日后也会诞生。凡人又无仙躯，最受这些因素影响。"
        },
        {
          "role": "萍姥姥",
          "text": "曾经是他陪伴你们走过荒芜的平原，来到港口，造起民房，生起炉火…"
        },
        {
          "role": "萍姥姥",
          "text": "是他亲手点燃璃月第一盏夜灯，让饭菜的香味飘入千家万户。"
        },
        {
          "role": "萍姥姥",
          "text": "你们不再记得他了。但在你们还认得他的时代里，他是最最亲近人的仙人。"
        },
        {
          "type": "subtitle",
          "text": "[https://www.bilibili.com/video/BV1yR4y1p7WX 剧情PV「人间至味」]"
        },
        {
