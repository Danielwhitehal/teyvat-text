{
  "quest_id": 22020,
  "chapter_num": null,
  "chapter_title": "万端珊瑚事件簿·收尾工作",
  "type": "iq",
  "route": "Bantan Sango Case File: Cleanup Work",
  "stories": [
    {
      "story_id": 22020,
      "title": "万端珊瑚事件簿·收尾工作",
      "description": "万端珊瑚侦探社的龙二，似乎想要去做一件事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与龙二对话"
        },
        {
          "role": "龙二",
          "text": "旅行者，居然能在这里遇见你，看来社长说得没错，我们很有缘分。"
        },
        {
          "role": "旅行者",
          "text": "你在这里做什么呢？"
        },
        {
          "role": "龙二",
          "text": "是社长的嘱咐，为上次的工作做最后一点收尾。"
        },
        {
          "role": "龙二",
          "text": "其实就是给同心大人们送一些点心过去，感谢他们的协助罢了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他们应该感谢我们。",
              "dialogues": []
            },
            {
              "text": "不是我们协助了他们吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "龙二",
          "text": "话这么说没错。但这其实也就是借这个借口送点礼物过去，打点打点人情而已。"
        },
        {
          "role": "龙二",
          "text": "毕竟，我们侦探社在将来可能会有很多事需要他们多多照拂。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这绝对是珊瑚教你的。",
              "dialogues": []
            },
            {
              "text": "一听就是珊瑚找的理由…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "龙二",
          "text": "呵呵，没错，你的直觉还是一如既往的敏锐。"
        },
        {
          "role": "旅行者",
          "text": "那你自己怎么想？"
        },
        {
          "role": "龙二",
          "text": "我？天野和安藤…之前也和我共事过，给朋友送点点心，也很正常。"
        },
        {
          "role": "龙二",
          "text": "但是…今天社长还让我去调查另外一件事，从时间上来看，我应该抽不出身了…"
        },
        {
          "role": "龙二",
          "text": "旅行者，能请你帮我把这些点心送给三个人吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "龙二",
                  "text": "多谢你愿意帮忙。"
                }
              ]
            },
            {
              "text": "你去送比较好吧。",
              "dialogues": [
                {
                  "role": "龙二",
                  "text": "还是…社长的委托比较要紧…"
                },
                {
                  "role": "龙二",
                  "text": "之后我会再找时间去拜访那三位的。"
                }
              ]
            }
          ]
        },
        {
          "role": "龙二",
          "text": "这里有三份点心，要送给天野和安藤，还有大和田先生。"
        },
        {
          "role": "旅行者",
          "text": "大和田先生？"
        },
        {
          "role": "龙二",
          "text": "他也是我之前的…同事。在我离开奉行所之前，对我很照顾。"
        },
        {
          "role": "龙二",
          "text": "在之前处理连环盗窃案时，他也在奉行所那边帮了我们一些忙。"
        },
        {
          "role": "龙二",
          "text": "那这件事就拜托你了，旅行者。你把点心送过去之后，我们再回来这里碰头吧。"
        },
        {
          "type": "subtitle",
          "text": "与天野和安藤对话"
        },
        {
          "role": "天野",
          "text": "哦？旅行者，你怎么来了？"
        },
        {
          "role": "旅行者",
          "text": "这是龙二送给你们的。"
        },
        {
          "role": "天野",
          "text": "哦？我看看…这不是「绯樱饼」嘛，龙二这小子还真是客气…"
        },
        {
          "role": "天野",
          "text": "喂，安藤，你也别这么警惕了嘛。虽然这位旅行者是外国人，但他不是刚帮了我们吗？"
        },
        {
          "role": "天野",
          "text": "亏那小子还记得我们喜欢吃的东西，没白和他同事一场…"
        },
        {
          "role": "旅行者",
          "text": "龙二之前和你们共事过？"
        },
        {
          "role": "天野",
          "text": "啊？他没和你提过吗？我俩之前确实和他共事过很短一段时间。"
        },
        {
          "role": "天野",
          "text": "不过，那家伙不知道为什么，突然卷入了一个事件里。"
        },
        {
          "role": "天野",
          "text": "虽然最后托珊瑚的福，把那个真正的犯人揪了出来，帮龙二脱了罪。但那家伙在那之后也离开奉行所，去珊瑚那边工作了。"
        },
        {
          "role": "天野",
          "text": "除了这些之外，再多的我也不知道了…"
        },
        {
          "role": "安藤",
          "text": "好了，说到这里就可以了。"
        },
        {
          "role": "天野",
          "text": "唔，也是。不过那小子在珊瑚那边过得可比我们滋润太多了。"
        },
        {
          "role": "天野",
          "text": "要是可能的话，我也…"
        },
        {
          "role": "安藤",
          "text": "我说你啊…"
        },
        {
          "role": "天野",
          "text": "咳！不说了不说了，谢谢你旅行者，这些点心我就收下了。"
        },
        {
          "role": "天野",
          "text": "记得帮我给龙二和珊瑚问个好。"
        },
        {
          "type": "subtitle",
          "text": "与大和田对话"
        },
        {
          "role": "大和田",
          "text": "喔？你是…那位金发的旅行者吧，我听天野提起过你。"
        },
        {
          "role": "大和田",
          "text": "怎么，找我有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "这是龙二送给你的。"
        },
        {
          "role": "大和田",
          "text": "哦呀，居然是「绯樱饼」，这可不能随随便便就吃掉，得找个合适的地方好好品尝。"
        },
        {
          "role": "大和田",
          "text": "上杉，稍微在这里代我一下。如果有人来找我，就让他们等一下吧。"
        },
        {
          "role": "上杉",
          "text": "大和田先生，现在可是上班时间…"
        },
        {
          "role": "大和田",
          "text": "哈哈哈，没关系，只不过是出去透透气而已，很快就回来。"
        },
        {
          "role": "上杉",
          "text": "唉…好吧，但您可要快点回来，要是哪位大人突然过来…"
        },
        {
          "role": "大和田",
          "text": "放心吧，奉行所刚刚破了一桩案子，就算是来人，应该也是过来嘉奖的。"
        },
        {
          "role": "大和田",
          "text": "那么就交给你，上杉。"
        },
        {
          "role": "大和田",
          "text": "旅行者，和我一起出去转转吧，我知道一个地方，很适合悠闲地吃掉这些点心。"
        },
        {
          "type": "subtitle",
          "text": "跟随大和田"
        },
        {
          "role": "大和田",
          "text": "唔…这个地方还不错吧。我可是经常来这里透气的…"
        },
        {
          "role": "大和田",
          "text": "景色不错，空气也很新鲜。"
        },
        {
          "role": "大和田",
          "text": "有什么想问的，就在这里问吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你也是龙二之前的同事？",
              "dialogues": [
                {
                  "role": "大和田",
                  "text": "是龙二告诉你的吗？没错，之前龙二确实和我共事过。"
                }
              ]
            },
            {
              "text": "龙二为什么会离开奉行所？",
              "dialogues": [
                {
                  "role": "大和田",
                  "text": "他之所以离开奉行所，当然是他自己的选择。"
                }
              ]
            }
          ]
        },
        {
          "role": "大和田",
          "text": "当年发生的那件事，不知道龙二有没有和你提过，你知不知道。"
        },
        {
          "role": "大和田",
          "text": "简单来说的话，就是龙二那小子因为太冲动，落进了人家已经设好的陷阱，成了替罪羊。"
        },
        {
          "role": "大和田",
          "text": "就算是我出来为他担保，负责判决的人还是执意定他的罪。"
        },
        {
          "role": "大和田",
          "text": "虽然我也拜托了很多人调查，但最后要么无功而返，要么反过来告诉我，不要再接着查下去了。"
        },
        {
          "role": "大和田",
          "text": "呵呵，当时的我…怎么说呢，也听从了告诫，没有再查下去。"
        },
        {
          "role": "大和田",
          "text": "这件事和「龙二是冤枉的」这件事一样，都是众人皆知的秘密，所以告诉你了也没关系。"
        },
        {
          "role": "旅行者",
          "text": "既然大家都知道…"
        },
        {
          "role": "大和田",
          "text": "正因为所有人都意识到「大家都知道」，所以反而没有人敢再插手。"
        },
        {
          "role": "大和田",
          "text": "不过，还好有一个「什么都不知道」的侦探恰好来奉行所办事，对这件案子产生了兴趣。"
        },
        {
          "role": "大和田",
          "text": "在这位侦探的行动下，那桩案子最终得以侦破，龙二也洗清了冤屈。"
        },
        {
          "role": "大和田",
          "text": "然后，龙二就离开了奉行所，从此在那个侦探的手底下做事。故事到这里就结束了。"
        },
        {
          "role": "旅行者",
          "text": "你为什么告诉我这些？"
        },
        {
          "role": "大和田",
          "text": "是谁让你把这份礼物送给我的？"
        },
        {
          "role": "旅行者",
          "text": "是龙二。"
        },
        {
          "role": "大和田",
          "text": "龙二之所以会送礼物过来给我，想必也是「社长的嘱咐」吧。"
        },
        {
          "role": "大和田",
          "text": "以龙二的性格，如果珊瑚让他亲自送礼物过来，那我就算是住在火海里，他也会把礼物毫发无损地亲自送过来。"
        },
        {
          "role": "大和田",
          "text": "如果龙二让你转交礼物给我，那么一定也是珊瑚嘱咐他这么做的。"
        },
        {
          "role": "旅行者",
          "text": "是珊瑚想让我知道这件事？"
        },
        {
          "role": "大和田",
          "text": "哈哈哈，你的反应倒也不慢。现在你在这里，几乎就相当于珊瑚在和我说：「我有了个新帮手」。"
        },
        {
          "role": "大和田",
          "text": "看来，她对当年的事还耿耿于怀。"
        },
        {
          "role": "大和田",
          "text": "也难怪，毕竟…到现在她也没有找到真正设下那个陷阱的人…"
        },
        {
          "role": "大和田",
          "text": "好了，能告诉你的事，我已经全都告诉你了。到底要不要上珊瑚的这艘船，你就自己决定吧。"
        },
        {
          "role": "大和田",
          "text": "哦对了，你回去的时候，顺便帮我谢谢龙二的「绯樱饼」吧，我一直很喜欢吃这个。"
        },
        {
          "type": "subtitle",
          "text": "与大和田对话"
        },
        {
          "type": "subtitle",
          "text": "与龙二对话"
        },
        {
          "role": "龙二",
          "text": "那这件事就拜托你了，旅行者。你把点心送过去之后，我们再回来这里碰头吧。"
        },
        {
          "role": "龙二",
          "text": "辛苦你了，旅行者，礼物都…交给他们了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这都是珊瑚让你做的？",
              "dialogues": []
            },
            {
              "text": "你直接把事情告诉我就好…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "龙二",
          "text": "你…都发现了？抱歉…让你去送礼物这件事，确实是社长的嘱咐。"
        },
        {
          "role": "龙二",
          "text": "社长说，想要彻底解决当年我的那桩案件，把幕后的真凶揪出来，你是不可或缺的帮手。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这案子还没有彻底解决吗？",
              "dialogues": [
                {
                  "role": "龙二",
                  "text": "没有。社长说，当年她找到那个「犯人」时，一切都…太完美了。"
                },
                {
                  "role": "龙二",
                  "text": "在社长开展调查后，线索，动机和证据几乎都是自己跑到了社长手里，而且都齐齐指向那个人。"
                },
                {
                  "role": "龙二",
                  "text": "虽然最后奉行所将那个人作为犯人处理，但社长始终认为，真正的犯人另有其人。"
                }
              ]
            },
            {
              "text": "这案子是珊瑚说的「完美犯罪」？",
              "dialogues": [
                {
                  "role": "龙二",
                  "text": "是的。社长说，当年她找到那个「犯人」时，一切都…太完美了。"
                },
                {
                  "role": "龙二",
                  "text": "在社长开展调查后，线索，动机和证据几乎都是自己跑到了社长手里，而且都齐齐指向那个人。"
                },
                {
                  "role": "龙二",
                  "text": "虽然最后奉行所将那个人作为犯人处理，但社长始终认为，真正的犯人另有其人。"
                }
              ]
            }
          ]
        },
        {
          "role": "龙二",
          "text": "我想，她之所以愿意把我收进社里工作，一定也是为了找到侦破那桩案子的机会吧。"
        },
        {
          "role": "旅行者",
          "text": "但是，我又能帮上什么…"
        },
        {
          "role": "龙二",
          "text": "社长的心思…我从来都猜不透。但她有一次和我说，或许是因为她一直待在稻妻，眼界已经变得狭窄…"
        },
        {
          "role": "龙二",
          "text": "如果能有一个见识广阔，又无拘无束的人愿意来帮忙，说不定这桩案子的侦破工作就能有突破性的进展。"
        },
        {
          "role": "龙二",
          "text": "旅行者，或许社长觉得，你就是那个能帮她忙的人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我也算是「侦探」了？",
              "dialogues": [
                {
                  "role": "龙二",
                  "text": "如果你愿意帮忙的话，那是当然了"
                }
              ]
            },
            {
              "text": "这桩案子，报酬不少吧？",
              "dialogues": [
                {
                  "role": "龙二",
                  "text": "那我可说不准，但是…一定会是一笔足够让你满意的报酬。"
                }
              ]
            }
          ]
        },
        {
          "role": "龙二",
          "text": "但无论如何，你帮了我们侦探社这么多忙，这一次的报酬还请你先收下。"
        },
        {
          "role": "旅行者",
          "text": "这些话，也是珊瑚教的？"
        },
        {
          "role": "龙二",
          "text": "不，这一次，这些话都是我自己想的。"
        },
        {
          "role": "龙二",
          "text": "再次感谢你的协助。如果你愿意的话，还请多来我们那边转转吧，社长应该…也会十分欢迎你的。"
        }
      ]
    }
  ]
}