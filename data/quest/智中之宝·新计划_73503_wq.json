{
  "quest_id": 73503,
  "chapter_num": null,
  "chapter_title": "智中之宝·新计划",
  "type": "wq",
  "route": "Treasure of Wisdom: A New Plan",
  "stories": [
    {
      "story_id": 73503,
      "title": "智中之宝·新计划",
      "description": "喜爱谜语的学者德鲁苏，最近似乎又有了新想法…",
      "dialogues": [
        {
          "role": "装有谜语的题箱",
          "text": "「试探浅海的智慧之枝。」"
        },
        {
          "role": "装有谜语的题箱",
          "text": "「擅长水珠贸易的智慧植物。」"
        },
        {
          "role": "装有谜语的题箱",
          "text": "「有智归海处，宝藏侧帆间。」"
        },
        {
          "role": "带有谜语的题板",
          "text": "「奔流上，绿树下。」"
        },
        {
          "role": "德鲁苏",
          "text": "唔，这个地方不错…"
        },
        {
          "role": "旅行者",
          "text": "你又在研究谜语吗？"
        },
        {
          "role": "德鲁苏",
          "text": "旅行者！你来得正好，我正准备设计一段全新的连续谜题呢。"
        },
        {
          "role": "德鲁苏",
          "text": "这里的地形有点复杂。你看，港口的一侧有一根「圣树」的巨大根系入水。"
        },
        {
          "role": "德鲁苏",
          "text": "另一侧则是一片巨大的荷叶，和一堆待出港的船只。"
        },
        {
          "role": "德鲁苏",
          "text": "旅行者，你觉得这段谜语以哪一边的景物为主题最好？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还是从根系入手吧。",
              "dialogues": [
                {
                  "role": "德鲁苏",
                  "text": "是吗？「圣树」的巨大根系确实很显眼，作为谜语的「切入点」也很容易被感知到。"
                },
                {
                  "role": "德鲁苏",
                  "text": "好！那我就以根系为主题写一道谜语。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "嘿嘿嘿，我来写一段。",
                      "dialogues": []
                    },
                    {
                      "text": "嘿嘿嘿，交给我吧。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "旅行者",
                  "text": "嘿嘿嘿，交给我吧。"
                },
                {
                  "role": "派蒙",
                  "text": "我说，你怎么笑得这么开心啊…"
                },
                {
                  "role": "旅行者",
                  "text": "写好了，给你看看。"
                },
                {
                  "role": "德鲁苏",
                  "text": "「有智归海处，宝藏侧帆间。」"
                },
                {
                  "role": "德鲁苏",
                  "text": "读起来真不错！而且这道谜语也很容易让人联想到「港口」…"
                },
                {
                  "role": "德鲁苏",
                  "text": "和「有智归海」相搭配，也不难解答出这个地点和教令院或者须弥城有关…"
                },
                {
                  "role": "德鲁苏",
                  "text": "没想到你还有这方面的才能。"
                },
                {
                  "role": "德鲁苏",
                  "text": "稍等一下，我把这道谜语给贴在容易被发现的地方…"
                },
                {
                  "role": "派蒙",
                  "text": "欸？就贴在这附近？可谜语所说的位置也不远啊？说不定马上就会被发现的。"
                },
                {
                  "role": "德鲁苏",
                  "text": "哈哈哈，我这也是在给解谜的人划定解谜范围啊。"
                },
                {
                  "role": "德鲁苏",
                  "text": "要是不这么做，那解谜的范围可就太大了。"
                },
                {
                  "role": "？？？",
                  "text": "德鲁苏开始布置起了谜语…"
                },
                {
                  "role": "德鲁苏",
                  "text": "好了，这里的谜语就这样吧，我们去下一个地方。"
                },
                {
                  "role": "派蒙",
                  "text": "欸？还有下一个地方啊…"
                }
              ]
            },
            {
              "text": "莲叶和船只很有意思。",
              "dialogues": [
                {
                  "role": "德鲁苏",
                  "text": "确实…把这两者联系起来的话，也许有着别样的趣味性。"
                },
                {
                  "role": "德鲁苏",
                  "text": "没问题，我就以这个主题来写一道谜语好了。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "嘿嘿嘿，我来写一段。",
                      "dialogues": []
                    },
                    {
                      "text": "嘿嘿嘿，交给我吧。",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "这些都太简单了！",
              "dialogues": [
                {
                  "role": "德鲁苏",
                  "text": "太简单了？那你有什么想法吗？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "嘿嘿嘿，我来写一段。",
                      "dialogues": []
                    },
                    {
                      "text": "嘿嘿嘿，交给我吧。",
                      "dialogues": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "嘿嘿嘿，我来写一段。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嘿嘿嘿，我来写一段。",
              "dialogues": []
            },
            {
              "text": "嘿嘿嘿，交给我吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "带有谜语的题板",
          "text": "「思维自由奔流，智慧驻岸思考。」"
        },
        {
          "role": "带有谜语的题板",
          "text": "「青伞怀宝望珠帘。」"
        },
        {
          "type": "subtitle",
          "text": "与德鲁苏一起布置谜题"
        },
        {
          "role": "德鲁苏",
          "text": "好！就在这里布置第二个谜题吧，只要解开这个谜题，就能找到最终的宝箱。"
        },
        {
          "role": "德鲁苏",
          "text": "我准备把最终的宝藏设置在…那里。"
        },
        {
          "role": "派蒙",
          "text": "欸…"
        },
        {
          "role": "旅行者",
          "text": "呃…"
        },
        {
          "role": "派蒙",
          "text": "这不就是一个普普通通的小山坡，旁边有个普普通通的小瀑布吗？"
        },
        {
          "role": "德鲁苏",
          "text": "没错！但它马上就会因为我们的谜语而不普通了。"
        },
        {
          "role": "德鲁苏",
          "text": "好了，旅行者，你对这一道谜语有什么建议呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别折腾了，直接点吧…",
              "dialogues": [
                {
                  "role": "德鲁苏",
                  "text": "欸？是这样吗？唔…解谜的人翻山越岭到这里来，确实会感到疲惫啊…"
                },
                {
                  "role": "德鲁苏",
                  "text": "行，那就简单点吧。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "不能说是特别学过…",
                      "dialogues": [
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "不能说是特别学过…",
                              "dialogues": []
                            },
                            {
                              "text": "只能说是熟能生巧…",
                              "dialogues": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "只能说是熟能生巧…",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "用瀑布为主题吧。",
              "dialogues": [
                {
                  "role": "德鲁苏",
                  "text": "唔…瀑布确实是一个很明确的主题。"
                },
                {
                  "role": "德鲁苏",
                  "text": "没问题，就以它为主题好了。而且这最后一道谜题的难度…就稍微下调一点吧。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "不能说是特别学过…",
                      "dialogues": []
                    },
                    {
                      "text": "只能说是熟能生巧…",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "嘿嘿嘿，我来写一段。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂！你笑得越来越开心了啊！"
                },
                {
                  "role": "旅行者",
                  "text": "写好了。"
                },
                {
                  "role": "德鲁苏",
                  "text": "「青伞怀宝望珠帘。」"
                },
                {
                  "role": "德鲁苏",
                  "text": "呃…这谜语，读起来还真是特别…你在哪里专门学过这方面的学问吗？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "不能说是特别学过…",
                      "dialogues": []
                    },
                    {
                      "text": "只能说是熟能生巧…",
                      "dialogues": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "只能说是熟能生巧…"
        },
        {
          "role": "德鲁苏",
          "text": "原来如此，不愧是旅行者啊，真是博闻广识…好，我这就把你写的谜语给布置下去。"
        },
        {
          "role": "？？？",
          "text": "德鲁苏开始布置起了谜语…"
        },
        {
          "role": "德鲁苏",
          "text": "好了！这个小告示牌应该够显眼了。"
        },
        {
          "role": "德鲁苏",
          "text": "那我们现在就去布置最后的宝箱吧。"
        },
        {
          "type": "subtitle",
          "text": "与德鲁苏一起布置宝藏"
        },
        {
          "role": "德鲁苏",
          "text": "这就是最后一个宝箱了，这次不用写谜语了。"
        },
        {
          "role": "德鲁苏",
          "text": "不过，到底放什么比较好呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "够值钱的东西。",
              "dialogues": [
                {
                  "role": "德鲁苏",
                  "text": "有道理，这宝箱里东西的价值，至少要对得起解谜者一路的辛苦思辨啊。"
                },
                {
                  "role": "德鲁苏",
                  "text": "说到价值，那最直观的当然就是摩拉了，唔…我多放点摩拉好了…"
                }
              ]
            },
            {
              "text": "有实用价值的东西。",
              "dialogues": [
                {
                  "role": "德鲁苏",
                  "text": "实用价值？呃…什么东西比较有实用价值？"
                },
                {
                  "role": "德鲁苏",
                  "text": "对了！我前几天刚从别人那里拿到了一份菜谱，就放在这宝箱里当做奖励吧。"
                }
              ]
            },
            {
              "text": "这段思辨的经历就是最好的宝物。",
              "dialogues": [
                {
                  "role": "德鲁苏",
                  "text": "哈哈哈哈哈，你说得没错！太对了！这段辛苦的思辨确实是无价的宝贵经历！和它相比，其他的东西几乎毫无价值。"
                },
                {
                  "role": "派蒙",
                  "text": "根本就不对！好好地放一点摩拉或者菜谱啊！实在不行放点蔬菜水果也可以，别什么都不放啊！"
                },
                {
                  "role": "德鲁苏",
                  "text": "开个玩笑，开个玩笑，我肯定会放一些东西当做是奖励的。"
                }
              ]
            }
          ]
        },
        {
          "role": "德鲁苏",
          "text": "好了，这段「谜语」就算是布置完了，多谢你帮忙，旅行者。"
        },
        {
          "role": "德鲁苏",
          "text": "这些东西给你，就当做是报酬吧。"
        },
        {
          "role": "德鲁苏",
          "text": "唉，我本来打算和你再深入讨论一下谜语的，但我还得回教令院处理一些事情。"
        },
        {
          "role": "德鲁苏",
          "text": "如果你以后在旅途中发现了新奇的谜语，或者被谜题难住了，一定要记得过来找我。"
        },
        {
          "role": "德鲁苏",
          "text": "我们可以一起详细地讨论它们，然后…再把它们重新布置给冒险家们，哈哈哈！"
        },
        {
          "role": "德鲁苏",
          "text": "那么我就先告辞了，旅行者，祝你接下来的旅途一路顺风。"
        },
        {
          "role": "德鲁苏",
          "text": "希望那个叫娜赞的盗宝团不要惹出什么大麻烦…"
        }
      ]
    }
  ]
}