{
  "quest_id": 73233,
  "chapter_num": null,
  "chapter_title": "沙上花",
  "type": "wq",
  "route": "Blooming Sands",
  "stories": [
    {
      "story_id": 73233,
      "title": "沙上花",
      "description": "阿如村的里夫似乎正在烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与里夫对话"
        },
        {
          "type": "subtitle",
          "text": "与阿扎莱对话"
        },
        {
          "role": "阿扎莱",
          "text": "唉，还有一批货物呢…"
        },
        {
          "role": "旅行者",
          "text": "关于里夫的货物…"
        },
        {
          "role": "阿扎莱",
          "text": "你是说里夫找我订的货物吗？我刚接了一批货，里面正好有他要的东西。"
        },
        {
          "role": "阿扎莱",
          "text": "不过，他买的东西可不少啊…你是帮他来拿货的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很，很重吗？",
              "dialogues": []
            },
            {
              "text": "有，有多少…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿扎莱",
          "text": "除了那个花盆之外，还有各类种子，肥料和园艺用品…"
        },
        {
          "role": "阿扎莱",
          "text": "这些东西加起来可不轻啊，你…你一个人搬得过去吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我自有办法…",
              "dialogues": []
            },
            {
              "text": "我都答应人家了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿扎莱",
          "text": "这样啊…那行，我给你把东西都包好。真是辛苦你走这一趟了…"
        },
        {
          "type": "subtitle",
          "text": "将东西带回给里夫"
        },
        {
          "role": "里夫",
          "text": "旅行者！你把东西拿回来了吗？"
        },
        {
          "type": "subtitle",
          "text": "将东西带回给里夫"
        },
        {
          "role": "里夫",
          "text": "唉，真希望内尔敏能快点好起来…"
        },
        {
          "role": "里夫",
          "text": "就是这些，太谢谢你了，旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是要开花店吗…",
              "dialogues": []
            },
            {
              "text": "你买这么多东西干啥！？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "里夫",
          "text": "哎呀，这不是…一次性买多点，免得总是出去嘛…"
        },
        {
          "role": "里夫",
          "text": "你先在旁边休息一下吧！我得先把种子种下去，再施点肥料…"
        },
        {
          "role": "？？？",
          "text": "里夫开始摆弄起了花盆…"
        },
        {
          "role": "里夫",
          "text": "好了！这样就可以了，内尔敏只需要给这盆花浇浇水就行。"
        },
        {
          "role": "里夫",
          "text": "旅行者，能不能…再请你帮我把这盆花送去给内尔敏…"
        },
        {
          "role": "旅行者",
          "text": "你自己怎么不去？"
        },
        {
          "role": "里夫",
          "text": "我得盯着这个路口啊，要是有粮食或者物资运过来，我还得去叫村里的人过来接收物资。"
        },
        {
          "role": "里夫",
          "text": "周围这温度…你应该已经感觉到了。要是接收速度太慢，物资说不定都会被晒坏。"
        },
        {
          "role": "里夫",
          "text": "拜托你啦旅行者，内尔敏住得离这里不远，你就把这一盆花送去给她就好，其余的东西我会想办法运回去。"
        },
        {
          "type": "subtitle",
          "text": "将花盆带给内尔敏"
        },
        {
          "type": "subtitle",
          "text": "与内尔敏对话"
        },
        {
          "role": "？？？",
          "text": "屋内的某人似乎听到了动静…"
        },
        {
          "role": "内尔敏",
          "text": "你好，请问有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于这盆花…"
        },
        {
          "role": "内尔敏",
          "text": "这是…里夫送给我的？"
        },
        {
          "role": "内尔敏",
          "text": "这盆里种着花吗？真的？谢谢你帮他送来，我很喜欢…"
        },
        {
          "role": "内尔敏",
          "text": "不过…我真的能养好它吗…"
        },
        {
          "role": "旅行者",
          "text": "你之前没养过花吗？"
        },
        {
          "role": "内尔敏",
          "text": "我…我不擅长照顾植物，之前好多盆绿植都被我养得枯萎了…"
        },
        {
          "role": "内尔敏",
          "text": "这盆花一定更娇贵，要是我又把它给养枯的话…"
        },
        {
          "role": "内尔敏",
          "text": "唔，不行，既然花已经到我手上了，我就要好好照顾它才行！"
        },
        {
          "role": "内尔敏",
          "text": "库尔苏姆奶奶一定知道怎么解决这个问题…"
        },
        {
          "type": "subtitle",
          "text": "向里夫回报"
        },
        {
          "role": "里夫",
          "text": "旅行者，你回来了，真是辛苦你了…内尔敏怎么说？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她担心自己不会种花。",
              "dialogues": [
                {
                  "role": "里夫",
                  "text": "这个…我会陪着她研究这事的啦，实在不行就去找人问问…"
                },
                {
                  "role": "里夫",
                  "text": "要是真不行，我…我就…我就去找点容易种，又容易成活的东西…"
                }
              ]
            },
            {
              "text": "你之前没送过她花？",
              "dialogues": [
                {
                  "role": "里夫",
                  "text": "也不能说没送过吧…只不过前几次我托人买的都是已经长成的花。等送到村里来的时候，那些花已经快被晒干了…"
                },
                {
                  "role": "里夫",
                  "text": "所以这次，我决定直接送内尔敏一盆刚种下的花。"
                }
              ]
            }
          ]
        },
        {
          "role": "里夫",
          "text": "咳，总之…谢谢你帮我的忙，旅行者，这些报酬请你收下。"
        },
        {
          "role": "里夫",
          "text": "等会我就把其他的东西给内尔敏拿过去。"
        },
        {
          "role": "里夫",
          "text": "等等，这些园艺工具没附带使用说明书吗？我完全不知道怎么用它们啊！"
        }
      ]
    }
  ]
}