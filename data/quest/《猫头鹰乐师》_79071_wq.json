{
  "quest_id": 79071,
  "chapter_num": null,
  "chapter_title": "《猫头鹰乐师》",
  "type": "wq",
  "route": "\"Owl Musician\"",
  "stories": [
    {
      "story_id": 79071,
      "title": "《猫头鹰乐师》",
      "description": "在星轨王城里，你遇见了一个严肃的守卫…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与埃洛夫对话"
        },
        {
          "role": "埃洛夫",
          "text": "欢迎来到星轨王城，旅行者，派蒙小姐。"
        },
        {
          "role": "埃洛夫",
          "text": "我已经从同僚那边听说过了你们的名字和事迹，二位的确是勇武之人。"
        },
        {
          "role": "埃洛夫",
          "text": "如果我不是必须要负责守卫的训练事宜，也想着与二位切磋一番。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是王城的守卫？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "埃洛夫",
          "text": "正是。我等奉城主大人之命，守卫星轨王城，维护其安宁和平。"
        },
        {
          "role": "埃洛夫",
          "text": "而我的职责，则是锻炼守卫，使其武力配得上自己的职责。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以，这后面的门就是训练场？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "埃洛夫",
          "text": "果然敏锐。这个入口通往一处秘境，前段时间我们方才改造完成。"
        },
        {
          "role": "埃洛夫",
          "text": "在这个训练场中，受训者必须按照特定的节奏挥剑。战斗时，场地的照明环境也会不断变化。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好严格的训练…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "听起来好复杂…战斗时还要按照特定的节奏吗？"
        },
        {
          "role": "埃洛夫",
          "text": "这一环节，其实是来源于一篇名为《猫头鹰乐师》的故事。"
        },
        {
          "role": "埃洛夫",
          "text": "前段时间，这篇故事在守卫之中颇为流行。不少人看得开心，就连训练也忘了参加，甚至还有人耽误了日常巡逻的时间。"
        },
        {
          "role": "埃洛夫",
          "text": "既然大家都如此喜爱这本书，那我觉得，将这故事的元素加入训练之中，大家一定能更喜爱训练吧。"
        },
        {
          "role": "埃洛夫",
          "text": "从结果上来说，训练效果的确显著。至少…没有人再因为个人原因耽误巡逻了。"
        },
        {
          "role": "埃洛夫",
          "text": "呵呵…不知道二位对我们的训练有没有兴趣？"
        },
        {
          "role": "埃洛夫",
          "text": "我想，以二位的勇武之能，训练场中的各类考验一定都不在话下。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要试试看！",
              "dialogues": [
                {
                  "role": "埃洛夫",
                  "text": "好，勇气可嘉，请您踏入秘境吧。"
                }
              ]
            },
            {
              "text": "还有别的事…",
              "dialogues": [
                {
                  "role": "埃洛夫",
                  "text": "无妨。二位可以有空再来。我这段时间会一直守在这里。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（埃洛夫）"
        },
        {
          "role": "埃洛夫",
          "text": "您是想要来尝试一下我们的训练吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要试试看！",
              "dialogues": [
                {
                  "role": "埃洛夫",
                  "text": "好，勇气可嘉，请您踏入秘境吧。"
                }
              ]
            },
            {
              "text": "关于《猫头鹰乐师》…",
              "dialogues": [
                {
                  "role": "埃洛夫",
                  "text": "您对这故事也感兴趣？好吧，我简短为您讲述一下。"
                },
                {
                  "role": "埃洛夫",
                  "text": "在故事中，描述了一个与怪异魔物战斗着的王国。"
                },
                {
                  "role": "埃洛夫",
                  "text": "…抱歉，我就省略大部分的战斗能力和魔法效果描写了。"
                },
                {
                  "role": "埃洛夫",
                  "text": "这篇故事的前三分之一都在讲述各个卫兵的特殊能力…也许守卫们就是被这个吸引住了。"
                },
                {
                  "role": "埃洛夫",
                  "text": "在故事的后半段，魔物们用出了最后的手段，他们用「黑夜」侵蚀了整个王国，自己则在黑暗中发起攻击。"
                },
                {
                  "role": "埃洛夫",
                  "text": "卫兵们被迫退到了最后的堡垒，也就是王宫之中。但外界的黑夜还在继续侵蚀，王宫里的灯火也逐渐熄灭。"
                },
                {
                  "role": "埃洛夫",
                  "text": "随着最后的灯光熄灭。所有人都做好了最后一搏的准备，无论如何，至少要奋战到最后。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "（继续听下去。）",
                      "dialogues": [
                        {
                          "role": "埃洛夫",
                          "text": "突然，王宫里响起了扑扇翅膀的声音，有一群猫头鹰从窗外飞了进来。"
                        },
                        {
                          "role": "埃洛夫",
                          "text": "它们本来是王宫乐师的朋友，在魔物入侵时，乐师知道王宫即将成为战场，就将它们送去了森林——现在猫头鹰们回来了。"
                        },
                        {
                          "role": "埃洛夫",
                          "text": "这群能看穿黑暗的战士们在王宫里盘旋，用叫声告诉乐师敌人究竟藏在何处。"
                        },
                        {
                          "role": "埃洛夫",
                          "text": "乐师坐在了管风琴前，这台管风琴曾经为无数场舞会奏乐，它足够强大，能将音符送到王宫的每一个角落。"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "（继续听下去。）",
                              "dialogues": [
                                {
                                  "role": "埃洛夫",
                                  "text": "王宫里的战士们在管风琴的轰鸣声里奋起战斗，这次他们知道该向何处挥剑了。"
                                },
                                {
                                  "role": "埃洛夫",
                                  "text": "乐师弹奏着管风琴，每隔一段时间就停下音乐，聆听猫头鹰的报信，而战士们也会在音乐暂歇时结成防御阵型。"
                                },
                                {
                                  "role": "埃洛夫",
                                  "text": "战士们击退了魔物，他们以王宫为堡垒，在猫头鹰和乐师的带领下不断击退黑夜中的魔物。"
                                },
                                {
                                  "role": "埃洛夫",
                                  "text": "最后，王宫重归和平。而那段指引了战士们作战的音乐，也广为传诵…故事就到此结束了。"
                                }
                              ]
                            },
                            {
                              "text": "（还是先不听了…）",
                              "dialogues": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "（还是先不听了…）",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "还有别的事…",
              "dialogues": [
                {
                  "role": "埃洛夫",
                  "text": "无妨。你可以有空再来。我这段时间会一直守在这里。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          19,
          21
        ]
      ]
    }
  ]
}