{
  "quest_id": 22002,
  "chapter_num": null,
  "chapter_title": "璃月港，有海盗！",
  "type": "iq",
  "route": "Pirate Invasion, in Liyue Harbor!",
  "stories": [
    {
      "story_id": 22002,
      "title": "璃月港，有海盗！",
      "description": "有一群孩子想要玩一场海盗游戏…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与璐璐、阿飞、小蒙对话"
        },
        {
          "role": "小蒙",
          "text": "璐璐，怎么又是我做船长啊。"
        },
        {
          "role": "璐璐",
          "text": "因为小蒙做船长的时候，我们才玩得最开心呀。"
        },
        {
          "role": "阿飞",
          "text": "璐璐觉得没问题，那我…那我也没问题…"
        },
        {
          "role": "旅行者",
          "text": "你们在做什么？"
        },
        {
          "role": "璐璐",
          "text": "大哥哥，我们正准备玩游戏呢。"
        },
        {
          "role": "璐璐",
          "text": "小蒙是船长，阿飞是服务员，我是个有钱的商人。"
        },
        {
          "role": "璐璐",
          "text": "只缺一个海盗来抢劫我们啦！"
        },
        {
          "role": "璐璐",
          "text": "你愿意扮海盗，来陪我们玩吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "谢谢大哥哥！"
                }
              ]
            },
            {
              "text": "我想做个好人…",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "只是玩个游戏啦，我知道大哥哥一定是个好人。"
                }
              ]
            }
          ]
        },
        {
          "role": "璐璐",
          "text": "好啦，大哥哥准备好了，就来找我吧。"
        },
        {
          "type": "subtitle",
          "text": "与「富商」璐璐对话"
        },
        {
          "role": "旅行者",
          "text": "准备好了。"
        },
        {
          "role": "璐璐",
          "text": "那我们就开始玩吧！"
        },
        {
          "role": "璐璐",
          "text": "那么，就请大哥哥开始吧。"
        },
        {
          "role": "？？？",
          "text": "你好，抢劫。"
        },
        {
          "role": "小蒙",
          "text": "哼，大白天的就来抢劫，千岩军的叔叔们就在旁边！"
        },
        {
          "role": "阿飞",
          "text": "璐璐，快过来，我们快点跑…"
        },
        {
          "role": "璐璐",
          "text": "你好，你是来抢什么的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "呃，应该是钱…",
              "dialogues": []
            },
            {
              "text": "来抢你…",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "大哥哥，虽然是玩游戏，但是也要注意喔。"
                },
                {
                  "role": "璐璐",
                  "text": "你看，旁边千岩军的叔叔们，都往这边看啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "璐璐",
          "text": "可是我没多少钱可以抢…"
        },
        {
          "role": "璐璐",
          "text": "爸爸说，在船上，最值钱的东西是商人们运的货。"
        },
        {
          "role": "璐璐",
          "text": "唔，这样吧。大哥哥，你帮我去找点值钱的东西回来吧。"
        },
        {
          "role": "璐璐",
          "text": "这样子，我就有能被抢走的东西啦！"
        },
        {
          "role": "璐璐",
          "text": "我想想…那么，你就找点莲蓬回来吧。"
        },
        {
          "role": "璐璐",
          "text": "我们三个人都很喜欢吃莲蓬，大哥哥作为一个大坏蛋海盗，抢莲蓬最合适不过啦。"
        },
        {
          "type": "subtitle",
          "text": "找到莲蓬"
        },
        {
          "type": "subtitle",
          "text": "与璐璐对话"
        },
        {
          "role": "璐璐",
          "text": "你准备好了吗？"
        },
        {
          "role": "璐璐",
          "text": "你找到莲蓬了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了。"
        },
        {
          "role": "璐璐",
          "text": "谢谢大哥哥！"
        },
        {
          "role": "璐璐",
          "text": "小蒙，阿飞，快点过来吃莲蓬啦。"
        },
        {
          "role": "派蒙",
          "text": "喂…喂，我们还是在抢劫吧…"
        },
        {
          "role": "璐璐",
          "text": "喔，对啊。那这些钱和东西给你们。"
        },
        {
          "role": "璐璐",
          "text": "大哥哥扮海盗真厉害，从一个小孩子手里抢走了这么多东西呢。"
        },
        {
          "role": "派蒙",
          "text": "总感觉这孩子…话里有话…"
        },
        {
          "role": "璐璐",
          "text": "这次辛苦大哥哥啦，下次也要陪我们一起玩呀。"
        }
      ]
    }
  ]
}