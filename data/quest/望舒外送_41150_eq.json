{
  "quest_id": 41150,
  "chapter_num": null,
  "chapter_title": "望舒外送",
  "type": "eq",
  "route": "Wangshu Take-Away",
  "stories": [
    {
      "story_id": 41150,
      "title": "望舒外送",
      "description": "璃月的望舒客栈里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "言笑",
          "text": "那之后再说吧。"
        },
        {
          "role": "旅行者",
          "text": "我这就去送。"
        },
        {
          "role": "言笑",
          "text": "有劳了。"
        },
        {
          "role": "言笑",
          "text": "现在实在抽不开身。"
        },
        {
          "role": "随缘的铃官",
          "text": "糟糕啊，好像一时间回不去了。"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "言笑",
          "text": "是这样的。铃官这个糊涂姑娘点了一份来来菜，说是等会儿回来吃。我估计她又逛到什么地方回不来了。"
        },
        {
          "role": "言笑",
          "text": "你把这份给她送过去吧。走路稳点，不要乱飞乱跑，怕漏了。"
        },
        {
          "role": "言笑",
          "text": "还有就是别沾着奇怪的元素搅和了味道。"
        },
        {
          "role": "言笑",
          "text": "如果餐点成色坏了，你们就回来找我，我重新弄一份。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "随缘的铃官",
          "text": "居然直接送过来了。太感谢你了。"
        }
      ]
    }
  ]
}