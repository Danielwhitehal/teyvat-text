{
  "quest_id": 71660,
  "chapter_num": null,
  "chapter_title": "学术的往来",
  "type": "wq",
  "route": "Academic Exchange",
  "stories": [
    {
      "story_id": 71660,
      "title": "学术的往来",
      "description": "「烟霞魔药」的阶段性试验结束了，是时候向蒂玛乌斯进行反馈了…",
      "dialogues": [
         {
          "type": "subtitle",
          "text": "向蒂玛乌斯回报「烟霰魔药」的效果"
        },
        {
          "role": "蒂玛乌斯",
          "text": "你们回来了！「烟霰魔药」的效果如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "如果能在秘境外使用就好了。",
            "还有提升空间。"
          ]
        },
        
        {
          "role": "派蒙",
          "text": "对对对！那样就锦上添花了！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "哦？感觉你们的评价还不错嘛，请展开说说！"
        },
        {
          "type": "subtitle",
          "text": "向蒂玛乌斯详细说明了试验中的细节。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "和你的预测完全相符啊，莺儿小姐！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "完善「烟霰魔药」的方向确定了——我们需要将升华后的药剂约束在一定范围内。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "或许…反向利用蒲公英的特性，制作特殊的辅料，就能让药剂免受空气流动的影响。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "但这个方案没有先例，并不简单，还需要大量试验来证明它的可行性…"
        },
        {
          "role": "派蒙",
          "text": "完全听不懂！"
        },
        {
          "role": "派蒙",
          "text": "不过总感觉，莺儿小姐每次都提出了很重要的建议呢。"
        },
        {
          "role": "莺儿",
          "text": "啊呀，我可没有给出过这么详实的预测哦。"
        },
        {
          "role": "莺儿",
          "text": "刻苦的炼金术士，你是在揣摩我的心思，还是想夸奖我…变着花样哄我开心？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "我，我只是由衷敬佩莺儿小姐的学识而已！"
        },
        {
          "role": "莺儿",
          "text": "好啦好啦，那你要加把劲哦，也许以后还要用到其他偏门的知识呢。"
        },
        {
          "role": "莺儿",
          "text": "等到你的研究成功了，别忘了告诉我哦~"
        },
        {
          "role": "蒂玛乌斯",
          "text": "那是当然…到时我会把品质最好的魔药寄过来，给莺儿小姐当纪念品！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "如果莺儿小姐还有空，不如和我们一起去「万民堂」…"
        },
        {
          "role": "莺儿",
          "text": "这次的「学术交流」就到此为止啦，「春香窑」还有许多事务等着我去处理。"
        },
        {
          "role": "莺儿",
          "text": "有空的话，一定要经常来陪我哦~"
        },
        {
          "role": "旅行者",
          "text": "下次一定！"
        },
        {
          "role": "派蒙",
          "text": "谢谢你啦，莺儿小姐！"
        },
        {
          "type": "subtitle",
          "text": "莺儿离开了。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "唉，结果还是没能说出口。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "不过，最近给莺儿小姐添了这么多麻烦，不应该再占用她的时间。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "还是沉下心来，等待合适的时机为妙…"
        },
        {
          "role": "派蒙",
          "text": "你在自言自语什么呢，蒂玛乌斯？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "没什么！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "这段时间有劳你们了！按照约定，我会请两位到「万民堂」吃顿大餐。"
        },
        {
          "role": "旅行者",
          "text": "我差点都忘了…"
        },
        {
          "role": "派蒙",
          "text": "对哦，吃大餐吃大餐！我们赶快过去吧！"
        },
        {
          "type": "subtitle",
          "text": "与蒂玛乌斯来到了「万民堂」，享用了丰盛的佳肴。"
        },
        {
          "role": "派蒙",
          "text": "呜呼！吃得好饱，好满足！"
        },
        {
          "role": "派蒙",
          "text": "其实这次研究还蛮有意思的，蒂玛乌斯！以后如果还要来璃月，记得叫上我们哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你不关心研究吧？",
            "你只是想蹭饭吧？"
          ]
        },
        {
          "role": "派蒙",
          "text": "这是什么话！明明我也有出力…出力去问路啊！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "总之，多谢两位了！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "不过回到蒙德后，我就要全心全意改进「烟霰魔药」，恐怕很长时间不会再来璃月了。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "也许不久后，还要拜托你们帮我送信。刚才我还没来得及向莺儿小姐表达感激之情。"
        },
        {
          "role": "派蒙",
          "text": "咦？你们明明在一起讨论了那么久，为什么不当面说呢？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "咳咳！莺儿小姐的谈吐实在太…特别了！我要仔细斟酌措辞，写信当然比当面说更合适…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "时间紧迫，我们现在就动身回蒙德吧，我等不及要制作出完美的「烟霰魔药」了！"
        },
        {
          "role": "派蒙",
          "text": "我怎么感觉，告别莺儿小姐以后，蒂玛乌斯的反应就怪怪的？"
        },
        {
          "role": "派蒙",
          "text": "真让人摸不着头脑…"
        }
      ]
    }
  ]
}