{
  "quest_id": 73244,
  "chapter_num": null,
  "chapter_title": "失而复得者一同欢喜",
  "type": "wq",
  "route": "Rejoice With Me, for What Was Lost Is Now Found",
  "stories": [
    {
      "story_id": 73244,
      "title": "失而复得者一同欢喜",
      "description": "阿德菲虽然作为塔尼特的叛徒被婕德解决，但是，之前托付给阿德菲的奔奔现在又怎么样了呢…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与婕德对话"
        },
        {
          "type": "subtitle",
          "text": "额外对话（奔奔）阿德菲的帐篷內"
        },
        {
          "role": "奔奔",
          "text": "（奔奔，躺在地上…并没有发出熟悉的「哔哔」声。）"
        },
        {
          "role": "婕德",
          "text": "怎么会…我居然忘记了…"
        },
        {
          "role": "婕德",
          "text": "希望还来得及，至少，得去他的帐篷里先找一找…"
        },
        {
          "role": "派蒙",
          "text": "婕德！咦，怎么了，你现在正要去哪吗？"
        },
        {
          "role": "婕德",
          "text": "派蒙，还有旅行者…你们倒是来的正好，嗯，我现在得立刻去办件事情，我要去…阿德菲住的地方。"
        },
        {
          "role": "派蒙",
          "text": "阿德菲？"
        },
        {
          "role": "派蒙",
          "text": "那个家伙不是和愚人众勾搭在一起的叛徒吗…哦！我懂了，你是想去搜刮他的帐篷！"
        },
        {
          "role": "婕德",
          "text": "不，我对那家伙留下来的东西毫无兴趣。"
        },
        {
          "role": "婕德",
          "text": "部族对这些叛徒遗留的东西应当如何处置有特定的规矩，哼…要不是因为这个，我恨不得把那家伙留下的东西全部烧光。"
        },
        {
          "role": "婕德",
          "text": "我要去他的帐篷是因为…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是因为奔奔吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "啊，对哦！奔奔在阿德菲那里，这可怎么办！"
        },
        {
          "role": "派蒙",
          "text": "呜，婕德，你怎么把奔奔交给了那样的家伙呀！"
        },
        {
          "role": "婕德",
          "text": "唉，在、在那之前，我也不知道他是叛徒啊！"
        },
        {
          "role": "婕德",
          "text": "总之，得快点去阿德菲那里看看才行…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们也一起去吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "事不宜迟…",
              "dialogues": []
            },
            {
              "text": "现在就出发吧！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，奔奔可千万别出事呀…"
        },
        {
          "type": "subtitle",
          "text": "到达阿德菲的帐篷寻找线索"
        },
        {
          "type": "subtitle",
          "text": "查看状态失常的奔奔"
        },
        {
          "role": "派蒙",
          "text": "啊，是奔奔！"
        },
        {
          "role": "婕德",
          "text": "幸好阿德菲还没来得及把奔奔带走…"
        },
        {
          "role": "婕德",
          "text": "不如说，这里的东西都跟之前一模一样，根本没有变化。"
        },
        {
          "role": "婕德",
          "text": "这家伙不会以为自己能够成功推翻主母，然后安然无恙地回到自己的帐篷里吧…？真是自大的蠢货。"
        },
        {
          "role": "婕德",
          "text": "不过也多亏了这份愚蠢，奔奔才没出什么事。"
        },
        {
          "role": "派蒙",
          "text": "这也叫没出什么事吗…奔奔，奔奔…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么会变成这样…",
              "dialogues": []
            },
            {
              "text": "奔奔…它怎么了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，它怎么躺在地上…"
        },
        {
          "role": "派蒙",
          "text": "奔奔到底出了什么事呀，上次见到的时候还好好的呢…"
        },
        {
          "role": "婕德",
          "text": "奔奔…在离开圣显厅之后，就逐渐变得虚弱起来了，看上去像是有什么地方出了故障，发出的声音也越来越小…"
        },
        {
          "role": "婕德",
          "text": "直到发不出声音，甚至也没法移动，就像是，拥有的生命力一点一点流失掉了一样。"
        },
        {
          "role": "婕德",
          "text": "那个时候，整个部族里，除了阿德菲，没人对奔奔身上发生什么有概念。"
        },
        {
          "role": "婕德",
          "text": "所以我就把奔奔放在了阿德菲这里…"
        },
        {
          "role": "派蒙",
          "text": "怎么会这样…奔奔，奔奔不会就这样再也醒不了了吧。"
        },
        {
          "role": "婕德",
          "text": "……"
        },
        {
          "role": "婕德",
          "text": "总之，奔奔既然还在，总有一天能找到让它恢复的办法…"
        },
        {
          "role": "派蒙",
          "text": "可像这样，一点头绪都没有…"
        },
        {
          "role": "婕德",
          "text": "我想想，我记得上次阿德菲还和我说，不是什么很严重的问题，这两天就能够出结果…"
        },
        {
          "role": "婕德",
          "text": "按这家伙的习惯，如果做了什么检查，肯定会留下什么记录才对。我们在周围先找找看吧！"
        },
        {
          "role": "婕德",
          "text": "如果不是什么「严重的问题」的话，说不定我们也能解决一下！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（婕德）"
        },
        {
          "role": "婕德",
          "text": "嗯，这里好像也没有什么有用的东西…"
        },
        {
          "type": "subtitle",
          "text": "在帐篷内进行调查"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调查",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "查看信件"
        },
        {
          "role": "派蒙",
          "text": "快看，这里好像有点东西。"
        },
        {
          "role": "派蒙",
          "text": "不过看上去不像是一份什么检查记录，而是一封信…"
        },
        {
          "role": "婕德",
          "text": "什么信，快打开看看吧！"
        },
        {
          "type": "subtitle",
          "text": "关于货物交易的回函"
        },
        {
          "role": "[[file",
          "text": "关于货物交易的回函-地图.png|center|500px]]"
        },
        {
          "type": "subtitle",
          "text": "…按惯例，夜间在「后山枯树」进行交易，至于之前垂询的特殊个体「奔奔」一事，确实是类似能量匮乏无法进行自循环所致…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "…事实上只要利用元素转化后的能量进行充能，即能恢复运作功能呢，至于转化充能所用容器，自然不必忧心，我们可以在交易时奉上…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "…不过还望到时能携带特殊个体「奔奔」，我们的研究员对此十分感兴趣，或可作为研究参考…",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "看这封信上的意思，奔奔原来只是没有能量了…"
        },
        {
          "role": "派蒙",
          "text": "这么一想，不管是打开赤王陵的大门，还是为我们激活了权限，奔奔在一路上帮我们做了很多事…"
        },
        {
          "role": "婕德",
          "text": "就算是奔奔，也会觉得累吧…可能就是因为为我们做了那么多事，所以它才失去了能量。"
        },
        {
          "role": "婕德",
          "text": "上面提到有什么特殊的「充能转化容器」，可是帐篷里好像没有看到类似的东西。"
        },
        {
          "role": "婕德",
          "text": "难道说…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "藏在某个地方？",
              "dialogues": [
                {
                  "role": "婕德",
                  "text": "不太像，只是用来维修奔奔的话，也不用特地藏起来，直接使用不就好了…"
                },
                {
                  "role": "婕德",
                  "text": "我明白了！一定是这场交易还没发生！"
                }
              ]
            },
            {
              "text": "还没有拿到？",
              "dialogues": [
                {
                  "role": "婕德",
                  "text": "啊，我明白你的意思了，这场交易还没有发生！"
                }
              ]
            }
          ]
        },
        {
          "role": "婕德",
          "text": "所以奔奔没被阿德菲带到交易现场，当然也没有「充能转化容器」…那剩下的问题只有一个了，阿德菲交易的对象是谁？"
        },
        {
          "role": "婕德",
          "text": "哈，真是问了个蠢问题，会和他在部落外做这种交易的恐怕只有一类人了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是须弥的学者？",
              "dialogues": [
                {
                  "role": "婕德",
                  "text": "是愚人众啦！"
                }
              ]
            },
            {
              "text": "是愚人众！",
              "dialogues": [
                {
                  "role": "婕德",
                  "text": "想也知道，不会有别人了。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那我们现在怎么办？"
        },
        {
          "role": "婕德",
          "text": "还能怎么办，跟那群愚人众还有什么好话可说，当然是到了交易地点，把那些「充能转化容器」抢过来！"
        },
        {
          "role": "派蒙",
          "text": "好欸，抢过来！"
        },
        {
          "role": "婕德",
          "text": "可是奔奔…奔奔现在的状态，没法携带在身上，当然也不可能带去交易现场…"
        },
        {
          "role": "婕德",
          "text": "如果放在别的地方，也并不安全。把它独自留在别处这种事…有一次就够了。"
        },
        {
          "role": "派蒙",
          "text": "那就这样好了，我和旅行者去抢愚人众，你和奔奔在这里等着！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好耶！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好耶！我们去抢愚人众！"
                }
              ]
            },
            {
              "text": "抢愚人众！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯嗯，反正也不是第一次啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "婕德",
          "text": "虽然很想自己去，但是…旅行者，派蒙，奔奔能不能恢复，就拜托你们了！"
        },
        {
          "role": "婕德",
          "text": "以及，虽然对方只是一些愚人众，但是也要注意安全…"
        },
        {
          "role": "派蒙",
          "text": "没事的！就放心交给我们吧！"
        },
        {
          "role": "婕德",
          "text": "嗯，我也…不能让奔奔留在阿德菲这个叛徒这里，我先把它带到我那边。"
        },
        {
          "role": "婕德",
          "text": "等拿到「充能转化容器」，就在我的帐篷那会合吧！"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|关于货物交易的回函}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "额外对话（婕德）婕德的帐篷"
        },
        {
          "role": "婕德",
          "text": "「充能转化容器」，希望拿到那个东西以后，就能够让奔奔恢复过来…"
        },
        {
          "role": "婕德",
          "text": "如果实在不安心的话，我也一起去吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你在这里陪奔奔吧。",
              "dialogues": []
            },
            {
              "text": "我们马上就会回来的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "婕德",
          "text": "嗯，那我就在这里等你的好消息，一定要安全回来！"
        },
        {
          "role": "婕德（心声）",
          "text": "（…这样的话，奔奔一定有救了，嗯！）"
        },
        {
          "type": "subtitle",
          "text": "前往信件中的密会地点"
        },
        {
          "role": "派蒙",
          "text": "看地图上的标识，交易地点应该就在那边！"
        },
        {
          "role": "派蒙",
          "text": "不过看上去似乎还没有人来，我们坐在那里等会儿吧…"
        },
        {
          "type": "subtitle",
          "text": "在密会地点进行等待"
        },
        {
          "type": "subtitle",
          "text": "仓库物资订单"
        },
        {
          "type": "subtitle",
          "text": "…佛罗德洛克·弗朗孔斯汀教授所要求的一批次「充能转化容器」，三批次「火水」，三批次枫丹甜酒已经入库等候要求。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "…佛罗德洛克教授不喝酒就无法正常工作，所以一定要妥善注意六批次酒水的保存条件…",
          "narration": true
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "坐下",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "快看，果然是愚人众！"
        },
        {
          "type": "subtitle",
          "text": "击败愚人众"
        },
        {
          "role": "愚人众",
          "text": "不对，不是阿德菲，你、你们是谁？"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|愚人众先遣队·水铳重卫士|1}}{{图标|愚人众·雷萤术士|1}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "与愚人众交易人员对话"
        },
        {
          "role": "愚人众交易人员",
          "text": "别、别打了…"
        },
        {
          "role": "愚人众交易人员",
          "text": "快停手吧，再打下去真的要出人命了…"
        },
        {
          "role": "派蒙",
          "text": "被打的人说这话还真有说服力。"
        },
        {
          "role": "派蒙",
          "text": "说！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "快说！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "愚人众交易人员",
          "text": "我说我说，你们想知道什么我都说！"
        },
        {
          "role": "派蒙",
          "text": "先说说你知道什么！"
        },
        {
          "role": "愚人众交易人员",
          "text": "我、我们只是一直和阿德菲做一些交易而已…据说塔尼特的主母偏爱什么阿萨里格…还有那个新来的小姑娘…"
        },
        {
          "role": "愚人众交易人员",
          "text": "哼，虽说不知怎么回事，阿萨里格似乎也失踪了…"
        },
        {
          "role": "愚人众交易人员",
          "text": "那个女人心狠手辣，不会容留对部族失去价值的人…所以，阿德菲为了保证自己的地位联系了我们…"
        },
        {
          "role": "愚人众交易人员",
          "text": "之前我们在沙漠里的工作开展一直不是很顺利，这下倒是、倒是有点一拍即合的意思。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "失去价值…你是什么意思？",
              "dialogues": [
                {
                  "role": "愚人众交易人员",
                  "text": "我不知道…我真的不知道！那是他们沙漠人内部的事务…不过要我猜的话，可能是因为那个女人认为我们不可信任了…"
                },
                {
                  "role": "愚人众交易人员",
                  "text": "…所以她才会疏远我们，而经常与我们联络的阿德菲也为此不安…"
                },
                {
                  "role": "愚人众交易人员",
                  "text": "毕竟我们还能撤离这个鬼地方，而他只能被榨干价值，然后任部落处置…"
                }
              ]
            },
            {
              "text": "你们在沙漠里的工作…？",
              "dialogues": [
                {
                  "role": "愚人众交易人员",
                  "text": "…机密。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "……",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "你瞧，你惹旅行者生气啦！他生气的后果很严重哦！"
                },
                {
                  "role": "愚人众交易人员",
                  "text": "唔…！好吧，好吧！请别生气，我说就是了！虽然…虽然我知道的也不多…"
                },
                {
                  "role": "愚人众交易人员",
                  "text": "我们的任务是调查沙漠住民各部落现状，以贸易的方式拉拢和渗透他们，吸引贤者注意…为须弥城内的执行官大人提供方便。"
                },
                {
                  "role": "愚人众交易人员",
                  "text": "另外…佛罗德洛克教授也在沙漠里寻找活体样本，他一向不服从「博士」大人的领导…要我说，这就是嫉妒…"
                },
                {
                  "role": "愚人众交易人员",
                  "text": "咳咳，扯多了、扯多了…总之，阿德菲是我们的联络人，我们的物资交易一直由他负责。"
                }
              ]
            }
          ]
        },
        {
          "role": "愚人众交易人员",
          "text": "只是阿德菲这个人异常狡猾，他要的东西我们给了不少，我们要的东西却一点眉目没有…"
        },
        {
          "role": "愚人众交易人员",
          "text": "不过听说他出事了…虽然不知道出了什么事，但我们想，这不正好是个好机会…"
        },
        {
          "role": "派蒙",
          "text": "好机会？什么好机会？"
        },
        {
          "role": "愚人众交易人员",
          "text": "我们估计之后也没有什么和阿德菲做交易的机会，所以就让他带上前几次信里说的什么特殊元能构装体…"
        },
        {
          "role": "愚人众交易人员",
          "text": "如果可以就夺过来，等过几天我们完全撤离了以后，也不算毫无所得…"
        },
        {
          "role": "派蒙",
          "text": "什么，原来你们也想来抢东西，怪不得，既没有货物也没看见那些「充能转化容器」。"
        },
        {
          "role": "愚人众交易人员",
          "text": "啊？「也」想来抢东西？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "对，快把「充能转化容器」交出来。",
              "dialogues": []
            },
            {
              "text": "遇上我们算你运气不好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔，不会那个什么「充能转化容器」也是你们编的吧！"
        },
        {
          "role": "愚人众交易人员",
          "text": "不，「充能转化容器」倒是真的，不过因为也是古代的东西，有很多，但不知道其中有没有能用的…"
        },
        {
          "role": "派蒙",
          "text": "那这些「充能转化容器」在什么地方？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙的气势真不错。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，是嘛…旅行者不要转移话题啦…"
        },
        {
          "role": "派蒙",
          "text": "快，快把你们放东西的地点说出来。"
        },
        {
          "role": "愚人众交易人员",
          "text": "…就在附近的一个据点，这个就是据点的钥匙…我知道的我全告诉你们了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "走吧！",
              "dialogues": []
            },
            {
              "text": "别让我们再看见你！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "愚人众交易人员",
          "text": "好好好，我这就消失。"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|愚人众据点钥匙}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "前往愚人众的据点"
        },
        {
          "role": "派蒙",
          "text": "看来那里就是据点了，快进去找找吧！"
        },
        {
          "type": "subtitle",
          "text": "收集一定数量的「充能转化容器」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "开启",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "消耗{{图标|愚人众据点钥匙|1}}开启",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调查",
              "dialogues": []
            },
            {
              "text": "查看",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|充能转化容器|1}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "看来这个就是「充能转化容器」了，那个愚人众的家伙不是说有很多个吗，我们找找有没有别的…"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|充能转化容器|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "有这么多「充能转化容器」，应该有能用得上了的吧。"
        },
        {
          "role": "派蒙",
          "text": "我们快回去找婕德吧！"
        },
        {
          "type": "subtitle",
          "text": "返回婕德的帐篷"
        },
        {
          "type": "subtitle",
          "text": "将「充能转化容器」交给婕德"
        },
        {
          "role": "派蒙",
          "text": "婕德！"
        },
        {
          "role": "婕德",
          "text": "怎么样，你们没出什么事吧？"
        },
        {
          "role": "派蒙",
          "text": "没有没有，什么事都没有。对了，你看，这些就是「充能转化容器」！"
        },
        {
          "type": "subtitle",
          "text": "交付{{图标|充能转化容器|3}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "修复奔奔"
        },
        {
          "role": "婕德",
          "text": "原来「充能转化容器」长这样啊…可是，这东西应该怎么用呢…"
        },
        {
          "role": "奔奔",
          "text": "哔…哔哔…"
        },
        {
          "role": "婕德",
          "text": "奔奔？"
        },
        {
          "type": "subtitle",
          "text": "奔奔链接上了「充能转化容器」，以很快的速度汲取了其中的能量。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "奔奔",
          "text": "哔哔——哔哔——"
        },
        {
          "role": "派蒙",
          "text": "哇，奔奔复活了！"
        },
        {
          "role": "婕德",
          "text": "说什么傻话，奔奔之前都在睡觉，现在只是醒过来了而已啦！"
        },
        {
          "role": "奔奔",
          "text": "哔哔…哔哔…"
        },
        {
          "role": "婕德",
          "text": "没有，我才没有担心呢，我知道你总有一天能恢复过来的！"
        },
        {
          "role": "派蒙",
          "text": "哼，「把它独自留在别处这种事，有一次就够了…」"
        },
        {
          "role": "婕德",
          "text": "派蒙不许学我说话！"
        },
        {
          "role": "奔奔",
          "text": "哔哔——"
        },
        {
          "role": "婕德",
          "text": "啊，对了，旅行者，奔奔说谢谢你。"
        },
        {
          "role": "婕德",
          "text": "看来就算躺着不动，但是你们做的事奔奔也能知道。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用谢，奔奔。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奔奔",
          "text": "哔哔！"
        },
        {
          "role": "婕德",
          "text": "唔…"
        },
        {
          "role": "派蒙",
          "text": "怎么了，婕德？"
        },
        {
          "role": "婕德",
          "text": "虽然醒了过来，不过看上去奔奔还是需要恢复一下…"
        },
        {
          "role": "派蒙",
          "text": "嗯，要好好休息呀，奔奔！"
        },
        {
          "role": "奔奔",
          "text": "哔哔…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（奔奔）"
        },
        {
          "role": "奔奔",
          "text": "哔哔——哔哔——"
        },
        {
          "role": "奔奔",
          "text": "（奔奔似乎恢复了很多，现在看起来精神不错…）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（婕德）"
        },
        {
          "role": "婕德",
          "text": "（…这下奔奔终于恢复了！奔奔…）"
        },
        {
          "role": "婕德",
          "text": "啊，旅行者…原来是你，怎么了，有什么事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「永恒绿洲」…",
              "dialogues": [
                {
                  "role": "婕德",
                  "text": "这次去「永恒绿洲」，真是多亏有你，如果没有你的话，说不定根本没办法真的打开通往「永恒绿洲」的道路。"
                },
                {
                  "role": "婕德",
                  "text": "我都不知道应该如何感谢你…下次我们再一起点起篝火，坐在篝火边夜谈吧，就像…"
                },
                {
                  "role": "婕德",
                  "text": "就像上次和[[阿萨里格]]…啊…"
                },
                {
                  "role": "婕德",
                  "text": "…那个狗东西…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "抱歉…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "婕德",
                  "text": "没有什么可抱歉的，我没有在生你的气…"
                },
                {
                  "role": "婕德",
                  "text": "主母在我出发前就已经让我提高警惕了。我可能行事草率…噗，也许吧…但我并不傻。"
                },
                {
                  "role": "婕德",
                  "text": "那些古代机械的图纸…他从来没有给族人分享过——这是重罪，从意识到这点起，我就已经生疑了…"
                },
                {
                  "role": "婕德",
                  "text": "但我没想到，他在与我接触的这么长时间里，竟然怀着那样的算计…他自以为能掌控我…"
                },
                {
                  "role": "婕德",
                  "text": "一想到这个我就觉得恶心…"
                },
                {
                  "role": "婕德",
                  "text": "不过还好，还有[[芭别尔]]主母始终站在我这边，我相信她一定能让部族重新繁荣…"
                },
                {
                  "role": "婕德",
                  "text": "一定能…嗯。"
                },
                {
                  "role": "婕德",
                  "text": "对了，还有你！还有你是我这边的！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "嗯，我也是婕德人！",
                      "dialogues": [
                        {
                          "role": "婕德",
                          "text": "婕德人是什么啦…好怪，听上去好像派蒙会取的外号哦。"
                        },
                        {
                          "role": "婕德",
                          "text": "不过，谢谢你，旅行者…真的很感谢！"
                        }
                      ]
                    },
                    {
                      "text": "如果我和主母起了冲突呢…",
                      "dialogues": [
                        {
                          "role": "婕德",
                          "text": "……"
                        },
                        {
                          "role": "婕德",
                          "text": "哈哈，不许开这种玩笑啦，你是塔尼特的贵宾，又迎回了「镇灵之母」，找到了前往「永恒绿洲」的路…"
                        },
                        {
                          "role": "婕德",
                          "text": "我想不到主母会和你起冲突的理由。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "关于奔奔…",
              "dialogues": [
                {
                  "role": "婕德",
                  "text": "多亏你上次从那些北方人手里拿来的东西，奔奔现在逐渐恢复，看上去可精神了。"
                },
                {
                  "role": "婕德",
                  "text": "跟我们当初遇到它的时候一样…"
                }
              ]
            },
            {
              "text": "没什么事…",
              "dialogues": [
                {
                  "role": "婕德",
                  "text": "嗯…有什么需要我帮忙的，要及时和我说。"
                }
              ]
            }
          ]
        }
      ],
