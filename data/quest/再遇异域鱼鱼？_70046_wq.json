{
  "quest_id": 70046,
  "chapter_num": null,
  "chapter_title": "再遇异域鱼鱼？",
  "type": "wq",
  "route": "A Very Fishy Encounter",
  "stories": [
    {
      "story_id": 70046,
      "title": "再遇异域鱼鱼？",
      "description": "在柔灯港以南的某片水域，你们遇见了某位奇怪的「放生徒追猎者」，她正全力应对潜在的生态危机…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与奇怪的捕鱼人对话"
        },
        {
          "role": "哲俩阿",
          "text": "完美，准备工作全都搞定了…"
        },
        {
          "role": "哲俩阿",
          "text": "加把劲，哲俩阿，争取几天之内把它们全抓起来！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抓，抓什么？",
              "dialogues": []
            },
            {
              "text": "盗，盗猎？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "噫！怎么枫丹也冒出盗猎者了…最近倒卖动物很赚钱吗？"
        },
        {
          "role": "派蒙",
          "text": "不行不行，我们要先把你抓起来，押送执律庭！"
        },
        {
          "role": "哲俩阿",
          "text": "…是你们？"
        },
        {
          "role": "哲俩阿",
          "text": "好啊好啊，我刚从执律庭过来，要不要我给你们带路？"
        },
        {
          "role": "派蒙",
          "text": "？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "棒欸，我喜欢爽快人！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "等等，有点不对劲…听说要被抓起来还一副完全不怕的模样，要么是惯犯，要么就是…"
                }
              ]
            },
            {
              "text": "等等…我们好像误会了什么？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "确实，听说要被抓起来还一副完全不怕的模样，要么是惯犯，要么就是…"
                }
              ]
            }
          ]
        },
        {
          "role": "哲俩阿",
          "text": "就是站在正义这边的好人哦。"
        },
        {
          "role": "哲俩阿",
          "text": "准确地说，是为了环境去战斗的执律庭特聘顾问——「放生徒追猎者」。"
        },
        {
          "role": "哲俩阿",
          "text": "因为我要抓的，可是入侵枫丹水域的外来物种鱼。"
        },
        {
          "role": "派蒙",
          "text": "外来…物种？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像有点耳熟。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "啊，确实有印象，以前在蒙德听说过类似的事…{{#info:[[「嘟嘟可轰轰奇遇记」]]}}"
                }
              ]
            },
            {
              "text": "什么东西？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好像有点印象，应该是很久以前，我们在蒙德听说过类似的事…{{#info:[[「嘟嘟可轰轰奇遇记」]]}}"
                }
              ]
            }
          ]
        },
        {
          "role": "哲俩阿",
          "text": "过去的事先不提啦，现在的情况更重要。"
        },
        {
          "role": "哲俩阿",
          "text": "这些外来物种鱼啊，是被奇怪信仰的商人们特意放生的。"
        },
        {
          "role": "哲俩阿",
          "text": "它们有的特别凶猛，有的繁殖能力特别强，有的还被特殊的饲料喂养过，对于本地水生生物来说，全都是大麻烦。"
        },
        {
          "role": "哲俩阿",
          "text": "要是被它们鸠占鹊巢，改变了水下生物的结构，枫丹的水质有可能受到影响…"
        },
        {
          "role": "哲俩阿",
          "text": "不说枫丹人的健康这种长远问题，枫达这类饮料的口感第一时间就会变样吧，到时候枫丹的经济也会受到牵连，事情就大条了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "枫达，你还不能倒下！",
              "dialogues": []
            },
            {
              "text": "虽然不怎么喝，但枫达很重要…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "越是轻描淡写，越觉得问题很严重，我们不能坐视不理！"
        },
        {
          "role": "派蒙",
          "text": "抓鱼这种事，我们也挺在行的，不如就让我们来帮你一把？"
        },
        {
          "role": "哲俩阿",
          "text": "太对了，我就等着这句话呢，这才是你们的作风！"
        },
        {
          "role": "哲俩阿",
          "text": "我已经搭好了一个围捕区，其中的诱饵会将入侵鱼类统统吸引过来…"
        },
        {
          "role": "哲俩阿",
          "text": "拿出你们执行正义的气势吧，荣誉骑士和白色小帮手，我会尽全力支持你们的！"
        },
        {
          "role": "派蒙",
          "text": "不知为什么，感觉这位小姐很了解我们…是我的错觉吗？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（哲俩阿）"
        },
        {
          "role": "哲俩阿",
          "text": "怎么样，荣誉骑士和白色小帮手，捕捉一群被围困的鱼儿，对你们来说应该是小菜一碟吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "开始捕鱼，开始烹饪！",
              "dialogues": [
                {
                  "role": "哲俩阿",
                  "text": "气势真强…期待你们大展身手！"
                }
              ]
            },
            {
              "text": "小菜一碟，随便炒炒！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "不过…我有点在意，你一句就带过的那些「奇怪信仰的商人」，究竟是怎么回事？"
                },
                {
                  "role": "派蒙",
                  "text": "他们搞出了这次的大麻烦，应该要找他们算账才对！"
                },
                {
                  "role": "哲俩阿",
                  "text": "那些人啊…大部分不算纯粹的坏家伙，只是太过天真了——"
                },
                {
                  "role": "哲俩阿",
                  "text": "他们相信了一则传闻：在做重要的事情之前，放生一些动物，会让自己的运气好转。"
                },
                {
                  "role": "哲俩阿",
                  "text": "这样的人从须弥扩散到了提瓦特各地，形成了一个独特的「放生」群体。而某些商人嗅到了其中的商机…"
                },
                {
                  "role": "哲俩阿",
                  "text": "于是那些奸商提前从各地走私动物，甚至用奇怪的饲料让动物们看起来更华丽，然后将这些动物高价卖给放生徒们。"
                },
                {
                  "role": "派蒙",
                  "text": "这也太离谱了！真的会有傻子掏钱干这种事吗？"
                },
                {
                  "role": "哲俩阿",
                  "text": "要是不傻，怎么会相信…「放生动物带来好运」这样的事呢？"
                },
                {
                  "role": "哲俩阿",
                  "text": "在一些人看来，放生了高价的、瑰丽的动物，获得的「功德」也更多。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "不要的摩拉可以给我。",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "真是的，钱打了水漂，什么都没得到，还给别人惹出大祸…最后只有那些奸商赚的盆满钵满！"
                        }
                      ]
                    },
                    {
                      "text": "信这个还不如信我。",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "对哦，起码给旅行者摩拉，他真的会帮你解决麻烦！"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "哲俩阿",
                  "text": "不过，你们也不用担心。执律庭那边的一位警官已经顺着我提供的线索去追查奸商了，应该不久后就能出结果。"
                },
                {
                  "role": "哲俩阿",
                  "text": "这次就不劳荣誉骑士和白色小帮手亲自去捉拿罪魁祸首了！"
                }
              ]
            },
            {
              "text": "这个先放一边，我们是不是见过？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对哦，看你的服装，好像是须弥人，但你又叫旅行者荣誉骑士，叫我白色小帮手，这些不是蒙德人对我们的称号吗…"
                },
                {
                  "role": "哲俩阿",
                  "text": "可以理解你们的困惑。"
                },
                {
                  "role": "哲俩阿",
                  "text": "蒙德的居民们都说，你们两位一天能接下七八十人份的工作，那肯定见过成百上千的奇人，就算脑力超强，也记不住我——"
                },
                {
                  "role": "哲俩阿",
                  "text": "以前，我也迷信过放生能带来好运，前往蒙德经商时，在果酒湖里放生了一些须弥鱼类，导致了危险的生物入侵事件…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "原来是你！",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "想起来了！那时候，你好像还在果酒湖边野餐？"
                        },
                        {
                          "role": "哲俩阿",
                          "text": "没错，在果酒湖边遇见你们两位后，我才意识到自己的错误，接受我应得的惩罚。"
                        }
                      ]
                    },
                    {
                      "text": "还是没想起来…",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "我依稀有点印象，确实有这么一件事来着…"
                        },
                        {
                          "role": "哲俩阿",
                          "text": "没关系，不谈细节了。总之，在你们的影响下，我才意识到自己的错误，接受我应得的惩罚。"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "哲俩阿",
                  "text": "好在那时，事态还没发展到不可挽回的地步。西风骑士团的大好人们最终解决了问题，但我一直后怕不已…"
                },
                {
                  "role": "哲俩阿",
                  "text": "回到须弥后，我极力警告那些有着放生习惯的人，其中一些被我劝住了，另一些还是不管不顾，甚至把我当成敌人。"
                },
                {
                  "role": "哲俩阿",
                  "text": "作为犯过大错的人，我不能看着别人走上我的老路，重复同样的蠢事…"
                },
                {
                  "role": "哲俩阿",
                  "text": "所以我就恶补了相关知识，协助教令院的相关机构、配合「三十人团」，对这些放生徒和背后牟利的商人重拳出击。"
                },
                {
                  "role": "哲俩阿",
                  "text": "给放生徒们供货的商人通常在多国活动，我也因此辗转各地。最近的目标，如你所见，就是一位枫丹人了。"
                },
                {
                  "role": "哲俩阿",
                  "text": "我带着教令院的相关文件和证明，执律庭之前也对相关事件做过备案，我和警官们一拍即合，很快就能把那家伙缉拿归案。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "好转变，真替你高兴！",
                      "dialogues": []
                    },
                    {
                      "text": "有点狠，但是干得漂亮！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "从犯错的人转变成到处阻止别人犯错的人…你让我刮目相看了，哲俩阿小姐！"
                },
                {
                  "role": "哲俩阿",
                  "text": "归根结底，我能改过自新，都离不开你们两位的帮助。"
                },
                {
                  "role": "哲俩阿",
                  "text": "执律庭为此向我支付了一笔不错的报酬，我只留盘缠，其余的全都转赠你们两位，以表谢意！"
                }
              ]
            },
            {
              "text": "还有别的事…",
              "dialogues": [
                {
                  "role": "哲俩阿",
                  "text": "那两位请便！相信下次你们再来时，不消片刻就能解决眼下的问题！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          27,
          29
        ]
      ]
    }
  ]
}