{
  "quest_id": 73532,
  "chapter_num": null,
  "chapter_title": "奇书疑云",
  "type": "wq",
  "route": "An Odd Textual Mystery",
  "stories": [
    {
      "story_id": 73532,
      "title": "奇书疑云",
      "description": "听柯莱说，须弥城最近有些热闹，你和派蒙毅然决定前去看看发生了什么事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往须弥城"
        },
        {
          "role": "派蒙",
          "text": "对了，柯莱不是说最近须弥城里很热闹吗？你不好奇吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "呃…一般吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "啊——！不要这么冷淡嘛，拿出热情，热情！就当是陪我去凑凑热闹好不好嘛…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "好吧好吧陪派蒙…",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "有点兴趣。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对吧？我也是呢！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那我们现在就出发去热闹的地方！唔…第一站，先从看起来情报最密集的教令院开始吧？"
        },
        {
          "type": "subtitle",
          "text": "前往教令院"
        },
        {
          "type": "subtitle",
          "text": "心声（珐露珊）"
        },
        {
          "role": "珐露珊",
          "text": "（哼…下次借书还是谨慎一些吧。）"
        },
        {
          "role": "珐露珊",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "快看，珐露珊在那边！要不要问问…"
        },
        {
          "role": "珐露珊",
          "text": "…哼！"
        },
        {
          "role": "珐露珊",
          "text": "受不了，对着借书记录都会想起借到那种书的感觉…哎，真烦。"
        },
        {
          "role": "派蒙",
          "text": "珐露珊？你怎么在这里自言自语？"
        },
        {
          "role": "珐露珊",
          "text": "身为前辈，自言自语一些事也很常有哦。不过嘛…"
        },
        {
          "role": "珐露珊",
          "text": "唉，算了，先不说这个。你们俩怎么突然过来了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说来惭愧，我们来凑热闹…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我们听柯莱说须弥最近很热闹，好像出了些有趣的事，想来打听打听。你知道柯莱说的是什么吗？"
        },
        {
          "role": "珐露珊",
          "text": "有趣的事…柯莱觉得有趣，会是什么呢？提纳里的尾巴毛炸得像风滚草？还是赛诺爬树被枝杈勾掉帽子了？"
        },
        {
          "role": "派蒙",
          "text": "原来还有这么有趣的场面吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不喊我一起看，不够意思…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不过她说大家都在忙着什么，你能想到什么大规模的事吗？"
        },
        {
          "role": "珐露珊",
          "text": "大规模……"
        },
        {
          "role": "珐露珊",
          "text": "啊！！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "前辈怎么了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珐露珊",
          "text": "那个那个，就是，就是那个，哎呀！说起这件事，肯定是那个！"
        },
        {
          "role": "珐露珊",
          "text": "最近啊，我们这里突然流传起「某本书」的传闻了。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，好经典好恐怖的开头！会是什么邪典吗？"
        },
        {
          "role": "珐露珊",
          "text": "邪典？哈！我看也差不多了。你们看过超级糟糕的那种推理小说吗？"
        },
        {
          "role": "派蒙",
          "text": "呃…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "呃…没看过…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我看过我看过！"
                }
              ]
            },
            {
              "text": "呃…看过…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珐露珊",
          "text": "有多糟糕，说出来。"
        },
        {
          "role": "派蒙",
          "text": "我来说吧！比如那种开头以为是密室杀人，最后告诉你整栋房子都被吊走了的…"
        },
        {
          "role": "珐露珊",
          "text": "对对，还有说好是严肃推理，最后发现犯人有特殊异能的…"
        },
        {
          "role": "派蒙",
          "text": "啊没错！还有开头一本正经，后半段突然告诉你其实大家都失去了记忆！"
        },
        {
          "role": "珐露珊",
          "text": "还有在暴风雪山庄！一直描写得很严肃的警察毫无预兆地摇身一变成为凶手！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们说得太具体了…",
              "dialogues": []
            },
            {
              "text": "攻击到了太多人，快住口…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珐露珊",
          "text": "啊咳…前辈我失态了，不好意思。总之，我前几天就借到了一本这样的书。"
        },
        {
          "role": "派蒙",
          "text": "失手了呢，但也算很正常的事。"
        },
        {
          "role": "珐露珊",
          "text": "不，接下来就是问题所在，这本书，它汇聚了暴雪山庄、异能、警察变犯人等等各种元素…实在是太叫人难受了。"
        },
        {
          "role": "珐露珊",
          "text": "而且它这么复杂，竟然也没让我心动！"
        },
        {
          "role": "珐露珊",
          "text": "这样一本书，却跟传闻有关，人们都说它里面藏着秘密，因为书上每一页都被画了诡异记号。"
        },
        {
          "role": "派蒙",
          "text": "难道是宝藏？"
        },
        {
          "role": "珐露珊",
          "text": "不清楚，但这么想的人一定不少，所以越来越多人借阅这本小说，而且指定要借「有记号的那一本」。"
        },
        {
          "role": "派蒙",
          "text": "你是不是也借了？"
        },
        {
          "role": "珐露珊",
          "text": "对！前辈我可是学者，有点求知欲很正常吧。"
        },
        {
          "role": "派蒙",
          "text": "引起传闻的这本书，究竟藏着什么秘密呢？"
        },
        {
          "role": "珐露珊",
          "text": "我从头到尾仔细看了，书里的记号，大多是圆圈，但起笔落笔位置各不相同，墨水颜色也不一样…"
        },
        {
          "role": "珐露珊",
          "text": "重要的是，书上所有出现过的人名都被圈了起来。另外，这本书中有不少人名都化用自须弥历史上的知名人物。"
        },
        {
          "role": "珐露珊",
          "text": "有人推测，这是不同时代的不同学者在研究书的秘密，每个人寻找一个自己信仰的名字。"
        },
        {
          "role": "珐露珊",
          "text": "也有人认为，这是来自不同人的记号，他们属于同个组织，圈起的名字即为他们的代号。"
        },
        {
          "role": "珐露珊",
          "text": "还有说这是密文的，但我看完什么都没弄明白，只是浪费时间，还被离谱的推理震惊了好几次…"
        },
        {
          "role": "珐露珊",
          "text": "一怒之下我立刻把书还了回去。今天来智慧宫发现好些人鬼鬼祟祟的，大概还在找那东西吧。"
        },
        {
          "role": "派蒙",
          "text": "难怪你对着借书记录发呆，短期内不敢再借推理小说了是吗…"
        },
        {
          "role": "珐露珊",
          "text": "是啊…唉，派蒙，旅行者，你们两个一定能懂我的，对不对？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是的。",
              "dialogues": []
            },
            {
              "text": "前辈别难过，我感同身受。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这本书叫什么名字？我们也想借来开开眼。"
        },
        {
          "role": "珐露珊",
          "text": "它叫《推理不分早中晚但悬疑总在暴雪后》。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            },
            {
              "text": "确定是推理小说？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这名字都像轻小说了吧！"
        },
        {
          "role": "珐露珊",
          "text": "唉，可不是嘛。总之，你们谨慎阅读吧，真的是太无聊了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（珐露珊）"
        },
        {
          "role": "珐露珊",
          "text": "嗯？你问我喜欢看什么样的书？"
        },
        {
          "role": "珐露珊",
          "text": "那范围就太广了，不知道该从哪里开始说呢…"
        },
        {
          "type": "subtitle",
          "text": "四处寻找线索"
        },
        {
          "role": "派蒙",
          "text": "这里好像有几本书名很长的书，我看看…呃，《严肃办公与轻松休假》，这是什么东西？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "《雨林稀有物种专业版图谱》…",
              "dialogues": []
            },
            {
              "text": "《咖啡机构造与专精》…谁要看？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "《元素学问中的秘密》，书的腰封上还写着「专家推荐！前任贤者居勒什大人也叫好的入门级好书」…"
        },
        {
          "role": "派蒙",
          "text": "还有这个，《古沙漠民族稀有语种通用基本语法整理与归纳》…我要昏迷了，好多字我头好晕…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "加油啊派蒙，学会二十种…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯？那边是莱依拉吗？"
        },
        {
          "role": "派蒙",
          "text": "问问她好了！她说不定知道什么消息。"
        },
        {
          "type": "subtitle",
          "text": "与莱依拉对话"
        },
        {
          "type": "subtitle",
          "text": "心声（莱依拉）"
        },
        {
          "role": "莱依拉",
          "text": "（明明已经忙了很久，为什么还有好多事要做呀？呜呜…）"
        },
        {
          "role": "莱依拉",
          "text": "旅行者，派蒙，好久不见了呀…呼啊——有点困…"
        },
        {
          "role": "派蒙",
          "text": "昨天没睡好吗？"
        },
        {
          "role": "莱依拉",
          "text": "嗯，看了一本小说，睡得有点晚。"
        },
        {
          "role": "派蒙",
          "text": "难道是最近风头正盛的推理小说？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就是那本名字很长的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱依拉",
          "text": "欸？不是不是，如果你是说《推理不分早中晚但悬疑总在…》…呃，在哪来着…"
        },
        {
          "role": "派蒙",
          "text": "在暴雪后。"
        },
        {
          "role": "莱依拉",
          "text": "啊对对，不是那本哦。珐露珊前辈苦口婆心地劝过我，她说那本书非常无聊，我就没借。"
        },
        {
          "role": "派蒙",
          "text": "这样啊，莱依拉对书的秘密兴趣不大呢。"
        },
        {
          "role": "莱依拉",
          "text": "嗯，我自己的事都做不过来啦，最近总熬夜。"
        },
        {
          "role": "莱依拉",
          "text": "不过，打听这本书的人实在是比想的还要多，坐在这里像个告示牌一样，一个上午七八个人来问。"
        },
        {
          "role": "莱依拉",
          "text": "卡维前辈也来问过我一样的问题，他应该也在找这本书吧？之前还缩在梯子后面一脸尴尬地翻找…"
        },
        {
          "role": "派蒙",
          "text": "躲在梯子后面翻东西…看来那家伙想要钱啊！一定会这样的吧，为了他能早日还…"
        },
        {
          "role": "派蒙",
          "text": "啊不是不是，当我没说！莱依拉困了，那个是你的梦话，哈哈。"
        },
        {
          "role": "莱依拉",
          "text": "虽然不太明白，但好的，是梦话…"
        },
        {
          "role": "派蒙",
          "text": "谢谢啦，我们再去别处找找！"
        },
        {
          "role": "莱依拉",
          "text": "嗯嗯！下次见！…呼…呼…"
        },
        {
          "role": "旅行者",
          "text": "（难得看到莱依拉睡这么快，真为她高兴…）"
        },
        {
          "role": "派蒙",
          "text": "我觉得，我们现在应该去找卡维问问，他既然在找，那势必知道些情报。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可是，卡维现在在哪里？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…不知道呢…不过我们可以去堵他！我觉得他有很大概率就在那里，对吧？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（莱依拉）"
        },
        {
          "role": "莱依拉",
          "text": "呼…呼…"
        },
        {
          "role": "莱依拉（心声）",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "找到卡维"
        },
        {
          "type": "subtitle",
          "text": "心声（卡维）"
        },
        {
          "role": "卡维",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你有没有觉得我们这副嘴脸像小偷？而且不知道为什么，躲在这里堵卡维有种要去敲诈勒索的感觉…"
        },
        {
          "role": "派蒙",
          "text": "明明只是找他问个话…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别这样，搞得我们成坏人了…",
              "dialogues": []
            },
            {
              "text": "事到如今你竟如此有良知？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯？好像有脚步声，快出去看看！"
        },
        {
          "role": "派蒙",
          "text": "站住！卡…"
        },
        {
          "role": "艾尔海森",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "呃？艾尔海森？怎么是你？"
        },
        {
          "role": "艾尔海森",
          "text": "好问题。真叫人惊讶，我以为你们都知道这里是我家。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "早上好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾尔海森",
          "text": "早上好。有什么事？"
        },
        {
          "role": "派蒙",
          "text": "呃我们，那个…呃…没事，没事。"
        },
        {
          "role": "艾尔海森",
          "text": "这样吗，那再见。"
        },
        {
          "role": "派蒙",
          "text": "他走了呢，是不是有工作啊？"
        },
        {
          "role": "旅行者",
          "text": "（好像又有脚步声？朝着门口来了。）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "站住！卡维！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡维",
          "text": "呜哇啊！干嘛呀，怎么是你们？"
        },
        {
          "role": "派蒙",
          "text": "好问题，真叫人惊讶，我以为你知道我们出现在这里肯定是有事找你。"
        },
        {
          "role": "卡维",
          "text": "派蒙，你的口气好不像你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是不是在找一本书？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡维",
          "text": "哎？！"
        },
        {
          "role": "派蒙",
          "text": "是这样的…"
        },
        {
          "type": "subtitle",
          "text": "你和派蒙将卡维拉到一旁，小声分享了来自珐露珊的传闻，并指出有人目击他在智慧宫找东西…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "卡维",
          "text": "…怎么你们都知道了…天哪，我一直觉得我做事很谨慎啊，不应该有人注意到才对。"
        },
        {
          "role": "派蒙",
          "text": "别傻了！你真以为没人知道你住这吗！"
        },
        {
          "role": "卡维",
          "text": "喂！这是什么话！当然没多少人知道了，也就赛诺提纳里柯莱他们几个，还有你们俩知道…吧？"
        },
        {
          "role": "卡维",
          "text": "朋友是朋友，知道就…就知道吧！但这种事被陌生人听去还了得？说不定对工作也有影响…"
        },
        {
          "role": "卡维",
          "text": "言归正传，关于那本书，其实…"
        },
        {
          "role": "派蒙",
          "text": "你是不是相信书里藏着宝藏的信息？想大发一笔？"
        },
        {
          "role": "卡维",
          "text": "呃…嗯…你要帮我找吗？"
        },
        {
          "role": "派蒙",
          "text": "早说啊！原来真的有宝藏！我们帮你找，收益平分，就这么定啦。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，路走多了终于轮到我们发财啦！什么都不用说了，派蒙探测仪，出发！"
        },
        {
          "role": "卡维",
          "text": "哎？喂！派蒙！"
        },
        {
          "type": "subtitle",
          "text": "前往宝商街"
        },
        {
          "role": "派蒙",
          "text": "嗯？那个背影…迪希雅？"
        },
        {
          "role": "迪希雅",
          "text": "旅行者和派蒙？真是好日子，居然能在街上遇到你们俩。"
        },
        {
          "role": "派蒙",
          "text": "迪希雅，你们佣兵消息比较灵通，你听说过一本叫做《推理不分早中晚但悬疑总在暴雪后》的书吗？"
        },
        {
          "role": "迪希雅",
          "text": "等等，难道你们也在找它？"
        },
        {
          "role": "派蒙",
          "text": "「也」的意思难道是你也要它？可恶，我们…我们终于要和迪希雅兵戎相见了吗？"
        },
        {
          "role": "迪希雅",
          "text": "…稍等，方便透露一下你们为什么要找那本书吗？"
        },
        {
          "type": "subtitle",
          "text": "再次分享了来自珐露珊的传闻…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "迪希雅",
          "text": "……"
        },
        {
          "role": "迪希雅",
          "text": "如果这真是很重要的东西，我得到消息一定会共享给你们。"
        },
        {
          "role": "派蒙",
          "text": "哇？！可以吗？刚看你的反应，还以为你也要拿这本书呢。"
        },
        {
          "role": "迪希雅",
          "text": "没关系。虽然确实有雇主想请我帮她弄到这本书，但我觉得她的态度很奇妙，就没接那个委托。"
        },
        {
          "role": "迪希雅",
          "text": "那可是一位相当聪明的人，她好像在隐瞒什么，一定是有别的目的。另外，我也有自己要调查的事。"
        },
        {
          "role": "迪希雅",
          "text": "与委托相比，还是书的真相更重要。事不宜迟，我现在就出发。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，祝你顺利！有消息的话也别忘了告诉我们哦！"
        },
        {
          "role": "旅行者",
          "text": "（不过，迪希雅的雇主会是谁呢？）"
        },
        {
          "role": "卡维",
          "text": "喂——！"
        },
        {
          "role": "卡维",
          "text": "哎，哎呼…呼…你们怎么走得这么快？"
        },
        {
          "role": "派蒙",
          "text": "飞比跑快嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不好意思，生活所迫…",
              "dialogues": []
            },
            {
              "text": "经历得太多了，跑得就快…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡维",
          "text": "好吧，听我说…呼…呼…是这样，是这样的…"
        },
        {
          "role": "卡维",
          "text": "派蒙，你做好心理准备。那本书它…根本不是什么藏宝图，就只是一本普普通通的推理小说。"
        },
        {
          "role": "派蒙",
          "text": "欸？可是刚刚你不是说有吗？一般人这么说，基本都是反悔了想独吞钱…可不对啊，那不像你！"
        },
        {
          "role": "卡维",
          "text": "才不是，我…呃…唉！抱歉，刚刚实在是难以启齿，才将计就计顺着你的话说。"
        },
        {
          "role": "卡维",
          "text": "事情是这样的，一个月前我借阅了这本书，翻开正文第一页就发现有个名字印错了。"
        },
        {
          "role": "卡维",
          "text": "当晚我喝了点酒，不多，有点犯困，就随手拿起一支笔把那个名字圈了出来。"
        },
        {
          "role": "卡维",
          "text": "你应该听说过吧？智慧宫的藏书是允许借阅者做批注的，我也有这个习惯，所以当时并没多想。"
        },
        {
          "role": "卡维",
          "text": "可是继续看了十几页，我发现那本书全都是故意写错一点的人名。"
        },
        {
          "role": "卡维",
          "text": "应该说，小说本身就很奇怪，里面的出场人物姓名全都取材自历史，却不原样挪用，而是改动一点点…"
        },
        {
          "role": "卡维",
          "text": "那种名字拼写，第一眼很容易以为是作者写错或者书刊印刷错误。"
        },
        {
          "role": "卡维",
          "text": "书的内容也不太吸引我，所以我没看完就拿去还了。"
        },
        {
          "role": "卡维",
          "text": "可是后来，听说这本书突然走红了，还有什么神秘宝藏的传闻…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你猜这件事跟你有关？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "确实很难说没有呢。"
        },
        {
          "role": "卡维",
          "text": "是啊…而且听人说，这本书上所有人物名字都被画了圈，不止一个。"
        },
        {
          "role": "卡维",
          "text": "我就是想不明白，从我还书到现在，究竟发生什么事了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你跟人提过借这本书的事吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡维",
          "text": "我想想……呃，提纳里？"
        },
        {
          "role": "卡维",
          "text": "上次见面我还说起这本书里写得很糟糕的地方，结果他说，因为我讲得很好笑，突然也想借来看看了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你这是反向促销啊！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那我们去找提纳里吧！"
        },
        {
          "role": "卡维",
          "text": "好是好，但我手头还有些工作没收尾，挺急的，我先去结束那边的事，再来跟你们会合怎么样？"
        },
        {
          "role": "派蒙",
          "text": "没问题，加油工作哦。"
        },
        {
          "role": "卡维",
          "text": "嗯，多谢啦，那回头见。"
        },
        {
          "type": "subtitle",
          "text": "与提纳里对话"
        },
        {
          "type": "subtitle",
          "text": "心声（提纳里）"
        },
        {
          "role": "提纳里",
          "text": "最近想看一些趣味性强的科普读物…"
        },
        {
          "role": "派蒙",
          "text": "看到了看到了，在那边呢。喂——提纳里呀——"
        },
        {
          "role": "提纳里",
          "text": "听见了听见了。旅行者和派蒙怎么了吗？一脸激动的样子。"
        },
        {
          "type": "subtitle",
          "text": "跟提纳里说起你正在找那本名为《推理不分早中晚但悬疑总在暴雪后》的小说。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与此同时你在心中默默评价：书名真长啊，说一次好累…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "提纳里",
          "text": "原来是这本。嗯，我确实去智慧宮借阅了它。卡维说不好看，我出于好奇，就找来看了。"
        },
        {
          "role": "提纳里",
          "text": "问题在于，我借到的书上被人画了两个圈，而且画圈的习惯还不一样。"
        },
        {
          "role": "提纳里",
          "text": "就像一个游戏，有人给第一个出现的人名画了红圈，接着又有另一个人给另外的人名画了绿圈。"
        },
        {
          "role": "派蒙",
          "text": "意思是，从卡维还书到你借书，这中间书被人为做过记号？"
        },
        {
          "role": "提纳里",
          "text": "是的。"
        },
        {
          "role": "派蒙",
          "text": "我跟你说，第一个圈是卡维画的哦。"
        },
        {
          "role": "提纳里",
          "text": "嗯，不太意外呢。"
        },
        {
          "role": "提纳里",
          "text": "那第二个记号的作者，随便想想应该也能猜到吧？"
        },
        {
          "role": "派蒙",
          "text": "难道是…"
        },
        {
          "role": "提纳里",
          "text": "假如一栋房屋内住着两个人。其中一人画了第一个圈，那另一个人很可能也留下了什么记号。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很有道理呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "提纳里",
          "text": "唉，有时觉得那两个人未免太离谱了。我看完那本书，发现第一页第一个带圈的名字果然就是凶手。"
        },
        {
          "role": "提纳里",
          "text": "这不是明晃晃的剧透吗？就像笑话里说的那样，翻开小说，第一眼就被别人的标注剧透的彻彻底底。"
        },
        {
          "role": "派蒙",
          "text": "什么笑话这么残酷…"
        },
        {
          "role": "提纳里",
          "text": "居勒什说的。也不全是笑话吧，他说他年轻时这样恶作剧过。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "谁那么倒霉借到他画过的书？"
        },
        {
          "role": "提纳里",
          "text": "我的老师纳菲斯，还有那天下午和他一起开研讨会的萨赫哈蒂女士。"
        },
        {
          "role": "提纳里",
          "text": "听居勒什说，老师放话要把他堵在智慧宫侧门打一顿，还是我母亲和萨赫哈蒂女士拦着才没让那事发生…"
        },
        {
          "role": "派蒙",
          "text": "真没法同情居勒什，一丁点儿都不能！"
        },
        {
          "role": "提纳里",
          "text": "智慧宫向来不禁止人们在书上做笔记，但这本书情况有些特别，我认为，不能放任它以这个样子流通下去。"
        },
        {
          "role": "提纳里",
          "text": "所以，我也找了几个人名圈起来，混淆视听。"
        },
        {
          "role": "派蒙",
          "text": "呃…"
        },
        {
          "role": "提纳里",
          "text": "想藏起一片树叶，最好的办法就是把它放进树林。很简单的思路吧。"
        },
        {
          "role": "派蒙",
          "text": "话是没错啦，但…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "提纳里，你画了几个名字？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "提纳里",
          "text": "我想想……不多，就三四个吧？都是随机挑选的。"
        },
        {
          "role": "派蒙",
          "text": "那书上其他名字是谁圈的啊？"
        },
        {
          "role": "提纳里",
          "text": "说明还有其他借阅者做了类似的事，只是不清楚动机。"
        },
        {
          "role": "派蒙",
          "text": "我现在觉得借书是一件很复杂的事了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（提纳里）"
        },
        {
          "role": "提纳里",
          "text": "看来那本书有故事啊…"
        },
        {
          "type": "subtitle",
          "text": "前往宝商街"
        },
        {
          "role": "派蒙",
          "text": "好，我们再去找找有没有别的线索，多打听一定能问到新消息。"
        },
        {
          "type": "subtitle",
          "text": "心声（迪希雅）"
        },
        {
          "role": "迪希雅",
          "text": "真没想到事情会变成这样。下次我得多留神。"
        },
        {
          "type": "subtitle",
          "text": "心声（坎蒂丝）"
        },
        {
          "role": "坎蒂丝",
          "text": "很久没过来，这一带还是老样子呢。"
        },
        {
          "role": "派蒙",
          "text": "你看，迪希雅在那边，我们把真相告诉她吧。"
        },
        {
          "role": "派蒙",
          "text": "欸？坎蒂丝也在呢。"
        },
        {
          "role": "迪希雅",
          "text": "…所以，我要为自己的所作所为小小反省一下。"
        },
        {
          "role": "派蒙",
          "text": "发生什么事了吗？"
        },
        {
          "role": "坎蒂丝",
          "text": "能在今日见到你们两位，一定是神明的指引。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "坎蒂丝是来玩的吗？"
        },
        {
          "role": "坎蒂丝",
          "text": "今天我是替阿如村的各位过来城里采买东西，顺便帮忙碌的塞塔蕾小姐送信给教令院的贤者。"
        },
        {
          "role": "坎蒂丝",
          "text": "路上见到迪希雅一脸忧郁地坐在咖啡馆，就过来陪她聊天了。"
        },
        {
          "role": "迪希雅",
          "text": "别担心，没出大事。只是跟你们聊过以后，我想起有关那本书的细节。"
        },
        {
          "role": "迪希雅",
          "text": "早在雇主联系我之前，我就听说有本藏着秘密的精彩小说，出于好奇拜托赛诺帮我借来了。"
        },
        {
          "role": "迪希雅",
          "text": "我是沙漠人嘛，又是做佣兵的，对解开藏宝图之谜有点兴趣。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，非常能理解。"
        },
        {
          "role": "坎蒂丝",
          "text": "寻找沙子中的黄金与智慧，我们从神明那里继承了这般习俗。"
        },
        {
          "role": "迪希雅",
          "text": "但实际上，那本书一点都不好看，书里的人名还被画了许多圈，我从头到尾认真看完也不明白所谓的谜题是什么。"
        },
        {
          "role": "迪希雅",
          "text": "最后我开始思考，难道这是某种仪式或者游戏？就拿起笔，也在上面画了一个圈。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪希雅",
          "text": "但是后来，迪娜泽黛小姐也托父母想办法借到这本书，她说书上的神秘记号让她非常在意，有点看不进书了。"
        },
        {
          "role": "迪希雅",
          "text": "假如是文字批注倒也没什么，可一个个匪夷所思的圆圈，实在很难不去猜测。"
        },
        {
          "role": "坎蒂丝",
          "text": "确实是这样。那么迪希雅，你所反省的就是这不经意间干扰了他人阅读时光的行为，对吗？"
        },
        {
          "role": "迪希雅",
          "text": "是的。"
        },
        {
          "role": "派蒙",
          "text": "等一下等一下！为什么要跟坎蒂丝说啊！"
        },
        {
          "role": "迪希雅",
          "text": "她是战士嘛，有时也会负责拷问犯人什么的。大家都认可这份工作很神圣，慢慢地反省时也会说给她听。"
        },
        {
          "role": "坎蒂丝",
          "text": "请不要太惊讶，亲爱的旅行者。对我而言，聆听他人的错误也是「守护」的方式之一。"
        },
        {
          "role": "坎蒂丝",
          "text": "说出自身的错，听取真诚的建议，事情便会慢慢好转。这是我们做事的方式。"
        },
        {
          "role": "派蒙",
          "text": "可是，她只是画了一个圈，又不是故意的…而且大家都说那本书不好看，迪希雅不要放在心上啦。"
        },
        {
          "role": "迪希雅",
          "text": "唔，这倒是，我刚还跟坎蒂丝说呢，书的内容确实莫名其妙…"
        },
        {
          "role": "坎蒂丝",
          "text": "但不管怎么说，干扰别人看书肯定不是什么好事。该说的还是要说。"
        },
        {
          "role": "坎蒂丝",
          "text": "那么迪希雅，请相信神明会原谅你这一作为。"
        },
        {
          "role": "坎蒂丝",
          "text": "再说，听你描述的情节，案件中的一个嫌疑人四肢着地爬行离开了山庄，而这个人物被取名为…「阿玛赫尔」。"
        },
        {
          "role": "迪希雅",
          "text": "对。书中的侦探认为他以蛙跳的方式一跃经过断桥，当然这个想法在后来的推理中根本不成立。"
        },
        {
          "role": "派蒙",
          "text": "为什么呢？"
        },
        {
          "role": "迪希雅",
          "text": "因为实际上「阿玛赫尔」拥有一般人没有的能力，他可以漂浮飞过断桥。"
        },
        {
          "role": "派蒙",
          "text": "…这书到底在写什么玩意儿…太莫名其妙了。"
        },
        {
          "role": "坎蒂丝",
          "text": "「阿玛赫尔」，怎么想都避不开赤王大人的尊名吧？对于此等僭越之作，还是不要太在意为好。"
        },
        {
          "role": "迪希雅",
          "text": "说得也是。唉，我在想，缄默之殿那群家伙看到这本书，不知道是什么表情。"
        },
        {
          "role": "坎蒂丝",
          "text": "那些智者大概能从书里读出我们常人想象不到的趣味吧。"
        },
        {
          "role": "派蒙",
          "text": "暴雪山庄外面有桥，很正常，桥被弄断了，也很正常，可是有人能漂浮在半空飞过整座桥…写这个情节干嘛呀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这真的是严格的推理小说吗？",
              "dialogues": []
            },
            {
              "text": "怎么像搞笑漫画？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我理解珐露珊了，满怀期待地打开一本推理小说，就看到这种东西…呃，算了我不要想。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "对了，这本书现在在哪里？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪希雅",
          "text": "目前还不清楚。我看完早就还了，而且那时书上也还没有传闻中说的那么多记号。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那我们继续加油调查！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（迪希雅&坎蒂丝）"
        },
        {
          "role": "迪希雅",
          "text": "唉，谁能想到这种事啊？"
        },
        {
          "role": "坎蒂丝",
          "text": "正因为无从预料，才更不应该责备自己呀。"
        },
        {
          "type": "subtitle",
          "text": "前往智慧宫"
        },
        {
          "role": "派蒙",
          "text": "有点没方向了，要不然，回智慧宫看看？"
        },
        {
          "role": "派蒙",
          "text": "你好，我们想问问《推理不分早中晚但悬疑总在暴雪后》被还回来了吗？"
        },
        {
          "role": "卡塔扬",
          "text": "这本书有两册，一册有记号，一册没有，我猜你们想借阅的是有记号的那本，对吧。"
        },
        {
          "role": "派蒙",
          "text": "哦哦，完全被看穿了哦…"
        },
        {
          "role": "卡塔扬",
          "text": "这么问的人很多，但很抱歉，书目前还没有被还回来。你们可以过阵子再来。"
        },
        {
          "role": "派蒙",
          "text": "不能透露一下谁借走了吗？"
        },
        {
          "role": "卡塔扬",
          "text": "这个嘛，从记录上看，只要还没到归还日期，我们就会静候。"
        },
        {
          "role": "卡塔扬",
          "text": "贸然透露借阅者的信息并不合理，请恕我基于职业操守对此保密。"
        },
        {
          "role": "派蒙",
          "text": "也是呢，万一有人为了抢书去找别人的麻烦就糟糕了…"
        },
        {
          "role": "？？？",
          "text": "呀，你们晕头转向的样子好像两只撞到脑袋的兰那罗呢。是在找什么东西吗？我来帮你吧。"
        },
        {
          "role": "派蒙",
          "text": "是纳西妲的声音！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好呀。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "纳西妲！你知道有本书叫做《推理不分早中晚但悬疑总在暴雪后》吗？"
        },
        {
          "role": "纳西妲",
          "text": "好长的书名，不过，嗯，我知道哦。"
        },
        {
          "role": "纳西妲",
          "text": "听说大家都在找这本书，很有魅力的样子，我就也找了这本书的另一本全新版本来看。"
        },
        {
          "role": "派蒙",
          "text": "全新的意思是，不是被做过标记的那本？"
        },
        {
          "role": "纳西妲",
          "text": "嗯。比起宝藏的传闻，我更好奇书中写了什么，所以只要看到原文就够了。"
        },
        {
          "role": "纳西妲",
          "text": "说起来，很有趣，这本书不止一册，但大家都在找被圈了名字的那版，究竟是害怕被剧透，还是渴望被剧透呢？"
        },
        {
          "role": "派蒙",
          "text": "啊，那你知道有记号的那本现在在谁手上吗？"
        },
        {
          "role": "纳西妲",
          "text": "我碰巧见过你的一位朋友拿着那本书，你若想见到传说中的书刊，就去卡萨扎莱宫一带吧。"
        },
        {
          "type": "subtitle",
          "text": "前往卡萨扎莱宫"
        },
        {
          "role": "派蒙",
          "text": "那边是…欸？多莉和赛诺，还有赛索斯？"
        },
        {
          "role": "多莉",
          "text": "呀啊——！可恶的大风纪官，钓鱼执法行不通的，你不能这样！"
        },
        {
          "role": "赛索斯",
          "text": "哎哎哎，怎么就钓鱼执法了？"
        },
        {
          "role": "赛索斯",
          "text": "是你说你手上有这本书，我说我要看，你就约我在这里见面。碰巧赛诺也在，单纯的巧合而已嘛！"
        },
        {
          "role": "多莉",
          "text": "噢你这家伙，我可认得你哟！你是那个新来的叫赛索斯的小兄弟，对不对？我知道你是赛诺的朋友呢。"
        },
        {
          "role": "赛索斯",
          "text": "唔？原来你认得我。"
        },
        {
          "role": "多莉",
          "text": "上回见到赛诺追着你打牌，你打了两局就找借口溜了，印象很深。"
        },
        {
          "role": "赛索斯",
          "text": "这种事情不分享也可以的。"
        },
        {
          "role": "赛诺",
          "text": "不，这一点我认为多莉说得对，你对七圣召唤的态度显然是逃避，很成问题。"
        },
        {
          "role": "赛诺",
          "text": "旅行者，派蒙，在旁边站了好一会儿了吧。"
        },
        {
          "role": "多莉",
          "text": "噢！这不是这不是…这不是亲爱的旅行者和派蒙吗？什么风把你们吹到卡萨扎莱宫来了！"
        },
        {
          "role": "多莉",
          "text": "莫非，是有生意要找我桑歌玛哈巴依老爷？啊哈哈，当然好！稍等片刻，我结束这边的交易就来陪你。"
        },
        {
          "role": "多莉",
          "text": "言归正传吧，大风纪官大人，你应该知道我是用绝对正规、万分合理的手段托人从智慧宫借阅了这本书才对。"
        },
        {
          "role": "多莉",
          "text": "既然还没到还书日期，你就不能以任何方式抢夺我借来的书本。"
        },
        {
          "role": "赛诺",
          "text": "那只是你没有异常举动的情况。"
        },
        {
          "role": "赛诺",
          "text": "而就在刚才，买家赛索斯根据神秘信息来到卡萨扎莱宫与卖家接头，妄图购入一本推理小说。"
        },
        {
          "role": "多莉",
          "text": "什么买家，他是你安排的人吧！故意来买东西，引我现身？"
        },
        {
          "role": "赛诺",
          "text": "对此我不能认可。我只能告诉你，我注意这本书有段时间了。记住，任何人都不得私自贩卖、转让借自智慧宫的书。"
        },
        {
          "role": "多莉",
          "text": "哼哼…我可没有要卖哦，我只是顺水推舟，别人付我一点摩拉，我就借他「看看」这本神奇的小说。"
        },
        {
          "role": "多莉",
          "text": "不信你问买家，啊不不，好奇的读者！对对，你是读者。总之，我只是拿出这本书给他看看。"
        },
        {
          "role": "赛诺",
          "text": "…是吗？赛索斯，亏我以为你真的要进行这种非法交易。"
        },
        {
          "role": "多莉",
          "text": "哎？什么，你们真的不是一伙的？"
        },
        {
          "role": "赛索斯",
          "text": "…唉，我只是太好奇这本书了。好不容易顺藤摸瓜来到这里，不过赛诺，多莉确实没有明确说过她要「贩卖」书。"
        },
        {
          "role": "赛诺",
          "text": "…啧。难道她不是这一切的始作俑者？"
        },
        {
          "role": "多莉",
          "text": "什么始作俑者？呵呵呵，按照你们的说法，大风纪官大人或许只是来早了呢。我可不要把书交出来。"
        },
        {
          "role": "赛诺",
          "text": "哼。你以为你打出了一张王牌，但是，多莉，刚才你翻开书的一瞬间我就看到了，还书日期是今天！"
        },
        {
          "role": "多莉",
          "text": "呃…！！"
        },
        {
          "role": "派蒙",
          "text": "赛诺视力真好！"
        },
        {
          "role": "赛诺",
          "text": "是的。我的眼睛很好。距离还书时间不到半小时了，把书给我，我会将它带回。"
        },
        {
          "role": "多莉",
          "text": "唔…怎么能，怎么能就这样交给你…这可是宝藏般神秘的超级无敌不讲理推理小说，我要靠它小发一笔！"
        },
        {
          "role": "赛索斯",
          "text": "你确定这些话可以说出来吗…"
        },
        {
          "role": "多莉",
          "text": "我又没有真的卖！说说而已嘛。"
        },
        {
          "role": "赛索斯",
          "text": "那这样吧，多莉，赛诺，你们赌上那本书简单地比试一下不就好了？"
        },
        {
          "role": "赛诺",
          "text": "这倒是个办法。多莉，敢挑战吗？你要是赢了，我暂不追究书的事，你要是输了，就把书给我。"
        },
        {
          "role": "多莉",
          "text": "哦？听起来还算有点意思。好，我入局，要怎么比？"
        },
        {
          "role": "赛索斯",
          "text": "你们二位对自己的记忆力有信心吗？"
        },
        {
          "role": "多莉",
          "text": "还算不错。"
        },
        {
          "role": "赛诺",
          "text": "有。"
        },
        {
          "role": "赛索斯",
          "text": "你们都读过这本书的内容了，对吗？"
        },
        {
          "role": "赛诺",
          "text": "没错。"
        },
        {
          "role": "多莉",
          "text": "欸？赛诺居然看过？唔唔…不用说，我当然也是看过的。"
        },
        {
          "role": "赛索斯",
          "text": "那么，我随便打开书翻几页，告诉我上面有多少个名字被画了圈。三局定胜负，怎么样？"
        },
        {
          "role": "多莉",
          "text": "咦？！这么刁钻？"
        },
        {
          "role": "赛诺",
          "text": "怎么，你退缩了？"
        },
        {
          "role": "多莉",
          "text": "不，比就比。开始吧！"
        },
        {
          "role": "赛索斯",
          "text": "好，那么，第一页。"
        },
        {
          "role": "多莉",
          "text": "六个！"
        },
        {
          "role": "赛诺",
          "text": "六个。"
        },
        {
          "role": "赛索斯",
          "text": "全对。接下来，第二页。"
        },
        {
          "role": "多莉",
          "text": "唔…好像是四个？"
        },
        {
          "role": "赛诺",
          "text": "四个吧。"
        },
        {
          "role": "赛索斯",
          "text": "哦！竟然也都答对了！两次平手，让我们期待下一题的结果。请听题！"
        },
        {
          "role": "多莉",
          "text": "唔唔。"
        },
        {
          "role": "赛索斯",
          "text": "——第六十一页。"
        },
        {
          "role": "多莉",
          "text": "呃？这…呃…我…我不太记得了，七个？"
        },
        {
          "role": "赛诺",
          "text": "我知道。答案是…五个！"
        },
        {
          "role": "赛索斯",
          "text": "回答完全正确！答案就是五个。"
        },
        {
          "role": "多莉",
          "text": "呃啊！赛诺，你、你记性真的这么好吗？我不信！"
        },
        {
          "role": "派蒙",
          "text": "怎么做到的？"
        },
        {
          "role": "赛诺",
          "text": "其实，不是我记性好，是我正好对这本书上的圈印象很深。"
        },
        {
          "role": "赛诺",
          "text": "我借到书之后，发现前几页上的人名被人挑着画了圈。"
        },
        {
          "role": "赛诺",
          "text": "每个人的笔迹都不一样，而且，我认出来有三个圈是提纳里画的。他用的墨水颜色很稀奇，一眼就能辨别。"
        },
        {
          "role": "派蒙",
          "text": "你这都知道？"
        },
        {
          "role": "赛诺",
          "text": "嗯，很早就知道。那时我刚当大风纪官不久，如果想找个人少的地方一口气忙完所有琐事，就会去秘密基地。"
        },
        {
          "role": "赛诺",
          "text": "我在树上遇到过躲在那儿做作业的提纳里，很容易就注意到他常用的文具了。这么多年，他一直没换墨水。"
        },
        {
          "role": "赛诺",
          "text": "说回那本书。看完的人都知道，第一个被圈起来的名字正是凶手。提纳里也许不希望别人剧透，才在书上画了圈。"
        },
        {
          "role": "赛诺",
          "text": "做标注本身不违反借书规则。但书上有不止一种笔迹，为什么？记号背后是否有阴谋？这些又与提纳里有什么关系？"
        },
        {
          "role": "赛诺",
          "text": "即便是为了朋友，我也要查清此事。而了解秘密，就要混入这个计划。所以，我将书上剩下所有的人名都圈了起来！"
        },
        {
          "role": "多莉",
          "text": "啊——！竟然做出这种事…根本没有什么宝藏，就是你们这些家伙干的啊！"
        },
        {
          "role": "赛诺",
          "text": "没错。想要藏起一粒沙子，就应该埋到沙漠里去。靠着这粒沙，我也能窥见真相。"
        },
        {
          "role": "赛诺",
          "text": "而你被这件事吸引，企图做些什么，又被我意外撞见。天网恢恢，疏而不漏。"
        },
        {
          "role": "多莉",
          "text": "在那说什么漂亮话呢？你真的，真的是一个，好有闲心的人…我服了，我认输。"
        },
        {
          "role": "多莉",
          "text": "咳咳，今天就到这里吧，桑歌玛哈巴依老爷该回房间休息了。各位，回见啦！"
        },
        {
          "role": "赛诺",
          "text": "所以，你要这本书是想带回缄默之殿吗？"
        },
        {
          "role": "赛索斯",
          "text": "听说里面有宝藏，还以为跟我们那有什么关系呢，没想到真相是这样。就当帮你一个小忙喽。"
        },
        {
          "role": "赛索斯",
          "text": "不过在你答应比试的时候，我就猜到你很了解这本书了，才提出那样的胜负形式。"
        },
        {
          "role": "赛诺",
          "text": "好哥们，你真聪明！"
        },
        {
          "role": "赛诺",
          "text": "嗯？你们俩表情有点难看啊。"
        },
        {
          "role": "派蒙",
          "text": "我们只是觉得，这本书的经历未免有点…太波折了…"
        },
        {
          "role": "赛索斯",
          "text": "哎呀，拿回来就好，其他的秘密就留给你们去探索吧。那我先走一步，各位，再会。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那本书，能借我看看吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "赛诺",
          "text": "当然。"
        },
        {
          "type": "subtitle",
          "text": "接过赛诺递来的书，你和派蒙匆匆翻阅起来。尽管看得不够仔细，也已经品出几分不妙…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "小说剧情天马行空，而且确实如大家所说，书上的名字大都眼熟，细看又不是你以为的那个历史人物名字。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "此外，每个人名都被画了圈。想到整件事的过程，你沉默了…接着，你说明了事情的始末。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "赛诺",
          "text": "…没想到。好吧，也合理，而且，这总比真有什么阴谋要好得多。"
        },
        {
          "role": "赛诺",
          "text": "我接下来另有安排，上次在喀万驿约好要请迪希雅和坎蒂丝喝酒。旅行者，能麻烦你代劳一下还书的事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可以，给我吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "赛诺",
          "text": "好朋友，谢了。"
        },
        {
          "type": "subtitle",
          "text": "返回智慧宫"
        },
        {
          "role": "派蒙",
          "text": "总算回来了，总之，先把这本书还过去…"
        },
        {
          "role": "卡维",
          "text": "你们真的找到书了？真厉害，我一直等在这里，就是想第一时间见见它。"
        },
        {
          "type": "subtitle",
          "text": "你们将之前的事复述给卡维听…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "卡维",
          "text": "啊？怎么会有这种事？这、这…我圈到了凶手？！"
        },
        {
          "role": "派蒙",
          "text": "整件事太让我惊讶了…"
        },
        {
          "role": "卡维",
          "text": "…还是先解决书的问题吧。"
        },
        {
          "role": "卡维",
          "text": "你好，这本书，呃…可能还得怪我用了没法擦除的笔在书上做记号，才引发后面一系列事。"
        },
        {
          "role": "卡维",
          "text": "现在它被画成这样，有剧透风险，我想买下它。教令院用我付的书款重新买一本新的，应该就能避免问题了。"
        },
        {
          "role": "卡维",
          "text": "能考虑一下我的提议吗？"
        },
        {
          "role": "卡塔扬",
          "text": "…卡维先生，您的想法很有道理，确实是个好办法。我马上确认书本的价格，稍后请到那边付款。"
        },
        {
          "role": "卡维",
          "text": "好的好的，谢谢你！"
        },
        {
          "type": "subtitle",
          "text": "不久后，卡维跟着教令院工作人员去登记了购书信息，付清了书款。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "工作人员将被画得面目全非的旧书包装起来，交给了他。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "卡维",
          "text": "真是一场乌龙…但不管怎么说，非常感谢你们的帮助。"
        },
        {
          "role": "派蒙",
          "text": "没关系啦，也算是凑到热闹了。不过卡维，下次别再用擦不掉的颜色做笔记比较好…"
        },
        {
          "role": "卡维",
          "text": "我明白，我再也不会下意识挑排版错误了…"
        },
        {
          "role": "卡维",
          "text": "不！短时间内我绝对不会再借这种书名很长的书了！"
        },
        {
          "type": "subtitle",
          "text": "跟上离开的卡维"
        },
        {
          "role": "卡维",
          "text": "啊，艾尔海森！你在这里啊！找了半天。"
        },
        {
          "role": "艾尔海森",
          "text": "怎么了？"
        },
        {
          "role": "卡维",
          "text": "哈哈…你猜这个纸包里有什么？"
        },
        {
          "role": "艾尔海森",
          "text": "我猜是一个年轻人悔恨的泪水。"
        },
        {
          "role": "卡维",
          "text": "唉你知道什么呀！是那本《推理不分早中晚但悬疑总在暴雪后》。"
        },
        {
          "role": "艾尔海森",
          "text": "你竟然能把这荒谬又无趣的书名念得滚瓜烂熟？"
        },
        {
          "role": "卡维",
          "text": "因为我刚刚去办买书手续，在教令院办公室报了好几遍书名。"
        },
        {
          "role": "艾尔海森",
          "text": "看来你已经是这本书的新主人了。"
        },
        {
          "role": "卡维",
          "text": "还不是因为我不小心在书上画了擦不掉的圈！"
        },
        {
          "role": "卡维",
          "text": "你知道吗，提纳里，迪希雅，赛诺，这些人都在书上圈了人名，而起因就是我圈出的那个角色名是凶手。"
        },
        {
          "role": "艾尔海森",
          "text": "噢，实不相瞒，看见第一个圆圈里是凶手名字的那一刻，我就猜到会这样。"
        },
        {
          "role": "卡维",
          "text": "等等，你怎么也看过这本书？"
        },
        {
          "role": "艾尔海森",
          "text": "以前在智慧宫有幸读过。逻辑混乱，写得也不怎么样。"
        },
        {
          "role": "艾尔海森",
          "text": "而且你把这本书摊在了书房里。"
        },
        {
          "role": "卡维",
          "text": "所以你知道我圈了凶手？？那…那这上面有你画的圈吗？"
        },
        {
          "role": "艾尔海森",
          "text": "你觉得呢？"
        },
        {
          "role": "卡维",
          "text": "…那就是有？"
        },
        {
          "role": "艾尔海森",
          "text": "第二个就是我画的。"
        },
        {
          "role": "卡维",
          "text": "为什么啊？！"
        },
        {
          "role": "艾尔海森",
          "text": "要避免剧透，最好的办法就是增加误导信息。"
        },
        {
          "role": "卡维",
          "text": "那为什么只画一个？提纳里都画了三个呢。"
        },
        {
          "role": "艾尔海森",
          "text": "我将下一位借阅者被剧透凶手的概率降低这么多，已经够意思了。其他挽回不了的情况没必要理会。"
        },
        {
          "role": "卡维",
          "text": "怎么就没必要了？"
        },
        {
          "role": "艾尔海森",
          "text": "用擦不掉的墨水在第一页画圈，那显然无可挽回。"
        },
        {
          "role": "卡维",
          "text": "什么啊，你就只是觉得好玩才圈的吧！"
        },
        {
          "role": "艾尔海森",
          "text": "非要说的话，这些记号都比这本书本身有趣得多。"
        },
        {
          "role": "卡维",
          "text": "…唉，说得也是。"
        },
        {
          "role": "卡维",
          "text": "归根结底，谁让我把铅笔用完了呢…我得去买点新的。"
        },
        {
          "role": "艾尔海森",
          "text": "恭喜。这本书上有那么多人的亲笔作品，现在，独一无二的绝版书归你了。"
        },
        {
          "role": "卡维",
          "text": "你看我像高兴的样子吗！唉…我可不想要…"
        },
        {
          "role": "派蒙",
          "text": "啊哈哈…换做是我，我也不想要！"
        },
        {
          "role": "旅行者",
          "text": "（我也不想要呢…）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（妮露）须弥 大巴扎舞台上"
        },
        {
          "role": "溪泉",
          "text": "喔！不愧是仙子大人起舞的地方，真是片夺目的荷叶舞台。"
        },
        {
          "role": "杏仁",
          "text": "嗯…老夫也开眼了，不…不过，仙子大人，那边好像有只狗一直盯着我们…"
        },
        {
          "role": "妮露",
          "text": "啊，那是斯汪，它脾气很好的，从不咬人。"
        },
        {
          "role": "斯汪",
          "text": "汪汪！"
        },
        {
          "role": "妮露",
          "text": "哈哈，斯汪乖，好久都没见到你了呢，这边的青蛙和胖胖鼠不能吃哟。"
        },
        {
          "role": "帕蒂沙兰",
          "text": "不能吃哟！"
        },
        {
          "role": "斯汪",
          "text": "汪！"
        },
        {
          "role": "杏仁",
          "text": "啊…哈哈，可真是一只通得人性的乖狗狗。溪泉，我出发前就和你说吧，外面的世界也没有那么危险。"
        },
        {
          "role": "溪泉",
          "text": "嗯，这倒没错。但…长老…你为什么要躲在我背后啊？"
        },
        {
          "role": "妮露（心声）",
          "text": "（待会儿去台上舞一曲吧。）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（纳西妲&流浪者）须弥 教令院"
        },
        {
          "role": "流浪者",
          "text": "……"
        },
        {
          "role": "纳西妲",
          "text": "教令院的人说这段时间都没见到你呢。"
        },
        {
          "role": "流浪者",
          "text": "待得闷了出去走走都不行吗？这里是学校还是监狱？"
        },
        {
          "role": "纳西妲",
          "text": "我没说不行哦，只是看你心情不错的样子。"
        },
        {
          "role": "流浪者",
          "text": "嘁…"
        },
        {
          "role": "小杜林",
          "text": "阿帽，这是谁呀？"
        },
        {
          "role": "流浪者",
          "text": "闭嘴， 别出声。"
        },
        {
          "role": "纳西妲",
          "text": "交到新朋友了？"
        },
        {
          "role": "流浪者",
          "text": "…说了别看我在想什么。"
        },
        {
          "role": "纳西妲",
          "text": "我没看哟，都写在你脸上了。"
        },
        {
          "role": "流浪者",
          "text": "啧…"
        },
        {
          "role": "流浪者（心声）",
          "text": "（…麻烦死了。）"
        }
