{
  "quest_id": 72243,
  "chapter_num": null,
  "chapter_title": "食莲者后续玛乔丽$HIDDEN",
  "type": "wq",
  "route": "Lotus Eater Epilogue: Marjorie",
  "stories": [
    {
      "story_id": 72243,
      "title": "食莲者后续玛乔丽$HIDDEN",
      "description": "",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "我有宝物想要出售。"
        },
        {
          "role": "玛乔丽",
          "text": "出售宝物？真是令人意外。"
        },
        {
          "role": "玛乔丽",
          "text": "像您这样强大的冒险家，想要出售的东西一定很罕见吧？"
        },
        {
          "role": "玛乔丽",
          "text": "快请让我看看。"
        },
        {
          "role": "？？？",
          "text": "将龙骨花凝珠的故事告诉了玛乔丽。"
        },
        {
          "role": "玛乔丽",
          "text": "啊，这不是就像是吟游诗人的故事里说的忘忧果吗？"
        },
        {
          "role": "玛乔丽",
          "text": "居然真的有这种东西存在吗…原来它叫龙骨花凝珠。"
        },
        {
          "role": "玛乔丽",
          "text": "如果它的效果真的和您所说的一样，我愿意花80000摩拉加一些特色料理买下它。"
        },
        {
          "role": "玛乔丽",
          "text": "嗯…80000摩拉加上5个月亮派，您觉得怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你会拿它做什么？",
            "公道的价格，成交。",
            "我再考虑一下。"
          ]
        },
        {
          "role": "旅行者",
          "text": "你会拿它做什么？"
        },
        {
          "role": "玛乔丽",
          "text": "嘻嘻，多么独特的宝物呀。"
        },
        {
          "role": "玛乔丽",
          "text": "童话一般的神奇功效，我相信那些炼金术士们不会吝惜自己的钱包。"
        },
        {
          "role": "旅行者",
          "text": "关于龙骨花凝珠。"
        },
        {
          "role": "玛乔丽",
          "text": "怎么样？是不是我的价格最合适了，嘻嘻。"
        },
        {
          "role": "玛乔丽",
          "text": "如果卖给我的话，我出的价格是80000摩拉加5个月亮派，还不差吧?"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "就决定卖给你了。",
            "我还要再考虑一下。"
          ]
        },
        {
          "role": "旅行者",
          "text": "就决定卖给你了。"
        },
        {
          "role": "玛乔丽",
          "text": "那我就收下这件宝物了，多谢惠顾。"
        },
        {
          "role": "玛乔丽",
          "text": "对了，通常来说，这种凝珠类的物品会在风中缓慢挥发。"
        },
        {
          "role": "玛乔丽",
          "text": "所以，最好将它覆上隔膜或者放进容器密封起来，这样成色会更好。"
        },
        {
          "role": "玛乔丽",
          "text": "这是一点附送您的小技巧，希望对您的冒险有帮助。"
        },
        {
          "role": "玛乔丽",
          "text": "如果今后您又找到了类似的宝物，别忘了，这里有你忠实的买家。"
        }
      ]
    }
  ]
}