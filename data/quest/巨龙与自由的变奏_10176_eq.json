{
  "quest_id": 10176,
  "chapter_num": "捕风的归客 其三",
  "chapter_title": "巨龙与自由的变奏",
  "type": "eq",
  "route": "Variations on the Song of the Dragon and Freedom",
  "stories": [
    {
      "story_id": 40231,
      "title": "巨龙与自由的变奏",
      "description": "第二天的测试也圆满结束，在一场快乐的宴会后，你终于迎来了第三天，也就是故事结局部分的测试…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到第二天（8-10点）"
        },
        {
          "type": "subtitle",
          "text": "前往骑士团参与测试"
        },
        {
          "role": "派蒙",
          "text": "来了来了，我们准备出发吧…欸？！"
        },
        {
          "role": "派蒙",
          "text": "这个泡泡之前不是这个颜色啊，怎么回事，难道它生病了？"
        },
        {
          "role": "尼可",
          "text": "我也不知道是怎么回事，早上我刚到这里，打算做一些入场前的检查，结果就发现它变成了这样。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是深渊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸，深渊？！不会吧，深渊力量是怎么跑进去的？"
        },
        {
          "role": "法尔伽",
          "text": "果然你对这种力量形式很敏感，其实我在看到的时候也想到了这种可能性，但似乎又有些区别。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，我也很难形容…",
              "dialogues": []
            },
            {
              "text": "虽然很像深渊，但暂时没有危害。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪卢克",
          "text": "这是什么意思？"
        },
        {
          "role": "温迪",
          "text": "「雏形」，或许可以理解为尚未孵化的鸟蛋，或者暴雨前的乌云，更像是一种灾难的预兆。"
        },
        {
          "role": "尼可",
          "text": "因为魔法泡泡内部的世界是虚构的，这种深渊力量也是被虚构出来的…暂时可以这么理解。"
        },
        {
          "role": "派蒙",
          "text": "艾莉丝，这个魔法是你发明的对吧，你知道是什么原因吗？"
        },
        {
          "role": "艾莉丝",
          "text": "新魔法出问题的情况多了去了，千奇百怪，无所不有，现在这样也没什么大惊小怪的。"
        },
        {
          "role": "艾莉丝",
          "text": "只是你问我具体是什么原因，该怎么解决，我只能说还需要更多的观察才能确定。"
        },
        {
          "role": "琴",
          "text": "现在看来，有危险的可能性，那它就不能作为普通蒙德市民的娱乐场所。"
        },
        {
          "role": "琴",
          "text": "抱歉，艾莉丝女士，和可莉的约定，恐怕要食言了。"
        },
        {
          "role": "艾莉丝",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "从、从来没见过艾莉丝这么严肃的表情。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "和可莉失约这件事…",
              "dialogues": []
            },
            {
              "text": "可能比多托雷的麻烦更让她气恼。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾莉丝",
          "text": "前所未有的大危机，现在就考虑放弃还太早了，我们商量下对策吧。"
        },
        {
          "role": "法尔伽",
          "text": "你是说可莉还是深渊的事…"
        },
        {
          "role": "艾莉丝",
          "text": "都是！我有一些大概的猜想，但想获得切实的依据，还是需要有人进入到泡泡的内部。"
        },
        {
          "role": "艾莉丝",
          "text": "无论是调查深渊的成因，还是把威胁扼杀在摇篮里，这都是必要的。"
        },
        {
          "role": "琴",
          "text": "这点我也同意，既然它出现了就不能放任不管。"
        },
        {
          "role": "艾莉丝",
          "text": "这样吧，我去哄哄可莉，先让她去别的地方玩，然后我再赶回来。"
        },
        {
          "role": "艾莉丝",
          "text": "尼可，你就在外部观察和记录，配合他们尽快修好这个泡泡魔法。"
        },
        {
          "role": "尼可",
          "text": "这我可没法保证，不确定的因素太多，也不能勉强他们去冒险，天使又不是有求必应的许愿精灵…"
        },
        {
          "role": "艾莉丝",
          "text": "不是吗？"
        },
        {
          "role": "尼可",
          "text": "…我试试吧。你尽量早点回来，这是你的魔法。"
        },
        {
          "role": "派蒙",
          "text": "好像只能这样了，我们也没办法坐视不管。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "今天原本的故事内容是什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "尼可",
          "text": "你们顺利拿到了天空之琴，巴巴托斯用它唤来了遭受深渊侵蚀的特瓦林。"
        },
        {
          "role": "尼可",
          "text": "众人齐心合力，在风龙废墟与特瓦林展开战斗，最后终于帮他清除了深渊力量的影响，皆大欢喜。"
        },
        {
          "role": "派蒙",
          "text": "听起来，确实就是那时候发生过的事…"
        },
        {
          "role": "迪卢克",
          "text": "既然如此，正好原班人马就在这里，我们一起进去探个究竟吧。"
        },
        {
          "role": "法尔伽",
          "text": "也算我一个，毕竟这是发生在蒙德境内的潜在危险，我必须搞清楚情况。"
        },
        {
          "role": "琴",
          "text": "……"
        },
        {
          "role": "温迪",
          "text": "怎么了，琴？"
        },
        {
          "role": "琴",
          "text": "没什么，只是突然感觉有点怀念，没想到又有机会像这样一起行动。"
        },
        {
          "role": "迪卢克",
          "text": "昨天也是这样的吧。"
        },
        {
          "role": "琴",
          "text": "嗯，但那时只是玩乐的心态，而此刻我们是团结一致去解决危机，这一瞬间好像和我的回忆产生了共鸣。"
        },
        {
          "role": "派蒙",
          "text": "没想到这句话是从最正经的琴团长嘴里说出来的，嘿嘿。"
        },
        {
          "role": "琴",
          "text": "我，咳…果然还是太紧绷了一点吗。"
        },
        {
          "role": "法尔伽",
          "text": "没有的事，我向来很支持每个人说出自己心里的想法，这样别人才会更了解你。"
        },
        {
          "role": "法尔伽",
          "text": "多说一些，就不会听到像派蒙这样的惊讶了。"
        },
        {
          "role": "温迪",
          "text": "派蒙从来都是想到什么说什么，所以我们才会觉得她真诚又亲近，不会和她一般见识哦。"
        },
        {
          "role": "派蒙",
          "text": "卖唱的也挺擅长说好话的嘛…欸，等等，这是好话吗？"
        },
        {
          "role": "尼可",
          "text": "出发之前，我必须要叮嘱各位，现在谁也不知道魔法泡泡内部的情况。"
        },
        {
          "role": "尼可",
          "text": "我之前可以与你们保持联络，但现在从外面能看到的只有一片混乱，恐怕声音的传递也会受阻。"
        },
        {
          "role": "尼可",
          "text": "没有魔女的指引，你们一定要小心行事。"
        },
        {
          "role": "迪卢克",
          "text": "放心，这样的险境我们也经历过好多次了，经验丰富。"
        },
        {
          "role": "艾莉丝",
          "text": "哪怕是最坏最坏的情况，我也能为你们兜底。只是那样做我们之前的辛苦就全白费了。"
        },
        {
          "role": "温迪",
          "text": "是指把整个泡泡都毁掉吗？"
        },
        {
          "role": "艾莉丝",
          "text": "如果事态紧急，我会这么做的。"
        },
        {
          "role": "尼可",
          "text": "好吧，我会在这里关注泡泡的情况，从外部进行可能的修理，尽量提供支援。"
        },
        {
          "role": "法尔伽",
          "text": "明白了，各司其职，争取完美解决。"
        },
        {
          "role": "迪卢克",
          "text": "走吧。"
        },
        {
          "type": "subtitle",
          "text": "进入异常的泡泡"
        },
        {
          "role": "派蒙",
          "text": "哇，这、这里是蒙德城？"
        },
        {
          "role": "派蒙",
          "text": "他们不是和我们一起进来的吗，人呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "估计泡泡现在很不稳定。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "喂，你看，温迪在那里，周围好像有很多魔物！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们去帮他。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！"
        },
        {
          "role": "温迪",
          "text": "你们来了。先把魔物解决再说吧。"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "type": "subtitle",
          "text": "走到边界"
        },
        {
          "role": "艾莉丝",
          "text": "前面的区域以后再来探索吧？"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|嗜雷·兽境幼兽|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "尼可",
          "text": "能听到吗，各位？"
        },
        {
          "role": "尼可",
          "text": "我修好了部分的通讯和操作功能，现在可以为你们提供一些道具支援。"
        },
        {
          "role": "尼可",
          "text": "遇到棘手的战斗，就用上这些元素装置作为助力吧。"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|嗜岩·兽境猎犬|1}}{{图标|嗜雷·兽境幼兽|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与温迪交谈，分析现状"
        },
        {
          "role": "派蒙",
          "text": "你没事吧，温迪？"
        },
        {
          "role": "温迪",
          "text": "多亏你们来得及时，不过蒙德城显然不像没事的样子。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "故事已经乱掉了吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，怎么会有这么多深渊魔物出现在城里，就好像…已经失守了一样。"
        },
        {
          "role": "温迪",
          "text": "我也不知道，但首先我们应该把一起进来的同伴们都找回来，或许他们现在也被困在了什么地方。"
        },
        {
          "role": "派蒙",
          "text": "有道理，我们快走吧。"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "传说任务-巨龙与自由的变奏-CG-空.png|center|1100px]]"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "传说任务-巨龙与自由的变奏-CG-荧.png|center|1100px]]"
        },
        {
          "role": "特瓦林",
          "text": "——"
        },
        {
          "role": "派蒙",
          "text": "啊，你们看，是特瓦林！可是它的样子是不是…病得比那时候重得多？"
        },
        {
          "role": "温迪",
          "text": "嗯，深渊的污染已经完全扩散。如果当时在蒙德特瓦林没有得到净化，可能最终它就会变成这副样子。"
        },
        {
          "role": "派蒙",
          "text": "好像有什么东西落下来了！"
        },
        {
          "role": "[[file",
          "text": "传说任务-巨龙与自由的变奏-CG2.png|center|1100px]]"
        },
        {
          "role": "温迪",
          "text": "是他的眼泪…"
        },
        {
          "role": "派蒙",
          "text": "眼泪？！就是曾经我们净化的泪滴吗？"
        },
        {
          "role": "温迪",
          "text": "嗯，但恐怕现在已经变成混沌的深渊力量结晶了…"
        },
        {
          "role": "温迪",
          "text": "如果放任不管的话，这些眼泪也会持续唤来深渊魔物，这场灾难将无法收场。"
        },
        {
          "role": "温迪",
          "text": "而且，我们也需要那些眼泪。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还是我来净化吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "不，这种程度的污染已经无法净化，而且如果要唤来被污染的龙，就要用被污染的眼泪。"
        },
        {
          "role": "温迪",
          "text": "如今的特瓦林，或许已经听不到纯净的琴声了。"
        },
        {
          "role": "派蒙",
          "text": "听上去，故事还是会走向决战…"
        },
        {
          "role": "温迪",
          "text": "嗯，在特瓦林出现之前，我还不能完全确定，但现在我知道，眼前所发生的事并非单纯的混乱。"
        },
        {
          "role": "温迪",
          "text": "它更像是故事的「另一种可能」，而且它是如何产生的，我也有点头绪。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也有眉目。",
              "dialogues": []
            },
            {
              "text": "可是还是先找到伙伴要紧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "嗯，左右都有魔物肆虐，你来选择往哪边前进吧。"
        },
        {
          "type": "subtitle",
          "text": "收集泪滴，寻找伙伴"
        },
        {
          "role": "派蒙",
          "text": "看，是琴！"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "type": "subtitle",
          "text": "获得{{图标|深度污染的泪滴结晶|1}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "琴",
          "text": "感谢你们支援。"
        },
        {
          "role": "琴",
          "text": "虚构的深渊力量在虚构的世界中，就和真实并无二致，我们面临的敌人有些过于棘手了。"
        },
        {
          "role": "温迪",
          "text": "没关系，这种力量也能够化为己用。我们来帮你，也是为了回收特瓦林的泪滴。"
        },
        {
          "role": "琴",
          "text": "原来如此…好吧，那就继续行动，我们没有时间耽搁在这里。"
        },
        {
          "role": "派蒙",
          "text": "你见到法尔伽了吗，我们也在找他。"
        },
        {
          "role": "琴",
          "text": "没有，可能在上面吧。我们一起去找。"
        },
        {
          "type": "subtitle",
          "text": "先寻找琴"
        },
        {
          "role": "琴",
          "text": "对了，迪卢克似乎在另一边，我们先去帮他吧。"
        },
        {
          "role": "派蒙",
          "text": "好的，走！"
        },
        {
          "type": "subtitle",
          "text": "收集泪滴，寻找伙伴"
        },
        {
          "role": "派蒙",
          "text": "迪卢克老爷在那边！"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "role": "迪卢克",
          "text": "多谢各位，我没事。"
        },
        {
          "role": "迪卢克",
          "text": "蒙德城似乎彻底受灾了…你们进来的路上见到西风骑士或者普通市民了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这倒是没有…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪卢克",
          "text": "那应该能印证我的推测：在这个虚构的世界中，蒙德城已经被西风骑士放弃，所有人已经被疏散到了别处。"
        },
        {
          "role": "派蒙",
          "text": "放、放弃…"
        },
        {
          "role": "迪卢克",
          "text": "我们没有抵御深渊的能力，骑士团会做出这个决定或许也是迫不得已，但我们没时间细究缘由了。"
        },
        {
          "role": "迪卢克",
          "text": "在空城中反而有好处，不会因为要保护与疏散别人而分心。"
        },
        {
          "role": "迪卢克",
          "text": "还有这个风龙泪滴，不能放着不管。"
        },
        {
          "role": "温迪",
          "text": "我们就是来回收它的。"
        },
        {
          "role": "派蒙",
          "text": "对了，法尔伽呢，你看见他了吗？"
        },
        {
          "role": "迪卢克",
          "text": "这我也不知道，只能继续找找看。"
        },
        {
          "type": "subtitle",
          "text": "先寻找迪卢克"
        },
        {
          "role": "迪卢克",
          "text": "哦，琴似乎在城的另一边，本来我打算脱身后就直接赶过去。我们先去帮她吧。"
        },
        {
          "role": "温迪",
          "text": "嗯，走吧。"
        },
        {
          "type": "subtitle",
          "text": "收集泪滴，寻找伙伴"
        },
        {
          "role": "迪卢克",
          "text": "嗯，虽然大团长身手了得，但毕竟是深渊力量，不能掉以轻心。"
        },
        {
          "type": "subtitle",
          "text": "在城中收集被污染的泪滴"
        },
        {
          "type": "subtitle",
          "text": "获得{{图标|深度污染的泪滴结晶|3}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "你们听到了一阵巨响…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "啊？怎么了？"
        },
        {
          "role": "派蒙",
          "text": "神、神像坏了！"
        },
        {
          "role": "迪卢克",
          "text": "大团长应该就在那里，快去。"
        },
        {
          "type": "subtitle",
          "text": "前往大教堂前的广场"
        },
        {
          "role": "琴",
          "text": "我们来帮忙了。"
        },
        {
          "role": "法尔伽",
          "text": "哦，时机非常好，动手吧！"
        },
        {
          "type": "subtitle",
          "text": "清理此地的魔物"
        },
        {
          "type": "subtitle",
          "text": "与众人商议对策"
        },
        {
          "role": "法尔伽",
          "text": "总算是完成会合了，都没事吧？"
        },
        {
          "role": "迪卢克",
          "text": "嗯，还好荣誉骑士他们来得及时。"
        },
        {
          "role": "温迪",
          "text": "在收集完特瓦林落下的泪滴结晶之后，深渊魔物的攻势似乎也减弱不少。"
        },
        {
          "role": "温迪",
          "text": "法尔伽也感觉到了吧，在这个虚构的世界里蒙德已经是一座空城了。"
        },
        {
          "role": "法尔伽",
          "text": "嗯，所以我们不该继续恋战，白白消耗自身体力。赶紧找个机会离开这里。"
        },
        {
          "role": "琴",
          "text": "就到这里吧，看起来这附近暂时安全，不会有魔物骚扰。"
        },
        {
          "role": "尼可",
          "text": "能听见吗？之前的联络功能又出故障了，能听见吗？我是尼可，艾莉丝刚刚也回来了。"
        },
        {
          "role": "派蒙",
          "text": "嗯，可以听见了！尼可，艾莉丝，这是怎么回事啊！"
        },
        {
          "role": "尼可",
          "text": "我想，根本原因还是过于想当然地裁剪掉了关于旅行者净化深渊力量的部分，没有进行补充与修复。"
        },
        {
          "role": "尼可",
          "text": "之前我和艾莉丝认为，这几天的游玩内容都是独立的场景，理应不会产生干扰。"
        },
        {
          "role": "尼可",
          "text": "但因为魔法的基底是同一个泡泡，所以它好像自认为这一切有连续性…"
        },
        {
          "role": "尼可",
          "text": "最终导致的结果，就是在处理「特瓦林是如何被净化的」这件事上出现了故障。"
        },
        {
          "role": "温迪",
          "text": "果然啊。"
        },
        {
          "role": "温迪",
          "text": "现在的故事走向，几乎就是「荣誉骑士没有出现在蒙德」，这种情况下的延续。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样…可是，不是还有你在吗？"
        },
        {
          "role": "温迪",
          "text": "深渊是世界的大敌，那时的我又刚刚苏醒。我的确能够处理，可是不会做得那么圆满。"
        },
        {
          "role": "温迪",
          "text": "这段故事，我相信法尔伽已经在魔女们的水占盘中看过一次了吧。"
        },
        {
          "role": "法尔伽",
          "text": "那段预言我的确见识过，很逼真所以让人记忆犹新。"
        },
        {
          "role": "法尔伽",
          "text": "最后的结果…是你以负伤作为代价，再次封印了特瓦林。"
        },
        {
          "role": "迪卢克",
          "text": "既然被封印了，为什么还会变成这样？"
        },
        {
          "role": "艾莉丝",
          "text": "封印不能从根本解决问题，深渊力量会随着时间越来越强，最后彻底瓦解特瓦林的心智。"
        },
        {
          "role": "派蒙",
          "text": "难道说，我们眼前所经历的已经是…"
        },
        {
          "role": "艾莉丝",
          "text": "对，应该是特瓦林再次挣脱封印时候的事，他已经病得很重了。"
        },
        {
          "role": "艾莉丝",
          "text": "深渊力量已经和他的皮肉骨骼完全融合，现在就算再为他净化，也和处刑没有区别。"
        },
        {
          "role": "众人",
          "text": "……"
        },
        {
          "role": "琴",
          "text": "如果要解决这场危机，就只能…"
        },
        {
          "role": "法尔伽",
          "text": "消灭特瓦林。"
        },
        {
          "role": "法尔伽",
          "text": "气氛不用这么凝重，我们应该庆幸这是在虚构世界中发生的事，现实里那条龙可精神了，只是没那么活泼。"
        },
        {
          "role": "法尔伽",
          "text": "既然找到了解决问题的方式，就干净利落地把它解决掉吧。对我们这帮人来说，还不是三两下就搞定的事。"
        },
        {
          "role": "法尔伽",
          "text": "小可莉还在等着我们呢，对吧。"
        },
        {
          "role": "艾莉丝",
          "text": "现在可莉在别的地方玩，我们还有时间，不过还是越快越好。"
        },
        {
          "role": "温迪",
          "text": "…嗯，你们说得对。"
        },
        {
          "role": "法尔伽",
          "text": "如果你会心情复杂，就交给我们来动手。这个世界总归只是游戏，没必要给任何人留下深刻的负面回忆。"
        },
        {
          "role": "温迪",
          "text": "没关系的，毕竟那时候…我也有这种心理准备。"
        },
        {
          "role": "温迪",
          "text": "走吧，去风龙废墟。"
        },
        {
          "type": "subtitle",
          "text": "前往风龙废墟"
        },
        {
          "role": "温迪",
          "text": "就是这里了，准备好了吗，各位。"
        },
        {
          "role": "迪卢克",
          "text": "我随时可以。"
        },
        {
          "role": "琴",
          "text": "希望之前的战斗经验还没有遗忘。"
        },
        {
          "role": "法尔伽",
          "text": "只有我是初学者吗？哈哈，没问题，我会迅速跟上你们的。"
        },
        {
          "role": "派蒙",
          "text": "准备好了吗？旅行者，这是你来到提瓦特第一次对上强敌，那时候你会紧张吗？现在呢？"
        },
        {
          "role": "旅行者",
          "text": "我不会紧张。因为我们都成长了。"
        },
        {
          "role": "旅行者",
          "text": "过去能够跨越的挑战，现在也一定可以。"
        },
        {
          "role": "派蒙",
          "text": "嗯，我相信你！"
        },
        {
          "role": "温迪",
          "text": "那么，以此沾染污秽之琴声，呼唤面目全非的眷属到来。"
        },
        {
          "role": "温迪",
          "text": "唔…"
        },
        {
          "role": "法尔伽",
          "text": "没事吧，巴巴托斯？"
        },
        {
          "role": "温迪",
          "text": "要把汹涌的深渊力量转化成音符，可不是件容易的事…"
        },
        {
          "role": "温迪",
          "text": "但我自诩最好的吟游诗人，总不能在这种时候丢人现眼吧？"
        },
        {
          "role": "特瓦林",
          "text": "■■■■■，■■■■■，我早就听够了！"
        },
        {
          "role": "特瓦林",
          "text": "唤我而来，■■■■，■■■■■■■！"
        },
        {
          "type": "subtitle",
          "text": "击败被深渊污染的特瓦林"
        },
        {
          "role": "派蒙",
          "text": "唔，这么大的家伙，还是好有压迫感…"
        },
        {
          "role": "温迪",
          "text": "还记得吗？首先要削弱他的体力，我们才能攻击到他的破绽。"
        },
        {
          "role": "迪卢克",
          "text": "就是现在，爬上去攻击那个深渊核心。"
        },
        {
          "role": "法尔伽",
          "text": "好样的！再来一次！"
        },
        {
          "role": "派蒙",
          "text": "他变得更凶暴了，要小心啊！"
        },
        {
          "role": "琴",
          "text": "我们要换个地方站了！"
        },
        {
          "type": "subtitle",
          "text": "击败'''深渊魔龙·特瓦林'''",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "[https://www.bilibili.com/video/BV1GcPvz5ESM 过场动画「命中未定的屠龙」]"
        },
        {
          "role": "法尔伽",
          "text": "谢啦 琴"
        },
        {
          "type": "subtitle",
          "text": "众人在与魔龙交战时，魔龙破坏了平台，特瓦林赶来接住了众人并与魔龙交战…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "特瓦林？你怎么来了！"
        },
        {
          "role": "特瓦林",
          "text": "循琴声而来，无论何处"
        },
        {
          "role": "温迪",
          "text": "谢谢你"
        },
        {
          "role": "温迪",
          "text": "看来魔女的故事，还没有收场啊"
        },
        {
          "role": "法尔伽",
          "text": "结局注定不会圆满"
        },
        {
          "role": "法尔伽",
          "text": "但总要有人挥出最后一剑"
        },
        {
          "role": "特瓦林",
          "text": "这次轮到你来当英雄？"
        },
        {
          "role": "法尔伽",
          "text": "呵"
        },
        {
          "role": "法尔伽",
          "text": "我只想"
        },
        {
          "role": "法尔伽",
          "text": "当好这个团长"
        },
        {
          "type": "subtitle",
          "text": "法尔伽向魔龙砍下了最后一剑…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "可莉",
          "text": "啦啦啦"
        },
        {
          "type": "subtitle",
          "text": "艾莉丝和尼可看到泡泡中的深渊力量消失时，众人突然从泡泡中冲出来，特瓦林冲破窗户，跌入了湖中…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "可莉",
          "text": "妈妈，我来玩游戏了！"
        },
        {
          "role": "可莉",
          "text": "…欸？"
        },
        {
          "type": "subtitle",
          "text": "与骑士团总部内的众人交谈"
        },
        {
          "type": "subtitle",
          "text": "魔法泡泡中的深渊危机被有惊无险地解决，艾莉丝与尼可紧急修复了魔法中存在的瑕疵，杜绝问题再度发生。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "可莉并未发现任何异状，在母亲和尼可的陪同下体验了一场轻松欢快的冒险之旅。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "留给骑士团唯一的杂音…可能就是那扇被特瓦林撞碎的窗户了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "看来总算是顺利收场呢。"
        },
        {
          "role": "派蒙",
          "text": "打比方的话，就像是坐了一次呼呼飞车，有快乐，也有惊险，最后好像还挺满足的。"
        },
        {
          "role": "温迪",
          "text": "虽然那个窗户上的大窟窿，我有点抱歉啦，又要辛苦琴去善后了。"
        },
        {
          "role": "琴",
          "text": "没关系，建筑结构没有受损还是万幸，我稍后会安排替换新的窗框与玻璃。"
        },
        {
          "role": "琴",
          "text": "特瓦林最后来得很及时，不然面对会飞的邪龙，我们好像也没有很好的办法。"
        },
        {
          "role": "温迪",
          "text": "谢谢你能这么说，那时候我倒是能用风载你们一程，可是风之翼的骨架能不能坚持得住就不好说了。"
        },
        {
          "role": "迪卢克",
          "text": "不过，艾莉丝女士真是有魄力，明明我们遇到的事情一点都不小，她还是决定要带女儿进去玩。"
        },
        {
          "role": "迪卢克",
          "text": "要是还有其他的隐患没有暴露出来该怎么办。"
        },
        {
          "role": "琴",
          "text": "这说明魔女们对魔法的掌控还是有自信的吧。"
        },
        {
          "role": "法尔伽",
          "text": "倒不如说有艾莉丝在，就算整个泡泡被炸得四分五裂，她也能保证小可莉毫发无伤。"
        },
        {
          "role": "迪卢克",
          "text": "嗯…她的身手确实有说服力。"
        },
        {
          "role": "法尔伽",
          "text": "接下来各位准备做什么，要不然继续去喝酒？我请客。"
        },
        {
          "role": "迪卢克",
          "text": "我没问题，不过这次就不劳烦大团长招待了，我那里正好有一瓶能为辛劳的远征队接风的好酒。"
        },
        {
          "role": "法尔伽",
          "text": "哈哈，那太好了，这我可不会客气的。"
        },
        {
          "role": "温迪",
          "text": "欸，有酒吗？我也要去我也要去。"
        },
        {
          "role": "迪卢克",
          "text": "那就去我那边吧。琴要来吗？"
        },
        {
          "role": "琴",
          "text": "我就不去了，还有很多工作要处理。"
        },
        {
          "role": "法尔伽",
          "text": "哎呀，少干一天不会怎么样的，机会难得，走吧走吧。"
        },
        {
          "role": "琴",
          "text": "那酒会之后，大团长您也要和我一起回来处理工作。"
        },
        {
          "role": "法尔伽",
          "text": "呃…那、那你忙完有兴致再来！"
        },
        {
          "role": "法尔伽",
          "text": "荣誉骑士呢，怎么说？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还有些事想问艾莉丝。",
              "dialogues": []
            },
            {
              "text": "等她陪完可莉吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "行，那就这样，也算是圆满收场吧，哈哈。"
        },
        {
          "role": "派蒙",
          "text": "艾莉丝很喜欢去图书馆，我们就去那里等她吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（琴&阿贝多&砂糖）"
        },
        {
          "role": "派蒙",
          "text": "咦，这么快就修好了？"
        },
        {
          "role": "砂糖",
          "text": "怪不得我听到了那么大的动静，原来摔到河里去的是特瓦林啊…"
        },
        {
          "role": "阿贝多",
          "text": "鉴于他的体型，最后我们只需要替换这扇窗户而非整面墙壁，这也堪称魔法的伟业了。"
        },
        {
          "role": "琴",
          "text": "非常感谢二位能协助维修与清理房间，把这里恢复得和之前一模一样。"
        },
        {
          "role": "派蒙",
          "text": "这应该也算炼金术的伟业吧…"
        },
        {
          "type": "subtitle",
          "text": "在图书馆等待艾莉丝"
        },
        {
          "role": "艾莉丝",
          "text": "在等我？"
        },
        {
          "role": "艾莉丝",
          "text": "非常谢谢你们，让我守住了和女儿的约定，她今天玩得非常开心。"
        },
        {
          "role": "艾莉丝",
          "text": "尼可后来陪我们一起进去，是为了彻底调查魔法当中还有没有其他的问题，避免类似的情况再次发生。"
        },
        {
          "role": "艾莉丝",
          "text": "哎，也算是给了我一个教训吧。大魔王很少有像今天这样略显狼狈的时候呢。"
        },
        {
          "role": "派蒙",
          "text": "所以问题解决了吗？"
        },
        {
          "role": "艾莉丝",
          "text": "嗯，已经完全修好了，而且录制工作也已经完成，接下来只需要重复播放就好。"
        },
        {
          "role": "艾莉丝",
          "text": "最不稳定的那个部分已经结束，普通人能够按照之前的想法，在里面随意体验。"
        },
        {
          "role": "艾莉丝",
          "text": "当然，尼可还会盯着的，放心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们经历的那段灾难。",
              "dialogues": []
            },
            {
              "text": "是被改变前的「命运」吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾莉丝",
          "text": "嗯…我觉得不能这么说，准确来说它展现的是一段「不会发生的命运」吧。"
        },
        {
          "role": "派蒙",
          "text": "呃，这两者有什么差别吗？"
        },
        {
          "role": "艾莉丝",
          "text": "别忘了，你们在故事中见到的那位屠龙的勇者，已经去挪德卡莱远征了。"
        },
        {
          "role": "艾莉丝",
          "text": "特瓦林并不会因此绕开死亡的命运，会有另外的英雄挺身而出，付出惨痛代价赢得胜利。"
        },
        {
          "role": "派蒙",
          "text": "但我记得他们说，这是特瓦林再次挣脱封印的时候的灾难，那说不定那时候法尔伽已经回来了呢？"
        },
        {
          "role": "艾莉丝",
          "text": "呵呵…小派蒙，这种问题就别问出来，自己去想吧。"
        },
        {
          "role": "艾莉丝",
          "text": "我给你们的告诫是，不要因为知晓了那些「不会发生的命运」而感慨，或患得患失…"
        },
        {
          "role": "艾莉丝",
          "text": "如果你们能看到命运，那一定会看到很好很好的，也会看到很坏很坏的。"
        },
        {
          "role": "艾莉丝",
          "text": "可那些都是不会发生的，远不及我们现在所处的世界重要。"
        },
        {
          "role": "派蒙",
          "text": "好、好吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还有个问题…",
              "dialogues": []
            },
            {
              "text": "故事里的深渊之力太真实了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾莉丝",
          "text": "你是说，一点都不像假的，像是泡泡本身被深渊污染了吗？"
        },
        {
          "role": "艾莉丝",
          "text": "本魔女天天都在「边界」游荡，行囊一不小心粘上了脏东西，让它混进了我的魔法而我还正好没发现——"
        },
        {
          "role": "艾莉丝",
          "text": "呵呵，我怎么会让这种丢人的事发生。"
        },
        {
          "role": "艾莉丝",
          "text": "你的感觉是正确的——那就是深渊力量的雏形，若不加以干涉，它会演化成真实的深渊力量。"
        },
        {
          "role": "派蒙",
          "text": "欸？你是说，不是从外面来的，而是…凭空诞生的？"
        },
        {
          "role": "艾莉丝",
          "text": "深渊是种非常深奥的东西，你们已经和它打过很多交道，它有很多复杂的特质——危险，狡诈，恶毒，偏执。"
        },
        {
          "role": "艾莉丝",
          "text": "魔女会长期观察这种力量，其中，芭比洛斯的解读我觉得最为准确。"
        },
        {
          "role": "艾莉丝",
          "text": "深渊的本质，是一切「不会发生的命运」的恨意。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "命运的恨意…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾莉丝",
          "text": "在这个世界上存在很多互相冲突的事，一件事发生的同时，意味着另一种可能性的消弭。"
        },
        {
          "role": "艾莉丝",
          "text": "小到无所谓的事，比如今天午饭我吃了甜甜花酿鸡，那选择了庄园烤松饼的我就消失了。"
        },
        {
          "role": "艾莉丝",
          "text": "大到威胁世界的事，比如我的好友莱茵多特染指了深渊，纯净的她的未来故事也在那一刻消失了。"
        },
        {
          "role": "艾莉丝",
          "text": "可是，为什么偏偏是「它们」消失呢？"
        },
        {
          "role": "派蒙",
          "text": "我大概理解了，是一种没有被选中的恨意吧。"
        },
        {
          "role": "艾莉丝",
          "text": "嗯，而这一次我们利用再现过去的魔法，掺入变量，令「不会发生的命运」距离现实很近很近。"
        },
        {
          "role": "艾莉丝",
          "text": "深渊之力，便从中露出了獠牙。它不求诞生，只想毁灭一切。"
        },
        {
          "role": "艾莉丝",
          "text": "所幸，问题不大，「边界」天天都在发生这样的事，哎。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来是这样。",
              "dialogues": []
            },
            {
              "text": "怪不得深渊总是那么恨。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾莉丝",
          "text": "因为它自认为是被剥夺者吧。"
        },
        {
          "role": "艾莉丝",
          "text": "它充满了执念，不择手段地想要降临这个世界，正因如此，我们才要守护好属于我们的生活与朋友。"
        },
        {
          "role": "艾莉丝",
          "text": "这些真实存在的东西，是诞生于无数种可能性中，唯一的幸运。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在和深渊对抗过之后…",
              "dialogues": []
            },
            {
              "text": "我也越来越能理解你的想法了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "琴",
          "text": "艾莉丝，原来你在这里。"
        },
        {
          "role": "琴",
          "text": "很抱歉地通知你，依照骑士团的规章制度，你必须被送往禁闭室。"
        },
        {
          "role": "艾莉丝",
          "text": "啊，为什么？魔法泡泡的事，我可是圆满解决了。"
        },
        {
          "role": "艾莉丝",
          "text": "这应该不能算我的错吧，如果你要抓我…那你也应该把尼可抓起来。"
        },
        {
          "role": "琴",
          "text": "不是的，是侦察骑士提供了情报，在星落湖附近出现了大量受到炸弹伤害的鱼群。"
        },
        {
          "role": "琴",
          "text": "——这是明令禁止的行为，你应该非常清楚。"
        },
        {
          "role": "艾莉丝",
          "text": "呃…"
        },
        {
          "role": "艾莉丝",
          "text": "可莉，快跑！"
        },
        {
          "role": "琴",
          "text": "她已经在里面了。"
        },
        {
          "role": "艾莉丝",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "没想到，大魔王也有今天呢。"
        },
        {
          "role": "艾莉丝",
          "text": "…呜呜呜，旅行者，永别了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（艾莉丝&可莉）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "聆听",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾莉丝",
          "text": "我画好了。你看，都怪他，就是这个人给爸爸添乱，让爸爸这次没办法回来。"
        },
        {
          "role": "可莉",
          "text": "好坏好坏的大坏蛋！炸飞这个大坏蛋！"
        },
        {
          "role": "艾莉丝",
          "text": "就是就是，非常坏！不过现在坏蛋已经被荣誉骑士哥哥和他的同伴解决了。"
        },
        {
          "role": "可莉",
          "text": "好耶，不愧是荣誉骑士哥哥！"
        }
      ],
