{
  "quest_id": 75670,
  "chapter_num": null,
  "chapter_title": "龙龙同游",
  "type": "wq",
  "route": "Saurian Sojourn",
  "stories": [
    {
      "story_id": 75670,
      "title": "龙龙同游",
      "description": "某天，你在「回声之子」遇见了两人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与科米娜和克维库对话"
        },
        {
          "role": "科米娜",
          "text": "除去高空特训的部分，其他均已完备，总教官。"
        },
        {
          "role": "「耶耶副教官」",
          "text": "耶！"
        },
        {
          "role": "克维库",
          "text": "好，两位都很有精神！"
        },
        {
          "role": "克维库",
          "text": "「回声之子」将是我们伟大计划的第一据点，然后，我们将逐步渗透「流泉之众」、「悬木人」等多个部族…"
        },
        {
          "role": "派蒙",
          "text": "呜哇哇！克维库，你在说些什么可怕的东西！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来像神秘间谍组织。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "克维库",
          "text": "欸？是大英雄旅行者和他的好伙伴派蒙来了呀！"
        },
        {
          "role": "克维库",
          "text": "什么间谍组织？啊哈哈哈哈，你们误会了，我们只是来传授一些能让你和龙伙伴愉快互动的技巧罢了。"
        },
        {
          "role": "克维库",
          "text": "科米娜是我们的随行医生，她会保障每一位参与者的安全。"
        },
        {
          "role": "克维库",
          "text": "「耶耶副教官」是我们特地找来的帮手，在设置关卡目标的时候，它帮了我不少忙呢！"
        },
        {
          "role": "克维库",
          "text": "至于我嘛，是总教官，简而言之，就是组织人，刚刚只是在给他们做动员大会…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还好是误会…",
              "dialogues": []
            },
            {
              "text": "差点要去揭发你了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "科米娜",
          "text": "不好意思！当时我听说克维库先生要做这么有意义的事情，还提议在用词上要更「正规」一些，没想到有些用力过猛了…"
        },
        {
          "role": "克维库",
          "text": "哈，不用道歉科米娜小姐，我和「耶耶副教官」都很喜欢你取的称呼呢——对吧？「耶耶副教官」。"
        },
        {
          "role": "「耶耶副教官」",
          "text": "呜哇——耶！"
        },
        {
          "role": "克维库",
          "text": "果然满意啊…对了，旅行者想来试试这些关卡吗？虽然这对你来说是小菜一碟，但也有些不一样的趣味。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "具体内容是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "克维库",
          "text": "很简单，只要和各种各样的龙配合来完成我设定的目标就行了…最关键的点就是你与龙伙伴之间的信任与默契。"
        },
        {
          "role": "克维库",
          "text": "只想着一个人把所有目标完成的话，是完全——完全完成不了任何事情的，你必须时时关注你身边的伙伴。"
        },
        {
          "role": "克维库",
          "text": "哦，还有，这次暂时没有办法和绒翼龙同行，因为我们还没有准备好高空上的安全措施——再怎么样，安全第一嘛！"
        },
        {
          "role": "派蒙",
          "text": "呜哇哇，来试试吧！旅行者可最擅长合作了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我愿意来试试。",
              "dialogues": []
            },
            {
              "text": "看在派蒙的面子上…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "科米娜",
          "text": "太好了…如果大家知道了旅行者都来尝试了，一定会积极参与的！"
        },
        {
          "role": "派蒙",
          "text": "欸？那么科米娜是不是也应该帮我们取一个「正规」的称呼？最好更威风一些，嘿嘿…"
        },
        {
          "role": "科米娜",
          "text": "那要等我好好地、慎重地想一想…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（克维库）"
        },
        {
          "role": "克维库",
          "text": "想来试试看吗？龙伙伴们都已经准备好了呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好呀，我也准备好了。",
              "dialogues": [
                {
                  "role": "克维库",
                  "text": "来吧！这体验不会让你失望的！"
                }
              ]
            },
            {
              "text": "有些不够玩。",
              "dialogues": [
                {
                  "role": "克维库",
                  "text": "真的吗？实不相瞒，在去「回声之子」前，我的心都还在打鼓，万一没有人愿意尝试…"
                },
                {
                  "role": "克维库",
                  "text": "倒也不是担心其他的，我只是有时候看到那些小家伙们亮亮的眼睛，就总是觉得不得劲，这让我想起了我的老伙计…"
                },
                {
                  "role": "克维库",
                  "text": "它是条好龙…噢，特别活泼，你不陪它玩的时候，它就围着你绕来绕去，就像一个好奇的小宝宝一样…"
                },
                {
                  "role": "克维库",
                  "text": "还有科米娜小姐——有时候没有她，我都不知道下一步该怎么办好了。"
                },
                {
                  "role": "克维库",
                  "text": "但现在有你的肯定，我就安心多啦，至少看在你的份上，都会有许多人愿意尝试吧。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "没有我也是一样的。",
                      "dialogues": []
                    },
                    {
                      "text": "与龙同游的魅力很难抵抗。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "克维库",
                  "text": "啊哈哈哈哈…不论如何，你还是帮我们大忙了。"
                },
                {
                  "role": "克维库",
                  "text": "等到下次我想出新的关卡，我一定邀请你来第一个尝试。"
                }
              ]
            },
            {
              "text": "我先热热身再来。",
              "dialogues": [
                {
                  "role": "克维库",
                  "text": "啊，在运动前进行适当的热身是正确的…总之，你想玩了就来找我，我随时都在。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（科米娜）"
        },
        {
          "role": "科米娜",
          "text": "两位好，体验得如何了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "非常好，一定会大受欢迎的。",
              "dialogues": [
                {
                  "role": "科米娜",
                  "text": "感谢你的祝福…这样的话，克维库先生心中的担忧总能放下一大半了吧。"
                },
                {
                  "role": "科米娜",
                  "text": "那场大战过后，他就经常发呆，然后——他想要大家都去尝试和龙伙伴们进行更有创意、更有趣的合作。"
                },
                {
                  "role": "科米娜",
                  "text": "我猜，他肯定是有一位难以忘怀的好伙伴永远地停留在了某一个时间节点上…"
                },
                {
                  "role": "科米娜",
                  "text": "好在他现在总归是精神一点了…每天看看像耶耶这样活蹦乱跳的小家伙们，总归是要比一个人呆在家好的。"
                }
              ]
            },
            {
              "text": "简直想要带只小龙回家看看…",
              "dialogues": [
                {
                  "role": "科米娜",
                  "text": "那些小家伙的确有这样的魔力呢。"
                },
                {
                  "role": "科米娜",
                  "text": "虽然它们不会说话，还经常捣乱，但只要有它们在身边，总觉得一切事情都会变得好起来…"
                },
                {
                  "role": "科米娜",
                  "text": "这可能也是克维库先生真正想要让大家体验的东西吧。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "小龙真是很好的伙伴对象呢。",
                      "dialogues": []
                    },
                    {
                      "text": "说得我想再去体验一遍了！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "科米娜",
                  "text": "总之，和小龙呆在一起是一种很奇妙的感觉…有时候我甚至觉得，这比我的一些治疗都有效果呢。"
                },
                {
                  "role": "科米娜",
                  "text": "啊…不多说了，是时候检查一下龙伙伴们的身体了。如果你想要体验那些关卡的话，请自便。"
                }
              ]
            },
            {
              "text": "我正准备去体验呢。",
              "dialogues": [
                {
                  "role": "科米娜",
                  "text": "好哦…对了，有一点需要提醒你，大部分人和龙伙伴们玩起来都会容易忘记时间的流逝。"
                },
                {
                  "role": "科米娜",
                  "text": "如果你觉得你的肌肉感觉到疲惫的话，要记得注意停下来休息一下，放松放松。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（「耶耶副教官」）"
        },
        {
          "type": "subtitle",
          "text": "人形态"
        },
        {
          "role": "「耶耶副教官」",
          "text": "耶耶！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（拍拍。）",
              "dialogues": [
                {
                  "role": "「耶耶副教官」",
                  "text": "呼呼——"
                }
              ]
            },
            {
              "text": "下次见！",
              "dialogues": [
                {
                  "role": "「耶耶副教官」",
                  "text": "嗯…嗯！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "魂附状态"
        },
        {
          "role": "「耶耶副教官」",
          "text": "你好！你好！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "耶耶玩得高兴吗？",
              "dialogues": [
                {
                  "role": "「耶耶副教官」",
                  "text": "呀！耶耶开心！"
                }
              ]
            },
            {
              "text": "再见咯——",
              "dialogues": [
                {
                  "role": "「耶耶副教官」",
                  "text": "耶耶，再见~"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
