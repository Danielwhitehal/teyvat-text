{
  "quest_id": 20011,
  "chapter_num": null,
  "chapter_title": "此路不通？",
  "type": "iq",
  "route": "Blocked?",
  "stories": [
    {
      "story_id": 20011,
      "title": "此路不通？",
      "description": "安东尼从蒙德城前往清泉镇周边，为妹妹安娜找药，但是在途中却被路障拦截，遭到丘丘人的围攻。消灭丘丘人，解救安东尼。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前去查看详请"
        },
        {
          "role": "安东尼",
          "text": "快来救救我！"
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物并摧毁路障"
        },
        {
          "type": "subtitle",
          "text": "与安东尼对话"
        },
        {
          "role": "安东尼",
          "text": "这样子可以走过去了…谢谢，旅行者。"
        },
        {
          "role": "安东尼",
          "text": "因为没多少钱，安娜的病又始终不见好，所以我经常来这采草药。"
        },
        {
          "role": "安东尼",
          "text": "虽然草药采到了，但没想到今天会被这群家伙袭击，还好你赶过来了。"
        },
        {
          "role": "安东尼",
          "text": "这个给你，我经常用这个给安娜泡茶喝，这样她的咳嗽才会好些。"
        },
        {
          "role": "安东尼",
          "text": "你也经常在野外跑吧，自己要照顾好自己啊。"
        }
      ]
    }
  ]
}