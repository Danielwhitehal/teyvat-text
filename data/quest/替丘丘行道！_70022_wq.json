  "chapter_title": "替丘丘行道！",
  "type": "wq",
  "route": "Hilichurl Justice",
  "stories": [
    {
      "story_id": 70022,
      "title": "替丘丘行道！",
      "description": "与艾拉·马斯克一同前去为被欺负的丘丘人打抱不平，或许能够借此得到新的线索？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与另一个愿意交流的丘丘人对话"
        },
        {
          "role": "丘丘人",
          "text": "Odomu tomo? Kundala? Mosi mita?"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Mimi tomo! Mosi mita!"
        },
        {
          "role": "丘丘人",
          "text": "Tomo mosi mita! Tomo mani mimi?"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Mimi mani ye! Plata yaya ika?"
        },
        {
          "role": "丘丘人",
          "text": "Plata ika odomu! Zido mi! mi muhe yeye! Mi mita yeye!"
        },
        {
          "role": "派蒙",
          "text": "不知怎么的，感觉他们很谈得来的样子。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这就是丘丘人学家吗…",
              "dialogues": []
            },
            {
              "text": "氛围变得热闹了起来…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾拉·马斯克",
          "text": "哼哼，它很愿意和我们交朋友，只要我们帮一个小忙…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "我们需要帮它们打倒难对付的敌人，具体位置我标记下来啦。"
        },
        {
          "role": "丘丘人",
          "text": "Dada, Valo!"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Valo!"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点战斗"
        },
        {
          "type": "subtitle",
          "text": "向丘丘人回复"
        },
        {
          "role": "丘丘人",
          "text": "Dada! Tomo dada!"
        },
        {
          "role": "旅行者",
          "text": "Valo!"
        },
        {
          "role": "丘丘人",
          "text": "Valo,tomo!"
        },
        {
          "role": "丘丘人",
          "text": "Mosi mita! Yeye mimi dada tomo!"
        },
        {
          "role": "丘丘人",
          "text": "Odomu tomo zido mi! <color=#00E1FFFF> Unta mosi dada</color>！"
        },
        {
          "role": "派蒙",
          "text": "<color=#00E1FFFF> Unta mosi dada</color>…我记得是…唔…欸…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "Mosi mita dada!",
              "dialogues": []
            },
            {
              "text": "Tomo, valo!",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丘丘人",
          "text": "Valo, mi tomo!"
        }
      ]
    }
  ]
}