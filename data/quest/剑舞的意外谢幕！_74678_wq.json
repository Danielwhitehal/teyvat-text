{
  "quest_id": 74678,
  "chapter_num": null,
  "chapter_title": "剑舞的意外谢幕！",
  "type": "wq",
  "route": "Blade Dance's Unexpected End!",
  "stories": [
    {
      "story_id": 74678,
      "title": "剑舞的意外谢幕！",
      "description": "在「轻剑舞者」构筑舞台上体验了一番独特的战斗后，你和派蒙打算给科斯唐坦一些反馈，却发现事态有变…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与科斯唐坦对话"
        },
        {
          "role": "昂吉安妮",
          "text": "私斗私斗！抓起来抓起来！"
        },
        {
          "role": "昂吉安妮",
          "text": "发现危险的秘境后，不赶紧报告给执律庭，而是擅自进行调查并使用武力…你这家伙好狂啊！"
        },
        {
          "role": "科斯唐坦",
          "text": "大大大大人！我一不在枫丹廷，二打的是魔物，这也要被抓吗？"
        },
        {
          "role": "昂吉安妮",
          "text": "那你是冒险家协会的注册成员吗？"
        },
        {
          "role": "科斯唐坦",
          "text": "不是…我体能不过关，没通过测试…"
        },
        {
          "role": "昂吉安妮",
          "text": "那你有提前向执律庭报备，需要在枫丹境内使用武器吗？"
        },
        {
          "role": "科斯唐坦",
          "text": "还有这事？原来使用武器还要报备的？"
        },
        {
          "role": "昂吉安妮",
          "text": "肯定啊！不然，随便什么人都能在枫丹打架的话，执律庭不就成了摆设吗？"
        },
        {
          "role": "昂吉安妮",
          "text": "没有报备信息，小心警卫机关把你这种喜欢拿着武器瞎比划的家伙当成入侵者！"
        },
        {
          "role": "昂吉安妮",
          "text": "你看看你，简直就像个假枫丹人，被抓不冤吧？"
        },
        {
          "role": "科斯唐坦",
          "text": "失算了失算了！身为作家，取材不到位，忽略了重要的基本设定…我真是失职！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们经常随意调查秘境吧？",
              "dialogues": []
            },
            {
              "text": "我们好像也没有报备来着？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不过，我们两个早就成为冒险家了，应该没什么问题？"
        },
        {
          "role": "昂吉安妮",
          "text": "哦？你们两位来了啊，大名人！"
        },
        {
          "role": "昂吉安妮",
          "text": "咳咳，我是昂吉安妮，常年在野外值岗的老牌警备队员。不久前，我在附近巡逻的时候，发现了这个冒失的家伙…"
        },
        {
          "role": "昂吉安妮",
          "text": "他向我交待了他在这里鬼混的前因后果，介绍了这个奇怪的秘境，还说你们两位也参与了这场「剑舞」。"
        },
        {
          "role": "派蒙",
          "text": "噫！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们在秘境里玩得还挺开心的。",
              "dialogues": []
            },
            {
              "text": "你要把我们两个也一起抓走吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "昂吉安妮",
          "text": "那当然不可能了，相反，你们是见义勇为的优秀冒险家，我还要给你们一笔奖金！"
        },
        {
          "role": "昂吉安妮",
          "text": "这次我们针对的只是「未经报备就随意使用武力」这一件事，把这家伙抓回去以后，也只是对他进行口头教育。"
        },
        {
          "role": "昂吉安妮",
          "text": "他也没犯什么原则性的大错，当然不可能被重重惩罚了。"
        },
        {
          "role": "科斯唐坦",
          "text": "就算要缴纳罚金，我可能也拿不出几个摩拉…"
        },
        {
          "role": "派蒙",
          "text": "还好还好！"
        },
        {
          "role": "派蒙",
          "text": "科斯唐坦虽然说话很夸张，但肯定不是什么坏人…他只是沉迷于华丽战斗的表现，想要写好小说而已。"
        },
        {
          "role": "昂吉安妮",
          "text": "听到没，两位大名人都在给你说情了…下次别再犯这种错了，冒失的好人！"
        },
        {
          "role": "科斯唐坦",
          "text": "下次我一定会做好足够的前期铺垫，再来实地取材！"
        },
        {
          "role": "昂吉安妮",
          "text": "那我就按章办事了，先带他回执律庭，好好教育他一番。"
        },
        {
          "role": "昂吉安妮",
          "text": "再过一段时间，其他警备队员就会赶过来，控制住这座秘境…"
        },
        {
          "role": "昂吉安妮",
          "text": "不过，有你们两位在，这座秘境倒也构不成什么威胁。"
        },
        {
          "role": "昂吉安妮",
          "text": "如果你们还有兴趣，继续在里面战斗一番，击败更多魔物…也能让之后的警备队员少忙活点，算是帮大忙了！"
        },
        {
          "role": "派蒙",
          "text": "结果我们不知不觉就成了见义勇为的好人，拿到了剑舞作家和执律庭的双份奖励…也没算是白折腾吧？"
        }
      ]
    }
  ]
}