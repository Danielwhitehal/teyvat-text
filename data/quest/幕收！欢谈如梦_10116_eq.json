{
  "quest_id": 10116,
  "chapter_num": "决斗！召唤之巅！ 第四回合",
  "chapter_title": "幕收！欢谈如梦",
  "type": "eq",
  "route": "Culminate! Chatter of Joyous Dreams",
  "stories": [
    {
      "story_id": 40110,
      "title": "幕收！欢谈如梦",
      "description": "（真相大白！一段云谲波诡的旅途！没想到在卡牌之中，还有着这样的宝藏…）",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到第二天白天（8-10点）"
        },
        {
          "role": "派蒙",
          "text": "差不多该去须弥见「怪盗团」了。事件的谜底很快就能揭晓。"
        },
        {
          "role": "绮良良",
          "text": "那就先前往喀万驿吧，收货地址就在那边。"
        },
        {
          "type": "subtitle",
          "text": "前往喀万驿调查「怪盗」的真相"
        },
        {
          "role": "派蒙",
          "text": "就在这附近吧？接下来该往哪儿走？"
        },
        {
          "role": "绮良良",
          "text": "往沙漠方向走一小段就到了。不远。"
        },
        {
          "role": "夏洛蒂",
          "text": "我建议还是叫上一名卫兵吧，如果对方真是坏人，就交给卫兵处理。"
        },
        {
          "role": "派蒙",
          "text": "有道理…我看看，卫兵…卫兵…"
        },
        {
          "role": "派蒙",
          "text": "咦？那不是赛诺吗！"
        },
        {
          "role": "派蒙",
          "text": "赛诺！"
        },
        {
          "role": "赛诺",
          "text": "好久不见，几位来喀万驿有什么事吗？"
        },
        {
          "role": "绮良良",
          "text": "派蒙，客户的信息还是…"
        },
        {
          "role": "派蒙",
          "text": "嗯？啊，不用担心，这位是须弥的大风纪官赛诺，是风纪官们的首领，对于犯罪行为从不姑息！"
        },
        {
          "role": "绮良良",
          "text": "你们还认识这么厉害的人？"
        },
        {
          "role": "夏洛蒂",
          "text": "哈…绮良良小姐，这都是小场面，一路跟来的我已经习惯了…"
        },
        {
          "role": "派蒙",
          "text": "赛诺接下来有时间吗？还是说你要赶去参加「七圣召唤」的比赛？"
        },
        {
          "role": "赛诺",
          "text": "比赛？比赛已经结束了。"
        },
        {
          "role": "派蒙",
          "text": "欸？那赛诺你…"
        },
        {
          "role": "赛诺",
          "text": "我已经取得了「召唤王」的称号。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "恭喜恭喜。",
              "dialogues": []
            },
            {
              "text": "赢得轻松吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "赛诺",
          "text": "我在关键时刻使出「禁忌的一手」，抽到了…"
        },
        {
          "role": "赛诺",
          "text": "…咳，不说这个了。我目前有空。"
        },
        {
          "role": "派蒙",
          "text": "是这样…"
        },
        {
          "type": "subtitle",
          "text": "一段时间过后…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "哈…嘴巴好干…这已经是我第几次讲事情经过了…"
        },
        {
          "role": "赛诺",
          "text": "我可以与你们同行。如派蒙所言，我的职责便是维护规则、审判罪恶。"
        },
        {
          "role": "夏洛蒂",
          "text": "绮良良小姐怎么想？"
        },
        {
          "role": "绮良良",
          "text": "行，但交货时你们还是先藏在远处。"
        },
        {
          "role": "绮良良",
          "text": "我知道这位客户很可疑，但只要没有决定性证据，客户就还是客户。"
        },
        {
          "role": "派蒙",
          "text": "好，我们答应你。"
        },
        {
          "role": "夏洛蒂",
          "text": "距离远了听不到你们的谈话，如果绮良良小姐觉得事态不对的话，要怎么让我们知道呢？"
        },
        {
          "role": "绮良良",
          "text": "这不用担心，你们到时候看我尾巴行事。"
        },
        {
          "role": "派蒙",
          "text": "…尾巴？呃…看你哪条尾巴？"
        },
        {
          "role": "绮良良",
          "text": "当然是两条一起看啦！我会想办法让客户确认包裹内容的。"
        },
        {
          "role": "绮良良",
          "text": "如果对方是位正常的客户，包裹里的东西也不是牌背的话，我会把两条尾巴沉下来。你们就不要出手。"
        },
        {
          "role": "绮良良",
          "text": "如果对方真的是「怪盗」，我就…"
        },
        {
          "role": "赛诺",
          "text": "趴到地上。"
        },
        {
          "role": "夏洛蒂",
          "text": "欸？为什么？"
        },
        {
          "role": "赛诺",
          "text": "你们不是说她是妖怪吗？暗示我们「怪倒」。"
        },
        {
          "role": "夏洛蒂",
          "text": "……"
        },
        {
          "role": "绮良良",
          "text": "我才不要做那么丢人的事呢！这也太奇怪了吧！"
        },
        {
          "role": "赛诺",
          "text": "是吗？那你用尾巴拍拍自己身后也行。"
        },
        {
          "role": "夏洛蒂",
          "text": "这…这又是为什么？"
        },
        {
          "role": "赛诺",
          "text": "很简单，「拍背」。所以是…「牌背」。"
        },
        {
          "role": "夏洛蒂",
          "text": "……"
        },
        {
          "role": "夏洛蒂",
          "text": "我还是第一次在文字创意上棋逢对手…"
        },
        {
          "role": "夏洛蒂",
          "text": "赛诺先生有想过来兼职取新闻标题吗？"
        },
        {
          "role": "派蒙",
          "text": "亏你能欣赏他的幽默感…"
        },
        {
          "role": "绮良良",
          "text": "哎呀，再这么讨论下去送货时间都要到了！"
        },
        {
          "role": "绮良良",
          "text": "你们听我的，如果对方是「怪盗」，我会把尾巴变得一高一低。你们就来把他绳之以法。"
        },
        {
          "role": "赛诺",
          "text": "真的不趴下吗？"
        },
        {
          "role": "绮良良",
          "text": "不——趴——！"
        },
        {
          "type": "subtitle",
          "text": "与绮良良共同前往收货地址"
        },
        {
          "role": "派蒙",
          "text": "好荒凉啊，地址绮良良你确认过的吧？"
        },
        {
          "role": "绮良良",
          "text": "「喀万驿往沙漠方向沿大路走一百步左右看到的第一朵烈焰花旁」。地址是这么写的。"
        },
        {
          "role": "派蒙",
          "text": "这一看就不对劲吧！"
        },
        {
          "type": "subtitle",
          "text": "你们来到了所述地址附近…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "绮良良",
          "text": "第一朵烈焰花…我们到了。"
        },
        {
          "role": "派蒙",
          "text": "呃…周围一间房子都看不到呀。"
        },
        {
          "role": "绮良良",
          "text": "可能是收货人想亲自来这儿取件。这种事我以前也遇到过。"
        },
        {
          "role": "绮良良",
          "text": "还没到收货时间，你们趁现在找个地方躲起来吧。"
        },
        {
          "role": "绮良良",
          "text": "记住哦！看我尾巴行事！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（绮良良）"
        },
        {
          "role": "绮良良",
          "text": "你们快去躲起来，待会儿客户就要来了。"
        },
        {
          "role": "绮良良（内心）",
          "text": "（喵…）"
        },
        {
          "type": "subtitle",
          "text": "寻找隐蔽处"
        },
        {
          "role": "赛诺",
          "text": "就这里吧，地形隐蔽，视野不错。"
        },
        {
          "role": "派蒙",
          "text": "我觉得那个收货人肯定有问题！谁会约来这里见面嘛！"
        },
        {
          "role": "赛诺",
          "text": "嗯，我也这么想。"
        },
        {
          "role": "赛诺",
          "text": "但事关对方公司声誉，还是看她「尾色」行事吧。"
        },
        {
          "role": "夏洛蒂",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "赛诺",
          "text": "怎么了？就是「尾巴」的…"
        },
        {
          "role": "派蒙",
          "text": "啊好的好的…我们都懂…"
        },
        {
          "type": "subtitle",
          "text": "在岩石后等了一会儿…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "…你们快看！真的有人来啦！"
        },
        {
          "role": "收货人",
          "text": "你就是「狛荷屋」的快递员？"
        },
        {
          "role": "绮良良",
          "text": "没错，您就是「迪迪巴巴」先生吧？"
        },
        {
          "role": "迪迪巴巴",
          "text": "「货」呢？"
        },
        {
          "role": "绮良良",
          "text": "哦，货物都在这儿呢，您收好。"
        },
        {
          "role": "迪迪巴巴",
          "text": "……"
        },
        {
          "role": "绮良良",
          "text": "我建议您还是打开确认一下，我这几天跑了好多地方，路途颠簸，天气多变，不知里面东西有没有受影响。"
        },
        {
          "role": "迪迪巴巴",
          "text": "不必了。这一路，你没看过里面是什么吧？"
        },
        {
          "role": "绮良良",
          "text": "没有没有，这是我们公司明令禁止的。"
        },
        {
          "role": "绮良良",
          "text": "如果东西很重要的话，建议您还是确认一下。如果有损坏，我现在就可以给您赔偿。"
        },
        {
          "role": "迪迪巴巴",
          "text": "都说不必了，你怎么还要提？"
        },
        {
          "role": "帕巴格",
          "text": "老大，我看这快递员只有一个人。"
        },
        {
          "role": "帕帕克",
          "text": "不如我们…"
        },
        {
          "role": "迪迪巴巴",
          "text": "喂，你。你今天是一个人来的吧？"
        },
        {
          "role": "绮良良",
          "text": "欸？对…对呀，怎么可能带好多人一起送快递嘛。"
        },
        {
          "role": "绮良良",
          "text": "（糟了！我不擅长说谎！一说谎尾巴就上下摇个不停！）"
        },
        {
          "role": "派蒙",
          "text": "来信号了！"
        },
        {
          "role": "派蒙",
          "text": "咦？这…这和说好的不一样啊！"
        },
        {
          "role": "赛诺",
          "text": "……"
        },
        {
          "role": "绮良良",
          "text": "啊啊啊对了，这…这其实刚好是我职业生涯的第一百份快递，很有纪念意义！"
        },
        {
          "role": "绮良良",
          "text": "要是各位能让我知道这次送的是什么，我会很高兴的！"
        },
        {
          "role": "派蒙",
          "text": "尾巴摇得更厉害了！"
        },
        {
          "role": "派蒙",
          "text": "哎呀，这我们到底是去还是不去呀？"
        },
        {
          "role": "赛诺",
          "text": "她尾巴一直摇摆交错…指向的是东边？西边？"
        },
        {
          "role": "赛诺",
          "text": "…！难道说，她想表达自己「东西交错」了！"
        },
        {
          "role": "派蒙",
          "text": "这也太牵强了吧！尾巴怎么可能传达那么多信息啦！"
        },
        {
          "role": "迪迪巴巴",
          "text": "嘶…不对劲，果然还是不太对劲。小妹妹你对这货物也太关心了。"
        },
        {
          "role": "绮良良",
          "text": "啊哈哈…这，这不是对客户负责嘛…您真的不看一眼？"
        },
        {
          "role": "帕巴格",
          "text": "老大，动手吧！"
        },
        {
          "role": "帕帕克",
          "text": "这荒郊野岭，没人知道！"
        },
        {
          "role": "绮良良",
          "text": "呃…那，那您能抽空给我个五星好评…"
        },
        {
          "role": "迪迪巴巴",
          "text": "哼，我这就抽空把你给埋了！"
        },
        {
          "role": "派蒙",
          "text": "呜啊！对方刀子都亮出来了！这总不用想了吧！"
        },
        {
          "role": "派蒙",
          "text": "我们快去救绮良良！"
        },
        {
          "role": "帕巴格",
          "text": "老大！有救兵！"
        },
        {
          "role": "迪迪巴巴",
          "text": "怕什么？照样给我上！"
        },
        {
          "role": "帕帕克",
          "text": "咦？不对…那…那是大风纪官赛诺！"
        },
        {
          "role": "迪迪巴巴",
          "text": "赛…赛诺？！"
        },
        {
          "type": "subtitle",
          "text": "击退敌人"
        },
        {
          "type": "subtitle",
          "text": "与收货人对话"
        },
        {
          "role": "派蒙",
          "text": "绮良良，你没受伤吧？"
        },
        {
          "role": "绮良良",
          "text": "没事没事，一切都好。"
        },
        {
          "role": "迪迪巴巴",
          "text": "嘁…没想到，栽在了这里…"
        },
        {
          "role": "赛诺",
          "text": "后悔已晚。至于你们，我不想再听到任何苍白的辩解。"
        },
        {
          "role": "帕巴格",
          "text": "…明白，我们明白！"
        },
        {
          "role": "帕帕克",
          "text": "…大风纪官赛诺大人，我、我可不想晕过去啊，还请您手下留情！"
        },
        {
          "role": "赛诺",
          "text": "看你们老不老实了。"
        },
        {
          "role": "帕帕克",
          "text": "…我们说，我们说。"
        },
        {
          "role": "赛诺",
          "text": "是什么货？"
        },
        {
          "role": "帕帕克",
          "text": "是牌背，是从各地收集的「七圣召唤」牌背…"
        },
        {
          "role": "派蒙",
          "text": "是不是背后画了一个宝箱的模样？"
        },
        {
          "role": "帕巴格",
          "text": "没错，没错，您连这都知道！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们是什么人？",
              "dialogues": []
            },
            {
              "text": "为什么要偷牌背？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "帕巴格",
          "text": "我…我们只是一伙盗宝团而已…"
        },
        {
          "role": "帕帕克",
          "text": "最近有人不满足于小偷小摸，想搞一票大的…就…就…"
        },
        {
          "role": "赛诺",
          "text": "说。"
        },
        {
          "role": "帕帕克",
          "text": "就想做一个惊天动地的跨国案件！"
        },
        {
          "role": "派蒙",
          "text": "跨国案件？"
        },
        {
          "role": "帕巴格",
          "text": "我们打算在各个国家，同一时间偷走一件重要的宝物…"
        },
        {
          "role": "帕巴格",
          "text": "这样，所有人都会知道我们盗宝团才是最厉害的跨国组织！"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "帕巴格",
          "text": "呃…现…现在不行了…"
        },
        {
          "role": "派蒙",
          "text": "那这和牌背有什么关系？"
        },
        {
          "role": "帕帕克",
          "text": "我们遇到的难题是，如何将这宏大的计划传达给所有盗宝团…"
        },
        {
          "role": "帕帕克",
          "text": "突然，有人提出最近「七圣召唤」这游戏很火，可以用卡牌作为媒介，躲过各类搜查。"
        },
        {
          "role": "派蒙",
          "text": "原来这牌是你们自己印的。"
        },
        {
          "role": "帕帕克",
          "text": "嗯…所有盗宝团成员看到宝箱都知道该怎么做…"
        },
        {
          "role": "帕帕克",
          "text": "先把它埋起来，这才不会被捡走。用在这上面的话…"
        },
        {
          "role": "帕巴格",
          "text": "嘘，你再说，我们全部人的计划…"
        },
        {
          "role": "赛诺",
          "text": "……"
        },
        {
          "role": "赛诺",
          "text": "看来这早晚要失败的计划，比你们的命还重要。"
        },
        {
          "role": "帕帕克",
          "text": "呃啊啊！不不不，我说，说…"
        },
        {
          "role": "帕帕克",
          "text": "只要用土或者沙子加点水盖在上面…过一会儿再擦去的话…"
        },
        {
          "role": "帕帕克",
          "text": "就变成了这个样子。"
        },
        {
          "role": "派蒙",
          "text": "「所有盗宝团的兄弟，我们这次干一票大的。都拿起你们的匕首，蒙上你们的脸，最好再带上身边的驮兽…」"
        },
        {
          "role": "派蒙",
          "text": "「哦，其他地方没有驮兽的话…」"
        },
        {
          "role": "派蒙",
          "text": "呃，怎么印了这么多没用的东西？"
        },
        {
          "role": "帕巴格",
          "text": "什么叫没用的东西？这都是战前动员！"
        },
        {
          "role": "帕帕克",
          "text": "行…行动时间和计划都印在最后了…"
        },
        {
          "role": "派蒙",
          "text": "我看看…还真是！"
        },
        {
          "role": "夏洛蒂",
          "text": "嗯…客观评价的话，这传播方式还算有创意。"
        },
        {
          "role": "夏洛蒂",
          "text": "但最后为什么又要收回来呢？"
        },
        {
          "role": "帕巴格",
          "text": "还不是盗宝团里有人迷上了「七圣召唤」！"
        },
        {
          "role": "帕巴格",
          "text": "明明照计划行事就对了，偏有人管不住手，要去打牌！还不忘炫耀这牌背！"
        },
        {
          "role": "帕巴格",
          "text": "这些也就算了，最后…还把牌背输给了别人！"
        },
        {
          "role": "夏洛蒂",
          "text": "你们怕行动计划暴露，这才紧急派人去回收流落到坊间的牌背。"
        },
        {
          "role": "帕帕克",
          "text": "不仅仅是流落到坊间的，这次所有宝箱牌背都寄回来了…"
        },
        {
          "role": "帕帕克",
          "text": "我们担心计划已经泄漏，原本准备重印一次，改一下行动时间再发出去…"
        },
        {
          "role": "帕帕克",
          "text": "为了保证万无一失…我们还专门筹资用最安全准时的「狛荷屋」来寄件…"
        },
        {
          "role": "绮良良",
          "text": "欸？啊…呃…谢谢夸奖…"
        },
        {
          "role": "夏洛蒂",
          "text": "所以寄件人留在当地，是为了保证之后行动可以继续进行。"
        },
        {
          "role": "夏洛蒂",
          "text": "这么一想，被拿走牌背的人遇上盗宝团的事也说得通了…"
        },
        {
          "role": "派蒙",
          "text": "对哦！我说怎么一路上都是盗宝团，原来是想封住当事人的口！"
        },
        {
          "role": "帕帕克",
          "text": "我…我们知道的也就这些了。谅在我们将功补过的份上…还请赛诺大人宽宏大量，宽宏大量…"
        },
        {
          "role": "赛诺",
          "text": "自会有针对你们的审判。闲话少说，跟我走吧。"
        },
        {
          "type": "subtitle",
          "text": "在喀万驿与赛诺对话"
        },
        {
          "type": "subtitle",
          "text": "随赛诺回到了喀万驿不久后…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "赛诺",
          "text": "犯人我先临时安置了一番，稍后就押送回须弥城。"
        },
        {
          "role": "旅行者",
          "text": "辛苦了。"
        },
        {
          "role": "赛诺",
          "text": "职责所在，也多亏各位。"
        },
        {
          "role": "夏洛蒂",
          "text": "（一旦进入工作状态，赛诺先生就像变了个人呢…）"
        },
        {
          "role": "赛诺",
          "text": "那就有缘再见了。"
        },
        {
          "role": "夏洛蒂",
          "text": "欸等等等等…我还想采访一下须弥赛区的冠军呢。"
        },
        {
          "role": "赛诺",
          "text": "你问吧。"
        },
        {
          "role": "夏洛蒂",
          "text": "请问赛诺先生对这次比赛有什么感悟吗？或者…对这次事件的感悟也行。"
        },
        {
          "role": "赛诺",
          "text": "嗯…"
        },
        {
          "role": "赛诺",
          "text": "「七圣召唤」是一个不错的卡牌游戏，堪称艺术。它让许多人得以相识、相知，共同体会决斗的乐趣。"
        },
        {
          "role": "赛诺",
          "text": "我希望每一个人都能享受它带来的快乐。"
        },
        {
          "role": "夏洛蒂",
          "text": "不错的发言，都能作为新闻稿结尾了。"
        },
        {
          "role": "赛诺",
          "text": "所以，如果有不法之徒妄想让这游戏沾染上肮脏的私欲…无论身处何地，逃往何方，我必将对其降下审判的雷霆！"
        },
        {
          "role": "夏洛蒂",
          "text": "啊…好，好，您别激动，别激动…"
        },
        {
          "role": "夏洛蒂",
          "text": "我想想…"
        },
        {
          "role": "夏洛蒂",
          "text": "「埋于『卡牌』中的『宝物』，隐于『召唤』下的…的…」"
        },
        {
          "role": "赛诺",
          "text": "谜「团」。"
        },
        {
          "role": "夏洛蒂",
          "text": "哦！这个好！"
        },
        {
          "role": "派蒙",
          "text": "这俩人还真是说得到一起去…"
        },
        {
          "role": "赛诺",
          "text": "没其他事的话，我就先告辞了。"
        },
        {
          "role": "赛诺",
          "text": "还得通知其他地方小心盗宝「团」的计划。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "多保重。",
              "dialogues": []
            },
            {
              "text": "下次来局「七圣召唤」。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "赛诺",
          "text": "嗯，一定。"
        },
        {
          "role": "派蒙",
          "text": "搞了这么久，「怪盗团」原来就是「盗宝团」啊…"
        },
        {
          "role": "派蒙",
          "text": "总觉得有些失望…还以为牌背里真有什么绝世宝藏的线索呢。"
        },
        {
          "role": "夏洛蒂",
          "text": "话也不能这么说，往好处想，我们也算破获了一宗国际大案嘛！"
        },
        {
          "role": "夏洛蒂",
          "text": "这下「独家新闻」的素材肯定不缺了。"
        },
        {
          "role": "派蒙",
          "text": "要是说还有什么遗憾的话，就是没见到两位「七圣召唤」的神秘发明人了吧。"
        },
        {
          "role": "绮良良",
          "text": "哈哈，感觉大家都很喜欢「七圣召唤」呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "主要是喜欢打牌。",
              "dialogues": []
            },
            {
              "text": "主要是喜欢交朋友。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "绮良良",
          "text": "既然这样的话，我这里还有份比较特殊的快递，不如大家一起去送吧？"
        },
        {
          "role": "派蒙",
          "text": "是和「七圣召唤」有关吗？"
        },
        {
          "role": "绮良良",
          "text": "嗯，没错，大家去了就知道啦。"
        },
        {
          "role": "绮良良",
          "text": "要不是那位赛诺先生忙于工作，我也想邀请他一起来的。"
        },
        {
          "role": "夏洛蒂",
          "text": "这样好吗？之前不是说，客户的信息…"
        },
        {
          "role": "绮良良",
          "text": "哦，这次的没事啦。"
        },
        {
          "role": "绮良良",
          "text": "要说的话…这不是公司安排给我的任务。"
        },
        {
          "role": "绮良良",
          "text": "这份快递在公司放了很久很久。原因是找不到收件人，附近的邻居也不知道他去了哪儿。"
        },
        {
          "role": "派蒙",
          "text": "也就是所谓的「滞留件」吧？"
        },
        {
          "role": "绮良良",
          "text": "嗯，它上个月就过了滞留期，要被拿去处理掉了。"
        },
        {
          "role": "夏洛蒂",
          "text": "不能退回寄件人手中吗？"
        },
        {
          "role": "绮良良",
          "text": "这个…其实寄件人…已经去世了。"
        },
        {
          "role": "派蒙",
          "text": "怎么这样…"
        },
        {
          "role": "绮良良",
          "text": "嗯…如果收不到这份快递的话，寄件人和收件人都会很难过吧。"
        },
        {
          "role": "绮良良",
          "text": "我自作主张地用闲暇时间在须弥各地打听了一番，最后总算知道他去了哪儿，也听说了他的过往。"
        },
        {
          "role": "派蒙",
          "text": "哇！这么厉害！到底是谁呀？"
        },
        {
          "role": "绮良良",
          "text": "这个嘛…嘿嘿，你们跟我来就是了。"
        },
        {
          "role": "绮良良",
          "text": "而且我觉得…对方一定也需要热爱「七圣召唤」的你们。"
        },
        {
          "role": "夏洛蒂",
          "text": "听起来又是个不错的题材…嗯，我加入。"
        },
        {
          "role": "派蒙",
          "text": "绮良良说得我好在意…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你也会去的吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当然。",
              "dialogues": []
            },
            {
              "text": "这是身为牌手的职责。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "绮良良",
          "text": "嗯，那大家就和我一起去维摩庄吧！"
        },
        {
          "type": "subtitle",
          "text": "前往维摩庄，寄送快递"
        },
        {
          "role": "绮良良",
          "text": "线索指向维摩庄，但具体住在哪栋房子里还不知道。"
        },
        {
          "role": "绮良良",
          "text": "我们就顺路打听一下吧。"
        },
        {
          "role": "派蒙",
          "text": "那人有什么特征吗？"
        },
        {
          "role": "绮良良",
          "text": "他名叫伽吠毗陀，是位教令院的学者。"
        },
        {
          "role": "派蒙",
          "text": "伽吠毗陀，好，我记住了。"
        },
        {
          "type": "subtitle",
          "text": "向扎蒂斯打听学者的下落"
        },
        {
          "role": "派蒙",
          "text": "你好，请问你知道伽吠毗陀住在哪儿吗？"
        },
        {
          "role": "扎蒂斯",
          "text": "没听过这名字啊…"
        },
        {
          "role": "派蒙",
          "text": "是位教令院的学者。"
        },
        {
          "role": "扎蒂斯",
          "text": "学者这里倒是有…但没听说过有叫这名字的。"
        },
        {
          "role": "扎蒂斯",
          "text": "对了，你们这消息准吗？我…我想请教一下他关于六大学派的选择建议！"
        },
        {
          "role": "派蒙",
          "text": "唔…看来他不知道呢，我们再找别人问问。"
        },
        {
          "type": "subtitle",
          "text": "向阿莲佐打听学者的下落"
        },
        {
          "role": "派蒙",
          "text": "你好，我们在找一位叫伽吠毗陀的学者。"
        },
        {
          "role": "阿莲佐",
          "text": "伽吠毗陀？没听过，是新名字啊…"
        },
        {
          "role": "阿莲佐",
          "text": "欸等等，难道是那位前些日子来的新面孔？"
        },
        {
          "role": "派蒙",
          "text": "你有印象吗？"
        },
        {
          "role": "阿莲佐",
          "text": "还真有。那人愁眉苦脸的，简直像被论文折磨透了一样。"
        },
        {
          "role": "阿莲佐",
          "text": "我看到他去找过村长，应该是想租个屋住吧。"
        },
        {
          "role": "阿莲佐",
          "text": "维摩庄适合度假养神，这不，我最后也选择回到这儿了嘛。"
        },
        {
          "role": "派蒙",
          "text": "明白了。谢谢你，我们去找村长问问。"
        },
        {
          "role": "阿莲佐",
          "text": "嗯，你们要是遇到了不顺心的事，也可以来这儿住住。"
        },
        {
          "type": "subtitle",
          "text": "向村长打听学者的下落"
        },
        {
          "role": "派蒙",
          "text": "村长，我们想打听个事。"
        },
        {
          "role": "阿玛兹亚",
          "text": "说吧，我听着呢。"
        },
        {
          "role": "派蒙",
          "text": "您知不知道名叫伽吠毗陀的学者住在哪儿？"
        },
        {
          "role": "阿玛兹亚",
          "text": "伽吠毗陀？哦，是那位吧…"
        },
        {
          "role": "派蒙",
          "text": "您记得？"
        },
        {
          "role": "阿玛兹亚",
          "text": "记得，记得。他来我这儿租了间屋子住，说是要散散心。"
        },
        {
          "role": "阿玛兹亚",
          "text": "谁知他住进去之后就几乎没有出来过，也不和别人打招呼。"
        },
        {
          "role": "阿玛兹亚",
          "text": "我看这哪是散心哟…简直是把心锁起来了…"
        },
        {
          "role": "阿玛兹亚",
          "text": "你们是他的朋友？"
        },
        {
          "role": "绮良良",
          "text": "嗯，算是吧。"
        },
        {
          "role": "派蒙",
          "text": "（咦？尾巴又摇起来了，原来是在说谎的时候才会摇吗？）"
        },
        {
          "role": "阿玛兹亚",
          "text": "好，好…我看他的确需要有朋友来看看了。"
        },
        {
          "role": "阿玛兹亚",
          "text": "他就住在上边最角落的那个小房子里，你们去和他聊聊吧。"
        },
        {
          "role": "派蒙",
          "text": "好，谢谢村长！"
        },
        {
          "role": "阿玛兹亚",
          "text": "没什么…我只希望看到来这儿的人都开开心心。"
        },
        {
          "type": "subtitle",
          "text": "前往小屋，与伽吠毗陀对话"
        },
        {
          "role": "派蒙",
          "text": "就是这里了，我们先敲敲门吧。"
        },
        {
          "role": "派蒙",
          "text": "有人吗？我们找伽吠毗陀先生。"
        },
        {
          "role": "伽吠毗陀",
          "text": "……"
        },
        {
          "role": "伽吠毗陀",
          "text": "…我就是伽吠毗陀。你们有什么事吗？"
        },
        {
          "role": "绮良良",
          "text": "伽吠毗陀先生，我是「狛荷屋」的绮良良。这是您的快递。送达时间迟了不少，还请您收下。"
        },
        {
          "role": "伽吠毗陀",
          "text": "我的…快递？"
        },
        {
          "role": "绮良良",
          "text": "是古拉卜先生寄给您的。"
        },
        {
          "role": "伽吠毗陀",
          "text": "…什…什么？古拉卜…？他…他已经…"
        },
        {
          "role": "绮良良",
          "text": "嗯…这是您的朋友生前交予我们公司的。"
        },
        {
          "role": "伽吠毗陀",
          "text": "朋友…哈…连他的病都无计可施，甚至没有在生命最后时刻陪在他身边的人…还怎么好意思说是「朋友」…"
        },
        {
          "role": "绮良良",
          "text": "您别这么说。您和古拉卜先生一同发明的「七圣召唤」如今这么受欢迎，我想他一定会很高兴的。"
        },
        {
          "role": "派蒙",
          "text": "欸？！这…这位就是发明了「七圣召唤」的人？"
        },
        {
          "role": "伽吠毗陀",
          "text": "哎…为什么…为什么厄运总是降临到像他那样的天才身上…"
        },
        {
          "role": "夏洛蒂",
          "text": "您不介意的话，可以讲给我们听听，一般说出来会好很多。"
        },
        {
          "role": "伽吠毗陀",
          "text": "……"
        },
        {
          "role": "伽吠毗陀",
          "text": "哈…你说得对…或许我是该说说了…"
        },
        {
          "role": "伽吠毗陀",
          "text": "你们…真的愿意听吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要了解…",
              "dialogues": []
            },
            {
              "text": "说出来好些…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伽吠毗陀",
          "text": "好吧…也不是什么了不得的故事…"
        },
        {
          "role": "伽吠毗陀",
          "text": "我和古拉卜从小认识，一起学习、一起长大。"
        },
        {
          "role": "伽吠毗陀",
          "text": "除了手上的绷带之外，他一点不像得了魔鳞病的样子。总是那么乐观、平和、善良…"
        },
        {
          "role": "伽吠毗陀",
          "text": "后来，我们一起到了教令院。他还成为了明论派陀裟多。"
        },
        {
          "role": "夏洛蒂",
          "text": "我记得那是个挺高的职称。"
        },
        {
          "role": "伽吠毗陀",
          "text": "哈哈…是啊，他总是那么厉害…"
        },
        {
          "role": "伽吠毗陀",
          "text": "但没过多久，他身上的魔鳞病加重了…还引发了严重的并发症…"
        },
        {
          "role": "伽吠毗陀",
          "text": "到后来，只能老老实实躺在医院的床上接受治疗。他的研究也就此荒废。"
        },
        {
          "role": "伽吠毗陀",
          "text": "我每天都去医院看望他。他倒好，叫我不要去得那么勤快…"
        },
        {
          "role": "夏洛蒂",
          "text": "他一定是在担心，你会因此耽搁了自己的研究吧。"
        },
        {
          "role": "伽吠毗陀",
          "text": "我知道…但越是这样越是叫我不忍心…明明，他才是更优秀的那一个…"
        },
        {
          "role": "伽吠毗陀",
          "text": "来医院看他的时候，我俩闲着也是闲着，就拿了些牌来涂涂画画。"
        },
        {
          "role": "伽吠毗陀",
          "text": "渐渐地，就变成了「七圣召唤」。"
        },
        {
          "role": "旅行者",
          "text": "因「友谊」而生的游戏…"
        },
        {
          "role": "伽吠毗陀",
          "text": "这不仅仅是游戏…在发明它的时候，我还融入了一些相关的元素理论知识。"
        },
        {
          "role": "伽吠毗陀",
          "text": "原本想等他康复之后，我俩再一起研究课题，结果…"
        },
        {
          "role": "派蒙",
          "text": "你别太难过，「七圣召唤」就是你们一起研究的成果。"
        },
        {
          "role": "派蒙",
          "text": "现在这个成果，已经被好多好多人喜欢啦。"
        },
        {
          "role": "伽吠毗陀",
          "text": "哎…在他走后，我试过和别人玩「七圣召唤」…"
        },
        {
          "role": "伽吠毗陀",
          "text": "但从牌桌上抬起头的时候…眼前浮现的，却总是他的模样。就好像他从未离开…"
        },
        {
          "role": "伽吠毗陀",
          "text": "但我知道这不是真的…"
        },
        {
          "role": "派蒙",
          "text": "呜…我理解。要是有一天我和旅行者分开了，我也一定习惯不了…可能还会对着空气自言自语…"
        },
        {
          "role": "伽吠毗陀",
          "text": "是啊…认识的人都叫我看开点，去享受「七圣召唤」的乐趣，说我是什么「发明人」之一…"
        },
        {
          "role": "伽吠毗陀",
          "text": "但要我说的话…没了古拉卜，这「七圣召唤」，还有什么意思…"
        },
        {
          "role": "绮良良",
          "text": "…伽吠毗陀先生。不如，先看看您的朋友给您寄了什么吧。"
        },
        {
          "role": "伽吠毗陀",
          "text": "…哎…也对。"
        },
        {
          "role": "伽吠毗陀",
          "text": "…！这是…一封信？"
        },
        {
          "type": "subtitle",
          "text": "过场动画（[https://www.bilibili.com/video/BV1GM4y1e7rp?p=1 「牌中秘宝」]）"
        },
        {
          "role": "古拉卜",
          "text": "亲爱的挚友，你一定在疑惑"
        },
        {
          "role": "古拉卜",
          "text": "我为什么要用这样的方式给你留信吧？"
        },
        {
          "role": "古拉卜",
          "text": "还不是因为……"
        },
        {
          "role": "伽吠毗陀",
          "text": "古拉卜！我来啦，今天感觉怎么样？"
        },
        {
          "role": "伽吠毗陀",
          "text": "嘿嘿，告诉你，我昨晚又想到了一个卡牌的…"
        },
        {
          "role": "伽吠毗陀",
          "text": "咦？你在写东西吗？"
        },
        {
          "role": "古拉卜",
          "text": "啊，没什么"
        },
        {
          "role": "伽吠毗陀",
          "text": "好，那我们就来上一局吧！"
        },
        {
          "role": "古拉卜",
          "text": "你可以不用每天来的，教令院的工作应该很辛苦才对…"
        },
        {
          "role": "伽吠毗陀",
          "text": "这怎么行？到你完全康复之前，我都会来"
        },
        {
          "role": "伽吠毗陀",
          "text": "再说了，教令院里的人都闷得很！"
        },
        {
          "role": "伽吠毗陀",
          "text": "来，到你的回合了"
        },
        {
          "role": "古拉卜",
          "text": "咳咳咳…！"
        },
        {
          "role": "伽吠毗陀",
          "text": "古拉卜，你没事吧？"
        },
        {
          "role": "古拉卜",
          "text": "咳咳…伽吠毗陀…你应该知道的"
        },
        {
          "role": "古拉卜",
          "text": "我的魔鳞病已经…"
        },
        {
          "role": "伽吠毗陀",
          "text": "行了！别再说了！"
        },
        {
          "role": "伽吠毗陀",
          "text": "你只是…没休息好而已…"
        },
        {
          "role": "古拉卜",
          "text": "哎…"
        },
        {
          "role": "古拉卜",
          "text": "还不是因为，你一直无法接受我已经来日无多的事实…"
        },
        {
          "role": "古拉卜",
          "text": "你知道吗，我俩发明的这游戏"
        },
        {
          "role": "古拉卜",
          "text": "最近好像在医院里流行起来了"
        },
        {
          "role": "伽吠毗陀",
          "text": "哦？这不是好事吗？"
        },
        {
          "role": "古拉卜",
          "text": "是啊，我为此还做了个道具"
        },
        {
          "role": "古拉卜",
          "text": "让大家可以寻找到附近的牌手"
        },
        {
          "role": "古拉卜",
          "text": "来，也给你一个"
        },
        {
          "role": "古拉卜",
          "text": "这样，就算我不在了，你也能找到新的…"
        },
        {
          "role": "伽吠毗陀",
          "text": "够了！"
        },
        {
          "role": "伽吠毗陀",
          "text": "我都说了你会康复的！这东西…我不要！"
        },
        {
          "role": "古拉卜",
          "text": "当时送你的那个秘典之盒"
        },
        {
          "role": "古拉卜",
          "text": "恐怕早就被你丢到某个角落里去了吧…"
        },
        {
          "role": "古拉卜",
          "text": "所以，这最后一件礼物，就原谅我现在才送到你手上吧"
        },
        {
          "role": "古拉卜",
          "text": "还记得我们刚认识的时候吗？"
        },
        {
          "role": "古拉卜",
          "text": "只有你愿意和我这个得了魔鳞病的孩子做朋友"
        },
        {
          "role": "古拉卜",
          "text": "这次，该换我带你去结交新朋友了"
        },
        {
          "role": "古拉卜",
          "text": "挚友啊…就让我用这样的方式，继续陪在你身边吧…"
        },
        {
          "role": "伽吠毗陀",
          "text": "……"
        },
        {
          "role": "伽吠毗陀",
          "text": "古拉卜…你这家伙…就连这种时候都还是老样子…"
        },
        {
          "role": "绮良良",
          "text": "我没怎么玩过「七圣召唤」，只知道它为大家带来了很多快乐。"
        },
        {
          "role": "夏洛蒂",
          "text": "嗯，借一位牌手的话说，它让许多人得以相识、相知，共同体会决斗的乐趣。"
        },
        {
          "role": "派蒙",
          "text": "没错，我们一路走来，见证了好多这样的故事呢！"
        },
        {
          "role": "派蒙",
          "text": "如果你感兴趣的话，我可以一个一个说给你听。"
        },
        {
          "role": "伽吠毗陀",
          "text": "…谢谢你们这么说。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "朋友不会永远离去。",
              "dialogues": []
            },
            {
              "text": "而是以另一种形式陪在我们身边。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伽吠毗陀",
          "text": "…你说得对。"
        },
        {
          "role": "伽吠毗陀",
          "text": "哈哈…古拉卜，你留下这封信的时候，难道已经想到这些了吗…"
        },
        {
          "role": "伽吠毗陀",
          "text": "你的秘典之盒…我一直都带在身边…"
        },
        {
          "role": "伽吠毗陀",
          "text": "难得你为我画了这么一张牌，不把它用出去一次，那得多浪费啊…"
        },
        {
          "role": "伽吠毗陀",
          "text": "我想，如果是他在这儿的话，一定会这么说吧——"
        },
        {
          "role": "伽吠毗陀",
          "text": "「朋友们，要来一局『七圣召唤』吗？」"
        },
        {
          "role": "旅行者",
          "text": "乐意奉陪。"
        },
        {
          "type": "subtitle",
          "text": "同众人告别"
        },
        {
          "type": "subtitle",
          "text": "与伽吠毗陀进行了一局愉快的决斗…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "伽吠毗陀好像释怀不少，和你打牌时，我还看见他笑了呢。"
        },
        {
          "role": "夏洛蒂",
          "text": "完全走出悲伤或许需要一段时间，但我觉得这是个好的开始。"
        },
        {
          "role": "派蒙",
          "text": "嗯！还好绮良良没有丢掉那封滞留件呢。"
        },
        {
          "role": "绮良良",
          "text": "怎么说呢…那天老板让我去处理它的时候，我冥冥之中觉得不能这么做，一定要把它送到对方手上。"
        },
        {
          "role": "派蒙",
          "text": "这是「妖怪」的直觉吗？"
        },
        {
          "role": "绮良良",
          "text": "我不知道，也可能…只是不想让对方的心意就这么白白消失吧。"
        },
        {
          "role": "夏洛蒂",
          "text": "我差不多在这儿和大家分别吧。"
        },
        {
          "role": "派蒙",
          "text": "是要回枫丹了吗？"
        },
        {
          "role": "夏洛蒂",
          "text": "嗯，「卡牌怪盗」告一段落，还意外收获了这么有价值的故事。光是新闻稿都够我写上几天了。"
        },
        {
          "role": "夏洛蒂",
          "text": "哦对了，我从头到尾，还没采访过两位呢。"
        },
        {
          "role": "夏洛蒂",
          "text": "这一趟旅途见证了这么多故事，二位有什么想说的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交到了许多新朋友…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对！这一次最大的收获，就是认识了许多新朋友呢！"
                }
              ]
            },
            {
              "text": "了解了更多「七圣召唤」…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯！以后打牌的时候，会想到很多不一样的东西呢！"
                }
              ]
            }
          ]
        },
        {
          "role": "夏洛蒂",
          "text": "我明白了，二位的感悟，我也会写入夏洛蒂「独家新闻」里的。"
        },
        {
          "role": "夏洛蒂",
          "text": "下次来枫丹，别忘了买上一份《蒸汽鸟报》哟！"
        },
        {
          "role": "绮良良",
          "text": "那我也准备回稻妻了。这次的事，还得和老板汇报呢。"
        },
        {
          "role": "旅行者",
          "text": "大家都多保重。"
        },
        {
          "role": "夏洛蒂",
          "text": "嗯！我们肯定还会见面的。"
        },
        {
          "role": "夏洛蒂",
          "text": "等到那时，如果有机会，也来一局「七圣召唤」吧。"
        },
        {
          "type": "subtitle",
          "text": "彩蛋（迪奥娜）"
        },
        {
          "type": "subtitle",
          "text": "迪奥娜在蒙德城外的传送锚点旁",
          "narration": true
        },
        {
          "role": "迪奥娜",
          "text": "臭老爹，要打牌吗？"
        },
        {
          "role": "迪奥娜",
          "text": "我可有言在先哦！要是你今天喝了酒，脑袋晕乎乎的，肯定在三回合内就输给我了。"
        },
        {
          "role": "杜拉夫",
          "text": "三回合？迪奥娜是不是有点小看爸爸了啊？"
        },
        {
          "role": "杜拉夫",
          "text": "再怎么说也能拖到五回合吧。"
        },
        {
          "role": "迪奥娜",
          "text": "一样是输！那有什么好骄傲的！"
        },
        {
          "role": "迪奥娜",
          "text": "上次，臭老爹你还指着水元素的骰子，对我说是冰元素！气死人了。"
        },
        {
          "role": "杜拉夫",
          "text": "哈哈哈，是我眼神不好…"
        },
        {
          "role": "迪奥娜",
          "text": "是「酒」不好！不许为它辩护。"
        },
        {
          "role": "杜拉夫",
          "text": "好好好，是酒不好。那今天就先不喝了，一滴也不碰，这下总行了吧？"
        },
        {
          "role": "迪奥娜",
          "text": "勉勉强强。"
        },
        {
          "role": "杜拉夫",
          "text": "那我要是赢了迪奥娜呢？有没有什么奖励？"
        },
        {
          "role": "迪奥娜",
          "text": "想我给你做一杯特调？门都没有！"
        },
        {
          "role": "杜拉夫",
          "text": "如果是在五回合之内赢的呢？…"
        },
        {
          "role": "迪奥娜",
          "text": "小看我！来就来…我才不会输呢！"
        },
        {
          "type": "subtitle",
          "text": "彩蛋（北斗&枫原万叶）"
        },
        {
          "type": "subtitle",
          "text": "北斗和万叶在孤云阁圣遗物本旁边",
          "narration": true
        },
        {
          "role": "北斗",
          "text": "几日不见，小子，你的牌技怎么长进这么多？"
        },
        {
          "role": "枫原万叶",
          "text": "多亏和高人交过手。"
        },
        {
          "role": "北斗",
          "text": "哦？哪位高人？你先别急着说…让我猜猜。"
        },
        {
          "role": "北斗",
          "text": "凝光那家伙没这个闲心，香菱和辛焱也不是一直琢磨牌的人…"
        },
        {
          "role": "北斗",
          "text": "瑶瑶最近要是不忙，早耐不住往船上跑，和大家打招呼了。也不会是她。"
        },
        {
          "role": "北斗",
          "text": "难道是旅行者？他刚巧也来璃月港了？"
        },
        {
          "role": "枫原万叶",
          "text": "可惜大姐头还是猜的不对。我的确和旅行者同行了一阵，期间也「以牌会友」…"
        },
        {
          "role": "北斗",
          "text": "新朋友？那我就猜不出了。"
        },
        {
          "role": "枫原万叶",
          "text": "往生堂堂主，胡桃小姐。大姐头可有耳闻？"
        },
        {
          "role": "北斗",
          "text": "听倒是听说过。这次拿了「召唤王大奖赛」冠军的也是她吧？"
        },
        {
          "role": "枫原万叶",
          "text": "正是。她还说对大姐头崇拜已久，一直想跟你交个朋友。"
        },
        {
          "role": "北斗",
          "text": "那好啊！这不是正好吗？"
        },
        {
          "role": "北斗",
          "text": "把她请来船上，切磋上几局，让我仰望仰望冠军的风采。"
        },
        {
          "role": "北斗",
          "text": "唔…这么说来，是不是还是我亲自去往生堂，显得比较有诚意？"
        },
        {
          "type": "subtitle",
          "text": "彩蛋（珊瑚宫心海）"
        },
        {
          "type": "subtitle",
          "text": "心海在曚云神社七天神像旁边",
          "narration": true
        },
        {
          "role": "珊瑚宫心海",
          "text": "咦？旅行者，你是专程回来见我的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「怪盗」…",
              "dialogues": [
                {
                  "role": "珊瑚宫心海",
                  "text": "原来谜底是这样…让人不知该以怎样的表情面对呢。"
                },
                {
                  "role": "珊瑚宫心海",
                  "text": "谢谢你能告诉我这些。"
                },
                {
                  "role": "珊瑚宫心海",
                  "text": "就像读完了小说的结尾，这下可以安心了。"
                }
              ]
            },
            {
              "text": "关于「比赛」…",
              "dialogues": [
                {
                  "role": "珊瑚宫心海",
                  "text": "「胜负不是最重要的。」「要打出风度。」——原本我一直这么想着。"
                },
                {
                  "role": "珊瑚宫心海",
                  "text": "可看着你们为我加油的样子，不知不觉就想以最认真的姿态面对了。"
                },
                {
                  "role": "珊瑚宫心海",
                  "text": "呵呵…这一想，能在比赛前见到你们真是太好了。"
                },
                {
                  "role": "旅行者",
                  "text": "能量值+5？"
                },
                {
                  "role": "珊瑚宫心海",
                  "text": "唔…！不，不要再提那个了啦！"
                }
              ]
            },
            {
              "text": "先不打扰你了。",
              "dialogues": [
                {
                  "role": "珊瑚宫心海",
                  "text": "既然来了海祇岛，就多坐一会儿再走吧。"
                },
                {
                  "role": "珊瑚宫心海",
                  "text": "希望这片风景能一直留在你的心中。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "彩蛋（提纳里）"
        },
        {
          "type": "subtitle",
          "text": "提纳里在香醉坡右侧传送锚点旁边",
          "narration": true
        },
        {
          "role": "提纳里",
          "text": "这么巧？赛诺先前和我讲了你们的经历。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「冷笑话」…",
              "dialogues": [
                {
                  "role": "提纳里",
                  "text": "停！赛诺已经满脸得意地和我一一细数了他想出的冷笑话。我不想听第二遍了。"
                },
                {
                  "role": "提纳里",
                  "text": "这个话题到此为止吧。"
                }
              ]
            },
            {
              "text": "关于「七圣召唤」…",
              "dialogues": [
                {
                  "role": "提纳里",
                  "text": "最近道成林的事务不多，就带着柯莱一起去玩了玩。"
                },
                {
                  "role": "提纳里",
                  "text": "柯莱她还挺厉害的，在大奖赛上也拿到了不错的名次。"
                },
                {
                  "role": "提纳里",
                  "text": "我虽然通过了预选，但签运不好，没打几场就碰到了赛诺。"
                },
                {
                  "role": "提纳里",
