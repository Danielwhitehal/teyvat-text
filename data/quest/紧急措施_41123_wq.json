{
  "quest_id": 41123,
  "chapter_num": null,
  "chapter_title": "紧急措施",
  "type": "wq",
  "route": "Contingencies",
  "stories": [
    {
      "story_id": 41123,
      "title": "紧急措施",
      "description": "为了处理和陨石相关的诸多事宜，霍夫曼先生正忙得不可开交…",
      "dialogues": [
        {
          "role": "霍夫曼",
          "text": "您好，旅行者。这段时间请尽量待在城里，不要外出。"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "霍夫曼",
          "text": "外面那些砸落的陨石，您应该也看见了。"
        },
        {
          "role": "霍夫曼",
          "text": "不知道为什么，这段时间陨石降落的势头似乎更猛了，野外也更加危险了。"
        },
        {
          "role": "霍夫曼",
          "text": "城内的事务越来越多，骑士团也要忙不过来了。偏偏最近城边还发现了不少盗宝团的踪迹…"
        },
        {
          "role": "霍夫曼",
          "text": "这群为了钱什么都肯干的家伙，只怕是想要趁火打劫一番…"
        },
        {
          "role": "霍夫曼",
          "text": "如果你愿意的话，能帮忙去城边赶走那些盗宝团吗？"
        },
        {
          "role": "霍夫曼",
          "text": "本来这应该是骑士团的职责，但我们实在抽不出人手来处理这件事，只能拜托你了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我知道了。",
            "盗宝团不怕陨石吗？"
          ]
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "霍夫曼",
          "text": "那就拜托你了，在这种情况下还让你帮忙，实在是不好意思。"
        },
        {
          "role": "霍夫曼",
          "text": "您好，荣誉骑士。这段时间请尽量待在城里，不要外出。"
        },
        {
          "role": "霍夫曼",
          "text": "外面那些砸落的陨石，您应该也看见了。"
        },
        {
          "role": "霍夫曼",
          "text": "不知道为什么，这段时间陨石降落的势头似乎更猛了，野外也更加危险了。"
        },
        {
          "role": "霍夫曼",
          "text": "城内的事务越来越多，骑士团也要忙不过来了。偏偏最近城边还发现了不少盗宝团的踪迹…"
        },
        {
          "role": "霍夫曼",
          "text": "这群为了钱什么都肯干的家伙，只怕是想要趁火打劫一番…"
        },
        {
          "role": "霍夫曼",
          "text": "如果你愿意的话，能帮忙去城边赶走那些盗宝团吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "交给我吧。",
            "盗宝团不怕陨石吗？"
          ]
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "霍夫曼",
          "text": "嗯，不愧是荣誉骑士。那就拜托你了。"
        },
        {
          "role": "霍夫曼",
          "text": "你把那些盗宝团都赶走了吗？"
        },
        {
          "role": "旅行者",
          "text": "都赶走了。"
        },
        {
          "role": "霍夫曼",
          "text": "太好了，实在是帮大忙了。"
        },
        {
          "role": "霍夫曼",
          "text": "那群盗宝团吃了这个教训，应该不敢来趁火打劫了。"
        },
        {
          "role": "旅行者",
          "text": "没事的话…"
        },
        {
          "role": "霍夫曼",
          "text": "呃，请留步…还有一件事，想要再请你帮帮忙。"
        },
        {
          "role": "霍夫曼",
          "text": "其实在陨石落下之后，骑士团就收到很多有关魔物异常的报告。"
        },
        {
          "role": "霍夫曼",
          "text": "这些报告里面提到，魔物似乎也受到了陨石的影响，变得格外暴躁。"
        },
        {
          "role": "霍夫曼",
          "text": "蒙德城的防卫还算全面，不需要担心，但是有一颗陨石正好落在了清泉镇旁边…"
        },
        {
          "role": "霍夫曼",
          "text": "清泉镇里虽然有不少猎人，我们也派了骑士过去协助，但那里的地形实在难以做到完全防守好。"
        },
        {
          "role": "霍夫曼",
          "text": "假如漏了魔物进镇子，那就糟糕了…"
        },
        {
          "role": "霍夫曼",
          "text": "能请你去清泉镇周围调查一下魔物的情况吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我知道了。",
            "清泉镇的情况怎么样？"
          ]
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "霍夫曼",
          "text": "那就拜托你了，我也会尽量快点再安排些骑士过去支援。"
        },
        {
          "role": "胆小的莫罗",
          "text": "呜哇！别，别过…"
        },
        {
          "role": "胆小的莫罗",
          "text": "咦？不是魔物…你，你是谁？"
        },
        {
          "role": "旅行者",
          "text": "关于魔物的情况…"
        },
        {
          "role": "胆小的莫罗",
          "text": "魔物的情况…那还用问吗？我就是刚从魔物堆旁边跑过来的！"
        },
        {
          "role": "胆小的莫罗",
          "text": "就在旁边，一群魔物已经在那扎堆了，一副要进攻镇子的样子。"
        },
        {
          "role": "胆小的莫罗",
          "text": "要不是我跑得快，说不定你就看不到我了…"
        },
        {
          "role": "旅行者",
          "text": "那群魔物在哪？"
        },
        {
          "role": "胆小的莫罗",
          "text": "就在镇子旁边，很近，走几步就能看见了。"
        },
        {
          "role": "胆小的莫罗",
          "text": "你也快点去避难吧，我在这再歇一会…再歇一会就回去把情况告诉镇子里的人。"
        },
        {
          "role": "胆小的莫罗",
          "text": "咦？怎么又是你，你去做什么了？"
        },
        {
          "role": "旅行者",
          "text": "我把魔物都打倒了。"
        },
        {
          "role": "胆小的莫罗",
          "text": "打倒了…真的假的，就你一个人？"
        },
        {
          "role": "旅行者",
          "text": "你可以自己去看看。"
        },
        {
          "role": "胆小的莫罗",
          "text": "呃…我可不敢自己去看，要是被魔物发现了可就完蛋了…"
        },
        {
          "role": "胆小的莫罗",
          "text": "算了，不管你说的是真是假，我都得回去报告一声。"
        },
        {
          "role": "胆小的莫罗",
          "text": "要是你真把那些魔物都打倒了，镇子里的那些西风骑士总会有办法验证的。"
        },
        {
          "role": "霍夫曼",
          "text": "情况怎么样？"
        },
        {
          "role": "旅行者",
          "text": "清泉镇已经安全了。"
        },
        {
          "role": "霍夫曼",
          "text": "那就太好了…我还在发愁抽调不出人手来呢。"
        },
        {
          "role": "霍夫曼",
          "text": "十分感谢你，实在帮大忙了，这些谢礼请收下吧。"
        },
        {
          "role": "霍夫曼",
          "text": "唉，又是陨石，又是魔物…千万别再出什么乱子了。"
        }
      ]
    }
  ]
}