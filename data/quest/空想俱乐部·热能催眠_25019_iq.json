  "type": "iq",
  "route": "Daydream Club: Thermal Hypnosis",
  "stories": [
    {
      "story_id": 25019,
      "title": "空想俱乐部·热能催眠",
      "description": "在纳塔，你遇见了一个奇怪的枫丹人…",
      "dialogues": [
        {
          "role": "格里斯潘",
          "text": "这是…烬芯花啊。不错，不错，一定能派上大用场。"
        },
        {
          "role": "格罗贝尔",
          "text": "喵喵？喵？"
        },
        {
          "role": "格里斯潘",
          "text": "会长，这朵花恐怕没法在枫丹养活啊。"
        },
        {
          "role": "格里斯潘",
          "text": "如果您坚持的话…唔，做成书签怎么样？"
        },
        {
          "role": "格罗贝尔",
          "text": "喵，喵喵喵，喵喵喵，喵。"
        },
        {
          "role": "格里斯潘",
          "text": "没问题，会长，我会简短介绍的…您就原谅我这张嘴吧，它总是停不下来，我也没有另一张嘴训斥它啊。"
        },
        {
          "role": "格里斯潘",
          "text": "简单来说，旅行者，我想要请您去搜集带有「燃素」的东西。"
        },
        {
          "role": "格里斯潘",
          "text": "让我想想…呃，我一直在用「烛伞蘑菇」来提取燃素，就请您帮我找些「烛伞蘑菇」来吧。"
        },
        {
          "role": "格里斯潘",
          "text": "不过，我听说「烬芯花」里也有不少燃素…如果您能把它拿来给我的话，也不错！"
        },
        {
          "role": "格里斯潘",
          "text": "只要提取到足够的燃素，我就可以在此开始研究了。"
        },
        {
          "role": "格里斯潘",
          "text": "太好了！那就拜托您了，我会在这里继续完善提取燃素的计划，还有许多仪器需要重新设计。"
        },
        {
          "role": "格里斯潘",
          "text": "但是，这一切都是值得的！只要能够提取出我想要的东西，我就能回镇子，舒舒服服地继续研究了。"
        },
        {
          "role": "格里斯潘",
          "text": "万分感谢，等我的研究成功后，我愿意请您第一个来体验「热能催眠术」。"
        },
        {
          "role": "格罗贝尔",
          "text": "喵！喵喵，喵！"
        },
        {
          "role": "格里斯潘",
          "text": "会长，您怎么能这么说？我的「热能催眠术」绝对安全！没有任何副作用！"
        },
        {
          "role": "格里斯潘",
          "text": "为了良好的睡眠和灼热的燃素，旅行者先生，万事拜托了。"
        },
        {
          "role": "旅行者",
          "text": "咱们一起去吧。"
        },
        {
          "role": "格里斯潘",
          "text": "一起？那就更好了！我早就想要实地考察了，有您在旁边，我就没什么好怕的了。"
        },
        {
          "role": "格里斯潘",
          "text": "来吧，咱们这就出发。亲爱的旅行者先生！"
        },
        {
          "role": "格里斯潘",
          "text": "至于会长您…就留在这里吧。请您放心，有亲爱的旅行者先生在，我的人身安全绝对有保障！"
        },
        {
          "role": "格罗贝尔",
          "text": "喵…喵喵…喵…"
        },
        {
          "role": "格里斯潘",
          "text": "呃…差点忘了，我把考察地点先给您标在地图上，那边的烛伞蘑菇可好了！"
        },
        {
          "role": "旅行者",
          "text": "咱们一起去吧。"
        },
        {
          "role": "格里斯潘",
          "text": "没问题，上次的实地考察虽然出了点岔子，但我依然受益良多。"
        },
        {
          "role": "格罗贝尔",
          "text": "喵喵…"
        },
        {
          "role": "格里斯潘",
          "text": "呃…那会长您就留在这里吧。请您放心，有亲爱的旅行者先生在，我的人身安全绝对有保障！"
        },
        {
          "role": "格罗贝尔",
          "text": "喵…喵喵…喵…"
        },
        {
          "type": "subtitle",
          "text": "与格里斯潘对话"
        },
        {
          "role": "格里斯潘",
          "text": "嗬！您可是鼎鼎大名啊，实在幸会！"
        },
        {
          "role": "格罗贝尔",
          "text": "喵，喵喵。"
        },
        {
          "role": "格里斯潘",
          "text": "会长也向您问好。要是咱们在佩特莉可镇，我必然会请您喝一杯好茶。"
        },
        {
          "role": "格里斯潘",
          "text": "但现在…哈哈哈，我既找不到茶，也谈不上好了。"
        },
        {
          "role": "派蒙",
          "text": "唔？你们遇见什么事情了吗？看你满头大汗的…"
        },
        {
          "role": "旅行者",
          "text": "纳塔很热，可以理解。"
        },
        {
          "role": "格里斯潘",
          "text": "哈！让人愉快的先生。从我到纳塔开始，您是唯一一个和我对上幽默感的人。"
        },
        {
          "role": "格里斯潘",
          "text": "但纳塔的热度也比不上我内心的焦急。唉，怎么事情全都凑到一块了…"
        },
        {
          "role": "格里斯潘",
          "text": "不仅没有搜集到足够多的燃素，就连镇子也失去了消息。"
        },
        {
          "role": "格里斯潘",
          "text": "亲爱的旅行者，我知道初次见面就委人任务，实在不算礼貌。"
        },
        {
          "role": "格里斯潘",
          "text": "但我真的很需要一个靠谱的人…您无疑是最佳人选了。"
        },
        {
          "type": "subtitle",
          "text": "与格里斯潘对话"
        },
        {
          "type": "subtitle",
          "text": "将烛伞蘑菇或烬芯花交给格里斯潘"
        },
        {
          "role": "格罗贝尔",
          "text": "喵…喵喵…喵…"
        },
        {
          "type": "subtitle",
          "text": "将烛伞蘑菇或烬芯花交给格里斯潘"
        },
        {
          "role": "格里斯潘",
          "text": "亲爱的旅行者先生，咱们又见面了。"
        },
        {
          "role": "格里斯潘",
          "text": "上次可多亏了您帮忙，我的研究又前进了一大步。"
        },
        {
          "role": "格里斯潘",
          "text": "按照这种势头，我很快就能达到预定目标了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的预定目标是什么？",
              "dialogues": [
                {
                  "role": "格里斯潘",
                  "text": "我没向您介绍？天哪，瞧瞧我这个脑袋，让我简单为您…"
                },
                {
                  "role": "格罗贝尔",
                  "text": "喵！喵喵喵喵。喵喵！"
                },
                {
                  "role": "格里斯潘",
                  "text": "咳，您说得对，会长。我会以最简短的方式叙述的。"
                },
                {
                  "role": "格里斯潘",
                  "text": "简单来说，我之所以想要搜集燃素。是想要用「热能」来进行「催眠」。"
                },
                {
                  "role": "格里斯潘",
                  "text": "我的催眠装置不在身边…但请您想象一个半人高，能容人坐在里面的箱子。"
                },
                {
                  "role": "格里斯潘",
                  "text": "这个箱子里有一个蒸汽装置，可以不断产生热气，将箱内的温度始终保持在一个特定数值上。"
                },
                {
                  "role": "格里斯潘",
                  "text": "被催眠者坐在里面，露出脑袋，身体则在箱子里被加热…我相信，这种方式能让催眠术更快起效，催眠效果也更好！"
                },
                {
                  "role": "旅行者",
                  "text": "你这纯粹是想把人热晕了！"
                },
                {
                  "role": "格里斯潘",
                  "text": "您说得倒也有几分道理。但咱们对于「晕」的定义可能不太一样…"
                },
                {
                  "role": "格里斯潘",
                  "text": "但现在，咱们还是先放下这些细枝末节吧，我依然想要请您帮忙。"
                }
              ]
            },
            {
              "text": "你又想让我干什么？",
              "dialogues": [
                {
                  "role": "格里斯潘",
                  "text": "敏锐的先生！我就知道您是一个容易合作的好人。"
                }
              ]
            }
          ]
        },
        {
          "role": "格里斯潘",
          "text": "还是和之前一样，我想要请您去搜集带有「燃素」的东西。"
        },
        {
          "role": "格里斯潘",
          "text": "我想想…唔，还是请您拿些「烬芯花」来吧，这种植物里，确实含有不少燃素。"
        },
        {
          "role": "格里斯潘",
          "text": "当然，「烛伞蘑菇」也依然是我的重要实验材料。您看…"
        },
        {
          "type": "subtitle",
          "text": "与格里斯潘对话"
        },
        {
          "role": "格里斯潘",
          "text": "喔！这是烛伞蘑菇啊！好，太好了！"
        },
        {
          "role": "格罗贝尔",
          "text": "喵，喵…喵喵？"
        },
        {
          "role": "格里斯潘",
          "text": "放心吧会长，我不会吃这些东西的。呃…至少在处理好之前，我是不会吃的。"
        },
        {
          "role": "格里斯潘",
          "text": "材料已经足够我再一次开展实验了，再次感谢您，旅行者先生。"
        },
        {
          "role": "格里斯潘",
          "text": "这些是报酬，请您收下吧。"
        },
        {
          "role": "格罗贝尔",
          "text": "喵，喵喵，喵。"
        },
        {
          "role": "格里斯潘",
          "text": "会长也在对您表达感谢。等研究成功后，我愿意把您的名字刻在第一台「热能催眠台」上。"
        },
        {
          "role": "格里斯潘",
          "text": "好啦！接下来就是实操环节了，在哪里实操比较好呢…"
        },
        {
          "type": "subtitle",
          "text": "与格里斯潘对话"
        },
        {
          "role": "旅行者",
          "text": "这位是派蒙。"
        },
        {
          "type": "subtitle",
          "text": "和格里斯潘会合"
        },
        {
          "role": "格里斯潘",
          "text": "这地方确实足够火热了…会长，您感觉还好吗？"
        },
        {
          "role": "格罗贝尔",
          "text": "喵。"
        },
        {
          "role": "格里斯潘",
          "text": "抱歉，会长，埃斯特和梅康顿兄弟还没回信。"
        },
        {
          "role": "格里斯潘",
          "text": "见鬼…镇子到底出了什么事…现在也没办法马上赶回去…"
        },
        {
          "role": "旅行者",
          "text": "你看着不像纳塔人。"
        },
        {
          "role": "格里斯潘",
          "text": "您看着倒也像是个外乡人呐。向您问好，我是格里斯潘，枫丹空想俱乐部的会员。"
        },
        {
          "role": "格里斯潘",
          "text": "这位则是咱们俱乐部的会长…部长？呃，总之是领头的，格罗贝尔女士。"
        },
        {
          "role": "格里斯潘",
          "text": "哈！瞧瞧这株「颗粒果」，它的长势真不错，也许，它也是受到了燃素的影响？我得把它采下来，做成样本。"
        },
        {
          "role": "格里斯潘",
          "text": "旅行者先生，您来了，快来帮我一把，把它的根茎给…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小心后面！",
              "dialogues": []
            },
            {
              "text": "放手！过来！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "格里斯潘",
          "text": "啊？！救命啊！"
        },
        {
          "type": "subtitle",
          "text": "和格里斯潘会合"
        },
        {
          "role": "旅行者",
          "text": "你是空想俱乐部的人？"
        },
        {
          "role": "派蒙",
          "text": "咦？等一下，我们之前就听埃斯特先生他们提起过格里斯潘这个名字…"
        },
        {
          "role": "格里斯潘",
          "text": "您去过俱乐部？露景泉在上，我总算撞上了好运！"
        },
        {
          "role": "格里斯潘",
          "text": "您知道俱乐部出了什么事吗？我已经连着寄去了好几封信，但就是没人回我！"
        },
        {
          "role": "旅行者",
          "text": "关于佩特莉可镇的事…"
        },
        {
          "role": "？？？",
          "text": "向格里斯潘讲述佩特莉可镇所发生的事…"
        },
        {
          "role": "格里斯潘",
          "text": "喔，噢，嗬…真是让人，震惊。"
        },
        {
          "role": "格罗贝尔",
          "text": "喵…喵喵。喵。"
        },
        {
          "role": "格里斯潘",
          "text": "没错，会长。我真的被震惊了。"
        },
        {
          "role": "格里斯潘",
          "text": "我真不敢相信，我居然错过了这么一场超级大催眠。天哪！看在露景泉的份上！"
        },
        {
          "role": "格里斯潘",
          "text": "我要是在镇子上，肯定能搜集到一大堆可用的实验记录！"
        },
        {
          "role": "格里斯潘",
          "text": "会长，看来咱们得尽快结束研究，回去俱乐部看看情况。"
        },
        {
          "role": "格里斯潘",
          "text": "咳，抱歉，旅行者。我知道初次见面就委人任务，实在不算礼貌。"
        },
        {
          "role": "格里斯潘",
          "text": "但我真的很需要一个靠谱的人…您无疑是最佳人选了。"
        },
        {
          "type": "subtitle",
          "text": "打倒「秘源机兵」"
        },
        {
          "role": "旅行者",
          "text": "我是旅行者。"
        },
        {
          "type": "subtitle",
          "text": "与格里斯潘对话"
        },
        {
          "role": "格里斯潘",
          "text": "多谢您搭救，旅行者先生。"
        },
        {
          "role": "格里斯潘",
          "text": "您瞧瞧，这可真是一场惊心动魄的冒险啊。还好我说服会长，让它留在了部族里。"
        },
        {
          "role": "格里斯潘",
          "text": "会长最不喜欢的就是这种不可控的突发事件，我可不想被它教训半天。"
        },
        {
          "role": "格里斯潘",
          "text": "不过，从结果上来说，我还是采到了足够的材料，一切皆大欢喜。"
        },
        {
          "role": "格里斯潘",
          "text": "这些东西给你，旅行者先生，再次感谢您的帮助。"
        },
        {
          "role": "格里斯潘",
          "text": "等研究成功后，我愿意请您第一个来体验「热能催眠术」。"
        }
      ]
    }
  ]
