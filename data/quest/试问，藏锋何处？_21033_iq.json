{
  "quest_id": 21033,
  "chapter_num": null,
  "chapter_title": "试问，藏锋何处？",
  "type": "iq",
  "route": "Where Is the Unseen Razor?",
  "stories": [
    {
      "story_id": 21033,
      "title": "试问，藏锋何处？",
      "description": "岚姐正在寻找一把剑，但却始终没有收获，她决定扩大搜索范围…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与岚姐对话"
        },
        {
          "role": "岚姐",
          "text": "不知道…这个思路能不能管用…"
        },
        {
          "role": "旅行者",
          "text": "你还在找那把剑吗？"
        },
        {
          "role": "岚姐",
          "text": "旅行者？是你啊…是的，我还在找那把「藏锋」呢。"
        },
        {
          "role": "岚姐",
          "text": "但到现在，我也没有找到什么有价值的线索。"
        },
        {
          "role": "岚姐",
          "text": "不过这也是没办法的事，毕竟在整个璃月寻找一把剑…实在是太难了。"
        },
        {
          "role": "岚姐",
          "text": "有人和我说，那把剑也许早就被魔物毁了…但即使它碎了，我也要把所有碎片都找到。"
        },
        {
          "role": "岚姐",
          "text": "抱歉，自顾自地说了这么多。这次的委托地点我已经标在你的地图上了，拜托你了，旅行者。"
        },
        {
          "role": "岚姐",
          "text": "希望…那把剑不要真的碎了…"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "role": "岚姐",
          "text": "希望…那把剑不要真的碎了…"
        },
        {
          "type": "subtitle",
          "text": "在营地搜寻一番"
        },
        {
          "type": "subtitle",
          "text": "与岚姐对话"
        },
        {
          "type": "subtitle",
          "text": "与岚姐对话"
        },
        {
          "role": "岚姐",
          "text": "这剑柄…倒是还算完整。"
        },
        {
          "role": "旅行者",
          "text": "它和「藏锋」有关吗？"
        },
        {
          "role": "岚姐",
          "text": "我还要仔细分辨后才知道…喔，忘了告诉你，我前段时间就开始四处搜集武器的碎片了。"
        },
        {
          "role": "岚姐",
          "text": "我从市场上，野外，还有冒险家的手里得到了不少碎片，想着也许能从这方面找到「藏锋」的线索…"
        },
        {
          "role": "岚姐",
          "text": "但直到现在，我也没能找到它的任何踪迹…"
        },
        {
          "role": "岚姐",
          "text": "没关系，我们璃月有句话叫「有志者，事竟成」，我还是会一直找下去…直到找到「藏锋」。"
        },
        {
          "role": "岚姐",
          "text": "啊，这些报酬给你，辛苦你了，旅行者。"
        },
        {
          "role": "岚姐",
          "text": "怎么样，旅行者？这次你找到什么东西了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了这个剑柄…"
        }
      ]
    }
  ]
}