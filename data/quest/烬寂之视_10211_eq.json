{
  "quest_id": 10211,
  "chapter_num": "暝视寻灵织卷·中",
  "chapter_title": "烬寂之视",
  "type": "eq",
  "route": "Vision of Ashen Desolation",
  "stories": [
    {
      "story_id": 40172,
      "title": "烬寂之视",
      "description": "为了帮助勒拉寻回他的灵性，茜特菈莉计划去族内打探更多消息，不知道她的成果如何了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至第二天（7点-11点）"
        },
        {
          "type": "subtitle",
          "text": "前往勒拉的山洞"
        },
        {
          "role": "茜特菈莉",
          "text": "嗨！各位。"
        },
        {
          "role": "欧洛伦",
          "text": "奶奶，你来了。"
        },
        {
          "role": "茜特菈莉",
          "text": "你这里没有好消息吧？"
        },
        {
          "role": "欧洛伦",
          "text": "一眼就被奶奶看出来了啊。旅行者收集了很多游灵，我一一分辨了，都没有勒拉的特征。"
        },
        {
          "role": "茜特菈莉",
          "text": "看你的样子就知道了。没关系，大海捞针本来就是很难的。"
        },
        {
          "role": "欧洛伦",
          "text": "虽然勒拉的情况还比较稳定，可这样下去也不是办法。"
        },
        {
          "role": "茜特菈莉",
          "text": "我倒是有些进展，勒拉的父母告诉我，勒拉前阵子认识了一个朋友，经常一出门就好几天不回来。"
        },
        {
          "role": "茜特菈莉",
          "text": "他们有次悄悄跟了过去，发现勒拉和那个朋友在一个营地里鼓捣什么。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他们见到了那个人？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "茜特菈莉",
          "text": "嗯，是个男人，名叫谷中，穿着似乎是稻妻的款式。"
        },
        {
          "role": "勒拉",
          "text": "谷中先生，用这个就可以了吗？"
        },
        {
          "role": "谷中",
          "text": "据我从古籍里学习的知识，大多数过敏的症状会使用相应的脱敏疗法，我想反过来也一样。"
        },
        {
          "role": "谷中",
          "text": "您是对灵性完全脱敏的可怜人，只能完全将自己浸泡在充满灵性的物质中。这样的方法，我称为过敏疗法…"
        },
        {
          "role": "勒拉",
          "text": "…会有问题吗？"
        },
        {
          "role": "谷中",
          "text": "您才是灵性白痴，强行施法会怎么样，您应该比我更清楚。如何决定，还是看您自己了。"
        },
        {
          "role": "勒拉",
          "text": "好吧…但我还有一个问题，谷中先生为什么要帮助我？"
        },
        {
          "role": "勒拉",
          "text": "毕竟像我这样的家伙，在族里根本说不上什么话，没有什么能回报的。"
        },
        {
          "role": "谷中",
          "text": "回报？请您好好看看我的脸吧，看看上面写了什么？"
        },
        {
          "role": "勒拉",
          "text": "呃，写了什么？"
        },
        {
          "role": "谷中",
          "text": "「乐于助人」。"
        },
        {
          "role": "派蒙",
          "text": "呜哇！没想到是个稻妻人，居然还是为了给勒拉治病？"
        },
        {
          "role": "欧洛伦",
          "text": "过敏疗法，真是天马行空的点子啊，真的有用吗？"
        },
        {
          "role": "派蒙",
          "text": "看勒拉现在的样子，结果应该是失败了。"
        },
        {
          "role": "茜特菈莉",
          "text": "哼，很久以前，族内是有过这种办法，但成功率很低，又太过冒险，渐渐就被禁止了。"
        },
        {
          "role": "茜特菈莉",
          "text": "至于这个谷中的目的，我看也没那么简单，在勒拉出事后，他就消失了。"
        },
        {
          "role": "茜特菈莉",
          "text": "我按照勒拉父母给的地址去了营地，那有明显的灵性残留，另外，我还发现了这个。"
        },
        {
          "role": "欧洛伦",
          "text": "这是…？"
        },
        {
          "role": "茜特菈莉",
          "text": "某种碎片…似乎是武器或者仪具上的。"
        },
        {
          "role": "茜特菈莉",
          "text": "你也感觉到了吧，虽然看起来上了年份，但上面还是有很强大的灵性残留。"
        },
        {
          "role": "茜特菈莉",
          "text": "勒拉应该就是用这个东西做的媒介，这能解释他这个灵性白痴是怎么开始的暝视。"
        },
        {
          "role": "欧洛伦",
          "text": "等等，我还有一种熟悉的感觉，它似乎与我的古名有关系…"
        },
        {
          "role": "派蒙",
          "text": "欧洛伦的古名？难道这是古名碎片吗？"
        },
        {
          "role": "欧洛伦",
          "text": "不…我觉得它可能是古名的前主人留下的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道是桑哈杰的遗物？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "茜特菈莉",
          "text": "奶奶我开始手痒了，这次的暝视就用这个来做媒介。"
        },
        {
          "role": "派蒙",
          "text": "那还是和上次一样吧？让旅行者用灵性织机把茜特菈莉看到的画面织下来。"
        },
        {
          "role": "茜特菈莉",
          "text": "不，这次让欧洛伦来。"
        },
        {
          "role": "欧洛伦",
          "text": "为什么？"
        },
        {
          "role": "茜特菈莉",
          "text": "这是安全措施。"
        },
        {
          "role": "茜特菈莉",
          "text": "你对灵性领域的认知比旅行者强，如果这是桑哈杰的遗物，万一出现意外状况，你能更好地应对。"
        },
        {
          "role": "欧洛伦",
          "text": "噢…看见了吧，派蒙，我说奶奶很关注旅行者吧，一点都不肯让他冒险。"
        },
        {
          "role": "欧洛伦",
          "text": "我这样的孙子就无所谓了。"
        },
        {
          "role": "茜特菈莉",
          "text": "喂！你在说什么啊！"
        },
        {
          "role": "欧洛伦",
          "text": "不好意思，奶奶，我准备好了。"
        },
        {
          "role": "茜特菈莉",
          "text": "那我们就开始吧。"
        },
        {
          "type": "subtitle",
          "text": "按照计划，茜特菈莉以神秘碎片为媒介，开始了第二次暝视。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "一旁，欧洛伦用灵性织机将她看到的画面誊录在织物上。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "很快，一幅画面出现了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "[[file",
          "text": "活动任务-烬寂之视-CG1.png|center|1100px]]"
        },
        {
          "role": "派蒙",
          "text": "出来了！这次的织物…好像是一张碎掉的弓，在火焰里燃烧着…"
        },
        {
          "role": "欧洛伦",
          "text": "你们看，其中一块是不是和这个碎片有点像啊？"
        },
        {
          "role": "派蒙",
          "text": "真的！好像是弓身的位置…"
        },
        {
          "role": "欧洛伦",
          "text": "我在奶奶家里的织卷上看到过跟这把弓很像的东西…"
        },
        {
          "role": "茜特菈莉",
          "text": "…没错，它是桑哈杰征战烬寂海时使用的武器。看来这块碎片，是货真价实的桑哈杰遗物。"
        },
        {
          "role": "欧洛伦",
          "text": "不愧是桑哈杰前辈，虽然遗物的灵性波动很强，但刚才并没有什么危险，如果是旅行者来的话，应该也没问题。"
        },
        {
          "role": "派蒙",
          "text": "果然这就是英雄！留下来的东西都可以拿给后人治疗。"
        },
        {
          "role": "茜特菈莉",
          "text": "仅仅是治疗吗？我总觉得，那个谷中还别有目的。"
        },
        {
          "role": "派蒙",
          "text": "让我想想，刚刚我们看见了完整的弓的样子…难道是…他想找到其他碎片的下落？"
        },
        {
          "role": "欧洛伦",
          "text": "虽说是桑哈杰前辈的东西，但既然都已经碎掉了，就算找齐了也派不上什么用场了吧。"
        },
        {
          "role": "茜特菈莉",
          "text": "而且为什么要找一个灵性白痴来做这件事？这只会什么也得不到。"
        },
        {
          "role": "勒拉",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "欸？勒拉的身体好像有反应了！"
        },
        {
          "role": "茜特菈莉",
          "text": "让我看看。我感觉到有灵性在向碎片附着…"
        },
        {
          "role": "欧洛伦",
          "text": "那就是说，奶奶的方向是正确的。勒拉的游离灵性正在被吸引过来。"
        },
        {
          "role": "茜特菈莉",
          "text": "既然如此，我要再试一次，用勒拉的身体与这块碎片一起当作媒介。"
        },
        {
          "role": "欧洛伦",
          "text": "加油，奶奶。我也会加油的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这次让我来操纵灵性织机吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "茜特菈莉",
          "text": "你也手痒了吗？"
        },
        {
          "role": "派蒙",
          "text": "一人一次，这样比较公平嘛。"
        },
        {
          "role": "欧洛伦",
          "text": "安全性我也确认过了，应该不会有危险。"
        },
        {
          "role": "茜特菈莉",
          "text": "嗯…"
        },
        {
          "role": "茜特菈莉",
          "text": "好，既然旅行者有这个想法，就这么来吧。准备好了就告诉我一声。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（欧洛伦）"
        },
        {
          "role": "欧洛伦",
          "text": "放心，我确认过了，这次应该不会有危险。"
        },
        {
          "type": "subtitle",
          "text": "使用灵性织机编织织物"
        },
        {
          "role": "茜特菈莉",
          "text": "准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "开始吧。",
              "dialogues": [
                {
                  "role": "茜特菈莉",
                  "text": "嗯，来吧。"
                }
              ]
            },
            {
              "text": "再等一下。",
              "dialogues": [
                {
                  "role": "茜特菈莉",
                  "text": "嗯。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "还原'''暝视片段·未知之地'''",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与茜特菈莉交谈"
        },
        {
          "role": "[[file",
          "text": "活动任务-烬寂之视-CG2.png|center|1100px]]"
        },
        {
          "role": "派蒙",
          "text": "新的织物出现了！这是…一张地图！"
        },
        {
          "role": "欧洛伦",
          "text": "地图？是哪里啊？"
        },
        {
          "role": "茜特菈莉",
          "text": "难道是烬寂海的位置…"
        },
        {
          "role": "派蒙",
          "text": "烬寂海？！"
        },
        {
          "role": "茜特菈莉",
          "text": "据我所知，烬寂海在当年那场大战后就成了一片不毛之地。或者说，就是因为那场大战，烬寂海才成为烬寂海。"
        },
        {
          "role": "茜特菈莉",
          "text": "魔兽与战士们化为的灰烬铺满了战场。有时深处会传出可怖的嚎叫，有时又会燃起滔天的火焰，将嚎叫淹没。"
        },
        {
          "role": "茜特菈莉",
          "text": "那里隐藏着未知的危险与秘密，在几百年来，都是顶尖冒险家们证明自己的地方，可惜他们基本都埋骨其中了。"
        },
        {
          "role": "茜特菈莉",
          "text": "直到大约二三十年前，烬寂海出现了异动，有人说看见了黑色山岳般的巨物在其中移动。"
        },
        {
          "role": "茜特菈莉",
          "text": "但没多久，整片区域一下就消失了，谁也不清楚发生了什么，这个传说中的不祥之地就这样不见了。"
        },
        {
          "role": "派蒙",
          "text": "整片区域消失了？！"
        },
        {
          "role": "茜特菈莉",
          "text": "嗯，如果我没记错的话，烬寂海消失的地方，就是这份地图指向的地方。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那这是在哪里？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "茜特菈莉",
          "text": "在纳塔最西边，是远离各部族的地界，之前并非普通人的聚集地。直到烬寂海消失后，才开始有人烟了。"
        },
        {
          "role": "茜特菈莉",
          "text": "不过说到底，奶奶我也没有去过那边啦，以上全是听来的。"
        },
        {
          "role": "茜特菈莉",
          "text": "人就是这样的，年纪越大，冒险精神越少。"
        },
        {
          "role": "欧洛伦",
          "text": "其实奶奶就是懒得出远门而已。"
        },
        {
          "role": "茜特菈莉",
          "text": "等一下，有灵性在向碎片和织物聚集！"
        },
        {
          "role": "勒拉",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "哦！勒拉的身体又有动静了！"
        },
        {
          "role": "茜特菈莉",
          "text": "这次的反应很强烈，难道他的目的是烬寂海的位置吗？"
        },
        {
          "role": "欧洛伦",
          "text": "我也有感觉，附近有一个接近完整的灵魂。"
        },
        {
          "role": "派蒙",
          "text": "噫，听起来有点毛毛的。"
        },
        {
          "role": "茜特菈莉",
          "text": "看来办法生效了。"
        },
        {
          "role": "派蒙",
          "text": "那是不是可以唤醒勒拉了呀？"
        },
        {
          "role": "茜特菈莉",
          "text": "今天还不行，将灵性引导回身体可不像把一瓶水倒进另一瓶那么简单。"
        },
        {
          "role": "茜特菈莉",
          "text": "我要去请一柄仪式用剑，再加上一些其他准备，大概需要两天的时间。"
        },
        {
          "role": "茜特菈莉",
          "text": "放心，既然灵性已经返回，就只剩最后一步了。我们两天后再见吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（欧洛伦）"
        },
        {
          "role": "欧洛伦",
          "text": "还是有点想不通，那个谷中假如别有目的，怎么又把桑哈杰前辈的遗物留在现场了呢？"
        },
        {
          "role": "欧洛伦",
          "text": "难道说，那个也是诱饵？"
        }
      ],
      "collapse_ranges": [
        [
          74,
          75
        ],
        [
          109,
          111
        ]
      ]
    }
  ]
}