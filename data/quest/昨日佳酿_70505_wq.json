{
  "quest_id": 70505,
  "chapter_num": null,
  "chapter_title": "昨日佳酿",
  "type": "wq",
  "route": "Fine Wine From Yesterday",
  "stories": [
    {
      "story_id": 70505,
      "title": "昨日佳酿",
      "description": "「刚才，我看迪卢克老爷行色匆匆地走进了酒馆。」「哦？今天是老爷亲自调酒吗？那我可得去捧个场…来，扶我一把。」",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与迪卢克对话",
          "narration": true
        },
        {
          "role": "迪卢克",
          "text": "什么叫闲着没事干。我收到了你们兼任酒保的消息，过来看看而已。"
        },
        {
          "role": "派蒙",
          "text": "哇，情报太灵通了！"
        },
        {
          "role": "迪卢克",
          "text": "所以，旅行者，当酒保的体验如何？"
        },
        {
          "role": "旅行者",
          "text": "才刚开始…"
        },
        {
          "role": "派蒙",
          "text": "是啊，迪卢克老爷问得太早啦，我们开张还没多久呢。"
        },
        {
          "role": "迪卢克",
          "text": "只是想问问第一感觉。"
        },
        {
          "role": "迪卢克",
          "text": "兴奋吗？还是困扰？有什么感受，直说就好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还挺新奇的…",
              "dialogues": [
                {
                  "role": "迪卢克",
                  "text": "原来如此。"
                }
              ]
            },
            {
              "text": "有点手忙脚乱…",
              "dialogues": [
                {
                  "role": "迪卢克",
                  "text": "原来如此。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不、不问问我吗？"
        },
        {
          "role": "派蒙",
          "text": "我的第一感觉是…好喝！"
        },
        {
          "role": "迪卢克",
          "text": "……"
        },
        {
          "role": "迪卢克",
          "text": "那就好，为你高兴。"
        },
        {
          "role": "迪卢克",
          "text": "能请你帮我调一杯苍谷落日吗？杯量随意。"
        },
        {
          "role": "旅行者",
          "text": "明白了，请稍等片刻。"
        },
        {
          "role": "迪卢克",
          "text": "嗯，不用着急。"
        },
        {
          "type": "subtitle",
          "text": "为迪卢克调制饮品",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "主要还是原材料好！只要水果新鲜，就算什么也不加都会很甜。"
        },
        {
          "role": "迪卢克",
          "text": "那就感谢蒙德的土地吧。"
        },
        {
          "role": "迪卢克",
          "text": "…苍谷落日，是我第一次调出的饮品。"
        },
        {
          "role": "迪卢克",
          "text": "那时还小，父亲摆出了几种材料，让我自己动手尝试。"
        },
        {
          "role": "迪卢克",
          "text": "没有要求，也没有提示，多半是为了看我的灵性吧。"
        },
        {
          "role": "迪卢克",
          "text": "最后我做出的，就是这样一杯果汁。"
        },
        {
          "role": "派蒙",
          "text": "欸，为、为什么…"
        },
        {
          "role": "迪卢克",
          "text": "父亲也很诧异。但当时的我并未考虑其他因素，只知道果汁很甜。"
        },
        {
          "role": "迪卢克",
          "text": "现在想来，那是多么幼稚又短浅的认知啊…"
        },
        {
          "role": "旅行者",
          "text": "我不这么认为。"
        },
        {
          "role": "迪卢克",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "对他来说一定也是好饮品。",
              "dialogues": [
                {
                  "role": "迪卢克",
                  "text": "我没有那样想过…毕竟，当时父亲什么都没说。"
                }
              ]
            },
            {
              "text": "他一定也觉得很美味。",
              "dialogues": [
                {
                  "role": "迪卢克",
                  "text": "我没有那样想过…毕竟，当时父亲什么都没说。"
                }
              ]
            }
          ]
        },
        {
          "role": "迪卢克",
          "text": "不过，谢谢你。"
        },
        {
          "role": "迪卢克",
          "text": "另外，有件东西想给你。"
        },
        {
          "role": "迪卢克",
          "text": "…等你对酒保工作有更多体验之后，再交给你比较好。以你的能力，一定能出色地完成这份工作。"
        },
        {
          "role": "派蒙",
          "text": "我也会…帮忙打气！"
        },
        {
          "role": "迪卢克",
          "text": "嗯，期待你们的成果。那我就先告辞了。"
        },
        {
          "role": "派蒙",
          "text": "有空再来哦！"
        }
      ]
    }
  ]
}