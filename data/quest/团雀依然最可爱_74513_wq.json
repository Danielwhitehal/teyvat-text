{
  "quest_id": 74513,
  "chapter_num": null,
  "chapter_title": "团雀依然最可爱",
  "type": "wq",
  "route": "Finches Are Still the Cutest!",
  "stories": [
    {
      "story_id": 74513,
      "title": "团雀依然最可爱",
      "description": "在枫丹的海露港，你与派蒙撞见了一位开朗的学者兼商人，她正忙于抒发自己的情感，并邀请你们试玩某种游戏…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与拜希麦·五世对话"
        },
        {
          "role": "拜希麦·五世",
          "text": "路过的客人，生论派的学者、兼大巴扎与海露港的新星商人拜希麦五世恳求您，别急着离开…"
        },
        {
          "role": "拜希麦·五世",
          "text": "请放松身体，放空思绪，听我说一件重要的事——"
        },
        {
          "role": "拜希麦·五世",
          "text": "团雀最可爱！"
        },
        {
          "role": "派蒙",
          "text": "？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "团雀确实很可爱，但拜希麦小姐说自己是…学者兼商人？一句话没有限制范围，不是会引发很激烈的争论吗？"
        },
        {
          "role": "派蒙",
          "text": "我的印象里，学者的发言都很谨慎的，商人也不敢随便说出很夸张的话…"
        },
        {
          "role": "派蒙",
          "text": "如果你和别人说，「我的理论最正确」或者「我的商品最厉害」，那不是会被很多不服气的人盯上，用力找茬吗？"
        },
        {
          "role": "派蒙",
          "text": "奇怪，怎么感觉这段对话好像发生过，有种熟悉感…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我还要说！",
              "dialogues": []
            },
            {
              "text": "派蒙最可爱！",
              "dialogues": []
            },
            {
              "text": "什么都不管！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "噫！旅行者，为什么这么突然啦！"
        },
        {
          "role": "派蒙",
          "text": "就算不是开玩笑，也不要那么大声嘛…"
        },
        {
          "role": "拜希麦·五世",
          "text": "哈哈哈！就是这种气势！"
        },
        {
          "role": "拜希麦·五世",
          "text": "我当然知道，世上任何东西都没有绝对的第一。任何学术理论都有被推翻的可能，任何商品都会被新品超越。"
        },
        {
          "role": "拜希麦·五世",
          "text": "但不管客观的世界怎么变，每个人心里都存在一些…自己最认可的人与事物。不管别人怎么说，它们的价值都是最高的。"
        },
        {
          "role": "拜希麦·五世",
          "text": "要是害怕被人否认，对自己失去信心，那就永远不可能成为自己心里最棒的模样，更没法找到认可自己的知音！"
        },
        {
          "role": "拜希麦·五世",
          "text": "如果你们来玩过我这款桌上游戏「哐哐当当雀雀球」，也会像我这样大声告诉别人，团雀最可爱！"
        },
        {
          "role": "派蒙",
          "text": "哐哐…当当…雀雀球？就是你旁边这张桌子上的东西吗？也有点眼熟呢…"
        },
        {
          "role": "拜希麦·五世",
          "text": "没错哦，玩过这个游戏以后，你们就能深刻领会到团雀的可爱之处啦！"
        },
        {
          "role": "拜希麦·五世",
          "text": "我正在推广这种桌上游戏，如果在游戏里得到高分，还可以获得一些奖品哦！"
        },
        {
          "role": "派蒙",
          "text": "我确实觉得团雀很可爱啦，就算奖品不多也没关系，只要能玩得开心就足够了。"
        },
        {
          "role": "派蒙",
          "text": "你觉得呢，旅行者？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也想来试试看！",
              "dialogues": []
            },
            {
              "text": "团雀究竟多可爱！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "拜希麦·五世",
          "text": "嘿嘿嘿，看来我们的意见即将统一了！那就请你们尽情体验吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（拜希麦·五世）"
        },
        {
          "role": "拜希麦·五世",
          "text": "嗯哼哼~怎么样？你们玩过「哐哐当当雀雀球」了吗？团雀最可爱，我没说错吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来玩一局「雀雀球」！",
              "dialogues": [
                {
                  "role": "拜希麦·五世",
                  "text": "嘿呀，看来这可可爱爱的团雀游戏正中你的心窝了！请随意游玩，玩到你心满意足！"
                }
              ]
            },
            {
              "text": "团雀一直很可爱！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯！我也想起来了，好像以前在什么地方玩到过这种桌上游戏！"
                },
                {
                  "role": "派蒙",
                  "text": "因为玩过这个桌上游戏，我还在现实中观察过一段时间的团雀呢，然后从团雀身上发现了很多…容易被疏忽的小特点。"
                },
                {
                  "role": "派蒙",
                  "text": "拜希麦…五世小姐？说不定继续玩这个游戏，我和旅行者也能重温以前旅行时的记忆！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "以前玩过吗？那说明你们和我的家族很有缘！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "「哐哐当当雀雀球」是我们家从太外祖母那里继承下来的传统游戏，之前一直被当成招待贵客的家庭仪式。"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "除了招待贵客，太外祖母似乎只和学术对手，以及她最认可的朋友们一起游玩过雀雀球，并送过她们几份样品…"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "太外祖母说过，「要是大家都被团雀的可爱充盈了心灵，躁动不安的情绪就会减少，世界上的争吵就会少一点…」"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "为了太外祖母的和平愿景，也为了让可爱的团雀给大家带去笑容，我要继续改进这个游戏，好好推广它！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "具体要怎么做呢？",
                      "dialogues": [
                        {
                          "role": "拜希麦·五世",
                          "text": "我已经想好了！如你所见，我正在枫丹人流量最大的港口打响「哐哐当当雀雀球」的名气！"
                        },
                        {
                          "role": "拜希麦·五世",
                          "text": "团雀的可爱名声会随着巡轨船和货船四处流传，等到时机成熟，我就会大量免费派送游戏，让大家随时都能玩到雀雀球！"
                        }
                      ]
                    },
                    {
                      "text": "好耶！可爱就是和平！",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "现在我觉得这句话完全不夸张了，这段时间的旅行以来，接触到的养宠物的人都很有耐心，和他们讲道理也非常顺利！"
                        },
                        {
                          "role": "派蒙",
                          "text": "所以拜希麦五世小姐和你的…太外祖母，说得非常有道理！"
                        },
                        {
                          "role": "拜希麦·五世",
                          "text": "看来我们的想法非常一致，你们两位要不也加入「团雀和平大使」的队伍？"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "拜希麦·五世",
                  "text": "要是方便的话，请带上几份游戏的本体，或者是宣传画，在之后的旅行过程中向其他人推荐「哐哐当当雀雀球」…"
                },
                {
                  "role": "派蒙",
                  "text": "这样一来，就能向更多人喊出那句话了——"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "「团雀最可爱！」"
                }
              ]
            },
            {
              "text": "为什么你叫「五世」来着？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对哦，听起来像是很厉害的大贵族后裔…须弥有这样的家族吗？"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "哈哈哈，没有那么夸张啦！我的这个名字只是一个称号。"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "一切都起源于我的太外祖母，她刚正不阿，得罪了很多学术对手，被恶意派遣到沙漠中去调查不存在的生物，直接失踪了…"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "结果在所有人都以为她死掉的十几年后，她突然带着调查报告和「哐哐当当雀雀球」回来了。"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "她不仅完成了当年的任务，还性情大变，像是参悟了什么道理。"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "遇见和她争论的同行，她再也不会生气，而是邀请对方一起来玩雀雀球，边玩边讨论。"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "在和谐的讨论氛围中，大部分问题都迎刃而解，甚至许多和太外祖母针锋相对的人都变成了她的好朋友兼雀雀球爱好者…"
                },
                {
                  "role": "派蒙",
                  "text": "雀雀球居然真的有这种功效吗！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "超出预期的发展…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "拜希麦·五世",
                  "text": "很神奇吧！所以我才坚信太外祖母的说法，可爱的团雀能让世界和平！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "出于对太外祖母的尊敬，她的朋友为我的家族成员们起了便于辨认的称号，我是那之后的第五代当家，所以就是五世了！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "据说一些太外祖母本人的朋友非常长寿，取走雀雀球研究时，还说，希望能看到拜希麦十世，甚至二十世的活跃…"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "最后让「坐下来玩一局雀雀球」成为全提瓦特流行的一种习俗，解决万千争端！"
                },
                {
                  "role": "派蒙",
                  "text": "这么看来，拜希麦五世小姐的理想还真不是空话呢，我们也可以来帮忙！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "多玩雀雀球少吵架。",
                      "dialogues": []
                    },
                    {
                      "text": "多讲讲道理少生气。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "拜希麦·五世",
                  "text": "说得很精髓，我用力鼓掌！"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "你这简洁有力的话蕴含着最珍贵的道理，我就把它写在雀雀球包装的背面吧。"
                },
                {
                  "role": "拜希麦·五世",
                  "text": "总之，我们一起努力吧，让更多人开开心心前进，把烦人的争吵变成和谐的讨论！"
                }
              ]
            },
            {
              "text": "下次再来聊可爱！",
              "dialogues": [
                {
                  "role": "拜希麦·五世",
                  "text": "好哦！看在我们如此合拍的份上，记得多多回来找我，多多赏玩雀雀球哦！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          25,
          27
        ]
      ]
    }
  ]
}