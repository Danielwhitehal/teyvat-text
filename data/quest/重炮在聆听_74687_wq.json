{
  "quest_id": 74687,
  "chapter_num": null,
  "chapter_title": "重炮在聆听",
  "type": "wq",
  "route": "The Cannon Has Ears",
  "stories": [
    {
      "story_id": 74687,
      "title": "重炮在聆听",
      "description": "枫丹南部的某地似乎出现了紧急事态，警备队员们需要支援…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与警备队员们对话"
        },
        {
          "role": "谢妮",
          "text": "前辈，事态已经持续半天了，魔物还是没有减少的迹象…"
        },
        {
          "role": "谢妮",
          "text": "要不然，我还是去呼叫增援吧？"
        },
        {
          "role": "弗雷瑞斯",
          "text": "不用慌张，相信我的重炮和那位便衣同事！"
        },
        {
          "role": "弗雷瑞斯",
          "text": "此外，对危机有着敏锐嗅觉的冒险家，甚至是某位长官…应该也会在第一时间赶来吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "又有什么危机？",
              "dialogues": []
            },
            {
              "text": "我们来得正好？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "谢妮",
          "text": "出现了…准领队居然真的带着小助手来了！"
        },
        {
          "role": "弗雷瑞斯",
          "text": "两位好，请让我简单说明事态…"
        },
        {
          "role": "谢妮",
          "text": "嘿嘿，前辈先休息一会儿吧，说明工作交给我就好。"
        },
        {
          "role": "谢妮",
          "text": "咳！想操纵重炮狂轰一番吗？海军舰队全灭后，这种机会可不多了，说是梦回几百年前也不为过！"
        },
        {
          "role": "谢妮",
          "text": "用特制的弹头成片成片击倒魔物，怎么想都很解压吧，还能拿到警备队的奖金呢！"
        },
        {
          "role": "派蒙",
          "text": "用大炮轰魔物…这个我们的确在行！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来确实不复杂。",
              "dialogues": []
            },
            {
              "text": "但为什么突然轰魔物？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "谢妮",
          "text": "最近，工人们无意间在附近的地下挖出了一座遗迹，惊动了里边沉睡的魔物…"
        },
        {
          "role": "谢妮",
          "text": "为了不让魔物外逃，警备队建立了防御阵地…"
        },
        {
          "role": "谢妮",
          "text": "不过，说是阵地，目前只有我们两人和一位度假中的美露莘探员，还有我们改进过的一种炮台…"
        },
        {
          "role": "派蒙",
          "text": "噫！感觉有点危险！那位美露莘探员没关系吗？"
        },
        {
          "role": "弗雷瑞斯",
          "text": "放心，通过远程操纵遗迹出口的重炮，那位美露莘探员不必亲自上阵，也能将大部分魔物拦住。"
        },
        {
          "role": "谢妮",
          "text": "她确实非常可靠，但长期高强度执勤，肯定也会累的。"
        },
        {
          "role": "谢妮",
          "text": "准领队，你愿意帮帮我们吗？要是情况一直不妙，我会找来更多增援。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你别说，还真有兴趣试试重炮…",
              "dialogues": []
            },
            {
              "text": "无论事态好坏，我都想来帮忙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "放着眼前的事态不管，也不是我们的作风！"
        },
        {
          "role": "弗雷瑞斯",
          "text": "太好了，多谢你们愿意出手相帮。"
        },
        {
          "role": "弗雷瑞斯",
          "text": "上次实验之后，我又重新调整了自己的发明，希望你们用得顺手。"
        },
        {
          "role": "谢妮",
          "text": "哎，要是重炮能自己瞄准、自己发射就好了，前辈觉得呢？"
        },
        {
          "role": "弗雷瑞斯",
          "text": "对啊！下次我可以试着给重炮加上警卫机关的识别模块，让它们自行值岗！"
        },
        {
          "role": "谢妮",
          "text": "不愧是前辈，真聪明！"
        },
        {
          "role": "玛因",
          "text": "好呀，顶班的来了…"
        },
        {
          "role": "玛因",
          "text": "咦？怎么是你们？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我…我们怎么了吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "感觉你好像认识我们…"
                },
                {
                  "role": "玛因",
                  "text": "没有任何问题，很好很好，你们出了名的强！"
                },
                {
                  "role": "玛因",
                  "text": "在单位里的时候，回村里以后，大家都在说，什么事都能放心交给你们。"
                }
              ]
            },
            {
              "text": "我们之前好像见过？",
              "dialogues": [
                {
                  "role": "玛因",
                  "text": "居然还记得我？之前「海薇玛映影欢乐城」招募员工的时候，我还给你投过简历呢。"
                },
                {
                  "role": "派蒙",
                  "text": "好像，确实有这么一回事来着？"
                },
                {
                  "role": "玛因",
                  "text": "我知道你们很强，什么事都能放心交给你们。"
                }
              ]
            }
          ]
        },
        {
          "role": "玛因",
          "text": "相比之下，那边的两位同事，虽然也都很可靠，但总感觉有点，说不上来的别扭？"
        },
        {
          "role": "玛因",
          "text": "人类的情感真复杂啊…要不要推他们一把呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别扭？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛因",
          "text": "算了，正事要紧。"
        },
        {
          "role": "玛因",
          "text": "总之加油吧，那部重炮的操纵并不难，期待你们三下五除二，把所有目标都轰得一个不留。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（弗雷瑞斯）"
        },
        {
          "role": "弗雷瑞斯",
          "text": "怎么样，这次的炮台体验如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "如果还能改进就好了。",
              "dialogues": [
                {
                  "role": "弗雷瑞斯",
                  "text": "比如说？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "固定一个位置有点笨…",
                      "dialogues": []
                    },
                    {
                      "text": "我想扛它边走边打…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "没想到还有这种需求…准领队果然不是凡人，充满奇思妙想。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "但要想边走边射击，还得先承受重炮的后坐力。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "准领队你自己的话，以肉体之躯硬接舰炮的后坐力，也不是不可能。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "但普通警备队员极大概率被炮尾直接一下撞死…所以还得发明一个…小型地上战舰级别的平台，载着重炮到处跑。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "这么大一个东西，也得考虑防护能力，加了装甲就会很笨重，那动力和行走机构的问题，都要纳入考虑了。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "工程设计会变得特别复杂，像我这种被枫丹科学院拒绝了三次的普通人…能顶得住吗？"
                }
              ]
            },
            {
              "text": "你好像有点眼熟？",
              "dialogues": [
                {
                  "role": "弗雷瑞斯",
                  "text": "你还对我有点印象啊？那太好了！"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "好一段时间之前，这部炮台的原型机，也是你帮忙测试的。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "那时的我，还在不断和谢妮重复着天才的谎言…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "现在谎言被拆穿了？",
                      "dialogues": []
                    },
                    {
                      "text": "后来你和她坦白了？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "哈哈，都不是，谎言进化了。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "托你的福，上次的炮台表现很棒，执律庭也适当给了我资金支持，还帮我介绍了几位工程师。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "得到了老前辈的指教，再加拿到了枫丹科学院的很多工程废案后，我确实做出了一些东西——"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "「能挖掘地下浅层矿物的钻头」，「异构安东·罗杰飞行器」…应该说叫「弗雷瑞斯飞行器」了。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "不过，谢妮还是最喜欢那台「早餐自动烘焙机」，她说她天天都用。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那谎言不就变成现实了吗？",
                      "dialogues": []
                    },
                    {
                      "text": "说不定你确实是个天才呢？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "不，我心里明白，我能做出这些东西，都是借助了别人的力量，我只是个改进者，说得难听点，「装裱匠」。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "真正的天才，根本不需要借助别人的外力，"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "但我又和原来那个普普通通，什么都做不出来的普通人…不一样了。"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "所以我觉得，这个「谎言」好像逐渐变成了我的…「许诺」？"
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "没有那么不切实际，但好像，也还挺遥远的。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那你就为此不断加油吧！",
                      "dialogues": []
                    },
                    {
                      "text": "坚持下去！搞发明的男子汉！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "弗雷瑞斯",
                  "text": "我会尽力的！你的鼓励让我稍微有一点底气了！"
                }
              ]
            },
            {
              "text": "我再琢磨琢磨。",
              "dialogues": [
                {
                  "role": "弗雷瑞斯",
                  "text": "没问题，重炮的身管寿命很不错，请随意开火吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（谢妮）"
        },
        {
          "role": "谢妮",
          "text": "准领队，你想和我聊聊重炮的事呢，还是前辈的事？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你对重炮其实没什么兴趣吧？",
              "dialogues": [
                {
                  "role": "谢妮",
                  "text": "还是被你看穿了…"
                },
                {
                  "role": "谢妮",
                  "text": "说实话，我有点后悔，之前一直配合前辈「扮演天才」的努力了。"
                },
                {
                  "role": "谢妮",
                  "text": "他的动力好像愈发旺盛了，不仅做出了炮台的正式军用版，还不怕危险，带着它第一时间赶来危险地带。"
                },
                {
                  "role": "谢妮",
                  "text": "要不是玛因小姐本来就守在这里，只凭他一人，可能真的会出现意外。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "但你也在保护他吧。",
                      "dialogues": []
                    },
                    {
                      "text": "你好像也不怕魔物。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "=谢妮",
                  "text": "嗯，我在重炮后方布置了只会被魔物触发的雷场，就算重炮没能杀死魔物，它们也逃不出遗迹。"
                },
                {
                  "role": "谢妮",
                  "text": "就算真有什么意外情况，我也会第一时间握好铳枪，干掉走运或狡猾的家伙。"
                },
                {
                  "role": "谢妮",
                  "text": "自从那次被救过以后，我就一直在好好训练。现在我的射术，应该不输蒂蕾娜之类的杰出代表了。"
                },
                {
                  "role": "谢妮",
                  "text": "好在，至少到目前为止，前辈的重炮还没有失误过。"
                },
                {
                  "role": "谢妮",
                  "text": "应该说，自从上次那座试验性炮台得到了不错的反响后，前辈还一直没有遭遇过惨痛的失败。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那要是真的遭遇了惨败呢？",
                      "dialogues": []
                    },
                    {
                      "text": "如果哪天他真的倒霉了呢？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "谢妮",
                  "text": "我想过哦，他再次让所有人失去兴致，被所有人忽视的那天，我该怎么面对他…"
                },
                {
                  "role": "谢妮",
                  "text": "「不要紧的，就算不是什么天才，也没关系。」"
                },
                {
                  "role": "谢妮",
                  "text": "我要这样安慰他吗？有点残忍。"
                },
                {
                  "role": "谢妮",
                  "text": "人的自尊很重要，我不想任何人伤害他的自尊，所以我得帮他继续演下去。"
                },
                {
                  "role": "谢妮",
                  "text": "如果他吸引过来的那几位工程师也放弃他了，我就雇几位一直想邀请我，但被我拒绝的专家，来配合他演戏吧。"
                },
                {
                  "role": "谢妮",
                  "text": "有趣与否已经是次要了，最重要的是，这场戏可不能草草收场。"
                }
              ]
            },
            {
              "text": "要不，待会儿再聊？",
              "dialogues": [
                {
                  "role": "谢妮",
                  "text": "好，那你先忙，我继续在这里陪着前辈，随时都在。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（玛因）"
        },
        {
          "role": "玛因",
          "text": "哟，老板…准领队，事态平息了吗？如果没什么魔物了，那我就去干正事了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像暂时还没处理完。",
              "dialogues": [
                {
                  "role": "玛因",
                  "text": "那我不急，不走，我继续待命。"
                },
                {
                  "role": "玛因",
                  "text": "如果你累了，就叫我一声，我继续去遥控炮台，杀魔物。"
                },
                {
                  "role": "玛因",
                  "text": "这事我能干一整天。"
                }
              ]
            },
            {
              "text": "你不和那两位同事交流吗？",
              "dialogues": [
                {
                  "role": "玛因",
                  "text": "咦？我有和他们好好聊过天啊。"
                },
                {
                  "role": "玛因",
                  "text": "谢妮小姐还给了我很贵重的甜点，以前没吃过的蛋糕，以人类的标准，应该很美味。"
                },
                {
                  "role": "玛因",
                  "text": "我的口味已经被同事们驯化好了，我吃得也挺开心的。"
                },
                {
                  "role": "玛因",
                  "text": "谢妮家应该很有钱，弗雷瑞斯就出自普通家庭。谢妮总是给弗雷瑞斯吃这种甜点，少说一天也得花八九千摩拉。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "这都能看出来？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "玛因",
                  "text": "我猜的，嗯，根据步态，神情和谈吐用词猜的。"
                },
                {
                  "role": "玛因",
                  "text": "不过，和他们一起休息的时候，我能感觉到，我有点多余。不是他们嫌弃我，而是我能意识到，气氛不对…"
                },
                {
                  "role": "玛因",
                  "text": "所以我还是不打扰他们了，在这里安安静静放哨也挺好的，以前我在连队里也干侦察和放哨的活。"
                }
              ]
            },
            {
              "text": "你还有什么正事？",
              "dialogues": [
                {
                  "role": "玛因",
                  "text": "说来挺巧的，本来我在这附近转悠，是领了埃德勒…另一位探员的任务。"
                },
                {
                  "role": "玛因",
                  "text": "最近有些搞经济犯罪的混蛋，在这一带出没过。"
                },
                {
                  "role": "玛因",
                  "text": "正好这里也有几间正在招租的房子，说不定藏着点玄机，我就过来查查线索。"
                },
                {
                  "role": "玛因",
                  "text": "不过，说实话，调查经济犯罪，并没有直接揍魔物来得有劲。"
                },
                {
                  "role": "玛因",
                  "text": "以后你有揍魔物的差事，也可以随时叫上我，管饭最好，不管饭的话我自带便当。"
                }
              ]
            },
            {
              "text": "我去继续对付魔物了。",
              "dialogues": [
                {
                  "role": "玛因",
                  "text": "看样子还有的忙啊，挺好。别累着自己，乏了的话，就把重炮让给我吧，我来打打杀杀。"
                }
              ]
            }
          ]
