{
  "quest_id": 10084,
  "chapter_num": "溯及以往",
  "chapter_title": "溯及以往",
  "type": "wq",
  "route": "The Scattered Past",
  "stories": [
    {
      "story_id": 79022,
      "title": "被丢失的合照",
      "description": "在破破岛上，有一位一直叨念着丢失照片的愚人众藏镜仕女，看样子似乎无法正常沟通…找到让她恢复理智的办法，说不定能得知她在此行动的目的。",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "旅行者，这个藏镜仕女给人感觉好奇怪啊…"
        },
        {
          "role": "阿加菲娅",
          "text": "…要赶快回去…要赶快回去，他还在…可是，哥哥们不见了，哥哥们的照片…"
        },
        {
          "role": "派蒙",
          "text": "喂，愚人众的…"
        },
        {
          "role": "阿加菲娅",
          "text": "哥哥们的照片…丢了照片，就回不去了…"
        },
        {
          "role": "派蒙",
          "text": "愚人众的！"
        },
        {
          "role": "阿加菲娅",
          "text": "不能，把他丢下…不能让他一个人…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "状态不太对呢…",
            "没法沟通啊…"
          ]
        },
        {
          "role": "旅行者",
          "text": "状态不太对呢…"
        },
        {
          "role": "派蒙",
          "text": "总觉得看到过类似的场景啊…"
        },
        {
          "role": "旅行者",
          "text": "之前的愚人众…"
        },
        {
          "role": "派蒙",
          "text": "是哦，之前碰到叶夫卡的时候，他也一直念叨着「徽记、徽记…」什么的，把徽记给他就清醒了…"
        },
        {
          "role": "派蒙",
          "text": "愚人众在这里做实验，结果连自己的人都被影响了，这就叫「恶有恶报」！"
        },
        {
          "role": "旅行者",
          "text": "派蒙说的对！"
        },
        {
          "role": "派蒙",
          "text": "这么说来，这个藏镜仕女是不是就是叶夫卡说的，他们小队的成员啊…"
        },
        {
          "role": "派蒙",
          "text": "那我们是不是也要找到什么让她清醒过来…"
        },
        {
          "role": "阿加菲娅",
          "text": "哥哥们和我的合照…要是那个找不回来了，我就没法回去，可是…可是他还在那里，独自等着我…"
        },
        {
          "role": "派蒙",
          "text": "我明白了…旅行者，看来得把她心心念念的那个合照给她，她才会醒过来了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿加菲娅）"
        },
        {
          "role": "阿加菲娅",
          "text": "哥哥们的照片…丢了照片，就回不去了…"
        },
        {
          "role": "旅行者",
          "text": "（看来还是没办法对话…）"
        },
        {
          "type": "subtitle",
          "text": "寻找藏镜仕女丢失的照片"
        },
        {
          "type": "subtitle",
          "text": "将内有照片的怀表交给藏镜仕女"
        },
        {
          "type": "subtitle",
          "text": "与藏镜仕女对话"
        },

        {
          "role": "阿加菲娅",
          "text": "这…啊，这个是我的，这里面是哥哥们和我的合照…"
        },
        {
          "role": "阿加菲娅",
          "text": "能够重新找回来真是太好了，之前到底是丢在哪了呢…唔，不对，头好痛…"
        },
        {
          "role": "派蒙",
          "text": "我们是在丘丘人营地的旁边找到的啦！"
        },
        {
          "role": "阿加菲娅",
          "text": "真是，真是十分感谢…"
        },
        {
          "role": "阿加菲娅",
          "text": "啊！是内部文件上看到过的…金发的旅行者和小飞人！"
        },
        {
          "role": "派蒙",
          "text": "是「派蒙」啦…唉，我干脆改名叫「小飞人」算了…"
        },
        {
          "role": "阿加菲娅",
          "text": "你们对我做了什么，记忆…记忆有一段空白，你们不会对我做了什么奇怪的实验吧！"
        },
        {
          "role": "阿加菲娅",
          "text": "就算我们立场不同…这样的行为也是不能被接受的！"
        },
        {
          "role": "派蒙",
          "text": "做奇怪实验的是你们啦！"
        },
        {
          "role": "派蒙",
          "text": "居然对把合照还给你的好心人说这种话！"
        },
        {
          "role": "阿加菲娅",
          "text": "…原来是这样，可是，既然我清醒了过来就说明，佩尔西科夫研究员的实验失败了。"
        },
        {
          "role": "阿加菲娅",
          "text": "看到你们也大概猜到失败的原因…欸呀，从立场上我们暂时仍是敌对的，你们还把合照给我，你们对敌人也太好心了吧…"
        },
        {
          "role": "阿加菲娅",
          "text": "正确的做法应该是把别人的珍贵之物，比如对我来说，就是刚才怀表里的合照…应该把合照拿在手里，然后威胁我说出情报。"
        },
        {
          "role": "派蒙",
          "text": "居然反过来被教训了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好没有人情味的做法…",
              "dialogues": [
                {
          "role": "阿加菲娅",
          "text": "…确实，是很没有人情味的做法，但是我们进入愚人众之后就是这样被教导的。"
        }
              ]
            },
            {
              "text": "下次试试看吧…",
              "dialogues": [
                {
          "role": "阿加菲娅",
          "text": "不要学这种事啦！"
        }
              ]
            }      
          ]
        },
        
        {
          "role": "派蒙",
          "text": "对了，你们在这里到底在搞什么破坏，快说出来啦！"
        },
        {
          "role": "阿加菲娅",
          "text": "我…我们，我们一起到了这岛上…对了，扎哈尔！"
        },
        {
          "role": "阿加菲娅",
          "text": "他还一个人在那里，得快点回去！"
        },
        {
          "type": "subtitle",
          "text": "似乎想起了什么，刚清醒的愚人众转身就离开了…"
        },
        {
          "type": "subtitle",
          "text": "前去藏镜仕女离开的方向查看"
        },
        {
          "role": "阿加菲娅",
          "text": "扎哈尔！扎哈尔！你能听见吗！"
        },
        {
          "role": "阿加菲娅",
          "text": "这里怎么会变成这样…我们来的时候这里明明就是个山洞，这荆棘是怎么回事…"
        },
        {
          "role": "派蒙",
          "text": "啊，这就是因为受到你们那个什么幻境实验的影响导致的啦。"
        },
        {
          "role": "派蒙",
          "text": "这个岛上有很多类似的荆棘呢，不过只要用一定的方法…"
        },
        {
          "role": "阿加菲娅",
          "text": "是放火吗？你们不会是想放火烧掉荆棘吧，不行，里面可还有人呢！"
        },
        {
          "role": "阿加菲娅",
          "text": "虽说早就听闻旅行者和派蒙非常危险，有的时候只是走在执行公务的路上也会被突然袭击…"
        },
        {
          "role": "阿加菲娅",
          "text": "但是居然想放火慢慢烧一个大活人，天啊，就连最残忍的债务处理人都做不到这种程度…"
        },
        {
          "role": "派蒙",
          "text": "当然不是啦…而且这种荆棘用火烧也没用…"
        },
        {
          "role": "派蒙",
          "text": "我们有将荆棘打开，但不会伤到里面的人的办法…"
        },
        {
          "role": "阿加菲娅",
          "text": "真的吗，我可不信你们有这么神通广大。"
        },
        {
          "role": "派蒙",
          "text": "什么，旅行者，这就把荆棘打开给她看看！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "上当受骗了哦，派蒙…",
            "别这么简单就被挑拨啦…"
          ]
        },
        {
          "role": "派蒙",
          "text": "咦…好呀，你故意挑拨我！"
        },
        {
          "role": "阿加菲娅",
          "text": "居然被识破了，真是可惜。"
        },
        {
          "role": "派蒙",
          "text": "哼，真是奸诈狡猾的愚人众，我们差点就中了你的诡计！"
        },
        {
          "role": "旅行者",
          "text": "中计的只有你啦…"
        },
        {
          "role": "派蒙",
          "text": "呜…总之，总之我们可以救出里面的人，但是相对的，你也得说出一些情报来…"
        },
        {
          "role": "派蒙",
          "text": "这就是用别人的珍贵之物作为威胁，让别人说出情报的方法！"
        },
        {
          "role": "阿加菲娅",
          "text": "哇，真是好没有人情味的做法。"
        },
        {
          "role": "旅行者",
          "text": "好没有人情味的做法…"
        },
        {
          "role": "派蒙",
          "text": "她说也就算了，为什么你也说我呀，你到底是哪一边的！"
        },
        {
          "role": "阿加菲娅",
          "text": "…情报吗，阿加菲娅，我的名字是阿加菲娅，现在能给的情报只有这样了。"
        },
        {
          "role": "派蒙",
          "text": "只有一个名字吗！"
        },
        {
          "role": "阿加菲娅",
          "text": "我要是说出什么重要情报，你们就拉下脸来说什么「是嘛，你已经没用了…」之类的台词，然后把我解决掉…"
        },
        {
          "role": "阿加菲娅",
          "text": "愚人众的教官说每年都会发生很多类似的事，所以一定不能外泄重要的情报。"
        },
        {
          "role": "派蒙",
          "text": "我们才不会干这样的事呢！还有你们愚人众的教官真的很奇怪…"
        },
        {
          "role": "阿加菲娅",
          "text": "奇怪吗…我倒觉得还挺正常的。总之，我现在就一个人在这里，无论如何你们都能很轻松解决我不是吗，我又逃不掉。"
        },
        {
          "role": "派蒙",
          "text": "嗯…总觉得有点不甘心，唉，没办法，旅行者，那我们就先打开封住洞口的荆棘吧…"
        },
        {
          "type": "subtitle",
          "text": "解开荆棘封锁的洞口"
        },
        {
          "type": "subtitle",
          "text": "进入洞口与阿加菲娅对话"
        },
        {
          "role": "阿加菲娅",
          "text": "扎哈尔，扎哈尔…你没事吧？"
        },
        {
          "role": "扎哈尔",
          "text": "阿加霞，怎么了，出什么事了…我只是在这儿睡了一觉，不过身体已经舒服很多啦。"
        },
        {
          "role": "阿加菲娅",
          "text": "唉…你没事就好。"
        },
        {
          "role": "扎哈尔",
          "text": "嘿嘿，对了，阿加霞，你之前给我的果子，你给了我四个，我可一个都没吃呢，就等你回来一起吃。"
        },
        {
          "role": "阿加菲娅",
          "text": "真是的，本来就是给你摘的苹果…要是等太久饿了，就先吃嘛。"
        },
        {
          "role": "扎哈尔",
          "text": "可是你独自去做任务，更辛苦…虽然很饿，但是扎哈尔忍住了！"
        },
        {
          "role": "派蒙",
          "text": "哦？独自去做任务呀，是做了什么任务呢…"
        },
        {
          "role": "扎哈尔",
          "text": "啊，不就是因为雅科夫差点弄坏了设备，所以…"
        },
        {
          "role": "阿加菲娅",
          "text": "扎哈尔！你怎么什么词都敢往外捅啊！"
        },
        {
          "role": "扎哈尔",
          "text": "啊！你们，这不是内部文件上的，旅行者和…"
        },
        {
          "role": "旅行者",
          "text": "「小飞人」。"
        },
        {
          "role": "扎哈尔",
          "text": "对，是「小飞人」！"
        },
        {
          "role": "派蒙",
          "text": "我已经说腻了，我的名字是「派蒙」啦。"
        },
        {
          "role": "扎哈尔",
          "text": "嘿嘿，我脑袋不太好使，我的名字是扎哈尔…不对，你们和我们愚人众不是…不是敌人吗！"
        },
        {
          "role": "扎哈尔",
          "text": "阿加菲娅，是你把敌人带到这里来的？"
        },
        {
          "role": "阿加菲娅",
          "text": "对，这两位就是把你从荆棘里救出来的好心…救出来的好敌人。"
        },
        {
          "role": "扎哈尔",
          "text": "对哦，你走了以后不久，这里突然长出了巨大的荆棘，把山洞封起来了…是你们把那个巨大荆棘消灭掉的吗，了不起啊！"
        },
        {
          "role": "派蒙",
          "text": "正是如此！"
        },
        {
          "role": "扎哈尔",
          "text": "可是我们不是敌人嘛，为什么要做帮助敌人的事呢？"
        },
        {
          "role": "派蒙",
          "text": "真是个让人有点答不上来的好问题…"
        },
        {
          "role": "派蒙",
          "text": "当然是因为她答应了，如果我们把你救出来，她就告诉我们，你们几个到底在干什么…"
        },
        {
          "role": "扎哈尔",
          "text": "阿加菲娅，你居然出卖愚人众的情报！"
        },
        {
          "role": "阿加菲娅",
          "text": "没关系的，扎哈尔，到时候我们随便说些什么「愚人众在这片海域捕猎神秘花鳉」之类的话糊弄过去就是了。"
        },
        {
          "role": "派蒙",
          "text": "哇，居然光明正大地说要糊弄我们，真是被小瞧了。"
        },
        {
          "role": "派蒙",
          "text": "好了，荆棘也打开了，扎哈尔也救出来了，该说出你们要做什么事了吧…"
        },
        {
          "role": "扎哈尔",
          "text": "不能说呀，阿加菲娅。"
        },
        {
          "role": "阿加菲娅",
          "text": "唉，都到了这个时候了…不过说实话。其实我们也不太清楚，只是过来做测试的而已。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "测试？",
            "什么测试？"
          ]
        },
        {
          "role": "阿加菲娅",
          "text": "大概是什么信号测试吧…具体的我也不清楚，不过如果是小队里的另一组人，应该知道。"
        },
        {
          "role": "派蒙",
          "text": "只有这些吗…"
        },
        {
          "role": "阿加菲娅",
          "text": "我知道的也不多嘛…对了，情报也说了，你们可以放我们走了吧。"
        },
        {
          "role": "派蒙",
          "text": "虽然好像没有答应过会放你们走，不过看上去也没什么危险…"
        },
        {
          "role": "旅行者",
          "text": "那就算我们大发慈悲…"
        },
        {
          "role": "阿加菲娅",
          "text": "欸呀，那还真是感谢了。唉，也不知道<color=00E1FFFF>另一组的家伙们</color>怎么样了，我们当时约好，说做完任务就回海域中间的营地…"
        },
        {
          "role": "派蒙",
          "text": "另一组人？"
        },
        {
          "role": "阿加菲娅",
          "text": "对，也是两个人，说是要朝着<color=00E1FFFF>南方的两个岛</color>的方向去了…啊，这可是额外的情报，可不是无意中被套话了哦。"
        },
        {
          "role": "派蒙",
          "text": "南方的大岛上…那就是危危岛吧！"
        },
        {
          "role": "阿加菲娅",
          "text": "好了好了，不能再说了，我们得快点回海域中央岛屿上的营地才行…"
        }
      ]
    },
    {
      "story_id": 79023,
      "title": "被抛出的徽记",
      "description": "在危危岛上，有一位一直叨念着什么徽记的愚人众雷锤前锋军，看样子似乎无法正常沟通…找到让他恢复理智的办法，说不定能得知他在此行动的目的。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与奇怪的愚人众对话"
        },
        {
          "role": "叶夫卡",
          "text": "都是因为我…都是因为我他才会那样…"
        },
        {
          "role": "叶夫卡",
          "text": "不行，我得把…我得把徽记找回来给他…得把徽记找回来…"
        },
        {
          "role": "派蒙",
          "text": "喂，你在这里做什么呢！"
        },
        {
          "role": "叶夫卡",
          "text": "徽记，徽记…"
        },
        {
          "role": "派蒙",
          "text": "完全不理我们呢…"
        },
        {
          "role": "旅行者",
          "text": "派蒙再叫大声一点吧！"
        },
        {
          "role": "派蒙",
          "text": "这明显是听不到我们的话啦，喊再大声也没用…"
        },
        {
          "role": "派蒙",
          "text": "根本就和阿加菲娅一开始的时候一模一样嘛，那个时候把带着合照的怀表给阿加菲娅以后，她就醒过来了。"
        },
        {
          "role": "派蒙",
          "text": "这个雷锤前锋军，难道也有什么能让他从装置的影响里醒过来的东西吗？"
        },
        {
          "role": "派蒙",
          "text": "看来他好像一直在找什么徽记的样子…旅行者，看来得把他在找的徽记给他呀…"
        },
        {
          "type": "subtitle",
          "text": "寻找雷锤前锋军口中的徽记"
        },
        {
          "type": "subtitle",
          "text": "将徽记交给雷锤前锋军"
        },
        {
          "role": "派蒙",
          "text": "不过，他说的徽记不会就是我们之前在海边捡到的那个吧…就是那枚看上去有点破旧的那个！"
        },
        {
          "role": "派蒙",
          "text": "不如把那枚徽记给他看看吧…"
        },
        {
          "role": "旅行者",
          "text": "嗯，把徽记给他看…"
        },
        {
          "type": "subtitle",
          "text": "与雷锤前锋军对话"
        },
        {
          "role": "叶夫卡",
          "text": "这个…对，就是这个，这上面的划痕我记得一清二楚…嗯，这里怎么多了个缺口…"
        },
        {
          "role": "叶夫卡",
          "text": "对了，那时候雅科夫把这个徽记往下扔…"
        },
        {
          "role": "派蒙",
          "text": "是嘛，怪不得这个徽记在那么奇怪的地方…"
        },
        {
          "role": "叶夫卡",
          "text": "原来是这样，哈哈哈，没想到在海边，终于找到了…真是谢谢你们啊，这世上这么好心的人可不多了…"
        },
        {
          "role": "叶夫卡",
          "text": "不对，你们是…你们是旅行者和派蒙！"
        },
        {
          "role": "旅行者",
          "text": "对，我就是旅行者！"
        },
        {
          "role": "派蒙",
          "text": "对，我就是派蒙！"
        },
        {
          "role": "叶夫卡",
          "text": "我明白了…既然落到了你们的手里，那也没有什么办法了。"
        },
        {
          "role": "叶夫卡",
          "text": "我的父亲曾这样教导我，「如若落在敌手受辱，还不如慷慨就义，为家族赢得荣誉」。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，听上去有点可怕…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "居然说这样的话…",
            "不是合格的父亲会说的话！"
          ]
        },
        {
          "role": "派蒙",
          "text": "不过我们只是好奇你出现在这里的目的而已啦…"
        },
        {
          "role": "叶夫卡",
          "text": "……"
        },
        {
          "role": "叶夫卡",
          "text": "我的父亲曾这样教导我，「向敌人说出情报，那就和背叛没什么两样，我们家族没有为了苟活而背叛的人！」"
        },
        {
          "role": "派蒙",
          "text": "严厉过头了吧。"
        },
        {
          "role": "旅行者",
          "text": "严厉过头了…"
        },
        {
          "role": "叶夫卡",
          "text": "所以按照父亲的教导，不仅落在你们手上，还接受了你们的帮助，实在是让人感到羞愧的一件事…"
        },
        {
          "role": "叶夫卡",
          "text": "实不相瞒，我现在，羞愧得想要大哭一场！"
        },
        {
          "role": "派蒙",
          "text": "知道了，这又不是什么值得自豪的事，没必要说那么大声啦。"
        },
        {
          "role": "叶夫卡",
          "text": "但是父亲也曾这样教导我，「受人恩惠，就该好好回报。」父亲的教导，在现在的情况里，产生了矛盾。"
        },
        {
          "role": "叶夫卡",
          "text": "所以我决定…"
        },
        {
          "role": "派蒙",
          "text": "你决定？"
        },
        {
          "role": "叶夫卡",
          "text": "就按照我的意思来吧，我会告诉你们的！"
        },
        {
          "role": "派蒙",
          "text": "突然就变得随意了！"
        },
        {
          "role": "叶夫卡",
          "text": "我的名字是叶夫卡，原本是在做装置信号的测试工作…唔，这段记忆有点不清楚，总之，我记得我们一路来到这座岛…"
        },
        {
          "role": "叶夫卡",
          "text": "哦，对了，雅科夫，我是和雅科夫一起行动的，这之间还和他大吵了一架，导致他扔掉了这枚徽记…"
        },
        {
          "role": "叶夫卡",
          "text": "后来我…眼睁睁地看着雅科夫走进一个奇怪的东西里，然后他就和那个东西一起消失了。我不会从此以后都见不到他了吧…"
        },
        {
          "role": "叶夫卡",
          "text": "所以我才在这里，找能重新见到他的方法…然后不知道为什么脑袋「嗡」了一下，就变成了刚才那样。"
        },
        {
          "role": "派蒙",
          "text": "走进去就会消失的奇怪的东西…是什么金苹果群岛的怪谈吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "是恐怖的扭曲陷阱！",
            "是无形的吃人魔物！"
          ]
        },
        {
          "role": "派蒙",
          "text": "应该不是那样的东西吧…说不定其实就跟我们以前见过的那些奇怪的机关道路一样…"
        },
        {
          "role": "派蒙",
          "text": "说不定确实有重新打开的办法呢！"
        },
        {
          "role": "叶夫卡",
          "text": "你们，你们能打开那个吗…"
        },
        {
          "role": "派蒙",
          "text": "可以是可以啦，不过我们为什么要帮你呢…"
        },
        {
          "role": "旅行者",
          "text": "明明是愚人众呢…"
        },
        {
          "role": "叶夫卡",
          "text": "如果你们能打开，找到雅科夫，你们要我说什么我都会说的…啊，执行官大人们的坏话除外。"
        },
        {
          "role": "派蒙",
          "text": "哇，答应得好快，弄得我都觉得自己是反派了…而且，这个时候就遗忘你父亲的教导了吗…"
        },
        {
          "role": "叶夫卡",
          "text": "本来就是因为我的过错所以雅科夫才…有些事情，是比所谓的原则和教导更重要的…我是这么认为的。"
        },
        {
          "role": "派蒙",
          "text": "好吧！旅行者，我们就试试看看吧！"
        },
        {
          "type": "subtitle",
          "text": "寻找打开雅科夫穿行道路的办法"
        },
        {
          "type": "subtitle",
          "text": "前去寻找雅科夫"
        },
        {
          "type": "subtitle",
          "text": "与叶夫卡对话"
        },
        {
          "role": "叶夫卡",
          "text": "原来这里还有这样的一座岛…还真是奇怪…"
        },
        {
          "role": "叶夫卡",
          "text": "之前，我们在进行调查的时候，不记得有这样一座岛啊…"
        },
        {
          "role": "派蒙",
          "text": "叶夫卡…怎么了？"
        },
        {
          "role": "叶夫卡",
          "text": "不，没什么事…"
        },
        {
          "role": "派蒙",
          "text": "嗯，看来雅科夫肯定也来到了这个岛上！"
        },
        {
          "role": "叶夫卡",
          "text": "对，雅科夫，得赶紧找到雅科夫才行。雅科夫——！"
        },
        {
          "role": "派蒙",
          "text": "哇，都说了，别突然叫这么大声啦！"
        },
        {
          "role": "叶夫卡",
          "text": "抱歉…"
        },
        {
          "role": "派蒙",
          "text": "没必要那么紧张，这里应该是很安全的地方，好，旅行者，我们就先去找找雅科夫在哪吧…"
        },
        {
          "type": "subtitle",
          "text": "前去寻找雅科夫"
        },
        {
          "type": "subtitle",
          "text": "尝试唤醒雅科夫"
        },
        {
          "role": "雅科夫",
          "text": "（留声机里播放着，让人能回想起温暖过去的话语……）"
        },
        {
          "role": "雅科夫",
          "text": "啊…为什么…"
        },
        {
          "role": "叶夫卡",
          "text": "雅科夫，雅科夫你醒醒啊！你怎么，怎么变成了这个样子…"
        },
        {
          "role": "派蒙",
          "text": "你之前也是这个样子啦，而且还念叨着那个徽记呢！"
        },
        {
          "role": "叶夫卡",
          "text": "哦，对哦，那个徽记…"
        },
        {
          "role": "叶夫卡",
          "text": "雅科夫，你看，这是你的徽记。虽然你一气之下把它扔了，但是现在已经找到了…"
        },
        {
          "role": "叶夫卡",
          "text": "这是你和你父亲一起获得的荣誉，现在已经重新回到你的手中了…怎么样，雅科夫，你醒过来了吗…"
        },
        {
          "role": "雅科夫",
          "text": "为什么…为什么…为什么要抛下我一个人..."
        },
        {
          "role": "派蒙",
          "text": "还是没有恢复呢…"
        },
        {
          "role": "叶夫卡",
          "text": "难道这不是能唤醒他的东西吗…那他到底想要的是什么呀…"
        },
        {
          "role": "派蒙",
          "text": "他想要的是什么，你居然不知道吗…你们不是队友嘛？"
        },
        {
          "role": "叶夫卡",
          "text": "我…我一直以为他最重要的就是这份荣誉，不对，我错了，是「我以为」他觉得最重要的就是这个…"
        },
        {
          "role": "叶夫卡",
          "text": "那是他和他父亲一起出一个紧急任务得来的，只不过他的父亲牺牲了，再也没有回来…"
        },
        {
          "role": "叶夫卡",
          "text": "他的母亲在他出生的时候就去世了…失去父亲以后，他就变成了孤伶伶的一个人。"
        },
        {
          "role": "叶夫卡",
          "text": "唉，他年纪比我小，得过的荣誉却比我多，说不定我只是一直在嫉妒他，也不知道如何和他相处，我唯一能够参照的就是…"
        },
        {
          "role": "派蒙",
          "text": "不会是你父亲跟你相处的方式吧…"
        },
        {
          "role": "叶夫卡",
          "text": "说来惭愧，但是确实如此…"
        },
        {
          "role": "派蒙",
          "text": "这样不出问题才怪…"
        },
        {
          "role": "叶夫卡",
          "text": "我们这支小队的休整处在海域中央的岛屿，现在雅科夫这个样子，我必须得先把他送到那边去才行。"
        },
        {
          "role": "叶夫卡",
          "text": "哦，对了，我们…我们是受佩尔西科夫研究员指派，过来进行信号测试的成员。"
        },
        {
          "role": "叶夫卡",
          "text": "据说是某位执行官大人在须弥得到了什么新的知识，可以通过一些技术，连接他人的意识，影响到一整片区域…"
        },
        {
          "role": "叶夫卡",
          "text": "虽然不被看好，但是佩尔西科夫研究员还是强行开始了这次的实验，而我们则被指派前往海域各处进行装置的信号测试…"
        },
        {
          "role": "叶夫卡",
          "text": "对了，不知道佩尔西科夫研究员的实验进行的如何了…"
        },
        {
          "role": "派蒙",
          "text": "那还用问，我们出现在了这里，愚人众的实验…"
        },
        {
          "role": "旅行者",
          "text": "当然是失败了！"
        },
        {
          "role": "叶夫卡",
          "text": "是嘛，嘿嘿，这下那个佩尔西科夫研究员恐怕要吃苦头了。"
        },
        {
          "role": "叶夫卡",
          "text": "我知道的也只有这么多了，我之前就跟别的队员约好，完成测试任务，就要回海域中心岛屿的营地…"
        },
        {
          "role": "派蒙",
          "text": "啊，是之前碰到的愚人众！"
        },
        {
          "role": "叶夫卡",
          "text": "是嘛，原来你们已经见过她们了呀…"
        },
        {
          "role": "叶夫卡",
          "text": "唉…要是让阿加霞看到雅科夫这个样子，非得生我的气不可…不过无论如何，我得赶紧把雅科夫带回去才行！"
        }
      ]
    },
    {
      "story_id": 79024,
      "title": "被错置的海螺",
      "description": "之前唤醒的愚人众小队成员都回到了中央岛屿的营地里，真不知道名为雅科夫的岩使游击兵最后恢复理智了没有…",
      "dialogues": [
        {
          "role": "阿加菲娅",
          "text": "雅科夫，雅科夫，刚才的就是你平时最喜欢听的曲子…"
        },
        {
          "role": "阿加菲娅",
          "text": "怎么样，雅科夫醒过来了吗？"
        },
        {
          "role": "扎哈尔",
          "text": "不行，阿加霞，还是什么反应都没有。"
        },
        {
          "role": "阿加菲娅",
          "text": "每次我唱这首歌的时候，尤其是唱到「仲夏已逝，万花凋谢。你必将远行，而我却习惯等待。」这句的时候…"
        },
        {
          "role": "阿加菲娅",
          "text": "每次我唱到这里，他总是会眼睛变得湿润地看着我呀…怎么会一点反应都没有呢？"
        },
        {
          "role": "阿加菲娅",
          "text": "唉…"
        },
        {
          "role": "扎哈尔",
          "text": "我给他做了他最喜欢喝的汤，味道香得我自己口水都要流出来了，可是他还是没醒。"
        },
        {
          "role": "叶夫卡",
          "text": "阿加霞，我明白了！其实雅科夫最想要的就是他父亲能够回来，要不我就假扮成他的父亲…"
        },
        {
          "role": "阿加菲娅",
          "text": "闭嘴，我现在不想跟你说话！我当时就不该让雅科夫和你一队的！"
        },
        {
          "role": "叶夫卡",
          "text": "阿加霞，这不是因为我，你知道的，都是因为那个实验…"
        },
        {
          "role": "阿加菲娅",
          "text": "雅科夫，可怜的雅科夫啊…"
        },
        {
          "role": "派蒙",
          "text": "怎么了，雅科夫还是什么反应都没有吗？"
        },
        {
          "role": "阿加菲娅",
          "text": "是你们啊…唉，正如你们所见，雅科夫还是一点反应都没有。"
        },
        {
          "role": "阿加菲娅",
          "text": "这该如何是好啊，如果他这样浑浑噩噩的，就算回到了至冬，恐怕也会被愚人众除名…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "被愚人众除名不好吗…",
            "听上去倒是件好事。"
          ]
        },
        {
          "role": "阿加菲娅",
          "text": "可是，可是雅科夫现在孤身一人…我们都时常外出执行任务，没人能够照顾他…如果被愚人众除名，他这样还怎么活下去呀…"
        },
        {
          "role": "阿加菲娅",
          "text": "对了，旅行者，你…你肯定解决过很多这样的事了吧！"
        },
        {
          "role": "阿加菲娅",
          "text": "拜托了，拜托了，找到让雅科夫恢复的办法吧！"
        },
        {
          "role": "派蒙",
          "text": "可是…"
        },
        {
          "role": "阿加菲娅",
          "text": "你们不是想要情报吗，我们会拿机密的情报跟你们交换的，比如…"
        },
        {
          "role": "扎哈尔",
          "text": "对，比如「愚人众其实在金苹果群岛偷偷捕猎神秘花鳉」！"
        },
        {
          "role": "阿加菲娅",
          "text": "扎哈尔…"
        },
        {
          "role": "扎哈尔",
          "text": "对不起…我只记得这个了…"
        },
        {
          "role": "叶夫卡",
          "text": "我们只是些负责跑腿的，哪有什么机密情报…"
        },
        {
          "role": "阿加菲娅",
          "text": "叶夫卡，你不说话没人把你当哑巴。"
        },
        {
          "role": "派蒙",
          "text": "唉…旅行者，你怎么看呢，「愚人众其实在金苹果群岛偷偷捕猎神秘花鳉」这条情报。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "多少也是情报…",
            "勉勉强强吧…"
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧，就看在这条情报的价值上，就帮你们这个忙吧。"
        },
        {
          "role": "阿加菲娅",
          "text": "那真是感激不尽！"
        },
        {
          "role": "派蒙",
          "text": "不过说是这么说…到底怎么样才能唤醒雅科夫呢…"
        },
        {
          "role": "派蒙",
          "text": "他们之前好像一直在这个营地里…旅行者，不如我们先一起去营地里找找线索吧！"
        },
        {
          "type": "subtitle",
          "text": "在营地进行调查"
        },
        {
          "role": "派蒙",
          "text": "嗯？旅行者，你看箱子上放的海螺…"
        },
        {
          "role": "派蒙",
          "text": "总觉得在什么地方看到过类似的海螺，我们调查看看吧…"
        },
        {
          "type": "subtitle",
          "text": "继续调查"
        },
        {
          "role": "派蒙",
          "text": "呦，瞧瞧，回来啦…哼，幸好装置没被你摔个稀巴烂…"
        },
        {
          "role": "派蒙",
          "text": "但是…"
        },
        {
          "role": "派蒙",
          "text": "去做信号接收测试而已，累活又不是没干过…"
        },
        {
          "role": "派蒙",
          "text": "你看，叶夫卡也觉得不是什么大事吧。"
        },
        {
          "role": "派蒙",
          "text": "那…那我先去做准备，待会儿我们就出发！"
        },
        {
          "role": "派蒙",
          "text": "原来是能够记录下影像的海螺啊…"
        },
        {
          "role": "派蒙",
          "text": "唔…总觉得这段对话有些没头没尾的…像是缺了什么东西一样…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们去问问那些愚人众吧。"
        },
        {
          "type": "subtitle",
          "text": "与营地中的愚人众对话收集线索"
        },
        {
          "role": "阿加菲娅",
          "text": "怎么样，有什么发现了吗？"
        },
        {
          "role": "派蒙",
          "text": "虽然也说不上是有线索，不过也是一种可能呢…"
        },
        {
          "type": "subtitle",
          "text": "向三位愚人众小队成员说明了海螺的作用…"
        },
        {
          "role": "阿加菲娅",
          "text": "啊，没想到被那个奇怪装置影响到的海螺还会有这样的效果啊…"
        },
        {
          "role": "阿加菲娅",
          "text": "你说的那个画面，应该是我带着害怕被训斥的雅科夫，找叶夫卡的画面吧…"
        },
        {
          "role": "叶夫卡",
          "text": "对，你这么一说，我也有点印象。"
        },
        {
          "role": "阿加菲娅",
          "text": "不过，那也是很长一段时间之前，更何况，受到了那台巨大装置的影响，呜…在营地里时的记忆也变得很模糊…"
        },
        {
          "role": "阿加菲娅",
          "text": "但是，这里的海螺本来应该有四个，应该<color=00E1FFFF>还有其他三个</color>的！"
        },
        {
          "role": "派蒙",
          "text": "其他的记忆很模糊，但是海螺有四个却记得很清楚？"
        },
        {
          "role": "阿加菲娅",
          "text": "在营地休整的时候，我们发现忘带盛汤的容器了，所以就临时用了那个海螺装做好的汤。所以，那个海螺是我们一人一个的…"
        },
        {
          "role": "扎哈尔",
          "text": "嗯，不过出发之前，雅科夫就把汤喝完，留在箱子上了…"
        },
        {
          "role": "扎哈尔",
          "text": "其他的我们一人一个，全都带走啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那，海螺呢？",
            "海螺现在在哪？"
          ]
        },
        {
          "role": "阿加菲娅",
          "text": "唔…当时只觉得是一些普通的海螺，所以喝完汤之后就扔掉了…"
        },
        {
          "role": "阿加菲娅",
          "text": "我想想，那个时候才刚上<color=00E1FFFF>西北方向的大岛</color>，就把汤喝完，海螺，海螺被我顺手丢在岛上一个全是水的山洞里了。"
        },
        {
          "role": "叶夫卡",
          "text": "我，我好像扔在<color=00E1FFFF>南方的大岛</color>遗迹边的山上了…"
        },
        {
          "role": "扎哈尔",
          "text": "嘿嘿，我的扔进了<color=00E1FFFF>东北方向大岛</color>的井里…"
        },
        {
          "role": "派蒙",
          "text": "哇，根本就丢得到处都是…"
        },
        {
          "role": "派蒙",
          "text": "西北方向的岛，应该是辛焱的幻境所在的岛，也就是破破岛…"
        },
        {
          "role": "派蒙",
          "text": "南方向的大岛，就应该是危危岛…东北方向的话…"
        },
        {
          "role": "旅行者",
          "text": "就是双双岛吧…"
        },
        {
          "role": "派蒙",
          "text": "丢在了这三个岛上呀…"
        },
        {
          "role": "旅行者",
          "text": "看来得找到这三个海螺…"
        },
        {
          "role": "派蒙",
          "text": "嗯，如果找到了这三个海螺，说不定就能找到能让雅科夫醒过来的线索了！"
        },
         {
          "type": "subtitle",
          "text": "寻找丢失的海螺"
        },
        {
          "role": "派蒙",
          "text": "对了，旅行者，就在他们说的那些地方…我们不都看到过奇怪的海螺影像嘛…"
        },
        {
          "role": "派蒙",
          "text": "那个时候我们捡到的那三个有点怪怪的海螺，说不定就是用在这里的，赶紧放箱子上试试吧！"
        },
        {
          "type": "subtitle",
          "text": "将错位的海螺放回原位"
        },
        {
          "type": "subtitle",
          "text": "唤醒雅科夫"
        },
        {
          "role": "派蒙",
          "text": "影像里这几个人好像不是…「那么坏」的愚人众嘛…"
        },
        {
          "role": "扎哈尔",
          "text": "雅科夫，长官说了你些什么，你这么垂头丧气的。"
        },
        {
          "role": "雅科夫",
          "text": "因为海浪颠簸，搬运仪器的时候摔了一跤，幸好我手快，仪器没事…"
        },
        {
          "role": "雅科夫",
          "text": "但是长官还是训话说，要让我们小队去各个岛上做装置的信号接收测试，那可是最辛苦的任务…"
        },
        {
          "role": "扎哈尔",
          "text": "没关系，不必这么伤心，咱们什么累活没干过啊。别伤心啦，先吃点东西吧！"
        },
        {
          "role": "雅科夫",
          "text": "阿加霞，佩尔西科夫研究员让我们去做信号接收测试，是让我们四个一起去…叶夫卡要是听到这件事，非得气个爆炸不可…"
        },
        {
          "role": "阿加菲娅",
          "text": "雅科夫，不会的，这是上面大人的命令，叶夫卡肯定也不会责怪你的…"
        },
        {
          "role": "阿加菲娅",
          "text": "唉，你要是真这么害怕，我陪你去跟叶夫卡说。"
        },
        {
          "role": "叶夫卡",
          "text": "呦，瞧瞧，回来啦…哼，幸好装置没被你摔个稀巴烂…"
        },
        {
          "role": "雅科夫",
          "text": "但是…"
        },
        {
          "role": "叶夫卡",
          "text": "去做信号接收测试而已，累活又不是没干过…"
        },
        {
          "role": "阿加菲娅",
          "text": "你看，叶夫卡也觉得不是什么大事吧。"
        },
        {
          "role": "雅科夫",
          "text": "那…那我先去做准备，待会儿我们就出发！"
        },
        {
          "role": "雅科夫",
          "text": "信号测试器…两组…"
        },
        {
          "role": "叶夫卡",
          "text": "唉，我还以为他被单独叫出去是要受什么严重的惩罚，结果只是布置了比较麻烦的任务，真是松了口气。"
        },
        {
          "role": "阿加菲娅",
          "text": "他可害怕被你骂了，哈哈，看上去就像是害怕被「哥哥」骂的「弟弟」一样…你说，他是不是，其实怕的是我们对他失望…"
        },
        {
          "role": "阿加菲娅",
          "text": "明明大家只是小队成员而已…但有的时候，感觉就跟「家人」一样啊…"
        },
        {
          "role": "叶夫卡",
          "text": "家人吗…"
        },
        {
          "role": "雅科夫",
          "text": "家人…我已经没有家人了…"
        },
        {
          "role": "雅科夫",
          "text": "…父亲让自己留在了危险的地方，让我得以脱身返回至冬。确认父亲无法归还后，他们送来了那枚徽记…"
        },
        {
          "role": "雅科夫",
          "text": "可是我不想要那些奖赏和荣誉…我，我只想要我的家人…啊，父亲啊，为什么你独自把我留在这个世上呢…"
        },
        {
          "role": "阿加菲娅",
          "text": "雅科夫。"
        },
        {
          "role": "雅科夫",
          "text": "唔...头好痛，怎么了，阿加霞姐姐，你怎么在这...我们不是在不同的组吗..."
        },
        {
          "role": "阿加菲娅",
          "text": "实验和任务都已经结束啦，雅科夫。"
        },
        {
          "role": "叶夫卡",
          "text": "没想到居然是「家人」啊…那我的推论也对了一半嘛！"
        },
        {
          "role": "雅科夫",
          "text": "怎么、怎么都这样看着我，我是说了什么奇怪的话吗…"
        },
        {
          "role": "阿加菲娅",
          "text": "没有，只是不小心听到了一些你的心里话而已。雅科夫，所谓的家人有的时候并不仅仅指血脉相连的人哦…"
        },
        {
          "role": "扎哈尔",
          "text": "嘿嘿，我觉得家人就是能一直在一起吃饭的人。"
        },
        {
          "role": "雅科夫",
          "text": "…我，我知道啦。"
        },
        {
          "role": "叶夫卡",
          "text": "如果你愿意的话，你也可以将我视作你的父亲…"
        },
        {
          "role": "雅科夫",
          "text": "不，这就有点恶心了…"
        },
        {
          "role": "派蒙",
          "text": "啊，雅科夫恢复了！"
        },
        {
          "role": "旅行者",
          "text": "真是可喜可贺…"
        },
        {
          "role": "雅科夫",
          "text": "咦，这两位，不是在内部文件里看到过的…"
        },
        {
          "role": "派蒙",
          "text": "其实之前就想问了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "内部文件？",
            "什么内部文件？"
          ]
        },
        {
          "role": "阿加菲娅",
          "text": "哎呀，没什么，上面都没什么重要的东西…"
        },
        {
          "role": "阿加菲娅",
          "text": "对了雅科夫，如果没有他们帮忙，你说不定就没法恢复理智了！"
        },
        {
          "role": "雅科夫",
          "text": "唔，虽然不知道发生了什么，但这次就谢谢你们了！"
        },
        {
          "role": "派蒙",
          "text": "嗯…还是有点在意，不过就算了，我们也算成功完成了「情报与委托的交易啦」。"
        }
      ]
    }
  ]
}