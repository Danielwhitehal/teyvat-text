{
  "quest_id": 20007,
  "chapter_num": null,
  "chapter_title": "紧急修理",
  "type": "iq",
  "route": "Urgent Repairs",
  "stories": [
    {
      "story_id": 20007,
      "title": "紧急修理",
      "description": "艾伦正运送着猎物去蒙德城，但是货车却被丘丘人袭击，货物和他自己都陷入了危险的境地…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "消灭所有魔物"
        },
        {
          "role": "艾伦",
          "text": "谢，谢谢你，旅行者，太好了，我还以为这次完蛋了…"
        },
        {
          "role": "艾伦",
          "text": "这车上都是猎手们辛苦狩猎的成果，杜拉夫先生要我送去蒙德城。"
        },
        {
          "role": "艾伦",
          "text": "虽然我不…太擅长狩猎，但是押送这么简单的活，应该还是能做的，我开始是这么想的…"
        },
        {
          "role": "艾伦",
          "text": "但还是差点搞砸了。突然被这么袭击，肯定是因为这些猎物太好了，那群家伙也想要，还好你来了。"
        },
        {
          "role": "艾伦",
          "text": "呃，虽然很不好意思，但是…刚才被袭击的时候，货车也被弄坏了，想要离开这，我必须把车修好。"
        },
        {
          "role": "艾伦",
          "text": "周围的树林里应该有能用的材料。但是猎物还在车里，走开的话我实在很担心。"
        },
        {
          "role": "艾伦",
          "text": "如果可以的话，你能帮我从周围找一块<color=#00E1FFFF>结实的木板</color>来吗？"
        },
        {
          "type": "subtitle",
          "text": "和艾伦对话"
        },
        {
          "role": "艾伦",
          "text": "只需要修理几个小地方，能让车撑到蒙德城就好了。"
        },
        {
          "role": "艾伦",
          "text": "周围的树林里应该就有合适的木材。"
        },
        {
          "role": "旅行者",
          "text": "我明白了。"
        },
        {
          "role": "艾伦",
          "text": "太好了，那我就在这等你，请你快一些，不然那群家伙说不定又要回来了…"
        },
        {
          "role": "旅行者",
          "text": "还有别的急事。"
        },
        {
          "role": "艾伦",
          "text": "别啊！那群家伙说不定还在附近，你就再帮我一把，让我快点离开这吧，拜托了！"
        },
        {
          "type": "subtitle",
          "text": "收集木材"
        },
        {
          "type": "subtitle",
          "text": "将结实的木板交给艾伦"
        },
        {
          "role": "艾伦",
          "text": "太感谢了，这帮家伙也太执着了，这些猎物有这么大的吸引力吗？"
        },
        {
          "role": "艾伦",
          "text": "也亏得杜拉夫先生能猎到这么好的猎物，要是我也能成为这样的猎人就好了。"
        },
        {
          "role": "艾伦",
          "text": "唉，在此之前，我还是先把车给弄进城吧。"
        },
        {
          "role": "艾伦",
          "text": "抱歉，旅行者，本来车都快修好了，结果刚才一阵折腾，又有个小地方出问题了。"
        },
        {
          "role": "艾伦",
          "text": "但是再呆在这只会更危险，必须把车快点修好，我记得车上有绳索，一定是被那群丘丘人给丢掉了。"
        },
        {
          "role": "艾伦",
          "text": "旅行者，能请你去帮我去周围找找<color=#00E1FFFF>绳索</color>吗？"
        },
        {
          "role": "艾伦",
          "text": "这些就足够了，只要一小会我就能…"
        },
        {
          "role": "艾伦",
          "text": "咦…旅行者，那群家伙又来了！"
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物"
        },
        {
          "role": "艾伦",
          "text": "绳索应该就在周围的树林里。"
        },
        {
          "type": "subtitle",
          "text": "和艾伦对话"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "艾伦",
          "text": "太感谢了，应该就在周围的树林里。"
        },
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "艾伦",
          "text": "最——后一步了，只要把绳索拿过来就好，剩下的我自己搞定，辛苦你了！"
        },
        {
          "type": "subtitle",
          "text": "收集绳索"
        },
        {
          "type": "subtitle",
          "text": "将绳索交给艾伦"
        },
        {
          "role": "艾伦",
          "text": "这样就可以了，虽然感觉随时可能散架，但只要能撑到蒙德城就好。"
        },
        {
          "role": "艾伦",
          "text": "谢谢你！那么我先出发了，以后来清泉镇记得来找我，我们好好喝一杯。"
        },
        {
          "role": "艾伦",
          "text": "…只要别喝得像杜拉夫先生一样就行。"
        },
        {
          "type": "subtitle",
          "text": "前去查看详情"
        }
      ]
    }
  ]
}