  "stories": [
    {
      "story_id": 20701,
      "title": "回头客",
      "description": "齐格芙丽雅对「翡玉什锦袋」的味道念念不忘，很想再次品尝…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与齐格芙丽雅对话"
        },
        {
          "role": "齐格芙丽雅",
          "text": "肚子怎么又饿了…"
        },
        {
          "role": "齐格芙丽雅",
          "text": "咦，是你啊！太好了，你还记得我吗？"
        },
        {
          "role": "齐格芙丽雅",
          "text": "香菱，料理对决，是我呀，齐格芙丽雅！"
        },
        {
          "role": "齐格芙丽雅",
          "text": "嘿嘿，记起来了吗，你来得正好，我能不能…拜托你一件事…"
        },
        {
          "role": "旅行者",
          "text": "什么事？"
        },
        {
          "role": "齐格芙丽雅",
          "text": "你还记得，你上次做的那道「翡玉什锦袋」吗？"
        },
        {
          "role": "齐格芙丽雅",
          "text": "我一直记得那个味道，实在是太好吃了。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "所以，我想要自己也来做一做看，但是…感觉做出来的味道始终都差一点点…"
        },
        {
          "role": "齐格芙丽雅",
          "text": "我觉得，只要再仔细品尝几次，我就能重现那个味道！"
        },
        {
          "role": "齐格芙丽雅",
          "text": "能不能拜托你，再把「翡玉什锦袋」做给我尝尝看？"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "太好了！那就拜托你了，我就在这等着你！"
        },
        {
          "role": "齐格芙丽雅",
          "text": "嘿嘿，「翡玉什锦袋」…又可以吃到了…"
        },
        {
          "role": "旅行者",
          "text": "不吃点别的吗？"
        },
        {
          "role": "齐格芙丽雅",
          "text": "唔…别的我也想吃，但要是什么都想吃，那就什么都吃不过来啦。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "总之，我还是先弄清「翡玉什锦袋」的味道吧。"
        },
        {
          "type": "subtitle",
          "text": "制作翡玉什锦袋"
        },
        {
          "type": "subtitle",
          "text": "将「翡玉什锦袋」交给齐格芙丽雅"
        },
        {
          "role": "齐格芙丽雅",
          "text": "太好了，总算可以再吃到你做的「翡玉什锦袋」了。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "虽然我知道菜谱，也摸索清楚了做法，但就是一直还原不了你做的那种味道。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "唉，要是你能多做几次「翡玉什锦袋」给我吃就好了，这道菜里，我还有很多细节想要弄清楚呢…"
        },
        {
          "role": "齐格芙丽雅",
          "text": "…啊，已经吃完了。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "那个蔬菜的口感…火腿和莲子之间的味道搭配…还有这个高汤…"
        },
        {
          "role": "齐格芙丽雅",
          "text": "就是这个味道，这就是我上次吃到的味道！"
        },
        {
          "role": "齐格芙丽雅",
          "text": "谢谢你专门过来给我做菜，我要赶紧回去做笔记了。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "下次，我一定能做出完美的「翡玉什锦袋」。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "到时候，你一定要来尝尝看啊。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "「翡玉什锦袋」做好了吗？"
        },
        {
          "role": "齐格芙丽雅",
          "text": "这火腿的鲜味，蔬菜的口感也刚刚好，还有这微微的辣味…"
        },
        {
          "role": "齐格芙丽雅",
          "text": "嗯，味道真不错，是一份很不错的「翡玉什锦袋」呢！"
        },
        {
          "role": "齐格芙丽雅",
          "text": "谢谢你专门过来给我做菜，我要赶紧回去做笔记了。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "下次，我一定能做出完美的「翡玉什锦袋」。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "到时候，你一定要来尝尝看啊。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "唔…菜叶的口感好干…里面好像还有食材没熟透…"
        },
        {
          "role": "齐格芙丽雅",
          "text": "和之前吃到的味道差太多了…难道，这是你琢磨出的什么新做法？"
        },
        {
          "role": "齐格芙丽雅",
          "text": "总感觉这道菜味道有些不对…不过，也可以作为参考。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "谢谢你专门过来给我做菜，我要赶紧回去做笔记了。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "下次，我一定能做出完美的「翡玉什锦袋」。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "到时候，你一定要来尝尝看啊。"
        },
        {
          "type": "subtitle",
          "text": "与齐格芙丽雅对话"
        }
      ]
    }
  ]
}