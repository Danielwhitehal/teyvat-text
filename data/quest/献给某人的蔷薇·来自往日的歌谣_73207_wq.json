{
  "quest_id": 73207,
  "chapter_num": null,
  "chapter_title": "献给某人的蔷薇·来自往日的歌谣",
  "type": "wq",
  "route": "A Gifted Rose: Ballad of Days Gone By",
  "stories": [
    {
      "story_id": 73207,
      "title": "献给某人的蔷薇·来自往日的歌谣",
      "description": "采取赛芭的建议，试着「唤醒」种子吧。",
      "dialogues": [
        {
          "role": "阿凡",
          "text": "沙法卡特叔叔，你最后的一点心愿我没法替你完成了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "沙法卡特是谁？",
              "dialogues": [
                {
                  "role": "阿凡",
                  "text": "你们之前不是还缠着我问鬼老头的事吗，其实鬼老头原来也不叫鬼老头，毕竟哪有人真名就叫这个的。"
                },
                {
                  "role": "阿凡",
                  "text": "听我的长辈说，他原来叫沙法卡特，年轻的时候就从须弥城离开，到了我们村。"
                },
                {
                  "role": "阿凡",
                  "text": "他来之后盖了这间小屋一个人住，后来几十年里几乎都没离开。"
                },
                {
                  "role": "阿凡",
                  "text": "我是没见过他年轻时候的样子，不过据说他那会儿还不怎么讨厌小孩。"
                },
                {
                  "role": "阿凡",
                  "text": "他家的屋前屋后又种了很多花和树，很多孩子都喜欢往他那里跑，跟他要枣椰吃，听他说话。"
                },
                {
                  "role": "阿凡",
                  "text": "但我见到他的时候，他已经老了，被人叫作鬼老头，变得讨厌小孩子。"
                }
              ]
            },
            {
              "text": "为什么执着于种花呢？",
              "dialogues": [
                {
                  "role": "阿凡",
                  "text": "我们村里，时不时就会有些外来的人迫不得己，在这里定居。"
                },
                {
                  "role": "阿凡",
                  "text": "有的人哪怕一直勉强自己，都始终不能习惯这里的生活，最后孤独一辈子。"
                },
                {
                  "role": "阿凡",
                  "text": "可能鬼老头…也就是沙法卡特叔叔，算其中之一吧，长期以来，大家都习惯这种事了。"
                },
                {
                  "role": "阿凡",
                  "text": "但不管多少年，我还是不愿意习惯这种事。他实在是太可惜了…"
                },
                {
                  "role": "阿凡",
                  "text": "他那座小花园你要是看到也会喜欢的，各种颜色的花，还有高高低低的树…"
                },
                {
                  "role": "阿凡",
                  "text": "打理出这么一座小花园的人就那么无声无息的不在了，关于他，大家只记得鬼老头会抓走调皮的小孩。"
                },
                {
                  "role": "阿凡",
                  "text": "我就是不乐意接受这种事，他留下的手记里写了他想让这些蔷薇到处长，我就是想实现他的心愿。"
                },
                {
                  "role": "阿凡",
                  "text": "反正我这一把年纪，别人怎么看我都无所谓，能做好这件事我就算没有白活。"
                },
                {
                  "role": "阿凡",
                  "text": "屋子我给他收拾好了，他留下来的一大堆小册子我也分类整理好了。"
                },
                {
                  "role": "阿凡",
                  "text": "你感兴趣的话，我可以拿一册出来给你瞧瞧。"
                },
                {
                  "role": "阿凡",
                  "text": "我就放在<color=#00E1FFFF>屋前</color>吧，让这手记里的他也见见太阳。"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "一定还有办法。"
        },
        {
          "role": "阿凡",
          "text": "还能有什么办法呢？"
        },
        {
          "role": "阿凡",
          "text": "沙法卡特叔叔…也就是鬼老头，早就安安静静地离开了，要不是这样，我还能去问一问这蔷薇有什么栽种的特殊方法。"
        },
        {
          "role": "阿凡",
          "text": "现在我还能去问谁呢。"
        },
        {
          "role": "旅行者",
          "text": "我认识一位生论派的学者赛芭。"
        },
        {
          "role": "阿凡",
          "text": "哦，你是说那个外来的姑娘啊。她能帮上忙吗？"
        },
        {
          "role": "阿凡",
          "text": "再说，她之前路过我这里，被我说了几句给呛跑了。她还会愿意帮忙吗？"
        },
        {
          "role": "旅行者",
          "text": "我会试试。"
        },
        {
          "role": "阿凡",
          "text": "你是个很好的孩子，如果找不到能帮忙的人也没关系，有你这些心意就够了。"
        },
        {
          "role": "旅行者",
          "text": "关于阿凡…"
        },
        {
          "role": "赛芭",
          "text": "嗯？什么样的问题呢？"
        },
        {
          "role": "？？？",
          "text": "把阿凡遇到的困难告诉了赛芭。"
        },
        {
          "role": "赛芭",
          "text": "原来如此，所以你来向我求援了啊。"
        },
        {
          "role": "赛芭",
          "text": "虽然在这种时候你能想起我，对我来说是很荣幸的事。"
        },
        {
          "role": "赛芭",
          "text": "不过我毕竟不是专攻物种培育的学者，我的经验也很有限，不能保证一定帮上忙。"
        },
        {
          "role": "赛芭",
          "text": "但我会努力试试的，更何况你说的那位培育出新品种蔷薇的先生也让人很感兴趣。"
        },
        {
          "role": "赛芭",
          "text": "等我有空的时候就会去阿凡老先生的苗圃，之后去那里找我吧。"
        },
        {
          "role": "阿凡",
          "text": "你们来了啊。"
        },
        {
          "role": "阿凡",
          "text": "这位就是你们找来帮忙的人吧，我前几天才刚对她说了难听的话…"
        },
        {
          "role": "阿凡",
          "text": "我真是…唉，老糊涂了。"
        },
        {
          "role": "赛芭",
          "text": "我们现在不是在友好地谈天嘛，老先生你别放在心上了。"
        },
        {
          "role": "旅行者",
          "text": "种子发芽了吗？"
        },
        {
          "role": "赛芭",
          "text": "很遗憾，我和阿凡老先生都看过了，种子依旧没有发芽。"
        },
        {
          "role": "赛芭",
          "text": "据我观察，这些种子的外部出现了矿石化的现象，之所以会如此，有两种可能原因："
        },
        {
          "role": "赛芭",
          "text": "第一，经过长时间的自然风化，它们失去了生物的活性，正在向化石形态转变。"
        },
        {
          "role": "赛芭",
          "text": "这种情况下，种子当然是无法发芽的。不过，这种假设成立的可能性较小。"
        },
        {
          "role": "赛芭",
          "text": "出现化石化现象所需的时间相当长，这些种子不能满足这个时间条件。"
        },
        {
          "role": "赛芭",
          "text": "第二，这个品种本身具有岩元素亲和力。"
        },
        {
          "role": "赛芭",
          "text": "它们在种子阶段富集了足够的岩元素，在种子外部生成了一层石壳。"
        },
        {
          "role": "赛芭",
          "text": "上述假设成立的话，这就是种子能够长时间保存的基本原理。"
        },
        {
          "role": "派蒙",
          "text": "我…我不是很明白，赛芭小姐是在说种子都变成了石头吗？"
        },
        {
          "role": "阿凡",
          "text": "石头啊，果然还是没希望了，石头开不出金蔷薇啊。"
        },
        {
          "role": "赛芭",
          "text": "金蔷薇？那个歌谣里的金蔷薇吗？"
        },
        {
          "role": "阿凡",
          "text": "哦，你们应该都还不知道吧，村子里流传的蔷薇歌谣，最初就是沙法卡特叔叔编出来的。"
        },
        {
          "role": "阿凡",
          "text": "他把自己编的歌谣教给了我的上一辈，他们又把它教给自己的孩子们。"
        },
        {
          "role": "阿凡",
          "text": "我这辈就已经有人不知道这事了，等我这一辈人也不在了，就没人记得他了吧。"
        },
        {
          "role": "阿凡",
          "text": "「蔷薇啊蔷薇，实现我的愿望。」"
        },
        {
          "role": "阿凡",
          "text": "「花从石头中绽放，金蔷薇对我歌唱。」"
        },
        {
          "role": "赛芭",
          "text": "对啊…我们可以让石头开花！"
        },
        {
          "role": "旅行者",
          "text": "赛芭想到了什么？"
        },
        {
          "role": "赛芭",
          "text": "就像歌谣里暗示的那样，或许打破了石质外壳，就能让种子从石头中发出芽来。"
        },
        {
          "role": "赛芭",
          "text": "一般来说，栽种植物都需要创造一个理想条件唤醒种子，让它们自己突破种壳。"
        },
        {
          "role": "赛芭",
          "text": "但既然这个蔷薇品种的种子外壳过于坚硬，种芽难以自行突破种壳，我们可以试着从外部帮一帮它们。"
        },
        {
          "role": "赛芭",
          "text": "阿凡老先生，你看可以吗？"
        },
        {
          "role": "阿凡",
          "text": "这是要用暴力方法弄碎种子吗？"
        },
        {
          "role": "赛芭",
          "text": "当然不能把种子完全打碎，我们得让一个灵巧的人去做这件事。"
        },
        {
          "role": "赛芭",
          "text": "旅行者，可以拜托你吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "果然是我。",
              "dialogues": []
            },
            {
              "text": "交给我吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "赛芭",
          "text": "过程中一定得小心，先用<color=#00E1FFFF>钝击</color>打破种壳，再用<color=#00E1FFFF>草元素</color>的力量「唤醒」种子。"
        },
        {
          "type": "subtitle",
          "text": "「唤醒」种子"
        },
        {
          "type": "subtitle",
          "text": "「唤醒」种子"
        },
        {
          "role": "？？？",
          "text": "静静等待了片刻之后，幼芽慢慢从土里冒了出来…"
        },
        {
          "role": "派蒙",
          "text": "赛芭的方法真的有效！"
        },
        {
          "role": "阿凡",
          "text": "终于发芽了，终于…"
        },
        {
          "role": "赛芭",
          "text": "看来，那位沙法卡特先生生前许下的心愿能够被实现了。"
        },
        {
          "role": "赛芭",
          "text": "阿凡老先生，你之前告诉我，这种蔷薇是由他培育出来的。"
        },
        {
          "role": "赛芭",
          "text": "能培育出新品种，他和我一样，也是被驱逐到这里的学者对吗？"
        },
        {
          "role": "阿凡",
          "text": "…是的。他被流放到了这个村子，在我们身后的屋子里度过了一生。"
        },
        {
          "role": "赛芭",
          "text": "是这样啊，的确，既然成为了流放者，最后的结局都会如此吧。"
        },
        {
          "role": "赛芭",
          "text": "说起来，培育新品种是只有顶尖学者才办得到的事。"
        },
        {
          "role": "赛芭",
          "text": "他这样的人，就这么籍籍无名地消失在教令院之外的地方，真是可惜。"
        },
        {
          "role": "派蒙",
          "text": "赛芭是想到了自己的将来吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请振作起来。",
              "dialogues": [
                {
                  "role": "阿凡",
                  "text": "是啊，孩子，你还有很长的路要走，还有很多事可以做。"
                },
                {
                  "role": "阿凡",
                  "text": "不要被感伤困住，我可不想看到第二个鬼老头出现。"
                }
              ]
            },
            {
              "text": "（不知道该如何劝慰赛芭…）",
              "dialogues": [
                {
                  "role": "阿凡",
                  "text": "别难过，你看，到最后他还是给我们留下了金蔷薇。"
                },
                {
                  "role": "阿凡",
                  "text": "它们还能证明沙法卡特叔叔来过这个世界。"
                }
              ]
            }
          ]
        },
        {
          "role": "赛芭",
          "text": "说的也是，我怎么在这种开心的时候伤感起来了，我们说正事吧。"
        },
        {
          "role": "赛芭",
          "text": "现在这些金蔷薇还只是发了芽，还没有开花。我想一直见证到金蔷薇盛开，你们呢？"
        },
        {
          "role": "旅行者",
          "text": "我也是。"
        },
        {
          "role": "赛芭",
          "text": "那我们多等些时间，让它们汲取一点养分，过一段时间再一起来见证它们盛开吧。"
        },
        {
          "type": "subtitle",
          "text": "「唤醒」种子"
        },
        {
          "role": "阿凡",
          "text": "「蔷薇啊蔷薇，实现我的愿望。」"
        },
        {
          "role": "阿凡",
          "text": "「花从石头中绽放，金蔷薇对我歌唱。」"
        },
        {
          "role": "阿凡",
          "text": "「她唱：」"
        },
        {
          "role": "阿凡",
          "text": "「没有土地承载我，唯有歌谣承载我。」"
        },
        {
          "role": "阿凡",
          "text": "「歌谣战胜敌视我的命运，战胜我的结局。」"
        },
        {
          "role": "阿凡",
          "text": "「战胜我战胜时间，战胜永不消逝的消逝。」"
        },
        {
          "role": "阿凡",
          "text": "这就是沙法卡特叔叔以前教给我们的歌谣。"
        },
        {
          "type": "subtitle",
          "text": "「唤醒」种子"
        },
        {
          "role": "赛芭",
          "text": "试着<color=#00E1FFFF>钝击</color>打破种子的石质外壳吧，然后再用<color=#00E1FFFF>草元素</color>的力量「唤醒」它们。"
        }
      ]
    }
  ]
}