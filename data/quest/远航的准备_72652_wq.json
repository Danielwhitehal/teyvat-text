{
  "quest_id": 72652,
  "chapter_num": null,
  "chapter_title": "远航的准备",
  "type": "wq",
  "route": "Voyage Prep",
  "stories": [
    {
      "story_id": 72652,
      "title": "远航的准备",
      "description": "「南十字船队」的首席技术官似乎有事相托…",
      "dialogues": [
        {
          "role": "？？？",
          "text": "旅行者，你好！最近过得怎样？有没有兴趣给南十字船队帮忙呀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "南十字船队…？",
            "我认识你吗？"
          ]
        },
       
        {
          "role": "？？？",
          "text": "欸…啊哈哈哈哈，抱歉抱歉！"
        },
        {
          "role": "慕珍",
          "text": "我是「死兆星号」的首席技术官慕珍。以往一直呆在船舱里不怎么出来，你不认识我也正常。"
        },
        {
          "role": "慕珍",
          "text": "结果这不是被海龙大哥一脚踢出来了，哈哈。"
        },
        {
          "role": "慕珍",
          "text": "「动动你的懒骨头吧！晒晒太阳又没坏处！」这么说着就把我赶到岸上来了…"
        },
        {
          "role": "慕珍",
          "text": "可是他自己连下船都不敢，一站在陆地上就晕。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这样啊…",
            "有什么需要帮忙的吗？"
          ]
        },
        {
          "role": "慕珍",
          "text": "哦哦，真不好意思。光顾着笑话别人，把正事忘了。"
        },
        {
          "role": "慕珍",
          "text": "为了给北斗大姐头的下一班航程做技术准备，我得拜托你做一些杂活。"
        },
        {
          "role": "慕珍",
          "text": "以往这种事都是大姐头亲自来做的，因为身为「南十字」的总领，要有身先士卒探索未知险境的自觉…"
        },
        {
          "role": "慕珍",
          "text": "这是我们「南十字」的规矩，不论我们当中谁做了老大，都要承担这份义务才行。"
        },
        {
          "role": "慕珍",
          "text": "而且大姐头她在稻妻还有更优先的订单要完成，不能为了这种小事耽误了当前的任务。"
        },
        {
          "role": "派蒙",
          "text": "所以就推给我们咯？"
        },
        {
          "role": "慕珍",
          "text": "嘿嘿，这不是我身为技术官不擅长打架嘛…而且船上的大家都各有各的活干。都忙得很，抽不出身来。"
        },
        {
          "role": "慕珍",
          "text": "行了，闲话不多说啦。事情是这样的——"
        },
        {
          "role": "慕珍",
          "text": "下一趟运单的雇主需要一批样品，就是产自此地的某种特殊遗迹机械的零件。"
        },
        {
          "role": "慕珍",
          "text": "根据雇主交给我们的目击记录分析，那些机械…或是生物，就藏匿在稻妻列岛，非常有趣。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "雇主…？",
              "dialogues": [
        {
          "role": "慕珍",
          "text": "怎么，想打探「南十字」的商业机密？"
        },
        {
          "role": "慕珍",
          "text": "哈哈，不必紧张，如果我知道的话，我也挺乐意告诉你的…不过这在行规上可是「死罪」。"
        },
        {
          "role": "慕珍",
          "text": "所以不好意思咯。雇主是谁我也不知道，对你来说也不重要。"
        }
              ]
            },
            {
              "text": "机械生物…？",
              "dialogues": [
                 {
          "role": "慕珍",
          "text": "…嗯，层岩巨渊的矿工以前也挖出过类似的东西，据说和五百年前的灾难有关。"
        },
        {
          "role": "慕珍",
          "text": "总之都是些…盘桓遗迹的不祥之物，令人生畏，却也令人兴奋…"
        },
        {
          "role": "慕珍",
          "text": "一想到它们就在这里就受不了，真想拆一台来解解手痒…"
        },
        {
          "role": "慕珍",
          "text": "不过你不是技术员，这种心情恐怕不懂啦。"
        }
              ]
            },
            {
              "text": "有趣…？",
              "dialogues": [
                 {
          "role": "慕珍",
          "text": "唔…你就不想亲手拆解一台来试试吗？"
        },
         {
          "role": "派蒙",
          "text": "不是很想…吧？"
        },
         {
          "role": "慕珍",
          "text": "哼，好吧…可能只有技术员才理解我的热情。"
        }
              ]
            }
          ]
        },
        

        {
          "role": "旅行者",
          "text": "它们在哪里？"
        },
        {
          "role": "慕珍",
          "text": "唉，你算是问到点子上了。"
        },
        {
          "role": "慕珍",
          "text": "苦恼的是，我也不知道它们的具体位置在何处。"
        },
        {
          "role": "慕珍",
          "text": "不过在岛上的某些地方，出现了一些奇异的雷元素活动现象。根据我的监测，它们的频率与岛上的其他雷元素活动有很大差异…"
        },
        {
          "role": "慕珍",
          "text": "总之，我认为应该先调查一下那些异常区域，很可能会将结果导向我们的目标。"
        },
        {
          "role": "慕珍",
          "text": "顺便，如果它们会产生什么副产品的话，希望你能带回一些供我研究。"
        },
        {
          "role": "慕珍",
          "text": "放心，报酬我会如数付清的。"
        }
      ]
    }
  ]
}