{
  "quest_id": 20012,
  "chapter_num": null,
  "chapter_title": "此路不通？",
  "type": "iq",
  "route": "Blocked?",
  "stories": [
    {
      "story_id": 20012,
      "title": "此路不通？",
      "description": "米拉娜正在享受难得的散步时光，但是在前往酒庄的路上被路障拦截，遭到丘丘人的围攻。消灭丘丘人，解救米拉娜。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前去查看详请"
        },
        {
          "role": "惊慌的米拉娜",
          "text": "快来救救我！"
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物并摧毁路障"
        },
        {
          "type": "subtitle",
          "text": "与米拉娜对话"
        },
        {
          "role": "惊慌的米拉娜",
          "text": "太感谢你了，旅行者。"
        },
        {
          "role": "惊慌的米拉娜",
          "text": "但请你别和人说我在这遇见麻烦了。不然我肯定又要被我丈夫念叨个不停了。"
        },
        {
          "role": "惊慌的米拉娜",
          "text": "别用这种眼神看着我，等你结了婚就知道，连独自散步都是奢侈的娱乐，所以必须抓紧每分每秒。"
        },
        {
          "role": "惊慌的米拉娜",
          "text": "喏，这个给你，我在路上采了一些，自己做饭可比叫猎鹿人的餐便宜多了。过日子就要这样精打细算。"
        }
      ]
    }
  ]
}