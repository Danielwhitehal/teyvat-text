              "dialogues": [
                {
                  "role": "阿桂",
                  "text": "那你搜集齐了之后，就请尽快拿过来吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与阿桂对话"
        },
        {
          "role": "阿桂",
          "text": "薄荷…薄荷…嗯，这些应该够用了。"
        },
        {
