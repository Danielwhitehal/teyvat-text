{
  "quest_id": 73500,
  "chapter_num": null,
  "chapter_title": "被嫌弃的木刻",
  "type": "wq",
  "route": "The Unappreciated Carving",
  "stories": [
    {
      "story_id": 73500,
      "title": "被嫌弃的木刻",
      "description": "奥摩斯港的集市内，有两位工人面对着一个造型奇特的木刻唉声叹气，也不知道是为什么…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与苦恼的工匠对话"
        },
        {
          "role": "派蒙",
          "text": "奥摩斯港真是一个不错的地方，有许多没有见过的东西，也有许多好吃的。"
        },
        {
          "role": "派蒙",
          "text": "不愧是须弥最大的商港，这里的生意人真多，而且大家都很有精神。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "大概也会有垂头丧气的人。",
            "是派蒙太有精神了。"
          ]
        },
        {
          "role": "马姆杜",
          "text": "唉，事情怎么会这样？"
        },
        {
          "role": "法伊兹",
          "text": "还不是因为你自由发挥，才闹成这幅样子。早知道我就应该劝住你，再等等丹吉尔先生的消息才是。"
        },
        {
          "role": "马姆杜",
          "text": "可是昨天我刚刚雕好这尊「试作兰那罗」的时候，你也觉得小朋友们会喜欢，所以才摆出来试一试呀。"
        },
        {
          "role": "法伊兹",
          "text": "那毕竟…我也没想到小朋友们会这么不喜欢啊。"
        },
        {
          "role": "马姆杜",
          "text": "唉…怎么办呀。"
        },
        {
          "role": "旅行者",
          "text": "烦恼的人出现了。"
        },
        {
          "role": "派蒙",
          "text": "哇，和其他人一比他们真的很垂头丧气的样子，要不我们去看看吧。"
        },
        {
          "role": "派蒙",
          "text": "你们好呀，我是派蒙，他是路过这里的旅行者，请问你们是有什么烦恼吗？"
        },
        {
          "role": "马姆杜",
          "text": "啊…！我刚刚就注意到二位了，欢迎光临阿折罗造像，本店是奥摩斯港最好的玩具商店…至少目前还是…"
        },
        {
          "role": "马姆杜",
          "text": "我们的烦恼来自这尊「试作兰那罗」…首先，能够让我们听一听二位的宝贵意见吗？"
        },
        {
          "role": "派蒙",
          "text": "「试作兰那罗」？指的是这个木刻吗？看起来像是蘑菇变成的怪物呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来像是什么武器的名字。",
              "dialogues": [
                 {
          "role": "马姆杜",
          "text": "不，不，「试作兰那罗」是可以给小朋友们带来欢笑的事物，至少理论上是。"
        }
              ]
            },
            {
              "text": "看起来它不是很开心。",
              "dialogues": [
                 {
          "role": "马姆杜",
          "text": "啊…果然是这样的评价，真头疼。"
        }
              ]
            }      
          ]
        },
       
        {
          "role": "法伊兹",
          "text": "果然也没有得到正面评价。"
        },
        {
          "role": "派蒙",
          "text": "所以这个「试作兰那罗」到底是什么呀？"
        },
        {
          "role": "法伊兹",
          "text": "是这样的，兰那罗是须弥童话中一种居住在森林里的精灵。"
        },
        {
          "role": "法伊兹",
          "text": "本店原来打算在二十周年店庆之际，以小朋友们都喜欢的兰那罗童话为主题，推出兰那罗系列木刻玩具。"
        },
        {
          "role": "法伊兹",
          "text": "这一尊呢，就是我们提前制作的木刻原型，用来测试小朋友们的反应。"
        },
        {
          "role": "法伊兹",
          "text": "只是在原型展示之后…我们收到的意见，和最开始的预期有些许…不同。"
        },
        {
          "role": "派蒙",
          "text": "他们也会觉得这尊「试作兰那罗」很像蘑菇吗？"
        },
        {
          "role": "法伊兹",
          "text": "不，也许更激烈一些…我不太会转述小朋友的话，和他们也聊不到一处去，得拜托你们问问看了。"
        },
        {
          "role": "卡西特",
          "text": "这不是兰那罗！我不承认！"
        },
        {
          "role": "卡西特",
          "text": "我读过丹吉尔叔叔写的《病蕈兽与兰那罗》，那里面说兰那罗都是肉嘟嘟的，看起来很弹弹，这个木刻看起来根本不是这样的！"
        },
        {
          "role": "派蒙",
          "text": "嗯，玩具的话，胖嘟嘟的也许会更加可爱一点。"
        },
        {
          "role": "阿利娅",
          "text": "唔，我想起了丹吉尔叔叔在《兰那罗的誓言》里说过的话：「眼睛也许会被欺骗，但是内心不会。」"
        },
        {
          "role": "阿利娅",
          "text": "看着这个木刻，心里就觉得不是很舒服…感觉作者不用心，我的内心不承认这个是兰那罗。"
        },
        {
          "role": "派蒙",
          "text": "不用心…好像是很多人都会说，但是又很难传达的一个评价。"
        },
        {
          "role": "鲁希",
          "text": "虽然卡西特和阿利娅都挺不喜欢这个木刻的，但是我觉得还好啦。"
        },
        {
          "role": "鲁希",
          "text": "看上去不太高兴的样子，反而会觉得它有点可怜又有点可爱。"
        },
        {
          "role": "派蒙",
          "text": "噢！是正面评价！"
        },
        {
          "role": "鲁希",
          "text": "是的！所以如果它不叫兰那罗的话，我会让爸爸给我买的。"
        },
        {
          "role": "派蒙",
          "text": "欸…突然就变成了很糟糕的评价呢。"
        },
        {
          "role": "派蒙",
          "text": "我们问了小朋友们的意见。"
        },
        {
          "role": "马姆杜",
          "text": "怎么样？他们看久之后会不会…觉得这个木雕顺眼起来了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "很遗憾，没有。",
            "能够理解你们的心情了。"
          ]
        },
        
        {
          "role": "马姆杜",
          "text": "啊——好难过，丹吉尔先生怎么还没有从化城郭回来啊？"
        },
        {
          "role": "派蒙",
          "text": "刚刚小朋友们也一直在说「丹吉尔叔叔」，这个名字听到好几遍了，究竟是什么人呀？"
        },
        {
          "role": "马姆杜",
          "text": "丹吉尔先生是奥摩斯港小有名气的童话作者。"
        },
        {
          "role": "马姆杜",
          "text": "之前他曾经写过十几篇童话故事，但是都和「试作兰那罗」一样，不太受小朋友们的欢迎。"
        },
        {
          "role": "马姆杜",
          "text": "但是从一两年前开始，突然之间，他的灵感就像是绿洲里的泉水一样涌出，每个故事都能吸引很多小朋友去听。"
        },
        {
          "role": "法伊兹",
          "text": "是啊是啊，我家的小加法里也可喜欢他的故事了。就连我们想要推出兰那罗木刻，也正是因为发现了小孩子之间的兰那罗风潮。"
        },
        {
          "role": "法伊兹",
          "text": "本来想拜托丹吉尔先生指导我们，但是他刚答应下来，就带着他家儿子去了化城郭附近取材，一直没有回来。"
        },
        {
          "role": "法伊兹",
          "text": "原来预计开售的日子越来越近，我们没有办法，就只能凭着想象，试着做了一尊木刻。"
        },
        {
          "role": "法伊兹",
          "text": "结果就是这样了，唉…"
        },
        {
          "role": "马姆杜",
          "text": "唉，这样不行啊…"
        },
        {
          "role": "马姆杜",
          "text": "对了，既然你是那位旅行者，能不能帮帮我们，去化城郭找到丹吉尔先生？"
        },
        {
          "role": "马姆杜",
          "text": "他要是忙的话，不用他亲自来，只需要他把建议写在纸条上，再托你带回来就好了。"
        },
        {
          "role": "马姆杜",
          "text": "拜托了，就当是为了小朋友们的笑容。当然，我们也会准备好报酬的！"
        },
        {
          "role": "派蒙",
          "text": "他们看起来真的很着急的样子，旅行者，为了小朋友们的笑容还有报酬，我们帮帮他们吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "好，为了小朋友们的笑容。",
            "好，为了派蒙期待的报酬。"
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，没错！"
        },
        {
          "type": "subtitle",
          "text": "前往化城郭寻找丹吉尔"
        },
        {
          "role": "派蒙",
          "text": "说是丹吉尔先生来了化城郭取材，可是要怎么才能找到他呢？"
        },
        {
          "role": "派蒙",
          "text": "难道要大声喊他的名字？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "听起来不是一个好主意。",
            "也许会吸引到巡林员。"
          ]
        },
      
        {
          "role": "柯莱",
          "text": "小朋友，你叫什么名字？你一个人在这做什么？你不是化城郭的居民吧？"
        },
        {
          "role": "柯莱",
          "text": "不用担心，身为见习巡林员，我会尽力帮助你。"
        },
        {
          "role": "拉齐",
          "text": "你好，巡林员姐姐，我叫拉齐，不用管我，我认识回化城郭的路。"
        },
        {
          "role": "柯莱",
          "text": "那可更不能就这样让你回去了，「不用管我」可是「不用担心我」的同义词。"
        },
        {
          "role": "拉齐",
          "text": "……"
        },
        {
          "role": "拉齐",
          "text": "呜呜…"
        },
        {
          "role": "柯莱",
          "text": "欸，你别哭呀…发生什么事了，可以慢慢和姐姐说。"
        },
        {
          "role": "派蒙",
          "text": "这个声音好熟悉…在哪里听过。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "就在化城郭听过。",
            "是柯莱。"
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦，是柯莱。听起来还有一个很伤心的小朋友，我们去看看吧。"
        },
        {
          "role": "派蒙",
          "text": "你好啊，柯莱！你最近身体还好吗？"
        },
        {
          "role": "柯莱",
          "text": "啊，是派蒙和旅行者！谢谢关心我，我最近状态还不错，正在帮着师父巡林。你们怎么回来了？"
        },
        {
          "role": "派蒙",
          "text": "我们来这里有一些事情，远远听到了你的声音，所以就想找你帮忙。"
        },
        {
          "role": "派蒙",
          "text": "不过你现在好像也很忙…"
        },
        {
          "role": "拉齐",
          "text": "啊…我没事的。巡林员姐姐，你先去帮他们吧。我真的没事，刚刚只是沙子迷了眼睛！"
        },
        {
          "role": "派蒙",
          "text": "（好有礼貌的小朋友。）"
        },
        {
          "role": "旅行者",
          "text": "（肯定不会放着他不管啊。）"
        },
        {
          "role": "柯莱",
          "text": "欸…这里到处都是树，哪里来的沙子。一直说没事，是不是不想让人知道自己难过的原因？"
        },
        {
          "role": "拉齐",
          "text": "……"
        },
        {
          "role": "柯莱",
          "text": "越是这样的事情，就越要说出来才行。"
        },
        {
          "role": "柯莱",
          "text": "姐姐教你一个方法：如果有不想让其他人知道的坏事情，可以统统把这些都讲给树洞听。"
        },
        {
          "role": "拉齐",
          "text": "树洞？"
        },
        {
          "role": "柯莱",
          "text": "对呀，树洞！你听过丹吉尔先生的童话么？居住在森林里的兰那罗们会耐心地听小朋友说完每一句话。"
        },
        {
          "role": "柯莱",
          "text": "没准那些树洞里真的住着兰那罗，能够听到你的诉说。"
        },
        {
          "role": "拉齐",
          "text": "没想到姐姐也喜欢兰那罗！"
        },
        {
          "role": "柯莱",
          "text": "对，我可喜欢兰那罗的童话了。"
        },
        {
          "role": "拉齐",
          "text": "喜欢兰那罗的人都是好人！是要对树洞讲出秘密么…我会试试的！谢谢巡林员姐姐，你懂的好多！"
        },
        {
          "role": "柯莱",
          "text": "嘿嘿…我也没有那么厉害啦，只是受一个朋友影响，看到其他人难过就想努力让他开心起来。"
        },
        {
          "role": "柯莱",
          "text": "怎么样？心情是不是好一点了？森林很危险，先跟着巡林员姐姐一起走吧。"
        },
        {
          "role": "拉齐",
          "text": "好！"
        },
        {
          "role": "派蒙",
          "text": "哇，没想到柯莱安抚小孩子很有一套嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "真是负责任的巡林员。",
            "感觉处理起这种事得心应手。"
          ]
        },
        
        {
          "role": "柯莱",
          "text": "是的，帮助在雨林里迷路的小朋友们找到回家的路，也是巡林员的职责之一哦。"
        },
        {
          "role": "柯莱",
          "text": "那么，刚刚提到的帮忙是什么？难道你们也迷路了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "不不不。",
            "甚至想要去树林深处。"
          ]
        },
       
        {
          "type": "subtitle",
          "text": "向柯莱讲述了阿折罗造像员工们的困扰。"
        },
        {
          "role": "柯莱",
          "text": "嗯，找到来自奥摩斯港，到化城郭取材的童话作者丹吉尔先生…"
        },
        {
          "role": "柯莱",
          "text": "等等，莫非这个丹吉尔先生就是那个丹吉尔先生？"
        },
        {
          "role": "派蒙",
          "text": "没错，就是那个丹吉尔先生！"
        },
        {
          "role": "柯莱",
          "text": "他就在附近？为新的童话故事寻找素材？"
        },
        {
          "role": "柯莱",
          "text": "太好了，你们可以稍等我一会儿吗？等我把拉齐送回化城郭，就立刻回来帮你们。"
        },
        {
          "role": "柯莱",
          "text": "我一直在好奇，到底是什么样的人，才能创作出那么有意思的童话。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说不定是经常被关禁闭的骑士。",
              "dialogues": [
                
              ]
            },
            {
              "text": "说不定是一家大商会的少爷。",
              "dialogues": []
            },
            {
              "text": "说不定是小吉祥草王的眷属。",
              "dialogues": []
            }          
          ]
        },
         {
          "role": "拉齐",
          "text": "丹吉尔…他是一个普通人。"
        },
        {
          "role": "柯莱",
          "text": "即便他是普通人，那也肯定是有趣的普通人。"
        },
        {
          "role": "柯莱",
          "text": "等等！拉齐，你这么说，难道是见过丹吉尔？"
        },
        {
          "role": "拉齐",
          "text": "嗯…他是我的爸爸。"
        },
        {
          "role": "派蒙",
          "text": "爸爸？！等等…也就是说，他是你的爸爸，你是他的儿子？"
        },
        {
          "role": "拉齐",
          "text": "是的。"
        },
        {
          "role": "派蒙",
          "text": "对哦，那位阿折罗造像的雕刻师说过，丹吉尔是带着他的孩子一起来取材的，原来说的就是拉齐。"
        },
        {
          "role": "派蒙",
          "text": "不过为什么拉齐会在这里？难道是和丹吉尔先生走散了？"
        },
        {
          "role": "拉齐",
          "text": "我…我和他吵架了…有些难过，所以才一个人跑到这里…"
        },
        {
          "role": "柯莱",
          "text": "啊，那么是不是先带你回化城郭比较好？我们再去找他，转告他你在哪里。"
        },
        {
          "role": "拉齐",
          "text": "不用啦。因为柯莱姐姐的话，我已经不那么难过了。"
        },
        {
          "role": "拉齐",
          "text": "跟我来吧，我带你们去找他。"
        },
        {
          "role": "派蒙",
          "text": "好耶！本来以为要在森林里找好久，没想到这么快就找到了。"
        },
        {
          "role": "旅行者",
          "text": "好耶！"
        },
        {
          "role": "柯莱",
          "text": "啊…居然真的能见到丹吉尔先生！"
        },
         {
          "role": "拉齐",
          "text": "……"
        },
         {
          "type": "subtitle",
          "text": "跟随拉齐寻找丹吉尔"
        },
        {
          "type": "subtitle",
          "text": "与丹吉尔对话"
        },
      
        {
          "role": "丹吉尔",
          "text": "啊，拉齐！可找到你了。如果没有你，我该怎么办呐。"
        },
        {
          "role": "丹吉尔",
          "text": "你有没有遇到危险？野兽有没有让你失措惊惶？星辰有没有为你指明方向？"
        },
        {
          "role": "拉齐",
          "text": "我没事…是他们帮助了我。"
        },
        {
          "role": "丹吉尔",
          "text": "原来是这样。谢谢，谢谢你们！我敢说，哪怕是心肠最冰冷的棘冠鳄都会因为你们的热情而动情落泪。"
        },
        {
          "role": "柯莱",
          "text": "没什么，身为见习巡林员，这些都是我应该做的。也谢谢您一直为须弥的小朋友们创作了那么多童话故事。我…我很喜欢！"
        },
        {
          "role": "丹吉尔",
          "text": "哦？没想到除了小朋友以外，还有大朋友也喜欢我的童话。说明你也有一颗纯真的童心啊！"
        },
        {
          "role": "丹吉尔",
          "text": "嗯，不错，下一则童话有灵感了，那即是——拥有童心的兰那罗奶奶！"
        },
        {
          "role": "柯莱",
          "text": "……！"
        },
        {
          "role": "柯莱",
          "text": "能…能成为您灵感的来源，是我的荣幸！"
        },
        {
          "role": "派蒙",
          "text": "哇，柯莱一副快要晕过去的样子…是身体不舒服么？"
        },
        {
          "role": "柯莱",
          "text": "啊，没事。不好意思，我有点过于激动了。"
        },
        {
          "role": "丹吉尔",
          "text": "那么，你们二位也是我的读者吗？嗯…一看到你们，我的脑内已经出现了一位兰巨人和一只兰团雀结伴旅行的画面！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我们受人所托，请你帮忙。",
            "我们就是兰巨人和兰团雀！"
          ]
        },
        
        {
          "role": "丹吉尔",
          "text": "哦？是哪位？我的读者遍布须弥，请原谅我记忆有限，难以从无垠沙海中找出无法辨识的一捧。"
        },
        {
          "role": "派蒙",
          "text": "唔…听这位丹吉尔先生说话，会让人觉得，童话有点被小看了。"
        },
        {
          "role": "派蒙",
          "text": "而且，把别人比喻成团雀好像没有那么值得激动吧。"
        },
        {
          "role": "旅行者",
          "text": "玩笑话放一边，姑且先聊正事吧。"
        },
        {
          "type": "subtitle",
          "text": "向丹吉尔讲述了阿折罗造像员工们的困扰。"
        },
        {
          "role": "丹吉尔",
          "text": "阿折罗造像…阿折罗造像…"
        },
        {
          "role": "丹吉尔",
          "text": "哦对，哦对对对！我想起来了，确实有这么一条小船曾经闯进了我的记忆之海，但是它又在不经意间远航。"
        },
        {
          "role": "丹吉尔",
          "text": "毕竟，名为丹吉尔的港湾中，出现了更加迅猛的风暴。"
        },
        {
          "role": "派蒙",
          "text": "呃啊…我完全没听懂他在说什么…"
        },
        {
          "role": "旅行者",
          "text": "我也没听懂…"
        },
        {
          "role": "派蒙",
          "text": "唔，这可怎么办，要带他找提纳里治疗么？"
        },
        {
          "role": "拉齐",
          "text": "爸爸的意思是，他之前把要帮阿折罗造像的人了解兰那罗这件事给忘了，但现在眼前有更重要的事情要做。"
        },
        {
          "role": "派蒙",
          "text": "原来如此…真不愧是丹吉尔先生的儿子，能听懂这么奇怪的话。"
        },
        {
          "role": "派蒙",
          "text": "不对，现在不是感叹的时候。这件事对于那两位雕刻师很重要，丹吉尔先生，你一定要帮帮他们。"
        },
        {
          "role": "丹吉尔",
          "text": "可是，我眼前的繁茂花园更加重要，关乎须弥所有小朋友梦中的美丽帕蒂沙兰——"
        },
        {
          "role": "丹吉尔",
          "text": "我，丹吉尔，在这道成林中，发现了兰那罗留下的痕迹！这无疑证明了兰那罗并非只存在于童话之中，更存在于你我身边！"
        },
        {
          "role": "丹吉尔",
          "text": "如果真的记录下了兰那罗的外形，那么阿折罗造像的小小绳结将会轻松解开。"
        },
        {
          "role": "丹吉尔",
          "text": "而我，说不定能够借此良机擢升教令院高位，让全须弥人都知道小小的奥摩斯港竟然住着一位大大的丹吉尔！"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "拉齐",
          "text": "…唉。"
        },
        {
          "role": "柯莱",
          "text": "呃…那个…"
        },
        {
          "role": "柯莱",
          "text": "虽然我没有写过，但是我知道，想要加入教令院的话，需要有足够多被评审机构认可的论文，并且还需要有详细客观的实验记录。"
        },
        {
          "role": "柯莱",
          "text": "丹吉尔先生刚刚提到「发现了兰那罗留下的痕迹」，是什么呢？"
        },
        {
          "role": "丹吉尔",
          "text": "创作故事，重要的是留下钓钩，直接喂下饵食不符合我童话作者的做派，跟我来！"
        },
        {
          "role": "柯莱",
          "text": "啊！那个方向是…"
        },
        {
          "role": "派蒙",
          "text": "柯莱，怎么了？"
        },
        {
          "role": "柯莱",
          "text": "没什么，那个方向是道成林的深处，我担心丹吉尔先生遇到危险。"
        },
        {
          "role": "柯莱",
          "text": "然后，我好像能够理解为什么拉齐会和丹吉尔先生吵架了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "（也许另有隐情。）",
            "（这就是拉齐不想说的秘密吧…）"
          ]
        },
        {
          "type": "subtitle",
          "text": "跟随丹吉尔"
        },
        {
          "type": "subtitle",
          "text": "与丹吉尔对话"
        },
        {
          "role": "丹吉尔",
          "text": "果然不出我所料，对童话果实的祈望驱使你们随我而至。"
        },
        {
          "role": "派蒙",
          "text": "这里看起来只是普通的树洞，没有什么兰那罗的痕迹呀。"
        },
        {
          "role": "丹吉尔",
          "text": "不，「眼睛也许会被欺骗，但是内心不会。」用心去看，你们也会有所收获的。"
        },
        {
          "role": "派蒙",
          "text": "唔…虽然不明白什么叫做用心去看，不过旅行者，我们先在树洞周围调查看看吧。"
        },
        {
          "type": "subtitle",
          "text": "寻找「兰那罗痕迹」"
        },
        {
          "role": "派蒙",
          "text": "啊，这里贴着一张纸条，是不是丹吉尔先生说的「兰那罗痕迹」？"
        },
        {
          "role": "派蒙",
          "text": "呃，好难认的笔迹，「好难，根本记不住这么多种蘑菇」？"
        },
        {
          "role": "派蒙",
          "text": "兰那罗需要学习蘑菇分类吗？"
        },
        {
          "role": "派蒙",
          "text": "又有一张纸条，上面写的是「这个树洞就是我的城堡」。"
        },
        {
          "role": "派蒙",
          "text": "确实像是童话里兰那罗会说出来的话呢。"
        },
        {
          "role": "派蒙",
          "text": "这里也有！嗯…「如果我是一只聪明的兰那罗就好了」。"
        },
        {
          "role": "派蒙",
          "text": "「聪明的兰那罗」，重点到底是「聪明」还是「兰那罗」呢？"
        },
        {
          "type": "subtitle",
          "text": "与丹吉尔对话"
        },
        {
          "role": "丹吉尔",
          "text": "见证划时代发现的感觉如何？很不错吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "哪里有划时代的发现？",
            "看起来像是小朋友的留言。"
          ]
        },
        
        {
          "role": "丹吉尔",
          "text": "这些稚嫩的笔迹确实很像是小朋友留下的，但是不要忘了这里可是雨林正中啊。"
        },
        {
          "role": "丹吉尔",
          "text": "我想，是不会有小朋友能够到达这样幽深的树林的，更不会觉得这个简陋的树洞如同城堡一样坚不可摧。"
        },
        {
          "role": "丹吉尔",
          "text": "所以，我大胆推测，这里是兰那罗的教令院，而这些纸条毫无疑问出自兰那罗的手笔。"
        },
        {
          "role": "丹吉尔",
          "text": "正是一只不太聪明的兰那罗，许下了成为「聪明兰那罗」的愿望，留在了这里。"
        },
        {
          "role": "丹吉尔",
          "text": "我愿意为他创作一则新的童话，就叫做「树洞里的兰那罗」！"
        },
        {
          "role": "丹吉尔",
          "text": "怎么样，现在你们的眼前是不是也仿佛出现了兰那罗的身影？"
        },
        {
          "role": "派蒙",
          "text": "没有…"
        },
        {
          "role": "旅行者",
          "text": "完全没有…"
        },
        {
          "role": "丹吉尔",
          "text": "啊，很多冒险家的背后只有看得见的风之翼，没有看不见的想象之翼，所以他们很难跟上我的思维。"
        },
        {
          "role": "丹吉尔",
          "text": "那么，这位巡林员小姐的背后，有没有想象之翼呢？"
        },
        {
          "role": "柯莱",
          "text": "啊？！我？我不知道…也许可能有吧，也许可能没有，反正和…和我没什么…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "柯莱你怎么了？",
            "身体真的没有不舒服吗？"
          ]
        },
       
        {
          "role": "柯莱",
          "text": "不，我没事，我只是直接见到丹吉尔先生的创作过程，有点…有点…"
        },
        {
          "role": "丹吉尔",
          "text": "震撼？"
        },
        {
          "role": "柯莱",
          "text": "对对对，震撼。"
        },
        {
          "role": "丹吉尔",
          "text": "总之，我已经做了决定，会和拉齐在这里等待兰那罗的出现，等待着见证树洞里的奇迹。"
        },
        {
          "role": "丹吉尔",
          "text": "放心，我不会让阿折罗造像的委托落空的。只要真正的兰那罗出现了，这点小问题还算得了什么？算不了什么的。"
        },
        {
          "role": "派蒙",
          "text": "唔，他好固执，不过看起来我们只能在这里再等一等了。"
        },
        {
          "role": "柯莱",
          "text": "不，我觉得我们还是回到刚才的营地比较好。"
        },
        {
          "role": "柯莱",
          "text": "丹吉尔先生，《病蕈兽与兰那罗》里有说：兰那罗是非常敏感的生灵，如果我们一直在这里的话，他们很可能是不会靠近的。"
        },
        {
          "role": "丹吉尔",
          "text": "啊？有这一段吗？哦对…确实有这样的描述。真不愧是巡林员小姐，直击要害！"
        },
        {
          "role": "丹吉尔",
          "text": "那么我们就先回营地休息，等到明日晨曦初启，再来寻找新的证据。"
        },
        {
          "type": "subtitle",
          "text": "在夜间前往营地"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "旅行者，旅行者，快醒醒。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "怎么了？",
            "兰那罗出现了吗？"
          ]
        },
        
        {
          "role": "派蒙",
          "text": "不是兰那罗。是柯莱…柯莱她不在营地里！"
        },
        {
          "role": "派蒙",
          "text": "我昨晚就有点担心她，虽然她说自己没有不舒服，可好像在看到那些树洞里的「兰那罗痕迹」之后，就变得不太对劲。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我也注意到了。",
            "可能丹吉尔先生吓到她了。"
          ]
        },
        {
          "role": "派蒙",
          "text": "总之，我们去找她吧。"
        },
        {
          "type": "subtitle",
          "text": "寻找柯莱"
        },
        {
          "type": "subtitle",
          "text": "寻找接近树洞并观察"
        },
        {
          "role": "派蒙",
          "text": "原来柯莱一个人又回到了这里，难道她是想要在这里等着兰那罗出现？"
        },
        {
          "role": "柯莱",
          "text": "呜，还以为没人知道这个地方呢，没想到会被丹吉尔先生发现，还正好撞上旅行者和派蒙…"
        },
        {
          "role": "柯莱",
          "text": "呜呜…早知道这样，应该只用嘴巴说给树洞听，不该写下来！要想练字，肯定有更好的素材啊…"
        },
        {
          "role": "柯莱",
          "text": "现在还添了新的烦恼，我要不要假装成真的兰那罗…"
        },
        {
          "role": "柯莱",
          "text": "不对，不对，现在应该做的是，写下绝对不会被当作兰那罗的留言才对。这样一来丹吉尔先生就不会被误导了吧…"
        },
        {
          "role": "柯莱",
          "text": "写什么好呢…写什么好呢？"
        },
        {
          "role": "柯莱",
          "text": "对了，写这个的话，就一定不会被当作兰那罗了。"
        },
        {
          "role": "派蒙",
          "text": "噢！原来白天见到的那些「兰那罗痕迹」，其实是「柯莱痕迹」。"
        },
        {
          "role": "派蒙",
          "text": "不过，她为什么没有直接告诉丹吉尔先生呢？"
        },
        {
          "role": "旅行者",
          "text": "这是她的秘密吧。"
        },
        {
          "role": "派蒙",
          "text": "对哦，我想起来了：她和拉齐说，可以找树洞讲出秘密。原来她自己也是这么做的，甚至还写下来了。"
        },
        {
          "role": "旅行者",
          "text": "柯莱有柯莱的理由。"
        },
        {
          "role": "派蒙",
          "text": "好…好吧，我们就先帮她保守秘密。"
        },
        {
          "role": "派蒙",
          "text": "她好像快写完了，我们也回去吧。"
        },
        {
          "type": "subtitle",
          "text": "等待至第二天白天"
        },
        {
          "type": "subtitle",
          "text": "与丹吉尔对话"
        },
        {
          "role": "丹吉尔",
          "text": "啊哈！果然如同我预想的一样，出现了新的纸条。"
        },
        {
          "role": "丹吉尔",
          "text": "嗯，嗯嗯！同样的字迹，应该是同一只兰那罗留下的。"
        },
        {
          "role": "丹吉尔",
          "text": "让我看看，上面写着什么呢？"
        },
        {
          "role": "派蒙",
          "text": "写着什么呢？"
        },
        {
          "role": "旅行者",
          "text": "好好奇哦！"
        },
        {
          "role": "丹吉尔",
          "text": "……？！"
        },
        {
          "role": "丹吉尔",
          "text": "「好想再参加一次蒙德的羽球节」？"
        },
        {
          "role": "丹吉尔",
          "text": "不，不可能！这一定是恶作剧！兰那罗怎么可能去蒙德参加什么羽球节？"
        },
        {
          "role": "丹吉尔",
          "text": "即便在童话里也不会出现这样的情节！"
        },
        {
          "role": "派蒙",
          "text": "也就是说，这些纸条根本不是兰那罗留下来的。"
        },
        {
          "role": "柯莱",
          "text": "是的！我觉得，很可能是路过附近的蒙德商人留下的，而不是兰那罗。"
        },
        {
          "role": "丹吉尔",
          "text": "不，我不相信！"
        },
        {
          "type": "subtitle",
          "text": "尽管丹吉尔说着不相信，但是在现实面前，也陷入了长久的沉默。"
        },
        {
          "role": "丹吉尔",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "救救阿折罗造像。"
        },
        {
          "role": "丹吉尔",
          "text": "办不到…"
        },
        {
          "role": "派蒙",
          "text": "办不到是什么回答啦！明明只要花一点时间就可以了。"
        },
        {
          "role": "柯莱",
          "text": "是的，既然丹吉尔先生能创作出受小朋友们欢迎的童话，就一定也能创造出同样受欢迎的木刻。"
        },
        {
          "role": "旅行者",
          "text": "我也相信丹吉尔先生。"
        },
        {
          "role": "丹吉尔",
          "text": "就是办不到！"
        },
        {
          "role": "丹吉尔",
          "text": "原来我以为真的可以找到兰那罗，这样就可以帮到阿折罗造像了。"
        },
        {
          "role": "丹吉尔",
          "text": "谁知道…谁知道居然只是一个蒙德人。"
        },
        {
          "role": "柯莱",
          "text": "可是，你之前创作童话的时候，也没有真的见过兰那罗，为什么这次却不一样了呢？"
        },
        {
          "role": "丹吉尔",
          "text": "我…我…"
        },
        {
          "role": "丹吉尔",
          "text": "唉，算了。拉齐，你来告诉大家吧。"
        },
        {
          "role": "拉齐",
          "text": "欸？真的可以吗？"
        },
        {
          "role": "丹吉尔",
          "text": "嗯，没关系，说吧，我知道你其实等这一刻等了很久。"
        },
        {
          "role": "拉齐",
          "text": "好。"
        },
        {
          "role": "拉齐",
          "text": "柯莱姐姐，旅行者哥哥，还有派蒙，你们还记得吗？我说过我有一个不想让其他人知道的秘密。"
        },
        {
          "role": "旅行者",
          "text": "嗯，记得。"
        },
        {
          "role": "拉齐",
          "text": "我真的很不想说出这个秘密，但是它让我很难过，也让爸爸变了一个人。"
        },
        {
          "role": "拉齐",
          "text": "所以我觉得我应该说出来："
        },
        {
          "role": "拉齐",
          "text": "我的爸爸，其实并不是那些兰那罗童话的作者。"
        },
        {
          "role": "柯莱",
          "text": "什么？可如果不是丹吉尔先生…那到底是谁创作了那些故事？莫非…"
        },
        {
          "role": "拉齐",
          "text": "是我。"
        },
        {
          "role": "拉齐",
          "text": "在我很小的时候，爸爸就在奥摩斯港里讲故事了，而我永远能听到他的新故事。"
        },
        {
          "role": "拉齐",
          "text": "每天晚上，爸爸就会往我手里塞一个墩墩桃，我一边吃，他一边讲。"
        },
        {
          "role": "拉齐",
          "text": "墩墩桃虽然很甜，但是爸爸的故事却很糟糕，因为他很喜欢用很难懂的句子，还有那种…唔，叫做比喻的东西。"
        },
        {
          "role": "拉齐",
          "text": "不过爸爸还是一遍又一遍地和我讲他的童话，有时候还会借来桑歌玛哈巴依老爷店里的留影机，让我拍下他讲故事时的样子。"
        },
        {
          "role": "拉齐",
          "text": "爸爸指着留影对我说，这就是未来须弥童话大王的宝贵活动记录。"
        },
        {
          "role": "拉齐",
          "text": "那时候虽然每天只能吃墩墩桃，听着并不有趣的故事，不过也挺开心的。"
        },
        {
          "role": "拉齐",
          "text": "直到有一天，我试着给爸爸讲了一个我自己想的故事。"
        },
        {
          "role": "拉齐",
          "text": "爸爸听到那个故事的开头后，好像非常非常激动。"
        },
        {
          "role": "拉齐",
          "text": "他先是很开心很开心，用双手把我举得很高很高，让我继续讲。"
        },
        {
          "role": "拉齐",
          "text": "我被他举过头顶，低下头看着他，继续讲故事，在我的影子里，他看我的眼神好像渐渐地变了。"
        },
        {
          "role": "拉齐",
          "text": "而当我讲到我最满意的地方的时候，爸爸哭了。我觉得，爸爸是被我的故事感动了吧。"
        },
        {
          "role": "拉齐",
          "text": "当爸爸把我放下时，我的故事刚好结束，而我再仰头看，发现他的眼神有点让人害怕…"
        },
        {
          "role": "派蒙",
          "text": "你记得好清楚…"
        },
        {
          "role": "丹吉尔",
          "text": "不要说是拉齐，我也从来没有忘记过那一天发生的事情。"
        },
        {
          "role": "丹吉尔",
          "text": "在那之后，我如愿以偿成为了须弥最好的童话作者，开始有了一些名气，有了一些小钱。"
        },
        {
          "role": "丹吉尔",
          "text": "每天的晚餐也不再只有一个墩墩桃…"
        },
        {
          "role": "丹吉尔",
          "text": "我以为拉齐会高兴。"
        },
        {
          "role": "拉齐",
          "text": "我一开始是很高兴啦，可是渐渐地，大家都开始只叫我「丹吉尔先生的儿子」，而不叫我「拉齐」了。"
        },
        {
          "role": "拉齐",
          "text": "我大概是知道为什么，但是又不太敢相信。"
        },
        {
          "role": "拉齐",
          "text": "而爸爸也开始越来越忙，开始忙一些不是童话的事情，比如说阿折罗造像的委托。"
        },
        {
          "role": "拉齐",
          "text": "所以，我下了决心，至少这一次，我希望我是「拉齐」，也希望爸爸能够回到之前的样子。"
        },
        {
          "role": "拉齐",
          "text": "比起现在这个每个故事的开头都是「献给最亲爱的拉齐」的爸爸…"
        },
        {
          "role": "拉齐",
          "text": "我还是更喜欢那个，结结巴巴，不知道怎么给故事一个好结局的爸爸。"
        },
        {
          "role": "拉齐",
          "text": "所以，我打算不再告诉爸爸，我脑子里的兰那罗究竟是什么样的。"
        },
        {
          "role": "派蒙",
          "text": "等等等等，我终于想明白了。"
        },
        {
          "role": "派蒙",
          "text": "也就是说，丹吉尔先生创作的那些童话，实际上的作者是拉齐。"
        },
        {
          "role": "派蒙",
          "text": "而拉齐不想看到丹吉尔先生…在谎言里越走越远，所以拒绝了帮助丹吉尔先生完成阿折罗造像的委托？"
        },
        {
          "role": "丹吉尔",
          "text": "…没错，所以我才会到这附近寻找兰那罗出没的痕迹，没想到却还是和以前一样，只能成为一段不好笑的笑料…"
        },
        {
          "role": "丹吉尔",
          "text": "我不是一个称职的爸爸。"
        },
        {
          "role": "丹吉尔",
          "text": "对不起，拉齐，对不起…"
        },
        {
          "role": "丹吉尔",
          "text": "也要对你们说对不起，害你们白忙了这么久。"
        },
        {
          "role": "丹吉尔",
          "text": "真正能帮阿折罗造像的是拉齐，你们试着说服他吧。我现在只想找一个安静的树洞待着。"
        },
        {
          "role": "派蒙",
          "text": "欸…这样真的好吗？"
        },
        {
          "role": "旅行者",
          "text": "让拉齐自己决定吧。"
        },
        {
          "role": "拉齐",
          "text": "让我来帮助阿折罗造像吗？"
        },
        {
          "role": "拉齐",
          "text": "故事里确实提到过兰那罗的样子，可是做成木刻的话，应该要更详细的描述…"
        },
        {
          "role": "拉齐",
          "text": "柯莱姐姐，旅行者哥哥，派蒙，我可能会需要你们的帮助，你们愿意帮我吗？"
        },
        {
          "role": "拉齐",
          "text": "之前我一直住在奥摩斯港，都没怎么离开过，这次被爸爸带着来化城郭取材是我第一次出远门。"
        },
        {
          "role": "拉齐",
          "text": "我才知道须弥原来比我想象中还要大这么多，又想到了更多的兰那罗的童话。"
        },
        {
          "role": "拉齐",
          "text": "所以，我想，为了能够制作出小朋友们都喜欢的兰那罗木刻。我想再去须弥的其他地方看一看。"
        },
        {
          "role": "拉齐",
          "text": "并且，我也希望能再有机会给爸爸在各种地方，拍许多许多相片。"
        },
        {
          "role": "丹吉尔",
          "text": "嗯？你是说，想让我继续陪你？哪怕爸爸之前做了…那么过分的事情？"
        },
        {
          "role": "拉齐",
          "text": "当然！毕竟你是我最喜欢的爸爸呀。"
        },
        {
          "role": "柯莱",
          "text": "感觉这是认识拉齐到现在，他说出的最开心的一句话。"
        },
        {
          "role": "拉齐",
          "text": "我也想要谢谢你，柯莱姐姐。"
        },
        {
          "role": "柯莱",
          "text": "咦？我？我…什么忙都没帮上呀。"
        },
        {
          "role": "拉齐",
          "text": "是你告诉我，有不想让人知道的秘密的话，可以讲给树洞听。"
        },
        {
          "role": "拉齐",
          "text": "虽然我还没有来得及找到树洞，不过把秘密讲出来以后，确实轻松了许多许多。"
        },
        {
          "role": "柯莱",
          "text": "嗯…是的，一个人是很难承载太多秘密的。并且，也不用真的把过错当做永远无法见人的一面藏起来。"
        },
        {
          "role": "柯莱",
          "text": "曾经我在蒙德的时候也犯过错误，但是现在回头去看，对我来说那更像是一个新的起点。"
        },
        {
          "role": "柯莱",
          "text": "我相信对于丹吉尔先生来说，这次的经历也是一样的。"
        },
        {
          "role": "丹吉尔",
          "text": "嗯，我会努力重新做一个好爸爸的。"
        },
        {
          "role": "丹吉尔",
          "text": "等等，你刚刚说你去过蒙德…？"
        },
        {
          "role": "柯莱",
          "text": "啊啊啊，只是路过，路过而已！别管这些了，阿折罗造像的员工还在等着我们呢。"
        },
        {
          "role": "柯莱",
          "text": "走，拉齐，我们带上留影机，为了藏在须弥各处地方的灵感，出发！"
        },
        {
          "role": "拉齐",
          "text": "好，我们出发！爸爸快跟上！"
        },
        {
          "role": "丹吉尔",
          "text": "拉齐，别跑太快了，当心脚下。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "大家都好有精神。",
            "我们也出发吧！"
          ]
        },
      
        {
          "role": "派蒙",
          "text": "好耶！"
        }
      ]
    }
  ]
}