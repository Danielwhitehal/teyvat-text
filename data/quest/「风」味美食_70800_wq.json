{
  "quest_id": 70800,
  "chapter_num": null,
  "chapter_title": "「风」味美食",
  "type": "wq",
  "route": "Flavor of the Month",
  "stories": [
    {
      "story_id": 70800,
      "title": "「风」味美食",
      "description": "",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "布洛克",
          "text": "其实我正打算配合风花节开发一道新菜，主推「风的味道」，现在正在准备食材呢。"
        },
        {
          "role": "布洛克",
          "text": "不过，我明明拜托了艾伦帮我去明冠峡猎最新鲜的肉，怎么这么久了他还没回来…"
        },
        {
          "role": "布洛克",
          "text": "再拖下去，说不定那些食材都要不新鲜了，旅行者，能拜托你去明冠峡那边看看吗？"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "布洛克",
          "text": "那就辛苦你了，回头请你尝尝我的最新菜品！"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "布洛克",
          "text": "你是…我记得你，你是香菱的那位助手，对吧？"
        },
        {
          "role": "布洛克",
          "text": "上次的对决真是让人印象深刻，我现在还记忆犹新呢。"
        },
        {
          "role": "布洛克",
          "text": "虽然上次我输给了香菱，但这一次，我决定要研究出一道带有「风的味道」的菜。然后，用这道菜再和香菱一决胜负！"
        },
        {
          "role": "布洛克",
          "text": "为了这道菜，我还特地去拜托了一位冒险家，帮我去雪山里取一些「冷鲜肉」回来。"
        },
        {
          "role": "布洛克",
          "text": "但那位叫做舒特的冒险家，到现在还没有回来…"
        },
        {
          "role": "布洛克",
          "text": "我听说雪山里十分危险，那位冒险家不会是遇到什么危险了吧…你能帮我去找找他吗？"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "布洛克",
          "text": "你愿意帮忙那真是太好了，雪山的气候严寒，记得随时生火取暖啊。"
        },
        {
          "role": "艾伦",
          "text": "得，得救了…真是太谢谢了。"
        },
        {
          "role": "艾伦",
          "text": "真没想到，就是猎个林猪也能这么麻烦…"
        },
        {
          "role": "旅行者",
          "text": "关于布洛克要的食材…"
        },
        {
          "role": "艾伦",
          "text": "是布洛克让你来的？啊…其实她要的新鲜兽肉，我已经弄到了。"
        },
        {
          "role": "艾伦",
          "text": "不过我追林猪的时候太大意，一不小心就惊动了附近的魔物…"
        },
        {
          "role": "艾伦",
          "text": "虽然林猪是猎到了，但我也被魔物们给围住了…"
        },
        {
          "role": "艾伦",
          "text": "旅行者，能拜托你把这些肉送给布洛克吗，我要先去城里，拜托教会那边治疗一下我的伤…"
        },
        {
          "role": "艾伦",
          "text": "唉，又搞成这个样子，杜拉夫先生肯定又要说我了…"
        },
        {
          "role": "布洛克",
          "text": "啊，你们来了吗，兽肉准备的怎么样了？"
        },
        {
          "role": "旅行者",
          "text": "已经带来了。"
        },
        {
          "role": "布洛克",
          "text": "嗯，我来看看…确实很新鲜，这样应该就可以了。主料就用这些兽肉，再准备一点有「风的味道」的辅料就好…"
        },
        {
          "role": "布洛克",
          "text": "唔，说到带有「风的味道」的辅料…那当然就是「蒲公英籽」了。"
        },
        {
          "role": "布洛克",
          "text": "旅行者，你能帮我去收集一点蒲公英籽吗？"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "布洛克",
          "text": "那就麻烦你了，我先去处理一下兽肉，搜集好蒲公英籽之后，就直接拿来给我吧。"
        },
        {
          "role": "布洛克",
          "text": "你准备好蒲公英籽了吗？"
        },
        {
          "role": "布洛克",
          "text": "谢谢，这下材料就都准备好了。"
        },
        {
          "role": "布洛克",
          "text": "辛苦你了，这些东西请你收下吧，就算是报酬了。"
        },
        {
          "role": "布洛克",
          "text": "不过要怎么处理，才能让整道菜都带上「风的味道」呢？"
        },
        {
          "role": "布洛克",
          "text": "蒸煮煎炸…唔…不然，还是以食材的原味为主，在整道菜出锅之后再把蒲公英籽撒上去吧…"
        },
        {
          "role": "害怕的舒特",
          "text": "冷，冷…怎么这么冷…"
        },
        {
          "role": "害怕的舒特",
          "text": "谁，谁…谁能帮忙生一下火吗…"
        },
        {
          "role": "害怕的舒特",
          "text": "活，活过来了…"
        },
        {
          "role": "害怕的舒特",
          "text": "是你生的火吗…好心的旅行者…谢谢你，多谢你了…"
        },
        {
          "role": "旅行者",
          "text": "你还好吗？"
        },
        {
          "role": "害怕的舒特",
          "text": "现在暖和点了，还好…还好…我本来是接到委托，进雪山取那种「冷鲜肉」…"
        },
        {
          "role": "害怕的舒特",
          "text": "我最开始就是想在雪山外围找找看就好，但是走着走着不小心弄丢了火种，又不小心迷了路…"
        },
        {
          "role": "害怕的舒特",
          "text": "要是没有你，我都不知道怎么办才好了，多谢你了。"
        },
        {
          "role": "旅行者",
          "text": "关于布洛克的委托…"
        },
        {
          "role": "害怕的舒特",
          "text": "是布洛克拜托你找我的，唉…她肯定已经等急了。但我实在没体力把这份肉再大老远送回镇上了…"
        },
        {
          "role": "害怕的舒特",
          "text": "虽然很不好意思，但能请你帮我把这份「冷鲜肉」送过去吗？"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "害怕的舒特",
          "text": "多谢你了。我得回山下的营地去，好好喝口热汤…"
        },
        {
          "role": "布洛克",
          "text": "你们回来了？"
        },
        {
          "role": "旅行者",
          "text": "肉已经带回来了。"
        },
        {
          "role": "布洛克",
          "text": "那太好了！欸？舒特呢…他没遇见危险吧？"
        },
        {
          "role": "旅行者",
          "text": "他应该已经没事了。"
        },
        {
          "role": "布洛克",
          "text": "那就好，幸好没有出大事…等我把新菜做好了之后，也带过去给他尝尝吧。"
        },
        {
          "role": "布洛克",
          "text": "话说回来，这「冷鲜肉」看着确实和普通肉类不一样，用这个做材料，说不定真能做出那种有「噼咔」感的菜…"
        },
        {
          "role": "布洛克",
          "text": "不过，要想让菜带有「风的味道」的话，还需要蒲公英籽来做辅料…"
        },
        {
          "role": "布洛克",
          "text": "但如果只是这样的话，感觉跟普通的肉类菜品也没有很大区别，还少一种决定性的辅料。"
        },
        {
          "role": "布洛克",
          "text": "对了，对了！在那场对决之后，其实我还见过几次香菱，还从她那里听到了一道叫做「史莱姆滑蘑菇」的菜。"
        },
        {
          "role": "布洛克",
          "text": "这种新奇的材料，我还从来没用过…不过，想要做出新奇的菜，就要尝试新奇的材料。"
        },
        {
          "role": "布洛克",
          "text": "旅行者，那就拜托你帮我去找一份史莱姆凝液和一份蒲公英籽吧。"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "布洛克",
          "text": "嗯，那就拜托你了，我在这里再思考一下我的那份菜谱。"
        },
        {
          "role": "布洛克",
          "text": "蒲公英籽和史莱姆凝液，都准备好了吗？"
        },
        {
          "role": "布洛克",
          "text": "太好了，这下终于可以开始制作了，多谢你了。"
        },
        {
          "role": "布洛克",
          "text": "有了这份冷鲜肉，再加上这两种材料，我一定能做出那种有「噼咔」感的菜！"
        },
        {
          "role": "布洛克",
          "text": "对了，这些报酬请你收下，谢谢你帮我的忙。"
        }
      ]
    }
  ]
}