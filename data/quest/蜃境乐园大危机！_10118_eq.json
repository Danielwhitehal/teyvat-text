{
  "quest_id": 10118,
  "chapter_num": "清夏！乐园？大秘境！其二",
  "chapter_title": "蜃境乐园大危机！",
  "type": "eq",
  "route": "Mirage Paradise in Crisis!",
  "stories": [
    {
      "story_id": 40115,
      "title": "聚众游园，点亮夏日灯火",
      "description": "修复核心轮縠的第三个零件落在了北边的密林之中，之前伊迪娅说，优菈要寻找的表亲似乎也到这个区域去了，不知有没有她要找的人的线索…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到第二天早晨（8-12点）"
        },
        {
          "type": "subtitle",
          "text": "与伊迪娅对话"
        },
        {
          "role": "派蒙",
          "text": "柯莱，优菈，还有伊迪娅小姐！"
        },
        {
          "role": "柯莱",
          "text": "啊，旅行者和派蒙，你们来了。"
        },
        {
          "role": "柯莱",
          "text": "怎么样，休息得还好吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "疲劳感已经消失了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊迪娅",
          "text": "没错，我这里的环境还是很好的，不像沙漠…这可是为数不多的优点了！"
        },
        {
          "role": "柯莱",
          "text": "不这样说自己也没关系的啦！"
        },
        {
          "role": "伊迪娅",
          "text": "是实话哦，要知道沙漠里充满了令人讨厌的回忆，对我来说就像…对，就像污泥汤一样。"
        },
        {
          "role": "派蒙",
          "text": "真是个奇妙的比喻。要是伊迪娅不说我都快忘了，这个蜃境居然是在沙漠里。"
        },
        {
          "role": "柯莱",
          "text": "我懂！这里的空气一直都很湿润，更像是待在雨林里。我再熟悉不过了。"
        },
        {
          "role": "优菈",
          "text": "各位看起来都休息完毕了，那我们出发前往北边的森林吧。"
        },
        {
          "role": "伊迪娅",
          "text": "各位一路顺利！带着我的份一起加油！"
        },
        {
          "role": "优菈",
          "text": "不必道别。「我们」当然是包括伊迪娅小姐你的。"
        },
        {
          "role": "伊迪娅",
          "text": "欸？！等一下，我不就是一个吉祥物吗？"
        },
        {
          "role": "柯莱",
          "text": "不可以退缩哦，伊迪娅小姐！「游园会」管理人还等着见你呢，说是…「只有你才能处理」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「游园会」？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "优菈",
          "text": "嗯，是我和柯莱在森林里发现的。"
        },
        {
          "role": "柯莱",
          "text": "负责管理那片「游园会」区域的人，似乎是一位素论派的学者。"
        },
        {
          "role": "派蒙",
          "text": "学者？是在研究森林里的地脉吗？"
        },
        {
          "role": "伊迪娅",
          "text": "唉，这里最好有可以给她研究的地脉啦…但我知道是谁了，我还是跟你们一起去吧。"
        },
        {
          "type": "subtitle",
          "text": "前往北边的密林"
        },
        {
          "type": "subtitle",
          "text": "继续前往北边的密林"
        },
        {
          "role": "？？？",
          "text": "哎呀，终于有人来了…"
        },
        {
          "role": "柯莱",
          "text": "让你久等了，迈蒙小姐，伊迪娅也来了。"
        },
        {
          "role": "迈蒙",
          "text": "谢谢你，柯莱小姐。哇，好久不见啊，伊迪娅，没想到你真的出现了…"
        },
        {
          "role": "迈蒙",
          "text": "我还以为你会一直缩在一个谁都找不到的地方独自哭泣呢。"
        },
        {
          "role": "优菈",
          "text": "说这种话不太好吧。"
        },
        {
          "role": "派蒙",
          "text": "总觉得…好像不是第一次听到这样的评价了…"
        },
        {
          "role": "伊迪娅",
          "text": "好！我哭，我现在就哭给你们看！"
        },
        {
          "role": "柯莱",
          "text": "啊！别、别这样…"
        },
        {
          "role": "迈蒙",
          "text": "好了好了，是我言重了…这两位是？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我是旅行者。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你好你好，我是派蒙。"
        },
        {
          "role": "伊迪娅",
          "text": "他们都是我找来的可靠帮手。你…你可不能像对我一样对他们几位！"
        },
        {
          "role": "迈蒙",
          "text": "嗯，两位好，叫我迈蒙就行。那我就不多做寒暄了，请各位移步。"
        },
        {
          "type": "subtitle",
          "text": "进入游园会深处"
        },
        {
          "role": "柯莱",
          "text": "哇…"
        },
        {
          "role": "派蒙",
          "text": "里面，居然还有这样一个大帐篷…"
        },
        {
          "role": "伊迪娅",
          "text": "厉害吧，是我帮忙做出来的。说到庆典和游园会，就应该有好看的大帐篷嘛。"
        },
        {
          "role": "派蒙",
          "text": "我就知道！伊迪娅只是为人谦虚了点，实际上深藏不露呢！"
        },
        {
          "role": "柯莱",
          "text": "…欸？"
        },
        {
          "role": "优菈",
          "text": "怎么了，柯莱？"
        },
        {
          "role": "柯莱",
          "text": "不好意思，呃，不知道该不该说…"
        },
        {
          "role": "柯莱",
          "text": "我想到的事，有点扫兴…"
        },
        {
          "role": "优菈",
          "text": "没事，想到什么就说什么。"
        },
        {
          "role": "柯莱",
          "text": "唔…这里虽然设置了很多摊位，但既没有摊主，也没有来玩的人。看着好冷清…"
        },
        {
          "role": "迈蒙",
          "text": "唉，不瞒你说，这本应该是个挺热闹的地方。"
        },
        {
          "role": "迈蒙",
          "text": "就在前几天，不知出了什么问题，整个蜃境…"
        },
        {
          "role": "派蒙",
          "text": "就像「天和地突然翻转了一下」？"
        },
        {
          "role": "迈蒙",
          "text": "对…轮縠里的东西落入大帐篷，将里面的「晶灯」从大帐篷的顶部打落…"
        },
        {
          "role": "伊迪娅",
          "text": "啊，那个「晶灯」…"
        },
        {
          "role": "迈蒙",
          "text": "没错。就是某个人说，庆典就得有漂亮的光，做出来的那个「晶灯」。"
        },
        {
          "role": "迈蒙",
          "text": "「晶灯」掉下来之后，大帐篷内也乱作一团，水形幻灵也被困在了里面。"
        },
        {
          "role": "迈蒙",
          "text": "就在一筹莫展的时候，有位劳伦斯先生自告奋勇…"
        },
        {
          "role": "优菈",
          "text": "等等…自告奋勇？"
        },
        {
          "role": "迈蒙",
          "text": "是啊，他根本没有听我的警告，毅然决然地走进了大帐篷里，然后…"
        },
        {
          "role": "优菈",
          "text": "…然后呢？"
        },
        {
          "role": "派蒙",
          "text": "是啊！你别说话只说一半啊，然后呢？"
        },
        {
          "role": "迈蒙",
          "text": "然后就没有然后了，他和我的水形幻灵朋友一起被困在了里面。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "受害人，增加了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "柯莱",
          "text": "这不行呀，迈蒙小姐，不能放着他不管吧！"
        },
        {
          "role": "迈蒙",
          "text": "我知道，但里面的情况可能比各位想象得还要麻烦…还请做好心理准备。"
        },
        {
          "role": "优菈",
          "text": "……"
        },
        {
          "role": "优菈",
          "text": "在这凭空猜想只有浪费时间，既然人都在，去实地看了再说吧。"
        },
        {
          "role": "迈蒙",
          "text": "唉，来吧。"
        },
        {
          "type": "subtitle",
          "text": "进入大帐篷"
        },
        {
          "role": "迈蒙",
          "text": "本来里面是个大舞台…但在蜃境发生动荡以后，场景的性质也产生了变化。"
        },
        {
          "role": "迈蒙",
          "text": "原本悬挂在高处的灯和「晶灯」一起落了下来…对修理造成了不小的阻碍。"
        },
        {
          "role": "柯莱",
          "text": "是路变得很难走吗？"
        },
        {
          "role": "迈蒙",
          "text": "主要原因是灯光。"
        },
        {
          "role": "迈蒙",
          "text": "各位有登上舞台的经历吗？一旦灯光照射过来，所有人的目光都会聚焦在你身上。"
        },
        {
          "role": "柯莱",
          "text": "呃…"
        },
        {
          "role": "柯莱",
          "text": "对我来说还是有点…我不太喜欢被那样看着，目光太集中了让人很难受。"
        },
        {
          "role": "伊迪娅",
          "text": "我也是！明明很不擅长说话还要被那么多人看着，想想就浑身发毛…"
        },
        {
          "role": "优菈",
          "text": "还是有些放不下吗？"
        },
        {
          "role": "柯莱",
          "text": "唉，说出来你可别笑我…我已经在努力改了，但还是有些事克服不了，人多的时候啊，被盯着的时候啊…"
        },
        {
          "role": "优菈",
          "text": "没什么可笑的，而且你知道吗？在意别人的眼光也不是什么坏事。"
        },
        {
          "role": "优菈",
          "text": "至少我觉得是这样。你想，只有对自己很有要求的人才不愿辜负别人的期待吧。"
        },
        {
          "role": "优菈",
          "text": "你各方面资质都很好，要是和我一样从小就开始练舞，说不定现在跳得比我还好。"
        },
        {
          "role": "柯莱",
          "text": "不不不，绝对不可能的！"
        },
        {
          "role": "伊迪娅",
          "text": "（我也不行！我太理解了！）"
        },
        {
          "role": "优菈",
          "text": "不妨找时间跟我学学吧？总有一天你也会成为杰出的舞者，到那时你将足够耀眼，无惧于身外的光。"
        },
        {
          "role": "派蒙",
          "text": "优菈说这话的时候，已经在发光了…"
        },
        {
          "role": "柯莱",
          "text": "…真的没关系吗？你不会偷偷在心里笑话我笨吧？"
        },
        {
          "role": "优菈",
          "text": "哼，我在你心里是那种人？"
        },
        {
          "role": "柯莱",
          "text": "不是啦！好吧好吧，我学就是了。"
        },
        {
          "role": "迈蒙",
          "text": "好吧，看来不需要我再警示什么了。总之，只要拉开幕帘，就能够看见舞台了。"
        },
        {
          "type": "subtitle",
          "text": "解锁并升起「晶灯」"
        },
        {
          "role": "派蒙",
          "text": "等等，中间那个是什么？"
        },
        {
          "role": "伊迪娅",
          "text": "是我的「晶灯」，被锁起来了…"
        },
        {
          "role": "迈蒙",
          "text": "想办法恢复吧，得让下面托着「晶灯」的台子升起来…"
        },
        {
          "role": "伊迪娅",
          "text": "没记错的话，周围应该有控制舞台的机关吧…"
        },
        {
          "type": "subtitle",
          "text": "第一次解锁「晶灯」",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "伊迪娅",
          "text": "看来得利用插销的彩镜，让灯光变换颜色吧…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（插销彩片被灯光融化}）"
        },
        {
          "role": "派蒙",
          "text": "插销的彩片融化了！"
        },
        {
          "role": "迈蒙",
          "text": "因为彩镜是用很容易被光融化的材料做的嘛。"
        },
        {
          "role": "柯莱",
          "text": "感觉，能闻到一些甜甜的味道？"
        },
        {
          "type": "subtitle",
          "text": "安装光斓彩镜",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "迈蒙",
          "text": "光就会这样改变颜色，变成了「有色眼光」…"
        },
        {
          "role": "派蒙",
          "text": "迈蒙小姐…你是不是认识一位叫赛诺的人？"
        },
        {
          "role": "迈蒙",
          "text": "没听说过啊，怎么了？"
        },
        {
          "role": "派蒙",
          "text": "唔，没事。我只是一下子觉得…你们应该很有共同语言。"
        },
        {
          "role": "迈蒙",
          "text": "咳咳，说回正题。还是快点到打开的通道里去吧…"
        },
        {
          "type": "subtitle",
          "text": "前往大帐篷的第二层"
        },
        {
          "role": "？？？",
          "text": "有人吗…周、周围有人在吗…快来救救我…"
        },
        {
          "role": "优菈",
          "text": "莱斯格·劳伦斯？"
        },
        {
          "role": "莱斯格",
          "text": "什、什么人…居然直呼本人的全名，真是失礼…"
        },
        {
          "role": "派蒙",
          "text": "明明都已经这么虚弱了，居然还在说这种话。"
        },
        {
          "role": "优菈",
          "text": "…确实是劳伦斯家的人，就算落到了这种地步，还在恪守没有意义的礼节。"
        },
        {
          "role": "莱斯格",
          "text": "怎、怎么会是你…"
        },
        {
          "role": "莱斯格",
          "text": "哈！你是来嘲笑我的吗？优菈。"
        },
        {
          "role": "优菈",
          "text": "那种事情随便想一想就明白了吧，还需要特意向我挑衅吗？"
        },
        {
          "role": "优菈",
          "text": "当然了，你完全可以不接受我的帮助，毕竟「贵族天生自立，不需要他人的帮助」。"
        },
        {
          "role": "莱斯格",
          "text": "…感谢你的提醒，我不需要帮助！"
        },
        {
          "role": "柯莱",
          "text": "优菈，他说的不是真话哦。"
        },
        {
          "role": "柯莱",
          "text": "他语气很生硬，眼角一直在偷偷瞟你。作为「治疗师」，我的判断是，这个人需要帮助。"
        },
        {
          "role": "优菈",
          "text": "好。"
        },
        {
          "role": "优菈",
          "text": "…哼，被困这么久，已经不懂得谈吐的礼仪了。真是可笑，各位，我们走，把舞台留给这死要面子的人。"
        },
        {
          "role": "莱斯格",
          "text": "喂…等、等等！！"
        },
        {
          "role": "莱斯格",
          "text": "站住！你不能真的放下我不管！我们…我们可是一家人！"
        },
        {
          "role": "莱斯格",
          "text": "在必要时援助我，折损的绝不会是你的威光！我的狼狈将由你的义举覆盖，这是…这是在维护家族的威名与尊严！"
        },
        {
          "role": "优菈",
          "text": "这就是你能想到最好的理由了吗？扣上一顶名为家族的帽子，就能说服我吗？"
        },
        {
          "role": "优菈",
          "text": "你应当对自己不谨慎的行为感到愧疚。为了你，我们一行人才赶来这里。"
        },
        {
          "type": "subtitle",
          "text": "优菈对柯莱使了个眼色…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "莱斯格",
          "text": "…我…"
        },
        {
          "role": "派蒙",
          "text": "劳伦斯家的人都这样吗…面子大过天呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "优菈她虽然嘴上严苛…",
              "dialogues": []
            },
            {
              "text": "毕竟还是赶来救人了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊迪娅",
          "text": "好啦好啦，「吉祥物」该出来活跃气氛了！"
        },
        {
          "role": "伊迪娅",
          "text": "优菈·劳伦斯小姐，莱斯格·劳伦斯先生，来，一人一颗。"
        },
        {
          "role": "莱斯格",
          "text": "什么啊…糖？"
        },
        {
          "role": "优菈",
          "text": "唔…谢谢。"
        },
        {
          "role": "柯莱",
          "text": "啊！这个味道，和彩镜飘出来的香气是一样的。"
        },
        {
          "role": "伊迪娅",
          "text": "没错没错，吃了甜甜的糖果，心情也会变好。"
        },
        {
          "role": "莱斯格",
          "text": "…谢谢你，「吉祥物」小姐，它让我觉得好多了。"
        },
        {
          "role": "优菈",
          "text": "（这个家伙，居然能好好地向其他人表达谢意？）"
        },
        {
          "role": "伊迪娅",
          "text": "优菈小姐这几天可担心你了呢，向我确认过好几次你的行踪。"
        },
        {
          "role": "伊迪娅",
          "text": "这下两位终于团聚了，我不用再被问东问西，真是皆大欢喜。"
        },
        {
          "role": "优菈",
          "text": "容我声明一句，我并不关心这家伙的安危！你要是想胡说八道…"
        },
        {
          "role": "柯莱",
          "text": "在「嘴硬」这一点上，优菈也不输呢。"
        },
        {
          "role": "派蒙",
          "text": "我也觉得。"
        },
        {
          "role": "优菈",
          "text": "…要是想胡说八道，至少…至少再给我一颗糖。"
        },
        {
          "role": "伊迪娅",
          "text": "欸？啊，好的好的，糖还有！"
        },
        {
          "role": "莱斯格",
          "text": "…对不起，我知错了，确实给各位添了许多麻烦。"
        },
        {
          "role": "优菈",
          "text": "……"
        },
        {
          "role": "优菈",
          "text": "哼，早说不就好了…"
        },
        {
          "role": "迈蒙",
          "text": "我回来了…欸，大家已经聊完了吗？怎么都盯着我看。"
        },
        {
          "role": "派蒙",
          "text": "没有没有，别在意。"
        },
        {
          "role": "迈蒙",
          "text": "那就收拾收拾，继续向前修「晶灯」吧！对了，莱斯格先生身体不适的话，就不用勉强了。"
        },
        {
          "role": "伊迪娅",
          "text": "我带他找个地方休息吧，正好我也累了…"
        },
        {
          "role": "优菈",
          "text": "嗯，我们劳伦斯的表亲就交给你了，伊迪娅小姐。"
        },
        {
          "role": "优菈",
          "text": "…在我找你算账之前，好好恢复说话的力气吧，莱斯格。"
        },
        {
          "type": "subtitle",
          "text": "解锁并升起「晶灯」"
        },
        {
          "role": "迈蒙",
          "text": "现在得看看，有没有让平台继续上升的办法…"
        },
        {
          "role": "迈蒙",
          "text": "估计也得找找类似灯那样的机关了。"
        },
        {
          "type": "subtitle",
          "text": "安装光斓彩镜，升起幕布，解救一只小水珠",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "啊，那里有一只「小水珠」…"
        },
        {
          "role": "迈蒙",
          "text": "是水形幻灵啊，没想到它被关在幕布里面，还好看上去没事。"
        },
        {
          "type": "subtitle",
          "text": "安装第二个光斓彩镜",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "优菈",
          "text": "…真奇怪，那个人真的是我认识的莱斯格吗？"
        },
        {
          "role": "迈蒙",
          "text": "总是以「以前的认知」作基准可不作数，人是会变的，人总能作出「选择」…"
        },
        {
          "role": "优菈",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "前往大帐篷的第三层"
        },
        {
          "role": "派蒙",
          "text": "外面看起来已经很大了，结果里面的空间更大！"
        },
        {
          "role": "迈蒙",
          "text": "毕竟是神奇帐篷嘛。里面比外面大，故事里不也经常出现这样的场面嘛…"
        },
        {
          "type": "subtitle",
          "text": "到达第三层",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "唔，又出现了新的道路，这里应该是最后一层了吧…"
        },
        {
          "role": "迈蒙",
          "text": "安心安心，已经快到大帐篷顶了。"
        },
        {
          "role": "迈蒙",
          "text": "最后要做的就是让「晶灯」从大帐篷的顶部升上去。"
        },
        {
          "role": "迈蒙",
          "text": "唔，塌下来之后才发现，这个台子升到一半的时候真像大巴扎的舞台啊…你们去过大巴扎吗？"
        },
        {
          "role": "优菈",
          "text": "我没有。"
        },
        {
          "role": "柯莱",
          "text": "我跟提纳里师父去过几次。"
        },
        {
          "role": "柯莱",
          "text": "那里有各种商贩，真的很热闹！运气好的时候，还能看到妮露的舞蹈表演。"
        },
        {
          "role": "优菈",
          "text": "哦，须弥的舞蹈？说得我也想看一眼了，要是回程的时候顺路就好了。"
        },
        {
          "role": "柯莱",
          "text": "不顺路也没关系哦。只要优菈有时间，之后我也可以带你过去！"
        },
        {
          "role": "优菈",
          "text": "好啊，那就这么说定了。"
        },
        {
          "role": "旅行者",
          "text": "我们去过…"
        },
        {
          "role": "派蒙",
          "text": "这么想来，还真是去过很多很多次！数都快数不清了。"
        },
        {
          "role": "迈蒙",
          "text": "是嘛，我的父亲当年在大巴扎帮忙筹办庆典，每到庆典都有糖吃…"
        },
        {
          "role": "迈蒙",
          "text": "小孩子懂什么呢，吃到糖就很开心了，就觉得庆典啊，游园会啊，是很好很好的东西。"
        },
        {
          "role": "迈蒙",
          "text": "…也总觉得父亲很了不起，长大后一定要成为父亲那样的人。"
        },
        {
          "role": "柯莱",
          "text": "但迈蒙小姐是教令院的学者吧？据我所知，学者的业余时间往往也离不开研究课题…"
        },
        {
          "role": "柯莱",
          "text": "迈蒙小姐，是不是没有时间帮忙举办庆典呢…？"
        },
        {
          "role": "迈蒙",
          "text": "嗯，被你看出来了。"
        },
        {
          "role": "迈蒙",
          "text": "在「我想成为的人」与「父母想让我成为的人」之间，我选择了后者，但我并不快乐。"
        },
        {
          "role": "派蒙",
          "text": "和优菈的情况刚好相反呢…"
        },
        {
          "role": "优菈",
          "text": "我想你现在已经意识到了吧？所以你才会布置这些摊位，搭建出庆典的氛围。"
        },
        {
          "role": "迈蒙",
          "text": "对，但…我依然没有想象中那么快乐。"
        },
        {
          "role": "迈蒙",
          "text": "我发现…参加庆典和举办庆典是两码事。"
        },
        {
          "role": "迈蒙",
          "text": "童年之所以无忧无虑，很大一部分原因是有我的家人在付出劳动。"
        },
        {
          "role": "迈蒙",
          "text": "但父亲深知筹备工作的繁重与辛劳，所以才想让我走上学术之路…"
        },
        {
          "role": "迈蒙",
          "text": "唉…可我哪边都没做好。"
        },
        {
          "role": "迈蒙",
          "text": "自暴自弃地在沙漠里做地脉调查，结果不小心落到这里来。"
        },
        {
          "role": "迈蒙",
          "text": "好不容易有了个达成愿望的机会…在看见成果被破坏之后，又失去了站起来的力气。"
        },
        {
          "role": "柯莱",
          "text": "迈蒙小姐没有自己说的那么糟糕哦，别太悲观了。"
        },
        {
          "role": "柯莱",
          "text": "你有改变的勇气，这一路上也在积极地引导我们…"
        },
        {
          "role": "柯莱",
          "text": "真正「自暴自弃」的人，是绝对做不到这些的。"
        },
        {
          "role": "派蒙",
          "text": "柯莱…"
        },
        {
          "role": "迈蒙",
          "text": "我自己清楚自己的情况，不用特意安慰我…"
        },
        {
          "role": "柯莱",
          "text": "这也不算是安慰啦，有时当事人自己会意识不到，行动比语言更反应真实。"
        },
        {
          "role": "柯莱",
          "text": "这个道理，我也是从优菈身上明白的。"
        },
        {
          "role": "优菈",
          "text": "嗯？你想说什么？"
        },
        {
          "role": "柯莱",
          "text": "没有没有！呃，我们还是快点把「晶灯」修好吧…"
        },
        {
          "role": "迈蒙",
          "text": "…嗯。"
        },
        {
          "type": "subtitle",
          "text": "升起「晶灯」"
        },
        {
          "role": "迈蒙",
          "text": "嗯…要让「晶灯」升上去的话，还得打开大帐篷的顶部…"
        },
        {
          "type": "subtitle",
          "text": "点亮「游园会」的灯火"
        },
        {
          "role": "派蒙",
          "text": "伊迪娅小姐，我们出来啦！"
        },
        {
          "role": "伊迪娅",
          "text": "噢噢，我还想着你们也应该早就出来了才对！莱斯格先生已经差不多恢复了，请放心。"
        },
        {
          "role": "伊迪娅",
          "text": "哎呀，就算是我也能做到一些关照人的事情嘛…不错呢，又发现自己一个优点…"
        },
        {
          "role": "柯莱",
          "text": "看到她这样真不知道该担心还是该欣慰…"
        },
        {
          "role": "莱斯格",
          "text": "巨大的…等等！！刚才、刚才的影子…啊！"
        },
        {
          "role": "伊迪娅",
          "text": "好吧，看来他完全恢复还要再过一会儿，怎么样，一切都还顺利吗？"
        },
        {
          "role": "迈蒙",
          "text": "当然了，旅行者，派蒙，柯莱小姐和优菈小姐，加起来大概有你四十倍可靠吧。"
        },
        {
          "role": "伊迪娅",
          "text": "什么嘛才四十倍，我还是挺棒的呀。"
        },
        {
          "role": "迈蒙",
          "text": "…只要先觉得自己输了，就能够立于不败之地吗…好可怕的韧性，像斩不断的河水一样…"
        },
        {
          "role": "莱斯格",
          "text": "咦！欸，怎么回事…我怎么从大帐篷里出来了…"
        },
        {
          "role": "莱斯格",
          "text": "对了，我遇到了优菈，然后然后是…咝，我的头…"
        },
        {
          "role": "伊迪娅",
          "text": "这就是一些治疗的副作用了，莱斯格先生，你清醒了吗？"
        },
        {
          "role": "莱斯格",
          "text": "虽然还是有点晕…"
        },
        {
          "role": "旅行者",
          "text": "（究竟是怎么治疗的啊…）"
        },
        {
          "role": "优菈",
          "text": "莱斯格·劳伦斯。"
        },
        {
          "role": "莱斯格",
          "text": "呜，优菈…好了好了，我知道了，我会乖乖和你一起回蒙德，不再想着「靠激进的手段复兴劳伦斯家」这种事…"
        },
        {
          "role": "优菈",
          "text": "…真是奇怪，你竟然变得如此好沟通了。"
        },
        {
          "role": "优菈",
          "text": "既然如此，你该交代的事就比原来更多了，对吗？"
        },
        {
          "role": "莱斯格",
          "text": "我…唉，必须承认，刚开始我确实是为了「复兴劳伦斯家」来到这里。"
        },
        {
          "role": "莱斯格",
          "text": "但一路上我花了很多时间，还迷路过。我经过了璃月和须弥…有阵子甚至弄丢钱包住在野外。"
        },
        {
          "role": "莱斯格",
          "text": "很奇怪，你知道吗？在那里我发现…没有任何人认识我，也没有任何人关心「劳伦斯」。"
        },
        {
          "role": "莱斯格",
          "text": "你和我，我们都是成长于桎梏中的玻璃棋子。我们被教导要像贵族，可在外面，蒙德人又因此看不起我们。"
        },
        {
          "role": "莱斯格",
          "text": "唾弃、憎恶、固执的教育…这一切相加，令我们越发坚守陈旧的贵族教条，试图以此维持自尊。"
        },
        {
          "role": "莱斯格",
          "text": "就像是一场漫长的拔河一样。但这没有任何意义…你明白的，应该说，你早就明白了，而我才学懂这一点。"
        },
        {
          "role": "派蒙",
          "text": "唔…感觉似乎能够理解莱斯格说的话…"
        },
        {
          "role": "优菈",
          "text": "…都是事实。你家人似乎还不清楚你已经想开了。"
        },
        {
          "role": "莱斯格",
          "text": "是啊，都是最近的事。来到这里以后，我明白我真正想要的不是一个人人都畏惧我的蒙德。"
        },
        {
          "role": "莱斯格",
          "text": "我…和其他不少劳伦斯的人，我们渴望的仅仅是一个能与人和平共处的环境而已。"
        },
        {
          "role": "优菈",
          "text": "莱斯格，你我都与所谓的劳伦斯荣光无关。「荣誉」全在过往…我们只是普通人而已。"
        },
        {
          "role": "莱斯格",
          "text": "……"
        },
        {
          "role": "莱斯格",
          "text": "本来我想等处理完这里的事就回去的。没想到你会过来…惊动了你，真抱歉。"
        },
        {
          "role": "迈蒙",
          "text": "你看，人总是能做出「选择」的，看来莱斯格先生也选了成为「我想成为的人」那边。"
        },
        {
          "role": "莱斯格",
          "text": "关于这一点…实在对不起，我还没有找到独属于自己的人生目标…"
        },
        {
          "role": "迈蒙",
          "text": "没关系，看清「我想成为的人」和「父母想让我成为的人」，已经是很了不起的一步了。"
        },
        {
          "role": "迈蒙",
          "text": "…「如何寻找真正的幸福」，恐怕是比一切都要难的研究课题。"
        },
        {
          "role": "优菈",
          "text": "莱斯格，我有个提议。"
        },
        {
          "role": "优菈",
          "text": "回去以后把你刚才那番话说给你父母听听，如何？"
        },
        {
          "role": "莱斯格",
          "text": "哈，那我说不定会挨打吧。你呢？你对家人说过自己真实的想法吗？"
        },
        {
          "role": "优菈",
          "text": "这也是我在想的问题…或许我们可以坐下来，跟所有人谈谈。"
        },
        {
          "role": "优菈",
          "text": "劳伦斯就像这片舞台，曾经光辉无比，但过去的戏剧都已落幕，我们也是时候更新它了。"
        },
        {
          "role": "柯莱",
          "text": "（…因为她是这样的人，才能够随时随地起舞吗？顽强又坚硬，但也很剔透…像冰块一样。）"
        },
        {
          "role": "伊迪娅",
          "text": "呃…你们、你们这是聊完了？"
        },
        {
          "role": "迈蒙",
          "text": "看上去是的，那这个给你们吧，是我之前在快不行了的莱斯格先生身边找到的。"
        },
        {
          "role": "伊迪娅",
          "text": "啊！是掉落在这里的「零件」！你、你那个时候就找到了，却现在才给我？"
        },
        {
          "role": "迈蒙",
          "text": "你、你刚才也没问啊！好吧我就是忘了…"
        },
        {
          "role": "伊迪娅",
          "text": "哼哼…那这一份零件也先一起保存在旅行者手里好了。"
        },
        {
          "role": "柯莱",
          "text": "咦？这个东西…"
        },
        {
          "role": "派蒙",
          "text": "总觉得很眼熟，是不是在哪里看到过…{{黑幕|主线中花神诞祭的糖果盒}}"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "永无止境的…<ref>梗出处：凉宫春日的忧郁第二季 永无止境的八月</ref>",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘘！不要在这时候吹嘘英雄事迹啦！"
                }
              ]
            },
            {
              "text": "是装糖果的盒子！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "柯莱",
          "text": "上次庆典的时候，我也买过一盒。"
        },
        {
          "role": "迈蒙",
          "text": "对，庆典上经常拿这个来装糖果，这也是当时制造出大帐篷的「素材」…"
        },
        {
          "role": "迈蒙",
          "text": "既然大帐篷恢复了，这个东西也不再具有什么特殊意义。"
        },
        {
          "role": "迈蒙",
          "text": "变成大人以后再吃糖果盒里的糖，总是不如小时候美味啊。不过仔细想想，长大以后可以吃的东西也更多了吧。"
        },
        {
          "role": "派蒙",
          "text": "噢！所以归根结底，吃糖就像人生一样，无非是一种「选择」嘛！"
        },
        {
          "role": "莱斯格",
          "text": "……"
        },
        {
          "role": "伊迪娅",
          "text": "这样一来，我们也找齐三个「零件」啦，还差最后一个。"
        },
        {
          "role": "伊迪娅",
          "text": "不过修复大帐篷花了大家那么多时间…真抱歉，各位果然还是先回去休息一下再说吧…就由我来带路…"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|似曾相识的糖果盒}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "返回银瓶庭院"
        },
        {
          "role": "派蒙",
          "text": "心海！原来你已经先回来了啊。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "是你们啊，在北边森林里的冒险还顺利吗？"
        },
        {
          "role": "派蒙",
          "text": "一切都很顺利！你呢？今天有做什么吗？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯…也是时候告诉各位了，我作为海祇岛现人神巫女，本不该在这个时间出现于此。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "事实上，海祇岛很久以前丢失了一件古物，名为「蜃楼玉匣」。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "近期，与之相配的宝珠突然发出了指引般的光芒，我这才得知了古物的去向。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以心海是来找东西的…",
              "dialogues": []
            },
            {
              "text": "原来不是因为想开阔视野…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珊瑚宫心海",
          "text": "说想开阔视野也不是假话。五郎常跟我说，蹲在家里看轻小说不是上上之策…也该出去走走了。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "自海祇岛出发，一路来到须弥，我欣赏了沿途不少风光。真是有趣的国家，我还在雨林地区停留了好几天呢。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "不过没想到，礼器最终落在了沙漠一带。我这里有所感应，却始终不能精准定位…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "伊迪娅小姐并没有刻意隐瞒我们什么，但这片蜃境还藏着秘密，相信以你的能力一定也感觉到了。"
        },
        {
          "role": "旅行者",
          "text": "（确实有些不寻常的地方，伊迪娅有时会变得很匆忙…何况还有艾莉丝这层关系在。）"
        },
        {
          "role": "派蒙",
          "text": "说到这个，我们今天也遇到了不少事！"
        },
        {
          "type": "subtitle",
          "text": "向珊瑚宫心海讲述了在「游园会」发生的事…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "珊瑚宫心海",
          "text": "原来如此，你们见到了莱斯格先生。他那里有关于蜃境的线索吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "似乎没有。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珊瑚宫心海",
          "text": "恐怕是他困于心境没能注意周围吧。事实上，在「天和地突然翻转了一下」之前，整个蜃境并不是现在这副模样。"
        },
        {
          "role": "柯莱",
          "text": "旅行者！啊，没有打扰你和心海小姐聊天吧？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "没关系，两位小姐今天也辛苦了，要一起喝杯茶吗？"
        },
        {
          "role": "柯莱",
          "text": "好的！其实，我和优菈刚才去做了些点心…"
        },
        {
          "role": "优菈",
          "text": "伊迪娅那里居然有烤箱和炉灶，也不早说，真是的。"
        },
        {
          "role": "派蒙",
          "text": "所以有月亮派吃了吗？"
        },
        {
          "role": "优菈",
          "text": "我做的那种叫做「骇浪派」。旅行者，你也来一份？"
        },
        {
          "role": "柯莱",
          "text": "口袋饼也有哦！心海小姐也请，配茶应该不错的。"
        },
        {
          "role": "柯莱",
          "text": "啊，说漏了，应该是叫「军师」小姐…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "哎呀，那我就不客气了。"
        },
        {
          "role": "派蒙",
          "text": "对了优菈，你那个表亲怎么样了？"
        },
        {
          "role": "优菈",
          "text": "他啊…你大概猜不到，他也在烤箱旁边忙活呢。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（莱斯格&优菈）"
        },
        {
          "role": "莱斯格",
          "text": "尊贵的劳伦斯家后裔，一路旅行也学了不少技巧…比如，做烤饼！"
        },
        {
          "role": "莱斯格",
          "text": "…嗯，这个火候应该没问题吧…"
        },
        {
          "role": "优菈",
          "text": "没想到你居然会做烤饼…你不是那种从来不洗碗的人吗…"
        },
        {
          "role": "莱斯格",
          "text": "来得正好，你之后有时间吗？能不能教教我做点心？"
        },
        {
          "role": "优菈",
          "text": "欸？那可得花上不少时间…我们不是来这里增进家族情谊的吧。"
        },
        {
          "role": "莱斯格",
          "text": "行啦，这时候又在意这些了？你也说了我们是普通人，像普通的表亲一样互相学习吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（柯莱&珊瑚宫心海）"
        },
        {
          "role": "柯莱",
          "text": "这种味道的茶我还是第一次喝到，果然稻妻的茶叶跟须弥饮料很不一样呢。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "这样说来，须弥人会往茶里放香料吗？"
        },
        {
          "role": "柯莱",
          "text": "会的，不过我喝不惯，如果让我选的话，还是咖啡好一点，就是喝了容易失眠…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊迪娅）"
        },
        {
          "role": "伊迪娅",
          "text": "哎呀，旅行者，怎么样，在蜃境里有什么新发现吗？"
        },
        {
          "role": "伊迪娅",
          "text": "如果觉得有趣的话，跟我说说也行哦。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（可莉&凯亚）"
        },
        {
          "role": "可莉",
          "text": "真想和「军师」姐姐一起呼呼——地坐飞车呀！可是，她好像会晕倒…"
        },
        {
          "role": "凯亚",
          "text": "可莉真敏锐啊，一定是从「军师」姐姐眼睛里看到了旋转的星星吧。"
        },
        {
          "role": "可莉",
          "text": "今天的少了一点哦！昨天有很多很多金色的星星。"
        },
        {
          "role": "可莉",
          "text": "妈妈要是在的话，可能会说这些星星全是掉进云朵的鱼吧！"
        }
      ],
