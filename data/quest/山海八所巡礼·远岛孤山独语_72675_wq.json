{
  "quest_id": 72675,
  "chapter_num": null,
  "chapter_title": "山海八所巡礼·远岛孤山独语",
  "type": "wq",
  "route": "Eight Locales Over Mountains and Seas: Soliloquy of Distant Island Peaks",
  "stories": [
    {
      "story_id": 72675,
      "title": "山海八所巡礼·远岛孤山独语",
      "description": "之前答应了五百藏「带吉法师去外面修行」的请求。这回就去孤云阁那边看看吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往孤云阁"
        },
        {
          "role": "「吉法师」",
          "text": "和雪山不同，不冷。也没有雪。"
        },
        {
          "role": "派蒙",
          "text": "这里是孤云阁！传说是当年岩王帝君击败那个…那个…很多头的大水蛇，叫什么来着？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "漩涡之魔神？",
            "奥赛尔？"
          ]
        },
        {
          "role": "派蒙",
          "text": "啊，对！漩涡之魔神奥赛尔！当年就是在这里，被石枪打败、镇压的。"
        },
        {
          "role": "「吉法师」",
          "text": "哇！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，厉害吧？不过我们也和它战斗过！我们在凝光小姐的群玉阁上…"
        },
        {
          "role": "「吉法师」",
          "text": "金色的晶蝶！"
        },
        {
          "role": "派蒙",
          "text": "原来是在感叹这个喔！好好听人说话啦！"
        },
        {
          "role": "旅行者",
          "text": "毕竟和稻妻的晶蝶不同…"
        },
        {
          "role": "旅行者",
          "text": "他应该没见过不是紫色的晶蝶…"
        },
        {
          "role": "派蒙",
          "text": "嗯…也是啦。真拿吉法师没办法。旅行者，抓个晶蝶给他看看吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么不是你去抓？",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "但是，明明是你比较熟练嘛。"
        }
              ]
            },
            {
              "text": "会飞的明明是你。",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "但是，抓晶蝶还是你比较熟练嘛。"
        }
              ]
            },
            {
              "text": "好吧。",
              "dialogues": []
            }
            
          ]
        },
        {
          "role": "旅行者",
          "text": "可以是可以，不过只能抓到晶核。"
        },
        {
          "role": "「吉法师」",
          "text": "好棒！"
        },
         {
          "type": "subtitle",
          "text": "将1枚晶核交给吉法师"
        },
        {
          "role": "「吉法师」",
          "text": "砰砰~晶蝶~金色的晶蝶~"
        },
        {
          "type": "subtitle",
          "text": "与吉法师对话"
        },
        {
          "role": "「吉法师」",
          "text": "…"
        },
        {
          "role": "「吉法师」",
          "text": "不是金色。"
        },
        {
          "role": "派蒙",
          "text": "欸！震惊！居然不是金色的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "就算你们这么说…",
            "这个我也没办法。"
          ]
        },
        {
          "role": "派蒙",
          "text": "这么一想，虽然和你旅行的时候抓过很多晶蝶，但从来没注意过…"
        },
        {
          "role": "派蒙",
          "text": "有种…我有种自己突然长大了，有些幻想破灭了的感觉…？"
        },
        {
          "role": "旅行者",
          "text": "看来派蒙也需要修行。"
        },
        {
          "role": "「吉法师」",
          "text": "白毛加油。"
        },
        {
          "role": "派蒙",
          "text": "真是的，别给我加油啦！明明是吉法师要修行。"
        },
        {
          "role": "派蒙",
          "text": "不过，还是有点失望喔…为什么岩晶蝶的晶核不是金色的呢？"
        },
        {
          "role": "「吉法师」",
          "text": "对。晶蝶是金色，为什么不是金色。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "可能晶蝶就是这样的物种。",
            "就算你们问我我也不知道…"
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯…没办法了。总之，按原计划行动吧。我们带吉法师看看死兆星号！"
        },
         {
          "type": "subtitle",
          "text": "前往能看见死兆星号的地方"
        },
        {
          "role": "派蒙",
          "text": "看，死兆星号！"
        },
        {
          "role": "「吉法师」",
          "text": "好厉害！好多水！"
        },
        {
          "role": "「吉法师」",
          "text": "而且，好大！好大而且在水上！"
        },
        {
          "role": "「吉法师」",
          "text": "这么大，一定很重。为什么不会沉下去？"
        },
        {
          "role": "派蒙",
          "text": "因为死兆星号是船呀。"
        },
        {
          "role": "「吉法师」",
          "text": "但是，泥巴船就会沉。五百藏说过。兔子、妖狸、泥巴船的故事。"
        },
        {
          "role": "派蒙",
          "text": "嗯…不过，北斗的死兆星号不是泥巴做的，所以不会沉。"
        },
        {
          "role": "「吉法师」",
          "text": "为什么不是泥巴，就不会沉？"
        },
        {
          "role": "派蒙",
          "text": "吉法师说话倒是越来越流利了…不过应该怎么说呢…对了…"
        },
        {
          "role": "派蒙",
          "text": "哼哼，旅行者，让我考考你。为什么船能浮在水面上？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text":  "船是木头做的，草元素厉害。",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "欸？草元素有这样的作用吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…不过，为什么拿盾牌的丘丘人不能浮在水面上呢？"
        }
              ]
            },
            {
              "text":  "浮力大于重力，船就能浮起来。",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "原来是这样吗！嗯嗯我明白了。"
        }
              ]
            }
        
          ]
        },
       
        {
          "role": "「吉法师」",
          "text": "呜呶呶，听不懂。"
        },
        {
          "role": "派蒙",
          "text": "没关系，等吉法师长大以后，变得像派蒙一样聪明，就能明白了。为什么船能浮起来，为什么雪山会下雪，都能明白。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
             {
              "text": "我看你也不懂吧。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "喂！"
        }
              ]
            },
            {
              "text": "现在不用明白也行的。",
              "dialogues": []
            },
            {
              "text": "有些事情不明白也行的。",
              "dialogues": []
            }
          ]
        },
        
        {
          "role": "派蒙",
          "text": "不管怎么说，这里正好可以看到死兆星号，给吉法师留影吧！"
        },
        {
          "role": "「吉法师」",
          "text": "留影！画像！"
        },
        {
          "role": "派蒙",
          "text": "嗯，没错！吉法师站好别乱跑喔！"
        },
        {
          "type": "subtitle",
          "text": "为吉法师拍照"
        },
        {
          "type": "subtitle",
          "text": "与吉法师对话"
        },
        {
          "role": "派蒙",
          "text": "接下来，带吉法师我们去死兆星上看看吧！"
        },
        {
          "role": "「吉法师」",
          "text": "不好。船要是沉呶…"
        },
        {
          "role": "旅行者",
          "text": "这艘船不会沉的。"
        },
        {
          "role": "旅行者",
          "text": "我们就是坐这个船，去的稻妻。"
        },
        {
          "role": "派蒙",
          "text": "对呀！然后，我们才认识了五百藏和吉法师。不用担心！"
        },
        {
          "role": "「吉法师」",
          "text": "喔！原来是这样。"
        },
        {
          "role": "派蒙",
          "text": "而且北斗大姐头很可靠，南十字星的人也很可靠。所以呀，这艘船就是海上最安全的地方。"
        },
        {
          "role": "「吉法师」",
          "text": "呶！好！"
        },
         {
          "type": "subtitle",
          "text": "前往死兆星号"
        },
         {
          "type": "subtitle",
          "text": "登上桅杆"
        },
        {
          "role": "派蒙",
          "text": "你看！视线很好吧？"
        },
        {
          "role": "「吉法师」",
          "text": "呶，好厉害。"
        },
        {
          "role": "「吉法师」",
          "text": "那边好多山。是什么地方？"
        },
        {
          "role": "派蒙",
          "text": "嗯？那边的话…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "是稻妻。",
            "是你住的地方。"
          ]
        },
        {
          "role": "派蒙",
          "text": "没错！那边应该就是影向山。影向山下面，就是镇守之森。"
        },
        {
          "role": "「吉法师」",
          "text": "好远。五百藏在海的那边。"
        },
        {
          "role": "派蒙",
          "text": "嗯。不过，我们会陪你一起修行的！"
        },
        {
          "role": "「吉法师」",
          "text": "嗯！"
        },
        {
          "role": "派蒙",
          "text": "接下来，去什么地方好呢…"
        },
        {
          "role": "派蒙",
          "text": "唔，有没有什么对我们来说很熟悉，又有好吃的东西的地方呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙就想着吃。",
              "dialogues": [
                {
          "role": "「吉法师」",
          "text": "好吃的东西，好。"
        },
        {
          "role": "派蒙",
          "text": "旅行者你看，吉法师就比较懂。吃遍世界上好吃的东西，也是很重要的修行。"
        },
        {
          "role": "派蒙",
          "text": "如果不能理解这样的道理，吉法师很快就会超越你啦！"
        }
              ]
            },
            {
              "text": "这么说来，我也饿了。",
              "dialogues": []
            }
          ]
        },
        
        {
          "role": "派蒙",
          "text": "哎呀，不管怎么说，爬桅杆真累人呢。"
        },
        {
          "role": "「吉法师」",
          "text": "白毛要爬？明明会飞。"
        },
        {
          "role": "派蒙",
          "text": "别在意这种细节！"
        },
        {
          "role": "派蒙",
          "text": "总之，今天就到这里吧。接下来去什么地方，让我好好考虑一下。"
        },
        {
          "role": "「吉法师」",
          "text": "呶！"
        }
      ]
    }
  ]
}