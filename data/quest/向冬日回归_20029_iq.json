{
  "quest_id": 20029,
  "chapter_num": null,
  "chapter_title": "向冬日回归",
  "type": "iq",
  "route": "Return to Days of Winter",
  "stories": [
    {
      "story_id": 20029,
      "title": "向冬日回归",
      "description": "待在蒙德城的愚人众维克多先生终于接到了回国的命令…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与维克多对话"
        },
        {
          "role": "维克多",
          "text": "呼…总算能回去了…"
        },
        {
          "role": "旅行者",
          "text": "你要回国了吗？"
        },
        {
          "role": "维克多",
          "text": "啊？是你啊…"
        },
        {
          "role": "维克多",
          "text": "没错，我最近才刚接到上头的命令，让我回至冬去。"
        },
        {
          "role": "维克多",
          "text": "说是什么…我被调去另外一个执行官大人手下，暂时不用在蒙德这边待命了。"
        },
        {
          "role": "维克多",
          "text": "也不知道我到底被调去哪位执行官大人手下了，可千万别是「散兵」啊…"
        },
        {
          "role": "旅行者",
          "text": "你大概什么时候离开？"
        },
        {
          "role": "维克多",
          "text": "上头没说，只要我先把东西收拾好，到时候尽快出发。"
        },
        {
          "role": "维克多",
          "text": "哎呀，总算是能离开这破地方，不用天天吃修女的白眼了。"
        },
        {
          "role": "维克多",
          "text": "哦对了，旅行者，你看我们俩也合作了这么长时间了，你最后再帮我个忙呗。"
        },
        {
          "role": "维克多",
          "text": "和之前一样，你帮我忙，我付你报酬，绝对不让你白跑，怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你又要讲什么故事？",
              "dialogues": []
            },
            {
              "text": "你这里，愚人众的故事真是特别多…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维克多",
          "text": "哈哈哈，我这里能告诉你的「愚人众故事」已经全部讲完啦。"
        },
        {
          "role": "维克多",
          "text": "这次你帮我忙，我绝对付你真金白银的报酬，怎么样？"
        },
        {
          "role": "维克多",
          "text": "除非，你想听我给莉莉讲的那些童话故事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你要我帮什么忙？",
              "dialogues": []
            },
            {
              "text": "你还在陪莉莉玩？",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "我就是偶尔…偶尔陪她玩玩…"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "嗯…其实我这次想请你帮的忙，也和莉莉有关。"
        },
        {
          "role": "维克多",
          "text": "除了你之外，整个蒙德城里愿意听我这个「愚人众坏叔叔」说话的，估计也就只有莉莉这孩子了。"
        },
        {
          "role": "维克多",
          "text": "我要是走了，估计以后也不可能有机会再回蒙德城了…我就想最后送点礼物给莉莉做留念。"
        },
        {
          "role": "维克多",
          "text": "但你也知道，我要是自己上街买东西，指不定要吃多少白眼。"
        },
        {
          "role": "维克多",
          "text": "所以，这件事就拜托你了，旅行者。"
        },
        {
          "role": "维克多",
          "text": "你就去玛乔丽那边，帮我看看有什么适合送给小孩子的礼物吧。"
        },
        {
          "role": "维克多",
          "text": "呼…总算能回去了…"
        },
        {
          "role": "旅行者",
          "text": "你要回国了吗？"
        },
        {
          "role": "维克多",
          "text": "啊？是你啊…"
        },
        {
          "role": "维克多",
          "text": "没错，我最近才刚接到上头的命令，让我回至冬去。"
        },
        {
