{
  "quest_id": 10023,
  "chapter_num": "风花节 其三",
  "chapter_title": "雾与风之境",
  "type": "eq",
  "route": "Realm of Fog and Wind",
  "stories": [
    {
      "story_id": 41412,
      "title": "雾与风之境",
      "description": "看在美酒的份上，你和温迪不断为作业奔波。寒冷的地方、危险的地方、奇怪的地方…真不知道前面还有什么事件在等待着你们。更有趣的是，你逐渐发觉，人们对「风之花」的认知大不相同。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往炼金铺"
        },
        {
          "role": "派蒙",
          "text": "到了到了，这里就是蒂玛乌斯的炼金铺啦。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "你们是不是叫了我名字？"
        },
        {
          "role": "温迪",
          "text": "嗨，我先到了哦。"
        },
        {
          "role": "派蒙",
          "text": "蒂玛乌斯的作业做完了吗？哼哼哼，我要听我要听！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "呃…非常抱歉，我还没来得及写…"
        },
        {
          "role": "砂糖",
          "text": "蒂玛乌斯——！可以问问你的进度吗？"
        },
        {
          "role": "砂糖",
          "text": "咦，旅行者和他的朋友们也在这儿，你们好呀！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "砂糖拜托我帮她破译一份炼金配方，但这东西太难理解了，我、我看不懂！"
        },
        {
          "role": "砂糖",
          "text": "意思是说，你也没有进展？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "唉，是啊。"
        },
        {
          "role": "砂糖",
          "text": "呜呜，其实我也…没研究出来…"
        },
        {
          "role": "派蒙",
          "text": "唔？炼金术这么神秘的吗？"
        },
        {
          "role": "温迪",
          "text": "当然啦，炼金术这门学科古老又神秘。如今，掌握相关知识的人越来越少了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么不问神奇的阿贝多？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "对对，我也这么想！不过，阿贝多先生还在雪山写生，我们还有其他研究，一时走不开…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "依我看，要是连阿贝多先生也解读不了，世上就没人能看懂这份配方了！砂糖，这到底是什么玩意儿啊？"
        },
        {
          "role": "砂糖",
          "text": "是我从古书上抄写的「风之花」配方。"
        },
        {
          "role": "派蒙",
          "text": "咦！难道说，「风之花」不是自然生长的植物，而是炼金产物吗？"
        },
        {
          "role": "温迪",
          "text": "嗯哼？原来还有这种说法。"
        },
        {
          "role": "砂糖",
          "text": "不不，书上没说它是「风之花」的配方，是我的猜测！因为那本古书…呃，已经不能叫它书本了。"
        },
        {
          "role": "砂糖",
          "text": "它缺损得很严重，整本册子只剩几页零散笔记和一份用未知语言写成的配方。"
        },
        {
          "role": "砂糖",
          "text": "作者在笔记中提到，这是一份非常珍贵的配方。具体的内容文字，我跟蒂玛乌斯解读不了。"
        },
        {
          "role": "砂糖",
          "text": "我也知道这件事很不可思议，但、但是…这么珍贵的成品，我只能联想到「风之花」呀！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "啊？这…"
        },
        {
          "role": "温迪",
          "text": "哈哈，天马行空的想象力啊。"
        },
        {
          "role": "砂糖",
          "text": "所以旅行者，我有个不情之请。"
        },
        {
          "role": "砂糖",
          "text": "你能把这份配方带给阿贝多先生吗？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "阿贝多先生好像去了雪山脚下的营地。"
        },
        {
          "role": "温迪",
          "text": "嗯，雪山啊，真是有情调的地方呢。"
        },
        {
          "role": "派蒙",
          "text": "炼金术制造的「风之花」…好神奇，我也想知道。"
        },
        {
          "role": "派蒙",
          "text": "走吧，我们快去问问阿贝多！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（砂糖）"
        },
        {
          "role": "砂糖",
          "text": "呜…太期待了！"
        },
        {
          "role": "砂糖",
          "text": "古老的配方肯定不简单…希望阿贝多先生能顺利解读它。"
        },
        {
          "type": "subtitle",
          "text": "前往雪山脚下的营地"
        },
        {
          "role": "派蒙",
          "text": "阿贝多——！"
        },
        {
          "role": "阿贝多",
          "text": "嗯？旅行者和派蒙？还有这位是…？"
        },
        {
          "role": "派蒙",
          "text": "他是卖唱的！"
        },
        {
          "role": "温迪",
          "text": "叫温迪就好啦，我是个吟游诗人。"
        },
        {
          "role": "阿贝多",
          "text": "你好，我是炼金术士阿贝多。"
        },
        {
          "role": "派蒙",
          "text": "大好的风花节，人人都在庆祝，你却一个人待在这里。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一个人不寂寞吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "哦？那赶在大好节日跑来找我的你们，又是什么想法呢？"
        },
        {
          "role": "派蒙",
          "text": "我们在帮砂糖的忙！"
        },
        {
          "role": "派蒙",
          "text": "砂糖给了我们一张纸，说是古书上看来的「风之花」配方，她和蒂玛乌斯都看不懂，只能找你啦。"
        },
        {
          "role": "阿贝多",
          "text": "「风之花」配方？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "给你。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "阿贝多阅读了炼金配方…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "阿贝多",
          "text": "我明白了。纸上的是古代语言，难怪砂糖和蒂玛乌斯解读不出来。"
        },
        {
          "role": "阿贝多",
          "text": "不过，我认为它不是「风之花」的配方。"
        },
        {
          "role": "派蒙",
          "text": "那它会是什么呢？"
        },
        {
          "role": "阿贝多",
          "text": "目前我也只是猜测。要下结论，还得看成品。"
        },
        {
          "role": "阿贝多",
          "text": "可惜我手上还有工作，需要的材料清单我会列出来，搜集工作就交给各位了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿贝多）"
        },
        {
          "role": "阿贝多",
          "text": "这份配方年代久远，思路倒很新奇，值得一试。"
        },
        {
          "type": "subtitle",
          "text": "搜集三份星银矿石"
        },
        {
          "type": "subtitle",
          "text": "将材料交给阿贝多"
        },
        {
          "role": "温迪",
          "text": "收工喽——！"
        },
        {
          "role": "阿贝多",
          "text": "辛苦了，我来看看。"
        },
        {
          "role": "阿贝多",
          "text": "嗯，材料齐全。接下来我会进行炼制工作，你们稍等一下。"
        },
        {
          "type": "subtitle",
          "text": "阿贝多走到炼金台旁，开始炼制…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "阿贝多",
          "text": "完成了。"
        },
        {
          "role": "温迪",
          "text": "唔~哦~"
        },
        {
          "role": "派蒙",
          "text": "呜哇——这就是砂糖所说的「风之花」吗？它、它…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很亲切的长相。",
              "dialogues": []
            },
            {
              "text": "很熟悉的气味。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "根本就只是甜甜花而已呀——！"
        },
        {
          "role": "阿贝多",
          "text": "仔细看，它和一般的甜甜花有什么不同？"
        },
        {
          "role": "派蒙",
          "text": "呃…确实，这株甜甜花怎么会这么大…"
        },
        {
          "role": "阿贝多",
          "text": "这就是按古代配方炼制的所谓「风之花」。"
        },
        {
          "role": "阿贝多",
          "text": "哈哈，竟有几分砂糖的风格。"
        },
        {
          "role": "温迪",
          "text": "总觉得是那个女孩会喜欢的东西呢。"
        },
        {
          "role": "派蒙",
          "text": "这么大的甜甜花，还是甜甜花吗？"
        },
        {
          "role": "阿贝多",
          "text": "我可以负责任地说：是的，本质没什么区别。"
        },
        {
          "role": "派蒙",
          "text": "可是，砂糖说配方是从古书上抄下来的，难道…难道古代也有甜甜花？！"
        },
        {
          "role": "阿贝多",
          "text": "没错，古代也有甜甜花，这一物种历史悠久。"
        },
        {
          "role": "派蒙",
          "text": "古代也有？！甜甜花…它、它存在了那么久吗？！"
        },
        {
          "role": "阿贝多",
          "text": "对。"
        },
        {
          "role": "派蒙",
          "text": "哎哎哎哎——？！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "的确是砂糖会喜欢的东西。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "各位，我还要去山上写生，东西就劳烦你们转交了。"
        },
        {
          "role": "阿贝多",
          "text": "旅行者，祝你在庆典期间玩得开心。"
        },
        {
          "type": "subtitle",
          "text": "将「风之花」交给砂糖"
        },
        {
          "role": "温迪",
          "text": "砂糖小姐，你要的东西完成了。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "哦哦，你们回来了！"
        },
        {
          "role": "温迪",
          "text": "蒂玛乌斯，作业写好了吗？"
        },
        {
          "role": "砂糖",
          "text": "「风之花」完成了吗？！给我看看，给我看看！"
        },
        {
          "role": "派蒙",
          "text": "喏，这就是炼制出来的花啦。阿贝多说了，这东西完全就是…"
        },
        {
          "role": "砂糖",
          "text": "呀——！果然是我梦中的「风之花」！"
        },
        {
          "role": "派蒙",
          "text": "是甜甜花啊！"
        },
        {
          "role": "砂糖",
          "text": "不不不，请听我说，这是一份来自古代的配方，而成品如此完美，它正是我梦中的…梦中的…"
        },
        {
          "role": "砂糖",
          "text": "「四倍大种子甜甜花」！"
        },
        {
          "role": "派蒙",
          "text": "还有这事？"
        },
        {
          "role": "砂糖",
          "text": "四倍大种子甜甜花的种子有普通种子的四倍那么大，用四倍大种子种出来的甜甜花也就是四倍大甜甜花。"
        },
        {
          "role": "砂糖",
          "text": "更大、更强、更甜美，可以说是完美的提瓦特物种啦！而且而且，配方又来自很久远的历史之中…"
        },
        {
          "role": "砂糖",
          "text": "历史悠久的、完美而强大的花朵，不管别人怎么说，我的「风之花」就是它啦！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "不愧是砂糖，完全逻辑自洽。"
        },
        {
          "role": "砂糖",
          "text": "各位，我要去给我的「风之花」补充些养分，先告辞了。"
        },
        {
          "role": "温迪",
          "text": "哈哈，提到炼金术这么有热情，真好。"
        },
        {
          "role": "温迪",
          "text": "对了蒂玛乌斯，你的作业呢？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "刚刚写完，请老师过目。"
        },
        {
          "role": "派蒙",
          "text": "哦哦哦要来了，最喜欢的环节！"
        },
        {
          "role": "温迪",
          "text": "蒂玛乌斯，我能朗读你的作品吗？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "哎？！要、要读出来？这…"
        },
        {
          "role": "温迪",
          "text": "哈哈，别不好意思嘛，那我念咯。"
        },
        {
          "role": "温迪",
          "text": "「我和你在炼金炉前手拉手，火焰没有升起，因为爱火燃烧在我心中」。"
        },
        {
          "role": "派蒙",
          "text": "哇，既有感情，又有职业特色，真不错。"
        },
        {
          "role": "温迪",
          "text": "的确是意料之外的佳作，蒂玛乌斯，你很有天赋！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "真的吗？！哎呀，没想到我这样的人也能写出被人夸奖的情诗，果然是温迪老师指导得好。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "老师，等我手上的事忙完，就去准备给您的酬劳！"
        },
        {
          "role": "温迪",
          "text": "嗯嗯，好极了好极了！"
        },
        {
          "role": "温迪",
          "text": "呼~真是令人开心的工作呀。这么一来，作业应该也收得差不多了…嗯？"
        },
        {
          "role": "派蒙",
          "text": "嗯？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你们觉不觉得，好像漏了什么？"
        },
        {
          "role": "温迪",
          "text": "是谁呢，是谁呢，是谁呢——"
        },
        {
          "role": "派蒙",
          "text": "唔…唔…啊！"
        },
        {
          "role": "派蒙",
          "text": "那个叫班尼特的小子，去哪儿了？"
        },
        {
          "type": "subtitle",
          "text": "前往教堂与芭芭拉对话"
        },
        {
          "role": "派蒙",
          "text": "芭芭拉，我们有事想问你！"
        },
        {
          "role": "芭芭拉",
          "text": "旅行者，派蒙，诗人先生！"
        },
        {
          "role": "芭芭拉",
          "text": "不好了，班尼特失踪了！"
        },
        {
          "role": "温迪",
          "text": "失踪？意思是，那天他离开后再没回来过吗？"
        },
        {
          "role": "芭芭拉",
          "text": "是的，我担心他是不是遇到危险了，可又不知道他在哪里…"
        },
        {
          "role": "罗莎莉亚",
          "text": "千风神殿。"
        },
        {
          "role": "芭芭拉",
          "text": "咦，罗莎莉亚！"
        },
        {
          "role": "罗莎莉亚",
          "text": "你们在教堂里大喊大叫，刚巧被我听见而已。"
        },
        {
          "role": "派蒙",
          "text": "这么说来，那家伙好像说过…「我想起来了，是千风神殿！」"
        },
        {
          "role": "温迪",
          "text": "事不宜迟，我们赶快去千风神殿看看吧。"
        },
        {
          "type": "subtitle",
          "text": "前往千风神殿"
        },
        {
          "role": "派蒙",
          "text": "一路走来，并没有看到疑似班尼特的人。"
        },
        {
          "role": "派蒙",
          "text": "快看那边！"
        },
        {
          "role": "？？？",
          "text": "有声音？！雷泽，有人来了！也许是来救我们的！"
        },
        {
          "role": "温迪",
          "text": "旅行者，小心敌人哦~"
        },
        {
          "type": "subtitle",
          "text": "击败遗迹守卫"
        },
        {
          "type": "subtitle",
          "text": "寻找班尼特"
        },
        {
          "type": "subtitle",
          "text": "与班尼特对话"
        },
        {
          "role": "派蒙",
          "text": "啊，在这里！班尼特，我们来救…呃啊，这个牢房怎么有两层！"
        },
        {
          "role": "班尼特",
          "text": "看我说什么来着，谁见了这间牢房都要大吃一惊！"
        },
        {
          "role": "派蒙",
          "text": "真亏你们能分别关在两边啊…"
        },
        {
          "role": "温迪",
          "text": "好高超的设计，是古代机关吧？"
        },
        {
          "role": "班尼特",
          "text": "这东西一定有机关，能麻烦你们在附近找找吗？"
        },
        {
          "role": "雷泽",
          "text": "肚子…有点饿…"
        },
        {
          "role": "班尼特",
          "text": "你明明才刚吃了我包里的苹果！"
        },
        {
          "role": "温迪",
          "text": "看起来你们的狱中生活还挺不错，就在这儿待着如何？"
        },
        {
          "role": "班尼特",
          "text": "不不不不，别开玩笑了！算我求你，快去找找机关好吗？"
        },
        {
          "type": "subtitle",
          "text": "打开机关"
        },
        {
          "type": "subtitle",
          "text": "与班尼特和雷泽对话"
        },
        {
          "role": "温迪",
          "text": "开门啦——"
        },
        {
          "role": "班尼特",
          "text": "啊！总算出来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们是怎么做到的？",
              "dialogues": []
            },
            {
              "text": "居然能被关成这样。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "雷泽",
          "text": "很…突然…"
        },
        {
          "role": "班尼特",
          "text": "啊哈哈，我倒没觉得突然，反正对我来说也算是生活的常态了…"
        },
        {
          "role": "雷泽",
          "text": "对不起。"
        },
        {
          "role": "班尼特",
          "text": "别道歉啊，又不是你的错。"
        },
        {
          "role": "温迪",
          "text": "请问，我们可以听听二位的故事吗？"
        },
        {
          "role": "班尼特",
          "text": "先等等，那封恐吓信怎么样了？"
        },
        {
          "role": "派蒙",
          "text": "那个不是真的，只是粉丝引起注意的送礼手段而已。"
        },
        {
          "role": "班尼特",
          "text": "什么…"
        },
        {
          "role": "班尼特",
          "text": "可恶，就为了这种理由！我可是被关了整整一天啊！"
        },
        {
          "role": "雷泽",
          "text": "对、对不起…"
        },
        {
          "role": "班尼特",
          "text": "不不，雷泽，我不是说你…都说了不要道歉啊！"
        },
        {
          "role": "班尼特",
          "text": "也怪我太莽撞，没看清地图就选择了错误的目的地…唉，我离开大教堂之后，直接到了千风神殿一带。"
        },
        {
          "role": "班尼特",
          "text": "这一带怪物好多，还有遗迹守卫！好大好大的那个，你们应该见过吧。"
        },
        {
          "role": "班尼特",
          "text": "但我是一流冒险家，凭借机敏的行动绕开了它，来到神殿深处…"
        },
        {
          "role": "班尼特",
          "text": "正在这时，我听到了怪物的吼叫声！"
        },
        {
          "role": "派蒙",
          "text": "啊，好像已经看到结局了。"
        },
        {
          "role": "班尼特",
          "text": "我想，难道这就是那些坏人准备的陷阱，而我堂堂冒险家班尼特，班尼冒险团团长，绝不退缩！"
        },
        {
          "role": "班尼特",
          "text": "于是我立刻冲了进去！…然后在里面，发现了他。"
        },
        {
          "role": "派蒙",
          "text": "雷泽，你怎么会跑到千风神殿来呀？"
        },
        {
          "role": "雷泽",
          "text": "奔狼领…很多…猎人。"
        },
        {
          "role": "雷泽",
          "text": "很吵…我走了…"
        },
        {
          "role": "温迪",
          "text": "一路走到了千风神殿，然后呢？被困在机关里了吗？"
        },
        {
          "role": "雷泽",
          "text": "嗯嗯。"
        },
        {
          "role": "班尼特",
          "text": "这间牢房太阴险了，有里外两层！我看见雷泽被机关困在牢房内，当然是选择救他了，谁知…"
        },
        {
          "role": "班尼特",
          "text": "一声巨响，另一扇牢门也落了下来。"
        },
        {
          "role": "派蒙",
          "text": "嗯，意料之中呢。"
        },
        {
          "role": "班尼特",
          "text": "话说回来，你们怎么会到千风神殿来？"
        },
        {
          "role": "温迪",
          "text": "班尼特，还记得你的作业吗？我可是等着批改完拿酬劳的哦。"
        },
        {
          "role": "班尼特",
          "text": "哦哦，情诗嘛！当然记得啦！"
        },
        {
          "role": "班尼特",
          "text": "在牢里关了一天一夜，闲着也是闲着，干脆就写完了，还让雷泽审评过。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？他写得怎么样？"
        },
        {
          "role": "雷泽",
          "text": "呃…呃…"
        },
        {
          "role": "雷泽",
          "text": "不懂。但是…暖暖的，麻麻的…"
        },
        {
          "role": "雷泽",
          "text": "像被…钩钩果…刺到。"
        },
        {
          "role": "温迪",
          "text": "班尼特，可以朗读你的作品吗？"
        },
        {
          "role": "班尼特",
          "text": "噢，好啊！让大家看看我的实力，嘿嘿。"
        },
        {
          "role": "派蒙",
          "text": "来了来了来了，旅行者，快拍手！"
        },
        {
          "role": "温迪",
          "text": "「你和烬寂海，很近 又很远，一个在大陆另一边 一个在我心里，钩钩果和蒲公英，我的『风之花』献给你」。"
        },
        {
          "role": "派蒙",
          "text": "咦？钩钩果？"
        },
        {
          "role": "班尼特",
          "text": "怎、怎么样，还行…吧？"
        },
        {
          "role": "派蒙",
          "text": "唔，也是很有个人风格的作品呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "充满冒险家协会气息。",
              "dialogues": []
            },
            {
              "text": "踏实又饱满的爱意。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "很不错的作品哦。朴实中透着真心，既亲切又有代入感。"
        },
        {
          "role": "班尼特",
          "text": "谢谢，谢谢老师！"
        },
        {
          "role": "雷泽",
          "text": "太好了，班尼特！"
        },
        {
          "role": "班尼特",
          "text": "嗯！也谢谢你，雷泽！"
        },
        {
          "role": "派蒙",
          "text": "可喜可贺可喜可贺！"
        },
        {
          "role": "派蒙",
          "text": "不过，钩钩果和蒲公英…？都是「风之花」吗？"
        },
        {
          "role": "班尼特",
          "text": "这个啊，是我问雷泽「你觉得『风之花』是什么？」他回答钩钩果。"
        },
        {
          "role": "雷泽",
          "text": "嗯！钩钩果…好。"
        },
        {
          "role": "派蒙",
          "text": "原来，果子也算啊…"
        },
        {
          "role": "温迪",
          "text": "嗯，观点很新奇。"
        },
        {
          "role": "班尼特",
          "text": "啊，真高兴啊，今天运气不错呢。"
        },
        {
          "role": "班尼特",
          "text": "被困在这种地方，都能有人来救我，还表扬了我写的诗，太棒了！等回到蒙德，我马上给老师买酒！"
        },
        {
          "role": "派蒙",
          "text": "班尼特…要求好低…"
        },
        {
          "role": "班尼特",
          "text": "哈哈哈哈，别这么说嘛。我知道我的运气不太好，但…生活总要继续，对吧。"
        },
        {
          "role": "雷泽",
          "text": "嗯，加油！"
        },
        {
          "role": "班尼特",
          "text": "你这家伙！哈哈哈！"
        },
        {
          "role": "温迪",
          "text": "各位，我有个好消息。"
        },
        {
          "role": "温迪",
          "text": "情诗速成班所有学生的作业都收齐啦！"
        },
        {
          "role": "派蒙",
          "text": "太好啦！"
        },
        {
          "role": "温迪",
          "text": "为表庆祝，一起去酒馆喝一杯吧！"
        },
        {
          "role": "班尼特",
          "text": "各位，我和雷泽先告辞了。他说他知道一些稀有探险地点，要带我去看看。祝你们玩得开心！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（班尼特、雷泽）"
        },
        {
          "role": "班尼特",
          "text": "唉，怎么会有这么阴险的机关！"
        },
        {
          "role": "雷泽",
          "text": "啊…饿了。"
        },
        {
          "role": "班尼特",
          "text": "我包里还有个苹果，给你吃吧。"
        },
        {
          "type": "subtitle",
          "text": "前往天使的馈赠"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "派蒙",
          "text": "老板，我们来啦！"
        },
        {
          "role": "迪卢克",
          "text": "欢迎光临，随便找空位坐吧。"
        },
        {
          "role": "派蒙",
          "text": "咦咦咦？迪卢克老爷！"
        },
        {
          "role": "凯亚",
          "text": "哟，我还想着喝完酒去找你们，你们就主动出现了。"
        },
        {
          "role": "温迪",
          "text": "好热闹呀。"
        },
        {
          "role": "凯亚",
          "text": "毕竟现在是风花节嘛，有闲有钱的蒙德人都会到酒馆坐坐。"
        },
        {
          "role": "凯亚",
          "text": "旅行者，你也来喝酒吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯亚",
          "text": "没关系，喝不喝都行，重要的是感受节日气氛。"
        },
        {
          "role": "凯亚",
          "text": "琴团长托我转达，你已被选为本届的「风花节之星」。这可是殊荣啊！"
        },
        {
          "role": "派蒙",
          "text": "「风花节之星」？"
        },
        {
          "role": "凯亚",
          "text": "「风花节之星」是蒙德至高荣誉之一，通常只会颁给对蒙德有巨大贡献或是在风花节期间表现最为突出的人。"
        },
        {
          "role": "迪卢克",
          "text": "你来蒙德以后帮了大家许多，这是人们对你的感谢。"
        },
        {
          "role": "凯亚",
          "text": "没错，心怀感激地领受吧。喔，对了，还有一件事。"
        },
        {
          "role": "凯亚",
          "text": "「风花节之星」需要与骑士团长一同出席风花典礼。在这个仪式上，你会代表蒙德人民向风神巴巴托斯献上「风之花」。"
        },
        {
          "role": "派蒙",
          "text": "可是，「风之花」究竟是哪种花呀？"
        },
        {
          "role": "凯亚",
          "text": "嗯，好问题。迪卢克，你觉得呢？"
        },
        {
          "role": "迪卢克",
          "text": "传达口信和讲解仪式好像是你的工作吧。"
        },
        {
          "role": "凯亚",
          "text": "唉，好没幽默感的人。"
        },
        {
          "role": "凯亚",
          "text": "旅行者，「风之花」向来由风花节之星决定。所以，这次庆典为风神献上哪种花，是你说了算。"
        },
        {
          "role": "派蒙",
          "text": "好重大的责任呢。"
        },
        {
          "role": "温迪",
          "text": "对了，酒保呢？怎么是迪卢克老爷在调酒？"
        },
        {
          "role": "罗莎莉亚",
          "text": "找查尔斯的话，他出去送外卖了。"
        },
        {
          "role": "凯亚",
          "text": "哈哈哈哈，谁让风花节期间点酒水外卖的人太多了呢！"
        },
        {
          "role": "迪卢克",
          "text": "…哼。"
        },
        {
          "role": "温迪",
          "text": "原来如此，那迪卢克老爷调酒的手艺如何啊？"
        },
        {
          "role": "凯亚",
          "text": "身手不凡的修女阁下，你觉得呢？"
        },
        {
          "role": "罗莎莉亚",
          "text": "还不错吧。"
        },
        {
          "role": "派蒙",
          "text": "身手不凡？你们打架了吗？"
        },
        {
          "role": "凯亚",
          "text": "误会而已。罗莎莉亚小姐从骑士团窗外疾驰而过，被我误认为可疑人物。幸好我发现得早，及时住手了。"
        },
        {
          "role": "派蒙",
          "text": "啊——！原来那天的可疑人影是罗莎莉亚！"
        },
        {
          "role": "迪卢克",
          "text": "总是注意着蒙德人的一举一动，你可真不像普通修女。"
        },
        {
          "role": "罗莎莉亚",
          "text": "彼此彼此。迪卢克老爷也完全不像普通富商呢。"
        },
        {
          "role": "凯亚",
          "text": "罗莎莉亚小姐真会开玩笑。在座诸位，难道有来头很小的人物吗？"
        },
        {
          "role": "凯亚",
          "text": "连大名鼎鼎的荣誉骑士都来酒馆作客，今天果然是喝酒的好日子啊。"
        },
        {
          "role": "温迪",
          "text": "说得对，那么凯亚，你的学费准备好了吗？"
        },
        {
          "role": "凯亚",
          "text": "直接找迪卢克老爷领取就行。三瓶酒，花了我不少钱呢。"
        },
        {
          "role": "迪卢克",
          "text": "酒越好价越贵，理所应当的事。"
        },
        {
          "role": "罗莎莉亚",
          "text": "旅行者，风花节好玩吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，不错哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "罗莎莉亚",
          "text": "是吗，那就好。"
        },
        {
          "role": "凯亚",
          "text": "来吧各位，为了愉快的风花节和自由的蒙德人，干杯！"
        },
        {
          "role": "众人",
          "text": "干杯——！"
        },
        {
          "role": "温迪",
          "text": "啊哈哈，真是个好节日啊，我们也喝点吧。"
        },
        {
          "role": "派蒙",
          "text": "卖唱的，别光顾你自己，我也要吃好吃的！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（罗莎莉亚、迪卢克、凯亚）"
        },
        {
          "role": "罗莎莉亚",
          "text": "跟大教堂比起来，酒馆真是个好地方。说起来，这种节日应该放几天假才对吧。为什么教会不放假？"
        },
        {
          "role": "迪卢克",
          "text": "查尔斯那家伙，动作真慢。"
        },
        {
          "role": "凯亚",
          "text": "我说，酒馆的菜单上也该加点前菜主菜了吧？光是喝酒，嘴里有点寂寞呀。"
        },
        {
          "role": "迪卢克",
          "text": "哼，说得轻巧。"
        },
        {
          "type": "subtitle",
          "text": "离开酒馆"
        }
      ],
      "collapse_ranges": [
        [
          32,
