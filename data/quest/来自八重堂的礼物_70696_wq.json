{
  "quest_id": 70696,
  "chapter_num": null,
  "chapter_title": "来自八重堂的礼物",
  "type": "wq",
  "route": "A Gift From Yae Publishing House",
  "stories": [
    {
      "story_id": 70696,
      "title": "来自八重堂的礼物",
      "description": "神子正在八重堂内翻阅近期新作，她似乎也听闻了龙脊雪山国际越野赛的讯息…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与八重神子对话"
        },
        {
          "role": "八重神子",
          "text": "好久不见了，小家伙。最近去哪儿旅行了？"
        },
        {
          "type": "subtitle",
          "text": "将雪山的见闻告知了神子。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "八重神子",
          "text": "嗯，真是群可爱的孩子呀。"
        },
        {
          "role": "八重神子",
          "text": "为了共同的爱好，不管相隔多远也要相聚……啊呀，青春的气息真是扑面而来。"
        },
        {
          "role": "八重神子",
          "text": "看来《炽魂斗士战记》的魅力不小呢，是时候把再版计划提上日程了…"
        },
        {
          "role": "八重神子",
          "text": "读者们这么真诚，我也必须表示一下心意才行呢。"
        },
        {
          "role": "八重神子",
          "text": "给你们赠送一些漫画如何？嗯…人不少，得多送几本。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你。",
              "dialogues": []
            },
            {
              "text": "会和大家分享的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "都是初版印刷品，外面可买不到，好好珍惜哦。"
        },
        {
          "type": "subtitle",
          "text": "返回营地放置礼物"
        },
        {
          "role": "派蒙",
          "text": "神子送了我们不少漫画，既然决定了要和大家分享，干脆就把它们都摆出来吧。"
        },
        {
          "role": "派蒙",
          "text": "就放在「特战队」营地书摊附近吧，方便大家拿去看。"
        },
        {
          "type": "subtitle",
          "text": "借来一个书柜，将神子赠送的漫画都放了进去。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "不错不错，这样一来，大家空闲的时候就能来挑漫画了。"
        }
      ]
    }
  ]
}