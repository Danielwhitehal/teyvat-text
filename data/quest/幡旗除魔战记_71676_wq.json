{
  "quest_id": 71676,
  "chapter_num": null,
  "chapter_title": "幡旗除魔战记",
  "type": "wq",
  "route": "Battle Beneath the Spirit-Quelling Banner",
  "stories": [
    {
      "story_id": 71676,
      "title": "幡旗除魔战记",
      "description": "说书人捷悟和纸映戏专家报菲似乎正在讨论他们的新作品…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "参与捷悟和报菲的讨论"
        },
        {
          "role": "捷悟",
          "text": "正似这热火朝天的美食街，璃月蒙德枫丹和稻妻，哪儿的客人都有…"
        },
        {
          "role": "捷悟",
          "text": "底色各异的朋友聚在一起，故事自然少不了新意…"
        },
        {
          "role": "报菲",
          "text": "的确，现在的年轻人都热衷于各种题材的碰撞，我也一样！"
        },
        {
          "role": "派蒙",
          "text": "看起来，你们两位都挺开心的？在聊什么呢？"
        },
        {
          "role": "捷悟",
          "text": "正好来了两位仪表不凡的客人。"
        },
        {
          "role": "报菲",
          "text": "要不要来体验一下「纸映斗阵」？能帮你们愉愉快快消消食哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看起来有点眼熟…",
              "dialogues": []
            },
            {
              "text": "是纸映剧的变体？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "捷悟",
          "text": "不错，小友好眼力。这是一部讲述「幡旗除魔」的新锐互动纸映剧。"
        },
        {
          "role": "捷悟",
          "text": "一位术士游历各国，安抚战士们散落各地的魂灵，打造了一面「幡旗」，从而借助战魂们的力量祓除邪祟。"
        },
        {
          "role": "报菲",
          "text": "然后然后，我来说！"
        },
        {
          "role": "报菲",
          "text": "凭借着超厉害的战魂「暝视冰晶龙炮手」、「决战机兵·领主型」与「十二天尊曼陀草」…"
        },
        {
          "role": "报菲",
          "text": "这位术士独自平定了一方灾祸，然后开始向着死对头的城塞进发，要讨伐那位魔道中人。"
        },
        {
          "role": "报菲",
          "text": "后面的故事还没想好怎么写，就先在这断章吧。"
        },
        {
          "role": "派蒙",
          "text": "璃月的术士…召唤龙武士、机兵和曼陀草的英魂…消灭邪祟和魔道中人？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是轻小说级的主题喔？",
              "dialogues": []
            },
            {
              "text": "能展开写的情节还不少…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "报菲",
          "text": "确实，捷悟先生提出这个点子的时候，我一下子就沉浸到故事的推想里去了。"
        },
        {
          "role": "捷悟",
          "text": "要说灵感来源，还得感谢那位往生堂的堂主啊。"
        },
        {
          "role": "捷悟",
          "text": "我只是听了[[胡桃|胡堂主]]的几首打油诗，受到了深深的震撼——"
        },
        {
          "role": "捷悟",
          "text": "原来，只需要将寻常可见的元素结合起来，就算故事不复杂，也能给人一种醍醐灌顶般的冲击感。"
        },
        {
          "role": "捷悟",
          "text": "有些时候，无比离奇的母题也倍儿棒啊，和跌宕起伏的情节不相上下！"
        },
        {
          "role": "捷悟",
          "text": "所以我找来了报菲，用她擅长的形式，对故事和表现手法稍加改进，便有了现在的「纸映斗阵」。"
        },
        {
          "role": "报菲",
          "text": "捷悟叔叔有礼了，我一直想创作这样新奇的作品！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来胡桃的影响力如此之广…",
              "dialogues": []
            },
            {
              "text": "打油诗也能促成新的作品啊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "听起来还挺不一般的，也是我们感兴趣的题材。那我们也来玩玩看吧，说不定还能给你们一些建议呢？"
        },
        {
          "role": "派蒙",
          "text": "毕竟，我们也见过各种各样强大的战士，可以说是收集了许多高手资料的战斗专家嘛。"
        },
        {
          "role": "捷悟",
          "text": "如此甚好，如此甚好啊！"
        },
        {
          "role": "报菲",
          "text": "那我备好纸笔，等你们的新建议。"
        },
        {
          "role": "报菲",
          "text": "希望二位能享受这部作品~"
        },
        {
          "type": "subtitle",
          "text": "额外对话（报菲）"
        },
        {
          "role": "报菲",
          "text": "朋友，玩一局「纸映斗阵」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就开战吧！",
              "dialogues": [
                {
                  "role": "报菲",
                  "text": "气势如虹啊！愿你打出五彩斑斓的效果！"
                }
              ]
            },
            {
              "text": "你好像很喜欢这种故事？",
              "dialogues": [
                {
                  "role": "报菲",
                  "text": "嗯？是说各种不同势力的混战吗？"
                },
                {
                  "role": "报菲",
                  "text": "那当然了！在传统故事里加入一些新元素，就会诞生超级吸引人的亮点嘛！"
                },
                {
                  "role": "报菲",
                  "text": "不过，捷悟先生说，也有人反映过，「戏说也要有个限度」之类的道理。"
                },
                {
                  "role": "报菲",
                  "text": "我觉得他们说得也没错，要是改编故事只顾着好玩有趣，一些深刻的寓意就会被消解了。"
                },
                {
                  "role": "报菲",
                  "text": "因此，我们今后只会改编一些流行的通俗故事，对于比较严肃的民俗传说，还是要保持慎重。"
                },
                {
                  "role": "报菲",
                  "text": "这中间的平衡之术，还得好好钻研钻研啊…"
                }
              ]
            },
            {
              "text": "之后再来玩。",
              "dialogues": [
                {
                  "role": "报菲",
                  "text": "随时可以来看热血沸腾的战斗，等你哦！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（捷悟）"
        },
        {
          "role": "捷悟",
          "text": "哎呀哎呀，这次的故事讲得有意思，选角也相当精妙…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "选角是怎么定的？",
              "dialogues": [
                {
                  "role": "捷悟",
                  "text": "哦？你是说「暝视冰晶龙炮手」和「十二天尊曼陀草」？"
                },
                {
                  "role": "捷悟",
                  "text": "那可有门道了…"
                },
                {
                  "role": "捷悟",
                  "text": "我们听去过纳塔的冒险家说，纳塔的冒险家分会有一位名为[[莉琉]]的战士…"
                },
                {
                  "role": "捷悟",
                  "text": "她与她的好友[[莉莱]]、[[莎孚]]，都是一等一的高手，清剿过大量魔物。"
                },
                {
                  "role": "捷悟",
                  "text": "因此，为了强调异域勇士的要素，便选择了「烟谜主」部族的豪杰们。"
                },
                {
                  "role": "捷悟",
                  "text": "至于「十二天尊曼陀草」嘛…"
                },
                {
                  "role": "捷悟",
                  "text": "前些日子，有个咱们这边的乐手，[[辛焱]]大师，去了趟挪德卡莱。"
                },
                {
                  "role": "捷悟",
                  "text": "她为了取材，走遍那片地区，仔细聆听了各种各样的声音…"
                },
                {
                  "role": "捷悟",
                  "text": "其中就有一种叫曼陀草的生物，据说能发出非常空灵的声响。"
                },
                {
                  "role": "捷悟",
                  "text": "不过我们这只曼陀草，相比盘踞当地北部的那只…有名草，体格要含蓄一些…"
                },
                {
                  "role": "捷悟",
                  "text": "根据计算，应该就是普通品种的十二倍大，所以就用这个称号了。"
                },
                {
                  "role": "捷悟",
                  "text": "听起来也挺有趣吧！"
                }
              ]
            },
            {
              "text": "你认识胡堂主？",
              "dialogues": [
                {
                  "role": "捷悟",
                  "text": "璃月谁人不识堂主？尤其是我这种…强调说书要通俗易懂的…"
                },
                {
                  "role": "捷悟",
                  "text": "多少得背几首堂主的诗，学学怎么用简练的话，讲清楚有趣的意象。"
                },
                {
                  "role": "捷悟",
                  "text": "只可惜，堂主来我们茶馆品茶的次数不算多，不然，我可得好好向她请教请教作诗的思路了。"
                }
              ]
            },
            {
              "text": "那我多看看多玩玩。",
              "dialogues": [
                {
                  "role": "捷悟",
                  "text": "祝你玩得顺心！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          29,
          31
        ],
        [
          32,
          34
        ]
      ]
    }
  ]
}