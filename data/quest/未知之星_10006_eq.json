{
  "quest_id": 10006,
  "chapter_num": "未归的熄星 其一",
  "chapter_title": "未知之星",
  "type": "eq",
  "route": "Unknown Star",
  "stories": [
    {
      "story_id": 41111,
      "title": "未知之星",
      "description": "蒙德冒险家协会的凯瑟琳似乎有话要对你说。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往蒙德冒险家协会找凯瑟琳"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，你来得正好。"
        },
        {
          "role": "派蒙",
          "text": "凯瑟琳，出什么事了吗？"
        },
        {
          "role": "凯瑟琳",
          "text": "是的，发生了一件不得不请冒险家们出手相助的大事。"
        },
        {
          "role": "凯瑟琳",
          "text": "有非常紧急的任务要委托给你，旅行者。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…听起来很严重的样子…"
        },
        {
          "role": "凯瑟琳",
          "text": "实不相瞒，我们也是第一次遇到这种事。"
        },
        {
          "role": "凯瑟琳",
          "text": "协会里忙得不可开交，也要靠各位在外游历的冒险家齐心协力了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "义不容辞。",
              "dialogues": []
            },
            {
              "text": "谢谢你告诉我，我马上动身。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "请稍等，安全起见…"
        },
        {
          "role": "菲谢尔",
          "text": "凯瑟琳！幽夜净土的子民啊，莫非是你在虔诚地高呼本皇女之尊名？"
        },
        {
          "role": "凯瑟琳",
          "text": "啊，来了来了。"
        },
        {
          "role": "奥兹",
          "text": "又见面了，凯瑟琳女士。"
        },
        {
          "role": "派蒙",
          "text": "啊！这只乌鸦会说话？！"
        },
        {
          "role": "奥兹",
          "text": "哈哈，何必为这等小事惊讶呢，我的朋友。"
        },
        {
          "role": "菲谢尔",
          "text": "我忠诚的臣属，看你一脸忧虑，想必是那些罪愆邪佞又一次妄图染指蒙德的安宁吧。"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，这位是蒙德冒险家协会的资深成员菲谢尔。"
        },
        {
          "role": "凯瑟琳",
          "text": "菲谢尔，奥兹，这位就是我提起过的旅行者。"
        },
        {
          "role": "菲谢尔",
          "text": "哦？就是你吗？哼…眼神不错。"
        },
        {
          "role": "奥兹",
          "text": "西风骑士团荣誉骑士与其旅伴派蒙。久仰了，很高兴见到二位。"
        },
        {
          "role": "菲谢尔",
          "text": "旅人，你也想要对抗那无边深邃的黑暗结晶吗？"
        },
        {
          "role": "派蒙",
          "text": "对抗…什么什么黑暗？黑暗什么？"
        },
        {
          "role": "旅行者",
          "text": "凯瑟琳，你刚才说的不是这个。"
        },
        {
          "role": "奥兹",
          "text": "小姐说的，就是那些{{颜色|蓝|陨石}}。"
        },
        {
          "role": "凯瑟琳",
          "text": "协会方面还不能确定陨石雨的成因及副作用。因此，我们希望冒险家能够组成二人小队。"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，菲谢尔，希望你们能彼此关照，在保证自身安全的前提下行动。"
        },
        {
          "role": "菲谢尔",
          "text": "哼，既然是忠诚的凯瑟琳的请求，本皇女也只能允诺了。"
        },
        {
          "role": "菲谢尔",
          "text": "雀跃吧！能与断罪的皇女菲谢尔一同踏上征途，你之余生都应为此感到骄傲！"
        },
        {
          "role": "奥兹",
          "text": "这位是我的主人，来自异界·幽夜净土的皇女菲谢尔，我是她的眷属夜鸦，奥兹。"
        },
        {
          "role": "派蒙",
          "text": "好、好有来头的人呢…"
        },
        {
          "role": "派蒙",
          "text": "我是派蒙，他是旅行者，请多关照啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你刚刚说，异世界？",
              "dialogues": []
            },
            {
              "text": "幽夜净土…我还是第一次听说。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "呃，以后你会慢慢明白的…只要和菲谢尔相处久了，就能明白…"
        },
        {
          "role": "菲谢尔",
          "text": "区区旅人，未曾领略无尽幽夜净土的伟大也是意料之中。无妨，我宽恕你。"
        },
        {
          "role": "派蒙",
          "text": "宽恕？"
        },
        {
          "role": "奥兹",
          "text": "她的意思是「你好」。"
        },
        {
          "role": "派蒙",
          "text": "这两个人从刚才开始就像唱双簧一样…主人神秘兮兮的，眷属却时不时拆台，好奇怪！"
        },
        {
          "role": "奥兹",
          "text": "二位想必有很多疑问，我们不如边走边说。"
        },
        {
          "role": "派蒙",
          "text": "话说回来，我们哪是二人小队，明明是四人小队啊…"
        },
        {
          "type": "subtitle",
          "text": "前往清泉镇查看情况"
        },
        {
          "role": "派蒙",
          "text": "这里就是凯瑟琳所说离蒙德最近的事发地点，清泉镇。"
        },
        {
          "role": "奥兹",
          "text": "看来，情况比预想还严重。"
        },
        {
          "role": "旅行者",
          "text": "许多人倒下了。"
        },
        {
          "role": "菲谢尔",
          "text": "祝圣之钟当鸣！断罪之时已至！赞颂吧，呼唤救赎的人，只因「断罪皇女」降临此间！"
        },
        {
          "role": "派蒙",
          "text": "这位皇女还真是有干劲啊！"
        },
        {
          "type": "subtitle",
          "text": "调查附近的病患（0/3）"
        },
        {
          "role": "菲谢尔",
          "text": "凡人，本皇女恩许你免却礼节，就这样将机要线索悉数禀报吧。"
        },
        {
          "role": "乔伊斯",
          "text": "哎？你是？"
        },
        {
          "role": "奥兹",
          "text": "无意冒犯，先生。只是想请您透露一些有关病患的信息。"
        },
        {
          "role": "派蒙",
          "text": "啊啊请不要误会！我们是冒险家协会成员，受委托前来调查情况的！"
        },
        {
          "role": "乔伊斯",
          "text": "噢，好的。昨天晚上，这个人摸了地上的陨石，很快便昏睡过去。"
        },
        {
          "role": "乔伊斯",
          "text": "所以，你们调查时千万不能直接触碰陨石。"
        },
        {
          "role": "菲谢尔",
          "text": "粗莽的进谏。本皇女自有渊色秘珠秘法加护，区区黑晶可奈我何？"
        },
        {
          "role": "奥兹",
          "text": "不不，小姐，您是皇女，有必要听取正确的谏言。"
        },
        {
          "role": "菲谢尔",
          "text": "是吗…看来只能照办了。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，您是…您是冒险家，有必要听取正确的谏言！"
        },
        {
          "role": "旅行者",
          "text": "好、好吧。"
        },
        {
          "role": "派蒙",
          "text": "难得说说这种话，感觉还不错呢！"
        },
        {
          "role": "菲谢尔",
          "text": "是在模仿本皇女吗？哼，一千世界寂灭的悲愿岂是凡人所能领会！"
        },
        {
          "role": "菲谢尔",
          "text": "不过也好。毕竟对你而言，「断罪皇女」的命运还是太过沉重了。"
        },
        {
          "role": "旅行者",
          "text": "请、请皇女移驾。"
        },
        {
          "type": "subtitle",
          "text": "调查附近的病患（1/3）"
        },
        {
          "role": "派蒙",
          "text": "这里也有人倒下了！"
        },
        {
          "role": "菲谢尔",
          "text": "骑士，请回应本皇女的询查。这个不幸之人情况如何？"
        },
        {
          "role": "阿德勒",
          "text": "呃，他…他已经睡了一整天，还没有醒来的迹象。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是因为接触了陨石吗？",
              "dialogues": [
                {
                  "role": "阿德勒",
                  "text": "是的。睡得很沉，还有梦话。"
                }
              ]
            },
            {
              "text": "除了昏睡，还有其他症状吗？",
              "dialogues": [
                {
                  "role": "阿德勒",
                  "text": "暂时没有。不过，他偶尔会说梦话。"
                }
              ]
            }
          ]
        },
        {
          "role": "昏睡的病患",
          "text": "走不动了…真的，休息一会儿吧…"
        },
        {
          "role": "派蒙",
          "text": "他…他这是在干什么呀…"
        },
        {
          "role": "菲谢尔",
          "text": "黑暗之梦正如同衔着艾登果实的凶兽，它夤夜般深黑的双目会使弱小之辈坠入深渊…"
        },
        {
          "role": "派蒙",
          "text": "意思是，梦中有什么东西在引诱他？"
        },
        {
          "role": "奥兹",
          "text": "虽然还没有证据，但皇女的直觉一向准确。"
        },
        {
          "role": "派蒙",
          "text": "唔…还是再打听一下吧！"
        },
        {
          "type": "subtitle",
          "text": "调查附近的病患（2/3）"
        },
        {
          "role": "艾德娜",
          "text": "你们好，我是负责看护工作的修女艾德娜。"
        },
        {
          "role": "菲谢尔",
          "text": "报上名来，梦魇的狂徒。"
        },
        {
          "role": "奥兹",
          "text": "抱歉，不是说您。地上这位先生有说过什么话吗？"
        },
        {
          "role": "艾德娜",
          "text": "似乎有说过要回去工作什么的…"
        },
        {
          "role": "哈特曼",
          "text": "啊…酒，酒还…"
        },
        {
          "role": "旅行者",
          "text": "是与酒有关的工人吗？"
        },
        {
          "role": "奥兹",
          "text": "他看起来睡得很沉。"
        },
        {
          "role": "菲谢尔",
          "text": "这不是一般的梦…是诅咒！"
        },
        {
          "role": "派蒙",
          "text": "能叫醒他吗？"
        },
        {
          "role": "艾德娜",
          "text": "我试过。他短暂地醒来过一会儿，可没多久又睡着了。"
        },
        {
          "role": "派蒙",
          "text": "醒来后他有没有透露什么信息？"
        },
        {
          "role": "艾德娜",
          "text": "他说梦见自己在山上，觉得很冷。"
        },
        {
          "role": "派蒙",
          "text": "山上？冷？嗯…？"
        },
        {
          "role": "菲谢尔",
          "text": "莫非是雪山之恶魔的冷冽诅咒…泉水精灵守护的清泉小镇，也终于成为被恶魔盯上的土地了吗？"
        },
        {
          "role": "菲谢尔",
          "text": "真是棘手的事态，但无妨，只要由我断罪…"
        },
        {
          "role": "杜拉夫",
          "text": "抱歉打扰各位，你们现在有空吗？"
        },
        {
          "role": "派蒙",
          "text": "是杜拉夫先生！出什么事了吗？"
        },
        {
          "role": "杜拉夫",
          "text": "呃，真是不好开口啊…"
        },
        {
          "role": "杜拉夫",
          "text": "我们这儿的{{颜色|蓝|后山}}上也有{{颜色|蓝|陨石}}，村里那个{{颜色|蓝|艾伦}}，吵着要去见识一下，一个人就冲出去了。"
        },
        {
          "role": "杜拉夫",
          "text": "陨石的危险性你们也看到了，我担心他出什么意外，想请各位跟我走一趟，把他接回来。"
        },
        {
          "role": "派蒙",
          "text": "都这么危险了，他还去凑什么热闹呀！"
        },
        {
          "role": "杜拉夫",
          "text": "就是！等这小子回来，一定要狠狠骂他一顿！"
        },
        {
          "role": "派蒙",
          "text": "说得对，那我们现在就去找他吧！"
        },
        {
          "type": "subtitle",
          "text": "前往后山寻找艾伦"
        },
        {
          "type": "subtitle",
          "text": "解救被怪物围攻的艾伦"
        },
        {
          "role": "艾伦",
          "text": "啊！我还以为我会死在那里！"
        },
        {
          "role": "杜拉夫",
          "text": "臭小子！非常时期，还敢惹麻烦！"
        },
        {
          "role": "艾伦",
          "text": "我错了，我再也不敢了！"
        },
        {
          "role": "杜拉夫",
          "text": "实在是非常抱歉，我一定好好教训他！"
        },
        {
          "role": "派蒙",
          "text": "下次可别乱跑了哦！"
        },
        {
          "role": "旅行者",
          "text": "陨石就在那边。"
        },
        {
          "role": "派蒙",
          "text": "我去看看有什么…咦？皇女，你的{{颜色|蓝|神之眼}}在{{颜色|蓝|闪}}哦！"
        },
        {
          "role": "菲谢尔",
          "text": "咦？难道说，冷冽诅咒已经意识到，这渊色秘珠里流淌的能量，正在奏响它命运的挽歌？"
        },
        {
          "role": "派蒙",
          "text": "唔，神之眼会对什么东西起反应吗？"
        },
        {
          "role": "菲谢尔",
          "text": "世界的幽邃，群星的低语。魔骸的诅咒，还有…"
        },
        {
          "role": "派蒙",
          "text": "都是些什么呀！你说话真的很难懂！"
        },
        {
          "role": "奥兹",
          "text": "失礼了，皇女对凡人的语言并不熟悉。"
        },
        {
          "role": "派蒙",
          "text": "所以才要靠你翻译吗？"
        },
        {
          "role": "奥兹",
          "text": "在下惶恐，这不是翻译，只是代传皇女的意旨。我想周遭会对{{颜色|蓝|神之眼}}造成影响的，恐怕只有{{颜色|蓝|元素力}}。"
        },
        {
          "role": "菲谢尔",
          "text": "嗯，辛苦你了，奥兹。被尘世凡俗掩没双眼之人，总是无法像你这样，第一时间领会本皇女的真意…"
        },
        {
          "role": "派蒙",
          "text": "陨石中含有元素力？神之眼会发光，是在回应元素力的呼唤吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "神之眼可以反向搜寻元素力吗？",
              "dialogues": []
            },
            {
              "text": "这种呼唤会双向发生吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "感觉…也许可以？要不我们就先试试，能不能利用{{颜色|蓝|神之眼}}来搜索{{颜色|蓝|陨石碎片}}、清理危害吧？"
        },
        {
          "type": "subtitle",
          "text": "清理后山的陨石"
        },
        {
          "role": "派蒙",
          "text": "这样一来应该就清理得差不多了。会对清泉镇的村民有帮助吗？"
        },
        {
          "role": "奥兹",
          "text": "含有元素力的陨石…它就是事件的元凶吗？"
        },
        {
          "role": "菲谢尔",
          "text": "以祝圣的圣约起誓，这些陨石正是梦魇的根源！"
        },
        {
          "role": "旅行者",
          "text": "回镇上确认一下吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯！！"
        },
        {
          "type": "subtitle",
          "text": "回清泉镇确认病患的状况"
        },
        {
          "role": "派蒙",
          "text": "艾德娜小姐，我们把后山上的陨石清掉啦，请问病人有好转吗？"
        },
        {
          "role": "艾德娜",
          "text": "多亏你们，刚才已经有两名患者醒来了！"
        },
        {
          "role": "哈特曼",
          "text": "还有点困…呼啊~"
        },
        {
          "role": "派蒙",
          "text": "太好了，这个办法奏效！"
        },
        {
          "role": "艾德娜",
          "text": "如果能把附近的{{颜色|蓝|陨石}}都清理干净…"
        },
        {
          "role": "旅行者",
          "text": "大家就会从梦中醒来。"
        },
        {
          "role": "奥兹",
          "text": "啊，真是个振奋人心的好消息。"
        },
        {
          "role": "菲谢尔",
          "text": "哼哼，劳烦本皇女亲自出马，有这种结果也是应该的嘛！"
        },
        {
          "role": "派蒙",
          "text": "那位醒来的先生，你在梦里看到了什么呀？"
        },
        {
          "role": "哈特曼",
          "text": "只记得很冷，我在不停地走山路…是{{颜色|蓝|雪山}}吧…"
        },
        {
          "role": "派蒙",
          "text": "走山路…？没有目的吗？"
        },
        {
          "role": "哈特曼",
          "text": "呃，我也不知道呢，梦里的我，似乎不完全受我控制。"
        },
        {
          "role": "菲谢尔",
