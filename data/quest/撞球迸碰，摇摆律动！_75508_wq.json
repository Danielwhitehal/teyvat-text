{
  "quest_id": 75508,
  "chapter_num": null,
  "chapter_title": "撞球迸碰，摇摆律动！",
  "type": "wq",
  "route": "Rhythm Ball Revolution!",
  "stories": [
    {
      "story_id": 75508,
      "title": "撞球迸碰，摇摆律动！",
      "description": "一封来自「流泉之众」的信件，呈递至了你和派蒙的手上——玛拉妮主导的特别派对，正等待你们登场…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "我们收到了一封玛拉妮的信呢，真是个惊喜！"
        },
        {
          "role": "派蒙",
          "text": "上面说，「流泉之众」正在举办一场…音乐派对？"
        },
        {
          "role": "派蒙",
          "text": "听起来有点好玩欸，我们去看看情况吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「律动魔匠」）"
        },
        {
          "role": "旅行者",
          "text": "（看起来，这位控碟乐师正沉浸在音乐中，还是先去找玛拉妮她们问问情况吧…）"
        },
        {
          "type": "subtitle",
          "text": "前往「流泉之众」"
        },
        {
          "role": "玛拉妮",
          "text": "哟！"
        },
        {
          "role": "玛拉妮",
          "text": "我们最最重要的客人来啦，说明气氛即将达到最热点！"
        },
        {
          "role": "派蒙",
          "text": "玛拉妮，你好呀！希诺宁也在？"
        },
        {
          "role": "派蒙",
          "text": "还有瑞希？你从稻妻过来啦？"
        },
        {
          "role": "梦见月瑞希",
          "text": "没错哦，纳塔的朋友们待我就像家人，「流泉之众」就像是我异乡的家。"
        },
        {
          "role": "梦见月瑞希",
          "text": "我也需要用心打理分店，才能为纳塔的大家提供力所能及的帮助嘛。"
        },
        {
          "role": "希诺宁",
          "text": "说得不错，瑞希小姐的工作态度实在无可挑剔。"
        },
        {
          "role": "希诺宁",
          "text": "和她一对比，传说中的乙方模板都会显得怠惰…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来希诺宁也是瑞希的客户？",
              "dialogues": []
            },
            {
              "text": "瑞希和希诺宁站在同一战线了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "最近做了几个奇怪的梦，比如…委托人把原本四周的订单工期缩短到一周。"
        },
        {
          "role": "希诺宁",
          "text": "或者接到的需求是「外形圆润又带着危险感的挂饰」，同样是四倍加急…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这题我会，史莱姆和蕈兽。",
              "dialogues": []
            },
            {
              "text": "说的是飘浮灵和球球章鱼？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "反应这么快，该不会是你托梦给希诺宁下单的吧！"
        },
        {
          "role": "希诺宁",
          "text": "这两种生物…危险吗？"
        },
        {
          "role": "希诺宁",
          "text": "唔，工期倒是次要的，圆形图案处理起来比较费事，一旦加急，成品效果就未必完美了。"
        },
        {
          "role": "希诺宁",
          "text": "梦里这类的麻烦订单还不少，我感觉有些不对劲，就把手头的单子都结了，来瑞希小姐的店里试了试…"
        },
        {
          "role": "希诺宁",
          "text": "结果还真灵验，当天午睡时，我就没再做过奇怪的梦。"
        },
        {
          "role": "梦见月瑞希",
          "text": "能为希诺宁女士排遣烦扰，我深感荣幸。"
        },
        {
          "role": "梦见月瑞希",
          "text": "不过我觉得，希诺宁女士的古怪梦境会消散，主要的功劳应该还在于您自己啦…"
        },
        {
          "role": "玛拉妮",
          "text": "总而言之，现在大家的精神状态都很不错，正是放松的好时机——"
        },
        {
          "role": "玛拉妮",
          "text": "「流泉之众」要重启水上派对的传统，让大家玩个痛快！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "水上派对~",
              "dialogues": []
            },
            {
              "text": "玩个痛快~",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好耶，玩个痛快！"
        },
        {
          "role": "派蒙",
          "text": "…不过，我以前还没参加过这种活动，只知道有好吃的东西和好喝的饮料…"
        },
        {
          "role": "派蒙",
          "text": "一般纳塔人会在派对上玩些什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "鳍游龙拉着客人高速冲浪？",
              "dialogues": []
            },
            {
              "text": "绒翼龙空投玩家高跳低开？",
              "dialogues": []
            },
            {
              "text": "匿叶龙无绳蹦极…这个玩过了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我…我能玩这个？"
        },
        {
          "role": "玛拉妮",
          "text": "哎呀，你们已经是成熟的极限运动爱好者了！我第一时间也想让客人们玩这个！"
        },
        {
          "role": "玛拉妮",
          "text": "不过阿米娜很认真地说…咳咳…「对于一般人来说，这样的活动还是刺激过头了！」"
        },
        {
          "role": "玛拉妮",
          "text": "「就算是普普通通的沙滩排球，一些客人都可能把握不住力道，导致同伴受伤哦！」"
        },
        {
          "role": "玛拉妮",
          "text": "「要是参加了派对，一个不注意，没能玩个痛快，反而留下了心理阴影，到时候增加的就是瑞希小姐的工作量了！」"
        },
        {
          "role": "梦见月瑞希",
          "text": "我倒是不介意帮更多人排忧解难啦，但可不包括自己制造出的病患哦，还是别让客人受伤为妙。"
        },
        {
          "role": "玛拉妮",
          "text": "嘿嘿，所以我才好好找你咨询了一番嘛！"
        },
        {
          "role": "派蒙",
          "text": "看来你们已经商量出了不错的方案？"
        },
        {
          "role": "梦见月瑞希",
          "text": "没错，我们达成了共识，希望更多没有极限运动基础的客人参加派对，而不是看着刺激的活动望而却步。"
        },
        {
          "role": "梦见月瑞希",
          "text": "在和我聊天时，玛拉妮小姐听说了稻妻的「三川花祭」，对历年祭典上的轻松游戏很感兴趣。"
        },
        {
          "role": "梦见月瑞希",
          "text": "就萌生了一个念头——将「秋津羽戏」与纳塔的氛围相结合，打造出既能休闲放松，又能玩个爽快的游戏「节拍撞球」。"
        },
        {
          "role": "派蒙",
          "text": "稻妻的游戏…纳塔的氛围…还真是以前从没想过的组合！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我看到了「回声之子」的「热舞乐台」。",
              "dialogues": []
            },
            {
              "text": "我的身体感受到了音乐的律动…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "啊呀，「热舞乐台」明明还没调高音量，看来你对低音和鼓点还挺敏感的嘛…"
        },
        {
          "role": "希诺宁",
          "text": "这次的主力游戏「节拍撞球」，就是跟着热情的音乐，畅玩弹球，打碎所有方块。"
        },
        {
          "role": "希诺宁",
          "text": "顺从本能，释放自我，不必考虑复杂的技巧，不用担心安全问题，任何人都能玩个痛快。"
        },
        {
          "role": "希诺宁",
          "text": "当然，对于旅行者这种天赋异禀的选手，应该能打出…具有特别「节拍」和「层次」的效果。"
        },
        {
          "role": "希诺宁",
          "text": "在不同的控碟乐师手中，一首曲子有可能展现出截然不同的风格，带有打击感的游戏也是同理。"
        },
        {
          "role": "希诺宁",
          "text": "没准…「驰放」风格的基底音乐，经过你的处理，都会展现出类似「出神」或「艺核」的有趣律动呢。"
        },
        {
          "role": "希诺宁",
          "text": "我有点期待哦。"
        },
        {
          "role": "派蒙",
          "text": "听…听不太明白！不过感觉，应该是旅行者能做到的事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我就来扮演音乐和游戏天才！",
              "dialogues": []
            },
            {
              "text": "不至于这么强，我会尽力的！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛拉妮",
          "text": "太对了，就是这种劲头！在我们的期待中，无论如何都要保证玩得最开心的客人，就是你和派蒙啦！"
        },
        {
          "role": "玛拉妮",
          "text": "待会儿我要拿一堆零食和饮料，在一边开开心心地看！"
        },
        {
          "role": "梦见月瑞希",
          "text": "当然，也请注意，别兴奋过头呀。"
        },
        {
          "role": "梦见月瑞希",
          "text": "说不定晚上睡觉前，脑子里还在反复播放「热舞乐台」的音乐，停不下来呢。"
        },
        {
          "role": "派蒙",
          "text": "谢谢大家！我们一定玩个开心！"
        },
        {
          "role": "派蒙",
          "text": "话说回来，我记得希诺宁很会挑歌，就算梦里还在重播…应该也没问题？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（希诺宁）"
        },
        {
          "role": "希诺宁",
          "text": "状态还不错，旅行者，有即兴演奏大师的风范了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "演奏方面还得请教你…",
              "dialogues": [
                {
                  "role": "希诺宁",
                  "text": "很好，你确实对控碟乐师的专业技能有兴趣。"
                },
                {
                  "role": "希诺宁",
                  "text": "要了解控碟乐师的要点，还得先从熟悉设备开始…"
                },
                {
                  "role": "希诺宁",
                  "text": "我也打造过不少相关设备，收集了一些资料。下次来我那时，都拿去吧。"
                },
                {
                  "role": "希诺宁",
                  "text": "学习一门音乐技艺时，熟悉理论知识的过程难免有点枯燥，但只要成功入门，就会进入一段快速上升的甜蜜期。"
                },
                {
                  "role": "希诺宁",
                  "text": "期待你的表现。"
                }
              ]
            },
            {
              "text": "希诺宁最中意哪种音乐风格？",
              "dialogues": [
                {
                  "role": "希诺宁",
                  "text": "风格吗…我倒是很难说，自己认定了哪种风格。"
                },
                {
                  "role": "希诺宁",
                  "text": "在我看来，一首歌的综合制作水平才更重要——"
                },
                {
                  "role": "希诺宁",
                  "text": "旋律线的走向、编曲的思路、配器的选择、录音和综合处理的质量…都有各自的及格线。"
                },
                {
                  "role": "希诺宁",
                  "text": "随处可见的大众风格中，也会诞生乐理技术异常超前的杰作，相对的，看似高级的小众风格里，也有水平不容乐观的案例。"
                },
                {
                  "role": "希诺宁",
                  "text": "要是一首歌粗制滥造，就想借着小众标签骗过听众，那未免有点…卑鄙？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "确实，不能滥竽充数…",
                      "dialogues": []
                    },
                    {
                      "text": "还是没必要盯着标签…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "希诺宁",
                  "text": "所以啊，认真学习乐理，按部就班地练习吧，旅行者。"
                },
                {
                  "role": "希诺宁",
                  "text": "基本功是重中之重，我相信你会扎扎实实做事。"
                }
              ]
            },
            {
              "text": "那我继续找找灵感。",
              "dialogues": [
                {
                  "role": "希诺宁",
                  "text": "有好点子的话，可以和我分享，随便哼哼旋律也行，我会帮你记下来的。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（玛拉妮）"
        },
        {
          "role": "玛拉妮",
          "text": "哟，旅行者，精神满满嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说起来，玛拉妮喜欢什么歌？",
              "dialogues": [
                {
                  "role": "玛拉妮",
                  "text": "我啊？哈哈，我不挑！"
                },
                {
                  "role": "玛拉妮",
                  "text": "悠闲的、热情的、轻松愉快的歌，我都能接受！"
                },
                {
                  "role": "玛拉妮",
                  "text": "至于旋律比较低沉，氛围很正式的音乐，我可能没法跟着摇摆…我不常听，但也不反感！"
                }
              ]
            },
            {
              "text": "有什么游玩建议嘛？",
              "dialogues": [
                {
                  "role": "玛拉妮",
                  "text": "嗯，让我想想…"
                },
                {
                  "role": "玛拉妮",
                  "text": "凭我打沙滩排球的经验，太过紧张的话，反而有可能发挥失常。"
                },
                {
                  "role": "玛拉妮",
                  "text": "有时看着飞来的撞球，思考太多条件，反而会左右为难！"
                },
                {
                  "role": "玛拉妮",
                  "text": "适当放空思维，让身体跟着直觉作出反应！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "原来如此，我试试！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "玛拉妮",
                  "text": "当然，遇上了需要比拼策略的游戏，或者更严肃的事，完全依靠直觉是行不通的，要好好考虑行动的后果哦。"
                },
                {
                  "role": "玛拉妮",
                  "text": "张弛有度才是关键！"
                }
              ]
            },
            {
              "text": "游戏不错，我再玩玩！",
              "dialogues": [
                {
                  "role": "玛拉妮",
                  "text": "嘿！以你的实力，多玩几局，就能创下没人能超越的分数啦！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（梦见月瑞希）"
        },
        {
          "role": "梦见月瑞希",
          "text": "嗯，我能感觉到，你在享受游艺的乐趣时，情绪中蕴含着温暖的色彩，相信你今晚会有个轻松舒畅的好梦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "瑞希也会听节奏很快的歌吗？",
              "dialogues": [
                {
                  "role": "梦见月瑞希",
                  "text": "这个问题的思路非常经典哦。"
                },
                {
                  "role": "梦见月瑞希",
                  "text": "朋友推荐的音乐，不管我能否接受，都会好好听完，如此才不至于辜负朋友的好意。"
                },
                {
                  "role": "梦见月瑞希",
                  "text": "我可以接受节奏特别快的音乐，不过更倾向于舒缓、优美的类型。乐器的种类不一定要很丰富，技巧也不用特别炫目。"
                },
                {
                  "role": "梦见月瑞希",
                  "text": "只要主要的旋律足够动听，哪怕只是慢慢的独奏，或是人声清唱，也不会显得单薄，反而有种清静的美感。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "我也一样。",
                      "dialogues": [
                        {
                          "role": "梦见月瑞希",
                          "text": "那…等到你下回空闲时，我挑选几首不错的音乐，沏一壶好茶，准备些点心，一起慢慢欣赏吧？"
                        }
                      ]
                    },
                    {
                      "text": "也可以试试新风格？",
                      "dialogues": [
                        {
                          "role": "梦见月瑞希",
                          "text": "没问题哦，以你的审美，肯定能让我走出舒适区，找到些新的宝藏。下回空闲时，带我欣赏这些杰作吧？"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "想看瑞希玩这个游戏。",
              "dialogues": [
                {
                  "role": "梦见月瑞希",
                  "text": "当然可以啦，不过有点犯规哦。"
                },
                {
                  "role": "梦见月瑞希",
                  "text": "作为设计者之一的我了解每个关卡的细节，每一步都在预料中，难免显得有些无趣嘛。"
                },
                {
                  "role": "梦见月瑞希",
                  "text": "游艺之中多一点惊喜才好，这对设计者的思维是一种考验，要尽可能跳出常规，避免每一步发展都被人一眼望穿。"
                },
                {
                  "role": "梦见月瑞希",
                  "text": "在超出常理的领域里，你自然是最佳代表啦。"
                },
                {
                  "role": "梦见月瑞希",
                  "text": "希望以后，你也能从头参与一些游艺的统筹架构，让我体验你设计的关卡~"
                }
              ]
            },
            {
              "text": "你也要好好休息哦。",
              "dialogues": [
                {
                  "role": "梦见月瑞希",
                  "text": "请别担心，这次成功邀请到你，我就心满意足了。心情舒畅的睡眠，一份时间，甚至抵得上平时的三倍~"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（「律动魔匠」）"
        },
        {
          "role": "「律动魔匠」",
          "text": "嗯，撞球打击目标的音色富有张力，要是能配上稳定的节奏，就是完美的加花！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来一局「节拍撞球」！",
              "dialogues": [
                {
                  "role": "「律动魔匠」",
                  "text": "好，期待你的发挥，祝你打出漂亮的段落！"
                }
              ]
            },
            {
              "text": "你是…",
              "dialogues": [
                {
                  "role": "「律动魔匠」",
                  "text": "你好你好，欢迎来玩这个游戏！"
                },
                {
                  "role": "「律动魔匠」",
                  "text": "我是希诺宁大师雇来的一般乐师，负责管理这座「热舞乐台」。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "大师？",
                      "dialogues": []
