{
  "quest_id": 10248,
  "chapter_num": "绘夏！烈日？度假村！其四",
  "chapter_title": "收幕！将夏夜染作缤纷！",
  "type": "lq",
  "route": "A Curtain Call for a Colorful Summer Night!",
  "stories": [
    {
      "story_id": 15045,
      "title": "收幕！将夏夜染作缤纷！",
      "description": "直到太阳又一次升起…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后"
        },
        {
          "type": "subtitle",
          "text": "返回度假屋休息"
        },
        {
          "type": "subtitle",
          "text": "（可选）与朋友们对话"
        },
        {
          "type": "subtitle",
          "text": "额外对话（班尼特&温迪） 提提岛西南"
        },
        {
          "role": "班尼特",
          "text": "温迪老师，我终于明白了…"
        },
        {
          "role": "温迪",
          "text": "噢？明白什么？"
        },
        {
          "role": "班尼特",
          "text": "你的诗歌。自天幕降下的恒久光芒，指的并不是星光…"
        },
        {
          "role": "温迪",
          "text": "嘘…把它藏在你心中吧。比起谜题或者答案，诗歌更像是风。只要你体会得到它，它就一直存在。"
        },
        {
          "role": "班尼特",
          "text": "嗯…谢谢你为我做的一切。"
        },
        {
          "role": "温迪",
          "text": "期待你写出更棒的诗噢，班尼特同学。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（玛薇卡） 提提岛「醅蜜」"
        },
        {
          "role": "玛薇卡",
          "text": "旅行者，来喝一杯吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没想到大家都来了…",
              "dialogues": [
                {
                  "role": "玛薇卡",
                  "text": "哈哈，是不是声势太大？但事先告知你的话，就不能算作「惊喜」了。"
                },
                {
                  "role": "玛薇卡",
                  "text": "看拍照时的表情，大家都对度假时光充满了期待啊。"
                }
              ]
            },
            {
              "text": "接下去有什么打算？",
              "dialogues": [
                {
                  "role": "玛薇卡",
                  "text": "尽管时间不会很长，但趁这个难得的机会，我也想放松一下。"
                },
                {
                  "role": "玛薇卡",
                  "text": "那么…度假村里难度最高的项目是什么？你有推荐吗？"
                }
              ]
            },
            {
              "text": "关于风…",
              "dialogues": [
                {
                  "role": "玛薇卡",
                  "text": "噢，是天气的话题？"
                },
                {
                  "role": "玛薇卡",
                  "text": "度假村里最近吹着一阵既凉爽又舒适的风…很是难得。"
                },
                {
                  "role": "玛薇卡",
                  "text": "如果这阵风能够在纳塔多停留几日，就再好不过了。"
                }
              ]
            },
            {
              "text": "祝玛薇卡也享受假期。",
              "dialogues": [
                {
                  "role": "玛薇卡",
                  "text": "谢谢你的祝福，也祝你和朋友们玩得畅怀。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊安珊） 悠悠集市向东锚点"
        },
        {
          "role": "伊安珊",
          "text": "这里环境不错，刚好适合有氧锻炼。"
        },
        {
          "role": "伊安珊",
          "text": "跑到第三圈的时候，有些阿夏好奇地跟在了我的身边。但到第十圈的时候，它们全部瘫在了路旁。"
        },
        {
          "role": "伊安珊",
          "text": "我放它们休息了，希望它们明天能有所进步。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卡齐娜） 热舞乐台"
        },
        {
          "role": "卡齐娜",
          "text": "这里好热闹呀。"
        },
        {
          "role": "卡齐娜",
          "text": "可惜阿尤昨天吃坏了肚子不能来…我还想抱着它一起去玩蹦床呢。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（希诺宁） 热舞乐台"
        },
        {
          "role": "希诺宁",
          "text": "难得放下工作出来休假，先找个适合睡觉的地方好了…"
        },
        {
          "role": "希诺宁",
          "text": "…等等，「热舞乐台」的姿态好像不太对啊。难道是轴承…不对，是支架…"
        },
        {
          "role": "希诺宁",
          "text": "啊…！还是要过去看看…真是烦人！说了多少次，操作和维护的时候给我好好看操作手册！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（恰斯卡） 刺梨岩"
        },
        {
          "role": "恰斯卡",
          "text": "有兴趣再来点「争斗」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不如帮你拍张照？",
              "dialogues": [
                {
                  "role": "恰斯卡",
                  "text": "好，那就这样。"
                },
                {
                  "role": "恰斯卡",
                  "text": "本来想拿去送给「妈妈」，但她看到只怕要举起翅膀，问我留画片算什么意思，怎么平时不多去看看她…"
                },
                {
                  "role": "恰斯卡",
                  "text": "我还是自己留作纪念吧。"
                }
              ]
            },
            {
              "text": "求之不得。",
              "dialogues": [
                {
                  "role": "恰斯卡",
                  "text": "不错。让我们全力以赴吧。"
                },
                {
                  "role": "绵驮兽警长",
                  "text": "很久很久以前，一伙亡命之徒来到了镇上…"
                },
                {
                  "role": "绵驮兽警长",
                  "text": "就连空中的砂砾都在传递不祥的气息。逃啊，快逃啊。风暴、绵驮兽警长：…即将降临！"
                },
                {
                  "role": "恰斯卡",
                  "text": "英雄该出场了吧？"
                },
                {
                  "role": "派蒙",
                  "text": "嗯？警长还没提到有英雄呢！"
                },
                {
                  "role": "恰斯卡",
                  "text": "我已经看到爪牙了。"
                },
                {
                  "role": "绵驮兽警长",
                  "text": "…这时英雄挺身而出，枪口直指灾祸之源。"
                },
                {
                  "role": "恰斯卡",
                  "text": "——♪"
                },
                {
                  "role": "恰斯卡",
                  "text": "看上去有点挑战，来比比吧。"
                },
                {
                  "role": "绵驮兽警长",
                  "text": "自此，镇民们过上了幸福快乐的生活。"
                },
                {
                  "type": "subtitle",
                  "text": "战胜恰斯卡"
                },
                {
                  "role": "恰斯卡",
                  "text": "…敌人这就清理完了？"
                },
                {
                  "role": "恰斯卡",
                  "text": "枪法不错嘛，想赢你还真不容易。"
                },
                {
                  "type": "subtitle",
                  "text": "输给恰斯卡"
                },
                {
                  "role": "恰斯卡",
                  "text": "热身不足？下回等你状态好了，我们再来过。"
                },
                {
                  "role": "派蒙",
                  "text": "结束得也太快了吧！"
                },
                {
                  "role": "派蒙",
                  "text": "呃，怎么听上去你才是风暴、灾难和毁灭…"
                }
              ]
            },
            {
              "text": "或许下次？<br>",
              "dialogues": [
                {
                  "role": "恰斯卡",
                  "text": "好，有时间再说。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（瓦雷莎） 刺梨岩"
        },
        {
          "role": "瓦雷莎",
          "text": "梨果之夜…听上去有好多好吃的东西…"
        },
        {
          "role": "瓦雷莎",
          "text": "瓦雷莎，要上了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（玛拉妮） 悠悠集市"
        },
        {
          "role": "玛拉妮",
          "text": "来得正好！能帮我拍张照吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好呀。",
              "dialogues": [
                {
                  "role": "玛拉妮",
                  "text": "谢谢，那我要摆出这个姿势！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "我拍咯。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "玛拉妮",
                  "text": "我看看…哇，真不错。角度和构图都很完美，谢谢你！"
                },
                {
                  "role": "玛拉妮",
                  "text": "我要把它摆在床头…或者挂在墙上也行？"
                },
                {
                  "role": "玛拉妮",
                  "text": "折些粉色和蓝色的彩纸，再捡些贝壳来装饰相框。哈哈，感觉一定很棒！"
                },
                {
                  "role": "玛拉妮",
                  "text": "谢谢你还专程陪我满足了心愿，我会一直记得这个夏天的…"
                },
                {
                  "role": "玛拉妮",
                  "text": "实在太开心啦——"
                }
              ]
            },
            {
              "text": "或许下次？",
              "dialogues": [
                {
                  "role": "玛拉妮",
                  "text": "噢噢，没关系的！现在可是自由活动时间，你也要玩得开心哦！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（基尼奇&阿乔） 浪浪湾向西南锚点下方"
        },
        {
          "role": "阿乔",
          "text": "这个项目看着很适合你啊，基尼奇，我们一起来挑战吧？"
        },
        {
          "role": "基尼奇",
          "text": "我知道你想趁我起跳的时候，往我背上踢一脚。"
        },
        {
          "role": "基尼奇",
          "text": "说少了。你好像还在盘算要拆掉一两块木板…让我踩空掉下去。"
        },
        {
          "role": "阿乔",
          "text": "……"
        },
        {
          "role": "基尼奇",
          "text": "同样的把戏你在「悬木人」的地盘用过了…我有什么理由上当？"
        },
        {
          "role": "阿乔",
          "text": "谁度假的时候会那么警惕啊！气死我了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊法&欧洛伦） 热舞乐台{{#info:需完成世界任务欢聚总在寻觅后}}"
        },
        {
          "role": "伊法",
          "text": "开业仪式的事，你跟奶奶提过吧？"
        },
        {
          "role": "欧洛伦",
          "text": "当然。但奶奶说，小孩子聚在一起玩的事她就不掺和了。她这么说，我不敢提火神大人也要来。"
        },
        {
          "role": "伊法",
          "text": "唉。那我们给她带点礼物回去吧…阿夏头箍？她会喜欢那东西吗？"
        },
        {
          "role": "欧洛伦",
          "text": "不如带吃的。奶奶总是需要下酒菜和下书的零食。"
        },
        {
          "role": "伊法",
          "text": "也听听咔库库的主意吧…咔库库呢？还在跟阿夏玩？"
        },
        {
          "role": "欧洛伦",
          "text": "别担心，咔库库能照顾好自己。"
        },
        {
          "role": "伊法",
          "text": "说什么呢哥们，我担心的是那些阿夏，别它们也被教会喊哥们了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "休息",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "（该休息了吧？）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就休息吧。",
              "dialogues": []
            },
            {
              "text": "再等等。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛拉妮",
          "text": "旅行者，派蒙！我带着豚豚球来跟你们问早哦！"
        },
        {
          "role": "派蒙",
          "text": "早啊，玛拉妮，你怎么那么有精神？昨晚玩得最疯的不就是你吗？"
        },
        {
          "role": "玛拉妮",
          "text": "那已经是昨晚的事啦！睡一觉，疲劳就统统扫清！"
        },
        {
          "role": "玛拉妮",
          "text": "喏，收下这个。是纪念册的奖励，我帮你一起领回来了，免得你多跑一趟。"
        },
        {
          "role": "派蒙",
          "text": "噢噢！真贴心啊玛拉妮！"
        },
        {
          "role": "玛拉妮",
          "text": "急人所急，想人所想，才算是个好向导，对吧？"
        },
        {
          "role": "玛拉妮",
          "text": "说到工作，算算时间，假期差不多要结束了。再不回家，我怕我家小狗都要认不出我了。"
        },
        {
          "role": "玛拉妮",
          "text": "我问了问其他人，大家也有各自的牵挂。"
        },
        {
          "role": "玛拉妮",
          "text": "想念家人的，想念蒲公英酒味道的…"
        },
        {
          "role": "恰斯卡",
          "text": "就连恰斯卡嘴上没说什么，一到傍晚，她就翘着腿坐在树梢上，往「花羽会」的方向望了又望。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能够理解…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛拉妮",
          "text": "所以呀，在这个美妙的夏天结束之前，让我们再做一些有纪念意义的事情吧！"
        },
        {
          "role": "玛拉妮",
          "text": "比如…再拍一张合照！"
        },
        {
          "role": "派蒙",
          "text": "要在这里拍吗？住了那么久，还挺有感情的。"
        },
        {
          "role": "玛拉妮",
          "text": "采纳！再把墙面装饰一番吧，我喊大家过来集合…广场见！"
        },
        {
          "type": "subtitle",
          "text": "获得{{图标|食谱：娜娜丝梨饼}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "根据同伴们的想法进行喷绘"
        },
        {
          "type": "subtitle",
          "text": "待机文本"
        },
        {
          "type": "subtitle",
          "text": "玛拉妮：蓝色也是这栋小屋的幸运色！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "温迪：你觉得这边用浅绿色怎么样~",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "派蒙：我想要这里是明黄色！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "班尼特：上面那层喷成橙色一定很棒！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "恰斯卡：花羽会的颜色应该不错…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "喷绘后待机文本"
        },
        {
          "type": "subtitle",
          "text": "玛拉妮：幸运小屋~！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "温迪：看着就很凉爽呢。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "派蒙：太棒了，不愧是你！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "班尼特：真不错啊！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "恰斯卡：果然合适。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "班尼特",
          "text": "噢，真好看！"
        },
        {
          "role": "玛拉妮",
          "text": "各位，来我这里集合！要拍照啦！"
        },
        {
          "role": "玛拉妮",
          "text": "嗯…不错嘛！所有人的精神状态都很饱满，没有黏答答的刘海或者熬夜的黑眼圈。"
        },
        {
          "role": "派蒙",
          "text": "你拍照前还会帮忙检查这些？"
        },
        {
          "role": "玛拉妮",
          "text": "拍照不够细心还怎么声称自己是好向导？"
        },
        {
          "role": "温迪",
          "text": "爱喝酒的吟游诗人才能成为好旅伴？"
        },
        {
          "role": "派蒙",
          "text": "这话到底是怎么接上的…"
        },
        {
          "role": "班尼特",
          "text": "哈哈，但气氛很好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大家变成一起说胡话的朋友了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这真的是个好方向吗？你也跟班尼特一样在惯着卖唱的吧？"
        },
        {
          "role": "恰斯卡",
          "text": "至少不坏。"
        },
        {
          "role": "玛拉妮",
          "text": "来，旅行者，把这个阿夏头箍带上。这是大家一起为你买的纪念礼物噢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "嗯，很适合你！"
        },
        {
          "role": "玛拉妮",
          "text": "那么…"
        },
        {
          "role": "玛拉妮",
          "text": "三、二、一——"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "班尼特",
          "text": "派蒙？"
        },
        {
          "role": "派蒙",
          "text": "…不好意思，胡话听多了之后脑袋突然卡壳了，没想出要说什么词…"
        },
        {
          "role": "恰斯卡",
          "text": "再加上还有点舍不得大家？"
        },
        {
          "role": "恰斯卡",
          "text": "觉得当自己这么说出来的时候，仿佛就是在给假期画上句号了？"
        },
        {
          "role": "派蒙",
          "text": "你…！你还说「调停人」不会读心术！"
        },
        {
          "role": "玛拉妮",
          "text": "哈哈，派蒙…"
        },
        {
          "role": "班尼特",
          "text": "没事的，派蒙。"
        },
        {
          "role": "班尼特",
          "text": "夏天一定还会到来，就像你和火神大人许愿的那样。"
        },
        {
          "role": "班尼特",
          "text": "大家的旅程都在继续。但只要我们都珍惜着彼此，总有一天还会相聚。"
        },
        {
          "role": "玛拉妮",
          "text": "班尼特是不是变得相当能说啊，温迪老师？"
        },
        {
          "role": "温迪",
          "text": "啊呀，不是我教的哦。"
        },
        {
          "role": "派蒙",
          "text": "不是你教的你语气那么得意干嘛呀！真是的，我好不容易有点感动…"
        },
        {
          "role": "玛拉妮",
          "text": "那我们重新来一次？"
        },
        {
          "role": "班尼特",
          "text": "大家一起吧？"
        },
        {
          "role": "恰斯卡",
          "text": "喊什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "幸运之星？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好！"
        },
        {
          "role": "玛拉妮",
          "text": "三、二、一——"
        },
        {
          "role": "众人",
          "text": "幸运之星！"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "传说任务-收幕！将夏夜染作缤纷！-CG-荧.png|center|900px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "传说任务-收幕！将夏夜染作缤纷！-CG-空.png|center|900px]]"
        },
        {
          "type": "subtitle",
          "text": "和朋友们共度了一段愉快的时光…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "恰斯卡",
          "text": "…班尼特之后有什么打算？"
        },
        {
          "role": "玛拉妮",
          "text": "对啊，如果现在不好做决定的话，可以来我们「流泉之众」坐坐，想待多久都行。"
        },
        {
          "role": "班尼特",
          "text": "…嗯，谢谢你的好意，玛拉妮。"
        },
        {
          "role": "班尼特",
          "text": "在这之前，我去见了火神大人，向她郑重表达了我的感谢。"
        },
        {
          "role": "班尼特",
          "text": "她告诉我，那片空间是由深渊拟态而成的烬寂海，空间本身极不稳定，现在已经彻底消失了。"
        },
        {
          "role": "班尼特",
          "text": "后面聊到我的事之后，火神大人欢迎我留在纳塔，但也说会尊重我的决定。"
        },
        {
          "role": "班尼特",
          "text": "我思考再三…还是决定回蒙德。"
        },
        {
          "role": "恰斯卡",
          "text": "放心不下老爹们？"
        },
        {
          "role": "班尼特",
          "text": "这也是原因之一。我答应要把收获的故事讲给老爹们听，不能失约。"
        },
        {
          "role": "班尼特",
          "text": "其余的嘛…"
        },
        {
          "role": "班尼特",
          "text": "告别的时候，我对爸妈说了，我一定会成为提瓦特最伟大的传奇冒险家。"
        },
        {
          "role": "班尼特",
          "text": "冒险家，可不能只待在一个地方啊。"
        },
        {
          "role": "玛拉妮",
          "text": "班尼特…"
        },
        {
          "role": "派蒙",
          "text": "要是你在离开纳塔之后，又变得不幸起来…那要怎么办？"
        },
        {
          "role": "班尼特",
          "text": "哈哈，这也没关系。"
        },
        {
          "role": "班尼特",
          "text": "在这次旅程中获得的温暖，足以让我面对未来的所有挑战。"
        },
        {
          "role": "班尼特",
          "text": "我想把握自己的命运。我想将这份家人和朋友带给我的温暖，继续传递下去。这个想法一直没变。"
        },
        {
          "role": "恰斯卡",
          "text": "敬我们的团长！"
        },
        {
          "role": "温迪",
          "text": "敬班尼特团长！"
        },
        {
          "role": "玛拉妮",
          "text": "干杯干杯——！"
        },
        {
          "role": "派蒙",
          "text": "呃…竟然快要通宵了…"
        },
        {
          "role": "玛拉妮",
          "text": "玩得尽兴嘛！接下去轮到谁表演？"
        },
        {
          "role": "班尼特",
          "text": "我看班尼特好几次要睡着了。"
        },
        {
          "role": "班尼特",
          "text": "没有，没有…我还可以…"
        },
        {
          "role": "恰斯卡",
          "text": "大家都回去休息吧，玛拉妮，这么有力气就交给你收拾场地了。"
        },
        {
          "role": "玛拉妮",
          "text": "欸？为什么是我——"
        },
        {
          "role": "温迪",
          "text": "旅行者，再陪我散散步？"
        },
        {
          "role": "温迪",
          "text": "我知道一个风景不错的地方。"
        },
        {
          "type": "subtitle",
          "text": "前往温迪所说的地点"
        },
        {
          "role": "派蒙",
          "text": "卖唱的，你还是那么会挑地方…"
        },
        {
          "role": "温迪",
          "text": "很高兴你能喜欢。有些故事不适合飞鸟，只能说给高处的星辰听呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要讲睡前故事了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "哈哈，这篇故事，要从「时间」开始说起。"
        },
        {
          "role": "温迪",
          "text": "很久很久以前，「时间（伊斯塔露）」开始记录这个世界。"
        },
        {
          "role": "温迪",
          "text": "她对栖息在尘世的生灵一视同仁，与此同时，这些生灵在她心中也是同等的无足轻重。"
        },
        {
          "role": "温迪",
          "text": "她就好像一张古老的卷轴，将所有人、所有事、所有的相遇与别离都刻印在自己的记忆中。"
        },
        {
          "role": "温迪",
          "text": "那时还是风精灵的我，在千风神殿与「时间」偶遇。"
        },
        {
          "role": "温迪",
          "text": "她聆听我的愿望，将部分力量与权能的碎片出让给了我…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "风带来了种子…",
              "dialogues": []
            },
            {
              "text": "时间使其发芽…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "看来这不是你第一次听说「时间与风」的故事。"
        },
        {
          "role": "温迪",
          "text": "这不是很有韵味吗？"
        },
        {
          "role": "温迪",
          "text": "靠着铭刻在祭礼、诗歌、遗迹和古籍中的记忆，被视作微不足道的生灵们一次次「见」到了时间。"
        },
        {
          "role": "派蒙",
          "text": "这就是你要说的故事？"
        },
        {
          "role": "温迪",
          "text": "嗯…只能算是故事的「序章」。"
        },
        {
          "role": "温迪",
          "text": "烬寂海的污染是具有时间特性的，换句话说，它的灾害存在于时间的每一处。"
        },
        {
          "role": "温迪",
          "text": "不同于「时间」本身，我的心中，一直存在诸多愿望。"
        },
        {
          "role": "温迪",
          "text": "五百年前，为了防止烬寂海的污染继续扩散，影响特诺奇兹托克以外的更多区域…"
        },
        {
          "role": "温迪",
          "text": "我将烬寂海从时间轴上吹了出去，让它成为了「无风之地」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这就是烬寂海消失之谜的真相吗…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "哎呀，好像让你弄混了呢。"
        },
        {
          "role": "温迪",
          "text": "如果你问的是二三十年前，烬寂海从特诺奇兹托克消失的事，或许存在比我更适合的讲述人。"
        },
        {
          "role": "温迪",
          "text": "烬寂海承载了太多不应属于它的故事…我仅参与了其中一个篇章。"
        },
        {
          "role": "温迪",
          "text": "而我在五百年前做出的选择，也有代价。"
        },
        {
          "role": "温迪",
          "text": "有些灵魂因此无法返回蒙德…另有些灵魂沉淀在这块土地上，和幻写灵结合，成为了你我所见的阿夏。"
        },
        {
          "role": "派蒙",
          "text": "所以，你这次来特诺奇兹托克是为了…"
        },
        {
          "role": "温迪",
          "text": "没错，我需要和现任火神玛薇卡合作。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是在点燃蜡烛的时候吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "猜对咯，火光是我们的暗号。"
        },
        {
          "role": "温迪",
          "text": "由玛薇卡从那片空间中开启通往真正烬寂海的裂隙，我才能悄悄钻进去，把所有愿意回家的灵魂都接送回去。"
        },
        {
          "role": "温迪",
          "text": "至于带回记忆这种小把戏…欸嘿，也不是第一次了吧。{{#info:温迪传说任务[[若你困于无风之地]]、3.1版本活动任务[[杯中遥吟之歌]]}}"
        },
        {
          "role": "温迪",
          "text": "玛薇卡还和我提到了你想帮忙引荐的事…没想到还是被我抢先了。"
        },
        {
          "role": "温迪",
          "text": "很高兴看到她也热爱着美酒与自由…我们很聊得来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真有你的…",
              "dialogues": []
            },
            {
              "text": "做了那么大一件事…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "我可是累了好几天，差点就要再度沉睡过去啦。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？"
        },
        {
          "role": "温迪",
          "text": "但想到蜜酿和蒲公英酒都没喝够，说什么都得再多撑一下吧？"
        },
        {
          "role": "派蒙",
          "text": "我看你还不够累，只用这点理由别想让我们请客。"
        },
        {
          "role": "温迪",
          "text": "哎——太严格了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "温迪…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "旅行者，你会接济美酒给我的，对吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我有些好奇。",
              "dialogues": []
            },
            {
              "text": "你现在的愿望是什么呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "……"
        },
        {
          "role": "温迪",
          "text": "或许就是守护蒙德这个地方，让所有愿意在蒙德驻足的人都有选择的自由吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（玛薇卡&温迪） 「醅蜜」酒吧"
        },
        {
          "role": "玛薇卡",
          "text": "如何？事情办完，这次能放开喝了吧？"
        },
        {
          "role": "温迪",
          "text": "啊哈，可不是我有所保留。"
        },
        {
          "role": "温迪",
          "text": "真要和你比赛喝酒的话，只怕度假村的蜜虫要忙到筋疲力尽，一个个都变成打瞌睡的懒虫咯。"
        },
        {
          "role": "玛薇卡",
          "text": "不愧是吟游诗人，说出来的话总是那么有趣，噢，刚才那段即兴的祝酒词也是。"
        },
        {
          "role": "玛薇卡",
          "text": "「为了自由而快乐的生活。」说得真好，正是大家现在需要的。"
        },
        {
          "role": "玛薇卡",
          "text": "你在蒙德没少参与宴会吧？"
        },
        {
          "role": "温迪",
          "text": "当然。毕竟是「诗与酒的城邦」，如果一位吟游诗人讲不好祝酒词，要怎么换到免费的蒲公英酒呢？"
        },
        {
          "role": "玛薇卡",
          "text": "哈哈，等你有时间，欢迎你加入各部族的宴会，大家一定抢着请客。"
        },
        {
          "role": "玛薇卡",
          "text": "不过，喝得高兴时，大家一般会拍着桌子，跺着脚，一起唱起也不知道是什么调子的歌…不会介意吧？"
        },
        {
          "role": "温迪",
          "text": "怎么会呢，听起来很棒啊！哎呀…要是蒙德和纳塔能办一场联谊酒会就好了。"
        },
        {
          "role": "玛薇卡",
          "text": "好啊，到时候我可要多带几桶蜜酿过去。"
        },
        {
          "role": "玛薇卡",
          "text": "之前「沃陆之邦」还新推出了一款「火山青蜜莓暖饮」…也带给你和你的朋友们尝尝。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（班尼特） 呼呼丘"
        },
        {
          "role": "班尼特",
          "text": "旅行者，谢谢你和我一同经历了这场冒险。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于悠悠度假村…",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "温暖的海岛，迷人的篝火，有趣的游乐项目和无忧无虑的派对…"
                },
                {
                  "role": "班尼特",
                  "text": "这里太神奇了，美好得就像一场梦。"
                },
                {
                  "role": "班尼特",
                  "text": "但因为我知道它是真实发生的事，鼻子又会一酸…哈哈，这一定就是「幸福」的感觉吧。"
                },
                {
                  "role": "班尼特",
                  "text": "我遇见了最亲的人和最好的朋友们，度过了一个不想结束的夏天…"
                },
                {
                  "role": "班尼特",
                  "text": "我真是天底下最幸运的人。"
                }
              ]
            },
            {
              "text": "关于返程的计划…",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "我给老爹们和蒙德的大家选好了礼物，原本以为包裹够塞，结果新买了一个大拎包才勉强装下…"
                },
                {
                  "role": "班尼特",
                  "text": "我还买了一瓶浓缩蜜露，打算回蒙德后，请迪奥娜制成蒲公英风味的饮品，送给温迪老师。"
                },
                {
                  "role": "班尼特",
                  "text": "…迪奥娜，[[杜拉夫]]先生！我怎么把杜拉夫先生的礼物给漏了…哎呀，我得再去一次悠悠集市。"
                }
              ]
            },
            {
              "text": "关于欧洛伦和伊法…{{#info:需完成世界任务[[欢聚总在寻觅后]]}}",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "噢，你说他们呀！伊法先生请我帮忙时我还担心了半天，说我学不来莫娜小姐水占术的那套，真要演会演出破绽的。"
                },
                {
                  "role": "班尼特",
                  "text": "结果他说「会转树枝就行」，剩下的交给他来圆…"
                },
                {
                  "role": "班尼特",
                  "text": "听说后来玩得特别热闹，我也为他们还有咔库库开心！"
                }
              ]
            },
            {
              "text": "祝你好运。",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "嗯，也祝你旅途顺利。我会期待着，某天能和你在新的冒险路上偶遇！"
                }
              ]
            }
          ]
        }
      ],
