  "chapter_title": "牌手等级突破·四",
  "type": "wq",
  "route": "Ascension Challenge IV",
  "stories": [
    {
      "story_id": 70669,
      "title": "牌手等级突破·四",
      "description": "「七圣召唤」的牌手协会认定你已经具有了进行等级突破试炼的资格。赢下突破挑战的牌局，成为「传说牌手」吧！希望你能感受到「七圣召唤」的乐趣！",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往「猫尾酒馆」"
        },
        {
          "role": "旅行者",
          "text": "进行突破挑战！"
        },
        {
          "role": "「小王子」",
          "text": "喵…「哎呀，要来进行牌手等级突破的试炼吗…嗯，旅行者确实已经拥有了挑战的资格，那我这就…」"
        },
        {
          "role": "「小王子」",
          "text": "「这就让恕筠准备突破试炼所用的牌局吧，可要小心应对呀…」"
        },
        {
          "type": "subtitle",
          "text": "与「小王子」进行突破对局"
        },
        {
          "role": "「小王子」",
          "text": "喵…「嗯，旅行者得要再小心一点才行啊，先调整一下，之后再来挑战吧？」"
        },
        {
          "role": "「小王子」",
          "text": "「我相信你是有足以完成试炼的实力的…」"
        },
        {
          "type": "subtitle",
          "text": "与「小王子」对话"
        },
        {
          "role": "「小王子」",
          "text": "喵！「真是了不起，恭喜你突破了牌手等级的试炼，现在已经是传说牌手了！」"
        },
        {
          "role": "「小王子」",
          "text": "喵…「传说牌手是个了不起的头衔呢…」"
        },
        {
          "role": "「小王子」",
          "text": "「希望旅行者以后也能继续精进自己的牌技！要成为不辜负传说牌手这一头衔的了不起的牌手！」"
        },
        {
          "role": "「小王子」",
          "text": "「事到如今再说或许有点多余了，但是…」"
        },
        {
          "role": "「小王子」",
          "text": "「旅行者，希望你能感受到『七圣召唤』的乐趣！」"
        }
      ]
    }
  ]
}