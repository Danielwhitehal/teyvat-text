{
  "quest_id": 76684,
  "chapter_num": null,
  "chapter_title": "花羽伴弹头",
  "type": "wq",
  "route": "Flower, Feathers, and Bullets",
  "stories": [
    {
      "story_id": 76684,
      "title": "花羽伴弹头",
      "description": "「弹道推理」的演习临近结束，夏沃蕾和恰斯卡似乎达成了某种共识…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与恰斯卡对话"
        },
        {
          "role": "恰斯卡",
          "text": "那…成交？"
        },
        {
          "role": "夏沃蕾",
          "text": "成交。"
        },
        {
          "role": "派蒙",
          "text": "成交什么？我是不是错过了什么重要的事？"
        },
        {
          "role": "恰斯卡",
          "text": "正式的说法，应该是确定签署一份备忘录——"
        },
        {
          "role": "夏沃蕾",
          "text": "《关于提升射手效能的联合训练备忘录》。"
        },
        {
          "role": "夏沃蕾",
          "text": "想来，招募恰斯卡小姐至特巡队，会对她的故乡纳塔造成不可估量的人才损失，不是明智之举。"
        },
        {
          "role": "恰斯卡",
          "text": "特巡队那宛如钟表的稳定运转，也离不开夏沃蕾队长每天的指挥调度，少了夏沃蕾队长，枫丹也会遇上不少麻烦。"
        },
        {
          "role": "夏沃蕾",
          "text": "要想达成我们的目标…"
        },
        {
          "role": "恰斯卡",
          "text": "就需要前所未有的合作方式。"
        },
        {
          "role": "派蒙",
          "text": "这种惊人的默契是怎么回事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "两位高手的思维对上了。",
              "dialogues": []
            },
            {
              "text": "她们找出了彼此满意的方案。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "总之，经过和夏沃蕾队长的商讨，我们决定在三个月内，争取开始「交换代表长期进修」。"
        },
        {
          "role": "恰斯卡",
          "text": "这个方案能在最大程度减少负担的前提下，加强特巡队、「花羽会」与西风骑士团的合作。"
        },
        {
          "role": "派蒙",
          "text": "…是我理解的，字面意思上那么做吗？"
        },
        {
          "role": "派蒙",
          "text": "你们两边互相派人，「花羽会」的勇士在枫丹住一段时间，特巡队的战士就去纳塔？"
        },
        {
          "role": "夏沃蕾",
          "text": "没错，只不过实践起来，就不止是「让两边的人各自去对方的国家旅居」那么简单了。"
        },
        {
          "role": "恰斯卡",
          "text": "进修代表的人选，驻地，每天的课程，模拟训练与实际演练的计划，经费的安排…种种细节都需要系统性的规划。"
        },
        {
          "role": "夏沃蕾",
          "text": "而且要盯住弱项，对症下药，比如，纳塔勇士不太关注编制学，枫丹射手几乎没有实践经验的动对动射击…"
        },
        {
          "role": "夏沃蕾",
          "text": "那就让纳塔勇士试着以班组为单位，严格分工行动；让绒翼龙抓着特巡队射手的双肩，低空飞行，截射靶标。"
        },
        {
          "role": "派蒙",
          "text": "听起来也太严格了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真能做到的话，肯定效果拔群。",
              "dialogues": []
            },
            {
              "text": "专练弱项的确是最有效的方法。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "许多计划中的课程，还要用到蒙德友军的卓越装备，西风骑士团的代表也不可或缺，所有进修所得的结果都应与他们分享。"
        },
        {
          "role": "赫得蔚格",
          "text": "呃咳！夏沃蕾队长有心了，再次感谢贵方慷慨的报价！"
        },
        {
          "role": "赫得蔚格",
          "text": "这次演练中，「观测榴弹」和一系列装备发挥正常，我们会按照之前的采购合同定期交付货品。"
        },
        {
          "role": "赫得蔚格",
          "text": "派出代表进修一事，也请容我将消息传回骑士团，由长官们给出正式答复。"
        },
        {
          "role": "夏沃蕾",
          "text": "我会给你提供正式的书面文件，等着你的好消息。"
        },
        {
          "role": "恰斯卡",
          "text": "最后，话题该回到我们的「射击推理」了。"
        },
        {
          "role": "恰斯卡",
          "text": "夏沃蕾队长可是对这次的结果异常满意啊。"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯，得到了旅行者令人惊叹的对照组后，我们最后的拼图也被补全了。"
        },
        {
          "role": "夏沃蕾",
          "text": "这次演练带来了大量弹道规划的思维样本，覆盖各种水平的射手——"
        },
        {
          "role": "夏沃蕾",
          "text": "足以让原本的铳枪射击教材，甚至训练射手的教官手册，都进一步改良，效率成倍提升。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "下次推演还可以叫我哦。",
              "dialogues": []
            },
            {
              "text": "我乐于参加这样的演习。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "就等你这句话呢。"
        },
        {
          "role": "恰斯卡",
          "text": "到时候，肯定第一时间给你寄信！"
        },
        {
          "role": "夏沃蕾",
          "text": "以你目前的射击才能，下次坐到出题者的位置上来才合适。"
        },
        {
          "role": "派蒙",
          "text": "哈哈！能帮蒙德、枫丹和纳塔的朋友们变强，真是再好不过了！"
        },
        {
          "role": "派蒙",
          "text": "如果哪天听说，我们帮忙编好的书，教出了厉害的战士，砰砰几枪就击退了魔物，保护了大家…"
        },
        {
          "role": "派蒙",
          "text": "那种感觉，应该会和我们亲自打跑坏家伙一样，自豪又踏实！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（恰斯卡）"
        },
        {
          "role": "恰斯卡",
          "text": "作为代表派到枫丹长期进修的人选啊…"
        },
        {
          "role": "恰斯卡",
          "text": "首选有[[朱南]]和[[因卡纳克]]，她们两人一起来，应该相当不错。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（蒂蕾娜&夏沃蕾）"
        },
        {
          "role": "蒂蕾娜",
          "text": "队长，你刚刚说的是认真的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（继续听听看…）",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "我也要被绒翼龙抓着在天上飞吗？"
                },
                {
                  "role": "夏沃蕾",
                  "text": "对。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "我还要练习在天上操纵铳枪，在高速移动中射击地面的目标？"
                },
                {
                  "role": "夏沃蕾",
                  "text": "对。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "那…加薪吗？"
                },
                {
                  "role": "夏沃蕾",
                  "text": "加。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "我干！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "其实就算不加薪，我也会干。钱从来不是问题，特巡队员的尊严才是。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "「花羽会」的龙骑士们能做到，我也不想认输！"
                },
                {
                  "role": "夏沃蕾",
                  "text": "其实我知道，不加薪你也会答应，但我不想亏待任何一个队员。所以，除了加薪，还会有一系列额外保险措施和津贴。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "为了保证你们拥有充足的体力，应对更恶劣的作战环境，我会给你们再增加针对性的体能训练。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "先从十万步的负重跑开始吧。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "我…我跑，我一定好好跑。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "在天上挂着，确实很消耗体能吧？那这次的十万步，我就背五十单位的负重？"
                },
                {
                  "role": "夏沃蕾",
                  "text": "…我本来想说三十五单位的。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "但你既然主动提出五十单位，那[[勒泰利埃]]也按这个标准来好了，然后再看看其他人承不承受得了。"
                }
              ]
            },
            {
              "text": "（还是不听了…）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（科赫&赫得蔚格）"
        },
        {
          "role": "科赫",
          "text": "快要收工了…去那边的「锈舵」喝两杯？"
        },
        {
          "role": "赫得蔚格",
          "text": "喝什么喝！你们自己掏腰包喔？我一摩拉都不会给你们批的。"
        },
        {
          "role": "科赫",
          "text": "没事，我们自己出钱，再带几瓶好的回去给[[霍肯]]、[[乌苏拉]]和[[君特]]！噢，还有凯亚队长和大团长！"
        },
        {
          "role": "赫得蔚格",
          "text": "反正我就免了，我要好好整理这次推演的记录，远程小队得留个人下来帮我！"
        },
        {
          "role": "赫得蔚格",
          "text": "还有特巡队给团长的书面文件，进修计划…无意之间，又开了个好头啊！"
        }
      ],
      "collapse_ranges": [
        [
          39,
