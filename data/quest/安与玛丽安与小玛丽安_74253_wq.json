{
  "quest_id": 74253,
  "chapter_num": null,
  "chapter_title": "安与玛丽安与小玛丽安",
  "type": "wq",
  "route": "Ann, Mary-Ann, and Marionette",
  "stories": [
    {
      "story_id": 74253,
      "title": "安与玛丽安与小玛丽安",
      "description": "前往隐居处放置茶桌并使用桑多涅落座后，与众人共度茶会时光吧…",
      "dialogues": [
        {
          "role": "「木偶」",
          "text": "说实话，我到现在还是很惊讶。"
        },
        {
          "role": "「木偶」",
          "text": "要知道，我和阿兰当时真的都认为你已经不存在于这个世上了。"
        },
        {
          "role": "玛丽安",
          "text": "嗯…要是我们早些苏醒的话，说不定还能去同阿兰和你见面。但，这就是命运吧。"
        },
        {
          "role": "安",
          "text": "玛丽安小姐…"
        },
        {
          "role": "玛丽安",
          "text": "但命运也自有它的妙处，谁能想到我和安在旅行时会看到印着桑多涅小姐画像的映影海报呢？"
        },
        {
          "role": "「木偶」",
          "text": "所以你们才想办法联系的我。"
        },
        {
          "role": "安",
          "text": "正是这样！"
        },
        {
          "role": "玛丽安",
          "text": "啊…真是令人怀念的咖啡香气…呵呵，也谢谢你邀请我们到这里来参加茶会，桑多涅小姐。"
        },
        {
          "role": "玛丽安",
          "text": "花园布置得优雅华美，非常符合淑女的品位。"
        },
        {
          "role": "「木偶」",
          "text": "这里是我和阿兰曾经的家，打理得漂亮些也是应该的。"
        },
        {
          "role": "玛丽安",
          "text": "你看，这就比老哥强多了。"
        },
        {
          "role": "安",
          "text": "阿兰从来都不会去布置房间，也应付不来漂亮的东西。"
        },
        {
          "role": "玛丽安",
          "text": "是啊，雷内也一样。会认真布置房间、认真准备茶会的，应该只有我和雅各布了。"
        },
        {
          "role": "「木偶」",
          "text": "从小就是这样吗？我一直以为是上了岁数的缘故…"
        },
        {
          "role": "玛丽安",
          "text": "从小就是这样。虽然头脑很聪明，但别的方面总是笨笨的。"
        },
        {
          "role": "玛丽安",
          "text": "说不定也是因为这个原因，他才成为了我们之中唯一一个选择真实的痛苦，而不是虚幻美梦的人。"
        },
        {
          "role": "「木偶」",
          "text": "我倒觉得他没有遗憾。"
        },
        {
          "role": "安",
          "text": "嗯，因为那就是他作为勇者的愿望吧。"
        },
        {
          "role": "安",
          "text": "遗憾的是我们。他的愿望本不该如此孤独。"
        },
        {
          "role": "玛丽安",
          "text": "那你呢，桑多涅小姐？你有什么愿望吗？"
        },
        {
          "role": "「木偶」",
          "text": "你和阿兰问的问题真是一模一样。"
        },
        {
          "role": "玛丽安",
          "text": "嗯？他也问过这个问题吗？"
        },
        {
          "role": "玛丽安",
          "text": "看来老哥真的成长了不少呢。他从前绝对说不出这种话。"
        },
        {
          "role": "「木偶」",
          "text": "「愿望」这个词实在是太虚无了。想要什么就能有什么吗？哈，那这世上也不会有这么多讨厌的事了。"
        },
        {
          "role": "「木偶」",
          "text": "我正在做我想做的事，我认为正确的事。我不知道这个算不算愿望，但我很开心。"
        },
        {
          "role": "玛丽安",
          "text": "嗯，这是一件很了不起的事。我很羡慕。"
        },
        {
          "role": "玛丽安",
          "text": "那你会…埋怨阿兰吗？因为他照着…玛丽安的模样创造了你。"
        },
        {
          "role": "「木偶」",
          "text": "从来不会。他一直都说我就是我，独一无二，我应当选择自己的人生。我也的确这么做了。"
        },
        {
          "role": "安",
          "text": "哈哈，无论是故事还是茶点，只要是你满意的选择，就是最正确的选择，桑多涅。"
        },
        {
          "role": "玛丽安",
          "text": "没错，所以现在，就让我们静静享用你精心准备的茶点吧。"
        },
        {
          "role": "玛丽安",
          "text": "平静的日子，真好啊。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "玛丽安",
          "text": "已经这个点了吗？哈哈，那我们以后也多聚聚吧，桑多涅小姐。"
        }
      ]
    }
  ]
}