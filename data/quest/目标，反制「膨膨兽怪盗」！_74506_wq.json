{
  "quest_id": 74506,
  "chapter_num": null,
  "chapter_title": "目标，反制「膨膨兽怪盗」！",
  "type": "wq",
  "route": "Goal: Counter the \"Phantom Blubberbeast!\"",
  "stories": [
    {
      "story_id": 74506,
      "title": "目标，反制「膨膨兽怪盗」！",
      "description": "心情不错的派蒙提议，要和你一起在枫丹廷逛逛，买些有趣的东西和好吃的点心，没想到，你们却撞见了一位奇怪的工程师…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "在枫丹廷的商业区逛逛"
        },
        {
          "role": "派蒙",
          "text": "哼哼~旅行者，不知道为什么，刚才我突然想起了一些开心的事，感觉心情很不错！"
        },
        {
          "role": "派蒙",
          "text": "要不然，我们就趁着这会儿，去枫丹逛逛街，放松一下，买些有趣的东西和好吃的点心吧！"
        },
        {
          "type": "subtitle",
          "text": "与乐平波琳对话"
        },
        {
          "role": "乐平波琳",
          "text": "我拍拍拍拍拍…素材多多多多多…摩拉滚滚滚滚来！"
        },
        {
          "role": "乐平波琳",
          "text": "啊！不得了的大人物出现了！"
        },
        {
          "role": "乐平波琳",
          "text": "你们好啊，两位！我能给你们拍张照吗？"
        },
        {
          "role": "派蒙",
          "text": "咦…那个人是在叫我们吗？她要给我们留影？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "合影留念到没什么问题…",
              "dialogues": []
            },
            {
              "text": "另作他用就得付钱了哦…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿…看来我和旅行者也算是超级大名人了呢，居然有人主动给我们留影！"
        },
        {
          "role": "派蒙",
          "text": "不过，如果你要把我们的照片用在别的地方，按照枫丹的说法，你应该付我们…唔…出场费？出镜费？"
        },
        {
          "role": "乐平波琳",
          "text": "好！拍到你们两位是我乐平波琳的荣幸，这张照片算你们一百五十万摩拉怎么样？尊贵的皇牌冒险家搭档？"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯！这还差不多嘛…"
        },
        {
          "role": "派蒙",
          "text": "欸，等等，你说多少？一百五十万？我没听错吧！"
        },
        {
          "role": "派蒙",
          "text": "一张照片就给我们一百五十万…是不是有点夸张了？我们俩的形象有这么值钱吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那赶紧再多拍点！",
              "dialogues": []
            },
            {
              "text": "事出反常必有诈…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "乐平波琳",
          "text": "啊哈！区区一百五十万，根本不算什么！"
        },
        {
          "role": "乐平波琳",
          "text": "如果你们愿意跟我合作，带着留影机轻轻松松拍拍…就算分到九位数的摩拉，也不在话下！"
        },
        {
          "role": "派蒙",
          "text": "九位数…个十百千万…十万百万千万…这这这这这么多？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "数字编得太离谱了！",
              "dialogues": []
            },
            {
              "text": "我们绝不会相信的！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没错！太夸张了啦！这种话就算是我也不会相信的！"
        },
        {
          "role": "派蒙",
          "text": "你该不会是什么诈骗犯，想要以我们两个的名义去招摇撞骗吧？"
        },
        {
          "role": "乐平波琳",
          "text": "招摇撞骗？嘿，还真被你们猜对了主题——"
        },
        {
          "role": "乐平波琳",
          "text": "只不过恰恰相反，我的这桩差事可以让那些招摇撞骗的家伙从提瓦特彻底消失，还能给你们一大笔分红！"
        },
        {
          "role": "派蒙",
          "text": "你，你说慢一点！我有点跟不上你的思路了…你只不过在路边拍照而已，怎么说得像是…在打击犯罪？"
        },
        {
          "role": "乐平波琳",
          "text": "这就不得不提到大家都很容易忽视的问题了——警卫机关的「目标识别」能力。"
        },
        {
          "role": "乐平波琳",
          "text": "我们都知道，警卫机关想要打击不法行为时，首先要确定对方是罪犯，没错吧？"
        },
        {
          "role": "乐平波琳",
          "text": "无论把好人当成了坏家伙，还是忽视了带着武器的潜在罪犯，都会导致很大的问题！"
        },
        {
          "role": "乐平波琳",
          "text": "比如说，把渔师手里的鱼竿当成了长枪，或者被伪装成水管的武器骗过！"
        },
        {
          "role": "派蒙",
          "text": "好像有点道理…"
        },
        {
          "role": "乐平波琳",
          "text": "那么，假如我穿着猫猫狗狗、团雀鸽子，甚至膨膨兽的伪装服，像是从游乐园里跑出来的演员，警卫机关要怎么应对我呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "游乐园？",
              "dialogues": []
            },
            {
              "text": "伪装服？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这，这犯规了！"
        },
        {
          "role": "派蒙",
          "text": "你说的这些动物都很可爱，警卫机关一般是不会出手的吧！而且膨膨兽也根本不会出现在城里…"
        },
        {
          "role": "乐平波琳",
          "text": "噔噔！答到要害了！"
        },
        {
          "role": "乐平波琳",
          "text": "实际上，城区内的警卫机关根本不会将猫猫狗狗，团雀鸽子，尤其是膨膨兽列为目标，识别图像的时候，会直接跳过它们。"
        },
        {
          "role": "乐平波琳",
          "text": "考虑到机关运转的效率，将几乎不可能遇见的目标排除在列表之外，的确有助于提升工作的效能。"
        },
        {
          "role": "乐平波琳",
          "text": "之前《蒸汽鸟报》就刊登过一则新闻：「几个观察力敏锐的罪犯发现了警卫机关的弱点，穿着膨膨兽的伪装服去行窃…」"
        },
        {
          "role": "乐平波琳",
          "text": "「结果警卫机关将他们当成了空气，完全没有对他们的犯罪行为进行干预。」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真狡猾欸！",
              "dialogues": []
            },
            {
              "text": "太奸诈了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "穿着膨膨兽的伪装服去犯罪？还被警卫机关无视了？"
        },
        {
          "role": "派蒙",
          "text": "仔细想想，又好气，又有点可怕…如果那群人不满足于偷东西，而是要做更大的坏事…那不就太糟糕了吗！"
        },
        {
          "role": "乐平波琳",
          "text": "所以说，这是一场关乎图形识别的对抗，而且随着罪犯伪装技术的进步，这场对抗会愈演愈烈，最终演变成技术的战争！"
        },
        {
          "role": "乐平波琳",
          "text": "为了枫丹的治安，本人——「图形对抗学」工程师乐平波琳，必须尽早站出来做点贡献！"
        },
        {
          "role": "乐平波琳",
          "text": "我正在收集各种图形样本，从大量样本中总结出一套简洁、高效而准确的图形识别逻辑，将它们做成一个小型辅助装置…"
        },
        {
          "role": "乐平波琳",
          "text": "只要将这个小型辅助装置安装在发条机关上，它们立即就能拥有识破伪装，准确判断罪犯的能力。"
        },
        {
          "role": "乐平波琳",
          "text": "依照我的计划，为了保证治安的效果，沫芒宫会为所有警卫机关进行升级…这是何等惊人的商机啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以你才对着街道留影吗？",
              "dialogues": []
            },
            {
              "text": "总感觉你的样本量不太够…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我有种熟悉的预感…一般来说，像你这样搞研究的人，都不擅长跋山涉水，所以只能在城里收集样本…"
        },
        {
          "role": "派蒙",
          "text": "你想找我们合作，也是为了让我们帮你跑腿，去对各种东西留影，收集更多样本，没错吧？"
        },
        {
          "role": "乐平波琳",
          "text": "咳咳…完全正确！不愧是皇牌冒险家搭档，很快就理解了我的需求。"
        },
        {
          "role": "乐平波琳",
          "text": "来吧，加入我的项目组，我们一起成为「图形对抗」的专家，拆穿那些罪犯的花招！"
        },
        {
          "role": "乐平波琳",
          "text": "重要的是，你们能和我一起抓住「图形对抗」的脉络，为枫丹的技术进步和治安做出巨大的贡献，名利双收！"
        },
        {
          "role": "派蒙",
          "text": "嗯…这么说来，乐平波琳的研究还挺有价值的…"
        },
        {
          "role": "派蒙",
          "text": "就算不考虑摩拉的分成，我们也不能坐视不理…不能让更多坏家伙做了坏事，还把污名丢给膨膨兽！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们不能坐视不理！",
              "dialogues": []
            },
            {
              "text": "有分红就更好说了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "乐平波琳",
          "text": "好，真是爽快！这下，我们就确认合作关系了！"
        },
        {
          "role": "乐平波琳",
          "text": "那么，请你们带上这台「图形识别样本收集器」的备用机，这里边装载了我精心制作的记录和分析装置…还有一本我准备的手册！"
        },
        {
          "role": "乐平波琳",
          "text": "我早就对照各地的资料，事先归纳了重要样本的特征。接下来，你们只需要对着手册去留影，把照片交给我就行了，很轻松吧！"
        },
        {
          "role": "乐平波琳",
          "text": "为了「图形对抗」战争的胜利，还有以后源源不断的订单…我们一起加油吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "乐平波琳",
          "text": "你们回来了！怎么样，有什么收获吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交付样本。",
              "dialogues": [
                {
                  "role": "乐平波琳",
                  "text": "好！向我展示你们的收获吧，「图形对抗」的研究又要向前迈进一大步了！"
                }
              ]
            },
            {
              "text": "关于你的研究…",
              "dialogues": [
                {
                  "role": "乐平波琳",
                  "text": "啊呀，你对我的学术理论感兴趣吗？"
                },
                {
                  "role": "乐平波琳",
                  "text": "你想要学习我这门理论的精髓，我当然一万个乐意！"
                },
                {
                  "role": "乐平波琳",
                  "text": "不过，目前我的理论还没什么指导性的著作，因为我根本没时间撰写论文，参考资料也都比较零碎。"
                },
                {
                  "role": "乐平波琳",
                  "text": "因为，我之前忙着处理枫丹科学院的各种外包订单，来不及做书面工作。"
                },
                {
                  "role": "乐平波琳",
                  "text": "我刚从各种文献里发现「图形对抗」这门行业的重要性，就开始推进项目了，完全没有考虑过照顾新人的事。"
                },
                {
                  "role": "乐平波琳",
                  "text": "「图形对抗」会是一种很难入门的学问，如果你下定决心要学，我一定会毫无保留，把我所有的知识分享给你！"
                },
                {
                  "role": "乐平波琳",
                  "text": "当然，前提是我们先完成眼前的工作，哈哈哈哈哈！"
                }
              ]
            },
            {
              "text": "关于「膨膨兽怪盗」…",
              "dialogues": [
                {
                  "role": "乐平波琳",
                  "text": "咦？你也很好奇那些家伙的犯罪细节吗？"
                },
                {
                  "role": "乐平波琳",
                  "text": "为了给我的「图形对抗」技术提供第一个研究样本，我走访了很多店家，店主们都没听过这样的事。"
                },
                {
                  "role": "乐平波琳",
                  "text": "就连那篇报道的作者都杳无音信，像是直接离开了枫丹…"
                },
                {
                  "role": "乐平波琳",
                  "text": "我想，要么是「膨膨兽怪盗」的犯罪地点极其隐秘，保密程度很高。"
                },
                {
                  "role": "乐平波琳",
                  "text": "要么是执律庭给店主们下了封口令，店主们都不敢对外透露任何消息。"
                },
                {
                  "role": "乐平波琳",
                  "text": "无论是哪种情况，都说明，「膨膨兽怪盗」之流的威胁都相当大，「图形对抗」技术的有着超大的需求和商机！"
                }
              ]
            },
            {
              "text": "先告辞了。",
              "dialogues": [
                {
                  "role": "乐平波琳",
                  "text": "加油啊！如果收集到了不错的样本，记得及时回来交给我哦！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          60,
          62
        ]
      ]
    }
  ]
}