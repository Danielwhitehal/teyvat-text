{
  "quest_id": 23011,
  "chapter_num": null,
  "chapter_title": "等量再交换!",
  "type": "iq",
  "route": "Equivalent Exchange Once More",
  "stories": [
    {
      "story_id": 23011,
      "title": "等量再交换!",
      "description": "在须弥城里，你看见了一个熟悉的身影…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与维克多对话"
        },
        {
          "role": "维克多",
          "text": "呃…这里该怎么雕来着…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗨！",
              "dialogues": []
            },
            {
              "text": "维，维克多？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维克多",
          "text": "哎呀，谁啊，别吵我，我正…"
        },
        {
          "role": "维克多",
          "text": "啊？！旅行者？！你怎么也来须弥了？"
        },
        {
          "role": "维克多",
          "text": "不会是鲁道夫那家伙派你来揍我的吧，我就是很久之前送了莉莉一点礼物而已啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我只是旅行过来啦…",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "你还在旅行中啊，真是够有精力的…"
                }
              ]
            },
            {
              "text": "是啊，和我回蒙德！",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "哈，哈，哈，好哦，那你要不要把我铐着带走？"
                },
                {
                  "role": "维克多",
                  "text": "行了，不和你开玩笑了，我还有正事要办呢。"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "不过，真没想到能在须弥遇见你…"
        },
        {
          "role": "维克多",
          "text": "我从蒙德被调走的时候，本来接到的命令是让我直接回至冬。"
        },
        {
          "role": "维克多",
          "text": "不过，半路上又来了一道新命令，让我来须弥城协助弗谢沃洛德先生的工作，还告知我，我已经被调到了「公鸡」大人手下了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「公鸡」？",
              "dialogues": []
            },
            {
              "text": "是另一位执行官？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维克多",
          "text": "对…呃，不行，我不能接着往下说了，不然弗谢沃洛德先生又要说我对保密工作不敏感了。"
        },
        {
          "role": "维克多",
          "text": "唉，这些执行官大人的名字又不是什么秘密，真不知道他为什么这么敏感。"
        },
        {
          "role": "旅行者",
          "text": "你在须弥做什么？"
        },
        {
          "role": "维克多",
          "text": "哦，我和弗谢沃洛德先生主要负责的是协调后勤补给工作。简单来说，就是到处去采购啦。"
        },
        {
          "role": "维克多",
          "text": "虽然听起来也不是很重要，但总比在蒙德教堂里一直发呆好。"
        },
        {
          "role": "维克多",
          "text": "嘿嘿，而且干这个活，在工作时有很多空闲时间，而且也没人一直盯着我…"
        },
        {
          "role": "维克多",
          "text": "我就把我小时候做木雕的手艺捡起来了，反正须弥木头多，正好练手。"
        },
        {
          "role": "维克多",
          "text": "没想到我雕的那些小玩意，居然还挺受孩子们喜欢的。这帮小毛孩一直吵着要，我就答应他们，给他们每个人都雕一个玩具。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是愚人众吧？",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "是啊，怎么了？哎呀…谁规定愚人众就不能给孩子们送玩具了？"
                },
                {
                  "role": "维克多",
                  "text": "再说了，我现在就是个管后勤的，那些惊天动地的大事，就留给上面的大人们折腾去吧。"
                }
              ]
            },
            {
              "text": "你不会是想从孩子们嘴里套情报吧…",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "喂！我不会做这种事的，你对愚人众到底有啥可怕的刻板印象啊！"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "总之，我现在的情况就是这样啦，虽然没能回至冬，但我还挺喜欢须弥的，有吃有玩，环境也好。"
        },
        {
          "role": "维克多",
          "text": "工作完了之后，我就去买点吃的，然后找个阳光好的地方雕我的木雕。"
        },
        {
          "role": "维克多",
          "text": "虽然…哈哈，大家看我的表情都有点不信任，就和你第一次和我说话的时候一样。"
        },
        {
          "role": "维克多",
          "text": "那也没办法，谁叫我是个愚人众呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我现在也不信任你哦。",
              "dialogues": []
            },
            {
              "text": "谁信任你了，别套近乎！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维克多",
          "text": "行吧…总而言之，我对现在的生活还挺满意的，而且手头还有了点积蓄。"
        },
        {
          "role": "维克多",
          "text": "再这么过几年，说不定我就在须弥定居得了…"
        },
        {
          "role": "维克多",
          "text": "咳，不说了不说了。旅行者，既然你也来须弥了，那如果你有兴趣的话，咱们俩就继续「等量交换」吧。"
        },
        {
          "role": "维克多",
          "text": "不过，这次我没故事给你讲了，只能给你真金白银的报酬了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这样更好。",
              "dialogues": []
            },
            {
              "text": "这是「愚人众」的委托吗？",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "当然不是，这只是「维克多」的委托。"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "好了，我来说明一下委托内容吧。"
        },
        {
          "role": "维克多",
          "text": "我前几天找哈马维订了一批木头，但是他现在还没把货物给我送来。"
        },
        {
          "role": "维克多",
          "text": "现在我还在工作时间，也不敢直接去找他，不然弗谢沃洛德先生又要训我了。"
        },
        {
          "role": "维克多",
          "text": "旅行者，你就帮我去找哈马维问问，我要的那一批木头什么时候到吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "报酬准备好。",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "你就放心吧，肯定准备好"
                }
              ]
            },
            {
              "text": "你真没打什么鬼主意吗…",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "我之前和你做交易的时候哪次打了鬼主意的，你就放心吧，我才懒得做那种麻烦事呢，舒舒服服地生活不好吗…"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "总之，这件事就交给你了啊，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "与哈马维对话"
        },
        {
          "role": "维克多",
          "text": "没想到，我还能把木雕手艺重新捡起来…"
        },
        {
          "role": "哈马维",
          "text": "真是倒霉…"
        },
        {
          "role": "旅行者",
          "text": "关于维克多的木头…"
        },
        {
          "role": "哈马维",
          "text": "你是说那个愚人众找我订的木头吧。"
        },
        {
          "role": "哈马维",
          "text": "唉，别提了，我就说和愚人众做生意不会有好运气。"
        },
        {
          "role": "哈马维",
          "text": "那批木头运到一半就被魔物袭击了，人是全跑回来了，但车毁了，木头都丢在了半路上。"
        },
        {
          "role": "哈马维",
          "text": "唉，现在这情况，我是不敢过去了，一时半会也找不到人去赶走那些魔物…"
        },
        {
          "role": "旅行者",
          "text": "我不是愚人众…"
        },
        {
          "role": "哈马维",
          "text": "你不是愚人众吗？那你怎么帮他做事？奇怪…"
        },
        {
          "role": "哈马维",
          "text": "无论如何，那辆车我暂时是拉不回来了，我只能等到能雇到人之后再想办法。"
        },
        {
          "role": "哈马维",
          "text": "如果你着急要木头的话，我把那辆车大概的地方给你标在地图上，你自己过去看看吧。"
        },
        {
          "role": "哈马维",
          "text": "唉，只要和愚人众沾边果然就遇不上好事…"
        },
        {
          "type": "subtitle",
          "text": "前往货车所在地点"
        },
        {
          "type": "subtitle",
          "text": "打倒所有蕈兽，并拿回木板"
        },
        {
          "role": "哈马维",
          "text": "唉，只要和愚人众沾边果然就遇不上好事…"
        },
        {
          "type": "subtitle",
          "text": "向哈马维回报"
        },
        {
          "role": "哈马维",
          "text": "唉，只要和愚人众沾边果然就遇不上好事…"
        },
        {
          "role": "旅行者",
          "text": "关于维克多的木头…"
        },
        {
          "role": "哈马维",
          "text": "这木头是…你已经把魔物都赶走了？看不出来，你还挺能打的…"
        },
        {
          "role": "哈马维",
          "text": "多谢你了，我等会就找人和我一起过去，把木头给弄回来。"
        },
        {
          "role": "哈马维",
          "text": "唉，只要和愚人众沾边果然就遇不上好事…"
        },
        {
          "type": "subtitle",
          "text": "与维克多对话"
        },
        {
          "role": "维克多",
          "text": "怎么样，我买的木头已经到了吗？"
        },
        {
          "role": "？？？",
          "text": "向维克多叙述了事情的过程…"
        },
        {
          "role": "维克多",
          "text": "又是魔物？我怎么感觉全世界的货车都很容易被魔物袭击…"
        },
        {
          "role": "维克多",
          "text": "算了，反正木头能送回来就行。"
        },
        {
          "role": "维克多",
          "text": "喏，这是说好的报酬，好好数一数吧。"
        },
        {
          "role": "维克多",
          "text": "还有…那个，莉莉还好吗？"
        },
        {
          "role": "维克多",
          "text": "我走的时候也没和那丫头当面道别，她没生气吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她很好。",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "那就行，咳…你别这么看着我，我就是关心一下啊！"
                }
              ]
            },
            {
              "text": "你自己回去看看她呗。",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "那弗谢沃洛德先生非得踢我不可，算了吧。"
                },
                {
                  "role": "维克多",
                  "text": "我也不太敢直接寄信过去。"
                },
                {
                  "role": "维克多",
                  "text": "收到一封来自愚人众的信，听起来就不像什么好事，哈哈哈…"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "不说这些了，再数数报酬吧，旅行者，我可是一分都没少你的。"
        }
      ]
    }
  ]
}