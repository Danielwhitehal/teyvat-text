{
  "quest_id": 77204,
  "chapter_num": null,
  "chapter_title": "浮雪之上",
  "type": "wq",
  "route": "Atop the Floating Snow",
  "stories": [
    {
      "story_id": 77204,
      "title": "浮雪之上",
      "description": "奥黛塔来到了曙光车站…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与奥黛塔对话"
        },
        {
          "role": "奥黛塔",
          "text": "……"
        },
        {
          "role": "蕾托娃",
          "text": "呜——"
        },
        {
          "role": "蕾托娃",
          "text": "还、还有多久——"
        },
        {
          "role": "奥黛塔",
          "text": "三。"
        },
        {
          "role": "蕾托娃",
          "text": "您刚才就数到了四，怎么现在才到三啊！"
        },
        {
          "role": "奥黛塔",
          "text": "四。"
        },
        {
          "role": "蕾托娃",
          "text": "欸？！"
        },
        {
          "role": "蕾托娃",
          "text": "我、我坚持不住了——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "原来是正着数啊。",
            "怎么在这里都要舞蹈训练。"
          ]
        },
        {
          "role": "蕾托娃",
          "text": "痛痛痛…撞到膝盖了…"
        },
        {
          "role": "奥黛塔",
          "text": "我在镇子外的雪原里看见她在跳舞。她跳得不太好，我正好有空，就来指导了。"
        },
        {
          "role": "蕾托娃",
          "text": "奥黛塔小姐说得没错，我确实跳得不太好…这样下去，肯定通不过剧团的遴选…"
        },
        {
          "role": "奥黛塔",
          "text": "是的。非常难。"
        },
        {
          "role": "蕾托娃",
          "text": "但、但我会努力练习的！每一步我都会跳很多很多遍，直到记住为止！"
        },
        {
          "role": "奥黛塔",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "奥黛塔你不要在这种时候沉默呀！不是应该鼓励她一下吗？"
        },
        {
          "role": "奥黛塔",
          "text": "每一位来剧团参与选拔的舞者都这么想，也都这么做了。但她们并不是人人都能站上正式的舞台。"
        },
        {
          "role": "奥黛塔",
          "text": "这不是因为她们没有努力，而是有人比她们跳得更好。"
        },
        {
          "role": "奥黛塔",
          "text": "如果一个人从未在舞台上起舞，那人们也没有兴趣听她讲述舞台下的努力。这地方就是如此严酷。"
        },
        {
          "role": "奥黛塔",
          "text": "她们的往事都会被盖在雪下，除了自己之外无人问津。"
        },
        {
          "role": "蕾托娃",
          "text": "您也是？"
        },
        {
          "role": "奥黛塔",
          "text": "曾经是。但我不喜欢讲述曾经，那没有意义。"
        },
        {
          "role": "蕾托娃",
          "text": "但您发了芽，把上头的雪都顶开了。"
        },
        {
          "role": "奥黛塔",
          "text": "只要能度过寒冬，种子就会发芽。因为它已经活了下去，把根扎得很深了。"
        },
        {
          "role": "蕾托娃",
          "text": "那您…能不能请您带着我度过寒冬？我绝不会再说「坚持不住」那种话了，数到十都不会！"
        },
        {
          "role": "奥黛塔",
          "text": "真的？"
        },
        {
          "role": "蕾托娃",
          "text": "真的！老师好！"
        },
        {
          "role": "奥黛塔",
          "text": "我不是老师。"
        },
        {
          "role": "蕾托娃",
          "text": "首席好！"
        },
        {
          "role": "奥黛塔",
          "text": "…只有沃雅妮莎喜欢被这么叫。"
        },
        {
          "role": "蕾托娃",
          "text": "那就奥黛塔姐姐！奥黛塔姐姐奥黛塔老师奥黛塔首席，最好最好的奥黛塔——"
        },
        {
          "role": "派蒙",
          "text": "好、好强的气势…奥黛塔都扭过头去了呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "看来奥黛塔实在…",
            "不太擅长应付这一类啊…"
          ]
        },
        {
          "role": "奥黛塔",
          "text": "…我是在看矮灵。"
        },
        {
          "role": "派蒙",
          "text": "噗…什么嘛，奥黛塔也会使用这种借…"
        },
        {
          "role": "派蒙",
          "text": "真有啊！"
        },
        {
          "role": "蕾托娃",
          "text": "喔，那是我的朋友们，之前我一个人练习的时候，她们就经常过来为我鼓劲。"
        },
        {
          "role": "蕾托娃",
          "text": "有次摔倒之后，她们还帮我敷了药膏呢。"
        },
        {
          "role": "蕾托娃",
          "text": "我们约好了，等我进入了剧团，就教她们跳舞，但是…看起来我还需要练习好久…"
        },
        {
          "role": "奥黛塔",
          "text": "你现在就可以教她们了。"
        },
        {
          "role": "蕾托娃",
          "text": "咦？可是，我还没完全学会…"
        },
        {
          "role": "奥黛塔",
          "text": "教学同样有助于为你自身巩固基础，所以，只教授最基础的舞步…"
        },
        {
          "role": "奥黛塔",
          "text": "关键就在于重复。一遍又一遍，直到你的身体比头脑更加熟悉舞步。"
        },
        {
          "role": "派蒙",
          "text": "我懂了！这就是深深扎根的办法，对吧？"
        },
        {
          "role": "奥黛塔",
          "text": "是这样没错。"
        },
        {
          "role": "蕾托娃",
          "text": "…啊！好的，奥黛塔姐姐！"
        },
        {
          "role": "奥黛塔",
          "text": "有言在先，这会是一段很漫长的时光，就像是在茫茫雪原跋涉。"
        },
        {
          "role": "蕾托娃",
          "text": "我一定…"
        },
        {
          "role": "奥黛塔",
          "text": "在被冻死在雪原上之前，每一个旅者都认为自己能征服寒冬。"
        },
        {
          "role": "蕾托娃",
          "text": "呃…"
        },
        {
          "role": "奥黛塔",
          "text": "所以，时刻找好你的目标。"
        },
        {
          "role": "奥黛塔",
          "text": "去练习吧，你没有多少时间了。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…虽说是「指导」，但蕾托娃也一直在跳啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "每指导一遍…",
            "自己也要跳一遍吧…"
          ]
        },
        {
          "role": "奥黛塔",
          "text": "…间歇时间太长了。"
        },
        {
          "role": "派蒙",
          "text": "奥黛塔的语气好严格喔，还有一点点吓人…"
        },
        {
          "role": "奥黛塔",
          "text": "是吗？我觉得我已经很温柔了。"
        },
        {
          "role": "奥黛塔",
          "text": "蕾托娃资质不错。但对于舞者来说，无处发挥的天赋，有时候反而是一种附骨的诅咒。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "有奥黛塔指导的话…",
            "蕾托娃一定能做到。"
          ]
        },
        {
          "role": "奥黛塔",
          "text": "我也希望如此。"
        },
        {
          "role": "奥黛塔",
          "text": "…但是，如果蕾托娃真能登上舞台。我想…"
        },
        {
          "role": "奥黛塔",
          "text": "她或许，反而会怀念起在雪原上和妖精共同起舞的日子。"
        }
      ]
    }
  ]
}