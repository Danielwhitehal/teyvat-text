  "stories": [
    {
      "story_id": 23004,
      "title": "宝贝计划",
      "description": "弄蛇人古拉布吉尔似乎遇到了点麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与古拉布吉尔对话"
        },
        {
          "role": "古拉布吉尔",
          "text": "怎么又不见了…哎…旅行者！能不能请你帮个忙？"
        },
        {
          "role": "古拉布吉尔",
          "text": "我的口粮不见了！"
        },
        {
          "role": "古拉布吉尔",
          "text": "不对，不对！是我的宠物蛇口粮，全部不见了！"
        },
        {
          "role": "派蒙",
          "text": "宠物蛇也有专用口粮吗？它们一般不是会吃老鼠之类的…"
        },
        {
          "role": "古拉布吉尔",
          "text": "最开始它们也是会自己觅食的。"
        },
        {
          "role": "古拉布吉尔",
          "text": "但自从它们进食的时候吓到了几个孩子之后，我就不敢让它们自己出去了，都是自己调制口粮给它们吃。"
        },
        {
          "role": "古拉布吉尔",
          "text": "唉…不过，自从我开始给它们调制口粮之后，它们就开始懒得动弹，也基本上不吃其他食物了。"
        },
        {
          "role": "派蒙",
          "text": "欸…不劳而获的食物啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吃！",
              "dialogues": []
            },
            {
              "text": "非常好吃！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我还没问味道呢，别这么一脸向往的表情，你不会有这种机会的啦！"
        },
        {
          "role": "派蒙",
          "text": "那种机会是派蒙的！"
        },
        {
          "role": "旅行者",
          "text": "说得真是理直气壮…"
        },
        {
          "role": "古拉布吉尔",
          "text": "我肯定是之前出去采草药的时候，把口粮落在哪处营地里了。"
        },
        {
          "role": "古拉布吉尔",
          "text": "可是我也不方便自己去找，得留在这里看着这群小家伙，防止它们饿极了溜出去吓到别人…"
        },
        {
          "role": "古拉布吉尔",
          "text": "旅行者，你能帮我跑一趟，从营地里把口粮带回来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就交给我吧。",
              "dialogues": [
                {
                  "role": "古拉布吉尔",
                  "text": "太谢谢你了，要是我自己带着这群小家伙回去找，还不知道会发生什么意外呢。"
                },
                {
                  "role": "古拉布吉尔",
                  "text": "要是它们兴致来了，往林子里一钻玩个几天，那我就惨了…"
                }
              ]
            },
            {
              "text": "那边不会有其他蛇吧…",
              "dialogues": [
                {
                  "role": "古拉布吉尔",
                  "text": "不会的，不会的，我选的那几处营地都特意避开了蛇的聚集地，免得惹上什么麻烦…"
                }
              ]
            },
            {
              "text": "有很多处营地吗？",
              "dialogues": [
                {
                  "role": "古拉布吉尔",
                  "text": "我之前在雨林里生活的时候，亲手布置了不少营地。"
                },
                {
                  "role": "古拉布吉尔",
                  "text": "虽然现在我已经不在雨林里讨生活了…但进林子采草药的时候，我还是会在营地里休息一下。"
                }
              ]
            }
          ]
        },
        {
          "role": "古拉布吉尔",
          "text": "总之，这件事就拜托你了，旅行者。"
        },
        {
          "role": "古拉布吉尔",
          "text": "我把这次待过的营地标注在你的地图上，请你去那边看看吧。"
        },
        {
          "role": "派蒙",
          "text": "养蛇做宠物的人，总感觉之前也见过呢…对了！那个叫做白术的怪人…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "长生应该不是「宠物」啦…",
              "dialogues": []
