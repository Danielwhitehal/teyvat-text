        },
        {
          "role": "古拉布吉尔",
          "text": "你们回来了！好快啊，找到口粮了吗？"
        },
        {
          "role": "旅行者",
          "text": "是这个吗？"
        },
        {
          "type": "subtitle",
          "text": "前往营地"
