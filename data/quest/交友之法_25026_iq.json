  "chapter_title": "交友之法",
  "type": "iq",
  "route": "How to Make Friends",
  "stories": [
    {
      "story_id": 25026,
      "title": "交友之法",
      "description": "在圣火竞技场旁边，有一位「悬木人」的部族成员正在为某事而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "帮助烦恼的猎人"
        },
        {
          "role": "特阿墨",
          "text": "可怜的小匿叶龙…这帮恶棍，我一定得教训他们！"
        },
        {
          "role": "特阿墨",
          "text": "恶棍们，你们可以逃，但绝对无处可藏…！"
        },
        {
          "role": "旅行者",
          "text": "发生什么了？"
        },
        {
          "role": "特阿墨",
          "text": "你是…外来的旅行者，对吧？向你致意，很抱歉，现在我没办法招待你。"
        },
        {
          "role": "特阿墨",
          "text": "那群不识好歹的盗宝团恶棍，又想抓住那只小匿叶龙，还好我去的及时，把他们都赶跑了。"
        },
        {
          "role": "特阿墨",
          "text": "那只小匿叶龙一定是吓坏了，无论我怎么招呼，它都不肯过来…"
        },
        {
          "role": "特阿墨",
          "text": "但现在，我已经找到了那群盗宝团的所在地，等会就去教训这帮恶棍。再把他们捆在树上，拿树藤狠狠地抽一顿！"
        },
        {
          "role": "特阿墨",
          "text": "而且，还要找点好吃的，去安慰一下那只小匿叶龙才行…"
        },
        {
          "role": "旅行者",
          "text": "还是先去安慰小匿叶龙吧。"
        },
        {
          "role": "特阿墨",
          "text": "唔…你说得也有道理，那孩子一定被吓得够呛。还是先去安慰一下它比较好啊…"
        },
        {
          "role": "特阿墨",
          "text": "那就跟我来吧，看你的模样，想必也是位经验丰富的冒险家。"
        },
        {
          "role": "特阿墨",
          "text": "我们两个一起过去，那群不怀好意的人肯定不敢再来。不用担心报酬，我会按照冒险家的规矩准备好的。"
        },
        {
          "role": "特阿墨",
          "text": "我想想，那孩子很喜欢吃新鲜的烛伞蘑菇…我记得那边的树下长着很多,请你先去采一些吧。"
        },
        {
          "role": "特阿墨",
          "text": "我去另一边采烛伞蘑菇，等你采好了，我们在竞技场那边的悬崖上集合。"
        },
        {
          "role": "特阿墨",
          "text": "那孩子平时经常在那边休息。也许我们可以去那边找到它。"
        },
        {
          "role": "旅行者",
          "text": "我们一起去教训盗宝团吧。"
        },
        {
          "role": "特阿墨",
          "text": "你愿意和我一起去？那太好了，看你这副模样…想必也是位经验丰富的冒险家。"
        },
        {
          "role": "特阿墨",
          "text": "我会按冒险家的规矩准备好报酬的。那我们立即出发吧，给那群恶棍一点颜色瞧瞧。"
        },
        {
          "role": "旅行者",
          "text": "还是先去安慰小匿叶龙吧。"
        },
        {
          "role": "特阿墨",
          "text": "行。这样的话，也许能让那孩子心情更好一些。"
        },
        {
          "role": "特阿墨",
          "text": "有我们俩在，那群盗宝团一定不敢再来找霉头。"
        },
        {
          "role": "特阿墨",
          "text": "让我想想…请你先去那边的树下采两朵新鲜的烛伞蘑菇吧。"
        },
        {
          "role": "特阿墨",
          "text": "等你采好了，我们还是在竞技场那边的悬崖上集合。有你在，那些盗宝团肯定不敢露头。"
        },
        {
          "role": "旅行者",
          "text": "我们一起去教训盗宝团吧。"
        },
        {
          "role": "特阿墨",
          "text": "没问题，那群盗宝团死性不改，又扎了新营。我已经确定好了位置。"
        },
        {
          "role": "特阿墨",
          "text": "报酬还是按照冒险家的规矩来算。我们立刻出发吧。"
        },
        {
          "role": "特阿墨",
          "text": "…嘘。看那边，那孩子在等我们。"
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "朋友…？不认识…好人…？"
        },
        {
          "role": "特阿墨",
          "text": "好孩子，来这边。我们不会伤害你的。"
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "好人…？朋友…"
        },
        {
          "role": "特阿墨",
          "text": "我是特阿墨，记得吗？之前给你吃过好吃的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我是旅行者。",
              "dialogues": []
            },
            {
              "text": "帮你找过好吃的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "你…朋友！"
        },
        {
          "role": "？？？",
          "text": "和开心的小匿叶龙玩了一段时间。看起来，他似乎心情好了不少…"
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "给你，给你，礼物！"
        },
        {
          "role": "特阿墨",
          "text": "这是…旅行者，看来我们都收到一份礼物了。"
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "朋友，谢谢！"
        },
        {
          "role": "旅行者",
          "text": "谢谢你喔。"
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "朋友！朋友！好！好！再见！"
        },
        {
          "role": "？？？",
          "text": "小匿叶龙欢快地围着你们转了两圈，随后就转身，再次钻进了林子里。"
        },
        {
          "role": "特阿墨",
          "text": "看来，这孩子是回家了。希望他之后别再遇见恶棍了。"
        },
        {
          "role": "特阿墨",
          "text": "我们也回去吧。这些报酬给你，请收下吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一次委托收到了两份报酬。",
              "dialogues": []
            },
            {
              "text": "这次的委托还蛮赚的嘛。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特阿墨",
          "text": "那你可要把小匿叶龙送给你的那一份收好了。我给你的那一份嘛…哈哈哈，就随你怎么花吧。"
        },
        {
          "type": "subtitle",
          "text": "采两朵新鲜的烛伞蘑菇"
        },
        {
          "type": "subtitle",
          "text": "前往悬崖边寻找特阿墨"
        },
        {
          "role": "特阿墨",
          "text": "平时那孩子经常呆在这里。但今天，怎么没见到它留下的痕迹…"
        },
        {
          "role": "特阿墨",
          "text": "也许是被吓坏了，特意藏起来了吧。"
        },
        {
          "role": "旅行者",
          "text": "我们要去找到它吗？"
        },
        {
          "role": "特阿墨",
          "text": "…不必了。先让那孩子安静一会吧。咱们把烛伞蘑菇放在这里就好。"
        },
        {
          "role": "旅行者",
          "text": "你还挺熟练的…"
        },
        {
          "role": "特阿墨",
          "text": "我已经照顾这孩子一段时间了。它的性格很敏感，就算是遇见陌生人都会吓一跳。"
        },
        {
          "role": "特阿墨",
          "text": "我喂了这只小匿叶龙很长时间，这孩子才愿意靠近我…唉，可是被那群恶棍一闹，它肯定又不愿意出来了。"
        },
        {
          "role": "特阿墨",
          "text": "没办法，只能让它先自己安静一会了。"
        },
        {
          "role": "特阿墨",
          "text": "多谢你陪我一起来。这是报酬，请收下吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没看见它，有点遗憾。",
              "dialogues": []
            },
            {
              "text": "还是想见见那只小匿叶龙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特阿墨",
          "text": "放心。那孩子会记住对它好的人。等到时机成熟，它一定会来见我们的。"
        },
        {
          "role": "特阿墨",
          "text": "…嘘。看那边，那孩子在等我们。"
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "…呜？呜，呜…？"
        },
        {
          "role": "特阿墨",
          "text": "好孩子，来这边。我们不会伤害你的。"
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "呜…？呜呜…"
        },
        {
          "role": "特阿墨",
          "text": "我是特阿墨，记得吗？之前给你吃过好吃的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我是旅行者。",
              "dialogues": []
            },
            {
              "text": "帮你找过好吃的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "呜…呜呜！"
        },
        {
          "role": "？？？",
          "text": "和开心的小匿叶龙玩了一段时间。看起来，它似乎心情好了不少…"
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "呜！呜呜，呜！"
        },
        {
          "role": "特阿墨",
          "text": "这是…旅行者，看来这孩子已经把你当朋友了，我们也都收到了礼物。"
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "呜！呜！"
        },
        {
          "role": "旅行者",
          "text": "谢谢你喔。"
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "呜！呜呜！呜！"
        },
        {
          "role": "？？？",
          "text": "小匿叶龙欢快地围着你们转了两圈，随后就转身，再次钻进了林子里。"
        },
        {
          "role": "特阿墨",
          "text": "看来，这孩子是回家了。希望它之后别再遇见恶棍了。"
        },
        {
          "role": "特阿墨",
          "text": "我们也回去吧。这些报酬给你，请收下吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一次委托收到了两份报酬。",
              "dialogues": []
            },
            {
              "text": "这次的委托还蛮赚的嘛。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特阿墨",
          "text": "那你可要把小匿叶龙送给你的那一份收好了。我给你的那一份嘛…哈哈哈，就随你怎么花吧。"
        },
        {
          "role": "特阿墨",
          "text": "那孩子不在啊…唔，我们就把烛伞蘑菇放在这里吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没看见它，有点遗憾。",
              "dialogues": []
            },
            {
              "text": "还想再见见那只小匿叶龙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "怯生生的小匿叶龙",
          "text": "呜！呜呜！呜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "欸？我好像听见什么声音。",
              "dialogues": []
            },
            {
              "text": "难道它就躲在旁边？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特阿墨",
          "text": "我们还是先依着它吧。也许等这孩子再长大一些之后，就愿意和我们更亲近一些了。"
        },
        {
          "role": "特阿墨",
          "text": "无论如何，只要它能开心地生活下去就好了。"
        },
        {
          "role": "特阿墨",
          "text": "喂——我们走啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们走啦！",
              "dialogues": []
            },
            {
              "text": "下次再见！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特阿墨",
          "text": "对了，这些报酬给你，就当做是感谢了。"
        },
        {
          "role": "特阿墨",
          "text": "希望那孩子能快快长大。这样的话…它就能亲自踢飞那些盗宝团了，哈哈哈！"
        },
        {
          "type": "subtitle",
          "text": "教训盗宝团"
        },
        {
          "type": "subtitle",
          "text": "与特阿墨交谈"
        },
        {
          "role": "特阿墨",
          "text": "哼，这下他们应该不敢随便去伤害小匿叶龙了。"
        },
        {
          "role": "旅行者",
          "text": "总感觉，有什么误会…"
        },
        {
          "role": "特阿墨",
          "text": "别听他们的花言巧语。我可是亲眼看着，他们想要把绳子捆在小匿叶龙的尾巴上。"
        },
        {
          "role": "特阿墨",
          "text": "要不是我过去的及时，真不知道会出什么事。"
        },
        {
          "role": "特阿墨",
          "text": "再次感谢你帮忙，这些报酬给你，请收下吧。"
        },
        {
          "role": "特阿墨",
          "text": "可惜，那群盗宝团跑得太快了。要是能抓住他们，我一定要把这群恶徒斩草除根！"
        }
      ]
    }
  ]
}