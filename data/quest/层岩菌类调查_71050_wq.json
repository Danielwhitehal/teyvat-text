{
  "quest_id": 71050,
  "chapter_num": null,
  "chapter_title": "层岩菌类调查",
  "type": "wq",
  "route": "Mycological Investigation in The Chasm",
  "stories": [
    {
      "story_id": 71050,
      "title": "层岩菌类调查",
      "description": "层岩巨渊有许多奇异的生态环境和地质环境，其中尤为特殊的就是生长在层岩的荧光蘑菇，帮助须弥学者海迪夫调查一下此处的蘑菇吧…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与海迪夫对话"
        },
        {
          "role": "旅行者",
          "text": "关于这种蘑菇…"
        },
        {
          "role": "海迪夫",
          "text": "该说真不愧是经验丰富的冒险家吗，这么快就有所发现了。"
        },
        {
          "role": "海迪夫",
          "text": "嗯？这确定是在这里采摘的菌类吗，这可有点奇怪啊…"
        },
        {
          "role": "旅行者",
          "text": "地下不能长蘑菇吗？"
        },
        {
          "role": "海迪夫",
          "text": "也不是不能长的问题。"
        },
        {
          "role": "海迪夫",
          "text": "只是因为这个菌和生长在须弥的一种菌很像…"
        },
        {
          "role": "海迪夫",
          "text": "只有一种不太够啊…如果有足够多的样本，说不定就能看出些什么。"
        },
        {
          "role": "海迪夫",
          "text": "足够多的样本啊…这个既然也是你拿回来的，肯定知道在哪里还有…不如你帮我采点吧！"
        },
        {
          "role": "海迪夫",
          "text": "你帮我采足够多的蘑菇，我给你足够多的钱作为报酬。"
        },
        {
          "role": "旅行者",
          "text": "足够多是多少蘑菇？"
        },
        {
          "role": "海迪夫",
          "text": "嗯…我想想，那就先采8个吧。"
        },
        {
          "role": "海迪夫",
          "text": "没关系，只要你带过来，钱不会少你的！"
        },
        {
          "type": "subtitle",
          "text": "收集8只发光的蘑菇"
        },
        {
          "type": "subtitle",
          "text": "将采摘到的发光蘑菇交给海迪夫进行鉴定"
        },
        {
          "role": "旅行者",
          "text": "蘑菇采回来了。"
        },
        {
          "role": "海迪夫",
          "text": "嗯嗯，多谢多谢。"
        },
        {
          "role": "海迪夫",
          "text": "有了你的帮助，我的调查就像是…有句璃月话是怎么说的来着，「就像猛虎插上了翅膀一样顺利」。"
        },
        {
          "role": "旅行者",
          "text": "如虎添翼？"
        },
        {
          "role": "海迪夫",
          "text": "对，简直就是如虎添翼。"
        },
        {
          "role": "海迪夫",
          "text": "这些菌类，怎么会这样呢…"
        },
        {
          "role": "海迪夫",
          "text": "这可奇怪了，这种菌类和须弥的一种菌类简直就是一模一样，但怎么会发光呢，在黑暗中生长所以长出了荧光素？"
        },
        {
          "role": "海迪夫",
          "text": "但是既然已经进化出荧光素，为什么菌类的本体什么变化都没有？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "完全听不懂…",
              "dialogues": []
            },
            {
              "text": "有什么问题吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海迪夫",
          "text": "嗯…简单来说，菌类会适应环境进化，但是这种真菌的本体，显然是更适合生长在森林环境的品种。"
        },
        {
          "role": "海迪夫",
          "text": "所以，这种真菌本来是生长在须弥的，这点毋庸置疑。"
        },
        {
          "role": "旅行者",
          "text": "那发光是…"
        },
        {
          "role": "海迪夫",
          "text": "真菌不是层岩巨渊的原生种，就说明发光不是进化产物，而是非正常生态影响导致的…"
        },
        {
          "role": "海迪夫",
          "text": "大概因为那个天上掉下来的碎块吧，吸收了它的能量…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "碎块？",
              "dialogues": []
            },
            {
              "text": "什么碎块？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海迪夫",
          "text": "咳咳…嗯？你刚才说什么，碎块？啊，我是说，肯定是因为真菌的碎块从天上飘下来的时候产生了…"
        },
        {
          "role": "海迪夫",
          "text": "产生了偶发性的变异。"
        },
        {
          "role": "海迪夫",
          "text": "一定是这样的！"
        },
        {
          "role": "海迪夫",
          "text": "嗯，能采集这些真菌真是感谢你，辛苦了辛苦了，先去好好休息一下吧！"
        },
        {
          "role": "海迪夫",
          "text": "我要对这些真菌再做些研究，旁边有人会打扰到我的。"
        }
      ]
    }
  ]
}