{
  "quest_id": 77657,
  "chapter_num": null,
  "chapter_title": "一场特殊的选拔",
  "type": "wq",
  "route": "A Special Selection",
  "stories": [
    {
      "story_id": 77657,
      "title": "一场特殊的选拔",
      "description": "偶然路过「冬契军」总部的你，发现这里正在进行一场特殊的选拔…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往「冬契军」总部"
        },
        {
          "role": "派蒙",
          "text": "他们这是在做什么？"
        },
        {
          "role": "雅洛维娅",
          "text": "预备…开始！"
        },
        {
          "role": "紧张的年轻人",
          "text": "唔…"
        },
        {
          "role": "雅洛维娅",
          "text": "不行，只有这种水平的话，根本无法完成任务。"
        },
        {
          "role": "紧张的年轻人",
          "text": "真的不行吗？我很需要这个机会！"
        },
        {
          "role": "雅洛维娅",
          "text": "很抱歉，这是性命攸关的事，我们不能把如此危险的任务交给一个不合格的人。"
        },
        {
          "role": "雅洛维娅",
          "text": "下一个！"
        },
        {
          "role": "派蒙",
          "text": "看上去是在选拔枪法好的人？"
        },
        {
          "role": "旅行者",
          "text": "是在招募新兵吗？"
        },
        {
          "role": "应募者",
          "text": "听说不是常规的募兵，这次的招募标准严格多了。"
        },
        {
          "role": "应募者",
          "text": "要是每次募兵都采用这种标准，恐怕冬契军早就因为招不到人而解散了。"
        },
        {
          "role": "派蒙",
          "text": "那为什么还有这么多人来？"
        },
        {
          "role": "应募者",
          "text": "因为报酬足够丰厚啊，我听人说，要是合格了，甚至能领到克什尼克晶矿！"
        },
        {
          "role": "雅洛维娅",
          "text": "下一个！"
        },
        {
          "role": "应募者",
          "text": "到我了…来了！"
        },
        {
          "role": "派蒙",
          "text": "晶矿…最近这东西确实很抢手，在这里竟然可以直接领到吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "作为呼啸社的一员…",
              "dialogues": []
            },
            {
              "text": "我有个想法。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我知道了，凭你的枪法，肯定能合格，然后就把从这里领到的晶矿都分给那些村民，对吗？"
        },
        {
          "role": "派蒙",
          "text": "听上去确实是一位呼啸社的成员该做的事！"
        },
        {
          "role": "雅洛维娅",
          "text": "下一个！"
        },
        {
          "role": "派蒙",
          "text": "呀，到我们了…"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "雅洛维娅",
          "text": "合…合格！"
        },
        {
          "role": "派蒙",
          "text": "好耶！"
        },
        {
          "role": "雅洛维娅",
          "text": "恕我冒昧，阁下应该进入过影域吧？"
        },
        {
          "role": "旅行者",
          "text": "是的，有问题吗？"
        },
        {
          "role": "雅洛维娅",
          "text": "请先随我来。"
        },
        {
          "role": "雅洛维娅",
          "text": "从阁下使用的枪械来看，阁下已经进入过影域，并且了解其中的危险。"
        },
        {
          "role": "雅洛维娅",
          "text": "我的上级希望我能安排人手将这些危险消灭在影域之内，防止它影响到影域外的世界。"
        },
        {
          "role": "雅洛维娅",
          "text": "借助这种设备，我们可以将阁下投送到指定的影域内，之后就要仰赖阁下刚刚展现的能力了。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样…"
        },
        {
          "role": "旅行者",
          "text": "那报酬呢？"
        },
        {
          "role": "派蒙",
          "text": "对啊，有没有晶矿呢？"
        },
        {
          "role": "雅洛维娅",
          "text": "晶矿？阁下应该是听到了应募者之间的传言吧，看来大家想象中最丰厚的报酬就是它了。"
        },
        {
          "role": "雅洛维娅",
          "text": "事实上，上级准许我给出的条件是，除了最高规格的津贴之外，阁下还可以指定一批完成任务所需的物资。"
        },
        {
          "role": "雅洛维娅",
          "text": "只要在冬契军力所能及的范围内，就优先供应给阁下。"
        },
        {
          "role": "派蒙",
          "text": "那样的话…我们需要一些晶矿！"
        },
        {
          "role": "雅洛维娅",
          "text": "嗯…可以安排，不过阁下可以告诉我具体用来做什么吗？"
        },
        {
          "role": "派蒙",
          "text": "这个嘛…"
        },
        {
          "role": "旅行者",
          "text": "分给那些有需要的人。"
        },
        {
          "role": "派蒙",
          "text": "旅行者…"
        },
        {
          "role": "雅洛维娅",
          "text": "这样啊…如果是作为让阁下出手的条件，我可以接受。"
        },
        {
          "role": "雅洛维娅",
          "text": "向您禀报，已经有了合适的人选。"
        },
        {
          "role": "雅洛维娅",
          "text": "真是惭愧，最近冬契军的人手很短缺。不然的话，这种任务应该由我们来完成才是。"
        },
        {
          "role": "薇斯纳",
          "text": "不必自责，陛下之所以安排了「特殊招募计划」，就是为了应对这种情况。"
        },
        {
          "role": "薇斯纳",
          "text": "至冬是一个伟大的国家，陛下相信潜藏在民间的力量。"
        },
        {
          "role": "雅洛维娅",
          "text": "在下明白了。"
        },
        {
          "role": "薇斯纳",
          "text": "另外可不要忘了，「特殊招募计划」选拔出的人才不只是用来应对官方不便处理的问题。"
        },
        {
          "role": "薇斯纳",
          "text": "这次入选的人有希望更进一步，去承接女皇的敕令吗？"
        },
        {
          "role": "雅洛维娅",
          "text": "说到这一点，在下希望您能先阅读一下这位入选者的登记信息，他或许就是您想找的那种人。"
        },
        {
          "role": "薇斯纳",
          "text": "是他？这可就有趣了…"
        },
        {
          "role": "薇斯纳",
          "text": "是旅行者？算了，当我没问…"
        }
      ]
    }
  ]
}