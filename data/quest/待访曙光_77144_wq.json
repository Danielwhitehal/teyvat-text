{
  "quest_id": 77144,
  "chapter_num": null,
  "chapter_title": "待访曙光",
  "type": "wq",
  "route": "Awaiting the Dawn",
  "stories": [
    {
      "story_id": 77144,
      "title": "待访曙光",
      "description": "沃雅妮莎似乎前往了曙光车站，在那里，好像有事情等她处理…",
      "dialogues": [
        {
          "role": "沃雅妮莎",
          "text": "玩得这么熟练？看起来你之前没少玩「哐哐当当雀雀球」啊…"
        },
        {
          "role": "迈斯卡娅",
          "text": "…看起来，各个设施运转得也很正常，已经可以正式营业了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "…真的不能给雀雀球多准备几套衣服吗？如果是出于资金问题考虑的话，那包在我身上。"
        },
        {
          "role": "沃雅妮莎",
          "text": "我衣柜里还有好多衣服呢，大不了拿出来几套给它们换上呗。"
        },
        {
          "role": "迈斯卡娅",
          "text": "我相信您的审美，沃雅妮莎小姐，但您的衣服都太贵重了。考虑到这游戏的玩法，对衣服的损耗实在是…"
        },
        {
          "role": "沃雅妮莎",
          "text": "哦，有几件确实是挺贵的。但无所谓啊，反正都是穿不了的旧衣服。"
        },
        {
          "role": "沃雅妮莎",
          "text": "就算不给雀雀球套上，等城里募捐的人过来了，我也会把它们都捐出去的。"
        },
        {
          "role": "沃雅妮莎",
          "text": "而且，既然你要在我打理的车站里开店铺，店铺和店里的东西都必须要既气派，又漂亮。"
        },
        {
          "role": "迈斯卡娅",
          "text": "雀雀球还有一项重要的特征：可爱。"
        },
        {
          "role": "沃雅妮莎",
          "text": "好的，那就既气派，又漂亮，也可爱。"
        },
        {
          "role": "沃雅妮莎",
          "text": "——你不介意我把可爱放在最后一项吧？我保证，它们三者都同等重要。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "沃雅妮莎？",
            "你这是在…"
          ]
        },
        {
          "role": "派蒙",
          "text": "这旁边的摆设好熟悉，这是…团雀？对了！这不应该是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "团雀最可爱！",
            "好耶！"
          ]
        },
        {
          "role": "派蒙",
          "text": "吓我一跳…你干嘛啦！但话说回来，拜希麦小姐去哪了？"
        },
        {
          "role": "派蒙",
          "text": "平常不都是她在照看「哐哐当当雀雀球」的摊位么，这次怎么突然换人了，还有点不习惯呢…"
        },
        {
          "role": "沃雅妮莎",
          "text": "咦，你们还挺熟悉「哐哐当当雀雀球」的嘛，居然还知道拜希麦。"
        },
        {
          "role": "迈斯卡娅",
          "text": "你们是…喔，拜希麦和我提起过你们，旅行者和小派蒙。"
        },
        {
          "role": "迈斯卡娅",
          "text": "抱歉，拜希麦正在开发新的雀雀球玩法，一时半会抽不开身，只能由我代她在这里看着店铺。"
        },
        {
          "role": "沃雅妮莎",
          "text": "不过，这些布设和小玩具，可都是由拜希麦小姐亲自监督制作的。"
        },
        {
          "role": "迈斯卡娅",
          "text": "是的。一切都和你们所知的「哐哐当当雀雀球」一样。"
        },
        {
          "role": "沃雅妮莎",
          "text": "哎呀，多说也没用，旅行者，你自己来试玩体验一下吧。"
        },
        {
          "role": "沃雅妮莎",
          "text": "你应该…很久没有玩过「哐哐当当雀雀球」了吧？玩得有点手忙脚乱啊…"
        },
        {
          "role": "迈斯卡娅",
          "text": "…看起来，各个设施运转得也很正常，已经可以正式营业了。"
        },
        {
          "role": "派蒙",
          "text": "不过，玩起来确实是之前的感觉呢，嘿嘿，团雀也很可爱！"
        },
        {
          "role": "迈斯卡娅",
          "text": "呵，玩得开心就好…拜希麦之前也和我说过，你们是最能理解她和团雀的人，也是和团雀一样可爱的人。"
        },
        {
          "role": "派蒙",
          "text": "欸？拜希麦小姐这么说吗，嘿嘿嘿，其实也还好啦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "派蒙最可爱！",
            "好欸！"
          ]
        },
        {
          "role": "派蒙",
          "text": "我说你还喊来劲了啊！这种话说一次就够了啊，再这样的话，我也要喊旅行者最可爱了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "咳咳…",
            "…嗓子有点痛。"
          ]
        },
        {
          "role": "派蒙",
          "text": "你这人啊…等一下喔，我去给你倒点水去…"
        },
        {
          "role": "沃雅妮莎",
          "text": "水在这里，喝吧。"
        },
        {
          "role": "派蒙",
          "text": "沃雅妮莎准备得好周全喔，但说起来，刚才你说…这个车站平时主要是由你打理？"
        },
        {
          "role": "沃雅妮莎",
          "text": "是啊，说是打理，其实就相当于「重建」了。毕竟这座车站的状态…无论怎么看，都不是很好。"
        },
        {
          "role": "沃雅妮莎",
          "text": "车站都这样了，不仅住在这里的人们生活得不方便，而且列车停靠的时候也很麻烦。总而言之，两方面都很郁闷。"
        },
        {
          "role": "沃雅妮莎",
          "text": "所以，出于各种考量，我就拉着奥黛塔和阿罗夏来打理它了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "不过，毕竟这座车站也不算完全废弃，只要补充上关键物资，然后稍加修缮，它就能重焕生机。"
        },
        {
          "role": "沃雅妮莎",
          "text": "但在重焕生机之后，这个车站会变成什么样…哼哼，那就是随我们心意了。"
        },
        {
          "role": "旅行者",
          "text": "不过，这里主要是你来打理…"
        },
        {
          "role": "沃雅妮莎",
          "text": "没错，奥黛塔和阿罗夏都忙嘛，平时都不方便经常过来。"
        },
        {
          "role": "沃雅妮莎",
          "text": "奥黛塔你知道，一天到晚忙得脚跟不沾地，还好她是跳芭蕾舞的，脚跟平时就不怎么沾地。"
        },
        {
          "role": "沃雅妮莎",
          "text": "阿罗夏么…他自己的事就够他操心的了，不过，他还是挑了几只可靠的小狗来车站做看护。"
        },
        {
          "role": "沃雅妮莎",
          "text": "阿罗夏么…他自己的事就够他操心的了，但他说，之后会挑几只可靠的小狗来车站做看护。"
        },
        {
          "role": "派蒙",
          "text": "但沃雅妮莎平时不也要练习么？在车站里的话，列车轰隆隆的，难道不会打扰到你么？"
        },
        {
          "role": "沃雅妮莎",
          "text": "这不是正好？轰隆隆的声音正好盖住我练习唱歌时的歌声。"
        },
        {
          "role": "沃雅妮莎",
          "text": "否则，要是列车司机听见我唱歌的话，说不定会忘了启动列车，而导致列车晚点很久呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "怎么听起来…",
            "是一件确实会发生的事…"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "是这样？那下次，我在列车进站的时候唱一曲试试，看看…最多能让列车晚点多久？"
        },
        {
          "role": "派蒙",
          "text": "不用啦不用啦——列车还是准点运行最重要，不能耽误大家的事情啊…"
        },
        {
          "role": "沃雅妮莎",
          "text": "不对！光顾着和你们聊天，我还要处理雀雀球的衣服问题呢。"
        },
        {
          "role": "沃雅妮莎",
          "text": "迈斯卡娅，那就这么定了，我回去把适合雀雀球穿的衣服都翻出来，找人裁剪好之后送过来。"
        },
        {
          "role": "沃雅妮莎",
          "text": "…唔，单纯的换衣服，好像也没什么意思。"
        },
        {
          "role": "沃雅妮莎",
          "text": "不然，直接把雀雀球打扮成奥黛塔和阿罗夏的样子…"
        },
        {
          "role": "沃雅妮莎",
          "text": "嘻嘻，这样肯定好玩，那也不需要旧衣服了，直接买一批新布做吧，看我亲手来裁一裁…"
        }
      ]
    }
  ]
}