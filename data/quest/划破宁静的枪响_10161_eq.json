{
  "quest_id": 10161,
  "chapter_num": "铳枪与蔷薇 第一幕",
  "chapter_title": "划破宁静的枪响",
  "type": "eq",
  "route": "The Crack of Muskets Breaking the Silence",
  "stories": [
    {
      "story_id": 40132,
      "title": "划破宁静的枪响",
      "description": "时值枫丹「千灵节」，孩子们提着篮子走上街头，讨要糖果。漫步在如此热闹的节日街头，或许会遇到几位熟悉的朋友…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "你读《蒸汽鸟报》了吗？看起来枫丹最近在过什么节日，广场那边好热闹呀！连旗子都换了！"
        },
        {
          "role": "派蒙",
          "text": "好多人手上拿着留影机，还有点心糖果，好开心的样子！"
        },
        {
          "role": "派蒙",
          "text": "我们也去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "前往枫丹廷的广场"
        },
        {
          "role": "泽维尔",
          "text": "…这！莫里斯先生，您这位先生啊！怎么能现在才跟我说这些？"
        },
        {
          "role": "莫里斯",
          "text": "哎，我也是没办法…这真的是突发状况！"
        },
        {
          "role": "泽维尔",
          "text": "那我的映影可怎么办？"
        },
        {
          "role": "莫里斯",
          "text": "这…只能你自己想想办法了，或者听我一句劝，这个映影节就随它去吧…"
        },
        {
          "role": "泽维尔",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "那不是泽维尔吗？原来他回到枫丹啦。"
        },
        {
          "role": "派蒙",
          "text": "泽维尔！"
        },
        {
          "role": "泽维尔",
          "text": "哎呀！这不是我亲爱的旅行者先生/小姐和派蒙吗？没想到…没想到会在此时此刻和您相会…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好久不见。",
              "dialogues": []
            },
            {
              "text": "近来可好？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "泽维尔",
          "text": "本来挺好的，但…我刚刚被一个噩耗叩门拜访。与我合作拍映影的投资人因为财务危机，无法提供资金支持了…"
        },
        {
          "role": "派蒙",
          "text": "那再找下一位投资人不就好了？"
        },
        {
          "role": "泽维尔",
          "text": "不…这次的合同是专门为「千灵映影节」而签订的，它规定了我在节日结束前都不能与其他投资人合作。"
        },
        {
          "role": "派蒙",
          "text": "千灵映影节？"
        },
        {
          "role": "泽维尔",
          "text": "哦，你们是第一次参加枫丹的「千灵节」吧？我来给你们解释一下。"
        },
        {
          "role": "泽维尔",
          "text": "「千灵节」是为了纪念传说中寻找纯水精灵、迎回了水神「厄歌莉娅」的纯水骑士而设立的节日。"
        },
        {
          "role": "泽维尔",
          "text": "这个日子和枫丹的成立、以及其特有的「律法」与「审判」息息相关，也是枫丹最重要的节日之一。"
        },
        {
          "role": "派蒙",
          "text": "泽维尔的表情，突然好别扭，就像…就像在吞一卷旧报纸一样…"
        },
        {
          "role": "泽维尔",
          "text": "这些话都是书上写的。为了避免一些…呃，定义上不必要的争议，在需要引用时，我一般就会这样…照着背一遍。"
        },
        {
          "role": "派蒙",
          "text": "哦！我懂了，就像是蒙德的风花节、璃月的海灯节一样！"
        },
        {
          "role": "泽维尔",
          "text": "可以这么类比，节日嘛！谁不喜欢？和其他国家的节日一样，每到「千灵节」这几天，枫丹廷还会举办许多活动。"
        },
        {
          "role": "泽维尔",
          "text": "人们为了纪念纯水骑士，会效仿他们的样子，穿上特殊的衣装、手举金杯、挨家挨户向人们讨要纯净水。"
        },
        {
          "role": "泽维尔",
          "text": "不过，最近几年芙宁娜大人觉得这样太无趣，就把「讨要纯净水」变成了「讨要甜点」。"
        },
        {
          "role": "派蒙",
          "text": "真像是她的风格呢…"
        },
        {
          "role": "泽维尔",
          "text": "现在它更像一个狂欢节，孩子们倒是挺喜欢，每年都能听到有人对你说「不给糖就审判」！"
        },
        {
          "role": "派蒙",
          "text": "听起来还挺有趣的！不过你刚才提到的「千灵映影节」又是什么？"
        },
        {
          "role": "泽维尔",
          "text": "哦！咱们都聊跑题了…我一定是见到您之后太开心了，让我们回归正题。"
        },
        {
          "role": "泽维尔",
          "text": "这是今年「枫丹映影协会」提出的活动。如今映影技术渐渐走向成熟，也是时候让这一艺术得到更多人关注了。"
        },
        {
          "role": "泽维尔",
          "text": "协会在这段时间，向人们公开收集映影成片，最后进行评选。得分最高的一部映影，将会获得协会颁发的「芙宁娜」奖。"
        },
        {
          "role": "派蒙",
          "text": "什…什么奖？"
        },
        {
          "role": "泽维尔",
          "text": "就是以水神大人的名字命名的「芙宁娜」奖，呃…这应该是在芙宁娜大人在位期间就取好的名字，如今嘛…也没人提出要改。"
        },
        {
          "role": "泽维尔",
          "text": "可能大家都觉得挺合适的吧。虽然她不再是水神，但芙宁娜大人作为枫丹的大明星，在舞台上闪耀的样子，是人们有目共睹的。"
        },
        {
          "role": "派蒙",
          "text": "好吧…这么一说的确挺搭…"
        },
        {
          "role": "泽维尔",
          "text": "哎，但谁能想到资金上出了问题呢…这下怎么和千织小姐还有千里迢迢从稻妻赶来的演员们交代…"
        },
        {
          "role": "派蒙",
          "text": "千织？这个名字好耳熟，我们是不是在哪里听到过？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "枫丹廷的服装店…",
              "dialogues": []
            },
            {
              "text": "「千织屋」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "泽维尔",
          "text": "没错，就是她。我请她来负责艺术指导，包含了这部映影中演员的形象设计。"
        },
        {
          "role": "派蒙",
          "text": "哦！我想起来了！娜维娅说她的衣服就是千织为她定制的！还有绮良良也是！"
        },
        {
          "role": "泽维尔",
          "text": "千织小姐怎么说呢，呃…说话直来直去，做事也很犀利。枫丹时尚界都叫她「鸣雷的裁锦师」。"
        },
        {
          "role": "泽维尔",
          "text": "因为她出色的服饰设计，不少枫丹人对稻妻都产生了浓厚的兴趣。"
        },
        {
          "role": "泽维尔",
          "text": "说回来…千织小姐和我请来的稻妻演员们都认识，这次跨国映影合作也多亏了她的相助，真是位好心肠的女士。"
        },
        {
          "role": "派蒙",
          "text": "稻妻的演员是谁呀？我们认识吗？"
        },
        {
          "role": "泽维尔",
          "text": "不如，二位和我一起去巡轨船总站台迎接他们吧。"
        },
        {
          "role": "泽维尔",
          "text": "算算时间，巡轨船快要到了，千织小姐也在那边等着和我会合。"
        },
        {
          "type": "subtitle",
          "text": "彩蛋"
        },
        {
          "type": "subtitle",
          "text": "夏沃蕾在会场旁的报刊亭前看书（不可对话）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往巡轨船总站克莱门汀线"
        },
        {
          "role": "泽维尔",
          "text": "千织小姐…"
        },
        {
          "role": "千织",
          "text": "你和投资人谈得挺快，巡轨船还没到。"
        },
        {
          "role": "千织",
          "text": "嗯？他们是谁？"
        },
        {
          "role": "泽维尔",
          "text": "哦，我来介绍一下吧，这是旅行者和派蒙。"
        },
        {
          "role": "千织",
          "text": "你们好。"
        },
        {
          "role": "派蒙",
          "text": "你好！听说「千织屋」的老板很厉害，今天总算见到真人了呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "娜维娅衣装的搭配很出彩。",
              "dialogues": [
                {
                  "role": "千织",
                  "text": "谢谢。为了配得上那位「大小姐」的身份，这点程度是必须的。"
                }
              ]
            },
            {
              "text": "绮良良衣装的概念很新颖。",
              "dialogues": [
                {
                  "role": "千织",
                  "text": "谢谢。我只是为了让她不要再穿得像一只掉进了颜料桶的猫。"
                }
              ]
            }
          ]
        },
        {
          "role": "千织",
          "text": "所以，发生什么事了？你脸色不对。"
        },
        {
          "role": "泽维尔",
          "text": "事情是这样…"
        },
        {
          "type": "subtitle",
          "text": "向千织叙述了投资人资金的问题…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "千织",
          "text": "……"
        },
        {
          "role": "泽维尔",
          "text": "稍等！稍等，千织小姐，我…我知道你提醒过我这位投资人有些问题…"
        },
        {
          "role": "千织",
          "text": "他绝对有。"
        },
        {
          "role": "泽维尔",
          "text": "但我实在无法拒绝…他当时提出了比其他人高一倍的预算…"
        },
        {
          "role": "千织",
          "text": "这就是问题所在。"
        },
        {
          "role": "泽维尔",
          "text": "我、我也是事出有因呀。拿到了这么优秀的剧本，当然还是想把这部映影给拍好啦。"
        },
        {
          "role": "泽维尔",
          "text": "但其他人提出的预算…完全撑不起账目，好不容易遇见一个愿意出大钱的人，我就…"
        },
        {
          "role": "派蒙",
          "text": "泽维尔你别难过，我们…我们说不定可以为你凑一些摩拉呢？"
        },
        {
          "role": "泽维尔",
          "text": "谢谢你，派蒙，你的好意我心领了。但映影的开销是很大的…光是凑，恐怕连演员的出场费都付不起…"
        },
        {
          "role": "千织",
          "text": "算了，已经发生的事也无可奈何。不过，现在还不是你放弃的时候。"
        },
        {
          "role": "泽维尔",
          "text": "咦？难道…千织你有什么办法吗？"
        },
        {
          "role": "千织",
          "text": "不是这个意思。我只是说事情还有的聊。"
        },
        {
          "role": "千织",
          "text": "毕竟我推荐的「演员」，比起摩拉，更注重其他东西…"
        },
        {
          "type": "subtitle",
          "text": "来自稻妻的三人正在巡轨船上与爱贝尔交谈…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "宵宫",
          "text": "…真的吗！那你们住哪儿呀？"
        },
        {
          "role": "爱贝尔",
          "text": "我们美露莘的家在海沫村，是一个需要从水下进入的地方哦！"
        },
        {
          "role": "宵宫",
          "text": "哇，那你们每天下班一定很累吧？要游好远好远的路呢！"
        },
        {
          "role": "爱贝尔",
          "text": "你好贴心！但一些美露莘也会选择住在枫丹廷，这样更加便捷嘛。"
        },
        {
          "role": "神里绫人",
          "text": "我们到了。"
        },
        {
          "role": "宵宫",
          "text": "欸？这就到了吗？我都还没和爱贝尔聊够呢！"
        },
        {
          "role": "神里绫华",
          "text": "我也很享受爱贝尔小姐的介绍，生动详实，让人意犹未尽。"
        },
        {
          "role": "爱贝尔",
          "text": "谢谢你们！我平时都在这班巡轨船上，希望还能见到你们！我还有好多景点没来得及跟你们介绍呢。"
        },
        {
          "type": "subtitle",
          "text": "巡轨船到站后…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "千织",
          "text": "欢迎来到枫丹廷。"
        },
        {
          "role": "神里绫华",
          "text": "千织小姐！你变化真大。这还是你离开稻妻之后我们第一次见面。"
        },
        {
          "role": "千织",
          "text": "我也想不到过了这么长时间。当时走得急，都没和你们道别。"
        },
        {
          "role": "神里绫人",
          "text": "感谢你的邀请，泽维尔先生。我很期待此次枫丹之行的收获。"
        },
        {
          "role": "泽维尔",
          "text": "神里先生能来，应该是我的荣幸才对。"
        },
        {
          "role": "派蒙",
          "text": "泽维尔你说的几位「演员」，居然是他们吗？"
        },
        {
          "role": "神里绫华",
          "text": "咦？旅行者和派蒙！"
        },
        {
          "role": "宵宫",
          "text": "哇！好巧！我和绫华路上还聊起你们！你们也是来拍映影的吗？"
        },
        {
          "role": "派蒙",
          "text": "我们在会场碰到了泽维尔，就一起跟来了。"
        },
        {
          "role": "宵宫",
          "text": "嘿嘿，不过我不是演员哟。神里大人和绫华才是，而且还是主演呢！我沾绫华的光，跟着一起出来玩玩。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还以为我是「永远的男/女一号」。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "泽维尔",
          "text": "我这不是…筹备映影的时候完全联系不上您吗？想着您也许在忙着自己的事务，不好打扰…"
        },
        {
          "role": "泽维尔",
          "text": "所以，在这部映影里，我就只能将您放在我心里，先另寻他人来饰演「一号演员」啦。"
        },
        {
          "role": "神里绫华",
          "text": "来枫丹的路上，我也思考了很久，怎样才能见到你们，给你们一个惊喜。没想到，还是被你们抢先了。"
        },
        {
          "role": "泽维尔",
          "text": "咦，各位都彼此认识？这可太巧了！大家能够在此重逢着实不易啊。"
        },
        {
          "role": "泽维尔",
          "text": "不如这样吧，我们移步到德波大饭店，大家边吃边聊。座位我也预定好了。"
        },
        {
          "role": "派蒙",
          "text": "咦？我们也有份吗？"
        },
        {
          "role": "泽维尔",
          "text": "当然有当然有，我会叮嘱老板多上几个好菜的。"
        },
        {
          "role": "神里绫人",
          "text": "那就有劳泽维尔先生带路了。"
        },
        {
          "role": "宵宫",
          "text": "哇！枫丹的建筑都好高，好大！"
        },
        {
          "role": "神里绫华",
          "text": "还有爱贝尔提到的喷泉。看起来十分精美华丽。"
        },
        {
          "role": "宵宫",
          "text": "中间那个大圆球是怎么转起来的呀？难道这就是发条机关？"
        },
        {
          "type": "subtitle",
          "text": "前往德波大饭店二楼"
        },
        {
          "role": "宵宫",
          "text": "嗯！这就是枫丹的美食吗？味道和稻妻真不一样。怎么说呢，做法更加…复杂？味道也很有层次感呢！"
        },
        {
          "role": "泽维尔",
          "text": "哈哈哈，我当初去稻妻的时候，反倒觉得那边口味太过清淡，花了些时间才适应。"
        },
        {
          "role": "神里绫人",
          "text": "说回此行的目的，泽维尔先生。你的映影，如今筹备到哪一步了？"
        },
        {
          "role": "泽维尔",
          "text": "其实，团队的成员我已经基本找齐了，灯光师、道具师、服装设计…剧本也从小说作者那里买到了版权。"
        },
        {
          "role": "宵宫",
          "text": "哦！是叫《两个铳枪手》对吧！来的路上我看了你寄来的剧本，是个不错的故事呢！"
        },
        {
          "role": "泽维尔",
          "text": "原本，等神里先生和绫华小姐到枫丹之后，映影就可以立马开拍，但…现在遇到了一个问题。"
        },
        {
          "role": "神里绫人",
          "text": "说来听听。"
        },
        {
          "role": "泽维尔",
          "text": "影片的投资人，莫里斯先生。今早突然告诉我他遇到了财务危机，无法给予我约定好的摩拉了…"
        },
        {
          "role": "神里绫人",
          "text": "听说枫丹的律法体系很完善，如果是他违约…不能将他告上审判庭吗？"
        },
        {
          "role": "泽维尔",
          "text": "哎，我更在意的是映影的拍摄…就算要上审判庭，一趟流程下来，开庭日恐怕都要排到一两个月之后了。"
        },
        {
          "role": "神里绫人",
          "text": "如果用筹资的方法解决资金问题呢？"
        },
        {
          "role": "泽维尔",
          "text": "我也这么想过。但…很难在短时间内筹集到这么多摩拉，毕竟「千灵映影节」的拍摄时间有限…"
        },
        {
          "role": "神里绫人",
          "text": "……"
        },
        {
          "role": "神里绫人",
          "text": "泽维尔先生，如果我和绫华愿意为你无偿出演的话，是否能解决你眼下面临的问题？"
        },
        {
          "role": "泽维尔",
          "text": "什么？这，这怎么行？你们大老远过来一趟，还无偿演出什么的…不不不，这绝对不行。"
        },
        {
          "role": "神里绫华",
          "text": "泽维尔先生，您不必介意。在收到您邀请的时候，我和哥哥其实就有这份打算了。"
        },
        {
          "role": "神里绫华",
          "text": "稻妻刚解除锁国不久，亟需加强与其他国家的文化交流。我们之前与枫丹合作较少，此行便是希望为将来开个好头。"
        },
        {
          "role": "神里绫人",
          "text": "不如说，这才是我们社奉行来枫丹真正的目的。"
        },
        {
          "role": "泽维尔",
          "text": "可…无偿演出也太委屈二位了…"
        },
        {
          "role": "神里绫人",
          "text": "哪里的话。虽说我们此行只是以「考察文化」的名义来到枫丹，但若是想要建立正式的文化合作，也得表达一些诚意。"
        },
        {
          "role": "神里绫人",
          "text": "这部映影，刚好能够成为稻妻与枫丹友好交流的证明。我个人也希望影片能够顺利上映。"
        },
        {
          "role": "神里绫人",
          "text": "若是还觉得过意不去的话，就请泽维尔先生多为我引荐几位枫丹文艺界的能人妙士吧。"
        },
        {
          "role": "泽维尔",
          "text": "……"
        },
        {
          "role": "泽维尔",
          "text": "好，那就照您说的办。谢谢，太谢谢你们了…这下我就算倾家荡产也要凑够摩拉！"
        },
        {
          "role": "千织",
          "text": "喂，别想那么绝，我也以「品牌赞助」的名义帮你一部分。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们也可以帮…",
              "dialogues": []
            },
            {
              "text": "以「朋友赞助」的名义…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宵宫",
          "text": "我也可以！虽然，我这次出来没带太多零花钱，不过有总比没有好嘛！"
        },
        {
          "role": "泽维尔",
          "text": "您这些好先生，好女士们！哎呀！我…我…"
        },
        {
          "role": "千织",
          "text": "够了够了。省下两位主演的片酬，再加上泽维尔的储蓄和我的赞助，我猜已经差不多了。"
        },
        {
          "role": "千织",
          "text": "你们与其出钱，不如出力吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯？怎么出力呀？我…我们拍映影也不专业…"
        },
        {
          "role": "千织",
          "text": "泽维尔，擦擦眼泪，告诉大家你团队里还缺什么人。"
        },
        {
          "role": "泽维尔",
          "text": "…啊，好…好的。我想想，现在还缺少一位摄影师、一位场记、一位后勤…"
        },
        {
          "role": "泽维尔",
          "text": "原本我想自己担任导演，但光是「制片人」的身份就已经让我忙得不可开交，所以…导演和导演助理两个职位也还缺席…"
        },
        {
          "role": "派蒙",
          "text": "摄影师和后勤我知道，但「场记」是干什么的呀？"
        },
        {
          "role": "泽维尔",
          "text": "「场记」负责在摄影师拍摄的时候，利用打板器记录并整理每一段镜头的信息。是个需要耐心与细心的体力活。"
        },
        {
          "role": "派蒙",
          "text": "打板器！难道就是拍摄的时候，可以拿在手上「咔哒」一下的那个东西吗？"
        },
        {
          "role": "千织",
          "text": "就是那个。你有兴趣吗？"
        },
        {
          "role": "派蒙",
          "text": "有！我一直都想试试看呢！"
        },
        {
          "role": "千织",
          "text": "那「场记」就交给你来当。后勤工作我让店里的人过来搭把手，怎么样？泽维尔。"
        },
        {
          "role": "泽维尔",
          "text": "好，我没意见。至于「摄影师」的职位，我想交给旅行者来负责。"
        },
        {
          "role": "派蒙",
          "text": "哦！他很会摄影的！这一路走来，我们的留影机都不知道拍过多少东西了呢！"
        },
        {
          "role": "泽维尔",
          "text": "嗯，这也是我的想法。以前合作的时候，就发现旅行者对摄影构图很有研究。"
        },
        {
          "role": "神里绫华",
          "text": "想必是因为旅行者行遍诸国、博览众多吧。看得多了，自然就知道镜头中应该收录什么。"
        },
        {
          "role": "泽维尔",
          "text": "怎么样？你有兴趣接下这个职务吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只要能帮到忙。",
              "dialogues": []
            },
            {
              "text": "在所不辞。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "泽维尔",
          "text": "谢谢您，真是太贴心了，来！我要给您个拥抱，亲爱的好朋友！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你先去做正事！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那接下来就剩「导演」和「导演助理」了…"
        },
        {
          "role": "宵宫",
          "text": "我我我！我先把「导演助理」给认领了！总之就是帮导演的忙对吧？这我能干！"
        },
        {
          "role": "泽维尔",
          "text": "最后的「导演」…哎，最近枫丹知名的导演几乎都和我一样在筹备自己的映影…想不到谁能有空闲…"
        },
        {
          "role": "派蒙",
          "text": "咦？我记得芙宁娜之前作为演出顾问帮过剧团的忙，她应该很适合当导演吧？而且还赋闲在家…"
        },
        {
          "role": "泽维尔",
          "text": "芙…芙宁娜？"
        },
        {
          "role": "泽维尔",
          "text": "…这，这位女士，真愿意屈尊来此吗？"
        },
        {
          "role": "神里绫华",
          "text": "…是那位枫丹水神的名字吗？我听哥哥说了发生在枫丹的事。"
        },
        {
          "role": "派蒙",
          "text": "没错，就是她。她不久前帮助了一个剧团，现在顺势做起导演的工作啦。"
        },
        {
          "role": "泽维尔",
          "text": "这…"
        },
        {
          "role": "千织",
          "text": "我看过那场音乐剧，她的表演很完美，剧本编排也很出色。"
        },
        {
          "role": "千织",
          "text": "别被对方曾经的身份吓到，这是我们能想到的最佳人选，不去试试怎么知道。"
        },
        {
          "role": "泽维尔",
          "text": "好吧…千织小姐你说的对。为了我的映影…为了我的映影！"
        },
        {
          "role": "泽维尔",
          "text": "呼…那就有劳旅行者先生/小姐和派蒙带我去芙宁娜大人的府上一趟，希望…她能同意吧。"
        },
        {
          "role": "神里绫人",
          "text": "需要我们与你同行吗？"
        },
        {
          "role": "泽维尔",
          "text": "这件事就不劳烦您了。诸位刚到枫丹，应该有许多想逛的地方吧。"
        },
        {
          "role": "泽维尔",
          "text": "这件事就交给我吧，这也是…身为「制片人」的职责。"
        },
        {
          "role": "神里绫人",
          "text": "好，那我们静候佳音。"
        },
        {
          "role": "千织",
          "text": "我和你一起去。最好带上些礼物。"
        },
        {
          "role": "派蒙",
          "text": "我们也去！我们和芙宁娜比较熟，而且，也算是我们提出的建议嘛。"
        },
        {
          "role": "泽维尔",
          "text": "好，那我现在就去准备一下。礼物的话…"
        },
        {
          "role": "神里绫华",
          "text": "曾经人们眼中的水神大人…会喜欢什么样的礼物呢…"
        },
        {
          "role": "泽维尔",
          "text": "芙宁娜大人曾经很喜欢一个钟表戒指，这次是不是也该准备一些精巧的发条机械…"
        },
        {
          "role": "宵宫",
          "text": "咦？准备点心不行吗？比如「千灵慕斯」什么的。"
        },
        {
          "role": "派蒙",
          "text": "欸？会不会太便宜了点…虽然她的确喜欢甜点…"
        },
        {
          "role": "宵宫",
          "text": "最近不是千灵节吗？我听巡轨船上的导游爱贝尔说，是芙宁娜下令把习俗改为讨要点心的。"
        },
        {
          "role": "宵宫",
          "text": "我想，她一定也是喜欢甜点才这么做的。"
        },
        {
          "role": "千织",
          "text": "我赞成宵宫的想法。礼物过重反倒会让对方不自在。"
        },
        {
          "role": "派蒙",
          "text": "好，那就去买一份「千灵慕斯」吧！"
        },
        {
          "role": "泽维尔",
          "text": "这真的够吗？毕竟是去拜托这么重要的事。"
        },
        {
          "role": "千织",
          "text": "的确不够。「千灵慕斯」还不够甜。"
        },
        {
          "role": "派蒙",
          "text": "欸？还要比这更甜？"
        },
        {
          "role": "千织",
          "text": "嗯，得配上一个比任何点心都甜的礼物。"
        },
        {
          "role": "派蒙",
          "text": "那是什么呀？"
        },
        {
          "role": "千织",
          "text": "你们的赞美。"
        },
        {
          "type": "subtitle",
          "text": "获得食谱{{图标|千灵慕斯}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "额外对话（神里绫华&宵宫）"
        },
        {
          "role": "神里绫华",
          "text": "各位放心去吧，不用担心我们。"
        },
        {
          "role": "宵宫",
          "text": "希望芙宁娜喜欢我们准备的礼物，啊！要是觉得不够的话随时来找我，我可以做些烟花送给她！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（神里绫人）"
        },
        {
          "role": "神里绫人",
          "text": "静候你们的好消息。"
        },
        {
          "type": "subtitle",
          "text": "前往芙宁娜的公寓"
        },
        {
          "role": "派蒙",
          "text": "我们到了，芙宁娜就住在这里。"
        },
        {
          "role": "泽维尔",
          "text": "好，我去敲门。"
        },
        {
          "role": "泽维尔",
          "text": "……"
        },
        {
          "role": "芙宁娜",
          "text": "啊——来了来了，这大中午的…"
        },
        {
          "role": "芙宁娜",
          "text": "呃…你是哪位？"
        },
        {
          "role": "泽维尔",
          "text": "芙宁娜大人，请容我自我介绍一下。我叫泽维尔，是一位映影导演。"
        },
        {
          "role": "芙宁娜",
          "text": "你好。咦？后面不是旅行者和派蒙吗？还有…"
        },
        {
          "role": "千织",
          "text": "我叫千织。"
        },
        {
          "role": "芙宁娜",
          "text": "哦！就是「千织屋」的那位吧！你好你好。"
        },
        {
          "role": "芙宁娜",
          "text": "所以…你们这么多人找我，是有什么事吗？"
        },
        {
          "role": "派蒙",
          "text": "芙宁娜你难道是刚起吗？这都中午了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "咳咳，派蒙…",
              "dialogues": []
            },
            {
              "text": "甜一点…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸？啊，我，我是说…这中午的天气真好，太阳暖呼呼的，像芙宁娜一样让人温暖。你睡到这个时候，真是个聪明的决定！"
        },
        {
          "role": "芙宁娜",
          "text": "啊？我只是昨天熬夜看了些小说而已，和天气…没什么关系？"
        },
        {
          "role": "泽维尔",
          "text": "哦，这是我们为芙宁娜大人准备的一点小礼物，还请您笑纳。"
        },
        {
          "role": "芙宁娜",
          "text": "不必那么正式啦，我现在就是一个普通人。哇，这不是「千灵慕斯」吗？是我喜欢的甜点。"
        },
        {
          "role": "泽维尔",
          "text": "那就太好了。其实，我们此行是有件事想拜托您…"
        },
        {
          "role": "泽维尔",
          "text": "鉴于您对演戏卓越的追求与理解，我想请您担任我们剧组的「导演」一职。"
        },
        {
          "role": "芙宁娜",
          "text": "嗯？可你不是说，你自己就是位导演吗？"
        },
        {
          "role": "泽维尔",
          "text": "在这部作品上，我主要担任「制片人」这一职责。而且，我对演艺的了解，肯定还比不上芙宁娜大人您。"
        },
        {
          "role": "芙宁娜",
          "text": "旅行者和派蒙也在这个映影团队里吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯，没错！我是场记，他是摄影师。"
        },
        {
          "role": "芙宁娜",
          "text": "摄影师？这可是份技术含量很高的工作啊，它影响了影片的最终质量。你真的可以吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我有经验。",
              "dialogues": []
            },
            {
              "text": "要不要试试看？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芙宁娜",
          "text": "啊，我不是怀疑你的意思啦。只是，之前没怎么见你用过留影机。"
        },
        {
          "role": "派蒙",
          "text": "不如就让芙宁娜出道考题吧！"
        },
        {
          "role": "派蒙",
          "text": "如果旅行者的拍摄让芙宁娜满意的话，你就放心加入我们团队怎么样？"
        },
        {
          "role": "芙宁娜",
          "text": "呃…你这个顺水推舟的本事倒是长进了。不过，我的确想看看你的摄影水平。"
        },
        {
          "role": "芙宁娜",
          "text": "嗯…这样吧，我们就地取材。我来给出一些拍摄要求，看看你能不能满足。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "听从芙宁娜导演安排。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芙宁娜",
          "text": "嗯，实际拍摄中摄影师能否参透导演的意图是很重要的，我要看看你的成果再决定。"
        },
        {
          "role": "芙宁娜",
          "text": "准备好了吗？我要求可是很严格的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "芙宁娜",
                  "text": "拿好留影机，我要出题了。"
                }
              ]
            },
            {
              "text": "稍等一下。",
              "dialogues": [
                {
                  "role": "芙宁娜",
                  "text": "嗯，复习一下构图要领，准备好再来吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "完成芙宁娜导演的题目"
        },
        {
          "type": "subtitle",
          "text": "芙宁娜导演的摄影题"
        },
        {
          "type": "subtitle",
          "text": "「博蒙特工坊」的老板伊丝黛莱小姐，一直都为自己的锻造机械感到自豪，它不仅能精准地控制力度与温度，而且对铁匠来说毫不费力。我们为她的工坊拍一段宣传片吧！记得要凸显出锻造机械的优越性哦。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与芙宁娜对话"
        },
        {
          "type": "subtitle",
          "text": "拍摄正确"
        },
        {
          "role": "芙宁娜",
          "text": "…欸？看不出，你们还真有两下子。"
        },
        {
          "role": "芙宁娜",
          "text": "拍摄所选的角度很有构图感，台词的安排也合理地展现了人物的所思所想…"
        },
        {
          "type": "subtitle",
          "text": "拍摄错误"
        },
        {
          "role": "芙宁娜",
          "text": "容我直言。你们…是认真想搞映影吗？"
        },
        {
          "role": "芙宁娜",
          "text": "拍摄角度没有重点，人物也没入镜，就连台词的意图都歪到埃尔顿海沟里去了。"
        },
        {
          "role": "芙宁娜",
          "text": "除非你们是在追求某种新兴的艺术，不然…还真得找一位靠谱的导演了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那么结论是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "芙宁娜这是答应帮我们了吗？"
        },
        {
          "role": "芙宁娜",
          "text": "哪会有这么容易？经过上回「水的女儿」那一出音乐剧，我的名号又响了起来。"
        },
        {
          "role": "芙宁娜",
          "text": "不瞒你们说，这次千灵映影节，已经有好几个剧团来找过我了。只不过那些剧本都有些无聊，我提不起兴致。"
        },
        {
          "role": "芙宁娜",
          "text": "要是被其他人知道，我这么轻易就答应了你们…"
        },
        {
          "role": "派蒙",
          "text": "我还以为刚才都说好了！芙宁娜还有什么不满意的吗？"
        },
        {
          "role": "芙宁娜",
          "text": "那个…片…片酬是多少？"
        },
        {
          "role": "派蒙",
          "text": "啊？"
        },
        {
          "role": "芙宁娜",
          "text": "就是你们要给多少钱请我来当导演啦！片酬也是很重要的衡量标准嘛！"
        },
        {
          "role": "泽维尔",
          "text": "这个…呃，我能给您…这个数…"
        },
        {
          "role": "芙宁娜",
          "text": "…什么？就这点？这…这要是报到那维莱特那里，都可以指控你「低价雇佣劳动力」了！"
        },
        {
          "role": "泽维尔",
          "text": "抱歉，但以我们团队现在的情况来看…"
        },
        {
          "role": "芙宁娜",
          "text": "好吧，虽然现在不太可能加入你们了，但我还是姑且问一句，就当满足我的好奇心…你们打算拍什么？"
        },
        {
          "role": "泽维尔",
          "text": "呃…是根据小说改编的剧本——《两个铳枪手》。"
        },
        {
          "role": "芙宁娜",
          "text": "…欸？等等，是那本登上过销量榜第一的悬疑小说？"
        },
        {
          "role": "派蒙",
          "text": "原来芙宁娜也读过呀。"
        },
        {
          "role": "芙宁娜",
          "text": "当然读过！我对民众热爱的艺术作品还是很上心的。"
        },
        {
          "role": "芙宁娜",
          "text": "哦，我懂了，你一定是把映影的预算都拿去买版权了对吧？"
        },
        {
          "role": "泽维尔",
          "text": "这…倒也不是，小说作者听说我要翻拍这个故事，几乎是用白送的价格就把这本书的版权转让给了我。资金短缺，是别的原因…"
        },
        {
          "role": "千织",
          "text": "大概是想出名吧，钱对那位来说不重要。"
        },
        {
          "role": "千织",
          "text": "就像有个[[绮良良|跨国快递员]]愿意穿着我做的衣服满世界跑，我也不会收她太多钱。宣传作用早就覆盖成本了。"
        },
        {
          "role": "芙宁娜",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "芙宁娜很喜欢这个故事吗？"
        },
        {
          "role": "芙宁娜",
          "text": "也…也就一般吧！故事节奏可圈可点，但人物关系有待改进，以前读的时候，总觉得有些遗憾。我的标准可是很严格的！"
        },
        {
          "role": "芙宁娜",
          "text": "…咳咳，泽维尔先生，如果，我是说如果！如果我来当导演的话，剧本和表现上的修改，能给我多大的自由度？"
        },
        {
          "role": "泽维尔",
          "text": "那当然是最大的自由度！我怎么可能怀疑枫丹人人皆知的大明星，芙宁娜大人的审美呢？"
        },
        {
          "role": "芙宁娜",
          "text": "那就是，我按照自己的喜好来改编故事也没问题喽？"
        },
        {
          "role": "泽维尔",
          "text": "当然没问题！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "拜托芙宁娜大导演了。",
              "dialogues": []
            },
            {
              "text": "拍一个你喜欢的故事吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芙宁娜",
          "text": "唔，好吧。看来说到底，你们还是不能缺少了我的眷顾嘛！"
        },
        {
          "role": "泽维尔",
          "text": "那您这是，同意了？"
        },
        {
          "role": "芙宁娜",
          "text": "嗯，我加入。虽然片酬有些配不上我的身价，但最好的剧本就应该配上最好的导演！"
        },
        {
          "role": "芙宁娜",
          "text": "我可不能让一个好故事因为缺钱就给毁了。就像不能看着上好的面包和奶酪，因为缺少烤箱而放在一旁发霉一样。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你，芙宁娜。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "泽维尔",
          "text": "…水神大人在上，我没在做梦吧？"
        },
        {
          "role": "芙宁娜",
          "text": "水神大人哪都不在，你们还是先别高兴得太早了。"
        },
        {
          "role": "芙宁娜",
          "text": "映影的准备工作可是很漫长的，虽说最困难的剧本和选角已经定下来了，但之后还有场地预约、灯光道具…"
        },
        {
          "role": "芙宁娜",
          "text": "哦对了，既然我们拍的是《两个铳枪手》，那还得找一位动作指导。最好是真正用过铳枪的专业人士。"
        },
        {
          "role": "泽维尔",
          "text": "这方面的问题我也考虑过，原本想的是，不知道芙宁娜大人这边有没有能拜托的关系…"
        },
        {
          "role": "芙宁娜",
          "text": "我吗？嗯…换作以前，倒是可以拜托克洛琳德，但我已经好久都没联系她了。"
        },
        {
          "role": "芙宁娜",
          "text": "娜维娅倒也用枪，但她用枪的风格和小说中的人物有很大差别…"
        },
        {
          "role": "千织",
          "text": "不去拜托一下特巡队吗？"
        },
        {
          "role": "芙宁娜",
          "text": "哦，是说那支隶属于特巡队的铳枪小队吗？"
        },
        {
          "role": "千织",
          "text": "没错，他们每天都与铳枪打交道，从专业性上来说当为首选。"
        },
        {
          "role": "芙宁娜",
          "text": "那都是那维莱特的管辖范畴，我…我和他们不熟啦！"
        },
        {
          "role": "芙宁娜",
          "text": "唔…难道说，最后还是得去拜托那维莱特？"
        },
        {
          "role": "千织",
          "text": "不用那么麻烦，我认识他们的队长——夏沃蕾。"
        },
        {
          "role": "派蒙",
          "text": "咦？千织怎么会认识铳枪队队长的？"
        },
        {
          "role": "千织",
          "text": "没什么特别的理由。我做生意总会碰到些破事，她帮我摆平过几次。"
        },
        {
          "role": "千织",
          "text": "反过来，我也帮她处理过一些特巡队不能出面的事。一来二去就熟络了。"
        },
        {
          "role": "派蒙",
          "text": "呃…有什么特巡队不能出面的事是需要服装设计师来解决的？我对千织的工作真是越来越搞不懂了…"
        },
        {
          "role": "千织",
          "text": "那最好还是别懂。不说这些了，请这位来做铳枪指导你们觉得怎么样？"
        },
        {
          "role": "芙宁娜",
          "text": "能请到专业人士我当然没意见，更何况还是队长级别的。"
        },
        {
          "role": "泽维尔",
          "text": "不过，特巡队的工作应该很忙吧，她真的有时间来参加映影的拍摄吗？而且薪酬方面…"
        },
        {
          "role": "千织",
          "text": "很巧，她也不是那种看重钱的人。至于时间，还是得去问问本人才能知道。"
        },
        {
          "role": "芙宁娜",
          "text": "那我就不和你们一起去了，今天可是通心粉打折的大日子。晚些时候把结果连同明天的安排一起告诉我就行。"
        },
        {
          "role": "泽维尔",
          "text": "没问题。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，感觉有了芙宁娜的加入，这部映影的阵容一下子变得厉害起来了呢。"
        },
        {
          "role": "芙宁娜",
          "text": "那是自然，等到首映日那天，你们就尽管为「芙宁娜」这名字在枫丹的号召力而庆幸吧。我保证剧场里到时候连站票都会售罄的。"
        },
        {
          "role": "芙宁娜",
          "text": "我也会顺带找认识的人问问，看看他们愿不愿意来当群众演员。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，芙宁娜总算不会被大家的评价所困扰了呀！"
        },
        {
          "role": "芙宁娜",
          "text": "不需要你做多余的说明。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "期待着首映日。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "千织",
          "text": "那就出发吧，我恰好知道夏沃蕾今天在哪。"
        },
        {
          "role": "芙宁娜",
          "text": "对了，我就是随便问一下，你给我的片酬都那么少，那两位主演怎么办？他们不是大老远从稻妻赶来的吗？"
        },
        {
          "role": "泽维尔",
          "text": "其实…他们说这是为了和枫丹进行文化交流，所以…也没要什么片酬。"
        },
        {
          "role": "芙宁娜",
          "text": "什么？合着全世界不要钱的人都来拍这部映影了？难道千织小姐也…"
        },
        {
          "role": "千织",
          "text": "我们有些交情，他也同意把我的品牌名打在最显眼的地方。"
        },
        {
          "role": "芙宁娜",
          "text": "…虽然我不是指我自己，但泽维尔先生，你还真是受神明眷顾的人啊。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（芙宁娜）"
        },
        {
          "role": "芙宁娜",
          "text": "除了通心粉之外，再买些番茄酱好了…"
        },
        {
          "type": "subtitle",
          "text": "寻找特巡队队长夏沃蕾"
        },
        {
          "role": "千织",
          "text": "就是这里了。"
        },
        {
          "role": "派蒙",
          "text": "嗯？周围没人呀，那位铳枪队队长在哪里？"
        },
        {
          "role": "千织",
          "text": "那边那位戴着眼罩，在报刊亭前看书的就是。"
        },
        {
          "role": "派蒙",
          "text": "哦！就是她呀，我说怎么气质和周围人都不一样，给人一种十分威严的感觉呢！"
        },
        {
          "role": "千织",
          "text": "你们在这里等一下，我去叫她过来。现在是她的工作时间，直接过去会添麻烦。"
        },
        {
          "role": "派蒙",
          "text": "工作时间？可她不就是站在那边看小说吗？"
        },
        {
          "role": "千织",
          "text": "听我的就是了。"
        },
        {
          "role": "派蒙",
          "text": "啊…她走掉了…"
        },
        {
          "role": "派蒙",
          "text": "总觉得千织给人的感觉好神秘啊，一边说自己只是个做衣服的，一边却认识那么多厉害的人。"
        },
        {
          "role": "泽维尔",
          "text": "枫丹廷对于外国来客的眼光并不算十分宽容，想要在此推广自己的品牌不是件容易的事，更别说是竞争激烈的时尚界了。"
        },
        {
          "role": "泽维尔",
          "text": "连我这本地人拍个映影都困难重重，难以想象千织小姐是如何才走到今天这一步的。多认识些人肯定不是坏处。"
        },
        {
          "role": "千织",
          "text": "工作时间看书？"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯，侦探小说。"
        },
        {
          "role": "千织",
          "text": "独角戏？"
        },
        {
          "role": "夏沃蕾",
          "text": "不，多主角，多分支。"
        },
        {
          "role": "千织",
          "text": "剧情到哪一步了？"
        },
        {
          "role": "夏沃蕾",
          "text": "其中一位主角正要做出决定他下半辈子命运的抉择，我打赌他选不对。"
        },
        {
          "role": "千织",
          "text": "能快点吗？有事想拜托你。"
        },
        {
          "role": "夏沃蕾",
          "text": "这不取决于我，你知道的。取决于那位主角选什么。"
        },
        {
          "role": "千织",
          "text": "所以我这不是来帮你了吗。"
        },
        {
          "role": "夏沃蕾",
          "text": "……"
        },
        {
          "role": "夏沃蕾",
          "text": "好吧，看来他终究还是选错了。"
        },
        {
          "role": "夏沃蕾",
          "text": "站住！"
        },
        {
          "role": "书摊老板",
          "text": "…！干，干什么？"
        },
        {
          "role": "夏沃蕾",
          "text": "把手里的东西交出来。"
        },
        {
          "role": "买书的顾客",
          "text": "就是一本书啊，我没买什么其他东西。"
        },
        {
          "role": "夏沃蕾",
          "text": "那你一定不介意给我看一下吧。"
        },
        {
          "role": "书摊老板",
          "text": "警官大人，您在这儿一天光看不买我没什么意见，但还请别吓到了我的顾客，让人不好做生意呀。"
        },
        {
          "role": "夏沃蕾",
          "text": "别给我在这装，你也一样逃不掉。"
        },
        {
          "role": "夏沃蕾",
          "text": "我再说一遍，我是枫丹特巡队队长夏沃蕾。老老实实把你手里的东西交出来。"
        },
        {
          "role": "夏沃蕾",
          "text": "在你做出任何不理性的举动前我提醒一句，我制服你的速度一定比你的念头动得更快。"
        },
        {
          "role": "买书的顾客",
          "text": "呜！我给，我交出来就是了！"
        },
        {
          "role": "买书的顾客",
          "text": "但…但我说在前面！如果书里夹着什么违禁品的话，那一定是老板擅自塞给我的，和我没关系啊！"
        },
        {
          "role": "书摊老板",
          "text": "你！这个落井下石的家伙！明明是你说要…"
        },
        {
          "role": "夏沃蕾",
          "text": "有话去审讯室里吵去！"
        },
        {
          "role": "夏沃蕾",
          "text": "勒泰利埃，把他们带走。"
        },
        {
          "role": "派蒙",
          "text": "这是怎么回事？怎么刚才还在看书，现在就有人被抓走了？"
        },
        {
          "role": "夏沃蕾",
          "text": "这几位…咦？不就是之前经常在报纸上看到的旅行者吗？千织你说的事就和他们有关？"
        },
        {
          "role": "夏沃蕾",
          "text": "行，那和你们说说也无妨。"
        },
        {
          "role": "夏沃蕾",
          "text": "瓦谢事件过后，「乐斯」的源头已经被掐断。但枫丹警备队一直在回收之前流落到市场上的残余份额。"
        },
        {
          "role": "夏沃蕾",
          "text": "多亏了可靠的消息来源，刚才那就是最后一批了。"
        },
        {
          "role": "派蒙",
          "text": "原来夏沃蕾是为了抓捕犯人才在那边看书的呀…"
        },
        {
          "role": "派蒙",
          "text": "哦对了，还没正式介绍过呢。我叫派蒙，这位是旅行者，这位是泽维尔。"
        },
        {
          "role": "夏沃蕾",
          "text": "你们好，我是夏沃蕾。身份想必不用再介绍一遍了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么不直接抓捕他们？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "千织",
          "text": "是怕我给的情报不准吗？一定要抓现行。"
        },
        {
          "role": "夏沃蕾",
          "text": "不，我是想看看店主会不会自首。"
        },
        {
          "role": "夏沃蕾",
          "text": "他大可以走上那么几步到我身前，说那些「乐斯」是自己不知从哪里捡到的。如果他这么做的话，我就不会追究。"
        },
        {
          "role": "千织",
          "text": "但他整整一天都没那么做，反倒是我帮他挡住了你的视线之后，他就马上抓住机会卖了出去。"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯，他选错了路。但明明正确的路离他只有三步之遥。"
        },
        {
          "role": "千织",
          "text": "你知道他们不可能选对。"
        },
        {
          "role": "夏沃蕾",
          "text": "我知道，我只是希望自己错一次。"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "夏沃蕾",
          "text": "好了，不谈这些。你们找我有什么事？"
        },
        {
          "role": "派蒙",
          "text": "哦，是这样…"
        },
        {
          "type": "subtitle",
          "text": "向夏沃蕾讲述了拍摄映影的打算…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "夏沃蕾",
          "text": "《两个铳枪手》…你们选故事挺有眼光。"
        },
        {
          "role": "夏沃蕾",
          "text": "需要我做什么？作为演员的动作指导就行了吗？"
        },
        {
          "role": "泽维尔",
          "text": "没错，既然要拍，我就想拍得专业一些，尽量让演员握枪的姿势和对枪械的了解都接近真实的铳枪手。"
        },
        {
          "role": "泽维尔",
          "text": "不过，这工作可能会占用您比较多的时间…毕竟拍摄需要全程陪同，还有就是，给您的片酬…"
        },
        {
          "role": "夏沃蕾",
          "text": "不用说了，我加入。"
        },
        {
          "role": "派蒙",
          "text": "欸？答应得好干脆！"
        },
        {
          "role": "泽维尔",
          "text": "真…真的吗？您真的愿意来指导这么一个小成本映影？"
        },
        {
          "role": "夏沃蕾",
          "text": "这没什么，像我说的，搜查工作告一段落，暂时没有其他要紧事了。"
        },
        {
          "role": "夏沃蕾",
          "text": "而且我喜欢这本小说，家里放着精装本。正义战胜邪恶的故事，看几遍都不嫌腻。"
        },
        {
          "role": "千织",
          "text": "那就这么说定了？"
        },
        {
          "role": "夏沃蕾",
          "text": "说定了，我们明天拍摄现场见。"
        },
        {
          "role": "泽维尔",
          "text": "我的天，这也太顺利了吧！我…我得赶快去通知芙宁娜大人，还有道具师和灯光师，让他们准备好器材，明天就开拍！"
        },
        {
          "role": "千织",
          "text": "冷静点，泽维尔。映影不是一天能拍完的。"
        },
        {
          "role": "千织",
          "text": "不过，我也得回去为演员准备衣装和化妆用品了。"
        },
        {
          "role": "派蒙",
          "text": "好，那我们今天就在这里告别吧。"
        },
        {
          "role": "夏沃蕾",
          "text": "旅行者，派蒙，你们留下。有事和你们说。"
        },
        {
          "role": "千织",
          "text": "那我先送泽维尔回去，他已经激动得不走直线了，我不想开拍第一天的活动是去喷泉里找制片人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "明天见。",
              "dialogues": [
                {
                  "role": "千织",
                  "text": "嗯，明天见。"
                }
              ]
            },
            {
              "text": "泽维尔应该能保持清醒。",
              "dialogues": [
                {
                  "role": "千织",
                  "text": "他最好能。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与夏沃蕾对话"
        },
        {
          "role": "派蒙",
          "text": "所以，夏沃蕾想和我们说什么？"
        },
        {
          "role": "夏沃蕾",
          "text": "你们看过《两个铳枪手》吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "知道个大概。",
              "dialogues": []
            },
            {
              "text": "还没看过。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "小说讲的是一对伯爵家的子女相依为命，为母亲复仇的故事。"
        },
        {
          "role": "夏沃蕾",
          "text": "他们小的时候生活在伯爵家中，母亲是宅子里的女仆，二人是伯爵和女仆的私生子，所以从小就不受其他人待见。"
        },
        {
          "role": "夏沃蕾",
          "text": "有一天他们回到家中，发现自己的母亲倒在房间里，被杀害了。很明显，凶手就是同一个屋檐下那些对他们恶语相向的伯爵家人。"
        },
        {
          "role": "夏沃蕾",
          "text": "但奈何伯爵的势力强大，足以压下声音，案件最终被认定为自杀，正义无处伸张。兄妹二人决定逃走，来日再报仇。"
        },
        {
          "role": "夏沃蕾",
          "text": "很多年后，伯爵的家人突然一个接一个被铳枪所杀。他们的尸体上，都有一朵盛开的虹彩蔷薇，是那位死去的母亲最喜欢的花。"
        },
        {
          "role": "夏沃蕾",
          "text": "伯爵以为是那位母亲的亡魂来报复了，天天都生活在恐惧之中。"
        },
        {
          "role": "夏沃蕾",
          "text": "但，其实是当初逃走的那对兄妹，相依为命，日夜训练，最终成为了两个铳枪手。"
        },
        {
          "role": "夏沃蕾",
          "text": "他们用自己的力量，收集线索与证据，执行计划，最终完成了对伯爵的复仇，让母亲死亡的真相被世人所知。"
        },
        {
          "role": "派蒙",
          "text": "是个大快人心的故事呢。"
        },
        {
          "role": "夏沃蕾",
          "text": "没错，邪恶终将受到报应，正义终将得到伸张。我喜欢它的主题。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，这也是夏沃蕾想要加入的原因吧？"
        },
        {
          "role": "夏沃蕾",
          "text": "只是其中一个方面。"
        },
        {
          "role": "派蒙",
          "text": "咦？还有其他原因？"
        },
        {
          "role": "夏沃蕾",
          "text": "我读过关于你们的报道，无论是参与案件的审判，还是协助应对枫丹的危机…"
        },
        {
          "role": "夏沃蕾",
          "text": "不难看出，你们富有正义心，推理的实力也不容小觑。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道说…",
              "dialogues": []
            },
            {
              "text": "有什么案件要拜托我们？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "你很敏锐，看来没少经历过类似的情况。"
        },
        {
          "role": "夏沃蕾",
          "text": "最近发生了一起铳枪杀人案。凶手的作案手法和小说里的情节很相似。"
        },
        {
          "role": "派蒙",
          "text": "咦？真的吗！今天的报纸上可没写这个呀。"
        },
        {
          "role": "夏沃蕾",
          "text": "逐影庭暂时没有公开案件信息，因为调查没有进展，凶手很谨慎。"
        },
        {
          "role": "派蒙",
          "text": "铳枪杀人…我记得枫丹用铳枪的人很少啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "会不会是「铳枪队」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "不可能。铳枪队每天都会检查枪械的状态和弹药存量，开没开过枪一目了然。况且他们都是我信得过的人。"
        },
        {
          "role": "夏沃蕾",
          "text": "不过…案件的信息今天只能告诉你们这些。"
        },
        {
          "role": "派蒙",
          "text": "咦？什么意思？"
        },
        {
          "role": "夏沃蕾",
          "text": "我希望你们回去睡个好觉，明天再决定要不要和我一起调查。"
        },
        {
          "role": "夏沃蕾",
          "text": "我知道这是在为你们添麻烦，只是我希望正义的帮手越多越好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "特巡队没人调查吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "这不是特巡队的职责。我们的工作是捉拿凶手，找他们是逐影庭的工作。调查…算是我的一个私心。"
        },
        {
          "role": "夏沃蕾",
          "text": "我不希望「铳枪」被染上污名，另外…我也很在意作案手法和小说相似的这一点。"
        },
        {
          "role": "派蒙",
          "text": "是觉得这背后存在联系？"
        },
        {
          "role": "夏沃蕾",
          "text": "我的确是这么想的。"
        },
        {
          "role": "夏沃蕾",
          "text": "再重复一遍。这不是命令，不是交易，只是一个请求。"
        },
        {
          "role": "夏沃蕾",
          "text": "如果二位经过明天的拍摄，对案件感兴趣，愿意帮我调查的话，我将十分感激。"
        },
        {
          "role": "派蒙",
          "text": "唔…旅行者你觉得呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "今天发生的太多…",
              "dialogues": []
            },
            {
              "text": "还是明天再想吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧，你说得对，我也有些累了。从早上开始就没歇过呢。"
        },
        {
          "role": "夏沃蕾",
          "text": "今天就先回去休息吧。保持冷静的头脑是很重要的，尤其是在做重要决定的时候。"
        },
        {
          "role": "夏沃蕾",
          "text": "不然到了关键时刻，你可能连那条三步之外的路都看不到。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（泽维尔&千织）"
        },
        {
          "role": "泽维尔",
          "text": "噢，多么好心的人啊，多么幸运的我啊！"
        },
        {
          "role": "千织",
          "text": "…你慢点走。"
        },
        {
          "role": "泽维尔",
          "text": "这就是苦尽甘来，这就是柳暗花明！"
        },
        {
          "role": "泽维尔",
          "text": "噢，我看到了，我的前方是希望！"
        },
        {
          "role": "千织",
          "text": "…你的前方是喷泉，我希望你至少看清这点。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（神里绫人&那维莱特）"
        },
        {
          "role": "神里绫人",
          "text": "…对于以上种种，我所提出的初步想法和合作方向，不知那维莱特先生意下如何？"
        },
        {
          "role": "那维莱特",
          "text": "非常周全的考虑。从神里先生的话语中足以见您良苦用心。不必谦虚。"
        },
        {
          "role": "神里绫人",
          "text": "感谢您的认可。那么，结论是？"
        },
        {
          "role": "那维莱特",
          "text": "如果您问的是我个人…出于我自身的倾向，以及我对稻妻文化的印象，我愿意予以充分合作。"
        },
        {
          "role": "那维莱特",
          "text": "但枫丹的运行并不依托于任何一人的私情，我想稻妻也是如此。凡事皆应符合规章。"
        },
        {
          "role": "神里绫人",
          "text": "自然如此。"
        },
        {
          "role": "神里绫人",
          "text": "我会将具体的合作事宜以书面形式交由沫芒宫，一周之内。"
        },
        {
          "role": "那维莱特",
          "text": "期待着您的消息。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（神里绫华&宵宫）"
        },
        {
          "role": "神里绫华",
          "text": "宵宫尝尝晶螺糕吧。"
        },
        {
          "role": "宵宫",
          "text": "这是绫华点的，绫华先吃。"
        },
        {
          "role": "神里绫华",
          "text": "我是为了宵宫才要的。宵宫很喜欢甜点吧？"
        },
        {
          "role": "宵宫",
          "text": "嘿嘿…既然这样，我们也不要再谦让了！一起吃吧，好不好？"
        },
        {
          "role": "神里绫华",
          "text": "呵呵…好呀。"
        },
        {
          "role": "宵宫",
          "text": "……"
        },
        {
          "role": "神里绫华",
          "text": "……"
        },
        {
          "role": "宵宫",
          "text": "太好吃了！"
        },
        {
          "role": "宵宫",
          "text": "好松软！入口的时候黄油的香气特别馥郁，回味也让人觉得很幸福…"
        },
        {
          "role": "神里绫华",
          "text": "太好了，宵宫很喜欢呢。"
        },
        {
          "role": "神里绫华",
          "text": "我也觉得很好吃，而且，我很喜欢它的花纹。"
        },
        {
          "role": "宵宫",
          "text": "听说是仿造「苍晶螺」的造型做的哦！我从来没有亲眼见过，很好奇它们长什么样子！"
        },
        {
          "role": "宵宫",
          "text": "绫华，你有没有兴趣？要不要找个时间，我们一起去水下找找看？"
        },
        {
          "role": "神里绫华",
          "text": "好啊，要不等下就去？"
        },
        {
          "role": "宵宫",
          "text": "嗯！我还有好多地方想和绫华一起逛的，那就说好了哦！"
        }
      ],
