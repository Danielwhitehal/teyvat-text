{
  "quest_id": 72210,
  "chapter_num": null,
  "chapter_title": "寝子是只猫·孩子们",
  "type": "wq",
  "route": "Neko Is a Cat: The Children",
  "stories": [
    {
      "story_id": 72210,
      "title": "寝子是只猫·孩子们",
      "description": "「浅濑神社代宫司」寝子似乎有事找你…",
      "dialogues": [
        {
          "role": "「寝子」",
          "text": "哎呀…喵喵，跑到哪里去了…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "「寝子」",
          "text": "是汝等啊。有些小家伙不知道跑到哪里玩了，真是令人担心哪。"
        },
        {
          "role": "「寝子」",
          "text": "外面可是很危险的。虽然奴家教过它们很多次了。外面又有拿棒子的毛茸茸人，又有…圆形的水和火的东西，可是相当危险哪。"
        },
        {
          "role": "「寝子」",
          "text": "如果跑到酥酥麻麻里面去，还会弄得全身的毛都竖起来。这种滋味，奴家可不希望小家伙们也体会到。"
        },
        {
          "role": "「寝子」",
          "text": "但总有几个不听话的小家伙到处乱跑，奴家每次都要费很大劲把它们找回来…"
        },
        {
          "role": "「寝子」",
          "text": "今天又有几个不知道跑到哪去了。好担心。"
        },
        {
          "role": "「寝子」",
          "text": "汝也帮奴家。找到「昆布丸」和「八宝」。"
        },
        {
          "role": "旅行者",
          "text": "「昆布丸」是…"
        },
        {
          "role": "「寝子」",
          "text": "是个好孩子。这一代昆布丸很聪明。"
        },
        {
          "role": "旅行者",
          "text": "「这一代」？"
        },
        {
          "role": "「寝子」",
          "text": "阿响有时候会说到的东西。奴家也不知道是什么，但看她说的时候的表情，那应该是好东西吧。"
        },
        {
          "role": "「寝子」",
          "text": "奴家会用好东西给小家伙取名字。等小家伙长大了、走了以后，奴家就会用这些名字，给更小更小的小家伙取名字。"
        },
        {
          "role": "「寝子」",
          "text": "「昆布丸」喜欢在高的地方睡觉。去好高好高的地方找。"
        },
        {
          "role": "旅行者",
          "text": "那，「八宝」是…"
        },
        {
          "role": "「寝子」",
          "text": "非常机灵的小家伙。很喜欢吃鱼。所以，有时候会在海边找被冲到岸上的鱼。"
        },
        {
          "role": "「寝子」",
          "text": "但是，很危险。水可是可怕的东西。好久好久以前，有个叫「吾辈」的小家伙就掉到水里去，差点就回不来了。"
        },
        {
          "role": "「寝子」",
          "text": "「八宝」应该在海边看，有没有小鱼和螃蟹。去有咸水的地方找。"
        },
        {
          "role": "旅行者",
          "text": "太宽泛了…"
        },
        {
          "role": "「寝子」",
          "text": "总之，就是，好高好高，还有咸水。"
        },
        {
          "role": "派蒙",
          "text": "总、总之，把地图拿出来让寝子看看…"
        },
        {
          "role": "「寝子」",
          "text": "汝啊，悟性不行哪。你看，这里就是好高好高。这里就是咸水。它们一定在这两个地方。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我们吧。",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "那就拜托汝等了，喵喵，这些孩子可真是的…"
                }
              ]
            },
            {
              "text": "我不擅长抓猫…",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "喵喵，没关系，那些孩子都不怕人的…不如说，正是因为没人陪它们玩，它们才会到处乱跑呢。"
                },
                {
                  "role": "「寝子」",
                  "text": "那就拜托汝等了，喵喵，这些孩子可真是的…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往海边，将小猫带回神社"
        },
        {
          "type": "subtitle",
          "text": "前往海边，将小猫带回神社"
        },
        {
          "role": "「八宝」",
          "text": "喵，喵喵？"
        },
        {
          "role": "派蒙",
          "text": "啊，它应该就是寝子说的「八宝」了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听话，过来吧…",
              "dialogues": [
                {
                  "role": "「八宝」",
                  "text": "喵喵。"
                }
              ]
            },
            {
              "text": "喵，喵…",
              "dialogues": [
                {
                  "role": "「八宝」",
                  "text": "喵…喵喵喵？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呜哇，好听话的小猫…"
        },
        {
          "type": "subtitle",
          "text": "前往高处，将小猫带回神社"
        },
        {
          "type": "subtitle",
          "text": "前往高处，将小猫带回神社"
        },
        {
          "role": "「昆布丸」",
          "text": "喵！喵喵，喵！"
        },
        {
          "role": "派蒙",
          "text": "呜啊！好、好凶的小猫，小心点…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "喵，喵…",
              "dialogues": [
                {
                  "role": "「昆布丸」",
                  "text": "喵喵？喵…"
                }
              ]
            },
            {
              "text": "我是带你回家的。",
              "dialogues": [
                {
                  "role": "「昆布丸」",
                  "text": "喵！喵…喵。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，虽然很凶，但还是乖乖让你抱着了呢。"
        },
        {
          "type": "subtitle",
          "text": "与寝子对话"
        },
        {
          "role": "「寝子」",
          "text": "汝等，找到那两个孩子了吗？"
        },
        {
          "role": "旅行者",
          "text": "还没有…"
        },
        {
          "role": "「寝子」",
          "text": "唔…这样吗？那汝等可要快点啊，不然，那两个孩子也许又会跑到更远的地方去了。"
        },
        {
          "type": "subtitle",
          "text": "与寝子对话"
        },
        {
          "role": "「寝子」",
          "text": "汝等找到他们了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了。"
        },
        {
          "role": "「寝子」",
          "text": "汝等，为什么总是不听奴家的话呢？为什么不能像「阿饭」那样听话呢？"
        },
        {
          "role": "旅行者",
          "text": "「阿饭」…"
        },
        {
          "role": "派蒙",
          "text": "确实是用好东西当名字呢…"
        },
        {
          "role": "「八宝」",
          "text": "喵，喵喵喵…喵…"
        },
        {
          "role": "「昆布丸」",
          "text": "喵！喵喵！"
        },
        {
          "role": "「寝子」",
          "text": "不许和奴家顶嘴！不然以后奴家可不去找汝等了，就给奴家从…从太阳还在天上，饿到月亮到天上，再饿到太阳跑到天上，然后再自己想办法回来吧！"
        },
        {
          "role": "「昆布丸」",
          "text": "喵…"
        },
        {
          "role": "「寝子」",
          "text": "呵呵，这才是好孩子，好了，回来就好。"
        },
        {
          "role": "「寝子」",
          "text": "多亏汝等了，要是没有汝等帮忙，这小家伙们又要在野外挨饿了。"
        },
        {
          "role": "旅行者",
          "text": "它们应该能自己回来…"
        },
        {
          "role": "「寝子」",
          "text": "总之，奴家很感谢。"
        },
        {
          "role": "「寝子」",
          "text": "有空的话，记得常来这边看看，奴家说不定还会有事要请汝等搭把手。"
        }
      ]
    }
  ]
}