  "chapter_title": "水族箱里的…演员？",
  "type": "wq",
  "route": "An Actor... In the Aquarium?",
  "stories": [
    {
      "story_id": 74707,
      "title": "水族箱里的…演员？",
      "description": "朋友们似乎在欣赏水族箱…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往水族箱附近…"
        },
        {
          "role": "芙宁娜",
          "text": "…好，没问题！再来一条——"
        },
        {
          "role": "芙宁娜",
          "text": "好。停——！"
        },
        {
          "role": "派蒙",
          "text": "芙宁娜！还有哥伦比娅和千织，又见面了！"
        },
        {
          "role": "芙宁娜",
          "text": "嗯，我们刚好拍完上次说的氛围镜头。"
        },
        {
          "role": "派蒙",
          "text": "哦！就是让鱼儿来当演员的那个吧，怎么样怎么样？"
        },
        {
          "role": "芙宁娜",
          "text": "多亏你们的帮助，我们找到了一位合适的「演员」。拍摄很顺利！"
        },
        {
          "role": "千织",
          "text": "你们布置水族箱也很有一套。芙宁娜导演刚才还说看得她想去拍部水下纪录片了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "多谢夸奖。",
              "dialogues": []
            },
            {
              "text": "你们喜欢就好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，我也很喜欢。我能感觉到鱼儿们游得很惬意，很满足，你们照料得很好。"
        },
        {
          "role": "芙宁娜",
          "text": "真希望这水族馆一直留在这里呢，这样就能时不时来看看这些鱼了。"
        },
        {
          "role": "千织",
          "text": "真舍不得的话，就多剪几个镜头到映影里呗。"
        },
        {
          "role": "芙宁娜",
          "text": "你说得对。那干脆再补几条吧！"
        },
        {
          "role": "哥伦比娅",
          "text": "补几条鱼？"
        },
        {
          "role": "芙宁娜",
          "text": "补镜头啦…灯光师，摄影师，还有场记就位！"
        },
        {
          "role": "派蒙",
          "text": "来啦！不过为鱼儿们打板还真是头一回呢…"
        }
      ]
    }
  ]
}