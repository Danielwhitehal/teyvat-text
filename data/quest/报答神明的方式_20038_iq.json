  "stories": [
    {
      "story_id": 20038,
      "title": "报答神明的方式",
      "description": "吉丽安娜小姐正在寻找一个人，替她去清扫久未打理过的七天神像…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与吉丽安娜对话"
        },
        {
          "role": "吉丽安娜",
          "text": "唉，不知道那些七天神像怎么样了…"
        },
        {
          "role": "旅行者",
          "text": "七天神像怎么了？"
        },
        {
          "role": "吉丽安娜",
          "text": "是这样的…我以往每周都会去七天神像前祈祷，顺便为神像扫除尘埃。"
        },
        {
          "role": "吉丽安娜",
          "text": "多亏了神明，我才有了现在的幸福生活，这么做，也是我报答神明的一种方式…"
        },
        {
          "role": "吉丽安娜",
          "text": "可是自从我有了莉莉以后，出行的机会越来越少了。"
        },
        {
          "role": "吉丽安娜",
          "text": "那些七天神像，肯定因为没人清洗而蒙尘了。"
        },
        {
          "role": "吉丽安娜",
          "text": "虽然这么说，有点像是推卸责任。但能不能请您替我去清除一下七天神像上的灰尘？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "吉丽安娜",
                  "text": "太感谢您了，愿风神保佑您。"
                }
              ]
            },
            {
              "text": "就让风把灰尘给吹干净…",
              "dialogues": [
                {
                  "role": "吉丽安娜",
                  "text": "巴巴托斯大人和他的风，肯定每天都很繁忙，"
                },
                {
                  "role": "吉丽安娜",
                  "text": "而且，也不能事事指望神明，自己却偷着懒呀。"
                },
                {
                  "role": "吉丽安娜",
                  "text": "就请您和我一起，为巴巴托斯大人分忧吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "吉丽安娜",
          "text": "对了，七天神像有着神明的力量。"
        },
        {
          "role": "吉丽安娜",
          "text": "上面的「尘埃」并不能用普通的方法清理掉…"
        },
        {
          "role": "吉丽安娜",
          "text": "不过您有着「元素」的力量，应该能轻松解决吧。"
        },
        {
          "role": "吉丽安娜",
          "text": "不像我，一尊神像就要清理整整一天…"
        },
        {
          "type": "subtitle",
          "text": "清扫位于星落湖的七天神像"
        },
        {
          "type": "subtitle",
          "text": "清扫位于风起地的七天神像"
        },
        {
          "type": "subtitle",
          "text": "清扫位于晨曦酒庄的七天神像"
        },
