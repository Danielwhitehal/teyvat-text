{
  "quest_id": 23041,
  "chapter_num": null,
  "chapter_title": "沙中花",
  "type": "iq",
  "route": "Desert Bloom",
  "stories": [
    {
      "story_id": 23041,
      "title": "沙中花",
      "description": "内尔敏正在努力地照顾着那盆花…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与内尔敏对话"
        },
        {
          "role": "内尔敏",
          "text": "呼…这样松土应该就可以了吧…"
        },
        {
          "role": "旅行者",
          "text": "你还在照顾这盆花吗？"
        },
        {
          "role": "内尔敏",
          "text": "嗯，库尔苏姆奶奶教了我很多照顾花的方法。"
        },
        {
          "role": "内尔敏",
          "text": "比如要给它松土啦，定时修剪叶片啦，用各种方法除虫啦…"
        },
        {
          "role": "内尔敏",
          "text": "还有浇水不能浇得太多，不然花的根部就会被水泡烂。"
        },
        {
          "role": "内尔敏",
          "text": "哎呀，我还以为要每天浇花，时刻让土壤保持湿润呢…"
        },
        {
          "role": "内尔敏",
          "text": "不过这样也好，我就不用每天都去打水了，取水的地方离这里可远了。"
        },
        {
          "role": "内尔敏",
          "text": "我得接着修剪枝叶，旅行者，你能帮我去打一小壶水过来吗？"
        },
        {
          "role": "内尔敏",
          "text": "我已经和卡桑说过了，他答应我可以去取水浇花。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "这都是库尔苏姆奶奶告诉你的？",
              "dialogues": [
                {
                  "role": "内尔敏",
                  "text": "唔…差不多吧，库尔苏姆奶奶知道的事可多了，我经常去找她请教呢。"
                },
                {
                  "role": "内尔敏",
                  "text": "那就拜托你了，旅行者，只要打一小壶水过来就好。"
                }
              ]
            }
          ]
        },
        {
          "role": "内尔敏",
          "text": "水壶就在那边，你打水的时候可要注意喔，可不要打上来太多泥沙了。"
        },
        {
          "role": "内尔敏",
          "text": "呜…又有几片叶子被咬破了…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "内尔敏",
          "text": "旅行者，你看呀！又有小猫过来咬花了！"
        },
        {
          "role": "内尔敏",
          "text": "你看这片叶子，这片…还有这片！都被咬下去了一大块！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小猫饿了？",
              "dialogues": [
                {
                  "role": "内尔敏",
                  "text": "里夫也这么说，他还专门带着吃的到处去喂猫…"
                },
                {
                  "role": "内尔敏",
                  "text": "但是第二天，还是有小猫过来咬花。"
                }
              ]
            },
            {
              "text": "小猫是…咬着玩？",
              "dialogues": [
                {
                  "role": "内尔敏",
                  "text": "我是弄不清小猫喜欢玩什么啦…"
                }
              ]
            }
          ]
        },
        {
          "role": "内尔敏",
          "text": "现在小猫只是咬叶子，但我就怕小猫有一天开始咬花茎…那可就糟了。"
        },
        {
          "role": "内尔敏",
          "text": "不过，我也狠不下心去把它赶得很远，毕竟外面就是沙漠，它除了这个村子之外，也无处可去…"
        },
        {
          "role": "内尔敏",
          "text": "旅行者，你能帮我再去喂喂它吗？希望小猫吃饱了之后，别再来咬花了，花叶也不是什么好吃的东西呀…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "我很擅长和猫打交道。",
              "dialogues": [
                {
                  "role": "内尔敏",
                  "text": "那样就最好了！我每次看见小猫的爪子，都担心它会突然扑上来给我一爪…"
                }
              ]
            }
          ]
        },
        {
          "role": "内尔敏",
          "text": "那就拜托你了，旅行者，我把那只小猫经常待的地方给你标在地图上…"
        },
        {
          "role": "内尔敏",
          "text": "我要在这盆花旁边守着，免得又有其他的小猫过来咬花…"
        },
        {
          "role": "内尔敏",
          "text": "旅行者，你来得正好，快来尝尝我做的薄荷豆汤。"
        },
        {
          "role": "旅行者",
          "text": "这些材料是…"
        },
        {
          "role": "内尔敏",
          "text": "有些是我托人买回来的，但是薄荷嘛…是我自己种的。"
        },
        {
          "role": "内尔敏",
          "text": "里夫不是送了我一套园艺工具，还有一堆肥料吗？"
        },
        {
          "role": "内尔敏",
          "text": "如果仅仅是种一盆花，我觉得实在是太浪费了…所以，我就拜托阿扎莱帮我买了一些薄荷种子。"
        },
        {
          "role": "内尔敏",
          "text": "把薄荷种子种下去之后，我就和照顾那盆花一样照顾着它。"
        },
        {
          "role": "内尔敏",
          "text": "照顾着照顾着，薄荷就顺利地成长…成熟…"
        },
        {
          "role": "内尔敏",
          "text": "我就采了一些下来，做成了「薄荷豆汤」，怎么样，味道还不错吧。"
        },
        {
          "role": "内尔敏",
          "text": "那…你既然喝了我做的「薄荷豆汤」，就得帮我个忙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那个，我没喝完…",
              "dialogues": []
            },
            {
              "text": "这碗还给你！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "内尔敏",
          "text": "别呀！我开玩笑的，会好好付给你报酬的啦！"
        },
        {
          "role": "内尔敏",
          "text": "我就是想请你去帮我采三枚「墩墩桃」回来，里夫很喜欢吃这种水果…"
        },
        {
          "role": "内尔敏",
          "text": "我想把它们加入「薄荷豆汤」里，然后送去给里夫。"
        },
        {
          "role": "内尔敏",
          "text": "现在「薄荷豆汤」我已经会做了，就等人帮我去拿「墩墩桃」啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了…",
              "dialogues": [
                {
                  "role": "内尔敏",
                  "text": "谢谢你啦，等你回来之后，我再请你喝一碗「薄荷豆汤」。"
                }
              ]
            },
            {
              "text": "他在工作时能喝吗？",
              "dialogues": [
                {
                  "role": "内尔敏",
                  "text": "就只是喝点东西而已啦，他的工作没有那么紧张。"
                }
              ]
            }
          ]
        },
        {
          "role": "内尔敏",
          "text": "那就拜托你了，旅行者。采到「墩墩桃」后就带回来给我吧。"
        },
        {
          "type": "subtitle",
          "text": "拿起水壶"
        },
        {
          "type": "subtitle",
          "text": "到达梯井下接水"
        },
        {
          "type": "subtitle",
          "text": "回去给绿植浇水"
        },
        {
          "role": "内尔敏",
          "text": "旅行者，你取到水了吗？"
        },
        {
          "role": "旅行者",
          "text": "算是取到了吧…"
        },
        {
          "role": "内尔敏",
          "text": "太好了，我这就开始浇花，你稍等一下…"
        },
        {
          "role": "？？？",
          "text": "内尔敏开始了浇花…"
        },
        {
          "role": "内尔敏",
          "text": "呼…这样应该就可以了…"
        },
        {
          "role": "内尔敏",
          "text": "库尔苏姆奶奶说，浇水的时候，只要浇到花盆底下有水透出来就可以停下了。"
        },
        {
          "role": "内尔敏",
          "text": "这样就算是「浇透」了花土，之后就要每三天浇一次水…"
        },
        {
          "role": "内尔敏",
          "text": "喔！对不起，我怎么自言自语起来了…这些是报酬，谢谢你帮忙，旅行者。"
        },
        {
          "role": "内尔敏",
          "text": "修剪叶片的时候，要用什么工具好呢…"
        },
        {
          "role": "里夫",
          "text": "唉，怎么突然有一批货物要运过来…"
        },
        {
          "role": "内尔敏",
          "text": "唔唔，为什么花叶上会有这么多虫子啊…"
        },
        {
          "type": "subtitle",
          "text": "寻找小猫"
        },
        {
          "role": "懒散的小猫",
          "text": "喵？喵喵喵！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！我们不是坏人，别这么凶呀。"
        },
        {
          "role": "派蒙",
          "text": "这应该就是内尔敏说的那只小猫了，我们喂它点吃的吧。"
        },
        {
          "role": "？？？",
          "text": "在小猫警惕地注视下，把食物放在了它面前…"
        },
        {
          "role": "派蒙",
          "text": "它吃的可真香…这样应该就可以了，我们回去告诉内尔敏这件事吧。"
        },
        {
          "type": "subtitle",
          "text": "寻找小猫"
        },
        {
          "role": "内尔敏",
          "text": "小猫居然这么喜欢咬花叶…那花叶尝起来到底是什么味道呢…"
        },
        {
          "type": "subtitle",
          "text": "寻找小猫"
        },
        {
          "type": "subtitle",
          "text": "向内尔敏回报"
        },
        {
          "role": "内尔敏",
          "text": "旅行者，你找到那只小猫了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "已经喂过它了。",
              "dialogues": []
            },
            {
              "text": "它应该已经吃饱了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "内尔敏",
          "text": "那就好，希望它别再来咬花了。无论怎么说，猫粮都要比花叶好吃啊。"
        },
        {
          "role": "内尔敏",
          "text": "谢谢你帮忙旅行者，这是报酬，请你收下吧。"
        },
        {
          "role": "内尔敏",
          "text": "唉，希望小猫不要饿得太快…"
        },
        {
          "type": "subtitle",
          "text": "将「墩墩桃」带给内尔敏"
        },
        {
          "type": "subtitle",
          "text": "将「墩墩桃」带给内尔敏"
        },
        {
          "role": "内尔敏",
          "text": "谢谢你！我得先把它切块，然后再加入进「薄荷豆汤」里…"
        },
        {
          "role": "？？？",
          "text": "内尔敏开始制作特别的「薄荷豆汤」…"
        },
        {
          "role": "内尔敏",
          "text": "完成了！唔…看起来和普通的「薄荷豆汤」好像也没什么区别…"
        },
        {
          "role": "内尔敏",
          "text": "不过，尝起来肯定会不一样的！"
        },
        {
          "role": "内尔敏",
          "text": "旅行者，就麻烦你把这碗「薄荷豆汤」带去给里夫吧。"
        },
        {
          "role": "内尔敏",
          "text": "我还得给库尔苏姆奶奶做几份，奥贝德和希尔米说他们也想喝…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别太累了喔。",
              "dialogues": [
                {
                  "role": "内尔敏",
                  "text": "我知道啦，只是几碗「薄荷豆汤」而已，不会有什么问题的。"
                }
              ]
            },
            {
              "text": "你还真有精力…",
              "dialogues": [
                {
                  "role": "内尔敏",
                  "text": "毕竟…我总算是可以做一些正事了，当然要好好把握住这个机会。"
                }
              ]
            }
          ]
        },
        {
          "role": "内尔敏",
          "text": "总之，请你把这份「薄荷豆汤」送给里夫吧。"
        },
        {
          "role": "内尔敏",
          "text": "还得给纳瓦兹和拉米兹也准备几份…"
        },
        {
          "type": "subtitle",
          "text": "把内尔敏做好的饮料带给里夫"
        },
        {
          "role": "内尔敏",
          "text": "还得给纳瓦兹和拉米兹也准备几份…"
        },
        {
          "type": "subtitle",
          "text": "把内尔敏做好的饮料带给里夫"
        },
        {
          "role": "里夫",
          "text": "喔！旅行者，你今天怎么有空过来了，是有事找我帮忙吗？"
        },
        {
          "role": "旅行者",
          "text": "这是内尔敏给你的。"
        },
        {
          "role": "里夫",
          "text": "这「薄荷豆汤」…是内尔敏自己做的？"
        },
        {
          "role": "里夫",
          "text": "我说她最近怎么神神秘秘的，而且还找人买了几个花盆，不知道往里面种了什么…"
        },
        {
          "role": "里夫",
          "text": "不过这样也不错，至少…内尔敏不会每天都只想着自己的身体问题了。"
        },
        {
          "role": "里夫",
          "text": "等会还有一批货要送进来，等我把那批货接进村里之后，就把这碗汤给喝了。"
        },
        {
          "role": "里夫",
          "text": "对了，这些报酬给你，多谢你跑一趟啦，旅行者。"
        }
      ]
    }
  ]
}