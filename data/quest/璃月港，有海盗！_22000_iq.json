{
  "quest_id": 22000,
  "chapter_num": null,
  "chapter_title": "璃月港，有海盗！",
  "type": "iq",
  "route": "Pirate Invasion, in Liyue Harbor!",
  "stories": [
    {
      "story_id": 22000,
      "title": "璃月港，有海盗！",
      "description": "有一群孩子想要玩一场海盗游戏…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与璐璐、阿飞、小蒙对话"
        },
        {
          "role": "小蒙",
          "text": "今天我们怎么玩？"
        },
        {
          "role": "阿飞",
          "text": "哼，要是没人来扮海盗，今天也玩不了。"
        },
        {
          "role": "小蒙",
          "text": "可是，谁也不愿意扮海盗，怎么办呢…"
        },
        {
          "role": "旅行者",
          "text": "你们在做什么？"
        },
        {
          "role": "小蒙",
          "text": "我们在玩游戏呢，可总是缺一个人来扮海盗。"
        },
        {
          "role": "小蒙",
          "text": "因为没人扮海盗来抢劫，我们一直没法开始玩…"
        },
        {
          "role": "小蒙",
          "text": "对了，大哥哥！你能来扮海盗吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "小蒙",
                  "text": "好哎！那我们就去准备啦！"
                }
              ]
            },
            {
              "text": "我不太了解这方面…",
              "dialogues": [
                {
                  "role": "小蒙",
                  "text": "没关系啦，海盗…唔，应该是那种蛮不讲理，随便抢走人家东西的坏人。"
                },
                {
                  "role": "小蒙",
                  "text": "虽然我也没有见过，只是听北斗姐姐讲过。"
                },
                {
                  "role": "小蒙",
                  "text": "但我觉得…这种人，应该挺好演的吧。"
                },
                {
                  "role": "小蒙",
                  "text": "嘿嘿，总之就拜托大哥哥啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "小蒙",
          "text": "大哥哥准备好了的话，就过来吧。"
        },
        {
          "type": "subtitle",
          "text": "与「船长」小蒙对话"
        },
        {
          "role": "旅行者",
          "text": "准备好了。"
        },
        {
          "role": "小蒙",
          "text": "那我们直接开始吧。"
        },
        {
          "role": "小蒙",
          "text": "从哪开始呢…"
        },
        {
          "role": "旅行者",
          "text": "那个，抢劫…"
        },
        {
          "role": "璐璐",
          "text": "呜哇！是海盗！"
        },
        {
          "role": "阿飞",
          "text": "璐璐快过来，我来保护你！"
        },
        {
          "role": "小蒙",
          "text": "你是海盗吧，为什么要来抢劫？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我是海盗。",
              "dialogues": []
            },
            {
              "text": "海盗就是要抢劫。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "小蒙",
          "text": "海盗也分好坏，不一定都要抢劫呀。"
        },
        {
          "role": "小蒙",
          "text": "北斗姐姐也说自己是海盗，可是她是很好的人，会给我好吃的，大家都很喜欢她。"
        },
        {
          "role": "小蒙",
          "text": "为什么大哥哥要做坏海盗，不做好海盗呢？"
        },
        {
          "role": "派蒙",
          "text": "明明是你说，海盗是那种「蛮不讲理」的人吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧，我错了…",
              "dialogues": []
            },
            {
              "text": "我想做个好人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "小蒙",
          "text": "唔，愿意改邪归正是好事。这也是北斗姐姐说的。"
        },
        {
          "role": "小蒙",
          "text": "那么，你就帮忙去清理一下周围吧，只要做好事，那就可以做好人，或者好海盗。"
        },
        {
          "type": "subtitle",
          "text": "用「风」或「水」来清洗甲板"
        },
        {
          "type": "subtitle",
          "text": "与小蒙对话"
        },
        {
          "role": "小蒙",
          "text": "你准备好了吗？"
        },
        {
          "role": "小蒙",
          "text": "清洗好了吗？"
        },
        {
          "role": "旅行者",
          "text": "清洗好了。"
        },
        {
          "role": "小蒙",
          "text": "嗯！辛苦你啦，这些给你，谢谢你陪我们玩。"
        },
        {
          "role": "小蒙",
          "text": "大哥哥以后也要做好人啊。"
        },
        {
          "role": "阿飞",
          "text": "喂，什么时候能轮到我做船长啊？"
        },
        {
          "role": "小蒙",
          "text": "下次吧，下次就归你了。"
        },
        {
          "role": "阿飞",
          "text": "哼，上次你就这么说的…"
        },
        {
          "role": "小蒙",
          "text": "清理好了吗？"
        },
        {
          "role": "旅行者",
          "text": "还没有。"
        },
        {
          "role": "小蒙",
          "text": "快去清理吧，这可是大哥哥改邪归正的好机会喔。"
        },
        {
          "role": "阿飞",
          "text": "喂，我说啊，做一下清洁工作就能成好人了吗？"
        },
        {
          "role": "小蒙",
          "text": "只要愿意去做好事，那就是好人。"
        },
        {
          "role": "阿飞",
          "text": "这也太简单了…"
        },
        {
          "role": "小蒙",
          "text": "做了好事，就是好人，做了坏事，就是坏人，就这么简单。"
        },
        {
          "role": "阿飞",
          "text": "哼，你说是简单，但如果这么简单，那天下哪里还有坏人呢？"
        },
        {
          "role": "小蒙",
          "text": "因为天下的所有事都是说起来容易，做起来难。"
        },
        {
          "role": "小蒙",
          "text": "而坏事做起来，总是比好事容易的。"
        },
        {
          "role": "阿飞",
          "text": "这也是北斗姐姐教你的？"
        },
        {
          "role": "小蒙",
          "text": "是我从书里看的。"
        }
      ]
    }
  ]
}