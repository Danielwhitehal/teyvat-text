{
  "quest_id": 71145,
  "chapter_num": null,
  "chapter_title": "解析与想定",
  "type": "wq",
  "route": "Scenarios for Study",
  "stories": [
    {
      "story_id": 71145,
      "title": "解析与想定",
      "description": "此次千岩军主持的联合推演即将结束，苏定似乎还想与你谈谈…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与苏定对话"
        },
        {
          "role": "苏定",
          "text": "有劳两位了，旅行者顾问和这位才智出众的帮手！"
        },
        {
          "role": "苏定",
          "text": "经过这段时间的推演，我们获得了充足的对抗案例，足以拆解出各种复杂战况的分析样本。"
        },
        {
          "role": "苏定",
          "text": "接下来，只需根据推演兵种的特性，建立更宽泛的模型，就能撰写多种想定脚本，将它们交给多个单位的各级将士钻研。"
        },
        {
          "role": "苏定",
          "text": "如果两位有兴趣，下次见面时，我也会为你们提供对应的想定脚本，以供你们在闲暇之时锻炼才思。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这就搞定了？好像还没玩几局…",
              "dialogues": [
                {
                  "role": "苏定",
                  "text": "我们深知两位事务繁忙，尽量排除了相似的推演，避免重复工作。当然，如果两位还没尽兴，再来多少次都没问题。"
                }
              ]
            },
            {
              "text": "终于完成了！辛苦我和派蒙啦…",
              "dialogues": [
                {
                  "role": "苏定",
                  "text": "嘿嘿，虽然我还没完全搞明白各种规则，但玩得还挺开心的！看起来结果也不错嘛！"
                }
              ]
            }
          ]
        },
        {
          "role": "苏定",
          "text": "总而言之，我代表千岩军的参谋部，以及其他参会单位的代表，向你们表示郑重的感谢！"
        },
        {
          "role": "苏定",
          "text": "希望以后还有机会与两位合作，进一步加强各单位清除魔物，改善治安状况的能力。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "乐意至极！",
              "dialogues": []
            },
            {
              "text": "有空就来！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼哼，这次的进展真是超级顺利。感觉，我们和以前就认识的各种团队搞好了关系，还帮到了提瓦特各种地方的人！"
        },
        {
          "role": "派蒙",
          "text": "而且，看着你进行推演，我好像也学到了不少知识？"
        },
        {
          "role": "派蒙",
          "text": "说不定，以后我们闲着无聊的时候，也可以来分析分析…"
        },
        {
          "role": "派蒙",
          "text": "比如，唔…深渊法师和大雪猪王对对碰，谁会赢？"
        },
        {
          "role": "派蒙",
          "text": "或者…遗迹守卫和岩龙蜥，谁的脑袋更硬！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（苏定）"
        },
        {
          "role": "苏定",
          "text": "根据你这位将才的多次推演所总结出的想定，肯定能让各级将士得到极大的锻炼，万分感谢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "之前忘了问，关于千岩军的参谋部门…",
              "dialogues": [
                {
                  "role": "苏定",
                  "text": "哦，其实这是一个约定俗成的称呼，毕竟正式成立的时间不算长。"
                },
                {
                  "role": "苏定",
                  "text": "自上次与「跋掣」交战后，玉衡星大人与其余几位七星长官仔细商议后，决定适当改进千岩军的指挥体系。"
                },
                {
                  "role": "苏定",
                  "text": "璃月自古已有参谋一职，但大多作为将军的谋士独自活动，个人所能发挥的才智和影响力其实相当有限。"
                },
                {
                  "role": "苏定",
                  "text": "玉衡星大人根据提瓦特各地收集到的情报，单独设立了这一部门，将参谋们集中起来，以更高效的方式安排工作。"
                },
                {
                  "role": "苏定",
                  "text": "如此一来，参谋们就能分析出更为准确的情报、制定尽可能合理的作战计划，并以更准确的方式传达给各级将士。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "听不太懂了…",
                      "dialogues": []
                    },
                    {
                      "text": "好像明白了…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "苏定",
                  "text": "没关系，以你的身份，说不定之后再见玉衡星大人时， 她会直接为你详尽而易懂地进行说明。"
                },
                {
                  "role": "苏定",
                  "text": "我也期待着，将来某天，我们的情报能为你提供切实的帮助。"
                }
              ]
            },
            {
              "text": "其实…「想定」是什么？",
              "dialogues": [
                {
                  "role": "苏定",
                  "text": "这是玉衡星大人推广的一种概念，据说是总结了多方情报后的产物——"
                },
                {
                  "role": "苏定",
                  "text": "你可以把想定当成一种综合性的考察与训练课题，从多个方面考验将士们对排兵布阵，指挥交战的能力。"
                },
                {
                  "role": "苏定",
                  "text": "读起来可能有些复杂，进行想定的过程，相比这次桌上推演会更严格，但完成想定后的收获是相当可观的。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那对我很有用…",
                      "dialogues": [
                        {
                          "role": "苏定",
                          "text": "果然…「身为将才，从不放过每次锻炼自己的机会」，军中有关你的英武传闻句句属实！"
                        }
                      ]
                    },
                    {
                      "text": "那我还是免了…",
                      "dialogues": [
                        {
                          "role": "苏定",
                          "text": "无妨，听说你近来每日都有要事在身，说不定等到闲暇时，会有兴致稍作尝试。"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "苏定",
                  "text": "言归正传，根据此次推演编写想定是个漫长的过程，还需不少时日，我会尽力而为。"
                }
              ]
            },
            {
              "text": "客气了，你先忙。",
              "dialogues": [
                {
                  "role": "苏定",
                  "text": "那就来日再见了！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（方妮雅）"
        },
        {
          "role": "方妮雅",
          "text": "看来你也忙得差不多了，荣誉骑士。我们这边的工作基本完成了，不久后就会启程返回蒙德。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这次交流的结果怎么样？",
              "dialogues": [
                {
                  "role": "方妮雅",
                  "text": "相当不错，直接暴露了我方计划编制的短板——机动力量中的远程交战能力略显孱弱。"
                },
                {
                  "role": "方妮雅",
                  "text": "推演中，我方多次与枫丹的发条机关交手，虽有使用重型弓箭的单位，但很难穿透对方厚重的装甲，需要尽量拉近交战距离。"
                },
                {
                  "role": "方妮雅",
                  "text": "如此一来，却又丧失了我方在预想中利用炼金侦察设备带来的情报优势。"
                },
                {
                  "role": "方妮雅",
                  "text": "这方面的问题，可能要多多请教那位侦察骑士了。"
                },
                {
                  "role": "方妮雅",
                  "text": "或者…找到艾玛托那家伙，让她把自己的炸药小型化…绑在箭头上？"
                },
                {
                  "role": "方妮雅",
                  "text": "嗯…似乎也是不错的选择。"
                }
              ]
            },
            {
              "text": "一路顺风！",
              "dialogues": [
                {
                  "role": "方妮雅",
                  "text": "那就在蒙德再见了，荣誉骑士。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（玄理）"
        },
        {
          "role": "玄理",
          "text": "奉行大人的贵客，在下归乡在即。近来见阁下事务繁忙，不敢随意叨扰。如有怠慢，还请见谅。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不必这么拘谨，你是来开会的！",
              "dialogues": [
                {
                  "role": "玄理",
                  "text": "在下是来学习的，理应以谦卑之姿面对在场每位武艺精湛之人。"
                },
                {
                  "role": "玄理",
                  "text": "所幸在下不负奉行大人的期望，此行收获颇丰，记录了多本要点。"
                },
                {
                  "role": "玄理",
                  "text": "幕府军今后便可以本次推演的收获，针对性改进战法，更为利落地应对游荡在各岛的浪人贼寇…"
                },
                {
                  "role": "玄理",
                  "text": "但愿阁下能在机缘得当之时再访稻妻，验收我等精进的成果。"
                }
              ]
            },
            {
              "text": "别客气，请代我问候绫人和绫华！",
              "dialogues": [
                {
                  "role": "玄理",
                  "text": "阁下的气度深深影响了在下，在下定会将美言回呈奉行大人与神里大小姐！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（西达）"
        },
        {
          "role": "西达",
          "text": "又见面了，大风纪官和「炽鬃之狮」的友人，可惜不能与你多聊几天，我们准备返回须弥了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "推演进行得顺利吗？",
              "dialogues": [
                {
                  "role": "西达",
                  "text": "越往后，越觉得学到了不少东西。"
                },
                {
                  "role": "西达",
                  "text": "比如，我们对上了少见的稻妻魔物，在佣兵们多年来的经验之谈中，很难找到有效打败对方的方法。"
                },
                {
                  "role": "西达",
                  "text": "还是其他兵棋的进攻方式启发了我们，让我们恍然大悟。"
                },
                {
                  "role": "西达",
                  "text": "不得不说，用兵棋模拟魔物，彼此对抗，只要仔细思索其中的规律…"
                },
                {
                  "role": "西达",
                  "text": "即便是装备没有明显优势的镀金旅团佣兵，也能找到稳定制胜的捷径。"
                }
              ]
            },
            {
              "text": "那就须弥再见了！",
              "dialogues": [
                {
                  "role": "西达",
                  "text": "哈哈哈，没问题！再碰面的时候，我叫上兄弟们和「炽鬃之狮」，尽量邀请大风纪官，好好聚一聚！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（蒂蕾娜）"
        },
        {
          "role": "蒂蕾娜",
          "text": "推演快要结束啦，准领队，我听苏定参谋说，你那边的进展相当顺利？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我这边还不错，你的收获如何？",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "嘿！我们的收获可真是不得了！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "这次我们在推演中遇上了许多机动性极强的敌人，比如飞行的蕈兽。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "它们相当克制铳枪这种攻击速度不快，只能对点打击的武器。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "因此，我们好好锻炼了小队伍快速转移的战术，区别于以前的结阵射击，战斗方式变得更灵活了！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "总之，好在这次推演为我们找到了作战方式上的短板，接下来的努力方向就有眉目了，我现在充满干劲！"
                }
              ]
            },
            {
              "text": "一切都好，下次再见！",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "当然当然！随时欢迎您到特巡队的驻地来视察…如果您能找得到！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
