{
  "quest_id": 72153,
  "chapter_num": null,
  "chapter_title": "在他乡",
  "type": "wq",
  "route": "In Another Land",
  "stories": [
    {
      "story_id": 72153,
      "title": "在他乡",
      "description": "来自须弥的学者爱拉尼小姐似乎又想到了一个全新的论文主题…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "跟随爱拉尼"
        },
        {
          "role": "爱拉尼",
          "text": "稻妻的特色商品，原来是这样的啊…嗯…"
        },
        {
          "role": "枫",
          "text": "喂，你们…这是在做什么？"
        },
        {
          "role": "爱拉尼",
          "text": "你好！我是爱拉尼，来自须弥的学者，为了进行学术研究正在调查稻妻呢。"
        },
        {
          "role": "枫",
          "text": "在这种时候「调查稻妻」？好可疑的家伙…"
        },
        {
          "role": "枫",
          "text": "我不管你们究竟有什么目的，请不要在我的店附近做这种让人不安的事情，快走吧。"
        },
        {
          "type": "subtitle",
          "text": "给店铺「天顶屋」及其店主留影"
        },
        {
          "role": "瓦希德",
          "text": "喂，你们在做什么呢？"
        },
        {
          "role": "爱拉尼",
          "text": "你好！我是来自…"
        },
        {
          "role": "瓦希德",
          "text": "来自教令院的学者，对吧？没想到在这里都能遇见…"
        },
        {
          "role": "爱拉尼",
          "text": "您怎么…"
        },
        {
          "role": "瓦希德",
          "text": "看你的模样就知道是学者，在须弥的时候我可见多了。"
        },
        {
          "role": "瓦希德",
          "text": "大老远从须弥跑到稻妻来，难道是在进行所谓的「社会调查」？"
        },
        {
          "role": "爱拉尼",
          "text": "是的，我正准备着呢。您也在教令院里…"
        },
        {
          "role": "瓦希德",
          "text": "我可没有那种做学问的本事，只不过是普通的生意人而已。"
        },
        {
          "role": "瓦希德",
          "text": "既然你是在写论文，那你想记录我这里的什么东西，就自己记录吧，但我要忠告你几句。"
        },
        {
          "role": "瓦希德",
          "text": "远国监司对你我这种外国人可是很提防的，你去记录的时候，记得收敛一点。"
        },
        {
          "role": "瓦希德",
          "text": "如果惹到了什么麻烦，对你这种刚来稻妻的外国人来说，说不定会很难收场。"
        },
        {
          "role": "爱拉尼",
          "text": "我、我知道了，谢谢您！"
        },
        {
          "role": "瓦希德",
          "text": "嗯，你赶紧自己去做记录去吧。"
        },
        {
          "type": "subtitle",
          "text": "与枫对话"
        },
        {
          "type": "subtitle",
          "text": "跟随爱拉尼"
        },
        {
          "role": "瓦希德",
          "text": "您找到食材了吗？"
        },
        {
          "type": "subtitle",
          "text": "给店铺「葱茏之愿」及店主留影"
        },
        {
          "role": "爱拉尼",
          "text": "<color=#00E1FFFF>一份鱼肉</color>、<color=#00E1FFFF>一份海草</color>和<color=#00E1FFFF>一份稻米</color>…能做出什么菜呢？"
        },
        {
          "type": "subtitle",
          "text": "与瓦希德对话"
        },
        {
          "type": "subtitle",
          "text": "跟随爱拉尼"
        },
        {
          "type": "subtitle",
          "text": "前往码头给渔夫留影"
        },
        {
          "role": "瓦希德",
          "text": "唉，不是提醒过你们了吗？不要做出格的事情。"
        },
        {
          "role": "瓦希德",
          "text": "你还没办好许可，要真的闹到远国监司去，这事就真的没法收场了，还好我留意了一下你们那边。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有这么严重吗？",
              "dialogues": [
                {
                  "role": "瓦希德",
                  "text": "就是这么严重，看见离岛这里的关卡了吗？想要进入稻妻，必须拿到许可才行。"
                }
              ]
            },
            {
              "text": "局势还这么紧张？",
              "dialogues": [
                {
                  "role": "瓦希德",
                  "text": "我在这里，也不太清楚。但总不能连许可都没有啊。"
                },
                {
                  "role": "瓦希德",
                  "text": "看见离岛这里的关卡了吗？想要进入稻妻，必须拿到许可才行。"
                }
              ]
            }
          ]
        },
        {
          "role": "爱拉尼",
          "text": "呜…这样的话，我是不是就不能去其他的岛取材了…"
        },
        {
          "role": "瓦希德",
          "text": "放心吧。我已经去远国监司问过许可的事了，有我这个在稻妻做生意的人做保，办许可应该会容易不少。"
        },
        {
          "role": "爱拉尼",
          "text": "谢…谢谢您，但是，您为什么要帮我解围？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是热心肠啊。",
              "dialogues": [
                {
                  "role": "瓦希德",
                  "text": "你这么说，我倒是也不反对。"
                }
              ]
            },
            {
              "text": "是「同乡之谊」吗？",
              "dialogues": [
                {
                  "role": "瓦希德",
                  "text": "同乡之谊…算是有一点吧，在稻妻遇见一个须弥人可不太容易。"
                }
              ]
            }
          ]
        },
        {
          "role": "瓦希德",
          "text": "不过更主要的是，我想要请这位学者，来帮我一个忙。"
        },
        {
          "role": "爱拉尼",
          "text": "欸？可是我不太会卖东西…"
        },
        {
          "role": "瓦希德",
          "text": "当然不是这方面了。说出来有些不好意思…"
        },
        {
          "role": "瓦希德",
          "text": "虽然我是做肥料生意的，但我却对这些肥料实在不够了解。"
        },
        {
          "role": "瓦希德",
          "text": "别人问我这些肥料有什么须弥特色，我也只会照着进货时候附带的说明书念，说不出什么更有说服力的话。"
        },
        {
          "role": "瓦希德",
          "text": "如果你愿意的话，我想请你帮我稍微想想…怎么推销这些肥料。"
        },
        {
          "role": "瓦希德",
          "text": "至少让我知道怎么介绍才能更有说服力，更能吸引顾客…"
        },
        {
          "role": "瓦希德",
          "text": "作为交换，我会为你做担保，向远国监司申请一份许可，让你可以进入稻妻的其他地方。"
        },
        {
          "role": "瓦希德",
          "text": "你看这笔生意，你愿不愿意？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来须弥也有学者之外的人…",
              "dialogues": [
                {
                  "role": "瓦希德",
                  "text": "那是当然了。也不是每个人都能…或者愿意去教令院里学习成为学者的。"
                }
              ]
            },
            {
              "text": "听起来倒是还算合理。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱拉尼",
          "text": "推销啊…我在教令院的时候，倒是有学过相关的课程。"
        },
        {
          "role": "旅行者",
          "text": "这个你也学过？"
        },
        {
          "role": "爱拉尼",
          "text": "只是看过一些相关的书啦…而且都是理论，我也从来没有实践过。"
        },
        {
          "role": "爱拉尼",
          "text": "毕竟在教令院那种地方，我也没法实践「推销」这种事情。"
        },
        {
          "role": "爱拉尼",
          "text": "但是，如果能从应用的角度研究一下这些肥料，也许我能想出一些可以用在推销上的点子…"
        },
        {
          "role": "瓦希德",
          "text": "如果你真能想出来的话，那就太好了…"
        },
        {
          "role": "瓦希德",
          "text": "啊…我们还是别在这里站着说了，折腾了这么久，你们应该也饿了。"
        },
        {
          "role": "瓦希德",
          "text": "我给你们做点吃的填填肚子吧。"
        },
        {
          "role": "瓦希德",
          "text": "旅行者，能请你帮我找些食材来吗？只要一份鱼肉、一份海草和一份稻米就好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我了。",
              "dialogues": []
            },
            {
              "text": "要做什么好吃的？",
              "dialogues": [
                {
                  "role": "瓦希德",
                  "text": "哈哈哈，谈不上什么美味。只不过是…一些老手艺而已。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与小畑对话"
        },
        {
          "role": "小畑",
          "text": "喂！你们两个，在做什么呢！"
        },
        {
          "role": "爱拉尼",
          "text": "你好！我是爱拉尼，来自须弥的学者，正在这里做学术调查呢。"
        },
        {
          "role": "小畑",
          "text": "调查？我这个打渔的，有什么好调查的？"
        },
        {
          "role": "小畑",
          "text": "而且做这种可疑的事…你们有远国监司的许可吗？"
        },
        {
          "role": "小畑",
          "text": "我之前听权四郎说过，这种行为应该是要先去远国监司报备的吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没听说过…",
              "dialogues": []
            },
            {
              "text": "怎么这也要许可…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱拉尼",
          "text": "诶？咦？有、有这种事吗？之前完全没听说过！"
        },
        {
          "role": "小畑",
          "text": "越来越可疑了…你们还是和我去见一下荫山小姐吧。"
        },
        {
          "role": "小畑",
          "text": "她是远国监司的监察，你们的事让她来判断再合适不过了。"
        },
        {
          "role": "爱拉尼",
          "text": "等、等等，我真的只是学术调查而已，备案什么的…我、我等会就去…"
        },
        {
          "role": "瓦希德",
          "text": "小畑先生，这里是怎么了，我离那么远都能听到这边的动静。"
        },
        {
          "role": "小畑",
          "text": "哦，是瓦希德先生啊。是这样，这两个人一直在旁边转悠，说是在开展什么学术调查。"
        },
        {
          "role": "小畑",
          "text": "但我问了之后，他们好像也没有远国监司的许可，我正打算让他们去见一下荫山小姐呢。"
        },
        {
          "role": "瓦希德",
          "text": "爱拉尼，你到处跑什么？店里不用帮忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（这是什么情况？）",
              "dialogues": []
            },
            {
              "text": "是啊，都说了不要乱跑。",
              "dialogues": [
                {
                  "role": "爱拉尼",
                  "text": "欸…欸？"
                }
              ]
            }
          ]
        },
        {
          "role": "瓦希德",
          "text": "你那论文写了那么久，难道还差这么一点时间吗？你看，这不就打扰到小畑先生了吗？"
        },
        {
          "role": "小畑",
          "text": "咦？瓦希德先生，您这是…"
        },
        {
          "role": "瓦希德",
          "text": "这位是我从教令院那边请来，给我的店做顾问的学者。"
        },
        {
          "role": "瓦希德",
          "text": "因为她正在写一篇和稻妻有关的论文，所以正在这周围取材。"
        },
        {
          "role": "瓦希德",
          "text": "她刚从教令院那边过来，还不太懂这里的规矩。"
        },
        {
          "role": "瓦希德",
          "text": "远国监司那边的手续我还在办，但她就忍不住到处跑…打扰到你真不好意思，小畑先生。"
        },
        {
          "role": "爱拉尼",
          "text": "欸…哦！对、对不起，小畑先生，打扰到您实在是不好意思…"
        },
        {
          "role": "小畑",
          "text": "哎呀，没关系，没关系，是我误会了，原来你真是在做学问啊。"
        },
        {
          "role": "瓦希德",
          "text": "好了，爱拉尼，过来这边，我们再好好说一说你的事。"
        },
        {
          "role": "瓦希德",
          "text": "小畑先生，我们就先失陪了。"
        },
        {
          "type": "subtitle",
          "text": "与瓦希德对话"
        },
        {
