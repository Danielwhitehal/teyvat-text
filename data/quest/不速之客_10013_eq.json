{
  "quest_id": 10013,
  "chapter_num": "白垩与黑龙 第四幕",
  "chapter_title": "不速之客",
  "type": "eq",
  "route": "Uninvited Guests",
  "stories": [
    {
      "story_id": 41213,
      "title": "不速之客",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "雪山上有太多意料之外的事：神秘隐蔽的营地、突然出现的小偷、不请自来的敌人。这把剑似乎将你们带入了怪圈，只要它还在你手中，麻烦就会源源不断地到来。你的麻烦，甚至包括蛮横夺剑之人与闻所未闻的新怪物。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "寻找阿贝多"
        },
        {
          "role": "派蒙",
          "text": "阿贝多！我们又——来啦！"
        },
        {
          "role": "派蒙",
          "text": "嗯？阿贝多好像不在？"
        },
        {
          "role": "派蒙",
          "text": "是出去调查了吗，还是又去画神秘写生了呢…"
        },
        {
          "role": "砂糖",
          "text": "啊！是你们！"
        },
        {
          "role": "派蒙",
          "text": "这不是砂糖吗，你怎么在这里？"
        },
        {
          "role": "砂糖",
          "text": "我的研究刚告一段落，今天有五小时二十六分左右的空闲时间。"
        },
        {
          "role": "砂糖",
          "text": "所以，就来找你们打听之前委托的事了！"
        },
        {
          "role": "派蒙",
          "text": "好精确的时间，你是人型钟表吗？"
        },
        {
          "role": "砂糖",
          "text": "不不不，这没什么值得夸奖的，你太客气了…"
        },
        {
          "role": "派蒙",
          "text": "人家没有在夸你啦！"
        },
        {
          "role": "砂糖",
          "text": "旅行者，我、我可以问吗？之前拜托你去调查阿贝多先生隐瞒的事，进展得还顺利吗？"
        },
        {
          "role": "派蒙",
          "text": "如果我的感官没有出问题，那已经是一个多星期前的事了哦。"
        },
        {
          "role": "旅行者",
          "text": "还以为你已经忘了。"
        },
        {
          "role": "砂糖",
          "text": "什么…！！"
        },
        {
          "role": "砂糖",
          "text": "一、一个多星期？！我明明…啊！"
        },
        {
          "role": "砂糖",
          "text": "呜，我太沉迷实验，完全忽略了这件事…"
        },
        {
          "role": "派蒙",
          "text": "该说她的时间观念太强呢，还是太弱呢…"
        },
        {
          "role": "砂糖",
          "text": "所、所以！你已经知道答案了对吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，可以这么说哦。",
              "dialogues": [
                {
                  "role": "砂糖",
                  "text": "太好了，能说给我听吗？"
                }
              ]
            },
            {
              "text": "完全调查清楚了。",
              "dialogues": [
                {
                  "role": "砂糖",
                  "text": "太好了，能说给我听吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "派蒙，你觉得呢？"
        },
        {
          "role": "派蒙",
          "text": "唔…告诉她应该不要紧吧？"
        },
        {
          "role": "派蒙",
          "text": "看看也行，只要不是触摸…"
        },
        {
          "role": "砂糖",
          "text": "等一下，你们在说什么呀？"
        },
        {
          "role": "砂糖",
          "text": "这是…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这就是阿贝多隐瞒的事。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是一把非常厉害的剑哦，不能用手碰。"
                }
              ]
            },
            {
              "text": "这就是你想知道的答案。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是一把非常厉害的剑哦，不能用手碰。"
                }
              ]
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "嗯…这是…"
        },
        {
          "role": "砂糖",
          "text": "！！这、这是！！我从未见过的…"
        },
        {
          "role": "派蒙",
          "text": "哼哼，尽情欣赏吧！不知为什么，连我都有一种奇怪的成就感！"
        },
        {
          "role": "砂糖",
          "text": "太厉害了，我还是第一次见到这么神奇的武器。"
        },
        {
          "role": "砂糖",
          "text": "我能隐约感到有力量在剑的内部徐徐流动…它就像活着的生物一样。"
        },
        {
          "role": "派蒙",
          "text": "这么具体的感觉吗？"
        },
        {
          "role": "砂糖",
          "text": "也许是我学习过炼金术的缘故吧。"
        },
        {
          "role": "砂糖",
          "text": "我不敢用太绝对的说辞，但确实有「流动」的感觉。虽然这说法很不严谨…本、本来我是不会用的。"
        },
        {
          "role": "砂糖",
          "text": "请相信我，我平时绝不会用这么模棱两可的说法！"
        },
        {
          "role": "派蒙",
          "text": "好好好，知道了。"
        },
        {
          "role": "砂糖",
          "text": "旅行者，请问…你可以使用这把剑战斗吗？"
        },
        {
          "role": "砂糖",
          "text": "我想多了解一些，但我不能使用它，只能拜托你了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "偷偷地，别让阿贝多知道哦。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那就到附近找合适的地点吧！"
                }
              ]
            },
            {
              "text": "找个不容易被发现的地方比较好。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那就到附近找合适的地点吧！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往怪物栖息地试剑"
        },
        {
          "type": "subtitle",
          "text": "击败周边的怪物"
        },
        {
          "type": "subtitle",
          "text": "与砂糖对话"
        },
        {
          "role": "砂糖",
          "text": "太厉害了，这样的武器我还是第一次看到…"
        },
        {
          "role": "砂糖",
          "text": "你也好厉害，无论是战斗的姿势还是挥剑的气势都非常完美。"
        },
        {
          "role": "旅行者",
          "text": "你过奖了。"
        },
        {
          "role": "砂糖",
          "text": "这把剑好特别，明明没有想要深入研究，眼神却不知不觉就被吸引了过去…"
        },
        {
          "role": "派蒙",
          "text": "我倒觉得比起剑的属性，这个更像是你自己的属性呢…"
        },
        {
          "role": "砂糖",
          "text": "危险诱人的神秘单手剑，嗯，不会错的。"
        },
        {
          "role": "砂糖",
          "text": "把这么重要的东西交给你，阿贝多先生果然非常信任你呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "对于这件事，我也很惊讶。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼哼，这也是凭本事换来的信任吧。"
                }
              ]
            },
            {
              "text": "很感谢他能这么相信我。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼哼，这也是凭本事换来的信任吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "我也这么觉得。"
        },
        {
          "role": "砂糖",
          "text": "不过在交给你之前，剑还没有吸收多少能量…阿贝多先生是怎么从一堆杂物中发觉它与众不同的呢？"
        },
        {
          "role": "派蒙",
          "text": "灵光一闪通常是没有道理的。比如我想吃蜜酱胡萝卜煎肉！"
        },
        {
          "role": "砂糖",
          "text": "啊…这么一说，我今天还没吃过多少东西呢。"
        },
        {
          "role": "砂糖",
          "text": "忙完实验赶来找你们，却在路上遇到被困在雪地里的冒险家，为了救他又花了不少时间…"
        },
        {
          "role": "砂糖",
          "text": "（咕…咕…）"
        },
        {
          "role": "旅行者",
          "text": "刚才那是肚子饿了的声音吗？"
        },
        {
          "role": "砂糖",
          "text": "啊、啊啊啊！不、不是这样的…"
        },
        {
          "role": "派蒙",
          "text": "别害羞别害羞，大胆地说出你的想法嘛！"
        },
        {
          "role": "砂糖",
          "text": "呃、呃…"
        },
        {
          "role": "派蒙",
          "text": "那我先说：肚子饿了！我想吃饭！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "肚子饿了！",
              "dialogues": [
                {
                  "role": "砂糖",
                  "text": "肚子…肚子饿了，要吃…"
                }
              ]
            },
            {
              "text": "我想吃饭！",
              "dialogues": [
                {
                  "role": "砂糖",
                  "text": "肚子…肚子饿了，要吃…"
                }
              ]
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "呜啊啊果然还是好丢脸啊！"
        },
        {
          "role": "派蒙",
          "text": "才没有这种事呢，承认饥饿会让食物更美味哦。"
        },
        {
          "role": "砂糖",
          "text": "咦，是这样吗？"
        },
        {
          "role": "派蒙",
          "text": "是这样哦！所以打起精神来，去休息地找食物吧~"
        },
        {
          "role": "派蒙",
          "text": "可以的话，真想在这冰天雪地里享用美味的蜜酱胡萝卜煎肉呀。"
        },
        {
          "type": "subtitle",
          "text": "跟随砂糖前往冒险家营地"
        },
        {
          "role": "冒失的帕拉德",
          "text": "呜呜…呜啊啊嗷嗷呜…"
        },
        {
          "role": "砂糖",
          "text": "帕拉德先生？！"
        },
        {
          "role": "砂糖",
          "text": "你、你还没回去吗？"
        },
        {
          "role": "派蒙",
          "text": "这不是蒙德那个冒失鬼冒险家吗？他也跟着塞琉斯来雪山探险啊？"
        },
        {
          "role": "冒失的帕拉德",
          "text": "冷冷冷死我了，阿嚏！"
        },
        {
          "role": "砂糖",
          "text": "我把你从雪坑里救出来以后，你就一直在这里吗？！"
        },
        {
          "role": "冒失的帕拉德",
          "text": "我也不想的，可是、可是我迷路了！抱歉…"
        },
        {
          "role": "冒失的帕拉德",
          "text": "呜噗噗噗…冷死了，一步也走不动啦…"
        },
        {
          "role": "砂糖",
          "text": "唉，帕拉德先生，你对雪山之旅太掉以轻心啦。"
        },
        {
          "role": "旅行者",
          "text": "我们带他一起回去吧。"
        },
        {
          "role": "砂糖",
          "text": "可以吗？他现在这样，恐怕要我们扶着才能走路了…"
        },
        {
          "role": "派蒙",
          "text": "就算不可以，也不能把他丢在这里吧？"
        },
        {
          "role": "砂糖",
          "text": "说得也是…抱歉呀旅行者，我、我替他向你道歉。"
        },
        {
          "role": "？？？",
          "text": "还有心思考虑别人？先担心你自己吧！"
        },
        {
          "role": "派蒙",
          "text": "啊！又是愚人众！"
        },
        {
          "role": "瓦京",
          "text": "我们的来意，你们想必已经知道了。"
        },
        {
          "role": "瓦京",
          "text": "交出那把剑，否则谁也别想离开这里！"
        },
        {
          "role": "砂糖",
          "text": "不行，请不要把剑交给他们！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当然不会交给他们了！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好有气势！一鼓作气把他们打翻！"
                }
              ]
            },
            {
              "text": "谁也别想从我这里夺走东西！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好有气势！一鼓作气把他们打翻！"
                }
              ]
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "帕拉德先生，我带你到安全的地方去！快来！"
        },
        {
          "role": "瓦京",
          "text": "天真，所有知情人一个都别想跑！"
        },
        {
          "role": "瓦京",
          "text": "这把剑将被作为礼物，献给尊贵的执行官「女士」大人！"
        },
        {
          "type": "subtitle",
          "text": "与帕拉德对话"
        },
        {
          "type": "subtitle",
          "text": "击败意图夺剑的愚人众"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "阿贝多",
          "text": "听到声音过来一看，居然是你们几个。"
        },
        {
          "role": "阿贝多",
          "text": "怎么回事，你们跟人打架了？"
        },
        {
          "role": "砂糖",
          "text": "阿、阿贝多先生…我不是故意的…"
        },
        {
          "role": "阿贝多",
          "text": "砂糖，你不是在整理资料吗？怎么突然跑到这种地方来了。"
        },
        {
          "role": "阿贝多",
          "text": "而且还在冰天雪地里和这么危险的对手作战…"
        },
        {
          "role": "旅行者",
          "text": "我、我也作战了，对不起…"
        },
        {
          "role": "派蒙",
          "text": "为什么连我也跟着心虚起来了呀…"
        },
        {
          "role": "砂糖",
          "text": "呜啊啊我、我只是…对不起对不起，我就是路过…"
        },
        {
          "role": "阿贝多",
          "text": "唉，我猜，一定又有什么让你感兴趣的东西出现了。"
        },
        {
          "role": "旅行者",
          "text": "我把剑的事告诉砂糖了，抱歉。"
        },
        {
          "role": "阿贝多",
          "text": "你都告诉她了？"
        },
        {
          "role": "派蒙",
          "text": "只是说了剑的属性和来历，没有让她触摸本体！这点意识我们还是有的嘛~"
        },
        {
          "role": "阿贝多",
          "text": "算了，本来也不可能瞒她多久。"
        },
        {
          "role": "阿贝多",
          "text": "砂糖对知识和秘密很有探究精神，确实适合做炼金术研究。"
        },
        {
          "role": "砂糖",
          "text": "啊呜呜…我再也不敢乱惹麻烦了！用我新研究的四倍大种子甜甜花发誓！"
        },
        {
          "role": "阿贝多",
          "text": "我不怕麻烦，只是担心你们的安全。下次千万注意。"
        },
        {
          "role": "阿贝多",
          "text": "对了，那个蹲在那里的冒险家是怎么回事？"
        },
        {
          "role": "砂糖",
          "text": "刚才战斗中我负责保护帕拉德先生，我想，他应该没有受伤。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "冷…冷死我了…"
        },
        {
          "role": "派蒙",
          "text": "好像是在刚才的战斗中着凉了。"
        },
        {
          "role": "砂糖",
          "text": "啊啊，这倒是没想到…是我疏忽了，非常抱歉！"
        },
        {
          "role": "砂糖",
          "text": "阿贝多先生，我去看看他的情况！"
        },
        {
          "role": "阿贝多",
          "text": "嗯。"
        },
        {
          "role": "派蒙",
          "text": "砂糖看起来有些死板，居然是个很有爱心的好孩子呢。"
        },
        {
          "role": "旅行者",
          "text": "不要叫比你大的人孩子哦。"
        },
        {
          "role": "派蒙",
          "text": "说得也是呢。"
        },
        {
          "role": "阿贝多",
          "text": "砂糖这家伙，一不小心就会跑到奇怪的地方去…"
        },
        {
          "role": "旅行者",
          "text": "年轻人都这样。"
        },
        {
          "role": "阿贝多",
          "text": "也是。"
        },
        {
          "role": "旅行者",
          "text": "砂糖不是故意的，请不要生气。"
        },
        {
          "role": "阿贝多",
          "text": "放心吧，我没生气。"
        },
        {
          "role": "派蒙",
          "text": "哎？剑上面好像有什么东西在闪烁呢。"
        },
        {
          "role": "阿贝多",
          "text": "嗯？又有变化…"
        },
        {
          "role": "阿贝多",
          "text": "剑上的力量比之前强大了不少。怎么回事？"
        },
        {
          "role": "旅行者",
          "text": "我们和愚人众发生了战斗。"
        },
        {
          "role": "派蒙",
          "text": "这一带的愚人众士兵里有些我们没见过的狠角色哦。"
        },
        {
          "role": "阿贝多",
          "text": "是之前没有遇到过的力量吗…"
        },
        {
          "role": "阿贝多",
          "text": "所以，剑也大幅成长了。"
        },
        {
          "type": "subtitle",
          "text": "击败急冻树"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "阿贝多",
          "text": "龙的力量…龙的生命力，能让枯死的植物复活到这种地步…"
        },
        {
          "role": "阿贝多",
          "text": "不可思议。"
        },
        {
          "role": "派蒙",
          "text": "还以为是一截枯树桩，没想到是这种怪物呀！"
        },
        {
          "role": "派蒙",
          "text": "差一点就被吞下去了！"
        },
        {
          "role": "派蒙",
          "text": "不过，为什么只有今天发生了这种情况呢？"
        },
        {
          "role": "阿贝多",
          "text": "多半是因为剑落到地上遭受了撞击，导致力量外泄。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "我错了，不要赶我走，千万不要赶我走啊！"
        },
        {
          "role": "冒失的帕拉德",
          "text": "我保证绝不乱动！"
        },
        {
          "role": "砂糖",
          "text": "啊，帕拉德先生…也不用抱着膝盖蹲到地上变成蘑菇呀…"
        },
        {
          "role": "阿贝多",
          "text": "唉。"
        },
        {
          "role": "阿贝多",
          "text": "这棵急冻树会枯死在这种地方，难道是因为它无法吸收被污染过的力量？"
        },
        {
          "role": "阿贝多",
          "text": "旅行者能够净化污秽，净化后的纯净元素力不仅能让它复活，甚至强化了它。"
        },
        {
          "role": "阿贝多",
          "text": "纯粹的生命之力会迫使它不断重生…看来，之后还会有持续不断的战斗。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "发生了比想象中还麻烦的事呀…",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "我也从没遇到过类似事件。"
                }
              ]
            },
            {
              "text": "真没想到，是我太厉害了吗？",
              "dialogues": [
                {
                  "role": "阿贝多",
                  "text": "我也从没遇到过类似事件。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "如此罕见的情况，不得不说，也是一种意外收获。"
        },
        {
          "role": "阿贝多",
          "text": "砂糖。"
        },
        {
          "role": "砂糖",
          "text": "啊、是！"
        },
        {
          "role": "阿贝多",
          "text": "看好那个冒险家，把他送回营地去。"
        },
        {
          "role": "砂糖",
          "text": "好的先生！"
        },
        {
          "role": "阿贝多",
          "text": "至于这里，虽然很不好意思…但还是要麻烦你了，旅行者。"
        },
        {
          "role": "旅行者",
          "text": "我会尽力解决它。"
        },
        {
          "role": "派蒙",
          "text": "预料之外的麻烦事，却只有我们能解决。果然还是因为我们越来越厉害了！"
        }
      ]
    }
  ]
}