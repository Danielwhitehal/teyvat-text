{
  "quest_id": 73206,
  "chapter_num": null,
  "chapter_title": "献给某人的蔷薇·石头能不能开花",
  "type": "wq",
  "route": "A Gifted Rose: Can Stones Bloom",
  "stories": [
    {
      "story_id": 73206,
      "title": "献给某人的蔷薇·石头能不能开花",
      "description": "阿凡的花种依然没有发芽，试着帮助失落的他吧。",
      "dialogues": [
        {
          "role": "阿凡",
          "text": "♪蔷薇啊蔷薇，实现我的愿望…"
        },
        {
          "role": "阿凡",
          "text": "嗯？你们还在啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么住在这里？",
              "dialogues": [
                {
                  "role": "阿凡",
                  "text": "呵呵，反正我是个怪老头，「怪老头做事哪有为什么」，很少有人像你这样问我。"
                },
                {
                  "role": "阿凡",
                  "text": "我啊，这一辈子总想出去闯荡，想抓住机会做点什么。"
                },
                {
                  "role": "阿凡",
                  "text": "刚结婚不久的时候差点儿跟着镀金旅团离开，但想想总觉得不能抛下老婆出去漂泊。"
                },
                {
                  "role": "阿凡",
                  "text": "后来遇到行脚商，我又想跟着出去跑生意，最终因为本钱不够没走成。"
                },
                {
                  "role": "阿凡",
                  "text": "再后来老太婆不在了，我没牵挂了，可是年纪已经太老，没法离开了。"
                },
                {
                  "role": "阿凡",
                  "text": "拖拖拉拉混到今天，我错过的事情太多。"
                },
                {
                  "role": "阿凡",
                  "text": "回过头发现自己不属于这个村子，也不属于其他任何地方。"
                },
                {
                  "role": "阿凡",
                  "text": "最后结果么，就是我一个人搬到村子边上生活才舒服。"
                },
                {
                  "role": "阿凡",
                  "text": "几十年也就这么回事，算了。"
                }
              ]
            },
            {
              "text": "关于鬼老头…",
              "dialogues": [
                {
                  "role": "阿凡",
                  "text": "也就只有外来的人会打听鬼老头的事了，我们村里的小孩可都知道这个名字。"
                },
                {
                  "role": "阿凡",
                  "text": "哪家孩子不听话，孩子的父母就吓唬他：马上鬼老头要来把你抓走了。"
                },
                {
                  "role": "阿凡",
                  "text": "这些年轻人啊，一个都不认识鬼老头，倒挺会把他的名头搬出来吓人。"
                },
                {
                  "role": "阿凡",
                  "text": "我小的时候可是见过鬼老头本人的，他是讨厌小孩子没错，但长得也不恐怖。"
                },
                {
                  "role": "阿凡",
                  "text": "不知道怎么就被传成了鬼老头，我看都是一帮闲人在背后胡说八道。"
                },
                {
                  "role": "旅行者",
                  "text": "你们不是朋友吗？"
                },
                {
                  "role": "阿凡",
                  "text": "我还小的时候，经常溜到他的小花园附近玩，他一发现，就会挥着锄头把我赶走。"
                },
                {
                  "role": "阿凡",
                  "text": "他八成只把我当成去捣乱的调皮小子，哪里会记得我哟。"
                },
                {
                  "role": "阿凡",
                  "text": "虽然他不一定认识我，但我还是一直记得他和他的小花园。"
                },
                {
                  "role": "阿凡",
                  "text": "我说他是我的朋友，也不算错，不是吗？"
                },
                {
                  "role": "阿凡",
                  "text": "就当是为了还原我记忆里的小花园，我也会把这些花种出来的。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿凡",
          "text": "这些花开了我就叫你们来看，明天或者后天，它们说不定就开了，你有空来看吧？"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "阿凡",
          "text": "好好好，我知道了…"
        },
        {
          "role": "阿凡",
          "text": "♪蔷薇啊蔷薇，实现我的愿望…"
        },
        {
          "role": "阿凡",
          "text": "你们来了啊。"
        },
        {
          "role": "旅行者",
          "text": "种子怎么样了？"
        },
        {
          "role": "阿凡",
          "text": "所有的种子都还没有抽芽…"
        },
        {
          "role": "阿凡",
          "text": "我检查过种子表面了，连一点点发芽的迹象都没有。"
        },
        {
          "role": "阿凡",
          "text": "这到底是为什么呢？"
        },
        {
          "role": "阿凡",
          "text": "种子我肯定没认错，它们都是我照着鬼老头的手记从储藏室里翻出来的。"
        },
        {
          "role": "阿凡",
          "text": "按照他的记录，种子的保存时间很长，只要保证干燥，它们就不会坏。"
        },
        {
          "role": "阿凡",
          "text": "栽培方式也不该有问题，该浇的水和该施的肥料我都没有落下，到底为什么呢？"
        },
        {
          "role": "派蒙",
          "text": "别着急呀，阿凡爷爷，再等等看呢？"
        },
        {
          "role": "派蒙",
          "text": "每次我和旅行者去野外摘果子摘花，摘完之后也要等好几天它们才能重新长出来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "耐心点。",
              "dialogues": []
            },
            {
              "text": "继续浇水试试。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿凡",
          "text": "唉，也只能等等看了，你们今天有空吗？能不能再帮我给它们浇点水？"
        },
        {
          "role": "阿凡",
          "text": "我刚给苗圃松土，忙活了好半天，实在没力气跑回去打水了。"
        },
        {
          "role": "旅行者",
          "text": "我明白了。"
        },
        {
          "role": "阿凡",
          "text": "谢谢你们了。"
        },
        {
          "type": "subtitle",
          "text": "给花种浇水"
        },
        {
          "type": "subtitle",
          "text": "和阿凡聊聊"
        },
        {
          "role": "阿凡",
          "text": "水还是要浇，肥还是要施，有没有用…"
        },
        {
          "role": "阿凡",
          "text": "我也不知道了，唉。"
        },
        {
          "role": "阿凡",
          "text": "我糊里糊涂活到今天，终于下定决心要做一件事，结果还是做不成。"
        },
        {
          "role": "阿凡",
          "text": "鬼老头，辜负了你的嘱托，对不起。"
        },
        {
          "role": "派蒙",
          "text": "阿凡爷爷…"
        },
        {
          "role": "阿凡",
          "text": "两个小娃娃，你们去忙吧。"
        },
        {
          "type": "subtitle",
          "text": "（test）给花种浇水"
        },
        {
          "role": "阿凡",
          "text": "难道我真的是在种石头吗？"
        },
        {
          "type": "subtitle",
          "text": "（test）给花种浇水"
        }
      ]
    }
  ]
}