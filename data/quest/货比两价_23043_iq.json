        },
        {
          "role": "阿扎莱",
          "text": "这样就行了，拜托你了，旅行者。"
        },
        {
          "role": "贾汉吉尔",
          "text": "喂，决定了没？要在我这里买的话，我就去开锅了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就在你这里订货了。",
              "dialogues": [
                {
                  "role": "贾汉吉尔",
                  "text": "行！我这就开始做鱼干，做好了之后就雇人送过去。"
                }
              ]
            },
            {
              "text": "我，我去别处看看…",
              "dialogues": [
                {
                  "role": "贾汉吉尔",
                  "text": "欸？都说了，你去别处可找不到味道这么好的鱼干了，你就在我这里买吧…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "向阿扎莱回报"
        },
        {
          "role": "拉玛",
          "text": "欢迎光临！要买些常用的香料吗？价格很实惠哦！"
        },
        {
          "role": "旅行者",
          "text": "关于阿扎莱的订单…"
        },
        {
          "role": "拉玛",
          "text": "欸？阿扎莱拜托你来订货吗？倒是没问题…"
        },
        {
          "role": "拉玛",
          "text": "不过之前他都是拜托镀金旅团的人把货款带来，这次怎么拜托了一个冒险家…"
        },
        {
          "role": "拉玛",
          "text": "咳！这次他有多少货金？我看看…嚯，不少啊。"
        },
        {
          "role": "拉玛",
          "text": "唔，如果在我这里进香料的话，我给他提供的货，应该能足够他卖很长时间了。"
        },
        {
          "role": "拉玛",
          "text": "至于售价嘛…我还是建议和之前一样定的稍微低一些。这样才容易卖出去嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就在你这里订货了。",
              "dialogues": [
                {
                  "role": "拉玛",
                  "text": "喔！谢谢惠顾，等我准备好之后，就雇人把货物运过去。"
