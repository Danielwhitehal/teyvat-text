{
  "quest_id": 75672,
  "chapter_num": null,
  "chapter_title": "斑斓色彩不许逃！",
  "type": "wq",
  "route": "Don't Let the Colors Escape!",
  "stories": [
    {
      "story_id": 75672,
      "title": "斑斓色彩不许逃！",
      "description": "重返悠悠度假村时，你们遇见了一位老朋友，还有一群特别的「阿夏」…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往悠悠度假村"
        },
        {
          "role": "派蒙",
          "text": "这里怎么有个蹦蹦跳跳的阿夏，还有…欸？班尼特？"
        },
        {
          "role": "班尼特",
          "text": "啊，是旅行者和派蒙！又见面了！"
        },
        {
          "role": "活跃的「阿夏」",
          "text": "！"
        },
        {
          "role": "派蒙",
          "text": "班尼特这是又回悠悠度假村来玩了吗？"
        },
        {
          "role": "班尼特",
          "text": "对呀，如果旅行者有印象的话，我之前写信告诉过你们——"
        },
        {
          "role": "班尼特",
          "text": "前几个月，我准备了好久，拿下了不少报酬丰厚的委托，攒够了钱…"
        },
        {
          "role": "班尼特",
          "text": "总算成功邀请老爹们和朋友们，来「悠悠度假村」尽情游玩了一番。"
        },
        {
          "role": "班尼特",
          "text": "老爹们亲眼看见，我在纳塔几乎和倒霉绝缘，一个个都非常感动！"
        },
        {
          "role": "派蒙",
          "text": "对哦，对班尼特来说这么好的事，确实要让大家都知道！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是大好的消息！",
              "dialogues": []
            },
            {
              "text": "我每次听都很高兴！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "要是再早一周遇见你们，说不定，大家还能聚个餐呢…"
        },
        {
          "role": "班尼特",
          "text": "嗯，那就等到你们之后回蒙德了，找个万无一失的地方，好好再吃一顿「安全冒险山洞晚饭」。"
        },
        {
          "role": "派蒙",
          "text": "等等？听班尼特的意思是，现在老爹们和朋友们都回去了，你独自留在度假村了？"
        },
        {
          "role": "班尼特",
          "text": "说来也有点巧，老爹们刚刚玩到尽兴，就得知了一个消息，猫尾酒馆的[[迪奥娜]]小姐之后会出差一段时间…"
        },
        {
          "role": "班尼特",
          "text": "为了多喝几杯特调，他们就没有延长假期，选择按计划准点回了蒙德。"
        },
        {
          "role": "班尼特",
          "text": "不过别担心，我留下的理由，也和意外延误，船票被偷什么的无关，而是碰见了需要帮助的朋友。"
        },
        {
          "role": "班尼特",
          "text": "我们在海边钓鱼的时候，发现了几位被叫做「调色家」的阿夏，它们正在犯难。"
        },
        {
          "role": "班尼特",
          "text": "凭借以前的经验，我大概能理解，它们想要寻找不同凡响的宝物…"
        },
        {
          "role": "派蒙",
          "text": "唔，既然被冠上了「调色家」的头衔，那对它们而言的宝物应该是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "超棒的颜料？",
              "dialogues": []
            },
            {
              "text": "贵重的颜料？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "是的！阿夏们除了到处涂鸦，还喜欢自己寻找颜料，用心收藏。"
        },
        {
          "role": "班尼特",
          "text": "「调色家阿夏」们就在某座秘境里发现了非常特殊的品类…是一种游离的染色成分。"
        },
        {
          "role": "班尼特",
          "text": "那些游离的色彩像晶蝶，会到处乱逃，「调色家」们一时不知该怎么处理…"
        },
        {
          "role": "派蒙",
          "text": "这个好说，我们也来帮忙吧。去秘境里一看就能明白情况了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "阿夏需要帮助，我义不容辞。",
              "dialogues": []
            },
            {
              "text": "收集特别的东西，我们在行。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「调色家阿夏」",
          "text": "！！"
        },
        {
          "role": "班尼特",
          "text": "那可太好了！我们一起来帮「调色家」，你们怎么做，我就跟着照做。"
        },
        {
          "role": "班尼特",
          "text": "希望这些阿夏能收集到最棒的颜料，调出特别漂亮的色彩，继续传递不一样的快乐！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（班尼特）"
        },
        {
          "role": "班尼特",
          "text": "状态怎么样，旅行者？我们继续引导阿夏收集染料？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一起加油吧！",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "好！和你一起冒险，每次都干劲满满！"
                }
              ]
            },
            {
              "text": "还有什么好消息吗？",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "这个呀，让我想想…"
                },
                {
                  "role": "班尼特",
                  "text": "…在纳塔，我的运气实在太好了，所以可以尝试许多以前不敢深入研究的事…"
                },
                {
                  "role": "班尼特",
                  "text": "比如——给自己做一组超合适的冒险护具！护腕护膝绑腿和鞋垫都要有！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "没想到的道具…",
                      "dialogues": []
                    },
                    {
                      "text": "为什么是这个？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "班尼特",
                  "text": "旅行者也要留意哦，冒险的过程中，保护关节和双脚是一等一的大事。"
                },
                {
                  "role": "班尼特",
                  "text": "背着重物爬坡，会对膝盖持续施加压力，通过崎岖的地形时，要防止一脚没踩稳，扭伤脚踝…"
                },
                {
                  "role": "班尼特",
                  "text": "长途步行中，双脚也有可能比双腿先撑不住，需要有效避免疲惫，甚至是无形受伤。"
                },
                {
                  "role": "班尼特",
                  "text": "减震和保护作用都不错的护具，就能在这种时候派上用场。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "这么一说确实有道理。",
                      "dialogues": []
                    },
                    {
                      "text": "平常没怎么注意过。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "班尼特",
                  "text": "长远来看，对自己有利的道具，永远不嫌多嘛！"
                },
                {
                  "role": "班尼特",
                  "text": "也可以听听普通冒险家们许多年来不断试错，总结出的窍门——"
                },
                {
                  "role": "班尼特",
                  "text": "把诸如嘟嘟莲和肉龙掌一类的植物，切成小块后，捣碎在面粉里，放进锅中，加入磐石精油熬煮两天。"
                },
                {
                  "role": "班尼特",
                  "text": "然后倒进模具，放在冰雾花旁边冷却一晚，稍微修修外形，削去不平的地方…"
                },
                {
                  "role": "班尼特",
                  "text": "比须弥的跳跳菇还有弹性的护具，就完工了！据说有了它，一天爬两回图兰大火山，关节和脚底都不会受伤！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "听起来工艺也不复杂？",
                      "dialogues": []
                    },
                    {
                      "text": "虽然我不用这个也能爬好几回…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "班尼特",
                  "text": "哎呀，换在其他地方，我在熬煮的那一环，就会败下阵来。"
                },
                {
                  "role": "班尼特",
                  "text": "要么是锅里混进去不知道什么成分，煮到一半就变质，要么就是整口锅都炸掉，碎片到处乱崩…"
                },
                {
                  "role": "班尼特",
                  "text": "如果我自己去买，尺码合不合适另说，十有八九会买到次品。"
                },
                {
                  "role": "班尼特",
                  "text": "关键，也不是老板有意卖给我劣质货，而是他们自己都没检查出问题…我只能自认倒霉。"
                },
                {
                  "role": "班尼特",
                  "text": "所以以前，我还从没搞到过好用的护具呢，这事说大也不大，说小，也还确实对冒险的体验有影响。"
                },
                {
                  "role": "班尼特",
                  "text": "这次来度假村，我就地取材，总算做出了最满意的作品…"
                },
                {
                  "role": "班尼特",
                  "text": "真是太舒心了…原来踏上好用的鞋垫，戴上弹性正合适的护膝再跑步，是这种感觉！"
                }
              ]
            },
            {
              "text": "附近还有别的朋友吗？",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "这个，如果是说以前打过交道的冒险家朋友，那他们都心满意足，跟着老爹们回去了啦。"
                },
                {
                  "role": "班尼特",
                  "text": "还留在纳塔的，只有和我们同乘一支车队来玩的几位蒙德游客。"
                },
                {
                  "role": "班尼特",
                  "text": "不过，有一位长着角的…摔角手？{{#info:[[瓦雷莎]]}}找了过来，向我询问，有没有见过一个戴帽子的女孩{{#info:[[明妮]]}}…"
                },
                {
                  "role": "班尼特",
                  "text": "听说那位摔角手是「沃陆之邦」重要的战士，之前还在「龙脊雪山越野赛」拿了不错的名次。{{#info:[[炽魂斗士的雪界之旅]]}}"
                },
                {
                  "role": "班尼特",
                  "text": "也许，在我们没注意到的地方，不少蒙德人都和纳塔人交上朋友了？"
                }
              ]
            },
            {
              "text": "待会儿再来。",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "嗯，我们等着你！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（希诺宁&妮佩卡）北方岸边"
        },
        {
          "role": "希诺宁",
          "text": "和[[明妮]]玩得开心吗？差不多可以回去了？"
        },
        {
          "role": "妮佩卡",
          "text": "嗯嗯，我们都尽兴了！"
        },
        {
          "role": "妮佩卡",
          "text": "还有，希诺宁姐姐，我仔细看了明妮给我带来的插画…"
        },
        {
          "role": "妮佩卡",
          "text": "很多张画里都出现了…蒙德的「偶像」？西风教会的[[芭芭拉]]小姐，她跳舞的本领好像很厉害！"
        },
        {
          "role": "妮佩卡",
          "text": "[[玛拉妮]]姐姐不是想要在度假村再举办一次跳舞派对吗？还说要再次试着邀请国外的跳舞高手…"
        },
        {
          "role": "妮佩卡",
          "text": "说不定，玛拉妮姐姐会对这位芭芭拉小姐感兴趣？"
        },
        {
          "role": "希诺宁",
          "text": "有道理哦，那我把这些画也给玛拉妮看看好了…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（瓦雷莎&明妮）西南方小岛岸边"
        },
        {
          "role": "瓦雷莎",
          "text": "明妮明妮，看那只阿夏画出来的涂鸦，像不像打翻了枫达瓶…果汁洒在了烤蘑菇披萨上？"
        },
        {
          "role": "明妮",
          "text": "真的欸！这个比喻太贴切了…"
        },
        {
          "role": "明妮",
          "text": "想吃。"
        },
        {
          "role": "瓦雷莎",
          "text": "我也想…不过，泡泡桔的风味，和蘑菇混合在一起，会不会有点怪？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那要不试试？",
              "dialogues": [
                {
                  "role": "瓦雷莎",
                  "text": "咦？我是不是…蘑菇吃太多，出现幻觉了吗…"
                },
                {
                  "role": "明妮",
                  "text": "不是幻觉哦，的确是旅行者！没想到还能在悠悠度假村见面！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你是叫…明妮来着？",
                      "dialogues": [
                        {
                          "role": "明妮",
                          "text": "还记得我吗？太好了…感觉又得到了莫大的鼓舞…"
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "没错没错，也是我们「炽魂斗士特战队」的首席画师，现在正在创作《炽魂斗士战记》的外传作品。"
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "这次明妮可厉害了，一个人跟着冒险家们的车队来纳塔，出了个超级大远门！"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "那还真是长途跋涉。",
                              "dialogues": []
                            },
                            {
                              "text": "你家里人不担心吗？",
                              "dialogues": []
                            }
                          ]
                        },
                        {
                          "role": "明妮",
                          "text": "没事的，还要多亏旅行者、瓦雷莎和希诺宁姐姐，之前你们说服了我的爸爸妈妈，让他们不再那么苛刻。"
                        },
                        {
                          "role": "明妮",
                          "text": "越野赛过后，我才找到机会，开始帮教会画公益宣传画，给一些书刊提供插图…"
                        },
                        {
                          "role": "明妮",
                          "text": "后来，瓦雷莎把我创作的《炽魂斗士战记》联想故事寄给了八重堂，被著名插画师[[朝雾]]老师看到了。"
                        },
                        {
                          "role": "明妮",
                          "text": "实在太好运了！朝雾老师非常认可我的画功，还给爸爸妈妈写了信。"
                        },
                        {
                          "role": "明妮",
                          "text": "现在，爸爸妈妈也明白，我可以把自己喜爱的绘画当成正经的工作，投入再多时间都值得。"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "还算顺利嘛。",
                              "dialogues": []
                            },
                            {
                              "text": "是个好消息。",
                              "dialogues": []
                            }
                          ]
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "我觉得，明妮可以自信一点，你的画功不是运气带来的，而是你自己每天努力的结果。"
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "就像…我现在还算不错的摔角技巧，也是跟着伊安珊教练一点点练出来的。"
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "朝雾小姐也参与了许多《炽魂斗士》系列作品的插画和漫画，直接和最严格的森子编辑推荐了明妮…"
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "正好，有一部《炽魂斗士战记》的外传作品，很长时间找不到画成漫画的合适画师。"
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "结果明妮做过笔试题后，直接拿到了九十多分，还破了招募的纪录呢！"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "那还真是厉害！",
                              "dialogues": []
                            },
                            {
                              "text": "恭喜喔！",
                              "dialogues": []
                            }
                          ]
                        },
                        {
                          "role": "明妮",
                          "text": "谢…谢谢！"
                        },
                        {
                          "role": "明妮",
                          "text": "但还不是庆祝的时候…我甚至都没拿出过正式的作品，就被选中来画这么一篇很有分量的连载，心里也很没底…"
                        },
                        {
                          "role": "明妮",
                          "text": "我会一边磨砺画技，一边认真完成这部外传的。"
                        },
                        {
                          "role": "明妮",
                          "text": "这次纳塔之行，除了和瓦雷莎、希诺宁姐姐还有妮佩卡见面，也是想尽量领略这里的文化，为作品做好考据！"
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "嘿嘿，最近我在圣火竞技场卖水果的时候，从龙遗物协会那边获得了不少…古物？"
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "总之，我更了解菲耶蒂娜和泰卡在历史上的形象了，甚至是他们龙伙伴和车队的细节！"
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "初稿也可以寄给我哦，我也来给你出建议！"
                        }
                      ]
                    },
                    {
                      "text": "这位是谁，好像没见过？",
                      "dialogues": [
                        {
                          "role": "瓦雷莎",
                          "text": "我简单介绍一下，这位是我们「炽魂斗士特战队」的首席画师明妮，和我一样爱好漫画织卷的朋友。"
                        },
                        {
                          "role": "瓦雷莎",
                          "text": "之前我们一起参加了「龙脊雪山越野赛」，还拿了很不错的名次呢！"
                        },
                        {
                          "role": "瓦雷莎",
