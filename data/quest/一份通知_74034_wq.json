{
  "quest_id": 74034,
  "chapter_num": null,
  "chapter_title": "一份通知",
  "type": "wq",
  "route": "A Certain Notice",
  "stories": [
    {
      "story_id": 74034,
      "title": "一份通知",
      "description": "复律庭的艾尤恩正在勤恳工作…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与加特尼奥对话"
        },
        {
          "role": "加特尼奥",
          "text": "艾尤恩，真是巧遇。今天下班你总有时间和我喝杯咖啡了吧？"
        },
        {
          "role": "艾尤恩",
          "text": "感谢您的好意，但我有一件「秘密事务」来请您处理。"
        },
        {
          "role": "加特尼奥",
          "text": "「秘密事务」？是我知道的事吗？"
        },
        {
          "role": "艾尤恩",
          "text": "我想您应该不知道。今天早上我才接到这文件呢。"
        },
        {
          "role": "加特尼奥",
          "text": "这倒是稀奇，也许是我今天还没来得及看《蒸汽鸟报》的原因，获取消息的速度慢了你一步。"
        },
        {
          "role": "派蒙",
          "text": "明明是秘密事务，为什么你会在《蒸汽鸟报》上看到呀？"
        },
        {
          "role": "加特尼奥",
          "text": "哈哈哈，那些记者传递消息的速度，可比我们复律庭内部传递消息的速度快多了。"
        },
        {
          "role": "加特尼奥",
          "text": "但也可以理解，毕竟他们传递消息可是会拿到报酬的嘛。"
        },
        {
          "role": "派蒙",
          "text": "完，完全无法理解…"
        },
        {
          "role": "艾尤恩",
          "text": "先不谈这些。先生，事情是这样的…"
        },
        {
          "role": "？？？",
          "text": "艾尤恩详细叙述了相关事宜…"
        },
        {
          "role": "加特尼奥",
          "text": "没错，的确有必要下发这样的文件，之前确实出过这样的事。一个白痴为了显摆自己的桌面摆设，拿留影机给自己的桌子留影。"
        },
        {
          "role": "加特尼奥",
          "text": "他是「留影机爱好协会」的一员，还把那张画片拿去给会员们看。"
        },
        {
          "role": "加特尼奥",
          "text": "但会员中的一名记者很快发现，在画片中有一份疑似复律庭内部通讯稿的文件。"
        },
        {
          "role": "加特尼奥",
          "text": "然后，那份抱怨复律庭的内部晚餐除了鱼就是鱼的通讯，第二天就出现在了《蒸汽鸟报》上。"
        },
        {
          "role": "派蒙",
          "text": "这也算是需要保守的秘密吗…"
        },
        {
          "role": "旅行者",
          "text": "听起来好像不是很严重…"
        },
        {
          "role": "加特尼奥",
          "text": "无论如何，这也算得上是内部通讯，于情于理都不该对外泄露。"
        },
        {
          "role": "加特尼奥",
          "text": "枫丹廷的人们可不会放过任何一个嘲笑复律庭的机会，我们必须得谨慎行事。"
        },
        {
          "role": "加特尼奥",
          "text": "即使他们其实根本不关心我们在做什么。他们只是想…呃，笑两声。"
        },
        {
          "role": "艾尤恩",
          "text": "呃，总之…那这份文件就由您的办公室来…"
        },
        {
          "role": "加特尼奥",
          "text": "但有关人员事务规章…迪福尔所在的办公室显然更适合签发这份文件。"
        },
        {
          "role": "加特尼奥",
          "text": "毕竟，在这份文件里，虽然告知所有人保密原则十分重要，但更重要的是，如何告知所有人保密原则。"
        },
        {
          "role": "加特尼奥",
          "text": "要我说，必须得迪福尔来领办，我们办公室可以协办。这样既有效率，又能保密。"
        },
        {
          "role": "？？？",
          "text": "加特尼奥飞快地在文件上的协办方位置上签上了名字…"
        },
        {
          "role": "艾尤恩",
          "text": "但是，加特尼奥先生！这事…"
        },
        {
          "role": "加特尼奥",
          "text": "好啦小伙子，办这种急事可不能拖拖拉拉的。快去找迪福尔吧，不然他的耐心马上就要被日常工作给耗尽了。"
        },
        {
          "role": "加特尼奥",
          "text": "我也得去帮你们找找可用的保密原则了，等到文件正式下发，我们办公室一定全力支持！"
        },
        {
          "role": "加特尼奥",
          "text": "快去找他吧，小伙子！我还得去…呃，处理别的事务。"
        },
        {
          "role": "？？？",
          "text": "加特尼奥大踏步地离开了…"
        },
        {
          "role": "艾尤恩",
          "text": "什么？加特尼奥先生，等等！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "走掉了…",
              "dialogues": []
            },
            {
              "text": "走得真快…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "走掉了…"
        },
        {
          "role": "艾尤恩",
          "text": "您见识到加特尼奥先生的能力了吧？他能把所有事都办理妥当的诀窍，就是从来不办有风险的事。"
        },
        {
          "role": "派蒙",
          "text": "原来是这种推卸责任的能力啊…"
        },
        {
          "role": "艾尤恩",
          "text": "没办法…只能去找迪福尔先生了。咱们这边走。"
        },
        {
          "type": "subtitle",
          "text": "与迪福尔对话"
        },
        {
          "role": "迪福尔",
          "text": "艾尤恩。你找我有什么事吗？气喘吁吁的…"
        },
        {
          "role": "艾尤恩",
          "text": "事情是这样的，迪福尔先生…"
        },
        {
          "role": "？？？",
          "text": "艾尤恩详细叙述了相关事宜…"
        },
        {
          "role": "迪福尔",
          "text": "你找错人了，艾尤恩。你难道没意识到这份文件的重点是「保密」吗？"
        },
        {
          "role": "艾尤恩",
          "text": "我还以为主语是「这份文件」…"
        },
        {
          "role": "旅行者",
          "text": "语法确实如此。"
        },
        {
          "role": "派蒙",
          "text": "喂，现在的重点不是这个吧？"
        },
        {
          "role": "迪福尔",
          "text": "我真欣赏你们的严谨。但这份文件我是不会签的，无论怎么考虑，都应该是加特尼奥来领头。"
        },
        {
          "role": "艾尤恩",
          "text": "加特尼奥先生说，应该由您来领头…"
        },
        {
          "role": "迪福尔",
          "text": "哈！我来？该怎么做，我要拿着喇叭，朝每一位进来上班的人大喊吗？"
        },
        {
          "role": "迪福尔",
          "text": "「嘿！先生女士们，不要把留影机带进办公室，这样会导致泄密！绝对不要做这样的事！」"
        },
        {
          "role": "迪福尔",
          "text": "还是我要去印几百份文件，放在每一位复律庭职员的桌上，让他们拿着去喝咖啡？"
        },
        {
          "role": "迪福尔",
          "text": "我们可不像加特尼奥，能把泄密的人逮住，然后教训他们。我们唯一能做的就是发通知，没人会搭理这些文件。"
        },
        {
          "role": "艾尤恩",
          "text": "但他已经在文件上签了字，您瞧这里…"
        },
        {
          "role": "迪福尔",
          "text": "年轻人，你知道「协办方」是什么意思吗？"
        },
        {
          "role": "艾尤恩",
          "text": "呃…听从调遣的一方？"
        },
        {
          "role": "迪福尔",
          "text": "意思是「至少主要责任不在我」。"
        },
        {
          "role": "迪福尔",
          "text": "我绝不会在这份文件上签字。如果非要我们办公室来领办，那就让马内瓦尔亲自来说吧。"
        },
        {
          "role": "？？？",
          "text": "迪福尔怒气冲冲地离开了…"
        },
        {
          "role": "派蒙",
          "text": "他、他说话的声音好大，根本不敢插话…"
        },
        {
          "role": "艾尤恩",
          "text": "您看，这位先生的脾气就是这么暴躁。"
        },
        {
          "role": "旅行者",
          "text": "那现在怎么办？"
        },
        {
          "role": "艾尤恩",
          "text": "别担心…咱们回去找洛耶茨先生吧。"
        },
        {
          "type": "subtitle",
          "text": "与迪福尔对话"
        },
        {
          "role": "迪福尔",
          "text": "艾尤恩，我猜你今天没有带什么好消息给我。"
        },
        {
          "role": "艾尤恩",
          "text": "先生，这确实不是个好消息。准确来说，这是一个「秘密」消息。"
        },
        {
          "role": "旅行者",
          "text": "确实如此。"
        },
        {
          "role": "迪福尔",
          "text": "非常幽默，艾尤恩。那么这个「秘密」消息到底是什么？"
        },
        {
          "role": "？？？",
          "text": "艾尤恩详细叙述了相关事宜…"
        },
        {
          "role": "迪福尔",
          "text": "这种情况的确有可能出现，毕竟复律庭里的职员对一份文件的密级程度并不敏感。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这种问题也会忽视吗？",
              "dialogues": [
                {
                  "role": "迪福尔",
                  "text": "这都是拜加特尼奥那群人所赐。所有复律庭里来往的文件，都会交由他们审定密级，再做上标记。"
                },
                {
                  "role": "迪福尔",
                  "text": "这制度听起来还算不错。但那群审定密级的人为了省事，无论什么文件，都至少会给一个「秘密」的定级。"
                },
                {
                  "role": "迪福尔",
                  "text": "上周卡尔西去欧庇克莱歌剧院发表了一次演说，谈了谈新歌剧演出的话题。"
                },
                {
                  "role": "艾尤恩",
                  "text": "我记得这件事，演讲过程不长，但有很多人听，而且演讲稿还登上了报纸呢。"
                },
                {
                  "role": "派蒙",
                  "text": "既然已经在大家面前讲过了，那大家也都该知道了呀。大家都知道的事，怎么能算是秘密呢？"
                },
                {
                  "role": "迪福尔",
                  "text": "没错，但就算这样，加特尼奥也非要给它定一个「秘密」。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "也许里面真有重要内容？",
                      "dialogues": []
                    },
                    {
                      "text": "呃…也许他有这么做的理由…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "迪福尔",
                  "text": "才怪呢。他把这篇早就在公众面前演讲过的稿件定成了「秘密」，但却没管那些那份之前的原稿啊！"
                },
                {
                  "role": "迪福尔",
                  "text": "卡尔西自己才不会写演讲稿，整篇稿件都是别人代写的。"
                },
                {
                  "role": "迪福尔",
                  "text": "他做的唯一一处修改，就是把自己的名字签在上面，再改几个无关紧要的形容词。"
                },
                {
                  "role": "迪福尔",
                  "text": "但那些修改前的原稿，就堆在卡尔西的办公室桌子上，没有一个人去管。"
                },
                {
                  "role": "迪福尔",
                  "text": "如果这就是加特尼奥想要保守的秘密，他怎么不把这些文件也定个密级呢？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "这也是一种保密方式。",
                      "dialogues": []
                    },
                    {
                      "text": "说不定是…谨慎起见？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "迪福尔",
                  "text": "得了吧！他们只是想要省点事而已。在加特尼奥看来，保守秘密的最佳方式，就是把所有事都变成秘密。"
                },
                {
                  "role": "迪福尔",
                  "text": "这样，就没人知道到底哪一份才是真正需要保守的秘密了。就连他们自己也不知道。"
                },
                {
                  "role": "艾尤恩",
                  "text": "想要把一杯水藏起来，那最好的方法的确是将它倒入一个湖泊。这样做也没错呀。"
                },
                {
                  "role": "迪福尔",
                  "text": "如果你要藏起来的是一杯枫达呢？你准备把整片湖泊都变成枫达湖吗？"
                },
                {
                  "role": "派蒙",
                  "text": "一片枫达湖…嘿嘿嘿，想要去里面游泳。枫达可好喝了，对吧，旅行者？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "派蒙，重点不在这里。",
                      "dialogues": []
                    },
                    {
                      "text": "等下我们去喝一杯啦。",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "真的？那说好了，不许反悔！"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "艾尤恩",
                  "text": "那么…这份文件…"
                },
                {
                  "role": "迪福尔",
                  "text": "艾尤恩先生，这件事有关人员事宜，你来找我的确没错。"
                },
                {
                  "role": "迪福尔",
                  "text": "但在那之前，你必须得让加特尼奥来审定这件事的密级。就像是之前说的那样…"
                },
                {
                  "role": "迪福尔",
                  "text": "在正式工作之前，我们首先得知道要藏起来的究竟是一杯水还是一杯枫达啊。"
                },
                {
                  "role": "迪福尔",
                  "text": "咱们是同事，我不会为难你。我们办公室绝对会倾力协助办理这件事…"
                },
                {
                  "role": "？？？",
                  "text": "迪福尔拖过文件，慢吞吞地在协办方位置上签上了名字…"
                },
                {
                  "role": "迪福尔",
                  "text": "好了，快去找加特尼奥吧！这么大的人员事宜，我要去提前知会几个人才行…"
                },
                {
                  "role": "艾尤恩",
                  "text": "迪福尔先生，但是…"
                }
              ]
            },
            {
              "text": "没有人告诉他们这个…「密级」吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "迪福尔头也不回地离开了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "走掉了…",
              "dialogues": []
            },
            {
              "text": "走得真快…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾尤恩",
          "text": "唉，这就是迪福尔先生，暴躁又精明…"
        },
        {
          "role": "艾尤恩",
          "text": "没办法了，我们去找加特尼奥吧，咱们这边走。"
        },
        {
          "type": "subtitle",
          "text": "与加特尼奥对话"
        },
        {
          "role": "加特尼奥",
          "text": "艾尤恩！好小伙子，我竟然会在这遇见你。"
        },
        {
          "role": "艾尤恩",
          "text": "加特尼奥先生，我正在找你。有一个消息我得让你知道…"
        },
        {
          "role": "加特尼奥",
          "text": "什么消息？我刚看完了今天的《蒸汽鸟报》，上面没有提到复律庭啊。"
        },
        {
          "role": "艾尤恩",
          "text": "是的，这个消息事关保密。"
        },
        {
          "role": "加特尼奥",
          "text": "喔，那倒真是稀奇。除了记者之外，居然还有人能分辨出一件事是否有关保密。"
        },
        {
          "role": "？？？",
          "text": "艾尤恩详细叙述了相关事宜…"
        },
        {
          "role": "加特尼奥",
          "text": "哎哟，迪福尔先生简直就是一位勤勉的记者，他就差直接冲来我的办公室，质问我这份文件的保密性了。"
        },
        {
          "role": "加特尼奥",
          "text": "我完全同意他的观点。这件事确实得先确定密级，但「留影机泄密」事关重大，可能牵涉整个复律庭。"
        },
        {
          "role": "加特尼奥",
          "text": "我一个办公室无法为其定级，必须得送去给其他几位先生审定，让他们全部都知悉才行。比如…卡尔西先生。"
        },
        {
          "role": "艾尤恩",
          "text": "欸？但这份文件就是卡尔西先生发下来的…"
        },
        {
          "role": "加特尼奥",
          "text": "那就更应该让他知道我们后续的处理方案了。来吧年轻人，我们先去找洛耶茨，然后再去见卡尔西先生。"
        },
        {
          "role": "艾尤恩",
          "text": "什么？等等！加特尼奥先生！"
        },
        {
          "type": "subtitle",
          "text": "与洛耶茨对话"
        },
        {
          "role": "迪福尔",
          "text": "这是保密事件，理应由你们办公室来领头。"
        },
        {
          "role": "加特尼奥",
          "text": "那照你这么说，那以后我们经办的事件，即使和人员事宜相关，也不用让你们知悉了？"
        },
        {
          "role": "迪福尔",
          "text": "别偷换概念了，这俩不是一件事！"
        },
        {
          "role": "加特尼奥",
          "text": "这俩究竟是不是一件事，轮不到你我说了算。"
        },
        {
          "role": "艾尤恩",
          "text": "事情…又被我办砸了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好可怕…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "旅行者，不然…不然我们先出去吧，大人们吵架好可怕…"
                },
                {
                  "role": "洛耶茨",
                  "text": "先生们，先生们！冷静，冷静下来！别为了这么点小事坏和气！"
                },
                {
                  "role": "加特尼奥",
                  "text": "这可不是一件小事，洛耶茨先生，这可是牵扯到整个复律庭的大事啊。这件事我可不敢独断。"
                },
                {
                  "role": "迪福尔",
                  "text": "的确如此，毕竟保密无小事。我看整个复律庭除了加特尼奥之外，也没有其他办公室适合主导了。"
                },
                {
                  "role": "洛耶茨",
                  "text": "放轻松，为什么二位一定要争论谁来主导呢？依我看，这件事压根就不需要人来「主导」啊，就连协办也不用。"
                },
                {
                  "role": "旅行者",
                  "text": "什么？"
                },
                {
                  "role": "艾尤恩",
                  "text": "欸？"
                },
                {
                  "role": "加特尼奥",
                  "text": "我没明白您的意思，洛耶茨先生。"
                },
                {
                  "role": "迪福尔",
                  "text": "我没跟上您的思路，洛耶茨先生。"
                },
                {
                  "role": "洛耶茨",
                  "text": "二位都是经验丰富的人，对于一件复杂的事务，我们首先要做的当然是把它划分成简单的事。"
                },
                {
                  "role": "洛耶茨",
                  "text": "防止有人用留影机泄密这件事，理应由加特尼奥先生负责。"
                },
                {
                  "role": "洛耶茨",
                  "text": "但您不需要额外做什么工作，就和往常一样，去逮住那些泄密的人就行。"
                },
                {
                  "role": "洛耶茨",
                  "text": "让所有人知道留影机不能带进复律庭是件麻烦事，整个复律庭我想也只有迪福尔先生能厘清。"
                },
                {
                  "role": "迪福尔",
                  "text": "我们可没有强制执行的能力，没人听我们的！"
                },
                {
                  "role": "洛耶茨",
                  "text": "唉，您不用操心这件事。强制执行就交给加特尼奥先生吧，您要负责的不是「通知」，而是「倡议」。"
                },
                {
                  "role": "洛耶茨",
                  "text": "把这份「倡议」印得越大越好，就贴在复律庭的门口，下面再附上用留影机泄密的案例，这样就好了。"
                },
                {
                  "role": "派蒙",
                  "text": "听起来，好像和之前说的一模一样呀…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "我没明白…",
                      "dialogues": []
                    },
                    {
                      "text": "这么做和之前有什么不同吗？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "艾尤恩",
                  "text": "我…我没明白，洛耶茨先生，这样做…"
                },
                {
                  "role": "加特尼奥",
                  "text": "我同意这个方案，非常好，干净利落。"
                },
                {
                  "role": "艾尤恩",
                  "text": "什，什么？"
                },
                {
                  "role": "迪福尔",
                  "text": "倡议书？哈，这件事倒是不难。"
                },
                {
                  "role": "洛耶茨",
                  "text": "那么我们就达成共识了，等艾尤恩重新起草文件后，会拿去请二位再看一遍。现在嘛…咱们先各自回去干活吧。"
                },
                {
                  "role": "？？？",
                  "text": "加特尼奥和迪福尔互相对视了一眼，转身各自离去了…"
                },
                {
                  "role": "艾尤恩",
                  "text": "我很抱歉，洛耶茨先生，我把这件事给办砸了。"
                },
                {
                  "role": "洛耶茨",
                  "text": "别这么自责，这不是你的错，艾尤恩。至少不全是。"
                },
                {
                  "role": "旅行者",
                  "text": "他们怎么突然接受这个方案了？"
                },
                {
                  "role": "艾尤恩",
                  "text": "我不能理解…完全不能理解。"
                },
                {
                  "role": "派蒙",
                  "text": "对呀，为什么他们一下子就不吵架了？明明刚才一副要打起来的样子…"
                },
                {
                  "role": "洛耶茨",
                  "text": "那是因为你不知道这二位先生究竟最在意什么。难道他们真的仅仅是不想担负额外的工作吗？"
                },
                {
                  "role": "洛耶茨",
                  "text": "当然不是，他们只是不想让其他的部门参与自己的工作，而且还是自己担负主要责任。"
                },
                {
                  "role": "洛耶茨",
                  "text": "只要解决了这个问题，他们就不会那么不满，也愿意开始工作了。"
                },
                {
                  "role": "艾尤恩",
                  "text": "但…您刚才说的那种方案，他们依然要担起责任啊。"
                },
                {
                  "role": "洛耶茨",
                  "text": "加特尼奥和迪福尔是经验丰富的职员，他们深知一个事实…"
                },
                {
                  "role": "洛耶茨",
                  "text": "在复律庭这个庞大的体系里，每个人都必须要背点责任，这样才能让各种事务运转下去。"
                },
                {
                  "role": "洛耶茨",
                  "text": "责任的大小可以再商议，但每个人都必须参与其中。如果有人拒绝这么做…那他最好祈祷自己将来别遇见什么麻烦。"
                },
                {
                  "role": "洛耶茨",
                  "text": "别想这么多，艾尤恩，你将来会理解这些事的。现在你要做的，就是快点去重写一份「倡议」，然后拿给我看，好吗？"
                },
                {
                  "role": "艾尤恩",
                  "text": "好的，洛耶茨先生…"
                }
              ]
            },
            {
              "text": "吵起来了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "洛耶茨急匆匆地离开了…"
        },
        {
          "role": "艾尤恩",
          "text": "唉，又要熬夜了，我得先去买杯咖啡…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你经常熬夜吗？",
              "dialogues": [
                {
                  "role": "艾尤恩",
                  "text": "不能说是经常熬夜，只能说…我都习惯熬夜了。"
                },
                {
                  "role": "艾尤恩",
                  "text": "但无论如何，只要工作能够完成就好…"
                }
              ]
            },
            {
              "text": "还是健康要紧。",
              "dialogues": [
                {
                  "role": "艾尤恩",
                  "text": "这我也知道。但是…算了，没什么但是。"
                }
              ]
            }
          ]
        },
        {
          "role": "艾尤恩",
          "text": "唉，有时候我也会想，我做的这些工作真的有意义吗？"
        },
        {
          "role": "艾尤恩",
          "text": "成天都是敲打字机、做文件、唠唠叨叨、上传下达。"
        },
        {
          "role": "艾尤恩",
          "text": "旅行者，你作为一个…客观的旁观者，有什么想法吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我暂时不知道…",
              "dialogues": []
            },
            {
              "text": "我得再看看。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾尤恩",
          "text": "好吧。也许您再多观察观察后，能给我一个答案。"
        },
        {
          "role": "艾尤恩",
          "text": "如果您有兴趣的话，可以明天来这里再找我聊聊。"
        },
        {
          "role": "艾尤恩",
          "text": "作为一个复律官，我已经彻底迷失在工作的海洋里了。"
        },
        {
          "role": "艾尤恩",
          "text": "也许您作为一个客观的旁观者，能告诉我…这份工作的意义何在。"
        }
      ]
    }
  ]
