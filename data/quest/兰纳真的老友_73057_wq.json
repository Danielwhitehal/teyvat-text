{
  "quest_id": 73057,
  "chapter_num": null,
  "chapter_title": "兰纳真的老友",
  "type": "wq",
  "route": "Aranakin's Old Friend",
  "stories": [
    {
      "story_id": 73057,
      "title": "兰纳真的老友",
      "description": "在上次冒险结束后，兰纳真忘记了许多事情。但不管怎样，曾结识的新朋与旧友何尝那么容易忘怀呢？",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "欸，你听到了吗…有歌声呢。"
        },
        {
          "role": "派蒙",
          "text": "是兰纳真的歌，没错的！"
        },
        {
          "role": "派蒙",
          "text": "哈，果然是兰纳真！我们去跟他打个招呼吧！"
        },
        {
          "role": "派蒙",
          "text": "唔，不见了…也是呢，他不记得我们曾经一起冒险了呀。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不要灰心。",
              "dialogues": []
            },
            {
              "text": "我们还可以重新交朋友的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，你说得对…唔，对哦！"
        },
        {
          "role": "派蒙",
          "text": "上次兰纳真不是教给过我们一首曲子吗！我们弹奏一下，说不定他能认出来呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你说的很有道理。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘿嘿，因为我是派蒙！"
                }
              ]
            },
            {
              "text": "难得有用的提议呢…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你也太欺负人啦！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "弹奏兰纳真的曲调"
        },
        {
          "type": "subtitle",
          "text": "和兰纳真对话"
        },
        {
          "role": "派蒙",
          "text": "哈哈，他来啦！你好呀，小东西！"
        },
        {
          "role": "兰纳真",
          "text": "兰纳真不是小东西！你这个飞飞的白家伙才是小东西！"
        },
        {
          "role": "兰纳真",
          "text": "…话说回来，金色的「沙」…那菈，你们为什么会弹这首曲子呀？"
        },
        {
          "role": "派蒙",
          "text": "这个嘛…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是你教给我们的。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对呀，这首曲子是我们上一次在一起冒险时，你教给我们的呀！"
                }
              ]
            },
            {
              "text": "为了见到你，我专门弹了这首曲子。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘿嘿，旅行者弹得怎么样？我们还记得你教的曲谱哦！"
                }
              ]
            }
          ]
        },
        {
          "role": "兰纳真",
          "text": "这样…吗？哼，兰纳真不聪明，但你们看起来不像「沙子」。"
        },
        {
          "role": "派蒙",
          "text": "嗯！「沙子」是「巴螺迦」，是坏蛋那菈。而我们呢，是好那菈！你告诉我们的嘛！"
        },
        {
          "role": "兰纳真",
          "text": "欸！我还和你们说过这些吗？"
        },
        {
          "role": "派蒙",
          "text": "哈哈，对呀！旅行者，我们把之前的故事再给他讲一遍吧！"
        },
        {
          "type": "subtitle",
          "text": "你们为兰纳真复述了一同冒险，最终平息「死域」的经历。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "兰纳真",
          "text": "…这样啊。"
        },
        {
          "role": "兰纳真",
          "text": "兰纳真不聪明，但你们说的，应该是真的。兰纳真不记得了，对不起。"
        },
        {
          "role": "派蒙",
          "text": "没有必要对不起呀！唔，记不得事情很正常啦…况且，我们还可以重新交朋友呀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "兰纳真是个好孩子呢。",
              "dialogues": []
            },
            {
              "text": "派蒙是个好孩子。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘿嘿，那还用说！"
                }
              ]
            }
          ]
        },
        {
          "role": "兰纳真",
          "text": "唔…既然是好伙伴，那就请跟我来吧！"
        },
        {
          "role": "派蒙",
          "text": "欸？可是…"
        },
        {
          "role": "兰纳真",
          "text": "金色的那菈，白色的飞飞！来我的住处吧，跟我来！"
        },
        {
          "type": "subtitle",
          "text": "到达兰纳真身旁"
        },
        {
          "type": "subtitle",
          "text": "跟随兰纳真"
        },
        {
          "role": "兰纳真",
          "text": "嘿嘿，就是那边啦。"
        },
        {
          "role": "兰纳真",
          "text": "那棵大树是我居住的地方，但最初住在那里的不是我，也不是别的兰那罗。"
        },
        {
          "role": "兰纳真",
          "text": "大树里面，原来是一个那菈的家。兰纳真以前可能认识他，可能帮助过他，或者被他帮助过…"
        },
        {
          "role": "兰纳真",
          "text": "但兰纳真记不得了，就像兰纳真也记不得你们了一样。"
        },
        {
          "role": "兰纳真",
          "text": "对了，那菈的乐器，我还保留着。我应该也把我的歌教给过他，但他没有像你一样回来…"
        },
        {
          "role": "兰纳真",
          "text": "有一天，他也会回来的，对吧？就像你们一样，即使我忘记了他的名字…"
        },
        {
          "type": "subtitle",
          "text": "和兰纳真对话"
        },
        {
          "role": "兰纳真",
          "text": "我们到啦！这里就是啦！"
        },
        {
          "role": "兰纳真",
          "text": "这里是我的住处，请在这里休息吧！"
        },
        {
          "type": "subtitle",
          "text": "调查树屋"
        },
        {
          "type": "subtitle",
          "text": "调查琴",
          "narration": true
        },
        {
          "role": "兰纳真",
          "text": "这是那菈的琴，兰纳真一直留着。但它应该唱不出歌来了…上面的弦已经走调了。"
        },
        {
          "role": "古旧的乌德琴",
          "text": "（一柄古旧的乌德琴，其上有几处断裂的痕迹，但看起来被修补和保存得很妥善。）"
        },
        {
          "type": "subtitle",
          "text": "调查床",
          "narration": true
        },
        {
          "role": "兰纳真",
          "text": "那菈的…嗯，那个叫什么？兰纳真不需要这个睡觉，所以不知道这个词…"
        },
        {
          "role": "派蒙",
          "text": "是「床」，看起来还很新呢…之前有人在这里睡过吗？"
        },
        {
          "role": "兰纳真",
          "text": "嘿嘿，兰纳真一直在整理…你们想要在这里睡觉，也是可以的哦！"
        },
        {
          "type": "subtitle",
          "text": "和兰纳真对话"
        },
        {
          "role": "兰纳真",
          "text": "楼上还有那菈留下的叶子，但是…我看不懂，看不明白…"
        },
        {
          "role": "兰纳真",
          "text": "那个是…那菈用来留下记忆的叶子，在这样的叶子上面写下文字，收拢在一起。但那菈的文字，兰纳真不明白。"
        },
        {
          "role": "派蒙",
          "text": "你是不是说…「记事本」呀？"
        },
        {
          "role": "兰纳真",
          "text": "「记事本」…？那就是那菈用来留下记忆的东西吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯，是呀…兰纳真介意我们上楼去，一起看看里面写了什么吗？"
        },
        {
          "role": "兰纳真",
          "text": "我吗？不介意的！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（兰纳真）"
        },
        {
          "role": "兰纳真",
          "text": "发现什么有意思的东西，就跟我说吧！"
        },
        {
          "type": "subtitle",
          "text": "阅读树屋二楼的笔记"
        },
        {
          "role": "古旧的记事本",
          "text": "「…修好了被巴克尔伯伯摔坏的乌德琴，请不要自己一个人哭了，好吗？不开心的话，就同我和海亚姆讲吧…」"
        },
        {
          "role": "古旧的记事本",
          "text": "「…我被教令院录取了，恭喜我吧！我才不要当什么『战士的新娘』，我将来要做的是『大贤者熙蔓』！」"
        },
        {
          "role": "古旧的记事本",
          "text": "「…嘿嘿，『大乐师』伊尔凡和聪明鬼海亚姆！分别了可不要忘记我呀！尤其是你，海亚姆，不要忘了我！」"
        },
        {
          "role": "古旧的记事本",
          "text": "「…再会，记事本！再会，伊尔凡，熙蔓，我最好的朋友！愿森林永远记得我们的故事，希望我们记得对方…」"
        },
        {
          "role": "古旧的记事本",
          "text": "（…接下来的内容杂乱而热闹，充满了孩子们快乐与悲伤的回忆…）"
        },
        {
          "role": "古旧的记事本",
          "text": "「…兰纳真不见了，不知从什么时候，不见了。我也是时候告别乌德琴了，做个匠人吧，像父亲期望的那样…」"
        },
        {
          "role": "古旧的记事本",
          "text": "（下面似乎还写了什么内容，但都被划去涂黑了。）"
        },
        {
          "role": "古旧的记事本",
          "text": "「…正在阅读这个记事本的，多年以后的我，如果还能奇迹般地遇见兰纳真他们，就请把这朵花送还给他吧…」"
        },
        {
          "role": "派蒙",
          "text": "欸…好像有什么从书里掉出来了！"
        },
        {
          "role": "派蒙",
          "text": "好像是…一朵花？和我们拿到的…一样呢。"
        },
        {
          "type": "subtitle",
          "text": "和兰纳真对话"
        },
        {
          "role": "兰纳真",
          "text": "里面有什么样的记忆呢？你们看到什么了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "记事本的主人似乎认识你。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰纳真",
          "text": "这样吗…我不记得了呀…"
        },
        {
          "role": "派蒙",
          "text": "他说…他也看不见你了，是因为长大了吧…"
        },
        {
          "role": "派蒙",
          "text": "唔…长大还真是会有很多苦恼呢。"
        },
        {
          "role": "派蒙",
          "text": "对了，他还在记事本里说…这朵花留给你！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在这里。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰纳真",
          "text": "咦…？呀！这是很重要的花！你怎么会…他怎么会有的？"
        },
        {
          "role": "派蒙",
          "text": "同样的花，其实你也给过我们哦…只是你不记得了。"
        },
        {
          "role": "兰纳真",
          "text": "这样吗…我能和你们重新做朋友。可是…他的话，我连他的样子都记不得了…"
        },
        {
          "role": "派蒙",
          "text": "没、没关系啦…你不要伤心呀，我们还有这朵花，一定能给你更多回忆的，对吧？"
        },
        {
          "role": "兰纳真",
          "text": "嗯，白飞飞说得对。"
        },
        {
          "role": "兰纳真",
          "text": "我要把这朵花带回去，「无郁夷摩」应该知道怎样才能让她醒来。"
        },
        {
          "role": "兰纳真",
          "text": "唔…那菈旅行者和白飞飞，我要回兰纳迦那边了，把她种下，听她的歌。如果你们有空的话，也请来吧！"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，一定！"
        }
      ],
      "collapse_ranges": [
        [
          53,
          54
        ]
      ]
    }
  ]
}