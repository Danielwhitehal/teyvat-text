{
  "quest_id": 70651,
  "chapter_num": null,
  "chapter_title": "采矿之道",
  "type": "wq",
  "route": "Mine Craft",
  "stories": [
    {
      "story_id": 70651,
      "title": "采矿之道",
      "description": "在野外采集矿石不是一件容易的事…也许，蒙德城的铁匠瓦格纳先生会知道一些关于采集矿石的诀窍…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与瓦格纳对话"
        },
        {
          "role": "瓦格纳",
          "text": "唔，矿石好像有点不够用了…"
        },
        {
          "role": "旅行者",
          "text": "关于采集矿石…"
        },
        {
          "role": "瓦格纳",
          "text": "矿石？你是要锻造什么东西吗？是武器，还是铠甲？"
        },
        {
          "role": "瓦格纳",
          "text": "你如果想要采集矿石的话，我倒是知道哪里采比较方便。"
        },
        {
          "role": "瓦格纳",
          "text": "但矿石也分很多种，有最常用的铁块，用起来还算顺手的白铁块，品质还不错的水晶块…"
        },
        {
          "role": "瓦格纳",
          "text": "还有一种叫做魔晶块的矿物，品质很不错，能够锻造出很优质的东西。"
        },
        {
          "role": "瓦格纳",
          "text": "不过魔晶块很难加工，如果想要用它做锻造材料的话，还要用不少其他材料来辅助。"
        },
        {
          "role": "瓦格纳",
          "text": "不过，我刚从野外回来，好像矿物都被采集过了，现在你想采矿的话，估计采不到什么了…"
        },
        {
          "role": "瓦格纳",
          "text": "唔…这样好了，你过段时间再来找我吧，到时候我再把我知道的矿物位置帮你标在地图上。"
        }
      ]
    }
  ]
}