{
  "quest_id": 75069,
  "chapter_num": null,
  "chapter_title": "扭曲的延伸",
  "type": "wq",
  "route": "Twisted Extension",
  "stories": [
    {
      "story_id": 75069,
      "title": "扭曲的延伸",
      "description": "",
      "dialogues": [
        {
          "role": "夸恩因",
          "text": "啊呀，这里，很少有人来呢…因为毕竟是，危险的地方。"
        },
        {
          "role": "夸恩因",
          "text": "难道你也是冒险团的人吗…哼，听说黑色巨蛇的影子自天蛇船降临…你也要小心啊。"
        },
        {
          "role": "夸恩因",
          "text": "或者，不如早点离开吧，冒险团里，哈，也藏着非人之物啊…那些声音，咒骂，好吵闹…"
        },
        {
          "role": "夸恩因",
          "text": "在这里反而能平静一点，因为瀑布，呵呵…因为瀑布的声音充斥了耳朵，所以，就听不见别的东西了。"
        },
        {
          "role": "夸恩因的日记",
          "text": "（破碎的纸张，一开始，写着整齐的文字…）"
        },
        {
          "role": "夸恩因的日记",
          "text": "「…深渊的魔物变得越来越多，这都是可预见的…冒险团最终还是失败了，撤退的计划正在进行。」"
        },
        {
          "role": "夸恩因的日记",
          "text": "「必须得，让剩下的人安全撤离，得小心防备那些突然在夜晚消失的，或是那些自无光之处重新归来的人。」"
        },
        {
          "role": "夸恩因的日记",
          "text": "「…那些深渊的魔物出现得越来越多，据点或许也会被发现，但是得在那之前…」"
        },
        {
          "role": "夸恩因的日记",
          "text": "（下面的字开始变得歪歪扭扭起来…）"
        },
        {
          "role": "夸恩因的日记",
          "text": "「啊，好冷…好冷，在那里，在那里，血也流空了…」"
        },
        {
          "role": "夸恩因的日记",
          "text": "「瀑布声音，好大，对，这样就好。只要这样…只要在瀑布底下，在那里就会安静了，白色的脸，张开的嘴巴，流光的血…」"
        },
        {
          "role": "夸恩因的日记",
          "text": "「就在那里，在…那里，有什么东西…有什么在…」"
        },
        {
          "role": "夸恩因的日记",
          "text": "「在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下在瀑布底下…」"
        },
        {
          "type": "subtitle",
          "text": "探索瀑布之底"
        },
        {
          "type": "subtitle",
          "text": "打碎奇怪的石块"
        },
        {
          "type": "subtitle",
          "text": "调查瀑布之下的空间"
        },
        {
          "type": "subtitle",
          "text": "查看部族人的遗体"
        },
        {
          "role": "冰冷的身躯",
          "text": "（形如夸恩因的冰冷的身躯，不知为何身躯未能腐化，而是保持着这样的状态…）"
        },
        {
          "role": "冰冷的身躯",
          "text": "（而且，从周围的环境看，保持着这样的状态，已经有许久的时间了…）"
        },
        {
          "type": "subtitle",
          "text": "追寻声音的来源"
        },
        {
          "type": "subtitle",
          "text": "击败看似夸恩因之物"
        }
      ]
    }
  ]
}