{
  "quest_id": 71677,
  "chapter_num": null,
  "chapter_title": "符箓弹幕万花筒",
  "type": "wq",
  "route": "Sigil Barrage Kaleidoscope",
  "stories": [
    {
      "story_id": 71677,
      "title": "符箓弹幕万花筒",
      "description": "美食街上，一位方士的助手正在推广她们的新玩具…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与方士的助手们对话"
        },
        {
          "role": "文寻",
          "text": "你晕吗，墨忘？我现在感觉天旋地转…"
        },
        {
          "role": "文寻",
          "text": "虽然玩起来确实有趣，但后劲也挺大的，还要再改进一下啊。"
        },
        {
          "role": "墨忘",
          "text": "咦？我完全没事，之前的其他客人也还好哇。"
        },
        {
          "role": "墨忘",
          "text": "难道是万花筒里的荧光物质太多了？还是文寻姐你不适应这种…立体影像？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "玩什么呢？",
              "dialogues": []
            },
            {
              "text": "给我看看？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "万花筒嘛，是放在眼前，就能看见漂亮图像的机关。"
        },
        {
          "role": "派蒙",
          "text": "做工精致的万花筒可贵了呢，有的要好几万摩拉！"
        },
        {
          "role": "文寻",
          "text": "不止如此哦，这个万花筒是墨忘妹妹特别设计的，里面藏着很多精巧的图像机关。"
        },
        {
          "role": "文寻",
          "text": "旋转万花筒的轮轴，就能游玩一种奇特的弹幕游艺，主题还很特别，墨忘妹妹来介绍一下？"
        },
        {
          "role": "墨忘",
          "text": "嗯嗯，我平时经常帮方士们打杂，总觉得方士们默默付出这么久，却没什么人知道他们的事迹…"
        },
        {
          "role": "墨忘",
          "text": "一直这样下去，我都替他们觉得可惜。"
        },
        {
          "role": "墨忘",
          "text": "所以我就改进了这个万花筒，简单描绘了他们运用符箓击败妖魔的情景。"
        },
        {
          "role": "墨忘",
          "text": "希望大家玩过以后，对方士们的事迹产生兴趣…"
        },
        {
          "role": "墨忘",
          "text": "长此以往，说不定会有人愿意为方士们提供支援呢？哪怕只有一点点，也算是帮上忙了。"
        },
        {
          "role": "派蒙",
          "text": "居然还有这么长远的用意…我都要肃然起敬了！"
        },
        {
          "role": "墨忘",
          "text": "当然，游艺本身最重要的是玩得开心，如果游艺本身没意思，一切都是空谈。"
        },
        {
          "role": "墨忘",
          "text": "在万花筒的操作机制和游艺的设计上，我们还算是下了大功夫的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就让我来检验有趣程度。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，也可以给点反馈，毕竟最后是为方士们好嘛。"
                }
              ]
            },
            {
              "text": "为了方士们，来试玩一下吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "也让我们检验一下这个游戏够不够有趣。"
                }
              ]
            }
          ]
        },
        {
          "role": "文寻",
          "text": "欢迎欢迎，有什么意见都请直说哦，我和墨忘马上着手改进！"
        },
        {
          "role": "墨忘",
          "text": "希望，希望你们不要感到眼花或眩晕…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（文寻）"
        },
        {
          "role": "文寻",
          "text": "想玩「符箓灵弹巧阵」吗？随时可以开始哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就玩玩看吧。",
              "dialogues": [
                {
                  "role": "文寻",
                  "text": "好，希望你也能享受其中的乐趣~"
                }
              ]
            },
            {
              "text": "你还管理过别的游艺吗？",
              "dialogues": [
                {
                  "role": "文寻",
                  "text": "有的有的，以前我还跟着应公师傅学过「纸映剧」，制作了一种「剪纸戏」。"
                },
                {
                  "role": "文寻",
                  "text": "有一届海灯节上，这种「剪纸戏」还收获了不错的评价呢。"
                },
                {
                  "role": "文寻",
                  "text": "墨忘就是当时的游客之一，说是受到了我的「剪纸戏」启发，才想到制作这种游艺万花筒…"
                },
                {
                  "role": "文寻",
                  "text": "其实除了用到一些形成图像的小纸片，她的设计基本是全新的思路，她大可以自信一点。"
                },
                {
                  "role": "文寻",
                  "text": "以后，这种万花筒游艺大有前途啊！"
                }
              ]
            },
            {
              "text": "还有别的事…",
              "dialogues": [
                {
                  "role": "文寻",
                  "text": "请先忙吧，有空可以回这边来休息一下哦。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（墨忘）"
        },
        {
          "role": "墨忘",
          "text": "要是灵弹之类的光源亮度太高，就要修改底部的照口的光通量…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是专门的方士助手吗？",
              "dialogues": [
                {
                  "role": "墨忘",
                  "text": "不算吧，应该说是兼职。"
                },
                {
                  "role": "墨忘",
                  "text": "我本来是商船上的器械维护师，喜欢捣鼓各种装置，也算有点「专业经验」。"
                },
                {
                  "role": "墨忘",
                  "text": "不过，我始终记得，我成年当天，父亲很晚才回到家里，全身打满了绷带和药膏…\""
                },
                {
                  "role": "墨忘",
                  "text": "一问才知道，原来父亲想去山林里找些竹笋，给我做些新鲜菜式，不巧在路上遭遇了妖邪的袭击…"
                },
                {
                  "role": "墨忘",
                  "text": "还好有位叫[[重云]]的方士出手相助，救下了父亲，不然我都不知道生活要怎么继续下去了…"
                },
                {
                  "role": "墨忘",
                  "text": "从那以后，我才了解到，原来璃月有方士这么一个默默付出的群体。"
                },
                {
                  "role": "墨忘",
                  "text": "然后，我发现，自己慢慢能帮上忙了，于是就开始支援一些有需要的方士。"
                },
                {
                  "role": "墨忘",
                  "text": "真要算账的话，的确没什么钱财上的收益，但我想，斩除妖邪，让所有人平平安安…"
                },
                {
                  "role": "墨忘",
                  "text": "这件事的价值，不能用钱币的多少来衡量。"
                }
              ]
            },
            {
              "text": "加油哦，不打扰了。",
              "dialogues": [
                {
                  "role": "墨忘",
                  "text": "谢谢，也希望你玩得开心！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          21,
          23
        ],
        [
          24,
          26
        ]
      ]
    }
  ]
}