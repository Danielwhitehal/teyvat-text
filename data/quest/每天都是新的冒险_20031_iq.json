{
  "quest_id": 20031,
  "chapter_num": null,
  "chapter_title": "每天都是新的冒险",
  "type": "iq",
  "route": "Every Day a New Adventure",
  "stories": [
    {
      "story_id": 20031,
      "title": "每天都是新的冒险",
      "description": "冒险家协会的凯瑟琳似乎有新的委托想拜托你。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与凯瑟琳对话"
        },
        {
          "role": "凯瑟琳",
          "text": "我们又见面了，冒险家新星。"
        },
        {
          "role": "凯瑟琳",
          "text": "怎么样，最近的冒险还顺利吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很顺利。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "很不错的气势，记得一直保持下去哦。"
                }
              ]
            },
            {
              "text": "有点吃力。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "刚开始是会这样的，在冒险前做好准备会让你轻松不少。"
                }
              ]
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "看起来你已经积累了很多的阅历，是时候介绍给你冒险家协会的重要工作了。"
        },
        {
          "role": "凯瑟琳",
          "text": "冒险家协会每天都会收到来自各处的<color=#00E1FFFF>委托</color>，并负责整理发放给各位冒险家。"
        },
        {
          "role": "凯瑟琳",
          "text": "这也是冒险家们最主要的报酬来源。"
        },
        {
          "role": "派蒙",
          "text": "都是什么样的委托？"
        },
        {
          "role": "凯瑟琳",
          "text": "什么类型都可能有，从帮助居民到清理怪物，有琐碎的也有很危险的。"
        },
        {
          "role": "凯瑟琳",
          "text": "俗话说百闻不如一见，还是亲自上手做一做更容易理解。"
        },
        {
          "role": "凯瑟琳",
          "text": "这里就是今天的委托内容。"
        },
        {
          "role": "凯瑟琳",
          "text": "麻烦完成之后来向我报告一下，我会提供一份丰厚的奖励的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "不愧是旅行者，很可靠呢。"
                }
              ]
            },
            {
              "text": "有多丰厚？",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "别那么心急，保留一下期待吧，不会让你失望的。"
                }
              ]
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "那我就在这里等你的好消息，旅行者，向着星辰与深渊！"
        },
        {
          "role": "凯瑟琳",
          "text": "我听说了哦，旅行者。"
        },
        {
          "role": "凯瑟琳",
          "text": "你已经完成了冒险家协会承接的<color=#00E1FFFF>委托</color>，委托人都让我向你道谢呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "委托？没什么印象。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "就是你在路上遇到的需要你帮忙的事。"
                },
                {
                  "role": "凯瑟琳",
                  "text": "他们其实都是在协会发布了委托的。"
                }
              ]
            },
            {
              "text": "路上正好看到就帮忙了。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "不愧是我们的冒险者新星。"
                }
              ]
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "总之，还是和你简单介绍下吧。"
        },
        {
          "role": "凯瑟琳",
          "text": "冒险家协会每天都会收到来自各处的委托，并负责整理发放给各位冒险家。"
        },
        {
          "role": "凯瑟琳",
          "text": "这也是冒险家们最主要的报酬来源。"
        },
        {
          "role": "凯瑟琳",
          "text": "说到报酬，就不得不提到协会为你准备的一个惊喜。"
        },
        {
          "type": "subtitle",
          "text": "与凯瑟琳对话"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，那我们就不客气地收下了。"
        },
        {
          "role": "凯瑟琳",
          "text": "尽管收下，这是冒险家协会表示感谢的方式。"
        },
        {
          "role": "凯瑟琳",
          "text": "因为每天协会都会收到很多委托，如果不是各位冒险家鼎力相助，是肯定没办法完成的。"
        },
        {
          "role": "凯瑟琳",
          "text": "当你每天完成足够数量的委托，就可以到我这里领取一份额外的礼物。"
        },
        {
          "role": "凯瑟琳",
          "text": "「冒险之证」里会记录今天已经完成过的数量。"
        },
        {
          "role": "凯瑟琳",
          "text": "一定记得要当天过来领取礼物，因为数量有限，错过了是没办法补发的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "明白了，谢谢你。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "不用客气，是应该谢谢你。"
                }
              ]
            },
            {
              "text": "一天只有一份吗？",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "现在的话是这样的…很抱歉。"
                },
                {
                  "role": "凯瑟琳",
                  "text": "不过也请放心，关于冒险家们的报酬，我们一直都在和总部争取。"
                }
              ]
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "对了，如果你帮助你的冒险伙伴完成委托，同样会计算在领取礼物的数量之内。"
        },
        {
          "role": "凯瑟琳",
          "text": "也请多多与你的伙伴相互合作吧！向着星辰与深渊！"
        },
        {
          "type": "subtitle",
          "text": "完成4个每日委托后与凯瑟琳对话"
        },
        {
