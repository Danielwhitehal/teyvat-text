{
  "quest_id": 76511,
  "chapter_num": null,
  "chapter_title": "「有限制冷静格斗赛」",
  "type": "wq",
  "route": "Technical Martial Challenge",
  "stories": [
    {
      "story_id": 76511,
      "title": "「有限制冷静格斗赛」",
      "description": "在挪德卡莱，一场独特的武艺比拼大赛进入了白热阶段…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往那夏镇旁的码头"
        },
        {
          "role": "泽西切",
          "text": "按照奈芙尔女士的预测，比赛进行到现在，那位高手差不多要到场了。"
        },
        {
          "role": "枫原万叶",
          "text": "的确，泽西切先生，晚风已经捎来了他的气息…"
        },
        {
          "role": "枫原万叶",
          "text": "久违了，旅行者和派蒙。"
        },
        {
          "role": "枫原万叶",
          "text": "看见你们容光焕发的状态，我由衷欣喜。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "居然是万叶？",
              "dialogues": []
            },
            {
              "text": "好久不见！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没想到，万叶也会来挪德卡莱，还和这位执灯人先生聊上了？"
        },
        {
          "role": "派蒙",
          "text": "不对，周围的情况…气氛怎么有点紧张？"
        },
        {
          "role": "枫原万叶",
          "text": "紧张是理所当然的，毕竟赛事已经到达了白热化的阶段，各地的「武学高人」都在等待最终结果。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "比拼？",
              "dialogues": []
            },
            {
              "text": "武学？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "泽西切",
          "text": "没错，欢迎来到「挪德卡莱有限制冷静格斗赛」的决赛现场！"
        },
        {
          "role": "泽西切",
          "text": "相比肆意出招，天马行空的比武，这次格斗赛更聚焦于淳朴的武器技艺。"
        },
        {
          "role": "泽西切",
          "text": "因此，我们组委会才委托冒险家协会，邀请到了这位「南十字船队」的顶尖剑客，担任我们的顾问！"
        },
        {
          "role": "派蒙",
          "text": "我明白了，这次万叶成了武斗会的评委！"
        },
        {
          "role": "枫原万叶",
          "text": "是的，我之前也略感意外，没想到那场比武的消息居然传到了挪德卡莱。{{#info:魔神任务第二章序幕[[振袖秋风问红叶]]}}"
        },
        {
          "role": "枫原万叶",
          "text": "大姐头她们前不久才在那夏镇参了展，处理完了这里的所有事务，短时间内不会再来了。{{#info:[[「礁与浪的相逢」]]}}"
        },
        {
          "role": "枫原万叶",
          "text": "而我相对空闲，又有着「南十字武斗会」的一些经验，所以就答应了泽西切先生的邀请。"
        },
        {
          "role": "泽西切",
          "text": "多亏万叶先生那敏锐的观察力，还有近乎绝对客观的评价，一些混乱的赛况才能被准确判明结果。"
        },
        {
          "role": "泽西切",
          "text": "不过现在又难办了，三位冠军候选者各有优势，互相破不了对方的招。"
        },
        {
          "role": "泽西切",
          "text": "这样打下去，再来几天几夜都没个结果。"
        },
        {
          "role": "派蒙",
          "text": "呜啊，比赛打不出结果？还真是从没听过的情况…"
        },
        {
          "role": "枫原万叶",
          "text": "依我看，还是实行那个方案好了。"
        },
        {
          "role": "泽西切",
          "text": "没错，还是要麻烦这位专家中的专家。"
        },
        {
          "role": "派蒙",
          "text": "咦，焦点怎么转移到了旅行者身上？"
        },
        {
          "role": "枫原万叶",
          "text": "如果你能稍微露两手，僵局就会被打破。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来打表演赛？",
              "dialogues": []
            },
            {
              "text": "我给大家助兴？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "枫原万叶",
          "text": "不，是由你这位「南十字武斗会」的冠军，武学界的绝对泰斗，来扮演决定冠军的最终试炼人。"
        },
        {
          "role": "枫原万叶",
          "text": "你分别对战三位冠军候选人，以他们对你造成的威胁来进行评分。"
        },
        {
          "role": "枫原万叶",
          "text": "最终，分数最高的一位便将获得冠军。"
        },
        {
          "role": "泽西切",
          "text": "而为了答谢你为比赛做出的贡献，原定冠军一半的奖金，将支付给您作为酬劳。"
        },
        {
          "role": "派蒙",
          "text": "还有这种解决方式吗？"
        },
        {
          "role": "派蒙",
          "text": "既能搞定比赛僵住的麻烦，又给足了我们面子和好处…不愧是万叶！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这种事，我还真没体验过。",
              "dialogues": []
            },
            {
              "text": "的确是非常新奇的做法。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "泽西切",
          "text": "真爽快，那就这么说定了！"
        },
        {
          "role": "枫原万叶",
          "text": "有劳你了，旅行者。"
        },
        {
          "role": "枫原万叶",
          "text": "三位对手各有看家本领，相信你会享受这次的切磋，并展现出往届冠军的英姿。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（枫原万叶）"
        },
        {
          "role": "枫原万叶",
          "text": "近些日子，一切顺利吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "劳累减轻了。",
              "dialogues": [
                {
                  "role": "枫原万叶",
                  "text": "但我听说，你还是和往常一样，频频奔走在危险的前沿，向各界人士伸出援手。"
                },
                {
                  "role": "枫原万叶",
                  "text": "或许，你找到了诀窍，在平衡战斗与休憩的比值这件事上，已然得心应手了？"
                },
                {
                  "role": "枫原万叶",
                  "text": "若是如此，我也要向你请教其中的门道啊。"
                }
              ]
            },
            {
              "text": "万叶最近怎么样？",
              "dialogues": [
                {
                  "role": "枫原万叶",
                  "text": "感谢关心，一切都好。"
                },
                {
                  "role": "枫原万叶",
                  "text": "大姐头推荐我来挪德卡莱，原本是让我领略不同以往的「自然」之声。"
                },
                {
                  "role": "枫原万叶",
                  "text": "我也顺带替平藏拜访了他的冒险家朋友，带了几件伴手礼。"
                },
                {
                  "role": "枫原万叶",
                  "text": "得知这次比拼后，我想，这是开阔眼界的好机会，便答应下来。"
                },
                {
                  "role": "枫原万叶",
                  "text": "毕竟，前路尚远，可不能疏于精进武艺。"
                },
                {
                  "role": "枫原万叶",
                  "text": "此地的愚人众并未与我发生过冲突，似乎还与你维持着某种合作关系。所以，我会以中立的态度对待他们。"
                },
                {
                  "role": "枫原万叶",
                  "text": "了解一下不同愚人众的战法，也是百利而无一弊。"
                },
                {
                  "role": "枫原万叶",
                  "text": "这回要多多劳烦你了，旅行者，引导他们使出全部本领吧。"
                }
              ]
            },
            {
              "text": "待会儿再一起聊天，万叶。",
              "dialogues": [
                {
                  "role": "枫原万叶",
                  "text": "嗯，不必心急，你先忙要紧的事。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（泽西切）"
        },
        {
          "role": "泽西切",
          "text": "你好，最终试炼人，现在就和选手们过两招吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "战斗吧。",
              "dialogues": [
                {
                  "role": "泽西切",
                  "text": "好的，那请随我乘船前往赛场。"
                }
              ]
            },
            {
              "text": "我们之前是不是见过？",
              "dialogues": [
                {
                  "role": "泽西切",
                  "text": "你还记得啊，记性真好。"
                },
                {
                  "role": "泽西切",
                  "text": "在执灯人的办事处，调查异常案件的那次，我被奈芙尔女士叫来，办了个手续。{{#info:魔神任务空月之歌第二幕[[尘与灯的挽歌]]-[[曾有人追猎月亮]]}}"
                },
                {
                  "role": "泽西切",
                  "text": "感谢你为[[索西]]军士长所做的一切。"
                }
              ]
            },
            {
              "text": "原来执灯士也会当评委？",
              "dialogues": [
                {
                  "role": "泽西切",
                  "text": "你是奈芙尔女士的合作伙伴，那就不瞒着你了。"
                },
                {
                  "role": "泽西切",
                  "text": "这次大赛原本和「执灯人」无关，我们一般不会参与这种活动。"
                },
                {
                  "role": "泽西切",
                  "text": "不过，为了提高「执灯人」的战备水平，我们有必要准确评估各方人士的战力。"
                },
                {
                  "role": "泽西切",
                  "text": "于我个人，情报也多多益善。"
                },
                {
                  "role": "泽西切",
                  "text": "所以我就答应了[[萨林]]，代他主持这次比赛。"
                },
                {
                  "role": "泽西切",
                  "text": "从结果而言，的确见识到了不少能人异士。不过在你来之前，他们因为遭到最后这三位高手淘汰，基本都离场了。"
                },
                {
                  "role": "泽西切",
                  "text": "其实，我很好奇枫原先生认真出手时的效果。"
                },
                {
                  "role": "泽西切",
                  "text": "三位冠军候选人已经是顶尖高手了，在我个人看来，挪德卡莱本地只有奈芙尔女士、菲林斯、叶洛亚长官和雅珂达在他们之上。"
                },
                {
                  "role": "泽西切",
                  "text": "但枫原先生彬彬有礼，举止随和，总给我一种深不可测的感觉。"
                },
                {
                  "role": "泽西切",
                  "text": "精彩到让我惊呼的比拼，他似乎早就司空见惯了，一直平静而客观地点评。"
                },
                {
                  "role": "泽西切",
                  "text": "当然，那种谦逊却又波澜不惊的态度，值得每位战士…或者文雅点，值得每位「武人」学习。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "他是和我出生入死过的搭档哦。",
                      "dialogues": [
                        {
                          "role": "泽西切",
                          "text": "难怪，你们相处的感觉，就像是经历过血战的战友。"
                        },
                        {
                          "role": "泽西切",
                          "text": "有资格和你并肩面对强敌…这个身份，的确令人肃然起敬。"
                        }
                      ]
                    },
                    {
                      "text": "他挡下过神明的一刀哦。",
                      "dialogues": [
                        {
                          "role": "泽西切",
                          "text": "…是某种比喻吗？这比方实在震撼人心。"
                        },
                        {
                          "role": "泽西切",
                          "text": "连你都给出了这么高的评价，看来我之前还是失敬了…"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "泽西切",
                  "text": "这场比试结束后，我再以个人名义宴请枫原先生好了。"
                }
              ]
            },
            {
              "text": "待会儿再来。",
              "dialogues": [
                {
                  "role": "泽西切",
                  "text": "那你先忙，正好也给他们三位一点准备时间。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（堇葵）"
        },
        {
          "role": "堇葵",
          "text": "嗯？原来泽西切先生提到的「最终试炼人」是您…真让人安心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是？",
              "dialogues": [
                {
                  "role": "堇葵",
                  "text": "「终末番」目付堇葵，携搭档忍犬，前来磨砺武技。"
                },
                {
                  "role": "堇葵",
                  "text": "我曾听早柚多次提起你的本领，今天终于可以开开眼界了。"
                },
                {
                  "role": "堇葵",
                  "text": "尽情捶打所有对手吧，反正其他两位选手的医药费不用我付。"
                }
              ]
            },
            {
              "text": "「咕咕丸」？",
              "dialogues": [
                {
                  "role": "堇葵",
                  "text": "是我从小抚养到大的忍犬，最新一届忍犬的模范与领队。"
                },
                {
                  "role": "堇葵",
                  "text": "虽说「咕咕丸」资历尚浅，但应用了改进后的训练方法。"
                },
                {
                  "role": "堇葵",
                  "text": "战斗力应当不逊于…全盛时期的「暮色残光」——「[[太郎丸]]」先生…嗯，至少不会差太多吧。"
                },
                {
                  "role": "堇葵",
                  "text": "愿你们两位好好享受战斗的过程，当然，也请别对「咕咕丸」下手太狠。"
                },
                {
                  "role": "堇葵",
                  "text": "不然，我会心疼的。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "堇葵",
                  "text": "您慢走。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（「咕咕丸」）"
        },
        {
          "role": "「咕咕丸」",
          "text": "咕！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "帅狗狗！",
              "dialogues": [
                {
                  "role": "「咕咕丸」",
                  "text": "咕咕！"
                },
                {
                  "role": "「咕咕丸」",
                  "text": "（这只忍犬似乎对你很有好感，眼里闪烁着期待的光芒…）"
                }
              ]
            },
            {
              "text": "狗不是这么叫的！",
              "dialogues": [
                {
                  "role": "「咕咕丸」",
                  "text": "呜…"
                },
                {
                  "role": "「咕咕丸」",
                  "text": "嗷？"
                },
                {
                  "role": "旅行者",
                  "text": "乖狗狗！"
                },
                {
                  "role": "「咕咕丸」",
                  "text": "（这只忍犬的眼神变得格外明亮，显然非常开心。）"
                }
              ]
            },
            {
              "text": "待会儿再来陪你玩。",
              "dialogues": [
                {
                  "role": "「咕咕丸」",
                  "text": "咕~"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（「减七琶音」）"
        },
        {
          "role": "「减七琶音」",
          "text": "想吃蛋糕吗，旅行者大人？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大…大人？",
              "dialogues": [
                {
                  "role": "「减七琶音」",
                  "text": "您是「仆人」大人的朋友，我上司所尊敬的强者，我自然需要对您致以最高的尊重。"
                },
                {
                  "role": "旅行者",
                  "text": "那你怎么从枫丹跑过来了？"
                },
                {
                  "role": "「减七琶音」",
                  "text": "请别在意，是正常的人事调动。"
                },
                {
                  "role": "「减七琶音」",
                  "text": "之前的变故中，「木偶」大人的部队遭受了一定的损失，短时间内难以恢复战力…"
                },
                {
                  "role": "「减七琶音」",
                  "text": "除去本土的支援，「仆人」大人也向挪德卡莱派遣了多支连队，以增强试验设计局等区域的防御。"
                },
                {
                  "role": "「减七琶音」",
                  "text": "如今，挪德卡莱的状况已然稳定，连队也准备撤回原位了。我也因此放了长假，有幸参与这场赛事，开开眼界。"
                }
              ]
            },
            {
              "text": "有饭不吃没道理，当然要吃。",
              "dialogues": [
                {
                  "role": "「减七琶音」",
                  "text": "啊，才发现都吃完了…实在抱歉。"
                },
                {
                  "role": "「减七琶音」",
                  "text": "之后我会多准备一些枫丹甜点，以便哪天意外再见您时，留着足量的礼物。"
                }
              ]
            },
            {
              "text": "愚人众役人不是这样的！",
              "dialogues": [
                {
                  "role": "「减七琶音」",
                  "text": "我应该说着「恭候多时了」，上来就给您一剑吗？"
                },
                {
                  "role": "「减七琶音」",
                  "text": "如果你想，也不是不行。"
                },
                {
                  "role": "「减七琶音」",
                  "text": "但，如果我在那夏镇的地界向您动武，「仆人」大人知道了，会惩罚我的。"
                },
                {
                  "role": "「减七琶音」",
                  "text": "而且我也不是那么不自量力的类型，要是没有规则约束，我怎么配和您较量呢？"
                },
                {
                  "role": "「减七琶音」",
                  "text": "据我学生们的评价来看，我两三下就会被您打倒，还是不要主动献丑啦。"
                }
              ]
            },
            {
              "text": "下次再说。",
              "dialogues": [
                {
                  "role": "「减七琶音」",
                  "text": "我随时恭候。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（「缟玛瑙」）"
        },
        {
          "role": "「缟玛瑙」",
          "text": "你好，旅行者。听说之后要由你来考验我，希望我们双方都能享受这场战斗。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…好有礼貌？",
              "dialogues": [
                {
                  "role": "「缟玛瑙」",
                  "text": "「礼貌是文明人的空气，它存在时我们习以为常，它缺位时，我们很快就会察觉到不妙…」"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "我刚入役时，[[瓦列里]]长官就如此教导过我…原话不这样，意思差不多。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "瓦列里长官是我最尊敬的人之一，在本土的兵营里，我绝不说粗鄙之语。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "被指派到「木偶」大人麾下后，哪怕不幸和「霜月之子」起了摩擦，被他们扔鸟蛋在脸上…"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "我也不会骂人或动手，而是尽量想办法把道理讲清楚。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那你脾气还蛮好的。",
                      "dialogues": []
                    },
                    {
                      "text": "你这样的愚人众不多见。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "嗯…最近几年唯一骂人的一次，是得知「木偶」大人遭遇不测。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "虽说没有直接接到过「木偶」大人的命令，但她的「博西柯」系列巡陆艇无比可靠，坚固耐用。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "成为「博西柯」这种坚定不移的战争机器，是我毕生的追求。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "「狂猎」大军和那个不可理喻的怪物打进试验设计局时，我的刀都砍得卷刃了，还是拦不下它们。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "要不是有一台「博西柯」巡陆艇帮我突围，我就死在码头上了。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "啊，虽然之后也差点死在另一位执行官大人降下的界域中…那就是别的话题了。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "在病床上得知了那个消息后…我感到非常震惊和恐慌。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "事情已经告一段落了…",
                      "dialogues": []
                    },
                    {
                      "text": "我和伙伴们把元凶打败了…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "嗯…谨以我个人的立场，向你致以最高的敬意。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "现在，我的编制已经移回瓦列里少校麾下，再过不久，或许就会返回至冬本土。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "能在离开挪德卡莱前得到你的指导，我的挪德卡莱部署之旅也算是充满了荣光。"
                }
              ]
            },
            {
              "text": "那我待会儿可不会留手。",
              "dialogues": [
                {
                  "role": "「缟玛瑙」",
                  "text": "把我打得满地乱爬都没事，正合我意。"
                }
              ]
            }
          ]
        }
      ],
