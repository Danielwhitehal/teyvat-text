{
  "quest_id": 72662,
  "chapter_num": null,
  "chapter_title": "奈何明月",
  "type": "wq",
  "route": "By Thy Pale Beams I Solitary Rove",
  "stories": [
    {
      "story_id": 72662,
      "title": "奈何明月",
      "description": "鲸井椛似乎找到了什么有用的资料，快与她会合...",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与鲸井椛对话"
        },
        {
          "role": "鲸井椛",
          "text": "你们来看！我又翻了一遍父亲的航海日志。"
        },
        {
          "role": "鲸井椛",
          "text": "里面有一份附录，提到了他们曾经开发过的特殊鱼饵配方。"
        },
        {
          "role": "鲸井椛",
          "text": "他们遇见「海中月」那次，使用了一种混合了海草与魔晶矿的特殊鱼饵。"
        },
        {
          "role": "鲸井椛",
          "text": "如果我们也能做出这个，或许能够吸引到「海中月」。"
        },
        {
          "role": "鲸井椛",
          "text": "海草我倒是有很多，只是魔晶矿…"
        },
        {
          "role": "旅行者",
          "text": "别担心，我这里有。"
        },
        {
          "role": "鲸井椛",
          "text": "欸？真的吗？是在荒海那边开采的吗？"
        },
        {
          "role": "鲸井椛",
          "text": "父亲的日志中有提到，魔晶矿一定要在荒海那边的废墟里发掘。"
        },
        {
          "role": "鲸井椛",
          "text": "虽然不清楚和普通的魔晶矿有什么区别，但是既然已经决定要这么做了，我们还是严谨一些，遵循书训比较好。"
        },
        {
          "role": "鲸井椛",
          "text": "说起来，荒海那边有很多魔物，很危险。我们去冒险家协会挂一个委托吧。"
        },
        {
          "role": "旅行者",
          "text": "不用，我来搞定。"
        },
        {
          "role": "鲸井椛",
          "text": "啊…对了，我都忘了你本来就是个强大的冒险家了！"
        },
        {
          "role": "鲸井椛",
          "text": "有你帮忙实在是太幸运了，那就拜托你了！"
        },
        {
          "role": "鲸井椛",
          "text": "我先回去取一些制饵工具，稍后我们在荒海西侧的沙滩那儿汇合吧。"
        },
        {
          "type": "subtitle",
          "text": "前往荒海附近寻找特殊的魔晶矿"
        },
        {
          "role": "鲸井椛",
          "text": "这么快就找到了吗？不愧是强大的冒险家啊！"
        },
        {
          "role": "旅行者",
          "text": "这些够吗？"
        },
        {
          "role": "鲸井椛",
          "text": "嗯，接下来看我的吧，只要这样…这样…再这样…"
        },
        {
          "role": "鲸井椛",
          "text": "做好了，就是这些了。"
        },
        {
          "role": "派蒙",
          "text": "接下来要做的就是把鱼饵撒下去，然后等着「海中月」出现了吧？"
        },
        {
          "role": "鲸井椛",
          "text": "嗯，我特意选了这个地方，当年我们就是从这里上岸的。"
        },
        {
          "role": "鲸井椛",
          "text": "那条指引我们返航的「海中月」，也是在这里消失的。"
        },
        {
          "role": "鲸井椛",
          "text": "所以，大家准备好了吗？见到「海中月」可别忘了许愿哦。"
        },
        {
          "role": "旅行者",
          "text": "如果没有成功怎么办？"
        },
        {
          "role": "鲸井椛",
          "text": "……"
        },
        {
          "role": "鲸井椛",
          "text": "别说丧气话，会成功的，「海中月」一定会来的。"
        },
        {
          "role": "派蒙",
          "text": "嗯！会成功的！大鱼大鱼，你一定要乖乖上钩呀！拜托你了！"
        },
        {
          "role": "鲸井椛",
          "text": "你们看！你们快看！水下在发光！有什么过来了！"
        },
        {
          "role": "派蒙",
          "text": "真的吗？真的是「海中月」来了吗？"
        },
        {
          "role": "派蒙",
          "text": "呜哇——遗迹守卫！"
        },
        {
          "role": "派蒙",
          "text": "怎么会是这家伙！"
        },
        {
          "type": "subtitle",
          "text": "与鲸井椛对话"
        },
        {
          "role": "鲸井椛",
          "text": "怎么…怎么会这样，连父亲的鱼饵配方也没有用吗？"
        },
        {
          "role": "派蒙",
          "text": "不要难过，都怪那个遗迹守卫！一定是它把「海中月」吓跑了！我们再试试吧！"
        },
        {
          "role": "旅行者",
          "text": "嗯，要不我们再试试。"
        },
        {
          "role": "鲸井椛",
          "text": "……"
        },
        {
          "role": "鲸井椛",
          "text": "……"
        },
        {
          "role": "鲸井椛",
          "text": "先算了吧，我有点累了。或许楠塔克是对的？"
        },
        {
          "role": "鲸井椛",
          "text": "唉…我现在想去外面散散心，我得好好想想之后的事。"
        },
        {
          "role": "鲸井椛",
          "text": "这些是报酬，不管怎么说，还是非常感谢你们的帮助。"
        },
        {
          "role": "派蒙",
          "text": "看来鲸井小姐现在想要一个人静静呢，我们过一阵子再来看看她吧。"
        }
      ]
    }
  ]
}