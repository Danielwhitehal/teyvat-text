  "stories": [
    {
      "story_id": 20001,
      "title": "此路不通？",
      "description": "昆恩在运送水果回蒙德城时，在千风神殿附近被路障拦截，遭到丘丘人的围攻。消灭丘丘人，解救昆恩",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往查看详请"
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物并摧毁路障"
        },
        {
          "type": "subtitle",
          "text": "与昆恩对话"
        },
        {
          "role": "昆恩",
          "text": "太感谢了，旅行者。"
        },
        {
          "role": "昆恩",
          "text": "我就是想来这摘点水果，带回城里卖。"
        },
        {
          "role": "昆恩",
          "text": "没想到却被这个路障拦住，然后那群家伙就跳出来。"
        },
        {
          "role": "昆恩",
          "text": "我这就回蒙德城去了，记得来城里光顾我的生意啊。"
        },
        {
          "role": "昆恩",
          "text": "这些就当做谢礼吧，我的水果都是这么新鲜的…所以贝雅特丽奇那家伙，才会一直过来缠着我买。"
        }
      ]
    }
  ]
