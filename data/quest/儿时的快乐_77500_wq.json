  "chapter_title": "儿时的快乐",
  "type": "wq",
  "route": "Childhood Happiness",
  "stories": [
    {
      "story_id": 77500,
      "title": "儿时的快乐",
      "description": "避难所外面的雪原上传来了某种欢快的呼声…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往避难所外查看情况"
        },
        {
          "role": "阿罗夏",
          "text": "已经第十圈了…"
        },
        {
          "role": "旅行者",
          "text": "发生什么了？"
        },
        {
          "role": "阿罗夏",
          "text": "不用担心，是别尔斯基在玩雪橇。"
        },
        {
          "role": "阿罗夏",
          "text": "他一直想体验狗拉雪橇，可惜他老爸别斯特洛夫总是忙着找活干，所以我就代劳一下。"
        },
        {
          "role": "旅行者",
          "text": "是不是有些危险？"
        },
        {
          "role": "阿罗夏",
          "text": "放心，哨子有足够的力气，再加上图加林传授的技术，不会有问题。"
        },
        {
          "role": "阿罗夏",
          "text": "另外，无论是哪家的孩子，早晚要独自面对危险，有长辈带着先体验一下是一件好事。"
        },
        {
          "role": "旅行者",
          "text": "有些道理…"
        },
        {
          "role": "阿罗夏",
          "text": "别尔斯基，还玩吗？"
        },
        {
          "role": "别尔斯基",
          "text": "好玩！能再来十圈吗？"
        },
        {
          "role": "阿罗夏",
          "text": "…他好像不觉得这是一件危险的事。"
        },
        {
          "type": "subtitle",
          "text": "前往避难所外查看情况"
        }
      ]
    }
  ]
}