{
  "quest_id": 2001,
  "chapter_num": "孔雀羽之章 第一幕",
  "chapter_title": "海盗秘宝",
  "type": "lq",
  "route": "Secret Pirate Treasure",
  "stories": [
    {
      "story_id": 461,
      "title": "凯亚的难题",
      "description": "在骑士团总部，你们遇到了龙灾时结识的骑士，凯亚。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与凯亚对话"
        },
        {
          "role": "凯亚",
          "text": "啊啊糟了…伤脑筋…这可怎么办呢……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：怎么了，凯亚？",
              "dialogues": []
            },
            {
              "text": "旅行者：你好像不是会这么慌张的人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯亚",
          "text": "哦，感谢千风。旅行者，你的出现一定是神对我的恩赐。"
        },
        {
          "role": "凯亚",
          "text": "风神派来拯救凡人的使者哟，请问你现在有空吗？"
        },
        {
          "role": "派蒙",
          "text": "唔哇，好肉麻。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：也不能说没空…",
              "dialogues": [
                {
                  "role": "凯亚",
                  "text": "那可太好了！"
                },
                {
                  "role": "凯亚",
                  "text": "其实有件事不方便让骑士团的同事知道，非你帮忙不可。"
                }
              ]
            },
            {
              "text": "旅行者：先说说究竟发生了什么？",
              "dialogues": [
                {
                  "role": "凯亚",
                  "text": "其实有件事不方便让骑士团的同事知道，非你帮忙不可。"
                }
              ]
            }
          ]
        },
        {
          "role": "凯亚",
          "text": "我想借一步说话…"
        },
        {
          "role": "凯亚",
          "text": "不如咱们就到骑士团旁边的庭院去吧，随我来。"
        },
        {
          "role": "派蒙",
          "text": "怎么搞得这么神神秘秘的…"
        },
        {
          "type": "subtitle",
          "text": "在约定的地点和凯亚对话"
        },
        {
          "role": "凯亚",
          "text": "好了，就在这里吧。"
        },
        {
          "role": "派蒙",
          "text": "别吊胃口啦，到底有什么事？"
        },
        {
          "role": "凯亚",
          "text": "该从何说起呢…对了。先告诉你们一个秘密吧。"
        },
        {
          "role": "凯亚",
          "text": "那是有关我个人过往的秘密，请千万不要对别人提起。"
        },
        {
          "role": "派蒙",
          "text": "放心，我的口风可是很紧的。"
        },
        {
          "role": "凯亚",
          "text": "其实啊…我的爷爷…是个海盗！"
        },
        {
          "role": "派蒙",
          "text": "哦。"
        },
        {
          "role": "凯亚",
          "text": "…不不。这反应也太冷淡了。难道你不相信我吗？"
        },
        {
          "role": "凯亚",
          "text": "看！我的眼罩就是海盗爷爷的遗传，这就是血亲的证明！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：眼罩原来还能遗传的吗？",
              "dialogues": [
                {
                  "role": "凯亚",
                  "text": "啊哈哈，旅行者，你还真是没有常识呀。"
                },
                {
                  "role": "凯亚",
                  "text": "这就像许多孩子头上的辫子也遗传自妈妈，是一样的道理啊。"
                }
              ]
            },
            {
              "text": "旅行者：真令人惊讶。",
              "dialogues": [
                {
                  "role": "凯亚",
                  "text": "昨晚我翻阅爷爷留下来的手记，偶然发现了爷爷留下的<span style=\"color:#00E1FF\">宝藏</span>信息…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "…宝藏？！"
        },
        {
          "role": "凯亚",
          "text": "根据手记上的情报，似乎宝藏被埋藏在「失落的阿卡狄亚遗迹」。"
        },
        {
          "role": "派蒙",
          "text": "宝藏…"
        },
        {
          "role": "凯亚",
          "text": "但这遗迹的位置具体在哪里，目前还没有线索…"
        },
        {
          "role": "派蒙",
          "text": "宝藏！"
        },
        {
          "role": "派蒙",
          "text": "凯亚！那究竟是什么宝藏！黄金吗？还是宝石？"
        },
        {
          "role": "凯亚",
          "text": "哼哼，只有财宝的宝藏，不过都是三流货色而已…"
        },
        {
          "role": "凯亚",
          "text": "我爷爷的宝藏，是「剑」啊。"
        },
        {
          "role": "凯亚",
          "text": "据说是一柄只要握住，就可以获得无敌力量的神剑！"
        },
        {
          "role": "派蒙",
          "text": "哇——"
        },
        {
          "role": "凯亚",
          "text": "那剑是天空岛上的神明失手落入海中的，被爷爷他们碰巧打捞起来。"
        },
        {
          "role": "凯亚",
          "text": "他握住剑柄的瞬间，电闪雷鸣，巨浪翻腾，原本晴空万里的海上忽然卷起风暴…"
        },
        {
          "role": "凯亚",
          "text": "依靠神剑的力量，爷爷一路击败了八头海蛇、银发女妖、深渊邪龙…"
        },
        {
          "role": "凯亚",
          "text": "但这力量过于强大，令其他海盗觊觎不已。"
        },
        {
          "role": "凯亚",
          "text": "为了避免争端，爷爷只能把神剑藏了起来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：八头海蛇、银发女妖…真的存在吗？",
              "dialogues": [
                {
                  "role": "凯亚",
                  "text": "这世界就是因为充满了未知，所以才会有趣的嘛。"
                }
              ]
            },
            {
              "text": "旅行者：……",
              "dialogues": [
                {
                  "role": "凯亚",
                  "text": "精彩到令人难以置信的冒险，只属于海盗的浪漫，不是吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "八头海蛇、银发女妖…真的存在吗？"
        },
        {
          "role": "凯亚",
          "text": "这世界就是因为充满了未知，所以才会有趣的嘛。"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "凯亚",
          "text": "精彩到令人难以置信的冒险，只属于海盗的浪漫，不是吗？"
        },
        {
          "role": "派蒙",
          "text": "呜哇！！简直太厉害了！"
        },
        {
          "role": "凯亚",
          "text": "最近有一伙盗宝团非常活跃，好几处遗迹已经发生文物失窃。"
        },
        {
          "role": "凯亚",
          "text": "我担心「阿卡狄亚遗迹」也很快会被他们发现，那柄神剑…"
        },
        {
          "role": "派蒙",
          "text": "那可不行！与其落在坏人手里，还不如我们来…"
        },
        {
          "role": "派蒙",
          "text": "…总之，你放心吧！我和旅行者会帮忙的！"
        },
        {
          "role": "凯亚",
          "text": "哦~？"
        },
        {
          "role": "凯亚",
          "text": "那可真是太棒了，还请记得保守秘密，我会等你们的消息。"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话",
          "narration": true,
          "color": "描述1"
        },
        {
          "role": "派蒙",
          "text": "喂，怎么样，旅行者？不觉得很激动吗？那可是超——级厉害的神剑呀。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：那是真的吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯…不如先去<span style=\"color:#00E1FF\">冒险家协会</span>附近打探一下情报？"
                }
              ]
            },
            {
              "text": "旅行者：那真的是真的吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯…不如先去<span style=\"color:#00E1FF\">冒险家协会</span>附近打探一下情报？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "关于遗迹的情报，冒险家们会比较清楚吧。"
        },
        {
          "type": "subtitle",
          "text": "前往冒险家协会打听情报"
        },
        {
          "type": "subtitle",
          "text": "额外对话（与杰克对话）"
        },
        {
          "role": "杰克",
          "text": "你好！你也是新人冒险家吗？要不要来我的冒险团？"
        },
        {
          "role": "旅行者",
          "text": "想请教一下…"
        },
        {
          "role": "派蒙",
          "text": "你好！请问你有没有什么关于「阿卡狄亚遗迹」的消息？"
        },
        {
          "role": "杰克",
          "text": "阿卡狄亚…好像没听说过。对不起，我还是协会的新人，了解的情报比较少。"
        },
        {
          "role": "派蒙",
          "text": "这样啊…"
        },
        {
          "role": "杰克",
          "text": "不如试着去冒险家协会里挂个委托看看？有实力的老手们也是很活跃的。"
        },
        {
          "role": "派蒙",
          "text": "不行不行不行，那可不行。"
        },
        {
          "role": "派蒙",
          "text": "万一被那些冒险家捷足先登，把宝藏拿走就完了。"
        },
        {
          "role": "旅行者",
          "text": "（就这么说出去了…）"
        },
        {
          "role": "杰克",
          "text": "哦~↑↓"
        },
        {
          "role": "杰克",
          "text": "那就没办法了。宝藏的事我会替你们留意的，额，不，是遗迹的事…"
        },
        {
          "type": "subtitle",
          "text": "（再次对话）",
          "narration": true
        },
        {
          "role": "旅行者",
          "text": "关于「阿卡狄亚遗迹」"
        },
        {
          "role": "杰克",
          "text": "嗯…要不要也出发去找找看呢…哦？没事没事，祝你们能早日找到那处遗迹，哈哈。"
        },
        {
          "role": "塞琉斯",
          "text": "啊哈！小鬼，欢迎加入冒险家协会！"
        },
        {
          "role": "派蒙",
          "text": "哼，我们才不是为了那么无聊的事来的。"
        },
        {
          "role": "派蒙",
          "text": "我们是在找一柄从天空岛上掉下来的，斩杀过八头女妖，银发海蛇的…"
        },
        {
          "role": "派蒙",
          "text": "超级超级厉害的神剑！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：是八头海蛇，银发女妖…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸，都差不多啦，反正就是…很厉害。"
                }
              ]
            },
            {
              "text": "旅行者：你透露太多情报了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "没关系啦，只要不把藏宝地点说出去就好。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那么，塞琉斯先生，你知道「失落的阿卡狄亚遗迹」在哪里吗？"
        },
        {
          "role": "旅行者",
          "text": "（就这么说出去了…）"
        },
        {
          "role": "塞琉斯",
          "text": "「阿卡狄亚遗迹」…没听说过这名字。"
        },
        {
          "role": "塞琉斯",
          "text": "不过还是谢谢你们分享的情报。如果找到的话，记得拿来让我见识见识。"
        },
        {
          "role": "派蒙",
          "text": "嗯？分享…情报…？"
        },
        {
          "type": "subtitle",
          "text": "话音刚落，在你们背后不远处，一个鬼鬼祟祟的身影悄悄地离开了…",
          "narration": true,
          "color": "描述1"
        },
        {
          "type": "subtitle",
          "text": "额外对话（与塞琉斯对话）"
        },
        {
          "role": "旅行者",
          "text": "关于「阿卡狄亚遗迹」"
        },
        {
          "role": "塞琉斯",
          "text": "我对你们说的还是蛮有兴趣的，可惜线索方面真的帮不上忙。"
        },
        {
          "type": "subtitle",
          "text": "向凯亚报告"
        },
        {
          "role": "凯亚",
          "text": "哦，你们回来了。又带来什么好消息吗？"
        },
        {
          "role": "派蒙",
          "text": "唔嗯…我们在冒险家协会打听了一圈，但还是没找到什么线索。"
        },
        {
          "role": "凯亚",
          "text": "呼呼，那是当然的。"
        },
        {
          "role": "派蒙",
          "text": "嗯？"
        },
        {
          "role": "凯亚",
          "text": "没什么。我是说，不经历一些挫折，又怎么会有得到宝藏时的喜悦呢？"
        },
        {
          "role": "凯亚",
          "text": "对了，正巧我这边倒是有一些消息。"
        },
        {
          "role": "凯亚",
          "text": "我刚托人去了趟地下情报交易所…似乎有人知道「阿卡狄亚遗迹」的相关情报。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？那人在哪里？"
        },
        {
          "role": "凯亚",
          "text": "别急，按照交易所的规矩，他们会安排线人来和我们接头，防止情报泄露。"
        },
        {
          "role": "凯亚",
          "text": "那个线人，我已经约她在低语森林见面了。"
        },
        {
          "role": "派蒙",
          "text": "那我们还在等什么呀，不去找她吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：这件事凯亚自己不方便出面吧。",
              "dialogues": [
                {
                  "role": "凯亚",
                  "text": "没错！真不愧是阁下。"
                },
                {
                  "role": "凯亚",
                  "text": "那就有劳二位替我跑一趟了，不胜感激。"
                }
              ]
            },
            {
              "text": "旅行者：我和派蒙会把情报带回来的。",
              "dialogues": [
                {
                  "role": "凯亚",
                  "text": "那就有劳二位替我跑一趟了，不胜感激。"
                }
              ]
            }
          ]
        },
        {
          "role": "凯亚",
          "text": "情报费用方面，当然，我也会替你们报销的。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿。包在我身上！"
        }
      ],
      "collapse_ranges": [
