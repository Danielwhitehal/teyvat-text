        {
          "role": "凯亚",
          "text": "别忘了你承诺过什么，否则刚才的东西绝对不会是你见过最可怕的东西…"
        },
        {
          "role": "伊扎德",
          "text": "这…喂！你们骑士团都是这样对待嫌犯的吗…"
        },
        {
          "role": "凯亚",
          "text": "开玩笑的。好了，把他带回蒙德城吧。"
        },
        {
          "role": "西风骑士",
          "text": "是！凯亚队长。"
        },
        {
          "role": "西风骑士",
          "text": "队长，这两个人也要一并带走吗？"
        },
        {
          "role": "派蒙",
          "text": "什么？！"
        },
        {
          "role": "凯亚",
          "text": "哈哈，不用了。这两位可是本次行动的功臣。"
        },
        {
          "role": "凯亚",
          "text": "没有他们散布假情报，我们也没那么容易搞定盗宝团。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "果然是假情报。",
              "dialogues": []
            },
            {
              "text": "果然根本没有什么宝藏。",
              "dialogues": []
            },
            {
              "text": "原来我被骗了！震惊！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呜呜呜…骗子！喜欢说谎的坏人！骑士团的败类！"
        },
        {
          "role": "凯亚",
          "text": "停，停——好啦，好啦。"
        },
        {
          "role": "凯亚",
          "text": "尽管宝藏是假的，但至少有那么一瞬间你是想要独吞的吧？"
        },
        {
          "role": "凯亚",
          "text": "不然，你们为什么不通知我，而是自己过来了？"
        },
        {
          "role": "派蒙",
          "text": "啊！…唔嗯嗯嗯嗯…哼！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们走！谁有空和这家伙理论啊！"
        },
        {
          "role": "凯亚",
          "text": "哈哈，稍等一下。"
        },
        {
          "role": "凯亚",
          "text": "二位帮了我这么大的忙，谢礼总是少不了的。"
        },
        {
          "role": "凯亚",
          "text": "这柄剑名为「斩开黎明指向胜利的拂晓神剑」，如它的名字一样，是象征光明与胜利之剑。"
        },
        {
          "role": "派蒙",
          "text": "「黎明神剑」？"
        },
        {
          "role": "凯亚",
          "text": "没错。与通情达理的派蒙阁下很相称吧？"
        },
        {
          "role": "派蒙",
          "text": "嗯…如果谢礼是这柄「黎明神剑」的话…"
        },
        {
          "role": "凯亚",
          "text": "你们会理解我的，对吗？"
        },
        {
          "role": "凯亚",
          "text": "有你们这样温柔又懂得体谅他人的朋友，是我凯亚的荣幸。"
        },
        {
          "role": "派蒙",
          "text": "嗯…嗯…"
        },
        {
          "role": "凯亚",
          "text": "这次的事实在抱歉，但请派蒙阁下放心，同样的伎俩我是不会用两次的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…派蒙已经完全被掌控了呢。",
              "dialogues": []
            },
            {
              "text": "…不同的伎俩就可以继续用吗。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯亚",
          "text": "真是愉快的一天。那么，我还要回去审讯嫌犯…"
        },
        {
          "role": "凯亚",
          "text": "今天就先告辞了。以后也欢迎来骑士团找我，我们下次再见吧。"
        }
      ]
    }
  ]
}