{
  "quest_id": 70674,
  "chapter_num": null,
  "chapter_title": "神工天巧·宝录之章",
  "type": "wq",
  "route": "Divine Ingenuity: Collector's Chapter",
  "stories": [
    {
      "story_id": 70674,
      "title": "神工天巧·宝录之章",
      "description": "在蒙德郊外，你又遇见了宏朗，他似乎依然在研究那一处奇异的秘境…",
      "dialogues": [
        {
          "role": "宏朗",
          "text": "怎么这次跑到蒙德来了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "宏朗？",
              "dialogues": []
            },
            {
              "text": "这是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宏朗",
          "text": "旅行者！真是太巧了，没想到会在这里遇见你。"
        },
        {
          "role": "宏朗",
          "text": "至于现在的情况…看看旁边这道门，你应该差不多明白了吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "上次的那种秘境又出现了？",
              "dialogues": []
            },
            {
              "text": "是你一直在研究的那种秘境？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宏朗",
          "text": "没错。多亏了你上次帮忙探索了那处秘境，我们得到了很多宝贵的资料。"
        },
        {
          "role": "宏朗",
          "text": "不过…虽然协会也已经帮忙四处调查，但几乎没有从外界找到更多有价值的信息。"
        },
        {
          "role": "宏朗",
          "text": "我们正准备派出更多人手探索，甚至联系了其他协会的人来帮忙，这个秘境却突然消失了…"
        },
        {
          "role": "宏朗",
          "text": "直到今天，它才突然出现在了蒙德…多亏了蒙德冒险家协会的兄弟传来了消息，我才能第一时间赶来。"
        },
        {
          "role": "旅行者",
          "text": "你们开始探索了吗？"
        },
        {
          "role": "宏朗",
          "text": "那是当然，秘境就摆在面前，我们可没有退缩的道理。"
        },
        {
          "role": "宏朗",
          "text": "这个秘境的「规则」似乎没有变太多，依然是根据进入者的念头而拟想出某种物品。"
        },
        {
          "role": "宏朗",
          "text": "但在探索过程中，我们发现…这处秘境居然可以变化出一些「敌人」了。"
        },
        {
          "role": "宏朗",
          "text": "这些「敌人」会对我们发动攻击，被攻击到后，我们也会感受到真实的痛感。"
        },
        {
          "role": "宏朗",
          "text": "怎么说呢…简直和真实的「战斗」没什么两样了，冒险家们对这件事也十分感兴趣。"
        },
        {
          "role": "宏朗",
          "text": "但是，有些冒险家连自己拟想出的「敌人」都打不过，还要别人帮他搞定，真是…"
        },
        {
          "role": "宏朗",
          "text": "咳！不说这些了，旅行者，如果你愿意的话，就再和我们一起探索这处秘境吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "宏朗",
                  "text": "哈哈哈，那太好了！有你帮忙，我们的工作一定能事半功倍。"
                }
              ]
            },
            {
              "text": "我不会遇见啥危险吧…",
              "dialogues": [
                {
                  "role": "宏朗",
                  "text": "呃…以你的身手，只要提高警惕，应该不会有问题的。"
                },
                {
                  "role": "宏朗",
                  "text": "总之，如果你愿意的话，就帮我们探索一下这处秘境吧，有你帮忙，我们的工作一定能事半功倍。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "宏朗",
          "text": "旅行者，探索秘境时可要提高警惕，说不定你会遇见一些前所未有的情况。"
        },
        {
          "role": "宏朗",
          "text": "我等会还要去协会一趟，就这么点人，我怎么深入探索嘛…"
        }
      ],
      "collapse_ranges": [
        [
          18,
          20
        ]
      ]
    }
  ]
}