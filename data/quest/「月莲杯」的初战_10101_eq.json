{
  "quest_id": 10101,
  "chapter_num": "智巧灵蕈大竞逐 第二幕",
  "chapter_title": "「月莲杯」的初战",
  "type": "eq",
  "route": "Nilotpala Cup: Debut Match",
  "stories": [
    {
      "story_id": 40082,
      "title": "「月莲杯」的初战",
      "description": "「月莲杯驯兽师大赛」的预赛开始了，是时候和「咚咚小圆帽」并肩作战，对阵其他的驯兽师了！",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到第二天上午（8：00-10：00）"
        },
        {
          "type": "subtitle",
          "text": "前往「月莲杯」赛场"
        },
        {
          "role": "派蒙",
          "text": "预赛快要开始了，埃尔欣根好像在发表赛前的演讲呢。"
        },
        {
          "role": "埃尔欣根",
          "text": "各位选手与观众，「月莲杯驯兽师大赛」即将正式开幕。我由衷希望各位能在这场比赛中找到乐趣，有所收获。"
        },
        {
          "role": "埃尔欣根",
          "text": "同时，也请各位在比赛中保持一颗纯粹的竞技之心，友善地比拼。尽力而为就足够了，不必太动气，斗个你死我活。"
        },
        {
          "role": "埃尔欣根",
          "text": "我一直在寻找人与危险生物和谐共处的方法，而你们手中的「意智宝珠」让我看到了可能性。"
        },
        {
          "role": "埃尔欣根",
          "text": "希望这次大赛能向更多人展示「驯兽」的潜力，为将来的世界提供一种规避冲突的措施，使人们在野外活动时更加安全。"
        },
        {
          "role": "派蒙",
          "text": "原来如此！埃尔欣根是为了这个目标，才愿意出让自己的资产吗？感觉他很有理想呢！相比之下，那个考特里亚就有点…"
        },
        {
          "role": "考特里亚",
          "text": "由衷感谢埃尔欣根先生的发言！接下来我也简单说两句…"
        },
        {
          "role": "考特里亚",
          "text": "各位驯兽师！你们手中的「意智宝珠」是划时代的产物，凝聚着教令院几百年来的技术结晶，它的伟大之处有九点…"
        },
        {
          "role": "埃尔欣根",
          "text": "考特里亚，大家都跃跃欲试呢，眼下不必解释得这么细致。"
        },
        {
          "role": "考特里亚",
          "text": "咳咳！有机会的话，我再给各位说明吧！你们在比赛中肯定能感觉到它的先进。信任你们的「意智宝珠」，尽情去比拼吧！"
        },
        {
          "role": "派蒙",
          "text": "完全是个技术狂人呢，不管场合自顾自地发表观点…还好，埃尔欣根先生很会看气氛，没有让他耽误我们的时间！"
        },
        {
          "role": "派蒙",
          "text": "预赛总算要开始了，我们好好迎战第一位对手吧。"
        },
        {
          "role": "旅行者",
          "text": "（赛诺？他也注意到这场比赛了吗…）"
        },
        {
          "type": "subtitle",
          "text": "参加比赛",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "击败对手",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "风速枣椰",
          "text": "啊哈！没想到预赛的对手看起来这么普通。"
        },
        {
          "role": "风速枣椰",
          "text": "来吧，就让本小姐用华丽的快攻打败你们！"
        },
        {
          "role": "派蒙",
          "text": "不用紧张哦，「咚咚小圆帽」，只是预赛的对手而已，把他们当成踏脚石就好了！"
        },
        {
          "type": "subtitle",
          "text": "与对手对话"
        },
        {
          "role": "派蒙",
          "text": "「咚咚小圆帽」，干得漂亮！还有大家，打得真棒！"
        },
        {
          "role": "风速枣椰",
          "text": "怎么这样…我的风速攻势居然输掉了…大家快撤退！"
        },
        {
          "type": "subtitle",
          "text": "离开赛场"
        },
        {
          "type": "subtitle",
          "text": "与八重神子对话"
        },
        {
          "role": "派蒙",
          "text": "我觉得，指挥蕈兽和别人比赛的感觉很特别，很有意思！"
        },
        {
          "role": "派蒙",
          "text": "不过，刚才的那个驯兽师和蕈兽们的配合也挺不错的，简直和我们俩不相上下…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙也想参战吗？",
              "dialogues": []
            },
            {
              "text": "绝技是「爆裂银光轰轰拳」！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我不是那个意思啦！我是说，对方好像和蕈兽形成了一种「流派」！"
        },
        {
          "role": "派蒙",
          "text": "如果我们能和「咚咚小圆帽」配合得更自然就好了，我希望，我们一个眼神，「咚咚小圆帽」就知道该做什么！"
        },
        {
          "role": "八重神子",
          "text": "这就要仰仗「伙伴间的默契」了。"
        },
        {
          "role": "派蒙",
          "text": "神子！还有莱依拉！你们的比赛还顺利吗？"
        },
        {
          "role": "莱依拉",
          "text": "没想到「转转悠悠兽」和蘑菇伙伴们这么厉害，两三下就打垮了对手，我都没反应过来…"
        },
        {
          "role": "莱依拉",
          "text": "回到赛场时，我看见八重小姐的对手丢了魂似地逃走了…正好，八重小姐打算和你们商谈要事，我就跟着她一起过来了。"
        },
        {
          "role": "八重神子",
          "text": "小莱依拉顺利战胜了对手，左右加也首战告捷，略胜对手一线。我倒是有点遗憾…对手完全没让我尽兴呢。"
        },
        {
          "role": "派蒙",
          "text": "现在只是开始嘛，如果预赛的对手就超能打，这场比赛未免就太难了！"
        },
        {
          "role": "派蒙",
          "text": "不过说起来，神子打算和我们商量什么呢？"
        },
        {
          "role": "八重神子",
          "text": "啊呀，派蒙，你进步了呢，已经意识到了我要提醒你们的事。今后的对手会越来越强，我们可不能松懈啊。"
        },
        {
          "role": "八重神子",
          "text": "不如就借着赢下预赛的气势，和蕈兽开展「特别修行」，加强与伙伴们的配合吧。"
        },
        {
          "role": "派蒙",
          "text": "很有先见之明！那我们现在就出发吧，和蘑菇伙伴们开始特别修行！"
        },
        {
          "type": "subtitle",
          "text": "与八重神子对话"
        },
        {
          "role": "八重神子",
          "text": "嗯，这里风景不错，空气里有一股雨林的香气，还足够僻静，没人会来打扰我们。"
        },
        {
          "role": "八重神子",
          "text": "我们可以陪着蕈兽尽情玩耍，休息的时候，就来享受须弥的特色美食吧。"
        },
        {
          "role": "派蒙",
          "text": "好耶！吃零食吃零食！"
        },
        {
          "role": "派蒙",
          "text": "等等…我们不是来修行的吗？难道神子在这些零食里加入了特别的配方…能让我们和蕈兽伙伴心意相通？"
        },
        {
          "role": "八重神子",
          "text": "就算我有那种神通，也不能滥用吧？我只带了一些普通的果干和点心。"
        },
        {
          "role": "八重神子",
          "text": "也许你们以为，我会给你们准备一场魔鬼训练？但那种事对你们完全没必要，相反，一直紧绷着弦，会错过很多重要的事物呢。"
        },
        {
          "role": "八重神子",
          "text": "既然要和蕈兽培养感情，就该把它们当成朋友来对待，留下快乐的回忆嘛，和朋友一起吃喝玩乐，是更重要的「默契修行」。"
        },
        {
          "role": "八重神子",
          "text": "假如小家伙只想着让你变强，逼着你练出石头般的肌肉来，想看你一拳打飞丘丘暴徒…你会开开心心地听话吗？"
        },
        {
          "role": "旅行者",
          "text": "肌肉派蒙…"
        },
        {
          "role": "派蒙",
          "text": "干嘛这样看着我！如果你敢做那种事…我，我就三天，不对，我就五天不理你！"
        },
        {
          "role": "八重神子",
          "text": "你看，你和小家伙的交情这么深，都不想被他强迫着锻炼，何况是刚刚认识不久的蕈兽伙伴呢？"
        },
        {
          "role": "派蒙",
          "text": "呃，完全被你的逻辑绕进去了…"
        },
        {
          "role": "莱依拉",
          "text": "八重小姐的想法属实在理。我也想看看，如果关闭了「意智宝珠」，或是宝珠出现故障，蘑菇伙伴还会听我们的话吗？"
        },
        {
          "role": "旅行者",
          "text": "关闭意智宝珠？"
        },
        {
          "role": "莱依拉",
          "text": "嗯，朋友之间都是慢慢熟悉彼此，才一步步达成互相信任的。"
        },
        {
          "role": "莱依拉",
          "text": "我不能总是依赖道具去和「转转悠悠兽」沟通，这样多少有点命令它的感觉…"
        },
        {
          "role": "八重神子",
          "text": "哎呀，「纯粹的情感，绝不能依靠身外之物来维系」…小莱依拉的想法还真是经典~"
        },
        {
          "role": "派蒙",
          "text": "可是，这就等于解除了对蕈兽的控制…真的没问题吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我觉得值得一试。",
              "dialogues": []
            },
            {
              "text": "我也想知道结论。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "尽管试试看吧，小莱依拉。不用担心，我和小家伙们会帮你的。"
        },
        {
          "role": "莱依拉",
          "text": "好，请大家做好准备，我要开始了。"
        },
        {
          "role": "派蒙",
          "text": "真的欸，关掉了「意智宝珠」以后，「转转悠悠兽」只是自顾自地活动了起来，并没有像以前那样攻击附近的人。"
        },
        {
          "role": "八重神子",
          "text": "或许「意智宝珠」能让蕈兽们的性格变得平和，以便搭起沟通的桥梁，而不是凭借某种技术强行控制它们。"
        },
        {
          "role": "八重神子",
          "text": "如果这个假设属实，小莱依拉的期待就有望成真了——你们和蕈兽熟悉彼此后，不使用「意智宝珠」也能毫无障碍地沟通。"
        },
        {
          "role": "派蒙",
          "text": "还是神子说得好！什么神秘技术都靠边站，这个假设我更喜欢！"
        },
        {
          "role": "莱依拉",
          "text": "我会努力的！我要了解「转转悠悠兽」的喜好，然后去找一位「全能商人」，买很多它喜欢的零食…"
        },
        {
          "role": "派蒙",
          "text": "那我也要和原本的「咚咚小圆帽」交流！我们也试着关掉「意智宝珠」吧？"
        },
        {
          "role": "旅行者",
          "text": "（为什么「意智宝珠」会有如此之强的效果？考特里亚掌握着其他学者都不了解的强大技术吗？）"
        },
        {
          "role": "莱依拉",
          "text": "「转转悠悠兽」想去那边玩水？旅行者，派蒙和八重小姐，要带着蘑菇伙伴一起来吗？"
        },
        {
          "role": "八重神子",
          "text": "你可得留个心眼，站在水里时，别离「百雷遮罗」太近，否则可能享受到特别的腿部按摩服务哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「咚咚小圆帽」是浮游水蕈兽。",
              "dialogues": []
            },
            {
              "text": "「咚咚小圆帽」总是在玩水。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你不说我都快忘了…我们应该让「咚咚小圆帽」体验一些新奇的事？比如带着它爬树，去树顶看风景？"
        },
        {
          "role": "派蒙",
          "text": "那莱依拉，神子，你们先去吧。「咚咚小圆帽」以前在水边生活，应该对玩水习以为常了，我们想给它换点花样！"
        },
        {
          "role": "莱依拉",
          "text": "原来如此…之后我们就在这里碰头吧，希望你们也玩得开心！"
        },
        {
          "type": "subtitle",
          "text": "莱依拉和八重神子带着蕈兽去远处玩耍了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "「咚咚小圆帽」，你想玩什么都行，可以和我们说哦，我应该能理解你的意思。"
        },
        {
          "role": "派蒙",
          "text": "噫！居然不理我…我要给它塞好多好多好吃的，努力和它混熟！"
        },
        {
          "role": "遇袭的小孩",
          "text": "救命，救命啊！"
        },
        {
          "role": "遇袭的小孩",
          "text": "这和说好的不一样！蕈兽怎么这么凶啊！"
        },
        {
          "role": "派蒙",
          "text": "你听见了吗？好像有人在呼救！"
        },
        {
          "role": "派蒙",
          "text": "不对劲，我们赶快去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "寻找呼救声的来源"
        },
        {
          "type": "subtitle",
          "text": "与海妮耶对话"
        },
        {
          "role": "海妮耶",
          "text": "怎么是你们？"
        },
        {
          "role": "派蒙",
          "text": "海妮耶？你救下了那些孩子？"
        },
        {
          "role": "海妮耶",
          "text": "碰巧而已。那几个孩子想模仿参赛选手，结果被野生蕈兽围攻。还好我听见了动静，才保住了他们的性命。"
        },
        {
          "role": "派蒙",
          "text": "这也太危险了，他们怎么连「意智宝珠」都不拿，就冒冒失失靠近蕈兽啊！"
        },
        {
          "role": "海妮耶",
          "text": "不怪他们，以前我也被蕈兽可爱的外表迷惑过…好在我还牢记着家族的教诲和祖辈们吃过的苦头，没有贸然接近它们。"
        },
        {
          "role": "海妮耶",
          "text": "大家原本都明白，蕈兽是危险的魔物。但最近人们被「月莲杯」影响，慢慢对蕈兽放下了警惕心，这是埃尔欣根考虑欠妥的一点。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大赛的热度太高…",
              "dialogues": []
            },
            {
              "text": "导致了新的问题…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海妮耶",
          "text": "我会让这场闹剧尽快结束的。"
        },
        {
          "role": "海妮耶",
          "text": "「意智宝珠」非常适合大规模剿杀蕈兽。等到我夺得了冠军，就能随意支配这些道具。"
        },
        {
          "role": "派蒙",
          "text": "你在说什么啊，海妮耶？什么闹剧…什么剿杀蕈兽？你在「火一」面前说出这样的话，就不怕伤它的心吗？"
        },
        {
          "role": "派蒙",
          "text": "你不也参赛了吗？还主动给过我们指导，明明也乐在其中吧…"
        },
        {
          "role": "海妮耶",
          "text": "假如「火一」能意识到同类犯过的错，想必也会支持我的。可惜它无法理解人的情感，它只是被道具控制的「棋子」。"
        },
        {
          "role": "海妮耶",
          "text": "至于教导你们的理由…你们不也意识到了吗？我只是看中了你们的实力，想要让你们协助我实现自己的目标罢了。"
        },
        {
          "role": "海妮耶",
          "text": "现在你们居然在为蕈兽辩护，你们已经沉浸在这场荒谬的游戏里了，配不上「黄金流星」和「白银伴星」这两个响亮的称号…"
        },
        {
          "role": "派蒙",
          "text": "别走啊，海妮耶！我们刚刚还关闭了「意智宝珠」，在和蕈兽们一起玩呢！"
        },
        {
          "role": "旅行者",
          "text": "不打算听我们的话啊…"
        },
        {
          "role": "八重神子",
          "text": "啊呀呀，还真是一位性格鲜明的角色，言行中的执着也恰到好处，我嗅到了有趣展开的味道。"
        },
        {
          "role": "派蒙",
          "text": "神子？莱依拉？你们也被呼救声吸引过来了…"
        },
        {
          "role": "八重神子",
          "text": "刚刚我们还聊到了她，小莱依拉说，海妮耶是你们参赛之初的引路人，但在你们遇见小莱依拉后，她又突然离开了。"
        },
        {
          "role": "八重神子",
          "text": "现在看来，原来她是个经典的「迷途角色」。因为某些个体犯下了过错，就把矛头指向整个群体，要将对方彻底抹除…"
        },
        {
          "role": "八重神子",
          "text": "在「迷途角色」看来，这还是最有效、最稳妥的办法呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她似乎经历过蕈兽的灾害。",
              "dialogues": []
            },
            {
              "text": "她的看法应该是有来由的",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱依拉",
          "text": "暴躁的蕈兽确实对环境造成过破坏，可是，也有一些研究理论说，它们只是遵循着自己的本性，和野兽没什么区别吧…"
        },
        {
          "role": "莱依拉",
          "text": "这个物种已经存在很长时间了，一下子把它们全都除掉，反而不知道会对雨林的生态造成什么影响。"
        },
        {
          "role": "派蒙",
          "text": "莱依拉说得对啊，做事不能太极端！不管海妮耶经历过什么，我们都不能看着她胡来！"
        },
        {
          "role": "八重神子",
          "text": "「拦在她前往冠军的路上」？你们的反应也在我的意料之中呢。听说她是大赛著名的种子选手，实力异常强劲，你们做好准备了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们要加强训练。",
              "dialogues": []
            },
            {
              "text": "我们要继续培养默契。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "神子你带我们过来的目的，不就是要让我们和蕈兽伙伴彼此熟悉，配合得更好嘛？"
        },
        {
          "role": "派蒙",
          "text": "等等，难道你一开始就料到了这种事…"
        },
        {
          "role": "八重神子",
          "text": "呵呵，把一切都安排得妥妥当当，反而会有些无趣吧？这次你们和海妮耶意外相遇，反倒给了我不少惊喜。"
        },
        {
          "role": "八重神子",
          "text": "今天的修行先到此为止，预赛应该已经结束了，我们去了解之后的赛程吧。"
        },
        {
          "type": "subtitle",
          "text": "返回「月莲杯」赛场"
        },
        {
          "role": "派蒙",
          "text": "那边有好多人围在一起，好像在看什么东西？"
        },
        {
          "role": "莱依拉",
          "text": "听说主办方准备了好几块留言板，让观众们自由发表评论，互相交流，这种办法确实能提高大赛的讨论度。"
        },
        {
          "role": "莱依拉",
          "text": "那我和「转转悠悠兽」也会被大家讨论吗？要是这段经历也能被用在论文里就好了…"
        },
        {
          "role": "派蒙",
          "text": "我觉得很合适哦！听说写论文要引用很多资料，这件事很让人头疼。现在莱依拉自己就是提供资料的人，怎么高兴就怎么写！"
        },
        {
          "role": "莱依拉",
          "text": "派蒙的想法真好啊…可我是明论派的学员，只有生论派的论文会用到这种资料吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "隔行如隔山。",
              "dialogues": []
            },
            {
              "text": "隔山有商机。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯…莱依拉也可以向生论派学员提供资料嘛，说不定还可以赚一笔摩拉…啊呸，是资料费！"
        },
        {
          "role": "莱依拉",
          "text": "摩拉倒是次要的…不过，作为交换，可以请生论派的学员查阅高级文献，搞清楚「转转悠悠兽」的同类都喜欢什么。"
        },
        {
          "role": "莱依拉",
          "text": "缩小了调查范围后，我就轻松多了。不然，我可能要买几百种东西，每样都拿给「转转悠悠兽」尝尝看…"
        },
        {
          "role": "莱依拉",
          "text": "光是想想，我就要累昏了…"
        },
        {
          "role": "派蒙",
          "text": "还有这种思路？莱依拉真厉害啊！"
        },
        {
          "role": "派蒙",
          "text": "那「咚咚小圆帽」的喜好也麻烦你留意一下了！"
        },
        {
          "role": "莱依拉",
          "text": "我一定尽力…回去之后我就写信，托人送去阿弥利多学院。"
        },
        {
          "role": "旅行者",
          "text": "（赛诺的部下？他在监视赛场…）"
        },
        {
          "role": "八重神子",
          "text": "小家伙，三十二强赛的对阵列表公布了哦。"
        },
        {
          "role": "派蒙",
          "text": "欸？下场比赛居然就要和左右加小姐对决了！"
        },
        {
          "role": "八重神子",
          "text": "噗…我最期待的画面出现了啊…"
        },
        {
          "role": "派蒙",
          "text": "干嘛这么高兴？你就不怕你寄予厚望的作者被我们打败吗？那八重堂的须弥之旅就会草草收场的哦。"
        },
        {
          "role": "八重神子",
          "text": "千万别客气啊~我从没要求过左右加夺冠。没准被你们打败后，左右加还会因此顿悟呢。"
        },
        {
          "role": "八重神子",
          "text": "毕竟一帆风顺的经历可能让人们变得固执，认为只有自己才是正确的，有时挫折反而更宝贵哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白了…",
              "dialogues": []
            },
            {
              "text": "就按主编大人的意思…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "不错的反应。我很期待下一场比赛哦，等你们的捷报~"
        }
      ]
    }
  ]
}