{
  "quest_id": 75675,
  "chapter_num": null,
  "chapter_title": "不留负担的美味魔法！",
  "type": "wq",
  "route": "A Lighthearted Feast of Magic!",
  "stories": [
    {
      "story_id": 75675,
      "title": "不留负担的美味魔法！",
      "description": "又一次「舞力聚会」临近尾声，大家都有很棒的收获…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "呼啊，这段时间的舞力聚会，玩得还真开心！"
        },
        {
          "role": "派蒙",
          "text": "不知道大家的感觉怎么样呢？"
        },
        {
          "type": "subtitle",
          "text": "前往悠悠度假村"
        },
        {
          "role": "昂吉安妮",
          "text": "嘿！哈！"
        },
        {
          "role": "昂吉安妮",
          "text": "我的脑袋已经被音乐占满了，跳舞跳舞！"
        },
        {
          "role": "瑟琪",
          "text": "摇摆摇摆~"
        },
        {
          "role": "梅内娅",
          "text": "快快乐乐——"
        },
        {
          "role": "莫乌",
          "text": "呜啊呜啊！"
        },
        {
          "role": "玛因",
          "text": "还赚了外快。"
        },
        {
          "role": "昂吉安妮",
          "text": "咦？你这小妞，什么时候的事？"
        },
        {
          "role": "玛因",
          "text": "努斯妲小姐忙不过来，我就抽空去支援了她的学徒，清剿了几个魔物的巢穴。"
        },
        {
          "role": "玛因",
          "text": "在纳塔，战斗和跳舞一样尽兴，喜欢。"
        },
        {
          "role": "努斯妲",
          "text": "真是麻烦你了，玛因。我的本意是让新人们多多锻炼，没想到他们还是不能独立完成那一组任务。"
        },
        {
          "role": "努斯妲",
          "text": "等我回去后，给他们狠狠加练！"
        },
        {
          "role": "玛因",
          "text": "不麻烦，他们也打得很漂亮。只不过之前没想到，巢穴里有预估七倍的魔物罢了。"
        },
        {
          "role": "玛因",
          "text": "「花羽会」给的好多，我为[[爱贝尔]]买礼物的钱都凑够了。"
        },
        {
          "role": "昂吉安妮",
          "text": "但你的假期时间好像也差不多了？"
        },
        {
          "role": "昂吉安妮",
          "text": "再玩几天，就可以预订船票琢磨返程的事。"
        },
        {
          "role": "玛因",
          "text": "不急，还可以跳舞。小[[萝克珊]]、[[勒泰利埃]]，[[谢妮]]和[[弗雷瑞斯]]最近在争着任务做，我可不能和他们抢。"
        },
        {
          "role": "瑟琪",
          "text": "那就继续跳舞，继续开心。"
        },
        {
          "role": "梅内娅",
          "text": "跳累就吃，吃饱就睡，无忧无虑！"
        },
        {
          "role": "莫乌",
          "text": "咿啊——"
        },
        {
          "type": "subtitle",
          "text": "美露莘们和小鳍游龙排成一列，向着舞台蹦蹦跳跳过去了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "努斯妲",
          "text": "真是一群可爱的客人…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，你也很享受嘛，努斯妲。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "笑容更轻松畅快了。",
              "dialogues": []
            },
            {
              "text": "好像整个人都年轻了不少。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "努斯妲",
          "text": "当真？那以后，每次「舞力聚会」，我都非来不可。"
        },
        {
          "role": "努斯妲",
          "text": "要让那些见面就喊我大姐，甚至是阿姨的后辈…有一天发现，我的精神面貌比他们都年轻。"
        },
        {
          "role": "努斯妲",
          "text": "以后的「舞力聚会」应该以这次为典范，办得越频繁越好！成为每个月都有的惯例，都在情理之中！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（瑟琪&昂吉安妮&玛因）"
        },
        {
          "role": "瑟琪",
          "text": "我的假期倒是还有很多，我倒是觉得，给你们这些战斗岗位派发的任务，是不是有点太重了？"
        },
        {
          "role": "昂吉安妮",
          "text": "没事，[[蒂蕾娜]]接替我的教官职责后，很快就能带出又一批能干的新人，到时候玛因和小萝克珊都能闲下来的！"
        },
        {
          "role": "玛因",
          "text": "下次酿汐藻的时候，我肯定能提前回村里。"
        },
        {
          "role": "瑟琪",
          "text": "记得不要带武器回来了，你家的屋子放不下了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（梅内娅&莫乌）"
        },
        {
          "role": "梅内娅",
          "text": "应该不会再那么难过了吧，莫乌？"
        },
        {
          "role": "莫乌",
          "text": "呜嗷…"
        },
        {
          "role": "梅内娅",
          "text": "你要开开心心地生活下去，这样，远方的[[因娜]]也会为你高兴的。"
        },
        {
          "role": "莫乌",
          "text": "呜！"
        }
      ],
      "collapse_ranges": [
