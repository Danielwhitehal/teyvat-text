{
  "quest_id": 2076,
  "chapter_num": "",
  "chapter_title": "魔女的课业·意外之题",
  "type": "wq",
  "route": "Witch's Homework: Of the Unexpected",
  "stories": [
    {
      "story_id": 10003,
      "title": "艾伦·史密西，菲谢尔的作者",
      "description": "和魔女的课题完全没有关系，你只是去冒险家协会看看工作委托而已。结果好像有意外收获？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往蒙德城的冒险家协会"
        },
        {
          "role": "凯瑟琳",
          "text": "向着星辰与深渊。你好，旅行者。"
        },
        {
          "role": "派蒙",
          "text": "你好啊，凯瑟琳。奥兹、菲谢尔，你们也在，真巧啊。"
        },
        {
          "role": "菲谢尔",
          "text": "宇宙万物都会落入幽夜，追求光的人自会在黎明的境界上相聚。"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是，确实是巧遇，你们好。而我个人想说的也是：你们好，派蒙和旅行者。"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，最近正好有一个八重堂点名希望你接受的委托。他们派了一个编辑过来接洽委托的详细情况。"
        },
        {
          "role": "凯瑟琳",
          "text": "好像因为涉及商业隐秘，所以委托的很多细节无法全权交待给协会。只说是关于《神霄折戟录》作者的…"
        },
        {
          "role": "菲谢尔",
          "text": "什么？那岂不是…"
        },
        {
          "role": "菲谢尔",
          "text": "咳咳。"
        },
        {
          "role": "派蒙",
          "text": "这个作者这么重要吗？万一我们最近不在或者听了觉得任务很麻烦，编辑不就白来一趟了吗？"
        },
        {
          "role": "凯瑟琳",
          "text": "把它当作只需要带一句话的公费采风的话，我觉得大家可能争这个机会能争得头破血流…"
        },
        {
          "role": "凯瑟琳",
          "text": "如果你愿意接下这个委托的话，可以在猎鹿人找到那位编辑先生。稻妻人应该还挺显眼的。"
        },
        {
          "role": "菲谢尔",
          "text": "等…我是说，旅人哦，切勿焦急。命运把你推向世界的潮流，并非是为了让你孤身面对荒芜。"
        },
        {
          "role": "菲谢尔",
          "text": "而是为了把你推向幽夜净土的轨迹！"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是：请让她也一起帮忙。"
        },
        {
          "role": "派蒙",
          "text": "菲谢尔突然好积极！感觉有什么内情？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不也挺好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥兹",
          "text": "那么就趁着大家都在，一起先去猎鹿人看看能不能找到那位编辑先生吧。"
        },
        {
          "type": "subtitle",
          "text": "前往猎鹿人，寻找来接洽的编辑"
        },
        {
          "role": "派蒙",
          "text": "那个可以来蒙德公费旅游的幸运之人是——"
        },
        {
          "role": "派蒙",
          "text": "行——不对，枕玉老师的负责编辑小野寺！"
        },
        {
          "role": "小野寺",
          "text": "旅行者，之前承蒙照顾了。希望这次你听完八重大人的委托之后还能再照顾我一次…"
        },
        {
          "role": "小野寺",
          "text": "旁边这位菲谢尔皇女打扮的是？"
        },
        {
          "role": "菲谢尔",
          "text": "吾乃断罪之皇女菲谢尔。"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是：她是菲谢尔，很高兴认识你。"
        },
        {
          "role": "派蒙",
          "text": "呃，她是菲谢尔小姐。是个来协助的朋友。她可是很可靠的冒险家哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没错，她是菲谢尔。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "小野寺",
          "text": "原、原来是菲谢尔啊。就算如此，也不用说四次吧。"
        },
        {
          "role": "菲谢尔",
          "text": "即已知晓吾之名讳，自然应该了解：称吾之名，即为赎罪。因故，称赞吾名，即是救祓。"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是：她——"
        },
        {
          "role": "小野寺",
          "text": "原来是这样啊。记住名字确实是基本礼节。只要能解决问题，让我喊一万次也没问题。谢谢你来帮忙。"
        },
        {
          "role": "派蒙",
          "text": "居、居然比奥兹的翻译还要更早明白菲谢尔的意思！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可不要小看编辑。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "小野寺",
          "text": "那么事不宜迟，让我来详细说说这次的委托吧。"
        },
        {
          "role": "小野寺",
          "text": "你们应该知道，《神霄折戟录》的作者九老师吧？"
        },
        {
          "role": "菲谢尔",
          "text": "菲谢尔…"
        },
        {
          "role": "奥兹",
          "text": "小姐，您说什么？"
        },
        {
          "role": "菲谢尔",
          "text": "九老师代表作明明是《菲谢尔皇女夜谭》！"
        },
        {
          "role": "奥兹",
          "text": "咳咳，小姐的意思是：倘若造物主的常态只有冷酷，那幽夜净土与皇女也应是足以让它垂泪的造物。"
        },
        {
          "role": "小野寺",
          "text": "那好的。《菲谢尔皇女夜谭》的作者九老师，最近从挪德卡莱发来一封求救信，看起来他状态很不好。"
        },
        {
          "role": "派蒙",
          "text": "那这不是一个很简单的事情吗？委托那边的协会或者佣兵找到他就好了啊。"
        },
        {
          "role": "小野寺",
          "text": "所以最大的问题来了。我们其实也不知道九老师长什么样，年纪多大，是胖是瘦，是哪国人…"
        },
        {
          "role": "小野寺",
          "text": "他从来只写信和八重堂联系，发信地址遍布全大陆。作者年会和线下活动也请不来真人。"
        },
        {
          "role": "派蒙",
          "text": "这种委托怎么做啊？"
        },
        {
          "role": "小野寺",
          "text": "所以调查九老师究竟是谁是委托的一个重要部分。"
        },
        {
          "role": "小野寺",
          "text": "我们也自己努力调查过。结果发现，九老师自从《神霄》完结之后，字迹都开始不一样了。"
        },
        {
          "role": "小野寺",
          "text": "最早给九老师负责的编辑也已经辞职，想要自己写小说来着。他对于九老师也没有额外信息可以补充。"
        },
        {
          "role": "菲谢尔",
          "text": "凡存在过的事物都会被断罪皇女记住，在幽夜净土中永存。原初神圣言语自会涌流出一切因果。"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是：最——"
        },
        {
          "role": "小野寺",
          "text": "没错，我们想到一块去了。所以我们找出来了最早的《神霄折戟录》原稿！"
        },
        {
          "role": "派蒙",
          "text": "呜啊！这个行——枕玉老师看到会激动到晕过去的吧？"
        },
        {
          "role": "派蒙",
          "text": "不对！比起这个，小野寺居然又先于奥兹理解了菲谢尔的话！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "编辑，很神奇吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥兹",
          "text": "这是…"
        },
        {
          "role": "菲谢尔",
          "text": "奥兹华尔多·亨利·赫芙那梵茵斯哟，你发现了什么吗？"
        },
        {
          "role": "奥兹",
          "text": "没有那个「亨利」，小姐。"
        },
        {
          "role": "奥兹",
          "text": "确实能感觉到一丝若有若无的感应。和小姐您身上的…磁场、引力、因果丝线，这样的东西近似。"
        },
        {
          "role": "小野寺",
          "text": "我们最后只确定了一件事。投稿的稿纸底纹和工艺来自璃月，大概就在轻策庄。"
        },
        {
          "role": "派蒙",
          "text": "九老师难道是个璃月人吗？"
        },
        {
          "role": "派蒙",
          "text": "不对，说到轻策庄写小说的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "常…九爷？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这不太可能吧？"
        },
        {
          "role": "小野寺",
          "text": "常九爷是吗？《古华派的大师兄》也是新人奖获奖作品，我听说过。"
        },
        {
          "role": "菲谢尔",
          "text": "无妨。「垂泪的圣徒」与「赎罪的圣徒」纵使所行之道义不同，力量却是同源。"
        },
        {
          "role": "奥兹",
          "text": "小野寺先生，您请。"
        },
        {
          "role": "派蒙",
          "text": "奥兹我知道你信任小野寺，但是考虑一下我们啊！"
        },
        {
          "role": "小野寺",
          "text": "说的也没错。既然同为作家，就算不是一人，说不定总会有些交流吧？把他当切入点或许不错。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "编辑，很强大吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呃。"
        },
        {
          "role": "小野寺",
          "text": "那就麻烦你们了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（小野寺）"
        },
        {
          "role": "派蒙",
          "text": "九老师还有什么特征吗？"
        },
        {
          "role": "小野寺",
          "text": "根据读者来信问答和卷尾「作者的话」来看，他应该发际线后退、轻微啤酒肚、不喜欢吃甜的、心脏在右边。"
        },
        {
          "role": "小野寺",
          "text": "左边还是右边？嗯，右边。然后他左手有五个手指，失眠很严重、每只眼睛各有一个瞳孔…"
        },
        {
          "role": "派蒙",
          "text": "好没特色！"
        },
        {
          "type": "subtitle",
          "text": "前往轻策庄，向常九爷询问详情"
        },
        {
          "role": "派蒙",
          "text": "常九爷似乎不在啊。"
        },
        {
          "role": "奥兹",
          "text": "看来一下子是找不到人问话了。是要在这里等一等他吗？"
        },
        {
          "role": "派蒙",
          "text": "好像只能这样了。"
        },
        {
          "role": "奥兹",
          "text": "不过，他不在的话，是不是说明…他确实有可能是被绑架到挪德卡莱的九老师呢？"
        },
        {
          "role": "奥兹",
          "text": "要不要搜查一下他的住处？"
        },
        {
          "role": "派蒙",
          "text": "总觉得私自搜别人的家有点不好。不过哦，万一常九爷真的是九老师的话…"
        },
        {
          "type": "subtitle",
          "text": "调查周围线索"
        },
        {
          "type": "subtitle",
          "text": "调查路灯旁"
        },
        {
          "role": "奥兹",
          "text": "并不是这个。"
        },
        {
          "type": "subtitle",
          "text": "调查门前"
        },
        {
          "role": "派蒙",
          "text": "似乎没什么有用的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调查",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与菲谢尔对话"
        },
        {
          "role": "派蒙",
          "text": "看起来也是平平无奇的东西呢。"
        },
        {
          "role": "菲谢尔",
          "text": "并非如此。本皇女已然看破尘埃之中的宇宙奥秘。它所展现的，正是涌向真实的智慧泉流。"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是：她觉得这个是线索。"
        },
        {
          "type": "subtitle",
          "text": "调查菲谢尔怀疑的地点"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调查",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与菲谢尔对话"
        },
        {
          "role": "派蒙",
          "text": "这里居然真的有翻土的痕迹！"
        },
        {
          "role": "派蒙",
          "text": "呜啊，常九爷该不会被热情的粉丝埋在下面了吧！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，要不我们还是喊千岩军过来检查吧。"
        },
        {
          "role": "奥兹",
          "text": "诸位完全可以放心，最热情的粉丝就在眼前。"
        },
        {
          "role": "奥兹",
          "text": "既然小姐不会去伤害任何人，其他没这么热情的粉丝应该也不会。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那动手吧。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "挖开了松动的地面。\n找到了一大袋摩拉和北国银行的支票…\n突然一声呵斥在背后响起，你下意识把东西塞进了兜里。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "？？？",
          "text": "你们在干什么！我要喊千岩军了！"
        },
        {
          "role": "派蒙",
          "text": "哇！常九爷，你没死啊！也没被绑架！"
        },
        {
          "role": "常九爷",
          "text": "你能不能说几句好话。仔细一看，这不是上次跟着古华派小哥来这里的那谁吗？{{#info:传说任务：锦织之章·第一幕「[[江湖不问出处]]」|info}}"
        },
        {
          "role": "常九爷",
          "text": "嗨，看来是个误会。你们来我家翻土是干什么？"
        },
        {
          "role": "派蒙",
          "text": "其实，我们想问你…该不会用过「九老师」这个笔名吧？"
        },
        {
          "role": "常九爷",
          "text": "就算吃蘑菇发幻觉了我也不可能是九老师啊。我要是九老师，我投稿这么多年小说大赛图什么啊？"
        },
        {
          "role": "常九爷",
          "text": "图个扮猪吃老虎吗？那我还真是自取其辱，投稿落选了这么多年。"
        },
        {
          "role": "常九爷",
          "text": "我可经常被批评说「古典的少年英雄主角已经落后时代了。甚至开篇反转、扮猪吃虎都快过时了。」"
        },
        {
          "role": "常九爷",
          "text": "「…现在的读者喜欢九老师那种天马行空、标新立异的世界观和设定。」"
        },
        {
          "role": "派蒙",
          "text": "也是哦。"
        },
        {
          "role": "常九爷",
          "text": "我要真是九老师本人，《古华派的大师兄》获奖那一年，我就该立刻宣布其实我是九老师。"
        },
        {
          "role": "常九爷",
          "text": "「什么？居然是九老师。是不是弄错了，老常就是个落魄户啊。」啧啧，这么来一出，一定畅快。"
        },
        {
          "role": "派蒙",
          "text": "你家还收藏着《神霄折戟录》来着。回想一下当初你在行秋和我们面前夸这个作品的样子。"
        },
        {
          "role": "派蒙",
          "text": "你要真是九老师，岂不也是一种「琴团长在夸自己欸」。这么想想确实不对。"
        },
        {
          "role": "奥兹",
          "text": "各位，虽然常先生并不是九老师。但是对我来说，他身上也有奇特的感觉。"
        },
        {
          "role": "奥兹",
          "text": "那是一种奇特的感应，和小姐以及原稿一样的「缘」。我觉得我似乎有能力追踪和九老师有关的事物。"
        },
        {
          "role": "派蒙",
          "text": "既然这样就好办了！到了挪德卡莱，让奥兹领着我们寻找就可以了。"
        },
        {
          "role": "派蒙",
          "text": "说来，常九爷你刚才是去干什么了啊？"
        },
        {
          "role": "常九爷",
          "text": "我稿纸用完了，去买稿纸了呗。我可是讲究人，当作事业的文学创作自然要用上档次的纸。"
        },
        {
          "role": "奥兹",
          "text": "确实和那份原稿的纸一样。"
        },
        {
          "role": "派蒙",
          "text": "那我们没问题了！谢谢你啦，常九爷。事不宜迟，我们赶快出发吧！"
        },
        {
          "role": "常九爷",
          "text": "虽然我也不知道帮了什么忙，但是不客气。"
        },
        {
          "role": "菲谢尔",
          "text": "别了，他世界的造物者哟。虽然汝所安立之法则与叙事，自无法比拟幽夜净土下积淀的梦之尘泥。"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是：您写得不如…算了，小姐的意思是：谢谢您，常九爷，再见。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（常九爷）退出特殊剧情模式"
        },
        {
          "role": "常九爷",
          "text": "幻想我自己是九老师是么？倒也不失为一种打开创作思路的办法。"
        },
        {
          "role": "常九爷",
          "text": "开始幻想了，幻想我是九老师。如果是九老师会怎么写。"
        },
        {
          "type": "subtitle",
          "text": "前往挪德卡莱，随奥兹寻找九老师"
        },
        {
          "role": "奥兹",
          "text": "应该就在前面不远的地方。"
        },
        {
          "role": "派蒙",
          "text": "这里居然有个被袭击的仙灵？看起来很可疑啊。"
        },
        {
          "role": "奥兹",
          "text": "而且在这位仙灵身上也能感受到那种神秘的引力。"
        },
        {
          "role": "菲谢尔",
          "text": "既是如此，那命运已然指示了方向。"
        },
        {
          "type": "subtitle",
          "text": "击败眼前的魔物"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|荒野幽徒|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "帮助眼前的仙灵"
        },
        {
          "role": "派蒙",
          "text": "这个仙灵，似乎是在给我们引路？"
        },
        {
          "role": "派蒙",
          "text": "跟过去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "跟随仙灵"
        },
        {
          "type": "subtitle",
          "text": "与幕后之人对话"
        },
        {
          "role": "？？？",
          "text": "怎么是你们？"
        },
        {
          "role": "派蒙",
          "text": "这个声音，是尼可！"
        },
        {
          "role": "派蒙",
          "text": "我们还想问呢。为了找九老师，我们从璃月找到这里，结果最后遇到了你。"
        },
        {
          "type": "subtitle",
          "text": "和尼可以及仙灵说了八重堂的委托和之前的调查…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "尼可",
          "text": "原来是这样。九老师，就是它啊。"
        },
        {
          "role": "九老师",
          "text": "你们好啊！"
        },
        {
          "role": "菲谢尔",
          "text": "这、这是何等异常之「黄昏」，亿万幽夜也未曾听说过这样的事情！"
        },
        {
          "role": "尼可",
          "text": "就是那个嘛，我其实也挺想当小说家来着，但是能够直接沟通思想比说话都方便。"
        },
        {
          "role": "尼可",
          "text": "所以写字对我来说就更麻烦了。这个你们可以理解的吧。"
        },
        {
          "role": "尼可",
          "text": "找人把想写的设定和情节畅快地说一通，就相当于自己写了。但是真这么做了我又觉得可惜。"
        },
        {
          "role": "尼可",
          "text": "所以我就找了一个仙灵故交，把我的设定和点子全给她说了。让她去找想成为小说家的人替我写书。"
        },
        {
          "role": "尼可",
          "text": "为了真实性九老师还编了很多很有真实感的人设呢。比如脱发什么的。"
        },
        {
          "role": "九老师",
          "text": "我就是那个受害者。"
        },
        {
          "role": "尼可",
          "text": "也不能这么说嘛。通过调动那些作家预备役的语言系统，你说话的知性不都锻炼到恢复了嘛。"
        },
        {
          "role": "尼可",
          "text": "天使嘛，就是人脑子灵光乍现跑出来的灵感。也是重操旧业了。"
        },
        {
          "role": "派蒙",
          "text": "这真的没问题吗？"
        },
        {
          "role": "尼可",
          "text": "没关系。稿子都是趁着人睡着了被九老师上身写的。"
        },
        {
          "role": "尼可",
          "text": "只要是存在着创造世界的梦想，就会浮现的作家人格。自动式的哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「自动式的哦。」",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "等等，那求救信和奥兹的奇妙感觉是怎么回事？"
        },
        {
          "role": "九老师",
          "text": "我被尼可抓过来当挪德卡莱的监视员了。很危险好不好，我现在可没有天空的知识库和力量了。"
        },
        {
          "role": "尼可",
          "text": "至于那边那位的诞生之缘，你看，小说为了真实感，会加入很多半真半假的细节嘛。"
        },
        {
          "role": "派蒙",
          "text": "确实，稻妻的轻小说就有过写真实咒语的先例…"
        },
        {
          "role": "尼可",
          "text": "九老师故事的设定都是一些隐喻，里面创造生命的办法也不能说完全是假的吧…"
        },
        {
          "role": "尼可",
          "text": "但是没想到真的有小姑娘能够成功。"
        },
        {
          "role": "菲谢尔",
          "text": "…"
        },
        {
          "role": "奥兹",
          "text": "小姐已经完全呆住了。不过，容我僭越地理解一下：小姐通过小说里半真半假的方法，把我创造了出来？"
        },
        {
          "role": "尼可",
          "text": "七成假三成真吧。"
        },
        {
          "role": "九老师",
          "text": "九成假一成真。太危险了，所以我自己改了。我写的书你果然没看过！"
        },
        {
          "role": "派蒙",
          "text": "奥兹好像不怎么惊讶？"
        },
        {
          "role": "奥兹",
          "text": "怎么说呢？或许诞生之初就隐约察觉到了。能为小姐服务，我很荣幸。"
        },
        {
          "role": "尼可",
          "text": "总之挪德卡莱的事情结束，九老师就可以光荣回归了。你们就这么回去说吧。"
        },
        {
          "role": "九老师",
          "text": "我不要在这里当你眼睛！太危险啦！"
        },
        {
          "role": "九老师",
          "text": "不过这么说来，要麻烦你和轻策庄那位大叔带个话。稿费版税我们九一开了，这么多年的都埋他院里了。"
        },
        {
          "role": "派蒙",
          "text": "你要钱做什么啊？"
        },
        {
          "role": "九老师",
          "text": "我要把它藏起来当财宝，然后指引人跟着我去取啊。我们天性就喜欢引导人，就喜欢这一口。"
        },
        {
          "role": "九老师",
          "text": "以后有机会欢迎来找我的宝藏，我把它埋在幽夜净土的尽头了。"
        },
        {
          "role": "菲谢尔",
          "text": "我一定会去的！"
        },
        {
          "role": "奥兹",
          "text": "小姐？"
        },
        {
          "role": "菲谢尔",
          "text": "那个，九老师，我很喜欢你的小说！"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是：纵使宇宙的漆黑无边无际，万事万物终将投下发着光的影子。"
        },
        {
          "role": "九老师",
          "text": "我很高兴哦。看来你已经找到我最大的宝藏了。"
        },
        {
          "role": "尼可",
          "text": "那么这件事就先这样吧。现在我要和九老师吵一架，来争夺第一作者究竟是谁了。"
        },
