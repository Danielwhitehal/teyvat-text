{
  "quest_id": 20104,
  "chapter_num": null,
  "chapter_title": "酒庄大扫除之二",
  "type": "iq",
  "route": "Cleanup At Dawn II",
  "stories": [
    {
      "story_id": 20104,
      "title": "酒庄大扫除之二",
      "description": "在女仆长爱德琳的安排下，女仆摩可和海莉也开始了打扫，但是，她们似乎遇见了一点麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与摩可和海莉对话"
        },
        {
          "role": "摩可",
          "text": "怎么办…"
        },
        {
          "role": "海莉",
          "text": "又要挨女仆长骂了…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "摩可",
          "text": "爱德琳小姐本来是让我们打扫酒庄的外围…"
        },
        {
          "role": "海莉",
          "text": "其他的地方还好，但是，周围还有很多堆起来的草垛。"
        },
        {
          "role": "摩可",
          "text": "这些是康纳先生特意堆在这，说是有用处的…"
        },
        {
          "role": "海莉",
          "text": "虽然因为捆得很牢，暴风的时候这些草垛没有被吹走，但是，有很多落叶被吹到了草垛里面…"
        },
        {
          "role": "摩可",
          "text": "我们费了好大的劲，也没有把落叶从草垛里清理干净。"
        },
        {
          "role": "海莉",
          "text": "再这么耗下去，女仆长非得骂我们不可，这可怎么办啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "摩可",
                  "text": "咦？可以交给你吗！太好了，那就拜托你了！"
                }
              ]
            },
            {
              "text": "很难清理吗？",
              "dialogues": [
                {
                  "role": "海莉",
                  "text": "落叶和草垛都搅一起了，我们只能用手慢慢地分开，实在是太慢了…"
                },
                {
                  "role": "海莉",
                  "text": "如果你有什么好办法，就请帮帮我们吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "扫清落叶堆"
        },
        {
          "type": "subtitle",
          "text": "与摩可和海莉对话"
        },
        {
          "role": "摩可",
          "text": "怎么样？"
        },
        {
          "role": "海莉",
          "text": "打扫干净了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经打扫干净了。"
        },
        {
          "role": "摩可",
          "text": "太厉害了！"
        },
        {
          "role": "海莉",
          "text": "不愧是旅行者！"
        },
        {
          "role": "摩可",
          "text": "这样就不用被女仆长骂了，谢谢你。"
        },
        {
          "role": "海莉",
          "text": "这些请收下，就算是谢礼吧。"
        },
        {
          "role": "摩可",
          "text": "我们得赶紧打扫别的地方去了…再次谢谢你帮忙！"
        },
        {
          "role": "摩可",
          "text": "你，你做什么呀，怎么把整个草垛都烧掉了！"
        },
        {
          "role": "海莉",
          "text": "这回不是被骂就能了事了，一定会被开除…"
        },
        {
          "role": "旅行者",
          "text": "一不小心就…"
        },
        {
          "role": "摩可",
          "text": "早知道，我们还不如慢慢地一点点把落叶挑出来了…"
        },
        {
          "role": "海莉",
          "text": "完了…这下子全完了…"
        },
        {
          "role": "旅行者",
          "text": "那个…"
        },
        {
          "role": "摩可",
          "text": "旅行者，请你快点离开吧，这件事是我们的责任…"
        },
        {
          "role": "海莉",
          "text": "我们不该让不懂得打扫方法的人来帮忙，是我们错了…"
        },
        {
          "role": "摩可",
          "text": "女仆长会怎么处置我们呢…"
        },
        {
          "role": "海莉",
          "text": "这下子，全都完了…"
        },
        {
          "type": "subtitle",
          "text": "与摩可和海莉对话"
        },
        {
          "role": "摩可",
          "text": "呜…衣服全都弄脏了。"
        },
        {
          "role": "海莉",
          "text": "而且落叶也没打扫干净。"
        },
        {
          "role": "摩可",
          "text": "这可怎么办呐…"
        }
      ]
    }
  ]
}