{
  "quest_id": 10165,
  "chapter_num": "彩鹞栉春风 其一",
  "chapter_title": "风莺梳春，开天呈祥",
  "type": "eq",
  "route": "The Orioles Bask in Spring, the Heavens Present Auspices",
  "stories": [
    {
      "story_id": 40139,
      "title": "风莺梳春，开天呈祥",
      "description": "你和派蒙回到璃月，准备参加一年一度的海灯节，在港口漫步时，果不其然见到了熟悉的面孔…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "海灯节就快到了吧？现在这个时候，大家肯定都在忙忙碌碌地采买货品，给家里增添节庆氛围。"
        },
        {
          "role": "派蒙",
          "text": "不知道今年的主题会跟什么有关呢？真让人好奇呀…"
        },
        {
          "role": "派蒙",
          "text": "我们去璃月港到处转转、打听打听吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（遐庆）"
        },
        {
          "role": "遐庆",
          "text": "再准备一下，把活动办好点！"
        },
        {
          "role": "旅行者",
          "text": "（这个人似乎正忙着筹备活动，没空和别人闲聊…）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（文寻）"
        },
        {
          "role": "文寻",
          "text": "蓬蓬松松，软软弹弹…进度还不错，快要完成啦！"
        },
        {
          "role": "旅行者",
          "text": "（她好像很开心的样子，正一心一意准备着什么…还是不要打扰她了。）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卷舒）在遗珑埠"
        },
        {
          "role": "卷舒",
          "text": "还要再考虑一下路线啊，必须让那位可敬之人的身姿鼓舞更多人…"
        },
        {
          "role": "旅行者",
          "text": "（她好像在思考很重要的问题，完全没注意到旁边有人来了…）"
        },
        {
          "type": "subtitle",
          "text": "在璃月港随处走走"
        },
        {
          "role": "派蒙",
          "text": "刻晴！还有夏洛蒂？真是意想不到的组合。"
        },
        {
          "role": "刻晴",
          "text": "好久不见，旅行者，派蒙。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，没有打扰你们说话吧？"
        },
        {
          "role": "夏洛蒂",
          "text": "放心。我没在采访刻晴小姐，是在讨论选购风筝的事。"
        },
        {
          "role": "派蒙",
          "text": "风筝？夏洛蒂准备买特色礼物带回枫丹吗？"
        },
        {
          "role": "夏洛蒂",
          "text": "对。另外嘛…"
        },
        {
          "role": "刻晴",
          "text": "派蒙想必还没来得及发现，今年海灯节的主题就是「风筝」。"
        },
        {
          "role": "派蒙",
          "text": "欸！这么说起来，天上飘着的就是啊！"
        },
        {
          "role": "刻晴",
          "text": "璃月港不断发展，海灯节也需要推陈出新。"
        },
        {
          "role": "刻晴",
          "text": "「七星」对此的判断是，在继承璃月传统的基础上，也可参考他国技术。正如：他山之石，可以攻玉。"
        },
        {
          "role": "刻晴",
          "text": "为此，早些时候，凝光就作为代表，安排了一场和夏洛蒂小姐的私人会面，请她推动相关的合作事宜。"
        },
        {
          "role": "夏洛蒂",
          "text": "还记得我上次来璃月港，去找了「天权星」凝光小姐谈合作上的事吗？就是这个。"
        },
        {
          "role": "夏洛蒂",
          "text": "不过…虽然说是「推动合作」，但我也只是通过人脉关系，向凝光小姐引荐了几个有趣的人而已啦。"
        },
        {
          "role": "刻晴",
          "text": "双方最终选定的方案，是将璃月传统手工艺风筝和枫丹的「械动式垂直拉升装置」相结合。"
        },
        {
          "role": "派蒙",
          "text": "械动式…装置？听起来好像很厉害。"
        },
        {
          "role": "派蒙",
          "text": "但风筝不是借着风力就能飞吗？为什么还要靠机械？"
        },
        {
          "role": "刻晴",
          "text": "答案已经在你的问题里了，派蒙。"
        },
        {
          "role": "刻晴",
          "text": "风筝能否飞得高、飞得远，不仅依赖持线之人的技巧，还受制于当天的气候条件。"
        },
        {
          "role": "夏洛蒂",
          "text": "一旦遇上没有风的天气，再有经验的人也只能像水里的甜甜花鳉那样干瞪眼啦。"
        },
        {
          "role": "刻晴",
          "text": "没错。既然璃月现在是「人治」的国度，那我们不如自己想办法让风筝飞起来。"
        },
        {
          "role": "刻晴",
          "text": "况且，越是游玩体验轻松愉快，就会有越多的人参与进来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想法不错。",
              "dialogues": []
            },
            {
              "text": "支持！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏洛蒂",
          "text": "对吧？我也认为这个点子很新颖！而且成本也不高。"
        },
        {
          "role": "刻晴",
          "text": "托夏洛蒂小姐的福，合作一切顺利，新款械动式风筝已在港口摊点前开售，目前供应充足。"
        },
        {
          "role": "刻晴",
          "text": "定价方面我们也下了点功夫，相较传统风筝不会贵上多少。"
        },
        {
          "role": "派蒙",
          "text": "真好！原来刻晴、夏洛蒂还有凝光都像我一样喜欢玩具！"
        },
        {
          "role": "刻晴",
          "text": "玩具啊…这可真是…"
        },
        {
          "role": "夏洛蒂",
          "text": "你看吧，刻晴小姐，大家的第一反应都是这样的。"
        },
        {
          "role": "刻晴",
          "text": "嗯，不可否认，纵然风筝历史悠久，除了特殊典仪用途，它如今的形象更多停留在了「民间玩具」上…"
        },
        {
          "role": "刻晴",
          "text": "但在我眼中，它并不仅止于此。"
        },
        {
          "role": "刻晴",
          "text": "或许各位不太容易想象…又轻又薄，有一根线牵着就能飞上高空的纸风筝，同时也是承载着古今璃月风韵的宝物。"
        },
        {
          "role": "刻晴",
          "text": "我曾经在一本古诗集中读到过：「寄语纸鸢送愁客，天涯犹有未归人。」"
        },
        {
          "role": "刻晴",
          "text": "古时璃月诗人，常常借用风筝抒发思念之情，或是歌咏田园风光。"
        },
        {
          "role": "刻晴",
          "text": "如果今日我辈也能从这游乐之中撷取妙趣，我想，未来自会有更多人愿意领略并传承传统之美。"
        },
        {
          "role": "派蒙",
          "text": "不愧是刻晴，想的就是比我多呢。"
        },
        {
          "role": "夏洛蒂",
          "text": "很有学问！我也收获不小。"
        },
        {
          "role": "刻晴",
          "text": "哈哈，只要你们爱听就行。"
        },
        {
          "role": "刻晴",
          "text": "关于风筝的各类民俗故事，我也知道不少。"
        },
        {
          "role": "刻晴",
          "text": "好比以前大家每次看到意外飞走的风筝，就会说这是仙人用风带走了，图个口头上的吉利。"
        },
        {
          "role": "派蒙",
          "text": "还有什么好玩一点的吗？"
        },
        {
          "role": "刻晴",
          "text": "好玩…我想想。哦，那就要说起制作风筝了吧？这也是一种宝贵的传统手艺。"
        },
        {
          "role": "刻晴",
          "text": "我听我祖父说过，在他还是孩子的时候，风筝都是跟着长辈一步一步手工学做的。"
        },
        {
          "role": "刻晴",
          "text": "用细竹扎出骨架，在缃素纸上绘制心仪的图案，糊上纸，系好线…"
        },
        {
          "role": "刻晴",
          "text": "抬头仰望天空，将风筝亲手送到云朵旁。"
        },
        {
          "role": "刻晴",
          "text": "有的人会在风筝上写下名字或愿望，最后割断绳索，任由它们飞翔；有的则是选风筝纹样的时候，就寄托了自己的美好寓意。"
        },
        {
          "role": "夏洛蒂",
          "text": "纹样和寓意之间有什么关联吗？我想记录下来。"
        },
        {
          "role": "刻晴",
          "text": "嗯…比如蝴蝶纹样的风筝，多半与冲破束缚、追寻自由与幸福有关。"
        },
        {
          "role": "夏洛蒂",
          "text": "哇！还有吗？"
        },
        {
          "role": "刻晴",
          "text": "剪尾鸢是最经典的款式，象征着好运与喜报。根据颜色不同，还会有细微区分。"
        },
        {
          "role": "夏洛蒂",
          "text": "在璃月，这些寄语是约定俗成的吗？就像枫丹花卉的花语一样？"
        },
        {
          "role": "刻晴",
          "text": "我想是的。只要听家里长辈说起过的话，多少都知道吧。"
        },
        {
          "role": "刻晴",
          "text": "如果夏洛蒂小姐感兴趣的话，我可以将家中涉及这一选题的藏书找出来借给你，供你一并参考。"
        },
        {
          "role": "夏洛蒂",
          "text": "这会对我很有帮助的！"
        },
        {
          "role": "夏洛蒂",
          "text": "好！真实又生动的报道…我想好雏形了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "祝你顺利。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我们正好也想再多走走看看。"
        },
        {
          "role": "刻晴",
          "text": "嗯，那我就带夏洛蒂小姐来我家小坐片刻吧。"
        },
        {
          "role": "刻晴",
          "text": "对了，今年总务司举办了一场风筝比赛，时间就定在海灯节当夜。"
        },
        {
          "role": "刻晴",
          "text": "旅行者和派蒙感兴趣的话，欢迎你们带着风筝参加。"
        },
        {
          "role": "刻晴",
          "text": "规则也很简单。在规定时间内，谁的风筝飞得最高最远，就能得到一份特殊的荣誉，附赠神秘奖品。"
        },
        {
          "role": "夏洛蒂",
          "text": "我可是为这个晚上备足了空白画片的，我早就预见到了当晚的壮景！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一定支持！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "有奖励的地方就有我们！"
                }
              ]
            },
            {
              "text": "这份荣誉，我收下了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂，现在把话说得那么满，万一我们比不过别人怎么办？"
                },
                {
                  "role": "派蒙",
                  "text": "还不如先低调一点，等到最后…嘿嘿，出乎所有人的意料，把奖励弄到手！"
                }
              ]
            }
          ]
        },
        {
          "role": "刻晴",
          "text": "嗯，期待你们的表现。"
        },
        {
          "role": "派蒙",
          "text": "那就到时候见喽。"
        },
        {
          "type": "subtitle",
          "text": "刻晴和夏洛蒂一起离开了…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "旅行者，等一下！你看右手边，偷偷看…看到右边那两个人了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看到了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不知你有没有注意到，刚才和刻晴她们说话的时候，那两个人就一直在盯着我们看，神情很不自然。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕竟七星很受瞩目嘛。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？说是这么说…"
                },
                {
                  "role": "派蒙",
                  "text": "不对，我还是有点不放心。"
                }
              ]
            },
            {
              "text": "我也觉得有诈。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "太好了，我们想一起去了。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你说…他们会不会是盗宝团的人？以往海灯节总有盗宝团的人出来捣乱。"
        },
        {
          "role": "派蒙",
          "text": "我们不该再被动地等下去了，要先发制人，迅影如剑！"
        },
        {
          "role": "派蒙",
          "text": "我从左边，你从右边！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等等，派蒙！",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与可疑人物对话"
        },
        {
          "role": "？？？",
          "text": "嗯？"
        },
        {
          "role": "？？？",
          "text": "二位一副要缉拿我等的架势，这是何意？"
        },
        {
          "role": "派蒙",
          "text": "哇！这人说话怎么还文绉绉的。"
        },
        {
          "role": "派蒙",
          "text": "你才应该先交代你们是什么意思吧！"
        },
        {
          "role": "派蒙",
          "text": "鬼鬼祟祟地偷听别人聊天，一看就不是什么好人。快点老实交代，从名字开始！"
        },
        {
          "role": "？？？",
          "text": "这…"
        },
        {
          "role": "？？？",
          "text": "既是二位，倒也无需掩藏。我乃三眼五显仙人，削月筑阳真君。"
        },
        {
          "role": "侯章",
          "text": "此番游历人间，唤我「侯章」就好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "鬼才信咧！那只仙鹿多大的架子，他怎么可能亲自来璃月港啦。"
        },
        {
          "role": "？？？",
          "text": "咳，派蒙，少说两句…"
        },
        {
          "role": "派蒙",
          "text": "哼，别以为你知道我的名字我就会信你。你该不会想说自己是「理水叠山真君」吧？"
        },
        {
          "role": "接笏",
          "text": "正是如此！此番我与削月共访人间。二位称我「接笏」即可。"
        },
        {
          "role": "派蒙",
          "text": "他们调查工作做得不错，但根据我的经验，线长，说明想钓的鱼大！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们这就去找千岩军，把这两个冒名顶替仙人的坏家伙抓起来！"
        },
        {
          "role": "侯章",
          "text": "岂有此理，岂有此理！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "二位如此宣称…",
              "dialogues": []
            },
            {
              "text": "可有什么证据？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对呀，拿有力的事实出来！路上随便找个人都知道的那种可不能算。"
        },
        {
          "role": "接笏",
          "text": "唉…"
        },
        {
          "type": "subtitle",
          "text": "未参加3.4版本海灯节"
        },
        {
          "role": "接笏",
          "text": "我为求山门清净，在琥牢山周围种植「踱山葵」之事，你们总该记得吧？"
        },
        {
          "role": "接笏",
          "text": "要说这花的种子，还是出自歌尘浪市真君之手。我们之中，数她最擅园艺。"
        },
        {
          "role": "接笏",
          "text": "此花不枯不败，实用不假，难处在于每逢出门都需费尽心思打点一番…日积月累，连我也心力不支。"
        },
        {
          "role": "接笏",
          "text": "便进城问歌尘浪市讨了个生性温和、更好打理的花种。"
        },
        {
          "role": "侯章",
          "text": "途中却被几个孩童缠上。你不敢暴露真身，进退不得，最后还是歌尘浪市出面解的围。"
        },
        {
          "role": "接笏",
          "text": "这…"
        },
        {
          "role": "接笏",
          "text": "你怎会知道？"
        },
        {
          "role": "侯章",
          "text": "那位叫「瑶瑶」的女孩好心告诉了留云。"
        },
        {
          "role": "接笏",
          "text": "…唉，罢了罢了。木已成舟，木已成舟啊。"
        },
        {
          "type": "subtitle",
          "text": "参加过3.4版本海灯节"
        },
        {
          "role": "接笏",
          "text": "上回海灯节，帝君和我等在琥牢山，用留云的「烹饪神机」炖煮腌笃鲜之事，你们总该记得吧？"
        },
        {
          "role": "接笏",
          "text": "那速成腌笃鲜的滋味倒是不差。自那以后，我问留云借来机关，又讨了些食谱，偶尔寻些烹饪之趣。"
        },
        {
          "role": "侯章",
          "text": "「偶尔」？前日我上山做客时，你不是一见到我，就把机关藏进了身后的琥珀里吗？"
        },
        {
          "role": "接笏",
          "text": "这…"
        },
        {
          "role": "接笏",
          "text": "好你削月。方才我还为你说话，你怎能以怨报德？"
        },
        {
          "role": "侯章",
          "text": "是这二位不信在先。"
        },
        {
          "role": "接笏",
          "text": "那也不必漏这些家常里短出去，当真和留云成了一个模样。唉，罢了罢了，不与你争辩。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这么说来还真是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "都说到这个份上了…好吧，是我错怪你们了，对不起啦…"
        },
        {
          "role": "派蒙",
          "text": "你们就仙人肚里有大量，仙人肚里装山河！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是夸你们扮得像…",
              "dialogues": []
            },
            {
              "text": "普通人绝对看不出！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "侯章",
          "text": "旅行者你素来机敏，也不枉留云对你评价甚高。"
        },
        {
          "role": "派蒙",
          "text": "我还可以问吗？就是，那个…"
        },
        {
          "role": "派蒙",
          "text": "理水叠山还好说，削月筑阳你是怎么会进城里面来的呀？你不是一直都抹不开面子吗？"
        },
        {
          "role": "侯章",
          "text": "哼…"
        },
        {
          "role": "接笏",
          "text": "唉…"
        },
        {
          "role": "侯章&接笏",
          "text": "实属无奈…"
        },
        {
          "role": "接笏",
          "text": "自从留云也来了璃月港，山中清净，一日更复一日。"
        },
        {
          "role": "接笏",
          "text": "海灯节在即，我等原以为留云会提前交代今年的安排，怎想直至今日都未曾瞅见她的半点踪影。"
        },
        {
          "role": "侯章",
          "text": "留云可不是会忘事之人。"
        },
        {
          "role": "接笏",
          "text": "俗语说「山不转水转」。既然一众好友如今身居璃月港，我们二人也只能化为人形，结伴走这一趟，来城里寻找留云。"
        },
        {
          "role": "侯章",
          "text": "刚才听你们一众人聊起什么…械动式风筝，我们已对现状猜到一二，想来还是打道还府罢。"
        },
        {
          "role": "派蒙",
          "text": "欸？你们不找留云了吗？"
        },
        {
          "role": "接笏",
          "text": "派蒙有所不知。依照留云心性，近来她定是在这气头之上…"
        },
        {
          "role": "侯章",
          "text": "留云心高气傲，自诩机关术不输旁人，绝不会轻易认可这舶来的机关巧物。"
        },
        {
          "role": "接笏",
          "text": "想必她此刻正闭门谢客，费心钻研着自己的缥锦造物…我等就不自讨没趣了。"
        },
        {
          "role": "接笏",
          "text": "但如若未来几日，你们碰巧会见留云，就为我们带一声问候吧。"
        },
        {
          "role": "派蒙",
          "text": "也好，那就包在我们身上！"
        },
        {
          "role": "派蒙",
          "text": "那…二老回去路上慢慢走，多看看风景，也祝你们海灯节快乐呀。"
        },
        {
          "role": "侯章",
          "text": "嗯，好意心领，不必多送了。"
        },
        {
          "role": "派蒙",
          "text": "没想到是我瞎操心，弄半天都是自己人…"
        },
        {
          "role": "派蒙",
          "text": "趁时间早，我们还是去那边的风筝摊上逛一逛吧。"
        },
        {
          "role": "派蒙",
          "text": "我想看看有没有又大又漂亮的风筝，可以拿去参加比赛呢！"
        },
        {
          "type": "subtitle",
          "text": "前往风筝摊"
        },
        {
          "role": "枕鸢",
          "text": "欢迎欢迎，二位是来购置风筝的吗？需要我为你们简单介绍一下不同的款式吗？"
        },
        {
          "role": "派蒙",
          "text": "剪尾鸢、蝴蝶…欸？！"
        },
        {
          "role": "枕鸢",
          "text": "哦！这群玉阁图案的风筝是最新款，这两天卖得可好了。"
        },
        {
          "role": "派蒙",
          "text": "难不成它也有什么寓意吗？"
        },
        {
          "role": "枕鸢",
          "text": "当然。「群玉阁」寓意财源广进，祝福你在未来的日子里多多发财。"
        },
        {
          "role": "派蒙",
          "text": "哇！这个好！"
        },
        {
          "role": "陇舟",
          "text": "实在抱歉，容我插一句话。枕鸢小姐，你的货都准备好了吗？"
        },
        {
          "role": "枕鸢",
          "text": "哦哦，放在那边的就是。缃素纸、竹签、染料…都是扎风筝的东西。"
        },
        {
          "role": "陇舟",
          "text": "好，我来打包，这就联系镖师帮你送到遗珑埠去。"
        },
        {
          "role": "派蒙",
          "text": "遗珑埠？也不知道海灯节期间那边会是什么样，好想过去看一眼啊。"
        },
        {
          "role": "陇舟",
          "text": "你们对遗珑埠有兴趣吗？如果要去那边的话，能不能麻烦你们叫上嘉明，一起运送这批货物呢？"
        },
        {
          "role": "派蒙",
          "text": "嘉明就是你刚刚说的那位镖师？"
        },
        {
          "role": "陇舟",
          "text": "对，我们和记厅主要负责璃月地区的交通运输，而镖局是和记厅的下属机构。"
        },
        {
          "role": "陇舟",
          "text": "问题在于，海灯节期间，我的很多同事都请假回家、陪伴家人了，从事对接工作的人手一下子少了很多。"
        },
        {
          "role": "陇舟",
          "text": "要是你们愿意帮我这个忙，我就能提前去见下一位客户…"
        },
        {
          "role": "派蒙",
          "text": "听得出来，你是真的很赶时间…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们帮了。",
              "dialogues": [
                {
                  "role": "陇舟",
                  "text": "太好了！报酬不会少你们的！"
                }
              ]
            },
            {
              "text": "报酬还是要的。",
              "dialogues": [
                {
                  "role": "陇舟",
                  "text": "那是当然，肯定不会少你们的。"
                }
              ]
            }
          ]
        },
        {
          "role": "陇舟",
          "text": "这个时间点…嘉明他多半就在附近吧。沿大路直走，右手边，有舞兽戏的兽首那边。"
        },
        {
          "role": "枕鸢",
          "text": "想买风筝的话回头再来哦，我给二位打折。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（枕鸢）"
        },
        {
          "role": "枕鸢",
          "text": "说起来，你们认识我舅妈吗？大家都管她叫阿山婆。"
        },
        {
          "role": "枕鸢",
          "text": "舅妈她之前就跟我提起过嘉明，说他热情又健谈，是个好小伙。"
        },
        {
          "type": "subtitle",
          "text": "根据指引寻找嘉明"
        },
        {
          "role": "？？？",
          "text": "不是吧？说好的谁输谁请下一顿早茶，看把你气得脸都垮下来咯。"
        },
        {
          "role": "？？？",
          "text": "别难过了你，可以你请我喝，我来埋单的嘛。"
        },
        {
          "role": "遐庆",
          "text": "那不又跟平时一样了嘛！这怎么行，嘉明。"
        },
        {
          "role": "遐庆",
          "text": "我不是输不起。唉，我就是…就是没想到你会用那种方式翻盘！"
        },
        {
          "role": "嘉明",
          "text": "嘿嘿，小意思啦，玩这个跟吃生菜那样容易。"
        },
        {
          "role": "派蒙",
          "text": "太好了，嘉明就在这里！"
        },
        {
          "role": "派蒙",
          "text": "打扰一下，嘉明！刚才有一个「和记厅」的人，要托你送货去遗珑埠…"
        },
        {
          "role": "嘉明",
          "text": "哦哦，陇舟哥吗？有工作了，我走先。"
        },
        {
          "role": "遐庆",
          "text": "忙你的去吧。"
        },
        {
          "role": "遐庆",
          "text": "等你回来，有时间我们再玩，下回可不会让你再赢了。"
        },
        {
          "role": "嘉明",
          "text": "好咯，东西都拿来给我吧，路上运过来重不重？我来装我来装。"
        },
        {
          "role": "派蒙",
          "text": "还好啦。都是些扎风筝的材料，总共也就没几步路。"
        },
        {
          "role": "嘉明",
          "text": "风筝啊…懂了懂了。"
        },
        {
          "role": "嘉明",
          "text": "派蒙好客气哦，肯定要好好谢谢你们的嘛！"
        },
        {
          "role": "嘉明",
          "text": "你就是旅行者吧？你好你好！也要多谢你的热心！"
        },
        {
          "role": "派蒙",
          "text": "欸？原来你认识我们呀。"
        },
        {
          "role": "嘉明",
          "text": "哈哈，璃月不认识你们的人才少吧？我听很多人说起过你们的事，好有名气的呢你们！"
        },
        {
          "role": "嘉明",
          "text": "哦！要是陇舟哥没来得及道谢，千万别往心里去！我替他说。"
        },
        {
          "role": "嘉明",
          "text": "他人很好，就是这几天实在忙得不行，看他连赶路都是跑来跑去的…多多担待，嘿嘿。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没事。",
              "dialogues": []
            },
            {
              "text": "举手之劳而已。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "嘉明",
          "text": "来过海灯节的吗这次？"
        },
        {
          "role": "派蒙",
          "text": "是呀，每年这个时候都是最热闹的呢。我们还说想跟你一起过去遗珑埠那边看看。"
        },
        {
          "role": "嘉明",
          "text": "走啊走啊，一起咯。"
        },
        {
          "role": "嘉明",
          "text": "我路上熟得很，我带路，一点弯都不会给你们绕的。讲故事，讲笑话，聊天解闷，都可以。"
        },
        {
          "role": "嘉明",
          "text": "哦，沿途有几家馆子，都是我常去的好店，到饭点了一起随便吃吃啦？"
        },
        {
          "role": "嘉明",
          "text": "食材新鲜，用料又足，物美价廉，我保证怎么点都好吃的。"
        },
        {
          "role": "派蒙",
          "text": "保证好吃…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙口水已经要滴下来了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "在新朋友面前这样揭短很失礼欸！"
        },
        {
          "role": "嘉明",
          "text": "没关系的啦，我懂我懂，这说明感情好嘛。我和我兄弟也会这样调侃来调侃去的。"
        },
        {
          "role": "嘉明",
          "text": "还有什么要收拾的吗？我可以等你们。"
        },
        {
          "role": "派蒙",
          "text": "不用不用，我们一直在外面旅行，东西早就放在包里啦。"
        },
        {
          "role": "嘉明",
          "text": "哦！对哦。那就走咯，我也会保护好你们，毕竟我是镖师嘛。"
        },
        {
          "type": "subtitle",
          "text": "与嘉明共同前往沉玉谷地区"
        },
        {
          "type": "subtitle",
          "text": "未开启任务「仙山有茗，名以翘英」"
        },
        {
          "role": "嘉明",
          "text": "哦！你们刚才跑哪里去啦？一转眼人都不见了， 吓我一跳！"
        },
        {
          "role": "派蒙",
          "text": "啊，抱歉抱歉，我们刚才…唔，总觉得一两句话很难讲明白。"
        },
        {
          "role": "嘉明",
          "text": "好吧，这附近的山道不太好走，有时候还会起雾，记得要跟紧我咯！"
        },
        {
          "role": "派蒙",
          "text": "嗯，继续赶路吧！"
        },
        {
          "role": "嘉明",
          "text": "还有几步路就到码头了，迈多两步， 顶住啊。"
        },
        {
          "type": "subtitle",
          "text": "击败盗宝团"
        },
        {
          "role": "嘉明",
          "text": "等等！…你们往后靠，这里交给我。"
        },
        {
          "type": "subtitle",
          "text": "与嘉明对话"
        },
        {
          "role": "派蒙",
          "text": "呼，防不胜防，还真是走到哪里都少不了盗宝团啊…"
        },
        {
          "role": "嘉明",
          "text": "运镖路上遇到劫货的人是家常便饭啦，所以才需要我们镖师嘛。"
        },
        {
          "role": "派蒙",
          "text": "我看你的动作还挺有两下子的，很专业？"
        },
        {
          "role": "嘉明",
          "text": "哦！这就跟镖师的职业无关咯，是我自己的兴趣爱好。"
        },
        {
          "role": "嘉明",
          "text": "舞兽戏，你们听说过没有？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "略有耳闻。",
              "dialogues": []
            },
            {
              "text": "不太了解。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "嘉明",
          "text": "不是吧？舞兽戏在沉玉谷地区还是很有名的喔！"
        },
        {
          "role": "嘉明",
          "text": "谁家店铺开张了，谁家过节想拿个好意头，都会请人去表演。"
        },
        {
          "role": "嘉明",
          "text": "好吧，跟璃月戏是没得比的啦。"
        },
        {
          "role": "嘉明",
          "text": "我自己也知道，在璃月港，愿意看舞兽戏的人不多…我只能把它当个副业。"
        },
        {
          "role": "派蒙",
          "text": "啊？你还做副业？嘉明你精神那么好的吗？"
        },
        {
          "role": "嘉明",
          "text": "不累啊，休息下不就好了？"
        },
        {
          "role": "派蒙",
          "text": "我懂了，你天天睡到自然醒？"
        },
        {
          "role": "嘉明",
          "text": "没有哦，昨晚打牌还打通宵呢我。"
        },
        {
          "role": "派蒙",
          "text": "呃…"
        },
        {
          "role": "嘉明",
          "text": "走啦，码头就在前面，跟紧哦。"
        },
        {
          "type": "subtitle",
          "text": "前往码头"
        },
        {
          "type": "subtitle",
          "text": "嘉明上前和码头旁歇脚的船夫搭了几句话，转眼间，招呼大家坐上了竹筏…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "终于！可以静下来休息休息了。我的肩膀好僵硬，胃里好空虚…"
        },
        {
          "role": "嘉明",
          "text": "对不住对不住，赶路太快了？不是说一直在外面旅行的吗你。"
        },
        {
          "role": "派蒙",
          "text": "那就是璃月山路太多，飞得太累！我好不容易吃饱的肚子又要饿扁了…"
        },
        {
          "role": "嘉明",
          "text": "冬蓉酥，要吃吗？店里买的，不是我自己做的就是了。"
        },
        {
          "role": "派蒙",
          "text": "要！有多少来多少！"
        },
        {
          "role": "嘉明",
          "text": "不是吧，那么贪心？等下吃饱了吃不下正餐喔。"
        },
        {
          "role": "派蒙",
          "text": "我天生能吃！就像…就像你天生精神好，走多少路，干几份活都不觉得累。"
        },
        {
          "role": "嘉明",
          "text": "这我就懂了。来，派蒙，给，旅行者也有。"
        },
        {
          "role": "嘉明",
          "text": "泊溯伯，孝敬你的，放旁边了啊。"
        },
        {
          "role": "旅行者",
          "text": "（嘉明似乎人缘很好，无论和谁都能说上几句话，待每个人都像朋友那样。）"
        },
        {
          "role": "派蒙",
          "text": "啊，香香甜甜，我复活了。"
        },
        {
          "role": "嘉明",
          "text": "噗，有没有那么夸张啊？"
        },
        {
          "role": "嘉明",
          "text": "冬蓉酥我从小吃到大。街边小摊到城里的大酒楼，好多店都会做，但每家做出来的味道都会有细微的不一样。"
        },
        {
          "role": "嘉明",
          "text": "你喜欢的话，我回去之后查一查，把店铺地址写给你好咯。"
        },
        {
          "role": "嘉明",
          "text": "啊！会不会讲太多了，耽误你们安静地看风景？嫌我吵的话直说哦，不要不好意思，无所谓的。"
        },
        {
          "role": "派蒙",
          "text": "没事啦！听你像敲鼓一样哐啷哐当地说话还挺有趣的。"
        },
        {
          "role": "嘉明",
          "text": "派蒙一吃饱，心情就好？"
        },
        {
          "role": "派蒙",
          "text": "才不是这个原因啦！"
        },
        {
          "type": "subtitle",
          "text": "不知不觉沉浸在山水美景之中，回过神来时，遗珑埠的码头已经映入眼帘…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "哇，我们到啦！"
        },
        {
          "role": "嘉明",
          "text": "东西拿好先，下船时要看脚下，踩空了就要掉水里去咯。"
        },
        {
          "role": "嘉明",
          "text": "泊溯伯，多谢您，保重身体哦，我们回头再见啊。"
        },
        {
          "role": "嘉明",
          "text": "跟我来，走这边最近。镖局在上面，要坐升降梯上去。"
        },
        {
          "role": "嘉明",
          "text": "噓——走慢点拜托。"
        },
        {
          "role": "派蒙",
          "text": "出什么事了？街上那么热闹，已经不会再有人劫镖了吧？"
        },
        {
          "type": "subtitle",
          "text": "前往镖局"
        },
        {
          "role": "嘉明",
          "text": "呃，这个…唔，怎么说好咧…"
        },
        {
          "role": "派蒙",
          "text": "你倒是说啊？"
        },
        {
          "role": "嘉明",
          "text": "…看到那边几位阿婶阿婆阿叔阿伯了吗？"
        },
        {
          "role": "嘉明",
          "text": "都是我家亲戚。"
        },
        {
          "role": "派蒙",
          "text": "哇，那还真是好大一家子。"
        },
        {
          "role": "嘉明",
          "text": "他们买起东西来，不逛到天黑是不会回去的。这下完咯。"
        },
        {
          "role": "派蒙",
          "text": "是亲戚又不是仇人，有什么好怕的？难道说…你做了什么伤天害理的事！"
        },
        {
          "role": "嘉明",
          "text": "想什么呢你。"
        },
        {
          "role": "嘉明",
          "text": "我…纯粹是不太擅长应付自家亲戚。"
        },
        {
          "role": "嘉明",
          "text": "能避开的话，最好还是避开…"
        },
        {
          "role": "嘉明",
          "text": "有机会的话，我会跟你们好好解释的，但现在还是工作要紧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就偷偷溜过去吧。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "跟随嘉明，尽可能避开亲戚注意"
        },
        {
          "role": "派蒙",
          "text": "左边人多，我们直走。"
        },
        {
          "role": "派蒙",
          "text": "慢一点~慢一点~"
        },
        {
          "role": "嘉明",
          "text": "在这等下先，看看阿婶会不会走。"
        },
        {
          "role": "派蒙",
          "text": "阿婶走了，我们赶紧！"
        },
        {
          "role": "嘉明",
          "text": "往左拐，跑起来！"
        },
        {
          "role": "嘉明",
          "text": "右手边，我们到了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（风涟）"
        },
        {
          "role": "风涟",
          "text": "海灯节促销，海灯节促销，「松萝仙芽」，上好的茶，翘英庄直送。"
        },
        {
          "role": "风涟",
          "text": "三盒九折，四盒八折…十盒半价啦。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（距离过远）"
        },
        {
          "role": "嘉明",
          "text": "旅行者！别离我太远。"
        },
        {
          "type": "subtitle",
          "text": "避开亲戚"
        },
        {
          "role": "嘉明",
          "text": "你们身手很好嘛，佩服佩服。"
        },
        {
          "role": "派蒙",
          "text": "这点根本算不上什么啦！就跟冬蓉酥一样，两三口就搞定了。"
        },
        {
          "role": "嘉明",
          "text": "那么喜欢？那我给你买一座小山那么高的冬蓉酥，把你堆在中间咯。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，要记得让我露出脑袋哦！"
        },
        {
          "type": "subtitle",
          "text": "被发现"
        },
        {
          "role": "派蒙",
          "text": "糟糕！被发现了！"
        },
        {
          "type": "subtitle",
          "text": "面对嘉明的亲戚"
        },
        {
          "type": "subtitle",
          "text": "「是嘉明啊！」",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "一声高呼过后，众多亲戚围了上来…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "阿婆",
          "text": "嘉明，你什么时候回来的呀？哎呀，怎么又瘦了！这次要在遗珑埠待多久呀？"
        },
        {
          "role": "阿婶",
          "text": "工作很辛苦吧？要多回家看看的哦。"
        },
        {
          "role": "阿伯",
          "text": "上回问起你爹的时候他还念叨你呢，脸沉得很，又给你爹惹祸了？"
        },
        {
          "role": "嘉明",
          "text": "啊哈哈，哈哈…"
        },
        {
          "type": "subtitle",
          "text": "费了一番口舌，才从嘉明亲戚的包围圈中脱身…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "太可怕了…连我也插不上话。"
        },
        {
          "role": "嘉明",
          "text": "对不住啦，其实他们人都是好人…"
        },
        {
          "role": "嘉明",
          "text": "呼…不想了，把东西送到先。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那就等你什么时候想讲了再讲。"
        },
        {
          "type": "subtitle",
          "text": "前往镖局，送达货物"
        },
        {
          "role": "嘉明",
          "text": "知贵叔，我来咯。这两位是我朋友，旅行者和派蒙，和我一起送货过来的。"
        },
        {
          "role": "嘉明",
          "text": "那我把货放去永赞伯那里咯？"
        },
        {
          "role": "知贵",
          "text": "好，有劳你了。"
        },
        {
          "role": "知贵",
          "text": "也辛苦你们二位了。我去倒点茶，先坐一会儿歇歇脚吧？"
        },
        {
          "role": "派蒙",
          "text": "没事没事，我们等下就走了。"
        },
        {
          "role": "嘉明",
          "text": "哎呀，来都来咯，说坐一坐就坐一坐嘛。我们镖局的「松萝仙芽」很正宗的，包你喝完返寻味。"
        },
        {
          "role": "嘉明",
          "text": "知贵叔也坐。哪能让你落手落脚跑前跑后哦，我来我来。"
        },
        {
          "role": "嘉明",
          "text": "两件事情也就是一个前脚一个后脚，我一起办了，马上就好。"
        },
        {
          "role": "嘉明",
          "text": "旅行者没什么忌口，对吧？派蒙口味偏甜，茶我给你泡淡一点，加两件茶酥点心。"
        },
        {
          "role": "派蒙",
          "text": "欸？这你都记住了吗？"
        },
        {
          "role": "知贵",
          "text": "你们和嘉明，认识多长时间了呀？"
        },
        {
          "role": "派蒙",
          "text": "不久不久，碰巧一起来遗珑埠的嘛。"
        },
        {
          "role": "派蒙",
          "text": "主要还是他待人热情，我们没聊几句就交上朋友了。"
        },
        {
          "role": "知贵",
          "text": "哈哈，这孩子是这样。记性好，又在人际关系上处处留心。"
        },
        {
          "role": "知贵",
          "text": "我们有个老镖师，前些阵子下雨，请了一天假，说是骨头酸。"
        },
        {
          "role": "知贵",
          "text": "嘉明他还特地去不卜庐找白先生开了膏药的方子，连夜给老头子送了过去。"
        },
        {
          "role": "知贵",
          "text": "你说，这样的好小伙，大家能不疼吗？"
        },
        {
          "role": "知贵",
          "text": "也就他家里…"
        },
        {
          "role": "嘉明",
          "text": "知贵叔，永赞伯说最近腾不出人手送件了。干脆我去送到人家家里吧？"
        },
        {
          "role": "知贵",
          "text": "这多麻烦你啊。"
        },
        {
          "role": "嘉明",
          "text": "扎风筝的材料，说不定是给家里孩子玩的。"
        },
        {
          "role": "嘉明",
          "text": "这个时间点寄东西，肯定是想在海灯节前送到的嘛。"
        },
        {
          "role": "嘉明",
          "text": "哦！来来，喝口茶先。"
        },
        {
          "type": "subtitle",
          "text": "「松萝仙芽」茶香清雅，回味悠远，令人精神为之一振…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "知贵",
          "text": "好吧，那你想送就送吧。"
        },
        {
          "role": "嘉明",
          "text": "你们后天早上得闲吗？去新月轩喝个早茶怎么样？我埋单我埋单。"
        },
        {
          "role": "派蒙",
          "text": "哎呀…这么客气。"
        },
        {
          "role": "嘉明",
          "text": "应该的，毕竟给你们添了麻烦。再说，我家里那个情况，一匹布那么长，还得坐下来慢慢说…"
        },
        {
          "role": "派蒙",
          "text": "好呀，只要有吃的我就不会拒绝！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就新月轩店里见。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "嘉明",
          "text": "行，那我走咯，后天见。派蒙要留好肚子啊，别怪我不提醒。"
        },
        {
          "role": "派蒙",
          "text": "他是不是瞧不起我？那我倒要让他见识见识——我的肚量！"
        },
        {
          "role": "派蒙",
          "text": "说回来。嘉明的家庭情况，真的有那么复杂吗？"
        },
        {
          "role": "派蒙",
          "text": "以嘉明这种乐呵呵的性格…加上他腿脚又麻利，干活也算仔细。好难想象会有什么矛盾啊…"
        },
        {
          "role": "知贵",
          "text": "嗯…怎么说呢…"
        },
        {
          "role": "知贵",
          "text": "既然他自己都准备跟你们说这件事了，我这个大叔就不多嘴多舌了。"
        },
        {
          "role": "知贵",
          "text": "我看你们两个年龄相仿，说不定挺有共同语言。"
        },
        {
          "role": "知贵",
          "text": "要是你乐意，就帮我劝他几句…这件事算我托你了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我试试。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "大叔你有时间不如去做一面小旗子送给我们。"
        },
        {
          "role": "派蒙",
          "text": "上面就写好——「助人为乐」。"
        },
        {
          "role": "知贵",
          "text": "那我真去托人做了哦？二位还有什么要求，还要印什么字吗？"
        },
        {
          "role": "派蒙",
          "text": "不是吧？我只是开个玩笑先…"
        },
        {
          "role": "知贵",
          "text": "哈哈哈，小语气学得太像嘉明了。"
        },
        {
          "role": "知贵",
          "text": "茶还有吗？要不要给你们再加一点？"
        },
        {
          "role": "派蒙",
          "text": "不用啦。好不容易过来一次，我们还想去码头那边看几眼，刚刚躲亲戚的路上瞟到了好多小摊呢。"
        },
        {
          "role": "派蒙",
          "text": "说不定会有璃月港没有的风筝！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你倒是会安排。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "知贵",
          "text": "行，那你们请便。要加茶和我说，想歇歇脚的话，坐多久都可以。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（知贵）"
        },
        {
          "role": "知贵",
          "text": "嘉明这个孩子啊，什么都好，唯独那点让人操心。"
        },
        {
          "role": "知贵",
          "text": "你们是同龄人，说话他应该听得进去，就拜托你多劝劝他了。"
        },
        {
          "type": "subtitle",
          "text": "在遗珑埠码头逛逛"
        },
        {
          "role": "派蒙",
          "text": "啊！怎么是你？"
        },
        {
          "role": "闲云",
          "text": "这话说的，见到本仙还不乐意了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "留云借风真君好。",
              "dialogues": []
            },
            {
              "text": "闲云好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "闲云",
          "text": "学学人家，这才是对待长辈应有的尊敬。"
        },
        {
          "role": "派蒙",
          "text": "还倚老卖老起来了…"
        },
        {
          "role": "派蒙",
          "text": "我说闲云，你这个时候不应该缩在洞府里敲敲打打，研究你的机关风筝嘛。怎么会有心思出远门？"
        },
        {
          "role": "派蒙",
          "text": "身边还摆着这么大一个箱子…啊，你这是…你这是在逛街购物啊！"
        },
        {
          "role": "闲云",
          "text": "是又如何？"
        },
        {
          "role": "闲云",
          "text": "七星引进枫丹技术办风筝比赛，跟本仙有什么关系。"
        },
        {
          "role": "闲云",
          "text": "在你们眼中，本仙是会跟世俗风潮竞争攀比、乃至怄气的人吗？"
        },
        {
          "role": "派蒙",
          "text": "呃…不是我猜的啊，是理水和削月说的！他们给自己起了拗口的名字…一点都不好记。"
        },
        {
          "role": "派蒙",
          "text": "总之，那两位来城里找你，还让我们向你问好呢。"
        },
        {
          "role": "闲云",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "闲云？"
        },
        {
          "role": "闲云",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "该不会…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "闲云",
          "text": "（自从来了璃月港，这一天天的连时间都变快了不少。怎么就把这俩老家伙给忘了。）"
        },
        {
          "role": "闲云",
          "text": "（给他们带点仙草作为赔礼吧…不，难得来一回遗珑埠，还是选些茶叶为好。）"
        },
        {
          "role": "闲云",
          "text": "本仙灵光一现，想起另有一些东西需要购置。"
        },
        {
          "role": "闲云",
          "text": "你们不妨在此稍待片刻，本仙去去就来。"
        },
        {
          "role": "派蒙",
          "text": "欸？等等啊？就留我们给你看东西？"
        },
        {
          "role": "派蒙",
          "text": "这个女人来去如风，真是自由。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我跟上去看看。",
              "dialogues": []
            },
            {
              "text": "拜托派蒙看箱子了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "喂…别在这种地方学那么快啊！"
        },
        {
          "role": "派蒙",
          "text": "你要快点回来哦！我…我怕有人来抢！"
        },
        {
          "role": "风涟",
          "text": "瞧一瞧喽看一看，「松萝仙芽」，上好的茶，翘英庄直送。客人您要买茶叶吗？"
        },
        {
          "role": "闲云",
          "text": "（听着不错。给那两位各带一份就好了吧…）"
        },
        {
          "role": "闲云",
          "text": "来两盒。"
        },
        {
          "role": "风涟",
          "text": "好咧，这位客人。小店正在搞海灯节促销，三盒九折，四盒八折…"
        },
        {
          "role": "闲云",
          "text": "（四盒八折？很合算啊。给帝君和阿萍也各送一份吧。）"
        },
        {
          "role": "闲云",
          "text": "那就来四盒。"
        },
        {
          "role": "风涟",
          "text": "哟，客人是要拿去送人吗？那不如买小店这边的精美礼盒套装，十份半价。"
        },
        {
          "role": "风涟",
          "text": "您看看，这礼盒多精美啊！打了红丝带，更添喜庆。走亲访友的时候拿去送人，倍有面子。"
        },
        {
          "role": "闲云",
          "text": "（十盒…是不是有点多了？但要是把降魔大圣和我那几个徒弟都算上…）"
        },
        {
          "role": "闲云",
          "text": "嗯…"
        },
        {
          "role": "风涟",
          "text": "您想想，十这数字多吉利，十全十美啊。我再给您抹个零头？"
        },
        {
          "role": "闲云",
          "text": "也好，那就给本仙…给我装上吧。"
        },
        {
          "role": "风涟",
          "text": "好咧好咧。"
        },
        {
          "role": "沙博尼耶",
          "text": "这位女士真有眼光，请您也来我这边看看吧！"
        },
        {
          "role": "沙博尼耶",
          "text": "我是从枫丹来的玩具商人，我这里卖的玩具全靠发条驱动，精致小巧，妙趣横生…"
        },
        {
          "role": "闲云",
          "text": "…哼。"
        },
        {
          "role": "闲云",
          "text": "你倒说说，这妙趣在哪？"
        },
        {
          "role": "沙博尼耶",
          "text": "这…玩具玩具，当然是要玩了才知道。稍等，我给您拿出来展示。"
        },
        {
          "role": "闲云",
          "text": "……！"
        },
        {
          "role": "闲云",
          "text": "咳咳…不必了。"
        },
        {
          "role": "沙博尼耶",
          "text": "呃，女士…"
        },
        {
          "role": "闲云",
          "text": "最新、最好的款式，拿一个，包装得严实些。"
        },
        {
          "role": "沙博尼耶",
          "text": "啊，好的…给您。"
        },
        {
          "role": "沙博尼耶",
          "text": "说明书在…"
        },
        {
          "role": "闲云",
          "text": "不用了，多谢。"
        },
        {
          "role": "闲云",
          "text": "（这里人多眼杂。要是被旁人看见本仙特意为年轻人的机巧玩物驻足，那可成何体统。）"
        },
        {
          "role": "闲云",
          "text": "（偷偷带回去研究吧…）"
        },
        {
          "role": "旅行者",
          "text": "（趁闲云没有发现，赶紧回去吧…）"
        },
        {
          "role": "派蒙",
          "text": "噢！闲云，购物顺利吗？"
        },
        {
          "role": "闲云",
          "text": "那是自然。本仙不喜交际，又不是不会交际。"
        },
        {
          "role": "旅行者",
          "text": "（闲云很容易被推销手段打动…一眼看过去，箱子已经快被塞满了。）"
        },
        {
          "role": "闲云",
          "text": "你们呢？来这不买东西吗？"
        },
        {
          "role": "派蒙",
          "text": "还没来得及逛，但看起来，遗珑埠好像都没有风筝摊…反而有不少枫丹来的货品。"
        },
        {
          "role": "闲云",
          "text": "你们该不会也想参加那个风筝比赛吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "闲云",
          "text": "咳，我是说…孩子们都想参加。"
        },
        {
          "role": "闲云",
          "text": "一会儿又蹦又跳，一会儿可怜兮兮地在人跟前转悠着不肯走，这谁能招架？"
        },
        {
          "role": "闲云",
          "text": "本仙不得已，准备开个手工风筝兴趣小组，亲手教大家扎风筝。"
        },
        {
          "role": "派蒙",
          "text": "哦，都有谁参加啊？"
        },
        {
          "role": "闲云",
          "text": "漱玉，还有申鹤、甘雨和瑶瑶。"
        },
        {
          "role": "派蒙",
          "text": "还真是好多人！"
        },
        {
          "role": "派蒙",
          "text": "而且，闲云，你人还怪好的嘛。只是想参加比赛的话，明明买现成的风筝就可以打发了。"
        },
        {
          "role": "闲云",
          "text": "哈，什么械动式垂直拉升装置，只是凡众所造的粗砺机关罢了。"
        },
        {
          "role": "闲云",
          "text": "本仙所研之千年机关妙术，不说以仙源为驱，就单论本仙所造的机关构结吧。"
        },
        {
          "role": "闲云",
          "text": "构结之材轻如竹坚如铁，掷于天际，亦可凭风遨游万里。再说其中构结之法、循六结十二道…"
        },
        {
          "role": "闲云",
          "text": "…咳！罢了，就算与你们说了，只怕你们也听不懂，白费本仙口舌。"
        },
        {
          "role": "派蒙",
          "text": "你明明说得很畅快，像是在肚子里憋了好久…"
        },
        {
          "role": "闲云",
          "text": "…你们到底要不要来？"
        },
        {
          "role": "派蒙",
          "text": "欸…啊？原来你一直在邀请我们啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我挺有兴趣。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "闲云",
          "text": "好。材料不劳烦你们准备，本仙一手张罗。"
        },
        {
          "role": "闲云",
          "text": "后日下午，奥藏山见。"
        },
        {
          "role": "派蒙",
          "text": "闲云这就要走了吗？那么大一个木箱，不需要请个镖师帮你送送吗？"
        },
        {
          "role": "闲云",
          "text": "笑话。本仙来去自如，何须仰赖他人。"
        },
        {
          "role": "派蒙",
          "text": "啊？！这箱子…原来是能自己飘起来的啊？怎么会有这种发明？"
        },
        {
          "role": "闲云",
          "text": "其名为「流木运物神机」。"
        },
        {
          "role": "派蒙",
          "text": "…呃。她好自豪。"
        },
        {
          "role": "派蒙",
          "text": "她走路的样子倒是很潇洒啦，但周围的人都在用奇怪的眼神看她。唉，不管了…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我跟你说哦，她的箱子里有好多械动式…什么装置！"
        },
        {
          "role": "派蒙",
          "text": "不是我要偷看的！我没飞稳，不小心碰到最上面的锦缎…"
        },
        {
          "role": "派蒙",
          "text": "连带着里面的东西都差点咕噜一下滑出来，我还帮忙扶了呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "唉，你啊你。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这个女人还真要面子…"
        },
        {
          "role": "派蒙",
          "text": "嘴上说着什么粗砺机关，肯定是想买回去拆开看看里面装了什么。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "符合她的作风。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯。但是，为了照顾她的心情，我们就装不知道好了。"
        },
        {
          "role": "派蒙",
          "text": "这才是对待长辈应有的尊敬，对吧？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（沙博尼耶）"
        },
        {
          "role": "沙博尼耶",
          "text": "怎么稀里糊涂就卖出去了…璃月客人关心的到底是哪个部分？"
        },
        {
          "role": "沙博尼耶",
          "text": "我是不是也应该弄些…打折促销？"
        }
      ],
