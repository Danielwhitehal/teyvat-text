{
  "quest_id": 74249,
  "chapter_num": null,
  "chapter_title": "为了枫丹！",
  "type": "wq",
  "route": "For Fontaine!",
  "stories": [
    {
      "story_id": 74249,
      "title": "为了枫丹！",
      "description": "前往欧庇克莱歌剧院喷泉附近放置茶桌并使用桑多涅落座后，与芙宁娜共度茶会时光吧…",
      "dialogues": [
        {
          "role": "芙宁娜",
          "text": "这次也是让吉约丹小姐准备茶水点心，还真是不好意思。"
        },
        {
          "role": "「木偶」",
          "text": "没关系，前不久的千灵映影节也多亏了芙宁娜导演的关照。"
        },
        {
          "role": "芙宁娜",
          "text": "哪有哪有，我觉得了不起的是演员们才对。"
        },
        {
          "role": "「木偶」",
          "text": "芙宁娜小姐以后也不准备参与表演类的活动了吗？"
        },
        {
          "role": "芙宁娜",
          "text": "唔…也不是说一定不能吧。只不过现在的我更想退居幕后。"
        },
        {
          "role": "「木偶」",
          "text": "实不相瞒，在我还生活在枫丹的时候，就知道有您这位人人喜爱的大明星了。"
        },
        {
          "role": "芙宁娜",
          "text": "呃停停停！千万别说什么是看着我的表演长大的，每次都觉得怪别扭…"
        },
        {
          "role": "「木偶」",
          "text": "哦，这倒不是。我只是想说，在离开枫丹时，我也有幸见过那时的芙宁娜小姐。"
        },
        {
          "role": "「木偶」",
          "text": "但这次接触下来后，我还是觉得现在芙宁娜小姐的样子更好一些。"
        },
        {
          "role": "芙宁娜",
          "text": "欸…？现在的样子？"
        },
        {
          "role": "「木偶」",
          "text": "嗯，台上的你好像总是绷得紧紧的，现在让人感觉自在了不少。"
        },
        {
          "role": "芙宁娜",
          "text": "哈…谢谢你能这么说。我其实也更喜欢现在的生活。"
        },
        {
          "role": "芙宁娜",
          "text": "吉约丹小姐呢？现在的生活还满意吗？比起离开枫丹那时来说。"
        },
        {
          "role": "「木偶」",
          "text": "挺好的，但这更多是心境上的变化吧。我其实一直都挺喜欢枫丹这个家乡。"
        },
        {
          "role": "「木偶」",
          "text": "倒不是说它比其他国家都好，只是它承载了我们的回忆。这里的生活有时如水一般平静，有时又充满令人新奇的变化。"
        },
        {
          "role": "「木偶」",
          "text": "我最近学会了去看到生活中好的一方面。我猜，其他地方的人或多或少也是这么看待自己国家的吧。"
        },
        {
          "role": "芙宁娜",
          "text": "哎，说得真好啊，吉约丹小姐。"
        },
        {
          "role": "芙宁娜",
          "text": "虽然这么做不太符合茶会的礼仪，但…为了枫丹！"
        },
        {
          "role": "「木偶」",
          "text": "哈哈…为了家乡。"
        },
        {
          "role": "芙宁娜",
          "text": "嗯！这种悠闲的下午茶时光怎么都过不腻呢。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "芙宁娜",
          "text": "嗯，欢乐的时光过得可真快啊。"
        }
      ]
    }
  ]
}