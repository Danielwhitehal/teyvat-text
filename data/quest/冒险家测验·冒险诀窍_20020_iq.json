{
  "quest_id": 20020,
  "chapter_num": null,
  "chapter_title": "冒险家测验·冒险诀窍",
  "type": "iq",
  "route": "Adventurer Exam: The Art of Adventure",
  "stories": [
    {
      "story_id": 20020,
      "title": "冒险家测验·冒险诀窍",
      "description": "蒙德城的安娜真的想要成为冒险家…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "安娜",
          "text": "原来如此，原来如此…"
        },
        {
          "role": "安娜",
          "text": "哥，你知道这些植物除了做菜之外的用途吗？"
        },
        {
          "role": "安东尼",
          "text": "我怎么可能知道…"
        },
        {
          "role": "安东尼",
          "text": "我只知道在哪可以采到它们，还有它们到底能不能吃。"
        },
        {
          "role": "安娜",
          "text": "唔…那我就自己出去看看好了，放心啦哥，我只是去采集植物，绝对不会靠近魔物的。"
        },
        {
          "role": "安东尼",
          "text": "唉，你自己心里有点数就好。"
        },
        {
          "role": "安娜",
          "text": "我知道啦。那我今天可要晚点回来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还在训练吗？",
              "dialogues": []
            },
            {
              "text": "你训练得怎么样了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安娜",
          "text": "旅行者！你来得正好，我正准备去野外观察植物呢。"
        },
        {
          "role": "安娜",
          "text": "塞琉斯叔叔和我说，冒险家会经常在野外露宿，寻找食物是一项很重要的能力。"
        },
        {
          "role": "安娜",
          "text": "所以，我打算先去观察一下野外的植物，把它们的分布点和特性都记录好，再慢慢背下来。"
        },
        {
          "role": "安娜",
          "text": "这样子，以后我在野外寻找食物的时候，至少知道哪些植物能吃，哪些植物不能吃了。"
        },
        {
          "role": "安娜",
          "text": "但是…光用文字描述的话，我觉得实在不够直观。"
        },
        {
          "role": "安娜",
          "text": "旅行者，我听说你有一种叫做「留影机」的东西，对吧？"
        },
        {
          "role": "安娜",
          "text": "能不能请你帮我用「留影机」记录一下几种植物的生长环境？"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "安娜",
          "text": "那就请你先帮我去记录一下嘟嘟莲，小灯草，还有塞西莉亚花的生长环境吧。"
        },
        {
          "role": "安娜",
          "text": "然后再把这三种植物采下来带给我，我要把它们做成标本保存下来。"
        },
        {
          "role": "安娜",
          "text": "植物生长环境的记录画片、真实的植物标本，还有详细的文字说明…"
        },
        {
          "role": "安娜",
          "text": "我的「冒险家植物笔记」读起来一定会很不错的！"
        },
        {
          "role": "安娜",
          "text": "那就拜托你啦，旅行者。"
        },
        {
          "role": "安娜",
          "text": "清泉镇的那潭泉水旁应该有很多嘟嘟莲，小灯草能在奔狼领里找到。"
        },
        {
          "role": "安娜",
          "text": "塞西莉亚花嘛…那当然要去摘星崖啦。"
        },
        {
          "role": "安娜",
          "text": "我得去其他的地方继续观察植物。"
        },
        {
          "role": "安娜",
          "text": "等你拍到了画片，我们还是在城里碰头。"
        },
        {
          "type": "subtitle",
          "text": "拍摄画片，记录嘟嘟莲的生长环境"
        },
        {
          "type": "subtitle",
          "text": "采摘嘟嘟莲"
        },
        {
          "type": "subtitle",
          "text": "拍摄画片，记录小灯草的生长环境"
        },
        {
          "type": "subtitle",
          "text": "采摘小灯草"
        },
        {
          "type": "subtitle",
          "text": "拍摄画片，记录塞西莉亚花的生长环境"
        },
        {
          "type": "subtitle",
          "text": "采摘塞西莉亚花"
        },
        {
          "type": "subtitle",
          "text": "向安娜回报"
        },
        {
          "role": "安娜",
          "text": "旅行者，你已经回来了啊，怎么样？你拍到画片了吗？"
        },
        {
          "role": "旅行者",
          "text": "全部拍好了，还都采来了。"
        },
        {
          "role": "安娜",
          "text": "哇！你怎么能这么快全部拍好的…这就是经验丰富的冒险家吗？真厉害啊…"
        },
        {
          "role": "安娜",
          "text": "谢谢你，旅行者！嗯…这样吧，为了感谢你，我来亲手做一道好菜给你吧。"
        },
        {
          "role": "安娜",
          "text": "怎么样，看起来还不错吧，要好好品尝啊。"
        },
        {
          "role": "安娜",
          "text": "我回去接着写笔记去了。嗯…这些植物的话…"
        },
        {
          "role": "安娜",
          "text": "我得去问问杰克，看他知不知道怎么做植物标本。"
        },
        {
          "role": "安娜",
          "text": "塞西莉亚花就不做标本了，插在花瓶里好了…"
        }
      ]
    }
  ]
}