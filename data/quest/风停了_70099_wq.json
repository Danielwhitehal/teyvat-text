{
  "quest_id": 70099,
  "chapter_num": null,
  "chapter_title": "风停了",
  "type": "wq",
  "route": "The Wind Has Ceased",
  "stories": [
    {
      "story_id": 70099,
      "title": "风停了",
      "description": "风息山上有一座废弃的疗养院…",
      "dialogues": [
        {
          "role": "曼恩",
          "text": "真是好话难劝想死的鬼啊。都说了现在不能上山。"
        },
        {
          "role": "霍夫曼",
          "text": "哎哎，曼恩大爷，你别这么激动。好好说话，好好说话。"
        },
        {
          "role": "莉普哈特",
          "text": "之前我和这位大爷在暗夜之酿聊得还好好的呢。"
        },
        {
          "role": "莉普哈特",
          "text": "他一听说我要去风息山就开始拽着我了，一路拉扯都走到这里来了。"
        },
        {
          "role": "派蒙",
          "text": "咦，是霍夫曼啊。这里发生什么了吗？"
        },
        {
          "role": "霍夫曼",
          "text": "如你所见，曼恩大爷正在力劝人们远离风息山呢。"
        },
        {
          "role": "霍夫曼",
          "text": "介绍一下，这位是冒险家莉普哈特。"
        },
        {
          "role": "曼恩",
          "text": "我的亲身经历可是很吓人的！你们真的要听吗？"
        },
        {
          "role": "莉普哈特",
          "text": "好嘛，我感觉今天是走不了了。那听听吧，就当是刚才喝酒吹牛的延续了。"
        },
        {
          "role": "莉普哈特",
          "text": "我来看看究竟是怎么个危险法。"
        },
        {
          "role": "曼恩",
          "text": "疗养院里真的有鬼！我亲眼看见的！"
        },
        {
          "role": "派蒙",
          "text": "哇，鬼！"
        },
        {
          "role": "曼恩",
          "text": "昨天晚上的事情是这样的…"
        }
      ]
    }
  ]
}