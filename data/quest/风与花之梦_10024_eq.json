{
  "quest_id": 10024,
  "chapter_num": "风花节 其四",
  "chapter_title": "风与花之梦",
  "type": "eq",
  "route": "Dream of Wind and Flowers",
  "stories": [
    {
      "story_id": 41413,
      "title": "风与花之梦",
      "description": "因对蒙德城的贡献，你被选为本届「风花节之星」，将代表蒙德人民向风神巴巴托斯献上你所认定的「风之花」。不过，「风之花」究竟是什么呢？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到约定的时间，前往蒙德广场"
        },
        {
          "type": "subtitle",
          "text": "与琴对话"
        },
        {
          "role": "派蒙",
          "text": "琴团长，我们来啦。"
        },
        {
          "role": "琴",
          "text": "旅行者！啊，不，这里或许该称呼你为荣誉骑士。"
        },
        {
          "role": "琴",
          "text": "想必你已经听说了，你是本届的「风花节之星」，将代表全蒙德人向风神巴巴托斯献上「风之花」。"
        },
        {
          "role": "琴",
          "text": "不过…这次似乎略有不同呢。"
        },
        {
          "role": "派蒙",
          "text": "有我们，还有卖唱的，这次风花节是不是格外热闹呀！"
        },
        {
          "role": "琴",
          "text": "是的。感谢你们常驻蒙德，也希望你们今后继续享受在蒙德的生活。"
        },
        {
          "role": "琴",
          "text": "风花典礼快要开始了。风花节之星，选好属于你的「风之花」了吗？"
        },
        {
          "role": "派蒙",
          "text": "我们必须选出一种花，把它献给风神，对吗？"
        },
        {
          "role": "琴",
          "text": "没错，请你慎重考虑之后做出选择。别忘了，你的选择代表着全蒙德。"
        },
        {
          "role": "旅行者",
          "text": "温迪，你喜欢什么花？"
        },
        {
          "role": "温迪",
          "text": "嗯？好狡猾呀，居然直接问我。"
        },
        {
          "role": "琴",
          "text": "咳咳…"
        },
        {
          "role": "派蒙",
          "text": "不要在这种场合说悄悄话啦你们两个！"
        },
        {
          "role": "温迪",
          "text": "哈哈，被训了呢！"
        },
        {
          "role": "温迪",
          "text": "不用在意我，选喜欢的就好。我相信你的品味。"
        },
        {
          "role": "琴",
          "text": "那么，荣誉骑士，你的选择是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "蒲公英",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦！支持者众多的热门选择，「风之花」一定就是蒲公英啦！"
                }
              ]
            },
            {
              "text": "风车菊",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦！是支持者众多的热门选择，「风之花」一定就是风车菊啦！"
                }
              ]
            },
            {
              "text": "塞西莉亚花",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦！与贝雅特丽奇意见一致，「风之花」是较为冷门却有着坚定拥护者的塞西莉亚花！"
                }
              ]
            },
            {
              "text": "小灯草",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦！与宁禄意见一致，「风之花」是能照亮黑暗的小灯草！"
                }
              ]
            },
            {
              "text": "甜甜花",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦！与砂糖意见一致，「风之花」是从古到今生生不息的甜甜花！"
                }
              ]
            },
            {
              "text": "钩钩果",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦！与雷泽意见一致，「风之花」是刺刺的麻麻的钩钩果！"
                }
              ]
            }
          ]
        },
        {
          "role": "琴",
          "text": "请代表蒙德人，向神像献上你的「风之花」。"
        },
        {
          "type": "subtitle",
          "text": "向风神献上「风之花」"
        },
        {
          "role": "温迪",
          "text": "今年的「风之花」会是什么花呢？好期待啊。"
        },
        {
          "role": "琴",
          "text": "遵循心意，选择你所认可的「风之花」吧。"
        },
        {
          "role": "琴",
          "text": "愿风送去我们的祝福与赞美。"
        },
        {
          "role": "观察蒲公英",
          "text": "祭坛上的蒲公英正随微风轻轻摇摆…"
        },
        {
          "role": "观察风车菊",
          "text": "祭坛上的风车菊正随微风轻轻摇摆…"
        },
        {
          "role": "观察塞西莉亚花",
          "text": "祭坛上的塞西莉亚花正随微风轻轻摇摆…"
        },
        {
          "role": "观察小灯草",
          "text": "祭坛上的小灯草正随微风轻轻摇摆…"
        },
        {
          "role": "观察甜甜花",
          "text": "祭坛上的甜甜花正随微风轻轻摇摆…"
        },
        {
          "role": "观察钩钩果",
          "text": "微风吹来，祭坛上的钩钩果竟然纹丝不动…真结实呀！"
        },
        {
          "type": "subtitle",
          "text": "与温迪对话"
        },
        {
          "role": "琴",
          "text": "感谢你，风花节之星。我们已向风神巴巴托斯献上饱含敬爱的「风之花」，愿风护佑蒙德。"
        },
        {
          "role": "温迪",
          "text": "不错的选择哦。"
        },
        {
          "role": "旅行者",
          "text": "你喜欢吗？"
        },
        {
          "role": "温迪",
          "text": "嗯——你猜？"
        },
        {
          "role": "派蒙",
          "text": "又让人猜，这个坏家伙！"
        },
        {
          "role": "温迪",
          "text": "啊哈哈哈哈！会告诉你的啦，不过不是在这里。"
        },
        {
          "role": "温迪",
          "text": "人来人往的广场不方便聊这些，换个地方吧。"
        },
        {
          "role": "派蒙",
          "text": "去哪儿好呢？"
        },
        {
          "role": "温迪",
          "text": "我想邀请你和我一起到「风龙废墟」去。"
        },
        {
          "type": "subtitle",
          "text": "前往风龙废墟"
        },
        {
          "role": "温迪",
          "text": "一段日子没来这里，多了不少小麻烦呢。"
        },
        {
          "role": "温迪",
          "text": "旅行者，和我一起打扫环境吧？就当是送给特瓦林的见面礼。"
        },
        {
          "role": "派蒙",
          "text": "对哦，特瓦林也要过风花节吗？"
        },
        {
          "role": "温迪",
          "text": "它不在，但我能感觉到，它很快就会回来。"
        },
        {
          "role": "温迪",
          "text": "那这边就交给你喽，我去处理另一侧。忙完之后，就到上面会合吧！"
        },
        {
          "type": "subtitle",
          "text": "解决废墟内风场紊乱的问题"
        },
        {
          "role": "派蒙",
          "text": "这里的风…流向好杂乱呀！"
        },
        {
          "role": "派蒙",
          "text": "得想个办法把风向调顺。"
        },
        {
          "role": "派蒙",
          "text": "好，这样就行啦，我们去跟卖唱的会合吧！"
        },
        {
          "role": "派蒙",
          "text": "唔…好像不对…"
        },
        {
          "role": "派蒙",
          "text": "要不要试试其他顺序？"
        },
        {
          "role": "派蒙",
          "text": "咦？这些风场好像是遵循固定规律产生的呢，难道说，要参考它的顺序？"
        },
        {
          "type": "subtitle",
          "text": "与温迪对话"
        },
        {
          "role": "温迪",
          "text": "嗯！还是这里的景色最好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好漂亮的风景。",
              "dialogues": []
            },
            {
              "text": "气氛真不错。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "是啊，我很喜欢这个地方，闲暇时总会过来坐一会儿，看看风景。"
        },
        {
          "role": "派蒙",
          "text": "是来偷懒的吧？"
        },
        {
          "role": "温迪",
          "text": "哈哈哈，被你发现了！"
        },
        {
          "role": "温迪",
          "text": "如此美景，手里要是有杯苹果酒该多好。"
        },
        {
          "role": "温迪",
          "text": "旅行者，蒙德的风花节，你喜欢吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "充满人情味，又很热闹。",
              "dialogues": []
            },
            {
              "text": "跟大家在一起，非常开心。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "但还是有所疑问，对不对？"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "温迪",
          "text": "我知道你想问什么。究竟什么是「风之花」？风神巴巴托斯眼中的「风之花」与「风花节」又意味着什么？"
        },
        {
          "role": "温迪",
          "text": "如你所见，蒙德人民各有选择。有人从千万种花朵里选择了蒲公英，有人则挑选了风车菊。"
        },
        {
          "role": "派蒙",
          "text": "每个人心中的「风之花」，好像都不一样。"
        },
        {
          "role": "温迪",
          "text": "是啊，本该如此。没有唯一的答案，也没有真实存在过的「风之花」。"
        },
        {
          "role": "派蒙",
          "text": "咦…不存在吗？"
        },
        {
          "role": "温迪",
          "text": "「风之花」这个词语，最初只是旧蒙德时代，人民之间相互联络、共约反抗的暗语罢了。"
        },
        {
          "role": "温迪",
          "text": "那时人们常说，风越大，「风之花」的根基就越稳固，花朵也绽放得越鲜艳。"
        },
        {
          "role": "温迪",
          "text": "要我说的话，它并不存在，也无处不在。"
        },
        {
          "role": "温迪",
          "text": "它是向往自由的灵魂、是追逐风向的勇气…一切美好、值得被祝福的事物，都可以是「风之花」。"
        },
        {
          "role": "派蒙",
          "text": "看似不存在，却又无处不在的东西，就像风一样！"
        },
        {
          "role": "温迪",
          "text": "哈哈，你说得没错。"
        },
        {
          "role": "温迪",
          "text": "所以，风神巴巴托斯不会定义何为「风之花」。"
        },
        {
          "role": "温迪",
          "text": "祝福之花、敬爱之花、深爱之花。每个人都会有属于自己的「风之花」，每个人都有自由定义它的权利。"
        },
        {
          "role": "派蒙",
          "text": "自由之都蒙德献给风神的花，果然非常自由呢。"
        },
        {
          "role": "旅行者",
          "text": "我也喜欢自由的感觉。"
        },
        {
          "role": "温迪",
          "text": "我知道。"
        },
        {
          "role": "温迪",
          "text": "人们会因为共同的意志走到一起，牵引你我相遇的，想必是自由之风。"
        },
        {
          "role": "温迪",
          "text": "它来自旅途的尽头、世界的边缘。来自你我心中，永不停歇。"
        },
        {
          "role": "温迪",
          "text": "「是谁轻抚你带伤却坚毅的面容，在小溪边，在巨岩旁」"
        },
        {
          "role": "温迪",
          "text": "「是谁紧拥你疲惫而高贵的灵魂，在深梦里，在高天之上」"
        },
        {
          "role": "温迪",
          "text": "「亲爱的朋友，我牵着你的手，带你走进夜晚华灯」"
        },
        {
          "role": "温迪",
          "text": "「为你从头讲述，节日里那自由与梦的乐章」"
        },
        {
          "type": "subtitle",
          "text": "[https://www.bilibili.com/video/BV16y4y1b7QJ 过场动画「万花成风」]"
        },
        {
          "role": "温迪",
          "text": "风花节，发源于「北地明冠、自由之都」"
        },
        {
          "role": "班尼特",
          "text": "这次探险一定要带足物资，不能再饿肚子了！"
        },
        {
          "role": "雷泽",
          "text": "嗯"
        },
        {
          "role": "温迪",
          "text": "所以，如果你要问我…"
        },
        {
          "role": "玛乔丽",
          "text": "在执行公务吗！二位辛苦了"
        },
        {
          "role": "琴",
          "text": "你也辛苦了"
        },
        {
          "role": "丽莎",
          "text": "说来，好久没一起吃饭了呢"
        },
        {
          "role": "琴",
          "text": "最近太忙了……"
        },
        {
          "role": "温迪",
          "text": "这一天，我们该做些什么？"
        },
        {
          "role": "砂糖",
          "text": "啊，阿贝多先生！"
        },
        {
          "role": "阿贝多",
          "text": "研究进行得如何了？"
        },
        {
          "role": "砂糖",
          "text": "遇到了一些问题……"
        },
        {
          "role": "蒂玛乌斯",
          "text": "请看这个，我们认为……"
        },
        {
          "role": "凯亚",
          "text": "好的酒馆，当然要提供下酒菜了"
        },
        {
          "role": "罗莎莉亚",
          "text": "是吗？"
        },
        {
          "role": "温迪",
          "text": "如何去做？为谁而做？"
        },
        {
          "role": "温迪",
          "text": "低调一点？勇敢一点？"
        },
        {
          "role": "温迪",
          "text": "主动出击？还是守株待兔？"
        },
        {
          "role": "安伯",
          "text": "小心！"
        },
        {
          "role": "安伯",
          "text": "对不起对不起，你没事吧？"
        },
        {
          "role": "温迪",
          "text": "我的回答是"
        },
        {
          "role": "温迪",
          "text": "只要有共同的思念之情，那就都一样"
        },
        {
          "role": "温迪",
          "text": "全看心中所想"
        },
        {
          "role": "温迪",
          "text": "哈哈，特瓦林应该发现我们精心准备的礼物了吧？"
        },
        {
          "role": "温迪",
          "text": "清爽的风与舒适的环境，它一定会喜欢的。"
        }
      ],
      "collapse_ranges": [
        [
          86,
          109
        ]
      ]
    }
  ]
}