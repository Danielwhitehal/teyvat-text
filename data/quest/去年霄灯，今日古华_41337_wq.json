{
  "quest_id": 41337,
  "chapter_num": null,
  "chapter_title": "去年霄灯，今日古华",
  "type": "wq",
  "route": "Yesteryear's Lanterns and the Guhua of Today",
  "stories": [
    {
      "story_id": 41337,
      "title": "去年霄灯，今日古华",
      "description": "孙宇和小雀儿似乎想要放飞霄灯…",
      "dialogues": [
        {
          "role": "孙宇",
          "text": "师妹，你怎么突然头痛了，要不要先喝些药？"
        },
        {
          "role": "小雀儿",
          "text": "不、不用了，师兄你陪着我一会，我等会就好…"
        },
        {
          "role": "孙宇",
          "text": "在这附近放灯，或许就能被仙人所见吧？但是这材料…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么？"
        },
        {
          "role": "孙宇",
          "text": "啊，失礼了，我和师妹正在考虑放霄灯一事。"
        },
        {
          "role": "孙宇",
          "text": "不过，我们手头这制作霄灯的材料有些不足…"
        },
        {
          "role": "孙宇",
          "text": "如果这位朋友愿意的话…"
        },
        {
          "role": "小雀儿",
          "text": "又是古华派，古华派古华派…"
        },
        {
          "role": "小雀儿",
          "text": "好不容易的一个海灯节，许的愿望还是古华派…"
        },
        {
          "role": "孙宇",
          "text": "师妹，你我都是古华派门人，振兴古华派，自然是我们的责任。"
        },
        {
          "role": "小雀儿",
          "text": "是是是，师兄说什么，就是什么…"
        },
        {
          "role": "孙宇",
          "text": "唉…这位朋友，如果你愿意的话，能麻烦你找一些霄灯的材料给我吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "交给我吧。",
            "你的师妹好像有话想说…"
          ]
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "孙宇",
          "text": "非常感谢你。"
        },
        {
          "role": "孙宇",
          "text": "咳，我清点了一下，现在好像还缺了一朵清心…"
        },
        {
          "role": "孙宇",
          "text": "之前的那些摘了太长时间，变得又干又脆，没法用了。"
        },
        {
          "role": "旅行者",
          "text": "清心也能用来编霄灯吗？"
        },
        {
          "role": "孙宇",
          "text": "呵呵，这是之前在古华派里，我和师弟师妹们胡闹的时候想出来的怪法子。"
        },
        {
          "role": "孙宇",
          "text": "让霄灯带上些花香，倒也有些乐趣。"
        },
        {
          "role": "孙宇",
          "text": "我就在这里等你，找到材料就请你送回来吧，麻烦你了。"
        },
        {
          "role": "孙宇",
          "text": "我就在这里等你，找到材料就请你送回来吧，麻烦你了。"
        },
        {
          "role": "孙宇",
          "text": "谢谢你，这样我就能把霄灯编出来了。"
        },
        {
          "role": "孙宇",
          "text": "霄灯编好了，师妹，你待会就把愿望写上去吧，你的字是写得很好的…"
        },
        {
          "role": "小雀儿",
          "text": "写，我写就是了。"
        },
        {
          "role": "孙宇",
          "text": "师妹…你…是不是有些不高兴？怎么了？"
        },
        {
          "role": "小雀儿",
          "text": "没有，我哪有不高兴，能帮师兄放霄灯，我可高兴了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "咳…咳！你们要去哪放灯？",
            "咳…咳！你们该去放灯了。"
          ]
        },
        {
          "role": "旅行者",
          "text": "咳…咳！你们要去哪放灯？"
        },
        {
          "role": "孙宇",
          "text": "对，这位朋友说得对，我们该准备去放灯了。"
        },
        {
          "role": "小雀儿",
          "text": "那师兄你自己去吧，我就不去了，爬山太累了…我才没那个劲呢。"
        },
        {
          "role": "孙宇",
          "text": "这…我们刚刚才在这里休息了一段时间…"
        },
        {
          "role": "小雀儿",
          "text": "我头有些痛，不知道是不是方才吹了山风了。"
        },
        {
          "role": "孙宇",
          "text": "这…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我…我帮你们去放吧。",
            "我来帮忙！"
          ]
        },
        {
          "role": "旅行者",
          "text": "我…我帮你们去放吧。"
        },
        {
          "role": "孙宇",
          "text": "这…唉，那就麻烦朋友了。我本来准备去个特别的地方放飞霄灯的…"
        },
        {
          "role": "孙宇",
          "text": "之前古华派尚…在的时候，每逢海灯节，师长都会带着我们去那里放灯。"
        },
        {
          "role": "孙宇",
          "text": "可惜现在山门败落，那个地方，也久未有古华派门人放霄灯了…"
        },
        {
          "role": "孙宇",
          "text": "如今朋友既然愿意帮忙，那就请朋友代我去那边放飞这霄灯吧。"
        },
        {
          "role": "孙宇",
          "text": "我把位置标给你，我先去照顾照顾我家师妹…"
        },
        {
          "role": "芷若",
          "text": "你们是来…放灯的？"
        },
        {
          "role": "芷若",
          "text": "只有古华派弟子知道这个放灯的地方，可是我对你们没有什么印象…"
        },
        {
          "role": "旅行者",
          "text": "我是代人来放灯的。"
        },
        {
          "role": "芷若",
          "text": "还有古华派的人记得这里吗？"
        },
        {
          "role": "芷若",
          "text": "我过来的时候看着这周围寂寥无人，本来有些难过的…"
        },
        {
          "role": "芷若",
          "text": "但现在知道还有古华派的人记得这里，心里反倒是好受了不少。"
        },
        {
          "role": "旅行者",
          "text": "之前古华派会在这里放灯？"
        },
        {
          "role": "芷若",
          "text": "嗯…那个时候都是编好霄灯后，师长领着我们过来，师长在前面走，我们捧着霄灯在后面跟着。"
        },
        {
          "role": "芷若",
          "text": "那时候…山上山下，霄灯连成一片，可好看了。"
        },
        {
          "role": "芷若",
          "text": "可是现在…"
        },
        {
          "role": "芷若",
          "text": "…我们还是先把灯放起来吧，过去的事，如果不着急，我们可以边走边说。"
        },
        {
          "role": "芷若",
          "text": "有一次放霄灯的时候，有一位兴致高昂的师兄非要和我比剑。"
        },
        {
          "role": "芷若",
          "text": "我还没说话，我的一个好姐妹帮我用水悄悄浇湿了师兄站着的那块地。"
        },
        {
          "role": "芷若",
          "text": "那地又湿又滑，师兄还没出剑，刚走了一步就摔了个屁股墩，我笑得不行，也不小心摔倒了。"
        },
        {
          "role": "芷若",
          "text": "当时那位师兄也没生气，只是指着我笑。然后，周围的大家也笑成了一团…"
        },
        {
          "role": "芷若",
          "text": "不知道，这位师兄现在在哪里…"
        },
        {
          "role": "芷若",
          "text": "曾经我也看到过希望，有一位新入古华派的少年，仪表堂堂，天赋异禀，看上去是能重振山门的奇人。"
        },
        {
          "role": "芷若",
          "text": "但他踪迹难寻，常常见不到影子，唉，说到底，将振兴门派的愿望寄托于他人，本来就不对吧…"
        },
        {
          "role": "芷若",
          "text": "所以，还是由他去，不要期待为好。"
        },
        {
          "role": "芷若",
          "text": "我离开古华派的时候，同门弟子已经寥寥无几了。"
        },
        {
          "role": "芷若",
          "text": "师父没有责备我，只是叫我要好好生活。"
        },
        {
          "role": "芷若",
          "text": "但是，我现在也不知道我是不是真的在好好生活…"
        },
        {
          "role": "芷若",
          "text": "又或者，我只不过是在得过且过罢了…"
        },
        {
          "role": "芷若",
          "text": "我听人说，有一位叫孙宇的古华派门人正在访仙，想要复兴古华派。"
        },
        {
          "role": "芷若",
          "text": "我要是有他这种勇气的话…就好了。"
        },
        {
          "role": "芷若",
          "text": "抱歉，一个人说了这么多，难得到外面来透透气，就是想多说一些话。"
        },
        {
          "role": "旅行者",
          "text": "你好像有点难过。"
        },
        {
          "role": "芷若",
          "text": "我、我没事，只不过每年过节的时候，都有点…"
        },
        {
          "role": "芷若",
          "text": "好了，时间也差不多了，祝你们海灯节快乐，也麻烦你代我向拜托你放灯的人带句话，就说…"
        },
        {
          "role": "芷若",
          "text": "就说…"
        },
        {
          "role": "芷若",
          "text": "就说…芷若祝他海灯节快乐吧。"
        },
        {
          "role": "旅行者",
          "text": "也祝你海灯节快乐。"
        },
        {
          "role": "芷若",
          "text": "嗯，谢谢你，路上小心。"
        },
        {
          "role": "孙宇",
          "text": "咦，你回来了，霄灯已经放了吗？"
        },
        {
          "role": "旅行者",
          "text": "关于放霄灯时的经历…"
        },
        {
          "role": "孙宇",
          "text": "原来如此，芷若…我还记得她，当年她还关照过我的。"
        },
        {
          "role": "孙宇",
          "text": "原来她还记得古华派啊，太好了，太好了…"
        },
        {
          "role": "旅行者",
          "text": "关于小雀儿…"
        },
        {
          "role": "孙宇",
          "text": "啊，小雀儿的头痛好了些，刚才也许是真着凉了，我正准备给她…"
        },
        {
          "role": "小雀儿",
          "text": "师兄，刚刚你说的那个「芷若」…"
        },
        {
          "role": "小雀儿",
          "text": "是古华派的师姐吗？人好看吗？你和她很熟悉吗？"
        },
        {
          "role": "孙宇",
          "text": "唔…倒说不上熟悉，不过芷若很擅长做伤药，之前受了伤，大家都愿意去找她。"
        },
        {
          "role": "孙宇",
          "text": "哈哈哈，这么一说，古华派里的人，喜欢她的人应该也很多吧。"
        },
        {
          "role": "小雀儿",
          "text": "师兄，你呢？"
        },
        {
          "role": "孙宇",
          "text": "啊…啊？"
        },
        {
          "role": "小雀儿",
          "text": "师兄，你和这位芷若师姐之间的关系…"
        },
        {
          "role": "孙宇",
          "text": "这…我们也不太熟悉，嗯，可以说是同门之谊吧…"
        },
        {
          "role": "小雀儿",
          "text": "喔…那师兄，那你我之间的关系。"
        },
        {
          "role": "孙宇",
          "text": "哈哈哈，那自然是同门之谊了！"
        },
        {
          "role": "小雀儿",
          "text": "……"
        },
        {
          "role": "孙宇",
          "text": "师妹，师妹？你…你怎么了…"
        }
      ]
    }
  ]
}