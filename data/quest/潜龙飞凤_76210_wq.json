{
  "quest_id": 76210,
  "chapter_num": null,
  "chapter_title": "潜龙飞凤",
  "type": "wq",
  "route": "Submerged Dragon, Soaring Phoenix",
  "stories": [
    {
      "story_id": 76210,
      "title": "潜龙飞凤",
      "description": "在麓阳书院，遇见了一位正在磨砺身法的古华派剑士…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "操作「小右」复原「画中天」",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "欸？这个是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调查",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "和画中人对话"
        },
        {
          "type": "subtitle",
          "text": "画中人纵身一跃，来到了你们面前…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "长孙继璟",
          "text": "在下长孙继璟，见过郎君当面。不知郎君唤住在下，有何要事相商？"
        },
        {
          "role": "派蒙",
          "text": "呃，也没什么要事啦。只是看你在画里跳来跳去的，稍微有点好奇…"
        },
        {
          "role": "长孙继璟",
          "text": "原是这般。在下方才正苦砺轻身之法，只是技法愚拙，让二位见笑了。"
        },
        {
          "role": "派蒙",
          "text": "轻身之法？"
        },
        {
          "role": "长孙继璟",
          "text": "不错。此地从未有雨点落下，在下难以修习恩师所传「裁雨」之法，然窃思不可荒废武技，故而只得这般修习。"
        },
        {
          "role": "长孙继璟",
          "text": "遥想当年，先师古华正是在石桩上修习身法，终臻大成。我等晚生无能，却仍愿拟仿先师皮毛，只求些微寸进。"
        },
        {
          "role": "长孙继璟",
          "text": "既然今日有缘相会，我观郎君又同为习武之人，可否请郎君不吝赐教一二？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哼，正合我意。汝可要看好了！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "呜哇，语气突然变得好奇怪！呃，所以我们要做什么？"
                }
              ]
            },
            {
              "text": "派蒙是我派蒙派掌门，派派蒙去吧。",
              "dialogues": [
                {
                  "role": "长孙继璟",
                  "text": "原来是派蒙派派蒙派掌门。晚生失敬。"
                },
                {
                  "role": "派蒙",
                  "text": "已经完全听不懂你在说什么了！而且就算是行秋的武侠小说里也没有让掌门先上的道理吧！"
                }
              ]
            }
          ]
        },
        {
          "role": "长孙继璟",
          "text": "多谢。那么，还请二位观瞧。"
        },
        {
          "type": "subtitle",
          "text": "和长孙对话"
        },
        {
          "role": "长孙继璟",
          "text": "二位请看。这便是我古华堂的「望梅之阵」。"
        },
        {
          "role": "长孙继璟",
          "text": "可否请郎君在规定时间内依次踏过由在下指出的石桩，向在下展示身法？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小事一桩。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "虽然其实有好多好多桩就是了…呃，没什么。"
                }
              ]
            },
            {
              "text": "其实派蒙派掌门派蒙也能做到…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "做不到！不管怎么想都——咦？仔细想想好像还真能做到…不过，用飞的应该算犯规吧？"
                }
              ]
            }
          ]
        },
        {
          "role": "长孙继璟",
          "text": "那么，便请郎君一展身手吧。"
        },
        {
          "type": "subtitle",
          "text": "在「望梅之阵」上大展身手"
        },
        {
          "type": "subtitle",
          "text": "在90秒内收集7个岩之微粒",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "和长孙对话"
        },
        {
          "role": "长孙继璟",
          "text": "郎君果然好身法。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，那是当然！旅行者可是很强的！"
        },
        {
          "role": "长孙继璟",
          "text": "接下来，不知郎君可否向在下展现{{颜色|蓝|纵跃法}}的精髓？"
        },
        {
          "role": "长孙继璟",
          "text": "据书中记载，我古华先师跳墙越城，如登平地，真有飞檐走壁之能，是为纵跃之法——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好厉害！",
              "dialogues": []
            },
            {
              "text": "听着像飞贼…",
              "dialogues": [
                {
                  "role": "长孙继璟",
                  "text": "呵呵，郎君请想，若是飞贼能逾墙而走，我等锄恶扶正之人却不能，岂不是要被那奸邪之徒轻易走脱？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯…要不然试试看？毕竟旅行者平时到处翻宝箱，也爬过很多地方了…"
        },
        {
          "type": "subtitle",
          "text": "前往下一处地点"
        },
        {
          "type": "subtitle",
          "text": "和长孙对话"
        },
        {
          "role": "长孙继璟",
          "text": "郎君，可曾准备好？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "开始吧。",
              "dialogues": []
            },
            {
              "text": "稍候。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "以纵跃之法，在屋檐上大展身手"
        },
        {
          "type": "subtitle",
          "text": "在90秒内收集38个岩之微粒",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "和长孙对话"
        },
        {
          "role": "长孙继璟",
          "text": "令人仰止。晚生叹服。"
        },
        {
          "role": "长孙继璟",
          "text": "既是如此…在下还有一个不情之请。不知郎君可曾听说过{{颜色|蓝|纵云之法}}？"
        },
        {
          "role": "长孙继璟",
          "text": "传闻我等先师古华，曾在华光紫气中登临高天，踏空而行，如履平地，正是靠这传说中的秘法…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听着有点离谱…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是啊，听着就像是假的…不过这么说来，要是能用风之翼的话，说不定也可以做到类似的效果？"
                }
              ]
            },
            {
              "text": "如果能用风之翼的话…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长孙继璟",
          "text": "哦？那便请郎君示范一二了！"
        },
        {
          "type": "subtitle",
          "text": "总之就是想办法在半空中大展身手"
        },
        {
          "type": "subtitle",
          "text": "在120秒内收集55个岩之微粒",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "和长孙对话"
        },
        {
          "role": "长孙继璟",
          "text": "原来如此…"
        },
        {
          "role": "长孙继璟",
          "text": "虽说不算是踏空而行，但亦对在下颇有启发。多谢郎君提点。"
        }
      ]
    }
  ]
}