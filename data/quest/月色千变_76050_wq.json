{
  "quest_id": 76050,
  "chapter_num": null,
  "chapter_title": "月色千变",
  "type": "wq",
  "route": "Shifting Moonlight",
  "stories": [
    {
      "story_id": 76050,
      "title": "月色千变",
      "description": "在「银月之庭」，「少女」似乎在和月灵玩耍…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同「少女」见面"
        },
        {
          "role": "月灵",
          "text": "~！"
        },
        {
          "role": "月灵",
          "text": "！！"
        },
        {
          "role": "派蒙",
          "text": "哇，今天这里好热闹啊，有好多月灵都在哥伦比娅身边起舞呢。"
        },
        {
          "role": "派蒙",
          "text": "呃，等等…好像不是跳舞！月灵们是想朝她撒娇吗？哥伦比娅快要被淹没了！"
        },
        {
          "role": "「少女」",
          "text": "救…救救。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "把手给我。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "呼…谢谢你们…"
        },
        {
          "role": "派蒙",
          "text": "刚才那是发生什么了？月灵们平时不会那么激动吧…"
        },
        {
          "role": "月灵",
          "text": "~！"
        },
        {
          "role": "「少女」",
          "text": "嗯…"
        },
        {
          "role": "「少女」",
          "text": "我陪这些孩子玩了点游戏，它们似乎很享受。"
        },
        {
          "role": "派蒙",
          "text": "享受完游戏时间之后围到你身边转…怎么感觉像狗狗一样呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这就是它们表达感谢的方式吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "只不过这次一不留神，谢意就像雪堆一样积起来了…"
        },
        {
          "role": "派蒙",
          "text": "说是这么说，你不还是很宠它们嘛！"
        },
        {
          "role": "「少女」",
          "text": "你们也想试试看吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "被围在中间的感觉？",
              "dialogues": [
                {
                  "role": "「少女」",
                  "text": "嗯…这个也行。只要你答得上来。"
                }
              ]
            },
            {
              "text": "和月灵玩游戏？",
              "dialogues": [
                {
                  "role": "「少女」",
                  "text": "嗯。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "行啊，我倒要看看是什么游戏，那么受月灵欢迎。"
        },
        {
          "role": "「少女」",
          "text": "去吧。"
        },
        {
          "role": "月灵",
          "text": "~！"
        },
        {
          "role": "月灵",
          "text": "！！"
        },
        {
          "type": "subtitle",
          "text": "同月灵玩耍"
        },
        {
          "role": "「少女」",
          "text": "猜猜看这是什么图案吧。"
        },
        {
          "role": "派蒙",
          "text": "欸？这…这也太抽象了。"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅，你刚刚真的答对了吗？"
        },
        {
          "role": "「少女」",
          "text": "好像错的时候更多一些。"
        },
        {
          "role": "派蒙",
          "text": "我放弃了。旅行者，你猜吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "凛角鹿。",
              "dialogues": [
                {
                  "role": "月灵",
                  "text": "！！"
                },
                {
                  "role": "派蒙",
                  "text": "噢！看这反应是！"
                },
                {
                  "role": "「少女」",
                  "text": "恭喜，猜对了呢。"
                }
              ]
            },
            {
              "text": "长颈角犀。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好担心啊！它的脖子是不是出了点问题啊！"
                },
                {
                  "role": "「少女」",
                  "text": "嗯…是没有见过的生物呢…"
                },
                {
                  "role": "「少女」",
                  "text": "正确答案是凛角鹿。"
                },
                {
                  "role": "「少女」",
                  "text": "月灵们，回来吧。"
                }
              ]
            },
            {
              "text": "翻折了一根叉刺的渔叉。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好丰富的想象力…"
                },
                {
                  "role": "「少女」",
                  "text": "哈…很有趣的答案。"
                },
                {
                  "role": "「少女」",
                  "text": "正确答案是凛角鹿。"
                },
                {
                  "role": "「少女」",
                  "text": "月灵们，回来吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "月灵",
          "text": "~！"
        },
        {
          "role": "月灵",
          "text": "！！"
        },
        {
          "role": "派蒙",
          "text": "满意了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真的软乎乎的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "它们喜欢你。"
        },
        {
          "role": "「少女」",
          "text": "我能感觉到，当这些孩子靠近你的时候，它们本身也放松了下来。"
        },
        {
          "role": "「少女」",
          "text": "就像凛角鹿喜欢沐浴着月光生长，月灵们也喜欢你心中散发出的什么。"
        },
        {
          "role": "派蒙",
          "text": "嗯？那是什么呢？"
        },
        {
          "role": "「少女」",
          "text": "温柔与善良吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「少女」）"
        },
        {
          "role": "「少女」",
          "text": "如果你愿意的话，下次也来陪月灵们玩游戏吧。"
        }
      ],
      "collapse_ranges": [
        [
          38,
          39
        ]
      ]
    }
  ]
}