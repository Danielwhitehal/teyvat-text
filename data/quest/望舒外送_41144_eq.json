{
  "quest_id": 41144,
  "chapter_num": null,
  "chapter_title": "望舒外送",
  "type": "eq",
  "route": "Wangshu Take-Away",
  "stories": [
    {
      "story_id": 41144,
      "title": "望舒外送",
      "description": "璃月的望舒客栈里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "言笑",
          "text": "你还真是个大忙人…那我去找别人帮忙，你忙你的去吧。"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "言笑",
          "text": "行，还挺爽快的…那你赶紧去吧。路上别沾了奇怪的东西。"
        },
        {
          "role": "言笑",
          "text": "对了，记得别用风之翼赶路啊，落地的时候要是把肉卷给震散了，那客人肯定不会收的。"
        },
        {
          "role": "随缘的铃官",
          "text": "肚子饿了…唉，我订的餐怎么还没送来啊…"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "言笑",
          "text": "怎么，你是来帮忙送餐的吗？"
        },
        {
          "role": "言笑",
          "text": "哼，来得正好，有个叫铃官的客人在我这点了一份松茸酿酒卷。"
        },
        {
          "role": "言笑",
          "text": "她让我晚些时候送到荻花洲西北面的一个地方，钱已经付好了。"
        },
        {
          "role": "言笑",
          "text": "怎么样，如果你有空的话，就帮忙送过去吧，报酬少不了你的。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "随缘的铃官",
          "text": "总算送来啦！谢谢你。"
        },
        {
          "role": "随缘的铃官",
          "text": "要是再不送来，我都想回望舒客栈看看了…"
        }
      ]
    }
  ]
}