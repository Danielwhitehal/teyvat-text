  "stories": [
    {
      "story_id": 70825,
      "title": "善后工作",
      "description": "风暴之后，西风骑士霍夫曼正在为善后工作而头疼着…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与霍夫曼对话"
        },
        {
          "type": "subtitle",
          "text": "前往巡查，并清除障碍物"
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物，并清除障碍"
        },
        {
          "type": "subtitle",
          "text": "前往巡查，并清除障碍物"
        },
        {
          "role": "霍夫曼",
          "text": "唉，要是能再多点人就好了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "城里西风骑士们在做什么？",
              "dialogues": [
                {
                  "role": "霍夫曼",
                  "text": "保持城防、协助城内各种修缮事务，还有一些杂七杂八的事务。"
                },
                {
                  "role": "霍夫曼",
                  "text": "现在骑士团总部里每个人都忙得脚不沾地。"
                },
                {
                  "role": "霍夫曼",
                  "text": "这么一比，在门口站岗反而算是个轻松的活了。"
                }
              ]
            },
            {
              "text": "可以去找冒险家协会帮忙。",
              "dialogues": [
                {
                  "role": "霍夫曼",
                  "text": "他们早就在帮忙了，最开始在城里不断搜索受灾的人们，之后又负责监视野外的魔物。"
                },
                {
                  "role": "霍夫曼",
                  "text": "魔物向城边聚集时，也是冒险家协会的各位冒险家们不断外出确认魔物动向，再回来报告，我们才能制订出具体的迎击计划。"
                },
                {
                  "role": "霍夫曼",
                  "text": "现在他们也在全力协助城内的各种工作，没了他们，西风骑士团只怕会独木难支吧。"
                },
                {
                  "role": "霍夫曼",
                  "text": "这么一说，我得找个机会好好谢谢塞琉斯了…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物，并拆除魔物营地"
        },
        {
          "type": "subtitle",
          "text": "前往巡查，并清除障碍物"
        },
        {
          "role": "霍夫曼",
          "text": "怎么样，已经清理干净了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经清理干净了。"
        },
        {
          "role": "霍夫曼",
          "text": "太好了，实在是帮大忙了，没有你帮忙，那堆乱七八糟的东西不知道还要堆多久…"
        },
        {
          "role": "霍夫曼",
          "text": "荣誉骑士，请收下这些吧，感谢你的帮助。"
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物，并拆除营地"
        },
        {
          "type": "subtitle",
          "text": "向霍夫曼回报"
        }
      ]
    }
  ]
}