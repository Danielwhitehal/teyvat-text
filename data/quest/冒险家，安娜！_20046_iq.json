{
  "quest_id": 20046,
  "chapter_num": null,
  "chapter_title": "冒险家，安娜！",
  "type": "iq",
  "route": "Anna the Adventurer!",
  "stories": [
    {
      "story_id": 20046,
      "title": "冒险家，安娜！",
      "description": "蒙德城的安娜，似乎已经成功地成为了一位冒险家。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "安娜",
          "text": "好…今天也要努力完成委托！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是有干劲啊。",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "那是当然了，做冒险家可是很有趣的。"
                },
                {
                  "role": "安娜",
                  "text": "不过…嘿嘿，我执行委托的时候，还是有很多事不熟悉。"
                },
                {
                  "role": "安娜",
                  "text": "旅行者，能请你再陪我去执行一下委托吗？我还有事想要请教你。"
                }
              ]
            },
            {
              "text": "要我陪你去吗？",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "可以吗？嘿嘿，我正好有很多事想要请教你呢。"
                }
              ]
            }
          ]
        },
        {
          "role": "安娜",
          "text": "那我们就快出发吧，今天的委托是…"
        },
        {
          "role": "安娜",
          "text": "嗯…又是护送货运热气球…"
        },
        {
          "type": "subtitle",
          "text": "与安娜一同完成冒险家协会的委托"
        },
        {
          "type": "subtitle",
          "text": "与安娜一同完成冒险家协会的委托"
        },
        {
          "role": "安东尼",
          "text": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…"
        },
        {
          "role": "旅行者",
          "text": "你不希望她做冒险家吗？"
        },
        {
          "role": "安东尼",
          "text": "……"
        },
        {
          "role": "安东尼",
          "text": "我尊重我妹妹的梦想。"
        },
        {
          "role": "安东尼",
          "text": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。"
        },
        {
          "role": "安东尼",
          "text": "作为她的哥哥，我…会全力支持她。"
        },
        {
          "role": "安东尼",
          "text": "就这样。"
        },
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "安娜",
          "text": "完成啦！谢谢你旅行者，这次的护送任务很顺利呢。"
        },
        {
          "role": "安娜",
          "text": "不过，冒险家平时去执行的委托，都是这种事情吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "会有其他委托的。",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "你的语气也太无奈了…"
                }
              ]
            },
            {
              "text": "你慢慢就会知道了…",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "喂，你的表情不要这么疲惫啊…"
                }
              ]
            }
          ]
        },
        {
          "role": "安娜",
          "text": "是这样吗…好嘞！那我要继续努力了！"
        },
        {
          "role": "安娜",
          "text": "等我攒够了钱，就带着哥哥和爸爸妈妈一起出去旅行！"
        },
        {
          "role": "安娜",
          "text": "哥哥他之前一直想出去旅行的，可是…因为我生病了，他必须留下来照顾我。"
        },
        {
          "role": "安娜",
          "text": "现在我的病已经好了，也成为了冒险家。"
        },
        {
          "role": "安娜",
          "text": "嘿嘿，是时候帮我哥哥完成一些梦想啦。"
        }
      ]
    }
  ]
}