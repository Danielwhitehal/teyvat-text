{
  "quest_id": 72682,
  "chapter_num": null,
  "chapter_title": "「百人一揆·黄金旋风」",
  "type": "wq",
  "route": "Hyakunin Ikki: Golden Whirlwind",
  "stories": [
    {
      "story_id": 72682,
      "title": "「百人一揆·黄金旋风」",
      "description": "距离上次的「百人一揆」结束已经有一段时间了，而茅葺再次出现在了稻妻城里…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与茅葺一庆对话"
        },
        {
          "role": "茅葺一庆",
          "text": "嗨！那边那位金发异乡人…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "又见面了。",
            "有什么委托吗？"
          ]
        },
        {
          "role": "茅葺一庆",
          "text": "嗯…你这头金发，越看越眼熟…难道是…"
        },
        {
          "role": "茅葺一庆",
          "text": "啊，对了！是上次「百人一揆」中，表现无比亮眼的「黄金旋风」…"
        },
        {
          "role": "旅行者",
          "text": "黄、黄金旋风…？"
        },
        {
          "role": "茅葺一庆",
          "text": "上次，我在乱斗的场馆一隅，观察着参加者的活跃表现，想将其中最为精彩的场面收为素材。而你战斗的身姿，如刈草的黄金之风一般，横扫各路敌手…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "奉承的话就免了。",
              "dialogues": []
            },
            {
              "text": "…再多说点？",
              "dialogues": [
                 {
          "role": "茅葺一庆",
          "text": "咳咳…「想必观众当中拥有剑豪般动态视力的人已经看出来了，这位金发异人所使用的正是在古武术中也被视为禁忌的『苟兰茄大龙卷』…！」"
        },
        {
          "role": "旅行者",
          "text": "？"
        },
        {
          "role": "茅葺一庆",
          "text": "这是受你战斗的身影启发，而写的情节。"
        }
              ]
            }      
            
            
          ]
        },
        
        {
          "role": "茅葺一庆",
          "text": "无论如何，最近又有好事之徒举办「百人一揆」了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「百人一揆」是什么来着？",
              "dialogues": [
                 {
          "role": "茅葺一庆",
          "text": "通过酣畅淋漓的打斗，来进行庆祝、或者消除晦气的乱斗大会。无论是武人还是魔物，都能摈弃成见不问身份，在其中为了纯粹的热血而混战的祭典。"
        },
        {
          "role": "茅葺一庆",
          "text": "在其中脱颖而出者，据说也能得到各种宝藏。"
        },
        {
          "role": "茅葺一庆",
          "text": "虽然举办者、赞助者究竟是何许人也，至今都是谜团就是了。"
        }
              ]
            },
            {
              "text": "原来如此，我明白了。",
              "dialogues": []
            }          
          ]
        },
       
        {
          "role": "茅葺一庆",
          "text": "总之，这些事情不适合在人多口杂的地方讨论。跟我来…"
        },
        {
          "type": "subtitle",
          "text": "与茅葺一庆对话"
        },
        {
          "role": "茅葺一庆",
          "text": "我们到了。"
        },
        {
          "role": "茅葺一庆",
          "text": "只要踏入这扇看起来十分可疑的大门，就能进入这回的战斗场馆。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "好兴奋。",
            "好麻烦。"
          ]
        },
        {
          "role": "茅葺一庆",
          "text": "这次的规则和上次应该差不多。来自世界各地，渴求争斗的魔物、冒险者、战士，在它的舞台上酣畅淋漓地大打出手。"
        },
        {
          "role": "茅葺一庆",
          "text": "与之前一样，你可以和志同道合的同伴、战友一起去参战。毕竟，所谓「百人」，自然是人数越多越好啦。"
        },
        {
          "role": "茅葺一庆",
          "text": "我很期待你的表现。"
        },
        {
          "role": "旅行者",
          "text": "这次你也不参加吗？"
        },
        {
          "role": "茅葺一庆",
          "text": "我吗？我会以旁观者的身份参与，为你喝彩。"
        },
        {
          "role": "茅葺一庆",
          "text": "毕竟，我的目标还是写出最精彩的格斗小说，而不是成为像你这样耀眼的战士。"
        },
        {
          "role": "茅葺一庆",
          "text": "而我的直觉告诉我，你一定会是格斗场上最耀眼的明星。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我会尽力。",
            "拭目以待吧。"
          ]
        },
        {
          "role": "茅葺一庆",
          "text": "嗯。想必这次你也能展现出耀眼无比的剑之舞吧。"
        }
      ]
    }
  ]
}