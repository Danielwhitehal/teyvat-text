{
  "quest_id": 40061,
  "chapter_num": null,
  "chapter_title": "御先祖大人的委托",
  "type": "eq",
  "route": "That Which Our Ancestors Entrusted",
  "stories": [
    {
      "story_id": 40061,
      "title": "御先祖大人的委托",
      "description": "你很关心海祇御灵祭的进展，于是决定再去一趟珊瑚宫…",
      "dialogues": [
        {
          "role": "露子",
          "text": "今天海祇岛刮起了南来风，我就料想会有好友来拜访。"
        },
        {
          "role": "派蒙",
          "text": "每次你这么一说话，我和旅行者就要奔波大半天。"
        },
        {
          "role": "露子",
          "text": "不要这么说嘛。我们不是，好搭档吗？最好的那种。"
        },
        {
          "role": "露子",
          "text": "不过今天，我确实有件事想要拜托你们。"
        },
        {
          "role": "露子",
          "text": "相传，我家先祖在珊瑚宫海祇御灵祭之事外，还追加了另一套试炼。和海祇岛存亡无关，和真相有关。"
        },
        {
          "role": "旅行者",
          "text": "另一套…试炼？"
        },
        {
          "role": "露子",
          "text": "现在海祇岛的存亡危机既然已经解除了，那我就出于祖传的义务与责任提醒你们一下吧。"
        },
        {
          "role": "露子",
          "text": "你们可以去那个所谓的「蛇心之地」的某处，寻找第二试炼的线索。"
        },
        {
          "role": "露子",
          "text": "哎呀，解脱了，轻松了。这份沉重的责任可以传给我未来的女儿了。"
        },
        {
          "role": "派蒙",
          "text": "祖传的任务就是说这么简单的一句话吗！？"
        },
        {
          "role": "派蒙",
          "text": "…我至今还是有点跟不上露子的思维…"
        }
      ]
    }
  ]
}