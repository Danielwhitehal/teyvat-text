{
  "quest_id": 73800,
  "chapter_num": null,
  "chapter_title": "全能美食队·职责之内",
  "type": "wq",
  "route": "Gourmet Supremos: Within Our Duties",
  "stories": [
    {
      "story_id": 73800,
      "title": "全能美食队·职责之内",
      "description": "在须弥，你遇见了一群熟悉的人…",
      "dialogues": [
        {
          "role": "旭东",
          "text": "这里就是须弥啊，嗯…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "…你这家伙，突然在闻什么呢？"
        },
        {
          "role": "旭东",
          "text": "你不是说须弥有很多香料吗？我没闻到啊？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "香料都是密闭保存在仓库里的，我们在港口怎么可能闻得到啊！"
        },
        {
          "role": "朱莉",
          "text": "呜哇…那棵好大好大的树，是不是就是托着教令院的「圣树」了啊？"
        },
        {
          "role": "朱莉",
          "text": "那棵树上，会不会结出什么水果啊？嗯…「圣树果果」！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "没有这种果子啦…"
        },
        {
          "role": "朱莉",
          "text": "学者们要是看书看饿了，就把这种果子摘下来吃…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我们也有正经的食堂…"
        },
        {
          "role": "龟井宗久",
          "text": "呵呵，各位，我们也不能总是待在港口。"
        },
        {
          "role": "龟井宗久",
          "text": "芭尔瓦涅阁下不是要去教令院办事吗？我们尽快动身吧，不要耽搁了时间。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们也来须弥了？",
              "dialogues": []
            },
            {
              "text": "我又来蹭饭了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旭东",
          "text": "旅行者！真巧，居然能在这里遇见你！"
        },
        {
          "role": "派蒙",
          "text": "好久不见呀！你们来须弥还是为了寻找食材做好吃的吗？"
        },
        {
          "role": "旭东",
          "text": "嗯…算是吧，不过我们在去寻找食材之前，还是得先陪芭尔瓦涅去办点事。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "其实就是我那篇关于「万能调料」的论文已经完成了，正准备回教令院报告呢。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "但是…我说啊！你们该去做什么就去做什么，我把事情办完就过去找你们。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "你们这一大帮人乌泱泱地往教令院里钻，不知道的还以为我被挟持了呢！"
        },
        {
          "role": "旭东",
          "text": "芭尔瓦涅，你不会是不好意思了吧？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "哈？！我，我不好意思？我为什么要不好意思！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "教令院里没什么有趣的东西，你们进去也只能在那干等着…"
        },
        {
          "role": "朱莉",
          "text": "没关系呀，我一直想要去教令院里看看呢，之前都只是听协会里的人提起…"
        },
        {
          "role": "龟井宗久",
          "text": "芭尔瓦涅阁下，旭东阁下只是担心您在教令院里会遇见为难的事。"
        },
        {
          "role": "龟井宗久",
          "text": "毕竟您离开的时间太久，现在回来，谁也不知道会发生什么情况。"
        },
        {
          "role": "旭东",
          "text": "嘿嘿，还是大叔了解我。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "你们把教令院当成什么了…我的导师人很好的，才不会为难我。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "而且我也一直和她保持着联系，她也看过了论文的草稿。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这次我只要把论文的定稿交上去就可以了。"
        },
        {
          "role": "旭东",
          "text": "哎呀，这样就最好了。那你就把我们当做观光团就好了。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "哪个观光团专门会来教令院…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "算了，你要来就来吧，我应该很快就能把事办完。"
        },
        {
          "role": "朱莉",
          "text": "办完了之后呢…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "唉…办完了之后，我就带你去吃好吃的，我记得啦。"
        },
        {
          "role": "朱莉",
          "text": "好耶！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "旅行者，你也一起来吧，之前你帮了我们那么多忙，现在到了须弥，就归我来招待你了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我就不客气了…",
              "dialogues": []
            },
            {
              "text": "嘿嘿嘿，又有饭可蹭了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂！你的语气听起来也太怪啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "芭尔瓦涅",
          "text": "那我们就快出发吧，从这里去教令院…应该要花点时间。"
        },
        {
          "type": "subtitle",
          "text": "前往须弥主城"
        },
        {
          "role": "朱莉",
          "text": "呜哇…好大的树…"
        },
        {
          "role": "龟井宗久",
          "text": "朱莉阁下，走路的时候还请注意脚下，别一直盯着那棵树啊。"
        },
        {
          "role": "旭东",
          "text": "喔！我闻到了，闻到美食的味道了！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "所以让你们自己先去玩，我等会就来找你们…"
        },
        {
          "role": "旭东",
          "text": "不行不行，美食要大家一起品尝才行，一个人都不能少。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "唉…真是受不了你。好吧，再往上走走就是教令院了，我们走吧。"
        },
        {
          "type": "subtitle",
          "text": "与芭尔瓦涅一行人前往教令院"
        },
        {
          "role": "法尔扎",
          "text": "哈哈哈，芭尔瓦涅，你总算是回来了，我可是等你好久啦。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "抱歉我回来晚了，老师，路上遇见了一些事耽搁了点时间。"
        },
        {
          "role": "法尔扎",
          "text": "没关系，没关系！你的论文很好，里面的研究项目也很有应用前景，我可是听见好多人都提起过你的研究了。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "谢谢您，老师。我把完整的论文都带来了…"
        },
        {
          "role": "法尔扎",
          "text": "嗯…好，很好啊，辛苦你了，芭尔瓦涅。"
        },
        {
          "role": "法尔扎",
          "text": "我等会就回去仔细看看。不过以你的学问，想必这篇论文一定没有任何问题。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "老，老师，您夸奖得太过了…"
        },
        {
          "role": "旭东",
          "text": "嚯…芭尔瓦涅那家伙居然还会脸红，真是稀奇。"
        },
        {
          "role": "龟井宗久",
          "text": "被自己的老师认可，确实是一件值得自豪的事。"
        },
        {
          "role": "朱莉",
          "text": "唔…怎么回事呀…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "朱莉",
          "text": "唔唔…我，我不太喜欢那个老师…"
        },
        {
          "role": "龟井宗久",
          "text": "这又是为什么，朱莉阁下？"
        },
        {
          "role": "朱莉",
          "text": "我不知道…就是有一种不喜欢的感觉。"
        },
        {
          "role": "朱莉",
          "text": "哎呀，说不定是我太累了，可不要告诉小芭啊，不然会惹她不高兴的。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "喂，你们在聊什么呢？"
        },
        {
          "role": "朱莉",
          "text": "呜哇！没什么！我…我肚子饿了！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "来的时候不是吃过了吗…你怎么这么能吃啊…"
        },
        {
          "role": "龟井宗久",
          "text": "朱莉阁下这么爱动，自然饿得快了。"
        },
        {
          "role": "旭东",
          "text": "芭尔瓦涅，你的事情已经办完了吗？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "差不多了，接下来只要等走完正式的论文评审流程就好了，应该也就在最近几天了。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这篇论文通过了之后…哼，我就可以去研究自己喜欢的项目了。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "现在我设计的「万能调料」还不完善，等我有了一个完整的团队，一定要把它做得更好！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "但在论文正式通过之前，我还有很多事要做，你们就待在须弥城里，不要乱跑。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "不然，我可不会专门跑去找你们…"
        },
        {
          "role": "旭东",
          "text": "嘿嘿，放心吧，须弥城够我们逛了。"
        },
        {
          "role": "旭东",
          "text": "先不说这些，既然事情办完了，你是不是该带我们去周围玩玩了？"
        },
        {
          "role": "旭东",
          "text": "然后…再请我们吃一点须弥的特色美食？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "看你这副「总算找到机会啦」的表情…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "让我想想…我们就先去「三十人团」的驻地看看吧。"
        },
        {
          "role": "龟井宗久",
          "text": "唔？只有三十个人吗…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "从名字上说是「三十人团」啦…总之，我们过去看看吧。"
        },
        {
          "role": "派蒙",
          "text": "朱莉，你怎么一直不说话呀？是哪里不舒服吗？"
        },
        {
          "role": "朱莉",
          "text": "欸？没事！我就是…我就是饿了！等下吃点东西就好了！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "真不知道你这么大的食量，是怎么保持身材的…"
        },
        {
          "type": "subtitle",
          "text": "前往「三十人团」驻地"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这里就是啦。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "在这里驻守着负责须弥城防卫工作的佣兵团「三十人团」。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "之所以叫这个名字，是因为这个佣兵团最初创立的时候只有三十个人。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "虽然现在规模庞大，但为了纪念最开始的创始人们，他们还是沿用了这个名字。"
        },
        {
          "role": "朱莉",
          "text": "喔，就和我们蒙德的「四风守护」一样容易理解呢。"
        },
        {
          "role": "旭东",
          "text": "就和璃月的「璃月七星」一个意思啊…"
        },
        {
          "role": "龟井宗久",
          "text": "咦？诸位看在下做什么？"
        },
        {
          "role": "龟井宗久",
          "text": "非，非要说的话…稻妻也有「三奉行」啊。"
        },
        {
          "role": "旅行者",
          "text": "大家的命名方式都有相似之处啊。"
        },
        {
          "role": "派蒙",
          "text": "不过，虽然看起来命名方式一样，但须弥的「三十人团」可不止三十个人呢"
        },
        {
          "role": "龟井宗久",
          "text": "唔？那边有一位看起来像是武人的守卫，怎么满面愁容"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谁遇见麻烦了！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你怎么突然激动起来了，这不是委托啊！"
                }
              ]
            },
            {
              "text": "是需要我帮忙吗？！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "只不过是看见有人在发愁而已，你冷静一点啊！"
                }
              ]
            }
          ]
        },
        {
          "role": "尤努斯",
          "text": "诸位…哦，您应该是来须弥城游玩的人吧。"
        },
        {
          "role": "尤努斯",
          "text": "我是尤努斯，是「三十人团」聚砂厅的后勤官。"
        },
        {
          "role": "旭东",
          "text": "你怎么看起来满面愁容的…是遇见什么麻烦了吗？"
        },
        {
          "role": "尤努斯",
          "text": "是…最近野外的魔物不知道为什么突然开始了躁动，我们只能派人出去清理。"
        },
        {
          "role": "尤努斯",
          "text": "那些魔物数量众多，又行动迅捷，每次派出去的人回来时都精疲力竭。"
        },
        {
          "role": "尤努斯",
          "text": "我正在想，该让后厨做什么菜给他们吃呢。"
        },
        {
          "role": "尤努斯",
          "text": "啊！算算时间，又有一批人该回来了…"
        },
        {
          "role": "尤努斯",
          "text": "请恕我失陪了，祝各位在须弥城里玩得尽兴。"
        },
        {
          "role": "龟井宗久",
          "text": "这位阁下还真是雷厉风行…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "呼…还好没找我说话，我最怕和这帮「镀金旅团」出身的人说话了…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我看看…接下来我们就去「冒险家协会」看看吧。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "虽然我觉得各地的「冒险家协会」应该没什么区别…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "但是朱莉应该还是想看看吧。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "呃…朱莉？"
        },
        {
          "role": "朱莉",
          "text": "欸？！什么？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我们要去「冒险家协会」看看啦，你要不要去？"
        },
        {
          "role": "朱莉",
          "text": "去呀！我一直想要去看看呢，快…快出发吧！"
        },
        {
          "type": "subtitle",
          "text": "前往冒险家协会"
        },
        {
          "role": "旭东",
          "text": "这里应该就是冒险家协会了吧？"
        },
        {
          "role": "卡玛尔",
          "text": "欢迎来到冒险家协会，各位有什么事吗？"
        },
        {
          "role": "卡玛尔",
          "text": "如果是想要接取委托的话，就去问问那边的凯瑟琳吧。"
        },
        {
          "role": "旭东",
          "text": "朱莉，你怎么这么没精神，是不是真的累了？"
        },
        {
          "role": "朱莉",
          "text": "嗯，是有点累了…"
        },
        {
          "role": "龟井宗久",
          "text": "从港口下船之后，我们就没有怎么休息过，在下也颇感困乏。"
        },
        {
          "role": "龟井宗久",
          "text": "芭尔瓦涅阁下，我们还是快去吃点东西，今天就先歇息了吧。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "哦…这样也好，正好沙瓦玛的烤肉摊还开着，我们就过去吃一顿吧。"
        },
        {
          "role": "旭东",
          "text": "那就快出发吧，没想到须弥城这么大，逛得我也有点累了。"
        },
        {
          "role": "旭东",
          "text": "不过总算可以吃到须弥的特色美食了，真是期待啊！"
        },
        {
          "type": "subtitle",
          "text": "前往品尝须弥特色美食"
        },
        {
          "role": "沙瓦玛",
          "text": "这不是芭尔瓦涅吗？你怎么回来了？"
        },
        {
          "role": "沙瓦玛",
          "text": "这后面几位…是你的朋友吗？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "是，他们刚来须弥，我正带着他们在城里玩呢。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "看你摊子开着，就想过来买点烤肉卷，怎么样？还有食材吗？"
        },
        {
          "role": "沙瓦玛",
          "text": "哈哈哈，你看你说的，食材有的是，一人一份…六份对吧？你就等好吧！"
        },
        {
          "role": "派蒙",
          "text": "呜哇…好期待！"
        },
        {
          "role": "？？？",
          "text": "沙瓦玛开始了烹饪…"
        },
        {
          "role": "旭东",
          "text": "这气味…这口感！太棒了！"
        },
        {
          "role": "龟井宗久",
          "text": "唔，真是新奇的口感，和稻妻的料理都颇为不同啊。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "朱莉，还吃得惯吗？"
        },
        {
          "role": "朱莉",
          "text": "嗯，很好吃，谢谢…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "你怎么了啊，怎么突然这么客气…你身体没有不舒服吧？"
        },
        {
          "role": "旅行者",
          "text": "接下来有什么安排？"
        },
        {
          "role": "旭东",
          "text": "我们已经订好了旅馆，等会就回去休息了。"
        },
        {
          "role": "旭东",
          "text": "等芭尔瓦涅的论文正式通过后，我们也会离开须弥了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等一下。",
              "dialogues": []
            },
            {
              "text": "芭尔瓦涅不和你们走？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旭东",
          "text": "她论文通过之后，就要留在教令院做研究了，当然不能跟着我们满世界跑。"
        },
        {
          "role": "旭东",
          "text": "这是芭尔瓦涅的愿望…她也和我们谈过了，大家也都很理解她。"
        },
        {
          "role": "旭东",
          "text": "唉，话是这么说没错…但大家心里多少还是有些不舍得吧。"
        },
        {
          "role": "派蒙",
          "text": "所以，朱莉一路上之所以那么心不在焉的…"
        },
        {
          "role": "旭东",
          "text": "大概也是因为这件事吧。"
        },
        {
          "role": "旭东",
          "text": "虽然大家都刻意避过这个话题，但是…芭尔瓦涅还是会留在教令院吧。"
        },
        {
          "role": "旭东",
          "text": "……"
        },
        {
          "role": "旭东",
          "text": "哎呀！这也没什么大不了的，又不是永远见不到了。"
        },
        {
          "role": "旭东",
          "text": "等我们有空的时候，还能过来教令院蹭饭吃呢。"
        },
        {
          "role": "旭东",
          "text": "芭尔瓦涅之前和我们说，因为她一直和导师保持沟通，所以论文应该会审核得很快，两到三天就会有结果。"
        },
        {
          "role": "旭东",
          "text": "嗯…明天你再来教令院找我们吧，咱们再聚一聚。"
        },
        {
          "role": "旭东",
          "text": "等我们离开须弥，那就真的不知道什么时候才能再见了。"
        },
        {
          "type": "subtitle",
          "text": "等待至第二天8点到12点"
        },
        {
          "type": "subtitle",
          "text": "前往教令院，寻找旭东"
        },
        {
          "role": "龟井宗久",
          "text": "无耻之徒，真是愧对她的学者之名！"
        },
        {
          "role": "龟井宗久",
          "text": "她在教令院里只学会了怎么巧取豪夺，慷他人之慨吗？！"
        },
        {
          "role": "龟井宗久",
          "text": "芭尔瓦涅阁下怎么能受这种败类的责难！"
        },
        {
          "role": "旭东",
          "text": "大叔，冷静一点，这里可是教令院，下面就是三十人团啊…"
        },
        {
          "role": "旭东",
          "text": "你要是真的过去动手，我们都要被抓进去了！"
        },
        {
          "role": "龟井宗久",
          "text": "…哼！假如是在稻妻，在下非要用刀剑和这小人讲讲道理不可！"
        },
        {
          "role": "派蒙",
          "text": "大家怎么一副怒气冲冲的样子，到底发生什么了…"
        },
        {
          "role": "旭东",
          "text": "旅行者，你来得…真不是时候…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "发生什么了？",
              "dialogues": []
            },
            {
              "text": "芭尔瓦涅呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旭东",
          "text": "你往前边看，她就在那边呢。具体情况…我就长话短说吧…"
        },
        {
          "role": "旭东",
          "text": "昨天晚上我们和芭尔瓦涅一起回了旅馆，打算再聊一会天。"
        },
        {
          "role": "旭东",
          "text": "正聊着的时候，芭尔瓦涅突然被教令院来的人叫走了，说她的论文出了什么问题，要去和导师讨论。"
        },
        {
          "role": "旭东",
          "text": "她本来是一个人过去，但我们实在不放心，就跟了过去。"
        },
        {
          "role": "旭东",
          "text": "我们在外面听到，那个叫做法尔扎的学者好像在和芭尔瓦涅说什么…"
        },
        {
          "role": "旭东",
          "text": "但没说几句，她们就吵了起来，之后芭尔瓦涅就摔门出去，正好撞见了我们。"
        },
        {
          "role": "旭东",
          "text": "和我们说明原委之后，她说自己的论文成果可能要被法尔扎剽窃，用来和一个…什么人做生意。"
        },
        {
          "role": "旭东",
          "text": "我们商量了一晚上也没想出什么两全的好主意，今天我们陪她来和法尔扎再谈一次。"
        },
        {
          "role": "旭东",
          "text": "因为…大叔很生气，所以我就和大叔留在这里，让朱莉陪着芭尔瓦涅去谈。"
        },
        {
          "role": "旭东",
          "text": "唉，我站在这里都能感觉到气氛很紧张，也不知道她们到底谈得怎么样了…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我说了，我绝对不会和你合作！"
        },
        {
          "role": "尼特",
          "text": "芭尔瓦涅小姐，我真诚地建议你再考虑一下，这可是一门难得的双赢生意。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "双赢？我可一点都不想赢，我这篇论文不是用来赚钱的！"
        },
        {
          "role": "尼特",
          "text": "哼…法尔扎小姐，这可和我们当初说好的不一样啊。"
        },
        {
          "role": "法尔扎",
          "text": "芭尔瓦涅，唉…我不会害你的，和尼特先生合作，你的研究成果才能更快地普及给大众啊。"
        },
        {
          "role": "朱莉",
          "text": "骗子的语气…"
        },
        {
          "role": "朱莉",
          "text": "你们，都离芭尔瓦涅远一点。"
        },
        {
          "role": "朱莉",
          "text": "不然，我就要不客气了。"
        },
        {
          "role": "尼特",
          "text": "啧…法尔扎小姐，你们教令院的护卫工作做得不太好啊，怎么随便一个冒险家都能闯进来撒野了？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "朱莉，我没事的。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "法尔扎老师，我绝不会用我的「万能调料」来赚一个摩拉。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "从写下这篇论文的第一个字起，我就和您说过了，我会把这篇论文的研究成果无偿提供给任何有需要的人。"
        },
        {
          "role": "法尔扎",
          "text": "唉，你怎么就听不进去呢…"
        },
        {
          "role": "尼特",
          "text": "您瞧，我就知道事情会发展成这样。"
        },
        {
          "role": "尼特",
          "text": "没关系，芭尔瓦涅小姐，请您放心吧，我不会让您难做的。"
        },
        {
          "role": "尼特",
          "text": "就算您不愿意和我合作…我们也会有其他办法的。"
        },
        {
          "role": "？？？",
          "text": "法尔扎和尼特离开了…"
        },
        {
          "role": "朱莉",
          "text": "小芭，你没事吧…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这下糟糕了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "芭尔瓦涅！",
              "dialogues": []
            },
            {
              "text": "怎么会这样…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旭东",
          "text": "这两个家伙…看来是蓄谋已久了。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "老师…法尔扎的目的从一开始就是我的调料。怪不得她会那么勤快地和我讨论论文的内容…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "现在她已经在我那篇论文的基础上开发了一个全新的项目，做出了另外一种调料，准备对外销售。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那怎么办？",
              "dialogues": []
            },
            {
              "text": "有什么办法阻止她吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芭尔瓦涅",
          "text": "想要阻止老师…法尔扎制造出高级「万能调料」，那几乎是不可能的…"
        },
        {
          "role": "旭东",
          "text": "事到如今，看来也只有用我的那个笨办法了。"
        },
        {
          "role": "派蒙",
          "text": "欸？你这么快就想到办法了吗？"
        },
        {
          "role": "旭东",
          "text": "怎么可能，是昨天晚上我们彻夜讨论出来的。"
        },
        {
          "role": "旭东",
          "text": "虽然我主业是厨师…但我最开始可是在璃月港开餐馆的，知道不少生意场上的小把戏。"
        },
        {
          "role": "旭东",
          "text": "芭尔瓦涅和我说了几个细节之后，我基本上就知道那个家伙要怎么拿「万能调料」赚钱了。"
        },
        {
          "role": "旭东",
          "text": "那两个财迷如果想要赚钱，必须把「万能调料」的配方紧紧攥在自己手里。"
        },
        {
          "role": "旭东",
          "text": "我的那个笨蛋方法则和他们完全相反，那就是…"
        },
        {
          "role": "旭东",
          "text": "把芭尔瓦涅的「万能调料」配方给抢先送出去。"
        },
        {
          "role": "旭东",
          "text": "如果大家先有了一份免费的调料配方，那尼特去推销调料的时候，也许就不会有多少人买帐了。"
        },
        {
          "role": "派蒙",
          "text": "但，但是要怎么把调料配方送到大家手里呢？"
        },
        {
          "role": "旭东",
          "text": "嘿嘿嘿…你说巧不巧，我们「全能美食队」最擅长的就是用各种食材和调料做菜…"
        },
        {
          "role": "派蒙",
          "text": "你是说…你们要用做菜的方式，把这种「万能调料」的配方提前传播出去？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但是芭尔瓦涅的论文…",
              "dialogues": []
            },
            {
              "text": "但是芭尔瓦涅的研究…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芭尔瓦涅",
          "text": "…没关系。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "只不过是一篇破论文而已，没有什么好在意的。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "反正我本来就是想要借用教令院的资源，将「万能调料」的配方无偿提供给所有人。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "用最直接的方式把配方送出去，也没什么不好的。"
        },
        {
          "role": "朱莉",
          "text": "小芭…"
        },
        {
          "role": "龟井宗久",
          "text": "芭尔瓦涅阁下…"
        },
        {
          "role": "旭东",
          "text": "不愧是须弥教令院的「学者」芭尔瓦涅，回答得真是有气势。"
        },
        {
          "role": "旭东",
          "text": "好！那我们就按照昨天晚上商量的计划开工吧！"
        },
        {
          "role": "旭东",
          "text": "尼特那家伙说不定已经召集了人手，开始到处去推销了，我们必须赶上去才行！"
        },
        {
          "role": "旭东",
          "text": "朱莉！你去冒险家协会，问他们有哪些村庄有大量的体力劳作，无论是打渔砍树还是狩猎，只要是体力劳作就行！"
        },
        {
          "role": "朱莉",
          "text": "好嘞！交给我吧！"
        },
        {
          "role": "旭东",
          "text": "大叔！我们接下来可能要做很多菜，所以需要采集很多其他的调料…"
        },
        {
          "role": "龟井宗久",
          "text": "就交给在下吧，芭尔瓦涅阁下已经给在下划出了「香辛果」的生长位置。"
        },
        {
          "role": "旭东",
          "text": "真是可靠，旅行者，能请你也和大叔一起去采一些「香辛果」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "记得让我蹭饭。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "没问题，给你留最香的一碗！"
                }
              ]
            }
          ]
        },
        {
          "role": "旭东",
          "text": "那就交给你们了。"
        },
        {
          "role": "旭东",
          "text": "我和芭尔瓦涅会先回旅馆准备菜谱，等你们准备好了，我们就在这里碰头。"
        },
        {
          "role": "旭东",
          "text": "旅行者，我也把碰头地点画给你。"
        },
        {
          "role": "旭东",
          "text": "那就出发吧，没想到能在须弥城遇上这么好玩的事，真是不虚此行，哈哈哈！"
        },
        {
          "type": "subtitle",
          "text": "与龟井宗久对话"
        },
        {
          "role": "龟井宗久",
          "text": "「香辛果」的生长地应该就在前方。"
        },
        {
          "role": "龟井宗久",
          "text": "阁下，我们两个分头采集，速战速决吧。"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "龟井宗久",
          "text": "好，但在下刚才注意到，周围有魔物活动的痕迹。"
        },
        {
          "role": "龟井宗久",
          "text": "再往前探索，说不定会遇见魔物，阁下请千万小心。"
        },
        {
          "role": "龟井宗久",
          "text": "阁下采集到「香辛果」后，就请过来与在下汇合。"
        },
        {
          "role": "龟井宗久",
          "text": "那么，就拜托阁下了。"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物获取材料"
        },
        {
          "type": "subtitle",
          "text": "向龟井宗久回报"
        },
        {
          "role": "龟井宗久",
          "text": "实在惭愧，我这里毫无收获…阁下，您那边怎么样？"
        },
        {
          "type": "subtitle",
          "text": "与龟井宗久对话"
        },
        {
          "role": "龟井宗久",
          "text": "太好了，「香辛果」应该就足够了。"
        },
        {
          "role": "龟井宗久",
          "text": "我还要在周围继续搜集一些食材，请阁下先行回去，看看朱莉阁下的情况吧。"
        },
        {
          "type": "subtitle",
          "text": "寻找朱莉"
        },
        {
          "role": "卡玛尔",
          "text": "体力劳作？嗯…非要说的话，那就是「维摩庄」和「喀万驿」和「奥摩斯港」了吧…"
        },
        {
          "role": "卡玛尔",
          "text": "「维摩庄」里有些人从事农活，「喀万驿」和「奥摩斯港」里也有不少人做着卖力气的工作。"
        },
        {
          "role": "卡玛尔",
          "text": "不过你打听这些干什么？是有什么委托吗？"
        },
        {
          "role": "朱莉",
          "text": "嗯…是的！是我的一个好朋友拜托我调查这件事！"
        },
        {
          "role": "卡玛尔",
          "text": "是这样啊，那我再帮你把位置标在地图上吧，这几个地方离城里还有些距离，可别走错路了。"
        },
        {
          "role": "朱莉",
          "text": "谢谢您！"
        },
        {
          "role": "旅行者",
          "text": "怎么样？还顺利吗？"
        },
        {
          "role": "朱莉",
          "text": "多亏了这位前辈帮忙，位置已经打听好了。"
        },
        {
          "role": "朱莉",
          "text": "碰头地点离这里不远…旅行者，我们一起快些过去吧。"
        },
        {
          "type": "subtitle",
          "text": "与旭东会合"
        },
        {
          "role": "旭东",
          "text": "…辛苦了，大叔。这样食材应该就足够了，芭尔瓦涅和我也已经把菜谱定好了。"
        },
        {
          "role": "旭东",
          "text": "接下来只需要等朱莉把位置带回来，就可以出发了。"
        },
        {
          "role": "朱莉",
          "text": "我们回来啦！"
        },
        {
          "role": "旭东",
          "text": "太好了，你打听到位置了吗？"
        },
        {
          "role": "朱莉",
          "text": "我们最好去「维摩庄」和「喀万驿」，位置也已经在地图上标好了。"
        },
        {
          "role": "旭东",
          "text": "太棒了！那事不宜迟，我们马上出发，先去拜访一下「维摩庄」吧。"
        },
        {
          "type": "subtitle",
          "text": "前往维摩庄"
        },
        {
          "role": "纳巴提",
          "text": "田野调查，又是田野调查…"
        },
        {
          "role": "纳巴提",
          "text": "咦？芭尔瓦涅？你怎么来这里了，你不是回去教令院交论文去了吗？"
        },
        {
          "role": "纳巴提",
          "text": "后面怎么还有这么多人，你到底在干啥啊！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "论文…说来话长…"
        },
        {
          "role": "？？？",
          "text": "芭尔瓦涅简单叙述了事情的经过…"
        },
        {
          "role": "纳巴提",
          "text": "用美食来宣传你的调料…这还挺新鲜的。"
        },
        {
          "role": "纳巴提",
          "text": "不过那个法尔扎居然能做出这种事？没理由啊，我也没听说她的项目被卡啊，她的薪水也在正常发。"
        },
        {
          "role": "纳巴提",
          "text": "怎么突然和枫丹人掺和到一起做生意去了…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "总之情况就是这样，快点帮忙，不然我之前那么多作业都白给你抄了！"
        },
        {
          "role": "纳巴提",
          "text": "谁抄你作业了！那你，你还参考我的实证大纲呢！"
        },
        {
          "role": "旭东",
          "text": "看来两位是老相识了啊，这位…"
        },
        {
          "role": "纳巴提",
          "text": "哦，你好，我是纳巴提，在生论派里研究一些有关人体的问题。"
        },
        {
          "role": "纳巴提",
          "text": "虽然…课题一直批不下来…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我和这家伙很早之前是同学，后来因为研究方向不同，就没怎么在一起研究过了。"
        },
        {
          "role": "纳巴提",
          "text": "是喔，还好没一起研究了，不然我非得被你那些怪里怪气的菜噎死不可。"
        },
        {
          "role": "纳巴提",
          "text": "别瞪我，别瞪我，我们说正事。"
        },
        {
          "role": "纳巴提",
          "text": "你们是想要做一道适合维摩庄居民口味的菜，对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你有什么想法吗？",
              "dialogues": []
            },
            {
              "text": "他们…好像没什么体力活动啊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "纳巴提",
          "text": "嗯…维摩庄的位置很微妙，虽然是须弥水路的关键地带，但再顺着水路走的话，就能一路到奥摩斯港。"
        },
        {
          "role": "纳巴提",
          "text": "大部分船都会直接去奥摩斯港停驻。"
        },
        {
          "role": "纳巴提",
          "text": "卸货，装船，修缮之类的力气活，也都几乎集中在奥摩斯港。"
        },
        {
          "role": "纳巴提",
          "text": "久而久之，不少人也去了奥摩斯港工作，如今留在这里的人，要么是老人，要么是孩子。"
        },
        {
          "role": "纳巴提",
          "text": "当然，还有我这种一心只想放松的闲汉。"
        },
        {
          "role": "旭东",
          "text": "那你知道，这里的人们一般喜欢吃什么口味的菜吗？"
        },
        {
          "role": "纳巴提",
          "text": "菜啊，嗯…应该是比较偏清淡的菜吧，也经常吃鱼。"
        },
        {
          "role": "纳巴提",
          "text": "但这里离城里太远，调料都不好买来，有时候做出来的菜实在是淡得要命。"
        },
        {
          "role": "纳巴提",
          "text": "那些老人们也品不出来，但我吃着实在是受不了…"
        },
        {
          "role": "纳巴提",
          "text": "你们提到的那个调料，确实有个怪模怪样的枫丹人过来推销过，但住在这里的人都没什么钱，实在买不起…"
        },
        {
          "role": "旭东",
          "text": "嘿嘿…那你正好可以试试芭尔瓦涅的「万能调料」。"
        },
        {
          "role": "旭东",
          "text": "话不多说了，大叔，朱莉，帮我支起一下锅。"
        },
        {
          "role": "旭东",
          "text": "纳巴提先生，现在，我要向你隆重推荐这份神奇的「万能调料」。"
        },
        {
          "role": "旭东",
          "text": "无论是任何菜，只要加入了这种「万能调料」，味道都会变得格外鲜美。"
        },
        {
          "role": "旭东",
          "text": "不信的话，你等一下可以亲口品尝一道用这种「万能调料」做出来的「奶酱鲜鱼」。"
        },
        {
          "role": "旭东",
          "text": "旅行者，请你也帮忙去拿一点新鲜的鱼肉回来吧。拿到鱼肉之后，交给芭尔瓦涅就好，我还得再看几遍菜谱…"
        },
        {
          "role": "旭东",
          "text": "这菜谱我才看了五遍，呼…希望不要失手…"
        },
        {
          "type": "subtitle",
          "text": "将3块新鲜的鱼肉带给芭尔瓦涅"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我居然真的这么做了，我肯定是疯了…啊！旅行者，你把食材拿来了吗？"
        },
        {
          "type": "subtitle",
          "text": "与芭尔瓦涅对话"
        },
        {
          "role": "旭东",
          "text": "一切都准备好了…我刚才又把菜谱看了两遍，总共七遍，不会有任何问题。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你真的记住了吗？",
              "dialogues": []
            },
            {
              "text": "真的没问题吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旭东",
          "text": "如果有问题…那我也会找到解决方法的。"
        },
        {
          "role": "旭东",
          "text": "好了，该开锅了！"
        },
        {
          "role": "？？？",
          "text": "旭东开始了烹饪…"
        },
        {
          "role": "纳巴提",
          "text": "这味道！真是鲜美…好像也没有加入什么特别的香料…"
        },
        {
          "role": "旭东",
          "text": "这就是「万能调料」的神奇之处，只要加入菜中，它就可以引出食材的鲜味，让整道菜拥有无与伦比的鲜美味道。"
        },
        {
          "role": "旭东",
          "text": "最重要的是，这「万能调料」的制作并不困难…"
        },
        {
          "role": "纳巴提",
          "text": "这「万能调料」多少钱，我想买几瓶试试。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我直接把这个配方给你，你既然是个学者，那就按照这个配方上的方法自己调吧。"
        },
        {
          "role": "纳巴提",
          "text": "等会！你就这么把配方给我了？这东西…应该能卖不少摩拉吧？那个枫丹人可是开了高价啊。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "白送你还不高兴？收下吧，记得多多和人分享这个配方，可不要藏私啊。"
        },
        {
          "role": "纳巴提",
          "text": "我知道了。芭尔瓦涅，你真是疯了…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我现在也这么觉得。不过偶尔这么疯一下，感觉也挺不错的。"
        },
        {
          "role": "旭东",
          "text": "总之，这份配方就交给你了，可要多多得向外分享啊。"
        },
        {
          "role": "旭东",
          "text": "既然这里沿着水路可以直达奥摩斯港，那我们接下来就先去那里吧。"
        },
        {
          "type": "subtitle",
          "text": "前往奥摩斯港"
        },
        {
          "role": "芭尔瓦涅",
          "text": "又回到奥摩斯港了啊。"
        },
        {
          "role": "朱莉",
          "text": "好多人，要从哪里入手呢…"
        },
        {
          "role": "龟井宗久",
          "text": "不如，在下去找一些武者比试，胜过他们之后，再向他们推荐这种调料？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这两个东西根本就挨不上边吧。"
        },
        {
          "role": "朱莉",
          "text": "咦？旭东去哪里了呀？"
        },
        {
          "role": "纳里曼",
          "text": "…喔！原来璃月也有那么多卸货的人啊。"
        },
        {
          "role": "旭东",
          "text": "对啊，我们每次卸完货也都累得不行。"
        },
        {
          "role": "派蒙",
          "text": "这家伙，什么时候和那个人聊起来的啊…"
        },
        {
          "role": "旅行者",
          "text": "是旭东的一种天赋吧…"
        },
        {
          "role": "纳里曼",
          "text": "唉，大家都不容易啊。特别是工作完了之后还要给自己做饭，光是想想就觉得更疲惫了…"
        },
        {
          "role": "旭东",
          "text": "那我就和你不一样了，我有一种特别的调料，可以轻松做出美味的饭菜来。"
        },
        {
          "role": "旅行者",
          "text": "这转折也太生硬了！"
        },
        {
          "role": "纳里曼",
          "text": "什么啊…你也是来推销货物的吗？我可没空听你说闲话。"
        },
        {
          "role": "纳里曼",
          "text": "你还不如和那个枫丹人一样，上来直接说要卖东西呢。先说好，我可没多少钱。"
        },
        {
          "role": "派蒙",
          "text": "完全暴露啦！"
        },
        {
          "role": "旭东",
          "text": "欸，别急啊，我们的调料和那个枫丹人卖的调料可不一样。"
        },
        {
          "role": "旭东",
          "text": "你不用出钱，我会用这种调料做道菜给你来品尝。"
        },
        {
          "role": "旭东",
          "text": "这样子，你就能切实地感受到这种调料的优势了。"
        },
        {
          "role": "纳里曼",
          "text": "还有这种好事…"
        },
        {
          "role": "旭东",
          "text": "我们做厨师的就是这么慷慨。旅行者，能请你帮忙带两个土豆回来吗？拿回来之后把土豆给芭尔瓦涅就好。"
        },
        {
          "role": "旭东",
          "text": "我得…嗯…想想怎么给这位先生做一道美味的「土豆船」了。"
        },
        {
          "type": "subtitle",
          "text": "将2个土豆带给芭尔瓦涅"
        },
        {
          "role": "芭尔瓦涅",
          "text": "旭东这家伙…呃，旅行者，你把食材拿来了吗？"
        },
        {
          "type": "subtitle",
          "text": "与芭尔瓦涅对话"
        },
        {
          "role": "旭东",
          "text": "这样就可以了，让我热一下锅…"
        },
        {
          "role": "？？？",
          "text": "旭东开始了烹饪…"
        },
        {
          "role": "纳里曼",
          "text": "这，这么快就做完了？你根本就没有怎么调味吧？"
        },
        {
          "role": "旭东",
          "text": "我都说了，只要有这种「万能调料」，任何菜都能快速变美味。"
        },
        {
          "role": "纳里曼",
          "text": "哦…但是这种调料一瓶肯定很贵吧。那个枫丹人就给我开了一个高价…"
        },
        {
          "role": "旭东",
          "text": "来，这是「万能调料」的配方，材料都很简单，自己在家里就能做出来。"
        },
        {
          "role": "纳里曼",
          "text": "你，你什么意思？你不收我摩拉吗？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我们不会向你索取任何东西，只有一个要求，请你把这份配方多多向外分享。"
        },
        {
          "role": "旭东",
          "text": "老兄，反正你是免费拿到的，送一份给别人做个人情也不错，是不是？"
        },
        {
          "role": "纳里曼",
          "text": "啊…你说得也有点道理，那就谢谢你们了…"
        },
        {
          "role": "派蒙",
          "text": "旭东可真会说话，之前怎么没看出来…"
        },
        {
          "role": "旭东",
          "text": "这也是厨师必要的技巧之一，如果厨师没有说话的技巧，怎么能照顾得了满堂性格各异的客人呢？"
        },
        {
          "role": "旅行者",
          "text": "璃月港的厨师也太难做了吧！"
        },
        {
          "role": "旭东",
          "text": "好了，我们接下来就去最后一个目的地「喀万驿」吧。"
        },
        {
          "role": "旭东",
          "text": "芭尔瓦涅说，她认识「金砂之旅」的老板玛亚姆，也把推广调料的事和她说过了。"
        },
        {
          "role": "旭东",
          "text": "希望咱们这最后一站能够顺利啊。"
        },
        {
          "type": "subtitle",
          "text": "前往「金砂之旅」"
        },
        {
          "role": "玛亚姆",
          "text": "你们总算来了，我还以为你们半途就放弃了呢。"
        },
        {
          "role": "玛亚姆",
          "text": "事情我都听芭尔瓦涅说了，居然想用这种方式来对抗那个枫丹人的「生意」。"
        },
        {
          "role": "玛亚姆",
          "text": "亏你还是个教令院的学者，居然想出来了这么笨的一个主意。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "咳…"
        },
        {
          "role": "旭东",
          "text": "那个…是我这个厨师想出来的，抱歉。"
        },
        {
          "role": "玛亚姆",
          "text": "呼…看着我和芭尔瓦涅认识的份上，我可以帮你们推广那种「万能调料」。"
        },
        {
          "role": "玛亚姆",
          "text": "你们跑了那么久，肯定都累了。"
        },
        {
          "role": "玛亚姆",
          "text": "那边的厨师，厨房里的食材都准备好了，外面也有现成的篝火和锅，你就自己动手做点东西吃吧。"
        },
        {
          "role": "玛亚姆",
          "text": "吃完了之后，好好地休息一下，就算是你不累，那位学者小姐也要累了。"
        },
        {
          "role": "旭东",
          "text": "那我就恭敬不如从命了。"
        },
        {
          "role": "旭东",
          "text": "旅行者，你能帮我拿几株帕蒂沙兰来吗？辛苦了这么久，我来做一道好菜犒劳一下大家。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "你还行吗？",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "放心吧，我在璃月做流水席的时候，比现在辛苦多了。"
                }
              ]
            }
          ]
        },
        {
          "role": "旭东",
          "text": "我去准备其他食材，你拿到帕蒂沙兰之后，就把它交给芭尔瓦涅吧，拜托你了，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "将3个帕蒂沙兰交给芭尔瓦涅"
        },
        {
          "role": "芭尔瓦涅",
          "text": "还好玛亚姆小姐肯帮忙…旅行者，你把帕蒂沙兰拿来了吗？"
        },
        {
          "type": "subtitle",
          "text": "与芭尔瓦涅对话"
        },
        {
          "role": "旭东",
          "text": "这些就足够了，你们先去等着吧，很快就好。"
        },
        {
          "role": "？？？",
          "text": "旭东开始了烹饪…"
        },
        {
          "role": "朱莉",
          "text": "好香啊！这是什么菜啊？"
        },
        {
          "role": "旭东",
          "text": "这道菜叫「唐杜尔烤鸡」，虽然名字听起来很奇怪，但吃起来的滋味可是很不错的。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "你什么时候学的这道菜？从来没见你做过啊。"
        },
        {
          "role": "旭东",
          "text": "昨天看了一会菜谱，差不多都记住了。"
        },
        {
          "role": "龟井宗久",
          "text": "旭东阁下的厨艺真是不凡啊…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "要是早点认识你，说不定我的研究速度都能加快不少…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "那个叫尼特的人…似乎和我们的目的地一模一样，而且他总是能快我们一步。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "虽然他好像没能把调料推销出去…但他为什么要和我们的步调保持一致呢？"
        },
        {
          "role": "朱莉",
          "text": "那个叫尼特的人，给我的感觉很不好…"
        },
        {
          "role": "玛亚姆",
          "text": "你们应该休息好了吧，那么…这封信拿着吧，这是那个叫尼特的枫丹人让我给你们的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他在这里？",
              "dialogues": []
            },
            {
              "text": "他什么时候给你的？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛亚姆",
          "text": "那个人已经离开了。他来了之后就付了我一笔钱，让我置办好食材等你们过来。"
        },
        {
          "role": "玛亚姆",
          "text": "他说，等你们休息好了之后，再把这封信给你们。"
        },
        {
          "role": "玛亚姆",
          "text": "抱歉啦，之前没告诉你们，毕竟他付的钱可不少。"
        },
        {
          "role": "旭东",
          "text": "芭尔瓦涅，上面写着什么？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "…尽是些肉麻的废话，唯一有用的话，就是让我们回教令院找他，他有事和我们谈。"
        },
        {
          "role": "龟井宗久",
          "text": "哼，这恶徒终于受不了了，想要和我们刀兵相见了么？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "如果他是这么直接的人，问题反倒是不大了…"
        },
        {
          "role": "旭东",
          "text": "既然尼特都这么说了，那我们更要过去了。"
        },
        {
          "role": "旭东",
          "text": "旅行者，能再麻烦你和我们同行一段吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "嘿嘿，那可就拜托你了啊。"
                }
              ]
            },
            {
              "text": "等会我就去打飞他。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旭东",
          "text": "那我们就出发吧，看看那家伙到底想要干什么。"
        },
        {
          "type": "subtitle",
          "text": "回到教令院，寻找尼特"
        },
        {
          "role": "尼特",
          "text": "欢迎！各位，欢迎啊，我恭候多时了。"
        },
        {
          "role": "朱莉",
          "text": "你要做什么，离远点。"
        },
        {
          "role": "尼特",
          "text": "冷静点，冒险家小姐，我可打不过你，也不想和你动手。"
        },
        {
          "role": "尼特",
          "text": "你们的计划已经成功了，调料市场已经开始被你们的免费配方占据，我以后再想要推销新款调料可是难上加难喽。"
        },
        {
          "role": "尼特",
          "text": "你们都已经是胜利者了，就对我这个亏钱鬼宽容一点吧。"
        },
        {
          "role": "龟井宗久",
          "text": "满嘴谎言…在下还没见过如阁下一般惹人厌恶之人。"
        },
        {
          "role": "尼特",
          "text": "哈哈哈，这大概是因为你见过的生意人不太多吧。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "你没和法尔扎在一起？"
        },
        {
          "role": "尼特",
          "text": "法尔扎小姐…也许是在研究新配方吧，她把自己关在屋子里也不出来…但说实话，我已经不太关心这件事了。"
        },
        {
          "role": "尼特",
          "text": "为了规避几个无聊的条款就要花那么大的功夫…而且还自持着学者的身份不放，不肯自己去找人推销，还要我亲自代劳。"
        },
        {
          "role": "尼特",
          "text": "我真是看走眼了，真是个不适合做生意伙伴的家伙。"
        },
        {
          "role": "尼特",
          "text": "但我现在觉得，你们非常适合做生意。"
        },
        {
          "role": "尼特",
          "text": "既有计划，又肯放下身段去行动，而且…手上的技术也不错。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你想捣乱吗？",
              "dialogues": []
            },
            {
              "text": "你想做什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "尼特",
          "text": "别紧张，我只是想问一下…我有没有向你们投资的机会。"
        },
        {
          "role": "旅行者",
          "text": "什么？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "你知道你自己在说什么吗？"
        },
        {
          "role": "龟井宗久",
          "text": "阁下的态度，真是乖张莫测啊。"
        },
        {
          "role": "朱莉",
          "text": "哼，骗子。"
        },
        {
          "role": "旭东",
          "text": "你是认真的？"
        },
        {
          "role": "尼特",
          "text": "当然！您为什么认为我不是认真的呢？"
        },
        {
          "role": "尼特",
          "text": "您的调料配方正在占据市场的主流，有受众，口碑看上去也还不错。"
        },
        {
          "role": "尼特",
          "text": "法尔扎小姐正在制造的配方虽然质量会更高，但推广多少是有些困难的。"
        },
        {
          "role": "尼特",
          "text": "当然啦，我也知道您不愿意和法尔扎小姐合作。"
        },
        {
          "role": "尼特",
          "text": "所以，我的提议是。由我来投资您，为您统合资源。"
        },
        {
          "role": "尼特",
          "text": "用法尔扎小姐的配方来赚钱，赚到的钱里分出一部分，一部分用于免费推广您的配方，另一部分…您可以拿去犒劳自己。"
        },
        {
          "role": "尼特",
          "text": "我不需要您付出一枚摩拉，您只需要在配方表的背面印上我们的「商标」就行。"
        },
        {
          "role": "尼特",
          "text": "怎么样？这个条件您还满意吗？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我拒绝。我说过了，我不想和你们沾上一点关系。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "而且你为什么想要投资我们，法尔扎…老师的研究实力和资源，都比我雄厚多了。"
        },
        {
          "role": "尼特",
          "text": "研究实力，资源…这些都是可以用各种方式快速提升的。"
        },
        {
          "role": "尼特",
          "text": "但口碑和知名度…呵呵，可不是一时半会就能积蓄起来的…"
        },
        {
          "role": "尼特",
          "text": "哦唷，我好像说得太多了。那今天咱们就聊到这里，我得回去看看法尔扎小姐有没有饿昏在研究室里了。"
        },
        {
          "role": "尼特",
          "text": "我还会在须弥待一段时间，衷心期待着和您合作的那一天…今天我就先告辞了。"
        },
        {
          "role": "？？？",
          "text": "尼特离开了…"
        },
        {
          "role": "朱莉",
          "text": "我…越来越讨厌这个人了…"
        },
        {
          "role": "龟井宗久",
          "text": "在下觉得…这个人也许比魔物还要难以对付。"
        },
        {
          "role": "旭东",
          "text": "法尔扎…尼特，看来这件事并没有我们想得那么简单。"
        },
        {
          "role": "旭东",
          "text": "看来我们暂时不能离开须弥了，必须要好好调查一下这件事。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "唉，为什么我会遇上这种麻烦事，我只是想要好好做个研究而已…"
        },
        {
          "role": "旭东",
          "text": "哈哈哈，这也是没办法的事，餐馆营业的时候，也必须先打扫干净屋子，再开门接待客人。"
        },
        {
          "role": "旭东",
          "text": "放心吧，我们一定会查清这件事的。"
        },
        {
          "role": "旭东",
          "text": "旅行者，看来我们又得联手了，以后说不定还要拜托你帮忙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "只要管饭，一切好说。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旭东",
          "text": "爽快！不愧是你。"
        },
        {
          "role": "旭东",
          "text": "但是…这个尼特，到底在打什么鬼主意呢…"
        }
      ]
    }
  ]
}