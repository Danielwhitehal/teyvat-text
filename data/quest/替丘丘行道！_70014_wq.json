  "chapter_title": "替丘丘行道！",
  "type": "wq",
  "route": "Hilichurl Justice",
  "stories": [
    {
      "story_id": 70014,
      "title": "替丘丘行道！",
      "description": "与艾拉·马斯克一同前去为被欺负的丘丘人打抱不平，或许能够借此得到新的线索？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与另一个愿意交流的丘丘人对话"
        },
        {
          "role": "丘丘人",
          "text": "Odomu! Ya dala?"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Mimi tomo, Odomu nye! Muhe mani?"
        },
        {
          "role": "丘丘人",
          "text": "Mani? Mani! Yoyo mani mi?"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Dada! Muhe mani yeye!"
        },
        {
          "role": "丘丘人",
          "text": "Dada! Mosi mita!"
        },
        {
          "role": "丘丘人",
          "text": "Dada odomu! Kundala dada! Kundala zido, mi dada!"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Ya zido? Ye? Mi?"
        },
        {
          "role": "丘丘人",
          "text": "Mi!"
        },
        {
          "role": "艾拉·马斯克",
          "text": "经过这些天的考察，我想你也知道它的要求了，辛苦你再跑一趟了。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "那家伙的位置已经标在地图上了，接下来希望你能找到一直搜寻的目标吧！"
        },
        {
          "role": "丘丘人",
          "text": "Dada, Valo!"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点战斗"
        },
        {
          "type": "subtitle",
          "text": "向丘丘人回复"
        },
        {
          "role": "丘丘人",
          "text": "Dala?"
        },
        {
          "role": "丘丘人",
          "text": "Yeye dada! Mosi mita!"
        },
        {
          "role": "丘丘人",
          "text": "Odomu tomo zido mi! Mi mani yeye! <color=#00E1FFFF> Aba mosi dada</color>！"
        },
        {
          "role": "派蒙",
          "text": "<color=#00E1FFFF> Aba mosi dada</color>…没记住的话，就再查一下手册吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "Mimi tomo, mosi mita!",
              "dialogues": []
            },
            {
              "text": "Tomo, valo!",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丘丘人",
          "text": "Valo, tomo!"
        },
        {
          "role": "派蒙",
          "text": "Valo!"
        }
      ]
    }
  ]
}