{
  "quest_id": 10264,
  "chapter_num": "叮铃哐啷大作战·尾声",
  "chapter_title": "叮叮叮，大聚餐！",
  "type": "wq",
  "route": "Ding Ding Dinggg! A Great Feast!",
  "stories": [
    {
      "story_id": 40207,
      "title": "叮叮叮，大聚餐！",
      "description": "数日的纷扰终于告一段落，你和派蒙决定再去探望爱诺一次…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到第二天"
        },
        {
          "role": "派蒙",
          "text": "不知道爱诺现在怎么样了，我们再去看望她一下吧。"
        },
        {
          "type": "subtitle",
          "text": "去看望爱诺"
        },
        {
          "role": "派蒙",
          "text": "你好啊，伊涅芙——雅珂达这次又在这里？"
        },
        {
          "role": "雅珂达",
          "text": "辛苦了这么多天，至少应该让我分一块蛋糕吃吧？"
        },
        {
          "role": "派蒙",
          "text": "有蛋糕吃！"
        },
        {
          "role": "伊涅芙",
          "text": "嗯，旅行者和派蒙来得刚好。"
        },
        {
          "role": "伊涅芙",
          "text": "爱诺一直想感谢大家，正好铛铛七分甜也被救回来了，所以就想让大家尝尝它的厨艺。"
        },
        {
          "role": "铛铛七分甜",
          "text": "嘎吱…嘎吱…"
        },
        {
          "role": "派蒙",
          "text": "这就是铛铛七分甜原本的样子吗？"
        },
        {
          "role": "伊涅芙",
          "text": "好在核心相对完整，爱诺为它重新制作了一副身躯。"
        },
        {
          "role": "铛铛七分甜",
          "text": "哼哧…哼哧…"
        },
        {
          "role": "派蒙",
          "text": "新鲜的甜品要出炉了吗？"
        },
        {
          "role": "铛铛七分甜",
          "text": "嘎吱…"
        },
        {
          "role": "派蒙",
          "text": "自己吃下去了…"
        },
        {
          "role": "雅珂达",
          "text": "厨子上菜之前总会偷吃两口的，不稀奇。"
        },
        {
          "role": "伊涅芙",
          "text": "不用担心，铛铛七分甜吃完后就可以为大家烤制甜品了，稍等片刻就好。"
        },
        {
          "role": "派蒙",
          "text": "好吧…话说要吃甜品的时候，爱诺怎么不在？"
        },
        {
          "role": "伊涅芙",
          "text": "爱诺刚刚想到了一个制作机器人的新点子，就立刻钻进了工作室。从我来到工坊起，她就一直这样。"
        },
        {
          "role": "派蒙",
          "text": "爱诺为什么这么喜欢制作机器人啊？"
        },
        {
          "role": "伊涅芙",
          "text": "嗯…要回答这个问题的话，需要从数据库中检索许多历史记录。"
        },
        {
          "role": "[[file",
          "text": "活动任务-叮叮叮，大聚餐！-CG1.png|center|1100px]]"
        },
        {
          "role": "伊涅芙",
          "text": "最初，爱诺可能只是惊讶于这世界上还存在一种比甜食更吸引她的事物。"
        },
        {
          "role": "伊涅芙",
          "text": "爱诺是幸运的，她对这种事物的爱好得到了同伴们的尊重，即便维持生计本身就快要耗光他们每天的活动时间。"
        },
        {
          "role": "[[file",
          "text": "活动任务-叮叮叮，大聚餐！-CG2.png|center|1100px]]"
        },
        {
          "role": "伊涅芙",
          "text": "直到一位优秀的老师出现之后，爱诺的爱好才被定义成天赋。"
        },
        {
          "role": "伊涅芙",
          "text": "正如爱诺曾经的那些伙伴那样，她终于找到了自己最想做，也最擅长做的事。"
        },
        {
          "role": "[[file",
          "text": "活动任务-叮叮叮，大聚餐！-CG3.png|center|1100px]]"
        },
        {
          "role": "伊涅芙",
          "text": "而当一位天才找到了自己真正想做的事，她就很难再停下自己的脚步了。"
        },
        {
          "role": "[[file",
          "text": "活动任务-叮叮叮，大聚餐！-CG4.png|center|1100px]]"
        },
        {
          "role": "伊涅芙",
          "text": "所以爱诺最终还是离开了儿时的伙伴，创建了最初的叮铃哐啷蛋卷工坊，开始制作各种各样的机器人。"
        },
        {
          "role": "[[file",
          "text": "活动任务-叮叮叮，大聚餐！-CG5.png|center|1100px]]"
        },
        {
          "role": "伊涅芙",
          "text": "这一切对于那时的爱诺来说，或许都是身为天才的「本能」，她渴望将自己的奇思妙想化为现实。"
        },
        {
          "role": "[[file",
          "text": "活动任务-叮叮叮，大聚餐！-CG6.png|center|1100px]]"
        },
        {
          "role": "派蒙",
          "text": "哦…所以才那么喜欢制作机器人？"
        },
        {
          "role": "[[file",
          "text": "活动任务-叮叮叮，大聚餐！-CG7.png|center|1100px]]"
        },
        {
          "role": "伊涅芙",
          "text": "不过，结合我自身的经历，我并不认为那就是答案的全部。"
        },
        {
          "role": "[[file",
          "text": "活动任务-叮叮叮，大聚餐！-CG8.png|center|1100px]]"
        },
        {
          "role": "伊涅芙",
          "text": "早在收留我之前，爱诺就开始穷尽她的技术手段，尝试为每个被制作的机器人赋予独特的个性，把它们当成伙伴…"
        },
        {
          "role": "伊涅芙",
          "text": "我并没有因为自己的出身，而成为工坊中的特例。"
        },
        {
          "role": "伊涅芙",
          "text": "分析原因，或许是她在这条名为天才的道路上走出了太远，回望空无一人的身侧，不由得感受到了孤独。"
        },
        {
          "role": "[[file",
          "text": "活动任务-叮叮叮，大聚餐！-CG9.png|center|1100px]]"
        },
        {
          "role": "伊涅芙",
          "text": "所以，我、铛铛七分甜、还有其他所有经爱诺之手得以加入工坊的机器人，都不单单是一种「天才的证明」。"
        },
        {
          "role": "伊涅芙",
          "text": "我们还是爱诺的家人，是她渴求的陪伴。"
        },
        {
          "role": "伊涅芙",
          "text": "这就是我所理解的，爱诺和机器人之间的关系。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样啊…"
        },
        {
          "role": "伊涅芙",
          "text": "正因如此，爱诺并不关心铛铛七分甜是否拥有令各方势力忌惮的威能。"
        },
        {
          "role": "伊涅芙",
          "text": "它已经被确定为工坊的一员，这就足够让爱诺做出那一切了。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，我也这么觉得！所以我也很奇怪爱诺这样的人竟然会留在挪德卡莱…"
        },
        {
          "role": "伊涅芙",
          "text": "…派蒙的这句发言，我的逻辑单元无法理解呢。"
        },
        {
          "role": "派蒙",
          "text": "我的意思是，在我看来，挪德卡莱这个地方，鱼龙混杂，到处都是算计，能在这里立足的肯定都是很不好惹的人。"
        },
        {
          "role": "派蒙",
          "text": "如果其他人得到了爱诺那样的技术，肯定会把机器人都改造成强大的兵器，驱使它们，用来威胁别人。"
        },
        {
          "role": "派蒙",
          "text": "但爱诺…她是能把大杀器造成烤蛋糕机的人，把她放到挪德卡莱，完全格格不入啊…"
        },
        {
          "role": "伊涅芙",
          "text": "不，我的逻辑单元持完全相反的看法。"
        },
        {
          "role": "伊涅芙",
          "text": "我在挪德卡莱接触过很多人，但其中的绝大多数都不能被定义为「挪德卡莱人」。"
        },
        {
          "role": "伊涅芙",
          "text": "偏偏是让派蒙感到惊讶的爱诺，最符合我的逻辑单元对「挪德卡莱人」的定义呢。"
        },
        {
          "role": "铛铛七分甜",
          "text": "叮铃…叮铃…"
        },
        {
          "role": "爱诺",
          "text": "甜品烤好了吧？"
        },
        {
          "role": "伊涅芙",
          "text": "嗯，不要急，先让我来分一下。"
        },
        {
          "role": "爱诺",
          "text": "我要奶油最多的！"
        },
        {
          "role": "伊涅芙",
          "text": "好了，大家品尝一下吧。"
        },
        {
          "role": "派蒙",
          "text": "…真好吃！"
        }
      ]
    }
  ]
}