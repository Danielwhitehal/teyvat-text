{
  "quest_id": 75663,
  "chapter_num": null,
  "chapter_title": "急风狙击",
  "type": "wq",
  "route": "Strikers Through the Storm",
  "stories": [
    {
      "story_id": 75663,
      "title": "急风狙击",
      "description": "在悠悠度假村，你遇见了一个正在筹备「射击术」练习的人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与加希菈对话"
        },
        {
          "role": "加希菈",
          "text": "哦呀？这不是旅行者吗？欢迎，有兴趣的话，来打两枪玩玩？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是「花羽会」的成员？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "加希菈",
          "text": "没错。我之前曾经在「花羽会」里担任射击术教官，训练大家的空中射击技术。"
        },
        {
          "role": "加希菈",
          "text": "在我教导过的那批学生里，有不少人都在战场上立下了赫赫战功。"
        },
        {
          "role": "加希菈",
          "text": "不过…能够回到我身边的，也只有他们的赫赫战功了。"
        },
        {
          "role": "加希菈",
          "text": "我之前也想要投身战场，和我的学生们并肩作战。但却被部族里的人拦住了…"
        },
        {
          "role": "加希菈",
          "text": "他们说，我教导射击的能力比我的射击术本身更加宝贵，为了部族，我必须留下。"
        },
        {
          "role": "加希菈",
          "text": "我服从了命令，继续研究训练射击术的方式，直到现在。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以，你来这里也是为了研究这个？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "加希菈",
          "text": "呃…算是吧。准确来说，我来这里主要是为了研究…如何让孩子对射击术感兴趣。"
        },
        {
          "role": "加希菈",
          "text": "普通的射击术训练很困难，也十分枯燥，战士们当然能够靠自己的毅力耐住性子训练…"
        },
        {
          "role": "加希菈",
          "text": "但孩子们…正好处于爱玩的年纪，只怕是没有那么多耐心的。要是受的挫折多了，说不定反而会对射击术产生反感。"
        },
        {
          "role": "加希菈",
          "text": "于是，我就想要研究出一套既有趣，也能让孩子们学习到基本射击术技巧的训练方式。"
        },
        {
          "role": "加希菈",
          "text": "喏，这就是我的「研究成果」了。保证既有趣，又刺激，还十分安全。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "给孩子们玩的啊…",
              "dialogues": []
            },
            {
              "text": "总觉得难度有点低…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "加希菈",
          "text": "哈哈哈哈哈，没关系，如果你需要的话，我可以再为你布设一套更加困难的挑战。"
        },
        {
          "role": "加希菈",
          "text": "没问题。站上台子，拿好射击器具，我保证一定让你尽兴而归。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（加希菈）"
        },
        {
          "role": "加希菈",
          "text": "怎么样，旅行者？想来玩两局射击吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要试试…",
              "dialogues": [
                {
                  "role": "加希菈",
                  "text": "没问题。站上台子，拿好射击器具，我保证一定让你尽兴而归。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "加希菈",
                  "text": "嗯，忙你的事去吧，想要试试的话，直接过来就好。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          18,
          20
        ]
      ]
    }
  ]
}