{
  "quest_id": 72244,
  "chapter_num": null,
  "chapter_title": "法厄同们全跳舞",
  "type": "wq",
  "route": "The Phaethons' Syrtos",
  "stories": [
    {
      "story_id": 72244,
      "title": "法厄同们全跳舞",
      "description": "帮助久利由卖，在七座御陵墓石前进行凭吊，进行「太阳之子」的安魂仪式…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆与残影对话"
        },
        {
          "role": "？？？",
          "text": "嗯？真是古怪，妾身已很久未见你们这样穿着之人了…"
        },
        {
          "role": "？？？",
          "text": "言行举止，看上去也并非白夜国民。"
        },
        {
          "role": "？？？",
          "text": "难不成，是自异邦落入此处的旅客么。"
        },
        {
          "role": "旅行者",
          "text": "是的…"
        },
        {
          "role": "？？？",
          "text": "没想到，白夜国竟然也有来自世外的通途吗…真是令人惊讶。"
        },
        {
          "role": "？？？",
          "text": "说来，妾身从出生起就在白夜国，从未见过世外之人。"
        },
        {
          "role": "？？？",
          "text": "从前，有人向妾身提及此事，说想要一窥天外风景，妾身都以为是他的玩笑话…"
        },
        {
          "role": "？？？",
          "text": "唉…"
        },
        {
          "role": "？？？",
          "text": "旅者啊，其实妾身有一事相求。"
        },
        {
          "role": "？？？",
          "text": "在白夜之国各处，有七座压着「<ruby> 太阳之子 <rp>(</rp><rt> 法厄同 </rt><rp>)</rp></ruby>」遗服的御陵墓石。"
        },
        {
          "role": "派蒙",
          "text": "太阳之子…"
        },
        {
          "role": "？？？",
          "text": "嗯，白夜国崇尚大日御舆。"
        },
        {
          "role": "？？？",
          "text": "每隔数年，便有出世孩童被擢选为太阳之子，执掌国家。"
        },
        {
          "role": "？？？",
          "text": "太阳之子…一共有七位。"
        },
        {
          "role": "？？？",
          "text": "在白夜国很难遇到异乡的旅客，拜托了，请去他们墓冢之前凭吊一番吧。"
        },
        {
          "role": "派蒙",
          "text": "咦，可是，为什么要让我们这些外来者去凭吊呢。"
        },
        {
          "role": "派蒙",
          "text": "一般来说，不是熟人去凭吊比较好吗…"
        },
        {
          "role": "？？？",
          "text": "按常理而言，确是如此。"
        },
        {
          "role": "？？？",
          "text": "唉，只是，白夜之国的居民应该无人会想要凭吊他们吧。"
        },
        {
          "role": "？？？",
          "text": "甚至，那些墓上的御陵墓石也久未祭拜了。"
        },
        {
          "role": "派蒙",
          "text": "可是…这是为什么呀？"
        },
        {
          "role": "派蒙",
          "text": "难道这个国家的国民，都不喜欢那些太阳之子吗？"
        },
        {
          "role": "？？？",
          "text": "与其说是不喜欢…不如说是痛恨。"
        },
        {
          "role": "？？？",
          "text": "刚才说过，太阳之子是刚出生就成为太阳之子的。"
        },
        {
          "role": "？？？",
          "text": "这样的孩子又怎么会治理国家，真正把持国度的是太阳之子背后的大人们。"
        },
        {
          "role": "？？？",
          "text": "太阳之子只是听凭他们摆布的傀儡。"
        },
        {
          "role": "？？？",
          "text": "只不过…那些大人们贪得无厌，收刮民脂，操纵太阳之子做过许多残忍之事。"
        },
        {
          "role": "？？？",
          "text": "由是，民怨愤起，将许多过错归咎于太阳之子…"
        },
        {
          "role": "派蒙",
          "text": "怎么会这样…"
        },
        {
          "role": "派蒙",
          "text": "明明太阳之子是无辜的。"
        },
        {
          "role": "？？？",
          "text": "…不，他们并不无辜。"
        },
        {
          "role": "？？？",
          "text": "对于白夜国民而言，他们、太阳之子的无知就是最大的过错。"
        },
        {
          "role": "？？？",
          "text": "人因无知而犯下的罪，确实伤害到了他人，这人真的能被称为是无辜的吗…"
        },
        {
          "role": "？？？",
          "text": "恐怕很难吧，皆因造成的伤害已无法挽回。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "既然这样…",
              "dialogues": []
            },
            {
              "text": "为什么还要凭吊？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "这算是…妾身的私情之托。"
        },
        {
          "role": "久利由卖",
          "text": "妾身名为久利由卖，是大日御舆内，负责照顾太阳之子起居的女官。"
        },
        {
          "role": "久利由卖",
          "text": "虽然知道他们所行是错误的，知道他们处处被人操控…"
        },
        {
          "role": "久利由卖",
          "text": "可毕竟是妾身看着长大的孩子，妾身对他们，可怜有之，悲哀有之…"
        },
        {
          "role": "久利由卖",
          "text": "却唯独…无法恨他们。"
        },
        {
          "role": "久利由卖",
          "text": "况且，虽然由于妾身的职务，能日日与太阳之子接触，却囿于周围严苛的监视…"
        },
        {
          "role": "久利由卖",
          "text": "在他们身边时，不被允许开口说出任何一句言辞。"
        },
        {
          "role": "久利由卖",
          "text": "那些孩子，在四下无人，彷徨无助之时。他们向妾身说了那么多、那么多话语……"
        },
        {
          "role": "久利由卖",
          "text": "妾身却无法作出任何回应。"
        },
        {
          "role": "久利由卖",
          "text": "如果，如果妾身那时能够提起舍生的勇气，对他们说些什么的话…"
        },
        {
          "role": "久利由卖",
          "text": "或许…一切都会有所不同吧。"
        },
        {
          "role": "久利由卖",
          "text": "拜托了，时至今日，妾身已无颜面对他们，只得在此作些祭拜。"
        },
        {
          "role": "久利由卖",
          "text": "凭吊之事，还请旅者大人帮妾身一次吧。"
        },
        {
          "role": "久利由卖",
          "text": "只需要，在他们的墓前…放下一枚「珊瑚真珠」即可。"
        },
        {
          "role": "久利由卖",
          "text": "这样，就能点燃此处石龛上的魂灯，打开前往引魂之处的道路，为他们祈求安魂…"
        },
        {
          "role": "旅行者",
          "text": "好。"
        },
        {
          "role": "久利由卖",
          "text": "多谢，那就…麻烦你们了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "久利由卖",
          "text": "太阳之子…一共有七位。旅者啊，请在他们的御陵墓石前，替妾身凭吊一番吧。"
        },
        {
          "type": "subtitle",
          "text": "◆在七座御陵墓石前献上珊瑚真珠（1/7）"
        },
        {
          "type": "subtitle",
          "text": "御陵墓石"
        },
        {
          "type": "subtitle",
          "text": "墓石上的字分为两排，其中，第一排以白夜国文写就，无法辨认。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "第二排为通用文字，上书内容如下：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「其名里栖太御须命，好仿匠人以黏土塑型，造宫中女官像，五官精巧，栩栩如生。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在御陵墓石之前，供奉上了一枚「珊瑚真珠」。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "◆在七座御陵墓石前献上珊瑚真珠（2/7）"
        },
        {
          "type": "subtitle",
          "text": "御陵墓石"
        },
        {
          "type": "subtitle",
          "text": "墓石上的字分为两排，其中，第一排以白夜国文写就，无法辨认。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "第二排为通用文字，上书内容如下：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「其名栖令比御命，少时身患恶疾。愈后，对医者事颇有心得。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在御陵墓石之前，供奉上了一枚「珊瑚真珠」。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "◆在七座御陵墓石前献上珊瑚真珠（3/7）"
        },
        {
          "type": "subtitle",
          "text": "御陵墓石"
        },
        {
          "type": "subtitle",
          "text": "墓石上的字分为两排，其中，第一排以白夜国文写就，无法辨认。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "第二排为通用文字，上书内容如下：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「其名御琉部栖命，少时通音律，擅弦琴。其人歌喉婉转，颂曲之时声动梁尘。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在御陵墓石之前，供奉上了一枚「珊瑚真珠」。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "◆在七座御陵墓石前献上珊瑚真珠（4/7）"
        },
        {
          "type": "subtitle",
          "text": "御陵墓石"
        },
        {
          "type": "subtitle",
          "text": "墓石上的字分为两排，其中，第一排以白夜国文写就，无法辨认。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "第二排为通用文字，上书内容如下：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「其名伊恩命，效占卜、符箓之事，然屡试屡错，唯算定自身寿数时分毫不差。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在御陵墓石之前，供奉上了一枚「珊瑚真珠」。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "◆在七座御陵墓石前献上珊瑚真珠（5/7）"
        },
        {
          "type": "subtitle",
          "text": "御陵墓石"
        },
        {
          "type": "subtitle",
          "text": "墓石上的字分为两排，其中，第一排以白夜国文写就，无法辨认。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "第二排为通用文字，上书内容如下：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「其名比螺梦门命，常言此天之外尚有世界，然皆为妄诞之语而已。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在御陵墓石之前，供奉上了一枚「珊瑚真珠」。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "◆在七座御陵墓石前献上珊瑚真珠（6/7）"
        },
        {
          "type": "subtitle",
          "text": "御陵墓石"
        },
        {
          "type": "subtitle",
          "text": "墓石上的字分为两排，其中，第一排以白夜国文写就，无法辨认。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "第二排为通用文字，上书内容如下：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「其名离可琉命，喜工造之事，尝于庭中盖小日舆，高六尺，惟妙惟肖。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在御陵墓石之前，供奉上了一枚「珊瑚真珠」。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "◆在七座御陵墓石前献上珊瑚真珠（7/7）"
        },
        {
          "type": "subtitle",
          "text": "御陵墓石"
        },
        {
          "type": "subtitle",
          "text": "墓石上的字分为两排，其中，第一排以白夜国文写就，无法辨认。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "第二排为通用文字，上书内容如下：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「其名依栖目那须命，凡沐休之日，必乘小舟泛游，勘校白夜国舆图。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在御陵墓石之前，供奉上了一枚「珊瑚真珠」。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "一二三…唔，旅行者，好像已经完成七座墓石的凭吊了！"
        },
        {
          "role": "派蒙",
          "text": "我们回到石头神龛那边，告诉等待在石龛边上的那个残魂吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往久利由卖处"
        },
        {
          "role": "久利由卖",
          "text": "如是，七盏魂灯既已亮起…"
        },
        {
          "role": "久利由卖",
          "text": "看来你们已经完成凭吊了。你们的帮助，妾身铭感于心。"
        },
        {
          "role": "久利由卖",
          "text": "那么，现在就由妾身为你们来打开…通往引魂之地的道路吧。"
        },
        {
          "role": "久利由卖",
          "text": "异乡的旅者啊，因妾身私念为你造成了许多麻烦…不过妾身仍希望你能见证安魂之仪。"
        },
        {
          "role": "久利由卖",
          "text": "请随着这条道路前进吧，妾身会在那里等你的。"
        },
        {
          "type": "subtitle",
          "text": "◆到达引魂之地"
        },
        {
          "role": "派蒙",
          "text": "哇，没想到这里真的能走上来！"
        },
        {
          "type": "subtitle",
          "text": "◆与久利由卖对话"
        },
        {
          "role": "久利由卖",
          "text": "旅者啊，你来了。"
        },
        {
          "role": "久利由卖",
          "text": "此处是引魂之处，也是妾身最后的执念所在。"
        },
        {
          "role": "久利由卖",
          "text": "太阳之子每到了一定岁数，就会按典仪，于生辰之日进入大日御舆。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "进入大日御舆？",
              "dialogues": [
                {
                  "role": "久利由卖",
                  "text": "是啊，所谓的进入大日御舆，即是「归日之祭」。"
                },
                {
                  "role": "久利由卖",
                  "text": "太阳之子从大日御舆而出，在被凡尘浊世侵染之前，回归太阳御座。"
                },
                {
                  "role": "久利由卖",
                  "text": "…大日御舆温度之高可炽照白夜之国。"
                },
                {
                  "role": "久利由卖",
                  "text": "太阳之子中，最后回到引魂之处的，都已经是残缺魂魄。"
                },
                {
                  "role": "久利由卖",
                  "text": "但是妾身还是觉得，或许…"
                },
                {
                  "role": "旅行者",
                  "text": "或许？"
                },
                {
                  "role": "久利由卖",
                  "text": "或许妾身打开引魂之地，就能够靠自己的记忆补足他们的残魂。"
                }
              ]
            },
            {
              "text": "那不就是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "久利由卖",
          "text": "就让妾身一试吧。"
        },
        {
          "role": "久利由卖",
          "text": "比螺梦门…御琉部栖…妾身在这里，你们还不归来吗？"
        },
        {
          "role": "久利由卖",
          "text": "…"
        },
        {
          "role": "旅行者",
          "text": "怎么样？"
        },
        {
          "role": "久利由卖",
          "text": "唉，七任太阳之子中，比螺梦门与御琉部栖由妾身养大，若连他们都不愿回应…"
        },
        {
          "role": "久利由卖",
          "text": "看来只有妾身一人的记忆，还是不足够啊…"
        },
        {
          "role": "久利由卖",
          "text": "如果有什么作为媒介，若有象征太阳之子正身的御辔就好了。"
        },
        {
          "role": "久利由卖",
          "text": "只可惜那枚御辔早就佚失。"
        },
        {
          "role": "久利由卖",
          "text": "唉…这个国家，白夜之国，仍然在恨着这些孩子们啊。"
        },
        {
          "role": "久利由卖",
          "text": "看来，想要解放他们的残魂，终究只是妾身的痴心妄想罢了。"
        },
        {
          "role": "久利由卖",
          "text": "…旅者，算是妾身最后拜托你，能帮忙找寻「神舆之辔」所在吗？"
        },
        {
          "role": "久利由卖",
          "text": "虽然，找到的可能也并不大。你已经帮妾身许多，再提出要求也显得有些厚颜无耻。"
        },
        {
          "role": "久利由卖",
          "text": "不过…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白了。",
              "dialogues": []
            },
            {
              "text": "我会尽力。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "久利由卖",
          "text": "那真是…那真是感谢了…"
        },
        {
          "role": "久利由卖",
          "text": "不过，御辔丢失已久，也不急于一时。"
        },
        {
          "role": "久利由卖",
          "text": "若是有消息，便来妾身这儿吧。"
        },
        {
          "type": "subtitle",
          "text": "◆获得「神舆之辔」"
        },
        {
          "role": "久利由卖",
          "text": "旅者，难道你找到了御辔了么。"
        },
        {
          "role": "久利由卖",
          "text": "能…将御辔交予我一视吗？"
        },
        {
          "role": "久利由卖",
          "text": "啊啊，这果然就是，果然就是「神舆之辔」。"
        },
        {
          "role": "久利由卖",
          "text": "没想到，时至今日居然还能够看到它，旅者啊，旅者你是从何处寻到？"
        },
        {
          "role": "旅行者",
          "text": "阿倍良久…"
        },
        {
          "role": "久利由卖",
          "text": "从阿倍良久命处得到吗？"
        },
        {
          "role": "久利由卖",
          "text": "真是奇怪，妾身记得，那是…白夜国刚建立时的伟大人物。"
        },
        {
          "role": "久利由卖",
          "text": "不过据说他之后想要篡夺白夜国王，也就是太阳之子之位，视为谋逆。"
        },
        {
          "role": "久利由卖",
          "text": "啊…既然你们从他手中取回了这枚御辔，看来背后亦有隐情。"
        },
        {
          "role": "久利由卖",
          "text": "御辔啊，在此重现天日，时也命也…妾身朝思暮想…那些孩子们的脸…"
        },
        {
          "role": "久利由卖",
          "text": "这样一来，妾身也终于有赎罪的机会了。"
        },
        {
          "role": "久利由卖",
          "text": "旅者，将这枚御辔投入引魂之处的池中，有此御辔在，必可复原残魂…"
        },
        {
          "role": "久利由卖",
          "text": "呜…好让他们魂魄健全，魂魄健全地走上往生之路啊！"
        },
        {
          "type": "subtitle",
          "text": "◆将「神舆之辔」投入水池"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "久利由卖",
          "text": "旅者，将「神舆之辔」投入引魂之处的池中吧…"
        },
        {
          "type": "subtitle",
          "text": "◆与久利由卖对话"
        },
        {
          "role": "久利由卖",
          "text": "啊啊…比螺梦门，你喜欢读书，常言有天外之地，那时妾身并不相信…"
        },
        {
          "role": "久利由卖",
          "text": "对你的绮言狂想，每每都只是笑着摇头。妾身该相信你的呀，该相信你的呀！"
        },
        {
          "role": "久利由卖",
          "text": "你说，如有机会，一定要逃出大日御舆，去天外之地冒险…"
        },
        {
          "role": "久利由卖",
          "text": "比螺梦门，现在已不再有人会束缚你了，去吧，去吧！"
        },
        {
          "role": "久利由卖",
          "text": "还有，御琉部栖，御琉部栖，妾身好想再听你歌上一曲啊。"
        },
        {
          "role": "久利由卖",
          "text": "听到你唱歌，听到你那样纯净清澈的歌喉，有谁不悄悄在内心里跟你一起唱呢？"
        },
        {
          "role": "久利由卖",
          "text": "归日之祭前夜，你突然想听妾身的声音，无论如何都想让妾身开口唱给你听。"
        },
        {
          "role": "久利由卖",
          "text": "说没有关系，不管唱多难听，你都不会笑的。"
        },
        {
          "role": "久利由卖",
          "text": "你那个时候是不是已经知道…已经知道归日之祭其实正是自己的终期？"
        },
        {
          "role": "久利由卖",
          "text": "呜…可是妾身到最后也…"
        },
        {
          "role": "旅行者",
          "text": "久利由卖？"
        },
        {
          "role": "久利由卖",
          "text": "啊啊，不好意思，旅者，妾身失态了。"
        },
        {
          "role": "久利由卖",
          "text": "侍奉太阳之子的女官，为保自身的洁净无暇…终生不可嫁予他人。"
        },
        {
          "role": "久利由卖",
          "text": "所以妾身一生都没有自己的孩子。"
        },
        {
          "role": "久利由卖",
          "text": "这些孩子，这些由妾身侍奉，看着长大的孩子，不知何时已变得比血脉还要亲近。"
        },
        {
          "role": "久利由卖",
          "text": "多谢你，旅者，多谢你找回了御辔。"
        },
        {
          "role": "久利由卖",
          "text": "这御辔经由每位太阳之子之手，其上承载的记忆足以补全残缺魂魄。"
        },
        {
          "role": "久利由卖",
          "text": "即使，这些记忆也是双面的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "双面的？",
              "dialogues": []
            },
            {
              "text": "记忆也有面向吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "久利由卖",
          "text": "自然，记忆分为两类，一类是自身之记忆，一类是他人对自身的记忆。"
        },
        {
          "role": "久利由卖",
          "text": "补全他们存在的，既有御辔之上，太阳之子自身的记忆…"
        },
        {
          "role": "久利由卖",
          "text": "也有御辔作为被白夜国怪罪的孩童们的象征，承载的身为罪孽之子的记忆。"
        },
        {
          "role": "久利由卖",
          "text": "妾身的记忆，并不足以补全他们的魂魄，便只能靠白夜之国诸民的记忆了。"
        },
        {
          "role": "久利由卖",
          "text": "这些孩童们，应这些归咎于他们身上的罪孽，才重新被白夜国记起，留下残影。"
        },
        {
          "role": "久利由卖",
          "text": "多谢你了，旅者…妾身大愿已了。"
        },
        {
          "role": "久利由卖",
          "text": "也终于能…稍微…安心一下了。"
        },
        {
          "role": "久利由卖",
          "text": "终于能…再和那些孩子们一起…"
        },
        {
          "type": "subtitle",
          "text": "◆与伊恩对话"
        },
        {
          "role": "伊恩",
          "text": "哎呀，这位旅者，咱看你眉心发黑，不如让咱给你算个命吧！"
        },
        {
          "role": "伊恩",
          "text": "咱可是百算百灵的伊恩大人呀。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？"
        },
        {
          "role": "派蒙",
          "text": "这在桥下拉客的人的语气。"
        },
        {
          "role": "派蒙",
          "text": "（而且，我记得他的墓碑上写着……）"
        },
        {
          "role": "伊恩",
          "text": "那是什么怀疑的眼神，好了好了，咱平时给别人算命。"
        },
        {
          "role": "伊恩",
          "text": "但是白夜国的国民…很少有幸福快乐的命运。"
        },
        {
          "role": "伊恩",
          "text": "所以咱就欺骗他们，说他们走了好运。"
        },
        {
          "role": "伊恩",
          "text": "咱觉得，这样他们好歹也能快乐一些嘛。"
        },
        {
          "role": "伊恩",
          "text": "结果他们就说咱根本就不会算，真是令人悲伤呀。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？"
        },
        {
          "role": "伊恩",
          "text": "怎么样，小家伙，就让咱给你算一下吧！"
        },
        {
          "role": "派蒙",
          "text": "那、那好吧！"
        },
        {
          "role": "伊恩",
          "text": "嗯…让我仔细算算，咦，怎么牵涉的东西这么多…"
        },
        {
          "role": "伊恩",
          "text": "诶呀！"
        },
        {
          "role": "派蒙",
          "text": "怎、怎么了？"
        },
        {
          "role": "伊恩",
          "text": "算不出来…"
        },
        {
          "role": "伊恩",
          "text": "怎么会这样呢，咱平时算出来的虽然不准，但也不会到算不出来的地步啊。"
        },
        {
          "role": "派蒙",
          "text": "看来水平不是很高嘛。"
        },
        {
          "role": "伊恩",
          "text": "…所言甚是，看来，咱还得再努力学习呀。"
        },
        {
          "type": "subtitle",
          "text": "◆与御琉部栖对话"
        },
        {
          "role": "御琉部栖",
          "text": "唉，你就是异乡的旅者吗…"
        },
        {
          "role": "御琉部栖",
          "text": "你是在追寻什么吗，你行走的姿势，实在是，令人感到忧伤啊。"
        },
        {
          "role": "派蒙",
          "text": "忧伤？有什么让人觉得忧伤的事吗？"
        },
        {
          "role": "御琉部栖",
          "text": "对于歌者来说，世界上任何事都是值得悲伤的事。"
        },
        {
          "role": "御琉部栖",
          "text": "譬如，结合就意味着分离，活着就意味着有一日会被埋入尘土之下…"
        },
        {
          "role": "御琉部栖",
          "text": "譬如，重逢短暂，消解不了别离之苦，这位旅者呀…"
        },
        {
          "role": "御琉部栖",
          "text": "只有追寻什么的人才会踏上远离故土的旅程。"
        },
        {
          "role": "御琉部栖",
          "text": "这旅程对于长住一地的居民来说想必相当浪漫，但对于旅者自己，或许是难言的苦楚。"
        },
        {
          "role": "御琉部栖",
          "text": "若是从前，我便要在此为你歌唱。"
        },
        {
          "role": "御琉部栖",
          "text": "只是，我在日前与人立下誓言，如果我听不到她的声音，那我也不再展露自己的歌喉。"
        },
        {
          "role": "御琉部栖",
          "text": "我只能祝福你，虽然你看上去也已比我年长许多…"
        },
        {
          "role": "御琉部栖",
          "text": "祝你如愿以偿。"
        },
        {
          "type": "subtitle",
          "text": "◆与比螺梦门对话"
        },
        {
          "role": "比螺梦门",
          "text": "啊，看你的样子，你是从异国而来的旅者吧！"
        },
        {
          "role": "比螺梦门",
          "text": "是从什么地方来的呀！"
        },
        {
          "role": "派蒙",
          "text": "我们是从蒙德来的。"
        },
        {
          "role": "比螺梦门",
          "text": "蒙德？"
        },
        {
          "type": "subtitle",
          "text": "向比螺梦门简单讲述了蒙德城的风物…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "比螺梦门",
          "text": "从来没有听说过的城邦，是嘛，了不起，居然还有这样的地方。"
        },
        {
          "role": "比螺梦门",
          "text": "哈哈哈，我就说世上怎么会只有白夜国那么大小。"
        },
        {
          "role": "比螺梦门",
          "text": "世上只有白夜国，嘿，那岂不是寂寞得要死了。"
        },
        {
          "role": "比螺梦门",
          "text": "看古籍的时候也有提到白夜成国之前的故事，那时我就觉得天外有天。"
        },
        {
          "role": "比螺梦门",
          "text": "不过，我原本还是害怕的，害怕白夜国之外其实空无一物。"
        },
        {
          "role": "比螺梦门",
          "text": "旅者，你的到来让我安心好多。哼，世上原来还有这么多有趣的地方。"
        },
        {
          "role": "比螺梦门",
          "text": "只可惜我现在还有一个叫归日之祭的祭典要完成。"
        },
        {
          "role": "比螺梦门",
          "text": "旅者啊，不如这样，你告诉我你进入此处的路吧。"
        },
        {
          "role": "比螺梦门",
          "text": "等到归日之祭的祭典礼成，我就找机会偷偷从大日御舆跑出去。"
        },
        {
          "role": "比螺梦门",
          "text": "到时候一起喝杯果汁吧！哈哈哈哈！"
        },
        {
          "type": "subtitle",
          "text": "◆与离可琉对话"
        },
        {
          "role": "离可琉",
          "text": "嗯？别来打扰我，我在想…"
        },
        {
          "role": "离可琉",
          "text": "我在想很重要的事！"
        },
        {
          "role": "派蒙",
          "text": "很重要的事？是什么事啊？"
        },
        {
          "role": "离可琉",
          "text": "你看到那个叫大日御舆的东西了吗？"
        },
        {
          "role": "离可琉",
          "text": "就整个白夜之国最高的建筑。"
        },
        {
          "role": "离可琉",
          "text": "我在想呀，要怎么做个更高的建筑，比大日御舆还高！"
        },
        {
          "role": "派蒙",
          "text": "嗯，可是大日御舆建那么高，是为了照亮白夜国。"
        },
        {
          "role": "派蒙",
          "text": "你的那个建筑做那么高是为了什么呀？"
        },
        {
          "role": "离可琉",
          "text": "当然是为了彰显我离可琉大人的声名啊！"
        },
        {
          "role": "离可琉",
          "text": "只有这样，就能证明我比阿倍良久那个大叔要厉害！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你认识…",
              "dialogues": []
            },
            {
              "text": "阿倍良久吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "离可琉",
          "text": "那是当然了，建造大日御舆，让白夜国摆脱危机…我以前，正是因为崇拜他…"
        },
        {
          "role": "离可琉",
          "text": "可是，他居然想要图谋王位，要不是那些大人，说不定我就要丢掉性命了。"
        },
        {
          "role": "离可琉",
          "text": "哼，我一定要建造比大日御舆还高的建筑。"
        },
        {
          "role": "派蒙",
          "text": "那、那要建多久啊。"
        },
        {
          "role": "离可琉",
          "text": "我才不管呢！"
        },
        {
          "role": "离可琉",
          "text": "白夜之国的人民能受我谕令，建造一个留名青史的奇观，感恩戴德还来不及呢！"
        },
        {
          "role": "离可琉",
          "text": "好了，别打扰我了！"
        },
        {
          "role": "离可琉",
          "text": "让我想想，梁高如果…这样的话，承重和斗拱…"
        },
        {
          "type": "subtitle",
          "text": "◆与依栖目那须对话"
        },
        {
          "role": "依栖目那须",
          "text": "嗯？从未在白夜之国见过你们这样穿着的人。"
        },
        {
          "role": "依栖目那须",
          "text": "难道你们是从什么天外之处来的吗？"
        },
        {
          "role": "依栖目那须",
          "text": "原来世上不只有白夜之国，那，呈上你们通行使用的地图，给我一观吧！"
        },
        {
          "role": "旅行者",
          "text": "（给予地图…）"
        },
        {
          "role": "依栖目那须",
          "text": "哦哦，真是精巧，不仅陆地轮廓精确，连山川走势也隐隐所现。"
        },
        {
          "role": "依栖目那须",
          "text": "那么这名为提瓦特之国的国土大小，能和白夜之国相比吗？"
        },
        {
          "role": "派蒙",
          "text": "提瓦特是整片大陆的名字啦…"
        },
        {
          "role": "派蒙",
          "text": "还有，渊下宫，啊，也就是白夜国，在地图南边的这个小块。"
        },
        {
          "role": "依栖目那须",
          "text": "荒谬！我白夜国土如此辽阔，怎么可能才只有这点大小。"
        },
        {
          "role": "依栖目那须",
          "text": "此图看上去精巧，实为妄诞乱画之作，拿去拿去！"
        },
        {
          "role": "依栖目那须",
          "text": "我本还有些敬佩之心，没想到竟是伪作，真是污了我的眼睛！"
        },
        {
          "role": "派蒙",
          "text": "哼，你不信就算了！"
        },
        {
          "type": "subtitle",
          "text": "◆与栖令比御对话"
        },
        {
          "role": "栖令比御",
          "text": "远方到来的旅者，咳咳，你看上去相当疲惫啊。"
        },
        {
          "role": "栖令比御",
          "text": "疲惫可不行，很多病，都是从疲惫开始的。"
        },
        {
          "role": "栖令比御",
          "text": "每日要保证足够的睡眠，才能，咳咳…"
        },
        {
          "role": "栖令比御",
          "text": "咳咳咳咳，咳咳咳…才能健康成长。"
        },
        {
          "role": "派蒙",
          "text": "总觉得你自己不是很健康呢…"
        },
        {
          "role": "栖令比御",
          "text": "哈哈，这是老毛病了。"
        },
        {
          "role": "栖令比御",
          "text": "旅者啊，只有完备健全的身躯，才可寄寓完备健全的魂魄。"
        },
        {
          "role": "栖令比御",
          "text": "唉，如果再有点时间就好了，我一定能够成为世上最好的医生…"
        },
        {
          "role": "栖令比御",
          "text": "这样，就算是我这样的身躯，恐怕也可以健康地走出房间，肆意玩耍了吧。"
        },
        {
          "type": "subtitle",
          "text": "◆与里栖太御须对话"
        },
        {
          "role": "里栖太御须",
          "text": "不许动！"
        },
        {
          "role": "里栖太御须",
          "text": "啊，不要动，不要动啊！诶呀，都说了不要动。"
        },
        {
          "role": "派蒙",
          "text": "诶，可是，突然让我不要动…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "让派蒙不动…",
              "dialogues": []
            },
            {
              "text": "会掉下来吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "才不会呢！"
        },
        {
          "role": "里栖太御须",
          "text": "哎呀，那就转个身吧，我可从来没见过这样的衣服。"
        },
        {
          "role": "里栖太御须",
          "text": "虽然有点丑陋，但也不是什么意思都没有。"
        },
        {
          "role": "派蒙",
          "text": "居然觉得丑，那还不如不要看…"
        },
        {
          "role": "里栖太御须",
          "text": "真是的，以往我让那些女官们给我作范本，可没有那么烦的。"
        },
        {
          "role": "里栖太御须",
          "text": "不过，白夜国的人啊，穿的衣服，长的样子我也全都看腻了。"
        },
        {
          "role": "里栖太御须",
          "text": "你们身上的倒是少见。"
        },
        {
          "role": "里栖太御须",
          "text": "嗯嗯，我知道了，原来这个衣服是这样的结构的…你们异乡还真是不知羞耻。"
        },
        {
          "role": "里栖太御须",
          "text": "原来如此，衣服结构若是这样的，那身躯就做成这个造型吧！"
        },
        {
          "role": "派蒙",
          "text": "你这是在做什么呢？"
        },
        {
          "role": "里栖太御须",
          "text": "造像啊，用泥水混合，用双手捏出造型。每每只有做这事的时候，内心才能平静。"
        },
        {
          "role": "里栖太御须",
          "text": "平时的议会，照本宣科地按着大人们写好的词句读，总让人不安。"
        },
        {
          "role": "里栖太御须",
          "text": "…好了，你的造型我也已经看腻了。"
        },
        {
          "role": "里栖太御须",
          "text": "别烦我，去做自己的事去吧。"
        },
        {
          "type": "subtitle",
          "text": "◆与所有太阳之子残魂对话完"
        },
        {
          "role": "派蒙",
          "text": "感觉每个太阳之子的个性都不太一样呢…"
        },
        {
          "role": "派蒙",
          "text": "如果他们能长大的话，说不定也能变成了不起的大人，真是可惜啊。"
        }
