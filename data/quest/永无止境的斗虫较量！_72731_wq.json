{
  "quest_id": 72731,
  "chapter_num": null,
  "chapter_title": "永无止境的斗虫较量！",
  "type": "wq",
  "route": "The Beetle Battles Will Never End!",
  "stories": [
    {
      "story_id": 72731,
      "title": "永无止境的斗虫较量！",
      "description": "「荒泷极意堂堂斗虫大试合」举办得似乎相当成功，是时候回到场地，看看荒泷一斗和「花角玉将」切磋得怎么样了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "返回「斗虫大试合」的场地"
        },
        {
          "role": "派蒙",
          "text": "说起来，「荒泷极意堂堂斗虫大试合」的进展很顺利呢。"
        },
        {
          "role": "派蒙",
          "text": "不知道放牛的和「花角玉将」究竟谁占了上风，我们赶快去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "与荒泷一斗对话"
        },
        {
          "role": "「花角玉将」",
          "text": "原来如此，原来如此啊…再打一场吧，我一定能看透你斗虫的门道。"
        },
        {
          "role": "「花角玉将」",
          "text": "比试的胜负似乎已经没那么重要了，我们就斗个爽快，如何？"
        },
        {
          "role": "「花角玉将」",
          "text": "难得有这么合拍的对手，短短几分钟就结束，未免也太不尽兴了？"
        },
        {
          "role": "荒泷一斗",
          "text": "哈！来就来！"
        },
        {
          "role": "荒泷一斗",
          "text": "不过…看穿本大爷斗虫的秘技？你可别痴心妄想啊！"
        },
        {
          "role": "荒泷一斗",
          "text": "如果你肯承认，是我斗虫的本领更强，无论斗多少场，我都会奉陪到底！"
        },
        {
          "role": "派蒙",
          "text": "唔，放牛的和「花角玉将」还是热血沸腾呢，就让他们继续斗虫吧，斗到他们完全满足！"
        },
        {
          "type": "subtitle",
          "text": "等待至第二天"
        },
        {
          "type": "subtitle",
          "text": "与荒泷一斗对话"
        },
        {
          "role": "「花角玉将」",
          "text": "哈哈哈哈哈哈哈…"
        },
        {
          "role": "「花角玉将」",
          "text": "尽兴！"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈哈哈…"
        },
        {
          "role": "荒泷一斗",
          "text": "痛快！"
        },
        {
          "role": "「花角玉将」",
          "text": "尽管斗虫的风格与我不同，但你倾注在鬼兜虫身上的一腔热血，让我找到了强烈的共鸣。"
        },
        {
          "role": "「花角玉将」",
          "text": "假以时日，你必定能成为斗虫界的佼佼者。"
        },
        {
          "role": "荒泷一斗",
          "text": "你也不赖！整整一千一百四十一场较量，居然能勉强战胜本大爷五百七十场。"
        },
        {
          "role": "荒泷一斗",
          "text": "和本大爷拉锯百场以上的对手里，你最有毅力，不得不说，你让本大爷刮目相看了！"
        },
        {
          "role": "「花角玉将」",
          "text": "是五百七十一场，我赢的次数更多哦。考虑到客场作战的因素，本来应该是我占上风。"
        },
        {
          "role": "荒泷一斗",
          "text": "嘿？怎么了你？这种时候还嘴硬？本大爷记得清清楚楚，阿守也可以作证！"
        },
        {
          "role": "荒泷一斗",
          "text": "你说是吧，阿守？"
        },
        {
          "role": "阿守",
          "text": "老大…我，我实在撑不住了…让我睡一会儿吧。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，难道这段时间，他们一直在这里斗虫，完全没有休息吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "擂台都快被震裂了吧…",
              "dialogues": []
            },
            {
              "text": "鬼兜虫都要累趴了吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "行！本大爷宽宏大量，让你一局也无所谓，反正接下来，本大爷还会赢回来的！"
        },
        {
          "role": "荒泷一斗",
          "text": "看你不服气的样子，之后的较量，就去你的主场吧。本大爷要让你明白，场地没什么影响，关键还是斗虫的人！"
        },
        {
          "role": "「花角玉将」",
          "text": "正合我意，且随我来。"
        },
        {
          "role": "荒泷一斗",
          "text": "嗯？我的挚友和飞行矮堇瓜，你们可算来了！"
        },
        {
          "role": "派蒙",
          "text": "怎么又变回飞行矮堇瓜了，难道我不帮你斗虫的时候，你就只能想起难听的外号吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "这个先放一边！说好要给你们的两月份免费拉面优惠券，拿着吧！"
        },
        {
          "role": "派蒙",
          "text": "拉面优惠券？对哦，拉面！"
        },
        {
          "role": "派蒙",
          "text": "这样才像话嘛，还算你识相！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "撒花庆祝！",
              "dialogues": []
            },
            {
              "text": "「斗虫大试合」完满结束！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "不对不对，这次只算是「荒泷极意堂堂斗虫大试合」的预演！"
        },
        {
          "role": "荒泷一斗",
          "text": "毕竟完全没有任何观众，未免也太冷清了，不能就这样草草了事！"
        },
        {
          "role": "荒泷一斗",
          "text": "走运的是，「花角玉将」总算放下了他的架子，承认本大爷是难得一遇的斗虫强者！"
        },
        {
          "role": "荒泷一斗",
          "text": "我们的较量还没结束，之后，本大爷要孤军深入「花角玉将」的阵地，打他个心服口服！"
        },
        {
          "role": "荒泷一斗",
          "text": "到时候，「花角玉将」也会听候本大爷的调遣，一起把「荒泷极意堂堂斗虫大试合」办得红红火火！"
        },
        {
          "role": "荒泷一斗",
          "text": "这次就多谢你们了，等着本大爷的捷报吧！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，这回放牛的可算是玩了个爽快，我们也赚到了整整两个月的拉面！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "全员大丰收！",
              "dialogues": []
            },
            {
              "text": "好啦，其实开心更重要…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿晃",
          "text": "老大，老大！忍姐来信了，你快看看…"
        },
        {
          "role": "阿晃",
          "text": "咦？老大跑哪儿去了？之前明明一直在这儿斗虫的啊？"
        },
        {
          "role": "派蒙",
          "text": "欸？有什么要紧的事吗？放牛的刚刚才跟着「花角玉将」走了，说是要继续去切磋…"
        },
        {
          "role": "阿晃",
          "text": "倒也不是什么要紧的事，就是有点意外…"
        },
        {
          "role": "阿晃",
          "text": "具体的内容，请你们看一下信吧。"
        },
        {
          "type": "subtitle",
          "text": "久岐忍的来信"
        },
        {
          "type": "subtitle",
          "text": "老大：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "我的事还没办完，一时半会儿还回不来。要是你有了什么新点子，想带着弟兄们干一番大事，先别急着动手，等我回来给你们做规划。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "之前我采堇瓜的时候碰到了一位小友，他能言善道，特别喜欢斗虫，还有不少这方面的朋友。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "听说你也对斗虫很在行，这位小友很期待与你交流，还说如果你的斗虫本领比他强的话，可以考虑加入「荒泷派」，所以我给了他几个你常活动的地址，让他来找你。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "现在你们应该已经见面了吧？希望你们玩得开心。当然，记得按时吃饭。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "再说一遍，切记！这段时间就安心斗虫，消停一会儿吧，千万不要和弟兄们到处折腾！",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "呃啊，结果到头来，「花角玉将」也算是荒泷派的自己人吗？只不过「花角玉将」根本不好好说话，搞得放牛的如临大敌…"
        },
        {
          "role": "派蒙",
          "text": "和阿忍的预料一样，放牛的确实在废寝忘食地斗虫。"
        },
        {
          "role": "派蒙",
          "text": "不过找了我们来举办「荒泷极意堂堂斗虫大试合」…"
        },
        {
          "role": "旅行者",
          "text": "倒也算不上消停…"
        },
        {
          "role": "派蒙",
          "text": "这样看来，拉面的优惠券，更应该奖励给阿忍才对嘛！等到阿忍回来了，我们一起去吃吧！"
        },
        {
          "role": "派蒙",
          "text": "欸？等等…"
        },
        {
          "role": "派蒙",
          "text": "说起来，放牛的根本还没有告诉我们，这张优惠券究竟能被用在哪家拉面店呢…"
        },
        {
          "role": "派蒙",
          "text": "难不成，还得我们自己去找吗！"
        }
      ],
      "collapse_ranges": [
        [
          49,
          55
        ]
      ]
    }
  ]
}