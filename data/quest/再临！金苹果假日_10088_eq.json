{
  "quest_id": 10088,
  "chapter_num": "远海诗夏游纪 其一",
  "chapter_title": "再临！金苹果假日",
  "type": "eq",
  "route": "The Golden Apple Vacation Returns!",
  "stories": [
    {
      "story_id": 40064,
      "title": "再临！金苹果假日",
      "description": "随盛夏一同到来的还有一封神秘来信。见字如晤，寄信者似乎在等什么人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往蒙德冒险家协会"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，正好，我这里有一份来自你朋友的口信。"
        },
        {
          "role": "派蒙",
          "text": "口信？好难得啊，会是谁呢？"
        },
        {
          "role": "凯瑟琳",
          "text": "「心爱的臣子，愿你察觉到纺织出命运的银线正将你缠绕。大幻梦森…嗯？森罗万象…之眼，将注视你…」"
        },
        {
          "role": "凯瑟琳",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "凯瑟琳",
          "text": "抱歉，很少有这么难念的东西，我读得不太顺。两位确定想听下去吗？"
        },
        {
          "role": "派蒙",
          "text": "呃…一听就是菲谢尔的留言…怎么办？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我想听完。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "「将注视你迈入位于幽夜净土的无上王城。速来觐见，以祝圣之名向我宣誓，与我同往世界之底。」"
                }
              ]
            },
            {
              "text": "还是不听了吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "总之，菲谢尔小姐留下这条口信，让二位到教堂前的广场去。"
        },
        {
          "role": "凯瑟琳",
          "text": "等你们有空的时候，去那里找她吧。她说她会一直等你们。"
        },
        {
          "role": "派蒙",
          "text": "呜呃…口信内容那么抽象，要求却这么具体…真服了她…"
        },
        {
          "role": "派蒙",
          "text": "菲谢尔让我们去教堂前的广场，那还是不要让她等太久了，我们赶快去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "前往广场与菲谢尔见面"
        },
        {
          "role": "派蒙",
          "text": "她们在那边，而且莫娜也在呢！"
        },
        {
          "role": "菲谢尔",
          "text": "来了吗，本皇女最忠诚的扈从！"
        },
        {
          "role": "莫娜",
          "text": "刚刚还说别人是家臣，现在又说人家是扈从…"
        },
        {
          "role": "奥兹",
          "text": "哎呀，小姐心情好的时候措辞难免有些夸张，还请见谅。"
        },
        {
          "role": "派蒙",
          "text": "菲谢尔，你找我们对吧？居然自己先聊得热火朝天的，快告诉我是什么事让人这么开心！"
        },
        {
          "role": "旅行者",
          "text": "好久不见了，几位。"
        },
        {
          "role": "菲谢尔",
          "text": "永夜的絮语将汝召回本皇女身侧，很好，很好。此即祝圣之恩典，至夜之赐福！此等欢愉，当与卿悠然同享…"
        },
        {
          "role": "奥兹",
          "text": "旅行者，派蒙，好久不见，在此向二位献上小姐与我诚挚的问候。"
        },
        {
          "role": "派蒙",
          "text": "我是很想好好打招呼啦，但根本不知道从哪里开始接话…"
        },
        {
          "role": "莫娜",
          "text": "一般人在这种情况下只会说…「嗨旅行者，最近怎么样」。"
        },
        {
          "role": "旅行者",
          "text": "谢谢，还不错呢。"
        },
        {
          "role": "菲谢尔",
          "text": "哼！旅行者与本皇女犹如浩瀚天穹中的伴生双星，本次会面昭示着何种命运，汝不是最清楚吗？"
        },
        {
          "role": "奥兹",
          "text": "正是！梅姬斯图斯卿，还请不要说出如此缺乏想象力的发言。"
        },
        {
          "role": "派蒙",
          "text": "梅…啊？？"
        },
        {
          "role": "旅行者",
          "text": "外号又更新了吗？"
        },
        {
          "role": "菲谢尔",
          "text": "呵呵，梅姬斯图斯卿归附幽夜净土已久，早已成为本皇女麾下首屈一指的宫廷大法师。"
        },
        {
          "role": "莫娜",
          "text": "咳！她只是在叫我的姓氏而已，别介意…搞得我都不好意思了，哈哈哈…"
        },
        {
          "role": "莫娜",
          "text": "旅行者，今天是菲谢尔托凯瑟琳传话给你，让你到这里来的，对吧？"
        },
        {
          "role": "菲谢尔",
          "text": "嗯哼，不愧是大法师，这一切也浮现在汝的占卜中了吗？卿果真是危险的女人。"
        },
        {
          "role": "莫娜",
          "text": "这种事还需要算吗！是你自己说已经给凯瑟琳留了言的啊！"
        },
        {
          "role": "莫娜",
          "text": "咳！失态了，总之我也是被她锤着门板叫出家门的…接下去不论她说什么你都不要太惊讶哦。"
        },
        {
          "role": "派蒙",
          "text": "小意思，我们见过世面，不会怕你们的啦。"
        },
        {
          "role": "菲谢尔",
          "text": "诸位家仆，背负着黑暗宿命的我之故乡，幽夜净土，现已重临世间。众卿，与我并立，一同守候吾等王朝那祝圣的荣光吧！"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "等一下，我不理解…"
        },
        {
          "role": "菲谢尔",
          "text": "如此伟大又隐秘的天启，只有我之御使有幸得知。幽夜净土，正在蒙德附近！"
        },
        {
          "role": "旅行者",
          "text": "明白了，立刻报告骑士团！"
        },
        {
          "role": "奥兹",
          "text": "噢不不，怎么会这样呢！"
        },
        {
          "role": "莫娜",
          "text": "我知道听起来很离奇，但这次的消息不是空穴来风，我能作证。"
        },
        {
          "role": "莫娜",
          "text": "事实上，菲谢尔她…"
        },
        {
          "role": "菲谢尔",
          "text": "梅姬斯图斯卿！"
        },
        {
          "role": "莫娜",
          "text": "啊——好吧好吧！真是的…为什么本天才占星术士也要被迫参加过家家游戏啊…"
        },
        {
          "role": "莫娜",
          "text": "其实，皇女殿下昨天在城外偶遇了火花骑士可莉。皇女与可莉小姐互闻大名已久，当即聊了起来。"
        },
        {
          "role": "莫娜",
          "text": "当时天色已晚，皇女殿下本着关怀与慈爱的原则，亲自陪可莉小姐一同返回蒙德城。"
        },
        {
          "role": "莫娜",
          "text": "途中，皇女殿下将自己的身世告诉了可莉，善良的小骑士悲伤于故国覆灭的故事，含着泪花问道…"
        },
        {
          "role": "奥兹",
          "text": "「噢噢！那个名叫幽夜净土的地方，是真的灭亡了吗？不会再长出来吗？」"
        },
        {
          "role": "菲谢尔",
          "text": "「凡人啊，汝的真诚与悲悯之心打动了本皇女。不妨告诉汝，幽夜净土是不灭的，终有一日重现人间。」"
        },
        {
          "role": "奥兹",
          "text": "「真的吗？那要怎么才能让你的故乡长出来呢？告诉可莉吧，求求你啦求求你啦——」"
        },
        {
          "role": "菲谢尔",
          "text": "「既然汝诚心诚意地叩问…赐予我静谧之乐土，赐予我无双之倾慕，赐予我时间与风，令世界苏生。」"
        },
        {
          "role": "派蒙",
          "text": "复述故事就不要演了吧，说重点！"
        },
        {
          "role": "莫娜",
          "text": "简单地说，可莉送出了一座岛作为复现幽夜净土的伟大圣土。原本我也不信，直到看见这封信。"
        },
        {
          "type": "subtitle",
          "text": "神秘来信"
        },
        {
          "type": "subtitle",
          "text": ":致 尊贵的幽夜净土断罪之皇女殿下，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": ":我是游历于提瓦特山川之间的魔女。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": ":冒昧来信，只因听我年幼的女儿提起，您伟大的国度不幸陨落，而您正在寻找机会拯救它。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": ":距离这里十分遥远的海面上，有一片「金苹果群岛」。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": ":如果这片无主的土地能为幽夜净土的降临计划提供些许帮助，那就太好了！",
          "narration": true
        },
        {
          "role": "奥兹",
          "text": "诸位，这正是上天赐予小姐的绝佳机会。旅行者阁下作为重要的家臣，理应一起见证伟大的时刻。"
        },
        {
          "role": "派蒙",
          "text": "这座海岛…我怎么好像有印象…"
        },
        {
          "role": "旅行者",
          "text": "呃…呃…"
        },
        {
          "role": "菲谢尔",
          "text": "旅行者！还愣着做什么？幽夜的王座正在呼唤。集结在本皇女麾下，成为锋刃执于我手，斩断一切、见证一切吧！"
        },
        {
          "role": "莫娜",
          "text": "她应该只是想邀请你们一起去那座岛而已。话说回来，我总有种感觉，最好不要算有关那座岛的事…"
        },
        {
          "role": "派蒙",
          "text": "咦，为什么呀？"
        },
        {
          "role": "莫娜",
          "text": "既然跟可莉有关，就有可能跟她妈妈有关，那就是跟老太婆有关…呜哇，我才不要。"
        },
        {
          "role": "旅行者",
          "text": "皇女殿下需要我做什么？"
        },
        {
          "role": "菲谢尔",
          "text": "万般全能的你走遍远山大川，读得出星屑坠落掌心的轨迹，见证过雨水汇入命运的伏线。这样的你…"
        },
        {
          "role": "奥兹",
          "text": "——去为小姐找出前往命运之圣土的航路吧！"
        },
        {
          "role": "派蒙",
          "text": "原来只是不认识路啊…"
        },
        {
          "role": "旅行者",
          "text": "我就知道会这样…"
        },
        {
          "role": "派蒙",
          "text": "哼哼，既然你有求于我们，那我也告诉你，我们正是火花骑士可莉的好伙伴，命运的引路人！"
        },
        {
          "role": "旅行者",
          "text": "派蒙，你…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你怎么不演啊！"
        },
        {
          "role": "旅行者",
          "text": "好！我乃跨越星海的唯一之人！"
        },
        {
          "role": "莫娜",
          "text": "于此登场，见证者，引路人，幻梦的编织者——旅行者！{{黑幕|总感觉哪里有点怪}}"
        },
        {
          "role": "菲谢尔",
          "text": "哦呵呵呵呵！非常好，非常好！"
        },
        {
          "type": "subtitle",
          "text": "接下来，一行人在蒙德居民震惊的眼神中表演了整整半小时…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "莫娜",
          "text": "…综上，旅行者，你说你有门路，那这次前往小岛…不是，前往圣土的路就交给你安排了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为了皇女殿下！",
              "dialogues": []
            },
            {
              "text": "梅姬斯图斯卿，放心交给我。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莫娜",
          "text": "行行行，梅姬斯图斯卿要回去收拾行李加补眠了，诸位大人殿下阁下，我们明天九点在城门口集合吧。"
        },
        {
          "role": "菲谢尔",
          "text": "噢！就这么办吧。赐汝无人侵扰的深眠，梅姬斯图斯卿。还有你，旅行者。"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是各位晚安，明天见。"
        },
        {
          "role": "派蒙",
          "text": "真是够了…晚安！"
        },
        {
          "role": "派蒙",
          "text": "我累死了我累死了！为什么你们都有正常的角色，我却要演皇宫里的报时挂钟啊！"
        },
        {
          "role": "派蒙",
          "text": "「布谷布谷——幽夜净土时间十二点整——」"
        },
        {
          "role": "旅行者",
          "text": "（派蒙，明明是第一个开始演的…）"
        },
        {
          "role": "派蒙",
          "text": "既然是要去不可思议的海岛，肯定得找一些一看就有奇思妙想的人帮忙，对吧？"
        },
        {
          "role": "派蒙",
          "text": "说到奇思妙想，这整座蒙德城里，除了凯亚，就数那家伙鬼点子最多…"
        },
        {
          "role": "派蒙",
          "text": "这个时间点，那家伙一定在酒馆里，我们立刻出发，抓他来帮忙！"
        },
        {
          "type": "subtitle",
          "text": "前往「天使的馈赠」"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "派蒙",
          "text": "到啦！我看看，卖唱的…咿！"
        },
        {
          "role": "派蒙",
          "text": "喂旅行者，那两个家伙怎么会在蒙德啊！"
        },
        {
          "role": "温迪",
          "text": "哎呀呀，真的来了！快请坐，加入我们愉快的闲聊。"
        },
        {
          "role": "辛焱",
          "text": "哇，旅行者，派蒙！刚说到你们两个，本人立刻到场了，真是巧啊。"
        },
        {
          "role": "枫原万叶",
          "text": "哈哈，此谓之「无巧不成书」。"
        },
        {
          "role": "派蒙",
          "text": "万叶，辛焱，你们两个怎么到蒙德酒馆来了？而且还跟卖唱的坐在同一桌…"
        },
        {
          "role": "辛焱",
          "text": "卖唱的？哈哈哈，真是个有意思的外号。看来小哥你是声名在外，唱歌很有一套。"
        },
        {
          "role": "温迪",
          "text": "可惜不是摇滚，不然就能跟辛焱一起表演了。"
        },
        {
          "role": "温迪",
          "text": "没想到几位全都互相认识！我的新朋友是老朋友的他乡之友，嗯，这太棒了。"
        },
        {
          "role": "温迪",
          "text": "机会难得，干脆大家成立一个兴趣小组吧，就叫自由情诗社什么的…"
        },
        {
          "role": "旅行者",
          "text": "你们是从璃月过来的吗？"
        },
        {
          "role": "辛焱",
          "text": "对呀，这次我想外出采风寻找新的作曲灵感，万叶也想外出走走，就一起过来了。"
        },
        {
          "role": "辛焱",
          "text": "上个月北斗姐办了场大型饮酒会，起名叫「英杰痛饮锦标赛」。我帮着奏乐，就是那一次认识了万叶。"
        },
        {
          "role": "枫原万叶",
          "text": "辛焱看似不羁，对音乐的理解却极为细心独到，我们俩，怎么都能算是音乐知音了。"
        },
        {
          "role": "辛焱",
          "text": "可不是嘛！万叶能用树叶当乐器，在我朋友里也是首屈一指的高手啦。"
        },
        {
          "role": "辛焱",
          "text": "我们从璃月出发，穿过石门一直往前，就进入蒙德境内了。沿途还看到了一片漂亮的庄园，真不错！"
        },
        {
          "role": "派蒙",
          "text": "哦！说起来，那座庄园也是我们朋友名下的资产呢。"
        },
        {
          "role": "辛焱",
          "text": "真的？你们朋友可真多！住在那样的地方，你这位朋友一定很热爱生活吧？"
        },
        {
          "role": "派蒙",
          "text": "呃…应该是吧…"
        },
        {
          "role": "枫原万叶",
          "text": "人会与志趣相投的人走到一起，可见旅行者和派蒙也与那位朋友一样，有良好的品味。"
        },
        {
          "role": "派蒙",
          "text": "哇，你真会说话！不像这家伙，老是吐槽我。"
        },
        {
          "role": "辛焱",
          "text": "啊对，你们知道据说规模很大，足以横跨提瓦特七国的那个「虹色巡回］吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "记得。",
              "dialogues": []
            },
            {
              "text": "没印象。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "辛焱",
          "text": "哎呀雷声大雨点小，反正就是个音乐盛典，主办还坑过我。虽然上次放了我鸽子，但听说他们还在活动。"
        },
        {
          "role": "辛焱",
          "text": "我是很想再见见那位负责人，可没想到，盛典又没了下文…该不会，他们又把事情搅黄了吧？"
        },
        {
          "role": "温迪",
          "text": "音乐全靠灵感，说不定他们是因为没有灵感才终止了演出。"
        },
        {
          "role": "温迪",
          "text": "不过嘛，你们的路也没有白走。这一走，就走到了我这里，嗯~走入了音乐殿堂。"
        },
        {
          "role": "辛焱",
          "text": "音乐殿堂里可不只有好听的旋律，还得有精妙的故事，这样才能被吟游诗人认可，对不对？"
        },
        {
          "role": "温迪",
          "text": "哈哈，当然当然！你太懂吟游诗人了，作为报答，我愿意为你讲一个故事。"
        },
        {
          "role": "辛焱",
          "text": "哈哈哈哈，小哥，你说话真逗。吟游诗人都这样吗？"
        },
        {
          "role": "枫原万叶",
          "text": "我在别处旅行时，也遇到过其他吟游诗人，但没有一位像你一样风趣幽默。"
        },
        {
          "role": "温迪",
          "text": "想必我们之间有想象力上的差距，所以接下来，我要讲一个异想天开的故事给各位助助兴。"
        },
        {
          "role": "温迪",
          "text": "「传说，大海中央有一座绿宝石般的岛屿。嘟嘟大魔王带着它的臣民，幸福快乐地生活在那里。」"
        },
        {
          "role": "温迪",
          "text": "「每一个嘟嘟可出生后都会跃入水中，有些游泳，有些则被浪冲走，来到蒙德，成为小孩子的好朋友。」"
        },
        {
          "role": "温迪",
          "text": "「嘟嘟可在蒙德交到了新朋友——火花小骑士，然而大魔王不同意，要求小骑士前往岛上，证明自己。」"
        },
        {
          "role": "温迪",
          "text": "「于是，小骑士带上她最重要的伙伴，穿过风浪抵达海的中央。但魔王不在那里，魔王撒了谎…」"
        },
        {
          "role": "温迪",
          "text": "「没有试炼，没有火焰与审问。小骑士的魔女妈妈在那里造了一座夏日之城，作为礼物送给她。」"
        },
        {
          "role": "温迪",
          "text": "「——夏天是爱的季节，是自由与放松的季节。所以来到这里的人们，请你歌唱、起舞，请你快乐。」"
        },
        {
          "role": "温迪",
          "text": "…故事就到这里。"
        },
        {
          "role": "旅行者",
          "text": "（真巧，我才刚想问海岛的事，就被他抢先了呢…）"
        },
        {
          "role": "枫原万叶",
          "text": "有意思，说得我也想去那片海岛看看了。旅行一事…果然不能提前计划，随时出发，身随心动才是上选。"
        },
        {
          "role": "温迪",
          "text": "哈哈，你们喜欢就好。桌上有酒，我有故事，所谓缘分就是这样的东西吧。"
        },
        {
          "role": "辛焱",
          "text": "好，为音乐干杯！旅行者，一起啊！"
        },
        {
          "role": "温迪",
          "text": "别担心，不想喝酒的话这里有果汁饮料哦。"
        },
        {
          "role": "枫原万叶",
          "text": "那我要一杯果汁。嗯，就选这个颜色的好了。"
        },
        {
          "type": "subtitle",
          "text": "莫名其妙被拉过去跟大家喝了一杯又一杯…回过神来，有人已经喝得迷迷糊糊了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "啊！万叶！"
        },
        {
          "role": "辛焱",
          "text": "糟了，小哥怎么喝醉了…他喝的不是果汁吗？"
        },
        {
          "role": "枫原万叶",
          "text": "唔…喝…喝点…"
        },
        {
          "role": "温迪",
          "text": "啊呀，好像不小心摆了混入一点酒精的果汁…欸嘿，不好意思。"
        },
        {
          "role": "派蒙",
          "text": "喂…"
        },
        {
          "role": "温迪",
          "text": "喝了这么多杯，也该聊聊正事了。旅行者你找我一定有重要的事，对吧？"
        },
        {
          "role": "派蒙",
          "text": "这么一说才想起来，我们不是来喝酒的啊…"
        },
        {
          "role": "旅行者",
          "text": "温迪，借一步说话。"
        },
        {
          "type": "subtitle",
          "text": "到酒馆二楼与温迪对话"
        },
        {
          "role": "温迪",
          "text": "都到这里了，嗯，我能感觉到，你要说的话题肯定很有趣。"
        },
        {
          "type": "subtitle",
          "text": "把火花骑士赠岛、皇女殿下即将率众前往海岛的事告诉了温迪…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "温迪",
          "text": "竟然将妈妈为自己打造的礼物送给了冒险家朋友，可莉果然是个温柔的孩子。"
        },
        {
          "role": "温迪",
          "text": "相信你们应该也猜到了，那封信啊，绝对出自艾莉丝女士之手。"
        },
        {
          "role": "派蒙",
          "text": "果然是这样啊…"
        },
        {
          "role": "温迪",
          "text": "不仅如此，今天我还在去酒馆的路上遇到了两个人，猜猜是谁？"
        },
        {
          "role": "派蒙",
          "text": "唔…琴团长？或者…图书管理员丽莎？"
        },
        {
          "role": "温迪",
          "text": "一对母女，都长着长长的精灵耳朵，有着令人惊讶的可爱性格。"
        },
        {
          "role": "派蒙",
          "text": "是艾莉丝和可莉？！"
        },
        {
          "role": "温迪",
          "text": "叮咚！猜对了。"
        },
        {
          "role": "温迪",
          "text": "不老魔女带着小小的骑士一起外出度假，而我正好遇到她们。作为问候，神奇的女士给了我一份礼物…"
        },
        {
          "role": "温迪",
          "text": "她还说，如果遇到有趣的朋友，就与对方共享这份礼物。所以旅行者，现在我把它给你。"
        },
        {
          "role": "派蒙",
          "text": "啊啊啊！炸弹啊！"
        },
        {
          "role": "温迪",
          "text": "火芯都拔了，不会爆炸的啦。拿着它吧，这样一来，哪怕你我分隔两地也能像这样对话哦。"
        },
        {
          "role": "旅行者",
          "text": "还有这种好东西？"
        },
        {
          "role": "温迪",
          "text": "它叫做「嘟嘟通讯仪」，能让相隔千里的人们保持联络，不过不是什么时候都能用，使用次数也有限制，只在近期提供给有缘人。"
        },
        {
          "role": "温迪",
          "text": "据说发明灵感来源于异世界…不愧是艾莉丝女士。"
        },
        {
          "role": "温迪",
          "text": "她和可莉让我转告你们，「带上这个，与各位伙伴一同前往海岛，哦不圣土，尽情玩耍吧。」"
        },
        {
          "role": "温迪",
          "text": "至于怎么过去，别担心，假日的策划者自有安排。出城门过桥右转，你就会见到为你带去快乐的东西。"
        },
        {
          "role": "派蒙",
          "text": "听起来你们俩串通一气…"
        },
        {
          "role": "温迪",
          "text": "哈哈哈，怎么会呢，我在你们心里是那种人？"
        },
        {
          "role": "温迪",
          "text": "旅行者，你可是我的朋友，身为朋友，我当然要送你带来快乐的东西了。你怎么能这样想我呢？"
        },
        {
          "role": "旅行者",
          "text": "我知道了，我去就是。"
        },
        {
          "role": "派蒙",
          "text": "好吧，卖唱的虽然很爱胡说八道，但也是我们重要的朋友呢。正好我也想度假了，嘿嘿…"
        },
        {
          "role": "派蒙",
          "text": "说起来，刚才万叶和辛焱也表现得很感兴趣的样子，问问他们要不要一起去吧！"
        },
        {
          "role": "辛焱",
          "text": "回来啦？可惜，万叶还在酣睡…他对酒精不太行啊。"
        },
        {
          "role": "派蒙",
          "text": "辛焱，你们要不要跟我们一起去海岛玩？"
        },
        {
          "role": "枫原万叶",
          "text": "呼…唔…冒险…冒险，不可以…"
        },
        {
          "role": "辛焱",
          "text": "哎？他这是不想去了？刚刚还一副很感兴趣的样子嘛。"
        },
        {
          "role": "枫原万叶",
          "text": "不可以…错过…"
        },
        {
          "role": "辛焱",
          "text": "哈哈哈哈万叶这家伙，再怎么老成也是个对新鲜事物感兴趣的年轻人啊，所以才会一高兴就分不清果汁和酒。"
        },
        {
          "role": "温迪",
          "text": "既然是这样，就更不该错过海岛之旅了！要知道，这座岛屿可是拥有连吟游诗人都交口称赞的美丽景色啊。"
        },
        {
          "role": "辛焱",
          "text": "噢！就这么定了，旅行者，我们怎么过去？"
        },
        {
          "role": "派蒙",
          "text": "听说有人安排了，刚巧这次还有其他朋友一起，我们约了明天早上在城门口集合，等人齐了一起出发。"
        },
        {
          "role": "旅行者",
          "text": "万叶醒醒！要出远门了！"
        },
        {
          "role": "枫原万叶",
          "text": "嗯…？旅行者？"
        },
        {
          "role": "派蒙",
          "text": "噢噢对，他们还不认识菲谢尔！是这样的，有位来自异国他乡的尊贵皇女将携大臣们参加本次旅行…"
        },
        {
          "role": "辛焱",
          "text": "……？"
        },
        {
          "role": "辛焱",
          "text": "那个，派蒙，我没别的意思，就是以防万一问问…呃，你这么积极地推销旅游，难道是…当了虹色巡回的托儿吗？"
        },
        {
          "role": "辛焱",
          "text": "我总觉得，那些奔着虹色巡回赶去别国，最终却被放了鸽子的人，不就等于是被骗去旅游了吗？"
        },
        {
          "role": "派蒙",
          "text": "啊——！我就知道没人信！"
        },
        {
          "role": "温迪",
          "text": "哈哈哈，大家不要担心，明天早晨各位就会见面了。"
        },
        {
          "role": "温迪",
          "text": "不论是皇女、臣子、会说话的乌鸦，还是异乡剑客、别国乐手…大家都是夏日海岛的贵客，不是吗？"
        },
        {
          "role": "辛焱",
          "text": "说得我好期待啊。"
        },
        {
          "role": "旅行者",
          "text": "对了温迪，你去吗？"
        },
        {
          "role": "温迪",
          "text": "我就不了，这几天还有工作。"
        },
        {
          "role": "派蒙",
          "text": "不会吧，卖唱的居然要工作了？"
        },
        {
          "role": "温迪",
          "text": "我答应一位长着猫耳猫尾的小女士{{黑幕|迪奥娜}}，要为她的酒馆唱歌揽生意，打败竞争对手。啊对，就是有六指乔瑟的这一家。"
        },
        {
          "role": "派蒙",
          "text": "你不是对猫过敏吗？"
        },
        {
          "role": "温迪",
          "text": "嗯，我可以在屋顶上唱。"
        },
        {
          "role": "温迪",
          "text": "她说，只要能在营业额上占优势，就愿意包我一整个月的酒。这种好事，简直是为我量身定制的啊！"
        },
        {
          "role": "温迪",
          "text": "所以别在意我，你们几个玩得开心。啊哈哈，今年夏天一定会非常有趣吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（辛焱＆枫原万叶）"
        },
        {
          "role": "辛焱",
          "text": "万叶，万叶！…唉，还是没醒，看来今晚要留在酒馆里了呢。"
        },
        {
          "role": "枫原万叶",
          "text": "呼…呼…"
        },
        {
          "type": "subtitle",
          "text": "等待至次日早晨（8点-10点）"
        },
        {
          "type": "subtitle",
          "text": "前往城门口"
        },
        {
          "role": "菲谢尔",
          "text": "今日正是我观测夜空真理，与命运一决胜负之日！往昔的耻辱、经年的遗恨…在此，一决胜负！"
        },
        {
          "role": "奥兹",
          "text": "小姐，恕我直言，这句「在此什么什么」，似乎不是您的口头禅啊。"
        },
        {
          "role": "菲谢尔",
          "text": "自然不是。本皇女不过是曾经耳闻城中…咳！是征用大陆各地富有智慧与勇气的箴言，以彰显今日之尊殊…"
        },
        {
          "role": "莫娜",
          "text": "唔…我看看…啊？还真是别人的口头禅？"
        },
        {
          "role": "派蒙",
          "text": "哇，你们真早！"
        },
        {
          "role": "莫娜",
          "text": "你们来啦！"
        },
        {
          "role": "莫娜",
          "text": "后面那几位是…？"
        },
        {
          "role": "派蒙",
          "text": "嗯咳咳！容我为大家介绍，此二人乃是来自稻妻的传奇浪人武士和来自璃月的音乐先锋奇才。"
        },
        {
          "role": "辛焱",
          "text": "你们好啊！我叫辛焱，是璃月人，喜欢摇滚乐、好天气和令人开心的好事。"
        },
        {
          "role": "辛焱",
          "text": "这位小姐一定就是派蒙说的皇女了吧？看起来就不一般，听说你从异国来，想必是个厉害的人物。"
        },
        {
          "role": "辛焱",
          "text": "还有这位戴帽子的小姐，我听家里人说，最富有智慧的学者通常都会准备一顶尖头帽，你也是这样吗？"
        },
        {
          "role": "莫娜&菲谢尔",
          "text": "（嗯？这个女人…眼光不错！）"
        },
        {
          "role": "菲谢尔",
          "text": "辛焱，你这双眼睛能够看透雾夜之迷障，触达真实，正是我需要的人。很好，汝就是我的御用乐师了。"
        },
        {
          "role": "莫娜",
          "text": "她是想说你很不错，眼光很好！嗯，我也有同感，很高兴认识你，我叫莫娜，是个占星术士。"
        },
        {
          "role": "辛焱",
          "text": "噢，很高兴认识你们！"
        },
        {
          "role": "派蒙",
          "text": "莫娜可厉害了，无论是什么样的人，她都能摸清对方来龙去脉！"
        },
        {
          "role": "枫原万叶",
          "text": "皇女与占星术士，还有能言善道的乌鸦家臣…与各位相比，我实在平平无奇，不足挂齿。"
        },
        {
          "role": "枫原万叶",
          "text": "在下枫原万叶，来自稻妻。很荣幸认识各位。"
        },
        {
          "role": "菲谢尔",
          "text": "这位…万叶，报上汝的力量与名讳。"
        },
        {
          "role": "奥兹",
          "text": "噢小姐的意思是，您于何处高就？可有什么特长爱好？"
        },
        {
          "role": "枫原万叶",
          "text": "这…在下只是一介过客，身无长物…"
        },
        {
          "role": "派蒙",
          "text": "哼哼，我们这位朋友武艺高强，能接下别人招架不住的攻击，更能挥剑如闪电，凡人根本无从想象！"
        },
        {
          "role": "菲谢尔",
          "text": "（哎？是这么厉害的人物吗？！）"
        },
        {
          "role": "莫娜",
          "text": "我看看…唔…嗯？！这、这…"
        },
        {
          "role": "莫娜",
          "text": "你好万叶，非常高兴认识你这样厉害的剑术大师，我们一行人在海岛的护卫工作能委托给你吗？"
        },
        {
          "role": "菲谢尔",
          "text": "幽夜净土的宫廷侍卫长已然就位。"
        },
        {
          "role": "奥兹",
          "text": "连梅姬斯图斯卿都这么说，看来您实力了得。"
        },
        {
          "role": "旅行者",
          "text": "梅姬斯图斯卿说得没错！"
        },
        {
          "role": "枫原万叶",
          "text": "好的，梅…梅…"
        },
        {
          "role": "辛焱",
          "text": "梅…什么梅？"
        },
        {
          "role": "莫娜",
          "text": "叫我莫娜就好了啦！不要再喊那个奇怪的名字了！"
        },
        {
          "role": "派蒙",
          "text": "说起来，梅姬斯图斯卿，我们问到怎么去圣土了哦。"
        },
        {
          "role": "派蒙",
          "text": "嘻嘻…传说中的大魔女给了我们伟大建议，来吧，大家跟着我！"
        },
        {
          "type": "subtitle",
          "text": "前往派蒙所说的位置"
        },
        {
          "role": "派蒙",
          "text": "大家看，这就是我们的交通工具。"
        },
        {
          "role": "莫娜",
          "text": "……"
        },
        {
          "role": "莫娜",
          "text": "不知怎么搞的，突然一点都不想去了。"
        },
        {
          "role": "辛焱",
          "text": "好别致的东西，长得…长得是不是有些像锅巴？"
        },
        {
          "role": "旅行者",
          "text": "？"
        },
        {
          "role": "枫原万叶",
          "text": "锅巴…是万民堂那只神奇生物？这么一说，还真有点…"
        },
        {
          "role": "派蒙",
          "text": "呃…虽然刚才是我做的介绍，但我也不觉得这东西能送我们去海岛…"
        },
        {
          "role": "菲谢尔",
          "text": "…哼。"
        },
        {
          "role": "菲谢尔",
          "text": "我明白了。原来如此…原来如此。唯有堕入终末，才能抵达新生的幽夜净土。"
        },
        {
          "role": "菲谢尔",
          "text": "哦呵呵，好一道圣裁之雷烧灼之门，与本皇女断罪现世的做派万分契合。来吧奥兹，为我开辟征途！"
        },
        {
          "role": "奥兹",
          "text": "打头阵的正是在下。小姐自己是不会动的。"
        },
        {
          "role": "派蒙",
          "text": "…进去了…消失了？！"
        },
        {
          "role": "菲谢尔",
          "text": "这、这当真是前往圣土的断罪之路！"
        },
        {
          "role": "莫娜",
          "text": "安全起见算一下吧我…"
        },
        {
          "role": "派蒙",
          "text": "梅姬斯图斯卿，这可是那位艾莉丝大人的造物！请不要这样牺牲自己，跟我们一起走罢。"
        },
        {
          "role": "莫娜",
          "text": "对哦！怎么忘了…唉，好吧。"
        },
        {
          "type": "subtitle",
          "text": "众人面面相觑，随后怀着疑惑又期待的心情依次钻入这台「砰砰魔球堡」之巨口…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "旅途相当热闹，甚至有些拥挤…？",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "好黑啊，能不能开个灯…喂谁啊！不要挤我！"
        },
        {
          "role": "莫娜",
          "text": "慢慢来，我们…呃啊菲谢尔！不要踩我辫子！"
        },
        {
          "role": "菲谢尔",
          "text": "不是蛇吗？！"
        },
        {
          "role": "辛焱",
          "text": "哇啊啊啊飞起来了？！"
        },
        {
          "role": "枫原万叶",
          "text": "各位注意安全！"
        },
        {
          "type": "subtitle",
          "text": "前往金苹果群岛"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "辛焱",
          "text": "呼…总算落地了，刚才到底经历了什么啊…"
        },
        {
          "role": "枫原万叶",
          "text": "好美的地方，有风有海，又很宁静…嗯，风中有好闻的气息。"
        },
        {
          "role": "派蒙",
          "text": "嗯！一看到这片大海，我心情就好起来了。"
        },
        {
          "role": "菲谢尔",
          "text": "……"
        },
        {
          "role": "奥兹",
          "text": "生命之海，苍之大地…小姐，我们终于抵达了圣土，这里足以令幽夜净土苏生。"
        },
        {
          "role": "菲谢尔",
          "text": "…诸位家臣，这正是本皇女追寻已久的祝圣乐园。就在这里，见证因果终结的降临。"
        },
        {
          "role": "菲谢尔",
          "text": "统御漆黑的我，会将诸位带向梦幻的门扉。"
        },
        {
          "role": "莫娜",
          "text": "……"
        },
        {
          "role": "菲谢尔",
          "text": "…带向！梦幻的门扉！"
        },
        {
          "role": "莫娜",
          "text": "……"
        },
        {
          "role": "莫娜",
          "text": "大法师梅姬斯图斯，感谢皇女的恩赐。今日今时，在此献上为我幽夜净土之祝福。"
        },
        {
          "role": "辛焱",
          "text": "莫娜，你、你们这是…"
        },
        {
          "role": "莫娜",
          "text": "别问，加入我！"
        },
        {
          "role": "辛焱",
          "text": "啊…啊对！感谢皇女，带我们来到如此神圣之地！"
        },
        {
          "role": "枫原万叶",
          "text": "衷心感谢您提出这次旅行，皇女殿下。"
        },
        {
          "role": "菲谢尔",
          "text": "诸位的欢愉即是我之喜悦。嗯~如此真命尊奉之时刻，能令各位聚集在此，我也非常欣慰哦。"
        },
        {
          "role": "菲谢尔",
          "text": "我现将踏上巡礼，以身躯感受故土的生命之海。毕竟无论怎么说，这里都是我灵魂的归宿。"
        },
        {
          "role": "菲谢尔",
          "text": "反倒是你，梅姬斯图斯卿，据说你是诞生自水元素的高贵之人，可灵魂中杂质太多…啧啧。"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是，论游泳，梅姬斯图斯卿或许稍逊一筹。"
        },
        {
          "role": "莫娜",
          "text": "呜…菲谢尔，我忍你很久了！"
        },
        {
          "role": "莫娜",
          "text": "平时陪你装模作样演话剧就算了，可你竟然小看我这个天才？要比游泳，我能让你跪地认输！"
        },
        {
          "role": "奥兹",
          "text": "唔哦！小姐，小姐燃起斗志了！"
        },
        {
          "role": "派蒙",
          "text": "好耶！比一比，输的是小狗！"
        },
        {
          "role": "菲谢尔",
          "text": "接受汝的挑衅！区区梅姬斯图斯卿，定将为其愚行懊悔不休！"
        },
        {
          "role": "莫娜",
          "text": "笑话，我从小到大游泳还没输过，来啊，先跑到海边的才是第一名！"
        },
        {
          "role": "辛焱",
          "text": "她俩是认真的吗？跑到海边？那不是在比跑步吗？"
        },
        {
          "role": "旅行者",
          "text": "别在意，开心最重要。"
        },
        {
          "role": "枫原万叶",
          "text": "旅行者，你现在没有安排对吧，我想在附近巡逻，一起吗？"
        },
        {
          "role": "旅行者",
          "text": "不愧是万叶，真可靠。"
        },
        {
          "role": "枫原万叶",
          "text": "先前远远看见西北方有座小岛，感觉很特别，想去看看。"
        },
        {
          "role": "枫原万叶",
          "text": "辛焱要来吗？"
        },
        {
          "role": "辛焱",
          "text": "大家似乎都有事要做，那我先留守吧，刚好莫娜菲谢尔她们去游泳了，总得有人布置营地才行。"
        },
        {
          "role": "辛焱",
          "text": "这里放心交给我！你们要去周围走走对吧？正好看看风景，要是有什么好的观景点，别忘了告诉我啊。"
        },
        {
          "role": "派蒙",
          "text": "噢！那就拜托你啦！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（辛焱）"
        },
        {
          "role": "辛焱",
          "text": "好，先抓十只螃蟹，再捞二十条鱼！唔…够吃吗？这么多人，再准备点什么好呢？"
        },
        {
          "type": "subtitle",
          "text": "前往万叶所说的岛屿"
        },
        {
          "role": "派蒙",
          "text": "喂，那边有台好大的怪东西！"
        },
        {
          "role": "枫原万叶",
          "text": "一路过来，除了这台用途不明的装置和旁边这顶军帽之外，没有其他可疑之处。但岛上明显有人驻扎过。"
        },
        {
          "role": "枫原万叶",
          "text": "此外，还有一些脚印，很新鲜，应该就是近几日印上去的。"
        },
        {
          "role": "派蒙",
          "text": "不会吧？我完全没发现呢…"
        },
        {
          "role": "枫原万叶",
          "text": "…嗯？"
        },
        {
          "role": "枫原万叶",
          "text": "……"
        },
        {
          "role": "枫原万叶",
          "text": "……"
        },
        {
          "role": "枫原万叶",
          "text": "旅行者，派蒙，最好保持警惕。"
        },
        {
          "role": "派蒙",
          "text": "咦？怎么了，有东西吗？"
        },
        {
          "role": "枫原万叶",
          "text": "有人来过…而且没走远。这种气味，对方应该也是远道而来的客人。"
        },
        {
          "role": "派蒙",
          "text": "还有别人在这里？呜，我总觉得有点吓人…喂旅行者，快找找线索！"
        },
        {
          "type": "subtitle",
          "text": "开启元素视野追踪痕迹"
        },
        {
          "role": "派蒙",
          "text": "你说帽子上有水元素力？那我们就跟着元素力走吧。"
        },
        {
          "role": "枫原万叶",
          "text": "似乎接近了。注意安全。"
        },
        {
          "role": "派蒙",
          "text": "是愚人众！"
        },
        {
          "type": "subtitle",
          "text": "击败愚人众士兵"
        },
        {
          "type": "subtitle",
          "text": "与愚人众士兵交谈"
        },
        {
          "role": "派蒙",
          "text": "说起来，这里为什么会有愚人众啊！世上还有没薄荷、甜甜花和愚人众的地方吗？"
        },
        {
          "role": "旅行者",
          "text": "到处都有薄荷甜甜花愚人众。"
        },
        {
          "role": "派蒙",
          "text": "好吧，也有道理。"
        },
        {
          "role": "模样怪异的士兵",
          "text": "呜呜…帽帽丢了…帽帽…"
        },
        {
          "role": "枫原万叶",
          "text": "你在找东西？"
        },
        {
          "role": "模样怪异的士兵",
          "text": "帽帽…不可以，不可以丢呀…"
        },
        {
          "role": "模样怪异的士兵",
          "text": "啊！我什么都不知道，把帽帽还我，呜呜呜…"
        },
        {
          "role": "枫原万叶",
          "text": "你在找这顶帽子吗？"
        },
        {
          "role": "模样怪异的士兵",
          "text": "哥哥的帽帽！给我给我！"
        },
        {
          "type": "subtitle",
          "text": "把帽子归还给愚人众士兵…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这家伙，看起来不太聪明呢…"
        },
        {
          "role": "模样怪异的士兵",
          "text": "别欺负我，不然、不然我就打你…哇啊！大怪物！呜呜…"
        },
        {
          "role": "？？？",
          "text": "站住，你们要干什么！"
        },
        {
          "role": "派蒙",
          "text": "又一个愚人众？这话应该我们问你吧，你们在这座岛上想干什么呀！"
        },
        {
          "role": "模样怪异的士兵",
          "text": "帽帽…保护好…不然，哥哥会生我的气…"
        },
        {
          "role": "佩尔西科夫",
          "text": "别老抱着你哥哥那顶帽子了，得把他人找回来！"
        },
        {
          "role": "枫原万叶",
          "text": "请问他怎么了？"
        },
        {
          "role": "佩尔西科夫",
          "text": "…没什么，有点生病发烧，难免胡言乱语。"
        },
        {
          "role": "佩尔西科夫",
          "text": "我没有义务向你们交代任何事，走开。"
        },
        {
          "role": "派蒙",
          "text": "这里是我们朋友的岛，你们最好小心一点哦。"
        },
        {
          "role": "佩尔西科夫",
          "text": "啊？这不是无人岛吗？我们可是来这…不，没什么。"
        },
        {
          "role": "旅行者",
          "text": "那台装置是什么？"
        },
        {
          "role": "佩尔西科夫",
          "text": "…啧，好吧，我说了你们就不能再来烦我。"
        },
        {
          "role": "佩尔西科夫",
          "text": "那是我发明的新型能源机，我们只是找了座无人岛做性能测试而已。可以了吗？"
        },
        {
          "role": "旅行者",
          "text": "都说了这里是我们的岛。"
        },
        {
          "role": "旅行者",
          "text": "请不要妨碍我们度假。"
        },
        {
          "role": "派蒙",
          "text": "你要是不答应，我们就…抢走这家伙的帽帽！"
        },
        {
          "role": "模样怪异的士兵",
          "text": "啊！不要，不要拿走帽帽！呜呜…"
        },
        {
          "role": "佩尔西科夫",
          "text": "不许哭，喂！…好吧，我答应你们，不会离开这一带。行了吧！"
        },
        {
          "role": "派蒙",
          "text": "对了，你们那台装置怎么冒烟呀？"
        },
        {
          "role": "佩尔西科夫",
          "text": "因为这没出息的玩意儿坏了！我可真不想说…但测试很不顺利，我们本来就已经准备撤队了。"
        },
        {
          "role": "派蒙",
          "text": "什么嘛，那你们赶快走吧，不送了哦。"
        },
        {
          "role": "佩尔西科夫",
          "text": "喂，走了！"
        },
        {
          "role": "模样怪异的士兵",
          "text": "啊是、是…"
        },
        {
          "role": "派蒙",
          "text": "真是的，出门度个假还遇到这些家伙…"
        },
        {
          "role": "枫原万叶",
          "text": "愚人众出现在偏僻的海岛…总觉得没那么简单。"
        },
        {
          "role": "枫原万叶",
          "text": "就算是在度假期间，也请务必保持警惕，旅行者。"
        },
        {
          "role": "旅行者",
          "text": "嗯。"
        },
        {
          "role": "枫原万叶",
          "text": "另外，为了让女士们带着好心情度假，我有个提议。"
        },
        {
          "role": "枫原万叶",
          "text": "暂且让这件事留在我们心中吧，有什么需要注意或警戒的也由我和旅行者负责。你们觉得如何？"
        },
        {
          "role": "旅行者",
          "text": "很有道理，我支持。"
        },
        {
          "role": "派蒙",
          "text": "万叶真是个体贴的人呀。"
        },
        {
          "role": "枫原万叶",
          "text": "派蒙过奖了。我只是觉得，假日难得，不要被琐事打扰才好。"
        },
        {
          "role": "枫原万叶",
          "text": "美景当前，但愿各位都能开心。"
        },
        {
          "type": "subtitle",
          "text": "查看：大法师梅姬斯图斯 vs 断罪之皇女菲谢尔 10:7"
        },
        {
          "role": "今天绝对要决出胜负的游泳比赛",
          "text": "大法师梅姬斯图斯 vs 断罪之皇女菲谢尔 10:7"
        },
        {
          "role": "旅行者",
          "text": "（10这个数字被潦草地划掉了，想也知道是谁做的…旁边还有一些抱怨的句子，仔细看的话，似乎写着「竟敢放水，本皇女不需要对手同情！」）"
        },
        {
          "role": "旅行者",
          "text": "（看来比赛双方的关系并不差。不过真令人惊讶，莫娜竟然会让着菲谢尔吗？）"
        },
        {
          "type": "subtitle",
          "text": "返回营地"
        },
        {
          "role": "派蒙",
          "text": "我们回来啦！"
        },
        {
          "role": "莫娜",
          "text": "来得正好！旅行者，派蒙，你们说，我和菲谢尔谁才是游泳健将？！"
        },
        {
          "role": "菲谢尔",
          "text": "哦呵呵，尽管道出本皇女的真名，让不自量力的梅姬斯图斯卿痛哭流涕吧！"
        },
        {
          "role": "旅行者",
          "text": "我和派蒙一个意见。"
        },
        {
          "role": "派蒙",
          "text": "你怎么这样？！这不是要我来做选择了吗！"
        },
        {
          "role": "奥兹",
          "text": "派蒙独具慧眼，一定能看出真正的赢家是谁。"
        },
        {
          "role": "菲谢尔",
          "text": "对我效忠的时刻到来了哦，派蒙卿。"
        },
        {
          "role": "辛焱",
          "text": "等一等等一等，在这之前先让派蒙吃点东西吧？我看她出去那么久，一定饿了。"
        },
        {
          "role": "派蒙",
          "text": "呜呜呜辛焱！"
        },
        {
          "role": "枫原万叶",
          "text": "嗯，确实是走了不少路。"
        },
        {
          "role": "辛焱",
          "text": "对吧？你们几个出去玩的时候，我在海边捞了些海鲜，还摘了瓜果。用火烤一烤，非常好吃哦！"
        },
        {
          "role": "莫娜",
          "text": "这么一说，我也有点饿了…"
        },
        {
          "role": "菲谢尔",
          "text": "咳！本皇女也…"
        },
        {
          "role": "辛焱",
          "text": "我准备了很多，大家一起吃吧。手艺一般，没法跟我那开餐馆的厨师朋友{{黑幕|香菱}}比，但填饱肚子是绰绰有余。"
        },
        {
          "role": "派蒙",
          "text": "噢！开饭了开饭了！"
        },
        {
          "role": "奥兹",
          "text": "请辛焱卿一起来海岛，绝对是明智之举啊。"
        },
        {
          "role": "派蒙",
          "text": "不说了，我要第一个吃，你们就饿着吧！"
        },
        {
          "role": "莫娜",
          "text": "啊，烧烤的香味…太好吃了。"
        },
        {
          "role": "菲谢尔",
          "text": "唔——！真不错！"
        },
        {
          "role": "枫原万叶",
          "text": "今天是辛焱负责晚饭，那明天的早饭我来做吧。"
        },
        {
          "role": "旅行者",
          "text": "好耶！我等着吃！"
        },
        {
          "role": "派蒙",
          "text": "好耶！我也等着吃！"
        },
        {
          "role": "派蒙",
          "text": "噢对了，旅行者，有件事你好像忘了！"
        },
        {
          "role": "派蒙",
          "text": "我们到边上说吧。"
        },
        {
          "type": "subtitle",
          "text": "到隐蔽地点联络温迪"
        },
        {
          "role": "派蒙",
          "text": "我看你也有些在意愚人众的事，对吧？你记不记得温迪给了我们一个炸弹，用那个能跟他取得联系。"
        },
        {
          "role": "派蒙",
          "text": "啊不对，不是炸弹，温迪说，那个叫嘟嘟通讯仪！"
        },
        {
          "role": "派蒙",
          "text": "找他问问吧，那家伙消息灵通，要是有什么重要的线索，他一定也会知道的。"
        },
        {
          "role": "嘟嘟通讯仪",
          "text": "嘟嘟——嘟嘟——嘟嘟可——"
        },
        {
          "role": "温迪",
          "text": "哈啾！呜呜…"
        },
        {
          "role": "温迪",
          "text": "喂，旅行者，这么快就想到我了？"
        },
        {
          "role": "旅行者",
          "text": "啊温迪，是我是我。"
        },
        {
          "role": "温迪",
          "text": "哈哈哈，除了你可没有人能用这种方式联系到我。"
        },
        {
          "role": "派蒙",
          "text": "你怎么在打喷嚏？"
        },
        {
          "role": "温迪",
          "text": "猫尾酒馆附近很多猫呢，老板给了我过敏药，但没什么用…哈啾！…嗯，尽管说吧，想问我什么？"
        },
        {
          "role": "旅行者",
          "text": "让派蒙细细道来。"
        },
        {
          "role": "派蒙",
          "text": "你还能再懒一点吗！"
        },
        {
          "role": "派蒙",
          "text": "好吧，温迪，我们在海岛上遇到了一些奇怪的事情，这里居然有愚人众！"
        },
        {
          "role": "温迪",
          "text": "愚人众…他们不是无处不在吗？"
        },
        {
          "role": "温迪",
          "text": "啊哈哈，冰神的部下可是很能干的哦，出现在哪里都不奇怪。"
        },
        {
          "role": "派蒙",
          "text": "可是出现在这里会影响我们度假啊！"
        },
        {
          "role": "旅行者",
          "text": "就是就是。"
        },
        {
          "role": "温迪",
          "text": "但听你的口气，应该没遇到什么麻烦对吧？也就是说，你们一定已经解决问题了。"
        },
        {
          "role": "派蒙",
          "text": "话是这么说啦，但我们觉得不太对劲，才想问问你的…你那里有线索吗？"
        },
        {
          "role": "温迪",
          "text": "我也没听说任何有关愚人众的新消息。不过别担心，虽然我只是个卖唱的，必要时也可以联系我。"
        },
        {
          "role": "温迪",
          "text": "就算帮不上什么忙，能陪你们聊聊天，多少能让你们放心吧？"
        },
        {
          "role": "派蒙",
          "text": "哼，这家伙…"
        },
        {
          "role": "温迪",
          "text": "你们擅长冒险，外出旅行遇到意外的惊喜也不奇怪呀。但千万不要害怕它，可不是所有邂逅都叫危险。"
        },
        {
          "role": "温迪",
          "text": "风在陆地上，自然也会在海边。白云飘浮的地方，风也随之而至。所以放心吧，风将永远陪伴你们。"
        },
        {
          "role": "旅行者",
          "text": "嗯。"
        },
        {
          "role": "温迪",
          "text": "那就先聊到这里，我要去猫尾酒馆演出啦！"
        },
        {
          "role": "派蒙",
          "text": "噢噢，再见！"
        },
        {
          "role": "派蒙",
          "text": "所以他的意思也是不用太担心愚人众，对吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "应该是的。",
              "dialogues": []
            },
            {
              "text": "和我想的差不多。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔，既然卖唱的也这么说，那就希望这次旅行平平安安，不要有任何怪事发生。"
        },
        {
          "role": "派蒙",
          "text": "跟朋友一起出远门，玩得开心才最重要！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（枫原万叶＆辛焱、菲谢尔＆莫娜）"
        },
        {
          "role": "枫原万叶",
          "text": "听着海风享用美食，当真是一件乐事。辛焱，多谢你为大家准备的晚餐。"
        },
        {
          "role": "辛焱",
          "text": "没事，不用客气。看大家吃得开心，我也满足得很。我还担心自己对数量把控缺乏经验，不够吃…或者吃剩好多呢。"
        },
        {
          "role": "辛焱",
          "text": "啊，对了…你们逛得怎么样，有没有去高点的地方看看风景？"
        },
        {
          "role": "枫原万叶",
          "text": "嗯，吟游诗人口中「绿宝石般的」岛屿名副其实。"
        },
        {
          "role": "辛焱",
          "text": "哦？难道那一整个故事也都是真的？"
        },
        {
          "role": "枫原万叶",
          "text": "不好说。不过，我倒是相信的。"
        },
        {
          "role": "辛焱",
          "text": "那要是明天醒来，我们就能见到故事里的魔王或者嘟嘟可，一定会很有意思。"
        },
        {
          "role": "辛焱",
          "text": "…不对，见不到也没关系。能来到故事里的岛屿，还能交到蒙德的朋友，已经很有收获了。"
        },
        {
          "role": "菲谢尔",
          "text": "凡尘的诱惑迫使真相却步，昭告胜利的判决未能显现在我的面前。"
        },
        {
          "role": "莫娜",
          "text": "没想到，你还好意思再提起这个话题。"
        },
        {
          "role": "莫娜",
          "text": "你跟奥兹一唱一和，拼命在旅行者和派蒙耳边暗示，我看早就偏离了公平吧。"
        },
        {
          "role": "莫娜",
          "text": "而且，也只有输了的人才会想要得到…"
        },
        {
          "role": "菲谢尔",
          "text": "你说什么？"
        },
        {
          "role": "奥兹",
          "text": "小姐，她的意思是你输了。"
        },
        {
          "role": "菲谢尔",
          "text": "多嘴！奥兹！"
        },
        {
          "role": "菲谢尔",
          "text": "咳咳…梅姬斯图斯卿，且让这神圣的胜负暂且搁置。待我重回幽夜的王座，再邀你于忘忧之御膳园中一决高下。"
        },
        {
          "role": "莫娜",
          "text": "可以是可以，反正再来几次结果都是一样的…但那到底是个什么地方啊？"
        }
