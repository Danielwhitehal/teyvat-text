{
  "quest_id": 22027,
  "chapter_num": null,
  "chapter_title": "神明啊，回应我吧！",
  "type": "iq",
  "route": "O Archon, Hear Me!",
  "stories": [
    {
      "story_id": 22027,
      "title": "神明啊，回应我吧！",
      "description": "名为翔太的孩子，似乎正为某些事情感到苦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与翔太对话"
        },
        {
          "role": "翔太",
          "text": "漆器…到底是怎么做的呢…"
        },
        {
          "role": "旅行者",
          "text": "你做漆器干什么？"
        },
        {
          "role": "翔太",
          "text": "是你啊…大哥哥，是这样的，你听说过神龛显灵的事吗？"
        },
        {
          "role": "翔太",
          "text": "我听人家说，如果向神龛献上珍贵的供品，也许就能实现自己的愿望。"
        },
        {
          "role": "翔太",
          "text": "我想，漂亮的漆器特别值钱，用漆器来供奉神龛的话，肯定能得到回应吧！"
        },
        {
          "role": "翔太",
          "text": "我没钱买漆器，所以就想要自己做一个。"
        },
        {
          "role": "翔太",
          "text": "我听说，「弥生漆器」的七月姐姐很擅长做漆器…"
        },
        {
          "role": "翔太",
          "text": "大哥哥，你能陪我去找七月姐姐问一下漆器的事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题，我们走吧。",
              "dialogues": [
                {
                  "role": "翔太",
                  "text": "谢谢大哥哥！"
                }
              ]
            },
            {
              "text": "你怎么不自己去？",
              "dialogues": [
                {
                  "role": "翔太",
                  "text": "七月姐姐她平时…很严肃的，我不太敢去向她请教…"
                },
                {
                  "role": "翔太",
                  "text": "有大哥哥在旁边的话，应该会好一些吧…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与弥生七月对话"
        },
        {
          "role": "弥生七月",
          "text": "你们好，找我有什么事吗？"
        },
        {
          "role": "翔太",
          "text": "那、那个…"
        },
        {
          "role": "旅行者",
          "text": "关于漆器的事…"
        },
        {
          "role": "弥生七月",
          "text": "…想要向神龛供奉漆器，所以想要自己来做一个？"
        },
        {
          "role": "翔太",
          "text": "拜托了，七月姐姐，我有很想实现的愿望！而且我…我一定不会把你的秘方告诉别人的！"
        },
        {
          "role": "弥生七月",
          "text": "这不是涂料配方的问题。要制作出精美的漆器，除了涂料之外，还需要长年累月的练习。"
        },
        {
          "role": "弥生七月",
          "text": "这不仅是时间问题，更是…财力问题。我家的漆器手艺传到我这里，已经是第四代了。"
        },
        {
          "role": "弥生七月",
          "text": "为了研究漆器，我甚至还去须弥游学过。所以，你想要一下子学会制作漆器…实在是不太可能。"
        },
        {
          "role": "翔太",
          "text": "是…是这样吗？可是，我也想不到去给神龛供奉什么好东西了…"
        },
        {
          "role": "弥生七月",
          "text": "我觉得，向神龛供奉物品这种事，最重要的并不是物品的价值，而是这个物品所代表的「心意」才对。"
        },
        {
          "role": "弥生七月",
          "text": "只要诚心诚意，供奉你最喜欢的东西，应该就能得到神明的回应了。"
        },
        {
          "role": "翔太",
          "text": "诚心诚意…我最喜欢的东西…"
        },
        {
          "role": "翔太",
          "text": "唔，好像明白了…又好像不明白，但还是谢谢你了，七月姐姐。"
        },
        {
          "role": "翔太",
          "text": "大哥哥，我们先回神龛去吧，我还想请你帮我参考一下，应该供奉什么。"
        },
        {
          "type": "subtitle",
          "text": "帮助翔太供奉神龛"
        },
        {
          "role": "翔太",
          "text": "唉，虽然七月姐姐那么说了，但我到底该供奉什么呢…"
        },
        {
          "role": "翔太",
          "text": "说到我喜欢的东西，那肯定就是「三彩团子」了，我可喜欢吃了…"
        },
        {
          "role": "翔太",
          "text": "但是用「三彩团子」来供奉，是不是太不严肃了呢？而且我之前用金平糖供奉，神明大人也没有回复…"
        },
        {
          "role": "翔太",
          "text": "我还听说，有些人会把新鲜的花瓣做成香包，用这种香包来供奉的。这好像比团子严肃一点…"
        },
        {
          "role": "翔太",
          "text": "怎么办？大哥哥，你觉得我应该供奉哪种东西呢？"
        },
        {
          "role": "旅行者",
          "text": "还是供奉「三彩团子」吧。"
        },
        {
          "role": "翔太",
          "text": "这样吗…好！我刚好带着一个「三彩团子」，这是妈妈做给我的，我还没舍得吃呢…"
        },
        {
          "role": "翔太",
          "text": "就…就供奉给神明大人吧！"
        },
        {
          "role": "翔太",
          "text": "希望神明能保佑我，帮我实现愿望…"
        },
        {
          "role": "翔太",
          "text": "谢谢你陪我到现在，大哥哥，这些东西给你，就当做是谢礼啦。"
        },
        {
          "role": "翔太",
          "text": "明天我会再来这里看看的，希望…神明大人会有些回复…"
        },
        {
          "type": "subtitle",
          "text": "帮助翔太供奉神龛"
        },
        {
          "role": "旅行者",
          "text": "还是供奉香包吧。"
        },
        {
          "role": "翔太",
          "text": "好，我听你的。"
        },
        {
          "role": "翔太",
          "text": "希望神明能保佑我，帮我实现愿望…"
        },
        {
          "role": "翔太",
          "text": "谢谢你陪我到现在，大哥哥，这些东西给你，就当做是谢礼啦。"
        },
        {
          "role": "翔太",
          "text": "明天我会再来这里看看的，希望…神明大人会有些回复…"
        }
      ]
    }
  ]
}