{
  "quest_id": 20004,
  "chapter_num": null,
  "chapter_title": "应付尽付",
  "type": "iq",
  "route": "Owe Mora, Pay Mora",
  "stories": [
    {
      "story_id": 20004,
      "title": "应付尽付",
      "description": "歌德先生似乎正在为某事发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与歌德对话"
        },
        {
          "role": "歌德",
          "text": "唉，看来我还是得自己跑一趟…"
        },
        {
          "role": "歌德",
          "text": "我这把老骨头，非得散架不可…"
        },
        {
          "role": "旅行者",
          "text": "有什么急事吗？"
        },
        {
          "role": "歌德",
          "text": "旅行者？唉…也不能算是急事，但我是真的操办不过来了…"
        },
        {
          "role": "歌德",
          "text": "你也知道，那群愚人众把我的酒店给包下来了吧。"
        },
        {
          "role": "歌德",
          "text": "他们包下了酒店之后，我作为「歌德大酒店」的老板，自然也得在旁边照应着。"
        },
        {
          "role": "歌德",
          "text": "帮着联系食材供应商，物件坏了及时叫人去修，还有一些杂七杂八的事。"
        },
        {
          "role": "歌德",
          "text": "最近酒店里有几间屋子的桌椅坏了，我得赶紧去联系人，把合适的木材送去给木匠。"
        },
        {
          "role": "歌德",
          "text": "还有城里几间屋子的租金没收…玛文那小子又成天不见影子。"
        },
        {
          "role": "歌德",
          "text": "唉，也不知道我这把老骨头能折腾几年，玛文到底什么时候才能懂事点呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来帮您。",
              "dialogues": []
            },
            {
              "text": "你先在这歇一会吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "歌德",
          "text": "你，你愿意帮我吗？唉，真的太麻烦你了，玛文那小子要是有你一半懂事，我也不会累成这样…"
        },
        {
          "role": "歌德",
          "text": "那就麻烦你，先帮我去拿一份杉木和一份桦木回来吧，我要赶紧把这些木材交给木匠了。"
        },
        {
          "type": "subtitle",
          "text": "将木材带给歌德"
        },
        {
          "role": "歌德",
          "text": "你拿到木材了吗？只要一份杉木和一份桦木就好了。"
        },
        {
          "type": "subtitle",
          "text": "与歌德对话"
        },
        {
          "role": "歌德",
          "text": "谢谢你，这些木材就够了，我这就拿去给木匠…对了，还得去收房租才行…"
        },
        {
          "role": "歌德",
          "text": "唉，也不知道那个…阿斯…阿斯…什么莫娜…这次在不在家…"
        },
        {
          "role": "旅行者",
          "text": "是阿斯托洛吉斯·莫娜·梅姬斯图斯。"
        },
        {
          "role": "歌德",
          "text": "对！就是这个名字，哎哟…我是真的记不住。"
        },
        {
          "role": "派蒙",
          "text": "咦？莫娜还没交房租吗？"
        },
        {
          "role": "歌德",
          "text": "可不是嘛，其他的租客都把房租交了，就剩她了。"
        },
        {
          "role": "歌德",
          "text": "我跑了好几趟了，但她一直都不在家。"
        },
        {
          "role": "歌德",
          "text": "旅行者，请你帮我跑一趟，去催催她交房租吧。"
        },
        {
          "type": "subtitle",
          "text": "拜访莫娜"
        },
        {
          "type": "subtitle",
          "text": "与莫娜对话"
        },
        {
          "role": "莫娜",
          "text": "是你啊，好久不见。"
        },
        {
          "role": "莫娜",
          "text": "怎么一副急匆匆的样子，你找我有什么事吗？"
        },
        {
          "role": "派蒙",
          "text": "莫娜，你这几天去哪里了呀？"
        },
        {
          "role": "旅行者",
          "text": "找你好几天了。"
        },
        {
          "role": "莫娜",
          "text": "那可真不巧…前几天《蒸汽鸟报》刚向我约了一份新稿件。"
        },
        {
          "role": "莫娜",
          "text": "主题是「星相的运转变化和个人命运变迁的关系」。"
        },
        {
          "role": "莫娜",
          "text": "为了写这篇稿件，我这几天基本上都在野外观测星象，很晚才回家。"
        },
        {
          "role": "派蒙",
          "text": "为了赚钱，莫娜也真是努力呢…"
        },
        {
          "role": "莫娜",
          "text": "毕竟枫丹廷那边的星象仪又推出了新版嘛，我都已经付了订货押金了。"
        },
        {
          "role": "莫娜",
          "text": "等这篇稿件的稿酬到了，我就能结清尾款，正式拿到那台星象仪了。"
        },
        {
          "role": "旅行者",
          "text": "你还有钱付歌德先生的房租吗…"
        },
        {
          "role": "莫娜",
          "text": "房租？"
        },
        {
          "role": "莫娜",
          "text": "喔…！我、我应该留了钱的…"
        },
        {
          "role": "莫娜",
          "text": "你们等一会，我找找…"
        },
        {
          "role": "？？？",
          "text": "（莫娜开始翻起了自己的钱包…）"
        },
        {
          "role": "莫娜",
          "text": "这些…加上这些！应该够付房租了…"
        },
        {
          "role": "旅行者",
          "text": "（莫娜是把身上的钱都掏光了吗…）"
        },
        {
          "role": "莫娜",
          "text": "你们帮我把这些钱带给歌德先生吧。"
        },
        {
          "type": "subtitle",
          "text": "将租金交给歌德"
        },
        {
          "role": "歌德",
          "text": "怎么样，你们找到那位…呃…你们的那位朋友了吗？"
        },
        {
          "role": "旅行者",
          "text": "这是租金。"
        },
        {
          "role": "歌德",
          "text": "好，好，这些钱够了，谢谢你们啊。"
        },
        {
          "role": "歌德",
          "text": "不过，你们的那位朋友究竟是做什么的？"
        },
        {
          "role": "歌德",
          "text": "明明看着那么有本事，却总是这么穷…"
        },
        {
          "type": "subtitle",
          "text": "回复莫娜"
        },
        {
          "role": "莫娜",
          "text": "你们回来了，租金交给歌德了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经都交给他了。"
        },
        {
          "role": "莫娜",
          "text": "那就好。幸好这间屋子的租金也不算太贵…勉强能把钱凑齐了。"
        },
        {
          "role": "莫娜",
          "text": "不过，看来我又得多吃几天沙拉了…"
        }
      ]
    }
  ]
}