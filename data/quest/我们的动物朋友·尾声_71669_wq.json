  "chapter_title": "我们的动物朋友·尾声",
  "type": "wq",
  "route": "Our Animal Friends: Epilogue",
  "stories": [
    {
      "story_id": 71669,
      "title": "我们的动物朋友·尾声",
      "description": "「伴爪同行」动物救助会的礼物交换活动已经结束了，振尘正在整理救助会收到的礼物…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "额外对话（拉米雅）"
        },
        {
          "role": "拉米雅",
          "text": "「铭随流镜」还有可以改进的地方…下次加点功能试试看。"
        },
        {
          "role": "振尘",
          "text": "旅行者，听工作人员们说，所有安装了发讯装置的小动物都被你找到了。"
        },
        {
          "role": "振尘",
          "text": "有点意外啊，有些动物天性敏感，在陌生生物靠近时会立刻逃走。"
        },
        {
          "role": "振尘",
          "text": "但它们并不排斥你的接近，真是奇事。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "因为我是动物之友。",
              "dialogues": []
            },
            {
              "text": "这是冒险家的天赋。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "振尘",
          "text": "哈哈，你这能力很让人嫉妒啊。"
        },
        {
          "role": "振尘",
          "text": "之前好几次，工作人员陪着我一起去给动物喂食的时候，我不是被吼就是挨咬。"
        },
        {
          "role": "振尘",
          "text": "胳膊上留了好几道疤，还挺疼的。"
        },
        {
          "role": "振尘",
          "text": "不过呢，虽然它们对我一点都不亲近，但能看到这些可爱的生灵好好地活着，我就觉得很满足了。"
        },
        {
          "role": "振尘",
          "text": "对所有认养人来说也是这样，大家都希望在不惊扰到动物们的前提下，保护好它们的生存环境。"
        },
        {
          "role": "振尘",
          "text": "我知道对许多冒险家来说，野生动物是重要的食物来源，我们也并不会要求「伴爪同行」的成员完全不杀生。"
        },
        {
          "role": "振尘",
          "text": "我们提倡的原则是不滥杀滥捕，如果每个人都能做到这一点，我们身边的环境一定会变得更丰富更美好。"
        },
        {
          "role": "振尘",
          "text": "作为我们的成员，如果旅行者你也能认同并接受这个原则就太好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我认同。",
              "dialogues": [
                {
                  "role": "振尘",
                  "text": "我就知道，像你这样通情达理的人一定会认同我们的。"
                }
              ]
            },
            {
              "text": "我保留意见。",
              "dialogues": [
                {
                  "role": "振尘",
                  "text": "没关系，我们并不强求所有人都接受，但我个人希望所有人在杀生前想一想这件事。"
                }
              ]
            }
          ]
        },
        {
          "role": "振尘",
          "text": "能带给别人思考，就已经是成功。"
        },
        {
          "role": "振尘",
          "text": "有机会的话，希望能在下一次「伴爪同行」的活动里见到你。"
        },
        {
          "role": "振尘",
          "text": "希望到那个时候，我胳膊上不会增加新伤疤哈哈。"
        }
      ],
      "collapse_ranges": [
        [
          0,
          1
        ]
      ]
    }
  ]
}