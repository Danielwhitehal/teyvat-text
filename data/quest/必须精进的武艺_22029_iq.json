{
  "quest_id": 22029,
  "chapter_num": null,
  "chapter_title": "必须精进的武艺",
  "type": "iq",
  "route": "An Art to Be Honed",
  "stories": [
    {
      "story_id": 22029,
      "title": "必须精进的武艺",
      "description": "一名叫做朝仓的家伙，似乎正在找人帮他锻炼武艺…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "找到发布委托的朝仓"
        },
        {
          "role": "朝仓",
          "text": "我一定！我一定要…"
        },
        {
          "role": "朝仓",
          "text": "嗯？你是？"
        },
        {
          "role": "旅行者",
          "text": "我接到了你的委托。"
        },
        {
          "role": "朝仓",
          "text": "噢，你说那个陪练委托啊，没错，是我发布的，我想找个人来和我对练武艺。"
        },
        {
          "role": "朝仓",
          "text": "你把我的委托给接下了吗？但我之前好像没有在城里见过你。"
        },
        {
          "role": "朝仓",
          "text": "抱歉，我不是质疑你的实力。但我确实不知道你的武艺如何…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我击倒过巨龙。",
              "dialogues": [
                {
                  "role": "朝仓",
                  "text": "哈哈哈…真的吗？其实我更好奇你是在哪里找到巨龙的，我也只是听说过而已…"
                }
              ]
            },
            {
              "text": "我见证过神陨。",
              "dialogues": [
                {
                  "role": "朝仓",
                  "text": "欸，你看你说的，你肯定是在璃月那边参与过「请仙典仪」吧？"
                },
                {
                  "role": "朝仓",
                  "text": "哈哈哈，照你这么说，璃月那边有很多人都「见证过神陨」了。"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "我还是很能打的。"
        },
        {
          "role": "朝仓",
          "text": "哈哈，无论如何，武艺这种事情都是口说无凭，我们还是手上见真章吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "正有此意。",
              "dialogues": []
            },
            {
              "text": "等下，为什么要匿名发布委托？",
              "dialogues": [
                {
                  "role": "朝仓",
                  "text": "这、这其实是因为一个不那么…不那么光彩的原因…"
                },
                {
                  "role": "朝仓",
                  "text": "咳，不过既然你接下了委托，我就直说了。"
                },
                {
                  "role": "朝仓",
                  "text": "就在前段时间，我和几位同心外出执行任务，回程的时候，突然发现了一队准备袭掠商队的海乱鬼。"
                },
                {
                  "role": "朝仓",
                  "text": "我和其余几位同心马上赶过去救援那支商队、最开始，我们略占上风，他们也很快退去了。"
                },
                {
                  "role": "朝仓",
                  "text": "但是，就在我们刚准备喘口气的时候，从旁边突然又出现了一支海乱鬼，还有一个头领模样的人在率领着他们。"
                },
                {
                  "role": "朝仓",
                  "text": "我和其余同僚还没反应过来，就被他们打了个措手不及…"
                },
                {
                  "role": "朝仓",
                  "text": "失去了胜机，我们只能一边抵挡着海乱鬼的攻势，一边护着商人往城里撤退。"
                },
                {
                  "role": "朝仓",
                  "text": "而我在和那个海乱鬼头领交手的时候…居然被他夺走了武器。"
                },
                {
                  "role": "朝仓",
                  "text": "而且那家伙在夺走我武器之后，还举着我的武器，朝我哈哈大笑，真是奇耻大辱…"
                },
                {
                  "role": "旅行者",
                  "text": "那队商人怎么样了？"
                },
                {
                  "role": "朝仓",
                  "text": "在我们往后撤退的时候，又遇见了出门巡逻的其他同心，那些海乱鬼看见了之后，也全都撤退了。"
                },
                {
                  "role": "朝仓",
                  "text": "那些商人也被我们护送进了城，但他们的货物都…唉，都怪我武艺不精…"
                },
                {
                  "role": "朝仓",
                  "text": "回去之后，我也再次被配发了武器。但我还是没法对这件事释怀…"
                },
                {
                  "role": "朝仓",
                  "text": "所以，我才发布了那道委托。想要以此来磨砺武艺。"
                },
                {
                  "role": "朝仓",
                  "text": "直到我足够强大，再去亲手打倒那个海乱鬼，拿回我的武器，彻底洗刷这道耻辱！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与朝仓对话"
        },
        {
          "role": "旅行者",
          "text": "放马过来吧！"
        },
        {
          "role": "朝仓",
          "text": "刀枪无眼，请小心了。"
        },
        {
          "type": "subtitle",
          "text": "完成与朝仓的对练"
        },
        {
          "role": "朝仓",
          "text": "您刚才是留手了吗？"
        },
        {
          "role": "朝仓",
          "text": "不用顾忌我的面子，阁下，请使出全力吧，我…必须要变强才行！"
        },
        {
          "type": "subtitle",
          "text": "与朝仓对话"
        },
        {
          "role": "朝仓",
          "text": "呼…呼…阁下的武艺，果然高强…"
        },
        {
          "role": "朝仓",
          "text": "在下…在下领教了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你、你没事吧？",
              "dialogues": []
            },
            {
              "text": "抱歉、刚才没收住手…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "朝仓",
          "text": "没…没事，只是需要调整一下气息…"
        },
        {
          "role": "朝仓",
          "text": "但您强大到这种程度，就算是您说您打倒过巨龙我也信…"
        },
        {
          "role": "旅行者",
          "text": "其实我真的打倒过巨龙…"
        },
        {
          "role": "朝仓",
          "text": "哈哈哈…在下当然是相信的。谢谢您和我对练，这场比试，在下铭记在心。"
        },
        {
          "role": "朝仓",
          "text": "如果阁下愿意的话，请以后常来和我对练，有您这样的强者磨砺…我一定能完成那件事。"
        },
        {
          "role": "旅行者",
          "text": "那件事？"
        },
        {
          "role": "朝仓",
          "text": "咳…只是我的一点小心愿而已，这次谢谢您了，这些报酬请收下吧。"
        },
        {
          "role": "朝仓",
          "text": "我还要回去休息一下，您…您的那些招数，力道可真是太足了…"
        }
      ]
    }
  ]
}