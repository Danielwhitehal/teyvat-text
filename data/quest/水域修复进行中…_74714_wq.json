{
  "quest_id": 74714,
  "chapter_num": null,
  "chapter_title": "水域修复进行中…",
  "type": "wq",
  "route": "Underwater Restoration in Progress...",
  "stories": [
    {
      "story_id": 74714,
      "title": "水域修复进行中…",
      "description": "菲米尼似乎有事找我们…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与菲米尼对话"
        },
        {
          "role": "菲米尼",
          "text": "旅行者和派蒙，我知道了。"
        },
        {
          "role": "菲米尼",
          "text": "最近潜水员变多的原因，是要好好处理水下废弃品，加快修复环境…"
        },
        {
          "role": "菲米尼",
          "text": "如果是这样，我应该尽全力帮忙。"
        },
        {
          "role": "菲米尼",
          "text": "要是水下污染变得严重，海露花的色彩都会黯淡下去，还有许多我不敢想的可怕后果…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们也来出力。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好哦！一起加油吧！"
        },
        {
          "role": "派蒙",
          "text": "对了，菲米尼，之前我们在水下找到了一个看起来挺厉害的…结构？似乎是某种乐器的部件？你也看看呢？"
        },
        {
          "role": "菲米尼",
          "text": "好的…啊，非常精密的构造。我研究过一些机关，但在市面上，我还从没见过那么细致又独特的作品。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉摆在这里还不错。",
              "dialogues": []
            },
            {
              "text": "和这里的环境很搭。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲米尼",
          "text": "嗯，不过它还差一些部件才能复原的样子。"
        },
        {
          "role": "派蒙",
          "text": "嗯！慢慢来吧。我也很好奇它修好后是什么样子。"
        },
        {
          "role": "菲米尼",
          "text": "那我继续去水里帮忙了。二位可以再多休息一下。"
        },
        {
          "role": "派蒙",
          "text": "好，你也注意休息。"
        },
        {
          "role": "「木偶」",
          "text": "咦？这东西…是你们捞上来的？"
        },
        {
          "role": "派蒙",
          "text": "嗯，桑多涅你知道这是什么吗？"
        },
        {
          "role": "「木偶」",
          "text": "哈，何止是知道？我以前每天都坐在花园里弹它呢。"
        },
        {
          "role": "派蒙",
          "text": "欸？！这是…你的东西？"
        },
        {
          "role": "「木偶」",
          "text": "曾经是。这是阿兰发明的机械钢琴，既可以由人来弹奏，也可以自动演奏。"
        },
        {
          "role": "派蒙",
          "text": "这么厉害…那它怎么会…"
        },
        {
          "role": "「木偶」",
          "text": "阿兰病重后听不得琴声，我就拿去处理了。但没想到还能再次见到它…"
        },
        {
          "role": "「木偶」",
          "text": "我猜是拿到这架钢琴的人用坏了也不会修，最终就变成这样了吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你能修好它吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「木偶」",
          "text": "当然可以。这能难倒我？"
        },
        {
          "role": "「木偶」",
          "text": "呃，不过这看起来散得也太彻底了…如果你们能找到钢琴的其他部分，我很快就能动手修好。"
        },
        {
          "role": "派蒙",
          "text": "好！那我们平时下水的时候就多留意一下吧！"
        }
      ]
    }
  ]
}