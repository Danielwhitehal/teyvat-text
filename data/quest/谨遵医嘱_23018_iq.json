{
  "quest_id": 23018,
  "chapter_num": null,
  "chapter_title": "谨遵医嘱",
  "type": "iq",
  "route": "Doctor's Orders",
  "stories": [
    {
      "story_id": 23018,
      "title": "谨遵医嘱",
      "description": "「健康之家」的扎卡里亚正在为他的病人们煞费苦心…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与扎卡里亚对话"
        },
        {
          "role": "扎卡里亚",
          "text": "唉，真不让人省心…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么要帮忙的吗？",
              "dialogues": []
            },
            {
              "text": "这里发生什么事了？",
              "dialogues": [
                {
                  "role": "扎卡里亚",
                  "text": "你是旅行者吧，这里是「健康之家」，是一家为普罗大众…嗯…广布草神恩泽的医院。"
                },
                {
                  "role": "扎卡里亚",
                  "text": "无论贫富，我们都会为需要的人提供医疗帮助。"
                },
                {
                  "role": "扎卡里亚",
                  "text": "不过也拜此所赐…最近来就诊的病人太多，实在有些忙不过来了。"
                },
                {
                  "role": "扎卡里亚",
                  "text": "唉，就算草神对我们的仁慈是无限的…但医院的预算和人力却是有限的啊。"
                },
                {
                  "role": "扎卡里亚",
                  "text": "有一些病人压根不听医嘱，只是一个劲地问我，他该怎么样才能更好地承接草神恩泽。"
                },
                {
                  "role": "扎卡里亚",
                  "text": "哈哈，草神恩泽…看在老天的份上！"
                },
                {
                  "role": "扎卡里亚",
                  "text": "要是草神真的能直接降下恩泽，他们压根就不会得病了！"
                },
                {
                  "role": "扎卡里亚",
                  "text": "…呼，抱歉，我不该说这样的话，你可别告诉戈尔珊，不然她又要开始唠叨了。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你不是一个虔诚的草神信徒吗？",
                      "dialogues": [
                        {
                          "role": "扎卡里亚",
                          "text": "我确实是，这须弥城里还有谁不是吗？"
                        },
                        {
                          "role": "扎卡里亚",
                          "text": "但你可以把虔诚这两个字换掉，我是一个…相对理性的草神信徒，哈哈。"
                        }
                      ]
                    },
                    {
                      "text": "有人说治疗本身就是草神恩泽…",
                      "dialogues": [
                        {
                          "role": "扎卡里亚",
                          "text": "唉，这些话你听听就行了，别和那些病人一样把这件事当真。"
                        },
                        {
                          "role": "扎卡里亚",
                          "text": "如果草神真有这么全能，那我就直接给病人吃点蘑菇，他们就能痊愈了。"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "扎卡里亚",
                  "text": "呃…抱歉，我一定是太累了，这是我个人的一点情绪，你别当真。"
                }
              ]
            }
          ]
        },
        {
          "role": "扎卡里亚",
          "text": "最近我们的人手实在是不够，我已经连续几天没休息了。"
        },
        {
          "role": "扎卡里亚",
          "text": "旅行者，你如果有空的话，可以帮我送药给附近的病人吗？也请一并看看他们的状况。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "扎卡里亚",
                  "text": "那就拜托你了，看在草神的份上，我真的很需要一个不会整天念叨草神保佑的人给我帮忙。"
                },
                {
                  "role": "扎卡里亚",
                  "text": "哈，看在草神的份上…我念得真熟练。"
                }
              ]
            },
            {
              "text": "你还是休息一下吧。",
              "dialogues": [
                {
                  "role": "扎卡里亚",
                  "text": "我可休息不得，还有一些更重的病人被我安置在别处了，我还得为他们配药。"
                },
                {
                  "role": "扎卡里亚",
                  "text": "唉，那些病人肯定又要问我，他们该用什么方法承接草神的恩泽了。"
                },
                {
                  "role": "扎卡里亚",
                  "text": "拜托你了，旅行者，我真的很需要一个不会整天念叨草神保佑的人给我帮忙。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与扎卡里亚对话"
        },
        {
          "role": "扎卡里亚",
          "text": "这次的药是要送给药田的古尔根。"
        },
        {
          "role": "扎卡里亚",
          "text": "这位老兄前几天工作得太用力，把自己的胳膊给拉伤了。"
        },
        {
          "role": "扎卡里亚",
          "text": "你就把这副药送给他，顺便告诉他，今天在家里向草神大人默祷吧，不要下地干活了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好的。",
              "dialogues": []
            },
            {
              "text": "向草神大人默祷？",
              "dialogues": [
                {
                  "role": "扎卡里亚",
                  "text": "我不这么说，他怎么可能会听？好了，你就按我说的来做吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "扎卡里亚",
          "text": "送完药就回来找我吧，我会准备好报酬的。"
        },
        {
          "type": "subtitle",
          "text": "将药带给古尔根"
        },
        {
          "role": "扎卡里亚",
          "text": "送药的事情就拜托了，切记药和医嘱都要送到。"
        },
        {
          "type": "subtitle",
          "text": "与古尔根对话"
        },
        {
          "role": "古尔根",
          "text": "咦？这个是…"
        },
        {
          "role": "旅行者",
          "text": "这是你的药，记得在家里向草神大人默祷。"
        },
        {
          "role": "古尔根",
          "text": "欸，多谢你了。向草神大人默祷啊…这确实必须要做…"
        },
        {
          "role": "古尔根",
          "text": "但<color=#00E1FFFF>田里的杂草</color>这么多，再不收拾一下，就要影响收成了。"
        },
        {
          "role": "古尔根",
          "text": "唔…我就先去<color=#00E1FFFF>把杂草处理</color>了，再回去向草神大人默祷吧。"
        },
        {
          "type": "subtitle",
          "text": "与扎卡里亚对话"
        },
        {
          "role": "扎卡里亚",
          "text": "你回来了，一切顺利么？"
        },
        {
          "role": "旅行者",
          "text": "他要先去处理杂草…"
        },
        {
          "role": "扎卡里亚",
          "text": "唉，这种说法也不行吗…下次还得换个说法…"
        },
        {
          "role": "扎卡里亚",
          "text": "你也辛苦了，这些报酬就请收下吧。"
        },
        {
          "type": "subtitle",
          "text": "与古尔根对话"
        },
        {
          "role": "古尔根",
          "text": "杂草…全都被你清理了？这，这怎么好意思？"
        },
        {
          "role": "旅行者",
          "text": "你回去好好休息就行。"
        },
        {
          "role": "古尔根",
          "text": "我会的，谢谢，愿草神大人护佑你！"
        },
        {
          "role": "古尔根",
          "text": "我也得快点回去向草神大人默祷了…"
        },
        {
          "type": "subtitle",
          "text": "与扎卡里亚对话"
        },
        {
          "role": "扎卡里亚",
          "text": "你回来了，一切顺利么？"
        },
        {
          "role": "旅行者",
          "text": "关于清理杂草…"
        },
        {
          "role": "扎卡里亚",
          "text": "啊，那可真不错。这下古尔根他总能好好休息一下了，病情恢复得也会更快一点吧。"
        },
        {
          "role": "扎卡里亚",
          "text": "真是太感谢你了，这些报酬还请务必收下。"
        },
        {
          "type": "subtitle",
          "text": "与扎卡里亚对话"
        },
        {
          "role": "扎卡里亚",
          "text": "这次的药是要送给剧场门口的阿兹拉。"
        },
        {
          "role": "扎卡里亚",
          "text": "她最近一直在咳嗽，我给她开了药，但她总说太苦不愿意吃。"
        },
        {
          "role": "扎卡里亚",
          "text": "你帮我把这副药送给她吧，顺便告诉她…呃…"
        },
        {
          "role": "扎卡里亚",
          "text": "这个…苦涩的药物，是草神对她的…那个…考验，对，考验。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好的。",
              "dialogues": []
            },
            {
              "text": "你这话术是向谁学的？",
              "dialogues": [
                {
                  "role": "扎卡里亚",
                  "text": "谈不上学，只能说是耳濡目染吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "扎卡里亚",
          "text": "送完药就回来找我吧，我会准备好报酬的。"
        },
        {
          "type": "subtitle",
          "text": "将药带给阿兹拉"
        },
        {
          "role": "古尔根",
          "text": "唉，身体果然没以前好使唤了…不行，得再坚持一会儿。"
        },
        {
          "type": "subtitle",
          "text": "与阿兹拉对话"
        },
        {
          "role": "阿兹拉",
          "text": "呃…好熟悉的气味…"
        },
        {
          "role": "旅行者",
          "text": "这是你的药，记得要全部吃完…"
        },
        {
          "role": "阿兹拉",
          "text": "唔，又是这种<color=#00E1FFFF>超苦的药</color>，我不想吃…"
        },
        {
          "role": "旅行者",
          "text": "药的苦涩是草神对你的考验喔。"
        },
        {
          "role": "阿兹拉",
          "text": "欸？是这样吗？但<color=#00E1FFFF>这药也太苦了</color>，草神大人就不能温柔一些吗…"
        },
        {
          "role": "阿兹拉",
          "text": "先把药给我吧，我，我等一会再吃…"
        },
        {
          "type": "subtitle",
          "text": "与扎卡里亚对话"
        },
        {
          "role": "扎卡里亚",
          "text": "你回来了，一切顺利么？"
        },
        {
          "role": "旅行者",
          "text": "病人说药的味道太苦了…"
        },
        {
          "role": "扎卡里亚",
          "text": "这也没什么办法，毕竟草药的成分和性质…咳，有些恩惠就是要吃点苦才能受用的。"
        },
        {
          "role": "扎卡里亚",
          "text": "希望她真的能把药给全吃掉，上次我就发现她只吃了一点…"
        },
        {
          "role": "扎卡里亚",
          "text": "你也辛苦了，这些报酬就请收下吧。"
        },
        {
          "type": "subtitle",
          "text": "与阿兹拉对话"
        },
        {
          "role": "阿兹拉",
          "text": "咦？这是给我的吗？谢谢你…"
        },
        {
          "role": "阿兹拉",
          "text": "好！我要再试一次…这一次要一口气把药吃掉！"
        },
        {
          "type": "subtitle",
          "text": "与扎卡里亚对话"
        },
        {
          "role": "扎卡里亚",
          "text": "你回来了，一切顺利么？"
        },
        {
          "role": "旅行者",
          "text": "我给她送了点糖。"
        },
        {
          "role": "扎卡里亚",
          "text": "糖？但是那副药和糖一起吃会降低药效啊。"
        },
        {
          "role": "扎卡里亚",
          "text": "算了，药效低一点就低一点吧，至少她能把药吃完了。"
        },
        {
          "role": "扎卡里亚",
          "text": "真是太感谢你了，这些报酬还请务必收下。"
        },
        {
          "type": "subtitle",
          "text": "与扎卡里亚对话"
        },
        {
          "role": "扎卡里亚",
          "text": "这次的药是要送给农舍的阿夫塔。"
        },
        {
          "role": "扎卡里亚",
          "text": "这家伙平时吃东西总是大鱼大肉，弄的肠胃很不好。"
        },
        {
          "role": "扎卡里亚",
          "text": "你就把这副药带给他吧，顺便告诉他…呃…"
        },
        {
          "role": "扎卡里亚",
          "text": "饮食清淡，少食酒肉，才能更好地承接草神大人的恩泽。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好的。",
              "dialogues": []
            },
            {
              "text": "你都是从哪听到的这些…",
              "dialogues": [
                {
                  "role": "扎卡里亚",
                  "text": "我听说教令院里确实有学者这么做，我也不知道为什么…"
                }
              ]
            }
          ]
        },
        {
          "role": "扎卡里亚",
          "text": "送完药就回来找我吧，我会准备好报酬的。"
        },
        {
          "type": "subtitle",
          "text": "将药带给阿夫塔"
        },
        {
          "role": "阿夫塔",
          "text": "再坚持几天就好…"
        },
        {
          "type": "subtitle",
          "text": "与阿夫塔对话"
        },
        {
          "role": "阿夫塔",
          "text": "嗯？这个药是？"
        },
        {
          "role": "旅行者",
          "text": "这是你的药。注意保持饮食清淡。"
        },
        {
          "role": "阿夫塔",
          "text": "唉，好，放心吧。我已经好些天<color=#00E1FFFF>没碰过肉</color>了，这样一定能更好地承接草神大人的恩惠…"
        },
        {
          "role": "阿夫塔",
          "text": "不过怎么感觉身体还不如以前了呢？唉，一定是时间还不够久…"
        },
        {
          "type": "subtitle",
          "text": "与扎卡里亚对话"
        },
        {
          "role": "扎卡里亚",
          "text": "你回来了，一切顺利么？"
        },
        {
          "role": "旅行者",
          "text": "他已经有好几天没吃肉了…"
        },
        {
          "role": "扎卡里亚",
          "text": "什么？我就是叮嘱他吃得相对清淡一点，也没让他完全不吃肉啊！"
        },
        {
          "role": "扎卡里亚",
          "text": "为了更好地承接草神大人的恩惠？"
        },
        {
          "role": "扎卡里亚",
          "text": "好吧…我回头得把说法再变一变…"
        },
        {
          "role": "扎卡里亚",
          "text": "你也辛苦了，这些报酬就请收下吧。"
        },
        {
          "type": "subtitle",
          "text": "与阿夫塔对话"
        },
        {
          "role": "阿夫塔",
          "text": "这是？不行…但这气味实在是…"
        },
        {
          "role": "旅行者",
          "text": "其实是这样的…"
        },
        {
          "role": "阿夫塔",
          "text": "什么？清淡饮食也可以吃肉？教令院的学者也这么做？"
        },
        {
          "role": "阿夫塔",
          "text": "原，原来是这样！我还担心我吃肉会惹草神大人不高兴呢。"
        },
        {
          "role": "阿夫塔",
          "text": "既然学者大人们也这样做…那我就可以放心吃肉了，谢谢你！"
        },
        {
          "type": "subtitle",
          "text": "与扎卡里亚对话"
        },
        {
          "role": "扎卡里亚",
          "text": "你回来了，一切顺利么？"
        },
        {
          "role": "旅行者",
          "text": "关于肉排…"
        },
        {
          "role": "扎卡里亚",
          "text": "哦？原来还有这种话术，我还真没想到…"
        },
        {
          "role": "扎卡里亚",
          "text": "不过，只要阿夫塔能继续正常调理身体就行。"
        },
        {
          "role": "扎卡里亚",
          "text": "真是太感谢你了，这些报酬还请务必收下。"
        }
      ]
    }
  ]
}