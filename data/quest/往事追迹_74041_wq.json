{
  "quest_id": 74041,
  "chapter_num": null,
  "chapter_title": "往事追迹",
  "type": "wq",
  "route": "In Search of Lost Time",
  "stories": [
    {
      "story_id": 74041,
      "title": "往事追迹",
      "description": "研究员布罗意已经取回了中枢处理站的钥匙…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与布罗意对话"
        },
        {
          "role": "派蒙",
          "text": "布罗意，你说的那两座观测站的数据，我们已经拿到手啦！"
        },
        {
          "role": "布罗意",
          "text": "真的吗？！那可真是太好了！拜托了，快点让我看看——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "喏，给你。",
              "dialogues": []
            },
            {
              "text": "我们的报酬呢？",
              "dialogues": [
                {
                  "role": "布罗意",
                  "text": "这个…请您不必担心，只要主管能批准恢复原本的水文研究，报酬一定不会少了您的！"
                },
                {
                  "role": "派蒙",
                  "text": "嘿嘿，那就好！"
                }
              ]
            }
          ]
        },
        {
          "role": "？？？",
          "text": "将之前收集到的纸带交给了布罗意…"
        },
        {
          "role": "布罗意",
          "text": "啊啊啊，没错，就是这个，就是这个！两位简直就是上天派来救我脱离苦海，重新过上美好幸福清闲生活的天使——"
        },
        {
          "role": "派蒙",
          "text": "也不至于夸张到这个地步吧！"
        },
        {
          "role": "布罗意",
          "text": "总之，事不宜迟，好心的先生，我这就去找主管申请中枢处理站的钥匙，请您稍微等我一下！"
        },
        {
          "role": "派蒙",
          "text": "唉，真是的…记得快一点呀！"
        },
        {
          "role": "？？？",
          "text": "没过多久，布罗意兴奋地回来了…"
        },
        {
          "role": "布罗意",
          "text": "先生，我已经拿到钥匙了！接下来只要前往中枢处理站，完成对这些数据的整理，水文观测事业就可以顺利恢复了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哦…",
              "dialogues": []
            },
            {
              "text": "这种事情也需要我们跟着去吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布罗意",
          "text": "考虑到「果果软糖站」和「桔桔薄饼站」的情况，中枢处理站说不定也有那些来自至冬的先生们…"
        },
        {
          "role": "布罗意",
          "text": "所以…拜托了，请两位陪伴我一起去吧！"
        },
        {
          "role": "派蒙",
          "text": "唔，你可别忘了给我们报酬呀！"
        },
        {
          "role": "布罗意",
          "text": "先生，您终于来了！"
        },
        {
          "role": "布罗意",
          "text": "我已经拿到钥匙了！接下来只要前往中枢处理站，完成对这些数据的整理，水文观测事业就可以顺利恢复了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哦…",
              "dialogues": []
            },
            {
              "text": "这种事情也需要我们跟着去吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布罗意",
          "text": "考虑到「果果软糖站」和「桔桔薄饼站」的情况，中枢处理站说不定也有那些来自至冬的先生们…"
        },
        {
          "role": "布罗意",
          "text": "所以…拜托了，请两位陪伴我一起去吧！"
        },
        {
          "role": "派蒙",
          "text": "唔，你可别忘了给我们报酬呀！"
        },
        {
          "type": "subtitle",
          "text": "(跳过)等待到第二天"
        },
        {
          "type": "subtitle",
          "text": "前往中枢处理站"
        },
        {
          "type": "subtitle",
          "text": "与布罗意对话"
        },
        {
          "role": "布罗意",
          "text": "我们到了！请看，先生，这里就是中枢处理站，用来读取水文研究数据的地方！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像没什么人…",
              "dialogues": []
            },
            {
              "text": "我能回去了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是呀，既然没有愚人众，这里应该也就用不到我们了…"
        },
        {
          "role": "布罗意",
          "text": "这个…现在还不能肯定嘛，要是里面万一有那些至冬来的先生，我可能就再也见不到晶螺糕了…"
        },
        {
          "role": "布罗意",
          "text": "咳，我是说，再也没办法进行水文研究了！就拜托两位好心人，陪我一起进去看看吧！"
        },
        {
          "role": "派蒙",
          "text": "唉，没办法，你开门吧…"
        },
        {
          "type": "subtitle",
          "text": "进入中枢处理站"
        },
        {
          "role": "派蒙",
          "text": "旅行者，看到那家伙了！在那边，不要逃！"
        },
        {
          "type": "subtitle",
          "text": "调查中枢处理站"
        },
        {
          "type": "subtitle",
          "text": "(跳过)打开塔身封锁门"
        },
        {
          "type": "subtitle",
          "text": "(跳过)击败塔身内敌人"
        },
        {
          "type": "subtitle",
          "text": "调查中枢处理站"
        },
        {
          "role": "？？？",
          "text": "走投无路的愚人众指挥官，扑通一声跳进了水里，溅起的水花比骗骗花还要大…"
        },
        {
          "role": "布罗意",
          "text": "嗯，让我看看…"
        },
        {
          "role": "布罗意",
          "text": "如果能把先前收集到的数据汇总起来，应该能取得不错的成果…恢复水文监测的事情，指日可待，指日可待呀！"
        },
        {
          "role": "派蒙",
          "text": "哦哦，那真是太好啦！"
        },
        {
          "role": "布罗意",
          "text": "咦？总觉得好像缺了一部分数据…是错觉吗？"
        },
        {
          "role": "派蒙",
          "text": "为什么说得这么不确定啦！这不是你自己负责的数据吗！"
        },
        {
          "role": "马林诺夫斯基",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "…？"
        },
        {
          "role": "马林诺夫斯基",
          "text": "…呃，抱歉，走错房间了…"
        },
        {
          "role": "？？？",
          "text": "愚人众指挥官，以一种与体型完全不符的敏捷，飞也似的溜走了…"
        },
        {
          "role": "派蒙",
          "text": "等…等一下，刚才什么东西过去了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好快，比龙蜥还要快…",
              "dialogues": []
            },
            {
              "text": "还真是个灵活的家伙…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不不不，现在好像不是关心那种事情的时候啦！那家伙是愚人众吧！为什么会出现在这里啊！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们快点追上去，好好问个清楚！"
        },
        {
          "type": "subtitle",
          "text": "追上愚人众指挥官"
        },
        {
          "type": "subtitle",
          "text": "击败愚人众指挥官"
        },
        {
          "type": "subtitle",
          "text": "追上愚人众指挥官"
        },
        {
          "type": "subtitle",
          "text": "再次击败愚人众"
        },
        {
          "type": "subtitle",
          "text": "与愚人众指挥官对峙"
        },
        {
          "role": "马林诺夫斯基",
          "text": "不要再打了！我投降！投降！"
        },
        {
          "role": "马林诺夫斯基",
          "text": "你…你们是为了这些纸带来的吧？全都给你们！不要再打啦！"
        },
        {
          "role": "？？？",
          "text": "愚人众指挥官老老实实地交出了所有的研究数据…"
        },
        {
          "role": "派蒙",
          "text": "怎么样，布罗意，这些就是全部了吗？"
        },
        {
          "role": "布罗意",
          "text": "呃，这个…也许吧？嗯，没错，这应该就是全部了！"
        },
        {
          "role": "派蒙",
          "text": "算了，就当我没问吧…"
        },
        {
          "role": "旅行者",
          "text": "你们的目的是什么？"
        },
        {
          "role": "派蒙",
          "text": "对啊，老实交代！你们占领这些观测站，到底是想要做什么？"
        },
        {
          "role": "马林诺夫斯基",
          "text": "……"
        },
        {
          "role": "马林诺夫斯基",
          "text": "是…为了偷懒…"
        },
        {
          "role": "派蒙",
          "text": "…？"
        },
        {
          "role": "马林诺夫斯基",
          "text": "我的名字是马林诺夫斯基，第三十四独立侦察小队的队长。"
        },
        {
          "role": "马林诺夫斯基",
          "text": "一开始，我们刚被调派到枫丹的时候，大家过得都很开心，也没有什么困难的任务…"
        },
        {
          "role": "派蒙",
          "text": "呃…所以这跟你占领观测站有什么关系？"
        },
        {
          "role": "马林诺夫斯基",
          "text": "没想到，就在几个月前，由于人事关系变动，至冬那边给我分派了一个叫舒米洛夫的家伙，作为我的新副官！"
        },
        {
          "role": "派蒙",
          "text": "舒米洛夫？啊，是之前在桔桔薄饼站那边见到的那个小队长…"
        },
        {
          "role": "马林诺夫斯基",
          "text": "是啊！我实在是受不了那家伙了！但是又没有办法解决掉他，只好找个借口，主动外出执行任务，以便从他身边逃开——"
        },
        {
          "role": "派蒙",
          "text": "等等，你把我说糊涂了…那个叫舒米洛夫的家伙，是你的副官？"
        },
        {
          "role": "马林诺夫斯基",
          "text": "是啊。"
        },
        {
          "role": "派蒙",
          "text": "那他不就是你的下属嘛，上司为什么得听下属的话！"
        },
        {
          "role": "马林诺夫斯基",
          "text": "那个可恶的家伙，分明是我的下属，却总是摆出一副严肃的样子来，让其他人努力工作！"
        },
        {
          "role": "马林诺夫斯基",
          "text": "他说的还都是无法反驳的正论——我总不能当着其他人的面，公开跟他说大家其实根本不想工作吧？！"
        },
        {
          "role": "马林诺夫斯基",
          "text": "正好，我看到附近有一些奇怪的塔，干脆就说我们要来这边调查，然后伪造了复律庭的信件…"
        },
        {
          "role": "派蒙",
          "text": "哼，果然是你们伪造的！想想也是，复律庭怎么可能把水文监测站交给你们管理！"
        },
        {
          "role": "派蒙",
          "text": "布罗意，你还有什么想问他的吗？"
        },
        {
          "role": "布罗意",
          "text": "嗯…原来如此，您占据我们的观测站，只是想要偷懒…不，只是想要在这个喧嚣的世界中获得片刻的安宁。"
        },
        {
          "role": "布罗意",
          "text": "所以呢？您觉得在这里休息的感觉如何？"
        },
        {
          "role": "派蒙",
          "text": "？"
        },
        {
          "role": "马林诺夫斯基",
          "text": "呃…非常舒服？附近的风景也很漂亮，稍微午睡一下，就觉得心情都变得舒畅起来了…"
        },
        {
          "role": "布罗意",
          "text": "对吧？尤其是一觉醒来，发现自己没有任何不得不做的紧急工作，也没有讨厌的人盯着您，只要安心享受午后的阳光与微风…"
        },
        {
          "role": "马林诺夫斯基",
          "text": "就像是从一场梦醒来，就进入了另外一场不必为任何事忧虑的梦。"
        },
        {
          "role": "布罗意",
          "text": "呵，这才是生活，先生！真遗憾，您应该还没有品尝过瓦萨里回廊限量贩售的红茶吧？要是您有机会的话——"
        },
        {
          "role": "派蒙",
          "text": "不不不，你们怎么突然开始聊这种莫名其妙的话题啦！"
        },
        {
          "role": "派蒙",
          "text": "好了，你这家伙，还是老老实实跟我们走一趟吧！是时候向枫丹科学院细数你的罪恶了！"
        },
        {
          "role": "马林诺夫斯基",
          "text": "噫呜——"
        },
        {
          "role": "布罗意",
          "text": "请、请等一下！"
        },
        {
          "role": "布罗意",
          "text": "两位恩人！这位先生实际上并没有对我们的水文研究造成任何破坏，不是吗？"
        },
        {
          "role": "布罗意",
          "text": "从客观结果上来说，这位先生甚至还帮助我们收集了一部分数据…"
        },
        {
          "role": "布罗意",
          "text": "更何况，他也只是不想工作，想要过上美好幸福清闲的生活而已！"
        },
        {
          "role": "马林诺夫斯基",
          "text": "是、是的！"
        },
        {
          "role": "派蒙",
          "text": "不，就算你们两个说得这么理直气壮，这也不是什么值得骄傲的事情吧！"
        },
        {
          "role": "布罗意",
          "text": "拜托了，好心的先生！看在科学的份上，就请您宽宏大量，放过他这一次吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "虽然和科学好像没什么关系…",
              "dialogues": []
            },
            {
              "text": "既然当事人都已经这么说了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马林诺夫斯基",
          "text": "谢…谢谢你，先生，还有两位！我发誓，我绝对绝对不会再做这种事了！从今往后，我一定会拼尽全力，只靠自己的能力偷懒！"
        },
        {
          "role": "布罗意",
          "text": "没错！最重要的就是那样的决心！"
        },
        {
          "role": "派蒙",
          "text": "不要在这种地方燃起奇怪的斗志啊！"
        },
        {
          "role": "？？？",
          "text": "愚人众的指挥官感恩戴德地离开了…"
        },
        {
          "role": "布罗意",
          "text": "好！既然问题已经圆满解决了，我也该回去整理一下这些数据了！"
        },
        {
          "role": "布罗意",
          "text": "非常感谢两位！拜托了，请务必收下这些！"
        },
        {
          "role": "派蒙",
          "text": "真…真的圆满解决了吗？"
        },
        {
          "role": "派蒙",
          "text": "唔，算了…观测站也恢复运作了，那些愚人众小队也撤退了，这件事也算是告一段落了吧…"
        }
      ]
    }
  ]
}