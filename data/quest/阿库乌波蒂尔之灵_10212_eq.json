{
  "quest_id": 10212,
  "chapter_num": "暝视寻灵织卷·下",
  "chapter_title": "阿库乌波蒂尔之灵",
  "type": "eq",
  "route": "The Spirit of Ah K'ulbatil",
  "stories": [
    {
      "story_id": 40173,
      "title": "阿库乌波蒂尔之灵",
      "description": "按照茜特菈莉的计划，今天就是将勒拉的灵性引导回身体的日子，你们能否顺利完成这件事呢…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至两天后"
        },
        {
          "type": "subtitle",
          "text": "前往勒拉的山洞"
        },
        {
          "role": "茜特菈莉",
          "text": "各位好。"
        },
        {
          "role": "派蒙",
          "text": "茜特菈莉，你来啦！"
        },
        {
          "role": "茜特菈莉",
          "text": "嗯，我去首领那里请来了一柄仪式剑，借用它的力量可以完成一些事情。"
        },
        {
          "role": "茜特菈莉",
          "text": "都没忘记我们今天要干什么吧？"
        },
        {
          "role": "派蒙",
          "text": "当然啦，我们都等着勒拉醒来，好问问他到底是怎么回事呢。"
        },
        {
          "role": "欧洛伦",
          "text": "按照奶奶说的，我也准备好了备用的物品，今天万无一失。"
        },
        {
          "role": "茜特菈莉",
          "text": "真不错，那我们就不多说了，现在就开始吧。"
        },
        {
          "type": "subtitle",
          "text": "茜特菈莉召出了一柄名为「厄水之祸」的仪式剑。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "茜特菈莉",
          "text": "自秘烟中献上供奉。星星献予无月之夜，梦的花环献予风。"
        },
        {
          "role": "茜特菈莉",
          "text": "向死之主献上供奉。褪落。褪落。褪落。往复三重又三重。"
        },
        {
          "role": "派蒙",
          "text": "呜哇——这是什么咒语吗？突然一下变得好凉！是不是有什么东西来了！"
        },
        {
          "role": "欧洛伦",
          "text": "小声一点，现在不能吵到她。"
        },
        {
          "role": "茜特菈莉",
          "text": "我等，祭司王之嗣，要遵循亘古的盟约，撕裂夜域的织帷。"
        },
        {
          "role": "茜特菈莉",
          "text": "茜特菈莉在此告谕。我为阿库乌波蒂尔，我为末地的养主。"
        },
        {
          "role": "勒拉",
          "text": "……"
        },
        {
          "role": "欧洛伦",
          "text": "看！勒拉的灵性回来了，正在往他的身上跑。"
        },
        {
          "role": "茜特菈莉",
          "text": "我要用燧石刀刺入夜的斗篷，逐弃一切不属于亡者之国的魂灵。"
        },
        {
          "role": "茜特菈莉",
          "text": "勒拉！依从敕命，归来炎日下的地土，归来你应属的道途！"
        },
        {
          "role": "派蒙",
          "text": "成…成功了吗？"
        },
        {
          "role": "勒拉",
          "text": "欸…欸？这里是…？你们…"
        },
        {
          "role": "勒拉",
          "text": "呜哇——黑曜石奶奶！不不…茜特菈莉大祭司！请手下留情！！"
        },
        {
          "role": "茜特菈莉",
          "text": "你这小鬼，看来很清楚自己干了什么嘛？"
        },
        {
          "role": "茜特菈莉",
          "text": "知道自己差点回不来吗？把自己变成一具空壳很有趣吗？"
        },
        {
          "role": "勒拉",
          "text": "对、对不起…请惩罚我吧。"
        },
        {
          "role": "茜特菈莉",
          "text": "噢？你是真心的吗？那就快回家和父母告个别吧，就说："
        },
        {
          "role": "茜特菈莉",
          "text": "「再见了，爸爸妈妈，我喜欢空壳的人生，所以决定去黑曜石奶奶那里变成一块石像，替她看家一百年。」"
        },
        {
          "role": "勒拉",
          "text": "不要啊，我知道错了！十分感谢茜特菈莉大祭司把我救回来！"
        },
        {
          "role": "茜特菈莉",
          "text": "哼哼，还是谢我孙子吧，要不是他察觉到异常，我是不想管这回事的。"
        },
        {
          "role": "欧洛伦",
          "text": "不用客气，勒拉，奶奶只是嘴巴不饶人，我们都不会怪你的。"
        },
        {
          "role": "欧洛伦",
          "text": "毕竟你受了别人的蛊惑吧？那个谷中才是罪魁祸首。"
        },
        {
          "role": "勒拉",
          "text": "不…跟谷中先生没关系，是我要这么干的。"
        },
        {
          "role": "派蒙",
          "text": "欸？"
        },
        {
          "role": "勒拉",
          "text": "虽然是他告诉了我用强大灵物来做媒介的方法，但决定要这么做的人是我，他并没有蛊惑我什么。"
        },
        {
          "role": "勒拉",
          "text": "对不起，要怪也只能怪我。"
        },
        {
          "role": "茜特菈莉",
          "text": "呵呵，这小鬼被洗脑得不轻啊。"
        },
        {
          "role": "派蒙",
          "text": "呃…那那个媒介碎片是他带来的吗？"
        },
        {
          "role": "勒拉",
          "text": "没错，据他说是跟烬寂海相关的宝物。"
        },
        {
          "role": "派蒙",
          "text": "那这一看就是在利用你吧！利用你帮他暝视！"
        },
        {
          "role": "勒拉",
          "text": "可是，我只是一个灵性白痴，什么法术都学不会…我有什么利用价值呢？"
        },
        {
          "role": "勒拉",
          "text": "像我这样的家伙，如果只是打坐冥想，一辈子都没法感知到灵性的。"
        },
        {
          "role": "勒拉",
          "text": "谷中先生说，如果用别的办法让我强行施展法术，把自己浸泡在大量灵性中，反而有机会抓住它们的踪影。所以…"
        },
        {
          "role": "派蒙",
          "text": "这简直就是破罐子破摔了啊！要不是茜特菈莉，你可真的就回不来了！"
        },
        {
          "role": "勒拉",
          "text": "对不起…对不起…族里的大家都是很有才华的人，可我却是个白痴…我只是不想再当异类…"
        },
        {
          "role": "欧洛伦",
          "text": "我很理解你…勒拉。"
        },
        {
          "role": "欧洛伦",
          "text": "有些种子可以毫不费劲地长成漂亮的卷心菜，但也有些种子，怎么努力都没法发芽。"
        },
        {
          "role": "欧洛伦",
          "text": "我也不知道为什么会是这样，可能这就是人生吧？总有很多没办法的事情。"
        },
        {
          "role": "欧洛伦",
          "text": "虽然我说这些也没有用，但希望你能调整好自己。"
        },
        {
          "role": "茜特菈莉",
          "text": "总之，有什么事之后再说吧，现在先跟我去马塔拉那里检查身体。"
        },
        {
          "type": "subtitle",
          "text": "前往巫医马塔拉处"
        },
        {
          "role": "马塔拉",
          "text": "嗯，挺好，小伙子身体没什么毛病，就是饥饿程度比较高，回去多吃点饭。"
        },
        {
          "role": "欧洛伦",
          "text": "那太好了，之前我还听说，有那种出神太久结果身体部位坏死的情况。"
        },
        {
          "role": "派蒙",
          "text": "这也太可怕了吧。"
        },
        {
          "role": "欧洛伦",
          "text": "嗯，总之勒拉，虽然我们之前不认识，但是现在你没事就好，我为你高兴。"
        },
        {
          "role": "勒拉",
          "text": "其实，欧洛伦，只是你不认识我而已…我早就听过你的事情了。"
        },
        {
          "role": "勒拉",
          "text": "还有茜特菈莉大祭司，旅行者，派蒙，你们的事迹我都知道…"
        },
        {
          "role": "派蒙",
          "text": "欸？居然连我和旅行者都…"
        },
        {
          "role": "勒拉",
          "text": "说起来还挺不好意思的，因为你们都是我梦寐以求想要成为的人，但事实证明，我只有仰望你们的份。"
        },
        {
          "role": "勒拉",
          "text": "谁让我生来就是个灵性白痴呢？哈哈，没关系，我已经习惯了被忽视的日子了。谢谢你们救了我。"
        },
        {
          "role": "勒拉",
          "text": "欧洛伦，你说的对，也许这就是人生。我之后不会再做这种危险的事、再给大家添麻烦了。"
        },
        {
          "role": "派蒙",
          "text": "勒拉先生…"
        },
        {
          "role": "勒拉",
          "text": "不用安慰我啦，哈哈。"
        },
        {
          "role": "茜特菈莉",
          "text": "喂，你这小鬼在说什么呢？你好好看看我。"
        },
        {
          "role": "勒拉",
          "text": "欸？茜特菈莉大祭司，怎么了吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "让你看就仔细看，感觉出来什么了吗？"
        },
        {
          "role": "欧洛伦",
          "text": "奶奶，你在说什么？"
        },
        {
          "role": "派蒙",
          "text": "呃…旅行者，你说茜特菈莉脸上是不是也写着「乐于助人」？"
        },
        {
          "role": "勒拉",
          "text": "…等一下，好像…"
        },
        {
          "role": "勒拉",
          "text": "不知道是不是我的错觉，我感觉茜特菈莉大祭司的身体是虚幻的…"
        },
        {
          "role": "勒拉",
          "text": "不…肯定是错觉，我怎么可能看出来。"
        },
        {
          "role": "欧洛伦",
          "text": "等等，这种套路…是我用过的那个法术，奶奶的真身已经离我们很远了。根本就是脚底抹油。"
        },
        {
          "role": "茜特菈莉",
          "text": "看见了吗？你已经能察觉到一点灵性的异常了。恭喜你。"
        },
        {
          "role": "勒拉",
          "text": "真…真的吗？"
        },
        {
          "role": "欧洛伦",
          "text": "不过这是要去哪里？"
        },
        {
          "role": "茜特菈莉",
          "text": "笨，当然是钓鱼了。"
        },
        {
          "role": "茜特菈莉",
          "text": "我留在山洞里的陷阱被人踩中了，那个叫谷中的家伙上钩了。"
        },
        {
          "role": "派蒙",
          "text": "什么？"
        },
        {
          "role": "茜特菈莉",
          "text": "闲话之后再聊，来山洞里找我。"
        },
        {
          "type": "subtitle",
          "text": "返回勒拉的山洞"
        },
        {
          "role": "茜特菈莉",
          "text": "……"
        },
        {
          "role": "茜特菈莉",
          "text": "（居然被那家伙跑了，这下糗大了…刚刚还一副自信满满的样子，哦天！我的形象…）"
        },
        {
          "role": "茜特菈莉",
          "text": "（虽然那个谷中出人意料地擅长逃跑，但我也得想个恰当的说辞…）"
        },
        {
          "role": "派蒙",
          "text": "茜特菈莉！你抓住那个谷中了吗？"
        },
        {
          "role": "欧洛伦",
          "text": "从山洞里只有奶奶一个人来看，应该是没有。"
        },
        {
          "role": "茜特菈莉",
          "text": "…我…"
        },
        {
          "role": "茜特菈莉",
          "text": "我暂时放了他一马。"
        },
        {
          "role": "茜特菈莉",
          "text": "不过我在他身上留下了记号，如果他出现在附近，我就能追踪到他。"
        },
        {
          "role": "欧洛伦",
          "text": "原来奶奶刚才是假装离开山洞，实际偷偷躲了起来，准备来个瓮中捉鳖。"
        },
        {
          "type": "subtitle",
          "text": "茜特菈莉点了点头…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "噢！就跟一开始抓欧洛伦那样。"
        },
        {
          "role": "派蒙",
          "text": "不过茜特菈莉怎么知道那个家伙会过来呢？"
        },
        {
          "role": "茜特菈莉",
          "text": "因为我放了诱饵啊，那张烬寂海的地图和弓的碎片，我刻意把它们留在桌子上，因为它们可能就是谷中的目的。"
        },
        {
          "role": "茜特菈莉",
          "text": "果然我们离开没多久后，我留下的陷阱就被触发了。"
        },
        {
          "role": "派蒙",
          "text": "什么？原来洞里真的有陷阱！"
        },
        {
          "role": "茜特菈莉",
          "text": "当然，只是会自动忽略你们而已。"
        },
        {
          "role": "欧洛伦",
          "text": "看，我之前没瞎说吧？"
        },
        {
          "role": "勒拉",
          "text": "谷中先生，原来你真的在利用我…原来你的目的是烬寂海的情报…"
        },
        {
          "role": "茜特菈莉",
          "text": "没错，我最初就在想，那家伙为什么会把碎片留在营地。"
        },
        {
          "role": "茜特菈莉",
          "text": "在我得到烬寂海位置的时候，我明白了，那个碎片是诱饵。"
        },
        {
          "role": "茜特菈莉",
          "text": "他知道勒拉一定会出问题，而部族又不会对勒拉视而不见，一定会有人来帮助勒拉…"
        },
        {
          "role": "派蒙",
          "text": "噢！他在钓鱼！钓出真正有能力的人来帮他暝视这块碎片！"
        },
        {
          "role": "茜特菈莉",
          "text": "没错，而上钩的人…"
        },
        {
          "role": "欧洛伦",
          "text": "对不起，是我…"
        },
        {
          "role": "欧洛伦",
          "text": "但还有奶奶。"
        },
        {
          "role": "茜特菈莉",
          "text": "臭小子！我是因为你！"
        },
        {
          "role": "欧洛伦",
          "text": "总之，这个谷中真狡猾，选择了风险最低的一种办法。"
        },
        {
          "role": "派蒙",
          "text": "是哦，如果那家伙直接找到茜特菈莉，应该一分钟就会被识破！"
        },
        {
          "role": "派蒙",
          "text": "那话说回来，茜特菈莉，你为什么要放他一马呀？"
        },
        {
          "role": "茜特菈莉",
          "text": "咳…因为这里不方便施展出全力，那家伙又很擅长逃跑，强行留下他可能会出问题。"
        },
        {
          "role": "欧洛伦",
          "text": "难道是我选错了地方…抱歉。"
        },
        {
          "role": "欧洛伦",
          "text": "一开始为了救勒拉，我想找一个灵性比较充足的区域，所以就找到了疯贤者的地盘。"
        },
        {
          "role": "派蒙",
          "text": "疯贤者？"
        },
        {
          "role": "茜特菈莉",
          "text": "没错，那家伙就在那堵墙后面，如果把他吵醒了也是个麻烦，所以我只能收着手。"
        },
        {
          "role": "茜特菈莉",
          "text": "不过现在还有一个好消息：我把地图和碎片都抢了回来。奶奶我也不是吃素的。"
        },
        {
          "role": "派蒙",
          "text": "太好了！那家伙能带走的就只有他自己！"
        },
        {
          "role": "茜特菈莉",
          "text": "唔…可有一点坏的消息是：他大概已经看过了那地图，虽说烬寂海消失时的位置也不算什么秘辛吧…"
        },
        {
          "role": "派蒙",
          "text": "啊？真令人担忧，那家伙不会要做什么坏事吧…"
        },
        {
          "role": "茜特菈莉",
          "text": "不用太紧张，我会追踪那家伙的。"
        },
        {
          "role": "茜特菈莉",
          "text": "另外，勒拉，如果你没意见，我想把地图和这块碎片送给旅行者，这或许对他未来的旅途有帮助。"
        },
        {
          "role": "勒拉",
          "text": "当然！当然没意见！这是旅行者应得的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有点太贵重了吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "茜特菈莉",
          "text": "反正我们都没兴趣。如果它真的指向了烬寂海，你这样的冒险者肯定不愿意错过那里。"
        },
        {
          "role": "茜特菈莉",
          "text": "这是黑曜石奶奶的预感噢。"
        },
        {
          "role": "勒拉",
          "text": "那个，黑曜石奶奶，还有一件事，我现在还是灵性白痴吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "什么傻问题？你不是察觉了奶奶我的幻影术吗？虽说是故意露的破绽，但也不是灵性白痴能识破的。"
        },
        {
          "role": "茜特菈莉",
          "text": "欧洛伦，之后你有空就好好教教这家伙。"
        },
        {
          "role": "茜特菈莉",
          "text": "能学多少，勒拉，就全看你自己的本事了。"
        },
        {
          "role": "欧洛伦",
          "text": "真好啊，人生真是奇妙，只要一直向前走，说不定就会碰到肥料。"
        },
        {
          "role": "欧洛伦",
          "text": "勒拉，我为你高兴。以后要一起加油啊，希望我们都能成为一颗漂亮的卷心菜。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（茜特菈莉）"
        },
        {
          "role": "茜特菈莉",
