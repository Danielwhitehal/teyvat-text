{
  "quest_id": 41151,
  "chapter_num": null,
  "chapter_title": "万民鲜食",
  "type": "eq",
  "route": "Wanmin Fresh",
  "stories": [
    {
      "story_id": 41151,
      "title": "万民鲜食",
      "description": "璃月港的万民堂里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "卯师傅",
          "text": "好吧，那你先忙吧。"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "卯师傅",
          "text": "那就麻烦你了。"
        },
        {
          "role": "寡言的廷方",
          "text": "嗯…怎么还没来…"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "卯师傅",
          "text": "有个叫廷方的家伙点了一份香嫩椒椒鸡，说之后送去。"
        },
        {
          "role": "卯师傅",
          "text": "这个香嫩椒椒鸡，路上不要乱飞瞎爬，尤其是记得不要沾任何元素，还要限定时间内送到。错了一项这口感就全完了。"
        },
        {
          "role": "卯师傅",
          "text": "如果路上出事了，你回来找我，我重新为客人再做一份。不能辱没了万民堂名声。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "寡言的廷方",
          "text": "收到了。有劳了。"
        }
      ]
    }
  ]
}