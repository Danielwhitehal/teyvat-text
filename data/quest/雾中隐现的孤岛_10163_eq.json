{
  "quest_id": 10163,
  "chapter_num": "铳枪与蔷薇 第三幕",
  "chapter_title": "雾中隐现的孤岛",
  "type": "eq",
  "route": "The Lone Isle Glimpsed Through Fog",
  "stories": [
    {
      "story_id": 40134,
      "title": "雾中隐现的孤岛",
      "description": "黑夜的迷雾之中，孤岛悄然而现。它究竟会将你们引向何处…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到第二天早晨（8-10点）"
        },
        {
          "type": "subtitle",
          "text": "前往集合地点"
        },
        {
          "role": "派蒙",
          "text": "又可以去拍映影了呢！这几天的行程还挺满，要去好多不同的地方。"
        },
        {
          "role": "派蒙",
          "text": "我们快出发吧，先去约定好的集合地点！"
        },
        {
          "type": "subtitle",
          "text": "影片的拍摄与案件的调查都在稳步推进，就这么过了几天的时间…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "芙宁娜",
          "text": "大家辛苦了！今天是两位主角的杀青戏，我们已经离成功不远了。"
        },
        {
          "role": "派蒙",
          "text": "「杀青」是什么意思？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就是拍完了的意思。",
              "dialogues": []
            },
            {
              "text": "意思是底片不会再动了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哦！你懂的真多！"
        },
        {
          "role": "芙宁娜",
          "text": "这场讲的是两位铳枪手与伯爵的最终对峙，动作戏会比较多，大家按照之前排练的来就行。"
        },
        {
          "role": "芙宁娜",
          "text": "准备好，三、二、一，开始！"
        },
        {
          "role": "「伯爵」",
          "text": "今天的夜色可真美，不是吗？让我想到了十年前的那个夜晚。"
        },
        {
          "role": "「伯爵」",
          "text": "嗯，这么一闻，我甚至都能嗅到花草茶的香气。"
        },
        {
          "role": "「爱芮丝」",
          "text": "闭嘴，你这个害死了母亲的恶棍。"
        },
        {
          "role": "「伯爵」",
          "text": "我亲爱的爱芮丝，你怎么能这么跟我说话呢？我可是你的父亲。"
        },
        {
          "role": "「图利佩」",
          "text": "就算是拔光我嘴里的最后一颗牙，也别指望我吐出这两个字。"
        },
        {
          "role": "「伯爵」",
          "text": "…我的女儿们，你们就和那位愚蠢的母亲一样执迷不悟。"
        },
        {
          "role": "「伯爵」",
          "text": "在这个社会，有了金钱和地位，就是有了绝对的力量。"
        },
        {
          "role": "「伯爵」",
          "text": "她以为用孩子就可以要挟我，向我提要求？不不不，她太天真了。"
        },
        {
          "role": "「爱芮丝」",
          "text": "母亲从未向你提过什么要求，她只希望我们像其他人一样过上安稳的一生。"
        },
        {
          "role": "「图利佩」",
          "text": "是你们亲手酿出了名为「偏见」的毒药，害死了母亲。"
        },
        {
          "role": "「图利佩」",
          "text": "和这毒药比起来，你即将吃到的两颗子弹，已经算甜的了。"
        },
        {
          "role": "「伯爵」",
          "text": "哈哈哈，所以说，你们和她一样天真。以为有两把枪就赢了？"
        },
        {
          "role": "「伯爵」",
          "text": "就让我看看，是金钱与地位更厉害，还是你们手上的枪更厉害。"
        },
        {
          "type": "subtitle",
          "text": "拍摄复仇的场景，击败敌人"
        },
        {
          "role": "「伯爵」",
          "text": "都给我上！"
        },
        {
          "role": "「爱芮丝」",
          "text": "姐姐，他们人太多了！"
        },
        {
          "role": "「图利佩」",
          "text": "没事的！爱芮丝 ，我们掩护彼此。"
        },
        {
          "role": "「图利佩」",
          "text": "母亲…也一定会保佑我们。"
        },
        {
          "type": "subtitle",
          "text": "进行映影的拍摄"
        },
        {
          "role": "「图利佩」",
          "text": "你输了。"
        },
        {
          "role": "「伯爵」",
          "text": "嘁…想不到，区区两个丫头…"
        },
        {
          "role": "「爱芮丝」",
          "text": "我们从不是你的丫头，那里也不是我们的家。"
        },
        {
          "role": "「伯爵」",
          "text": "哼…告诉我，这一切到底为了什么？"
        },
        {
          "role": "「伯爵」",
          "text": "你们失去了母亲、杀死了父亲…除了一身罪名，还能留下什么？"
        },
        {
          "role": "「图利佩」",
          "text": "留下了…「正义」。"
        },
        {
          "role": "「图利佩」",
          "text": "（枪响——）"
        },
        {
          "role": "「图利佩」",
          "text": "…结束了。"
        },
        {
          "role": "「爱芮丝」",
          "text": "…终于，结束了。"
        },
        {
          "role": "「爱芮丝」",
          "text": "姐姐，接下来你会去哪里？"
        },
        {
          "role": "「图利佩」",
          "text": "我不知道，爱芮丝，可能去一个开满鲜花的地方吧，母亲以前常这么说。你呢？"
        },
        {
          "role": "「爱芮丝」",
          "text": "我想先去给母亲扫一次墓。"
        },
        {
          "role": "「图利佩」",
          "text": "嗯，不错的主意…"
        },
        {
          "role": "「爱芮丝」",
          "text": "…！姐姐，你看！"
        },
        {
          "role": "「图利佩」",
          "text": "怎么了？"
        },
        {
          "role": "「爱芮丝」",
          "text": "母亲最喜欢的虹彩蔷薇，开了。"
        },
        {
          "role": "芙宁娜",
          "text": "（啪——啪——）"
        },
        {
          "role": "芙宁娜",
          "text": "精彩，真是太精彩了！我也没想到这条能拍得那么顺利，一气呵成。"
        },
        {
          "role": "芙宁娜",
          "text": "我宣布，两位主角的戏码杀青！"
        },
        {
          "role": "派蒙",
          "text": "绫华！夏沃蕾！恭喜你们！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "演得真棒。",
              "dialogues": []
            },
            {
              "text": "祝贺杀青。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫华",
          "text": "谢谢各位。没想到夏沃蕾和我的戏份这么快就拍完了，还真有些舍不得。"
        },
        {
          "role": "派蒙",
          "text": "我能理解，想到再过几天就不能玩打板器了，好遗憾啊。拍映影还真是件开心的事情呢！"
        },
        {
          "role": "派蒙",
          "text": "夏沃蕾也很棒，那句「留下了正义」，简直太帅了！"
        },
        {
          "role": "夏沃蕾",
          "text": "这的确是书中我最喜欢的台词，以前读到的时候，还经常在自己房间里比划。"
        },
        {
          "role": "派蒙",
          "text": "真看不出夏沃蕾你还有这样的一面。"
        },
        {
          "role": "夏沃蕾",
          "text": "坏人被制裁，正义战胜邪恶，有谁不喜欢这样的结局？别忘了，我可是枫丹特巡队队长。"
        },
        {
          "role": "勒泰利埃",
          "text": "报告！队长。有紧急情况需要汇报。"
        },
        {
          "role": "夏沃蕾",
          "text": "…抱歉，各位，我先失陪一下。"
        },
        {
          "role": "派蒙",
          "text": "你放心去忙吧！"
        },
        {
          "role": "芙宁娜",
          "text": "怎么这就被喊走了？我还想来夸夸她呢。"
        },
        {
          "role": "神里绫华",
          "text": "似乎是有要紧的公事要办。"
        },
        {
          "role": "芙宁娜",
          "text": "哦，那还好今天你们的部分顺利，不然拍摄计划调整起来还挺麻烦。"
        },
        {
          "role": "芙宁娜",
          "text": "对了，我是来告诉大家今天可以提前解散了，早点回去休息吧。"
        },
        {
          "role": "芙宁娜",
          "text": "还有，绫华小姐，你的演技还是一如既往的出色，真的不考虑来当专业演员吗？我刚好知道有个优秀的剧团在招募女主角。"
        },
        {
          "role": "神里绫华",
          "text": "谢谢芙宁娜导演的肯定。但稻妻社奉行还有许多事情需要操办，我无法长期留在枫丹从事演艺事业。"
        },
        {
          "role": "神里绫华",
          "text": "我会将这次的合作经历，当作一份宝物，珍藏于心的。"
        },
        {
          "role": "芙宁娜",
          "text": "好吧，真是可惜。但如果你改主意了，随时来找我。"
        },
        {
          "role": "神里绫华",
          "text": "我也差不多告辞了。虽说我的戏份已经结束，但之后几天我还是想来现场帮帮忙。"
        },
        {
          "role": "神里绫华",
          "text": "旅行者，派蒙，我们明天见。"
        },
        {
          "role": "派蒙",
          "text": "嗯！明天见！"
        },
        {
          "role": "派蒙",
          "text": "我们接下来去哪里呢？也不知道今天还要不要和夏沃蕾一起调查。"
        },
        {
          "role": "夏沃蕾",
          "text": "旅行者，派蒙，跟我来。"
        },
        {
          "role": "派蒙",
          "text": "欸？去…去哪儿？"
        },
        {
          "role": "夏沃蕾",
          "text": "我们的船，终于撞上一座「孤岛」了。"
        },
        {
          "type": "subtitle",
          "text": "与夏沃蕾一同追踪线索"
        },
        {
          "role": "派蒙",
          "text": "呃…累死我了，拍完戏还走这么远的路。"
        },
        {
          "role": "派蒙",
          "text": "所以，夏沃蕾你把我们带到这里做什么呀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么线索了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "没错。虽然不是决定性证据，但也是关键的一步。"
        },
        {
          "role": "夏沃蕾",
          "text": "你们听过艾梅莉埃这个名字吗？"
        },
        {
          "role": "派蒙",
          "text": "哦，是那位著名的调香师吧？"
        },
        {
          "role": "夏沃蕾",
          "text": "她和我关系不错，偶尔会帮我解决一些难题。"
        },
        {
          "role": "夏沃蕾",
          "text": "我不久前将案发现场留下的虹彩蔷薇寄给了她，毕竟，她每天都在和花卉打交道。"
        },
        {
          "role": "派蒙",
          "text": "结果呢？"
        },
        {
          "role": "夏沃蕾",
          "text": "花卉上没有留下什么其他的痕迹，土壤样本也没什么特别。"
        },
        {
          "role": "夏沃蕾",
          "text": "但艾梅莉埃发现，犯罪现场留下的虹彩蔷薇，是一种特别稀有的品种。"
        },
        {
          "role": "派蒙",
          "text": "虹彩蔷薇还分品种？这种花不是在枫丹野外遍地都是吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "任何花卉人工繁育和自然条件下的生长结果都会有所不同。"
        },
        {
          "role": "夏沃蕾",
          "text": "我们之前知道案发现场的是人工繁育品种，但艾梅莉埃凭借她的专业本领，为我们进一步缩小了范围。"
        },
        {
          "role": "派蒙",
          "text": "哦！也就是说只要知道谁家种了这种品种，他就很有可能是犯人对吧！"
        },
        {
          "role": "夏沃蕾",
          "text": "没错，在进一步对购买记录进行交叉比对之后，我们发现枫丹只有一个人种这种品种的虹彩蔷薇。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？是谁？"
        },
        {
          "role": "夏沃蕾",
          "text": "就是那位「作者」。"
        },
        {
          "role": "派蒙",
          "text": "欸？可你不是说…"
        },
        {
          "role": "夏沃蕾",
          "text": "我到现在也坚持自己的看法。我不认为他杀过人。"
        },
        {
          "role": "夏沃蕾",
          "text": "但，这不代表犯人没有到过他的家中，或是他没有向犯人出售过自己种的蔷薇。"
        },
        {
          "role": "夏沃蕾",
          "text": "不管怎样，一场问话是免不了的了。"
        },
        {
          "role": "派蒙",
          "text": "那我们现在要去的地方…"
        },
        {
          "role": "夏沃蕾",
          "text": "就是「作者」的家。"
        },
        {
          "type": "subtitle",
          "text": "前往夏沃蕾所说的地点"
        },
        {
          "role": "夏沃蕾",
          "text": "那幢房子就是了。"
        },
        {
          "role": "派蒙",
          "text": "周围好多机械警卫，普通人的家不是这样的吧？"
        },
        {
          "role": "夏沃蕾",
          "text": "按上次和他见面的说法，这是希望不被人打扰。"
        },
        {
          "role": "派蒙",
          "text": "他院子里种着好多花。呃…但要避开这些警卫去摘也太困难了。"
        },
        {
          "role": "夏沃蕾",
          "text": "所以我觉得他和犯人的关系肯定不简单。"
        },
        {
          "role": "派蒙",
          "text": "我们要去敲门吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "安全起见，还是让我解决一部分机械警卫再去吧。"
        },
        {
          "role": "派蒙",
          "text": "这么远的地方，你怎么解决？"
        },
        {
          "role": "夏沃蕾",
          "text": "派蒙你是不是忘了，我可是一位真正的「铳枪手」。"
        },
        {
          "type": "subtitle",
          "text": "击败机械警卫"
        },
        {
          "type": "subtitle",
          "text": "与夏沃蕾对话"
        },
        {
          "role": "夏沃蕾",
          "text": "搞定。我们走。"
        },
        {
          "role": "派蒙",
          "text": "等等等等，一想到那里可能有凶手我就有些紧张，再告诉我一遍该干什么。"
        },
        {
          "role": "夏沃蕾",
          "text": "我会先去敲门，确认屋内的安全。顺带问他愿不愿意去一趟警备队，我们有些问题要问他。"
        },
        {
          "role": "派蒙",
          "text": "不能直接逮捕他吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "我们还没有充足的证据证明他就是凶手，或者协助过凶手。"
        },
        {
          "role": "夏沃蕾",
          "text": "不过，我希望在我敲门的时候，你们能帮我采一株他的虹彩蔷薇，方便之后带回去给逐影庭作比对。"
        },
        {
          "role": "派蒙",
          "text": "好，这没问题，夏沃蕾你也小心。"
        },
        {
          "type": "subtitle",
          "text": "前往作者的家"
        },
        {
          "role": "夏沃蕾",
          "text": "巴蒂斯特先生，您在家吗？"
        },
        {
          "role": "巴蒂斯特",
          "text": "这么晚了…哟，是夏沃蕾警官。"
        },
        {
          "role": "夏沃蕾",
          "text": "巴蒂斯特先生，您介意和我一起去趟警备队吗？关于案件，还有些问题想问你。"
        },
        {
          "role": "巴蒂斯特",
          "text": "还是上次那个铳枪杀人案吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "我暂时无可奉告。"
        },
        {
          "role": "巴蒂斯特",
          "text": "那就是没错了。"
        },
        {
          "role": "夏沃蕾",
          "text": "巴蒂斯特先生，您的回答是？"
        },
        {
          "role": "巴蒂斯特",
          "text": "哎…夏沃蕾小姐，我就为你省点功夫吧。还有那边的两位，也省下你们摘花的功夫吧，这些花苞还没到开放的那一天。"
        },
        {
          "role": "派蒙",
          "text": "呃…"
        },
        {
          "role": "夏沃蕾",
          "text": "您指的「省功夫」是…"
        },
        {
          "role": "巴蒂斯特",
          "text": "人是我杀的。"
        },
        {
          "role": "夏沃蕾",
          "text": "……！"
        },
        {
          "role": "派蒙",
          "text": "他…他承认了！"
        },
        {
          "role": "巴蒂斯特",
          "text": "几位放轻松，我身上没带武器。枪埋在后院里了。"
        },
        {
          "role": "夏沃蕾",
          "text": "…我有义务提醒你，巴蒂斯特先生，你现在说出的每一个字都会成为审判庭上的重要证据。"
        },
        {
          "role": "巴蒂斯特",
          "text": "我当然知道。"
        },
        {
          "role": "夏沃蕾",
          "text": "…我讨厌这种感觉。"
        },
        {
          "role": "巴蒂斯特",
          "text": "讨厌我认罪了，还是讨厌自己错了？"
        },
        {
          "role": "夏沃蕾",
          "text": "二者皆有。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那位死者…",
              "dialogues": []
            },
            {
              "text": "你为什么要那么做…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "巴蒂斯特",
          "text": "和我在小说中写的是一样的理由——为了复仇。"
        },
        {
          "role": "夏沃蕾",
          "text": "……"
        },
        {
          "role": "巴蒂斯特",
          "text": "我知道你们没有查到他和我的联系，不然我早就去警备队了。"
        },
        {
          "role": "巴蒂斯特",
          "text": "但我永远记得他的脸，就是他杀死了我的母亲。"
        },
        {
          "role": "夏沃蕾",
          "text": "…你母亲如今健在。"
        },
        {
          "role": "巴蒂斯特",
          "text": "你知道我是被领养的。我说的是亲生母亲。"
        },
        {
          "role": "夏沃蕾",
          "text": "这些可没写在孤儿院的记录里…"
        },
        {
          "role": "巴蒂斯特",
          "text": "母亲在眼前死去，足以让一位六岁的孩子学会用谎言保护自己。"
        },
        {
          "role": "派蒙",
          "text": "所以…小说中的那些都是…真的？"
        },
        {
          "role": "巴蒂斯特",
          "text": "不，当然不是。小说经过了艺术的加工。"
        },
        {
          "role": "巴蒂斯特",
          "text": "但…我是一位富人的私生子，而那位富人杀死了我的母亲，这是真的。"
        },
        {
          "role": "夏沃蕾",
          "text": "你杀死的人可没钱。"
        },
        {
          "role": "巴蒂斯特",
          "text": "他是被金钱雇佣的杀手，为了摩拉而对一位手无寸铁的母亲下手的禽兽。"
        },
        {
          "role": "夏沃蕾",
          "text": "如果真是这样，你就不该告诉我们这些。你还没有杀死真正的幕后黑手。"
        },
        {
          "role": "巴蒂斯特",
          "text": "…哈哈，真想不到这话会从一位特巡队队长嘴里说出来。"
        },
        {
          "role": "夏沃蕾",
          "text": "我在怀疑你做这一切的动机。"
        },
        {
          "role": "巴蒂斯特",
          "text": "很简单，我累了。不想再背负这一切了。"
        },
        {
          "role": "巴蒂斯特",
          "text": "你可能觉得我是不敢开枪的那种人。那么你对了，开枪后所带来的一切才是真正的磨难。"
        },
        {
          "role": "夏沃蕾",
          "text": "你就这么放弃你的复仇？"
        },
        {
          "role": "巴蒂斯特",
          "text": "那人有太多的权和钱了，我深知自己一个人已经无法完成复仇。"
        },
        {
          "role": "夏沃蕾",
          "text": "那又如何？你书里可不是这么写的。"
        },
        {
          "role": "巴蒂斯特",
          "text": "我以为我俩之间我才是罪犯。你是在教唆我去犯罪吗？警官大人。"
        },
        {
          "role": "夏沃蕾",
          "text": "那位富人叫什么名字？你怎么证明自己说的这一切是真的？"
        },
        {
          "role": "巴蒂斯特",
          "text": "…我想和你单独谈谈。"
        },
        {
          "role": "夏沃蕾",
          "text": "不如去警备队谈谈？"
        },
        {
          "role": "巴蒂斯特",
          "text": "不，只有这里才不会被其他人听见。"
        },
        {
          "role": "夏沃蕾",
          "text": "…行，你说吧。"
        },
        {
          "role": "巴蒂斯特",
          "text": "我指的「其他人」，是除你以外的所有人。"
        },
        {
          "role": "巴蒂斯特",
          "text": "…我只告诉你一个人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            },
            {
              "text": "我们可以回避。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "…好吧，拜托你们了。"
        },
        {
          "role": "派蒙",
          "text": "夏沃蕾，注…注意安全啊。"
        },
        {
          "role": "夏沃蕾",
          "text": "你说吧。"
        },
        {
          "role": "巴蒂斯特",
          "text": "…你真的愿意相信我吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "我得听你说了才能做出判断。"
        },
        {
          "role": "巴蒂斯特",
          "text": "哈哈…好吧，那你听好了…"
        },
        {
          "role": "夏沃蕾",
          "text": "……"
        },
        {
          "role": "夏沃蕾",
          "text": "事情都串起来了。"
        },
        {
          "role": "巴蒂斯特",
          "text": "看来，你是相信我了。"
        },
        {
          "role": "夏沃蕾",
          "text": "你希望我公开事件的真相吗？"
        },
        {
          "role": "巴蒂斯特",
          "text": "不，当然不，至少不是现在…"
        },
        {
          "role": "夏沃蕾",
          "text": "那你为什么要告诉我？"
        },
        {
          "role": "巴蒂斯特",
          "text": "你读过我的小说，你觉得呢？"
        },
        {
          "role": "夏沃蕾",
          "text": "……"
        },
        {
          "role": "巴蒂斯特",
          "text": "就算你现在去向报社公开这段信息，得到的也只会是当事人的否认。"
        },
        {
          "role": "巴蒂斯特",
          "text": "事情过去太久…快二十年了。证据早已消散，就算曾有「孤岛」立于海面，现在也早已沉入深深的海底。"
        },
        {
          "role": "巴蒂斯特",
          "text": "「正义」，永远不会找上他的…"
        },
        {
          "role": "夏沃蕾",
          "text": "不试试怎么知道？"
        },
        {
          "role": "巴蒂斯特",
          "text": "我知道你作为特巡队队长，是站在「正义」的那边。"
        },
        {
          "role": "巴蒂斯特",
          "text": "但…你真的觉得牢狱之安是对他的「正义」吗？我打赌他能在梅洛彼得堡里活得很好。"
        },
        {
          "role": "夏沃蕾",
          "text": "你想说什么？"
        },
        {
          "role": "巴蒂斯特",
          "text": "我去过你们的拍摄片场，你演的铳枪手很帅气。"
        },
        {
          "role": "巴蒂斯特",
          "text": "对罪恶之人扣下正义的扳机。你不觉得这才是他应受到的裁决吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "…你想让我现在放了你，好去完成你的复仇。"
        },
        {
          "role": "巴蒂斯特",
          "text": "不，夏沃蕾警官。我知道这不可能。"
        },
        {
          "role": "巴蒂斯特",
          "text": "我希望你替我完成复仇。"
        },
        {
          "type": "subtitle",
          "text": "与此同时，在不远处…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "唔…夏沃蕾好慢啊，他们到底在聊什么？"
        },
        {
          "role": "派蒙",
          "text": "我好担心，她不会遇到什么危险吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "相信夏沃蕾的身手。",
              "dialogues": []
            },
            {
              "text": "遇到危险的可能是对方。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这…我倒是知道啦。"
        },
        {
          "role": "派蒙",
          "text": "你说，幕后黑手到底会是谁呢？那位作家为什么不愿意让我们听到？"
        },
        {
          "role": "夏沃蕾",
          "text": "旅行者，派蒙，让你们久等了。"
        },
        {
          "role": "派蒙",
          "text": "夏沃蕾！你们谈得怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "知道那位富人是谁了？",
              "dialogues": []
            },
            {
              "text": "我们接下来怎么做？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "我已经叫人将巴蒂斯特押送回警备处进行审问。后院如他所说，藏着作案的枪械。"
        },
        {
          "role": "派蒙",
          "text": "幕后黑手的名字呢？"
        },
        {
          "role": "夏沃蕾",
          "text": "他的确和我说了。不过，我现在得回特巡队继续处理。"
        },
        {
          "role": "旅行者",
          "text": "（怎么回事？感觉夏沃蕾有事瞒着我们。）"
        },
        {
          "role": "夏沃蕾",
          "text": "接下来几天我大概会忙于案件，不会来片场了。"
        },
        {
          "role": "派蒙",
          "text": "好吧，看来是不方便说呢，那我们会关注《蒸汽鸟报》的！"
        },
        {
          "role": "夏沃蕾",
          "text": "…事实上，我还有一件事想拜托二位。"
        }
      ]
    }
  ]
}