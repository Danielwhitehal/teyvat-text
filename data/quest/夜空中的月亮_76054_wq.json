{
  "quest_id": 76054,
  "chapter_num": null,
  "chapter_title": "夜空中的月亮",
  "type": "wq",
  "route": "The Moon Adorning the Night",
  "stories": [
    {
      "story_id": 76054,
      "title": "夜空中的月亮",
      "description": "在「银月之庭」，「少女」似乎遇到了一些困难…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同「少女」见面"
        },
        {
          "role": "派蒙",
          "text": "咦？哥伦比娅呢？怎么没见到她。"
        },
        {
          "role": "「少女」",
          "text": "我在这边。"
        },
        {
          "role": "派蒙",
          "text": "哇！你在这么高的地方做什么啦？"
        },
        {
          "role": "「少女」",
          "text": "上来。"
        },
        {
          "role": "派蒙",
          "text": "嗯？这次又是要干什么…"
        },
        {
          "role": "「少女」",
          "text": "还记得我们上次出去收集的石头吗？[[归家的微光]]"
        },
        {
          "role": "派蒙",
          "text": "上次？哦，是说吸收了月矩力后会发光的那种矿石对吧？"
        },
        {
          "role": "「少女」",
          "text": "对。那之后月灵们又收集了一些，我将这些石头处理了一下，大致分为了深色和浅色的两类。"
        },
        {
          "role": "派蒙",
          "text": "深色和浅色？为什么？"
        },
        {
          "role": "「少女」",
          "text": "当然是用来玩「月亮棋」呀。"
        },
        {
          "role": "派蒙",
          "text": "欸？什…什么是「月亮棋」…"
        },
        {
          "role": "「少女」",
          "text": "你们没玩过吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "这样吗…以前看「霜月之子」的孩子们在地上画格子的时候，我就想试试了。但没人能陪我玩。"
        },
        {
          "role": "派蒙",
          "text": "具体规则是什么呢？"
        },
        {
          "role": "「少女」",
          "text": "唔…这样说明容易些…"
        },
        {
          "type": "subtitle",
          "text": "「少女」在空中创造出了一个棋盘…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "哦！好…好厉害…你怎么做到的？"
        },
        {
          "role": "「少女」",
          "text": "嗯？就很简单地运用月矩力而已，你们做不到吗？"
        },
        {
          "role": "派蒙",
          "text": "不要以神明的标准来要求我们啦…"
        },
        {
          "role": "「少女」",
          "text": "好吧。这就是棋盘，或者说是游戏中的「夜空」。然后两个人手中的棋子代表了你所拥有的「月亮」。"
        },
        {
          "role": "「少女」",
          "text": "两人交替将「月亮」放到「夜空」上，谁的三个月亮最先连成一条线，谁就获胜了。"
        },
        {
          "role": "派蒙",
          "text": "哦！总之就是三颗棋子连成一条线的游戏对吧！"
        },
        {
          "role": "派蒙",
          "text": "这游戏在挪德卡莱居然叫「月亮棋」…还真是有本地特色呢…"
        },
        {
          "role": "「少女」",
          "text": "不过，「月亮」是会轮替的，天空中无法存在三个以上的「月亮」。"
        },
        {
          "role": "「少女」",
          "text": "所以当「夜空」中的「月亮」达到一定数量之后，最开始升上的「月亮」就会消失。"
        },
        {
          "role": "派蒙",
          "text": "还…还挺有道理…也给这游戏加了不少难度呢…"
        },
        {
          "role": "「少女」",
          "text": "嗯，要试试吗？我也是第一次玩。"
        },
        {
          "role": "旅行者",
          "text": "（她看起来很期待的样子呢…）"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，那我来给你们当裁判吧。这家伙脑子不错，你可要小心哟！"
        },
        {
          "role": "「少女」",
          "text": "好呀。"
        },
        {
          "type": "subtitle",
          "text": "同「少女」玩月亮棋"
        },
        {
          "type": "subtitle",
          "text": "折叠内容"
        },
        {
          "role": "将代表「月亮」的棋子放上棋盘，我方三个棋子连成一条线时，即为胜利。注意",
          "text": "任意一方的棋子大于三颗时，最先进入棋盘的棋子将会消失。"
        },
        {
          "type": "subtitle",
          "text": "长时间放置"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「少女」",
          "text": "不喜欢这个游戏吗？我觉得还挺有意思。"
        },
        {
          "role": "「少女」",
          "text": "忘了怎么将「月亮」放上「夜空」吗？要不要我帮你？"
        },
        {
          "role": "「少女」",
          "text": "原来你喜欢深思熟虑后再做决定，嗯，没事，我们有很多时间。"
        },
        {
          "type": "subtitle",
          "text": "长时间看向「少女」"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「少女」",
          "text": "我的脸上…有关于「月亮」的答案吗？"
        },
        {
          "role": "「少女」",
          "text": "嗯？你是在盯着我看吗？我感觉得到。"
        },
        {
          "role": "「少女」",
          "text": "棋盘在那边哦。"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「少女」",
          "text": "唔…"
        },
        {
          "role": "「少女」",
          "text": "月亮…月亮…"
        },
        {
          "role": "「少女」",
          "text": "这样对吗…？"
        },
        {
          "role": "「少女」",
          "text": "唔…我想想…"
        },
        {
          "role": "「少女」",
          "text": "这里怎么样？"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "平局"
        },
        {
          "role": "「少女」",
          "text": "是不是…快平手了？"
        },
        {
          "role": "「少女」",
          "text": "我们的月亮谁都不让谁呢。"
        },
        {
          "role": "「少女」",
          "text": "嗯…月升月落，真是漫长。"
        },
        {
          "type": "subtitle",
          "text": "玩家胜利"
        },
        {
          "role": "「少女」",
          "text": "啊…一不小心就…"
        },
        {
          "role": "「少女」",
          "text": "这片夜空属于你了。"
        },
        {
          "role": "「少女」",
          "text": "嗯，是你的「月亮」获胜了。"
        },
        {
          "type": "subtitle",
          "text": "「少女」胜利"
        },
        {
          "role": "「少女」",
          "text": "嗯，这样就赢了。"
        },
        {
          "role": "「少女」",
          "text": "我的三个月亮连起来了。"
        },
        {
          "role": "「少女」",
          "text": "这次是我赢了。"
        },
        {
          "type": "subtitle",
          "text": "与哥伦比娅在游戏中度过了一段愉快的时光…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「少女」",
          "text": "谢谢你，我玩得很开心。"
        },
        {
          "role": "「少女」",
          "text": "如果可以的话，下次也来陪我吧。"
        },
        {
          "role": "「少女」",
          "text": "把这个，当做「约定」的证明。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「少女」）"
        },
        {
          "role": "「少女」",
          "text": "三个月亮…"
        }
      ],
      "collapse_ranges": [
        [
          33,
