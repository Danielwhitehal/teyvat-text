{
  "quest_id": 22116,
  "chapter_num": null,
  "chapter_title": "这本小说会很厉害！",
  "type": "iq",
  "route": "A Novel Idea",
  "stories": [
    {
      "story_id": 22116,
      "title": "这本小说会很厉害！",
      "description": "常九爷又想要写一本新小说，但却苦于不知从何下笔，他现在急需找到灵感…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和常九爷对话"
        },
        {
          "role": "常九爷",
          "text": "到底怎么开头好…"
        },
        {
          "role": "旅行者",
          "text": "你又在做什么？"
        },
        {
          "role": "常九爷",
          "text": "哦，是你啊。我准备新写一本小说，但无论怎么开头，都觉得缺了点什么。"
        },
        {
          "role": "常九爷",
          "text": "我想了很久，还是一点头绪都没有，这么下去什么时候才能开始写啊…"
        },
        {
          "role": "常九爷",
          "text": "对了，我知道你是见多识广了。你觉得，一本成功的小说最需要的是什么？"
        },
        {
          "role": "旅行者",
          "text": "富有张力的热血战斗。"
        },
        {
          "role": "常九爷",
          "text": "热血战斗…热血战斗，嗯…有点道理，这东西最能吸引眼球了。"
        },
        {
          "role": "常九爷",
          "text": "不过，别说「富有张力的热血战斗」了，这轻策庄里连「战斗」都没有…"
        },
        {
          "role": "常九爷",
          "text": "看来我得出去取点材。对了！我听说…在野外有很多冒险家。"
        },
        {
          "role": "常九爷",
          "text": "为了寻宝，他们会到处跑，还经常和野外的那些怪物打起来。"
        },
        {
          "role": "常九爷",
          "text": "我刚好知道一个地方有很多怪物，而且那地方看起来嘛…也像模像样的，咱们就去那里等着！等着那些冒险家过来，和那些怪物好好打上一场。"
        },
        {
          "role": "常九爷",
          "text": "然后嘛，嘿嘿，这材料不就到手了。好了，那地方还有点远…我先过去了啊，你赶紧过来！"
        },
        {
          "role": "旅行者",
          "text": "深刻的浪漫剧情。"
        },
        {
          "role": "旅行者",
          "text": "心眼。"
        },
        {
          "role": "常九爷",
          "text": "你，你别和我开玩笑啊，我认真的，你好好想想，认真想！"
        },
        {
          "type": "subtitle",
          "text": "找到常九爷"
        },
        {
          "type": "subtitle",
          "text": "聆听志华与绮命的对话"
        },
        {
          "role": "常九爷",
          "text": "你还记得经常在码头上玩的那三个孩子吗？就是小蒙、璐璐和阿飞。"
        },
        {
          "role": "常九爷",
          "text": "虽然只是孩子，但他们之间也或多或少能找到点故事…"
        },
        {
          "role": "常九爷",
          "text": "你去帮我瞧瞧吧，如果有什么好材料，就记下来拿给我。"
        },
        {
          "role": "志华",
          "text": "那个，绮命姐姐，今天我…"
        },
        {
          "role": "绮命",
          "text": "今天不太适合。"
        },
        {
          "role": "志华",
          "text": "咦？可是我还什么都没说呢。"
        },
        {
          "role": "绮命",
          "text": "不用说，我也知道你要说什么，今天不太合适。"
        },
        {
          "role": "志华",
          "text": "那什么时候才合适，绮命姐姐，不然你…"
        },
        {
          "role": "绮命",
          "text": "哦，到了合适的那天，当然就会合适了。"
        },
        {
          "role": "志华",
          "text": "这不和什么都没说一样嘛！绮命姐姐，你就详细听我说说吧…"
        },
        {
          "role": "绮命",
          "text": "好了，下一位请过来。"
        },
        {
          "role": "志华",
          "text": "我还什么都没说啊！还有，哪里有下一位啊？！"
        },
        {
          "type": "subtitle",
          "text": "聆听思思与潮汐的对话"
        },
        {
          "role": "思思",
          "text": "汐哥哥，你…你回来了，我刚学会了一道菜，回去做给你吃吧？"
        },
        {
          "role": "潮汐",
          "text": "思妹妹，我刚回来，已经身心俱疲了，只想好好休息一下…"
        },
        {
          "role": "思思",
          "text": "对，是啊，你这么辛苦，是应该休息。"
        },
        {
          "role": "思思",
          "text": "那…等你休息好了，我们再好好聊聊？也该定个日子…"
        },
        {
          "role": "潮汐",
          "text": "嗯，嗯，我记得的，但我暂时还没有想好。并不是我不想负责，而是我不想辜负你…"
        },
        {
          "role": "潮汐",
          "text": "唉，与大海为伍是水手的宿命，思妹妹，你值得更好的人…"
        },
        {
          "role": "思思",
          "text": "汐哥哥，你别这么说，我知道的…"
        },
        {
          "type": "subtitle",
          "text": "聆听小蒙、阿飞与璐璐的对话"
        },
        {
          "role": "小蒙",
          "text": "璐璐，这次真的应该归阿飞做船长了。"
        },
        {
          "role": "阿飞",
          "text": "对呀，都说了多少次了，老是我来做服务生…"
        },
        {
          "role": "璐璐",
          "text": "可我觉得小蒙扮船长的时候，我们玩得最开心呀。"
        },
        {
          "role": "小蒙",
          "text": "璐璐，你不能这么说，阿飞也演得不错…"
        },
        {
          "role": "璐璐",
          "text": "对呀，没错，你扮船长的时候，我扮富商，阿飞扮服务生。"
        },
        {
          "role": "璐璐",
          "text": "这个时候，我们玩得是最开心的呀，对吧阿飞？"
        },
        {
          "role": "小蒙",
          "text": "璐璐，你…"
        },
        {
          "role": "阿飞",
          "text": "璐璐都这么说了，那…那也行吧。"
        },
        {
          "role": "小蒙",
          "text": "阿飞，你这又是…"
        },
        {
          "role": "阿飞",
          "text": "没事啦！没事了，璐璐开心就好了，我们继续来玩吧。"
        },
        {
          "role": "阿飞",
          "text": "不就是个船长吗，我才不稀罕呢。"
        },
        {
          "role": "小蒙",
          "text": "…你们，唉…"
        },
        {
          "type": "subtitle",
          "text": "击败所有魔物"
        },
        {
          "role": "常九爷",
          "text": "我上次去城里的时候，碰巧看见了一个人和一个似乎是在占卜的姑娘啰嗦个不停，但我那时候没有详细听下去…"
        },
        {
          "role": "常九爷",
          "text": "后来我打听到，这两个人一个叫志华，一个叫绮命，你去帮我再打听打听，如果有什么好故事，就快点拿回来给我吧。"
        },
        {
          "type": "subtitle",
          "text": "向常九爷回报"
        },
        {
          "role": "常九爷",
          "text": "怎么样，你有什么收获吗？"
        },
        {
          "role": "旅行者",
          "text": "记下来了这个。"
        },
        {
          "role": "常九爷",
          "text": "还真有收获，给我看看…志华和绮命，果然没错…"
        },
        {
          "role": "常九爷",
          "text": "嗯…不错，不错啊，这个不错！"
        },
        {
          "role": "旅行者",
          "text": "哪里不错了…"
        },
        {
          "role": "常九爷",
          "text": "你，你没看出来？没感觉到吗？你仔细看，这股隐隐约约，不足为外人道的微妙默契感？"
        },
        {
          "role": "常九爷",
          "text": "这个不错，我觉得我抓到点思路了…"
        },
        {
          "role": "常九爷",
          "text": "对了，这是给你的谢礼，收下吧，我得好好想一想怎么动笔了。"
        },
        {
          "role": "常九爷",
          "text": "怎么样，你有什么收获吗？"
        },
        {
          "role": "旅行者",
          "text": "记下来了这个。"
        },
        {
          "role": "常九爷",
          "text": "还真有收获，我看看啊…这潮汐，怎么感觉不太对劲啊，不对，应该说这两个人都不太对劲。"
        },
        {
          "role": "常九爷",
          "text": "这算得上「浪漫」吗？算了，就算不浪漫，也能算得上是剧情的一种吧。"
        },
        {
          "role": "常九爷",
          "text": "对了，这是给你的谢礼，谢谢你帮我取材，我得好好想一想该怎么动笔了。"
        },
        {
          "role": "常九爷",
          "text": "不过，这种剧情在小说里出现还行，要是在现实里出现的话…说不定最后会闹到找千岩军…"
        },
        {
          "role": "常九爷",
          "text": "这一对，总感觉会出什么问题啊…"
        },
        {
          "role": "常九爷",
          "text": "怎么样，你有什么收获吗？"
        },
        {
          "role": "旅行者",
          "text": "记下来了这个。"
        },
        {
          "role": "常九爷",
          "text": "还真有收获。嗯…不过，童言无忌，你也把这群孩子看得太早熟了，他们要是再长大点，说不定真会有些「浪漫」的感觉。"
        },
        {
          "role": "常九爷",
          "text": "不过，我就先收着吧，这也算是剧情的一种，即使不能直接拿来写浪漫的桥段，也是有点参考价值的。"
        },
        {
          "role": "常九爷",
          "text": "对了，这是给你的谢礼，谢谢你帮我取材啊，我得好好想一想怎么动笔了。"
        },
        {
          "type": "subtitle",
          "text": "与常九爷对话"
        },
        {
          "role": "常九爷",
          "text": "这么一说，你见过一个叫思思的姑娘吗？她似乎一直在等着一个叫做潮汐的水手。"
        },
        {
          "role": "常九爷",
          "text": "在我印象中，她好像隔段时间就要去等一次…这思思和潮汐之间，到底有什么故事呢？"
        },
        {
          "role": "常九爷",
          "text": "你去帮我看看吧，如果听到了什么好故事，就赶紧记下来，拿回来给我。"
        },
        {
          "role": "常九爷",
          "text": "嘿…这回，哎哟，这回我算是亲身体验了一把「富有张力的热血战斗」了…"
        },
        {
          "role": "旅行者",
          "text": "你不只是想旁观战斗吗？"
        },
        {
          "role": "常九爷",
          "text": "那是啊，我开始是这么想，但是谁叫冒险家迟迟就不出现呢？"
        },
        {
          "role": "常九爷",
          "text": "那些怪物慢慢悠悠，眼看着就要离开了，要是它们真走了，我不就白等了。"
        },
        {
          "role": "常九爷",
          "text": "然后我就…丢了块小石头过去，小说里不都这么写，丢块石头吸引住注意力什么的。"
        },
        {
          "role": "常九爷",
          "text": "谁，谁知道，我把石头给直接丢到那怪物头顶上去了，然后…就这样了嘛…"
        },
        {
          "role": "常九爷",
          "text": "哎呀，得了得了，虽然是吃了点皮肉苦，但是这材还是取到了嘛。"
        },
        {
          "role": "常九爷",
          "text": "我现在是才思泉涌！对了，这是给你的，多亏了你帮我，这些就算是谢礼吧。"
        },
        {
          "role": "常九爷",
          "text": "我感觉，一回去我就能马上动笔了！"
        },
        {
          "role": "常九爷",
          "text": "浪漫的剧情，这不是为难我嘛，我都不知道「浪漫」这俩字笔划有多少…"
        }
      ]
    }
  ]
}