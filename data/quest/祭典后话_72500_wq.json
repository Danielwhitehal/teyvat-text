{
  "quest_id": 72500,
  "chapter_num": null,
  "chapter_title": "祭典后话",
  "type": "wq",
  "route": "Festival Afterword",
  "stories": [
    {
      "story_id": 72500,
      "title": "祭典后话",
      "description": "结束表演之后，你发现阿守似乎很慌张，他遇到了什么麻烦吗...",
      "dialogues": [
        {
          "role": "阿守",
          "text": "出事了！"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "阿守",
          "text": "老大又进去了！"
        },
        {
          "role": "阿守",
          "text": "就在刚才，天领奉行派人过来，在留言板上贴了一张告示，说是要暂停我们的祭典。"
        },
        {
          "role": "阿守",
          "text": "不知道怎么回事，老大他好像把宣传广告发进了天守阁。"
        },
        {
          "role": "阿守",
          "text": "还说将军大人一定想要参加荒泷极上盛世豪鼓大祭典！"
        },
        {
          "role": "阿晃",
          "text": "欸？这么说的话，我觉得老大说的没错呀。我也觉得将军大人肯定想参加。"
        },
        {
          "role": "元太",
          "text": "对呀，难道你不是这么认为的吗？"
        },
        {
          "role": "阿守",
          "text": "哎呀，谁会管我们怎么觉得呀。"
        },
        {
          "role": "阿守",
          "text": "总之老大就是被看守的奥诘众当场抓获，送去了天领奉行。"
        },
        {
          "role": "旅行者",
          "text": "那要怎么办呢？"
        },
        {
          "role": "阿守",
          "text": "忍姐应该已经在处理了吧。"
        },
        {
          "role": "阿守",
          "text": "据说奥诘众对老大的指控是涉嫌扰乱军事禁区。"
        },
        {
          "role": "阿守",
          "text": "后来被九条裟罗大人改成了涉嫌妨碍公共秩序。"
        },
        {
          "role": "元太",
          "text": "呀呀呀呀呀，这个可恶的九条天狗，居然给老大定了这种重罪！"
        },
        {
          "role": "阿守",
          "text": "哎呀，你傻啦！这是变成了轻罪，一般在所里教育教育就好…"
        },
        {
          "role": "阿守",
          "text": "至于祭典这边，就只能等老大出来之后再说啦。"
        },
        {
          "role": "阿守",
          "text": "旅行者，您也不用担心，有忍姐在那边处理，肯定不会有大问题。"
        },
        {
          "role": "阿守",
          "text": "您对我们的祭典这么支持，等老大出来，他一定会来当面感谢你的！"
        },
        {
          "role": "阿守",
          "text": "希望您的旅途和我们的祭典一样，都能越来越好。"
        },
        {
          "role": "阿守",
          "text": "越来越好！！"
        }
      ]
    }
  ]
}