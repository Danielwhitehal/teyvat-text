{
  "quest_id": 76114,
  "chapter_num": null,
  "chapter_title": "形迹反常的隐士",
  "type": "wq",
  "route": "The Suspicious Hermit",
  "stories": [
    {
      "story_id": 76114,
      "title": "形迹反常的隐士",
      "description": "在伦波岛北部，空寂走廊东侧蛰居的隐者德文特，过去会定期来那夏镇拜访友人，但最近不必说到访那夏镇，就连登门拜访的客人也不接待，深居简出的他似乎在装扮和生活习惯上也有了不小的变化…另有一件值得在意的事，一名游商声称，会定期拜访隐者的游商伙伴，自最后一次拜访后便下落不明…要想探明真相，直接登门拜访或许是最好的选择。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往「秘闻馆」"
        },
        {
          "role": "雅珂达",
          "text": "这次要调查的是…「形迹反常的隐士」？"
        },
        {
          "role": "雅珂达",
          "text": "隐者什么的不是本来就是怪人那一类的吗？会住在那种荒山野岭的人不管做什么都不奇怪吧。"
        },
        {
          "role": "奈芙尔",
          "text": "但变化必然是有理由的，无论这理由出自内心还是来自外在。"
        },
        {
          "role": "奈芙尔",
          "text": "另外，失踪的游商也令人在意。"
        },
        {
          "role": "雅珂达",
          "text": "欸？可是那一片危险得很，这是众所周知的事，被强盗打劫、被魔物袭击…可能性太多啦。"
        },
        {
          "role": "奈芙尔",
          "text": "既然是众所周知的事，常在那片行走的游商自然是有对策的。"
        },
        {
          "role": "奈芙尔",
          "text": "尽管如此，老练的游商却下落不明，想必其中有未为人知的原因。"
        },
        {
          "role": "奈芙尔",
          "text": "雅珂达，这次就由你亲自拜访这位「形迹反常的隐士」吧。"
        },
        {
          "role": "奈芙尔",
          "text": "路途遥远，记得不要离开大路。"
        },
        {
          "role": "雅珂达",
          "text": "嗯？知道了，老板！这点小事你就放心交给我好啦。"
        },
        {
          "type": "subtitle",
          "text": "前往隐者小屋调查"
        },
        {
          "role": "雅珂达",
          "text": "您好——有人在吗——"
        },
        {
          "role": "雅珂达",
          "text": "德文特先生——您在家吗？"
        },
        {
          "role": "德文特",
          "text": "…是谁？"
        },
        {
          "role": "雅珂达",
          "text": "是「秘闻馆」的雅珂达，有些事想要问问您，所以特意来拜访。"
        },
        {
          "role": "德文特",
          "text": "…你就这么问吧。我病了，起不来。"
        },
        {
          "role": "雅珂达",
          "text": "（奇怪，之前听海螺帮的孩子们说，德文特先生教他们认字，说话温声细语…）"
        },
        {
          "role": "雅珂达",
          "text": "（现在听着声音沙哑，不过不像是病了，而像是原本就是这副嗓音…）"
        },
        {
          "role": "雅珂达",
          "text": "您没事吧？如果病得厉害，我可以去请医生…"
        },
        {
          "role": "德文特",
          "text": "…不用。过阵子就好了。"
        },
        {
          "role": "雅珂达",
          "text": "好吧，那等您恢复了再去那夏镇吧，您的朋友也很牵挂您呢。"
        },
        {
          "role": "德文特",
          "text": "……"
        },
        {
          "role": "雅珂达",
          "text": "（…他怎么不说话了？能听到屋里有人走动的声音，不过步子很沉…）"
        },
        {
          "role": "雅珂达",
          "text": "您最近好像都没怎么出门吧？"
        },
        {
          "role": "德文特",
          "text": "…是为了专心修行。"
        },
        {
          "role": "雅珂达",
          "text": "听说您近来的装扮也和过去不太一样，有人说完全没想到原来您那么健硕，之前穿隐者长袍的时候都没看出来。"
        },
        {
          "role": "雅珂达",
          "text": "呃，还有隔绝月矩力的面罩…是新的流行吗？"
        },
        {
          "role": "德文特",
          "text": "…是为了隔绝外界的杂音。"
        },
        {
          "role": "雅珂达",
          "text": "也是为了修行？"
        },
        {
          "role": "德文特",
          "text": "……"
        },
        {
          "role": "雅珂达",
          "text": "那前阵子拜访过您的游商，您知道他在那之后去哪儿了吗？"
        },
        {
          "role": "德文特",
          "text": "…不知道。"
        },
        {
          "role": "雅珂达",
          "text": "好、好吧…那我就先不打扰了。"
        },
        {
          "role": "雅珂达",
          "text": "（不知道为什么，有种继续问下去会很危险的感觉…）"
        },
        {
          "role": "雅珂达",
          "text": "（唔，他们说的没错，简直就像是换了个人…）"
        },
        {
          "role": "雅珂达",
          "text": "（收获太少了，也不能就这么回去面对奈姐啊，在附近再小心地调查一下吧。）"
        },
        {
          "type": "subtitle",
          "text": "在小屋周边寻找线索"
        },
        {
          "role": "雅珂达",
          "text": "（咦？这是…看起来像是没烧完的…）"
        },
        {
          "role": "雅珂达",
          "text": "（以前就听说德文特先生会收留受伤的冒险家之类的…这好像是最近发生的事。）"
        },
        {
          "role": "雅珂达",
          "text": "（为什么要把这些烧掉呢…）"
        },
        {
          "type": "subtitle",
          "text": "与屋内的人对话"
        },
        {
          "role": "雅珂达",
          "text": "（没有声音，他在休息吗？还是…）"
        }
      ]
    }
  ]
}