{
  "quest_id": 74144,
  "chapter_num": null,
  "chapter_title": "无格律自由诗",
  "type": "wq",
  "route": "Free Verse",
  "stories": [
    {
      "story_id": 74144,
      "title": "无格律自由诗",
      "description": "佩妮做了个梦，也不全是梦。",
      "dialogues": [
        {
          "role": "唐·西哈诺",
          "text": "你们升格成亲爱的朋友了，从你问出刚才那个问题的那刻起。"
        },
        {
          "role": "娜娜",
          "text": "我们去告诉佩妮这个好消息。"
        },
        {
          "role": "佩妮",
          "text": "要听明白别人真正想说的，不能用耳朵听，要用脑袋听哦。"
        },
        {
          "role": "佩妮",
          "text": "「狗儿欢笑，盘子跟着勺子跑。」"
        },
        {
          "role": "唐·西哈诺",
          "text": "呜——汪！"
        },
        {
          "role": "派蒙",
          "text": "有人在这里唱歌呢，我们要打个招呼吗？"
        },
        {
          "role": "旅行者",
          "text": "你好。"
        },
        {
          "role": "佩妮",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "是不是声音太小了…你好？"
        },
        {
          "role": "佩妮",
          "text": "…唔。"
        },
        {
          "role": "唐·西哈诺",
          "text": "喵喵，喵——喵。"
        },
        {
          "role": "娜娜",
          "text": "呜汪，汪。"
        },
        {
          "role": "佩妮",
          "text": "…好，好，我知道了。远来、远来的朋友们…你们好。"
        },
        {
          "role": "佩妮",
          "text": "…欢迎加入…我们、我们的宴席，请落座。"
        },
        {
          "role": "派蒙",
          "text": "唔，她看起来很害羞的样子，我们是不是吓到她了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "轻点声吧。",
              "dialogues": []
            },
            {
              "text": "小心说话吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，我明白你的意思，那我们就坐…欸，等一下，我没看到座位呀。"
        },
        {
          "role": "娜娜",
          "text": "汪，汪，汪。"
        },
        {
          "role": "唐·西哈诺",
          "text": "喵，喵喵喵喵，喵！"
        },
        {
          "role": "佩妮",
          "text": "啊没关系的，娜娜，不用了。"
        },
        {
          "role": "佩妮",
          "text": "西哈诺先生说的对，我们不要讨人厌的规矩，只要小饼干和肉骨头。"
        },
        {
          "role": "娜娜",
          "text": "汪…汪汪，汪汪——汪呜。"
        },
        {
          "role": "派蒙",
          "text": "嗯？你在和这条小狗说话吗？"
        },
        {
          "role": "佩妮",
          "text": "不是、不是小狗，是…是娜娜…女士。"
        },
        {
          "role": "佩妮",
          "text": "嗯总之，餐前致辞就到这里，现在该举杯了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我没看到杯子啊。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "其实我也没看到…这种时候大概只要附和就好了。"
                }
              ]
            },
            {
              "text": "让我们举起脑海中的杯子。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这是那种不管有多奇怪，反正照着做就对了的场合吗？你适应得好快。"
                },
                {
                  "role": "派蒙",
                  "text": "那…让我们举起脑海中的杯子！"
                }
              ]
            }
          ]
        },
        {
          "role": "佩妮",
          "text": "为所有的齿轮、铳枪还有算术本子干杯！"
        },
        {
          "role": "唐·西哈诺",
          "text": "喵！"
        },
        {
          "role": "娜娜",
          "text": "汪！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "喵！",
              "dialogues": []
            },
            {
              "text": "汪！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我也要喵或者汪吗？好、好吧…汪！"
        },
        {
          "role": "娜娜",
          "text": "呜汪！汪汪汪，汪！"
        },
        {
          "role": "派蒙",
          "text": "怎么了，难道我汪错了？…呃不，从刚开始就有哪里不对。"
        },
        {
          "role": "派蒙",
          "text": "有人能向我解释一下吗，他们又汪又喵的，到底在说些什么呀？"
        },
        {
          "role": "唐·西哈诺",
          "text": "喵，喵喵。"
        },
        {
          "role": "佩妮",
          "text": "唉，你说的对。作为宴席组织者，我没有考虑周到，这是我的问题，我应该先介绍自己的。"
        },
        {
          "role": "佩妮",
          "text": "佩妮，这是我的名字。这位戴黑帽子的毛毛先生，他叫唐·西哈诺，是一位剑客。"
        },
        {
          "role": "唐·西哈诺",
          "text": "喵。"
        },
        {
          "role": "佩妮",
          "text": "这是娜娜女士，她是一位特别优雅的淑女，很会关心人。"
        },
        {
          "role": "娜娜",
          "text": "嘤嘤，汪呜汪。汪汪。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是我的错觉吗？",
              "dialogues": []
            },
            {
              "text": "狗在说话？",
              "dialogues": []
            },
            {
              "text": "虽然也不是没见过，但…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你怎么发愣呀，该我们介绍自己了。这个孩子好像在和幻想出来的动物朋友说话，我们要不要配合一下？"
        },
        {
          "role": "佩妮",
          "text": "不不不，娜娜女士和西哈诺先生才不是幻想，他们本来就会说话。"
        },
        {
          "role": "派蒙",
          "text": "啊，说悄悄话被听到了。"
        },
        {
          "role": "佩妮",
          "text": "娜娜女士，你的事我可以告诉他们一点点吗？就一点点，不然他们听不懂你说的话。"
        },
        {
          "role": "娜娜",
          "text": "汪。"
        },
        {
          "role": "佩妮",
          "text": "嗯！娜娜女士是从枫丹廷来的，她有一个好听的姓氏，勒…"
        },
        {
          "role": "娜娜",
          "text": "呜…"
        },
        {
          "role": "佩妮",
          "text": "好娜娜，我不提那部分了，对不起，你不要伤心。"
        },
        {
          "role": "佩妮",
          "text": "我就只说开心的部分吧，娜娜最好最好的玩伴是紫眼睛的秋姐姐。"
        },
        {
          "role": "佩妮",
          "text": "秋姐姐是真正的淑女，她每天都会帮娜娜换好多套衣服。"
        },
        {
          "role": "佩妮",
          "text": "睡觉、三餐、茶歇、舞会、散步还有约会时，娜娜都要穿不同的裙子，配不同的首饰。"
        },
        {
          "role": "佩妮",
          "text": "后来，紫眼睛的秋姐姐离开了家，娜娜陪着她一起流浪到了这里，和我们成为了好朋友。"
        },
        {
          "role": "佩妮",
          "text": "然后，西哈诺先生，你介意吗？"
        },
        {
          "role": "唐·西哈诺",
          "text": "喵呜，喵。"
        },
        {
          "role": "佩妮",
          "text": "好吧，那我就只和他们说一点。"
        },
        {
          "role": "佩妮",
          "text": "对不起，到今天，西哈诺先生还在被执律庭通缉呢，为你们好，我也只说一点点。"
        },
        {
          "role": "佩妮",
          "text": "好几年前，西哈诺先生和他的伙伴们冒险的时候，啊，也就是我的鲁热哥哥、盲人弗里曼他们。"
        },
        {
          "role": "佩妮",
          "text": "他们被仇家雇佣的打手一路追到了白淞镇，吃的没有了，但那三个打手他们就是甩不掉。"
        },
        {
          "role": "佩妮",
          "text": "这时候，为了救他们，西哈诺先生冲了出来…你当时说了什么来着，西哈诺先生？"
        },
        {
          "role": "唐·西哈诺",
          "text": "…喵喵喵，喵喵。喵——喵，喵。"
        },
        {
          "role": "佩妮",
          "text": "对，他说：「我的好朋友们，我打心眼儿里喜欢你们。但是时候说再见了，我们在地下再会吧。」"
        },
        {
          "role": "佩妮",
          "text": "他以为自己回不来了，于是自己一只猫冲到前面，一口气击退了那三个坏蛋！"
        },
        {
          "role": "派蒙",
          "text": "哇，他的剑术一定很高超！"
        },
        {
          "role": "佩妮",
          "text": "哼哼，怎么样，听完之后你们还不相信吗？"
        },
        {
          "role": "佩妮",
          "text": "鲁热哥哥说过，要听明白别人真正想说的，不能用耳朵听，要用脑袋听。"
        },
        {
          "role": "佩妮",
          "text": "你们还是听不懂的话，就闭上眼睛吧，用脑袋听。"
        },
        {
          "role": "？？？",
          "text": "女孩的话充满了幻想，你觉得配合她一会儿倒没关系。"
        },
        {
          "role": "佩妮",
          "text": "你们多闭会儿，嗯…无聊的话，我唱歌给你们听吧，西哈诺先生和娜娜女士经常陪我唱这首歌。"
        },
        {
          "role": "佩妮",
          "text": "「喂喂，滴答滴。」"
        },
        {
          "role": "佩妮",
          "text": "「猫儿弹琴，鱼儿跃上月空。」"
        },
        {
          "role": "佩妮",
          "text": "「狗儿欢笑，盘子跟着勺子跑。」"
        },
        {
          "role": "？？？",
          "text": "听起来，女孩总是这样呆在河边唱歌，一只猫还有一只狗陪着她…"
        },
        {
          "role": "？？？",
          "text": "难怪他们如此熟悉，他们会说些什么呢…"
        },
        {
          "role": "？？？",
          "text": "你静静幻想了一会儿…"
        },
        {
          "role": "派蒙",
          "text": "唔，旅行者，我感觉没什么变化，要不我们试着去和猫和狗说话看看？"
        },
        {
          "type": "subtitle",
          "text": "尝试理解唐·西哈诺和娜娜的话"
        },
        {
          "role": "唐·西哈诺",
          "text": "喵，喵喵…喵呜。"
        },
        {
          "role": "派蒙",
          "text": "干嘛啦？他才不笨，不许说旅行者坏话。"
        },
        {
          "role": "旅行者",
          "text": "派蒙听懂了？"
        },
        {
          "role": "派蒙",
          "text": "对哦，我好像不费什么力气就听懂了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可能因为派蒙像个孩子吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "什么嘛，你就是想说我幼稚吧。"
                }
              ]
            },
            {
              "text": "派蒙变聪明了啊。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘿嘿，不愧是我…啊不对，我本来就很聪明，你是在怀疑我的智慧吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "娜娜",
          "text": "汪，嗷呜，汪汪汪。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能听懂了！",
              "dialogues": []
            },
            {
              "text": "你好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "娜娜",
          "text": "嗷呜，汪汪汪。"
        },
        {
          "role": "派蒙",
          "text": "你们怎么知道我们是从很远的地方来的，难道你们除了说话，还有占卜的能力？就像莫娜一样。"
        },
        {
          "role": "唐·西哈诺",
          "text": "喵呜——喵，咕噜，喵喵喵。"
        },
        {
          "role": "派蒙",
          "text": "哦。"
        },
        {
          "role": "旅行者",
          "text": "所以佩妮说的事情都是真的吗？"
        },
        {
          "role": "娜娜",
          "text": "嗷嗷嗷嗷呜，呜，汪汪汪，汪呜。"
        },
        {
          "role": "娜娜",
          "text": "嗷呜，我的老朋友们现在也还是会定期在德波大饭店聚会吧。"
        },
        {
          "role": "娜娜",
          "text": "呵呵，以前我总会陪秋去德波大饭店聚会、跳舞。"
        },
        {
          "role": "娜娜",
          "text": "一直跳到伴奏的乐队都犯困了也不停。"
        },
        {
          "role": "娜娜",
          "text": "你信也好，不信也好，对现在的我来说那只是回忆而已。"
        },
        {
          "role": "娜娜",
          "text": "现在，秋找到了她自己的使命，我找到了我的，我衷心希望秋幸福。"
        },
        {
          "role": "娜娜",
          "text": "而且鲁热接受了我，所以最后我还是选择留在这里。"
        },
        {
          "role": "派蒙",
          "text": "她完全沉浸在回忆里了。"
        },
        {
          "role": "派蒙",
          "text": "鲁热…这个名字佩妮刚才提到过，他是谁啊？"
        },
        {
          "role": "娜娜",
          "text": "他是个优雅的绅士。"
        },
        {
          "role": "唐·西哈诺",
          "text": "是佩妮的监护人，也是我们的朋友。"
        },
        {
          "role": "娜娜",
          "text": "很风趣。"
        },
        {
          "role": "唐·西哈诺",
          "text": "会用弓弩，也懂剑术，是个不错的年轻人。"
        },
        {
          "role": "娜娜",
          "text": "西哈诺，以后别干那么危险的事了，你会死的。"
        },
        {
          "role": "唐·西哈诺",
          "text": "别担心娜娜，有一个魔怪为我做过预言，我不会轻易死掉。"
        },
        {
          "role": "唐·西哈诺",
          "text": "预言说在我厌倦了冒险的时候，将会出现一位可敬可爱的小姑娘。"
        },
        {
          "role": "唐·西哈诺",
          "text": "我将在她身上找到我余生的目标，并把我的一切献给她，保护她不受伤害。"
        },
        {
          "role": "唐·西哈诺",
          "text": "那个孩子就是佩妮。但怎么样才能保护佩妮呢？"
        },
        {
          "role": "唐·西哈诺",
          "text": "如果我不是剑客，而是一名骑士，那我应该就懂了，可惜我不是。"
        },
        {
          "role": "派蒙",
          "text": "骑士？你面前就有一位骑士哦。旅行者可是蒙德西风骑士团的荣誉骑士呢。"
        },
        {
          "role": "唐·西哈诺",
          "text": "哦，天！我居然遇到了一位骑士！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么了吗？",
              "dialogues": []
            },
            {
              "text": "佩服我吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "唐·西哈诺",
          "text": "那我有一个不情之请…"
        },
        {
          "role": "娜娜",
          "text": "我猜我们想到一起去了。"
        },
        {
          "role": "派蒙",
          "text": "哼哼，传奇冒险家组合——旅行者与派蒙虽然无所不能，但我们的时间也很宝贵，而且要收费。"
        },
        {
          "role": "旅行者",
          "text": "有空的时候制定一个收费标准吧。"
        },
        {
          "role": "娜娜",
          "text": "我愿意用我所有的珠宝雇佣一名骑士，请你们…"
        },
        {
          "role": "唐·西哈诺",
          "text": "成为佩妮的朋友吧。"
        },
        {
          "role": "旅行者",
          "text": "嗯？"
        },
        {
          "role": "唐·西哈诺",
          "text": "亲爱的佩妮正站在十字路口上，她不知道该长大还是继续当孩子。"
        },
        {
          "role": "唐·西哈诺",
          "text": "她的身体正在长大，每天她都变得比昨天更大一点。"
        },
        {
          "role": "娜娜",
          "text": "她的心也在长大，每天都变得比昨天更复杂一点。"
        },
        {
          "role": "唐·西哈诺",
          "text": "一只猫和一条狗是不会明白人身上这些奇怪事的，但骑士应该可以。"
        },
        {
          "role": "娜娜",
          "text": "我们需要找到一位骑士来做佩妮的朋友，这样她就能得到答案。"
        },
        {
          "role": "旅行者",
          "text": "你们对佩妮很好。"
        },
        {
          "role": "唐·西哈诺",
          "text": "她是全世界最好的孩子。"
        },
        {
          "role": "娜娜",
          "text": "没有谁比我更爱她。"
        },
        {
          "role": "娜娜",
          "text": "请做佩妮的朋友吧，我愿意献出我所有的项链，还有缎子做的裙子。"
        },
        {
          "role": "唐·西哈诺",
          "text": "你会得到我的承诺。只要你需要，我愿意付出生命保护你。"
        },
        {
          "role": "唐·西哈诺",
          "text": "璃月的大商人贩卖的宝石价值无量，而唐·西哈诺的承诺远比它们更加珍贵。"
        },
        {
          "role": "旅行者",
          "text": "怎么成为她的朋友呢？"
        },
        {
          "role": "娜娜",
          "text": "你愿意？！"
        },
        {
          "role": "派蒙",
          "text": "还有我呢，我也愿意做小佩妮的朋友。"
        },
        {
          "role": "唐·西哈诺",
          "text": "亲爱的朋友们，从现在开始，你们不是远来的朋友了。"
        },
        {
          "role": "唐·西哈诺",
          "text": "你们升格成亲爱的朋友了，从你问出刚才那个问题的那刻起。"
        },
        {
          "role": "娜娜",
          "text": "太好了，太好了，让我们去告诉佩妮这个好消息。"
        },
        {
          "type": "subtitle",
          "text": "与佩妮对话"
        },
        {
          "role": "娜娜",
          "text": "佩妮亲爱的，你要有两个新朋友了。"
        },
        {
          "role": "唐·西哈诺",
          "text": "传奇冒险家组合——旅行者与派蒙愿意成为我们的朋友。"
        },
        {
          "role": "佩妮",
          "text": "真的吗？我有好多好多朋友了，太好了！"
        },
        {
          "role": "娜娜",
          "text": "让我们举办一个交朋友仪式。"
        },
        {
          "role": "唐·西哈诺",
          "text": "仪式需要一篇演讲稿，糟糕，我们没时间写了。"
        },
        {
          "role": "娜娜",
          "text": "别担心，简单点就好。"
        },
        {
          "role": "唐·西哈诺",
          "text": "好吧，那我简单喵两句，请站到我们面前来。"
        },
        {
          "role": "派蒙",
          "text": "这样就行吧。"
        },
        {
          "role": "唐·西哈诺",
          "text": "女士们先生们，我在此宣布——"
        },
        {
          "role": "唐·西哈诺",
          "text": "佩妮，也即「孩子们」、剑客唐·西哈诺、淑女娜娜之友，将与派蒙以及…"
        },
        {
          "role": "唐·西哈诺",
          "text": "等一下，我该怎么介绍你们？"
        },
        {
          "role": "派蒙",
          "text": "头衔吗？就称呼我是提瓦特最好的向导派蒙好了。"
        },
        {
          "role": "派蒙",
          "text": "他的话，就用蒙德西风骑士团荣誉骑士这个头衔吧，虽然其他的头衔也很气派。"
        },
        {
          "role": "佩妮",
          "text": "不不不，西哈诺先生不是在问这个。"
        },
        {
          "role": "娜娜",
          "text": "我们需要知道你们的朋友有什么人。"
        },
        {
          "role": "唐·西哈诺",
          "text": "我们所有人、猫还有狗，都是通过友谊联系在一起的。"
        },
        {
          "role": "娜娜",
          "text": "没有友谊…哦，那种生活太悲惨了，所以你们的朋友有些什么人？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有掌管一国的神明。",
              "dialogues": [
                {
                  "role": "唐·西哈诺",
                  "text": "很好，佩妮总是带好吃的来，她也是神，小饼干和肉骨头之神。"
                },
                {
                  "role": "娜娜",
                  "text": "那么亲爱的朋友们，从今天起你们的神明朋友又多了一个。"
                }
              ]
            },
            {
              "text": "有官员和有钱人。",
              "dialogues": [
                {
                  "role": "娜娜",
                  "text": "小可怜，你只有这种朋友吗？没关系，现在你有我们了。"
                }
              ]
            },
            {
              "text": "派蒙是我最好的朋友。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你也是派蒙最好的朋友！"
                },
                {
                  "role": "唐·西哈诺",
                  "text": "啊哈，你们是一对好朋友，太棒了！"
                },
                {
                  "role": "娜娜",
                  "text": "我看得出来，派蒙是个顶顶棒的好朋友。"
                }
              ]
            }
          ]
        },
        {
          "role": "唐·西哈诺",
          "text": "好，以所有的轴承、小蛋糕还有故事书的名义——"
        },
        {
          "role": "唐·西哈诺",
          "text": "佩妮，将与派蒙还有旅行者成为好朋友。"
        },
        {
          "role": "唐·西哈诺",
          "text": "你们将分享所有的肉骨头、小饼干还有画册，睡前互相说晚安。"
        },
        {
          "role": "娜娜",
          "text": "一起玩泥巴，一起吓唬小鸟，一起数星星。"
        },
        {
          "role": "佩妮",
          "text": "好耶！"
        },
        {
          "role": "派蒙",
          "text": "好耶！"
        },
        {
          "role": "旅行者",
          "text": "好耶！"
        },
        {
          "role": "佩妮",
          "text": "现在，我们所有人都是好朋友…啊不对，派蒙和旅行者还没有见过「孩子们」。"
        },
        {
          "role": "唐·西哈诺",
          "text": "天，我们差点把「孩子们」忘了。"
        },
        {
          "role": "娜娜",
          "text": "奇怪，今天一整天都没有见过他们。"
        },
        {
          "role": "佩妮",
          "text": "「孩子们」也是我们的好朋友，派蒙和旅行者应该见一见他们。"
        },
        {
          "role": "娜娜",
          "text": "说的对，请见一见「孩子们」，让他们知道你们是他们的新朋友。"
        },
        {
          "role": "唐·西哈诺",
          "text": "他们八成是游去远处玩了，这时候应该回来了，你们下水瞧瞧吧。"
        },
        {
          "role": "佩妮",
          "text": "下水去吧，别担心「孩子们」不肯回来，我唱一首歌送你们游。"
        },
        {
          "role": "佩妮",
          "text": "「孩子们」听到之后，就会回到他们的大贝壳里乖乖睡觉的，到大贝壳附近和他们说好梦吧。"
        },
        {
          "type": "subtitle",
          "text": "下水见见「孩子们」"
        },
        {
          "role": "「孩子们」",
          "text": "波噜波噜，佩妮在唱歌，波噜波噜。"
        },
        {
          "role": "派蒙",
          "text": "哦，佩妮说的「孩子们」原来是鱼呀！"
        },
        {
          "role": "派蒙",
          "text": "你们好呀，我们是佩妮的新朋友，派蒙和旅行者。"
        },
        {
          "role": "「孩子们」",
          "text": "波噜波噜，新朋友？新朋友…新朋友！"
        },
        {
          "role": "「孩子们」",
          "text": "波噜波噜，新朋友好梦！"
        },
        {
          "role": "派蒙",
          "text": "好梦。他们好像很开心呢，这样就算打完招呼了吧，我们去找下一处贝壳吧。"
        },
        {
          "type": "subtitle",
          "text": "下水见见「孩子们」"
        },
        {
          "role": "「孩子们」",
          "text": "波噜波噜，找不到，波噜波噜，找不到！"
        },
        {
          "role": "派蒙",
          "text": "你们好呀，我们是佩妮的新朋友，派蒙和旅行者。"
        },
        {
          "role": "「孩子们」",
          "text": "波噜波噜，新朋友！波噜波噜，老朋友，找不到！"
        },
        {
          "role": "「孩子们」",
          "text": "波噜波噜…佩妮在唱歌…波噜波噜…想睡觉…"
        },
        {
          "role": "派蒙",
          "text": "他们好像丢了什么东西？有点奇怪…不过这样就算打完招呼了吧，我们还是先去下一处贝壳好了。"
        },
        {
          "type": "subtitle",
          "text": "下水见见「孩子们」"
        },
        {
          "role": "派蒙",
          "text": "这里怎么什么都没有…「孩子们」去哪里了？"
        },
        {
          "role": "派蒙",
          "text": "欸，这是愚人众的徽记！"
        },
        {
          "role": "派蒙",
          "text": "「孩子们」不见了，贝壳里只有愚人众的徽记，这件事我们得赶快告诉佩妮！"
        },
        {
          "type": "subtitle",
          "text": "把情况告诉佩妮"
        },
        {
          "role": "派蒙",
          "text": "佩妮！刚才在水下，我们见到了「孩子们」。"
        },
        {
          "role": "佩妮",
          "text": "怎么样？你们成为好朋友了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "应该算是比较友好吧。",
              "dialogues": []
            },
            {
              "text": "我们已经是好朋友了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "听我说，佩妮，有一部分孩子不见了。"
        },
        {
          "role": "派蒙",
          "text": "我们在他们的摇篮里发现了这个，旅行者，我们把那个交给佩妮吧。"
        },
        {
          "role": "旅行者",
          "text": "这是愚人众的徽记。"
        },
        {
          "role": "佩妮",
          "text": "这是…！"
        },
        {
          "role": "派蒙",
          "text": "你可能不知道，愚人众是一群很坏很坏的人，那些孩子有可能是被愚人众掳走了。"
        },
        {
          "role": "派蒙",
          "text": "不过你不用担心，旅行者和我会帮忙的，因为我们已经是好朋友了。"
        },
        {
          "role": "唐·西哈诺",
          "text": "坏人？"
        },
        {
          "role": "佩妮",
          "text": "派蒙是在说基里克是坏人吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯？基里克？什么基里克…那是谁？"
        },
        {
          "role": "娜娜",
          "text": "基里克会陪佩妮一起唱歌，我曾经建议他去欧庇克莱歌剧院试试运气。"
        },
        {
          "role": "唐·西哈诺",
          "text": "他的嗓子确实不错。"
        },
        {
          "role": "娜娜",
          "text": "他还会下水陪「孩子们」玩。"
        },
        {
          "role": "唐·西哈诺",
          "text": "是的，基里克游泳很快，我很欣赏他。"
        },
        {
          "role": "派蒙",
          "text": "…唔，你们的意思是有个叫基里克的愚人众成员，是佩妮的朋友，这个徽记是他留下的吗？"
        },
        {
          "role": "佩妮",
          "text": "我想是的，这是基里克的东西，他是我们的好朋友。"
        },
        {
          "role": "派蒙",
          "text": "这样吗？…说不定是我们误会了。"
        },
        {
          "role": "佩妮",
          "text": "愚人众是什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是爱耍阴谋诡计的家伙们。",
              "dialogues": []
            },
            {
              "text": "是立场不同于大多数人的家伙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "愚人众的一些成员喜欢利用别人，会干很多坏事，我和旅行者被坑了好多次。"
        },
        {
          "role": "佩妮",
          "text": "所以基里克很坏很坏，有很多阴谋吗？"
        },
        {
          "role": "唐·西哈诺",
          "text": "我能闻得出坏蛋的味道，基里克身上并没有那种邪恶的气息。"
        },
        {
          "role": "娜娜",
          "text": "不过我们亲爱的朋友说他有可能是坏人…"
        },
        {
          "role": "娜娜",
          "text": "啊我明白了，可能基里克曾经是坏人，然后他又变成了好人。"
        },
        {
          "role": "唐·西哈诺",
          "text": "但也有这种可能性，他既是坏人也是好人。"
        },
        {
          "role": "娜娜",
          "text": "哦你说的没错，人可以既坏又好。"
        },
        {
          "role": "唐·西哈诺",
          "text": "就像人可以同时喜欢小蛋糕和生海鲜。"
        },
        {
          "role": "娜娜",
          "text": "生海鲜…呃，只有最坏最坏的人才吃那种东西。"
        },
        {
          "role": "唐·西哈诺",
          "text": "娜娜，其实生海鲜也不算很糟。"
        },
        {
          "role": "娜娜",
          "text": "不，我绝不吃生海鲜。"
        },
        {
          "role": "派蒙",
          "text": "好吧，既然「孩子们」没有被愚人众掳走，那他们去哪儿了呢…"
        },
        {
          "role": "唐·西哈诺",
          "text": "哦别担心，小捣蛋鬼们经常到处乱游，过一会儿他们就自己回来了。"
        },
        {
          "role": "娜娜",
          "text": "佩妮，你在想什么？怎么发起呆来了？"
        },
        {
          "role": "佩妮",
          "text": "好人和坏人…听起来很复杂，像算术。一个好人加上一个坏人，得到的结果是什么呢…"
        },
        {
          "role": "？？？",
          "text": "佩妮先是掰开手指，皱着眉头想了半天…毫无结果。"
        },
        {
          "role": "？？？",
          "text": "她又拿出了算术本子，用笔写写画画…依然毫无结果。"
        },
        {
          "role": "佩妮",
          "text": "啊，算不出来，我的算术还没学到这里，等秋姐姐回来，我应该就可以问她了。"
        },
        {
          "role": "唐·西哈诺",
          "text": "你需要向秋这样的大人学习，佩妮。大人知道这种问题的答案。"
        },
        {
          "role": "娜娜",
          "text": "我们又回到那个老问题去了，佩妮要不要长成大人。"
        },
        {
          "role": "唐·西哈诺",
          "text": "是的，这已经是我们第三十六次讨论这个问题了。"
        },
        {
          "role": "娜娜",
          "text": "我们有一张表，列举了所有做大人的好处和坏处，西哈诺，表在吗？"
        },
        {
          "role": "唐·西哈诺",
          "text": "放心，它在我的脑子里。"
        },
        {
          "role": "唐·西哈诺",
          "text": "第一个坏处：大人不能睡在丝绒垫子上，因为大人是非常坚硬的物种。"
        },
        {
          "role": "唐·西哈诺",
          "text": "他们必须睡在硬木头板子上，方便他们保持心灵和身体的坚硬。"
        },
        {
          "role": "娜娜",
          "text": "不可以睡在软和的垫子上真是太糟了。"
        },
        {
          "role": "唐·西哈诺",
          "text": "第二个坏处：大人不可以扑蝴蝶，这一点我倒是不明白为什么。"
        },
        {
          "role": "娜娜",
          "text": "我知道。我记得秋是怎么长大的。起初，路过小水坑时她不再去踩了。"
        },
        {
          "role": "娜娜",
          "text": "然后，她每次起床都不肯再光脚了，非得穿上小皮鞋不可。"
        },
        {
          "role": "娜娜",
          "text": "最后有一天我问她要不要一起扑蝴蝶，她拒绝了，抱起课本去了书房。"
        },
        {
          "role": "娜娜",
          "text": "她就是在那一刻长大的，我看到她「嘭」地一下，长成了大人。"
        },
        {
          "role": "娜娜",
          "text": "所以，我想，成为大人就意味着不可以扑蝴蝶。"
        },
        {
          "role": "佩妮",
          "text": "其实，不扑蝴蝶也没有关系，还有其他很多好玩的事可以做。"
        },
        {
          "role": "娜娜",
          "text": "哦，不止这些，亲爱的。在许许多多好玩的事里，你只能选一样。"
        },
        {
          "role": "娜娜",
          "text": "你忙着吃小饼干就没空翻开算术本子，拿起铳枪就不方便吃蛋糕。"
        },
        {
          "role": "佩妮",
          "text": "那这也太难过了，其他的轴承啊、弓箭啊、漂亮裙子啊，我都不能同时拥有了吗？"
        },
        {
          "role": "娜娜",
          "text": "不能，亲爱的。你只能选择一样，因为人类只有一生。"
        },
        {
          "role": "娜娜",
          "text": "而且，我和西哈诺也没法陪伴你了，佩妮。"
        },
        {
          "role": "佩妮",
          "text": "什么？你们不能和我一起长大吗？我怎么能没有你们呢？"
        },
        {
          "role": "佩妮",
          "text": "那每天早上谁来舔我的脸，晚上谁来和我说睡前故事呢？天，那我该怎么办…"
        },
        {
          "role": "娜娜",
          "text": "我可怜的佩妮，你知道我的使命就是爱你、保护你，不能和你一起长大我好难过。"
        },
        {
          "role": "派蒙",
          "text": "哎呀，不知道为什么，我也好想哭…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不要哭。",
              "dialogues": []
            },
            {
              "text": "长大不一定是坏事。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "唐·西哈诺",
          "text": "女士们，请别流泪了…我说真的，我最看不得眼泪了。"
        },
        {
          "role": "唐·西哈诺",
          "text": "要是我能用长剑把害你们流泪的东西刺穿，我一定立刻拔剑，可我…"
        },
        {
          "role": "唐·西哈诺",
          "text": "啊，我真受不了，真是受不了！我一定得做点什么！"
        },
        {
          "role": "唐·西哈诺",
          "text": "骑士先生，让我们想办法止住她们的眼泪吧！我们…"
        },
        {
          "role": "唐·西哈诺",
          "text": "我们…我们可以把「孩子们」找回来，让他们陪佩妮和娜娜一起唱歌，她们就会笑了！"
        },
        {
          "role": "唐·西哈诺",
          "text": "对！就这么干，来！到一边来，我们商量个办法。"
        },
        {
          "type": "subtitle",
          "text": "和唐·西哈诺商量"
        },
        {
          "type": "subtitle",
          "text": "和唐·西哈诺商量"
        },
        {
          "role": "唐·西哈诺",
          "text": "亲爱的朋友们，你们觉得这个主意怎么样？"
        },
        {
          "role": "派蒙",
          "text": "我们只要把「孩子们」找回来就好了吗？总觉得这样没法真正地解决什么…"
        },
        {
          "role": "旅行者",
          "text": "她最终还是要面对成长。"
        },
        {
          "role": "唐·西哈诺",
          "text": "我知道我知道，但是她这么犹豫，我们能不能晚点再让她长大呢。"
        },
        {
          "role": "唐·西哈诺",
          "text": "要是佩妮「嘭」地一下长大了，谁来挠我的下巴呢？晚上谁搂着我睡觉呢？"
        },
        {
          "role": "唐·西哈诺",
          "text": "不不不，再给她一点时间吧。"
        },
        {
          "role": "唐·西哈诺",
          "text": "作为佩妮亲爱的朋友，我此刻最该做的是止住她的眼泪，让她笑出来。"
        },
        {
          "role": "唐·西哈诺",
          "text": "娜娜女士的使命是爱佩妮，而我的使命是做佩妮的骑士，保护她不受伤害。"
        },
        {
          "role": "唐·西哈诺",
          "text": "啊我做得太糟糕了，我居然眼睁睁地看着佩妮哭！唉，要是我是真正的骑士就好了。"
        },
        {
          "role": "派蒙",
          "text": "我有点好奇，西哈诺为什么这么想当骑士呢？"
        },
        {
          "role": "唐·西哈诺",
          "text": "这是我的使命啊，朋友们，你们从没有被人赋予过使命吗？"
        },
        {
          "role": "唐·西哈诺",
          "text": "鲁热赋予了我这项伟大的使命，我发过誓，要好好保护佩妮。"
        },
        {
          "role": "唐·西哈诺",
          "text": "唐·西哈诺说到做到！我们不能再浪费时间了，得赶快行动起来。"
        },
        {
          "role": "派蒙",
          "text": "好，我也不希望看到我的朋友难过落泪。"
        },
        {
          "role": "旅行者",
          "text": "我愿意协助。"
        },
        {
          "role": "唐·西哈诺",
          "text": "很好，那么起床了，「孩子们」！"
        },
        {
          "role": "唐·西哈诺",
          "text": "听我说，「孩子们」，我们的佩妮遇到了前所未有的心灵危机！"
        },
        {
          "role": "唐·西哈诺",
          "text": "为了找回她的笑容，我们需要带回所有不见了的捣蛋鬼。"
        },
        {
          "role": "唐·西哈诺",
          "text": "然后一起为她唱歌，逗她开心，这是好朋友该做的，对不对？"
        },
        {
          "role": "「孩子们」",
          "text": "对！对！对！"
        },
        {
          "role": "唐·西哈诺",
          "text": "旅行者阁下，派蒙女士，说来惭愧…"
        },
        {
          "role": "唐·西哈诺",
          "text": "唐·西哈诺精通剑术和童话故事，是个响当当的好汉。可他…不擅长游泳。"
        },
        {
          "role": "唐·西哈诺",
          "text": "我可以把下水找回捣蛋鬼们这个伟大的使命交给你们吗？"
        },
        {
          "role": "派蒙",
          "text": "哈哈，小菜一碟。"
        },
        {
          "role": "旅行者",
          "text": "可以。"
        },
        {
          "role": "唐·西哈诺",
          "text": "「孩子们」，你们要好好帮新朋友们的忙，不可以调皮。"
        },
        {
          "role": "「孩子们」",
          "text": "知道，知道，知道！"
        },
        {
          "role": "「孩子们」",
          "text": "跟我们走，跟我们走，跟我们走！"
        },
        {
          "type": "subtitle",
          "text": "跟随孩子们"
        },
        {
          "role": "唐·西哈诺",
          "text": "佩妮要唱哪首呢？"
        },
        {
          "role": "佩妮",
          "text": "摇篮曲吧。"
        },
        {
          "role": "娜娜",
          "text": "啊，我喜欢摇篮曲。"
        },
        {
          "type": "subtitle",
          "text": "跟随孩子们"
        },
        {
          "type": "subtitle",
          "text": "救出捣蛋鬼"
        },
        {
          "type": "subtitle",
          "text": "跟随孩子们"
        },
        {
          "type": "subtitle",
          "text": "救出「大个头」"
        },
        {
          "type": "subtitle",
          "text": "跟随孩子们"
        },
        {
          "role": "「孩子们」",
          "text": "找到啦，找到啦，找到啦。"
        },
        {
          "role": "「孩子们」",
          "text": "调皮鬼们又在比赛，谁能抓住他们，谁就赢啦。"
        },
        {
          "role": "派蒙",
          "text": "你们的意思是说，这些游得飞快的蓝色鱼群就是我们要带回去的孩子吗？"
        },
        {
          "role": "「孩子们」",
          "text": "对，对，跟上他们，跟上他们，对他们说："
        },
        {
          "role": "「孩子们」",
          "text": "「抓住你啦！抓住你啦！抓住你啦！」"
        },
        {
          "role": "派蒙",
          "text": "好吧，帽子猫先生说的没错，还真是一群调皮捣蛋的孩子。"
        },
        {
          "type": "subtitle",
          "text": "抓住「调皮鬼」"
        },
        {
          "role": "娜娜",
          "text": "呜呜，我好难过，佩妮。"
        },
        {
          "role": "佩妮",
          "text": "好娜娜，我们不能一直哭。"
        },
        {
          "role": "唐·西哈诺",
          "text": "女士们，拿出勇气来。"
        },
        {
          "type": "subtitle",
          "text": "跟随孩子们"
        },
        {
          "role": "佩妮",
          "text": "娜娜，我好难过。"
        },
        {
          "role": "娜娜",
          "text": "不要伤心，佩妮，呜呜…"
        },
        {
          "type": "subtitle",
          "text": "救出「胆小鬼」"
        },
        {
          "type": "subtitle",
          "text": "返回佩妮身边"
        },
        {
          "role": "派蒙",
          "text": "大家，我们回来啦，所有的孩子们都回来了吗？"
        },
        {
          "role": "唐·西哈诺",
          "text": "是的，旅行者阁下，派蒙女士，他们都回来了。"
        },
        {
          "role": "「孩子们」",
          "text": "我们在，我们在，我们在。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "佩妮没有在哭了。",
              "dialogues": []
            },
            {
              "text": "佩妮还难过吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "佩妮",
          "text": "我早不哭啦，娜娜舔掉了我的眼泪，好娜娜，谢谢你。西哈诺，旅行者，派蒙，也谢谢你们。"
        },
        {
          "role": "娜娜",
          "text": "这是我该为你做的，毕竟爱你是我的使命。"
        },
        {
          "role": "唐·西哈诺",
          "text": "啊哈，我就知道，我们的佩妮足够勇敢，绝不会一直哭鼻子。"
        },
        {
          "role": "佩妮",
          "text": "其实…其实我也没那么勇敢，我还是有点害怕…还是有那么点想哭。"
        },
        {
          "role": "「孩子们」",
          "text": "没关系，别害怕！我们来唱歌吧！"
        },
        {
          "role": "「孩子们」",
          "text": "一起游一起唱，佩妮佩妮一起来！"
        },
        {
          "role": "唐·西哈诺",
          "text": "好主意，朋友们！这跨越了痛苦和悲伤的关头，理应高歌一曲！"
        },
        {
          "role": "「孩子们」",
          "text": "新朋友快过来，去爬上波浪的背，她会抱着你游。"
        },
        {
          "role": "娜娜",
          "text": "放心吧，朋友们，我们也会在岸上跟着你们。"
        },
        {
          "type": "subtitle",
          "text": "进入波浪之中"
        },
        {
          "role": "唐·西哈诺",
          "text": "高歌吧，朋友们！"
        },
        {
          "role": "佩妮",
          "text": "唱歌！"
        },
        {
          "role": "娜娜",
          "text": "我会和你们一起唱。"
        },
        {
          "type": "subtitle",
          "text": "进入波浪之中"
        },
        {
          "type": "subtitle",
          "text": "与佩妮对话"
        },
        {
          "role": "佩妮",
          "text": "游吧，往前游，飞吧，往上飞♪"
        },
        {
          "role": "佩妮",
          "text": "唱歌真好，我一点都不害怕啦。长大也没什么了不起的，长大就长大。"
        },
        {
          "role": "派蒙",
          "text": "这次游得真舒服，一点都不需要我们费力。最后被「大个头」喷出水面的时候我被吓了一跳呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还想来一次。",
              "dialogues": []
            },
            {
              "text": "我有点晕…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "唐·西哈诺",
          "text": "朋友们，能让你们一同露出微笑，唐·西哈诺心满意足了。"
        },
        {
          "role": "佩妮",
          "text": "我想明白了一件大事！下次看到鲁热哥哥，我得把这件事说给他听。"
        },
        {
          "role": "唐·西哈诺",
          "text": "我是你心里鲁热哥哥的影子，能陪伴你是我的荣幸，小姐。"
        },
        {
          "role": "佩妮",
          "text": "还有还有，等秋姐姐从枫丹廷回来，我也要和她说说旅行者和派蒙的事！"
        },
        {
          "role": "派蒙",
          "text": "佩妮和这个秋姐姐关系很好吗？"
        },
        {
          "role": "佩妮",
          "text": "秋姐姐对我顶顶好，她特意留下娜娜来照顾我，我最喜欢秋姐姐和娜娜了。"
        },
        {
          "role": "娜娜",
          "text": "我是你心里秋姐姐留下的香气，你的微笑就是我的幸福，甜心。"
        },
        {
          "role": "佩妮",
          "text": "嘭！"
        },
        {
          "role": "唐·西哈诺",
          "text": "娜娜，你听到什么了吗？刚才好像有什么东西「嘭」地响了。"
        },
        {
          "role": "娜娜",
          "text": "是的，我听到了。而且你发现了吗？佩妮的眼睛里有什么亮晶晶的东西。"
        },
        {
          "role": "佩妮",
          "text": "那是什么？"
        },
        {
          "role": "娜娜",
          "text": "是点亮所有黑暗角落的好奇目光，我亲爱的。"
        },
        {
          "role": "唐·西哈诺",
          "text": "以及一点点泪光，让你变得柔软。"
        },
        {
          "role": "娜娜",
          "text": "你已经带着我们的祝福长大了，好孩子。"
        },
        {
          "role": "派蒙",
          "text": "哎呀，但我们还没来得及祝福佩妮呢，她怎么就已经长大了？"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们赶快给佩妮补一个祝福吧。我祝…唔，祝佩妮天天都有好胃口！"
        },
        {
          "role": "旅行者",
          "text": "我是旅行者，我祝愿佩妮永远有探索世界的勇气。"
        },
        {
          "role": "佩妮",
          "text": "探索…世界…"
        },
        {
          "role": "佩妮",
          "text": "我决定了！"
        },
        {
          "role": "唐·西哈诺",
          "text": "你决定什么了，佩妮？"
        },
        {
          "role": "佩妮",
          "text": "我本来打算去枫丹廷做一个大人，但是现在我改主意了！我也要旅行，就像旅行者一样。"
        },
        {
          "role": "派蒙",
          "text": "佩妮的意思是想要做冒险家吗？"
        },
        {
          "role": "佩妮",
          "text": "对，旅行者和派蒙是冒险家，我要像你们一样旅行，就得成为冒险家。"
        },
        {
          "role": "旅行者",
          "text": "佩妮想要成为冒险家的话，得通过冒险家协会的考察。"
        },
        {
          "role": "派蒙",
          "text": "考察很难哦，而且冒险家的生活非常辛苦，没关系吗？"
        },
        {
          "role": "佩妮",
          "text": "没关系，我想试试！"
        },
        {
          "role": "旅行者",
          "text": "我帮佩妮写一封推荐信吧，作为祝贺你长大的礼物。"
        },
        {
          "role": "？？？",
          "text": "你借来佩妮的笔和纸，写好了一封简单的推荐信。"
        },
        {
          "role": "佩妮",
          "text": "太好了，谢谢你们！我好喜欢这个礼物，我也要给所有的朋友们送礼物！大家请过来一下…"
        },
        {
          "role": "？？？",
          "text": "佩妮蹦蹦跳跳地，带着微笑亲吻了帽子先生和裙子女士的额头…"
        },
        {
          "role": "？？？",
          "text": "然后是派蒙的侧脸，最后你弯下腰…"
        },
        {
          "role": "？？？",
          "text": "小佩妮高兴地亲吻了你的额头，你似乎感觉到她对未来既期待又不安的心情从额头处传来。"
        },
        {
          "role": "佩妮",
          "text": "亲爱的、最爱的好朋友们，我长大了，要成为冒险家了！"
        }
      ]
    }
  ]
}