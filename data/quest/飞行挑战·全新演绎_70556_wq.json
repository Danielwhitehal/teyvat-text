{
  "quest_id": 70556,
  "chapter_num": null,
  "chapter_title": "飞行挑战·全新演绎",
  "type": "wq",
  "route": "Gliding Challenge: New Heights",
  "stories": [
    {
      "story_id": 70556,
      "title": "飞行挑战·全新演绎",
      "description": "特别的欢迎仪式期间，安柏与后辈一同准备好了全新的飞行射击挑战，正等人们前来体验…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和安柏对话"
        },
        {
          "role": "安柏",
          "text": "你们来啦，旅行者和派蒙。"
        },
        {
          "role": "安柏",
          "text": "先认识一下新同事？这是第七小队的信号官耶嘉，还有她的搭档灰郁香。"
        },
        {
          "role": "耶嘉",
          "text": "初次见面，荣誉骑士和白色小帮手，向你们致以敬意。"
        },
        {
          "role": "耶嘉",
          "text": "灰郁香，来问好。"
        },
        {
          "role": "灰郁香",
          "text": "嘎啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "又一位信号官？",
              "dialogues": []
            },
            {
              "text": "是没听过的职位…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这只大大的鹰好听话欸！居然还穿着铠甲一样的衣服，还背着一个小包？"
        },
        {
          "role": "派蒙",
          "text": "等等，我有点迷糊了…安柏说的表演又是什么意思？"
        },
        {
          "role": "派蒙",
          "text": "和耶嘉小姐，还有这只鹰有关吗？"
        },
        {
          "role": "安柏",
          "text": "啊哈哈，我来简单解释一下。"
        },
        {
          "role": "安柏",
          "text": "琴团长应该和你说过，我们这边在举办风之翼竞速射击活动，没错吧？这是一种便于理解的说法…"
        },
        {
          "role": "安柏",
          "text": "其实，有可能不同于你们的预期，这次更像是一次「飞行表演与指挥挑战」。"
        },
        {
          "role": "安柏",
          "text": "核心不是传统的风之翼滑翔，而是从地面给灰郁香这样的空中单位发信，引导它进行各种复杂的行动，战胜魔物标靶…"
        },
        {
          "role": "安柏",
          "text": "算是一种新奇的体验，能给大家带来小小的惊喜！"
        },
        {
          "role": "灰郁香",
          "text": "嘎呜！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "从自己滑翔，改成指挥飞鹰？",
              "dialogues": []
            },
            {
              "text": "我们不上阵，坐镇发令就行？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "耶嘉",
          "text": "没错，这次飞行挑战也是一种技术演示，目标是向同僚们展现骑士团侦察力量的发展方向。"
        },
        {
          "role": "耶嘉",
          "text": "并非每位骑士都像安柏前辈这样，能在滑翔中准确捕捉敌情，并进行简明扼要的记录…"
        },
        {
          "role": "耶嘉",
          "text": "而我和灰郁香的使命，就是写好条令，让普通骑士与训练有素的蒙德鹰达成配合，运营一双「空中的眼睛」。"
        },
        {
          "role": "耶嘉",
          "text": "这样一来，就算没有强劲的侦察骑士，也能长时间探明敌情，稳定地向前行军。"
        },
        {
          "role": "耶嘉",
          "text": "甚至，通过灰郁香装备的前向武器，还能提前排除一些较为弱小的空中魔物。"
        },
        {
          "role": "派蒙",
          "text": "好…好专业的感觉？口吻有点像工程师！"
        },
        {
          "role": "安柏",
          "text": "放轻松，耶嘉，不用像面对[[芙蕾德莉卡]]阿姨那样严肃嘛。"
        },
        {
          "role": "安柏",
          "text": "荣誉骑士和派蒙，你们就当是和新认识的动物朋友一起游玩就好，开心最重要！"
        },
        {
          "role": "耶嘉",
          "text": "不好意思，前辈，我们只是有点…跃跃欲试。因为我和灰郁香一直在为这次演示反复练习。"
        },
        {
          "role": "耶嘉",
          "text": "如果能被荣誉骑士和白色小帮手认可，说明条令已经趋于完善，稍稍润色就能投入使用了。"
        },
        {
          "role": "耶嘉",
          "text": "当然，演示过程中可能出现一些机械故障…这都是因为之前训练的强度太高，耗尽了某些部件的使用寿命。"
        },
        {
          "role": "耶嘉",
          "text": "等到消耗性的部件到位，统统替换上去，灰郁香的背包在正式行动中就绝不会有差池，请别在意！"
        },
        {
          "role": "灰郁香",
          "text": "嘎嗷！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我会严格一些，但不至于苛责。",
              "dialogues": []
            },
            {
              "text": "没事，我不会乱挑毛病的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那，那我也要来好好试一试！"
        },
        {
          "role": "安柏",
          "text": "嘿嘿，听起来，你们四位都干劲满满啊，那就祝你们玩得开心啦！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（耶嘉）"
        },
        {
          "role": "耶嘉",
          "text": "荣誉骑士，耶嘉·格蕾特向您问好！我和灰郁香都做好准备了，飞行演示与指挥挑战随时可以开始。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就来吧！",
              "dialogues": [
                {
                  "role": "耶嘉",
                  "text": "收到！灰郁香，要加油哦，好好听荣誉骑士的指令。"
                },
                {
                  "role": "灰郁香",
                  "text": "嘎呀！"
                }
              ]
            },
            {
              "text": "说起来，飞鹰要怎么侦察？",
              "dialogues": [
                {
                  "role": "耶嘉",
                  "text": "您居然对技术原理感兴趣吗？那太好了！这个问题有点复杂，我尽量简单概括…"
                },
                {
                  "role": "灰郁香",
                  "text": "嘎哦！"
                },
                {
                  "role": "耶嘉",
                  "text": "为了实现空地通信，除了充分运用安柏前辈那无与伦比的侦察知识，我们还综合了四种技术——"
                },
                {
                  "role": "耶嘉",
                  "text": "蒙德的炼金器材、枫丹警卫机关的识别设备、璃月的俯瞰机关操纵理论，以及须弥的驯兽学。"
                },
                {
                  "role": "耶嘉",
                  "text": "灰郁香经受过特殊的伙伴训练，可以用不同的音调和动作，向背上的机关发送三十余种简单信号。"
                },
                {
                  "role": "耶嘉",
                  "text": "这个信号再经由频闪灯语转换为光信号，向地面回传情报，交给我这样的地面人员进行解读。"
                },
                {
                  "role": "耶嘉",
                  "text": "类似的运作方式，已在璃月的俯瞰机关上经过实战验证，被用于剿灭多支犯罪团伙与魔物集群，成熟而稳定。{{#info:[[「谛踪匿行」]]}}"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "好像听说过这事…",
                      "dialogues": []
                    },
                    {
                      "text": "居然还有这事？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "耶嘉",
                  "text": "据说不久后，挪德卡莱还要举行一届大型展会，璃月方面会展示更为先进的技术…我要好好观瞻学习！"
                },
                {
                  "role": "耶嘉",
                  "text": "当然，在此之前，灰郁香接受的飞行指令，也采用了相同的信号传输链——"
                },
                {
                  "role": "耶嘉",
                  "text": "地面发送特殊的频闪信号，背上的机关接受后，就能通过特定的音调，为灰郁香指明接下来的行动。"
                },
                {
                  "role": "耶嘉",
                  "text": "在能见度良好的情况下，从下令到灰郁香作出反应，只需要一秒以内。"
                },
                {
                  "role": "耶嘉",
                  "text": "如果收不到频闪信号，灰郁香就会根据记忆与直觉，主动向起飞点返航。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "灰郁香真聪明！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "灰郁香",
                  "text": "嘎呀！"
                },
                {
                  "role": "耶嘉",
                  "text": "确实，我还只有火花骑士那么高的时候，还只有我一半高的灰郁香，就成为我的邻居了。"
                },
                {
                  "role": "耶嘉",
                  "text": "当然，那本[[海妮耶]]小姐的著作《驯兽原理概论》，也发挥了至为重要的作用。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "海妮耶？这个名字有印象…",
                      "dialogues": []
                    },
                    {
                      "text": "这位好像有着特别的本领？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "耶嘉",
                  "text": "嗯，说不定您已经见过她了？我倒是只读过她写的著作，没能当面感谢她…"
                },
                {
                  "role": "耶嘉",
                  "text": "虽然只是少量发行的试印本，但其中与动物伙伴沟通的细节论述，让我获益匪浅。"
                },
                {
                  "role": "耶嘉",
                  "text": "可以说，要是没能在挪德卡莱的杂货摊里偶然找到她的著作…"
                },
                {
                  "role": "耶嘉",
                  "text": "通过空中平台进行侦察的设想，还需要好几年才能落地。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你和灰郁香的默契也很重要。",
                      "dialogues": []
                    },
                    {
                      "text": "你和灰郁香原本就是好搭档。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "耶嘉",
                  "text": "确实，像灰郁香这么乖巧懂事的猛禽可不好找。"
                },
                {
                  "role": "耶嘉",
                  "text": "这也是之后普及这类设备的难点之一。"
                },
                {
                  "role": "耶嘉",
                  "text": "不过，我愿意接受这项挑战，在恪守本职的同时，好好研修一番驯兽学。"
                },
                {
                  "role": "耶嘉",
                  "text": "说不定以后技术进步了，能让信号设备紧凑化，鸽子之类的鸟儿也能搭载它们，训练流程就能更加标准化。"
                },
                {
                  "role": "耶嘉",
                  "text": "请等着我的好消息吧，荣誉骑士！"
                }
              ]
            },
            {
              "text": "详细聊聊信号官的职务？",
              "dialogues": [
                {
                  "role": "耶嘉",
                  "text": "嗯…或许您已经接触过[[方妮雅]]前辈了？她是骑士团首批信号官中的代表。"
                },
                {
                  "role": "耶嘉",
                  "text": "借助奇妙的炼金装备和富有前瞻性的试验战法，方妮雅前辈确定了信号官的行动原则。"
                },
                {
                  "role": "耶嘉",
                  "text": "我接受的训练科目，基本都由副队长和最初的信号官莱奥诺拉两位长官领着方妮雅前辈拟定。"
                },
                {
                  "role": "耶嘉",
                  "text": "只不过，之前方妮雅前辈似乎遇到了什么麻烦，完成手册的编写后，她就暂时转为情报官了。{{#info:魔神任务间章第四幕[[悖理]]}}"
                },
                {
                  "role": "耶嘉",
                  "text": "我从荆夫港回来后，发现方妮雅前辈正在休长假，也没能见她一面…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "确实发生了一些事…",
                      "dialogues": []
                    },
                    {
                      "text": "我也不清楚发生了什么…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "耶嘉",
                  "text": "嗯…感觉背后的情况很复杂啊…但长官们没有下发事故报告，说明我这样的普通骑士不必知情，就不多想了。"
                },
                {
                  "role": "耶嘉",
                  "text": "以我对方妮雅前辈的了解，她应该很快就能振作起来的，过度担心反而是对她的不尊重。"
                },
                {
                  "role": "耶嘉",
                  "text": "我们继续正题？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "嗯，我还想了解更多。",
                      "dialogues": [
                        {
                          "role": "耶嘉",
                          "text": "好！让我想想…刚刚聊到了纸面上的行动逻辑，但在实践中，碰到了不少麻烦…"
                        },
                        {
                          "role": "耶嘉",
                          "text": "比如，回声或波束探测装置的操纵难度还是太高，保养起来也相当麻烦。"
                        },
                        {
                          "role": "耶嘉",
                          "text": "想在战场上进行维护，更是需要一整套技术人员的班底。"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "确实，毕竟是精密装置。",
                              "dialogues": []
                            },
                            {
                              "text": "也不是每个骑士都懂工程技术…",
                              "dialogues": []
                            }
                          ]
                        },
                        {
                          "role": "耶嘉",
                          "text": "没办法，这就是理论和应用的差别了。"
                        },
                        {
                          "role": "耶嘉",
                          "text": "将声学系统或炼金波束的装置部署到每个小组的成本实在太高，蒙德暂时还负担不起。"
                        },
                        {
                          "role": "耶嘉",
                          "text": "所以，目前我们选择了两条线路，一条是继续技术攻关。"
                        },
                        {
                          "role": "耶嘉",
                          "text": "另一条就是我所采用的，相对简化的光学层面侦察了。"
                        },
                        {
                          "role": "耶嘉",
                          "text": "璃月在这一方面有着丰富的经验，之后还要常去向[[苏定]]参谋的团队取经才好啊…"
                        }
                      ]
                    },
                    {
                      "text": "已经了解很多了，下次吧！",
                      "dialogues": [
                        {
                          "role": "耶嘉",
                          "text": "好，那先聊到这里！如果还想了解相关的技术知识，我或许可以给您写一份简述文件。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "过会儿再来…",
              "dialogues": [
                {
                  "role": "耶嘉",
                  "text": "请慢走，荣誉骑士，我和灰郁香随时等您检阅。"
                },
                {
                  "role": "灰郁香",
                  "text": "嘎呀！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          33,
          35
        ]
      ]
    }
  ]
}