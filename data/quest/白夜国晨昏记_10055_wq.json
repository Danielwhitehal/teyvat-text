{
  "quest_id": 10055,
  "chapter_num": "",
  "chapter_title": "白夜国晨昏记",
  "type": "wq",
  "route": "From Dusk to Dawn in Byakuyakoku",
  "stories": [
    {
      "story_id": 72177,
      "title": "龙蛇洞宫试炼记",
      "description": "为了财宝和海祇岛的未来，你接受了露子的委托，准备前往渊下宫…",
      "dialogues": [
        {
      "story_id": 72242,
      "title": "常世入口",
      "description": "穿越月浴之渊后，你来到了一片陌生的地方。这里没有文明的迹象，于是你准备深入调查…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆前往洞穴深处"
        },
        {
          "role": "派蒙",
          "text": "哦哦，走了这么久，终于有个像是文明遗迹的东西了。我们靠近看看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往前方建筑物处"
        },
        {
          "role": "派蒙",
          "text": "这个大门上的五个符文，似乎就是「键纹」的样式啊。"
        },
        {
          "role": "派蒙",
          "text": "我们去周围看看吧。根据长久以来的经验，应该又得做点什么才行。"
        },
        {
          "type": "subtitle",
          "text": "◆调查附近，寻找线索（5/5）"
        },
        {
          "type": "subtitle",
          "text": "◆调查机关，启动大门"
        },
        {
          "type": "subtitle",
          "text": "◆观察大门，寻找前进的方法"
        },
        {
          "role": "派蒙",
          "text": "似乎透过门能看到不一样的东西欸。是通道吗？引诱我们撞墙的陷阱？"
        },
        {
          "type": "subtitle",
          "text": "◆调查隐藏的通路"
        },
        {
          "role": "派蒙",
          "text": "居然真的有个通道。渊下宫好神奇。"
        },
        {
          "type": "subtitle",
          "text": "◆前往门扉"
        },
        {
          "role": "派蒙",
          "text": "看起来，这里就应该用上「月浴渊之钥」了。"
        },
        {
          "type": "subtitle",
          "text": "◆使用「月浴渊之钥」打开门扉"
        },
        {
          "type": "subtitle",
          "text": "◆打开门扉"
        },
        {
          "role": "派蒙",
          "text": "原来海祇岛下面有这么巨大的空间嘛！"
        },
        {
          "role": "派蒙",
          "text": "看起来，我们的目标应该就是中间那个地方了吧。"
        },
        {
          "role": "派蒙",
          "text": "好咧，旅行者，我们就稳步推进吧。"
        },
        {
          "role": "派蒙",
          "text": "那边的废墟看起来比较近，先从那块开始探索吧。"
        },
        {
          "role": "派蒙",
          "text": "有建筑物就说明曾经有人，有人的话就会留下那种纸条。"
        },
        {
          "role": "派蒙",
          "text": "纸多的地方最容易找到根本看不懂的提示了。"
        }
      ]
    },
        {
          "type": "subtitle",
          "text": "◆前往前方的遗迹处"
        },
        {
          "type": "subtitle",
          "text": "◆调查前方的遗迹"
        },
        {
          "role": "派蒙",
          "text": "啊，是深渊教团。他们就是露子提到的那些溜下来的家伙吗？"
        },
        {
          "role": "派蒙",
          "text": "这些丘丘人应该也是深渊教团带下来的吧。"
        },
        {
          "role": "派蒙",
          "text": "之前在蒙德似乎见过深渊法师凭空搬来个丘丘人的技法来着。"
        },
        {
          "type": "subtitle",
          "text": "◆打倒出现的敌人"
        },
        {
          "type": "subtitle",
          "text": "◆调查机关，解开大门"
        },
        {
          "type": "subtitle",
          "text": "◆前往遗迹内部"
        },
        {
          "role": "派蒙",
          "text": "楼上居然有人！"
        },
        {
          "type": "subtitle",
          "text": "◆与二层的人对话"
        },
        {
          "role": "？？？",
          "text": "哎呀，你们是偷偷溜进来的…"
        },
        {
          "role": "？？？",
          "text": "——看起来不是啊。所以你们两个就是这次的摘珊瑚勇者吗？"
        },
        {
          "role": "派蒙",
          "text": "两个！你也算上我了！"
        },
        {
          "role": "？？？",
          "text": "哈哈，我原本是想珊瑚宫再怎么人手紧张，也不至于只派一个人下来吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "未拿到御辔时",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "超出我的预期了，可以说是。居然有两个人。"
                }
              ]
            },
            {
              "text": "先去后山拿到御辔时",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "超出预期了，可以说是。居然有两个人。"
                }
              ]
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我很能打的。",
              "dialogues": []
            },
            {
              "text": "两个人就够了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "你这种乐观与自信的精神我很欣赏咧。"
        },
        {
          "role": "？？？",
          "text": "不过我还是希望你们能算上我。我们三个人一定会配合得很好的。"
        },
        {
          "role": "？？？",
          "text": "自我介绍一下，我是前来帮忙的调查研究人员。我叫渊上。"
        },
        {
          "role": "渊上",
          "text": "主要负责过来整理翻译试炼的线索，给勇者提供下一步的指引。"
        },
        {
          "role": "派蒙",
          "text": "哦哦，那太好了。以前在其他地方，各种看不懂的谜语都得靠我们自己猜。"
        },
        {
          "role": "渊上",
          "text": "哈哈哈，那说不定你们其实比我更加专业咧。毕竟，我只是个读书的人。"
        },
        {
          "role": "旅行者",
          "text": "但是露子说过…"
        },
        {
          "role": "渊上",
          "text": "露子是…啊，对，露子嘛。她没和你们说过会有文员来支援勇者的事情吗？"
        },
        {
          "role": "派蒙",
          "text": "好像是有这么回事来着？"
        },
        {
          "role": "渊上",
          "text": "这就对了。让你们重新学白夜国文字太耗费时间了吧。你想想，是不是也太强人所难了？"
        },
        {
          "role": "渊上",
          "text": "所以就有了我来提前翻译文书和提示。你们有什么想问的吗？"
        },
        {
          "role": "旅行者",
          "text": "关于中央的那个高塔…"
        },
        {
          "role": "渊上",
          "text": "那座高塔是试练的核心，是名叫「大日御舆」的建筑。意思是太阳之车。"
        },
        {
          "role": "渊上",
          "text": "不过现在它应该是有一层屏障守护的。虽然以前的功能是保护民众，但是现在不解除就进不去内部。"
        },
        {
          "role": "渊上",
          "text": "我看你似乎有些想问的。我马上就告诉你破解这个屏障的方法。"
        },
        {
          "role": "渊上",
          "text": "首先你需要找到一个东西，叫做「御辔」。它根据文献描述似乎是不到一抱大小的装置。"
        },
        {
          "role": "派蒙",
          "text": "原来不是什么缰绳吗？"
        },
        {
          "role": "渊上",
          "text": "它的名字只是取自白夜国的传说啦。太阳与月亮都是神明的马车运送的。"
        },
        {
          "role": "渊上",
          "text": "而「御辔」则是白夜国曾经的传国之宝。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "白夜国的…",
              "dialogues": []
            },
            {
              "text": "…传国之宝？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "渊上",
          "text": "没错，白夜国。这片土地真正的名字。幽冥的无光世界。<ruby> 常夜 <rp>(</rp><rt> 常世 </rt><rp>)</rp></ruby>中，罪孽积堆又被涤净之后的真色——白夜之国。"
        },
        {
          "role": "渊上",
          "text": "话说回试炼。白夜国民被大蛇海祇所救，终于可以重见天光了。他们全部搬到了海渊之上。"
        },
        {
          "role": "渊上",
          "text": "哎哟，这不就是咱家的姓氏吗？"
        },
        {
          "role": "旅行者",
          "text": "哈哈哈…"
        },
        {
          "role": "渊上",
          "text": "最后离开白夜国之时，海祇之民封存了全境的所有设施。而此处正如两位所见，是其中的一处。这里是白夜国的图书馆。"
        },
        {
          "role": "渊上",
          "text": "而为了方便后来人之试炼，「御辔」也被安放于附近。正在图书馆的后山里。"
        },
        {
          "role": "渊上",
          "text": "两位，找到这个「御辔」正是试炼的第一环哦。图书馆里的试炼指引正是这么说的。"
        },
        {
          "role": "旅行者",
          "text": "为什么你会比我们先出现在这里？"
        },
        {
          "role": "渊上",
          "text": "这个嘛。因为你们是勇者，走的是唤醒试炼的正门。而我们这些提供支援的人还是有自己的、字面意思的旁门左道能进来的。"
        },
        {
          "role": "渊上",
          "text": "一般人就算溜进来也没什么用处。如果不使用「月浴渊之钥」开门，有关试炼的一切都是不会被激活的。"
        },
        {
          "role": "渊上",
          "text": "同时，一般人也无法读懂白夜国的文字。所以无法获得试炼的线索。"
        },
        {
          "role": "渊上",
          "text": "没有御辔，就无法了解渊下宫在白夜之外、常夜之下的秘密。"
        },
        {
          "role": "渊上",
          "text": "如果你们真的这么不放心我，我给你们揍一顿好啦。不过揍完麻烦不要把我扛回上面，谢谢。"
        },
        {
          "role": "渊上",
          "text": "如你所见，我只是一个有些求知欲的读书人而已。我一定要在白夜国找到那卷文献。"
        },
        {
          "role": "派蒙",
          "text": "他都说到这个份上了…而且好像他也没有要骗我们的意思。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我觉得可以相信他这一次？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "未拿到御辔时",
              "dialogues": [
                {
                  "role": "渊上",
                  "text": "哈哈，谢谢你的信任。那，试炼的指引我也已经说了。请您去后山寻找御辔吧。"
                },
                {
                  "role": "渊上",
                  "text": "哦，对了。背后这张图我觉得应该和渊下宫的地形是相匹配的。建议你出门前好好研究一下这个地图。"
                }
              ]
            },
            {
              "text": "先去后山拿到御辔时",
              "dialogues": [
                {
                  "role": "渊上",
                  "text": "哈哈，谢谢你的信任。那，请您去后山寻找御辔吧。"
                },
                {
                  "role": "旅行者",
                  "text": "是这个吗？"
                },
                {
                  "role": "渊上",
                  "text": "啊，没错。就是这个。你们，说不定很有当勇者的天赋啊。（接下来的对话直接跳到：书上传说，工匠「『阿倍良久』之命」…）"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "渊上",
          "text": "关于御辔，有什么头绪了吗？"
        },
        {
          "role": "渊上",
          "text": "我一进图书馆就看到最醒目的位置摆着一个小册子。里面用古代语言写着试炼的提示。御辔应该就在图书馆的后山里。"
        },
        {
          "type": "subtitle",
          "text": "◆前往图书馆后山，寻找御辔"
        },
        {
          "role": "派蒙",
          "text": "这个就是所谓的试炼谜题了吧。"
        },
        {
          "role": "派蒙",
          "text": "我们找找看附近的线索吧。"
        },
        {
          "type": "subtitle",
          "text": "◆调查后山，解开谜题"
        },
        {
          "type": "subtitle",
          "text": "◆取得御辔"
        },
        {
          "role": "派蒙",
          "text": "这个就是「御辔」吗？唔，拿给那个叫渊上的家伙看看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往图书馆，与渊上对话"
        },
        {
          "role": "渊上",
          "text": "关于御辔，有什么头绪了吗？"
        },
        {
          "role": "旅行者",
          "text": "是这个吗？"
        },
        {
          "role": "渊上",
          "text": "没错，就是这个。这可真是太巧了。"
        },
        {
          "role": "渊上",
          "text": "书上传说，工匠「『<ruby> 阿倍良久 <rp>(</rp><rt> 阿布拉克 </rt><rp>)</rp></ruby>』之命」奉命建造了太阳之车，终于为常夜带来了光明。"
        },
        {
          "role": "渊上",
          "text": "在之前的常夜里，人们一直生活在恐惧中。黑暗中狩猎的深海龙蜥才是这片土地原本的霸王。"
        },
        {
          "role": "旅行者",
          "text": "深海龙蜥？"
        },
        {
          "role": "渊上",
          "text": "深海龙蜥，纯粹而且原始的元素生物。没有被众魔神与执政调伏的山精野怪之群。"
        },
        {
          "role": "渊上",
          "text": "在珊瑚宫的「龙蛇斗」传统故事里，也会被叫做深海龙嗣。"
        },
        {
          "role": "渊上",
          "text": "人们最开始会点起千灯驱散黑暗，但终究收效甚微。直到大日御舆落成，白夜驱散了常世之暗，人们才得以喘息并繁衍生息。"
        },
        {
          "role": "渊上",
          "text": "大日御舆甚至可以展开屏障，集中保护白夜国民。而有了这个的话，应该就可以解开大日御舆的屏障了。"
        },
        {
          "role": "渊上",
          "text": "我来为你激活它。根据书上说的，应该这样，这样…嗯，再这样。好咧。"
        },
        {
          "role": "渊上",
          "text": "这样御辔就算是激活了。拿它去号令大日御舆，解除屏障应该不在话下。"
        },
        {
          "role": "渊上",
          "text": "不过这么有仪式感的事情，我们还是去大日御舆最外围的正门那里办吧。"
        },
        {
          "role": "渊上",
          "text": "大日御舆的正门就在它那块区域的东南方，绕着屏障走总能看到的。"
        },
        {
          "type": "subtitle",
          "text": "渊上给你详细描述了约定的地方在哪里。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "…根本不考虑你听不听得懂…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "渊上",
          "text": "渊下宫四周都是万丈深渊，掉下去感觉数到一百都不一定能到底。你过去的路上要千万注意啊。"
        },
        {
          "role": "渊上",
          "text": "反正，就像是我刚才说的。如果找不到了，就绕着屏障走吧，总会找到我的。"
        },
        {
          "role": "渊上",
          "text": "我在这里也调查得差不多了，并没有我想要的东西。所以我先去那里等你了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "与渊上对话前未拿到御辔，而正常进行任务时",
              "dialogues": []
            },
            {
              "text": "与渊上对话前先去后山拿到御辔，而跳任务阶段时",
              "dialogues": [
                {
                  "role": "渊上",
                  "text": "哦，对了。背后这张图我觉得应该和渊下宫的地形是相匹配的。建议你出门前好好研究一下这个地图。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "渊上这家伙是怎么回事，怎么一个人就先跑了？"
        },
        {
          "role": "派蒙",
          "text": "虽说现在渊下宫应该已经空了，但是他行动也太不谨慎了吧。"
        },
        {
          "role": "派蒙",
          "text": "这家伙还是有点可疑。"
        },
        {
          "type": "subtitle",
          "text": "◆依照渊上的指引，向前探索"
        },
        {
          "type": "subtitle",
          "text": "◆前往大日御舆前的断桥处"
        },
        {
          "type": "subtitle",
          "text": "◆与渊上对话"
        },
        {
          "role": "渊上",
          "text": "哦哦，你们来了。请由我来代劳，为你解除屏障吧。能请你把御辔先交给我吗？"
        },
        {
          "role": "旅行者",
          "text": "（突然有些犹豫…）"
        },
        {
          "role": "渊上",
          "text": "怎么了，你们还是对我不放心吗？"
        },
        {
          "role": "派蒙",
          "text": "这个嘛…渊上你行动力是不是太强了。"
        },
        {
          "role": "渊上",
          "text": "伤我心了啊，朋友。不过也不怪你们就是了，一个文献研究人员开心地四处跑跑跳跳确实还挺少见的。"
        },
        {
          "role": "渊上",
          "text": "不过我之前也没骗你吧？"
        },
        {
          "role": "派蒙",
          "text": "唔…确实没有你指引，我们也找不到御辔。"
        },
        {
          "role": "渊上",
          "text": "尽管这话说着听起来太像是反派了，但我还是得说：现在也只有我能帮助你们了。"
        },
        {
          "role": "渊上",
          "text": "你把剑架在我脖子上也行，或者上次没揍我，这次想揍我一顿也行。"
        },
        {
          "role": "渊上",
          "text": "揍完之后请你相信我。不这样的话，我们都无法进入大日御舆内部。"
        },
        {
          "role": "派蒙",
          "text": "你是有什么喜欢挨揍的癖好吗？！"
        },
        {
          "role": "派蒙",
          "text": "我才不会做到这一步啦！旅行者，你觉得呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（捋起袖子。）",
              "dialogues": [
                {
                  "role": "渊上",
                  "text": "喂喂喂，你等等你等等。你是在开玩笑对吧！我可怕疼了！"
                },
                {
                  "role": "派蒙",
                  "text": "不要吓唬他啦。旅行者，还是把御辔交给他吧。"
                }
              ]
            },
            {
              "text": "（交出御辔。）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "渊上",
          "text": "嗯，那就由我来代劳，为你解除屏障吧。你可以站远一点。"
        },
        {
          "role": "渊上",
          "text": "毕竟我也是第一次干这种事，万一解开瞬间发生什么事情就不好了。"
        },
        {
          "role": "派蒙",
          "text": "比如说？"
        },
        {
          "role": "渊上",
          "text": "比如说解除瞬间的冲击把你撞倒到无底深渊里了，或者不新鲜的空气让人一下子无法呼吸了，又或者守护巨龙突然出现…"
        },
        {
          "role": "渊上",
          "text": "再或者我突然被诅咒，变成了操纵火元素的怪物。"
        },
        {
          "role": "派蒙",
          "text": "呜啊，好可怕。"
        },
        {
          "type": "subtitle",
          "text": "过场动画：解开封印",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "渊上",
          "text": "哇，生平第一次解除古迹封印，还挺刺激的。"
        },
        {
          "role": "渊上",
          "text": "看着这么大的墙壁消失，还真有种一把火烧了大图书馆的愉悦感。"
        },
        {
          "role": "派蒙",
          "text": "你这话好危险。你真的是研究调查人员吗？"
        },
        {
          "role": "渊上",
          "text": "啊哈哈，当然是了。我都迫不及待想要调查大日御舆内部了。有没有什么绝本的古籍呢？"
        },
        {
          "role": "渊上",
          "text": "那么我先走一步。你们有什么想搜刮的宝物就请随意吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往大日御舆"
        },
        {
          "role": "渊上",
          "text": "喂，这里这里。快来快来！"
        },
        {
          "role": "派蒙",
          "text": "是渊上在上面喊我们。"
        },
        {
          "type": "subtitle",
          "text": "◆调查机关"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "渊上",
          "text": "我正等你们呢。"
        },
        {
          "role": "渊上",
          "text": "你现在掌握了渊下宫…不，白夜国的中枢。你可以试试碰一下这个机关。"
        },
        {
          "role": "渊上",
          "text": "我猜测一定会是一次了不得的体验。"
        },
        {
          "type": "subtitle",
          "text": "启动机关",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "过场动画：昼夜转换",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "渊上",
          "text": "噫——鬼、鬼啊！"
        },
        {
          "role": "派蒙",
          "text": "唔哇！"
        },
        {
          "role": "派蒙",
          "text": "没有被这个幽灵样的家伙吓到，反而被渊上吓到了。"
        },
        {
          "role": "渊上",
          "text": "咳咳，丢人了。我、我已经反应过来了。"
        },
        {
          "role": "渊上",
          "text": "白、白夜国因为其幽冥之特性…会、会出现过去残念的投影。"
        },
        {
          "role": "渊上",
          "text": "虽然他们的故事已经结束，但是他们那一刻的人格被保留了下来。甚至能面对你做出反应。"
        },
        {
          "role": "渊上",
          "text": "这种过于强烈的情绪，会被认为是「常世之罪」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「强烈的情绪」…",
              "dialogues": []
            },
            {
              "text": "「罪」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "渊上",
          "text": "因此这个奇特的地脉现象会被叫做「罪影」，或者「常世之灵」。"
        },
        {
          "role": "？？？",
          "text": "…所以我的这个样子会被后世的勇者看到对吗？"
        },
        {
          "role": "？？？",
          "text": "嗯嗯，我知道我不用太紧张。日后我的残影是会根据我现在的记忆自己行动的。"
        },
        {
          "role": "？？？",
          "text": "但是，还是好紧张啊。"
        },
        {
          "role": "渊上",
          "text": "哎哟我的…开口说话啦！"
        },
        {
          "role": "？？？",
          "text": "啊，看来勇者已经到了。你好，我的海祇名字是亚琉，本来的白夜国名字是阿尔戈斯。"
        },
        {
          "role": "亚琉",
          "text": "我负责传达试炼的下一步指示。那就是复原「苏生之辔」，展示白夜之王权。"
        },
        {
          "role": "亚琉",
          "text": "「苏生之辔」是可以命令幽冥残魂开口的传国之宝，与大日御舆用相同的材料制成。"
        },
        {
          "role": "亚琉",
          "text": "它需要以「御辔」为核心进一步加工拼合。因此您还需要寻找另外三块碎片。"
        },
        {
          "role": "亚琉",
          "text": "啊，你们如果有什么问题的话可以直接提出来。我相信我留下的精魂残影能做出反应。"
        },
        {
          "role": "旅行者",
          "text": "你喜欢吃黄油蟹蟹吗？"
        },
        {
          "role": "亚琉",
          "text": "那、那是什么…"
        },
        {
          "role": "派蒙",
          "text": "那你喜欢吃鲜鱼刺身吗？"
        },
        {
          "role": "亚琉",
          "text": "哦哦，最近海祇大御神为我们拱起海面的土地之后，我们可以从事浅海渔猎了。能吃的鱼肉种类也变多了。"
        },
        {
          "role": "亚琉",
          "text": "…话说回正题吧。三处碎片，分别藏在环绕大日御舆的三处要地里，即狭间之街、常夜灵庙和蛇心之地。"
        },
        {
          "role": "亚琉",
          "text": "我用了「藏」字一点都不夸张。这群负责布置试炼的官员折腾人真的很有一手。"
        },
        {
          "role": "旅行者",
          "text": "没事，更加刁钻的谜题也见过…"
        },
        {
          "role": "亚琉",
          "text": "您在蛇心之地看到那个祭坛的话，可得在附近好好找找提示了。有个地走官在那里设计了好半天。"
        },
        {
          "role": "派蒙",
          "text": "地走官？"
        },
        {
          "role": "渊上",
          "text": "特殊官员克托尼俄，指的是白夜国的武装幽冥判官。也就是「地走官」。"
        },
        {
          "role": "渊上",
          "text": "他们拥有特殊材质的令牌，可以让白夜国的魂灵显形。"
        },
        {
          "role": "派蒙",
          "text": "为什么听起来一点都不像是稻妻式的名字…"
        },
        {
          "role": "渊上",
          "text": "怎么说呢，海祇岛也是魔神战争期间内被造出来的。在那之前…"
        },
        {
          "role": "渊上",
          "text": "白夜国的历史可就充满了阿布拉克、斯巴达克、克托尼俄、吉干忒斯这种名字。"
        },
        {
          "role": "渊上",
          "text": "这就是天之御史没怎么多加干涉的人文风貌吗…"
        },
        {
          "role": "派蒙",
          "text": "你在说什么？"
        },
        {
          "role": "渊上",
          "text": "啊啊，没什么。读书之人的坏习惯发作了。继续听阿尔戈斯说话吧。"
        },
        {
          "role": "亚琉",
          "text": "哦，对了，如今常夜到来，整个渊下宫都会对你展现出另一面。您在一路上应该会遇到不少残影。"
        },
        {
          "role": "亚琉",
          "text": "但是和我这种仪式留影不同。他们因为过于强烈的情绪而被渊下宫的常世法则选中，因罪而留影。"
        },
        {
          "role": "亚琉",
          "text": "它们即是地走官口中的「常世之灵」。但是因为「知罪则无罪」的法则，请不要直接告诉他们自己是残影。"
        },
        {
          "role": "亚琉",
          "text": "其他残影和我不同。一旦知道自己只不过是生前的影子，他们就会因此消散。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在璃月也见过一个类似的地方。",
              "dialogues": []
            },
            {
              "text": "这里还真神奇。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "亚琉",
          "text": "我们渊下宫人反而都已经习惯了。那么祝您好运了。"
        },
        {
          "role": "亚琉",
          "text": "那么，我就在这里静候您的佳音了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（渊上）"
        },
        {
          "role": "渊上",
          "text": "残影，还真是有意思…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于日月回轮…",
              "dialogues": [
                {
                  "role": "渊上",
                  "text": "毕竟这里是地下嘛，并没有太阳。所以这里的人们建造了这个灯塔。"
                },
                {
                  "role": "渊上",
                  "text": "通过此处或者他处的机关，白夜国的统治者可以转动日月之轮，切换白夜和常夜。"
                },
                {
                  "role": "渊上",
                  "text": "在古代，大日御舆的名字叫做「许伯利翁」，亘古语言里的意思是太阳之本体。"
                },
                {
                  "role": "渊上",
                  "text": "很能理解他们。没有太阳的地下王国，确实一切都很艰难。"
                }
              ]
            },
            {
              "text": "白夜国的其他事…",
              "dialogues": [
                {
                  "role": "渊上",
                  "text": "白夜国有着三角崇拜的传统。"
                },
                {
                  "role": "渊上",
                  "text": "他们认为白夜国乃是三个世界的交界之处：龙蜥界、人间界和虚无界。"
                },
                {
                  "role": "渊上",
                  "text": "边陲的试炼三地，原本是对抗龙蜥的边疆守望，也是渊下宫的三处灵力交汇之结点。"
                },
                {
                  "role": "渊上",
                  "text": "白夜国的三角自然状态下，本就有深渊虚无界与元素龙蜥界的对抗。"
                },
                {
                  "role": "渊上",
                  "text": "随后人们建造了高塔，让人界介入其中。三角三塔撑起了一个稳定的空间。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（亚琉）"
        },
        {
          "role": "亚琉",
          "text": "有什么能帮助您的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于常夜灵庙的碎片…<br>",
              "dialogues": [
                {
                  "role": "亚琉",
                  "text": "据说碎片被藏在了灵庙区域的一处秘所中，大门只有夜间才会打开。"
                },
                {
                  "role": "亚琉",
                  "text": "因为保存的碎片持有的乃是「寻蛇尺」之力，因此会吸引龙蜥。"
                },
                {
                  "role": "亚琉",
                  "text": "所以跟着龙蜥的痕迹，应该就能找到它。但是那边似乎有残余的魔物把守，请你务必小心。"
                }
              ]
            },
            {
              "text": "关于蛇心之地的碎片…",
              "dialogues": [
                {
                  "role": "亚琉",
                  "text": "蛇心之地保存了一个祭坛，被认为是宇宙蛇之心。在海祇神来之前我们就叫它奥罗巴洛斯之心了。"
                },
                {
                  "role": "亚琉",
                  "text": "它本质上是一种保存重要物件的封印装置，利用了渊下宫的特殊现象阳炎之幻，在中心叠加了可能性的维度。"
                },
                {
                  "role": "亚琉",
                  "text": "所以那里在海祇大御神到来之前，就已经被叫做蛇之地德尔斐了。"
                },
                {
                  "role": "亚琉",
                  "text": "取出对应空间的物件则需要依照对应的顺序进门。所以它也被用来关押犯人。"
                },
                {
                  "role": "亚琉",
                  "text": "这些密码似乎都被分散在了渊下宫各处…如果你找到了，在那里说不定能有些别的收获。"
                },
                {
                  "role": "亚琉",
                  "text": "其中一个碎片就在祭坛中。关于它的密文应该就在祭坛附近吧。这还是被乌帽子大人骂过后才改的。"
                },
                {
                  "role": "亚琉",
                  "text": "顺带您前去寻找线索的时候，需要注意一下渊下宫的「白夜」与「常夜」。"
                },
                {
                  "role": "亚琉",
                  "text": "这里还有一种地脉现象，叫做「阳炎之幻」。随着白夜、常夜轮转，能量会聚集或者消散。借此能将物体隐藏或者显现。"
                },
                {
                  "role": "亚琉",
                  "text": "如果你没找到线索，却察觉到了一丝异常，可以试试转换昼夜。"
                }
              ]
            },
            {
              "text": "关于狭间之街的碎片…",
              "dialogues": [
                {
                  "role": "亚琉",
                  "text": "狭间的遗迹中有一个隐藏的密室，具体的位置就需要靠您自己寻找了。"
                },
                {
                  "role": "亚琉",
                  "text": "密室被「阳炎之幻」隐藏了入口，需要切换白夜与常夜，使之显形。"
                },
                {
                  "role": "亚琉",
                  "text": "我们后来掌握了「阳炎之幻」这种现象，并且擅长利用它掩盖秘密。"
                },
                {
                  "role": "亚琉",
                  "text": "试炼之事情自然属于最高规格的秘密，所以您可以利用昼夜转换的能力多多观察。"
                }
              ]
            },
            {
              "text": "没有别的事了…",
              "dialogues": [
                {
                  "role": "亚琉",
                  "text": "好的。如果需要帮助，请随时来找我。虽然我这个状态也只能答疑解惑了…"
                },
                {
                  "role": "亚琉",
                  "text": "祝您好运。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往常夜灵庙，寻找「苏生之辔」的碎片"
        },
        {
          "type": "subtitle",
          "text": "前往蛇心之地，寻找「苏生之辔」的碎片"
        },
        {
          "type": "subtitle",
          "text": "前往狭间之街，寻找「苏生之辔」的碎片"
        },
        {
          "type": "subtitle",
          "text": "◆收集三块碎片（3/3）"
        },
        {
          "type": "subtitle",
          "text": "◆与亚琉对话"
        },
        {
          "role": "亚琉",
          "text": "你已经把所有的碎片都找到了吗？"
        },
        {
          "role": "亚琉",
          "text": "看起来您已经收集完所有的碎片了。"
        },
        {
          "role": "亚琉",
          "text": "不知在您的冒险里是否已经察觉了这件事…"
        },
        {
          "role": "亚琉",
          "text": "不过已经不重要了。我接下来说的事情，请您不要感到震惊——"
        },
        {
          "role": "亚琉",
          "text": "「血枝珊瑚」需要从特殊的深海龙蜥身上采取。而那些深海龙蜥就在这座大日御舆的下方。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "又是地下埋龙…",
              "dialogues": []
            },
            {
              "text": "有些意外…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "亚琉",
          "text": "被我们关在下方的龙蜥是特地调整过的品种。它们能够移植海祇大御神的血枝珊瑚碎块而不产生排异。"
        },
        {
          "role": "亚琉",
          "text": "但是因为这些调整，它们也格外强大，应该不会简单地引颈就戮。"
        },
        {
          "role": "亚琉",
          "text": "一切正统试炼的最后，勇者都得打倒恶龙才行。"
        },
        {
          "role": "派蒙",
          "text": "果然最后还是需要战斗啊。"
        },
        {
          "role": "亚琉",
          "text": "正是如此。不过您大可不必担心…对您来说，龙蜥之众应该不成问题。"
        },
        {
          "role": "派蒙",
          "text": "虽然我觉得对旅行者来说，龙蜥确实不是对手啦。但是你说这话有什么根据吗？"
        },
        {
          "role": "亚琉",
          "text": "哈哈哈，确实没有什么根据。只是一句鼓励罢了。"
        },
        {
          "role": "派蒙",
          "text": "你这样有些不负责任啊。你这样只是让他们盲目自信而已。"
        },
        {
          "role": "亚琉",
          "text": "欸，明明看起来头不怎么大，怎么比我们海祇的勇士都要聪明？"
        },
        {
          "role": "派蒙",
          "text": "那你们海祇岛人也太蠢了吧！"
        },
        {
          "role": "派蒙",
          "text": "不对不对。我想说的是，这样是不好的。"
        },
        {
          "role": "亚琉",
          "text": "我也明白这一点，此是「欺瞒之罪」。但是取珊瑚本身就是关系到海祇存亡的大事。"
        },
        {
          "role": "亚琉",
          "text": "勇者们，也是已经做好了觉悟才下来的。到了这一步，我也唯有推动他们前进了。"
        },
        {
          "role": "亚琉",
          "text": "我相信同为海祇之民的大家，也相信我们的后人。"
        },
        {
          "role": "亚琉",
          "text": "名义上，我是因为仪式诞生的无罪「常世之灵」。但是因为这一层原因，我想我也并非无罪吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（实在是不好意思说…）",
              "dialogues": []
            },
            {
              "text": "（其实我们的目的是财宝…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "亚琉",
          "text": "那么让我来为您拼合「苏生之辔」。"
        },
        {
          "type": "subtitle",
          "text": "过场动画",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "亚琉",
          "text": "虽然「苏生之辔」这个名字有点不准确。它本来的写法是「甦生之辔」，意思是「支配黄泉归来之物的缰绳」。"
        },
        {
          "role": "亚琉",
          "text": "大日之车白日带来光，夜晚带来过去的魂灵。持此物者，能支配阴阳与昏冥。"
        },
        {
          "role": "派蒙",
          "text": "诶，话说渊上怎么不见了？"
        },
        {
          "role": "亚琉",
          "text": "那人把大日御舆上下调查了一圈之后似乎有些不开心，然后就离开了。看起来没找到想要的东西。"
        },
        {
          "role": "亚琉",
          "text": "我能确定他并不是海祇之民血脉的末裔。而且他似乎身负秘法，或许能打乱仪式，将我驱散。"
        },
        {
          "role": "亚琉",
          "text": "我身负指引勇者的责任，不能轻举妄动。万一我消散了，关乎海祇生计的试炼就会停滞。这个后果我不能承受。"
        },
        {
          "role": "亚琉",
          "text": "现在他不在附近了，我必须警告您要对他多加提防。"
        },
        {
          "role": "派蒙",
          "text": "可是没有他的帮助，我们就找不到御辔，可能到现在都没办法到达大日御舆。"
        },
        {
          "role": "亚琉",
          "text": "是吗？可能是我多虑了。仔细想想，确实只有珊瑚宫的近臣能习得海祇古文的知识。当然，还有一种可能就是…"
        },
        {
          "role": "亚琉",
          "text": "我想也不会有太大问题吧。毕竟太古过于久远，文明已化风沙。"
        },
        {
          "role": "亚琉",
          "text": "…还是回到试炼上来吧。我来为你打开最终试炼的通路。"
        },
        {
          "role": "亚琉",
          "text": "「于此罪海祇，有渎身名等四罪，复有欺生灵之八罪。」"
        },
        {
          "role": "亚琉",
          "text": "「于此镇常世之磐石，往罪不可追。」"
        },
        {
          "role": "派蒙",
          "text": "亚琉你在说什么？"
        },
        {
          "role": "亚琉",
          "text": "这是我的最后一项工作，诵读这段祝词。它意思就是，海祇大御神将要带着我们所有人的罪孽死去了。"
        },
        {
          "role": "亚琉",
          "text": "我还要最后委托您一件事。当你离开渊下宫之后，请不要说有关试炼的任何事。"
        },
        {
          "role": "亚琉",
          "text": "之前的历次试炼也是这么运作的，还希望您能遵守。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "亚琉",
          "text": "接下来，您需要向御舆之下的深海龙蜥证明自己的勇武——唉，这种说法，我自己也无法接受。"
        },
        {
          "role": "亚琉",
          "text": "您是为了他们身上移植的血枝珊瑚而去的，它们自然是不会给你亲切露出肚皮或者腰肋的。"
        },
        {
          "role": "亚琉",
          "text": "它们只会朝你发泄百年以来积攒的，针对人类的愤怒。"
        },
        {
          "role": "亚琉",
          "text": "对您来说，这毫无疑问是一场死斗。那么，珊瑚宫的存亡就交给您了，祝您好运。"
        },
        {
          "type": "subtitle",
          "text": "◆开启最终试炼的通道"
        },
        {
          "type": "subtitle",
          "text": "◆前往大日御舆底部"
        },
        {
          "type": "subtitle",
          "text": "◆打倒深海龙蜥"
        },
        {
          "role": "渊上",
          "text": "旅行者，你好厉害啊。居然真的一个人就打败了这些深海龙蜥。"
        },
        {
          "role": "渊上",
          "text": "我能摸摸吗？"
        },
        {
          "role": "派蒙",
          "text": "渊上，你怎么在这里！？"
        },
        {
          "role": "渊上",
          "text": "嘿，我决定了。不论你同不同意我都要摸一摸。毕竟深海龙蜥是人类的敌人，这个机会太难得了。"
        },
        {
          "role": "渊上",
          "text": "啊，对了，你们很好奇对吧？但我反而不知道从哪里开始解释了。"
        },
        {
          "role": "渊上",
          "text": "简而言之，渊下宫就是罪人的冥府黄泉嘛。而我就是犯了欺瞒与背叛之罪的人。"
        },
        {
          "role": "派蒙",
          "text": "我还是不明白…渊上你究竟想要做什么？"
        },
        {
          "role": "渊上",
          "text": "我是前来渊下宫寻找一本书的。那本书记载了白夜国在大日御舆建成之前的事情。"
        },
        {
          "role": "渊上",
          "text": "这段纪年，被白夜国民称呼为「日月之前的事」。那时大地甚至还没有神明行走其上，全大陆也都同属一个文明。"
        },
        {
          "role": "派蒙",
          "text": "太古存在这样的时代吗？「那时众神行走大地」已经是吟游诗人嘴巴里最久远的时间了。"
        },
        {
          "role": "渊上",
          "text": "啊，是啊。所以我也想找到这本书。这样我们深渊教团就有实证了。「众神」和天空岛果然是外来之物。"
        },
        {
          "role": "渊上",
          "text": "我唯一能知道的事情，就是大蛇因为不慎阅读了这本书，被天空岛宣判了死刑。"
        },
        {
          "role": "渊上",
          "text": "它甚至还筹划了举国搬迁、海渊封门和举国东征来掩盖这个真相。"
        },
        {
          "role": "渊上",
          "text": "为了海祇之民获得像人一样活着的权力，策划了一场宏大的献头之仪。"
        },
        {
          "role": "渊上",
          "text": "可是这本书啊，我在图书馆并没有找到，在大日御舆内也没有找到。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "信息量…有点大。",
              "dialogues": []
            },
            {
              "text": "你欺骗了我们？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "渊上",
          "text": "我说了这么多，你就这个感想吗？"
        },
        {
          "role": "渊上",
          "text": "没有恨我恨到牙痒痒，恨不得立刻打我的脸吗？"
        },
        {
          "role": "派蒙",
          "text": "你是真的有喜欢挨打的毛病吗？"
        },
        {
          "role": "渊上",
          "text": "不过我觉得我罪不至此啦。毕竟我也没有说很多假话：我确实是来帮助你们的文员，但是我可没说我是珊瑚宫派来的。"
        },
        {
          "role": "渊上",
          "text": "我确实在翻译文献，只不过和试炼无关就是了。我确实只是个读书的人，而且变成了火元素的怪物。"
        },
        {
          "role": "渊上",
          "text": "我们读经士，不正被你们称呼为「咏者」吗？"
        },
        {
          "type": "subtitle",
          "text": "◆打倒深渊咏者·渊火"
        },
        {
          "role": "自称「渊上」之物",
          "text": "呼，虽然我也没小瞧你们，但是文员真不是勇者的对手啊。"
        },
        {
          "role": "自称「渊上」之物",
          "text": "本想在这里把你们干掉，然后伪装成讨伐失败来着。这么多故事里，总会有勇者打不赢龙蜥的吧。可惜了啊。"
        },
        {
          "role": "派蒙",
          "text": "你为什么要袭击我们啊？"
        },
        {
          "role": "自称「渊上」之物",
          "text": "那原因不是多了去了吗？我是深渊里挣扎之物，而你是大地之上的凡人。"
        },
        {
          "role": "自称「渊上」之物",
          "text": "你之前在渊下宫打倒了不少我的部下和同伴，于情于理，我也得复仇啊。"
        },
        {
          "role": "自称「渊上」之物",
          "text": "我也想着，我到处找不到书，是不是因为书在你手上。把你干掉之后搜你的身好啦。"
        },
        {
          "role": "自称「渊上」之物",
          "text": "「哎呀，这人带着这么多薄荷、包菜、禽肉兽肉想干什么啊？」"
        },
        {
          "role": "自称「渊上」之物",
          "text": "——大概就是这样，想要杀你理由多的是。不杀你的理由只有一个：「我还挺喜欢你的」。你还能想出第二个吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            },
            {
              "text": "「不去挑战无法战胜的人。」",
              "dialogues": []
            }
          ]
        },
        {
          "role": "自称「渊上」之物",
          "text": "哼哼。"
        },
        {
          "role": "自称「渊上」之物",
          "text": "看来我失败了。我们都得学到点教训。你下次可不要再轻易相信别人了。"
        },
        {
          "role": "自称「渊上」之物",
          "text": "比如说你身边的那个小家伙。说不定在最后也会背叛你哦。"
        },
        {
          "role": "派蒙",
          "text": "你这家伙怎么突然挑拨离间起来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙是不会背叛的。",
              "dialogues": []
            },
            {
              "text": "派蒙也没什么能背叛的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "自称「渊上」之物",
          "text": "哎，你这不是完全没学到教训吗。"
        },
        {
          "role": "自称「渊上」之物",
          "text": "罢了，聊天拖延时间也差不多了。我便就此离开了。应该还会再见的。"
        },
        {
          "type": "subtitle",
          "text": "◆取得血枝珊瑚"
        },
        {
          "role": "派蒙",
          "text": "气死我了。这个家伙是怎么回事！"
        },
        {
          "role": "派蒙",
          "text": "算了。赶紧去取走露子需要的血枝珊瑚吧。"
        },
        {
          "type": "subtitle",
          "text": "◆返回珊瑚宫，与露子对话"
        },
        {
          "role": "派蒙",
          "text": "好了，我们赶紧回去找露子复命吧。"
        },
        {
          "role": "派蒙",
          "text": "渊下宫这个地方，各种秘密都太危险了…"
        },
        {
          "role": "派蒙",
          "text": "露子，血枝珊瑚我们找到了。"
        },
        {
          "role": "露子",
          "text": "英雄，大侠，好汉，救世主！我要代表心海大人和全体海祇岛民感谢您。"
        },
        {
          "role": "露子",
          "text": "看您一脸疲惫，果然让您一个人试炼还是太强人所难了。"
        },
        {
          "role": "派蒙",
          "text": "倒也不算是一个人吧，还有我呢。然后还有一个偷偷溜下去的家伙，一开始帮了我们很多…"
        },
        {
          "role": "派蒙",
          "text": "可是最后…唔，这个故事很复杂，也是让旅行者这么疲惫的主要原因。"
        },
        {
          "role": "露子",
          "text": "听起来像是一个心海大人没有预料到的故事展开啊。"
        },
        {
          "role": "露子",
          "text": "乍看只是一群带着古海祇语字典的小贼，结果其实是什么更麻烦的家伙吗？"
        },
        {
          "role": "派蒙",
          "text": "是深渊教团的家伙。"
        },
        {
          "role": "露子",
          "text": "…这可非常之不得了。我之后会上报给心海大人的。"
        },
        {
          "role": "露子",
          "text": "不过，既然您带回来了枝条，她差不多也该开始操心「海祇御灵祭」的事情了。"
        },
        {
          "role": "露子",
          "text": "我这就回去把她从休息的房间里拽出来。"
        },
        {
          "role": "露子",
          "text": "总之，旅行者请您收下我们的感谢吧。"
        }
      ],
