{
  "quest_id": 10093,
  "chapter_num": "远海诗夏游纪 其六",
  "chapter_title": "如诗如歌，夏之梦",
  "type": "eq",
  "route": "Like Rhyme and Song, the Summer Reverie",
  "stories": [
    {
      "story_id": 40077,
      "title": "如诗如歌，夏之梦",
      "description": "不需要更多占卜，众人前往最后的岛屿寻找下个幻境。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往愚人众装置所在地"
        },
        {
          "role": "派蒙",
          "text": "喂！你们看那个人，是不是第一天我们见到的那个？"
        },
        {
          "role": "研究员",
          "text": "啊哈哈…嗝！都疯了，都滚吧！"
        },
        {
          "role": "研究员",
          "text": "我们…我们永远不会醒来…但我是对的，我的宝贝，无敌…"
        },
        {
          "role": "辛焱",
          "text": "宝贝？他的什么宝贝？"
        },
        {
          "role": "研究员",
          "text": "创造奇迹的机械…绝非…不可能…嗝！"
        },
        {
          "role": "莫娜",
          "text": "看来，宝贝就是指那台装置了吧。"
        },
        {
          "role": "菲谢尔",
          "text": "烂醉如泥，哼。"
        },
        {
          "role": "奥兹",
          "text": "噢这扑面的酒气…小姐，请容我用翅膀为您扇风。"
        },
        {
          "role": "莫娜",
          "text": "太好了，也给我扇扇。"
        },
        {
          "role": "旅行者",
          "text": "那我也要。"
        },
        {
          "role": "奥兹",
          "text": "当然。"
        },
        {
          "role": "枫原万叶",
          "text": "各位，我在附近看过了，没有其他人在。"
        },
        {
          "role": "枫原万叶",
          "text": "很奇怪不是吗？愚人众是一个组织，这里却只剩这位。而上一次来，我们甚至连这位也没找到。"
        },
        {
          "role": "枫原万叶",
          "text": "甚至就连上一次那位胖胖的先生也不见了。我猜…他们躲在其他地方。"
        },
        {
          "role": "枫原万叶",
          "text": "至于原因，恐怕就要问眼前这位了。"
        },
        {
          "role": "派蒙",
          "text": "可是他醉得像头死猪一样，我们是不是还要等他？"
        },
        {
          "role": "菲谢尔",
          "text": "降下惩戒的圣泉！"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是拿水浇他。"
        },
        {
          "role": "派蒙",
          "text": "听起来不错，我们试试！"
        },
        {
          "type": "subtitle",
          "text": "众人找出背囊里的水，毫不客气地对准这位愚人众研究员倒下…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "呀，他睁眼了！"
        },
        {
          "role": "研究员",
          "text": "唔…唔？"
        },
        {
          "role": "莫娜",
          "text": "喂，你是愚人众吧？能不能告诉我们这里到底发生了什么事，那台装置究竟有什么用？"
        },
        {
          "role": "研究员",
          "text": "…愚人…众…"
        },
        {
          "role": "研究员",
          "text": "…哈哈哈！愚人众！"
        },
        {
          "role": "研究员",
          "text": "噢，噢…愚昧无知的高层，你后悔了吧！哈哈，否定我的研究，逼我…"
        },
        {
          "role": "研究员",
          "text": "逼我…来到无人岛，做实验…宝贝！宝贝，呜呜呜…"
        },
        {
          "role": "派蒙",
          "text": "怎么还哭了，感觉他也受过很多委屈…"
        },
        {
          "role": "研究员",
          "text": "…蔑视我…和我的宝贝发明！你们、你们…不懂得未来的胜算。"
        },
        {
          "role": "研究员",
          "text": "唯有我的发明…能让大家征服世界…哈哈，哈哈哈…"
        },
        {
          "role": "研究员",
          "text": "傻子，傻子，哈哈哈哈哈…"
        },
        {
          "role": "研究员",
          "text": "呃啊…！不要打我，我不炸实验室了…对不起！不是故意…"
        },
        {
          "role": "辛焱",
          "text": "不行啊，这个人疯疯癫癫的，根本没法交流。"
        },
        {
          "role": "枫原万叶",
          "text": "第一天我们见到他的时候，他还不是这样，看来是在后几天受到了进一步影响，最终也陷入疯狂。"
        },
        {
          "role": "研究员",
          "text": "呜、呜…我的手稿，手稿！只有这个…能救…救…呜呜…"
        },
        {
          "role": "菲谢尔",
          "text": "手稿？在哪里？"
        },
        {
          "role": "研究员",
          "text": "别凶我，别凶我呜呜呜…"
        },
        {
          "role": "派蒙",
          "text": "菲谢尔，你别凶他啊！"
        },
        {
          "role": "菲谢尔",
          "text": "哼！那…"
        },
        {
          "role": "莫娜",
          "text": "换我来。"
        },
        {
          "role": "莫娜",
          "text": "亲爱的先生，看着我。告诉我，你把手稿藏在哪里了？"
        },
        {
          "role": "研究员",
          "text": "呜…呜…好可怕，不要逼我写报告…呜呜…走开…"
        },
        {
          "role": "派蒙",
          "text": "不会吧，他完全沉浸在想象中…"
        },
        {
          "role": "枫原万叶",
          "text": "我来吧。"
        },
        {
          "role": "枫原万叶",
          "text": "……"
        },
        {
          "role": "枫原万叶",
          "text": "失礼了！"
        },
        {
          "type": "subtitle",
          "text": "谁也没想到，万叶静静地站了一会儿，随后一个过肩摔将研究员拎起又摔下。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "枫原万叶",
          "text": "喝啊！"
        },
        {
          "role": "研究员",
          "text": "呜呜！屁股痛痛，呜呜…脑子好像动起来了，不是浆糊了…"
        },
        {
          "role": "枫原万叶",
          "text": "能告诉我你把手稿放在哪里了吗？"
        },
        {
          "role": "研究员",
          "text": "手稿…手稿…在那边的石缝里…"
        },
        {
          "role": "辛焱",
          "text": "说了！太好啦，不然我就要对着他的耳朵来一曲摇滚了。"
        },
        {
          "role": "派蒙",
          "text": "万叶似乎犹豫了很久才对他加以制裁呢，真是心地善良。"
        },
        {
          "role": "旅行者",
          "text": "嗯。这就是干大事的人吧。"
        },
        {
          "role": "枫原万叶",
          "text": "各位，先把手稿找出来吧，就在附近的石头缝里。"
        },
        {
          "type": "subtitle",
          "text": "寻找佩尔西科夫的笔记"
        },
        {
          "role": "菲谢尔",
          "text": "在这里！"
        },
        {
          "role": "奥兹",
          "text": "恭喜诸位，已寻得解决问题的关键！"
        },
        {
          "role": "莫娜",
          "text": "我看看…唔…"
        },
        {
          "type": "subtitle",
          "text": "莫娜接过手稿，仔细研读…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "莫娜",
          "text": "果然，这组名为「知感拟态」的装置能对人脑产生影响，制造者就是前面那个研究员，他名叫佩尔西科夫。"
        },
        {
          "role": "莫娜",
          "text": "从手稿来看，愚人众上层并不支持佩尔西科夫的研究，甚至认为他走了弯路。"
        },
        {
          "role": "莫娜",
          "text": "但佩尔西科夫非常坚持要将已成型的装置投入实战。为此，他托关系调用人手，将整组装置拆分为多个部件，运到无人岛上。"
        },
        {
          "role": "派蒙",
          "text": "真亏他们能找到这座岛啊！果然不能小看愚人众的情报网呢。"
        },
        {
          "role": "莫娜",
          "text": "佩尔西科夫一意孤行，在这里展开实验。参与实验的成员大都是愚人众下层士兵。他们签署过风险知情书。"
        },
        {
          "role": "莫娜",
          "text": "…看来，他们真的认为这组装置能为愚人众带去收益。"
        },
        {
          "role": "枫原万叶",
          "text": "装置的原理是什么？"
        },
        {
          "role": "莫娜",
          "text": "那恐怕就是顶级机密了，手稿中并未详写。但佩尔西科夫提到，这组装置是仿照某位神明的权能制作而成。"
        },
        {
          "role": "莫娜",
          "text": "意思是，有一位神明的权能和这些幻梦有关，而且愚人众还进行过了相关研究？"
        },
        {
          "role": "菲谢尔",
          "text": "对。否则，他们无法模仿神明的权能。"
        },
        {
          "role": "旅行者",
          "text": "（居然还有这样的神明吗？）"
        },
        {
          "role": "莫娜",
          "text": "总而言之，佩尔西科夫的实验过程并不顺利。装置启动后没几天就出现了故障，他们试图维修，没想到…"
        },
        {
          "role": "莫娜",
          "text": "毫无技术的愚人众士兵直接把装置搞得一团糟，连最最重要的晶核都被弹飞出去，不知掉到了哪个角落。"
        },
        {
          "role": "奥兹",
          "text": "可见维修是一项多么重要的工作，请各位量力而为。"
        },
        {
          "role": "莫娜",
          "text": "虽说佩尔西科夫是个科学疯子，却也不想看着自己的部下遭遇不测。再说，如果不解决问题，他自己也会发疯。"
        },
        {
          "role": "莫娜",
          "text": "情急之下，佩尔西科夫孤身一人外出寻找晶核，可他是个体弱多病的研究员，根本没那个本事，只得放弃。"
        },
        {
          "role": "莫娜",
          "text": "跟着，佩尔西科夫竭尽全力找回那些因疯狂而走散的士兵，把他们带到隐蔽的山洞里。"
        },
        {
          "role": "枫原万叶",
          "text": "登岛那天我们遇到的应该就是这个阶段的他们，佩尔西科夫带着一个身材健壮的愚人众士兵。"
        },
        {
          "role": "莫娜",
          "text": "对，佩尔西科夫花了很大力气，将士兵们都聚集到洞穴中，开始想办法唤醒他们。他使用音乐、诗歌…"
        },
        {
          "role": "莫娜",
          "text": "但都没什么用。"
        },
        {
          "role": "辛焱",
          "text": "我记得我们来过这里一次，那天谁都不在。这么看，佩尔西科夫就是在那天把所有人召集到了山洞里。"
        },
        {
          "role": "莫娜",
          "text": "嗯。最后几页有一个好消息和一个坏消息。"
        },
        {
          "role": "莫娜",
          "text": "好消息是，佩尔西科夫从疯狂的士兵口中问到零零散散的信息，拼凑出了晶核的所在地…"
        },
        {
          "role": "莫娜",
          "text": "而坏消息是，佩尔西科夫没能唤醒他们。随后他自己也受到影响，陷入了疯狂。手稿最后几页都是他发疯一样的乱涂乱画。"
        },
        {
          "role": "菲谢尔",
          "text": "如此看来，这份差事又落到了我与家臣们头上。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没想到，度假还要助人为乐…",
              "dialogues": []
            },
            {
              "text": "有一种职责在身的感觉。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莫娜",
          "text": "手稿里有张地图，这上面标明的应该就是晶核所在地了。"
        },
        {
          "role": "派蒙",
          "text": "没其他办法了，我们加油找回那些晶核吧！"
        },
        {
          "type": "subtitle",
          "text": "寻找装置缺失的晶核"
        },
        {
          "role": "派蒙",
          "text": "这个就是手稿中提到的晶核了吧！"
        },
        {
          "role": "派蒙",
          "text": "有了，第二个。"
        },
        {
          "role": "派蒙",
          "text": "这样一来就都找齐啦，快点把晶核放回装置里！"
        },
        {
          "role": "旅行者",
          "text": "（这位研究员遭到万叶制裁后有过片刻清醒，可没多久又晕了过去…）"
        },
        {
          "role": "旅行者",
          "text": "（到底是他本就神志不清，还是被摔晕了呢？）"
        },
        {
          "type": "subtitle",
          "text": "将晶核放入装置"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "派蒙",
          "text": "都放进去了，莫娜，这样就行了吗？"
        },
        {
          "role": "莫娜",
          "text": "应该是吧，反正手稿是这么写的。"
        },
        {
          "role": "枫原万叶",
          "text": "稍等片刻吧。希望它能恢复正常。"
        },
        {
          "type": "subtitle",
          "text": "大家席地而坐，就着火堆烤了些食物边吃边聊。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "装置修复后，情况果真有所好转。很快，远处传来了脚步声…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "愚人众士官",
          "text": "啊！有人在我们的营地里！"
        },
        {
          "role": "愚人众新兵",
          "text": "喂，你们是什么人？！"
        },
        {
          "role": "愚人众士官",
          "text": "等等，你看那台装置，修、修好了？"
        },
        {
          "role": "愚人众新兵",
          "text": "欸？欸？可是佩尔西科夫先生还躺在那边的地上啊。"
        },
        {
          "role": "派蒙",
          "text": "这台装置是我们修好的哦，你们应该谢谢我们！"
        },
        {
          "role": "莫娜",
          "text": "要不是被这些事打扰，我们本来可以度过一个完美无缺的假期。"
        },
        {
          "role": "菲谢尔",
          "text": "哼！还不快过来向本皇女和诸位家臣致歉！"
        },
        {
          "role": "愚人众士官",
          "text": "啊？！不不不，我、我先走了…"
        },
        {
          "role": "愚人众新兵",
          "text": "喂，喂，别丢下我…佩尔西科夫先生还在那里，快回来救他啊！"
        },
        {
          "role": "辛焱",
          "text": "哈哈哈，那两个人看起来很清醒。"
        },
        {
          "role": "枫原万叶",
          "text": "看来，修复成功了。"
        },
        {
          "role": "派蒙",
          "text": "太好啦！那我们别待在这里了，我想回自己的营地继续度假。"
        },
        {
          "role": "旅行者",
          "text": "你说的，是可莉的营地吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯！但我现在觉得，那里也是属于我们几个的营地了，就像临时的家一样，嘿嘿。"
        },
        {
          "role": "奥兹",
          "text": "那里或许该被称为幽夜净土暨嘟嘟王国大使馆。"
        },
        {
          "role": "派蒙",
          "text": "欸？不要啦，好难念。我还是喜欢用记得住的名字。"
        },
        {
          "role": "派蒙",
          "text": "走吧走吧，我们快点回家去。"
        },
        {
          "type": "subtitle",
          "text": "与众人一起返回营地"
        },
        {
          "role": "派蒙",
          "text": "呼啊——！回到家里大吃一顿，又在躺椅上躺了半天，总算是放松下来啦。"
        },
        {
          "role": "菲谢尔",
          "text": "哦呵呵，幽夜净土的招待，汝还满意吗？"
        },
        {
          "role": "派蒙",
          "text": "很喜欢！"
        },
        {
          "role": "奥兹",
          "text": "喜欢就好。小姐请诸位家臣过来，不仅想让各位见证我等圣国的降临，更是想让各位放松身心，欢度夏日。"
        },
        {
          "role": "辛焱",
          "text": "真好啊，我好喜欢这里，这次真是来对了！"
        },
        {
          "role": "菲谢尔",
          "text": "这里应该成为永远的乐土。"
        },
        {
          "role": "奥兹",
          "text": "小姐的意思是，希望以后还能与你们一同外出游玩。"
        },
        {
          "role": "辛焱",
          "text": "一定！等你们有时间，也可以来璃月找我，我带你们四处转转。"
        },
        {
          "role": "辛焱",
          "text": "哦对，璃月最好吃的饭店是我朋友家经营的，你们肯定喜欢。"
        },
        {
          "role": "辛焱",
          "text": "要是想听戏，也可以去找云堇，她人很好，又喜欢结交有趣的朋友，你们或许会在戏剧话题上很合得来。"
        },
        {
          "role": "菲谢尔",
          "text": "哦？辛焱卿极力推荐，我确实开始感兴趣了呢。"
        },
        {
          "role": "枫原万叶",
          "text": "旅行者，我有个想法。"
        },
        {
          "role": "枫原万叶",
          "text": "稻妻有种小吃叫做烤堇瓜，配着鱼肉风味也不错。今晚不如我们也试着把水果和海鲜一起烤，如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好啊好啊！",
              "dialogues": [
                {
                  "role": "枫原万叶",
                  "text": "那就说定了，我会尽量多找些水果，调味的话…嗯，就这么办。"
                }
              ]
            },
            {
              "text": "烤堇瓜不错哦，我吃过！",
              "dialogues": [
                {
                  "role": "枫原万叶",
                  "text": "是在稻妻吃的吗？"
                },
                {
                  "role": "旅行者",
                  "text": "几位稻妻朋友亲手给我烤的。"
                },
                {
                  "role": "枫原万叶",
                  "text": "哈哈，那太好了。"
                },
                {
                  "role": "枫原万叶",
                  "text": "我也打算像你一样，四处游历，广交好友。"
                },
                {
                  "role": "旅行者",
                  "text": "万叶的话，一定没问题。"
                },
                {
                  "role": "枫原万叶",
                  "text": "承你吉言，旅行者。"
                }
              ]
            }
          ]
        },
        {
          "role": "莫娜",
          "text": "你们在这儿啊。"
        },
        {
          "role": "莫娜",
          "text": "我发现一个问题。虽然我们已经修复装置，但你看，那些小岛上的幻境并未消失。"
        },
        {
          "role": "枫原万叶",
          "text": "我也察觉到了。考虑到幻境诞生需要时间，消失可能也需要。"
        },
        {
          "role": "莫娜",
          "text": "嗯，也是一种可能。"
        },
        {
          "role": "莫娜",
          "text": "说起来，我的水占盘倒是完全恢复正常，可以用了。刚才占卜的结果也没有太大异常，只是…"
        },
        {
          "role": "旅行者",
          "text": "只是？"
        },
        {
          "role": "莫娜",
          "text": "只是，占卜结果中有些看不懂的东西…似乎有某种力量围绕在我们身侧，注视着我们。"
        },
        {
          "role": "枫原万叶",
          "text": "是装置造成的吗？还是佩尔西科夫？"
        },
        {
          "role": "莫娜",
          "text": "抱歉，我也不清楚。只能确定这股力量目前不具有攻击性，应该是对我们没什么恶意。"
        },
        {
          "role": "旅行者",
          "text": "（这么说来，岛上还有一个问题没有解决，只是大家都不知道那件事。）"
        },
        {
          "role": "旅行者",
          "text": "我会留意的。"
        },
        {
          "role": "莫娜",
          "text": "嗯。虽说接下来没有干扰，可以尽情享受假日了，但离开海岛之前，我们还是要多加小心。"
        },
        {
          "role": "莫娜",
          "text": "我也会每日占卜的。"
        },
        {
          "role": "枫原万叶",
          "text": "我答应过菲谢尔会担任守卫一职，我也可以帮忙。"
        },
        {
          "role": "莫娜",
          "text": "好，拜托了。"
        },
        {
          "role": "莫娜",
          "text": "…唉，谁让她们那么无忧无虑呀。这次的事，我多操心就是了。"
        },
        {
          "role": "旅行者",
          "text": "派蒙，跟我来！"
        },
        {
          "role": "派蒙",
          "text": "噢噢，来了！"
        },
        {
          "role": "旅行者",
          "text": "到边上去。"
        },
        {
          "role": "派蒙",
          "text": "我明白了，是要联络卖唱的对吧？"
        },
        {
          "role": "嘟嘟通讯仪",
          "text": "嘟嘟可——嘟嘟可——"
        },
        {
          "role": "温迪",
          "text": "哎呀哎呀，你们终于联系我了？还以为你们玩得太高兴，把我彻底忘掉了呢。"
        },
        {
          "role": "派蒙",
          "text": "不是啦，卖唱的，我们遇到了很奇怪的事哦！"
        },
        {
          "type": "subtitle",
          "text": "将这几天海岛上发生的所有事件详细告知温迪…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "温迪",
          "text": "奇怪的装置？甚至能模仿神的能力？啊哈哈，愚人众还有这种计划吗，真是异想天开啊。"
        },
        {
          "role": "派蒙",
          "text": "听你的口气，是不知道这事咯？"
        },
        {
          "role": "温迪",
          "text": "我只是个酒馆卖唱的吟游诗人而已，怎么可能知道这些。"
        },
        {
          "role": "派蒙",
          "text": "这家伙，又开始了…"
        },
        {
          "role": "温迪",
          "text": "不过，撇开这些，旅行者，派蒙，这次你们玩得开心吗？"
        },
        {
          "role": "派蒙",
          "text": "开心！吃了好吃的东西，看了很多奇妙的景象，很不错哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "体验很不错哦。",
              "dialogues": []
            },
            {
              "text": "整体算是满意。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "啊哈哈，那就好。"
        },
        {
          "role": "温迪",
          "text": "旅行的意义在于记录心情。只要能给你们留下难忘的体验，这次旅程就有意义。"
        },
        {
          "role": "温迪",
          "text": "至于那个神秘的声音，虽然不知道是谁，但至少她没有让你们受到任何伤害，还让你们了解了彼此，对吧？"
        },
        {
          "role": "温迪",
          "text": "从这一点说，她或许带着善意。否则她都能截断艾莉丝女士发明的通讯工具了，一定也可以成功袭击你们。"
        },
        {
          "role": "派蒙",
          "text": "唔，卖唱的说得对…"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "明白了。"
        },
        {
          "role": "温迪",
          "text": "啊哈哈，能让你放心些就好。你们就尽情地玩吧，等你回来，别忘了将海岛上的美丽幻境仔细说给我听。"
        },
        {
          "role": "温迪",
          "text": "我想把这一切美好回忆记录下来，写进诗歌里。每个夏天，都会成为一段难忘的乐章。"
        },
        {
          "role": "旅行者",
          "text": "嗯，说好了。"
        },
        {
          "role": "温迪",
          "text": "那就等你回来喽。旅行者，假期愉快！"
        },
        {
          "role": "派蒙",
          "text": "既然卖唱的说不要紧，应该就没事了吧。"
        },
        {
          "role": "派蒙",
          "text": "毕竟，不管怎么说卖唱的也是个神呢，我们应该相信他。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实。",
              "dialogues": []
            },
            {
              "text": "马马虎虎吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那我们回去吧，别让大家久等了。"
        },
        {
          "role": "派蒙",
          "text": "刚才菲谢尔还说要去抓螃蟹，我也想去！"
        },
        {
          "role": "？？？（纳西妲）",
          "text": "解决这次事件的你，是否感到满足快乐？"
        },
        {
          "role": "旅行者",
          "text": "（这个声音是…！）"
        },
        {
          "role": "？？？",
          "text": "别担心，我不会伤害你。倒不如说，我只是一只偶尔飞经这片海域的小鸟，正从遥远的地方望着你。"
        },
        {
          "role": "？？？",
          "text": "只是偶然，这里竟然有与我相关的力量。我感到好奇，便降落在海滩上，悄悄窥视岛上的一切。"
        },
        {
          "role": "？？？",
          "text": "…真有趣啊。尽管忙于公务，那些来到海岛的人居然也会露出真心实意的笑容。"
        },
        {
          "role": "？？？",
          "text": "而后到的你们，更不用说，带来了璀璨的梦境与美丽的意志。"
        },
        {
          "role": "？？？",
          "text": "你们的幻梦，犹如海面上的气泡，剔透而脆弱。越是动人的泡影，越让我好奇。"
        },
        {
          "role": "？？？",
          "text": "我不能出远门，很羡慕你们这些自由自在的人，所以，也帮着做了一些小设计，希望你们喜欢。"
        },
        {
          "role": "旅行者",
          "text": "你是谁？"
        },
        {
          "role": "？？？",
          "text": "我说了，我没有目的，只是一只小鸟罢了。留在这里，是为了欣赏你们的喜怒哀乐。"
        },
        {
          "role": "？？？",
          "text": "你是个特别的人，散发着别样色彩。我实在好奇，才以这种方式与你沟通。"
        },
        {
          "role": "？？？",
          "text": "不必在意我的名字。或许未来某一天，我们会在别处{{黑幕|须弥}}相见。"
        },
        {
          "role": "？？？",
          "text": "到那时，你应该会认得我。呵呵。"
        },
        {
          "role": "旅行者",
          "text": "（声音消失了…她刚才是直接在我脑海中说话吗？）"
        },
        {
          "role": "派蒙",
          "text": "喂，你在干什么啊！快跟上！"
        },
        {
          "role": "旅行者",
          "text": "（…这是…）"
        },
        {
          "role": "旅行者",
          "text": "（在别处相见吗…会是什么时候，在哪里呢？）"
        }
      ]
    }
  ]
}