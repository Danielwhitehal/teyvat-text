{
  "quest_id": 74049,
  "chapter_num": null,
  "chapter_title": "好事多磨",
  "type": "wq",
  "route": "Were It So Easy",
  "stories": [
    {
      "story_id": 74049,
      "title": "好事多磨",
      "description": "小花匠柯莎的烦恼仍未解决…",
      "dialogues": [
        {
          "role": "柯莎",
          "text": "是带来异国花朵的旅行者和派蒙！"
        },
        {
          "role": "派蒙",
          "text": "你好啊柯莎。我们带来的花，成长得怎么样了？"
        },
        {
          "role": "柯莎",
          "text": "这个…柯莎已经一天没去看了…"
        },
        {
          "role": "派蒙",
          "text": "欸，不是很喜欢我们带来的花吗，为什么不去看呢？"
        },
        {
          "role": "柯莎",
          "text": "异国的花，那么难得，柯莎想要赶紧去照料它。可是一想到它可能会在眼前枯萎，就不敢去看了…"
        },
        {
          "role": "派蒙",
          "text": "不会吧，都在意成这个样子了？…不如我们一起去看看吧！如果遇到什么问题，派蒙和旅行者会帮助你的！"
        },
        {
          "role": "旅行者",
          "text": "光提心吊胆也不是办法。"
        },
        {
          "role": "柯莎",
          "text": "…说得对，我们一起去吧！有派蒙和旅行者帮助，柯莎就有信心了！"
        },
        {
          "type": "subtitle",
          "text": "前往花圃"
        },
        {
          "role": "柯莎",
          "text": "旅行者真厉害，把丑丑的机关，「咚」地一下变成了美丽的零件。"
        },
        {
          "role": "旅行者",
          "text": "这样一来花圃应该不会被打扰了。"
        },
        {
          "role": "派蒙",
          "text": "虽然已经被糟蹋了一些，但剩下的花好像状态还不错。隙境原体也不会再来捣乱了，柯莎的花可以茁壮生长啦。"
        },
        {
          "role": "柯莎",
          "text": "太好了…不过，柯莎已经吸取了教训，对宝贵的花朵要小心看护，小心照顾。"
        },
        {
          "role": "柯莎",
          "text": "旅行者和派蒙…送来了异国的花，还帮柯莎保护花圃。柯莎要怎么报答…"
        },
        {
          "role": "派蒙",
          "text": "不必那么客气啦。"
        },
        {
          "role": "柯莎",
          "text": "对了，还有柯莎亲手采到的花朵，最珍贵的花朵！就把这个送给旅行者和派蒙！"
        },
        {
          "role": "派蒙",
          "text": "哦！既然是这么珍贵的花朵，不如旅行者也开辟一片花圃把它种下去…"
        },
        {
          "role": "派蒙",
          "text": "话说这不是汐藻吗？汐藻也算是花吗？"
        },
        {
          "role": "柯莎",
          "text": "汐藻是植物，汐藻又很美丽，当然属于花朵啦。这是人类的「生物学」，为了成为厉害的花匠，柯莎学了一点，哼哼。"
        },
        {
          "role": "派蒙",
          "text": "总觉得哪里不对，可我也不太懂那些分类理论啦…"
        },
        {
          "role": "柯莎",
          "text": "柯莎以后要继续努力，成为更厉害的花匠。听人类说，厉害的花匠会培育出新品种的花，拿去参加「园艺会」。"
        },
        {
          "role": "柯莎",
          "text": "柯莎也要培育出新品种，在「园艺会」上赢得「奖项」。"
        },
        {
          "role": "派蒙",
          "text": "柯莎的劲头倒是很不错，不过好像还有很多难以解释的误会…"
        },
        {
          "role": "派蒙",
          "text": "参加园艺会，就是说要把自己培育的新品种拿去给人类鉴赏吧？"
        },
        {
          "role": "派蒙",
          "text": "柯莎的感官和审美，跟人类差别太大了…她培育的新品种花朵，在人类看来会不会很奇怪啊？"
        },
        {
          "role": "旅行者",
          "text": "派蒙真关心柯莎的园艺事业啊。"
        },
        {
          "role": "派蒙",
          "text": "那当然了！我可是柯莎的园艺教师。要是柯莎能参赛获奖，我脸上也有光彩嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不必太在意奖项，最重要的是开心。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "…也对哦！柯莎认为自己培育的花美丽就够啦！旁人的评价也没有那么重要吧。"
                },
                {
                  "role": "派蒙",
                  "text": "柯莎要照顾好花圃，看着美丽的花，每天都开开心心的哦！"
                },
                {
                  "role": "柯莎",
                  "text": "嗯！柯莎会让异国的花茁壮成长的！"
                }
              ]
            },
            {
              "text": "至少已经成功地迈出了第一步。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对哦，柯莎培育出的品种可能会有些不寻常，但有些人就是喜欢独树一帜的东西嘛！"
                },
                {
                  "role": "派蒙",
                  "text": "柯莎！培育出了新品种之后，要第一个告诉派蒙和旅行者哦！"
                },
                {
                  "role": "柯莎",
                  "text": "没问题，派蒙和旅行者帮了柯莎那么多!"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "击败隙境原体"
        },
        {
          "role": "柯莎",
          "text": "异国的花，异国的花~你要快快长大~"
        },
        {
          "type": "subtitle",
          "text": "与柯莎对话"
        },
        {
          "role": "柯莎",
          "text": "柯莎的花圃…坏家伙为什么要弄坏柯莎的花圃呢…"
        },
        {
          "role": "柯莎",
          "text": "呜呜呜…宝贵的花朵，被弄坏了…"
        },
        {
          "role": "派蒙",
          "text": "真是好可惜…原来花儿无法成活，是因为隙境原体在搞破坏吗？"
        },
        {
          "role": "柯莎",
          "text": "…柯莎，柯莎从此要守在花朵旁边，一步也不离开了！"
        },
        {
          "role": "派蒙",
          "text": "冷静一点啊，柯莎，我们一起来想想办法吧！话说回来，隙境原体为什么会破坏花圃…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "柯莎之前带别的花回来时…",
              "dialogues": []
            },
            {
              "text": "…被隙境原体找过麻烦吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "柯莎",
          "text": "从没有过！哼，这些坏家伙，只敢躲着我做坏事！柯莎好生气！"
        },
        {
          "role": "派蒙",
          "text": "哇啊…没想到柯莎也会有这么气愤的时候。看来是真的非常在意这些花朵。"
        },
        {
          "role": "派蒙",
          "text": "但是，回忆一下的话，刚才柯莎靠近的时候，隙境原体也没有主动躲开啊…"
        },
        {
          "role": "旅行者",
          "text": "或许吸引隙境原体的不是花。"
        },
        {
          "role": "派蒙",
          "text": "对呀，也有这种可能，我们调查一下花圃周围的情况吧！"
        },
        {
          "type": "subtitle",
          "text": "在附近寻找线索"
        },
        {
          "type": "subtitle",
          "text": "击败警卫机关"
        },
        {
          "type": "subtitle",
          "text": "与柯莎对话"
        }
      ]
    }
  ]
}