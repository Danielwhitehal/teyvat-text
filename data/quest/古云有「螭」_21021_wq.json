{
  "quest_id": 21021,
  "chapter_num": null,
  "chapter_title": "古云有「螭」",
  "type": "wq",
  "route": "The Chi of Yore",
  "stories": [
    {
      "story_id": 21021,
      "title": "古云有「螭」",
      "description": "轻策山中，似乎藏匿着什么秘密…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆与胭儿对话"
        },
        {
          "role": "胭儿",
          "text": "唉，运气真差…"
        },
        {
          "role": "旅行者",
          "text": "发生什么了？"
        },
        {
          "role": "胭儿",
          "text": "是旅行者啊，你来得正好，我正在…呃，研究呢。"
        },
        {
          "role": "胭儿",
          "text": "你知道这片地方的名字吧——「轻策庄」。"
        },
        {
          "role": "胭儿",
          "text": "怎么说呢，你了解「轻策」这个名字吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "了解…哪方面？",
              "dialogues": [
                {
                  "role": "胭儿",
                  "text": "当然是来历和含义咯，一看你就没见识…"
                }
              ]
            },
            {
              "text": "挺有特色的。",
              "dialogues": [
                {
                  "role": "胭儿",
                  "text": "就光一句「挺有特色」就完了？真没见识…"
                }
              ]
            }
          ]
        },
        {
          "role": "胭儿",
          "text": "你知道「螭」这个字吗？在传说里，「螭」是一只盘踞在这附近的龙形魔物。"
        },
        {
          "role": "胭儿",
          "text": "在被岩王帝君「摩拉克斯」击败之后，它的身体蜷曲成了顽石，血液化为了碧水，鳞片则变成了梯田…"
        },
        {
          "role": "胭儿",
          "text": "而在很久之前，「螭」其实也就是「轻策」的意思。"
        },
        {
          "role": "胭儿",
          "text": "然后，经过我长久、认真，严谨地研究之后…"
        },
        {
          "role": "胭儿",
          "text": "我认为，「螭」的遗骸，说不定还在这座山里。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "压根说不通…",
              "dialogues": [
                {
                  "role": "胭儿",
                  "text": "哼，先别急着否定。你注意到了这周围生长着的巨树了吗？是不是感觉，比其他地方的树都粗壮不少？"
                },
                {
                  "role": "胭儿",
                  "text": "当地人把这些树称为「螭血木」，认为这树吸收着螭血而生，所在的地方则是「螭眼」。"
                },
                {
                  "role": "胭儿",
                  "text": "而且这些树的生长情况，也确实超乎常理。"
                },
                {
                  "role": "胭儿",
                  "text": "即使不是真正的魔物遗骸，地下也一定有着什么厉害的东西…"
                }
              ]
            },
            {
              "text": "遗骸有什么用？",
              "dialogues": [
                {
                  "role": "胭儿",
                  "text": "什么用？一只魔物的遗骸，你知道能…"
                },
                {
                  "role": "胭儿",
                  "text": "咳！能，能有多大的研究价值吗？"
                }
              ]
            },
            {
              "text": "这就是你的研究？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胭儿",
          "text": "当然了，我怎么能放过这么有…研究价值的东西。"
        },
        {
          "role": "胭儿",
          "text": "不过，虽然说是研究，但其实也没什么线索。"
        },
        {
          "role": "胭儿",
          "text": "毕竟是上古的传说，恐怕连知道传说本身的人都没有几个了。"
        },
        {
          "role": "胭儿",
          "text": "我好不容易才找到了这片遗迹，想着说不定能从里面找到什么…"
        },
        {
          "role": "胭儿",
          "text": "但是里面居然有个{{颜色|蓝|遗迹猎者}}守着，这就是我说「运气差」的原因。"
        },
        {
          "role": "胭儿",
          "text": "虽然很想进去看看，但实在是太危险了，我还是过段时间，等它离开之后再来吧。"
        },
        {
          "role": "胭儿",
          "text": "你不会是想要进去探探吧？我倒是也不会阻止你啦，就是…"
        },
        {
          "role": "胭儿",
          "text": "一定要注意安全啊，虽然这可能是什么宝藏的线索…但说到底，也只不过是个传说而已，也没必要太过在意啦。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "胭儿",
          "text": "…这样就可以…呃啊！你，你怎么还在这？"
        },
        {
          "role": "胭儿",
          "text": "我要再休息一会，再休息一会我…我就走了。"
        },
        {
          "role": "胭儿",
          "text": "你自己注意安全啊，别太逞强了，说不定…真就只是个传说而已啦。"
        },
        {
          "type": "subtitle",
          "text": "◆调查遗迹"
        },
        {
          "role": "派蒙",
          "text": "呜哇，有遗迹猎者！"
        },
        {
          "role": "派蒙",
          "text": "看来，如果我们想要在这里搜寻什么…就必须先消灭它呢。"
        },
        {
          "type": "subtitle",
          "text": "◆消灭遗迹猎者"
        },
        {
          "role": "残缺的文字",
          "text": "「轻策即已无螭，缚龙妙法亦无用。…」"
        },
        {
          "role": "残缺的文字",
          "text": "「…然螭身不死，其血凝于地，结之为石，污害世间…」"
        },
        {
          "role": "残缺的文字",
          "text": "「…故镇之以尊像，其数为三…」"
        },
        {
          "role": "派蒙",
          "text": "…好难读的三段话，璃月的传说都这么难懂的吗…"
        },
        {
          "role": "派蒙",
          "text": "不过，里面说{{颜色|蓝|「…其血凝于地，结之为石…」}}，难道是在说某种{{颜色|蓝|奇怪的石头}}吗？"
        },
        {
          "role": "派蒙",
          "text": "唔，我们四处找找，留意一下周围的{{颜色|蓝|石头}}吧，说不定能找到什么线索呢。"
        },
        {
          "type": "subtitle",
          "text": "◆开启宝箱"
        },
        {
          "role": "派蒙",
          "text": "唔…完全看不懂呢。"
        },
        {
          "role": "派蒙",
          "text": "这是画吗？还是铭文，或者是其他东西…"
        },
        {
          "role": "派蒙",
          "text": "说不定，本地人会知道上面记录了什么。"
        },
        {
          "role": "派蒙",
          "text": "我们去轻策庄里问问看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆在轻策庄向人们询问关于碎片的线索"
        },
        {
          "role": "旅行者",
          "text": "关于碎片…"
        },
        {
          "role": "小星",
          "text": "碎片？嗯…不知道呢。"
        },
        {
          "role": "小星",
          "text": "你去问问若心奶奶吧，也许她知道。"
        },
        {
          "role": "旅行者",
          "text": "关于碎片…"
        },
        {
          "role": "阿佐",
          "text": "碎片？嗯…不知道，看不明白。"
        },
        {
          "role": "阿佐",
          "text": "而且，之前也从来没见过…"
        },
        {
          "role": "阿佐",
          "text": "你去问问若心奶奶吧，说不定她知道。"
        },
        {
          "role": "旅行者",
          "text": "关于碎片…"
        },
        {
          "role": "凯叔",
          "text": "什么东西，我瞧瞧。"
        },
        {
          "role": "凯叔",
          "text": "这上面字不是字的…看不懂。"
        },
        {
          "role": "凯叔",
          "text": "你去问问村长吧，她也许能看明白。"
        },
        {
          "type": "subtitle",
          "text": "◆向若心询问与碎片相关的线索"
        },
        {
          "role": "旅行者",
          "text": "关于碎片…"
        },
        {
          "role": "若心",
          "text": "碎片？是什么稀奇物件吗？我来看看…"
        },
        {
          "role": "若心",
          "text": "呵呵…怪不得你们认不出来，这上面的不是「字」，而是「画」。"
        },
        {
          "role": "若心",
          "text": "在很久之前，先民们还没有「字」，所以只能用「画」来记事。"
        },
        {
          "role": "若心",
          "text": "你看，这里是一个「螭」字。看起来，用来表达「螭」的「画」想必很大，也很复杂，这里也只有一部分，但也足够让我认出来了。"
        },
        {
          "role": "若心",
          "text": "我猜啊，这大概是记载着岩王爷和「螭」的那场战斗吧。但是，其他的地方就看不清喽…"
        },
        {
          "role": "旅行者",
          "text": "如果完整的话，您能看懂吗？"
        },
        {
          "role": "若心",
          "text": "呵呵，我可不能打包票说，肯定能看懂，"
        },
        {
          "role": "若心",
          "text": "不过，如果不完整，那就是肯定看不懂了。"
        },
        {
          "role": "旅行者",
          "text": "我们这就去找剩下的部分。"
        },
        {
          "role": "若心",
          "text": "呵呵，年轻人可真有干劲，好事，好事啊。"
        },
        {
          "role": "若心",
          "text": "按照这枚碎片上面记载的事情，依我看，如果你们真想找有关的东西…"
        },
        {
          "role": "若心",
          "text": "传说，岩王爷和「螭」的那场战斗发生在{{颜色|蓝|「高处」}}，你们可以先去周围的山上碰碰运气。"
        },
        {
          "role": "若心",
          "text": "然后，这场战斗也留下了许多痕迹，在这片留意一下{{颜色|蓝|「遗迹」}}准没错。"
        },
        {
          "role": "若心",
          "text": "争斗么…必然有落败的一方，按照传说，在击败「螭」之后，岩王爷教先民们做出了一种名为{{颜色|蓝|「岩尊像」}}的东西，用来镇压「螭」剩余的力量。"
        },
        {
          "role": "若心",
          "text": "我猜，一个地方的{{颜色|蓝|「岩尊像」}}越多，能够找到有关「螭」的线索的机会，应该也就越多吧。"
        },
        {
          "role": "若心",
          "text": "比如，我知道在「轻策庄」的{{颜色|蓝|西边}}，就有一个地方供奉着许多{{颜色|蓝|「岩尊像」}}，传说啊，那里就是岩王爷镇压「螭」的一处地方…你们不如去那里碰碰运气。"
        },
        {
          "role": "若心",
          "text": "呵呵，我就在这等着你们，等你们找齐了碎片之后，再拿来我看看吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "旅行者",
          "text": "…没想到，还能看见这东西。"
        },
        {
          "role": "若心",
          "text": "罢了，罢了，也算是缘分到了吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "您能再说说那些碎片的位置吗…",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "你们是记不清了吗？也是啊，絮絮叨叨一大堆，太难记了。"
                },
                {
                  "role": "若心",
                  "text": "如果你们想要找到有关于那场战斗的碎片，可以先去{{颜色|蓝|「高处」}}碰碰运气。"
                },
                {
                  "role": "若心",
                  "text": "然后，你们可以再去{{颜色|蓝|西边}}，沿着{{颜色|蓝|「岩尊像」}}仔细看看。"
                },
                {
                  "role": "若心",
                  "text": "最后，再留意一下周围的{{颜色|蓝|「遗迹」}}吧。"
                }
              ]
            },
            {
              "text": "您是怎么知道…",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "知道？哈哈哈，谈不上「知道」。"
                },
                {
                  "role": "若心",
                  "text": "只不过年纪大了点，见识多了点，记性好了点。勉强记得些老掉牙的东西"
                },
                {
                  "role": "若心",
                  "text": "在我那个年代啊，岩王爷镇压「螭」的故事，可是人尽皆知啊。"
                },
                {
                  "role": "若心",
                  "text": "不过，还有人说，连岩王爷都不能把「螭」彻底消灭，只能用「岩尊像」把它镇压在这里，慢慢把他磨灭。"
                },
                {
                  "role": "若心",
                  "text": "哈哈哈，不过啊，这也只是传说，假如「螭」真的还活着，那咱们这轻策庄，可就不得安稳喽。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆沿着「岩尊像」寻找碎片"
        },
        {
          "role": "残缺的文字",
          "text": "「…帝君伏螭，然其身不全死，故渐次镇之，束其神于{{颜色|蓝|正北}}，钉其骨于{{颜色|蓝|东南}}，锁其身于{{颜色|蓝|西北}}，缚其魂于{{颜色|蓝|东北}}，压其形于{{颜色|蓝|西南}}…」"
        },
        {
          "type": "subtitle",
          "text": "◆前往轻策庄的「最高处」寻找碎片"
        },
        {
          "role": "残缺的文字",
          "text": "「…其骨已销，其神已失，其形已灭，其魂已灭…其身仍存…」"
        },
        {
          "role": "残缺的文字",
          "text": "「…置此尊像，{{颜色|蓝|遥望四方}}…{{颜色|蓝|狂风隔蔽之墟}}、{{颜色|蓝|冰雪不化之峰}}、{{颜色|蓝|绝云隐仙之地}}、{{颜色|蓝|璃月众人之城}}…」"
        },
        {
          "type": "subtitle",
          "text": "◆寻齐碎片"
        },
        {
          "role": "派蒙",
          "text": "这样子就有三枚碎片了，好像能拼起来…"
        },
        {
          "role": "派蒙",
          "text": "嗯…拼起来之后，也看不懂上面是什么意思。"
        },
        {
          "role": "派蒙",
          "text": "果然还是要去找本地人问问看吗…"
        },
        {
          "type": "subtitle",
          "text": "◆解读碎片"
        },
        {
          "role": "旅行者",
          "text": "这些碎片…"
        },
        {
          "role": "若心",
          "text": "我看看…这些碎片，是可以拼起来的。"
        },
        {
          "role": "若心",
          "text": "唔…你看这里，是一个「螭」字，这个「螭」在一场大战中被击败。"
        },
        {
          "role": "若心",
          "text": "然后，「螭」的遗骸被钉在了某个极低的地方…"
        },
        {
          "role": "旅行者",
          "text": "「螭」是什么？"
        },
        {
          "role": "若心",
          "text": "哦，在传说里，「螭」是一只龙型的魔兽，这片轻策山啊，之前就是它的巢穴。"
        },
        {
          "role": "若心",
          "text": "多亏了岩王帝君将它击败，「螭」的身体蜷曲成了顽石，血液化为了碧水，鳞片则变成了梯田。"
        },
        {
          "role": "若心",
          "text": "你看见轻策庄旁边那些粗壮的大树了吗？那些是「螭血木」，传说里，它们被「螭」的血滋养着生长。"
        },
        {
          "role": "若心",
          "text": "但是传说也只是传说，如今，谁又真能找到「螭」的痕迹呢？"
        },
        {
          "role": "旅行者",
          "text": "然后呢？"
        },
        {
          "role": "若心",
          "text": "然后…为了封住「螭」的遗骸，不让它再为祸世间…用「水」将「螭」的遗骸封堵…又用「宝器」将它镇在了「密藏」的中心…"
        },
        {
          "role": "若心",
          "text": "唔，剩下的就完全看不清了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「螭」的遗骸还存在吗？",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "这件事，除了岩王帝君之外，只怕谁都不知道了。"
                },
                {
                  "role": "若心",
                  "text": "怎么？年轻人，你觉得这三枚碎片记载的东西是真的？"
                }
              ]
            },
            {
              "text": "「密藏」…「宝器」！",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "呵呵，年轻人…一听到「宝」字，这颗心就摁不住了。"
                },
                {
                  "role": "若心",
                  "text": "怎么，你觉得这三枚碎片记载的东西是真的？"
                }
              ]
            }
          ]
        },
        {
          "role": "若心",
          "text": "不过年轻人嘛，到处跑跑也不是坏事。"
        },
        {
          "role": "若心",
          "text": "如果你们真想按着这三枚碎片找过去的话，按我想，你们要找的地方一定与{{颜色|蓝|「水」}}有关。"
        },
        {
          "role": "若心",
          "text": "而且，是能够封堵住某个{{颜色|蓝|「入口」}}的{{颜色|蓝|「水」}}。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是…瀑布？",
              "dialogues": []
            },
            {
              "text": "是深潭吗…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "若心",
          "text": "唔…让我想想。这么说来，我倒是记得…轻策庄的西北面，有一道不小的瀑布，不知道和那处「密藏」有没有关系…"
        },
        {
          "role": "若心",
          "text": "好啦，我也就知道这些了，剩下的你们就自己琢磨去吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "若心",
          "text": "「螭」的遗骸，这种阴魂不散的东西，居然还有人想要打它的主意。"
        },
        {
          "role": "若心",
          "text": "…唉，希望只是些不成器的小毛贼。但如果那里面真的还有东西的话…"
        },
        {
          "role": "若心",
          "text": "…岩王爷保佑，岩王爷保佑…"
        },
        {
          "type": "subtitle",
          "text": "◆寻找进入「密藏」的方法"
        },
        {
          "type": "subtitle",
          "text": "◆在「密藏」中搜索"
        },
        {
          "role": "派蒙",
          "text": "咦？门上有三个凹下去的地方…"
        },
        {
          "role": "派蒙",
          "text": "难道，是要用什么东西嵌进去吗？"
        },
        {
          "role": "轻策之藏大门",
          "text": "（石门紧闭着，上面有三个奇怪的凹槽，也许会是开门的关键…）"
        },
        {
          "role": "派蒙",
          "text": "这里…就是那个碎片上说，「螭」遗骸的所在地吗？"
        },
        {
          "role": "派蒙",
          "text": "那，那是什么东西！看起来好像很危险…小心点走，别触动了什么…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！小心后面，是盗宝团！"
        },
        {
          "role": "派蒙",
          "text": "这群坏蛋，怎么哪里有宝藏哪里就有他们…"
        },
        {
          "type": "subtitle",
          "text": "◆击败敌人"
        },
        {
          "role": "派蒙",
          "text": "呼，这样就结束了吧…可是，可是「宝器」和「遗骸」都不见踪影。"
        },
        {
          "role": "派蒙",
          "text": "这么大一片地方，总不可能真的什么都没有吧，而且我们还费了这么大的力气…"
        },
        {
          "role": "派蒙",
          "text": "唔…不然，我们再到处找找看吧？"
        },
        {
          "type": "subtitle",
          "text": "◆搜索宝藏"
        },
        {
          "type": "subtitle",
          "text": "◆前往轻策庄，向村长若心报告"
        },
        {
          "role": "若心",
          "text": "你们回来了，怎么样，有什么发现吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么都没有。",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "哈哈哈，好，好，没关系，没关系，年轻人多跑跑没坏处。"
                }
              ]
            },
            {
              "text": "在外面发现了一堆盗宝团。",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "盗宝团？你们把他们全都赶走了？"
                },
                {
                  "role": "若心",
                  "text": "这群不成器的毛贼，成天偷鸡摸狗的，实在烦人，让他们吃点教训也好。"
                },
                {
                  "role": "若心",
                  "text": "里面…什么也没有？哈哈哈，没关系，没关系，年轻人多跑跑没坏处。"
                }
              ]
            }
          ]
        },
        {
          "role": "若心",
          "text": "来，这些给你们，跑了这么久，拿去买点好吃的，休息休息吧。"
        },
        {
          "role": "若心",
          "text": "什么都没有，什么都没有…好啊，好啊…"
        }
      ],
