{
  "quest_id": 73520,
  "chapter_num": null,
  "chapter_title": "「二十年前的事」",
  "type": "wq",
  "route": "\"That Incident From Twenty Years Ago\"",
  "stories": [
    {
      "story_id": 73520,
      "title": "「二十年前的事」",
      "description": "多莉说她这里有学院庆典独家情报，要不要找她打听一下呢？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "向多莉打听情报"
        },
        {
          "role": "多莉",
          "text": "两位决定要从我这里购买情报了吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…我确实对你说的独家情报有点好奇，不过我们要先听听价钱！如果太贵的话，我们就不买了。"
        },
        {
          "role": "多莉",
          "text": "一口价，一百万摩拉！"
        },
        {
          "role": "派蒙",
          "text": "好贵！还是算了吧！一百万摩拉能买好多好吃的了！"
        },
        {
          "role": "多莉",
          "text": "等一等，让我看看…什么？小派蒙是今天第一千零一位客人，原价一百万摩拉的特别情报，竟然不要钱就能拿走！"
        },
        {
          "role": "派蒙",
          "text": "欸？！还有这种好事？！"
        },
        {
          "role": "派蒙",
          "text": "等等，该不会是消费陷阱吧？第一句免费，第二句就要收费什么的…"
        },
        {
          "role": "多莉",
          "text": "不听拉倒！下一位客人，下一位——"
        },
        {
          "role": "派蒙",
          "text": "别别别，算我错了，我们听我们听！"
        },
        {
          "role": "多莉",
          "text": "多莉独家消息第一条！你们还记得才识之冠吗？"
        },
        {
          "role": "派蒙",
          "text": "记得呀，听说只有冠军才有资格佩戴那枚冠冕，好像是很贵重的东西呢！"
        },
        {
          "role": "多莉",
          "text": "没错，萨齐因捐给教令院的冠冕，是一件非常昂贵的古董。"
        },
        {
          "role": "多莉",
          "text": "然而就是这个冠冕，在捐给教令院之后，曾经被教令院搞丢过一次呢！"
        },
        {
          "role": "派蒙",
          "text": "欸？我们怎么没听说过？"
        },
        {
          "role": "多莉",
          "text": "呵呵…大家都知道的话，怎么能算「独家消息」呢？"
        },
        {
          "role": "多莉",
          "text": "当然，这条情报可不是空穴来风，而是有目击证人的。"
        },
        {
          "role": "多莉",
          "text": "南郊有一个叫喀什米的年轻人，如果你们感兴趣的话，可以去问问他。"
        },
        {
          "role": "多莉",
          "text": "暗号就是…「二十年前的事」！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（多莉）"
        },
        {
          "role": "多莉",
          "text": "还有什么事情吗？想要额外的情报，就要支付额外的价钱咯！"
        },
        {
          "type": "subtitle",
          "text": "与喀什米对话"
        },
        {
          "role": "喀什米",
          "text": "你们是谁？找我有什么事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没事…",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（对话结束）",
                  "narration": true
                }
              ]
            },
            {
              "text": "「二十年前的事」",
              "dialogues": [
                {
                  "role": "喀什米",
                  "text": "…看来我就不该到处说。上次喝多了酒唠叨了几句，结果最近总有人来问。"
                },
                {
                  "role": "喀什米",
                  "text": "既然你们好奇，我就再讲讲吧。"
                },
                {
                  "role": "喀什米",
                  "text": "二十年前，我只是个六岁的毛头小子。当时发生的事，我已经完全记不清了。前段时间看了小时候写的日记，才朦胧地回忆起当时的情况。"
                },
                {
                  "role": "喀什米",
                  "text": "那年也办了学院争霸赛，比赛共三轮，最后一轮是在城外。我就央求老妈带我出城去看，她不答应，我就偷偷跑了出去。"
                },
                {
                  "role": "派蒙",
                  "text": "然后呢？"
                },
                {
                  "role": "喀什米",
                  "text": "然后我就在城外迷路了。荒郊野岭，一个人都没有。我越来越怕，忍不住哭了起来。"
                },
                {
                  "role": "喀什米",
                  "text": "就在这时，我看到一些奇特的生物…我已经记不起它们的长相了，只记得当时还是孩子的我看到它们，很快就不哭了。"
                },
                {
                  "role": "派蒙",
                  "text": "奇特的生物，难道说是…"
                },
                {
                  "role": "旅行者",
                  "text": "（是兰那罗吧。）"
                },
                {
                  "role": "喀什米",
                  "text": "它们带我去了比赛现场。可惜到那里的时候已经太晚，比赛早就结束了。"
                },
                {
                  "role": "喀什米",
                  "text": "就在我心灰意冷的时候，我忽然看到一个奇特的生物拖着一顶王冠慢慢地走着。"
                },
                {
                  "role": "喀什米",
                  "text": "那王冠很漂亮，在月光下闪闪发亮，我忍不住跟了上去。我看到那个小家伙将王冠藏进了一个树洞里，然后就消失不见了。"
                },
                {
                  "role": "喀什米",
                  "text": "我很想去摸一摸那顶王冠。但就在这个时候，远处传来了老妈的呼声。原来她发现我跑丢了，就叫上左邻右舍一起来找我了。"
                },
                {
                  "role": "喀什米",
                  "text": "我最后也没有摸到那顶冠冕，直到后来我长大了，在学院争霸赛现场见到「才识之冠」，才恍然发觉似乎是同一个东西。"
                },
                {
                  "role": "派蒙",
                  "text": "好吧…你还记得那个王冠最后被放在哪里了吗？"
                },
                {
                  "role": "喀什米",
                  "text": "好像是在道成林，不过我后来去找过几次，都没有发现任何线索。"
                },
                {
                  "role": "喀什米",
                  "text": "就算我说了也没人相信。唉，连我自己也记不真切了，可能是我小时候做的一个梦吧。"
                },
                {
                  "role": "派蒙",
                  "text": "嗯…旅行者，我们要不要去找找看？"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（喀什米）"
        },
        {
          "role": "喀什米",
          "text": "那时候…到底发生了什么呢？"
        },
        {
          "type": "subtitle",
          "text": "继续寻找线索"
        },
        {
          "type": "subtitle",
          "text": "你们来到喀什米所说的树洞…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这里好像有个树洞，不过里面是空的，什么都没有…"
        },
        {
          "role": "派蒙",
          "text": "嗯？等等，这里面好像有张字条！"
        },
        {
          "role": "派蒙",
          "text": "「好那菈教兰迦叶波识字，兰迦叶波要保护好那菈…」"
        },
        {
          "role": "派蒙",
          "text": "这是什么意思呢？"
        },
        {
          "type": "subtitle",
          "text": "调查字条"
        },
        {
          "role": "旅行者",
          "text": "（风化的字条上还留有模糊的字迹…）"
        },
        {
          "role": "旅行者",
          "text": "（「好那菈教兰迦叶波识字，兰迦叶波要保护好那菈…」）"
        }
      ],
      "collapse_ranges": [
