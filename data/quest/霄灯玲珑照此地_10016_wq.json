{
  "quest_id": 10016,
  "chapter_num": "",
  "chapter_title": "霄灯玲珑照此地",
  "type": "wq",
  "route": "Beneath Splendent Lanterns",
  "stories": [
    {
      "story_id": 41358,
      "title": "玲珑霄灯图之二",
      "description": "璃月港冒险家协会的小千似乎还在招揽人过去试玩「玲珑霄灯图」…",
      "dialogues": [
        {
          "role": "小千",
          "text": "欢迎试玩「玲珑霄灯图」…"
        },
        {
          "role": "旅行者",
          "text": "咦？这些灯…"
        },
        {
          "role": "小千",
          "text": "是你啊，来得正好，你上次解开了那盏灯之后，我特意又换了几盏灯。"
        },
        {
          "role": "小千",
          "text": "怎么样，要不要再试试解读一下？这次可没上次那么简单了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "是映出来的图案更复杂了吗？",
            "是转灯的方式更难了吗？"
          ]
        },
        {
          "role": "小千",
          "text": "不不，图案还是很好理解，也只分成三份。"
        },
        {
          "role": "小千",
          "text": "这次的难度，是在「转灯的方式」上。"
        },
        {
          "role": "小千",
          "text": "哦！对了，这次要拼出来的图案是<color=#00E1FFFF>「摩拉」</color>，记住了啊，拼好了正确的图案之后，才能去找宝藏。"
        },
        {
          "role": "小千",
          "text": "那些宝藏可都是协会特意准备的，祝你们寻宝开心。"
        },
        {
          "role": "小千",
          "text": "你想要玩这个的话，就等晚上再来吧。"
        },
        {
          "role": "小千",
          "text": "这次要拼出来的图案是<color=#00E1FFFF>「摩拉」</color>。"
        },
        {
          "role": "小千",
          "text": "已经拼好了啊，你玩得越来越熟练了嘛。快点去看看图案吧，上面可隐藏着宝藏的线索呢。"
        },
        {
          "role": "小千",
          "text": "怎么样，寻宝之旅还顺利吗？"
        },
        {
          "role": "旅行者",
          "text": "已经找到全部宝藏了。"
        },
        {
          "role": "小千",
          "text": "全部都找到了？你寻宝的功夫真还挺…出色的，好多人过来，转了一下灯就走了…"
        },
        {
          "role": "小千",
          "text": "既然你找到了全部的宝藏…那这些奖励给你，收下吧，祝你在海灯节玩得开心。"
        }
      ]
    }
  ]
}