{
  "quest_id": 72233,
  "chapter_num": null,
  "chapter_title": "止水之潘",
  "type": "wq",
  "route": "The Still Water's Flow",
  "stories": [
    {
      "story_id": 72233,
      "title": "止水之潘",
      "description": "已经醒转的渊下宫正在呼唤勇者。止水之下有着新天地。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与露子对话"
        },
        {
          "role": "露子",
          "text": "旅行者，你们好啊。"
        },
        {
          "role": "派蒙",
          "text": "露子小姐，取珊瑚的事情准备的怎么样了啊？"
        },
        {
          "role": "露子",
          "text": "哎呀，这不是又遇到了难处嘛。"
        },
        {
          "role": "派蒙",
          "text": "虽然露子小姐你看起来悲伤地低下了头…"
        },
        {
          "role": "派蒙",
          "text": "但这样不停地给我们使眼色，未免也太露骨了。"
        },
        {
          "role": "露子",
          "text": "呜，果然你们也发现了情况危急。那我也不隐瞒了吧。"
        },
        {
          "role": "派蒙",
          "text": "你根本就没想隐瞒吧！"
        },
        {
          "role": "露子",
          "text": "之前虽然初步取得了「月浴渊之钥」，渊下宫正在缓慢苏醒。但是因为人手不足的原因，调查推进还是很慢。"
        },
        {
          "role": "露子",
          "text": "毕竟最近还是特殊时期嘛，和鸣神岛的关系不知能不能缓和。"
        },
        {
          "role": "旅行者",
          "text": "那，多我一个也不多…"
        },
        {
          "role": "露子",
          "text": "那可不一样哦。要知道根据传统，取珊瑚最需要的人，就是「勇者」。"
        },
        {
          "role": "露子",
          "text": "先建立根据地，然后协助「勇者」沿着先人足迹探索，最后迎来试炼。"
        },
        {
          "role": "露子",
          "text": "所谓稳扎稳打的策略就是这样了。"
        },
        {
          "role": "派蒙",
          "text": "但是因为最近人手不足，所以没办法探索咯。"
        },
        {
          "role": "露子",
          "text": "正是如此，最关键的「勇者」现在连根头发丝都看不到呢。"
        },
        {
          "role": "露子",
          "text": "现在好像看到了。似乎是一缕…一缕金发！"
        },
        {
          "role": "派蒙",
          "text": "呜啊，听起来好麻烦的样子。根本不想趟这趟水。"
        },
        {
          "role": "露子",
          "text": "不过探索通常都会发现一些奇珍异宝。按照惯例，拿到了都是要上缴珊瑚宫家的。"
        },
        {
          "role": "露子",
          "text": "如果这次你下去找到点什么的话，咱们睁一只眼闭一只眼也不是不可以…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要不两只眼一起闭上吧。",
              "dialogues": []
            },
            {
              "text": "我和心海大人关系很好的！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "露子",
          "text": "英雄，大侠，好汉，救世主！这么说您是同意咯？"
        },
        {
          "role": "派蒙",
          "text": "我们怎么能对珊瑚宫的危险视而不见呢！"
        },
        {
          "role": "露子",
          "text": "您这么说是最好不过了。看来按照心海大人教的话术，确实能哄到人啊。"
        },
        {
          "role": "露子",
          "text": "珊瑚宫大人甚至连你们会回来找我也预料到了。"
        },
        {
          "role": "派蒙",
          "text": "你说什么？"
        },
        {
          "role": "露子",
          "text": "没什么没什么。那么请随我来，我来向您展示一个东西。"
        },
        {
          "role": "露子",
          "text": "我们就在前方下面的祭台那里见面吧。如果你看不到…"
        },
        {
          "role": "派蒙",
          "text": "如果看不到…"
        },
        {
          "role": "露子",
          "text": "就在东南方向，眯起眼睛看就看到啦。"
        },
        {
          "type": "subtitle",
          "text": "在祭坛处与露子对话"
        },
        {
          "role": "露子",
          "text": "这个叫做「键纹」，是曾经渊下宫的通行纹章。只有当通路打开之时，它才会在地上浮现。"
        },
        {
          "role": "露子",
          "text": "据说是渊下宫苏醒之时，为海祇岛之民递送的另一组钥匙。而这种键纹在珊瑚宫的记载里，一共有五种。"
        },
        {
          "role": "露子",
          "text": "目前我们在海祇岛找到了其中的三种。如此操作之后就可以将其归位，解开封禁。"
        },
        {
          "role": "露子",
          "text": "我们之前特地将这三个从键纹孔上拔了下来，并且放置到了海祇岛的其他地方。这样可以让屏障重新生效。"
        },
        {
          "role": "露子",
          "text": "就是为了防止不懂事的熊孩子帮、愚人众间谍、鸣神岛居民和外乡人之类的家伙，偷偷潜下去。"
        },
        {
          "role": "露子",
          "text": "哦，外乡人当然不包括您啦。哈哈哈…"
        },
        {
          "role": "露子",
          "text": "现阶段没有办法和冒险家协会取得联系，所以冒险家都不给放下去哦。"
        },
        {
          "role": "派蒙",
          "text": "你们还会放冒险家下去的吗？"
        },
        {
          "role": "露子",
          "text": "历史上有这样的记录啦，合作共赢嘛。毕竟探索是他们和您的强项。"
        },
        {
          "role": "派蒙",
          "text": "哦豁，也就是说这次没有别人抢跑的意思吧。"
        },
        {
          "role": "旅行者",
          "text": "注意点吃相…"
        },
        {
          "role": "露子",
          "text": "这怎么说呢…这种临时保护屏障挺不可靠的。因为从调查键纹位置到取出键纹的时间用得太久了，期间可能溜下去过几个人。"
        },
        {
          "role": "露子",
          "text": "毕竟人手不够嘛…所以您在下面如果遇到愚人众、盗宝团、海乱鬼之类的，请毫不犹豫地把他们教训一顿吧。"
        },
        {
          "role": "派蒙",
          "text": "如果他们这么容易就下去了，那之前我们拿到的月什么钥是为了什么啊。"
        },
        {
          "role": "露子",
          "text": "只有取走「月浴渊之钥」，渊下宫才会转醒。同时只有用「月浴渊之钥」开门，试炼系统才会运作。"
        },
        {
          "role": "露子",
          "text": "如果不是为了海祇御灵祭前往渊下宫，或许确实可以靠着外道邪法溜进去吧。"
        },
        {
          "role": "露子",
          "text": "所以就希望你们能尽快动身，请去将海祇岛其他「键纹」取回吧。"
        },
        {
          "role": "露子",
          "text": "键纹被我们放在了「海神之鳍」与「海神之心」处。而两座祭坛则在它们与珊瑚宫的连线里，坐落于月浴渊的第二重山垣上。"
        },
        {
          "role": "露子",
          "text": "那么我就回到老地方静候您的消息了。"
        },
        {
          "role": "露子",
          "text": "旅行者，还有什么想问的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于键纹…",
              "dialogues": [
                {
                  "role": "露子",
                  "text": "键纹被我们放在了「海神之鳍」与「海神之心」处。"
                },
                {
                  "role": "露子",
                  "text": "其实我们也就是就近移开了一点。毕竟两处海神之伤也还算是比较隐秘的地方了。"
                },
                {
                  "role": "露子",
                  "text": "尽力了，真的。"
                }
              ]
            },
            {
              "text": "关于祭坛…",
              "dialogues": [
                {
                  "role": "露子",
                  "text": "祭坛在北方和正东边。就在下面月浴渊的第二重山之垣上。"
                },
                {
                  "role": "露子",
                  "text": "如果你从珊瑚宫到「海神之鳍」与「海神之心」连两条线…"
                },
                {
                  "role": "露子",
                  "text": "再和二重垣的弧线取两个交点。就是这两处啦。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找剩余的键纹"
        },
        {
          "role": "露子",
          "text": "旅行者，还有什么想问的吗？"
        },
        {
          "role": "旅行者",
          "text": "关于白夜国…"
        },
        {
          "role": "露子",
          "text": "渊下宫曾经的名字就叫做白夜国。因为地下之国并无日月，只有白夜和常夜两种天象。"
        },
        {
          "role": "露子",
          "text": "我的家系之中曾有一位名叫乌帽子的巫女，在白夜国历史里也算个人物，所以才让我负责「海祇御灵祭」。"
        },
        {
          "type": "subtitle",
          "text": "寻找剩余的键纹"
        },
        {
          "type": "subtitle",
          "text": "依照露子的指引激活所有祭坛"
        },
        {
          "type": "subtitle",
          "text": "依照露子的指引激活所有祭坛"
        },
        {
          "type": "subtitle",
          "text": "与露子对话"
        },
        {
          "role": "露子",
          "text": "接下来就是解封之刻了，请你拿好之前的「月浴渊之钥」。"
        },
        {
          "role": "派蒙",
          "text": "你再说一遍。"
        },
        {
          "role": "露子",
          "text": "「月浴渊之钥」。"
        },
        {
          "role": "派蒙",
          "text": "你再说三遍。"
        },
        {
          "role": "露子",
          "text": "「月浴渊之钥」、「月浴渊之钥」、「哕浴腌之浴」…切，咬舌头了。"
        },
        {
          "role": "派蒙",
          "text": "所以你们这个命名肯定有问题啊。改个名字吧。"
        },
        {
          "role": "露子",
          "text": "就算要改也是几百年后的人受益啦。这次你就忍一下吧。"
        },
        {
          "role": "露子",
          "text": "咳咳，总、总之，我就要施行仪式了。"
        },
        {
          "role": "露子",
          "text": "十分可惜，我们并没有渊下宫试炼的具体细节，接下来您只能依赖自己了。"
        },
        {
          "role": "露子",
          "text": "这种保持神秘感的传统真是坏东西。所以我也只能祝您好运了。"
        },
        {
          "role": "露子",
          "text": "另外，请您千万不要逞强。您的安全是最重要的。"
        },
        {
          "type": "subtitle",
          "text": "前往渊下宫"
        },
        {
          "type": "subtitle",
          "text": "调查洞穴"
        }
      ]
    }
  ]
}