{
  "quest_id": 73686,
  "chapter_num": null,
  "chapter_title": "意外争斗",
  "type": "wq",
  "route": "Unexpected Battle",
  "stories": [
    {
      "story_id": 73686,
      "title": "意外争斗",
      "description": "你和派蒙漫步于白狐之野，本想享受难得的平和氛围，却还是遇上了意外的争斗…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆前往白狐之野附近"
        },
        {
          "role": "派蒙",
          "text": "咦，你听，那边好像传来了争吵的声音。出什么事了吗？我们过去看看吧。"
        },
        {
          "role": "忠常",
          "text": "师兄，多年来我们情同手足，这次，我本来是不想以真剑对决的…"
        },
        {
          "role": "忠明",
          "text": "别说这种软弱的话了，你我之中只能有一个胜者，来吧，师弟。"
        },
        {
          "role": "派蒙",
          "text": "欸，这两个人怎么突然在路上打了起来？"
        },
        {
          "role": "忠常",
          "text": "嗯？有路人？你们两个，给我走开。"
        },
        {
          "role": "忠明",
          "text": "我们「狐野一刀流」直传弟子要在此对决，不通剑术的外人别旁观碍事。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，好不讲理，挡在路中间的是你们两个才对吧。"
        },
        {
          "role": "派蒙",
          "text": "而且，什么叫不通剑术？要说到剑术，我身边的这位旅行者可是很强的。"
        },
        {
          "role": "忠常",
          "text": "哦？又是一个来抢夺资格的。既然如此，师兄，我们还是先联手对外吧。"
        },
        {
          "role": "忠明",
          "text": "正有此意。"
        },
        {
          "type": "subtitle",
          "text": "◆迎战"
        },
        {
          "role": "派蒙",
          "text": "欸，怎么回事？这两个人怎么又冲着我们来了？旅行者，小心啊！"
        },
        {
          "role": "忠明",
          "text": "这唯一的资格，只能属于我们「狐野一刀流」。"
        },
        {
          "type": "subtitle",
          "text": "◆击败二人后对话"
        },
        {
          "role": "派蒙",
          "text": "呼…可算让他们停下了。喂，你们两个是误会了吧，我们只是路过，没有和你们抢东西的意思。"
        },
        {
          "role": "旅行者",
          "text": "参赛资格？"
        },
        {
          "role": "两人",
          "text": "…"
        },
        {
          "role": "忠常",
          "text": "这…师兄，怎么会这样？刚才这个年轻人没用几招，竟然就把我们两个逼得毫无招架之力！"
        },
        {
          "role": "忠常",
          "text": "我还以为，这次我们一定能让「狐野一刀流」扬名天下，可谁知道还没踏进赛场，就栽在了这种地方…"
        },
        {
          "role": "忠明",
          "text": "师弟，不用再说了。会有这样的结果，只说明我们实力不济。"
        },
        {
          "role": "忠明",
          "text": "唉，师父之前常说天外有天，可这话我们都没听进去。"
        },
        {
          "role": "忠明",
          "text": "现在看来，这张唯一的「参赛资格券」，落在我们谁手里，恐怕结果都一样。"
        },
        {
          "role": "派蒙",
          "text": "等等，你们两个自顾自的，到底在说什么呀？而且明明刚才还是一副掐起来的样子。"
        },
        {
          "role": "忠明",
          "text": "不好意思，让两位误会了。我们是剑道流派「狐野一刀流」的弟子，刚才动手，只是为了角逐「演武传心剑道大赛」的参赛资格。"
        },
        {
          "role": "忠明",
          "text": "这场赛事对习剑之人来说意义非凡，这附近又很少有人路过，我们没有细想就误以为二位是来抢夺参赛资格的，实在抱歉。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "误会已经澄清……",
              "dialogues": []
            },
            {
              "text": "你们继续。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "忠明",
          "text": "请等一下！如果不是阁下出手点醒了我，我这井底之蛙恐怕无法意识到自己的不足。"
        },
        {
          "role": "忠常",
          "text": "的确，和您切磋之后我才意识到，无论剑术还是心态我都需要精进。"
        },
        {
          "role": "忠明",
          "text": "师兄，我有个提议，不如就把那张参赛券送给他吧。"
        },
        {
          "role": "忠明",
          "text": "嗯，我没有异议。只有真正的剑术好手，才有资格站在演武传心的赛场上，我们还需历练啊。"
        },
        {
          "role": "派蒙",
          "text": "欸，你们的意思是，希望旅行者代替你们参赛？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这也太突然了吧？",
              "dialogues": []
            },
            {
              "text": "可我们完全不了解那个比赛…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "忠常",
          "text": "是否参赛，就由阁下定夺吧。至少这张参赛券，现在对于我们而言，已经没有用处了。二位，我们就此别过。"
        },
        {
          "role": "派蒙",
          "text": "他们两个就这么走掉了…唔，他们留下的这张什么什么大赛的参赛券要怎么办？"
        },
        {
          "role": "派蒙",
          "text": "让我看看…「演武传心剑道大赛」，「承办方社奉行」。既然是社奉行负责筹备的赛事，那我们就到神里屋敷去问问看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往神里屋敷询问斑目"
        },
        {
          "role": "斑目百兵卫",
          "text": "旅行者，派蒙，好久不见。真不凑巧，今天社奉行大人和神里小姐都有公务在身，目前不在府上。"
        },
        {
          "role": "派蒙",
          "text": "不是哦，今天我们不是来找他们的，而是要打听社奉行举办的「演武传心剑道大赛」活动。"
        },
        {
          "role": "斑目百兵卫",
          "text": "啊，旅行者是想报名参加比赛？实在不好意思，因为这次赛事的报名人数众多，参赛资格券早在上周就已经发完了。"
        },
        {
          "role": "斑目百兵卫",
          "text": "不过如果你们是想要最后那场表演赛的门票，我现在去想想办法，或许还能帮你们弄到…"
        },
        {
          "role": "派蒙",
          "text": "不不，你误会了。其实我们今天偶然得到了一张参赛券，但还没决定要不要参加，所以就先来这里打听一下情况。"
        },
        {
          "role": "派蒙",
          "text": "不过听你刚才的意思，这个比赛好像相当火爆啊。"
        },
        {
          "role": "斑目百兵卫",
          "text": "确实，「演武传心」本就是稻妻历史悠久的剑道赛事，对武人来说，参加比赛既是检验自身实力的好机会，更是一种荣誉。"
        },
        {
          "role": "斑目百兵卫",
          "text": "将军大人也希望借此机会，让更多人了解剑道的魅力，本次大赛就引入了不少新形式，普通民众们都很感兴趣呢。"
        },
        {
          "role": "斑目百兵卫",
          "text": "旅行者，既然你手里已经有参赛券，就考虑考虑参加比赛怎么样？毕竟机会难得。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好的，那我考虑一下。",
              "dialogues": []
            },
            {
              "text": "但我们还有其他事情要做…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斑目百兵卫",
          "text": "哦对了，你们既然是今天才听说「演武传心」，那应该还不知道吧？其实神里小姐她…"
        },
        {
          "role": "宏达",
          "text": "这么好的机会，有什么可犹豫的。"
        },
        {
          "role": "宏达",
          "text": "如果你们并不以参与「演武传心」为荣，就没必要占着这张参赛券，盼着得到参赛资格的人可有的是。"
        },
        {
          "role": "斑目百兵卫",
          "text": "宏达，你这是在说什么呀，如此出言不逊可不是我们的待客之道。"
        },
        {
          "role": "宏达",
          "text": "斑目，不是我有意羞辱他们。其实正相反，本来我是很想见识见识这位旅行者的身手的。"
        },
        {
          "role": "宏达",
          "text": "我们全府上下都听说过你的名字，小姐她本人也十分看重你，我还以为你是个了不起的英杰。"
        },
        {
          "role": "宏达",
          "text": "现在看来也不过如此，既没气魄，剑术本领嘛…大概也挺一般的，要不然早就干脆参赛了。"
        },
        {
          "role": "斑目百兵卫",
          "text": "哎呀宏达，旅行者又不是武家出身，想法肯定会有差异。再说了，气魄和剑艺，又不是一定要靠比赛体现…"
        },
        {
          "role": "派蒙",
          "text": "真是岂有此理，今天一连碰到的两拨人居然都这么不会说话，可恶。"
        },
        {
          "role": "派蒙",
          "text": "除了饿肚子之外，派蒙我最讨厌的事之一，就是旅行者被根本不了解他的人看轻。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙！",
              "dialogues": []
            },
            {
              "text": "我已经习惯了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这个宏达根本就不了解你，居然就说你又没气魄又没本领，我好生气。"
        },
        {
          "role": "派蒙",
          "text": "我要给他起个难听的绰号，就…就叫他「没眼力」！"
        },
        {
          "role": "宏达",
          "text": "话倒是不少,本事可不是耍耍嘴皮子就能证明的。我宏达是个货真价实的武人，不靠吹牛皮博名声，就不奉陪了。"
        },
        {
          "role": "斑目百兵卫",
          "text": "唉，旅行者，真是不好意思，宏达就是这种心直口快的类型。"
        },
        {
          "role": "旅行者",
          "text": "没关系，我会用实力让他心服口服。"
        },
        {
          "role": "派蒙",
          "text": "这是准备要参赛了吗？太好了，我举双手赞成！让那个宏达看看你的本事。"
        },
        {
          "role": "斑目百兵卫",
          "text": "开赛时间是两天后，赛场在离岛。刚才没来得及告诉你们，其实今天小姐就是前往离岛，和柊千里小姐核对比赛的各项事宜去了。"
        },
        {
          "role": "派蒙",
          "text": "是吗？既然这样，我们就去离岛和绫华见一面吧，也可以顺便问问她关于「演武传心」的其他事情。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（斑目百兵卫）"
        },
        {
          "role": "斑目百兵卫",
          "text": "神里小姐现在正在离岛，和勘定奉行的格千里小姐核对「演武传心」的各项事宜。"
        },
        {
          "role": "斑目百兵卫",
          "text": "小姐在这次大赛中也担负着重要的职责，既然二位要去见小姐，具体情况就请与她细聊吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（宏达）"
        },
        {
          "role": "宏达",
          "text": "你真的打算参加比赛吗？也行，到时候赛场上见。"
        },
        {
          "type": "subtitle",
          "text": "◆前往离岛寻找神里绫华"
        },
        {
          "role": "派蒙",
          "text": "绫华，千里——"
        },
        {
          "role": "神里绫华",
          "text": "旅行者，派蒙，好久不见，原来你们最近也在稻妻。"
        },
        {
          "role": "派蒙",
          "text": "嗯，其实我们决定参加「演武传心剑道大赛」了，听说你们正在离岛做准备，所以就过来看看。"
        },
        {
          "role": "柊千里",
          "text": "这真是巧了，我们才聊完「代神使」的工作，刚说到旅行者会不会对「演武传心」感兴趣呢，你就出现了。"
        },
        {
          "role": "派蒙",
          "text": "「代神使」？那是什么呀？"
        },
        {
          "role": "柊千里",
          "text": "欸，你们还不知道？难道说，你们不是因为收到绫华小姐的信才赶回稻妻的吗？"
        },
        {
          "role": "派蒙",
          "text": "咦，信？什么信？"
        },
        {
          "role": "神里绫华",
          "text": "啊，没什么，你们别在意。派蒙，你刚刚是问「代神使」对吗？"
        },
        {
          "role": "派蒙",
          "text": "对，那是什么呀？"
        },
        {
          "role": "神里绫华",
          "text": "「代神使」是「演武传心」中一项很特殊的职责。说起这个，就不得不提起这一赛事的由来了。"
        },
        {
          "role": "神里绫华",
          "text": "「演武传心」起源于稻妻古代传说，据说在很久以前，剑术冠绝稻妻的武人，将获得面见将军大人，与之切磋剑术的殊荣。"
        },
        {
          "role": "神里绫华",
          "text": "只不过，将军大人的实力实在高出人类太多，如果直接与武人较量，这场对决恐怕瞬间就结束了。"
        },
        {
          "role": "神里绫华",
          "text": "因此，将军大人派出自己的眷属作为接引武人的使者，并在切磋中为武人提供援护，让两人一同与自己对战。"
        },
        {
          "role": "神里绫华",
          "text": "由于将军大人选择以演武的形式，将自身的技艺与守护稻妻的意志传达给子民，因此这场切磋被称为「演武传心」。"
        },
        {
          "role": "神里绫华",
          "text": "后来，「演武传心」的传说演变为了剑道比赛，这场神明传授技艺的切磋，也作为赛事最后的「表演赛」被保留了下来。"
        },
        {
          "role": "神里绫华",
          "text": "通过它，后世就能了解「演武传心」的由来，也能了解到武艺所承载的意义。"
        },
        {
          "role": "派蒙",
          "text": "听起来是很重要的表演呢。"
        },
        {
          "role": "神里绫华",
          "text": "是的。现在的表演赛上，将军大人虽然不会亲自出席，但会派遣特使代表自身参战，以示神威。"
        },
        {
          "role": "神里绫华",
          "text": "饰演「武人」的，自然就是大赛的胜者了；「神明眷属」会由一位官家出身的剑士饰演，这一职责也被称为「代神使」。"
        },
        {
          "role": "神里绫华",
          "text": "本次，就是由我来担任「代神使」。"
        },
        {
          "role": "派蒙",
          "text": "原来如此！我总算知道这次比赛那么火爆的原因了！毕竟绫华在稻妻民众眼里，就是很有人气的呀。"
        },
        {
          "role": "柊千里",
          "text": "派蒙说得没错，白鹭公主虽然会出席一些祭典仪式，但能近距离见识到她超群剑术的场合可不多呢。"
        },
        {
          "role": "柊千里",
          "text": "将军大人说，这次要打造面向大众的赛事，要选一位有号召力的形象大使。既然这样，「代神使」一职也就非绫华小姐莫属了。"
        },
        {
          "role": "柊千里",
          "text": "哦对了，这位是八重堂的小野寺先生，专门负责筹备各类活动，也是我们的外援。最早就是他建议由绫华小姐来担任「代神使」的。"
        },
        {
          "role": "柊千里",
          "text": "除此之外，他提出的「扩大受众面」、「提升话题度」这两个方案，也大大增加了赛事的热度，真是帮了大忙。"
        },
        {
          "role": "派蒙",
          "text": "听上去好专业！这些方案都是什么意思呀，快说给我听听。"
        },
        {
          "role": "小野寺",
          "text": "说到「扩大受众面」，自然是要让更多的人能参与到比赛中来。"
        },
        {
          "role": "小野寺",
          "text": "过去演武传心的参赛者，必须是稻妻剑道流派的人。这次则不同，不论国籍与身份，只要有向武之心，就都能参与。"
        },
        {
          "role": "小野寺",
          "text": "同时在比赛中，使用的武器也不仅仅局限于单手剑，只要是近战武器，并且符合比赛要求的长度与重量规则即可。"
        },
        {
          "role": "小野寺",
          "text": "至于「提升话题度」，就我个人的经验来说，最有效的办法就是——举办投票。"
        },
        {
          "role": "旅行者",
          "text": "投票？"
        },
        {
          "role": "小野寺",
          "text": "没错。「代神使」在表演赛中穿着的华服，以往都是由将军大人指定，但这次在将军大人支持下我们把选择权交给了观众。"
        },
        {
          "role": "小野寺",
          "text": "大家可以在「春樱」、「秋叶」等象征四季风物的款式中选择一种进行投票，神里小姐将身着得票最多的服装出席表演赛。"
        },
        {
          "role": "柊千里",
          "text": "虽然投票要到比赛当天才会开始，但最近我家仆人已经在猜测服装的主题了。"
        },
        {
          "role": "小野寺",
          "text": "多亏神里小姐答应担任「代神使」一职，这些方案才能够成立。我知道这对于神里小姐来说，也是不小的压力。"
        },
        {
          "role": "神里绫华",
          "text": "没关系，能对推广剑道有帮助，对我而言也是一种荣幸。小野寺先生为赛事尽心尽力，大家有目共睹。"
        },
        {
          "role": "小野寺",
          "text": "神里小姐过奖了。各位，我还要回去准备投票的事，就先走一步了。"
        },
        {
          "role": "神里绫华",
          "text": "旅行者，派蒙，既然你们来了，我和千里小姐就带你们去比赛的场地看看吧，也能熟悉一下环境。"
        },
        {
          "role": "派蒙",
          "text": "好呀好呀，那我们走吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往赛场"
        },
        {
          "role": "派蒙",
          "text": "好气派的赛场啊…原来远国监司里还有这种地方，我之前都不知道呢。"
        },
        {
          "role": "神里绫华",
          "text": "这里是勘定奉行的室内练兵场。这次多亏有千里小姐帮忙，才能借用到这里的场地。"
        },
        {
          "role": "柊千里",
          "text": "不用客气，绫华小姐，能帮上忙我也很高兴。"
        },
        {
          "role": "派蒙",
          "text": "千里，那边那个是什么呀？"
        },
        {
          "role": "柊千里",
          "text": "哦，那个啊…"
        },
        {
          "role": "神里绫华",
          "text": "旅行者，现在方便…稍微和你说几句话吗？"
        },
        {
          "role": "旅行者",
          "text": "当然。"
        },
        {
          "role": "神里绫华",
          "text": "嗯，这件事应该从何说起才好呢…"
        },
        {
          "role": "旅行者",
          "text": "绫华，难道是想说「信」的事吗？"
        },
        {
          "role": "神里绫华",
          "text": "啊…果然瞒不过你的眼睛。其实，一开始听说大家希望由我来担任「代神使」时，我心里真的有些忐忑。"
        },
        {
          "role": "神里绫华",
          "text": "虽说我从小就经常在公众面前露面，但作为剑道赛事的活动大使，还要身着盛装参加演武，这还是第一次。"
        },
        {
          "role": "神里绫华",
          "text": "以前，有资格担任「代神使」的，都是稻妻官家剑术最精湛的武者，我自知和他们比起来还差得太远。"
        },
        {
          "role": "神里绫华",
          "text": "我担心自己无法胜任这一职责，所以那个时候，我曾想写封信给你，问问你的建议。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们是朋友，你不用顾虑的。",
              "dialogues": []
            },
            {
              "text": "我很愿意为你分忧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫华",
          "text": "嗯,是啊，我知道的。不过，大概正因为知道这一点我最后才没有寄出那封信。"
        },
        {
          "role": "神里绫华",
          "text": "之前，你已经帮了我很多次，也倾听了我的许多烦恼。但如果我总是向你寻求帮助的话，就感觉自己有点「输给你」了。"
        },
        {
          "role": "神里绫华",
          "text": "呵呵，作为朋友，会这样想很奇怪吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "并不奇怪。",
              "dialogues": []
            },
            {
              "text": "我能理解你的心情。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫华",
          "text": "谢谢你。但今天得知你也来参加比赛了，我真的很开心…"
        },
        {
          "role": "派蒙",
          "text": "绫华…欸，你们两个刚刚在说什么吗？"
        },
        {
          "role": "神里绫华",
          "text": "我刚刚在说，得知旅行者来参加比赛，我觉得很高兴。以他在稻妻的人望，肯定又能为赛事增加不少热度呢。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我觉得有他出场的话，比赛一定会很精彩。"
        },
        {
          "role": "柊千里",
          "text": "派蒙说的没错，我也很看好你哦。"
        },
        {
          "type": "subtitle",
          "text": "又在周围参观了一段时间后，你们离开了赛场…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "神里绫华",
          "text": "天色不早了，我和千里小姐就先回去了。你们这两天也要好好休息，不要太劳顿了。我们比赛当天再见。"
        },
        {
          "role": "派蒙",
          "text": "嗯，绫华，千里，我们比赛当天见！"
        },
        {
          "type": "subtitle",
          "text": "◆等待至两天之后"
        },
        {
          "type": "subtitle",
          "text": "◆前往赛场"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你看，绫华和千里她们在那边呢。"
        },
        {
          "role": "神里绫华",
          "text": "旅行者，派蒙，你们来了。昨天休息得怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "休息的不错。",
              "dialogues": [
                {
                  "role": "柊千里",
                  "text": "不愧是旅行者，一副气定神闲的样子。"
                }
              ]
            },
            {
              "text": "没怎么睡着呢。",
              "dialogues": [
                {
                  "role": "柊千里",
                  "text": "话虽这么说，但你还是平常那副气定神闲的样子。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼哼，赛前保持良好状态可是很重要的，这次的比赛我们志在必得。"
        },
        {
          "role": "小野寺",
          "text": "各位看起来状态不错，今天的开幕赛一定会顺利的…嗯。"
        },
        {
          "role": "派蒙",
          "text": "说起来，难道这两个箱子里装着的就是选票？"
        },
        {
          "role": "小野寺",
          "text": "我都安排好了，左边这箱是演武传心的选票，右边是给其他活动用的，投票的结果将会在你们参加第三轮比赛的时候揭晓。"
        },
        {
          "role": "小野寺",
          "text": "以旅行者的实力，参加第三轮比赛肯定是板上钉钉的事吧？"
        },
        {
          "role": "派蒙",
          "text": "那还用说！"
        },
        {
          "role": "水田",
          "text": "小野寺先生，那我们就先把「演武传心」用的投票箱拿走啦！"
        },
        {
          "role": "小野寺",
          "text": "好的，辛苦你们了！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，时间差不多了，我们准备进赛场吧。"
        },
        {
          "role": "神里绫华",
          "text": "旅行者，祝你比赛取得好成绩。"
        },
        {
          "role": "柊千里",
          "text": "好啦，我和绫华小姐也该去场边观赛了，一会儿见。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（松前&纱江）"
        },
        {
          "role": "松前",
          "text": "不知道最后的表演赛上，绫华小姐到底会穿什么样的演武华服…"
        },
        {
          "role": "纱江",
          "text": "啊，我就说嘛，之前连出门散个步都懒得动一下的你会突然对剑道大赛感兴趣，果然是因为绫华小姐的关系！"
        },
        {
          "role": "松前",
          "text": "又、又不是只有我一个人是这样！现在在稻妻，像你这种狂热的剑道爱好者毕竟是少数。而且表演赛的门票，也是我大早起来排队才买到的。"
        },
        {
          "role": "纱江",
          "text": "好啦好啦，我也没有责怪你的意思。难得有兴趣相投的时候，我们不是说好一起好好看比赛不吵架的嘛，而且说不定你也会真的对剑道产生兴趣呢。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（尤南）"
        },
        {
          "role": "尤南",
          "text": "嗯？莫非你也是「演武传心」的参赛者？"
        },
        {
          "role": "旅行者",
          "text": "你是须弥人？"
        },
        {
          "role": "尤南",
          "text": "对。咱的镀金旅团，主要负责押运从稻妻进口到须弥的货物，所以咱也经常要来离岛。"
        },
        {
          "role": "尤南",
          "text": "这次这个「演武传心」大赛，只要使的是近战武器就能报名，这种好事怎么能错过？"
        },
        {
          "role": "尤南",
          "text": "哼哼，不瞒你说，咱旅团的弟兄们在奥摩斯港，可是以武艺高强出了名的，咱的实力，更是响当当的全团第一！"
        },
        {
          "role": "尤南",
          "text": "小伙子/小姑娘，看你也像也是个舞刀弄剑的，不过这身板可欠点火候啊。要是赛场上碰见，可别怪咱下手重啊，哈哈哈哈。"
        }
      ],
