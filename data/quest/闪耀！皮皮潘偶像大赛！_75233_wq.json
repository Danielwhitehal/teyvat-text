  "stories": [
    {
      "story_id": 75233,
      "title": "闪耀！皮皮潘偶像大赛！",
      "description": "据说，悠悠度假村正在举办皮皮潘偶像大赛…",
      "dialogues": [
        {
          "role": "「希顿」",
          "text": "「承、承载绽放刺梨的奇迹，用圣火点燃你的笑容！」"
        },
        {
          "role": "派蒙",
          "text": "呜、呜哇！怪物啊！"
        },
        {
          "role": "「希顿」",
          "text": "「以悠悠度假村之名，为你献上欢迎的舞蹈，闪耀吧！皮皮潘偶像！」"
        },
        {
          "role": "派蒙",
          "text": "要、要打过来了！旅行者，救、救命啊！"
        },
        {
          "role": "「希顿」",
          "text": "啊——！"
        },
        {
          "role": "派蒙",
          "text": "咦，它怎么自己摔倒了…喂，怪怪的家伙，你、还好吗…有、有没有摔到哪里啊…"
        },
        {
          "role": "「希顿」",
          "text": "又、又失败了，我果然还是跳不好这个舞，好羞耻…啊——好想原地消失…"
        },
        {
          "role": "派蒙",
          "text": "那个…原、原来你刚才是在跳舞吗？要不你再跳一次试试？这次说不定会有好结果呢！"
        },
        {
          "role": "「希顿」",
          "text": "不行不行不行，我不行的，我做不到啊…果然，我还是没有办法成为皮皮潘偶像…"
        },
        {
          "role": "派蒙",
          "text": "完了，我现在完全搞不懂它在说什么了…欸？等一下，这个是什么？"
        },
        {
          "role": "派蒙",
          "text": "唔——《皮皮潘偶像大赛宣传册》？原来皮皮潘偶像是这个意思啊！"
        },
        {
          "role": "「希顿」",
          "text": "那、那个…"
        },
        {
          "role": "派蒙",
          "text": "哦！我明白了，你应该是对比赛没有自信，所以想要找我们给一些建议对不对？"
        },
        {
          "role": "「希顿」",
          "text": "…我、我不行的，我就连在你们面前跳舞都做不好，而、而且老爹他也说我不行…"
        },
        {
          "role": "派蒙",
          "text": "老爹？"
        },
        {
          "role": "「希顿」",
          "text": "嗯，我的老爹也是演员，也是我的偶像！"
        },
        {
          "role": "「希顿」",
          "text": "老爹他跳舞可厉害了！还教出了特别多的优秀演员！只不过…他不愿意教我…"
        },
        {
          "role": "派蒙",
          "text": "啊？为什么啊？"
        },
        {
          "role": "「希顿」",
          "text": "他、他说——「『希顿』我在你的身上根本没有看到决心！没有决心的人是没办法跳好舞蹈的！」"
        },
        {
          "role": "「希顿」",
          "text": "为了让老爹承认我，我跟他打了赌，如果我成为了皮皮潘偶像，证明了自己，他就会对我倾囊相授…"
        },
        {
          "role": "「希顿」",
          "text": "可、可是，我不仅连欢迎的舞蹈都跳不好，还出了个大丑，呜呜…"
        },
        {
          "role": "派蒙",
          "text": "别、别哭啦，你看，你不是遇到我们了吗？我和旅行者可是知名冒险家，走南闯北见得多了。"
        },
        {
          "role": "派蒙",
          "text": "有我们的帮助，你肯定可以成为皮皮潘偶像，在老爹面前证明自己啦！"
        },
        {
          "role": "「希顿」",
          "text": "真、真的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "既然派蒙都这么说了…",
              "dialogues": []
            },
            {
              "text": "嚯嚯，闪耀吧！皮皮潘偶像！",
              "dialogues": [
                {
                  "role": "「希顿」",
                  "text": "求、求求你，不要再说这句台词了！"
                },
                {
