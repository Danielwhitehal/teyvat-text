{
  "quest_id": 20505,
  "chapter_num": null,
  "chapter_title": "繁忙的冒险家协会",
  "type": "iq",
  "route": "Busy Adventurers' Guild",
  "stories": [
    {
      "story_id": 20505,
      "title": "繁忙的冒险家协会",
      "description": "愿意前来委托冒险家协会的人越来越多，凯瑟琳似乎有点忙不过来了。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与凯瑟琳对话"
        },
        {
          "role": "凯瑟琳",
          "text": "不好意思，又把你叫过来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没关系，平时受了很多照顾。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "你能这么说真是太好了，那我尽量长话短说。"
                }
              ]
            },
            {
              "text": "又有报酬可以拿了？",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "哈哈…确实是这样，看来你很感兴趣的样子。"
                }
              ]
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "很感谢你之前能帮忙完成协会的委托，冒险家协会的风评也变得越来越好了。"
        },
        {
          "role": "凯瑟琳",
          "text": "不过因为这个，愿意来委托协会的人越来越多，现在冒险家们已经有点忙不过来了。"
        },
        {
          "role": "派蒙",
          "text": "是要我们去当宣传员吗？"
        },
        {
          "role": "凯瑟琳",
          "text": "啊，不是的，有这份心我很感激。我也希望能有更多新人加入协会…"
        },
        {
          "role": "凯瑟琳",
          "text": "但现在再去找新人，有点远水救不了近火的感觉。"
        },
        {
          "role": "凯瑟琳",
          "text": "我想问问看，不知道你的朋友有时间帮这个忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "需要和他们商量一下。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "太好了，谢谢你。"
                }
              ]
            },
            {
              "text": "原来想劝我的朋友加入协会？！",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "不不不，你误会了。我明白你的朋友有各种各样的身份，让他们都加入很不现实。"
                },
                {
                  "role": "凯瑟琳",
                  "text": "这更像是协会的不情之请。"
                }
              ]
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "总之我先说明一下吧，现在比较紧急的是这种<color=#00E1FFFF>「探索派遣」</color>。"
        },
        {
          "role": "旅行者",
          "text": "「探索派遣」？"
        },
        {
          "role": "凯瑟琳",
          "text": "我们会随时关注城市周边和野外，比如存在潜在的危险，或者地下遗迹又有异常之类的情况。"
        },
        {
          "role": "凯瑟琳",
          "text": "因为不是来自他人的委托，所以没有时间限制。"
        },
        {
          "role": "凯瑟琳",
          "text": "但如果因为繁忙就长期搁置，可能隐患就会变成巨大的灾难。"
        },
        {
          "role": "派蒙",
          "text": "听起来确实很重要…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "朋友们应该可以理解。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "只要他们答应帮忙，剩下的手续交给我就好。"
                }
              ]
            },
            {
              "text": "报酬呢？",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "放心，探索中的收获协会分文不取，全都归你们。"
                }
              ]
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "那事不宜迟，为你介绍一下目前的「探索派遣」有哪些吧。"
        },
        {
          "role": "旅行者",
          "text": "确认「探索派遣」"
        },
        {
          "role": "凯瑟琳",
          "text": "你可以随时承接「探索派遣」，而执行委托的伙伴在此期间仍然可以和你一起冒险。"
        },
        {
          "role": "凯瑟琳",
          "text": "进行不同程度的探索会花费不同的时间，探索完成后，只需要来我这里确认一下成果就好了。"
        },
        {
          "role": "凯瑟琳",
          "text": "随着「冒险等阶」的提高，还可以去更多更危险的地方探索。"
        },
        {
          "role": "派蒙",
          "text": "这就是能力越大，责任越大吧！"
        },
        {
          "role": "凯瑟琳",
          "text": "是的，当然这也是为了各位的安全着想。"
        },
        {
          "role": "凯瑟琳",
          "text": "再次感谢你的帮助，希望你和你的伙伴能多多承接「探索派遣」哦。"
        }
      ]
    }
  ]
}