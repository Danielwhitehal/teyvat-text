{
  "quest_id": 41343,
  "chapter_num": null,
  "chapter_title": "蒙德人，在璃月",
  "type": "wq",
  "route": "Mondstadters in Liyue",
  "stories": [
    {
      "story_id": 41343,
      "title": "蒙德人，在璃月",
      "description": "在海灯节期间，弗莱琪和杰里似乎也有些想家了…",
      "dialogues": [
        {
          "role": "杰里",
          "text": "可是霄灯到底怎么做啊…姐姐，你知道吗？"
        },
        {
          "role": "弗莱琪",
          "text": "我不知道啊，唔…能不能拜托人帮我们去做呢…"
        },
        {
          "role": "旅行者",
          "text": "你们也想放霄灯吗。"
        },
        {
          "role": "弗莱琪",
          "text": "啊，是旅行者吗。嗯…放霄灯吗，我是挺好奇的。"
        },
        {
          "role": "弗莱琪",
          "text": "我们本来是打算先去试试海灯节特色小吃的，但杰里说，他还是想要先放盏霄灯，感受一下海灯节的氛围。"
        },
        {
          "role": "杰里",
          "text": "是…是这样！要先融入节日的氛围，再尝试节日的美食，这样才能有最全面的感受嘛。"
        },
        {
          "role": "弗莱琪",
          "text": "而且我听说放霄灯还可以许愿什么…可是我们俩谁都不知道怎么做。"
        },
        {
          "role": "弗莱琪",
          "text": "旅行者，能麻烦你帮我们做一盏霄灯吗？"
        },
        {
          "role": "旅行者",
          "text": "交给我了。"
        },
        {
          "role": "弗莱琪",
          "text": "那就拜托你了，我们就在这等着你。"
        },
        {
          "role": "弗莱琪",
          "text": "请问你做好霄灯了吗？"
        },
        {
          "role": "弗莱琪",
          "text": "谢谢你，接下来是不是就该把愿望写在霄灯上了？"
        },
        {
          "role": "弗莱琪",
          "text": "嗯…原来如此，让我想想该写点什么…"
        },
        {
          "role": "弗莱琪",
          "text": "这样应该就可以了。说起来，让霄灯带着愿望飞上天空…"
        },
        {
          "role": "弗莱琪",
          "text": "我们在蒙德的时候，也会把心事说给蒲公英听，然后把蒲公英籽撒在风中…"
        },
        {
          "role": "杰里",
          "text": "这么一说，我还挺想蒙德的，也好久都没看见蒲公英了…"
        },
        {
          "role": "弗莱琪",
          "text": "旅行者，能再麻烦你帮我们找些蒲公英籽来吗？"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "弗莱琪",
          "text": "那太好了，谢谢你愿意帮忙。找到蒲公英籽直接拿给我们就好。"
        },
        {
          "role": "弗莱琪",
          "text": "你拿到蒲公英籽了吗？"
        },
        {
          "role": "杰里",
          "text": "谢谢你，明明离开蒙德没多久，但我就是想家…"
        },
        {
          "role": "弗莱琪",
          "text": "也不知道家里人现在怎么样了…"
        },
        {
          "role": "杰里",
          "text": "唔，那我们正好趁这个机会…姐姐，你有什么心愿吗？"
        },
        {
          "role": "弗莱琪",
          "text": "我？我想一想啊…"
        },
        {
          "role": "弗莱琪",
          "text": "这样应该就可以了，旅行者，我还有件事想拜托你。"
        },
        {
          "role": "弗莱琪",
          "text": "蒲公英籽要在高处播撒才好，可是璃月的建筑和蒙德区别好大，而且我和杰里也不知道怎么去高处…"
        },
        {
          "role": "弗莱琪",
          "text": "可以请你帮我们去高处播撒这些蒲公英吗？"
        },
        {
          "role": "旅行者",
          "text": "交给我了。"
        },
        {
          "role": "弗莱琪",
          "text": "那就拜托你了。"
        },
        {
          "role": "杰里",
          "text": "姐姐，我们什么时候能回蒙德一趟啊…"
        },
        {
          "role": "弗莱琪",
          "text": "嗯…再过一会吧，我们才刚出来没多久呢…"
        },
        {
          "role": "弗莱琪",
          "text": "你好，旅行者，你已经把蒲公英籽播撒出去了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经播撒出去了。"
        },
        {
          "role": "弗莱琪",
          "text": "太好了，希望那些蒲公英能被风带回蒙德城…"
        },
        {
          "role": "杰里",
          "text": "不过，说是要融入璃月…结果姐姐你也还是忘不了在蒙德的习惯嘛，不如我们今天去找点蒙德的小吃…"
        },
        {
          "role": "弗莱琪",
          "text": "那可不行。"
        },
        {
          "role": "杰里",
          "text": "欸…欸？"
        },
        {
          "role": "弗莱琪",
          "text": "——忘不掉蒙德习俗和融入璃月氛围是两码事嘛，我们赶紧去放飞霄灯吧。"
        },
        {
          "role": "弗莱琪",
          "text": "你写好愿望了吗？等放完霄灯…我们就去尝试海灯节的特色小吃吧！"
        },
        {
          "role": "杰里",
          "text": "写，写是写好了，但还要接着吃吗？"
        },
        {
          "role": "弗莱琪",
          "text": "哼哼，那当然了，璃月海灯节的特色小吃…绝对不能错过！"
        }
      ]
    }
  ]
}