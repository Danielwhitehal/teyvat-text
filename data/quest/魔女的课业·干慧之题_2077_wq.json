{
  "quest_id": 2077,
  "chapter_num": "",
  "chapter_title": "魔女的课业·干慧之题",
  "type": "wq",
  "route": "Witch's Homework: Of Untested Insight",
  "stories": [
    {
      "story_id": 10004,
      "title": "枯井无法映星月",
      "description": "根据辞典的引导，你们准备把课题带给莫娜。看起来应该是再简单不过的事情了。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往莫娜的住处"
        },
        {
          "role": "派蒙",
          "text": "莫娜莫娜，我们来给你送东西来了。"
        },
        {
          "role": "莫娜",
          "text": "是派蒙和旅行者啊，看起来挺精神的嘛。"
        },
        {
          "role": "莫娜",
          "text": "要送我什么？如果是那种简单又来钱快的工作委托就最好不过了。"
        },
        {
          "role": "派蒙",
          "text": "好像是，你老师给你的「课题」来着。"
        },
        {
          "role": "莫娜",
          "text": "那种东西根本不想要！不对，似乎也不能这么说。人还是应该保留进取心的。"
        },
        {
          "role": "莫娜",
          "text": "不过我觉得多半是什么折腾人的东西。我太懂老太婆了。"
        },
        {
          "role": "派蒙",
          "text": "不论怎么样，你先看看？"
        },
        {
          "role": "莫娜",
          "text": "这本书…好像也没什么特殊的地方啊。"
        },
        {
          "role": "莫娜",
          "text": "啊，掉下来几封信。"
        },
        {
          "role": "派蒙",
          "text": "是和解信吗？"
        },
        {
          "role": "莫娜",
          "text": "有三封标记了序号的信。嗯，先拆第一封吧。"
        },
        {
          "role": "莫娜",
          "text": "如果这个是课题的话，那应该没什么见不得人的内容。一起看看吧。"
        },
        {
          "role": "芭比洛斯",
          "text": "「许久没见到你，腿脚都日渐不便了…」"
        },
        {
          "role": "莫娜",
          "text": "哼，想打感情牌。至少再多点真情实感吧。"
        },
        {
          "role": "芭比洛斯",
          "text": "「以前追着你打，你一边跑一边还用水元素虚影吸引我注意力的情景还历历在目。」"
        },
        {
          "role": "芭比洛斯",
          "text": "「如今你不在了，我整天就躺在摇椅上。现在确实是缺乏运动。」"
        },
        {
          "role": "莫娜",
          "text": "老——太——婆——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要不咱们还是别看了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芭比洛斯",
          "text": "「闲话不说了。你想要知道怎么测算王国甚至是世界的命运吗？」"
        },
        {
          "role": "芭比洛斯",
          "text": "「前去须弥，去寻找地底王国的大门吧。在那里打开第二封信。」"
        },
        {
          "role": "莫娜",
          "text": "看来老太婆的理论框架又进一步完善了，这是要教我看家本领了。"
        },
        {
          "role": "莫娜",
          "text": "她还真的是老了啊。"
        },
        {
          "role": "派蒙",
          "text": "你们师徒感情好奇怪啊。谈感情就吵架，谈学术就伤感…"
        },
        {
          "role": "派蒙",
          "text": "不过这个位于须弥的地下王国大门…难道是？"
        },
        {
          "role": "莫娜",
          "text": "怎么，你们有什么线索吗？"
        },
        {
          "role": "派蒙",
          "text": "我们应该知道你老师说的地方是哪里。"
        },
        {
          "role": "莫娜",
          "text": "那太好了，这下省去了我调查的时间。相当于间接省去了导游费、食宿费，这可是一笔巨款。"
        },
        {
          "role": "莫娜",
          "text": "我可一刻都等不了了。我们快出发吧。"
        },
        {
          "role": "派蒙",
          "text": "你刚才没有提到交通费，难道是说？"
        },
        {
          "role": "莫娜",
          "text": "没错，就是用老办法。一起走吧。"
        },
        {
          "type": "subtitle",
          "text": "前往坎瑞亚的大门之前"
        },
        {
          "role": "派蒙",
          "text": "呼，用这种充满夏日回忆的方法过来，人都清爽了呢。"
        },
        {
          "role": "莫娜",
          "text": "这里就是地下古国——坎瑞亚的大门吗？"
        },
        {
          "role": "莫娜",
          "text": "背后一定有着许多秘密和悲伤吧。"
        },
        {
          "role": "派蒙",
          "text": "我们来看看第二封信吧。"
        },
        {
          "role": "莫娜",
          "text": "嗯嗯，我看看。标记序号二的信封…啊，是这个。"
        },
        {
          "role": "芭比洛斯",
          "text": "「须弥有古语：解经诵卷非见道，终须智水解干慧。这片土地上有一种现象叫做『焚真之天象』。」{{#info:[[善恶的赫瓦雷纳]]}}"
        },
        {
          "role": "芭比洛斯",
          "text": "「然而『焚真之天象』只是因为对真理过于苦渴，最终燃烧了起来。叫它『渴真』或许更贴合本质。」"
        },
        {
          "role": "芭比洛斯",
          "text": "「地下古国的记载里说，坎瑞亚的几大地底镜湖都倒映着真实宇宙星海。」"
        },
        {
          "role": "芭比洛斯",
          "text": "「这正是因为水开启的『渴真天象』越过了虚假之天，联系着外部宇宙。」"
        },
        {
          "role": "莫娜",
          "text": "居然是这样！"
        },
        {
          "role": "芭比洛斯",
          "text": "「只有穿透虚假之天，宇宙星体的引力与影响才能被观测。只有拥有这些世界外的参数，才能推算世界命运。」"
        },
        {
          "role": "芭比洛斯",
          "text": "「现在，我给你的课题就是：在坎瑞亚的大门前，打开一次『渴真天象』。」"
        },
        {
          "role": "莫娜",
          "text": "后面就是老太婆推算出来的仪式和方法了。"
        },
        {
          "role": "派蒙",
          "text": "确实呢。这些行星轨迹和符文我就完全看不懂了。"
        },
        {
          "role": "派蒙",
          "text": "莫娜现在就要试试吗？"
        },
        {
          "role": "莫娜",
          "text": "虽然不想承认，但是我脑袋里快速演算了一下老太婆开发的仪式参数，似乎真的可行。"
        },
        {
          "role": "莫娜",
          "text": "现在我情绪激动，斗志昂扬。而且就这样回去又是一天住宿费。此时不做，更待何时。我要开始了！"
        },
        {
          "role": "莫娜",
          "text": "连达一切恒星的使者、君临黄赤的漫游者们，以及天上光辉的众兄啊——"
        },
        {
          "role": "莫娜",
          "text": "空虚之洞，弯折的路径。我，阿斯托洛吉斯·莫娜·梅姬斯图斯，于此以水调配平衡。"
        },
        {
          "role": "莫娜",
          "text": "以智慧、以真理缓解苦渴。我，阿斯托洛吉斯·莫娜·梅姬斯图斯，命那群星现前。"
        },
        {
          "role": "派蒙",
          "text": "成、成功了吗？"
        },
        {
          "role": "派蒙",
          "text": "呜啊，怎么冒出来了这么多怪物！"
        },
        {
          "role": "莫娜",
          "text": "看样子没完全成功。就结果而言只打开了一瞬间，然后这些怪物就穿越「渴真天象」过来了。"
        },
        {
          "role": "莫娜",
          "text": "啊啊，真生气。真实星空一眼都没看上，就拿你们撒气好了。"
        },
        {
          "type": "subtitle",
          "text": "击败出现的深渊魔物"
        },
        {
          "role": "莫娜",
          "text": "虽然打开天象的仪式失败了。但是老太婆的新理论好像确实可行。"
        },
        {
          "role": "莫娜",
          "text": "现在的我，对于水与水占的理解更加深刻了。让我拿你们试试吧。"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|深邃摹结株|1|深邃拟态·丘丘风行游侠}}{{图标|深邃摹结株|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与莫娜对话"
        },
        {
          "role": "派蒙",
          "text": "呼，总算是解决了。"
        },
        {
          "role": "莫娜",
          "text": "老太婆倒是提到了，结束之后打开第三封信。"
        },
        {
          "role": "莫娜",
          "text": "但是我没有成功，要不要打开呢？"
        },
        {
          "role": "派蒙",
          "text": "我感觉我已经理解你们师徒相处的脑回路了。"
        },
        {
          "role": "派蒙",
          "text": "你看，她只说结束，没有说成功结束。所以我觉得可以打开。"
        },
        {
          "role": "莫娜",
          "text": "确实。我感觉老太婆应该没写什么好话。"
        },
        {
          "role": "芭比洛斯",
          "text": "「如果你看到这句话，说明你真的尝试了。」"
        },
        {
          "role": "芭比洛斯",
          "text": "「不是，你真敢尝试打开啊？哈哈哈哈哈哈。」"
        },
        {
          "role": "莫娜",
          "text": "老——太——婆——！"
        },
        {
          "role": "芭比洛斯",
          "text": "「坎瑞亚因为存在过许多星海之湖，所以空间上相对不稳定，故非物理穿透天盖障更容易成功。」"
        },
        {
          "role": "芭比洛斯",
          "text": "「而且那里保密性比较好，加之位于人迹罕至的地底。如果失败了，不良影响传播比较小。」"
        },
        {
          "role": "芭比洛斯",
          "text": "「作为我的徒弟，我相信你还是能处理在虚假之天外界游弋的深渊生物的。」"
        },
        {
          "role": "芭比洛斯",
          "text": "「打不过你肯定跑得掉吧。你跑路本事这么不错。」"
        },
        {
          "role": "芭比洛斯",
          "text": "「唉，我真是天才啊。水占术氛围上对应了缓解『渴』的智慧。」"
        },
        {
          "role": "芭比洛斯",
          "text": "「实际应用上水占盘也减小了虚假之天的扰动。真不知道艾莉丝拿什么赢我——」"
        },
        {
          "type": "subtitle",
          "text": "莫娜说不用看了，后面几千字都是老太婆的自吹。\n在整理好观测结果后，大家回到了蒙德。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "解锁额外天赋「魔女的前夜礼·天步真原」",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}