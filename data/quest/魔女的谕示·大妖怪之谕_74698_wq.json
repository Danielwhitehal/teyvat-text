{
  "quest_id": 74698,
  "chapter_num": null,
  "chapter_title": "魔女的谕示·大妖怪之谕",
  "type": "wq",
  "route": "Witch's Revelation: Great Youkai's Instruction",
  "stories": [
    {
      "story_id": 74698,
      "title": "魔女的谕示·大妖怪之谕",
      "description": "在芭比洛斯的占卜摊前，你遇见了八重神子。这位稻妻的大妖怪，似乎正是芭比洛斯所做出谕示中的一员。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与八重神子对话"
        },
        {
          "role": "派蒙",
          "text": "唔…那边是神子啊，总感觉事情会变得麻烦起来呢…"
        },
        {
          "role": "派蒙",
          "text": "比如上一次「三川花祭」，虽然结果上很开心啦，只不过过程上就…{{#info:[[三川游艺绮梦谭]]}}"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "而且见面就让我们签卖身契。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不过这次…嘿嘿，不是我们出力，肯定不会被…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小声小声…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "哎呀…旅行者，小派蒙。亏我们好不容易在枫丹偶遇，你们原来…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！神神神神子，你刚才都听到了？"
        },
        {
          "role": "八重神子",
          "text": "没有。我什么都没听见，但看小派蒙的样子，应该不是什么…好话？"
        },
        {
          "role": "派蒙",
          "text": "没有没有，我们也很高兴能在这里见到神子呢，嘿嘿嘿…神子来这里是干什么的呀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（话题转移得好生硬…）",
              "dialogues": []
            },
            {
              "text": "（完全被神子诈到了…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "我这个苦命的主编，还能做什么？当然是为了八重堂的生意出来奔波啊。"
        },
        {
          "role": "八重神子",
          "text": "本来刚买了一箱子新书，准备带回去，让八重堂里的编辑们好好研读。"
        },
        {
          "role": "八重神子",
          "text": "没想到，却偶然看见了我的某位「老朋友」{{#info:[[梦见月瑞希]]，在这个占卜摊前停了很久。"
        },
        {
          "role": "八重神子",
          "text": "她平时都不怎么来神社里抽「御神签」，现在却突然对占卜起了兴趣…"
        },
        {
          "role": "八重神子",
          "text": "但在城里闲逛的时候，听说城外有一个很灵验的占卜摊位。"
        },
        {
          "role": "八重神子",
          "text": "所以，我也过来占卜了一轮，就算是…满足一下好奇心吧。"
        },
        {
          "role": "派蒙",
          "text": "欸？已经抽过了吗？亏我还想了这么半天！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抽到什么牌了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "哎呀，对我的未来这么感兴趣啊？呵，想知道的话，我也不是不可以让你们看看。不过，你们也得付出点代价才行。"
        },
        {
          "role": "八重神子",
          "text": "我想想…要不小家伙你干脆就加入八重堂，负责把你们的冒险经历整理成书吧？"
        },
        {
          "role": "八重神子",
          "text": "就按时下流行的起名方式，叫《开局捡到应急食品，而后天下无敌》好了，想想就一定能大卖。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那这本书还挺厚的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "没关系。只要有趣，多厚都行。本社之前还出版过一部叫《悖论后的地平线》的轻小说呢。<ref>捏他自日本轻小说《境界上的地平线》（<lang=\"jp\">境界上のホライズン</lang>）</ref>"
        },
        {
          "role": "八重神子",
          "text": "那本书，可是厚得和字典一样，而且还足足出了八部，算上三本设定集和六本衍生外传，叠起来都能顶到天花板了。"
        },
        {
          "role": "八重神子",
          "text": "小家伙，你要是能写这么多，那我这个主编，就亲自来做你的责任编辑，怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你就是想催我稿！",
              "dialogues": []
            },
            {
              "text": "不了不了我还要冒险…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "哎呀，那你对我抽到的牌也不感兴趣喽？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我突然也没这么想看了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是啊！其实我们也没有那么——"
        },
        {
          "role": "八重神子",
          "text": "啊，这就是我抽到的牌。"
        },
        {
          "role": "八重神子",
          "text": "用这位芭比洛斯女士的描述就是…逆位的「正义」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我蒙住眼睛了！",
              "dialogues": []
            },
            {
              "text": "我捂住耳朵了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "不想看？好吧，唉，这么不喜欢占卜，那下次你们来抽「御神签」的时候，我这个不讨人喜欢的宫司，就不帮你抽了。"
        },
        {
          "role": "八重神子",
          "text": "这么说来，你们最近是不是经常来神社挂绘马来着？不如…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这张牌抽得真好！",
              "dialogues": []
            },
            {
              "text": "正义这牌，听着就好！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我说你啊——"
        },
        {
          "role": "八重神子",
          "text": "好是好，但可惜，我抽到的这张「正义」是逆位的…是在说，我是一个坏人吗？占卜师女士。"
        },
        {
          "role": "芭比洛斯",
          "text": "虽然牌名为「正义」，但它并不代指普遍意义上的「好人」或「坏人」。"
        },
        {
          "role": "芭比洛斯",
          "text": "不如说…如今处于逆位的它，所指代的是「不诚实的人」。"
        },
        {
          "role": "八重神子",
          "text": "不诚实。怎么会呢，我平时给这小家伙解签的时候，可都是诚实得要命呢…是不是？"
        },
        {
          "role": "派蒙",
          "text": "我只记得，每次神子帮旅行者主持抽签的时候，旅行者抽到的都是大吉…"
        },
        {
          "role": "八重神子",
          "text": "那是这小家伙运气好，或者说，他待在本宫司身边的时候，运气很好。"
        },
        {
          "role": "芭比洛斯",
          "text": "运气…那倒是巧了。逆位的「正义」，确实象征着偏差的因果、失衡、不诚实…还有不满足。"
        },
        {
          "role": "芭比洛斯",
          "text": "这位妖怪小姐，应该听得懂。毕竟，「妖怪」的诞生，本就和「欲望」关系紧密。"
        },
        {
          "role": "芭比洛斯",
          "text": "对于某物的渴求，未曾完成的梦想，未竟的某种大业，被某种情感吸引…"
        },
        {
          "role": "芭比洛斯",
          "text": "只要些许契机，这些未曾被满足的「欲望」，就会生根成长，蔓延出意料之外的根芽。"
        },
        {
          "role": "芭比洛斯",
          "text": "而你这位稻妻的「大妖怪」，心中大概也埋着更为庞大的「欲望」…"
        },
        {
          "role": "八重神子",
          "text": "……"
        },
        {
          "role": "芭比洛斯",
          "text": "但更多的我也看不见了。毕竟只抽了一张牌嘛，而且逆位的「正义」也很擅长掩盖和谎言，无论是对他人，还是对自己。"
        },
        {
          "role": "八重神子",
          "text": "听着云山雾罩的，很像是我神社里各位巫女解签时候的说法。没想到来这一趟，还能收获这种全新的占卜话术，还挺有趣的。"
        },
        {
          "role": "八重神子",
          "text": "不过，有趣归有趣，但这种话术和本社的经营理念不符，不能教给各位巫女了。"
        },
        {
          "role": "八重神子",
          "text": "但总归，感谢这位魔女的占卜。有机会的话，请你也去鸣神大社坐坐，让我也为你做一做占卜，怎么样？"
        },
        {
          "role": "芭比洛斯",
          "text": "可惜，水占术就够我忙的了，可分不出空来体验其他的占卜形式。"
        },
        {
          "role": "芭比洛斯",
          "text": "但这「御神签」听着像是尼可和艾莉丝会喜欢的游乐项目，我会告诉她们的。"
        },
        {
          "role": "八重神子",
          "text": "好啊，到时候，我来主持各位魔女的抽签仪式。"
        },
        {
          "role": "八重神子",
          "text": "我保证，各位都能抽到上好的吉签。"
        },
        {
          "type": "subtitle",
          "text": "聆听八重神子的故事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "聆听故事…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "完成八重神子的故事"
        },
        {
          "type": "subtitle",
          "text": "击败9只怪物"
        },
        {
          "type": "subtitle",
          "text": "解锁额外天赋「魔女的谕示·祓所之讬宣」",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}