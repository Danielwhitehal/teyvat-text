{
  "quest_id": 41141,
  "chapter_num": null,
  "chapter_title": "望舒外送",
  "type": "eq",
  "route": "Wangshu Take-Away",
  "stories": [
    {
      "story_id": 41141,
      "title": "望舒外送",
      "description": "璃月的望舒客栈里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "言笑",
          "text": "啊？行吧，行吧，那我找别人…实在不行，我就自己跑一趟…"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去了。"
        },
        {
          "role": "言笑",
          "text": "行，那你可紧着点。"
        },
        {
          "role": "言笑",
          "text": "送的时候千万绕着魔物走，沾了奇怪的元素或者挨了一下推搡，菜就不行了。"
        },
        {
          "role": "言笑",
          "text": "要是菜被弄坏了，客人可不会收。"
        },
        {
          "role": "言笑",
          "text": "行了，反正你紧着点吧，别让客人等急了。"
        },
        {
          "role": "随缘的铃官",
          "text": "都逛了这么久了，我订的餐怎么还没送来…"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "言笑",
          "text": "哼，也好，一个叫铃官的客人本来在这投宿，早些时候在我这里订了份杏仁豆腐，钱也付好了，要我过一会送去荻花洲北边的一个地方。"
        },
        {
          "role": "言笑",
          "text": "但客栈里的生意太忙了，我可抽不开身子去送，如果你能帮忙跑一趟那就最好了，报酬少不了你的。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "随缘的铃官",
          "text": "总算送到啦，嗯…这道杏仁豆腐看起来真不错。"
        },
        {
          "role": "随缘的铃官",
          "text": "嘿嘿，谢谢你啦，哎呀…逛了这么久，总算可以吃点东西了。"
        }
      ]
    }
  ]
}