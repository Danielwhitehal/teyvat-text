{
  "quest_id": 74045,
  "chapter_num": null,
  "chapter_title": "奇石历险记",
  "type": "wq",
  "route": "Strange Stone Chronicle",
  "stories": [
    {
      "story_id": 74045,
      "title": "奇石历险记",
      "description": "为了寻找芙佳的「信物」，你们再次前往之前去过的矿脉附近…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "芙佳你怎么又跑到这里来了啦！"
        },
        {
          "role": "派蒙",
          "text": "虽然附近应该不会再出现什么魔物了，但也不知道还会不会有其它危险…"
        },
        {
          "role": "派蒙",
          "text": "一个人的话还是不要到处乱跑会比较好吧。"
        },
        {
          "role": "芙佳",
          "text": "派蒙和旅行者哥哥，我没有乱跑啦…其实我是过来找我的「信物」的…"
        },
        {
          "role": "派蒙",
          "text": "欸？你的「信物」弄丢了嘛？"
        },
        {
          "role": "芙佳",
          "text": "嗯…应该是在我之前捡石头的那个地方…"
        },
        {
          "role": "派蒙",
          "text": "唔…该不会是上次被困住的时候，一不小心丢在那里的吧！"
        },
        {
          "role": "芙佳",
          "text": "呜呜…应该就是那个时候弄丢的没错…当时因为太害怕了，完全没顾得上这些…"
        },
        {
          "role": "芙佳",
          "text": "虽然现在想起来也有点可怕，但是「信物」很重要，必须得找回来才行…"
        },
        {
          "role": "派蒙",
          "text": "唔…不过要是芙佳一个人过去找的话也太危险了，既然这样的话…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们就再去一趟之前那个地方，帮芙佳把「信物」找回来吧，芙佳就先回家等我们好啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我们吧。",
              "dialogues": []
            },
            {
              "text": "正好趁机探索一番。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芙佳",
          "text": "谢谢你们，旅行者哥哥，派蒙！我会乖乖待在家里等你们的。"
        },
        {
          "type": "subtitle",
          "text": "寻找芙佳的「信物」"
        },
        {
          "type": "subtitle",
          "text": "将找到的「信物」带给芙佳"
        },
        {
          "role": "派蒙",
          "text": "芙佳，我们回来啦！你的信物已经找到了。"
        },
        {
          "role": "？？？",
          "text": "将找到的信物交给了芙佳。"
        },
        {
          "role": "芙佳",
          "text": "嗯嗯，就是这个没错，谢谢你们！"
        },
        {
          "role": "派蒙",
          "text": "不过，我们在找信物的时候还发现了这个…"
        },
        {
          "role": "派蒙",
          "text": "是之前从来没有见过的矿石，想着说不定会是什么珍贵的宝石呢，所以就一起带回来啦。"
        },
        {
          "role": "派蒙",
          "text": "我记得芙佳说自己以前经常在这附近捡好看的石头回来，应该也有见过这样的吧？"
        },
        {
          "role": "芙佳",
          "text": "让我看看…确实很好看！不过…不是什么珍贵的石头，只是普通的石头而已…"
        },
        {
          "role": "芙佳",
          "text": "虽然在其它地方可能没有这样的矿石，不过在这里的矿脉附近到处都是！"
        },
        {
          "role": "派蒙",
          "text": "什么嘛，原来只是普通的石头啊，我还以为会很值钱呢！"
        },
        {
          "role": "派蒙",
          "text": "看起来也没有什么其它用途，我们就找个地方把它丢掉好了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不过外面的人说不定没见过…",
              "dialogues": []
            },
            {
              "text": "不过如果只在这里有的话…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哦哦，你的意思是说，如果拿到外面去卖的话，说不定可以卖个好价钱？"
        },
        {
          "role": "派蒙",
          "text": "的确外面的人肯定不会想到来美露莘的村子里面采矿，他们应该也没见过这种矿石…好聪明啊，旅行者！"
        },
        {
          "role": "派蒙",
          "text": "既然这样，我们就把这个石头拿去枫丹廷，给那里的商人看看吧！"
        },
        {
          "role": "芙佳",
          "text": "嗯，你们要是想知道更多关于矿石的事情的话，也欢迎随时来这里找我…"
        },
        {
          "role": "芙佳",
          "text": "虽然我不像姐姐一样拥有自己的宝石工坊，鉴定处理之类的事情我也不太懂…"
        },
        {
          "role": "芙佳",
          "text": "比起那些珍贵的宝石，我更喜欢收集各种各样有趣的石头…"
        },
        {
          "role": "芙佳",
          "text": "所以这附近矿脉的情况我还是很了解的！"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，知道啦，芙佳。"
        },
        {
          "type": "subtitle",
          "text": "将奇异的矿石带给枫丹廷的宝石商人"
        },
        {
          "role": "切瑟尔",
          "text": "欢迎光临，这里是全枫丹廷宝石种类最齐全的商铺，还有各类工艺品出售。"
        },
        {
          "role": "切瑟尔",
          "text": "有什么你们看得上眼的东西吗？没有的话要是有什么其它想要的也尽管问我！"
        },
        {
          "role": "旅行者",
          "text": "我们手上有些神奇的矿石…"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，既然是宝石种类最齐全的商铺，那你一定也会清楚我们手上矿石的价值咯！"
        },
        {
          "role": "切瑟尔",
          "text": "哦哦，原来你们是来兜售矿石的吗？"
        },
        {
          "role": "切瑟尔",
          "text": "那你们可找对人了，我这里的收购价格，可以说是童叟无欺。"
        },
        {
          "role": "切瑟尔",
          "text": "那么，是什么样的矿石呢…"
        },
        {
          "role": "？？？",
          "text": "你将之前找到的奇异矿石拿出来交给了切瑟尔查看。"
        },
        {
          "role": "切瑟尔",
          "text": "这…没想到竟然是连我也没见过的矿石…"
        },
        {
          "role": "切瑟尔",
          "text": "不过这奇异的色泽，这光滑的质地…肯定是非常珍稀的品类没错！"
        },
        {
          "role": "切瑟尔",
          "text": "虽然这样说不太好意思，不过恕我见识短浅，敢问这到底是什么矿石呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也不清楚。",
              "dialogues": [
                {
                  "role": "切瑟尔",
                  "text": "所以你们才来找我鉴定的吗？"
                }
              ]
            },
            {
              "text": "可能是叫「派派石」？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "什么啦，不要起奇怪的名字吧！"
                }
              ]
            },
            {
              "text": "当然是叫「闪耀的琉璃色金」。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔，是你刚编出来的名字吗？"
                },
                {
                  "role": "切瑟尔",
                  "text": "竟然是叫这样厉害的名字，怪不得看上去会这么特殊！"
                }
              ]
            }
          ]
        },
        {
          "role": "切瑟尔",
          "text": "不过这样的矿石竟然只有一块，实在可惜…"
        },
        {
          "role": "切瑟尔",
          "text": "如果能有足够的货源，说不定就可以打磨制作出足以风靡整个枫丹的饰品了。"
        },
        {
          "role": "派蒙",
          "text": "（我记得芙佳说过这样的石头在矿脉附近到处都是，要是问问她的话…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这样的矿石我们还有不少。",
              "dialogues": [
                {
                  "role": "切瑟尔",
                  "text": "真的吗，那可真是太好了！"
                }
              ]
            },
            {
              "text": "货源可是商业机密。",
              "dialogues": [
                {
                  "role": "切瑟尔",
                  "text": "哦哦，这是当然…"
                },
                {
                  "role": "切瑟尔",
                  "text": "不过，只要你们有进货的渠道那就太好了。"
                }
              ]
            },
            {
              "text": "其实在「厄里那斯」那里就有很多。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂，你怎么直接告诉他了啦！"
                },
                {
                  "role": "切瑟尔",
                  "text": "原来是从「厄里那斯」那里找到的吗？的确一般不会有人深入那里寻找矿脉…"
                }
              ]
            }
          ]
        },
        {
          "role": "切瑟尔",
          "text": "既然这样的话，你们手上的矿石我愿意买下，并且我还想通过你们的渠道购入更多的矿石，来制作一批工艺品。"
        },
        {
          "role": "切瑟尔",
          "text": "当然为表诚意，货款我会提前预付给你们，只要下次来的时候你们能把更多的矿石带给我就行了。"
        },
        {
          "role": "切瑟尔",
          "text": "怎么样，我觉得是笔公平的交易，不知你们意下如何？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我也觉得不错，那就成交啦！"
        },
        {
          "role": "切瑟尔",
          "text": "那真的是太好了，这是给你们的货款…"
        },
        {
          "role": "切瑟尔",
          "text": "这样的宝石能做出什么样的饰品呢，哈哈，我都已经开始期待了。"
        },
        {
          "role": "切瑟尔",
          "text": "那么我就在此静候佳音了。"
        },
        {
          "role": "芙佳",
          "text": "「信物」很重要，必须得找回来才行…"
        },
        {
          "role": "芙佳",
          "text": "又见到你们啦！"
        },
        {
          "role": "芙佳",
          "text": "是想知道什么关于矿石的事情吗？不管是什么都可以问我哦！"
        },
        {
          "role": "芙佳",
          "text": "虽然芙佳也不一定知道…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于珍贵的宝石…",
              "dialogues": [
                {
                  "role": "芙佳",
                  "text": "虽然附近的矿脉有很多亮闪闪的、好看的石头，但是距离真正的宝石还有很大的差距…"
                },
                {
                  "role": "芙佳",
                  "text": "如果我也能够找到真正的宝石的话，说不定就能像希露艾姐姐一样拥有自己的宝石工坊了！"
                }
              ]
            },
            {
              "text": "关于矿石的用途…",
              "dialogues": [
                {
                  "role": "芙佳",
                  "text": "欸？芙佳从来没有想过这些…我只是觉得好看才会收集各种各样的石头的…"
                }
              ]
            },
            {
              "text": "没问题了。",
              "dialogues": [
                {
                  "role": "芙佳",
                  "text": "嘿嘿，谢谢你们能过来找芙佳玩！"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}