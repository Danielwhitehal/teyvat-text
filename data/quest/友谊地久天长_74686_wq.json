{
  "quest_id": 74686,
  "chapter_num": null,
  "chapter_title": "友谊地久天长",
  "type": "wq",
  "route": "A Time-Tested Friendship",
  "stories": [
    {
      "story_id": 74686,
      "title": "友谊地久天长",
      "description": "除了拍映影，还有别的事可以一起做，有空记得找我吃饭。猎鹿人、万民堂、兰巴德酒馆、德波大饭店之类的…去露泽咖啡厅喝咖啡也是好主意。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与泽维尔对话"
        },
        {
          "role": "泽维尔",
          "text": "你好呀，大冒险家。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请称呼我为大剪辑师。",
              "dialogues": []
            },
            {
              "text": "请称呼我为广告高手！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "泽维尔",
          "text": "哈哈，看起来广告片制作没让你觉得太无聊！还好，要不然我就该自我怀疑了，是不是拿宝贵的相聚时间，做了无趣的事。"
        },
        {
          "role": "泽维尔",
          "text": "毕竟我们不总是有时间碰面，要找一位全世界旅行的冒险家，这难度不比把星星从天上扯下来低多少。"
        },
        {
          "role": "泽维尔",
          "text": "有的时候，就像现在，在咖啡馆里都能碰上你，有的时候，就算到处和人打听你去哪儿了，也没人知道。"
        },
        {
          "role": "泽维尔",
          "text": "好处是每次见到你，绝对能听到跌宕起伏的新故事，永远不会无聊。坏处是不知道哪一次和你见面就会变成最后一次。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没这么糟吧。",
              "dialogues": []
            },
            {
              "text": "我会经常找你的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "泽维尔",
          "text": "哈哈，好吧，我也觉得自己再抱怨下去，就要变成公益广告里的空巢老人了。"
        },
        {
          "role": "泽维尔",
          "text": "手头的广告片都完成得差不多了，接下来我该为拍出下一部长篇，继续焦头烂额了。咱们不见面的时候，就各自为梦想努力吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我会的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "泽维尔",
          "text": "啊，但我还是要说，有空记得找我吃饭！不在枫丹也行。"
        },
        {
          "role": "泽维尔",
          "text": "猎鹿人、万民堂、兰巴德酒馆之类的…去野炊或者打猎也可以考虑…只要我还能跟得上…总而言之，保持联络！"
        }
      ]
    }
  ]
}