{
  "quest_id": 73024,
  "chapter_num": null,
  "chapter_title": "林中奇遇",
  "type": "wq",
  "route": "Woodland Encounter",
  "stories": [
    {
      "story_id": 73024,
      "title": "林中奇遇",
      "description": "在林间道路上，见到了一位被蕈兽攻击的人。无论如何，不能放着遇到困难的人不管。",
      "dialogues": [
        {
          "role": "拉娜",
          "text": "哎呀，真是帮大忙了！谢谢你们。"
        },
        {
          "role": "拉娜",
          "text": "如二位所见，我是这边的巡林官。名字嘛，叫拉娜。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我是旅行者。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我的名字叫派蒙！我们是从别的国度来的。"
                }
              ]
            },
            {
              "text": "我们来自很远的地方…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯！我叫派蒙，他是旅行者。"
                }
              ]
            }
          ]
        },
        {
          "role": "拉娜",
          "text": "原来如此。嗯…从穿着打扮来看，确实不像是森林的子民…也不像是从黄沙里来的。透气性看起来很好，很适合在须弥行动。"
        },
        {
          "role": "派蒙",
          "text": "嗯？这么说来，既然拉娜是巡林官的话…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "应该认识提纳里？",
              "dialogues": [
                {
                  "role": "拉娜",
                  "text": "哦哦！旅行者也认识前辈吗？"
                },
                {
                  "role": "拉娜",
                  "text": "提纳里前辈虽然有着「生人勿近」的气场，但其实是很不错的人。见习的时候，受了他很多照顾呢。而且，他的耳朵很漂亮。"
                },
                {
                  "role": "派蒙",
                  "text": "嗯嗯！其实我也很想摸摸看…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "其实我也…",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "嗯…如果悄悄飞过去的话，是不是可以摸到呢？"
                        },
                        {
                          "role": "拉娜",
                          "text": "哈哈哈，如果贸然动手，提纳里前辈应该会生气吧。"
                        }
                      ]
                    },
                    {
                      "text": "派蒙可以悄悄飞过去摸。",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "喂！这样的话，提纳里会生气吧？"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "拉娜",
                  "text": "对吧？看起来很有光泽，不知道是什么样的触感。他现在在带的孩子对这个也很有兴趣…"
                },
                {
                  "role": "派蒙",
                  "text": "咦？拉娜说的，难道是…"
                },
                {
                  "role": "旅行者",
                  "text": "是柯莱吗？"
                },
                {
                  "role": "拉娜",
                  "text": "咦，旅行者也认识柯莱吗？"
                },
                {
                  "role": "拉娜",
                  "text": "柯莱的身体似乎不太好。就算是这样，她也很努力地看护着森林、祓除死域。大家都很担心她的情况。"
                }
              ]
            },
            {
              "text": "应该认识柯莱？",
              "dialogues": [
                {
                  "role": "拉娜",
                  "text": "咦，旅行者和那个孩子见过面吗？"
                },
                {
                  "role": "拉娜",
                  "text": "柯莱的身体似乎不太好。就算是这样，她也很努力地看护着森林、祓除死域。大家都很担心她的情况。"
                },
                {
                  "role": "拉娜",
                  "text": "不过，既然她身边有那个「耳朵看起来很好摸」的前辈，应该不会有问题的！"
                },
                {
                  "role": "派蒙",
                  "text": "咦？耳朵…难道是说…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "是提纳里吧？",
                      "dialogues": [
                        {
                          "role": "拉娜",
                          "text": "哦哦！旅行者也认识前辈吗？"
                        },
                        {
                          "role": "拉娜",
                          "text": "提纳里前辈虽然有着「生人勿近」的气场，但其实是很不错的人。见习的时候，受了他很多照顾呢。而且，他的耳朵很漂亮。"
                        },
                        {
                          "role": "派蒙",
                          "text": "嗯嗯！其实我也很想摸摸看…"
                        },
                        {
                          "role": "拉娜",
                          "text": "对吧？看起来很有光泽，不知道是什么样的触感。"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "其实我也…",
                              "dialogues": [
                                {
                                  "role": "派蒙",
                                  "text": "嗯…如果悄悄飞过去的话，是不是可以摸到呢？"
                                },
                                {
                                  "role": "拉娜",
                                  "text": "哈哈哈，如果贸然动手，提纳里前辈应该会生气吧。"
                                }
                              ]
                            },
                            {
                              "text": "派蒙可以悄悄飞过去摸。",
                              "dialogues": [
                                {
                                  "role": "派蒙",
                                  "text": "喂！这样的话，提纳里会生气吧？"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "是安柏吗？",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "「兔兔伯爵，出击！」"
                        },
                        {
                          "role": "派蒙",
                          "text": "…怎么想都不可能是安柏吧！"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "role": "拉娜",
          "text": "咳咳！不管怎么说，我们巡林官的职责是保护森林、帮助旅人、提供指引。"
        },
        {
          "role": "拉娜",
          "text": "诚如旅行者和派蒙所见，最近林子…应该说状况不太理想吧？无论是「蕈兽」，还是猛兽，都特别狂躁。还有「死域」…"
        },
        {
          "role": "拉娜",
          "text": "不如让我送你们一程吧？我的巡林路线接下来会经过维摩庄。到那边沿着水路，无论是去奥摩斯港，还是须弥城，都很方便。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可以，我们走吧。",
              "dialogues": [
                {
                  "role": "拉娜",
                  "text": "嗯，我会保障二位平安的！"
                }
              ]
            },
            {
              "text": "好，不过暂时有点别的事要处理…",
              "dialogues": [
                {
                  "role": "拉娜",
                  "text": "我明白了，我会暂时在这里等你们。要注意安全喔！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "咦？那边是…"
        },
        {
          "role": "拉娜",
          "text": "嘿呀！可恶的蘑菇！回去回去！"
        },
        {
          "role": "派蒙",
          "text": "呜哇，旅行者，那个人好像有危险！"
        },
        {
          "role": "派蒙",
          "text": "我们快去帮帮忙吧！"
        },
        {
          "type": "subtitle",
          "text": "帮助被攻击的人"
        },
        {
          "role": "拉娜",
          "text": "哎呀，真是帮大忙了！谢谢你们。"
