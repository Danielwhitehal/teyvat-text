{
  "quest_id": 41121,
  "chapter_num": null,
  "chapter_title": "猎鹿急送",
  "type": "eq",
  "route": "Good Hunter Express",
  "stories": [
    {
      "story_id": 41121,
      "title": "猎鹿急送",
      "description": "蒙德城的猎鹿人餐馆里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "莎拉",
          "text": "是这样吗？好吧，我去找别人帮忙派送…"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "莎拉",
          "text": "那就拜托你啦。"
        },
        {
          "role": "莎拉",
          "text": "对了，这份蒙德土豆饼刚刚出炉，可要小心点派送。"
        },
        {
          "role": "莎拉",
          "text": "千万别跑太快，别使用风之翼，也不要被卷入战斗中，不然土豆饼说不定会被碰坏的。"
        },
        {
          "role": "莎拉",
          "text": "好了，快点把这道菜送过去吧，凉了就不好吃了。"
        },
        {
          "role": "卖力的西瑞",
          "text": "呃…肚子好饿，我订的餐怎么还没送过来…"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "莎拉",
          "text": "对啊，你就是来帮忙派送订单的人吧，来得刚刚好，我刚把这份蒙德土豆饼做好。"
        },
        {
          "role": "莎拉",
          "text": "订这份土豆饼的人是西瑞先生，他已经预付好了餐费，说自己会在望风角附近等着订单送过去。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "卖力的西瑞",
          "text": "总算送来了，我都要饿死了…"
        },
        {
          "role": "卖力的西瑞",
          "text": "谢谢你，这份土豆饼我收下了。"
        }
      ]
    }
  ]
}