        {
          "role": "洛耶茨",
          "text": "呃…也许我们可以让他们签个名？摁手印？哎呀，到时候会有办法的。"
        },
        {
          "role": "艾尤恩",
          "text": "好吧，洛耶茨先生…"
        },
        {
          "role": "旅行者",
          "text": "「悬木人」。"
        },
        {
          "role": "洛耶茨",
          "text": "行！咱们出发吧。"
        },
        {
          "role": "艾尤恩",
          "text": "我真应该带一台留影机来，这样至少可以留下点实证…"
        },
        {
          "role": "旅行者",
          "text": "「流泉之众」。"
        },
        {
          "role": "洛耶茨",
          "text": "都听您的，那么咱们就出发吧。艾尤恩，你可得做好记录。"
        },
        {
          "role": "艾尤恩",
          "text": "我会的，先生。可是…他们也没有能证明我所做记录可靠性的公章啊。"
        },
        {
          "role": "洛耶茨",
          "text": "呃…也许我们可以让他们签个名？摁手印？哎呀，到时候会有办法的。"
        },
        {
          "role": "艾尤恩",
          "text": "好吧，洛耶茨先生…"
        },
        {
          "role": "旅行者",
          "text": "「流泉之众」。"
        },
        {
          "role": "洛耶茨",
          "text": "行！咱们出发吧。"
        },
        {
          "role": "艾尤恩",
          "text": "我真应该带一台留影机来，这样至少可以留下点实证…"
        },
        {
          "type": "subtitle",
          "text": "前往「回声之子」"
        },
        {
          "role": "艾尤恩",
          "text": "那个是什么？钻头？它是怎么动起来的？"
        },
        {
          "role": "洛耶茨",
          "text": "「别问泉水为何流溢，它们自古如此。」，好好欣赏就行，艾尤恩。"
        },
        {
          "role": "艾尤恩",
          "text": "好吧…但「回声之子」的朋友们的确拥有一套非常独特的审美…"
        },
        {
          "role": "洛耶茨",
          "text": "这话不假。咱们再往里面走走。旅行者，请您带路吧。"
        },
        {
          "type": "subtitle",
          "text": "前往「穆胡鲁宝石铺」"
        },
        {
          "role": "洛耶茨",
          "text": "咱们真是收获颇丰。纳塔果然是一个奇妙的国度，你说对吧，艾尤恩？"
        },
        {
          "role": "艾尤恩",
          "text": "是的，洛耶茨先生…"
        },
        {
          "role": "洛耶茨",
          "text": "唉，打起精神来，小伙子。在这里与纳塔的先生女士们亲切对话，总比在办公室对付文书好。"
        },
        {
          "role": "艾尤恩",
          "text": "您说得没错。但文书上总有一个句号，这场公差我根本看不到终点啊。"
        },
        {
          "role": "洛耶茨",
          "text": "安心，小伙子。工作总会在它应当结束的时候结束。"
        },
        {
          "role": "旅行者",
          "text": "你们还要继续考察吗？"
        },
        {
          "role": "洛耶茨",
          "text": "啊哈！您来了，看来咱们的纳塔之行可以继续了。"
        },
        {
          "role": "艾尤恩",
          "text": "向您问好，祝您健康，旅行者先生…"
        },
        {
          "role": "旅行者",
          "text": "艾尤恩看起来没什么精神…"
        },
        {
          "role": "洛耶茨",
          "text": "突然脱离办公桌，公章和报表，任谁都会不知所措。这位小伙子需要再适应一下。"
        },
        {
          "role": "洛耶茨",
          "text": "来吧，我们听您建议，这次最好去哪个部族做考察？"
        },
        {
          "role": "夏温",
          "text": "你们好。看起来你们不是部族的人，真稀奇…你们要买饰品，还是武器？"
        },
        {
          "role": "艾尤恩",
          "text": "这是…宝石？还是矿物？真漂亮！"
        },
        {
          "role": "伊蜜",
          "text": "二位客人是枫丹人吗？我们这里有很多好看的矿石！嗯…你们先看看蓝色的这一款！"
        },
        {
          "role": "伊蜜",
          "text": "如果要饰品的话，就得晚几天了，夏温师父要从头开始打造。"
        },
        {
          "role": "艾尤恩",
          "text": "洛耶茨先生，你觉得…"
        },
        {
          "role": "洛耶茨",
          "text": "谢谢您的介绍，亲爱的小姐，您真贴心…恕我冒昧，哪位是店主？"
        },
        {
          "role": "夏温",
          "text": "我是。叫我夏温就好。"
        },
        {
          "role": "洛耶茨",
          "text": "好，夏温小姐。我是来自枫丹廷沫芒宫复律庭的复律官，请问您有意向和我们签署一项合作协议吗？"
        },
        {
          "role": "夏温",
          "text": "合作协议？你们是要买饰品吗？那直接告诉我就好，我会记下来的。"
        },
        {
          "role": "洛耶茨",
          "text": "太好了，那咱们这就签个合同！艾尤恩，你带了商业合作协议吗？"
        },
        {
          "role": "艾尤恩",
          "text": "是的，先生。这是商业合作协议，保密协议，义务告知，还有咱们对接部门的合作资质证明…"
        },
        {
          "role": "艾尤恩",
          "text": "夏温小姐，请您在这里，这里…还有这里和这里签字，您有公章吗？没有的话摁一个手印也行。"
        },
        {
          "role": "夏温",
          "text": "那个…做生意我不排斥。但你们这是做什么？难道怕我毁约吗？"
        },
        {
          "role": "夏温",
          "text": "哼，要是我不守信用，你们可以直接来部族里找我，我的店铺可不会跑。"
        },
        {
          "role": "洛耶茨",
          "text": "您误会了，夏温小姐。我等会也会作为这个合作项目的负责人之一，参与这些文件的签署。"
        },
        {
          "role": "洛耶茨",
          "text": "您签多少字，摁多少手印。我也要签一样多的字，摁一样多的手印。"
        },
        {
          "role": "夏温",
          "text": "哦？这么一听，你难道连自己也不相信吗？这么多记录，难道你自己会骗自己吗？"
        },
        {
          "role": "洛耶茨",
          "text": "哈哈哈，您真敏锐。这件事我可经历了不少。"
        },
        {
          "role": "洛耶茨",
          "text": "从我个人的工作经验来谈，一个人最擅长欺骗的对象就是自己，所以这份文件必须双方一起签署。"
        },
        {
          "role": "夏温",
          "text": "你们枫丹廷真奇怪。伊蜜，你也来看看这份文件吧，我怕我有疏漏。"
        },
        {
          "role": "伊蜜",
          "text": "咦？我也要看吗？"
        },
        {
          "role": "夏温",
          "text": "多一个人见证这个「合同」，咱们的枫丹朋友肯定会更放心，来吧。"
        },
        {
          "role": "伊蜜",
          "text": "欸，欸…"
        },
        {
          "role": "艾尤恩",
          "text": "…我就是学不会洛耶茨说话的技术。"
        },
        {
          "role": "艾尤恩",
          "text": "让他们继续签合同吧。我们来结一下报酬，旅行者。"
        },
        {
          "role": "艾尤恩",
          "text": "唔，按照我们的合作协议…喏，这些东西给你，收下吧，数目应该没错。"
        },
        {
          "role": "旅行者",
          "text": "我，我什么也没干啊？"
        },
        {
          "role": "艾尤恩",
          "text": "您站在旁边，作为可靠的第三方旁观了这场商业会谈。这就足够了。"
        },
        {
          "role": "艾尤恩",
          "text": "如果就我们俩去找人谈生意。说不定一回枫丹，执律庭的人就要上门了…"
        },
        {
          "role": "艾尤恩",
          "text": "来吧，收下这些。我也要过去收文件了。"
        },
        {
          "type": "subtitle",
          "text": "前往「回声之子」"
        },
        {
          "type": "subtitle",
          "text": "观看舞台上的表演"
        },
        {
          "role": "艾尤恩",
          "text": "天哪，这是…这是舞蹈？"
        },
        {
          "role": "洛耶茨",
          "text": "非常有…表现力。让人印象深刻。"
        },
        {
          "role": "洛耶茨",
          "text": "唔，如果能把他们请去枫丹表演，说不定会是一件好事…"
        },
        {
          "role": "艾尤恩",
          "text": "您是说在歌剧院里？这…"
        },
        {
          "role": "洛耶茨",
          "text": "当然不是，我们会为这群好先生找到一个合适的场地。"
        },
        {
          "role": "洛耶茨",
          "text": "但在那之前，咱们得找到他们领头的人…好吧，我分不清谁是领头的。"
        },
        {
          "role": "艾尤恩",
          "text": "呃，也许我们可以…等他们跳完之后，再去详细问问？"
        },
        {
          "role": "洛耶茨",
          "text": "好吧，就依你说的，小伙子。但看在露景泉的份上，谁知道这场舞蹈什么时候结束…"
        },
        {
          "role": "洛耶茨",
          "text": "艾尤恩，请您先把报酬结给旅行者吧，没有他领路，咱们可找不到这里来。"
        },
        {
          "role": "洛耶茨",
          "text": "或者说，连这个部族的门朝哪边开都不知道…天哪，我都快分不出哪里是建筑，哪里是山了…"
        },
        {
          "type": "subtitle",
          "text": "前往「悬木人」"
        },
        {
          "type": "subtitle",
          "text": "与米齐卡对话"
        },
        {
          "role": "米齐卡",
          "text": "你们是来寄送物品的吗？咦？你们看起来不像是纳塔人…"
        },
        {
          "role": "旅行者",
          "text": "他们是枫丹来的。"
        },
        {
          "role": "米齐卡",
          "text": "这还真是稀奇…"
        },
        {
          "role": "艾尤恩",
          "text": "嚯…这么多信件和包裹，你们能送得过来吗？"
        },
        {
          "role": "米齐卡",
          "text": "这个不成问题。有咱们的匿叶龙伙伴帮忙，无论多少信件都能送得过来。"
        },
        {
          "role": "米齐卡",
          "text": "怎么？几位外来的客人，想要送什么信？"
        },
        {
          "role": "米齐卡",
          "text": "先说好。我们的人手有限，在纳塔之内送信没问题，去纳塔之外不行。"
        },
        {
          "role": "洛耶茨",
          "text": "嗯…请问您怎么称呼？"
        },
        {
          "role": "米齐卡",
          "text": "叫我米齐卡就好。"
        },
        {
          "role": "洛耶茨",
          "text": "好的。米齐卡先生，您认为，这里能够承受多重的货运强度？"
        },
        {
          "role": "米齐卡",
          "text": "货运强度？你是说我这里能容纳多少货吗？"
        },
        {
          "role": "米齐卡",
          "text": "跟我来吧，带你们参观一下「讯使长屋」。"
        },
        {
          "type": "subtitle",
          "text": "跟随米齐卡参观「讯使长屋」"
        },
        {
          "role": "洛耶茨",
          "text": "这么大的空间…唔，想必能容纳不少货物。"
        },
        {
          "role": "洛耶茨",
          "text": "米齐卡先生。如果您愿意的话，我想要和您签订一份货运合同。"
        },
        {
          "role": "洛耶茨",
          "text": "这份合同不需要立即履行。但我需要您留出部分存货空间和运输人手，以随时应对我方的货运需求。"
        },
        {
          "role": "米齐卡",
          "text": "提前留出人手？这可不行，我这边的人手也很紧缺，信件都要送不过来了。"
        },
        {
          "role": "洛耶茨",
          "text": "请您放心，我们不会凭着一张合同就让您空出人手。"
        },
        {
          "role": "洛耶茨",
          "text": "对于这些提前的准备，我方也会提前预付一部分货款。顺便一提，如果我们达成合作，后续的货款也会以月度结算。"
        },
        {
          "role": "米齐卡",
          "text": "也就是说，你们要提前给我钱，但却不会让我立即干活。"
        },
        {
          "role": "米齐卡",
          "text": "有意思。我们可以详细谈谈，但提前付钱对你们来说，真的能接受吗？"
        },
        {
          "role": "洛耶茨",
          "text": "哈哈哈哈，当然能接受。从某个角度说，这反而是一件好事。"
        },
        {
          "role": "洛耶茨",
          "text": "很抱歉，我没有带相关的文件…咱们只能去后面详细谈谈了。"
        },
        {
          "role": "洛耶茨",
          "text": "艾尤恩先生，请您先把报酬结给旅行者吧，没有他领路，我们可找不到这边来。"
        },
        {
          "role": "？？？",
          "text": "洛耶茨和米齐卡去了上方，开始详细谈起了合作事宜…"
        },
        {
          "role": "艾尤恩",
          "text": "好吧，总算有一件事顺利推进了。请收下这些报酬吧，旅行者。"
        },
        {
          "role": "旅行者",
          "text": "提前付钱为什么是好事？"
        },
        {
          "role": "艾尤恩",
          "text": "这个啊…洛耶茨总是说，提前付出一点代价，对于合作的双方来说都有着激励作用。"
        },
        {
          "role": "艾尤恩",
          "text": "至少，能让那些文件和流程运转地更快一些。毕竟…钱都已经付出去了。"
        },
        {
          "type": "subtitle",
          "text": "前往「悬木人」"
        },
        {
          "role": "艾尤恩",
          "text": "台子上的那个人在干什么？他为什么要攀那么高？"
        },
        {
          "role": "洛耶茨",
          "text": "看起来他似乎正在做一项运动…"
        },
        {
          "role": "艾尤恩",
          "text": "什么运动要绑着绳子从悬崖上跳下来，特巡队的训练吗？"
        },
        {
          "role": "洛耶茨",
          "text": "据我观察，这位老兄似乎玩得还挺开心的…旅行者…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们要试试吗？",
              "dialogues": [
                {
                  "role": "洛耶茨",
                  "text": "亲爱的旅行者，看在您那一笔未结算的报酬的份上，请您不要尝试谋杀我了。"
                },
                {
                  "role": "艾尤恩",
                  "text": "我光是看就要昏过去了，如果跳下去的话…就算不恐高，我也会变得恐高…"
                },
                {
                  "role": "洛耶茨",
                  "text": "拜托您了，咱们还是去一个安全的地点，进行一场单纯的会谈吧。"
                }
              ]
            },
            {
              "text": "那我们再往前走走？",
              "dialogues": [
                {
                  "role": "艾尤恩",
                  "text": "好，好…快些走吧，但要靠里面点！我可不敢看悬崖旁边…"
                },
                {
                  "role": "洛耶茨",
                  "text": "呼…这话没错。如果我们掉下去的话，亲爱的旅行者就只能亲自去枫丹一趟，找复律庭领取您那一笔未结算的报酬了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往高台的边缘"
        },
        {
          "role": "洛娅",
          "text": "欢迎，外来的客人，你们来这里是想要学攀岩吗？"
        },
        {
          "role": "艾尤恩",
          "text": "不能往下看，不能往下看，不能往下看…"
        },
        {
          "role": "旅行者",
          "text": "呼啊！"
        },
        {
          "role": "艾尤恩",
          "text": "哎哟！别吓我！真要摔下去了！"
        },
        {
          "role": "旅行者",
          "text": "你掉不下去的。"
        },
        {
          "role": "艾尤恩",
          "text": "唉，每一个失足坠落的人都曾经这么想过…"
        },
        {
          "role": "洛娅",
          "text": "哈哈哈哈，别担心，有我看着你们呢。"
        },
        {
          "role": "洛耶茨",
          "text": "那就太好了…容我稍微休息一下，我想和您谈一谈，关于之后枫丹游客的攀岩教学工作…"
        },
        {
          "role": "洛娅",
          "text": "游客？你是说会有很多枫丹人过来学习攀岩吗？"
        },
        {
          "role": "洛娅",
          "text": "好啊，我一直在教一个蒙德人学攀岩，他学得很快，现在连急风都会应对了。"
        },
        {
          "role": "洛耶茨",
          "text": "蒙德人总是很擅长对付和风有关的问题。但我请求您，别让咱们枫丹的先生小姐们在大雨天攀岩。"
        },
        {
          "role": "洛娅",
          "text": "哈哈哈哈，那怎么会？我顶多会挑一个底下有水潭的悬崖来训练枫丹的客人。"
        },
        {
          "role": "洛耶茨",
          "text": "那就再好不过了，来，咱们具体谈一谈合作的事宜吧。"
        },
        {
          "role": "洛耶茨",
          "text": "艾尤恩先生，请您先把报酬结给旅行者吧，没有他帮忙，我们可上不来。"
        },
        {
          "role": "？？？",
          "text": "洛耶茨和洛娅去了上方，开始详细谈起了合作事宜…"
        },
        {
          "role": "艾尤恩",
          "text": "就算底下是水潭，我也绝对不会靠着一根绳子攀爬悬崖的，绝不。"
        },
        {
          "role": "艾尤恩",
          "text": "这些报酬给您，旅行者。感谢您帮忙。"
        },
        {
          "role": "艾尤恩",
          "text": "…天哪，我得离悬崖再远点，太高了，真的太高了…"
        },
        {
          "type": "subtitle",
          "text": "前往「流泉之众」"
        },
        {
          "role": "洛耶茨",
          "text": "这里的音乐风格真让人耳目一新，艾尤恩，你说呢？"
        },
        {
          "role": "艾尤恩",
          "text": "确实非常新奇。和我在枫丹听过的那些曲子完全不一样。"
        },
        {
          "role": "洛耶茨",
          "text": "如果能把他们请去枫丹演奏一曲，想必效果会非常不错…"
        },
        {
          "role": "艾尤恩",
          "text": "或者，我们也可以把枫丹的乐队请过来表演？如果能够促成他们的合作…"
        },
        {
          "role": "洛耶茨",
          "text": "这是一个好主意！让我想想，分管这件事的办公室是哪一间来着？"
        },
        {
          "role": "旅行者",
          "text": "音乐也有办公室管？"
        },
        {
          "role": "洛耶茨",
          "text": "准确来说，是一个刚刚设立办公室的「协会」，这个协会致力于传承和发扬枫丹传统音乐…"
        },
        {
          "role": "洛耶茨",
          "text": "他们吸收了不少枫丹音乐家，在音乐界的影响嘛…也不可谓不大。"
        },
        {
          "role": "洛耶茨",
          "text": "如果我们想要促成枫丹音乐和纳塔音乐的合作，那必须要得到他们的帮助。"
        },
        {
          "role": "洛耶茨",
          "text": "但负责这个办公室的老兄可是一个死脑筋，不知道他能不能接受纳塔的音乐…"
        },
        {
          "role": "洛耶茨",
          "text": "嗨，还是先记个备忘录吧…艾尤恩先生，请您把报酬结给旅行者。"
        },
        {
          "role": "洛耶茨",
          "text": "我现在要去后台，和这支乐队谈一谈。唔…该用什么开场白呢…"
        },
        {
          "role": "？？？",
          "text": "洛耶茨一边思索，一边走向了演出台…"
        },
        {
          "role": "艾尤恩",
          "text": "唔，老实说，我还挺喜欢纳塔的曲子。听起来就很有活力，让人想要跳舞。"
        },
        {
          "role": "艾尤恩",
          "text": "但是很遗憾，我这一身衣服并不适合跳舞。等我下次来纳塔，一定要带一套宽松的衣服来。"
        },
        {
          "role": "艾尤恩",
          "text": "这些报酬给您，旅行者。感谢您帮忙。"
        },
        {
          "role": "艾尤恩",
          "text": "…对了，除了宽松的衣服，我还要戴一顶漂亮的帽子。"
        },
        {
          "type": "subtitle",
          "text": "前往「流泉之众」"
        },
        {
          "type": "subtitle",
          "text": "前往「奥特华的渔网」"
        },
        {
          "role": "叶莱菲",
          "text": "你好！需要定制纪念品吗？可自选颜色哦！"
        },
        {
          "role": "旅行者",
          "text": "原来是纪念品店啊。"
        },
        {
          "role": "洛耶茨",
          "text": "哈哈哈，那咱们来得正好。"
        },
        {
          "role": "洛耶茨",
          "text": "好不容易来纳塔出一趟公差，肯定要带一点纪念品回去。"
        },
        {
          "role": "艾尤恩",
          "text": "我也得给伊丝黛莱带一些礼物了。她上次送了我一顶漂亮帽子，我一直想着回礼呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是生日礼物吗？",
              "dialogues": [
                {
                  "role": "艾尤恩",
                  "text": "不是不是。她送我礼物的那个日子，离我生日很远的。"
                }
              ]
            },
            {
              "text": "她突然送你礼物？",
              "dialogues": [
                {
                  "role": "艾尤恩",
                  "text": "对，对啊，没有什么前因，我都不知道为什么…"
                }
              ]
            }
          ]
        },
        {
          "role": "艾尤恩",
          "text": "那天我下班的时候，突然被伊丝黛莱抓住了，她一下子就把一顶帽子扣在我头上。"
        },
        {
          "role": "艾尤恩",
          "text": "还说什么，在路上看见了一顶帽子很适合我，就买下来了。"
        },
        {
          "role": "艾尤恩",
          "text": "我正打算谢谢她，还准备给她钱。但伊丝黛莱一听我要给钱，就突然踢了我一脚，转头就走了…"
        },
        {
          "role": "洛耶茨",
          "text": "你活该，亲爱的艾尤恩。如果我不是指望你帮我记录文件，我现在就要用我的鞋再次狠狠踢你的屁股。"
        },
        {
          "role": "艾尤恩",
          "text": "啊？！难道是我对那个帽子的估价估错了？我绝对没有说那顶帽子不好的意思啊！"
        },
        {
          "role": "洛耶茨",
          "text": "好吧，站好了。我现在就替伊丝黛莱小姐再踢你一脚。"
        },
        {
          "role": "旅行者",
          "text": "你还是接着挑礼物吧！"
        },
        {
          "role": "叶莱菲",
          "text": "噗…！不，不好意思！不好意思…我来帮你挑礼物吧！"
        },
        {
          "role": "叶莱菲",
          "text": "那位伊丝黛莱小姐喜欢什么样式的礼物？你先告诉我吧。"
        },
        {
          "role": "艾尤恩",
          "text": "哦…好的。伊丝黛莱最喜欢蓝色，不是深蓝，是浅蓝，最好点缀一些黄色。"
        },
        {
          "role": "艾尤恩",
          "text": "她最喜欢戒指了，有时候会自己打造。但平时工作时不戴，休息的时候才戴。"
        },
        {
          "role": "艾尤恩",
          "text": "还有…哦，对了，戒指的份量不能太重，有时候她会把戒指挂在胸口…"
        },
        {
          "role": "叶莱菲",
          "text": "欸…挺详细的嘛，让我挑一挑，实在不行的话，我也可以给你定制一份礼物。"
        },
        {
          "role": "洛耶茨",
          "text": "不需担心费用。这份礼物的钱由我来出。"
        },
        {
          "role": "艾尤恩",
          "text": "洛耶茨先生…"
        },
        {
          "role": "洛耶茨",
          "text": "闭嘴，小伙子。好好地挑你的礼物。"
        },
        {
          "role": "洛耶茨",
          "text": "这些报酬给您，旅行者。感谢您把我们带到这里来。您真是拯救了不止一个人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "祝福艾尤恩。",
              "dialogues": [
                {
                  "role": "洛耶茨",
                  "text": "这个好小伙子总是有着好运气，他会搞定一切的。"
                }
              ]
            },
            {
              "text": "祝伊丝黛莱开心。",
              "dialogues": [
                {
                  "role": "洛耶茨",
                  "text": "遇见艾尤恩这么一位小伙子，这位好小姐只怕是不想开心都难。"
                }
              ]
            }
          ]
        },
        {
          "role": "洛耶茨",
          "text": "唉，瞧瞧他这模样。等回了枫丹，必须得让瑟米安给他好好上一课才行…"
        }
      ]
    }
  ]
}