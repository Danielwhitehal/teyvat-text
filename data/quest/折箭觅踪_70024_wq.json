{
  "quest_id": 70024,
  "chapter_num": null,
  "chapter_title": "折箭觅踪",
  "type": "wq",
  "route": "Mimi Tomo",
  "stories": [
    {
      "story_id": 70024,
      "title": "折箭觅踪",
      "description": "冒险家协会挂出了一份新委托，似乎与某个「奇怪的丘丘人」相关…？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往冒险家协会"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，请您过来这边！"
        },
        {
          "role": "凯瑟琳",
          "text": "抱歉占用您一些时间，请问您有兴趣接受一份新委托吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请讲无妨。",
              "dialogues": []
            },
            {
              "text": "请问是什么委托？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "是这样的。根据最近协会收到的报告，野外的丘丘人们又聚集了起来，侵扰商道。"
        },
        {
          "role": "凯瑟琳",
          "text": "为此我们也派出了不少冒险家…"
        },
        {
          "role": "凯瑟琳",
          "text": "但根据那些冒险家的说法，在集结起来的丘丘人里，他们总能发现一个奇怪的丘丘人…"
        },
        {
          "role": "凯瑟琳",
          "text": "我们猜测，那个奇怪的丘丘人，或许会和这次丘丘人骚乱有关…"
        },
        {
          "role": "凯瑟琳",
          "text": "所以，我们需要有人去捕获，或者至少驱赶那个奇怪的家伙。"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，您有兴趣接受这份委托吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "我会留意的。",
              "dialogues": []
            }     
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "谢谢您。我已经在您的地图上标注了几个地点！"
        },
        {
          "role": "凯瑟琳",
          "text": "这些地方都有丘丘人出没，请您先从这些地方开始调查吧。"
        },
        {
          "type": "subtitle",
          "text": "前去野外调查"
        },
        {
          "role": "凯瑟琳",
          "text": "如果遇见了那个奇怪的丘丘人…请您务必小心。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "呼…好险，幸好你们来了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "幸好我们来了…",
              "dialogues": []
            },
            {
              "text": "你还好吗…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾拉·马斯克",
          "text": "唉…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "明明刚刚进展还很顺利的…究竟是哪句话说错了呢…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "不管怎样…感谢你们及时搭救…"
        },
        {
          "role": "派蒙",
          "text": "她看上去很消沉呢。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "毕竟刚刚发生的事你们也看到了。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "自己跑出来和丘丘人沟通，果然还是风险太大了…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "可是…与丘丘人正常交流的机会，就这样浪费的话还是很不甘心…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这样啊…",
              "dialogues": []
            },
            {
              "text": "有什么能帮上忙的吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾拉·马斯克",
          "text": "这样的话，词典的编纂工作又要继续拖延了…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "如果有人能替我验证书中内容的准确性就好了。"
        },
        {
          "role": "旅行者",
          "text": "我可以帮忙。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "真、真的吗！太好了！那么请你们务必带上这本书！"
        },
        {
          "role": "派蒙",
          "text": "哇啊…瞬间变成了使唤人的口气…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "如果在沟通中遇到什么困难，只需查阅词条就可以解决…至少理论是这样的。"
        },
        {
          "role": "旅行者",
          "text": "理论…？"
        },
        {
          "role": "派蒙",
          "text": "所以马斯克小姐自己也不知道自己写的是什么吗！"
        },
        {
          "role": "艾拉·马斯克",
          "text": "外行才会提这样的问题！科学研究不导入现实中验证，怎么知道是否符合逻辑！"
        },
        {
          "role": "艾拉·马斯克",
          "text": "哼…算了，反正再说下去你也未必听得懂。不管怎样，这次真的很感谢你们能来相救。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "接下来你们不介意的话，就让我和你们一同去与丘丘人交涉吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "欢迎加入！",
              "dialogues": []
            }
          ]
        }
      ]
    }
  ]
}