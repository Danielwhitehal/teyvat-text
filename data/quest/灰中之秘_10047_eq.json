{
  "quest_id": 10047,
  "chapter_num": "皑尘与雪影 第三幕",
  "chapter_title": "灰中之秘",
  "type": "eq",
  "route": "A Secret Born From Ashes",
  "stories": [
    {
      "story_id": 40029,
      "title": "灰中之秘",
      "description": "你们带着故事回到雪山，前往营地与阿贝多会合。未知的秘密，或许就藏在这座神秘又危险的雪山之中…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往阿贝多的营地"
        },
        {
          "role": "派蒙",
          "text": "说起来，我已经把故事编得差不多了哦，去找阿贝多聊聊吧！"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "派蒙",
          "text": "阿贝多！"
        },
        {
          "role": "阿贝多",
          "text": "旅行者，派蒙。"
        },
        {
          "role": "阿贝多",
          "text": "看来你们已经想好故事了。"
        },
        {
          "role": "派蒙",
          "text": "对呀对呀，你呢？需要再给你一些时间吗？"
        },
        {
          "role": "阿贝多",
          "text": "不用。我也想好了。"
        },
        {
          "role": "派蒙",
          "text": "先来后到，我要先说！"
        },
        {
          "role": "阿贝多",
          "text": "好啊，请。"
        },
        {
          "role": "派蒙",
          "text": "我开始了哦！"
        },
        {
          "role": "派蒙",
          "text": "从前有一个邪恶的学者，抓着山上的骗骗花进行改造，这些骗骗花带着痛苦变成了人的样子，站在山路旁等着过往行人…"
        },
        {
          "role": "派蒙",
          "text": "只要有人理，他们就会问对方一些问题，例如：我是谁？你是谁？"
        },
        {
          "role": "派蒙",
          "text": "如果回答错误…就会哇的一声被吃掉！"
        },
        {
          "role": "阿贝多",
          "text": "嗯，真可怕。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙好可怕。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "什么呀，你们完全没被吓到嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可能是我太坚强了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不许挑我的毛病啦！你要是不满意就自己想一个嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那么，加入恐怖要素…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "骗骗花吃了人之后…",
              "dialogues": []
            },
            {
              "text": "就会变成那个人的样子！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "也就是说，身为凶手的骗骗花完全取代了被害者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "而且还要利用这个身份。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那接下来骗骗花就要进城了吧？！变成普通人的样子回到家里，把他们的家人统统吃掉…呜哇…"
        },
        {
          "role": "派蒙",
          "text": "明明是我开的头，我却觉得好可怕呀…"
        },
        {
          "role": "阿贝多",
          "text": "不错的故事呢。我能记下来吗？下次跟人聊天也许会用到。"
        },
        {
          "role": "派蒙",
          "text": "你是想拿去吓唬人吗？"
        },
        {
          "role": "阿贝多",
          "text": "嗯。"
        },
        {
          "role": "派蒙",
          "text": "这人好坏啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你编了什么故事呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "我的故事比你的故事要长一些。最早，要从一个炼金术士说起。"
        },
        {
          "role": "阿贝多",
          "text": "伟大的炼金术士创造了一号。一号带着她的骄傲，完美地融入了普通人。谁也不会想到，身边这个朋友竟然是人造人。"
        },
        {
          "role": "阿贝多",
          "text": "然而，一号并不知道，在他诞生前，炼金术师还进行过许多次试验。有些失败的残次品遭到遗弃，可他并未死去。"
        },
        {
          "role": "阿贝多",
          "text": "失败品二号被巨龙吞入腹中，跟随龙一起留在了雪山上，直到许多年后，他因为某种神秘的龙之力苏醒过来。"
        },
        {
          "role": "阿贝多",
          "text": "他看见雪山上各式各样的人，以及那个…神奇地融入了他们的一号。"
        },
        {
          "role": "阿贝多",
          "text": "二号从未想过，他们这些试验品居然能完美骗过所有人的眼睛。人们接纳一号为朋友，亲切地称呼他的名字。"
        },
        {
          "role": "阿贝多",
          "text": "而那正是二号想要的。所以，二号想要替代一号，成为那个幸福的人。"
        },
        {
          "role": "派蒙",
          "text": "呜…我、我突然觉得好冷，好吓人…"
        },
        {
          "role": "阿贝多",
          "text": "二号展开了他的计划。他偷来一号的书本与笔记，研究一号那些继承自炼金术士的学识。他很聪明，学得很快。"
        },
        {
          "role": "阿贝多",
          "text": "随后，他改变了自己原本那张脸，变成与一号完全一样的面孔。又找到一株能够拟态的雪山植物，使用龙血和炼金术改造它。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "二号将自己变成与一号完全相同的模样，又制造出了第三个个体：三号。"
        },
        {
          "role": "派蒙",
          "text": "哎？！三个？！"
        },
        {
          "role": "阿贝多",
          "text": "但不同的是，二号想要成为真正的完美之人。于是，他抹去了自己和三号脖子上象征瑕疵的印记。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "故意…抹去？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "要我说的话，抹去印记可能只是下意识所为。"
        },
        {
          "role": "阿贝多",
          "text": "他太过渴望成为完美之人，以至于忘记了，人类本就因不完美而生动。"
        },
        {
          "role": "阿贝多",
          "text": "二号的计划非常周密，三号负责吸引注意力，等一号处理掉三号之后，认为威胁已经消失的一号必然会陷入松懈。"
        },
        {
          "role": "阿贝多",
          "text": "一号落单的时刻，就是二号动手的最佳时机。除掉一号，他就能成为唯一的那个个体。"
        },
        {
          "role": "阿贝多",
          "text": "他会神不知鬼不觉地替换掉所有人记忆中的一号，继承一号的身份、住所、衣物、宝剑、名字和朋友。"
        },
        {
          "role": "阿贝多",
          "text": "而人们并不知道，他们昨天与今天见到的竟然是两个人。"
        },
        {
          "role": "派蒙",
          "text": "好吓人，好吓人啊…我再也不要相信别人了…"
        },
        {
          "role": "阿贝多",
          "text": "但就在二号实施计划之前，有个特别的陌生人出现了。二号尝试与他接触，却发现他能隐约感觉出自己和一号有所不同。"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "怎么？被吓到了吗？"
        },
        {
          "role": "派蒙",
          "text": "后来呢？那个陌生人怎么样了？"
        },
        {
          "role": "阿贝多",
          "text": "当然是被二号列为了计划中的一环。对二号来说，必须除掉的人又多了一个。"
        },
        {
          "role": "阿贝多",
          "text": "就像是院子里的三株玫瑰，外观完全一样。三株中只有一株是不带毒刺的优质品，剩下两株都是长有毒刺的劣等品。"
        },
        {
          "role": "阿贝多",
          "text": "而在这世界上，只有照顾它们的园丁能够分辨出哪一株才是优质品。"
        },
        {
          "role": "阿贝多",
          "text": "人们不喜欢带毒的植物，唯有完美的玫瑰可以卖出高价。劣等品想要掩盖自己不值钱的事实，就要用毒刺除掉园丁。"
        },
        {
          "role": "阿贝多",
          "text": "二号也是这样想的。所以他躲在暗处耐心地等待。也许再过一会儿，他的机会就要来了。他会成为真正的「人」。"
        },
        {
          "role": "旅行者",
          "text": "（这不只是故事…）"
        },
        {
          "role": "旅行者",
          "text": "（这是真实存在于过去的事。阿贝多想告诉我的，就是这些残酷又不可思议的真相。）"
        },
        {
          "role": "派蒙",
          "text": "好压抑的故事啊，后来怎么样？二号成功了吗？我都不敢想了…"
        },
        {
          "role": "阿贝多",
          "text": "幸好故事只是故事，不会成真，二号在这个故事里也没能取得成功。但在雪山，你们不能放松警惕。"
        },
        {
          "role": "阿贝多",
          "text": "用杜林的力量和血肉变异而成的怪物，也能算是莱茵多特的造物，跟我没什么不同。你们要小心这类生物。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不是这样的！你是我的朋友，不是怪物。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "很高兴听到你这么说。没关系，我知道自己的来历。你我同为异类，在你面前我无需掩饰真实。"
        },
        {
          "role": "阿贝多",
          "text": "只不过有时想到炼金术是如此伟大的学问，会有些无奈。"
        },
        {
          "role": "阿贝多",
          "text": "作为踏足大地的生命之一，渴望掌握命运，渴求创造的我们究竟有多傲慢？"
        },
        {
          "role": "阿贝多",
          "text": "旅行者，创造是傲慢的行径吗？如果不是，那我们为何称呼掌控我们、创造我们的事物为「神」？"
        },
        {
          "role": "阿贝多",
          "text": "如果是，那我们又有何资格去自居「创造者」这一身份呢。我们的敬畏和尊重，究竟要做到哪一步，要用到何处？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "处置冒牌货的时候，你是什么感觉？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "没什么特别的感觉。不过…"
        },
        {
          "role": "阿贝多",
          "text": "…偶尔想起这件事，会感到一丝悲哀。"
        },
        {
          "role": "派蒙",
          "text": "阿贝多…"
        },
        {
          "role": "？？？",
          "text": "喂——！旅行者！你在这里吗？"
        },
        {
          "role": "派蒙",
          "text": "咦，安柏的声音？"
        },
        {
          "role": "优菈",
          "text": "果然在这里啊。"
        },
        {
          "role": "安柏",
          "text": "旅行者，我们是来替塞琉斯先生传话的，山脚营地那边有重要的事，你也一起去吧。"
        },
        {
          "role": "优菈",
          "text": "冬令营接近尾声，就算是挂名教官也得就位了。"
        },
        {
          "role": "派蒙",
          "text": "我们得走了，阿贝多，先再见啦。"
        },
        {
          "role": "阿贝多",
          "text": "去忙吧。我这里还有些事，就不陪各位下山了。"
        },
        {
          "role": "安柏",
          "text": "没关系没关系，最近上下山都很顺利哦。"
        },
        {
          "role": "优菈",
          "text": "准备好就出发吧，别让营地那边久等了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿贝多）"
        },
        {
          "role": "阿贝多",
          "text": "去忙吧。怎么说你也是个教官，对吧？"
        },
        {
          "type": "subtitle",
          "text": "返回冒险家营地"
        },
        {
          "type": "subtitle",
          "text": "与塞琉斯对话"
        },
        {
          "role": "派蒙",
          "text": "咦？这个人是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道是乔尔的父亲？",
              "dialogues": []
            },
            {
              "text": "大号的乔尔…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "我来介绍一下，这位是乔瑟夫，是乔尔的父亲。"
        },
        {
          "role": "乔尔",
          "text": "爸爸！这位就是我和你说的旅行者，之前帮过我好多好多忙，这次还陪我一起堆雪人呢。"
        },
        {
          "role": "乔瑟夫",
          "text": "乔尔都和我说了，哎呀，真是太感谢你了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "团圆就好…",
              "dialogues": []
            },
            {
              "text": "没事就好…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是啊，这真是天大的好事了！"
        },
        {
          "role": "派蒙",
          "text": "等等，塞琉斯会长怎么在偷偷抹眼泪，帕拉德怎么也在这里！"
        },
        {
          "role": "安柏",
          "text": "这次帕拉德可是大功臣哦！帕拉德，你还是自己说吧。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "咳咳…"
        },
        {
          "role": "冒失的帕拉德",
          "text": "我记得那时天气不错，我预感自己将要有好运气，就坚信着自己的理念，往危险的地方去，因为越危险的地方越有宝藏嘛。"
        },
        {
          "role": "派蒙",
          "text": "怎么听开头就感觉不靠谱…"
        },
        {
          "role": "冒失的帕拉德",
          "text": "可我才稍微离队行动了一小会儿…"
        },
        {
          "role": "冒失的帕拉德",
          "text": "不小心就失足从山坡上滚了下去…"
        },
        {
          "role": "班尼特",
          "text": "呜哇…"
        },
        {
          "role": "班尼特",
          "text": "（该不会是因为和我在山上见了一面，就被我的倒霉传染了吧…）"
        },
        {
          "role": "冒失的帕拉德",
          "text": "我无意中摔在一个平时不太走到的地方…还受了点轻伤，正在感慨自己运气差到了极点…"
        },
        {
          "role": "班尼特",
          "text": "（呃…）"
        },
        {
          "role": "冒失的帕拉德",
          "text": "然后，我就遇到了听见声音跑出来看的乔瑟夫先生！"
        },
        {
          "role": "班尼特",
          "text": "哎…？"
        },
        {
          "role": "派蒙",
          "text": "哇，简直是误打误撞啊。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "我当时以为他是冒险家协会的人，也是来参加活动的。聊了几句才发现，好多事情他都记不得了，连自己的名字都不知道。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "我哪来得及想这些来龙去脉啊，雪山上太冷了，我赶紧催他跟我一起翻山回营地，有什么事等回来再说！"
        },
        {
          "role": "冒失的帕拉德",
          "text": "回到营地，我们见到了乔尔，乔尔一见到他就愣住了，跟着大叫起来：「爸爸！」他就是在这个时候突然回忆起一些事情的。"
        },
        {
          "role": "乔瑟夫",
          "text": "直到现在我的记忆都还没有完全恢复，但乔尔和他的妈妈…唯独他们，我不会…不，是不能忘记。"
        },
        {
          "role": "乔尔",
          "text": "爸爸…"
        },
        {
          "role": "乔瑟夫",
          "text": "乔尔，爸爸在，爸爸在。"
        },
        {
          "role": "派蒙",
          "text": "乔瑟夫先生，真的想不起其他事情了吗？"
        },
        {
          "role": "派蒙",
          "text": "《野猪公主》、还有雪山上你喂过的狐狸们…"
        },
        {
          "role": "乔瑟夫",
          "text": "很抱歉，我没有印象了。或许是因为脑袋受了外伤？我也不清楚了…"
        },
        {
          "role": "乔瑟夫",
          "text": "当我醒来的时候，身上全是血。就连行李也丢了，没有能够证明身份的东西。"
        },
        {
          "role": "乔瑟夫",
          "text": "我只能爬进一个山洞，安顿下来慢慢养伤，在腿脚恢复点之后，靠打猎的本能才活了下来。"
        },
        {
          "role": "乔尔",
          "text": "爸爸…我真的好担心你。"
        },
        {
          "role": "乔瑟夫",
          "text": "没事没事，乔尔不哭，爸爸这次哪里也不去了，就陪在你身边。"
        },
        {
          "role": "班尼特",
          "text": "呜…太好了，太好了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这样就好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "冒失的帕拉德",
          "text": "说起来，我就是从在山上遇到班尼特之后才变得比之前更倒霉的。"
        },
        {
          "role": "班尼特",
          "text": "我就知道！唉…我…我真是…"
        },
        {
          "role": "冒失的帕拉德",
          "text": "不不，我是想说，要不是因为这样，我根本就不可能在这么大的雪山里遇到乔瑟夫先生啊！"
        },
        {
          "role": "冒失的帕拉德",
          "text": "再说，我们不都安全回来了吗？所以你也别自责，运气这种事，差到极点说不定就会引发奇迹呢。"
        },
        {
          "role": "班尼特",
          "text": "…帕拉德…嘿嘿，你这家伙，什么时候变得这么会说话了！"
        },
        {
          "role": "冒失的帕拉德",
          "text": "啊？是吗？实、实话而已…"
        },
        {
          "role": "乔尔",
          "text": "啊，对了，我要谢谢旅行者哥哥，还有塞琉斯叔叔、优菈姐姐和安柏姐姐。"
        },
        {
          "role": "乔尔",
          "text": "大家都很照顾我，我非常珍惜这一段时间。"
        },
        {
          "role": "乔尔",
          "text": "不过，雪人离开雪山就会融化了吧。没有办法一起带走，好可惜…"
        },
        {
          "role": "优菈",
          "text": "…这我倒是有办法，稍等一下。"
        },
        {
          "role": "派蒙",
          "text": "欸？优菈？"
        },
        {
          "role": "优菈",
          "text": "…好了。乔尔，收下这个。这是坚冰的粉末，只需要加在你的雪人里，它就永远都不会融化了。"
        },
        {
          "role": "乔尔",
          "text": "哇！是真的吗？太厉害了！优菈姐姐太厉害了。"
        },
        {
          "role": "乔尔",
          "text": "爸爸，我有不会融化的雪人了！太棒了！"
        },
        {
          "role": "乔瑟夫",
          "text": "我实在是不知道要如何感谢各位了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别客气。",
              "dialogues": []
            },
            {
              "text": "大家都在为你们高兴。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "乔瑟夫",
          "text": "谢谢各位，谢谢…"
        },
        {
          "role": "乔尔",
          "text": "爸爸，我们一起去搬雪人，现在就去好不好？"
        },
        {
          "role": "乔瑟夫",
          "text": "行，那各位，我就先陪乔尔去玩了，我们改天见。"
        },
        {
          "role": "塞琉斯",
          "text": "好，好…我和帕拉德，也该再去谈一谈冒险过程中的纪律问题了。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "欸？塞、塞琉斯会长…我这算是将功补过，将功补过。"
        },
        {
          "role": "派蒙",
          "text": "大家慢走——"
        },
        {
          "role": "优菈",
          "text": "对了，我也做了这个给你和安柏，拿着吧，就当是冬天的纪念。"
        },
        {
          "role": "安柏",
          "text": "真的可以吗？对优菈来说，这是很重要的东西吧。"
        },
        {
          "role": "优菈",
          "text": "你这家伙，这种时候就不要说那么多了。"
        },
        {
          "role": "派蒙",
          "text": "哇，这下我们的雪人也不会融化了吧。太好了，旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你，优菈。",
              "dialogues": []
            },
            {
              "text": "我会好好珍惜的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "优菈",
          "text": "…你好好收着就行，不用客气。"
        },
        {
          "role": "优菈",
          "text": "那么，我和安柏还有事要处理，先告辞了。"
        },
        {
          "role": "派蒙",
          "text": "嗯！回头见！"
        },
        {
          "role": "派蒙",
          "text": "她们走啦，总觉得最近大家都有自己的事要做呢…"
        },
        {
          "role": "派蒙",
          "text": "啊！说起来，我们在雪山呆了那么久，却还是忘了找阿贝多帮忙做那个把果子变成果汁保鲜的机器…呃…"
        },
        {
          "role": "派蒙",
          "text": "要不然还是让蒂玛乌斯想办法吧，谁让他看起来最好说话！"
        },
        {
          "type": "subtitle",
          "text": "前往蒙德炼金铺"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "派蒙",
          "text": "蒂玛乌斯！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "是旅行者和派蒙啊。有什么事吗？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "等等…看你这有所图谋的表情，该不会还在想那个奇怪的要求吧！"
        },
        {
          "role": "派蒙",
          "text": "蒂玛乌斯，你会帮我们吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是你，不是我们。",
              "dialogues": []
            },
            {
              "text": "我不是很想要那种东西。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蒂玛乌斯",
          "text": "旅行者说不用，那就不用了吧…毕竟，这个要求怎么听都很奇怪啊。"
        },
        {
          "role": "派蒙",
          "text": "不行不行，没有这个我的日落果就浪费了！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "可我研究这种东西的时间都够帮你采十次果子了。"
        },
        {
          "role": "阿贝多",
          "text": "研究哪种东西？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "又见面了。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "阿贝多先生！来得正好，是这样的，派蒙想要一个能把果子变成果汁，同时又能为水果保鲜的机器，这也太…"
        },
        {
          "role": "派蒙",
          "text": "很重要！如果能发明这种东西的话，我们就再也不用担心水果腐烂啦！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "不可能啊！…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（……？！）",
              "dialogues": []
            },
            {
              "text": "（等等，他的脖子？！）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "把果子变成果汁不难，保鲜比较难办。如果只是希望水果不腐烂，倒是有不少办法。"
        },
        {
          "role": "阿贝多",
          "text": "对吧，旅行者？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（？！）",
              "dialogues": []
            },
            {
              "text": "你的脖子…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "（印记又出现了…是恶作剧？）"
        },
        {
          "role": "派蒙",
          "text": "脖子？"
        },
        {
          "role": "阿贝多",
          "text": "怎么了？我脖子上有什么东西吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…不，一切正常。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "看你的表情，还以为是我刚开了什么恶劣的玩笑呢。"
        },
        {
          "role": "旅行者",
          "text": "（果然是恶作剧！）"
        },
        {
          "role": "派蒙",
          "text": "阿贝多，你刚才说的防止水果腐烂的办法都有哪些？"
        },
        {
          "role": "阿贝多",
          "text": "比如说，把水果埋到雪山上终年不化的雪堆里。"
        },
        {
          "role": "派蒙",
          "text": "那不就吃不到了吗！"
        },
        {
          "role": "阿贝多",
          "text": "你可以住在雪山上啊。"
        },
        {
          "role": "派蒙",
          "text": "不了不了，我怕冷…"
        },
        {
          "role": "阿贝多",
          "text": "或者把那些果实交给我，我帮你带去雪山。"
        },
        {
          "role": "阿贝多",
          "text": "不过你怕冷，那就要派其他人来取果子了。"
        },
        {
          "role": "阿贝多",
          "text": "这份差事非你莫属啊，旅行者。"
        },
        {
          "role": "派蒙",
          "text": "如果是别人去跑腿，听起来可行度很高呢…要不就这么办吧？"
        },
        {
          "role": "阿贝多",
          "text": "果实埋在雪山，保质期是变长了，相对地，发芽长成果树的可能性也不是没有。"
        },
        {
          "role": "阿贝多",
          "text": "也许你下次来的时候，那些日落果已经变成果园了哦。你可以给那些树木浇水施肥，等它们结果，你就有新的日落果了。"
        },
        {
          "role": "派蒙",
          "text": "哎——？！不要啊！"
        },
        {
          "role": "派蒙",
          "text": "那样一来我们不就变成园丁了吗？本末倒置了啦！"
        },
        {
          "role": "阿贝多",
          "text": "是吗？"
        },
        {
          "role": "阿贝多",
          "text": "我倒是觉得，当个园丁，也不坏吧。"
        },
        {
          "role": "旅行者",
          "text": "（……）"
        },
        {
          "role": "旅行者",
          "text": "（园丁…呢。）"
        },
        {
          "role": "旅行者",
          "text": "（不过，没想到阿贝多会跟我开这种玩笑。难道…他一点都不在乎那个印记所代表的意义吗？）"
        },
        {
          "role": "派蒙",
          "text": "阿贝多！你干嘛老打我那些超甜日落果的主意！"
        },
        {
          "role": "阿贝多",
          "text": "哦？你很介意吗？"
        },
        {
          "role": "派蒙",
          "text": "当然啦！那可是难得一见的超超超级甜甜日落果呀，不会分你的！"
        },
        {
          "role": "阿贝多",
          "text": "嗯，只是日落果而已。应该是因为你手上没有多少同等级别的果实，才会对此感到介意。"
        },
        {
          "role": "阿贝多",
          "text": "如果一个人把口袋装得满满的，他的心灵也得到充实，就不会轻易陷入这种情绪了。"
        },
        {
          "role": "派蒙",
          "text": "哎？是这样吗…？"
        },
        {
          "role": "旅行者",
          "text": "（…原来如此，是这样啊。）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿贝多）"
        },
        {
          "role": "阿贝多",
          "text": "雪山气温太低，一般的果树很难在那里生存。不过…"
        },
        {
          "role": "阿贝多",
          "text": "假如有一天雪山上有了花园和果园，人们接近雪山的理由也会变多吧。说不定，生命才是吸引人的根本。"
        },
        {
          "role": "阿贝多",
          "text": "生命可能以各种意想不到的形式存在于各种不可思议的环境之中。神秘却又顽强…或许这就是它的极致之处。"
        }
      ],
