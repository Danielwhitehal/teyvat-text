{
  "quest_id": 76122,
  "chapter_num": null,
  "chapter_title": "与月嬉戏",
  "type": "wq",
  "route": "Come Play With the Moon",
  "stories": [
    {
      "story_id": 76122,
      "title": "与月嬉戏",
      "description": "在「银月之庭」，哥伦比娅似乎有想做的事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同哥伦比娅见面"
        },
        {
          "role": "哥伦比娅",
          "text": "哈哈，唔…好痒。"
        },
        {
          "role": "哥伦比娅",
          "text": "啊！嘘…"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅？"
        },
        {
          "role": "派蒙",
          "text": "咦？奇怪，刚刚好像听到了哥伦比娅的声音…"
        },
        {
          "role": "哥伦比娅",
          "text": "…嘿！"
        },
        {
          "role": "派蒙",
          "text": "噫！"
        },
        {
          "role": "哥伦比娅",
          "text": "你们好。"
        },
        {
          "role": "派蒙",
          "text": "不好不好，又被你吓了一大跳，你在的话怎么不早说嘛！"
        },
        {
          "role": "哥伦比娅",
          "text": "我想你们已经熟悉这种游戏了，所以这次适当增加了一点难度…"
        },
        {
          "role": "派蒙",
          "text": "可恶，下次我也要找机会吓你一跳！"
        },
        {
          "role": "哥伦比娅",
          "text": "好呀，那我期待着。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哥伦比娅你的眼罩呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "哦，似乎是刚才和月灵们玩耍的时候，被它们蹭掉了。"
        },
        {
          "role": "哥伦比娅",
          "text": "我平时也不用睁眼，这样没什么区别，它们喜欢的话，就让它们拿着玩玩吧。"
        },
        {
          "role": "派蒙",
          "text": "话说回来，哥伦比娅不打算多去外面走走吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不需要再躲着谁了吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "嗯…现在时间很多，想什么时候动身都行。"
        },
        {
          "role": "哥伦比娅",
          "text": "但想到你们或许会来找我，不告而别的话，可能会让你们担心吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这种时候…",
              "dialogues": []
            },
            {
              "text": "留张纸条就行了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是呀是呀，只要让我们知道你没事就好。"
        },
        {
          "role": "哥伦比娅",
          "text": "好的，那我会考虑的。"
        },
        {
          "role": "派蒙",
          "text": "只是考虑而已啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说不定哥伦比娅就是喜欢这里。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "在这里发生的事，对我来说都是愉快的记忆。"
        },
        {
          "role": "哥伦比娅",
          "text": "不过，我在这等你们还有另外一个原因。"
        },
        {
          "role": "派蒙",
          "text": "嗯？"
        },
        {
          "role": "哥伦比娅",
          "text": "我想给你们一个惊喜。"
        },
        {
          "type": "subtitle",
          "text": "前往惊喜地点"
        },
        {
          "type": "subtitle",
          "text": "同哥伦比娅对话"
        },
        {
          "role": "派蒙",
          "text": "哇！这就是你们提到过的那个地方吧？上次我不在，都没能看到。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真的很漂亮。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我可以四处飞着看看吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "当然。"
        },
        {
          "role": "哥伦比娅",
          "text": "喜欢的话，以后我也可以再带你们过来。"
        },
        {
          "role": "派蒙",
          "text": "这就是你想给我们的惊喜吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "原来这种程度就算派蒙心中的惊喜了吗？但还不是。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有比这更厉害的？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "我们来作画吧。"
        },
        {
          "role": "派蒙",
          "text": "在这里画画吗？可是哪里有画布、画笔和颜料呀？"
        },
        {
          "role": "哥伦比娅",
          "text": "很简单。"
        },
        {
          "role": "哥伦比娅",
          "text": "将水面纺作画布，月光织作画笔，你我途经的轨迹就会构成画作的轮廓。"
        },
        {
          "role": "哥伦比娅",
          "text": "顺着月之倒影的指引，将纯净的意念流转到脚下。"
        },
        {
          "type": "subtitle",
          "text": "跟随月之指引，绘制图案"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，没错，就像是这样。"
        },
        {
          "role": "哥伦比娅",
          "text": "我们同行一段吧。"
        },
        {
          "role": "哥伦比娅",
          "text": "当旅人前进的时候，月亮也伴着他前进。"
        },
        {
          "role": "哥伦比娅",
          "text": "当旅人驻足的时候，月亮也稍作停留。"
        },
        {
          "role": "哥伦比娅",
          "text": "需要拜托你绘制的线条在另一边，是我的月亮带错路了吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "你在看我吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "这样就完成了。"
        },
        {
          "type": "subtitle",
          "text": "同哥伦比娅对话"
        },
        {
          "role": "努昂诺塔",
          "text": "……！"
        },
        {
          "role": "派蒙",
          "text": "努昂诺塔！真的是水灵灵的努昂诺塔！我还以为再也见不到你了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刚才的画作…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "我们用月光为这孩子勾勒出了形体，我在其中注入了新的力量与赐福，让它再度诞生。"
        },
        {
          "role": "哥伦比娅",
          "text": "现在的它无须承载我的灵魂，它拥有独属于它自己的意志。"
        },
        {
          "role": "努昂诺塔",
          "text": "！！"
        },
        {
          "role": "派蒙",
          "text": "啊，它飞过来了！"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，我唤醒了它与你们共度时光里的所有记忆。"
        },
        {
          "role": "努昂诺塔",
          "text": "……！……！"
        },
        {
          "role": "派蒙",
          "text": "呜，太好了努昂诺塔，今后我一定会对你更加好一点。"
        },
        {
          "role": "派蒙",
          "text": "没想到是这个惊喜…我好喜欢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你，哥伦比娅。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "没什么。能再次见到努昂诺塔，我也很高兴。"
        },
        {
          "role": "努昂诺塔",
          "text": "……！"
        },
        {
          "role": "哥伦比娅",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "（她还是那么中意努昂诺塔，但她的神情和从前相比又有不同。）"
        },
        {
          "role": "旅行者",
          "text": "（好像它之于她不仅是被创造的眷属，更是熟悉的朋友。）"
        },
        {
          "role": "哥伦比娅",
          "text": "去吧，你一定很想他们了吧。"
        },
        {
          "role": "努昂诺塔",
          "text": "……！"
        },
        {
          "role": "哥伦比娅",
          "text": "随时欢迎你们再来。"
        },
        {
          "type": "subtitle",
          "text": "返回「银月之庭」"
        },
        {
          "type": "subtitle",
          "text": "额外对话（哥伦比娅&努昂诺塔）"
        },
        {
          "role": "哥伦比娅",
          "text": "我知道你很喜欢旅行者和派蒙，但不要给他们添麻烦哦。"
        },
        {
          "role": "哥伦比娅",
          "text": "要是和他们在外面玩累了的话，就回来这里休息吧。"
        },
        {
          "role": "努昂诺塔",
          "text": "……！"
        }
      ],
      "collapse_ranges": [
        [
          73,
          76
        ]
      ]
    }
  ]
}