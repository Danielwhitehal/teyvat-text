{
  "quest_id": 75500,
  "chapter_num": null,
  "chapter_title": "前卫理念与涂鸦先锋！",
  "type": "wq",
  "route": "Avant-Garde Graffiti Visionary!",
  "stories": [
    {
      "story_id": 75500,
      "title": "前卫理念与涂鸦先锋！",
      "description": "「回声之子」的舞蹈令派蒙惊叹不已，而在舞台之下，某位有着独特见解的纳塔艺术家看中了你和派蒙散发出的才气…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往观看「回声之子」的舞蹈活动"
        },
        {
          "role": "派蒙",
          "text": "呜哇…"
        },
        {
          "role": "派蒙",
          "text": "仔细看的时候才发现，台上这些「回声之子」跳的舞真厉害哇！人的身体居然能做出这么夸张的动作…"
        },
        {
          "role": "派蒙",
          "text": "配合节奏感超强的音乐，还有刺激的火光，相比其他国家的艺术，有着完全不同的气质！"
        },
        {
          "role": "？？？",
          "text": "这位容光焕发的少年，还有飘浮着的哇音玩偶。"
        },
        {
          "role": "？？？",
          "text": "我看你们感官敏锐，气质不凡，肯定能成为前卫艺术的先锋，涂鸦画师的超新星！"
        },
        {
          "role": "「炫彩呆子」",
          "text": "要跟着我「炫彩呆子」一起混，把握最新潮的艺术理念吗？"
        },
        {
          "role": "派蒙",
          "text": "哇啊，又是奇怪的外号！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还在哇。",
              "dialogues": []
            },
            {
              "text": "哇音派蒙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这次我可不会被带偏了——重点不在于哇不哇，或者新外号，而是这个「炫彩呆子」说的话。"
        },
        {
          "role": "派蒙",
          "text": "「前卫的理念」，听起来好像是…纳塔艺术与众不同的关键点？"
        },
        {
          "role": "「炫彩呆子」",
          "text": "好悟性~"
        },
        {
          "role": "「炫彩呆子」",
          "text": "如你所见，富有张力的舞姿、律动跳脱的音乐、还有色彩鲜明的涂鸦，这些都离不开前卫理念的熏陶。"
        },
        {
          "role": "「炫彩呆子」",
          "text": "在纳塔人的口中，时尚、潮流、新奇之类的说法，全都是前卫理念的同义词。"
        },
        {
          "role": "「炫彩呆子」",
          "text": "而我「炫彩呆子」作为「涂鸦联盟」的中流砥柱，正尝试让更多人理解前卫，践行前卫，用前卫把世界碾一遍…"
        },
        {
          "role": "「炫彩呆子」",
          "text": "从而让更多艺术不断进步，创造出非同凡响的美学产物，画出更狂猛的大尺寸涂鸦稿！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好难懂。",
              "dialogues": []
            },
            {
              "text": "太抽象了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「炫彩呆子」",
          "text": "那就说点具体的，比如舞台背景的那幅大型涂鸦，我也参与了它的绘制。"
        },
        {
          "role": "「炫彩呆子」",
          "text": "假如背景换成一幅写实的风景画、枫丹的唯美油画，或是须弥的壁画…"
        },
        {
          "role": "「炫彩呆子」",
          "text": "你觉得搭调吗？"
        },
        {
          "role": "派蒙",
          "text": "这个比方倒是很直白，我好像有点明白了…"
        },
        {
          "role": "派蒙",
          "text": "如果背景的图形和配色没现在的涂鸦这么夸张，音乐和舞蹈，好像确实也少了点劲头？"
        },
        {
          "role": "「炫彩呆子」",
          "text": "当然，我并不是说风景画、油画或壁画就不好。只是它们在需要强调张力和锐气的场合，不如前卫的涂鸦那么合适！"
        },
        {
          "role": "「炫彩呆子」",
          "text": "要我说，不管纳塔的哪个部族，都有一种向上冲击，追求锐势的气魄，因此，前卫也可以说是纳塔的主调！"
        },
        {
          "role": "派蒙",
          "text": "明明名字里有「呆子」这个词，懂的道理却挺多的嘛，你好厉害！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你要收我们为徒吗？",
              "dialogues": []
            },
            {
              "text": "学你的本事多少摩拉？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「炫彩呆子」",
          "text": "嘿！你这反应，挺老辣啊？"
        },
        {
          "role": "「炫彩呆子」",
          "text": "不用紧张，我们不拘泥于死板的师徒关系，不在乎钱和名分，我们注重的是分享经验，期待分享之物到处开花结果。"
        },
        {
          "role": "「炫彩呆子」",
          "text": "只要你能洞察到前卫艺术的精髓，并创作出相应的涂鸦作品，我就非常满意了。"
        },
        {
          "role": "「炫彩呆子」",
          "text": "甚至会大把大把倒贴你摩拉和物资，帮助你迅速成长为可靠的涂鸦高手…"
        },
        {
          "role": "「炫彩呆子」",
          "text": "然后来帮我画稿。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "啊？我来画稿？",
              "dialogues": []
            },
            {
              "text": "吔？这样抓助手？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「炫彩呆子」",
          "text": "或者帮我把涂鸦艺术宣传到其他地方，吸引更多人才加入涂鸦联盟。"
        },
        {
          "role": "「炫彩呆子」",
          "text": "毕竟我们的目标是给纳塔的每座山画上无比前卫的涂鸦，只凭寥寥十几个人肯定忙不过来。"
        },
        {
          "role": "「炫彩呆子」",
          "text": "我的背，我的腰…哎呀…成天举着染料罐画来画去，说不定骨头都歪了，肩膀和大腿都错位了。"
        },
        {
          "role": "派蒙",
          "text": "本来想说事出反常必有妖，换成其他人，我甚至有点担心是不是骗子…"
        },
        {
          "role": "派蒙",
          "text": "不过看你说得这么诚实，好像确实没什么可疑的地方。"
        },
        {
          "role": "派蒙",
          "text": "学一手涂鸦的本领，说不定以后还能派上用场，比如…画一面「旅行者和派蒙领地之墙」，吓跑魔物和坏人！"
        },
        {
          "role": "「炫彩呆子」",
          "text": "不愧是我看中的人选，痛快！那我们就进入正题了——"
        },
        {
          "role": "「炫彩呆子」",
          "text": "涂鸦这门手艺，对画技的要求并不严苛，在我看来，与其先练画，不如先去找准前卫理念的准绳。"
        },
        {
          "role": "派蒙",
          "text": "准绳？是…原则的意思吗？"
        },
        {
          "role": "「炫彩呆子」",
          "text": "差不多吧！总之要找到超脱拘束的灵感，并将其自由自在地表达出来。"
        },
        {
          "role": "「炫彩呆子」",
          "text": "为此，你们可以像我一样，在竞速挑战中捕捉风景扭曲形变的样貌，在近身搏斗中找寻人体动作的极限…"
        },
        {
          "role": "「炫彩呆子」",
          "text": "如此一来，就能构思涂鸦所需要的夸张线条。"
        },
        {
          "role": "「炫彩呆子」",
          "text": "至于色彩方案，将多种自然界的物品混搭，综合它们的配色，往往能获得意想不到的惊喜…"
        },
        {
          "role": "派蒙",
          "text": "听起来有点熟悉…又不太对劲。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在竞速和打架中观察线条。",
              "dialogues": []
            },
            {
              "text": "收集各种物产，研究色彩。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这种研究「艺术理念」的方法还真不一样，果然，纳塔人思考的方式真的很特别…"
        },
        {
          "role": "「炫彩呆子」",
          "text": "那么，收下我的这份涂鸦指南，带上这台留影机，在纳塔各处大闹一番，顺带好好感受这个国家独特之气的熏陶吧…"
        },
        {
          "role": "「炫彩呆子」",
          "text": "等到你们归来的时候，我就能根据你们的见闻，帮你们总结出最能让你们理解的前卫理念！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「炫彩呆子」）"
        },
        {
          "role": "「炫彩呆子」",
          "text": "哟，两位涂鸦新星，还有什么想了解的吗？"
        },
        {
          "role": "「炫彩呆子」",
          "text": "要是你们没问题，准备出发了，我也动身去野外转一转，找找还没被涂鸦装点的好山崖。你们的节奏可不能输给我啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于涂鸦这门艺术…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，感觉纳塔到处都是花花绿绿的涂鸦，屋子上，树上，山上，甚至人身上…"
                },
                {
                  "role": "派蒙",
                  "text": "这好像是你们的习俗？你们是从什么时候开始画涂鸦的呢？"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "哦呀，你们想要了解纳塔涂鸦的历史？问得好！"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "现在我们这些普通人掌握的涂鸦技术，其实是「燃素刻录纹」泛化后的产物。"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "你们或许已经听说过「燃素刻录纹」了，它是由专业的刻录师操刀，为强大的部族战士刻下的花纹。"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "每个部族都有着不同的花纹，无论是在和龙伙伴们的交流中，还是战斗之中，「燃素刻录纹」都有大用处。"
                },
                {
                  "role": "派蒙",
                  "text": "好像有点印象…原来那个叫「燃素刻录纹」吗？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "感觉是很不一般的象征…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "没错，在我们这些普通人看来，「燃素刻录纹」是勇气、能力和荣誉的符号，没有比这更前卫的东西了。"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "所以有人就会模仿刻录师们，在各种地方喷涂类似的花纹。"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "当然，他们是强者，我们是凡人，不一样。我们的作品没有情绪表达之外的任何功用。"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "久而久之，喷涂的内容就从「燃素刻录纹」扩展成了各种图形，主打一个随心所欲的表达，演变成了如今的涂鸦。"
                },
                {
                  "role": "派蒙",
                  "text": "强者的象征啊，感觉还挺有道理的…原来涂鸦背后还有这么一段演化的历史。"
                },
                {
                  "role": "派蒙",
                  "text": "这么说来，我们也可以在「尘歌壶」里找几座墙壁足够大的房子，画上我们旅途中遇见过的强者！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "哈哈，那我先画某位吟游诗人！",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "感觉挺合适的呢，可不可以在卖唱的身边再画一群猫猫？"
                        }
                      ]
                    },
                    {
                      "text": "见多识广的客卿可担此重任。",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "可以喔，想想就感觉安心！不过阿圆会不会不敢再打盹了？"
                        }
                      ]
                    },
                    {
                      "text": "御建鸣神主尊大御所大人像？",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "要画得威严一点吗？我们要不要多养一些团雀？"
                        }
                      ]
                    },
                    {
                      "text": "摩诃善法大吉祥智慧主如何？",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "那我们再好好装点一下壶中洞天，多种些漂亮的花花草草！"
                        }
                      ]
                    },
                    {
                      "text": "也有点想画枫丹第一的大明星。",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "好主意！那华丽的露天舞台必不可少，再研究研究漂亮的灯光方案…"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "画，都可以画！"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "等到你们的技艺成熟了，把所有想画的同伴和事物用一幅涂鸦展现出来，都不成问题！"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "不过，在此之前，你们要先理解涂鸦的核心理念，好好练习一番。"
                },
                {
                  "role": "派蒙",
                  "text": "那是当然！你就等着好啦，我们学东西向来很快的！"
                }
              ]
            },
            {
              "text": "关于前卫艺术理念…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "一提到前卫这个词，你就滔滔不绝，难道以前被很严格的老师教导过？"
                },
                {
                  "role": "派蒙",
                  "text": "不过，你应该没有离开过纳塔才对，纳塔本地也有这种专门教艺术的学校吗？"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "学校？我没去过那种地方。"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "我说的这些东西，都是根据我自己的经历，结合冒险家们从外地带来的书籍，慢慢寻思出来的。"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "真要说起来，应该是我来教别人才对？"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "正好，我还准备在涂鸦联盟的总部留出一块培训新人的区域…"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "如果这次成功让你们发掘出了涂鸦的才能，干脆之后的新人都由我来带好了。"
                },
                {
                  "role": "派蒙",
                  "text": "总部？我以为涂鸦联盟就像七圣召唤牌手，是一种只存在于身份上的说法。"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "我们好歹有着…追赶冒险家协会的远大志向，总部自然不能少，借钱凑钱也要建出来！"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "按照计划，总部的建设应该花不了多少时间，有机会的话，一定要趁早来玩玩啊！"
                }
              ]
            },
            {
              "text": "关于你的名字…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我之前就想问了，你真的就叫…「炫彩呆子」吗？你的本名呢？"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "嗨呀，对于我们这些涂鸦画手来说，真名不重要，称号才是一切！"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "我的这个称号可是来源于一个特别特别特别厉害的朋友…"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "她说我擅长发现炫目的色彩，给人的感觉很厉害，别人说我调配涂鸦颜料时有点呆呆的，两者结合起来就是这个称号了！"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "虽然我们认识以后并没有经常一起玩，但这个称号一直在鼓舞我！"
                },
                {
                  "role": "派蒙",
                  "text": "特别厉害的朋友带来的外号…好像也可以理解？"
                },
                {
                  "role": "派蒙",
                  "text": "不过「呆子」这个词…也许钻研「前卫理念」的人，已经不会在意个别词语的意思了吧…"
                }
              ]
            },
            {
              "text": "我们继续研究去了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯嗯，我们要按你的指引，继续去取材！"
                },
                {
                  "role": "「炫彩呆子」",
                  "text": "好呀，记得用心看，仔细看！然后，尝试让自己的思维夸张地运转起来！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          50,
          53
        ]
      ]
    }
  ]
}