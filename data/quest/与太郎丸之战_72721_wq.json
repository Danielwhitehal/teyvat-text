{
  "quest_id": 72721,
  "chapter_num": null,
  "chapter_title": "与太郎丸之战",
  "type": "wq",
  "route": "Versus Taroumaru",
  "stories": [
    {
      "story_id": 72721,
      "title": "与太郎丸之战",
      "description": "来者乃是最终亦是最强的对手，木漏茶室老板——太郎丸是也！",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与太郎丸对话"
        },
        {
          "role": "太郎丸",
          "text": "呜汪？汪汪！汪！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "怎么是太郎丸？",
            "「最强武者」是太郎丸！"
          ]
        },
        {
          "role": "派蒙",
          "text": "之前听安彦太郎说，第四位武者是因为手头有点紧才来参加比试的，看来太郎丸的目标也是获胜者的礼金。"
        },
        {
          "role": "派蒙",
          "text": "虽然有点不好意思，可在钱这件事上，我是不会让步的！"
        },
        {
          "role": "太郎丸",
          "text": "呜汪？"
        },
        {
          "role": "太郎丸",
          "text": "汪汪，汪汪汪汪！汪汪汪！！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "太郎丸的叫声变大了。",
            "该不是激怒它了…"
          ]
        },
        {
          "role": "派蒙",
          "text": "太郎丸，这可是堂堂正正的比试，礼金应该属于你和旅行者之中武艺更强的那个。"
        },
        {
          "role": "派蒙",
          "text": "不过如果我们赢了的话，也可以给你买点好吃的。"
        },
        {
          "role": "太郎丸",
          "text": "汪，汪汪汪汪汪，汪汪汪！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "虽然听不懂，但是来吧。",
            "虽然听不懂，但我还需要准备一下。"
          ]
        },
        {
          "role": "太郎丸",
          "text": "汪！"
        }
      ]
    }
  ]
}