    {
      "story_id": 71701,
      "title": "阿桂的药材需求",
      "description": "璃月港的阿桂需要三朵清心。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将三朵清心交给阿桂"
        },
        {
          "role": "旅行者",
          "text": "关于清心…"
        },
        {
          "role": "阿桂",
          "text": "啊，你是看到我的那个委托了对吧。太好了，总算有人来帮忙了…"
        },
        {
          "role": "阿桂",
          "text": "怎么样，你已经搜集齐三朵清心了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "搜集齐了。",
              "dialogues": []
            },
            {
              "text": "还没有…",
              "dialogues": [
                {
                  "role": "阿桂",
                  "text": "那你搜集齐了之后，就快点拿过来吧，还有病人等着用呢。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与阿桂对话"
        },
        {
          "role": "阿桂",
          "text": "这三朵清心的品质还不错。这些东西请你收下，多谢了。"
        },
        {
          "role": "阿桂",
          "text": "我要赶紧去把这些清心送过去了，还有病人等着要用呢。"
        }
      ]
    }
  ]
