{
  "quest_id": 2059,
  "chapter_num": "祈祝福愿，倾告嵴锋 第二幕",
  "chapter_title": "喑哑的回声",
  "type": "lq",
  "route": "Hoarse Echoes",
  "stories": [
    {
      "story_id": 15017,
      "title": "喑哑的回声",
      "description": "你们按照约定的时间去拜访了夏温。在她的邀请下，你们决定去见一见那位「前铸名师」特拉佐莉。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与夏温对话"
        },
        {
          "role": "夏温",
          "text": "喔！你们来得挺早啊，看来很期待那份礼物嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想探望特拉佐莉和妮赫佳。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对呀。妮赫佳生了那么一场大病，特拉佐莉女士还失去了那么重要的工作…"
                },
                {
                  "role": "派蒙",
                  "text": "虽然情况好转了，但不知道她们能不能打起精神来。"
                }
              ]
            },
            {
              "text": "所以，那份礼物到底是什么…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我也很在意…不过，我们也是想去看看妮赫佳的情况啦。"
                },
                {
                  "role": "派蒙",
                  "text": "她生了那么重的病，不知道恢复得怎么样了，还有特拉佐莉女士…"
                },
                {
                  "role": "派蒙",
                  "text": "失去了那么重要的工作，也不知道她能不能重新打起精神来。"
                }
              ]
            }
          ]
        },
        {
          "role": "夏温",
          "text": "哈哈哈，我已经托人去给特拉佐莉打过招呼了，她应该已经做好了所有准备。"
        },
        {
          "role": "夏温",
          "text": "我们赶紧出发吧，伊蜜，麻烦你照顾好店，等会我就回来。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊蜜）"
        },
        {
          "role": "伊蜜",
          "text": "又是我一个人看店？唉…请你们看好夏温师父，别让她再去危险的地方了。"
        },
        {
          "type": "subtitle",
          "text": "与夏温一同去拜访特拉佐莉"
        },
        {
          "type": "subtitle",
          "text": "额外对话（延古）山顶"
        },
        {
          "type": "subtitle",
          "text": "人状态"
        },
        {
          "role": "延古",
          "text": "…"
        },
        {
          "type": "subtitle",
          "text": "魂附状态"
        },
        {
          "role": "延古",
          "text": "饿，挖土，好累…"
        },
        {
          "role": "夏温",
          "text": "就是这里了。这屋子看着还挺气派的吧？稍等，我过去敲门。"
        },
        {
          "role": "夏温",
          "text": "特拉佐莉，开门吧，我把那两位带来啦。"
        },
        {
          "role": "夏温",
          "text": "…特拉佐莉？你在吗？开开门啊。"
        },
        {
          "role": "夏温",
          "text": "怪了，这门…呃，怎么是锁死的。这个时间她应该不会出去啊。"
        },
        {
          "role": "夏温",
          "text": "妮赫佳，妮赫佳？我是夏温姐姐，给我们开开门吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一点反应也没有…",
              "dialogues": []
            },
            {
              "text": "要把门撞开吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "难道特拉佐莉女士和妮赫佳又出事了？还是妮赫佳的病情又…呜…我不敢想了…"
                },
                {
                  "role": "夏温",
                  "text": "你别瞎想，昨天我来的时候，她们母女俩的情况很好，妮赫佳在自己的屋里睡得可安稳了。"
                }
              ]
            }
          ]
        },
        {
          "role": "夏温",
          "text": "真奇怪，我都和特拉佐莉说好了…难道是她临时带着小妮赫佳出去拿药了？"
        },
        {
          "role": "派蒙",
          "text": "咦？这旁边是什么地方，看着像是小嵴锋龙的窝。"
        },
        {
          "role": "夏温",
          "text": "没错，特拉佐莉有一只嵴锋龙伙伴，我记得名字好像是叫…「延古」来着。"
        },
        {
          "role": "夏温",
          "text": "之前她还在做锻造工作时，经常让延古帮忙做些挖掘工作。"
        },
        {
          "role": "夏温",
          "text": "但自从妮赫佳生病之后，特拉佐莉就再也没让延古挖掘过什么…"
        },
        {
          "role": "夏温",
          "text": "等等，这周围怎么乱七八糟的？延古也不见了。"
        },
        {
          "role": "派蒙",
          "text": "呜哇！还有好多箱子碎掉了，不会是遇见了什么坏事吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "靠近点看看。",
              "dialogues": []
            },
            {
              "text": "夏温小姐先呆在这。",
              "dialogues": [
                {
                  "role": "夏温",
                  "text": "喔…喔！好的，我…我我我这就找个地方藏起来！"
                },
                {
                  "role": "夏温",
                  "text": "伊蜜这孩子的嘴难道是被大灵祝福过，怎么每次说我别去危险的地方，我就会遇见危险…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（夏温）"
        },
        {
          "role": "夏温",
          "text": "伊蜜这孩子的嘴难道是被大灵祝福过，怎么每次说我别去危险的地方，我就会遇见危险…"
        },
        {
          "type": "subtitle",
          "text": "寻找与特拉佐莉或延古有关的线索"
        },
        {
          "role": "派蒙",
          "text": "痕迹只延伸到悬崖这边…难道那只嵴锋龙爬到山顶上去了？"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们要不要上去山顶看看？"
        },
        {
          "type": "subtitle",
          "text": "寻找延古"
        },
        {
          "role": "派蒙",
          "text": "真有一只嵴锋龙在上面，不知道是不是特拉佐莉女士养的那一只…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看起来，不像是遇见危险。",
              "dialogues": []
            },
            {
              "text": "他好像是自己跑上来的…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…不对不对，我们是来找特拉佐莉女士的，这周围也没看见她呀。"
        },
        {
          "type": "subtitle",
          "text": "你们听到山底传来夏温的呼喊…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "夏温",
          "text": "喂——旅行者——派蒙——"
        },
        {
          "role": "派蒙",
          "text": "夏温小姐在喊什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旁边多了一个人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏温",
          "text": "快下来吧——特拉佐莉在这里——"
        },
        {
          "role": "派蒙",
          "text": "欸？我们刚上来，特拉佐莉女士就回来了？这叫什么事啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "总之先下去吧。",
              "dialogues": []
            },
            {
              "text": "事情可真巧…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "总而言之，我们还是先下去吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这只嵴锋龙怎么跟上来了？呜啊，别突然冲过来呀，要撞到啦！"
        },
        {
          "type": "subtitle",
          "text": "和嵴锋龙一起下到了山底…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "特拉佐莉",
          "text": "延古，过来，你怎么又调皮了？"
        },
        {
          "role": "延古",
          "text": "呜…"
        },
        {
          "role": "特拉佐莉",
          "text": "好孩子。是不是饿了？抱歉…等会就给你做好吃的。"
        },
        {
          "role": "特拉佐莉",
          "text": "去吧，先去玩吧，等会我来陪你。"
        },
        {
          "role": "延古",
          "text": "呜！"
        },
        {
          "role": "特拉佐莉",
          "text": "抱歉二位。我本来是在家等着你们，但没想到妮赫佳却一个人偷偷跑了出去。"
        },
        {
          "role": "特拉佐莉",
          "text": "我找到妮赫佳的时候，这孩子说，想要给客人做一份礼物，所以就想去采几束漂亮的花。"
        },
        {
          "role": "特拉佐莉",
          "text": "她一边采花一边走，到最后居然迷了路…呼，幸好我及时找到了她。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "妮赫佳的身体没问题吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我们听夏温小姐说，她的病才刚刚好…"
        },
        {
          "role": "特拉佐莉",
          "text": "那孩子身体还是太虚弱了，先是受了惊，又吹了凉风，现在有些低烧。刚吃过药后，就回去睡着了。"
        },
        {
          "role": "特拉佐莉",
          "text": "不是什么大问题，只要休息一晚上应该就能好。"
        },
        {
          "role": "特拉佐莉",
          "text": "可是…她今天应该没办法和二位见面了，实在抱歉，让你们白跑了一趟。"
        },
        {
          "role": "派蒙",
          "text": "没有没有，不用道歉啦。我们之前听夏温小姐说，妮赫佳生了好严重的病，好不容易才痊愈。"
        },
        {
          "role": "派蒙",
          "text": "所以，我们今天想来看看妮赫佳的情况…无论如何，还是养好身体最重要啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她之前的病，已经痊愈了吗？",
              "dialogues": [
                {
                  "role": "特拉佐莉",
                  "text": "…至少，现在这孩子能和我说话，也能正常生活了。"
                },
                {
                  "role": "特拉佐莉",
                  "text": "我已经满足了，再别无他求…"
                }
              ]
            },
            {
              "text": "她都能乱跑了，看来状况不错。",
              "dialogues": [
                {
                  "role": "特拉佐莉",
                  "text": "是啊，特别是我让她吃蔬菜的时候，她跑得可快了。"
                },
                {
                  "role": "特拉佐莉",
                  "text": "跳过椅子，躲在桌子下面…在屋里绕啊绕，我怎么都追不上她。"
                },
                {
                  "role": "特拉佐莉",
                  "text": "看着妮赫佳如今的样子，我已经满足了，再别无他求…"
                }
              ]
            }
          ]
        },
        {
          "role": "夏温",
          "text": "好啦好啦，你们怎么把气氛聊得这么低落。"
        },
        {
          "role": "夏温",
          "text": "小妮赫佳的心意，我们是已经感受到了。但是特拉佐莉，我之前和你说的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是礼物！",
              "dialogues": []
            },
            {
              "text": "期待期待，礼物礼物。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "喔！到底是什么礼物呀，现在能够告诉我们了吧？"
        },
        {
          "role": "特拉佐莉",
          "text": "这份礼物，就是我制作的「燃晶名刻」。用最纯净的矿石打造，几乎不会被磨损。"
        },
        {
          "role": "特拉佐莉",
          "text": "制作它的技术，也全都源自于打造「古名」的技艺。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那，那这不就是「简易古名」？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "特拉佐莉",
          "text": "噗…可不能这么说，大灵也许会怪罪我的。我只是采用了打造古名的技艺，以矿石为原料，制作出这样的结晶体。"
        },
        {
          "role": "特拉佐莉",
          "text": "刚做出这样的结晶体时，我还觉得它除了「好看」和「永不磨损」之外，也没什么实际用途…"
        },
        {
          "role": "特拉佐莉",
          "text": "还是夏温给我出了个主意。她建议我，把这个结晶体做成一种特殊的「首饰」…"
        },
        {
          "role": "夏温",
          "text": "「由『古名工匠』所打造的『燃晶名刻』，在上面镌刻下永不磨损的字句。」"
        },
        {
          "role": "夏温",
          "text": "怎么样，听起来是不是还挺有购买欲望的？"
        },
        {
          "role": "派蒙",
          "text": "加上这么多描述之后，突然觉得这个「燃晶名刻」好厉害…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你挺会做生意的…",
              "dialogues": []
            },
            {
              "text": "不愧是开店的老板…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏温",
          "text": "哈哈哈，但特拉佐莉制作的「燃晶名刻」确实很有意义啊。"
        },
        {
          "role": "夏温",
          "text": "口口相传的话语总是不牢靠的。在转述的过程中，它会变得残缺，逐渐被遗忘，甚至被讹传。"
        },
        {
          "role": "夏温",
          "text": "但如果将话语刻在这枚「燃晶名刻」上，就可以让它恒久存在。而且意义明确，绝无半点扭曲的可能！"
        },
        {
          "role": "夏温",
          "text": "无论是送给自己重要的朋友，心上的恋人，或是家里的后辈，都再合适不过了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是不是开始推销了？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "说得我都快要心动了。唔，旅行者，不然我们也买一个吧，把我们的名字都刻上去？"
                },
                {
                  "role": "派蒙",
                  "text": "等我们找到你的妹妹/哥哥之后，再让她/他亲手把名字也刻上去。"
                }
              ]
            },
            {
              "text": "我都快被说动了…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "买一个也不错呀。把我们的名字都刻上去。等我们找到你妹妹/哥哥之后，再让她/他亲手把名字也刻上去。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这样子，我们的名字就能永远挨在一起了，嘿嘿。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙已经被吸引住了啊…",
              "dialogues": []
            },
            {
              "text": "听起来有点太珍贵了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏温",
          "text": "你们可别推辞啊，你们救了我，也救了小妮赫佳的生日礼物。这笔钱我还是愿意出的。"
        },
        {
          "role": "特拉佐莉",
          "text": "夏温，我之前和你说…"
        },
        {
          "role": "夏温",
          "text": "你也不许推辞，特拉佐莉。我知道做一枚「燃晶名刻」要费多少功夫。"
        },
        {
          "role": "特拉佐莉",
          "text": "谢谢你，夏温。还有旅行者。我会尽快做出来的，到时候，再请你们来亲自刻写。"
        },
        {
          "role": "特拉佐莉",
          "text": "那个时候，小妮赫佳应该也恢复好了。有你们来探望，她一定会很高兴的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好东西独享也不太好…",
              "dialogues": []
            },
            {
              "text": "干脆多买几个送人好了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "喂！你想得也太远了，这东西搞不好会很贵的喔，我们的旅费真的还够吗？"
        },
        {
          "role": "派蒙",
          "text": "等一下，难道这份礼物其实是夏温小姐的计划，想把我们拖进一个超大的花钱陷阱里？"
        },
        {
          "role": "夏温",
          "text": "说不定喔，毕竟…你们看起来也有不少积蓄…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！不行不行，旅行者，你可不能乱花钱！"
        },
        {
          "role": "夏温",
          "text": "哈哈哈，那你们就自己商量吧。"
        },
        {
          "type": "subtitle",
          "text": "你们正在交谈，延古再次凑了过来…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "延古",
          "text": "呜！"
        },
        {
          "role": "派蒙",
          "text": "咦？！它怎么又出来了，旅行者快拦住它！我不想再被撞啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "乖乖的喔！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "延古",
          "text": "呜…"
        },
        {
          "role": "夏温",
          "text": "特拉佐莉，我还要麻烦你，帮忙修一下我这枚「燃晶名刻」。"
        },
        {
          "role": "夏温",
          "text": "之前被袭击的时候，我把它落在地上，系绳和接口全都坏掉了，没法时刻随身戴着。"
        },
        {
          "role": "夏温",
          "text": "我自己也尝试修过，但怎么修都不牢固，只能拜托你了。"
        },
        {
          "role": "特拉佐莉",
          "text": "没问题。交给我吧！保证修得和原来一模一样。"
        },
        {
          "role": "特拉佐莉",
          "text": "…谢谢你，夏温。谢谢你愿意…"
        },
        {
          "role": "夏温",
          "text": "没关系，特拉佐莉。只要小妮赫佳健康就行。"
        },
        {
          "role": "特拉佐莉",
          "text": "…嗯。"
        },
        {
          "role": "特拉佐莉",
          "text": "延古！乖乖的，稍后我就来喂你！"
        },
        {
          "role": "特拉佐莉",
          "text": "旅行者，等「燃晶名刻」做好后，我会请夏温告诉你的。"
        },
        {
          "role": "特拉佐莉",
          "text": "说不定，还能赶上妮赫佳的生日，到时候我们就好好办个聚会吧。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，肯定有很多好吃的，到时候我们可得空着点肚子。"
        },
        {
          "role": "派蒙",
          "text": "那就回头见啦，特拉佐莉女士。"
        },
        {
          "type": "choice",
          "role": "旅行者",
