{
  "quest_id": 70698,
  "chapter_num": null,
  "chapter_title": "来自火花骑士的邀请",
  "type": "wq",
  "route": "An Invitation From the Spark Knight",
  "stories": [
    {
      "story_id": 70698,
      "title": "来自火花骑士的邀请",
      "description": "被热闹活动吸引来雪山的可莉，赢得了特别的奖品…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与可莉对话"
        },
        {
          "role": "可莉",
          "text": "荣誉骑士哥哥，你也来雪山了呀。"
        },
        {
          "role": "可莉",
          "text": "安柏姐姐告诉我，雪山这里在举办比赛，有好多有意思的东西。"
        },
        {
          "role": "可莉",
          "text": "摊位上的哥哥姐姐送了我一大堆礼物呢，这几天我特别开心。"
        },
        {
          "role": "可莉",
          "text": "喏，这个雪人送给你，是可莉玩游戏赢来的哦。"
        },
        {
          "role": "可莉",
          "text": "有空的时候，荣誉骑士哥哥也一起来玩吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（可莉）"
        },
        {
          "role": "可莉",
          "text": "荣誉骑士哥哥！可莉开心，你开心吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "和可莉一起玩就开心！",
              "dialogues": [
                {
                  "role": "可莉",
                  "text": "好耶！那我们继续捉迷藏！"
                },
                {
                  "role": "可莉",
                  "text": "本来，可莉最早看到这个游戏的时候，它是在桌上玩的…"
                },
                {
                  "role": "可莉",
                  "text": "可莉觉得，要不要试试，真正扮演一下游戏里的角色，就和阿贝多哥哥说了这个想法。"
                },
                {
                  "role": "可莉",
                  "text": "阿贝多哥哥刚好做了和骗骗花一样神奇的…叫什么来着…哦对，炼金道具！"
                },
                {
                  "role": "可莉",
                  "text": "我们把这些道具放在捉迷藏的场地周围，就能装成各种箱子的模样，按照桌上那样的规则来玩了。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "可莉和阿贝多，厉害！",
                      "dialogues": []
                    },
                    {
                      "text": "捉迷藏进化，大成功！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "可莉",
                  "text": "可莉经常来雪山找阿贝多哥哥，不怕冷，不过，荣誉骑士哥哥要小心，不要着凉感冒哦！"
                }
              ]
            },
            {
              "text": "还有什么开心的事吗？",
              "dialogues": [
                {
                  "role": "可莉",
                  "text": "有的有的！几个从纳塔来的，一看就很强壮的姐姐，送了可莉不一样的故事书…叫漫画！"
                },
                {
                  "role": "可莉",
                  "text": "漫画里的那些人都好厉害，可莉也想画蒙德的漫画…"
                },
                {
                  "role": "可莉",
                  "text": "比如…荣誉骑士哥哥带着可莉去找宝藏的大冒险！"
                },
                {
                  "role": "可莉",
                  "text": "还有妈妈和她朋友的故事！尼可阿姨，芭比阿姨，欧科塔维亚阿姨…"
                },
                {
                  "role": "可莉",
                  "text": "然后然后，可莉的新朋友，瑶瑶姐姐和早柚姐姐，也都有着很神奇的本领，可厉害了！"
                },
                {
                  "role": "可莉",
                  "text": "有意思的事情，几千页都讲不完！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "支持可莉！",
                      "dialogues": []
                    },
                    {
                      "text": "可莉要成为大漫画家！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "可莉",
                  "text": "可是用蜡笔画不出那种效果，好像要用专门的工具…可莉还得跟着阿贝多哥哥学学画画技巧。"
                },
                {
                  "role": "可莉",
                  "text": "阿贝多哥哥要加班…加完班很累，不能让他更累…"
                },
                {
                  "role": "可莉",
                  "text": "所以，等到阿贝多哥哥不忙的时候，可莉就去和阿贝多哥哥好好学习！"
                },
                {
                  "role": "可莉",
                  "text": "还有还有！宵宫姐姐也来了哦！"
                },
                {
                  "role": "可莉",
                  "text": "上次见面还是好久以前，去稻妻参加那个读书祭典的时候…{{#info:[[「堇庭华彩」]]}}"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "容彩祭？",
                      "dialogues": []
                    },
                    {
                      "text": "确实有一阵子了呢！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "可莉",
                  "text": "宵宫姐姐路过的时候，可莉隔着好远好远，一下子就看到她了！"
                },
                {
                  "role": "可莉",
                  "text": "然后，可莉带着宵宫姐姐在蒙德转了好几圈，吃了好多只有蒙德才有的好吃的！"
                },
                {
                  "role": "可莉",
                  "text": "虽然还想带宵宫姐姐试试炸鱼，但琴团长说最近有很多外国客人…不能吓到他们，会让蒙德被误会！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "可莉扮演了称职的东道主！",
                      "dialogues": []
                    },
                    {
                      "text": "可莉越来越懂事了，棒！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "可莉",
                  "text": "嘿嘿，以后肯定还有机会的…"
                },
                {
                  "role": "可莉",
                  "text": "我想看——宵宫姐姐的烟花，在果酒湖里炸出金鱼的形状！"
                }
              ]
            },
            {
              "text": "待会儿再来继续开心！",
              "dialogues": [
                {
                  "role": "可莉",
                  "text": "好！可莉等着你哦！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          6,
          8
        ]
      ]
    }
  ]
}