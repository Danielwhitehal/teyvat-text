{
  "quest_id": 70502,
  "chapter_num": null,
  "chapter_title": "曲生酌微梦",
  "type": "wq",
  "route": "Of Drink A-Dreaming",
  "stories": [
    {
      "story_id": 70502,
      "title": "曲生酌微梦",
      "description": "近期，「天使的馈赠」酒馆似乎在举行什么活动…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与卢卡对话，进入酒馆"
        },
        {
          "role": "卢卡",
          "text": "你好，想必你就是那位大名鼎鼎的旅行者吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我就是。",
            "有什么事吗？"
          ]
        },
        {
          "role": "派蒙",
          "text": "喂，还有我呢，我是大名鼎鼎的派蒙！"
        },
        {
          "role": "卢卡",
          "text": "是这样的。最近「天使的馈赠」酒馆在举行「酒保体验周」的活动，我想你或许会感兴趣。"
        },
        {
          "role": "卢卡",
          "text": "简单来说，你可以亲自参与调酒…或者调别的什么，原料随便用。"
        },
        {
          "role": "卢卡",
          "text": "只要不浪费，成品也供你们无限畅饮。"
        },
        {
          "role": "派蒙",
          "text": "无限畅饮！"
        },
        {
          "role": "卢卡",
          "text": "另外，如果能让顾客们满意，报酬肯定也不会少你们的。"
        },
        {
          "role": "派蒙",
          "text": "哇，还有报酬！"
        },
        {
          "role": "旅行者",
          "text": "派蒙彻底沦陷了…"
        },
        {
          "role": "派蒙",
          "text": "我们参加吧！好不好？"
        },
        {
          "role": "卢卡",
          "text": "虽说是「体验周」，其实对考勤没有要求…"
        },
        {
          "role": "卢卡",
          "text": "现在做不了决定也没关系，可以先来试一次。"
        },
        {
          "role": "卢卡",
          "text": "怎么样，你意下如何？"
        },
        {
          "role": "旅行者",
          "text": "好吧，那就试试。"
        },
        {
          "role": "卢卡",
          "text": "欢迎欢迎。请进，查尔斯先生会教你基本的调制手法。"
        },
        {
          "role": "旅行者",
          "text": "请稍等一下。"
        },
        {
          "role": "卢卡",
          "text": "没问题，要是你想好了，随时来找我就行。"
        },
        {
          "type": "subtitle",
          "text": "与查尔斯对话"
        },
        {
          "role": "查尔斯",
          "text": "没想到是老面孔，今天想喝点儿什么？"
        },
        {
          "role": "旅行者",
          "text": "你好，查尔斯。"
        },
        {
          "role": "派蒙",
          "text": "查尔斯，我们是来当酒保的！"
        },
        {
          "role": "查尔斯",
          "text": "当酒保…啊，原来卢卡招揽到了你们吗，他运气真够好的。"
        },
        {
          "role": "查尔斯",
          "text": "旅行者，我很信任你处理问题的能力，不过，调酒毕竟是个技术活，希望你不要掉以轻心。"
        },
        {
          "role": "查尔斯",
          "text": "原料的配比，混合的手法…都会影响出品的质量。"
        },
        {
          "role": "派蒙",
          "text": "没事，他做的菜可好吃了，美食的原理是相通的！"
        },
        {
          "role": "查尔斯",
          "text": "好，还有一件事…"
        },
        {
          "role": "查尔斯",
          "text": "之前活动中有位实习生，凭自己的理解混合了三种烈酒，结果一杯就灌倒了客人。"
        },
        {
          "role": "查尔斯",
          "text": "从那之后，我们就不敢再向新人提供含酒精的材料了，这点请你见谅。"
        },
        {
          "role": "旅行者",
          "text": "能够理解。"
        },
        {
          "role": "查尔斯",
          "text": "好，那就全部交待完了。手法和技巧，就在实际调制过程中教你吧。"
        },
        {
          "role": "卢卡",
          "text": "怎么样，你意下如何？"
        },
        {
          "role": "查尔斯",
          "text": "你学得很快，味道也确实不错。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，我也觉得好喝！"
        },
        {
          "role": "查尔斯",
          "text": "刚才只是情景模拟。实际上，顾客可能也会有一些个性化点单。"
        },
        {
          "role": "查尔斯",
          "text": "浓一点、酸一点，诸如此类。你只需要将对应口味的辅料加量就好。"
        },
        {
          "role": "派蒙",
          "text": "我想要一杯焦糖松果，甜一点，最大的杯子！"
        },
        {
          "role": "查尔斯",
          "text": "差不多就类似这样。但对一个优秀的酒保来说，除了具备调制技术，还需要掌握和客人聊天的技巧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "交给我吧！",
            "我很会聊天。"
          ]
        },
        {
          "role": "查尔斯",
          "text": "那好，这吧台的位置就交给你们了。遇到问题或者有什么需要，可以随时找我。"
        },
        {
          "role": "派蒙",
          "text": "呼…终于学完了！不对…我的焦糖松果呢？"
        },
        {
          "role": "旅行者",
          "text": "原来你真的在点单…"
        }
      ]
    }
  ]
}