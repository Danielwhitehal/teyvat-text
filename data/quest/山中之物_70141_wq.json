{
  "quest_id": 70141,
  "chapter_num": null,
  "chapter_title": "山中之物",
  "type": "wq",
  "route": "In the Mountains",
  "stories": [
    {
      "story_id": 70141,
      "title": "山中之物",
      "description": "从雪山营地中的冒险家玉霞口中得知，在这座雪山之中，似乎有一些奇怪的坚冰堵塞着山中的道路…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆前往调查奇怪的冰"
        },
        {
          "role": "派蒙",
          "text": "好大一块冰…里面到底冻着什么呢？"
        },
        {
          "role": "派蒙",
          "text": "咦，周围怎么有这么多蓝色的小草，真奇怪…"
        },
        {
          "type": "subtitle",
          "text": "◆继续向上调查"
        },
        {
          "role": "派蒙",
          "text": "好…好…好冷…要被冻成冰块了…"
        },
        {
          "role": "派蒙",
          "text": "这里到底…到底是什么情况啊…"
        },
        {
          "role": "派蒙",
          "text": "我们…我们还是去山脚下的营地里找人问问吧…"
        },
        {
          "type": "subtitle",
          "text": "◆向玉霞回报"
        },
        {
          "role": "旅行者",
          "text": "这座雪山可真危险…"
        },
        {
          "role": "玉霞",
          "text": "嗯？你回来了，怎么样，看到那些冰了吧，呃…你怎么这么一副样子…"
        },
        {
          "role": "旅行者",
          "text": "关于洞窟中的气流…"
        },
        {
          "role": "玉霞",
          "text": "你已经到那么高的地方了？你还真是厉害啊。不过…被奇怪气流封堵的洞窟？唔，我想想…"
        },
        {
          "role": "玉霞",
          "text": "哦…我想起来了，之前有一支冒险队运气好，一直探索到了山顶附近。"
        },
        {
          "role": "玉霞",
          "text": "虽然他们还是没能靠太近，但是据他们说，山顶附近的一个洞窟里确实有一股奇怪的强气流涌出…"
        },
        {
          "role": "玉霞",
          "text": "但按道理来说，那种地方即使有气流，也不该那么强才对，到现在也没人能找出原因…"
        },
        {
          "role": "玉霞",
          "text": "而且除了那股奇怪的气流之外，雪山中还有一些奇怪的冰。"
        },
        {
          "role": "玉霞",
          "text": "那些冰难以击碎，用火烤也不会融化，对我们的探索造成了很大的阻碍。"
        },
        {
          "role": "玉霞",
          "text": "我们也一直找不到对付那些冰的办法，只能尽量绕开走…"
        },
        {
          "role": "玉霞",
          "text": "而且在一些冰旁边，还生长着许多蓝色的植物。"
        },
        {
          "role": "玉霞",
          "text": "虽然我能隐约看见那些冰里似乎冻着什么，但我也没办法让那些冰解冻，也只能看看罢了…"
        },
        {
          "role": "玉霞",
          "text": "你有兴趣的话，可以循着那种蓝色植物，去看看那些冰。"
        },
        {
          "role": "玉霞",
          "text": "嗯…我想想，{{颜色|蓝|「雪葬之都·近郊」}}和{{颜色|蓝|「星荧洞窟」}}周围就长着很多那种植物，你可以去那里看看。"
        },
        {
          "role": "玉霞",
          "text": "奇怪的强气流、和奇怪的冰，还有奇怪的植物…"
        },
        {
          "role": "玉霞",
          "text": "哈哈哈，要是在一般的探险故事里，这三者之间说不定会有什么关联。"
        },
        {
          "role": "玉霞",
          "text": "但在现实里，探险还是要脚踏实地…你要进雪山的话，记得也要做好充足的准备啊。"
        },
        {
          "type": "subtitle",
          "text": "再次对话"
        },
        {
          "role": "旅行者",
          "text": "关于那些冰…"
        },
        {
          "role": "玉霞",
          "text": "不知道你注意到没有，在那块冰的周围，生长着很多蓝色的植物。"
        },
        {
          "role": "玉霞",
          "text": "我在想，这些植物说不定和那块被冻在冰里的碎片有所关联…"
        },
        {
          "role": "玉霞",
          "text": "如果你想要在雪山里继续寻找那些碎片的话，也许，你可以循着那些蓝色植物找找看。"
        },
        {
          "role": "玉霞",
          "text": "在{{颜色|蓝|「雪葬之都·近郊」}}和{{颜色|蓝|「星荧洞窟」}}附近，我记得有很多这种植物，你不妨去那里看看，说不定会有什么收获。"
        },
        {
          "type": "subtitle",
          "text": "◆解冻所有「碎片」（1/3）"
        },
        {
          "role": "派蒙",
          "text": "呜哇！有什么东西飞起来了，好像…是往山顶那边飞了。"
        },
        {
          "role": "派蒙",
          "text": "要去山顶附近看看吗？或者说…还是先回去找人问问情况？"
        },
        {
          "type": "subtitle",
          "text": "◆进入星荧洞窟"
        },
        {
          "role": "派蒙",
          "text": "那种蓝色的小草越来越多了，总感觉…我们离什么东西越来越近了呢…"
        },
        {
          "type": "subtitle",
          "text": "◆到达星荧洞窟底部"
        },
        {
          "role": "派蒙",
          "text": "好…好冷…"
        },
        {
          "role": "派蒙",
          "text": "是因为没有阳光吗…还是说，和那些{{颜色|蓝|蓝色的植物}}、{{颜色|蓝|奇怪的冰}}有关…"
        },
        {
          "type": "subtitle",
          "text": "◆解冻所有「碎片」（2/3）"
        },
        {
          "type": "subtitle",
          "text": "◆打开雪葬之都·近郊的机关"
        },
        {
          "role": "派蒙",
          "text": "呜哇，小心！那些大家伙好像醒过来了…"
        },
        {
          "role": "派蒙",
          "text": "好冷…那边的光，好像是{{颜色|蓝|热源}}…"
        },
        {
          "type": "subtitle",
          "text": "◆进入雪葬之都·近郊"
        },
        {
          "role": "派蒙",
          "text": "好大一块冰…里面到底冻着什么呢？"
        },
        {
          "role": "派蒙",
          "text": "咦，周围怎么有这么多蓝色的小草，真奇怪…"
        },
        {
          "type": "subtitle",
          "text": "◆解冻所有「碎片」（3/3）"
        },
        {
          "role": "派蒙",
          "text": "这样子就解冻三处碎片了，这些碎片也都…呃，飞上去了…"
        },
        {
          "role": "派蒙",
          "text": "唔，我们去山顶看看情况吧。"
        },
        {
          "type": "subtitle",
          "text": "◆寻找上山的路"
        },
        {
          "role": "派蒙",
          "text": "到底哪里才能上山呀…唔，我们先沿着这条路走走看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往雪山山顶"
        },
        {
          "role": "派蒙",
          "text": "快看，有一根超大的…柱子。这里怎么会有一根柱子？真奇怪。"
        },
        {
          "role": "派蒙",
          "text": "咦？你往上看看，那是不是我们之前解冻的那些碎片？难道…那些碎片就是从这跟大柱子上掉下来的？"
        },
        {
          "role": "派蒙",
          "text": "不过，看起来那些小碎片好像又被冻住了…这雪山里的环境真可怕…"
        },
        {
          "role": "派蒙",
          "text": "没办法，我们上去把那些碎片再解冻一次吧。"
        },
        {
          "type": "subtitle",
          "text": "◆再次解冻所有碎片"
        },
        {
          "role": "派蒙",
          "text": "咦？柱子下的冰面全部碎掉了…底下好像还有一个很大的空间，我们去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆调查下方的区域"
        },
        {
          "role": "派蒙",
          "text": "看起来，这里好像也没有其他东西了…"
        },
        {
          "role": "派蒙",
          "text": "不过，我们还是回去告诉那位冒险家吧。"
        },
        {
          "type": "subtitle",
          "text": "◆向玉霞回报"
        },
        {
          "role": "旅行者",
          "text": "关于山顶的情况…"
        },
        {
          "role": "玉霞",
          "text": "一根漂浮在空中的奇怪大柱子？雪山里居然会有这种东西…"
        },
        {
          "role": "玉霞",
          "text": "柱子下方的冰面下，还有一个很大的空间？唔…更奇怪了。"
        },
        {
          "role": "玉霞",
          "text": "这还真是…预料不到的情况。谢谢你，我这就去组织探险队，争取尽快再进山一次，去看看那里的情况。"
        },
        {
          "role": "玉霞",
          "text": "对了，谢谢你帮我们打开了通往山顶的路，这些是给你的，请收下吧，"
        },
        {
          "role": "玉霞",
          "text": "这座雪山里，果然埋藏着什么秘密。"
        },
        {
          "role": "玉霞",
          "text": "希望这次探险能有所收获…"
        }
      ],
      "collapse_ranges": [
        [
          25,
          30
        ]
      ]
    }
  ]
}