{
  "quest_id": 76678,
  "chapter_num": null,
  "chapter_title": "如月之恒",
  "type": "wq",
  "route": "Everlasting as the Moon",
  "stories": [
    {
      "story_id": 76678,
      "title": "如月之恒",
      "description": "在「银月之庭」，与哥伦比娅共度一段时光…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "商量今天的游戏项目"
        },
        {
          "role": "哥伦比娅",
          "text": "今天我们来玩点什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "演奏乐器。",
              "dialogues": []
            },
            {
              "text": "猜图案。",
              "dialogues": []
            },
            {
              "text": "调制饮品。",
              "dialogues": []
            },
            {
              "text": "下「月亮棋」。",
              "dialogues": []
            },
            {
              "text": "月灵躲帽帽。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "好呀。"
        },
        {
          "type": "subtitle",
          "text": "演奏乐器"
        },
        {
          "role": "旅行者",
          "text": "（弹什么好呢…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "演奏哥伦比娅常哼的歌…",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "（以什么样的情绪演奏呢…）"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "平和的乐调…",
                      "dialogues": [
                        {
                          "role": "哥伦比娅",
                          "text": "好听。我平时哼的旋律，原来你都记下来了。"
                        },
                        {
                          "role": "派蒙",
                          "text": "嘿嘿，因为你唱歌很好听嘛，我们有时会悄悄在旁边听上一会儿。"
                        },
                        {
                          "role": "哥伦比娅",
                          "text": "月灵们也听得入迷了。不知道它们有没有学会。"
                        },
                        {
                          "role": "哥伦比娅",
                          "text": "说不定，以后还得多请你们教几次。"
                        },
                        {
                          "role": "哥伦比娅",
                          "text": "来吧，把手给我。"
                        },
                        {
                          "role": "派蒙",
                          "text": "欸？我们这是无偿演出，不用收学费的！"
                        },
                        {
                          "role": "哥伦比娅",
                          "text": "嗯？学费？"
                        },
                        {
                          "role": "哥伦比娅",
                          "text": "我只是觉得，好听的旋律，应该有美丽的月光相伴。"
                        }
                      ]
                    },
                    {
                      "text": "愉快的乐调…",
                      "dialogues": [
                        {
                          "role": "哥伦比娅",
                          "text": "结束了？感觉都还没听够…"
                        },
                        {
                          "role": "哥伦比娅",
                          "text": "我曾说过这是我唯一记得的「摇篮曲」。"
                        },
                        {
                          "role": "哥伦比娅",
                          "text": "尽管还没找到其中的意义，但听你弹过之后，我开始觉得在月亮上等待着我的那个答案，至少是美好的。"
                        },
                        {
                          "role": "哥伦比娅",
                          "text": "来，把手给我。"
                        },
                        {
                          "role": "派蒙",
                          "text": "这次就不用回报啦。"
                        },
                        {
                          "role": "哥伦比娅",
                          "text": "不，我只是想为这旋律添上一束美好的月光。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "演奏他国的音乐…",
              "dialogues": [
                {
                  "role": "哥伦比娅",
                  "text": "奇妙的感觉。以前偶尔也听过类似的旋律，但听你弹的感受很不一样。"
                },
                {
                  "role": "派蒙",
                  "text": "可能其中包含了他对那个国家的感情吧。"
                },
                {
                  "role": "哥伦比娅",
                  "text": "奇妙的是，我能够从乐调中想象出风景…不知道现实和我的想象会有多少区别呢…"
                },
                {
                  "role": "派蒙",
                  "text": "想看还不简单？到时候就让我们来当你的导游吧！"
                },
                {
                  "role": "哥伦比娅",
                  "text": "嗯…如果能有那么一天的话。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "猜图案"
        },
        {
          "role": "哥伦比娅",
          "text": "去吧，月灵们。"
        },
        {
          "role": "哥伦比娅",
          "text": "猜猜看这是什么图案吧。"
        },
        {
          "type": "subtitle",
          "text": "月亮、陆鳗鳗、圆弧"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "月亮。",
              "dialogues": [
                {
                  "role": "月灵",
                  "text": "！！"
                },
                {
                  "role": "派蒙",
                  "text": "哼哼，这次还是挺明显的嘛。"
                },
                {
                  "role": "哥伦比娅",
                  "text": "对我们来说，这个谜底有些过于简单了。"
                }
              ]
            },
            {
              "text": "陆鳗鳗。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这次的这位是腰部出了问题？！"
                },
                {
                  "role": "哥伦比娅",
                  "text": "你们的见闻真的非常丰富呢…"
                },
                {
                  "role": "哥伦比娅",
                  "text": "正确答案是月亮。"
                },
                {
                  "role": "哥伦比娅",
                  "text": "回来吧，做得很好哦。"
                }
              ]
            },
            {
              "text": "圆弧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "谁都看得出来是圆弧吧！那么简单的结论怎么可能是正确答案啦！"
                },
                {
                  "role": "哥伦比娅",
                  "text": "的确不能说有错，可惜这并不是月灵们的本意。"
                },
                {
                  "role": "哥伦比娅",
                  "text": "正确答案是月亮。"
                },
                {
                  "role": "哥伦比娅",
                  "text": "回来吧，做得很好哦。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "重拳出击鸭、吃圆了肚子的盗宝鼬、烧瓶"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "重拳出击鸭。",
              "dialogues": [
                {
                  "role": "月灵",
                  "text": "！！"
                },
                {
                  "role": "派蒙",
                  "text": "你这到底是怎么看出来的？"
                },
                {
                  "role": "哥伦比娅",
                  "text": "原来它叫这个名字。它也会把那位机械师放在手上，盛着她到处走吗？"
                },
                {
                  "role": "派蒙",
                  "text": "你的想象中好像混入了前同事的影子…"
                }
              ]
            },
            {
              "text": "吃圆了肚子的盗宝鼬。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "都吃成这样了，它还盗得了宝吗？"
                },
                {
                  "role": "哥伦比娅",
                  "text": "或者说已经用不着去偷东西了吧？"
                },
                {
                  "role": "哥伦比娅",
                  "text": "正确答案是…爱诺工坊附近的大大的机械鸭子。"
                },
                {
                  "role": "哥伦比娅",
                  "text": "回来吧，辛苦你们了。"
                }
              ]
            },
            {
              "text": "烧瓶。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "月灵们真拼命啊，为了摆游戏用的图案，还要专门观察和研究实验器材！"
                },
                {
                  "role": "哥伦比娅",
                  "text": "答案很接近了。"
                },
                {
                  "role": "哥伦比娅",
                  "text": "正确答案是…爱诺工坊附近的大大的机械鸭子。"
                },
                {
                  "role": "哥伦比娅",
                  "text": "回来吧，辛苦你们了。"
                },
                {
                  "role": "派蒙",
                  "text": "这哪里接近了！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "月矩力试验设计局、浮游风蕈兽、伞"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "月矩力试验设计局。",
              "dialogues": [
                {
                  "role": "月灵",
                  "text": "！！"
                },
                {
                  "role": "派蒙",
                  "text": "你不会在我们不知道的时候，偷偷跟月灵们玩过一次了吧？"
                }
              ]
            },
            {
              "text": "浮游风蕈兽。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "虽然身体的部分能够想象出来，但风蕈兽的菌帽真有那么圆吗？"
                },
                {
                  "role": "哥伦比娅",
                  "text": "「浮游」的特征倒是没说错呢…"
                },
                {
                  "role": "哥伦比娅",
                  "text": "正确答案是月矩力试验设计局。"
                }
              ]
            },
            {
              "text": "伞。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这伞柄好像有点短了，下雨天不太好拿啊。"
                },
                {
                  "role": "哥伦比娅",
                  "text": "伞…我平时不怎么用呢。下雨的时候，用月矩力做个护盾就行了吧？"
                },
                {
                  "role": "派蒙",
                  "text": "原来你教我们的那招在下雨天也能用吗！"
                },
                {
                  "role": "哥伦比娅",
                  "text": "正确答案是月矩力试验设计局。"
                }
              ]
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "「愚人众」在挪德卡莱建造的设施太过张扬了，连月灵们也记住了它…"
        },
        {
          "type": "subtitle",
          "text": "游戏结束后，月灵们一如既往地扑到了你身上，看起来十分开心。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "谢谢你们愿意陪月灵们玩游戏。"
        },
        {
          "role": "哥伦比娅",
          "text": "希望，下次我们也能共度这样放松的时光。"
        },
        {
          "type": "subtitle",
          "text": "调制饮品"
        },
        {
          "type": "subtitle",
          "text": "额外对话（哥伦比娅）"
        },
        {
          "role": "哥伦比娅",
          "text": "以后…也拜托你们了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调制饮品",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "给她做杯什么好呢…"
        },
        {
          "type": "subtitle",
          "text": "调制错误"
        },
        {
          "role": "派蒙",
          "text": "好像哪里弄错了…再调一次吧。"
        },
        {
          "type": "subtitle",
          "text": "材料清单"
        },
        {
          "role": "'图书馆'",
          "text": "[[file:曲生酌微梦-咖啡.png|link=|30px]]咖啡*3"
        },
        {
          "role": "'北风之望'",
          "text": "[[file:曲生酌微梦-牛奶.png|link=|30px]]牛奶+[[file:曲生酌微梦-薄荷.png|link=|30px]]薄荷+[[file:曲生酌微梦-红茶.png|link=|30px]]红茶"
        },
        {
          "role": "'苍谷落日'",
          "text": "[[file:曲生酌微梦-果汁.png|link=|30px]]果汁*3"
        },
        {
          "role": "'酸沁光辉'",
          "text": "[[file:曲生酌微梦-红茶.png|link=|30px]]红茶*2+[[file:曲生酌微梦-柠檬.png|link=|30px]]柠檬"
        },
        {
          "role": "派蒙",
          "text": "哇，连我都忍不住想喝一杯了！/哦！好浓郁的香气，也不知道哥伦比娅有没有喝过类似的饮品。"
        },
        {
          "type": "subtitle",
          "text": "下「月亮棋」"
        },
        {
          "type": "subtitle",
          "text": "长时间放置"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "原来你喜欢深思熟虑后再做决定，嗯，没事，我们有很多时间。"
        },
        {
          "role": "哥伦比娅",
          "text": "忘了怎么将「月亮」放上「夜空」吗？要不要我帮你？"
        },
        {
          "role": "哥伦比娅",
          "text": "不喜欢这个游戏吗？我觉得还挺有意思。"
        },
        {
          "type": "subtitle",
          "text": "长时间看向哥伦比娅"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯？你是在盯着我看吗？我感觉得到。"
        },
        {
          "role": "哥伦比娅",
          "text": "我的脸上…有关于「月亮」的答案吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "棋盘在那边哦。"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "这样对吗…？"
        },
        {
          "role": "哥伦比娅",
          "text": "唔…我想想…"
        },
        {
          "role": "哥伦比娅",
          "text": "唔…"
        },
        {
          "role": "哥伦比娅",
          "text": "月亮…月亮…"
        },
        {
          "role": "哥伦比娅",
          "text": "这里怎么样？"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "平局"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯…月升月落，真是漫长。"
        },
        {
          "role": "哥伦比娅",
          "text": "我们的月亮谁都不让谁呢。"
        },
        {
          "role": "哥伦比娅",
          "text": "是不是…快平手了？"
        },
        {
          "type": "subtitle",
          "text": "玩家胜利"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，是你的「月亮」获胜了。"
        },
        {
          "role": "哥伦比娅",
          "text": "这片夜空属于你了。"
        },
        {
          "role": "哥伦比娅",
          "text": "啊…一不小心就…"
        },
        {
          "type": "subtitle",
          "text": "哥伦比娅胜利"
        },
        {
          "role": "哥伦比娅",
          "text": "这次是我赢了。"
        },
        {
          "role": "哥伦比娅",
          "text": "我的三个月亮连起来了。"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，这样就赢了。"
        },
        {
          "type": "subtitle",
          "text": "与哥伦比娅在游戏中度过了一段愉快的时光…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "谢谢你，我玩得很开心。"
        },
        {
          "role": "哥伦比娅",
          "text": "如果可以的话，下次也来陪我吧。"
        },
        {
          "role": "哥伦比娅",
          "text": "把这个，当做「约定」的证明。"
        },
        {
          "type": "subtitle",
          "text": "月灵躲帽帽"
        },
        {
          "role": "哥伦比娅",
          "text": "要开始了。"
        },
        {
          "role": "哥伦比娅",
          "text": "转起来吧。"
        },
        {
          "role": "哥伦比娅",
          "text": "猜猜看努昂诺塔在哪里呢？"
        },
        {
          "type": "subtitle",
          "text": "选对了"
        },
        {
          "role": "哥伦比娅",
          "text": "答对了。"
        },
        {
          "type": "subtitle",
          "text": "选错了"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，这次猜错了。"
        },
        {
          "type": "subtitle",
          "text": "使用元素视野"
        },
        {
          "role": "哥伦比娅",
          "text": "哈…"
        },
        {
          "type": "subtitle",
          "text": "使用元素视野，选择异样的帽子"
        },
        {
          "role": "哥伦比娅",
          "text": "作弊的是坏孩子。"
        },
        {
          "type": "subtitle",
          "text": "剧情结束"
        },
        {
          "type": "subtitle",
          "text": "额外对话（哥伦比娅）",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "谢谢你，今天玩得很开心。"
        },
        {
          "role": "哥伦比娅",
          "text": "无论你走向何处，愿这缕月光萦绕着你。"
        }
      ],
