{
  "quest_id": 41156,
  "chapter_num": null,
  "chapter_title": "望舒外送",
  "type": "eq",
  "route": "Wangshu Take-Away",
  "stories": [
    {
      "story_id": 41156,
      "title": "望舒外送",
      "description": "璃月的望舒客栈里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "言笑",
          "text": "那你忙着吧，我想想怎么办。"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "言笑",
          "text": "那麻烦你了。这爆炒肉要做好讲究一个步骤周全，不多节外生枝。"
        },
        {
          "role": "言笑",
          "text": "所以中途不要沾了奇怪的元素，也别跑动步子太大。"
        },
        {
          "role": "随缘的铃官",
          "text": "我觉得应该差不多了。"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "言笑",
          "text": "是的。铃官这人要了一份爆炒肉片，然后就往西北去了。"
        },
        {
          "role": "言笑",
          "text": "麻烦你趁着热给她送过去吧。"
        },
        {
          "role": "言笑",
          "text": "如果路上不慎发生了意外，你回到这里找我，我再做一次。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "随缘的铃官",
          "text": "嘿嘿，谢谢你啦。我还以为走这么远望舒客栈就不送了呢。"
        }
      ]
    }
  ]
}