{
  "quest_id": 74716,
  "chapter_num": null,
  "chapter_title": "水域状况已好转…",
  "type": "wq",
  "route": "Betterments in Aquatic Circumstances...",
  "stories": [
    {
      "story_id": 74716,
      "title": "水域状况已好转…",
      "description": "菲米尼似乎有事找我们…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与菲米尼对话"
        },
        {
          "role": "菲米尼",
          "text": "太好了…这下，最主要的水下废弃物基本被打捞完了。"
        },
        {
          "role": "菲米尼",
          "text": "让你们受累了，旅行者和派蒙。"
        },
        {
          "role": "派蒙",
          "text": "没有啦没有啦，比起受累这种说法，我更愿意说这次是收获满满哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "既帮助了修复水下环境。",
              "dialogues": []
            },
            {
              "text": "又找到了许多漂亮宝藏。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲米尼",
          "text": "谢谢你们…托你们的福，我才度过了一段愉快而又充实的时光。"
        },
        {
          "role": "派蒙",
          "text": "不用客气，这是大家的共同努力！而且，我觉得菲米尼也很有进步呢，水下和水上的时候都可靠。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别害羞。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲米尼",
          "text": "好…好的。"
        },
        {
          "role": "菲米尼",
          "text": "……"
        },
        {
          "role": "菲米尼",
          "text": "抱歉，除了感谢的话，我还是不知道这种时候应该说些什么。"
        },
        {
          "role": "菲米尼",
          "text": "可能…我还需要再多练习一段时间？"
        },
        {
          "role": "派蒙",
          "text": "慢慢来，不着急。即使是练习，也按照自己的节奏一点一点努力就行啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "以后有机会，还可以这样合作。",
              "dialogues": []
            },
            {
              "text": "下次有事情，还可以来找我们。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲米尼",
          "text": "嗯，一定。"
        },
        {
          "role": "菲米尼",
          "text": "…我本来以为，在任务完成之后，我会需要回水下独处一段时间的。"
        },
        {
          "role": "菲米尼",
          "text": "但很神奇，和你们聊过天…就连天空也变得非常宁静。我想把此刻的这种心情…告诉你们。"
        },
        {
          "role": "菲米尼",
          "text": "那…我今天先回去和林尼他们会合了。"
        },
        {
          "role": "菲米尼",
          "text": "余下的水底勘测信息，就交给你们了。祝愿你们能够找到满意的收获。"
        },
        {
          "role": "「木偶」",
          "text": "哟，我在楼上就听见你们庆祝的声音了。看来是有好事发生？"
        },
        {
          "role": "派蒙",
          "text": "嗯！我们把影响鱼儿们生活的废品基本打捞完了，还找到了钢琴剩下的部件！"
        },
        {
          "role": "「木偶」",
          "text": "真的吗？我看看…"
        },
        {
          "role": "「木偶」",
          "text": "…还真是。有了这些，我就能修好这架钢琴了。"
        },
        {
          "role": "「木偶」",
          "text": "虽说不是复原得和当初一模一样，但也能再次让它流出好听的音乐了。"
        },
        {
          "role": "派蒙",
          "text": "你听起来很开心嘛。"
        },
        {
          "role": "「木偶」",
          "text": "有…有吗？不管了，我现在就去修复它，花不了多少时间。你们帮我装点一下这里吧。"
        },
        {
          "role": "「木偶」",
          "text": "只有好看的舞台，才配得上你的乐声。哈哈。"
        },
        {
          "role": "派蒙",
          "text": "她果然很高兴啊…"
        },
        {
          "role": "派蒙",
          "text": "哇！好漂亮的钢琴！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好典雅！",
              "dialogues": []
            },
            {
              "text": "好华丽！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「木偶」",
          "text": "哼哼，那当然。也不看看是谁修的。我还为它重新加固了一下机械联动装置，翻新了一下外装。"
        },
        {
          "role": "「木偶」",
          "text": "你们干得也不赖嘛，这舞台也配得上它了。"
        },
        {
          "role": "派蒙",
          "text": "哎呀呀，小事小事。快别说那么多了，你现在不弹一首吗？"
        },
        {
          "role": "「木偶」",
          "text": "…欸？现在？"
        },
        {
          "role": "派蒙",
          "text": "不然呢？你修好它不就是为了弹的吗？"
        },
        {
          "role": "「木偶」",
          "text": "今天…就算了吧！以后有机会再弹也不迟！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "忘谱了？",
              "dialogues": []
            },
            {
              "text": "害羞了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「木偶」",
          "text": "啧…啰嗦…！我只是想先安静地和它待待，怀念一下过去的时光而已！"
        },
        {
          "role": "「木偶」",
          "text": "别以为随便挑衅我两句我就会答应，哼，回去练练再来吧！"
        },
        {
          "type": "subtitle",
          "text": "弹奏钢琴"
        },
        {
          "type": "subtitle",
          "text": "队伍中没有桑多涅时"
        },
        {
          "role": "旅行者",
          "text": "（桑多涅似乎知道如何演奏这架钢琴…）"
        },
        {
          "type": "subtitle",
          "text": "队伍中有桑多涅时"
        },
        {
          "type": "subtitle",
          "text": "播放过场动画《淑女最后的答案 La derniere question, et sa reponse》",
          "narration": true,
          "color": "描述"
        }
      ],
      "collapse_ranges": [
        [
          39,
          43
        ]
      ]
    }
  ]
}