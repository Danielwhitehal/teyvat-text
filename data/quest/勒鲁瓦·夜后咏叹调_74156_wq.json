{
  "quest_id": 74156,
  "chapter_num": null,
  "chapter_title": "勒鲁瓦·夜后咏叹调",
  "type": "wq",
  "route": "Leroy: Queen of the Night's Aria",
  "stories": [
    {
      "story_id": 74156,
      "title": "勒鲁瓦·夜后咏叹调",
      "description": "你们再次来到了勒鲁瓦家附近…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待「泡泡桔」信号出现"
        },
        {
          "type": "subtitle",
          "text": "等待「泡泡桔」信号出现"
        },
        {
          "type": "subtitle",
          "text": "调整时间到20:00-24:00"
        },
        {
          "type": "subtitle",
          "text": "前往后窗"
        },
        {
          "role": "派蒙",
          "text": "我好紧张，旅行者，按照纸条上说的，我们只要在这里等他就好了吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "耐心等待吧。",
              "dialogues": []
            },
            {
              "text": "我有些问题想问他。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好，我听你的。"
        },
        {
          "role": "？？？",
          "text": "安静地等待了一会儿，随着一声「吱呀」，窗户被一张你们熟悉的面孔打开了。伯努瓦向外探了探头，看见你们后，他小心地从窗户口爬了出来。"
        },
        {
          "role": "派蒙",
          "text": "伯努瓦，这到底是怎么…"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "快走快走，被他们发现就糟了。"
        },
        {
          "type": "subtitle",
          "text": "跟随伯努瓦"
        },
        {
          "type": "subtitle",
          "text": "前往乘坐娜维娅线"
        },
        {
          "type": "subtitle",
          "text": "向前追赶伯努瓦"
        },
        {
          "role": "旅行者",
          "text": "他们能自己解决，我不会再插手。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "小秋，你真的要这样对我吗？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "灰河的女孩子哪个有你过得幸福？你吃的点心，你的绸缎裙子，你看的书都是要花钱的。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "别人挨冻挨饿的时候，你在给家里的狗戴项链，穿裙子。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "这种生活是我挣来的，你不应该有所回报吗？不付出就获得回报这种事怎么可能？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我对你残酷吗？我已经够慷慨了。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "小秋，你仔细想一想。你生活中的哪一步我没有为你安排，你走歪的路都是你自己选的。"
        },
        {
          "role": "阿托斯",
          "text": "伯努瓦先生未免太会强词夺理了，用慷慨的言行实现自私的目的，说穿了还是为自己。"
        },
        {
          "role": "莫蒂西娅",
          "text": "你对我好不过是为了日后收割，不必花言巧语。"
        },
        {
          "role": "莫蒂西娅",
          "text": "我对你最大的怜悯就是给你一个痛快，但在那之前，告诉我，我的孩子在哪儿？"
        },
        {
          "role": "莫蒂西娅",
          "text": "不管是以前的老房子，还是现在你住的房子里，一点关于她去向的痕迹都没有。你把她弄到哪里去了？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我说了你就会放过我吗？"
        },
        {
          "role": "莫蒂西娅",
          "text": "不会，但我会让你没有痛苦地离开。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "…说也是死，不说也是死…呵呵，那我为什么要便宜你？"
        },
        {
          "role": "阿托斯",
          "text": "唉…秋你真是一点都不会撒谎，这下我们永远不会知道她在哪儿了。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我知道她在哪儿，嘿嘿，但我不会告诉你们，绝对不会。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "你再也不会找到她了，绝对找不到…"
        },
        {
          "role": "莫蒂西娅",
          "text": "我要把他带走，带回他自己家去，你们有什么意见吗？"
        },
        {
          "role": "旅行者",
          "text": "请便，我们不会干涉。"
        },
        {
          "role": "派蒙",
          "text": "你、你们自己解决就好，我们不管了，不管了。"
        },
        {
          "role": "？？？",
          "text": "伯努瓦念叨着「绝对找不到」，被一言不发的秋带走了。"
        },
        {
          "role": "阿托斯",
          "text": "本来没打算让别人知道这种事的，毕竟她还有通缉令在身，值得一提的是，我也是。"
        },
        {
          "role": "阿托斯",
          "text": "如果你们现在去执律庭告发我们，大概能拿不少钱。"
        },
        {
          "role": "阿托斯",
          "text": "不过我不建议你这么做，因为你这么做了的话，我的朋友们是不会忘记你的。你可以试试。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我不会告发。",
              "dialogues": []
            },
            {
              "text": "我不缺钱。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿托斯",
          "text": "哈哈，我也觉得你会是这个态度。"
        },
        {
          "role": "阿托斯",
          "text": "那么，这朵虹彩蔷薇送给你。我们很喜欢这种花，它的含义很丰富。"
        },
        {
          "role": "阿托斯",
          "text": "现在，它的意义是警告，希望你保持你的态度。"
        },
        {
          "role": "阿托斯",
          "text": "再会了。"
        },
        {
          "role": "派蒙",
          "text": "所以…一切原来是这么回事，真是复杂的一家子。"
        },
        {
          "role": "派蒙",
          "text": "该怎么说呢？我也不知道能评价些什么了，幸好之前没有报告执律庭。"
        },
        {
          "role": "派蒙",
          "text": "我有点可怜秋，她的孩子到最后也没有找到。"
        },
        {
          "role": "派蒙",
          "text": "一开始，我还觉得伯努瓦是好人呢。唔…你说，我该不会很容易被骗吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这都被你发现了。",
              "dialogues": []
            },
            {
              "text": "派蒙是小笨蛋。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "过分，这种时候还要取笑我！哼，你不请我去德波大饭店吃好吃的，我是绝对不会原谅你的！"
        },
        {
          "role": "旅行者",
          "text": "我不会看着他们伤害伯努瓦。"
        },
        {
          "role": "阿托斯",
          "text": "哼，麻烦起来了。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "谢谢你，谢谢你！唉，小秋，我费尽力气培养你，怎么外人都比你对我尽心？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "灰河的女孩子哪个有你过得幸福？你吃的点心，你的绸缎裙子，你看的书都是要花钱的。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "别人挨冻挨饿的时候，你在给家里的狗戴项链，穿裙子。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "这种生活是我挣来的，你不应该有所回报吗？不付出就获得回报这种事怎么可能？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我对你残酷吗？我已经够慷慨了。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "小秋，你仔细想一想。你生活中的哪一步我没有为你安排，你走歪的路都是你自己选的。"
        },
        {
          "role": "莫蒂西娅",
          "text": "我对你最大的怜悯就是给你一个痛快，但在那之前，告诉我，我的孩子在哪儿？"
        },
        {
          "role": "莫蒂西娅",
          "text": "不管是以前的老房子，还是现在你住的房子里，一点关于她去向的痕迹都没有。你把她弄到哪里去了？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我说了你就会放过我吗？"
        },
        {
          "role": "莫蒂西娅",
          "text": "不会，但我会让你没有痛苦地离开。"
        },
        {
          "role": "阿托斯",
          "text": "唉…秋你真是一点都不会撒谎，这下我们永远不会知道她在哪儿了。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "你、你们别以为自己可以为所欲为，这里还有别人看着呢！"
        },
        {
          "role": "阿托斯",
          "text": "你以为我们不敢吗？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "…小秋，放弃吧。她现在过得很好，她的父母很有财力，你找到她又能做什么呢？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "总不能让她跟着你流浪吧，你是从梅洛彼得堡逃出来的，你要让她也过这种日子吗？"
        },
        {
          "role": "莫蒂西娅",
          "text": "她被收养了…为什么不告诉我？"
        },
        {
          "role": "莫蒂西娅",
          "text": "她…她过得很好…"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "让我走吧，秋，对你来说我死还是活也都没有意义了。"
        },
        {
          "role": "莫蒂西娅",
          "text": "她有妈妈照顾，是吗？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "是啊，她的养母对她很好。比你、比我能做到的都要好。"
        },
        {
          "role": "莫蒂西娅",
          "text": "我找到她又能做什么…又有什么意义…"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "是啊，这一切都没有意义了。我在枫丹廷的一切都归你，我不要了，让我走吧。"
        },
        {
          "role": "莫蒂西娅",
          "text": "……"
        },
        {
          "role": "阿托斯",
          "text": "你发什么呆啊，秋！你要放他走吗？"
        },
        {
          "role": "阿托斯",
          "text": "啧，伯努瓦，你真的以为你能跑掉？"
        },
        {
          "role": "旅行者",
          "text": "我不会看着你们伤害伯努瓦。"
        },
        {
          "role": "阿托斯",
          "text": "你们非要作梗到底是吗？明明是不相干的人，非要卷进这件事。"
        },
        {
          "role": "阿托斯",
          "text": "滥好人，这就是我对你们的评价。"
        },
        {
          "role": "阿托斯",
          "text": "秋，你要放他走吗？"
        },
        {
          "role": "莫蒂西娅",
          "text": "我…我不知道…我…"
        },
        {
          "role": "阿托斯",
          "text": "唉，你还是心软。"
        },
        {
          "role": "阿托斯",
          "text": "伯努瓦，你赌对了，孩子是母亲最大的软肋。秋…你又有帮手，这种情况下我会放你一马。"
        },
        {
          "role": "阿托斯",
          "text": "但这没有关系，你可以试试看自己能跑多远，看看是我们先找到你，还是你先跑到我们找不到的地方。"
        },
        {
          "role": "阿托斯",
          "text": "顺带一提，我希望你没有误以为只有我会追你到天涯海角。"
        },
        {
          "role": "阿托斯",
          "text": "我们还有一些在梅洛彼得堡结识的朋友，这次到枫丹廷来之前，他们都说很想见见你本人。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我所有的财产你们都可以拿走…拿走！"
        },
        {
          "role": "阿托斯",
          "text": "看来今天不是你的最后一天，在我的朋友们找到你之前，衷心祝愿你可以多活几天。滚吧。"
        },
        {
          "role": "？？？",
          "text": "伯努瓦向着枫丹廷的反方向，头也不回地走山路离开了你们的视线。"
        },
        {
          "role": "阿托斯",
          "text": "至于你们…我们之后会离开枫丹廷，我想以后我们都不会再见了。"
        },
        {
          "role": "阿托斯",
          "text": "秋，我们离开吧。"
        },
        {
          "role": "莫蒂西娅",
          "text": "…对不起，阿托斯，我的孩子她…对不起…"
        },
        {
          "role": "莫蒂西娅",
          "text": "我们走吧。"
        },
        {
          "role": "派蒙",
          "text": "所以…一切原来是这么回事，真是复杂的一家子。"
        },
        {
          "role": "派蒙",
          "text": "该怎么说呢？我也不知道能评价些什么了。我有点可怜秋，她的孩子到最后也没有找到…"
        },
        {
          "role": "派蒙",
          "text": "无论如何，至少我们阻止了一场流血事件，这样就够了。"
        },
        {
          "type": "subtitle",
          "text": "见证对峙"
        },
        {
          "role": "阿托斯",
          "text": "你好呀，爸爸。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "…完了。"
        },
        {
          "role": "阿托斯",
          "text": "秋告诉我你要逃跑的时候我还挺惊讶的，我们已经关了你这么久，你居然还没有崩溃。"
        },
        {
          "role": "阿托斯",
          "text": "并且还能抓住机会，教唆这两位「正义使者」帮你逃跑，你的求生意志令我动容。"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "阿托斯",
          "text": "你明明有那么多地方可以跑，怎么最后偏偏选了你经常带秋来郊游的这地方？真是昏招。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我…"
        },
        {
          "role": "阿托斯",
          "text": "不用解释，人在危急关头慌不择路我能理解，习惯性地选了自己最熟悉的那条路对吧。"
        },
        {
          "role": "阿托斯",
          "text": "还好秋在你们后面出发，她还没有赶到这里，我不想在她面前聊这种事。"
        },
        {
          "role": "阿托斯",
          "text": "所以你到底是怎么想的呢？我实在搞不懂。"
        },
        {
          "role": "阿托斯",
          "text": "你以婚姻的名义，把她当商品卖给了别人，卖了两次，第一次你用她换来了枫丹廷的大房子。"
        },
        {
          "role": "阿托斯",
          "text": "第二次你胡乱选了一个人，只为了把她送走，房产和其他财物都归你。"
        },
        {
          "role": "阿托斯",
          "text": "你甚至在她受到欺凌的时候选择视而不见，她把第二次婚姻中生下的孩子都交给你抚养了。"
        },
        {
          "role": "阿托斯",
          "text": "她的孩子被你送走了，我估计是换了一大笔赡养费之类的吧。"
        },
        {
          "role": "阿托斯",
          "text": "今天你到底为什么还能心安理得地送小孩子点心，邀请他们去你家里做客呢？"
        },
        {
          "role": "阿托斯",
          "text": "你都没有一刻会觉得良心不安吗？我百思不得其解。"
        },
        {
          "role": "阿托斯",
          "text": "说实话，我是在秋流浪的时候才遇到了她，她是一个很温柔的母亲。"
        },
        {
          "role": "阿托斯",
          "text": "她对我朋友的女儿佩妮非常温柔，一天不见，小佩妮就嚷嚷着要见秋姐姐。"
        },
        {
          "role": "阿托斯",
          "text": "哦，以防你觉得自己还有翻盘的可能，除了我之外，秋现在还有很多朋友。"
        },
        {
          "role": "阿托斯",
          "text": "你跑到哪里都没有用，我们会追你到天涯海角。"
        },
        {
          "role": "阿托斯",
          "text": "为什么是她这样的人在受折磨，一无所有，你这样的家伙富得流油？我觉得这事儿不太对劲。"
        },
        {
          "role": "莫蒂西娅",
          "text": "收起你多余的好奇心，他不值得。"
        },
        {
          "role": "阿托斯",
          "text": "哎呀，被你听到了。"
        },
        {
          "role": "派蒙",
          "text": "原来你就是秋，我总算知道怎么回事了。勒鲁瓦这一家子真复杂，唉。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们一路跟伯努瓦走到这里，结果发现好多事都和我们之前以为的不太一样。"
        },
        {
          "role": "派蒙",
          "text": "到这个地步，你觉得我们还应该管这件事吗？我听你的。"
        }
      ]
    }
  ]
}