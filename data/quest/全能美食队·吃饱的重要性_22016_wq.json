{
  "quest_id": 22016,
  "chapter_num": null,
  "chapter_title": "全能美食队·吃饱的重要性",
  "type": "wq",
  "route": "The Gourmet Supremos: The Importance of Eating Well",
  "stories": [
    {
      "story_id": 22016,
      "title": "全能美食队·吃饱的重要性",
      "description": "全能美食队的芭尔瓦涅似乎正因为某事而焦急着…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与芭尔瓦涅对话"
        },
        {
          "type": "subtitle",
          "text": "与旭东汇合"
        },
        {
          "role": "旭东",
          "text": "芭尔瓦涅…还有旅行者，你怎么来了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来帮忙。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "是吗…多谢了，朱莉那家伙好像往更深处去了…"
                },
                {
                  "role": "旭东",
                  "text": "那里魔物众多，只凭我们两个，应该很难对付得过来，有你帮忙再好不过了。"
                }
              ]
            },
            {
              "text": "来找你要那顿大餐。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "没问题，不过只凭我一个人，应该没法做那顿大餐。"
                },
                {
                  "role": "旭东",
                  "text": "旅行者，请你先帮我个忙，和我们一起去把朱莉找回来，怎么样？"
                },
                {
                  "role": "旭东",
                  "text": "朱莉那家伙应该走得很深了，那里魔物众多，只凭我们两个，应该很难对付得过来。"
                },
                {
                  "role": "旭东",
                  "text": "把朱莉找回来之后，我就给你兑现那顿大餐。"
                }
              ]
            }
          ]
        },
        {
          "role": "旭东",
          "text": "我们这就出发吧，朱莉应该就在树林里面。"
        },
        {
          "type": "subtitle",
          "text": "与旭东对话"
        },
        {
          "type": "subtitle",
          "text": "向前方搜索"
        },
        {
          "role": "龟井宗久",
          "text": "咳…咳，居然被那群恶徒逼成这样，让各位见笑了。"
        },
        {
          "role": "朱莉",
          "text": "大叔，你没事吧…"
        },
        {
          "role": "龟井宗久",
          "text": "只不过是输了几招，没有大问题。"
        },
        {
          "role": "旭东",
          "text": "朱莉，现在你可以把事情的来龙去脉好好说一下了吧。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "全都说清楚，不然我这些书可就白丢了，啊…书页都皱了…"
        },
        {
          "role": "朱莉",
          "text": "事情很简单啦…就是，我想要送点吃的东西给大叔。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我说你啊…只不过是见了一面而已，你为什么就这么信任…他了啊！"
        },
        {
          "role": "朱莉",
          "text": "大叔肯定是好人！那个时候他明明都那么饿了，还愿意把食物分给我们。"
        },
        {
          "role": "朱莉",
          "text": "饿肚子的时候，还愿意把食物分给人家的人，肯定是好人！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这善恶观还真是纯粹初始又机械…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "你也许并不是生活在提瓦特大陆，而是生活在什么童话世界吧。"
        },
        {
          "role": "旭东",
          "text": "哈哈哈，但是我觉得朱莉说得没错。"
        },
        {
          "role": "旭东",
          "text": "我觉得，能在饿肚子的时候也保持气度的人，一定不会是坏人。"
        },
        {
          "role": "旅行者",
          "text": "这逻辑还真是简单直接…"
        },
        {
          "role": "旭东",
          "text": "总之，朱莉你接着往下说吧。"
        },
        {
          "role": "朱莉",
          "text": "我就做了点野菇鸡肉串，想去第一次遇见大叔的地方碰碰运气。"
        },
        {
          "role": "朱莉",
          "text": "然后，我就过去那里，结果真的看见了大叔。"
        },
        {
          "role": "朱莉",
          "text": "但我刚想和大叔打招呼，突然发现他在和几个海乱鬼对峙，好像还在说什么。"
        },
        {
          "role": "朱莉",
          "text": "我刚想先离远点，但是却被海乱鬼发现了…"
        },
        {
          "role": "龟井宗久",
          "text": "接下来，就由在下说吧。"
        },
        {
          "role": "龟井宗久",
          "text": "那些…人，其中有几位在下的「旧友」，之前和在下一起，在幕府效力。"
        },
        {
          "role": "龟井宗久",
          "text": "在稻妻横生变故后，我们先后都离开了幕府，各自谋生。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刚才就是他们的谋生手段？",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "…正是。我们除了挥剑之外，也没有什么谋生手段。"
                }
              ]
            },
            {
              "text": "难道，那些海乱鬼都是…",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "也并不尽然。但总归都是些挥剑向弱者的懦夫罢了。"
                }
              ]
            },
            {
              "text": "你为什么要离开幕府？",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "只不过是…不能认同幕府在稻妻施行的某种做法罢了。"
                },
                {
                  "role": "龟井宗久",
                  "text": "我只是一介武夫，也并不知道那种做法究竟是否有益于国家。"
                },
                {
                  "role": "龟井宗久",
                  "text": "我只知道那种做法与我心中的想法有悖，所以，我选择了离开。"
                },
                {
                  "role": "龟井宗久",
                  "text": "呵呵，也许是我太过古板，不知变通了吧…让您见笑了。"
                }
              ]
            }
          ]
        },
        {
          "role": "龟井宗久",
          "text": "在那之后，他们成为了那样的「海乱鬼」，以劫掠为生。"
        },
        {
          "role": "龟井宗久",
          "text": "而在下不愿与他们为伍，就一直在四处游荡，想找些工作。"
        },
        {
          "role": "龟井宗久",
          "text": "但听说了我是离开幕府的武士后，也没有人敢雇佣我做事。"
        },
        {
          "role": "龟井宗久",
          "text": "然后，就如同阁下所见，我只能去野外搜刮些食物果腹。"
        },
        {
          "role": "龟井宗久",
          "text": "最近几天，我的那些前同僚们似乎缺了人手，所以每天都来劝我入伙，我也每次都拒绝。"
        },
        {
          "role": "龟井宗久",
          "text": "今天…朱莉小姐出现后，他们还以为我投靠了哪家，想要把他们给吃掉。所以就向我们发动了攻击。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "完全没道理…",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "他们从来不讲什么道理。但处于他们那种境地…确实也没有什么道理好讲。"
                }
              ]
            },
            {
              "text": "他们也太敏感了。",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "处于他们那种境地，敏感也属正常…"
                },
                {
                  "role": "龟井宗久",
                  "text": "但我猜，其实他们也只是想要借这个理由，彻底把我这个「不听话」的人斩掉，以此来立威吧。"
                },
                {
                  "role": "龟井宗久",
                  "text": "毕竟，我三番五次地拒绝他们，肯定也让他们脸上挂不住了。"
                }
              ]
            }
          ]
        },
        {
          "role": "朱莉",
          "text": "然后，大叔就去对付那些坏蛋，我就留在原地等他回来，但是却突然有一群魔物冒了出来…"
        },
        {
          "role": "旅行者",
          "text": "你应该能够对付它们吧？"
        },
        {
          "role": "朱莉",
          "text": "平时是可以啦。但今天早上走的时候没吃东西，肚子很饿，没什么力气。"
        },
        {
          "role": "朱莉",
          "text": "而且被那群海乱鬼发现的时候，野菇鸡肉串也都弄丢了…还好有大叔保护我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这就是吃早饭的重要性。",
              "dialogues": []
            },
            {
              "text": "以后一定要记得吃早饭喔。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芭尔瓦涅",
          "text": "但是，稻妻还有很多那样不讲道理的海乱鬼吧，我们还得呆在稻妻一段时间，总感觉很危险…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "而且凭我们几个人，对付些弱小魔物还凑合，也不太好对付这群会武艺的家伙…"
        },
        {
          "role": "旭东",
          "text": "唔…大叔，你刚才说，你在找工作对吧？"
        },
        {
          "role": "旭东",
          "text": "如果愿意的话，要不要和我们同行？"
        },
        {
          "role": "朱莉",
          "text": "好耶！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "可是，他不是离开幕府的武士吗？这种身份在稻妻，会不会惹上麻烦…"
        },
        {
          "role": "龟井宗久",
          "text": "…没错，在下身份特殊，如果与各位同行，说不定会害各位惹上各种麻烦。"
        },
        {
          "role": "旭东",
          "text": "哈哈哈，我倒觉得没关系。我们只是到处去寻找食材做饭而已。"
        },
        {
          "role": "旭东",
          "text": "以大叔这种身份，做这种完全和幕府和武士搭不上关系的事才最合适。"
        },
        {
          "role": "旭东",
          "text": "要是大叔真的去给人做护卫，或者帮人守门的话，反而会引人猜忌。"
        },
        {
          "role": "旭东",
          "text": "而且，大叔这样子的好人却被迫饿着肚子，我觉得是十分没有道理的事。"
        },
        {
          "role": "旭东",
          "text": "作为厨师，我可看不过去，虽然其他的事没法管，但我至少要管一管他的饭。"
        },
        {
          "role": "龟井宗久",
          "text": "阁下，您…"
        },
        {
          "role": "旭东",
          "text": "嘿嘿，怎么样大叔，你愿意和我们同行吗？工钱虽然开不了多少，但饭一定管够。"
        },
        {
          "role": "龟井宗久",
          "text": "……"
        },
        {
          "role": "龟井宗久",
          "text": "在下，从命。"
        },
        {
          "role": "朱莉",
          "text": "好耶——"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这也算是好事吧，算是好事…"
        },
        {
          "role": "旭东",
          "text": "好嘞！大家辛苦了这么久，肚子都要饿扁了，虽然这里不太好起灶…但我还是能想办法做点食物的…"
        },
        {
          "role": "旭东",
          "text": "旅行者，你也别忙了，我来搞定就好，你就在这里等着开饭吧。"
        },
        {
          "role": "旭东",
          "text": "那么，开始动手了！"
        },
        {
          "role": "旭东",
          "text": "这样就行了…哈哈，用剩饭做的「饭团」，虽然有点粗糙…但填饱肚子应该够了，大家开吃吧。"
        },
        {
          "role": "旭东",
          "text": "对了旅行者，这一路上谢谢你了，这份食谱给你，这是宗久大叔刚给我的，我也给你抄了一份。"
        },
        {
          "role": "旭东",
          "text": "他说这是他在幕府的时候记下的食谱，据说还挺有特色的，有兴趣的话，你也研究一下吧。"
        },
        {
          "role": "旭东",
          "text": "好了好了，不多说了，快点开吃吧。"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "role": "旭东",
          "text": "总算是吃饱了…呃…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你为什么要帮他？",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "你说宗久大叔？那当然是出于一个厨师的职业道德了。"
                },
                {
                  "role": "旭东",
                  "text": "开玩笑的。但我是真的不愿意看见大叔这样的好人饿肚子。"
                },
                {
                  "role": "旭东",
                  "text": "不，或者说…我不想看见任何一个人饿肚子。"
                },
                {
                  "role": "旭东",
                  "text": "饥饿是一种很可怕的感觉，我…感受过这种感觉。"
                },
                {
                  "role": "旭东",
                  "text": "在饥饿感的逼迫下…人会做出很可怕的事。"
                },
                {
                  "role": "旭东",
                  "text": "我想，如果这个世界上人人都能吃饱吃好，或许，就能避免很多坏事发生了。"
                },
                {
                  "role": "旭东",
                  "text": "虽然我一个人没法做到这种事，但我至少能做个厨师，努力让我身边的人吃饱吃好。"
                },
                {
                  "role": "旭东",
                  "text": "哈哈哈，说白了，我就是想要让大家都能吃饱吃好而已，是不是个很没意思的理想？"
                },
                {
                  "role": "旅行者",
                  "text": "是个很伟大的理想。"
                },
                {
                  "role": "旭东",
                  "text": "嘿嘿，多谢啦。呃…不说了，你快再吃点，可别剩下了，剩饭可是大罪过。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "你要走了吗？不然…再吃点？"
                }
              ]
            }
          ]
        },
        {
          "role": "朱莉",
          "text": "嘿嘿，其实还挺好吃的，我还要再吃一点…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你为什么要送吃的给他？",
              "dialogues": [
                {
                  "role": "朱莉",
                  "text": "嗯…我就是不想看见大叔饿肚子嘛。"
                },
                {
                  "role": "朱莉",
                  "text": "而且，上次见到大叔的时候，他好像很难过的样子，我觉得，说不定就是因为没吃饱的原因。"
                },
                {
                  "role": "朱莉",
                  "text": "所以我想要给大叔送点吃的，只要吃饱了，大叔也许就不会那么难过了。"
                }
              ]
            },
            {
              "text": "你为什么会相信他？",
              "dialogues": [
                {
                  "role": "朱莉",
                  "text": "那是…冒险家的直觉喔。我可是很会分辨好人和坏蛋的。"
                },
                {
                  "role": "朱莉",
                  "text": "而且我真的觉得，在饿肚子的时候还把食物分给别人…只有好人才会做这样的事。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "朱莉",
                  "text": "再见。我以后一定记得吃早饭…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与朱莉对话"
        },
        {
          "role": "芭尔瓦涅",
          "text": "你、你这家伙…要是把锅砸坏了，我们还用什么做饭啊！？"
        },
        {
          "role": "旭东",
          "text": "别小看璃月的铸锅技术，我这口锅可是专门用来练习颠锅的特制铸铁锅，可不会轻易坏掉。"
        },
        {
          "role": "旭东",
          "text": "再说了，只是几个魔物而已。连魔物都没法砸倒，还算什么铁锅。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "你对这口铁锅的期望未免太高了些…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旭东可真是有气势。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "那是当然了，这可是做厨师的必修课。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "完全没听说过好吗？！为什么厨师要学习用铁锅砸翻魔物啊！？"
                }
              ]
            },
            {
              "text": "那么，在哪里可以买到这口锅呢？",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "哈哈哈，问得好，我是找「寒锋铁器」的那个大叔特别铸造的。"
                },
                {
                  "role": "旭东",
                  "text": "据说大叔还往里面加入了一些从层岩巨渊里开掘出来的材料，如果你想买的话，直接去找他就好了。"
                },
                {
                  "role": "旭东",
                  "text": "不过我听说层岩巨渊已经被封锁很久了，估计现在你找他，他也没法做了吧…"
                }
              ]
            },
            {
              "text": "芭尔瓦涅的气势也很足。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "咦？那个啊…哈哈哈，我只不过就是往那些魔物头上丢了几本书而已，还是靠你才击退了魔物。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "等等，我的那本《与神性同行》第六卷呢？不、不会也丢出去了吧…我还没看完呢！"
                }
              ]
            }
          ]
        },
        {
          "role": "旭东",
          "text": "好了，朱莉，我们现在赶紧离开这里…"
        },
        {
          "role": "朱莉",
          "text": "等、等一下，快去帮帮大叔，他一个人去树林里和那些海乱鬼战斗了！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "海乱鬼？不是魔物吗？为什么还会和那种家伙扯上关系…"
        },
        {
          "role": "朱莉",
          "text": "我、我之后会说的…快去帮帮大叔吧，他只有一个人…"
        },
        {
          "role": "旭东",
          "text": "我知道了。旅行者，请再和我们同行一段吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": []
            },
            {
              "text": "你要和海乱鬼战斗吗？",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "那是当然，我这口锅可是在跃跃欲试。"
                },
                {
                  "role": "旭东",
                  "text": "而且，厨师可不能临阵脱逃啊。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "都说了，不要对厨师和铁锅有这种过高的期待！"
                }
              ]
            }
          ]
        },
        {
          "role": "旭东",
          "text": "我们快点出发吧，走了！"
        },
        {
          "type": "subtitle",
          "text": "向前搜索龟井宗久的踪迹"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这两个人实在是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好像还是不太信任他？",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "你说龟井宗久吗？那当然了…我们见都没见过这个人几次，怎么能轻易信任他。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "…但是，虽然我不相信龟井宗久，但我还是会相信旭东的判断。"
                }
              ]
            },
            {
              "text": "你来自教令院？",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "我…算是吧，我本来是从教令院出来游学的，在璃月遇见了旭东。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "他打算去四处旅行研究食谱，我研究的课题恰好也和美食有关。在和他讨论过几次之后，我们就一起同行了。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "我们首先去了蒙德，在那里被一堆魔物围住了，还好朱莉过来帮忙赶走了它们。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "她听说我们想要四处旅行寻找美食之后，就也加入了我们。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "虽然她说自己本来就打算四处冒险，但我总感觉，这家伙就是想要吃好吃的而已…"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "我们下一站应该会去须弥，我的课题也研究得差不多了，也该回教令院一趟了。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "哼，等到了须弥，一定要让他们感受一下须弥的特色美食…"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "嗯，再见。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与龟井宗久对话"
        },
        {
          "role": "龟井宗久",
          "text": "阁下，请问有什么事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你为什么会答应旭东？",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "正如旭东阁下说的，目前…如果我想要吃饱的话，为他工作是最好的选择。"
                },
                {
                  "role": "龟井宗久",
                  "text": "而且，朱莉小姐和旭东阁下，我认为都是品德高尚之人，与他们同行是我的荣幸。"
                },
                {
                  "role": "龟井宗久",
                  "text": "芭尔瓦涅阁下…是一个心思缜密的人，她对我有所警惕也属正常。"
                },
                {
                  "role": "龟井宗久",
                  "text": "而且她也仅是警惕，并未排斥我，这就…足够了。"
                }
              ]
            },
            {
              "text": "你真的一直在外游荡吗？",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "在下自然不会说谎。从幕府离开后，我就一直在外徘徊。"
                },
                {
                  "role": "龟井宗久",
                  "text": "一般来说，我会用野果来填肚子，运气好的话，会有一些猎物。"
                },
                {
                  "role": "龟井宗久",
                  "text": "我偶尔也会帮助一些需要帮助的人，比如击退魔物，或者海乱鬼，这样也会得到一些报酬。"
                },
                {
                  "role": "龟井宗久",
                  "text": "呵呵…对我这种除了挥剑外别无长处的人来说，工作的机会实在有些少。"
                },
                {
                  "role": "龟井宗久",
                  "text": "更不用说我还有「离开幕府」这种背景在，人们总是会把我和海乱鬼联系在一起，如此…就更难找到工作了。"
                },
                {
                  "role": "龟井宗久",
                  "text": "我在稻妻也没什么居所，也没有亲眷可投奔，除了在外游荡，我也没有地方可去了。"
                }
              ]
            },
            {
              "text": "你为什么要离开幕府？",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "只不过是…不能认同幕府在稻妻施行的某种做法罢了。"
                },
                {
                  "role": "龟井宗久",
                  "text": "我只是一介武夫，也并不知道那种做法究竟是否有益于国家。"
                },
                {
                  "role": "龟井宗久",
                  "text": "我只知道那种做法与我心中的想法有悖，所以，我选择了离开。"
                },
                {
                  "role": "龟井宗久",
                  "text": "呵呵，也许是我太过古板，不知变通了吧…让您见笑了。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "再见，阁下。"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}