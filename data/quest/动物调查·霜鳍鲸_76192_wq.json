{
  "quest_id": 76192,
  "chapter_num": null,
  "chapter_title": "动物调查·霜鳍鲸",
  "type": "wq",
  "route": "Animal Research: Frostfin Whales",
  "stories": [
    {
      "story_id": 76192,
      "title": "动物调查·霜鳍鲸",
      "description": "据说在伦波岛西北侧的海域有粉色的霜鳍鲸出没…",
      "dialogues": [
        {
          "role": "赫卡",
          "text": "看来今天运气不太好，等了这么久，就连普通的霜鳍鲸也没见到几只…"
        },
        {
          "role": "玫熙",
          "text": "唔…"
        },
        {
          "role": "赫卡",
          "text": "要不今天就算了，先回去吧，以后还会有机会的。"
        },
        {
          "role": "玫熙",
          "text": "可是…可是你这次回来待不了多久就又会去其他地方吧…"
        },
        {
          "role": "玫熙",
          "text": "我们再等一下吧。"
        },
        {
          "role": "莉奈娅",
          "text": "欸？难道是赫卡？"
        },
        {
          "role": "赫卡",
          "text": "莉奈娅姐姐。是的，我回来了，不过我的图鉴还差一点才能完成，所以现在还不能和你分个胜负。"
        },
        {
          "role": "莉奈娅",
          "text": "哦？这么说来你这次远行也收获不少啊，不过这段时间我也没闲着，我也给图鉴增补了不少内容呢。"
        },
        {
          "role": "玫熙",
          "text": "莉奈娅姐姐也是来看那只霜鳍鲸的吗？"
        },
        {
          "role": "莉奈娅",
          "text": "是呀是呀，听说是最近才被发现的，考虑到它的体型，我推测是环境变化导致了表皮颜色的变化。"
        },
        {
          "role": "莉奈娅",
          "text": "比方说，环境中月矩力的浓度之类的…"
        },
        {
          "role": "赫卡",
          "text": "很可惜，今天大概是见不到了。我们已经等了很久了，但还是一无所获。"
        },
        {
          "role": "赫卡",
          "text": "莉奈娅姐姐，你也劝劝她，今天我们就先回去…"
        },
        {
          "role": "玫熙",
          "text": "我没事的，今天醒来的时候就觉得状态比平时都好，我们再等一下吧。"
        },
        {
          "role": "玫熙",
          "text": "据说见到那只霜鳍鲸的人，想要实现的愿望就能成真。那就说明，它是会带来好运的动物吧？"
        },
        {
          "role": "玫熙",
          "text": "我希望赫卡能够带上它送来的好运再出发。"
        },
        {
          "role": "赫卡",
          "text": "可是…"
        },
        {
          "role": "莉奈娅",
          "text": "那我们就一起等吧。"
        },
        {
          "role": "赫卡",
          "text": "莉奈娅姐姐！"
        },
        {
          "role": "莉奈娅",
          "text": "你先别急嘛，我有预感，今天一定能看到那只霜鳍鲸的。"
        },
        {
          "role": "莉奈娅",
          "text": "赫卡也知道的吧？我的预感一向很准。"
        },
        {
          "role": "赫卡",
          "text": "好吧…那就再等一会儿，但是真的只能一会儿哦！"
        },
        {
          "role": "？？？",
          "text": "等了一会儿…"
        },
        {
          "role": "莉奈娅",
          "text": "快看快看！哇，它跳得好高！"
        },
        {
          "role": "莉奈娅",
          "text": "要是我也能游得那么快就好了，如果能和它们同游，一定会很快乐吧！"
        },
        {
          "role": "莉奈娅",
          "text": "干脆现在就下水试试——"
        },
        {
          "role": "赫卡",
          "text": "那也太危险啦！唉，离开这么久回来一看，莉奈娅姐姐还是这么冒失…"
        },
        {
          "role": "莉奈娅",
          "text": "哪、哪有！赫卡难道不想和它们一起玩耍吗？它们玩得那么开心欸。"
        },
        {
          "role": "玫熙",
          "text": "可是衣服打湿了着凉了就不好了，不如留在岸上，用留影机记录下它们开心的样子吧？"
        },
        {
          "role": "莉奈娅",
          "text": "这么说也有道理…那就借赫卡的留影机一用了。"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点开启调查"
        },
        {
          "role": "？？？",
          "text": "快速做好了调查的准备…"
        },
        {
          "type": "subtitle",
          "text": "与玫熙对话"
        },
        {
          "type": "subtitle",
          "text": "为霜鳍鲸留影"
        },
        {
          "role": "旅行者",
          "text": "（附近似乎有些值得调查的，如果是对本地生态十分了解的<color=#FFCC33FF>莉奈娅</color>，或许会有所收获…）"
        },
        {
          "type": "subtitle",
          "text": "与玫熙对话"
        },
        {
          "role": "玫熙",
          "text": "什么都没有…"
        },
        {
          "role": "赫卡",
          "text": "今天运气不太好呢。"
        },
        {
          "role": "玫熙",
          "text": "拍得真好。"
        },
        {
          "role": "赫卡",
          "text": "现在心满意足了？"
        },
        {
          "role": "玫熙",
          "text": "嗯！不管传说是不是真的，我希望不论赫卡走到哪里，好运都会助你化险为夷，最后平安回到「斯佩兰扎」。"
        },
        {
          "role": "赫卡",
          "text": "…谢谢。"
        },
        {
          "role": "玫熙",
          "text": "嘿嘿，那我们回去吧？莉奈娅姐姐，也谢谢你，我们「斯佩兰扎」见！"
        },
        {
          "role": "莉奈娅",
          "text": "「斯佩兰扎」见！"
        }
      ]
    }
  ]
}