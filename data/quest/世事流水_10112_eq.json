{
  "quest_id": 10112,
  "chapter_num": "秋津森夜试胆会 其三",
  "chapter_title": "世事流水",
  "type": "eq",
  "route": "The Currents of Life",
  "stories": [
    {
      "story_id": 40091,
      "title": "世事流水",
      "description": "本以为一切都是小妖怪引发的误会，没想到背后似乎还有隐情…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到第二天"
        },
        {
          "type": "subtitle",
          "text": "前往试胆大会现场"
        },
        {
          "role": "派蒙",
          "text": "等了这么久，巫女姐姐还是没有出现。"
        },
        {
          "role": "派蒙",
          "text": "看来要我们自己完成第三轮试胆大会了。这次要怎么分组呢？"
        },
        {
          "role": "鹿野院平藏",
          "text": "旅行者、派蒙，最后一轮试胆大会，就由我来做你们的搭档吧。"
        },
        {
          "role": "鹿野院平藏",
          "text": "所有人中唯独你们见过那位「幽灵」，我想和你们一起调查真相。"
        },
        {
          "role": "派蒙",
          "text": "嗯，我没问题，旅行者觉得呢？"
        },
        {
          "role": "旅行者",
          "text": "平藏有什么头绪吗？"
        },
        {
          "role": "鹿野院平藏",
          "text": "现在线索太少，我的脑袋中也只有一些猜测。"
        },
        {
          "role": "鹿野院平藏",
          "text": "不过我有一些想要调查的地方，等下你们跟我一起去看看吧。"
        },
        {
          "role": "派蒙",
          "text": "去哪里？"
        },
        {
          "role": "鹿野院平藏",
          "text": "先去我们第一次见面的地方。根据你们的描述，你们在那里遇到了「幽灵」，然后昏了过去。"
        },
        {
          "role": "鹿野院平藏",
          "text": "我想那里应该还留存有一些线索。"
        },
        {
          "role": "派蒙",
          "text": "真的要过去吗？我们会不会…嗯…「自投罗网」？"
        },
        {
          "role": "鹿野院平藏",
          "text": "你是担心她在那里等我们吗？对我来说，那样更好。"
        },
        {
          "role": "鹿野院平藏",
          "text": "我正愁找不到她。她要是这么轻易就出现，我也省了很多事。"
        },
        {
          "role": "派蒙",
          "text": "平藏，胆子好大…"
        },
        {
          "role": "鹿野院平藏",
          "text": "接触的案子多了，自然就不怕了。我们走吧。"
        },
        {
          "type": "subtitle",
          "text": "前往初见神秘女性的地方"
        },
        {
          "role": "鹿野院平藏",
          "text": "这里应该就是你们第一次遇到幽灵的地方。"
        },
        {
          "role": "鹿野院平藏",
          "text": "当然，那位女性是不是幽灵，眼下还不能确定。"
        },
        {
          "role": "鹿野院平藏",
          "text": "我想重新梳理一下整个过程，你们还记得当时她说过什么吗？"
        },
        {
          "role": "派蒙",
          "text": "我想想…"
        },
        {
          "role": "派蒙",
          "text": "她说我们不该接近她。还说我们再不离开的话，会把灵魂留在这里。"
        },
        {
          "role": "派蒙",
          "text": "呜呜，真不想回忆当时的场景…一旦回想起来，身体又开始发抖了！"
        },
        {
          "role": "鹿野院平藏",
          "text": "然后呢？"
        },
        {
          "role": "派蒙",
          "text": "然后我感觉眼前变得好暗，头也晕乎乎的，到处都是鬼火在闪烁。"
        },
        {
          "role": "派蒙",
          "text": "我感觉那个幽灵身边好像有黑雾缭绕，紧接着我就昏过去了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "嗯。从描述来看，确实给人一种幽灵作祟的感觉。"
        },
        {
          "role": "派蒙",
          "text": "是呀！果然平藏也这么觉得吧？"
        },
        {
          "role": "鹿野院平藏",
          "text": "我不否认，不过比起她是什么，我更在意她「到底想做什么」。"
        },
        {
          "role": "鹿野院平藏",
          "text": "就算是幽灵，只要她具备理智，那么做事就应该是为了某种切实的目的。"
        },
        {
          "role": "派蒙",
          "text": "不是要我们的灵魂吗？我听她是这么说的。"
        },
        {
          "role": "鹿野院平藏",
          "text": "那个多半是吓你们的吧。"
        },
        {
          "role": "派蒙",
          "text": "欸？这样吗？"
        },
        {
          "role": "鹿野院平藏",
          "text": "怎么说呢，如果我有「取走灵魂」这种能力，根本用不着三番两次地警告你们。"
        },
        {
          "role": "鹿野院平藏",
          "text": "而且，大概也根本不会允许你们带着这种秘密在附近闲逛的。"
        },
        {
          "role": "派蒙",
          "text": "这么一说确实有道理，我怎么就没想到呢？"
        },
        {
          "role": "旅行者",
          "text": "派蒙一直在害怕吧。"
        },
        {
          "role": "鹿野院平藏",
          "text": "我认为只有两种情况。第一种是她想收割你们的灵魂，但必须要达成某种条件，类似于我们常说的诅咒。"
        },
        {
          "role": "鹿野院平藏",
          "text": "不过对于你们来说，如果真的中了什么诅咒，肯定能感觉到异样吧。"
        },
        {
          "role": "鹿野院平藏",
          "text": "所以这种可能性比较小。我认为她只是想借此吓跑你们而已。"
        },
        {
          "role": "派蒙",
          "text": "吓跑我们做什么…等等，我明白啦！"
        },
        {
          "role": "派蒙",
          "text": "说不定她是想让我们弃权，好独吞试胆大会的奖品！"
        },
        {
          "role": "旅行者",
          "text": "她有报名参加试胆大会吗？"
        },
        {
          "role": "派蒙",
          "text": "对哦。应该没有吧…那会是什么原因呢？平藏，你能想到吗？"
        },
        {
          "role": "鹿野院平藏",
          "text": "单从你们的描述来看，我认为她对你们没有恶意，只是不希望你们继续呆在这里。"
        },
        {
          "role": "鹿野院平藏",
          "text": "不过单靠这一点也猜不到什么。以常理推断，她可能是在看守什么宝藏，或是掩盖什么凶案。"
        },
        {
          "role": "鹿野院平藏",
          "text": "不过我的直觉认为这些推测都不对。还是先在附近调查一下吧。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（鹿野院平藏）"
        },
        {
          "role": "鹿野院平藏",
          "text": "嗯…"
        },
        {
          "type": "subtitle",
          "text": "在附近寻找线索"
        },
        {
          "type": "subtitle",
          "text": "[线索一]",
          "narration": true
        },
        {
          "role": "旅行者",
          "text": "（地上能看出些许脚印的痕迹。）"
        },
        {
          "role": "旅行者",
          "text": "（但仔细辨认，似乎只有我和平藏的脚印。难道那名女性真的是幽灵…？）"
        },
        {
          "type": "subtitle",
          "text": "[线索二]",
          "narration": true
        },
        {
          "role": "旅行者",
          "text": "（四下环顾一番，没有看到什么线索。）"
        },
        {
          "role": "旅行者",
          "text": "（向上看去时，感觉有几根树枝微微向下弯曲，好像曾悬挂过什么重物。）"
        },
        {
          "type": "subtitle",
          "text": "与平藏讨论刚刚的发现"
        },
        {
          "role": "鹿野院平藏",
          "text": "发现什么线索了吗？"
        },
        {
          "role": "旅行者",
          "text": "有几根树枝不太正常。"
        },
        {
          "role": "派蒙",
          "text": "我们看见树枝好像被什么东西压弯了，别的再没有什么了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "嗯，之前和你们分别后，我在附近找了一圈。"
        },
        {
          "role": "鹿野院平藏",
          "text": "除了树枝被压弯外，有些地方还有些许烧灼的印痕，但依旧说明不了什么。"
        },
        {
          "role": "鹿野院平藏",
          "text": "如果能有什么更直观的物证…"
        },
        {
          "role": "独眼小僧",
          "text": "你们好…那个…没打扰到你们吧？"
        },
        {
          "role": "派蒙",
          "text": "独眼小僧！还有狐妖和河童，你们怎么来啦？"
        },
        {
          "role": "狐妖",
          "text": "听说你们在调查线索，我们想来帮忙。"
        },
        {
          "role": "派蒙",
          "text": "真勇敢！"
        },
        {
          "role": "河童",
          "text": "其，其实我们心里也没底…"
        },
        {
          "role": "河童",
          "text": "刚刚我们询问了荒泷大人的小弟们，听他们详细描述了所见所闻，的确很可怕。"
        },
        {
          "role": "河童",
          "text": "那家伙绝对是什么恐怖的恶灵，或者是妖力充沛的邪恶大妖怪…不管哪个都不是善茬。"
        },
        {
          "role": "河童",
          "text": "但是，但是一想到「三川花祭」——"
        },
        {
          "role": "独眼小僧",
          "text": "……"
        },
        {
          "role": "狐妖",
          "text": "我们从很早以前，就十分憧憬镰井大人与武士大人的友谊。"
        },
        {
          "role": "狐妖",
          "text": "正是因为这份憧憬，我们才在受人恩惠后，想要举办三川花祭来报答。"
        },
        {
          "role": "狐妖",
          "text": "就算力量有限，我们也不希望这份来之不易的友谊蒙上尘埃。三川花祭，应该是让人尽兴而归才对。"
        },
        {
          "role": "鹿野院平藏",
          "text": "镇守之森很大，多些人手一起调查，也是件好事。"
        },
        {
          "role": "鹿野院平藏",
          "text": "那就拜托你们，再好好找一找了。"
        },
        {
          "role": "独眼小僧",
          "text": "放心，我们对这里很熟悉，不会错过任何可疑的线索的！"
        },
        {
          "type": "subtitle",
          "text": "查看小妖怪的发现"
        },
        {
          "role": "河童",
          "text": "呼、呼…"
        },
        {
          "role": "河童",
          "text": "你们看，我在河流的下游找到了这个…"
        },
        {
          "role": "独眼小僧",
          "text": "这是什么？"
        },
        {
          "role": "狐妖",
          "text": "好像是一块黑布的残片？不过这种布料，以前我从来没有见过。"
        },
        {
          "role": "鹿野院平藏",
          "text": "这是遮光布的碎片。"
        },
        {
          "role": "派蒙",
          "text": "遮光布？"
        },
        {
          "role": "鹿野院平藏",
          "text": "嗯。对光线有很强的阻挡效果，常用于舞台等各种地方。"
        },
        {
          "role": "鹿野院平藏",
          "text": "布料的断口很粗糙，似乎是被石子或者树枝划开的…"
        },
        {
          "role": "派蒙",
          "text": "树枝…？"
        },
        {
          "role": "鹿野院平藏",
          "text": "假定曾有一块很大的遮光布悬挂在树上，树枝因此被压弯。"
        },
        {
          "role": "鹿野院平藏",
          "text": "将遮光布从树上扯下的时候，某个角被树枝划破，一小片黑布落入水中。"
        },
        {
          "role": "鹿野院平藏",
          "text": "当事人没有在意，或者说她来不及管。她还有许多不得不做的事情。"
        },
        {
          "role": "派蒙",
          "text": "为什么要把遮光布挂到树上呢？"
        },
        {
          "role": "鹿野院平藏",
          "text": "这只是我的猜测——"
        },
        {
          "role": "鹿野院平藏",
          "text": "也许，是为了刻意「营造」出你们所见到的氛围。"
        },
        {
          "role": "旅行者",
          "text": "什么意思？"
        },
        {
          "role": "鹿野院平藏",
          "text": "先不用在意，许多事我也还没想清楚。"
        },
        {
          "role": "鹿野院平藏",
          "text": "我想去荒泷派那些人被吓到的地方再调查一下，你们认识路吗？"
        },
        {
          "role": "独眼小僧",
          "text": "我认识路。"
        },
        {
          "role": "独眼小僧",
          "text": "荒泷大人的小弟们聊天时，我问了问他们「撞鬼」的确切位置。我带你们去！"
        },
        {
          "role": "鹿野院平藏",
          "text": "那就麻烦你了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "走，我们过去看看。"
        },
        {
          "type": "subtitle",
          "text": "跟随小妖怪去下个地方调查"
        },
        {
          "role": "独眼小僧",
          "text": "就是这里！"
        },
        {
          "role": "独眼小僧",
          "text": "我听说他们路过这里的时候，周围突然变暗，紧接着鬼火不停闪烁…"
        },
        {
          "role": "派蒙",
          "text": "嗯？听起来怎么这么熟悉？"
        },
        {
          "role": "派蒙",
          "text": "这和我们见到的差不多吧？"
        },
        {
          "role": "鹿野院平藏",
          "text": "和之前一样，先在这附近调查一下吧。"
        },
        {
          "type": "subtitle",
          "text": "在附近寻找线索"
        },
        {
          "type": "subtitle",
          "text": "[与鹿野院平藏对话]",
          "narration": true
        },
        {
          "role": "鹿野院平藏",
          "text": "果然…"
        },
        {
          "type": "subtitle",
          "text": "[与独眼小僧对话]",
          "narration": true
        },
        {
          "role": "独眼小僧",
          "text": "我在树底下捡到了一个碎掉的球。"
        },
        {
          "role": "独眼小僧",
          "text": "里面被烟雾熏烤得黑乎乎的，还有像烟花一样的味道。"
        },
        {
          "type": "subtitle",
          "text": "[与狐妖对话]",
          "narration": true
        },
        {
          "role": "狐妖",
          "text": "从火焰留下的痕迹来看，你们看到的鬼火应该不是用妖力做出来的。"
        },
        {
          "role": "狐妖",
          "text": "倒像是什么东西燃烧形成的？我也不太明白。"
        },
        {
          "type": "subtitle",
          "text": "[与河童对话]",
          "narration": true
        },
        {
          "role": "河童",
          "text": "旁边的石缝中有一些奇怪的粉末…"
        },
        {
          "role": "河童",
          "text": "我捏了一点闻了闻，感觉脑袋晕晕的…好困啊…"
        },
        {
          "type": "subtitle",
          "text": "听听平藏的分析"
        },
        {
          "role": "鹿野院平藏",
          "text": "相似的吓人手段、没来得及完全清理掉的痕迹…"
        },
        {
          "role": "鹿野院平藏",
          "text": "我想，我们离真相已经很近了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "现在基本可以确定，你们遇到的那名女性不是什么幽灵。"
        },
        {
          "role": "鹿野院平藏",
          "text": "她没有什么匪夷所思的力量，只是在用一些提前布置好的小道具吓人而已。"
        },
        {
          "role": "派蒙",
          "text": "小道具？靠那些东西真的能做到吗，我们见到的画面明明很恐怖。"
        },
        {
          "role": "鹿野院平藏",
          "text": "首先，试胆大会原本就让这里多了些恐怖的氛围。"
        },
        {
          "role": "鹿野院平藏",
          "text": "当时的你们先遇到三只小妖怪，被它们吓了一跳。随后又遇到了神秘的女性，感到紧张是必然的。"
        },
        {
          "role": "鹿野院平藏",
          "text": "因紧张而过度呼吸，吸入了大量她预先洒好的安眠花粉，开始感到眩晕。"
        },
        {
          "role": "鹿野院平藏",
          "text": "这时她拉下遮光布，点燃所谓的鬼火，制造出一副未知而可怕的景象——大概就是这么一回事吧。"
        },
        {
          "role": "狐妖",
          "text": "这么说来，她其实只是虚张声势？"
        },
        {
          "role": "派蒙",
          "text": "可恶，居然敢骗我！"
        },
        {
          "role": "鹿野院平藏",
          "text": "但其实还有一个问题。委托我来调查这件事的人，确实是被某种不同寻常的力量困在沙滩上的。"
        },
        {
          "role": "鹿野院平藏",
          "text": "这可不是用一些小道具就能做到的事…但如果她真有这样的力量，为什么还要准备这么多道具呢？"
        },
        {
          "role": "派蒙",
          "text": "我已经开始头疼了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "……"
        },
        {
          "role": "鹿野院平藏",
          "text": "在林中只能用道具吓人，在沙滩上却能使用奇特的力量…原来如此，我大概明白了。"
        },
        {
          "role": "派蒙",
          "text": "这么快！"
        },
        {
          "role": "鹿野院平藏",
          "text": "嗯。如果排除团伙作案的可能性，就只有一种情况了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "我知道你们遇到的那名女性的身份了，我们去海滩看看吧。"
        },
        {
          "role": "狐妖",
          "text": "我们也去！"
        },
        {
          "role": "鹿野院平藏",
          "text": "不，我希望你们回去一趟，告诉其他人不用害怕，也不用在林中费力调查了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "真相已经浮出水面，是时候结束不必要的恐慌，等待试胆大会结束了。"
        },
        {
          "role": "独眼小僧",
          "text": "好的，那你们注意安全。"
        },
        {
          "role": "独眼小僧",
          "text": "遇到什么危险的话，就大声叫我们，我们肯定能听见的。"
        },
        {
          "role": "鹿野院平藏",
          "text": "不会有什么危险。不过谢谢，我们走吧。"
        },
        {
          "type": "subtitle",
          "text": "到海滩寻找异常的地方"
        },
        {
          "role": "鹿野院平藏",
          "text": "沿着悬崖找找看吧，如果我没猜错，应该有一块泥土不太一样…"
        },
        {
          "role": "？？？",
          "text": "我就知道…你们果然还是找到这里来了。"
        },
        {
          "role": "派蒙",
          "text": "出现了！"
        },
        {
          "role": "派蒙",
          "text": "本来以为你是小妖怪的同伴，但它们说并没有见过你。"
        },
        {
          "role": "派蒙",
          "text": "你到底是谁呀？为什么要吓唬我们？"
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "role": "？？？",
          "text": "我说过，你们不该跟我搭话。如果再不消失的话——"
        },
        {
          "role": "派蒙",
          "text": "噫！她看上去好吓人！平藏，现在周围应该没有什么小道具吧？"
        },
        {
          "role": "鹿野院平藏",
          "text": "别动，这也是为了你好。"
        },
        {
          "role": "鹿野院平藏",
          "text": "这点妖力吓不到我们，反而会让你消失得更快。"
        },
        {
          "role": "派蒙",
          "text": "妖力？"
        },
        {
          "role": "？？？",
          "text": "…你为什么会知道？"
        },
        {
          "role": "鹿野院平藏",
          "text": "依物品而诞生的小妖怪，在本体之外幻化出人类的外形。"
        },
        {
          "role": "鹿野院平藏",
          "text": "在靠近本体的时候能使用些许妖力，离本体太远力量就会衰减。"
        },
        {
          "role": "鹿野院平藏",
          "text": "以及，如果本体坏掉的话，依其诞生的小妖怪也会彻底消失。"
        },
        {
          "role": "鹿野院平藏",
          "text": "应该叫你「物灵」…还是「付丧神」比较好？"
        },
        {
          "role": "羽生田千鹤",
          "text": "…不用那么麻烦。我有自己的名字，叫作羽生田千鹤。"
        },
        {
          "role": "派蒙",
          "text": "千鹤…为什么你希望我们离开呢？"
        },
        {
          "role": "派蒙",
          "text": "如果你也是妖怪的话，应该能理解独眼小僧它们的想法才对…"
        },
        {
          "role": "派蒙",
          "text": "而且，我们一起玩秋津游艺的时候也很开心呀。就像，就像故事中的镰井与武士——"
        },
        {
          "role": "羽生田千鹤",
          "text": "就是…因为这样…"
        },
        {
          "role": "羽生田千鹤",
          "text": "就是因为这样，我才不想让你们也难过啊…"
        },
        {
          "role": "派蒙",
          "text": "难过？什么意思？"
        },
        {
          "role": "羽生田千鹤",
          "text": "你们从小妖怪那里，听说了镰井与武士结识的故事吧。"
        },
        {
          "role": "羽生田千鹤",
          "text": "其实，那个故事还有一段，是它们不知道的。"
        },
        {
          "type": "subtitle",
          "text": "https://www.bilibili.com/video/BV1tG411P79B?t=104.3 过场动画"
        },
        {
          "type": "subtitle",
          "text": "羽生田千鹤：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "祭典相遇之时，人类武士大约二十五岁",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "十年后",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "双方再次碰面，依旧一见如故",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "饮酒、同游、切磋比试…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "初见时或许只是惺惺相惜",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "现在却真心将彼此视作挚友",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "又十年，人类武士剑道达到巅峰",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "竟在比试中略胜一筹",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "镰井先生大为惊奇",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "从此戒酒、修行，铆足劲要再战一场",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "然而下一个十年，却没有等到武士赴约",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "原来南方爆发战乱，武士前往戍边",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "对妖怪来说，十年弹指一挥间",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "镰井先生未曾在意",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "可再次见面时，镰井先生却不敢相认…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "人类武士六十五岁",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "一身伤疤，满头白发",
          "narration": true
        },
        {
          "role": "镰井显治",
          "text": "喂，小子，还握得动剑吗？"
        },
        {
          "role": "柳桥卓人",
          "text": "年事已高，难负所托了"
        },
        {
          "role": "柳桥卓人",
          "text": "我这次，其实是为告别而来"
        },
        {
          "role": "镰井显治",
          "text": "这样啊"
        },
        {
          "role": "镰井显治",
          "text": "那陪我再来一场「秋津羽戏」，如何？"
        },
        {
          "role": "柳桥卓人",
          "text": "也好"
        },
        {
          "type": "subtitle",
          "text": "羽生田千鹤：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "那一场「秋津羽戏」，人类武士依旧拼尽全力",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "却因体力不支早早出局",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "放下羽子板后，镰井先生沉默许久",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "留下一声长叹",
          "narration": true
        },
        {
          "role": "镰井显治",
          "text": "…令人遗憾"
        },
        {
          "role": "羽生田千鹤",
          "text": "从「令人期待」到「令人遗憾」，不过短短几十年的时间。"
        },
        {
          "role": "羽生田千鹤",
          "text": "镰井大人容貌未变，面前的故人却垂垂老矣。相遇时的快意，最终都会熬煮成名为遗憾的毒药。"
        },
        {
          "role": "羽生田千鹤",
          "text": "都说旁观者清，目睹了这一切之后，我意识到一个残酷的道理。那就是所有让人怅惋的事情，其实从一开始就注定会发生——"
        },
        {
          "role": "羽生田千鹤",
          "text": "我们与人类寿命不同、天性不同，却生活在同一片土地，相互接触、相互吸引，最终匆匆离别。"
        },
        {
          "role": "羽生田千鹤",
          "text": "梦醒时分，只留下永久的思念，和无法排解的痛苦…"
        },
        {
          "role": "羽生田千鹤",
          "text": "心智成熟的大妖怪尚且如此，那些单纯善良的小妖怪，在离别时又该有多么难过啊。"
        },
        {
          "role": "鹿野院平藏",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "所以，你是想…"
        },
        {
          "role": "羽生田千鹤",
          "text": "我本藏身在这片海滩上，等待大限之日到来。"
        },
        {
          "role": "羽生田千鹤",
          "text": "它们却碰巧将秋津游艺修建在这里，将我从沉睡中唤醒。"
        },
        {
          "role": "羽生田千鹤",
          "text": "我不希望它们，因为听了镰井先生与人类武士的传说，而带着无限的期待和热情与人类接触。那样只会重蹈覆辙…"
        },
        {
          "role": "派蒙",
          "text": "所以你才装神弄鬼，想要吓跑来这里的人？"
        },
        {
          "role": "派蒙",
          "text": "之前有人被困在沙滩上，也是你干的吧？为什么只对他下那么重的手呢？"
        },
        {
          "role": "羽生田千鹤",
          "text": "我的力量已经十分微弱，大部分时候都在用积攒的道具吓人，人多时不便露面。"
        },
        {
          "role": "羽生田千鹤",
          "text": "但那个混蛋贪婪无度，想要偷窃秋津游艺上摆放的装饰，回去高价售卖。"
        },
        {
          "role": "羽生田千鹤",
          "text": "所以我才动用妖力施加惩戒，给他一个教训。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样。没想到你这家伙，还挺有正义感的嘛。"
        },
        {
          "role": "派蒙",
          "text": "对了，那位镰井与武士的故事，你是怎么知道后半段的？"
        },
        {
          "role": "羽生田千鹤",
          "text": "……"
        },
        {
          "role": "鹿野院平藏",
          "text": "不必回答也没关系，我已经明白了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "你的真身，其实就是这对羽子板…对吧？"
        },
        {
          "role": "派蒙",
          "text": "羽子板？啊！难道是——"
        },
        {
          "role": "鹿野院平藏",
          "text": "数百年前，妖怪镰井与人类武士在秋津羽戏上使用的羽子板。"
        },
        {
          "role": "鹿野院平藏",
          "text": "受强大的妖力影响，逐渐产生了心智。他们的故事，你是距离最近的见证者。"
        },
        {
          "role": "鹿野院平藏",
          "text": "数百年的时间过去，就算有妖力护持，羽子板本身也几乎朽烂。你连自身存在都快要维持不住，自然也只能靠小道具吓人。"
        },
        {
          "role": "鹿野院平藏",
          "text": "同时，如果我没猜错的话，这对羽子板也是第三轮试胆大会的目标物…"
        },
        {
          "role": "八重神子",
          "text": "完全正确，真是有趣的推理。"
        },
        {
          "role": "八重神子",
          "text": "恭喜你们通过了第三轮试胆大会，小家伙们。"
        },
        {
          "role": "派蒙",
          "text": "神子！还有…巫女姐姐也在？你不是失踪了吗？"
        },
        {
          "role": "巫女",
          "text": "抱歉。其实这也是八重大人的安排…"
        },
        {
          "role": "八重神子",
          "text": "呵呵，怎么样，是不是吓了你们一跳？"
        },
        {
          "role": "八重神子",
          "text": "既然恐惧来源于未知，局面当然是越乱越好。最好是连工作人员也神秘消失，这样才能称为「试胆大会」嘛。"
        },
        {
          "role": "派蒙",
          "text": "你果然是在故意吓我们！"
        },
        {
          "role": "八重神子",
          "text": "仁美，你先回去通知其他人，试胆大会已经结束了。优胜者嘛，也已经产生了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "既然查明了真相，我也回去见委托人一面。「意图盗窃」…这个罪名不重，但也不能没有惩罚。"
        },
        {
          "role": "鹿野院平藏",
          "text": "回见了，旅行者、派蒙。"
        },
        {
          "role": "派蒙",
          "text": "说起来神子，你选羽子板作为第三轮试胆大会的目标物，是早就知道千鹤的事吗？"
        },
        {
          "role": "羽生田千鹤",
          "text": "「神子」…「八重大人」…你是…"
        },
        {
          "role": "八重神子",
          "text": "有一年三川花祭，我跟在狐斋宫的身旁，看着她玩过秋津羽戏。"
        },
        {
          "role": "八重神子",
          "text": "那时候我曾见过你，当时的你应该没有人形，只是初具神智。"
        },
        {
          "role": "羽生田千鹤",
          "text": "我想起来了，你是狐斋宫大人肩膀上的那位…"
        },
        {
          "role": "八重神子",
          "text": "前段时间我到海滩散步，察觉到这附近有熟悉的妖力。"
        },
        {
          "role": "八重神子",
          "text": "虽然那妖力很微弱，但我还是找到了你。你坐在树上，眺望着远处的旅人。"
        },
        {
          "role": "八重神子",
          "text": "我听见你小声告诫自己必须要忍耐，不能和人类接触。"
        },
        {
          "role": "羽生田千鹤",
          "text": "什么时候？我完全没有发现您。"
        },
        {
          "role": "八重神子",
          "text": "你的力量如此微弱，发现不了才是正常的。"
        },
        {
          "role": "八重神子",
          "text": "其实你一直在自责吧？在你心里，镰井与武士因秋津羽戏结识，与你有脱不开的关系。"
        },
        {
          "role": "羽生田千鹤",
          "text": "那时候我还不能像这样幻化成人形，只有一个模糊的意识。"
        },
        {
          "role": "羽生田千鹤",
          "text": "他们在三川花祭相遇时，我感到很骄傲，因为我也在他们的故事中留下了影子。"
        },
        {
          "role": "羽生田千鹤",
          "text": "他们分别后，我时常听到镰井先生叹息，心中也跟着自责，忍不住躲了起来。再次醒来时，世界已经不一样了。"
        },
        {
          "role": "羽生田千鹤",
          "text": "八重大人，您是有名的大妖怪，肯定知道许多我不知道的事。我想请问您…"
        },
        {
          "role": "羽生田千鹤",
          "text": "一次又一次地相遇，一次又一次地分别。短暂的时光匆匆而过，留下的只有怅然与难过。"
        },
        {
          "role": "羽生田千鹤",
          "text": "我们与人类的相遇，真的有意义吗？"
        },
        {
          "role": "八重神子",
          "text": "为什么没有呢？你和旅行者一起玩过秋津游艺，感觉如何？"
        },
        {
          "role": "羽生田千鹤",
          "text": "很开心。但是…"
        },
        {
          "role": "八重神子",
          "text": "但是「理性」告诉你这是错误的，是吗？"
        },
        {
          "role": "八重神子",
          "text": "其实啊，你所讲的镰井与武士的故事，依旧少了一段。"
        },
        {
          "role": "羽生田千鹤",
          "text": "怎么会？镰井先生与人类武士，应该再也没有见过面才对。"
        },
        {
          "role": "八重神子",
          "text": "但故事却并没有结束。那位武士名叫柳桥卓人，他还有另一个身份，是「苍岚一心流」的创始人。"
        },
        {
          "role": "八重神子",
          "text": "这门剑道，据说是柳桥在与镰井的切磋中悟到的，其第三代宗家富永正也同样与镰井交好。"
        },
        {
          "role": "八重神子",
          "text": "五百年前，镰井与富永并肩作战到最后一刻，富永使用的刀正是柳桥传下来的。对镰井来说，曾经的遗憾到这时反而消解了。"
        },
        {
          "role": "羽生田千鹤",
          "text": "这样…吗…"
        },
        {
          "role": "八重神子",
          "text": "我等妖怪的确与人类不同。对我们来说，人类的寿命太短，终有一日会成为过客。"
        },
        {
          "role": "八重神子",
          "text": "但是因相遇产生的「缘分」并不会就此断绝，而是会以新的方式传承下去。"
        },
        {
          "role": "八重神子",
          "text": "不必为此感到困扰。韶光易过，浮生如露，所以才要及时行乐。现在的你，应该明白我说的意思才对。"
        },
        {
          "role": "荒泷一斗",
          "text": "喂——挚友——！！"
        },
        {
          "role": "派蒙",
          "text": "一斗！你怎么找到这里来啦？"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈，本大爷已经从仁美那里听说了事情的原委，还知道你已经赢下了最后一轮试胆大会！"
        },
        {
          "role": "荒泷一斗",
          "text": "就连这位的身份，我们也已经知道了！于是本大爷和其他人商量了一下…"
        },
        {
          "role": "荒泷一斗",
          "text": "嗯？你是之前那个狐狸女人？你怎么也在这里？"
        },
        {
          "role": "八重神子",
          "text": "呵呵，不用在意我。你们商量了什么？"
        },
        {
          "role": "荒泷一斗",
          "text": "咳咳，听好了——为了庆祝试胆大会结束，我们打算一起搞一场「三川花祭」。"
        },
        {
          "role": "荒泷一斗",
          "text": "我想清楚了，只靠小妖怪的妖力或许做不到，但是有我出手肯定就没问题了！"
        },
        {
          "role": "荒泷一斗",
          "text": "由本大爷——荒泷天下百鬼之王一斗，带领大家搞一场最棒的三川花祭！"
        },
        {
          "role": "狐妖&河童&独眼小僧",
          "text": "不愧是荒泷大人！"
        },
        {
          "role": "八重神子",
          "text": "哦——"
        },
        {
          "role": "派蒙",
          "text": "真的没问题吗…"
        },
        {
          "role": "荒泷一斗",
          "text": "这是什么话。这次可不光有本大爷出手，其他人也一起来帮忙了。就连绫人兄也来了！"
        },
        {
          "role": "荒泷一斗",
          "text": "大家正在收集材料，估计用不了多久，庆典就搭好了。你们就等着来玩吧！哈哈哈哈哈！"
        },
        {
          "role": "狐妖&河童&独眼小僧",
          "text": "荒泷大人英明！"
        },
        {
          "type": "subtitle",
          "text": "一斗等人与小妖怪们一起搭建了庆典场地…",
          "narration": true
        },
        {
          "role": "八重神子",
          "text": "庆典怎么能少了我呢？我也过去看看。"
        },
        {
          "role": "八重神子",
          "text": "啊，好久没逛庆典了。幸好这次出来带了酒——"
        },
        {
          "role": "派蒙",
          "text": "一斗那家伙，有时候也蛮靠谱的嘛！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，庆典，好吃的…我来啦！"
        },
        {
          "role": "旅行者",
          "text": "要一起去吗？"
        },
        {
          "role": "羽生田千鹤",
          "text": "……"
        },
        {
          "role": "羽生田千鹤",
          "text": "好啊。如果你们…不介意的话。"
        },
        {
          "type": "subtitle",
          "text": "游玩三川花祭"
        },
        {
          "role": "派蒙",
          "text": "一斗！五郎也在！你们在聊什么？"
        },
        {
          "role": "荒泷一斗",
          "text": "哦，我刚刚在说，要不是时间有限，一定要在这里做一个超级大钓场！"
        },
        {
          "role": "五郎",
          "text": "钓鱼啊…以前在海祇岛的时候，我一般会直接下水抓鱼。"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈！抓鱼哪有钓鱼有意思！本大爷可是钓鱼的高手！"
        },
        {
          "role": "荒泷一斗",
          "text": "前段时间，本大爷钓上来一条超级大的鱼，大到我都苦恼怎么处理，还专门给八重堂写过信呢。"
        },
        {
          "role": "羽生田千鹤",
          "text": "居然会有这种烦恼…"
        },
        {
          "role": "派蒙",
          "text": "那么大！居然不告诉我，我帮你吃掉不就好啦！"
        },
        {
          "role": "五郎",
          "text": "嗯？给八重堂写信？"
        },
        {
          "role": "荒泷一斗",
          "text": "没错！我特地给《闲事月刊》投了稿，让希娜小姐帮忙看看。希娜小姐真是个温柔的人啊，很快就寄来了回信。"
        },
        {
          "role": "五郎",
          "text": "真巧，我平时也在那边兼职，前段时间也碰巧收到了相似的苦恼。"
        },
        {
          "role": "荒泷一斗",
          "text": "也是苦恼自己钓到了超级大的鱼？难道说…"
        },
        {
          "role": "荒泷一斗",
          "text": "难道说这世上竟有人能在钓鱼领域与本大爷一战？不行不行，你们先逛祭典，我今天一定要钓一条更大的上来。"
        },
        {
          "role": "荒泷一斗",
          "text": "到时候请你们吃全鱼宴！哈哈哈哈！"
        },
        {
          "role": "独眼小僧",
          "text": "就差一点——啊！！绳子断了。"
        },
        {
          "role": "独眼小僧",
          "text": "好难啊，宵宫姐姐。真的有办法能钓到水球吗？"
        },
        {
          "role": "宵宫",
          "text": "不用担心。让宵宫姐姐告诉你诀窍——其实只有「眼明手快」四个字！"
        },
        {
          "role": "派蒙",
          "text": "钓水球！我在轻小说里看到过！"
        },
        {
          "role": "宵宫",
          "text": "要不要来试试？闭上一只眼睛，好好瞄准，然后用巧劲迅速钓起来！"
        },
        {
          "role": "派蒙",
          "text": "看着就很难。还是让旅行者来试试，我们三个人的话，至少要钓三个哦。"
        },
        {
          "role": "独眼小僧",
          "text": "可宵宫姐姐，我闭上一只眼，就，什么也看不到了——！！"
        },
        {
          "role": "早柚",
          "text": "拉面，真好吃…"
        },
        {
          "role": "神里绫华",
          "text": "是呀，感觉好久没吃了。"
        },
        {
          "role": "派蒙",
          "text": "嗯？绫华平时很少吃拉面吗？明明那么好吃！"
        },
        {
          "role": "神里绫华",
          "text": "啊，是你们。麻烦加两碗拉面。"
        },
        {
          "role": "神里绫华",
          "text": "因为重油重盐，所以会被身边的人限制吃的次数…不管是拉面还是火锅，平时都吃不到的。"
        },
        {
          "role": "羽生田千鹤",
          "text": "真辛苦。"
        },
        {
          "role": "派蒙",
          "text": "是呀是呀。难怪绫华会把蛋糕放到火锅里。"
        },
        {
          "role": "羽生田千鹤",
          "text": "欸？"
        },
        {
          "role": "神里绫华",
          "text": "那个…还请忘记…"
        },
        {
          "role": "早柚",
          "text": "呼…吃饱了，有点困。让我睡一会儿…"
        },
        {
          "role": "神里绫华",
          "text": "说起来，以前妖怪们的庆典，会有什么特别的摊位吗？"
        },
        {
          "role": "羽生田千鹤",
          "text": "这个就说来话长了…"
        },
        {
          "role": "派蒙",
          "text": "居然一个水球都没有钓到。旅行者的技术退步了呢！"
        },
        {
          "role": "派蒙",
          "text": "最后还是千鹤钓到了一个，虽然送给了独眼小僧…"
        },
        {
          "role": "羽生田千鹤",
          "text": "我看他似乎很想要。"
        },
        {
          "role": "派蒙",
          "text": "派蒙也很想要哦！"
        },
        {
          "role": "羽生田千鹤",
          "text": "那下次我再钓一个给你。"
        },
        {
          "role": "派蒙",
          "text": "好耶！"
        },
        {
          "role": "托马",
          "text": "我说老板，这比平时贵太多了吧？虽然是庆典，但溢价也不该太高才对。"
        },
        {
          "role": "友浩",
          "text": "出摊也是有成本的，肯定要卖的贵些才能回本。"
        },
        {
          "role": "托马",
          "text": "这样吧，我要五个面具，打包价七折怎么样？不行就算了。"
        },
        {
          "role": "友浩",
          "text": "好吧好吧…"
        },
        {
          "role": "河童",
          "text": "好热，感觉要被烤干了！"
        },
        {
          "role": "枫原万叶",
          "text": "不要靠那么近，往后一点比较好。"
        },
        {
          "role": "河童",
          "text": "我知道…但平时根本看不到这么美丽的篝火，我想到最近的地方好好看看。"
        },
        {
          "role": "枫原万叶",
          "text": "世间美景有许多，不必急于一时。庆典还很长…"
        },
        {
          "role": "八重神子",
          "text": "没想到你连妹妹都没有告诉，看她的样子，似乎也被吓到了。"
        },
        {
          "role": "神里绫人",
          "text": "如果提前告诉她这里会发生什么，也就变得无趣了。"
        },
        {
          "role": "神里绫人",
          "text": "有朋友在身旁，她也不至于过于害怕。些许惊吓，正好能缓解她平时积累的紧张情绪。"
        },
        {
          "role": "八重神子",
          "text": "呵呵…这次的计划确实很顺利，看到不明就里的人们惊慌失措，真让人愉快。"
        },
        {
          "role": "神里绫人",
          "text": "呵呵…我也有同感。"
        },
        {
          "role": "派蒙",
          "text": "神子、绫人，你们笑得好可怕！"
        },
        {
          "role": "八重神子",
          "text": "嗯？你们逛完庆典了吗？"
        },
        {
          "role": "旅行者",
          "text": "差不多逛了一遍。"
        },
        {
          "role": "八重神子",
          "text": "那，开心吗？"
        },
        {
          "role": "派蒙",
          "text": "超级开心！"
        },
        {
          "role": "八重神子",
          "text": "真正的三川花祭，比现在还要热闹百倍。不过你们去了，倒是未必有现在开心。"
        },
        {
          "role": "八重神子",
          "text": "因为和朋友一起逛庆典比较开心，对吧？"
        },
        {
          "role": "羽生田千鹤",
          "text": "…嗯。谢谢。"
        },
        {
          "role": "八重神子",
          "text": "好啦，你应该有什么话想单独对旅行者说吧？我们就不打扰了。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？要说什么呀？"
        },
        {
          "role": "羽生田千鹤",
          "text": "又被您看出来了啊…总觉得您似乎什么都明白。"
        },
        {
          "role": "八重神子",
          "text": "并非「什么都明白」，只是我也经历过而已。"
        },
        {
          "role": "羽生田千鹤",
          "text": "……"
        },
        {
          "role": "羽生田千鹤",
          "text": "旅行者，你现在有空吗？我想…和你单独到海滩上聊聊。"
        },
        {
          "type": "subtitle",
          "text": "[与八重神子、神里绫人对话]",
          "narration": true
        },
        {
          "role": "神里绫人",
          "text": "离别也是庆典的一部分啊。"
        },
        {
          "role": "八重神子",
          "text": "…没有不散的宴席嘛。"
        },
        {
          "type": "subtitle",
          "text": "[与狐妖对话]",
          "narration": true
        },
        {
          "role": "狐妖",
          "text": "我想成为像有乐斋大人一样的大妖怪…"
        },
        {
          "role": "狐妖",
          "text": "这样，我就能做出真正的三川花祭了。"
        },
        {
          "type": "subtitle",
          "text": "[与河童对话]",
          "narration": true
        },
        {
          "role": "河童",
          "text": "让我先休息一会儿…"
        },
        {
          "type": "subtitle",
          "text": "[与枫原万叶对话]",
          "narration": true
        },
        {
          "role": "枫原万叶",
          "text": "玩得开心吗？要不要一起去吃点什么？"
        },
        {
          "type": "subtitle",
          "text": "[与宵宫、独眼小僧对话]",
          "narration": true
        },
        {
          "role": "独眼小僧",
          "text": "唔…只差一点点了！"
        },
        {
          "role": "宵宫",
          "text": "逐渐掌握技巧了？再加把劲！"
        },
        {
          "type": "subtitle",
          "text": "[与托马对话]",
          "narration": true
        },
        {
          "role": "托马",
          "text": "买了好多东西…回去要好好整理一下。"
        },
        {
          "type": "subtitle",
          "text": "[与荒泷一斗、五郎对话]",
          "narration": true
        },
        {
          "role": "荒泷一斗",
          "text": "奇怪，鱼都哪去了？"
        },
        {
          "role": "五郎",
          "text": "别紧张，我们换个地方试试看。"
        },
        {
          "type": "subtitle",
          "text": "[与神里绫华、早柚对话]",
          "narration": true
        },
        {
          "role": "早柚",
          "text": "呼…呼噜…"
        },
        {
          "role": "神里绫华",
          "text": "只是吃了一碗拉面…体重应该不会有什么变化吧…"
        },
        {
          "type": "subtitle",
          "text": "到海边见羽生田千鹤"
        },
        {
          "role": "羽生田千鹤",
          "text": "呼…就在这里吧，谢谢你愿意陪我过来。"
        },
        {
          "role": "旅行者",
          "text": "没事没事。"
        },
        {
          "role": "羽生田千鹤",
          "text": "其实，我第一次发现自己能变成人形时，是很开心的。"
        },
        {
          "role": "羽生田千鹤",
          "text": "我是羽子板化成的妖怪，是诞生在庆典中的妖怪，生来就喜欢热闹。"
        },
        {
          "role": "羽生田千鹤",
          "text": "我想参加庆典，想和人类做朋友，想和别人一起玩秋津游艺。"
        },
        {
          "role": "羽生田千鹤",
          "text": "但是啊，每当夜深人静的时候，我就会想起年迈的武士先生放下羽子板时露出的苦笑，想起孤独的镰井先生边饮酒边叹气的样子。"
        },
        {
          "role": "羽生田千鹤",
          "text": "然后我就会想，如果我和人类做朋友的话，将来那个人会不会也露出同样难过的表情呢？"
        },
        {
          "role": "羽生田千鹤",
          "text": "所以，我觉得自己不能这么做。我告诫自己，绝对不能这么做，不能再重复相同的悲剧。"
        },
        {
          "role": "旅行者",
          "text": "我明白。"
        },
        {
          "role": "羽生田千鹤",
          "text": "抱歉，第一次见面的时候，我一直在讲些听不懂的话，吓了你一跳吧？"
        },
        {
          "role": "羽生田千鹤",
          "text": "本来以为你会被吓跑，没想到第二次见面的时候，你却像没事人一样。"
        },
        {
          "role": "羽生田千鹤",
          "text": "我知道你把我当成了小妖怪们的同伴，但我没有点破，而是和你一起玩了秋津游艺——"
        },
        {
          "role": "旅行者",
          "text": "为什么？"
        },
        {
          "role": "羽生田千鹤",
          "text": "嗯…我自己也不太清楚。"
        },
        {
          "role": "羽生田千鹤",
          "text": "也许是我一直都想像镰井先生那样，与人类玩一场秋津游艺。"
        },
        {
          "role": "羽生田千鹤",
          "text": "也许是我知道自己剩下的时间不多了，不想就这么孤独地离开…"
        },
        {
          "role": "羽生田千鹤",
          "text": "总之，谢谢你愿意陪我玩。"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "羽生田千鹤",
          "text": "之前秋津游艺，小派蒙说赢的人可以让输的人实现自己一个愿望。"
        },
        {
          "role": "羽生田千鹤",
          "text": "当时我说，我的愿望就是希望你们不要出现在我的面前。"
        },
        {
          "role": "羽生田千鹤",
          "text": "可结果你们还是找了过来，愿望也没有达成。所以…我可以提一个新的愿望吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当然可以。",
              "dialogues": [
                {
                  "role": "羽生田千鹤",
                  "text": "让我想想。「希望你能记得我」…算了，只能许一个愿望的话，还是不要这个了。"
                }
              ]
            },
            {
              "text": "只要我做得到。",
              "dialogues": [
                {
                  "role": "羽生田千鹤",
                  "text": "让我想想。「希望你能记得我」…算了，只能许一个愿望的话，还是不要这个了。"
                }
              ]
            }
          ]
        },
        {
          "role": "羽生田千鹤",
          "text": "咳，听好了。我的愿望是——"
        },
        {
          "role": "羽生田千鹤",
          "text": "「希望你今后的旅程，每天都像庆典一样开心。」"
        },
        {
          "type": "subtitle",
          "text": "[与在场的NPC对话]",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "[与早柚对话]",
          "narration": true
        },
        {
          "role": "早柚",
          "text": "呼噜…真的长高了…嘿嘿…"
        },
        {
          "role": "早柚",
          "text": "好高…大家都变得好小…呼噜…"
        },
        {
          "type": "subtitle",
          "text": "[与宵宫对话]",
          "narration": true
        },
        {
          "role": "宵宫",
          "text": "每年烟花升空的时候，我都会想，「不知不觉又过去了一年」。"
        },
        {
          "role": "宵宫",
          "text": "人的生命，也在一年又一年中，不知不觉地走向尽头。"
        },
        {
          "role": "宵宫",
          "text": "不过，我并不觉得这是一件让人难过的事情，烟花易逝，人情长存嘛。"
        },
        {
          "type": "subtitle",
          "text": "[与八重神子对话]",
          "narration": true
        },
        {
          "role": "八重神子",
          "text": "绫人找我商议开办「试胆大会」的时候，我突然想到这是解开千鹤心结的好办法。"
        },
        {
          "role": "八重神子",
          "text": "她还没有人形，只微微诞生出一点意识的时候，所经历的第一件事就是镰鼬与武士的离别。"
        },
        {
          "role": "八重神子",
          "text": "这对她来说是非常沉重的心理阴影，只靠讲述道理不可能让她释然。"
        },
        {
          "role": "八重神子",
          "text": "最好的办法，就是让她试着和人类接触。不必难过啦，我觉得她离开的时候是很开心的。"
        },
        {
          "type": "subtitle",
          "text": "[与神里绫人对话]",
          "narration": true
        },
        {
          "role": "神里绫人",
          "text": "这次试胆大会，玩得开心吗？"
        },
        {
          "role": "神里绫人",
          "text": "察觉到小妖怪的心意后，我原本想直接将他们的事情公之于众，这样自然会有许多人慕名而来。"
        },
        {
          "role": "神里绫人",
          "text": "仔细想想，又未免有些拔苗助长。若是一开始就打出三川花祭的名头，人们的期望会上升到一个它们无法满足的高度。"
        },
        {
          "role": "神里绫人",
          "text": "倒不如借试胆大会之名带来一些游客，剩下的看它们自己发挥。"
        },
        {
          "role": "神里绫人",
          "text": "而它们的存在，也为试胆大会增添了新的乐趣，呵呵…"
        },
        {
          "type": "subtitle",
          "text": "[与枫原万叶、鹿野院平藏对话]",
          "narration": true
        },
        {
          "role": "鹿野院平藏",
          "text": "万叶，最近有空吗？"
        },
        {
          "role": "鹿野院平藏",
          "text": "有个案子，我想邀请你和我一起去调查。"
        },
        {
          "role": "枫原万叶",
          "text": "遇到什么麻烦了吗？"
        },
        {
          "role": "鹿野院平藏",
          "text": "倒也不算什么麻烦，只是一起陈年旧案，线索已经泯灭得差不多了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "不过倚靠你对自然的感知能力，我想说不定会有新的发现。"
        },
        {
          "role": "枫原万叶",
          "text": "可以，庆典结束后我会留下来一段时间，到时候一起去看看。"
        },
        {
          "role": "鹿野院平藏",
          "text": "好呀，多谢了。"
        },
        {
          "role": "枫原万叶",
          "text": "客气，举手之劳而已。"
        },
        {
          "type": "subtitle",
          "text": "[与狐妖对话]",
          "narration": true
        },
        {
          "role": "狐妖",
          "text": "下次我们举办三川花祭的时候，你会来吗？"
        },
        {
          "type": "subtitle",
          "text": "[与神里绫华对话]",
          "narration": true
        },
        {
          "role": "神里绫华",
          "text": "啊…刚刚听千鹤小姐讲从前三川花祭的事情，我还想着下次一定要再找时间好好聊聊。"
        },
        {
          "role": "神里绫华",
          "text": "没想到…这么快就会分别…"
        },
        {
          "type": "subtitle",
          "text": "[与义治对话]",
          "narration": true
        },
        {
          "role": "义治",
          "text": "要是能每天都参加庆典就好了！"
        },
        {
          "type": "subtitle",
          "text": "[与仁美对话]",
          "narration": true
        },
        {
          "role": "仁美（巫女）",
          "text": "为了能够吓到人，我特地练习了很长时间。总算可以放松一下了…"
        },
        {
          "type": "subtitle",
          "text": "[与独眼小僧对话]",
          "narration": true
        },
        {
          "role": "独眼小僧",
          "text": "我会一直珍惜这个水球…"
        },
        {
          "type": "subtitle",
          "text": "[与托马对话]",
          "narration": true
        },
        {
          "role": "托马",
          "text": "虽然知道家主大人多半在试胆大会前就安排好了，但这次还是被吓了一跳啊。"
        },
        {
          "role": "托马",
          "text": "不过事后想起来，倒是确实很有趣。"
        },
        {
          "type": "subtitle",
          "text": "[与友浩对话]",
          "narration": true
        },
        {
          "role": "友浩",
          "text": "今天的销售额暴涨，都快卖断货了。哈哈哈哈哈！"
        },
        {
          "type": "subtitle",
          "text": "[与河童对话]",
          "narration": true
        },
        {
          "role": "河童",
          "text": "和人类一起玩，真开心啊…"
        },
        {
          "type": "subtitle",
          "text": "[与荒泷一斗对话]",
          "narration": true
        },
        {
          "role": "荒泷一斗",
          "text": "寿命啊、离别啊，本大爷虽然听说了，但其实也不怎么懂。"
        },
        {
          "role": "荒泷一斗",
          "text": "不过本大爷从来没有后悔遇到过你们！哈哈哈哈哈！"
        },
        {
          "type": "subtitle",
          "text": "[与五郎对话]",
          "narration": true
        },
        {
          "role": "五郎",
          "text": "我听说了千鹤小姐的事情，真是让人难过。"
        },
        {
          "role": "五郎",
          "text": "战场上其实也是一样。不知何时就会和朋友彻底分别，所以要珍惜现在的时光。"
        }
      ],
      "collapse_ranges": [
        [
          49,
