{
  "quest_id": 10234,
  "chapter_num": "和旋舞剧·第三幕",
  "chapter_title": "一切代价的回旋",
  "type": "eq",
  "route": "The Price of Every Price",
  "stories": [
    {
      "story_id": 40196,
      "title": "一切代价的回旋",
      "description": "沫芒宫传来消息，看来是时候做出行动了。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后的上午（8点-10点）"
        },
        {
          "role": "派蒙",
          "text": "旅行者，那维莱特一早派人来联系我们了呢！"
        },
        {
          "role": "派蒙",
          "text": "一定是事情有了进展，事不宜迟，我们出发吧！"
        },
        {
          "type": "subtitle",
          "text": "前往沫芒宫附近"
        },
        {
          "role": "派蒙",
          "text": "几位好！我们没来晚吧？"
        },
        {
          "role": "那维莱特",
          "text": "不，刚刚好。休息得如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "忙碌使人精神焕发。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基尼奇",
          "text": "的确是保持活力的好方法。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "各位已经在着手准备了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱欧斯利",
          "text": "昨天从阿让托先生处得到消息，确定了交易的时间与地点。"
        },
        {
          "role": "莱欧斯利",
          "text": "说起来，是大家都知道的地方呢。「今日下午，映影欢乐城餐厅见。」"
        },
        {
          "role": "派蒙",
          "text": "欸？他还真是对那个地方情有独钟呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基尼奇",
          "text": "看来旅行者和我们产生了同样的担忧。"
        },
        {
          "role": "那维莱特",
          "text": "是的，比起空旷的地段，人流量高的活动场地会给抓捕行动造成额外的困难。"
        },
        {
          "role": "那维莱特",
          "text": "犯人可能会混入人群，甚至利用人质逃脱。"
        },
        {
          "role": "那维莱特",
          "text": "为此我们需要做更多的提前准备，所以从昨天接到消息起，这边就已经开始安排逐影庭与特巡队的工作了。"
        },
        {
          "role": "莱欧斯利",
          "text": "嗯，现场会安插很多便衣人员。如果事情进展不顺，我们会优先保障市民的人身安全。"
        },
        {
          "role": "莱欧斯利",
          "text": "当然，还是祝我们一切顺利比较好。"
        },
        {
          "role": "基尼奇",
          "text": "参与人员中有不少我在上起案件中见过的熟悉面孔，比如特巡队队长夏沃蕾小姐。所以，我持乐观态度哦。"
        },
        {
          "role": "莱欧斯利",
          "text": "那就借纳塔的大英雄吉言了。"
        },
        {
          "role": "莱欧斯利",
          "text": "哦，乐平波琳小姐和娜维娅小姐那边，我们也都进行了沟通与安排。"
        },
        {
          "role": "那维莱特",
          "text": "刺玫会会在可控范围内进行支援，不必担心。"
        },
        {
          "role": "莱欧斯利",
          "text": "唯一的问题…可能就是爱可菲小姐那边吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她不想接待犯过罪的顾客吗？",
              "dialogues": [
                {
                  "role": "莱欧斯利",
                  "text": "哈哈，要是这样反而简单了。"
                }
              ]
            },
            {
              "text": "她想给犯罪分子喂叉子吗？",
              "dialogues": [
                {
                  "role": "莱欧斯利",
                  "text": "哦，你别说，是个不错的思路…"
                }
              ]
            }
          ]
        },
        {
          "role": "那维莱特",
          "text": "咳…"
        },
        {
          "role": "莱欧斯利",
          "text": "不开玩笑了。爱可菲小姐提出，希望自己的餐厅不要因为本次行动蒙受任何损失。"
        },
        {
          "role": "莱欧斯利",
          "text": "哈哈…我有种预感，肯定不会如愿的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "需要我做些什么吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱欧斯利",
          "text": "说实话，这件事本就与你无关，发展到这一步已经给你添了很多麻烦。剩下的应该全权交由枫丹官方处理即可。"
        },
        {
          "role": "莱欧斯利",
          "text": "不过我猜，你应该也想知道事件的结局吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请务必。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱欧斯利",
          "text": "嗯，那就请你在现场见机行事吧。不一定需要你出手，只是以防万一。"
        },
        {
          "role": "基尼奇",
          "text": "我会尽量不让事情发展到那一步的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "基尼奇也要加入？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基尼奇",
          "text": "当然。"
        },
        {
          "role": "基尼奇",
          "text": "虽然我心中还有很多疑问，但从已有信息来看，犯人来自纳塔。"
        },
        {
          "role": "基尼奇",
          "text": "再说，我也算是证人之一，不能放任不管。"
        },
        {
          "role": "派蒙",
          "text": "很有基尼奇的风范呢！"
        },
        {
          "type": "subtitle",
          "text": "众人又就行动细节和注意事项进行了一些讨论。\n对话难得进行得非常高效…可能是因为阿乔和咔库库都没有出现。\n转念一想，如果阿乔突然现身对那维莱特口出狂言，场面一定会很尴尬吧…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "莱欧斯利",
          "text": "那么，闲话就说到这里吧。"
        },
        {
          "role": "莱欧斯利",
          "text": "行动时间选在下午。只要动作够快，出发前还能喝几杯茶。"
        },
        {
          "role": "派蒙",
          "text": "对哦，旅行者，我们也去吃点东西吧？吃饱肚子才有力气干活嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙就只是看着吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "陪伴也很重要哦！"
        },
        {
          "role": "基尼奇",
          "text": "那我就先一步去会场了。"
        },
        {
          "role": "基尼奇",
          "text": "那么一会儿见。"
        },
        {
          "role": "那维莱特",
          "text": "嗯，等各位的好消息。"
        },
        {
          "type": "subtitle",
          "text": "前往行动地点"
        },
        {
          "role": "派蒙",
          "text": "几天过去，这片沙滩好像变热闹了呢！"
        },
        {
          "role": "旅行者",
          "text": "（嗯，也可能是因为其中有不少便衣警卫吧。）"
        },
        {
          "role": "派蒙",
          "text": "旅行者，那个…"
        },
        {
          "role": "派蒙",
          "text": "咳咳！派蒙有些饿了，我们去餐厅看看菜单吧！"
        },
        {
          "role": "旅行者",
          "text": "（拿着这个箱子的人，应该就是前来交易的家伙了吧。）"
        },
        {
          "role": "旅行者",
          "text": "（那么，接下来就是正题了。）"
        },
        {
          "type": "subtitle",
          "text": "[https://www.bilibili.com/video/BV1zkEFzbEPg 过场动画「旋舞谢幕礼」]"
        },
        {
          "type": "subtitle",
          "text": "安格尔望来到交易地点准备偷偷地拿起手提箱时，莱欧斯利拉开他面前的椅子坐了下来…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "莱欧斯利",
          "text": "你朋友给你点的"
        },
        {
          "role": "莱欧斯利",
          "text": "不喝就走了？"
        },
        {
          "type": "subtitle",
          "text": "周围的便衣警卫纷纷将注意力锁定在安格尔望上…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "安格尔望",
          "text": "哈哈，在外面还是少喝敞口的饮料吧"
        },
        {
          "role": "特巡队员",
          "text": "你已经被包围了，放弃抵抗，跟我们…"
        },
        {
          "type": "subtitle",
          "text": "安格尔望将箱子向着特巡队员扔出去开始逃跑，爱可菲捂住芙宁娜的耳朵朝着安格尔望大喊…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "爱可菲",
          "text": "混账东西！"
        },
        {
          "role": "特巡队员",
          "text": "不许动！"
        },
        {
          "role": "维莱妲",
          "text": "快看，是彩蛋表演！"
        },
        {
          "role": "布蕾莘",
          "text": "真幸运，竟然被我们遇到了！"
        },
        {
          "type": "subtitle",
          "text": "围观的群众都在鼓掌欢呼…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "安格尔望逃到了港口准备登船，但娜维娅已经在船上等候…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "娜维娅",
          "text": "抱歉啦抱歉，非法停靠的无证船只暂不接待乘客哦~"
        },
        {
          "type": "subtitle",
          "text": "身后特巡队员已经追来，安格尔望将娜维娅拽下船，击倒了特巡队员…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "安格尔望将钩索钩到大桥上飞了上去…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "娜维娅",
          "text": "快，别让他跑了！"
        },
        {
          "type": "subtitle",
          "text": "夏沃蕾举起枪瞄准安格尔望时，阿乔切断了钩索，安格尔望掉了下来…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "阿乔",
          "text": "哈哈哈，无理小虫，胆敢比伟大圣龙飞得还高！"
        },
        {
          "type": "subtitle",
          "text": "咔库库把得意的阿乔一下撞飞了出去…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "阿乔",
          "text": "谁在抢功…啊"
        },
        {
          "role": "阿乔",
          "text": "怎么又是你！气死我了！"
        },
        {
          "role": "咔库库",
          "text": "哦天哪，哥们！"
        },
        {
          "type": "subtitle",
          "text": "基尼奇用钩索把即将落入水中的安格尔望钓上了岸…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "特巡队员",
          "text": "好，收工！"
        },
        {
          "role": "安格尔望",
          "text": "可恶，就这么把人拖过来…这是轻视生命的举动！我要去审判庭告你！"
        },
        {
          "role": "基尼奇",
          "text": "是吗。"
        },
        {
          "role": "基尼奇",
          "text": "我倒是觉得，我好心将你从「观众」面前带走，是在维护你的面子。"
        },
        {
          "role": "基尼奇",
          "text": "至于你在途中是头朝上还是头朝下，不是你自己的选择吗？"
        },
        {
          "role": "安格尔望",
          "text": "你…！"
        },
        {
          "role": "安格尔望",
          "text": "……"
        },
        {
          "role": "安格尔望",
          "text": "好吧，好吧，我承认，是我不对。"
        },
        {
          "role": "安格尔望",
          "text": "唉…我当然知道什么是对什么是错，但实在没办法，因为我真的很需要这笔钱。"
        },
        {
          "role": "安格尔望",
          "text": "我本来是研究古遗迹的专家，家庭美满，工作顺利。"
        },
        {
          "role": "安格尔望",
          "text": "但谁能想到，自己的儿子竟然被人蛊惑，陷入了赌博的泥沼…家里本来有些积蓄，但架不住钱就像瀑布一样流走…"
        },
        {
          "role": "安格尔望",
          "text": "欠债以后，他时常遭到债主威胁恐吓，我作为亲生父亲，又怎么能眼睁睁看着他遭遇这种事呢。"
        },
        {
          "role": "安格尔望",
          "text": "唉，我儿子就像你这般年纪，如果他也能像你一样健康成长就好了…所以我才需要钱！"
        },
        {
          "role": "基尼奇",
          "text": "……"
        },
        {
          "role": "安格尔望",
          "text": "你…"
        },
        {
          "role": "安格尔望",
          "text": "求求你了，小伙子，帮帮忙吧！"
        },
        {
          "role": "安格尔望",
          "text": "看在我们都是纳塔同胞的份上，饶我一命！"
        },
        {
          "role": "安格尔望",
          "text": "如果我回去，还有机会管教好我那不争气的儿子。但如果我被抓，他可能只有死路一条了！"
        },
        {
          "role": "安格尔望",
          "text": "作为家人，理应为了更好的未来一起战斗的，对吧？"
        },
        {
          "role": "安格尔望",
          "text": "我们全家的机会都在你的手上了，求求你，高抬贵手吧！"
        },
        {
          "role": "基尼奇",
          "text": "……"
        },
        {
          "role": "阿乔",
          "text": "哈哈，基尼奇，基尼奇，怎么不说话？难道心软了？"
        },
        {
          "role": "基尼奇",
          "text": "哼。"
        },
        {
          "role": "基尼奇",
          "text": "我不会相信你说的任何一句话。"
        },
        {
          "role": "基尼奇",
          "text": "莱欧斯利还真是猜对了八成，你就是一个彻头彻尾的赌徒。"
        },
        {
          "role": "安格尔望",
          "text": "呃，赌徒？我？怎么可能，都说了是我儿子…"
        },
        {
          "role": "基尼奇",
          "text": "首先，你真的是纳塔人吗？"
        },
        {
          "role": "基尼奇",
          "text": "如果你一直关注着那把枪的动向，应该不会连一个熟悉的面孔都认不出。"
        },
        {
          "role": "基尼奇",
          "text": "而比起这个，说「审判庭」的时候倒是顺口得很。"
        },
        {
          "role": "安格尔望",
          "text": "什么啊，就凭这个…"
        },
        {
          "role": "安格尔望",
          "text": "我，我可以解释的！我…我其实是从小生活在…"
        },
        {
          "role": "基尼奇",
          "text": "啧，真是一句话都不想再听了。"
        },
        {
          "role": "基尼奇",
          "text": "阿乔，给你一个堵别人嘴的机会，怎么样？"
        },
        {
          "role": "阿乔",
          "text": "哈哈哈，等你这句话好久了！"
        },
        {
          "role": "阿乔",
          "text": "没脸皮的老东西，吃我一拳！"
        },
        {
          "role": "基尼奇",
          "text": "赌徒的特征之一就是谎话连篇。"
        },
        {
          "role": "基尼奇",
          "text": "我猜你只是假扮成纳塔人的枫丹人罢了，身边也没有什么家人朋友。即便有，他们也早就因为你的不知廉耻离去了。"
        },
        {
          "role": "基尼奇",
          "text": "当然，我也有猜错的可能。"
        },
        {
          "role": "基尼奇",
          "text": "——但那又如何？"
        },
        {
          "role": "基尼奇",
          "text": "我只负责抓人，既不是你的代理人，也不是你的贴心听众。"
        },
        {
          "role": "基尼奇",
          "text": "而从你口中挖出真相，是你最喜欢的审判庭的职责。对吧？"
        },
        {
          "role": "夏沃蕾",
          "text": "没错。"
        },
        {
          "role": "夏沃蕾",
          "text": "基尼奇先生，好久不见。这名犯人就由特巡队接管了。"
        },
        {
          "role": "基尼奇",
          "text": "啊，辛苦你们了。"
        },
        {
          "role": "夏沃蕾",
          "text": "哪里，还是要再次感谢你的鼎力协助。"
        },
        {
          "role": "阿乔",
          "text": "我的呢？我的呢？无礼！难道不应该向伟大圣龙表达诚挚感谢吗！"
        },
        {
          "role": "夏沃蕾",
          "text": "那好吧，谢谢你和咔库库先生的精彩演出。"
        },
        {
          "role": "阿乔",
          "text": "啊——什么意思啊你，站住——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "基尼奇：你还好吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基尼奇",
          "text": "被一路拖行的人又不是我，放心吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉你刚刚心情不好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿乔",
          "text": "噗噗，小小基尼奇，是想起小小小小基尼奇的事情了吧？"
        },
        {
          "role": "阿乔",
          "text": "可别哭鼻子哦！伟大圣龙要是有这么懦弱的下仆，也是会没面子的！"
        },
        {
          "role": "基尼奇",
          "text": "什么跟什么…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": []
        },
        {
          "role": "基尼奇",
          "text": "也没有瞒你的必要，简单来讲，我确实很讨厌赌徒。"
        },
        {
          "role": "基尼奇",
          "text": "他们是世界上最没有责任心，最不尊重付出与回报的人。"
        },
        {
          "role": "基尼奇",
          "text": "为了一枚硬币，他们可以编出千万个谎言，再妄图通过这枚硬币，赌出千万的财富。"
        },
        {
          "role": "基尼奇",
          "text": "但我们都清楚，凭空得到的东西，背后总暗藏着无法想象的代价。"
        },
        {
          "role": "基尼奇",
          "text": "我从前的生活已经是我父亲赌输代价的一部分了。如果可以，我不希望有其他人陷入类似的境遇。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "基尼奇…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基尼奇",
          "text": "不用为我难过，我自己也并不觉得难过。"
        },
        {
          "role": "基尼奇",
          "text": "都说人是由过去组成。而既然我能走到现在这一步，那说明我一定做对了很多很多事情。"
        },
        {
          "role": "基尼奇",
          "text": "不要因他人的过失惩戒自己。"
        },
        {
          "role": "基尼奇",
          "text": "我的话，会选择记得那些让我成长的瞬间。"
        },
        {
          "role": "[[file",
          "text": "活动任务-一切代价的回旋-CG1.png|center|1100px]]"
        },
        {
          "role": "基尼奇",
          "text": "就像我第一次学会使用钩索——"
        },
        {
          "role": "[[file",
          "text": "活动任务-一切代价的回旋-CG2.png|center|1100px]]"
        },
        {
          "role": "基尼奇",
          "text": "第一次渴求知识的时候。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基尼奇",
          "text": "嗯，我相信你。"
        },
        {
          "role": "基尼奇",
          "text": "走吧。再不回去，会有更多人产生不必要的担心。"
        },
        {
          "type": "subtitle",
          "text": "与基尼奇一同返回"
        },
        {
          "role": "派蒙",
          "text": "喔，旅行者，基尼奇，你们回来啦！"
        },
        {
          "role": "派蒙",
          "text": "刚刚看夏沃蕾带着犯人离开了，好像心情不错的样子呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "比预想的顺利。",
              "dialogues": []
            },
            {
              "text": "敌人很弱欸。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，让我们绕了好大的圈子，结果也只是一个没什么战斗力，只会逃跑的家伙嘛！"
        },
        {
          "role": "派蒙",
          "text": "哦对了，莱欧斯利让我告诉你们，他已经去沫芒宫汇报结果了。"
        },
        {
          "role": "派蒙",
          "text": "他说接下来，逐影庭将深入调查灰色赌博产业，有得忙了。"
        },
        {
          "role": "派蒙",
          "text": "但无论如何，那些都是沫芒宫的工作，和我们关系不大啦。"
        },
        {
          "role": "夏洛蒂",
          "text": "我看这位公爵大人跑得这么快，是为了躲避记者的镜头吧！"
        },
        {
          "role": "夏洛蒂",
          "text": "哎，不过也习惯了。"
        },
        {
          "role": "派蒙",
          "text": "竟然这么轻易地放弃了！"
        },
        {
          "role": "夏洛蒂",
          "text": "哼哼，反正刚刚已经拍到了超多精彩瞬间，足够我出一篇头条新闻了！"
        },
        {
          "role": "夏洛蒂",
          "text": "所以说，由于公务缠身，忙碌的记者先行告退，回去冲洗画片啦！"
        },
        {
          "role": "派蒙",
          "text": "要给派蒙选最帅的角度哦！"
        },
        {
          "role": "派蒙",
          "text": "啊，跑得好快，希望她听到了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "相信专业摄影师的审美吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，也是哦！"
        },
        {
          "role": "派蒙",
          "text": "不过刚刚你们怎么花了这么久才过来，是遇到什么问题了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "阿乔撞到了头，在哭鼻子。",
              "dialogues": [
                {
                  "role": "阿乔",
                  "text": "什么？！"
                },
                {
                  "role": "阿乔",
                  "text": "你这家伙，怎么张嘴就来！，"
                },
                {
                  "role": "阿乔",
                  "text": "我伟大圣龙，「库胡勒阿乔」，何时有过此等丑态！"
                },
                {
                  "role": "基尼奇",
                  "text": "还少吗。"
                }
              ]
            },
            {
              "text": "基尼奇磕到了头，在哭鼻子。",
              "dialogues": [
                {
                  "role": "基尼奇",
                  "text": "你说是就是。"
                },
                {
                  "role": "阿乔",
                  "text": "啊哈哈哈哈哈，小小基尼奇，没人给他摸摸头，只好自己哭鼻子！"
                },
                {
                  "role": "派蒙",
                  "text": "真的假的？总觉得阿乔哭鼻子倒是更有可能…"
                },
                {
                  "role": "阿乔",
                  "text": "喂——"
                }
              ]
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "接下来有什么打算？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基尼奇",
          "text": "嗯…说实话，还没想好。"
        },
        {
          "role": "基尼奇",
          "text": "也没什么急事，搞不好审判庭还要再叫我去作证。"
        },
        {
          "role": "基尼奇",
          "text": "至于那把来自纳塔的枪，作为关键物证，可能也得等案件审理完成后再带回纳塔了。"
        },
        {
          "role": "基尼奇",
          "text": "总之，就让我再享受一阵沙滩与大海吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（那维莱特&莱欧斯利&夏沃蕾）"
        },
        {
          "role": "夏沃蕾",
          "text": "我们正在就灰色赌博产业一案对嫌疑人进行问询，一有消息就会告知各位。"
        },
        {
          "role": "那维莱特",
          "text": "嗯，辛苦了。"
        },
        {
          "role": "莱欧斯利",
          "text": "听上去好像没有我的事了？那容我先行告辞…"
        },
        {
          "role": "那维莱特",
          "text": "等等。"
        },
        {
          "role": "那维莱特",
          "text": "莱欧斯利先生作为重要证人，可能需要出席后续庭审。"
        },
        {
          "role": "莱欧斯利",
          "text": "哦天哪，真的假的…"
        },
        {
          "role": "夏沃蕾",
          "text": "？"
        },
        {
          "role": "莱欧斯利",
          "text": "我是说…可不可以让我匿名出席呢？"
        },
        {
          "role": "夏沃蕾",
          "text": "这怎么做到…听听你说的话。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（基尼奇&伊法&欧洛伦&咔库库&阿乔）"
        },
        {
          "role": "欧洛伦",
          "text": "之前，那位粉色头发的小姐给阿乔和咔库库照了合影。"
        },
        {
          "role": "伊法",
          "text": "听你这语气有些遗憾啊，难道也想加入吗？"
        },
        {
          "role": "欧洛伦",
          "text": "一开始是有点。"
        },
        {
          "role": "欧洛伦",
          "text": "但看到阿乔扭捏的样子，我又觉得自己可能无法融入它们。"
        },
        {
          "role": "阿乔",
          "text": "哈？！你不早说？"
        },
        {
          "role": "阿乔",
          "text": "我宁愿搂着你的脖子合影，也不想和那玩意儿出现在同一个画面上！"
        },
        {
          "role": "欧洛伦",
          "text": "真的吗？那你现在也有机会，来吧。"
        },
        {
          "role": "阿乔",
          "text": "稍等片刻，我的「怒火」马上到你脸上。"
        },
        {
          "role": "咔库库",
          "text": "我来保护，哥们！"
        },
        {
          "role": "伊法",
          "text": "……"
        },
        {
          "role": "伊法",
          "text": "基尼奇，你有没有想过永远把这帮家伙留在这片海域。"
        },
        {
          "role": "基尼奇",
          "text": "想过。但鉴于阿乔的特殊性，这可能会算作一种跨国走私行为。"
        },
        {
          "role": "基尼奇",
          "text": "我不能知法犯法。"
        },
        {
          "role": "伊法",
          "text": "哈哈，看来大家都有生活的难处呢。"
        },
        {
          "type": "subtitle",
          "text": "沫芒宫公告板"
        },
        {
          "role": "市民通告",
          "text": "「近期枫丹廷内发现不法赌博现象，请市民朋友多加警惕。如发现相关情报，请立即联系执律庭工作人员。」"
        },
        {
          "role": "市民通告",
          "text": "「再次提醒广大市民提高安全意识、自觉遵守相关法律法规，保护好自己的人身与财产安全。」"
        }
      ],
