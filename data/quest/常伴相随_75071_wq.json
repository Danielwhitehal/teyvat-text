{
  "quest_id": 75071,
  "chapter_num": null,
  "chapter_title": "常伴相随",
  "type": "wq",
  "route": "Stand by Me",
  "stories": [
    {
      "story_id": 75071,
      "title": "常伴相随",
      "description": "当你惹上麻烦，是否还愿意同我相伴？",
      "dialogues": [
        {
          "role": "马尼菲科",
          "text": "哈哈，亲爱的旅行者和派蒙，我的缪斯和…呃，小缪斯！"
        },
        {
          "role": "马尼菲科",
          "text": "啊，还有旅行者！"
        },
        {
          "role": "派蒙",
          "text": "哪个才是小的啦！"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "呀！"
        },
        {
          "role": "马尼菲科",
          "text": "哈哈，请别在意！"
        },
        {
          "role": "派蒙",
          "text": "哼，我很在意！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "又有什么新灵感了吗？",
              "dialogues": [
                {
                  "role": "马尼菲科",
                  "text": "当然，不过…呃，嘿嘿，新的灵感就意味着…我又要找你们求助了。"
                },
                {
                  "role": "派蒙",
                  "text": "没问题啦！反正你每次都会给钱！"
                },
                {
                  "role": "马尼菲科",
                  "text": "哈哈，好呀，我的小小雇佣兵！"
                }
              ]
            },
            {
              "text": "又需要你的慕斯们帮忙了？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "慕斯…我也想吃了…"
                },
                {
                  "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                  "text": "咕噜…咕噜…"
                },
                {
                  "role": "马尼菲科",
                  "text": "呃…是「缪斯」…不是吃的！"
                },
                {
                  "role": "派蒙",
                  "text": "嘿嘿，只要你给钱，我们就能换成吃的！"
                },
                {
                  "role": "马尼菲科",
                  "text": "随便你怎么说啦…不过我确实有钱，两位不用担心白忙活！"
                }
              ]
            }
          ]
        },
        {
          "role": "马尼菲科",
          "text": "你看，我这次打算拍摄的是嵴锋龙…嘘，我们小心点。不要吵到它了。"
        },
        {
          "role": "马尼菲科",
          "text": "我还是第一次接触这种龙类，但我已经观察了它们一段时间了…真是迷人的动物…在坚硬的甲壳下面，它们也有自己的个性呢。"
        },
        {
          "role": "马尼菲科",
          "text": "嘿嘿，喂过它几次之后，它现在已经能听懂基本的指令了。"
        },
        {
          "role": "马尼菲科",
          "text": "不过我需要驯龙大师做的事呢，就是和那头离群的嵴锋龙互动，让我拍一张它与其他同类在一起的照片。"
        },
        {
          "role": "马尼菲科",
          "text": "嘿嘿，很简单，不是吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯，太简单啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（反正不是你在忙…）",
              "dialogues": []
            },
            {
              "text": "（也没那么简单啦…！）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马尼菲科",
          "text": "哈哈，就是这个劲头！来吧，帮我带来那头离群的嵴锋龙，我们就可以开始啦！"
        },
        {
          "type": "subtitle",
          "text": "魂附嵴锋龙，与马尼菲科对话"
        },
        {
          "role": "马尼菲科",
          "text": "「…幽暗的森林中飘荡着芬芳的花香…」"
        },
        {
          "role": "马尼菲科",
          "text": "「…珍重离别之前，请给我一个美好的拥抱~」"
        },
        {
          "role": "马尼菲科",
          "text": "嗯…？哈，抱歉，我又在哼歌了。"
        },
        {
          "role": "派蒙",
          "text": "嵴锋龙来啦！我们可以拍摄了吧！"
        },
        {
          "role": "马尼菲科",
          "text": "很好，开始啦！"
        },
        {
          "type": "subtitle",
          "text": "配合马尼菲科的拍摄"
        },
        {
          "type": "subtitle",
          "text": "与马尼菲科对话"
        },
        {
          "role": "马尼菲科",
          "text": "你发现了吗？小家伙好像注意到了什么东西…是它的家人吗？"
        },
        {
          "role": "马尼菲科",
          "text": "它自己往那边去了！我们也跟上吧，可别让它走丢了！"
        },
        {
          "type": "subtitle",
          "text": "追上小嵴锋龙"
        },
        {
          "type": "subtitle",
          "text": "击败敌人"
        },
        {
          "type": "subtitle",
          "text": "与马尼菲科对话"
        },
        {
          "role": "？？？",
          "text": "你们击败了敌人，破开了囚禁小驮兽的笼门。驮兽从笼子里雀跃地奔出来，对你们发出欢快的叫声。"
        },
        {
          "role": "派蒙",
          "text": "哇啊…呼，终于告一段落了！好惊险！"
        },
        {
          "role": "马尼菲科",
          "text": "嘘——！看……"
        },
        {
          "role": "马尼菲科",
          "text": "「咔嚓！」"
        },
        {
          "role": "马尼菲科",
          "text": "完美。"
        },
        {
          "role": "派蒙",
          "text": "哇…它们关系很好呢…我还以为驮兽会被吃掉…之类的。"
        },
        {
          "role": "马尼菲科",
          "text": "嘿嘿，别看嵴锋龙一副很凶恶的样子，其实它们的个性很温和的。"
        },
        {
          "role": "马尼菲科",
          "text": "终于拍好了，副本给你。还有报酬…这里。"
        },
        {
          "role": "马尼菲科",
          "text": "唉…本以为能拍到幼年嵴锋龙和成年体亲密互动的场面，没想到让一头小驮兽占了便宜！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，不过驮兽也不讨厌呀。你肯定也这样觉得吧！"
        },
        {
          "role": "马尼菲科",
          "text": "我怎样觉得不重要！重要的是摄影委员会的评委怎么觉得！"
        },
        {
          "role": "马尼菲科",
          "text": "不过…这小东西在纳塔的陌生环境里晃荡还是太危险了，我正好也缺少一个帮忙背东西的搭档…"
        },
        {
          "role": "马尼菲科",
          "text": "嘿嘿，我也就只好勉为其难收养它咯。"
        },
        {
          "role": "派蒙",
          "text": "那它原来的主人怎么办呀…？"
        },
        {
          "role": "马尼菲科",
          "text": "哼，把这小东西丢在那么危险的地方不管，是他自己的过错！"
        },
        {
          "role": "马尼菲科",
          "text": "好啦，不管那些啦！枫丹摄影画廊，我来咯！哈哈，到时候你们也要来哇！"
        },
        {
          "role": "马尼菲科",
          "text": "不好意思，这次我真的要离开这个国家了！再见了！旅行者和派蒙！再见，小家伙！"
        },
        {
          "role": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
          "text": "呀！"
        },
        {
          "role": "马尼菲科",
          "text": "嘿，接住！留个纪念！别忘了我呀，小家伙们！"
        }
      ]
    }
  ]
}