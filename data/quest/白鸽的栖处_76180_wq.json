{
  "quest_id": 76180,
  "chapter_num": null,
  "chapter_title": "白鸽的栖处",
  "type": "wq",
  "route": "Where the White Dove Rests",
  "stories": [
    {
      "story_id": 76180,
      "title": "白鸽的栖处",
      "description": "前往银月之庭放置茶桌并使用桑多涅落座后，与哥伦比娅共度茶会时光吧…",
      "dialogues": [
        {
          "role": "「少女」",
          "text": "以前都是到桑多涅的庭院去聚会，现在换成桑多涅你到我的庭院来喝茶，感觉真新奇。"
        },
        {
          "role": "「木偶」",
          "text": "但茶和茶点还是我来准备，感觉也没变多少…"
        },
        {
          "role": "「少女」",
          "text": "嗯，还是和以前一样美味。"
        },
        {
          "role": "「木偶」",
          "text": "哼。不过，听说旅行者也会经常来这边看你，你们这种时候都会干嘛？"
        },
        {
          "role": "「少女」",
          "text": "唔…有时会聊聊天，有时会和月灵一起玩游戏，看月灵画画。哦，我还会和他下月亮棋呢。"
        },
        {
          "role": "「木偶」",
          "text": "「月亮棋」？就是那种三个子连成一条线的游戏？你们谁赢得多？"
        },
        {
          "role": "「少女」",
          "text": "我没有数过，但旅行者挺会下棋的。"
        },
        {
          "role": "「木偶」",
          "text": "哼哼，那你是没和我玩过。要来一局吗？让你见识一下什么是真正的厉害。平局算我输。"
        },
        {
          "role": "「少女」",
          "text": "好呀。"
        },
        {
          "role": "「木偶」",
          "text": "什…什么？怎么可能！"
        },
        {
          "role": "「少女」",
          "text": "是你输了呢，桑多涅。"
        },
        {
          "role": "「木偶」",
          "text": "我…我这是让你的！"
        },
        {
          "role": "「少女」",
          "text": "真的吗？你明明很不甘心的样子。"
        },
        {
          "role": "「木偶」",
          "text": "可恶…再来！"
        },
        {
          "role": "「木偶」",
          "text": "哼，轻轻松松。"
        },
        {
          "role": "「少女」",
          "text": "是我输了。你果然很厉害呢，桑多涅。"
        },
        {
          "role": "「木偶」",
          "text": "下次带你玩些更有难度的吧。我知道很多好玩的数理游戏。"
        },
        {
          "role": "「少女」",
          "text": "好呀。哈哈。"
        },
        {
          "role": "「木偶」",
          "text": "你笑什么？"
        },
        {
          "role": "「少女」",
          "text": "以前很少看到桑多涅这么开心的样子，你也不怎么邀请我玩游戏，还会把我赶走。"
        },
        {
          "role": "「木偶」",
          "text": "喂…别把我说得像是经常欺负你一样好不好！我以后多找你开几次茶会总行了吧！"
        },
        {
          "role": "「少女」",
          "text": "嗯，好啊。我很喜欢这种和桑多涅你一起度过的茶会时光。"
        },
        {
          "role": "「少女」",
          "text": "和桑多涅玩游戏真开心。下次也一起玩吧。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "「少女」",
          "text": "要走了吗？好吧，那我们下次见。"
        }
      ]
    }
  ]
}