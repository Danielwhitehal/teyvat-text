{
  "quest_id": 72813,
  "chapter_num": null,
  "chapter_title": "肥料…推销员？",
  "type": "wq",
  "route": "Fertilizer... Salesperson?",
  "stories": [
    {
      "story_id": 72813,
      "title": "肥料…推销员？",
      "description": "海祇岛的岩田似乎正在因为某事而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与岩田对话"
        },
        {
          "type": "subtitle",
          "text": "隔天去查看肥料的情况"
        },
        {
          "role": "岩田",
          "text": "唉，希望这次可以成功啊…"
        },
        {
          "type": "subtitle",
          "text": "去查看肥料的情况"
        },
        {
          "role": "岩田",
          "text": "谢谢，谢谢你，旅行者…"
        },
        {
          "role": "岩田",
          "text": "我肥料刚做到一半，那些魔物就突然不知道从哪冲了过来…"
        },
        {
          "role": "岩田",
          "text": "真是莫名其妙…还好你来了。"
        },
        {
          "role": "旅行者",
          "text": "也许是那堆肥料的原因…"
        },
        {
          "role": "岩田",
          "text": "是、是吗？不过，我听说，有这种气味就是成功的前兆啊。"
        },
        {
          "role": "岩田",
          "text": "先不说这些了，来来，你来看看我做的肥料堆，我来打开给你详细讲讲…"
        },
        {
          "role": "五郎",
          "text": "给我等一会！"
        },
        {
          "role": "岩田",
          "text": "咦？五郎先生，您今天怎么有空过来了？"
        },
        {
          "role": "旅行者",
          "text": "是在巡逻吗？"
        },
        {
          "role": "五郎",
          "text": "我是在…呃…先不说这个…"
        },
        {
          "role": "五郎",
          "text": "这堆…东西，是你们做的吗？"
        },
        {
          "role": "岩田",
          "text": "哈哈哈，是的，这堆肥料正是我和这位旅行者做的。"
        },
        {
          "role": "岩田",
          "text": "五郎先生，难道你也是想要看看这肥料的情况，所以才过来了吗？"
        },
        {
          "role": "岩田",
          "text": "嘿嘿，你来得正好，我们现在就…"
        },
        {
          "role": "五郎",
          "text": "等一会！我不是来看这个的，不对，我就是来看这个的…我…"
        },
        {
          "role": "派蒙",
          "text": "五郎一脸无法忍受的表情啊…"
        },
        {
          "role": "旅行者",
          "text": "我们先离这堆肥料远点吧…"
        },
        {
          "role": "五郎",
          "text": "好，我们先去旁边说话。"
        },
        {
          "role": "岩田",
          "text": "五郎先生，到底您是来做什么的？"
        },
        {
          "role": "五郎",
          "text": "最近，很多居民都说闻到了一股可怕的异味…"
        },
        {
          "role": "五郎",
          "text": "为了保险起见，我就稍微侦察了一下，循着气味一路找了过来。"
        },
        {
          "role": "五郎",
          "text": "然后，就找到了你们。"
        },
        {
          "role": "五郎",
          "text": "岩田，我听说你一直在研究肥料，但你这种制作方法，实在是太…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "扰民。",
              "dialogues": []
            },
            {
              "text": "刺激。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "五郎",
          "text": "没错。无论如何，岩田，你先把肥料堆撤掉，关于肥料的事，我会想想其他的办法。"
        },
        {
          "role": "大久保大介",
          "text": "大将！五郎大将！"
        },
        {
          "role": "五郎",
          "text": "我在，怎么了？"
        },
        {
          "role": "大久保大介",
          "text": "大将，我们在外围抓到了一个鬼鬼祟祟的人。"
        },
        {
          "role": "大久保大介",
          "text": "那个家伙鬼鬼祟祟的，一个劲说自己是什么…肥料的推销员。"
        },
        {
          "role": "大久保大介",
          "text": "我们觉得不对劲，就把那个人给扣了下来，请您赶快过去看看吧。"
        },
        {
          "role": "五郎",
          "text": "又是肥料，我今天真是和肥料过不去了…"
        },
        {
          "role": "五郎",
          "text": "我知道了，马上就过去，你先到那边维持住秩序。"
        },
        {
          "role": "五郎",
          "text": "岩田，你先处理好肥料堆的事情，后面的事后面再说。"
        },
        {
          "role": "五郎",
          "text": "旅行者，你也一起来吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": []
            },
            {
              "text": "肥料…推销员？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "推销肥料的人？总感觉，有一种熟悉的感觉…但是又想不起来…"
        },
        {
          "role": "派蒙",
          "text": "算了，总之先过去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "role": "岩田",
          "text": "唉，制作肥料可真难啊…"
        },
        {
          "type": "subtitle",
          "text": "与岩田对话"
        },
        {
          "type": "subtitle",
          "text": "与五郎一起去查看可疑人士"
        },
        {
          "role": "爱拉尼",
          "text": "呜…我就是想写一篇论文，怎么又被关起来了…"
        },
        {
          "role": "博行",
          "text": "老实点！别乱动！"
        },
        {
          "role": "爱拉尼",
          "text": "我、我也没动啊！你们听我解释，我真的是教令院的学者！"
        },
        {
          "role": "博行",
          "text": "你刚才不是说，你只是来推销肥料的吗？"
        },
        {
          "role": "爱拉尼",
          "text": "我…教令院的学者也可以推销肥料啊！你们听我解释…"
        },
        {
          "role": "五郎",
          "text": "就是这个人吗？"
        },
        {
          "role": "大久保大介",
          "text": "是，大将。"
        },
        {
          "role": "大久保大介",
          "text": "我们抓到她的时候，她正在外面鬼鬼祟祟地游荡，还不停地记着什么东西。"
        },
        {
          "role": "大久保大介",
          "text": "大将，她肯定是幕府那边派来刺探情报的人！"
        },
        {
          "role": "爱拉尼",
          "text": "我不是！我没有！都说了我是个学者，正在为论文取材啊！"
        },
        {
          "role": "博行",
          "text": "别开玩笑了！为了那个什么论文，你连战场都敢来吗？肯定是有什么其他的目的！"
        },
        {
          "role": "爱拉尼",
          "text": "呜…除了论文之外，我怎么敢还想着其他的目的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你…",
              "dialogues": []
            },
            {
              "text": "爱拉尼？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱拉尼",
          "text": "旅行者！太好了，你在这，你快和他们说说，我不是坏人，我只是来写论文的！"
        },
        {
          "role": "五郎",
          "text": "你认识她？"
        },
        {
          "role": "旅行者",
          "text": "算是吧…"
        },
        {
          "role": "五郎",
          "text": "须弥的学者…居然能为了「毕业」这件事，做到那种地步吗…"
        },
        {
          "role": "五郎",
          "text": "不过，听你的说法，你似乎也不知道她的底细。"
        },
        {
          "role": "五郎",
          "text": "至于「从须弥来的学者」这件事，你也只是从她嘴里听说的，对吧？"
        },
        {
          "role": "旅行者",
          "text": "是的。"
        },
        {
          "role": "五郎",
          "text": "唔…这些证据，实在都是缺乏可信度。"
        },
        {
          "role": "五郎",
          "text": "但有你担保，我也愿意相信，她应该不是个坏人…"
        },
        {
          "role": "大久保大介",
          "text": "大将，我倒是有一个想法。"
        },
        {
          "role": "大久保大介",
          "text": "您记得考什克吗？那位一直在研究我们岛上的文化和历史的学者。"
        },
        {
          "role": "大久保大介",
          "text": "他之前就一直待在这里，学者的身份也很可信…不然，让他来辨认一下，这位…肥料推销员，到底是不是学者吧。"
        },
        {
          "role": "五郎",
          "text": "嗯，这样不错。旅行者，能麻烦你跑一趟，把考什克先生带过来吗？"
        },
        {
          "role": "五郎",
          "text": "为了防止意外，我会在这里守着这位…肥料推销员。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "五郎",
          "text": "那就拜托你了，请快去快回吧。"
        },
        {
          "type": "subtitle",
          "text": "寻找考什克"
        },
        {
          "role": "考什克",
          "text": "图腾的含义…嗯？旅行者，你找我有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于爱拉尼的事…"
        },
        {
          "role": "考什克",
          "text": "你说爱拉尼来海祇岛了？奇怪，她怎么来这里了…她不是应该去璃月吗？"
        },
        {
          "role": "旅行者",
          "text": "她被士兵抓住了…"
        },
        {
          "role": "考什克",
          "text": "什么？唉…在这种情况下来海祇岛…她当然会被怀疑了…"
        },
        {
          "role": "考什克",
          "text": "先不说这个了，我们赶紧过去吧，这孩子太莽撞了…"
        },
        {
          "type": "subtitle",
          "text": "与考什克对话"
        },
        {
          "type": "subtitle",
          "text": "与考什克一起去向五郎回报"
        },
        {
          "role": "考什克",
          "text": "爱拉尼，真的是你，你、你怎么来稻妻了？你不是应该在璃月吗？"
        },
        {
          "role": "爱拉尼",
          "text": "呜…这个说起来就没完了…"
        },
        {
          "role": "五郎",
          "text": "考什克先生，你认识爱拉尼吗？"
        },
        {
          "role": "考什克",
          "text": "您是…噢，您是五郎大将吧。"
        },
        {
          "role": "考什克",
          "text": "您说得没错，爱拉尼和我一样，都是在教令院求学的学者。"
        },
        {
          "role": "考什克",
          "text": "我们各自为了不同的课题离开了教令院。没想到会在这里遇见她…"
        },
        {
          "role": "五郎",
          "text": "但是…你们学者，都可以自由离开教令院吗？"
        },
        {
          "role": "考什克",
          "text": "也不能说都能「自由离开」。我和爱拉尼都属于「帝利耶悉」。"
        },
        {
          "role": "考什克",
          "text": "对我们来说，在外游学是研究的一部分，所以离开教令院是被允许的行为。"
        },
        {
          "role": "考什克",
          "text": "五郎大将，我可以为爱拉尼做担保，你看…"
        },
        {
          "role": "五郎",
          "text": "有了您做担保，那就没问题了。"
        },
        {
          "role": "爱拉尼",
          "text": "呼…得救了…谢谢你们…"
        },
        {
          "role": "五郎",
          "text": "博行，大久保，你们也去忙自己的吧，这里没事了。"
        },
        {
          "role": "博行",
          "text": "是，大将。"
        },
        {
          "role": "大久保大介",
          "text": "是，大将。"
        },
        {
          "role": "五郎",
          "text": "抱歉了，爱拉尼小姐，之前把你当做可疑人士了。"
        },
        {
          "role": "五郎",
          "text": "嗯…虽然你的嫌疑已经洗清了，但是你擅自闯入海祇岛，给我们也添了很多麻烦。"
        },
        {
          "role": "爱拉尼",
          "text": "欸？有、有什么惩罚吗？我可没有带多少摩拉，呜…"
        },
        {
          "role": "五郎",
          "text": "既然你之前说，你是一个肥料推销员…而且，还是一个有学者身份的肥料推销员。"
        },
        {
          "role": "五郎",
          "text": "那正好，我们这边有一个叫做岩田的人，正在研究肥料的事，爱拉尼小姐，请你去协助他一下吧。"
        },
        {
          "role": "五郎",
          "text": "假如你能帮助他制作出不那么「扰民」的肥料，那你就可以像考什克先生一样，在这附近自由研究了。"
        },
        {
          "role": "爱拉尼",
          "text": "肥、肥料？不，那个，我只是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她没问题的。",
              "dialogues": []
            },
            {
              "text": "交给你了，爱拉尼。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "考什克",
          "text": "爱拉尼，这可是个取材的好机会，你既然来了稻妻，那就证明，你的论文应该还…"
        },
        {
          "role": "爱拉尼",
          "text": "唔…唔…"
        },
        {
          "role": "考什克",
          "text": "教令院的毕业准则你也知道，要是连续几年都没法毕业的话…"
        },
        {
          "role": "爱拉尼",
          "text": "我、我做！我做就是了！"
        },
        {
          "role": "爱拉尼",
          "text": "我也在瓦希德先生那边了解过肥料了…看我一口气搞定它！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕业真是催人成长啊…",
              "dialogues": []
            },
            {
              "text": "毕业真是最强动力啊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "五郎",
          "text": "那这件事就这么定了，肥料的事就拜托你了，爱拉尼小姐，我要先去处理其他的事了。"
        },
        {
          "role": "五郎",
          "text": "对了，你们记得告诉岩田，让他把那个…肥料堆，稍微放远一些。"
        },
        {
          "role": "考什克",
          "text": "那我也继续去研究去了，爱拉尼，如果有什么问题的话可以来问我。"
        },
        {
          "type": "subtitle",
          "text": "和爱拉尼一起去找岩田"
        },
        {
          "role": "五郎",
          "text": "快去把考什克带回来吧，请快去快回。"
        },
        {
          "role": "岩田",
          "text": "你回来了，旅行者，我已经把那个肥料堆处理掉了。"
        },
        {
          "role": "岩田",
          "text": "唉，我得再找个地方实验了…"
        },
        {
          "role": "岩田",
          "text": "咦？这位是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是五郎给你找的帮手。",
              "dialogues": [
                {
                  "role": "爱拉尼",
                  "text": "你好，我叫爱拉尼…"
                }
              ]
            },
            {
              "text": "这是来自须弥的肥料专家。",
              "dialogues": [
                {
                  "role": "爱拉尼",
                  "text": "你好，我叫爱拉尼…等一下，谁是肥料专家啊！"
                },
                {
                  "role": "爱拉尼",
                  "text": "我就是…略微了解一些。"
                }
              ]
            }
          ]
        },
        {
          "role": "爱拉尼",
          "text": "那个…总之，那位五郎「大将」让我来协助你进行肥料的研究工作…"
        },
        {
          "role": "爱拉尼",
          "text": "之后，我们就好好合作吧。"
        },
        {
          "role": "岩田",
          "text": "是吗…太好了！要是真能成功把肥料制作出来，那海祇岛上就能种更多的作物了！"
        },
        {
          "role": "旅行者",
          "text": "记得把肥料堆放远点。"
        },
        {
          "role": "岩田",
          "text": "啊？哦…哦，我知道了。"
        },
        {
          "role": "岩田",
          "text": "总之，我们就好好合作吧！请多多指教了，爱拉尼小姐！"
        },
        {
          "role": "爱拉尼",
          "text": "好的，我一定会努力的…"
        },
        {
          "role": "爱拉尼",
          "text": "为了我的论文，我一定会努力的，呜…"
        }
      ]
    }
  ]
}