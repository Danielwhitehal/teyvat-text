{
  "quest_id": 41143,
  "chapter_num": null,
  "chapter_title": "猎鹿急送",
  "type": "eq",
  "route": "Good Hunter Express",
  "stories": [
    {
      "story_id": 41143,
      "title": "猎鹿急送",
      "description": "蒙德城的猎鹿人餐馆里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "莎拉",
          "text": "好吧…那我再找别人来帮忙…"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "莎拉",
          "text": "那就最好了，谢谢你。"
        },
        {
          "role": "莎拉",
          "text": "送的时候千万要小心一些，别让它沾了奇怪的元素。"
        },
        {
          "role": "莎拉",
          "text": "还有千万绕着魔物走，别被它们把菜撞翻了。"
        },
        {
          "role": "莎拉",
          "text": "好了，快点把这道菜送过去吧，凉了就不好吃了。"
        },
        {
          "role": "急躁的瓦里特",
          "text": "我订的餐怎么还没送来，真是磨磨蹭蹭的…"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "莎拉",
          "text": "对啊，你来得正是时候，我刚把这份甜甜花酿鸡准备好。"
        },
        {
          "role": "莎拉",
          "text": "瓦里特先生早些时候在我们这边订了这道菜，要我们过一会送到晨曦酒庄西面的一个地方…"
        },
        {
          "role": "莎拉",
          "text": "如果你愿意帮忙的话，就快把这份订单送过去吧。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "急躁的瓦里特",
          "text": "终于送来了，多谢，多谢。"
        },
        {
          "role": "急躁的瓦里特",
          "text": "我得快点吃完，还有一堆事要办…"
        }
      ]
    }
  ]
}