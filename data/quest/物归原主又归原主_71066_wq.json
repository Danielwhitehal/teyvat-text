{
  "quest_id": 71066,
  "chapter_num": null,
  "chapter_title": "物归原主又归原主",
  "type": "wq",
  "route": "Stolen, by the Rightful Owner",
  "stories": [
    {
      "story_id": 71066,
      "title": "物归原主又归原主",
      "description": "吟游诗人塔列辛向你求助，原来是他从盗宝鼬窝里取得的戒指又被盗宝鼬偷走了…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "龙脊雪山没什么熔岩池。"
        },
        {
          "role": "塔列辛",
          "text": "唉…奇怪，奇怪，真是奇哉怪也…"
        },
        {
          "role": "塔列辛",
          "text": "应该还在的才对…可是怎么也找不到了…"
        },
        {
          "role": "旅行者",
          "text": "发生什么事了？"
        },
        {
          "role": "塔列辛",
          "text": "我的戒指…不见了。那枚戒指对我来说很重要，如果丢在这里可不行啊…"
        },
        {
          "role": "旅行者",
          "text": "你的戒指是什么样子的？"
        },
        {
          "role": "塔列辛",
          "text": "戒圈是黄铜的，上面镶嵌了一枚漂亮的红色宝石…"
        },
        {
          "role": "塔列辛",
          "text": "我是在传说中魔龙杜林陨落之地旁边的熔岩池拾到它的，这应当能解释为何它会有阴燃的黑暗火焰光泽…"
        },
        {
          "role": "派蒙",
          "text": "哇……"
        },
        {
          "role": "塔列辛",
          "text": "传说它的主人一旦戴上它，就会受到「深渊之大君」的凝视，被它的黑暗大军追杀…"
        },
        {
          "role": "派蒙",
          "text": "哦！"
        },
        {
          "role": "塔列辛",
          "text": "咳咳…抱歉，抱歉，身为诗人总会尝试更为戏剧化的表达，试验更新颖的故事嘛。"
        },
        {
          "role": "塔列辛",
          "text": "嘿嘿，其实那枚戒指是几年前，我从盗宝鼬的窝里掏来的…看起来保存状况还不错，也挺好看的，就留在身上了。"
        },
        {
          "role": "派蒙",
          "text": "哼，原来是偷了小偷的赃物呀！"
        },
        {
          "role": "塔列辛",
          "text": "不要说得那么难听嘛…是拾取，拾取才对！我还是很珍惜这件宝物的。"
        },
        {
          "role": "旅行者",
          "text": "关于戒指，有什么线索吗？"
        },
        {
          "role": "塔列辛",
          "text": "嗯…听说附近经常有盗宝鼬出没，说不定是这些小东西趁我睡下，把我的戒指偷走了。"
        },
        {
          "role": "派蒙",
          "text": "原来还有人睡觉会摘戒指的呀…"
        },
        {
          "role": "旅行者",
          "text": "没听说过呢。"
        },
        {
          "role": "派蒙",
          "text": "反正我是不会啦！摘下戒指还要考虑放在哪里，就浪费了好好睡觉的时间啦…"
        },
        {
          "role": "旅行者",
          "text": "真的有给派蒙戴的小戒指吗？"
        },
        {
          "role": "派蒙",
          "text": "哼，当然有啦。世界之大，你不知道的东西还多得是呢！"
        },
        {
          "role": "塔列辛",
          "text": "好了，请两位不要再随意评论别人的生活习惯，然后自顾自扯闲天了！很不礼貌的！"
        },
        {
          "role": "塔列辛",
          "text": "总之，如果要帮忙找戒指的话…嗯，请找一找有没有盗宝鼬的巢穴吧？"
        },
        {
          "role": "塔列辛",
          "text": "我听说在地图的这个地方…盗宝团设立了可疑的营地。来，我为你标出来好了。"
        },
        {
          "role": "塔列辛",
          "text": "据说在这一带常有盗宝鼬出没，很可能与那些鬼鬼祟祟的盗宝团有关…总之，还是请先去这里察看一番吧。"
        },
        {
          "role": "派蒙",
          "text": "哼…从盗宝鼬窝里偷来的戒指，又被盗宝鼬偷回去，也算是物归原主了吧！"
        },
        {
          "role": "塔列辛",
          "text": "请不要再挖苦我啦！"
        },
        {
          "type": "subtitle",
          "text": "寻找塔列辛被偷走的戒指"
        },
        {
          "role": "塔列辛",
          "text": "你回来了！怎么样，收获如何？"
        },
        {
          "role": "旅行者",
          "text": "你看看，是不是这枚戒指？"
        },
        {
          "type": "subtitle",
          "text": "将寻到的戒指交给塔列辛"
        },
        {
          "type": "subtitle",
          "text": "将寻到的戒指交给塔列辛"
        },
        {
          "role": "旅行者",
          "text": "我不信。"
        },
        {
          "type": "subtitle",
          "text": "将寻到的戒指交给塔列辛"
        },
        {
          "type": "subtitle",
          "text": "与塔列辛对话"
        },
        {
          "role": "塔列辛",
          "text": "没错，就是这枚！太感谢你们了！"
        },
        {
          "role": "塔列辛",
          "text": "请收下这些报酬吧，虽然不是很多…不过请你不必介意，我也一定会把这件事写进诗里传扬四方的！"
        }
      ]
    }
  ]
}