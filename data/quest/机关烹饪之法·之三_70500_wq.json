  "chapter_title": "机关烹饪之法·之三",
  "type": "wq",
  "route": "Contraption-Contrived Cooking Course: Part III",
  "stories": [
    {
      "story_id": 70500,
      "title": "机关烹饪之法·之三",
      "description": "留云借风真君似乎准备用「机关烹饪神机」制作第三道全新的菜品…",
      "dialogues": [
         {
          "type": "subtitle",
          "text": "与留云借风真君对话"
        },
        {
          "role": "留云借风真君",
          "text": "冰天雪地，玉树琼枝…寂寞又冷冽之地啊。本仙这第三道菜，倒是应景得很。"
        },
        {
          "role": "旅行者",
          "text": "这次又要做什么菜？"
        },
        {
          "role": "留云借风真君",
          "text": "唔…本仙问你，你有没有听说过一种名为「烩」的烹饪手法？这种手法也是本仙翻阅食谱时偶然发现的。"
        },
        {
          "role": "留云借风真君",
          "text": "本仙深感有趣，特意以这种烹饪手法为核心，写出了一份名为「红烩兽肉」的新食谱。"
        },
        {
          "role": "留云借风真君",
          "text": "虽然对本仙的「机关烹饪神机」来说，这道菜并不麻烦，但「红烩兽肉」这道菜重点在肉，所用的兽肉必须是优品…"
        },
        {
          "role": "留云借风真君",
          "text": "因此，本仙开启机关，一路追寻着食材的气息来到这里。"
        },
        {
          "role": "留云借风真君",
          "text": "此处风雪弥漫，实难办事。"
        },
        {
          "role": "留云借风真君",
          "text": "旅行者，本仙知道你见识广阔又精于冒险，区区雪山，对你而言，肯定不在话下。"
        },
        {
          "role": "留云借风真君",
          "text": "就请你再为本仙跑一趟，寻些食材回来吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
             {
              "text": "第三份食谱我也要哦。",
              "dialogues": [
                {
          "role": "留云借风真君",
          "text": "自然忘不了你的。那这件事就交给你了，本仙就在这里等着你。"
        }
              ]
            },
            {
              "text": "您冷得飞不动了吗？",
              "dialogues": [
                {
          "role": "留云借风真君",
          "text": "笑话！本仙威能，岂容你小觑！本仙只是、只是…需要在此修缮机关罢了！"
        },
        {
          "role": "留云借风真君",
          "text": "笑话！本仙威能，岂容你小觑！本仙只是、只是…需要在此修缮机关罢了！"
        }
              ]
            }
          ]
        },

        
        {
          "role": "留云借风真君",
          "text": "呃，机关怎么突然停了，难不成是周遭太冷…"
        },
        {
          "role": "留云借风真君",
          "text": "待本仙重启一下…"
        },
        {
          "role": "留云借风真君",
          "text": "机关烹饪神机…启！"
        },
        {
          "role": "留云借风真君",
          "text": "这下应该好了…旅行者，你快循着气息的踪迹，去把本仙要的食材拿回来吧。"
        },
         {
          "type": "subtitle",
          "text": "与留云借风真君对话"
        },
        {
          "role": "留云借风真君",
          "text": "怎么样，你拿到本仙要的食材了吗？"
        },
       
        {
          "role": "留云借风真君",
          "text": "这是…什么肉？"
        },
        {
          "role": "旅行者",
          "text": "冷鲜肉。"
        },
        {
          "role": "留云借风真君",
          "text": "冷鲜肉…名字倒是贴切。"
        },
        {
          "role": "留云借风真君",
          "text": "唔…品质不错。但看肉的状态，还需要稍加小火，化冻才行。"
        },
        {
          "role": "留云借风真君",
          "text": "幸好，本仙设计的「机关烹饪神机」兼有解冻之能…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这机关好像什么功能都不缺。",
              "dialogues": [
                {
          "role": "留云借风真君",
          "text": "怎么会呢？要说功能缺失，自然也有。例如，自动取回食材啊，自动控制火候…之类的。"
        },
        {
          "role": "留云借风真君",
          "text": "这机关，还是需要多多改进。"
        }
              ]
            },
            {
              "text": "仙人，果然很强大。",
              "dialogues": [
                {
          "role": "留云借风真君",
          "text": "与其赞赏仙力，本仙更希望你赞赏「机关烹饪神机」的巧能。"
        }
       
        
              ]
            }
          ]
        },

        {
          "role": "留云借风真君",
          "text": "好了，闲话不多说。既然食材备齐，本仙马上就去开启机关。"
        },
        {
          "role": "留云借风真君",
          "text": "照看火候的事，依然交给你负责，旅行者。"
        },
        {
          "role": "留云借风真君",
          "text": "你准备好之后，速来知会本仙。"
        },
        {
          "role": "旅行者",
          "text": "准备好了"
        },
        {
          "role": "留云借风真君",
          "text": "那我们就开始吧。"
        },
        {
          "role": "留云借风真君",
          "text": "机关烹饪神机…启！"
        },
        {
          "role": "旅行者",
          "text": "还没准备好。"
        },
        {
          "role": "留云借风真君",
          "text": "唔…那你准备好之后，再来告诉本仙吧。"
        },
        
        {
          "role": "留云借风真君",
          "text": "嗯…味道真是不错，不愧是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不愧是您。",
              "dialogues": []
            },
            {
              "text": "不愧是您的「机关烹饪神机」。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "留云借风真君",
          "text": "正是。这三道菜做下来，本仙亲自制作的这台「机关烹饪神机」，其可靠性已完全得到验证。"
        },
        {
          "role": "留云借风真君",
          "text": "只要解决控制火候与自动取回食材这两大问题，这台机关便能「一键烹饪」了。"
        },
        {
          "role": "留云借风真君",
          "text": "对了，这份「红烩兽肉」的食谱你收好。食谱中所写的肉类，特指寻常兽肉。"
        },
        {
          "role": "留云借风真君",
          "text": "雪山天寒地冻，不能让你总来此地寻材觅食…"
        },
        {
          "role": "留云借风真君",
          "text": "平日里下厨做这道菜，用寻常兽肉便可。"
        },
        {
          "role": "留云借风真君",
          "text": "好了，多谢你帮本仙搜罗食材，旅行者。"
        },
        {
          "role": "留云借风真君",
          "text": "本仙也该带着「机关烹饪神机」回洞府去，再好好琢磨一番了。就此别过吧。"
        },
        {
          "role": "留云借风真君",
          "text": "噢，本仙若还有什么事需要帮忙的话…说不定还会再找你。"
        },
        {
          "role": "留云借风真君",
          "text": "到时候，你可千万不要推辞啊。毕竟本仙信得过你，最是认可你的实力。"
        }
      ]
    }
  ]
}