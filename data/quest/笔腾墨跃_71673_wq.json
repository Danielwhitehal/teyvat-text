{
  "quest_id": 71673,
  "chapter_num": null,
  "chapter_title": "笔腾墨跃",
  "type": "wq",
  "route": "Vigorous Brushstrokes",
  "stories": [
    {
      "story_id": 71673,
      "title": "笔腾墨跃",
      "description": "在璃月港里，你遇见了一个帮人作画的人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与闻冀对话"
        },
        {
          "role": "闻冀",
          "text": "嗯…总感觉这幅画里缺了点什么，是不是应该再找点灵感呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是在…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "闻冀",
          "text": "哎，这不是旅行者么？久闻大名，久仰啊。"
        },
        {
          "role": "闻冀",
          "text": "如您所见，在下正遵照总务司的安排，在这里布置节日游乐之所。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "呃…你要教人画画？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "闻冀",
          "text": "哎，非也非也，并非是「教人作画」，而是「替人作画」。"
        },
        {
          "role": "闻冀",
          "text": "这海灯节一年比一年盛大，来往的客人也越来越多，其中不乏从璃月之外远道而来的游客。"
        },
        {
          "role": "闻冀",
          "text": "虽然总务司也为他们安排了无偿的「纪念留影」，但留影嘛，毕竟还是缺少了点璃月风味。"
        },
        {
          "role": "闻冀",
          "text": "于是，总务司就命我来港口，替来往游客作画留念。"
        },
        {
          "role": "闻冀",
          "text": "我看最近在璃月港内，「白马仙人」的传说最为炙手可热，就想着干脆以此为主题作画好了。"
        },
        {
          "role": "闻冀",
          "text": "所谓龙腾虎跃，龙马精神，替各位客人以白马奔腾为题，作一幅「腾跃之画」，再吉利不过了啊。"
        },
        {
          "role": "闻冀",
          "text": "怎么样，旅行者，你心中可有什么适合作画的意象？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那还挺多的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "闻冀",
          "text": "噢？哈哈哈哈，那好啊，有灵感的话，就尽管说来，待我为你泼墨一番！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（闻冀）"
        },
        {
          "role": "闻冀",
          "text": "嗯…总感觉这幅画里缺了点什么，是不是应该再找点灵感呢···"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我有灵感了！",
              "dialogues": [
                {
                  "role": "闻冀",
                  "text": "请讲，在下洗耳恭听。"
                }
              ]
            },
            {
              "text": "还有别的事…",
              "dialogues": [
                {
                  "role": "闻冀",
                  "text": "恰逢佳节，事务繁忙也是正常，请阁下自便。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          15,
          17
        ]
      ]
    }
  ]
}