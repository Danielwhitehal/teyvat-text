{
  "quest_id": 75651,
  "chapter_num": null,
  "chapter_title": "善良促销",
  "type": "wq",
  "route": "An Honest Promotion",
  "stories": [
    {
      "story_id": 75651,
      "title": "善良促销",
      "description": "「买一送一大促销！买了我吃亏，不买你吃亏！」到底哪些人会因为这种标语上当…什么？派蒙居然已经预定了？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和派蒙一起走走"
        },
        {
          "role": "派蒙",
          "text": "旅行者最近做委托很辛苦吧，我都看在眼里了。"
        },
        {
          "role": "派蒙",
          "text": "作为一个贴心称职的向导，我有责任帮你放松一下，当当——快看这是什么地方！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "招牌上写着呢，达莫维百货。",
              "dialogues": [
                {
                  "role": "布希柯",
                  "text": "你们好，欢迎来到达莫维百货。"
                }
              ]
            },
            {
              "text": "摩拉小偷的住所，钱包坟场。",
              "dialogues": [
                {
                  "role": "布希柯",
                  "text": "顾客，这么说就不妥了。达莫维百货主打的一直是价廉物美，你们可以看看价格嘛。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这可不是一家普通的商店，这里是辛苦的劳动者通过消费获得精神放松的好地方。"
        },
        {
          "role": "布希柯",
          "text": "说的没错，我们最近还推出了买一送一促销活动！欢迎所有顾客参加！"
        },
        {
          "role": "布希柯",
          "text": "买了我吃亏，不买你吃亏！"
        },
        {
          "role": "派蒙",
          "text": "之前路过的时候，看到达莫维百货的活动海报，我就记住了。"
        },
        {
          "role": "派蒙",
          "text": "花一份钱，能买两份货，怎么看怎么划算。"
        },
        {
          "role": "派蒙",
          "text": "总有种不在这里消费，我的人生就有点缺憾的感觉…我今天就要带上旅行者一起弥补这份缺憾。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙想买什么？",
              "dialogues": []
            },
            {
              "text": "派蒙想怎么弥补缺憾？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，这个先不告诉你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我可不付钱。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼哼，今天不需要你来付，我自己带钱来了。"
        },
        {
          "role": "派蒙",
          "text": "老板，预订商品到货了吗？预订人的姓名是派蒙和旅行者。"
        },
        {
          "role": "布希柯",
          "text": "有的，稍等。"
        },
        {
          "type": "subtitle",
          "text": "店主布希柯取出了一件被过度包装得看不出是什么的商品，在一旁的派蒙掏出了一大堆零钱。眼看这一大堆零钱就这么离开了自己，派蒙的脸上流露出一丝不舍。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "和派蒙一起拆开厚厚的包装后，你意识到这是两本留影册。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "终于拿到了，我等了好久呢，心愿达成！"
        },
        {
          "role": "派蒙",
          "text": "平时拍了那么多画片，这下有地方存了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没看到派蒙用留影机啊？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没在你面前掏出来而已啦，趁你不注意我可是拍了不少你的糗照，嘿嘿。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "竟然有点想看…",
              "dialogues": []
            },
            {
              "text": "快给我看看！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "现在不行，等我拍满一整本再说。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小气派蒙。",
              "dialogues": []
            },
            {
              "text": "坏心眼儿派蒙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我才不是你说的那样呢。喏，这本留影册给你。"
        },
        {
          "role": "派蒙",
          "text": "虽然这一本有点薄，但也能放不少画片了。"
        },
        {
          "role": "派蒙",
          "text": "我们去过那么多地方，经常帮别人留影，给自己留下的画片却不多。"
        },
        {
          "role": "派蒙",
          "text": "要是能多留下一些自己的回忆就好了，所以我买了这两本留影册。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是礼物？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，买一送一，你一本我一本，预订的时候我就想好了。"
        },
        {
          "role": "派蒙",
          "text": "要立刻用起来哦，可以去拍一拍我们一起走过的地方，找一找过去的回忆。"
        },
        {
          "role": "派蒙",
          "text": "对了，要不要用我的留影机来拍？你好像还没用过它呢。"
        },
        {
          "role": "派蒙",
          "text": "当时费了那么大力气让百货店联络定制款，不多用用就可惜了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来试试。",
              "dialogues": []
            },
            {
              "text": "谢谢你，派蒙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你喜欢就最好啦，这都是一个贴心称职的向导该做的。"
        },
        {
          "role": "派蒙",
          "text": "走，我陪你一起去留影。"
        }
      ]
    }
  ]
}