  "stories": [
    {
      "story_id": 23014,
      "title": "加尔恰的赞歌·替代物",
      "description": "加尔恰似乎又遇见了什么难题…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与加尔恰对话"
        },
        {
          "role": "路通",
          "text": "先生，这次我真的诚心建议，我们还是选择想办法付钱吧。"
        },
        {
          "role": "加尔恰",
          "text": "那群卖货的简直是在抢劫！为什么几个徽印要卖那么贵！"
        },
        {
          "role": "路通",
          "text": "也许是因为他们发现，您看见那些徽印的时候两眼都在放光吧。"
        },
        {
          "role": "旅行者",
          "text": "你要那些徽印做什么？"
        },
        {
          "role": "加尔恰",
          "text": "旅行者！您每次都来得这么及时…"
        },
        {
          "role": "加尔恰",
          "text": "上次多亏了您帮忙，我基本上已经制造出一种能用的润滑剂了。"
        },
        {
          "role": "加尔恰",
          "text": "但我马上又遇到了一个问题，在我重制某些部件的时候，我发现…如果用太过坚硬的材料制造它们，反而容易将其它组件碰伤。"
        },
        {
          "role": "加尔恰",
          "text": "而且，那些太过坚硬的部件只要稍微受到冲击，就会出现不同程度的坏裂情况…"
        },
        {
          "role": "加尔恰",
          "text": "所以，我就开始寻找某种既有一定的硬度，又有着一定柔性的材料。"
        },
        {
          "role": "加尔恰",
          "text": "在我不懈的研究…"
        },
        {
          "role": "路通",
          "text": "…和对阿汉格尔先生的持续骚扰后。"
        },
        {
          "role": "加尔恰",
          "text": "我觉得盗宝团所携带的那种…徽记，也许就用到了某些我所要找的材料。"
        },
        {
          "role": "加尔恰",
          "text": "但是…那些商人简直和盗宝团一样在抢劫…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "又到了我出马的时候。",
              "dialogues": []
            },
            {
              "text": "我去帮你找找。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "加尔恰",
          "text": "我简直想把您的名字刻在「推数机」的主轴承里了！太谢谢您了！"
        },
        {
          "role": "加尔恰",
          "text": "唔…路通，你得扶着我点…"
        },
        {
          "role": "路通",
          "text": "先生，您还是回去再睡一会吧。"
        },
        {
          "role": "路通",
          "text": "旅行者，您来得正好！请过来一下吧，我想请您帮一个忙。"
        },
        {
          "role": "旅行者",
          "text": "他这是怎么了？"
        },
        {
          "role": "路通",
          "text": "简单来说…加尔恰先生喝了太多咖啡，睡觉的时间又太少。"
        },
        {
          "role": "路通",
          "text": "不过值得庆幸的是，先生至少只是喝咖啡，没有喝酒。"
        },
        {
          "role": "加尔恰",
          "text": "路通，呃…我，我们得再找几枚那种徽印才行…就盗宝团带着的那种…"
        },
        {
          "role": "加尔恰",
          "text": "旅行者！你怎么在这里，抱歉，我刚才没有注意到你。"
        },
        {
          "role": "加尔恰",
          "text": "你愿意帮我去拿点那种徽印来吗？只要几枚就好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你就回去休息一下吧。",
              "dialogues": [
                {
                  "role": "加尔恰",
                  "text": "没事，没事，我很好，思维很清晰…就是手有点不听使唤。"
                }
              ]
            },
            {
              "text": "喝咖啡能喝成这样？",
              "dialogues": [
                {
                  "role": "路通",
                  "text": "这倒是不能怪罪咖啡，只能怪罪不想睡觉的加尔恰先生自己…"
                }
              ]
            }
          ]
        },
        {
          "role": "路通",
          "text": "总之，就请您拿几枚徽印来吧，我会准备好报酬的。"
        },
        {
          "role": "加尔恰",
          "text": "拿来之后直接…直接给我就行，我要仔细看看，这次一定要把那根轴承做好…"
        },
        {
          "type": "subtitle",
          "text": "拿到盗宝团所携带的徽印，并带给加尔恰"
        },
        {
          "role": "加尔恰",
          "text": "您准是已经拿到那种徽印了，对吧？"
        },
        {
          "type": "subtitle",
          "text": "与加尔恰对话"
        },
        {
          "role": "加尔恰",
          "text": "非常感谢您，旅行者，这些徽印就足够了。"
        },
        {
          "role": "加尔恰",
          "text": "我得先去把齿轮重制…呃，不对，也许先要研究一下轴承问题…"
        },
        {
          "role": "路通",
          "text": "这是您的报酬，旅行者，请您收好。"
        },
        {
          "role": "路通",
          "text": "就现在的情况来看，咱们估计真的要长期合作了。"
        },
        {
          "role": "路通",
          "text": "唉，加尔恰先生的账目，梳理起来可真是难啊…"
        },
        {
          "role": "加尔恰",
          "text": "很好，这些徽印就够用了，我…呃！我的头又开始痛了…"
        },
        {
          "role": "路通",
          "text": "先生！您得先把这些药吃了！"
        },
        {
          "role": "路通",
          "text": "旅行者，这些报酬请你收下，我要先带着加尔恰先生回去了。"
        },
        {
          "role": "加尔恰",
          "text": "徽印！别忘了那些徽印，你得收好才行！"
        },
        {
          "role": "路通",
          "text": "我已经收好了先生，您放心吧。"
        },
        {
          "type": "subtitle",
          "text": "与加尔恰对话"
        },
        {
          "role": "加尔恰",
          "text": "喔！这几枚徽印的品质，看上去就不赖！"
        },
        {
          "role": "加尔恰",
          "text": "我得先去把齿轮重制…呃，不对，也许先要研究一下轴承问题…"
        },
        {
          "role": "路通",
          "text": "这是您的报酬，旅行者，请您收好。"
        },
        {
          "role": "路通",
          "text": "就现在的情况来看，咱们估计真的要长期合作了。"
        },
        {
          "role": "路通",
          "text": "唉，加尔恰先生的账目，梳理起来可真是难啊…"
        }
      ]
    }
  ]
