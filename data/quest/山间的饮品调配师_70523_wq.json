{
  "quest_id": 70523,
  "chapter_num": null,
  "chapter_title": "山间的饮品调配师",
  "type": "wq",
  "route": "Mountain Mixologist",
  "stories": [
    {
      "story_id": 70523,
      "title": "山间的饮品调配师",
      "description": "刚刚返回轻策庄不久的厨师关垂似乎在为兄弟们的解渴饮品发愁…",
      "dialogues": [
        {
          "role": "关垂",
          "text": "外地来的客人？欢迎来到轻策庄…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你好…",
            "请问你…"
          ]
        },
        {
          "role": "旅行者",
          "text": "你好…"
        },
        {
          "role": "派蒙",
          "text": "我先说我先说，我们先自我介绍！"
        },
        {
          "role": "派蒙",
          "text": "这是无所不能的旅行者旅行者，我是旅行者最好的伙伴派蒙。"
        },
        {
          "role": "派蒙",
          "text": "我们正在帮外地的客人订购佳酿节的特色饮品，看到了你的委托，所以就来直接和你商量了。"
        },
        {
          "role": "关垂",
          "text": "原来如此，真是爽快人！那我也不废话了。"
        },
        {
          "role": "关垂",
          "text": "我是厨师关垂，需要采购100箱「假日果酿」，用来兑茶水，给干体力活的兄弟们喝个痛快。"
        },
        {
          "role": "派蒙",
          "text": "好！那我们就开工了，请提供采购资金吧。"
        },
        {
          "role": "关垂",
          "text": "早就准备好了，请收下这些「佳酿晶冻」！下单后想必还会有盈余，不管还剩多少，都是两位劳苦功高的报酬！"
        },
        {
          "role": "派蒙",
          "text": "我们都收下了，待会儿就出发！"
        },
        {
          "role": "关垂",
          "text": "好极了！等着你们两位的好消息！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "好迅速的交流…",
            "派蒙也上道了…"
          ]
        },
        {
          "role": "旅行者",
          "text": "好迅速的交流…"
        },
        {
          "role": "派蒙",
          "text": "别愣着啦，旅行者，我们快走吧！"
        },
        {
          "role": "派蒙",
          "text": "有什么想说的，就等下单以后再来聊吧。"
        },
        {
          "role": "派蒙",
          "text": "早点搞定这些工作，我们就能早点开店啦！"
        },
        {
          "role": "派蒙",
          "text": "开店开店，嗯哼哼~"
        },
        {
          "role": "关垂",
          "text": "这次佳酿节的特色饮品，想来就和轻策庄的山泉茶水很般配！"
        },
        {
          "role": "关垂",
          "text": "有劳你们两位了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "关于你自己…",
            "关于茶水…",
            "我们去去就回。"
          ]
        },
        {
          "role": "旅行者",
          "text": "关于你自己…"
        },
        {
          "role": "关垂",
          "text": "我和几个兄弟搬回庄里还没多久。平时我负责给下地干活的兄弟们做点饭菜，送到田里去。"
        },
        {
          "role": "关垂",
          "text": "不过我做的大多是些简单管饱的菜式，拿出来招待外地的客人还是有点寒碜了…"
        },
        {
          "role": "关垂",
          "text": "轻策庄虽不热闹，但美食可一点都不少，你在庄里逛逛就能见识到了！"
        },
        {
          "role": "格奥尔格",
          "text": "哦！你们又来了？"
        },
        {
          "role": "格奥尔格",
          "text": "这次还是帮别国的客人下单吗？"
        },
        {
          "role": "派蒙",
          "text": "没错哦，这次我们需要100箱「假日果酿」，委托人是轻策庄的厨师关垂。"
        },
        {
          "role": "派蒙",
          "text": "我们准备好出价了，格奥尔格先生！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "怎么有种商业对决的感觉…",
            "请接招吧，格奥尔格先生！"
          ]
        },
        {
          "role": "旅行者",
          "text": "怎么有种商业对决的感觉…"
        },
        {
          "role": "格奥尔格",
          "text": "喔！气势很强嘛！那就让我看看你们这次的觉悟吧！"
        },
        {
          "role": "格奥尔格",
          "text": "好了，和上次一样，单据给你们，运输工作由我来安排。"
        },
        {
          "role": "格奥尔格",
          "text": "因为是新顾客，你们还是把单据交给他比较好，这样能让他安心。"
        },
        {
          "role": "派蒙",
          "text": "格奥尔格先生说得有道理，我们正有此意！"
        },
        {
          "role": "派蒙",
          "text": "走吧，旅行者，我们回轻策庄去交差。"
        },
        {
          "role": "派蒙",
          "text": "关垂先生，我们回来了！"
        },
        {
          "role": "派蒙",
          "text": "你需要的100箱「假日果酿」已经订好了，这是给你的单据，请收下。"
        },
        {
          "role": "关垂",
          "text": "好好好！两位真是帮大忙了！"
        },
        {
          "role": "关垂",
          "text": "我要好好研究一下「假日果酿」，把这种新鲜饮料和茶水按特定的比例混合，调出最好的口感，让兄弟们下地干活时更有干劲！"
        },
        {
          "role": "派蒙",
          "text": "呃，听起来有点像调酒，不过用茶水来兑…真的能做到吗？"
        },
        {
          "role": "关垂",
          "text": "放心吧，我以前在外边当过一段时间厨师。这种做法能在成本和口味之间取得最好的平衡，我已经调配过很多次了！"
        },
        {
          "role": "旅行者",
          "text": "有点想试试看…"
        },
        {
          "role": "关垂",
          "text": "下次你们来轻策庄玩的时候，我就用成品来招待你们。"
        },
        {
          "role": "派蒙",
          "text": "好哦！到时候就让旅行者先尝尝！"
        },
        {
          "role": "旅行者",
          "text": "加油啊，调配饮品的厨师！"
        },
        {
          "role": "关垂",
          "text": "谢谢你们！有空常来啊！"
        }
      ]
    }
  ]
}