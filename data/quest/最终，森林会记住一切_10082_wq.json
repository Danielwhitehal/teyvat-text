{
  "quest_id": 10082,
  "chapter_num": "森林书 第四章",
  "chapter_title": "最终，森林会记住一切",
  "type": "wq",
  "route": "In the End, the Forest Will Remember",
  "stories": [
    {
      "story_id": 73038,
      "title": "「你好」、「谢谢」；最后是「再见」",
      "description": "终于得到了惟耶之实。是时候回去找拉娜了。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与兰拉娜对话"
        },
        {
          "role": "兰拉娜",
          "text": "觉王树…奇怪。觉王树不应该在这里。金色的那菈、白毛飞飞…兰拉娜不认识。但是，有熟悉的感觉。你们是谁？"
        },
        {
          "role": "派蒙",
          "text": "兰拉娜，真的忘记了…"
        },
        {
          "role": "派蒙",
          "text": "我叫派蒙，他是旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们是兰拉娜的朋友。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰拉娜",
          "text": "嗯。兰拉娜相信你们。你们有善良的气味…"
        },
        {
          "role": "兰拉娜",
          "text": "兰拉娜明白了。本来，心里就像有一个洞一样，重要的记忆都溜走了。但是，看到觉王树、看到你们，又明白了很多。"
        },
        {
          "role": "兰拉娜",
          "text": "刚刚看到了，你们拿了「惟耶之实」吗？为了帮助朋友，所以兰拉娜忘记了很多，然后请觉王树结出了果子。"
        },
        {
          "role": "派蒙",
          "text": "兰拉娜很聪明呢…「朋友」的事情，你还记得吗？"
        },
        {
          "role": "兰拉娜",
          "text": "不记得。不过，没关系。既然惟耶之实在你们手中，你们一定也是兰拉娜相信的朋友，也是觉王树认可的那菈。"
        },
        {
          "role": "兰拉娜",
          "text": "拜托你们，把惟耶之实，带给兰拉娜需要帮助的朋友。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "兰拉娜，我们一起去吧！你的朋友，一定也想再见到你！"
                }
              ]
            },
            {
              "text": "我们一起去吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰拉娜",
          "text": "……"
        },
        {
          "role": "兰拉娜",
          "text": "兰拉娜不要。兰拉娜已经忘记了。如果朋友看到兰拉娜忘记了自己，那一定会伤心，觉得兰拉娜不爱惜朋友。"
        },
        {
          "role": "派蒙",
          "text": "兰拉娜想要帮助的那个朋友，她是很好的人…很好的那菈。就算兰拉娜不记得她了，她也愿意重新当你的朋友。"
        },
        {
          "role": "派蒙",
          "text": "所以，我们一起去，好吗？"
        },
        {
          "role": "兰拉娜",
          "text": "…嗯。"
        },
        {
          "role": "兰拉娜",
          "text": "知道了。兰拉娜相信你们，你们是朋友。"
        },
        {
          "type": "subtitle",
          "text": "返回拉娜身边"
        },
        {
          "role": "兰拉娜",
          "text": "这是，兰拉娜的兰迦拉梨…"
        },
        {
          "role": "兰拉娜",
          "text": "她就是，兰拉娜的那菈朋友吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯。那么，旅行者…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（使用惟耶之实。）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与拉娜对话"
        },
        {
          "role": "拉娜",
          "text": "呜…"
        },
        {
          "role": "派蒙",
          "text": "醒过来了吗…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听得到我说话吗？",
              "dialogues": []
            },
            {
              "text": "看上去没有大碍。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "拉娜",
          "text": "咦？我又睡着了吗…这里是？旅行者、派蒙，你们没事真是太好了！我好担心，你们有没有受到死域的伤害。还有…"
        },
        {
          "role": "拉娜",
          "text": "兰拉娜？是你吗，兰拉娜…"
        },
        {
          "role": "兰拉娜",
          "text": "你好，那菈朋友。"
        },
        {
          "role": "拉娜",
          "text": "我等了你好久好久…我做了一个好长、好长的梦，梦见我遇见你的时候了…"
        },
        {
          "role": "拉娜",
          "text": "我梦见，我在森林里迷路了，找不到家，也找不到爸爸妈妈。我一直哭。你听见哭声，就过来找我，唱歌给我听…"
        },
        {
          "role": "拉娜",
          "text": "后来，我们成为了最好的朋友。我经常到森林里找你玩。你送了一朵花给我，还教了我好多好多东西，很多森林的秘密。"
        },
        {
          "role": "拉娜",
          "text": "像是，星蕈是天上的星星落在地上的倒影。像是，见到月莲开放的话…"
        },
        {
          "role": "兰拉娜",
          "text": "见到月莲开放的话，到月亮再次升起为止都会变得幸运。"
        },
        {
          "role": "拉娜",
          "text": "没错！就是这个！然后，我梦见…"
        },
        {
          "role": "拉娜",
          "text": "我梦见，为了维摩庄的大家，我快快地长大，成了可靠的大人，成了巡林官。可靠的大人，是不相信森林中的精灵童话的。"
        },
        {
          "role": "拉娜",
          "text": "我梦见，我把你给忘了。我以为兰那罗的故事，都是优丹他们小孩子的童话。我梦见，森林不过是很多树的土地，并没有魔法…"
        },
        {
          "role": "拉娜",
          "text": "刚刚醒来的时候，我真的好害怕，我害怕要是我真的忘了你，那该怎么办才好…幸好只是做梦而已！能再见到你，我好高兴喔！"
        },
        {
          "role": "拉娜",
          "text": "兰拉娜，你到哪去了呀！我等了你好久好久，等你把我带到森林里去…和你一起时才有的，充满秘密的神奇的森林…"
        },
        {
          "role": "兰拉娜",
          "text": "对不起。兰拉娜不记得了。"
        },
        {
          "role": "拉娜",
          "text": "欸…？"
        },
        {
          "role": "派蒙",
          "text": "嗯…拉娜，你不要怪兰拉娜。事情是这样的…"
        },
        {
          "type": "subtitle",
          "text": "「…在寻找你的时候，我们遇到了兰拉娜。兰拉娜说…」",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "无郁稠林的菌冠、雨的尽头的战斗。遗迹巨像的内部，蔷薇中的小曲。扮演兄妹的兰那罗，无忧节的欢快景象…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "慢慢地将这些时日里，与兰那罗们一起的故事，告诉了拉娜与兰拉娜。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "拉娜",
          "text": "原来，忘记了的是我…"
        },
        {
          "role": "派蒙",
          "text": "惟耶之实是由记忆凝结成的…或许与你一起的记忆对兰拉娜而言太过珍贵，所以在治愈你的时候，让你也想起了以前的事呢…"
        },
        {
          "role": "拉娜",
          "text": "谢谢你们…旅行者、派蒙…为了帮助我，竟然经历了这么多辛苦的事情…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没关系，我们也收获了许多。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，是呀！而且，拉娜更应该感谢兰拉娜和兰罗摩才对…"
                }
              ]
            },
            {
              "text": "你应该感谢兰拉娜和兰罗摩。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "拉娜",
          "text": "谢谢…对不起，兰拉娜…"
        },
        {
          "role": "拉娜",
          "text": "呜呜…我竟然，把你给忘了…你一定很讨厌我吧…"
        },
        {
          "role": "兰拉娜",
          "text": "不知道。兰拉娜已经忘记了。"
        },
        {
          "role": "兰拉娜",
          "text": "但是，没关系。既然，以前还记得的兰拉娜，愿意放弃记忆，现在的兰拉娜就明白，你是最重要的那菈，比回忆更宝贵。"
        },
        {
          "role": "派蒙",
          "text": "嗯…不知道我这样说，对兰拉娜会不会不公平…"
        },
        {
          "role": "派蒙",
          "text": "兰拉迦他们说过，兰那罗的生命很漫长！我觉得，你们还可以一起去创造好多好多宝贵的回忆，就像我和旅行者那样！"
        },
        {
          "role": "拉娜",
          "text": "嗯，对喔…我们还有很长的时间，一起重新认识森林的大、世界的大、未来的无限。"
        },
        {
          "role": "兰拉娜",
          "text": "嗯。"
        },
        {
          "role": "拉娜",
          "text": "无留陀…死域的问题，在我沉睡的时候，也解决得差不多了。真的很感谢你们，旅行者、派蒙，还有许许多多的兰那罗…"
        },
        {
          "role": "拉娜",
          "text": "虽然这样有些任性，我想和兰拉娜一起去旅行。但是，我担心维摩庄的孩子们会再遇到危险…"
        },
        {
          "role": "派蒙",
          "text": "我都快忘了，还有坏人的问题没解决…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "坏人的身份，我已经有眉目了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "什么？是谁？呜哇，我怎么不知道…"
        },
        {
          "role": "拉娜",
          "text": "是喔！是谁干的？离开之前，我要狠狠地揍他们一顿！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "现在还没有实际根据…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "拉娜",
          "text": "是喔…"
        },
        {
          "role": "拉娜",
          "text": "我相信你，旅行者。"
        },
        {
          "role": "拉娜",
          "text": "虽然这么说很奇怪…我觉得啊，那个坏人，带来的也不全是坏事。如果不是孩子们走失，我就不会增加巡林的次数——"
        },
        {
          "role": "拉娜",
          "text": "如果没有增加巡林的次数，我就不会在那个时间、那个地点遇到蕈兽。而你和派蒙又正直、又善良，不会放着需要帮助的人不管…"
        },
        {
          "role": "拉娜",
          "text": "所以，我认识了旅行者和派蒙。你们帮了我好多好多，救了我，而且，还让我和宝贵的朋友再次相遇…"
        },
        {
          "role": "拉娜",
          "text": "谢谢你，旅行者。谢谢，派蒙。"
        },
        {
          "role": "派蒙",
          "text": "没关系啦！不过，「拉娜姐姐」要走，优丹、卡乌斯和素达蓓，会很难过吧…"
        },
        {
          "role": "拉娜",
          "text": "他们其实很坚强哦。而且，他们也认识了旅行者哥哥。再说，我又不是不回来了！"
        },
        {
          "role": "拉娜",
          "text": "我一定会回来，跟他们说好多好多故事，把兰拉娜介绍给他们认识，就像我把旅行者介绍给他们一样。"
        },
        {
          "role": "派蒙",
          "text": "是喔…那就好，我还怕你不会回来了…"
        },
        {
          "role": "拉娜",
          "text": "你愿意和我一起旅行吗，兰拉娜？"
        },
        {
          "role": "兰拉娜",
          "text": "兰拉娜愿意。"
        },
        {
          "role": "拉娜",
          "text": "你为了我，忘记了好多好多东西。不过，就像派蒙说的，我们可以一起创造好多好多回忆，把你心里空落落的部分重新填满。"
        },
        {
          "role": "拉娜",
          "text": "我叫拉娜，你愿意当我的朋友吗？"
        },
        {
          "role": "兰拉娜",
          "text": "嗯。那菈拉娜，我们以前是好朋友，以后也是。"
        },
        {
          "role": "派蒙",
          "text": "咦，这是…"
        },
        {
          "type": "subtitle",
          "text": "从拉娜的胸口，散发出如同心跳般温暖、细微而明亮的光芒。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "她试着用手遮挡、试探，光源却如同有意识一般钻进了她的手中。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "光芒慢慢褪去后，出现在她手中的是一枚精致的饰品。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "神之眼。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这种情况，还是第一次亲眼见到…"
        },
        {
          "role": "拉娜",
          "text": "这样的话，我的愿望，也得到神的许可了吧…"
        },
        {
          "role": "拉娜",
          "text": "哎呀，有了这个，旅行的时候就更不用担心了！就算遇到残留的死域，我也能解决了。希望我战斗的样子，也能像旅行者那么利落！"
        },
        {
          "role": "拉娜",
          "text": "要做的事情还有很多，要去跟大家打个招呼才行。还有提纳里前辈，要跟他说旅行的事情。"
        },
        {
          "role": "拉娜",
          "text": "谢谢你们，派蒙、兰拉娜。谢谢你，旅行者。"
        },
        {
          "role": "兰拉娜",
          "text": "谢谢，金色的那菈旅行者、派蒙。兰拉娜不记得了，但你们一定都很好。你们让兰拉娜认识了那菈拉娜，很开心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很高兴认识你们。",
              "dialogues": [
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "要注意安全。",
                      "dialogues": []
                    },
                    {
                      "text": "希望你在旅途中，收获许多。",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "拉娜，兰拉娜…祝你们路途顺利。而且，一定不要忘记我们！"
        },
        {
          "role": "拉娜",
          "text": "「不要输给风，不要输给雨。不输给冬雪，也不输给炎夏…」"
        },
        {
          "role": "拉娜",
          "text": "以前，我听过这么一首诗。等我们再见的时候，我一定要变得更加坚强。旅行者、派蒙，我们一定会再见的！"
        },
        {
          "role": "兰拉娜",
          "text": "我们一定会再见！"
        }
      ]
    }
  ]
}