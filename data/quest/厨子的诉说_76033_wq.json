{
  "quest_id": 76033,
  "chapter_num": null,
  "chapter_title": "厨子的诉说",
  "type": "wq",
  "route": "The Chef's Tale",
  "stories": [
    {
      "story_id": 76033,
      "title": "厨子的诉说",
      "description": "倾听幽灵的低语，找回他们的名字。",
      "dialogues": [
        {
          "role": "执着于食物的幽影",
          "text": "喂，新来的，菜不能这么做。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "我们做出来的食物要供给岛上执灯士，得以他们的口味为准。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "这些菜完全不行，一欠火候，二不符合我们的伙食标准，得改。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "你还得练，从我们挪德卡莱的本土菜做起吧，比如挪德卡莱热狗，做好了再拿给我看。"
        },
        {
          "type": "subtitle",
          "text": "用灯塔附近的奇特烹饪锅制作挪德卡莱热狗"
        },
        {
          "type": "subtitle",
          "text": "与执着于食物的幽影对话"
        },
        {
          "role": "执着于食物的幽影",
          "text": "嗯，热狗里的香肠烤得不错。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "如果你是在外面的餐厅工作，这个水平够你做帮厨了。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "但是！我们是要为岛上的所有执灯士供餐，重要的不是菜有多精致，重要的是够吃。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "面包做厚一点，现在的蔬菜种类太少，除了香肠之外，还可以放点别的肉类。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "你还得练，下次再来做浆果煎肉试试吧。"
        },
        {
          "type": "subtitle",
          "text": "过一段时间再前来寻找幽影"
        },
        {
          "type": "subtitle",
          "text": "用灯塔附近的奇特烹饪锅制作浆果煎肉"
        },
        {
          "type": "subtitle",
          "text": "与执着于食物的幽影对话"
        },
        {
          "role": "执着于食物的幽影",
          "text": "肉切得足够厚，厚切的同时煎得又很熟，不错。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "但是我要提醒你一点，做煎肉要注意配菜。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "本来肉吃多了就容易腻，所以才会放浆果。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "在岛上，我们负责管理所有人的饮食健康，一定要注意蔬菜和肉食的平衡搭配。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "这盘煎肉里的配菜放得太少了，这点很不好，不够周全。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "你还得练，下次再来做白灵果酿鸡试试吧。"
        },
        {
          "type": "subtitle",
          "text": "过一段时间再前来寻找幽影"
        },
        {
          "type": "subtitle",
          "text": "用灯塔附近的奇特烹饪锅制作白灵果酿鸡"
        },
        {
          "type": "subtitle",
          "text": "与执着于食物的幽影对话"
        },
        {
          "role": "执着于食物的幽影",
          "text": "鸡肉足够入味，配菜量也放得够多，你这样我很难挑毛病啊。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "算了，本来就不是为了难为人才盯着你们这些新人的。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "我只是个厨子，做好厨子该做的事就行。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "就算狂猎真的来了，我也做好了准备。"
        },
        {
          "role": "执着于食物的幽影",
          "text": "只是可惜，来不及把做好的菜送给他们了…饭菜都洒了…洒了…"
        }
      ]
    }
  ]
}