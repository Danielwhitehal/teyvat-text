{
  "quest_id": 74141,
  "chapter_num": null,
  "chapter_title": "追寻",
  "type": "wq",
  "route": "Pursuit",
  "stories": [
    {
      "story_id": 74141,
      "title": "追寻·其一",
      "description": "决定进入「冥想」的世界，寻找夏诺蒂拉。",
      "dialogues": [
        {
          "role": "「揭示之书」",
          "text": "（书页上的内容依旧是由无法理解的图形、字母与古语，以及几何图形构成。但集中精神后，似乎能渐渐理解其中的内容了。）"
        },
        {
          "role": "派蒙",
          "text": "夏诺蒂拉好像不在呢，可能又到那个神秘的地方去了！要进行「冥想」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听了她上次说的话…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有点在意。我要去看看。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…虽然有点不安，不过我们一起去吧！夏诺蒂拉真是让人担心呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，你在外面等我就好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「揭示之书」的世界…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可能比想象中更危险。",
              "dialogues": []
            },
            {
              "text": "可能有我们不知道的一面。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以，我不希望你冒险。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "但是…但是，一直以来我们不是一起冒险的吗？我们在一起，就没有克服不了的困难、战胜不了的敌人才对…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "里面的危险可能不是战斗能解决的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "好吧！哼，你比我聪明多了，我相信你。那你可别抛下我喔！我会一直等你回来的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我一定会回来的。",
              "dialogues": [
                {
                  "role": "「揭示之书」",
                  "text": "（书页边缘渐渐变得模糊。无比陌生而又无比亲切的世界闯入了视野。在这里…）"
                }
              ]
            },
            {
              "text": "我先准备一下…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好喔！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "通过揭示之书进入「冥想」的世界",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "（若选择“我先准备一下…”）与「揭示之书」交互"
        },
        {
          "role": "「揭示之书」",
          "text": "（书页上的内容依旧是由无法理解的图形、字母与古语，以及几何图形构成。但集中精神后，似乎能渐渐理解其中的内容了。）"
        },
        {
          "role": "派蒙",
          "text": "要进行「冥想」吗？要注意安全喔…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯。",
              "dialogues": [
                {
                  "role": "阅读",
                  "text": "（书页边缘渐渐变得模糊。无比陌生而又无比亲切的世界闯入了视野。在这里…）"
                }
              ]
            },
            {
              "text": "暂时算了。",
              "dialogues": [
                {
                  "role": "阅读",
                  "text": "……"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "通过揭示之书进入「冥想」的世界",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "追寻人影"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（不是之前「冥想」抵达的地方。那边是…）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "（与遗落的花束交互）获得遗落的花束",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "额外对话（卡特皮拉）"
        },
        {
          "role": "卡特皮拉",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "卡特皮拉。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（看来听不到。）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "折叠内容"
        },
        {
          "type": "subtitle",
          "text": "与人影对话"
        },
        {
          "role": "卡特皮拉",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "卡特皮拉。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "谁？"
        },
        {
          "role": "卡特皮拉",
          "text": "…原来是你啊。我记得你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你怎么会在这里？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "被你抢先了。我也想问你这个问题呢。"
        },
        {
          "role": "卡特皮拉",
          "text": "没什么，我只是觉得…"
        },
        {
          "role": "卡特皮拉",
          "text": "你是[玩家]，对吧？你身边那个白色的小东西…叫什么名字来着？她怎么没和你一起？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙在外面等我。",
              "dialogues": [
                {
                  "role": "卡特皮拉",
                  "text": "是叫这个名字吗？算了，没所谓了。你是好人，派蒙也是好人。"
                }
              ]
            },
            {
              "text": "你还好吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "我来这里，是要找一个很重要的东西。你知道我要找的是什么吗？"
        },
        {
          "role": "卡特皮拉",
          "text": "算了，就当我没问吧。你怎么会在这里？快点离开。这里很危险，以前有人来这里接受试炼，结果迷失了，脑子变成了浆糊…"
        },
        {
          "role": "卡特皮拉",
          "text": "我想起来了，我和你，我们曾经做过很厉害的事情。那是我的一生中唯一值得骄傲的事情…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是说…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "战胜纳齐森克鲁兹？",
              "dialogues": []
            },
            {
              "text": "拯救莉诺尔？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "啊，金色的蝴蝶。像阳光一样耀眼的颜色。"
        },
        {
          "role": "卡特皮拉",
          "text": "只要得到了那样的光，一切都会…一切都会…"
        },
        {
          "type": "subtitle",
          "text": "追寻光芒"
        },
        {
          "type": "subtitle",
          "text": "与人影对话"
        },
        {
          "role": "卡特皮拉",
          "text": "…是吗，那就好说了。你叫什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "卡特皮拉。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "[玩家]，没想到会在这里遇到你。派蒙没在你身边吗？"
        },
        {
          "role": "卡特皮拉",
          "text": "等等，你该不会也是什么怪物，变成我认识的人的样子来戏弄我的吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们不久前才见过。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "…是这样吗？自从和你告别，感觉已经过了很久了。算了，可能是年纪大了吧，我能记得的事情越来越少。"
        },
        {
          "role": "卡特皮拉",
          "text": "…你真的不是什么怪物吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还记得吗？",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于巨人的花园的事情。",
              "dialogues": []
            },
            {
              "text": "关于学徒与小鱼的事情。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "我记得。我记得。你真的是你。"
        },
        {
          "role": "卡特皮拉",
          "text": "抱歉，我在这里遇到了太多不可思议的事情，也经过了许多无法取胜的战斗。"
        },
        {
          "role": "卡特皮拉",
          "text": "但这里终于发生了变化。金色的光芒已经升起，向日葵已经开放。也许就算是古人臆想的宇宙也会发生变化。"
        },
        {
          "role": "卡特皮拉",
          "text": "也许一切都会变好。也许我也能够理解，然后放下。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "卡特皮拉…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "跟我一起走吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "哈哈哈，看来真的是你。我想起来了，我曾经认识的你，就算到现在也没有变。你总是多管闲事，这是因为你正直而善良。"
        },
        {
          "role": "卡特皮拉",
          "text": "但你不用担心我。我不需要帮助。你也见识过我的身手。"
        },
        {
          "role": "卡特皮拉",
          "text": "况且，对于这里的事情，或许我比你懂的还多呢。"
        },
        {
          "role": "「小狗」",
          "text": "丘丘人，帮我告诉那位少年，请他赶紧离开。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你有话对我说吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「小狗」",
          "text": "…你能听懂我说的话？嗯，那我问你。在你眼里，我是什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "狗。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「小狗」",
          "text": "这样啊…那还来得及。"
        },
        {
          "role": "「小狗」",
          "text": "这也是为了你好。离开这里吧，少年。"
        },
        {
          "role": "卡特皮拉",
          "text": "我同意。[玩家]，你属于更光明的世界。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还有问题…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「小狗」",
          "text": "你不应该有。再见。不要再回来了。"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "呜哇！你回来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我离开了多久？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔，也就一眨眼的事情…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "如果对你来说只是一眨眼的话…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "怎么了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没什么。这里面确实很危险。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是喔…"
        },
        {
          "role": "派蒙",
          "text": "这么说来，夏诺蒂拉怎么还没回来呀？该不会到枫丹廷里当警卫去了吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…下次再来吧。我头有点晕。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是喔。那一起去找点东西吃吧？你害得我都担心得饿了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不是才过了一眨眼的时间？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我可是很用力很用力地担心你！"
        }
      ],
      "collapse_ranges": [
        [
          24,
