{
  "quest_id": 10172,
  "chapter_num": "炼金与经营 其三",
  "chapter_title": "远销各国",
  "type": "eq",
  "route": "International Markets",
  "stories": [
    {
      "story_id": 40146,
      "title": "远销各国",
      "description": "似乎有其他国家的商人来到了你的店铺…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至两天后"
        },
        {
          "type": "subtitle",
          "text": "返回店铺"
        },
        {
          "type": "subtitle",
          "text": "又过了一段时间，炼金店铺的经营规模越来越大，你也即将迎来全新的商机…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "似乎有其他国家的商人过来了，我们去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "与商人对话"
        },
        {
          "role": "阿泰菲",
          "text": "你们好呀，我是来自须弥的旅行商人阿泰菲，很高兴认识你们！"
        },
        {
          "role": "派蒙",
          "text": "哇，居然从这么远的地方过来吗，不知不觉，我们的店铺名气已经这么大了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "多亏了派蒙。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼哼，现在在你面前的，正是冉冉升起的销售之星，派蒙！"
                }
              ]
            },
            {
              "text": "这段时间的努力有成果了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿泰菲",
          "text": "啊哈哈，最近确实有不少消息灵通的商人听说了你们在售卖的炼金药剂呢。"
        },
        {
          "role": "阿泰菲",
          "text": "这种不太常见的商品，大部分人还是不太敢冒险。"
        },
        {
          "role": "阿泰菲",
          "text": "但在我看来，要想赚大钱，就得抢占商机！"
        },
        {
          "role": "阿泰菲",
          "text": "虽然现在普通人对炼金药剂的了解程度还不是很高，但只要配合销售手段，一旦打开了市场，那可就是赚不完的摩拉了！"
        },
        {
          "role": "阿泰菲",
          "text": "如果能打响名号，说不定售价能翻十倍…嘿嘿，干完这一票，就能休息到年底了。"
        },
        {
          "role": "派蒙",
          "text": "十倍！你是认真的吗？"
        },
        {
          "role": "阿泰菲",
          "text": "哼哼，只要有人愿意买，不管价格卖多高都是合理的。所谓你情我愿嘛。"
        },
        {
          "role": "派蒙",
          "text": "这个说辞，让我想起了某个满脑子都是摩拉的家伙…"
        },
        {
          "role": "派蒙",
          "text": "我说，既然你来自须弥，该不会凑巧认识多莉吧？"
        },
        {
          "role": "阿泰菲",
          "text": "多莉？难道你说的是多莉·桑歌马哈巴依老爷？你们居然认识这位大人物吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她是我的朋友。",
              "dialogues": []
            },
            {
              "text": "以前打过交道。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿泰菲",
          "text": "好厉害！桑歌马哈巴依老爷是我的偶像，她的商业嗅觉和对摩拉的执着一直激励着我！"
        },
        {
          "role": "阿泰菲",
          "text": "我曾经有幸拜访过卡萨扎莱宫，真是气派又美丽的宅邸啊。"
        },
        {
          "role": "阿泰菲",
          "text": "总有一天，我也想像她一样，拥有数都数不完的摩拉，嘿嘿…"
        },
        {
          "role": "派蒙",
          "text": "呃…她已经彻底沉浸在梦里了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "祝你成功。",
              "dialogues": [
                {
                  "role": "阿泰菲",
                  "text": "谢谢你的祝福！"
                }
              ]
            },
            {
              "text": "还是聊正事吧。",
              "dialogues": [
                {
                  "role": "阿泰菲",
                  "text": "咳咳，一下子扯远了。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿泰菲",
          "text": "那么，我们来聊聊一起赚大钱的方法吧。"
        },
        {
          "role": "阿泰菲",
          "text": "其实很简单，我定期来向你进货，你生产出需要的药剂，然后我就能帮你卖到其他地方啦！"
        },
        {
          "role": "阿泰菲",
          "text": "如果决定合作的话，就来具体谈谈这批要出售的药剂吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "查看药剂需求。",
              "dialogues": [
                {
                  "role": "阿泰菲",
                  "text": "根据我敏锐的市场嗅觉，这次需要的药剂是这样的。"
                }
              ]
            },
            {
              "text": "以后再说吧。",
              "dialogues": [
                {
                  "role": "阿泰菲",
                  "text": "赚钱的机会可是稍纵即逝的呀。"
                },
                {
                  "type": "subtitle",
                  "text": "再次对话",
                  "narration": true,
                  "color": "灰"
                },
                {
                  "role": "阿泰菲",
                  "text": "怎么样，准备好跟我一起赚更多的摩拉了吗？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "查看药剂需求。",
                      "dialogues": [
                        {
                          "role": "阿泰菲",
                          "text": "根据我敏锐的市场嗅觉，这次需要的药剂是这样的。"
                        }
                      ]
                    },
                    {
                      "text": "以后再说吧。",
                      "dialogues": [
                        {
                          "role": "阿泰菲",
                          "text": "赚钱的机会可是稍纵即逝的呀。"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "阿泰菲清点完药剂，背起行囊离开了…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "她将在一个经营周期后返回店铺并带来销售结果。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "额外对话（丽莎）"
        },
        {
          "role": "丽莎",
          "text": "哎呀，小可爱的生意越做越大了哦？"
        },
        {
          "role": "丽莎",
          "text": "把店铺交给你来经营，果然是正确的选择。"
        },
        {
          "role": "丽莎",
          "text": "要是累了，可以坐下来喝杯茶，休息一会哦。"
        },
        {
          "role": "阿泰菲",
          "text": "你们好呀，上次的药剂已经顺利卖出了。"
        },
        {
          "role": "阿泰菲",
          "text": "销售数据帮你们整理好了，可以看看哦。"
        },
        {
          "type": "subtitle",
          "text": "显示分销财报・须弥",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "阿泰菲",
          "text": "话不多说，来谈谈这次的交易吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "查看药剂需求。",
              "dialogues": [
                {
                  "role": "阿泰菲",
                  "text": "根据我敏锐的市场嗅觉，这次需要的药剂是这样的。"
                }
              ]
            },
            {
              "text": "以后再说吧。",
              "dialogues": [
                {
                  "role": "阿泰菲",
                  "text": "赚钱的机会可是稍纵即逝的呀。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "在{{图标|芙里达}}处购买'''{{颜色|橙|经销拓展合同}}'''",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "初次"
        },
        {
          "role": "德佑",
          "text": "你们好啊。我是来自璃月的商人德佑。"
        },
        {
          "role": "派蒙",
          "text": "哦，你也是来采购药剂的吗？"
        },
        {
          "role": "德佑",
          "text": "是的，看你们店铺生意蛮好的，这次应该能大卖吧…一定能大卖的吧…"
        },
        {
          "role": "派蒙",
          "text": "怎么听起来这么没信心…"
        },
        {
          "role": "派蒙",
          "text": "我们的药剂可畅销了，订单源源不断，都要做不过来了！"
        },
        {
          "role": "德佑",
          "text": "抱歉，我不是怀疑你们的销量…"
        },
        {
          "role": "德佑",
          "text": "只是我的买卖一直不太顺利，每次买入热销产品，还没卖出去呢，同行就纷纷降价，结果就是十次买卖九次亏。"
        },
        {
          "role": "德佑",
          "text": "每次我都相信只是运气不好，但是如果一直运气不好，是不是说明，我就不适合经商呢…"
        },
        {
          "role": "德佑",
          "text": "如果这次再不赚钱，我就准备回家，给老爹干活了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可能是商品选得不对。",
              "dialogues": []
            },
            {
              "text": "也许销售策略有问题。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "德佑",
          "text": "是这样的吗，我还有很多要学习的地方啊。"
        },
        {
          "role": "德佑",
          "text": "嗯，一直消沉下去也不是办法，这次一定要赚到钱，让老爹刮目相看…"
        },
        {
          "role": "德佑",
          "text": "好，我们来商量一下合作的事宜吧。"
        },
        {
          "type": "subtitle",
          "text": "再次"
        },
        {
          "role": "德佑",
          "text": "我们来商量一下合作的事宜吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "查看药剂需求。",
              "dialogues": [
                {
                  "role": "德佑",
                  "text": "这次我打算收购这几种药剂。"
                }
              ]
            },
            {
              "text": "以后再说吧。",
              "dialogues": [
                {
                  "role": "德佑",
                  "text": "没关系，谨慎一些也好。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "德佑再三确认药剂已经打包牢固之后，提着包裹离开了。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "他将在一个经营周期后返回店铺并带来销售结果。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "德佑",
          "text": "上次那批药剂已经卖出了。"
        },
        {
          "role": "德佑",
          "text": "这是销售情况…"
        },
        {
          "type": "subtitle",
          "text": "显示分销财报・璃月",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "德佑",
          "text": "之后也请多多提携了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "查看药剂需求。",
              "dialogues": [
                {
                  "role": "德佑",
                  "text": "这次我打算收购这几种药剂。"
                }
              ]
            },
            {
              "text": "以后再说吧。",
              "dialogues": [
                {
                  "role": "德佑",
                  "text": "没关系，谨慎一些也好。"
                }
              ]
            }
          ]
        }
      ],
