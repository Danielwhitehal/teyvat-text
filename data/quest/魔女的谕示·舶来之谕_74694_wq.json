{
  "quest_id": 74694,
  "chapter_num": null,
  "chapter_title": "魔女的谕示·舶来之谕",
  "type": "wq",
  "route": "Witch's Revelation: Voyaging Instruction",
  "stories": [
    {
      "story_id": 74694,
      "title": "魔女的谕示·舶来之谕",
      "description": "在芭比洛斯的占卜摊前，你遇见了北斗…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与北斗对话"
        },
        {
          "role": "北斗",
          "text": "那这么说来，我抽到的这张牌还算得上是一张好牌啊。"
        },
        {
          "role": "芭比洛斯",
          "text": "呵呵，命运就只是命运，从来都不分什么好坏。"
        },
        {
          "role": "芭比洛斯",
          "text": "不过，单单从你抽到的这张正位「力量」来说，其中的一层含义，倒是很适合你的职业。"
        },
        {
          "role": "芭比洛斯",
          "text": "这张牌象征热情、勇气、自信与渴望，也象征完美的、不迷失的爱。"
        },
        {
          "role": "芭比洛斯",
          "text": "无论面对何种突发事态，想必你都一定能主导并掌控局面吧。"
        },
        {
          "role": "北斗",
          "text": "哈哈哈哈哈哈，您别夸了，按照我们的规矩，抽到了好卦，要多多的给卦钱。"
        },
        {
          "role": "北斗",
          "text": "喏，我把钱袋子放桌上了，要是您有空，不如帮我们船上的兄弟都看看？"
        },
        {
          "role": "芭比洛斯",
          "text": "呵，我还是第一次听到这种请求。"
        },
        {
          "role": "北斗",
          "text": "我这一船的兄弟走南闯北，风里来浪里去的，这么多年了，每个人都揣着一肚子的难题。"
        },
        {
          "role": "北斗",
          "text": "我虽然是他们的老大，但有些问题，我也没办法帮他们解决。"
        },
        {
          "role": "北斗",
          "text": "如今遇见了您这么一位卦师，才想着请您去船上，帮他们多少开导一下心结。"
        },
        {
          "role": "北斗",
          "text": "报酬的话好说，反正我们这一趟过来，也做了几笔大生意，赚了不少…"
        },
        {
          "role": "芭比洛斯",
          "text": "虽然听着很有趣，但还是免了。我这个牌盒里，可没有那么多牌。"
        },
        {
          "role": "北斗",
          "text": "咦，旅行者，派蒙？真是好久不见，你们也来这里算卦么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "算、算卦…",
              "dialogues": []
            },
            {
              "text": "北斗怎么来枫丹了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "北斗",
          "text": "当然是来做生意的，顺便来帮某人查探一下新生意的商路。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这个某人…",
              "dialogues": []
            },
            {
              "text": "应该就是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "北斗",
          "text": "还能有谁，当然是咱们的天权星大人了。"
        },
        {
          "role": "北斗",
          "text": "这女人不知道又想出了什么鬼主意，前几天突然告诉我，枫丹有好生意可以做。"
        },
        {
          "role": "北斗",
          "text": "还没等我说什么，她就摸出了一张详尽的计划表，让我按着上面的商路走就好，她已经派人过去查探过了。"
        },
        {
          "role": "北斗",
          "text": "最近正好也没什么急生意，我就按着她说的来了，结果一来之后，所有事情都办得无比顺利。"
        },
        {
          "role": "北斗",
          "text": "本来准备忙活半个月的事，一个多星期就办好了…"
        },
        {
          "role": "北斗",
          "text": "我想着来都来了，就干脆在这里再玩一会吧，就给兄弟们放了个假，让他们也去放松放松。"
        },
        {
          "role": "北斗",
          "text": "这不，昨天刚在德波大饭店包了个场子，和兄弟们好好喝了一场。"
        },
        {
          "role": "北斗",
          "text": "他们现在还在旅馆里睡着呢，我一个人出来吹风醒醒酒。"
        },
        {
          "role": "北斗",
          "text": "不过嘛，刚走几步，就被这位…呃，卦师给叫住了，请我去抽一张牌…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你已经抽好了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "北斗",
          "text": "喏，就是这张「力量」牌…看着是一张好牌，因为是正着摆的，所以更是好上加好？"
        },
        {
          "role": "派蒙",
          "text": "正位的「力量」…怎么说呢，感觉上确实很像北斗呢。"
        },
        {
          "role": "芭比洛斯",
          "text": "确实。那么，我接下来要说其中所蕴含的另外一层意义了…"
        },
        {
          "role": "北斗",
          "text": "难不成，还有什么坏消息？"
        },
        {
          "role": "芭比洛斯",
          "text": "谈不上好坏，和占卜…呵呵，也没有直接的关系，就当做是占卜结束后的一点「课余奇思」吧。"
        },
        {
          "role": "芭比洛斯",
          "text": "无论是从外在的力量，还是内在的心灵来说，你都的确是一位强大的人。"
        },
        {
          "role": "芭比洛斯",
          "text": "要打比方的话，你就像是在黑夜中的一盏灯火。你会驱散黑暗，会为迷失道路的众人指引前行的道路。"
        },
        {
          "role": "芭比洛斯",
          "text": "但你要知道，会被灯火吸引的，不只有迷路的弱者，还有趋光而行的虫孑。它们会依附在灯罩上，争夺光与热。"
        },
        {
          "role": "芭比洛斯",
          "text": "灯火自信能够同样温暖它们，于是便要燃烧得更彻底。只有这样，光芒才不会变得黯淡。"
        },
        {
          "role": "芭比洛斯",
          "text": "若是有人能将这些跗骨的虫孑驱赶走，倒还好说…"
        },
        {
          "role": "芭比洛斯",
          "text": "但若是没有的话，也许终有一天，灯火也会为不值得的虫孑，燃尽自己的余薪。"
        },
        {
          "role": "北斗",
          "text": "…但这么想来，这个倒是不成问题。"
        },
        {
          "role": "北斗",
          "text": "我有一个朋友，她向来很擅长替人解惑，而且…哈哈哈，也经常亲手驱除那些藏在角落里的虫蝇鼠蚁。"
        },
        {
          "role": "芭比洛斯",
          "text": "那还真是难得。听你的语气，你应该很信任那位朋友，而她也不像是会迷失道路的人。"
        },
        {
          "role": "北斗",
          "text": "她？哈哈哈，要是她是迷路者，那整个璃月就没几个认路的人了。"
        },
        {
          "role": "北斗",
          "text": "就好比这一趟，就是她给我指的…"
        },
        {
          "role": "北斗",
          "text": "……"
        },
        {
          "role": "北斗",
          "text": "哈，怪不得。我还说呢，要是那女人真心想做笔大买卖，哪还能容我在这里优哉游哉。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "该说不愧是天权星吗？",
              "dialogues": []
            },
            {
              "text": "放假也放得这么有说法…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿嘿，简单来说，原来是凝光想要给北斗放假呀，可是，她为什么要绕这么大一个圈子呢？"
        },
        {
          "role": "北斗",
          "text": "那女人肯定会这么说：「有些圈子必须要绕，只有绕了，才能抄到近路。」"
        },
        {
          "role": "北斗",
          "text": "她脑子里的弯弯绕，我可弄不明白。呵…反正她还指着我帮她拓宽商路呢，总不会害我。"
        },
        {
          "role": "北斗",
          "text": "我这张「力量」牌，就好好地在前面劈波斩浪，勇往直前就是了。"
        },
        {
          "role": "北斗",
          "text": "…哎哟！怎么都这个点了，我得回去看看那群家伙，顺便让他们醒醒酒，为出航做准备了。"
        },
        {
          "role": "北斗",
          "text": "旅行者，派蒙，还有这位算卦的女士，之后有机会再见啊！"
        },
        {
          "role": "北斗",
          "text": "…这张牌也算是稀罕物了…能送出去么？应该不能吧…唔…看看应该还行…"
        },
        {
          "role": "芭比洛斯",
          "text": "庇引迷途之人的光辉…和不为光辉而来之人。"
        },
        {
          "role": "芭比洛斯",
          "text": "有意思，要是有空的话，就再去璃月看看吧…"
        },
        {
          "type": "subtitle",
          "text": "聆听北斗的故事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "聆听故事…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "完成北斗的故事"
        },
        {
          "type": "subtitle",
          "text": "击败8只怪物"
        },
        {
          "type": "subtitle",
          "text": "解锁额外天赋「魔女的谕示·引路明星」",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}