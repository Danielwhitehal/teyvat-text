{
  "quest_id": 73319,
  "chapter_num": null,
  "chapter_title": "浮光鸣召",
  "type": "wq",
  "route": "Lightcall Resonance",
  "stories": [
    {
      "story_id": 73319,
      "title": "浮光鸣召",
      "description": "在「荼泥黑渊」一带，你、派蒙和斯露莎遇见了一位举止古怪的花灵，她似乎正在筹备某种独特的「试炼」…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与古怪的花灵对话"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦啦，啊啦啦~更难更远更弯绕，吓跑所有喽啰~"
        },
        {
          "role": "斯露莎",
          "text": "这不是贾尔贾吗？这么多年过去了，你还是沉浸在自己的世界里啊。"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦？居然是…斯露莎…大人？"
        },
        {
          "role": "派蒙",
          "text": "咦？斯露莎认识这位花灵吗？"
        },
        {
          "role": "斯露莎",
          "text": "很久以前见过一次，不算熟悉，但对她的事迹有所耳闻。"
        },
        {
          "role": "斯露莎",
          "text": "贾尔贾的古怪性格，在花灵之中也比较出名。"
        },
        {
          "role": "斯露莎",
          "text": "整天用不知从哪找来的东西，捣鼓着不知所谓的「挑战」…大部分花灵都绕着她走。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "到底搞出过什么名堂…",
              "dialogues": []
            },
            {
              "text": "斯露莎都觉得古怪…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "喂，斯露莎，你这样当面评价人家，真的好吗？"
        },
        {
          "role": "派蒙",
          "text": "你都说和她不熟了，传闻毕竟是传闻，也许人家现在变了呢？"
        },
        {
          "role": "派蒙",
          "text": "看她一副干劲满满的样子，说不定现在要做的事就对花灵有好处！"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦啦，没关系，毕竟斯露莎大人最受祖尔宛大人器重，肩负无上的伟业。"
        },
        {
          "role": "贾尔贾",
          "text": "也许有朝一日，斯露莎大人的功名能与神鸟「西摩格」平齐，看不上我这种平庸之辈，也是理所当然的事。"
        },
        {
          "role": "贾尔贾",
          "text": "能被斯露莎大人亲口评价，已经是我的荣幸了。"
        },
        {
          "role": "斯露莎",
          "text": "呜哇！那、那都是过去的事了，过去的事就不必再提了！"
        },
        {
          "role": "贾尔贾",
          "text": "可是…可是，吾辈花灵应当牢记过去发生的事…"
        },
        {
          "role": "斯露莎",
          "text": "咳！过去我疏于同花灵同伴的交往，走了一些…对了，一些远路！所以就别提我了，不如你来说说你自己的事吧。"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦啦，如您所见，我正在筹备「浮光鸣召」，用来拦阻「矫论团」的喽啰。"
        },
        {
          "role": "贾尔贾",
          "text": "他们居然打出和我交朋友的旗号，追着我不停提问，想从我这里讨要一些人类根本学不会的门道，实在太烦了…"
        },
        {
          "role": "旅行者",
          "text": "「矫论团」会做这种事？"
        },
        {
          "role": "派蒙",
          "text": "说不定是那先朱那的手下，毕竟斯露莎也被他欺骗过呢。"
        },
        {
          "role": "贾尔贾",
          "text": "不知道你说的是谁，也无所谓了，反正「浮光鸣召」会让他们知难而退。"
        },
        {
          "role": "贾尔贾",
          "text": "我和他们明确说过，无法通过「浮光鸣召」之人，皆是愚钝孱弱之徒，不配向我发问。"
        },
        {
          "role": "派蒙",
          "text": "听你的描述，这个什么「浮光鸣召」好像是一种试炼？"
        },
        {
          "role": "派蒙",
          "text": "是要考验战斗的效率呢，还是赶路的速度？"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦啦，答案是后者。你们很懂行，这么快就猜到了！"
        },
        {
          "role": "贾尔贾",
          "text": "在有限的时间内收集特定的物品，尽快赶到终点…这是人类最能理解的试炼形式。"
        },
        {
          "role": "贾尔贾",
          "text": "你们有兴趣吗？不如，就由你们来试试它的难度吧？"
        },
        {
          "role": "斯露莎",
          "text": "不行！旅行者可是吾之「谒颂主」，哪有随随便便就来帮你的道理！"
        },
        {
          "role": "贾尔贾",
          "text": "正是因为他有幸成为了斯露莎大人的「谒颂主」，才非他不可。"
        },
        {
          "role": "贾尔贾",
          "text": "伟大花灵斯露莎大人的「谒颂主」，也是人类当中的翘楚。「浮光鸣召」若是能得到他的认可，无异于最高的荣耀。"
        },
        {
          "role": "贾尔贾",
          "text": "若是之后，「浮光鸣召」成为了选拔人类勇者的重要仪式，这功名也要归于斯露莎大人。"
        },
        {
          "role": "贾尔贾",
          "text": "只需占用斯露莎大人和这位「谒颂主」一点时间，就能再添几重功名，难道不是一件美事吗？"
        },
        {
          "role": "斯露莎",
          "text": "真的…是这样吗？"
        },
        {
          "role": "斯露莎",
          "text": "咳！我当然预料到了！我只是不想…不想旅行者白白奔走！"
        },
        {
          "role": "贾尔贾",
          "text": "「矫论团」的喽啰们曾向我献上一些财物，于我无用，不如就作为「谒颂主」和白仙灵的酬劳好了。"
        },
        {
          "role": "派蒙",
          "text": "财物！财宝！"
        },
        {
          "role": "派蒙",
          "text": "你看，斯露莎，话都说到这份上了，我们就帮帮贾尔贾吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "反正只是速度挑战…",
              "dialogues": []
            },
            {
              "text": "随随便便就能搞定…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯露莎",
          "text": "财宝什么的，我倒是无所谓啊。"
        },
        {
          "role": "斯露莎",
          "text": "不过，看在你们有兴趣的份上…就答应贾尔贾好了。动作要麻利一点！"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦啦，真爽快，看来斯露莎大人的「谒颂主」有着充足的经验和信心呢。"
        },
        {
          "role": "贾尔贾",
          "text": "这里就布置着「浮光鸣召」的第一重试炼，最简单的一环。等到你们准备好了，我们就开始吧。"
        },
        {
          "type": "subtitle",
          "text": "与贾尔贾对话，开始试炼"
        },
        {
          "role": "贾尔贾",
          "text": "怎么样，还需要什么准备吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "现在就开始吧！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯！我们也不是新手了，随时都能拿出最好的表现！"
                },
                {
                  "role": "斯露莎",
                  "text": "只是拦阻矫论团的考验，于我和旅行者而言，无需如临大敌。"
                },
                {
                  "role": "贾尔贾",
                  "text": "啊啦啦！真不愧是你们，好强的气势！"
                },
                {
                  "role": "贾尔贾",
                  "text": "请向我展示你们的英姿吧！"
                }
              ]
            },
            {
              "text": "先等等，晚点再开始。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "咦？你状态不好吗？是不是要吃点东西补充下体力？"
                },
                {
                  "role": "斯露莎",
                  "text": "旅行者做事一直很谨慎，肯定有他的考量。"
                },
                {
                  "role": "贾尔贾",
                  "text": "原来如此…请尽管调整状态吧，我随时在这里等着你们！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "完成第一试炼"
        },
        {
          "role": "斯露莎",
          "text": "这里的通道只有花灵才能打开，难怪贾尔贾说没有「矫论团」的人能通过…"
        },
        {
          "role": "斯露莎",
          "text": "当然，对我和旅行者的组合来说，就是小菜一碟了！"
        },
        {
          "role": "派蒙",
          "text": "应该说是我们三个的组合哦！"
        },
        {
          "type": "subtitle",
          "text": "回到了贾尔贾的身边。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与贾尔贾对话"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦啦，不愧是斯露莎大人和「谒颂主」，居然一开始就轻轻松松通过了！"
        },
        {
          "role": "贾尔贾",
          "text": "不过，这只是开始而已…"
        },
        {
          "role": "贾尔贾",
          "text": "我还要调整第二环试炼的布局，请你们稍等一天，直接去下个地点找我吧，我大概给你们指示一下方位…"
        },
        {
          "role": "派蒙",
          "text": "居然要一天吗？你是不是看我们太强了，要临时提高难度…"
        },
        {
          "role": "斯露莎",
          "text": "没什么关系，贾尔贾又不知道旅行者之前的身手，再怎么提升难度也难不住他吧。"
        },
        {
          "type": "subtitle",
          "text": "等待到第二天"
        },
        {
          "type": "subtitle",
          "text": "与贾尔贾对话"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦啦~你们来了？"
        },
        {
          "role": "贾尔贾",
          "text": "说起来，之前还没来得及问你们，第一环试炼的感觉如何？"
        },
        {
          "role": "派蒙",
          "text": "简简单单，轻轻松松！"
        },
        {
          "role": "斯露莎",
          "text": "哼！如果你只是想拦住烦你的「矫论团」成员，大可以把试炼搞得再难一点，让所有人都通过不了！"
        },
        {
          "role": "派蒙",
          "text": "刚开始就给他们一个下马威，看谁还敢来烦你！"
        },
        {
          "role": "贾尔贾",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "贾尔贾？"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦，没什么，我们继续吧。"
        },
        {
          "role": "贾尔贾",
          "text": "这次和之前一样，尽快收集所有微粒，抵达终点就好。"
        },
        {
          "type": "subtitle",
          "text": "与贾尔贾对话，开始试炼"
        },
        {
          "role": "贾尔贾",
          "text": "这次的难度提升了哦，你们可不要大意！准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "放花灵过来吧！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "噫！这个说法好像有点怪怪的…不过意思也没差了！看好我们的表演吧！"
                },
                {
                  "role": "斯露莎",
                  "text": "旅行者和白飘飘还真有干劲，我也表现得积极一点好了…"
                }
              ]
            },
            {
              "text": "既然你这么说了，就再准备一下。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦哦哦！旅行者认真起来了吗？"
                },
                {
                  "role": "斯露莎",
                  "text": "谨慎一点也不会错，很符合旅行者的作风呢。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "完成第二试炼"
        },
        {
          "role": "斯露莎",
          "text": "嗯，这里隐藏着一些平台、机关和通道，我来打开它们。"
        },
        {
          "role": "斯露莎",
          "text": "的确有点复杂呢，还是比较耗费体力的。"
        },
        {
          "role": "派蒙",
          "text": "斯露莎都这么说了，说明贾尔贾确实有两下子嘛！"
        },
        {
          "type": "subtitle",
          "text": "回到了贾尔贾的身边。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与贾尔贾对话"
        },
        {
          "role": "贾尔贾",
          "text": "真…真厉害！居然又轻轻松松通过了试炼…第二试炼明明更复杂了！"
        },
        {
          "role": "贾尔贾",
          "text": "难道是我太保守了吗…应该把时间限定得更紧一点？"
        },
        {
          "role": "派蒙",
          "text": "贾尔贾好像认真起来了，说不定是被我们激起了胜负心！"
        },
        {
          "role": "斯露莎",
          "text": "有这种可能，她好像又在思考试炼的细节了…"
        },
        {
          "role": "旅行者",
          "text": "（只是胜负心而已吗？）"
        },
        {
          "role": "贾尔贾",
          "text": "先不讨论无关话题了，挑战还没完呢…"
        },
        {
          "role": "贾尔贾",
          "text": "按照惯例，我还要一段时间来准备之后的试炼，麻烦你们先等到明天了！"
        },
        {
          "type": "subtitle",
          "text": "等待到第二天"
        },
        {
          "type": "subtitle",
          "text": "与贾尔贾对话"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦，几位还挺守约的嘛。"
        },
        {
          "role": "贾尔贾",
          "text": "那接下来，先讨论一下上次试炼的细节吧？比如每一段赛道的高低差会不会太保守，障碍物是不是太稀疏…"
        },
        {
          "role": "斯露莎",
          "text": "又开始唠叨一些正常花灵不会说的词了，没必要在试炼前聊这些琐事吧？"
        },
        {
          "role": "斯露莎",
          "text": "这些细枝末节的讨论，我就不参加了，你们先商量。"
        },
        {
          "role": "斯露莎",
          "text": "等到差不多要开始挑战了，再叫上我好了。"
        },
        {
          "type": "subtitle",
          "text": "斯露莎暂时离开了…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "贾尔贾",
          "text": "旅行者，看来上个试炼对你来说，挑战性还不够。"
        },
        {
          "role": "贾尔贾",
          "text": "我考虑了一下你们的建议，确实有必要修改之前的试炼，让「浮光鸣召」更有威慑力…"
        },
        {
          "role": "旅行者",
          "text": "怎么不用「谒颂主」称呼我了？"
        },
        {
          "role": "派蒙",
          "text": "对哦，不对比还没感觉，除了「啊啦啦」的口癖，贾尔贾说话的风格变得更利索了，现在这样就挺好的嘛。"
        },
        {
          "role": "派蒙",
          "text": "之前你说话的时候，好像有点「矫论团」的风格，像是在…摆架子？面对斯露莎又太毕恭毕敬了…你不是很讨厌「矫论团」吗？"
        },
        {
          "role": "派蒙",
          "text": "一开始，我们也忘了问你，「矫论团」究竟想从你这里得知些什么…"
        },
        {
          "role": "贾尔贾",
          "text": "呃，你们还挺敏感的。"
        },
        {
          "role": "贾尔贾",
          "text": "如果是你们的话…唔，这件事该从何说起呢。"
        },
        {
          "role": "旅行者",
          "text": "果然还有隐情。"
        },
        {
          "role": "派蒙",
          "text": "咦！怎么回事！我有点跟不上你们的节奏了！"
        },
        {
          "role": "贾尔贾",
          "text": "没关系，纯真的白仙灵，这些事不知道也罢，了解多了，也是徒增烦扰。"
        },
        {
          "role": "贾尔贾",
          "text": "你好像很喜欢财物，只想着最后的报酬就好，开开心心。沉重的情绪就分给旅行者来承担吧。"
        },
        {
          "role": "派蒙",
          "text": "才不要，我绝不会让旅行者一个人不开心！你们说话的时候，我一定要旁听！"
        },
        {
          "role": "贾尔贾",
          "text": "这才是真正的朋友吗…我之前都在干什么啊…简直笑死花灵了。"
        },
        {
          "role": "派蒙",
          "text": "什…什么意思？"
        },
        {
          "role": "贾尔贾",
          "text": "不废话了，正事要紧，快来试试这一环「浮光鸣召」。这次的试炼可不一般，你们未必能闯过这一关。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那我们之后再说，现在就先搞定你精心准备的挑战…"
        },
        {
          "type": "subtitle",
          "text": "与贾尔贾对话，开始试炼"
        },
        {
          "role": "贾尔贾",
          "text": "事先提醒你们，有了前两次的参考，第三试炼对你们来说很有挑战性，不拿出全力的话，可是会被难倒的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "直接开始吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "总感觉有点怪怪的，我是不是听漏了什么重要的谈话…"
                },
                {
                  "type": "subtitle",
                  "text": "找到了不远外的斯露莎，开始了第三环「浮光鸣召」试炼…",
                  "narration": true,
                  "color": "描述"
                }
              ]
            },
            {
              "text": "好可怕！还得再准备一下！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "噫！你是在附和贾尔贾吗？好像有点夸张了啦…"
                },
                {
                  "role": "派蒙",
                  "text": "不过，调整到最好的状态总不是坏事。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "完成第三试炼"
        },
        {
          "role": "派蒙",
          "text": "不止旅行者要跑来跑去，斯露莎也不轻松呢…确实很有挑战性！"
        },
        {
          "role": "斯露莎",
          "text": "呼…贾尔贾没有说大话，解开这些机关的难度也越来越高了…"
        },
        {
          "type": "subtitle",
          "text": "回到了贾尔贾的身边。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与贾尔贾对话"
        },
        {
          "role": "贾尔贾",
          "text": "好难得…果然，你们才是我在等的人…可你们又是斯露莎大人的「谒颂主」…"
        },
        {
          "role": "派蒙",
          "text": "咦？贾尔贾，你好像不太开心？"
        },
        {
          "role": "斯露莎",
          "text": "怎么了？贾尔贾又在嘀咕什么？"
        },
        {
          "role": "斯露莎",
          "text": "这「浮光鸣召」倒还挺折腾的，我有点累…刚刚没听清。"
        },
        {
          "role": "贾尔贾",
          "text": "没什么！我们还是着眼于试炼吧…"
        },
        {
          "role": "贾尔贾",
          "text": "看来斯露莎大人有些疲惫，我也要筹备最后的赛道…就按一直以来的规矩，过段时间再见面吧？到时我们再闲谈也不迟。"
        },
        {
          "role": "斯露莎",
          "text": "这不是挺懂事的吗？正好，我就稍微休息一下。"
        },
        {
          "role": "斯露莎",
          "text": "我的「谒颂主」，之后见到贾尔贾的时候，你们先聊聊吧，我就在附近休息一会儿，养养神…"
        },
        {
          "role": "斯露莎",
          "text": "这样一来，你们就有时间仔细讨论之前那些琐碎的问题了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就依你的意思…",
              "dialogues": []
            },
            {
              "text": "（目光暗示派蒙）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "咦？唔…哦！"
        },
        {
          "role": "派蒙",
          "text": "斯露莎你不用担心！到时候，我和旅行者就先去给贾尔贾反馈了！"
        },
        {
          "type": "subtitle",
          "text": "等待到第二天"
        },
        {
          "type": "subtitle",
          "text": "与贾尔贾对话"
        },
        {
          "role": "贾尔贾",
          "text": "看你们这么有气势，是觉得自己能顺利完成最后的试炼吗？"
        },
        {
          "role": "派蒙",
          "text": "当然了，你自己都说过，旅行者是伟大的斯露莎的「谒颂主」，「浮光鸣召」对他只算是热身罢了！"
        },
        {
          "role": "旅行者",
          "text": "先和我们说实话吧。"
        },
        {
          "role": "派蒙",
          "text": "没错，贾尔贾！有什么瞒着我们和斯露莎的事，都说出来吧。"
        },
        {
          "role": "贾尔贾",
          "text": "……"
        },
        {
          "role": "贾尔贾",
          "text": "其实也没什么大不了的，一个孤僻的花灵，被别有用心的人骗了而已。"
        },
        {
          "role": "贾尔贾",
          "text": "我原本就喜欢无拘无束的飞行，追求速度与技巧，布置了许多「浮光鸣召」这样的挑战…但没有花灵愿意和我一起享受。"
        },
        {
          "role": "贾尔贾",
          "text": "那个「矫论团」的喽啰突然出现，说是想和我成为朋友。"
        },
        {
          "role": "贾尔贾",
          "text": "明明连什么「风之翼」的滑翔都是个外行，却用他们那套阿谀奉承的话术，把我哄得团团转。"
        },
        {
          "role": "贾尔贾",
          "text": "结果到头来，他只是把我当成了普通花灵的观察样本…还想从我这里套出重要花灵的情报。"
        },
        {
          "role": "派蒙",
          "text": "难道说是祖尔宛…"
        },
        {
          "role": "贾尔贾",
          "text": "是啊，和最初的花灵祖尔宛大人比起来，我不过是个无人在意的无名花灵。"
        },
        {
          "role": "贾尔贾",
          "text": "人类讨好我，当然不是因为我，只是为了我了解的信息。"
        },
        {
          "role": "旅行者",
          "text": "听起来有点耳熟…"
        },
        {
          "role": "派蒙",
          "text": "确实，斯露莎也因为同样的原因被欺骗过呢。"
        },
        {
          "role": "贾尔贾",
          "text": "虽说我不过是个无名花灵，但也不会轻易透露秘密。发现真相之后，我赶走了他。"
        },
        {
          "role": "贾尔贾",
          "text": "原本以为这样就结束了，可没想到，又有其他的人类来同我接触，就好像完全不知道我之前已经赶走过他的同伙一样。"
        },
        {
          "role": "派蒙",
          "text": "这些人应该都是跟那先朱那一伙的吧？没想到他居然除了诓骗斯露莎之外，还做了这些小手段呢！"
        },
        {
          "role": "旅行者",
          "text": "还真是被看扁了呀。"
        },
        {
          "role": "贾尔贾",
          "text": "所以我设下「浮光鸣召」，并且告诉人类，只有通过试炼的人才有资格同我说话。"
        },
        {
          "role": "派蒙",
          "text": "那通过试炼的人…"
        },
        {
          "role": "贾尔贾",
          "text": "通过试炼的人，我也不会告诉他任何有关祖尔宛大人的事。这可是原则问题。"
        },
        {
          "role": "贾尔贾",
          "text": "虽然如斯露莎大人所说，我是个古怪的花灵，总是独自一个…"
        },
        {
          "role": "贾尔贾",
          "text": "但我也不会为了想和人类做朋友这种事而背叛花灵一族。"
        },
        {
          "role": "派蒙",
          "text": "哇，这话听起来好刺耳！"
        },
        {
          "role": "旅行者",
          "text": "斯露莎的情况不太一样吧。"
        },
        {
          "role": "派蒙",
          "text": "这倒也是…话说回来，贾尔贾其实是想多交朋友的，对吧？"
        },
        {
          "role": "派蒙",
          "text": "虽然这种时候说这句话，有点怪怪的，但旅行者一路都轻轻松松通过了试炼，难道不算数吗？"
        },
        {
          "role": "贾尔贾",
          "text": "旅行者？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "欸嘿。",
              "dialogues": []
            },
            {
              "text": "正是在下。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "贾尔贾",
          "text": "不行，旅行者是你的朋友，是斯露莎的「谒颂主」，怎么轮得到我…"
        },
        {
          "role": "派蒙",
          "text": "朋友又不是什么奇怪的主仆，没有只能一对一的规矩！"
        },
        {
          "role": "派蒙",
          "text": "你和我成为朋友，也和斯露莎成为朋友，不就行了吗！让大家都来体验你的飞行挑战，为你的「浮光鸣召」叫好，开开心心！"
        },
        {
          "role": "贾尔贾",
          "text": "你们…你们…"
        },
        {
          "role": "贾尔贾",
          "text": "财物，你们现在就可以拿走了，我不知道该怎么感谢你们…斯露莎那边，就算了吧…"
        },
        {
          "role": "派蒙",
          "text": "贾尔贾在关键的时候退缩了…这可不行！"
        },
        {
          "role": "派蒙",
          "text": "你明明还学「矫论团」的口吻和斯露莎说话，你是怎么看待斯露莎的呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你害怕斯露莎吗？",
              "dialogues": []
            },
            {
              "text": "你讨厌斯露莎吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "贾尔贾",
          "text": "怎么可能！斯露莎可是特别的花灵！她的觉悟和干劲，是我这种花灵怎么也学不来的，我很尊敬她！"
        },
        {
          "role": "贾尔贾",
          "text": "我只不过觉得，「矫论团」的话术能取悦我，骗到我，肯定也能让其他花灵心情愉快吧。这样，她们就应该更愿意和我交流了。"
        },
        {
          "role": "贾尔贾",
          "text": "仔细一想，那种阿谀奉承，我不该再学了，我要用自己原本的一面去和斯露莎相处才行…"
        },
        {
          "role": "贾尔贾",
          "text": "但我又有点害怕…不狠狠地夸斯露莎的话，她又会想起我的传闻，不再理会我…"
        },
        {
          "role": "派蒙",
          "text": "没那种事啦，该怎么说呢，现在的斯露莎已经不是以前的斯露莎了！一开始，她不就好好和你交流了吗？"
        },
        {
          "role": "派蒙",
          "text": "既然你本来就特别尊敬她，就算不用「矫论团」的那种口吻去奉承，她肯定也能感受到你对她的好意！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来做个约定吧。",
              "dialogues": []
            },
            {
              "text": "我们成功了，你就去试试。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对对对，事已至此，财宝什么的都不那么重要了。如果我们完成了最后的「浮光鸣召」，你就要主动和斯露莎交朋友。"
        },
        {
          "role": "派蒙",
          "text": "不迈出这一步的话，等到我和旅行者去别的地方旅行了，你又会变得孤零零，可怜巴巴。"
        },
        {
          "role": "派蒙",
          "text": "等到下次，有人能通过「浮光鸣召」，都不知道是什么时候了。"
        },
        {
          "role": "贾尔贾",
          "text": "先…先别那么乐观！最后一环试炼可是很难的！"
        },
        {
          "role": "贾尔贾",
          "text": "等到你们成功了，再来说这些麻烦的事吧…"
        },
        {
          "role": "派蒙",
          "text": "哼，我们可不能被小瞧了，旅行者！这关键的一把，我们推定了！"
        },
        {
          "type": "subtitle",
          "text": "与贾尔贾对话，开始试炼"
        },
        {
          "role": "贾尔贾",
          "text": "这回我是认真的！在这最终的试炼里，我拿出了我能想到的最难布置，你们最好全力以赴…"
        },
        {
          "role": "贾尔贾",
          "text": "呃咳！是做好失败的准备！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "开始吧，我们会成功的。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我们赢了的话，你也要守约，去和斯露莎坦白心声哦！"
                },
                {
                  "role": "贾尔贾",
                  "text": "明…明白了，我会尽力的！"
                },
                {
                  "type": "subtitle",
                  "text": "找到了附近休息的斯露莎，拉着她开始了最终的「浮光鸣召」试炼…",
                  "narration": true,
                  "color": "描述"
                }
              ]
            },
            {
              "text": "容我再调整一下状态。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，为了让贾尔贾和斯露莎交朋友，我们要动真格的了！"
                },
                {
                  "role": "贾尔贾",
                  "text": "我都说过了，不要那么乐观啊！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "完成第四试炼"
        },
        {
          "role": "派蒙",
          "text": "全力冲刺吧，旅行者和斯露莎！要开开心心完成最后的挑战！"
        },
        {
          "role": "斯露莎",
          "text": "怎么回事？白飘飘好像很有干劲？"
        },
        {
          "role": "斯露莎",
          "text": "那我也适当拿出一点热情吧…好了，机关全都解开了！"
        },
        {
          "type": "subtitle",
          "text": "和不知情的斯露莎一起回到了贾尔贾身边…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "见证贾尔贾向斯露莎的自白"
        },
        {
          "role": "斯露莎",
          "text": "好了，这下贾尔贾的所有试炼都完成了。"
        },
        {
          "role": "斯露莎",
          "text": "还真是繁琐，花费了我不少时间…"
        },
        {
          "role": "派蒙",
          "text": "到你上场了，贾尔贾，你就一鼓作气，开门见山吧！"
        },
        {
          "role": "贾尔贾",
          "text": "……"
        },
        {
          "role": "贾尔贾",
          "text": "啊啦啦，斯露莎大人。「浮光鸣召」还是略有难度，不然，岂能劳烦您的「谒颂主」来评点？"
        },
        {
          "role": "贾尔贾",
          "text": "若是结束得太快，说明「浮光鸣召」不可能成为重要的仪式，那反而才浪费了您的时间。还请您体谅！"
        },
        {
          "role": "斯露莎",
          "text": "说得有点道理…那我就不计较了。"
        },
        {
          "role": "旅行者",
          "text": "贾尔贾，怎么回事！"
        },
        {
          "role": "派蒙",
          "text": "为什么又是这种口吻啦？不是说好了要展示你本来的一面吗！"
        },
        {
          "role": "贾尔贾",
          "text": "没办法！我还没做好准备，根本开不了口嘛！"
        },
        {
          "role": "贾尔贾",
          "text": "直接和斯露莎说我在模仿「矫论团」的话术，说不定会让她发火，想想就太可怕了！"
        },
        {
          "role": "斯露莎",
          "text": "你们在嘀咕些什么？"
        },
        {
          "role": "斯露莎",
          "text": "话说回来，吾之「谒颂主」，你怎么评价贾尔贾的「浮光鸣召」？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…恰到好处？",
              "dialogues": []
            },
            {
              "text": "…很有潜力？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯露莎",
          "text": "…既然旅行者都这样说了，那一定是有特别的价值了。"
        },
        {
          "role": "斯露莎",
          "text": "唔，今后多和她来往，想必也不是什么坏事。"
        },
        {
          "role": "斯露莎",
          "text": "咳，尽管把我当成你最尊贵的朋友吧，贾尔贾，有着此等好运的花灵，可为数不多哦。"
        },
        {
          "role": "旅行者",
          "text": "！"
        },
        {
          "role": "派蒙",
          "text": "！"
        },
        {
          "role": "贾尔贾",
          "text": "…朋友？"
        },
        {
          "role": "贾尔贾",
          "text": "那以后…要是我还做出了比「浮光鸣召」更厉害的试炼，您是否能考虑一下…亲自来试试？"
        },
        {
          "role": "斯露莎",
          "text": "那可说不准！我斯露莎可是很忙的！"
        },
        {
          "role": "斯露莎",
          "text": "…不过，要是时机得当，我会考虑考虑的。"
        },
        {
          "role": "贾尔贾",
          "text": "太谢谢了…太谢谢了！斯露莎大人！我我我，我一定会竭尽全力，打造出您最满意的试炼！"
        },
        {
          "role": "斯露莎",
          "text": "怎么突然这么激动…你啊，可得学学怎么和其他花灵交流了！"
        },
        {
          "role": "派蒙",
          "text": "该说多亏斯露莎的心太大吗，无意中就解开了贾尔贾的难题…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "总之…结果是好的。",
              "dialogues": []
            },
            {
              "text": "可喜可贺！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！希望她们以后能愉快相处！"
        },
        {
          "role": "派蒙",
          "text": "欸，不过，「浮光鸣召」对这么高大的你来说，难度刚刚好…"
        },
        {
          "role": "派蒙",
          "text": "要是小小的斯露莎来挑战，说不定会失败！到时候，她会不会气得不停跺脚呢？"
        }
      ]
    }
  ]
}