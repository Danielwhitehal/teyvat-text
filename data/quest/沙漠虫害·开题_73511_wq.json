{
  "quest_id": 73511,
  "chapter_num": null,
  "chapter_title": "沙漠虫害·开题",
  "type": "wq",
  "route": "The Culling of the Worms: Proposal",
  "stories": [
    {
      "story_id": 73511,
      "title": "沙漠虫害·开题",
      "description": "在阿如村附近，你遇到了一名神色焦急的学者…",
      "dialogues": [
        {
          "role": "施芮娅",
          "text": "那个笨蛋…居然就这么冲进沙漠了！福迪尔大哥，求求你们，快去救救他吧！"
        },
        {
          "role": "福迪尔",
          "text": "很抱歉，村子里的守备力量有限，还要防着「它们」乱来，暂时没有那么多余力。"
        },
        {
          "role": "施芮娅",
          "text": "可那个笨蛋那么拼命，也是为了对付「它们」啊！至少看在利害一致的份上…"
        },
        {
          "role": "福迪尔",
          "text": "唉，也不是我们不想去找。但是守卫们现在分散在沙漠各处，提防「它们」的动向，召集人手也需要时间…"
        },
        {
          "role": "施芮娅",
          "text": "怎么会这样…现在回喀万驿找人帮忙，肯定也来不及了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "有谁有危险吗？",
            "你们需要帮助吗？"
          ]
        },
        {
          "role": "施芮娅",
          "text": "嗯？你们是…？"
        },
        {
          "role": "旅行者",
          "text": "一名路过的冒险家。"
        },
        {
          "role": "派蒙",
          "text": "——以及他最要好的伙伴派蒙！"
        },
        {
          "role": "施芮娅",
          "text": "冒险家？真的吗！谢天谢地，维纳亚克那家伙，终于有救了！"
        },
        {
          "role": "施芮娅",
          "text": "冒险家先生！请您救救维纳亚克吧，报酬绝对不成问题！"
        },
        {
          "role": "旅行者",
          "text": "先说说是什么情况？"
        },
        {
          "role": "福迪尔",
          "text": "嗯，沙漠里现在有「它们」作乱，比平时要危险不少，最好先听完情况说明再作打算。"
        },
        {
          "role": "施芮娅",
          "text": "呃…你们说得对，抱歉，我有点儿心急了…"
        },
        {
          "role": "派蒙",
          "text": "从刚才起就一直听你们在说了，「它们」究竟是什么东西啊？"
        },
        {
          "role": "福迪尔",
          "text": "——是一群沙虫。也不知道为什么，它们的性情最近变得异常凶暴，还会潜藏在沙暴里袭击过往的猎物。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "不过是些虫子而已。",
            "我对付过更大只的。"
          ]
        },
        {
          "role": "福迪尔",
          "text": "…话是这么说，但这次的数量实在太多了。"
        },
        {
          "role": "福迪尔",
          "text": "有沙暴作掩护，也很难对它们造成多大的伤害。一觉得有危险，那些家伙就会立刻逃走…"
        },
        {
          "role": "派蒙",
          "text": "唔，那确实还挺棘手的…"
        },
        {
          "role": "施芮娅",
          "text": "不止是阿如村，还有一些过往行商也受到了影响。所以，教令院派了我和维纳亚克来处理这些作乱的沙虫。"
        },
        {
          "role": "施芮娅",
          "text": "可我们托商队送来的一部分「零件」在半路上被沙虫袭击，还被沙暴卷得到处都是，现在…恐怕已经变成魔物们的玩具了吧…"
        },
        {
          "role": "施芮娅",
          "text": "我原本想先回喀万驿求援，谁知道维纳亚克那家伙，过了那么多年还是跟机械一样呆板！"
        },
        {
          "role": "施芮娅",
          "text": "他说着什么要救回他的宝贝零件，一个人就冲进沙漠里了！"
        },
        {
          "role": "施芮娅",
          "text": "啊啊——干脆让魔物抓走他算了！"
        },
        {
          "role": "派蒙",
          "text": "呜哇…怎么办，旅行者？要是放着不管的话，不仅那位学者有危险，沙虫的问题也不好解决…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "不能对沙漠的危机置之不理。",
            "救援的工作就交给我吧。"
          ]
        },
        {
          "role": "施芮娅",
          "text": "唉…谢谢，谢谢！抱歉，刚刚被气得有点失言了…我这就在地图上标出遇袭的地点，咳，请您尽快找到他吧。"
        },
        {
          "role": "施芮娅",
          "text": "希望他的脑袋，还没生锈到直接冲进魔物堆里捡零件…"
        },
        {
          "role": "维纳亚克",
          "text": "从这个角度潜入，利用地形进行遮蔽…只要太阳高度角不高于…我的速度不低于…嗯，果然还是无解！"
        },
        {
          "role": "旅行者",
          "text": "你在算什么？"
        },
        {
          "role": "维纳亚克",
          "text": "「在不正面接触魔物的情况下回收零件的可行路线」…拜沙虫所赐，我的宝贝零件全被卷进附近的魔物堆里了…"
        },
        {
          "role": "维纳亚克",
          "text": "——呜哇！你们是谁？是什么时候来的！"
        },
        {
          "role": "旅行者",
          "text": "都在边上听你嘀咕好久了…"
        },
        {
          "role": "派蒙",
          "text": "放心吧，我们不是坏人。是你的同伴让我们来的哦！"
        },
        {
          "role": "维纳亚克",
          "text": "同伴？难道是施芮娅？不对啊，她明明说，就算我被魔物抓走也不管我了…"
        },
        {
          "role": "维纳亚克",
          "text": "啊——我明白了，她是让你们俩来回收零件的吧！"
        },
        {
          "role": "维纳亚克",
          "text": "我有没有被抓走无所谓，零件没人回收了可是大事…嗯，像是她会说的话，合情合理。"
        },
        {
          "role": "旅行者",
          "text": "…你就当是这样吧。"
        },
        {
          "role": "维纳亚克",
          "text": "不过还是得多谢你们啦，刚才我怎么算都求不出解，都想直接冲出去，走一步再算一步了。"
        },
        {
          "role": "维纳亚克",
          "text": "…搞不好一步算错，就真要被魔物逮着了。"
        },
        {
          "role": "维纳亚克",
          "text": "唉，要是没我在，施芮娅又那么笨手笨脚的…还有谁能照料好这些机械啊！"
        },
        {
          "role": "派蒙",
          "text": "我算是理解施芮娅为什么那么担心了…这个人脑子里真的全是机械零件…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们快把零件给收集起来吧！免得他又想冒险了！"
        }
      ]
    }
  ]
}