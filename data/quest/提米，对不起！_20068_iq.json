{
  "quest_id": 20068,
  "chapter_num": null,
  "chapter_title": "提米，对不起！",
  "type": "iq",
  "route": "Sorry, Timmie!",
  "stories": [
    {
      "story_id": 20068,
      "title": "提米，对不起！",
      "description": "提米正因为某件事而与你赌着气。葛瑞丝修女也许知道能与提米和解的方法…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与葛瑞丝对话"
        },
        {
          "role": "葛瑞丝",
          "text": "唉，这可怎么办才好…"
        },
        {
          "role": "旅行者",
          "text": "呃，发生什么了？"
        },
        {
          "role": "葛瑞丝",
          "text": "是您啊，您来得正好。提米已经把您对鸭子做的事告诉我了。"
        },
        {
          "role": "葛瑞丝",
          "text": "您…您…唉，我该怎么说您好呢，您的事迹我也不是没听说过…"
        },
        {
          "role": "葛瑞丝",
          "text": "您的那些勇气和力量…怎么能用在这种地方…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "实在是太饿了…",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "您…如果实在肚子饿的话，可以去正经工作赚钱啊。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "以您的实力，在冒险家协会绝对能占得一席之地…"
                }
              ]
            },
            {
              "text": "只是失手…",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "失手打到鸽子和鸭子？那么您遇见的那些强敌，一定也是您「失手」击败的吧。"
                }
              ]
            },
            {
              "text": "力量就是来自于这种平时的累积。",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "您…您，我…算了，看来您的实力，确实是很全面…"
                }
              ]
            }
          ]
        },
        {
          "role": "葛瑞丝",
          "text": "唉，事情已经发生了，多说无益，提米因为这件事已经闷闷不乐很久了。"
        },
        {
          "role": "葛瑞丝",
          "text": "我曾经从提米的…父亲那里，学过一道菜谱。加入了「慕风蘑菇」的「蒙德土豆饼」，是提米最喜欢吃的东西。"
        },
        {
          "role": "葛瑞丝",
          "text": "您帮我找三个「慕风蘑菇」来吧，提米能吃到这个，心情应该会好些…您也能向他道歉了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "那就请您快去快回吧。"
                }
              ]
            },
            {
              "text": "无论多少蘑菇都可以！",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "只用三个就够了。您拿那么多，难道是准备以后每次惹提米生气，就拿出来用吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "葛瑞丝",
          "text": "慕风蘑菇的话…我记得在城里南边房子的房檐下应该就能找到一些。"
        },
        {
          "role": "葛瑞丝",
          "text": "请您快去快回吧。"
        },
        {
          "type": "subtitle",
          "text": "将3个慕风蘑菇带给葛瑞丝"
        },
        {
          "role": "葛瑞丝",
          "text": "您找到「慕风蘑菇」了吗？在城里的房檐下，应该能找到很多…"
        },
        {
          "type": "subtitle",
          "text": "与提米对话"
        },
        {
          "role": "提米",
          "text": "…吃吧，吃吧，吃好了就快点走…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么了？",
              "dialogues": [
                {
                  "role": "提米",
                  "text": "怎么又是你！"
                }
              ]
            },
            {
              "text": "提米，那个…",
              "dialogues": [
                {
                  "role": "提米",
                  "text": "怎么又是你？你到底有完没完！"
                }
              ]
            },
            {
              "text": "发，发生什么了吗？",
              "dialogues": [
                {
                  "role": "提米",
                  "text": "你还好意思问我！？"
                }
              ]
            }
          ]
        },
        {
          "role": "提米",
          "text": "你到底想做什么啊，难道还想对鸭子和鸽子下手吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这份土豆饼是给你的。",
              "dialogues": []
            },
            {
              "text": "请收下这份土豆饼吧！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "提米",
          "text": "土豆饼？咦，你怎么知道这个土豆饼的做法的？"
        },
        {
          "role": "提米",
          "text": "我知道了，你绝对是去找葛瑞丝妈妈了…"
        },
        {
          "role": "提米",
          "text": "哼，用这个就想收买我，你也想得太美了，你对鸽子和鸭子做的事，我比谁都清楚！"
        },
        {
          "role": "提米",
          "text": "…不过，葛瑞丝妈妈都让你送这个土豆饼来，肯定是不想我接着闹下去了。"
        },
        {
          "role": "提米",
          "text": "她还要照顾诺拉和葛罗丽，我再给她添麻烦，就太不懂事了…"
        },
        {
          "role": "提米",
          "text": "不过先说好，我可没有原谅你！只是不想再给妈妈添麻烦了，知道了吗？"
        },
        {
          "role": "提米",
          "text": "哼，不过…反正我只是个小孩子，这种口头的约定，你肯定说忘就忘了…"
        },
        {
          "role": "提米",
          "text": "等我爸爸回来了，我要再和他好好说说你的事！"
        },
        {
          "type": "subtitle",
          "text": "等待葛瑞丝制作蒙德土豆饼"
        },
        {
          "role": "葛瑞丝",
          "text": "这些就足够了，谢谢您，请您稍等一下…"
        },
        {
          "role": "葛瑞丝",
          "text": "这样就可以了，请您把这份「蒙德土豆饼」送给提米吧。"
        },
        {
          "role": "葛瑞丝",
          "text": "请您以后别做这种…不好的事了，实在是得不偿失…"
        },
        {
          "role": "葛瑞丝",
          "text": "希望您能记住我的告诫，别让我和提米太失望。"
        },
        {
          "role": "葛瑞丝",
          "text": "不过…唉，要是人人都能记住告诫，那维多利亚修女就不会那么忙了…"
        }
      ]
    }
  ]
}