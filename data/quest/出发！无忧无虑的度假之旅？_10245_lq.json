        {
          "role": "派蒙",
          "text": "这倒是…"
        },
        {
          "role": "班尼特",
          "text": "我有些好奇，可以再多介绍一点吗？"
        },
        {
          "role": "玛拉妮",
          "text": "我也是从织卷中读来的，这是一种完成能量更新的古老仪式。"
        },
        {
          "role": "玛拉妮",
          "text": "人们围坐在「太阳」边，点燃中心和四周的蜡烛，向神明献上供奉与祈祷。"
        },
        {
          "role": "玛拉妮",
          "text": "随着香火燃烧，烟气会带着人们的愿望飘入神明耳中。"
        },
        {
          "role": "玛拉妮",
          "text": "与此同时，世俗中不好的力量会被火焰吞噬与净化，好的能量则会随着火焰的舞动不断加强。"
        },
        {
          "role": "恰斯卡",
          "text": "这么一说，小时候我见过类似的习俗。"
        },
        {
          "role": "玛拉妮",
          "text": "很正常嘛，火焰对纳塔来说很重要呀。就算没有「烟谜主」那么频繁，「花羽会」肯定也要定期祭祀…"
        },
        {
          "role": "恰斯卡",
          "text": "是[[栖木普]]「妈妈」一口火喷着了姐姐带回家的果子，庆祝我那个晚上独自挑战了「深渊」。"
        },
        {
          "role": "派蒙",
          "text": "呃…会不会其实是你妈妈生气了，就像在说「下次再这么冒险指定没你好果子吃」！"
        },
        {
          "role": "恰斯卡",
          "text": "也不排除这种可能，谁叫我那次是自己溜出去的呢。"
        },
        {
          "role": "班尼特",
          "text": "这些故事我可以写进旅行日记里吗？"
        },
        {
          "role": "娜塔芭",
          "text": "这位客人真是专业，知道的比我一个做生意的人还详细…我算是学着下回该怎么做介绍了。"
        },
        {
          "role": "娜塔芭",
          "text": "来，这些蜡烛作为赠品送给你们，一人一个，请留作纪念吧。愿火神保佑诸位。"
        },
        {
          "role": "玛拉妮",
          "text": "嘿嘿，谢谢您，老板！度假村有您这位熟人我可就放心啦，之后还带朋友来。"
        },
        {
          "role": "玛拉妮",
          "text": "以我对卡齐娜的了解，她肯定会喜欢的。"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|「太阳」}}、{{图标|迷你「太阳」}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "前往度假屋"
        },
        {
          "role": "派蒙",
          "text": "快看，地面上亮起了缤纷的涂鸦！"
        },
        {
          "role": "派蒙",
          "text": "是欢迎我们入住的仪式呢，这群活泼的小家伙们太可爱了！"
        },
        {
          "role": "玛拉妮",
          "text": "噢！这里是用餐区域啊。稍等，我去找位工作人员，打听下推荐的菜品。"
        },
        {
          "role": "班尼特",
          "text": "需要帮忙吗？"
        },
        {
          "role": "玛拉妮",
          "text": "没事，你们先休息就好，我马上回来。"
        },
        {
          "role": "班尼特",
          "text": "欸？我也…"
        },
        {
          "role": "恰斯卡",
          "text": "玛拉妮的性格就是这样，不仅喜欢聚会和热闹的场面，还喜欢结交、照顾朋友。"
        },
        {
          "role": "恰斯卡",
          "text": "要是想让她保持安静，一个人待在角落里不要说话，她反倒会浑身不自在。"
        },
        {
          "role": "班尼特",
          "text": "是这样吗？你那么了解她，你们一定是认识很久的朋友了吧？"
        },
        {
          "role": "恰斯卡",
          "text": "是挺久了，多数时候动嘴，少数时候动手。"
        },
        {
          "role": "恰斯卡",
          "text": "班尼特呢，这是第一次来纳塔吗？那么远过来，有没有约着朋友一起？"
        },
        {
          "role": "班尼特",
          "text": "哦！我有一位旅伴，他是蒙德城最好的吟游诗人，名叫温迪。"
        },
        {
          "role": "派蒙",
          "text": "卖唱的！我们跟他好久没见了呢。他人在哪呢？"
        },
        {
          "role": "班尼特",
          "text": "他说他要先去找个住在纳塔的朋友，晚几天再来度假村，让我先玩着。"
        },
        {
          "role": "派蒙",
          "text": "纳塔的朋友？谁啊？"
        },
        {
          "role": "班尼特",
          "text": "抱歉，我一点都没打听…我觉得温迪老师那么优秀，认识谁都不奇怪。"
        },
        {
          "role": "玛拉妮",
          "text": "来了来了，各位的肚子都空出来了吗？空出来了就赶紧在桌边坐下吧…我精挑细选了一桌好菜！"
        },
        {
          "type": "subtitle",
          "text": "片刻间，美味的菜肴铺满了整个餐桌。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "话说回来，嗝，所以班尼特是怎么想到来纳塔玩的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "塞琉斯给了邀请函？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "嗯，就是那样。"
        },
        {
          "role": "班尼特",
          "text": "会长说纳塔的冒险家协会正在邀请各地冒险家去度假村玩，问我愿不愿意作为蒙德的代表…"
        },
        {
          "role": "班尼特",
          "text": "其实我早就想去更遥远的地方冒险了。"
        },
        {
          "role": "班尼特",
          "text": "之前主要是放心不下老爹们，再加上就凭我的运气，光是路途中的困难和险境恐怕就要花掉我大半时间…"
        },
        {
          "role": "玛拉妮",
          "text": "不过你最近不是转运了嘛，就好好守护住它呗。"
        },
        {
          "role": "班尼特",
          "text": "哈哈，我尽量…"
        },
        {
          "role": "玛拉妮",
          "text": "等有机会，干脆带你去「烟谜主」那边吧？让茜特菈莉奶奶帮你算算，平时要注意些什么之类的…很灵验的！"
        },
        {
          "role": "班尼特",
          "text": "是刚才提到的那位老奶奶？能拜托她算出阿夏的事吗？我还想了解更多它们的事！"
        },
        {
          "role": "派蒙",
          "text": "其实不算你想象中的那种老奶奶啦…等你见到就知道了吧。"
        },
        {
          "role": "阿夏",
          "text": "♪"
        },
        {
          "role": "玛拉妮",
          "text": "正好大家吃得差不多了吧？现在开始下一项活动！供奉「太阳」的仪式暨篝火派对！"
        },
        {
          "role": "玛拉妮",
          "text": "有人想要点火吗？五四三二一，好的，感谢大家纷纷谦让出这个宝贵的机会！"
        },
        {
          "role": "派蒙",
          "text": "她那个语速，根本就没打算让我们插话吧！一旦玩心起来，玛拉妮就跟小孩子一样。"
        },
        {
          "role": "玛拉妮",
          "text": "咳咳…"
        },
        {
          "role": "玛拉妮",
          "text": "太阳垂落于夜幕以西时，愿燧石的光亮指引归途。"
        },
        {
          "role": "玛拉妮",
          "text": "当旧的污浊焚尽，如烈焰般的光明定会再度到来。"
        },
        {
          "role": "班尼特",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "玛拉妮",
          "text": "怎么了？怎么都不说话。"
        },
        {
          "role": "派蒙",
          "text": "现在能说话吗？"
        },
        {
          "role": "玛拉妮",
          "text": "当然能呀，祝祷词念完了，接下来是自由发言环节。有什么想要祈祷的，尽管开口说。"
        },
        {
          "role": "玛拉妮",
          "text": "…对着火焰啊，不用对着我。"
        },
        {
          "role": "恰斯卡",
          "text": "祝愿家人平安，祝愿纳塔再无战争。"
        },
        {
          "role": "派蒙",
          "text": "很简洁嘛，而且很有力！"
        },
        {
          "role": "玛拉妮",
          "text": "祝愿我认识的所有朋友，祝愿纳塔的每一个人都能过上理想的生活…"
        },
        {
          "role": "玛拉妮",
          "text": "还要特别祝福纳塔地脉稳定…"
        },
        {
          "role": "班尼特",
          "text": "轮到我了吗？但我不是纳塔人，火神听见之后，会不会根本不知道是谁在说话啊？"
        },
        {
          "role": "派蒙",
          "text": "做个自我介绍就行了吧？"
        },
        {
          "role": "班尼特",
          "text": "素未谋面的火神大人，您好，我是班尼特，是来自蒙德的冒险家。"
        },
        {
          "role": "班尼特",
          "text": "听说之前纳塔发生了一场大战，各部族都有伤亡与阵痛，我感到十分遗憾。"
        },
        {
          "role": "班尼特",
          "text": "我想为这片受伤的土地，还有在这片土地上辛苦生活的人们，献上我的祝福。"
        },
        {
          "role": "班尼特",
          "text": "祝愿风调雨顺，祝愿作物丰收，祝愿大家摆脱昨日的阴影，重新踏上一段美妙的旅程…"
        },
        {
          "role": "恰斯卡",
          "text": "说得挺好。"
        },
        {
          "role": "班尼特",
          "text": "但我还有一点额外的私心，如果您不嫌弃的话，也想请您听一听…"
        },
        {
          "role": "班尼特",
          "text": "我想念我在蒙德的家人。不知道当我和朋友们玩得那么开心的时候，他们在星辰下会不会感到寂寞…"
        },
        {
          "role": "班尼特",
          "text": "所以，我想祝福老爹们身体健康，生活幸福。"
        },
        {
          "role": "班尼特",
          "text": "我说完了。"
        },
        {
          "role": "玛拉妮",
          "text": "被你说的，我也有点想我爸妈了。"
        },
        {
          "role": "玛拉妮",
          "text": "最近他们的跨国生意做得可好了，又是早出晚归，又是连日出差…经常弄得比我还忙，人影都见不着…"
        },
        {
          "role": "班尼特",
          "text": "是嘛…咳咳，那就多带点度假村特产回去和他们分享吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "班尼特的老爹们近况还好吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "噢…都好都好！放心吧。"
        },
        {
          "role": "班尼特",
          "text": "我跑去询问他们我能不能出国旅行的时候，老爹们脸上全都笑呵呵的。"
        },
        {
          "role": "班尼特",
          "text": "大家态度一致地鼓励我多去见见世面，回来再把冒险故事讲给他们听…"
        },
        {
          "role": "班尼特",
          "text": "要知道，平常讨论香肠要腌制成什么口味，他们七个人可是有八个主意。"
        },
        {
          "role": "班尼特",
          "text": "其中两位前一晚还为打牌的事情争了个面红耳赤，那天却在不断附和对方的话。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可能早就商量好了？",
              "dialogues": []
            },
            {
              "text": "是他们向塞琉斯推荐你的吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "嗯，这样想想很有可能…"
        },
        {
          "role": "派蒙",
          "text": "挺好嘛。肯定是班尼特平时的努力大家都看在眼里，你就好好收下老爹们的心意吧！"
        },
        {
          "role": "阿夏",
          "text": "♪"
        },
        {
          "role": "恰斯卡",
          "text": "我问一句，「老爹们」指的是照顾着班尼特的人？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "现在是班尼特在照顾他们吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "老爹们只是上了年纪，没有充足的精力打理生活，才需要我帮忙搭把手而已。"
        },
        {
          "role": "恰斯卡",
          "text": "挺了不起的。"
        },
        {
          "role": "班尼特",
          "text": "这没什么，那可是家人啊。"
        },
        {
          "role": "恰斯卡",
          "text": "难道说…"
        },
        {
          "role": "班尼特",
          "text": "嗯，我是个孤儿，从记事起就待在冒险家协会里了。哈哈，我可能就是人们口中「天生」的冒险家吧。"
        },
        {
          "role": "班尼特",
          "text": "虽然运气很差，但老爹们一直没放弃过我。托大家的福，我才算跌跌撞撞、缝缝补补地走到了今天…"
        },
        {
          "role": "班尼特",
          "text": "成长过程中，我明白自己接受了很多来自周边、原本素不相识的人的善意，这让我决心要加倍地将这份善意传递出去。"
        },
        {
          "role": "玛拉妮",
          "text": "就像接力一样？"
        },
        {
          "role": "班尼特",
          "text": "是个好比喻，没错，就像接力一样。"
        },
        {
          "role": "恰斯卡",
          "text": "哈，我们还挺像。"
        },
        {
          "role": "玛拉妮",
          "text": "既然要接力，那就不是一个人的冒险喽！"
        },
        {
          "role": "班尼特",
          "text": "呃…但别忘了，我是一个非常倒霉的人，之前总是厄运缠身…都很少有人敢和我结伴。"
        },
        {
          "role": "恰斯卡",
          "text": "过于一帆风顺的旅途就不能称为冒险了。就像「花羽会」失去了天空，「流泉之众」失去了海浪。"
        },
        {
          "role": "班尼特",
          "text": "你是这么想的？不过我的悬崖和海浪似乎太多了些…"
        },
        {
          "role": "玛拉妮",
          "text": "那也没什么不好嘛！听起来就很刺激！你以后冒险绝对得叫上我，我冲浪水平可是一流的！"
        },
        {
          "role": "恰斯卡",
          "text": "也叫上我。"
        },
        {
          "role": "派蒙",
          "text": "噢噢，这么说，班尼冒险团又要临时扩容啦？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我当后勤。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛拉妮",
          "text": "大英雄旅行者抢走了后勤岗位，那我只能负责加油呐喊的啦啦队了。"
        },
        {
          "role": "恰斯卡",
          "text": "在不需要动手的场合，我就当个翻译吧。"
        },
        {
          "role": "阿夏",
          "text": "♪~"
        },
        {
          "role": "班尼特",
          "text": "哈…呜…谢谢你们。我真是…真是太幸运了…"
        },
        {
          "role": "班尼特",
          "text": "我认识了一群天底下最好的人，大家的友谊就是我的宝藏…"
        },
        {
          "role": "派蒙",
          "text": "怎么说着说着还抹起了眼睛呀？"
        },
        {
          "role": "班尼特",
          "text": "是火星啦…咳…是烟雾有点呛人。"
        },
        {
          "role": "玛拉妮",
          "text": "最后还剩你们两位没有祈祷呢，有什么想对火神说的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "都那么熟了…",
              "dialogues": []
            },
            {
              "text": "都在心里。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你倒是挺会偷懒的，好吧好吧，我替你一起说了。"
        },
        {
          "role": "派蒙",
          "text": "火神在上，大家说过的我就不重复了，除此之外…"
        },
        {
          "role": "派蒙",
          "text": "祝愿我自己天天吃得好睡得香。"
        },
        {
          "role": "派蒙",
          "text": "祝愿友谊不变，无论去到哪里，都能和这家伙迎来下一个难忘的夏天。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（班尼特）"
        },
        {
          "role": "班尼特",
          "text": "给雷泽买肉干、给可莉买盒装龙龙饼干、再给菲谢尔带点甜面包…"
        },
        {
          "role": "班尼特",
          "text": "老爹们…兼顾健康和美味…粒果杯好像不错。"
        },
        {
          "role": "班尼特",
          "text": "以我现在的运气，一定能买到很棒的特产和点心，得把包裹装到装不下才行啊！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（恰斯卡）"
        },
        {
          "role": "恰斯卡",
          "text": "我们这位团长，能在那么多的挫折和失败中一次次爬起，毅然踏上冒险之路…实在令人佩服。"
        },
        {
          "role": "恰斯卡",
          "text": "他一定是一名优秀的冒险家。"
        },
        {
          "role": "恰斯卡",
