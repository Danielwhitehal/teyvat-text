{
  "quest_id": 10245,
  "chapter_num": "绘夏！烈日？度假村！其一",
  "chapter_title": "出发！无忧无虑的度假之旅？",
  "type": "lq",
  "route": "To a Carefree Vacation!",
  "stories": [
    {
      "story_id": 15039,
      "title": "出发！无忧无虑的度假之旅？",
      "description": "夏日再临，你与派蒙来到了特诺奇兹托克，准备迎接一场无忧无虑的度假之旅…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "先获得邀请函"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|悠悠度假村邀请函}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "噢，好酷炫的信封！一看就是纳塔风格。快拆开来看看里面写了什么吧？"
        },
        {
          "type": "subtitle",
          "text": "往事回想（「炽烈的还魂诗」回顾）"
        },
        {
          "role": "[[file",
          "text": "往事回想-炽烈的还魂诗.png|center|1100px]]"
        },
        {
          "type": "subtitle",
          "text": "为了在旅途的终点与血亲相会，你和派蒙来到了纳塔，认识了许多新的朋友。你们得知纳塔人已经持续与深渊对抗数千年之久，而此地的神明玛薇卡筹备了一个宏大的计划，意图终结这一切。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在推进计划的途中，你们见证了许多离别与伤痛，也感受到了生活在此地的人们的团结与勇气。终于，无数的冒险经历将你与纳塔串联起来，纳塔也终于战胜了名为深渊的强敌。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "这片土地即将迎接充满希望的未来，而救世者与牺牲者都会被永远铭记。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "查看邀请函"
        },
        {
          "type": "subtitle",
          "text": "色彩绚丽的邀请函"
        },
        {
          "type": "subtitle",
          "text": "英雄旅行者，久仰大名！我谨代表悠悠度假村全体工作人员向您及您的伙伴问好。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "正值盛夏，恰逢悠悠度假村投入试运营。为感谢您长久以来对纳塔提供的种种帮助，特邀您及您的伙伴前来特诺奇兹托克体验别样假期。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "试运营期间，度假村内食宿、游玩费用全包，凭此函更可免费尊享独栋景观套房，祝您旅途愉快！",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "嘟嘟，关键词捕捉完毕！「试运营期间食宿、游玩费用全包。」"
        },
        {
          "role": "派蒙",
          "text": "也就是说…又可以开启享受吃喝玩乐的假日模式了？"
        },
        {
          "role": "派蒙",
          "text": "那还等什么呢？目标是，特诺奇兹托克！"
        },
        {
          "type": "subtitle",
          "text": "后获得邀请函"
        },
        {
          "type": "subtitle",
          "text": "已完成迷林之子且未获得邀请函时直接前往悠悠度假村锚点",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "亚穆鲁",
          "text": "大英雄旅行者和他的搭档派蒙，欢迎来到悠悠度假村！"
        },
        {
          "role": "派蒙",
          "text": "噢，是认识我们的人！我记得…这里是叫特诺奇兹托克对吧？早说嘛，原来是个度假村啊！"
        },
        {
          "role": "亚穆鲁",
          "text": "哈哈，是你们来得巧了。度假村近期刚刚兴建，准确来说还没完全竣工…"
        },
        {
          "role": "亚穆鲁",
          "text": "总之，先收下这份邀请函吧。"
        },
        {
          "type": "subtitle",
          "text": "色彩绚丽的邀请函"
        },
        {
          "type": "subtitle",
          "text": "英雄旅行者，久仰大名！我谨代表悠悠度假村全体工作人员向您及您的伙伴问好。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "正值盛夏，恰逢悠悠度假村投入试运营。为感谢您长久以来对纳塔提供的种种帮助，特邀您及您的伙伴前来特诺奇兹托克体验别样假期。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "试运营期间，度假村内食宿、游玩费用全包，凭此函更可免费尊享独栋景观套房，祝您旅途愉快！",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "好像是说…试运营期间，在这里可以随便吃喝玩乐欸，而且…嘿嘿，「食宿、游玩费用全包」？"
        },
        {
          "role": "亚穆鲁",
          "text": "正是如此。请按心仪的节奏，尽情度过一段美妙的假日时光吧。"
        },
        {
          "role": "派蒙",
          "text": "好说！我很懂怎么玩。"
        },
        {
          "role": "亚穆鲁",
          "text": "那我就不多耽误二位的时间了，祝你们玩得愉快！"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|悠悠度假村邀请函}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "往事回想（「炽烈的还魂诗」回顾）"
        },
        {
          "role": "[[file",
          "text": "往事回想-炽烈的还魂诗.png|center|1100px]]"
        },
        {
          "type": "subtitle",
          "text": "为了在旅途的终点与血亲相会，你和派蒙来到了纳塔，认识了许多新的朋友。你们得知纳塔人已经持续与深渊对抗数千年之久，而此地的神明玛薇卡筹备了一个宏大的计划，意图终结这一切。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在推进计划的途中，你们见证了许多离别与伤痛，也感受到了生活在此地的人们的团结与勇气。终于，无数的冒险经历将你与纳塔串联起来，纳塔也终于战胜了名为深渊的强敌。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "这片土地即将迎接充满希望的未来，而救世者与牺牲者都会被永远铭记。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往特诺奇兹托克港口"
        },
        {
          "role": "派蒙",
          "text": "欸，那个人影是不是有点熟悉？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这不是班尼特嘛！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "…你的头巾非常帅噢！"
        },
        {
          "role": "阿夏",
          "text": "♪"
        },
        {
          "role": "班尼特",
          "text": "噢，你的意思…难道是在夸我的头巾也不错？哈哈，谢谢你！"
        },
        {
          "role": "派蒙",
          "text": "班尼特！还有一只长得有点特别的幻写灵！"
        },
        {
          "role": "班尼特",
          "text": "唔哇！旅行者和派蒙！我没看错吧？该不会是在梦里？"
        },
        {
          "role": "班尼特",
          "text": "我昨晚很早就入睡了…嗯，嗯…整理包裹的时候没有落下绷带…"
        },
        {
          "role": "班尼特",
          "text": "包括旅行者成为英雄，拯救纳塔的事迹…全都能回想起来！"
        },
        {
          "role": "派蒙",
          "text": "千真万确啦。"
        },
        {
          "role": "班尼特",
          "text": "这位是我新认识的朋友，一到这里它就跑来跟我打招呼了，真热情。"
        },
        {
          "role": "班尼特",
          "text": "我最近运气实在太好了吧！连手指都在发抖…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听上去终于转运了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "对！这阵子经历的好事已经多到连旅行日记都记不下了。"
        },
        {
          "role": "派蒙",
          "text": "噢！发生了什么？难道说…你中大奖了吗？"
        },
        {
          "role": "班尼特",
          "text": "这倒没有，我怎么会去参加抽奖活动呢，哈哈。"
        },
        {
          "role": "班尼特",
          "text": "我读给你们听啊…出发的第一天，没有跌进积水的坑里，没有错过游船。"
        },
        {
          "role": "班尼特",
          "text": "第五天，今天吃午饭的时候竟然没有被紫金渔鸥俯冲过来叼走，所以主动喂了一点面包，渔鸥很亲人…"
        },
        {
          "role": "班尼特",
          "text": "噢…到这里了！第十一天，成功买到纳塔小店里的折扣衣装，质量好棒！"
        },
        {
          "role": "班尼特",
          "text": "第十二天，从池子里顺利钓起了鲜活的河鱼…终于不是皮靴和垃圾了！"
        },
        {
          "type": "subtitle",
          "text": "你和派蒙眼含热泪…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "对于班尼特来说，好像的确比从前幸运了不少…"
        },
        {
          "role": "阿夏",
          "text": "？"
        },
        {
          "role": "班尼特",
          "text": "对吧？等这趟旅程结束，我要去好好谢谢那位店主，她给我推荐的幸运色真的管用！"
        },
        {
          "role": "派蒙",
          "text": "幸运色？…黄橙色吗？"
        },
        {
          "role": "班尼特",
          "text": "是湖蓝色噢！"
        },
        {
          "role": "班尼特",
          "text": "那天我路过一家水上用品店，逛了一圈没买什么东西。"
        },
        {
          "role": "班尼特",
          "text": "但店主仍然非常热情，说湖蓝色会很适合我，推荐我穿在身上。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像知道是谁了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "趁我的运气还在，旅行者和派蒙，有什么需要我帮忙的吗？"
        },
        {
          "role": "班尼特",
          "text": "有没有墨迹模糊的藏宝图，联络不上的委托人？好运的我一定能为你们解决麻烦！"
        },
        {
          "role": "派蒙",
          "text": "哎呀，这种时候就别说这话啦。现在可是度假时间，玩才是最重要的！"
        },
        {
          "role": "班尼特",
          "text": "好，那听你们的，有需要的话就跟我说。我还想趁难得的「好运状态」，多为朋友做一些有意义的事呢！"
        },
        {
          "role": "阿夏",
          "text": "♪"
        },
        {
          "role": "班尼特",
          "text": "当然，我们也是朋友了！结伴冒险吧！"
        },
        {
          "role": "远方的声音",
          "text": "噢！看见了！"
        },
        {
          "role": "远方的声音",
          "text": "那边的朋友们，注意注意！游船就要靠岸啦！"
        },
        {
          "role": "派蒙",
          "text": "什么动静？是从海那边传来的吗？"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "传说任务-出发！无忧无虑的度假之旅？-CG1-荧.png|600px|center]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "传说任务-出发！无忧无虑的度假之旅？-CG1-空.png|600px|center]]"
        },
        {
          "role": "玛拉妮",
          "text": "湛蓝色的海洋和满载幸运的鲨鲨冲浪板，准备好…要跟我一起加速了吗？"
        },
        {
          "role": "玛拉妮",
          "text": "再来深吸一口气，唔…呼，好，出发了！快点，再快点！"
        },
        {
          "role": "玛拉妮",
          "text": "把欢乐打包进浪花里，送给岸边的朋友吧！"
        },
        {
          "role": "玛拉妮",
          "text": "哟呼——"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "传说任务-出发！无忧无虑的度假之旅？-CG2-荧.png|600px|center]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "传说任务-出发！无忧无虑的度假之旅？-CG2-空.png|600px|center]]"
        },
        {
          "role": "派蒙",
          "text": "是玛拉妮！"
        },
        {
          "role": "班尼特",
          "text": "是店主！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是海浪！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "唉，这家伙真有本事，不管去哪都能把动静搞这么大…"
        },
        {
          "role": "玛拉妮",
          "text": "哈啊…海风就是要呼啦啦地往脸上吹才清凉畅快。"
        },
        {
          "role": "玛拉妮",
          "text": "哟呼~各位，看见我完美的着陆动作了吗？"
        },
        {
          "role": "恰斯卡",
          "text": "我看见旅行者及时把身边两位拉远了一点，不然你面前的人早就湿透了。"
        },
        {
          "role": "玛拉妮",
          "text": "啊哈哈，那也没关系嘛。太阳那么耀眼，随便一晒不就干喽。"
        },
        {
          "type": "subtitle",
          "text": "恰斯卡摇了摇头…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "恰斯卡",
          "text": "这位是？"
        },
        {
          "role": "班尼特",
          "text": "您好，我是班尼特！来自蒙德的冒险家！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是班尼冒险团团长。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "但还不是什么了不起的冒险团啦。我很羡慕纳塔到处都有传奇的冒险故事…"
        },
        {
          "role": "班尼特",
          "text": "部族的成员们身怀绝技，还和龙伙伴们配合无间，无论去哪，都能为人们荡平危难…听着就让人向往！"
        },
        {
          "role": "班尼特",
          "text": "我的话…咳…说是团长，其实常驻成员只有我一个人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我帮他打过工。",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "哪敢啊！请各位千万别当真，他在说笑呢。"
                },
                {
                  "role": "班尼特",
                  "text": "反过来倒差不多，虽然反过来也是我在拖他后腿…哈哈。"
                }
              ]
            },
            {
              "text": "我们曾经出生入死。",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "这都怪我太容易陷入险境了，真对不住…但这段时间我一直在努力训练自己，应该变强了不少！"
                }
              ]
            },
            {
              "text": "我们是朋友。",
              "dialogues": [
                {
                  "role": "班尼特",
                  "text": "谢谢你愿意这么说。能和旅行者成为朋友是我最自豪的事之一哦！"
                }
              ]
            }
          ]
        },
        {
          "role": "玛拉妮",
          "text": "新衣服不错！我就说湖蓝色适合你。早说是旅行者的朋友，我就送你些店里的小礼物了。"
        },
        {
          "role": "班尼特",
          "text": "你能愿意推荐幸运色给我，已经是最好的礼物了…呃，我该怎么称呼你？"
        },
        {
          "role": "玛拉妮",
          "text": "我是玛拉妮，开店之余也从事向导工作。这位是恰斯卡，「花羽会」的调停人，你可千万别惹到她噢！"
        },
        {
          "role": "班尼特",
          "text": "呃…不好意思，请问怎样才算「惹到」？"
        },
        {
          "role": "恰斯卡",
          "text": "我看得出你是个心思纯粹的冒险家，为人谦虚真诚，不用担心这个问题。"
        },
        {
          "role": "玛拉妮",
          "text": "哇，一见面就给那么高的评价！那我呢，恰斯卡？"
        },
        {
          "role": "玛拉妮",
          "text": "快看看我的眼睛，我的动作，我在想什么？"
        },
        {
          "role": "恰斯卡",
          "text": "我说过了，读心术不是「调停人」的必修课，我也不是能映照出你精神的曜石之镜。"
        },
        {
          "role": "玛拉妮",
          "text": "试试吧！前两次你都说对了。"
        },
        {
          "role": "恰斯卡",
          "text": "唉，你先停住把我的灵枪改造成水枪的想法再说，希诺宁不会答应的。"
        },
        {
          "role": "玛拉妮",
          "text": "准欸！"
        },
        {
          "role": "派蒙",
          "text": "哇，恰斯卡是怎么知道的？"
        },
        {
          "role": "恰斯卡",
          "text": "因为她在海上边冲浪边喊「好想要一把水枪啊」，喊了一路…我差点想学绒翼龙用翅膀捂住脑袋了。"
        },
        {
          "role": "玛拉妮",
          "text": "但水枪真的很有趣啊！有水仗打的夏天才算真正的夏天。"
        },
        {
          "role": "班尼特",
          "text": "我懂！我有个朋友{{黑幕|可莉}}…每次她一去湖边炸鱼，飞溅出来的水花都会从头到脚浇我一身，好过瘾。"
        },
        {
          "role": "玛拉妮",
          "text": "没错没错，玩水就是抛开一切束缚，痛痛快快、肆无忌惮地疯玩！"
        },
        {
          "role": "派蒙",
          "text": "亏你俩真有共同语言…"
        },
        {
          "role": "玛拉妮",
          "text": "不过我这次来度假村还另有目的，不光是为了玩水。"
