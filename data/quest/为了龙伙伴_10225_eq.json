{
  "quest_id": 10225,
  "chapter_num": "荣花竞捷之争 第一幕",
  "chapter_title": "为了龙伙伴",
  "type": "eq",
  "route": "For Our Saurian Companion",
  "stories": [
    {
      "story_id": 40177,
      "title": "为了龙伙伴",
      "description": "闲来无事，到「回声之子」逛逛吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往「回声之子」部族"
        },
        {
          "role": "派蒙",
          "text": "咦？这里怎么围了这么多人，出什么事了吗？"
        },
        {
          "role": "派蒙",
          "text": "走，我们过去看看吧！"
        },
        {
          "role": "帕加尔",
          "text": "怎么样，医生？它…还有救吗？"
        },
        {
          "role": "伊法",
          "text": "别急，哥们。我正在想办法呢。"
        },
        {
          "role": "伊法",
          "text": "它叫米莱是吗？真是个勇敢的棒小伙儿，痛成这样都一声不吭…它上过战场？"
        },
        {
          "role": "帕加尔",
          "text": "没错。按理来说不该让这么小的嵴锋龙上战场，但我们也拦不住它。米莱经常绕开我们的保护，偷偷跑到对抗深渊的最前线。"
        },
        {
          "role": "帕加尔",
          "text": "它很聪明，尽管没有强大的力量，但总是能把深渊魔物牵制得晕头转向。"
        },
        {
          "role": "帕加尔",
          "text": "战争结束后，我们还给它颁发过「战士勋章」。没想到这几天它的身体突然出了问题，时不时就会陷入昏迷。"
        },
        {
          "role": "伊法",
          "text": "小小年纪就是「久经沙场的老将」啊，难怪…"
        },
        {
          "role": "米莱",
          "text": "呜呜…"
        },
        {
          "role": "派蒙",
          "text": "卡齐娜，你们在这里做什么？"
        },
        {
          "role": "卡齐娜",
          "text": "旅行者、派蒙，好久不见。"
        },
        {
          "role": "卡齐娜",
          "text": "事情是这样的…我们部族有一只叫米莱的小嵴锋龙，不知道患了什么病，气息越来越弱。伊法哥哥正在帮它诊断。"
        },
        {
          "role": "卡齐娜",
          "text": "和它一起长大的尼娅也在，大家都很担心米莱的身体。"
        },
        {
          "role": "蒂雅卡",
          "text": "当初我的孩子在大山里迷路，就是它帮忙带回来的。"
        },
        {
          "role": "约洛华",
          "text": "它顽强地撑过了战争，难道却要在和平到来之后…唉。"
        },
        {
          "role": "咔库库",
          "text": "别担心哥们，会有办法的。"
        },
        {
          "role": "旅行者",
          "text": "你是…"
        },
        {
          "role": "派蒙",
          "text": "啊！是那只兽医诊所的「学舌怪怪龙」！"
        },
        {
          "role": "咔库库",
          "text": "你在胡说什么？"
        },
        {
          "role": "派蒙",
          "text": "这么说你刚刚提到的「伊法哥哥」，就是——"
        },
        {
          "role": "伊法",
          "text": "请各位「病龙家属」不要紧张，我大概知道问题出在哪了。"
        },
        {
          "role": "伊法",
          "text": "作为一只尚未成年的小龙，它在过去的战争中展现了令人敬佩的勇敢。然而正因为它年龄尚小，却透支身体使用了太多燃素…"
        },
        {
          "role": "伊法",
          "text": "它的体内出现了某种罕见的「病变」。最初的症状或许并不明显，拖到现在其实已经很严重了。"
        },
        {
          "role": "帕加尔",
          "text": "也就是说，它是在战争中患的病，只是现在才表现出来？"
        },
        {
          "role": "伊法",
          "text": "没错。或许是因为它一直在强撑着…很明显，它并不希望让自己的同伴感到担心。"
        },
        {
          "role": "尼娅",
          "text": "呜…呜！"
        },
        {
          "role": "米莱",
          "text": "呜…"
        },
        {
          "role": "卡齐娜",
          "text": "伊法哥哥，你应该有办法对吧？拜托你了！"
        },
        {
          "role": "伊法",
          "text": "像这种罕见病，我的手上也没有特效药。"
        },
        {
          "role": "伊法",
          "text": "不过有个好消息，我学医的时候翻到过类似的病症记录，织物中提到了两种不可或缺的「药材」。"
        },
        {
          "role": "伊法",
          "text": "第一样是「海风草」，多年生草本植物。到处都可能长，但数量却十分稀少。"
        },
        {
          "role": "伊法",
          "text": "第二样…我当时也没搞明白。织物中记载的名字是「圣火结晶」，除此之外没有太多描述。"
        },
        {
          "role": "派蒙",
          "text": "圣火…是圣火竞技场中燃烧的那个？"
        },
        {
          "role": "卡齐娜",
          "text": "我和玛拉妮参加归火圣夜巡礼的时候，在团体赛中收集过不少「角逐火簇」。"
        },
        {
          "role": "卡齐娜",
          "text": "据说那是圣火的「火星」，带在身上会觉得暖烘烘的。伊法哥哥说的「圣火结晶」…也是类似的东西吗？"
        },
        {
          "role": "伊法",
          "text": "从名字来看，应该是一种更为稀有、纯度更高的圣火吧。"
        },
        {
          "role": "派蒙",
          "text": "真的有那种东西吗？我们来纳塔这么久，好像也没见到过。"
        },
        {
          "role": "帕加尔",
          "text": "…似乎还真有。"
        },
        {
          "role": "卡齐娜",
          "text": "欸？！"
        },
        {
          "role": "卡齐娜",
          "text": "真的吗，帕加尔叔叔？"
        },
        {
          "role": "帕加尔",
          "text": "我也只是偶然听说过——据说很久很久以前，纳塔有办法产出一种特殊的「圣火结晶」。"
        },
        {
          "role": "帕加尔",
          "text": "具体方法我也不清楚，其他的首领也许知道什么…我去找他们商量一下。"
        },
        {
          "role": "帕加尔",
          "text": "谢谢你，伊法，你的诊断很有帮助。可以请你多留一会儿吗？"
        },
        {
          "role": "伊法",
          "text": "当然，我会等到有结果再走。"
        },
        {
          "role": "帕加尔",
          "text": "太好了。各位，暂时先散了吧，这么多人围在这里，米莱也不能好好休息。"
        },
        {
          "role": "帕加尔",
          "text": "后续有消息，我会第一时间告诉大家。希望它早日恢复健康。"
        },
        {
          "role": "伊法",
          "text": "初次见面，哥们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text":  "你好…？",
              "dialogues": [
                 {
          "role": "伊法",
          "text": "哈哈，不用这么紧张啦。"
        }
              ]
            },
            {
              "text": "久仰大名，哥们。",
              "dialogues": [
                 {
          "role": "伊法",
          "text": "哦？看来我们性格很合拍啊。"
        }
              ]
            }
          ]
        },
        {
          "role": "伊法",
          "text": "我叫伊法，花羽会的兽医。这是我的助手咔库库，喜欢学别人说话。"
        },
        {
          "role": "派蒙",
          "text": "我们是…"
        },
        {
          "role": "伊法",
          "text": "旅行者和派蒙，对吧？你们的故事在纳塔家喻户晓，我也早有耳闻。"
        },
        {
          "role": "伊法",
          "text": "兼具了勇气、智慧与实力…哥们，你们是我见过最了不起的英雄。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，说得我都有点不好意思啦。"
        },
        {
          "role": "伊法",
          "text": "说来惭愧，战争期间我在治疗受伤的龙，一直没机会和你们并肩战斗。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你救了很多龙，也很厉害。",
            "经验丰富的好医生啊。"
          ]
        },
        {
          "role": "伊法",
          "text": "谢谢你哥们，这话听得人心里暖暖的。"
        },
        {
          "role": "卡齐娜",
          "text": "那时候伊法哥哥的诊所一直排着长队，就连咔库库都忙得团团转呢。"
        },
        {
          "role": "咔库库",
          "text": "哎呀！哎呀！"
        },
        {
          "role": "伊法",
          "text": "是啊，战争期间，每天都会有新的伤员。"
        },
        {
          "role": "伊法",
          "text": "深渊非常狡猾，喜欢盯着部族的软肋，这些年倒在岗位上的医生也不在少数…"
        },
        {
          "role": "伊法",
          "text": "最近我还在给一些新人上课，希望他们早日成长起来。不过医术学起来很复杂，想成为合格的医生要经历许多考验。"
        },
        {
          "role": "旅行者",
          "text": "很辛苦啊…"
        },
        {
          "role": "伊法",
          "text": "其实就算学有所成，还是要面对许多棘手的疑难杂症。就像米莱患的病一样，罕见到之前甚至没人给它命名。"
        },
        {
          "role": "伊法",
          "text": "如果不是小时候被老爸逼着看了许多杂七杂八的知识，我大概也只能提出保守治疗。真是学无止境啊，哥们。"
        },
        {
          "role": "派蒙",
          "text": "欸？伊法的爸爸也是医生吗？"
        },
        {
          "role": "伊法",
          "text": "是啊，我家的医术是祖传的。小时候老爸就把我往医生的方向培养，带我认识各种草药，记不住就拿扫帚揍我。"
        },
        {
          "role": "伊法",
          "text": "我家世代都是兽医，不过最早是哪位先祖投身这个领域，我就不清楚了。"
        },
        {
          "role": "伊法",
          "text": "小时候好像听老爸讲过，这是「因愧疚而生的医术」…因什么而生不重要啦，重要的是它能派上用场。"
        },
        {
          "role": "派蒙",
          "text": "愧疚？一般来说做了错事才会愧疚吧，真是奇怪的说法。"
        },
        {
          "role": "伊法",
          "text": "谁知道呢，老爹去世后，现在也没人能问了。也许是因为作为医生，治不好病人时内心总有一种愧疚感，我也体会过。"
        },
        {
          "role": "伊法",
          "text": "所以这次，我也会努力治好米莱的病。印象里这种病还没有治愈的记录呢，米莱可能会成为第一只痊愈的小龙。"
        },
        {
          "role": "旅行者",
          "text": "加油哥们。"
        },
        {
          "role": "伊法",
          "text": "没问题哥们，相信我。"
        },
        {
          "type": "subtitle",
          "text": "又聊了一会儿天…",
          "narration": true,
          "color": "介绍"
        },
        {
          "role": "伊法",
          "text": "嗯？首领们好像回来了，先聊到这吧，去听听他们怎么说。"
        },
        {
          "type": "subtitle",
          "text": "向部族首领询问情况"
        },
        {
          "role": "瓦伊纳",
          "text": "上次来的时候，还看见它和阿尤在打闹，这也太突然了。"
        },
        {
          "role": "庇兰",
          "text": "所谓「病来如山倒」，一夜之间身体垮掉的情况不在少数。"
        },
        {
          "role": "穆托塔",
          "text": "战争期间就患上了病，能撑到现在已经很了不起了。"
        },
        {
          "role": "阿米娜",
          "text": "小家伙，你还好吗？会不会很痛？"
        },
        {
          "role": "阿卡特",
          "text": "小小年纪就在战场上出生入死，我们这些大人也有责任…"
        },
        {
          "role": "派蒙",
          "text": "哇，六个部族的首领聚在一起，这场面真少见。"
        },
        {
          "role": "瓦伊纳",
          "text": "哈哈，以前的确很少走动，光是自己部族的事情就够我们忙得焦头烂额。"
        },
        {
          "role": "瓦伊纳",
          "text": "现在嘛，休息日聚餐都快成常态了。不用惊讶。"
        },
        {
          "role": "阿卡特",
          "text": "聚餐？应该说「蹭饭」才对吧，每次都跑到我这里来，某些人脸皮比山崖还厚。"
        },
        {
          "role": "瓦伊纳",
          "text": "谁叫你做饭好吃呢？我们几个的手艺你也都见过了…咳，先说正事吧。"
        },
        {
          "role": "穆托塔",
          "text": "伊法，情况我们已经听说了，这次又是多亏了有你在。"
        },
        {
          "role": "穆托塔",
          "text": "米莱和其他嵴锋龙一起帮我们花羽会转运过物资，它的事我们不会坐视不管。"
        },
        {
          "role": "伊法",
          "text": "我也只是偶然在家里看过这种病的记录，但关于治病所需的「圣火结晶」就一无所知了。"
        },
        {
          "role": "阿米娜",
          "text": "我也没有听说过。圣火还有别的「形态」吗？"
        },
        {
          "role": "庇兰",
          "text": "有的。虽然我未曾亲眼见过，但织物里有关于它的记载。"
        },
        {
          "role": "庇兰",
          "text": "据说在很久以前的纳塔，除了「归火圣夜巡礼」外，还有一种产出圣火的手段，名为「荣花演武」。"
        },
        {
          "role": "庇兰",
          "text": "那是六个部族间的战斗演练。相较于归火圣夜巡礼，荣花演武的激烈程度更高，偶尔会产生一种更为纯净的圣火。"
        },
        {
          "role": "卡齐娜",
          "text": "圣火结晶？！"
        },
        {
          "role": "伊法",
          "text": "还有这种事？为什么我从来没听说过…"
        },
        {
          "role": "庇兰",
          "text": "很简单，因为荣花演武已经几百年没有举办过了。"
        },
        {
          "role": "旅行者",
          "text": "有什么隐情吗？"
        },
        {
          "role": "庇兰",
          "text": "最后一次举办的时候似乎出过事，因为时间太过久远，我也不了解详情。"
        },
        {
          "role": "庇兰",
          "text": "比较现实的理由是，最初人们相信「圣火结晶」有着非同寻常的力量，能够用来增强战士们的实力。"
        },
        {
          "role": "庇兰",
          "text": "后来发现它远没有那么神奇。它在一些少见的特殊场合有着无可替代的作用，但本质与普通圣火并无太大区别。"
        },
        {
          "role": "庇兰",
          "text": "归火圣夜巡礼已经能够产出足够的圣火，荣花演武就成了一种不必要的赛事，不再被提起。"
        },
        {
          "role": "伊法",
          "text": "原来如此。也就是说如果想救米莱，就必须要重新举办这个荣花演武。需要六个部族参与，听上去并不轻松…"
        },
        {
          "role": "瓦伊纳",
          "text": "我倒是觉得，没必要把它当成一件「麻烦事」。"
        },
        {
          "role": "瓦伊纳",
          "text": "需要六部族参与，但不需要所有人都到场吧。可以让空闲的战士们自愿报名，好好切磋一下。"
        },
        {
          "role": "瓦伊纳",
          "text": "战争结束后，归火圣夜巡礼也多了些竞技锻炼的味道。正好有一个新的舞台让战士们交流武艺，免得刀剑生锈。"
        },
        {
          "role": "穆托塔",
          "text": "和平年代也不能完全懈怠啊。这么一说，举办荣花演武还是很有必要的。"
        },
        {
          "role": "阿卡特",
          "text": "我同意。「决出最强部族」这种事，本身就让人热血沸腾。"
        },
        {
          "role": "庇兰",
          "text": "我没意见。"
        },
        {
          "role": "阿米娜",
          "text": "我回去和大家商量一下，肯定有不少人想要参加。"
        },
        {
          "role": "阿米娜",
          "text": "别人我不敢保证，玛拉妮肯定会来，她最喜欢这种热闹的场合了。"
        },
        {
          "role": "瓦伊纳",
          "text": "帕加尔不用问，肯定投赞成票吧？很好，全员通过。"
        },
        {
          "role": "派蒙",
          "text": "好耶！"
        },
        {
          "role": "帕加尔",
          "text": "谢谢各位…真的。"
        },
        {
          "role": "瓦伊纳",
          "text": "那我们先各自回部族，问问有多少人愿意报名。人多我们就把规模扩大一点，人少我们就简单地办一场。"
        },
        {
          "role": "穆托塔",
          "text": "嗯，既然是比赛，规则也很重要。不遵守任何规则的战斗只会变成纯粹的暴力，这肯定不是我们想看到的。"
        },
        {
          "role": "庇兰",
          "text": "具体的规则我来筹划。等下在话事处碰面吧，此事最终还需要火神大人准许。"
        },
        {
          "role": "阿米娜",
          "text": "对了，我记得想要治好米莱，还需要海风草。我们忙着举办荣花演武，谁去收集呢？"
        },
        {
          "role": "伊法",
          "text": "这个我有办法。刚刚我就注意到了，这里除了我们外，还来了一些米莱的「朋友」。"
        },
        {
          "role": "穆托塔",
          "text": "你是说…这些龙？的确，各种龙都有，我们这位小嵴锋龙朋友不少啊。"
        },
        {
          "role": "伊法",
          "text": "咔库库，帮我问问它们愿意帮忙吗？"
        },
        {
          "role": "咔库库",
          "text": "好的哥们，没问题哥们。"
        },
        {
          "role": "瓦伊纳",
          "text": "有一只会说话的龙伙伴真好啊，让人羡慕。"
        },
        {
          "role": "阿卡特",
          "text": "没什么事，就先散了？"
        },
        {
          "role": "穆托塔",
          "text": "走吧，待会儿见。"
        },
        {
          "role": "穆托塔",
          "text": "伊法，你跟我一起回去吧。带上这些龙，教教它们怎么辨认海风草。"
        },
        {
          "role": "阿米娜",
          "text": "再见了，小家伙，下次我们再来探望你。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…好快的速度。"
        },
        {
          "role": "派蒙",
          "text": "不愧是各部族的首领，决定了的事情，马上就开始做了。"
        },
        {
          "role": "旅行者",
          "text": "派蒙就喜欢讲「明天再说」。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，这不是有你在嘛。我已经发现了，有些事稍微拖一拖，你就会帮我解决掉啦。"
        },
        {
          "role": "咔库库",
          "text": "哦天哪，不会吧哥们！"
        },
        {
          "role": "卡齐娜",
          "text": "连咔库库都听不下去了…"
        },
        {
          "role": "帕加尔",
          "text": "我去把这事跟其他人说说，卡齐娜，你要不要报名参加？"
        },
        {
          "role": "卡齐娜",
          "text": "我、我要报名！"
        },
        {
          "role": "帕加尔",
          "text": "那你跟我一起来吧。旅行者、派蒙，我们等会儿在话事处再见。"
        },
        {
          "role": "派蒙",
          "text": "再见啦！"
        },
        {
          "role": "派蒙",
          "text": "一切都很顺利呢！太好了，很快它就能得救啦。"
        },
        {
          "role": "米莱",
          "text": "呜…"
        },
        {
          "role": "派蒙",
          "text": "咦，你醒了吗？要不要再睡会儿？"
        },
        {
          "role": "米莱",
          "text": "呜呜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "感觉…",
            "它好像有什么话想说？"
          ]
        },
        {
          "role": "派蒙",
          "text": "欸？这样吗？难道是肚子饿了？"
        },
        {
          "role": "派蒙",
          "text": "咔库库——喂——帮忙翻译一下——"
        },
        {
          "role": "派蒙",
          "text": "已经走远了！唔，它看上去确实有点着急，到底想说什么呢？"
        },
        {
          "type": "subtitle",
          "text": "魂附嵴锋龙与小龙交流"
        },
        {
          "role": "旅行者",
          "text": "（荣花演武的事情顺利敲定，圣火结晶的问题就解决了。海风草也有米莱的龙朋友去收集，应该没什么事了才对…）"
        },
        {
          "role": "旅行者",
          "text": "（不过米莱为什么看上去很着急呢？难道是病情有变化？以防万一，还是直接去问问它吧。）"
        },
        {
          "role": "米莱",
          "text": "呼…咳咳…"
        },
        {
          "role": "尼娅",
          "text": "米莱，你还好吗？想不想吃点什么？"
        },
        {
          "role": "尼娅",
          "text": "我、我去给你摘果子吃好不好？"
        },
        {
          "role": "米莱",
          "text": "谢谢你照顾我，尼娅。我没事…"
        },
        {
          "role": "旅行者",
          "text": "米莱，尼娅。"
        },
        {
          "role": "尼娅",
          "text": "咦，你是…？"
        },
        {
          "role": "尼娅",
          "text": "是没见过的龙耶，你也是来探望米莱的吗？"
        },
        {
          "role": "旅行者",
          "text": "是呀。我想告诉你们不用担心，那些人类朋友已经有办法治好你了。"
        },
        {
          "role": "旅行者",
          "text": "很快我们就能收集到足够的海风草和圣火结晶，再坚持一下，距离康复的日子不远了。"
        },
        {
          "role": "米莱",
          "text": "圣火结晶…咳咳。"
        },
        {
          "role": "尼娅",
          "text": "米莱…"
        },
        {
          "role": "米莱",
          "text": "我就是担心这个。那些善良的人类朋友肯定还不知道，圣火结晶其实是超级危险的坏东西。"
        },
        {
          "role": "旅行者",
          "text": "坏东西？"
        },
        {
          "role": "米莱",
          "text": "嗯。它能蛊惑人心，让好朋友变成仇人。一定要小心…"
        },
        {
          "role": "旅行者",
          "text": "（米莱挣扎着还想说些什么，但很快就陷入了昏迷。）"
        },
        {
          "role": "旅行者",
          "text": "（「蛊惑人心」？之前首领们完全没有提到这个问题。难道说使用圣火结晶有不为人知的风险？）"
        },
        {
          "role": "旅行者",
          "text": "（不对。比起这个…就连见多识广的首领们都不知道的事，米莱和尼娅是从哪里听说的？）"
        },
        {
          "role": "旅行者",
          "text": "尼娅，你们是怎么知道圣火结晶有危险的？"
        },
        {
          "role": "尼娅",
          "text": "我们和那些大怪兽砰砰锵锵打架的时候，认识了一个神秘的绒翼龙朋友，是它告诉我们的。"
        },
        {
          "role": "尼娅",
          "text": "还记得米莱第一次昏倒的时候，我们的朋友在旁边急得团团转…"
        },
        {
          "role": "？？？",
          "text": "又是这个病…只要有海风草和圣火结晶…"
        },
        {
          "role": "？？？",
          "text": "可是圣火结晶会蛊惑人类，让好朋友变成仇人。我该怎么办…"
        },
        {
          "role": "旅行者",
          "text": "绒翼龙朋友？它又是从哪知道的呢？"
        },
        {
          "role": "尼娅",
          "text": "我也不知道。它经常讲一些我们也听不懂的话，没有别的小龙愿意跟它玩，它好像也没有人类伙伴。"
        },
        {
          "role": "尼娅",
          "text": "不过它肯定不会骗我们。它救过我们很多次，我们关系很好的。"
        },
        {
          "role": "尼娅",
          "text": "我很希望米莱的病能够早点好起来。但是，如果圣火结晶真的很危险…我觉得它肯定不希望自己用这种方式得救。"
        },
        {
          "role": "旅行者",
          "text": "放心吧，有我在呢。"
        },
        {
          "role": "旅行者",
          "text": "我会提醒那些人类朋友注意安全，你照顾好米莱，让它不用担心，好好养病。"
        },
        {
          "role": "尼娅",
          "text": "真的吗？谢谢你！"
        },
        {
          "role": "旅行者",
          "text": "（谜团真是越来越多了。虽然有玛薇卡和六位首领在，应该不会有什么问题，但还是找机会跟玛薇卡聊聊吧。）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（米莱&尼娅）魂附状态"
        },
        {
          "role": "米莱",
          "text": "……"
        },
        {
          "role": "尼娅",
          "text": "米莱…你一定要早点好起来呀。我还有很多话想对你说呢。"
        },
        {
          "type": "subtitle",
          "text": "前往「话事处」见玛薇卡"
        },
        {
          "role": "玛薇卡",
          "text": "你们的提案我看过了，很不错。"
        },
        {
          "role": "玛薇卡",
          "text": "就算没有米莱的事情，举办荣花演武也很有意义。报名的人多吗？"
        },
        {
          "role": "瓦伊纳",
          "text": "比我们预想的多多了。"
        },
        {
          "role": "穆托塔",
          "text": "战士们的热情都很高。来晚了的战士围在报名处外抗议，最后我们还破例增加了一些名额。"
        },
        {
          "role": "庇兰",
          "text": "因为人数太多，最后不得不划分出正赛和表演赛。正赛的对抗限制在两个部族之间，表演赛则是三对三的混战。"
        },
        {
          "role": "庇兰",
          "text": "我打算限制表演赛的名额。混战很容易出现意外，人少一些可以确保伤员被及时救治。"
        },
        {
          "role": "玛薇卡",
          "text": "考虑得很周到嘛。我同意，经费的事情我来想办法。"
        },
        {
          "role": "帕加尔",
          "text": "多谢火神大人。"
        },
        {
          "role": "玛薇卡",
          "text": "比赛在哪举办？等会儿我也去看看。不过我就不参赛了，免得大家打不尽兴。"
        },
        {
          "role": "帕加尔",
          "text": "主会场我们选在圣火竞技场附近，具体的比赛设立在各个部族周围。"
        },
        {
          "role": "玛薇卡",
          "text": "好，我的问题问完了。大家去忙吧，辛苦了。"
        },
        {
          "role": "阿米娜",
          "text": "那我们先行告退，去组织人手布置比赛现场。"
        },
        {
          "role": "阿卡特",
          "text": "旅行者、派蒙…加油吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯？加油？什么加油？"
        },
        {
          "role": "玛薇卡",
          "text": "好久不见，两位。你们也是为荣花演武的事情来的吗？"
        },
        {
          "role": "派蒙",
          "text": "是呀，看来一切都很顺利呢。"
        },
        {
          "role": "玛薇卡",
          "text": "荣花演武…真是个让人怀念的名字。以前我从爸爸那里听说过，他也是听我爷爷讲的。"
        },
        {
          "role": "派蒙",
          "text": "也就是说，上次举办荣花演武，至少是在五百年前…不对，比五百年还要早很多？"
        },
        {
          "role": "派蒙",
          "text": "哇，这么一说还有一种不真实的感觉呢。我们居然在做一件这么久都没人做过的事情！"
        },
        {
          "role": "玛薇卡",
          "text": "不过我有一种预感，我们一定会成功的，放心吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "玛薇卡了解圣火结晶吗？",
            "圣火结晶有什么危害吗？"
          ]
        },
        {
          "role": "玛薇卡",
          "text": "为什么这么问？"
        },
        {
          "role": "旅行者",
          "text": "有传闻说圣火结晶会蛊惑人心…"
        },
        {
          "role": "玛薇卡",
          "text": "嗯…我从来没有听说过这种传闻。而且理性分析，这应该是不可能的。"
        },
        {
          "role": "玛薇卡",
          "text": "长久以来，还魂诗的规则庇佑纳塔，而这套规则运转的燃料就是圣火。纳塔一直与圣火打交道，从未发现它有什么异常。"
        },
        {
          "role": "玛薇卡",
          "text": "圣火结晶不过是另一种形式的圣火，我无法想象它要如何「蛊惑人心」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "确实。",
            "我也很难想象。"
          ]
        },
        {
          "role": "玛薇卡",
          "text": "放心吧，就算它真有什么邪恶的力量，在如今的纳塔也掀不起风浪，我会出手解决。"
        },
        {
          "role": "玛薇卡",
          "text": "现在最重要的还是办好荣花演武，收集足够多的圣火结晶，让那只小嵴锋龙恢复健康。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，有玛薇卡在，真让人安心。"
        },
        {
          "role": "玛薇卡",
          "text": "不过，有的事我可就帮不上忙了。"
        },
        {
          "role": "玛薇卡",
          "text": "我刚刚就察觉到，门外有人在等你们呢。"
        },
        {
          "role": "派蒙",
          "text": "欸？谁呀？"
        },
        {
          "role": "玛薇卡",
          "text": "见面就知道了…快去吧，别让他们等着急了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（玛薇卡）"
        },
        {
          "role": "玛薇卡",
          "text": "新的比赛、新的锻炼…或许也会带来新的故事。"
        },
        {
          "type": "subtitle",
          "text": "离开「话事处」"
        },
        {
          "role": "玛拉妮",
          "text": "终于来了！"
        },
        {
          "role": "伊安珊",
          "text": "旅行者、派蒙，其实——"
        },
        {
          "role": "玛拉妮",
          "text": "停停！先来后到！我是第一个！"
        },
        {
          "role": "派蒙",
          "text": "怎、怎么回事！大家怎么都来了？"
        },
        {
          "role": "卡齐娜",
          "text": "其实…"
        },
        {
          "role": "玛拉妮",
          "text": "咳，荣花演武不是要开始了吗？你有没有想好加入哪个部族？没有的话，要不要来我们流泉之众？"
        },
        {
          "role": "派蒙",
          "text": "欸？欸——！！"
        },
        {
          "role": "派蒙",
          "text": "我们也能参赛吗？"
        },
        {
          "role": "基尼奇",
          "text": "和归火圣夜巡礼不同，荣花演武已经很久没有举办了，我们会重新创立一套新的规则。"
        },
        {
          "role": "欧洛伦",
          "text": "首领们也同意了。不过，要不要参赛、要支持哪个部族，还是取决于你们的想法…"
        },
        {
          "role": "恰斯卡",
          "text": "作为拯救纳塔的英雄，你在哪个部族，哪个部族就会士气高涨。现在拉你入伙可是各部族的头等大事。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样！刚才阿卡特首领让我们「加油」…他早就知道会是这个情况了！"
        },
        {
          "role": "玛拉妮",
          "text": "哼哼，闲话少说，这次我可是带着「诚意」来的。"
        },
        {
          "role": "玛拉妮",
          "text": "听好了——我准备了豪华温泉招待券！还有我们商店的精美礼品！"
        },
        {
          "role": "派蒙",
          "text": "豪华温泉！感觉很适合度假！"
        },
        {
          "role": "基尼奇",
          "text": "来悬木人的话，我们会为你们举办烧烤聚会。食材都是最顶级的肉，不限量。"
        },
        {
          "role": "阿乔",
          "text": "现在加入，还有机会成为伟大圣龙库胡勒阿乔的小弟！"
        },
        {
          "role": "基尼奇",
          "text": "这个没人想要。"
        },
        {
          "role": "阿乔",
          "text": "基尼奇——你这小混蛋——"
        },
        {
          "role": "派蒙",
          "text": "不限量的烤肉…咕噜…"
        },
        {
          "role": "伊安珊",
          "text": "加入沃陆之邦的话，我可以提供一年的训练指导，还有饮食规划。可以让你们变得更强。"
        },
        {
          "role": "派蒙",
          "text": "唔…虽然我不想训练，但如果能变强的话…！"
        },
        {
          "role": "欧洛伦",
          "text": "我这边只有现摘的蔬菜。不过真的很好吃。"
        },
        {
          "role": "派蒙",
          "text": "我想尝尝看！"
        },
        {
          "role": "恰斯卡",
          "text": "带你们体验飞行课程？或者我亲自带你们去天空翱翔好了。"
        },
        {
          "role": "派蒙",
          "text": "虽然我自己会飞，但如果能和旅行者一起飞来飞去，好像也不错。"
        },
        {
          "role": "卡齐娜",
          "text": "我，我会烤龙龙饼干，还有粒果片片！"
        },
        {
          "role": "派蒙",
          "text": "呜呜，这个我也想吃…好难抉择呀。"
        },
        {
          "role": "派蒙",
          "text": "不仅仅是奖品都很棒，还有一种「一旦选了某个部族，就对不起其他人」的感觉…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，交给你了，你肯定有办法吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那就都加入吧。",
            "「杜麦尼」属于整个纳塔。"
          ]
        },
        {
          "role": "派蒙",
          "text": "不，这应该不太可能吧…"
        },
        {
          "role": "基尼奇",
          "text": "其实也是个不错的主意。至少表演赛行得通。"
        },
        {
          "role": "基尼奇",
          "text": "表演赛是三个部族对三个部族。上半场{M他}{F她}来帮我们，下半场反过来，这样就公平了。"
        },
        {
          "role": "欧洛伦",
          "text": "还有这种办法，学到了。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？那刚刚提到的奖励…嘿嘿…"
        },
        {
          "role": "玛拉妮",
          "text": "至少我这份诚意是不会少的。出来玩，开心最重要！"
        },
        {
          "role": "基尼奇",
          "text": "那就这么说定了？上半场的表演赛，你跟我们悬木人，还有流泉之众与回声之子一起战斗，对抗另外三个部族。"
        },
        {
          "role": "玛拉妮",
          "text": "哈哈，感觉又回到了从前并肩作战的时候，我们这个组合肯定是无敌的！"
        },
        {
          "role": "基尼奇",
          "text": "时间差不多了。做好准备，我们一起过去吧。"
        },
        {
          "type": "subtitle",
          "text": "参加上半场表演赛"
        },
        {
          "role": "派蒙",
          "text": "这里就是我们的营地了。按照规则，只要连续占领对方的三个营地，就是我们的胜利了！"
        },
        {
          "role": "旅行者",
          "text": "讨论一下作战计划吧。"
        },
        {
          "role": "阿乔",
          "text": "哼哼，伟大的圣龙库胡勒阿乔只需略微出手，就能轻松把一切烧成灰！"
        },
        {
          "role": "基尼奇",
          "text": "要是你干扰了作战，我就把你关到比赛结束。"
        },
        {
          "role": "阿乔",
          "text": "嘁…小气鬼！"
        },
        {
          "role": "玛拉妮",
          "text": "嘿嘿，我们这次可是黄金组合，只要一路打过去就好了吧。"
        },
        {
          "role": "基尼奇",
          "text": "嗯，我们几个比较熟悉，能互相配合。但还是要谨慎行事。"
        },
        {
          "role": "基尼奇",
          "text": "这附近有很多山壁，我们的视野会被阻挡，对方却可以躲在高处袭击。"
        },
        {
          "role": "玛拉妮",
          "text": "既然这样，我们就从水路前进吧！"
        },
        {
          "role": "玛拉妮",
          "text": "你们看那边的旗帜，那就是沃陆之邦的营地了吧？"
        },
        {
          "role": "玛拉妮",
          "text": "从水面快速接近，一口气抢占营地，然后再向高处进发！"
        },
        {
          "role": "基尼奇",
          "text": "嗯，我同意。"
        },
        {
          "role": "卡齐娜",
          "text": "我也相信玛拉妮的判断。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那就来个迅猛的开场吧。",
            "打对方一个措手不及。"
          ]
        },
        {
          "role": "玛拉妮",
          "text": "好耶，又到了我和「鲨鲨冲浪板」大展身手的时候啦！"
        },
        {
          "role": "玛拉妮",
          "text": "我来打头阵，你们跟紧我哦！"
        },
        {
          "type": "subtitle",
          "text": "进攻「沃陆之邦」营地"
        },

        {
          "role": "伊安珊",
          "text": "果然选择走水路过来了呢。很符合流泉之众的风格。"
        },
        {
          "role": "玛拉妮",
          "text": "咦？猜到我们的行动了吗？"
        },
        {
          "role": "基尼奇",
          "text": "没办法，只能正面对决了。"
        },
        {
          "role": "卡齐娜",
          "text": "我准备好了！"
        },
        {
          "role": "伊安珊",
          "text": "好，来场酣畅淋漓的角力吧！"
        },
         {
          "type": "subtitle",
          "text": "击败营地守卫并更换旗帜"
        },
        {
          "role": "伊安珊",
          "text": "不错的练习。今天就到这里吧。"
        },
        {
          "role": "卡齐娜",
          "text": "呼，赢了…"
        },
        {
          "role": "玛拉妮",
          "text": "嘿嘿，我们配合得越来越好了。"
        },
        {
          "role": "基尼奇",
          "text": "还早呢，去下一个地方吧。"
        },
        {
          "role": "玛拉妮",
          "text": "等一下…临走前，别忘了把我们的旗帜插在这里，这可是我们获胜的证明！"
        },
        {
          "type": "subtitle",
          "text": "更换旗帜",
          "narration": true,
          "color": "介绍"
        },
        {
          "type": "subtitle",
          "text": "进攻「烟谜主」营地"
        },
        {
          "role": "基尼奇",
          "text": "山壁上面就是烟谜主的营地了。"
        },
        {
          "role": "派蒙",
          "text": "呃…附近的山壁都被晶簇挡住了。看起来是不想让我们轻易地上去呢。"
        },
        {
          "role": "卡齐娜",
          "text": "没关系，交给「冲天转转」就好。"
        },
        {
          "role": "玛拉妮",
          "text": "加油，卡齐娜！"
        },
        {
          "role": "欧洛伦",
          "text": "旅行者爷爷，你们总算来了。"
        },
        {
          "role": "欧洛伦",
          "text": "要是我回去得太晚，家里的蔬菜会口渴的…"
        },
        {
          "role": "玛拉妮",
          "text": "没关系，很快就会结束了！"
        },
        {
          "type": "subtitle",
          "text": "击败营地守卫并更换旗帜"
        },
        {
          "role": "玛拉妮",
          "text": "好，烟谜主的营地也顺利攻下了。"
        },
        {
          "role": "卡齐娜",
          "text": "看，那边的山上，是花羽会的旗帜。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，看起来他们已经严阵以待了呢。"
        },
        {
          "role": "基尼奇",
          "text": "嗯，他们居高临下，机动性又强。以我们现在的兵力，强攻会比较困难。"
        },
        {
          "role": "希诺宁",
          "text": "看来我到得正是时候。"
        },
        {
          "role": "派蒙",
          "text": "哇，希诺宁也来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "之前就听说会有援兵…",
            "来了可靠的伙伴呢。"
          ]
        },
        {
          "role": "希诺宁",
          "text": "好了，寒暄的话等打完之后再说。"
        },
        {
          "role": "基尼奇",
          "text": "有了援手，我们就可以兵分两路了。"
        },
        {
          "role": "希诺宁",
          "text": "嗯，我带人从正面突破，消耗对方的火力。"
        },
        {
          "role": "希诺宁",
          "text": "你们找别的路线上去，直接杀入大本营。"
        },
        {
          "role": "玛拉妮",
          "text": "嘿嘿，这下我们可算是胜券在握了！"
        },
        {
          "type": "subtitle",
          "text": "绕后突袭「花羽会」营地"
        },

        {
          "role": "恰斯卡",
          "text": "哦？居然突破了我方的防守。"
        },
        {
          "role": "恰斯卡",
          "text": "不过现在才是开始，当心。"
        },
        {
          "role": "卡齐娜",
          "text": "我们不会输的！"
        },
        {
          "role": "基尼奇",
          "text": "嗯，大家一起上。"
        },
        {
          "role": "玛拉妮",
          "text": "好，互相都打个尽兴吧！"
        },
        {
          "type": "subtitle",
          "text": "击败营地守卫并更换旗帜"
        },
        {
          "role": "卡齐娜",
          "text": "这算是赢了吗？太好了…"
        },
        {
          "role": "玛拉妮",
          "text": "嘿嘿，我们果然是黄金组合！"
        },
        {
          "role": "基尼奇",
          "text": "嗯，相当畅快的一次战斗。"
        },
        {
          "role": "希诺宁",
          "text": "是啊，我刚刚还在山腰，跟绒翼龙骑士大打出手，不久就听说大本营被你们攻陷了。"
        },
        {
          "role": "希诺宁",
          "text": "你们干得很漂亮嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "多亏了希诺宁的援护…",
            "我们才能顺利攻上大本营。"
          ]
        },
        {
          "role": "派蒙",
          "text": "是呀，要不然光靠我们一路打上来，那可真是够呛…"
        },
        {
          "role": "希诺宁",
          "text": "圣火结晶呢？有人收集到了吗？"
        },
        {
          "role": "玛拉妮",
          "text": "我捡到了几块，可惜只有粒果片片那么大。回来的路上顺手交给烟谜主的工作人员了。"
        },
        {
          "role": "茜特菈莉",
          "text": "嗯，我收到了。"
        },
        {
          "role": "派蒙",
          "text": "茜特菈莉奶奶！连你也来参加荣花演武了吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "正赛用的术式是我发明的，我当然要过来。"
        },
        {
          "role": "茜特菈莉",
          "text": "见我在场，你说的那些工作人员就把圣火结晶都交给我了。"
        },
        {
          "role": "茜特菈莉",
          "text": "我清点了一下，按这个速度，比赛结束前应该可以收集到足够的数量。"
        },
        {
          "role": "玛拉妮",
          "text": "太好啦！"
        },
        {
          "role": "旅行者",
          "text": "（茜特菈莉也没看出圣火结晶有什么异样，难道真的是我多虑了吗？）"
        },
        {
          "role": "玛拉妮",
          "text": "既然一切顺利，我们晚上去泡温泉怎么样？"
        },
        {
          "role": "希诺宁",
          "text": "我同意，收工之后的休闲时光，就是要吃好喝好。"
        },
        {
          "role": "卡齐娜",
          "text": "那我们一起过去吧？我用冲天转转带大家去。"
        },
        {
          "role": "希诺宁",
          "text": "抱歉，我得先回一趟工坊，有几样锻造委托要收尾。还是今晚在流泉之众碰面吧。"
        },
        {
          "role": "玛拉妮",
          "text": "正好我也要去店里帮忙，顺便再去买点零食。大家晚上不见不散！"
        },
        {
          "role": "基尼奇",
          "text": "我可能会晚一点到。你们人齐了可以先开始。"
        },
        {
          "role": "派蒙",
          "text": "好耶，我已经迫不及待啦！"
        },
        {
          "role": "卡齐娜",
          "text": "好、好的！"
        },
        {
          "role": "卡齐娜",
          "text": "那我也先走了，今晚再见。"
        },
        {
          "role": "玛拉妮",
          "text": "快来快来！就差你们啦！"
        },
        {
          "role": "玛拉妮",
          "text": "走，我先带你们换衣服去。"
        },
        {
          "role": "玛拉妮",
          "text": "你应该记得更衣室在哪吧？第一次来的时候，也是我带你们去的呢。"
        },
        {
          "role": "玛拉妮",
          "text": "一晃都过去这么久了——啊，感慨的话等会儿再说！走啦！"
        },
        {
          "type": "subtitle",
          "text": "在熟悉的地方换好了衣服…",
          "narration": true,
          "color": "介绍"
        },
        {
          "role": "玛拉妮",
          "text": "呜呼！狂欢开始了！"
        },
        {
          "role": "阿乔",
          "text": "舒坦！我准许了，今后这片温泉就冠以伟大圣龙之名吧！"
        },
        {
          "role": "派蒙",
          "text": "疲惫都飞走啦，要是能每天都来泡温泉就好了。"
        },
        {
          "role": "卡齐娜",
          "text": "希诺宁姐姐不去泡温泉吗？"
        },
        {
          "role": "希诺宁",
          "text": "我不喜欢待在水里，这里更适合我。"
        },
        {
          "role": "基尼奇",
          "text": "…最后一道，「山与海与天空」。"
        },
        {
          "role": "派蒙",
          "text": "啊！我闻到香味了！"
        },
        {
          "role": "派蒙",
          "text": "等一下等一下，吃饭要紧，我现在就过去！"
        },
        {
          "role": "阿乔",
          "text": "哈哈！看招看招！基尼奇，见识到我的厉害了吧！"
        },
        {
          "role": "玛拉妮",
          "text": "喂！阿乔，水都甩到这边来啦！"
        },
        {
          "role": "希诺宁",
          "text": "呼…"
        },
        {
          "role": "派蒙",
          "text": "真好吃！旅行者，你也尝尝看！"
        },
        {
          "role": "卡齐娜",
          "text": "……"
        },
        {
          "role": "玛拉妮",
          "text": "卡齐娜——别发呆了，我做了「龙龙饼干」，一起来吃吧？"
        },
        {
          "role": "卡齐娜",
          "text": "啊…好，好的！我现在就来！"
        },
        {
          "role": "阿乔",
          "text": "可恶的基尼奇！放开我——！！"
        },
        {
          "type": "subtitle",
          "text": "在热闹的氛围中结束了今天的聚会，之后众人各自散去…"
        },
        {
          "role": "玛拉妮",
          "text": "呼，辛苦你们留下来帮我收拾啦。"
        },
        {
          "role": "派蒙",
          "text": "没事没事，我们也玩得很开心！"
        },
        {
          "role": "玛拉妮",
          "text": "有你们在的聚会总是格外热闹，真好。"
        },
        {
          "role": "玛拉妮",
          "text": "对了，今天吃饭的时候，总感觉卡齐娜好像有什么心事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我也感觉到了。",
            "表演赛结束时就有点不对劲…"
          ]
        },
        {
          "role": "玛拉妮",
          "text": "唔…真奇怪，以前有烦恼她一般会找我商量的。"
        },
        {
          "role": "玛拉妮",
          "text": "也许这次的烦恼比较特别？拜托了，只能靠你们帮忙打听啦。"
        },
        {
          "role": "派蒙",
          "text": "包在我们身上！下次独处的时候，我们去问问卡齐娜。"
        },
        {
          "role": "派蒙",
          "text": "如果能帮上忙，我和旅行者肯定不会坐视不管的！"
        },
        {
          "role": "玛拉妮",
          "text": "那我就放心了。"
        },
        {
          "role": "玛拉妮",
          "text": "我也走啦，欢迎你们随时来流泉之众找我玩。"
        },
        {
          "role": "派蒙",
          "text": "再见，改天见！"
        },

        {
          "type": "subtitle",
          "text": "额外对话（玛拉妮）玛拉妮的水上用品店前"
        },
        {
          "role": "玛拉妮",
          "text": "好…这个手套带上，这个滑板也带上。"
        },
        {
          "role": "玛拉妮",
          "text": "今天的幸运色…应该是粉蓝色来着？可惜，现在不能去找茜特菈莉问问…"
        },
        {
          "role": "玛拉妮",
          "text": "对了，还要写个告示牌放在店里…"
        },
        {
          "role": "玛拉妮",
          "text": "「店主暂时不在，需要的东西直接取走就好，钱放在旁边的袋子里…」"
        },
        {
          "role": "玛拉妮",
          "text": "「如果暂时没钱的话，也直接取走就好…」"
        },
        {
          "role": "玛拉妮",
          "text": "「大家玩得开心！」"
        },
        {
          "role": "玛拉妮",
          "text": "唔，写成「玩」好像不太合适…？"
        },
        {
          "role": "玛拉妮",
          "text": "「大家热热闹闹，一起开心吧！」"
        },
        {
          "role": "玛拉妮",
          "text": "改成这样就好了，嗯，我也该出发啦！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（瓦雷莎&伊安珊）比赛会场"
        },
        {
          "role": "瓦雷莎",
          "text": "痛痛痛…木屑飘进眼睛里了。伊安珊老师，帮帮…"
        },
        {
          "role": "伊安珊",
          "text": "你把眼睛睁开，我帮你吹吹。"
        },
        {
          "role": "瓦雷莎",
          "text": "呜…痛得睁不开，眼泪也流个不停…"
        },
        {
          "role": "伊安珊",
          "text": "所以我让你至少戴个护目镜…"
        },
        {
          "role": "伊安珊",
          "text": "先躺好，我去找点水帮你冲洗一下。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊法）比赛会场"
        },
        {
          "role": "伊法",
          "text": "听话哥们，不要害怕，只是一点小伤。"
        },
        {
          "role": "伊法",
          "text": "别担心，这不是真正的战争，只是演习而已，你的伙伴很安全。"
        },
        {
          "role": "伊法",
          "text": "等你恢复好，就可以继续投入战斗了，现在就好好休息吧。"
        },
        {
          "role": "伊法",
          "text": "稍后我会让你的伙伴来陪你，不要乱动，不然会影响伤口痊愈。"
        },
        {
          "role": "伊法",
          "text": "乖孩子，先睡一会吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（夏洛蒂）比赛会场"
        },
        {
          "role": "夏洛蒂",
          "text": "「纳塔战火再起，六部族谁能争先…」"
        },
        {
          "role": "夏洛蒂",
          "text": "只要把这部长篇报道写完，下周下下周的头条肯定全都是我的了。"
        },
        {
          "role": "夏洛蒂",
          "text": "不枉我从枫丹千辛万苦地跑过来…虽然只带了一台留影机，但也足够了。"
        },
        {
          "role": "夏洛蒂",
          "text": "还要再去采访几位选手…对了，听说火神会在那个竞技场里现身…"
        },
        {
          "role": "夏洛蒂",
          "text": "要是能拍到她的画面，那就赚大了！"
        },
        {
          "role": "夏洛蒂",
          "text": "嘿嘿，嘿嘿嘿，嘿嘿嘿嘿…"
        }
      ],
      "collapse_ranges": [
