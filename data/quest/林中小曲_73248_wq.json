{
  "quest_id": 73248,
  "chapter_num": null,
  "chapter_title": "林中小曲",
  "type": "wq",
  "route": "Encounter in the Woods",
  "stories": [
    {
      "story_id": 73248,
      "title": "林中小曲",
      "description": "与桓那兰那的兰加惟谈谈，或许对无忧节的准备有帮助。",
      "dialogues": [
        {
          "role": "兰拉迦",
          "text": "哦哦。是那菈旅行者。有什么事需要老身解答的吗？"
        },
        {
          "role": "旅行者",
          "text": "有没有什么需要帮忙的？"
        },
        {
          "role": "兰拉迦",
          "text": "哦哦，谢谢你，那菈旅行者。如你所见，老身相当自在。"
        },
        {
          "role": "旅行者",
          "text": "要准备无忧节，还有什么要做的？"
        },
        {
          "role": "兰拉迦",
          "text": "说到这个，兰加惟应该在桓那兰那的中心。既然要办无忧节，他应该也有需要帮忙的事情。"
        },
        {
          "type": "subtitle",
          "text": "与兰加惟对话"
        },
        {
          "role": "兰加惟",
          "text": "是兰罗摩和金色的那菈呀，你可真高。但边上这个银色的…"
        },
        {
          "role": "派蒙",
          "text": "嗯？银色的怎样？"
        },
        {
          "role": "兰加惟",
          "text": "该怎么说呢…应该可以钻进很狭窄的树洞吧，很方便很方便！太好了！"
        },
        {
          "role": "兰罗摩",
          "text": "嗯！按照那菈的习俗，应该要先介绍。这是那菈旅行者和派蒙，这是兰加惟。你们握手。"
        },
        {
          "type": "subtitle",
          "text": "有点不知所措地和兰加惟握手了…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "不敢太用力。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "触感很特别。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "兰加惟",
          "text": "真有趣。以前我也听大家说过许多那菈的事，但接触到那菈的身体还是第一次。感觉很奇妙呢！"
        },
        {
          "role": "兰加惟",
          "text": "上一次有那菈到我们这来，已经过了很久。许多的种子都长成了大树，许多的故事都变成了传说。据说，那是很好的那菈。"
        },
        {
          "role": "兰罗摩",
          "text": "那菈旅行者也是很好的那菈，勇敢又强壮，就像在岩壁上长出来的小树一样。而且，他们要帮助兰拉娜，才来的。"
        },
        {
          "role": "兰加惟",
          "text": "哦哦，兰拉娜吗…好久没见到了，希望一切都好。也希望维摩庄的小那菈们一切都好。"
        },
        {
          "role": "旅行者",
          "text": "你也认识维摩庄的孩子吗？"
        },
        {
          "role": "兰加惟",
          "text": "当然认识呀！"
        },
        {
          "role": "兰罗摩",
          "text": "我们都认识！兰拉娜回来，都跟我们说小那菈的故事。所以，那菈优丹、那菈巴兰、那菈拉娜他们，就是我们的那菈朋友。"
        },
        {
          "role": "派蒙",
          "text": "这样倒也不算是认识啦…"
        },
        {
          "role": "兰加惟",
          "text": "那，要怎样才算认识呢？要像那菈那样，「介绍」以后，「握手」吗？"
        },
        {
          "role": "兰罗摩",
          "text": "嗯嗯，派蒙说的，我明白。那菈还要一起吃饭、一起找「宝藏」，才算认识。对不对？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也不是那么简单的事情…",
              "dialogues": []
            },
            {
              "text": "该怎么说呢…",
              "dialogues": []
            },
            {
              "text": "我和派蒙一起吃饭、一起找宝藏。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯！我们不但认识，而且是最好的伙伴！"
                },
                {
                  "role": "兰罗摩",
                  "text": "那菈旅行者和派蒙，真好！"
                }
              ]
            }
          ]
        },
        {
          "role": "兰加惟",
          "text": "只要知道故事，就算认识。因为兰那罗的世界是歌的世界、梦的世界。"
        },
        {
          "role": "兰罗摩",
          "text": "嗯，兰加惟说得对。对兰那罗来说，只要听到了描绘那菈旅行者的歌、梦中见到了那菈旅行者的样子，就认识了。"
        },
        {
          "role": "派蒙",
          "text": "我觉得，这个可以先放一边…因为，我们已经是兰那罗的朋友了！"
        },
        {
          "role": "兰罗摩和兰加惟",
          "text": "好朋友！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好朋友！",
              "dialogues": []
            },
            {
              "text": "还是先谈正事…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，我们要举办无忧节，兰加惟要做好准备！"
        },
        {
          "role": "兰加惟",
          "text": "果然如此。是为了惟耶之实吧？我已经让兰耶娑、兰陀娑和兰修提袈去寻找「觉树之堂」了。"
        },
        {
          "role": "派蒙",
          "text": "直觉真准…不过，为什么你们不知道觉树之堂在哪呢？"
        },
        {
          "role": "兰罗摩",
          "text": "觉树之堂是很神圣很神圣的地方，我们一般不会去。就让莎兰树静静地沉睡在梦中吧。直到一切记忆在沙恒中交汇。"
        },
        {
          "role": "兰加惟",
          "text": "森林会记住一切。一切美好的事物都不会消散。一切痛苦都会成为美好事物的养分…"
        },
        {
          "role": "兰加惟",
          "text": "总之，兰耶娑、兰陀娑和兰修提袈他们在外面寻找觉树之堂。兰罗摩，你去帮帮他们吧。"
        },
        {
          "role": "兰罗摩",
          "text": "嗯。我会去的。如果那菈旅行者、派蒙在森林里遇到了我们，就一起冒险吧！"
        },
        {
          "role": "兰加惟",
          "text": "很好很好。很高兴认识你们，那菈旅行者和派蒙！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（兰加惟）"
        },
        {
          "role": "兰加惟",
          "text": "很高兴认识你们！等到了无忧节的时候，我们要一起开心地唱歌！"
        }
      ],
      "collapse_ranges": [
        [
          37,
          38
        ]
      ]
    }
  ]
}