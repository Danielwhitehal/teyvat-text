{
  "quest_id": 20049,
  "chapter_num": null,
  "chapter_title": "蒙德酒客",
  "type": "iq",
  "route": "A Little Booze Doesn't Hurt...",
  "stories": [
    {
      "story_id": 20049,
      "title": "蒙德酒客",
      "description": "为了能安心地喝几杯小酒，宁禄先生正在酒馆里找人帮忙……",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与宁禄对话"
        },
        {
          "role": "宁禄",
          "text": "好想喝杯酒…"
        },
        {
          "role": "宁禄",
          "text": "但要是被优律发现我喝了酒，那就全完了。"
        },
        {
          "role": "旅行者",
          "text": "你怎么了？"
        },
        {
          "role": "宁禄",
          "text": "嗯？哦…哦，我就是想喝点酒。"
        },
        {
          "role": "宁禄",
          "text": "我老婆优律最看不得我喝酒了，平时在家里，我几乎滴酒不能沾。"
        },
        {
          "role": "宁禄",
          "text": "我只能趁她上街买东西的时候，才能偷偷过来安静地喝几杯。"
        },
        {
          "role": "旅行者",
          "text": "你也太喜欢喝酒了吧…"
        },
        {
          "role": "宁禄",
          "text": "你这话说的！蒙德人怎么可能不喝酒嘛…"
        },
        {
          "role": "宁禄",
          "text": "拜托你，去帮我拖住优律一点时间，让我喝个一杯两杯就好。"
        },
        {
          "role": "宁禄",
          "text": "买东西的时候，只要有很多选择，优律就会一直犹豫，下不了判断。"
        },
        {
          "role": "宁禄",
          "text": "如果能让她一直有很多选择，她就会一直犹豫下去…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了…",
              "dialogues": [
                {
                  "role": "宁禄",
                  "text": "哈哈哈，那就拜托你了，祝你酒运昌隆。"
                }
              ]
            },
            {
              "text": "你要喝多久？",
              "dialogues": [
                {
                  "role": "宁禄",
                  "text": "哈哈哈，那就要看你能够拖多…"
                },
                {
                  "role": "宁禄",
                  "text": "不，不是，我只要能安静地喝一杯就好！"
                },
                {
                  "role": "宁禄",
                  "text": "这是一位蒙德酒客的承诺，拜托你了！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "找到优律小姐"
        },
        {
          "role": "优律",
          "text": "日落果，苹果…到底买哪个比较好呢？"
        },
        {
          "role": "优律",
          "text": "唉，要是宁禄在这的话，直接买他喜欢的就好了…"
        },
        {
          "role": "昆恩",
          "text": "抱歉，优律小姐，日落果已经卖光了。"
        },
        {
          "role": "优律",
          "text": "是这样吗？哎呀，那就只能买苹果了。"
        },
        {
          "role": "昆恩",
          "text": "呃，优律小姐，这些苹果很不新鲜了…"
        },
        {
          "role": "优律",
          "text": "咦？是这样吗，但是我也没别的能选了…"
        },
        {
          "role": "派蒙",
          "text": "我们来帮忙！"
        },
        {
          "role": "昆恩",
          "text": "咦？你们…"
        },
        {
          "role": "旅行者",
          "text": "就交给我们。"
        },
        {
          "role": "派蒙",
          "text": "放心吧，我们会去找新鲜的<color=#00E1FFFF>日落果</color>回来。"
        },
        {
          "role": "昆恩",
          "text": "是，是这样吗？那就拜托了…"
        },
        {
          "role": "优律",
          "text": "那太好了，宁禄也更喜欢吃日落果一些，那我在这先等着吧。"
        },
        {
          "type": "subtitle",
          "text": "找到日落果"
        },
        {
          "role": "昆恩",
          "text": "日落果就麻烦你们了，贝雅特丽奇这家伙，刚好把最后几个买走了…"
        },
        {
          "type": "subtitle",
          "text": "交付日落果"
        },
        {
          "role": "优律",
          "text": "真是谢谢您，我的丈夫最近为我戒了酒，一直很不开心…"
        },
        {
          "role": "优律",
          "text": "如果能吃到喜欢的水果，他也许会高兴一些吧。"
        },
        {
          "role": "优律",
          "text": "不过…好像买苹果会更划得来一些…"
        },
        {
          "role": "昆恩",
          "text": "找到日落果了吗？"
        },
        {
          "role": "旅行者",
          "text": "这些够了吗？"
        },
        {
          "role": "昆恩",
          "text": "够了够了！帮大忙了，谢谢你。"
        },
        {
          "role": "优律",
          "text": "这些日落果看着真不错！"
        },
        {
          "role": "优律",
          "text": "哎呀，不过买苹果也很划算，我要不要都买了呢…"
        },
        {
          "type": "subtitle",
          "text": "向宁禄回报"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们快去找日落果回来吧。"
        },
        {
          "role": "派蒙",
          "text": "这样子，优律小姐一定会接着犹豫不决。"
        },
        {
          "role": "派蒙",
          "text": "不过，宁禄先生可真是了解她呀…"
        },
        {
          "role": "宁禄",
          "text": "你，你们回来了？优律…她怎么说？"
        },
        {
          "role": "派蒙",
          "text": "呜哇，好大的酒气，他不是说只喝一杯的吗？"
        },
        {
          "role": "旅行者",
          "text": "优律小姐正在犹豫呢。"
        },
        {
          "role": "宁禄",
          "text": "好…好！这样子我就能接着安心喝酒了！"
        },
        {
          "role": "派蒙",
          "text": "喂！你不是说只喝一杯吗？"
        },
        {
          "role": "宁禄",
          "text": "嘿嘿，是啊，我喝的一杯，是「下一杯」…"
        },
        {
          "role": "宁禄",
          "text": "多谢你们了，这些给你们，就当做谢礼吧。"
        },
        {
          "role": "宁禄",
          "text": "我要接着喝酒了，美酒时光得来不易啊——"
        }
      ]
    }
  ]
}