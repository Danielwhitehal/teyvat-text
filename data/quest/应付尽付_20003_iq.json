{
  "quest_id": 20003,
  "chapter_num": null,
  "chapter_title": "应付尽付",
  "type": "iq",
  "route": "Owe Mora, Pay Mora",
  "stories": [
    {
      "story_id": 20003,
      "title": "应付尽付",
      "description": "歌德先生似乎正在为某事发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与歌德对话"
        },
        {
          "role": "歌德",
          "text": "唉，看来我还是得自己跑一趟…"
        },
        {
          "role": "歌德",
          "text": "我这把老骨头，非得散架不可…"
        },
        {
          "role": "旅行者",
          "text": "有什么急事吗？"
        },
        {
          "role": "歌德",
          "text": "旅行者？唉…也不能算是急事，但我是真的操办不过来了…"
        },
        {
          "role": "歌德",
          "text": "你也知道，那群愚人众把我的酒店给包下来了吧。"
        },
        {
          "role": "歌德",
          "text": "他们包下了酒店之后，我作为「歌德大酒店」的老板，自然也得在旁边照应着。"
        },
        {
          "role": "歌德",
          "text": "帮着联系食材供应商，物件坏了及时叫人去修，还有一些杂七杂八的事。"
        },
        {
          "role": "歌德",
          "text": "最近酒店里有几间屋子的桌椅坏了，我得赶紧去联系人，把合适的木材送去给木匠。"
        },
        {
          "role": "歌德",
          "text": "还有城里几间屋子的租金没收…玛文那小子又成天不见影子。"
        },
        {
          "role": "歌德",
          "text": "唉，也不知道我这把老骨头能折腾几年，玛文到底什么时候才能懂事点呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来帮您。",
              "dialogues": []
            },
            {
              "text": "你先在这歇一会吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "歌德",
          "text": "你，你愿意帮我吗？唉，真的太麻烦你了，玛文那小子要是有你一半懂事，我也不会累成这样…"
        },
        {
          "role": "歌德",
          "text": "那就麻烦你，先帮我去拿一份杉木和一份桦木回来吧，我要赶紧把这些木材交给木匠了。"
        },
        {
          "type": "subtitle",
          "text": "将木材带给歌德"
        },
        {
          "role": "歌德",
          "text": "你拿到木材了吗？只要一份杉木和一份桦木就好了。"
        },
        {
          "type": "subtitle",
          "text": "与歌德对话"
        },
        {
          "type": "subtitle",
          "text": "与歌德对话"
        },
        {
          "role": "歌德",
          "text": "阿斯…阿斯托洛…什么来着…"
        },
        {
          "role": "歌德",
          "text": "谢谢你，这些木材就够了，我这就拿去给木匠…对了，还得去收房租才行…"
        },
        {
          "role": "歌德",
          "text": "唉，也不知道那个…阿斯…阿斯…什么莫娜…这次在不在家…"
        },
        {
          "role": "旅行者",
          "text": "是阿斯托洛吉斯·莫娜·梅姬斯图斯。"
        },
        {
          "role": "歌德",
          "text": "对！就是这个名字，哎哟…我是真的记不住。"
        },
        {
          "role": "派蒙",
          "text": "咦？莫娜还没交房租吗？"
        },
        {
          "role": "歌德",
          "text": "可不是嘛，其他的租客都把房租交了，就剩她了。"
        },
        {
          "role": "歌德",
          "text": "我跑了好几趟了，但她一直都不在家。"
        },
        {
          "role": "歌德",
          "text": "旅行者，请你帮我跑一趟，去催催她交房租吧。"
        },
        {
          "role": "旅行者",
          "text": "骑士团里的图书馆。"
        },
        {
          "role": "派蒙",
          "text": "图书馆啊…嗯！骑士团的图书馆特别大，莫娜说不定会去那边查资料呢。"
        },
        {
          "role": "派蒙",
          "text": "那我们就过去看看吧！"
        },
        {
          "role": "旅行者",
          "text": "能买到沙拉的猎鹿人。"
        },
        {
          "role": "派蒙",
          "text": "猎鹿人…嗯…说不定莫娜会去买沙拉吃呢。我们过去看看吧。"
        },
        {
          "role": "派蒙",
          "text": "希望莫娜最近手里的钱够买沙拉的…"
        },
        {
          "role": "旅行者",
          "text": "直接去问问凯瑟琳。"
        },
        {
          "role": "派蒙",
          "text": "去问凯瑟琳小姐啊…也对，凯瑟琳小姐什么都知道，问她准没错。"
        },
        {
          "role": "派蒙",
          "text": "那我们赶紧去问问她吧。"
        },
        {
          "type": "subtitle",
          "text": "拜访莫娜"
        },
        {
          "role": "派蒙",
          "text": "莫娜，你在吗？"
        },
        {
          "role": "旅行者",
          "text": "莫娜，该交房租啦！"
        },
        {
          "role": "派蒙",
          "text": "呃…莫娜好像不在呢…"
        },
        {
          "role": "派蒙",
          "text": "奇怪，她一般不都是在房间里吗？难道今天出门办事去了？"
        },
        {
          "role": "派蒙",
          "text": "难、难道！莫娜已经被饿晕在房间里了，根本没力气来开门吗！？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不至于啦…",
              "dialogues": []
            },
            {
              "text": "她之前都说自己想到赚钱的方法了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是、是这样吗？"
        },
        {
          "role": "派蒙",
          "text": "但是，我们要去哪里才能找到莫娜呢…"
        },
        {
          "type": "subtitle",
          "text": "去图书馆寻找莫娜"
        },
        {
          "role": "派蒙",
          "text": "图书馆里好像没见到莫娜呢，丽莎小姐也不在。"
        },
        {
          "role": "派蒙",
          "text": "我们去问问门口的那位西风骑士，看看他有没有见过莫娜吧。"
        },
        {
          "type": "subtitle",
          "text": "向威拉格询问莫娜的去向"
        },
        {
          "role": "威拉格",
          "text": "你好，有什么能为你效劳的吗？"
        },
        {
          "role": "旅行者",
          "text": "请问你见过一个这样的女孩吗…"
        },
        {
          "role": "？？？",
          "text": "（旅行者向威拉格描述了莫娜的外貌特点…）"
        },
        {
          "role": "威拉格",
          "text": "噢！你说她啊，我记得，那个帽子很大的女孩。"
        },
        {
          "role": "威拉格",
          "text": "她经常过来图书馆查资料，一查就是一天，我印象很深的。"
        },
        {
          "role": "威拉格",
          "text": "不过，最近她倒是没怎么来图书馆了，你们来这里应该是找不到她了…"
        },
        {
          "role": "旅行者",
          "text": "来晚了啊…"
        },
        {
          "role": "威拉格",
          "text": "她要是再来的话，我会告诉她你们在找她的。"
        },
        {
          "role": "威拉格",
          "text": "不过，我也就能帮你这个忙了…"
        },
        {
          "role": "旅行者",
          "text": "谢谢你。"
        },
        {
          "role": "威拉格",
          "text": "小事，不用客气。"
        },
        {
          "role": "派蒙",
          "text": "看来莫娜不在图书馆啊，没办法，只能告诉歌德先生，我们今天没找到莫娜了…"
        },
        {
          "type": "subtitle",
          "text": "去猎鹿人餐馆寻找莫娜"
        },
        {
          "role": "莎拉",
          "text": "你好！有什么想吃的吗？"
        },
        {
          "role": "旅行者",
          "text": "请问你见过一个这样的女孩吗…"
        },
        {
          "role": "？？？",
          "text": "（旅行者向莎拉描述了莫娜的外貌特点…）"
        },
        {
          "role": "莎拉",
          "text": "你说莫娜啊，唔…她前段时间确实每天晚上都会来买沙拉，有时候还会拜托我往沙拉里多加点蛋。"
        },
        {
          "role": "派蒙",
          "text": "莫娜，还是一如既往地没钱啊…"
        },
        {
          "role": "莎拉",
          "text": "但最近，她已经连续好几天没来了。"
        },
        {
          "role": "莎拉",
          "text": "如果你们急着找她，那等她下次来买沙拉的时候，我可以帮你们告诉她一声。"
        },
        {
          "role": "旅行者",
          "text": "谢谢你。"
        },
        {
          "role": "派蒙",
          "text": "看来莫娜最近也没有来过猎鹿人呢。唔…只能回去告诉歌德先生，我们今天没找到莫娜了…"
        },
        {
          "type": "subtitle",
          "text": "向凯瑟琳询问莫娜的去向"
        },
        {
          "role": "凯瑟琳",
          "text": "您好，请问有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "请问你最近见过莫娜吗？"
        },
        {
          "role": "凯瑟琳",
          "text": "莫娜？唔…我最近还真没见过她…"
        },
        {
          "role": "凯瑟琳",
          "text": "如果你们急着找她的话，就在冒险家协会挂个委托吧。"
        },
        {
          "role": "旅行者",
          "text": "谢谢，我们自己再去找找吧。"
        },
        {
          "role": "派蒙",
          "text": "看来，凯瑟琳小姐不知道莫娜的去向呢。只能告诉歌德先生，我们今天没找到莫娜了…"
        },
        {
          "type": "subtitle",
          "text": "向歌德回报"
        },
        {
          "role": "歌德",
          "text": "怎么样，你们找到那位…呃…你们的那位朋友了吗？"
        },
        {
          "role": "旅行者",
          "text": "她好像今天不在家。"
        },
        {
          "role": "歌德",
          "text": "好吧…她欠的租金倒也不多，那就再缓几天。"
        },
        {
          "role": "歌德",
          "text": "这些报酬请你们收下吧，谢谢你们帮忙了。"
        }
      ]
    }
  ]
}