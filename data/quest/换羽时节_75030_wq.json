{
  "quest_id": 75030,
  "chapter_num": null,
  "chapter_title": "换羽时节",
  "type": "wq",
  "route": "Molting Season",
  "stories": [
    {
      "story_id": 75030,
      "title": "换羽时节",
      "description": "「爸爸，你训练出的勇士们都很完美对吧？」\\n「不能这么说，完美永远在下一秒，而追求完美的欲望会啃咬他们的心，他们永远也不会是完美的。他们也会厌倦，也会想放弃，和你我一样。」",
      "dialogues": [
        {
          "role": "阿科米蒂",
          "text": "我会永远记住你帮的这个大忙，恩人。让我缓一会儿，之后马上去找队长。"
        },
        {
          "role": "阿科米蒂",
          "text": "出来就得跟你打架，我干嘛出来。而且我又没收你钱，只不过是随口答应着玩而已。"
        },
        {
          "role": "阿科米蒂",
          "text": "把幼龙偷来带给你是违规的，我又不傻。"
        },
        {
          "role": "愤怒的贩龙者",
          "text": "胆子倒是大啊，敢玩我？你就躲吧，我有的是耐心，反正也不会有人救你。"
        },
        {
          "role": "阿科米蒂",
          "text": "…你怎么知道没人救我？"
        },
        {
          "role": "愤怒的贩龙者",
          "text": "…哦？"
        },
        {
          "role": "愤怒的贩龙者",
          "text": "臭小子，还真找了帮手？老子正在气头上，我连他一起揍。"
        },
        {
          "role": "阿科米蒂",
          "text": "啊？还真有人来了？"
        },
        {
          "role": "派蒙",
          "text": "什么？怎么冲我们过来了，真是的，没办法，看你的了旅行者。"
        },
        {
          "role": "阿科米蒂",
          "text": "最终成绩按照分数高低分四档，拜托你，至少要超过第二高的分档！我的脱队借口就指望你了。"
        },
        {
          "role": "阿科米蒂",
          "text": "追上曾经咬牙拼命努力过的我的影子吧，我自己是没有力气了，只能厚着脸皮拜托别人。"
        },
        {
          "role": "忧愁的绒翼龙",
          "text": "阿科米蒂躲在地窖里怎么能吃好？下巴都瘦尖了…"
        },
        {
          "role": "旅行者",
          "text": "你知道进地窖的路吗？"
        },
        {
          "role": "忧愁的绒翼龙",
          "text": "阿科米蒂正在地窖里休息，不方便外龙进去。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "给阿科米蒂带了吃的。",
              "dialogues": []
            },
            {
              "text": "给阿科米蒂带了喝的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "忧愁的绒翼龙",
          "text": "啊，你真好，我怎么就想不起来直接给他带点吃喝，逼他吃也是吃。"
        },
        {
          "role": "忧愁的绒翼龙",
          "text": "唉，当初库约尼把他交给我，但我居然没有照顾好他，丢龙啊。"
        },
        {
          "role": "忧愁的绒翼龙",
          "text": "还是你来吧，记住：从崖边冒热汽的地方飞下去有个小坡，按照「咚——咚咚咚——咚咚」的顺序敲打崖壁三次。"
        },
        {
          "role": "忧愁的绒翼龙",
          "text": "别敲错了，不然你可进不去。"
        },
        {
          "type": "subtitle",
          "text": "击退不怀好意的龙贩子"
        },
        {
          "role": "向下看",
          "text": "（下方传来窸窸窣窣的响动，似乎有人躲在这里。）"
        },
        {
          "role": "旅行者",
          "text": "喂，有人吗？"
        },
        {
          "role": "向下看",
          "text": "……"
        },
        {
          "role": "阿科米蒂",
          "text": "是谁？"
        },
        {
          "role": "派蒙",
          "text": "我们把龙贩子赶走了，你可以出来了。"
        },
        {
          "role": "阿科米蒂",
          "text": "…还是不了，就让我自己在地窖里待着吧。"
        },
        {
          "role": "阿科米蒂",
          "text": "谢谢你们帮忙，我也没什么好礼物可以拿来答谢你们。"
        },
        {
          "role": "阿科米蒂",
          "text": "不嫌弃的话，我在营地里存了点东西，你们随便拿吧。"
        },
        {
          "role": "旅行者",
          "text": "不解释一下吗？"
        },
        {
          "role": "阿科米蒂",
          "text": "害你们被这种无聊的事卷进来，我很抱歉，不过说了也没什么意思，算了吧。"
        },
        {
          "role": "派蒙",
          "text": "这是什么解释啊，我和旅行者在路上走得好好的，突然就有人喊着「我连你一起揍」就冲过来了。"
        },
        {
          "role": "派蒙",
          "text": "如果他反应慢一点，我们就会受伤，不对，已经受伤了，我们的精神受到了冲击。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "需要精神损失费。",
              "dialogues": []
            },
            {
              "text": "我的手擦伤了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "怎么想都很严重吧？我们好歹也是冒险家协会登记在册的知名冒险家，受协会保护，我们要求一个解释！"
        },
        {
          "role": "旅行者",
          "text": "（协会会保护我们吗？）"
        },
        {
          "role": "派蒙",
          "text": "（其实我也不知道，按之前的经验来看，我怀疑不会。）"
        },
        {
          "role": "阿科米蒂",
          "text": "这…我也不是故意的，怪我做什么…反正你们也进不来。"
        },
        {
          "role": "派蒙",
          "text": "可恶，这家伙藏在地窖里，旅行者我们去找他去！"
        },
        {
          "role": "阿科米蒂",
          "text": "别费劲了，就算我告诉你们营地里有两条路直通地窖，<color=#00E1FFFF>但知道这两条路的也只有龙</color>，你们不可能有办法，还是走吧。"
        },
        {
          "type": "subtitle",
          "text": "找到阿科米蒂"
        },
        {
          "role": "派蒙",
          "text": "阿科米蒂，我们找到你了。"
        },
        {
          "role": "阿科米蒂",
          "text": "你们还真的找到地窖来了？我还以为这个地窖这么隐蔽，你们找不到就该离开了。"
        },
        {
          "role": "派蒙",
          "text": "怎么说？跟我们解释解释吧，那些突然冒出来的龙贩子可是把我们吓了一跳。"
        },
        {
          "role": "阿科米蒂",
          "text": "真是爱追根究底的人，本来我觉得自己这点事不值得向别人大倒苦水，所以才干脆窝在这里不出来。"
        },
        {
          "role": "阿科米蒂",
          "text": "不过你们碰上这档子事也是受了损失，既然都找到这里来了，应该得到一个解释。"
        },
        {
          "role": "阿科米蒂",
          "text": "我是花羽会的阿科米蒂，刚刚通过驭龙师考核，算是飞行队正式成员了吧。"
        },
        {
          "role": "阿科米蒂",
          "text": "不对，我现在…应该已经被视为脱队的失翼者了，不知道队长打算怎么处理我的事，也没必要想这些了。"
        },
        {
          "role": "阿科米蒂",
          "text": "你们肯定也听到了，我其实没有违反规定，偷绒翼龙幼崽牟利。"
        },
        {
          "role": "阿科米蒂",
          "text": "至于那些龙贩子，你们放心，他们不敢再找你们寻仇。"
        },
        {
          "role": "阿科米蒂",
          "text": "花羽会里头脑正常的人不会闲着没事跟飞行队起冲突，刚才那几个想偷龙的家伙也不过是小混混。"
        },
        {
          "role": "阿科米蒂",
          "text": "他们其实害怕得很，只敢趁我落单过来堵路，这下被你们揍回去之后绝对不敢声张。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们怎么会起冲突？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是啊，这些人到底在想什么啊，怎么会找飞行队的麻烦。"
                }
              ]
            },
            {
              "text": "为什么会答应他们偷龙？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…我以为飞行队的驭龙师会很珍惜绒翼龙来着。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿科米蒂",
          "text": "不，跟身份无关，是我自己的问题，我可能…不适合进入飞行队吧。"
        },
        {
          "role": "阿科米蒂",
          "text": "做预备役的时候想要成为正式队员，为追逐前辈们的速度拼命训练。"
        },
        {
          "role": "阿科米蒂",
          "text": "没日没夜天天训练，一点做不好就战战兢兢，怀疑自己到底行不行。"
        },
        {
          "role": "阿科米蒂",
          "text": "都没法跟爸妈还有姐姐说上几句话，脾气也变得古怪又急躁，饭不想吃，觉不想睡。"
        },
        {
          "role": "阿科米蒂",
          "text": "好不容易通过了考核，成为正式队员之后，又得追逐队长的速度。"
        },
        {
          "role": "阿科米蒂",
          "text": "我永远不够好，永远有人比我有天分还更努力。"
        },
        {
          "role": "阿科米蒂",
          "text": "萤火虫刚刚飞上天，就发现自己得追上麻雀的速度，就算追上了飞鸟，接下来又不得不追逐流星。"
        },
        {
          "role": "阿科米蒂",
          "text": "挺累的，说实话，定期要去烟谜主找人付费咨询，唉，钱花了不少，人没见好。"
        },
        {
          "role": "阿科米蒂",
          "text": "就是想嘴上撒撒气，龙贩子来搭讪的时候才会说「趁早把龙都弄走」，谁知道他当真了。"
        },
        {
          "role": "阿科米蒂",
          "text": "躲到这儿都跑不掉，结果被人堵在地窖里，我实在是厌倦了。"
        },
        {
          "role": "派蒙",
          "text": "怎么说呢…大家都有大家的问题吧，其实做冒险家也很辛苦的。"
        },
        {
          "role": "阿科米蒂",
          "text": "对了，冒险家是不是能接委托？我想委托你们想个办法，给我一个充分的理由脱队。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真的要做失翼者吗？",
              "dialogues": [
                {
                  "role": "阿科米蒂",
                  "text": "处理矿石的时候不是会切开原矿的外壳吗，就当我是被磨掉的那部分碎屑好了。"
                },
                {
                  "role": "旅行者",
                  "text": "已经到这个地步了吗？"
                },
                {
                  "role": "阿科米蒂",
                  "text": "人人都是宝石，等于人人都不是，就让我来当碎屑，衬托大家的杰出吧。"
                },
                {
                  "role": "阿科米蒂",
                  "text": "一直追逐永远追不到的流星很痛苦，拜托饶了我。"
                }
              ]
            },
            {
              "text": "直接离开不行吗？",
              "dialogues": [
                {
                  "role": "阿科米蒂",
                  "text": "原谅我的懦弱吧，虽然其实是自己想要放弃，但就是没有勇气面对别人的期待。"
                },
                {
                  "role": "阿科米蒂",
                  "text": "这几天的脱队估计会被队长当成过失惩罚一下就过去了，而且前辈们肯定不会就这么让我离开。"
                },
                {
                  "role": "阿科米蒂",
                  "text": "「没关系」、「再努力一下」、「会好的」，越是这样说越是让人受不了，倒是别把我当回事啊。"
                },
                {
                  "role": "阿科米蒂",
                  "text": "结果个个都这样，想当废物都不好意思。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿科米蒂",
          "text": "能不能这样，你们跟我一起飞一次行不行？"
        },
        {
          "role": "阿科米蒂",
          "text": "你们来打破我的成绩，想一想，随便路过的冒险家，轻轻松松就把我超过了。"
        },
        {
          "role": "阿科米蒂",
          "text": "教官还能说什么？什么难得的天才，不努力就是浪费自己的天赋和人生，根本都是胡说。"
        },
        {
          "role": "派蒙",
          "text": "我后悔刚才刺激他了，旅行者，现在我有种强烈的愧疚感。"
        },
        {
          "role": "派蒙",
          "text": "也不知道该说些什么，要不就顺着他的意思帮忙试试看吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真的会有用吗？",
              "dialogues": []
            },
            {
              "text": "如果这样你觉得好些的话…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿科米蒂",
          "text": "大概吧。"
        },
        {
          "role": "旅行者",
          "text": "我可以帮忙。"
        },
        {
          "role": "阿科米蒂",
          "text": "太好了，我们到开阔的地方去谈。"
        },
        {
          "type": "subtitle",
          "text": "与阿科米蒂对话"
        },
        {
          "role": "阿科米蒂",
          "text": "听好了，一般飞行考核赛的目标是：在限定时间内，尽全力沿固定赛道驭龙飞行并得到尽可能高的分数。"
        },
        {
          "role": "阿科米蒂",
          "text": "飞行队的考核是很严格的，我们训练的时候教官会在每一个赛道节点评估考生的表现，进行打分。"
        },
        {
          "role": "阿科米蒂",
          "text": "最终成绩按照分数高低分四档，拜托你，至少要超过第二高的分档！我的脱队借口就指望你了。"
        },
        {
          "role": "阿科米蒂",
          "text": "追上曾经咬牙拼命努力过的我的影子吧，我自己是没有力气了，只能厚着脸皮拜托别人。"
        },
        {
          "type": "subtitle",
          "text": "开启计分飞行！"
        },
        {
          "type": "subtitle",
          "text": "与阿科米蒂对话"
        },
        {
          "role": "阿科米蒂",
          "text": "太好了呜呜，你做到了，你超过了我的最好成绩。"
        },
        {
          "role": "阿科米蒂",
          "text": "我可以放心地拿着这个成绩，回去让他们放弃我了。"
        },
        {
          "role": "阿科米蒂",
          "text": "你真的帮了我大忙，谢谢你！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不、不客气？",
              "dialogues": []
            },
            {
              "text": "对你有用就好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿科米蒂",
          "text": "我会永远记住你帮的这个大忙，恩人。让我缓一会儿，之后马上去找队长。"
        },
        {
          "role": "阿科米蒂",
          "text": "太好了，我马上就要自由了！"
        },
        {
          "type": "subtitle",
          "text": "与阿科米蒂对话"
        },
        {
          "role": "阿科米蒂",
          "text": "恩人！我现在就准备动身回队伍了，感谢你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "希望能有用吧…",
              "dialogues": []
            },
            {
              "text": "不客气。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿科米蒂",
          "text": "我都想好了，如果队长叫我再坚持一下、大家都是这么过来的，我就这样："
        },
        {
          "role": "阿科米蒂",
          "text": "先沉默一会儿，然后说：「对不起、队长，我…」，重点是要表现出自己的颓丧。"
        },
        {
          "role": "阿科米蒂",
          "text": "让队长意识到我确实是个没法指望的家伙，而且我也没撒谎，我真是不行了。"
        },
        {
          "role": "阿科米蒂",
          "text": "如果队长对我感到失望，打算从反面激将我，先说我最近的表现差然后再给我机会，我就这样："
        },
        {
          "role": "阿科米蒂",
          "text": "哭，但不能完全哭，眼泪在眼眶里不要流出来，然后简短地说一句「谢谢队长」。"
        },
        {
          "role": "阿科米蒂",
          "text": "接下来说自己也觉得自己是个废物，重点是要顺着队长的话头，队长也不好否定自己的话。"
        },
        {
          "role": "阿科米蒂",
          "text": "如果队长说自己要再想想，然后发动前辈们跟我谈话，我就…"
        },
        {
          "role": "阿科米蒂",
          "text": "这个有点难办，我暂时还想不出来怎么办，主要是我没力气跟每个前辈这么来一轮。"
        },
        {
          "role": "派蒙",
          "text": "本来以为你是破罐子破摔，已经拒绝思考了，才会拉我们帮忙。"
        },
        {
          "role": "派蒙",
          "text": "居然在这种地方想得这么清楚了吗？"
        },
        {
          "role": "阿科米蒂",
          "text": "这是人在遇到痛苦时心理产生的天然防御机制，压制对痛苦根源的感知，把注意力放到好的事情上。"
        },
        {
          "role": "阿科米蒂",
          "text": "付费咨询的时候，烟谜主的人这么跟我说的。好歹花了钱，总得得到点有用的建议吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来怪没用的。",
              "dialogues": []
            },
            {
              "text": "希望你没花太多钱。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿科米蒂",
          "text": "有点信心啊恩人，这次我一定能逃走，一定能！"
        },
        {
          "role": "阿科米蒂",
          "text": "对了，既然马上都要走了，我得跟你说一声。"
        },
        {
          "role": "阿科米蒂",
          "text": "我还是预备役的时候，为了训练，家人帮我建造了这座飞屋。"
        },
        {
          "role": "阿科米蒂",
          "text": "接下来我应该就用不上这里了，这座飞屋我打算拆下来带走，以后就不用再那么痛苦地训练了哈哈。"
        },
        {
          "role": "阿科米蒂",
          "text": "不过为了防止恩人你想要训练但找不到合适的地方，布设在这里的赛道我不会拆掉。"
        },
        {
          "role": "阿科米蒂",
          "text": "只要你想，随时都能来练习。"
        },
        {
          "role": "阿科米蒂",
          "text": "希望下次我们碰面的时候，咱们都是自由人啦。"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "阿科米蒂",
          "text": "太可惜了，只差一点点。"
        },
        {
          "role": "阿科米蒂",
          "text": "加油啊，千万不要放弃！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么变得这么积极？",
              "dialogues": [
                {
                  "role": "阿科米蒂",
                  "text": "我能不能解脱就靠你了，当然要积极面对。"
                },
                {
                  "role": "阿科米蒂",
                  "text": "来，歇一会儿我们再试一次，这次一定行。"
                }
              ]
            },
            {
              "text": "我想休息一会儿。",
              "dialogues": [
                {
                  "role": "阿科米蒂",
                  "text": "没关系，你好好休息，待会儿我们再来！"
                }
              ]
            }
          ]
        },
        {
          "role": "阿科米蒂",
          "text": "你放心，我不会放弃你的。不管尝试多少次都行，不要丧失信心，你一定能做到的。"
        },
        {
          "role": "旅行者",
          "text": "赶快给我放弃！"
        },
        {
          "role": "阿科米蒂",
          "text": "不，我说什么也不会放弃你的。我是没办法加油了，但是你可以。"
        },
        {
          "role": "阿科米蒂",
          "text": "要是你也帮不上忙，我就真的没有招了。"
        }
      ]
    }
  ]
}