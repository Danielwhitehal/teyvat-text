{
  "quest_id": 72212,
  "chapter_num": null,
  "chapter_title": "寝子是只猫·石头和猫",
  "type": "wq",
  "route": "Neko Is a Cat: Cat and Stone",
  "stories": [
    {
      "story_id": 72212,
      "title": "寝子是只猫·石头和猫",
      "description": "「浅濑神社代宫司」寝子似乎有事找你…",
      "dialogues": [
        {
          "role": "「寝子」",
          "text": "汝等来得正好，来帮奴家做件事吧。"
        },
        {
          "role": "旅行者",
          "text": "什么事？"
        },
        {
          "role": "「寝子」",
          "text": "奴家想要…"
        },
        {
          "role": "「寝子」",
          "text": "在神社旁边，放一块很高很高，很大很大，和奴家一个样子的石头。"
        },
        {
          "role": "派蒙",
          "text": "上、上哪找这样的石头…"
        },
        {
          "role": "旅行者",
          "text": "是说雕像对吧。"
        },
        {
          "role": "「寝子」",
          "text": "总之，奴家要的东西，和好远好远的那个岛上的狐狸石头一样。"
        },
        {
          "role": "「寝子」",
          "text": "阿响说过，在那个岛上，有好多狐狸石头，还说，要不要给奴家也弄一个。"
        },
        {
          "role": "「寝子」",
          "text": "奴家觉得，阿响想要的，一定是好的。所以，汝等帮忙弄个石头吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我没有雕刻的手艺…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔，要怎么办呢…"
                },
                {
                  "role": "派蒙",
                  "text": "对了，去找大祐吧！他这么喜欢猫，说不定能为了寝子学会雕刻。"
                }
              ]
            },
            {
              "text": "去找大祐帮忙好了…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "有道理！他这么喜欢猫，说不定能帮得上忙。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "询问大祐和悦子"
        },
        {
          "role": "大祐",
          "text": "喔！你好，今天又在忙什么呢？"
        },
        {
          "role": "旅行者",
          "text": "帮寝子做雕像。"
        },
        {
          "role": "大祐",
          "text": "哈…哈？做雕像，在这里？真的吗？"
        },
        {
          "role": "大祐",
          "text": "我、我这就去学雕刻技术！"
        },
        {
          "role": "旅行者",
          "text": "来、来不及吧…"
        },
        {
          "role": "悦子",
          "text": "又是那位寝子拜托你的吗？"
        },
        {
          "role": "悦子",
          "text": "说起来，因为踏鞴砂那边的问题，很多工匠都在找工作。"
        },
        {
          "role": "悦子",
          "text": "协会之前接到过不少相关的委托，据我所知，有人似乎还留在踏鞴砂附近，一直在找工作。"
        },
        {
          "role": "悦子",
          "text": "我之前去执行协会委托的时候，也见到了一个类似的营地。"
        },
        {
          "role": "悦子",
          "text": "如果你们愿意的话，倒是可以去那边碰碰运气。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你。",
              "dialogues": []
            },
            {
              "text": "悦子小姐感觉和平时不太一样…",
              "dialogues": [
                {
                  "role": "悦子",
                  "text": "怎么？我这么主动地给你们信息，你有些不习惯吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "悦子",
          "text": "呵呵…不用在意，只不过是举手之劳而已。"
        },
        {
          "role": "悦子",
          "text": "我也很想看看，这座神社如果真能热闹起来的话…会发生什么。"
        },
        {
          "role": "悦子",
          "text": "特别是那位「阿响」…到底是一位怎么样的人，能让那位寝子这么在意呢？"
        },
        {
          "role": "悦子",
          "text": "好了，你也别在这听我自言自语了，快去找工匠吧。"
        },
        {
          "role": "悦子",
          "text": "至于你们找到的工匠会不会雕石雕…呵呵，那就全凭你们的运气了。"
        },
        {
          "role": "大祐",
          "text": "悦子小姐，其实你也是想帮帮寝子大人对吧？哈哈哈，你可真是…"
        },
        {
          "role": "悦子",
          "text": "大祐，调查计划写好了没有？"
        },
        {
          "role": "大祐",
          "text": "呃！马、马上就好，实在对不起…"
        },
        {
          "type": "subtitle",
          "text": "前往踏鞴砂，寻找工匠"
        },
        {
          "role": "？？？",
          "text": "唉，到底什么时候才能找到工作…"
        },
        {
          "role": "？？？",
          "text": "你们…是来找我的吗？有什么事？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你会做石雕吗？",
              "dialogues": []
            },
            {
              "text": "我们正在找会做石雕的工匠。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "咦？那…那太好了！"
        },
        {
          "role": "？？？",
          "text": "我都忘了自我介绍了…我叫大岛纯平，之前是在踏鞴砂干活的。"
        },
        {
          "role": "？？？",
          "text": "出了意外之后，我和其他人也都被疏散了出去。"
        },
        {
          "role": "？？？",
          "text": "但是…到现在我也没有接到复工的消息，就这么一直闲在这里。"
        },
        {
          "role": "？？？",
          "text": "你们是在找做石雕的人对吧？我会一点石雕的手艺，虽然不是特别专业…"
        },
        {
          "role": "？？？",
          "text": "你们要做怎么样的石雕？能告诉我吗？"
        },
        {
          "role": "旅行者",
          "text": "是这样的…"
        },
        {
          "role": "？？？",
          "text": "呃，会说话的猫，要你们找一个工匠，帮它雕一座石雕？"
        },
        {
          "role": "？？？",
          "text": "不、不是我不相信，是这件事实在有点…有点离谱…"
        },
        {
          "role": "？？？",
          "text": "其他的不论，就算我答应了你们，那…那位「代宫司」大人，怎么支付报酬呢？我可不能做白工啊。"
        },
        {
          "role": "旅行者",
          "text": "放心吧。"
        },
        {
          "role": "派蒙",
          "text": "（真、真的可以放心吗…）"
        },
        {
          "role": "？？？",
          "text": "这样啊，这…我总觉得你们在骗我…"
        },
        {
          "role": "？？？",
          "text": "但是…算了，闲着也是闲着，我就和你们走一趟吧。"
        },
        {
          "role": "？？？",
          "text": "希望对方真的能支付报酬…"
        },
        {
          "type": "subtitle",
          "text": "与工匠对话"
        },
        {
          "role": "「寝子」",
          "text": "汝等回来了。这个人类想必便是石头人类，对吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是我们请来的工匠。",
              "dialogues": []
            },
            {
              "text": "对，石头人类。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "欸？欸！猫…猫说话了！"
        },
        {
          "role": "「寝子」",
          "text": "喵喵喵，汝可真是大惊小怪啊…奴家会说话很奇怪吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不要大惊小怪。",
              "dialogues": []
            },
            {
              "text": "只不过是猫会说话而已。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "喂！难道对你来说，这事情是一件很平常的事吗？！"
        },
        {
          "role": "旅行者",
          "text": "确实很平常啦。"
        },
        {
          "role": "大岛纯平",
          "text": "你到底都经历了什么啊…"
        },
        {
          "role": "「寝子」",
          "text": "好啦，好啦，你们不要光顾着说话了。"
        },
        {
          "role": "「寝子」",
          "text": "总之，石头人类，你能把石头，弄得和奴家一模一样吗？"
        },
        {
          "role": "大岛纯平",
          "text": "咦？石头人类？我吗？"
        },
        {
          "role": "大岛纯平",
          "text": "敲石头…呃，你是说做石雕啊，我倒是可以试试看…"
        },
        {
          "role": "「寝子」",
          "text": "是吗？那太好了，喵喵喵。"
        },
        {
          "role": "大岛纯平",
          "text": "这、这样啊…无论如何，有份工作都是件好事。虽然我也从来没为一只猫工作过…报酬的事…之后再聊吧…"
        },
        {
          "role": "大岛纯平",
          "text": "呃，我得先去做点准备工作，这岛上倒是有不少石头，我得去好好挑一下…"
        },
        {
          "role": "大岛纯平",
          "text": "那个，我该怎么称呼你？"
        },
        {
          "role": "「寝子」",
          "text": "喔，奴家是这座「浅濑神社」的代宫司，寝子。"
        },
        {
          "role": "「寝子」",
          "text": "至于称呼，随汝喜欢就好，高高的，会敲石头的人类。"
        },
        {
          "role": "大岛纯平",
          "text": "是吗？那我…就叫你代宫司大人吧，毕竟是发工钱的人嘛。"
        },
        {
          "role": "「寝子」",
          "text": "「宫前」？"
        },
        {
          "role": "大岛纯平",
          "text": "……"
        },
        {
          "role": "大岛纯平",
          "text": "那、那我就先去周围看看，挑挑石头去了，你们先聊着。"
        },
        {
          "role": "大岛纯平",
          "text": "给一只猫工作，还真是新奇…"
        },
        {
          "role": "派蒙",
          "text": "大岛先生，好像已经不想思考报酬的事情了呢…"
        },
        {
          "type": "subtitle",
          "text": "和大岛纯平一起向寝子回报"
        },
        {
          "role": "「寝子」",
          "text": "石头的事情，就交给汝等了。"
        },
        {
          "role": "「寝子」",
          "text": "不过，奴家还是很好奇。石头那么硬的东西，怎么会变成奴家的样子呢？"
        },
        {
          "role": "「寝子」",
          "text": "那个石头人类，是不是很厉害？是不是会什么妖术？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很厉害的。",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "原来如此，奴家很是期待哪。"
                }
              ]
            },
            {
              "text": "和做饭一样…",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "原来如此，奴家明白了。汝做的饭和阿响做的饭，都是好东西。所以，石头人类做的石头，也是好东西。"
                },
                {
                  "role": "「寝子」",
                  "text": "人类有时候真厉害哪。这次，也谢谢汝了。"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}