{
  "quest_id": 20504,
  "chapter_num": null,
  "chapter_title": "收集风之印的少女",
  "type": "iq",
  "route": "Collector of Anemo Sigils",
  "stories": [
    {
      "story_id": 20504,
      "title": "收集风之印的少女",
      "description": "派蒙注意到了一个很别致的商店…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与店主玛乔丽对话"
        },
        {
          "role": "玛乔丽",
          "text": "欢迎光临，这里的宝物保证独一无二。"
        },
        {
          "role": "派蒙",
          "text": "好多都是没见过的东西…"
        },
        {
          "role": "玛乔丽",
          "text": "哈哈，当然了，这些都是冒险家从世界各地找到的稀奇宝贝。"
        },
        {
          "role": "玛乔丽",
          "text": "怎么样，有一眼就相中的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉都很奢侈…",
              "dialogues": []
            },
            {
              "text": "我根本不敢看价格。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛乔丽",
          "text": "不会不会，忘记和你介绍了，我这里都是以物易物，不收取摩拉。"
        },
        {
          "role": "玛乔丽",
          "text": "我最近想做一个特殊的工艺品，需要大量的<color=#00E1FFFF>「风之印」</color>来装饰。"
        },
        {
          "role": "玛乔丽",
          "text": "你们身上有<color=#00E1FFFF>「风之印」</color>吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "找到了几个。",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "哈哈，那看起来你的冒险已经得到风神的认可了。"
                }
              ]
            },
            {
              "text": "那是什么？",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "那是一种印记，风神会将它送给受到认可的冒险者。"
                }
              ]
            }
          ]
        },
        {
          "role": "玛乔丽",
          "text": "总之，只要你有<color=#00E1FFFF>「风之印」</color>，就可以和我交换商店里所有的商品。"
        },
        {
          "role": "旅行者",
          "text": "挑选商品"
        },
        {
          "role": "玛乔丽",
          "text": "<color=#00E1FFFF>「风之印」</color>有可能出现在蒙德的任何地方，如果不够用的话就去多找找吧。"
        },
        {
          "role": "旅行者",
          "text": "真的只是用来装饰吗？"
        },
        {
          "role": "派蒙",
          "text": "是啊，怎么说都是风神的赠礼。"
        },
        {
          "role": "玛乔丽",
          "text": "哈哈，你们还挺敏锐的。"
        },
        {
          "role": "玛乔丽",
          "text": "解释起来挺复杂，用装饰品的说法大家都容易理解。"
        },
        {
          "role": "玛乔丽",
          "text": "我会选择用<color=#00E1FFFF>「风之印」</color>，自然是有非它不可的理由。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "做好了记得让我看看。",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "哈哈，肯定的，保证让你大吃一惊。"
                }
              ]
            },
            {
              "text": "故弄玄虚。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "但我真的有点好奇了…"
                },
                {
                  "role": "玛乔丽",
                  "text": "哈哈，就是要保持未知才会有惊喜啊。"
                }
              ]
            }
          ]
        },
        {
          "role": "玛乔丽",
          "text": "欢迎再来哦，希望你下次能带来很多很多的<color=#00E1FFFF>「风之印」</color>。"
        },
        {
          "role": "玛乔丽",
          "text": "找到什么稀奇宝物的话也记得要带到我这里来！"
        }
      ]
    }
  ]
}