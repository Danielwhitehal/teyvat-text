{
  "quest_id": 79041,
  "chapter_num": null,
  "chapter_title": "千奇澴回",
  "type": "wq",
  "route": "Returning Curios",
  "stories": [
    {
      "story_id": 79041,
      "title": "千奇澴回",
      "description": "遵循着派蒙的建议——「藏着摩拉的宝箱，一个都不能错过！」，你与派蒙打算再次造访伊迪娅，确认你们是否错过了「琉形蜃境」中某些有趣的地点。正巧，伊迪娅也筹备了一个独特的游乐项目…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与伊迪娅对话"
        },
        {
          "role": "派蒙",
          "text": "仔细一想，我们来到「琉形蜃境」也有好一阵子了，不知道这里会不会还有一些…我们还没发现的，有意思的地方！"
        },
        {
          "role": "派蒙",
          "text": "不如，先去和伊迪娅小姐聊聊吧？"
        },
        {
          "role": "伊迪娅",
          "text": "啊，旅行者和派蒙，我刚才还在想你们这时候在哪闲逛呢…"
        },
        {
          "role": "伊迪娅",
          "text": "欸呀，我看看，你们身上盘绕着净水欢唱的旋律，还有露珠轻灵起舞的活力，看来你们的状态很不错嘛。"
        },
        {
          "role": "伊迪娅",
          "text": "怎么样，有没有兴趣在「琉形蜃境」中深度赏玩一番？"
        },
        {
          "role": "派蒙",
          "text": "哼哼，没想到蜃境修复了以后，伊迪娅连说话都变得有模有样了。"
        },
        {
          "role": "派蒙",
          "text": "看上去和修复蜃境时都是两个人了，唔，不对，你不会是伊迪娅幻化出来的…"
        },
        {
          "role": "伊迪娅",
          "text": "这具身躯本来就是幻化出来的，好啦，别再提之前的事了！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，现在的伊迪娅看上去精神好多了，真是太好了！"
        },
        {
          "role": "派蒙",
          "text": "不对不对，跑题了！刚刚说到哪儿了来着？"
        },
        {
          "role": "派蒙",
          "text": "在「琉形蜃境」中…深度赏玩？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "四处走走总能找到惊喜。",
              "dialogues": []
            },
            {
              "text": "说不定还有超级大宝藏。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没错没错，我们的想法很合拍嘛！这么神奇的地方，我们正打算再仔细转转，把每个角落都逛个遍！"
        },
        {
          "role": "派蒙",
          "text": "藏着摩拉的宝箱，一个都不能错过！"
        },
        {
          "role": "伊迪娅",
          "text": "啊哈！我说的深度赏玩，可不只是到处逛逛那么简单。"
        },
        {
          "role": "伊迪娅",
          "text": "正好你们也对宝藏很感兴趣，嗯，正好来试试重新启动的「琉形蜃境」的传统项目「千奇澴回」吧？"
        },
        {
          "role": "派蒙",
          "text": "什么…环回？以前好像没听你说过啊？"
        },
        {
          "role": "伊迪娅",
          "text": "「千奇澴回」，顾名思义，百千瑰琦之物随着回旋的波流漂泊，汇入这「琉形蜃境」。"
        },
        {
          "role": "伊迪娅",
          "text": "这个保留项目要追溯到很久以前，当时，一位资深冒险家短暂造访此地，被这里的景致深深感动…"
        },
        {
          "role": "伊迪娅",
          "text": "咳，我的丰厚招待当然也有功劳。"
        },
        {
          "role": "伊迪娅",
          "text": "总之，他将自己最珍贵的东西埋藏在让他触景生情的地点。那是只属于他的「见证物」——由摩拉打造的三块怀表。"
        },
        {
          "role": "伊迪娅",
          "text": "离开之前，冒险家留下了富有诗意的暗语，拜托我讲述给之后的客人，引领他们去寻找这些宝藏。"
        },
        {
          "role": "派蒙",
          "text": "摩，摩拉做的怀表？听起来就金光闪闪的…一定很值钱！"
        },
        {
          "role": "伊迪娅",
          "text": "我倒是不知道它们有多贵重，反正，之后的一些客人听说这件事后，一个个的比派蒙还兴奋，誓要将冒险家留下的宝藏取出。"
        },
        {
          "role": "伊迪娅",
          "text": "可惜，他们走遍「琉形蜃境」都没能找到暗语所昭示的藏宝地。"
        },
        {
          "role": "伊迪娅",
          "text": "不过在这个过程中，一些客人也逐渐放松了自己的心情，不再像是刚进入蜃境那会儿那样紧张。"
        },
        {
          "role": "伊迪娅",
          "text": "虽然没有找到冒险家的宝藏，但他们觉得这个形式很有趣，在蜃境中留下了自己的「礼物」，埋藏自己的故事，交由我保管。"
        },
        {
          "role": "伊迪娅",
          "text": "总之，虽然我也没想到会变成这样，不过也变成了蜃境的保留活动。"
        },
        {
          "role": "伊迪娅",
          "text": "这正是「千奇澴回」——循着暗语的指示，发掘前人的宝藏！并将自己的故事传递下去！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以怀表呢？",
              "dialogues": []
            },
            {
              "text": "最后被找到了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊迪娅",
          "text": "啊，哈哈，你这么一说…最后怀表怎么样了来着…"
        },
        {
          "role": "伊迪娅",
          "text": "我只记得他想讲述的故事了，呃，对了，他留下的暗语在哪…我得好好找找，有没有什么记录…"
        },
        {
          "role": "派蒙",
          "text": "伊迪娅小姐！你不是答应了那位冒险家吗？你要负责啊！"
        },
        {
          "role": "伊迪娅",
          "text": "不能怪我啦，时间太久远了，中间的客人实在太多太多，我当然不可能全都牢牢记住嘛…"
        },
        {
          "role": "伊迪娅",
          "text": "而且，重点不在于怀表或宝藏的价值，而是宝藏中蕴藏的故事…"
        },
        {
          "role": "伊迪娅",
          "text": "对，只要故事在，财宝什么的也只是附加之物罢了！"
        },
        {
          "role": "伊迪娅",
          "text": "怎、怎么样，不如你们也来试试「千奇澴回」吧，你看，留下特别的见证物，会在很久之后被人取出。"
        },
        {
          "role": "伊迪娅",
          "text": "想象那人看到你们的故事有什么反应，然后在此刻选择将要留下的物品…这件事很有趣吧。"
        },
        {
          "role": "派蒙",
          "text": "有…有点道理哦。给陌生人留下礼物和寄语，的确是很有意思的事，根据谜题去寻找宝藏，也让人很期待！"
        },
        {
          "role": "派蒙",
          "text": "当然，如果能顺带拿到摩拉就再好不过了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "宝石有了黄金点缀更漂亮。",
              "dialogues": []
            },
            {
              "text": "我的浪漫也需要适度开价。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊迪娅",
          "text": "别担心！按照以前的规矩，每位客人至多听取一段暗语，寻找一个宝藏。"
        },
        {
          "role": "伊迪娅",
          "text": "而你们是最特别的客人，我会给你们三个机会，每段暗语对应的宝藏之中，除了故事的见证物，都有不少摩拉作为赠品！"
        },
        {
          "role": "派蒙",
          "text": "好好好！这样就完美啦，伊迪娅小姐！"
        },
        {
          "role": "派蒙",
          "text": "虽然不知道那位冒险家有多神奇，但我觉得，肯定还是比我和旅行者稍微差那么一点的。"
        },
        {
          "role": "派蒙",
          "text": "我们也来延续这种习俗吧，在这里埋下只属于我们的故事。我们就一边寻找宝藏，一边想想要留下什么「见证物」和暗语好了。"
        },
        {
          "role": "伊迪娅",
          "text": "那就这么说定了！接下来，请听好第一段暗语——"
        },
        {
          "role": "伊迪娅",
          "text": "「甘甜的雾气在弥漫，望着灯盏的光芒，我几乎忘记了呼吸。最后，还是儿时的回忆给了我引导，让我在桌边安心落座…」"
        },
        {
          "role": "伊迪娅",
          "text": "好了，「千奇澴回」的旅程开始了，请牢记暗语，努力理解它，寻找宝藏的所在地吧！"
        },
        {
          "type": "subtitle",
          "text": "寻找第一个藏宝地"
        },
        {
          "role": "派蒙",
          "text": "让我想想，暗语提到了什么「甘甜的雾气」…"
        },
        {
          "role": "派蒙",
          "text": "这不就是肚子饿了，想吃东西了嘛！我觉得去餐厅附近看看，一定会有收获的！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊迪娅）"
        },
        {
          "role": "伊迪娅",
          "text": "「千奇澴回」的旅程已经开始啦，还不出发吗？难道是还有什么疑问？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能不能再说一遍暗语…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊迪娅",
          "text": "当然没问题！"
        },
        {
          "role": "伊迪娅",
          "text": "「甘甜的雾气在弥漫，望着灯盏的光芒，我几乎忘记了呼吸。最后，还是儿时的回忆给了我引导，让我在桌边安心落座…」"
        },
        {
          "role": "伊迪娅",
          "text": "这下你应该记住了！这么简单的谜题肯定难不住你！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们去去就回！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔，这里好像藏着什么玄机！我们仔细调查一下吧！"
        },
        {
          "role": "派蒙",
          "text": "我记得暗语里还提到了…「灯的光芒」和「落座」什么的，这会不会是一个关键的信息呢…还是说，他停留的位置更关键？"
        },
        {
          "type": "subtitle",
          "text": "寻找「灯盏」和「落座」之处"
        },
        {
          "type": "subtitle",
          "text": "在亮着灯的桌边坐下",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|千奇澴回的见证物·其一}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "真的欸！在亮着灯的桌子边坐下，宝藏就出现了！"
        },
        {
          "role": "派蒙",
          "text": "不过，除了摩拉，好像就只有一个破破烂烂的袋子…这就是埋下宝藏的人选好的「见证物」吗？"
        },
        {
          "role": "派蒙",
          "text": "有点不太能理解那个人的用意呢…我们先回去问问伊迪娅小姐吧？"
        },
        {
          "type": "subtitle",
          "text": "向伊迪娅回报寻宝结果"
        },
        {
          "role": "伊迪娅",
          "text": "这么快就回来了？你们还真擅长寻宝啊！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，第一个暗语对我们来说太简单啦，一下就想明白了该去什么地方！"
        },
        {
          "role": "派蒙",
          "text": "不过，宝箱里的见证物是怎么回事呢？"
        },
        {
          "role": "派蒙",
          "text": "总觉得…这是个很容易饿肚子的人，站在餐厅门口就容易被香味吸引。这个见证物就是他装零食的包包，对不对？"
        },
        {
          "role": "伊迪娅",
          "text": "没错，但也不准确哦。"
        },
        {
          "role": "伊迪娅",
          "text": "留下第一个宝藏的访客，是一位意志坚定的斗士。"
        },
        {
          "role": "伊迪娅",
          "text": "我在沙漠中遇见他时，他的身上满是大大小小的伤口，肯定经历了一场惨烈的战斗。"
        },
        {
          "role": "伊迪娅",
          "text": "又累又饿的人，当然会被餐厅的香气吸引啦！这种时候有感而发，写下一些抒情的话，甚至诗兴大发，都是合情合理的嘛。"
        },
        {
          "role": "派蒙",
          "text": "噫！怎么会有这么大的出入！"
        },
        {
          "role": "派蒙",
          "text": "他为什么要在沙漠里战斗啊？"
        },
        {
          "role": "伊迪娅",
          "text": "要是我转述得太多，加上了我的个人评论，反倒会影响你们的心境，没法领会他原本的故事。"
        },
        {
          "role": "伊迪娅",
          "text": "见证物中还有他的一段笔记。如果你们有兴趣的话，可以抽空读读看哦。"
        },
        {
          "role": "派蒙",
          "text": "好，好吧，那旅行者，你记得有空看看，再给我说说是怎么回事哦。"
        },
        {
          "role": "伊迪娅",
          "text": "事不宜迟，我们就进入下一个环节吧，我要公布第二段藏宝地的暗语了。"
        },
        {
          "role": "伊迪娅",
          "text": "「藤蔓的飞星承载着我，在安静的林间穿行，终于进入了无人打扰的清静梦乡…」"
        },
        {
          "role": "伊迪娅",
          "text": "怎么样？这次的难度提升了不少哦！请充分运用你们的才智，快快寻找第二个藏宝地！"
        },
        {
          "type": "subtitle",
          "text": "寻找第二个藏宝地"
        },
        {
          "role": "派蒙",
          "text": "这次的暗语提到了藤蔓、无人打扰和…梦乡？这些东西都不太好理解啊…不过，倒是感觉有点耳熟。"
        },
        {
          "role": "派蒙",
          "text": "还有一个关键词——「飞星」。如果是打比方的话，说不定和我们乘坐过的「呼呼飞车」有关系？"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们去附近的「呼呼飞车」看看吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊迪娅）"
        },
        {
          "role": "伊迪娅",
          "text": "嗯？你不抓紧时间吗？这次可没办法简简单单找到藏宝地哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能不能再说一遍暗语…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊迪娅",
          "text": "好啊好啊，暗语确实不容易记住。"
        },
        {
          "role": "伊迪娅",
          "text": "「藤蔓的飞星承载着我，在安静的林间穿行，终于进入了无人打扰的清静梦乡…」"
        },
        {
          "role": "伊迪娅",
          "text": "这下应该没问题了吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我出发了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "果然有新发现！以前我们没有启动过这台「呼呼飞车」呢。说不定就是它了！"
        },
        {
          "role": "派蒙",
          "text": "坐上去试试看吧，旅行者！"
        },
        {
          "type": "subtitle",
          "text": "乘坐「呼呼飞车」"
        },
        {
          "type": "subtitle",
          "text": "寻找第二个藏宝地"
        },
        {
          "role": "派蒙",
          "text": "呜！这台「呼呼飞车」的轨道还挺曲折的，真的符合「藤蔓的飞星」这个比喻吗？"
        },
        {
          "role": "派蒙",
          "text": "什么样的流星，才能飞出这种弯弯绕绕的轨迹呢？"
        },
        {
          "type": "subtitle",
          "text": "完成先成图并挖掘宝箱",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|千奇澴回的见证物·其二}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我的预感很准嘛！第二个宝藏藏得这么隐秘，也被我们找到啦！"
        },
        {
          "role": "派蒙",
          "text": "这一回的见证物是个普通的盒子…里面好像还装着什么东西，摇晃起来有点声响？"
        },
        {
          "role": "派蒙",
          "text": "不知道马上打开盒子会发生什么事…我们先回伊迪娅小姐那里去吧！"
        },
        {
          "type": "subtitle",
          "text": "向伊迪娅回报寻宝结果"
        },
        {
          "role": "伊迪娅",
          "text": "嗯，这次寻宝的时间更久了，说明你们有好好享受解开谜题的过程！"
        },
        {
          "role": "伊迪娅",
          "text": "怎么样，除了摩拉，你们还找到了什么宝藏？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只是一个普通的盒子。",
              "dialogues": []
            },
            {
              "text": "单看外表没什么特点。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我们可以打开它吗？会不会装着…突然弹出来的鬼脸玩偶，或者「噌」的一下蹿出去炸开的烟花？"
        },
        {
          "role": "伊迪娅",
          "text": "啊呀，这么一说，在「见证物」里加入一些惊喜，的确是个好主意，以后可以建议其他访客这么干！"
        },
        {
          "role": "伊迪娅",
          "text": "话说回来，这种盒子是我提供的标准收纳盒，留下这个见证物的客人可是很正经的，你们大可以放心！"
        },
        {
          "role": "伊迪娅",
          "text": "她是一位迷路的学生，那天她睡醒后，发现自己突然来到了沙漠里，到处张望地标的时候，意外找到了「琉形蜃境」。"
        },
        {
          "role": "伊迪娅",
          "text": "她似乎还有学业任务没完成，不能停留太久。那段时间我也手忙脚乱，顾不上好好招待她，现在想来，我都还有点愧疚…"
        },
        {
          "role": "伊迪娅",
          "text": "好在她的要求非常低！只是坐在安静的地方看星星，就让她心满意足了。除此之外，她只要求了一个封闭、幽静的休息环境。"
        },
        {
          "role": "伊迪娅",
          "text": "所以我为她找到了那个洞窟，她离开之前，我还用藤蔓封上了那个山洞，让她随时可以安心睡觉！"
        },
        {
          "role": "派蒙",
          "text": "难怪暗语里提到了梦乡呢…在那个山洞里睡觉，的确不会被任何人打扰！"
        },
        {
          "role": "派蒙",
          "text": "不过…在陌生的地方醒来？总觉得这种事情有点耳熟…"
        },
        {
          "role": "派蒙",
          "text": "难不成是坐马车的时候太困了…然后被脾气很坏的车主扔下来了？"
        },
        {
          "role": "派蒙",
          "text": "伊迪娅小姐这么一说，我觉得，最好等到心静下来的时候，再看看这位神奇学生的故事！"
        },
        {
          "role": "派蒙",
          "text": "现在还有一个宝藏没找到呢！旅行者，我们先完成整个「千奇澴回」吧。"
        },
        {
          "role": "派蒙",
          "text": "如果你等不及了，倒是可以自己先看看，反正你读书的速度很快，两三下就能看完好几页纸。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为了新鲜感，我会对你保密的。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好哦！那我要在睡前喝一瓶牛奶，慢慢读读这里面的寄语，认真了解这个学生的奇妙经历。"
                }
              ]
            },
            {
              "text": "等我先读完，我来给你讲一讲。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "可以哦！你给我讲故事的话，我肯定也会听得更入神，更有兴趣！"
                },
                {
                  "role": "伊迪娅",
                  "text": "啊哈！只用两三句话就把任务分配得井井有条，不愧是默契的老搭档。"
                }
              ]
            }
          ]
        },
        {
          "role": "伊迪娅",
          "text": "那我们就继续「千奇澴回」的旅程吧！请听有关第三个藏宝地的暗语——"
        },
        {
          "role": "伊迪娅",
          "text": "「蓝蓝的屋顶没有一点灰尘，地板就像白色的糖果，软软的好朋友们陪伴着我，我也有了翅膀！」"
        },
        {
          "role": "伊迪娅",
          "text": "咳咳，很简单吧，一下子就能想到该去什么地方！"
        },
        {
          "role": "伊迪娅",
          "text": "不过，只是在远处看看还好，想要抵达那个位置可不容易。"
        },
        {
          "role": "伊迪娅",
          "text": "期待你们的表现哦！"
        },
        {
          "type": "subtitle",
          "text": "寻找第三个藏宝地"
        },
        {
          "role": "派蒙",
          "text": "第三段暗语的口吻…有点像小孩子呢。我回忆一下，哪里有蓝色的房顶和白色糖果一"
        },
        {
          "role": "派蒙",
          "text": "难道是在打比方？蓝色的房顶，应该说的是高高的天空？白色糖果的地板，说的是脚下的云层？"
        },
        {
          "role": "派蒙",
          "text": "嗯，好像可以对上嘛！我们就先去「琉形蜃境」里的最高点看看？肯定能找到线索的！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊迪娅）"
        },
        {
          "role": "伊迪娅",
          "text": "怎么样，需要回顾一下暗语吗？虽说用词很简单，但逻辑有点特别，不太好记哦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实需要再听一遍。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊迪娅",
          "text": "那这次请记好了哦！"
        },
        {
          "role": "伊迪娅",
          "text": "「蓝蓝的屋顶没有一点灰尘，地板就像白色的糖果，软软的好朋友们陪伴着我，我也有了翅膀！」"
        },
        {
          "role": "伊迪娅",
          "text": "怀着暗语里的喜悦情绪，快快出发吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题，我背下来了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "咦？快看那边！有三个小水珠在游荡？"
        },
        {
          "role": "派蒙",
          "text": "它们是不是被我们吓到了，怎么突然又散开了？"
        },
        {
          "role": "派蒙",
          "text": "软软的好朋友…也许说的就是小水珠？说明我们没找错！现在就跟上去好了！"
        },
        {
          "type": "subtitle",
          "text": "寻找水形幻灵"
        },
        {
          "role": "派蒙",
          "text": "小水珠变成了特别的东西？也许要让它们恢复原本的样子，回到之前的地方，才能解开那个暗语？"
        },
        {
          "type": "subtitle",
          "text": "让水形幻灵恢复原状"
        },
        {
          "role": "派蒙",
          "text": "我们没猜错！小水珠们聚在一起，解开了那个…「众叶觉蕊」的封印！"
        },
        {
          "role": "派蒙",
          "text": "噫！好高好远…我们想办法去高一点的地方看看吧，应该有办法够着！"
        },
        {
          "type": "subtitle",
          "text": "前往藏宝地"
        },
        {
          "type": "subtitle",
          "text": "乘坐飞亭来到最高处的浮岛",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "呜啊…居然来到了这么高的地方！要不是寻找「千奇澴回」的宝藏，我们可能就错过了这里的风景！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（眺望）"
        },
        {
          "role": "派蒙",
          "text": "原来，从高高的地方俯视那片山谷，感觉完全不一样了呢…好奇妙！"
        },
        {
          "role": "派蒙",
          "text": "那片正在发光的雾气，是各种各样的彩灯一起发亮的效果吧…那个词是怎么说的来着…想起来了！非常绚烂！"
        },
        {
          "role": "派蒙",
          "text": "快看，那边的剧场，我们之前也去过！就算在这么远的地方，也还能看到不少建筑呢…真气派！"
        },
        {
          "type": "subtitle",
          "text": "挖掘宝箱",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|千奇澴回的见证物·其三}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "找到最后的宝藏了！这次的「见证物」是一份…图纸？看不懂画了些什么呢…"
        },
        {
          "role": "派蒙",
          "text": "仔细一想，那段简单的暗语的确把每个重点都关注到了，我感觉，留下这个宝藏的人很厉害！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，之后见到伊迪娅小姐的时候，我们仔细问问她吧！"
        },
        {
          "type": "subtitle",
          "text": "向伊迪娅回报寻宝结果"
        },
        {
          "role": "派蒙",
          "text": "伊迪娅小姐，我们回来啦！"
        },
        {
          "role": "派蒙",
          "text": "行动大成功，三个宝藏都找齐了！"
        },
        {
          "role": "伊迪娅",
          "text": "咦，这么快吗？虽然已经想过旅行者很厉害，但没想到居然这么轻易…怎么样，这次寻宝的体验是不是很特别啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "藏宝地真的好高好高。",
              "dialogues": []
            },
            {
              "text": "路上的风景也很特别。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "留下第三个宝藏的人蛮有童心的！用好特别的比方表达了自己的意思，暗示的地点还都很准确…"
        },
        {
          "role": "派蒙",
          "text": "让我猜猜，这个人是不是一位童话作家？"
        },
        {
          "role": "伊迪娅",
          "text": "那不是比喻，而是她本来的想法哦。因为留下第三个宝藏的访客，本来就是个小朋友。"
        },
        {
          "role": "派蒙",
          "text": "小朋友？居然真的是个孩子吗！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这个小孩是怎么过来的？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊迪娅",
          "text": "那位小朋友听爸爸妈妈说，云朵深处藏着团雀和晶蝶的乐园，于是悄悄做了一个大风筝，想要用风筝飞高高，探访灵巧的朋友。"
        },
        {
          "role": "伊迪娅",
          "text": "不知道该说高空的风儿不懂人情，还是有意为之，她的大风筝被吹跑了，没有去往天上的乐园，而是落到了沙漠中…"
        },
        {
          "role": "伊迪娅",
          "text": "于是，她没能找到小小的团雀和晶蝶，而是和水形幻灵——也就是软软的好朋友们愉快相处了一段时间。"
        },
        {
          "role": "派蒙",
          "text": "停停停！伊迪娅小姐说得太快了，我还没跟上！"
        },
        {
          "role": "派蒙",
          "text": "而且…一个小孩子在大风筝上飞了这么远，应该发生了好多事情，你说得太快了啦，好像错过了很多细节。"
        },
        {
          "role": "伊迪娅",
          "text": "你看你看，我确实不能把小朋友冒险时的那种新奇感转述出来嘛，还是要靠你们自己去了解，去体会！"
        },
        {
          "role": "伊迪娅",
          "text": "盒子里除了小朋友留给你们的寄语，还有她精心选择的几页日记，内容可是很详实的。"
        },
        {
          "role": "伊迪娅",
          "text": "不过在这之前，还有最重要，最有仪式感的一件事，要不要先完成它呢？"
        },
        {
          "role": "派蒙",
          "text": "对，对哦！所有的宝藏都已经找到了，接下来，该留下我们自己的宝藏了。"
        },
        {
          "role": "派蒙",
          "text": "终于轮到这个环节了！旅行者，我们先想一想，把宝藏埋在哪里比较好呢？"
        },
        {
          "role": "派蒙",
          "text": "这下可要仔细考虑一下了，马虎不得！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "银瓶庭院的某个制高点？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯…高一点的地方吗？好像还挺不错的！"
                },
                {
                  "role": "伊迪娅",
                  "text": "制高点是个不错的选择，沿途的所见所闻会让人十分难忘。"
                },
                {
                  "role": "伊迪娅",
                  "text": "当然，如何登上复杂地形的高点，也是一门值得深挖的学问。"
                },
                {
                  "role": "派蒙",
                  "text": "也对，我们要考虑一下路线哦，不要放在特别陡峭的位置，寻宝的人会爬不上来的。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "克服困难后的收获更珍贵。",
                      "dialogues": []
                    },
                    {
                      "text": "我相信之后的寻宝人。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "这么一说，倒也可以理解，辛苦工作后，饭菜会变得好吃。"
                },
                {
                  "role": "派蒙",
                  "text": "解开难题后找到的宝藏，也让人更有满足感！"
                },
                {
                  "role": "派蒙",
                  "text": "那就选制高点好了，我们现在就出发吧！"
                }
              ]
            },
            {
              "text": "还是藏在湖边吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "湖边？这个地点…有什么特别的讲究吗？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "因为湖边的风景好看？",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "仔细想想，好像确实是这个道理。"
                        },
                        {
                          "role": "派蒙",
                          "text": "在景色漂亮的地方找到宝箱，心情也会更畅快！"
                        }
                      ]
                    },
                    {
                      "text": "毕竟这里是「水」的乐园？",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "「水」的乐园？"
                        },
                        {
                          "role": "派蒙",
                          "text": "我好像明白了，你想强调一下「琉形蜃境」的「主题」吗？"
                        },
                        {
                          "role": "派蒙",
                          "text": "「琉形蜃境」确实和水元素有着超级密切的关联，这算是一种点题？"
                        },
                        {
                          "role": "伊迪娅",
                          "text": "旅行者居然要在这种时候强调这件事，我…我有点感动！"
                        }
                      ]
                    },
                    {
                      "text": "哈哈，我没想那么多！",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "噫！这么随便真的好吗？明明是很重要的事啦！"
                        },
                        {
                          "role": "派蒙",
                          "text": "嗯…好像确实发生过这种事？没有特意做什么考虑，反而得到了很不错的结果…"
                        },
                        {
                          "role": "派蒙",
                          "text": "原来你是这么打算的吗…我完全理解了！"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "那就在湖边找个地方好了，我们现在就出发吧！"
                }
              ]
            },
            {
              "text": "不如就选「琉形蜃境」的正门？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "正门？你是说，要把宝箱放在入口附近吗？"
                },
                {
                  "role": "伊迪娅",
                  "text": "这么开门见山？有意思，第一次有人这样选择藏宝地。"
                },
                {
                  "role": "伊迪娅",
                  "text": "不过这样一来，有些访客就能轻轻松松找到宝藏了哦，没问题吗？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "轻松一点对大家都好。",
                      "dialogues": []
                    },
                    {
                      "text": "不必为难其他访客嘛。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "啊，我好像明白你的意思了！"
                },
                {
                  "role": "派蒙",
                  "text": "是因为我们以前为藏在角落里的宝箱发愁过，所以你不想让其他访客吃太多苦头吗？"
                },
                {
                  "role": "派蒙",
                  "text": "有道理，做了这个决定后，说不定我们也会走运，经常在路边找到宝箱！"
                },
                {
                  "role": "派蒙",
                  "text": "那就去「琉形蜃境」的入口附近看看吧，我们现在就出发！"
                }
              ]
            }
          ]
        },
        {
          "role": "伊迪娅",
          "text": "且慢，请先收下这个！"
        },
        {
          "role": "伊迪娅",
          "text": "这是蕴含着水形幻灵力量的特殊匣子，能够大大延长「见证物」的保存时间，防止它们随着时间流逝变坏。"
        },
        {
          "role": "伊迪娅",
          "text": "至于最后选择的「见证物」，你们也可以向我保密哦。"
        },
        {
          "role": "派蒙",
          "text": "好！这个道具很关键！"
        },
        {
          "role": "派蒙",
          "text": "有了这么厉害的容器，我们就可以留下一些新鲜的东西了，比如花花草草和好吃的…"
        },
        {
          "role": "派蒙",
          "text": "可是，如果我们都不告诉伊迪娅小姐…你岂不是没法把暗语转达给其他客人了？"
        },
        {
          "role": "伊迪娅",
          "text": "重要的是神秘感和惊喜！"
        },
        {
          "role": "伊迪娅",
          "text": "嘿嘿，你们留下的宝藏肯定会变成整个「千奇澴回」活动的终极惊喜，不输最初的摩拉怀表！"
