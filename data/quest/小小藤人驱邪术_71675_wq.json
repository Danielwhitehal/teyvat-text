{
  "quest_id": 71675,
  "chapter_num": null,
  "chapter_title": "小小藤人驱邪术",
  "type": "wq",
  "route": "Little Figure Exorcism",
  "stories": [
    {
      "story_id": 71675,
      "title": "小小藤人驱邪术",
      "description": "一位将蓝砚称作「姐姐」的女孩似乎制作出了不同寻常的藤人，正在美食街上进行推广…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "参与蓝颖和瑶露的讨论"
        },
        {
          "role": "蓝颖",
          "text": "[[蓝砚]]姐姐的手艺真细腻啊…"
        },
        {
          "role": "蓝颖",
          "text": "不，不止是细腻，她编得又快又准，还有种独特…灵气？"
        },
        {
          "role": "蓝颖",
          "text": "相比之下，我编得又粗糙又呆，差得好远好远…"
        },
        {
          "role": "瑶露",
          "text": "别心急，别心急。你年纪还小，进步空间还大得很。"
        },
        {
          "role": "瑶露",
          "text": "而且，不一定要完全和蓝砚姑娘走相同的路线嘛，也许你可以摸索出新的风格，自成一派。"
        },
        {
          "role": "派蒙",
          "text": "咦？刚刚听这位小朋友叫蓝砚「姐姐」…"
        },
        {
          "role": "派蒙",
          "text": "以前没听蓝砚说过她有妹妹啊？"
        },
        {
          "role": "蓝颖",
          "text": "唔…认真地说，蓝砚姐姐算是我的族姐，她是我祖父的堂兄的侄儿的女儿。"
        },
        {
          "role": "派蒙",
          "text": "停停停，好长一串亲戚，我要头晕了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这么远的亲属关系啊。",
              "dialogues": []
            },
            {
              "text": "蓝家可真是个大家族。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蓝颖",
          "text": "我之前远远看见你们和蓝砚姐姐在聊天，蓝砚姐姐的表情非常开心，你们应该是她的好朋友？"
        },
        {
          "role": "蓝颖",
          "text": "唔…能不能请你们帮我看看，我学着蓝砚姐姐的手法，编出的这个「驱邪藤人」怎么样？"
        },
        {
          "role": "派蒙",
          "text": "原来这是你的杰作？是按蓝砚的形象编的藤人啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这不是挺可爱的嘛？",
              "dialogues": []
            },
            {
              "text": "做得用心又精致哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！感觉非常传神，做工也完全挑不出毛病！"
        },
        {
          "role": "瑶露",
          "text": "对吧，我也觉得非常棒，小蓝颖可以自信一点！"
        },
        {
          "role": "瑶露",
          "text": "而且，别看这个藤人个头小小，它的本领可是强大的哦。"
        },
        {
          "role": "瑶露",
          "text": "它的内部装载了一种奇门术法的机关核心，可以收集并封存散落的邪气哦。"
        },
        {
          "role": "蓝颖",
          "text": "其实多亏了蓝砚姐姐啦，我是跟她学会编这种藤人的。"
        },
        {
          "role": "蓝颖",
          "text": "另外，比起蓝砚姐姐的作品，它只…只能处理那种不太强的，零散的小邪气团…"
        },
        {
          "role": "蓝颖",
          "text": "听说，每到大大的邪祟作乱时，这些小邪气团也会跟着冒出来，到处害人。"
        },
        {
          "role": "蓝颖",
          "text": "它们会让人头疼脑胀，身体虚弱，染上各种病症。"
        },
        {
          "role": "蓝颖",
          "text": "我看家族里的叔叔伯伯们被大块头的邪祟缠住，忙个不停，不怎么有空应付这些小邪气团…"
        },
        {
          "role": "蓝颖",
          "text": "就找蓝砚姐姐学艺，一起做出了这种驱邪藤人，派它们吸收仙力，处理掉小邪气团，相对省事一点…"
        },
        {
          "role": "派蒙",
          "text": "我懂了，这样就等于把藤人变成了小帮手，能给方士们节省时间，也能帮普通人应对小邪气。"
        },
        {
          "role": "瑶露",
          "text": "我就是受益者！"
        },
        {
          "role": "瑶露",
          "text": "前段时间，我被小邪气团影响，染了大病，还好有小蓝颖帮忙，才恢复过来…"
        },
        {
          "role": "瑶露",
          "text": "听小蓝颖介绍了驱邪藤人，我觉得，这种好帮手应该人手一个才对。"
        },
        {
          "role": "瑶露",
          "text": "所以就带着小蓝颖来美食街摆摊了，友情价出售「驱邪藤人」，只收成本费！"
        },
        {
          "role": "派蒙",
          "text": "原来如此…小蓝颖已经很了不起了，这个藤人不止是好看而已！"
        },
        {
          "role": "派蒙",
          "text": "每五十户人家里，有一家买了这种藤人的话，应该就不用再怕规模不大的邪气了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们就买下这个吧？",
              "dialogues": []
            },
            {
              "text": "这个藤人多少钱呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蓝颖",
          "text": "你们是蓝砚姐姐的朋友，送你们，不收摩拉！"
        },
        {
          "role": "瑶露",
          "text": "而且，蓝家的大师们听说了这件事以后非常高兴，还说要给拿着藤人驱散邪气的大家苦劳费。"
        },
        {
          "role": "瑶露",
          "text": "如果你们用这个「驱邪藤人」吸收仙力，处理了小邪气团，记得到我们这里领取报酬哦。"
        },
        {
          "role": "派蒙",
          "text": "居然还有这种好事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "搞定麻烦又拿报酬，双赢。",
              "dialogues": []
            },
            {
              "text": "怎么想都等于我们赚了两回。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那事不宜迟，我们就用「驱邪藤人」试着处理小邪气团吧？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（蓝颖）"
        },
        {
          "role": "蓝颖",
          "text": "你好，蓝砚姐姐的好朋友，要试试「驱邪藤人」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就开始吧？",
              "dialogues": [
                {
                  "role": "蓝颖",
                  "text": "嗯！「驱邪藤人」准备出发！"
                }
              ]
            },
            {
              "text": "你和蓝砚的关系很不错吧？",
              "dialogues": [
                {
                  "role": "蓝颖",
                  "text": "唔…应该说，家族里没有和蓝砚姐姐关系不好的同辈？"
                },
                {
                  "role": "蓝颖",
                  "text": "我们的确是个大家族，有特别多的亲戚，其中一些论亲属关系非常远，也不住在一起。"
                },
                {
                  "role": "蓝颖",
                  "text": "可能两三年才会见上一面，平时甚至连名字都很少听人提起，甚至忘了还有这么个远亲…"
                },
                {
                  "role": "蓝颖",
                  "text": "但蓝砚姐姐不会因为血缘关系不那么近，就敷衍对待我们，不管隔了多久再见面，她都能认出我。"
                },
                {
                  "role": "蓝颖",
                  "text": "所以每次过节聚在一起的时候，我都喜欢找蓝砚姐姐玩！"
                }
              ]
            },
            {
              "text": "关于藤人…",
              "dialogues": [
                {
                  "role": "蓝颖",
                  "text": "你想了解这门手艺吗？那欢迎哦！"
                },
                {
                  "role": "蓝颖",
                  "text": "我们蓝家的长辈乐于传授这门技巧，只收伙食费级别的学费…"
                },
                {
                  "role": "蓝颖",
                  "text": "不过，前提是不能想着靠藤人发财，赚骗人的钱。"
                },
                {
                  "role": "蓝颖",
                  "text": "要是有坏家伙打着蓝家的名号，故意炒作自己的藤人，忽悠别人出高价来买…"
                },
                {
                  "role": "蓝颖",
                  "text": "我们会直接向总务司反映的，然后会有专人用律法的手段来制裁他们！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "听起来有案例…",
                      "dialogues": []
                    },
                    {
                      "text": "难道发生过这种事？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "蓝颖",
                  "text": "是啊，我小时候就听说过几个…打着「传统」、「祖传」、「秘方」旗号，无缘无故坐地起价的商人。"
                },
                {
                  "role": "蓝颖",
                  "text": "真正能帮到大家的，能被一直流传下来的好东西，不应该成为…暴富的工具吧？"
                },
                {
                  "role": "蓝颖",
                  "text": "好在最后，总务司派出一位律法专家，[[烟绯|红头发的姐姐]]，她把那些无良商人都收拾了！"
                },
                {
                  "role": "蓝颖",
                  "text": "追缴回来的钱财，都还给了受骗的买家，那些商人还交了一大笔罚款。"
                },
                {
                  "role": "蓝颖",
                  "text": "要是我长大以后，还有那样的坏商人，我马上就去告诉那个红头发的姐姐！"
                }
              ]
            },
            {
              "text": "待会儿再来玩。",
              "dialogues": [
                {
                  "role": "蓝颖",
                  "text": "那就之后再见啦。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（瑶露）"
        },
        {
          "role": "瑶露",
          "text": "争取再多编几种藤人的外形，目标是凑齐「八奇乱斗」全阵容~"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们是不是见过？",
              "dialogues": [
                {
                  "role": "瑶露",
                  "text": "咦？你这么一说，确实有可能哦。"
                },
                {
                  "role": "瑶露",
                  "text": "之前有一年的海灯节上，我从总务司那里接过了「八奇乱斗」的相关事宜，也是一个和藤人有关的游艺。"
                },
                {
                  "role": "瑶露",
                  "text": "也许你当时也来玩过？"
                },
                {
                  "role": "瑶露",
                  "text": "不过当时客人太多了，我也不记得每个客人的样子了，不好意思呀！事情一多，我就容易忘事！"
                }
              ]
            },
            {
              "text": "关于蓝家…",
              "dialogues": [
                {
                  "role": "瑶露",
                  "text": "啊，其实我不是蓝家的人啦，只算帮忙打杂的。"
                },
                {
                  "role": "瑶露",
                  "text": "应该说，从我爷爷奶奶那一辈开始，就和蓝家关系很好了。"
                },
                {
                  "role": "瑶露",
                  "text": "我爷爷是木匠，主要的顾客就是蓝家，奶奶是茶商，经常要自己编竹篓和藤条簸箕，特意跟着蓝家学过手艺…"
                },
                {
                  "role": "瑶露",
                  "text": "所以我奶奶一样会编藤人，虽说比起蓝砚师傅的作品，在传神的程度上逊色一些，但也特别漂亮，我小时候可喜欢了！"
                },
                {
                  "role": "瑶露",
                  "text": "嗯，现在还有新星——蓝颖妹妹手巧心细，以后肯定也会成为手工大师的！"
                }
              ]
            },
            {
              "text": "不打扰了。",
              "dialogues": [
                {
                  "role": "瑶露",
                  "text": "d啊…那回见！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          39,
          41
        ],
        [
          42,
          44
        ]
      ]
    }
  ]
}