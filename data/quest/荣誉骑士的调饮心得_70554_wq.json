{
  "quest_id": 70554,
  "chapter_num": null,
  "chapter_title": "荣誉骑士的调饮心得",
  "type": "wq",
  "route": "Honorary Knight's Notes on Mixology",
  "stories": [
    {
      "story_id": 70554,
      "title": "荣誉骑士的调饮心得",
      "description": "骑士团的饮品小站即将开张，后勤小队的赫塔正在寻找帮手…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与赫塔对话"
        },
        {
          "role": "赫塔",
          "text": "荣誉骑士和白色小帮手，你们好啊！"
        },
        {
          "role": "格兰菲狄",
          "text": "初次见面，荣誉骑士和派蒙长官，在下格兰菲狄，听候调遣。"
        },
        {
          "role": "派蒙",
          "text": "心情不错嘛，赫塔！还有这位骑士小姐，很高兴认识你！"
        },
        {
          "role": "派蒙",
          "text": "看样子，你们正准备开张了？"
        },
        {
          "role": "赫塔",
          "text": "嗯！得益于「天使的馈赠」和「猫尾酒馆」的协助，饮品小站的一切都准备就绪了。"
        },
        {
          "role": "赫塔",
          "text": "除了经典的纯饮，我们这里也提供调制饮品，以及限时饮品外送服务…"
        },
        {
          "role": "派蒙",
          "text": "调制饮品？"
        },
        {
          "role": "派蒙",
          "text": "很久以前，我们在「天使的馈赠」当过调饮师来着？最近你在挪德卡莱的「旗舰」也露过几手…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实呢，好久好久了。",
              "dialogues": []
            },
            {
              "text": "记不太清了，不过没关系。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "赫塔",
          "text": "不过，目前的饮品都比较传统，远征开始前，所有人就习以为常了。为了给大家提供新鲜的选择，我们打算改进酒单。"
        },
        {
          "role": "赫塔",
          "text": "但我还得回去管理居民请求的事宜，格兰菲狄调制饮品的经验又不足，还有外送的订单要处理…"
        },
        {
          "role": "赫塔",
          "text": "如果荣誉骑士有空，能麻烦你暂时帮帮忙吗？一段时间后，我的另一组部下就会从望风山地回来顶班。"
        },
        {
          "role": "格兰菲狄",
          "text": "当然，我们会支付报酬，还有双倍的加班绩效！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我确实对调制饮品颇有心得。",
              "dialogues": []
            },
            {
              "text": "整个吧台可以完全交给我哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "虽然听不懂绩效是什么，但我也可以帮忙处理外送订单的事！"
        },
        {
          "role": "派蒙",
          "text": "作为提瓦特最好的向导，我也要与时俱进，多在城里转转，了解一下蒙德最近的变化！"
        },
        {
          "role": "赫塔",
          "text": "哎呀，和你们两位合作起来，简直顺利得就像呼吸一样自然！"
        },
        {
          "role": "格兰菲狄",
          "text": "我就全力支援派蒙长官。分装饮品之类的工作，我非常熟练。"
        },
        {
          "role": "派蒙",
          "text": "那事不宜迟，开工开工！"
        }
      ]
    }
  ]
}