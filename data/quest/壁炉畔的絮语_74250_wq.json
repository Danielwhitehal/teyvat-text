{
  "quest_id": 74250,
  "chapter_num": null,
  "chapter_title": "壁炉畔的絮语",
  "type": "wq",
  "route": "Whispers by the Hearth",
  "stories": [
    {
      "story_id": 74250,
      "title": "壁炉畔的絮语",
      "description": "前往布法蒂公馆附近放置茶桌并使用桑多涅落座后，与众人共度茶会时光吧…",
      "dialogues": [
        {
          "role": "「木偶」",
          "text": "这么想想，以前你们到至冬时，都没这样好好地招待过你们。"
        },
        {
          "role": "林尼",
          "text": "请别这么说，桑多涅女士。即便那时没像这样一起坐下来聊天，但您每次都为我们准备了美味的茶点。"
        },
        {
          "role": "「木偶」",
          "text": "哎，抱歉。以前在那边太忙了，下次你们去的时候会多照顾你们一些的。"
        },
        {
          "role": "琳妮特",
          "text": "你以前也从不给我玩你发明的机械。"
        },
        {
          "role": "「木偶」",
          "text": "那是其他原因…"
        },
        {
          "role": "琳妮特",
          "text": "哼…"
        },
        {
          "role": "菲米尼",
          "text": "其实「父亲」大人也和我们说过，尽量不要打扰桑多涅小姐。"
        },
        {
          "role": "「木偶」",
          "text": "没事，我不在意。下次多来我这边喝点下午茶吧。"
        },
        {
          "role": "菲米尼",
          "text": "真的吗？我其实…一直都想让您帮我看看佩伊…有些改进的方向想向您请教。"
        },
        {
          "role": "「木偶」",
          "text": "好啊，这可是我的专业领域。"
        },
        {
          "role": "菲米尼",
          "text": "…谢谢桑多涅女士！"
        },
        {
          "role": "琳妮特",
          "text": "当「执行官」真的很辛苦吗？"
        },
        {
          "role": "「木偶」",
          "text": "你要这么问的话…是有点吧。要考虑的事情很多。尽管工作中更多不爽的地方是来源于同事…"
        },
        {
          "role": "菲米尼",
          "text": "也就是说…与他人的相处很重要？"
        },
        {
          "role": "「木偶」",
          "text": "算是吧。我看林尼在这方面应该没什么问题。"
        },
        {
          "role": "林尼",
          "text": "哈哈，不敢不敢，桑多涅女士抬举我了。"
        },
        {
          "role": "「木偶」",
          "text": "你想成为「执行官」吗？算了，这话题不应该我来问。当我没说。"
        },
        {
          "role": "林尼",
          "text": "嗯…这话题对我来说还有些远呢。或许以后再想也不迟吧。"
        },
        {
          "role": "琳妮特",
          "text": "当「执行官」是不是就没时间和我们一起行动了？"
        },
        {
          "role": "菲米尼",
          "text": "如果是这样的话…难道说…我和琳妮特也必须成为「执行官」？"
        },
        {
          "role": "林尼",
          "text": "你们两个，说了这是以后考虑的问题啦。"
        },
        {
          "role": "林尼",
          "text": "而且，不论到哪里，我都不会抛下你们的，这我保证。"
        },
        {
          "role": "「木偶」",
          "text": "哈…有时真羡慕你们这一家子。"
        },
        {
          "role": "林尼",
          "text": "多谢桑多涅女士的款待。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "林尼",
          "text": "嗯，您慢走。"
        }
      ]
    }
  ]
}