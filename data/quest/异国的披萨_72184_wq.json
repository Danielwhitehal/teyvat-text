{
  "quest_id": 72184,
  "chapter_num": null,
  "chapter_title": "异国的披萨",
  "type": "wq",
  "route": "Pizza From Another Land",
  "stories": [
    {
      "story_id": 72184,
      "title": "异国的披萨",
      "description": "「木南料亭」的木南杏奈小姐似乎正在被什么事困扰…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与木南杏奈对话"
        },
        {
          "type": "subtitle",
          "text": "与梨绘对话"
        },
        {
          "role": "梨绘",
          "text": "你好呀，有什么事找我吗？"
        },
        {
          "role": "旅行者",
          "text": "关于「木南料亭」的披萨…"
        },
        {
          "role": "梨绘",
          "text": "哦，你说那个披萨啊，味道确实很不错。"
        },
        {
          "role": "梨绘",
          "text": "但是…怎么说呢，总感觉不太吃得惯呢。"
        },
        {
          "role": "梨绘",
          "text": "我个人是觉得，要是能在那种披萨里融入一些稻妻本地食材的话，比如堇瓜之类的…"
        },
        {
          "role": "梨绘",
          "text": "说不定，这种披萨会更受大家欢迎呢。"
        },
        {
          "type": "subtitle",
          "text": "向木南杏奈回报"
        },
        {
          "role": "木南杏奈",
          "text": "旅行者，你回来了。"
        },
        {
          "role": "木南杏奈",
          "text": "怎么样，你有问到什么吗？"
        },
        {
          "role": "旅行者",
          "text": "关于客人们的反馈…"
        },
        {
          "role": "木南杏奈",
          "text": "用堇瓜做的披萨…倒也不会太复杂…"
        },
        {
          "role": "木南杏奈",
          "text": "其余的材料就照常准备好了，唔，既然都说要「融入一些稻妻本地食材」了，那我就再加一点其他的材料好了…"
        },
        {
          "role": "木南杏奈",
          "text": "唔，海灵芝？鸣草？嗯…幽灯蕈怎么样…"
        },
        {
          "role": "旅行者",
          "text": "那个，要我帮忙吗？"
        },
        {
          "role": "木南杏奈",
          "text": "喔！抱歉，我光顾着想放什么食材好了！我看看，店里的堇瓜好像没多少了…"
        },
        {
          "role": "木南杏奈",
          "text": "旅行者，请你去帮我拿一个堇瓜来吧，材料的话…应该就只差这个了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我了。",
              "dialogues": [
                {
                  "role": "木南杏奈",
                  "text": "嗯，那就拜托你了，只要一个堇瓜就好。"
                }
              ]
            },
            {
              "text": "还要找其他的食材吗？",
              "dialogues": [
                {
                  "role": "木南杏奈",
                  "text": "其他的食材店里还有些存货，你带一个堇瓜回来就好，拜托你啦。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "将堇瓜带回给木南杏奈"
        },
        {
          "role": "木南杏奈",
          "text": "你把食材带回来了吗？"
        },
        {
          "type": "subtitle",
          "text": "与木南杏奈对话"
        },
        {
          "role": "木南杏奈",
          "text": "谢谢你，有这些食材就够了。"
        },
        {
          "role": "木南杏奈",
          "text": "加入了稻妻本地食材的披萨，不知道做出来会是什么味道…"
        },
        {
          "role": "木南杏奈",
          "text": "完成了！"
        },
        {
          "role": "木南杏奈",
          "text": "这披萨…看上去还不错…"
        },
        {
          "role": "木南杏奈",
          "text": "谢谢你帮忙，旅行者，这些东西请你收下吧。"
        },
        {
          "role": "木南杏奈",
          "text": "我等会就去仔细品尝一下这份披萨的味道…"
        },
        {
          "role": "木南杏奈",
          "text": "如果还不错的话…应该很快就能作为新品正式推出啦。"
        }
      ]
    }
  ]
}