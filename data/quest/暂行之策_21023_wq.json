{
  "quest_id": 21023,
  "chapter_num": null,
  "chapter_title": "暂行之策",
  "type": "wq",
  "route": "A Provisional Arrangement",
  "stories": [
    {
      "story_id": 21023,
      "title": "暂行之策",
      "description": "望舒客栈的楼梯似乎出了问题，暂时处于封闭状态。怎么去客栈顶上，是一个问题…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "乘坐升降机"
        },
        {
          "type": "subtitle",
          "text": "与淮安对话"
        },
        {
          "role": "淮安",
          "text": "楼梯还是得赶紧修了啊…"
        },
        {
          "role": "旅行者",
          "text": "你是掌柜的吗？"
        },
        {
          "role": "淮安",
          "text": "我是，您有什么事吗？"
        },
        {
          "role": "派蒙",
          "text": "有一份给你的包裹，是楼下的一个人要我们送给你的。"
        },
        {
          "role": "淮安",
          "text": "哦…这应该是客商给我的包裹…甄强怎么自己不来送？"
        },
        {
          "role": "淮安",
          "text": "他还有货要接？嗨，他准是嫌上上下下麻烦，懒得上来又下去…"
        },
        {
          "role": "淮安",
          "text": "您是客人吧，实在对不住，这楼梯坏得太不是时候了，我正寻思着怎么修呢。"
        },
        {
          "role": "淮安",
          "text": "真是麻烦了，还让您来送这个包裹给我，这样，这份报酬给您，您收好。"
        },
        {
          "role": "淮安",
          "text": "这本来是给甄强准备的，但既然他让您来送了这个包裹，那这份报酬当然该您收下。"
        },
        {
          "role": "淮安",
          "text": "好了，我接着去筹备修楼梯的事了，您随意在客栈里逛逛，有什么事您随时找我。"
        }
      ]
    }
  ]
}