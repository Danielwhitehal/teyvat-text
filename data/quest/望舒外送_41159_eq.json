{
  "quest_id": 41159,
  "chapter_num": null,
  "chapter_title": "望舒外送",
  "type": "eq",
  "route": "Wangshu Take-Away",
  "stories": [
    {
      "story_id": 41159,
      "title": "望舒外送",
      "description": "璃月的望舒客栈里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "言笑",
          "text": "那你忙着吧，我想想怎么办。"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "言笑",
          "text": "那麻烦你了。杏仁豆腐这东西，你明白吧，剧烈颠簸可能就碎了。"
        },
        {
          "role": "言笑",
          "text": "所以别乱飞乱爬乱跑。路上注意一下。"
        },
        {
          "role": "随缘的铃官",
          "text": "我觉得也该到了。"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "言笑",
          "text": "是的。铃官这人要了一份杏仁豆腐，然后就又往明蕴镇方向去了。"
        },
        {
          "role": "言笑",
          "text": "明蕴镇可是个怪地方啊。"
        },
        {
          "role": "言笑",
          "text": "总之这份杏仁豆腐希望有人能帮忙给她送过去。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "随缘的铃官",
          "text": "嘿嘿，谢谢你啦。我还以为走这么近，望舒客栈就不送了呢。"
        }
      ]
    }
  ]
}