  "stories": [
    {
      "story_id": 72713,
      "title": "村上的食材需求",
      "description": "鸣神岛的村上需要十五份薄荷。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将十五个薄荷交给村上"
        },
        {
          "role": "旅行者",
          "text": "关于薄荷…"
        },
        {
          "role": "村上",
          "text": "薄荷、薄荷…只要有了薄荷肯定就能融合出不一样的风味…"
        },
        {
          "role": "村上",
          "text": "你是接下委托的那位吧，那十五份薄荷你应该也准备好了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": []
            },
            {
              "text": "还没有。",
              "dialogues": [
                {
                  "role": "村上",
                  "text": "那你准备好了之后，再拿给我吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与村上对话"
        },
        {
          "role": "村上",
          "text": "这下就可以开始创造新料理了，哦，我差点忘了，这些报酬请你收下。"
        }
      ]
    }
  ]
