{
  "quest_id": 10233,
  "chapter_num": "和旋舞剧·第二幕",
  "chapter_title": "一波三折的辗转",
  "type": "eq",
  "route": "A Series of Twists and Turns",
  "stories": [
    {
      "story_id": 40195,
      "title": "一波三折的辗转",
      "description": "经过了一段时间，你们决定再访沫芒宫，查看龙伙伴的情况。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后的上午（8点-10点）"
        },
        {
          "role": "派蒙",
          "text": "算算时间，已经过了飞行物禁令期了呢。"
        },
        {
          "role": "派蒙",
          "text": "我们去沫芒宫看看咔库库的情况吧！"
        },
        {
          "type": "subtitle",
          "text": "去沫芒宫了解情况"
        },
        {
          "role": "派蒙",
          "text": "各位，我们来咯…"
        },
        {
          "role": "咔库库",
          "text": "哦我亲爱的老伙计们，早安！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "早安，小伙计！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哦天哪，咔库库又学会新的问候语了！"
        },
        {
          "role": "派蒙",
          "text": "一时间不知是福是祸…"
        },
        {
          "role": "莱欧斯利",
          "text": "抱歉，尽管拼尽全力，暂时只教会了他怎么说「早安」。"
        },
        {
          "role": "派蒙",
          "text": "你这几天就一直在忙这个吗！"
        },
        {
          "role": "咔库库",
          "text": "不对！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "它说不对。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "啊？"
        },
        {
          "role": "派蒙",
          "text": "所以除此之外，我们还有别的进展，对吗？"
        },
        {
          "role": "基尼奇",
          "text": "是，这就是为什么我在这里。"
        },
        {
          "role": "基尼奇",
          "text": "除了教咔库库说话以外，显然莱欧斯利先生还叫囚犯们「说话」了。"
        },
        {
          "role": "莱欧斯利",
          "text": "不算很难办的犯人，小事。"
        },
        {
          "role": "派蒙",
          "text": "所以所以，情况如何？"
        },
        {
          "role": "基尼奇",
          "text": "经过犯人们的仔细回忆，当他们正准备整理货物离开纳塔时，的确有一个不起眼的中年男子和他们搭过话。"
        },
        {
          "role": "基尼奇",
          "text": "此人穿着回声之子的常见服饰，提着一个箱子，和装枪的这个十分相似。整体上，和正常出游的纳塔人没什么区别。"
        },
        {
          "role": "基尼奇",
          "text": "可能因为走私犯们打扮成了商人模样，这个男人曾与他们闲聊，试图询问他们的货物卖往何方，还提出可否一起搭船。"
        },
        {
          "role": "基尼奇",
          "text": "但走私犯们都很谨慎，只是简单搪塞了他几句。"
        },
        {
          "role": "基尼奇",
          "text": "不过这些事情都发生在我遇到这些走私犯之前。"
        },
        {
          "role": "基尼奇",
          "text": "而我是碰巧在他们登船时发现了这样一伙儿形迹可疑的人，所以跟了上去，一路来到枫丹…"
        },
        {
          "type": "subtitle",
          "text": "回想开始",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "卡纳卡",
          "text": "老大，你说枫丹人会喜欢这种东西吗？要是卖不动怎么办…"
        },
        {
          "role": "瓦努卡",
          "text": "要不说你是菜鸟呢。物以稀为贵，纳塔的对外贸易才刚起步，岂有没市场的道理。"
        },
        {
          "role": "查霍尔",
          "text": "就是，快别给大哥添乱了。有这功夫不如看好箱子。"
        },
        {
          "role": "基尼奇",
          "text": "（商人吗？是来枫丹做生意？）"
        },
        {
          "role": "基尼奇",
          "text": "（脸上有伤疤，手上都是茧…）"
        },
        {
          "role": "基尼奇",
          "text": "（细看衣服的膝盖和手肘处均有磨损，指甲也有灰尘…看起来不像普通的商人。）"
        },
        {
          "role": "基尼奇",
          "text": "（难道是战士或者冒险家转行？）"
        },
        {
          "role": "基尼奇",
          "text": "（有些奇怪。小心靠近，再仔细看看吧。）"
        },
        {
          "type": "subtitle",
          "text": "悄悄靠近，弄清对方的意图"
        },
        {
          "role": "查霍尔",
          "text": "嘿嘿，大哥的主意真是不错，坐游客的船又快又稳，也没人问东问西。"
        },
        {
          "role": "瓦努卡",
          "text": "那可不。大货船太慢，小船虽快但实在颠簸。"
        },
        {
          "role": "瓦努卡",
          "text": "万一不小心损坏了货物，我们这几个月全白干。"
        },
        {
          "role": "基尼奇",
          "text": "（就这点东西需要几个月准备？还必须小心运输？）"
        },
        {
          "role": "基尼奇",
          "text": "（难道是从纳塔偷偷带出的珍贵物品…得想办法确认一下。）"
        },
        {
          "type": "subtitle",
          "text": "想办法引开对方，调查货箱"
        },
        {
          "type": "subtitle",
          "text": "被走私犯抓住"
        },
        {
          "role": "查霍尔",
          "text": "什么人？"
        },
        {
          "role": "瓦努卡",
          "text": "什么声音？"
        },
        {
          "role": "卡纳卡",
          "text": "什么人？"
        },
        {
          "role": "基尼奇",
          "text": "（嘶…）"
        },
        {
          "type": "subtitle",
          "text": "还需更加谨慎。小心隐蔽，适当引开对方的注意力，再试一次吧。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "基尼奇",
          "text": "（果然，箱子中藏了一些文物…私自将它们带出纳塔可是违反规定的。）"
        },
        {
          "role": "基尼奇",
          "text": "（去听听犯人们的「口供」吧。）"
        },
        {
          "type": "subtitle",
          "text": "悄悄靠近，弄清对方的意图"
        },
        {
          "role": "查霍尔",
          "text": "喂，怎么愁眉苦脸的？来国外做生意，还能顺路旅游玩耍，难道不是一件好事吗？快，高兴点。"
        },
        {
          "role": "卡纳卡",
          "text": "哈哈…你说的是。我就是有些担心，怕行李打包得不好，万一路上出了问题怎么办…"
        },
        {
          "role": "查霍尔",
          "text": "放松！去枫丹旅游的外国人多着呢，箱子里什么稀奇古怪的东西没有啊。"
        },
        {
          "role": "查霍尔",
          "text": "如果有人非要一件一件地检查，就把提前准备好的「订单合同」拿出来。"
        },
        {
          "role": "查霍尔",
          "text": "听说他们枫丹人最爱看「条款」，那就让他们看个够。"
        },
        {
          "role": "基尼奇",
          "text": "（啊，果然是想蒙混过关的走私品。）"
        },
        {
          "role": "基尼奇",
          "text": "（基本掌握了走私犯的人员和赃物信息，趁现在，去告知港口的警务人员吧。）"
        },
        {
          "type": "subtitle",
          "text": "回想结束",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "基尼奇",
          "text": "…总之，接下来我就跟枫丹当地的警卫说明了我的怀疑。"
        },
        {
          "role": "基尼奇",
          "text": "经过一番调查和追捕，的确是送他们上路了。"
        },
        {
          "role": "派蒙",
          "text": "也算是走上正路了吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "干得好，基尼奇！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基尼奇",
          "text": "多谢支持。"
        },
        {
          "role": "莱欧斯利",
          "text": "听你刚刚的回忆…"
        },
        {
          "role": "基尼奇",
          "text": "唉，我当时的注意力都在那几个走私犯身上，没有特别注意其他路过的人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "人之常情，别放在心上。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是啊，基尼奇已经很厉害啦。"
        },
        {
          "role": "莱欧斯利",
          "text": "也就是说，带来这把枪，和「丢失」这把枪的人，与走私团伙并无关系。以上种种只是个人行为。"
        },
        {
          "role": "咔库库",
          "text": "哎呀！哎呀！"
        },
        {
          "role": "莱欧斯利",
          "text": "哦，我们咔库库先生有什么想说的吗？"
        },
        {
          "role": "那维莱特",
          "text": "他说这人太奇怪了。"
        },
        {
          "role": "莱欧斯利",
          "text": "那咔库库说得对。"
        },
        {
          "role": "莱欧斯利",
          "text": "然而我们目前对此人知之甚少，不如先从「失物」本身入手吧。"
        },
        {
          "type": "subtitle",
          "text": "关于这把枪的疑点…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来自纳塔古龙遗迹…",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（这是一件来自纳塔古龙文明的遗物，也就是古董，价值应该很高。）",
                  "narration": true
                }
              ]
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "被人捡到的遗失物…",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（一件遗落在路边的宝物，却至今无人挂失，也无人认领…）",
                  "narration": true
                }
              ]
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "箱子被埋在杂物中…",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（不是不小心丢失的状态，更像是有人故意为之。）",
                  "narration": true
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "出现新选项「诱饵？」",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "诱饵？",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（将一件价值昂贵的古董放置在野外，难道是在等人来取？）",
                  "narration": true
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "提交错误结论"
        },
        {
          "type": "subtitle",
          "text": "（好像不对…再好好考虑一下…）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "提交结论「诱饵？」",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "基尼奇",
          "text": "的确很像是布置在陷阱里的诱饵。"
        },
        {
          "role": "基尼奇",
          "text": "不过唯一的问题是，诱饵应该要更显眼才对。"
        },
        {
          "role": "莱欧斯利",
          "text": "唔…"
        },
        {
          "role": "那维莱特",
          "text": "想到什么了吗？"
        },
        {
          "role": "莱欧斯利",
          "text": "想到了之前看过的一部映影。"
        },
        {
          "role": "派蒙",
          "text": "啊？"
        },
        {
          "role": "咔库库",
          "text": "哦天哪，不会吧哥们！"
        },
        {
          "role": "莱欧斯利",
          "text": "别急嘛。"
        },
        {
          "role": "莱欧斯利",
          "text": "刚刚旅行者推测，这个箱子是故意放在那里等人来取，正好让我想起那种与绑架案有关的映影。"
        },
        {
          "role": "莱欧斯利",
          "text": "在索要赎金时，绑匪要求受害人家属把钱或者值钱的东西放在某个约定地点，等人来取。"
        },
        {
          "role": "那维莱特",
          "text": "不用说文艺作品，即使在现实中也有类似的案件发生。"
        },
        {
          "role": "那维莱特",
          "text": "或者不如说，映影的情节才应该是取材于现实的。"
        },
        {
          "role": "基尼奇",
          "text": "哦，是个好思路。"
        },
        {
          "role": "派蒙",
          "text": "等等等等，情况突然变得复杂了…"
        },
        {
          "role": "派蒙",
          "text": "如果这把枪真的是用来赎人的，那岂不是因为我们把箱子拿走了，绑匪没能拿到赎金…"
        },
        {
          "role": "派蒙",
          "text": "所以…有、有人被撕票了…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，冷静。",
              "dialogues": []
            },
            {
              "text": "还没听说有失踪人员。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱欧斯利",
          "text": "是，我也觉得这并不是一起绑架案。"
        },
        {
          "role": "莱欧斯利",
          "text": "为了避免后续销赃问题，除非绑匪想要特定物品，不然都是要求现金支付的。"
        },
        {
          "role": "莱欧斯利",
          "text": "一个痴迷古龙手枪的绑架犯…也不是没有可能吧，但我们先把这种极其微小的可能性放在一边。"
        },
        {
          "role": "莱欧斯利",
          "text": "而说到销赃问题，你们不觉得，这件事更像是一起交易吗？"
        },
        {
          "type": "subtitle",
          "text": "关于交易内容…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于卖方…",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（使用上锁的箱子将货物放在隐蔽地点，显然卖方不想透露自己的身份。）",
                  "narration": true
                }
              ]
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于买方…",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（买方接到指示后，带着钱前往约定好的地点取货。为了确保真的能收到货款，卖方应该是会对买方进行监视。）",
                  "narration": true
                }
              ]
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于货物…",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（在买方前来交易前，货物不巧被突然来搭建活动场地的乐平波琳捡到。）",
                  "narration": true
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "出现新选项「未能完成的交易…」",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "未能完成的交易…",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（由于映影欢乐城的「搅局」，这场交易被迫终止。）",
                  "narration": true
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "提交错误结论"
        },
        {
          "type": "subtitle",
          "text": "（好像不对…再好好考虑一下…）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "提交结论「未能完成的交易…」",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "基尼奇",
          "text": "所以本质上，这是一起个人走私行为。"
        },
        {
          "role": "莱欧斯利",
          "text": "对，而且造成交易未能完成的问题，就出在了交易地点上。"
        },
        {
          "role": "莱欧斯利",
          "text": "谁也没想到交易地点一夜之间从无人问津的沙滩，变成了活动举办地。"
        },
        {
          "role": "莱欧斯利",
          "text": "不仅游客众多，还有刺玫会的人参与其中，估计交易双方都被打了个措手不及。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "干得好，乐平波琳！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "那维莱特",
          "text": "听下来是个合理的猜想，但要怎么确认呢？"
        },
        {
          "role": "莱欧斯利",
          "text": "要辛苦下你的人了。"
        },
        {
          "role": "那维莱特",
          "text": "怎么说？"
        },
        {
          "role": "莱欧斯利",
          "text": "简单，按照正常流程发布失物招领即可。"
        },
        {
          "role": "莱欧斯利",
          "text": "我们表现得越平常，嫌疑人会来认领的概率就越大。即便不是他亲自来取，我们也能获得新的线索。"
        },
        {
          "role": "莱欧斯利",
          "text": "而且算算工时…也正好要到更新公告板的时间了。"
        },
        {
          "role": "莱欧斯利",
          "text": "就是要找一位幸运的复律官，加急出一份文书咯。"
        },
        {
          "role": "那维莱特",
          "text": "啊，你说的「幸运」是这个意思…"
        },
        {
          "role": "那维莱特",
          "text": "既然如此，不如我亲自来写吧。"
        },
        {
          "role": "那维莱特",
          "text": "如果委托给其他人，还得做额外的说明…"
        },
        {
          "role": "莱欧斯利",
          "text": "呵呵，我看你只是不习惯叫人加班吧？"
        },
        {
          "role": "派蒙",
          "text": "原来在意的是这个吗？！"
        },
        {
          "role": "基尼奇",
          "text": "那至少在失物招领发布之前，暂时不需要我了。"
        },
        {
          "role": "莱欧斯利",
          "text": "你想在这里等也可以哦？沫芒宫的茶不错。"
        },
        {
          "role": "基尼奇",
          "text": "不必了，出门前把很吵闹的玩意儿丢给了熟人，得回去给它喂食。"
        },
        {
          "role": "莱欧斯利",
          "text": "啊，原来基尼奇先生还养了宠物。"
        },
        {
          "role": "莱欧斯利",
          "text": "说到宠物…"
        },
        {
          "role": "咔库库",
          "text": "不对！不对！"
        },
        {
          "role": "莱欧斯利",
          "text": "好，好，不对。"
        },
        {
          "role": "那维莱特",
          "text": "莱欧斯利应该是想说，咔库库先生可以离开了。"
        },
        {
          "role": "那维莱特",
          "text": "而且经判定，咔库库先生已经被排除在飞行物范围之外，以后可以随时在枫丹自由行动了。"
        },
        {
          "role": "咔库库",
          "text": "还是你最好，哥们！"
        },
        {
          "role": "派蒙",
          "text": "哦！这确实是个好消息呢！旅行者，我们把咔库库带回给伊法和欧洛伦吧？"
        },
        {
          "role": "那维莱特",
          "text": "那就拜托二位了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不客气。",
              "dialogues": []
            },
            {
              "text": "有空常联系。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "那维莱特",
          "text": "嗯。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（那维莱特&莱欧斯利）"
        },
        {
          "role": "莱欧斯利",
          "text": "啊，果然还是很想养只宠物。"
        },
        {
          "role": "那维莱特",
          "text": "如果在梅洛彼得堡不方便，不如在枫丹廷找个住处吧。"
        },
        {
          "role": "莱欧斯利",
          "text": "…有道理啊。"
        },
        {
          "role": "莱欧斯利",
          "text": "之前有洪水的预言，感觉在城里购置房产也没什么意义，就搁置了。"
        },
        {
          "role": "那维莱特",
          "text": "你也应该认真读下我给你的有关爵位的文件了吧。"
        },
        {
          "role": "莱欧斯利",
          "text": "啊？"
        },
        {
          "role": "那维莱特",
          "text": "拥有荣誉称号的市民，在枫丹廷购置房产是有优惠政策的。"
        },
        {
          "role": "莱欧斯利",
          "text": "真的？"
        },
        {
          "role": "那维莱特",
          "text": "不如就在我写失物招领的时候，从头到尾读一遍吧。"
        },
        {
          "type": "subtitle",
          "text": "去找欧洛伦和伊法"
        },
        {
          "role": "欧洛伦",
          "text": "阿乔。"
        },
        {
          "role": "阿乔",
          "text": "又、又怎么了？"
        },
        {
          "role": "欧洛伦",
          "text": "握手。"
        },
        {
          "role": "阿乔",
          "text": "没问题。看我给你一拳！"
        },
        {
          "role": "欧洛伦",
          "text": "！"
        },
        {
          "role": "伊法",
          "text": "哦！好闪！"
        },
        {
          "role": "派蒙",
          "text": "呃…不知为何，有点不想靠近他们…"
        },
        {
          "role": "咔库库",
          "text": "哥们，想我了？"
        },
        {
          "role": "伊法",
          "text": "咔库库！你自由了！"
        },
        {
          "role": "阿乔",
          "text": "啊！怎么是你！不想，我完全不想你！"
        },
        {
          "role": "欧洛伦",
          "text": "原来是旅行者奶奶。"
        },
        {
          "role": "欧洛伦",
          "text": "还有派蒙、基尼奇。各位好，谢谢你们把咔库库带了回来。"
        },
        {
          "role": "阿乔",
          "text": "快拿走，快拿走！"
        },
        {
          "role": "咔库库",
          "text": "幸会，哥们！"
        },
        {
          "role": "阿乔",
          "text": "你再说一遍！谁是你哥们！"
        },
        {
          "role": "基尼奇",
          "text": "有力气吵架，看来还不饿。"
        },
        {
          "role": "基尼奇",
          "text": "旅行者，等下我们去吃饭吧，让阿乔过自己的生活。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我觉得好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伊法",
          "text": "哈哈，可怜的阿乔！被欧洛伦折磨了半天，结果发现苦难才刚刚开始。"
        },
        {
          "role": "欧洛伦",
          "text": "伊法，身为龙的医生，你怎么能这样幸灾乐祸。"
        },
        {
          "role": "伊法",
          "text": "？你倒是说起我来了？"
        },
        {
          "role": "咔库库",
          "text": "听听你说的话！"
        },
        {
          "role": "派蒙",
          "text": "呃，就没有人关心咔库库是怎么「出狱」的吗…"
        },
        {
          "type": "subtitle",
          "text": "在嘈杂声中，简单和伊法、欧洛伦说明了咔库库的情况。\n听到咔库库以后都可以自由行动，阿乔更红了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "欧洛伦",
          "text": "别泄气，阿乔。"
        },
        {
          "role": "欧洛伦",
          "text": "按照同等标准，你今后也可以随意行动了。你没有输。"
        },
        {
          "role": "阿乔",
          "text": "谁要和它是同等标准啊！"
        },
        {
          "role": "基尼奇",
          "text": "是啊，以我对沫芒宫工作习惯的了解，阿乔必须得亲自经过判定，才能获得自由行动的权利。"
        },
        {
          "role": "咔库库",
          "text": "哈哈！"
        },
        {
          "role": "阿乔",
          "text": "可恶…哪里有龙肉餐厅来着？我一定亲自送这粉色气球进厨房…"
        },
        {
          "role": "伊法",
          "text": "那你也自身难保啊，哥们。"
        },
        {
          "role": "派蒙",
          "text": "没有这种餐厅啦。"
        },
        {
          "role": "基尼奇",
          "text": "总之，谢谢二位帮我照看阿乔。接下来就由我接手了。"
        },
        {
          "role": "阿乔",
          "text": "你…！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们运送咔库库的任务完成了。",
              "dialogues": []
            },
            {
              "text": "交换龙的任务完成了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "二选一的话，那我觉得还是咔库库可爱多了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还挑上了。",
              "dialogues": []
            },
            {
              "text": "那我觉得还是派蒙可爱多了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，真的吗？谢谢你哦！"
        },
        {
          "role": "派蒙",
          "text": "不对…你这是在拿我跟什么比啊！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（欧洛伦&伊法&咔库库）"
        },
        {
          "role": "欧洛伦",
          "text": "人终于又齐了。接下来有什么打算吗？"
        },
        {
          "role": "欧洛伦",
          "text": "要不还是猜拳…"
        },
        {
          "role": "伊法",
          "text": "别！如果我输了，我们又要憋在房间里继续看映影了…"
        },
        {
          "role": "欧洛伦",
          "text": "不，这次换我输了才看映影。"
        },
        {
          "role": "伊法",
          "text": "你也看腻了是吧。"
        },
        {
          "role": "咔库库",
          "text": "真的假的？哥们。"
        },
        {
          "role": "伊法",
          "text": "说真的，我们就不能放弃概率事件，将命运掌握在自己手中吗？"
        },
        {
          "role": "欧洛伦",
          "text": "可猜拳不就是用手的…"
        },
        {
          "role": "咔库库",
          "text": "哈哈！"
        },
        {
          "role": "伊法",
          "text": "…笑什么，只能出布的家伙！"
        },
        {
          "type": "subtitle",
          "text": "等待到第二天上午（8点-10点）"
        },
        {
          "type": "subtitle",
          "text": "前往沫芒宫"
        },
        {
          "role": "派蒙",
          "text": "失物招领已经发布了哦！"
        },
        {
          "role": "派蒙",
          "text": "我们要不要去沫芒宫那蹲守，看会不会有人来认领呀？"
        },
        {
          "type": "subtitle",
          "text": "沫芒宫公告板"
        },
        {
          "role": "失物招领",
          "text": "「近日沫芒宫失物招领处接收数件物品如下。」"
        },
        {
          "role": "失物招领",
          "text": "「一、枫丹廷利奥奈区捡到灰色手包一枚，内有工作证、合同文件，以及摩拉若干。」"
        },
        {
          "role": "失物招领",
          "text": "「二、『娜维娅线』巡轨船上发现留影机一个，虹彩蔷薇一束。很遗憾虹彩蔷薇已有枯萎迹象，希望失主尽快察觉，及时认领。」"
        },
        {
          "role": "失物招领",
          "text": "「三、茉洁站附近沙滩拾取上锁手提箱一只，箱体沉重，外部绘有纳塔纹样。」"
        },
        {
          "role": "失物招领",
          "text": "「四、新枫丹科学院办公处发现无主鸟笼一个，内含松鼠一只。松鼠生命体征良好，但心情不佳…」"
        },
        {
          "role": "失物招领",
          "text": "「…出于健康考虑已将其从笼中释出。衷心建议失主领回后可对松鼠的生活环境再加考虑。」"
        },
        {
          "role": "失物招领",
          "text": "「请上述物品失主本人携带有效证明，联系沫芒宫工作人员领取。」"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，看来和我们有同样想法的人不止一个呢。"
        },
        {
          "role": "那维莱特",
          "text": "二位好。"
        },
        {
          "role": "派蒙",
          "text": "有什么进展吗？"
        },
        {
          "role": "派蒙",
          "text": "看样子…没有呢…"
        },
        {
          "role": "派蒙",
          "text": "也是哦，失物招领才发出不久，想也不会这么快就…"
        },
        {
          "role": "？？？",
          "text": "特巡队，开门！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！谁啊！什么东西！"
        },
        {
          "role": "派蒙",
          "text": "特、特巡队！"
        },
        {
          "role": "莱欧斯利",
          "text": "我看不是哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有人在敲门。",
              "dialogues": []
            },
            {
              "text": "是特巡队！好可怕！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不是开玩笑的时候吧！我们还是过去看看…"
        },
        {
          "type": "subtitle",
          "text": "沫芒宫的警卫小心地打开了门，一个熟悉的人走了进来…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "欧洛伦",
          "text": "各位爷爷奶奶，叔叔阿姨们好。"
        },
        {
          "role": "派蒙",
          "text": "怎么是欧洛伦呀！"
        },
        {
          "role": "莱欧斯利",
          "text": "哦，是你们提过的咔库库的主人吗？"
        },
        {
          "role": "派蒙",
          "text": "算是主人之一吧…"
        },
        {
          "role": "派蒙",
          "text": "不过哥们，你到底在干嘛啦？"
        },
        {
          "role": "欧洛伦",
          "text": "我来认领失物。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "平静地提出了诉求呢…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "那维莱特",
          "text": "这位…是基尼奇先生在船上见过的人吗？"
        },
        {
          "role": "莱欧斯利",
          "text": "应该不是吧…"
        },
        {
          "role": "莱欧斯利",
          "text": "在叫爷爷奶奶叔叔阿姨呢。如果是中年人，那保养得还挺好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抱歉，家孙失礼了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "欧洛伦",
          "text": "欸？是我敲门的礼仪不到位吗？我看映影里都是这样的。"
        },
        {
          "role": "派蒙",
          "text": "不不，那是特巡队在执行公务吧，完全是两码事。"
        },
        {
          "role": "欧洛伦",
          "text": "啊，是这样吗…我还以为是某种礼貌地请求进门的方式呢，以此说明自己有要事相求。"
        },
        {
          "role": "欧洛伦",
          "text": "看来是我理解错了，抱歉。请大家等我一下，我再进一次门…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用，不用…",
              "dialogues": []
            },
            {
              "text": "还是说正事吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基尼奇",
          "text": "咳…欧洛伦，你说你是来认领失物的？你丢了什么东西吗？"
        },
        {
          "role": "欧洛伦",
          "text": "对，是这样的…"
        },
        {
          "type": "subtitle",
          "text": "欧洛伦认真描述了想要认领的「失物」的样子…从箱子的外表到枪的样式，竟然都对上了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "真的假的，哥们…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要忍痛割爱逮捕乖孙了吗…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欧洛伦，你…你说实话，这真的是你丢的东西吗？"
        },
        {
          "role": "欧洛伦",
          "text": "不，是朋友的。"
        },
        {
          "role": "派蒙",
          "text": "啊？是…是伊法的？"
        },
        {
          "role": "欧洛伦",
          "text": "当然不是，伊法有自己的枪。"
        },
        {
          "role": "派蒙",
          "text": "呃…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "欧洛伦，快老实交代。",
              "dialogues": []
            },
            {
              "text": "不然真的要逮捕你了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "欧洛伦",
          "text": "好吧…我就说不会这么顺利的。"
        },
        {
          "role": "欧洛伦",
          "text": "是这样，今天早上，我和伊法猜拳，他和往常一样输得很快，于是我们决定出门逛街，游览枫丹廷的著名景点。"
        },
        {
          "role": "欧洛伦",
          "text": "就在广场附近，突然有位先生拦住我们，求我们帮忙。"
        },
        {
          "role": "欧洛伦",
          "text": "他说他有样东西丢了，被人捡到送进了沫芒宫。"
        },
        {
          "role": "欧洛伦",
          "text": "但他以前在这里工作过，怕见到老同事尴尬，所以拜托我们假装失主，帮他认领。"
        },
        {
          "role": "派蒙",
          "text": "你倒是全给他说出来了…"
        },
        {
          "role": "欧洛伦",
          "text": "没关系，反正我不尴尬。"
        },
        {
          "role": "莱欧斯利",
          "text": "在沫芒宫工作过…这个拜托你的人是枫丹人吗？"
        },
        {
          "role": "欧洛伦",
          "text": "嗯，看着是位穿着讲究的先生。"
        },
        {
          "role": "欧洛伦",
          "text": "我们本来想拒绝的，但他实在很有礼貌…"
        },
        {
          "role": "基尼奇",
          "text": "难道是变装？"
        },
        {
          "role": "派蒙",
          "text": "完蛋…欧洛伦，我觉得你被骗了，这个人可能是坏蛋的同伙…"
        },
        {
          "role": "派蒙",
          "text": "搞不好在你任务失败的时候，他已经丢下你逃之夭夭了！"
        },
        {
          "role": "欧洛伦",
          "text": "不会的，我又不傻。"
        },
        {
          "role": "派蒙",
          "text": "啊？"
        },
        {
          "role": "欧洛伦",
          "text": "他不会跑的，伊法和咔库库正在广场看守他呢。"
        },
        {
          "role": "莱欧斯利",
          "text": "「看守」，我喜欢这个。"
        },
        {
          "role": "派蒙",
          "text": "既然如此，那我们赶快去找伊法吧！"
        },
        {
          "role": "派蒙",
          "text": "把那个骗人的家伙抓过来，看看究竟是怎么回事。"
        },
        {
          "role": "莱欧斯利",
          "text": "稍等，我想先问个问题。"
        },
        {
          "role": "莱欧斯利",
          "text": "旅行者，派蒙，你们在纳塔很有名吧？"
        },
        {
          "role": "派蒙",
          "text": "那可太有名了！不过，为什么这样问？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不仅是我和派蒙…",
              "dialogues": []
            },
            {
              "text": "基尼奇、欧洛伦、伊法也都…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱欧斯利",
          "text": "哈…"
        },
        {
          "role": "基尼奇",
          "text": "你是担心…？"
        },
        {
          "role": "莱欧斯利",
          "text": "还记得我说过，卖家可能会暗中监视吗？"
        },
        {
          "role": "那维莱特",
          "text": "那他们哄骗欧洛伦的行为就有些打草惊蛇了。"
        },
        {
          "role": "莱欧斯利",
          "text": "说明叫欧洛伦来领东西的人，或许也不了解情况。"
        },
        {
          "role": "莱欧斯利",
          "text": "…还有许多疑问，但在这里空想也不是办法。"
        },
        {
          "role": "莱欧斯利",
          "text": "不过我还是建议，各位名人，也就是旅行者和基尼奇，哦还有那维莱特先生，都先留在此地。"
        },
        {
          "role": "莱欧斯利",
          "text": "我们将空箱子交给欧洛伦，让他假装取到了东西回去。"
        },
        {
          "role": "莱欧斯利",
          "text": "而我会跟过去，看看是不是真的有人在一旁监视。"
        },
        {
          "role": "莱欧斯利",
          "text": "反正没什么人知道我究竟是做什么的，应该不会引起注意。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "低调有低调的好处呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "那维莱特",
          "text": "我认为这个方案值得一试。那就拜托二位了。"
        },
        {
          "role": "欧洛伦",
          "text": "所以我需要再伪装一次，对吗？"
        },
        {
          "role": "莱欧斯利",
          "text": "嗯…也不算伪装吧，去掉特巡队的部分，做你自己就好了。"
        },
        {
          "role": "欧洛伦",
          "text": "好，我明白了。"
        },
        {
          "type": "subtitle",
          "text": "按计划前往广场"
        },
        {
          "type": "subtitle",
          "text": "切换到莱欧斯利主视角",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "莱欧斯利",
          "text": "（附近没有可疑的人…）"
        },
        {
          "role": "莱欧斯利",
          "text": "（欧洛伦已经按计划进入升降梯，我也前往广场吧。）"
        },
        {
          "type": "subtitle",
          "text": "靠近升降机"
        },
        {
          "role": "莱欧斯利",
          "text": "（欧洛伦正在搭乘升降梯。走其他路前往广场吧。）"
        },
        {
          "type": "subtitle",
          "text": "呼叫升降机"
        },
        {
          "type": "subtitle",
          "text": "（欧洛伦正在使用升降梯，还是别和他抢了。）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "远离任务区域"
        },
        {
          "role": "莱欧斯利",
          "text": "（欧洛伦说的方向不是这边。我已经到记不清路的年纪了吗？）"
        },
        {
          "role": "莱欧斯利",
          "text": "（这附近也没有可疑情况…）"
        },
        {
          "role": "莱欧斯利",
          "text": "（奇怪…难道是我们把事情想复杂了？）"
        },
        {
          "role": "咔库库",
          "text": "哎呀！哎呀！"
        },
        {
          "role": "阿让托",
          "text": "别啄了…别啄了！"
        },
        {
          "role": "阿让托",
          "text": "求求你，这位好先生！能不能行行好，管管你家宠物！"
        },
        {
          "role": "咔库库",
          "text": "你在胡说什么！"
        },
        {
          "role": "伊法",
          "text": "抱歉啊，这不是我家宠物，是我的同事。"
        },
        {
          "role": "伊法",
          "text": "它不喜欢你的说法，现在不高兴了，你自求多福吧。"
        },
        {
          "role": "阿让托",
          "text": "不是吧！在纳塔什么东西都能上班的吗？"
        },
        {
          "role": "欧洛伦",
          "text": "糟糕，咔库库也不喜欢被叫作东西…你自求多福吧。"
        },
        {
          "role": "阿让托",
          "text": "抱歉，抱歉，咔库库先生！咔库库老师！咔库库大师！向您诚挚道歉！"
        },
        {
          "role": "欧洛伦",
          "text": "可以了咔库库，先让我问他点事。"
        },
        {
          "role": "咔库库",
          "text": "没问题哥们！"
        },
        {
          "role": "莱欧斯利",
          "text": "（这会儿欧洛伦看着倒挺正经的。之前是在装傻吗？）"
        },
        {
          "role": "莱欧斯利",
          "text": "（挺好玩的，再看一会儿。）"
        },
        {
          "role": "伊法",
          "text": "你竟然拿到了，还以为不会那么顺利呢。"
        },
        {
          "role": "阿让托",
          "text": "啊，果然叫你们去拿这个东西是正确的选择！"
        },
        {
          "role": "伊法",
          "text": "果然？"
        },
        {
          "role": "阿让托",
          "text": "呃…我是说，因为我的前同事们都不认识你们嘛，哈哈…"
        },
        {
          "role": "欧洛伦",
          "text": "取是取到了，但没说一定会给你。"
        },
        {
          "role": "阿让托",
          "text": "啊？"
        },
        {
          "role": "欧洛伦",
          "text": "这个东西很不错，我看上了。"
        },
        {
          "role": "伊法",
          "text": "……"
        },
        {
          "role": "莱欧斯利",
          "text": "（？）"
        },
        {
          "role": "阿让托",
          "text": "别啊，这位先生！老师！大师！这可是与我性命攸关的东西…"
        },
        {
          "role": "莱欧斯利",
          "text": "（性命攸关？）"
        },
        {
          "role": "欧洛伦",
          "text": "既然是如此珍贵的宝物，你准备用什么来换？"
        },
        {
          "role": "伊法",
          "text": "你不会要说「生命」吧？"
        },
        {
          "role": "欧洛伦",
          "text": "你怎么知道？"
        },
        {
          "role": "伊法",
          "text": "我们可是一起看的映影！"
        },
        {
          "role": "伊法",
          "text": "不要一直背诵台词了，会引起误会的。"
        },
        {
          "role": "欧洛伦",
          "text": "…你说得对，但我也确实不知道该说什么了。"
        },
        {
          "role": "欧洛伦",
          "text": "抱歉，顶多只能做这么多自己了。够吗？"
        },
        {
          "role": "莱欧斯利",
          "text": "够了，足够了。"
        },
        {
          "role": "伊法",
          "text": "呃，这位是…"
        },
        {
          "role": "莱欧斯利",
          "text": "就当我是沫芒宫的工作人员吧。"
        },
        {
          "role": "莱欧斯利",
          "text": "关于你们说的这件性命攸关的宝物，我有些事情要和这位先生谈谈，望你如实告知。"
        },
        {
          "role": "阿让托",
          "text": "完了，完了…我死定了…"
        },
        {
          "role": "莱欧斯利",
          "text": "这是什么话。难道在怀疑沫芒宫保护枫丹人民安全的能力吗？"
        },
        {
          "role": "阿让托",
          "text": "不敢，不敢！您…您问吧…"
        },
        {
          "role": "莱欧斯利",
          "text": "与其我来问，不如你自己从头讲吧。"
        },
        {
          "role": "阿让托",
          "text": "唉…说到底，还是怪我自己定力不足，禁不起这种稀有古物的诱惑。"
        },
        {
          "role": "阿让托",
          "text": "我是一个古董爱好者，最喜欢收集罕见的旧物。说实话，只要能用钱搞定，我…不太在意东西的来源…"
        },
        {
          "role": "阿让托",
          "text": "这次卖我东西的人，我…没见过他本人。"
        },
        {
          "role": "阿让托",
          "text": "之前交易过几回，但都是靠在不入流小报上刊登寻物或寻人启事接头的。"
        },
        {
          "role": "阿让托",
          "text": "只要在行文里藏好交货和交钱的时间地点，再在信封里塞点钱投稿就能上报纸，不会留下多余的痕迹，很简单吧？"
        },
        {
          "role": "阿让托",
          "text": "往常都很顺利的，谁知道这次我到了提货的地方，却看到一群人在盖房子！"
        },
        {
          "role": "阿让托",
          "text": "和说好的完全不一样，我又不甘心就这样放弃，于是按照以往的方式再次联系了他。"
        },
        {
          "role": "阿让托",
          "text": "结果你猜他怎么说？他说我想要的东西在沫芒宫！"
        },
        {
          "role": "莱欧斯利",
          "text": "倒也没有骗你。"
        },
        {
          "role": "阿让托",
          "text": "他说他不方便出面，但只要我能有本事把东西从沫芒宫里拿走，这次的货款就给我打个折扣…"
        },
        {
          "role": "阿让托",
          "text": "当然，我不是因为贪这点钱才答应的，我像是缺钱的人吗！"
        },
        {
          "role": "伊法",
          "text": "你还得意上了？"
        },
        {
          "role": "咔库库",
          "text": "你还得意上了？"
        },
        {
          "role": "阿让托",
          "text": "不敢，不敢…您您您嘴下留情…"
        },
        {
          "role": "莱欧斯利",
          "text": "继续。"
        },
        {
          "role": "阿让托",
          "text": "啊，说到哪了来着…反正，我就想，既然是纳塔来的东西，那找个纳塔人去拿，应该会更合理吧？"
        },
        {
          "role": "阿让托",
          "text": "好巧不巧，正好撞见这两位年轻人在闲逛，我就…"
        },
        {
          "role": "阿让托",
          "text": "唉，对不起，是我有眼无珠，小看二位了！"
        },
        {
          "role": "莱欧斯利",
          "text": "那个卖你东西的人，他叫你自己想办法去沫芒宫拿东西，就不怕你拿完不给钱吗？"
        },
        {
          "role": "阿让托",
          "text": "这个…这个…实不相瞒，虽然我不了解他，但他似乎是知道我叫什么、家住哪里的…"
        },
        {
          "role": "阿让托",
          "text": "而且，能从纳塔搞到武器的人，应该不简单吧…"
        },
        {
          "role": "莱欧斯利",
          "text": "好吧，我明白了。"
        },
        {
          "role": "莱欧斯利",
          "text": "那么这位…"
        },
        {
          "role": "阿让托",
          "text": "啊…啊，叫我阿让托就好。"
        },
        {
          "role": "莱欧斯利",
          "text": "那么阿让托先生，接下来我说的话，希望你认真听，因为这事关你接下来的半辈子将有多长时间是在水下度过的。"
        },
        {
          "role": "欧洛伦",
          "text": "什么意思？要淹死他吗，像映影里的那些黑帮一样？"
        },
        {
          "role": "欧洛伦",
          "text": "哦，我知道了！是枫丹海底下的那个…"
        },
        {
          "role": "伊法",
          "text": "嘘！"
        },
        {
          "role": "莱欧斯利",
          "text": "因为涉嫌私自交易纳塔文物，你已经成为了跨国走私案的嫌疑人之一。"
        },
        {
          "role": "莱欧斯利",
          "text": "去一趟欧庇克莱歌剧院应当是无可避免了，但好消息是，你还有一次弥补的机会。"
        },
        {
          "role": "阿让托",
          "text": "我…我可以吗？您请说。"
        },
        {
          "role": "莱欧斯利",
          "text": "很简单，按照你们一贯的礼节，联系你的卖家，提上钱去和他交易。只不过时间、地点等一切交易的细节，都要先告知我。"
        },
        {
          "role": "莱欧斯利",
          "text": "如果能借此抓到对方，你也算是戴罪立功了，懂吗？"
        },
        {
          "role": "阿让托",
          "text": "哦…哦！我、我明白了！我一定配合！"
        },
        {
          "role": "莱欧斯利",
          "text": "嗯。不要违法，不要逃跑，沫芒宫的人会盯住你，保障你的安全。"
        },
        {
          "role": "莱欧斯利",
          "text": "好，箱子拿走，身份证件什么的都留一下，你可以走了。"
        },
        {
          "role": "莱欧斯利",
          "text": "至于你们二位…"
        },
        {
          "role": "莱欧斯利",
          "text": "唉，按照正规流程，应当要把你俩带回沫芒宫，按住签署保密协议…但这一来二去又要花费好多功夫。"
        },
        {
          "role": "咔库库",
          "text": "很烦，哥们！"
        },
        {
          "role": "莱欧斯利",
          "text": "你看，咔库库先生深有体会。"
        },
        {
          "role": "莱欧斯利",
          "text": "所以我想，既然你们都是旅行者的朋友…"
        },
        {
          "role": "伊法",
          "text": "我明白，先生。我们是无意中被牵扯进来，这起事件本就与我们无关。"
        },
        {
          "role": "伊法",
          "text": "哪怕看在旅行者的面子上，我们也不会多说半个字。"
        },
        {
          "role": "欧洛伦",
          "text": "哦，是那个吗？如果不守口如瓶，就会被装进水泥桶里丢进大海。"
        },
        {
          "role": "欧洛伦",
          "text": "那我明白了，我加入。"
        },
        {
          "role": "莱欧斯利",
          "text": "…不完全一样，但你这么理解也没什么问题。"
        },
        {
          "role": "莱欧斯利",
          "text": "嗯，那就这样，多谢二位协助。"
        },
        {
          "role": "莱欧斯利",
          "text": "（可算结束了，今天的工作就做到这里…好，回去吧！）"
        },
        {
          "role": "派蒙",
          "text": "啊，莱欧斯利回来了！"
        },
        {
          "role": "派蒙",
          "text": "看你的表情，应该是好消息吧？"
        },
        {
          "role": "莱欧斯利",
          "text": "还算顺利。"
        },
        {
          "type": "subtitle",
          "text": "听莱欧斯利讲述了事情经过。\n情况十分明了，但总觉得莱欧斯利简化了很多「哥们」的部分…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "基尼奇",
          "text": "也就是说，接下来我们要等阿让托和对方约好进一步的交易计划，再安排后续行动。"
        },
        {
          "role": "莱欧斯利",
          "text": "要有耐心哦。"
        },
        {
          "role": "基尼奇",
          "text": "这个我明白，狩猎也是类似的原理。我只是有些担心，对方会不会轻易上钩。"
        },
        {
          "role": "莱欧斯利",
          "text": "呵呵，如果他不需要这笔钱，或者说，自保的优先级高于赚钱，那他在赃物进入沫芒宫的时候就可以放弃了。"
        },
        {
          "role": "莱欧斯利",
          "text": "与此同时，虽然他一直没有亲自出面，但他似乎也没有什么随从或者帮手，只能靠极其有限的手段推动交易。"
        },
        {
          "role": "莱欧斯利",
          "text": "在我看来，是个很好面子，略显自负，却能力不足的人。似乎错过这次机会，他就没有其他赚钱的办法了。"
        },
        {
          "role": "莱欧斯利",
          "text": "他的每一步行动都像是在被轮盘推着走，寄希望于骰子能落在他想要的格子里。"
        },
        {
          "role": "基尼奇",
          "text": "……"
        },
        {
          "role": "莱欧斯利",
          "text": "嗐，谁知道呢。"
        },
        {
          "role": "莱欧斯利",
          "text": "没准接下来他会在权衡利弊后直接消失，让我们白费力气呢。"
        },
        {
          "role": "莱欧斯利",
          "text": "至少纳塔追回了赃物，也不算一场空吧。"
        },
        {
          "role": "基尼奇",
          "text": "那还是希望他更自负一点吧。"
        },
        {
          "role": "那维莱特",
          "text": "各位，我刚刚已经和逐影庭的人说明了情况。一旦有新的进展，我们会马上做出行动。"
        },
        {
          "role": "那维莱特",
          "text": "到时候，还是要麻烦各位了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我们吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "那维莱特",
          "text": "等你的好消息哦！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（莱欧斯利&那维莱特）"
        },
        {
          "role": "莱欧斯利",
          "text": "说到绑架案…"
        },
        {
          "role": "那维莱特",
          "text": "嗯？"
        },
        {
          "role": "莱欧斯利",
          "text": "按照规定，我们对被绑架的主体是如何定义的来着？"
        },
        {
          "role": "莱欧斯利",
          "text": "除了人类以外，宠物算吗？非人类的智慧生物算吗？"
        },
        {
          "role": "莱欧斯利",
          "text": "嗯…美露莘就不用说了，但咔库库那种该怎么界定？"
        },
        {
          "role": "那维莱特",
          "text": "没想到你会不了解这方面的法律条款。"
        },
        {
          "role": "莱欧斯利",
          "text": "哈哈，我如果对每一条法律都了若指掌，就不会在梅洛彼得堡生活了。"
        },
        {
          "role": "那维莱特",
          "text": "…这个玩笑不好笑，莱欧斯利。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（基尼奇&阿乔）"
        },
        {
          "role": "阿乔",
          "text": "……"
        },
        {
          "role": "基尼奇",
          "text": "……"
        },
        {
          "role": "阿乔",
          "text": "……"
        },
        {
          "role": "基尼奇",
          "text": "想说什么就说吧，何苦如此矜持。"
        },
        {
          "role": "阿乔",
          "text": "啊哈哈！笨蛋基尼奇，上当了吧？上当了吧？"
        },
        {
          "role": "阿乔",
          "text": "怎么，本圣龙不说话的时候，你反而寂寞了？"
        },
        {
          "role": "阿乔",
          "text": "想听童话故事就直说嘛，我一定给你讲个最惊悚最吓人的，让你三个晚上睡不着觉！"
        },
        {
          "role": "基尼奇",
          "text": "可以啊。"
        },
        {
          "role": "阿乔",
          "text": "啊？答应得这么轻巧，不会是在逞强吧？"
        },
        {
          "role": "基尼奇",
          "text": "也许吧。只不过，我不睡，你也别想休息。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（欧洛伦&伊法&咔库库）"
        },
        {
          "role": "欧洛伦",
          "text": "♪~"
        },
        {
          "role": "伊法",
          "text": "心情不错？"
        },
        {
          "role": "欧洛伦",
          "text": "嗯！看到心爱的蔬菜们都有了各自的归宿，我感到十分欣慰。"
        },
        {
          "role": "伊法",
          "text": "你现在说话好像一位自豪的家长，我为你感到高兴。"
        },
        {
          "role": "伊法",
          "text": "但因为蔬菜的归宿是在锅里，我同时又感到有些害怕。"
        },
        {
          "role": "咔库库",
          "text": "幸会，哥们！"
        },
        {
          "role": "伊法",
          "text": "什么意思？现在是该说「幸会」的时候吗？"
        },
        {
          "role": "欧洛伦",
          "text": "我猜，咔库库应该是在指蔬菜与锅的「幸会」吧。"
        },
        {
          "role": "咔库库",
          "text": "说得好，哥们！"
        },
        {
          "role": "伊法",
          "text": "……"
        },
        {
          "role": "伊法",
          "text": "说实话，我不知道是该担心你们对幸运的定义，还是应该好奇你和咔库库是否心有灵犀。"
        }
      ],
