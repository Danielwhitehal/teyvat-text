{
  "quest_id": 22022,
  "chapter_num": null,
  "chapter_title": "全能美食队·美食小问答",
  "type": "iq",
  "route": "The Gourmet Supremos: Foodie Quiz",
  "stories": [
    {
      "story_id": 22022,
      "title": "全能美食队·美食小问答",
      "description": "全能美食队的芭尔瓦涅似乎正因为某事而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与芭尔瓦涅对话"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这个食谱的搭配应该是这样才对…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么呢？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我正在整理食谱呢，呃…但有些食谱还是记不太清…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "直接问旭东就好了。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "旭东…我之所以记不清那些食谱，大部分原因就是他成天折腾的那些「创意食物」。"
                }
              ]
            },
            {
              "text": "你们不是「全能美食队」吗？",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "拜托你不要再重复这个名字了，我的论文里绝对不会出现这五个字…"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "再说了，我之所以记不清那些食谱，大部分原因也就是旭东成天折腾的那些「创意食物」。"
                }
              ]
            }
          ]
        },
        {
          "role": "芭尔瓦涅",
          "text": "每次他拿到新食谱之后，顶多只会按照那些食谱记录的方法做一两天。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "然后，他就会开始…用各种方法「改造」那些食谱。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他为什么要这么做？",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "据他说，是为了让那些菜的成本变便宜什么的…但我是不太清楚他为什么这么做…"
                }
              ]
            },
            {
              "text": "他具体怎么改造的？",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "嗯…他的改造方法还不同于其他厨师，其他厨师改造食谱，大多是让食谱变得更加丰富，让做出来的菜能卖更多钱。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "但旭东改造那些食谱的时候，却似乎有着另一种完全不同的改造原则…"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "比如他用土豆…蘑菇…还有另外一些廉价的蔬菜食材做了一道素菜，但是吃的时候，却是香嫩椒椒鸡的味道…"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "还有用土豆、稻米、莲蓬、绝云椒椒、面团和兽肉做的简易版「仙跳墙」，口感和味道居然都和原版差不多…"
                }
              ]
            }
          ]
        },
        {
          "role": "芭尔瓦涅",
          "text": "但不管怎么说，从结果上来看，他也确实把那些菜改造成功了。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "味道和原版的菜大致相同，但制作成本却低得离谱。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我之所以会愿意和他同行，也是因为他这种离谱的烹饪手法。而他之所以愿意接纳我，应该也是看中了我的技术。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以，你想让我帮什么忙？",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "啊…喔！对，光顾着说旭东的事了，差点忘了正事…"
                }
              ]
            },
            {
              "text": "你的技术？",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "我之前没和你说过吗？我在教令院的研究课题是「万能调料」。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "简单来说，就是一种只要加入菜里，无论什么菜都能变得美味的超级调料。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "为了研究出这种调料，我才外出游学搜集各种美食的资料。"
                },
                {
                  "role": "芭尔瓦涅",
                  "text": "咳，说远了，我们还是接着说食谱的事…"
                }
              ]
            }
          ]
        },
        {
          "role": "芭尔瓦涅",
          "text": "因为旭东成天都在拉着我改造那些食谱，还直接在那些食谱上写写画画…有些食谱的配方都乱了。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "为了能有个正经的对照物，我还是想要把那些食谱准确地复原出来，然后存档一份。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "旅行者，如果你记得那些食谱的话，能帮我回忆一下吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "我是吃遍提瓦特的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芭尔瓦涅",
          "text": "那就拜托你了，我先把那些乱掉的食谱整理一下，你稍微帮我修正一下不清楚的地方就好…"
        },
        {
          "type": "subtitle",
          "text": "与芭尔瓦涅对话"
        },
        {
          "role": "芭尔瓦涅",
          "text": "蒙德有一道「北地苹果焖肉」，旭东这家伙又在乱写…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "「黄油略贵，兽肉难储，不如揉和面团，洗出面筋，再将面筋入屉蒸熟，佐以蔬果调料，入口亦有肉感。」"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这家伙，黄油有什么贵的，兽肉直接去买新鲜的不就好了？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "算了…旅行者，我想问你的是，这道「北地苹果焖肉」的原料，除了苹果、黄油和兽肉之外，还有一道材料是？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "杏仁。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "唔…是这样吗？我先记一下…"
                }
              ]
            },
            {
              "text": "胡椒。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "唔…是这样吗？我先记一下…"
                }
              ]
            },
            {
              "text": "绝云椒椒。",
              "dialogues": []
            },
            {
              "text": "火腿。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芭尔瓦涅",
          "text": "嗯，谢谢你。这些食谱我就先记下了，希望旭东不要再乱改它们了"
        },
        {
          "role": "旅行者",
          "text": "他为什么要这么做？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "旭东只是和我说，他想要把这些菜变便宜点。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我是完全弄不懂他这么做的理由…但不管怎么说，他的手艺是真的不错。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "真是的…他有这手艺做些什么不好，怎么尽和这些食谱过不去呢…"
        },
        {
          "type": "subtitle",
          "text": "与芭尔瓦涅对话"
        },
        {
          "role": "芭尔瓦涅",
          "text": "璃月有一道「天枢肉」很有名气，我看看…咦，旭东果然又在乱写了…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "「可取土豆去皮蒸熟，趁热捣烂后拌以油盐，倒扣碗中，再以面粉调出厚芡汁浇上，初尝软烂如肉。」"
        },
        {
          "role": "芭尔瓦涅",
          "text": "初尝…那吃多了不还是能分辨出来吗？这也就骗骗没吃过正版「天枢肉」的人…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "算了，旅行者，我想问的是…这道「天枢肉」的原料，除了兽肉、糖和松茸外，还需要一道什么材料？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "琉璃袋。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "唔…是这样吗？我先记一下…"
                }
              ]
            },
            {
              "text": "清心。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "唔…是这样吗？我先记一下…"
                }
              ]
            },
            {
              "text": "金鱼草。",
              "dialogues": []
            },
            {
              "text": "嘟嘟莲。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芭尔瓦涅",
          "text": "嗯…总感觉这些食谱哪里不太对…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "算了，总之我先记下来吧，谢谢你，希望旭东不要再乱改它们了"
        },
        {
          "role": "旅行者",
          "text": "他为什么要这么做？"
        },
        {
          "role": "芭尔瓦涅",
          "text": "旭东只是和我说，他想要把这些菜变便宜点。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "我是完全弄不懂他这么做的理由…但不管怎么说，他的手艺是真的不错。"
        },
        {
          "role": "芭尔瓦涅",
          "text": "真是的…他有这手艺做些什么不好，怎么尽和这些食谱过不去呢…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "璃月有一道菜「腌笃鲜」，据说制作起来很是精细…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "旭东这个家伙…果然又改了…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "「金鱼草切碎，与口蘑同煮，调以盐糖，汤尝之有火腿味。」"
        },
        {
          "role": "芭尔瓦涅",
          "text": "谁要把这两个放一起煮啊！？而且就算汤有火腿味，那我也吃不到火腿啊！"
        },
        {
          "role": "芭尔瓦涅",
          "text": "算了…旅行者，我想问的是，这道「腌笃鲜」的原料，除了兽肉和火腿之外，还需要一道什么材料？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "鸟蛋。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "唔…是这样吗？我先记一下…"
                }
              ]
            },
            {
              "text": "鱼肉。",
              "dialogues": []
            },
            {
              "text": "松茸。",
              "dialogues": []
            },
            {
              "text": "竹笋。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "唔…是这样吗？我先记一下…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与芭尔瓦涅对话"
        },
        {
          "role": "芭尔瓦涅",
          "text": "稻妻有一道叫做「串串三味」的菜…自从宗久大叔教给旭东后，他就一个劲地在那琢磨…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "居然还有这么多笔记…"
        },
        {
          "role": "芭尔瓦涅",
          "text": "「串串二字实在妙极，无论何种食材，皆可串于一签之上…」"
        },
        {
          "role": "芭尔瓦涅",
          "text": "这人到底想要串什么…算了，旅行者，我想问的是，这道「串串三味」的原料，除了兽肉、面粉和金鱼草之外，还需要一道什么材料？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "鸟蛋。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "唔…是这样吗？我先记一下…"
                }
              ]
            },
            {
              "text": "番茄。",
              "dialogues": [
                {
                  "role": "芭尔瓦涅",
                  "text": "唔…是这样吗？我先记一下…"
                }
              ]
            },
            {
              "text": "牛奶。",
              "dialogues": []
            },
            {
              "text": "竹笋。",
              "dialogues": []
            }
          ]
        }
      ]
    }
  ]
}