{
  "quest_id": 10190,
  "chapter_num": "荒泷生命摇滚虹色大巡回·上",
  "chapter_title": "不是普通的虹色巡回",
  "type": "eq",
  "route": "This Ain't Your Daddy's Iridescence Tour...",
  "stories": [
    {
      "story_id": 40157,
      "title": "不是普通的虹色巡回",
      "description": "收到了一封「荒泷一斗」送出的邀请函。在这封热情满满的邀请函的介绍下，你踏上了前往海祇岛的旅途…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "查看邀请函"
        },
        {
          "type": "subtitle",
          "text": "前往海祇岛"
        },
        {
          "role": "派蒙",
          "text": "哇哦，这里就是这次活动现场吗，还有点模样呢…"
        },
        {
          "type": "subtitle",
          "text": "与一斗相聚"
        },
        {
          "role": "荒泷一斗",
          "text": "沙克兄，你放心，就算那只狗在天守阁，我们也一定帮你找到。"
        },
        {
          "role": "德沃沙克",
          "text": "一斗兄…那只是个传言而已…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么狗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "哇呀！挚友！还有派蒙！"
        },
        {
          "role": "荒泷一斗",
          "text": "你们终于来了，想死本大爷了！哈哈哈哈哈哈！"
        },
        {
          "role": "荒泷一斗",
          "text": "对了，这位是枫丹音乐家德沃沙克，沙克兄，听说你们也认识？"
        },
        {
          "role": "派蒙",
          "text": "呜哇！德沃沙克大叔，原来是你！"
        },
        {
          "role": "德沃沙克",
          "text": "呵呵，见到两位真是高兴，海灯节一别，都还顺利吗？"
        },
        {
          "role": "派蒙",
          "text": "还不错啦。你和一斗怎么碰到一起去了？难道在合作举办「虹色巡回」？"
        },
        {
          "role": "荒泷一斗",
          "text": "矮堇瓜！你说对了，但没全对。"
        },
        {
          "role": "荒泷一斗",
          "text": "这不是普通的「虹色巡回」，是我与沙克兄强强联合的「荒泷生命摇滚虹色大巡回」！"
        },
        {
          "role": "派蒙",
          "text": "什么什么荒泷摇滚…你这放牛的也懂摇滚吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "哈？难道你没听过放牛摇滚吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "哞哞哞~咚咚咚~"
        },
        {
          "role": "荒泷一斗",
          "text": "矮堇瓜啊，你也不要再浑浑噩噩下去了，去寻找自己的堇瓜摇滚吧！"
        },
        {
          "role": "派蒙",
          "text": "谁才是浑浑噩噩的那个啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那前面说的狗又是怎么回事？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "德沃沙克",
          "text": "咳咳…只是我听到的一个传言而已。据说之前，鸣神岛和海祇岛发生过一次战争，对吧？"
        },
        {
          "role": "荒泷一斗",
          "text": "战争啊战争，你不摇滚。"
        },
        {
          "role": "德沃沙克",
          "text": "确实很遗憾，还有很多小动物被波及了。乌鸦、妖狸、盗宝鼬什么的，它们都受伤了…"
        },
        {
          "role": "派蒙",
          "text": "呃…小动物很无辜…不过总觉得这不是重点吧…"
        },
        {
          "role": "荒泷一斗",
          "text": "在我们摇滚艺术家的眼里，所有生命都是重点。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那狗也受伤了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "德沃沙克",
          "text": "不，传言里的那只狗，就像一只忍犬，在战场上神出鬼没，救助了倒下的小动物们，还把它们带去了安全的避难所。"
        },
        {
          "role": "荒泷一斗",
          "text": "摇滚支援之王！我们荒泷派必须给它留把交椅。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这个传言是从哪里来的？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "德沃沙克",
          "text": "其实战争时期，我本人就在离岛，在那里听到了这个说法。"
        },
        {
          "role": "德沃沙克",
          "text": "之后我就以此为动机写了首歌，还打算举办一场主题音乐节。但可惜，后来和投资人有了分歧。"
        },
        {
          "role": "荒泷一斗",
          "text": "那件事本大爷也听过，后来据说他们遇到了海难，才取消了原定计划。但其实那是借口。"
        },
        {
          "role": "德沃沙克",
          "text": "嗯，其实是投资人认为这个主题回报率太低，而且…他们好像还在担心别的风险。"
        },
        {
          "role": "派蒙",
          "text": "什么风险？"
        },
        {
          "role": "德沃沙克",
          "text": "我也说不好啊…可能是摩拉越多就越能看见的风险？"
        },
        {
          "role": "荒泷一斗",
          "text": "本大爷也同意，摩拉越多，摇滚精神越少。"
        },
        {
          "role": "派蒙",
          "text": "摇滚精神又是什么东西…"
        },
        {
          "role": "荒泷一斗",
          "text": "就是摇摇晃晃往前滚的精神啊！"
        },
        {
          "role": "派蒙",
          "text": "…照这么说，已经滚蛋的投资人才是最摇滚的吧？"
        },
        {
          "role": "荒泷一斗",
          "text": "总而言之，那些家伙的位置，现在由本大爷来坐。"
        },
        {
          "role": "派蒙",
          "text": "少说大话了，放牛的，你有多少摩拉呀？就坐投资人的位置。"
        },
        {
          "role": "德沃沙克",
          "text": "我相信一斗兄。他说荒泷派在本地是小有名望、实力不俗的组织，还在官方那里有过备案。对吧？"
        },
        {
          "role": "派蒙",
          "text": "德沃沙克大叔，你是不是把案底听成了备案…"
        },
        {
          "role": "荒泷一斗",
          "text": "别小看荒泷派啊！现在本大爷说的话，拿去三奉行也好使！"
        },
        {
          "role": "派蒙",
          "text": "噢哟哟哟…"
        },
        {
          "role": "荒泷一斗",
          "text": "矮堇瓜，你别不信，社奉行那个无敌家政官知道吧？那个托马，他跟本大爷称兄道弟！"
        },
        {
          "role": "荒泷一斗",
          "text": "还有天领奉行那个大将，那个九条天狗，她跟本大爷交情过命！"
        },
        {
          "role": "派蒙",
          "text": "真怀疑…是过命还是要命啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那勘定奉行呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "倒是没什么熟人，但他们还要靠荒泷派的罚款创收呢！"
        },
        {
          "role": "德沃沙克",
          "text": "罚、罚款？"
        },
        {
          "role": "荒泷一斗",
          "text": "是税、税款！咳咳…"
        },
        {
          "role": "荒泷一斗",
          "text": "还有！还有三奉行之外的那些能人异士…比如…比如坊间盛传的那位牌圣绫人！"
        },
        {
          "role": "荒泷一斗",
          "text": "俗话说「南绫人，北一斗」，没错，除了本大爷，稻妻再找不出谁能跟绫人兄分庭抗礼！"
        },
        {
          "role": "派蒙",
          "text": "有这种俗话吗？！"
        },
        {
          "role": "荒泷一斗",
          "text": "还有那个幸雄拉面摊的贵宾狐狸客人，在拉面大师赛里，唯独本大爷是她堂堂劲敌。"
        },
        {
          "role": "荒泷一斗",
          "text": "还有那个天守阁里的寂寞神明啊，你们知道吗？能看一次本大爷举办的活动是她毕生所愿！"
        },
        {
          "role": "荒泷一斗",
          "text": "上次豪鼓祭典，天领奉行就是担心他们的将军大人参加之后乐不思政，所以才把本大爷请过去，招待了两天。"
        },
        {
          "role": "派蒙",
          "text": "你这家伙，几天不见…你也快成将军了，放牛将军！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "荒泷派真是太厉害了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "德沃沙克",
          "text": "咳咳…虽然我听出了一些夸张的成分，但不论如何，一斗兄确实解决了活动的场地问题，我得感谢他。"
        },
        {
          "role": "荒泷一斗",
          "text": "区区小事，不值一提！这块好场子还是靠五郎好兄弟帮忙审批，之后我们一起去感谢他吧！"
        },
        {
          "role": "派蒙",
          "text": "你还认识五郎呢！"
        },
        {
          "role": "荒泷一斗",
          "text": "那是，之前本大爷就知道他是反抗军小队的大将，但没想到他的身份远不是这么简单，他还有别的身份…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别的身份？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "是希娜小姐…"
        },
        {
          "role": "派蒙",
          "text": "希娜小姐？！你你…"
        },
        {
          "role": "荒泷一斗",
          "text": "干嘛那么大声？就是希娜小姐说的啊。"
        },
        {
          "role": "荒泷一斗",
          "text": "上次豪鼓祭典，本大爷着了天领奉行的道。所以这次决定换个他们管不着的地方，比如这儿。"
        },
        {
          "role": "荒泷一斗",
          "text": "所以就写信咨询了希娜小姐，问她知不知道在海祇岛办活动要什么手续。"
        },
        {
          "role": "荒泷一斗",
          "text": "她很快就回复我，说可以请海祇岛大将帮忙，那个大将名叫五郎。"
        },
        {
          "role": "荒泷一斗",
          "text": "原来五郎兄弟是整个海祇岛的大将啊！"
        },
        {
          "role": "派蒙",
          "text": "吓死我了…原来是这么回事…你以为大将这种身份有很多个吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "欸？不是每支小队都有一个大将吗？"
        },
        {
          "role": "派蒙",
          "text": "那个叫队长！"
        },
        {
          "role": "荒泷一斗",
          "text": "这样吗？好吧，不管怎么说，要不是希娜小姐，本大爷还被蒙在鼓里。这真是太摇滚了！哈哈哈哈哈哈！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是太摇滚了！",
              "dialogues": []
            },
            {
              "text": "哈哈哈哈哈哈！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "说到这里，挚友啊，我想起来我还约了五郎兄弟的时间，想打听一下关于那只狗的事，所以要先失陪一阵子了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "需要我们帮忙打听吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈！你们还是尽情享受庆典吧！找狗这种小事，本大爷来搞定就行。"
        },
        {
          "role": "荒泷一斗",
          "text": "距离最后的庆典晚会还有几天，虽然场地还没完全弄好，但乐曲排练区和烤堇瓜区都已经准备就绪了！"
        },
        {
          "role": "荒泷一斗",
          "text": "挚友啊，一定要玩得愉快！本大爷先走一步了！"
        },
        {
          "role": "德沃沙克",
          "text": "唉，一斗兄真是热情似火…"
        },
        {
          "role": "德沃沙克",
          "text": "旅行者，派蒙，既然这样，我先带你们去乐曲排练区看看吧。"
        },
        {
          "type": "subtitle",
          "text": "前往乐曲排练区"
        },
        {
          "role": "德沃沙克",
          "text": "就是这里了。我准备了各地的曲谱和乐器，还有个圆号是我专门从枫丹带来的，大家可以尽情演奏自己心仪的曲子。"
        },
        {
          "role": "德沃沙克",
          "text": "如果玩累了，那边是烤堇瓜区，据一斗兄说，堇瓜是一种摇滚艺术食品。怎么样？要不要试试看。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那派蒙成了飞天摇滚艺术食品。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不要随便替我代入啊！一斗应该走远了吧？给他听见可就完蛋了。"
        },
        {
          "role": "派蒙",
          "text": "德沃沙克大叔，还是赶快说说别的吧，还有什么可玩的？"
        },
        {
          "role": "德沃沙克",
          "text": "我们还计划邀请更多音乐爱好者过来，还会搜集来更多的物资，把场地打扮得更漂亮。"
        },
        {
          "role": "德沃沙克",
          "text": "但这还需要一些时间，自从我说了那只狗的事后，荒泷派的注意力一下就转移到狗身上去了…"
        },
        {
          "role": "德沃沙克",
          "text": "只有那位叫做久岐忍的小姐还在按计划寄送邀请函…"
        },
        {
          "role": "派蒙",
          "text": "哎呀，荒泷派除了阿忍，没有谁是在谱上的。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，不如我们来帮忙吧！看在阿忍的份上，我们也不能让这次活动太走调啦！"
        },
        {
          "role": "德沃沙克",
          "text": "这…这样可以吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，让我们来吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "德沃沙克",
          "text": "那真是帮了大忙了呀…刚刚提到的内容就是很需要人手的地方。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，别客气！所以我们要做的，就是去邀请更多的音乐爱好者，还有找来更多打扮场地的东西，对不对呀？"
        },
        {
          "role": "德沃沙克",
          "text": "没错，按照原先的计划，我们会在五天内完成所有内容，之后就可以开始最后的庆典晚会了。"
        },
        {
          "role": "德沃沙克",
          "text": "请稍等一下，我把待完成项记在一个清单里吧，这样对你们也方便。"
        },
        {
          "role": "德沃沙克",
          "text": "对了，再透露一点消息，一斗兄打算在最后一天登台献唱。"
        },
        {
          "role": "派蒙",
          "text": "这个放牛的！又想一个人出风头！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那派蒙也去献唱吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼哼，要是那样，恐怕放牛的就一点风头都没了哦。"
        },
        {
          "role": "派蒙",
          "text": "他肯定会大喊着「派蒙真是太摇滚了！」然后哇哇乱哭跑下台。"
        },
        {
          "role": "德沃沙克",
          "text": "哈哈，派蒙小姐这种信心，意外地适合上台表演。"
        },
        {
          "role": "派蒙",
          "text": "我就是那么一说嘛，嘿嘿。现在我们就等一下德沃沙克大叔的清单吧！"
        },
        {
          "role": "德沃沙克",
          "text": "那两位可以在场地里转转，我稍后就来。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（德沃沙克）"
        },
        {
          "role": "德沃沙克",
          "text": "两位可以在场地里转转，我稍后就来。"
        },
        {
          "type": "subtitle",
          "text": "参观庆典场地"
        },
        {
          "role": "鹿野院平藏",
          "text": "哎呀呀！旅行者，派蒙！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！是阿忍！还有平藏！你居然也来了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "真是意外又不那么意外之喜啊。我刚才还在和阿忍小姐说，感觉马上就会遇到你们。"
        },
        {
          "role": "久岐忍",
          "text": "呵呵，鹿野院同心刚才一路提到你们好几次。这就叫念念不忘，必有回响吧。"
        },
        {
          "role": "鹿野院平藏",
          "text": "是直觉啦，直觉。我习惯在关键的时候想到关键的人呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很高兴见到你们。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "真没想到，平藏居然是我们之外第一个到的。"
        },
        {
          "role": "久岐忍",
          "text": "老大叮嘱了我，给天领奉行的邀请函要尽快，他特别邀请了九条裟罗大人和鹿野院同心两位。"
        },
        {
          "role": "派蒙",
          "text": "那…那裟罗怎么没来呢？"
        },
        {
          "role": "鹿野院平藏",
          "text": "肯定是因为她完全不想见到一斗老兄吧，毕竟邀请函上最后写着："
        },
        {
          "role": "鹿野院平藏",
          "text": "「九条天狗！跟本大爷在珊瑚宫之巅来一场热血燃情摇滚相扑吧！！」"
        },
        {
          "role": "久岐忍",
          "text": "如果我是九条裟罗大人，一定想要把老大从珊瑚宫顶上推下去。"
        },
        {
          "role": "派蒙",
          "text": "然后心海会把裟罗也推下去吧？在她头顶上叮呤哐啷的简直吵死了。"
        },
        {
          "role": "久岐忍",
          "text": "哈哈哈，总之，我觉得九条裟罗大人脾气还是太好了点，她还给我们送了一筐堇瓜作为贺礼。"
        },
        {
          "role": "鹿野院平藏",
          "text": "脾气好吗？嘿嘿，我怎么觉得，那个女人另有深意呢。"
        },
        {
          "role": "派蒙",
          "text": "什么深意啊？"
        },
        {
          "role": "鹿野院平藏",
          "text": "「荒泷小鬼跟我一斗？奉行之所堇瓜管够。」"
        },
        {
          "role": "派蒙",
          "text": "什么嘛，平藏，你也太有心眼了吧！我看你们带来了两筐堇瓜，另一筐是不是你送的？是不是也另有深意？"
        },
        {
          "role": "鹿野院平藏",
          "text": "哈哈，另一筐是奉行所里的大家凑的啦。有我，有抓过一斗老兄的其它同心，还有一斗老兄的一些狱友。"
        },
        {
          "role": "鹿野院平藏",
          "text": "所以这筐堇瓜的祝福大概就是「要常来找我们玩哦！」的意思吧。"
        },
        {
          "role": "久岐忍",
          "text": "这种祝福还是不要让老大听见为好。"
        },
        {
          "role": "鹿野院平藏",
          "text": "嗯，送到了堇瓜，还见到了想见的人，我也差不多该要先走一步了。"
        },
        {
          "role": "派蒙",
          "text": "咦？平藏不参加活动了吗？"
        },
        {
          "role": "鹿野院平藏",
          "text": "放心，我不会错过最后的庆典，只是现在还要去离岛办点事。"
        },
        {
          "role": "派蒙",
          "text": "还要去离岛啊，当侦探真忙…欸对了！平藏听过战场中的忍犬吗？好像就是在离岛流传起来的。"
        },
        {
          "role": "鹿野院平藏",
          "text": "噢…那只狗啊。是不是这次音乐节的灵感来源？阿忍小姐倒是有跟我介绍过主题和故事。"
        },
        {
          "role": "派蒙",
          "text": "好吧，我以为奉行所会知道什么内情呢。"
        },
        {
          "role": "鹿野院平藏",
          "text": "但按经验…我猜这只是个乡野传说，根本没有什么狗。"
        },
        {
          "role": "鹿野院平藏",
          "text": "怎么？旅行者，看你的表情，好像有点在意？"
        },
        {
          "role": "鹿野院平藏",
          "text": "有意思…不如我顺便打听打听吧，反正我要去趟离岛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "会不会影响你办事？",
              "dialogues": []
            },
            {
              "text": "需要付委托费吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹿野院平藏",
          "text": "这种话就太客气了。你在意的东西，我通常都很感兴趣哦。"
        },
        {
          "role": "鹿野院平藏",
          "text": "嘿嘿，那等我消息吧，回见了各位！"
        },
        {
          "role": "久岐忍",
          "text": "鹿野院同心果然是个自由的行动派啊，我也该继续去送邀请函了，不管怎么说，最后的庆典晚会才是重点。"
        },
        {
          "role": "派蒙",
          "text": "那我们也不能落后，不知道待完成清单怎么样了…"
        },
        {
          "role": "德沃沙克",
          "text": "久等了两位，请收好这份清单。之后按照这个来就没问题了。"
        },
        {
          "role": "派蒙",
          "text": "太好了，大叔来的正是时候！旅行者，这下我们也可以准备准备出发了！"
        },
        {
          "role": "德沃沙克",
          "text": "请两位费心了。如果想要演奏乐曲放松一下，我就在乐曲排练区等着。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（德沃沙克）"
        },
        {
          "role": "德沃沙克",
          "text": "你好啊，旅行者，有什么想演奏的曲子吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "让我试试吧。",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "初次"
                },
                {
                  "role": "德沃沙克",
                  "text": "嗯，在开始之前，因为每个人的使用习惯不同，最好先调试一下乐器，我来帮你们。"
                },
                {
                  "type": "subtitle",
                  "text": "再次"
                },
                {
                  "role": "德沃沙克",
                  "text": "看来我可以大饱耳福了。"
                }
              ]
            },
            {
              "text": "我想装饰一下场地。",
              "dialogues": [
                {
                  "role": "德沃沙克",
                  "text": "哦？你完成了清单上的内容吗？请交给我就好，非常感谢！"
                }
              ]
            },
            {
              "text": "稍后再来。",
              "dialogues": [
                {
                  "role": "德沃沙克",
                  "text": "没问题，我会在这里等着。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "观察签到板"
        },
        {
          "role": "「荒泷生命摇滚虹色大巡回」",
          "text": "（一块签到板，和城里的留言板款式相同。）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "鹿野院平藏的留言",
              "dialogues": [
                {
                  "role": "「荒泷生命摇滚虹色大巡回」",
                  "text": "一斗老兄，收到你寄至我所的邀请函，所有人都为你感到高兴。"
                },
                {
                  "role": "「荒泷生命摇滚虹色大巡回」",
                  "text": "大家一致认为，你的智慧足以胜任活动策划的工作。如果能再刻苦专注一点，就不用总去我们那报到了。"
                },
                {
                  "role": "「荒泷生命摇滚虹色大巡回」",
                  "text": "所以，请收下这些堇瓜吧，一点来自奉行所的心意。"
                },
                {
                  "role": "「荒泷生命摇滚虹色大巡回」",
                  "text": "对了，差点忘了九条裟罗大人让我带句话：「不要忘记，天领奉行在看着你。」"
                }
              ]
            },
            {
              "text": "离开",
              "dialogues": []
            }
          ]
        }
      ],
