{
  "quest_id": 70104,
  "chapter_num": null,
  "chapter_title": "雪山大勘测",
  "type": "wq",
  "route": "The Great Mountain Survey",
  "stories": [
    {
      "story_id": 70104,
      "title": "雪山大勘测",
      "description": "环境学家艾斯特尔与一支探险队进山勘测时，因为遭遇怪物袭击，她的大部分勘测信标都丢失了，她正在寻找愿意帮她拿回信标的人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆与艾斯特尔对话"
        },
        {
          "role": "艾斯特尔",
          "text": "糟糕了糟糕了，这可怎么办…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "艾斯特尔",
          "text": "我的信标！好多都落在山上了！"
        },
        {
          "role": "艾斯特尔",
          "text": "呜…这我还怎么研究啊，那可是我花了好多钱买的…"
        },
        {
          "role": "旅行者",
          "text": "到底发生了什么？"
        },
        {
          "role": "艾斯特尔",
          "text": "我…我因为想要研究雪山的气候啦，环境啦什么的，所以花大价钱订购了一套的勘测信标。"
        },
        {
          "role": "艾斯特尔",
          "text": "然后我跟着一支探险队上山安置信标，但是…但是在我安置信标的时候，突然有一大群怪物冲了过来…"
        },
        {
          "role": "艾斯特尔",
          "text": "我还没来得及把信标全部拿回来，就被探险队里的人给带回来了。"
        },
        {
          "role": "艾斯特尔",
          "text": "他们说一时半会不能再次上山，但我的信标要是被怪物弄坏了可怎么办啊！"
        },
        {
          "role": "艾斯特尔",
          "text": "你愿意帮我把山上的那些信标拿回来吗？拜托你了，那些信标很好找的。"
        },
        {
          "role": "旅行者",
          "text": "好吧…"
        },
        {
          "role": "艾斯特尔",
          "text": "谢谢你！太谢谢你了，那就拜托你啦。"
        },
        {
          "role": "旅行者",
          "text": "关于报酬…"
        },
        {
          "role": "艾斯特尔",
          "text": "报、报酬…我会准备好足够的报酬，一定会的…"
        },
        {
          "role": "艾斯特尔",
          "text": "所以这件事就拜托你了。"
        },
        {
          "type": "subtitle",
          "text": "◆回收勘测信标（4/4）"
        },
        {
          "type": "subtitle",
          "text": "◆与艾斯特尔对话"
        },
        {
          "role": "艾斯特尔",
          "text": "你找到我的信标了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了。"
        },
        {
          "role": "艾斯特尔",
          "text": "给我看看，没错，这些是我的信标！"
        },
        {
          "role": "艾斯特尔",
          "text": "这个状态…它们一定还是被魔物折腾过了，还好，总算是没有彻底坏掉。"
        },
        {
          "role": "艾斯特尔",
          "text": "唉，但这些信标暂时是不能用了…算了，不能完全勘测就不能完全勘测吧，能测一点是一点…"
        },
        {
          "role": "艾斯特尔",
          "text": "我这里还有几个信标，你能帮我把它们都放到山上去吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "具体要放在哪？",
              "dialogues": [
                {
                  "role": "艾斯特尔",
                  "text": "你是答应我了吧！谢谢你，我这就把地点给你标注在地图上。"
                }
              ]
            },
            {
              "text": "你怎么不自己去？",
              "dialogues": [
                {
                  "role": "艾斯特尔",
                  "text": "我不敢去啦…连探险队都被怪物袭击成那个样子，我一个人怎么敢上去。"
                },
                {
                  "role": "艾斯特尔",
                  "text": "而且我暂时也找不到另一支要进山的探险队，再这么拖下去，不知道要拖到什么时候。"
                },
                {
                  "role": "艾斯特尔",
                  "text": "所以我只能拜托你了，你之前那么顺利就帮我拿回了信标，身手一定不错。"
                },
                {
                  "role": "艾斯特尔",
                  "text": "这件事就拜托你了，我一定会准备好报酬的！"
                },
                {
                  "role": "艾斯特尔",
                  "text": "对了，我把要放置信标的地点给你标在地图上…"
                }
              ]
            }
          ]
        },
        {
          "role": "艾斯特尔",
          "text": "好了，我已经把地点给你标好了，把信标放在那附近就好。"
        },
        {
          "role": "艾斯特尔",
          "text": "你放置信标的时候，记得把信标放在高处啊，那样勘测的效果才最好。"
        },
        {
          "type": "subtitle",
          "text": "◆放置勘测信标（4/4）"
        },
        {
          "type": "subtitle",
          "text": "◆向艾斯特尔回报"
        },
        {
          "role": "艾斯特尔",
          "text": "怎么样，信标都放好了吗？"
        },
        {
          "role": "旅行者",
          "text": "都放好了。"
        },
        {
          "role": "艾斯特尔",
          "text": "实在是帮大忙了，这些报酬给你，谢谢你帮我这么多忙。"
        },
        {
          "role": "艾斯特尔",
          "text": "唉，这么点信标，也不知道能勘测到多少有用的信息…"
        }
      ]
    }
  ]
}