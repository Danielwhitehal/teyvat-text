{
  "quest_id": 41147,
  "chapter_num": null,
  "chapter_title": "望舒外送",
  "type": "eq",
  "route": "Wangshu Take-Away",
  "stories": [
    {
      "story_id": 41147,
      "title": "望舒外送",
      "description": "璃月的望舒客栈里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "言笑",
          "text": "哦唷，这么爽快，那你赶紧送过去吧。"
        },
        {
          "role": "言笑",
          "text": "对了，你送的时候别乱跑，见到危险情况也绕着走别被撞了。要是汤弄洒了的话，客人肯定是不会收的。"
        },
        {
          "role": "言笑",
          "text": "那个人口味又刁钻的很，也不知道是谁养的…"
        },
        {
          "role": "寡言的廷方",
          "text": "那厨子怎么还没把餐送来…"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "言笑",
          "text": "嗯，确实一份。廷方那个…客人，在我这里订了一份水煮黑背鲈。"
        },
        {
          "role": "言笑",
          "text": "然后他说，晚点时候再把餐送到地中之盐的一个地方…"
        },
        {
          "role": "言笑",
          "text": "你要是愿意，就帮我跑个腿吧，报酬少不了你的。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "寡言的廷方",
          "text": "多谢。"
        },
        {
          "role": "寡言的廷方",
          "text": "……"
        },
        {
          "role": "寡言的廷方",
          "text": "那厨子的手艺，不错。"
        }
      ]
    }
  ]
}