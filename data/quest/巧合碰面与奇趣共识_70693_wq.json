{
  "quest_id": 70693,
  "chapter_num": null,
  "chapter_title": "巧合碰面与奇趣共识",
  "type": "wq",
  "route": "Serendipitous Encounters and a Curious Consensus",
  "stories": [
    {
      "story_id": 70693,
      "title": "巧合碰面与奇趣共识",
      "description": "在「龙脊雪山国际越野赛」的营地附近，你遇见了两位老朋友，她们之间的会面，你此前还未有过设想…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与正在讨论的两人对话"
        },
        {
          "role": "安柏",
          "text": "所以说呀，我们都看出来了！"
        },
        {
          "role": "安柏",
          "text": "优菈最讨厌的应该是那种…死板和迂腐写在眉毛之间，一股劲儿钻牛角尖，只知道在流程和细节上卡人的家伙！"
        },
        {
          "role": "烟绯",
          "text": "说不定，脸上还戴着单片眼镜，手里时常拿着一本书，但自己并没有完全读透，只是把它当成了装饰品。"
        },
        {
          "role": "烟绯",
          "text": "如此一来，就显得自己有股「老学派」的气质，好像对话刚开始，就能在气势上压人一头！"
        },
        {
          "role": "安柏",
          "text": "啊，实在太精准了，我的脑袋里都有画面了！"
        },
        {
          "role": "派蒙",
          "text": "烟绯和…安柏？是之前完全没见过的组合！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是在聊什么呢？",
              "dialogues": []
            },
            {
              "text": "优菈讨厌的家伙？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "啊呀，荣誉骑士和派蒙，你们来啦！"
        },
        {
          "role": "安柏",
          "text": "我正和烟绯商量方案呢，要不要给我们的游艺加几个「坏家伙雪人」，当成彩蛋。"
        },
        {
          "role": "派蒙",
          "text": "就像是魔物的靶子吗？"
        },
        {
          "role": "安柏",
          "text": "除了反派专业户魔物，也可以有些不那么传统的形象。"
        },
        {
          "role": "安柏",
          "text": "在选角的方向上，我和烟绯不谋而合的点子太多了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在这里看到烟绯，有些惊喜。",
              "dialogues": []
            },
            {
              "text": "以前没想过你们碰面的场景。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "说起来也挺神奇的，你们真的站在一起的时候，我才发现，你们一看就很合得来！"
        },
        {
          "role": "烟绯",
          "text": "确实，能在蒙德遇见旅行者和派蒙，我也非常意外！"
        },
        {
          "role": "烟绯",
          "text": "其实哦，我也不是第一次来蒙德了，之前在这边帮忙处理过不少民事诉讼…"
        },
        {
          "role": "烟绯",
          "text": "这回，我刚和瑶瑶忙完，就碰上了「龙脊雪山国际越野赛」开幕，正好来看点新鲜的场面。"
        },
        {
          "role": "烟绯",
          "text": "结果，到会场问路时，我遇见了安柏，和安柏聊得很投缘。"
        },
        {
          "role": "烟绯",
          "text": "于是就来体验一下安柏管理的游戏，也帮忙出出主意！"
        },
        {
          "role": "安柏",
          "text": "嘿嘿，优菈的朋友，也是我的朋友，有趣的游戏，当然要一起享受啦！"
        },
        {
          "role": "安柏",
          "text": "荣誉骑士和派蒙也来试试吧？为各国客人放松心情，施放压力的小游戏「飞玉趣掷」。"
        },
        {
          "role": "派蒙",
          "text": "嗯！练习一下打雪仗的本领，说不定以后能派上用场！"
        },
        {
          "role": "派蒙",
          "text": "而且，我和旅行者无聊的时候也可以玩，比一比谁更厉害，输了的负责做饭！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我可不能错过。",
              "dialogues": []
            },
            {
              "text": "我丢雪球还蛮准的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "投雪球，和扔火球…以至于各种元素的投掷物，都有共通之处。"
        },
        {
          "role": "烟绯",
          "text": "对于你这位武艺天才来说，肯定不在话下！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（烟绯）"
        },
        {
          "role": "烟绯",
          "text": "旅行者，准备捏好雪球，把它们痛痛快快地抛向目标了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了！",
              "dialogues": [
                {
                  "role": "烟绯",
                  "text": "那就来玩吧！"
                }
              ]
            },
            {
              "text": "在蒙德玩得开心吗？",
              "dialogues": [
                {
                  "role": "烟绯",
                  "text": "那可不，每次来这边，都有新收获！比如这回，终于和安柏见面了！"
                },
                {
                  "role": "烟绯",
                  "text": "之前，我就从优菈那里听说了安柏的事，很想结交这位朋友。"
                },
                {
                  "role": "烟绯",
                  "text": "一碰面就确认了，我们真的非常合拍！"
                },
                {
                  "role": "烟绯",
                  "text": "安柏陪着我到处留影，走访了一些有趣的地标，体验了明冠峡的特色滑翔航线…"
                },
                {
                  "role": "烟绯",
                  "text": "昨天，我们还在望风山地露营，钓到了肉质非常鲜嫩的鱼，烧煮出来的豆腐汤特别鲜美！"
                },
                {
                  "role": "烟绯",
                  "text": "这点特别需要感谢安柏——我寄信给优菈，提到最近要来蒙德后，安柏也得知了这个消息。"
                },
                {
                  "role": "烟绯",
                  "text": "她提前找商人预定了蒙德不常见的豆腐，以至于，我们露营的时候，食材的质量和饭店里完全没区别！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "想试试豆腐鱼汤…",
                      "dialogues": []
                    },
                    {
                      "text": "想试试这种旅行…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "烟绯",
                  "text": "那简单，下次挑个优菈不用加班的日子，我们四个一起露营吧？一定会很开心的！"
                }
              ]
            },
            {
              "text": "正事忙得如何了？",
              "dialogues": [
                {
                  "role": "烟绯",
                  "text": "一切顺利啦！这次我的工作，是调解商人转销茶叶的利润纠纷，非常经典的案例，没花多少心力。"
                },
                {
                  "role": "烟绯",
                  "text": "工作结束得太快，以至于我还能抽出空来，和瑶瑶一起去图书馆，借些新鲜的书。"
                },
                {
                  "role": "烟绯",
                  "text": "蒙德骑士团图书馆的藏书风格，和总务司的书库，还有璃月的几家书店，风格差异还是挺大的。"
                },
                {
                  "role": "烟绯",
                  "text": "我找到了待读书单里的《北大陆律法演进史》全集，在安柏的帮助下搞定了手续，办了一年的借期。"
                },
                {
                  "role": "烟绯",
                  "text": "瑶瑶要找的书也都齐了！和那位优雅的图书管理员小姐闲聊时，瑶瑶还结识了新朋友，收获满满！"
                },
                {
                  "role": "烟绯",
                  "text": "现在，她们应该在尝试全新的捉迷藏游戏，我看了规则，感觉很有意思，你也可以去。"
                }
              ]
            },
            {
              "text": "先去别的地方看看。",
              "dialogues": [
                {
                  "role": "烟绯",
                  "text": "好呀，有空了就记得来玩哦！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          27,
          29
        ]
      ]
    }
  ]
}