{
  "quest_id": 10173,
  "chapter_num": "炼金与经营 其四",
  "chapter_title": "完满收工",
  "type": "eq",
  "route": "A Job Well Done",
  "stories": [
    {
      "story_id": 40154,
      "title": "完满收工",
      "description": "店铺经营大获成功，是时候庆祝一番了。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "返回店铺"
        },
        {
          "type": "subtitle",
          "text": "与丽莎对话"
        },
        {
          "type": "subtitle",
          "text": "经过这段时间的努力经营，炼金店铺的营业额达到了比预期中更高的数据…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "丽莎",
          "text": "哎呀，想不到短短一段时间，小可爱居然能把营业额提升到这个程度…"
        },
        {
          "role": "丽莎",
          "text": "莫非你是商业天才吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "多亏了丽莎的帮助。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "呵呵，你还是那么谦虚。"
                },
                {
                  "role": "丽莎",
                  "text": "得到这么厉害的成果，可以再自豪一点的哦。"
                }
              ]
            },
            {
              "text": "不知不觉就找到诀窍了。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "嗯，你的学习能力果然非常强呢。"
                }
              ]
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "要是能把你留在身边当助手，我的假期应该能再增加一倍吧。"
        },
        {
          "role": "丽莎",
          "text": "现阶段收集到的销售数据已经足够了。这段时间辛苦你们啦。"
        },
        {
          "role": "丽莎",
          "text": "当然，如果你愿意继续帮忙照看店铺，姐姐也会很高兴哦。"
        },
        {
          "role": "丽莎",
          "text": "这下，我也能跟琴交差了，呵呵…"
        },
        {
          "role": "琴",
          "text": "旅行者，派蒙，好久不见。"
        },
        {
          "role": "派蒙",
          "text": "琴团长！"
        },
        {
          "role": "丽莎",
          "text": "你来了，我正想着跟小可爱交接完工作，就回骑士团找你呢。"
        },
        {
          "role": "琴",
          "text": "嗯，我已经从其他骑士那里了解了大致情况。"
        },
        {
          "role": "琴",
          "text": "想不到，这次你也让旅行者来帮忙了。"
        },
        {
          "role": "丽莎",
          "text": "哎呀，这种重要的工作要想取得突破，精明能干的合作伙伴是不可或缺的。"
        },
        {
          "role": "丽莎",
          "text": "你看，只有我的话可达不到这样的效率呢。"
        },
        {
          "role": "琴",
          "text": "确实，你们的成绩非常惊人。"
        },
        {
          "role": "琴",
          "text": "本想将其他事务安排妥当之后就过来看看你们的情况，却一直抽不出时间…至少我想亲口表达对你们的感谢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "琴团长一直在背后支持我们。",
              "dialogues": []
            },
            {
              "text": "这是所有人一起努力的成果。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "琴",
          "text": "嗯，有你们这样优秀的同伴，实在是令人安心。"
        },
        {
          "role": "丽莎",
          "text": "呵呵，等事情告一段落，我是不是可以好好休个假了？"
        },
        {
          "role": "丽莎",
          "text": "最近似乎头发都多掉了几根呢。"
        },
        {
          "role": "琴",
          "text": "没问题。这段时间辛苦你了。"
        },
        {
          "role": "琴",
          "text": "之前我看你每天待在图书馆，时间长了或许会感到无聊，所以想安排一些更能发挥你才能的工作。"
        },
        {
          "role": "琴",
          "text": "是不是一下子给你增加太多压力了？"
        },
        {
          "role": "丽莎",
          "text": "其实也还好啦，毕竟有骑士团各位的支援，还有得力的同伴旅行者帮我分担工作。"
        },
        {
          "role": "丽莎",
          "text": "偶尔干回老本行，搞搞研究，也还挺有意思的。"
        },
        {
          "role": "琴",
          "text": "嗯，你能这么想就好了。"
        },
        {
          "role": "琴",
          "text": "旅行者，再次感谢你的付出。请收下这些报酬。"
        },
        {
          "role": "丽莎",
          "text": "说到这个，姐姐我也为你做了个纪念品，希望你能喜欢哦。"
        },
        {
          "type": "subtitle",
          "text": "1100px",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "额外对话（琴&丽莎）"
        },
        {
          "role": "琴",
          "text": "民众对炼金药剂的接受程度，比预想中高了许多。"
        },
        {
          "role": "琴",
          "text": "长此以往，炼金药剂相关的产业说不定能一跃成为蒙德新的经济来源…"
        },
        {
          "role": "丽莎",
          "text": "哎呀，这些事情以后再想也不迟。难得重要的工作告一段落，找个时间办庆功宴如何？"
        },
        {
          "role": "派蒙",
          "text": "哇，有好吃好喝的吗？那我可一定要参加！"
        },
        {
          "role": "丽莎",
          "text": "当然，等筹备完成，姐姐会亲自邀请你们的。"
        },
        {
          "role": "琴",
          "text": "是啊，大家确实需要好好放松呢。"
        }
      ],
      "collapse_ranges": [
        [
          32,
          38
        ]
      ]
    }
  ]
}