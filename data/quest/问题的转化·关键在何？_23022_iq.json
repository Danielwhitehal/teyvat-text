  "stories": [
    {
      "story_id": 23022,
      "title": "问题的转化·关键在何？",
      "description": "拉菲克由之前的测试总结出了一些经验…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与拉菲克对话"
        },
        {
          "role": "拉菲克",
          "text": "这里的强度要是再增加的话，就必须把这里…"
        },
        {
          "role": "绮珊",
          "text": "如果你采用这种设计，就和之前没什么本质区别了。"
        },
        {
          "role": "旅行者",
          "text": "你们还在设计船吗？"
        },
        {
          "role": "拉菲克",
          "text": "是你啊，旅行者。没错，在上次试航结束之后，我和绮珊又讨论了一些…嗯…关键节点上的设计。"
        },
        {
          "role": "拉菲克",
          "text": "在我们…充分地交流后，正准备尝试一种新的设计方案。"
        },
        {
          "role": "拉菲克",
          "text": "但是在材料使用上，我们又产生了一些分歧。"
        },
        {
          "role": "拉菲克",
          "text": "不过这一次！我可是听了绮珊的意见，花大价钱买了一批好材料。"
        },
        {
          "role": "拉菲克",
          "text": "旅行者，你看，我一个人搬不完，绮珊的力气也不大，你就…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们一起去搬。",
              "dialogues": []
            },
            {
              "text": "别说了，走吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "拉菲克",
          "text": "真是可靠，那我们赶紧出发吧。"
        },
        {
          "role": "拉菲克",
          "text": "这次的材料可是绮珊亲自选的，应该不会出什么问题了…"
        },
        {
          "role": "拉菲克",
          "text": "而且这次，我还给你准备了更多的报酬，真是谢谢你帮忙了…"
        },
        {
          "type": "subtitle",
          "text": "前去拿取修船物资"
        },
        {
          "role": "绮珊",
          "text": "…说服拉菲克多花点钱，比说服老板给我涨工资还困难。"
        },
        {
          "type": "subtitle",
          "text": "前去拿取修船物资"
        },
        {
          "type": "subtitle",
          "text": "回去向拉菲克说明情况"
        },
        {
          "role": "拉菲克",
          "text": "怎么样，你把那些材料搬过来了吗？"
        },
        {
          "type": "subtitle",
          "text": "回去向拉菲克说明情况"
        },
        {
          "role": "拉菲克",
          "text": "好…嘞！这些材料应该就够用了。这是你的报酬。"
        },
        {
          "role": "拉菲克",
          "text": "不过，这些材料还真是轻啊…绮珊选的这些材料真的可靠吗…"
        },
        {
          "role": "绮珊",
          "text": "相信我，这些材料比你之前选的那些都好。"
        },
        {
          "role": "拉菲克",
          "text": "那这次，你要帮我准备好救生用具。"
        },
        {
          "role": "绮珊",
          "text": "…没问题的，你就相信我吧。"
        }
      ]
    }
  ]
}