{
  "quest_id": 10099,
  "chapter_num": "杯中遥吟之歌 第三幕",
  "chapter_title": "自往昔飘起的酒香",
  "type": "eq",
  "route": "Aroma of the Past",
  "stories": [
    {
      "story_id": 40080,
      "title": "自往昔飘起的酒香",
      "description": "骑士团为雷泽提供的酿酒材料，似乎已经准备得差不多了，到西风骑士团去看看吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到两天后"
        },
        {
          "role": "派蒙",
          "text": "之前丽莎小姐说，骑士团也会帮雷泽准备酿酒材料，算算时间，今天应该差不多了。"
        },
        {
          "role": "派蒙",
          "text": "我们过去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "前往西风骑士团"
        },
        {
          "role": "派蒙",
          "text": "也不知道雷泽那边，「补课」的进展是不是顺利…"
        },
        {
          "role": "诺艾尔",
          "text": "砂糖小姐，请等一下！"
        },
        {
          "role": "诺艾尔",
          "text": "旅行者前辈，派蒙，请帮我拦住她！"
        },
        {
          "role": "派蒙",
          "text": "哇，吓我一跳！"
        },
        {
          "role": "派蒙",
          "text": "你们两个，怎么慌慌张张的？"
        },
        {
          "role": "诺艾尔",
          "text": "是这样的，我和砂糖小姐说好要一起把酿酒材料交给你们，可她-听说雷泽也要来，说什么都不肯留在这里。"
        },
        {
          "role": "砂糖",
          "text": "我…我不擅长和陌生人打交道，只要材料能平安送到就可以了…"
        },
        {
          "role": "诺艾尔",
          "text": "这怎么行呢！既然是我们两人合作完成的，就应该一起出面。我不能抢了砂糖小姐的功劳。"
        },
        {
          "role": "砂糖",
          "text": "不是…功劳什么的…"
        },
        {
          "role": "派蒙",
          "text": "这么看来，骑士团准备的材料是「生物炼金」的产物咯？"
        },
        {
          "role": "诺艾尔",
          "text": "对，是「四倍甜日落果」。"
        },
        {
          "type": "subtitle",
          "text": "获得诺艾尔和砂糖给的日落果…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "四倍甜？普通的甜度还不够吗？"
        },
        {
          "role": "派蒙",
          "text": "而且…为什么是日落果？"
        },
        {
          "role": "诺艾尔",
          "text": "嗯，这就要从头说起了。"
        },
        {
          "role": "诺艾尔",
          "text": "我很喜欢闻酒的味道，对酿酒这件事情，也学习和总结过一些经验。"
        },
        {
          "role": "诺艾尔",
          "text": "从结论来说，原材料的甜味是必不可少的！"
        },
        {
          "role": "诺艾尔",
          "text": "为了选出最合适的那一种，我找来了蒙德周边所有含有甜味的植物和果实，逐一试吃并记录了一份完整的清单。"
        },
        {
          "role": "诺艾尔",
          "text": "不同地点的同种素材也纳入了考量，比如清泉镇附近的甜甜花会比誓言岬的更甜一些。"
        },
        {
          "role": "派蒙",
          "text": "哇，听上去工作量好大…"
        },
        {
          "role": "诺艾尔",
          "text": "没关系，这就是我身为「骑士团女仆」应该做的！"
        },
        {
          "role": "诺艾尔",
          "text": "能够代表骑士团，找到「守护的执着」，对我来说也是无上的荣幸！"
        },
        {
          "role": "派蒙",
          "text": "诺艾尔的眼睛，在发光…"
        },
        {
          "role": "派蒙",
          "text": "但我觉得，她是被丽莎小姐给…"
        },
        {
          "role": "旅行者",
          "text": "派蒙，嘘。"
        },
        {
          "role": "诺艾尔",
          "text": "啊，说回正题。只有我独自进行评测的话，我会担心陷入主观。那天正好遇到了从实验室里出来的砂糖小姐，就问了问她…"
        },
        {
          "role": "砂糖",
          "text": "啊！"
        },
        {
          "role": "诺艾尔",
          "text": "怎么了，砂糖！"
        },
        {
          "role": "砂糖",
          "text": "我突然想起来…我出门是为了去领最近进口的一批实验器材…"
        },
        {
          "role": "诺艾尔",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "看你们的脸色…该不会是把这事情忘记了，一直在实验室里待到今天吧…"
        },
        {
          "role": "诺艾尔",
          "text": "嗯，是的…对不起…"
        },
        {
          "role": "砂糖",
          "text": "唉，别在意，我也有责任。器材我晚些再去找玛乔丽小姐吧。诺艾尔，你先继续说吧。"
        },
        {
          "role": "诺艾尔",
          "text": "是，是！"
        },
        {
          "role": "诺艾尔",
          "text": "砂糖小姐不愧是专业的研究员！对我的清单提出了宝贵的建议…"
        },
        {
          "role": "砂糖",
          "text": "就不用特意夸我了啦…"
        },
        {
          "role": "砂糖",
          "text": "在那之后，诺艾尔也告诉了我事情的经过。"
        },
        {
          "role": "砂糖",
          "text": "她明明不认识那位名叫雷泽的少年，却做得那么认真…让我很感动。但在我看来，现有材料都不足以达到「完美」这一要求。"
        },
        {
          "role": "砂糖",
          "text": "我们需要的是-种含糖量高又便于发酵的水果，最后，我从清单里选择了果酒湖周围采集的日落果样本作为基础，将它改良。"
        },
        {
          "role": "砂糖",
          "text": "通过「生物炼金」放大甜味的特征，再加以实验对照…"
        },
        {
          "role": "诺艾尔",
          "text": "一旦开始做实验，砂糖小姐的毅力就令我自愧不如！"
        },
        {
          "role": "砂糖",
          "text": "啊，都说了请不要夸奖我…"
        },
        {
          "role": "砂糖",
          "text": "总之…「伍式日落果改陆叁号四倍甜度版」，终于研发成功了，甜度经过严格测量，色泽和饱满度也是一流的。"
        },
        {
          "role": "砂糖",
          "text": "诺艾尔把它简称为「四倍甜日落果」。"
        },
        {
          "role": "砂糖",
          "text": "可惜现在的条件还不支持大规模量产…这次能帮上雷泽就好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一定可以的。",
              "dialogues": []
            },
            {
              "text": "我能先尝一口吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂！你怎么回事啊？"
                }
              ]
            }
          ]
        },
        {
          "role": "砂糖",
          "text": "旅行者，我还有一些话想说。"
        },
        {
          "role": "砂糖",
          "text": "从小到大…我都生活得很幸福。虽然一直不太擅长跟人打交道，但父母从没对我提过要求。"
        },
        {
          "role": "砂糖",
          "text": "他们从没对我说过「你应该表现得更开朗一点」，只是告诉我「做自己喜欢的事就好。」"
        },
        {
          "role": "砂糖",
          "text": "我知道…我是幸运的。"
        },
        {
          "role": "砂糖",
          "text": "雷泽的生活，我从未经历过，也无从想象。贸然说这些话只会是冒犯。但我真心希望他能过得快乐，能去做自己想做的事。"
        },
        {
          "role": "诺艾尔",
          "text": "砂糖小姐…"
        },
        {
          "role": "图书馆的门",
          "text": "「咔嗒——」"
        },
        {
          "role": "雷泽",
          "text": "对不起，我又来晚了。"
        },
        {
          "role": "雷泽",
          "text": "师父，忘记看时间，一直，在说话。"
        },
        {
          "role": "派蒙",
          "text": "没事哦，我们刚好也在聊天呢。欸，总感觉这两天说过一模一样的…"
        },
        {
          "role": "派蒙",
          "text": "（咦，等等，砂糖怎么不见了？）"
        },
        {
          "role": "诺艾尔",
          "text": "（竟然趁他推门出来的时机跑掉了？！）"
        },
        {
          "role": "诺艾尔",
          "text": "你好！我是西风骑土团的女仆诺艾尔。"
        },
        {
          "role": "雷泽",
          "text": "你好。"
        },
        {
          "role": "诺艾尔",
          "text": "这份材料请你收下。这并不是我一个人准备的！另一位炼金术土，她现在…那个…"
        },
        {
          "role": "旅行者",
          "text": "她工作有点忙。"
        },
        {
          "role": "诺艾尔",
          "text": "啊，对…很遗憾，不能亲手交给你。"
        },
        {
          "role": "雷泽",
          "text": "药剂，花蜜，还有风晶蝶一样的味道…对吗？"
        },
        {
          "role": "派蒙",
          "text": "哇，果然瞒不过雷泽的嗅觉呀。"
        },
        {
          "role": "雷泽",
          "text": "日落果，比之前闻到过的，都甜。可莉说过，炼金术，超级厉害，能让东西变好。"
        },
        {
          "role": "诺艾尔",
          "text": "嗯！希望这种甜蜜的果子，能为你们酿出最甜最好的酒。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那位女孩子还想说…",
              "dialogues": []
            },
            {
              "text": "「做自己喜欢的事就好。」",
              "dialogues": []
            }
          ]
        },
        {
          "role": "雷泽",
          "text": "…谢谢你们。"
        },
        {
          "role": "雷泽",
          "text": "下次，等她，有空，想当面说谢谢。"
        },
        {
          "role": "诺艾尔",
          "text": "交给我吧！我来想办法说服她…说服她不要每天都这么忙，然后就把她介绍给你认识！"
        },
        {
          "role": "雷泽",
          "text": "好，我会等。"
        },
        {
          "role": "派蒙",
          "text": "嗯，这下材料也收齐了，终于可以酿酒啦。酒桶的话，我记得放在「天使的馈赠」摊位那边了！"
        },
        {
          "role": "派蒙",
          "text": "诺艾尔，那我们就先走了。"
        },
        {
          "role": "诺艾尔",
          "text": "再见，祝你们一切顺利！"
        },
        {
          "type": "subtitle",
          "text": "分支对话（诺艾尔）"
        },
        {
          "role": "诺艾尔",
          "text": "这次的任务，也算顺利完成了吧…"
        },
        {
          "role": "诺艾尔",
          "text": "啊！砂糖小姐的实验器材！我得去帮忙搬运才行！"
        },
        {
          "type": "subtitle",
          "text": "前往佳酿节会场进行酒浆调制"
        },
        {
          "role": "可莉",
          "text": "荣誉骑士哥哥，雷泽，这里这里！你们看看谁来啦！"
        },
        {
          "role": "派蒙",
          "text": "哇，这不是迪奥娜吗？我还以为你会来猫尾酒馆的摊位，结果好几天都没看见你！"
        },
        {
          "role": "迪奥娜",
          "text": "呜…不可原谅…"
        },
        {
          "role": "派蒙",
          "text": "欸？欸——你这么了？"
        },
        {
          "role": "迪奥娜",
          "text": "唔呃呃呃呃呃——气死我啦！"
        },
        {
          "role": "迪奥娜",
          "text": "可莉都告诉我了，都是你们两个干的好事，竟然让雷泽，让爸爸的朋友，可靠的好人！也对酒产生了兴趣！"
        },
        {
          "role": "迪奥娜",
          "text": "雷泽，你绝对不可以变成趴在酒桌上哇哇大哭的臭大叔！"
        },
        {
          "role": "雷泽",
          "text": "我，呃…不明白。"
        },
        {
          "role": "派蒙",
          "text": "听起来像是有什么误会…"
        },
        {
          "role": "派蒙",
          "text": "小可莉，你到底是怎么说的呀？"
        },
        {
          "role": "可莉",
          "text": "唔…我和迪奥娜姐姐说，雷泽要找妈妈，荣誉骑士哥哥在帮他，他们很难过，他们需要酒，所以想要你帮忙…"
        },
        {
          "role": "可莉",
          "text": "还没说完，迪奥娜姐姐就回答:「可莉，你不用再说了，这件事我一定要管。」然后，我们就一起过来了…"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "雷泽",
          "text": "呃…"
        },
        {
          "role": "派蒙",
          "text": "好…好吧，我都不知道该怎么接话了。迪奥娜，关于这件事，传达环节出现了一点问题…"
        },
        {
          "type": "subtitle",
          "text": "向迪奥娜讲述了来龙去脉…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "迪奥娜",
          "text": "你们的意思是说，雷泽是想通过制作父母从前酿造的酒，来了解他们的过去…不是刚编了一个说辞在骗我吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有没有。",
              "dialogues": []
            },
            {
              "text": "绝对没有。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "可莉",
          "text": "迪奥娜姐姐对不起，是可莉不好，没有说清楚。"
        },
        {
          "role": "可莉",
          "text": "你可不可以不要生气，帮帮雷泽做酒？"
        },
        {
          "role": "可莉",
          "text": "我抓好多鱼跟你一起吃，喏，嘟嘟可也给你摸摸。"
        },
        {
          "role": "迪奥娜",
          "text": "我…我才没有多生气呢。"
        },
        {
          "role": "迪奥娜",
          "text": "可莉是想帮忙做好事，我明白。"
        },
        {
          "role": "迪奥娜",
          "text": "我刚才是因为不想雷泽被带坏，才不小心把声音抬高了一点点…既然不是要自己喝，那就勉为其难地帮你们一下好了。"
        },
        {
          "role": "迪奥娜",
          "text": "但有些事先说好，我平时调制的都是酿好的酒。现在突然要从混合原料开始制作,我也不知道会变成怎么样哦…"
        },
        {
          "role": "可莉",
          "text": "太好啦！迪奥娜姐姐是大好人！"
        },
        {
          "role": "雷泽",
          "text": "嗯。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有迪奥娜出手，事半功倍。",
              "dialogues": []
            },
            {
              "text": "加油啊，迪奥娜！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪奥娜",
          "text": "哼，你们就会说好听的。看我的吧。"
        },
        {
          "type": "subtitle",
          "text": "迪奥娜亮出她享誉蒙德的招牌调酒师手势，往酒桶里捣鼓了几下…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "搞定了，真不费力！"
        },
        {
          "role": "派蒙",
          "text": "接下来，就得把它找个地方储存起来了。"
        },
        {
          "role": "派蒙",
          "text": "「等啊，等啊，等着风起涌。」…唔，是要放在有风的地方吗？"
        },
        {
          "role": "雷泽",
          "text": "风起地，可以吗？风很大。"
        },
        {
          "role": "派蒙",
          "text": "嗯！在蒙德只要说起风，第一时间想到的就是那里呢。"
        },
        {
          "role": "可莉",
          "text": "好呀好呀，可莉也要一起去！"
        },
        {
          "role": "迪奥娜",
          "text": "我还要监督我那个笨蛋老爹，就不跟过去了。"
        },
        {
          "role": "迪奥娜",
          "text": "可莉，下次再一起玩吧。"
        },
        {
          "role": "可莉",
          "text": "好哦，约好啦！"
        },
        {
          "type": "subtitle",
          "text": "前往风起地"
        },
        {
          "role": "温迪",
          "text": "好巧好巧，你们也来啦。"
        },
        {
          "role": "派蒙",
          "text": "卖唱的，你怎么会在这里？"
        },
        {
          "role": "温迪",
          "text": "我一觉醒来，空中飘来一阵特别好闻的味道。顺着果子的甜味一路走，就到这里了哦。"
        },
        {
          "role": "可莉",
          "text": "对的，果子好甜，可莉也闻得到！"
        },
        {
          "role": "旅行者",
          "text": "还有别的原因吧？"
        },
        {
          "role": "温迪",
          "text": "嗯，因为我想起了一件重要的事。在你们封上木桶、把酒埋进泥土之前，还需要再做一件事。"
        },
        {
          "role": "可莉",
          "text": "欸！还缺什么东西吗？"
        },
        {
          "role": "温迪",
          "text": "雷泽，还记得那半瓶「千风佳酿」的味道吧？里面是不是有一点苦味？"
        },
        {
          "role": "雷泽",
          "text": "嗯，有。"
        },
        {
          "role": "温迪",
          "text": "啊哈哈，那种苦味大有来头，就是…这个。"
        },
        {
          "role": "派蒙",
          "text": "蒲公英籽？"
        },
        {
          "role": "温迪",
          "text": "你们知道蒲公英酒吧。在蒙德人心中，风能够带回灵魂，也可以保存记忆。"
        },
        {
          "role": "温迪",
          "text": "蒲公英籽就像自然的宝石，汇聚着每年第一缕风。人们把它放进酒桶，就是把当下的风放了进去。"
        },
        {
          "role": "温迪",
          "text": "美酒因而保留下此刻的记忆，直到永远。"
        },
        {
          "role": "温迪",
          "text": "所以，「千风佳酿」就是最初的「蒲公英酒」。"
        },
        {
          "role": "派蒙",
          "text": "喔——！"
        },
        {
          "role": "可莉",
          "text": "好厉害——我们的事情被酒记下来啦！"
        },
        {
          "role": "温迪",
          "text": "至于为什么没有固定的味道嘛，因为放进去的材料完全自由，欲嘿。"
        },
        {
          "role": "雷泽",
          "text": "唔…"
        },
        {
          "role": "可莉",
          "text": "怎么了，雷泽，你在想什么？"
        },
        {
          "role": "雷泽",
          "text": "爸爸妈妈的酒里，蒲公英籽以外，不知道。"
        },
        {
          "role": "雷泽",
          "text": "我的酒里，有很多，朋友的情感。"
        },
        {
          "role": "雷泽",
          "text": "爸爸妈妈，还是不明白。但…有大家。"
        },
        {
          "role": "雷泽",
          "text": "大家，很努力。"
        },
        {
          "role": "雷泽",
          "text": "法尔伽，师父，可莉，班尼特，棕色猫叔叔，冷冷的姐姐，装笑的大人…"
        },
        {
          "role": "雷泽",
          "text": "灰灰硬硬的女孩子，风晶蝶味道的人，猫叔叔的女儿…"
        },
        {
          "role": "雷泽",
          "text": "绿诗人，派蒙，旅行者。"
        },
        {
          "role": "雷泽",
          "text": "每个人，都记着。"
        },
        {
          "role": "雷泽",
          "text": "酒，做起来，很难。"
        },
        {
          "role": "雷泽",
          "text": "没有大家…不会有，今天的酒。"
        },
        {
          "role": "雷泽",
          "text": "和朋友一起，困难，不是困难。"
        },
        {
          "role": "雷泽",
          "text": "我…很开心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能够帮上雷泽…",
              "dialogues": []
            },
            {
              "text": "所有人都很开心哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "雷泽",
          "text": "嗯，谢谢。"
        },
        {
          "role": "雷泽",
          "text": "朋友，也是「卢皮卡」。"
        },
        {
          "role": "雷泽",
          "text": "未来，大家一起。我是人，我是狼都没有关系。"
        },
        {
          "role": "雷泽",
          "text": "长大…再一起来开，这桶酒。"
        },
        {
          "role": "温迪",
          "text": "精彩的发言。我这个吟游诗人，已经没有什么想补充的呢。"
        },
        {
          "role": "温迪",
          "text": "接下来就把酒埋好…慢慢等待它变得甘醇吧。"
        },
        {
          "type": "subtitle",
          "text": "大家一起把酒桶埋进了土里…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "终于完工啦，我也想好好庆祝一下了！"
        },
        {
          "role": "派蒙",
          "text": "没记错的话，明天就是「归风日」对吧？"
        },
        {
          "role": "可莉",
          "text": "哇！风神大人要回来啦——"
        },
        {
          "role": "温迪",
          "text": "啊哈哈，提醒我了。歌谣还没有背完，我得回去准备举杯仪式。各位朋友，明天再见喽。"
        },
        {
          "role": "温迪",
          "text": "今晚好好睡觉，明天早晨记得迎着清风叫醒你们的耳朵，然后，来听最好的吟游诗人演出。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（观察刚埋下的酒桶）"
        },
        {
          "role": "观察藏着酒的土堆",
          "text": "（和同伴们共同制作的酒已经埋好了，就等待它慢慢变成佳酿吧。）"
        },
        {
          "type": "subtitle",
          "text": "分支对话（可莉和雷泽）"
        },
        {
          "role": "可莉",
          "text": "雷泽刚刚很帅哦！"
        },
        {
          "role": "雷泽",
          "text": "帅…是什么意思？"
        },
        {
          "role": "可莉",
          "text": "就是厉害！"
        },
        {
          "role": "雷泽",
          "text": "唔…没有。可莉才帅。"
        },
        {
          "type": "subtitle",
          "text": "等到第二天（10-14点）"
        },
        {
          "role": "派蒙",
          "text": "总算等到「归风日」了，我们快出发，不要错过举杯仪式！"
        },
        {
          "type": "subtitle",
          "text": "前往会场参加举杯仪式"
        },
        {
          "role": "派蒙",
          "text": "好多人啊，大家都来迎接风神了呢。咦，怎么都围在「天使的馈赠」摊位前？"
        },
        {
          "role": "丽莎",
          "text": "按照惯例，佳酿节上品质最好的酒，要等到举杯仪式献给风神大人品尝过之后才能开售，大家都在排队等着呢。"
        },
        {
          "role": "派蒙",
          "text": "哼，对这些家伙来说，迎接风神只是个过场吧。丽莎小姐，你是来看雷泽的吗？"
        },
        {
          "role": "丽莎",
          "text": "嗯，之前还有些不放心，刚才和雷泽聊过几句，听说你们的酿酒之旅还算顺利。今天我也能安心喝一杯了。"
        },
        {
          "role": "派蒙",
          "text": "哇…你也…"
        },
        {
          "role": "丽莎",
          "text": "呵呵，雷泽他们已经在那边了，赶快过去吧。"
        },
        {
          "role": "班尼特",
          "text": "呦，你们来啦！"
        },
        {
          "role": "派蒙",
          "text": "哇，这么多酒瓶是怎么回事？如果不知道，还以为你们也摆了个卖酒的摊位呢。"
        },
        {
          "role": "班尼特",
          "text": "哈哈哈，这些都是我们帮雷泽准备的！"
        },
        {
          "role": "可莉",
          "text": "妈妈说过，今天大家要迎接风神大人，要请他喝酒。如果风神大人高兴，就会变成风来祝福大家。"
        },
        {
          "role": "可莉",
          "text": "我们想让风神大人高兴，让他帮帮雷泽。荣誉骑士姐姐你看，这是阿贝多哥哥借给我的。"
        },
        {
          "role": "班尼特",
          "text": "这瓶是我的老爹们给的，还好没在路上摔了…也就装装样子，用完得给他们带回去。"
        },
        {
          "role": "可莉",
          "text": "妈妈说，风神大人的酒量特别大，只要他想，一口气能把果酒湖喝干！"
        },
        {
          "role": "可莉",
          "text": "这些，再加上雷泽爸爸妈妈留下的酒…够不够呀？"
        },
        {
          "role": "雷泽",
          "text": "啊，绿诗人。"
        },
        {
          "role": "温迪",
          "text": "咳咳各位，非常荣幸来到这里。今天我受西风骑土团代理团长琴小姐邀请，为大家弹奏一曲——「千风佳酿」。"
        },
        {
          "role": "温迪",
          "text": "我会把最好的歌谣献给风，也献给在场的你们——"
        },
        {
          "type": "subtitle",
          "text": "温迪："
        },
        {
          "type": "subtitle",
          "text": "「我们把这些东西封进桶，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "等啊，等啊，等着风起涌。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "把佳酿的瓶口先蜡上，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "南风和煦，北风猛。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "温迪："
        },
        {
          "type": "subtitle",
          "text": "「佳酿味道像什么？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "蒙德的名字，自由的梦。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "究竟是什么发酵成佳酿？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "探索的勇气，慈爱的温柔。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "温迪："
        },
        {
          "type": "subtitle",
          "text": "「守护的执着一如初，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "伴着千风起祝颂，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "酸汁变甜，糙桶润透，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "等啊，等啊，等着风起涌。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "温迪："
        },
        {
          "type": "subtitle",
          "text": "「酒桶里面放了啥？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "小麦的金黄，潜荟葱茏。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "佳酿出桶，飘来了什么？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "风铃的声音，万古的长空。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "温迪："
        },
        {
          "type": "subtitle",
          "text": "「我们伴着这些美酒唱起歌，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "等啊，等啊，等着风起咏。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "千风带走了什么下酒？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "琴弦上的故事，今夜的美梦。」",
          "narration": true
        },
        {
          "role": "琴",
          "text": "朋友们，让我们共同开启美酒——"
        },
        {
          "role": "众人",
          "text": "敬献风神！"
        },
        {
          "role": "雷泽",
          "text": "敬献风神…"
        },
        {
          "role": "旅行者",
          "text": "敬献风神。"
        },
        {
          "role": "可莉",
          "text": "欸…没有风…"
        },
        {
          "role": "雷泽",
          "text": "可莉，别难过。"
        },
        {
          "role": "可莉",
          "text": "怎么会这样，雷泽，风神大人没有回来，是不是他不喜欢我们准备的酒？"
        },
        {
          "role": "旅行者",
          "text": "应该不是…"
        },
        {
          "role": "派蒙",
          "text": "才不会呢！小可莉知道吗？风神大人不仅会变成风，也会变成其他样子，所以今年他一定是变成其他样子回来了！"
        },
        {
          "role": "可莉",
          "text": "唔？是吗？变成…变成蹦蹦？"
        },
        {
          "role": "派蒙",
          "text": "好，就变成蹦蹦！听见了吗风神！"
        },
        {
          "role": "可莉",
          "text": "嘿嘿…雷泽，风神大人给你带来祝福了吗？"
        },
        {
          "role": "雷泽",
          "text": "嗯。"
        },
        {
          "role": "雷泽",
          "text": "跟你们一起，说很多，学会了很多。"
        },
        {
          "role": "雷泽",
          "text": "现在，不会害怕。"
        },
        {
          "role": "雷泽",
          "text": "这个…就是祝福。"
        },
        {
          "role": "班尼特",
          "text": "别忘了，将来等你的酒酿成之后，我也要来喝一口哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也有我的份吧？",
              "dialogues": []
            },
            {
              "text": "会回忆起现在吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "雷泽",
          "text": "嗯，一起分享，一起，回忆。"
        },
        {
          "role": "可莉",
          "text": "嗯嗯！不过…可莉口渴了…"
        },
        {
          "role": "派蒙",
          "text": "光顾着说话了，我们去喝饮料吧？"
        },
        {
          "role": "班尼特",
          "text": "我听说「天使的馈赠」摊位上新开卖的「假日果酿」，可好喝了！"
        },
        {
          "role": "可莉",
          "text": "我要喝我要喝！"
        },
        {
          "role": "雷泽",
          "text": "嗯，大家，我们走吧。"
        },
        {
          "type": "subtitle",
          "text": "过场动画"
        },
        {
          "role": "[https",
          "text": "//www.bilibili.com/video/BV1wD4y1y7CZ?p=1 「待风归，启佳酿」]"
        },
        {
          "type": "subtitle",
          "text": "分支对话（温迪）"
        },
        {
          "type": "subtitle",
          "text": "温迪在摘星崖",
          "narration": true
        },
        {
          "role": "温迪",
          "text": "想不到你会来到这里呀，莫非…你是顺着风中的酒香，一路找过来的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要不要聊聊天？",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "好呀，真想多听听你的声音。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "关于祝福…",
                      "dialogues": [
                        {
                          "role": "温迪",
                          "text": "祝福？哦，你说那个啊。"
                        },
                        {
                          "role": "温迪",
                          "text": "偷偷告诉你，还好大家举杯的时候没有把心愿说出口，否则我就要下不来台了，因为…啊哈哈，风神巴巴托斯的本事很有限嘛。"
                        },
                        {
                          "role": "温迪",
                          "text": "为了吹起来自遥远过去的风，我可是做了一个很长很长的深呼吸，差点缓不过这口气呢。"
                        }
                      ]
                    },
                    {
                      "text": "关于雷泽…",
                      "dialogues": [
                        {
                          "role": "温迪",
                          "text": "那个孩子成长得那么快，我也很欣慰。"
                        },
                        {
                          "role": "温迪",
                          "text": "嗯，用这种口气说话，一下子变得像极了老爷爷呢。"
                        },
                        {
                          "role": "温迪",
                          "text": "这次，还要多亏有你们这些好朋友一路支持着他。"
                        },
                        {
                          "role": "温迪",
                          "text": "善良、温柔，也不乏浪漫和自由…不愧是喝着果酒湖的水长大的蒙德人。"
                        },
                        {
                          "role": "温迪",
                          "text": "至于你…放心，你是我见过最温柔的人了。"
                        }
                      ]
                    },
                    {
                      "text": "关于喝酒…",
                      "dialogues": [
                        {
                          "role": "温迪",
                          "text": "嗯~趁着那么好的节日，我早就喝到喝不下了。"
                        },
                        {
                          "role": "温迪",
                          "text": "可没想到，「归风日」那天，大家又把压箱底的好酒翻出来。"
                        },
                        {
                          "role": "温迪",
                          "text": "唔，闻着都让人陶醉。只好再撑一撑，再撑一撑…"
                        },
                        {
                          "role": "温迪",
                          "text": "不瞒你说，最后，我还偷偷藏了两瓶哦？"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "先不打扰你了。",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "去吧，我的朋友。这里发生的诗篇，风会一一记下。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "分支对话（迪卢克）"
        },
        {
          "type": "subtitle",
          "text": "迪卢克在晨曦酒庄西南的葡萄架中间",
          "narration": true
        },
        {
          "role": "迪卢克",
          "text": "佳酿节氛围如何？还喜欢吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要不要聊聊天？",
              "dialogues": [
                {
                  "role": "迪卢克",
                  "text": "有什么想知道的事？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "旅行者：关于雷泽…",
                      "dialogues": [
                        {
                          "role": "迪卢克",
                          "text": "我能理解远离亲人的苦闷。"
                        },
                        {
                          "role": "迪卢克",
                          "text": "固然不幸，但也未尝不是一种成长。想要成为独当一面的男人或许就要学着面对这些。"
                        },
                        {
                          "role": "迪卢克",
                          "text": "有同伴帮助，想必会过渡得更顺利。"
                        }
                      ]
                    },
                    {
                      "text": "旅行者：关于「声音」…",
                      "dialogues": [
                        {
                          "role": "迪卢克",
                          "text": "…启封的陈酿里，似乎有父亲从前说过的话。"
                        },
                        {
                          "role": "迪卢克",
                          "text": "如果他见到我现在的样子，又不知会怎么想了。"
                        },
                        {
                          "role": "迪卢克",
                          "text": "总不会还抱有过去那种观点吧。"
                        },
                        {
                          "role": "旅行者",
                          "text": "一定会的。"
                        },
                        {
                          "role": "迪卢克",
                          "text": "……"
                        },
                        {
                          "role": "迪卢克",
                          "text": "是吗。"
                        }
                      ]
                    },
                    {
                      "text": "关于「佳酿节」…",
                      "dialogues": [
                        {
                          "role": "迪卢克",
                          "text": "对于蒙德人来说，酿造是沉淀情感的过程，也是铭记历史的方式。"
                        },
                        {
                          "role": "迪卢克",
                          "text": "如今战争远去，生活安宁了许多，我们才能酿出品质更为上乘的美酒。"
                        },
                        {
                          "role": "迪卢克",
                          "text": "就算不亲身汇入欢庆的人群，我也为此感到满足。"
                        },
                        {
                          "role": "迪卢克",
                          "text": "说起来，「假日果酿」…你尝过了吗？"
                        },
                        {
                          "role": "迪卢克",
                          "text": "如果有什么改进建议，我很乐意听。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "先不打扰你了。",
              "dialogues": [
                {
                  "role": "迪卢克",
                  "text": "嗯，有空再聊。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "分支对话（丽莎）"
        },
        {
          "type": "subtitle",
          "text": "丽莎在蒙德城传送锚点旁边的二楼阳台",
          "narration": true
        },
        {
          "role": "丽莎",
          "text": "呵呵，还是这样悠闲的日子更适合我啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要不要聊聊天？",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "好呀，小可爱。哎呀，可惜手边没有茶水招待你。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "关于法尔伽…",
                      "dialogues": [
                        {
                          "role": "丽莎",
                          "text": "知道大团长专门给我写了留言的时候，我也挺意外的。"
                        },
                        {
                          "role": "丽莎",
                          "text": "没想到他在外奔波那么久，心里还一直念着雷泽。"
                        },
                        {
                          "role": "丽莎",
                          "text": "明明他对琴就很严格呢…佳酿节的大小事务都留给了琴去伤脑筋，连句慰劳的话都没有。"
                        },
                        {
                          "role": "丽莎",
                          "text": "等他回来，我可得好好为琴出口气啊。"
                        }
                      ]
                    },
                    {
                      "text": "关于雷泽…",
                      "dialogues": [
                        {
                          "role": "丽莎",
                          "text": "说起来，「雷泽」这个名字，我一直以为是大团长为他取的…"
                        },
                        {
                          "role": "丽莎",
                          "text": "原来是他亲生父母早就想好的啊。"
                        },
                        {
                          "role": "丽莎",
                          "text": "……"
                        },
                        {
                          "role": "丽莎",
                          "text": "嗯，没错，雷泽和我说了，他听到了父母的声音。"
                        },
                        {
                          "role": "丽莎",
                          "text": "「像蹭到了被太阳照着的石头-样，又暖又重。」"
                        },
                        {
                          "role": "丽莎",
                          "text": "在他心中，他们一定是亲切而又厉害的人吧…"
                        }
                      ]
                    },
                    {
                      "text": "关于「佳酿节」…",
                      "dialogues": [
                        {
                          "role": "丽莎",
                          "text": "本来想犒赏自己，只是小酌一杯的。"
                        },
                        {
                          "role": "丽莎",
                          "text": "但佳酿节限供的葡萄酒， 风味确实独特…"
                        },
                        {
                          "role": "丽莎",
                          "text": "等我回过神来的时候，发现自己都已经有些醉意了，呵呵…"
                        },
                        {
                          "role": "丽莎",
                          "text": "小可爱，不要学我哦。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "先不打扰你了。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "嗯，累了就歇一会儿吧。看你总是那么忙碌，还挺心疼的。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "分支对话（雷泽）"
        },
        {
          "type": "subtitle",
          "text": "雷泽在蒙德钓鱼协会对面的悬崖上",
          "narration": true
        },
        {
          "role": "雷泽",
          "text": "风，轻轻的，舒服…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要不要聊聊天？",
              "dialogues": [
                {
                  "role": "雷泽",
                  "text": "好。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "关于法尔伽…",
                      "dialogues": [
                        {
                          "role": "雷泽",
                          "text": "信，送来消息。想谢谢他。"
                        },
                        {
                          "role": "雷泽",
                          "text": "…我想他，卢皮卡也想他。"
                        },
                        {
                          "role": "雷泽",
                          "text": "我已经，大了。"
                        },
                        {
                          "role": "雷泽",
                          "text": "想听他说，人类的爸爸妈妈。"
                        }
                      ]
                    },
                    {
                      "text": "关于父母…",
                      "dialogues": [
                        {
                          "role": "雷泽",
                          "text": "我听到了，他们的声音。"
                        },
                        {
                          "role": "雷泽",
                          "text": "人类的爸爸妈妈…是冒险家…"
                        },
                        {
                          "role": "雷泽",
                          "text": "师父说，恐怕，没活下来…"
                        },
                        {
                          "role": "旅行者",
                          "text": "雷泽…"
                        },
                        {
                          "role": "雷泽",
                          "text": "我有一个木箱，里面是朋友送的，宝物。"
                        },
                        {
                          "role": "雷泽",
                          "text": "是我，最珍贵的东西。"
                        },
                        {
                          "role": "雷泽",
                          "text": "……"
                        },
                        {
                          "role": "雷泽",
                          "text": "人类爸爸妈妈的盒子里…都是我…"
                        }
                      ]
                    },
                    {
                      "text": "关于朋友…",
                      "dialogues": [
                        {
                          "role": "雷泽",
                          "text": "很久以前，我以为，我一个人。只有卢皮卡。"
                        },
                        {
                          "role": "雷泽",
                          "text": "现在，好多人。"
                        },
                        {
                          "role": "雷泽",
                          "text": "大家都帮我，我也帮大家。"
                        },
                        {
                          "role": "雷泽",
                          "text": "人也可以，狼也可以。"
                        },
                        {
                          "role": "雷泽",
                          "text": "我是，城里和城外的，桥。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "先不打扰你了。",
              "dialogues": [
                {
                  "role": "雷泽",
                  "text": "嗯，你也，吹风。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "分支对话（罗莎莉亚）"
        },
        {
          "type": "subtitle",
          "text": "罗莎莉亚在蒙德城正南边的一棵树下（正对佳酿节会场）",
          "narration": true
        },
        {
          "role": "罗莎莉亚",
          "text": "旅行者，又见面了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要不要聊聊天？",
              "dialogues": [
                {
                  "role": "罗莎莉亚",
                  "text": "也行吧。是有什么想问我的？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "关于法尔伽…",
                      "dialogues": [
                        {
                          "role": "罗莎莉亚",
                          "text": "哦。他写的信，芭芭拉已经拿给我看过了。"
                        },
                        {
                          "role": "罗莎莉亚",
                          "text": "她还在牵挂她父亲西蒙。「所有成员平安无事」那句，差点就要沾上泪痕了。"
                        },
                        {
                          "role": "罗莎莉亚",
                          "text": "嗯？你问我吗？"
                        },
                        {
                          "role": "罗莎莉亚",
                          "text": "法尔伽…你认为我应该把他当做父亲来看待，对吧？但我没法像别人家的女儿那样担心他。"
                        },
                        {
                          "role": "罗莎莉亚",
                          "text": "如果他拿不出足够的勇气和实力，就不配带领那么多人。这样的人，不需要我们太过操心。"
                        }
                      ]
                    },
                    {
                      "text": "关于雷泽…",
                      "dialogues": [
                        {
                          "role": "罗莎莉亚",
                          "text": "这么说，他最后想清楚了？"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "至少不会迷茫了。",
                              "dialogues": []
                            },
                            {
                              "text": "算是有了方向。",
                              "dialogues": []
                            }
                          ]
                        },
                        {
                          "role": "罗莎莉亚",
                          "text": "听上去离独立还有些距离。不过，每个人有每个人的活法。"
                        },
                        {
                          "role": "罗莎莉亚",
                          "text": "挺好的，也算你们的努力没有白费。"
                        }
                      ]
                    },
                    {
                      "text": "关于「佳酿节」…",
                      "dialogues": [
                        {
                          "role": "罗莎莉亚",
                          "text": "原本以为熬到节日，总算可以在酒馆里泡一整天。结果哪边的工作都比平时更忙。"
                        },
                        {
                          "role": "罗莎莉亚",
                          "text": "就算溜到这种地方也不能放松，谁知道维多利亚和塔利雅会不会突然抓我去唱诗。"
                        },
                        {
                          "role": "罗莎莉亚",
                          "text": "唉，这节日还是早点过去吧。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "先不打扰你了。",
              "dialogues": [
                {
                  "role": "罗莎莉亚",
                  "text": "嗯。不过别和其他人提起我在这里，我暂时还不想换地方。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "分支对话（砂糖）"
        },
        {
          "type": "subtitle",
          "text": "砂糖在佳酿节会场的猫尾酒馆摊位旁边",
          "narration": true
        },
        {
          "role": "砂糖",
          "text": "你好，是来看我的摊位吗？有很多近期研发品哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要不要聊聊天？",
              "dialogues": [
                {
                  "role": "砂糖",
                  "text": "嗯，你说就好…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "关于摊位…",
                      "dialogues": [
                        {
                          "role": "砂糖",
                          "text": "你问这个啊。"
                        },
                        {
                          "role": "砂糖",
                          "text": "我提前把「生物炼金」产品的营养成分表和价格都写在纸上了,但顾客们还是喜欢直接问…"
                        },
                        {
                          "role": "砂糖",
                          "text": "于是我就只能…照着读…"
                        },
                        {
                          "role": "砂糖",
                          "text": "摆摊这种事，对我来说很有挑战性。"
                        },
                        {
                          "role": "砂糖",
                          "text": "是不是该请诺艾尔来负责接待的部分呢，唔，算了…她应该也挺忙的吧。"
                        }
                      ]
                    },
                    {
                      "text": "关于「生物炼金」产品…",
                      "dialogues": [
                        {
                          "role": "砂糖",
                          "text": "这里有「玖式冰雾花速效冷冻版」、「捌式甜甜花改贰壹号香气特化版」…"
                        },
                        {
                          "role": "砂糖",
                          "text": "还有「伍式日落果改陆叁号四倍甜度版」，都是我的得意作品！"
                        },
                        {
                          "role": "砂糖",
                          "text": "既然是你，我就不用照着读说明了吧。"
                        }
                      ]
                    },
                    {
                      "text": "关于雷泽…",
                      "dialogues": [
                        {
                          "role": "砂糖",
                          "text": "不好意思，那个时候逃走了…"
                        },
                        {
                          "role": "砂糖",
                          "text": "我觉得无论是你还是诺艾尔，都会表达得比我更好…"
                        },
                        {
                          "role": "砂糖",
                          "text": "你们后来还顺利吗?「伍式日落果改陆叁号四倍甜度版」和其他材料在混合过程中没出问题吧？"
                        },
                        {
                          "role": "砂糖",
                          "text": "还有，那个，雷泽他…"
                        },
                        {
                          "role": "旅行者",
                          "text": "放心，一切都好。"
                        },
                        {
                          "role": "砂糖",
                          "text": "呼…太好了。"
                        },
                        {
                          "role": "砂糖",
                          "text": "那…可以麻烦你帮我一个忙吗？我想把这次「千风佳酿」的配方完整地记录下来。"
                        },
                        {
                          "role": "砂糖",
                          "text": "哪怕在很久很久以后，未来的我们，也能再次还原出今天的味道。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "先不打扰你了。",
              "dialogues": [
                {
                  "role": "砂糖",
                  "text": "哪里哪里，没关系的。"
                }
              ]
            }
          ]
        }
      ],
