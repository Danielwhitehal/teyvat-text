{
  "quest_id": 20512,
  "chapter_num": null,
  "chapter_title": "奇药庐中来",
  "type": "iq",
  "route": "Miracle Medicine",
  "stories": [
    {
      "story_id": 20512,
      "title": "奇药庐中来",
      "description": "安东尼向璃月港的一位「神医」求到了一副药方，用来治疗安娜的病…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安东尼对话"
        },
        {
          "role": "安东尼",
          "text": "药方越来越怪了…"
        },
        {
          "role": "旅行者",
          "text": "安娜怎么样了？"
        },
        {
          "role": "安东尼",
          "text": "是你啊，呃，虽然说出来你可能不信，但是安娜说自己确实感觉好多了。"
        },
        {
          "role": "安东尼",
          "text": "难道是那位医生的药方真的起作用了？我自己都不信…"
        },
        {
          "role": "安东尼",
          "text": "不过，不管是不是真的，总之还是先吃药吧。"
        },
        {
          "role": "安东尼",
          "text": "这次的药方是…我看看，你能帮我找一份「水史莱姆的浓厚凝液」来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这次的还算正常。",
              "dialogues": [
                {
                  "role": "安东尼",
                  "text": "…呃，正常吗？我觉得这次的反而更不正常了。"
                },
                {
                  "role": "安东尼",
                  "text": "不过，这次倒是挺好找的，「浓厚凝液」我也问过别人，只要消灭大型史莱姆应该就能拿到。"
                },
                {
                  "role": "安东尼",
                  "text": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。"
                },
                {
                  "role": "安东尼",
                  "text": "我是没这种战斗力的，所以，就拜托你了！"
                }
              ]
            },
            {
              "text": "也许能入口，放心吧。",
              "dialogues": [
                {
                  "role": "安东尼",
                  "text": "你怎么知道的，你难道尝试过吗？呃，你怎么突然不说话了…"
                },
                {
                  "role": "安东尼",
                  "text": "算了先不说这个，水史莱姆应该很好找。「浓厚凝液」我问过别人，只要消灭大型史莱姆应该就能拿到。"
                },
                {
                  "role": "安东尼",
                  "text": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。"
                },
                {
                  "role": "安东尼",
                  "text": "我是没这种战斗力的啦，就拜托你了！"
                }
              ]
            },
            {
              "text": "好说，我知道在哪。",
              "dialogues": [
                {
                  "role": "安东尼",
                  "text": "嚯…真可靠啊，看来你已经很熟悉怎么对付史莱姆了呢。"
                },
                {
                  "role": "安东尼",
                  "text": "那就麻烦你了。「浓厚凝液」，只要消灭大型史莱姆应该就能拿到。"
                },
                {
                  "role": "安东尼",
                  "text": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。"
                },
                {
                  "role": "安东尼",
                  "text": "那么，就万事拜托了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "取得「水史莱姆的浓厚凝液」"
        },
        {
          "role": "安东尼",
          "text": "你找到东西了吗？"
        },
        {
          "role": "旅行者",
          "text": "还没有。"
        },
        {
          "role": "安东尼",
          "text": "毕竟还是要战斗，请做好准备再去吧。"
        },
        {
          "type": "subtitle",
          "text": "与安东尼对话"
        },
        {
          "role": "安东尼",
          "text": "你找到东西了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了。"
        },
        {
          "role": "安东尼",
          "text": "这…看起来确实…很浓郁啊…"
        },
        {
          "role": "安东尼",
          "text": "这东西真的能入药吗，做好了药，我得自己先试试。"
        },
        {
          "role": "安东尼",
          "text": "假如我出了什么事，安娜就拜托你…"
        },
        {
          "role": "安东尼",
          "text": "…交给葛瑞丝修女照顾了。"
        },
        {
          "role": "安东尼",
          "text": "然后告诉她，我去很远的地方工作了，拜托你了，这是我最后的愿望。"
        },
        {
          "role": "旅行者",
          "text": "没事的，你别自己吓自己…"
        },
        {
          "role": "安东尼",
          "text": "因为这药看着就很吓人啊！总之，这些你先收下吧。"
        },
        {
          "role": "安东尼",
          "text": "一定要记得我说的话啊！"
        }
      ]
    }
  ]
}