{
  "quest_id": 74154,
  "chapter_num": null,
  "chapter_title": "勒鲁瓦·绞索",
  "type": "wq",
  "route": "Leroy: Hangman's Noose",
  "stories": [
    {
      "story_id": 74154,
      "title": "勒鲁瓦·绞索",
      "description": "你们再次来到了勒鲁瓦家附近…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往观察伯努瓦家附近情况"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你看，鱼肉是新鲜的，地上也很干净，一定有人刚打扫过。"
        },
        {
          "role": "派蒙",
          "text": "伯努瓦家一定有人，我们过去听听看。"
        },
        {
          "role": "阿托斯",
          "text": "…他说的也有道理，他不能一直消失，至少得偶尔出现一下，散个步什么的。"
        },
        {
          "role": "阿托斯",
          "text": "至少能防止邻居报告执律庭，我可不想招来铳枪队。"
        },
        {
          "role": "莫蒂西娅",
          "text": "爸爸，你很想出去散步对吗？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我…我能吗？"
        },
        {
          "role": "莫蒂西娅",
          "text": "当然能了，不仅能，我们还很乐意陪你出去散步呢。"
        },
        {
          "role": "阿托斯",
          "text": "当心点，别反而给他机会出门求救，那两个怪人一直盯着这里…"
        },
        {
          "role": "莫蒂西娅",
          "text": "爸爸不会的，我知道。"
        },
        {
          "role": "莫蒂西娅",
          "text": "爸爸，你会愿意让执律庭知道…"
        },
        {
          "role": "派蒙",
          "text": "知道什么啊…怎么说话这么小声，根本听不清。"
        },
        {
          "role": "旅行者",
          "text": "他们要出门了。"
        },
        {
          "role": "派蒙",
          "text": "嗯，我们走远些吧。这次得想办法和伯努瓦说上话，对吧？"
        },
        {
          "role": "旅行者",
          "text": "没错。"
        },
        {
          "role": "派蒙",
          "text": "好，我们快走开。"
        },
        {
          "role": "莫蒂西娅",
          "text": "怎么样，爸爸？心情是不是好些了呢？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "是你们！"
        },
        {
          "role": "派蒙",
          "text": "伯努瓦…"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "…你们救救我，不，别救我…"
        },
        {
          "role": "莫蒂西娅",
          "text": "爸爸在说些什么呀，什么救不救的？呵呵。"
        },
        {
          "role": "莫蒂西娅",
          "text": "哦，是你们啊，难怪爸爸要特意跟你们打招呼，原来是熟人。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "…没有，不是的！我们不熟、不熟…"
        },
        {
          "role": "莫蒂西娅",
          "text": "不熟？怎么会呢，我看他们是特地在这里等着你的呀，爸爸。"
        },
        {
          "role": "莫蒂西娅",
          "text": "还好心帮我们拿了报纸，还去灰河找了我们以前的邻居史诺德格拉斯聊天。"
        },
        {
          "role": "莫蒂西娅",
          "text": "我想你们应该是很亲近的，爸爸一向很爱孩子，难怪。"
        },
        {
          "role": "莫蒂西娅",
          "text": "我也很爱孩子，不过我不像爸爸那么无私，我最爱自己的孩子，可惜她不见了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们到底在做什么？",
              "dialogues": [
                {
                  "role": "莫蒂西娅",
                  "text": "我和阿托斯是爸爸的孩子，爸爸爱我们，所以我们也爱爸爸，这不是很明显吗？"
                }
              ]
            },
            {
              "text": "你们为什么要这样做？",
              "dialogues": [
                {
                  "role": "莫蒂西娅",
                  "text": "你是指陪爸爸出来散步吗？这是作为子女应尽的义务，否则我怎么对得起爸爸对我的关爱呢？"
                }
              ]
            }
          ]
        },
        {
          "role": "阿托斯",
          "text": "莫蒂西娅，你看今天天气多好啊，适合散步。"
        },
        {
          "role": "莫蒂西娅",
          "text": "是的，阿托斯。"
        },
        {
          "role": "阿托斯",
          "text": "今天的蒸汽鸟报你看了吗？有很多非常有趣的新闻。"
        },
        {
          "role": "莫蒂西娅",
          "text": "还没有呢。"
        },
        {
          "role": "阿托斯",
          "text": "有一条是关于不幸身亡的老年人的，据说他在无人监护的情况下遇到了强盗，因此不慎摔下山崖，跌死了。"
        },
        {
          "role": "莫蒂西娅",
          "text": "是吗？那太凄惨了。"
        },
        {
          "role": "阿托斯",
          "text": "还有一条是关于一位不幸溺死的商人的，他好像是酒喝多了，晕晕乎乎地走到了湖里，就这么淹死了。"
        },
        {
          "role": "莫蒂西娅",
          "text": "啊，我的天，太不幸了。"
        },
        {
          "role": "阿托斯",
          "text": "最后一条最有趣，是一位爱多管闲事的老好人，唉，他不小心吃错了药。"
        },
        {
          "role": "阿托斯",
          "text": "把毒药当成了治病的药，就这么吃了下去，结果死得极其痛苦。"
        },
        {
          "role": "莫蒂西娅",
          "text": "我的天，人的死法可真多，再给我讲讲吧。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "…对不起，对不起，我不会再这么做了。"
        },
        {
          "role": "莫蒂西娅",
          "text": "爸爸在说什么呢？我们才没有怪你的意思，不过你跑了这一会儿，应该很累了。"
        },
        {
          "role": "莫蒂西娅",
          "text": "阿托斯，我们回去一起读报给爸爸听吧，爸爸不是订了很多报纸吗？"
        },
        {
          "role": "阿托斯",
          "text": "是啊，聊得够多了，该回去了。"
        },
        {
          "role": "莫蒂西娅",
          "text": "我们回去吧，亲爱的爸爸。"
        },
        {
          "type": "subtitle",
          "text": "和派蒙商量"
        },
        {
          "role": "派蒙",
          "text": "太不对劲了，太不对劲了，连我都能看出来不对劲了。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你脑子好，你说接下来怎么办？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "伯努瓦想求救却又说别救他…",
              "dialogues": []
            },
            {
              "text": "这对夫妻可能来自灰河…",
              "dialogues": []
            },
            {
              "text": "看他们的反应，可能另有隐情…",
              "dialogues": []
            },
            {
              "text": "我有一些推测，尽管缺少证据。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那我们再去伯努瓦家附近看看？他家后窗那里不是有一个奇怪的箱子吗？"
        },
        {
          "role": "派蒙",
          "text": "那里面一定藏了什么东西，说不定能证明你的推测。"
        },
        {
          "type": "subtitle",
          "text": "前往调查奇怪的箱子"
        },
        {
          "type": "subtitle",
          "text": "前往调查奇怪的箱子"
        },
        {
          "role": "阿托斯",
          "text": "我想按照你们的执着程度，应该不会就这么回去。"
        },
        {
          "role": "阿托斯",
          "text": "我还以为你们会直接报告执律庭，结果没有，看来你们有些自己的想法啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们为什么要困住伯努瓦？",
              "dialogues": []
            },
            {
              "text": "伯努瓦到底和你们有什么关系？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿托斯",
          "text": "说实话，我已经有点佩服你们了。如果把这股劲头用对地方，你们可能会成为相当了不起的人。"
        },
        {
          "role": "阿托斯",
          "text": "只可惜，这件事上不行。唉，你们真是不怕死啊。"
        },
        {
          "role": "旅行者",
          "text": "你吓错人了。"
        },
        {
          "role": "阿托斯",
          "text": "哦？是因为完全没有弄清楚自己身处的状况，还是因为自以为在执行正义呢？"
        },
        {
          "role": "阿托斯",
          "text": "说起来刚才那条新闻提到的溺死的商人，他叫布拉德特。嗯，是一个极其能说会道的家伙。"
        },
        {
          "role": "阿托斯",
          "text": "你知道吗？新闻上说他其实不是溺死的，而是被人谋杀之后再沉湖的。"
        },
        {
          "role": "阿托斯",
          "text": "逐影庭的人调查了半天，只查出来他是被人谋杀的，谋杀他的人罪该万死这样的结果。"
        },
        {
          "role": "阿托斯",
          "text": "于是新闻报道就也这样写，实际情况到底怎么样，是杀人者更该死，还是他本人更该死呢？"
        },
        {
          "role": "阿托斯",
          "text": "嗯…这是个复杂的问题，我暂时还没有想出答案。"
        },
        {
          "role": "阿托斯",
          "text": "哦，扯远了，这跟我们要聊的事情没什么关系。"
        },
        {
          "role": "派蒙",
          "text": "你到底想说什么啊？"
        },
        {
          "role": "阿托斯",
          "text": "我想说的是，在没有全然了解一件事之前，就贸然行动是愚蠢的，可能招致恶果。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "对不正义的事无动于衷才愚蠢。",
              "dialogues": []
            },
            {
              "text": "面对不正义的事我会积极行动。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿托斯",
          "text": "哈哈，如果是在不同的场合下相遇，我们说不定能成为朋友。"
        },
        {
          "role": "阿托斯",
          "text": "虽然你的想法合我胃口，但我有我要做的事。"
        },
        {
          "role": "阿托斯",
          "text": "这是我最后的耐心了，下一次再让我看到你们在我家附近转悠，我一定会动手。"
        },
        {
          "role": "？？？",
          "text": "阿托斯撂下了一些莫名其妙的话之后，离开了这里。"
        },
        {
          "role": "？？？",
          "text": "他离奇的态度让你觉得意外，你正思索在这件事里，自己究竟该持何种立场…"
        },
        {
          "role": "？？？",
          "text": "后窗传来轻轻的敲击玻璃声，随着极轻的一声「吱呀」，一张纸条被从后窗丢了出来…"
        },
        {
          "role": "？？？",
          "text": "纸条上有褐色的字迹，似乎是在十分仓促的情况下，蘸着咖啡写出来的…"
        },
        {
          "role": "派蒙",
          "text": "快看看，上面写了什么？"
        },
        {
          "role": "派蒙",
          "text": "是伯努瓦！"
        },
        {
          "role": "旅行者",
          "text": "嘘。"
        },
        {
          "role": "派蒙",
          "text": "…对不起，总之我们小心留意猫食盆，等他的讯号吧。"
        }
      ]
    }
  ]
}