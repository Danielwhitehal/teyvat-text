{
  "quest_id": 70506,
  "chapter_num": null,
  "chapter_title": "蒲公英、蔷薇、风车菊",
  "type": "wq",
  "route": "Dandelion, Rose, and Windwheel Aster",
  "stories": [
    {
      "story_id": 70506,
      "title": "蒲公英、蔷薇、风车菊",
      "description": "「就连那位琴团长都去酒馆了？到底发生了什么事？」「慌什么，那可是琴团长。再说，真要有大事就不会去酒馆了。」",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与丽莎和琴对话",
          "narration": true
        },
        {
          "role": "琴",
          "text": "虽然很少会在这种地方见面，但我此刻的心情和丽莎是一样的。"
        },
        {
          "role": "丽莎",
          "text": "欸，怎么能叫「这种地方」呢？酒馆明明是娱乐休闲的好去处。"
        },
        {
          "role": "丽莎",
          "text": "你一定想不到，我可是费尽力气劝了半天，才把这位大忙人从她那把椅子上请起来。"
        },
        {
          "role": "丽莎",
          "text": "才到这里坐了没多久，琴那张脸上呀，又写满了担忧…"
        },
        {
          "role": "琴",
          "text": "丽莎…"
        },
        {
          "role": "旅行者",
          "text": "毕竟骑士团事务繁多…"
        },
        {
          "role": "派蒙",
          "text": "是啊，琴团长是代理团长嘛，当然会挂念团里的事啦！"
        },
        {
          "role": "派蒙",
          "text": "不过那句话怎么说的来着…「来都来了！」"
        },
        {
          "role": "派蒙",
          "text": "让她为你们调两杯好喝的吧，喝完就开心了！"
        },
        {
          "role": "旅行者",
          "text": "就当换换心情。"
        },
        {
          "role": "丽莎",
          "text": "唉，需要学会放松的，就只有琴啦。"
        },
        {
          "role": "丽莎",
          "text": "小可爱，麻烦给我一杯情诗吧，中杯，要甜一点。"
        },
        {
          "role": "丽莎",
          "text": "琴呢？来点什么？"
        },
        {
          "role": "琴",
          "text": "我的话…咖啡就好，也要中杯。"
        },
        {
          "role": "派蒙",
          "text": "琴团长平时咖啡喝得够多了吧，要不要换点别的口味？"
        },
        {
          "role": "琴",
          "text": "谢谢你，不过，我还是想喝点提神的…"
        },
        {
          "role": "旅行者",
          "text": "明白了，请稍等片刻。"
        },
        {
          "role": "琴",
          "text": "嗯，辛苦你了。"
        },
         {
          "type": "subtitle",
          "text": "为丽莎和琴调制饮品"
        },
        {
          "role": "琴",
          "text": "咖啡非常醇厚，苦味也恰到好处。"
        },
        {
          "role": "旅行者",
          "text": "两位满意就好。"
        },
        {
          "role": "琴",
          "text": "…丽莎会那样说，其实我也明白。"
        },
        {
          "role": "丽莎",
          "text": "哦？"
        },
        {
          "role": "琴",
          "text": "最近我常常反思自己的不足。工作效率也好，办事手腕也好…各方面都有提升空间。"
        },
        {
          "role": "琴",
          "text": "看来我身上这份压力，已经在不知不觉中扩散给丽莎了吧…"
        },
        {
          "role": "旅行者",
          "text": "这不完全没明白吗…"
        },
        {
          "role": "琴",
          "text": "欸？"
        },
        {
          "role": "丽莎",
          "text": "是啊。喏，小可爱一眼就看出来了。"
        },
        {
          "role": "丽莎",
          "text": "我是看你太过操劳，想带你品品酒，喝喝茶"
        },
        {
          "role": "丽莎",
          "text": "结果来到酒馆，你还满心想着工作，这才有些失落的。"
        },
        {
          "role": "丽莎",
          "text": "总像这样紧绷神经，早晚会累趴下的啦。"
        },
        {
          "role": "旅行者",
          "text": "没错。"
        },
        {
          "role": "琴",
          "text": "旅行者，连你也这样想吗？"
        },
        {
          "role": "琴",
          "text": "唔，所以说…学会休息，对我来说才是最大的挑战吗？"
        },
        {
          "role": "旅行者",
          "text": "借一句璃月俗语：「张弛有度」。"
        },
        {
          "role": "派蒙",
          "text": "嗯！该工作的时候工作，该休息的时候休息。简单来说，就是你们俩加一加再除以二啦！"
        },
        {
          "role": "旅行者",
          "text": "好怪的说法…"
        },
        {
          "role": "丽莎",
          "text": "噗…"
        },
        {
          "role": "琴",
          "text": "我，我明白了…"
        },
        {
          "role": "琴",
          "text": "谢谢你们。没想到来这里除了喝饮品，还能让心情轻松不少。这就是丽莎和凯亚喜欢酒馆的原因吗？"
        },
        {
          "role": "丽莎",
          "text": "是，也不全是。更重要的还要看调酒的是谁。"
        },
        {
          "role": "丽莎",
          "text": "今天也是托小可爱的福才能说动琴，你可真有口才。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：这没什么。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "呵呵，那我们就先告辞了。"
                }
              ]
            },
            {
              "text": "能帮到你们就好。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "呵呵，那我们就先告辞了。"
                }
              ]
            }
          ]
        },
        {
          "role": "琴",
          "text": "今后有机会的话，我也会考虑再来这里放松一下的。"
        },
        {
          "role": "派蒙",
          "text": "好耶，两位慢走！"
        }
      ]
    }
  ]
}