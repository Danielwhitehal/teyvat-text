{
  "quest_id": 70532,
  "chapter_num": null,
  "chapter_title": "零时召唤",
  "type": "wq",
  "route": "Zero Hour Invokation",
  "stories": [
    {
      "story_id": 70532,
      "title": "零时召唤",
      "description": "蒙德城的弗丽德似乎有话想和你说…",
      "dialogues": [
        {
          "role": "弗丽德",
          "text": "嗯…还要加入这张牌…咦？还有几张牌呢…"
        },
        {
          "role": "弗丽德",
          "text": "咦？旅行者！抱歉抱歉，我刚才在想牌组的事，没注意到你过来了…"
        },
        {
          "role": "弗丽德",
          "text": "我是由冒险家协会委派来协办「召唤王大奖赛」的冒险家，我这边负责的是…嗯…一种有着特殊规则的卡牌对决！"
        },
        {
          "role": "弗丽德",
          "text": "我们把它取名为「零时召唤」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "结果就是普通的打牌吗…",
              "dialogues": []
            },
            {
              "text": "和「召唤王大奖赛」的感觉一样嘛…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "弗丽德",
          "text": "不不不，我们「零时召唤」属于坊间比赛，有一套特别的规则。"
        },
        {
          "role": "弗丽德",
          "text": "简单来说就是，参赛者不能使用自己收藏的卡牌，而是要从我们已经准备好的八套不完整卡牌组中挑选三套，组成一套完整的牌组。"
        },
        {
          "role": "弗丽德",
          "text": "在这三组套牌中，还有一些刚刚推出的全新卡牌，至于如何使用它们…就看你打牌的本事了。"
        },
        {
          "role": "弗丽德",
          "text": "除了这些之外，其他的规则就和正常的对局没什么区别啦。"
        },
        {
          "role": "弗丽德",
          "text": "要是你觉得自己没有什么靠谱的组牌思路，我们也可以帮你组建牌组…"
        },
        {
          "role": "弗丽德",
          "text": "但是组出来的牌组究竟好不好用嘛…嘿嘿，那就不知道了。"
        },
        {
          "role": "弗丽德",
          "text": "总之，我的建议还是由你自己来挑选并组建牌组啦，毕竟你可是要拿着这套牌去和人对决的。"
        },
        {
          "role": "弗丽德",
          "text": "如果您对自己的实力有信心，甚至可以去其他的「召唤王大奖赛」举办区域，继续玩「零时召唤」。"
        },
        {
          "role": "弗丽德",
          "text": "啊，当然啦，你也不用有什么心理负担，只要参加「零时召唤」，无论对局的结果是胜是负，我们都有好礼相赠。"
        },
        {
          "role": "弗丽德",
          "text": "旅行者，要是你有兴趣的话，就来体验一下吧。"
        },
        {
          "type": "subtitle",
          "text": "再次与弗丽德对话"
        },
        {
          "role": "弗丽德",
          "text": "旅行者，你是想来体验一下「零时召唤」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要玩玩看。",
              "dialogues": [
                {
                  "role": "弗丽德",
                  "text": "没问题，那就请你挑选想要使用的卡牌吧。"
                },
                {
                  "role": "弗丽德",
                  "text": "喔！还有你的决斗对手，我看看啊…不少牌手都用代名来参加比赛，这些代名都有些不好记…"
                },
                {
                  "role": "弗丽德",
                  "text": "有了，你的决斗对手是…「快乐小火把」，等你准备好了之后，就直接开始对局吧。"
                },
                {
                  "type": "subtitle",
                  "text": "「快乐小火把」接受了挑战，来到了牌桌前…",
                  "narration": true,
                  "color": "描述"
                },
                {
                  "role": "安柏",
                  "text": "原来对手是你呀！这次可是正经比赛了，我们分个胜负吧！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "进行「七圣召唤」的对局吧。",
                      "dialogues": [
                        {
                          "type": "subtitle",
                          "text": "（进入对局）",
                          "narration": true
                        }
                      ]
                    },
                    {
                      "text": "暂时有别的事…",
                      "dialogues": [
                        {
                          "role": "安柏",
                          "text": "嗯！我等会还要再研究一下牌组，实在不行…我再找人请教一下…"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "还有别的事…",
              "dialogues": [
                {
                  "role": "弗丽德",
                  "text": "没关系，没关系。「零时召唤」又不是举办个一两天就结束了。"
                },
                {
                  "role": "弗丽德",
                  "text": "在「召唤王大奖赛」期间，你随时都可以过来体验「零时召唤」。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外收录 与安柏的对局"
        },
        {
          "type": "subtitle",
          "text": "击败安柏的一个角色",
          "narration": true
        },
        {
          "role": "安柏",
          "text": "咦？！不对不对！"
        },
        {
          "type": "subtitle",
          "text": "再击败安柏的一个角色",
          "narration": true
        },
        {
          "role": "安柏",
          "text": "思路乱七八糟的了…"
        },
        {
          "type": "subtitle",
          "text": "我方被击败一个角色",
          "narration": true
        },
        {
          "role": "安柏",
          "text": "我可是好好练习过了。"
        },
        {
          "type": "subtitle",
          "text": "安柏使用元素爆发技能",
          "narration": true
        },
        {
          "role": "安柏",
          "text": "用这个决胜吧！"
        },
        {
          "type": "subtitle",
          "text": "对局胜利",
          "narration": true
        },
        {
          "role": "安柏",
          "text": "呜哇…你怎么比其他人厉害这么多…"
        },
        {
          "type": "subtitle",
          "text": "对局失败",
          "narration": true
        },
        {
          "role": "安柏",
          "text": "哼哼，这一局是我赢了。"
        }
      ],
