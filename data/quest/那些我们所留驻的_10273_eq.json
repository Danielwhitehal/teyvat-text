{
  "quest_id": 10273,
  "chapter_num": "映夏！归乡？千灵节！ 第三幕",
  "chapter_title": "那些我们所留驻的",
  "type": "eq",
  "route": "Those We Have Kept",
  "stories": [
    {
      "story_id": 40246,
      "title": "那些我们所留驻的",
      "description": "获得了「第二次出生」的她，会想要做些什么呢…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至一天后早上（8~10点）"
        },
        {
          "role": "派蒙",
          "text": "到了和桑多涅约好的时间呢，不知道茜特菈莉有没有找到她需要的位置呢？"
        },
        {
          "role": "派蒙",
          "text": "不管怎样，我们先去和她们见面吧！希望事情能顺利解决！"
        },
        {
          "type": "subtitle",
          "text": "前往维恩歌莱号甲板"
        },
        {
          "role": "派蒙",
          "text": "昨天茜特菈莉喝得还挺多，也不知道她现在醒没醒…"
        },
        {
          "role": "哥伦比娅",
          "text": "早上好。"
        },
        {
          "role": "派蒙",
          "text": "呃啊！哥伦比娅！你…你怎么在这里？不对，你怎么老是喜欢从人背后出现啦！"
        },
        {
          "role": "哥伦比娅",
          "text": "今早和大家一起来这边补个镜头，刚刚拍完。我就先到甲板上来透透气。"
        },
        {
          "role": "哥伦比娅",
          "text": "其他人好像还在下面讨论有关「最后一幕」的事情。"
        },
        {
          "role": "派蒙",
          "text": "最后一幕？"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，就是这部映影的结尾。大家在烦恼故事中的女主角最终有没有找到自己曾经的朋友。"
        },
        {
          "role": "派蒙",
          "text": "啊…这两天做别的事情都快忙忘了，这部艺术片的确是以主角发现友人不见了，所以回到她故乡为背景的呢。"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，芙宁娜导演和千织小姐认为，从故事韵味上来说，最终二人没有相见的悲剧式结尾会更加令人惋惜。"
        },
        {
          "role": "哥伦比娅",
          "text": "泽维尔导演则认为，相见的结局更加令人感动，治愈人心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哥伦比娅怎么想？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "我吗？我…我不知道…"
        },
        {
          "role": "哥伦比娅",
          "text": "如果是「我」的话，我当然想和她见面…多希望她真的还能和我见面…哪怕是在映影中。"
        },
        {
          "role": "哥伦比娅",
          "text": "但想到这样意味着要让另一个人来演绎她，我心中又有些…"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "先别担心这些。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "嗯？"
        },
        {
          "role": "派蒙",
          "text": "对啊对啊，别因为这个就愁眉苦脸的。映影就应该享受地去拍才对！"
        },
        {
          "role": "派蒙",
          "text": "而且…我，我敢向哥伦比娅保证！事情一定会顺利的！"
        },
        {
          "role": "哥伦比娅",
          "text": "顺利？指的是…？"
        },
        {
          "role": "派蒙",
          "text": "呃，就…就是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一定会是个好结局。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！就是这个意思！"
        },
        {
          "role": "哥伦比娅",
          "text": "哈…好吧。我相信你们。"
        },
        {
          "role": "哥伦比娅",
          "text": "那就像你们说的，先享受拍戏的过程吧。"
        },
        {
          "role": "芙宁娜",
          "text": "哟？这不是旅行者和派蒙吗？"
        },
        {
          "role": "千织",
          "text": "哟？这不是翘班的灯光师和场记吗？"
        },
        {
          "role": "派蒙",
          "text": "呃…抱歉…这次拍摄我们请假是有些频繁。"
        },
        {
          "role": "千织",
          "text": "呵呵，开个玩笑。别往心里去。我们这次拍摄挺顺利的，你们先安心忙自己的事就好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感谢各位理解…",
              "dialogues": []
            },
            {
              "text": "之后一定补偿…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芙宁娜",
          "text": "咦？哥伦比娅小姐似乎心情好了不少。啊，抱歉，是我们刚才讨论结局的话题让你为难了吧…"
        },
        {
          "role": "哥伦比娅",
          "text": "没关系，我现在没事了。旅行者和派蒙已经帮我想通了。"
        },
        {
          "role": "芙宁娜",
          "text": "哦？那是想拍个相见的结局还是不相见的结局？"
        },
        {
          "role": "哥伦比娅",
          "text": "拍个好结局。"
        },
        {
          "role": "芙宁娜",
          "text": "…啊？"
        },
        {
          "type": "subtitle",
          "text": "与茜特菈莉对话"
        },
        {
          "role": "派蒙",
          "text": "茜特菈莉，我们来啦！"
        },
        {
          "role": "茜特菈莉",
          "text": "哟。挺准时嘛。"
        },
        {
          "role": "派蒙",
          "text": "你才是…昨天喝那么多没关系吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "呵？你是小瞧奶奶我了？就那点可醉不倒我。"
        },
        {
          "role": "派蒙",
          "text": "可你后来都开始说胡话了…"
        },
        {
          "role": "茜特菈莉",
          "text": "有…有吗？我怎么不记得？我没说什么…了不得的事吧？"
        },
        {
          "role": "派蒙",
          "text": "骂孙子骂了半小时、抱怨烟谜主工作抱怨了半小时、分享轻小说分享了一小时…还有…呃，好像后面我也睡着了。"
        },
        {
          "role": "「木偶」",
          "text": "…她们走了吗？"
        },
        {
          "role": "派蒙",
          "text": "她们？哦，是说剧组吧。已经走了，我们刚好在甲板碰上。"
        },
        {
          "role": "派蒙",
          "text": "不过，既然你都解决了自己的问题，为什么还不去见哥伦比娅呢？她明明很想见你。"
        },
        {
          "role": "「木偶」",
          "text": "我…我想先处理完手上这烂摊子再去见她。再说了，这么好一个吓她一跳的机会，我肯定得多计划计划呀！"
        },
        {
          "role": "「木偶」",
          "text": "不说这个了。那个污秽聚合体的位置找到了吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "当然，黑曜石奶奶我说办得到就办得到。"
        },
        {
          "role": "「木偶」",
          "text": "辛苦了。我看看…"
        },
        {
          "role": "「木偶」",
          "text": "莫尔泰区…嗯？这不是格式塔吗？"
        },
        {
          "role": "「木偶」",
          "text": "果然还是对自己灵魂被切割时的地方怨意最深吗？还是说，这是对「水仙十字」的怨意…"
        },
        {
          "role": "茜特菈莉",
          "text": "我陪你们一起去吧，这东西的出现地点其实不算很固定，如果它不在那儿的话，我也有办法用某种仪式把它招过来。"
        },
        {
          "role": "「木偶」",
          "text": "真的吗？但这件事已经给你添了很多麻烦…"
        },
        {
          "role": "茜特菈莉",
          "text": "别客气，这老骨头闲着也是闲着，帮小年轻招个魂什么的还累不到我。"
        },
        {
          "role": "茜特菈莉",
          "text": "（我不去的话谁知道你们又会聊出什么我参与不了的话题？！）"
        },
        {
          "role": "「木偶」",
          "text": "好吧，那就辛苦你了。谢谢。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，那么事不宜迟，我们这就出发吧！"
        },
        {
          "type": "subtitle",
          "text": "检查格式塔内的空间"
        },
        {
          "role": "「木偶」",
          "text": "看来是不在呢…"
        },
        {
          "role": "茜特菈莉",
          "text": "要我现在开始举行仪式吗？"
        },
        {
          "role": "「木偶」",
          "text": "先等等，我们把这层格式塔的水排空吧。这样更容易行动。"
        },
        {
          "role": "派蒙",
          "text": "这水还能排走？"
        },
        {
          "role": "「木偶」",
          "text": "当然可以。在阿兰和雷内不约而同观测到枫丹命运之后，二人就曾分享过一些建筑防水的方法。原理是…"
        },
        {
          "role": "「木偶」",
          "text": "咳咳，跑题了。总之你们照我说的，按顺序解开几个机关就行。"
        },
        {
          "type": "subtitle",
          "text": "排空格式塔内的水"
        },
        {
          "type": "subtitle",
          "text": "等待茜特菈莉的仪式"
        },
        {
          "role": "茜特菈莉",
          "text": "准备好了吗？"
        },
        {
          "role": "「木偶」",
          "text": "嗯。我会先尝试着和他们沟通两句。"
        },
        {
          "role": "「木偶」",
          "text": "但这些灵魂的聚合体恐怕已经失去了理智，如果无法沟通，事态很可能演变为一场战斗。"
        },
        {
          "role": "派蒙",
          "text": "好，假如变成了最坏的情况，我会找个地方好好躲着的。"
        },
        {
          "role": "「木偶」",
          "text": "嗯，真打起来的话，最后一击让我来，你们不要出手。相信我。"
        },
        {
          "role": "茜特菈莉",
          "text": "明白了。"
        },
        {
          "role": "茜特菈莉",
          "text": "好了，你们安静点。"
        },
        {
          "role": "茜特菈莉",
          "text": "…随潮汐飘摇的游魂，我呼唤你们。被分离、被遗弃、被迫沉默的碎魂啊，循着旧日的气息归来吧。"
        },
        {
          "role": "茜特菈莉",
          "text": "…让失名的怨恨彼此识别，让禁秽的恶质相互吸引，在此，重新聚合成形！"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "「木偶」",
          "text": "（…然后呢？这就结束了？）"
        },
        {
          "role": "「木偶」",
          "text": "（啊…所以我才对付不来这些魔法秘术什么的…根本不知道算法进展到了哪一步，术式逻辑也看不通透。）"
        },
        {
          "role": "「木偶」",
          "text": "（和我熟知的机械科学完全…）"
        },
        {
          "role": "「木偶」",
          "text": "……！"
        },
        {
          "role": "茜特菈莉",
          "text": "当心！"
        },
        {
          "role": "「游魂的怨意」",
          "text": "——！"
        },
        {
          "role": "「木偶」",
          "text": "那边的人，或者说里面的人，能听懂我说话吗？"
        },
        {
          "role": "「木偶」",
          "text": "我是枫丹「奇械公」，阿兰·吉约丹的后人。我有办法帮你们恢复原样，回归地脉。只需要你们稍微配合…"
        },
        {
          "role": "「游魂的怨意」",
          "text": "——！"
        },
        {
          "role": "派蒙",
          "text": "桑多涅！"
        },
        {
          "role": "「木偶」",
          "text": "嘁…这架势，看来是怎么都劝不动了啊。"
        },
        {
          "role": "「木偶」",
          "text": "好吧。那就陪你们发泄发泄。"
        },
        {
          "type": "subtitle",
          "text": "击败敌人"
        },
        {
          "role": "「游魂的怨意」",
          "text": "该死的…「水仙十字」！"
        },
        {
          "role": "「游魂的怨意」",
          "text": "该死的…雷内！雅各布！"
        },
        {
          "role": "「木偶」",
          "text": "你们跟我骂也没用。我和他们不——熟——！"
        },
        {
          "role": "「游魂的怨意」",
          "text": "——！"
        },
        {
          "role": "「游魂的怨意」",
          "text": "去死…都给我去死——！"
        },
        {
          "role": "「木偶」",
          "text": "他们没几个活着了，但你们还有机会回归地脉，和家人团聚！"
        },
        {
          "role": "「木偶」",
          "text": "给我…配合一点啊！"
        },
        {
          "type": "subtitle",
          "text": "借助着「数秘阵列」反向运算「世界式」，桑多涅剥离了「怨意」内的污秽与邪念，让众多无家的灵魂重归清净，使他们获得了安眠。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "[https://www.bilibili.com/video/BV1NUMg6fEt3 过场动画「安眠于众水」]"
        },
        {
          "role": "「游魂的怨意」",
          "text": "雅各布、雷内！该死的「水仙十字」！"
        },
        {
          "role": "「游魂的怨意」",
          "text": "还有…你！！"
        },
        {
          "role": "「木偶」",
          "text": "说了我和他们不一样"
        },
        {
          "role": "「木偶」",
          "text": "我比他们更厉害"
        },
        {
          "role": "「木偶」",
          "text": "世界式·反转——「归约」"
        },
        {
          "role": "「木偶」",
          "text": "安眠于众水吧"
        },
        {
          "role": "「木偶」",
          "text": "无家的灵魂们"
        },
        {
          "role": "派蒙",
          "text": "这样就…结束了吗？"
        },
        {
          "role": "「木偶」",
          "text": "结束了。说了这是很简单的事。"
        },
        {
          "role": "茜特菈莉",
          "text": "你是怎么做到的？"
        },
        {
          "role": "「木偶」",
          "text": "那个怨意的集合体，不过是众多无家灵魂聚合在一起的产物。其中混杂着许多污秽与邪念。"
        },
        {
          "role": "「木偶」",
          "text": "我不过是将它们最原本的灵魂与污秽分离，让它们得以被现在的世界规则容纳罢了。"
        },
        {
          "role": "「木偶」",
          "text": "「世界式」的原理是「发散」。从一个原点出发，解构与重组世界的可能性，从中寻找答案。"
        },
        {
          "role": "「木偶」",
          "text": "而利用「数秘阵列」反向运算「世界式」，就能达到归拢收束与还原的功能。即术式的反转。"
        },
        {
          "role": "「木偶」",
          "text": "这类似数理中的同调归约，在不改变群体本质的情况下，将他们还原为更简单和实质性的存在。"
        },
        {
          "role": "「木偶」",
          "text": "所以…呃，算了。看你们的样子也不是真的想搞明白这些…"
        },
        {
          "role": "茜特菈莉",
          "text": "我好像理解外地人听烟谜主萨满讲东西是什么感觉了。"
        },
        {
          "role": "派蒙",
          "text": "总…总之我知道很了不起就对了！你果然很厉害呢！桑多涅。"
        },
        {
          "role": "「木偶」",
          "text": "笑话，我一直很厉害！哈哈哈。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不愧是析构万理的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「木偶」",
          "text": "这个就算了！！"
        },
        {
          "role": "「木偶」",
          "text": "差…差不多该走了！我去把格式塔内部的机关还原一下。我们岸上见！"
        },
        {
          "type": "subtitle",
          "text": "离开格式塔"
        },
        {
          "role": "「木偶」",
          "text": "好了好了！过去的烂摊子总算收拾完了。真是浑身都轻松了不少。"
        },
        {
          "role": "「木偶」",
          "text": "偶尔这么做一件好事，还挺开心的嘛。"
        },
        {
          "role": "派蒙",
          "text": "你在挪德卡莱也帮了朋友们很多忙啦，明明一直都很好！"
        },
        {
          "role": "「木偶」",
          "text": "呵，这可说不好。我之后可是要回愚人众的，你们这么相信别人真的好吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "至少桑多涅可以相信。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「木偶」",
          "text": "哼，到时候吃了苦头可别怪我没提醒过你们。"
        },
        {
          "role": "茜特菈莉",
          "text": "我们接下来去哪儿？回船上吗？"
        },
        {
          "role": "派蒙",
          "text": "对啊，桑多涅你自己的事也解决完了，过去的事也解决完了。是时候让朋友们知道你没事了吧。"
        },
        {
          "role": "派蒙",
          "text": "大家见你回来，一定会很高兴的！"
        },
        {
          "role": "「木偶」",
          "text": "哈…换作以前，我恐怕绝对不会承认，不过…嗯，我的确也想大家了。"
        },
        {
          "role": "「木偶」",
          "text": "但哥伦比娅是个例外！这次我一定要把她老是来烦我的仇给报了！"
        },
        {
          "type": "subtitle",
          "text": "桑多涅被传入了一个未知的空间，见到了对她的归来感到难以置信的哥伦比娅。最终，桑多涅主动拥抱了这位久别重逢的挚友，而在下一刹那，她们又再次回到了映影的拍摄现场…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "[https://www.bilibili.com/video/BV1JvME66Eej 过场动画「若我们再次相见」]"
        },
        {
          "role": "「木偶」",
          "text": "那家伙感官很敏锐"
        },
        {
          "role": "「木偶」",
          "text": "要怎么才能吓到…"
        },
        {
          "role": "哥伦比娅",
          "text": "…桑多涅？"
        },
        {
          "role": "哥伦比娅",
          "text": "真的是你吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "为什么不告诉我你回来了？"
        },
        {
          "role": "哥伦比娅",
          "text": "为什么要躲着我？"
        },
        {
          "role": "哥伦比娅",
          "text": "我还……"
        },
        {
          "role": "哥伦比娅",
          "text": "…桑多涅？"
        },
        {
          "role": "「木偶」",
          "text": "哼"
        },
        {
          "role": "「木偶」",
          "text": "这样就扯平了"
        },
        {
          "role": "哥伦比娅",
          "text": "我好想你"
        },
        {
          "role": "哥伦比娅",
          "text": "桑多涅"
        },
        {
          "role": "「木偶」",
          "text": "哼"
        },
        {
          "role": "「木偶」",
          "text": "我才没有想你呢"
        },
        {
          "role": "「木偶」",
          "text": "笨蛋"
        },
        {
          "role": "「木偶」",
          "text": "我回来了"
        },
        {
          "role": "「木偶」",
          "text": "哥伦比娅"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯…"
        },
        {
          "role": "哥伦比娅",
          "text": "……"
        },
        {
          "role": "哥伦比娅",
          "text": "唔，桑多涅…"
        },
        {
          "role": "「木偶」",
          "text": "闭嘴。早就说过不许把我随便传到奇奇怪怪的地方。"
        },
        {
          "role": "哥伦比娅",
          "text": "可…可是…"
        },
        {
          "role": "泽维尔",
          "text": "哦！太棒了！简直太棒了！这就是我想要的结局！我想要的画面！"
        },
        {
          "role": "「木偶」",
          "text": "…哈？！！"
        },
        {
          "role": "芙宁娜",
          "text": "你刚才去哪儿了？哥伦比娅小姐。怎么一转眼就从片场消失，又突然…呃，和这位小姐一起出现。拥抱着。"
        },
        {
          "role": "「木偶」",
          "text": "你…你们刚才…在拍…拍…"
        },
        {
          "role": "千织",
          "text": "事情发生得太突然，留影机一直在运转，刚才的画面也拍下了。"
        },
        {
          "role": "芙宁娜",
          "text": "这位难道就是…"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，她就是我最好的朋友。没想到真的能和她再次相见。我好高兴。"
        },
        {
          "role": "哥伦比娅",
          "text": "看来，这部映影有了个好结局呢。桑多涅。"
        },
        {
          "role": "哥伦比娅",
          "text": "…桑多涅？"
        },
        {
          "role": "「木偶」",
          "text": "果然…果然我还是觉得你好烦人啊！！哥·伦·比·娅！！！"
        }
      ],
