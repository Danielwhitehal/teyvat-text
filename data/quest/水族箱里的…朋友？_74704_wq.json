{
  "quest_id": 74704,
  "chapter_num": null,
  "chapter_title": "水族箱里的…朋友？",
  "type": "wq",
  "route": "Friends... In the Aquarium?",
  "stories": [
    {
      "story_id": 74704,
      "title": "水族箱里的…朋友？",
      "description": "哥伦比娅似乎在欣赏水族箱…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往水族箱附近…"
        },
        {
          "role": "派蒙",
          "text": "嗨！哥伦比娅。在欣赏水族箱里的鱼吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，你们把这里装点得很漂亮。有很多我以前没见过的鱼。"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅以前去过水族馆吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "没有，水族箱倒是在至冬见过几个。但我以前没睁眼，也不算是真正的「欣赏」吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "现在感觉怎么样？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "很美。水下的风景原来这么艳丽多彩，就好像大家永远生活在繁花盛开的春天一样。"
        },
        {
          "role": "哥伦比娅",
          "text": "啊，你看那条鱼。上次就觉得它和桑多涅真像。还有那两条，一直互相跟随着对方行动，就像你们一样呢。"
        },
        {
          "role": "派蒙",
          "text": "真的欸！你这么一说还真是。"
        },
        {
          "role": "哥伦比娅",
          "text": "那条一直很忙的像菈乌玛。那边在珊瑚间很警觉的又像奈芙尔小姐。"
        },
        {
          "role": "派蒙",
          "text": "呃…难道说哥伦比娅看鱼的时候，喜欢去找它们和哪个朋友相似？"
        },
        {
          "role": "哥伦比娅",
          "text": "有些不太准确。更多是我喜欢朋友们，所以总是会在生活中不知不觉想起大家。看鱼的时候也是。"
        },
        {
          "role": "派蒙",
          "text": "哇！真高兴听你这么说。那还有什么鱼和大家比较像？"
        },
        {
          "role": "哥伦比娅",
          "text": "唔…最近交到的新朋友很多。不是每个都能找到对应的鱼儿呢。"
        },
        {
          "role": "派蒙",
          "text": "也是。不过我们也会不断丰富这些水族箱，哥伦比娅有时间可以多来看看，说不定就在里面找到其他朋友了呢？"
        },
        {
          "role": "哥伦比娅",
          "text": "朋友们会到水族箱里？"
        },
        {
          "role": "派蒙",
          "text": "是和朋友们相像的鱼啦！"
        }
      ]
    }
  ]
}