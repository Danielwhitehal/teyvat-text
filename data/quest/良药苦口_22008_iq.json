  "stories": [
    {
      "story_id": 22008,
      "title": "良药苦口",
      "description": "沉香的女儿红豆一直拒绝吃药，也许「杏仁豆腐」能让红豆听话一些…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与沉香对话"
        },
        {
          "role": "沉香",
          "text": "豆豆乖，吃了药病才能好…"
        },
        {
          "role": "红豆",
          "text": "不嘛不嘛！药太苦了，我不想吃嘛！"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "沉香",
          "text": "是旅行者吗…是这样，我家豆豆身子一直不太好，之前求着白先生给开了个方子治病。"
        },
        {
          "role": "沉香",
          "text": "可豆豆总说不卜庐的药太苦，怎么都不肯吃，唉，这世上的药哪有不苦的呢…"
        },
        {
          "role": "沉香",
          "text": "为了让这孩子吃药，我答应她，每次喝完药之后就能吃一份「杏仁豆腐」。"
        },
        {
          "role": "沉香",
          "text": "旅行者，如果您有空的话，能帮我去找份「杏仁豆腐」来吗？我还得再哄哄豆豆…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "沉香",
                  "text": "那就拜托您了，一份给豆豆吃就够了。"
                }
              ]
            },
            {
              "text": "她得了什么病？",
              "dialogues": [
                {
                  "role": "沉香",
                  "text": "唉，我也说不好，但是据白先生说，这病极难治根，但就算只治表，也要一直吃药。"
                },
                {
                  "role": "沉香",
                  "text": "说不定，豆豆将来要吃一辈子的药，她才这么小…我真是想都不敢想…"
                },
                {
                  "role": "沉香",
                  "text": "我真是恨不得是我自己得病。但是…现在我也只能盼着豆豆能少遭点罪…"
                },
                {
                  "role": "沉香",
                  "text": "旅行者，拜托您了，帮我去找份杏仁豆腐回来吧，一份就够了。"
                }
              ]
            },
            {
              "text": "豆豆，你为什么不肯吃药？",
              "dialogues": [
                {
                  "role": "红豆",
                  "text": "那药太苦了！璐璐她们的药都没这么难吃…"
                },
                {
                  "role": "沉香",
                  "text": "豆豆，璐璐她们是在做游戏呀，那些都是杏仁豆腐的糖水，不是药。"
                },
                {
                  "role": "红豆",
                  "text": "那…那我吃杏仁豆腐不能治好病吗？非得吃那么苦的药…"
                },
                {
                  "role": "沉香",
                  "text": "豆豆乖，只要病好了，以后吃什么都可以。"
                },
                {
                  "role": "红豆",
                  "text": "为什么药不能和杏仁豆腐一样，都是甜的呢，真讨厌…"
                },
                {
                  "role": "沉香",
                  "text": "这孩子真是，唉…旅行者，麻烦您了，请帮我找份杏仁豆腐来吧，一份就够了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "将杏仁豆腐带给沉香"
        },
        {
          "role": "红豆",
          "text": "呜…我不想吃药嘛…"
        },
        {
          "role": "旅行者",
          "text": "豆豆，你为什么不肯吃药？"
        },
        {
          "role": "红豆",
          "text": "那药太苦了！璐璐她们的药都没这么难吃…"
        },
        {
          "role": "沉香",
          "text": "豆豆，璐璐她们是在做游戏呀，那些都是杏仁豆腐的糖水，不是药。"
        },
        {
          "role": "红豆",
          "text": "那…那我吃杏仁豆腐不能治好病吗？非得吃那么苦的药…"
        },
        {
          "role": "沉香",
          "text": "豆豆乖，只要病好了，以后吃什么都可以。"
        },
        {
          "role": "红豆",
          "text": "为什么药不能和杏仁豆腐一样，都是甜的呢，真讨厌…"
        },
        {
          "role": "沉香",
          "text": "这孩子真是，唉…旅行者，麻烦您了，请帮我找份杏仁豆腐来吧，一份就够了。"
        },
        {
          "type": "subtitle",
          "text": "将杏仁豆腐带给沉香"
        },
        {
          "role": "沉香",
          "text": "您找到杏仁豆腐了吗？"
        },
        {
          "role": "红豆",
          "text": "不嘛，我不想吃药…"
        },
        {
          "role": "旅行者",
          "text": "吃完了药就有杏仁豆腐吃。"
        },
        {
          "role": "红豆",
          "text": "杏仁豆腐…可我还是要吃药呀…"
        },
        {
          "role": "沉香",
          "text": "豆豆乖，吃了药你的病才能好，而且，这不是有杏仁豆腐了吗？"
        },
        {
          "role": "红豆",
          "text": "呜…白术哥哥那么厉害的人，为什么不能把药做成杏仁豆腐味呢…"
        }
      ]
    }
  ]
