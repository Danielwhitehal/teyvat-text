{
  "quest_id": 10032,
  "chapter_num": "",
  "chapter_title": "清籁逐雷记",
  "type": "wq",
  "route": "Seirai Stormchasers",
  "stories": [
    {
      "story_id": 72155,
      "title": "清籁逐雷记·其一",
      "description": "从稻妻冒险家协会的凯瑟琳小姐那里，你得知稻妻冒险家协会最近正在招募冒险家前往清籁岛进行探索…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆与稻妻凯瑟琳对话"
        },
        {
          "role": "凯瑟琳",
          "text": "你好，冒险家。最近的冒险活动开展得还顺利吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还算顺利吧。",
              "dialogues": []
            },
            {
              "text": "没有我完不成的委托。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "不愧是你，保持着这种气势继续冒险，你一定会成为一名伟大的冒险家。"
        },
        {
          "role": "凯瑟琳",
          "text": "说到冒险，最近协会正在招募一批冒险家前往清籁岛探索，不知道你有没有兴趣？"
        },
        {
          "role": "旅行者",
          "text": "清籁岛？"
        },
        {
          "role": "凯瑟琳",
          "text": "嗯，是一座位于鸣神岛南面的岛屿，岛上的某些区域还一直有雷暴肆虐，所以协会的探索工作一直没法推进。"
        },
        {
          "role": "凯瑟琳",
          "text": "虽然协会也派遣了两名冒险家，悦子小姐和大祐先生常驻清籁岛，拜托他们研究平息雷暴的方法…"
        },
        {
          "role": "凯瑟琳",
          "text": "但是，他们似乎到现在也没找到什么头绪…"
        },
        {
          "role": "凯瑟琳",
          "text": "如果你有兴趣的话，就去清籁岛上去看看吧，据说，那座岛上还埋藏着很多宝藏呢。"
        },
        {
          "role": "凯瑟琳",
          "text": "但你在清籁岛探索的时候，请务必提高警惕。"
        },
        {
          "role": "凯瑟琳",
          "text": "毕竟，那种雷暴的成因，到现在协会也没有弄清。"
        },
        {
          "type": "subtitle",
          "text": "◆寻找清籁岛上的冒险家"
        },
        {
          "role": "悦子",
          "text": "这本书要用…这本书也要…还有这一本…"
        },
        {
          "role": "悦子",
          "text": "啊，你好，你是…冒险家？是来这座岛上探索的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是的。",
              "dialogues": []
            },
            {
              "text": "算是吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "悦子",
          "text": "是吗…那你可以先在这座岛的外围区域探索一下。"
        },
        {
          "role": "悦子",
          "text": "但是你可不要随便去这座岛的中央区域，那边的雷暴可不是开玩笑的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有解决办法吗？",
              "dialogues": [
                {
                  "role": "悦子",
                  "text": "暂时没有…准确地说，我连这场雷暴的成因都没弄清楚。"
                }
              ]
            },
            {
              "text": "只有那边有雷暴？",
              "dialogues": [
                {
                  "role": "悦子",
                  "text": "嗯，很奇怪对吧？简直像是…有什么东西给这场雷暴划定了范围一样。"
                }
              ]
            }
          ]
        },
        {
          "role": "悦子",
          "text": "大祐那家伙，一直说这场雷暴绝对是神明为了阻拦普通人冒犯神域而降下的。"
        },
        {
          "role": "悦子",
          "text": "最开始我也不信，不过，后来我们在清籁岛上找到了很多奇怪的石座。"
        },
        {
          "role": "悦子",
          "text": "大祐从一本典籍里查到，那种石座叫做「镇石」。"
        },
        {
          "role": "悦子",
          "text": "而且在传说里，这种石座还真是用来封印某种东西的仪式器具。"
        },
        {
          "role": "悦子",
          "text": "虽然…我们找到的那些石座都破破烂烂的，怎么看都是一副年久失修的样子…"
        },
        {
          "role": "悦子",
          "text": "唉，解这种毫无头绪的谜题真是让人烦躁…不过既然是工作，那也只能硬着头皮解解看了。"
        },
        {
          "role": "旅行者",
          "text": "那个「镇石」在哪?"
        },
        {
          "role": "悦子",
          "text": "就在不远，大祐一直留在那边研究，我是帮他回来拿资料的，如果你想过去看看的话，我带你过去就是了。"
        },
        {
          "role": "悦子",
          "text": "越快解开那个「镇石」的秘密，就能越快回协会交差了。"
        },
        {
          "role": "悦子",
          "text": "稍等一下，我把资料打包一下…"
        },
        {
          "role": "悦子",
          "text": "好了，我们出发吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往调查「镇石」"
        },
        {
          "role": "大祐",
          "text": "这封印…不对，不对…"
        },
        {
          "role": "悦子",
          "text": "大祐，我把资料给你带过来了喔。"
        },
        {
          "role": "大祐",
          "text": "奇怪，这里不应该是这种结构…"
        },
        {
          "role": "悦子",
          "text": "大祐！"
        },
        {
          "role": "大祐",
          "text": "噢！？悦、悦子小姐，别这么大声嘛，我都被你吓死了，就算我没被你吓死，你这么大声要是招来了魔物也不好啊…"
        },
        {
          "role": "悦子",
          "text": "行了！我都叫了你好多声了，是你没听见啦。"
        },
        {
          "role": "悦子",
          "text": "喏，你要的资料我都拿来了，还带来了一位冒险家。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好。",
              "dialogues": []
            },
            {
              "text": "初次见面。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "大祐",
          "text": "喔…喔！初次见面，请多指教，我的名字是大祐，是一名稻妻冒险家协会的冒险家…"
        },
        {
          "role": "悦子",
          "text": "好了，既然大家是冒险家，打招呼就不要这么麻烦了。"
        },
        {
          "role": "大祐",
          "text": "话也不能这么说，基本的礼貌还是必须要的啊。"
        },
        {
          "role": "大祐",
          "text": "毕竟大家都是在野外奔忙的冒险家，在闲下来的时候就更需要保持一个良好的心态。"
        },
        {
          "role": "悦子",
          "text": "你这家伙…我说你啊…"
        },
        {
          "role": "大祐",
          "text": "我和你之前就说过很多次了，与人交往时保持礼貌的态度就是一个良好心态的开始…"
        },
        {
          "role": "悦子",
          "text": "不说这些了！「镇石」研究得怎么样了？"
        },
        {
          "role": "大祐",
          "text": "基本上算是没进展，只找到了一些奇怪的踪迹。"
        },
        {
          "role": "旅行者",
          "text": "真是果断。"
        },
        {
          "role": "悦子",
          "text": "没进展啊…我们在这里也待了这么长时间了，要是再没有进展，我们就回协会去求援吧。"
        },
        {
          "role": "大祐",
          "text": "求、求援，那不就等于承认我们没能力完成这个委托了吗？"
        },
        {
          "role": "悦子",
          "text": "大祐，我和你说过了，我们是职业冒险家，承接的委托也是协会的工作。"
        },
        {
          "role": "悦子",
          "text": "我们的目标是完成工作，而不是证明自己。"
        },
        {
          "role": "悦子",
          "text": "如果为了证明自己而耽误了工作，那就得不偿失了。"
        },
        {
          "role": "旅行者",
          "text": "真是有职业精神啊…"
        },
        {
          "role": "悦子",
          "text": "谢谢夸奖。不过，这也只是我个人的一种工作方式而已。"
        },
        {
          "role": "悦子",
          "text": "协会里有人说我没干劲，也有人说我…只是为了工作而工作。"
        },
        {
          "role": "悦子",
          "text": "但无论他们怎么说，我在协会里完成委托的效率还是最高的。"
        },
        {
          "role": "旅行者",
          "text": "那你做冒险家的原因是…"
        },
        {
          "role": "悦子",
          "text": "工作，赚钱，仅此而已。"
        },
        {
          "role": "旅行者",
          "text": "真是单纯的目标啊…"
        },
        {
          "role": "悦子",
          "text": "不知道是不是因为我的目的这么单纯好懂，所以协会反而更愿意让我去执行各项委托。"
        },
        {
          "role": "悦子",
          "text": "不过这一次…呵呵，我好像没法独立完成委托了。"
        },
        {
          "role": "大祐",
          "text": "悦子小姐…协会都把任务派发给我们了，还请你打起精神来啊。"
        },
        {
          "role": "悦子",
          "text": "我已经打起了十分精神了，不过…没办法打起十二分。"
        },
        {
          "role": "悦子",
          "text": "好了，说说你找到的奇怪踪迹吧。"
        },
        {
          "role": "大祐",
          "text": "是一些…猫的足迹，就在这「镇石」的旁边，一直向外延伸。"
        },
        {
          "role": "悦子",
          "text": "猫的足迹…听起来和这座「镇石」没什么关系。"
        },
        {
          "role": "大祐",
          "text": "不如，我们顺着这些足迹向那边找找看…"
        },
        {
          "role": "悦子",
          "text": "嗯，确实是很奇怪的足迹…但我们现在还是先把重点集中在「镇石」上，不要再发散了。"
        },
        {
          "role": "悦子",
          "text": "等我们弄清了这座「镇石」的原理后，再顺着足迹搜索吧。"
        },
        {
          "role": "大祐",
          "text": "悦子小姐，你不会是单纯地…不想走路吧…"
        },
        {
          "role": "悦子",
          "text": "…这是一种严谨的工作方式，快点开始吧。"
        },
        {
          "role": "派蒙",
          "text": "看来，他们还是准备先研究「镇石」呢…"
        },
        {
          "role": "派蒙",
          "text": "不过，我还是很在意那些猫的足迹。"
        },
        {
          "role": "派蒙",
          "text": "那些足迹既然在「镇石」旁边出现…说不定会和「镇石」有关。"
        },
        {
          "role": "派蒙",
          "text": "嗯…我们先沿着那些足迹往前找找看吧，说不定会有什么收获呢。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "大祐",
          "text": "虽然书上说「镇石」是用于封印的仪式器具。"
        },
        {
          "role": "大祐",
          "text": "但是…这座「镇石」的形制却和书上的有些对不上…"
        },
        {
          "role": "悦子",
          "text": "唉…这种完全找不到头绪的感觉真难受…"
        },
        {
          "type": "subtitle",
          "text": "◆循着猫的足迹向前探索"
        },
        {
          "role": "派蒙",
          "text": "小猫的足迹还在往前延伸…"
        },
        {
          "role": "派蒙",
          "text": "我们继续往前吧。"
        },
        {
          "role": "派蒙",
          "text": "这是…一座神社？"
        },
        {
          "role": "派蒙",
          "text": "小猫的足迹延伸进去了，我们也进去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆探索神社"
        },
        {
          "role": "？？？",
          "text": "哈唔…终于有人类来了。"
        },
        {
          "role": "派蒙",
          "text": "猫…说说说说说话了！"
        },
        {
          "role": "？？？",
          "text": "啊呀，见到奴家就这么受宠若惊吗？"
        },
        {
          "role": "派蒙",
          "text": "只是没见过会说话的动物…"
        },
        {
          "role": "？？？",
          "text": "真是失礼，汝也是会说话的动物。"
        },
        {
          "role": "派蒙",
          "text": "派蒙才不是动物！"
        },
        {
          "role": "旅行者",
          "text": "冷静一下…"
        },
        {
          "role": "派蒙",
          "text": "哼！"
        },
        {
          "role": "派蒙",
          "text": "仔细一想，我们好像见过很多会说话的动物了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "见过会说话的龙。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？龙只是动物吗？总感觉应该有更高级、更了不起的分类吧…"
                },
                {
                  "role": "派蒙",
                  "text": "不过，特瓦林确实会说话就是了…"
                }
              ]
            },
            {
              "text": "见过会说话的蛇。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你是说璃月那条叫做「长生」的蛇吗？"
                },
                {
                  "role": "派蒙",
                  "text": "那真的不是「药材」吗…？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不过，会说话的猫还是第一次见呢…"
        },
        {
          "role": "？？？",
          "text": "放肆，奴家不是什么「会说话的猫」。"
        },
        {
          "role": "？？？",
          "text": "这里是浅濑神社，奴家是这里的「代宫司」寝子。"
        },
        {
          "role": "「寝子」",
          "text": "别的猫称呼奴家，都要加上「代宫司大人」几个字。但汝等与奴家有缘，礼节就免了。不必客气。"
        },
        {
          "role": "旅行者",
          "text": "别的猫也会说话吗？"
        },
        {
          "role": "「寝子」",
          "text": "呵呵…当然了，只不过汝等听不懂罢了。"
        },
        {
          "role": "「寝子」",
          "text": "汝等倒也不笨，知道沿着奴家的指引找过来。"
        },
        {
          "role": "「寝子」",
          "text": "要是汝等和那两个人类一样，只知道琢磨那堆大石头就没意思了。"
        },
        {
          "role": "派蒙",
          "text": "大石头…啊，是不是之前的「镇石」？"
        },
        {
          "role": "「寝子」",
          "text": "奴家怎么知道叫什么。总之，是几个堆起来的石头，上面捆了绳子的那个。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是你要那些猫…",
              "dialogues": []
            },
            {
              "text": "那些猫的足迹是你…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "奴家让几个好动的小猫去那边晃悠，就是为了看看汝等的悟性如何。"
        },
        {
          "role": "「寝子」",
          "text": "这些石头是阿响好久好久以前解开的封印。和岛上那些…"
        },
        {
          "role": "「寝子」",
          "text": "和那些紫紫的、酥酥麻麻的、会让毛变成毛球的不好的东西有关。"
        },
        {
          "role": "派蒙",
          "text": "紫紫的…酥酥麻麻的东西，难道是雷元素吗？"
        },
        {
          "role": "派蒙",
          "text": "确实，清籁岛上的雷元素很夸张呢…"
        },
        {
          "role": "「寝子」",
          "text": "奴家可以教汝等怎么用那些大石头。但与此相对…"
        },
        {
          "role": "旅行者",
          "text": "我们得帮你忙。"
        },
        {
          "role": "「寝子」",
          "text": "很有悟性嘛，果然不愧是奴家看上的人类。"
        },
        {
          "role": "「寝子」",
          "text": "奴家虽说贵为浅濑神社代宫司，但有些事情，以奴家的这两对肉球是做不到的。"
        },
        {
          "role": "「寝子」",
          "text": "比如说，神社现在没有什么香火。等阿响回来了，看到神社这么破败，一定会伤心。"
        },
        {
          "role": "「寝子」",
          "text": "所以奴家想了好久好久，就明白了。只要把「塞钱箱」修好，就会有人来塞钱。神社也会重新变得热闹起来。"
        },
        {
          "role": "旅行者",
          "text": "事情好像没这么简单…"
        },
        {
          "role": "「寝子」",
          "text": "「塞钱箱」是用来塞钱的，之前箱子完好的时候，有很多人过来塞钱，所以神社很热闹。"
        },
        {
          "role": "「寝子」",
          "text": "箱子坏了之后，就没有人过来塞钱了，神社也冷清了下来…"
        },
        {
          "role": "「寝子」",
          "text": "所以，只要把这箱子修好，就会有人重新过来塞钱，神社也会重新热闹起来…有什么问题吗？"
        },
        {
          "role": "派蒙",
          "text": "虽然说不上什么地方不对，但总感觉不太对劲，唔…"
        },
        {
          "role": "「寝子」",
          "text": "总之，奴家记得…好久好久以前，这个「塞钱箱」之前一直有人类来负责维修，所以神社一直很热闹，香火也很好。"
        },
        {
          "role": "「寝子」",
          "text": "负责维修的人类住在那边的村子里，但他已经好久没来了…"
        },
        {
          "role": "「寝子」",
          "text": "而且，自从那次好大好大的打雷之后，阿响和百目鬼他们也都不见了。"
        },
        {
          "role": "「寝子」",
          "text": "总之，奴家已经完全明白了，如果能把「塞钱箱」修好，神社就会变好。"
        },
        {
          "role": "「寝子」",
          "text": "所以，汝等帮奴家把「塞钱箱」修好，奴家就教汝等石头封印的做法。"
        },
        {
          "role": "派蒙",
          "text": "你真的知道「镇石」要怎么封印吗？"
        },
        {
          "role": "「寝子」",
          "text": "哼，奴家可是看着阿响封印了好多好多次的，也看过她怎么解开封印。"
        },
        {
          "role": "「寝子」",
          "text": "大概没问题。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大概？",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "喵喵喵？"
                },
                {
                  "role": "派蒙",
                  "text": "居然装傻！"
                }
              ]
            },
            {
              "text": "我还算是擅长修理。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不过，要修理的话，应该还需要很多材料呢。"
        },
        {
          "role": "派蒙",
          "text": "比如木板，钉子和绳子之类的东西…神社里有这些东西吗？"
        },
        {
          "role": "「寝子」",
          "text": "奴家可是把这座神社打理得很好的，没有这些没用的杂物。"
        },
        {
          "role": "派蒙",
          "text": "明明都是些有用的东西啦！"
        },
        {
          "role": "旅行者",
          "text": "在哪里能找到这些材料？"
        },
        {
          "role": "「寝子」",
          "text": "奴家是猫，怎么会知道这种事情。"
        },
        {
          "role": "旅行者",
          "text": "那个负责维修的人住在哪？"
        },
        {
          "role": "派蒙",
          "text": "对喔，那个负责维修的人应该存有维修用的材料，我们可以去那边找找看…"
        },
        {
          "role": "「寝子」",
          "text": "喔…你说这个啊，把地图拿来，奴家帮你把地点标记出来。"
        },
        {
          "type": "subtitle",
          "text": "寝子开始在地图上做标记…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "真、真的标记出来了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来是用爪子标记吗…",
              "dialogues": []
            },
            {
              "text": "你的爪子真灵活。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "那当然了。"
        },
        {
          "role": "「寝子」",
          "text": "好了，奴家已经给汝等标出大概的位置了。"
        },
        {
          "role": "「寝子」",
          "text": "维修箱子的事就拜托…汝等了…喵喵…"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "「寝子」",
          "text": "箱子维修…拜托了…喵喵…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么突然不会说话了…",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "说人类的话…很累…喵喵…"
                }
              ]
            },
            {
              "text": "我会修好箱子的，放心吧。",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "那就拜托汝等了，喵喵…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆查看「塞钱箱」的情况"
        },
        {
          "role": "派蒙",
          "text": "居然坏成这样了，看来很长时间没人维修过它了。"
        },
        {
          "role": "派蒙",
          "text": "这哪里是维修啊，差不多算是重新做一个了…"
        },
        {
          "role": "派蒙",
          "text": "我们快去那个村子里看看吧，希望真能找到一些能用的材料。"
        },
        {
          "type": "subtitle",
          "text": "◆前往村子，搜集维修用材料"
        },
        {
          "role": "派蒙",
          "text": "这应该就是那个村子了，我们四处找找看吧。"
        },
        {
          "role": "派蒙",
          "text": "呃，怎么又有盗宝团，他们在这里做什么…"
        },
        {
          "role": "派蒙",
          "text": "不行，要是他们也要用那些维修材料就糟糕了，快去阻止他们！"
        },
        {
          "type": "subtitle",
          "text": "◆打倒所有盗宝团"
        },
        {
          "role": "盗宝团",
          "text": "哎哟！别打了，别打了！英雄，我们知错了！"
        },
        {
          "role": "旅行者",
          "text": "你们在这做什么？"
        },
        {
          "role": "盗宝团",
          "text": "我们…我们就是在这里随便挖挖，碰碰运气…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说。",
              "dialogues": []
            },
            {
              "text": "三、二…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "盗宝团",
          "text": "停！停！我们说！我们说…"
        },
        {
          "role": "盗宝团",
          "text": "我们就是从人家那听说，清籁岛上有宝藏，而且岛上还没多少人…"
        },
        {
          "role": "盗宝团",
          "text": "所以，我们就过来想要碰碰运气。"
        },
        {
          "role": "盗宝团",
          "text": "但是…但是我们什么都没找到啊，这村子也不知道多少年没人打理过了…"
        },
        {
          "role": "盗宝团",
          "text": "别说宝藏了，我们连一块完整的木头都找不到！"
        },
        {
          "role": "派蒙",
          "text": "木头都坏掉了？那、那我们要找的维修材料…"
        },
        {
          "role": "旅行者",
          "text": "你们有营地吗？"
        },
        {
          "role": "盗宝团",
          "text": "这…这…当然是有的。英雄，你是要…"
        },
        {
          "role": "旅行者",
          "text": "营地里有钉子、木板和绳子吗？"
        },
        {
          "role": "盗宝团",
          "text": "这、这倒是也有的…"
        },
        {
          "role": "盗宝团",
          "text": "英、英雄，你想要什么直说就是，不用说这些隐语！"
        },
        {
          "role": "盗宝团",
          "text": "既然我们折在了英雄手上，那英雄无论要钱要宝，我们兄弟必然都双手奉上！"
        },
        {
          "role": "盗宝团",
          "text": "只求英雄高抬贵手，放我们兄弟一马…"
        },
        {
          "role": "旅行者",
          "text": "我确实是需要这些东西。"
        },
        {
          "role": "盗宝团",
          "text": "那…那英雄自己去我们的营地，把这些东西拿走就是！"
        },
        {
          "role": "旅行者",
          "text": "那你们呢？"
        },
        {
          "role": "盗宝团",
          "text": "我们…还有别的事，就在此和英雄告别了！"
        },
        {
          "role": "盗宝团",
          "text": "兄弟们，走！走了！"
        },
        {
          "role": "派蒙",
          "text": "总感觉那群盗宝团似乎对我们说的话有什么误会…"
        },
        {
          "role": "派蒙",
          "text": "不管了，我们先去他们的营地，把我们要的东西都拿到手吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往盗宝团营地"
        },
        {
          "role": "派蒙",
          "text": "这里应该就是那群盗宝团的营地了，我们四处搜索一下吧。"
        },
        {
          "type": "subtitle",
          "text": "◆打倒所有盗宝团"
        },
        {
          "type": "subtitle",
          "text": "◆在营地中搜索维修材料（3/3）"
        },
        {
          "role": "派蒙",
          "text": "东西都找到了，我们就回去维修一下那个「塞钱箱」吧。"
        },
        {
          "role": "派蒙",
          "text": "对了，这些东西你拿上吧，我可没办法拿这么多东西。"
        },
        {
          "role": "派蒙",
          "text": "这些东西，应该足够把那个「塞钱箱」给修好吧…"
        },
        {
          "type": "subtitle",
          "text": "◆回到浅濑神社，维修「塞钱箱」"
        },
        {
          "type": "subtitle",
          "text": "开始维修「塞钱箱」…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这样应该就可以了，我们回去向那只…向寝子报告一下吧。"
        },
        {
          "type": "subtitle",
          "text": "◆向寝子回报"
        },
        {
          "role": "「寝子」",
          "text": "哈唔…修得很好。奴家看见了，谢谢。"
        },
        {
          "role": "「寝子」",
          "text": "这样一来，神社就会变得热闹吧。汝等也要多多塞钱。"
        },
        {
          "role": "「寝子」",
          "text": "按照约定，奴家这就把封印石头的事情告诉汝等。"
        },
        {
          "role": "「寝子」",
          "text": "在岛上，有四堆那样的石头。阿响说，这都是为了封印一只好大好大的鸟才做的。"
        },
        {
          "role": "旅行者",
          "text": "好大好大的…鸟？"
        },
        {
          "role": "「寝子」",
          "text": "阿响说，那只鸟的力量很可怕，可以让岛上所有的猫的毛都炸起来。"
        },
        {
          "role": "「寝子」",
          "text": "奴家听她说，神社也是为了封印它才造的。"
        },
        {
          "role": "「寝子」",
          "text": "哈唔…喵喵…具体的奴家也记不清了，可惜阿响不在神社里，不然汝等就可以直接问她了。"
        },
        {
          "role": "「寝子」",
          "text": "不过奴家还记得封印那…喵喵…四块石头的方法，要封印的话…唔…喵喵…"
        },
        {
          "role": "「寝子」",
          "text": "阿响说，关键是要用石头上的绳子，还有上面的纸…"
        },
        {
          "role": "派蒙",
          "text": "绳子？纸？"
        },
        {
          "role": "「寝子」",
          "text": "要把边上的棍子的纸，变成和石头的纸一样…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听不懂。",
              "dialogues": []
            },
            {
              "text": "这、这样啊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "你的表情怎么这么迷茫，果然是悟性不够啊…总之，纸和纸，还有石头。明白了吗？"
        },
        {
          "role": "派蒙",
          "text": "难、难道是猜拳玩法？"
        },
        {
          "role": "「寝子」",
          "text": "「猜拳」？那是什么？奴家不明白…"
        },
        {
          "role": "「寝子」",
          "text": "唔，既然汝等的悟性不行…那些木板还有剩下的吗？奴家把这些事给汝等刻下来。"
        },
        {
          "role": "旅行者",
          "text": "好、好的…"
        },
        {
          "type": "subtitle",
          "text": "寝子开始在木板上刻画了起来…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「寝子」",
          "text": "这下总明白了吧。石头的封印方法，还有石头的所在位置。"
        },
        {
          "role": "「寝子」",
          "text": "汝等快点去吧，奴家还要在这里打理神社。"
        },
        {
          "role": "「寝子」",
          "text": "哼哼，既然「塞钱箱」已经修好了，那神社一定会很快重新热闹起来的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的爪子真灵巧。",
              "dialogues": []
            },
            {
              "text": "居然能刻出这么复杂的内容…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "小事一桩。"
        },
        {
          "role": "「寝子」",
          "text": "之后再来奴家的神社看看吧。等神社重新热闹起来了，一定又会有好多好多人类过来参拜。"
        },
        {
          "role": "「寝子」",
          "text": "到时候，奴家说不定又要汝等来帮忙啦。"
        },
        {
          "role": "「寝子」",
          "text": "阿响要是回来的话，看到神社重新热闹起来，肯定也会很高兴的。嗯…还有百目鬼那家伙…喵喵…"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "「寝子」",
          "text": "奴家把神社打理得真不错…"
        },
        {
          "type": "subtitle",
          "text": "◆封印「镇石」"
        },
        {
          "role": "大祐",
          "text": "这「镇石」居然分成了上下两个结构，能转动…"
        },
        {
          "role": "大祐",
          "text": "要是用正确方式转动的话，说不定就会发生什么…"
        },
        {
          "role": "悦子",
          "text": "但是，究竟什么才是「正确的方式」呢？"
        },
        {
          "role": "旅行者",
          "text": "我知道怎么封印它了。"
        },
        {
          "role": "悦子",
          "text": "咦？你回来了，我们刚才还在奇怪你去哪了呢？"
        },
        {
          "role": "大祐",
          "text": "等会？封印？这、这个「镇石」是要「封印」的吗？"
        },
        {
          "type": "subtitle",
          "text": "旅行者讲述了自己的经历…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "悦子",
          "text": "呃，一只会说话的猫？守在一个…废弃的神社里？"
        },
        {
          "role": "悦子",
          "text": "然后那只猫还告诉了你，封印「镇石」的方法？"
        },
        {
          "role": "悦子",
          "text": "真是匪夷所思…协会对这件委托的评级真是评太低了。"
        },
        {
          "role": "大祐",
          "text": "悦子小姐…这种时候就别在意委托评级了…"
        },
        {
          "role": "大祐",
          "text": "你看，这片木板上的字，好像真是用爪子划出来的！"
        },
        {
          "role": "大祐",
          "text": "这也太…太厉害了，那只叫「寝子」的猫还在那里吗？"
        },
        {
          "role": "大祐",
          "text": "我要是去那座神社参拜的话，需不需要带什么见面礼？"
        },
        {
          "role": "大祐",
          "text": "比如，鱼啊，猫粮啊之类的…"
        },
        {
          "role": "悦子",
          "text": "大祐，把重点放在封印「镇石」上，不要忘了我们过来的任务。"
        },
        {
          "role": "大祐",
          "text": "喔…喔！抱歉…"
        },
        {
          "role": "悦子",
          "text": "那我们就开始研究怎么封印这「镇石」吧。"
        },
        {
          "role": "悦子",
          "text": "但根据这块木板上的内容来看，这「镇石」似乎也不是那么好封印的啊…"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "悦子",
          "text": "根据这块木板上的内容来看，这「镇石」也不是这么好封印的…"
        },
        {
          "role": "悦子",
          "text": "而且，我还有一件很在意的事。"
        },
        {
          "role": "悦子",
          "text": "既然我们要做的是「封印」住这座「镇石」，从而平息雷暴…"
        },
        {
          "role": "悦子",
          "text": "那是不是说…曾经有人在这里解开了这些「镇石」的封印。"
        },
        {
          "role": "悦子",
          "text": "所以，清籁岛上才会出现那样的雷暴…"
        },
        {
          "role": "悦子",
          "text": "但是，到底是谁…这个人又为什么要做这种事呢…"
        },
        {
          "role": "悦子",
          "text": "真是麻烦…听起来就不像是我能掺和的事…"
        },
        {
          "role": "悦子",
          "text": "不然…还是回去报告协会，让他们再派些人过来调查吧。"
        },
        {
          "role": "大祐",
          "text": "会说话的猫…真想去亲眼看看…"
        },
        {
          "role": "大祐",
          "text": "喔…喔，你好。悦子小姐一直是那种行事方式，请你不要在意。"
        },
        {
          "role": "大祐",
          "text": "虽然看起来有点没干劲…但悦子小姐其实是一名很厉害的冒险家，每次都能很完美地完成手上的委托。"
        },
        {
          "role": "大祐",
          "text": "不过…用悦子小姐的话来说，这其实是因为她从来不接受自己完不成的委托…"
        },
        {
          "role": "大祐",
          "text": "但是我觉得，悦子小姐拥有这种判断力就已经很厉害了。"
        },
        {
          "type": "subtitle",
          "text": "◆触碰「纸垂」（3/3）"
        },
        {
          "type": "subtitle",
          "text": "◆封印「镇石」"
        },
        {
          "role": "悦子",
          "text": "这样的话…这座「镇石」应该就算是被封印住了吧。"
        },
        {
          "role": "大祐",
          "text": "但是雷暴还没有平息啊…"
        },
        {
          "role": "旅行者",
          "text": "要把四座全部封印。"
        },
        {
          "role": "悦子",
          "text": "嗯，应该就是这样了。"
        },
        {
          "role": "悦子",
          "text": "那位「寝子」在那块木板上也标记好了四座「镇石」的所在位置吧。"
        },
        {
          "role": "旅行者",
          "text": "我们出发吧。"
        },
        {
          "role": "悦子",
          "text": "嗯，我们快点出发吧。"
        },
        {
          "role": "大祐",
