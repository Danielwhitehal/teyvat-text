{
  "quest_id": 75668,
  "chapter_num": null,
  "chapter_title": "炫音爆光",
  "type": "wq",
  "route": "A Feast for the Senses",
  "stories": [
    {
      "story_id": 75668,
      "title": "炫音爆光",
      "description": "在悠悠度假村，你发现了一个庞大的舞台。而且，似乎有人正在舞台旁调制饮品…？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与阿维苏拉对话"
        },
        {
          "role": "阿维苏拉",
          "text": "加点蘑菇…再加点野菜根…"
        },
        {
          "role": "阿维苏拉",
          "text": "饮料调好了，旅行者，你要尝尝么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你，你往里面加了什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿维苏拉",
          "text": "都是一些普通的香料和调味品，它们能让饮料变得更好喝。"
        },
        {
          "role": "阿维苏拉",
          "text": "后面的乐台已经搭建完成，普通的饮料可配不上它奏出来的音乐。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "话是这么说没错…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿维苏拉",
          "text": "放心吧，在你之前已经有不少人喝过了。"
        },
        {
          "role": "阿维苏拉",
          "text": "喏，他们都已经拿着饮料去乐台旁边跳舞了。"
        },
        {
          "role": "阿维苏拉",
          "text": "来吧旅行者，拿上一杯，和我们一起跳舞！"
        },
        {
          "role": "阿维苏拉",
          "text": "把糟心事都甩到一旁，尽情享受音乐吧！"
        },
        {
          "role": "阿维苏拉",
          "text": "对了，你跳舞的时候，也记得稍微控制一下，别用力过头了啊。"
        },
        {
          "role": "阿维苏拉",
          "text": "之前就有几个人因为跳太久差点晕过去了，被人扶下来的时候，还嘟嘟囔囔什么…"
        },
        {
          "role": "阿维苏拉",
          "text": "「我…我真看见了！那个…丘丘人…和我一起跳舞…」"
        },
        {
          "role": "阿维苏拉",
          "text": "咳，不说这些耽误你时间了，快去台上玩个痛快吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿维苏拉）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来一杯！",
              "dialogues": [
                {
                  "role": "阿维苏拉",
                  "text": "没问题！拿上这杯，和我们一起跳舞，尽情享受音乐吧！"
                }
              ]
            },
            {
              "text": "还，还是不了…",
              "dialogues": [
                {
                  "role": "阿维苏拉",
                  "text": "哎，行吧。你要是想喝，随时回来找我。可要早点来，不然饮料说不定都要被喝光了。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          15,
          16
        ]
      ]
    }
  ]
}