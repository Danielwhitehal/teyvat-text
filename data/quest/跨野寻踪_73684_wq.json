{
  "quest_id": 73684,
  "chapter_num": null,
  "chapter_title": "跨野寻踪",
  "type": "wq",
  "route": "Across the Wilderness",
  "stories": [
    {
      "story_id": 73684,
      "title": "跨野寻踪",
      "description": "在蒙德城里，一位冒险家似乎正在招募人手…",
      "dialogues": [
        {
          "role": "温克尔",
          "text": "欸——各位冒险家们，有兴趣的请过来看看，协会正在开展新活动——"
        },
        {
          "role": "温克尔",
          "text": "只要参与这个活动，不仅能拿到协会发放的奖励，还会有额外的礼品——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "冒险家协会有活动？",
              "dialogues": []
            },
            {
              "text": "冒险家协会又在干什么…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温克尔",
          "text": "你是…旅行者！幸会幸会，哎呀，没想到能遇见前辈！"
        },
        {
          "role": "温克尔",
          "text": "如您所见，我正在为协会里的一项活动招募参与人员呢。"
        },
        {
          "role": "温克尔",
          "text": "这是我在协会里的第一项正式工作，我可得打起十二分的精神完成才行。"
        },
        {
          "role": "旅行者",
          "text": "关于这次活动…"
        },
        {
          "role": "温克尔",
          "text": "喔…哦！抱歉，前辈肯定还不知道这次活动的情况吧！"
        },
        {
          "role": "温克尔",
          "text": "这次的活动被[[杰克]]前辈取名叫做「跨野寻踪」。"
        },
        {
          "role": "温克尔",
          "text": "用杰克前辈的话来说，是一场「既简单又有趣，同时还能检验冒险家自身实力」的活动。"
        },
        {
          "role": "温克尔",
          "text": "具体来说，我们会在各地布设一些「野踪气球」。"
        },
        {
          "role": "温克尔",
          "text": "参与的冒险家们需要做的，就是根据提示找到「野踪气球」，并且沿着这些气球的分布轨迹前进。"
        },
        {
          "role": "温克尔",
          "text": "在限定时间内搜集到越多的「野踪气球」，就能获得越高的评价，奖励也会更加丰厚喔。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要是我把这些气球击破了…",
              "dialogues": [
                {
                  "role": "温克尔",
                  "text": "那些气球可都是特制的，能抵御住一般弓箭的射击，只能从近处击破。"
                },
                {
                  "role": "温克尔",
                  "text": "毕竟之前举办这类活动的时候，冒险家们看见气球的第一反应就是举弓就射，说了很多次他们也不记得…"
                },
                {
                  "role": "温克尔",
                  "text": "所以，这次协会使用了这种特制气球，希望会有用啊…"
                }
              ]
            },
            {
              "text": "感觉就是一场长跑啊…",
              "dialogues": [
                {
                  "role": "温克尔",
                  "text": "唔…杰克前辈说…"
                },
                {
                  "role": "温克尔",
                  "text": "「寻找气球是检验冒险家们的『洞察力』，在各种环境中前进是检验冒险家们的『基本功』…」"
                },
                {
                  "role": "温克尔",
                  "text": "「而『按照提示行动』则是检验冒险家们的『纪律性』…」"
                },
                {
                  "role": "温克尔",
                  "text": "我刚进协会，对这方面的事不太懂啦…但杰克前辈既然这么说了，肯定有他的道理。"
                }
              ]
            }
          ]
        },
        {
          "role": "温克尔",
          "text": "啊！我不能和您闲聊了，我还要接着去招募人员呢！"
        },
        {
          "role": "温克尔",
          "text": "如果您有兴趣的话，也请来参与一下吧！如果您愿意加入这次活动，杰克前辈和塞琉斯会长一定也会很高兴的。"
        }
      ]
    }
  ]
}