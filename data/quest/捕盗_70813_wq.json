  "chapter_title": "捕盗",
  "type": "wq",
  "route": "Thief-Catcher",
  "stories": [
    {
      "story_id": 70813,
      "title": "捕盗",
      "description": "风暴刚刚结束，蒙德城冒险家协会的塞琉斯先生正在筹备清扫盗宝团…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与塞琉斯对话"
        },
        {
          "type": "subtitle",
          "text": "击败晨曦酒庄附近的盗宝团"
        },
        {
          "type": "subtitle",
          "text": "击败驻守营地的盗宝团成员"
        },
        {
          "type": "subtitle",
          "text": "与塞琉斯对话"
        },
        {
          "role": "塞琉斯",
          "text": "哼，盗宝团…真是一帮扫不净赶不走的老鼠。"
        },
        {
          "role": "塞琉斯",
          "text": "你回来了，那些盗宝团的营地扫清了吗？"
        },
        {
          "role": "旅行者",
          "text": "全部扫清了。"
        },
        {
          "role": "塞琉斯",
          "text": "不愧是荣誉骑士，这么点小事果然不在话下。"
        },
        {
          "role": "塞琉斯",
          "text": "哼…这群盗宝团倒是有点「毅力」，风暴的时候全城都在避难，他们居然还敢顶着风暴进来偷东西。"
        },
        {
          "role": "塞琉斯",
          "text": "有这种「毅力」，做点正经的事不是更好吗…"
        }
      ]
    }
  ]
}