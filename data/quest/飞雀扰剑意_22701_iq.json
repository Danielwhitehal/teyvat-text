{
  "quest_id": 22701,
  "chapter_num": null,
  "chapter_title": "飞雀扰剑意",
  "type": "iq",
  "route": "The Sparrow Studies the Blade",
  "stories": [
    {
      "story_id": 22701,
      "title": "飞雀扰剑意",
      "description": "在绝云间寻访仙迹的孙宇似乎有事想找人帮忙…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "有话直说。"
        },
        {
          "role": "小雀儿",
          "text": "我师兄同你搭话，你给我客气点！"
        },
        {
          "role": "孙宇",
          "text": "师妹，是我主动叫住这位朋友的…"
        },
        {
          "role": "小雀儿",
          "text": "只怕这人又是个想来绝云间碰仙缘的投机贼…"
        },
        {
          "role": "孙宇",
          "text": "师妹，好了，好了，你先在这里歇歇吧，我和这位朋友说几句话就回来。"
        },
        {
          "role": "小雀儿",
          "text": "师兄，有什么事不能当着我说的呀？"
        },
        {
          "role": "孙宇",
          "text": "只是一些杂事，师妹你肯定是不愿意听的…"
        },
        {
          "role": "小雀儿",
          "text": "哼，肯定又是要说古华派的事了…好啦，师兄你不愿意我听，我不听就是。"
        },
        {
          "role": "孙宇",
          "text": "这位朋友，请随我去那边，我再和你细细说过。"
        },
        {
          "type": "subtitle",
          "text": "与孙宇对话"
        },
        {
          "role": "孙宇",
          "text": "这位朋友请留步。"
        },
        {
          "role": "孙宇",
          "text": "看你步伐轻健，自有一番架势，想必同我二人一样，是习武之人…"
        },
        {
          "type": "subtitle",
          "text": "跟随孙宇"
        },
        {
          "type": "subtitle",
          "text": "与孙宇对话"
        },
        {
          "role": "孙宇",
          "text": "这里就可以了…"
        },
        {
          "role": "旅行者",
          "text": "到底是什么事…"
        },
        {
          "role": "孙宇",
          "text": "唉，还是我师妹小雀儿的事。我与她平日习武练功形影不离，她的功夫也不在我之下。"
        },
        {
          "role": "孙宇",
          "text": "但这次进绝云间寻访仙迹本就路途艰辛，她又爱说话，前几天着了凉，嗓子也哑了。"
        },
        {
          "role": "孙宇",
          "text": "我看朋友功夫也是不凡的，能不能请你帮我去旁边的山崖顶上摘三朵清心回来，我给小雀儿泡水喝养养嗓子。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "那就拜托朋友了，小雀儿太活泼了，我可不敢独自去采药，放她一个人在这。"
                }
              ]
            },
            {
              "text": "为什么要避着她？",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "让朋友看笑话了，我师妹她从小就性子要强，万事都不肯落了旁人半点。"
                },
                {
                  "role": "孙宇",
                  "text": "要是当着她面说给她找药养嗓子，她一定会和我置气不肯喝药，所以只能避着她了。"
                },
                {
                  "role": "孙宇",
                  "text": "我又不敢独自去采药，把她留在原地，所以只能拜托你了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往崖顶，采摘三朵清心"
        },
        {
          "type": "subtitle",
          "text": "前往崖顶，采摘三朵清心"
        },
        {
          "type": "subtitle",
          "text": "前往崖顶，采摘三朵清心"
        },
        {
          "role": "孙宇",
          "text": "小雀儿与我从小一同习武练功，我向来是拿她当亲妹妹待。"
        },
        {
          "role": "孙宇",
          "text": "只是不知怎么，小雀儿越是长大，我反而越是弄不懂她了。"
        },
        {
          "role": "孙宇",
          "text": "唉，还是小时候好啊…"
        },
        {
          "role": "小雀儿",
          "text": "怎么，师兄和你说完话了？别这么看着我，师兄不愿我听的事，我自然不会听。"
        },
        {
          "role": "小雀儿",
          "text": "再说了，师兄准又在说古华派。这么多年了，他心里就没有记挂过其他的事…"
        },
        {
          "role": "小雀儿",
          "text": "我的事也…"
        },
        {
          "role": "小雀儿",
          "text": "算了！说给你听做什么，你还杵在这不走？我师兄不是让你帮忙吗？还不快去！"
        },
        {
          "type": "subtitle",
          "text": "将清心交给孙宇"
        },
        {
          "role": "孙宇",
          "text": "你回来了，我所托之事…"
        },
        {
          "role": "旅行者",
          "text": "已经采到了。"
        },
        {
          "role": "孙宇",
          "text": "这些就可以了，谢谢朋友，容我找些谢礼给你…"
        },
        {
          "role": "小雀儿",
          "text": "咦？你怎么采了这么多清心回来，师兄，你是不是又头痛了？"
        },
        {
          "role": "旅行者",
          "text": "是给你师兄治头痛的。"
        },
        {
          "role": "小雀儿",
          "text": "师兄，你若要去采药，我给你去采就是，何必拜托这外人？"
        },
        {
          "role": "小雀儿",
          "text": "再说了，这人不知来历，说不定有什么…"
        },
        {
          "role": "孙宇",
          "text": "…好了，师妹，这位朋友是帮了我们的，不要这么说人家。"
        },
        {
          "role": "孙宇",
          "text": "谢谢你，这些谢礼请你收下吧。"
        },
        {
          "role": "小雀儿",
          "text": "收下了就快点走吧，我师兄头疼吹不得风。"
        },
        {
          "role": "小雀儿",
          "text": "师兄，我们快点去那边避避风，我煮点热糖水给你喝…"
        },
        {
          "role": "旅行者",
          "text": "这是采给你治嗓子的。"
        },
        {
          "role": "孙宇",
          "text": "朋友！你…"
        },
        {
          "role": "小雀儿",
          "text": "…我哪里有这么娇弱，吹点风就嗓子哑了。"
        },
        {
          "role": "小雀儿",
          "text": "不过，这些清心倒是正好来止止我师兄的头疼。"
        },
        {
          "role": "孙宇",
          "text": "师妹，你听我说…"
        },
        {
          "role": "小雀儿",
          "text": "师兄，你先去避风的地方歇歇吧，我待会煮了糖水给你喝。"
        },
        {
          "role": "小雀儿",
          "text": "你，拿好这些，赶紧走吧。"
        }
      ]
    }
  ]
}