{
  "quest_id": 10247,
  "chapter_num": "绘夏！烈日？度假村！其三",
  "chapter_title": "惊遇！等待众人的将是…？",
  "type": "lq",
  "route": "The Surprise That Awaits Us All!",
  "stories": [
    {
      "story_id": 15044,
      "title": "惊遇！等待众人的将是…？",
      "description": "悠悠纪念册填满了你与大家共度的欢乐时光，终于，兑奖的时间到了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至次日上午（8~12点）"
        },
        {
          "type": "subtitle",
          "text": "前往接待处兑换奖励"
        },
        {
          "role": "派蒙",
          "text": "哈…休息得真好，该喊上大家去领取我们的奖励了。"
        },
        {
          "role": "派蒙",
          "text": "奖品到底会是什么呢？好期待啊！"
        },
        {
          "role": "欧库夏",
          "text": "是你们啊，早上好！这几天过得还愉快吗？"
        },
        {
          "role": "派蒙",
          "text": "非常愉快！吃的好，玩的也好，无忧无虑的日子真棒呀…"
        },
        {
          "role": "温迪",
          "text": "有人听见风里的声音了吗？"
        },
        {
          "role": "玛拉妮",
          "text": "嗯？有什么特别的吗？我怎么没听见。"
        },
        {
          "role": "温迪",
          "text": "没有吗？「温迪，温迪——」蜜酿们在呼唤着我呢。"
        },
        {
          "role": "派蒙",
          "text": "呃…怎么大清早就开始说胡话。"
        },
        {
          "role": "恰斯卡",
          "text": "就算吟游诗人嗜酒如命，但他还是为了朋友们来到了这里。"
        },
        {
          "role": "温迪",
          "text": "哎呀，真是位目光锐利的小姐，果然像绒翼龙一样呢。"
        },
        {
          "role": "阿夏",
          "text": "♪"
        },
        {
          "role": "欧库夏",
          "text": "噢！阿夏的精神也不错嘛。"
        },
        {
          "role": "班尼特",
          "text": "要不要把我们刚才的切磋分享给大家听？"
        },
        {
          "role": "阿夏",
          "text": "！"
        },
        {
          "role": "玛拉妮",
          "text": "哈哈，怎么是这个反应？我感兴趣了！"
        },
        {
          "role": "班尼特",
          "text": "我刚收拾完出门的东西，阿夏就在房间里蹦跶来、蹦跶去的，像有用不完的精力，还使劲向我炫耀它的徽章。"
        },
        {
          "role": "班尼特",
          "text": "「好呀，那我们就比试比试。怎么比？」我对它说。"
        },
        {
          "role": "班尼特",
          "text": "没想到它竟然向我伸出了小手，想跟我掰手腕。"
        },
        {
          "role": "派蒙",
          "text": "你赢了吗？"
        },
        {
          "role": "班尼特",
          "text": "轻轻松松，但以我们的体型差距来说也太欺负人了，我有点过意不去。"
        },
        {
          "role": "班尼特",
          "text": "我说，我们还是应该比点别的，一会去涂鸦怎么样？我带着颜料罐…"
        },
        {
          "role": "欧库夏",
          "text": "很高兴看到各位的行程仍然充实。"
        },
        {
          "role": "欧库夏",
          "text": "那么，四个区域主要挑战…我猜你们全都做完了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是的。",
              "dialogues": []
            },
            {
              "text": "这是完成后的纪念册。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "欧库夏",
          "text": "好的，稍等我看看…"
        },
        {
          "role": "欧库夏",
          "text": "啊——？！"
        },
        {
          "role": "温迪",
          "text": "欸？怎么了吗？"
        },
        {
          "role": "欧库夏",
          "text": "你们…没在开玩笑吧？"
        },
        {
          "role": "派蒙",
          "text": "呀——！！"
        },
        {
          "role": "玛拉妮",
          "text": "派蒙干嘛突然大叫啊，吓死我了，到底发生什么了？"
        },
        {
          "role": "派蒙",
          "text": "对不起…我胆子比较小，但这个真的有点瘆人…"
        },
        {
          "role": "班尼特",
          "text": "这…"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-CG1-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-CG1-空.png|center|600px]]"
        },
        {
          "role": "玛拉妮",
          "text": "啊？…合照怎么会变成这样？"
        },
        {
          "role": "派蒙",
          "text": "对吧…像突然变了一群人一样…"
        },
        {
          "role": "恰斯卡",
          "text": "冷静点，仔细看，衣着服饰还有留影时的动作，的确是我们。"
        },
        {
          "role": "玛拉妮",
          "text": "那是为什么？"
        },
        {
          "role": "班尼特",
          "text": "画片被人涂鸦了？不对…上面也没有附着颜料的痕迹，它像是留影机直接拍出来的画片。说不通啊…"
        },
        {
          "role": "恰斯卡",
          "text": "其他画片呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我看看。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛拉妮",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-CG2-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-CG2-空.png|center|600px]]"
        },
        {
          "role": "恰斯卡",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-CG3-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-CG3-空.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-CG4-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-CG4-空.png|center|600px]]"
        },
        {
          "role": "班尼特",
          "text": "四张合照都变了。"
        },
        {
          "role": "派蒙",
          "text": "呃，你们看吧，我不想看了…这种感觉太奇怪了…"
        },
        {
          "role": "温迪",
          "text": "不会是谁的恶作剧吧？"
        },
        {
          "role": "玛拉妮",
          "text": "翻到最后了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（再翻一页…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-照片.png|center|600px]]"
        },
        {
          "role": "班尼特",
          "text": "……"
        },
        {
          "role": "恰斯卡",
          "text": "先生，兑奖的事情暂缓。"
        },
        {
          "role": "恰斯卡",
          "text": "我们过去聊。"
        },
        {
          "role": "派蒙",
          "text": "所以…有看出什么信息吗？"
        },
        {
          "role": "玛拉妮",
          "text": "看不清脸，但我认出了「流泉之众」的衣服！还有「花羽会」、「沃陆之邦」和「烟谜主」…"
        },
        {
          "role": "班尼特",
          "text": "「燧石之锋」冒险团…"
        },
        {
          "role": "温迪",
          "text": "嗯？"
        },
        {
          "role": "班尼特",
          "text": "他们是，「燧石之锋」冒险团…我们在刺梨镇读过他们的故事。"
        },
        {
          "role": "班尼特",
          "text": "来自于不同部族的朋友组建成了这支冒险团，他们立志让「燧石之锋」的名号传遍全提瓦特…"
        },
        {
          "role": "班尼特",
          "text": "后来，因为那位婴儿的诞生，夫妻萌生退意，他们组织了那场告别的旅行…"
        },
        {
          "role": "恰斯卡",
          "text": "再给我看一眼？"
        },
        {
          "role": "派蒙",
          "text": "喏。"
        },
        {
          "role": "恰斯卡",
          "text": "我确实见过这个地方，就在这里。"
        },
        {
          "role": "玛拉妮",
          "text": "你说什么？怎么可能？"
        },
        {
          "role": "玛拉妮",
          "text": "按照班尼特的说法，笔记里记载的不是很久以前的事了吗？这里都不是度假村呢！"
        },
        {
          "role": "恰斯卡",
          "text": "不冲突…你们看地形。"
        },
        {
          "role": "温迪",
          "text": "唔，我倒是没什么印象呢…"
        },
        {
          "role": "恰斯卡",
          "text": "我每天早起巡逻的时候，都会飞过那一带，我知道它的准确位置，可以带路。"
        },
        {
          "role": "派蒙",
          "text": "要去看看吗？"
        },
        {
          "role": "班尼特",
          "text": "要。我们走…"
        },
        {
          "role": "温迪",
          "text": "哎，别急别急。行动之前，大家再来回顾一下，如何呢？"
        },
        {
          "role": "玛拉妮",
          "text": "嗯…不管是不是恶作剧，留下画片的人，肯定是想通过它暗示或传达些什么。"
        },
        {
          "role": "玛拉妮",
          "text": "既然线索指向具体的位置，只有去到对应的地方，才可能发现更进一步的信息，我是这么想的。"
        },
        {
          "role": "温迪",
          "text": "谢谢玛拉妮的总结。"
        },
        {
          "role": "温迪",
          "text": "但恰斯卡巡逻的时候没有发现过异样，而纪念册里的画片，也在神不知鬼不觉的时候被加了进去…"
        },
        {
          "role": "恰斯卡",
          "text": "对手不容小觑…是这个意思吧。"
        },
        {
          "role": "温迪",
          "text": "差不多吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们谨慎前进吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "班尼特？"
        },
        {
          "role": "班尼特",
          "text": "…我们接下来要去的地方可能会有风险，这段时间，能请你照看阿夏吗？"
        },
        {
          "role": "欧库夏",
          "text": "可它不是已经往那边去了吗？就在你们讨论的时候。我还以为是你的指示…"
        },
        {
          "role": "派蒙",
          "text": "糟糕。"
        },
        {
          "role": "恰斯卡",
          "text": "是同一个方向。"
        },
        {
          "role": "班尼特",
          "text": "追上去吧，沿路也找找看！"
        },
        {
          "type": "subtitle",
          "text": "前往照片所指示的地方"
        },
        {
          "role": "班尼特",
          "text": "阿夏！你在吗？"
        },
        {
          "role": "班尼特",
          "text": "阿夏，听得到吗？"
        },
        {
          "role": "班尼特",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "没事的，班尼特…说不定它只是看到了感兴趣的东西，等下就出来了呢？"
        },
        {
          "role": "恰斯卡",
          "text": "画片中的位置就是这里了。"
        },
        {
          "role": "玛拉妮",
          "text": "好安静的地方，看着也没人想和我们接洽。"
        },
        {
          "role": "恰斯卡",
          "text": "分头找找看吧，但不要走远…也留意是否有阿夏的行踪。"
        },
        {
          "role": "玛拉妮",
          "text": "好像没什么呀…"
        },
        {
          "role": "温迪",
          "text": "阿夏，出来一起玩咯？"
        },
        {
          "role": "班尼特",
          "text": "……"
        },
        {
          "role": "班尼特",
          "text": "我听见…"
        },
        {
          "role": "派蒙",
          "text": "大家，快过来！"
        },
        {
          "role": "班尼特",
          "text": "我听见…有声音一直在呼唤着我。"
        },
        {
          "role": "温迪",
          "text": "蜜酿的声音？"
        },
        {
          "role": "班尼特",
          "text": "不是蜜酿…虽然它的确在呼唤我的名字，让我走向…"
        },
        {
          "role": "派蒙",
          "text": "你们看！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可能是秘境的入口，但…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛拉妮",
          "text": "突然出现在这种地方…"
        },
        {
          "role": "班尼特",
          "text": "声音，就是从这里面…"
        },
        {
          "role": "恰斯卡",
          "text": "小心，万一是个圈套。"
        },
        {
          "role": "班尼特",
          "text": "不…不是的，那不是圈套。"
        },
        {
          "role": "班尼特",
          "text": "它的语气，没有丝毫恶意…而是充满了关心…"
        },
        {
          "role": "派蒙",
          "text": "班尼特！唉，卖唱的，你快劝劝他呀！"
        },
        {
          "role": "温迪",
          "text": "……"
        },
        {
          "role": "班尼特",
          "text": "……"
        },
        {
          "role": "班尼特",
          "text": "各位，我知道你们在担心我，我也知道前方有危险…"
        },
        {
          "role": "班尼特",
          "text": "但我隐约有种预感。我所寻找的东西，呼唤我的声音，那张画片背后的谜题…只有在这里面才会有解答。"
        },
        {
          "role": "班尼特",
          "text": "老爹们总说，冒险家不该惧怕探索和挑战…"
        },
        {
          "role": "班尼特",
          "text": "我想进入这座秘境，但我不希望大家跟上来…我怕会将各位也卷入危险之中。"
        },
        {
          "role": "派蒙",
          "text": "现在怎么办？"
        },
        {
          "role": "恰斯卡",
          "text": "「冒险的灵魂是团队合作。」这话还是你自己说的。"
        },
        {
          "role": "玛拉妮",
          "text": "别说认识你更久的旅行者和温迪了…我们早就是同伴了吧？怎么能让团长一个人落单呢！"
        },
        {
          "role": "班尼特",
          "text": "两位…"
        },
        {
          "role": "派蒙",
          "text": "好吧，我本来还想劝劝你，但我也知道啦，要说服冒险家不去冒险还是太难了…"
        },
        {
          "role": "派蒙",
          "text": "算啦，要是冒险的终点有着宝藏，那我们也要分一勺，不能让你独享！"
        },
        {
          "role": "班尼特",
          "text": "那…温迪老师呢？"
        },
        {
          "role": "温迪",
          "text": "都被叫了一路的温迪老师了，关键时候抛下学生，岂不是很过分？"
        },
        {
          "role": "温迪",
          "text": "感谢的话就等派对上再说吧，今天又有人要请客咯。"
        },
        {
          "role": "班尼特",
          "text": "嗯，嗯…好的…哈哈，谢谢大家。"
        },
        {
          "role": "班尼特",
          "text": "那么，各位都准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "出发吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "班尼特",
          "text": "嗯！"
        },
        {
          "type": "subtitle",
          "text": "进入秘境"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "派蒙",
          "text": "这是…什么地方…"
        },
        {
          "role": "玛拉妮",
          "text": "好热啊…呼吸像是被压缩了…呼，不太好喘气…"
        },
        {
          "role": "恰斯卡",
          "text": "要小心。这里存在深渊的气息。"
        },
        {
          "role": "派蒙",
          "text": "深渊？！"
        },
        {
          "role": "恰斯卡",
          "text": "啧，气流太紊乱了，我找不准它的精确位置。"
        },
        {
          "role": "派蒙",
          "text": "难道深渊真的是冲着班尼特来的？等等…班尼特呢？"
        },
        {
          "role": "玛拉妮",
          "text": "班尼特——"
        },
        {
          "role": "派蒙",
          "text": "班尼特——你在这里吗——"
        },
        {
          "role": "玛拉妮",
          "text": "走散了？我们不是一起进来的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不好…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "班尼特发现自己正独自一人在此…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "班尼特",
          "text": "（这是哪里？…我来过这个地方…）"
        },
        {
          "role": "班尼特",
          "text": "（为什么我会那么熟悉…？）"
        },
        {
          "role": "班尼特",
          "text": "旅行者…派蒙…"
        },
        {
          "role": "班尼特",
          "text": "呃…咳咳…"
        },
        {
          "role": "班尼特",
          "text": "（我的声音…嗓子里面好难受…）"
        },
        {
          "role": "班尼特",
          "text": "大家…"
        },
        {
          "role": "班尼特",
          "text": "（还是没有回音，也没有人影，是我和其他人走丢了吗？还是大家都分开了？）"
        },
        {
          "role": "班尼特",
          "text": "（不、不行…）"
        },
        {
          "role": "班尼特",
          "text": "（心跳得越来越快了，脊背上全是冷汗，什么都回想不起来…再这样下去，我随时都有可能晕倒…）"
        },
        {
          "role": "班尼特",
          "text": "（想停下来…）"
        },
        {
          "role": "班尼特",
          "text": "（不知道我现在到底是…好运还是厄运。）"
        },
        {
          "role": "班尼特",
          "text": "（如果我还在好运的状态，我都遇到了这么危险的处境，大家一定面临着更大的危险…）"
        },
        {
          "role": "班尼特",
          "text": "（我得去帮忙…得往前，得动起来…）"
        },
        {
          "role": "班尼特",
          "text": "（对，这点痛不算什么…往前…我可以做到的…）"
        },
        {
          "role": "班尼特",
          "text": "（我没事，我没事…不会有事的…要和大家会合才行…）"
        },
        {
          "role": "班尼特",
          "text": "等着…我…"
        },
        {
          "type": "subtitle",
          "text": "你们环顾四方，却没看见班尼特的身影…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "玛拉妮",
          "text": "那些奇怪的星星，是不是比刚才更暗了？我总有一种不祥的预感…"
        },
        {
          "role": "温迪",
          "text": "不能等在原地了，我们往前找。"
        },
        {
          "role": "派蒙",
          "text": "唔！卖唱的都这么说了…"
        },
        {
          "type": "subtitle",
          "text": "逆风前行"
        },
        {
          "role": "派蒙",
          "text": "可是这风真的好大…飞都飞不动…"
        },
        {
          "role": "玛拉妮",
          "text": "再坚持一下，派蒙，我牵住你了。"
        },
        {
          "role": "派蒙",
          "text": "谢谢…"
        },
        {
          "type": "subtitle",
          "text": "继续逆风前行"
        },
        {
          "role": "派蒙",
          "text": "哇啊啊啊啊啊——"
        },
        {
          "role": "派蒙",
          "text": "还以为要被卷走了…这里真的好邪门…"
        },
        {
          "role": "恰斯卡",
          "text": "我来开路。跟紧一点，千万别掉队。"
        },
        {
          "role": "派蒙",
          "text": "又来？！"
        },
        {
          "role": "派蒙",
          "text": "胃里好难受，我要吐了…"
        },
        {
          "role": "恰斯卡",
          "text": "越往前越凶险…"
        },
        {
          "role": "派蒙",
          "text": "卖唱的，你确定班尼特是在这前面吗？"
        },
        {
          "role": "温迪",
          "text": "嗯…"
        },
        {
          "role": "温迪",
          "text": "命运吸引他回到了这里，这是他必须翻越的坎坷与劫难…但如果只靠他自己…"
        },
        {
          "role": "温迪",
          "text": "各位，坚持一下！我们的动作得再快一点。"
        },
        {
          "role": "派蒙",
          "text": "这根本…走不动啊…"
        },
        {
          "role": "琴声",
          "text": "♪"
        },
        {
          "type": "subtitle",
          "text": "温迪弹奏竖琴，制造出了风元素的屏障保护众人…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "卖唱的…"
        },
        {
          "role": "温迪",
          "text": "……"
        },
        {
          "role": "温迪",
          "text": "趁现在！"
        },
        {
          "type": "subtitle",
          "text": "在温迪的协助下，你们顶着怪异的狂风前进着…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "班尼特",
          "text": "你是说…这里是我…命运的终点？"
        },
        {
          "role": "回荡在耳边的声音",
          "text": "没错…没错…"
        },
        {
          "role": "回荡在耳边的声音",
          "text": "死里逃生的班尼特，「幸运」的班尼特…"
        },
        {
          "role": "回荡在耳边的声音",
          "text": "你曾经逃出命运的掌控，逃到了我无法触及的地方…你一定享受了不少幸福的日子吧…"
        },
        {
          "role": "回荡在耳边的声音",
          "text": "现在命运终于让你回到这里，面对你在很久以前侥幸逃脱的死亡。"
        },
        {
          "role": "班尼特",
          "text": "哈哈，就算你这么说，我还是觉得…命运，是要靠自己去把握的…"
        },
        {
          "role": "班尼特",
          "text": "冒险家的职责…就是去改写人为的定义…去挖掘，和挑战…原本不可能的事情。"
        },
        {
          "role": "回荡在耳边的声音",
          "text": "所以我才钟爱你们这些冒险家…满腔热血，最后一事无成，就像你的父母一样。"
        },
        {
          "role": "班尼特",
          "text": "你说…什么？"
        },
        {
          "role": "回荡在耳边的声音",
          "text": "「燧石之锋」…多么可笑的名字，他们划出的最后一点火光，也即将在此熄灭。"
        },
        {
          "role": "回荡在耳边的声音",
          "text": "那些会拯救你的人已经不在了…看啊，就连你的「命运之轮」也如此残破…"
        },
        {
          "role": "回荡在耳边的声音",
          "text": "放弃吧，班尼特…逃脱死亡的婴儿…"
        },
        {
          "role": "回荡在耳边的声音",
          "text": "迎接你宿命的终局。"
        },
        {
          "role": "回荡在耳边的声音",
          "text": "你是没法与我（深渊）对抗的。"
        },
        {
          "role": "班尼特",
          "text": "……"
        },
        {
          "role": "班尼特",
          "text": "我还不能…"
        },
        {
          "type": "subtitle",
          "text": "你们一路前进，发现了前方有奇异的光芒闪烁…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "恰斯卡",
          "text": "那片光芒是…"
        },
        {
          "role": "玛拉妮",
          "text": "是阿夏！有一位是班尼特的搭档！"
        },
        {
          "role": "恰斯卡",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "班尼特！班尼特——你怎么了？班尼特，快醒醒…"
        },
        {
          "role": "恰斯卡",
          "text": "急救手段没有效果，他的生命体征还是很微弱。"
        },
        {
          "role": "派蒙",
          "text": "班尼特！呜，快想想办法啊大家！"
        },
        {
          "role": "温迪",
          "text": "有没有人随身带着火种？"
        },
        {
          "role": "玛拉妮",
          "text": "火种？"
        },
        {
          "role": "温迪",
          "text": "他现在需要的是光，帮助他跨越这段命运的火光。"
        },
        {
          "role": "玛拉妮",
          "text": "蜡烛可以吗？"
        },
        {
          "role": "温迪",
          "text": "嗯，点燃它，「太阳」会为他指引方向。"
        },
        {
          "role": "恰斯卡",
          "text": "真的能行吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我相信温迪。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "…好，知道了。"
        },
        {
          "role": "玛拉妮",
          "text": "我们为他祈祷吧。"
        },
        {
          "role": "玛拉妮",
          "text": "太阳垂落于夜幕以西时，愿燧石的光亮指引归途。"
        },
        {
          "role": "众人",
          "text": "当旧的污浊焚尽，如烈焰般的光明定会再度到来。"
        },
        {
          "role": "温迪",
          "text": "迷途的游子，侧耳聆听。"
        },
        {
          "role": "温迪",
          "text": "阳光驱散灰烬，林间的风唱着往昔的旋律，归乡之路洒满果香。"
        },
        {
          "role": "温迪",
          "text": "跟着我，跟着我，回家吧。"
        },
        {
          "type": "subtitle",
          "text": "[https://www.bilibili.com/video/BV1HTtnzjEoN 过场动画「最幸运的孩子」]"
        },
        {
          "role": "阿洛妮",
          "text": "人们都说孩子爱哭"
        },
        {
          "role": "阿洛妮",
          "text": "但当我想到你"
        },
        {
          "role": "阿洛妮",
          "text": "亲爱的孩子"
        },
        {
          "role": "阿洛妮",
          "text": "我只记得你的笑"
        },
        {
          "role": "阿洛妮",
          "text": "你会笑跳上游隙灵道的龙龙"
        },
        {
          "role": "阿洛妮",
          "text": "会笑查丘叔叔帽子上打颤的羽毛毛"
        },
        {
          "role": "阿洛妮",
          "text": "有天晚上你突然笑起了天上的星星"
        },
        {
          "role": "阿洛妮",
          "text": "让你爹也迷上了观星"
        },
        {
          "role": "阿洛妮",
          "text": "我以为你们从星光中读到了什么谕示"
        },
        {
          "role": "阿洛妮",
          "text": "抬头望去，原来星星真的在笑"
        },
        {
          "role": "安洁娅",
          "text": "阿洛妮，别写了，就差你了！"
        },
        {
          "role": "安洁娅",
          "text": "团长，快为大家说点什么"
        },
        {
          "role": "马坎尼",
          "text": "那就…"
        },
        {
          "role": "马坎尼",
          "text": "祝福故乡繁荣，祝福友谊长存"
        },
        {
          "role": "马坎尼",
          "text": "祝福我们度过一段美妙的旅程…"
        },
        {
          "role": "阿洛妮",
          "text": "嘘！他笑了"
        },
        {
          "role": "安洁娅",
          "text": "你们有没有听说过爱笑的宝宝会很幸运啊？"
        },
        {
          "role": "查丘",
          "text": "你也太相信那些了…"
        },
        {
          "role": "安洁娅",
          "text": "是真的！"
        },
        {
          "role": "阿洛妮",
          "text": "虽然我们都不知道"
        },
        {
          "role": "阿洛妮",
          "text": "为什么你这么喜欢笑"
        },
        {
          "role": "阿洛妮",
          "text": "但我想，你是感觉到了大家的关怀与祝福"
        },
        {
          "role": "阿洛妮",
          "text": "对不对？"
        },
        {
          "role": "阿洛妮",
          "text": "大家都爱你"
        },
        {
          "role": "阿洛妮",
          "text": "你一定会成为一个很幸福的孩子"
        },
        {
          "role": "安洁娅",
          "text": "这里怎么会有那么多深渊魔物？"
        },
        {
          "role": "查丘",
          "text": "快逃！"
        },
        {
          "role": "马坎尼",
          "text": "不行，退路全被封死了"
        },
        {
          "role": "马坎尼",
          "text": "阿洛妮，把孩子…"
        },
        {
          "role": "马坎尼",
          "text": "阿洛妮！！"
        },
        {
          "role": "阿洛妮",
          "text": "我的孩子…"
        },
        {
          "role": "马坎尼",
          "text": "坚持住！快！我来保护你们"
        },
        {
          "role": "阿洛妮",
          "text": "别管我…带他去，安全的…"
        },
        {
          "role": "阿洛妮",
          "text": "神明啊，如果你能够听见我的祈祷"
        },
        {
          "role": "阿洛妮",
          "text": "我愿将我的身躯，我的爱与记忆作为燃料"
        },
        {
          "role": "阿洛妮",
          "text": "哪怕灵魂无法回归神国"
        },
        {
          "role": "阿洛妮",
          "text": "注定要在荒野上游荡…"
        },
        {
          "role": "众人",
          "text": "我愿意奉上我的一切…"
        },
        {
          "role": "众人",
          "text": "请让这个孩子活下去"
        },
        {
          "type": "subtitle",
          "text": "冒险团的成员们变成了阿夏…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "阿洛妮",
          "text": "长大后，你一定会交上许多朋友"
        },
        {
          "role": "阿洛妮",
          "text": "因为我知道"
        },
        {
          "role": "阿洛妮",
          "text": "你就是最幸运的孩子"
        },
        {
          "role": "阿洛妮",
          "text": "再笑一笑好吗"
        },
        {
          "role": "阿洛妮",
          "text": "让妈妈…再看一眼"
        },
        {
          "type": "subtitle",
          "text": "你们看见了那一支名为「燧石之锋」的冒险团所进行的最后冒险，也得知了班尼特的命运。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "班尼特",
          "text": "妈妈…"
        },
        {
          "role": "班尼特",
          "text": "我该不会是在梦里？"
        },
        {
          "role": "阿洛妮",
          "text": "不是梦，这不是梦，我的孩子…你都长这么大了…"
        },
        {
          "role": "班尼特",
          "text": "……！爸爸，妈妈！我终于见到你们了！"
        },
        {
          "role": "马坎尼",
          "text": "……"
        },
        {
          "role": "马坎尼",
          "text": "让爸爸也抱抱你…"
        },
        {
          "role": "派蒙",
          "text": "这里的空气没那么压抑了，呼吸也顺畅了不少。"
        },
        {
          "role": "玛拉妮",
          "text": "我们刚才看到的画面是…？"
        },
        {
          "role": "温迪",
          "text": "是过去残留的记忆吧，说不定是火神大人听到了我们的祈祷。"
        },
        {
          "role": "玛拉妮",
          "text": "之后可要好好谢谢火神大人…"
        },
        {
          "role": "派蒙",
          "text": "原来班尼特就是「燧石之锋」冒险团故事中的那位婴儿…"
        },
        {
          "role": "阿洛妮",
          "text": "没错，当年我们不幸踏入此地…没能生还…只能用最后一丝希望保护这个孩子，我们的孩子…"
        },
        {
          "role": "阿洛妮",
          "text": "该让我抱一下了吧？孩子他爹…"
        },
        {
          "role": "马坎尼",
          "text": "哎呀，哎呀…"
        },
        {
          "role": "温迪",
          "text": "虽然事情已经解决了，但这里的风景怎么都不像是能够静下心来聊天的地方呀。"
        },
        {
          "role": "温迪",
          "text": "走吧，各位，我们出去再说。"
        },
        {
          "type": "subtitle",
          "text": "离开秘境"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "温迪",
          "text": "好了，到这里就可以了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "冒险的终点真的有宝藏…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那就是班尼特，对吧？"
        },
        {
          "role": "阿洛妮",
          "text": "朋友们都叫你「班尼特」？"
        },
        {
          "role": "班尼特",
          "text": "对，这是老爹们给我起的名字，蒙德的老冒险家，是他们把我抚养长大的。"
        },
        {
          "role": "马坎尼",
          "text": "班尼特，嗯…班尼特…"
        },
        {
          "role": "阿洛妮",
          "text": "意为「受祝福的人」。从这个名字里就能明白大家对你的感情了。"
        },
        {
          "role": "马坎尼",
          "text": "真是个好名字。"
        },
        {
          "role": "阿洛妮",
          "text": "我为你高兴，班尼特，我的孩子。看见你拥有着那么多爱你的人，看见你健健康康地长大…"
        },
        {
          "role": "班尼特",
          "text": "妈妈，你放心吧，我过得很好，大家都特别照顾我…"
        },
        {
          "role": "马坎尼",
          "text": "代表我和「燧石之锋」其他成员，感谢各位。哈哈，又一个奇迹！"
        },
        {
          "role": "马坎尼",
          "text": "我这辈子见过的奇迹够多了，但怎么也想不到还能有机会跟儿子说上话。我们还一起…"
        },
        {
          "role": "马坎尼",
          "text": "啊！"
        },
        {
          "role": "班尼特",
          "text": "怎么了，老爹？"
        },
        {
          "role": "马坎尼",
          "text": "我突然想起来了，我这几天跟你一起冒险的经历。"
        },
        {
          "role": "马坎尼",
          "text": "还有…早上那不是掰手腕，那怎么能是掰手腕呢！那是摔跤！"
        },
        {
          "role": "班尼特",
          "text": "呃…摔跤？"
        },
        {
          "role": "派蒙",
          "text": "对哦！这么说来，班尼特其实是…纳塔人？"
        },
        {
          "role": "玛拉妮",
          "text": "哎呀！一直和纳塔地脉断了联系？"
        },
        {
          "role": "派蒙",
          "text": "所以才会变得特别不幸，直到他重新返回纳塔吗？啊啊…"
        },
        {
          "role": "温迪",
          "text": "班尼特想不想留在纳塔？"
        },
        {
          "role": "玛拉妮",
          "text": "嗯，对…我可以帮你引荐大灵。你是更想去「沃陆之邦」还是「烟谜主」？"
        },
        {
          "role": "班尼特",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "烟谜主很酷。",
              "dialogues": []
            },
            {
              "text": "沃陆之邦不错。",
              "dialogues": []
            },
            {
              "text": "或许班尼特想回蒙德？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "这个问题也不用急着现在回答。"
        },
        {
          "role": "阿洛妮",
          "text": "旅行者，可以请你拿出纪念册吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在这里。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿洛妮",
          "text": "…嗯，这样就好了。"
        },
        {
          "role": "派蒙",
          "text": "破案了！原来是画片被直接掉包了！"
        },
        {
          "role": "阿洛妮",
          "text": "从哪里说起呢…成为阿夏后的我们失去了所有记忆，意识模模糊糊，连自己是谁都已经忘了，只留下行动的本能…"
        },
        {
          "role": "阿洛妮",
          "text": "我的性格不像马坎尼那么外向…原来性格这种因素，就算成了阿夏也改变不了啊。"
        },
        {
          "role": "马坎尼",
          "text": "然后呢？阿洛妮，你做什么了？"
        },
        {
          "role": "阿洛妮",
          "text": "从见到你们一行人起，我就跟在各位身后不远处，一路拍下了不少画片。"
        },
        {
          "role": "恰斯卡",
          "text": "度假村里到处都有阿夏，难怪我没有察觉到危险…"
        },
        {
          "role": "阿洛妮",
          "text": "隐约之间的熟悉感，回忆不清的往事吸引着我…"
        },
        {
          "role": "阿洛妮",
          "text": "跟随各位来到这里的时候，这个地方强烈地呼唤着我，让我深感不安…"
        },
        {
          "role": "阿洛妮",
          "text": "结果多亏了各位，但让大家置身险境也是不争的事实…我真的很抱歉。"
        },
        {
          "role": "玛拉妮",
          "text": "没关系的。"
        },
        {
          "role": "恰斯卡",
          "text": "你们也不容易…"
        },
        {
          "role": "温迪",
          "text": "嗯，嗯，要我说的话…"
        },
        {
          "role": "温迪",
          "text": "如果把命运比作一个巨大的车轮，我相信班尼特已经把最坎坷的部分翻过去了。这才是最重要的事。"
        },
        {
          "role": "班尼特",
          "text": "谢谢大家…唔，也谢谢爸妈…"
        },
        {
          "role": "班尼特",
          "text": "我真的很爱你们…"
        },
        {
          "role": "阿洛妮",
          "text": "我也爱你，我的孩子，收下这张画片，收好。"
        },
        {
          "role": "阿洛妮",
          "text": "我喜欢为你拍照的这个习惯，还是没有变啊…"
        },
        {
          "role": "班尼特",
          "text": "妈妈…"
        },
        {
          "type": "subtitle",
          "text": "班尼特和父母相拥在一起…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "温迪",
          "text": "「酣梦之子 / 握紧尾羽 / 莫在黎明前睁开眼眸」"
        },
        {
          "role": "温迪",
          "text": "「无法言说的凝注如此恒久 / 自天幕降下 / 直至托起白昼」"
        },
        {
          "role": "派蒙",
          "text": "你还真会挑时间…"
        },
        {
          "role": "温迪",
          "text": "当然咯，毕竟要是再晚一些的话，风就要吹来下一篇故事了噢。"
        },
        {
          "role": "派蒙",
          "text": "什么故事啊？"
        },
        {
          "role": "「律动魔匠」",
          "text": "呼，总算找到你们了！"
        },
        {
          "role": "班尼特",
          "text": "！"
        },
        {
          "role": "派蒙",
          "text": "还真有人来了？快快快挡一下！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么事吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「律动魔匠」",
          "text": "打扰英雄们了！提提岛的表演，也就是整个度假村最盛大的开业仪式快要开始了，就等你们过去呢。"
        },
        {
          "role": "玛拉妮",
          "text": "完了！现在是什么时候了？我差点忘的一干二净！我们快走吧！"
        },
        {
          "type": "subtitle",
          "text": "前往「热舞乐台」"
        },
        {
          "role": "玛拉妮",
          "text": "那「热舞乐台」就交给你喽，旅行者，我们去各就各位啦。"
        },
        {
          "role": "恰斯卡",
          "text": "等你的音乐和配合。"
        },
        {
          "role": "班尼特",
          "text": "辛苦大家！我和温迪老师会在台下为大家加油的。"
        },
        {
          "role": "马坎尼",
          "text": "我们也…"
        },
        {
          "role": "阿洛妮",
          "text": "嘘！"
        },
        {
          "role": "马坎尼",
          "text": "哦哦…"
        },
        {
          "role": "马坎尼",
          "text": "♪"
        },
        {
          "type": "subtitle",
          "text": "操作「热舞乐台」，完成演出"
        },
        {
          "role": "玛拉妮",
          "text": "鲨鲨冲呀！"
        },
        {
          "role": "玛拉妮",
          "text": "太爽了！呜呼——"
        },
        {
          "role": "玛拉妮",
          "text": "幸运炫彩！"
        },
        {
          "role": "玛拉妮",
          "text": "表演时间！"
        },
        {
          "type": "subtitle",
          "text": "挑战失败"
        },
        {
          "role": "玛拉妮",
          "text": "哎呀！配合出现事故了呢…别灰心，一起加把劲！"
        },
        {
          "role": "温迪",
          "text": "♪~"
        },
        {
          "role": "班尼特",
          "text": "让气氛嗨起来！"
        },
        {
          "role": "恰斯卡",
          "text": "一起飞吧！"
        },
        {
          "role": "恰斯卡",
          "text": "交给我！"
        },
        {
          "type": "subtitle",
          "text": "挑战失败"
        },
        {
          "role": "恰斯卡",
          "text": "走神了？我们再来一次吧。"
        },
        {
          "type": "subtitle",
          "text": "正在山上照顾小龙和小动物们的伊法向你打了个招呼…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "在醅幽花田的欧洛伦也向你打了招呼…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "「热舞乐台」绕着提提岛飞了一圈后回到了舞台上…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "[https://www.bilibili.com/video/BV1qNtAz9Eyd 过场动画「炽烈的惊喜」]"
        },
        {
          "role": "玛拉妮",
          "text": "现在，热烈邀请我们的火神大人登场！"
        },
        {
          "role": "观众们",
          "text": "竟然还有啊！"
        },
        {
          "role": "观众们",
          "text": "火神大人都来了！"
        },
        {
          "role": "观众们",
          "text": "玛薇卡大人——"
        },
        {
          "role": "玛薇卡",
          "text": "晚上好，朋友们！"
        },
        {
          "role": "玛薇卡",
          "text": "希望你们喜欢这个惊喜"
        },
        {
          "type": "subtitle",
          "text": "希诺宁、玛拉妮、基尼奇、欧洛伦、恰斯卡、伊安珊在台上进行乐队表演…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "玛薇卡",
          "text": "有没有人愿意登上台来，与我们共同狂欢？"
        },
        {
          "role": "温迪",
          "text": "不去吗？"
        },
        {
          "role": "班尼特",
          "text": "万一我突然运气不好，把表演弄砸了…"
        },
        {
          "type": "subtitle",
          "text": "阿洛妮和马坎尼把班尼特拽到了舞台上…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "旅行者",
          "text": "有大家的祝福，你就是我们的幸运之星"
        },
        {
          "type": "subtitle",
          "text": "班尼特感动地冲着你微笑，勇敢地跑向了舞台…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "玛薇卡",
          "text": "让我们欢迎这位勇敢的朋友！"
        },
        {
          "type": "subtitle",
          "text": "派蒙拽着你和温迪跑到了舞台上…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "伊法追着抢走了他帽子的咔库库也到了舞台上…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "阿夏们和班尼特合作让五彩斑斓的颜料在空中喷溅…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "观众们",
          "text": "哇——"
        },
        {
          "role": "观众们",
          "text": "好漂亮"
        },
        {
          "role": "咔库库",
          "text": "不会吧哥们——"
        },
        {
          "type": "subtitle",
          "text": "「热舞乐台」热烈地闪烁，你们在舞曲之中度过了一段美好的时光。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "玛薇卡",
          "text": "机会难得，台上的朋友们，要不要一起来拍张合照？"
        },
        {
          "role": "玛拉妮",
          "text": "要！！我来架留影机。"
        },
        {
          "role": "卡齐娜",
          "text": "噢！玛拉妮的动作好熟练…"
        },
        {
          "role": "派蒙",
          "text": "最近她拍了好多画片，快成专业的了。"
        },
        {
          "role": "玛薇卡",
          "text": "来吧，往中间靠，阿夏朋友们也是。"
        },
        {
          "role": "班尼特",
          "text": "…谢谢火神大人！"
        },
        {
          "role": "伊安珊",
          "text": "阿乔又被关起来了？"
        },
        {
          "role": "基尼奇",
          "text": "它一见到咔库库就要吵个不停。舞台够热闹了，不需要多余的噪音。"
        },
        {
          "role": "恰斯卡",
          "text": "咔库库呢？"
        },
        {
          "role": "伊法",
          "text": "还在享受阿夏蹦床，回头它肯定能学会阿夏的叫声了。"
        },
        {
          "role": "欧洛伦",
          "text": "又多一门外语？它长成了一只博学的龙，为它高兴。"
        },
        {
          "role": "希诺宁",
          "text": "头发上不再来点气氛？"
        },
        {
          "role": "玛薇卡",
          "text": "已经够热了吧？"
        },
        {
          "role": "瓦雷莎",
          "text": "和火山一样热——"
        },
        {
          "role": "玛拉妮",
          "text": "别聊啦别聊啦，都看镜头了没有？我要倒数喽？"
        },
        {
          "role": "玛拉妮",
          "text": "三、二、一——"
        },
        {
          "role": "派蒙",
          "text": "狂欢！"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-CG5-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "传说任务-惊遇！等待众人的将是…？-CG5-空.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "在舞台之外，班尼特与自己的父母聚在一起…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "马坎尼",
          "text": "…还真是交到了许多了不起的朋友呢。"
        },
        {
          "role": "班尼特",
          "text": "嗯…大家对我都挺好。"
        },
        {
          "role": "马坎尼",
          "text": "平时不挑食吧？也不熬夜吧？要是像你妈那样天天很晚才睡的话…"
        },
        {
          "role": "阿洛妮",
          "text": "咳咳…"
        },
        {
          "role": "马坎尼",
          "text": "呃…好吧，我不该啰嗦这么多…"
        },
        {
          "role": "班尼特",
          "text": "老爹…"
        },
        {
          "role": "马坎尼",
          "text": "过来…"
        },
        {
          "role": "班尼特",
          "text": "我想多听一点…"
        },
        {
          "role": "马坎尼",
          "text": "好。"
        },
        {
          "role": "马坎尼",
          "text": "这是一位团长对另一位团长要说的话。"
        },
        {
          "role": "马坎尼",
          "text": "我知道你很坚强，也很努力。但选择团队合作之路，只有自己坚强还不够。"
        },
        {
          "role": "马坎尼",
          "text": "记得我那时是怎么安慰你的吗？「从每段可贵的旅途中收获成果，目光放长一点。」"
        },
        {
          "role": "马坎尼",
          "text": "有朝一日，你会成为表率，肩负起大家的付出和信赖，那时，就靠你安慰自己的团员了。"
        },
        {
          "role": "班尼特",
          "text": "嗯…我记住了。"
        },
        {
          "role": "马坎尼",
          "text": "我们的冒险团叫「燧石之锋」，它象征的是火种的传承。"
        },
        {
          "role": "马坎尼",
          "text": "但在生下你这个小火种之后，我们的想法也产生了许多变化。"
        },
        {
          "role": "马坎尼",
          "text": "其中最重要的一点就是…你不需要延续我们的使命。你有自己的路要走，对吗？"
        },
        {
          "role": "班尼特",
          "text": "老爹…"
        },
        {
          "role": "马坎尼",
          "text": "嗯，接下去，就该是老爹想说的话了…其实我还不老，但既然你这么叫了…"
        },
        {
          "role": "马坎尼",
          "text": "我的孩子，在你出生之前，我们就深深地爱着你。在你成长路上，还有那么多爱你的朋友陪伴着你。"
        },
        {
          "role": "马坎尼",
          "text": "别忘了你的「老爹们」，是他们给了你这个饱含祝福的名字。"
        },
        {
          "role": "马坎尼",
          "text": "无论你最后选择去哪里，无论你将要踏上怎样的旅程，作为父母，我们都会支持你的决定。"
        },
        {
          "role": "马坎尼",
          "text": "所以啊…"
        },
        {
          "role": "马坎尼",
          "text": "自信地、勇敢地活下去吧，我的孩子。像你那位朋友说的，你就是我们的「幸运之星」。"
        },
        {
          "role": "班尼特",
          "text": "呜呜…"
        },
        {
          "role": "阿洛妮",
          "text": "你怎么又把孩子说哭了。"
        },
        {
          "role": "马坎尼",
          "text": "这不怪我…"
        },
        {
          "role": "阿洛妮",
          "text": "还不怪你？"
        },
        {
          "role": "马坎尼",
          "text": "我…我闭嘴。"
        },
        {
          "role": "阿洛妮",
          "text": "班尼特？"
        },
        {
          "role": "班尼特",
          "text": "呜，妈妈，我听着…"
        },
        {
          "role": "阿洛妮",
          "text": "别听你爹絮叨了半天，其实啊，你妈妈一直比你爹聪明。"
        },
        {
          "role": "班尼特",
          "text": "妈…"
        },
        {
          "role": "阿洛妮",
          "text": "…看见你的第一眼，我就放心了。"
        },
        {
          "role": "阿洛妮",
          "text": "你眼中闪烁着你爹的勇敢和我的好奇心。没有困难能将你绊倒。"
        },
        {
          "role": "班尼特",
          "text": "妈…我在笑了，我真的在笑了…"
        },
        {
          "role": "阿洛妮",
          "text": "我知道，我一直知道。"
        },
        {
          "type": "subtitle",
          "text": "天渐渐亮了起来…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "班尼特",
          "text": "已经要走了吗？"
        },
        {
          "role": "阿洛妮",
          "text": "……"
        },
        {
          "role": "马坎尼",
          "text": "该说的都说好啦，这次我也放心了。"
        },
        {
          "role": "班尼特",
          "text": "……"
        },
        {
          "role": "班尼特",
          "text": "相信我吧，爸妈，我一定会成为提瓦特最伟大的传奇冒险家！"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "班尼特…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "走吧…",
              "dialogues": []
            },
            {
              "text": "我们去陪陪他。",
              "dialogues": []
            }
          ]
        },
        {
