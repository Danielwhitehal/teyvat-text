{
  "quest_id": 76085,
  "chapter_num": null,
  "chapter_title": "月下小酌",
  "type": "wq",
  "route": "A Toast Beneath the Moon",
  "stories": [
    {
      "story_id": 76085,
      "title": "月下小酌",
      "description": "在「银月之庭」，「少女」似乎有想做的事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同「少女」见面"
        },
        {
          "role": "「少女」",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅，你还好吗？看上去有点没精打采呢。"
        },
        {
          "role": "「少女」",
          "text": "是你们啊。我没事…"
        },
        {
          "role": "旅行者",
          "text": "（是又在思考关于「月亮」的问题了吗…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么能为你做的吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "我…"
        },
        {
          "role": "「少女」",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "没关系，就算只是些小烦恼，说出来也会好些哦。"
        },
        {
          "role": "「少女」",
          "text": "我有点…想喝酒馆里的饮品。"
        },
        {
          "role": "派蒙",
          "text": "欸？"
        },
        {
          "role": "「少女」",
          "text": "…唔。"
        },
        {
          "role": "派蒙",
          "text": "抱歉！刚才我有点惊讶。因为你很少会提你自己想要什么东西嘛…"
        },
        {
          "role": "派蒙",
          "text": "而且，居然只是…饮品。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是觉得太简单了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "可能我以为至少也得是「为我摘下月亮吧」这种级别的愿望…"
        },
        {
          "role": "派蒙",
          "text": "啊，不过我似乎可以理解。现在哥伦比娅无法随心所欲地行动，去酒馆说不定和摘月亮差不多难呢…"
        },
        {
          "role": "「少女」",
          "text": "不只是现在。以前在「愚人众」的时候没人要抓我，但出门散步的时候，大家还是躲得远远的。"
        },
        {
          "role": "旅行者",
          "text": "（执行官第三席…这个名号的确会让不了解她的人害怕吧…）"
        },
        {
          "role": "派蒙",
          "text": "咦？不过…我突然觉得这愿望也不是那么难！"
        },
        {
          "role": "派蒙",
          "text": "只要求酒馆水平的饮品的话，玩家，你不是就会做嘛！"
        },
        {
          "role": "「少女」",
          "text": "…真的？"
        },
        {
          "role": "派蒙",
          "text": "看你那么期待的样子，我反倒要紧张起来了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "口味上有要求吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "口味…"
        },
        {
          "role": "「少女」",
          "text": "我没怎么尝试过外面的饮品，反而给不出具体的方向…"
        },
        {
          "role": "「少女」",
          "text": "不要太厚重的？"
        },
        {
          "role": "派蒙",
          "text": "厚重是什么意思？"
        },
        {
          "role": "「少女」",
          "text": "像「愚人众」的大衣一样。"
        },
        {
          "role": "派蒙",
          "text": "怎么越比喻还越模糊了啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大概是想要清香淡雅的饮品…",
              "dialogues": []
            },
            {
              "text": "交给我吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "好啊。交给你定。"
        },
        {
          "type": "subtitle",
          "text": "「少女」将月亮石像放倒作为桌面…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "调制饮品"
        },
        {
          "type": "subtitle",
          "text": "玩法教学"
        },
        {
          "type": "subtitle",
          "text": "根据材料清单，加入对应数量与种类的材料，即可完成调制。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "如果调制有误，可以选择「重调」以重新进行这一轮调制。",
          "narration": true
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调制饮品",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "给她做杯什么好呢…"
        },
        {
          "type": "subtitle",
          "text": "调制错误"
        },
        {
          "role": "派蒙",
          "text": "好像哪里弄错了…再调一次吧。"
        },
        {
          "type": "subtitle",
          "text": "材料清单"
        },
        {
          "role": "'图书馆'",
          "text": "[[file:曲生酌微梦-咖啡.png|link=|30px]]咖啡*3"
        },
        {
          "role": "'北风之望'",
          "text": "[[file:曲生酌微梦-牛奶.png|link=|30px]]牛奶+[[file:曲生酌微梦-薄荷.png|link=|30px]]薄荷+[[file:曲生酌微梦-红茶.png|link=|30px]]红茶"
        },
        {
          "role": "'苍谷落日'",
          "text": "[[file:曲生酌微梦-果汁.png|link=|30px]]果汁*3"
        },
        {
          "role": "派蒙",
          "text": "哇，连我都忍不住想喝一杯了！/哦！好浓郁的香气，也不知道哥伦比娅有没有喝过类似的饮品。"
        },
        {
          "type": "subtitle",
          "text": "同「少女」对话"
        },
        {
          "type": "subtitle",
          "text": "图书馆"
        },
        {
          "role": "「少女」",
          "text": "我闻过这个气味。"
        },
        {
          "role": "派蒙",
          "text": "噢？在哪里？"
        },
        {
          "role": "「少女」",
          "text": "桑多涅的房间。她看我好像对散发这种香味的饮品很感兴趣，故意拿在手上好半天都没喝完。"
        },
        {
          "role": "「少女」",
          "text": "就像…在等我提问一样。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你问了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "嗯。"
        },
        {
          "role": "派蒙",
          "text": "问的什么？"
        },
        {
          "role": "「少女」",
          "text": "「你不应该喝机油吗？」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她…怎么说？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "嗯…"
        },
        {
          "role": "「少女」",
          "text": "很难听的话。不要学。"
        },
        {
          "role": "「少女」",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "才喝一口就不感兴趣了呀！"
        },
        {
          "role": "「少女」",
          "text": "对不起，有点苦，不好喝。难怪桑多涅脸色那么难看。"
        },
        {
          "role": "派蒙",
          "text": "我觉得那个是因为别的原因…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「少女」）"
        },
        {
          "role": "「少女」",
          "text": "嗯…谢谢你满足了我的好奇心。下次我不会再相信桑多涅的口味了。"
        },
        {
          "type": "subtitle",
          "text": "北风之望"
        },
        {
          "role": "「少女」",
          "text": "嗯…"
        },
        {
          "role": "派蒙",
          "text": "怎么样怎么样？"
        },
        {
          "role": "「少女」",
          "text": "它让我回想起了非常久远的过去，那时我和「霜月之子」生活在一起…"
        },
        {
          "role": "「少女」",
          "text": "他们习惯将新鲜的薄荷叶、香料和浆果干共同冲泡，制成具有混合风味的饮品。"
        },
        {
          "role": "「少女」",
          "text": "每次经过窗边的时候，我总会闻见小屋里飘出淡淡的草木清香…"
        },
        {
          "role": "派蒙",
          "text": "后来呢？你尝了吗？"
        },
        {
          "role": "「少女」",
          "text": "试过，但没喝成。"
        },
        {
          "role": "派蒙",
          "text": "欸？为什么…"
        },
        {
          "role": "「少女」",
          "text": "「神明大人」突然说出「能尝尝你家的茶吗？」这种话之后…没人敢真的将家中的「粗茶」献上…"
        },
        {
          "role": "派蒙",
          "text": "啊，也是呢…"
        },
        {
          "role": "「少女」",
          "text": "最后到我手中，就变成了在华美包装下「献予神明」的「贡品」。"
        },
        {
          "role": "「少女」",
          "text": "不是说它难喝。但…它少了某种我路过窗边时闻到的…温馨的味道。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "现在可以喝个够了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "嗯…"
        },
        {
          "role": "「少女」",
          "text": "很美味。"
        },
        {
          "role": "「少女」",
          "text": "…不过，倒是很少见到加入牛奶的做法。"
        },
        {
          "role": "派蒙",
          "text": "毕竟是从蒙德带来的配方嘛，他们喝茶还挺喜欢加牛奶、奶油和糖的。"
        },
        {
          "role": "「少女」",
          "text": "很新奇，感觉还不错。"
        },
        {
          "role": "派蒙",
          "text": "呼，你喜欢就好！"
        },
        {
          "role": "「少女」",
          "text": "嗯，谢谢你们。"
        },
        {
          "role": "「少女」",
          "text": "原来不止月光能映照往事，饮品的芳香，也能唤起深藏于过去的风景…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「少女」）"
        },
        {
          "role": "「少女」",
          "text": "下次还想喝其他饮品的话，可以再麻烦你们吗？"
        },
        {
          "type": "subtitle",
          "text": "苍谷落日"
        },
        {
          "role": "「少女」",
          "text": "咕嘟…咕嘟…"
        },
        {
          "role": "派蒙",
          "text": "一口气全喝完了！太好了，她看起来是很喜欢的样子呢。"
        },
        {
          "role": "「少女」",
          "text": "没什么味道。"
        },
        {
          "role": "派蒙",
          "text": "没…没什么味道？"
        },
        {
          "role": "「少女」",
          "text": "嗯。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是不是喝太快了…",
              "dialogues": []
            },
            {
              "text": "要不我再调一杯？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "噢，不用了，谢谢。"
        },
        {
          "role": "「少女」",
          "text": "曾经，我无法理解人们所说的那种丰收的喜悦，直到有天，我亲手触碰了枝头成熟的果实…"
        },
        {
          "role": "「少女」",
          "text": "我能从果皮的纹理中感受到它的生命力，它将来自阳光、水土和空气的养分转化成了这种形式。"
        },
        {
          "role": "「少女」",
          "text": "伴随着咀嚼时的脆响，鲜甜的滋味像沁凉白浪一般层层翻涌而来。"
        },
        {
          "role": "「少女」",
          "text": "于是我明白了，香气是一种谁也逃不开的引力。"
        },
        {
          "role": "派蒙",
          "text": "哦！不错的感想呢！"
        },
        {
          "role": "「少女」",
          "text": "我们以夺走这种生命力的方式完成了自然的转化。"
        },
        {
          "role": "派蒙",
          "text": "突然就变得残酷了起来？！"
        },
        {
          "role": "「少女」",
          "text": "所以我更喜欢新鲜的水果，它让我知道我从这个世界原原本本地取走了什么。"
        },
        {
          "role": "「少女」",
          "text": "这也是我应当回报这个世界的…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「少女」）"
        },
        {
          "role": "「少女」",
          "text": "白灵果给你。慢慢嚼嚼看吧，很甜。"
        }
      ],
