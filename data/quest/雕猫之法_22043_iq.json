{
  "quest_id": 22043,
  "chapter_num": null,
  "chapter_title": "雕猫之法",
  "type": "iq",
  "route": "To Make a Cat Carving",
  "stories": [
    {
      "story_id": 22043,
      "title": "雕猫之法",
      "description": "在浅濑神社工作的大岛纯平似乎正在为某事而发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与大岛纯平对话"
        },
        {
          "role": "大岛纯平",
          "text": "木头怎么又用完了…"
        },
        {
          "role": "大岛纯平",
          "text": "哦！旅行者，你来得正好，你愿意帮我个忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么忙？",
              "dialogues": []
            },
            {
              "text": "你在做什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "我最近，正尝试着按照代宫司大人的模样雕刻一些尺寸很小的木雕。"
        },
        {
          "role": "大岛纯平",
          "text": "我想，等我雕得好一些之后，就带着这些木雕回鸣神岛去，看看能不能卖出去…"
        },
        {
          "role": "大岛纯平",
          "text": "如果真能卖出去的话，应该也能算是一份稳定的收入了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "应该能卖出去。",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "哈哈哈，那我就借你吉言了。"
                },
                {
                  "role": "大岛纯平",
                  "text": "不过，我也对代宫司大人的魅力很有信心啦，嘿嘿。"
                }
              ]
            },
            {
              "text": "怎么突然开始做木雕了？",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "你问这个啊…那个，你知道代宫司大人给我的「报酬」是什么吗？"
                },
                {
                  "role": "大岛纯平",
                  "text": "是一些…瓶瓶罐罐，杯杯盏盏之类的东西。"
                },
                {
                  "role": "大岛纯平",
                  "text": "虽然看起来有点旧了，但我拿回去给人看了之后，发现这些东西居然还颇有些年头，而且也能卖一点钱。"
                },
                {
                  "role": "大岛纯平",
                  "text": "不过把那些东西拿去卖钱的过程可折腾了，每次都把我累得够呛…"
                },
                {
                  "role": "大岛纯平",
                  "text": "而且，这样子的收入也不稳定…要是代宫司大人哪一天找不出这些东西了，我不就又等于失业了吗…"
                },
                {
                  "role": "大岛纯平",
                  "text": "所以，我正想办法开辟一条新的生意路。"
                }
              ]
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "啊…先不说这些了，我们说正事…"
        },
        {
          "role": "大岛纯平",
          "text": "其实，最近我手上用来练习木雕的木材有些不够用了。"
        },
        {
          "role": "大岛纯平",
          "text": "旅行者，能请你帮我去外面搜集10份「御伽木」来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "那就拜托你了，旅行者，真是帮大忙了。"
                }
              ]
            },
            {
              "text": "要这么多吗？",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "毕竟我刚开始练习木雕不久…多备一些材料总是好的。"
                },
                {
                  "role": "大岛纯平",
                  "text": "那就拜托你了，旅行者。"
                }
              ]
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "你搜集到御伽木后，就快点带来给我吧。"
        },
        {
          "type": "subtitle",
          "text": "将10份「御伽木」交给大岛纯平"
        },
        {
          "role": "大岛纯平",
          "text": "怎么样，你搜集到10份「御伽木」了吗？"
        },
        {
          "type": "subtitle",
          "text": "与大岛纯平对话"
        },
        {
          "role": "大岛纯平",
          "text": "嗯，这些应该就够用了。抱歉啊，你好不容易过来神社，我还拜托你帮忙…这些东西你先收下吧。"
        },
        {
          "role": "大岛纯平",
          "text": "等我木雕的手艺练好了，我一定送你一座最好的木雕。"
        },
        {
          "role": "大岛纯平",
          "text": "唔，接下来雕个什么样的代宫司大人好呢…"
        }
      ]
    }
  ]
}