{
  "quest_id": 70802,
  "chapter_num": null,
  "chapter_title": "白皑谜影·希望",
  "type": "wq",
  "route": "Snowy Silhouette: Hope",
  "stories": [
    {
      "story_id": 70802,
      "title": "白皑谜影·希望",
      "description": "据乔尔说，塞琉斯先生找到了和他父亲有关的线索…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与乔尔对话"
        },
        {
          "role": "乔尔",
          "text": "这次，真的能找到爸爸吗…"
        },
        {
          "role": "旅行者",
          "text": "你爸爸有消息了吗？"
        },
        {
          "role": "乔尔",
          "text": "大哥哥，是你呀。"
        },
        {
          "role": "乔尔",
          "text": "帕拉德哥哥和我说，塞琉斯叔叔好像找到了和我爸爸有关的消息。"
        },
        {
          "role": "乔尔",
          "text": "虽然他还不能确定…但帕拉德哥哥说，这次他们找到的线索很有力，说不定真能找到我爸爸。"
        },
        {
          "role": "乔尔",
          "text": "我想要和他们一起进雪山去，但塞琉斯叔叔要我留在营地里，有了消息他们自然会告诉我…"
        },
        {
          "role": "乔尔",
          "text": "大哥哥，如果可以的话，你能帮我去向塞琉斯叔叔打听一下消息吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": []
            },
            {
              "text": "你为什么不自己去问？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "乔尔",
          "text": "我、我害怕听到…不好的消息…"
        },
        {
          "role": "乔尔",
          "text": "总之，拜托你了！大哥哥！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（乔尔）"
        },
        {
          "role": "乔尔",
          "text": "大哥哥，请帮我去向塞琉斯叔叔打听一下消息吧。"
        },
        {
          "type": "subtitle",
          "text": "前往冒险家协会"
        },
        {
          "role": "塞琉斯",
          "text": "居然在这个区域…帕拉德，你确定吗？"
        },
        {
          "role": "冒失的帕拉德",
          "text": "我很确定，塞琉斯先生。"
        },
        {
          "role": "旅行者",
          "text": "你们在讨论乔尔父亲的事吗？"
        },
        {
          "role": "塞琉斯",
          "text": "这不是旅行者吗？看来你是从乔尔那边过来的啊。"
        },
        {
          "role": "塞琉斯",
          "text": "那孩子，每天都要拜托人从我这里打听消息…"
        },
        {
          "role": "塞琉斯",
          "text": "不过，这次我可是要带给他一个大大的好消息。"
        },
        {
          "role": "塞琉斯",
          "text": "前段时间，我们冒险家协会刚刚组织了一场「雪山特训」…"
        },
        {
          "role": "冒失的帕拉德",
          "text": "接下来的就由我说吧，塞琉斯先生。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "在参加那场特训的途中，我因为风雪太大而偏离了预定的路线。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "当我摸索着准备回到路线上时，突然在一处山崖上，看见了一个模糊的人影。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "我最开始还以为是一个和我一样迷路的冒险家，就大声喊他。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "但是，在吸引到那个人的注意力之前…我的喊声先引来了魔物。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "在雪山的那种环境里，我没有打倒那些魔物的自信，只能先撤退了。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "回来之后，我就把这件事和塞琉斯先生说了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那个人影就是乔尔的父亲？",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "我们也不能确定。"
                }
              ]
            },
            {
              "text": "也许是另外哪位迷路的冒险家…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塞琉斯",
          "text": "无论如何，至少我们知道了有人被困在雪山里，必须要组织营救行动。"
        },
        {
          "role": "塞琉斯",
          "text": "至于那个人到底是不是乔尔的父亲乔瑟夫先生…就只能看运气了。"
        },
        {
          "role": "塞琉斯",
          "text": "总之，我已经让协会里有能力进入雪山的人都去展开搜救了。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "我也准备一下，等会就去雪山里参加搜救。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我和你一起去。",
              "dialogues": []
            },
            {
              "text": "我去打倒那些魔物。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "冒失的帕拉德",
          "text": "你愿意帮忙吗？太好了，那我们就一起出发吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（塞琉斯）"
        },
        {
          "role": "塞琉斯",
          "text": "必须得抓紧时间了…"
        },
        {
          "type": "subtitle",
          "text": "前往雪山，搜寻线索"
        },
        {
          "role": "冒失的帕拉德",
          "text": "呼…真是够冷的，应该就是这附近了…"
        },
        {
          "role": "冒失的帕拉德",
          "text": "居然还有这么多魔物…"
        },
        {
          "role": "冒失的帕拉德",
          "text": "那就拜托你了，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "type": "subtitle",
          "text": "和帕拉德对话"
        },
        {
          "role": "冒失的帕拉德",
          "text": "这周围总算安全点了，多谢啦。"
        },
        {
          "role": "旅行者",
          "text": "关于乔瑟夫先生…"
        },
        {
          "role": "冒失的帕拉德",
          "text": "唉，我刚才也没发现什么新线索。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "不过，既然这周围都安全了，那我也会继续搜索的。"
        },
        {
          "role": "冒失的帕拉德",
          "text": "请你先回协会一趟，告诉塞琉斯先生我已经开始搜索工作了吧。"
        },
        {
          "type": "subtitle",
          "text": "和塞琉斯对话"
        },
        {
          "role": "塞琉斯",
          "text": "旅行者，你回来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "帕拉德已经开始搜索了。",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "嗯，那家伙偶尔还是能干点正事的嘛…"
                }
              ]
            },
            {
              "text": "真的能找到那个人吗？",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "这我…不能保证。只能说，我们会尽最大的努力。"
                }
              ]
            }
          ]
        },
        {
          "role": "塞琉斯",
          "text": "等我整理一下手上的情报之后，也会去雪山那边见见乔尔那孩子，把事情详细地讲给他听。"
        },
        {
          "role": "塞琉斯",
          "text": "旅行者，请你先去告诉乔尔，我等一下就会过去。"
        },
        {
          "role": "塞琉斯",
          "text": "我整理情报还要些时间，可别让那孩子等急了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（塞琉斯）"
        },
        {
          "role": "塞琉斯",
          "text": "旅行者，请你先去告诉乔尔，我等一下就会过去。"
        },
        {
          "role": "塞琉斯",
          "text": "我整理情报还要些时间，可别让那孩子等急了。"
        },
        {
          "type": "subtitle",
          "text": "向乔尔回报"
        },
        {
          "role": "乔尔",
          "text": "大哥哥，你帮我打听到什么消息了吗？"
        },
        {
          "type": "subtitle",
          "text": "旅行者向乔尔转述了塞琉斯的话…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "乔尔",
          "text": "也就是说…塞琉斯叔叔还没有找到我爸爸…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "相信塞琉斯先生吧。",
              "dialogues": []
            },
            {
              "text": "已经找到线索了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "乔尔",
          "text": "嗯，我知道。等塞琉斯叔叔来了，我会再详细问他的，谢谢你，大哥哥。"
        },
        {
          "role": "乔尔",
          "text": "爸爸…你到底在哪啊…"
        }
      ],
      "collapse_ranges": [
        [
          11,
