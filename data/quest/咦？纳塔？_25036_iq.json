{
  "quest_id": 25036,
  "chapter_num": null,
  "chapter_title": "咦？纳塔？",
  "type": "iq",
  "route": "Hmm? Natlan?",
  "stories": [
    {
      "story_id": 25036,
      "title": "咦？纳塔？",
      "description": "在圣火竞技场，你被一个人叫住了…",
      "dialogues": [
        {
          "role": "凯塔",
          "text": "…果然这个问题还是太简单了吗？"
        },
        {
          "role": "凯塔",
          "text": "喔。真不好意思，我刚才在思考，没注意到您过来了。"
        },
        {
          "role": "凯塔",
          "text": "向您问好。我是「烟谜主」的凯塔，正在这里做学徒，负责管理资料。"
        },
        {
          "role": "旅行者",
          "text": "你在思考什么问题？"
        },
        {
          "role": "凯塔",
          "text": "啊…只是一些有关纳塔的过去，当下和未来的简单问题，不值一提。"
        },
        {
          "role": "凯塔",
          "text": "您看起来是一位来自远方的旅者。我能感觉到，你交游良多，所思甚广…"
        },
        {
          "role": "凯塔",
          "text": "如果您愿意的话，可以试试体验一下我已经记录在册的问题。"
        },
        {
          "role": "凯塔",
          "text": "这些问题的答案就在您的旅途之中——无论过去，当下还是未来的旅途。"
        },
        {
          "type": "subtitle",
          "text": "与凯塔对话"
        },
        {
          "role": "凯塔",
          "text": "您准备好体验那些问题了吗？"
        },
        {
          "type": "subtitle",
          "text": "与凯塔对话"
        },
        {
          "role": "旅行者",
          "text": "我想试试。"
        },
        {
          "role": "凯塔",
          "text": "唔，果决爽利，值得称赞。"
        },
        {
          "role": "旅行者",
          "text": "稍等一下…"
        },
        {
          "role": "凯塔",
          "text": "嗯，不急一时，我可静待。"
        }
      ]
    }
  ]
}