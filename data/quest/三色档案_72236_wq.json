{
  "quest_id": 72236,
  "chapter_num": null,
  "chapter_title": "三色档案",
  "type": "wq",
  "route": "Tricolor File",
  "stories": [
    {
      "story_id": 72236,
      "title": "三色档案",
      "description": "宫地不想交出实验记录一定事出有因，你决定继续调查…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆与禁区的残影对话"
        },
        {
          "role": "？？？",
          "text": "哼，渊下宫最后一天，你们都来了三波人了。"
        },
        {
          "role": "？？？",
          "text": "你要是想回收实验记录，那我无可奉告。你让厄伯斯派和珊瑚宫派先吵完架再说这事吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "未接取[[龙蛇藏归辑录]]任务",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "渊下宫这种夜里到处都是过去残影的地方，「过去」、「纪录」、「历史」什么的…"
                },
                {
                  "role": "？？？",
                  "text": "根本没必要，还很危险。"
                },
                {
                  "role": "派蒙",
                  "text": "（这个人似乎还不知道自己也是残影哦。）"
                },
                {
                  "role": "派蒙",
                  "text": "我们不是来回收实验记录的。"
                },
                {
                  "role": "？？？",
                  "text": "哦，这样啊。那快点离开吧。"
                },
                {
                  "role": "？？？",
                  "text": "不对…一般人哪有本事闲逛到这个地方。你们难道是地走官吗，是珊瑚宫想要灭我们的口来保密了吗？"
                }
              ]
            },
            {
              "text": "已接取[[龙蛇藏归辑录]]任务",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "我反正站珊瑚宫派。这些实验记录永远埋葬在黑暗里比较好。"
                },
                {
                  "role": "派蒙",
                  "text": "实验记录…"
                },
                {
                  "role": "？？？",
                  "text": "哦？你们不是来回收实验记录的啊。那快点离开吧。"
                },
                {
                  "role": "？？？",
                  "text": "不过一般人哪有本事闲逛到这个地方。你们难道是地走官吗，是珊瑚宫想要灭我们的口来保密了吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不是啦不是！我们只是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "未接取[[龙蛇藏归辑录]]任务",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "我们前来清点物资。"
                },
                {
                  "role": "？？？",
                  "text": "哼。这是什么没同步到我这里的暗号吗？不过罢了，你既然能来这里，靠我想拦你也是拦不住的。"
                },
                {
                  "role": "派蒙",
                  "text": "啊哈哈，你看，今天是渊下宫最后一天嘛。提前来看看，估算一下搬运需要多少人手。"
                },
                {
                  "role": "？？？",
                  "text": "请便吧。但是注意不要把方碑激活了。"
                }
              ]
            },
            {
              "text": "已接取[[龙蛇藏归辑录]]任务",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "你，觉悟不错啊。"
                },
                {
                  "role": "？？？",
                  "text": "什么意思？"
                },
                {
                  "role": "旅行者",
                  "text": "我们是来检视你工作的。"
                },
                {
                  "role": "？？？",
                  "text": "哼…"
                },
                {
                  "role": "旅行者",
                  "text": "我们前来检查记录的密保措施。"
                },
                {
                  "role": "？？？",
                  "text": "…反正你们能来到此地，料想也不是泛泛之辈。但我不管你究竟是哪边的人，还是离这里远点比较好。"
                },
                {
                  "role": "？？？",
                  "text": "记录被我放在了所内深处，打开通路需要激活元素方碑。换句话说，需要释放强大的元素力。"
                }
              ]
            }
          ]
        },
        {
          "role": "？？？",
          "text": "所有人离开白夜国后，这里的深海龙蜥就会被放出来。而它们被培养成了对特定元素起反应的体质。"
        },
        {
          "role": "？？？",
          "text": "这里的深海龙蜥可都是强化品种，而且特征遗传给子代的概率很高。数载之后，这里将常年盘踞强大的深海龙蜥族群。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "未接取[[龙蛇藏归辑录]]任务",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "虽然它们现在还关着，但是察觉到元素力，躁动起来的话我还是很头疼的。"
                },
                {
                  "role": "派蒙",
                  "text": "你这是想干什么。"
                },
                {
                  "role": "？？？",
                  "text": "用来把手实验记录啊。可能还有一些稀奇古怪的资料吧，那些都不需要你们搬运。不用在意。"
                }
              ]
            },
            {
              "text": "已接取[[龙蛇藏归辑录]]任务",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "因此，实验记录安全得很。"
                },
                {
                  "role": "旅行者",
                  "text": "把它烧了不是更加安全？"
                },
                {
                  "role": "？？？",
                  "text": "我是赞成这么做的，但是研究人员里面也分派系。我也不是不能理解另一派人的想法。"
                },
                {
                  "role": "？？？",
                  "text": "「我们是拯救海祇的英雄了！」、「我们这下变成混蛋了…」——确实都有道理。"
                },
                {
                  "role": "？？？",
                  "text": "把真相留到一个可以原谅我们的时代，也是一个我可以接受的方案。"
                }
              ]
            }
          ]
        },
        {
          "role": "？？？",
          "text": "看你也不是一般人，就算不是地走官也是什么珊瑚宫近臣了。"
        },
        {
          "role": "宫地",
          "text": "帮我给大人物们带个话吧：宫地他会在禁区里待到离开的前一刻，确保再也没有人出现在附近。"
        },
        {
          "role": "派蒙",
          "text": "所以你就是宫地对吧？"
        },
        {
          "role": "宫地",
          "text": "嗯哼，不过到海面之上就要换个名字开始新生活了。不过，罪孽是没办法和老名字一样轻易抛弃的。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "宫地",
          "text": "哼，其他的事情我无可奉告。"
        },
        {
          "type": "subtitle",
          "text": "◆在实验区域寻找实验记录"
        },
        {
          "role": "派蒙",
          "text": "你套话的本事又进步了啊。"
        },
        {
          "role": "派蒙",
          "text": "他刚才说了什么来着？想要拿到记录需要激活方碑。"
        },
        {
          "role": "派蒙",
          "text": "但是方碑会引来危险的深海龙蜥。要事先做好准备才行。"
        }
      ],
      "collapse_ranges": [
        [
          13,
          14
        ]
      ]
    }
  ]
}