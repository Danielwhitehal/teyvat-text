{
  "quest_id": 76653,
  "chapter_num": null,
  "chapter_title": "走失的创意",
  "type": "wq",
  "route": "Misplaced Creativity",
  "stories": [
    {
      "story_id": 76653,
      "title": "走失的创意",
      "description": "来自枫丹的研究员茜涅特设计了一种机器人，但是各种突发故障让她不得不向爱诺求助…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与茜涅特对话"
        },
        {
          "role": "茜涅特",
          "text": "到底是哪里出错了呢？只有理论知识的话果然还是…"
        },
        {
          "role": "爱诺",
          "text": "这位的订单就不用确认了…茜涅特，来自枫丹的工程师…这个订单是我最感兴趣的！"
        },
        {
          "role": "茜涅特",
          "text": "您终于来了！那就还有希望…"
        },
        {
          "role": "派蒙",
          "text": "你好，我们算是爱诺的助手哦。话说这位需要我们帮什么忙？"
        },
        {
          "role": "爱诺",
          "text": "她设计了一种可以利用月矩力进行远距离交流的机器人，特别好玩！但是故障太多了，所以只能来找我调试。"
        },
        {
          "role": "茜涅特",
          "text": "真是惭愧，只是抱着试一试的好奇心根本做不出成果，最终还是要靠实践…"
        },
        {
          "role": "派蒙",
          "text": "听上去不是什么麻烦事，那就交给我们吧！"
        },
        {
          "role": "茜涅特",
          "text": "说起来有些不好意思…我希望能修改一下订单的内容。之前等待回复的时候没有其他事情做，我又搞砸了一些事情…"
        },
        {
          "role": "茜涅特",
          "text": "我忽然很好奇换个环境能不能解决故障的问题，就找了几个月矩力不同的区域，分别测试了一下。"
        },
        {
          "role": "茜涅特",
          "text": "结果，机器人还是发生了故障，全部失联…所以，除了之前约好的调试之外，能不能也帮我把那些机器人找回来？"
        },
        {
          "role": "派蒙",
          "text": "全丢了？"
        },
        {
          "role": "茜涅特",
          "text": "如果需要支付额外的报酬，我会想办法的！"
        },
        {
          "role": "爱诺",
          "text": "嗯…对应的探测手段有很多，那些机器人都是用月矩力驱动的，它们活动过的地方会留下一些「月矩力纹样」。"
        },
        {
          "role": "爱诺",
          "text": "我会给你们准备一种特殊的仪器，只要用它收集足够多的「月矩力纹样」，就可以探测到对应的机器人藏在哪里。"
        },
        {
          "role": "爱诺",
          "text": "唔…估计会很好玩，看在这一点的份上，就不收取额外的费用了。"
        },
        {
          "role": "茜涅特",
          "text": "真的？非常感谢！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（茜涅特）"
        },
        {
          "role": "茜涅特",
          "text": "你们能帮我调试，非常感谢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于机器人。",
              "dialogues": [
                {
                  "role": "茜涅特",
                  "text": "我的机器人其实是用爱诺发明的显像机关改造的，利用月矩力这一点其实参考了她最近的作品，她真的是一个天才！"
                },
                {
                  "role": "茜涅特",
                  "text": "但等到真的让我自己去实现这一点的时候，我才发现有多难…果然还是要向前辈虚心学习。"
                }
              ]
            },
            {
              "text": "关于故障。",
              "dialogues": [
                {
                  "role": "茜涅特",
                  "text": "说来惭愧，最初的故障都源自我的一些「创意」。我想实验一些新的东西，结果几乎都搞砸了。"
                },
                {
                  "role": "茜涅特",
                  "text": "但是，如果有爱诺亲自制作的显像机关帮忙测试，这些「创意」却大多能顺利运行，真不知道这其中的原理是什么…"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          17,
          19
        ]
      ]
    }
  ]
}