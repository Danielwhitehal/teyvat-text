{
  "quest_id": 20005,
  "chapter_num": null,
  "chapter_title": "钥匙是易丢品",
  "type": "iq",
  "route": "Lost Key",
  "stories": [
    {
      "story_id": 20005,
      "title": "钥匙是易丢品",
      "description": "押送着货车的怀尔德酷爱喝酒，但是在一次大醉之后，他的钥匙被自己弄丢了。尝试跟随着怀尔德脚印的痕迹寻找钥匙，并交还给他。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往询问怀尔德"
        },
        {
          "role": "怀尔德",
          "text": "旅行者，你，你来的正好。"
        },
        {
          "role": "怀尔德",
          "text": "我本来是要把这车货送去蒙德城。昨天晚上走到这里的时候，看见了几团亮亮的东西。"
        },
        {
          "role": "怀尔德",
          "text": "因为喝的太多，我…我突然很想去看看那是什么，过去了之后，却发现是一大堆史莱姆，我还被狠狠撞了几下。"
        },
        {
          "role": "怀尔德",
          "text": "我很害怕，但是又找不到方向，跑了半天才回到了车旁边。今天早上，我发现我的<color=#00E1FFFF>钥匙</color>不见了…"
        },
        {
          "role": "怀尔德",
          "text": "你能帮我找找吗？肯定就在这周围，我觉得…肯定就在旁边。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好的。",
              "dialogues": [
                {
                  "role": "怀尔德",
                  "text": "太好了，这么大片地方，我都不知道从何下手了。"
                }
              ]
            },
            {
              "text": "还有别的急事",
              "dialogues": [
                {
                  "role": "怀尔德",
                  "text": "这么大片地方，我可从哪下手啊，这件事只有你能办到，拜托了！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "用元素视野寻找钥匙"
        },
        {
          "role": "怀尔德",
          "text": "你找到钥匙了吗？"
        },
        {
          "role": "旅行者",
          "text": "抱歉，还没有。"
        },
        {
          "role": "怀尔德",
          "text": "这地方果然还是太大了啊…拜托你了！"
        },
        {
          "type": "subtitle",
          "text": "把钥匙交给怀尔德"
        },
        {
          "role": "怀尔德",
          "text": "钥匙找到了吗？"
        },
        {
          "role": "旅行者",
          "text": "这是你丢的钥匙吗？"
        },
        {
          "role": "怀尔德",
          "text": "没错！就是这把，我以后可不能…嗯，以后要喝少点了。"
        },
        {
          "role": "怀尔德",
          "text": "哦，还有，请收下这些吧，谢谢你们帮忙。"
        }
      ]
    }
  ]
}