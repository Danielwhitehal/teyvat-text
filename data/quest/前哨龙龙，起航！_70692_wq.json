{
  "quest_id": 70692,
  "chapter_num": null,
  "chapter_title": "前哨龙龙，起航！",
  "type": "wq",
  "route": "Let's Go, Saury-Saury Scout!",
  "stories": [
    {
      "story_id": 70692,
      "title": "前哨龙龙，起航！",
      "description": "得益于最近与多国友人的交流，游击小队的成员米卡取得了新的成就…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与米卡对话"
        },
        {
          "role": "「狂图捕手」",
          "text": "哇哇，骑士小哥，你把我们的大英雄引过来了！"
        },
        {
          "role": "米卡",
          "text": "是荣誉骑士前辈，还有白色小帮手！你们好！"
        },
        {
          "role": "派蒙",
          "text": "米卡和…纳塔的朋友？你们在忙什么呢？"
        },
        {
          "role": "米卡",
          "text": "我们正在推广一种对冒险家团体很有帮助的「前哨龙龙」。"
        },
        {
          "role": "米卡",
          "text": "它结合了安柏前辈从须弥带回来的「侦察伙伴」机关核心，还有纳塔朋友们送我的小龙玩偶外形…"
        },
        {
          "role": "派蒙",
          "text": "伙伴机关…哦哦，我还有印象！"
        },
        {
          "role": "米卡",
          "text": "与须弥的「侦察伙伴」的功能类似，「前哨龙龙」可以帮忙侦察魔物，勘测地形。"
        },
        {
          "role": "米卡",
          "text": "不过，由于重点放在后者，它更侧重行动的可控性和精准度…"
        },
        {
          "role": "米卡",
          "text": "…荣誉骑士前辈有兴趣试飞一下吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是一本正经的介绍。",
              "dialogues": []
            },
            {
              "text": "可以不用这么正式的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "米卡",
          "text": "欸？是…是我太紧张了吗？"
        },
        {
          "role": "米卡",
          "text": "好像的确…明明之前基本放松下来，可以比较自然地面对你了。"
        },
        {
          "role": "米卡",
          "text": "但最近从不少其他国家的朋友那里听说了你的事迹，感觉你越来越厉害，越来越了不起了…"
        },
        {
          "role": "米卡",
          "text": "一想到以后要帮上你的忙，不能拖你的后腿，下意识又绷紧了弦。"
        },
        {
          "role": "派蒙",
          "text": "还真是米卡特有的逻辑…"
        },
        {
          "role": "「狂图捕手」",
          "text": "已经很不错了，骑士小哥！"
        },
        {
          "role": "「狂图捕手」",
          "text": "在纳塔啊，部族里的战士要是碰见了旅行者，有的会激动到语无伦次，有的还会半个字都说不出来！"
        },
        {
          "role": "「狂图捕手」",
          "text": "你作为旅行者的同事，也能算得上传奇级高手，和我们的部族首领对话都不必虚！"
        },
        {
          "role": "派蒙",
          "text": "没错没错，米卡要自信点！"
        },
        {
          "role": "米卡",
          "text": "原来还有这种事…这样的思考角度，我完全没想过…"
        },
        {
          "role": "米卡",
          "text": "总之，如果旅行者试飞过「前哨龙龙」后感到满意，这个可爱又可靠的辅助机关，肯定能造福更多冒险家团体！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这个我在行！",
              "dialogues": []
            },
            {
              "text": "让我试试龙龙的性能！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "米卡",
          "text": "好的！我这就调试好「前哨龙龙」，试飞很快就能开始！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「狂图捕手」）"
        },
        {
          "role": "「狂图捕手」",
          "text": "一切准备就绪，尊敬的大英雄，要来试飞一下「前哨龙龙」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "开始吧！",
              "dialogues": [
                {
                  "role": "「狂图捕手」",
                  "text": "好的！相信你和龙伙伴们的默契，也能在指挥「前哨龙龙」上发挥奇效！"
                }
              ]
            },
            {
              "text": "你也是来参赛的吗？",
              "dialogues": [
                {
                  "role": "「狂图捕手」",
                  "text": "高看我了！我的体能不太行，哪够格打比赛！只是顺路过来买点素材，找找机会招招人而已。"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "自从你和火神大人，还有诸多勇士们一同平息了最大的危机，让我们纳塔人有了外出旅游的机会…"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "我们「涂鸦联盟」一直在扩张，吸纳各地的绘画人才！"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "涂鸦是一种表达形式，具体到绘制的手法上，也有融入漫画常用技巧的例子，毕竟我以前也接过漫画的委托订单…"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "将张力满满的画面从纸面转移到墙面上，也是一种成就。"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "我很期待，比如蒙德人将他们的特色艺术转化为涂鸦，呈现在墙上和山体上时，会是怎样的一幅画面…"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "当然，一切的前提是，大家只能在管理人员允许的区域内绘制涂鸦，绝不能恶意破坏当地原本的景观！"
                }
              ]
            },
            {
              "text": "你怎么和米卡达成了合作？",
              "dialogues": [
                {
                  "role": "「狂图捕手」",
                  "text": "能遇上这位专业的骑士小哥，都是我走运！"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "作为「涂鸦联盟」的盟主，我早早在冒险家协会注册了一个身份，以便日后外出考察。"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "这样一来，探查适合涂鸦的地形时，就不会被当成可疑人员抓起来。"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "可是雪山的寒冷和魔物不认这个证明，我差点被它们困死在山上…"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "还好骑士小哥发现了我，带我离开了绝境，不然事情就严重了。"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "事后，我仔细一想，碰见过我这种困境的冒险家肯定不在少数，骑士小哥也觉得，有时勘探地形的工作太危险…"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "于是我们商量着，商量着，就有了制作「前哨龙龙」的主意。"
                },
                {
                  "role": "「狂图捕手」",
                  "text": "希望积累了足够的数据后，「前哨龙龙」能顺利量产，帮到更多冒险家…以及我之后潜在的联盟成员！"
                }
              ]
            },
            {
              "text": "过会儿再来…",
              "dialogues": [
                {
                  "role": "「狂图捕手」",
                  "text": "没问题，我们随时等你！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          24,
          26
        ]
      ]
    }
  ]
}