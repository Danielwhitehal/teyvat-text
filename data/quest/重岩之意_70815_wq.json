{
  "quest_id": 70815,
  "chapter_num": null,
  "chapter_title": "重岩之意",
  "type": "wq",
  "route": "Will of Stone",
  "stories": [
    {
      "story_id": 70815,
      "title": "重岩之意",
      "description": "千岩军嘉义想要送一份礼物给自己的女儿小六，但他实在抽不出空回轻策庄，正在找人帮忙…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与嘉义对话"
        },
        {
          "type": "subtitle",
          "text": "与若心对话"
        },
        {
          "role": "若心",
          "text": "这孩子，跑到哪里去了…"
        },
        {
          "role": "旅行者",
          "text": "关于小六…"
        },
        {
          "role": "若心",
          "text": "你们是来找小六的？唉，你们来得不巧，那孩子不知道跑到哪里去了。"
        },
        {
          "role": "若心",
          "text": "前几天，她爸爸从璃月港里托人带了封信回来，说很快就能回来了。"
        },
        {
          "role": "若心",
          "text": "小六很开心，说要给她爸爸准备礼物，拉着几个孩子到处采花采野果…"
        },
        {
          "role": "若心",
          "text": "结果前几天，她爸爸又说临时要执勤，回不来了。"
        },
        {
          "role": "若心",
          "text": "这孩子就赌了气，怎么劝也不好，非说她爸爸不回来，她就自己去璃月港。"
        },
        {
          "role": "若心",
          "text": "我们还当她是开玩笑，结果今天一起来，小六人就不见了。"
        },
        {
          "role": "若心",
          "text": "唉，能去找她的人已经都出去找她了，要是你们愿意的话，就也去找找她吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "那就麻烦你了，唉，这孩子…"
                }
              ]
            },
            {
              "text": "她会去哪？",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "这孩子也跑不太远，应该就在附近，但荒郊野外的太危险了…你们快去找找她吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找小六"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "role": "嘉义",
          "text": "唉，本来我算着日子，再值个两三天班就能回去了…"
        },
        {
          "role": "嘉义",
          "text": "加上我之前攒的假，这次回去少说能陪小六一个多星期。"
        },
        {
          "role": "嘉义",
          "text": "结果一声命令全体千岩军取消休假，正在休假的也全部召回。"
        },
        {
          "role": "嘉义",
          "text": "按照我的经验，至少一个月内我都别想回轻策庄。这都叫什么事嘛…"
        },
        {
          "type": "subtitle",
          "text": "与小六对话"
        },
        {
          "role": "小六",
          "text": "你们是来抓我回轻策庄的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "若心奶奶很担心你。",
              "dialogues": [
                {
                  "role": "小六",
                  "text": "哼，果然是来抓我回去的，我才不回去呢。"
                }
              ]
            },
            {
              "text": "我们有东西给你…",
              "dialogues": [
                {
                  "role": "小六",
                  "text": "我才不要你们的东西，又是那些哄小孩的东西…"
                }
              ]
            }
          ]
        },
        {
          "role": "小六",
          "text": "你们回去告诉村里的人，我要去璃月港找我爸爸去。"
        },
        {
          "role": "小六",
          "text": "找到了之后，我和我爸爸说会话就回去，让他们别操心了。"
        },
        {
          "type": "subtitle",
          "text": "追上小六（>30米失败）"
        },
        {
          "role": "若心",
          "text": "嘉义也是，怎么说不回来就不回来了。"
        },
        {
          "role": "若心",
          "text": "这孩子一年都见不到他几次，这天下哪里有这么当爸爸的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他也是为了璃月港…",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "嘉义年年也都这么说，我都记不清他说了多少次了…"
                }
              ]
            },
            {
              "text": "这也是为了工作…",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "那他也要顾顾自己的女儿吧，小六可是看着看着长大了…"
                },
                {
                  "role": "若心",
                  "text": "可别到时候，他是不工作了回庄里住着了，结果小六又要去工作了。"
                },
                {
                  "role": "若心",
                  "text": "这父女俩啊，反正就凑不到一块去。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "type": "subtitle",
          "text": "与小六对话"
        },
        {
          "role": "小六",
          "text": "你们跟着我到底有什么事？我说了我要去璃月港。"
        },
        {
          "role": "小六",
          "text": "这些魔物我自己会绕着走，它们发现不了我。"
        },
        {
          "role": "小六",
          "text": "别老是把我当小孩子，我已经长大了！"
        },
        {
          "role": "旅行者",
          "text": "这是你爸爸给你的…"
        },
        {
          "role": "小六",
          "text": "我爸爸给我的？是他要你们送过来的吗…"
        },
        {
          "role": "小六",
          "text": "准又是些小孩子玩的东西…不是风筝就是娃娃。"
        },
        {
          "role": "旅行者",
          "text": "你不喜欢这些？"
        },
        {
          "role": "小六",
          "text": "…喜欢啊，我爸爸送给我的东西，我怎么可能不喜欢。"
        },
        {
          "role": "小六",
          "text": "但我要是一直只喜欢这些东西的话，不就一直是小孩子了吗？"
        },
        {
          "role": "小六",
          "text": "老是玩这些，我什么时候能成为冒险家，拿到「神之眼」啊。"
        },
        {
          "role": "旅行者",
          "text": "你要「神之眼」做什么？"
        },
        {
          "role": "小六",
          "text": "有了「神之眼」，我就能做到很多事了啊，无论是赚钱还是其他什么…"
        },
        {
          "role": "小六",
          "text": "然后，爸爸就不用天天在璃月港里工作，可以回来陪我了。"
        },
        {
          "role": "小六",
          "text": "你看，现在我没有「神之眼」…连自己去璃月港都做不到。"
        },
        {
          "role": "小六",
          "text": "不过，爸爸都让你们把礼物送过来了，我去找他，说不定还会给他添麻烦。"
        },
        {
          "role": "小六",
          "text": "<color=#00E1FFFF>我本来也给他准备了礼物</color>，想要给他个惊喜的…但现在我自己是送不过去了。"
        },
        {
          "role": "小六",
          "text": "<color=#00E1FFFF>要是有人愿意帮我送过去</color>…算了，我回去了。你们别跟着我了，我自己知道回去的路。"
        },
        {
          "type": "subtitle",
          "text": "与小六对话"
        },
        {
          "role": "小六",
          "text": "娃娃…风筝…风车…爸爸果然又送了这些。"
        },
        {
          "role": "小六",
          "text": "唉，可惜了我搜集的那些礼物，没法送到爸爸手上了…"
        },
        {
          "role": "旅行者",
          "text": "我帮你把礼物送过去吧。"
        },
        {
          "role": "小六",
          "text": "你要帮我送过去？好吧…虽然你没有「神之眼」，但你刚才对付那些魔物的样子，好像还挺轻松的。"
        },
        {
          "role": "小六",
          "text": "也只能这样了，那就拜托你了。"
        },
        {
          "role": "小六",
          "text": "唉，要是…我也有你这样的身手就好了。"
        },
        {
          "type": "subtitle",
          "text": "与嘉义对话"
        },
        {
          "role": "若心",
          "text": "你们回来啦，辛苦你们了，小六已经回来了，怀里还抱着个包裹。"
        },
        {
          "role": "旅行者",
          "text": "那是嘉义送给她的。"
        },
        {
          "role": "若心",
          "text": "是吗…唉，但是小六那孩子，还是更想他人回来啊。"
        },
        {
          "role": "若心",
          "text": "这小孩子啊，就和村子旁边的那些竹子一样，开始不惹眼，但是一眨眼就长大啦。"
        },
        {
          "role": "若心",
          "text": "孩子的小时候啊，错过了，就错过了，再也补不回来了…"
        },
        {
          "role": "嘉义",
          "text": "你把礼物送给小六了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "送过去了。",
              "dialogues": [
                {
                  "role": "嘉义",
                  "text": "那就好，那都是她最喜欢的玩具。谢谢你们，这些拿着吧，算是谢礼了。"
                }
              ]
            },
            {
              "text": "她更想你回去。",
              "dialogues": [
                {
                  "role": "嘉义",
                  "text": "我也想回去，可是现在璃月港这情况，我怕是一时半会走不了了。"
                },
                {
                  "role": "嘉义",
                  "text": "唉，还是谢谢你们，那些都是小六最喜欢的玩具，她的心情应该会好些。"
                },
                {
                  "role": "嘉义",
                  "text": "这些给你们，就算是谢礼吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与嘉义对话"
        },
        {
          "role": "嘉义",
          "text": "你把礼物送给小六了吗？"
        },
        {
          "role": "旅行者",
          "text": "这是小六给你的。"
        },
        {
          "role": "嘉义",
          "text": "这是…小六给我的东西？这么多，那孩子得花了多大功夫。"
        },
        {
          "role": "嘉义",
          "text": "我真是恨不得直接回轻策庄去算了，但是总务司这边又…"
        },
        {
          "role": "嘉义",
          "text": "谢谢你们，这些是谢礼，请收下吧。"
        },
        {
          "role": "嘉义",
          "text": "唉，也不知道这事情到底什么时候才算完，总务司又到底什么时候能准我的假…"
        }
      ]
    }
  ]
}