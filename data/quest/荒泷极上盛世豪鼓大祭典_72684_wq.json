{
  "quest_id": 72684,
  "chapter_num": null,
  "chapter_title": "荒泷极上盛世豪鼓大祭典",
  "type": "wq",
  "route": "The Almighty Arataki Great and Glorious Drumalong Festival",
  "stories": [
    {
      "story_id": 72684,
      "title": "荒泷极上盛世豪鼓大祭典",
      "description": "收到了来自荒泷一斗的邀请函，你决定去这个荒泷极上盛世豪鼓大祭典看看…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往离岛"
        },
        {
          "role": "派蒙",
          "text": "呜哇——一斗这个家伙，连邀请函都需要代笔吗？真是没救了…"
        },
        {
          "role": "派蒙",
          "text": "不过荒泷极上盛世豪鼓大祭典这个名字还挺威风的，会不会有很多好吃的呢？"
        },
        {
          "role": "派蒙",
          "text": "欸？我到处看了看，感觉这里不像是正在办祭典的样子呀，一点气氛都没有。"
        },
        {
          "role": "派蒙",
          "text": "去和这里的同心打听一下吧？说不定他们知道是怎么回事。"
        },
        {
          "type": "subtitle",
          "text": "与天领奉行同心木村交谈"
        },
        {
          "role": "木村",
          "text": "有什么需要帮忙的吗？"
        },
        {
          "role": "旅行者",
          "text": "关于即将举办的祭典。"
        },
        {
          "role": "木村",
          "text": "什么？祭典？最近没听说要举办祭典。"
        },
        {
          "role": "木村",
          "text": "二位能说得更详细一些吗？比如名字之类的。"
        },
        {
          "role": "旅行者",
          "text": "名字是荒泷极上…"
        },
        {
          "role": "木村",
          "text": "荒泷极上？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "荒泷极上盛世…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是荒泷派举办的荒泷极上盛世豪鼓大祭典！"
                }
              ]
            },
            {
              "text": "荒泷极上盛世豪鼓…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是荒泷派举办的荒泷极上盛世豪鼓大祭典！"
                }
              ]
            }
          ]
        },
        {
          "role": "木村",
          "text": "啊！是上次在容彩祭上捣乱的那个荒泷派吧？"
        },
        {
          "role": "木村",
          "text": "原来你们说的是那个三无活动…"
        },
        {
          "role": "派蒙",
          "text": "三无活动？不是不是，你搞错啦。是荒泷极上盛世豪鼓大祭典！"
        },
        {
          "role": "木村",
          "text": "好了，不用强调这个名字，我大概知道了，总之我来告诉你们吧。"
        },
        {
          "role": "木村",
          "text": "前几天我确实在这里看到了荒泷派的成员，他们在四处堆放一些毫无美感的东西。"
        },
        {
          "role": "木村",
          "text": "那个为首的家伙，还声称要在这里办一场超过容彩祭的大型祭典，应该就是你们说的那个。"
        },
        {
          "role": "木村",
          "text": "结果稍微查问了两句，发现他们既没有活动举办许可，也没有场地租用凭证，更不用说事先应该去奉行所准备好报批记录了。"
        },
        {
          "role": "木村",
          "text": "这明显是板上钉钉的三无活动。按照规定，我们只好强制他们停止。"
        },
        {
          "role": "派蒙",
          "text": "欸？强行停止！难道他们已经被抓起来了？"
        },
        {
          "role": "木村",
          "text": "那倒没有，看在他们是没有经验，而且好歹准备了安全预案的份上。我们也只是对他们进行了简单教育。"
        },
        {
          "role": "派蒙",
          "text": "安全预案，这帮家伙还是挺有安全意识的嘛…"
        },
        {
          "role": "木村",
          "text": "如果你们在找荒泷派，也许可以去甘金岛看看。"
        },
        {
          "role": "木村",
          "text": "甘金岛是社奉行给各种大小祭典常备的场地，初衷是为了培育各种来自民间的文化活动，手续和费用都是从简的。"
        },
        {
          "role": "木村",
          "text": "我们把这个告诉了荒泷派的那几位。"
        },
        {
          "role": "木村",
          "text": "如果他们仍然想要举办活动的话，那里是最合适的选择。"
        },
        {
          "role": "派蒙",
          "text": "唔…旅行者，虽然已经感觉不太靠谱的样子…"
        },
        {
          "role": "派蒙",
          "text": "但是，来都来了…所以我们还是去甘金岛找找吧？"
        },
        {
          "type": "subtitle",
          "text": "前往甘金岛寻找荒泷派"
        },
        {
          "role": "派蒙",
          "text": "还是和刚刚一样，没有看见荒泷派的人呢。"
        },
        {
          "role": "派蒙",
          "text": "说到哪了…"
        },
        {
          "role": "派蒙",
          "text": "这里应该有社奉行的代行在管理，我们去问问他吧。"
        },
        {
          "type": "subtitle",
          "text": "与社奉行代行彦博交谈"
        },
        {
          "role": "彦博",
          "text": "二位有什么需要？"
        },
        {
          "role": "旅行者",
          "text": "我们来找荒泷派。"
        },
        {
          "role": "彦博",
          "text": "噢噢噢，我知道了，你们也是来参加那个荒泷极上什么什么大祭典的吧？"
        },
        {
          "role": "旅行者",
          "text": "也是？"
        },
        {
          "role": "彦博",
          "text": "嗯嗯，不久前，天领奉行的九条裟罗大人，还有长野原烟花店的宵宫小姐都来过。"
        },
        {
          "role": "彦博",
          "text": "宵宫小姐过来送烟花时，碰巧看到那伙人在张罗场地，可能是感兴趣吧，所以过去看了看。"
        },
        {
          "role": "彦博",
          "text": "至于九条沙罗大人为什么过来，就不太清楚了。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，居然有人比我们先到了呢！嘿嘿嘿。"
        },
        {
          "role": "派蒙",
          "text": "所以荒泷派他们现在在哪里呀？"
        },
        {
          "role": "彦博",
          "text": "说来惭愧，因为最近岛上已经没有额外的空域场地里。"
        },
        {
          "role": "彦博",
          "text": "我们只好把他们安排在了西北边的小滩涂上。"
        },
        {
          "role": "彦博",
          "text": "如果他们能再早些申请，我可以为他们准备更好一些的位置。"
        },
        {
          "role": "彦博",
          "text": "你们往西北边走一走应该就能看见。"
        },
        {
          "type": "subtitle",
          "text": "前往甘金岛西北边的滩涂"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈哈哈！我的挚友啊！你终于到了！"
        },
        {
          "role": "荒泷一斗",
          "text": "刚刚还在想，什么时候才能见到你，果然你就到了，真是让本大爷高兴啊。"
        },
        {
          "role": "荒泷一斗",
          "text": "看看本大爷这场子，怎么样？是不是上佳的选择？"
        },
        {
          "role": "阿守",
          "text": "三面环海，空气清新，远离城市喧嚣，作用绝版景观资源。"
        },
        {
          "role": "阿晃",
          "text": "背靠甘金岛，独享祭典文化中心的顶级配套。"
        },
        {
          "role": "元太",
          "text": "水陆交通发达，无论是步行或是坐船都能便捷抵达。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实，场子很不错。",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "当初看到这个场子的瞬间，本大爷就决定，就是它了！"
                },
                {
                  "role": "荒泷一斗",
                  "text": "那一刻，世界大有不同。"
                }
              ]
            },
            {
              "text": "确实，你们很乐观。",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "当初看到这个场子的瞬间，本大爷就决定，就是它了！"
                },
                {
                  "role": "荒泷一斗",
                  "text": "那一刻，世界大有不同。"
                }
              ]
            }
          ]
        },
        {
          "role": "荒泷派成员",
          "text": "老大英明！！！"
        },
        {
          "role": "派蒙",
          "text": "明明是被天领奉行的人赶过来的吧。"
        },
        {
          "role": "荒泷一斗",
          "text": "咳咳…我们还是先说正事吧。"
        },
        {
          "role": "荒泷一斗",
          "text": "这次请你们过来，是想请你们参加我荒泷极上盛世豪鼓大祭典！这个祭典意义重大。"
        },
        {
          "role": "元太",
          "text": "老大说，一来是为了宣传我荒泷派的名头，方便未来招新。"
        },
        {
          "role": "阿守",
          "text": "而是为了忍姐毕业庆功！"
        },
        {
          "role": "阿晃",
          "text": "最后还能补上因为欠经费而延期的团建。"
        },
        {
          "role": "派蒙",
          "text": "还真是一典多用呢。"
        },
        {
          "role": "荒泷一斗",
          "text": "阿晃…最后一条不必再提。"
        },
        {
          "role": "旅行者",
          "text": "怎么没有看见阿忍？"
        },
        {
          "role": "荒泷一斗",
          "text": "祭典这种事，多多宣传才有更多的人来参加，所以阿忍去发传单了。"
        },
        {
          "role": "派蒙",
          "text": "喂！明明阿忍是主角吧？"
        },
        {
          "role": "派蒙",
          "text": "居然她在外面干活，你们在这里游手好闲。"
        },
        {
          "role": "荒泷一斗",
          "text": "本大爷也有在认真…认真在这里接待你们啊！"
        },
        {
          "role": "元太",
          "text": "老大其实是刚回来啦。"
        },
        {
          "role": "阿守",
          "text": "说是估算这你们都要到了，才特地回来迎接的。"
        },
        {
          "role": "阿晃",
          "text": "本来他和忍姐一起，也在外面努力拉人参加祭典呢。"
        },
        {
          "role": "荒泷一斗",
          "text": "不用夸我，不用夸我。"
        },
        {
          "role": "派蒙",
          "text": "哟，放牛的居然也在认真做事了。难得的靠谱了起来。"
        },
        {
          "role": "荒泷一斗",
          "text": "哼，不跟你这飞行矮堇瓜一般见识！"
        },
        {
          "role": "荒泷一斗",
          "text": "话说回来，我的挚友啊，关于这次祭典，你还有什么疑问吗？"
        },
        {
          "role": "旅行者",
          "text": "祭典都有哪些内容？"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈！内容丰富的很！"
        },
        {
          "role": "荒泷一斗",
          "text": "看到那边的小山坡了吗？那是豪歌岭，你们可以站在上面，面对大海，自由唱歌。"
        },
        {
          "role": "荒泷一斗",
          "text": "还有这团篝火，用来烤堇瓜绰绰有余。"
        },
        {
          "role": "荒泷一斗",
          "text": "还有这堆箱子，不管是玩《七圣召唤》还是斗虫都不会感到拥挤。"
        },
        {
          "role": "派蒙",
          "text": "听起来还真是「丰富」呢。"
        },
        {
          "role": "荒泷一斗",
          "text": "当然，祭典的重头戏还是这个豪鼓祭演啦。来，你们看。"
        },
        {
          "role": "荒泷一斗",
          "text": "偷偷告诉你们，这可是我从秘密渠道搞来的好东西，说是一位大阴阳师留下的宝具小鼓，本来要价800万摩拉！"
        },
        {
          "role": "荒泷一斗",
          "text": "卖家看我面目俊朗，与她有缘，于是给我打了个折，只要80万摩拉就卖我了。"
        },
        {
          "role": "派蒙",
          "text": "800万摩拉变80摩拉，怎么听也像骗人的吧？"
        },
        {
          "role": "荒泷一斗",
          "text": "当然！我怎么可能被这种低劣的手法骗到。"
        },
        {
          "role": "荒泷一斗",
          "text": "我一眼就看出了这个小鼓的边缘有些破损，这是瑕疵品！还说什么与我有缘，可笑！"
        },
        {
          "role": "荒泷一斗",
          "text": "于是本大爷又砍了她一刀，最后只要8万摩拉成交。哈哈哈哈哈！捡到大便宜了！"
        },
        {
          "role": "派蒙",
          "text": "总觉得是人家捡到大便宜了…"
        },
        {
          "role": "派蒙",
          "text": "话说回来，放牛的居然出得起8万摩拉，让人有点刮目相看啊。"
        },
        {
          "role": "荒泷一斗",
          "text": "不过是8万摩拉而已，不要随便看轻本大爷啊！"
        },
        {
          "role": "元太",
          "text": "我出了其中的2万…"
        },
        {
          "role": "阿守",
          "text": "我也…"
        },
        {
          "role": "阿晃",
          "text": "啊？老大，为什么我出的是3万？"
        },
        {
          "role": "派蒙",
          "text": "2万加2万加3万等于…"
        },
        {
          "role": "派蒙",
          "text": "好你个放牛的，居然自己不出一分钱，就从小弟那里搜刮了8万摩拉出来…"
        },
        {
          "role": "荒泷一斗",
          "text": "咳咳，你是怎么算的，我我我也是出了最后1万摩拉的啊！"
        },
        {
          "role": "荒泷一斗",
          "text": "好了，多的就不说了，看看时间，我也得回阿忍那里了。"
        },
        {
          "role": "荒泷一斗",
          "text": "祭典才刚刚开始，我们还得再努力拉一些人过来才热闹！"
        },
        {
          "role": "荒泷一斗",
          "text": "收好这个小鼓，如果准备好要开始豪鼓表演，找元太就行。"
        },
        {
          "role": "荒泷一斗",
          "text": "回见了！我的挚友！"
        },
        {
          "type": "subtitle",
          "text": "在元太那里开始豪鼓表演"
        },
        {
          "role": "元太",
          "text": "我是荒泷鼓祭接引大使元太，准备好开始豪鼓祭演了吗？"
        },
        {
          "role": "元太",
          "text": "哦对了，关于这个小鼓，之前老大有一点忘记交代了。"
        },
        {
          "role": "元太",
          "text": "因为大家也不太懂乐器，所以在您开始之前，可以先调试一番。"
        },
        {
          "role": "元太",
          "text": "这样可以让最后的音色更加准确动听。"
        },
        {
          "role": "元太",
          "text": "来，请您试试吧。"
        },
        {
          "type": "subtitle",
          "text": "完成所有谱面后"
        },
        {
          "role": "阿守",
          "text": "出事了！"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "阿守",
          "text": "老大又进去了！"
        },
        {
          "role": "阿守",
          "text": "就在刚才，天领奉行派人过来，在留言板上贴了一张告示，说是要暂停我们的祭典"
        },
        {
          "role": "阿守",
          "text": "不知道怎么回事，老大他好像把宣传广告发进了天守阁。"
        },
        {
          "role": "阿守",
          "text": "还说将军大人一定想要参加荒沈极上盛世豪鼓大祭典！"
        },
        {
          "role": "阿晃",
          "text": "欸？这么说的话，我觉得老大说的没错呀。我也觉得将军大人肯定想参加。"
        },
        {
          "role": "元太",
          "text": "对呀。难道你不是这么认为的吗？"
        },
        {
          "role": "阿守",
          "text": "哎呀，谁会管我们怎么觉得呀。"
        },
        {
          "role": "阿守",
          "text": "总之老大就是被看守的奥诘众当场抓获，送去了天领奉行。"
        },
        {
          "role": "旅行者",
          "text": "那要怎么办呢？"
        },
        {
          "role": "阿守",
          "text": "恐姐应该已经在处理了吧。"
        },
        {
          "role": "阿守",
          "text": "据说奥诘众对老大的指控是涉嫌扰乱军事禁区。"
        },
        {
          "role": "阿守",
          "text": "后来被九条裟罗大人改成了涉嫌妨碍公共秩序。"
        },
        {
          "role": "元太",
          "text": "呀呀呀呀呀，这个可恶的九条天狗，居然给老大定了这种重罪！"
        },
        {
          "role": "阿守",
          "text": "哎呀，你傻啦！这是变成了轻罪，一般在所里教育教育就好…"
        },
        {
          "role": "阿守",
          "text": "至于祭典这边，就只能等老大出来之后再说啦。"
        },
        {
          "role": "阿守",
          "text": "旅行者，您也不用担心，有忍姐在那边处理，肯定不会有大问题。"
        },
        {
          "role": "阿守",
          "text": "您对我们的祭典这么支持，等老大出来，他一定会来当面感谢你的！"
        },
        {
          "role": "阿守",
          "text": "希望您的旅途和我们的祭典一样，都能越来越好。"
        },
        {
          "role": "荒泷派成员",
          "text": "越来越好！！"
        }
      ]
    }
  ]
