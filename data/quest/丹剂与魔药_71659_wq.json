{
  "quest_id": 71659,
  "chapter_num": null,
  "chapter_title": "丹剂与魔药",
  "type": "wq",
  "route": "Elixirs and Potions",
  "stories": [
    {
      "story_id": 71659,
      "title": "丹剂与魔药",
      "description": "蒙德的炼金术研究者蒂玛乌斯似乎正在为某项研究而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "拜访蒂玛乌斯"
        },
        {
          "role": "蒂玛乌斯",
          "text": "似乎只差一点了…争取在九个小时内制作出第一份「烟霰丹剂」！"
        },
        {
          "role": "派蒙",
          "text": "蒂玛乌斯？你在干嘛呀，表情这么严肃？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "是你们！好久不见了！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "实在不好意思，我正在试制「烟霰丹剂」，可能需要占用合成台一段时间。"
        },
        {
          "role": "派蒙",
          "text": "「烟霰丹剂」？完全没听说过这种东西呢…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "这是近年来出现的神秘药剂，我也是在一本冷门的学术书籍上读到相关资料的。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "据作者所说，「烟霰丹剂」起源于璃月，能让使用者的力量成倍增长，效果无与伦比，想必是强大炼金术的造物。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "「烟霰丹剂」在璃月得到了高度认可，有着诸如「丹香悠邈焕仪质」的描述…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "我仔细进行了评估——如果成功试制「烟霰丹剂」，我对炼金术的理解至少能进步十年！"
        },
        {
          "role": "派蒙",
          "text": "进步十年？这也太厉害了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "前提是那本书的说法属实。",
            "前提是你的评估足够准确。"
          ]
        },
        {
          "role": "蒂玛乌斯",
          "text": "放心吧！这本书的作者是个万事通，写过不少令人拍案叫绝的论文！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "炼金术是一门奇妙的学问，在发掘古代的技术的同时，参考当世之人的研究成果，不断演化和进步。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "所以我才会寻找各种资料，从中发掘能为炼金术提供帮助的知识，推进我的主要课题。"
        },
        {
          "role": "派蒙",
          "text": "蒂玛乌斯的心态还真是积极进取呢！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "如果两位能协助我，我肯定能顺利完成这次研究，获得阿贝多老师的认可！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "也许我能借此机会成为阿贝多老师的助手，常驻在他的营地里，研究更高深的课题。"
        },
        {
          "role": "派蒙",
          "text": "怎么办，旅行者？我们要答应他吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "为了自由使用合成台…",
            "为了蒂玛乌斯的学术生涯…"
          ]
        },
        {
          "role": "派蒙",
          "text": "还是帮帮他吧！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "感谢两位！我一定会全力答谢你们的！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "等到我的「烟霰丹剂」试制成功，两位就能第一时间享受到它的神奇功效，快速变强！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "也不必这么客气…",
            "我不需要借助外力变强…"
          ]
        },
        {
          "role": "旅行者",
          "text": "也不必这么客气…"
        },
        {
          "role": "派蒙",
          "text": "比起试用药剂和快快变强，我更想要很多很多好吃的！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "那更不成问题了！事成之后，我会支付足够的报酬，然后请两位任选餐馆，痛痛快快吃一顿大餐！"
        },
        {
          "role": "派蒙",
          "text": "真的吗！一言为定哦！"
        },
        {
          "type": "subtitle",
          "text": "协助蒂玛乌斯，尝试制作传说中的「烟霰丹剂」…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "唉！只凭我掌握的工艺，还是没法制作出「烟霰丹剂」，果然还是要请教一下专家啊…"
        },
        {
          "role": "派蒙",
          "text": "比如阿贝多吗？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "不行！绝对不行，这么干不就等于在考试途中向老师询问答案吗？！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "要是被阿贝多老师知道，我连这么一种药剂都做不出来，他就更不可能认可我了…"
        },
        {
          "role": "派蒙",
          "text": "有道理哦…"
        },
        {
          "role": "旅行者",
          "text": "不如去问问砂糖？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "虽然砂糖小姐对炼金术的理解的确远远超过我，但她专攻的领域和「烟霰丹剂」基本无关…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "而且她平时研究也很忙，我也不好意思去打扰她…"
        },
        {
          "role": "旅行者",
          "text": "不如去请教丽莎？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "丽莎小姐最近正在整理图书馆的藏书，据说工作量很恐怖…要是被人打扰了，丽莎小姐说不定心情也会不好…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "总之！我们还是、还是别去打扰她了…"
        },
        {
          "role": "派蒙",
          "text": "那怎么办？这不是完全没办法了吗！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "办法…倒是有。只不过不在蒙德，而是在…璃月。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "那本书籍里提到过，「宗匠闲清隐隔邻，薰风郁霭笼岩港」…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "听说「薰风」这个词在璃月有着「南风」的意思，所以创造出「烟霞丹剂」的「丹剂宗匠」应该就住在璃月港的南部区域。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "直接请教那位「丹剂宗匠」，当然是最有效的方法。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "所以，能不能请二位和我一同前往璃月？我对那里实在是不熟…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这句诗的含义…",
            "你确定吗？"
          ]
        },
        {
          "role": "蒂玛乌斯",
          "text": "当然！请相信我分析资料的能力！"
        },
        {
          "role": "派蒙",
          "text": "还要去璃月…好远啊…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "对了，听说璃月的料理相当美味，事成之后，我们可以直接在璃月吃饭。"
        },
        {
          "role": "派蒙",
          "text": "好主意欸！我支持！"
        },
        {
          "role": "派蒙",
          "text": "那我要把「万民堂」的所有招牌菜都吃一遍！「万民堂」的菜，无论吃几次都不够呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "会不会太破费了…",
            "蒂玛乌斯的资金储备…"
          ]
        },
        {
          "role": "蒂玛乌斯",
          "text": "别担心，比起研究的成果…不对，是两位帮助我的恩情，这点钱根本不算什么！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "我们现在就出发吧！"
        },
        {
          "type": "subtitle",
          "text": "寻找「丹剂宗匠」"
        },
        {
          "role": "蒂玛乌斯",
          "text": "我看看地图啊…璃月港的南部是叫「吃虎岩」没错吧？那传说中的「丹剂宗匠」应该就住在这一带。"
        },
        {
          "role": "派蒙",
          "text": "我们到了，这里就是「吃虎岩」！赶快在附近找找看吧！"
        },
         {
          "type": "subtitle",
          "text": "询问小千"
        },
        {
          "role": "派蒙",
          "text": "你好！请问你认识住在这附近的「丹剂宗匠」吗？"
        },
       
        {
          "role": "小千",
          "text": "「丹剂宗匠」？没听说过这号人啊…"
        },
        {
          "role": "小千",
          "text": "只有地位显赫的人才配得上「宗匠」这种称号吧？我这种小人物当然不认识了。"
        },
        {
          "role": "派蒙",
          "text": "唔，那我们去问问其他人吧。"
        },
        {
          "type": "subtitle",
          "text": "询问弘毅"
        },
        {
          "role": "派蒙",
          "text": "你好！我们在找吃虎岩的「丹剂宗匠」，请问你知道他住在哪吗？"
        },
        {
          "role": "弘毅",
          "text": "不好意思，我不了解街坊邻居们的绰号，只记得他们登记在册的正式姓名。"
        },
        {
          "role": "弘毅",
          "text": "或许你们可以请教「春香窑」的莺儿。"
        },
        {
          "role": "派蒙",
          "text": "有道理哦！莺儿小姐应该很熟悉这方面的事吧，我们去问问她好了！"
        },
         {
          "type": "subtitle",
          "text": "询问莺儿"
        },
        {
          "role": "莺儿",
          "text": "你们终于想起我啦？还带来了一位朋友…是特意来陪我的吗？"
        },
        {
          "role": "派蒙",
          "text": "呜，我有点不好意思了…"
        },
        {
          "role": "派蒙",
          "text": "其实…莺儿小姐，我们是来拜访「丹剂宗匠」的，请问你认识这位大师吗？"
        },
        {
          "role": "莺儿",
          "text": "啊呀，原来还是另有所图吗？我有一点失望哦…"
        },
        {
          "role": "莺儿",
          "text": "不过，你们居然在打听我的秘密，还挺让我惊喜的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "秘密？",
            "惊喜？"
          ]
        },
        {
          "role": "派蒙",
          "text": "等等！难道说，莺儿小姐就是「丹剂宗匠」？"
        },
        {
          "role": "莺儿",
          "text": "越来越聪明啦，真招人喜欢。"
        },
        {
          "role": "派蒙",
          "text": "完全没想到会是这样！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "「丹剂宗匠」竟然如此年轻…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "和阿贝多老师给人的感觉截然不同，但也有一股深不可测的气息！"
        },
        {
          "role": "莺儿",
          "text": "看你们急切的神情，似乎遇上了难题呢，不妨和我直说吧？"
        },
        {
          "role": "派蒙",
          "text": "不知为什么，总觉得事情要朝着无法预料的方向发展了…"
        },
        {
          "type": "subtitle",
          "text": "和蒂玛乌斯一起向莺儿解释了「烟霰丹剂」的研究课题。"
        },
        {
          "role": "莺儿",
          "text": "原来如此，这位炼金术士正在研究奇妙的「烟霰丹剂」…"
        },
        {
          "role": "莺儿",
          "text": "可惜啊，要让你们失望了。"
        },
        {
          "role": "莺儿",
          "text": "你们正在调查的「烟霰丹剂」只不过是我特制的一种古法香膏而已，和炼金术完全无关。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "香膏？那不是一种固体香料吗？"
        },
        {
          "role": "派蒙",
          "text": "「烟霰丹剂」这个名字听起来明明很厉害啊！书里也写着它能让人们变强…"
        },
        {
          "role": "莺儿",
          "text": "呵呵，大概是我的古法香膏太受欢迎的缘故吧。"
        },
        {
          "role": "莺儿",
          "text": "古代的文人曾强调「熏陶」一词。长期沉浸在香膏的芬芳中，人们的气质和心性也会受到影响哦。"
        },
        {
          "role": "莺儿",
          "text": "使用了我的古法香膏之后，人们的气质大变，魅力大增，待人接物的信心大涨，人际关系也不断改善。事业步步高升，生活顺心顺意…"
        },
        {
          "role": "莺儿",
          "text": "就像是使用了仙人的丹药一样，运势明显好转。"
        },
        {
          "role": "莺儿",
          "text": "因此，人们给我的古法香膏起了个富有诗意的称号，还写下了简单易懂的诗词，夸赞它们的功效。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "不可能啊…难不成，我在那本书里读到的论文并不准确？或者说，我对诗词的理解出现了偏差？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "比如「丹香悠邈焕仪质」。这一段的含义应该是：「烟霰丹剂」能激发出人的威仪和潜质…没错吧，莺儿小姐？"
        },
        {
          "role": "莺儿",
          "text": "啊呀，「仪质」其实是一个完整的词，意为人的风度和气质。这句诗词其实是在说，古法香膏令人拥有了焕然一新的容姿。"
        },
        {
          "role": "莺儿",
          "text": "也不能怪你，诗词也是一门深奥的学问，可不能像分析数据那样，拆开成零散的文字来解读，而是要注意整体的意境哦。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "逐字逐句拆解的分析方法居然不管用？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "可是那本书还提到了不少「烟霰丹剂」发挥神奇功效的例子，让我看得目瞪口呆…"
        },
        {
          "role": "莺儿",
          "text": "刺激而神秘的事物总是令人神往的嘛，就像透过窗纸的婀娜身影。记录坊间传闻的书籍，也需要适当的艺术加工。"
        },
        {
          "role": "莺儿",
          "text": "多谢那位作者的夸赞啦~"
        },
        {
          "role": "蒂玛乌斯",
          "text": "怎么会这样…"
        },
        {
          "role": "派蒙",
          "text": "也就是说，蒂玛乌斯的参考资料夸大了香膏的效果，他也错误地理解了诗词。导致他误以为「烟霰丹剂」是强大的炼金术药剂？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "还好有心理准备。",
            "总感觉不太意外。"
          ]
        },
       
        {
          "role": "蒂玛乌斯",
          "text": "到头来，我的研究课题完全建立在错误的理论上啊！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "这次研究失败了，我又做了无用功…"
        },
        {
          "role": "莺儿",
          "text": "欸呀，也不必丧气嘛。"
        },
        {
          "role": "莺儿",
          "text": "有道是「峰回路转见蹊径，枯树新芽亦成荫」…"
        },
        {
          "role": "莺儿",
          "text": "或许炼制香膏的古法能给你一些启示，让你突破最后的瓶颈，制作出理想中的药剂？"
        },
        {
          "role": "派蒙",
          "text": "的确，虽然出发点不太靠谱，但蒂玛乌斯凭借自己的理解，也取得了一定的进展呢。"
        },
        {
          "role": "派蒙",
          "text": "既然莺儿小姐都这样提议了，不如就试一试吧。"
        },
        {
          "role": "旅行者",
          "text": "也许能收获意外之喜。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "说得在理…炼金术是一门深奥的学问，我也不是第一次失败了，必须打起精神来！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "大多时候，我还是能准确解读资料的，这次是意外！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "就算无法做出传说中的奇妙药剂，改进现有的炼金药剂，也算是不错的成就！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "莺儿小姐，旅行者，我们现在就去合成台附近吧。"
        },
        {
          "type": "subtitle",
          "text": "协助蒂玛乌斯和莺儿"
        },
        {
          "role": "莺儿",
          "text": "制作古法香膏的流程啊，可是相当讲究的。"
        },
        {
          "role": "莺儿",
          "text": "要像摩挲恋人的肌肤一样，以极为温柔的力道剥开花苞，取下花瓣，将它们细致地叠放。"
        },
        {
          "role": "莺儿",
          "text": "纤薄的花瓣在上，厚实的花瓣在下，留下适当的空隙，再将它们捣碎…"
        },
        {
          "role": "莺儿",
          "text": "臼杵不必握得太紧，手腕要放松，节奏要起伏有致。"
        },
        {
          "role": "莺儿",
          "text": "等到花瓣的汁液弥漫，臼杵的底部完全湿润，再适当加快速度。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "这…咳咳！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "莺儿小姐的用词还真是…特别！我大概理解你的意思了。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "谨慎处理原料，注意置入容器的次序，把握浸入基液的时间，以便精确控制火候…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "制作一些高等炼金药剂时，也需要以这么严格的要求把控细节。"
        },
        {
          "role": "莺儿",
          "text": "你的悟性很不错嘛，但制作香膏的要点远不止这些哦。"
        },
        {
          "role": "莺儿",
          "text": "有些香膏的「升华效应」极为重要，需要加入合适的辅料，比如薄荷和星螺磨制的粉末。"
        },
        {
          "role": "莺儿",
          "text": "这样一来，香膏的气味就能快速弥漫开来，让周围的人心旷神怡。"
        },
        {
          "role": "莺儿",
          "text": "但「升华效应」也不能太强，否则，香膏很快就会消耗殆尽。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "升华…升华？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "我懂了，古法香膏的这种特性，正是我所追求的关键之处！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "弥漫在空气里的药剂能同时作用于使用者和环境，相比普通的精油，效果应该更明显！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "而且，适当控制升华的速度以后，持续时间应该也会比普通的精油更长！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "向这个方向努力，绝对不会有错！"
        },
        {
          "role": "派蒙",
          "text": "进入学术讨论后，就完全插不上嘴了…"
        },
        {
          "role": "派蒙",
          "text": "还是不要打扰他们两位了吧。"
        },
        {
          "type": "subtitle",
          "text": "在莺儿的指点下，蒂玛乌斯尝试制作了改进的炼金药剂。"
        },
        {
          "role": "派蒙",
          "text": "好香啊！只是闻到这种气味，就让人感觉十分清爽，又充满力量呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "的确让人打起精神来了。",
            "的确有着神奇的功效。"
          ]
        },
        
        {
          "role": "蒂玛乌斯",
          "text": "成功了！我总算成功了！结合了香膏古法的炼金药剂完成了！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "多亏了莺儿小姐的指导，我才能在这么短的时间内找到窍门，顺利制备这些药剂！"
        },
        {
          "role": "莺儿",
          "text": "太谦虚的话，就会显得虚假和客套啦。你的学识和悟性才是成功的关键哦。"
        },
        {
          "role": "莺儿",
          "text": "现在…不如先为你的心血之作起个名字？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "就叫它们「烟霰魔药」吧！它们结合了莺儿小姐的香膏和炼金药剂的特性，意义非凡，一定会被记载在学术史上！"
        },
        {
          "role": "莺儿",
          "text": "啊呀，真让我受宠若惊呢~"
        },
        {
          "role": "派蒙",
          "text": "不过这个名字和之前的「烟霰丹剂」…没什么区别吧？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "咳咳，言归正传！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "旅行者，你会是「烟霰魔药」的首位使用者。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "目前的「烟霰魔药」还需要完善，能麻烦你试验一下这些药剂的效果吗？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "在空气流动相对缓慢的区域，「烟霰魔药」的效果会更明显。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "听说璃月有一些无人造访的秘境，它们是相当理想的试验场地！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "帮人帮到底。",
            "我也起兴致了！"
          ]
        },
       
        {
          "role": "蒂玛乌斯",
          "text": "那就有劳你了！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "我会在这里待上一段时间，继续和莺儿小姐交流学术，等着你的反馈，准备改进「烟霰魔药」。"
        },
        {
          "role": "莺儿",
          "text": "等你们的好消息哦~"
        }
      ]
    }
  ]
}