        },
        {
          "role": "芙萝拉",
          "text": "请你帮我把这些花分别放在雪山上的<color=#00E1FFFF>七天神像附近</color>、<color=#00E1FFFF>雪山里一个洞窟的入口</color>。"
        },
        {
          "role": "芙萝拉",
          "text": "然后再<color=#00E1FFFF>在雪山里找到一片水域</color>…不管是湖还是池塘都可以，然后把一盒花放在水边吧。"
        },
        {
          "role": "芙萝拉",
          "text": "这次请您千万小心一些，千万别把它们弄坏了。"
        },
        {
          "type": "subtitle",
          "text": "前往雪山的七天神像附近放置包裹"
        },
        {
          "type": "subtitle",
          "text": "前往雪山，在水域放置包裹"
        },
        {
          "type": "subtitle",
          "text": "前往雪山中的洞窟放置包裹"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "type": "subtitle",
          "text": "在山洞附近放置包裹"
        },
        {
          "type": "subtitle",
          "text": "向芙萝拉道歉"
        },
        {
          "role": "芙萝拉",
          "text": "花怎么样啦？"
        },
        {
          "role": "旅行者",
          "text": "对不起…"
        },
        {
          "role": "芙萝拉",
          "text": "嗯？怎么了？"
        },
        {
          "role": "旅行者",
          "text": "我不小心把盒子和花弄坏了…"
        },
        {
          "role": "芙萝拉",
          "text": "弄、弄坏了？！"
        },
        {
          "role": "芙萝拉",
          "text": "呜…那可是我专门挑出来的花，那么好的花，可不是能轻易找到的…"
        },
        {
          "role": "芙萝拉",
          "text": "雪山真有这么危险吗？连你这样的冒险家都会失手，连一盒花都…"
        },
        {
          "role": "芙萝拉",
          "text": "不过，还是谢谢你帮我跑这一趟，这些东西给你，请收下吧，我要去打理店里的花了。"
        },
        {
          "role": "芙萝拉",
          "text": "唉，不然…我还是再用莎拉小姐的办法试试吧…"
        },
        {
          "type": "subtitle",
          "text": "向芙萝拉回报"
        },
        {
          "role": "芙萝拉",
          "text": "花怎么样啦？"
        },
        {
          "role": "旅行者",
          "text": "花已经埋好了。"
        },
        {
          "role": "芙萝拉",
          "text": "谢谢你，那就先让这些花在雪山上待一会吧。"
        },
        {
          "role": "芙萝拉",
          "text": "呼呼，谢谢你们这次帮我的忙，请收下这些报酬吧。"
        }
      ]
    }
  ]
