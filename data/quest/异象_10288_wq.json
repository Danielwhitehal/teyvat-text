{
  "quest_id": 10288,
  "chapter_num": "",
  "chapter_title": "异象",
  "type": "wq",
  "route": "The Anomaly",
  "stories": [
    {
      "story_id": 77502,
      "title": "异象·至冬",
      "description": "提瓦特各处的「判罚之钉」似乎都出现了异象，去探查当地的具体情况吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往至冬堡东面查看情况"
        },
        {
          "role": "阿罗夏",
          "text": "看来你们也发现了？"
        },
        {
          "role": "派蒙",
          "text": "阿罗夏，这是怎么回事，你知道吗？"
        },
        {
          "role": "派蒙",
          "text": "天理留下的「钉子」在发光，时不时还会发出声音…"
        },
        {
          "role": "阿罗夏",
          "text": "我可能是头几个目击者，之前刚好在附近巡猎。"
        },
        {
          "role": "阿罗夏",
          "text": "至少目前为止看起来没什么危害，我当时立即把情况通知了当地的冬契军，女皇和愚人众那边应该也了解状况了。"
        },
        {
          "role": "派蒙",
          "text": "会不会…是若娜瓦的什么手段呀？来自她的报复？"
        },
        {
          "role": "阿罗夏",
          "text": "有待观察。我们刚击败了天空岛的死之执政，天理的钉子就出现异变，怎么想都不会是好事。"
        },
        {
          "role": "阿罗夏",
          "text": "军方的那些聪明人应该会找到答案吧，在此之前，也应该多留意这一带，会不会有其他变化。"
        }
      ]
    },
    {
      "story_id": 77506,
      "title": "异象·蒙德",
      "description": "提瓦特各处的「判罚之钉」似乎都出现了异象，去探查当地的具体情况吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往龙脊雪山查看情况"
        },
        {
          "role": "阿贝多",
          "text": "旅行者，派蒙，你们是来看这个的吗？"
        },
        {
          "role": "派蒙",
          "text": "是呀，果然雪山上的寒天之钉也有了一样的变化。"
        },
        {
          "role": "阿贝多",
          "text": "在雪山上这么久，我也是第一次观测到这样的景象…"
        },
        {
          "role": "阿贝多",
          "text": "本以为在天理降下判罚，寒天之钉覆灭了古国文明以后，它的使命就完成了。"
        },
        {
          "role": "阿贝多",
          "text": "可现在看来，没有想象的那么简单啊。"
        },
        {
          "role": "阿贝多",
          "text": "我会继续在这里观察记录，尤其是这种变化对附近区域生态的影响。"
        }
      ]
    },
    {
      "story_id": 77507,
      "title": "异象·璃月",
      "description": "提瓦特各处的「判罚之钉」似乎都出现了异象，去探查当地的具体情况吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往层岩巨渊查看情况"
        },
        {
          "role": "魈",
          "text": "有段时间没见了，两位。"
        },
        {
          "role": "派蒙",
          "text": "你也到层岩巨渊来了，看来璃月也很重视这些钉子的情况呢。"
        },
        {
          "role": "魈",
          "text": "嗯，异变产生后，不论是仙人那边还是人类那边，都很重视。"
        },
        {
          "role": "魈",
          "text": "璃月港增派了些千岩军人手，加强层岩巨渊附近的巡逻，而留云真君他们正在着手调查此番现象。"
        },
        {
          "role": "派蒙",
          "text": "那你呢，你在这里干嘛？"
        },
        {
          "role": "魈",
          "text": "帝君托我监视此地，我脚程快，如有进一步异变，可第一时间通知到他。"
        },
        {
          "role": "派蒙",
          "text": "我就知道他应该也会放心不下…"
        }
      ]
    },
    {
      "story_id": 77508,
      "title": "异象·稻妻",
      "description": "提瓦特各处的「判罚之钉」似乎都出现了异象，去探查当地的具体情况吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往鹤观查看情况"
        },
        {
          "role": "派蒙",
          "text": "居然会在这里见到八重神子？"
        },
        {
          "role": "八重神子",
          "text": "叫我宫司大人。"
        },
        {
          "role": "派蒙",
          "text": "呃…宫司大人。"
        },
        {
          "role": "八重神子",
          "text": "逗逗你的，真听话。"
        },
        {
          "role": "八重神子",
          "text": "之前有人来向我报告，说这一带有异变出现。"
        },
        {
          "role": "八重神子",
          "text": "我随手卜签…结果可是「大凶」哦。所以就过来看看。"
        },
        {
          "role": "派蒙",
          "text": "我也觉得这种现象看上去就不怎么吉利…宫司大人你来了之后能感觉到什么吗？"
        },
        {
          "role": "八重神子",
          "text": "没法确定，不知道是天理的什么小手段。"
        },
        {
          "role": "八重神子",
          "text": "隐隐能够感觉到某种力量…等有空最好拉心海小姑娘过来问问，看她是否会觉得熟悉。"
        }
      ]
    },
    {
      "story_id": 77509,
      "title": "异象·须弥",
      "description": "提瓦特各处的「判罚之钉」似乎都出现了异象，去探查当地的具体情况吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往达马山查看情况"
        },
        {
          "role": "派蒙",
          "text": "坎蒂丝和迪希雅？"
        },
        {
          "role": "迪希雅",
          "text": "哟，你们是来参观的？"
        },
        {
          "role": "坎蒂丝",
          "text": "怎么说也应该叫调查或者考察吧？"
        },
        {
          "role": "迪希雅",
          "text": "哈哈，我们佣兵团里那些人很多都没什么文化，来这边也就是看热闹，像参观一样。"
        },
        {
          "role": "派蒙",
          "text": "你们佣兵团的人也都过来了？"
        },
        {
          "role": "迪希雅",
          "text": "是啊，最近感觉须弥多灾多难，一直不怎么太平。"
        },
        {
          "role": "迪希雅",
          "text": "我们团的人暂时先在这一带驻扎，观察一下情况，以防再出了什么事，大家应对不及时。"
        },
        {
          "role": "坎蒂丝",
          "text": "我和迪希雅差不多，沙漠民应当为草神大人分忧。"
        }
      ]
    },
    {
      "story_id": 77510,
      "title": "异象·纳塔",
      "description": "提瓦特各处的「判罚之钉」似乎都出现了异象，去探查当地的具体情况吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往圣火竞技场查看情况"
        },
        {
          "role": "玛薇卡",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "玛薇卡？"
        },
        {
          "role": "玛薇卡",
          "text": "哦？怎么是你们呀，不好意思，刚才没注意到你们。"
        },
        {
          "role": "派蒙",
          "text": "你是在看着那个光柱发呆吧？那个天理的钉子引发的光柱…"
        },
        {
          "role": "玛薇卡",
          "text": "是啊，不论它的本质是什么，不论它会引发什么，都太危险了，在这个位置的话…"
        },
        {
          "role": "派蒙",
          "text": "纳塔这个…真的有点棘手呀，离大家住的地方这么近。"
        },
        {
          "role": "玛薇卡",
          "text": "听说你们在至冬，把那个若娜瓦给干掉了？可真厉害啊。"
        },
        {
          "role": "派蒙",
          "text": "可是…我们怀疑现在这种情况，会和若娜瓦的报复有关系…"
        },
        {
          "role": "派蒙",
          "text": "就算你夸我们，感觉也高兴不起来了，总觉得好像连累了大家。"
        },
        {
          "role": "玛薇卡",
          "text": "哪儿的话，要不是卡皮塔诺，当时若娜瓦要的就是我的命了，我也不喜欢她。"
        },
        {
          "role": "玛薇卡",
          "text": "若娜瓦和她所代表的天理，一直以来都把纳塔当做应对深渊和世界破碎的工具…"
        },
        {
          "role": "玛薇卡",
          "text": "…纳塔过去的那些灾劫也多是拜此所赐。"
        },
        {
          "role": "玛薇卡",
          "text": "就算未来真的有什么不好的事情发生，也并非你们的责任，不过是那些家伙一贯的肆意妄为罢了。"
        },
        {
          "role": "派蒙",
          "text": "是这个道理哦，谢谢玛薇卡的理解。"
        },
        {
          "role": "玛薇卡",
          "text": "不论如何，专注当下吧，我会通知附近的住民提防潜在风险的。"
        }
      ]
    }
  ]
}