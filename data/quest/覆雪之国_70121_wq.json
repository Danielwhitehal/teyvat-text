{
  "quest_id": 70121,
  "chapter_num": null,
  "chapter_title": "覆雪之国",
  "type": "wq",
  "route": "A Land Entombed",
  "stories": [
    {
      "story_id": 70121,
      "title": "覆雪之国",
      "description": "在雪山之中，你找到了一份奇怪的日志，上面似乎记载着某个王国的秘密。也许，营地里会有人知道和这本日志有关的线索…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆获得其中一本考察日志后触发任务"
        },
        {
          "role": "派蒙",
          "text": "咦？这是什么？是一本…日志？"
        },
        {
          "role": "派蒙",
          "text": "看起来，好像是以前在这里考察的人留下的记录…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，可能有人对这些…嗯，历史记录感兴趣，我们去问问吧。"
        },
        {
          "type": "subtitle",
          "text": "◆与史蒂文斯对话"
        },
        {
          "role": "史蒂文斯",
          "text": "唉，要是能有人帮忙就好了…不好意思，让你听到我的自言自语了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我找到了这本日志…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "史蒂文斯",
          "text": "嗯？在雪山上找到的？让我看看…"
        },
        {
          "role": "史蒂文斯",
          "text": "喔！这可真是了不得的宝藏。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "宝藏？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "宝藏！"
                },
                {
                  "role": "史蒂文斯",
                  "text": "…学术意义上的宝藏。"
                }
              ]
            }
          ]
        },
        {
          "role": "史蒂文斯",
          "text": "我以前游学的时候，曾经读过一些古老的年鉴。"
        },
        {
          "role": "史蒂文斯",
          "text": "一本年鉴上有记载，在骑士团的时代前，蒙德曾经有一支贵族向雪山派出了考察队。"
        },
        {
          "role": "史蒂文斯",
          "text": "但是不知道为什么，在那本年鉴里，关于那支考察团的事，并没有过多的细节记载…"
        },
        {
          "role": "史蒂文斯",
          "text": "如果这些考察日志真是那支考察队留下的，一定能成为重要的历史研究参考。"
        },
        {
          "role": "史蒂文斯",
          "text": "如果你愿意的话，能帮我再去雪山上搜索一下这些日志吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧！",
              "dialogues": []
            },
            {
              "text": "如果有宝藏的话…",
              "dialogues": [
                {
                  "role": "史蒂文斯",
                  "text": "哈哈哈，物质意义上的宝藏不一定有。"
                },
                {
                  "role": "史蒂文斯",
                  "text": "不过，如果你们肯帮忙。我也会准备好合适的…物质上的报酬，犒劳你对学术研究的伟大贡献。"
                }
              ]
            }
          ]
        },
        {
          "role": "史蒂文斯",
          "text": "根据这篇日志…考察队为了考察，总共去了这座雪山里的三个地方…"
        },
        {
          "role": "史蒂文斯",
          "text": "排除你们拿到日志的那一个，应该还有两个…"
        },
        {
          "role": "史蒂文斯",
          "text": "我看看…这里…还有这里…嗯，我给你在地图上标记一下。"
        },
        {
          "role": "史蒂文斯",
          "text": "那就拜托你了。一定要注意安全。"
        },
        {
          "type": "subtitle",
          "text": "◆取得考察日志•其之二"
        },
        {
          "role": "派蒙",
          "text": "找到了！这应该就是我们要找的日志了，里面写了什么？快点看看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆取得考察日志•其之一"
        },
        {
          "role": "派蒙",
          "text": "这应该就是我们要找的日志了，怎么会在这里…算了，快打开看看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆取得所有日志后与史蒂文斯对话"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于日志…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "史蒂文斯",
          "text": "你把剩下的两份日志也找到了？真是太感谢了。让我看看…"
        },
        {
          "role": "史蒂文斯",
          "text": "嗯…居然是这样…等等，这里的细节…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你发现什么了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "史蒂文斯",
          "text": "啊…哦，不好意思，刚刚有些走神了。"
        },
        {
          "role": "史蒂文斯",
          "text": "谢谢你，这些日志确实是相当宝贵的史料。在已有的资料里对于那支神秘的贵族探险队一直语焉不详，所有细节都只是一笔带过…"
        },
        {
          "role": "史蒂文斯",
          "text": "你带来的这些日志，补全了不少缺失的信息。"
        },
        {
          "role": "史蒂文斯",
          "text": "这么一来，为什么关于这支考察队的消息如此匮乏，在所有史料中只提过考察队出发的事情，一切都说得通了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实，大体上能明白。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "史蒂文斯",
          "text": "是的，虽然一些细节还需要再考证一下…但大体的框架已经很清楚了。"
        },
        {
          "role": "派蒙",
          "text": "派蒙不明白！"
        },
        {
          "role": "史蒂文斯",
          "text": "从结果而言，考察队里似乎没有一个人回到蒙德。但从这些日志上来看，至少有一个叫厄伯哈特的人可能逃了回来…"
        },
        {
          "role": "史蒂文斯",
          "text": "不过，蒙德城里却没有与之相关的资料记载，这个人到底去了哪呢，真是让人在意…"
        },
        {
          "role": "史蒂文斯",
          "text": "还有很多细节需要考证…"
        },
        {
          "role": "史蒂文斯",
          "text": "但无论如何，这都是非常宝贵的史料。"
        },
        {
          "role": "史蒂文斯",
          "text": "真的很感谢你。请你收下这些，作为报酬。"
        },
        {
          "role": "史蒂文斯",
          "text": "如果在雪山冒险是，发现了其他的书籍，还请你带到我这来。"
        },
        {
          "role": "史蒂文斯",
          "text": "那个叫做厄伯哈特的人，到底去了哪呢…"
        }
      ]
    }
  ]
}