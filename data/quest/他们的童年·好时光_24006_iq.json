{
  "quest_id": 24006,
  "chapter_num": null,
  "chapter_title": "他们的童年·好时光",
  "type": "iq",
  "route": "Their Childhood: Good Times",
  "stories": [
    {
      "story_id": 24006,
      "title": "他们的童年·好时光",
      "description": "奥雷勒，韦吕和洛薇似乎又在玩什么游戏…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与韦吕对话"
        },
        {
          "role": "韦吕",
          "text": "这次轮到我来抓人了，我肯定能抓住洛薇。"
        },
        {
          "role": "洛薇",
          "text": "那可说不准。有些地方你都爬不上去呢。"
        },
        {
          "role": "韦吕",
          "text": "那是…那是因为我的鞋子不适合爬，要是换双鞋，肯定能抓住你！"
        },
        {
          "role": "洛薇",
          "text": "那我们干脆把鞋子都脱掉好了，这样才公平！"
        },
        {
          "role": "奥雷勒",
          "text": "好了！你们不许光脚到处跑，这里到处都是废弃的零件，要是划伤了怎么办？"
        },
        {
          "role": "洛薇",
          "text": "是…"
        },
        {
          "role": "韦吕",
          "text": "好…"
        },
        {
          "role": "韦吕",
          "text": "那个…哥，你刚才抓我的时候，怎么一副走神的样子啊？我从你面前跑过去都没反应。"
        },
        {
          "role": "奥雷勒",
          "text": "咦？是这样吗？我刚才完全没注意到…"
        },
        {
          "role": "洛薇",
          "text": "是啊，我刚才绕着跑一圈啦，但你就和没看见我一样。"
        },
        {
          "role": "奥雷勒",
          "text": "但…欸？大哥哥，您怎么来了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "洛薇怎么在这？",
              "dialogues": [
                {
                  "role": "洛薇",
                  "text": "爸爸说他最近要去出差，妈妈也要出去工作。"
                },
                {
                  "role": "洛薇",
                  "text": "正好奥雷勒哥哥来还书，爸爸就拜托奥雷勒哥哥来照顾我，所以我就来这里和他们一起玩啦。"
                }
              ]
            },
            {
              "text": "你们还在玩捉迷藏吗？",
              "dialogues": [
                {
                  "role": "奥雷勒",
                  "text": "是的。因为德勒吕叔叔正巧要去出差，杜梅阿姨也要去工作，于是他们就拜托我来照顾洛薇。"
                },
                {
                  "role": "奥雷勒",
                  "text": "所以我就带着洛薇来这里和我们一起玩了，希望她的裙子不会被弄得太脏…"
                }
              ]
            }
          ]
        },
        {
          "role": "奥雷勒",
          "text": "不说这些了，继续玩吧，这次谁来抓人？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还以为你不太喜欢捉迷藏。",
              "dialogues": []
            },
            {
              "text": "你怎么突然这么想玩捉迷藏了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥雷勒",
          "text": "这个啊，咳…因为我最近正在写第一篇评论，需要思考一些问题。"
        },
        {
          "role": "奥雷勒",
          "text": "我发现…那个，在运动时我的思维会格外敏捷，所以…"
        },
        {
          "role": "洛薇",
          "text": "但就是容易走神，有时候还会站在原地自言自语，怎么叫都没反应。"
        },
        {
          "role": "韦吕",
          "text": "大哥哥，你陪我们玩玩吧，你玩捉迷藏肯定比哥哥厉害多了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "我可不会让你们。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "韦吕",
          "text": "嘿嘿，那可说不好，我和洛薇可都是捉迷藏大师。"
        },
        {
          "role": "韦吕",
          "text": "那就开始吧，快快快洛薇，我们去藏起来吧。"
        },
        {
          "role": "？？？",
          "text": "洛薇和韦吕飞快地跑开了，奥雷勒则沉思着缓步离开…"
        },
        {
          "type": "subtitle",
          "text": "找到孩子们"
        },
        {
          "role": "韦吕",
          "text": "还是被找到啦，大哥哥果然还是比我厉害。"
        },
        {
          "role": "韦吕",
          "text": "那我去集合点啦，希望哥哥能晚点被找到…"
        },
        {
          "role": "旅行者",
          "text": "你为什么这么希望？"
        },
        {
          "role": "韦吕",
          "text": "哥哥说过呀，每次玩捉迷藏了之后，他都会找到很多新思路。"
        },
        {
          "role": "韦吕",
          "text": "那些思路太多了，他每次都要蹲在地上记好久。"
        },
        {
          "role": "韦吕",
          "text": "洛薇和我说，那些思路可宝贵了，绝对不能打扰他。"
        },
        {
          "role": "韦吕",
          "text": "所以我和洛薇在和哥哥玩捉迷藏的时候。如果轮到他被抓，那我们就会故意拖长时间，等他记好了再去找他。"
        },
        {
          "role": "韦吕",
          "text": "就是…如果轮到哥哥抓人，那我们可就得等好长一段时间了…"
        },
        {
          "type": "subtitle",
          "text": "找到孩子们"
        },
        {
          "role": "奥雷勒",
          "text": "不行…这一段的逻辑不通顺，要从另外一个角度切入…"
        },
        {
          "role": "奥雷勒",
          "text": "这么…不对，还是不对…"
        },
        {
          "role": "奥雷勒",
          "text": "啊？我被找到了啊，我现在就去集合点。"
        },
        {
          "role": "奥雷勒",
          "text": "嗯…这个观点对吗？不对，呃…对不对呢…"
        },
        {
          "type": "subtitle",
          "text": "找到孩子们"
        },
        {
          "role": "洛薇",
          "text": "不知道奥雷勒哥哥能不能找到思路…"
        },
        {
          "role": "洛薇",
          "text": "咦？！这个地方也能被找到吗？大哥哥，你到底玩过多少次捉迷藏啊…"
        },
        {
          "role": "洛薇",
          "text": "那我回集合点啦，下次一定藏得再好点。"
        },
        {
          "type": "subtitle",
          "text": "与奥雷勒对话"
        },
        {
          "role": "奥雷勒",
          "text": "不对，不对…这里的论证不严谨…"
        },
        {
          "role": "洛薇",
          "text": "奥雷勒哥哥又不搭理人了…大哥哥，谢谢你陪我们玩啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他…没关系吗？",
              "dialogues": []
            },
            {
              "text": "他…不会太累吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "洛薇",
          "text": "只要他不像我爸爸一样，把咖啡当做水来喝，应该就不会有身体问题。"
        },
        {
          "role": "韦吕",
          "text": "这个问题嘛，就包在我身上，我不会让哥哥喝太多咖啡的，实在不行…我把他的咖啡都藏起来。"
        },
        {
          "role": "洛薇",
          "text": "唉，我还打算把我爸爸的咖啡，都拿过来藏在这里的…这下可藏不得啦。"
        },
        {
          "role": "韦吕",
          "text": "做评论家，可真是一件麻烦的事啊…"
        }
      ]
    }
  ]
}