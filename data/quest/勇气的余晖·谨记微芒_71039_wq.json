{
  "quest_id": 71039,
  "chapter_num": null,
  "chapter_title": "勇气的余晖·谨记微芒",
  "type": "wq",
  "route": "Valor's Afterglow: The Faint Light Remembered",
  "stories": [
    {
      "story_id": 71039,
      "title": "勇气的余晖·谨记微芒",
      "description": "志琼似乎要离开勘探队独自探险，独自进入层岩巨渊还是太危险了，还是尽快找到她吧…",
      "dialogues": [
        {
          "role": "瑾武",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好，瑾武姐！",
              "dialogues": []
            },
            {
              "text": "你还好吗！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑾武",
          "text": "…？！"
        },
        {
          "role": "派蒙",
          "text": "哇啊，吓我一跳！"
        },
        {
          "role": "瑾武",
          "text": "抱…抱歉。那个，如果你们要找志琼的话…她离队了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她去哪里了？",
              "dialogues": [
                {
                  "role": "瑾武",
                  "text": "我不知道…只是疏忽了一会，她就这样不见了。"
                }
              ]
            },
            {
              "text": "她离开时情况如何？",
              "dialogues": [
                {
                  "role": "瑾武",
                  "text": "……"
                },
                {
                  "role": "瑾武",
                  "text": "海迪夫给她做过了检查，她的情况很不好…"
                }
              ]
            }
          ]
        },
        {
          "role": "瑾武",
          "text": "我和她谈过了…她还是执意要走。好话坏话，或者拳头都留不住她。"
        },
        {
          "role": "瑾武",
          "text": "唉…希望她知道她自己在做什么吧。希望如此。"
        },
        {
          "role": "瑾武",
          "text": "希望如此…"
        },
        {
          "role": "瑾武",
          "text": "对了，这件事一定要和沐宁说。让他尽快组织一支搜救队，尽早找到那孩子才行！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们会去的。",
              "dialogues": []
            },
            {
              "text": "请你稍微安心。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "真是的…志琼怎么又不见了！我们快去地面找沐宁吧！"
        },
        {
          "type": "subtitle",
          "text": "向沐宁说明志琼离开之事"
        },
        {
          "role": "沐宁",
          "text": "嗯？志琼没和你一起上来吗？总务司的荐书下来了。"
        },
        {
          "role": "沐宁",
          "text": "因为她绘制的地图给辉山厅帮了大忙，总务司破格聘任她为…嗯，我看看…顾问向导，享受正式职位待遇。"
        },
        {
          "role": "沐宁",
          "text": "恭喜志琼啦，先前那样四处乱跑果然不是白做工的。"
        },
        {
          "role": "旅行者",
          "text": "她退出了。"
        },
        {
          "role": "沐宁",
          "text": "退出了？什么意思…？她先离开了吗？可是千岩军没有和我说有人离开过层岩巨渊啊…"
        },
        {
          "role": "旅行者",
          "text": "志琼退出了勘探队。"
        },
        {
          "role": "沐宁",
          "text": "啊？哦…"
        },
        {
          "role": "沐宁",
          "text": "等等！等等！"
        },
        {
          "role": "沐宁",
          "text": "不对不对…你说，她，退出了勘探队？"
        },
        {
          "role": "沐宁",
          "text": "志琼，退出了？"
        },
        {
          "role": "派蒙",
          "text": "对呀！你是哪个部分听不懂呀！"
        },
        {
          "role": "沐宁",
          "text": "…我明白了，我会即刻组织起一支搜救队。如果她还留在层岩巨渊，我们应该还能找到她。"
        },
        {
          "role": "沐宁",
          "text": "不管她是又一次自己犯傻，还是别的什么原因…要找到她才行。"
        },
        {
          "role": "沐宁",
          "text": "以她现在的状态，脱离队伍擅自行动完全是在胡闹…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "需要我帮忙吗？",
              "dialogues": [
                {
                  "role": "沐宁",
                  "text": "抱歉，这次就不需要劳烦你帮忙了…我也总得派上点用场嘛。"
                }
              ]
            },
            {
              "text": "关于志琼…",
              "dialogues": [
                {
                  "role": "沐宁",
                  "text": "她是个不安分的家伙，但我们再怎么说也算是朋友。我知道我不讨人喜欢…但我可不能随随便便就把朋友忘了。"
                },
                {
                  "role": "沐宁",
                  "text": "这家伙总是在做什么冒险家的大梦，之前受过几次重伤…还差点把命也搭进去。后来好不容易才安生了一段时间…"
                },
                {
                  "role": "沐宁",
                  "text": "本来以为她已经把不切实际的美梦抛之脑后了…罗尔德、斯坦利，哪有那么好当！"
                },
                {
                  "role": "沐宁",
                  "text": "唉…可是没想到…或许这次我不应该推荐请你来探索层岩巨渊才是，不然也不至于引起志琼的这把火…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "但她的努力并非毫无收获。",
                      "dialogues": [
                        {
                          "role": "沐宁",
                          "text": "收获…？你这样说，未免有点太功利了。她画下了地下大部分区域的地图，我们很感激没错…但…"
                        },
                        {
                          "role": "沐宁",
                          "text": "把「愿望」这种虚无缥缈的东西，和追求它的行为，放置于生命本身之上…？"
                        },
                        {
                          "role": "沐宁",
                          "text": "我是无论如何也不能理解的，我也不能想象有人真的为此置身危险之中。"
                        }
                      ]
                    },
                    {
                      "text": "但这是她的选择。",
                      "dialogues": [
                        {
                          "role": "沐宁",
                          "text": "选择，选择，选择…什么借口！她是在去送死，你没意识到吗？"
                        },
                        {
                          "role": "沐宁",
                          "text": "咳咳…抱歉，我的话说得有点太重了。但…在我们这些凡人无法扭转的情势面前…她应该更耐心些的。"
                        },
                        {
                          "role": "沐宁",
                          "text": "再等…二三十年，也许只用十年，说不定她就能等到更加安全的矿下设备研发完成了呢？到那时候她也用不着急着勘探地下地图了。"
                        },
                        {
                          "role": "沐宁",
                          "text": "但她一点也不愿意等等…只想在自己最年轻的时候，就完成别人一辈子的成就！"
                        },
                        {
                          "role": "沐宁",
                          "text": "这家伙太傻了…作为朋友，这件事我不能不管。"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "沐宁",
                  "text": "所以，寻找她的事情，就请包在我身上吧…呃，我是说，包在千岩军的搜救队身上吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "如果需要我帮忙，我一定尽快赶到。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，我也是！不能放着后辈不管呀！"
        },
        {
          "role": "派蒙",
          "text": "我们也在路上多多注意吧，说不定什么时候就能遇见她了呢！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（巨柱岩宫）"
        },
        {
          "role": "派蒙",
          "text": "快看，有人好像在这里扎了营火！"
        },
        {
          "type": "subtitle",
          "text": "与志琼的信交互",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "唔…好长的一封信，是志琼留下来的呢！"
        },
        {
          "role": "旅行者",
          "text": "没错，是志琼的信…"
        },
        {
          "role": "派蒙",
          "text": "可恶…还是找不到她人在哪里，我们先回去跟瑾武说一声吧！"
        },
        {
          "type": "subtitle",
          "text": "获得志琼的信、{{图标|琉璃寒晶}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "志琼说她自己一个人顺着深处的通路离开了…可究竟是哪里呢？哪里还有通路呀…"
        },
        {
          "role": "派蒙",
          "text": "我们还有机会再见到她吗…？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（瑾武）"
        },
        {
          "role": "派蒙",
          "text": "瑾武姐，我们找到了这个！"
        },
        {
          "role": "瑾武",
          "text": "好了，好了，不要着急。你们找到了什么？和志琼的下落有关吗？"
        },
        {
          "role": "旅行者",
          "text": "是她留下的信，她去了层岩巨渊的更深处。"
        },
        {
          "role": "瑾武",
          "text": "…谢谢，请让我看看她写了什么。"
        },
        {
          "type": "subtitle",
          "text": "瑾武仔细地阅读了志琼的信",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "瑾武",
          "text": "这个孩子…我从没有想过这么宏大的问题，也不好评价她的选择。但或许…"
        },
        {
          "role": "瑾武",
          "text": "或许我没能来得及重视她的发现，没能给她足够的尊重和理解吧。"
        },
        {
          "role": "瑾武",
          "text": "明明没有她的地图的话，后续的勘察根本难以完成…但我一直只顾着担心她的身体情况，却无视了她的努力与拼命达成的成就…"
        },
        {
          "role": "瑾武",
          "text": "毕竟她与我们这些矿工从一开始就是不同的，我怎么就没有想过这点呢…"
        },
        {
          "role": "旅行者",
          "text": "她只是不想被遗忘。"
        },
        {
          "role": "瑾武",
          "text": "对我们这些从未被神审视的普通人来说，谁又不是呢…"
        },
        {
          "role": "瑾武",
          "text": "谁又不是呢…但谁像她这样执着呢？"
        },
        {
          "role": "瑾武",
          "text": "但一旦想到自己曾在某一刻放弃了想让自己变得伟大的执着…一旦意识到自己习惯了日复一日的平凡…"
        },
        {
          "role": "瑾武",
          "text": "也就更无颜面评判志琼这样的年轻人了…"
        }
      ],
      "collapse_ranges": [
        [
          31,
          39
        ],
        [
          40,
          54
        ]
      ]
    }
  ]
}