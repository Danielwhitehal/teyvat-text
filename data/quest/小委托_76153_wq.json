  "stories": [
    {
      "story_id": 76153,
      "title": "小委托",
      "description": "在听说了萨维特的「小生意」之后，雅珂达似乎有什么话想和萨维特说…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与萨维特对话"
        },
        {
          "role": "萨维特",
          "text": "出版业也不挣钱哪，要不干脆只做投资算了…"
        },
        {
          "role": "旅行者",
          "text": "想看看投资券…"
        },
        {
          "role": "萨维特",
          "text": "好嘞，投资券2000摩拉一张，每周结算一次，嘿嘿，这小袋子里…"
        },
        {
          "role": "萨维特",
          "text": "…呃！"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "萨维特",
          "text": "雅珂达，你怎么来了，是奈芙尔老板有什么…"
        },
        {
          "role": "雅珂达",
          "text": "没有，我就是陪着我的朋友来这里随便逛逛。"
        },
        {
          "role": "雅珂达",
          "text": "嘿嘿，看来萨维特老板的投资生意确实做得很好啊。"
        },
        {
          "role": "萨维特",
          "text": "一般！一般，哈哈哈…小本生意，糊口罢了。"
        },
        {
          "role": "萨维特",
          "text": "（这丫头…话里有话！肯定是奈芙尔派她过来的…嘁。）"
        },
        {
          "role": "旅行者",
          "text": "这真的能赚钱吗？"
        },
        {
          "role": "雅珂达",
          "text": "当然啦，老板说了，萨维特老板可是最最有声望，最最有能力的商人。跟着他投资，准没错。"
        },
        {
          "role": "萨维特",
          "text": "是…是…哈哈哈…"
        },
        {
          "role": "萨维特",
          "text": "（果然是奈芙尔…！）"
        },
        {
          "role": "旅行者",
          "text": "那什么时候能结算投资…"
        },
        {
          "role": "萨维特",
          "text": "今天！就在今天，您刚才买的是我们刚刚推出的…短线投资券！盈亏立即结算！"
        },
        {
          "role": "派蒙",
          "text": "怎么感觉这些话都是你刚刚才编出来的…"
        },
        {
          "role": "萨维特",
          "text": "呃…总、总之，感谢您购买短线投资券！"
        },
        {
          "role": "萨维特",
          "text": "这是您的投资回报，祝您拥有美好的一天！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "总之赚钱是好事啦…",
              "dialogues": []
            },
            {
              "text": "走，派蒙，我们去买糖雕吃。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "真的？嘿嘿嘿，那你给我买一个小鸟形状的，我就喜欢那样的！"
        },
        {
          "role": "雅珂达",
          "text": "欸，我和你们一起去，给老板也带一个回去。"
        },
        {
          "role": "萨维特",
          "text": "雅…雅珂达小姐，稍等！"
        },
        {
          "role": "萨维特",
          "text": "…那个，奈芙尔老板是否交代您了什么…"
        },
        {
          "role": "雅珂达",
          "text": "啊。老板说：「东西已经找到了。」"
        },
        {
          "role": "雅珂达",
          "text": "「萨维特先生，不要心急。事情，要一步一步地做才稳当。」"
        },
        {
          "role": "萨维特",
          "text": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望二位了…"
        },
        {
          "role": "萨维特",
          "text": "哟，这不是老主顾吗，今天也来买投资券？"
        },
        {
          "role": "旅行者",
          "text": "给我来张投资券。"
        },
        {
          "role": "萨维特",
          "text": "好嘞，2000摩拉一张，每周结算一次，相信我，这一定是…一笔…"
        },
        {
          "role": "萨维特",
          "text": "雅珂达，你怎么来了，是奈芙尔老板有什么…"
        },
        {
          "role": "雅珂达",
          "text": "没有，我就是陪着我的朋友来这里随便逛逛。"
        },
        {
          "role": "雅珂达",
          "text": "嘿嘿，看来萨维特老板的投资生意确实做得很好啊。"
        },
        {
          "role": "萨维特",
          "text": "一般！一般，哈哈哈…小本生意，糊口罢了。"
        },
        {
          "role": "萨维特",
          "text": "（这丫头…话里有话！肯定是奈芙尔派她过来的…嘁。）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这种投资的回报真的高吗…",
              "dialogues": []
            },
            {
              "text": "感觉赚不了多少钱…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "雅珂达",
          "text": "当然啦，老板说了，萨维特老板可是最最有声望，最最有能力的商人。跟着他投资，准没错。"
        },
        {
          "role": "萨维特",
          "text": "咳…！是、是…奈芙尔老板说的是。"
        },
        {
          "role": "萨维特",
          "text": "（果然是奈芙尔…！）"
        },
        {
          "role": "旅行者",
          "text": "那看看今天的投资回报…"
        },
        {
          "role": "萨维特",
          "text": "今天…我正想恭喜您呢！您上次买的投资券，可是大大的赚了一笔啊！"
        },
        {
          "role": "派蒙",
          "text": "你的表情好可疑喔…不会这些话都是你刚刚才编出来的吧？"
        },
        {
          "role": "萨维特",
          "text": "呃…嗨！我说的这都是真的，不愧是旅行者，真是慧眼独具啊！"
        },
        {
          "role": "萨维特",
          "text": "来，这是您的投资回报，祝您拥有美好的一天！"
        },
        {
