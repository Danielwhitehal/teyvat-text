{
  "quest_id": 74677,
  "chapter_num": null,
  "chapter_title": "优雅剑舞的艺术？",
  "type": "wq",
  "route": "The Art of the Elegant Blade Dance?",
  "stories": [
    {
      "story_id": 74677,
      "title": "优雅剑舞的艺术？",
      "description": "在白露区某个不起眼的角落，你与派蒙发现了一座秘境的入口，某位兴致高昂的「剑客」向你们发出了特别的邀请…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与古怪的「剑客」对话"
        },
        {
          "role": "科斯唐坦",
          "text": "哈哈！两位仪表不凡的冒险家与我科斯唐坦在此相遇，实属缘分…"
        },
        {
          "role": "科斯唐坦",
          "text": "那么二位，请大声回答我——你们想战斗吗？"
        },
        {
          "role": "派蒙",
          "text": "好突然！这是什么展开话题的新把戏吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "找茬？",
              "dialogues": []
            },
            {
              "text": "找打？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "科斯唐坦",
          "text": "不，我并不是在挑战二位。"
        },
        {
          "role": "科斯唐坦",
          "text": "我所说的战斗，并非闲来无事发泄怒气的愚行，并非拦路贼匪的恶意阻截。"
        },
        {
          "role": "科斯唐坦",
          "text": "而是一种释放热情的颂歌，是赞美生命本能的艺术！"
        },
        {
          "role": "科斯唐坦",
          "text": "生命的演进赋予了我们持剑的手，我们也就有义务好好使用这双手，紧握漂亮的剑，优雅地战斗！"
        },
        {
          "role": "科斯唐坦",
          "text": "作为强大冒险家的二位，绝对是这个艺术领域的大师！"
        },
        {
          "role": "派蒙",
          "text": "你好像对战斗有什么误解，说得也太美好太夸张了。"
        },
        {
          "role": "派蒙",
          "text": "就算我平常没有直接撸起袖子打过架，光看旅行者对付敌人也知道，战斗可是很辛苦的。"
        },
        {
          "role": "派蒙",
          "text": "而且我们也没自报过身份，你怎么就肯定我们很能打呢？"
        },
        {
          "role": "科斯唐坦",
          "text": "这儿距离枫丹廷可不近，沿途的魔物可不少。二位不是一路拼杀过来的，难不成还是从天上掉下来的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "错！我还有更妙的移动方式！",
              "dialogues": []
            },
            {
              "text": "错！我们是从巡轨船跳船的！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "科斯唐坦",
          "text": "但你们身上的气势不会说谎！你们肯定战胜过很多强敌，也会对我身后这座秘境中的强敌感兴趣…"
        },
        {
          "role": "派蒙",
          "text": "嘿！回到我熟悉的话题了！你接下来的台词是——「请你们两位向我演示精妙的战斗吧！」"
        },
        {
          "role": "科斯唐坦",
          "text": "没错！请你们两位向我演示精妙的战斗吧！"
        },
        {
          "role": "派蒙",
          "text": "所以我们的回答是——你自己怎么不去呢？"
        },
        {
          "role": "科斯唐坦",
          "text": "因为我刚在里边被痛揍了一顿，抓紧时间化了个妆，你们才没看见我脸上青一块紫一块的痕迹。"
        },
        {
          "role": "派蒙",
          "text": "居然大大方方地承认了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "呜呜，你好惨哦！",
              "dialogues": []
            },
            {
              "text": "厉害，不愧是你！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "科斯唐坦",
          "text": "这不是什么丢脸的事，毕竟我本来只是个作家，练习时间不够长，战斗的本领自然不够专业。"
        },
        {
          "role": "科斯唐坦",
          "text": "我会亲身实践，全是因为在查阅资料时，发现了一位名为「轻剑舞者」[[勒非尼]]的传闻。"
        },
        {
          "role": "科斯唐坦",
          "text": "他将战斗比作剑舞，与某位才华横溢的工程师共同构筑了多个战斗的舞台，进行了数次精妙的表演…"
        },
        {
          "role": "科斯唐坦",
          "text": "可谓优雅至极！"
        },
        {
          "role": "科斯唐坦",
          "text": "虽说最后他被执律庭追捕，逃出了枫丹，但这样一位怪谈角色的事迹，可是上好的素材，不能被白白浪费了！"
        },
        {
          "role": "派蒙",
          "text": "难道说，你在模仿那位传说中的人物…"
        },
        {
          "role": "科斯唐坦",
          "text": "正是如此！为了领会他的心境，我苦心寻找多年，好不容易发现了这个秘境。"
        },
        {
          "role": "科斯唐坦",
          "text": "好运眷顾了我，这似乎就是当年「轻剑舞者」构筑的舞台之一！要是有人向我演示所谓剑舞的全貌…"
        },
        {
          "role": "科斯唐坦",
          "text": "我肯定能以「轻剑舞者」为原型，写出一本剑客题材的小说，将这份优雅延续下去！"
        },
        {
          "role": "科斯唐坦",
          "text": "当然，我肯定会给两位支付丰厚的报酬。"
        },
        {
          "role": "科斯唐坦",
          "text": "你们的辛苦付出还会被我的文字记录，成为小说读者之间长久流传的美谈…"
        },
        {
          "role": "派蒙",
          "text": "你的用词这么夸张，搞得我都有点好奇了…旅行者，你感兴趣吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "打架有钱拿？",
              "dialogues": []
            },
            {
              "text": "不拿白不拿！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "说得也是哦…那我们就答应这位剑客作家了？"
        },
        {
          "role": "科斯唐坦",
          "text": "豪爽！我果然没有看走眼！"
        },
        {
          "role": "科斯唐坦",
          "text": "那就辛苦二位了！我布置在秘境暗处的留影机，会将你们的英姿全都记录下来！"
        },
        {
          "role": "科斯唐坦",
          "text": "报答二位的酬劳，也恭候着二位的捷报！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（科斯唐坦）"
        },
        {
          "role": "科斯唐坦",
          "text": "二位，请尽情施展你们的艺术才华，漂亮地战斗吧！"
        },
        {
          "role": "科斯唐坦",
          "text": "我布置在秘境暗处的留影机，会将你们的英姿全都记录下来！"
        }
      ],
      "collapse_ranges": [
        [
          39,
          41
        ]
      ]
    }
  ]
}