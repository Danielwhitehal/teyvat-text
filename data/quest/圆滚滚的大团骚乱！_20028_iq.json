{
  "quest_id": 20028,
  "chapter_num": null,
  "chapter_title": "圆滚滚的大团骚乱！",
  "type": "iq",
  "route": "Big Pudgy Problem!",
  "stories": [
    {
      "story_id": 20028,
      "title": "圆滚滚的大团骚乱！",
      "description": "史莱姆突然在清泉镇后山出现，在附近的胆小的莫罗似乎被卷入其中…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前去查看详请"
        },
        {
          "type": "subtitle",
          "text": "消灭史莱姆"
        },
        {
          "type": "subtitle",
          "text": "和胆小的莫罗对话"
        },
        {
          "role": "胆小的莫罗",
          "text": "谢，谢谢你，旅行者…"
        },
        {
          "role": "胆小的莫罗",
          "text": "虽然是猎人…但是我也拿这些史莱姆没办法。"
        },
        {
          "role": "胆小的莫罗",
          "text": "被这群家伙一搅合，这次狩猎我又什么都带不回去了。"
        },
        {
          "role": "胆小的莫罗",
          "text": "只希望别的猎人不要和我一样倒霉…"
        },
        {
          "role": "胆小的莫罗",
          "text": "对了，说起这个，能请你去周围看看吗？"
        },
        {
          "role": "胆小的莫罗",
          "text": "不知道是不是我的错觉，在镇子周围…史莱姆好像越来越多了。"
        },
        {
          "role": "胆小的莫罗",
          "text": "请你去前头看看吧。如果发现了史莱姆，就直接把它们消灭掉吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "胆小的莫罗",
                  "text": "那就拜托你了，我也会回去和杜拉夫先生报告的。"
                },
                {
                  "role": "胆小的莫罗",
                  "text": "希望他别喝太多了，能听进去我说的话…"
                }
              ]
            },
            {
              "text": "还有别的事。",
              "dialogues": [
                {
                  "role": "胆小的莫罗",
                  "text": "但有能力能解决这件事的人，只有你了。为了清泉镇，就拜托你了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往异常地点"
        },
        {
          "type": "subtitle",
          "text": "用「风」驱散尘埃"
        },
        {
          "type": "subtitle",
          "text": "消灭全部史莱姆"
        }
      ]
    }
  ]
}