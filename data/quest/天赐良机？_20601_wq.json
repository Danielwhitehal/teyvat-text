{
  "quest_id": 20601,
  "chapter_num": null,
  "chapter_title": "天赐良机？",
  "type": "wq",
  "route": "A Fine Opportunity?",
  "stories": [
    {
      "story_id": 20601,
      "title": "天赐良机？",
      "description": "虽然在风暴之中，冒险家协会的塞琉斯先生却正在摩拳擦掌…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与塞琉斯对话"
        },
        {
          "type": "subtitle",
          "text": "寻找杰克的踪迹"
        },
        {
          "type": "subtitle",
          "text": "寻找杰克的踪迹"
        },
        {
          "type": "subtitle",
          "text": "解救被围困的杰克"
        },
        {
          "role": "塞琉斯",
          "text": "班尼特这小子又跑到哪去了，唉，这个关头…他可别再出什么意外…"
        },
        {
          "type": "subtitle",
          "text": "与杰克对话"
        },
        {
          "role": "杰克",
          "text": "嘶，疼…"
        },
        {
          "role": "杰克",
          "text": "谢谢你，我还以为自己回不去了。"
        },
        {
          "role": "旅行者",
          "text": "你怎么样？"
        },
        {
          "role": "杰克",
          "text": "哈，一点小伤…呃！一点…小伤，我没问题。"
        },
        {
          "role": "杰克",
          "text": "我是因为发现一群丘丘人正在向前面的营地里集结，觉得它们想要做什么，才跟了上去。"
        },
        {
          "role": "杰克",
          "text": "…但我跟踪调查的时候靠得太近，不小心就被它们发现了。"
        },
        {
          "role": "杰克",
          "text": "不说这个了，不用担心我，请快点去把前面的丘丘人都清理掉！"
        },
        {
          "role": "杰克",
          "text": "它们的数量越来越多，绝不能让它们的阴谋得逞。"
        },
        {
          "role": "杰克",
          "text": "至于我…我会照顾好我自己的。"
        },
        {
          "type": "subtitle",
          "text": "清理营地"
        },
        {
          "type": "subtitle",
          "text": "与塞琉斯对话"
        },
        {
          "role": "塞琉斯",
          "text": "你回来了，杰克也回来了，但是一瘸一拐的…"
        },
        {
          "role": "塞琉斯",
          "text": "到底发生什么了？"
        },
        {
          "role": "旅行者",
          "text": "杰克因为冒进受伤了…"
        },
        {
          "role": "塞琉斯",
          "text": "果然和我想的一样，唉…平时我和他说的话，他都没怎么记得。"
        },
        {
          "role": "塞琉斯",
          "text": "虽然我也理解他想要证明自己的心思，但是…"
        },
        {
          "role": "塞琉斯",
          "text": "算了，这件事我已经了解了，杰克那边我会去和他谈谈。"
        },
        {
          "role": "塞琉斯",
          "text": "这是给你的，算是你冒险的奖励吧。"
        },
        {
          "role": "杰克",
          "text": "你已经清理掉那个营地了吧。"
        },
        {
          "role": "旅行者",
          "text": "是的。"
        },
        {
          "role": "杰克",
          "text": "你的实力可真强啊，要是我能像你一样优秀就好了…"
        },
        {
          "role": "杰克",
          "text": "我也想留下斩杀恶龙、拯救世界的传说，但到头来连丘丘人都没法胜过…"
        },
        {
          "role": "杰克",
          "text": "呃，那个…虽然很不好意思，但是我有件事拜托你…"
        },
        {
          "role": "杰克",
          "text": "其实我这次之所以会去千风神殿调查，是因为我马上就要「冒险等阶评定」了…"
        },
        {
          "role": "杰克",
          "text": "我想着如果能在这个时候展现出实力的话，等阶评定一定会顺利不少。"
        },
        {
          "role": "杰克",
          "text": "但是没想到，实力没展现出来，反而差点把自己给赔进去。"
        },
        {
          "role": "杰克",
          "text": "能，能拜托你，别把我的惨样告诉塞琉斯先生吗？要是真的影响到「冒险等阶评定」，那我就真的惨了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了…",
              "dialogues": [
                {
                  "role": "杰克",
                  "text": "太谢谢你了！我以后一定不会再这么鲁莽了！"
                }
              ]
            },
            {
              "text": "这样不好。",
              "dialogues": [
                {
                  "role": "杰克",
                  "text": "我知道这样不好，塞琉斯先生也说「冒险家应该直面自己」…"
                },
                {
                  "role": "杰克",
                  "text": "但是…唉，算了，希望塞琉斯先生不会太生我的气…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与塞琉斯对话"
        },
        {
          "role": "杰克",
          "text": "唉，希望我的「冒险等阶评定」不会受到影响…"
        },
        {
          "role": "塞琉斯",
          "text": "你回来了，杰克也回来了，但是一瘸一拐的。"
        },
        {
          "role": "塞琉斯",
          "text": "到底发生什么了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "杰克战斗时很英勇。",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "你和他并肩作战了吗？原来他是这么受伤的…"
                },
                {
                  "role": "塞琉斯",
                  "text": "唉，英勇是好事…但我宁愿他更加稳重一些，毕竟，活下来的冒险家才是冒险家。"
                },
                {
                  "role": "塞琉斯",
                  "text": "旅行者，你和杰克的勇气都值得嘉奖，这些东西你拿着，算是你冒险的奖励吧。"
                }
              ]
            },
            {
              "text": "杰克因为冒进受伤了…",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "果然和我想的一样，唉…平时我和他说的话，他都没怎么记得。"
                },
                {
                  "role": "塞琉斯",
                  "text": "虽然我也理解他想要证明自己的心思，但是…"
                },
                {
                  "role": "塞琉斯",
                  "text": "算了，这件事我已经了解了，杰克那边我会去和他谈谈。"
                },
                {
                  "role": "塞琉斯",
                  "text": "这是给你的，算是你冒险的奖励吧。"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}