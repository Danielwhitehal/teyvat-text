{
  "quest_id": 10159,
  "chapter_num": "特尔克西的奇幻历险·下",
  "chapter_title": "奇迹的冠冕",
  "type": "eq",
  "route": "Miraculous Crown",
  "stories": [
    {
      "story_id": 40130,
      "title": "奇迹的冠冕",
      "description": "直到历险的最后你们发现，真正需要帮助不是「水妖王子」，而是他的母亲。但你们仍然完成了幻想的加冕仪式，就在那个时刻，奇迹般地，离去的王子好像从童话世界回来了，他赶走了纠缠妈妈的孤独病，和妈妈好好道了别。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后"
        },
        {
          "role": "派蒙",
          "text": "今天是《特尔克西的奇幻历险》最后一天啦！我们快去菲米尼的营地吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（祖莉亚夫人家敲门）"
        },
        {
          "role": "屋内的男声",
          "text": "哪位？屋内有病人在静养，没有要事就请回吧。"
        },
        {
          "type": "subtitle",
          "text": "刻有字迹的贝壳（三）"
        },
        {
          "type": "subtitle",
          "text": "「听！海的女神举起了杵，王子的丧钟，叮叮、叮叮、叮叮。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往菲米尼的营地"
        },
        {
          "role": "派蒙",
          "text": "嘿！菲米尼！「特尔克西」！我们来啦~"
        },
        {
          "role": "菲米尼",
          "text": "你好，派蒙，还有旅行者。"
        },
        {
          "role": "「特尔克西」",
          "text": "-.. -... .-- -...？{{黑幕|ça va?（法语，你好吗？）}}"
        },
        {
          "role": "派蒙",
          "text": "今天王冠是不是已经做好啦？"
        },
        {
          "role": "菲米尼",
          "text": "嗯，现在就等祖莉亚夫人了，她还没到。"
        },
        {
          "role": "派蒙",
          "text": "那我们再等一会好啦，或者直接去找她，反正离的也不远，她家就在那边的山坡上吧？"
        },
        {
          "role": "？？？",
          "text": "喂！旅行者！派蒙！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，说着说着就来了吗？"
        },
        {
          "role": "德拉萝诗",
          "text": "终于找到你们了…你们没事真是太好了…"
        },
        {
          "role": "派蒙",
          "text": "咦？德拉萝诗小姐，怎么是你？我们能有什么事呀？"
        },
        {
          "role": "德拉萝诗",
          "text": "什么事？当然是特尔克西啊！那个可怕的水妖！那天委托你们之后，我也放不下心，又去打听了一下那个走进水里的孩子…"
        },
        {
          "role": "派蒙",
          "text": "那个我们都调查清楚了，其实就是菲米尼这家伙啦，鱼群也是他吓跑的。你放心，等我们完成工作，就能帮你把鱼群找回来。"
        },
        {
          "role": "菲米尼",
          "text": "抱歉，我是一名潜水员…"
        },
        {
          "role": "德拉萝诗",
          "text": "欸？菲米尼？潜水员？不不不…这不对吧？我的消息可不是这样…"
        },
        {
          "role": "德拉萝诗",
          "text": "我打听到，大概一个月前，有个孩子在身上绑满了沉重的贝壳，走进了身后这片水中…再也没回来…这绝对是被水妖蛊惑了啊！"
        },
        {
          "role": "派蒙",
          "text": "什么？你…你应该搞错了吧？"
        },
        {
          "role": "德拉萝诗",
          "text": "千真万确，我向几位德高望重的渔师都确认过了，那孩子今年八岁，叫莱斯科，莱斯科·德斯特雷。"
        },
        {
          "role": "菲米尼",
          "text": "等等…莱斯科·德斯特雷？"
        },
        {
          "role": "德拉萝诗",
          "text": "对，就是这个名字，据说他家祖上是从一个叫斯特雷的地方搬来的，他母亲是一位小有名气的画商，父亲说是早就意外离世了。"
        },
        {
          "role": "德拉萝诗",
          "text": "唉…出了这事，他母亲大受打击，一病不起，听说现在已经离开枫丹廷，不知去哪了。"
        },
        {
          "role": "派蒙",
          "text": "不会吧？莱斯科·德斯特雷…祖莉亚·德斯特雷…不会这么巧吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看来得去一趟祖莉亚夫人家。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲米尼",
          "text": "这位小姐，抱歉了！我们有事得先离开一下！"
        },
        {
          "role": "德拉萝诗",
          "text": "噢噢…你们先忙，我就是来看看，你们没事就好，那我就先回去了…你们注意安全哦！"
        },
        {
          "type": "subtitle",
          "text": "前往祖莉亚·德斯特雷夫人的小屋"
        },
        {
          "type": "subtitle",
          "text": "你们来到祖莉亚夫人所说的小屋前…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "喂？有人在吗？这里是祖莉亚夫人家吗？"
        },
        {
          "role": "屋内的男声",
          "text": "哪位？屋内有病人在静养，没有要事就请回吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谁是病人？",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "门在一阵短暂的沉默后打开了，一个男人走了出来，他的眼神满是疑惑…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "贾拉康",
          "text": "这里是祖莉亚·德斯特雷家，我是她的家庭医生贾拉康。你们刚刚的话什么意思？还有谁是病人？"
        },
        {
          "role": "派蒙",
          "text": "不是祖莉亚夫人的孩子吗？她亲口告诉我们的，说她的孩子得了孤独病…"
        },
        {
          "role": "贾拉康",
          "text": "没错，莱斯科少爷确实患过孤独病，可他…算了…总之少爷已经不在了，现在孤独病又缠上了夫人，你们…是她的朋友吗？"
        },
        {
          "type": "subtitle",
          "text": "在沉默的间隙中，讲述了这几天的事…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "贾拉康",
          "text": "原来这几天她要求的散心时间，是和你们在一起。"
        },
        {
          "role": "菲米尼",
          "text": "所以其实…陷入失控性幻想的人是祖莉亚夫人自己？她以为她的孩子还活着？"
        },
        {
          "role": "贾拉康",
          "text": "是的，少爷出事那天，夫人正在操办一场画展，那是专门为少爷准备的，可却反而让夫人没能见到她的孩子最后一面。"
        },
        {
          "role": "贾拉康",
          "text": "或许这成了她的心结，又或许早在夫人的丈夫意外离世时，孤独病的种子就已经扎根在这个家庭了，先是少爷，再是夫人…"
        },
        {
          "role": "派蒙",
          "text": "怎么会这样…可祖莉亚夫人明明看起来一切都很好…她笑得很开心，她还教我们乐观，她…"
        },
        {
          "role": "贾拉康",
          "text": "这正是病人混淆幻想与现实的表现。"
        },
        {
          "role": "派蒙",
          "text": "那她和我们说的，关于她孩子的那些事…难道都是假的吗？"
        },
        {
          "role": "贾拉康",
          "text": "不，那些事都是真的，只不过是少爷离开之前发生的事，而夫人的时间也停留在了那一刻。"
        },
        {
          "role": "菲米尼",
          "text": "所以在那之后，她就幻想出了一个世界，那个世界里她的孩子还在，她正努力想要治好孩子的病，她找到了我们…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那现在祖莉亚夫人怎么样了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "贾拉康",
          "text": "这几天她情绪一直不错，每次散心都是哼着歌儿回来的，还主动和我讨论了关于引导幻想来缓解孤独症的疗法，直到昨晚…"
        },
        {
          "role": "贾拉康",
          "text": "夫人对着少爷的遗物看了一夜，是一颗刻着遗言的贝壳…然后她再次崩溃了…我给夫人开了一些镇静的药物，她现在还在休息。"
        },
        {
          "role": "派蒙",
          "text": "那…那该怎么办呀？怎么样能帮到她吗？我们快帮帮祖莉亚夫人吧…"
        },
        {
          "role": "菲米尼",
          "text": "别着急派蒙…别着急…虽然这个消息让人难过，但我们现在必须要冷静一点…"
        },
        {
          "role": "菲米尼",
          "text": "（怎么办？快想办法…想想曾经的壁炉之家…想想那些孩子…那些病人…还有医生的话…啊！有了…）"
        },
        {
          "role": "菲米尼",
          "text": "贾拉康医生，你有没有见过一个绘本，祖莉亚夫人应该把它带回来了。"
        },
        {
          "role": "贾拉康",
          "text": "年轻人…你是想用夫人说的那个引导幻想的方法吗？我明白了，我去拿来。"
        },
        {
          "type": "subtitle",
          "text": "医生很快拿着绘本交给了菲米尼。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "菲米尼",
          "text": "没错…就是这个。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们要继续完成绘本和历险？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲米尼",
          "text": "嗯…如果按照贾拉康医生所说，那我们这几天经历的一定对夫人有帮助，所以我们该继续完成它。"
        },
        {
          "role": "菲米尼",
          "text": "我们要让祖莉亚夫人看见，她的孩子在那个世界有了美好的结局。"
        },
        {
          "role": "派蒙",
          "text": "但是…这难道不会让她更难以接受现实吗？"
        },
        {
          "role": "贾拉康",
          "text": "接受现实的前提是直面现实，夫人被崩溃的情绪击倒，不敢再看一眼现实，我们首先得帮她脱离这个状态。"
        },
        {
          "role": "菲米尼",
          "text": "嗯…在今天前，我以为《特尔克西的奇幻历险》是祖莉亚夫人用来拯救她孩子的，但现在我想，那也许是用来拯救夫人自己的。"
        },
        {
          "role": "菲米尼",
          "text": "如果我们完成它，我想祖莉亚夫人就能获得些许慰藉和鼓舞，也就能获得些许直视现实的勇气吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只能试一试了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲米尼",
          "text": "事不宜迟…我们现在就出发吧。"
        },
        {
          "type": "subtitle",
          "text": "调查（刻有字迹的贝壳（三））"
        },
        {
          "role": "刻有字迹的贝壳（三）",
          "text": "「听！海的女神举起了杵，王子的丧钟，叮叮、叮叮、叮叮。」"
        },
        {
          "type": "subtitle",
          "text": "前往水妖王国"
        },
        {
          "role": "派蒙",
          "text": "又到了这里，已经是「特尔克西」旅程的最后一段了，却少了最重要的人…"
        },
        {
          "role": "「特尔克西」",
          "text": "-. -... -. -... ---{{黑幕|maman（法语，妈妈）}}"
        },
        {
          "role": "菲米尼",
          "text": "大家…别这么沉重…祖莉亚夫人说过，要是我们也忧心忡忡，病人会被传染的。"
        },
        {
          "role": "派蒙",
          "text": "说得对，我要笑一下！如果要把什么传染给祖莉亚夫人，那就是笑容！我们要带着笑容完成这场历险。"
        },
        {
          "role": "派蒙",
          "text": "然后祖莉亚夫人就会好起来，对不对？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一定会的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲米尼",
          "text": "嗯，一定会的。"
        },
        {
          "type": "subtitle",
          "text": "夺回「特尔克西」的王冠"
        },
        {
          "type": "subtitle",
          "text": "第一波敌人出现",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "勇者们小心！现在袭来的是夺走了王冠的可恶敌人！它们是…是…是独眼海宝！揍扁他们！"
        },
        {
          "role": "「特尔克西」",
          "text": "-.. -... .-- -...？！"
        },
        {
          "type": "subtitle",
          "text": "第二波敌人出现",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "菲米尼",
          "text": "大家注意，敌人又来了！"
        },
        {
          "role": "派蒙",
          "text": "不用怕，今天的王子殿下看起来比之前更强了，他一定也在全力以赴了吧！"
        },
        {
          "role": "「特尔克西」",
          "text": "-.. -... .-- -...？！"
        },
        {
          "type": "subtitle",
          "text": "第三波敌人出现",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这就是最后的敌人了吧？王子殿下，我们一定会帮你夺回王冠！"
        },
        {
          "role": "「特尔克西」",
          "text": "-.. -... .-- -...？！！"
        },
        {
          "type": "subtitle",
          "text": "离开水妖王国"
        },
        {
          "type": "subtitle",
          "text": "返回祖莉亚夫人的小屋"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "抱歉…我得离开了，我和朋友约好了，我已经迟到很久了。"
        },
        {
          "role": "贾拉康",
          "text": "夫人，你的身体…"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "不要拦着我！今天是治疗特尔克西最重要的日子！我们会用引导幻想的疗法，你也觉得会有用的，不是吗？"
        },
        {
          "role": "贾拉康",
          "text": "我不是阻止你，夫人，只是…你的孩子叫什么？"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "贾拉康医生，你怎么能忘记你病人的名字？他叫特尔克西！他是水妖王国的王子！我们今天就会夺回他的王冠，为他加冕！"
        },
        {
          "role": "贾拉康",
          "text": "夫人…请放心，什么事都不会耽误的，你的朋友们已经出发了…等等…看！他们回来了。"
        },
        {
          "role": "派蒙",
          "text": "祖莉亚夫人，祖莉亚夫人！我们把王冠夺回来啦！"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "派蒙…你们…这是真的吗？"
        },
        {
          "role": "菲米尼",
          "text": "是的，但王子的加冕仪式还没有完成，我们觉得这件事要由夫人您来主持…"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "太好了，太好了！特尔克西…孩子啊…我的孩子…你听见了吗？你的一切都要回来了，你马上就可以不再孤独了…"
        },
        {
          "role": "「特尔克西」",
          "text": "-.- ..-. ..- -... .--- -. ..-. -. -... -. -... ---{{黑幕|je t'aime maman（法语，妈妈我爱你）}}"
        },
        {
          "role": "菲米尼",
          "text": "还有绘本的终页，夫人，这也是您要完成的事。"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "对，绘本，还有绘本…可我不知道终页的故事要画什么…"
        },
        {
          "role": "派蒙",
          "text": "特尔克西和我们都知道哦，夫人快准备一下，我们来念，你来画，这样就可以啦！"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "好…好！"
        },
        {
          "role": "派蒙",
          "text": "咳咳…终于，「特尔克西」与勇者伙伴们齐心协力，帅气地追击了残余的魔物，潇洒地取得了胜利，完美地将王冠夺了回来。"
        },
        {
          "role": "菲米尼",
          "text": "重获家园的水妖们欢呼着迎接王子，他们再次取出珍贵的贝壳，搭起了曾经的彩虹桥，王子看着这一切，心想：哦，这真美啊。"
        },
        {
          "role": "派蒙",
          "text": "王子感动地走上了彩虹桥，看着一路走来的伙伴，有旅行者，派蒙女神，菲米尼，还有…"
        },
        {
          "role": "派蒙",
          "text": "咦？还有一个人呢？王子四处张望，却没有找到她。这时，那个人突然出现在了桥的另一头，她微笑着走过来，揭开了面罩。"
        },
        {
          "role": "菲米尼",
          "text": "王子的泪水一下就夺眶而出，因为他认出来，这个一直陪伴他的神秘人，就是他的母亲。"
        },
        {
          "role": "[[file",
          "text": "活动任务-王子的冠冕-绘本.png|center|600px]]"
        },
        {
          "role": "菲米尼",
          "text": "祖莉亚夫人走过来，将王冠戴在了王子的头上，并微笑着对他说，我的孩子，我的国王，你永远都不必再感到孤独了。"
        },
        {
          "role": "派蒙",
          "text": "祖莉亚夫人，这就是最后的故事了。"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "谢谢…谢谢你们…"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "我的孩子，妈妈要跟你说对不起，妈妈应该多陪陪你…你听见了吗，你终于可以不再孤独了…"
        },
        {
          "role": "「特尔克西」",
          "text": "-.- ..-. ..- -... .--- -. ..-. -. -... -. -... ---"
        },
        {
          "role": "「特尔克西」",
          "text": "-.- ..-. ..- -... .--- -. ..-. -. -... -. -... ---"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "嗯！妈妈也是！"
        },
        {
          "type": "subtitle",
          "text": "祖莉亚夫人留下了泪水…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "怎…怎么回事？祖莉亚夫人在和「特尔克西」交流吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「特尔克西」在说什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲米尼",
          "text": "旅行者，快戴上我的潜水头盔，里面匹配了「特尔克西」信号码的转译模块，这样你应该就能理解「特尔克西」的话。"
        },
        {
          "type": "subtitle",
          "text": "菲米尼靠过来，拿出他的潜水头盔，戴在了你的脑袋上。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「特尔克西」",
          "text": "-.- ..-. ..- -... .--- -. ..-. -. -... -. -... ---"
        },
        {
          "role": "「特尔克西」",
          "text": "-.- ..-. ..- -... .--- -. ..-. -. -... -. -... ---"
        },
        {
          "role": "「特尔克西」",
          "text": "我爱你，妈妈！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来这就是「特尔克西」说的话。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "妈妈…妈妈也爱你…"
        },
        {
          "role": "莱斯科·德斯特雷",
          "text": "我更爱你，妈妈！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等等，这是什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲米尼",
          "text": "怎么了？你看到了什么？"
        },
        {
          "role": "莱斯科·德斯特雷",
          "text": "妈妈，我有点困了，到了睡觉的时间了，妈妈能再给我哼一首摇篮曲吗？"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "好孩子…当然了，只要你想听，妈妈会永远哼给你听。"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "♪♫♪~"
        },
        {
          "role": "莱斯科·德斯特雷",
          "text": "谢谢妈妈，最喜欢妈妈的摇篮曲了，这样我就能安心回去梦里，回去水妖王国了。"
        },
        {
          "role": "祖莉亚·德斯特雷",
          "text": "傻孩子，一定不要忘记，妈妈永远爱你，就像…就像从这里到水妖王国那么多。"
        },
        {
          "role": "莱斯科·德斯特雷",
          "text": "我不会忘的，妈妈也要记住哦，我爱妈妈，就像从这里到水妖王国再回来那么多！"
        },
        {
          "role": "莱斯科·德斯特雷",
          "text": "妈妈，晚安！"
        },
        {
          "role": "[[File",
          "text": "活动任务-奇迹的冠冕-cg.png|1100px|center]]"
        },
        {
          "type": "subtitle",
          "text": "前往菲米尼的营地"
        },
        {
          "type": "subtitle",
          "text": "三天之后，菲米尼的营地…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "菲米尼",
          "text": "旅行者，派蒙，你们来了…"
        },
        {
          "role": "派蒙",
          "text": "菲米尼！这么急着找我们，是不是有祖莉亚夫人的消息啦？不是好消息我不听！"
        },
        {
          "role": "菲米尼",
          "text": "放心，是很好的消息。刚才在医生的陪同下，夫人来了一趟，她看起来气色很不错，人也很有精神。"
        },
        {
          "role": "菲米尼",
          "text": "她说她打算回城把画展继续办完，但这次她会和医生合作，展出一些跟孤独病相关的绘本。"
        },
        {
          "role": "菲米尼",
          "text": "当然也包括《特尔克西的奇幻历险》和引导幻想的疗法，她想用自己的经历帮助更多人。"
        },
        {
          "role": "派蒙",
          "text": "太好了，真是货真价实的好消息！"
        },
        {
          "role": "菲米尼",
          "text": "嗯，还有这绘本请收下吧，是夫人留给你们的，以防万一，万一以后谁遇上了同样的问题，她希望这个能陪你们共渡难关。"
        },
        {
          "role": "派蒙",
          "text": "欸？可这是她孩子的故事，送给我们没关系吗？"
        },
        {
          "role": "菲米尼",
          "text": "是复画本啦，原本还在祖莉亚夫人那里，这对她意义重大。"
        },
        {
          "role": "派蒙",
          "text": "那就好，嘿嘿，感觉这份意义里也有我们的努力呢，没想到这一次的幻想历险真的有用，我之前还在担心，幻想毕竟只是幻想。"
        },
        {
          "role": "菲米尼",
          "text": "派蒙，你知道夫人是怎么说的吗？"
        },
        {
          "role": "菲米尼",
          "text": "夫人说，在她给特尔克西戴上王冠的时刻，她似乎真的看见了很美好的事情——她的孩子回来了，对她说，他爱她。"
        },
        {
          "role": "菲米尼",
          "text": "夫人还说，就是那个时刻，让她完成了和孩子的道别，也让她感觉自己被什么治愈了，身体一下就充满了勇气。"
        },
        {
          "role": "派蒙",
          "text": "欸？！真的吗？可那应该也只是夫人的一部分幻想吧？"
        },
        {
          "role": "菲米尼",
          "text": "但是，如果说幻想只是幻想，幻想的世界是虚假的，为什么它又能给人带来这种真实的力量呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以，也许幻想不仅仅是幻想。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那…那还能是什么呢？"
        },
        {
          "role": "菲米尼",
          "text": "是童话世界的真实降临，在那个时刻，美好的童话短暂地成为了现实，影响了现实，一定是这样…"
        },
        {
          "role": "菲米尼",
          "text": "旅行者，你也看到了这个吧？"
        },
        {
          "role": "派蒙",
          "text": "怎么可能啦？这个答案完全没戏。如果是这样，那不就成奇迹了吗？"
        },
        {
          "role": "菲米尼",
          "text": "是啊…那就是奇迹吧。"
        },
        {
          "type": "subtitle",
          "text": "一道彩虹出现在天边…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "菲米尼",
          "text": "我希望所有身处困境的人们，都能看到美好的东西，都能看到奇迹。"
        }
