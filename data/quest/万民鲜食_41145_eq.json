{
  "quest_id": 41145,
  "chapter_num": null,
  "chapter_title": "万民鲜食",
  "type": "eq",
  "route": "Wanmin Fresh",
  "stories": [
    {
      "story_id": 41145,
      "title": "万民鲜食",
      "description": "璃月港的万民堂里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "卯师傅",
          "text": "好吧，那我去找别人帮忙…"
        },
        {
          "role": "旅行者",
          "text": "我现在就送过去。"
        },
        {
          "role": "卯师傅",
          "text": "那就拜托你了，尽快送过去吧。"
        },
        {
          "role": "卯师傅",
          "text": "送的时候记得小心点，这道菜有点精细，要是跑快了或者摔着了，说不定就会把菜给弄散。"
        },
        {
          "role": "卯师傅",
          "text": "要是弄散了，只怕客人不会收下这道菜的。"
        },
        {
          "role": "寡言的廷方",
          "text": "呼…还没送来…"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "卯师傅",
          "text": "啊…对，是有一份，一个叫廷方的客人在我这点了一份翡玉什锦袋。"
        },
        {
          "role": "卯师傅",
          "text": "他付钱倒是爽快，说要我稍晚一会送到孤云阁附近的一个地方…"
        },
        {
          "role": "卯师傅",
          "text": "但我现在得看着店，能拜托你帮我把这份餐送过去吗？"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "寡言的廷方",
          "text": "总算来了。"
        },
        {
          "role": "寡言的廷方",
          "text": "……"
        },
        {
          "role": "寡言的廷方",
          "text": "多谢。"
        }
      ]
    }
  ]
}