  "chapter_title": "月光奏鸣曲·遐音",
  "type": "wq",
  "route": "Moonlight Sonata: Lingering Resonance",
  "stories": [
    {
      "story_id": 76049,
      "title": "月光奏鸣曲·遐音",
      "description": "在「银月之庭」，「少女」似乎在和月灵玩耍…",
      "dialogues": [
        {
          "role": "「少女」",
          "text": "…好像调子高了一些，再试试？"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅！你好呀。"
        },
        {
          "role": "派蒙",
          "text": "咦？你今天是在…教月灵弹琴吗？"
        },
        {
          "role": "「少女」",
          "text": "嗯，之前修好琴后，月灵们很开心，每天都缠着我。"
        },
        {
          "role": "「少女」",
          "text": "但我其实不是很会弹琴，之前都是听别人弹。"
        },
        {
          "role": "派蒙",
          "text": "唔，可以理解，感觉如果组乐队的话，哥伦比娅是专门负责唱歌的角色呢。"
        },
        {
          "role": "派蒙",
          "text": "不过，说到乐器，这家伙可是特别擅长呢！从蒙德的「诗琴」到纳塔的「聚聚鼓」，他都十分精通呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "一般般，一般般…",
            "略熟，略熟…"
          ]
        },
        {
          "role": "「少女」",
          "text": "是吗？那…不如你来教它们弹？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那就露一手…",
            "弹什么好呢…"
          ]
        },
        {
          "role": "「少女」",
          "text": "月灵们最近都在练习我平时唱的那首歌，你记得旋律吧？"
        },
        {
          "role": "「少女」",
          "text": "或者…弹些你拿手的旋律也行。月灵们很少听到其他国家的音乐，我也想听。"
        },
        {
          "role": "旅行者",
          "text": "（弹什么好呢…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "演奏哥伦比娅常哼的歌…",
            "演奏他国的音乐…"
          ]
        },
        {
          "role": "旅行者",
          "text": "（以什么样的情绪演奏呢…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "平和的乐调…",
            "愉快的乐调…"
          ]
        },
        {
          "role": "「少女」",
          "text": "好听。我平时哼的旋律，原来你都记下来了。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，因为你唱歌很好听嘛，我们有时会悄悄在旁边听上一会儿。"
        },
        {
          "role": "「少女」",
          "text": "月灵们也听得入迷了。不知道它们有没有学会。"
        },
        {
          "role": "「少女」",
          "text": "说不定，以后还得多请你们教几次。"
        },
        {
          "role": "「少女」",
          "text": "来吧，把手给我。"
        },
        {
          "role": "派蒙",
          "text": "欸？我们这是无偿演出，不用收学费的！"
        },
        {
          "role": "「少女」",
          "text": "嗯？学费？"
        },
        {
          "role": "「少女」",
          "text": "我只是觉得，好听的旋律，应该有美丽的月光相伴。"
        },
        {
          "role": "旅行者",
          "text": "平和的乐调…"
        },
        {
          "role": "「少女」",
          "text": "好听。我平时哼的旋律，原来你都记下来了。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，因为你唱歌很好听嘛，我们有时会悄悄在旁边听上一会儿。"
        },
        {
          "role": "「少女」",
          "text": "月灵们也听得入迷了。不知道它们有没有学会。"
        },
        {
          "role": "「少女」",
          "text": "说不定，以后还得多请你们教几次。"
        },
        {
          "role": "「少女」",
          "text": "来吧，把手给我。"
        },
        {
          "role": "派蒙",
          "text": "欸？我们这是无偿演出，不用收学费的！"
        },
        {
          "role": "「少女」",
          "text": "嗯？学费？"
        },
        {
          "role": "「少女」",
          "text": "我只是觉得，好听的旋律，应该有美丽的月光相伴。"
        },
        {
          "role": "旅行者",
          "text": "愉快的乐调…"
        },
        {
          "role": "「少女」",
          "text": "结束了？感觉都还没听够…"
        },
        {
          "role": "「少女」",
          "text": "我曾说过这是我唯一记得的「摇篮曲」。"
        },
        {
          "role": "「少女」",
          "text": "尽管还没找到其中的意义，但听你弹过之后，我开始觉得在月亮上等待着我的那个答案，至少是美好的。"
        },
        {
          "role": "「少女」",
          "text": "来，把手给我。"
        },
        {
          "role": "派蒙",
          "text": "这次就不用回报啦。"
        },
        {
          "role": "「少女」",
          "text": "不，我只是想为这旋律添上一束美好的月光。"
        },
        {
          "role": "旅行者",
          "text": "演奏他国的音乐…"
        },
        {
          "role": "「少女」",
          "text": "奇妙的感觉。以前偶尔也听过类似的旋律，但听你弹的感受很不一样。"
        },
        {
          "role": "派蒙",
          "text": "可能其中包含了他对那个国家的感情吧。"
        },
        {
          "role": "「少女」",
          "text": "奇妙的是，我能够从乐调中想象出风景…不知道现实和我的想象会有多少区别呢…"
        },
        {
          "role": "派蒙",
          "text": "想看还不简单？到时候就让我们来当你的导游吧！"
        },
        {
          "role": "「少女」",
          "text": "嗯…如果能有那么一天的话。"
        }
      ]
    }
  ]
