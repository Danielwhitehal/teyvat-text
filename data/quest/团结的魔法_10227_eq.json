{
  "quest_id": 10227,
  "chapter_num": "荣花竞捷之争 第三幕",
  "chapter_title": "团结的魔法",
  "type": "eq",
  "route": "Spell of Unity",
  "stories": [
    {
      "story_id": 40179,
      "title": "团结的魔法",
      "description": "在得知了上一次荣花演武的惨淡收场，以及小绒翼龙安杜的事情后，众人决定为它做些什么。为此还需要其他伙伴们的配合…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后"
        },
        {
          "type": "subtitle",
          "text": "到「话事处」商量计划"
        },
        {
          "role": "玛拉妮",
          "text": "呼啊——好困！"
        },
        {
          "role": "基尼奇",
          "text": "没睡好？"
        },
        {
          "role": "玛拉妮",
          "text": "是呀！都怪卡齐娜神神秘秘地说要召集大家商量事情，我好奇了一晚上，翻来覆去都睡不着。"
        },
        {
          "role": "玛拉妮",
          "text": "今天怎么这么安静，你把阿乔关起来了？"
        },
        {
          "role": "基尼奇",
          "text": "早上我喊它起床，它说「退下，勿扰伟大圣龙清梦」。我也觉得它不在场更好，就懒得再叫它了。"
        },
        {
          "role": "玛拉妮",
          "text": "哈哈，幸好你没告诉它今天有聚会，不然它肯定要来凑热闹。"
        },
        {
          "role": "伊安珊",
          "text": "我迟到了？"
        },
        {
          "role": "茜特菈莉",
          "text": "来得正好。人齐了伊法，可以开始了吧？"
        },
        {
          "role": "伊法",
          "text": "咳…其实今天，我们有件事想拜托大家。"
        },
        {
          "role": "希诺宁",
          "text": "怎么了？突然这么严肃。"
        },
        {
          "role": "伊法",
          "text": "说来话长，这得从米莱的一位「神秘朋友」讲起…"
        },
        {
          "type": "subtitle",
          "text": "向众人讲述了数百年前的荣花演武，以及小绒翼龙安杜的故事。",
          "narration": true,
          "color": "介绍"
        },
        {
          "type": "subtitle",
          "text": "听完之后，众人的情绪都有些低落。",
          "narration": true,
          "color": "介绍"
        },
        {
          "role": "伊安珊",
          "text": "部族之间的流血冲突…对我们来说是个很陌生的词，在那个年代的纳塔却是日常发生的事情啊。"
        },
        {
          "role": "瓦雷莎",
          "text": "连「各部族共同做一件事」都是一种奢望…未免也太残酷了。"
        },
        {
          "role": "恰斯卡",
          "text": "「争斗」一直都有，但升级到部族之间，恐怕已经是无法调停的矛盾了。"
        },
        {
          "role": "欧洛伦",
          "text": "而那只名叫安杜的小绒翼龙认为圣火结晶有着某种邪恶力量，导致了部族之间的争执。"
        },
        {
          "role": "欧洛伦",
          "text": "这才有了后来的种种误会。事到如今，也很难向它解释真相…奶奶说的对，真相只会再次让它陷入痛苦。"
        },
        {
          "role": "玛薇卡",
          "text": "话虽如此，等到我们收集了足够的圣火结晶，为米莱治疗的时候，安杜自然会察觉到异样吧？"
        },
        {
          "role": "玛薇卡",
          "text": "它会发现没有人被蛊惑，一切都很正常。就算是小龙，看到这里也会想明白过去的真相。"
        },
        {
          "role": "伊法",
          "text": "是的。所以我们想到了一个计划。"
        },
        {
          "role": "伊法",
          "text": "等到下半场比赛打完后，我们会拿到足够的圣火结晶。这时候，我希望大家假装被圣火结晶蛊惑，摆出一副争吵的态度。"
        },
        {
          "role": "玛拉妮",
          "text": "哦，演戏！听起来很好玩，然后呢？"
        },
        {
          "role": "伊法",
          "text": "然后，我们会带着安杜赶来，施放「团结的魔法」，破除圣火结晶中的「邪恶力量」，让大家恢复清醒。"
        },
        {
          "role": "伊法",
          "text": "当然，无论是魔法还是邪恶力量都是假的，只是为了让它相信自己做了一件「了不起的事」。"
        },
        {
          "role": "希诺宁",
          "text": "懂你意思了。"
        },
        {
          "role": "希诺宁",
          "text": "弥补遗憾的最好方式，就是做到过去自己做不到的事。我们来重现过去的「那一幕」，但这次它可以亲手改变未来。"
        },
        {
          "role": "希诺宁",
          "text": "具体要怎么实施呢？有什么参考吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "我曾经在他国的书籍中见到过一种「互动舞台剧」，是专门为小孩子设计的。"
        },
        {
          "role": "茜特菈莉",
          "text": "剧本里一般都是英雄与坏蛋的对决，过程也是波澜起伏。在最后，舞台上的英雄会假意不敌，寻求孩子们的帮助。"
        },
        {
          "role": "茜特菈莉",
          "text": "于是孩子们高举双手，将自己的「力量」借给英雄，帮助他战胜坏人。"
        },
        {
          "role": "茜特菈莉",
          "text": "对于台下的成年人来说这只是一场表演，但孩子们却会因此高兴许多天。"
        },
        {
          "role": "茜特菈莉",
          "text": "在那个年纪，快乐不源于实质的奖赏，而是出自「相信的心」。"
        },
        {
          "role": "玛拉妮",
          "text": "确实，我也深有体会。"
        },
        {
          "role": "玛拉妮",
          "text": "小时候我去爸爸妈妈的店里帮忙，他们总是会故意留一些简单的工作给我。比如擦干净柜子上的灰，或是把商品摆放整齐。"
        },
        {
          "role": "玛拉妮",
          "text": "然后在我做好之后，他们就会大力夸赞我「做得好玛拉妮，你简直就是天才！」…然后我就会变得超级开心。"
        },
        {
          "role": "伊法",
          "text": "就是这个意思。让它像帮到英雄的孩子一样开心，让它在离开前能够少一点遗憾和痛苦…这就是我们的目的。"
        },
        {
          "role": "伊法",
          "text": "除此之外，米莱已经从安杜那里听说了圣火结晶的传闻，不当着它的面破除魔咒，我担心它会抗拒服药。"
        },
        {
          "role": "伊法",
          "text": "为了演好这出戏，只有我们几个人是不够的，所以我想向大家寻求帮助。"
        },
        {
          "role": "茜特菈莉",
          "text": "大概还需要五个人才行…咳，五个名额，先到先得。"
        },
        {
          "role": "玛拉妮",
          "text": "我要报名！哼哼，我们当中最擅长吵架的应该就是我吧？"
        },
        {
          "role": "玛拉妮",
          "text": "店里有时会来一些无礼的客人。为了跟他们沟通，我可是磨练出了不少技巧。"
        },
        {
          "role": "欧洛伦",
          "text": "我也参加。我可以帮忙准备一些道具，比如伪装「邪恶力量」用的烟雾，还有「团结魔法」发出的光亮。"
        },
        {
          "role": "玛薇卡",
          "text": "也带上我吧。"
        },
        {
          "role": "玛拉妮",
          "text": "咦，火神大人也来？"
        },
        {
          "role": "玛薇卡",
          "text": "刚刚茜特菈莉提到了英雄与坏蛋的对决，我很有感触。"
        },
        {
          "role": "玛薇卡",
          "text": "和舞台剧中的英雄不同，我曾经真切地从各位这里借用了力量，共同战胜了强大的敌人。我应该能演好这个角色，对吧？"
        },
        {
          "role": "希诺宁",
          "text": "玛薇卡参加的话，算我一个。我对「假装争吵」这个步骤很感兴趣。"
        },
        {
          "role": "伊法",
          "text": "我想想。演员和布场都有了，还缺一位…「导演」？或者说协调各方的「指挥」。"
        },
        {
          "role": "基尼奇",
          "text": "看我做什么？"
        },
        {
          "role": "玛拉妮",
          "text": "这是大家对你的信任哦。"
        },
        {
          "role": "基尼奇",
          "text": "好吧，正好我最近有空。"
        },
        {
          "role": "恰斯卡",
          "text": "人齐了？那我和瓦雷莎负责荣花演武的收尾工作。"
        },
        {
          "role": "瓦雷莎",
          "text": "抱歉大家，虽然很想报名，但我已经答应要帮忙运送伤员了。"
        },
        {
          "role": "恰斯卡",
          "text": "至于我——唉，要是看到你们吵架，我怕自己会忍不住先开始调停。"
        },
        {
          "role": "伊安珊",
          "text": "我是真的不会演戏，要多生硬有多生硬，太容易被看出来了。"
        },
        {
          "role": "伊安珊",
          "text": "我留下来接应寻找海风草的龙吧。如果它们带回了足够的海风草，我可以第一时间去和你们会合。"
        },
        {
          "role": "伊安珊",
          "text": "这就是火神大人常说的，呃…「各司其职」？"
        },
        {
          "role": "玛薇卡",
          "text": "是啊。先打完表演赛的下半场，然后我们兵分两路，各司其职。"
        },
        {
          "role": "玛拉妮",
          "text": "好！下半场我们一定要打得更热烈，收集到更多的圣火结晶，治好小米莱的病。"
        },
        {
          "role": "玛拉妮",
          "text": "我还准备了「秘密战术」呢，到时候肯定会吓你们一跳。"
        },
        {
          "role": "玛薇卡",
          "text": "时隔数百年，我们重新举办了荣花演武。这一次，我希望它能不留遗憾地结束。"
        },
        {
          "role": "玛薇卡",
          "text": "有信心吗，各位？"
        },
        {
          "role": "伊安珊",
          "text": "有！"
        },
        {
          "role": "玛薇卡",
          "text": "出发！"
        },
        {
          "role": "派蒙",
          "text": "好，人都到齐了，我们来开作战会议吧！"
        },
        {
          "role": "派蒙",
          "text": "呃，今天的战场，又有很多高山要爬呢…"
        },
        {
          "role": "旅行者",
          "text": "派蒙明明是用飞的。"
        },
        {
          "role": "恰斯卡",
          "text": "嫌累的话，要直接飞到山上吗？"
        },
        {
          "role": "恰斯卡",
          "text": "奇袭对方的营地，倒也是一种战术。"
        },
        {
          "role": "欧洛伦",
          "text": "我用烟雾制造混乱，然后你们冲进去一顿猛打。"
        },
        {
          "role": "恰斯卡",
          "text": "用最快速度结束争斗。"
        },
        {
          "role": "派蒙",
          "text": "咳咳，这两人看起来比我还心急…"
        },
        {
          "role": "伊安珊",
          "text": "冷静点，我们还不清楚对方的布阵情况。而且不先把附近的对手打败的话，我们的大本营也会有危险。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "还是稳扎稳打吧。",
            "先从山脚的营地开始。"
          ]
        },
        {
          "role": "派蒙",
          "text": "不过，这附近布满了岩石…看起来是要阻碍我们前进呢。"
        },
        {
          "role": "伊安珊",
          "text": "没问题，这种程度的话，只要猛冲过去就好了。"
        },
        {
          "role": "伊安珊",
          "text": "来吧，要开始热身环节了！"
        },
        {
          "type": "subtitle",
          "text": "进攻「回声之子」营地"
        },
        {
          "role": "卡齐娜",
          "text": "我，我会在这里拦住你们的！"
        },
        {
          "type": "subtitle",
          "text": "击败营地守卫并更换旗帜"
        },
        {
          "role": "伊安珊",
          "text": "好，这样就拿下回声之子的营地了。接下来要往山上进发了。"
        },
        {
          "role": "茜特菈莉",
          "text": "打累了没？我来帮帮你们吧。"
        },
        {
          "role": "派蒙",
          "text": "奶奶来了！哇，这可真是强力帮手！"
        },
        {
          "role": "欧洛伦",
          "text": "呃，奶奶…她该不是来看我有没有偷懒的吧…"
        },
        {
          "type": "subtitle",
          "text": "进攻「流泉之众」营地"
        },
        {
          "type": "subtitle",
          "text": "击败营地守卫并更换旗帜"
        },
        {
          "role": "欧洛伦",
          "text": "好，又赢下一局。"
        },
        {
          "role": "伊安珊",
          "text": "不太对劲…他们的营地，人数比预想中少了许多。"
        },
        {
          "role": "恰斯卡",
          "text": "而且，刚才也没看到玛拉妮出现…"
        },
        {
          "role": "萨诺菈",
          "text": "不，不好了！刚才打下来的营地，被流泉之众的人给夺回去了。"
        },
        {
          "role": "萨诺菈",
          "text": "而且，他们正在派兵往我们的大本营进攻…"
        },
        {
          "role": "茜特菈莉",
          "text": "哦？玛拉妮那小丫头，还挺有两下子的嘛。"
        },
        {
          "role": "伊安珊",
          "text": "看来必须得兵分两路，阻止他们的反攻了。"
        },
        {
          "role": "茜特菈莉",
          "text": "行了，就让我去会会玛拉妮吧，上次她弄坏我家大门的账还没算呢。你们继续前进就好。"
        },
        {
          "role": "伊安珊",
          "text": "真是帮大忙了。有茜特菈莉奶奶在，我们就不用担心后方安全了。"
        },
        {
          "role": "欧洛伦",
          "text": "嗯，谢谢奶奶。我们会赢下来的。"
        },
        {
          "type": "subtitle",
          "text": "进攻「悬木人」营地"
        },
        {
          "role": "基尼奇",
          "text": "果然还是拦不住你们啊。那就痛快地打一场吧。"
        },
        {
          "type": "subtitle",
          "text": "击败营地守卫并更换旗帜"
        },
        {
          "role": "欧洛伦",
          "text": "胜利的果实，尝起来真不错…嗯，这样就不会挨奶奶的骂了。"
        },
        {
          "role": "派蒙",
          "text": "欧洛伦今天这么有干劲，原来是因为这个吗…"
        },
        {
          "role": "茜特菈莉",
          "text": "你这孩子，怎么说得我好像很凶一样…奶奶什么时候随便骂人了？"
        },
        {
          "role": "欧洛伦",
          "text": "……"
        },
        {
          "role": "伊安珊",
          "text": "咳咳，总之，今天算是好好地锻炼了一番呢。"
        },
        {
          "role": "恰斯卡",
          "text": "嗯，能尽情地享受争斗的乐趣，很难得。"
        },
        {
          "role": "茜特菈莉",
          "text": "到底还是年轻人啊，有架可打就兴奋得不行。"
        },
        {
          "role": "茜特菈莉",
          "text": "等事情结束，奶奶我可要在家里躺上个三五天…"
        },
        {
          "role": "欧洛伦",
          "text": "奶奶辛苦了。还好有奶奶的支援。"
        },
        {
          "role": "茜特菈莉",
          "text": "哼，刚才打起来的时候，玛拉妮那小丫头真是不留情面。"
        },
        {
          "role": "茜特菈莉",
          "text": "等她下次来家里求我办事，我可要跟她好好说道说道…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，说明大家都打得很卖力嘛。"
        },
        {
          "role": "派蒙",
          "text": "这回应该能收集到足够的圣火结晶了吧？"
        },
        {
          "role": "茜特菈莉",
          "text": "足够了。带上圣火结晶，我们回去吧。"
        },
        {
          "role": "茜特菈莉",
          "text": "接下来，就是「舞台剧」的时间了。"
        },
        {
          "role": "茜特菈莉",
          "text": "伊法，你看下这个数量应该够用了吧？"
        },
        {
          "role": "伊法",
          "text": "足够了，甚至用不完。"
        },
        {
          "role": "玛薇卡",
          "text": "好事，说明大家的比赛热情都很高涨。剩余的部分可以储存起来，以备不时之需。"
        },
        {
          "role": "玛薇卡",
          "text": "接下来才是重头戏，什么时候开始？"
        },
        {
          "role": "伊法",
          "text": "稍等。在开始之前，我再重复一遍计划的几个阶段。"
        },
        {
          "role": "伊法",
          "text": "等下你们带着圣火结晶，把它放到米莱和尼娅的面前。之后基尼奇会给出信号，欧洛伦控制圣火结晶散发黑雾。"
        },
        {
          "role": "伊法",
          "text": "大家自然而然地陷入争吵。吵得最凶的时候，我们会带着安杜出现，并让安杜释放「团结的魔法」。"
        },
        {
          "role": "伊法",
          "text": "那之后，欧洛伦控制黑雾消散，大家也重归于好。没问题吗？"
        },
        {
          "role": "希诺宁",
          "text": "放心，我在心里演练过许多次了。"
        },
        {
          "role": "伊法",
          "text": "那我们——开始。"
        },
        {
          "role": "玛拉妮",
          "text": "呼，总算收集到足够的圣火结晶了。放心吧，马上你就能康复了。"
        },
        {
          "role": "米莱",
          "text": "呜…"
        },
        {
          "role": "米莱",
          "text": "呜呜！"
        },
        {
          "role": "茜特菈莉",
          "text": "果然，就像伊法说的一样，它看上去很抗拒。"
        },
        {
          "role": "尼娅",
          "text": "呜…"
        },
        {
          "role": "希诺宁",
          "text": "只要当着它的面「破除」诅咒就可以了，继续吧。"
        },
        {
          "role": "卡齐娜",
          "text": "哎呀！玛拉妮，好奇怪呀，我感觉头有点晕晕的…"
        },
        {
          "role": "基尼奇",
          "text": "（氛围组就位。）"
        },
        {
          "role": "欧洛伦",
          "text": "（交给我就好。）"
        },
        {
          "role": "基尼奇",
          "text": "到吵架环节了。按照之前商议的，我们这边从玛拉妮开始。"
        },
        {
          "role": "卡齐娜",
          "text": "拜托了，玛拉妮…！"
        },
        {
          "role": "玛拉妮",
          "text": "交给我吧！"
        },
        {
          "role": "玛拉妮",
          "text": "咳咳。听好了，卡齐娜——"
        },
        {
          "role": "玛拉妮",
          "text": "呃…我、我要狠狠地训斥你！你居然做了这么出人意料的大坏事，我真的生气了！"
        },
        {
          "role": "卡齐娜",
          "text": "咦！我做什么了？"
        },
        {
          "role": "玛拉妮",
          "text": "对哦。这个嘛…让我想想…"
        },
        {
          "role": "基尼奇",
          "text": "你不是夸下海口，说自己「很会吵架」吗？"
        },
        {
          "role": "玛拉妮",
          "text": "当然啦，但是现在我想不到吵架的理由呀！就算让我发挥以前的天赋，脑子也是一片空白…"
        },
        {
          "role": "米莱",
          "text": "呜？"
        },
        {
          "role": "茜特菈莉",
          "text": "不行，再这样拖下去，连小龙都能看出有问题了。"
        },
        {
          "role": "茜特菈莉",
          "text": "别在意吵什么，先把氛围塑造起来再说！"
        },
        {
          "role": "玛拉妮",
          "text": "别急，我正在开动脑筋…对了！卡齐娜！"
        },
        {
          "role": "玛拉妮",
          "text": "我要谴责你，把最后一片龙龙饼干吃掉了！"
        },
        {
          "role": "卡齐娜",
          "text": "欸？"
        },
        {
          "role": "玛拉妮",
          "text": "昨天晚上我们一起野餐的时候！我本来想留到最后享用的那枚龙龙饼干，被你吃掉了！"
        },
        {
          "role": "卡齐娜",
          "text": "对不起…！不对，明明是你吃得比较多…！"
        },
        {
          "role": "玛拉妮",
          "text": "中间吃的不算！不管有多少块饼干，永远都是最后一块更好吃！"
        },
        {
          "role": "米莱",
          "text": "呜…"
        },
        {
          "role": "基尼奇",
          "text": "很好，它开始相信了。再加把火。"
        },
        {
          "role": "茜特菈莉",
          "text": "玛拉妮，弄坏我家门的赔偿该给了吧？"
        },
        {
          "role": "玛拉妮",
          "text": "现在提这个？！上次吃饭的时候不是答应给我免了吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "什么时候？"
        },
        {
          "role": "玛拉妮",
          "text": "就是上次啊！在流泉之众那次，你喝多了，拉着我的手说以前的事情一笔勾销！"
        },
        {
          "role": "玛拉妮",
          "text": "等下，你真的不记得了？不是在表演？我当时好不容易…"
        },
        {
          "role": "米莱",
          "text": "呜！"
        },
        {
          "role": "玛薇卡",
          "text": "这就是圣火结晶的力量吗？大家都变了一副样子。"
        },
        {
          "role": "玛薇卡",
          "text": "事到如今，只能靠我的力量——"
        },
        {
          "role": "希诺宁",
          "text": "呼…玛薇卡！你知道我忍你多久了吗？"
        },
        {
          "role": "希诺宁",
          "text": "自顾自地把不知道从哪搞来的设计图纸扔到我的工坊，让我给你做那个什么驰轮车！"
        },
        {
          "role": "希诺宁",
          "text": "每天开着它去野外狂奔，坏了就送到我这里来修。完全不管我是不是在放假——"
        },
        {
          "role": "希诺宁",
          "text": "还有特制的墨镜、不会被火焰熔化的宝剑…需要我帮你一件一件回忆吗？"
        },
        {
          "role": "玛薇卡",
          "text": "唔…"
        },
        {
          "role": "卡齐娜",
          "text": "总觉得希诺宁姐姐演得格外真实。"
        },
        {
          "role": "基尼奇",
          "text": "可能只有她没有在表演吧。"
        },
        {
          "role": "阿乔",
          "text": "呼啊…困死我了，基尼奇，早上你怎么不叫我？"
        },
        {
          "role": "希诺宁",
          "text": "总之，以后我假期的时候不接工作，也不允许你去度假的地方堵我。"
        },
        {
          "role": "茜特菈莉",
          "text": "不对，我记起来了，那天是你给我灌的酒！"
        },
        {
          "role": "茜特菈莉",
          "text": "想趁我喝醉把以前欠的债一笔勾销？好呀玛拉妮，知道用这招对付奶奶我了？"
        },
        {
          "role": "阿乔",
          "text": "我的天哪！怎么回事，这帮小鬼突然内讧了？这可是我的大好机会——"
        },
        {
          "role": "阿乔",
          "text": "大家听我说，吵架不能解决问题。所以赶紧动手吧，由我伟大圣龙库胡勒阿乔来当裁判！"
        },
        {
          "role": "阿乔",
          "text": "从基尼奇开始，想揍基尼奇的过来！"
        },
        {
          "role": "茜特菈莉",
          "text": "……"
        },
        {
          "role": "阿乔",
          "text": "怎、怎么了？看我干什么？"
        },
        {
          "role": "希诺宁",
          "text": "真是挑了个好时候来。"
        },
        {
          "role": "玛拉妮",
          "text": "就是你用冰桶泡澡，害得一整桶冰块都没法用！"
        },
        {
          "role": "卡齐娜",
          "text": "把我烤好的饼干都吃光了！我准备了整整一个晚上…"
        },
        {
          "role": "茜特菈莉",
          "text": "总是大嗓门说话，吵得我耳朵疼。"
        },
        {
          "role": "基尼奇",
          "text": "我就不必列举了吧？这家伙做的坏事数都数不清。"
        },
        {
          "role": "阿乔",
          "text": "停停，怎么突然冲我来了？"
        },
        {
          "role": "尼娅",
          "text": "呜…"
        },
        {
          "role": "玛薇卡",
          "text": "怎么会这样，争吵愈发激烈，只靠我已经无法净化圣火结晶中的邪恶力量。"
        },
        {
          "role": "玛薇卡",
          "text": "再这样下去…再这样下去…呃…"
        },
        {
          "role": "玛薇卡",
          "text": "我看看…哦对。「再这样下去，纳塔会陷入危险。」"
        },
        {
          "role": "玛薇卡",
          "text": "「只差一点了。如果有人能挺身而出…」"
        },
        {
          "role": "玛薇卡",
          "text": "（幸好提前把要说的话记录了下来，这样应该就可以了吧。）"
        },
        {
          "role": "伊法",
          "text": "到我们上了。准备好了吗，安杜？"
        },
        {
          "role": "伊法",
          "text": "…安杜？"
        },
        {
          "role": "安杜",
          "text": "……"
        },
        {
          "role": "伊马雷",
          "text": "没有救它的必要了。留着圣火结晶，我们能做更多的事。"
        },
        {
          "role": "尚贾",
          "text": "那好啊！今天索性就把账全部都算清楚好了！"
        },
        {
          "role": "尚贾",
          "text": "你们回声之子有什么资格指着我们的鼻子骂？你们做过多少对不起我们的事？"
        },
        {
          "role": "穆内蒂胡",
          "text": "一群骗子和胆小鬼凑在一起，真让人恶心。"
        },
        {
          "role": "特帕纳胡伊",
          "text": "上天从不眷顾遵守规则的人，越是好东西越要动手抢过来。"
        },
        {
          "role": "帕伊奥",
          "text": "我就不该相信你们！"
        },
        {
          "role": "安杜",
          "text": "（都怪我…如果我没有生病的话…）"
        },
        {
          "role": "安杜",
          "text": "（我不治病了。不要圣火结晶了。你们不要吵了好不好？）"
        },
        {
          "role": "安杜",
          "text": "呜…呜…"
        },
        {
          "role": "伊法",
          "text": "安杜！"
        },
        {
          "role": "咔库库",
          "text": "要上了，哥们！"
        },
        {
          "role": "安杜",
          "text": "…呜！"
        },
        {
          "role": "派蒙",
          "text": "到此为止！我们来帮忙了！"
        },
        {
          "role": "伊法",
          "text": "蛊惑人心的邪恶力量啊，如今的纳塔已经没有你的位置了。"
        },
        {
          "role": "伊法",
          "text": "我们会紧密地团结在一起，共同度过今后的岁月。"
        },
        {
          "role": "伊法",
          "text": "飞吧，哥们，飞吧。去施展我教你的，「团结的魔法」！"
        },
        {
          "role": "安杜",
          "text": "呜！"
        },
        {
          "role": "基尼奇",
          "text": "（欧洛伦。）"
        },
        {
          "role": "欧洛伦",
          "text": "（收到。）"
        },
        {
          "type": "subtitle",
          "text": "欧洛伦将安杜包围在光球中，安杜飞向众人上空，施展「团结的魔法」…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "伊法",
          "text": "「命途幽晦，人心筑高墙。」"
        },
        {
          "role": "伊法",
          "text": "「而我们破壁而行。」"
        },
        {
          "role": "伊法",
          "text": "「愿天下再无纷争——」"
        },
        {
          "role": "安杜",
          "text": "呜——！！"
        },
        {
          "role": "玛薇卡",
          "text": "这是…邪恶的力量在消退。"
        },
        {
          "role": "基尼奇",
          "text": "魔法开始生效了。"
        },
        {
          "role": "玛拉妮",
          "text": "粒果片片肯定要加甜奶酪才好吃呀！"
        },
        {
          "role": "茜特菈莉",
          "text": "哼，咸奶酪才是经典款，是纳塔传承百年的选择。"
        },
        {
          "role": "阿乔",
          "text": "哈哈，奶酪不是小孩子才吃的东西吗？我就从来不吃那玩意儿。"
        },
        {
          "role": "玛拉妮",
          "text": "也对，加咸奶酪的粒果片片也有独特的味道，适合一边听故事一边享用。"
        },
        {
          "type": "subtitle",
          "text": "看到众人和好，安杜开心地扇起了翅膀…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "茜特菈莉",
          "text": "也适合用来下酒。不过甜奶酪搭配一些利口酒也不错…"
        },
        {
          "role": "茜特菈莉",
          "text": "找机会再聚一次吧，弄坏我家门的事就不再提了。"
        },
        {
          "role": "玛拉妮",
          "text": "奶奶，真够意思！下次我和卡齐娜一起去，带上我们烤的龙龙饼干和粒果片片…"
        },
        {
          "role": "卡齐娜",
          "text": "还有火焰炖肉和火山蛋糕！"
        },
        {
          "role": "茜特菈莉",
          "text": "也好，我也去找瓦雷莎，调一些你们能喝的果蔬汁。唉，你们什么时候才能长大呢？每次都是我一个人喝酒。"
        },
        {
          "role": "玛拉妮",
          "text": "你也别喝酒啦，烟谜主不是有一种「奇瑰之汤」吗？现在很流行那个，酸酸甜甜的，比什么酒都好喝。"
        },
        {
          "role": "阿乔",
          "text": "等下，怎么回事？你们这态度变得也太快了吧！"
        },
        {
          "role": "希诺宁",
          "text": "奇怪…我刚刚都说了些什么？"
        },
        {
          "role": "希诺宁",
          "text": "我怎么都想不起来了，玛薇卡，你还记得吗？"
        },
        {
          "role": "玛薇卡",
          "text": "说了什么呢？我想应该是欢迎我经常去工坊，帮你挑战那些不可能完成的事情吧。"
        },
        {
          "role": "玛薇卡",
          "text": "「人生就像登山，风光都在险峰」，我从你的身上能感受到这种热血。"
        },
        {
          "role": "希诺宁",
          "text": "你认真的？"
        },
        {
          "role": "玛薇卡",
          "text": "开玩笑的！下次我肯定不会塞给你奇怪的工作…我尽力。"
        },
        {
          "role": "阿乔",
          "text": "你们怎么也…"
        },
        {
          "role": "阿乔",
          "text": "醒醒啊！你们是被什么东西蛊惑了吗？基尼奇，快想想办法——"
        },
        {
          "role": "基尼奇",
          "text": "阿乔…我也要向你道歉，我平时对你太严格了。"
        },
        {
          "role": "阿乔",
          "text": "！！！"
        },
        {
          "type": "subtitle",
          "text": "阿乔震惊得晕倒在地上…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "玛薇卡",
          "text": "看来邪恶的力量彻底消失了，是你帮了我们吗？"
        },
        {
          "role": "安杜",
          "text": "呜！"
        },
        {
          "role": "咔库库",
          "text": "做得好，哥们！"
        },
        {
          "role": "伊法",
          "text": "做得好，安杜。圣火结晶已经被净化，现在我们可以用它来治疗你的好朋友了。"
        },
        {
          "role": "伊法",
          "text": "去把这个好消息告诉它吧？别让它等急了。"
        },
        {
          "role": "米莱",
          "text": "呜？"
        },
        {
          "role": "安杜",
          "text": "呜！"
        },
        {
          "role": "米莱",
          "text": "呜呜…"
        },
        {
          "role": "伊法",
          "text": "辛苦大家了。比想象中还要成功呢。"
        },
        {
          "role": "玛拉妮",
          "text": "我就说没问题的吧？吵架这方面我最有经验了。"
        },
        {
          "role": "基尼奇",
          "text": "差一点就露馅了。"
        },
        {
          "role": "茜特菈莉",
          "text": "感觉还不如我们部族的小孩子拌嘴，幸好小龙听不懂我们在说什么。"
        },
        {
          "role": "玛拉妮",
          "text": "没办法，在卡齐娜面前，我根本想不到什么埋怨的话。"
        },
        {
          "role": "卡齐娜",
          "text": "玛拉妮…！其实我也是…就算是演戏，我也不想和你吵架。"
        },
        {
          "role": "阿乔",
          "text": "啊？原来只是在演戏啊。唉，真没劲，回去睡觉咯。"
        },
        {
          "role": "基尼奇",
          "text": "慢走不送。"
        },
        {
          "role": "希诺宁",
          "text": "接下来只需要海风草了吧，来的时候我听说已经找到一部分了，估计用不了多久…"
        },
        {
          "role": "伊安珊",
          "text": "各位！看这边！"
        },
        {
          "role": "派蒙",
          "text": "伊安珊！还有…好多龙——！！"
        },
        {
          "role": "伊安珊",
          "text": "已经找齐足够的药材了！我让它们把药材交给我，但它们似乎想亲自送过来。"
        },
        {
          "role": "伊安珊",
          "text": "所以我们一起来了。给，我感觉这么多应该够了。"
        },
        {
          "role": "伊法",
          "text": "各位稍等，我去调配药材。"
        },
        {
          "role": "伊法",
          "text": "咔库库，别聊了，过来帮忙。"
        },
        {
          "role": "咔库库",
          "text": "好的哥们，没问题哥们。"
        },
        {
          "type": "subtitle",
          "text": "伊法很快调好了药物，喂到了米莱口中。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "接下来，就是最重要的步骤——",
          "narration": true,
          "color":"描述"
        },
        {
          "role": "伊法",
          "text": "呼…终于到这个激动人心的时刻了。"
        },
        {
          "role": "伊法",
          "text": "汇聚了众人意志的圣火结晶…拜托了，驱散病痛，缔造奇迹吧。"
        },
        {
          "type": "subtitle",
          "text": "过场动画「因善意而生的魔法」"
        },
        {
          "type": "subtitle",
          "text": "伊法的药治愈了米莱的病，米莱和尼娅欢快地跳起舞，众人和龙都为它们感到开心…"
        },
        {
          "type": "subtitle",
          "text": "米莱拉起安杜的手，让六大部族的龙带着它们上天入地，游览了整个纳塔…"
        },
        {
          "type": "subtitle",
          "text": "纳博尔从夜神之国召唤安杜，安杜依依不舍地向自己的新朋友挥手告别后，飞奔向纳博尔的怀中…"
        },
        {
          "role": "米莱",
          "text": "呜…"
        },
        {
          "role": "伊法",
          "text": "开心点，哥们。朋友的离开难免让人难过，但我们的分别，恰是他们的重逢。"
        },
        {
          "role": "伊法",
          "text": "安杜的灵魂已经在世界上游荡太久，见到你恢复健康，我想它也没有牵挂了。"
        },
        {
          "role": "伊法",
          "text": "它回到了伙伴的身边，这是它最后的心愿。我们应该祝贺它，就像它也为你的康复而起舞。"
        },
        {
          "role": "米莱",
          "text": "呜！"
        },
        {
          "role": "伊法",
          "text": "谢谢大家。正因为有你们在，我做到了先祖未曾做到的事情。"
        },
        {
          "role": "伊法",
          "text": "我们救下了这只被病痛折磨的小龙，也极大地推进了燃素相关病症的研究。"
        },
        {
          "role": "伊法",
          "text": "…作为医生，我的心情真的很激动。"
        },
        {
          "role": "玛薇卡",
          "text": "很好。那么我宣布——本次荣花演武圆满落幕！"
        },
        {
          "role": "玛薇卡",
          "text": "对我来说，这场比赛还有另一个意义。赛事期间，我没有见到争吵、阴谋、为利益算计不休，六部族一同完成了这场壮举。"
        },
        {
          "role": "玛薇卡",
          "text": "没有了深渊这个威胁，我们依旧如家人般亲密。我们比过去的人们做得要好，未来的纳塔也一定会更加团结。"
        },
        {
          "role": "玛薇卡",
          "text": "所以——惯例的庆典也不能少，好好热闹一下吧。"
        },
        {
          "role": "玛拉妮",
          "text": "好耶！"
        },
        {
          "role": "欧洛伦",
          "text": "正好昨天我刚摘了一些新鲜蔬菜，等会儿我去拿。"
        },
        {
          "role": "基尼奇",
          "text": "肉就交给我来准备吧。"
        },
        {
          "role": "希诺宁",
          "text": "多带点肉，拜托。"
        },
        {
          "role": "伊安珊",
          "text": "我去把其他人也叫过来。人多力量大嘛，再说一起准备的饭菜才是最美味的。"
        },
        {
          "role": "玛薇卡",
          "text": "那就今晚见了，各位。"
        },
        {
          "role": "派蒙",
          "text": "今晚见！嘿嘿，我已经准备好大吃一顿啦。"
        },
        {
          "type": "subtitle",
          "text": "参加庆祝宴会"
        },
        {
          "role": "派蒙",
          "text": "卡齐娜！"
        },
        {
          "role": "卡齐娜",
          "text": "嘿嘿，要不要来一点火山蛋糕？我亲手烤的呢。"
        },
        {
          "role": "派蒙",
          "text": "那我不客气啦！"
        },
        {
          "role": "派蒙",
          "text": "真好吃！嘿嘿，我要把一整个蛋糕全部吃掉！"
        },
        {
          "role": "卡齐娜",
          "text": "可以呀，这个本来就是特地为你们烤的。"
        },
        {
          "role": "卡齐娜",
          "text": "甜甜的蛋糕会让人忘记烦恼，我希望大家每天都有好心情。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "感觉卡齐娜变开心了。",
            "比赛时的「心事」消失了？"
          ]
        },
        {
          "role": "卡齐娜",
          "text": "嗯。之前我确实迷茫过，不知道自己以后要做些什么。"
        },
        {
          "role": "卡齐娜",
          "text": "看了以前的织物，我才知道原来六部族以前并没有那么团结，大家会频繁地争吵，甚至还会打架…"
        },
        {
          "role": "卡齐娜",
          "text": "这些事我都没有经历过，甚至很难想象那种残酷的生活。"
        },
        {
          "role": "卡齐娜",
          "text": "我很喜欢现在的纳塔，喜欢和朋友们在一起的时光。帕加尔叔叔跟我说过，越是来之不易的东西越要好好珍惜。"
        },
        {
          "role": "卡齐娜",
          "text": "所以我想尽力去帮忙，想让朋友们都能开心快乐。最重要的是，我想让我们永远团结在一起！"
        },
        {
          "role": "卡齐娜",
          "text": "我还没想好具体要怎么做…不过我可以先从我擅长的事做起，比如烤好吃的饼干和蛋糕，跟大家分享。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "卡齐娜…",
            "好孩子！"
          ]
        },
        {
          "role": "派蒙",
          "text": "我有个提议，卡齐娜可以开一个蛋糕店！"
        },
        {
          "role": "派蒙",
          "text": "这样我就能经常吃到卡齐娜烤的蛋糕啦。"
        },
        {
          "role": "卡齐娜",
          "text": "这样吗？那回头让玛拉妮教教我怎么开店…"
        },
        {
          "role": "卡齐娜",
          "text": "如果能每天亲手做好吃的甜点，让吃过的人都露出笑容，那样的生活应该很美好吧。"
        },
        {
          "role": "卡齐娜",
          "text": "谢谢你们，我好像又找到努力的目标了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "加油。",
            "师父会一直支持你的。"
          ]
        },
        {
          "role": "旅行者",
          "text": "加油。"
        },
        {
          "role": "派蒙",
          "text": "对了，好像没在聚会上见到伊法和那只学舌怪怪龙，卡齐娜知道他们去哪了吗？"
        },
        {
          "role": "卡齐娜",
          "text": "啊…聚会前，我好像听说他想去那个山坡祭拜先祖。他们还没回来吗？"
        },
        {
          "role": "派蒙",
          "text": "再不回来的话，好吃的都要被吃光啦！"
        },
        {
          "role": "派蒙",
          "text": "真没办法，我们把蛋糕带上，去看看他们吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卡齐娜）"
        },
        {
          "role": "卡齐娜",
          "text": "要不要再来一点蛋糕？我烤了很多呢。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（玛拉妮&恰斯卡&希诺宁）"
        },
        {
          "role": "玛拉妮",
          "text": "庆祝荣花演武圆满结束——干杯！"
        },
        {
          "role": "恰斯卡",
          "text": "干杯，总算能休息几天了。"
        },
        {
          "role": "希诺宁",
          "text": "打算给自己放个假？"
        },
        {
          "role": "恰斯卡",
          "text": "从归火圣夜巡礼的经验来看，比赛过后的几天非常清静，很少有什么争斗。"
        },
        {
          "role": "玛拉妮",
          "text": "毕竟比赛消耗了很多精力嘛，赛后大家也想好好休息了。"
        },
        {
          "role": "恰斯卡",
          "text": "是啊。干杯——这次，为了难得的假期。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（玛薇卡）"
        },
        {
          "role": "玛薇卡",
          "text": "多余的圣火结晶我存起来了，下次有需要直接来找我就好。"
        },
        {
          "role": "玛薇卡",
          "text": "另外…我还是第一次「参演」这种舞台剧，感觉很有趣啊。你觉得我演技如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有待提升。",
              "dialogues": [
                {
          "role": "玛薇卡",
          "text": "嗯…我也有同样的感觉，看来我要学习的东西还有很多。"
        },
        {
          "role": "玛薇卡",
          "text": "你很擅长这个？有机会的话，我想请你教教我。"
        }
              ]
            },
            {
              "text": "简直就是天才。",
              "dialogues": [
                {
          "role": "玛薇卡",
          "text": "真的假的？那下次有这样的机会，不要忘了叫我。"
        }
              ]
            }      
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊安珊&茜特菈莉&欧洛伦）"
        },
        {
          "role": "伊安珊",
          "text": "我很好奇，那些黑雾是怎么变出来的？"
        },
        {
          "role": "欧洛伦",
          "text": "只是障眼法而已。如果奶奶出手，肯定能做出更厉害的。"
        },
        {
          "role": "茜特菈莉",
          "text": "好了，好了，别恭维我了。「障眼法而已」？这障眼法已经能骗过我了。"
        },
        {
          "role": "欧洛伦",
          "text": "呃…您还记得那件事啊，当时只是迫不得已…"
        },
        {
          "role": "茜特菈莉",
          "text": "放心吧，没有翻旧账的意思。奶奶我只是想说，你在障眼法上很有一套，这是值得骄傲的事！"
        },
        {
          "role": "欧洛伦",
          "text": "谢…谢谢奶奶。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（瓦雷莎&米莱&尼娅）"
        },
        {
          "role": "瓦雷莎",
          "text": "多吃点肉，才能恢复得更好。"
        },
        {
          "role": "米莱",
          "text": "呜！"
        },
        {
          "role": "尼娅",
          "text": "呜呜！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（基尼奇&阿乔）"
        },
        {
          "role": "阿乔",
          "text": "「我也要向你道歉，我平时对你太严格了。」"
        },
        {
          "role": "阿乔",
          "text": "唉，真想把这话记录下来，让你好好听听。"
        },
        {
          "role": "基尼奇",
          "text": "多喝两杯，今晚说不定能做一个这样的梦。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿卡特&瓦伊纳&阿米娜）"
        },
        {
          "role": "阿卡特",
          "text": "都尝尝看，味道如何？"
        },
        {
          "role": "瓦伊纳",
          "text": "唔…这熟悉的味道，不愧是你的招牌菜啊。"
        },
        {
          "role": "阿米娜",
          "text": "好吃！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（帕加尔&庇兰&穆托塔）"
        },
        {
          "role": "穆托塔",
          "text": "这酒真不错。"
        },
        {
          "role": "帕加尔",
          "text": "那当然了，这可都是我的珍藏。"
        },
        {
          "role": "帕加尔",
          "text": "今天想喝多少都行，谁叫我欠你们人情呢？"
        },
          {
          "role": "庇兰",
          "text": "那我们就不客气了。"
        },
        {
          "role": "穆托塔",
          "text": "想喝多少都行？哈哈，等下可别后悔！"
        },
        {
          "role": "帕加尔",
          "text": "咳…呃…嗯…放马过来吧！"
        },
        {
          "type": "subtitle",
          "text": "寻找伊法"
        },
        {
          "role": "伊法",
          "text": "我说先祖大人啊，现在你们应该团聚在一起了吧？"
        },
        {
          "role": "伊法",
          "text": "因为我也有一只绒翼龙伙伴，所以格外能理解你的心情。"
        },
        {
          "role": "伊法",
          "text": "第一次见到这家伙的时候，它正因为奇特的长相在野外被其他龙欺负。被啄了一身血，差点没命了。"
        },
        {
          "role": "伊法",
          "text": "我帮它上了药，它就死皮赖脸地跟上了我，还成了我的助手。"
        },
        {
          "role": "咔库库",
          "text": "谢谢你，哥们。"
        },
        {
          "role": "伊法",
          "text": "客气什么？"
        },
        {
          "role": "伊法",
          "text": "与我一起行医，注定是辛苦的旅程。有一次我们给病龙治疗的时候，咔库库也感染了。"
        },
        {
          "role": "伊法",
          "text": "它发了高烧，我到处去找药材，做了所有能做的事。但它还是在生死线上徘徊，我只能不停祈祷。"
        },
        {
          "role": "伊法",
          "text": "如果它没有顺利康复，我肯定也会陷入同样的愧疚吧。"
        },
        {
          "role": "伊法",
          "text": "幸好它顽强地撑了过来，还继续留在我的身边帮忙，真是可靠的助手。"
        },
        {
          "role": "伊法",
          "text": "我才应该谢谢你，哥们。"
        },
        {
          "role": "咔库库",
          "text": "客气什么？"
        },
        {
          "role": "伊法",
          "text": "呼…「因愧疚而生的医术」啊，今后，我们一定会将它不断完善下去。"
        },
        {
          "role": "伊法",
          "text": "为了这世界上，不再有同样的愧疚。"
        },
         {
          "type": "subtitle",
          "text": "额外对话（伊法&咔库库）"
        },
        {
          "role": "伊法",
          "text": "咦，哥们，你们怎么也来了？"
        },
        {
          "role": "派蒙",
          "text": "当然是给你们带蛋糕来啦！这是卡齐娜亲手烤的呢，可好吃了！"
        },
        {
          "role": "伊法",
          "text": "是吗？那我可一定要——"
        },
          {
          "role": "咔库库",
          "text": "哦天哪，太棒了哥们！"
        },
        {
          "role": "伊法",
          "text": "喂！给我留一点啊！"
        }
      ],
