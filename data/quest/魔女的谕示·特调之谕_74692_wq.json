{
  "quest_id": 74692,
  "chapter_num": null,
  "chapter_title": "魔女的谕示·特调之谕",
  "type": "wq",
  "route": "Witch's Revelation: Special Blend's Instruction",
  "stories": [
    {
      "story_id": 74692,
      "title": "魔女的谕示·特调之谕",
      "description": "在芭比洛斯的占卜摊前，你遇见了迪奥娜。这位来自蒙德的调酒师，似乎正是芭比洛斯所做出谕示中的一员。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和迪奥娜对话"
        },
        {
          "role": "迪奥娜",
          "text": "…也就是说，你也不能帮我解决这个麻烦的体质？"
        },
        {
          "role": "芭比洛斯",
          "text": "是的。这份扰动已经和你的命运牵连太深，打比方的话，它就像是从你的命运之树上生出的新芽。"
        },
        {
          "role": "芭比洛斯",
          "text": "它一直帮助着你吸收阳光雨露，也早已开始协助「塑造」你的命运。"
        },
        {
          "role": "芭比洛斯",
          "text": "如果贸然把它剪除，留下的伤口说不定会被什么脏东西侵入，从而让整棵树都生病呢。"
        },
        {
          "role": "迪奥娜",
          "text": "嘁…说的好像这个体质是什么好东西似的。明明就是它妨碍我，让我始终调不出想要的酒！"
        },
        {
          "role": "迪奥娜",
          "text": "比起幼苗，我觉得它反而像是那种缠绕在大树上，从一开始就打算勒死大树的藤蔓嘞！"
        },
        {
          "role": "芭比洛斯",
          "text": "唔，如果是那样的话，只要顺着命运的排斥反应，就可以轻松剪除掉了…但很可惜，它并不是这种东西啊。"
        },
        {
          "role": "芭比洛斯",
          "text": "好了，闲话就说到这里。现在你应该相信我是一个正派占卜师了吧？"
        },
        {
          "role": "芭比洛斯",
          "text": "喏，就和之前说的一样，过来随便抽一张牌吧，让我对你的未来做一些小建议。"
        },
        {
          "role": "迪奥娜",
          "text": "唔…呃，那就随便抽一张？这一张…不对不对，这一张…"
        },
        {
          "role": "芭比洛斯",
          "text": "安心吧，无论你怎么选，都只能抽到命中注定的那一张，呵呵呵呵呵…"
        },
        {
          "role": "迪奥娜",
          "text": "（呜…这个占卜师笑得好可怕！就像是童话书里说的老巫婆一样！）"
        },
        {
          "role": "迪奥娜",
          "text": "（但她既然是这么厉害的占卜师，那她的建议，说不定真能帮上我…必须认真选才行！）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别吓小孩了。",
              "dialogues": []
            },
            {
              "text": "好久不见，迪奥娜。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪奥娜",
          "text": "咦？旅行者，小派蒙？"
        },
        {
          "role": "芭比洛斯",
          "text": "不愧是你，每次都出现得恰到好处。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢夸奖。",
              "dialogues": []
            },
            {
              "text": "我很擅长及时出现。",
              "dialogues": []
            },
            {
              "text": "不然怎么处理那么多委托。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芭比洛斯",
          "text": "呵呵呵呵呵，确实如此，比起捉摸不透的「命运」，还是实打实的委托更能直观地塑造人的言行啊。"
        },
        {
          "role": "芭比洛斯",
          "text": "好了，既然你来了，就和这位小朋友聊聊吧，她似乎不太信任我这位魔女啊。"
        },
        {
          "role": "派蒙",
          "text": "在这种偏僻地方摆摊的奇怪占卜师，怎么想都很难信任得起来吧…"
        },
        {
          "role": "迪奥娜",
          "text": "（旅行者好像和这个占卜师很熟悉的样子？太好了，总算可以找个可靠的人打听了…！）"
        },
        {
          "role": "迪奥娜",
          "text": "…旅行者，小派蒙，过来过来，我悄悄问你们点事。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我正好也想问问…",
              "dialogues": []
            },
            {
              "text": "迪奥娜怎么来枫丹了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪奥娜",
          "text": "当然是为了寻找新的调酒材料啦。哼，我之前的调酒思路还是太狭窄了，总是找食材用来调酒…"
        },
        {
          "role": "派蒙",
          "text": "哈哈…哈…迪奥娜找的那些调酒材料，也不能全都算是「食材」啦…"
        },
        {
          "role": "迪奥娜",
          "text": "总、总之，都是一些能入口的东西嘛！只要咬着牙闭着眼，怎么样都能吃下肚子。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以，你打算找一些…",
              "dialogues": []
            },
            {
              "text": "压根不能入口的东西？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪奥娜",
          "text": "是啊，比如…我已经拿到了好多锈蚀的螺丝、废弃的线缆、凝结的油污块，还有…"
        },
        {
          "role": "迪奥娜",
          "text": "还是多亏了枫丹科学院那个做枫达的大叔帮忙，我才能顺利找到这么多好东西。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "安里？",
              "dialogues": []
            },
            {
              "text": "你怎么遇见他了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪奥娜",
          "text": "嗯…我之前就听说，那种很好喝的气泡饮料是枫丹科学院做的，所以一开始就打算过去看看。"
        },
        {
          "role": "迪奥娜",
          "text": "我去了之后，[[安里]]大叔很爽快地请我喝了好几瓶新口味的枫达呢。"
        },
        {
          "role": "迪奥娜",
          "text": "安里大叔身上都没有酒味喔，只有甜甜酸酸的枫达味，一闻就感觉他是一个可靠的大人！"
        },
        {
          "role": "迪奥娜",
          "text": "而且，就是安里大叔建议我来这里看看的。他说，我这种「特殊体质」恐怕不能用科学院的技术解析。"
        },
        {
          "role": "迪奥娜",
          "text": "但他听说最近枫丹廷附近有一个奇怪的占卜摊，去占卜过的人都说非常灵验。"
        },
        {
          "role": "迪奥娜",
          "text": "「去占卜的话，说不定就能弄清原理。只要弄清了原理，也许就能找到解决方法。」"
        },
        {
          "role": "派蒙",
          "text": "听着还挺有道理的，思路也很清晰，该说不愧是枫丹科学院的研究员吗…"
        },
        {
          "role": "迪奥娜",
          "text": "之后，我就来了这个占卜摊…我一过来，她就叫住了我，说我身上有着奇异的扰动。"
        },
        {
          "role": "迪奥娜",
          "text": "我还没来得及接话呢，她就把我的体质问题全都说了出来，但是…"
        },
        {
          "role": "芭比洛斯",
          "text": "但是，枫丹科学院的研究逻辑，并不能直接用在占卜上。"
        },
        {
          "role": "芭比洛斯",
          "text": "即便是知道了「原理」，之后的事情也并不好办…就像是之前我说的那样。"
        },
        {
          "role": "芭比洛斯",
          "text": "神秘学可不是实在的轴承与螺丝，我也无法为你直接「检修」命运。"
        },
        {
          "role": "迪奥娜",
          "text": "那不就是，什么都改变不了的意思吗？那我抽牌也没用…"
        },
        {
          "role": "芭比洛斯",
          "text": "那可不一定啊。说不定你抽了牌，就能找到你命运中缺失的某一片小小齿轮。"
        },
        {
          "role": "芭比洛斯",
          "text": "虽然看起来微不足道，但只要安装进机关里，反而能驱动某一个巨大的系统呢。"
        },
        {
          "role": "迪奥娜",
          "text": "你…你不会骗我吧？旅行者，你说…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "芭比洛斯女士很可靠的。",
              "dialogues": []
            },
            {
              "text": "放轻松抽一张牌吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪奥娜",
          "text": "…好吧，既然旅行者都这么说了，那我就抽一张…"
        },
        {
          "role": "迪奥娜",
          "text": "我、我抽好了。这张牌是…"
        },
        {
          "role": "芭比洛斯",
          "text": "…哦呀，真是奇了…没想到你身上的那团「扰动」居然成长地如此茁壮。"
        },
        {
          "role": "芭比洛斯",
          "text": "它已经不再是「新苗」，而是一根健壮的枝干了。真是奇了…"
        },
        {
          "role": "迪奥娜",
          "text": "啊？什么意思，是…是我以后调酒会越来越好喝的意思吗？！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听着不像是坏事…",
              "dialogues": []
            },
            {
              "text": "但从气势上来说也不算好事呢…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芭比洛斯",
          "text": "如果单从你的体质上来说，确实会如此。而且，你抽到的牌是逆位的「女祭司」。"
        },
        {
          "role": "芭比洛斯",
          "text": "这意味着你曾经过于在意帷幕前的表象，也正是因为如此，才久久无法穿过帷幕。"
        },
        {
          "role": "迪奥娜",
          "text": "听起来和调酒没什么关系嘛…我还以为这张牌会告诉我，需要去找什么食材呢…"
        },
        {
          "role": "芭比洛斯",
          "text": "呵…「月谕圣牌」确实做不到这件事，至少目前不能。"
        },
        {
          "role": "芭比洛斯",
          "text": "但是，你也不一定非要用「调酒」这个行为，来寻找你人生中那个真正的答案啊。"
        },
        {
          "role": "迪奥娜",
          "text": "我人生的真正答案，就是把所有酒鬼大叔都教训一遍，让他们再也不能醉醺醺地发酒疯。"
        },
        {
          "role": "芭比洛斯",
          "text": "很有行动力。不过，虽然你的身体在行动，但你的「内心」却一直停滞不前。"
        },
        {
          "role": "迪奥娜",
          "text": "才不是呢！我…我发自内心最讨厌喝酒的怪大叔了！特别是…"
        },
        {
          "role": "芭比洛斯",
          "text": "原来如此，那么…你和你心里所想着的那个人谈过么？"
        },
        {
          "role": "迪奥娜",
          "text": "我…唔，你、你怎么知道我想的是谁？我都没…"
        },
        {
          "role": "芭比洛斯",
          "text": "当然是占卜啊。呵呵呵，或许你可以抛去那些焦躁的行动，混乱的情绪，用你真正的内心和他对话。"
        },
        {
          "role": "芭比洛斯",
          "text": "这样做的效果，说不定会比调出一瓶世界上最难喝的酒更有效。"
        },
        {
          "role": "迪奥娜",
          "text": "…他肯定不会听的。只要喝了酒，他就什么都不会听的。"
        },
        {
          "role": "芭比洛斯",
          "text": "或许之前是这样。但现在，你已经找到了一枚小小的齿轮。在它的推动下，事情或许会发生一些…微妙的变化。"
        },
        {
          "role": "迪奥娜",
          "text": "你是说这张牌？但它只是一张牌而已…"
        },
        {
          "role": "芭比洛斯",
          "text": "当然不是。我说的是，你已经开始产生变化的「内心」。"
        },
        {
          "role": "迪奥娜",
          "text": "我、我的内心一点变化都没有！现在…现在我要去找调酒材料了！"
        },
        {
          "role": "迪奥娜",
          "text": "…那个，占卜费是多少，我会如数照付的。"
        },
        {
          "role": "芭比洛斯",
          "text": "哦呀，真是个礼貌的孩子，比那丫头讨喜多了。但占卜费就不必了。就当做是魔女赠予你的小礼物吧。"
        },
        {
          "role": "迪奥娜",
          "text": "谢…谢谢你。要是你来蒙德…我可以请你喝饮料的，保证好喝。"
        },
        {
          "role": "芭比洛斯",
          "text": "我去蒙德？嗯…如果有机会的话，去一趟倒也未尝不可…"
        },
        {
          "role": "迪奥娜",
          "text": "也谢谢你们陪我，旅行者，还有小派蒙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没事的。",
              "dialogues": []
            },
            {
              "text": "之后要帮忙的话，随时叫我。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没错。无论是什么麻烦事，我和旅行者都会马上赶过去帮你的。"
        },
        {
          "role": "派蒙",
          "text": "不过嘛…嘿嘿嘿，帮完忙之后，迪奥娜要请我们喝好喝的才行。"
        },
        {
          "role": "迪奥娜",
          "text": "…嗯！等你们来蒙德城玩，我一定请你们喝最好喝的饮料，一点酒都不含的那种。"
        },
        {
          "role": "芭比洛斯",
          "text": "对了，要是你之后对卡牌还有什么疑问，可以去找一个叫莫娜的小丫头。你应该认识她吧？"
        },
        {
          "role": "迪奥娜",
          "text": "莫娜姐姐？我认识呀，她经常来店里点那种最便宜的饮料喝，她也是很厉害的占卜师吗？"
        },
        {
          "role": "芭比洛斯",
          "text": "哈，比我差远了。不过，要是连解读「月谕圣牌」都做不到，那干脆也别自称占卜师了。"
        },
        {
          "role": "芭比洛斯",
          "text": "你只要和她说，替伟大的亚斯妥曼瑟·芭比洛斯·崔斯梅姬斯图斯带来了预言，作为给她的考验。"
        },
        {
          "role": "芭比洛斯",
          "text": "放心，只要这么说了，她肯定会拼尽全力为你解读的。"
        },
        {
          "role": "迪奥娜",
          "text": "嗯，我记住了！亚斯妥…妥曼瑟·芭比洛斯·崔斯梅姬斯图斯…好长的名字…"
        },
        {
          "role": "迪奥娜",
          "text": "这么说来，莫娜姐姐的名字是不是也很长，好像是叫阿斯托洛吉…什么来着…"
        },
        {
          "type": "subtitle",
          "text": "聆听迪奥娜的故事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "聆听故事…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "听完迪奥娜的故事"
        },
        {
          "type": "subtitle",
          "text": "击败19只怪物"
        },
        {
          "type": "subtitle",
          "text": "解锁额外天赋「魔女的谕示·珍选秘藏」",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}