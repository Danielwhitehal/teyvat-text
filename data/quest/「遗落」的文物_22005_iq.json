  "stories": [
    {
      "story_id": 22005,
      "title": "「遗落」的文物",
      "description": "宝儿自称弄丢了一件贵重的文物，正在焦急地搜索。看起来，她似乎很需要有人来帮忙…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与宝儿交谈"
        },
        {
          "role": "宝儿",
          "text": "到底在哪里…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么？"
        },
        {
          "role": "宝儿",
          "text": "呜哇！你是从哪冒出来的？怎么无声无息的…"
        },
        {
          "role": "宝儿",
          "text": "我？我…是一个学者，正在研究归离原的古代建筑和遗物。你…就叫我宝儿吧。"
        },
        {
          "role": "宝儿",
          "text": "不过，我研究太入神，把一个随身的包裹给弄丢了。"
        },
        {
          "role": "宝儿",
          "text": "那里面是我好不容易找到的宝…文物，你愿意帮我找找吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "宝儿",
                  "text": "太好了，应该就掉在附近了…或者再远点，总之，请你仔细找找吧。"
                }
              ]
            },
            {
              "text": "是什么样的包裹？",
              "dialogues": [
                {
                  "role": "宝儿",
                  "text": "就是…平常大家用的包裹啦，一个四四方方的盒子…"
                },
                {
                  "role": "宝儿",
                  "text": "为什么用这个装文物？呃，因为…这样的盒子方便啊！"
                },
                {
                  "role": "宝儿",
                  "text": "而且，我也在盒子里面垫了好几层衣服，绝对不会损坏文物的，请你快去帮我找找吧。"
                }
              ]
            },
            {
              "text": "是什么样的文物？",
              "dialogues": [
                {
                  "role": "宝儿",
                  "text": "是…总之是很贵重的文物，哎呀！说了你也不明白啦。"
                },
                {
                  "role": "宝儿",
                  "text": "只有我这种专业人士，才能判断出它的价值，拜托你了，快帮我找找吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找宝儿丢失的东西"
        },
        {
          "role": "宝儿",
          "text": "到底在哪里…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是什么样的包裹？",
              "dialogues": [
                {
                  "role": "宝儿",
                  "text": "就是…平常大家用的包裹啦，一个四四方方的盒子…"
                },
                {
                  "role": "宝儿",
                  "text": "为什么用这个装文物？呃，因为…这样的盒子方便啊！"
                },
                {
                  "role": "宝儿",
                  "text": "而且，我也在盒子里面垫了好几层衣服，绝对不会损坏文物的，请你快去帮我找找吧。"
                }
              ]
            },
            {
              "text": "是什么样的文物？",
              "dialogues": [
                {
                  "role": "宝儿",
                  "text": "是…总之是很贵重的文物，哎呀！说了你也不明白啦。"
                },
                {
                  "role": "宝儿",
                  "text": "只有我这种专业人士，才能判断出它的价值，拜托你了，快帮我找找吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与宝儿交谈"
        },
        {
          "role": "宝儿",
          "text": "你找到了吗？"
        },
        {
          "role": "旅行者",
          "text": "这个是吗？"
        },
        {
          "role": "宝儿",
          "text": "这个…包裹，好像不是呢…手感轻了好多，里面装着的东西肯定不对…"
        },
        {
          "role": "宝儿",
          "text": "不过，还是辛苦你了，我自己再去找找吧。"
        },
        {
          "role": "宝儿",
          "text": "到底掉在哪了呢…"
        }
      ]
    }
  ]
