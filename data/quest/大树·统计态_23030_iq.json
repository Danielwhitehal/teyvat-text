{
  "quest_id": 23030,
  "chapter_num": null,
  "chapter_title": "大树·统计态",
  "type": "iq",
  "route": "The Great Tree: Statistical State",
  "stories": [
    {
      "story_id": 23030,
      "title": "大树·统计态",
      "description": "在一个巨大的根系旁边，有两个人正在争吵…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与拉德普对话"
        },
        {
          "role": "拉德普",
          "text": "我们需要，更多的数据！"
        },
        {
          "role": "拉德普",
          "text": "你的这些装置没有数据支撑，怎么可能正常运行？"
        },
        {
          "role": "法尔希",
          "text": "你想把所有数据都搜集地尽善尽美了再动手？"
        },
        {
          "role": "法尔希",
          "text": "你捉鱼的时候需要看准每一道波浪吗？你只需要看准下面有鱼的那一条就行了 ！"
        },
        {
          "role": "拉德普",
          "text": "这就是你永远也抓不上鱼的原因。"
        },
        {
          "role": "法尔希",
          "text": "你又没在室罗婆耽进修过！别掐字眼了，咱们必须得先干起来。"
        },
        {
          "role": "法尔希",
          "text": "再拖下去，咱们和雅丝敏的论文说不定就要失去时效性了！"
        },
        {
          "role": "旅行者",
          "text": "你们在吵什么呢？"
        },
        {
          "role": "拉德普",
          "text": "你是…"
        },
        {
          "role": "法尔希",
          "text": "这位一定是雅丝敏提到过的旅行者，您帮了我们不少忙。"
        },
        {
          "role": "拉德普",
          "text": "幸会！旅行者，真是幸会！"
        },
        {
          "role": "法尔希",
          "text": "我叫法尔希，现在正在刹诃伐罗学院求学。"
        },
        {
          "role": "拉德普",
          "text": "我是拉德普，是悉般多摩学院的学生。"
        },
        {
          "role": "法尔希",
          "text": "旅行者，我们也想请你来帮一个忙。"
        },
        {
          "role": "法尔希",
          "text": "你知道雅丝敏最近正在这种「圣树」的根系周围播撒药水吧？"
        },
        {
          "role": "法尔希",
          "text": "不过…呃…最近雅丝敏撒的药水好像出了点问题…"
        },
        {
          "role": "法尔希",
          "text": "在她投药的区域周围，总是会出现各种各样的魔物。"
        },
        {
          "role": "拉德普",
          "text": "我发誓，我绝对没有修改任何配方或者投药比例。一定是…呃，出现了什么预期外的情况。"
        },
        {
          "role": "法尔希",
          "text": "随你怎么说…总之，旅行者，请你和我们一同去雅丝敏播撒药物的地方看一看吧。"
        },
        {
          "role": "法尔希",
          "text": "那边说不定又出现了不少魔物，我们可不敢自己过去…必须得找个武力高强的人同行。"
        },
        {
          "role": "拉德普",
          "text": "更重要的是，就算那些蕈兽没什么太大危险性，但要是导师知道我们的药水出了这种问题…"
        },
        {
          "role": "法尔希",
          "text": "我们这篇论文的开题报告一定会被打回来…"
        },
        {
          "role": "拉德普",
          "text": "特别是我们悉般多摩学院，如果提交上去的数据有错误，导师会骂死我们的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我了。",
              "dialogues": []
            },
            {
              "text": "你们之前怎么解决这问题？",
              "dialogues": [
                {
                  "role": "法尔希",
                  "text": "我们一般会雇佣冒险家，或者是去找我们的导师，请他出面，找几个信得过的镀金旅团成员帮忙。"
                },
                {
                  "role": "法尔希",
                  "text": "但我们导师的耐心也是有限的，现在这种情况，我们也不敢再去找他了…"
                },
                {
                  "role": "拉德普",
                  "text": "所以，只能拜托你了！旅行者！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与拉德普同行"
        },
        {
          "type": "subtitle",
          "text": "与拉德普同行"
        },
        {
          "role": "拉德普",
          "text": "喔！看那个箱子，里面应该装着那些药水吧，看来雅丝敏应该已经来过这里了。"
        },
        {
          "role": "拉德普",
          "text": "咦？箱子上这些药水的盖子还没打开…"
        },
        {
          "role": "法尔希",
          "text": "别把盖子打开！"
        },
        {
          "role": "派蒙",
          "text": "呜啊！看后面，有蕈兽钻出来了！"
        },
        {
          "role": "拉德普",
          "text": "啥？！之前还没有呢？这到底是怎么回事！"
        },
        {
          "role": "派蒙",
          "text": "别听他们唠叨了，旅行者，我们快点上吧！"
        },
        {
          "type": "subtitle",
          "text": "打倒所有蕈兽"
        },
        {
          "type": "subtitle",
          "text": "与拉德普对话"
        },
        {
          "role": "拉德普",
          "text": "还好箱子里的药水罐没被打破，不然我们非得大吐特吐不可…"
        },
        {
          "role": "法尔希",
          "text": "你居然不习惯这种味道？这可都是你亲自做的。"
        },
        {
          "role": "拉德普",
          "text": "我和你解释了多少次了，我加入的是生理催吐剂！"
        },
        {
          "role": "拉德普",
          "text": "和习不习惯没关系，只要人一闻到，身体就会自行做出呕吐反应。"
        },
        {
          "role": "拉德普",
          "text": "我为什么要再重复一遍，你绝对听不懂…"
        },
        {
          "role": "拉德普",
          "text": "不过，雅丝敏到底跑哪里去了？药水也没播撒…"
        },
        {
          "role": "法尔希",
          "text": "她一定又是发现了什么珍稀植物，忙着去采标本了。你还不知道她们阿弥利多的德行吗？"
        },
        {
          "role": "拉德普",
          "text": "好吧，这罐药物就由我们先看着，谢谢你帮忙，旅行者，这些东西请你收下吧。"
        },
        {
          "role": "法尔希",
          "text": "这群阿弥利多…真的是…"
        },
        {
          "type": "subtitle",
          "text": "与拉德普对话"
        },
        {
          "role": "拉德普",
          "text": "咳咳咳，咳咳…在这里应该可以了…"
        },
        {
          "role": "法尔希",
          "text": "呜…呕…你…这都是你的手笔！你居然也会呕吐？"
        },
        {
          "role": "旅行者",
          "text": "呃…咳…咳咳…"
        },
        {
          "role": "拉德普",
          "text": "我和你…和你…解释了多少次了，我加入的是生理催吐剂！"
        },
        {
          "role": "拉德普",
          "text": "和习不习惯没关系，只要人一闻到，身体就会自行做出呕吐反应。"
        },
        {
          "role": "拉德普",
          "text": "我为什么要再重复一遍，你绝对听不懂…唔…呃…"
        },
        {
          "role": "雅丝敏",
          "text": "咦？拉德普和法尔希，还有旅行者？你们怎么来了？"
        },
        {
          "role": "雅丝敏",
          "text": "药水罐也破了…你们被魔物袭击了吗？"
        },
        {
          "role": "拉德普",
          "text": "从表面上来看…确实是这样，你来的时候没看见魔物吗？"
        },
        {
          "role": "雅丝敏",
          "text": "没有啊，我还抽空去旁边采了几株植物做标本呢。"
        },
        {
          "role": "拉德普",
          "text": "这可真是奇怪…非常奇怪。"
        },
        {
          "role": "法尔希",
          "text": "别奇怪了！那些魔物就是被你制作的药水吸引过来的！"
        },
        {
          "role": "拉德普",
          "text": "啥？！但之前的田野试验都没出现过这种情况…"
        },
        {
          "role": "法尔希",
          "text": "那你现在见到了，你能不能务实一点！"
        },
        {
          "role": "拉德普",
          "text": "我们等会来讨论这个问题…旅行者，谢谢你帮忙，这些报酬请你收下。"
        },
        {
          "role": "拉德普",
          "text": "到底是哪里出了问题…"
        }
      ]
    }
  ]
}