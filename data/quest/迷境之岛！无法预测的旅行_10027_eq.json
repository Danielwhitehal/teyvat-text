{
  "quest_id": 10027,
  "chapter_num": "盛夏！海岛？大冒险！ 其一",
  "chapter_title": "迷境之岛！无法预测的旅行",
  "type": "eq",
  "route": "Mysterious Islands: Journey to the Unknown",
  "stories": [
    {
      "story_id": 40010,
      "title": "迷境之岛！无法预测的旅行",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "许久不见可莉了，去骑士团探望她吧！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "◆前往骑士团"
        },
        {
          "type": "subtitle",
          "text": "◆与可莉对话"
        },
        {
          "role": "派蒙",
          "text": "她在那边！"
        },
        {
          "role": "派蒙",
          "text": "小可莉，好久不见啦！"
        },
        {
          "role": "可莉",
          "text": "啊！是荣誉骑士姐姐和小派蒙！"
        },
        {
          "role": "可莉",
          "text": "呜呜，我刚想去找你们…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：哎？",
              "dialogues": [
                {
                  "role": "可莉",
                  "text": "可莉收到一封好可怕好可怕的信，必须要去一个地方！"
                }
              ]
            },
            {
              "text": "旅行者：发生什么事了？",
              "dialogues": [
                {
                  "role": "可莉",
                  "text": "可莉收到一封好可怕好可怕的信，必须要去一个地方！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "可怕的信？"
        },
        {
          "role": "可莉",
          "text": "那个人不承认可莉是嘟嘟可的家人，还说要考验可莉，让可莉到嘟嘟王国去…可是、可是…"
        },
        {
          "role": "派蒙",
          "text": "你、你不要急，慢慢说呀！"
        },
        {
          "role": "旅行者",
          "text": "你说的那个人是谁？"
        },
        {
          "role": "可莉",
          "text": "坏家伙、坏家伙坏家伙！他叫嘟嘟大魔王！"
        },
        {
          "role": "旅行者",
          "text": "……？"
        },
        {
          "role": "派蒙",
          "text": "嘟嘟大魔王是谁啊？"
        },
        {
          "role": "可莉",
          "text": "小派蒙也没听过吗？"
        },
        {
          "role": "派蒙",
          "text": "没听过呢。而且，你为什么要说「也」？"
        },
        {
          "role": "可莉",
          "text": "因为就连可莉也没听过！"
        },
        {
          "role": "派蒙",
          "text": "那不就是莫名其妙的人嘛！"
        },
        {
          "role": "可莉",
          "text": "本来可莉要去找阿贝多哥哥，可阿贝多哥哥不在家，所以…可莉就想到了你！"
        },
        {
          "role": "可莉",
          "text": "这是嘟嘟大魔王写的信，可莉念给你们听！"
        },
        {
          "role": "可莉",
          "text": "「邪恶的火焰女孩，我以嘟嘟一族」…呃，这里不会读…「嘟嘟大魔王之名，否定你成为嘟嘟可新家人的资格！」"
        },
        {
          "role": "可莉",
          "text": "「除非你带着嘟嘟可到金苹果群岛来，点亮」…呃…「接受」…呃…"
        },
        {
          "role": "可莉",
          "text": "有几个词，可莉不认识…"
        },
        {
          "role": "派蒙",
          "text": "让我看看！"
        },
        {
          "role": "派蒙",
          "text": "这个词是「统治者」，说明他是最厉害的人，他说了算；这一段是「点亮四盏明灯，叩响试炼者之门」，大概是要接受某种挑战吧。"
        },
        {
          "role": "派蒙",
          "text": "最后一个词是「审判」，就是…就是他要对你加以判决的意思。"
        },
        {
          "role": "可莉",
          "text": "判…呃…判…决？"
        },
        {
          "role": "派蒙",
          "text": "哎呀，反正不是好事，他会像个了不起的人一样审视你，然后批评你！"
        },
        {
          "role": "旅行者",
          "text": "好像还想让你交还嘟嘟可？"
        },
        {
          "role": "可莉",
          "text": "怎么这样！嘟嘟可是可莉的好朋友，绝对不给他！"
        },
        {
          "role": "可莉",
          "text": "…但是…他说他是嘟嘟一族最厉害的人，难道…嘟嘟一族是嘟嘟可的家人？"
        },
        {
          "role": "派蒙",
          "text": "从名字来看，好像是这个意思呢…不过小可莉，「金苹果群岛」是哪里？"
        },
        {
          "role": "可莉",
          "text": "可莉不知道哦。"
        },
        {
          "role": "派蒙",
          "text": "哎——？！"
        },
        {
          "role": "可莉",
          "text": "「金苹果群岛」，可莉也是第一次听说。金苹果…群岛…？"
        },
        {
          "role": "可莉",
          "text": "是苹果很多的岛吧，嘿嘿。"
        },
        {
          "role": "派蒙",
          "text": "唔…"
        },
        {
          "role": "派蒙",
          "text": "信的正面也只写了刚才可莉读的那几句话，没有落款…小可莉，这封信没有信封吗？"
        },
        {
          "role": "可莉",
          "text": "没有。"
        },
        {
          "role": "旅行者",
          "text": "信从哪里寄出？"
        },
        {
          "role": "可莉",
          "text": "不知道，它突然就出现在我房间的窗台上了。"
        },
        {
          "role": "派蒙",
          "text": "嘟嘟大魔王，嘟嘟一族…如果我没记错的话，嘟嘟可是可莉背包上那只玩偶吧？"
        },
        {
          "role": "可莉",
          "text": "不对！嘟嘟可是可莉最好的朋友，不是玩偶！"
        },
        {
          "role": "派蒙",
          "text": "啊、啊呀，那就是神秘生物了！不过，突然冒出来的家族什么的…有点奇怪，感觉更像是什么人的恶作剧呢。"
        },
        {
          "role": "旅行者",
          "text": "我也觉得像恶作剧哦。"
        },
        {
          "role": "派蒙",
          "text": "既然是恶作剧，不理它就好了。"
        },
        {
          "role": "可莉",
          "text": "不行不行！可莉绝对不会认输，一定要去那里！"
        },
        {
          "role": "派蒙",
          "text": "可是…我们都没见过叫这个名字的地方呀…"
        },
        {
          "role": "可莉",
          "text": "荣誉骑士姐姐，你一定有办法对不对？可莉相信你！"
        },
        {
          "role": "派蒙",
          "text": "就算你这么说…"
        },
        {
          "role": "可莉",
          "text": "求求你啦！求求你啦求求你啦——帮帮可莉吧！"
        },
        {
          "role": "派蒙",
          "text": "总觉得就算我们不答应，她也会一个人去的。这样会很危险吧？"
        },
        {
          "role": "旅行者",
          "text": "是啊…"
        },
        {
          "role": "派蒙",
          "text": "比起让小可莉一个人冒险，还不如我们陪她一起呢！"
        },
        {
          "role": "可莉",
          "text": "好不好，好不好嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：荣誉骑士明白了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唉，小可莉这么努力，我们也只能答应了。不过既然我们跟着一起去，可莉就要乖乖听话，不能一个人乱跑哦！"
                }
              ]
            },
            {
              "text": "旅行者：我会帮助可莉。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唉，小可莉这么努力，我们也只能答应了。不过既然我们跟着一起去，可莉就要乖乖听话，不能一个人乱跑哦！"
                }
              ]
            }
          ]
        },
        {
          "role": "可莉",
          "text": "好——！"
        },
        {
          "role": "派蒙",
          "text": "那么按照惯例，先从打听情报开始吧。"
        },
        {
          "type": "subtitle",
          "text": "◆打听传说中的岛屿"
        },
        {
          "role": "塞琉斯",
          "text": "哦？瞧这位小冒险家一脸烦恼的样子，莫非各位遇上了什么麻烦？"
        },
        {
          "role": "派蒙",
          "text": "呃…可以算是麻烦吧…是这样的，我们想找一片群岛，所以想来请教你这位经验丰富的大冒险家。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：（派蒙为了可莉…好努力…）",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "哈哈哈，打听未知之地，寻求冒险知识，找我塞琉斯准没错！"
                }
              ]
            },
            {
              "text": "旅行者：（突然好会奉承呢，派蒙…）",
              "dialogues": [
                {
                  "role": "塞琉斯",
                  "text": "哈哈哈，打听未知之地，寻求冒险知识，找我塞琉斯准没错！"
                }
              ]
            }
          ]
        },
        {
          "role": "塞琉斯",
          "text": "各位要找什么样的群岛？"
        },
        {
          "role": "可莉",
          "text": "很多小岛…在海上…"
        },
        {
          "role": "派蒙",
          "text": "是一个叫做「金苹果群岛」的地方。"
        },
        {
          "role": "塞琉斯",
          "text": "「金苹果群岛」…唔…嗯…嗯？"
        },
        {
          "role": "塞琉斯",
          "text": "啊哈哈哈，真是了不起啊各位，竟然说出了我塞琉斯都未曾听说的地名！"
        },
        {
          "role": "派蒙",
          "text": "哎——？！连你都不知道？！"
        },
        {
          "role": "塞琉斯",
          "text": "正是，正是！提瓦特大陆如此广袤，任何人都无法将它全部走遍。但没关系，亲爱的朋友，你要有踏入未知之地的勇气！"
        },
        {
          "role": "派蒙",
          "text": "没想到连身为冒险家协会会长的塞琉斯都不知道…难道说，这片岛屿真的不存在吗…"
        },
        {
          "role": "旅行者",
          "text": "塞琉斯，刚才的自信呢？"
        },
        {
          "role": "塞琉斯",
          "text": "哎呀！啊哈哈哈哈…别这样嘛…"
        },
        {
          "role": "可莉",
          "text": "怎么会这样…嘟嘟可…"
        },
        {
          "type": "subtitle",
          "text": "◆打听传说中的岛屿"
        },
        {
          "role": "派蒙",
          "text": "玛乔丽小姐经营纪念品商店，说不定会知道稀奇古怪的事哦！毕竟，纪念品也是各式各样，什么都有的嘛。"
        },
        {
          "role": "玛乔丽",
          "text": "稀奇古怪？你是指…？"
        },
        {
          "role": "派蒙",
          "text": "玛乔丽小姐知道「金苹果群岛」吗？由很多很多小岛组成，位于海面某处…"
        },
        {
          "role": "玛乔丽",
          "text": "群岛不都是由很多小岛组成，位于海面某处吗？"
        },
        {
          "role": "可莉",
          "text": "对哦！"
        },
        {
          "role": "派蒙",
          "text": "对哦！啊不对不对，那我换个问法，蒙德一带有群岛吗？"
        },
        {
          "role": "玛乔丽",
          "text": "据我所知好像没有。蒙德的地图你们应该有看过吧？所有已知的岛屿都标出来了哦，可以对照地图。"
        },
        {
          "role": "玛乔丽",
          "text": "一般而言，地图会忠实记录土地的形貌，地图上没有的地区对大部分人来说，就是不存在的地方呢。"
        },
        {
          "role": "派蒙",
          "text": "蒙德地图上没有，那就是没有了…"
        },
        {
          "role": "派蒙",
          "text": "不存在的地方吗？好有道理欸。"
        },
        {
          "role": "可莉",
          "text": "呜…怎么会…"
        },
        {
          "role": "派蒙",
          "text": "不不不，我的意思是再找其他人问问！"
        },
        {
          "type": "subtitle",
          "text": "◆打听传说中的岛屿"
        },
        {
          "role": "派蒙",
          "text": "霍夫曼先生，你知道「金苹果群岛」吗？"
        },
        {
          "role": "可莉",
          "text": "在海上！"
        },
        {
          "role": "霍夫曼",
          "text": "海上的「金苹果群岛」？呃…"
        },
        {
          "role": "霍夫曼",
          "text": "我还是第一次听说这个名字，是长着很多苹果的岛吗？"
        },
        {
          "role": "可莉",
          "text": "你也不知道啊…"
        },
        {
          "role": "派蒙",
          "text": "因为霍夫曼一直在城里转来转去嘛。"
        },
        {
          "role": "霍夫曼",
          "text": "真是对不起了啊…"
        },
        {
          "role": "可莉",
          "text": "好吧，可莉原谅你！"
        },
        {
          "role": "旅行者",
          "text": "可莉，他没有真的在道歉。"
        },
        {
          "role": "可莉",
          "text": "咦，是吗？"
        },
        {
          "role": "派蒙",
          "text": "我们还是再找别人问问吧。"
        },
        {
          "type": "subtitle",
          "text": "◆整理情报"
        },
        {
          "role": "派蒙",
          "text": "看来蒙德人都不知道信中所说的地方。"
        },
        {
          "role": "旅行者",
          "text": "越来越像恶作剧了呢。"
        },
        {
          "role": "派蒙",
          "text": "小可莉，你有没有关系不好的朋友？会不会是谁写信来吓唬你？"
        },
        {
          "role": "可莉",
          "text": "没有哦，可莉很爱大家，大家也很爱可莉。"
        },
        {
          "role": "派蒙",
          "text": "嗯，我想也是。"
        },
        {
          "role": "可莉",
          "text": "所以，不可能是恶作剧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：确实。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "既不是恶作剧，也没人知道神秘岛屿在哪里…我越来越不能理解这件事了…"
                }
              ]
            },
            {
              "text": "旅行者：没人会对可莉恶作剧吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "既不是恶作剧，也没人知道神秘岛屿在哪里…我越来越不能理解这件事了…"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "有没有知识更加渊博的人呢？"
        },
        {
          "role": "派蒙",
          "text": "渊博…对了！"
        },
        {
          "role": "派蒙",
          "text": "这种事应该请教图书管理员丽莎小姐。她每天呆在图书馆，说不定看过蒙德所有的书呢。"
        },
        {
          "role": "可莉",
          "text": "哦！丽莎姐姐——！"
        },
        {
          "role": "派蒙",
          "text": "走吧，到图书馆去！"
        },
        {
          "type": "subtitle",
          "text": "◆前往蒙德图书馆"
        },
        {
          "type": "subtitle",
          "text": "◆与丽莎对话"
        },
        {
          "role": "派蒙",
          "text": "丽莎小姐！"
        },
        {
          "role": "丽莎",
          "text": "哟，是小可爱、小派蒙和小可莉呀。怎么突然想到来图书馆了？"
        },
        {
          "role": "旅行者",
          "text": "有事想请教丽莎小姐。"
        },
        {
          "role": "可莉",
          "text": "丽莎姐姐，帮可莉找群岛，求求你啦！"
        },
        {
          "role": "丽莎",
          "text": "群岛？"
        },
        {
          "role": "可莉",
          "text": "嘟嘟大魔王叫可莉去「金苹果群岛」，他在挑战可莉！"
        },
        {
          "role": "派蒙",
          "text": "别急别急，我来说吧。丽莎小姐，事情是这样的…"
        },
        {
          "role": "丽莎",
          "text": "为了决定可莉是否有资格成为嘟嘟可的家人，嘟嘟一族的统治者嘟嘟大魔王写信约可莉到金苹果群岛去接受审判。"
        },
        {
          "role": "丽莎",
          "text": "是这样吗？"
        },
        {
          "role": "可莉",
          "text": "是的，可莉一定会去！"
        },
        {
          "role": "丽莎",
          "text": "而小可爱来找我，是为了帮可莉找出金苹果群岛的位置，对不对？"
        },
        {
          "role": "旅行者",
          "text": "丽莎小姐是蒙德最聪明的人之一。"
        },
        {
          "role": "丽莎",
          "text": "哈哈，嘴真甜。既然如此，我也得认真帮忙才行了。"
        },
        {
          "role": "丽莎",
          "text": "那封信可以给姐姐看一下吗？"
        },
        {
          "role": "可莉",
          "text": "嗯！"
        },
        {
          "role": "丽莎",
          "text": "信上的文字信息有限，不过，小可爱，你们有试过其他办法吗？"
        },
        {
          "role": "派蒙",
          "text": "其他办法？"
        },
        {
          "role": "丽莎",
          "text": "信纸上有非常微弱的元素力，比起其他，更像是一种提示…小可爱，请你开启元素视野。"
        },
        {
          "role": "派蒙",
          "text": "原来还有这种办法，我们快试试看！"
        },
        {
          "role": "派蒙",
          "text": "有新发现吗？"
        },
        {
          "role": "旅行者",
          "text": "信的背面出现了新的内容。"
        },
        {
          "role": "丽莎",
          "text": "背面的内容多半是用元素力刻上去的。相当有趣的做法呢。"
        },
        {
          "role": "丽莎",
          "text": "这里有笔，小可爱，麻烦你把元素视野下才能看到的内容描出来。"
        },
        {
          "role": "派蒙",
          "text": "完成了！"
        },
        {
          "role": "丽莎",
          "text": "如此一来，信纸背面的信息也清楚了。纸上画的，应该就是你们要找的「金苹果群岛」。"
        },
        {
          "role": "派蒙",
          "text": "好多小岛啊，像是从海底长出来的一样，独自漂在水里，不跟任何土壤相连…"
        },
        {
          "role": "派蒙",
          "text": "根本就是凭空冒出来的嘛！"
        },
        {
          "role": "丽莎",
          "text": "这座图书馆的藏书，每一本我都看过。其中似乎有提到过类似的岛屿。"
        },
        {
          "role": "丽莎",
          "text": "被暴风雨和浓雾环绕的神秘群岛，它不属于任何国度，外面的生物无法进入，里面的生物也无法离开…只有被选中的人才能进入它的领土。"
        },
        {
          "role": "丽莎",
          "text": "许多年前，某支蒙德船队在海上见到了一片岛屿。据说那天下着暴雨，刮着飓风，船上的人隐约看见浓雾后有着土地。"
        },
        {
          "role": "丽莎",
          "text": "岛屿并不遥远，可无论船只怎么航行，都无法抵达那里。船上的人先是惊讶，随后感到恐惧…认为自己看到了幻觉。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，又神秘又可怕…"
        },
        {
          "role": "丽莎",
          "text": "可惜，书中并未记载岛屿的具体位置。想知道更多信息，恐怕得找比我更有知识的人。"
        },
        {
          "role": "派蒙",
          "text": "我还以为丽莎小姐已经是这方面的专家了。"
        },
        {
          "role": "丽莎",
          "text": "谁让我只是一介图书管理员，不爱到处走呢。"
        },
        {
          "role": "丽莎",
          "text": "小可莉，你想到岛上去吗？那里也许是很可怕的地方哦。"
        },
        {
          "role": "可莉",
          "text": "可莉要去！"
        },
        {
          "role": "丽莎",
          "text": "哈哈，真有勇气，那我也不能故意吓唬孩子了。不过小可莉还是找个陪同者比较好哦，比如像小可爱这样值得信赖的人。"
        },
        {
          "role": "派蒙",
          "text": "小可莉不害怕吗？"
        },
        {
          "role": "可莉",
          "text": "怕，但是…可莉更怕不能做嘟嘟可的家人…"
        },
        {
          "role": "可莉",
          "text": "嘟嘟可很重要，可莉绝——对不能输给大魔王！"
        },
        {
          "role": "可莉",
          "text": "所以可莉要请假，请完假才能去「金苹果群岛」，才能找到嘟嘟大魔王。"
        },
        {
          "role": "派蒙",
          "text": "请假？"
        },
        {
          "role": "可莉",
          "text": "可莉是骑士，琴团长说过，可莉出远门要找她请假。"
        },
        {
          "role": "派蒙",
          "text": "现在就要请假吗？我们还不知道岛在哪里呢！"
        },
        {
          "role": "丽莎",
          "text": "小可爱，看你的表情，已经有头绪了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：我在蒙德有些厉害朋友。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "想让琴放行，得看你们的本事。姐姐我会在图书馆看着书喝着茶，默默祝福你们的。"
                }
              ]
            },
            {
              "text": "旅行者：稍稍有了些思路。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "想让琴放行，得看你们的本事。姐姐我会在图书馆看着书喝着茶，默默祝福你们的。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆与琴对话"
        },
        {
          "role": "可莉",
          "text": "琴团长，可莉要请假，要出远门！"
        },
        {
          "role": "琴",
          "text": "可莉？啊，旅行者和派蒙也在。"
        },
        {
          "role": "芭芭拉",
          "text": "各位，好久不见啦，最近过得好吗？"
        },
        {
          "role": "派蒙",
          "text": "芭芭拉小姐也在呢，真难得！"
        },
        {
          "role": "旅行者",
          "text": "打扰你们姐妹聚会了吗？"
        },
        {
          "role": "琴",
          "text": "咳！当、当然没有了。可莉，突然说要请假是怎么回事？"
        },
        {
          "role": "可莉",
          "text": "可莉要去金苹果群岛见嘟嘟大魔王！否则、否则他就要抢走嘟嘟可！"
        },
        {
          "role": "芭芭拉",
          "text": "大、大魔王？抢走嘟嘟可？"
        },
        {
          "role": "可莉",
          "text": "呜…他不相信可莉有资格成为嘟嘟可的家人…"
        },
        {
          "role": "可莉",
          "text": "可莉必须证明自己，荣誉骑士姐姐也会帮可莉的，对不对？"
        },
        {
          "role": "琴",
          "text": "旅行者，派蒙，是这样吗？"
        },
        {
          "role": "旅行者",
          "text": "可莉说的都是实话。"
        },
        {
          "role": "琴",
          "text": "我从没听说过「金苹果群岛」…它在哪里呢？"
        },
        {
          "role": "芭芭拉",
          "text": "我也没听过…"
        },
        {
          "role": "可莉",
          "text": "可莉也没听过，但丽莎姐姐说，总有人知道！"
        },
        {
          "role": "琴",
          "text": "…连丽莎都不知道的地方？"
        },
        {
          "role": "旅行者",
          "text": "嗯，不过我稍有头绪。"
        },
        {
          "role": "琴",
          "text": "是吗，既然旅行者这么说了，应该是片相当神秘的土地吧…"
        },
        {
          "role": "琴",
          "text": "但很抱歉，西风骑士可莉的外出申请我无法批准。"
        },
        {
          "role": "可莉",
          "text": "为什么，可莉要去！"
        },
        {
          "role": "琴",
          "text": "就算神秘群岛确实存在于某处，我们也无法判断那里是否安全。我不能让可莉前往存在风险的地区。"
        },
        {
          "role": "可莉",
          "text": "不去的话，嘟嘟可会被带走吧…可莉、可莉不想失去嘟嘟可…"
        },
        {
          "role": "芭芭拉",
          "text": "啊…可莉…"
        },
        {
          "role": "琴",
          "text": "再说，你们要如何前往群岛？没有具体安全可靠的方法之前，恕我无法批准。"
        },
        {
          "role": "可莉",
          "text": "…呜…嘟嘟可…"
        },
        {
          "role": "芭芭拉",
          "text": "荣誉骑士！"
        },
        {
          "role": "旅行者",
          "text": "（嗯？芭芭拉在对我眨眼？）"
        },
        {
          "role": "芭芭拉",
          "text": "到门外！"
        },
        {
          "role": "芭芭拉",
          "text": "你们能想到前往岛屿的办法吗？"
        },
        {
          "role": "旅行者",
          "text": "吟游诗人温迪或许知道。"
        },
        {
          "role": "派蒙",
          "text": "刚才我也想到他了！果然，我们的想法很一致嘛。"
        },
        {
          "role": "可莉",
          "text": "温迪？"
        },
        {
          "role": "派蒙",
          "text": "是个神奇的诗人，我都叫他「卖唱的」。"
        },
        {
          "role": "可莉",
          "text": "他能帮可莉吗？"
        },
        {
          "role": "派蒙",
          "text": "他是我们的朋友，肯定会帮你。"
        },
        {
          "role": "芭芭拉",
          "text": "既然是荣誉骑士的朋友，一定没问题。荣誉骑士的可靠，我们大家都很清楚。"
        },
        {
          "role": "芭芭拉",
          "text": "这样吧，我来说服琴团长。她性格很认真，你们也知道，我想，我可能需要一点时间…"
        },
        {
          "role": "芭芭拉",
          "text": "可莉，相信我好吗？我会尽全力帮你。"
        },
        {
          "role": "可莉",
          "text": "嗯，可莉可以等。"
        },
        {
          "role": "芭芭拉",
          "text": "太好了！那么，明天下午到教堂前的广场碰面吧。请期待我的好消息，我一定会成功！"
        },
        {
          "role": "派蒙",
          "text": "真可靠啊，芭芭拉加油！"
        },
        {
          "type": "subtitle",
          "text": "◆等待至翌日前往广场（次日12点-18点）"
        },
        {
          "type": "subtitle",
          "text": "◆与芭芭拉对话"
        },
        {
          "role": "派蒙",
          "text": "我们来啦，大家都在呀！"
        },
        {
          "role": "芭芭拉",
          "text": "各位，这边这边。"
        },
        {
          "role": "可莉",
          "text": "荣誉骑士姐姐，小派蒙~"
        },
        {
          "role": "琴",
          "text": "你好。"
        },
        {
          "role": "旅行者",
          "text": "琴团长也在啊。"
        },
        {
          "role": "琴",
          "text": "是的，说来话长…"
        },
        {
          "role": "琴",
          "text": "芭芭拉和丽莎都跟我谈过，我也想明白了一件事。不论我同不同意，可莉一定会去她要去的地方。她向来如此。"
        },
        {
          "role": "可莉",
          "text": "哎嘿嘿…"
        },
        {
          "role": "芭芭拉",
          "text": "可莉的性格我们也都知道。与其让她冒险，还不如直接同意她的请求。"
        },
        {
          "role": "琴",
          "text": "西风骑士可莉，你的外出申请已被批准。"
        },
        {
          "role": "琴",
          "text": "作为交换，我将与各位一同前往信中所写的「金苹果群岛」。至于骑士团事务，我已经委托给凯亚了。"
        },
        {
          "role": "琴",
          "text": "近期事务繁忙，我原本不该走开的，可…还是放心不下可莉。"
        },
        {
          "role": "琴",
          "text": "所以，请各位允许我同行。"
        },
        {
          "role": "派蒙",
          "text": "好呀好呀，琴团长也一起，那就没问题了！"
        },
        {
          "role": "芭芭拉",
          "text": "姐…不，琴团长建议我也一起，虽然不想这么说…要是途中有什么需要治疗包扎的情况，我也能及时帮忙。"
        },
        {
          "role": "派蒙",
          "text": "这次真是多亏了芭芭拉！"
        },
        {
          "role": "可莉",
          "text": "芭芭拉姐姐，琴团长，你们真好，可莉一定会听话！"
        },
        {
          "role": "琴",
          "text": "可莉常这么说，希望你这次要说到做到哦。"
        },
        {
          "role": "可莉",
          "text": "嘿嘿…"
        },
        {
          "role": "琴",
          "text": "丽莎听说我要陪同前往海岛，还给我准备了一只口袋，据说打开它就能收获新的方向。"
        },
        {
          "role": "派蒙",
          "text": "新的方向，是指看好可莉避免麻烦的新办法吗？"
        },
        {
          "role": "琴",
          "text": "她说抵达海岛之前都不能打开口袋，我想，应该是某种应急方法。"
        },
        {
          "role": "芭芭拉",
          "text": "不愧是丽莎小姐，看来提前为我们想了很多呢。"
        },
        {
          "role": "芭芭拉",
          "text": "接下来是要找那位诗人对吧？刚才我问了附近的居民，他今天没在广场献唱，据说是去了风起地。"
        },
        {
          "role": "派蒙",
          "text": "事不宜迟，我们赶紧去风起地找卖唱的吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往风起地"
        },
        {
          "type": "subtitle",
          "text": "◆与温迪对话"
        },
        {
          "role": "派蒙",
          "text": "温迪——！找到你啦！"
        },
        {
          "role": "温迪",
          "text": "嗯？这么多人一起来找我，是有重要的事吧？"
        },
        {
          "role": "旅行者",
          "text": "温迪，你知道「金苹果群岛」吗？"
        },
        {
          "role": "派蒙",
          "text": "这是那片群岛的地图。"
        },
        {
          "role": "温迪",
          "text": "哦~原来是这里…哈哈哈，恭喜你们，找对人了。"
        },
        {
          "role": "可莉",
          "text": "哇哇哇，你真的知道！"
        },
        {
          "role": "温迪",
          "text": "原来它现在叫「金苹果群岛」啊…从前可是叫做「雾海群岛」的呢。它位于一片特殊海域，普通人很难抵达。"
        },
        {
          "role": "温迪",
          "text": "而且那一带常年有暴风雨和浓雾，船只连靠近都难，更别说登岛了。"
        },
        {
          "role": "温迪",
          "text": "不过，你们为什么要到那里去？"
        },
        {
          "role": "可莉",
          "text": "我要去见大魔王！他说，要考验我作为嘟嘟可家人的资格！"
        },
        {
          "role": "温迪",
          "text": "嗯嗯，你怕他吗？"
        },
        {
          "role": "可莉",
          "text": "有、有一点...但可莉不会认输。卖唱的大哥哥，请你帮帮可莉！"
        },
        {
          "role": "温迪",
          "text": "卖唱的大哥哥…有意思，我喜欢这个名字呢。"
        },
        {
          "role": "旅行者",
          "text": "派蒙，你带坏小孩子…"
        },
        {
          "role": "派蒙",
          "text": "是、是我的错吗？"
        },
        {
          "role": "温迪",
          "text": "没关系没关系，既然你有这个愿望，那卖唱的大哥哥也要出手帮忙啦。"
        },
        {
          "role": "琴",
          "text": "真的可以吗？"
        },
        {
          "role": "温迪",
          "text": "当然啦，谁让小孩子的愿望是世界上最纯净、最自由的东西呢？"
        },
        {
          "role": "芭芭拉",
          "text": "好优美的琴声…"
        },
        {
          "role": "派蒙",
          "text": "哎？起风了？"
        },
        {
          "role": "温迪",
          "text": "稍等片刻，马上就来哦。"
        },
        {
          "role": "琴",
          "text": "这、这是…？！"
        },
        {
          "role": "温迪",
          "text": "嘘…"
        },
        {
          "role": "温迪",
          "text": "可别告诉其他人，这是我们之间的秘密。"
        },
        {
          "role": "芭芭拉",
          "text": "四风守护？！"
        },
        {
          "role": "琴",
          "text": "咳…咳！亲爱的诗人，非常感谢您为我们所做的一切。"
        },
        {
          "role": "温迪",
          "text": "代理团长真客气呀。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：不愧是温迪。",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "哈哈，各位惊讶的表情可真精彩啊。"
                }
              ]
            },
            {
              "text": "旅行者：真有你的！",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "哈哈，各位惊讶的表情可真精彩啊。"
                }
              ]
            }
          ]
        },
        {
          "role": "温迪",
          "text": "我就不送了，大家一路顺风哦！"
        },
        {
          "type": "subtitle",
          "text": "◆抵达神秘岛屿"
        },
        {
          "type": "subtitle",
          "text": "◆与众人讨论岛屿的情况"
        },
        {
          "role": "特瓦林",
          "text": "就到这里吧。"
        },
        {
          "role": "特瓦林",
          "text": "后面的事我不便陪同，你们多加小心。"
        },
        {
          "role": "旅行者",
          "text": "……？"
        },
        {
          "role": "可莉",
          "text": "到了到了，是海边！"
        },
        {
          "role": "派蒙",
          "text": "卖唱的真有面子，居然让我们骑龙过来！这么大的风，我快被吹走了…"
        },
        {
          "role": "芭芭拉",
          "text": "我、我还是第一次坐在龙背上…心脏到现在都怦怦跳个不停…"
        },
        {
          "role": "琴",
          "text": "呼…大家应该不要紧吧？"
        },
        {
          "role": "芭芭拉",
          "text": "嗯，我没事。姐…琴团长，那位诗人到底是什么来头？"
        },
        {
          "role": "琴",
          "text": "是…呃…"
        },
        {
          "role": "琴",
          "text": "是一位具有高超音乐技巧的传奇诗人，能用琴声吸引各种生物。"
        },
        {
          "role": "旅行者",
          "text": "这也是管理下属必须之技吧。"
        },
        {
          "role": "芭芭拉",
          "text": "这么厉害的人，回去之后可得好好谢谢他呀。"
        },
        {
          "role": "琴",
          "text": "话说回来，这片岛屿…"
        },
        {
          "role": "琴",
          "text": "气候十分恶劣，雾气浓重，能见度极低，与丽莎所说的传闻一致。"
        },
        {
          "role": "派蒙",
          "text": "我们还是小心点比较好。"
        },
        {
          "role": "琴",
          "text": "旅行者，派蒙，那封信里还说了什么吗？"
        },
        {
          "role": "派蒙",
          "text": "我记得内容！全文是：「邪恶的火焰女孩，我以嘟嘟一族统治者嘟嘟大魔王之名，否定你成为嘟嘟可新家人的资格！」"
        },
        {
          "role": "旅行者",
          "text": "除非…"
        },
        {
          "role": "派蒙",
          "text": "「除非你带着嘟嘟可到金苹果群岛来，点亮四盏明灯，叩响试炼者之门，接受审判。」"
        },
        {
          "role": "芭芭拉",
          "text": "「四盏明灯」，意思是要找四样能发光的东西吗？"
        },
        {
          "role": "派蒙",
          "text": "这么一说，我们所在的区域跟周围比起来，雾气好像少一些？"
        },
        {
          "role": "琴",
          "text": "仔细看的话，确实如此。"
        },
        {
          "role": "琴",
          "text": "难道是跟旁边这台装置有关？"
        },
        {
          "role": "派蒙",
          "text": "空，你觉不觉得这种装置很眼熟？跟我们用过的口袋锚点十分类似呢。"
        },
        {
          "role": "派蒙",
          "text": "制作口袋锚点需要发光髓，所以口袋锚点似乎也有着驱散黑暗的额外作用…这边的装置好像能驱散雾气，应该是同一种东西吧。"
        },
        {
          "role": "旅行者",
          "text": "我想是的。"
        },
        {
          "role": "芭芭拉",
          "text": "「点亮四盏明灯，叩响试炼者之门」…意思是，点亮四个装置后会有什么事发生？"
        },
        {
          "role": "琴",
          "text": "这里已经有一座被点亮的装置了。看来，我们要找到并点亮剩下三座装置才行。"
        },
        {
          "role": "可莉",
          "text": "咦，那是什么？"
        },
        {
          "role": "派蒙",
          "text": "喂，别乱跑…哎呀，空，我们快跟上去！"
        },
        {
          "role": "可莉",
          "text": "下面好像有东西！"
        },
        {
          "role": "琴",
          "text": "靠近看看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往上船点"
        },
        {
          "type": "subtitle",
          "text": "◆听听大家的看法"
        },
        {
          "role": "派蒙",
          "text": "这是…船？"
        },
        {
          "role": "琴",
          "text": "看上去像是有人在等我们来。"
        },
        {
          "role": "派蒙",
          "text": "要在这么恶劣的天气中开船吗？"
        },
        {
          "role": "琴",
          "text": "恐怕对方就是这个意思。各位，海岛的一切还是未知，不论面临怎样的挑战，都请谨慎行事，注意安全。"
        },
        {
          "type": "subtitle",
          "text": "◆寻找并点亮所有装置"
        },
        {
          "type": "subtitle",
          "text": "◆到高处确认情况"
        },
        {
          "type": "subtitle",
          "text": "◆与大家讨论"
        },
        {
          "role": "可莉",
          "text": "雾散啦——！"
        },
        {
          "role": "派蒙",
          "text": "咦，原来这里的景色这么好。"
        },
        {
          "role": "琴",
          "text": "「四盏明灯」已经全部点亮，不知接下来还会有什么考验。"
        },
        {
          "role": "芭芭拉",
          "text": "嗯——天气真好啊！"
        },
        {
          "role": "芭芭拉",
          "text": "就算知道情况没那么轻松，也忍不住开始享受夏天了呢…"
        },
        {
          "role": "可莉",
          "text": "可莉想去抓鱼！"
        },
        {
          "role": "琴",
          "text": "可莉，这里可不是蒙德城，请务必注意安全。"
        },
        {
          "role": "可莉",
          "text": "噢…可莉知道了…"
        },
        {
          "role": "可莉",
          "text": "小派蒙，等见到嘟嘟大魔王，我们一起说服他，然后就去抓鱼吧！"
        },
        {
          "role": "派蒙",
          "text": "好好好，都听你的。"
        },
        {
          "role": "琴",
          "text": "嘟嘟大魔王…究竟是什么呢？"
        },
        {
          "role": "旅行者",
          "text": "琴团长似乎很担心。"
        },
        {
          "role": "琴",
          "text": "是啊，我也是第一次到这里来。这么说对可莉或许不太公平，但我的首要职责是保护你们，其次才是找到那个大魔王。"
        },
        {
          "role": "琴",
          "text": "而且，突然的来信，常人无法抵达的海岛…一切未免太过巧合了。这样的邀请，为什么会送到一个孩子手里？"
        },
        {
          "role": "芭芭拉",
          "text": "确实很不可思议呢…嗯，我也不能掉以轻心。"
        },
        {
          "role": "派蒙",
          "text": "大家，要不要到周围探险呀！"
        },
        {
          "role": "旅行者",
          "text": "派蒙，心真大呀。"
        },
        {
          "role": "琴",
          "text": "派蒙说得没错，我们应该趁着天气转晴再次确认周围情况。"
        },
        {
          "role": "芭芭拉",
          "text": "就算是在陌生海岛上，只要有你在，我可一点都不担心呢。"
        },
        {
          "role": "芭芭拉",
          "text": "呼——！要不然，先去游游泳吧？"
        },
        {
          "role": "琴",
          "text": "唉，面对美景，芭芭拉还是那样容易松懈呢…"
        },
        {
          "role": "琴",
          "text": "旅行者，请你放心地探索。如果有危险，我会及时赶到你身旁。"
        },
        {
          "role": "琴",
          "text": "只是…但愿海岛上没有太多麻烦。"
        }
      ]
    }
  ]
}