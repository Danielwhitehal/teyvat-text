{
  "quest_id": 21022,
  "chapter_num": null,
  "chapter_title": "宝藏归离",
  "type": "wq",
  "route": "Treasure Lost, Treasure Found",
  "stories": [
    {
      "story_id": 21022,
      "title": "宝藏归离",
      "description": "在「归离集」之中，似乎隐藏着什么秘密…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往归离集遗迹寻找古代石碑"
        },
        {
          "role": "索拉雅",
          "text": "…璃月，到底埋藏着多少秘密…"
        },
        {
          "role": "索拉雅",
          "text": "唉，这么多传说，这么多说法…到底哪一个才是真的呢…"
        },
        {
          "type": "subtitle",
          "text": "与索拉雅对话"
        },
        {
          "role": "索拉雅",
          "text": "你从遗迹里找到线索了？"
        },
        {
          "role": "旅行者",
          "text": "找到了五座石碑。"
        },
        {
          "role": "索拉雅",
          "text": "太好了，让我来看看…呃，这些文字，顺序都乱了，我要捋捋…"
        },
        {
          "role": "索拉雅",
          "text": "…好像很多文字都缺失了，读起来断断续续的，而且，也不知道这种顺序对不对…"
        },
        {
          "role": "索拉雅",
          "text": "总之，我先大致排列了一下，这些文字连起来应该是…"
        },
        {
          "role": "索拉雅",
          "text": "「…初，因农而兴，聚之为集…有神临，名『归终』，善扬尘，遮天不知几千里…」"
        },
        {
          "role": "索拉雅",
          "text": "「…引诫四条，告以诸民…后又有神临，以岩为器，迁璃月族民于集，共护诸民…」"
        },
        {
          "role": "索拉雅",
          "text": "「…取二神之名，号此集为『归离』…」"
        },
        {
          "role": "索拉雅",
          "text": "唔，看起来，这是在讲述这片「归离集」的来历，还有一位护佑着「归离集」，善于操控「尘」的神明。"
        },
        {
          "role": "索拉雅",
          "text": "不过，上面还说，还有一位魔神曾经到过这里，甚至还把自己的子民迁过来了一部分。"
        },
        {
          "role": "索拉雅",
          "text": "就连「归离集」这个名字，都是从这两位神的名字中各取了一个字，合起来之后得到的名字。"
        },
        {
          "role": "索拉雅",
          "text": "真是罕见，文献记载里，还没有两位魔神能这么和平相处，而且还互相合作…"
        },
        {
          "role": "索拉雅",
          "text": "与其说是两位魔神，不如说是两位关系很好的朋友呢。"
        },
        {
          "role": "索拉雅",
          "text": "不过，真奇怪，为什么后面突然没有了…"
        },
        {
          "role": "索拉雅",
          "text": "而且，「归离集」又怎么会变为废墟的？有着两位魔神共同护佑，一般的天灾人祸，应该都不会毁灭整个「归离集」才对。"
        },
        {
          "role": "索拉雅",
          "text": "一定是发生了什么连魔神都无法解决的灾难…"
        },
        {
          "role": "索拉雅",
          "text": "旅行者，你能再去周围找找线索吗？如果不出意外的话，这里应该还有更多你之前发现的那种石碑。"
        },
        {
          "role": "索拉雅",
          "text": "也许，那些石碑上记载着后面的故事…"
        },
        {
          "role": "索拉雅",
          "text": "但这些石碑上所记载的东西，和一些文献中所记载的好像又有所差别…"
        },
        {
          "role": "索拉雅",
          "text": "唉，这么多传说，这么多说法…到底哪一个才是真的呢…"
        },
        {
          "type": "subtitle",
          "text": "寻找石碑"
        },
        {
          "type": "subtitle",
          "text": "寻找石碑"
        },
        {
          "type": "subtitle",
          "text": "与索拉雅对话"
        },
        {
          "role": "索拉雅",
          "text": "你回来了，我都要等不及了，你找到什么了？"
        },
        {
          "role": "旅行者",
          "text": "又找到两座石碑…"
        },
        {
          "role": "索拉雅",
          "text": "快给我看看！"
        },
        {
          "role": "索拉雅",
          "text": "「…战于『归离原』，彼时黑尘漫天，千岩俱裂…」"
        },
        {
          "role": "索拉雅",
          "text": "这是…好像是在说，在归离原上发生过一场大战，而且规模很大…"
        },
        {
          "role": "索拉雅",
          "text": "「归离集」应该就是毁于这次大战。但是另外一段话…"
        },
        {
          "role": "索拉雅",
          "text": "…似乎是一位不愿意离开「归离集」的人所留下来的，这个人一直守在这里，而且…"
        },
        {
          "role": "旅行者",
          "text": "而且还有宝藏。"
        },
        {
          "role": "索拉雅",
          "text": "…你对这个还真是敏感，不过，光是从字面上理解。在这片「归离原」上，确实有着一批宝藏。"
        },
        {
          "role": "索拉雅",
          "text": "但是，上面还说「…引之以『归终四诫』…」，后面还说…"
        },
        {
          "role": "索拉雅",
          "text": "「教之以智、律之以德、坚其筋骨，众志一心，四者汇之而成『归离集』。」"
        },
        {
          "role": "索拉雅",
          "text": "唔…根本不知道从哪里理解起。"
        },
        {
          "role": "索拉雅",
          "text": "我们回望舒客栈去吧。在那里稍作休整之后，我们再来解读这个「归终四诫」。"
        }
      ]
    }
  ]
}