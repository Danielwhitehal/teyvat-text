  "stories": [
    {
      "story_id": 71707,
      "title": "言笑的食材需求",
      "description": "望舒客栈的言笑需要两份培根。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将两份培根交给言笑"
        },
        {
          "role": "旅行者",
          "text": "关于培根…"
        },
        {
          "role": "言笑",
          "text": "嗯，是我的委托，你已经把两份培根都准备好了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "都准备好了。",
              "dialogues": []
            },
            {
              "text": "还没有…",
              "dialogues": [
                {
                  "role": "言笑",
                  "text": "那你准备好了之后，就快点拿给我吧。哼，那个吃白食的还等着我给他送饭过去呢。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与言笑对话"
        },
        {
          "role": "言笑",
          "text": "嗯…这两份培根差不多够了，那个吃白食的应该也吃不了多少。"
        },
        {
          "role": "言笑",
          "text": "哦对了，这是报酬，拿好了。"
        }
      ]
    }
  ]
}