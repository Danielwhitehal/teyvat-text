{
  "quest_id": 74710,
  "chapter_num": null,
  "chapter_title": "暴躁鱼儿还不少…",
  "type": "wq",
  "route": "Tons of Tons of Furious Fish...",
  "stories": [
    {
      "story_id": 74710,
      "title": "暴躁鱼儿还不少…",
      "description": "希格雯似乎有事找我们…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与希格雯对话"
        },
        {
          "role": "希格雯",
          "text": "嗯…在足够宽敞，装饰还特别用心的水箱之中，乖巧的鱼儿们来回游动…"
        },
        {
          "role": "希格雯",
          "text": "这场景的确非常漂亮。"
        },
        {
          "role": "派蒙",
          "text": "这也是水族馆吸引人的地方之一！"
        },
        {
          "role": "希格雯",
          "text": "要是它们在开放的水域里也这么安分就好了，潜入水下的人们就能更沉浸地享受自然生命的美景…"
        },
        {
          "role": "希格雯",
          "text": "言归正传，多亏你们的协助，我查出了这些鱼儿暴躁的原因——"
        },
        {
          "role": "希格雯",
          "text": "这些年来，陆陆续续发生了一些水运事故，还有坏家伙违法倾倒废弃物…"
        },
        {
          "role": "希格雯",
          "text": "大量人造物品沉入海底，不断堆积，破坏了许多鱼儿的栖息地，导致鱼儿们的攻击性愈发高涨…"
        },
        {
          "role": "希格雯",
          "text": "之前，已经有一批潜水员接到委托，开始专门处理这些垃圾了。"
        },
        {
          "role": "希格雯",
          "text": "看来得提醒他们，有劳他们加快进度…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来短期内无法解决啊…",
              "dialogues": []
            },
            {
              "text": "一时半会儿应该处理不完…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希格雯",
          "text": "是的，在此期间，我们还是继续之前的工作，尽可能把更多暴躁的鱼儿请回来休养吧。"
        },
        {
          "role": "希格雯",
          "text": "将病患与致病环境隔离开来，是相当重要的步骤。"
        },
        {
          "role": "派蒙",
          "text": "收到！就放心交给我们吧，我们继续寻找患者！"
        }
      ]
    }
  ]
}