{
  "quest_id": 71059,
  "chapter_num": null,
  "chapter_title": "他乡迷失客·觅迹",
  "type": "wq",
  "route": "Lost in a Foreign Land: Seeking",
  "stories": [
    {
      "story_id": 71059,
      "title": "他乡迷失客·觅迹",
      "description": "在层岩巨渊之下，遇到了独自游荡的愚人众术士卡塔琳娜，她似乎是为了什么目的而在层岩巨渊徘徊，去问问她究竟是为了什么事吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与卡塔琳娜对话"
        },
        {
          "role": "卡塔琳娜",
          "text": "你们来了！请随便坐坐吧。"
        },
        {
          "role": "卡塔琳娜",
          "text": "抱歉，之前急匆匆把你们赶走，也没有说清楚要请你们帮什么忙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没关系，你请说吧。",
              "dialogues": []
            },
            {
              "text": "没关系，我们还没答应你呢。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对呀，你们是愚人众嘛！要是指使我们做坏事的话，我们可不干！"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "噗…你说的很有道理。"
                }
              ]
            }
          ]
        },
        {
          "role": "卡塔琳娜",
          "text": "放心吧，我不会让你们做坏事的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你请说。",
              "dialogues": []
            },
            {
              "text": "你当然不会让我们坏愚人众的事。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对啊，如果我们做的好事对于你们这些坏家伙来说是坏事的话，你可不许阻止我们呀！"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "什么好事…坏事…我阻止你们…？"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "唉…你们好烦啊，听我把话说完好不好！"
                }
              ]
            }
          ]
        },
        {
          "role": "卡塔琳娜",
          "text": "是这样的…我的科利亚…我的队员尼古拉和我失散了。"
        },
        {
          "role": "卡塔琳娜",
          "text": "所以…我想拜托你寻找他留下的线索。"
        },
        {
          "role": "卡塔琳娜",
          "text": "如果他还活着，请带他回来见我。如果他牺牲了…也请让我知道。"
        },
        {
          "role": "卡塔琳娜",
          "text": "实在抱歉，拜托你这样的事情…但希望你们能够考虑一下。"
        },
        {
          "role": "派蒙",
          "text": "这样呀…我还以为你要找我们做什么坏事呢！比如说，给千岩军搞破坏…什么的…"
        },
        {
          "role": "卡塔琳娜",
          "text": "千岩军…为什么？和他们为敌对我们愚人众没有好处的。"
        },
        {
          "role": "旅行者",
          "text": "你是什么意思？"
        },
        {
          "role": "卡塔琳娜",
          "text": "我还想问你…！"
        },
        {
          "role": "卡塔琳娜",
          "text": "等等…我明白了…我们在地面上和璃月人闹翻了…？这就解释了为什么我们的补给会中断…"
        },
        {
          "role": "卡塔琳娜",
          "text": "可恶…地面上到底发生了些什么啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说来话长…",
              "dialogues": []
            },
            {
              "text": "事端是你们挑起的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡塔琳娜",
          "text": "哼…那个之后再说。战争就是这样…敌友瞬息万变，这就是愚人众栖身其中的环境。"
        },
        {
          "role": "卡塔琳娜",
          "text": "但我现在…至少是现在，我只关心科利亚一个人。"
        },
        {
          "role": "卡塔琳娜",
          "text": "在我们撤退的途中，他和小队失散了…后来，我回来找他，结果自己也和其他人失散了。唉，真是丢人…"
        },
        {
          "role": "卡塔琳娜",
          "text": "至于他最后出现的地点…我可以帮你在地图上标出位置。"
        },
        {
          "role": "卡塔琳娜",
          "text": "他在那里和我们分开了，他想要引开追击的敌人…他是个优秀的战士，我知道他不会死在那里。"
        },
        {
          "type": "subtitle",
          "text": "未找到线索时的闲聊"
        },
        {
          "role": "卡塔琳娜",
          "text": "你回来了。请问有什么发现吗？"
        },
        {
          "role": "卡塔琳娜",
          "text": "没有的话也没关系的，请随便休息一下吧。"
        },
        {
          "role": "卡塔琳娜",
          "text": "不用在乎我是否着急啦…反正我也有留在这里养老的计划，说不定还要拜托你替我申领退休金呢！"
        },
        {
          "role": "派蒙",
          "text": "哇，你这家伙倒是悠闲！"
        },
        {
          "role": "卡塔琳娜",
          "text": "哼，你们再没什么新发现的话，我可要在这里悠闲到老咯。"
        },
        {
          "type": "subtitle",
          "text": "寻找尼古拉留下的线索"
        },
        {
          "role": "派蒙",
          "text": "唔哇…这里有好多黑糊糊的脏东西！说不定下面埋着什么东西呢？"
        },
        {
          "role": "派蒙",
          "text": "哼…挖出来也已经变脏了吧，真是难办…"
        },
        {
          "type": "subtitle",
          "text": "前往尼古拉日志中提及的地点"
        },
        {
          "type": "subtitle",
          "text": "探索日志提及的地点"
        },
        {
          "role": "派蒙",
          "text": "那个叫尼古拉的愚人众，应该就在这里吧？"
        },
        {
          "type": "subtitle",
          "text": "阅读尼古拉留下的信息"
        },
        {
          "role": "派蒙",
          "text": "看，是一张纸，和愚人众的徽记…?"
        },
        {
          "role": "派蒙",
          "text": "咦…这个徽记…就是那个愚人众家伙留下的吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…连个人影都没有，这下我们要怎么回去交差呀…"
        },
        {
          "role": "派蒙",
          "text": "嗯，也没有别的办法啦，我们回去吧？"
        },
        {
          "role": "派蒙",
          "text": "看起来这个洞口被坍塌的碎石封住了…完全无法通过了呢。"
        },
        {
          "role": "派蒙",
          "text": "卡塔琳娜提到的那个家伙，会不会就通过这里逃跑了呢？"
        },
        {
          "type": "subtitle",
          "text": "将找到的线索告诉卡塔琳娜"
        },
        {
          "role": "卡塔琳娜",
          "text": "你们回来了，我还有些火水可以分。"
        },
        {
          "role": "卡塔琳娜",
          "text": "哈哈…没有要你们陪我喝酒啦，如果你们受伤的话，火水也可以用来清洁伤口的。"
        },
        {
          "role": "卡塔琳娜",
          "text": "怎么样？有何收获？"
        },
        {
          "role": "旅行者",
          "text": "我们找到了这些。"
        },
        {
          "role": "卡塔琳娜",
          "text": "这些是…士官徽章，行动日志和…笔记？"
        },
        {
          "role": "卡塔琳娜",
          "text": "请告诉我，科利亚他人在哪里？他还活着吗…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们没有找到他，但他可能还活着。",
              "dialogues": []
            },
            {
              "text": "他可能通过密道逃走了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡塔琳娜",
          "text": "科利亚不可能丢下我去做逃兵的。你们…你们可以放心，我明白的，他是不会临阵脱逃的。"
        },
        {
          "role": "卡塔琳娜",
          "text": "这些东西，你们是在哪里发现的？"
        },
        {
          "role": "旅行者",
          "text": "东南方一处山洞，我为你标出来。"
        },
        {
          "role": "派蒙",
          "text": "是一个很邪门的地方，有很多奇怪的怪物…"
        },
        {
          "role": "卡塔琳娜",
          "text": "谢谢…谢谢你，我…抱歉……"
        },
        {
          "role": "卡塔琳娜",
          "text": "我…我希望科利亚牺牲了，我宁愿这样相信。"
        },
        {
          "role": "卡塔琳娜",
          "text": "科利亚，请不要让女皇陛下蒙羞，不要让我蒙羞……"
        },
        {
          "role": "卡塔琳娜",
          "text": "咳，咳…我没事的…抱歉，抱歉！把气氛搞得这么僵…才想起来，还没来得及好好感谢你们呢！"
        },
        {
          "role": "卡塔琳娜",
          "text": "对了，火水…啊，唉…你们不喝酒的，是吗？"
        },
        {
          "role": "卡塔琳娜",
          "text": "我还有些摩拉…还有就是…之前收集的一些物资，反正已经没有什么用了，请你收下吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "接下来有何打算？",
              "dialogues": []
            },
            {
              "text": "还需要我帮忙吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡塔琳娜",
          "text": "接下来吗？谢谢关心，不过我不需要再拜托你帮忙「做坏事」啦。"
        },
        {
          "role": "卡塔琳娜",
          "text": "嗯…也许我还是会去找我的科利亚吧。"
        },
        {
          "role": "卡塔琳娜",
          "text": "部队调防之前他寄给我的信，我还留在身上…对于我来说，这是他还在这世上的最后证据了…我会永远将它留在身边。"
        },
        {
          "role": "卡塔琳娜",
          "text": "如果他还活着…作为女皇陛下的愚人众，我会猎取那个叛徒的首级，无论他逃到哪里，藏到什么时候。"
        },
        {
          "role": "卡塔琳娜",
          "text": "如果他已经牺牲了…作为他的姐姐，我也将迎向每一位愚人众必然面临的命运，并且为他而自豪。"
        },
        {
          "role": "卡塔琳娜",
          "text": "所谓「舍我其谁」呢…就是这样的事。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "如果你在作恶，而我必须阻止你呢？",
              "dialogues": [
                {
                  "role": "卡塔琳娜",
                  "text": "…我们都有没得选择的时候，也都有不得不去做的事情，对吧？"
                }
              ]
            },
            {
              "text": "你一定要拘泥于愚人众的立场吗？",
              "dialogues": [
                {
                  "role": "卡塔琳娜",
                  "text": "嗯？是呀，很奇怪吗？"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "理念呀、立场呀，都是太无聊的问题了。噗…我的面具下面可不是只有理念，我是怕子弹的！"
                }
              ]
            }
          ]
        },
        {
          "role": "卡塔琳娜",
          "text": "好啦…你真的太严肃了，没到喝酒年纪的孩子呀，总是有奇奇怪怪的烦恼。"
        },
        {
          "role": "卡塔琳娜",
          "text": "到时候再说吧，到不得不选择的时候再说。"
        },
        {
          "role": "卡塔琳娜",
          "text": "不过现在，我要休息了…你也要睡一会儿吗？"
        },
        {
          "role": "派蒙",
          "text": "只有一张草铺，你叫我们怎么睡呀？明明是在赶我们走吧！"
        },
        {
          "role": "卡塔琳娜",
          "text": "哈哈哈哈哈！那是你们自己的问题…真可怜。"
        },
        {
          "role": "卡塔琳娜",
          "text": "不过不管怎样，我真心感谢你们帮忙。"
        },
        {
          "type": "subtitle",
          "text": "当天后续"
        },
        {
          "role": "卡塔琳娜",
          "text": "怎么？专门来打扰我休息吗？"
        },
        {
          "role": "派蒙",
          "text": "没有啦，我们就是看你一个人在这里怪孤单的，想跟你聊聊天而已！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一个人喝酒很无聊吧？",
              "dialogues": []
            },
            {
              "text": "我们特地来陪你说说话。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡塔琳娜",
          "text": "…这样吗？谢谢你们。你们这副样子呀…让我想起柳达希卡那家伙。"
        },
        {
          "role": "卡塔琳娜",
          "text": "她也是个热心人…那时候总是缠在我身边，什么话都愿意和我说…很多时候只愿意和我说。"
        },
        {
          "role": "卡塔琳娜",
          "text": "唉，如果柳达希卡也在就好咯…她是个很有趣的人，你一定会喜欢她的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "柳达希卡？那是谁？",
              "dialogues": [
                {
                  "role": "卡塔琳娜",
                  "text": "她呀…我的一个朋友，看起来很严肃的样子，其实是个有趣的笨蛋。"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "曾经在「壁炉之家」的时候我们就像姐妹一样要好…可能更胜姐妹吧。她很喜欢我的捉弄…我也很受她照顾。"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "哈哈，总之，我预感她在外面过得还不错。每每想到这点，我在这个鬼地方受的伤就都不算什么啦。"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "希望她也有在好好执行任务吧…希望她不要想起我。"
                }
              ]
            },
            {
              "text": "柳达希卡…你是说稻妻的那个…【需要完成稻妻世界任务「[[特别的御神签]]」解锁此选项】",
              "dialogues": [
                {
                  "role": "卡塔琳娜",
                  "text": "……"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "这么说，她暴露了啊…"
                },
                {
                  "role": "派蒙",
                  "text": "欸…你怎么知道…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "她…设法逃出生天了。",
                      "dialogues": []
                    },
                    {
                      "text": "她还活着，过得很好。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "卡塔琳娜",
                  "text": "是吗？"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "哈哈…那就好，希望她也在好好执行任务吧。"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "但假如她为了苟且偷生，违背了女皇陛下的意志…"
                },
                {
                  "role": "卡塔琳娜",
                  "text": "…希望她不要想起我。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          22,
          27
        ],
        [
          73,
          80
        ]
      ]
    }
  ]
}