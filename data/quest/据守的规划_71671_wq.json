{
  "quest_id": 71671,
  "chapter_num": null,
  "chapter_title": "据守的规划",
  "type": "wq",
  "route": "A Defensive Strategy",
  "stories": [
    {
      "story_id": 71671,
      "title": "据守的规划",
      "description": "成功造访了地脉紊乱点通向的秘境，并在其中经历了一番战斗，是时候向刻晴和夜兰回报情况了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与刻晴和夜兰对话"
        },
        {
          "role": "派蒙",
          "text": "呃啊，不愧是夜兰都评价棘手的秘境，真的不一般呢…"
        },
        {
          "role": "派蒙",
          "text": "也不知道这个地脉紊乱点记录的都是什么战局…一般士兵真的能应付过来吗！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "魔神战争的局部交战？",
              "dialogues": []
            },
            {
              "text": "灾变之时的极端战况？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…我猜，大概也没到…那么吓人的程度吧？"
        },
        {
          "role": "刻晴",
          "text": "你们回来了。"
        },
        {
          "role": "夜兰",
          "text": "嗯，神色从容，应该取得了不错的战果。"
        },
        {
          "role": "派蒙",
          "text": "也确实遇见了非常惊险的情况！"
        },
        {
          "role": "？？？",
          "text": "向刻晴和夜兰描述了其中的战况…"
        },
        {
          "role": "刻晴",
          "text": "原来如此…实在有劳你们了，干得漂亮！"
        },
        {
          "role": "夜兰",
          "text": "你们通过紊乱点造访秘境后，外溢的魔物显著减少了。"
        },
        {
          "role": "夜兰",
          "text": "虽然没能直接清除紊乱点，但的确有效削弱了它的活性。"
        },
        {
          "role": "刻晴",
          "text": "得益于此，魔物们的棘手程度大大降低，普通的千岩军战士也能将它们击退。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "进去一次，就明白了凶险。",
              "dialogues": []
            },
            {
              "text": "难对付的家伙，要慢慢搞定。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "怎么感觉，旅行者的斗志燃烧起来了…你还摩拳擦掌呢！"
        },
        {
          "role": "刻晴",
          "text": "刚才，送往玉京台的加急信件得到了回复，天权星和开阳星一致同意，与旅行者达成长期合作。"
        },
        {
          "role": "刻晴",
          "text": "得益于旅行者的努力，这个地脉紊乱点甚至可被我们妥善利用。"
        },
        {
          "role": "刻晴",
          "text": "此后，旅行者将获得驻军的全力支持。"
        },
        {
          "role": "刻晴",
          "text": "紊乱点活跃期间，若是旅行者有意愿，便可攻入秘境。少量外溢的魔物则由千岩军处理，给战士们轮番练手。"
        },
        {
          "role": "夜兰",
          "text": "算是转危为安，转祸为福了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那从今以后，我定然全力以赴！",
              "dialogues": []
            },
            {
              "text": "既然危险解除，我就酌情出勤！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哎呀呀，可算松了口气…"
        },
        {
          "role": "派蒙",
          "text": "话又说回来了。"
        },
        {
          "role": "派蒙",
          "text": "地脉真是个奇妙的东西，总有一天，我们得想个办法，查出它更多的秘密才行…"
        },
        {
          "role": "派蒙",
          "text": "不知道能不能遇见什么聪明人，给我们翻出一本…《地脉百科全书》来！"
        }
      ]
    }
  ]
}