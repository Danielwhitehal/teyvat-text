{
  "quest_id": 72677,
  "chapter_num": null,
  "chapter_title": "山海八所巡礼·炎炎连歌百韵",
  "type": "wq",
  "route": "Eight Locales Over Mountains and Seas: Blazing Poetry",
  "stories": [
    {
      "story_id": 72677,
      "title": "山海八所巡礼·炎炎连歌百韵",
      "description": "之前答应了五百藏「带吉法师去外面修行」的请求。派蒙似乎打算带吉法师去看看禄华池…？",
      "dialogues": [
         {
          "type": "subtitle",
          "text": "前往渌华池附近"
        },
        {
          "role": "派蒙",
          "text": "这里的景致，很特别吧！"
        },
        {
          "role": "「吉法师」",
          "text": "一层一层的水，颜色很特别呶。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙和吉法师的词汇量一样匮乏…",
              "dialogues": []
            },
            {
              "text": "吉法师的词汇量和派蒙一样丰富…",
              "dialogues": [
                {
          "role": "「吉法师」",
          "text": "和派蒙一样厉害！"
        },
         {
          "role": "派蒙",
          "text": "唔…旅行者可能不是那个意思，但总之…吉法师就是很聪明呢！哼！"
        }
              ]
            },
            {
              "text": "真的很特别呢！",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "哎？旅行者的词汇量是不是有点匮乏…"
        }
              ]
            }       
          ]
        },
        {
          "role": "派蒙",
          "text": "不过，这里的景色真的很特别呢。旅行者还记得之前那位画家吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
             {
              "text":  "梵米尔？",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "嗯！就是梵米尔！当时，咱们不是还帮他在那两个大雕像上装超级发光大珠子吗？"
        }
              ]
            },
            {
              "text": "谁啊。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "是梵米尔啦！当时，不是还帮他在那两个大雕像上装超级发光大珠子来着吗？"
        }
              ]
            }      
           
            
          ]
        },
        
        {
          "role": "派蒙",
          "text": "最后还送了一幅画给我们！"
        },
        {
          "role": "旅行者",
          "text": "是这个吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯！就是这个！吉法师，快看！"
        },
        {
          "role": "「吉法师」",
          "text": "呶！好像！是拍照吗？"
        },
        {
          "role": "派蒙",
          "text": "不是哦，是人画的。"
        },
        {
          "role": "「吉法师」",
          "text": "咦？但是、为什么人能拍照，还要画画呶？"
        },
        {
          "role": "派蒙",
          "text": "唔…是呀，旅行者，这是为什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "因为想要创造只属于自己的东西吧。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "好像很有道理的样子。"
        }
              ]
            },
            {
              "text": "因为留影机很贵。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "欸？！留影机很贵吗？那平时战斗、游泳、爬山，又从山上掉下来会不会弄坏…"
        },
        {
          "role": "派蒙",
          "text": "呜哇，不得了，以后要小心才行…"
        }
              ]
            }      
            
            
          ]
        },
        
        {
          "role": "旅行者",
          "text": "而且，自己画的东西，有很多心意。"
        },
        {
          "role": "派蒙",
          "text": "嗯，一笔一笔把自己心里想的东西画出来，很辛苦的事情呢！"
        },
        {
          "role": "「吉法师」",
          "text": "嗯…那给我拍照，是不是很容易、不辛苦，所以没有很多心意？"
        },
        {
          "role": "派蒙",
          "text": "欸！不是这样的，是因为…"
        },
        {
          "role": "旅行者",
          "text": "画画要好长时间。吉法师会累。"
        },
        {
          "role": "派蒙",
          "text": "对对！画画要好长时间的，吉法师要是一直保持一个姿势，会很累。"
        },
        {
          "role": "「吉法师」",
          "text": "以前被封印变成石头的时候，就一直站着。"
        },
        {
          "role": "「吉法师」",
          "text": "所以，挣脱封印以后，好长时间里，脚好难受。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，听起来就觉得好辛苦…"
        },
        {
          "role": "「吉法师」",
          "text": "但是，派蒙可以飞飞。应该脚不会累。"
        },
        {
          "role": "派蒙",
          "text": "喂！飞的时候，全身的幻肢都在运动，很累的。"
        },
        {
          "role": "「吉法师」",
          "text": "哇！着火的花！"
        },
        {
          "role": "派蒙",
          "text": "好好听人说话啦…"
        },
        {
          "role": "旅行者",
          "text": "烈焰花？"
        },
        {
          "role": "派蒙",
          "text": "对喔，在镇守之森好像确实没怎么见过烈焰花…"
        },
        {
          "role": "派蒙",
          "text": "吉法师想要吗？"
        },
        {
          "role": "「吉法师」",
          "text": "想要！看上去很暖和。"
        },
        {
          "role": "派蒙",
          "text": "那要好好拜托旅行者喔！"
        },
        {
          "role": "「吉法师」",
          "text": "旅行者，想要。谢谢。"
        },
        {
          "role": "派蒙",
          "text": "…感觉也不是很有诚意。还是说，妖狸说话就是这种风格…"
        },
        {
          "type": "subtitle",
          "text": "将1个「烈焰花花蕊」交给吉法师"
        },
        {
          "role": "「吉法师」",
          "text": "好温暖。"
        },
        {
          "role": "「吉法师」",
          "text": "如果去雪山的时候，有烈焰花就好了哩。"
        },
        {
          "role": "派蒙",
          "text": "这么说来，当时确实应该准备一些保暖的东西…"
        },
        {
          "role": "「吉法师」",
          "text": "派蒙，如果有很大的这种花，能不能把雪山变得没有雪？"
        },
        {
          "role": "派蒙",
          "text": "恐、恐怕不太能吧…"
        },
        {
          "role": "「吉法师」",
          "text": "呶。"
        },
        {
          "role": "旅行者",
          "text": "可以带吉法师看「很大的烈焰花」。"
        },
        {
          "role": "派蒙",
          "text": "欸，说的难道是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "附近就有爆炎树。",
            "我们出发吧。"
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！就当吉法师今天的修行吧！"
        },
        {
          "type": "subtitle",
          "text": "前往爆炎树所在的洞窟深处"
        },
        {
          "role": "「吉法师」",
          "text": "好大喔！好热！竟然有这么大的着火的花！"
        },
        {
          "role": "派蒙",
          "text": "对吧！啊，对了…"
        },
        {
          "role": "派蒙",
          "text": "吉法师你等一下，我们给你拍照！"
        },
        {
          "role": "旅行者",
          "text": "在这么热的地方？"
        },
        {
          "role": "派蒙",
          "text": "就是这么热才好！"
        },
        {
          "role": "「吉法师」",
          "text": "呜呶呶…好…"
        },
        {
          "type": "subtitle",
          "text": "为吉法师拍照"
        },
        {
          "role": "「吉法师」",
          "text": "呜呶呶…好热…"
        },
        {
          "role": "派蒙",
          "text": "哼哼，吉法师，这下知道了吧！"
        },
        {
          "role": "「吉法师」",
          "text": "呶？"
        },
        {
          "role": "旅行者",
          "text": "知道什么了？"
        },
        {
          "role": "派蒙",
          "text": "如果是画画的话，就要花更多时间了！"
        },
        {
          "role": "派蒙",
          "text": "所以，选择拍照，而不是画画，并不是因为缺乏心意，而是体贴！是体贴啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "是这样的用意喔！",
            "莫名其妙！",
            "虽然道理没错，但是真的好热…"
          ]
        },
        {
          "role": "「吉法师」",
          "text": "明白了。拍照，好。好热喔…"
        },
        {
          "role": "旅行者",
          "text": "我去把热源快速处理掉。很快就好。"
        },
        {
          "role": "「吉法师」",
          "text": "呜呶呶…"
        },
         {
          "type": "subtitle",
          "text": "击败爆炎树"
        },
         {
          "type": "subtitle",
          "text": "与吉法师对话"
        },
        {
          "role": "「吉法师」",
          "text": "旅行者好厉害！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "还好。",
            "还好。和这种东西战斗很多次了。"
          ]
        },
        {
          "role": "「吉法师」",
          "text": "旅行者、派蒙，经常打吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯…仔细一想，虽然我们旅行的目的是找到失散的亲人，但旅途中总是在战斗呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "还好。我很喜欢打架。",
            "战斗麻烦死了。"
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…虽然有斗志是好事，但不要把这种事情当成爱好比较好吧？"
        },
        {
          "role": "「吉法师」",
          "text": "等我变成大妖狸，也要像旅行者这么厉害。"
        },
        {
          "role": "派蒙",
          "text": "吉法师一定没问题的！但是，要答应派蒙…"
        },
        {
          "role": "「吉法师」",
          "text": "派蒙说。"
        },
        {
          "role": "派蒙",
          "text": "嗯…咳咳！吉法师就算变成比五百藏还厉害的妖狸大王，也不要欺负弱小。然后，也不要随便打架。"
        },
        {
          "role": "派蒙",
          "text": "不能像那个好大好大的、着火的花那样，看到旅行者就冒出来扭来扭去喷火！"
        },
        {
          "role": "「吉法师」",
          "text": "那，要什么时候才能打打？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "保护自己的时候…",
            "保护别人的时候…",
            "守护正确的事情的时候…"
          ]
        },
        {
          "role": "「吉法师」",
          "text": "呶…虽然不是很明白，不过，我答应派蒙。不欺负弱小，也不随便打架。"
        },
        {
          "role": "派蒙",
          "text": "嗯，吉法师真乖。"
        },
        {
          "role": "派蒙",
          "text": "接下来…应该就是五百藏决定的，去八个地方修行的最后一站了呢…"
        },
        {
          "role": "「吉法师」",
          "text": "呶…"
        }
      ]
    }
  ]
}