{
  "quest_id": 71670,
  "chapter_num": null,
  "chapter_title": "肃靖险乱",
  "type": "wq",
  "route": "Tumult Subduer",
  "stories": [
    {
      "story_id": 71670,
      "title": "肃靖险乱",
      "description": "冒险家协会捎来情报，璃月的地中之盐一带似乎发生了某种异动，千岩军已将现场封锁，你与派蒙打算前往现场一探究竟…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往地中之盐一带"
        },
        {
          "role": "派蒙",
          "text": "唔…不太对劲啊，远处那个地脉淤积的烟团，越看越邪门，它就是异常魔物的来源吗？"
        },
        {
          "role": "派蒙",
          "text": "看起来，千岩军专门为它建造了一个营地，还有好多巡逻的士兵和工事！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "以前好像见过类似的淤积点。",
              "dialogues": []
            },
            {
              "text": "我们提高警惕，准备战斗吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！就按以前的惯例办事吧——我们和千岩军并肩作战，把所有魔物咚咚打翻，然后想办法处理掉淤积点！"
        },
        {
          "role": "方谨",
          "text": "两位旅人，前方危险，请止步。"
        },
        {
          "role": "方谨",
          "text": "等等…这种气势…莫非你是旅行者教头？"
        },
        {
          "role": "派蒙",
          "text": "咦？旅行者，你难道趁我睡着的时候去千岩军打工了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我吗？不可思议…",
              "dialogues": []
            },
            {
              "text": "教头竟是我自己！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "方谨",
          "text": "我叫方谨，是这支千岩军分队的领队。我曾听苏定参谋提到你，苏定说，你是百年难遇的将才。"
        },
        {
          "role": "方谨",
          "text": "情报也显示，西风骑士团的荣誉骑士在紧急时刻享有队长级的指挥权，那于情于理，也要尊称你一声教头。"
        },
        {
          "role": "方谨",
          "text": "正事要紧，请两位跟我去见玉衡大人。"
        },
        {
          "role": "派蒙",
          "text": "刻晴居然也在？"
        },
        {
          "role": "派蒙",
          "text": "那事情好像不简单了呢，看来不能直接抡拳头解决了…"
        },
        {
          "role": "方谨",
          "text": "玉衡大人，果然如您所料，旅行者与他的副官派蒙来访了。"
        },
        {
          "role": "刻晴",
          "text": "有劳了，方谨。"
        },
        {
          "role": "刻晴",
          "text": "好久不见，旅行者，你果然还是老样子，得到消息就火速赶来前线。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没错，本将来帮忙！",
              "dialogues": []
            },
            {
              "text": "没那么夸张，但也会尽力！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "刻晴",
          "text": "那我就长话短说了。"
        },
        {
          "role": "刻晴",
          "text": "多年以来，这里的地脉淤积点一直很稳定，但不知为什么，最近它突然异常活跃，引发了数次魔物袭击事件。"
        },
        {
          "role": "刻晴",
          "text": "而且，清除外溢的魔物后，这个紊乱点不会消散，还能将接触它的人送往奇异的秘境，这种情况前所未见。"
        },
        {
          "role": "派蒙",
          "text": "太古怪了，难不成，这个地脉淤积点…成了某种意义上的锚点？"
        },
        {
          "role": "派蒙",
          "text": "那只凭目前的兵力？是不是有点不够？应该尽快呼叫增援吧！"
        },
        {
          "role": "刻晴",
          "text": "这倒不用担心，目前的防线非常稳定，将士们都来自归离原方向的精锐部队，经验丰富，说句以一当百都不夸张。"
        },
        {
          "role": "刻晴",
          "text": "真正的麻烦之处在于，要是找不到地脉紊乱的根本原因，长期在此驻军作战，只会白白消耗人力物力，使部队疲惫磨损。"
        },
        {
          "role": "刻晴",
          "text": "用兵讲究精准节俭，直击要害，一味被动防御，永远无法赢得胜利。"
        },
        {
          "role": "派蒙",
          "text": "说的有道理…总是挨了打才反击，让人感觉不踏实，很不爽！"
        },
        {
          "role": "刻晴",
          "text": "夜兰已经领着部下进入秘境调查了，再过几个时辰，应该就能带着关键情报归来。"
        },
        {
          "role": "夜兰",
          "text": "啊呀，不好意思，我是不是应当适当放慢步调，让玉衡大人和旅行者先聊个尽兴…"
        },
        {
          "role": "派蒙",
          "text": "呜啊！什么时候出现的，夜兰！"
        },
        {
          "role": "刻晴",
          "text": "这个速度，是进展不顺吗？"
        },
        {
          "role": "夜兰",
          "text": "悲喜参半吧。"
        },
        {
          "role": "夜兰",
          "text": "好消息是，大致的状况已有眉目——这次的异象，属于地脉紊乱的余威。"
        },
        {
          "role": "夜兰",
          "text": "通过调查已有样本，对照战史记载，我能确定，地脉正在秘境中重现它所记录的惨烈战局，外溢的魔物大抵也是。"
        },
        {
          "role": "旅行者",
          "text": "地脉紊乱…"
        },
        {
          "role": "夜兰",
          "text": "耳熟吗？那就对了。"
        },
        {
          "role": "夜兰",
          "text": "我手头的情报显示，蒙德境内也发生过类似的异动。"
        },
        {
          "role": "夜兰",
          "text": "好在当时的情况不算严重，荣誉骑士与某位暗夜英雄通力合作，不断清除地脉淤积点外放的魔物…"
        },
        {
          "role": "夜兰",
          "text": "最终成功耗尽其中储存的「信息」，使地脉恢复了正常。可以说，无异于打赢了一场消耗战。"
        },
        {
          "role": "派蒙",
          "text": "原来这两个家伙属于同样的麻烦…难怪都红红的，看着像是一棵树上结出来的果子！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哪位荣誉骑士啊？干得好喔！",
              "dialogues": []
            },
            {
              "text": "还有这一回事？想不起来！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "不错哦，旅行者。你还是擅长用轻松写意的态度，来给合作的对象暗示，为自己争取更好的价码。这一次，你绝不会失望。"
        },
        {
          "role": "派蒙",
          "text": "欸？怎么开始听不懂了！"
        },
        {
          "role": "刻晴",
          "text": "接下来就是坏消息了吧，夜兰？"
        },
        {
          "role": "夜兰",
          "text": "嗯，显而易见，这次的地脉紊乱点与以往的孤例不同，仅仅处理外溢的魔物是不够的。"
        },
        {
          "role": "夜兰",
          "text": "要是不直接抵达秘境的最深处，清除特定情境下的所有魔物，战局会不断重演，没有尽头。"
        },
        {
          "role": "夜兰",
          "text": "而且，紊乱点通向的秘境之中，似乎有着某种特殊规则，在提防我与其他将士，拒绝我们探查它的根源。"
        },
        {
          "role": "夜兰",
          "text": "起初，我们还能对其中的物品取样分析，但进入纵深区域后，将士们都感到身体虚弱，无法发挥正常力量。"
        },
        {
          "role": "夜兰",
          "text": "盘踞其中的魔物则加倍凶恶，甚至展现出全新的特质，相当棘手。"
        },
        {
          "role": "夜兰",
          "text": "似乎只有很少受到地脉制约的人，才能摆脱干扰，洞察其中的独特规则…"
        },
        {
          "role": "夜兰",
          "text": "由这样的将才领兵，应当足以克服险恶的环境，直击地脉紊乱的要害。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这下我听懂了！",
              "dialogues": []
            },
            {
              "text": "除了我好像确实没别人了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "刻晴",
          "text": "也就是说，要么选择在外防御魔物，直到紊乱点周期性停止活跃。"
        },
        {
          "role": "刻晴",
          "text": "要么由旅行者领兵，攻入其中，随机应变，压制异动的根源…"
        },
        {
          "role": "刻晴",
          "text": "明白了，我会做两手打算——"
        },
        {
          "role": "刻晴",
          "text": "稍后，我会联络凝光，为此地投入更多防务资金。同时，与开阳星商议，尽快安排后续的轮岗部队。"
        },
        {
          "role": "派蒙",
          "text": "咦？我以为刻晴会直接拜托旅行者解决这个大麻烦呢！"
        },
        {
          "role": "刻晴",
          "text": "守护璃月的安定，是千岩军和七星的使命；不让将士们无端冒险，是指挥者的职责。"
        },
        {
          "role": "刻晴",
          "text": "但于公于私，我都不希望你一人担下全部危险。"
        },
        {
          "role": "刻晴",
          "text": "所以，如果你不愿意涉险，就由千岩军长期布防，安排多支部队轮换作战，以练兵的形式清剿魔物。"
        },
        {
          "role": "刻晴",
          "text": "同时持续派出斥候，收集秘境中的情报，不断了解它的特性，争取在将来某天组织部队，一举将它平定。"
        },
        {
          "role": "刻晴",
          "text": "当然，如果你有参战的想法，我也支持你，会让驻防部队全力支援你。"
        },
        {
          "role": "刻晴",
          "text": "一旦有效遏制地脉的紊乱，我将以战功为依据，给你应得的酬劳。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "于公于私，我都要帮忙才对！",
              "dialogues": []
            },
            {
              "text": "我也有很多并肩战斗的伙伴！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没错哦，无论作为璃月人的好伙伴、王牌冒险家搭档，还是刻晴和夜兰的朋友，我们都不能坐视不管。"
        },
        {
          "role": "派蒙",
          "text": "而且，我们完全不担心报酬的事，刻晴和夜兰无论如何都不会亏待我们！"
        },
        {
          "role": "刻晴",
          "text": "眼神认真起来了…"
        },
        {
          "role": "刻晴",
          "text": "气势很棒！那我们就这样达成合作吧。"
        },
        {
          "role": "刻晴",
          "text": "夜兰，通知你的部下，准备协助旅行者深入秘境作战。"
        },
        {
          "role": "夜兰",
          "text": "稍等，我要分析片刻，地脉紊乱点的情况会周期性变化，还需谨慎入场。"
        },
        {
          "role": "夜兰",
          "text": "旅行者也能趁此间隙调整状态，组建你的精锐小队，准备迎接此前少见的鏖战吧。"
        },
        {
          "role": "夜兰",
          "text": "时机不错，抓准目前的窗口，应当能深入秘境的关键区域…"
        },
        {
          "role": "夜兰",
          "text": "前提是找准沿途的「规则」，以得当的方式击败强敌。"
        },
        {
          "role": "刻晴",
          "text": "请保持谨慎和敏锐，时刻关注周围环境，还有己方的情况。"
        },
        {
          "role": "刻晴",
          "text": "状况不妙时，暂时撤退，重整态势也无妨，请别勉强自己。"
        },
        {
          "role": "刻晴",
          "text": "等你凯旋。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一定尽力而为！",
              "dialogues": []
            },
            {
              "text": "我会努力战斗！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！刻晴和夜兰，等着我们的好消息哦！"
        },
        {
          "type": "subtitle",
          "text": "通过紊乱点前往秘境"
        },
        {
          "role": "夜兰",
          "text": "看来，经过之前的一番波动，这个紊乱点暂时安定下来了。"
        },
        {
          "role": "刻晴",
          "text": "不过，异象尚未完全消除，一段时间后，它必定会重归活跃。"
        },
        {
          "role": "刻晴",
          "text": "但无论如何，也算是有了难得的空档期，趁这个功夫好好休憩一番，为下次战斗做好准备吧。"
        },
        {
          "role": "派蒙",
          "text": "好，我们会认认真真，做好功课的！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，借着这个机会，我们吃饱喝足，好好休息，养足精神！再仔细思考一下战术和对策！"
        },
        {
          "role": "夜兰",
          "text": "时机不错，抓准目前的窗口，应当能深入秘境的关键区域…"
        },
        {
          "role": "夜兰",
          "text": "前提是找准沿途的「规则」，以得当的方式击败强敌。"
        },
        {
          "role": "刻晴",
          "text": "请保持谨慎和敏锐，时刻关注周围环境，还有己方的情况。"
        },
        {
          "role": "刻晴",
          "text": "状况不妙时，暂时撤退，重整态势也无妨，请别勉强自己。"
        },
        {
          "role": "刻晴",
          "text": "等你凯旋。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一定尽力而为！",
              "dialogues": []
            },
            {
              "text": "我会努力战斗！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！刻晴和夜兰，等着我们的好消息哦！"
        }
      ]
    }
  ]
}