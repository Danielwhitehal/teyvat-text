{
  "quest_id": 21000,
  "chapter_num": null,
  "chapter_title": "哎呀！海盗想长大！",
  "type": "iq",
  "route": "Ahoy! A Pirate's Growth for Ye!",
  "stories": [
    {
      "story_id": 21000,
      "title": "哎呀！海盗想长大！",
      "description": "璃月港的小蒙，最近有些烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与小蒙对话"
        },
        {
          "role": "小蒙",
          "text": "唉，我真的能做到吗…"
        },
        {
          "role": "旅行者",
          "text": "小蒙，你怎么了？"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，是你啊…你好。"
        },
        {
          "role": "派蒙",
          "text": "小蒙，你怎么看着有些不开心呀？"
        },
        {
          "role": "派蒙",
          "text": "怎么了？是他们不和你玩那个…海盗游戏了吗？"
        },
        {
          "role": "小蒙",
          "text": "欸？不是，璐璐和阿飞他们是回家去了。"
        },
        {
          "role": "小蒙",
          "text": "我…是想要自己出去逛逛，所以才暂时没回家。"
        },
        {
          "role": "派蒙",
          "text": "这样你父母不会担心吗？"
        },
        {
          "role": "小蒙",
          "text": "现在这个时间，我爸妈应该还在工作没回家呢。"
        },
        {
          "role": "小蒙",
          "text": "不说这个，大哥哥，我能问你个问题吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么问题？",
              "dialogues": []
            },
            {
              "text": "我暂时没空陪你玩…",
              "dialogues": [
                {
                  "role": "小蒙",
                  "text": "哈哈哈，那个游戏我也是陪着璐璐和阿飞玩啦，他们不在，我也不会特意去玩的。"
                }
              ]
            }
          ]
        },
        {
          "role": "小蒙",
          "text": "大哥哥，我听很多人说起过你的事情。"
        },
        {
          "role": "小蒙",
          "text": "我觉得，你去过很多地方，也经历过很多事…说不定能告诉我这个问题的答案…"
        },
        {
          "role": "派蒙",
          "text": "呜哇…小蒙突然这么严肃了，到底是什么问题呀？"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，我想问你…"
        },
        {
          "role": "小蒙",
          "text": "一个人到底怎么样，才能变得「成熟」呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "需要用时间来成长。",
              "dialogues": [
                {
                  "role": "小蒙",
                  "text": "你是说，只要长大了，人就会自然而然地变成熟吗？"
                },
                {
                  "role": "小蒙",
                  "text": "可是，长大了之后再成熟，会不会有点太晚了呢…"
                }
              ]
            },
            {
              "text": "需要经历特别的事。",
              "dialogues": [
                {
                  "role": "小蒙",
                  "text": "要经历特别的事…可我到现在，连璃月港都没踏出去过…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…如果你是想要出城看看的话，我们可以陪你出去逛逛呀。"
        },
        {
          "role": "小蒙",
          "text": "那也太麻烦你们了，而且…只是出城的话，我应该也不会有什么特别的收获吧…"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，我想请你们帮我另一个忙…"
        },
        {
          "role": "小蒙",
          "text": "我听人家说，如果有解决不了的烦恼，可以把烦恼写下来放进漂流瓶里，让烦恼随着河水飘出去…"
        },
        {
          "role": "小蒙",
          "text": "这样子，说不定烦恼就会得到解决。"
        },
        {
          "role": "小蒙",
          "text": "但我听说，外面有很多魔物，我一个人去有些不太安全。"
        },
        {
          "role": "小蒙",
          "text": "所以，我想要拜托大哥哥保护一下我…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "交给我吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "小蒙",
          "text": "谢谢大哥哥。我会付你报酬的，都是我自己攒的钱。"
        },
        {
          "role": "小蒙",
          "text": "那我们出发吧，先去碧水河边看看。"
        },
        {
          "type": "subtitle",
          "text": "前往碧水河附近"
        },
        {
          "role": "小蒙",
          "text": "已经快到碧水河了吗？唔…我们挑个好地方把漂流瓶放出去吧。"
        },
        {
          "role": "小蒙",
          "text": "如果想让漂流瓶漂远一些的话，应该要挑一个上游的位置…"
        },
        {
          "type": "subtitle",
          "text": "与小蒙对话"
        },
        {
          "type": "subtitle",
          "text": "寻找放出漂流瓶的地方"
        },
        {
          "type": "subtitle",
          "text": "查看甜甜花"
        },
        {
          "type": "subtitle",
          "text": "打倒骗骗花"
        },
        {
          "type": "subtitle",
          "text": "与小蒙对话"
        },
        {
          "type": "subtitle",
          "text": "与小蒙对话"
        },
        {
          "role": "小蒙",
          "text": "居然…居然有这种东西…吓死我了…"
        },
        {
          "role": "小蒙",
          "text": "谢谢你，大哥哥，我们继续…"
        },
        {
          "role": "小蒙",
          "text": "欸？我…我的漂流瓶呢？刚刚还在我身上的，不见了！"
        },
        {
          "role": "小蒙",
          "text": "难道是刚才被那个…那个骗骗花袭击的时候，掉在哪里了？"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，拜托你帮我找找吧。"
        },
        {
          "type": "subtitle",
          "text": "寻找漂流瓶"
        },
        {
          "type": "subtitle",
          "text": "将漂流瓶带给小蒙"
        },
        {
          "type": "subtitle",
          "text": "将漂流瓶带给小蒙"
        },
        {
          "role": "小蒙",
          "text": "漂流瓶掉在哪了…"
        },
        {
          "role": "小蒙",
          "text": "太好了…我昨天晚上可是写了一晚上，弄丢的话，我就要重写了…"
        },
        {
          "role": "派蒙",
          "text": "呜哇…你有那么多烦恼吗？怎么会写一整个晚上呀？"
        },
        {
          "role": "小蒙",
          "text": "也…也不是有很多烦恼啦。我就只是想知道，怎么样才能变成熟啦。"
        },
        {
          "role": "小蒙",
          "text": "我查了很多资料，也看了很多书，但越是看书，我想不明白的事反而越多了…"
        },
        {
          "role": "小蒙",
          "text": "嘿嘿，所以我就把所有不明白的问题都写进去了，希望能得到答案。"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，我们快点去把漂流瓶放出去吧。"
        },
        {
          "type": "subtitle",
          "text": "跟随小蒙放出漂流瓶"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，你找到漂流瓶了吗？"
        },
        {
          "type": "subtitle",
          "text": "与小蒙对话"
        },
        {
          "role": "小蒙",
          "text": "这里看起来很合适，大哥哥，我们就在这里放出漂流瓶吧。"
        },
        {
          "role": "小蒙",
          "text": "希望…我的问题能够得到解答…"
        },
        {
          "role": "旅行者",
          "text": "应该会的。"
        },
        {
          "role": "小蒙",
          "text": "大哥哥，我们先回城里去吧。"
        },
        {
          "role": "派蒙",
          "text": "不过，就是放了个漂流瓶，小蒙的问题真的能得到解答吗…"
        },
        {
          "role": "旅行者",
          "text": "也许只是找个心理安慰吧。"
        },
        {
          "role": "派蒙",
          "text": "欸…是这样吗？总感觉小蒙还有很多心事没告诉我们呢…"
        },
        {
          "role": "派蒙",
          "text": "「如何变成熟」这个问题，还真是让人为难啊。"
        },
        {
          "type": "subtitle",
          "text": "送小蒙回璃月港"
        },
        {
          "type": "subtitle",
          "text": "与小蒙对话"
        },
        {
          "role": "小蒙",
          "text": "好了，今天谢谢你了，大哥哥。"
        },
        {
          "role": "小蒙",
          "text": "这些东西是给你的，请你收下吧。"
        },
        {
          "role": "小蒙",
          "text": "对了，今天的事情还请你向璐璐和阿飞保密。"
        },
        {
          "role": "小蒙",
          "text": "这是我一个人的烦恼，可别让他们也跟着不开心了。"
        },
        {
          "role": "小蒙",
          "text": "好了，我要回家去了，再见了，大哥哥。"
        }
      ]
    }
  ]
}