{
  "quest_id": 71057,
  "chapter_num": null,
  "chapter_title": "失踪的矿工",
  "type": "wq",
  "route": "The Missing Miner",
  "stories": [
    {
      "story_id": 71057,
      "title": "失踪的矿工",
      "description": "没有蘑菇肉便不愿意离开，为了将老何带回营地，还是与他一起去收集他口中的「蘑菇肉」吧…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "阅读工作手册"
        },
        {
          "type": "subtitle",
          "text": "工作手册"
        },
        {
          "type": "subtitle",
          "text": "（一本工作手册，封面上写着「老何」，大概是手册主人的名字。）",
          "narration": true
        },
        {
          "role": "（手册的前几页上写着",
          "text": "）"
        },
        {
          "type": "subtitle",
          "text": "「…戚定找那个以前送闺女的玩具找了半天，哪都没有，明天只能到矿深处帮他找找了…」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「…耳朵好痒…」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「…耳朵好痒，痒死了，痒死了，耳朵…真是烦啊，快没东西吃了，那个声音说…但是，这个蘑菇到底能不能吃…」",
          "narration": true
        },
        {
          "role": "后几页里写着",
          "text": "「…能听见，能听见，嘿嘿，蘑菇肉…嘿嘿嘿…蘑菇肉，好吃…嘿嘿嘿，蘑菇肉…」"
        },
        {
          "type": "subtitle",
          "text": "背后突然传来话语声：",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "「嘿嘿嘿…蘑菇肉…嘿嘿嘿…」",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "？？？",
          "text": "你们，嘿嘿嘿，怎么会出现在这里呀？"
        },
        {
          "role": "派蒙",
          "text": "呜哇！这人的脸色好奇怪啊！"
        },
        {
          "role": "派蒙",
          "text": "而且，旅行者，这个人从背后靠近的时候没发出一点声音…"
        },
        {
          "role": "派蒙",
          "text": "不会是…"
        },
        {
          "role": "旅行者",
          "text": "应该不是吧。"
        },
        {
          "role": "？？？",
          "text": "嘿嘿嘿…你们怎么…在这里。"
        },
        {
          "role": "？？？",
          "text": "你们的吃的，也吃光了吗？"
        },
        {
          "role": "旅行者",
          "text": "难道你就是老何？"
        },
        {
          "role": "？？？",
          "text": "啊…什么呀？年轻人，你们说的啥呀，听不清。"
        },
        {
          "role": "派蒙",
          "text": "我们在问！你是老何吗！"
        },
        {
          "role": "老何",
          "text": "哦哦，是啊，嘿嘿嘿，我就是老何。"
        },
        {
          "role": "老何",
          "text": "你们…不会是和我一样被困在下面，把吃的吃光了吧…欸呀，你的运气也不太好啊…"
        },
        {
          "role": "老何",
          "text": "嘿嘿嘿，不过没关系，我这里有吃的…饿了很久了吧…嘿嘿嘿…"
        },
        {
          "role": "派蒙",
          "text": "这么说来确实有点饿了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "蘑菇肉可不能乱吃！",
              "dialogues": []
            },
            {
              "text": "别乱吃危险的东西啦！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对、对哦，他看上去精神恍惚，脸色还…那么奇怪，不会就是因为吃蘑菇肉导致的吧！"
        },
        {
          "role": "老何",
          "text": "蘑菇肉？嘿嘿嘿，蘑菇肉可好吃了。"
        },
        {
          "role": "老何",
          "text": "来，老何给你们一些蘑菇肉…"
        },
        {
          "role": "老何",
          "text": "嘿嘿嘿蘑菇肉…咦，怎么…"
        },
        {
          "role": "派蒙",
          "text": "怎么了？"
        },
        {
          "role": "老何",
          "text": "蘑菇肉，没了！"
        },
        {
          "role": "派蒙",
          "text": "那就不要管什么蘑菇肉了，我们先一起回营地吧！"
        },
        {
          "role": "老何",
          "text": "不行，没有蘑菇肉了！"
        },
        {
          "role": "老何",
          "text": "没有蘑菇肉，就没力气走路，我哪也不去…没了蘑菇肉…这里其他地方都没有吃的。"
        },
        {
          "role": "老何",
          "text": "有了蘑菇肉，哪都能去！"
        },
        {
          "role": "派蒙",
          "text": "那…哪里有这种蘑菇肉呢？"
        },
        {
          "role": "老何",
          "text": "蘑菇肉…嘿嘿嘿…我知道哪里有蘑菇肉，我们来弄些蘑菇肉吃，这样就有力气做事了。"
        },
        {
          "role": "老何",
          "text": "就在这附近…"
        },
        {
          "role": "派蒙",
          "text": "没办法了，旅行者，我们先找些蘑菇肉给他吃吧！"
        },
        {
          "role": "旅行者",
          "text": "看来只能如此了。"
        },
        {
          "role": "老何",
          "text": "蘑菇肉…嘿嘿嘿…大蘑菇肉…"
        },
        {
          "type": "subtitle",
          "text": "与老何一起前往收集「蘑菇肉」"
        },
        {
          "role": "老何",
          "text": "对，就是这种蘑菇肉…多采点，多采点。嘿嘿…"
        },
        {
          "role": "派蒙",
          "text": "嗯？不对，周围怎么出现了这么多的蘑菇怪啊！"
        },
        {
          "role": "老何",
          "text": "嘿嘿嘿…蘑菇怪，蘑菇肉，好吃，嘿嘿嘿…"
        },
        {
          "role": "派蒙",
          "text": "这也能算在蘑菇肉里吗！"
        },
        {
          "type": "subtitle",
          "text": "击败蕈兽"
        },
        {
          "role": "派蒙",
          "text": "危险了，这些蕈兽怎么感觉源源不断地从地里钻出来…"
        },
        {
          "role": "老何",
          "text": "蘑菇怪…嘿嘿，来得好！"
        },
        {
          "type": "subtitle",
          "text": "过场动画：老何出手",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "一下子就全部解决了？"
        },
        {
          "role": "派蒙",
          "text": "老何…好强！"
        },
        {
          "role": "老何",
          "text": "嘿嘿嘿…蘑菇肉，蘑菇肉…"
        },
        {
          "role": "老何",
          "text": "自从吃了蘑菇肉，我腰也不疼了，手上也有劲了，嘿嘿嘿，感觉自己年轻了好几岁啊！"
        },
        {
          "role": "老何",
          "text": "蘑菇肉怪比蘑菇肉好吃，蘑菇肉，越大越好吃…嘿嘿嘿…"
        },
        {
          "role": "派蒙",
          "text": "难道，老何是吃了这些蘑菇肉之后才变得那么厉害的吗？"
        },
        {
          "role": "派蒙",
          "text": "旅行者，只要吃就能变强，我们也吃几个吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你只是想吃蘑菇肉吧！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我只是好奇是什么味道的嘛。"
                }
              ]
            },
            {
              "text": "不许乱吃！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我、我知道啦。"
        },
        {
          "role": "派蒙",
          "text": "不过这下老何应该愿意跟我们一起回去了吧！"
        },
        {
          "role": "老何",
          "text": "蘑菇肉…嘿嘿，好吃！"
        },
        {
          "role": "派蒙",
          "text": "老何！我们一起回营地吧！"
        },
        {
          "role": "老何",
          "text": "啊？一起？好啊，你们也来一起吃啊，这些蘑菇肉，嘿嘿嘿，风干之后可以吃很久…很久…"
        },
        {
          "role": "派蒙",
          "text": "是一起回营地啦！"
        },
        {
          "role": "老何",
          "text": "回阴地？阴地是什么地方，不过好呀…嘿嘿嘿…吃了蘑菇肉，我哪都能去。"
        },
        {
          "role": "派蒙",
          "text": "唉…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们还是快点把老何带回去见瑾武姐吧。"
        },
        {
          "type": "subtitle",
          "text": "将老何带回营地见瑾武"
        },
        {
          "role": "老何",
          "text": "蘑菇肉…嘿嘿…好好吃了一顿蘑菇肉，小蘑菇，蘑菇怪，大蘑菇…嘿嘿…"
        },
        {
          "role": "瑾武",
          "text": "老何？你脸色怎么这么怪啊！"
        },
        {
          "role": "瑾武",
          "text": "唉…我就知道你这家伙肯定还活着！你们家里人还请我吃席，我那个时候就说，没见到遗体，吃什么席！"
        },
        {
          "role": "瑾武",
          "text": "脸色看上去那么差，肯定在矿里吃了不少苦，不过、不过活着就好呀！"
        },
        {
          "role": "老何",
          "text": "活得好！活的蘑菇好吃…嘿嘿…"
        },
        {
          "role": "瑾武",
          "text": "老何？"
        },
        {
          "role": "派蒙",
          "text": "我们发现他的时候就已经是这样了。"
        },
        {
          "role": "派蒙",
          "text": "有点疯疯癫癫的…总是嚷嚷着要吃蘑菇。"
        },
        {
          "role": "瑾武",
          "text": "蘑菇…"
        },
        {
          "role": "瑾武",
          "text": "层岩巨渊下面的环境对于普通人来说很是凶险，生长的菌类和植物说不定也对人有害，所以辉山厅是严禁矿工进食那些东西的。"
        },
        {
          "role": "瑾武",
          "text": "但这几年老何一直在矿里，这样也是迫于无奈。"
        },
        {
          "role": "瑾武",
          "text": "变成这种模样，我该怎么和他的家里人交待呀。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "如果是蘑菇…",
              "dialogues": []
            },
            {
              "text": "有研究蘑菇的人在吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑾武",
          "text": "这么说来，海迪夫说不定有什么办法，毕竟是须弥的学者，对蘑菇肯定有研究。"
        },
        {
          "role": "瑾武",
          "text": "你们在这稍等下，我去把海迪夫叫来看看老何的情况。"
        },
        {
          "role": "老何",
          "text": "蘑菇肉…蘑菇肉…"
        },
        {
          "role": "派蒙",
          "text": "唉，真不知道老何这样还能不能恢复。"
        },
        {
          "role": "派蒙",
          "text": "要是一直这样，就算回去了，他家人也不会高兴吧。"
        },
        {
          "role": "老何",
          "text": "蘑菇肉…蘑菇肉…"
        },
        {
          "role": "海迪夫",
          "text": "我会认真考虑减少你们部分报酬的提案的。"
        },
        {
          "role": "瑾武",
          "text": "报酬的问题怎么样都好。"
        },
        {
          "role": "瑾武",
          "text": "你先看下这个人的情况…"
        },
        {
          "role": "老何",
          "text": "耳朵好痒…嘿嘿…"
        },
        {
          "role": "海迪夫",
          "text": "嗯？这是什么人！他脸色怎么那么奇怪啊！"
        },
        {
          "role": "海迪夫",
          "text": "旅行者，这人是你找回来的？你怎么总能碰到神奇的事啊…"
        },
        {
          "role": "海迪夫",
          "text": "那么…发现他的时候是什么情况呢？"
        },
        {
          "type": "subtitle",
          "text": "向海迪夫说明了与老何有关的事…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "海迪夫仔细检查了老何。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "海迪夫",
          "text": "还好还好，没什么大碍。"
        },
        {
          "role": "海迪夫",
          "text": "你看，他不是一直说自己的耳朵痒吗，那是因为这种菌类的孢子进入了耳道导致的。"
        },
        {
          "role": "海迪夫",
          "text": "而这种真菌…啊，也就是这种蘑菇虽然长期食用确实会让人精神失常，不过对于人体来说的损害没有那么大。"
        },
        {
          "role": "瑾武",
          "text": "也就是说，他能够恢复？"
        },
        {
          "role": "海迪夫",
          "text": "我已经帮他清理了身上的真菌，也做了能让紊乱的神经恢复下来的药。"
        },
        {
          "role": "海迪夫",
          "text": "只要好好休息，恢复的可能性还是很大的。"
        },
        {
          "role": "瑾武",
          "text": "那这样，做药的钱…"
        },
        {
          "role": "海迪夫",
          "text": "药的原材料还是很便宜的，只够在新月轩连吃一个月，算不上什么大钱。"
        },
        {
          "role": "瑾武",
          "text": "呃…我会想办法筹给你的…"
        },
        {
          "role": "海迪夫",
          "text": "这点钱就不用给了，倒是我的报告又可以添一笔了。"
        },
        {
          "role": "海迪夫",
          "text": "来层岩巨渊发现特殊蘑菇的时候，就想研究长期食用这种蘑菇会有什么后果…但是找不到愿意协助我进行实验的助手。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "助手？",
              "dialogues": [
                {
                  "role": "海迪夫",
                  "text": "就是负责吃蘑菇的人，大家都对这种蘑菇敬而远之，虽然知道不会有太大损害，但也不敢轻易尝试。"
                }
              ]
            },
            {
              "text": "是实验对象吧？",
              "dialogues": [
                {
                  "role": "海迪夫",
                  "text": "也可以这么说，不过这种蘑菇之前就已经被分析过，不会对人体或精神造成不可逆损伤。"
                }
              ]
            }
          ]
        },
        {
          "role": "海迪夫",
          "text": "不过…层岩巨渊环境特殊，说不定也有环境的影响，总之，只要用了这个药，然后再好好休息，恢复的可能还是很大的。"
        },
        {
          "role": "瑾武",
          "text": "那就行，那就行…待会儿我就把老何送到上面去。"
        },
        {
          "role": "瑾武",
          "text": "等他恢复了，就带他回家，还得告诉那些跟他关系好的兄弟们。"
        },
        {
          "role": "瑾武",
          "text": "老何可是老前辈了，身手敏捷，对新来的小伙子们都多有照顾。"
        },
        {
          "role": "瑾武",
          "text": "他当年失踪之后…大家都觉得岩王爷没开眼啊，怎么好人没好报呢。"
        },
        {
          "role": "瑾武",
          "text": "这次他回去，大伙肯定很高兴吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "老何",
          "text": "耳朵倒是不痒了…但是…"
        },
        {
          "role": "老何",
          "text": "蘑菇肉，唉，哪里能再找到蘑菇肉吃呢？"
        }
      ],
      "collapse_ranges": [
        [
          1,
          7
        ],
        [
          114,
          116
        ]
      ]
    }
  ]
}