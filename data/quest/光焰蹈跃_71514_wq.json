{
  "quest_id": 71514,
  "chapter_num": null,
  "chapter_title": "光焰蹈跃",
  "type": "wq",
  "route": "Radiant Sparks",
  "stories": [
    {
      "story_id": 71514,
      "title": "光焰蹈跃",
      "description": "海灯节期间，冒险家协会的宣传员甜甜正摩拳擦掌，筹备着一场有趣的活动…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与甜甜对话"
        },
        {
          "role": "甜甜",
          "text": "嗨嗨嗨！两位前辈，海灯节好呀！"
        },
        {
          "role": "甜甜",
          "text": "最近玩得开心吗？有兴趣跟我来一场特别冒险吗？"
        },
        {
          "role": "派蒙",
          "text": "呜哇，居然叫我们前辈？态度真不错！"
        },
        {
          "role": "派蒙",
          "text": "不说最近，我们一直挺开心的啦！不过…我怎么觉得你有点眼熟呢？"
        },
        {
          "role": "甜甜",
          "text": "你们可是冒险家协会的超级全勤王，肯定见过我！"
        },
        {
          "role": "甜甜",
          "text": "我叫甜甜，平常总在绯云坡附近转悠，为协会招揽新人。"
        },
        {
          "role": "甜甜",
          "text": "路过绯云坡的人里，十个有十个听过我的声音，还要加上他们抱的猫、遛的狗！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像有一点印象…",
              "dialogues": [
                {
                  "role": "甜甜",
                  "text": "对对对，说明我的努力被前辈们注意到了！那更要让前辈们体验一下我的杰作了！"
                }
              ]
            },
            {
              "text": "完全没印象…",
              "dialogues": [
                {
                  "role": "甜甜",
                  "text": "居然没印象？那我要用这次的杰作让更多人记住我…不对，是招揽更多人加入协会！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "话都说到这份上了，我们两位前辈肯定要给你面子！"
        },
        {
          "role": "派蒙",
          "text": "请简单介绍一下你说的特别冒险吧？"
        },
        {
          "role": "甜甜",
          "text": "好！那我就进入正题了！"
        },
        {
          "role": "甜甜",
          "text": "最近我在万文集舍看到了新的小说…不对，应该说是找到了新的情报！"
        },
        {
          "role": "甜甜",
          "text": "我发现人们对于冒险的期望正在变高，登山和风之翼滑翔这类活动的吸引力都不如以前了。"
        },
        {
          "role": "甜甜",
          "text": "为了让更多人加入冒险家协会，新奇而刺激的体验是必需品。"
        },
        {
          "role": "甜甜",
          "text": "所以，我联合外地的几位宣传员，一起花费重金，请教了几位登山高手和烟花工匠，设计了一种全新的竞速挑战！"
        },
        {
          "role": "甜甜",
          "text": "挑战中布置了很多机关，只要踩上去，就可以利用烟花和火药爆炸的推力，一下子飞到天上，完成超厉害的加速！"
        },
        {
          "role": "派蒙",
          "text": "烟花？火药？竞速挑战的过程中…把人炸到天上？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是烟花助飞的派蒙！",
              "dialogues": []
            },
            {
              "text": "是火药推进的派蒙！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你干嘛这么兴奋啦？你也会被轰飞的哦！"
        },
        {
          "role": "派蒙",
          "text": "虽然以你的实力，连面前爆开的炸药桶都不怕啦…但说不定会被炸得晕乎乎呢！"
        },
        {
          "role": "甜甜",
          "text": "放心放心，爆炸是在坚韧的装置内部发生的，我为安全措施做了重重保障，绝对没有受伤的风险！"
        },
        {
          "role": "甜甜",
          "text": "而且，我有和总务司正式报备，宣传的时候多次强调，请勿擅自模仿！"
        },
        {
          "role": "派蒙",
          "text": "还有这么多门道？你考虑得还挺周到嘛！"
        },
        {
          "role": "甜甜",
          "text": "按照我的预期，只要玩了这个竞速挑战，哪怕是一般人，心中的冒险之魂也会被点燃！"
        },
        {
          "role": "甜甜",
          "text": "两位前辈，你们盛名在外，如果你们带头参加这个竞速挑战，肯定能吸引很多人。"
        },
        {
          "role": "甜甜",
          "text": "我还为挑战准备了丰厚的奖励，肯定能把慕名而来的人们转化成冒险家协会的新成员！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好啊好啊，烟花火药大竞速！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯！既然还能拿到奖励，那我们就没有错过它的理由！"
                }
              ]
            },
            {
              "text": "好怕好怕，我和派蒙被炸飞！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "噫，你明明在笑啦！反正甜甜小姐说过了，安全措施很完善，你也很想试试看吧？"
                }
              ]
            }
          ]
        },
        {
          "role": "甜甜",
          "text": "那就这么说定了！事不宜迟，两位前辈请快试试看吧！"
        },
        {
          "role": "甜甜",
          "text": "嘿嘿，这次竞速挑战的赛道还挺多的，肯定能让你们玩个痛快！我也能一举拿到好几个月的业绩，双赢双赢！"
        },
        {
          "type": "subtitle",
          "text": "开启光焰蹈跃活动任务",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}