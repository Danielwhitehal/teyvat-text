{
  "quest_id": 73281,
  "chapter_num": null,
  "chapter_title": "「鹰猎」",
  "type": "wq",
  "route": "\"The Falcon's Hunt\"",
  "stories": [
    {
      "story_id": 73281,
      "title": "「鹰猎」",
      "description": "经历了上次的冒险后，马塞拉似乎仍对你有求…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等候到次日早上（8至12时）"
        },
        {
          "type": "subtitle",
          "text": "与马塞拉对话"
        },
        {
          "role": "马塞拉",
          "text": "啊，是您来了！尊贵的「镇灵主人」，「小猎鹰」的恩人。"
        },
        {
          "role": "马塞拉",
          "text": "十分不好意思，今天我还有事情要麻烦您，是一场狩猎任务。"
        },
        {
          "role": "马塞拉",
          "text": "长话短说，是塔德菈的「成年礼」。我请求你们替我见证她的成长。"
        },
        {
          "role": "马塞拉",
          "text": "唔…可能会有点棘手，但奖励丰厚。所以请您…"
        },
        {
          "role": "派蒙",
          "text": "嗯，我们接下啦！"
        },
        {
          "role": "利露帕尔",
          "text": "喂…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们接下了。",
              "dialogues": [
                {
                  "role": "利露帕尔",
                  "text": "唉，真是的…"
                }
              ]
            },
            {
              "text": "关于狩猎…",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "这场狩猎？是塔德菈的成年礼。部族里的「猎鹰」以往都是由我亲自指导的…但现在，我的腿脚不利索了。"
                },
                {
                  "role": "马塞拉",
                  "text": "上一次委托之后，她说她信得过您，于是我便麻烦您，来见证「猎鹰」的成长了。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "我明白了，我会帮忙的。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "马塞拉",
                  "text": "真是痛快。那么，这次狩猎的详情，就请你们找塔德菈细谈吧。"
                }
              ]
            },
            {
              "text": "我还有其他事要忙。",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "那我就不打扰您了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "选「我还有其他事要忙」时，额外对话（塔德菈）"
        },
        {
          "role": "'心声'",
          "text": "（…为什么不让我一个人完成「成人礼」…）"
        },
        {
          "role": "塔德菈",
          "text": "您好，「镇灵主人」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的伤好些了吗？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "已经没有大碍了…请不必关心我。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "嗯，再见。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "选「我还有其他事要忙」时"
        },
        {
          "role": "马塞拉",
          "text": "啊，您回来了。怎么？有时间接下我的委托吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我会帮忙的。",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "很好…那么，这次狩猎的详情，就请你们找塔德菈细谈吧。"
                }
              ]
            },
            {
              "text": "我还有其他事要忙。",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "那我就不打扰您了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "心声（马塞拉）"
        },
        {
          "role": "马塞拉",
          "text": "（…塔德菈啊…你的成长…太慢了…）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（马塞拉）"
        },
        {
          "role": "马塞拉",
          "text": "猎物不会自己送上门来，请您找塔德菈详谈吧。"
        },
        {
          "type": "subtitle",
          "text": "与塔德菈对话"
        },
        {
          "role": "塔德菈",
          "text": "您好，感谢您的搭救。"
        },
        {
          "role": "派蒙",
          "text": "塔德菈精神好多了呢！你的伤好些了吗？"
        },
        {
          "role": "塔德菈",
          "text": "谢谢关心，已经痊愈了…但难免留下伤疤。"
        },
        {
          "role": "塔德菈",
          "text": "请您不要担心我的状态，我的主人…父亲，想必已经将委托交待给了你们。"
        },
        {
          "role": "利露帕尔",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好的…",
              "dialogues": []
            },
            {
              "text": "「主人」…？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "……"
                }
              ]
            },
            {
              "text": "「父亲」…？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "那不是狩猎目标，抱歉。"
                }
              ]
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "此次狩猎有三个目标，分别是赤鹫、毒蝎和飞蛇。"
        },
        {
          "role": "塔德菈",
          "text": "首先是赤鹫，我们已经探查到了赤鹫巢穴的位置，接下来只需要追踪它就可以了。"
        },
        {
          "role": "塔德菈",
          "text": "当然，如果您还有别的事情要完成，我会在这里等着你。但…猎物不会等我们的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们这就出发。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "那么请您跟紧我。"
                }
              ]
            },
            {
              "text": "我还有其他事要忙。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "嗯，我会在这里等您。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "选「我还有其他事要忙」时"
        },
        {
          "role": "塔德菈",
          "text": "您来了，要出发了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们走吧。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "那么请您跟紧我。"
                }
              ]
            },
            {
              "text": "我只是路过。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "好的…我还在等着您。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（马塞拉）"
        },
        {
          "role": "马塞拉",
          "text": "啊，您回来了。还有什么事吗？还是说只是闲聊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于塔德菈…",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "我相信…在同您一起历练过后，她会成为合格的「猎鹰」。"
                }
              ]
            },
            {
              "text": "关于「成年礼」…",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "独自一人或和伙伴一起，狩猎强大的猎物，成为称职的「猎鹰」，为部族所用，猎捕动物与敌人…"
                },
                {
                  "role": "马塞拉",
                  "text": "就这么简单。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "祝你有好猎获。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往赤鹫巢穴所在之处"
        },
        {
          "role": "塔德菈",
          "text": "请您随我来，我们已经探查到了赤鹫巢穴的位置，接下来只需要追踪它就可以了。"
        },
        {
          "role": "塔德菈",
          "text": "对了，您在用香料吗…？"
        },
        {
          "role": "派蒙",
          "text": "没有呀，怎么啦？"
        },
        {
          "role": "塔德菈",
          "text": "很好，我也没有。"
        },
        {
          "type": "subtitle",
          "text": "沿途搜索赤鹫痕迹"
        },
        {
          "role": "塔德菈",
          "text": "看那边，那是什么？"
        },
        {
          "type": "subtitle",
          "text": "'''调查'''",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "塔德菈",
          "text": "应该是和同类争夺食物时掉下的…雌性，有腐肉的气味…她饱餐了一顿，不久之后应该就会回巢。"
        },
        {
          "role": "塔德菈",
          "text": "我们跟着她回巢吧。"
        },
        {
          "role": "塔德菈",
          "text": "我们的路线是正确的，前面还有遗落物。"
        },
        {
          "type": "subtitle",
          "text": "'''调查'''",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "塔德菈",
          "text": "…是粪便，鼬类的皮毛…还有一点水分，她离我们并不远。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…你不要用手捏它呀…"
        },
        {
          "role": "塔德菈",
          "text": "怎么，你想要？"
        },
        {
          "role": "派蒙",
          "text": "我不要！"
        },
        {
          "role": "塔德菈",
          "text": "可以掩盖自己的气味，很有用的。"
        },
        {
          "role": "塔德菈",
          "text": "那是什么…我们靠近看看。"
        },
        {
          "type": "subtitle",
          "text": "'''调查'''",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "前往赤鹫巢穴"
        },
        {
          "role": "塔德菈",
          "text": "爪印…啊，被沙子盖住了。在这里落地了，显然发觉到有人在跟踪她…"
        },
        {
          "role": "派蒙",
          "text": "塔德菈的眼力真好呢。"
        },
        {
          "role": "塔德菈",
          "text": "嘘…我们随时可能撞上她，小心不要把她惊跑了。"
        },
        {
          "role": "塔德菈",
          "text": "有巢穴的气味…嗯…果然，就在那里。"
        },
        {
          "role": "塔德菈",
          "text": "好了，我们上去吧。"
        },
        {
          "type": "subtitle",
          "text": "进入赤鹫巢穴"
        },
        {
          "type": "subtitle",
          "text": "与塔德菈对话"
        },
        {
          "role": "塔德菈",
          "text": "这里就是她的巢穴了。"
        },
        {
          "role": "塔德菈",
          "text": "赤鹫的性子谨慎狡诈，她大概已经闻到异样的气味，提前飞走了…所以并没有在巢穴里。"
        },
        {
          "role": "塔德菈",
          "text": "接下来我们要耐心等候才行。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "赤鹫什么时候会回来？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "直到她觉得危险解除为止…即使察觉到我们在这里，夜半的寒冷也会逼迫她回巢的。"
                }
              ]
            },
            {
              "text": "那边亮闪闪的是什么？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "「愚人金」，赤鹫喜欢收集亮闪闪的玩意。"
                },
                {
                  "role": "派蒙",
                  "text": "哦…「愚人金」，「愚人众的藏金」吗…"
                },
                {
                  "role": "利露帕尔",
                  "text": "不，是「只有笨蛋才会以为是金子」的东西。"
                },
                {
                  "role": "派蒙",
                  "text": "我、我可没说那是金子哦！"
                },
                {
                  "role": "塔德菈",
                  "text": "嘘…您不会想要那些东西的，大概是黄铜、黄铁之类的合金，不值钱。"
                }
              ]
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "好了，我们在这里等待到半夜吧。如果累了就请休息一下，我会替您盯着的。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（塔德菈）"
        },
        {
          "role": "'心声'",
          "text": "（…不要胡思乱想了，塔德菈…你只是「猎鹰」而已…）"
        },
        {
          "role": "塔德菈",
          "text": "…还没来，请您不要四处活动，会让她起戒心。"
        },
        {
          "type": "subtitle",
          "text": "等候到次日凌晨（1至3时）"
        },
        {
          "role": "派蒙",
          "text": "唔…反正赤鹫不会这么快就回来，不如我们先去看看那些{{颜色|蓝|金闪闪的东西}}吧？"
        },
        {
          "type": "subtitle",
          "text": "分支——等待"
        },
        {
          "type": "subtitle",
          "text": "猎捕赤鹫"
        },
        {
          "type": "subtitle",
          "text": "等待时间",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "塔德菈",
          "text": "嘘，他来了，您看。"
        },
        {
          "role": "塔德菈",
          "text": "我们上。"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|圣骸赤鹫}}赤鹫（来自天空的猎人）",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "分支——拾取"
        },
        {
          "type": "subtitle",
          "text": "前往隐蔽地点等待赤鹫归巢"
        },
        {
          "role": "塔德菈",
          "text": "您在干什么…快回来…！"
        },
        {
          "type": "subtitle",
          "text": "猎捕暴怒的赤鹫"
        },
        {
          "type": "subtitle",
          "text": "'''拾取'''金闪闪的东西",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|圣骸赤鹫}}暴怒的赤鹫（「我的宝物！」）",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与塔德菈对话出发"
        },
        {
          "role": "塔德菈",
          "text": "您是个天生的猎人，难怪父亲会委托您助我狩猎。"
        },
        {
          "role": "塔德菈",
          "text": "剩下的请交给我吧…不过如果您想要了解的话，我可以慢慢教您。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请让我看看。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "嗯…好的。"
                },
                {
                  "type": "subtitle",
                  "text": "塔德菈为你们慢慢演示了解剖和拆解猎物的过程，你们似乎学到了许多以后不一定用得到的技能。",
                  "narration": true,
                  "color": "描述"
                },
                {
                  "type": "subtitle",
                  "text": "演示结束，塔德菈为你展示了她血淋淋的双手，嘴角浮现一丝孩子般的浅笑。\n这是她第一次将感情的痕迹表现在脸上。",
                  "narration": true,
                  "color": "描述"
                }
              ]
            },
            {
              "text": "唔…还是不了。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "请您自便。"
                },
                {
                  "type": "subtitle",
                  "text": "塔德菈利落地解剖并拆解了猎物，随后将猎物包好收了起来。",
                  "narration": true,
                  "color": "描述"
                }
              ]
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "嗯…血腥气，很好。"
        },
        {
          "role": "派蒙",
          "text": "我也闻见啦…好大的血腥气！你不去洗洗吗？"
        },
        {
          "role": "塔德菈",
          "text": "不，我们接下来还要猎捕毒蝎。"
        },
        {
          "role": "利露帕尔",
          "text": "毒蝎是食肉的，新鲜血肉的气息会让它们活跃起来。"
        },
        {
          "role": "塔德菈",
          "text": "没错。"
        },
        {
          "role": "派蒙",
          "text": "唔…那好吧。反正我会捏住鼻子的！"
        },
        {
          "role": "塔德菈",
          "text": "你们还要休息吗？或是现在出发？"
        },
        {
          "role": "塔德菈",
          "text": "这座巢穴还算凉爽，应该可以妥善保存我们的猎物…我们还能在这里过夜，省得在路上受冷。"
        },
        {
          "role": "派蒙",
          "text": "嗯！反正这里不冷不热、还蛮舒服的，我们正好休息一下吧！"
        },
        {
          "role": "利露帕尔",
          "text": "小派蒙又想偷懒咯。"
        },
        {
          "role": "派蒙",
          "text": "哼，我又不是你，冷热不分的家伙！"
        },
        {
          "type": "subtitle",
          "text": "塔德菈从赤鹫巢穴中收集了一些胡杨枝与干粪便，很快，你们便搭起了一个简单的营火。\n你们就着火光，简单地分享了干粮与水，分量很足。\n火烧得很旺，你们出神地望着闪烁的火光，却没能提起什么有趣的话题…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "休息一夜与塔德菈对话"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于马塞拉…",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "他是我的父亲，我是他的「猎鹰」。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "……",
                      "dialogues": [
                        {
                          "role": "塔德菈",
                          "text": "……"
                        }
                      ]
                    },
                    {
                      "text": "然后呢…？",
                      "dialogues": [
                        {
                          "role": "塔德菈",
                          "text": "巧舌如簧是鹦鹉的工作，猎鹰应该沉默。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "关于你自己…",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "我自己…？"
                },
                {
                  "role": "塔德菈",
                  "text": "没什么好说的…你想要了解我？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "很奇怪吗？",
                      "dialogues": [
                        {
                          "role": "塔德菈",
                          "text": "我是「猎鹰」，只被允许了解自己的猎物，而不是被别人了解。"
                        },
                        {
                          "role": "塔德菈",
                          "text": "…所以…抱歉。"
                        },
                        {
                          "role": "利露帕尔",
                          "text": "这样吗…我建议这个小姑娘，还是多为自己着想一下为好。"
                        }
                      ]
                    },
                    {
                      "text": "我想知道自己在和什么样的人合作。",
                      "dialogues": [
                        {
                          "role": "塔德菈",
                          "text": "「人」？不。「猎鹰」？是。"
                        },
                        {
                          "role": "塔德菈",
                          "text": "请您放心，我不会违抗您，或抛下您逃走的。毕竟是父亲将我委托给了您。"
                        },
                        {
                          "role": "利露帕尔",
                          "text": "呵呵…被蒙了眼的猎鹰，怎么会在乎自己的羽毛有多漂亮呢？"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "您休息得如何了？我们可以继续出发了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们走吧，继续捕猎。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "请您跟上我。"
                }
              ]
            },
            {
              "text": "我还有些事要处理，要先离开一下。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "请您自便。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "选「我还有些事要处理」时"
        },
        {
          "role": "'心声'",
          "text": "（…不要胡思乱想了，塔德菈…你只是「猎鹰」而已…）"
        },
        {
          "role": "塔德菈",
          "text": "您回来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们走吧，继续捕猎。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "我会为您引路，请您跟上我。"
                }
              ]
            },
            {
              "text": "我还有些事要处理。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "请您自便。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往毒蝎洞穴"
        },
        {
          "type": "subtitle",
          "text": "进入毒蝎巢穴"
        },
        {
          "role": "利露帕尔",
          "text": "小派蒙，你一直捏着鼻子呢。"
        },
        {
          "role": "派蒙",
          "text": "因为味道很大嘛…血腥味…"
        },
        {
          "role": "利露帕尔",
          "text": "可我只闻到了野兽的味道…嗯，不难闻呢。"
        },
        {
          "role": "派蒙",
          "text": "噫…说起来，利露帕尔的鼻子长在哪里呢…？"
        },
        {
          "role": "利露帕尔",
          "text": "哼，多嘴…"
        },
        {
          "type": "subtitle",
          "text": "与塔德菈对话"
        },
        {
          "role": "塔德菈",
          "text": "我们到了。"
        },
        {
          "role": "塔德菈",
          "text": "毒蝎昼伏夜出，现在距离夜晚还有一段时间。我们可以先计划一下捕猎方式。"
        },
        {
          "role": "塔德菈",
          "text": "首先，我们可以用沙脂蛹的分泌物混一点毒蕈粉末。蛹脂可以吸引毒蝎，而毒蕈会麻痹它。"
        },
        {
          "role": "塔德菈",
          "text": "毒性不够杀死它，但足以让它难以动弹。"
        },
        {
          "role": "塔德菈",
          "text": "其次，我们可以用赤念果与蛇毒捣成糊，再加鲜肉制成毒饵…以毒攻毒。"
        },
        {
          "role": "塔德菈",
          "text": "但蛇毒太贵了，全用在这里实在浪费…我会以适当比例调配，不会杀死毒蝎，但足以削弱它的力量。"
        },
        {
          "role": "塔德菈",
          "text": "其三…最笨的办法。我们冒着生命危险猎捕它，不用任何其他手段。"
        },
        {
          "role": "塔德菈",
          "text": "但这样也有好处，可以尽可能避免污染，取到更纯净的蝎毒液。"
        },
        {
          "role": "塔德菈",
          "text": "至于您会选择哪种方式…我随时等待您的决定。"
        },
        {
          "role": "塔德菈",
          "text": "还有，与毒蝎战斗时一定要小心…它们的毒性很强烈。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们使用麻痹毒饵吧。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "好的…您手上没有伤口吧？"
                },
                {
                  "type": "subtitle",
                  "text": "塔德菈小心翼翼地配好了毒饵，你们在洞穴中耐心等到了月升之时…",
                  "narration": true,
                  "color": "描述"
                },
                {
                  "role": "塔德菈",
                  "text": "毒饵起效了，我们上！"
                }
              ]
            },
            {
              "text": "我们使用蛇毒饵吧。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "小心不要割破了自己，蛇毒渗进伤口会很难办。"
                },
                {
                  "type": "subtitle",
                  "text": "塔德菈小心翼翼地配好了毒饵，你们在洞穴中耐心等到了月升之时…",
                  "narration": true,
                  "color": "描述"
                },
                {
                  "role": "塔德菈",
                  "text": "它很虚弱，我们上！"
                }
              ]
            },
            {
              "text": "我不需要毒饵。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "那么我会在您背后做照应。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "分支——麻痹毒饵"
        },
        {
          "type": "subtitle",
          "text": "猎捕陷入眩晕的毒蝎"
        },
        {
          "role": "塔德菈",
          "text": "它来了，我们上！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|圣骸毒蝎}}眩晕的毒蝎（凶险但不太聪明…）",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "欸！怎么还有一只？！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|圣骸毒蝎}}食腐毒蝎（猎手的孪生兄弟）",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "分支——蛇毒饵"
        },
        {
          "type": "subtitle",
          "text": "猎捕食下毒饵的毒蝎"
        },
        {
          "role": "塔德菈",
          "text": "它来了，我们上！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|圣骸毒蝎}}中毒的毒蝎（或许是报应？）",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "欸！怎么还有一只？！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|圣骸毒蝎}}食腐毒蝎（猎手的孪生兄弟）",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "分支——不用毒饵"
        },
        {
          "type": "subtitle",
          "text": "在隐蔽点隐藏自己"
        },
        {
          "type": "subtitle",
          "text": "额外对话（塔德菈）"
        },
        {
          "role": "'心声'",
          "text": "（…不要胡思乱想了，塔德菈…你只是「猎鹰」而已…）"
        },
        {
          "role": "塔德菈",
          "text": "我们需要耐心等待…它们应该闻到了血腥味，但到夜晚才会活跃起来。"
        },
        {
          "type": "subtitle",
          "text": "'''隐藏'''",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "猎捕毒蝎"
        },
        {
          "role": "塔德菈",
          "text": "它来了，我们上！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|圣骸毒蝎}}毒蝎（凶险的埋伏者）",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "欸！怎么还有一只？！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|圣骸毒蝎}}食腐毒蝎（猎手的孪生兄弟）",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与塔德菈对话"
        },
        {
          "role": "塔德菈",
          "text": "…谢谢，您没必要这样做的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还好吧？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "我没事。"
                },
                {
                  "role": "派蒙",
                  "text": "你在流血…"
                },
                {
                  "role": "塔德菈",
                  "text": "没事，小伤而已。"
                }
              ]
            },
            {
              "text": "你受伤了？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "没有…呃…有一点，不过不碍事。"
                },
                {
                  "role": "派蒙",
                  "text": "你不要太勉强自己呀。"
                },
                {
                  "role": "塔德菈",
                  "text": "嗯，谢谢。"
                }
              ]
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "呼…接下来，解剖和分解…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "让我看看？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "…？"
                },
                {
                  "role": "塔德菈",
                  "text": "噗…"
                },
                {
                  "role": "派蒙",
                  "text": "欸…你笑什么呀？"
                },
                {
                  "role": "利露帕尔",
                  "text": "对于「猎鹰」来说，还真少见呢。"
                },
                {
                  "role": "塔德菈",
                  "text": "没什么，只是…您突然要看我解剖毒蝎，有点好笑。"
                },
                {
                  "role": "塔德菈",
                  "text": "很少有人对切割猎物之类的活计如您这般感兴趣的…或者说，您还有别的想法？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "我担心你会手抖。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "塔德菈",
                  "text": "猎取它的时候手没抖，解剖它的时候手就更不会抖。"
                },
                {
                  "role": "塔德菈",
                  "text": "请您放心，毕竟我是…「猎鹰」啊。"
                },
                {
                  "type": "subtitle",
                  "text": "塔德菈慢慢剖开毒蝎，然后有条不紊地去掉了无用的内脏，摘取了毒腺，将它们仔细分包起来。\n她的双手灵巧又稳定，就像在演奏乐器——血肉与角质外壳组成的无声乐器。\n…很快，毒蝎便被她处分完毕了。",
                  "narration": true,
                  "color": "描述"
                },
                {
                  "type": "subtitle",
                  "text": "忙完这些活计后，塔德菈长出了一口气。\n她的额上布满汗珠，呼吸稍带颤抖…刚刚的伤口一定很痛。",
                  "narration": true,
                  "color": "描述"
                }
              ]
            },
            {
              "text": "先休息一下吧。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "不…毒腺如果不及时做保鲜处理的话，很容易在空气中变质，到时候就不能用了。"
                },
                {
                  "type": "subtitle",
                  "text": "塔德菈轻车熟路地解剖了毒蝎，然后有条不紊地去掉了无用的内脏，摘取了毒腺，将它们仔细分包起来。\n然后，她把脏兮兮的双手亮给你看，她面无表情，但你总觉得她在赌气向你证明什么…",
                  "narration": true,
                  "color": "描述"
                }
              ]
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "你看，没什么大碍。这点伤对「猎鹰」来说…不算什么。"
        },
        {
          "role": "塔德菈",
          "text": "呼…我们还要狩猎飞蛇。我们走吧。"
        },
        {
          "type": "subtitle",
          "text": "进入飞蛇洞穴"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "塔德菈，你的脸色很不好呢…不需要休息一下吗？"
        },
        {
          "role": "塔德菈",
          "text": "我没事。"
        },
        {
          "role": "利露帕尔",
          "text": "「猎鹰」也会有受伤的时候，没必要为此羞耻，小姑娘。"
        },
        {
          "role": "塔德菈",
          "text": "我没有。"
        },
        {
          "type": "subtitle",
          "text": "与塔德菈对话"
        },
        {
          "role": "利露帕尔",
          "text": "等等…我感受到了…这种似曾相识的…痛感。"
        },
        {
          "role": "利露帕尔",
          "text": "那是我的魂魄，是我的碎片…就在附近了…"
        },
        {
          "role": "塔德菈",
          "text": "这附近蛰居着飞蛇，看来是镇灵碎片所催发出的绿洲，让它们得以生存在这里…"
        },
        {
          "role": "利露帕尔",
          "text": "说的没错。呃…不，无法确定碎片的方位，飞蛇的气息太浊重，太杂乱了…"
        },
        {
          "role": "派蒙",
          "text": "那我们就深入进去，干掉飞蛇就好啦！"
        },
        {
          "role": "塔德菈",
          "text": "嗯…"
        },
        {
          "role": "利露帕尔",
          "text": "我猜你想说「好耶！」但在这种情况下，我建议你还是退后好好休息一下。"
        },
        {
          "role": "塔德菈",
          "text": "…让我先去侦察一下前方飞蛇的情况。"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "塔德菈！你还好吗！"
        },
        {
          "role": "塔德菈",
          "text": "…呼…嗯…"
        },
        {
          "role": "利露帕尔",
          "text": "她的意思是「好痛」。"
        },
        {
          "role": "塔德菈",
          "text": "我没有…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没关系的，让我来就好。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，你还是休息一下吧！"
                }
              ]
            },
            {
              "text": "接下来就交给我吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，接下来只靠我们也可以的！呃，我是说靠旅行者啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "额外对话（塔德菈）"
        },
        {
          "role": "'心声'",
          "text": "（…很渴，很痛…而且好冷…）"
        },
        {
          "role": "塔德菈",
          "text": "呼…如果您需要我的帮助…请随时叫上我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还是在这里休息一下比较好。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "……"
                }
              ]
            },
            {
              "text": "你的状况不太适合继续捕猎了。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "哼…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "猎捕飞蛇"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|圣骸飞蛇}}飞蛇（堕落的使者）",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "击败飞蛇后对话"
        },
        {
          "role": "塔德菈",
          "text": "抱歉，没有帮上忙…"
        },
        {
          "role": "派蒙",
          "text": "不要这么说啦，你也需要休息一下啦！毕竟…在不方便的时候，把一些事情交给我们做也好呀，大家都是朋友嘛！"
        },
        {
          "role": "塔德菈",
          "text": "我只是马塞拉的「猎鹰」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "马塞拉的「猎鹰」，和我们的朋友。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "……"
                },
                {
                  "role": "塔德菈",
                  "text": "嗯。"
                }
              ]
            },
            {
              "text": "我们只把你当做朋友看待。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "……"
                },
                {
                  "role": "塔德菈",
                  "text": "…谢谢。"
                }
              ]
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "嗯…无意打扰你们，但我想…我的碎片，在这里。我找到了。"
        },
        {
          "role": "塔德菈",
          "text": "…没关系，我会去好好处理我们的猎获。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（塔德菈）"
        },
        {
          "role": "'心声'",
          "text": "（…不能显露虚弱…或胆怯的样子…）"
        },
        {
          "role": "塔德菈",
          "text": "怎么…？镇灵大人的事…您忙完了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还没有…",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "那么…请不必担心我，我还有事情要忙…"
                }
              ]
            },
            {
              "text": "你的伤好些了吗？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "嗯，已经不痛了…呃唔…没事的。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "获取利露帕尔的碎片"
        },
        {
          "type": "subtitle",
          "text": "随着闪光的碎片汇入利露帕尔的魔瓶，你感到自身的力量也被抽离了少许…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "从镇灵恍惚的目光中，你看到了衰败与背叛的漩涡…\n「胜利之灵」因其漆黑的印戒陷入疯狂，王后希琳在一连串悲剧中酿成蜜色的惨祸，从此将神智交托给迷乱…\n人民相残，镇灵破碎…崩裂的魂魄为庞大的机械供能，无智性的仙灵后裔化为力量无穷的奴隶…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "于是，「胜利之灵」的残酷盛世降临…疯狂的君王与贵胄为人的时代弹冠相庆…\n却浑然未知，居尔城的世事皆在「镇灵之母」阴险的算计之中…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "利露帕尔",
          "text": "您还好吗，我的大人…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "又是…居尔城…",
              "dialogues": []
            },
            {
              "text": "我的头好痛…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "抱歉，与镇灵的记忆合二为一，体验未必会很好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "利露帕尔，你究竟做了什么…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "我做了什么？不如问问他们自己做了什么…只需稍加点拨，就会在作恶的大道上一路向毁灭狂奔。"
        },
        {
          "role": "利露帕尔",
          "text": "居尔城的毁灭…这就是先声。而我只不过是为他们指引了受惩之路。"
        },
        {
          "role": "利露帕尔",
          "text": "好了，现在不是谈论这些的时候…您的朋友们都在等着您回应他们呢。"
        },
        {
          "role": "派蒙",
          "text": "你醒了…？真是的，每次都让我好担心！"
        },
        {
          "role": "塔德菈",
          "text": "啊，您终于醒了。派蒙很担心您…"
        },
        {
          "role": "派蒙",
          "text": "塔德菈也是！刚刚你失去意识，她手忙脚乱了好久呢！你都要把她急哭了，还不给她道个歉啦！"
        },
        {
          "role": "塔德菈",
          "text": "我没有…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抱歉让你担心了，塔德菈。",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "……"
                },
                {
                  "role": "塔德菈",
                  "text": "没有猎人向猎鹰道歉的说法。"
                }
              ]
            },
            {
              "text": "请不要太累到自己了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "这不算什么。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的伤怎么样了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "唔…好多了，我们回去吧。"
        },
        {
          "role": "利露帕尔",
          "text": "她在发抖，有点发烧…是蝎毒，我所熟悉的毒物。"
        },
        {
          "role": "利露帕尔",
          "text": "虽然不会致命，但会很痛苦…她需要休息。"
        },
        {
          "role": "塔德菈",
          "text": "不，我没事…"
        },
        {
          "role": "利露帕尔",
          "text": "你现在当然没事，但如果再在沙漠里跋涉一段时间的话…蝎毒和发热会加速脱水，轻松要了你的命。"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "利露帕尔",
          "text": "好猎鹰懂得珍惜自己的生命，否则就会成为拖累，然后被淘汰。你不是蠢「猎鹰」，对吧？"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "好啦，利露帕尔！说话不要那么刁钻呀！塔德菈，你也不要逞强啦…我们还是好好休息一下再出发吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "利露帕尔说的有道理。",
              "dialogues": []
            },
            {
              "text": "派蒙说得对。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "嗯…抱歉。"
        },
        {
          "role": "派蒙",
          "text": "没必要道歉啦！这座山洞应该能阻挡晚上的冷风，我们在这里搭篝火吧！"
        },
        {
          "role": "塔德菈",
          "text": "嗯…请让我也来帮忙…唔…"
        },
        {
          "role": "派蒙",
          "text": "让我们来就好！我们也是野营露宿专家呢！"
        },
        {
          "type": "subtitle",
          "text": "你们搭建了一个简单的营火，你与派蒙简单准备了一些食物。\n塔德菈喝了些水，很快便沉沉睡去了…\n她的身体微微发热，蝎毒造成的脱水症状与劳累令她看起来十分脆弱，但她睡得很安详。你能看出，痛苦正渐渐离她远去…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "不知过了多久，朝阳照亮了赤红的沙漠…\n天亮了，随着初晨的露珠被日光蒸干，你们纷纷醒来。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "塔德菈",
          "text": "是时候起床了，我们该出发了。"
        },
        {
          "role": "派蒙",
          "text": "塔德菈的脸色好多了呢…你好些了吗？"
        },
        {
          "role": "塔德菈",
          "text": "嗯，没有大碍了…我们走吧。"
        },
        {
          "role": "利露帕尔",
          "text": "再过一段时间，太阳就毒起来了，我们想要回到部落的话，要尽快出发才行。"
        },
        {
          "type": "subtitle",
          "text": "向马塞拉回报"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "欸？塔德菈怎么了，还是不舒服吗？"
        },
        {
          "role": "塔德菈",
          "text": "不…没有。"
        },
        {
          "role": "利露帕尔",
          "text": "如果你有话说，请现在与我的大人明说吧。"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "塔德菈",
          "text": "我…很高兴，能与您一同狩猎。"
        },
        {
          "role": "塔德菈",
          "text": "…谢谢。"
        },
        {
          "role": "利露帕尔",
          "text": "…这不是「猎鹰」的所为。"
        },
        {
          "type": "subtitle",
          "text": "心声（马塞拉）"
        },
        {
          "role": "马塞拉",
          "text": "（…塔德菈啊…你的成长…太慢了…）"
        },
        {
          "role": "马塞拉",
          "text": "啊，尊贵的「镇灵主人」！还有…嗯，你也回来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（交付猎物）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "交付{{图标|赤鹫翎羽|1}}{{图标|毒蝎尾部|1}}{{图标|飞蛇之角|1}}给马塞拉",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "马塞拉",
          "text": "比我预期要晚很多…我的小「猎鹰」。路上出什么事了？"
        },
        {
          "role": "塔德菈",
          "text": "说来丢人，我…我受伤了…但多亏「镇灵主人」的帮助，我已经没事了。"
        },
        {
          "role": "马塞拉",
          "text": "……"
        },
        {
          "role": "马塞拉",
          "text": "好，很好。你没事就好。"
        },
        {
          "role": "马塞拉",
          "text": "尊贵的「镇灵主人」，我的「猎鹰」拖您的后腿了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "塔德菈帮了我很大忙。",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "嗯…"
                },
                {
                  "role": "马塞拉",
                  "text": "很好，辛苦您了。"
                }
              ]
            },
            {
              "text": "我们相处得很开心。",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "哈哈，很开心？"
                },
                {
                  "role": "马塞拉",
                  "text": "很好，辛苦您了。"
                }
              ]
            },
            {
              "text": "请不要这样问，塔德菈很能干。",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "我当然知道，她是我精心培养的「猎鹰」呀。"
                }
              ]
            }
          ]
        },
        {
          "role": "马塞拉",
          "text": "但是…「猎鹰」属于猎人，不属于大地。一旦被大地上的牵绊拘束，目光与利爪就会变得迟钝，我又该如何期望它为我捕猎呢？"
        },
        {
          "role": "派蒙",
          "text": "什么啦…虽然我没搞懂你到底在说什么，但你一直「猎鹰」啦「猎鹰」的…让人好火大！"
        },
        {
          "role": "派蒙",
          "text": "塔德菈她是人，是我们的朋友！不是什么「猎鹰」！"
        },
        {
          "role": "马塞拉",
          "text": "「朋友」…"
        },
        {
          "role": "塔德菈",
          "text": "不…不是那样的…"
        },
        {
          "role": "马塞拉",
          "text": "我会稍后跟你谈。"
        },
        {
          "role": "马塞拉",
          "text": "哈哈，请您不要误会呀！我很高兴我的小「猎鹰」交了新朋友！我很高兴，真的。"
        },
        {
          "role": "马塞拉",
          "text": "这里是您的报酬。请您过一阵子再来吧…或许我还有其他事情要拜托您。"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "马塞拉",
          "text": "……"
        },
        {
          "role": "马塞拉",
          "text": "我的小「猎鹰」，我们谈谈下一场「狩猎」吧？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（马塞拉）"
        },
        {
          "role": "'心声'",
          "text": "（…清晨的水雾蒸腾之前，正午的蜃景成形之前，我的猎鹰便已起飞…）"
        },
        {
          "role": "马塞拉",
          "text": "啊，您来了，尊贵的「镇灵主人」。请问您有何要事？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于塔德菈…",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "她很中意你，我看得出来。"
                },
                {
                  "role": "马塞拉",
                  "text": "放心，我不会在意的，年轻人嘛…"
                },
                {
                  "role": "马塞拉",
                  "text": "我会鼓励她表达心意的，作为长辈，作为父亲，我会的…所以，请您不要太为她担心。"
                }
              ]
            },
            {
              "text": "关于「成年礼」…",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "感谢您帮助她完成了成年礼，信任您果然是正确的。"
                },
                {
                  "role": "马塞拉",
                  "text": "接下来，她就要作为成熟的「猎鹰」，领取第一个狩猎任务了。"
                },
                {
                  "role": "马塞拉",
                  "text": "到时候…呵呵，还要请您亲自见证她的成长呀。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（塔德菈）"
        },
        {
          "role": "'心声'",
          "text": "（…下一场「狩猎」，嗯…）"
        },
        {
          "role": "塔德菈",
          "text": "（她局促地别开目光。然后紧张地低下了头。）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还好吗？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "抱歉，狩猎已经结束了。我是父亲的「猎鹰」。"
                },
                {
                  "role": "塔德菈",
                  "text": "不过…我很好，请您不要担心。"
                }
              ]
            },
            {
              "text": "关于你和马塞拉的关系…",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "我说过，他是我的父亲，我是他的「猎鹰」。我跟随他的指令，为他而猎，为他而死…因为他代表了塔尼特的意志。"
                },
                {
                  "role": "塔德菈",
                  "text": "假如我什么时候无法贯彻父亲的指令了，那么作为「猎鹰」的生命就这样结束了。"
                }
              ]
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这么极端吗…？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "极端…？我不知道，我从懂事起就是这样活着的。"
                }
              ]
            },
            {
              "text": "你没想过为自己而活吗？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "……"
                },
                {
                  "role": "塔德菈",
                  "text": "…不，没有。没想过，没期待过。"
                },
                {
                  "role": "塔德菈",
                  "text": "沙漠很冷酷，没有闲暇考虑自己。没有我，还有很多人能活，但没有部族…我没办法一个人活下去。"
                }
              ]
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "啊…不过…你和派蒙的故事，你们的旅行…"
        },
        {
          "role": "塔德菈",
          "text": "有机会的话，我想多听你讲讲。"
        },
        {
          "role": "派蒙",
          "text": "好呀，我们有好多好多故事呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，我会的。",
              "dialogues": []
            },
            {
              "text": "你想听的话，我随时可以给你讲。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "噗…"
        },
        {
          "role": "塔德菈",
          "text": "咳咳，没什么，我只是很高兴…谢谢你…呃，您。"
        }
      ],
      "collapse_ranges": [
        [
          9,
          12
        ],
        [
          13,
