{
  "quest_id": 20034,
  "chapter_num": null,
  "chapter_title": "冒险家，安娜！",
  "type": "iq",
  "route": "Anna the Adventurer!",
  "stories": [
    {
      "story_id": 20034,
      "title": "冒险家，安娜！",
      "description": "蒙德城的安娜，似乎已经成功地成为了一位冒险家。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "安娜",
          "text": "好…今天也要努力完成委托！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是有干劲啊。",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "那是当然了，做冒险家可是很有趣的。"
                },
                {
                  "role": "安娜",
                  "text": "不过…嘿嘿，我执行委托的时候，还是有很多事不熟悉。"
                },
                {
                  "role": "安娜",
                  "text": "旅行者，能请你再陪我去执行一下委托吗？我还有事想要请教你。"
                }
              ]
            },
            {
              "text": "要我陪你去吗？",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "可以吗？嘿嘿，我正好有很多事想要请教你呢。"
                }
              ]
            }
          ]
        },
        {
          "role": "安娜",
          "text": "那我们就快出发吧，今天的委托是…"
        },
        {
          "role": "安娜",
          "text": "嗯…又是护送货运热气球…"
        },
        {
          "type": "subtitle",
          "text": "与安娜一同完成冒险家协会的委托"
        },
        {
          "type": "subtitle",
          "text": "与安娜一同完成冒险家协会的委托"
        },
        {
          "type": "subtitle",
          "text": "击退盗宝团"
        },
        {
          "role": "安东尼",
          "text": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…"
        },
        {
          "role": "旅行者",
          "text": "你不希望她做冒险家吗？"
        },
        {
          "role": "安东尼",
          "text": "……"
        },
        {
          "role": "安东尼",
          "text": "我尊重我妹妹的梦想。"
        },
        {
          "role": "安东尼",
          "text": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。"
        },
        {
          "role": "安东尼",
          "text": "作为她的哥哥，我…会全力支持她。"
        },
        {
          "role": "安东尼",
          "text": "就这样。"
        },
        {
          "type": "subtitle",
          "text": "继续前进，察看情况"
        },
        {
          "type": "subtitle",
          "text": "继续前进，察看情况"
        },
        {
          "role": "班尼特",
          "text": "菲谢尔，你刚才跑得太快了，很危险的…"
        },
        {
          "role": "菲谢尔",
          "text": "本皇女的圣裁之雷，绝不会放任邪孽滋长…"
        },
        {
          "role": "安娜",
          "text": "是菲谢尔前辈，还有班尼特前辈，你们好！"
        },
        {
          "role": "班尼特",
          "text": "是安娜啊，还有旅行者，你们是在这里执行协会的委托吗？"
        },
        {
          "role": "菲谢尔",
          "text": "喔！本皇女的祝圣之人啊，想来是命运的丝线，将你引至此地。"
        },
        {
          "role": "奥兹",
          "text": "小姐很意外会在这种地方见到你，她很高兴。"
        },
        {
          "role": "旅行者",
          "text": "我是陪着安娜出来执行委托的。"
        },
        {
          "role": "安娜",
          "text": "是的，我和旅行者正在这里护送货运热气球呢。"
        },
        {
          "role": "安娜",
          "text": "可是，突然看见有一群盗宝团朝我们冲了过来…"
        },
        {
          "role": "班尼特",
          "text": "抱歉抱歉，这都要怪我…"
        },
        {
          "role": "班尼特",
          "text": "原本我和菲谢尔接了委托，要追查一群盗宝团的下落…"
        },
        {
          "role": "班尼特",
          "text": "奥兹好不容易捕捉了对方的去向，我们正准备去捉拿的时候…我被路上的树枝绊倒，一下子就摔了出去…"
        },
        {
          "role": "班尼特",
          "text": "这伙盗宝团发现动静，掉头就跑，我们只能在后面一直追、一直追…"
        },
        {
          "role": "菲谢尔",
          "text": "无须烦忧。苍紫的罚罪之光，注定裁断恶徒的命运。"
        },
        {
          "role": "奥兹",
          "text": "但小姐，真正出手抓住恶徒的，是旅行者…"
        },
        {
          "role": "菲谢尔",
          "text": "奥，奥兹！"
        },
        {
          "role": "班尼特",
          "text": "话，话说回来，这次真要好好谢谢你们了，多亏有你们在前面拦着！"
        },
        {
          "role": "班尼特",
          "text": "看来，我今天的运气还是挺好的嘛。"
        },
        {
          "role": "旅行者",
          "text": "能帮上忙就好。"
        },
        {
          "role": "班尼特",
          "text": "嘿嘿，那我们先带着这群盗宝团回协会去了，你们执行委托路上也要小心啊，尤其是注意脚下！"
        },
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "安娜",
          "text": "班尼特前辈，还是一如既往地可靠呢。"
        },
        {
          "role": "安娜",
          "text": "菲谢尔前辈…她说的话也一如既往地很有气势！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于班尼特。",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "你说班尼特前辈？"
                },
                {
                  "role": "安娜",
                  "text": "我刚进入协会的时候，班尼特前辈给我解答了很多问题，也帮了我不少忙。"
                },
                {
                  "role": "安娜",
                  "text": "但我听说，班尼特前辈的运气一直很差。"
                },
                {
                  "role": "安娜",
                  "text": "真是不公平啊，明明是那么好的人…"
                }
              ]
            },
            {
              "text": "关于菲谢尔。",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "菲谢尔前辈…嗯…"
                },
                {
                  "role": "安娜",
                  "text": "她、她也很可靠喔！箭法很好，也执行过很多委托。"
                },
                {
                  "role": "安娜",
                  "text": "虽然她说的那些话…我不太能听懂…"
                },
                {
                  "role": "安娜",
                  "text": "但她也是一位…一位很有经验的冒险家！不、不对，调查员！"
                }
              ]
            }
          ]
        },
        {
          "role": "安娜",
          "text": "呼…这样子委托也完成了，谢谢你旅行者，我这就回去协会报告啦。"
        },
        {
          "role": "安娜",
          "text": "不过，为什么我连续几天都是在护送热气球…协会里没有别的委托了吗…"
        }
      ]
    }
  ]
}