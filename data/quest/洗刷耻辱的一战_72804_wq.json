{
  "quest_id": 72804,
  "chapter_num": null,
  "chapter_title": "洗刷耻辱的一战",
  "type": "wq",
  "route": "Battle of Revenge",
  "stories": [
    {
      "story_id": 72804,
      "title": "洗刷耻辱的一战",
      "description": "朝仓追查到了海乱鬼的行踪，讨伐海乱鬼，夺回武器的时机到了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与朝仓对话"
        },
        {
          "type": "subtitle",
          "text": "击败海乱鬼"
        },
        {
          "type": "subtitle",
          "text": "审问海乱鬼"
        },
        {
          "role": "「海乱鬼」",
          "text": "哎哟！好汉，好汉留手！你这是从哪里找来的帮手…"
        },
        {
          "role": "朝仓",
          "text": "恶徒！现在就把武器还给我！"
        },
        {
          "role": "「海乱鬼」",
          "text": "你、你居然还惦记着那把武器…"
        },
        {
          "role": "朝仓",
          "text": "我只为取回我的武器，你告诉我那把武器在哪，我留你一条生路。"
        },
        {
          "role": "「海乱鬼」",
          "text": "这…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别和他废话了。",
              "dialogues": []
            },
            {
              "text": "我们还是找下一个人…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「海乱鬼」",
          "text": "啊哟！好汉留手！怎得如此暴躁，我也没说我不说啊！"
        },
        {
          "role": "「海乱鬼」",
          "text": "那…那把武器，被我们老大留着当藏品了，你们要是想拿，去那边的营地里找他就可以了！"
        },
        {
          "role": "朝仓",
          "text": "哼，算你识相。"
        },
        {
          "role": "「海乱鬼」",
          "text": "那二位好汉，在下…"
        },
        {
          "role": "旅行者",
          "text": "滚！"
        },
        {
          "role": "「海乱鬼」",
          "text": "是！"
        },
        {
          "role": "朝仓",
          "text": "武艺不怎么样，逃跑倒是挺在行！"
        },
        {
          "role": "旅行者",
          "text": "卖同伴卖得这么果断…"
        },
        {
          "role": "朝仓",
          "text": "海乱鬼终归只是一群为利而聚的乌合之众，谈不上什么忠诚，也谈不上什么信念。"
        },
        {
          "role": "朝仓",
          "text": "遇见了麻烦事，第一反应是拍屁股走人，这实在是太正常不过了。"
        },
        {
          "role": "朝仓",
          "text": "不过，还是多亏了阁下在一旁以声势压人，不然他可不会这么容易就服软。"
        },
        {
          "role": "朝仓",
          "text": "但接下来，我们就必须直奔海乱鬼的大本营了。"
        },
        {
          "role": "朝仓",
          "text": "还是依照之前的计划，阁下，我会直接去斩了那个头领，剩下的杂鱼就交给阁下了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "我一个打十个。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "朝仓",
          "text": "那就拜托阁下了！"
        },
        {
          "type": "subtitle",
          "text": "前往海乱鬼的营地"
        },
        {
          "type": "subtitle",
          "text": "前往海乱鬼的营地"
        },
        {
          "role": "「海乱鬼」头领",
          "text": "你？哈哈哈，不是上次的那个毛头小子吗？怎么，又来给我送藏品了？"
        },
        {
          "role": "朝仓",
          "text": "我是来取回我的武器的！"
        },
        {
          "role": "「海乱鬼」头领",
          "text": "嗯…不错，倒是有点胆色。但只找了一个帮手就敢闯到这里来，你未免也太看不起我了。"
        },
        {
          "role": "「海乱鬼」头领",
          "text": "不过，看在你到这里的这份胆色上，我就给你这个机会，上前来！我们去旁边玩玩。"
        },
        {
          "role": "「海乱鬼」头领",
          "text": "但是嘛…我的这些手下，当然也不能闲着，你不是带了个帮手来吗？就让他来陪他们玩玩吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "尽管放马过来。",
              "dialogues": []
            },
            {
              "text": "只怕我玩不尽兴。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「海乱鬼」头领",
          "text": "哈哈哈，口气倒是挺大。小的们，给我好好…折腾一下这愣头青！"
        },
        {
          "role": "「海乱鬼」头领",
          "text": "至于你，我们去旁边吧。"
        },
        {
          "role": "朝仓",
          "text": "那就交给你了，阁下…"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "朝仓",
          "text": "不胜感激。我会马上把他斩掉，然后回来帮您的。"
        },
        {
          "role": "「海乱鬼」头领",
          "text": "你的口气也不小啊，想要斩我的话，就自己来试试吧！"
        },
        {
          "type": "subtitle",
          "text": "击败海乱鬼头领的部下"
        },
        {
          "type": "subtitle",
          "text": "与朝仓对话"
        },
        {
          "role": "朝仓",
          "text": "阁下，看你气息平稳，那些海乱鬼对你而言，果然不算什么。"
        },
        {
          "role": "旅行者",
          "text": "看起来你也赢了。"
        },
        {
          "role": "朝仓",
          "text": "没错，但是很惭愧…最后那家伙居然虚晃一招，拼着被我刺了一枪后逃跑了。"
        },
        {
          "role": "朝仓",
          "text": "但是他伤得很重，我想，几年内他应该不可能再出来作乱了。"
        },
        {
          "role": "朝仓",
          "text": "最主要的是，我亲手击败了他，也夺回了武器，彻底洗刷了耻辱。"
        },
        {
          "role": "旅行者",
          "text": "恭喜你，朝仓。"
        },
        {
          "role": "朝仓",
          "text": "实在感谢，但我还不能松懈！"
        },
        {
          "role": "朝仓",
          "text": "这一切的起因，都是我的武艺还不够精湛，以后我会继续加倍刻苦修炼，精进武艺的。"
        },
        {
          "role": "朝仓",
          "text": "所以…还请阁下多多关照，常来和我对练了！"
        },
        {
          "role": "朝仓",
          "text": "哦，对了，这些东西还请阁下收下。虽然不算太多…但也是我的一份心意。"
        },
        {
          "role": "朝仓",
          "text": "再次谢谢您，阁下！"
        }
      ]
    }
  ]
}