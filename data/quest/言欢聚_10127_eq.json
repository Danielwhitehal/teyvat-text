{
  "quest_id": 10127,
  "chapter_num": "游水酝诗籍 第一首",
  "chapter_title": "言欢聚",
  "type": "eq",
  "route": "Congenial Gathering",
  "stories": [
    {
      "story_id": 40123,
      "title": "言欢聚",
      "description": "听说蒙德和璃月合办了一场活动，打听到消息的你们准备前去一探究竟…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "听说蒙德和璃月最近在合办什么活动，好难得啊，到底是什么主题把大家凑到了一起呢？"
        },
        {
          "role": "派蒙",
          "text": "我们想办法打听打听吧，让我想想…消息灵通的地方，又高、视野又好的地方…"
        },
        {
          "role": "派蒙",
          "text": "啊，有了！就去望舒客栈吧，快点快点！"
        },
        {
          "type": "subtitle",
          "text": "前往望舒客栈"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，这次会是什么热闹的活动呢？"
        },
        {
          "role": "胡桃",
          "text": "哎哟哟，这不是旅行者和派蒙吗？真是比路上摔跤捡到摩拉还巧了，刚刚才聊到你们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "二位好。",
              "dialogues": []
            },
            {
              "text": "太巧了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "好久不见，看你的样子，一定在旅途中又收获了不少精彩的故事吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一如既往。",
              "dialogues": []
            },
            {
              "text": "曲折复杂。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "嗯嗯，果然和我想得一样。"
        },
        {
          "role": "派蒙",
          "text": "你们刚刚在聊什么呀？是什么好玩好吃的吗？"
        },
        {
          "role": "胡桃",
          "text": "哼哼，我们说到有这么一位旅行者和他的伙伴，二人游历诸国，交三朋四友，行五湖六海，七上八下，九死十生…"
        },
        {
          "role": "派蒙",
          "text": "怎…怎么越来越惨了？"
        },
        {
          "role": "温迪",
          "text": "最近在石门之下，有美酒佳肴，大家喝下八杯七盏，写个六句五首，游历四方的你，从这三言两语中，一定猜到是什么活动了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "数数大会！",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "哈哈，那感觉也不错呢。"
                },
                {
                  "role": "温迪",
                  "text": "是诗歌大会哟，蒙德和璃月合办的诗歌大会。"
                }
              ]
            },
            {
              "text": "诗歌大会！",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "没错，正是由蒙德和璃月合办的诗歌大会。"
                }
              ]
            }
          ]
        },
        {
          "role": "温迪",
          "text": "还记得海灯节时，我和这位胡堂主的约定吗？"
        },
        {
          "role": "派蒙",
          "text": "哦，是有机会一起写诗的那个吗？"
        },
        {
          "role": "胡桃",
          "text": "正是正是，那晚饭桌之上，本堂主就觉得这位小哥器宇不凡，品味高雅。乃是难得一遇的知音。"
        },
        {
          "role": "胡桃",
          "text": "这不，终于让我逮到机会，本堂主不惜亲自出马，又是拜托玉京台又是联系西风骑士团，好一番东奔西走…"
        },
        {
          "role": "胡桃",
          "text": "本着分享诗歌，友好交流的原则，办它这么一出「两国诗歌握手言欢会」！"
        },
        {
          "role": "派蒙",
          "text": "好奇怪的名字…"
        },
        {
          "role": "温迪",
          "text": "璃月诗词闻名远近，蒙德则被称为「诗与酒的城邦」。这么好的交流机会，当然是要办得越热闹越好啦。"
        },
        {
          "role": "温迪",
          "text": "我和胡桃小姐共同担任此次诗歌大会的主持人。我学璃月格律还没多久，刚刚也算献丑啦。"
        },
        {
          "role": "胡桃",
          "text": "哪里哪里，温迪刚才接的那段很了不起嘛！"
        },
        {
          "role": "温迪",
          "text": "过奖过奖。"
        },
        {
          "role": "派蒙",
          "text": "听起来挺有趣的，我们也去参加吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，喜欢写诗。",
              "dialogues": []
            },
            {
              "text": "嗯，期待大家的诗。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我知道你很厉害的！上次璃月的那个对联，好像是「风起地风不起」，你一下子就对上来了呢！"
        },
        {
          "role": "旅行者",
          "text": "「云来海云再来」。"
        },
        {
          "role": "胡桃",
          "text": "嚯嚯，你很有这方面的天赋嘛！看来我们到时候得加点儿难度才行。"
        },
        {
          "role": "派蒙",
          "text": "哦，我懂了。你们是在这儿讨论诗歌大会的活动吧？"
        },
        {
          "role": "胡桃",
          "text": "哎哟哟，派蒙的脑袋真是越来越灵光了！居然这么轻而易举地就——猜错了。"
        },
        {
          "role": "派蒙",
          "text": "欸？等等，怎么是猜错了呀？"
        },
        {
          "role": "温迪",
          "text": "我们是想请一位特别的嘉宾…"
        },
        {
          "role": "魈",
          "text": "…刚才就说了，我不去。"
        },
        {
          "role": "派蒙",
          "text": "魈！原来你在呀！"
        },
        {
          "role": "魈",
          "text": "我不曾作诗，更谈何点评。况且，我身负业障，最忌人多嘈杂之处，几位并非不知。"
        },
        {
          "role": "胡桃",
          "text": "哎呀，凡事总有第一次。谁不是从「地上一根草，树上两只鸟」开始的呢？"
        },
        {
          "role": "胡桃",
          "text": "上仙就算不到现场，在附近山头看看热闹捧捧场也行嘛。"
        },
        {
          "role": "胡桃",
          "text": "难得离客栈这么近，下来溜达溜达不是正好？我看客栈下面还有好多好玩的呢。"
        },
        {
          "role": "温迪",
          "text": "有这位大名鼎鼎的旅行者在，也没什么不放心的吧？"
        },
        {
          "role": "旅行者",
          "text": "一起来玩玩吧。"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "魈",
          "text": "我会考虑。"
        },
        {
          "role": "温迪",
          "text": "时间差不多了，你们要去会场逛逛吗？这次好像来了不少朋友呢。"
        },
        {
          "role": "胡桃",
          "text": "对对对，我和温迪还想讨论个开场诗，待会儿就到。说不定还能再给上仙软磨硬泡一下。"
        },
        {
          "role": "派蒙",
          "text": "好，那我们先走一步啦。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（胡桃&温迪）"
        },
        {
          "role": "温迪",
          "text": "…这样出场如何？"
        },
        {
          "role": "胡桃",
          "text": "嗯，不错不错，最好再有些气势！"
        },
        {
          "role": "胡桃",
          "text": "不如我们先「哐啷」一下，然后再「呲溜」一下！最后再「呼哨」——"
        },
        {
          "role": "胡桃",
          "text": "懂了吗？"
        },
        {
          "role": "温迪",
          "text": "了解了解。"
        },
        {
          "type": "subtitle",
          "text": "前往石门"
        },
        {
          "role": "派蒙",
          "text": "哇，好热闹呀，原来已经来了这么多人。"
        },
        {
          "role": "派蒙",
          "text": "有好多熟悉的面孔呢，我们去打打招呼吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（浣溪）"
        },
        {
          "role": "浣溪",
          "text": "有这么一个和蒙德朋友一起写诗的机会还真不错。"
        },
        {
          "role": "浣溪",
          "text": "不过光在会场站着也挺无聊的，我就把老家的果蔬拿来买买赚外快了。"
        },
        {
          "role": "浣溪",
          "text": "哦，当然，想要交流诗歌的话，我也奉陪呦。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（老周叔）"
        },
        {
          "role": "老周叔",
          "text": "哈哈…这年轻人的花样可越来越多了。"
        },
        {
          "role": "老周叔",
          "text": "诗歌大会…嗯，遥想我年轻的时候，也有好多能写的故事…"
        },
        {
          "role": "老周叔",
          "text": "哎…山月常在，红颜易消啊…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（乔姨）"
        },
        {
          "role": "乔姨",
          "text": "连石门都热闹起来啦？哈哈，这还真是不多见啊。"
        },
        {
          "role": "乔姨",
          "text": "年轻人，想歇就歇会儿吧，可别累着。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（约亨）"
        },
        {
          "role": "约亨",
          "text": "这里的位置您随便坐，看看风景写写诗，再来一杯上好的饮品。"
        },
        {
          "role": "约亨",
          "text": "…这么看来，璃月和蒙德娱乐消遣的方式还挺相似？"
        },
        {
          "type": "subtitle",
          "text": "与众人对话（1/3）"
        },
        {
          "role": "行秋",
          "text": "咦？瞧瞧谁来了，看来这次诗歌大会高人辈出。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，行秋和重云也来玩了呀。"
        },
        {
          "role": "重云",
          "text": "我本想去山上练功，结果半道被他拦了路，拉到这里来了。"
        },
        {
          "role": "行秋",
          "text": "哎，怎么能这么说呢。确保两国友谊的盛会不被妖邪侵扰，这不是璃月方士的职责吗？"
        },
        {
          "role": "行秋",
          "text": "再说了，趁这机会多结识些江湖侠士，岂不妙哉？你刚才不就好奇，那位蒙德的女侠是用什么方式举起那么多重物的吗？"
        },
        {
          "role": "派蒙",
          "text": "是说诺艾尔吗？她的力气可是很大的！"
        },
        {
          "role": "行秋",
          "text": "哦？既然是二位的熟人，就麻烦稍后为我们引荐一番了。"
        },
        {
          "role": "重云",
          "text": "好吧，但你可别忘了答应要帮我查的事，我是为了这个才跟来的。"
        },
        {
          "role": "派蒙",
          "text": "咦？什么事呀？"
        },
        {
          "role": "行秋",
          "text": "咳咳，那件事我自然忘不了。派蒙也别着急，到时自然就知道了。"
        },
        {
          "role": "派蒙",
          "text": "…嗯？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（行秋&重云）"
        },
        {
          "role": "重云",
          "text": "那东西真不是妖邪吗？"
        },
        {
          "role": "行秋",
          "text": "集思广益的话，肯定会得到答案的。"
        },
        {
          "role": "重云",
          "text": "也对…等等，你不会想告诉这里所有人吧？"
        },
        {
          "type": "subtitle",
          "text": "与众人对话（2/3）"
        },
        {
          "role": "派蒙",
          "text": "迪奥娜！"
        },
        {
          "role": "迪奥娜",
          "text": "旅行者和派蒙？你们也来啦。"
        },
        {
          "role": "派蒙",
          "text": "迪奥娜是来这里调酒的吗？"
        },
        {
          "role": "迪奥娜",
          "text": "没错，我是此次活动的猫尾酒馆特派员，也是代表蒙德酒业的调酒师。"
        },
        {
          "role": "派蒙",
          "text": "代表蒙德酒业？我还以为迪奥娜一定会讨厌这样的工作呢。"
        },
        {
          "role": "迪奥娜",
          "text": "我当然讨厌啦！但对我来说，这可是摧毁蒙德酒业千载难逢的好机会！"
        },
        {
          "role": "派蒙",
          "text": "咦？为什么…"
        },
        {
          "role": "迪奥娜",
          "text": "哼，只要我在调酒的时候加入各种奇怪的东西，调出超级难喝的酒，那么以后蒙德的酒，就再也卖不出去了！"
        },
        {
          "role": "派蒙",
          "text": "呃…但我觉得可能会起到相反的效果。"
        },
        {
          "role": "迪奥娜",
          "text": "哼！等着瞧吧，这次我可不会失误的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "祝你成功。",
              "dialogues": []
            },
            {
              "text": "别太辛苦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "迪奥娜会一起来写诗吗？"
        },
        {
          "role": "迪奥娜",
          "text": "诗歌啊…我倒是在酒馆里听吟游诗人们唱过好几首，但自己还从没写过。"
        },
        {
          "role": "派蒙",
          "text": "那就一起来玩玩吧，一定很有趣的！"
        },
        {
          "role": "迪奥娜",
          "text": "…好吧，有时间我就来。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（迪奥娜）"
        },
        {
          "role": "迪奥娜",
          "text": "是加鳅鳅宝玉好，还是加马尾好呢…"
        },
        {
          "role": "迪奥娜",
          "text": "对了，既然在璃月，就加点绝云椒椒吧！"
        },
        {
          "type": "subtitle",
          "text": "与众人对话（3/3）"
        },
        {
          "role": "派蒙",
          "text": "米卡！诺艾尔！"
        },
        {
          "role": "米卡",
          "text": "啊，是旅行者和派蒙！"
        },
        {
          "role": "诺艾尔",
          "text": "你们也是来参加「两国诗歌握手言欢会」的吗？"
        },
        {
          "role": "派蒙",
          "text": "呃…你倒是念着也不觉得奇怪…"
        },
        {
          "role": "旅行者",
          "text": "二位是蒙德的代表吗？"
        },
        {
          "role": "米卡",
          "text": "代…代表什么的…不至于啦。"
        },
        {
          "role": "米卡",
          "text": "我们是西风骑士团派来维护会场秩序，布置现场的。"
        },
        {
          "role": "米卡",
          "text": "虽然…这些桌椅基本都是诺艾尔前辈一路从蒙德城扛过来的…我没出上什么力…"
        },
        {
          "role": "诺艾尔",
          "text": "不是这样的，会场的选址和布设规划，都多亏了米卡事先测绘，你明明也出了很多力。而且按理来说，该是我称你为米卡前辈才对。"
        },
        {
          "role": "米卡",
          "text": "啊不不不，这怎么行？还是和以前一样，叫我米卡就好！"
        },
        {
          "role": "派蒙",
          "text": "总感觉这是个会一直寒暄下去的组合呢。"
        },
        {
          "role": "诺艾尔",
          "text": "琴团长说，在完成工作的基础上，建议我们多走走看看，积极参加诗歌大会。"
        },
        {
          "role": "诺艾尔",
          "text": "但我平时不会写诗，不知道能不能融入大家…"
        },
        {
          "role": "米卡",
          "text": "其实我也有些担心…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "重在参与。",
              "dialogues": []
            },
            {
              "text": "谁都有第一次。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！到时候我们也会加入！旅行者可是很能写的！"
        },
        {
          "role": "米卡",
          "text": "真的吗？那…那就拜托你了。"
        },
        {
          "role": "诺艾尔",
          "text": "难道说…写诗也是成为一名合格骑士的必修课吗？"
        },
        {
          "role": "派蒙",
          "text": "倒也没有那么夸张啦…"
        },
        {
          "role": "派蒙",
          "text": "那就这么说好了，待会儿见！"
        },
        {
          "role": "米卡",
          "text": "好的！有劳两位老师了！"
        },
        {
          "role": "诺艾尔",
          "text": "啊，怎么被米卡抢先了？我也想拜托二位。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "都能教，都能教。",
              "dialogues": []
            },
            {
              "text": "一起写，一起写。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（诺艾尔&米卡）"
        },
        {
          "role": "诺艾尔",
          "text": "诗歌最重要的是什么呢？米卡你知道吗？"
        },
        {
          "role": "米卡",
          "text": "欸？我…我也不清楚。"
        },
        {
          "role": "米卡",
          "text": "早知道的话…就该多去丽莎小姐那儿看看了。"
        },
        {
          "type": "subtitle",
          "text": "参与活动的开幕"
        },
        {
          "type": "subtitle",
          "text": "突然，一阵强风吹得人们闭上了眼。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "温迪",
          "text": "风捧着诗与音符，飘到了陌生的国度。"
        },
        {
          "role": "胡桃",
          "text": "水下鱼儿两条，吃得满满一肚。"
        },
        {
          "role": "温迪",
          "text": "风晶蝶披上金色霓裳，琉璃内小灯莹亮。"
        },
        {
          "role": "胡桃",
          "text": "团雀叼走稻米，林猪急得拱地。"
        },
        {
          "role": "温迪",
          "text": "欢迎各位朋友来到璃月与蒙德合办的诗歌大会现场。"
        },
        {
          "role": "胡桃",
          "text": "全称——「两国诗歌握手言欢会」！"
        },
        {
          "role": "胡桃",
          "text": "我们是此次大会的主持人——璃月小巷派打油诗人，胡桃。"
        },
        {
          "role": "温迪",
          "text": "——蒙德吟游派喝酒诗人，温迪。"
        },
        {
          "role": "温迪",
          "text": "本次大会意在促进两国诗歌友好交流，大家多交朋友，玩得开心最重要。"
        },
        {
          "role": "胡桃",
          "text": "来者皆是客，都图一个乐！"
        },
        {
          "role": "温迪",
          "text": "各位放心，不论你之前是否写过诗歌，都有机会在大会上一展身手。"
        },
        {
          "role": "温迪",
          "text": "要我说的话，诗歌最重要的是「情」，是把自己平时藏于内心、难于诉说的想法表达出来，形式上没有雅俗之分。"
        },
        {
          "role": "胡桃",
          "text": "为了让大家玩得尽兴，我和温迪精心准备了三个主题，分三天揭晓。"
        },
        {
          "role": "胡桃",
          "text": "事不宜迟，这第一个主题便是——猜诗谜！"
        },
        {
          "role": "行秋",
          "text": "（诗谜吗…有意思，作为诗歌大会的热身的确是个不错的选择。）"
        },
        {
          "role": "米卡",
          "text": "（呼…没有一上来就让我写诗真是太好了。）"
        },
        {
          "role": "胡桃",
          "text": "各位新老朋友看到现场挂着的灯笼了吗？那就是为诗谜准备的。"
        },
        {
          "role": "胡桃",
          "text": "大家把谜题挂到灯笼上，我和温迪会挑选其中的一些作为题目来供大家竞猜。"
        },
        {
          "role": "胡桃",
          "text": "接下来就给大家一些时间，写诗谜，挂诗谜，走走逛逛，讨论一下，待会儿猜对最多的人有奖哦。"
        },
        {
          "role": "温迪",
          "text": "那么——「两国诗歌握手言欢会」，正式开始！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（温迪）"
        },
        {
          "role": "温迪",
          "text": "欸嘿，我们刚才的出场还不赖吧？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（胡桃）"
        },
        {
          "role": "胡桃",
          "text": "魈上仙最后还是不肯来，只说会在哪处山头头上看两眼。可惜可惜，我原本都为他想好定场诗了。"
        },
        {
          "type": "subtitle",
          "text": "查看第一个诗谜"
        },
        {
          "role": "派蒙",
          "text": "让我看看这个灯笼上贴的…"
        },
        {
          "role": "派蒙",
          "text": "唔…「娟娟思乡念，盈盈花满园，来客问何故，寻梦去九天。」"
        },
        {
          "role": "派蒙",
          "text": "这一看就是璃月诗人写的。"
        },
        {
          "role": "米卡",
          "text": "我刚才也看到了这一条，璃月的诗，有时还挺难懂的。"
        },
        {
          "role": "诺艾尔",
          "text": "梦…天…是在说某种鸟类吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…大致意思就是，这东西离家很远，一开就一大片，飞得也很高。是这样吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "简明易懂。",
              "dialogues": []
            },
            {
              "text": "通俗达意。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "诺艾尔",
          "text": "不愧是派蒙，看来我平时钻研得还不够多。"
        },
        {
          "role": "派蒙",
          "text": "也…也没有那么厉害啦，到璃月走几趟，不知不觉就看得懂这些了。"
        },
        {
          "role": "米卡",
          "text": "啊，我明白，随大团长在外考察的时候，我也不知不觉就会受当地风土人情的影响。"
        },
        {
          "role": "派蒙",
          "text": "不过话说回来，这个诗谜到底说的是什么东西呢？"
        },
        {
          "role": "诺艾尔",
          "text": "飞得又高又远…我会想到蒲公英。"
        },
        {
          "role": "米卡",
          "text": "哦！有道理，而且在蒙德人眼里，蒲公英确实能传递思念。"
        },
        {
          "role": "诺艾尔",
          "text": "但我们会不会想得太简单了，毕竟这像是璃月风格的诗谜。璃月会不会有类似的植物？"
        },
        {
          "role": "诺艾尔",
          "text": "旅行者觉得呢？"
        },
        {
          "role": "旅行者",
          "text": "我觉得「蒲公英」挺对的。"
        },
        {
          "role": "米卡",
          "text": "好，那就作为一个备选答案吧。"
        },
        {
          "role": "旅行者",
          "text": "重要的是「情」。"
        },
        {
          "role": "诺艾尔",
          "text": "原来是这样，就像温迪先生说的，只要解释合理，在诗中有所感悟，答案或许没那么重要。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，不管真正的答案是什么，这个猜谜过程也挺有趣嘛。"
        },
        {
          "role": "派蒙",
          "text": "我们去看看下一个谜题吧！"
        },
        {
          "role": "诺艾尔",
          "text": "嗯，我也去找找有没有蒙德风格的诗谜吧。"
        },
        {
          "type": "subtitle",
          "text": "查看诗谜"
        },
        {
          "role": "灯笼上的诗谜",
          "text": "「娟娟思乡念，盈盈花满园，来客问何故，寻梦去九天。」"
        },
        {
          "type": "subtitle",
          "text": "查看第二个诗谜"
        },
        {
          "role": "派蒙",
          "text": "这张上写的是…呃，这字好难认呀…"
        },
        {
          "role": "派蒙",
          "text": "…「四四方方像块饼，胡椒芝麻里面淋；一粒一粒嘴里过，越吃脑袋越聪明。」"
        },
        {
          "role": "派蒙",
          "text": "哇，看得我都流口水了，还有这么好的食物吗？吃完还能变聪明！"
        },
        {
          "role": "行秋",
          "text": "哈哈，派蒙，诗谜可不能光看表面的意思。不然可就猜不到谜底了。"
        },
        {
          "role": "派蒙",
          "text": "咦？那行秋想到是什么了吗？"
        },
        {
          "role": "行秋",
          "text": "这个嘛…"
        },
        {
          "role": "重云",
          "text": "这纸片就是行秋刚刚贴上去的。"
        },
        {
          "role": "派蒙",
          "text": "哦！原来行秋就是出题人啊！我还以为你会写得更文雅呢。"
        },
        {
          "role": "行秋",
          "text": "这次活动以交流为重，会场上有好多蒙德的朋友，我还是尝试写得通俗一点，这样大家才都能尽兴嘛。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿…那，那能不能悄悄把谜底告诉我？"
        },
        {
          "role": "行秋",
          "text": "这可不行，派蒙就乖乖等着谜底揭晓吧。"
        },
        {
          "role": "派蒙",
          "text": "哼，小气。"
        },
        {
          "role": "行秋",
          "text": "不服气的话，你也出一个诗谜来难倒我怎么样？"
        },
        {
          "role": "派蒙",
          "text": "出…出就出！谁怕谁！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你会帮我的吧？"
        },
        {
          "role": "旅行者",
          "text": "乐意效劳。"
        },
        {
          "role": "派蒙",
          "text": "还是你对我好！"
        },
        {
          "role": "行秋",
          "text": "哈哈，那我就翘首以盼二位的诗才了。"
        },
        {
          "role": "派蒙",
          "text": "哼，擂台上见吧！"
        },
        {
          "type": "subtitle",
          "text": "查看诗谜"
        },
        {
          "role": "灯笼上的诗谜",
          "text": "「四四方方像块饼，胡椒芝麻里面淋；一粒一粒嘴里过，越吃脑袋越聪明。」"
        },
        {
          "type": "subtitle",
          "text": "查看第三个诗谜"
        },
        {
          "role": "派蒙",
          "text": "唔…虽说要出个诗谜，但完全不知道该怎么编呢。"
        },
        {
          "role": "派蒙",
          "text": "我还是看看别人写的找找灵感…"
        },
        {
          "role": "派蒙",
          "text": "「小小身板四条腿，不吃草也不喝水；见到客人板着脸，驮人一天不嫌累。」"
        },
        {
          "role": "派蒙",
          "text": "…这是在说什么动物吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "动物是需要进食的。",
              "dialogues": []
            },
            {
              "text": "应该说的是其他东西。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪奥娜",
          "text": "是椅子啦。"
        },
        {
          "role": "派蒙",
          "text": "咦？迪奥娜这就猜出来了？还是说这是迪奥娜出的？"
        },
        {
          "role": "迪奥娜",
          "text": "没有没有，我也是突然想到的。"
        },
        {
          "role": "迪奥娜",
          "text": "我经常教育店里的猫猫们，说椅子们干活已经很辛苦了，不要在它们腿上磨爪子。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样…诗谜会用其他东西来迷惑大家…"
        },
        {
          "role": "迪奥娜",
          "text": "你在出诗谜吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯，多亏迪奥娜，我想出一个啦！"
        },
        {
          "role": "迪奥娜",
          "text": "我是不是也想一个比较好呢…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿， 我贴好了，要我把谜底告诉迪奥娜吗？"
        },
        {
          "role": "迪奥娜",
          "text": "噢不用不用，我对奖品不是很在意啦。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那我们差不多该过去那边了。"
        },
        {
          "role": "迪奥娜",
          "text": "嗯，你们玩得开心。"
        },
        {
          "type": "subtitle",
          "text": "查看诗谜"
        },
        {
          "role": "灯笼上的诗谜",
          "text": "「小小身板四条腿，不吃草也不喝水；见到客人板着脸，驮人一天不嫌累。」"
        },
        {
          "type": "subtitle",
          "text": "查看诗谜（派蒙出的）"
        },
        {
          "role": "灯笼上的诗谜",
          "text": "「什么东西没有翅膀却能飞，悬在空中不怕累；肚子里满满当当是摩拉，沉海里咕嘟咕嘟捞不起它。」"
        },
        {
          "type": "subtitle",
          "text": "等待猜诗谜活动开始"
        },
        {
          "role": "胡桃",
          "text": "哟，看来大家逛得差不多了。来来来，大伙看向这边喽。"
        },
        {
          "role": "胡桃",
          "text": "我和温迪，刚才已经把大家写下的诗谜都挑选了一遍，顺带自己也添了些进去，待会儿随机抽选。"
        },
        {
          "role": "胡桃",
          "text": "被选到的诗谜，出题人记得最后出来公布正确答案。答题人答对得一分，没人答得上的话，出题人得一分。很公平吧？"
        },
        {
          "role": "温迪",
          "text": "当然，出题人公布的谜底，也得大家认可才行。"
        },
        {
          "role": "胡桃",
          "text": "没错没错，要是没有什么问题的话，我就开始抽题目啦。"
        },
        {
          "role": "米卡",
          "text": "（…希望抽到一些我会的。不对，难道是抢答？我…我要举手举得很快吗？）"
        },
        {
          "role": "派蒙",
          "text": "也不知道我的题目能不能被抽到呢…"
        },
        {
          "role": "胡桃",
          "text": "第一题，我看看…哎哟，这诗谜和字都挺有意思——"
        },
        {
          "role": "胡桃",
          "text": "「四四方方像块饼，胡椒芝麻里面淋；一粒一粒嘴里过，越吃脑袋越聪明。」"
        },
        {
          "role": "派蒙",
          "text": "这就抽到了行秋写的！"
        },
        {
          "role": "行秋",
          "text": "不快些答的话，就要被别人抢先喽？"
        },
        {
          "role": "派蒙",
          "text": "这！可恶…是…是披萨！答案是披萨吧！"
        },
        {
          "role": "胡桃",
          "text": "咘咘——就算出题人不出面，我也知道这答案不对。披萨怎么能让人脑袋聪明呢？"
        },
        {
          "role": "胡桃",
          "text": "而且我记得这种异国菜肴是圆的吧？和摩拉肉一样。"
        },
        {
          "role": "派蒙",
          "text": "可是…吃下披萨会很开心，一开心想问题就能更顺利…"
        },
        {
          "role": "派蒙",
          "text": "好吧，我承认自己着急了…"
        },
        {
          "role": "诺艾尔",
          "text": "（难道是什么其他菜肴，不对，诗谜没有那么简单，能让人变聪明的东西…）"
        },
        {
          "role": "派蒙",
          "text": "早知道就多看些书，这种时候就用得上了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……！",
              "dialogues": []
            },
            {
              "text": "派蒙！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "怎…怎么了？你想到什么了？"
        },
        {
          "role": "旅行者",
          "text": "「书」呀！"
        },
        {
          "role": "派蒙",
          "text": "啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "四四方方，上面还有大大小小的字！",
              "dialogues": []
            },
            {
              "text": "嘴里读过之后就能变聪明！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哦！原来是这样！"
        },
        {
          "role": "派蒙",
          "text": "…是「书」！谜底是「书」！"
        },
        {
          "role": "行秋",
          "text": "哈哈，居然这么快就被猜出来了，这可是我的得意之作呢。"
        },
        {
          "role": "胡桃",
          "text": "哦？看来出题人已经公布了正确答案。好，那派蒙得一分！"
        },
        {
          "role": "米卡",
          "text": "（欸？原来是「书」吗？哎，感觉再努力一下也能想出来的…）"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们可是很厉害的！"
        },
        {
          "role": "旅行者",
          "text": "…咳咳。"
        },
        {
          "role": "派蒙",
          "text": "我…我是说你可是很厉害的！这一分多亏了你！"
        },
        {
          "role": "温迪",
          "text": "那么我来选第二题——"
        },
        {
          "role": "米卡",
          "text": "（这次我也要试着抢答一下…）"
        },
        {
          "role": "温迪",
          "text": "「高云万仞上，郁郁凄雪间，孤直驻寒台，圣贤皆贫贱。」看来是一个璃月诗谜呢。"
        },
        {
          "role": "诺艾尔",
          "text": "啊！那是…"
        },
        {
          "role": "米卡",
          "text": "我知道！"
        },
        {
          "role": "诺艾尔",
          "text": "……"
        },
        {
          "role": "米卡",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "咦？他们的反应像是讨论过这个诗谜呢。好像是在说一种生活在又高又冷的地方的植物吧？"
        },
        {
          "role": "诺艾尔",
          "text": "还是米卡来说吧，你是西风骑士团的骑士，代表了我们蒙德的大家。"
        },
        {
          "role": "米卡",
          "text": "不不不，这怎么好意思？刚才也是诺艾尔前辈先想出来的，还是你来说吧。"
        },
        {
          "role": "诺艾尔",
          "text": "我的答案也不一定正确，况且是米卡抢到了回答的机会…"
        },
        {
          "role": "米卡",
          "text": "可刚才，是诺艾尔前辈先…"
        },
        {
          "role": "温迪",
          "text": "赛场上大家如此谦让，真是道不错的风景。"
        },
        {
          "role": "温迪",
          "text": "不如，二位同时说出自己的答案吧？如果正确的话，就各得一分。"
        },
        {
          "role": "诺艾尔",
          "text": "（刚刚不知不觉就…）"
        },
        {
          "role": "米卡",
          "text": "（我…我俩推让得太久了吗…）"
        },
        {
          "role": "米卡",
          "text": "那…那么，诺艾尔前辈…"
        },
        {
          "role": "诺艾尔",
          "text": "嗯，我们的答案是——"
        },
        {
          "role": "米卡",
          "text": "「塞西莉亚花」。"
        },
        {
          "role": "温迪",
          "text": "听起来很像正确答案，这种开在高处的花被人们赋予了美好的寓意，也是很多人心中的「风之花」。"
        },
        {
          "role": "温迪",
          "text": "欸…没有人出来公布答案，说明这不是出题人的本意呢。还有其他回答吗？"
        },
        {
          "role": "米卡",
          "text": "（居然错了吗…难道是璃月的植物？）"
        },
        {
          "role": "行秋",
          "text": "…是「清心」吗？此诗给人一种清高孤傲之印象。"
        },
        {
          "role": "出题人",
          "text": "没错，这是我出的题目。谜底就是「清心」。"
        },
        {
          "role": "派蒙",
          "text": "哎呀！被行秋抢先了！"
        },
        {
          "role": "出题人",
          "text": "…不过，刚才听完这位主持人的描述，我想起来了。之前在书中读到过「塞西莉亚花」，那的确是符合描述的高洁之花。"
        },
        {
          "role": "出题人",
          "text": "所以，我认可两位蒙德朋友的回答。"
        },
        {
          "role": "诺艾尔",
          "text": "真的吗？谢谢您…"
        },
        {
          "role": "温迪",
          "text": "哈哈，既然出题人都这么说了，三位答题者，各得一分！"
        },
        {
          "role": "派蒙",
          "text": "哎呀，要被行秋追上来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有很多呢。",
              "dialogues": []
            },
            {
              "text": "不缺这一分。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧，你说得对。"
        },
        {
          "role": "胡桃",
          "text": "第三题——咦？这字怎么飘飘忽忽的…"
        },
        {
          "role": "胡桃",
          "text": "「什么东西没有翅膀却能飞，悬在空中不怕累；肚子里满满当当是摩拉，沉海里咕嘟咕嘟捞不起它。」"
        },
        {
          "role": "派蒙",
          "text": "是我的耶！抽到了我写的诗谜耶！"
        },
        {
          "role": "重云",
          "text": "……"
        },
        {
          "role": "行秋",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "怎么了？你们怎么都不说话？是我出的题太难了吗？"
        },
        {
          "role": "行秋",
          "text": "这倒没有，不如说，是简单到我们都不敢相信。"
        },
        {
          "role": "派蒙",
          "text": "不会吧？那你说说我的谜底是什么。"
        },
        {
          "role": "重云",
          "text": "谜底…是「派蒙」吧？"
        },
        {
          "role": "派蒙",
          "text": "…欸？"
        },
        {
          "role": "行秋",
          "text": "是「派蒙」吧。"
        },
        {
          "role": "旅行者",
          "text": "是「派蒙」吧。"
        },
        {
          "role": "诺艾尔",
          "text": "我也觉得是派蒙…"
        },
        {
          "role": "米卡",
          "text": "其实我也…"
        },
        {
          "role": "派蒙",
          "text": "不对啦！怎么想都不对吧！为什么大家都觉得是我啦！"
        },
        {
          "role": "行秋",
          "text": "派蒙你身后有翅膀吗？"
        },
        {
          "role": "派蒙",
          "text": "…呃，没有。"
        },
        {
          "role": "重云",
          "text": "派蒙一直飘着，看起来都不觉得累。"
        },
        {
          "role": "诺艾尔",
          "text": "派蒙还很能吃，一定花掉了旅行者不少摩拉。"
        },
        {
          "role": "米卡",
          "text": "我听骑士团的前辈们提起过，派蒙是被旅行者从海里救上来的，也就是说派蒙其实不会游泳，沉到海里就会…"
        },
        {
          "role": "派蒙",
          "text": "咕嘟咕嘟…{{黑幕|一只失去了梦想的派蒙}}"
        },
        {
          "role": "派蒙",
          "text": "等等…难道说，谜底真是我？"
        },
        {
          "role": "旅行者",
          "text": "你再好好想想。"
        },
        {
          "role": "派蒙",
          "text": "不对啦！我写的谜底明明是「群玉阁」！天上飞着的那个「群玉阁」！"
        },
        {
          "role": "行秋",
          "text": "原来是这样吗？但我觉得一点不如「派蒙」来得贴切。"
        },
        {
          "role": "行秋",
          "text": "甚至说，要是为这诗谜加上两句，就更完美了。"
        },
        {
          "role": "派蒙",
          "text": "咦？怎么加呀？"
        },
        {
          "role": "行秋",
          "text": "——「旅者身边好向导，能说会道人人夸。」"
        },
        {
          "role": "派蒙",
          "text": "真…真的能加上这么一句吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当之无愧。",
              "dialogues": []
            },
            {
              "text": "派蒙，最好的伙伴！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "连你也这么觉得吗？欸嘿嘿…"
        },
        {
          "role": "派蒙",
          "text": "好吧！那我宣布，谜底就是…人见人爱的「派蒙」！"
        },
        {
          "role": "胡桃",
          "text": "好！人见人爱的派蒙为刚才所有答对的人送上一分！"
        },
        {
          "type": "subtitle",
          "text": "诗谜活动继续进行，大家有说有笑，时间很快过去…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，猜诗谜真开心呢，虽然最后还是没赢过行秋，但感觉自己的脑袋变聪明了一点。"
        },
        {
          "role": "派蒙",
          "text": "对了，之前重云不是说有什么事要查吗？我们过去问问他吧。"
        },
        {
          "type": "subtitle",
          "text": "与行秋和重云对话"
        },
        {
          "role": "派蒙",
          "text": "重云！行秋！"
        },
        {
          "role": "行秋",
          "text": "哦？是派蒙呀，刚才真是好险，差一点就输给你们了。"
        },
        {
          "role": "派蒙",
          "text": "咦？这是在领奖吗？"
        },
        {
          "role": "行秋",
          "text": "没错，派蒙要是想要的话，我可以把奖品让给你。"
        },
        {
          "role": "派蒙",
          "text": "真的吗！是什么呀！"
        },
        {
          "role": "重云",
          "text": "呃…"
        },
        {
          "role": "胡桃",
          "text": "是本堂主亲自奉上的——往生堂高端定制服务买一赠一券！看不出，原来派蒙这么想要这个奖品。"
        },
        {
          "role": "派蒙",
          "text": "呃啊啊！我不要，不要不要！你们收好！"
        },
        {
          "role": "行秋",
          "text": "是吗？那我就不客气地收下了。"
        },
        {
          "role": "胡桃",
          "text": "收好收好，这服务随叫随到，运气好的话不叫也能到。"
        },
        {
          "role": "行秋",
          "text": "派蒙找我们有什么事吗？"
        },
        {
          "role": "派蒙",
          "text": "哼，才不找你呢，我们是来找重云的，他好像需要帮忙的样子。"
        },
        {
          "role": "重云",
          "text": "啊，那件事呀…"
        },
        {
          "role": "行秋",
          "text": "不如我再出个诗谜让派蒙猜猜看吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯？还要加赛吗？"
        },
        {
          "role": "行秋",
          "text": "「似妖非妖，如邪非邪。远望行游无凭依，近瞧忽闪身影消。」你知道这是什么吗？"
        },
        {
          "role": "派蒙",
          "text": "这个…"
        },
        {
          "role": "胡桃",
          "text": "听这说法，我猜是野外的小鬼小魂？"
        },
        {
          "role": "重云",
          "text": "我来说吧…"
        },
        {
          "role": "重云",
          "text": "其实，它是我今早在野外修行的时候，突然瞥见的一个非人之物。"
        },
        {
          "role": "重云",
          "text": "它身下无物却能飘在空中，躯体也近似透明。我还以为终于撞上了一个不怕我「纯阳之体」的妖邪，赶忙施展所学方术应敌。"
        },
        {
          "role": "重云",
          "text": "但我所施方术，对它居然没有任何作用。正当我想要上前确认的时候，它却突然没了踪影。"
        },
        {
          "role": "胡桃",
          "text": "你确定那不是鬼魂一类的东西？"
        },
        {
          "role": "重云",
          "text": "不是。我能感觉到它有明显的实体。而且要是鬼魂见了我，恐怕早就跑远了。"
        },
        {
          "role": "重云",
          "text": "这也怨我，当时太兴奋，没有先确认其真身再行动，现在想想，如果对方不是妖邪的话，我岂不是有可能触犯了仙物？"
        },
        {
          "role": "行秋",
          "text": "也别这么想，说到底那毕竟是个你从未见过的东西。这样的反应很正常。"
        },
        {
          "role": "行秋",
          "text": "况且，我们这不也是在尽力探究真相嘛。"
        },
        {
          "role": "胡桃",
          "text": "温迪呢？你对重云的描述有什么头绪吗？"
        },
        {
          "role": "温迪",
          "text": "堂主猜猜看呢？"
        },
        {
          "role": "胡桃",
          "text": "那就是有喽。"
        },
        {
          "role": "温迪",
          "text": "欸嘿，其实我还不能完全确定呢。只能告诉大家那东西应该不是璃月所称的「妖邪」，至少没有什么危险。"
        },
        {
          "role": "温迪",
          "text": "唔…不如这样吧，我们把这个「寻物」的环节也融入明天的诗歌活动里。"
        },
        {
          "role": "派蒙",
          "text": "咦？是一边在外面玩一边写诗的意思吗？"
        },
        {
          "role": "温迪",
          "text": "哈哈，很接近了，但不准确。"
        },
        {
          "role": "温迪",
          "text": "好点子也不是凭空会出现在脑袋里面的。要我说的话，大家还是先好好休息一晚，放松放松！"
        },
        {
          "role": "派蒙",
          "text": "我看这家伙的眼神，早就飘到酒摊那边了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（温迪）"
        },
        {
          "role": "温迪",
          "text": "看朋友们讨论得那么热烈，我也很想一起来玩呢。"
        },
        {
          "role": "温迪",
          "text": "但既然答应了胡桃，我还是要乖乖做好主持人的工作…就是话说得一多，嗓子有点干，得找点喝的。"
        },
        {
          "role": "温迪",
          "text": "你知道吗？酒是诗人最好的墨水。这可以说是一举两得哦！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（雷温）"
        },
        {
          "role": "雷温",
          "text": "听说这次负责调酒的是猫尾酒馆的特派员。"
        },
        {
          "role": "雷温",
          "text": "平时都因为太热闹了，没怎么进去过，这次一定得尝尝到底是什么味道。"
        },
        {
          "type": "subtitle",
          "text": "查看诗谜（台子左）"
        },
        {
          "type": "subtitle",
          "text": "灯笼上的诗谜",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "遍野曾留芳，说旧时尚是流水有情胜霓裳。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "盆中亦有香，谈今日只是蝉绸半披掩心伤。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "——打一植物。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "查看诗谜（台子右）"
        },
        {
          "type": "subtitle",
          "text": "灯笼上的诗谜",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "梁上君子佩雄心，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "非银非玉似鎏金。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "一枚定下滔天胆，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "换来鸦雀作上宾。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "——打一物件。",
          "narration": true
        }
