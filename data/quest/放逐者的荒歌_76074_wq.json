  "chapter_title": "放逐者的荒歌",
  "type": "wq",
  "route": "Echoes of a Forsaken Song",
  "stories": [
    {
      "story_id": 76074,
      "title": "放逐者的荒歌",
      "description": "在安瓦蒂尼尔湖心，似乎有许多仙灵聚集在一起…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "好奇怪的琴，不管怎么拨，都完全发不出声音…该不会是坏掉了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "先跟上那些仙灵吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯嗯，先不管琴了，只要跟着仙灵的指引到上面去，应该就能找到宝藏啦！"
                }
              ]
            },
            {
              "text": "欸？可是我明明听到了琴声和歌声…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "真…真的吗？唔，除了风声，我什么也没听到，难道是那种「只有拨琴的人自己才能听到」的情况吗？"
                },
                {
                  "role": "派蒙",
                  "text": "好，让我也来弹一下试试看…"
                },
                {
                  "role": "？？？",
                  "text": "派蒙用力拨动了琴弦…\\n"
                },
                {
                  "role": "？？？",
                  "text": "同刚才一样，苍凉悲哀的旋律如清晨的微风般扬起，伴随着轻浅的歌——\\n"
                },
                {
                  "role": "？？？",
                  "text": "你听得懂那首歌中的每一句话、每一个字，甚至每一个音符，尽管你从未听过那种语言。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "跟随仙灵，前往上方"
        },
        {
          "type": "subtitle",
          "text": "解开浮空岛上的封锁（1/4）"
        },
        {
          "type": "subtitle",
          "text": "解开浮空岛上的封锁（2/4）"
        },
        {
          "type": "subtitle",
          "text": "跟随仙灵，前往下一个浮空岛"
        },
        {
          "type": "subtitle",
          "text": "解开浮空岛上的封锁（3/4）"
        },
        {
          "type": "subtitle",
          "text": "调查附近"
        },
        {
          "type": "subtitle",
          "text": "打开遗迹的封印"
        },
        {
          "type": "subtitle",
          "text": "解开封印"
        }
      ]
    }
  ]
}