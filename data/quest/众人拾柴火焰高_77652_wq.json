{
  "quest_id": 77652,
  "chapter_num": null,
  "chapter_title": "众人拾柴火焰高",
  "type": "wq",
  "route": "Many Hands Make Light Work",
  "stories": [
    {
      "story_id": 77652,
      "title": "众人拾柴火焰高",
      "description": "「炉子」越烧越旺，避难所的生活终于安稳下来…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与阿罗夏对话"
        },
        {
          "role": "阿罗夏",
          "text": "之前真没想到这个炉子这么好用。"
        },
        {
          "role": "莎普林娜",
          "text": "在这个炉子里，克什尼克晶矿的燃烧效率要高出很多，只是一开始有些不稳定。"
        },
        {
          "role": "莎普林娜",
          "text": "不过多亏了这段时间旅行者和阿罗夏的持续维护，它的输出功率已经稳定下来了。"
        },
        {
          "role": "莎普林娜",
          "text": "外面的晶矿一直在短缺，但如果把有限的晶矿集中到这里用，反而绰绰有余。"
        },
        {
          "role": "阿罗夏",
          "text": "看来暂时不用担心有人挨冻了。"
        },
        {
          "role": "旅行者",
          "text": "真是个好消息！"
        },
        {
          "role": "阿罗夏",
          "text": "对了，最近有帮派的人找过来吗？"
        },
        {
          "role": "莎普林娜",
          "text": "这个倒没有。"
        },
        {
          "role": "阿罗夏",
          "text": "看来是个立功心切的小喽啰，还没给上头报告就开始行动了。不过也好，值得担心的事又少了一件。"
        },
        {
          "role": "莎普林娜",
          "text": "是不是得庆祝一下？要不让大家都过来，让他们都认识一下开辟了这个避难所的英雄少年。"
        },
        {
          "role": "阿罗夏",
          "text": "不要跟我开这种玩笑，还是当初约好的说法，是你开辟了这个避难所，又接引他们过来。"
        },
        {
          "role": "莎普林娜",
          "text": "好吧…"
        },
        {
          "role": "旅行者",
          "text": "为什么要瞒着大家？"
        },
        {
          "role": "阿罗夏",
          "text": "我可是呼啸社的成员，低调行事是我的基本原则。"
        }
      ]
    }
  ]
}