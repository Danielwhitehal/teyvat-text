{
  "quest_id": 71813,
  "chapter_num": null,
  "chapter_title": "群玉阁…再现？",
  "type": "wq",
  "route": "Return of the Jade Chamber?",
  "stories": [
    {
      "story_id": 71813,
      "title": "群玉阁…再现？",
      "description": "从千岩军大坤那边意外听说，之前毁掉的群玉阁似乎有重建的计划，一些小物件已经开始了筹备…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与纪芳对话"
        },
        {
          "role": "纪芳",
          "text": "你好，想要买什么书吗？"
        },
        {
          "role": "旅行者",
          "text": "我们想要《珠玑宝矿》。"
        },
        {
          "role": "纪芳",
          "text": "《珠玑宝矿》？这本书我这里可没有…怎么，你要得很急吗？"
        },
        {
          "role": "旅行者",
          "text": "关于重建群玉阁…"
        },
        {
          "role": "纪芳",
          "text": "咦？群玉阁要重建了吗？那确实得好好筹备，我想想…"
        },
        {
          "role": "纪芳",
          "text": "不然，你去找清昼问问吧，他读过很多书，说不定他知道在哪能找到这本《珠玑宝矿》。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "纪芳",
          "text": "清昼我记得经常在望舒客栈待着，你可以去那边找找他。"
        },
        {
          "type": "subtitle",
          "text": "与清昼对话"
        },
        {
          "role": "清昼",
          "text": "难写，真是难写…"
        },
        {
          "role": "旅行者",
          "text": "关于《珠玑宝矿》…"
        },
        {
          "role": "清昼",
          "text": "《珠玑宝矿》？哦，我记得那本书。"
        },
        {
          "role": "清昼",
          "text": "我之前为了写一首和商贾之事有关的诗而四处取材，在一个地方偶然读过这本书。"
        },
        {
          "role": "清昼",
          "text": "那本书里说的东西虽然我有些看不懂，但有些事例对我作诗倒也有所启发。"
        },
        {
          "role": "清昼",
          "text": "我想想那首诗是什么啊，你稍等…"
        },
        {
          "role": "旅行者",
          "text": "你还记得那本书在哪里能找到吗？"
        },
        {
          "role": "清昼",
          "text": "你们要找那本书？那我可不记得在哪能找这本书了…"
        },
        {
          "role": "清昼",
          "text": "不过，如果你们急着要，我倒是可以直接手写一份给你们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "手写一份？",
              "dialogues": []
            },
            {
              "text": "你全记下来了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "清昼",
          "text": "欸，那本书的内容倒也不长，记下来也不难。"
        },
        {
          "role": "清昼",
          "text": "而且我那时候读那本《珠玑宝矿》的时候，藏书的人压根也不让我借阅出去。"
        },
        {
          "role": "清昼",
          "text": "但作诗哪是一朝一夕的事…我就把那本书给抄了一份走，因为内容也不太多，我也就差不多背下了。"
        },
        {
          "role": "旅行者",
          "text": "这就是诗人的实力吗…"
        },
        {
          "role": "清昼",
          "text": "不值一提，不值一提。不过…我写一份这本书给你，你也帮我个小忙吧。"
        },
        {
          "role": "清昼",
          "text": "说来有些不好意思，我一直在这取材，却忘了吃饭，现在有些饿了…"
        },
        {
          "role": "清昼",
          "text": "请你帮我拿一份「扣三丝」过来吧，我也会在这帮你写那本《珠玑宝矿》。"
        },
        {
          "role": "清昼",
          "text": "等你回来了，我差不多也就写好了。"
        },
        {
          "type": "subtitle",
          "text": "将一份「美味的扣三丝」带给清昼"
        },
        {
          "role": "清昼",
          "text": "《珠玑宝矿》…唔，「凡工商万业，如泉如流，起于山岩，终于汪洋…」"
        },
        {
          "type": "subtitle",
          "text": "与清昼对话"
        },
        {
          "role": "清昼",
          "text": "「璃月之永固，人世之绸缪，愿据此大计，徐徐而行…」"
        },
        {
          "role": "清昼",
          "text": "你回来了啊，稍等，还有最后几句…"
        },
        {
          "role": "清昼",
          "text": "嗯…行了，写完了。"
        },
        {
          "role": "旅行者",
          "text": "这是「扣三丝」…"
        },
        {
          "role": "清昼",
          "text": "不急不急，你先看看这本书怎么样，我自认书法尚可，写的字应该是能够入眼的。"
        },
        {
          "role": "旅行者",
          "text": "这就是诗人的实力吗…"
        },
        {
          "role": "清昼",
          "text": "哈哈哈，谬赞，谬赞了。这本书给你，可别弄丢了啊。"
        },
        {
          "type": "subtitle",
          "text": "与路爷对话"
        },
        {
          "role": "路爷",
          "text": "嗯？你有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "我们想要订制一些竹制的小摆件…"
        },
        {
          "role": "路爷",
          "text": "竹制的小摆件？我倒是也能做，但你这个订单是从哪…"
        },
        {
          "role": "旅行者",
          "text": "是百闻给的清单…"
        },
        {
          "role": "路爷",
          "text": "嚯…月海亭那边来的订单啊，行，我尽量加紧做就是。"
        },
        {
          "role": "路爷",
          "text": "不过，我经常去取材料的竹林那边，最近不知道为什么，突然多了很多林猪。"
        },
        {
          "role": "路爷",
          "text": "虽然也没什么大影响，但我总得绕着它们去取竹子…"
        },
        {
          "role": "路爷",
          "text": "要是你们能把那些林猪赶跑的话，我现在就能去取点竹子回来开工了。"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "路爷",
          "text": "那我就在这里等你，你赶跑那些林猪之后，就回来和我说一声吧。"
        },
        {
          "type": "subtitle",
          "text": "驱赶林猪"
        },
        {
          "role": "路爷",
          "text": "你把那些林猪都赶跑了？"
        },
        {
          "role": "旅行者",
          "text": "都赶跑了。"
        },
        {
          "role": "路爷",
          "text": "那就行了，我等会就去取竹子去，等做好了之后，我直接送去月海亭吧。"
        },
        {
          "role": "路爷",
          "text": "这单子还挺大的，应该能赚不少了…"
        },
        {
          "type": "subtitle",
          "text": "驱赶林猪"
        },
        {
          "role": "百闻",
          "text": "你好，又有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于筹备的物资…"
        },
        {
          "role": "百闻",
          "text": "这是…《珠玑宝矿》，你们是从哪里拿到这本书的，我都快找遍了璃月也没找到…"
        },
        {
          "role": "旅行者",
          "text": "是清昼手抄给我的。"
        },
        {
          "role": "百闻",
          "text": "是那位诗人？看来他确实名不虚传…"
        },
        {
          "role": "百闻",
          "text": "谢谢你们帮忙筹备这些东西，等路爷把那些摆件送来了，我也会支付相应的款项。"
        },
        {
          "role": "旅行者",
          "text": "关于重建群玉阁…"
        },
        {
          "role": "百闻",
          "text": "重建群玉阁确实已经在计划内了，但要准备的东西，做的工作都还很多。一时半会应该也无法马上建好。"
        },
        {
          "role": "百闻",
          "text": "而且最大的材料问题，到现在也没找到解决方法，真是愁人…"
        },
        {
          "role": "百闻",
          "text": "好了，不说这些了，再次感谢你们帮助筹备物资，这些报酬请你们收下，我要接着去工作了。"
        },
        {
          "type": "subtitle",
          "text": "驱赶林猪"
        },
        {
          "role": "路爷",
          "text": "唔，竹制的小摆件…"
        },
        {
          "type": "subtitle",
          "text": "向路爷回报"
        },
        {
          "role": "清昼",
          "text": "「民失其业，无恒产给食，无片瓦遮身，田舍毁弃，尽作劳力，而巨贾厅堂金玉盈门，何道之有？」"
        },
        {
          "role": "清昼",
          "text": "虽然讲的依然是商贾之道，但细细品读，倒也有几分意思…"
        },
        {
          "type": "subtitle",
          "text": "向百闻回报"
        },
        {
          "role": "百闻",
          "text": "你好，又有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于筹备的物资…"
        },
        {
          "role": "百闻",
          "text": "这是…《珠玑宝矿》，你们是从哪里拿到这本书的，我都快找遍了璃月也没找到…"
        },
        {
          "role": "旅行者",
          "text": "是清昼手抄给我的。"
        },
        {
          "role": "百闻",
          "text": "是那位诗人？看来他确实名不虚传…"
        },
        {
          "role": "百闻",
          "text": "谢谢你们帮忙筹备这些东西，等路爷把那些摆件送来了，我也会支付相应的款项。"
        },
        {
          "role": "百闻",
          "text": "再次感谢你们帮助筹备物资，这些报酬请你们收下。"
        }
      ]
    }
  ]
}