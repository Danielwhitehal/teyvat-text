{
  "quest_id": 72141,
  "chapter_num": null,
  "chapter_title": "险恶的教喻",
  "type": "wq",
  "route": "Sinister Instruction",
  "stories": [
    {
      "story_id": 72141,
      "title": "险恶的教喻",
      "description": "",
      "dialogues": [
        {
          "role": "鹫津",
          "text": "…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好？",
              "dialogues": []
            },
            {
              "text": "你在做什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "..."
        },
        {
          "role": "旅行者",
          "text": "你在听我讲话吗？"
        },
        {
          "role": "鹫津",
          "text": "…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好…？",
              "dialogues": []
            },
            {
              "text": "如果能说话就点点头吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "…请你不要打扰我了。"
        },
        {
          "role": "鹫津",
          "text": "「他」很不悦，不悦于口舌之语的扰乱，遮蔽了「心之语」的智慧。"
        },
        {
          "role": "旅行者",
          "text": "口舌之语…？"
        },
        {
          "role": "鹫津",
          "text": "口舌之语就像骤雨，敲振耳膜，搅扰心智。"
        },
        {
          "role": "鹫津",
          "text": "而「心之语」则像雾气，自然而来，氤氲而入…"
        },
        {
          "role": "鹫津",
          "text": "嘘…！「他」在听着，「他」在说话。"
        },
        {
          "role": "鹫津",
          "text": "不要用口舌，不要用耳朵，用心来听…"
        },
        {
          "role": "鹫津",
          "text": "来这里，拜祭，祈祷，然后倾听。"
        },
        {
          "role": "鹫津",
          "text": "要拜祭三番，记住，三番。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（试试好了。）",
              "dialogues": []
            },
            {
              "text": "还是不了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
        },
        {
          "role": "旅行者",
          "text": "参拜神龛"
        },
        {
          "role": "异人龛",
          "text": "（海风挟着潮湿的气息拂过你的脸颊，远处一只海鸟鸣叫着融入了孤云。你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "鹫津",
          "text": "「他」要来了！不要停止拜祭！不能停止拜祭！！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还好吗…？",
              "dialogues": []
            },
            {
              "text": "哦哦，「他」要来了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "「他」在愠怒，「他」要发怒了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么…？",
              "dialogues": []
            },
            {
              "text": "哦哦，要发怒了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "因为什么！因为那个女人！那个拒绝恩赏的邪佞之人！邪佞之人！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "女人…？",
              "dialogues": []
            },
            {
              "text": "哦哦，真该死！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "她在逃跑，但她怎么逃得过「他」！十八双血色的眼睛！千千万万锋利的毒牙！永远渴求鲜血的、数不清的口与舌！！"
        },
        {
          "role": "鹫津",
          "text": "她躲不过的，躲不过的！"
        },
        {
          "role": "鹫津",
          "text": "啊，沙的寡情的国度，龟缩雨林自称智慧的愚昧乞丐，你们统统庇护不了她！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请你冷静一点！",
              "dialogues": []
            },
            {
              "text": "哦哦，说得好！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "你拿到了恩赏，速去拜祭！速去拜祭！"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
        },
        {
          "role": "旅行者",
          "text": "继续参拜"
        },
        {
          "role": "异人龛",
          "text": "（朦胧的鲸声从遥远的海域传来，又被周围草叶的摇曳声掩盖。你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "鹫津",
          "text": "倾听我，请不要离弃我…"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
        },
        {
          "role": "旅行者",
          "text": "继续参拜"
        },
        {
          "role": "异人龛",
          "text": "（你听到不远的某处，萤虫正嗡嗡作响，这些小生灵间而发出令人安神的噼啪声。你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "鹫津",
          "text": "拜祭，祈祷，倾听…切记，切记。"
        },
        {
          "role": "鹫津",
          "text": "如何？「他」的教诲，你是否有幸听到？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么也没听到。",
              "dialogues": []
            },
            {
              "text": "福分浅薄，无缘一听。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "无妨，无妨，「他」在看着，「他」在听着。"
        },
        {
          "role": "鹫津",
          "text": "「他」很欣慰，而喜悦「他」的人，必获得奖赏。"
        },
        {
          "role": "鹫津",
          "text": "「他」的奖赏不在彼岸，就在明天。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你知道自己在说什么吗？",
              "dialogues": []
            },
            {
              "text": "恕我浅薄，道理尚有不明。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "下次再来此处，自见分晓。"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
        },
        {
          "role": "旅行者",
          "text": "参拜神龛"
        },
        {
          "role": "异人龛",
          "text": "（附近飘来不知名的野花清香，灌木丛中似有狐狸躲藏，发出沙沙轻响。你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
        },
        {
          "role": "旅行者",
          "text": "继续参拜"
        },
        {
          "role": "异人龛",
          "text": "（八酝岛因战乱而人烟凋零，举目伤怆，但在这里，无人的静谧正衬托了自然的活力。你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
        },
        {
          "role": "旅行者",
          "text": "继续参拜"
        },
        {
          "role": "异人龛",
          "text": "（你听见蜥蜴奔跑的声音，似能看到它们留下彷如竹叶的小小脚印，优雅却易逝。你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "鹫津",
          "text": "拜祭，倾听…"
        },
        {
          "role": "鹫津",
          "text": "「他」因倾听而强大，因强大而能见一切，能听一切。由是而无所不见，无所不听…"
        },
        {
          "role": "鹫津",
          "text": "珊瑚宫的愚人也好，鸣神岛的妄人也好，对此毫无理解，毫无感受。所以他们只知道互相厮杀，让血蒙蔽双眼…"
        },
        {
          "role": "鹫津",
          "text": "但你要理解这一点。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么乱七八糟的…",
              "dialogues": []
            },
            {
              "text": "大概能理解。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "答案就在拜祭中。"
        },
        {
          "role": "鹫津",
          "text": "切记，每日拜祭三番，必有回赐。"
        },
        {
          "role": "鹫津",
          "text": "与「他」的莫大福泽相比，这只不过是一点小小赏赐。"
        },
        {
          "role": "鹫津",
          "text": "祈祷吧，拜祭吧，倾听「他」，并且让「他」倾听你！"
        },
        {
          "role": "鹫津",
          "text": "然后，你将同我一样，听到「他」的话语，从你的心内传出。"
        },
        {
          "role": "鹫津",
          "text": "然后，「他」将引你脱离苦痛，得大恩赏。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "唔…",
              "dialogues": []
            },
            {
              "text": "随便你怎么说吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "记住，每日拜祭三番，必有回赐。"
        },
        {
          "role": "鹫津",
          "text": "切记，切记。"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
        },
        {
          "role": "旅行者",
          "text": "参拜神龛"
        },
        {
          "role": "异人龛",
          "text": "（鹫津努力平息着狂躁的心绪，呼吸声粗重。显然他情绪激动，似乎在期待什么。你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
        },
        {
          "role": "旅行者",
          "text": "继续参拜"
        },
        {
          "role": "异人龛",
          "text": "（鹫津并非全然疯狂，他显然有所求取，但他渴求的是什么？思索只会带来更多疑问。你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
        },
        {
          "role": "旅行者",
          "text": "继续参拜"
        },
        {
          "role": "异人龛",
          "text": "（你听见海浪拍在礁石上的声音，远处层叠的涛声催人遥望海天相接之处。你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "鹫津",
          "text": "必须平息「他」的怒火，必须安抚「他」的愤怒…"
        },
        {
          "role": "鹫津",
          "text": "你做的很好，你做的很好！"
        },
        {
          "role": "鹫津",
          "text": "切记，有的人会戴着面具，欺骗你，但「他」会帮助你，「他」永远襄助你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "呃…",
              "dialogues": []
            },
            {
              "text": "好吧…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹫津",
          "text": "那个女人就像传说中的狐狸妖怪，我放跑了她，「他」很生气。"
        },
        {
          "role": "鹫津",
          "text": "「他」现在又生气了…这是我的罪。"
        },
        {
          "role": "鹫津",
          "text": "请原谅我…我会再次献祭，我会为您寻找下一个「回归」的祭品…"
        },
        {
          "role": "鹫津",
          "text": "请原谅我，请原谅我…"
        },
        {
          "role": "鹫津",
          "text": "请原谅我，请原谅我…"
        },
        {
          "role": "鹫津",
          "text": "你来了。"
        },
        {
          "role": "旅行者",
          "text": "你还好吗？"
        },
        {
          "role": "鹫津",
          "text": "谢谢你宽恕我的罪恶，请让我回归于你…"
        },
        {
          "role": "旅行者",
          "text": "你在和我说话吗？"
        },
        {
          "role": "鹫津",
          "text": "什么…但为什么…"
        },
        {
          "role": "鹫津",
          "text": "我主持了每一次祭献，我接受了你的每一场恩典！"
        },
        {
          "role": "鹫津",
          "text": "而她，被你所标记，为你所成就，却逃离你的恩赐，背叛了我们！"
        },
        {
          "role": "旅行者",
          "text": "你在说什么…"
        },
        {
          "role": "鹫津",
          "text": "呀啊！唔呃…对不起…对不起…"
        },
        {
          "role": "鹫津",
          "text": "不应该怀疑「他」的选择，继续隐忍，继续拜祭…"
        },
        {
          "role": "旅行者",
          "text": "听得到我说话吗？"
        },
        {
          "role": "鹫津",
          "text": "继续隐忍…继续拜祭…"
        },
        {
          "role": "鹫津",
          "text": "继续隐忍…继续拜祭…"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。目睹了鹫津的狂态，你还要继续参拜吗？）"
        },
        {
          "role": "旅行者",
          "text": "参拜神龛"
        },
        {
          "role": "异人龛",
          "text": "（鹫津依然在旁边喃喃自语，模样很不妙。神龛则是岿然不动，全无反应。或许这一切不过是一场骗局？你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。目睹了鹫津的狂态，你还要继续参拜吗？）"
        },
        {
          "role": "旅行者",
          "text": "继续参拜"
        },
        {
          "role": "异人龛",
          "text": "（你听见风在大蛇的骸骨中回荡呼啸，庞大古老的骨骸则无动于衷。它似乎被海风化成了一支乐器——大海中最哀凄的乐器。你努力倾听，但什么也没有发生。）"
        },
        {
          "role": "异人龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。目睹了鹫津的狂态，你还要继续参拜吗？）"
        },
        {
          "role": "旅行者",
          "text": "继续参拜"
        },
        {
          "role": "异人龛",
          "text": "（鹫津依然在旁边喃喃自语，模样很不妙。神龛则是岿然不动，全无反应。或许这一切不过是一场骗局？）"
        },
        {
          "role": "异人龛",
          "text": "「小心身后…」"
        },
        {
          "role": "异人龛",
          "text": "（身后传来脚步声，欲盖弥彰，过于清晰。）"
        },
        {
          "role": "异人龛",
          "text": "「小心…！」"
        },
        {
          "type": "subtitle",
          "text": "击败发狂的武士"
        },
        {
          "type": "subtitle",
          "text": "在绯木村找到鹫津的财物"
        }
      ]
    }
  ]
}