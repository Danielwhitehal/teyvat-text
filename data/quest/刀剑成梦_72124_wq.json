{
  "quest_id": 72124,
  "chapter_num": null,
  "chapter_title": "刀剑成梦",
  "type": "wq",
  "route": "Dreams of Sword Art",
  "stories": [
    {
      "story_id": 72124,
      "title": "刀剑成梦",
      "description": "海风吹拂的山崖之上矗立着一位无名的武士，似乎在寻找着什么…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆寻找「无名武士」"
        },
        {
          "role": "无名",
          "text": "为什么？为什么找不到…"
        },
        {
          "role": "旅行者",
          "text": "在找什么？"
        },
        {
          "role": "无名",
          "text": "在找…找…我忘记了。每次快想起来的时候，都会忘记。"
        },
        {
          "role": "无名",
          "text": "喂，你知道我在找什么吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我怎么知道。",
              "dialogues": [
                {
                  "role": "无名",
                  "text": "不行，想不起来…"
                }
              ]
            },
            {
              "text": "摸摸你身上看看。",
              "dialogues": [
                {
                  "role": "无名",
                  "text": "没有，我已经找遍了，全都没有。"
                },
                {
                  "role": "无名",
                  "text": "虽然我不记得了，但是我能感觉到不对，我要找的东西不在身上。"
                },
                {
                  "role": "无名",
                  "text": "我要找的到底是什么…"
                }
              ]
            }
          ]
        },
        {
          "role": "无名",
          "text": "可恨，可恨！怎么总是想不起来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "以后会想起来的。",
              "dialogues": [
                {
                  "role": "无名",
                  "text": "不行，我等不了那么久。"
                },
                {
                  "role": "无名",
                  "text": "不论我要找什么，这东西一定至关重要，越早想起来越好。"
                },
                {
                  "role": "无名",
                  "text": "冥冥之中，我有种感觉，我留在此地就是为了找到那东西，找不到绝对不行。"
                },
                {
                  "role": "无名",
                  "text": "所有想来打扰我、妨碍我的家伙，我统统都会斩掉…"
                }
              ]
            },
            {
              "text": "回想一下你到这里来的时候。",
              "dialogues": [
                {
                  "role": "无名",
                  "text": "我在这里的时候？我只记得我在这里挥刀，至于挥刀做什么…"
                }
              ]
            }
          ]
        },
        {
          "role": "无名",
          "text": "哈哈，对了，这个我记得，我挥刀是为了斩人！"
        },
        {
          "role": "无名",
          "text": "只要挥刀斩了眼前的敌人，全身的血都会像江水一样奔涌起来，何其畅快，哈哈哈哈。"
        },
        {
          "role": "无名",
          "text": "我的刀上次染血，是什么时候？"
        },
        {
          "role": "无名",
          "text": "呵，感觉有些时日了，今天终于又来了一个你。"
        },
        {
          "role": "无名",
          "text": "我要寻找何物，这儿问题稍后再说，想了这么久我也累了，该放松一下。"
        },
        {
          "role": "无名",
          "text": "啊，有一阵子没挥刀了，都能听到「贵月胴切」她在抱怨了。"
        },
        {
          "role": "无名",
          "text": "你听，她在喊着想砍你啊，哈哈哈。和你打上一场，她也会开心吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是疯子吗？",
              "dialogues": []
            },
            {
              "text": "刀不会说话。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "无名",
          "text": "「贵月胴切」的声音，你难道听不到吗？太可惜了。"
        },
        {
          "role": "无名",
          "text": "生死悬于刀上之人，都会懂得倾听刀的声音。…呵呵，她又在催我动手了。"
        },
        {
          "role": "无名",
          "text": "来吧，把你的武器亮出来，和我赌一赌胜负。"
        },
        {
          "type": "subtitle",
          "text": "◆击败「无名武士」"
        },
        {
          "role": "无名",
          "text": "来吧，把你的武器亮出来，和我赌一赌胜负。"
        },
        {
          "type": "subtitle",
          "text": "◆与「无名武士」对话"
        },
        {
          "role": "无名",
          "text": "是我败了。"
        },
        {
          "role": "无名",
          "text": "我斩人无数，从无败绩，如今输在你手上…我愿赌服输，就算是死我也绝无怨言。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我不做这种事。",
              "dialogues": []
            },
            {
              "text": "你别再做这种事了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "无名",
          "text": "哈哈，我的刀拔出来就要斩人，你用武器却不是为了斩人吗？"
        },
        {
          "role": "无名",
          "text": "你的战法独特，气度也不寻常，和那些被我斩了的家伙不一样。"
        },
        {
          "role": "无名",
          "text": "你是哪个流派的弟子？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            },
            {
              "text": "只是旅行者。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "无名",
          "text": "呵，不愿说吗？无妨，我如今什么也回忆不起，就算你说了我也未必认识。"
        },
        {
          "role": "无名",
          "text": "流落到这里之前，我是何人、做过何事…我全都忘了。"
        },
        {
          "role": "无名",
          "text": "只有握住刀柄，我才会觉得熟悉、安心。向我这样丢失了过往的人，就只能在这荒地徘徊下去了吧。"
        },
        {
          "role": "旅行者",
          "text": "我可以帮你回忆。"
        },
        {
          "role": "无名",
          "text": "可是我连自己的姓名都忘记了，只能像鬼魂一样在世间游荡，你又怎么帮我？"
        },
        {
          "role": "无名",
          "text": "我不知道自己有没有家人，故乡何方，除了此地我无处可去。"
        },
        {
          "role": "无名",
          "text": "唯一跟我的过去有联系的，只有这一身剑术了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是在哪里学的剑术？",
              "dialogues": []
            },
            {
              "text": "你是和谁学的剑术？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "无名",
          "text": "师承…我一点印象也没有，总不会是野路子出身吧。"
        },
        {
          "role": "无名",
          "text": "这世道，野路子出身的家伙是成不了器的。"
        },
        {
          "role": "无名",
          "text": "就算年幼时开始刻苦练习，但因为付不起给师父的礼金，得不到正确的指点，不得不比常人多走无数弯路。"
        },
        {
          "role": "无名",
          "text": "没有像样的刀，只能偷偷摸摸去冶炼厂的锻剑师傅那里，求一把废弃不用的次品。"
        },
        {
          "role": "无名",
          "text": "即使是次品刀，依然倍加珍惜，甚至为刀取了名字。"
        },
        {
          "role": "无名",
          "text": "就这样流尽了汗水，一身的伤口，凭着毅力勉强打下了基础，还是会受到嘲笑。"
        },
        {
          "role": "无名",
          "text": "如果没有志同道合的伙伴勉励，早就坚持不下去了…"
        },
        {
          "role": "无名",
          "text": "唔…为什么…为什么这种感觉这么熟悉？"
        },
        {
          "role": "无名",
          "text": "我…我好像想起了一点…有两个小孩持着刀，在对练，旁边是他们两家的茅屋。"
        },
        {
          "role": "无名",
          "text": "他们…他们应该住在{{颜色|蓝|北面的渔村茅屋}}里，{{颜色|蓝|茅屋建在山崖下}}，{{颜色|蓝|屋子的四面都是海}}。"
        },
        {
          "role": "无名",
          "text": "他们每天都会沿着{{颜色|蓝|屋后的台阶}}，去{{颜色|蓝|山坡上}}对练…他们的刀或许还在那里。"
        },
        {
          "role": "无名",
          "text": "他们是谁？不行，我想不起来，头好疼…"
        },
        {
          "role": "无名",
          "text": "……"
        },
        {
          "role": "无名",
          "text": "你不是要帮我吗？那你帮我去找一找那两个持刀的小孩，把他们的刀带来，我…我想看一看他们的刀，那或许是跟我有关的东西。"
        },
        {
          "role": "旅行者",
          "text": "我明白了。"
        },
        {
          "role": "无名",
          "text": "…武士的诺言重于千金，在你履行承诺之前，我会在这里等待，一直等到你找到他们的刀。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "无名",
          "text": "那两个小孩到底是谁？不行，我想不起来，头好疼…"
        },
        {
          "role": "旅行者",
          "text": "他们住在哪里？"
        },
        {
          "role": "无名",
          "text": "他们…他们应该住在{{颜色|蓝|北面的渔村茅屋}}里，{{颜色|蓝|茅屋建在山崖下}}，{{颜色|蓝|屋子的四面都是海}}。"
        },
        {
          "role": "无名",
          "text": "他们每天都会沿着{{颜色|蓝|屋后的台阶}}，去{{颜色|蓝|山坡上}}对练…他们的刀或许还在那里。"
        },
        {
          "role": "无名",
          "text": "…武士的诺言重于千金，在你履行承诺之前，我会在这里等待，一直等到你找到他们的刀。"
        },
        {
          "type": "subtitle",
          "text": "◆寻找「无名武士」提到的刀"
        },
        {
          "role": "派蒙",
          "text": "这里好冷清，不像有人居住的样子。"
        },
        {
          "role": "派蒙",
          "text": "那个奇怪的武士提到的孩子，真的会住在这里吗？"
        },
        {
          "type": "subtitle",
          "text": "「一把被废弃的刀」旁边的任务道具「一封家信」内容"
        },
        {
          "type": "subtitle",
          "text": "父亲大人敬启",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "许久没有写信问询，不知道家中近况如何？上次父亲信中说道「泉水子」剩下了小狗崽，但我因为杂务繁忙，没能早点回信。现在，小狗崽们应该已经长大些了吧。您说过会将一只小狗崽送给研次的父母，这太好了。我和研次因为离家参军，无法侍奉父母，一直怀着歉意。得知您和母亲、研次的父母时长相互照应，我们做儿子的也能放心一些。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "至于我在军中的生活，父亲请勿担心。军中膳食供应充足，营房宽敞整洁，我在外的饮食住宿都很好，甚至还结交了一位名叫松平的新朋友。将来有机会，我打算请他来家乡做客，尝一尝母亲的手艺。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "另外，还有一件事，我想您听了一定会为我骄傲——因为我作战勇武，上官将我从军士拔擢为旗本了！其实，研次也和我一道晋升为旗本了，但我希望父亲先不要向他的家人透露，让他自己说吧。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "父亲，我一直相信，等到将来战争结束，我和研次带着军功回到村里，一切都会不同。以我那时的军饷，您与母亲就再也不必辛苦捕鱼了，我们甚至还可以修上一座新房子，买一条新船，过上富足的生活。为了这个目标，我会不断努力，立下更多功劳，取得更多荣誉！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "请安心等着我们归来吧。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "公义敬上",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "◆把刀交给「无名武士」"
        },
        {
          "role": "派蒙",
          "text": "完全没见到拿刀的小孩呀，找了半天也只有这一把刀，还孤零零地插在地上。"
        },
        {
          "role": "派蒙",
          "text": "那个武士说这里住着两个孩子，那就应该有两把刀才对，我们费了好大力气也只找到了一把…说不定另一把刀已经被带走了？"
        },
        {
          "role": "派蒙",
          "text": "唔…实在是猜不出这里发生过什么，总之我们先把刀拿去给他看看吧。"
        },
        {
          "role": "无名",
          "text": "你寻到刀了吗？"
        },
        {
          "role": "无名",
          "text": "……"
        },
        {
          "role": "无名",
          "text": "我认得，这是…两个小孩其中一个所带的刀。"
        },
        {
          "role": "无名",
          "text": "那个小孩…他和伙伴一起去冶炼厂附近偷偷捡了两把刀匠们废弃的、一模一样的刀。"
        },
        {
          "role": "无名",
          "text": "那里锻出来的刀都是上等的好刀，可是这两把刀却是次品，那两个小孩…"
        },
        {
          "role": "无名",
          "text": "我记得…他们后来因此被人嘲笑买不起名匠之刀，只能捡破烂的用。"
        },
        {
          "role": "无名",
          "text": "呵，不管是名刀还是破烂，上了战场能斩人的就是宝刀。"
        },
        {
          "role": "无名",
          "text": "天下谁人生来衔金配玉，明明战场之上不分贵贱。"
        },
        {
          "role": "无名",
          "text": "武士，你上过战场吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我不是武士。",
              "dialogues": [
                {
                  "role": "无名",
                  "text": "你一身本事却没有追随任何主家吗？愚蠢。"
                }
              ]
            },
            {
              "text": "没上过战场。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "无名",
          "text": "你该去战场上看看，一刀斩下去，无论是威风凛凛的大将还是区区足轻，都一样的会死啊，哈哈哈。"
        },
        {
          "role": "无名",
          "text": "但是…我不会死。多少剑客浪人来挑战过我，我都没有败。"
        },
        {
          "role": "无名",
          "text": "那些浪得虚名之辈，要么逃要么死在了我的刀下，哈哈哈哈。"
        },
        {
          "role": "无名",
          "text": "只有你打败了我…可恨！我怎么会败？"
        },
        {
          "role": "无名",
          "text": "可恨！可恨！可恨！"
        },
        {
          "role": "无名",
          "text": "再来！再来！我不会败！"
        },
        {
          "type": "subtitle",
          "text": "◆击败「无名武士」"
        },
        {
          "role": "无名",
          "text": "你，我要与你再次比试。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "先让我准备一下。",
              "dialogues": [
                {
                  "role": "无名",
                  "text": "我可以让你准备，无论你要准备到何时，我和「贵月胴切」都会在这里等你。"
                },
                {
                  "role": "无名",
                  "text": "准备好就拿出真本事来一决胜负吧。"
                }
              ]
            },
            {
              "text": "准备好认输吧。（仅此选项会继续剧情）",
              "dialogues": [
                {
                  "role": "无名",
                  "text": "败于这把「贵月胴切」的人都曾说过类似的话，你又能坚持到第几招？"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆与「无名武士」对话"
        },
        {
          "role": "无名",
          "text": "…我又败在你手下了。"
        },
        {
          "role": "无名",
          "text": "你真的不打算告诉我你的来历吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            },
            {
              "text": "说了是旅行者。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "无名",
          "text": "高手都是这样遮遮掩掩的么，罢了，你不想说的事我不再追问。"
        },
        {
          "role": "无名",
          "text": "啊，许久没有这样尽兴了，抛却一切杂念，沉心于武道。"
        },
        {
          "role": "无名",
          "text": "奇怪…这种舒爽的感觉，我的身体记得。"
        },
        {
          "role": "无名",
          "text": "好像…只要挥动手中的刀，只要专注于刀下胜负，就能获得肯定，就能…拥有一切。"
        },
        {
          "role": "无名",
          "text": "啊，是这样没错，我曾不停地挥刀，劈开铠甲下的无数躯体。"
        },
        {
          "role": "无名",
          "text": "那时的心声，我想起来了。摩拉和名誉都能以刀搏得，只要在枪林弹雨种笑到最后，千军万马又如何！归来还不是功高禄厚，哈哈哈。"
        },
        {
          "role": "无名",
          "text": "功禄、荣华…我原来曾有过那么得意的时候吗？满身荣耀，备受器重，美酒饮之不尽…"
        },
        {
          "role": "无名",
          "text": "酒…酒…怎么能忘了月下与伙伴共饮的酒，好想念那种味道。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你想起来了？",
              "dialogues": []
            },
            {
              "text": "你在哪里喝酒？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "无名",
          "text": "我记得…我们饮酒的地方在{{颜色|蓝|一大片营地}}里，周围都是{{颜色|蓝|穿铠佩刀}}的家伙。"
        },
        {
          "role": "无名",
          "text": "那时候我们好像…说了些什么…不行，记不起来。"
        },
        {
          "role": "旅行者",
          "text": "喝到当时的酒就能想起来吧。"
        },
        {
          "role": "无名",
          "text": "怎么，你愿意帮我找到从前的酒吗？"
        },
        {
          "role": "旅行者",
          "text": "可以。"
        },
        {
          "role": "无名",
          "text": "那就交给你了，再尝到那酒的话，说不定我就能想起当时的事情。"
        },
        {
          "role": "派蒙",
          "text": "穿铠佩刀的人，难道是军营里的兵士？"
        },
        {
          "role": "派蒙",
          "text": "从这里往东，那里的土地相对平坦连续，说不定军营会在那里。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "无名",
          "text": "曾经和我一起喝酒的人…是谁…我们又说过些什么…"
        },
        {
          "type": "subtitle",
          "text": "◆帮「无名武士」寻找酒"
        },
        {
          "type": "subtitle",
          "text": "◆向军士打听酒的事"
        },
        {
          "role": "九条政仁",
          "text": "嗯？军营之内，怎么会有你这样的平民闲逛？"
        },
        {
          "role": "旅行者",
          "text": "关于「无名武士」…"
        },
        {
          "role": "九条政仁",
          "text": "既未追随大名，又不在战场杀敌，你所说的此人，是个浪人吧。"
        },
        {
          "role": "九条政仁",
          "text": "我麾下军中，不会有此等人容身之地。"
        },
        {
          "role": "九条政仁",
          "text": "况且军营之内，秩序为上，不是平民可以前来肆意走动的地方，请你早点离开。"
        },
        {
          "role": "石川",
          "text": "希望这脆弱的和平能维持得久一点…"
        },
        {
          "role": "旅行者",
          "text": "关于「无名武士」…"
        },
        {
          "role": "石川",
          "text": "我从来没听说过这种奇怪的家伙，你问错人了。"
        },
        {
          "role": "松平",
          "text": "珊瑚宫叛军不过一帮虾兵蟹将。"
        },
        {
          "role": "旅行者",
          "text": "关于「无名武士」…"
        },
        {
          "role": "松平",
          "text": "呵呵，渔村出身，参了军，还有说话那口气…你们说的那个家伙，我应该认识。"
        },
        {
          "role": "松平",
          "text": "上次的合战结束后，包括那家伙在内，有不少人失踪了。"
        },
        {
          "role": "松平",
          "text": "一般来说，合战中失踪，不是做了逃兵就是「回老家」喽。"
        },
        {
          "role": "松平",
          "text": "但是那家伙，凭他的剑术，是不可能被珊瑚宫的杂兵们打败的，我原本以为那家伙是逃了。"
        },
        {
          "role": "松平",
          "text": "没想到他竟然失去了记忆，沦落成只会挥刀的狂人了。"
        },
        {
          "role": "松平",
          "text": "那么，你们现在来打听他的事情，是想要做什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想请你帮他找回记忆。",
              "dialogues": [
                {
                  "role": "松平",
                  "text": "哦？但我认为，忘记自己再战场上的记忆，未尝不是一件好事。"
                }
              ]
            },
            {
              "text": "我想知道他的过去。",
              "dialogues": [
                {
                  "role": "松平",
                  "text": "那家伙的过去吗？以我对他的了解，那不是一个令人开心的故事…"
                }
              ]
            }
          ]
        },
        {
          "role": "松平",
          "text": "不过，我看你是个善良的人，为了帮助他，大老远找到这里来。"
        },
        {
          "role": "松平",
          "text": "作为那家伙的老朋友，我当然愿意帮忙，不过…"
        },
        {
          "role": "松平",
          "text": "你也看到了，我还在为军队效力，不能随便离开…"
        },
        {
          "role": "旅行者",
          "text": "只需要以前的酒就可以。"
        },
        {
          "role": "松平",
          "text": "酒…只要酒就可以了吗？"
        },
        {
          "role": "松平",
          "text": "我明白了，那就把我随身带着的那壶酒给你们吧。"
        },
        {
          "role": "松平",
          "text": "以前，那家伙还在军中的时候，经常和他的同乡，还有我，三人一同饮酒。"
        },
        {
          "role": "松平",
          "text": "他和他那个同乡是穷苦人出身，总是受同营那些富家出身的混蛋排挤。"
        },
        {
          "role": "松平",
          "text": "他是个粗犷的汉子，那些排挤他全不在意，只知道再战场上拼命。"
        },
        {
          "role": "松平",
          "text": "当时的大将欣赏他，提拔他和同乡两人一跃成了旗本。"
        },
        {
          "role": "松平",
          "text": "可是没想到后来，那场合战中…"
        },
        {
          "role": "松平",
          "text": "唉，一提到过去就想到些让人难受的事，不唠叨了，没意思。"
        },
        {
          "role": "松平",
          "text": "酒我已经给你们了，没有其他事就离开吧。"
        },
        {
          "role": "松平",
          "text": "这里毕竟是军营，你们这些生面孔不要久留，免得遭人误会。"
        },
        {
          "type": "subtitle",
          "text": "◆把酒交给「无名武士」"
        },
        {
          "role": "无名",
          "text": "你寻到酒了吗？"
        },
        {
          "role": "无名",
          "text": "这酒…是苦的，不对。"
        },
        {
          "role": "无名",
          "text": "我记得从前饮的酒，不是这种苦味，从前的酒里只有兴奋和快意的味道。"
        },
        {
          "role": "无名",
          "text": "与人厮杀，拼取了荣华，不应当得意吗…可是，酒入喉为何只有酸苦…"
        },
        {
          "role": "无名",
          "text": "可是这个壶，我认得。没有错。"
        },
        {
          "role": "无名",
          "text": "有谁曾经举着这只壶，说：「公义，再喝一壶。」"
        },
        {
          "role": "无名",
          "text": "「公义」…「公义」…这是我的名字吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来你叫公义。",
              "dialogues": []
            },
            {
              "text": "是个好名字。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「公义」",
          "text": "我想起来了。我总是和同一个人对饮，我和他…情同手足，经常一起谈天说地。"
        },
        {
          "role": "「公义」",
          "text": "但是有一次，那个总和我共饮的人似乎说了什么，我们…争吵了起来，他就离开了。"
        },
        {
          "role": "「公义」",
          "text": "明明是生死与共的兄弟，怎么会就这样离开…为什么？"
        },
        {
          "role": "「公义」",
          "text": "我到底做错了什么？武士，你知道吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要问你自己。",
              "dialogues": []
            },
            {
              "text": "或许还是不要知道的好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「公义」",
          "text": "但是，我想知道，让我想起来吧。快想起来，快想起来啊…"
        },
        {
          "type": "subtitle",
          "text": "◆击败「公义」"
        },
        {
          "role": "「公义」",
          "text": "头…好痛…我恳求你，与我再战，用你的刀帮助我醒来，让我想起一切吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "让我考虑一下。",
              "dialogues": [
                {
                  "role": "「公义」",
                  "text": "你还在犹豫些什么？"
                }
              ]
            },
            {
              "text": "准备接招吧。（仅此选项会继续剧情）",
              "dialogues": [
                {
                  "role": "「公义」",
                  "text": "来吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆与「公义」对话"
        },
        {
          "role": "「公义」",
          "text": "三次败在同一人手下，我怎么会如此软弱？我磨练至今的武艺，怎么会如此无用？"
        },
        {
          "role": "「公义」",
          "text": "无用…无用…我是个无用的武人，我想起来了…"
        },
        {
          "role": "「公义」",
          "text": "我看见一把刀从谁的手中滑落，那把刀不是「贵月胴切」，看见它的那一刻…我浑身发抖…丢失了勇气。"
        },
        {
          "role": "「公义」",
          "text": "我害怕看见那把滑落在地上的刀，所以从那里逃走了，来到了这里。"
        },
        {
          "role": "旅行者",
          "text": "那里是哪里？"
        },
        {
          "role": "「公义」",
          "text": "我…我从{{颜色|蓝|西北面的滩涂}}一路走过来，那里是合战的战场。"
        },
        {
          "role": "「公义」",
          "text": "我为什么会那么害怕那把刀？战场上到底发生了什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来帮你回想。",
              "dialogues": []
            },
            {
              "text": "我来帮你找刀。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「公义」",
          "text": "想起来，我要想起来，那把刀…那把刀…"
        },
        {
          "type": "subtitle",
          "text": "◆寻找「公义」提到的刀"
        },
        {
          "type": "subtitle",
          "text": "「一把无主的刀」旁边的任务道具「残破的信笺」内容"
        },
        {
          "type": "subtitle",
          "text": "研次亲启",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "为了写这封信，我想了很久，有千言万语想要对你诉说，但每到下笔却又无法继续。我们从小一起习武，长大一起参军，做什么事都在一起。对我来说，你就是亲兄弟。我从来没有想到我们俩会起那么大的争执，甚至大打出手。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "研次，我的兄弟，我每时每刻都在为此懊悔。如果当时我更冷静一些，别那么武断地说要离开，你大概也不会那么愤怒。在你看来，我一定是个背叛了将军大人的无耻逃兵吧，所以你才会不听我解释就挥拳。我不在乎别人如何看待我，但唯有你对我的看法，我无法不在乎。所以，我一定要写这封信，向你倾吐心声。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "还记得我俩参军时的梦想吗？借着勇猛与剑技，借着如今的世道，在武的路途上取得功名，报效父母。而且大人曾训诫我们，珊瑚宫乱民胆敢向「雷之三重巴」的旗帜拔刀，乃是弥天大罪。既然如此，便无需介意他们的生命，因为选择死之途的是他们自己。原本我也是这么坚信的，但自从那件事发生之后，我就无法再这么想了。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "当时，一场战役刚刚结束，我在撤退时，于战场上捡到了一封染血的叛军军士家书。说出来你或许不信，那个叛军军士我们都认识。你我刚参军时，有位军中前辈照拂了我好一阵，而那位前辈就是家书的主人。信中，他还惦记着家里的渔船，期待着战争结束回到家乡。我无论如何也不曾料到，后来他竟投身于叛军，而自己居然以这种方式和他在战场上再会了。",
          "narration": true
        },
        {
          "role": "自从捡到了这封家书，我便突然醒悟过来",
          "text": "其实叛军们也是人啊，也有父母待奉养，也有故乡待归回。想到这一点，我决定将这封染血家书的事隐瞒起来，希望将来有机会代前辈将家书寄回家中。但不知为何，这件事居然让好几位同僚知道了，我因此饱受讥讽。你我出身低微，却凭借战功迅速升为旗本，早就有人在背后散布流言了。这事之后，种种排挤与孤立愈演愈烈，甚至在战场上，在我们本该同心御敌的时候，也有同僚刻意将我的后背暴露给敌方，我也因此多次与死亡擦肩而过。这一切不由我不心寒。我考虑了很久，终于决定：既然在幕府军中我遭同僚背弃，自己心中又已对敌军生了同情，那不如转而投身于他们吧。"
        },
        {
          "type": "subtitle",
          "text": "研次，你一向为人坦荡，这一系列因果你从前不曾察觉，如今我向你和盘托出，不敢奢求理解，只要你知晓我心中所想便好。现在，我身在珊瑚宫军的营地，提笔写下这封信。希望你看到这信的时候，战争已经结束了。那时，如果你还愿意与我相认，那我们就一起回家吧。什么摩拉，荣誉，都不重要了。我们当初参军，就只有两个人、两把刀，等到我们回家，也只要完完整整的两个人、两把刀就好了。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "公义敬上",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "◆把刀交给「公义」"
        },
        {
          "role": "「公义」",
          "text": "想起来，我要想起来，那把刀…那把刀…"
        },
        {
          "role": "「公义」",
          "text": "这是那把刀…对，是他的刀。"
        },
        {
          "role": "「公义」",
          "text": "可是他在哪里？他不见了，我们明明说好会一起回去的…"
        },
        {
          "role": "旅行者",
          "text": "你怎么了！"
        },
        {
          "role": "「公义」",
          "text": "他为什么不在了…啊啊啊…怎么会这样？"
        },
        {
          "type": "subtitle",
          "text": "◆击败发狂的「公义」"
        },
        {
          "type": "subtitle",
          "text": "◆与「公义」对话"
        },
        {
          "role": "「公义」",
          "text": "我…彻彻底底地败了。"
        },
        {
          "role": "「公义」",
          "text": "明明已经拼尽性命挥刀，但我所崇信的武道，还是狼狈落败了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你醒了？",
              "dialogues": []
            },
            {
              "text": "不比了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「公义」",
          "text": "你不用担心，刚才是我一时失控，但今后我不会再主动向你举刀。"
        },
        {
          "role": "「公义」",
          "text": "我与你尽兴真剑试合四回，朦胧中找到了一些散碎的回忆，得赠两把刀、一壶酒，已经十分满足。"
        },
        {
          "role": "「公义」",
          "text": "更何况越是回忆，我越能感受到愤怒与深切的悲伤，或许我的过去，并不是一个美好的故事。"
        },
        {
          "role": "「公义」",
          "text": "再执着下去…未必有好结果，不如放下。"
        },
        {
          "role": "「公义」",
          "text": "但与你相遇，仍然是一大幸事，我不后悔。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也这么认为。",
              "dialogues": []
            },
            {
              "text": "还是有点后怕的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「公义」",
          "text": "哈哈哈，你很直率。"
        },
        {
          "role": "「公义」",
          "text": "冲着你这份坦诚，虽然我已经是你手下败将，但如果你愿意，我仍然想和你切磋。"
        },
        {
          "role": "「公义」",
          "text": "武士相交，与其对坐空谈，不如以刀论心。"
        },
        {
          "role": "「公义」",
          "text": "我和「贵月胴切」会留在这里，观海听风，随时都可以与你再次以刀论心。"
        },
        {
          "type": "subtitle",
          "text": "后续相关剧情"
        },
        {
          "type": "subtitle",
          "text": "◆与「公义」对话"
        },
        {
          "role": "「公义」",
          "text": "你来了。"
        },
        {
          "role": "「公义」",
          "text": "是来比试的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备接招吧。",
              "dialogues": [
                {
                  "role": "「公义」",
                  "text": "很好，来吧。"
                }
              ]
            },
            {
              "text": "想和你说说话。",
              "dialogues": [
                {
                  "role": "「公义」",
                  "text": "我放弃了自己的过去，今后也不想再对这个世界诉说些什么了。"
                },
                {
                  "role": "「公义」",
                  "text": "只想找人聊天的话，你不该找我。"
                },
                {
                  "role": "「公义」",
                  "text": "你走吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "游戏时间2:00-23:59进入战斗",
              "dialogues": []
            },
            {
              "text": "游戏时间0:00-1:59进入战斗",
              "dialogues": [
                {
                  "role": "「公义」",
                  "text": "此刻海风正好，「贵月胴切」也在兴奋地躁动。"
                },
                {
                  "role": "「公义」",
                  "text": "呵呵，我的兴致来了，会拿出不同于以往的力量应战，你做好准备吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "挑战成功",
              "dialogues": [
                {
                  "role": "「公义」",
                  "text": "呵呵，竟然还是赢不过你。"
                },
                {
                  "role": "「公义」",
                  "text": "也罢，你的武艺仍在精进，我却因为心性所限再也悟不出更高深的奥义了。"
                },
                {
                  "role": "「公义」",
                  "text": "不过，若你习得了新的技艺，我依然乐于见识。"
                },
                {
                  "role": "「公义」",
                  "text": "那么，下次再会吧。"
                }
              ]
            },
            {
              "text": "挑战失败",
              "dialogues": [
                {
                  "role": "「公义」",
                  "text": "看来你近日来疏于练习。"
                },
                {
                  "role": "「公义」",
                  "text": "武者稍有一日怠惰便浪费了十日的勤勉，这个道理，你应该知道。"
                },
                {
                  "role": "「公义」",
                  "text": "回去磨练自己吧，你不该只有这点本事。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆与松平对话"
        },
        {
          "role": "旅行者",
          "text": "关于「公义」…"
        },
        {
          "role": "松平",
          "text": "那家伙，已经死了。"
        },
        {
          "role": "松平",
          "text": "明明有那么好的剑术，又和研次一道受上官赏识，居然会叛逃，真是让人想不通。"
        },
        {
          "role": "松平",
          "text": "如果不是因为这种荒谬的事情，研次怎么会…"
        },
        {
          "role": "松平",
          "text": "唉，可惜了研次啊，那小子不该沦落成那个样子的。"
        }
      ],
