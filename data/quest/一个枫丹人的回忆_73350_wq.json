        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "但在天才的艾德温先生主持下，枫丹科学院的大部分建筑现在已经成了一片废墟…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "而雷蒙多和舒瓦瑟尔先生接手重建工作之后，院里的「研究精神」也正在坍塌。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "我是一个爱好整洁的人，不愿意在废墟堆里生活。所以就四处旅行，散散心。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "别皱眉，这些烦心事都和您无关。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "来，请您快些给我拍一张画片吧。等泽维尔见识到须弥的风光，他肯定不会再待在稻妻了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们曾经共事过…",
              "dialogues": [
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "您…哎呀！您难道就是泽维尔说的那位旅行者？"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "幸会！真是幸会啊，我早就从泽维尔的信里听说过您在「御影炉心」里的英勇事迹了。"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "而且泽维尔每次在信里谈到「映影」的时候，都要提到您在「映影」中高超的演技！"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "他说您既无畏，又高尚。最重要的是，幽默感也非常棒！"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "唉，等会您帮我留完影，一定得给我签个名才行，就签在画片上！"
                },
                {
                  "role": "旅行者",
                  "text": "泽维尔还好吗？"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "呃…老实说，不太好。他一直在为「映影」发愁。从信里看，他最近找不到有趣的新题材了。"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "我建议他和我一样，先放下手里的活，来须弥散散心。"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "但他一直说，他必须要拍摄一部最优秀的「映影」给「社奉行」。在那之前，他不会离开稻妻。"
                }
              ]
            },
            {
              "text": "你是怎么认识泽维尔的？",
              "dialogues": [
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "想必您也知道，泽维尔是枫丹科学院里的研究员。我曾与他在同一间研究室共事，他也曾经为我提供了许多指导。"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "他坚持要拍「映影」，还要做「映影导演」，在当时的枫丹科学院里，这个想法可不受欢迎。"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "即使后来被赶到了其他项目，他仍借着记录项目研究过程的名头，不断地拍摄着「记录映影」。"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "就这样，他在项目与研究室之间辗转，直到最终他被派到稻妻…"
                },
                {
                  "role": "奥古斯都·洛夫莱斯",
                  "text": "很有想法的人，假使他诞生在研究方向更为开明、经费更加充裕的过去，或者是美好的未来，想必能大有成就吧…"
                }
              ]
            }
          ]
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "先不说这些了，请您来帮我拍一张画片吧，在这里就行。"
        },
        {
          "type": "subtitle",
          "text": "拍摄画片"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "您帮我拍完画片了吗？"
        },
        {
          "role": "旅行者",
          "text": "还没有。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "唔，您慢慢来，拍摄画片确实不是一件简单的事。"
        },
        {
          "type": "subtitle",
          "text": "向奥古斯都回报"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "这画片真不错，您在留影方面很有天赋。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "自从开始旅行以来，对于构图与色彩把握有如此水准的人，我还是第一次见呢。"
        },
        {
          "role": "旅行者",
          "text": "你都到过什么地方？"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "这个啊，嗯…我本来可以直接从枫丹到须弥。毕竟枫丹有一条航线直通须弥的拜达港嘛。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "但俗话说，旅行最重要的是过程嘛，所以我还是选择了一条…更具有趣味性的旅游路线。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "首先，我先通过柔灯港来到了沉玉谷，并途经轻策庄到达了分隔蒙德与璃月的石门。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "在拜访晨曦酒庄以后，我还是决定南下到璃月港看看。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "在璃月港我搭上了去奥摩斯港的渡船，再经河道北上，就来到了这里，遇到了您。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "毕竟，这次旅行的动机还是散心。倘若我是个热衷冒险的勇士…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "或许我会乐意从海露港出发，走走古代的朝圣之路，向南深入沙漠吧。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "…谁知道呢？或许返程时，我会试试穿越大沙漠。这么说来，现在经费还很充足，或许穿越沙漠去纳塔看看也不错…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "好了，不耽误您的时间了。感谢您帮我留影，这些报酬请您收下。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "我得赶紧去给泽维尔写信了，他再不来须弥，我就要回枫丹了…"
        }
      ]
    }
  ]
}