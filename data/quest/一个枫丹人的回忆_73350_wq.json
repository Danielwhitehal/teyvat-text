{
  "quest_id": 73350,
  "chapter_num": null,
  "chapter_title": "一个枫丹人的回忆",
  "type": "wq",
  "route": "Recollections of a Fontainian",
  "stories": [
    {
      "story_id": 73350,
      "title": "一个枫丹人的回忆",
      "description": "在须弥城，你遇见了一个焦躁的枫丹人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与奥古斯都对话"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "啊…阿嚏！这些香料的味道真是太…啊…阿嚏！"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "还是快点留个影，回去屋里待着吧…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "旅行者，嗨，旅行者！请您留步！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你叫我？",
              "dialogues": []
            },
            {
              "text": "有什么事吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "我想请您帮我在这里留个影，一张就好，不会花多长时间的。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "这地方的香料味道对我来说，实在是太刺激了…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "我在枫丹的时候，吃的菜里可是连一点辣味都不能有，最多放一点盐。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "在这里，我喷嚏打得连…阿嚏！连留影机都要拿不稳了…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "所以，我只能拜托…拜托其他人帮我留影。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "您看上去就是个好心肠的人，所以…我就想请您来帮我这个忙。"
        },
        {
          "role": "旅行者",
          "text": "你来自枫丹？"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "没错，我都忘记自我介绍了，真是抱歉…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "我的名字是奥古斯都·洛夫莱斯，「枫丹动能工程科学研究院」的一名研究员。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「枫丹动能工程科学研究院」？",
              "dialogues": []
            },
            {
              "text": "那是什么地方？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "这串字是不是太长了？您也可以把它称作「枫丹科学院」，枫丹人也都这么叫。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "之前，枫丹科学院可以说是枫丹科研者的一座圣地，大部分的机关造物都出自我们院内。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "但在天才的艾德温先生主持下，枫丹科学院的大部分建筑现在已经成了一片废墟…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "而雷蒙多和舒瓦瑟尔先生接手重建工作之后，院里的「研究精神」也正在坍塌。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "我是一个爱好整洁的人，不愿意在废墟堆里生活。所以就四处旅行，散散心。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "别皱眉，这些烦心事都和您无关。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "来，请您快些给我拍一张画片吧。等泽维尔见识到须弥的风光，他肯定不会再待在稻妻了。"
        },
        {
          "role": "旅行者",
          "text": "提到泽维尔…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "泽维尔是枫丹科学院里的研究员。我曾与他在同一间研究室共事，他也曾经为我提供了许多指导。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "他坚持要拍「映影」，还要做「映影导演」，在当时的枫丹科学院里，这个想法可不受欢迎。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "即使后来被赶到了其他项目，他仍借着记录项目研究过程的名头，不断地拍摄着「记录映影」。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "就这样，他在项目与研究室之间辗转，直到最终他被派到稻妻…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "很有想法的人，假使他诞生在研究方向更为开明、经费更加充裕的过去，或者是美好的未来，想必能大有成就吧…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "先不说这些了，请您来帮我拍一张画片吧，在这里就行。"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "啊…阿嚏！这些香料的味道真是太…啊…阿嚏！"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "还是快点留个影，回去屋里待着吧…"
        },
        {
          "role": "奥古斯都·洛夫莱斯",
          "text": "旅行者，嗨，旅行者！请您留步！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你叫我？",
              "dialogues": []
            },
            {
              "text": "有什么事吗？",
              "dialogues": []
