{
  "quest_id": 74040,
  "chapter_num": null,
  "chapter_title": "孤帆幽影",
  "type": "wq",
  "route": "The Lone Phantom Sail",
  "stories": [
    {
      "story_id": 74040,
      "title": "孤帆幽影",
      "description": "艾伊丝似乎有事找你…",
      "dialogues": [
        {
          "role": "艾伊丝",
          "text": "你们好呀，艾伊丝是我的名字，很高兴遇见新朋友！"
        },
        {
          "role": "派蒙",
          "text": "你好呀，艾伊丝！我是派蒙！"
        },
        {
          "role": "旅行者",
          "text": "你好，我是旅行者。"
        },
        {
          "role": "艾伊丝",
          "text": "听薇蕾娜妲说，你们也发现了「那艘船」，是真的吗？是真的吗？"
        },
        {
          "role": "派蒙",
          "text": "欸…？虽然海里确实有好多船就是啦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哪艘船？",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "就是…就是…独一无二的「那艘船」！"
                },
                {
                  "role": "派蒙",
                  "text": "哦哦…「那艘船」呀…"
                }
              ]
            },
            {
              "text": "哦哦，是那艘船！",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "嗯，嗯！"
                },
                {
                  "role": "派蒙",
                  "text": "啊…是那艘船呀！我还以为是哪艘呢，哈哈…"
                },
                {
                  "role": "艾伊丝",
                  "text": "那…你们说的是哪艘船？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "……",
                      "dialogues": [
                        {
                          "role": "旅行者",
                          "text": "……"
                        }
                      ]
                    },
                    {
                      "text": "呃…就是…你说的那艘。",
                      "dialogues": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "role": "艾伊丝",
          "text": "哈哈！对不起，对不起！艾伊丝一定把你们搞迷糊啦！"
        },
        {
          "role": "艾伊丝",
          "text": "咳咳，「那艘船」就是「斯彭西安号」，穿梭幻梦的白色铁甲船，海渊与漩涡的探索者…海军司令贝瑟·埃尔顿的旗舰！"
        },
        {
          "role": "艾伊丝",
          "text": "贝瑟船长在这片水域留下了褪色的船骸，还有残破的航海日志…艾伊丝每天都会来这里，挑挑拣拣，读完了所有带文字的东西！"
        },
        {
          "role": "艾伊丝",
          "text": "嘿嘿，所以艾伊丝也算是「斯彭西安号」的考古学家了呢！她的一切我都了解！呃…也不对，至少是了解一半啦！"
        },
        {
          "role": "派蒙",
          "text": "哇，看起来艾伊丝真的很喜欢这艘船呢…一聊起来就滔滔不绝的。"
        },
        {
          "role": "派蒙",
          "text": "不过，既然艾伊丝也只了解一半…那一定是很大的一艘船吧？"
        },
        {
          "role": "艾伊丝",
          "text": "唔…也没有很大啦…是因为贝瑟船长只留下了一半船体…"
        },
        {
          "role": "派蒙",
          "text": "哦哦…所以说…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以说，你找到了我。",
              "dialogues": []
            },
            {
              "text": "原来你说的是「那艘船」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾伊丝",
          "text": "哈哈，嗯！艾伊丝就知道你会懂的！"
        },
        {
          "role": "艾伊丝",
          "text": "薇蕾娜妲告诉我的，她说你从幻觉中看到了她！永远前进的「斯彭西安号」！她从卡苏利亚的仙境国土回来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准确说，是她的前半截…",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "没错！前半截！永不沉没的前半截！我就知道她还在不断地发现新的水域！还在与暗礁和漩涡、漆黑的舰队做着殊死斗争，还在…"
                }
              ]
            },
            {
              "text": "我没法确定，但的确是半艘透明船…",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "一定是的，一定是她的！艾伊丝从来没有怀疑过，自从她回应了我，我就明白的！她一定还在！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呜哇…你冷静些啦！那个，你还没说要我们帮什么忙呢？"
        },
        {
          "role": "艾伊丝",
          "text": "欸？帮忙？唔…艾伊丝也没有要你们帮忙啦，不算帮忙。但既然旅行者也目睹过「斯彭西安号」…"
        },
        {
          "role": "艾伊丝",
          "text": "嗯…艾伊丝正好在寻找她，你们不如也一起来吧！"
        },
        {
          "role": "派蒙",
          "text": "看你这么热情，我们也不好拒绝啦…而且你说到沉船…沉船宝藏…我觉得也不是不行！"
        },
        {
          "role": "旅行者",
          "text": "那我们就去会会她。"
        },
        {
          "role": "艾伊丝",
          "text": "嗯，就是这个精神！我们起航！"
        },
        {
          "type": "subtitle",
          "text": "前往艾伊丝提及的地点"
        },
        {
          "role": "艾伊丝",
          "text": "就是这里，我们到啦！"
        },
        {
          "role": "艾伊丝",
          "text": "唔，请你们稍等，让艾伊丝调试一下海螺。"
        },
        {
          "role": "派蒙",
          "text": "欸？「调试」…海螺？虽然烤海螺是很好吃啦…"
        },
        {
          "role": "艾伊丝",
          "text": "派蒙就知道吃呢，是沟通用的军用海螺！"
        },
        {
          "role": "旅行者",
          "text": "军用…海螺？"
        },
        {
          "role": "艾伊丝",
          "text": "嗯，是老式的军用海螺，古代海员互相联络时用的工具…应该是海军还在的时候留下的遗物，我从沉船中找到的。"
        },
        {
          "role": "艾伊丝",
          "text": "上次就在这里，我调试海螺时听到了她的回应。既然你见到过她，那我觉得你一定也能听到她的回应的！"
        },
        {
          "role": "艾伊丝",
          "text": "不过需要等一等哦，艾伊丝要先调试一下海螺的状态，然后才能发出正确的讯号。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以说，那艘船会接收特定的讯号。",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "嗯，没错。但时刻与海况的不同也会影响海螺的发声状况，所以需要时时调试。嘿嘿…古董就是这点不好啦。"
                }
              ]
            },
            {
              "text": "也就是说，她会随讯号而出现？",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "嘿嘿，很神奇吧？就像鲸鱼一样，你唱歌，她也回应你的歌。我亲耳听到的，是真的哦。"
                }
              ]
            }
          ]
        },
        {
          "role": "艾伊丝",
          "text": "唔，总之…等一下啦，等我把海螺与波浪的振动调谐好…你们不要乱走哦。"
        },
        {
          "role": "？？？",
          "text": "艾伊丝灵活地摆弄了一会手中的海螺，不久后便完成了调试…"
        },
        {
          "role": "艾伊丝",
          "text": "这就好啦！哼哼，艾伊丝从那些老旧的海军手册里学到了不少技术呢！"
        },
        {
          "role": "艾伊丝",
          "text": "嗯，请让艾伊丝介绍一下吧。艾伊丝一般常用的短信号有这三种…"
        },
        {
          "role": "艾伊丝",
          "text": "「长低音，短低音，长低音」。嗯…这个的含义是…艾伊丝猜测，应该是「准备就绪」。"
        },
        {
          "role": "艾伊丝",
          "text": "「长低音，长低音，长低音，长低音，长低音」。这个的含义…唔，艾伊丝还不清楚呢，但上次收到的回音大致是这样，所以一定也是有用的！"
        },
        {
          "role": "艾伊丝",
          "text": "「短低音，长低音，短低音，长低音，短低音，长低音，短低音，长低音，短低音，长低音」…呼，好长！这是最有几率获得回音的讯号，至于含义…"
        },
        {
          "role": "艾伊丝",
          "text": "是「我有消息要发送」的意思…手册是这么写的。"
        },
        {
          "role": "派蒙",
          "text": "唔…所以，我们要怎么做才能试出能获得回应的讯号呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "通过推理找出对应的讯号？",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "呜，不行。随机性太大，明确的信息又太少了…发送这三个讯号后，都曾收到过神秘的回音，但…"
                },
                {
                  "role": "艾伊丝",
                  "text": "但艾伊丝并没有发现讯号和「斯彭西安号」出现规律之间的关系有「理」可「推」…"
                },
                {
                  "role": "艾伊丝",
                  "text": "所以，只能挨个尝试了吧…"
                }
              ]
            },
            {
              "text": "我们挨个来试试吧？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…我们不用更省事…我是说更聪明的办法吗？比如…推理什么的！"
                },
                {
                  "role": "旅行者",
                  "text": "派蒙你来推推看？"
                },
                {
                  "role": "派蒙",
                  "text": "哼哼…我来推理的话，我们不如先列一个表格，其中得到回音的频率最高的一组，就是我们要选的讯号啦！"
                },
                {
                  "role": "艾伊丝",
                  "text": "…唔，虽然在枫丹，一般航船根据法律必须回应讯号没错…但我们要寻找的那艘船，可不是一般意义上的航船哦？"
                },
                {
                  "role": "艾伊丝",
                  "text": "所以，我们很难期待她一定依照某个讯号给我们发出回应…也就是说，推理的基础是不存在的，随机性太大，并且缺少证据。"
                },
                {
                  "role": "派蒙",
                  "text": "呜哇…那、那我们还是一个个来试吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "艾伊丝",
          "text": "那么，我们从哪个讯号开始呢？"
        },
        {
          "type": "subtitle",
          "text": "与艾伊丝对话"
        },
        {
          "role": "旅行者",
          "text": "从最长的开始吧。"
        },
        {
          "role": "旅行者",
          "text": "从最短的开始吧。"
        },
        {
          "role": "旅行者",
          "text": "就先试试长短适中的吧。"
        },
        {
          "role": "旅行者",
          "text": "我不知道，艾伊丝喜欢哪个呢？"
        },
        {
          "role": "艾伊丝",
          "text": "欸，我吗？嗯…我的话，是这个。"
        },
        {
          "role": "？？？",
          "text": "艾伊丝用海螺发出了信号…"
        },
        {
          "role": "艾伊丝",
          "text": "「长低音，长低音，长低音，长低音，长低音」，这是你选择的讯号哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，我明白了！",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "嘿嘿，加油哦！"
                }
              ]
            },
            {
              "text": "海螺实在是很难操作…",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "这样吗…嘿嘿，没办法呢，还是我自己来吧！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "没关系，我再试试。",
                      "dialogues": [
                        {
                          "role": "艾伊丝",
                          "text": "辛苦你啦！"
                        }
                      ]
                    },
                    {
                      "text": "好吧，麻烦你啦。",
                      "dialogues": [
                        {
                          "role": "艾伊丝",
                          "text": "嗯嗯，让我来吧！"
                        },
                        {
                          "role": "？？？",
                          "text": "艾伊丝用海螺发出了信号…"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "使用海螺发送信号"
        },
        {
          "role": "艾伊丝",
          "text": "这里…好混乱，都是不完整的船骸，大部分都是碎片。"
        },
        {
          "role": "旅行者",
          "text": "从痕迹来看，她应该还在前进。"
        },
        {
          "role": "艾伊丝",
          "text": "但她一定遭受了不可修复的损伤，为什么在这种情况下还能继续前进呢？或许…我们很快就能发现原因了。"
        },
        {
          "role": "派蒙",
          "text": "这么多碎片，也许是被大海怪「啊呜」一下咬成了两半呢！"
        },
        {
          "role": "艾伊丝",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "与艾伊丝对话"
        },
        {
          "role": "艾伊丝",
          "text": "欸…你听到了吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯？什么呀…"
        },
        {
          "role": "艾伊丝",
          "text": "嘘，讯号…等等…她、她就在那边！在那边的远处！"
        },
        {
          "role": "派蒙",
          "text": "哇？我、我什么都没看到呀！"
        },
        {
          "role": "旅行者",
          "text": "嗯，我看到了。"
        },
        {
          "role": "艾伊丝",
          "text": "嗯！我就知道你也能看到！快，我们追上她！"
        },
        {
          "role": "派蒙",
          "text": "追、追什么呀，追船吗？你们是也长了风帆或者螺旋桨吗！"
        },
        {
          "type": "subtitle",
          "text": "追随出现的幻影"
        },
        {
          "type": "subtitle",
          "text": "追随出现的幻影"
        },
        {
          "role": "艾伊丝",
          "text": "也就是说，「斯彭西安号」受了重伤，她受伤的原因与深渊远征有关，以及…她还在继续前进。那么…"
        },
        {
          "role": "艾伊丝",
          "text": "我们再用海螺发送信号吧，也许前方还会有她的回响呢！"
        },
        {
          "role": "艾伊丝",
          "text": "对了、对了，你要发送的讯号分别是：「长低音，短低音，长低音」…"
        },
        {
          "role": "艾伊丝",
          "text": "「长低音，长低音，长低音，长低音，长低音」，还有…嗯…"
        },
        {
          "role": "艾伊丝",
          "text": "「短低音，长低音，短低音，长低音，短低音，长低音，短低音，长低音，短低音，长低音」…呼，好长！不过这三个讯号应该都可以收到回音！"
        },
        {
          "type": "subtitle",
          "text": "与艾伊丝对话"
        },
        {
          "role": "艾伊丝",
          "text": "怎么，忘了吗？你要发送的讯号分别是：「低音，高音，低音」…"
        },
        {
          "role": "艾伊丝",
          "text": "「低音，低音，低音，低音，低音」，还有…嗯…"
        },
        {
          "role": "艾伊丝",
          "text": "「高音，低音，高音，低音，高音，低音，高音，低音，高音，低音」…呼，好长！不过这三个讯号应该都可以收到回音！"
        },
        {
          "role": "艾伊丝",
          "text": "奇怪…为什么她不再出现了呢？"
        },
        {
          "role": "派蒙",
          "text": "呜哇…我跟着你们迷迷糊糊跑了这么远，虽然看不见你们说的「那艘船」…"
        },
        {
          "role": "派蒙",
          "text": "但既然在这里消失了，一定是想要提示我们要找什么东西吧？说不定是「遗失的秘宝」之类的好东西呢！"
        },
        {
          "role": "艾伊丝",
          "text": "嘿嘿，小水母派蒙很贪财呢。"
        },
        {
          "role": "艾伊丝",
          "text": "不过我们要去寻找的可不是宝藏哦…嗯，非要说的话，应该是「证物」吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「证物」，你的意思是…？",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "就是「斯彭西安号」经过这里的证据。比如航海日志、船身碎片，或者航海工具什么的…总之，应该能够找到与她相关的线索！"
                },
                {
                  "role": "派蒙",
                  "text": "哦…这样啊…"
                }
              ]
            },
            {
              "text": "派蒙别灰心，说不定也有宝藏呢。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，我就是这样想的！"
                },
                {
                  "role": "艾伊丝",
                  "text": "也许吧…不过我们这次不是要去寻找宝藏的哦，我们要找的是「斯彭西安号」经过这里的证据。"
                },
                {
                  "role": "艾伊丝",
                  "text": "比如航海日志、船身碎片，或者航海工具什么的…总之，与她相关的线索。"
                }
              ]
            }
          ]
        },
        {
          "role": "艾伊丝",
          "text": "我们可以利用海螺发出声音，然后通过分辨传回的音波，就能够大致确定它们的位置了。"
        },
        {
          "type": "subtitle",
          "text": "调查线索地点"
        },
        {
          "role": "派蒙",
          "text": "欸…是箱子和…水桶？我们打开看看吧？说不定是…"
        },
        {
          "role": "艾伊丝",
          "text": "是石头哦。"
        },
        {
          "role": "派蒙",
          "text": "嗯！是很值钱的石头呢！"
        },
        {
          "role": "艾伊丝",
          "text": "哈哈哈，笨派蒙！是压舱物啦！用来稳定战舰重量的压舱物！"
        },
        {
          "role": "派蒙",
          "text": "这样啊…那…我猜应该没有值钱的压舱物就是了…"
        },
        {
          "role": "艾伊丝",
          "text": "不过既然我们能在单个地点找到这么多压舱物，也许说明这艘船经历了紧急上浮的操作…"
        },
        {
          "role": "艾伊丝",
          "text": "也就是说，当时她一定遭遇了突发的险情，即使作为铁甲舰队的旗舰，也不得不紧急避险。"
        },
        {
          "type": "subtitle",
          "text": "调查线索地点"
        },
        {
          "role": "派蒙",
          "text": "唔…破木板、船桨，还有…小艇的残骸。这里没什么好看的啦…"
        },
        {
          "role": "艾伊丝",
          "text": "是救生艇…即使是救生艇也被破坏了…嗯？你看那边，木板缝隙间是什么？"
        },
        {
          "role": "派蒙",
          "text": "唔…好像是纸张的残片…是日志吗？我们取出来看看吧？"
        },
        {
          "role": "旅行者",
          "text": "他们是来对抗深渊魔物的…"
        },
        {
          "role": "艾伊丝",
          "text": "嗯…艾伊丝也曾听说过关于它们的传说。但是…难道「斯彭西安号」真的已经…"
        },
        {
          "role": "艾伊丝",
          "text": "哼，证据还不充分。我们继续去下一个地点吧。"
        },
        {
          "type": "subtitle",
          "text": "调查线索地点"
        },
        {
          "type": "subtitle",
          "text": "与艾伊丝对话"
        },
        {
          "role": "旅行者",
          "text": "我选最长的吧。"
        },
        {
          "role": "旅行者",
          "text": "就先试试长短适中的吧。"
        },
        {
          "role": "旅行者",
          "text": "从最短的开始吧。"
        },
        {
          "role": "艾伊丝",
          "text": "还记得讯号吗？「短低音，长低音，短低音，长低音，短低音，长低音，短低音，长低音，短低音，长低音」！"
        },
        {
          "role": "艾伊丝",
          "text": "嘿嘿，很长呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，我明白了！",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "嘿嘿，加油哦！"
                }
              ]
            },
            {
              "text": "海螺实在是很难操作…",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "这样吗…嘿嘿，没办法呢，还是我自己来吧！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "没关系，我再试试。",
                      "dialogues": [
                        {
                          "role": "艾伊丝",
                          "text": "辛苦你啦！"
                        }
                      ]
                    },
                    {
                      "text": "好吧，麻烦你啦。",
                      "dialogues": [
                        {
                          "role": "艾伊丝",
                          "text": "嗯嗯，让我来吧！"
                        },
                        {
                          "role": "？？？",
                          "text": "艾伊丝用海螺发出了信号…"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "再次使用海螺发送信号"
        },
        {
          "type": "subtitle",
          "text": "追随再度出现的幻影"
        },
        {
          "type": "subtitle",
          "text": "到达幻影停驻的地点"
        },
        {
          "type": "subtitle",
          "text": "与艾伊丝对话"
        },
        {
          "role": "派蒙",
          "text": "呜哇…你们看，这些残骸就是我们先前一直在追的那艘船吧！呃…我是说，那半艘…"
        },
        {
          "role": "艾伊丝",
          "text": "……！"
        },
        {
          "role": "艾伊丝",
          "text": "好、好碎…"
        },
        {
          "role": "派蒙",
          "text": "唔…艾伊丝你别伤心啦…这艘船变成这样，也不是我们能预料到的呀？"
        },
        {
          "role": "艾伊丝",
          "text": "话是这么说，可是…唔，算了…我去旁边看看有什么值得调查的东西吧…"
        },
        {
          "role": "派蒙",
          "text": "嗯，说不定还剩了些好东西呢…旅行者，我们也调查一下附近吧！"
        },
        {
          "type": "subtitle",
          "text": "调查船骸附近的线索"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "也就是说，这艘船是在对抗海兽的过程中沉没的…"
        },
        {
          "role": "派蒙",
          "text": "然后，这半部分船身被巨浪撕碎，又随着洋流飘荡，最终在这里搁浅了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许她正是被海兽所摧毁的。",
              "dialogues": []
            },
            {
              "text": "…所以另一半在海兽的遗体中。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那不就是说，她真的是被海兽咬成两半的…欸？什么声音？"
        },
        {
          "role": "派蒙",
          "text": "呜哇，是魔物！讨厌的家伙又来了！"
        },
        {
          "role": "旅行者",
          "text": "派蒙，躲起来！"
        },
        {
          "role": "派蒙",
          "text": "可、可是…嗯！"
        },
        {
          "type": "subtitle",
          "text": "击败怪物"
        },
        {
          "type": "subtitle",
          "text": "调查奇异的掉落物"
        },
        {
          "role": "？？？",
          "text": "「…离开她吧，水手们，离开她吧…」\\n「…明天就是结薪日，是时候离开她了…」\\n「…离开她吧，水手们，离开她吧…」\\n「…旅途告终，风不再吹，是时候离开她了…」"
        },
        {
          "role": "？？？",
          "text": "「…酒也喝不着，肉也发了臭，是时候离开她了…」\\n「…离开她吧，水手们，离开她吧…」\\n「…我们该散伙各奔生路了，是时候离开她了…」"
        },
        {
          "role": "？？？",
          "text": "随着如梦的歌声溶入海波，奇异的吊坠中传出了忧伤的声音…"
        },
        {
          "role": "？？？",
          "text": "「蓝色的、像个小海员一样的孩子…我看到了她…呵呵…」\\n「那孩子的身上，带着海兽的气息…」\\n「但她是个好孩子，或许不会弄脏我的旗舰…」"
        },
        {
          "role": "？？？",
          "text": "「呵呵，只可惜我没有保护好她，真是艘好船…」"
        },
        {
          "type": "subtitle",
          "text": "与派蒙等人对话"
        },
        {
          "role": "艾伊丝",
          "text": "嗯？忘记讯号了吗？是「长低音，短低音，长低音」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，我明白了！",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "嘿嘿，加油哦！"
                }
              ]
            },
            {
              "text": "海螺实在是很难操作…",
              "dialogues": [
                {
                  "role": "艾伊丝",
                  "text": "这样吗…嘿嘿，没办法呢，还是我自己来吧！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "没关系，我再试试。",
                      "dialogues": [
                        {
                          "role": "艾伊丝",
                          "text": "辛苦你啦！"
                        }
                      ]
                    },
                    {
                      "text": "好吧，麻烦你啦。",
                      "dialogues": [
                        {
                          "role": "艾伊丝",
                          "text": "嗯嗯，让我来吧！"
                        },
                        {
                          "role": "？？？",
                          "text": "艾伊丝用海螺发出了信号…"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "旅行者，你还好吗！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！刚刚你让我躲起来，然后自顾自就去狂揍史莱姆…然后、然后还捞起一把沙子，又是发呆又是自言自语的！"
        },
        {
          "role": "派蒙",
          "text": "刚刚到底发生什么了呀，好吓人！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我经历了船沉前的时刻…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？所以…你刚刚以为自己在和一群深渊怪物作战吗？难怪表情认真得吓人！"
                },
                {
                  "role": "派蒙",
                  "text": "哼，要我说，肯定是薇蕾娜妲那家伙的药有问题，才让你变成这样的！"
                }
              ]
            },
            {
              "text": "我捡到了这个银吊坠。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "吊坠？唔…你手里除了沙子没有别的东西啦…嗯？我还看到了好小的小海螺…"
                },
                {
                  "role": "派蒙",
                  "text": "所以，刚刚你就是和「幻想吊坠」对话吗？唔…我觉得肯定是刚刚航海日志里的内容把你搞糊涂啦…"
                }
              ]
            }
          ]
        },
        {
          "role": "艾伊丝",
          "text": "好吵，好吵！你们都在干什么呀！是想要趁艾伊丝不在，把这些残骸都弄走吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…这种破船的木材很值钱吗？"
        },
        {
          "role": "艾伊丝",
          "text": "艾伊丝也不知道…喂，你这坏水母，还真的在这么盘算吗！"
        },
        {
          "role": "艾伊丝",
          "text": "唔…虽然已经破碎得不成样子了，唉，但收拢一下大概还是能作为纪念物带回去的…"
        },
        {
          "role": "艾伊丝",
          "text": "复原白色铁甲舰原来的模样，恐怕是没有可能了…但我还能继续探索她曾经历过什么，或许吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "贝瑟船长好像很喜欢你呢。",
              "dialogues": []
            },
            {
              "text": "我听到了贝瑟船长的声音。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾伊丝",
          "text": "嗯！嗯…？什、什么…？"
        },
        {
          "role": "派蒙",
          "text": "没什么啦！刚才开始旅行者就这样怪怪的…可能休息一会就好了吧。"
        },
        {
          "role": "艾伊丝",
          "text": "哈哈哈哈，派蒙也不要这样说啦！我相信旅行者看到了我们都没看到的东西，嗯…至少这样相信总没坏处。"
        },
        {
          "role": "艾伊丝",
          "text": "就像…我相信着，贝瑟船长一定也一直支持着我…"
        },
        {
          "role": "艾伊丝",
          "text": "之后，我会想办法慢慢修复她的日志和航程图，把她经历过的探险与故事一个接一个准确地标在海图上！"
        },
        {
          "role": "艾伊丝",
          "text": "这就是我想做的事情。虽然…也许有些名字再也找不到意义，有些港湾再也没人知道在哪里了…"
        },
        {
          "role": "派蒙",
          "text": "那也没关系啦，留给新人再去重新发现就好！"
        },
        {
          "role": "艾伊丝",
          "text": "嗯！谢谢你们帮我找到了「斯彭西安号」！请收下我的谢礼！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，好呀！再见咯！"
        }
      ]
    }
  ]
}