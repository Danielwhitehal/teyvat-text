{
  "quest_id": 75505,
  "chapter_num": null,
  "chapter_title": "蜜虫之宝",
  "type": "wq",
  "route": "Aphid Treasure",
  "stories": [
    {
      "story_id": 75505,
      "title": "蜜虫之宝",
      "description": "「回声之子」的市场上流通起了一种新鲜的小玩意…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往「回声之子」"
        },
        {
          "role": "派蒙",
          "text": "是希诺宁！你居然在这里。"
        },
        {
          "role": "希诺宁",
          "text": "嗨，是派蒙和旅行者啊。怎么？在家门口见到我很奇怪吗？"
        },
        {
          "role": "派蒙",
          "text": "不是啦，因为刚刚解决了那么大的问题，我以为你会找一棵漂亮的树，使劲躺个几天呢。"
        },
        {
          "role": "希诺宁",
          "text": "哈哈，我倒是那么想过，但这时候大家还忙着重建工作呢。这时候偷懒可不太像话。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以你在这干活吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "喏，给你们看个东西。"
        },
        {
          "role": "派蒙",
          "text": "哇！好漂亮的宝石！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看起来很珍贵。",
              "dialogues": [
                {
                  "role": "希诺宁",
                  "text": "确实，但不止这样。"
                }
              ]
            },
            {
              "text": "看起来不太对劲。",
              "dialogues": [
                {
                  "role": "希诺宁",
                  "text": "还是你敏锐。"
                }
              ]
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "这是最近才开始在市场流通的异纹燃素蜜珠。燃素蜜珠原本只是燃素蜜虫产的小玩意，那些很常见。"
        },
        {
          "role": "希诺宁",
          "text": "但这种异纹的燃素蜜珠却很新奇，数量也不多，所以价格不菲。"
        },
        {
          "role": "派蒙",
          "text": "这个我懂…我们在野外找宝箱的时候，也喜欢那种花纹看起来很厉害的！"
        },
        {
          "role": "希诺宁",
          "text": "呵呵，所以我也稍微买了几枚回来收藏，结果没过几天，我养在旁边的盆栽却枯萎了。"
        },
        {
          "role": "希诺宁",
          "text": "开始我没在意，我本来就搞不懂怎么养绿植。可后来我听卡齐娜说，族里一些人生了病。"
        },
        {
          "role": "希诺宁",
          "text": "病人大多是夏温宝石店的顾客，老板夏温自己也不例外…"
        },
        {
          "role": "派蒙",
          "text": "啊？这样想的话…难道和这颗宝石有关？"
        },
        {
          "role": "希诺宁",
          "text": "我也这么猜测，所以我砸碎了一颗蜜珠，发现里面居然包裹着一些深渊能量。"
        },
        {
          "role": "希诺宁",
          "text": "这些深渊能量的浓度非常低，又被蜜珠外壳隔绝，所以几乎察觉不到。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那病人现在怎么样了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "安心，因为浓度实在不高，所以大家的病情普遍不严重，多是一些嗜睡、易疲劳的症状。"
        },
        {
          "role": "希诺宁",
          "text": "像我和卡齐娜这样身体素质稍好的，完全没影响。"
        },
        {
          "role": "派蒙",
          "text": "噢…还好是史级危险。"
        },
        {
          "role": "希诺宁",
          "text": "史级？史诗级？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我猜是史莱姆级。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，还是你懂我。就是像史莱姆那样只能威胁到普通人的等级。"
        },
        {
          "role": "希诺宁",
          "text": "哈哈，你们两个，真有默契。"
        },
        {
          "role": "派蒙",
          "text": "话说回来，我们也遇到过不少被史莱姆吓到瑟瑟发抖的人，所以这种危险也不能放着不管吧？"
        },
        {
          "role": "希诺宁",
          "text": "不错，我已经向首领说明情况，请他把市场上的异纹蜜珠收集起来集中销毁了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有源头也得处理干净。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "我和你的想法一样。前面说过，燃素蜜珠是燃素蜜虫产的东西，所以我猜测问题的源头就在它们身上。"
        },
        {
          "role": "希诺宁",
          "text": "我去找了基尼奇，他在调查这方面比较在行。昨天他传来消息，确实发现了被深渊污染的蜜虫。"
        },
        {
          "role": "希诺宁",
          "text": "除了这里，「悬木人」和「流泉之众」附近也有它们的踪迹。嗯，他也顺便通知了玛拉妮。"
        },
        {
          "role": "希诺宁",
          "text": "不过他们的族人对宝石不怎么热衷，所以影响更小。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样…看来深渊带来的衍生问题还没有都解决，要耐心处理才行呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你们打算怎么处理蜜虫？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "先把它们捉起来，这种程度的深渊污染我们有办法净化，不至于伤及蜜虫的性命。"
        },
        {
          "role": "希诺宁",
          "text": "基尼奇标记了蜜虫集中出现的地方，我现在正打算去部族附近的那一处。"
        },
        {
          "role": "希诺宁",
          "text": "话说，你们有没有兴趣一起来？捉蜜虫，还挺有意思的对吧？"
        },
        {
          "role": "希诺宁",
          "text": "我本来想叫上卡齐娜，可惜她还有别的活要忙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你就是想偷懒吧？",
              "dialogues": [
                {
                  "role": "希诺宁",
                  "text": "哪里的话，我可不打算躺在树上旁观，我会和你们一起干活的。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "开玩笑的，我们出发吧。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "希诺宁",
                  "text": "很高兴你们愿意来，这样我就不会很无聊了。我们出发吧。"
                }
              ]
            },
            {
              "text": "乐意奉陪。",
              "dialogues": [
                {
                  "role": "希诺宁",
                  "text": "很高兴你们愿意来，这样我就不会很无聊了。我们出发吧。"
                }
              ]
            },
            {
              "text": "感觉不怎么有意思，算了。",
              "dialogues": [
                {
                  "role": "希诺宁",
                  "text": "那我要无聊死了…真的不来吗？我还打算送你们个小玩意呢。"
                },
                {
                  "role": "派蒙",
                  "text": "哦！原来还有报酬吗！是什么？"
                },
                {
                  "role": "希诺宁",
                  "text": "闪闪发光的小玩意，可好看了。"
                },
                {
                  "role": "派蒙",
                  "text": "哦！是摩拉！旅行者，我们可别错过赚摩拉的机会呀！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "前面是开玩笑，现在出发吧！",
                      "dialogues": []
                    },
                    {
                      "text": "看在摩拉的份上，陪你跑一趟吧。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "希诺宁",
                  "text": "哈哈，那我们走。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往深渊蜜虫的出没地点"
        },
        {
          "role": "希诺宁",
          "text": "就是这里了。"
        },
        {
          "role": "希诺宁",
          "text": "看见了吗？被深渊污染的蜜虫，它的体型比正常的同类大不少。"
        },
        {
          "role": "派蒙",
          "text": "居然是这么大的蜜虫…会不会有危险啊？"
        },
        {
          "role": "希诺宁",
          "text": "放心，即使被深渊污染，它们的习性似乎也没有什么变化。"
        },
        {
          "role": "希诺宁",
          "text": "但是为了顺利捕捉，我特制了大号的捕虫网，来，给你们，等会可以用这个禁锢蜜虫。"
        },
        {
          "role": "希诺宁",
          "text": "对了，基尼奇还提到了一个特殊情况，他侦察到深渊蜜虫活动范围总有一种特殊的浆果。"
        },
        {
          "role": "希诺宁",
          "text": "浆果里有麻痹蜜虫的毒素，我们可以把它们涂抹在网上，这样就能有效控制蜜虫的挣扎。"
        },
        {
          "role": "派蒙",
          "text": "欸？蜜虫总是活动在麻痹自己的浆果附近吗？有点奇怪…"
        },
        {
          "role": "希诺宁",
          "text": "我也觉得，我还是第一次知道有动物会待在对付自己的东西附近呢。"
        },
        {
          "role": "派蒙",
          "text": "真是反常！该不会这些蜜虫被污染，是什么人为的阴谋吧？！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙现在变得很警惕了嘛。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "喂喂，再傻瓜的向导也是会成长的！何况我本来就很聪明。"
        },
        {
          "role": "希诺宁",
          "text": "可惜，我们再三搜索，都没发现什么人为的痕迹。"
        },
        {
          "role": "希诺宁",
          "text": "所以暂时就先把它当作蜜虫的某种未知习性吧。"
        },
        {
          "role": "派蒙",
          "text": "好吧，不管怎么说，我们都要先把它们抓住，不能再有更多让人生病的东西了。"
        },
        {
          "role": "派蒙",
          "text": "捉虫小队出击！"
        },
        {
          "type": "subtitle",
          "text": "捕捉深渊蜜虫"
        },
        {
          "type": "subtitle",
          "text": "捕捉·其一"
        },
        {
          "type": "subtitle",
          "text": "「回声之子」一带有着深渊蜜虫活动的迹象，事不宜迟，就从这个区域开始捕捉行动吧！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "寻找深渊侵蚀的燃素蜜虫，运用捕虫网将其禁锢，快速破除护罩，并尽快通过攻击削减深渊力量，捕捉蜜虫。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与希诺宁交谈"
        },
        {
          "role": "派蒙",
          "text": "呼！搞定了，这家伙看起来很大，捉起来却挺轻松的。"
        },
        {
          "role": "派蒙",
          "text": "它除了会逃跑，一点都不危险，捕虫网和浆果的毒素也很管用。"
        },
        {
          "role": "希诺宁",
          "text": "呵呵，但毕竟是被深渊污染的蜜虫，说不定会吸引来魔物什么的，之后也不要太放松才好。"
        },
        {
          "role": "派蒙",
          "text": "嗯，这样说也很对！还有那些出现得很巧合的浆果，如果是我，肯定会离自己的敌人远远的。"
        },
        {
          "role": "派蒙",
          "text": "这不符合它们的本性，旅行者，我们要保持警惕，这里面可疑得很哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你倒是一副很有经验的样子。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，都是跟你学会的！"
        },
        {
          "role": "希诺宁",
          "text": "哈~"
        },
        {
          "role": "希诺宁",
          "text": "好了，总而言之，今天谢谢你们来陪我，搞定了一个蜜虫聚集的地方，差不多该休息了。"
        },
        {
          "role": "希诺宁",
          "text": "接下来的几天，就也要辛苦你们啦。"
        }
      ],
      "collapse_ranges": [
        [
          58,
          60
        ]
      ]
    }
  ]
}