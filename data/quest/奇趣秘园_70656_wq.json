  "chapter_title": "奇趣秘园",
  "type": "wq",
  "route": "Peculiar Wonderland",
  "stories": [
    {
      "story_id": 70656,
      "title": "奇趣秘园",
      "description": "冒险家协会的卜劳恩想要为你介绍位于蒙德野外的一处神秘的秘境。",
      "dialogues": [
        {
          "role": "卜劳恩",
          "text": "你好，你是来挑战面前这个秘境的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "有点兴趣。",
            "好像是个特殊的秘境。"
          ]
        },
        {
          "role": "旅行者",
          "text": "有点兴趣。"
        },
        {
          "role": "卜劳恩",
          "text": "那正好，就由我来介绍一下吧，我是冒险家协会的卜劳恩，负责看护这个秘境的入口。"
        },
        {
          "role": "卜劳恩",
          "text": "根据冒险家协会的记录，它好像只会在特定的时间出现。"
        },
        {
          "role": "卜劳恩",
          "text": "正好现在是风花节，我们把里面稍加改造，变成了一项特别的挑战，向所有人开放。"
        },
        {
          "role": "旅行者",
          "text": "不会有危险吗？"
        },
        {
          "role": "卜劳恩",
          "text": "没事，这是以庆祝节日为目的举办的特别活动，如果是没有冒险经验的人参加的话，会有资深冒险家全程陪同。"
        },
        {
          "role": "卜劳恩",
          "text": "不过，你们的冒险经验如此丰富，应该不需要我们帮忙了。"
        },
        {
          "role": "卜劳恩",
          "text": "你可以独自深入秘境探索，也可以邀请你的朋友，总之，只要最终通过，就可以获得一些奖励。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "明白了。",
            "有奖励的话可以试试。"
          ]
        },
        {
          "role": "旅行者",
          "text": "明白了。"
        },
        {
          "role": "卜劳恩",
          "text": "那我就不耽误时间了，祝你们在里面玩得愉快。"
        }
      ]
    }
  ]
}