{
  "quest_id": 25021,
  "chapter_num": null,
  "chapter_title": "洗理嵴锋·修锋",
  "type": "iq",
  "route": "Tending to a Tepetlisaurus: In Need of a Trim",
  "stories": [
    {
      "story_id": 25021,
      "title": "洗理嵴锋·修锋",
      "description": "卡兹加似乎正在尝试用全新的方法来照顾霍莱…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与卡兹加对话"
        },
        {
          "role": "卡兹加",
          "text": "霍莱，这次你可不能乱跑了。"
        },
        {
          "role": "霍莱",
          "text": "呜，呜…"
        },
        {
          "role": "旅行者",
          "text": "今天霍莱很听话啊。"
        },
        {
          "role": "卡兹加",
          "text": "是啊。多亏了你帮我做的那个「漂流球」。"
        },
        {
          "role": "卡兹加",
          "text": "有了这个球，我也能引导霍莱去做各种事。不管是洗澡，吃东西，睡觉还是训练，都方便了很多。"
        },
        {
          "role": "卡兹加",
          "text": "特别是修剪指甲这件事！要是放在之前，我光是追霍莱都能追到累瘫。"
        },
        {
          "role": "卡兹加",
          "text": "现在只要把球放在霍莱面前，这小伙子就会乖乖坐下了。"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜…"
        },
        {
          "role": "卡兹加",
          "text": "霍莱，你记得他吗？这可是帮你做玩具的人。"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜呜！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "乖乖喔。",
              "dialogues": []
            },
            {
              "text": "（摸摸霍莱。）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡兹加",
          "text": "喔！霍莱记得你啊，看起来还挺开心的。"
        },
        {
          "role": "卡兹加",
          "text": "你要试试给它剪指甲吗？顺便再擦擦它的角。"
        },
        {
          "role": "卡兹加",
          "text": "这对小嵴锋龙来说可是一件很重要的事，毕竟它们可是要挖岩掘土，爪子必须要时常打磨，并且修剪那些长歪，或者被撞坏的指甲。"
        },
        {
          "role": "卡兹加",
          "text": "只有这样，才能保证小嵴锋龙在长大之后拥有一对最完美的爪子…"
        },
        {
          "role": "卡兹加",
          "text": "来，拿着这个！咱们正好趁这个修剪指甲的机会，把霍莱的全身都收拾一下！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你说得真详细…",
              "dialogues": []
            },
            {
              "text": "你怎么突然变兴奋了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜——"
        },
        {
          "role": "卡兹加",
          "text": "咳…难得看见霍莱这么听话。一想到今天我不用追着霍莱跑遍整个部族，我就不由自主地高兴…"
        },
        {
          "role": "旅行者",
          "text": "…真是辛苦你了。"
        },
        {
          "role": "卡兹加",
          "text": "没什么！那我们就开始吧，我会在旁边指导你的。"
        },
        {
          "role": "卡兹加",
          "text": "为了让霍莱放松，你首先得用大刷子轻轻清理它的后背…"
        },
        {
          "role": "卡兹加",
          "text": "再用细毛刷清理它的角，这个时候要用点力道，否则就会漏掉一些缝隙中的污渍。"
        },
        {
          "role": "卡兹加",
          "text": "然后呢，拿毛巾擦洗霍莱的全身…这样，它就会慢慢放松，四足上的爪子也会伸出来，这个时候，就可以为它修剪指甲了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这也太详细了。",
              "dialogues": []
            },
            {
              "text": "你真是了解霍莱…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡兹加",
          "text": "那当然。霍莱可是我一手带大的。整个部族…不，整个纳塔也找不到比我更了解它的人了。"
        },
        {
          "role": "卡兹加",
          "text": "好了，你就按照我刚才说的，帮霍莱修剪一下指甲吧。我就在旁边，不明白的话来问我就行。"
        },
        {
          "type": "subtitle",
          "text": "摸摸霍莱"
        },
        {
          "role": "霍莱",
          "text": "呜呜？呜？呜…"
        },
        {
          "role": "霍莱",
          "text": "（霍莱逐渐放松了下来。它舒展全身，四足的爪子也伸了出来。看起来是时候为它修剪指甲了。）"
        },
        {
          "role": "？？？",
          "text": "在卡兹加的指导下，为霍莱细致地修剪了指甲。"
        },
        {
          "role": "卡兹加",
          "text": "哈哈哈，没看出来，你还挺擅长做这件事的啊。"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜呜，呜——"
        },
        {
          "role": "卡兹加",
          "text": "霍莱也在谢谢你呢。你修剪得这么仔细，霍莱挖土的时候肯定能挖得更快。"
        },
        {
          "role": "卡兹加",
          "text": "这些东西给你，就当做是谢礼吧。呃…对了，我得叮嘱你一句，你之后要是得照顾其他小龙，可不能照搬今天的方法啊。"
        },
        {
          "role": "卡兹加",
          "text": "每一只小龙的脾气都不一样，照顾它们的方法也不一样，我折腾到现在，也就只弄懂了怎么照顾霍莱。"
        },
        {
          "role": "卡兹加",
          "text": "不过，能弄懂这件事我就已经知足了。毕竟，我们俩可要继续相处很久…"
        },
        {
          "role": "卡兹加",
          "text": "咦？霍莱去哪了？不，不会是又跑了吧！"
        },
        {
          "role": "卡兹加",
          "text": "喂！霍莱——"
        },
        {
          "role": "卡兹加",
          "text": "（霍莱的身体并没有放松，反而迷茫地看着你。）"
        },
        {
          "role": "？？？",
          "text": "（卡兹加及时接手了工作。在又一阵细致的打理后，终于还是为霍莱修剪了指甲…）"
        },
        {
          "role": "卡兹加",
          "text": "没关系，有时候我也会猜错霍莱的心思。但它肯定知道，你是一位对它很好的朋友。"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜！"
        },
        {
          "role": "卡兹加",
          "text": "哈哈哈，你看，我说什么来着？"
        },
        {
          "role": "卡兹加",
          "text": "这次还是多谢你了。这些东西给你，就当做是谢礼吧。"
        },
        {
          "role": "卡兹加",
          "text": "小龙的心思就是这么难猜，我也是和霍莱相处很久之后，才能猜出来它大部分的心思。"
        },
        {
          "role": "卡兹加",
          "text": "能做到这件事，我就已经知足了。毕竟，我们俩可要继续相处…"
        },
        {
          "role": "卡兹加",
          "text": "咦？霍莱去哪了？不，不会是又跑了吧！"
        },
        {
          "role": "卡兹加",
          "text": "喂！霍莱——"
        },
        {
          "role": "旅行者",
          "text": "（摸摸霍莱的肚子…）"
        },
        {
          "role": "霍莱",
          "text": "呜呜，呜。"
        },
        {
          "role": "霍莱",
          "text": "（霍莱歪了歪脑袋，挠了挠自己的肚子，迷茫地看着你。）"
        },
        {
          "role": "卡兹加",
          "text": "你可不能一直光顾着和霍莱玩呀。还有正事要做。"
        },
        {
          "role": "卡兹加",
          "text": "咳！还是我来吧。让我给你示范一下，正确的刷洗方法。"
        },
        {
          "role": "霍莱",
          "text": "（卡兹加及时接手了工作。在又一阵细致的打理后，终于还是为霍莱修剪了指甲…）"
        },
        {
          "role": "卡兹加",
          "text": "你可不能光顾着和霍莱玩啊，还是先做正事比较好。"
        },
        {
          "role": "霍莱",
          "text": "呜！呜呜呜！"
        },
        {
          "role": "卡兹加",
          "text": "哈哈哈哈，但霍莱看起来还挺喜欢和你玩的，难怪这次刷洗的时候它这么听话。"
        },
        {
          "role": "卡兹加",
          "text": "无论如何，这次还是多谢你了。这些东西给你，就当做是谢礼吧。"
        },
        {
          "role": "卡兹加",
          "text": "唔，要不然…我之后也试试，先陪霍莱玩个痛快，再给它刷洗…？"
        },
        {
          "role": "卡兹加",
          "text": "霍莱，你觉得这个主意怎么样？"
        },
        {
          "role": "卡兹加",
          "text": "咦？霍莱去哪了？不，不会是又跑了吧！"
        },
        {
          "role": "卡兹加",
          "text": "喂！霍莱——"
        }
      ]
    }
  ]
}