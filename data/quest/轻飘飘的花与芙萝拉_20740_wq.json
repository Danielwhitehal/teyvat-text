  "stories": [
    {
      "story_id": 20740,
      "title": "轻飘飘的花与芙萝拉",
      "description": "在蒙德城中开花店的芙萝拉正在发愁，她店里的花很多都被风吹走了。芙萝拉正在寻找一个人来帮助自己…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与芙萝拉对话"
        },
        {
          "type": "subtitle",
          "text": "采摘新鲜的花"
        },
        {
          "type": "subtitle",
          "text": "采摘新鲜的花"
        },
        {
          "type": "subtitle",
          "text": "采摘新鲜的花"
        },
        {
          "type": "subtitle",
          "text": "采摘新鲜的花"
        },
        {
          "type": "subtitle",
          "text": "向芙萝拉回报"
        },
        {
          "role": "旅行者",
          "text": "关于那些花…"
        },
        {
          "role": "芙萝拉",
          "text": "你采到那些花了吗？"
        },
        {
          "role": "旅行者",
          "text": "都采到了。"
        },
        {
          "role": "芙萝拉",
          "text": "都是很新鲜的花…谢谢你，这些花摆在店外，一定能吸引到很多客人。"
        },
        {
          "role": "芙萝拉",
          "text": "然后，我还有一个小小的请求…风刮起来的时候，店里的蒲公英也都被吹走了。"
        },
        {
          "role": "芙萝拉",
          "text": "虽然蒲公英籽被风带走不是件坏事…"
        },
        {
          "role": "芙萝拉",
          "text": "但是蒙德城的花店里没有蒲公英，感觉还是有点说不过去呢。"
        },
        {
          "role": "芙萝拉",
          "text": "蒲公英就不能直接摘掉带回来了，要从头种起才行…"
        },
        {
          "role": "芙萝拉",
          "text": "所以，能拜托你帮我去找一份蒲公英籽回来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "芙萝拉",
                  "text": "那就拜托你啦，在蒙德城外，我记得就有很多蒲公英。"
                }
              ]
            },
            {
              "text": "到哪里采？",
              "dialogues": [
                {
                  "role": "芙萝拉",
                  "text": "蒙德城外就有很多蒲公英，很容易就能采到啦。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "采摘一份蒲公英籽"
        },
        {
          "type": "subtitle",
          "text": "向芙萝拉回报"
        },
        {
          "role": "旅行者",
          "text": "关于蒲公英…"
        },
        {
          "role": "芙萝拉",
          "text": "你采到蒲公英了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经采到了。"
        },
        {
          "role": "芙萝拉",
          "text": "谢谢你，这一份就足够了，我等会就把它种到花盆里…"
        },
        {
          "role": "芙萝拉",
          "text": "还有之前你帮我摘到的那些花，我也都会种到花盆里。"
        },
        {
          "role": "芙萝拉",
          "text": "对了，还要谢谢你呢，这些是谢礼，请收下吧。"
        },
        {
          "role": "芙萝拉",
          "text": "我得快点把这些花栽进花盆里才行，还有蒲公英籽也得种下去…"
        },
        {
          "type": "subtitle",
          "text": "向芙萝拉回报"
        },
        {
          "role": "芙萝拉",
          "text": "哦对了，因为蒲公英籽才刚刚种下去，花盆里看起来什么都没有…我就暂时不把它拿出来展示啦。"
        },
        {
          "role": "芙萝拉",
          "text": "嗯…真希望它快点长大…"
        },
        {
          "role": "旅行者",
          "text": "关于那些花…"
        },
        {
          "role": "芙萝拉",
          "text": "在低语森林里摘小灯草和甜甜花，在风起地摘风车菊，最后是摘星崖上的塞西莉亚花。"
        },
        {
          "role": "芙萝拉",
          "text": "在这些地方，一定能摘到最新鲜的花。"
        },
        {
          "role": "芙萝拉",
          "text": "摘到之后，请快点拿回来给我吧。"
        },
        {
          "role": "旅行者",
          "text": "关于蒲公英…"
        },
        {
          "role": "芙萝拉",
          "text": "蒲公英在蒙德城外就可以找到了，但我还要收拾店里，实在抽不开身…"
        },
        {
          "role": "芙萝拉",
          "text": "拜托你，帮我搜集一份蒲公英籽回来吧。"
        },
        {
          "role": "芙萝拉",
          "text": "这样就可以了，呼呼，是不是很有花店的感觉了？"
        }
      ]
    }
  ]
}