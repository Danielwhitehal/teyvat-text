{
  "quest_id": 72239,
  "chapter_num": null,
  "chapter_title": "食莲者",
  "type": "wq",
  "route": "Lotus Eater",
  "stories": [
    {
      "story_id": 72239,
      "title": "食莲者",
      "description": "在大社遗迹中遇到的残影，自称是忘记了名字的反抗军…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "'''常夜",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在大社遗迹中遇到的残影，自称是忘记了名字的反抗军…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "和祭坛中出现的残影对话"
        },
        {
          "role": "？？？",
          "text": "孩子们，永远不要放弃，希望就在你们之中…"
        },
        {
          "role": "？？？",
          "text": "是你们吗？孩子们，你们成功了吗？"
        },
        {
          "role": "？？？",
          "text": "不，不是…我感觉到了，你们不是…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，他好像个目盲之后被留影的人…"
        },
        {
          "role": "？？？",
          "text": "不论你是什么人，请帮帮我！帮我找到孩子们，我有话要告诉他们。"
        },
        {
          "role": "旅行者",
          "text": "可是，你是谁呢？"
        },
        {
          "role": "？？？",
          "text": "我…我的名字是…"
        },
        {
          "role": "？？？",
          "text": "我…忘记了我的名字…"
        },
        {
          "role": "？？？",
          "text": "我只记得…我曾为白夜国站了出来，为了希望战斗过。"
        },
        {
          "role": "？？？",
          "text": "我至今仍然是反抗军。"
        },
        {
          "role": "派蒙",
          "text": "可是在白夜国这样的地底国家，你在反抗什么呢？"
        },
        {
          "role": "？？？",
          "text": "当然是庙堂之上污秽的贵人们！"
        },
        {
          "role": "？？？",
          "text": "他们号称接收着神明的旨意，嘴上打着神明的旗号，做的事却只为满足他们的低劣欲望。"
        },
        {
          "role": "？？？",
          "text": "表面上是太阳之子们的监护者，实际上就是国家的统治者，本质上却是趴在人民身上吸食血肉的虫豸！"
        },
        {
          "role": "？？？",
          "text": "他们必须要被消灭。"
        },
        {
          "role": "派蒙",
          "text": "这些记得这么清楚，却连自己的名字都忘记了…"
        },
        {
          "role": "？？？",
          "text": "那是因为他们的手段就是这么残忍！"
        },
        {
          "role": "？？？",
          "text": "因为上次的失败，他们抓住了我，将我囚禁在这处祭坛里折磨。"
        },
        {
          "role": "？？？",
          "text": "这是一个恶毒的囚牢，我能感觉到，我的灵魂被碾磨，有珍贵的东西在流失…"
        },
        {
          "role": "？？？",
          "text": "善良的人啊，我恳求你，趁我还记得这些，请去帮我找到孩子们！"
        },
        {
          "role": "？？？",
          "text": "告诉他们，永远不要放弃，希望就在他们之中…"
        },
        {
          "role": "旅行者",
          "text": "孩子们？"
        },
        {
          "role": "？？？",
          "text": "有一批愿意跟随我的青年人，他们很聪明。他们是我的学生，也是我们的后备军。我把他们看作是我的孩子。"
        },
        {
          "role": "？？？",
          "text": "邪恶的大人们想尽各种办法要撬开我的嘴，让我交代孩子们的情报，我不可能开口。"
        },
        {
          "role": "？？？",
          "text": "因为我知道，希望就在他们之中…"
        },
        {
          "role": "派蒙",
          "text": "现在这个时间点，他们应该都不在了吧…"
        },
        {
          "role": "？？？",
          "text": "不，不会的！他们都是好孩子，一样怀揣着理想。"
        },
        {
          "role": "？？？",
          "text": "我都没有放弃…他们一定还在坚持。"
        },
        {
          "role": "旅行者",
          "text": "应该如何找到他们？"
        },
        {
          "role": "？？？",
          "text": "我肯定记得，这种事我肯定记得…"
        },
        {
          "role": "？？？",
          "text": "我告诉你他们的藏身处。"
        },
        {
          "role": "派蒙",
          "text": "但是如果找到了他们，要怎样说明来意呢？"
        },
        {
          "role": "派蒙",
          "text": "「我们是一位忘记名字的反抗军大叔派来的」？"
        },
        {
          "role": "？？？",
          "text": "不，这还不够，我把他们教得很好。除非你们能够证明自己，否则他们绝对不会信任你们。"
        },
        {
          "role": "？？？",
          "text": "但我现在却连名字都想不起来了，可恶啊…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，这位大叔看起来曾经是白夜国的重犯。怎么说也是个历史里能留名的级别了。"
        },
        {
          "role": "派蒙",
          "text": "他的线索应该不难找到吧，说不定附近就有。我们可以先找找看。"
        },
        {
          "role": "？？？",
          "text": "如果在历史里留下名字，我希望这名字让我们事业的后继者来书写。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "？？？",
          "text": "找到了有关我身分的东西了吗？"
        },
        {
          "type": "subtitle",
          "text": "帮助残影寻找身份的线索"
        },
        {
          "role": "派蒙",
          "text": "那边有个小石碑…我们快去看看写了什么。"
        },
        {
          "type": "subtitle",
          "text": "一块古老的石碑"
        },
        {
          "type": "subtitle",
          "text": "（墓石上的字分为两排，其中，第一排以白夜国文写就，无法辨认。）",
          "narration": true
        },
        {
          "role": "（第二排为通用文字，上面写着",
          "text": "）"
        },
        {
          "type": "subtitle",
          "text": "「义士斯巴达克，今称『须婆达之彦』，之凭吊处。以下为其罪诏之翻译。望参观诸君谨记历史。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「贼子须婆达之彦，兴大罪之师，动国之根基。今奉常世大神谕，抉其目，菹其魂，羁幻之重狱，永生永世。」",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "唔…这上面提到了一些名字，贼子须、婆达之彦？"
        },
        {
          "role": "派蒙",
          "text": "哦——应该是贼子…须婆达之彦！难道这就是大叔的名字？我们快回去问问看大叔！"
        },
        {
          "type": "subtitle",
          "text": "向残影回报"
        },
        {
          "role": "？？？",
          "text": "你们…你们是谁？你们的声音有熟悉的感觉…"
        },
        {
          "role": "派蒙",
          "text": "欸？这么快把我们忘了…大叔的状况已经这么差了吗？好担心…"
        },
        {
          "role": "？？？",
          "text": "谢谢，我们真的认识吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们刚刚才见过。",
              "dialogues": []
            },
            {
              "text": "我们刚刚在寻找你的身份。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "啊，我想起来了…在这里灵魂会被磨损，我的记忆衰退太严重了。"
        },
        {
          "role": "？？？",
          "text": "抱歉，我…唉！"
        },
        {
          "role": "？？？",
          "text": "你们找到了有用的信息吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的名字是须婆达之彦吗？",
              "dialogues": []
            },
            {
              "text": "你的名字是贼子须吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哎呀，不是贼子须，是须婆达之彦啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "？？？",
          "text": "须婆达之彦…须婆达之彦，没错！我就是反抗军的首领，斯巴达克！"
        },
        {
          "role": "派蒙",
          "text": "所以须婆达之彦和斯巴达克，都是大叔的名字吗？不愧是首领大叔啊，连名字都有两个！"
        },
        {
          "role": "须婆达之彦",
          "text": "感谢你们找回了我的名字，我好像还想起了一些别的…"
        },
        {
          "role": "须婆达之彦",
          "text": "……"
        },
        {
          "role": "须婆达之彦",
          "text": "「黑暗来自太阳之后，光明藏于你我之中。」"
        },
        {
          "role": "旅行者",
          "text": "这是？"
        },
        {
          "role": "须婆达之彦",
          "text": "这是我们反抗军的秘密口令。"
        },
        {
          "role": "须婆达之彦",
          "text": "找回了名字，记忆也逐渐回来了。这应该就是我们的暗号。"
        },
        {
          "role": "须婆达之彦",
          "text": "现在，让我把孩子们的藏身处告诉你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么需要我带话的吗？",
              "dialogues": [
                {
                  "role": "须婆达之彦",
                  "text": "让我想想，让我想想…"
                },
                {
                  "role": "须婆达之彦",
                  "text": "把我的话带给他们，让他们永远不要放弃，白夜国的希望就在他们之中。"
                }
              ]
            },
            {
              "text": "你希望我带他们回来见你吗？",
              "dialogues": [
                {
                  "role": "须婆达之彦",
                  "text": "不，永远不要。"
                },
                {
                  "role": "须婆达之彦",
                  "text": "我们唯一的优势，就是敌明我暗，而且所有白夜之民的心都和我们在一起。不要轻易暴露自己。"
                },
                {
                  "role": "须婆达之彦",
                  "text": "更何况，现在我已经不能记住他们每个人的名字了。甚至连自己的名字都已经…"
                },
                {
                  "role": "须婆达之彦",
                  "text": "把我的话带过去，让他们永远不要放弃，白夜国的希望就在他们之中。"
                }
              ]
            },
            {
              "text": "如果他们已经不在了…",
              "dialogues": [
                {
                  "role": "须婆达之彦",
                  "text": "不会的。只要操纵太阳之子的肮脏大人们还存在一天，他们就一直在。而反抗也会一直继续。"
                },
                {
                  "role": "须婆达之彦",
                  "text": "把我的告诫带给他们，让他们永远不要放弃，白夜国的希望就在他们之中。"
                },
                {
                  "role": "须婆达之彦",
                  "text": "这样就已经足够了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆前往「孩子们的藏身处」"
        },
        {
          "type": "subtitle",
          "text": "◆和藏身处的残影对话"
        },
        {
          "role": "？？？",
          "text": "你是什么人？"
        },
        {
          "role": "？？？",
          "text": "赶紧离开，这里可不是你该来的地方。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "光明来自太阳之后…",
              "dialogues": [
                {
                  "role": "？？？",
                  "text": "什么和什么啊，赶紧走开！（结束 需重新对话）"
                }
              ]
            },
            {
              "text": "黑暗来自太阳之后…",
              "dialogues": [
                {
                  "role": "阿多尼斯",
                  "text": "光明藏于你我之中…"
                },
                {
                  "role": "阿多尼斯",
                  "text": "呼——我快都忘了，有多久没有听到这句话了。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "告诉我，好同志，谁派你来的？"
                },
                {
                  "role": "旅行者",
                  "text": "须婆达之彦。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "斯巴达克老师？！是老师吗？！"
                },
                {
                  "role": "阿多尼斯",
                  "text": "他在哪里？我只知道他在动乱里被太阳之子的党羽抓住了。之后就再也没有他的消息了。"
                },
                {
                  "role": "派蒙",
                  "text": "他被关在蛇心之地的祭坛…以他的状态恐怕出不来了，所以拜托我们来寻找你们。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "该死的太阳之子…"
                },
                {
                  "role": "阿多尼斯",
                  "text": "老师让你们来有什么吩咐吗？"
                },
                {
                  "role": "派蒙",
                  "text": "大叔只让我们传句话啦，他说——"
                },
                {
                  "role": "派蒙",
                  "text": "孩子们，永远不要放弃，白夜国的希望就在你们之中。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "……"
                },
                {
                  "role": "阿多尼斯",
                  "text": "……"
                },
                {
                  "role": "阿多尼斯",
                  "text": "对不起…对不起！老师，我们让您失望了！"
                },
                {
                  "role": "旅行者",
                  "text": "怎么了？"
                },
                {
                  "role": "阿多尼斯",
                  "text": "反抗军已经不存在了…"
                },
                {
                  "role": "派蒙",
                  "text": "欸——"
                },
                {
                  "role": "阿多尼斯",
                  "text": "老师被抓走之后，反抗军的骨干基本全军覆没。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "只剩我们这些平时跟随老师的学生，因为远离事件中央而逃过一劫。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "之后我们这些幸存者逃到了之前准备的藏身处里，希望能够重新聚集起力量。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "我们当中本来有杰出的谋士、有专业的学者、有优秀的术士，还有可靠的医生…"
                },
                {
                  "role": "派蒙",
                  "text": "听起来很有希望的啊…"
                },
                {
                  "role": "阿多尼斯",
                  "text": "我们也是这样想的，只要给我们时间，我们就能重新组织起有生力量。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "但这些需要资金…开展任何活动都要资金，我们什么都有，就是没有钱…"
                },
                {
                  "role": "阿多尼斯",
                  "text": "最后有人提出了建议——贩卖龙骨花凝珠。"
                },
                {
                  "role": "旅行者",
                  "text": "龙骨花凝珠是什么？"
                },
                {
                  "role": "阿多尼斯",
                  "text": "是龙骨花在特殊情况下结出的一种果实，十分罕见。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "它会产生一种让人神清气爽的香气，使焦虑归于平静，忧患一扫而空。所以在市场上价值很高。"
                },
                {
                  "role": "派蒙",
                  "text": "真的有这么神奇吗？不会是骗人的吧？"
                },
                {
                  "role": "阿多尼斯",
                  "text": "如果只是神奇就好了…愚钝的我，最初没有看清这里面的危机。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "我已经不记得配方是从哪里得到的了，只知道，这东西确实给我们带来了很多资金。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "一切都在往好的方向发展…可慢慢地，我发现我的一些战友们，居然开始回避冲突，拒绝战斗…"
                },
                {
                  "role": "阿多尼斯",
                  "text": "这些人越来越多，到了后面，甚至还向我请愿，要脱离我们的队伍，而我根本挽留不住…"
                },
                {
                  "role": "派蒙",
                  "text": "怎么会这样？是不是因为卖凝珠赚到太多钱了，就不想打仗了…"
                },
                {
                  "role": "阿多尼斯",
                  "text": "你说是金钱的腐蚀吗？不…我…我不知道。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "我只知道，当不甘压迫的人们变得满足，反抗就无法继续下去。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "崩塌从那时就开始了，而且无可挽回。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "我有时甚至在想，这东西的配方，会不会就是那些卑鄙的大人故意流传给我们的…"
                },
                {
                  "role": "阿多尼斯",
                  "text": "这东西的畅销，会不会也是那些卑鄙的大人一手捏造的假象？"
                },
                {
                  "role": "阿多尼斯",
                  "text": "唉，如果是老师，他会怎么处理这种局面呢，会不会在最开始就把一切扼杀？"
                },
                {
                  "role": "阿多尼斯",
                  "text": "对不起老师，我们没能成为希望…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "很遗憾听到这件事…",
                      "dialogues": []
                    },
                    {
                      "text": "你希望再去见一见你的老师吗？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "阿多尼斯",
                  "text": "我无颜面对我的老师…"
                },
                {
                  "role": "阿多尼斯",
                  "text": "但无论如何，还是感谢你们带来了老师的消息。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "我没有别的东西能够感谢你，如果不介意的话，请让我把龙骨花凝珠的秘密告诉你。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "生产它的特殊条件就是必须用常夜灵川——也就是忘川的水来浇灌龙骨花。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "也许你们可以拿去换点金钱，或者自己留着。"
                },
                {
                  "role": "阿多尼斯",
                  "text": "但不论如何，希望你们保护好自己向前的心。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆前往常夜灵川"
        },
        {
          "role": "派蒙",
          "text": "有空的话，我们去制作一些龙骨花凝珠看看吧？"
        },
        {
          "role": "派蒙",
          "text": "还没听说过这么神奇的东西呢。"
        },
        {
          "type": "subtitle",
          "text": "◆获取忘川之水"
        },
        {
          "role": "派蒙",
          "text": "这里就是他们说的常夜灵川了吧？"
        },
        {
          "role": "派蒙",
          "text": "接下来取一些忘川的水，待会浇灌在龙骨花上面。"
        },
        {
          "type": "subtitle",
          "text": "◆到达龙骨花顶部"
        },
        {
          "role": "派蒙",
          "text": "这个就是忘川之水吗…"
        },
        {
          "role": "派蒙",
          "text": "看起来平平无奇，怎么也不像有那种魔力…"
        },
        {
          "role": "派蒙",
          "text": "总之先拿去试试吧。"
        },
        {
          "type": "subtitle",
          "text": "◆用忘川之水浇灌龙骨花"
        },
        {
          "type": "subtitle",
          "text": "◆等待龙骨花凝结"
        },
        {
          "role": "派蒙",
          "text": "感觉已经有一些变化了，接下来只要耐心等待。"
        },
        {
          "role": "派蒙",
          "text": "我们过一段时间再来看看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆获取龙骨花凝珠"
        },
        {
          "role": "派蒙",
          "text": "龙骨花凝珠就是这个吗，看起来就很一般般嘛…"
        },
        {
          "role": "派蒙",
          "text": "怎么也不像说的那么神奇，感觉没什么用的样子，真的能卖钱吗？"
        },
        {
          "role": "派蒙",
          "text": "我们要不去各地的商店问问吧？他们比较有见识，像蒙德的荣光之风、璃月的希古居，还有稻妻的根付之源…"
        },
        {
          "role": "派蒙",
          "text": "希望能换点钱来买好吃的…"
        },
        {
          "type": "subtitle",
          "text": "后续贩卖对话，非任务必须"
        },
        {
          "type": "subtitle",
          "text": "与玛乔丽对话",
          "narration": true
        },
        {
          "role": "旅行者",
          "text": "我有宝物想要出售。"
        },
        {
          "role": "玛乔丽",
          "text": "出售宝物？真是令人意外。"
        },
        {
          "role": "玛乔丽",
          "text": "像您这样强大的冒险家，想要出售的东西一定很罕见吧？"
        },
        {
          "role": "玛乔丽",
          "text": "快请让我看看。"
        },
        {
          "type": "subtitle",
          "text": "将龙骨花凝珠的故事告诉了玛乔丽。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "玛乔丽",
          "text": "啊，这不是就像是吟游诗人的故事里说的忘忧果吗？"
        },
        {
          "role": "玛乔丽",
          "text": "居然真的有这种东西存在吗…原来它叫龙骨花凝珠。"
        },
        {
          "role": "玛乔丽",
          "text": "如果它的效果真的和您所说的一样，我愿意花80000摩拉加一些特色料理买下它。"
        },
        {
          "role": "玛乔丽",
          "text": "嗯…80000摩拉加上5个月亮派，您觉得怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你会拿它做什么？",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "嘻嘻，多么独特的宝物呀。"
                },
                {
                  "role": "玛乔丽",
                  "text": "童话一般的神奇功效，我相信那些炼金术士们不会吝惜自己的钱包。"
                }
              ]
            },
            {
              "text": "公道的价格，成交。",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "那我就收下这件宝物了，多谢惠顾。"
                },
                {
                  "role": "玛乔丽",
                  "text": "对了，通常来说，这种凝珠类的物品会在风中缓慢挥发。"
                },
                {
                  "role": "玛乔丽",
                  "text": "所以，最好将它覆上隔膜或者放进容器密封起来，这样成色会更好。"
                },
                {
                  "role": "玛乔丽",
                  "text": "这是一点附送您的小技巧，希望对您的冒险有帮助。"
                },
                {
                  "role": "玛乔丽",
                  "text": "如果今后您又找到了类似的宝物，别忘了，这儿有您忠实的买家。"
                }
              ]
            },
            {
              "text": "我再考虑一下。",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "哈哈，没问题，但是我相信我的价格是最合适的。"
                },
                {
                  "role": "玛乔丽",
                  "text": "如果您考虑好了，可以再来找我。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与御舆源一郎对话",
          "narration": true
        },
        {
          "role": "旅行者",
          "text": "我有宝物想要出售。"
        },
        {
          "role": "御舆源一郎",
          "text": "欸？其实小店已经有了固定的进货渠道，平时也没有收购散货的业务…"
        },
        {
          "role": "御舆源一郎",
          "text": "不过看你的样子…似乎是个了不起的东西？"
        },
        {
          "role": "御舆源一郎",
          "text": "既然如此…不如先给我看看吧？"
        },
        {
          "type": "subtitle",
          "text": "将龙骨花凝珠的故事告诉了御舆源一郎。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "御舆源一郎",
          "text": "唔…"
        },
        {
          "role": "御舆源一郎",
          "text": "坦白说…虽然这个故事很神奇…但是好像也稍微神奇过头了些…"
        },
        {
          "role": "御舆源一郎",
          "text": "这种东西，已经有些超出我的理解能力了。"
        },
        {
          "role": "御舆源一郎",
          "text": "请别见笑，毕竟我也只是会做些手工艺品的家伙…"
        },
        {
          "role": "御舆源一郎",
          "text": "这样吧，80000摩拉，最多再加5份刺身拼盘，这种料理可不便宜。"
        },
        {
          "role": "御舆源一郎",
          "text": "这个价格你接受的话，我就买下这件宝物。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你会拿它做什么？",
              "dialogues": [
                {
                  "role": "御舆源一郎",
                  "text": "我还说不清楚，得再仔细琢磨一下这个东西。"
                },
                {
                  "role": "御舆源一郎",
                  "text": "如果情况好的话，说不定可以加工成一种特别的根付，这样应该能多卖点价钱。"
                }
              ]
            },
            {
              "text": "公道的价格，成交。",
              "dialogues": [
                {
                  "role": "御舆源一郎",
                  "text": "那么这些摩拉请收好。我得去好好研究研究这个。"
                }
              ]
            },
            {
              "text": "我再考虑一下。",
              "dialogues": [
                {
                  "role": "御舆源一郎",
                  "text": "嗯…刚好我也可以再想想。"
                },
                {
                  "role": "御舆源一郎",
                  "text": "如果你考虑好了，可以再来找我。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与琳琅对话",
          "narration": true
        },
        {
          "role": "旅行者",
          "text": "我有宝物想要出售。"
        },
        {
          "role": "琳琅",
          "text": "您又找到了什么稀奇东西？请让我看看。"
        },
        {
          "type": "subtitle",
          "text": "将龙骨花凝珠的故事告诉了琳琅。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "琳琅",
          "text": "听您所说，这可是一件了不得的古物啊。"
        },
        {
          "role": "琳琅",
          "text": "只是我入手察看一番，并没有感觉到特别明显的异样，或许需要长期使用才行…"
        },
        {
          "role": "琳琅",
          "text": "依我之见，您所听来的神妙效用，可能有些夸大了，又或者…说不定只是失败者的托辞呢…"
        },
        {
          "role": "琳琅",
          "text": "哈哈，您不用在意，我只是随口一说，您听听便好。"
        },
        {
          "role": "琳琅",
          "text": "在我们古董行当里，这种事情倒十分常见。"
        },
        {
          "role": "琳琅",
          "text": "另外，您似乎没有对它密封保存，粗粗看去，它的表面似乎已经有了一些耗损。"
        },
        {
          "role": "琳琅",
          "text": "这样一来，价格又要小打一点折扣。"
        },
        {
          "role": "琳琅",
          "text": "您看，80000摩拉如何？除此之外，再加5份特色料理丰年有余。"
        },
        {
          "role": "琳琅",
          "text": "我相信这是一个不错的价格。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你会拿它做什么？",
              "dialogues": [
                {
                  "role": "琳琅",
                  "text": "其实跟它的功效相比，我倒觉得它背后的那段故事更有价值。"
                },
                {
                  "role": "琳琅",
                  "text": "我猜港里的说书人、戏班子，或者玉京台上的贵人们都会对它有兴趣。"
                },
                {
                  "role": "琳琅",
                  "text": "就算只摆在本店的柜台上展示，也能算上一件珍稀的古董了。"
                }
              ]
            },
            {
              "text": "公道的价格，成交。",
              "dialogues": [
                {
                  "role": "琳琅",
                  "text": "您可真爽快，这些摩拉请收好。"
                },
                {
                  "role": "琳琅",
                  "text": "往后要是还有类似的宝贝，敝店随时恭候您的光临。"
                }
              ]
            },
            {
              "text": "我再考虑一下。",
              "dialogues": [
                {
                  "role": "琳琅",
                  "text": "嗯，对于这种珍奇宝物，货比三家…啊不是，价比三家也是应该的。"
                },
                {
                  "role": "琳琅",
                  "text": "如果您考虑好了，可以再来找我。"
                }
              ]
            }
          ]
        }
      ],
