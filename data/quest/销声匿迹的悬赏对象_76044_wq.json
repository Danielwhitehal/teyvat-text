{
  "quest_id": 76044,
  "chapter_num": null,
  "chapter_title": "销声匿迹的悬赏对象",
  "type": "wq",
  "route": "The Vanishing Bounty Target",
  "stories": [
    {
      "story_id": 76044,
      "title": "销声匿迹的悬赏对象",
      "description": "「旗舰」的悬赏榜单上有一个目标在犯下许多骇人罪行后便销声匿迹，仿佛人间蒸发。而罪咎终须追索，罪责终须清偿。询问「旗舰」员工勒塞克，或许能得到更多信息。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往「秘闻馆」"
        },
        {
          "role": "雅珂达",
          "text": "「旗舰」的悬赏里有一条很棘手呢，几乎没什么线索。"
        },
        {
          "role": "雅珂达",
          "text": "前阵子还听说他在伦波岛北边伤人呢，现在却突然消失得无影无踪，一点消息也没有…"
        },
        {
          "role": "奈芙尔",
          "text": "「凡走过必留痕迹」，哪怕是抹除痕迹，也会留下新的印迹。"
        },
        {
          "role": "奈芙尔",
          "text": "再者，悬赏里没有明文写出，也不代表他们没有掌握任何信息。"
        },
        {
          "role": "雅珂达",
          "text": "说得也是，我去找勒塞克问问好了，凭我的资深身份，应该能问出些什么。"
        },
        {
          "role": "奈芙尔",
          "text": "那就交给你了。"
        },
        {
          "role": "雅珂达",
          "text": "嗯，放心吧，老板！"
        },
        {
          "role": "雅珂达",
          "text": "「旗舰」的悬赏啊…不知不觉就只剩最后一条了。"
        },
        {
          "role": "奈芙尔",
          "text": "听闻是多亏了旅行者的活跃，不过看来就算是他，对这最后一条悬赏也是束手无策。"
        },
        {
          "role": "雅珂达",
          "text": "毕竟实在没什么线索嘛——"
        },
        {
          "role": "雅珂达",
          "text": "啊，悬赏上没写，倒也不见得真的没有。"
        },
        {
          "role": "奈芙尔",
          "text": "看来你有头绪了？"
        },
        {
          "role": "雅珂达",
          "text": "我去找勒塞克问问好了，凭我的资深身份，应该能问出些什么。"
        },
        {
          "role": "奈芙尔",
          "text": "那就交给你了。"
        },
        {
          "role": "雅珂达",
          "text": "嗯，放心吧，老板！"
        },
        {
          "type": "subtitle",
          "text": "与「旗舰」员工勒塞克对话"
        },
        {
          "role": "勒塞克",
          "text": "悬赏目标的信息都在板上，问我也行，但赏金多少没有商量的余地。"
        },
        {
          "role": "雅珂达",
          "text": "关于悬赏目标…"
        },
        {
          "role": "勒塞克",
          "text": "板上有四个目标，但只有三个有线索。被人指控欺诈而悬赏的…"
        },
        {
          "role": "雅珂达",
          "text": "…停一下，停一下！敷衍那些新入行的宝藏猎人也就算了，对我也这样？你知道我要问的是哪个。"
        },
        {
          "role": "勒塞克",
          "text": "「秘闻馆」要插手吗？"
        },
        {
          "role": "雅珂达",
          "text": "那得看老板的意思。欸？怎么变成你问我了？"
        },
        {
          "role": "雅珂达",
          "text": "说起来，「裂颚」哈尔克到现在还是下落不明，难道不是因为你们给的线索写得太模糊了吗？你自己看看，连外貌特征都没有。"
        },
        {
          "role": "勒塞克",
          "text": "要是哪个宝藏猎人连这个都不知道，那肯定也不是哈尔克的对手，何必让他们浪费时间…浪费自己的性命。"
        },
        {
          "role": "雅珂达",
          "text": "好吧，那除了他下巴上那道骇人的疤痕，还有什么其他的特征？最好是其他人不知道的。"
        },
        {
          "role": "勒塞克",
          "text": "其他人不知道的…你是说身上的，比如说背上的印记之类？"
        },
        {
          "role": "雅珂达",
          "text": "对，就是这种，原来真有啊！不过你又是怎么知道的？"
        },
        {
          "role": "勒塞克",
          "text": "我不知道。有没有我也不知道。再说，就算真的有，你准备怎么查验？"
        },
        {
          "role": "雅珂达",
          "text": "这、这么说来也是…唉，真的就没什么独家消息？看在咱们这么熟的份上，就不能透露一点吗？"
        },
        {
          "role": "勒塞克",
          "text": "哈尔克在那夏镇暴露了本性之后逃窜去了伦波岛北部一带，在那里继续为非作歹。"
        },
        {
          "role": "雅珂达",
          "text": "这我都知道，之前多多少少听过。"
        },
        {
          "role": "雅珂达",
          "text": "但他最近不是没了消息吗？要是去了北边，皮拉米达城还好，但要是去了至冬堡…"
        },
        {
          "role": "雅珂达",
          "text": "（冰天雪地的，我这胳膊能受得了吗…）"
        },
        {
          "role": "勒塞克",
          "text": "不会，他还在伦波岛，只是不知道他在哪里藏身。这条是独家消息。"
        },
        {
          "role": "雅珂达",
          "text": "欸，这你又是怎么确定的？"
        },
        {
          "role": "勒塞克",
          "text": "那就是商业机密了，价钱是另算的。"
        },
        {
          "role": "雅珂达",
          "text": "嘁，小气。唉，一个下巴有疤的壮汉，哪怕只是在伦波岛上，走十步也能碰到一个吧，这要怎么找啊。"
        },
        {
          "role": "勒塞克",
          "text": "那就看在我们这么熟的份上，给你一个建议，别光盯着下巴上的疤痕。"
        },
        {
          "role": "雅珂达",
          "text": "…你是想说，他会设法把下巴上的疤痕遮住？"
        },
        {
          "role": "雅珂达",
          "text": "有道理…他会被称作「裂颚」就是因为那道标志性的伤疤，反过来说，如果没了这道疤痕，他就和其他壮汉没什么区别了。"
        },
        {
          "role": "雅珂达",
          "text": "这样一来，只要找刻意遮挡下巴的壮汉就好了。算是一条新线索，好吧，之后有进展了再来找你。"
        },
        {
          "role": "勒塞克",
          "text": "等你的好消息。"
        }
      ]
    }
  ]
}