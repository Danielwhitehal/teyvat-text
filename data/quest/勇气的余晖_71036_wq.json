{
  "quest_id": 71036,
  "chapter_num": null,
  "chapter_title": "勇气的余晖",
  "type": "wq",
  "route": "Valor's Afterglow",
  "stories": [
    {
      "story_id": 71036,
      "title": "勇气的余晖",
      "description": "虽然层岩之下的事件已经暂时平息，但是志琼似乎还在进行其他的勘测工作，去问问她的情况吧…",
      "dialogues": [
        {
          "role": "志琼",
          "text": "你好，旅行者前辈，最近过得怎样！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还好吧，你好些了吗？",
              "dialogues": [
                {
                  "role": "志琼",
                  "text": "谢谢关心，我已经没什么问题了。实在抱歉之前让大家费心。"
                }
              ]
            },
            {
              "text": "不怎么样，至少还活着。你呢？",
              "dialogues": [
                {
                  "role": "志琼",
                  "text": "我还好啦…唔，也不怎么样就是了，冒险的风头都让前辈你出尽了，哈哈。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼，志琼你就不要到处乱跑啦！免得又像上次一样…"
        },
        {
          "role": "志琼",
          "text": "不会的，不会的。多亏了前辈的努力，层岩巨渊已经安全了许多。地质特征也变得…唔，稳定了许多。"
        },
        {
          "role": "志琼",
          "text": "不过瑾武姐和海迪夫还需要进一步分析那块神秘晶体的…那个…"
        },
        {
          "role": "志琼",
          "text": "唔，波长？海迪夫是这么说的，大概又是须弥的奇怪术语吧…总之，首先需要安置信标才能取得数据。"
        },
        {
          "role": "志琼",
          "text": "瑾武姐最近终于腾出空来把信标组装齐全了，我需要把它们安置在几个特定地点来读取读数。"
        },
        {
          "role": "志琼",
          "text": "隔一段时间后再前去回收，回收的数据就可以留给海迪夫去运算了。"
        },
        {
          "role": "志琼",
          "text": "之前由于很多区域都不安全，我们只能局限在营地内进行读数测算…"
        },
        {
          "role": "志琼",
          "text": "但现在既然通路被前辈打开了，用信标进行实地测量也就能得到更准确的数据了。"
        },
        {
          "role": "志琼",
          "text": "呼…有点事情做还是比闲着好。对了，前辈如果没有其他事情的话也请跟我一起来吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那么，我们出发吧。",
              "dialogues": [
                {
                  "role": "志琼",
                  "text": "好的，那么我们出发！"
                }
              ]
            },
            {
              "text": "有我们什么好处吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你这也太直接了吧！虽然我也想知道就是啦…"
                },
                {
                  "role": "志琼",
                  "text": "哈哈，咱们这次只是简单的一趟来回而已，不过瑾武姐应该会感谢你的。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "放置测算用的信标"
        },
        {
          "type": "subtitle",
          "text": "巨柱岩宫高处"
        },
        {
          "role": "志琼",
          "text": "好了，就是这里了。在这里布下信标的话，应该能够监测黑泥的动向…"
        },
        {
          "type": "subtitle",
          "text": "荧光狭道"
        },
        {
          "role": "志琼",
          "text": "我已经通知大家小心不要靠近那些黑色的泥巴了，唔…信标安置点在这里，我们到了。"
        },
        {
          "type": "subtitle",
          "text": "西北遗迹附近"
        },
        {
          "role": "志琼",
          "text": "前辈，请把信标安放在这里吧。"
        },
        {
          "type": "subtitle",
          "text": "东南遗迹附近"
        },
        {
          "role": "志琼",
          "text": "我之前标出的位置应该是这里…是这里没错了。"
        },
        {
          "type": "subtitle",
          "text": "颠倒古城下方"
        },
        {
          "role": "志琼",
          "text": "在这里安置信标就可以了，希望在这里能够测得到读数。"
        },
        {
          "role": "志琼",
          "text": "还有四处地点需要放置信标。"
        },
        {
          "role": "志琼",
          "text": "好的，标记出来…接下来我们还有三处要跑。"
        },
        {
          "role": "志琼",
          "text": "三处布置完毕，还有两处了。我们继续吧，前辈？就像闲庭信步一样！"
        },
        {
          "role": "志琼",
          "text": "四处布置完毕！我们朝最后一处地点一鼓作气进发吧！"
        },
        {
          "role": "志琼",
          "text": "好了，圆满完成！我们回去交差吧？"
        },
        {
          "type": "subtitle",
          "text": "返回层岩巨渊的勘探队营地"
        },
        {
          "role": "志琼",
          "text": "这一趟辛苦前辈了，一点小心意请收下！"
        },
        {
          "role": "旅行者",
          "text": "太客气了。"
        },
        {
          "role": "志琼",
          "text": "呼…最近层岩巨渊似乎停止了地形上的异变，这也说明我只需要对已有的地图进行一点小小的增补就够了。"
        },
        {
          "role": "志琼",
          "text": "多谢了前辈的冒险，我们的工作也相对轻松了许多。"
        },
        {
          "role": "志琼",
          "text": "啊，我就不多留前辈啦。如果想要休息或者继续探险，就请自便吧！"
        },
        {
          "role": "志琼",
          "text": "呼…距离回收信标还有挺长时间的，如果下次冒险也能再叫上前辈就好了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "志琼",
          "text": "你好，前辈！请找个地方坐坐吧。"
        },
        {
          "role": "旅行者",
          "text": "关于冒险的事…"
        },
        {
          "role": "志琼",
          "text": "你是想问，为什么我之前那么倔强，让大家如此费心吗？哈哈…我知道错啦，请不要再教训我了…"
        },
        {
          "role": "志琼",
          "text": "不过话说回来，对「危险」的痴迷，或许是我们这些冒险家的本性吧。"
        },
        {
          "role": "志琼",
          "text": "毕竟我们生来拥有坚韧的脊梁，轻捷的四肢…一想到身怀利器却安于无风无浪的一生，就总觉得不甘心呀。"
        },
        {
          "role": "志琼",
          "text": "至于致命的风险，我也不是没有考虑过，但…嗯，我可以问你一个问题吗？"
        },
        {
          "role": "旅行者",
          "text": "请说吧。"
        },
        {
          "role": "志琼",
          "text": "蒙德的大冒险家斯坦利因他横穿烬寂海的壮举而闻名…他在这场冒险中失去了自己的挚友。"
        },
        {
          "role": "志琼",
          "text": "因为他的这场冒险，那位死去的挚友…尽管很少有人知道他的名字是什么，但关于他的记忆却在冒险家中间流传至今。"
        },
        {
          "role": "志琼",
          "text": "我在想…哈哈，请前辈不要笑我幼稚。斯坦利那位再不归来的友人…会不会并未逝去，而是正在真正地「活着」呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "唯有生命本身才最重要。",
              "dialogues": [
                {
                  "role": "志琼",
                  "text": "但为人所铭记这件事本身…即使事业令他早夭，不也是一种生命的延续吗？"
                },
                {
                  "role": "志琼",
                  "text": "就这样借助他人的憧憬与纪念，评价与凝视…以另一种方式活在众人中间。"
                }
              ]
            },
            {
              "text": "能被人记住，也是一种成功吧。",
              "dialogues": [
                {
                  "role": "志琼",
                  "text": "唔…我从没想过一场的「成功」人生啦。相反，即使「失败」，只要能让众人都留下印象就好。"
                },
                {
                  "role": "志琼",
                  "text": "至少有人会说：「志琼这个人，也是挑战过层岩巨渊的啊！」"
                },
                {
                  "role": "志琼",
                  "text": "至少不会像那些牺牲在无人之地的前辈一样…至少不会像现在的我一样，被人遗忘。"
                }
              ]
            },
            {
              "text": "从来没想过这种问题。",
              "dialogues": [
                {
                  "role": "志琼",
                  "text": "这样吗…？或许那是因为像前辈这样的外来人，无论在哪里出现都会自然而然地成为视线的焦点吧。"
                },
                {
                  "role": "志琼",
                  "text": "就像含着金汤匙出生的孩子，也只会把贫穷当成一场并非必须的刺激冒险一样。"
                },
                {
                  "role": "志琼",
                  "text": "啊，抱歉…我不是那个意思，我只是说…没什么。当我没有问吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "请不要太过在意别人的看法。"
        },
        {
          "role": "志琼",
          "text": "已经有很多人这样劝过我了，「做你自己就好」「管好自己的事情就行了」…表面上是开导人的话，终究只是劝人放弃。"
        },
        {
          "role": "志琼",
          "text": "其实我之前就说过了，我的冒险，不是为了别人…甚至不是为了自己。"
        },
        {
          "role": "志琼",
          "text": "嗯…你有这样想过吗，前辈…？"
        },
        {
          "role": "志琼",
          "text": "这个世界是由众神摆布的…但我们作为凡人，即使没有神灵恩赐的「眼」，也同样拥有不甘于安宁和遗忘的执着。"
        },
        {
          "role": "志琼",
          "text": "我相信这份不甘的心情并非毫无意义，所以才会不要命地跑去探索那些险地。毕竟呀…"
        },
        {
          "role": "志琼",
          "text": "以弱小之身与纵使神灵也为之恐惧的永恒角力，这才是人之所以为「人」的理由…我是这样相信的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但赋予冒险意义的不仅你自己一人。",
              "dialogues": [
                {
                  "role": "志琼",
                  "text": "唔…我明白的。我不会忘记大家的帮助，不会忘记给前辈带来的麻烦的…毕竟这场冒险并不仅是我一个人的事。"
                }
              ]
            },
            {
              "text": "就这么想要逞英雄吗？",
              "dialogues": [
                {
                  "role": "志琼",
                  "text": "比起前辈来，我差得可太远啦…比起想做英雄，唔…不如说是，「想活着的人才不怕会死于非命」吧。"
                },
                {
                  "role": "志琼",
                  "text": "这话是一个须弥的前辈告诉我的，她也是在「镀金旅团」听来的就是啦。」"
                },
                {
                  "role": "志琼",
                  "text": "我觉得很有道理…"
                },
                {
                  "role": "派蒙",
                  "text": "不如说是在一个劲地追求不吉利的倒霉事呢…这个人呀！"
                }
              ]
            }
          ]
        },
        {
          "role": "志琼",
          "text": "哈哈，这不就是冒险家嘛！"
        }
      ],
      "collapse_ranges": [
        [
          35,
          55
        ]
      ]
    }
  ]
}