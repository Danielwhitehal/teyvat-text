{
  "quest_id": 71163,
  "chapter_num": null,
  "chapter_title": "仙人赠礼",
  "type": "wq",
  "route": "Adeptus's Gift",
  "stories": [
    {
      "story_id": 71163,
      "title": "仙人赠礼",
      "description": "兹白为你准备了一件小礼物，会是什么呢？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "收到兹白的传音"
        },
        {
          "type": "subtitle",
          "text": "前往白驹逆旅"
        },
        {
          "role": "派蒙",
          "text": "兹白好像不在这里呢，不是她让我们过来的吗？跑哪里去了？"
        },
        {
          "role": "派蒙",
          "text": "欸！这把伞有点眼熟…好像在哪里见过？"
        },
        {
          "role": "旅行者",
          "text": "可能是兹白的东西。"
        },
        {
          "role": "派蒙",
          "text": "我也这么觉得…不过她怎么把伞丢在旅店门口了？"
        },
        {
          "role": "旅行者",
          "text": "她的记性不太好。"
        },
        {
          "role": "派蒙",
          "text": "这可怎么办，这样下去，总觉得有一天她会一边吃饭，一边忘记筷子丢哪了。"
        },
        {
          "role": "派蒙",
          "text": "唉，我们还是快找找她吧。"
        },
        {
          "role": "旅行者",
          "text": "等等…这好像不是伞。"
        },
        {
          "role": "派蒙",
          "text": "不是伞是什么？嗯…让我再仔细看看…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！"
        },
        {
          "type": "subtitle",
          "text": "与兹白交谈"
        },
        {
          "role": "派蒙",
          "text": "怎么回事？我们怎么来了这里！"
        },
        {
          "role": "兹白",
          "text": "怎么样？喜欢我给你们准备的小玩意吗？"
        },
        {
          "role": "派蒙",
          "text": "兹白，你在这里啊！这把伞是什么？「嗖」地一下就把我们搬到这里来了。"
        },
        {
          "role": "兹白",
          "text": "看来你们的记性也欠佳呢，这就忘了先前与我一同乘过吗？"
        },
        {
          "role": "兹白",
          "text": "现在想起来了吗？"
        },
        {
          "role": "派蒙",
          "text": "哦！是…是月宫的高车！难怪刚才就觉得眼熟…"
        },
        {
          "role": "兹白",
          "text": "呵呵，只是我依照记忆仿制的而已。"
        },
        {
          "role": "兹白",
          "text": "这还要多亏旅行者拿来的那枚玉节。"
        },
        {
          "role": "派蒙",
          "text": "噢~原来你之前说要做一个小玩意送给旅行者，就是这个呀。"
        },
        {
          "role": "兹白",
          "text": "不错，这玉节所制的高车可载着你们快速抵达目的地，应当能为旅途提供些许便利。"
        },
        {
          "role": "兹白",
          "text": "两位向导，请收好吧。"
        },
        {
          "role": "派蒙",
          "text": "好厉害…我还以为你只是说说而已呢，没想到这么快就做好了！"
        },
        {
          "role": "兹白",
          "text": "我原以为是要花上一些工夫，毕竟这玉节受损严重，灵气早已散尽。"
        },
        {
          "role": "兹白",
          "text": "但幸运的是，这里是沉玉谷。"
        },
        {
          "role": "派蒙",
          "text": "哦？沉玉谷怎么了？"
        },
        {
          "role": "兹白",
          "text": "你可知，我们现在所在沉玉谷何处？"
        },
        {
          "role": "派蒙",
          "text": "呃…遗珑埠？"
        },
        {
          "role": "兹白",
          "text": "呵呵，你还不够了解这里。"
        },
        {
          "role": "兹白",
          "text": "你我脚踏之地，其实是璃月地脉交汇的关键节点之一，如此节点，共有八处…"
        },
        {
          "role": "旅行者",
          "text": "生死休杜，开景惊伤。"
        },
        {
          "role": "兹白",
          "text": "你倒是比我想象中要更加熟悉此地。"
        },
        {
          "role": "派蒙",
          "text": "哦！我也想起来了，是地脉中的八门！"
        },
        {
          "role": "兹白",
          "text": "不错，这里就是其中的大吉门——生门的中央地带。"
        },
        {
          "role": "兹白",
          "text": "生门主生长繁荣，万物复苏，因此，我才能在短时间内补足玉节灵气，制出这架高车。"
        },
        {
          "role": "派蒙",
          "text": "哇，原来这么管用啊？看来沉玉谷真是个风水宝地啊…"
        },
        {
          "role": "兹白",
          "text": "嗯…这才该是你们安居乐业的地方…"
        },
        {
          "role": "派蒙",
          "text": "你们…？"
        },
        {
          "role": "兹白",
          "text": "没什么…"
        },
        {
          "role": "兹白",
          "text": "好啦，我也没有别的事了，去忙你们的吧。"
        },
        {
          "role": "兹白",
          "text": "我打算在这山上再走一走，就在这里别过吧。"
        },
        {
          "role": "旅行者",
          "text": "谢谢兹白。"
        },
        {
          "role": "兹白",
          "text": "不必客气。你唤醒了我，是我欠你的。"
        },
        {
          "role": "旅行者",
          "text": "主要是钟离的功劳。"
        },
        {
          "role": "兹白",
          "text": "同样的话，我也对他说过。"
        },
        {
          "role": "兹白",
          "text": "从他那我还得知，你正行进在一条漫长的旅途中…"
        },
        {
          "role": "兹白",
          "text": "你的下一站，是那遥远的雪国吗？"
        },
        {
          "role": "旅行者",
          "text": "是的，那里是至冬。"
        },
        {
          "role": "兹白",
          "text": "至冬…虽然我不清楚那是个什么样的国度，但冰天雪地的路途，想必不能畅通无阻。"
        },
        {
          "role": "兹白",
          "text": "旅行者，往后若是需要助力，你知道在哪里可以找到我。"
        },
        {
          "role": "旅行者",
          "text": "我会的。"
        },
        {
          "role": "兹白",
          "text": "嗯，保重。"
        }
      ]
    }
  ]
}