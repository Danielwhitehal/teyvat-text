  "chapter_title": "小小人儿，快长大",
  "type": "iq",
  "route": "Grow Up Quickly, Littl'Un",
  "stories": [
    {
      "story_id": 25030,
      "title": "小小人儿，快长大",
      "description": "在「回声之子」部族中，考古学家塔莫蕾和她的助手阿基约似乎遇见了一些麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "听听阿蕾梅的话"
        },
        {
          "role": "阿蕾梅",
          "text": "塔莫蕾姐姐！我也想做考古学家！"
        },
        {
          "role": "塔莫蕾",
          "text": "小阿蕾梅，考古学家可不是只用到处挖石头就行，要学习很多东西的喔。"
        },
        {
          "role": "阿蕾梅",
          "text": "可是，考古学家可以和小龙一起玩！妈妈都不让我去找自己的龙！"
        },
        {
          "role": "阿基约",
          "text": "阿蕾梅，你妈妈不是说过了吗？这件事要等你长大之后再说。"
        },
        {
          "role": "阿蕾梅",
          "text": "我就在长大呀！塔莫蕾姐姐都说了，只有头脑的成长，才算是真正的成长。"
        },
        {
          "role": "阿蕾梅",
          "text": "我找塔莫蕾姐姐学习知识，就是要快快长大。这是塔莫蕾姐姐亲口告诉我的！"
        },
        {
          "role": "塔莫蕾",
          "text": "这确实…是我说的。哈哈哈…你这孩子还挺聪明的…"
        },
        {
          "role": "阿基约",
          "text": "塔莫蕾小姐，这可怎么办…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们在做什么呢？",
              "dialogues": []
            },
            {
              "text": "我也想要成为考古学家！",
              "dialogues": [
                {
                  "role": "阿基约",
                  "text": "这位朋友，你已经不用长大了。你看起来够成熟了。"
                }
              ]
            }
          ]
        },
        {
          "role": "塔莫蕾",
          "text": "我们…咳，阿蕾梅，这确实是我亲口说的，而且姐姐也没有骗你。"
        },
        {
          "role": "塔莫蕾",
          "text": "但在你正式学习考古学家相关的课程之前，还要接受…那个…课前…课前培训。"
        },
        {
          "role": "塔莫蕾",
          "text": "这位大哥哥，就是我专门请来为你培训的…课程导师！"
        },
        {
          "role": "旅行者",
          "text": "我是旅行者。"
        },
        {
          "role": "阿蕾梅",
          "text": "好欸！"
        },
        {
          "role": "塔莫蕾",
          "text": "…抱歉。总之拜托你先配合我一下，拜托拜托，我会给你准备好报酬的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我可是很严厉的。",
              "dialogues": [
                {
                  "role": "阿蕾梅",
                  "text": "我不怕！我们「回声之子」都超坚强的！"
                }
              ]
            },
            {
              "text": "叫一声老师听听。",
              "dialogues": [
                {
                  "role": "阿蕾梅",
                  "text": "大哥哥老师好！"
                }
              ]
            }
          ]
        },
        {
          "role": "塔莫蕾",
          "text": "好，那咱们就先开始熟悉一下课程吧…阿基约，你先来介绍一下课程吧。"
        },
        {
          "role": "阿基约",
          "text": "我，我来介绍？那个…阿蕾梅，你应该知道，部族里那些勇猛的战士们，都接受过有关「观察力」和「耐久力」的训练吧。"
        },
        {
          "role": "阿基约",
          "text": "作为一名要时常涉足险地的考古学家，你也要具备这样的素质。"
        },
        {
          "role": "阿蕾梅",
          "text": "我会努力的！"
        },
        {
          "role": "阿基约",
          "text": "那么，就请你的课程导师判断一下，先进行什么课程的训练吧。"
        },
        {
          "role": "旅行者",
          "text": "先训练一下「观察力」。"
        },
        {
          "role": "阿基约",
          "text": "没问题。那我们现在就出发去训练场地吧。"
        },
        {
          "role": "旅行者",
          "text": "…真有训练场地？"
        },
        {
          "role": "阿基约",
          "text": "…咳，你小声点，这可是我好不容易找到的地方。那个场地本来是我们部族用来训练的，这段时间正在维修。"
        },
        {
          "role": "阿基约",
          "text": "虽然有些机关失去了作用…有些机关拆了一半…但那个场地作为训练场来说，绝对足够了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真佩服你们的应变能力…",
              "dialogues": []
            },
            {
              "text": "真亏你能想到这个主意…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿基约",
          "text": "抱歉，抱歉…唉，这也是没办法的事啊。我好不容易才找到了这么一个相对安全的场地，但以我的实力，又没法做出漂亮的示范说服阿蕾梅…"
        },
        {
          "role": "阿基约",
          "text": "我们就只能指望你了，旅行者！就算是为了阿蕾梅，也请你帮帮忙。"
        },
        {
          "role": "阿基约",
          "text": "要是不给这孩子一个准话，让她有点事情做，她说不定会一个人跑去部族外瞎鼓捣…"
        },
        {
          "role": "旅行者",
          "text": "行吧…"
        },
        {
          "role": "阿基约",
          "text": "谢谢你，呼…我总算是安心点了…"
        },
        {
          "role": "塔莫蕾",
          "text": "好了！咱们快点出发吧。阿蕾梅，你等会可要好好看着大哥哥的动作喔。"
        },
        {
          "role": "阿蕾梅",
          "text": "我知道了！"
        },
        {
          "role": "阿基约",
          "text": "…唉，居然对这么一个孩子撒谎。大灵可别怪罪我，我也是没办法啊…"
        },
        {
          "role": "旅行者",
          "text": "先训练一下「耐久力」。"
        },
        {
          "role": "阿基约",
          "text": "没问题。那我们现在就出发去训练场地吧。"
        },
        {
          "role": "旅行者",
          "text": "…真有训练场地？"
        },
        {
          "role": "阿基约",
          "text": "…咳，你小声点，这可是我好不容易找到的地方。那个场地本来是我们部族用来训练的，这段时间正在维修。"
        },
        {
          "role": "阿基约",
          "text": "虽然有些机关失去了作用…有些机关拆了一半…但那个场地作为训练场来说，绝对足够了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真佩服你们的应变能力…",
              "dialogues": []
            },
            {
              "text": "真亏你能想到这个主意…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿基约",
          "text": "抱歉，抱歉…唉，这也是没办法的事啊。我好不容易才找到了这么一个相对安全的场地，但以我的实力，又没法做出漂亮的示范说服阿蕾梅…"
        },
        {
          "role": "阿基约",
          "text": "我们就只能指望你了，旅行者！就算是为了阿蕾梅，也请你帮帮忙。"
        },
        {
          "role": "阿基约",
          "text": "要是不给这孩子一个准话，让她有点事情做，她说不定会一个人跑去部族外瞎鼓捣…"
