        },
        {
          "role": "阿基约",
          "text": "…唉，居然对这么一个孩子撒谎。大灵可别怪罪我，我也是没办法啊…"
        },
        {
          "role": "旅行者",
          "text": "今天训练一下「观察力」吧。"
        },
        {
          "role": "阿蕾梅",
          "text": "我准备好啦！"
        },
        {
          "role": "阿基约",
          "text": "状态很好嘛，阿蕾梅。那咱们现在就去训练场地吧。"
        },
        {
          "role": "旅行者",
          "text": "今天训练一下「耐久力」吧。"
        },
        {
          "role": "阿蕾梅",
          "text": "我准备好啦！"
        },
        {
          "role": "阿基约",
          "text": "状态很好嘛，阿蕾梅。那咱们现在就去训练场地吧。"
        },
        {
          "type": "subtitle",
          "text": "为阿蕾梅示范「观察力」训练"
        },
        {
          "role": "阿基约",
          "text": "咳。咱们到了，这里是「观察力」训练场。"
        },
        {
          "role": "阿基约",
          "text": "虽然看起来很平坦，但是地底下实际上埋藏着不少爆炸机关。"
        },
        {
          "role": "阿基约",
          "text": "如果不经判断贸然前进，说不定就会踩爆机关，整个人都被掀倒在地。"
        },
        {
          "role": "阿基约",
          "text": "一般来说，我们「回声之子」都会借助嵴锋龙伙伴的帮助，避开干扰机关，找到并挖掘出埋藏着的目标机关。"
        },
        {
          "role": "阿基约",
          "text": "但是，作为一名考古学家，我们必须要考虑各种极端情况。"
        },
        {
          "role": "阿基约",
          "text": "所以…在这次训练中，你只能依靠自己的观察力找到，并挖掘出埋藏着的目标机关。"
        },
        {
          "role": "阿基约",
          "text": "接下来！就请旅行者示范一下，如何以正确的方式挖掘出那些机关吧！"
        },
        {
          "role": "阿基约",
          "text": "和上次一样，这里的场地底下埋藏着不少机关。"
        },
        {
          "role": "阿基约",
          "text": "考虑到阿蕾梅的实力已经很强了，所以…我稍微增加了一些难度，埋藏了更多的机关。"
        },
        {
          "role": "旅行者",
          "text": "…你埋了新的机关？"
        },
        {
          "role": "阿基约",
          "text": "…嘘，嘘！是上次的爆炸机关还没拆完啊…"
        },
        {
          "role": "阿基约",
          "text": "总之，旅行者，示范就交给你了。我相信那些机关肯定难不倒你。"
        },
        {
          "type": "subtitle",
          "text": "挖掘出埋藏着的目标机关"
        },
        {
          "role": "阿蕾梅",
          "text": "塔莫蕾姐姐，你们考古学家，真的要学这么辛苦的课程吗？"
        },
        {
          "role": "塔莫蕾",
          "text": "那是当然啦。这都不算什么，等你真正开始学习，才知道什么是真正辛苦的课程…"
        },
        {
          "role": "阿蕾梅",
          "text": "喔…"
        },
        {
          "type": "subtitle",
          "text": "向阿基约回报"
        },
        {
          "role": "塔莫蕾",
          "text": "你的身手真不错啊…这么快就把埋着的那些机关挖出来了，而且…衣服看起来也很整洁，应该也没被爆炸机关掀翻多少次。"
        },
        {
          "role": "塔莫蕾",
          "text": "谢天谢地，我们真是运气好，居然能遇见你这么厉害的人…"
        },
        {
          "role": "阿蕾梅",
          "text": "好厉害！我也要试试，阿基约哥哥，也让我试试！"
        },
        {
          "role": "阿基约",
          "text": "别急啊阿蕾梅，场地需要重新布置一下。等布置好了之后，我会陪着你一步步熟悉课程的。"
        },
        {
          "role": "阿基约",
          "text": "但是，在布置好场地之前，你可要乖乖地留在塔莫蕾姐姐旁边，不能乱跑。"
        },
        {
          "role": "阿蕾梅",
          "text": "我知道啦。我很听话的，绝对不乱跑。"
        },
        {
          "role": "塔莫蕾",
          "text": "阿蕾梅真乖，来姐姐这边，姐姐给你先念一段和考古有关的文章，你可要听好了喔…"
        },
        {
          "role": "阿基约",
          "text": "呼…感谢你的协助，旅行者。要是没你帮忙，我们都不知道怎么办了…"
        },
        {
          "role": "旅行者",
          "text": "你自己做示范就行了。"
        },
        {
          "role": "阿基约",
          "text": "我？唉，你就别开玩笑了。要是我没能挖出来那些宝贝，只怕连塔莫蕾小姐的安全都没法保护好。"
        },
        {
          "role": "阿基约",
          "text": "也不知道塔莫蕾小姐准备什么时候再次开展考古…不对不对，要是考古完成，她就要回须弥了，这样的话…"
        },
        {
          "role": "阿基约",
          "text": "咳！我，我什么也没说啊。这些报酬是给你的，快收下快收下，别和我们客气。"
        },
        {
          "role": "阿基约",
          "text": "好了，我得去布置场地了。呃…这次埋什么好呢？不然，埋点颗粒果好了…"
        },
        {
          "role": "阿蕾梅",
          "text": "我准备好了，阿基约哥哥！"
        },
        {
          "role": "阿基约",
          "text": "你这丫头，还催起我来了…我马上就去调整场地，你别着急啊。"
        },
        {
          "role": "塔莫蕾",
          "text": "你的身手还是那么高超啊…这么快就把埋着的那些机关挖出来了。"
        },
        {
          "role": "塔莫蕾",
          "text": "也许，就是因为有你这样厉害的榜样做示范，阿蕾梅才会这么有劲头训练吧。"
        },
        {
          "role": "塔莫蕾",
          "text": "…看阿蕾梅这孩子的劲头。我也在想，也许她真的能做一个优秀的考古学家。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不是都整理好资料了？",
              "dialogues": [
                {
                  "role": "塔莫蕾",
                  "text": "那些啊。只是我的一些笔记和心得，还有一些乱七八糟的故事而已。"
                },
                {
                  "role": "塔莫蕾",
                  "text": "我真没想到，阿蕾梅这孩子能看得下去。"
                }
              ]
            },
            {
              "text": "你要认真培养她吗？",
              "dialogues": [
                {
                  "role": "塔莫蕾",
                  "text": "「培养」这个词也太重了。就凭我的资质，最多给阿蕾梅做一个考古学启蒙。"
                },
                {
                  "role": "塔莫蕾",
                  "text": "要是再往深了教，我肯定会误人子弟…"
                }
              ]
            }
          ]
        },
        {
          "role": "塔莫蕾",
          "text": "好了，这些报酬给你，请收下吧。等会我还要给阿蕾梅整理新一批资料。"
        },
        {
          "role": "塔莫蕾",
          "text": "在我离开纳塔前，会把一切能教的知识都教给阿蕾梅。"
        },
        {
          "role": "塔莫蕾",
          "text": "呵呵…希望未来的纳塔，真的会出现一颗考古学界的新星。"
        },
        {
          "type": "subtitle",
          "text": "为阿蕾梅示范「观察力」训练"
        },
        {
          "role": "阿基约",
          "text": "大灵原谅，大灵原谅，我们也不是出于恶意…那些机关顶多是把人掀翻，绝对不会让人受到大伤…大灵原谅，大灵原谅…"
        },
        {
          "type": "subtitle",
          "text": "挖掘出埋藏着的目标机关"
        },
        {
          "role": "阿蕾梅",
          "text": "塔莫蕾姐姐，我训练得怎么样？可以做考古学家了吗？"
        },
        {
          "role": "塔莫蕾",
          "text": "嗯，阿蕾梅训练得很好，只要再巩固一下，姐姐就可以开始教你正式的课程的。"
        },
        {
          "role": "阿基约",
          "text": "你的塔莫蕾姐姐可是专门为你整理了一遍资料，等训练结束后，要好好学习喔。"
        },
        {
          "role": "塔莫蕾",
          "text": "旅行者，你来得正好。阿蕾梅，准备和大哥哥去训练吧。"
        },
        {
          "type": "subtitle",
          "text": "向阿基约回报"
        },
        {
          "type": "subtitle",
          "text": "为阿蕾梅示范「耐久力」训练"
        },
        {
          "role": "阿基约",
          "text": "咳。咱们到了，这里是「耐久力」的训练场。"
        },
        {
          "role": "阿基约",
          "text": "呃…这个场地还是咱们部族请「悬木人」那边的人过来，专门改造了一番。"
        },
        {
          "role": "阿基约",
          "text": "简单来说，在这场训练中，无论你用什么方法，只要以尽可能快的速度到达终点就好！"
        },
        {
          "role": "阿基约",
          "text": "接下来！就请旅行者示范一下，如何快速到达终点吧。"
        },
        {
          "role": "阿基约",
          "text": "咱们到了，这里是「耐久力」的训练场。"
        },
        {
          "role": "阿基约",
          "text": "和上次一样，无论你用什么方法，只要以尽可能快的速度到达终点就好！"
        },
        {
          "role": "阿基约",
          "text": "旅行者，示范就交给你了。让我们看看你的实力吧。"
        },
        {
          "type": "subtitle",
          "text": "迅速抵达目标点"
        },
        {
          "type": "subtitle",
          "text": "向塔莫蕾回报"
        },
        {
          "role": "？？？",
          "text": "过了一会，塔莫蕾三人才从旁边的小路钻了出来…"
        },
        {
          "role": "阿基约",
          "text": "你跑得也太快了，我们抄小路都没追上你。"
        },
        {
          "role": "塔莫蕾",
          "text": "谢天谢地，我们真是运气好，居然能遇见你这么厉害的人…"
        },
        {
          "role": "阿蕾梅",
          "text": "我看明白了，可以开始跑了吗？我已经准备好了！"
        },
        {
          "role": "塔莫蕾",
          "text": "等一下阿蕾梅，不要着急。等一下阿基约哥哥还要调整一下场地里的设施。让这个场地…更加适合你发挥。"
        },
        {
          "role": "阿基约",
          "text": "在那之前，你就先在姐姐旁边，千万不要到处乱跑，也不要抢跑喔。"
        },
        {
          "role": "阿蕾梅",
          "text": "我知道啦。我很听话的，绝对不抢跑。"
        },
        {
          "role": "塔莫蕾",
          "text": "阿蕾梅真乖，来姐姐这边，姐姐给你把衣服整理一下，免得你跑到一半被衣服绊倒…"
        },
        {
          "role": "阿基约",
          "text": "呼…感谢你的协助，旅行者。要是没你帮忙，我们都不知道怎么办了…"
        },
        {
          "role": "旅行者",
          "text": "你自己做示范就行了。"
        },
        {
          "role": "阿基约",
          "text": "我？你就别开玩笑了。没了我的龙伙伴，就凭我的腿脚可跑不了多快。"
        },
        {
          "role": "阿基约",
          "text": "唉，要是能再挖到点宝贝就好了。也不知道塔莫蕾小姐准备什么时候再次开展考古…"
        },
        {
          "role": "阿基约",
          "text": "不对不对，要是考古完成，她就要回须弥了。这样的话…"
        },
        {
          "role": "阿基约",
          "text": "咳！我，我什么也没说啊。这些报酬是给你的，快收下快收下，别和我们客气。"
        },
        {
          "role": "阿基约",
          "text": "好了，我得去布置场地了。呃…这次布什么好呢？"
        },
        {
          "role": "？？？",
          "text": "过了一会，塔莫蕾三人才从旁边的小路钻了出来…"
        },
        {
          "role": "阿蕾梅",
          "text": "我觉得…可以直接跑，不用调整场地了，阿基约哥哥。"
        },
        {
          "role": "阿基约",
          "text": "哎哟，你这丫头。别着急啊，路上那些枯枝石头都得收拾一下，你等一下被绊倒了怎么办？"
        },
        {
          "role": "塔莫蕾",
          "text": "你的速度可真快，我看…无论怎么抄小路，我们都追不上你了。"
        },
        {
          "role": "塔莫蕾",
          "text": "也许，就是因为有你这样厉害的榜样做示范，阿蕾梅才会这么有劲头训练吧。"
        },
        {
          "role": "塔莫蕾",
          "text": "…看阿蕾梅这孩子的劲头。我也在想，也许她真的能做一个优秀的考古学家。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不是都整理好资料了？",
              "dialogues": [
                {
                  "role": "塔莫蕾",
                  "text": "那些啊。只是我的一些笔记和心得，还有一些乱七八糟的故事而已。"
                },
                {
                  "role": "塔莫蕾",
                  "text": "我真没想到，阿蕾梅这孩子能看得下去。"
                }
              ]
            },
            {
              "text": "你要认真培养她吗？",
              "dialogues": [
                {
                  "role": "塔莫蕾",
                  "text": "「培养」这个词也太重了。就凭我的资质，最多给阿蕾梅做一个考古学启蒙。"
                },
                {
                  "role": "塔莫蕾",
                  "text": "要是再往深了教，我肯定会误人子弟…"
                }
              ]
            }
          ]
        },
        {
          "role": "塔莫蕾",
          "text": "好了，这些报酬给你，请收下吧。等会我还要给阿蕾梅整理新一批资料。"
        },
        {
          "role": "塔莫蕾",
          "text": "在我离开纳塔前，会把一切能教的知识都教给阿蕾梅。"
        },
        {
          "role": "塔莫蕾",
          "text": "呵呵…希望未来的纳塔，真的会出现一颗考古学界的新星。"
        }
      ]
    }
  ]
}