{
  "quest_id": 76183,
  "chapter_num": null,
  "chapter_title": "火与冰",
  "type": "wq",
  "route": "Fire and Ice",
  "stories": [
    {
      "story_id": 76183,
      "title": "火与冰",
      "description": "前往月矩力实验设计局高处放置茶桌并使用桑多涅落座后，与阿蕾奇诺共度茶会时光吧…",
      "dialogues": [
        {
          "role": "「仆人」",
          "text": "感谢你的邀请，桑多涅。茶点也依旧是熟悉的味道，令人怀念。"
        },
        {
          "role": "「木偶」",
          "text": "别客气。喜欢的话，在至冬我们也像以前一样多聚聚。"
        },
        {
          "role": "「仆人」",
          "text": "那是自然。"
        },
        {
          "role": "「木偶」",
          "text": "说到至冬，你那边一切都还顺利吗？"
        },
        {
          "role": "「仆人」",
          "text": "嗯，女皇陛下的谋划有了初步进展，但「严冬计划」的执行比市长大人想象中要困难得多。"
        },
        {
          "role": "「木偶」",
          "text": "这么说你我之后都要忙起来了。"
        },
        {
          "role": "「仆人」",
          "text": "但偶尔出来喝杯茶，或是去科洛列夫茨基剧团看场表演的时间或许还是有的。"
        },
        {
          "role": "「仆人」",
          "text": "嗯，偶尔出来喝杯茶，或是去科洛列夫茨基剧团看场表演的时间或许还是有的。"
        },
        {
          "role": "「木偶」",
          "text": "奥黛塔还在跳芭蕾吗？"
        },
        {
          "role": "「仆人」",
          "text": "嗯，一段时间不见，她的技术就又有精进了。"
        },
        {
          "role": "「木偶」",
          "text": "真好啊，等回去了我也想去看一场。"
        },
        {
          "role": "「木偶」",
          "text": "有时候看她会觉得很奇妙。明明是罗莎琳教出来的，但性格作风却和罗莎琳完全不一样。"
        },
        {
          "role": "「仆人」",
          "text": "这也不一定就是坏事。"
        },
        {
          "role": "「木偶」",
          "text": "嗯…如果说罗莎琳让人感觉像热烈的火，那奥黛塔就像坚实的冰。看不透的那种冰。"
        },
        {
          "role": "「仆人」",
          "text": "她似乎背负了很多东西。"
        },
        {
          "role": "「木偶」",
          "text": "是啊，但她在台上表演时，舞步又是如此纯净，仿佛心中没有一丝杂质。"
        },
        {
          "role": "「仆人」",
          "text": "或是将它们封到了人们看不见的地方。"
        },
        {
          "role": "「木偶」",
          "text": "嗯。说到底还是像冰，但一点也不脆弱。坚实的冰。硬要说还是很危险那种。"
        },
        {
          "role": "「仆人」",
          "text": "这点又和罗莎琳挺像。"
        },
        {
          "role": "「木偶」",
          "text": "危险的方面？"
        },
        {
          "role": "「仆人」",
          "text": "坚定的方面。"
        },
        {
          "role": "「木偶」",
          "text": "也对。难怪说她是目前最有希望继承「女士」这一头衔的愚人众。"
        },
        {
          "role": "「木偶」",
          "text": "哈…若是未来和她关系再近一些，就邀请她来参加我们的茶会吧。希望她不会拒绝。"
        },
        {
          "role": "「仆人」",
          "text": "但愿如此吧。"
        },
        {
          "role": "「仆人」",
          "text": "这样偶尔的放松很有必要。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "「仆人」",
          "text": "好，我们至冬见。"
        }
      ]
    }
  ]
}