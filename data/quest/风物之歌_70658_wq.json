{
  "quest_id": 70658,
  "chapter_num": null,
  "chapter_title": "风物之歌",
  "type": "wq",
  "route": "Ballads of Breeze",
  "stories": [
    {
      "story_id": 70658,
      "title": "风物之歌",
      "description": "风花节期间，蒙德城周围举办了各种各样的趣味活动。西风骑士团的莉兹想要隆重为你介绍其中之一，「风物之歌」。",
      "dialogues": [
        {
          "role": "莉兹",
          "text": "你好，有尽情享受风花节吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "多谢你的推荐。",
            "还没有时间…"
          ]
        },
        {
          "role": "旅行者",
          "text": "多谢你的推荐。"
        },
        {
          "role": "莉兹",
          "text": "嘿嘿，那我这里还有一项很轻松的活动，它的名字叫「风物之歌」。"
        },
        {
          "role": "莉兹",
          "text": "想必你在蒙德城见过了吟游诗人吧，参加这次的活动，你就能像他们一样演奏出好听的曲子！"
        },
        {
          "role": "莉兹",
          "text": "高山上，湖水边，感受着风的气息，全神贯注地演奏一曲，一定能让你把烦心事都忘光。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "没有这方面的经验…",
            "真的会好听吗？"
          ]
        },
        {
          "role": "旅行者",
          "text": "没有这方面的经验…"
        },
        {
          "role": "莉兹",
          "text": "不用担心，这个活动就是为了让没有演奏经验的人也能享受到音乐的乐趣。"
        },
        {
          "role": "莉兹",
          "text": "只要跟上提示，跟上节拍，接下来的都不是什么问题。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那我放心了。",
            "我这就去试试看。"
          ]
        },
        {
          "role": "旅行者",
          "text": "那我放心了。"
        },
        {
          "role": "莉兹",
          "text": "嗯嗯，祝你能度过一个快快乐乐的风花节！"
        }
      ]
    }
  ]
}