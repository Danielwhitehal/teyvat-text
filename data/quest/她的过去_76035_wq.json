{
  "quest_id": 76035,
  "chapter_num": null,
  "chapter_title": "她的过去",
  "type": "wq",
  "route": "Her Past",
  "stories": [
    {
      "story_id": 76035,
      "title": "她的过去",
      "description": "在「银月之庭」，「少女」似乎有些有趣的话题想要分享…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "（哥伦比娅…不在吗？）"
        },
        {
          "role": "「少女」",
          "text": "在找我？"
        },
        {
          "role": "派蒙",
          "text": "呜哇！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "吓我一跳…",
              "dialogues": []
            },
            {
              "text": "为什么要从背后出现…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "感觉到你来了，就想试试能不能从背后接近你。"
        },
        {
          "role": "派蒙",
          "text": "你好像很闲欸…"
        },
        {
          "role": "「少女」",
          "text": "唔…有吗？和以前也差不多吧。在「愚人众」的时候也没什么特别要干的。"
        },
        {
          "role": "「少女」",
          "text": "女皇需要的只是「月神」的力量，没派我出去抢过「神之心」什么的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你平时会做什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "散散步、看看月亮，偶尔唱唱歌，但后来桑多涅不让我唱，我就唱得少了。"
        },
        {
          "role": "派蒙",
          "text": "咦？她不喜欢吗？"
        },
        {
          "role": "「少女」",
          "text": "不是的。她说我唱得很好听，但那时我加入「愚人众」不久，她说其他人听到我唱歌有时会紧张。"
        },
        {
          "role": "「少女」",
          "text": "说在不知道的人看来，我就像要…使用什么能力一样。"
        },
        {
          "role": "派蒙",
          "text": "原来如此…我大概能理解。"
        },
        {
          "role": "「少女」",
          "text": "啊，还有一个原因。她说自己晚上基本都在搞研究，白天我唱歌会碰上她补觉的时间。"
        },
        {
          "role": "旅行者",
          "text": "（这才是主要原因吧！）"
        },
        {
          "role": "「少女」",
          "text": "所以，后来我就只在晚上到桑多涅门口去唱歌。但还是被她赶走了…"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你和其他人相处得好吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "「相处」吗…唔…刚认识的时候，阿蕾奇诺似乎很想和我「相处」。"
        },
        {
          "role": "「少女」",
          "text": "她总是悄悄出现在我后面，就像刚才那样。说是想…「试探」一下？"
        },
        {
          "role": "「少女」",
          "text": "我也试着和她玩一样的游戏，但她总在我还离很远的时候就转过头来。"
        },
        {
          "role": "「少女」",
          "text": "直到有次我不得不利用「月亮」的力量，才总算突然到她身后吓了她一跳。但那之后她就不和我玩这游戏了。"
        },
        {
          "role": "派蒙",
          "text": "（「仆人」恐怕一开始就没想过这是「游戏」吧…）"
        },
        {
          "role": "「少女」",
          "text": "「博士」也经常叫我去配合他做一些有关「光界力」的研究。"
        },
        {
          "role": "「少女」",
          "text": "我去过几次，但不是用月矩力打打这个，就是用月矩力操纵那个。很无聊，后来就没去了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看来你今天心情不错…",
              "dialogues": []
            },
            {
              "text": "聊了很多以前的话题…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "嗯，虽说是「离家出走」，但过去也有些愉快的回忆。"
        },
        {
          "role": "「少女」",
          "text": "阿蕾奇诺和桑多涅对我都不错，还有…"
        },
        {
          "role": "「少女」",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "（她的表情…是想起了谁…）"
        },
        {
          "role": "「少女」",
          "text": "把手给我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…欸？",
              "dialogues": []
            },
            {
              "text": "…为什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "我想起罗莎琳教过我…要记得对别人表示感谢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这没什么…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "谢谢你今天来听我说这些。"
        },
        {
          "role": "旅行者",
          "text": "（这是…月神的赐福？）"
        },
        {
          "role": "「少女」",
          "text": "今天就聊到这里吧。"
        },
        {
          "role": "派蒙",
          "text": "结束得好突然！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嘘…派蒙…",
              "dialogues": []
            },
            {
              "text": "她可能想起了一些往事…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧，你说得对，那今天就先不打扰她了。"
        }
      ]
    }
  ]
}