{
  "quest_id": 20021,
  "chapter_num": null,
  "chapter_title": "冒险家测验·起飞方式",
  "type": "iq",
  "route": "Adventurer Exam: Taking Flight",
  "stories": [
    {
      "story_id": 20021,
      "title": "冒险家测验·起飞方式",
      "description": "蒙德城的安娜真的想要成为冒险家…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "安娜",
          "text": "为什么使用风之翼还要考飞行执照这种东西啦…"
        },
        {
          "role": "安娜",
          "text": "哥，你考过飞行执照吗？"
        },
        {
          "role": "安东尼",
          "text": "我不用风之翼，从来没考过…"
        },
        {
          "role": "旅行者",
          "text": "你要考飞行执照？"
        },
        {
          "role": "安娜",
          "text": "因为风之翼是冒险的必备道具嘛，所以我就想练习一下风之翼的使用方法。"
        },
        {
          "role": "安娜",
          "text": "但我没想到…居然还有飞行执照这种东西…"
        },
        {
          "role": "安娜",
          "text": "虽然我已经报名考试了…但一些知识点我还是没完全背熟…"
        },
        {
          "role": "安娜",
          "text": "旅行者，我听安柏小姐说，你已经有飞行执照了，能请你辅导我一下吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是安柏为你监考吗？",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "那倒不是，我只是在报名的时候遇见了安柏小姐。"
                },
                {
                  "role": "安娜",
                  "text": "她为我介绍飞行执照考试情况的时候提到了你，她说你考得可好了。"
                },
                {
                  "role": "安娜",
                  "text": "所以，我就想来请教一下你有关飞行执照考试的问题…"
                }
              ]
            },
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "太好了！那就拜托你了！"
                }
              ]
            }
          ]
        },
        {
          "role": "安娜",
          "text": "那…我有三个问题想要问你。"
        },
        {
          "role": "安娜",
          "text": "唔…第一个问题是，在飞行时，最多可以同时几人共用一架风之翼？"
        },
        {
          "role": "安娜",
          "text": "喔…我差不多了解了！不过光听理论也不行…"
        },
        {
          "role": "安娜",
          "text": "旅行者，能请你为我演示一下风之翼的操纵方式吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "你可要看好了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安娜",
          "text": "那就拜托你啦，我们赶紧出发吧！"
        },
        {
          "type": "subtitle",
          "text": "为安娜演示操纵风之翼的方法"
        },
        {
          "role": "旅行者",
          "text": "一架风之翼只可由一人使用。"
        },
        {
          "role": "安娜",
          "text": "原来如此…"
        },
        {
          "type": "subtitle",
          "text": "为安娜演示操纵风之翼的方法"
        },
        {
          "role": "旅行者",
          "text": "这取决于风之翼操纵者的水平。"
        },
        {
          "role": "安娜",
          "text": "原来如此…"
        },
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "旅行者",
          "text": "这取决于风之翼操纵者的体重。"
        },
        {
          "role": "安娜",
          "text": "原来如此…"
        },
        {
          "role": "安娜",
          "text": "你操纵风之翼的手法可真是太厉害了，怪不得安柏小姐要我来请教你呢。"
        },
        {
          "role": "安娜",
          "text": "嘿嘿，有你给我辅导，我肯定能通过飞行执照的考试。"
        },
        {
          "role": "安娜",
          "text": "谢谢你啦，这些东西请你收下，我先回去复习了。"
        },
        {
          "role": "安娜",
          "text": "唔…我的风之翼用什么颜色比较好呢…"
        },
        {
          "role": "安娜",
          "text": "蓝色？绿色？不然都要一点好了…"
        },
        {
          "role": "安娜",
          "text": "第二个问题是，使用风之翼起飞时，需要注意什么？"
        },
        {
          "role": "旅行者",
          "text": "需采取合理的起飞动作与起飞地点。"
        },
        {
          "role": "安娜",
          "text": "是这样吗…"
        }
      ]
    }
  ]
}