{
  "quest_id": 22010,
  "chapter_num": null,
  "chapter_title": "这本小说…厉害吗？",
  "type": "iq",
  "route": "Is This Novel Amazing?",
  "stories": [
    {
      "story_id": 22010,
      "title": "这本小说…厉害吗？",
      "description": "「八重堂」的编辑阿茂和作家顺吉似乎正在为什么事情争吵…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "拜访阿茂和顺吉"
        },
        {
          "role": "阿茂",
          "text": "顺吉，明天是交稿的最后期限，绝对不能再拖延了！"
        },
        {
          "role": "顺吉",
          "text": "你再怎么催我都没用，剧情卡在关键的地方了，我不知道该怎么写才好。"
        },
        {
          "role": "旅行者",
          "text": "你们在吵什么呢？"
        },
        {
          "role": "阿茂",
          "text": "是…是旅行者？你来得正好，正好你来评评理。"
        },
        {
          "role": "阿茂",
          "text": "我是「八重堂」的编辑阿茂。这位是我负责的作家顺吉。"
        },
        {
          "role": "阿茂",
          "text": "他的新小说《鬼武道》本来很受欢迎，但他总是不能按时交稿，有时会拖延好几周。"
        },
        {
          "role": "阿茂",
          "text": "这次他又犯老毛病了，如果明天还不交稿，这个月的小说合刊就没法按时送印了。"
        },
        {
          "role": "顺吉",
          "text": "实在不行，就延期发售吧，反正忠实的读者还是会掏钱的。"
        },
        {
          "role": "阿茂",
          "text": "别开玩笑了，要是不能连续更新的话，小说的口碑会一口气跌到谷底的！"
        },
        {
          "role": "顺吉",
          "text": "但我没有灵感，与其写一些无趣的注水章节，还不如好好思索一下真正有趣的故事！"
        },
        {
          "role": "阿茂",
          "text": "但其他作者都已经都差不多交齐了，就差你一个人了！"
        },
        {
          "role": "旅行者",
          "text": "或许顺吉先生真的需要灵感…"
        },
        {
          "role": "顺吉",
          "text": "没错！这位朋友就很懂行，我需要灵感！"
        },
        {
          "role": "顺吉",
          "text": "也许四处转转，找找灵感，我就知道接下来该怎么写了！"
        },
        {
          "role": "阿茂",
          "text": "喂，上次你就是拿这个借口又拖了一天，还想来这套吗？"
        },
        {
          "role": "顺吉",
          "text": "这次绝对不会了，你也相信我一回啊！"
        },
        {
          "role": "阿茂",
          "text": "真是的…好吧，就再相信你一回…"
        },
        {
          "role": "阿茂",
          "text": "一定，一定不能再拖了，知道了吗？"
        },
        {
          "role": "顺吉",
          "text": "我知道了，我知道了…"
        },
        {
          "role": "顺吉",
          "text": "呼…这回看来是真的不能拖了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们现在就去取材吧。",
              "dialogues": []
            },
            {
              "text": "我们还是去找灵感吧。",
              "dialogues": [
                {
                  "role": "顺吉",
                  "text": "但灵感这东西，有时候找也找不到啊…"
                },
                {
                  "role": "顺吉",
                  "text": "不过现在也只能四处找找看了，不然阿茂非把我的屋子给掀了…"
                }
              ]
            }
          ]
        },
        {
          "role": "顺吉",
          "text": "我正在构思的章节里，主角在为下一场大战做准备。"
        },
        {
          "role": "顺吉",
          "text": "我觉得，他需要一个更强的武器，容我想想…"
        },
        {
          "role": "顺吉",
          "text": "我们就去「天目锻冶屋」看看吧。"
        },
        {
          "role": "顺吉",
          "text": "我正在构思的章节里，主角正想卖掉冒险途中搜集到的物品，积攒钱财。"
        },
        {
          "role": "顺吉",
          "text": "这样一来，就要和各种买方打交道了…"
        },
        {
          "role": "顺吉",
          "text": "我想想…我们就去「九十九物」看看吧。"
        },
        {
          "role": "顺吉",
          "text": "我正在构思的章节里，主角独自去往了敌人的领地。"
        },
        {
          "role": "顺吉",
          "text": "想要在那里对抗敌人们，收集情报是一项必要的工作，该怎么让他从容地度过这关呢…"
        },
        {
          "role": "顺吉",
          "text": "唔，我们不如先去观察一下同心们的工作吧。"
        },
        {
          "type": "subtitle",
          "text": "与顺吉一同前往「天目锻冶屋」"
        },
        {
          "role": "顺吉",
          "text": "火花飞溅，铁锤和铁砧不停碰撞…"
        },
        {
          "role": "顺吉",
          "text": "「天目锻冶屋」真是个热情澎湃的地方！"
        },
        {
          "role": "顺吉",
          "text": "铁匠们只用简单的工具，就能把粗糙的原胚和矿石变成性能卓越的兵器。"
        },
        {
          "role": "顺吉",
          "text": "那要是在锻造的过程中，使用炼金术，岂不是能制造出无坚不摧的神兵利器？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "炼金术没有这么夸张…",
              "dialogues": []
            },
            {
              "text": "你对炼金术有误解…",
              "dialogues": [
                {
                  "role": "顺吉",
                  "text": "误解？什么误解，炼金术不就是那种…把不可能化为可能的技术吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "顺吉",
          "text": "嗯！这个主意不错，让主角拥有一把…由炼金术铸就的最强武器！"
        },
        {
          "role": "顺吉",
          "text": "而且还要让这把武器有一个好名字…和一个好来历。"
        },
        {
          "role": "顺吉",
          "text": "没错，就这么干！"
        },
        {
          "role": "顺吉",
          "text": "旅行者，我们回去吧，我要把我的构思告诉阿茂。"
        },
        {
          "type": "subtitle",
          "text": "与顺吉一同前往「九十九物」"
        },
        {
          "role": "顺吉",
          "text": "「九十九物」里有着各式各样的商品，和冒险途中搜集的物品很像。"
        },
        {
          "role": "顺吉",
          "text": "葵小姐总是说，「一些其貌不扬的东西，也会被特定的买方看重」。"
        },
        {
          "role": "顺吉",
          "text": "唔…看来想要让商品卖出高价，找准买方重视的因素才是关键呢。"
        },
        {
          "role": "顺吉",
          "text": "但如果要这么写的话，就要花很大的功夫在描写心理博弈上，和「鬼武道」这本小说主题有些不合啊…"
        },
        {
          "role": "顺吉",
          "text": "不如让主角可以读心好了，这样他就可以准确洞察买方的需求…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别突然增加设定啊！",
              "dialogues": [
                {
                  "role": "顺吉",
                  "text": "这就是人物的「成长」啦，没关系的没关系的。"
                }
              ]
            },
            {
              "text": "都没有剧情铺垫的吗…",
              "dialogues": [
                {
                  "role": "顺吉",
                  "text": "剧情铺垫…唔，这个我写的时候会考虑的，应该不会有问题。"
                }
              ]
            }
          ]
        },
        {
          "role": "顺吉",
          "text": "我有灵感了，我明白该怎么写了！"
        },
        {
          "role": "顺吉",
          "text": "旅行者，我们回去吧，我要把我的构思告诉阿茂。"
        },
        {
          "type": "subtitle",
          "text": "与顺吉一同观察同心们的工作"
        },
        {
          "role": "顺吉",
          "text": "同心们维持着花见坂的治安，可疑人士根本逃不过他们的监视。"
        },
        {
          "role": "顺吉",
          "text": "敌国的骑士，和同心有着相同的职责，但为了更大的看头，就设定成同心的…十倍实力吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这数值也太随意了！",
              "dialogues": [
                {
                  "role": "顺吉",
                  "text": "数值上的察觉是最直观的嘛，这样才能体现出主角的强大！"
                }
              ]
            },
            {
              "text": "你准备怎么让主角解决这个问题…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "顺吉",
          "text": "至于主角怎么解决这个问题…就让主角有一个…呃，伪装的能力吧，能够自由改变外形和声音的那种。"
        },
        {
          "role": "旅行者",
          "text": "这是突然增加设定吗…"
        },
        {
          "role": "顺吉",
          "text": "这是主角的隐藏能力啦，遇见了需要用这种能力解决的敌人，当然要展现出来了。"
        },
        {
          "role": "旅行者",
          "text": "我说，你是现编的吧？"
        },
        {
          "role": "顺吉",
          "text": "那、那怎么可能啦…我当然是之前就想好了。"
        },
        {
          "role": "顺吉",
          "text": "好了，就这么办，我们回去把我的构思告诉阿茂吧。"
        },
        {
          "type": "subtitle",
          "text": "回八重堂找阿茂"
        },
        {
          "role": "阿茂",
          "text": "希望这个月的合刊能按时送印啊…"
        },
        {
          "role": "旅行者",
          "text": "其实顺吉的想法还不错…"
        },
        {
          "role": "阿茂",
          "text": "还不错？这、这样写下去，到最后他自己都会被这些设定弄晕的！"
        },
        {
          "role": "顺吉",
          "text": "哈哈哈，你瞧，旅行者也支持我，说明我的构思足够吸引人！"
        },
        {
          "role": "顺吉",
          "text": "小说最重要的当然就是能吸引人的爽快剧情了，我现在就按这个思路去写了。"
        },
        {
          "role": "阿茂",
          "text": "我说你啊…"
        },
        {
          "role": "顺吉",
          "text": "别担心了，我自己写的东西我自己心里有数，这样写绝对会得到一致好评，你就看好吧。"
        },
        {
          "role": "旅行者",
          "text": "其实阿茂的看法更合理…"
        },
        {
          "role": "顺吉",
          "text": "更合理？合理性哪有爽快的情节重要，没有足够吸引人的故事，再合理的情节都只能带来无趣！"
        },
        {
          "role": "阿茂",
          "text": "你这家伙…你爽快了一时，到要给这个故事收尾的时候，你会被你之前搞的这些设定逼疯的！"
        },
        {
          "role": "顺吉",
          "text": "我、我自己做了笔记，收尾的时候怎么可能有问题！"
        },
        {
          "role": "阿茂",
          "text": "你自己都要做笔记才能记住这些设定了，你打算让读者也和你一样，一边读小说一边记笔记吗？"
        },
        {
          "role": "顺吉",
          "text": "呃…这…"
        },
        {
          "role": "阿茂",
          "text": "我也不是不让你使用这些设定，但就算要用，也要慎重地选择使用的方法和次数。"
        },
        {
          "role": "阿茂",
          "text": "写小说这件事，说到底是一个体力活，如果一开始就拼尽全力的话，越到后面只会越疲软。"
        },
        {
          "role": "阿茂",
          "text": "只有一步步地稳定前进，才是一本小说成功的关键，你就相信我吧。"
        },
        {
          "role": "顺吉",
          "text": "好、好吧…唉…"
        }
      ]
    }
  ]
}