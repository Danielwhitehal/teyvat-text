{
  "quest_id": 73193,
  "chapter_num": null,
  "chapter_title": "流放者·萌芽",
  "type": "wq",
  "route": "The Exile: Sprouting",
  "stories": [
    {
      "story_id": 73193,
      "title": "流放者·萌芽",
      "description": "赛芭种植的须弥蔷薇始终无法生长，试着帮助她吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "使用草元素的力量为种子「施肥」"
        },
        {
          "type": "subtitle",
          "text": "和赛芭聊聊"
        },
        {
          "role": "赛芭",
          "text": "你能够使用草元素力？难道我碰上神之眼持有者了…"
        },
        {
          "role": "赛芭",
          "text": "好久没见过这样的人了，真让人怀念。"
        },
        {
          "role": "派蒙",
          "text": "赛芭小姐，赛芭小姐，这样就好了吧。"
        },
        {
          "role": "赛芭",
          "text": "没错，而且直接使用草元素力的话，它们应该很快就能发芽，我们等等看吧——"
        },
        {
          "role": "？？？",
          "text": "慢慢地，几根细弱的幼芽从土坑里钻了出来。"
        },
        {
          "role": "？？？",
          "text": "展开几片绿叶后，幼芽不再生长。"
        },
        {
          "role": "派蒙",
          "text": "发芽了发芽了，我就说嘛，旅行者什么都能做好。"
        },
        {
          "role": "赛芭",
          "text": "果然立刻就看到效果了，感谢你们。"
        },
        {
          "role": "旅行者",
          "text": "可惜没有开花。"
        },
        {
          "role": "赛芭",
          "text": "啊，这是很自然的事，不能着急。"
        },
        {
          "role": "赛芭",
          "text": "植物总要经历发芽、抽枝、结苞、开花这样的生长阶段，你能那么快就让种子发芽，已经很厉害了。"
        },
        {
          "role": "赛芭",
          "text": "多给蔷薇点时间，让它们继续汲取些养分再开花吧，这样对它们也好。"
        },
        {
          "role": "赛芭",
          "text": "况且今天的事已经让我很感激了，再麻烦两位就太不礼貌了。"
        },
        {
          "role": "赛芭",
          "text": "以后你们空闲的时候，能来看看它们就很好了。"
        }
      ]
    }
  ]
}