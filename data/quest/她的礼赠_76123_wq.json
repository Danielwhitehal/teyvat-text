{
  "quest_id": 76123,
  "chapter_num": null,
  "chapter_title": "她的礼赠",
  "type": "wq",
  "route": "A Gift From Her",
  "stories": [
    {
      "story_id": 76123,
      "title": "她的礼赠",
      "description": "在「银月之庭」，哥伦比娅似乎有想做的事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同哥伦比娅见面"
        },
        {
          "role": "派蒙",
          "text": "好香的味道，又遇上哥伦比娅的用餐时间了吗？"
        },
        {
          "role": "派蒙",
          "text": "月灵们…正在一个个排队，盛汤的是哥伦比娅！"
        },
        {
          "role": "哥伦比娅",
          "text": "稍等一下哦。"
        },
        {
          "role": "月灵",
          "text": "~！"
        },
        {
          "role": "派蒙",
          "text": "哇，这个好喝欸…"
        },
        {
          "role": "派蒙",
          "text": "清香爽口的甜果子汤，是在别的地方没喝过的味道！"
        },
        {
          "role": "哥伦比娅",
          "text": "再来一碗？"
        },
        {
          "role": "派蒙",
          "text": "两碗！"
        },
        {
          "role": "努昂诺塔",
          "text": "……！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哥伦比娅最近在学习烹饪？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，我问伊涅芙要了些基础菜谱，已经尝试了几次。月灵和小动物们的反响都不错。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有遇到什么难点吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "唔，袖子太宽了，一不小心就会沾到锅边…"
        },
        {
          "role": "旅行者",
          "text": "（原来不是烹饪本身的困难啊。）"
        },
        {
          "role": "哥伦比娅",
          "text": "不过，在制作点心类食物的时候，会有些应付不来。"
        },
        {
          "role": "哥伦比娅",
          "text": "它们对于温度和比例的要求很严格…"
        },
        {
          "role": "旅行者",
          "text": "（看来她以前很少自己做东西吃。）"
        },
        {
          "role": "旅行者",
          "text": "（而且点心类的料理，如果只靠自己摸索的话，的确会不容易…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要我来帮你吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "好呀。先从蛋卷开始吧。"
        },
        {
          "type": "subtitle",
          "text": "一段时间过后…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "尝尝看？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（咬一小口。）",
              "dialogues": []
            },
            {
              "text": "（咬一大口。）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "（第一口好酸啊，感觉脸都快皱到一起了…）"
        },
        {
          "role": "旅行者",
          "text": "（但稍微咽下去一点，甜味就重新出现了…可能习惯之后会好些…）"
        },
        {
          "role": "哥伦比娅",
          "text": "怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "合格…",
              "dialogues": []
            },
            {
              "text": "但调味还有改进空间…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我错过了什么吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，快来尝尝。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "呜哇哇哇，好酸啊，你们欺负人。"
        },
        {
          "role": "哥伦比娅",
          "text": "哈哈…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "回味还是不错的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "重点是一开始啊！根本没人提醒我要少咬它一点！"
        },
        {
          "role": "派蒙",
          "text": "你不说的话，我还以为你想搞恶作剧呢，看别人吃的反应什么的。"
        },
        {
          "role": "哥伦比娅",
          "text": "好吧，我再试试。"
        },
        {
          "type": "subtitle",
          "text": "又一段时间过后…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "给，试试看这次的。"
        },
        {
          "role": "旅行者",
          "text": "（唔…！这次的好多了！）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这次的真好吃！",
              "dialogues": []
            },
            {
              "text": "你学东西真快！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "真的吗？我也要我也要！唔…！这个好这个好！"
        },
        {
          "role": "哥伦比娅",
          "text": "能送得出手吗？"
        },
        {
          "role": "派蒙",
          "text": "当然可以！哦，哥伦比娅你学烹饪，做蛋卷，是想要给谁准备礼物吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯…想送给朋友们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "挺好的主意。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "还记得你们第一次一起来这边的时候吗？你们为我准备了一些饭菜。"
        },
        {
          "role": "哥伦比娅",
          "text": "与我流失的力量相比，食物没法提供多少补充，但在吃完之后，我的内心却舒缓了不少。"
        },
        {
          "role": "哥伦比娅",
          "text": "虽然那时没有细想其中的缘由，但现在我已经明白了。"
        },
        {
          "role": "哥伦比娅",
          "text": "亲手制作，用心付出…赋予食物灵魂的是人们所花费的时间。"
        },
        {
          "role": "哥伦比娅",
          "text": "我享用的不是饭菜本身，而是背后那双手中的温暖与善意。"
        },
        {
          "role": "哥伦比娅",
          "text": "它越是不求回报，便越是珍贵，唯有同等的温暖与善意才能与它辉映。"
        },
        {
          "role": "派蒙",
          "text": "哎呀，说得我都不好意思了，我们那时候还是挺想讨好你的呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不过现在不一样了。",
              "dialogues": []
            },
            {
              "text": "有什么想吃的就尽管说吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，但在理解这些之后，我也想多付出一点…感觉很开心。"
        },
        {
          "role": "哥伦比娅",
          "text": "可以和我一起出门拜访朋友们吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "除了蛋卷，我还准备了一些别的小礼物。哦，不过，是悄悄地送哟。"
        },
        {
          "role": "派蒙",
          "text": "为什么是「悄悄地」？"
        },
        {
          "role": "哥伦比娅",
          "text": "以前都是你们给我「惊喜」，我也想看看朋友们收到「惊喜」时的反应。"
        },
        {
          "role": "派蒙",
          "text": "呼，跑了好多地方呢，终于送完了。"
        },
        {
          "role": "派蒙",
          "text": "大家的反应都有些意想不到呢，虽然有的人好像根本没有意识到这是哥伦比娅的礼物。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "爱诺只顾着吃了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "没事，这也在我的预期之中。只要朋友们收到礼物时开心就好，这才是最重要的。"
        },
        {
          "role": "派蒙",
          "text": "这么说的话，菈乌玛看起来倒是发现了她桌上的蛋卷和花环是哥伦比娅送的。"
        },
        {
          "role": "派蒙",
          "text": "花环舍不得戴我倒是能理解，但那个蛋卷…她足足看了十分钟都没舍得吃呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "都怕她要供起来…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "但雅珂达好像被吓了一跳…是不是不该悄悄把东西放到她身后呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真的吓了一「跳」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "可能她本身就比较警觉吧。但在阿舍鲁过来挠你送的猫抓板后，她好像就冷静下来了。"
        },
        {
          "role": "哥伦比娅",
          "text": "其他最近不在挪德卡莱的朋友，就拜托你们送去啦。"
        },
        {
          "role": "长翎鹮",
          "text": "！！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哥伦比娅还挺会准备礼物的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "给。"
        },
        {
          "role": "派蒙",
          "text": "噢！终于轮到我们了吗？"
        },
        {
          "role": "派蒙",
          "text": "欸？是糖果？我还以为会跟大家一样是蛋卷呢。"
        },
        {
          "role": "哥伦比娅",
          "text": "那个已经在试吃的时候尝过了吧？来点不一样的不是更好么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯…很好吃。",
              "dialogues": []
            },
            {
              "text": "比祈月之夜的糖果更好吃。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "那就好。"
        },
        {
          "role": "哥伦比娅",
          "text": "还有一份。给你的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是…风之翼？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "我听说天空属于飞鸟，陆地属于走兽…"
        },
        {
          "role": "哥伦比娅",
          "text": "而天与地之间的广阔间隔，是留给身披风之翼的冒险家穿梭的。"
        },
        {
          "role": "哥伦比娅",
          "text": "希望在有它相伴的日子里，你的前路始终会像被月光照拂那般明朗。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我很喜欢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "谢谢你的陪伴。"
        }
      ]
    }
  ]
}