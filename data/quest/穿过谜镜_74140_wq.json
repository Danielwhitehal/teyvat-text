{
  "quest_id": 74140,
  "chapter_num": null,
  "chapter_title": "穿过谜镜",
  "type": "wq",
  "route": "Through the Looking Glass",
  "stories": [
    {
      "story_id": 74140,
      "title": "穿过谜镜",
      "description": "似乎发生了一些变化…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "咦？那幅画…"
        },
        {
          "type": "subtitle",
          "text": "进入「谜镜」"
        },
        {
          "role": "派蒙",
          "text": "呃，头好晕…这里是…那是夏诺蒂拉吗？"
        },
        {
          "type": "subtitle",
          "text": "与夏诺蒂拉对话"
        },
        {
          "role": "夏诺蒂拉",
          "text": "哎呀，又见面了。咦，这次把派蒙也带来了吗？"
        },
        {
          "role": "派蒙",
          "text": "咦，上次我们一起「冥想」到这里来的时候，我也在呀⋯"
        },
        {
          "role": "夏诺蒂拉",
          "text": "有这回事？那可能是我忘了吧。"
        },
        {
          "role": "夏诺蒂拉",
          "text": "不管怎么说，多亏你帮忙，我才找到了「谜镜」的位置、找到将要盛开花朵的地方，对这里的了解也加深了。"
        },
        {
          "role": "派蒙",
          "text": "唔⋯夏诺蒂拉说话的风格还是这么令人摸不着头脑呢。"
        },
        {
          "role": "「小狗」",
          "text": "汪！"
        },
        {
          "role": "夏诺蒂拉",
          "text": "嗯？不过⋯"
        },
        {
          "role": "「小狗」",
          "text": "呜汪！"
        },
        {
          "role": "夏诺蒂拉",
          "text": "好啦好啦，我知道啦。"
        },
        {
          "role": "派蒙",
          "text": "（唔⋯她和小狗在说什么呀？难道说，美露莘一般都会狗语吗？）"
        },
        {
          "role": "旅行者",
          "text": "（真不可思议。）"
        },
        {
          "role": "夏诺蒂拉",
          "text": "真没办法，那下次再见喽。哼，就算你这么说了，我也还是会回来找你玩的。"
        },
        {
          "role": "夏诺蒂拉",
          "text": "那我们走吧，旅行者哥哥、派蒙。"
        },
        {
          "role": "夏诺蒂拉",
          "text": "唉。又到这里来了。"
        },
        {
          "role": "派蒙",
          "text": "怎么啦？"
        },
        {
          "role": "夏诺蒂拉",
          "text": "其实我也觉得这么说太任性了，毕竟大家都对我很好，你们也对我很好。但是⋯"
        },
        {
          "role": "夏诺蒂拉",
          "text": "不觉得现实世界无趣得可怕吗？不觉得书里的世界更美丽吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也觉得。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？你居然这么觉得吗⋯"
                }
              ]
            },
            {
              "text": "我不这么觉得。",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "是喔…可能这样才是对的，我这样是不正常的。",
                  "narration": true
                }
              ]
            },
            {
              "text": "对我来说没有区别。",
              "dialogues": [
                {
                  "role": "夏诺蒂拉",
                  "text": "看来旅行者哥哥是最坚强的人呢。"
                }
              ]
            }
          ]
        },
        {
          "role": "夏诺蒂拉",
          "text": "我觉得，还是「揭示之书」里的世界更美丽。到处都是沾着露水的花瓣，而且好不容易才跟小狗交上了朋友。"
        },
        {
          "role": "派蒙",
          "text": "小狗⋯说起来，夏诺蒂拉，你能听懂狗狗说的话吗？"
        },
        {
          "role": "夏诺蒂拉",
          "text": "嗯？当然不能啦。只是，「揭示之书」里的小狗是特别的。也可能，我是特别的？"
        },
        {
          "role": "夏诺蒂拉",
          "text": "但我一直冥想，到书里的世界去玩。有一天，突然间，原本的汪汪叫，就变成了语言。"
        },
        {
          "role": "夏诺蒂拉",
          "text": "至于我们说的话⋯他在劝我走，让我不要再来了。"
        },
        {
          "role": "夏诺蒂拉",
          "text": "唉，我还是想看到向日葵盛开的景象⋯"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "⋯⋯",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是、是喔⋯夏诺蒂拉要多保重喔！那我们先走啦！"
        }
      ]
    }
  ]
}