{
  "quest_id": 74254,
  "chapter_num": null,
  "chapter_title": "水仙的圆舞曲",
  "type": "wq",
  "route": "Narcissus's Waltz",
  "stories": [
    {
      "story_id": 74254,
      "title": "水仙的圆舞曲",
      "description": "前往隐居处放置茶桌并使用桑多涅落座后，与众人共度茶会时光吧…",
      "dialogues": [
        {
          "role": "安",
          "text": "西摩尔！好久不见！还有玛梅赫也是！"
        },
        {
          "role": "玛梅赫",
          "text": "哈哈，西摩尔在旅途中也经常和我说他很想你们。"
        },
        {
          "role": "西摩尔",
          "text": "肯定。我无时不在思念着玛丽安小姐。"
        },
        {
          "role": "玛丽安",
          "text": "也多谢桑多涅小姐愿意举办这样一场茶会，让我们有机会重新聚在一起，聊聊旅途的见闻。"
        },
        {
          "role": "「木偶」",
          "text": "没什么。我只是觉得大家多少也算是有历史渊源的一家人。呃，应该能算吧。所以有空就聚聚没什么不好的。"
        },
        {
          "role": "安",
          "text": "一家人？不知道为什么，听到这样的说法我好高兴。"
        },
        {
          "role": "玛丽安",
          "text": "那桑多涅小姐算是家里的…妹妹？"
        },
        {
          "role": "「木偶」",
          "text": "呃…虽说是「一家人」，但算辈分这种事要不还是免了吧…"
        },
        {
          "role": "西摩尔",
          "text": "肯定。作为阿兰先生创造的原型机，桑多涅小姐应该称呼我为「大哥」。"
        },
        {
          "role": "「木偶」",
          "text": "啧…"
        },
        {
          "role": "玛梅赫",
          "text": "真好呀。我也能算是你们的家庭成员吗？"
        },
        {
          "role": "「木偶」",
          "text": "当然可以，这个「家庭」看起来什么都有了，再来一只美露莘也没什么奇怪的。"
        },
        {
          "role": "西摩尔",
          "text": "肯定。玛梅赫小姐就是我的家人。"
        },
        {
          "role": "玛梅赫",
          "text": "嘿嘿。真开心。那不如，我来为这个「家庭」画一幅画吧？"
        },
        {
          "role": "玛丽安",
          "text": "全家福？真是好久没有过了呢。"
        },
        {
          "role": "安",
          "text": "可要把我画得看起来厉害一点哦！就像家里的姐姐一样！"
        },
        {
          "role": "玛梅赫",
          "text": "嗯！"
        },
        {
          "role": "「木偶」",
          "text": "哈…随你们便吧…"
        },
        {
          "role": "玛丽安",
          "text": "真是平静惬意的日子。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "玛丽安",
          "text": "嗯，感谢你的邀请。桑多涅…妹妹？"
        }
      ]
    }
  ]
}