{
  "quest_id": 23027,
  "chapter_num": null,
  "chapter_title": "大树",
  "type": "iq",
  "route": "The Great Tree",
  "stories": [
    {
      "story_id": 23027,
      "title": "大树",
      "description": "一位名为雅丝敏的学生似乎很在意面前「圣树」的情况…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与雅丝敏对话"
        },
        {
          "role": "雅丝敏",
          "text": "果然还是得好好照看一下啊…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么？"
        },
        {
          "role": "雅丝敏",
          "text": "你是…喔，看样子是位旅行者，对吧？"
        },
        {
          "role": "雅丝敏",
          "text": "我是阿弥利多学院的学生，雅丝敏，正在这里研究这棵「圣树」。"
        },
        {
          "role": "雅丝敏",
          "text": "这棵「圣树」历经的岁月，比奥摩斯港里所有手抓饭的饭粒数量加起来都多。"
        },
        {
          "role": "雅丝敏",
          "text": "同时它又托举着教令院…重要性堪比唐杜尔烤鸡底下垫着的蔬菜。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这都是些什么比喻…",
              "dialogues": []
            },
            {
              "text": "派蒙肯定能听懂吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "真是一棵很伟大的树啊…"
                }
              ]
            }
          ]
        },
        {
          "role": "雅丝敏",
          "text": "但如果它出了问题，那须弥城也会面临巨大的灾难。"
        },
        {
          "role": "雅丝敏",
          "text": "比如，它遭到了虫害，比屋顶还大的蝗虫从树的内部冲出…"
        },
        {
          "role": "雅丝敏",
          "text": "或者是它的枝干生长失去控制，庞大的根系宛如洪水般从地底涌出，摧毁了所有房屋。"
        },
        {
          "role": "雅丝敏",
          "text": "又或者，这棵「圣树」飞速枯萎，倒下的树身压垮了半个须弥城…"
        },
        {
          "role": "旅行者",
          "text": "应，应该不会这样吧？！"
        },
        {
          "role": "雅丝敏",
          "text": "喔，那当然，到目前为止，它的情况一切正常。"
        },
        {
          "role": "雅丝敏",
          "text": "但话也说回来，在你去树林摘蘑菇的时候，袭击你的蕈兽也不会提前告知你它们的到来。"
        },
        {
          "role": "雅丝敏",
          "text": "我之所以在此研究，也是在观察这棵大树的情况，为各种可能发生的意外做准备。"
        },
        {
          "role": "雅丝敏",
          "text": "不过如你所见，就算我的思维如同暝彩鸟一般敏捷，但我的体力也如同星蕈一般孱弱…"
        },
        {
          "role": "雅丝敏",
          "text": "所以旅行者，你能帮我去记录几处「圣树」根系的状况吗？"
        },
        {
          "role": "雅丝敏",
          "text": "平时我都会雇佣冒险家和我同行，但现在他们似乎都没空…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "你们学者都是这么说话的吗…",
              "dialogues": [
                {
                  "role": "雅丝敏",
                  "text": "欸？你是说这些比喻吗？抱歉呀，我的说话方式一直是这样的…"
                },
                {
                  "role": "雅丝敏",
                  "text": "学院里也有很多人和我说过这个问题，但我一时半会是改不回来了。"
                },
                {
                  "role": "雅丝敏",
                  "text": "那这件事就拜托你了，我就在这里等着你。"
                }
              ]
            }
          ]
        },
        {
          "role": "雅丝敏",
          "text": "旅行者，真巧，又见到你了。"
        },
        {
          "role": "旅行者",
          "text": "你还在研究吗？"
        },
        {
          "role": "雅丝敏",
          "text": "嗯，拉德普和法尔希说还需要搜集更多数据，我就只能继续我的工作啦。"
        },
        {
          "role": "雅丝敏",
          "text": "不过，也不知道那些根系现在是什么情况…"
        },
        {
          "role": "雅丝敏",
          "text": "旅行者，如果你有空的话，就请再帮我去记录一下那些根系的情况吧。"
        },
        {
          "type": "subtitle",
          "text": "前往圣树根系所在的位置"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "role": "雅丝敏",
          "text": "那这件事就拜托你了，我就在这里等着你。"
        },
        {
          "type": "subtitle",
          "text": "记录根系的情况"
        },
        {
          "type": "subtitle",
          "text": "前往圣树根系所在的位置"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "type": "subtitle",
          "text": "记录根系的情况"
        },
        {
          "type": "subtitle",
          "text": "前往圣树根系所在的位置"
        },
        {
          "type": "subtitle",
          "text": "清理蜘蛛网"
        },
        {
          "type": "subtitle",
          "text": "记录根系的情况"
        },
        {
          "type": "subtitle",
          "text": "向雅丝敏回报"
        },
        {
          "role": "雅丝敏",
          "text": "你们回来了，圣树根系的情况怎么样？"
        },
        {
          "role": "？？？",
          "text": "向雅丝敏叙述了根系的情况…"
        },
        {
          "role": "雅丝敏",
          "text": "…喔，既然有生物聚集在那里，那就说明那块土地还有着很强的活力。"
        },
        {
          "role": "雅丝敏",
          "text": "圣树的根系一定也能安稳地生长，暂时不会出太大的问题。"
        },
        {
          "role": "雅丝敏",
          "text": "唯一要担心的问题…就是周围的水体会不会过营养化，从而滋生更多的蕈兽…"
        },
        {
          "role": "雅丝敏",
          "text": "喔，这是你们的报酬，谢谢你们帮忙。"
        },
        {
          "role": "雅丝敏",
          "text": "还是要让拉德普和法尔希监控一下周围的元素浓度才行…"
        }
      ]
    }
  ]
}