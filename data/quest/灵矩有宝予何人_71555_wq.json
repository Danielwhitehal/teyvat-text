{
  "quest_id": 71555,
  "chapter_num": null,
  "chapter_title": "灵矩有宝予何人",
  "type": "wq",
  "route": "And This Treasure Goes To...",
  "stories": [
    {
      "story_id": 71555,
      "title": "灵矩有宝予何人",
      "description": "在灵矩关里，你们发现了一处奇怪的营地，在这个营地中，似乎发生了什么事…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "这本日记，好像是一位学者的呢。"
        },
        {
          "role": "派蒙",
          "text": "看起来…她好像被盗宝团盯上了，希望她已经安全离开了…"
        },
        {
          "type": "subtitle",
          "text": "调查奇怪的扎营地"
        },
        {
          "role": "派蒙",
          "text": "呜哇…好像有人在这里搏斗过，地面都变得乱七八糟了。"
        },
        {
          "type": "subtitle",
          "text": "寻找失踪的学者"
        },
        {
          "type": "subtitle",
          "text": "打倒盗宝团，获得钥匙"
        },
        {
          "type": "subtitle",
          "text": "与爱拉尼对话"
        },
        {
          "role": "爱拉尼",
          "text": "谢谢你们，我还以为我彻底完了…这帮盗宝团应该是一直在跟踪我。"
        },
        {
          "role": "爱拉尼",
          "text": "我对这片遗迹的研究刚刚有了进展，想着要是能挖出埋藏在这里的宝藏带回去就再好不过了…"
        },
        {
          "role": "爱拉尼",
          "text": "但是还没等我做好准备，盗宝团就闯进营地，把我给绑起来带到了这里。"
        },
        {
          "role": "爱拉尼",
          "text": "他们还一直逼问我宝藏的下落，还威胁我说，如果我不把宝藏地点说出来，他们就要了我的命。"
        },
        {
          "role": "爱拉尼",
          "text": "不过我知道，要是我直接把宝藏的线索告诉了他们，那我才是真不要命了…"
        },
        {
          "role": "爱拉尼",
          "text": "唉，我果然该听索拉雅小姐的话，考古学家最好别太在意宝藏，只要有学术上的收获就好。"
        },
        {
          "role": "爱拉尼",
          "text": "但是我的经费就这么一点，光是几篇论文，连我自己掏的来往路费都填不平…"
        },
        {
          "role": "爱拉尼",
          "text": "也不知道索拉雅小姐是怎么做到一个人在璃月研究这么久的，光是看她被拒的那么多论文，我都替她觉得累。"
        },
        {
          "role": "旅行者",
          "text": "那你接下来打算怎么办？"
        },
        {
          "role": "爱拉尼",
          "text": "还能怎么办，学术上的资料我已经搜集齐了，宝藏什么的…就算了，就让给你们吧。"
        },
        {
          "role": "爱拉尼",
          "text": "杂七杂八的推导过程我就不说啦，总之，宝藏就埋在灵矩关最中间的那棵<color=#00E1FFFF>金色大树下</color>。"
        },
        {
          "role": "爱拉尼",
          "text": "你们要的话就去拿吧，我把地址写下来给你们，免得你们忘了。"
        },
        {
          "role": "爱拉尼",
          "text": "我休息一会就回营地收拾东西，我要尽快离开这，免得又有盗宝团过来…"
        },
        {
          "role": "爱拉尼",
          "text": "不知道从这里走去望舒客栈要花多长时间，别等我到了望舒客栈，索拉雅小姐已经走了。"
        },
        {
          "role": "爱拉尼",
          "text": "唉，要是索拉雅小姐能做我的导师就好了…"
        },
        {
          "type": "subtitle",
          "text": "获得宝藏"
        },
        {
          "role": "爱拉尼",
          "text": "笔记…笔记…还好没缺页…"
        },
        {
          "role": "爱拉尼",
          "text": "咦？你们还没找到吗？宝藏就在灵矩关最中间的那棵<color=#00E1FFFF>金色大树下</color>，你们想要的话，就快点去拿吧。"
        },
        {
          "type": "subtitle",
          "text": "打开笼子"
        },
        {
          "role": "派蒙",
          "text": "唔，这堆篝火已经熄灭很久了，扎营的人好像已经离开了呢。"
        },
        {
          "role": "派蒙",
          "text": "咦？这里刻着字。"
        },
        {
          "role": "派蒙",
          "text": "「他们要带我去山上，救救我。」"
        },
        {
          "role": "派蒙",
          "text": "一定是那位学者，我们快去山上吧！"
        },
        {
          "role": "派蒙",
          "text": "在这里扎营的那位学者，说不定真的遇到了危险。"
        },
        {
          "role": "派蒙",
          "text": "我们四处找找看吧，说不定能找到什么线索呢。"
        },
        {
          "role": "派蒙",
          "text": "而且，那位学者在这里研究这么久，一定对这里很了解。"
        },
        {
          "role": "派蒙",
          "text": "要是这里有宝藏的话，这位学者说不定也…"
        },
        {
          "type": "subtitle",
          "text": "寻找失踪的学者"
        }
      ]
    }
  ]
}