{
  "quest_id": 20018,
  "chapter_num": null,
  "chapter_title": "紧急修理",
  "type": "iq",
  "route": "Urgent Repairs",
  "stories": [
    {
      "story_id": 20018,
      "title": "紧急修理",
      "description": "玛伽正准备运货去清泉镇，但是货车却被丘丘人袭击，货物和他自己都陷入了危险的境地…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "消灭所有魔物"
        },
        {
          "role": "害怕的玛伽",
          "text": "谢谢你，旅行者，呜…我就知道，我肯定会把工作给搞砸…"
        },
        {
          "role": "害怕的玛伽",
          "text": "就是运一车酒而已我都能搞砸，我到底能做成什么事情呀。"
        },
        {
          "role": "害怕的玛伽",
          "text": "这么下去肯定会被酒庄开除，康纳先生说不定早就觉得我工作能力不行，埃泽先生也许把我的辞退信都拟好了，完了，全都完了…"
        },
        {
          "role": "旅行者",
          "text": "你…你冷静点…"
        },
        {
          "role": "害怕的玛伽",
          "text": "唉，我肯定完蛋了，但是这车酒还是要运到才行。"
        },
        {
          "role": "害怕的玛伽",
          "text": "车也被打坏了…旅行者，能麻烦你帮我找点材料来吗？只要一块<color=#00E1FFFF>结实的木板</color>就行了。"
        },
        {
          "type": "subtitle",
          "text": "和玛伽对话"
        },
        {
          "role": "害怕的玛伽",
          "text": "树林里应该就能找到<color=#00E1FFFF>结实的木板</color>了，找到后就给我吧。"
        },
        {
          "role": "旅行者",
          "text": "好的，别担心…"
        },
        {
          "role": "害怕的玛伽",
          "text": "那就拜托你了，我…我想想怎么才能把车修好。"
        },
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "害怕的玛伽",
          "text": "别，不要，要是我自己来，肯定又会搞砸的，只能拜托你了…"
        },
        {
          "type": "subtitle",
          "text": "收集木材"
        },
        {
          "type": "subtitle",
          "text": "将结实的木板交给玛伽"
        },
        {
          "role": "害怕的玛伽",
          "text": "呼…谢谢，旅行者，还好有你在。"
        },
        {
          "role": "害怕的玛伽",
          "text": "不过这么一折腾，这车我已经不知道怎么修了…"
        },
        {
          "role": "害怕的玛伽",
          "text": "这里是坏的，那里也是坏的…这就算是勉强修好了，走着走着也会散架。"
        },
        {
          "role": "害怕的玛伽",
          "text": "算了，总之先把车弄到镇里去，再慢慢想办法吧。"
        },
        {
          "role": "害怕的玛伽",
          "text": "我记得车上有绳子来着…准是被那群家伙拿走了。"
        },
        {
          "role": "害怕的玛伽",
          "text": "旅行者，帮我去旁边树林里找找看吧，如果<color=#00E1FFFF>绳子</color>在那就好了。"
        },
        {
          "role": "害怕的玛伽",
          "text": "这些就足够了，我应该，应该很快就能把车修好…"
        },
        {
          "role": "害怕的玛伽",
          "text": "那群家伙怎么又来了！旅行者，帮帮我！"
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物"
        },
        {
          "role": "害怕的玛伽",
          "text": "帮我去旁边树林里找找看吧，如果<color=#00E1FFFF>绳子</color>在那就好了。"
        },
        {
          "type": "subtitle",
          "text": "和玛伽对话"
        },
        {
          "role": "旅行者",
          "text": "明白了。"
        },
        {
          "role": "害怕的玛伽",
          "text": "那就麻烦你了，我，我接着看看车的状况。"
        },
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "害怕的玛伽",
          "text": "呜…这里只有你能帮我，拜托了——"
        },
        {
          "type": "subtitle",
          "text": "收集绳索"
        },
        {
          "type": "subtitle",
          "text": "将绳索交给玛伽"
        },
        {
          "role": "害怕的玛伽",
          "text": "谢谢你，旅行者，就先这样吧。"
        },
        {
          "role": "害怕的玛伽",
          "text": "勉强能到清泉镇，把货卸了之后，我再回去向酒庄报告情况。"
        },
        {
          "role": "害怕的玛伽",
          "text": "就是不知道埃泽先生看见车被破坏成这样，我会不会被当场开除啊…"
        },
        {
          "type": "subtitle",
          "text": "前去查看详情"
        }
      ]
    }
  ]
}