{
  "quest_id": 20102,
  "chapter_num": null,
  "chapter_title": "一个男孩的去信",
  "type": "iq",
  "route": "A Boy's Letter",
  "stories": [
    {
      "story_id": 20102,
      "title": "一个男孩的去信",
      "description": "清泉镇的杜拉夫先生，似乎正为了一封信而犯愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与杜拉夫对话"
        },
        {
          "role": "杜拉夫",
          "text": "唉，也不知道那孩子怎么样了…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "杜拉夫",
          "text": "嗯？哦，你来得正好，还记得上次那封信吗？"
        },
        {
          "role": "杜拉夫",
          "text": "如果你有空的话，就帮我把这封信带给葛瑞丝修女吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "杜拉夫",
                  "text": "那就拜托你了。"
                }
              ]
            },
            {
              "text": "为什么要我去？",
              "dialogues": [
                {
                  "role": "杜拉夫",
                  "text": "出了上次那种意外，我怎么敢继续用鸽子送信嘛。"
                },
                {
                  "role": "杜拉夫",
                  "text": "而且，如果我自己送这封信去蒙德城，一定会遇见那孩子…"
                },
                {
                  "role": "杜拉夫",
                  "text": "唉…你也别追问了，这封信就拜托你了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与葛瑞丝对话"
        },
        {
          "role": "杜拉夫",
          "text": "嗯？你怎么还没有去？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于那份信…",
              "dialogues": [
                {
                  "role": "杜拉夫",
                  "text": "…里面就写了些陈年旧事，你上次没有看吗？"
                },
                {
                  "role": "杜拉夫",
                  "text": "没看的话也别看了，都是些无聊的啰嗦话。"
                }
              ]
            },
            {
              "text": "那孩子是谁？",
              "dialogues": [
                {
                  "role": "杜拉夫",
                  "text": "你关心这个做什么，那个一直在桥上喂鸽子的孩子，你还记得吧？"
                },
                {
                  "role": "杜拉夫",
                  "text": "就是他，提米。因为…一些原因，我不太好现在去见他。"
                },
                {
                  "role": "杜拉夫",
                  "text": "满意了吗？快点去把信送过去吧，不然葛瑞丝修女又要想东想西了。"
                }
              ]
            }
          ]
        },
        {
          "role": "葛瑞丝",
          "text": "奇怪，怎么还没有来，难道是出什么事了…"
        },
        {
          "role": "旅行者",
          "text": "这是杜拉夫给你的信。"
        },
        {
          "role": "葛瑞丝",
          "text": "咦？怎么是你送来的，平时不都是鸽子…"
        },
        {
          "role": "葛瑞丝",
          "text": "鸽子出了意外？清泉镇真是…天天都在发生「意外」。"
        },
        {
          "role": "葛瑞丝",
          "text": "谢谢你们把信送来，请稍等一下，我去准备谢礼。"
        },
        {
          "role": "旅行者",
          "text": "关于这封信…"
        },
        {
          "role": "葛瑞丝",
          "text": "您看过了吗？没关系，不是什么重大的秘密。"
        },
        {
          "role": "葛瑞丝",
          "text": "用杜拉夫先生的话来说，这是些「陈年旧事」。"
        },
        {
          "role": "葛瑞丝",
          "text": "只不过，这些「陈年旧事」，我们永远也忘不掉。"
        },
        {
          "role": "旅行者",
          "text": "这些「陈年旧事」到底是…"
        },
        {
          "role": "葛瑞丝",
          "text": "您想听吗？好吧，您是值得信赖的人…但是您也得保证，绝不能把这件事说出去。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我保证。",
              "dialogues": []
            },
            {
              "text": "我尽量。",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "唉，您这个人哪…"
                },
                {
                  "role": "葛瑞丝",
                  "text": "…不过，我相信您的品德。"
                }
              ]
            }
          ]
        },
        {
          "role": "葛瑞丝",
          "text": "…提米的父亲，和杜拉夫先生是很好的朋友，他们一起狩猎，一起喝酒，一起到处折腾…"
        },
        {
          "role": "葛瑞丝",
          "text": "不知道被骑士团警告了多少次，也不知道被维多利亚修女训诫了多少次。"
        },
        {
          "role": "葛瑞丝",
          "text": "直到提米出生，提米的父亲才收敛了起来。他甚至还戒了酒，开始认真工作攒钱，说「老爹要给儿子做榜样才行」。"
        },
        {
          "role": "葛瑞丝",
          "text": "然后，他嚷嚷着不要给提米做坏榜样，磨得杜拉夫先生也把酒给戒了。"
        },
        {
          "role": "葛瑞丝",
          "text": "实在忍不住的时候，他们就一个劲地给自己灌苹果酿，偶尔我会去和他们一起喝一点。"
        },
        {
          "role": "葛瑞丝",
          "text": "但是，他们的一次狩猎出了意外，提米的父亲受了很重的伤…"
        },
        {
          "role": "葛瑞丝",
          "text": "虽然马上就送了过来，我们也全力治疗，但是…很不幸，他还是去世了。"
        },
        {
          "role": "葛瑞丝",
          "text": "那之后，杜拉夫先生就拜托我照顾提米，他回去清泉镇继续做猎人。"
        },
        {
          "role": "葛瑞丝",
          "text": "他每个月都会寄信和钱过来，但却一直不肯见提米。"
        },
        {
          "role": "葛瑞丝",
          "text": "不过，最近他一直在说，要把真相告诉提米，唉，到底他经历了什么呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "您不想告诉提米真相？",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "是的，我不想告诉提米真相，他还是个孩子。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "虽然他一直说自己已经是男子汉，还帮我照顾诺拉和葛罗丽。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "但是…这种残酷的真相，他怎么可能承受得住呢？"
                },
                {
                  "role": "葛瑞丝",
                  "text": "在他足够成熟，能够承受真相之前…"
                },
                {
                  "role": "葛瑞丝",
                  "text": "就算是欺骗也好，我想要给他一个幸福的童年。"
                }
              ]
            },
            {
              "text": "不可能瞒一辈子。",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "…是啊，我知道的。但提米还是个孩子…"
                },
                {
                  "role": "葛瑞丝",
                  "text": "但是我希望…我坚持，他应该有一个快乐的童年。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "这样的话，无论他以后会遭受怎样的痛苦折磨，至少还有美好的回忆能给他安慰。"
                }
              ]
            },
            {
              "text": "知道真相有什么不好的？",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "呼…您这么想也正常，因为您经历了太多，已经足够勇敢，足够坚强了。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "那些将您塑造得如此不凡的经历，想必也是十分痛苦的吧。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "但提米还小，即使是出于我的私心，我也不希望他承受太多。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "…至少，我想给他一个能够回忆的幸福童年。"
                }
              ]
            }
          ]
        },
        {
          "role": "葛瑞丝",
          "text": "不过提米也在长大，想的事，问的问题也越来越多…"
        },
        {
          "role": "葛瑞丝",
          "text": "我已经越来越难面对这孩子了。"
        },
        {
          "role": "葛瑞丝",
          "text": "诺拉说，之前提米一直拉着她到处跑，说是要给自己的父亲筹备礼物，还要寄信过去。"
        },
        {
          "role": "葛瑞丝",
          "text": "但最近，提米总是闷闷不乐的，还总是在发呆。"
        },
        {
          "role": "葛瑞丝",
          "text": "如果您有空的话，能帮我去看看提米吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "那就拜托您了。"
                }
              ]
            },
            {
              "text": "为什么你不自己去？",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "实在不好意思…虽然嘴上说我已经想清楚了，不会告诉提米真相。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "但每次听见那孩子说要给父亲写信的时候，我都会突然心软。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "我真怕我哪一天忍耐不住，把真相全部告诉他。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "…但这样是绝对不行的。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "所以，请您帮我去看看提米吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与提米对话"
        },
        {
          "role": "提米",
          "text": "…一点消息也没有。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你在喂鸽子吗？",
              "dialogues": [
                {
                  "role": "提米",
                  "text": "今天我喂过了，而且已经让它们赶紧飞走，免得又被你祸害。"
                },
                {
                  "role": "提米",
                  "text": "现在我就只是在写信而已。"
                }
              ]
            },
            {
              "text": "你在做什么？",
              "dialogues": [
                {
                  "role": "提米",
                  "text": "我在给我爸写信。"
                }
              ]
            }
          ]
        },
        {
          "role": "提米",
          "text": "葛瑞丝妈妈说，如果爸爸有空的话，就会用鸽子寄信过来。"
        },
        {
          "role": "提米",
          "text": "但是我等到现在也没收到一封信…也许爸爸工作真的太忙了。"
        },
        {
          "role": "提米",
          "text": "我就想，既然爸爸太忙，那我就写一封信给他吧，里面再带上点礼物…可是，带什么礼物好呢…"
        },
        {
          "role": "提米",
          "text": "对了，用<color=#00E1FFFF>蒲公英</color>吧，葛瑞丝妈妈说蒙德人都喜欢蒲公英。"
        },
        {
          "role": "提米",
          "text": "如果你有空的话，就去帮我找点<color=#00E1FFFF>蒲公英</color>来吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "提米",
                  "text": "哦！谢谢你啦…你偶尔还是挺好心的嘛。"
                }
              ]
            },
            {
              "text": "不送点别的？",
              "dialogues": [
                {
                  "role": "提米",
                  "text": "我倒是想送，可是太重的话，鸽子就飞不起来了。"
                },
                {
                  "role": "提米",
                  "text": "而且爸爸在很远的地方工作，鸽子应该也要飞很久吧…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "搜集三份蒲公英"
        },
        {
          "type": "subtitle",
          "text": "将蒲公英交给提米"
        },
        {
          "role": "提米",
          "text": "你快点去找<color=#00E1FFFF>蒲公英</color>啊，别磨蹭啦，我的信都要写好了…"
        },
        {
          "role": "提米",
          "text": "你找到蒲公英了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了。"
        },
        {
          "role": "提米",
          "text": "太好了，这些就够了。"
        },
        {
          "role": "提米",
          "text": "把蒲公英籽放进信里面…然后封好…"
        },
        {
          "role": "提米",
          "text": "好啦！嘿嘿，爸爸收到这封信肯定很高兴。"
        },
        {
          "role": "提米",
          "text": "不过…我听说送信要用专业的信鸽才行…而且，我也不知道爸爸的收信地址…"
        },
        {
          "role": "提米",
          "text": "对了！我听葛瑞丝妈妈说，清泉镇的杜拉夫先生养了一批信鸽。"
        },
        {
          "role": "提米",
          "text": "而且她说，杜拉夫先生还认识我爸爸，他一定知道怎么把这封信寄出去。"
        },
        {
          "role": "提米",
          "text": "那…就拜托你再帮我跑一趟，把这封信给杜拉夫先生，拜托他寄出去给我爸爸。"
        },
        {
          "role": "提米",
          "text": "还有，不许偷看！"
        },
        {
          "type": "subtitle",
          "text": "将提米的信交给杜拉夫"
        },
        {
          "role": "杜拉夫",
          "text": "嗯？你把信送过去了吗？"
        },
        {
          "role": "旅行者",
          "text": "这是提米要寄给他爸爸的信。"
        },
        {
          "role": "杜拉夫",
          "text": "提米寄给他爸爸的信…你也应该从葛瑞丝修女那听说了吧。"
        },
        {
          "role": "杜拉夫",
          "text": "这封信是…寄不出去的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就不寄了？",
              "dialogues": [
                {
                  "role": "杜拉夫",
                  "text": "怎么想都没法寄出去吧。"
                },
                {
                  "role": "杜拉夫",
                  "text": "没办法，还是暂且由我保管起来吧。"
                }
              ]
            },
            {
              "text": "烧掉吧。",
              "dialogues": [
                {
                  "role": "杜拉夫",
                  "text": "哈哈哈，你已经很有冒险家的作风了，做起事果决高效…"
                },
                {
                  "role": "杜拉夫",
                  "text": "不过，我可不是冒险家，我只是个普通的猎人。"
                },
                {
                  "role": "杜拉夫",
                  "text": "我不会把这封信烧掉的，也不会打开，我会把它好好保管起来。"
                }
              ]
            },
            {
              "text": "我来保管。",
              "dialogues": [
                {
                  "role": "杜拉夫",
                  "text": "你保管来做什么？你不会是想，也许我的那位老朋友没死…"
                },
                {
                  "role": "杜拉夫",
                  "text": "…只要你游历的地方够多，也许还是会遇见他。"
                },
                {
                  "role": "杜拉夫",
                  "text": "我也曾经和你想的一样，甚至还付诸了行动，但是…"
                },
                {
                  "role": "杜拉夫",
                  "text": "最终我还是认清了现实，那就是我的老朋友已经永远离我而去了。"
                }
              ]
            }
          ]
        },
        {
          "role": "杜拉夫",
          "text": "好了，这封信就放在我这里…就权当它已经寄出去了吧。"
        },
        {
          "role": "杜拉夫",
          "text": "我的那位老朋友一定也会理解我的。"
        },
        {
          "role": "杜拉夫",
          "text": "谢谢你，请务必向提米保密，你一定做得到，对吧？至少…看在这些谢礼的份上。"
        }
      ]
    }
  ]
}