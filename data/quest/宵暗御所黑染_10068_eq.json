{
  "quest_id": 10068,
  "chapter_num": "堇庭华彩真说 第四幕",
  "chapter_title": "宵暗御所黑染",
  "type": "eq",
  "route": "The Palace, Dyed in Black",
  "stories": [
    {
      "story_id": 40058,
      "title": "宵暗御所黑染",
      "description": "万叶说有些事情需要调查，约大家第二天中午再见。接下来，就耐心等待到会合的时间吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往五歌仙广场"
        },
        {
          "role": "枫原万叶",
          "text": "你们来了，这样人就都到齐了。"
        },
        {
          "role": "旅行者",
          "text": "万叶，你调查得怎么样？"
        },
        {
          "role": "枫原万叶",
          "text": "昨天晚上，我拜访了曾在我家工作的一位老仆人，从他那里知道了当年整个事情的始末。"
        },
        {
          "role": "枫原万叶",
          "text": "「一心传」在我曾祖父那一代，曾经奉命依照一份古老的锻造图谱，制作一把重要的御神刀。"
        },
        {
          "role": "枫原万叶",
          "text": "虽然参与锻刀的都是很有经验的匠人，可过程却一直很不顺利，做出的刀全都是残次品。"
        },
        {
          "role": "枫原万叶",
          "text": "眼看到了最后期限，刀却依旧无法锻好，负责的刀匠们因此畏罪潜逃了。"
        },
        {
          "role": "枫原万叶",
          "text": "枫原家与社奉行展开了调查，曾祖父与神里家家主总算在海边追上了那些匠人。"
        },
        {
          "role": "枫原万叶",
          "text": "然而他们却遭到了对方的激烈抵抗，最终，没能阻止叛逃者们乘船离开。"
        },
        {
          "role": "枫原万叶",
          "text": "枫原家由于门下刀匠叛逃而受到重罚，从此便一蹶不振了。"
        },
        {
          "role": "枫原万叶",
          "text": "不仅如此，我听说神里家家主也被叛逃者所伤，再加上年事已高，不久后就过世了。"
        },
        {
          "role": "神里绫华",
          "text": "是的…因为家主过世得突然，神里家一时群龙无首，又有奸人趁机作梗，在社奉行的地位也变得岌岌可危。"
        },
        {
          "role": "神里绫华",
          "text": "此事影响深远，直至家主之位传到我父亲手上，神里家也依旧没能恢复当初的名望。"
        },
        {
          "role": "旅行者",
          "text": "原来是这样…"
        },
        {
          "role": "神里绫华",
          "text": "不过幸亏有兄长在，现在一切总算是好了起来。"
        },
        {
          "role": "枫原万叶",
          "text": "当年的锻刀失败，最终被归因为「技艺不精」，枫原家和社奉行也一直是这么认为的。"
        },
        {
          "role": "枫原万叶",
          "text": "但五歌仙的故事却似乎在暗示，失败并非因为技艺，而是因为那份图谱被人篡改过。"
        },
        {
          "role": "枫原万叶",
          "text": "神里小姐，我昨天听说，当年锻刀失败后，那份图谱就一直保存在社奉行。"
        },
        {
          "role": "枫原万叶",
          "text": "不知道你是否愿意帮这个忙？"
        },
        {
          "role": "神里绫华",
          "text": "我明白了，既然这样我先回去寻找图谱，大家稍后到神里屋敷与我汇合即可。"
        },

        {
          "type": "subtitle",
          "text": "前往神里屋敷"
        },
         {
          "type": "subtitle",
          "text": "与绫华对话"
        },
        
        {
          "role": "神里绫华",
          "text": "各位，当年那份图谱我已经找到了。"
        },
        {
          "role": "温迪",
          "text": "嗯，虽然图谱保存得不错，不过看样子至少有三四百年历史了。"
        },
        {
          "role": "派蒙",
          "text": "这么古老的图谱，还能够找出被篡改过的证据吗？"
        },
        {
          "role": "温迪",
          "text": "事到如今，我们也只能碰碰运气了。"
        },
        {
          "type": "subtitle",
          "text": "把锻造图谱浸入了水盆中，几分钟后…",
          "narration": true
        },
        {
          "role": "阿贝多",
          "text": "虽然效果不太明显，但能看出有一些字变得模糊了。"
        },
        {
          "role": "阿贝多",
          "text": "万叶，这份图谱的确被篡改过，当年有人陷害了枫原家。"
        },
        {
          "role": "枫原万叶",
          "text": "呼…不知道现在发现这个秘密，会不会已经太晚了。"
        },
        {
          "role": "枫原万叶",
          "text": "其实，我爷爷年轻时多次对曾祖父提出要重振「一心传」，结果却被曾祖父大骂不自量力。"
        },
        {
          "role": "枫原万叶",
          "text": "昨天那位老仆人说，曾祖父甚至还到社奉行，请神里家主把这份图谱拿给爷爷看，让他带手下锻成这把刀再说。"
        },
        {
          "role": "枫原万叶",
          "text": "毫无疑问爷爷也失败了，于是曾祖父便说：「你找不出其中的秘密，一心传在世上消失也是活该。」"
        },
        {
          "role": "枫原万叶",
          "text": "听了这些话，爷爷一气之下便离开了稻妻，结果就连曾祖父的最后一面都没有见到。"
        },
        {
          "role": "枫原万叶",
          "text": "现在看来，他们父子二人的争执，其实根本就没有意义。"
        },
        {
          "role": "派蒙",
          "text": "万叶…"
        },
        {
          "role": "神里绫华",
          "text": "我听说你曾祖父枫原义庆年轻时十分勤勉，可后来却不再过问锻造技艺。看来，当年的失败对他打击很大。"
        },
        {
          "role": "阿贝多",
          "text": "万叶，你曾祖父当年所说的话，真的是「你找不出其中的秘密」？"
        },
        {
          "role": "枫原万叶",
          "text": "对，那位老仆人说，那些话都是他亲耳听见，记得很清楚。"
        },
        {
          "role": "枫原万叶",
          "text": "当时我爷爷还一气之下，把曾祖父珍爱的盆栽摔坏了…"
        },
        {
          "role": "旅行者",
          "text": "阿贝多，你难道是想说…"
        },
        {
          "role": "阿贝多",
          "text": "旅行者，看来你已经明白了我的意思。"
        },
        {
          "role": "阿贝多",
          "text": "万叶，如果你的曾祖父认为是一心传技艺不精，看到儿子失败，应该会说「你能力不够」这样的话吧？"
        },
        {
          "role": "阿贝多",
          "text": "但他说的却是「你找不出其中的秘密」，这不是很奇怪吗？"
        },
        {
          "role": "枫原万叶",
          "text": "…啊！"
        },
        {
          "role": "枫原万叶",
          "text": "所以，你的意思是…我曾祖父或许早就知道，失败是因为有人从中作梗？"
        },
        {
          "role": "阿贝多",
          "text": "现有的证据显示，这种可能性很大。"
        },
        {
          "role": "枫原万叶",
          "text": "不知道各位能否跟我去一趟天领奉行？"
        },
        {
          "role": "枫原万叶",
          "text": "我之前被通缉后，家里最后剩下的那间古屋被天领奉行查抄了，那里面存放的都是我家的旧物。"
        },
        {
          "role": "枫原万叶",
          "text": "我想去询问一下那些东西的去向，如果能找到的话，说不定能发现什么线索。"
        },
        {
          "role": "派蒙",
          "text": "那我们马上出发吧。"
        },
        {
          "type": "subtitle",
          "text": "前往天领奉行府"
        },
        {
          "type": "subtitle",
          "text": "与九条裟罗对话"
        },
         {
          "role": "九条裟罗",
          "text": "你们怎么来了，难道是离岛那边发生什么事了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "不是的裟罗。",
            "我们只是来打听一件事。"
          ]
        },
        {
          "role": "枫原万叶",
          "text": "九条裟罗，不知道你是否还记得我。"
        },
        {
          "role": "九条裟罗",
          "text": "我记得，你是枫原万叶。在眼狩令期间你曾经作为要犯被通缉，不过现在那份通缉令已经撤销了。"
        },
        {
          "role": "派蒙",
          "text": "裟罗，我们想问问你，万叶家当时被天领奉行查抄后，里面的东西现在还能找到吗？"
        },
        {
          "role": "九条裟罗",
          "text": "当时查抄所得的物品现在被收在奉行所旁边的仓库里，既然枫原现在已经回到稻妻，那些东西也理应物归原主。"
        },
        {
          "role": "枫原万叶",
          "text": "不，你误会了，我这次来并不是为了讨要物品，只是因为一些私事，想要调查一下那些东西。"
        },
        {
          "role": "九条裟罗",
          "text": "我明白了，我会告知奉行所，让他们领你们进入仓库。"
        },
        {
          "role": "派蒙",
          "text": "谢谢你，裟罗！"
        },
        {
          "role": "九条裟罗",
          "text": "枫原，关于眼狩令那时…"
        },
        {
          "role": "枫原万叶",
          "text": "九条裟罗，那些事情已经过去，就不必再提了，我知道你也有自己的信念与苦衷。"
        },
        {
          "role": "九条裟罗",
          "text": "……"
        },
        {
          "role": "枫原万叶",
          "text": "不知道现在能否拜托你一件事？"
        },
        {
          "role": "九条裟罗",
          "text": "请讲。"
        },
        {
          "role": "枫原万叶",
          "text": "现在的我，并没有继续回稻妻生活的打算，家里那些东西对于我也没什么用处。"
        },
        {
          "role": "枫原万叶",
          "text": "九条，我相信你的正直，等我们调查过后，我想请你代我处理那些物品。就把它们变卖了，用所得的钱救济穷苦的百姓吧。"
        },
        {
          "role": "九条裟罗",
          "text": "好的，我会妥善处置，请你放心。"
        },

        {
          "type": "subtitle",
          "text": "前往奉行所仓库"
        },
        {
          "type": "subtitle",
          "text": "调查枫原家的旧物"
        },

        {
          "role": "浅川",
          "text": "枫原家的物品都被放在这间仓库中，只是为了节省空间，东西摆放得有些分散，实在不好意思。"
        },
        {
          "role": "浅川",
          "text": "不过相应的物品上我都做好了标记，应该不会太难找。"
        },
        {
          "role": "浅川",
          "text": "我就在门口等待各位，如果需要帮助请来找我。"
        },
        {
          "role": "行秋",
          "text": "万叶，既然东西放得很分散，我们分头寻找线索如何？"
        },
        {
          "role": "枫原万叶",
          "text": "也好，那就拜托各位了。"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },

        {
          "type": "subtitle",
          "text": "与温迪对话",
          "narration": true
        },

        {
          "role": "温迪",
          "text": "嗯，有没有呢…"
        },
        {
          "role": "旅行者",
          "text": "温迪，你在找什么？"
        },
        {
          "role": "温迪",
          "text": "你看，这里有这么多罐子，肯定会有一两个装酒的吧？"
        },
        {
          "role": "派蒙",
          "text": "喂！其他人都在帮忙，你竟然还在找酒喝？"
        },
        {
          "role": "温迪",
          "text": "哈哈哈，开个玩笑。我们已经快要找到真相了，为什么你们看起来却顾虑重重的？"
        },
        {
          "role": "派蒙",
          "text": "因为我不是很明白，万叶为什么今天就跟裟罗说要把这些东西处理掉？"
        },
        {
          "role": "派蒙",
          "text": "万一我们今天什么都没有找到…我是说万一！万叶今后不就再也没有机会寻找当年的真相了吗？"
        },
        {
          "role": "温迪",
          "text": "我知道你们很担心万叶，但我觉得，他比你们想象中要坚强。"
        },
        {
          "role": "温迪",
          "text": "万叶既然这样做了，就说明他已经做好了准备——无论我们今天能否找到答案，无论答案是什么，他都会坦然接受。"
        },
        {
          "role": "旅行者",
          "text": "这是你身为神的直觉吗？"
        },
        {
          "role": "温迪",
          "text": "与其说是直觉，不如说是因为活得比较久，所以总结出了一些识人的经验。"
        },
        {
          "role": "温迪",
          "text": "这边就交给我，你们去其他地方搜查吧。"
        },
        {
          "type": "subtitle",
          "text": "与神里绫华对话",
          "narration": true
        },
        {
          "role": "神里绫华",
          "text": "嗯…"
        },
        {
          "role": "旅行者",
          "text": "绫华，情况怎么样？"
        },
        {
          "role": "神里绫华",
          "text": "旅行者，是你啊，我正在调查这具刀座。"
        },
        {
          "role": "派蒙",
          "text": "枫原家既然是锻刀名家，这把刀应该会很值钱吧？比如说是「一心传」的杰作什么的？"
        },
        {
          "role": "神里绫华",
          "text": "不，刀座虽然是上好的木料，但摆在上面的却是一把很普通的刀。按照枫原家最后的经济状况，值钱的收藏肯定已经拿去变卖了。"
        },
        {
          "role": "神里绫华",
          "text": "这把刀没有开刃，但刀柄上倒有不少使用痕迹，说不定是枫原小时候学习剑术的时候用的。"
        },
        {
          "role": "派蒙",
          "text": "让我看看…啊，刀鞘上好像刻有一些歪歪扭扭的字！「万」…「叶」，哈，真的是万叶小时候用过的刀。"
        },
        {
          "role": "派蒙",
          "text": "好像都能想象出万叶小时候的样子了呢。"
        },
        {
          "role": "神里绫华",
          "text": "我再在附近调查一下其他东西，如果有发现的话就喊你们。"
        },

         {
          "type": "subtitle",
          "text": "与行秋对话",
          "narration": true
        },
         {
          "role": "派蒙",
          "text": "行秋，你找到什么了？"
        },
        {
          "role": "行秋",
          "text": "我找到了不少旧书。"
        },
        {
          "role": "行秋",
          "text": "这一堆都是和钢铁冶炼有关的，这一堆是讲刀具锻造流程的，这一堆都是植物花艺类的。"
        },
        {
          "role": "派蒙",
          "text": "植物花艺类的书，肯定是万叶曾祖父的吧。"
        },
        {
          "role": "旅行者",
          "text": "上面会不会有线索？"
        },
        {
          "role": "行秋",
          "text": "刚才我大致翻了一遍，没找到值得注意的东西。不过我会再仔细看看，如果有线索就马上告诉你们。"
        },

        {
          "type": "subtitle",
          "text": "与阿贝多对话",
          "narration": true
        },
        {
          "role": "阿贝多",
          "text": "哦，是你们啊。我这里目前没发现什么有价值的东西。"
        },
        {
          "role": "派蒙",
          "text": "是吗，不过这扇屏风看起来好像挺有年头了。"
        },
        {
          "role": "阿贝多",
          "text": "嗯，如果保养状态好一点的话，说不定还能卖出价钱，现在这样是肯定不行了。"
        },
        {
          "role": "阿贝多",
          "text": "我刚才检查了一下，背面有一大块没清理干净的泥土卡在布料纤维里。"
        },
        {
          "role": "阿贝多",
          "text": "泥土能和布料结合得这么紧，粘上去的时候力量很大，很有可能就是万叶的爷爷扔出去的花盆砸在了这上面。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这不算是重要发现吗？",
            "怎么说没有价值呢？"
          ]
        },
        {
          "role": "阿贝多",
          "text": "因为它并不是我们现在要找的东西。"
        },
        {
          "role": "阿贝多",
          "text": "让我想想，如果是我想要留下信息的话，一定会留在一个更特殊的东西上…"
        },
        {
          "role": "派蒙",
          "text": "阿贝多陷入思考了，我们还是不要打扰他了。"
        },

        {
          "type": "subtitle",
          "text": "到万叶所在的地方去"
        },



        {
          "role": "枫原万叶",
          "text": "这个花盆在我家已经有很长时间了，听说是曾祖父留下的。"
        },
        {
          "role": "派蒙",
          "text": "里面的植物看起来已经枯死很长时间了。"
        },
        {
          "role": "枫原万叶",
          "text": "嗯，曾祖父不再钻研锻刀技艺后，就有了养盆栽的爱好，不过他的珍藏，大多都在重病时送给了别人。"
        },
        {
          "role": "枫原万叶",
          "text": "但当时，他却唯独留下了这盆已死的植物，还留下遗言，不允许爷爷丢弃。"
        },
        {
          "role": "枫原万叶",
          "text": "爷爷因为懊悔他们父子未能和解，所以也一直原封不动地保留着它。"
        },
        {
          "role": "枫原万叶",
          "text": "不过现在想想，曾祖父专门留下它，或许另有用意。"
        },
        {
          "role": "派蒙",
          "text": "听你这么一说，这个花盆果然有些可疑。"
        },
        {
          "role": "枫原万叶",
          "text": "嗯，我们来仔细调查一下吧。"
        },
        {
          "type": "subtitle",
          "text": "在花盆底部发现了一个夹层…",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "找到啦！不过怎么只有几张白纸呢？"
        },
        {
          "role": "派蒙",
          "text": "该不会是有人已经发现了这里面的东西，把它们替换掉了吧？"
        },
        {
          "role": "阿贝多",
          "text": "我觉得并不是这样，你看，这些纸都已经发黄，肯定有些年头了。"
        },
        {
          "role": "旅行者",
          "text": "或许又要用到水了。"
        },
        {
          "role": "枫原万叶",
          "text": "你是说这些纸和神里小姐之前拿到的那张一样，上面的文字是用特殊的墨水写成的？"
        },
        {
          "role": "阿贝多",
          "text": "我和旅行者的看法一致。"
        },
        {
          "role": "派蒙",
          "text": "那我们赶快试试吧！"
        },
        {
          "role": "枫原万叶",
          "text": "奉行所外面就有水池，我去那里把这些纸沾湿。"
        },

        {
          "type": "subtitle",
          "text": "与万叶对话"
        },
         {
          "role": "枫原万叶",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "万叶，怎么样，那些纸应该不是普通的白纸吧？"
        },
        {
          "role": "枫原万叶",
          "text": "和大家猜测的一样，洒上水后，纸上确实浮现出了笔迹，那是一封我曾祖父写的信。"
        },
        {
          "role": "派蒙",
          "text": "信上说了什么？"
        },
        {
          "role": "旅行者",
          "text": "是我们可以知道的事吗？"
        },
        {
          "role": "枫原万叶",
          "text": "嗯，我会把曾祖父知道的真相也告诉大家，不过在那之前，我想先带大家去一个地方。"
        },
        {
          "role": "枫原万叶",
          "text": "大家跟我来吧。"
        },
         {
          "type": "subtitle",
          "text": "跟随万叶前往海边"
        },
        {
          "type": "subtitle",
          "text": "与万叶对话"
        },

       
        {
          "role": "神里绫华",
          "text": "枫原，为什么要带我们来这片海边？"
        },
        {
          "role": "旅行者",
          "text": "这里与信的内容有关吗？"
        },
        {
          "role": "枫原万叶",
          "text": "嗯。这片海岸，就是我曾祖父当年与神里家主追踪逃亡刀匠的踪迹，最后到达的地方。"
        },
        {
          "role": "枫原万叶",
          "text": "我们之前的推测没有错，曾祖父的确知道锻刀失败的真相。而且也就在这里，找到了陷害枫原家与雷电五传的真凶。"
        },
        {
          "role": "枫原万叶",
          "text": "那封信上是这样写的："
        },
        {
          "role": "枫原万叶",
          "text": "「致读信之人：吾枫原义庆终其一生，始终受困于某一『秘密』，而今吾已时日无多，思前想后，最终决定将此事和盘托出。」"
        },
        {
          "role": "枫原万叶",
          "text": "「当年，吾与社奉行神里大人追捕叛逃刀匠之时，并非为叛逃者所伤。事实上……」"
        },
        {
          "role": "枫原义庆",
          "text": "…是夜，我等循着线索来到岸边时，未见任何刀匠踪影，却仅有一名倾奇者现身。"
        },
        {
          "role": "枫原义庆",
          "text": "倾奇者自居幕后主使，声称已等候我等多时，扬言绝灭雷电五传。"
        },
        {
          "role": "枫原义庆",
          "text": "此人身手远非常人能敌，仅须臾之间，我等随行武士便被尽数击倒。"
        },
        {
          "role": "枫原义庆",
          "text": "神里大人身受重伤，吾则因为被劈中了头顶斗笠，才侥幸逃过一死。"
        },
        {
          "role": "枫原义庆",
          "text": "倾奇者再有一击便可取吾性命，但见吾长相，却不再攻击，而是厉声逼问吾与「丹羽」有何瓜葛。"
        },
        {
          "role": "枫原义庆",
          "text": "吾只得作答此为家父旧姓，家父失踪后，吾便被枫原主家收养。"
        },
        {
          "role": "枫原义庆",
          "text": "倾奇者听后不再言语。沉默许久，忽道：「告知她，吾名『国崩』。」随即转身离去…"
        },
       
        {
          "role": "派蒙",
          "text": "当时竟然发生了这样的事！"
        },
        {
          "role": "枫原万叶",
          "text": "对。曾祖父与神里家主死里逃生，也得知了锻造图谱曾被国崩篡改的真相。"
        },
        {
          "role": "枫原万叶",
          "text": "但由于两人的这段遭遇，神里家主担心曾祖父会被人诬陷与罪犯有瓜葛，直到弥留之际，还在告诫他千万不要说出此事。"
        },
        {
          "role": "枫原万叶",
          "text": "因为犯人说要灭绝雷电五传，曾祖父也担心那人还会回来寻仇，为了保护家人，就放弃了家业。"
        },
        {
          "role": "枫原万叶",
          "text": "他说：「身为枫原一族之长，吾深以『一心传』没落为耻；但身为人父，只求子孙平安顺遂。」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "原来他是因为担心儿子…",
            "才故意说了那些刻薄的话。"
          ]
        },
        {
          "role": "枫原万叶",
          "text": "是啊。如果爷爷当年能发现图谱的秘密，或许曾祖父就会将真相和盘托出吧。"
        },
        {
          "role": "枫原万叶",
          "text": "只可惜，他却没能听出曾祖父话中的提示。"
        },
        {
          "role": "枫原万叶",
          "text": "神里小姐，我曾祖父叙述的这些经历，看样子你也并不知情，不知道你是怎么看待这件事的。"
        },
        {
          "role": "神里绫华",
          "text": "我觉得，当年神里家主没有对我们这些后人说起这件事，或许也是基于同样的想法。"
        },
        {
          "role": "神里绫华",
          "text": "敌人既然能够篡改将军大人的图纸，还能以一敌多，身份必定极不寻常。"
        },
        {
          "role": "神里绫华",
          "text": "我最近会去和兄长商议一下，调查这个叫国崩之人的身份。我们会慎重行动，各位可以放心。"
        },
        {
          "role": "旅行者",
          "text": "万叶，那你呢？"
        },
        {
          "role": "枫原万叶",
          "text": "其实在刚读到这封信时，我的内心也起了不小的波澜，现在才终于平静下来。"
        },
        {
          "role": "枫原万叶",
          "text": "我的曾祖父在信上说，不希望后人盲目寻仇，被陈年旧事蒙蔽了双眼。"
        },
        {
          "role": "枫原万叶",
          "text": "虽然他在写这些话时可能有些不得已，但我觉得，这些话却是有道理的。"
        },
        {
          "role": "枫原万叶",
          "text": "我认为，每个人最重要的不是过去，而是现在；虽然背负着昨日的重担，但也有自己想要追寻的东西。"
        },
        {
          "role": "枫原万叶",
          "text": "所以，能了解过去的真相对于我来说已经足够了，我会像曾祖父希望的那样好好活着。"
        },
        {
          "role": "枫原万叶",
          "text": "当然了，如果当年的敌人依然存在，还想搞什么阴谋诡计的话，我也绝不会听之任之。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "不愧是万叶，很理智。",
            "不愧是万叶，很豁达。"
          ]
        },
        {
          "role": "枫原万叶",
          "text": "这只不过是我经历了此前种种之后的感悟罢了。"
        },
        {
          "role": "枫原万叶",
          "text": "大家，谢谢你们陪我找到真相。"
        },
        {
          "role": "派蒙",
          "text": "既然在这里的事情已经办完，那我们就回离岛去吧。"
        }
      ]
    },
    {
      "story_id": 40059,
      "title": "五彩光华本相",
      "description": "",
      "dialogues": [
         {
          "type": "subtitle",
          "text": "返回五歌仙广场"
        },
         {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "阿贝多",
          "text": "旅行者，派蒙，你们好啊。"
        },
        {
          "role": "派蒙",
          "text": "阿贝多，说起来最后一幅黑主的画像怎么被盖住了呀，我还想看看你画的黑主究竟长什么样子呢。"
        },
        {
          "role": "阿贝多",
          "text": "别着急，再过一会儿会举行画像的揭幕式，到时候你们就能知道了。"
        },
        {
          "role": "阿贝多",
          "text": "这幅画可是我的得意之作，为了完成它，我还专程拜访了一个人。对方给我提供了非常宝贵的建议。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "感觉越说越神秘了。",
            "听起来有点可疑。"
          ]
        },
        {
          "role": "阿贝多",
          "text": "呵呵，有吗？总之距离揭幕还有段时间，你们先在会场上逛逛吧。"
        },
        {
          "type": "subtitle",
          "text": "在会场附近寻找朋友们"
        },
        {
          "type": "subtitle",
          "text": "与行秋对话"
        },
        {
          "role": "行秋",
          "text": "旅行者，派蒙，你们来了。"
        },
        {
          "role": "旅行者",
          "text": "今天的签售顺利吗？"
        },
        {
          "role": "行秋",
          "text": "嗯，多亏了你们，签售会进行得非常顺利，读者们也都很满意。"
        },
        {
          "role": "派蒙",
          "text": "行秋，是我的错觉吗，我怎么觉得你一直在东张西望啊。"
        },
        {
          "role": "行秋",
          "text": "并不是错觉，说来惭愧，其实我一直在提防着有璃月游客靠近。"
        },
        {
          "role": "行秋",
          "text": "我毕竟是以考察商品的名头来了稻妻，若是被认得我的人看见我坐在这里，我爹那边可就瞒不住了。"
        },
        {
          "role": "行秋",
          "text": "幸好今天来排队买书的读者众多，一般游客不会靠近这边。"
        },
        {
          "role": "行秋",
          "text": "对了，其实阿旭也不知道我此行的真正目的。你们若是见了他，可要记得替我保密。"
        },
        {
          "role": "旅行者",
          "text": "好，放心吧。"
        },
        {
          "role": "行秋",
          "text": "那我先谢过你们啦。抱歉，现在不能陪你们聊太久，后面还有读者在等。"
        },
        {
          "role": "行秋",
          "text": "待会儿就在黑主画像的揭幕仪式上再见吧。"
        },
        {
          "type": "subtitle",
          "text": "与神里兄妹对话"
        },
        {
          "role": "神里绫人",
          "text": "旅行者，派蒙，你们好。"
        },
        {
          "role": "派蒙",
          "text": "哇，绫人，今天总算又见到你这个大忙人了。"
        },
        {
          "role": "神里绫人",
          "text": "这些天事情太多，实在是脱不开身。"
        },
        {
          "role": "神里绫人",
          "text": "不过所幸容彩祭一切顺利，三奉行在此次祭典上也合作顺畅，今天总算能稍作休息了。"
        },
        {
          "role": "神里绫华",
          "text": "二位，我和兄长都很感谢你们的帮助。"
        },
        {
          "role": "神里绫人",
          "text": "嗯，托马还真是慢啊…"
        },
        {
          "role": "旅行者",
          "text": "你们在等托马？"
        },
        {
          "role": "神里绫华",
          "text": "对。难得兄长说今天不忙，要带我去买书，但他却把钱包忘在了家里，于是就只好让托马回去取了。"
        },
        {
          "role": "派蒙",
          "text": "没想到绫人也会有粗心大意的时候。"
        },
        {
          "role": "神里绫华",
          "text": "呵呵，兄长平日里总是殚精竭虑，难得能离开公务放松下来。"
        },
        {
          "role": "神里绫华",
          "text": "所以，这种偶尔的粗心大意，对于我和托马来说，反而很可贵呢。"
        },
        {
          "type": "subtitle",
          "text": "与八重神子对话"
        },
        {
          "role": "八重神子",
          "text": "小家伙们，你们好呀。"
        },
        {
          "role": "派蒙",
          "text": "你们两个怎么会凑在一起！而且刚才明明聊得热火朝天，看到我们靠近，就突然不说话了。"
        },
        {
          "role": "八重神子",
          "text": "哎呀，那只是你们的错觉啦。"
        },
        {
          "role": "温迪",
          "text": "我们只是在说下酒菜的话题，你们也不感兴趣嘛。"
        },
        {
          "role": "八重神子",
          "text": "嗯，说到下酒菜啊，油豆腐我觉得就不错呢…"
        },
        {
          "role": "派蒙",
          "text": "算了算了，就算这两个人凑在一起密谋什么，也不会让我们知道的。"
        },
        {
          "type": "subtitle",
          "text": "与万叶对话"
        },
        {
          "role": "派蒙",
          "text": "万叶，你没有去会场，怎么在这里呀？"
        },
        {
          "role": "枫原万叶",
          "text": "我来这里吹吹海风。会场上那种热闹的气氛，果然还是不太适合我。"
        },
        {
          "role": "旅行者",
          "text": "万叶，你真的不要紧吗？"
        },
        {
          "role": "枫原万叶",
          "text": "呵，果然你们还是在担心我。"
        },
        {
          "role": "枫原万叶",
          "text": "谢谢你们。放心吧，我之前在大家面前说的那些话并不是托词。"
        },
        {
          "role": "枫原万叶",
          "text": "你们看，眼前这座熟悉的港口，它曾经终日不见船舶靠岸，只有勘定奉行的役人戒备着不速之客。"
        },
        {
          "role": "枫原万叶",
          "text": "但现在，这里却热闹了许多。"
        },
        {
          "role": "枫原万叶",
          "text": "不仅有从其他国家来稻妻的外国人，海祇岛和这里的往来也频繁了起来。"
        },
        {
          "role": "派蒙",
          "text": "是呀，现在的稻妻，已经和过去不同了呢。"
        },
        {
          "role": "枫原万叶",
          "text": "我想，或许我们每个人，也都像这个国度一样。"
        },
        {
          "role": "枫原万叶",
          "text": "即使需要花费的时间不同，但身上的那副重担总有能够放下的一天。"
        },
        
        

        {
          "type": "subtitle",
          "text": "额外对话（枫原万叶）"
        },
        {
          "role": "枫原万叶",
          "text": "不用担心我，好好享受祭典吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（小野寺）"
        },
        {
          "role": "小野寺",
          "text": "旅行者，多亏了你们，这次的新刊发售会才会这么成功。"
        },
        {
          "role": "聪美",
          "text": "听说枕玉老师不仅是璃月富商家的公子，而且是瞒着家里进行小说创作的，这简直就像是小说里的设定一样。"
        },
        {
          "role": "聪美",
          "text": "嗯…下次要不要以枕玉老师为原型，写一篇以小说家为主角的故事试试呢？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（勘解由小路健三郎）"
        },
        {
          "role": "勘解由小路健三郎",
          "text": "今天来买书的人可真多，虽说签名的图案不复杂，但签了那么多本，还是累得手都要抬不起来了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿贝多）"
        },
        {
          "role": "阿贝多",
          "text": "你们先在会场上逛逛吧，今天应该是容彩祭最热闹的一天了。"
        },






        {
          "type": "subtitle",
          "text": "返回五歌仙广场"
        },
        {
          "type": "subtitle",
          "text": "与主编对话"
        },
        {
          "role": "平山",
          "text": "诸位，欢迎大家参加「光华容彩祭」！"
        },
        {
          "role": "平山",
          "text": "今天，我们的祭典顺利迎来了最后一个阶段。"
        },
        {
          "role": "平山",
          "text": "接下来，我们就将为大家揭晓由蒙德画家白垩老师绘制的五歌仙画像最后一幅——黑主。"
        },
        {
          "role": "派蒙",
          "text": "好紧张啊，不知道阿贝多画了什么…"
        },
        {
          "role": "平山",
          "text": "让我们一起倒计时，三、二、一！"
        },
        {
          "role": "平山",
          "text": "这是怎么回事，这幅画上面怎么只有背景？"
        },
        {
          "role": "平山",
          "text": "白垩老师肯定不会是忘了画角色啊…"
        },
        {
          "role": "平山",
          "text": "关于这幅画像的创作理念，就让我们来采访一下白垩老师吧。"
        },
        {
          "role": "阿贝多",
          "text": "大家好，很高兴这次能够受到邀请，绘制五歌仙的画像。"
        },
        {
          "role": "阿贝多",
          "text": "五歌仙是稻妻古代的传说人物，他们曾经以诗歌闻名，同样也被写进诗篇，成为了许多故事的主角。"
        },
        {
          "role": "阿贝多",
          "text": "我从现存的资料中得知，在这些故事中，「黑主」的身份是最为丰富多样的。"
        },
        {
          "role": "阿贝多",
          "text": "而且，没有个人篇章的他，似乎却是五歌仙故事的「幕后主角」。"
        },
        {
          "role": "阿贝多",
          "text": "或许我们可以认为，每个创作者对黑主的理解都各不相同，所以，我也想把这份想象留给大家。"
        },
        {
          "role": "阿贝多",
          "text": "毕竟容彩祭，就是一个让大家通过创作，抒发心中所想的地方。"
        },
        {
          "role": "派蒙",
          "text": "真不愧是阿贝多，他这样一解释，立刻就让游客们信服了。"
        },
        {
          "role": "派蒙",
          "text": "嘻嘻，这样一来，我们在这次容彩祭上的冒险，也算是圆满结束了吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "真的吗？",
            "你是不是忘了什么？"
          ]
        },
        {
          "role": "派蒙",
          "text": "咦，忘了什么？"
        },
        {
          "role": "派蒙",
          "text": "啊…啊啊啊！对啊，那个留下五歌仙故事的人，我们到现在都还没找到呢！"
        },
        {
          "role": "旅行者",
          "text": "不过我已经有头绪了。"
        },
        {
          "role": "派蒙",
          "text": "真的吗，快说给我听听！"
        },
        {
          "role": "旅行者",
          "text": "首先，对方认识我们每个人。"
        },
        {
          "role": "派蒙",
          "text": "嗯，你说得有道理，否则就没办法每次都能把信交给合适的人。"
        },
        {
          "role": "旅行者",
          "text": "而且，对方与万叶家有关联。"
        },
        {
          "role": "派蒙",
          "text": "是哦，虽然对方一直在用故事提示我们行秋的事，可根本目的，却是为了引导我们解开万叶家的秘密…"
        },
        {
          "role": "派蒙",
          "text": "我明白啦！留下故事的，应该就是「那个家伙」了！"
        },
        {
          "role": "派蒙",
          "text": "走，我们现在就去揭开真相！"
        },

        {
          "type": "subtitle",
          "text": "找到「那个人」"
        },



        {
          "role": "派蒙",
          "text": "绫人，留下五歌仙故事的人果然就是你了。"
        },
        {
          "role": "派蒙",
          "text": "真是太过分了，明明你跟大家都认识，却故意把我们耍得团团转！"
        },
        {
          "role": "神里绫人",
          "text": "呵呵，其实我今天来这里的一个目的，就是想跟你们解释清这件事的来龙去脉。"
        },
        {
          "role": "派蒙",
          "text": "哼，我倒要看看你怎么解释。"
        },
        {
          "role": "神里绫人",
          "text": "首先，这件事的起因十分偶然，是八重大人在某天晚上，偶然看见行秋和编辑将书运走，觉得有趣，就提出要作弄一下他们。"
        },
        {
          "role": "派蒙",
          "text": "什么，原来是神子？"
        },
        {
          "role": "派蒙",
          "text": "唔，不过这确实像是神子干得出来的事情…"
        },
        {
          "role": "神里绫人",
          "text": "正是，不过后来以五歌仙故事的形式传递信息，诱导你们发现枫原家的秘密，就是我的顺水推舟了。"
        },
        {
          "role": "神里绫人",
          "text": "而我采取这种迂回的办法，确实也有不得已之处。"
        },
        {
          "role": "旅行者",
          "text": "不得已之处？"
        },
        {
          "role": "神里绫人",
          "text": "此前因为「某件事」，我留意到了枫原义庆留下的盆栽，和里面所藏匿的无字纸张。"
        },
        {
          "role": "神里绫人",
          "text": "我知道这些纸肯定不简单，但还是花了一段时间，才解开上面的秘密——就是那种遇水才能显现的墨水。"
        },
        {
          "role": "神里绫人",
          "text": "枫原义庆在信中提及之事，无论对于神里家，还是枫原家的后人都十分重要，尤其是枫原万叶。"
        },
        {
          "role": "神里绫人",
          "text": "枫原一族曾是神里家的下属，当年我的先祖未能保护好他们，到我这里，仍有义务照拂他。"
        },
        {
          "role": "神里绫人",
          "text": "虽说他有权知道真相，但接触秘密同样意味着接近危险。我必须确认，万叶是否有了解真相的「意愿」与「能力」。"
        },
        {
          "role": "神里绫人",
          "text": "我当然可以将发现的事实直接告诉他，但或许他并无这种「意愿」，那这个真相对于他只会成为负担。"
        },
        {
          "role": "神里绫人",
          "text": "同时他如果缺少相应的「能力」，就无法找到真相，如果是那样的话，还是让他远离危险比较好。"
        },
        {
          "role": "神里绫人",
          "text": "枫原义庆，也正是考虑到这一点，才一样使用了迂回的办法留下了信息。"
        },
        {
          "role": "神里绫人",
          "text": "很长一段时间，我都苦于没有合适的契机传达此事，直到《沉秋拾剑录》被偷偷运走的那天晚上。"
        },
        {
          "role": "派蒙",
          "text": "原来如此…"
        },
        {
          "role": "旅行者",
          "text": "那其他人被拉进来的意义呢？"
        },
        {
          "role": "派蒙",
          "text": "对哦，不仅是万叶，你把我们都拉进了你的计划里。"
        },
        {
          "role": "神里绫人",
          "text": "呵呵呵，看来果然瞒不过你的眼睛。"
        },
        {
          "role": "神里绫人",
          "text": "我判断知道这件事对你们也有不小的价值。"
        },
        {
          "role": "神里绫人",
          "text": "当然更重要的是，我希望万叶与绫华在找到真相的时候，身边能有一群可靠的朋友。"
        },
        {
          "role": "神里绫人",
          "text": "这些人愿意守护他们做出冷静的决定，同样，也会在他们遇到困难时不遗余力地伸出援手。"
        },
        {
          "role": "神里绫人",
          "text": "因为你们很有可能，将来会面对相同的敌人。"
        },
        {
          "role": "旅行者",
          "text": "「国崩」究竟是谁？"
        },
        {
          "role": "神里绫人",
          "text": "其实你心里已经有答案了，不是吗？"
        },
        {
          "role": "神里绫人",
          "text": "而且这个答案，就埋藏在那幅「黑主」的画像中。"
        },
        {
          "role": "神里绫人",
          "text": "等到画像附近没人的时候，你可以用自己的眼睛去确认。"
        },
        {
          "role": "神里绫人",
          "text": "至于让那个真相显露的办法…你们之前，也已经用过很多次了。"
        },

         {
          "type": "subtitle",
          "text": "返回五歌仙广场"
        },
         {
          "type": "subtitle",
          "text": "等到晚上，调查黑主的画像。"
        },
        
        {
          "role": "派蒙",
          "text": "夜深了，现在周围已经没有人了。"
        },
        {
          "role": "派蒙",
          "text": "绫人说的那个用过很多次的办法，一定就是指把水洒在这幅画上吧？"
        },
        {
          "role": "派蒙",
          "text": "画面上的人…是散兵！"
        },
        {
          "role": "派蒙",
          "text": "果然他就是当年的幕后黑手！"
        },
         {
          "type": "subtitle",
          "text": "回忆早些时间与绫人的对话"
        },
       
        {
          "role": "神里绫人",
          "text": "…最后，我们还有一件事需要谈谈。"
        },
        {
          "role": "神里绫人",
          "text": "我之前提到，「某件事」的发生让我留意到盆栽的存在，现在要讲的就是那件事。"
        },
        {
          "role": "神里绫人",
          "text": "那是将军刚刚宣布废除锁国令之后，我听说天领奉行那里发生了一起案件。"
        },
        {
          "role": "神里绫人",
          "text": "保管证物与查抄得来赃物的仓库有窃贼进入的痕迹，不过却什么东西都没有丢失。"
        },
        {
          "role": "神里绫人",
          "text": "我觉得这起案件并不寻常，于是告诉天领奉行的九条裟罗，暂时当做无事发生，不要加强戒备或将仓库换地方。"
        },
        {
          "role": "神里绫人",
          "text": "而我则派终末番的人在旁边盯梢，果然发现有个人潜入到仓库中，翻找枫原家的东西。"
        },
        {
          "role": "派蒙",
          "text": "难道说，他也是在找…"
        },
        {
          "role": "神里绫人",
          "text": "我放任他翻找了一段时间，最后他一无所获，只得乘船离开了稻妻。"
        },
        {
          "role": "派蒙",
          "text": "你为什么不派人抓住他呀？"
        },
        {
          "role": "神里绫人",
          "text": "呵呵，保护一个秘密的最好办法，就是当做这个秘密并不存在，不是吗？而且这个人的身份也并不难猜测。"
        },
        {
          "role": "神里绫人",
          "text": "在他离开稻妻后，我就认真逐件检查了枫原家的物品，终于在那个花盆的夹层里，看到了那几张纸。"
        },
        {
          "role": "神里绫人",
          "text": "我确信这些纸，就是潜入者想要寻找的「秘密」，虽然他或许也并不能确定这个「秘密」真的存在。"
        },
        {
          "role": "神里绫人",
          "text": "那么接下来，就是我的最后一个问题了——"
        },
        {
          "role": "神里绫人",
          "text": "枫原义庆所写的那段经历中，究竟哪一部分才是真正需要被保守的秘密呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "枫原义庆知道家族被陷害？",
            "枫原义庆知道犯人叫国崩？",
            "枫原义庆被对方放了一马？"
          ]
        },
        {
          "role": "神里绫人",
          "text": "呵呵呵，这个问题，我现在也没有答案，就把它留给未来的你好了。"
        },
        {
          "role": "神里绫人",
          "text": "至于现在，就好好享受容彩祭吧。"
        }
      ]
    }
  ]
}