{
  "quest_id": 75169,
  "chapter_num": null,
  "chapter_title": "觐山之路",
  "type": "wq",
  "route": "The Way Into the Mountain",
  "stories": [
    {
      "story_id": 75169,
      "title": "觐山之路",
      "description": "在刚踏入火山周围的沃野之时，就收到了不知何人的指引，需要前往火山之内。如果想要前往圣山之内的话，就找找相关的线索吧…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "受龙所选者…啊，受龙所选者啊…",
          "narration": true,
          "color": "描述1"
        },
        {
          "type": "subtitle",
          "text": "圣山就在汝之身前…如若…就须清除…阴影之敌。",
          "narration": true,
          "color": "描述1"
        },
        {
          "type": "subtitle",
          "text": "啊，受龙所选者…进入…进入圣山吧…",
          "narration": true,
          "color": "描述1"
        },
        {
          "role": "小家伙",
          "text": "呜…"
        },
        {
          "role": "派蒙",
          "text": "怎么了…咦，是想要到火山里去吗？"
        },
        {
          "role": "派蒙",
          "text": "不过如果真的要去火山的话，就得去「沃陆之邦」打探一下消息了吧！"
        },
        {
          "role": "小家伙",
          "text": "呜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刚才…火山喷发了…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没有哦，刚才火山非常安静…你们看到火山喷发了吗？"
        },
        {
          "role": "派蒙",
          "text": "怎么了，旅行者，还有小家伙，怎么一副沉思的样子…"
        },
        {
          "role": "派蒙",
          "text": "简直就像是侦探小说里突然想到了事件真相的侦探一样…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看到的是别的「真相」…",
              "dialogues": [
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "（向派蒙说明了所看到的…）",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "啊，你是说，看到了和刚进入纳塔遇到小家伙时看到的相同的东西…"
                }
              ]
            },
            {
              "text": "蛋糕杀人的凶手…就是派蒙你！",
              "dialogues": [
                {
                  "role": "小家伙",
                  "text": "呀！"
                },
                {
                  "role": "派蒙",
                  "text": "可恶，怎么会，明明我偷吃小蛋糕小姐的时候没有被任何人看到…才怪啦，我偷吃的是火焰炖肉。"
                },
                {
                  "role": "派蒙",
                  "text": "所以你…不对，你们刚才看到了什么呀？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "（向派蒙说明了所看到的…）",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "又看到了奇怪的话…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "还有一些奇怪的影像吗？"
        },
        {
          "role": "小家伙",
          "text": "嗯？"
        },
        {
          "role": "派蒙",
          "text": "在那个时候旅行者就说看到了奇怪的话…唔，我没看到所以不知道啦，感觉上，像是一个人说的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "应该是同一个人…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "未完成隐藏任务「曼科的忠告」"
        },
        {
          "role": "派蒙",
          "text": "不过，这次你们还看到…巨大的遗迹，以及深渊…"
        },
        {
          "type": "subtitle",
          "text": "完成隐藏任务「曼科的忠告」"
        },
        {
          "role": "派蒙",
          "text": "唔，感觉有点奇怪呢…不过，这次你们还看到…巨大的遗迹，破碎的城市，深渊…"
        },
        {
          "role": "派蒙",
          "text": "还有「圣山」…唔，纳塔人好像也称那座火山为「圣山」，难道说，你们看到的东西和那座火山有关？"
        },
        {
          "role": "派蒙",
          "text": "总觉得那个把小家伙交到我们手上的人好像很想让我们「进入圣山」的样子…"
        },
        {
          "type": "subtitle",
          "text": "未完成隐藏任务「曼科的忠告」"
        },
        {
          "role": "派蒙",
          "text": "难道在那里就可以解开小家伙的身世之谜…说不定还能见到它的家人…"
        },
        {
          "type": "subtitle",
          "text": "完成隐藏任务「曼科的忠告」"
        },
        {
          "role": "派蒙",
          "text": "到了圣山里以后，是不是就可以解开小家伙身上的那个什么「焰主之祝」了…"
        },
        {
          "role": "小家伙",
          "text": "呀！"
        },
        {
          "type": "subtitle",
          "text": "未完成隐藏任务「曼科的忠告」"
        },
        {
          "role": "派蒙",
          "text": "总之…我们就留意一下火山相关的情报吧。"
        },
        {
          "role": "派蒙",
          "text": "对了，纳塔六个部族中的「沃陆之邦」好像就在火山的一侧，说不定可以在那里打探消息！"
        },
        {
          "type": "subtitle",
          "text": "完成隐藏任务「曼科的忠告」"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，为了小家伙能够健康长大！之后我们就去那个「圣山」看看吧。"
        },
        {
          "role": "派蒙",
          "text": "对了，纳塔六个部族中的「沃陆之邦」好像就在火山的一侧，说不定可以在那里打探到消息呢！"
        },
        {
          "type": "subtitle",
          "text": "与？？？对话"
        },
        {
          "role": "？？？（度尼娅）",
          "text": "圣山大人因为肚子不舒服，每天都在往外吐那么多东西，你又不是没见过！现在出去玩太危险了！"
        },
        {
          "role": "？？？（杜兹厄）",
          "text": "以前叔叔给我讲的故事里都说了，每次遇到火山不舒服的时候，只要大伙用力拍两下就好了…只可惜我的手太小了…"
        },
        {
          "role": "？？？（杜兹厄）",
          "text": "但是那些大人们肯定能拍得动，就是不想我们到部族外去玩，所以才拖着不去拍。"
        },
        {
          "role": "？？？（度尼娅）",
          "text": "哈哈，杜兹厄原来是这样想的呀！哼哼，可是要让圣山大人恢复正常，就得…至少得部族里所有的大人一起拍才行。"
        },
        {
          "type": "subtitle",
          "text": "已完成魔神任务：第五章．第四幕「命定将焚的虹光」"
        },
        {
          "role": "？？？（度尼娅）",
          "text": "可大人们都是很忙的，就比如瓦雷莎姐姐，还得照顾果园呢。得等到大家都有空的时候，一起拍拍圣山大人呀…"
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务第五章．第四幕「命定将焚的虹光」"
        },
        {
          "role": "？？？（度尼娅）",
          "text": "可大人们都是很忙的，就比如瓦雷莎姐姐，还得照顾果园呢。得等到大家都有空的时候，一起拍拍圣山大人呀。"
        },
        {
          "role": "杜兹厄",
          "text": "你说的也不是没有道理…唉，得等大人们都有空呀…"
        },
        {
          "role": "？？？（度尼娅）",
          "text": "嗯嗯，所以在那之前，我们就遵守大人们的禁足令，在圣山大人活动这么激烈的时期好好待在部族里吧…"
        },
        {
          "role": "杜兹厄",
          "text": "…好吧。"
        },
        {
          "role": "派蒙",
          "text": "你们在这说什么呀，什么拍不拍的？"
        },
        {
          "type": "subtitle",
          "text": "已完成魔神任务：第五章．第四幕「命定将焚的虹光」"
        },
        {
          "role": "杜兹厄",
          "text": "我们在说…啊…金发的，还有银色的小精灵…是大英雄旅行者和派蒙。"
        },
        {
          "role": "杜兹厄",
          "text": "我、我们在聊一些很重要很重要的部族秘密呢！"
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务第五章．第四幕「命定将焚的虹光」"
        },
        {
          "role": "杜兹厄",
          "text": "我们在说…啊…"
        },
        {
          "role": "杜兹厄",
          "text": "我们在说不能被奇怪的异邦人听进耳朵里的部族秘密。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来手拍火山是部族秘密啊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "杜兹厄",
          "text": "什、什么呀，你们不是全听进去了吗。"
        },
        {
          "role": "？？？（度尼娅）",
          "text": "是杜兹厄你讲得太大声了啦，下次要说秘密，就得把嘴巴贴到我耳朵边上说哦。"
        },
        {
          "role": "杜兹厄",
          "text": "好哦…咦，可是那样不会靠、靠得太近了吗？！"
        },
        {
          "type": "subtitle",
          "text": "已完成魔神任务：第五章．第四幕「命定将焚的虹光」"
        },
        {
          "role": "度尼娅",
          "text": "哈哈，好啦。嗯…异邦来的大英雄，我是度尼娅，这个家伙是笨蛋杜兹厄…"
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务第五章．第四幕「命定将焚的虹光」"
        },
        {
          "role": "度尼娅",
          "text": "哈哈，好啦。嗯…异邦来的客人，我是度尼娅，这个家伙是笨蛋杜兹厄…"
        },
        {
          "role": "杜兹厄",
          "text": "又叫我笨蛋…"
        },
        {
          "role": "度尼娅",
          "text": "欢迎你们来到沃陆之邦，还有这边的小嵴锋龙…奇怪，难道是因为圣山大人的状态不对吗…部族里应该有禁外龙的符石…"
        },
        {
          "role": "杜兹厄",
          "text": "哼哼，这就说明符石也该被拍一拍啦！"
        },
        {
          "type": "subtitle",
          "text": "已完成魔神任务：第五章．第四幕「命定将焚的虹光」"
        },
        {
          "role": "度尼娅",
          "text": "现在比较需要被拍拍的是杜兹厄的脑袋瓜…不过没想到，大英雄会到「沃陆之邦」来呢…"
        },
        {
          "role": "度尼娅",
          "text": "是有什么需要帮助的事吗？"
        },
        {
          "type": "subtitle",
          "text": "向度尼娅和杜兹厄说明了想要进入圣山的目的…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务第五章．第四幕「命定将焚的虹光」"
        },
        {
          "role": "度尼娅",
          "text": "现在比较需要被拍拍的是杜兹厄的脑袋瓜…唉，幸好你们看上去不是什么坏人呢…"
        },
        {
          "role": "度尼娅",
          "text": "所以异邦来的客人是为了什么来的呀…"
        },
        {
          "type": "subtitle",
          "text": "向度尼娅和杜兹厄做了自我介绍…\n并且说明了想要进入圣山的目的…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "度尼娅",
          "text": "想要「进入圣山」啊，那可不是容易的事呢…大人们还告诫我们，圣山是危险的地方，所以不能轻易进入…"
        },
        {
          "type": "subtitle",
          "text": "已完成魔神任务：第五章．第四幕「命定将焚的虹光」"
        },
        {
          "role": "度尼娅",
          "text": "不过，如果是旅行者想要进入圣山内，想必也有自己的理由吧…"
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务第五章．第四幕「命定将焚的虹光」"
        },
        {
          "role": "度尼娅",
          "text": "不过，异邦来的客人想要进入圣山内，想必也有自己的理由吧…"
        },
        {
          "role": "度尼娅",
          "text": "嗯…我倒是知道有人曾经进过圣山…"
        },
        {
          "role": "杜兹厄",
          "text": "我、我也知道呢！"
        },
        {
          "role": "派蒙",
          "text": "咦，那个「圣山」不是对于部族人来说很重要的地方吗？这样随便告诉我们真的好吗？"
        },
        {
          "role": "度尼娅",
          "text": "「圣山」的称呼是很久很久以前的织卷留下来的…对我们来说，还是「圣火竞技场」要更「圣」一筹呢。"
        },
        {
          "role": "度尼娅",
          "text": "我们被禁止进入只是因为里面比较危险啦。"
        },
        {
          "role": "杜兹厄",
          "text": "而且，以前「话事处」也组建过探险队进火山里…嘿嘿，等我长大了，我也要进去玩！"
        },
        {
          "role": "度尼娅",
          "text": "说了多少次，那是很危险的事啦…"
        },
        {
          "role": "度尼娅",
          "text": "嗯…具体的事我也不太清楚，不过，如果你愿意的话可以找{{颜色|蓝|恩波索爷爷}}，他要是能帮上你的忙，应该也会很高兴的。"
        },
        {
          "role": "杜兹厄",
          "text": "「无所事事的恩波索爷爷」吗…找他还不如去找{{颜色|蓝|基莫西}}呢，嘿嘿，基莫西是我叔叔，以前也曾经参加过冒险队…"
        },
        {
          "role": "度尼娅",
          "text": "不许说恩波索爷爷无所事事…唔，但是，他们现在一个在{{颜色|蓝|山南的挖掘地}}，一个在{{颜色|蓝|村子西边的喷发遗迹}}那边…"
        },
        {
          "role": "度尼娅",
          "text": "要是能够帮你们带路就好了，只不过现在圣山大人还在「喷吐」的时期…我们不能带你们去…"
        },
        {
          "role": "派蒙",
          "text": "没关系，告诉我们这些就已经足够啦！"
        },
        {
          "role": "派蒙",
          "text": "小家伙！回来啦，我们要出发了！"
        },
        {
          "role": "小家伙",
          "text": "呀！"
        },
        {
          "role": "度尼娅",
          "text": "嘿嘿，真是可爱的家伙，尾巴上绑的丝巾也很漂亮。等圣山大人睡着了，到时候一起去部族外面玩吧！"
        },
        {
          "role": "派蒙",
          "text": "好哦，下次我们再一起玩！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（度尼娅&杜兹厄）"
        },
        {
          "type": "subtitle",
          "text": "初次对话"
        },
        {
          "role": "度尼娅",
          "text": "哎呀，异邦的英雄，还有什么事吗？"
        },
        {
          "role": "杜兹厄",
          "text": "一定是找不到「挖掘地」和「喷发遗迹」，既然如此，我们也只能稍稍违背大人们的禁令…"
        },
        {
          "role": "度尼娅",
          "text": "……"
        },
        {
          "role": "杜兹厄",
          "text": "呜，好吧…我不会出部族的…"
        },
        {
          "type": "subtitle",
          "text": "再次对话"
        },
        {
          "role": "度尼娅",
          "text": "那么，旅行者…有什么想问的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「挖掘地」…",
              "dialogues": [
                {
                  "role": "度尼娅",
                  "text": "嗯，其实挖掘地应该被称为「秘源遗迹的挖掘地」，就在圣山的南侧，有一大片遗迹…"
                },
                {
                  "role": "度尼娅",
                  "text": "据说也是很久很久以前的巨龙留下来的呢，为了防止有不怀好意的盗宝团偷偷发掘遗迹，恩波索爷爷每天会在那边巡逻…"
                },
                {
                  "role": "度尼娅",
                  "text": "从前恩波索爷爷就对这些遗迹啊，遗物什么的特别上心，还加入过龙遗物研究协会，每次都会和我们说过去的故事。"
                },
                {
                  "role": "杜兹厄",
                  "text": "不过，恩波索爷爷讲故事的水平好差，而且都很枯燥无聊，什么从遗迹的什么纹路上就能看出什么图腾「葱白」…"
                },
                {
                  "role": "度尼娅",
                  "text": "是图腾「崇拜」啦…因为恩波索爷爷比起叙事人更像是个考古家嘛…"
                },
                {
                  "role": "度尼娅",
                  "text": "据说，恩波索爷爷以前也曾经探索过火山内，说不定能帮上你们的忙呢！"
                }
              ]
            },
            {
              "text": "关于「喷发遗迹」…",
              "dialogues": [
                {
                  "role": "杜兹厄",
                  "text": "哦哦，你想问「喷发遗迹」的事啊！这个我知道！"
                },
                {
                  "role": "杜兹厄",
                  "text": "很久很久以前…那个时候，纳塔还是一片安静祥和的乐土…"
                },
                {
                  "role": "度尼娅",
                  "text": "啊，其实就是五百年前，纳塔受到深渊侵蚀最严重的时候，从火山里整个喷发出来的遗迹，很完整呢！"
                },
                {
                  "role": "杜兹厄",
                  "text": "啊…什么嘛，度尼娅，为什么要抢我的话！"
                },
                {
                  "role": "度尼娅",
                  "text": "因为每次杜兹厄说起喷发遗迹就得从很久很久之前开始说起，太啰嗦了。"
                },
                {
                  "role": "杜兹厄",
                  "text": "呜…这些都是基莫西叔叔和我说的啦，基莫西叔叔也是之前「话事处」组建探索团的成员之一呢！"
                },
                {
                  "role": "杜兹厄",
                  "text": "不过听说最近「喷发遗迹」附近又有些深渊的痕迹，不知道基莫西叔叔还好不好…"
                },
                {
                  "role": "杜兹厄",
                  "text": "如果你去「喷发遗迹」的话，能不能帮我和基莫西叔叔问好呢…"
                }
              ]
            },
            {
              "text": "不，没什么事了。",
              "dialogues": [
                {
                  "role": "度尼娅",
                  "text": "是嘛，那就祝你的旅途顺利啦！"
                },
                {
                  "role": "杜兹厄",
                  "text": "嘿嘿，要常来玩哦！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找进入圣山的方法"
        },
        {
          "role": "派蒙",
          "text": "挖掘地和喷发遗迹…要先去哪边呢…"
        },
