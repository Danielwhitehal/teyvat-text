{
  "quest_id": 71125,
  "chapter_num": null,
  "chapter_title": "振晶，归来仍是振晶",
  "type": "wq",
  "route": "\"Vibro-Crystals. It's Always Vibro-Crystals...\"",
  "stories": [
    {
      "story_id": 71125,
      "title": "振晶，归来仍是振晶",
      "description": "两位枫丹的工程师似乎正在璃月进行着什么深奥的研究…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与枫丹工程师对话"
        },
        {
          "role": "？？？",
          "text": "帕特里克，收手吧！我们现在做实验的方向已经完全违背科学院里的指示了…"
        },
        {
          "role": "帕特里克",
          "text": "科学院的指示，你是说审批文件上那个「项目需要更具经济效益前景的技术落地」？"
        },
        {
          "role": "帕特里克",
          "text": "他们不就是想知道能不能卖钱，别管那个，我们需要的，就是继续实验并且收集数据，阿纳托尔，再给我点经费买振晶…"
        },
        {
          "role": "阿纳托尔",
          "text": "没那么多经费了，用完这笔经费，你要从哪里弄来摩拉请人下场做实验？你自己下场？"
        },
        {
          "role": "帕特里克",
          "text": "还记得吗，阿纳托尔，「出外实验的研究监督员，在必要时刻也需要协助研究者进行研究…」"
        },
        {
          "role": "帕特里克",
          "text": "下场实验的事，就交给你了。而且，我记得你有挺可观的一笔差旅费吧，不如少吃几顿饭…"
        },
        {
          "role": "阿纳托尔",
          "text": "哇，你省经费的打算都打到同僚身上了，帕特里克，你好狠的心啊！这钱我要用来去吃腌笃鲜的，必不能交给你这恶毒的家伙！"
        },
        {
          "role": "派蒙",
          "text": "是啊！事可以少做，饭怎么可以少吃！"
        },
        {
          "role": "阿纳托尔",
          "text": "说得对。"
        },
        {
          "role": "阿纳托尔",
          "text": "哦，我就说嘛，能说出如此深刻的真知灼见，原来是大名鼎鼎的…"
        },
        {
          "role": "派蒙",
          "text": "对，我就是大名鼎鼎的派蒙！"
        },
        {
          "role": "阿纳托尔",
          "text": "那这位就是大名鼎鼎的旅行者了吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "对，我就是大名鼎鼎的我！",
              "dialogues": []
            },
            {
              "text": "那我要比大名鼎鼎再有名一点。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你在这里攀比什么啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "阿纳托尔",
          "text": "总之，正如派蒙所说，怎么可以省吃饭的钱！"
        },
        {
          "role": "帕特里克",
          "text": "那怎么办，如果没钱做实验，落地的就不是所谓的「更具经济效益的研究前景」，而是我「悲惨的人生前景」了。"
        },
        {
          "role": "帕特里克",
          "text": "唉…"
        },
        {
          "role": "派蒙",
          "text": "啊，我刚才还在想，你们这两个枫丹人在这边做什么呢！"
        },
        {
          "role": "派蒙",
          "text": "原来你们是在这里进行什么「钱井」的研究。难、难道是不停地从地上冒出摩拉的井？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哇，请给我也打一口。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "帕特里克",
          "text": "哪有这样的井啊！不过，我相信，我研究项目的「前景」最终一定能变成这样的「钱井」…"
        },
        {
          "role": "阿纳托尔",
          "text": "但是首先得解决经费的问题。还有，就是要设计出能够大卖的发明。"
        },
        {
          "role": "帕特里克",
          "text": "咳咳，伟大的发明通常只是伟大研究的副产物…在进行研究的时候，奇妙发明的想法就会像鳐鱼一样自己从脑回溜出来……"
        },
        {
          "role": "阿纳托尔",
          "text": "最好是能。"
        },
        {
          "role": "派蒙",
          "text": "等等，听你们说我都觉得有点好奇了，到底是什么研究呀？"
        },
        {
          "role": "帕特里克",
          "text": "是关于特殊的名为「振晶」的矿石研究，「振晶」是从前在测试不同矿石性质时发现的璃月矿石。"
        },
        {
          "role": "帕特里克",
          "text": "「振晶」分为两类，一类名为「响振晶」，一类名为「应振晶」。"
        },
        {
          "role": "帕特里克",
          "text": "「响振晶」受到特定的刺激后，可以放出能量，激发「应振晶」的共鸣，由此可以产生一些特殊效果。"
        },
        {
          "role": "阿纳托尔",
          "text": "这种现象虽然是很有趣啦，不过枫科院对于矿石研究因为…因为一些特殊原因已经不像之前一样热衷。"
        },
        {
          "role": "阿纳托尔",
          "text": "而雷蒙多先生觉得这个研究项目没什么「经济效益」，说白了：并不能卖钱。"
        },
        {
          "role": "帕特里克",
          "text": "肤浅！"
        },
        {
          "role": "阿纳托尔",
          "text": "唉，总之帕特里克在申请经费的时候理所当然地遭受了搪塞，经费没要到，只要到一个荣誉头衔。"
        },
        {
          "role": "帕特里克",
          "text": "我本来以为至少可以用这个荣誉头衔作为信用证明去北国银行临时借点摩拉…"
        },
        {
          "role": "帕特里克",
          "text": "结果北国银行的柜员一听我是枫丹科学院的工程师，嘴角的笑容就像春日的雪一般消融了。"
        },
        {
          "role": "阿纳托尔",
          "text": "这招院里的人已经用烂了，你能借得到才奇怪。"
        },
        {
          "role": "阿纳托尔",
          "text": "所以正如两位所见，经费也见底了，实验也请不到冒险家来做…设计发明的思路也一点没有。"
        },
        {
          "role": "阿纳托尔",
          "text": "不过也确实，一边要准备程序繁琐的实验和实验场地，一边还要设计发明，还在没有经费的异乡，实在是有点困难。"
        },
        {
          "role": "派蒙",
          "text": "这样啊，旅行者，不如我们来帮忙吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哦，派蒙要成为大发明家了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "发明的事情我搞不懂啦，但是说不定我们可以承担做实验的部分？"
        },
        {
          "role": "帕特里克",
          "text": "真、真的可以吗？"
        },
        {
          "type": "subtitle",
          "text": "未完成世界任务「枫丹科学院纪事」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕竟我是经验丰富的冒险家。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿纳托尔",
          "text": "那，实验就拜托两位了，旅行者和派蒙！研究项目的存亡，在此一举。"
        },
        {
          "type": "subtitle",
          "text": "完成世界任务「枫丹科学院纪事」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕竟我是荣誉高级研究员。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿纳托尔",
          "text": "这、这可真是令人惊讶，没想到我们科学院发荣誉头衔都已经发到这里来了…"
        },
        {
          "role": "帕特里克",
          "text": "就凭这位想要帮助做实验的热心肠，就值得十个八个荣誉头衔。"
        },
        {
          "role": "帕特里克",
          "text": "快，阿纳托尔，快把你的差旅费拿出来吧。"
        },
        {
          "role": "阿纳托尔",
          "text": "好吧，不过我愿意支出的是旅行者和派蒙帮助实验的部分…"
        },
        {
          "role": "阿纳托尔",
          "text": "其他的我就得看帕特里克你的产品设计案再做决定了。"
        },
        {
          "role": "帕特里克",
          "text": "也行也行，至少实验能先继续…"
        },
        {
          "role": "帕特里克",
          "text": "那，实验就拜托两位了，旅行者和派蒙！研究项目的存亡，在此一举。"
        },
        {
          "role": "派蒙",
          "text": "嗯，交给我们，你们就放心吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（帕特里克&阿纳托尔）"
        },
        {
          "role": "帕特里克",
          "text": "能赚钱的应用场景！我想到了！"
        },
        {
          "role": "帕特里克",
          "text": "你看，只要把「应振晶」与控制灯亮暗的拉绳机关做个绑定，在远处激发「响振晶」就能关闭吊灯了！"
        },
        {
          "role": "阿纳托尔",
          "text": "这个和「应振晶」协同的拉绳机关想必造价不菲吧。"
        },
        {
          "role": "帕特里克",
          "text": "技术应用初期，成本总归还是高昂的，但是只要用的人更多，有更多的生产线，成本就会逐渐下降。"
        },
        {
          "role": "阿纳托尔",
          "text": "但是…比起用你这个机关，直接把拉绳延长不是既便宜又有同样的效果？"
        },
        {
          "role": "帕特里克",
          "text": "那…那，下一个，把「应振晶」绑定在很容易丢失的物件上，只要触发「响振晶」，就能够找到那些不知道被丢在哪的物件。"
        },
        {
          "role": "阿纳托尔",
          "text": "好想法，但是如果我找不到「响振晶」了呢…"
        },
        {
          "role": "帕特里克",
          "text": "那就在「响振晶」上再绑个「应振晶」…还能赚双倍的钱，你真是个天才阿纳托尔。"
        },
        {
          "role": "阿纳托尔",
          "text": "我是不是个天才，我不知道，但显然你离这个词还有点距离。唉，帕特里克，还是给点靠谱方案吧。"
        },
        {
          "role": "帕特里克",
          "text": "唔…"
        }
      ],
      "collapse_ranges": [
        [
          54,
          64
        ]
      ]
    }
  ]
}