{
  "quest_id": 77210,
  "chapter_num": null,
  "chapter_title": "沉船驶过，没有敲钟",
  "type": "wq",
  "route": "The Sunken Ship Sailed Past, Ringing No Bells",
  "stories": [
    {
      "story_id": 77210,
      "title": "沉船驶过，没有敲钟",
      "description": "一座冰上的木屋停在水面。这似曾相识的木屋里，或许正有一位老熟人驻足。他又遇到麻烦了吗？过去确认一下情况吧…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "靠近冰上的木屋"
        },
        {
          "type": "subtitle",
          "text": "与丘尔卡图林对话"
        },
        {
          "role": "冰上的木屋",
          "text": "我听到了脚步声，岸上的旅者。请您停一停，劳驾。"
        },
        {
          "role": "派蒙",
          "text": "啊，果然是这个房子，我没记错，里面有个三百年没出来的家伙！他上次用的也是这句开场白。"
        },
        {
          "role": "丘尔卡图林",
          "text": "我记得这个声音。曾解救我于倒悬的旅者。我们果然再次相遇了。"
        },
        {
          "role": "旅行者",
          "text": "这次也需要我帮忙吗？"
        },
        {
          "role": "丘尔卡图林",
          "text": "劳驾，如您愿意再次伸出援手。"
        },
        {
          "role": "丘尔卡图林",
          "text": "那么，请您想办法将房屋牵引到加固材料附近吧。"
        },
        {
          "role": "派蒙",
          "text": "加固材料…那是什么东西呀？"
        },
        {
          "role": "丘尔卡图林",
          "text": "您是否见到四散于水面的木箱？这些木箱里面，便是我在这段时间的漂荡中，有意收集的材料。"
        },
        {
          "role": "丘尔卡图林",
          "text": "是的，我已决意对我的栖息地——这冰上的房屋，进行简单的扩建。"
        },
        {
          "role": "丘尔卡图林",
          "text": "岸上的旅者，你们曾说，道谢应当当面进行，才不算失了礼数。"
        },
        {
          "role": "丘尔卡图林",
          "text": "自上次湖岸一别，我便开始思量：倘若再度得到旅者的帮助，要如何道谢才能显得体面？"
        },
        {
          "role": "丘尔卡图林",
          "text": "踏上至冬的土地，于我绝无可能。但若是岸上的旅者愿意踏足这间房屋，我便能亲自接待，聊表谢意。"
        },
        {
          "role": "旅行者",
          "text": "所以你要扩建这间木屋？"
        },
        {
          "role": "丘尔卡图林",
          "text": "您说的不错，旅者。若以当下这房屋将客人招待，未免太过狭窄、寒酸，显得小家子气…"
        },
        {
          "role": "丘尔卡图林",
          "text": "人们或会据此认为：我们的被遗忘，本就是历史的必然。只瞧瞧这房屋吧，这过去王国的最后象征，竟然毫不光鲜。"
        },
        {
          "role": "丘尔卡图林",
          "text": "为了我们最后的尊严，别叫人家觉得我们这些旧日的幽灵不懂得何为体面，扩建是必须的。"
        },
        {
          "role": "丘尔卡图林",
          "text": "但这些材料，这些木箱，因为我的判断失误，如今四散在不大理想的位置上。"
        },
        {
          "role": "丘尔卡图林",
          "text": "我无法控制房屋的航向，只能劳烦您将它<color=cyan>牵引至木箱旁</color>。"
        },
        {
          "type": "subtitle",
          "text": "收集加固材料"
        },
        {
          "type": "subtitle",
          "text": "收集加固材料"
        },
        {
          "type": "subtitle",
          "text": "收集加固材料"
        },
        {
          "type": "subtitle",
          "text": "与丘尔卡图林对话"
        },
        {
          "role": "丘尔卡图林",
          "text": "感激不尽，岸上的旅者。您的襄助，我都将铭记于心。"
        },
        {
          "role": "派蒙",
          "text": "哼哼，小事一桩！不过话说回来，我们能进去看看了吗？"
        },
        {
          "role": "丘尔卡图林",
          "text": "实在抱歉，房屋的扩建和修缮尚且还需要一些时日…"
        },
        {
          "role": "丘尔卡图林",
          "text": "待到一切完成，倘若还能再会，岸上的旅者，请务必赏光。"
        },
        {
          "role": "旅行者",
          "text": "还会再见吗？"
        },
        {
          "role": "丘尔卡图林",
          "text": "我想会的，两位，如果命运已经让我们两次相逢…"
        },
        {
          "role": "丘尔卡图林",
          "text": "比方说，也许有一天，水流会再度带着这间房屋漂向近海。而如果命运要令你们踏过冰雪，驻足于边岸…"
        },
        {
          "role": "丘尔卡图林",
          "text": "如果我们再度相遇，而这房屋又已修缮完毕，那么届时，请您务必赏光莅临。"
        }
      ]
    }
  ]
}