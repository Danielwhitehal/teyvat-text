{
  "quest_id": 75029,
  "chapter_num": null,
  "chapter_title": "向前冲！冲！冲！",
  "type": "wq",
  "route": "Charge Forward! Go, Go, Go!",
  "stories": [
    {
      "story_id": 75029,
      "title": "向前冲！冲！冲！",
      "description": "「爸爸，勇士们都很高大，又有力气，真羡慕他们。」\\n「确实很多勇士天生拥有强健的肉体，不过也有那种个子小、力气也不是很大的勇士，他们一点不比我训练出的那些高个子勇士差。」",
      "dialogues": [
        {
          "role": "马塔伽",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好？",
              "dialogues": []
            },
            {
              "text": "你好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马塔伽",
          "text": "哈哈哈哈哈哈！！"
        },
        {
          "role": "派蒙",
          "text": "呜哇，吓人一跳。"
        },
        {
          "role": "马塔伽",
          "text": "会来到这里，你们也是想要参与特训吧？！"
        },
        {
          "role": "马塔伽",
          "text": "果然，人也好，龙也好，拥有进取心的勇士会互相吸引！！"
        },
        {
          "role": "马塔伽",
          "text": "不要浪费时间了，我们现在就来进行特训吧！！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "果然这里也有…",
              "dialogues": []
            },
            {
              "text": "什么特训？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我们还什么都没说呢，怎么突然就变成来参与特训的了。"
        },
        {
          "role": "派蒙",
          "text": "不过这个口气，难道你是训练大师之类的人物？"
        },
        {
          "role": "马塔伽",
          "text": "训练大师也不是谁都可以做，我倒不是那么厉害的角色…"
        },
        {
          "role": "马塔伽",
          "text": "但你们从下面一口气飞到这里，原来不是为了参加我马塔伽的勇士特训吗？！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只是路过看看。",
              "dialogues": []
            },
            {
              "text": "别小看冒险家的好奇心。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马塔伽",
          "text": "明明有驭龙飞行的基本水平，却没有进取心，浪费！"
        },
        {
          "role": "马塔伽",
          "text": "本来以为是志同道合的勇士…可惜！"
        },
        {
          "role": "马塔伽",
          "text": "我竟然误判了…可耻！"
        },
        {
          "role": "派蒙",
          "text": "该说纳塔不愧是英雄的国度，还是说纳塔人均热血含量超标呢，连小朋友都这么积极。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小朋友，不至于不至于。",
              "dialogues": []
            },
            {
              "text": "你有点极端了，小朋友。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马塔伽",
          "text": "大错特错，决定了要成为勇士不能放任自己懒散！没气魄、没胆量、没志向的人绝对不可能成功！"
        },
        {
          "role": "马塔伽",
          "text": "而且我已经十二岁了，从年龄突破一位数的那天起我就告别了「小朋友」这个称呼，不过我原谅你们。"
        },
        {
          "role": "马塔伽",
          "text": "怎么喝牛奶也不松动的不过是我的身高，不会折断不会弯曲、能斩断一切阻碍的是我的意志！"
        },
        {
          "role": "马塔伽",
          "text": "况且，我的个子还会再长，你们俩的个子不也算不上高吗？"
        },
        {
          "role": "派蒙",
          "text": "好、好热血的发言，但为什么突然拐到我们身上？"
        },
        {
          "role": "马塔伽",
          "text": "哼，虽然不得不承认肉体力量受体型影响，但勇士怎么会受区区肉体限制！"
        },
        {
          "role": "马塔伽",
          "text": "精神的高大远远胜过肉体的高大，所以要有足够的信念，必须相信怀抱着远大梦想的自己！"
        },
        {
          "role": "马塔伽",
          "text": "这种浅显的道理，就算是冒险家也能理解吧！"
        },
        {
          "role": "派蒙",
          "text": "说的是没错，但我总觉得，他刚才…是不是骂了我们？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是的。",
              "dialogues": []
            },
            {
              "text": "怎么骂人呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马塔伽",
          "text": "我在向懒散的你们解释志气的必要性，悠闲又怠惰，怎么可能成为英雄？！"
        },
        {
          "role": "马塔伽",
          "text": "作为勇士，不…作为一个人类，没有光荣的志向，没有在训练场上挥洒过汗水，就是失败！！"
        },
        {
          "role": "马塔伽",
          "text": "不能以英勇的姿态翱翔于天空，不能被训练大师们认可，就是失败！！"
        },
        {
          "role": "马塔伽",
          "text": "所以必须努力训练！你们明白了吗？！"
        },
        {
          "role": "派蒙",
          "text": "明、明白了！怎么办？他嗓门好大，听起来好有道理，我竟然无法反驳。"
        },
        {
          "role": "马塔伽",
          "text": "很好，准备好磨砺的话就来找我进行特训！目标是：尽全力沿固定赛道驭龙飞行并得到尽可能高的分数。"
        },
        {
          "role": "马塔伽",
          "text": "我会观察训练者在每个赛道节点的表现，然后打分。最终成绩按照分数高低分四档。"
        },
        {
          "role": "马塔伽",
          "text": "使劲飞！就算达不到最高档评价，至少也要达到第二好的评价档！"
        },
        {
          "role": "马塔伽",
          "text": "燃烧你的意志，追上我的影子，向前冲！冲！冲！"
        },
        {
          "role": "马塔伽",
          "text": "……"
        },
        {
          "role": "马塔伽",
          "text": "勇士，我在等你的回答！！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "明、明白了！",
              "dialogues": [
                {
                  "role": "马塔伽",
                  "text": "再大声点！！"
                },
                {
                  "role": "旅行者",
                  "text": "明白了！！"
                },
                {
                  "role": "马塔伽",
                  "text": "这里是有抱负的未来勇士们用来自我磨炼的地方，拿出魄力来，不断挑战这个世界！"
                },
                {
                  "role": "马塔伽",
                  "text": "准备好了就来找我进行训练！"
                }
              ]
            },
            {
              "text": "明白了！但是我不想训练！！",
              "dialogues": [
                {
                  "role": "马塔伽",
                  "text": "什么？都说到这种程度了还是没办法抛弃自己的惰性吗！！"
                },
                {
                  "role": "马塔伽",
                  "text": "这很糟糕，但是没关系，总有一天你们会无法忍受自己的失败！"
                },
                {
                  "role": "马塔伽",
                  "text": "永远逃避、永远退缩就什么都不会拥有！只有奋力前进才能站着大笑！"
                },
                {
                  "role": "马塔伽",
                  "text": "哼，记住我的话，等到那个时候，再来这里磨砺自己，也不算晚。"
                }
              ]
            }
          ]
        },
        {
          "role": "马塔伽",
          "text": "勇士，你超越了我，可喜可贺！不过想要成为更加伟大的英雄，就不可以懈怠，继续奋斗吧！"
        },
        {
          "type": "subtitle",
          "text": "开启特训！！"
        },
        {
          "type": "subtitle",
          "text": "与马塔伽对话"
        },
        {
          "role": "马塔伽",
          "text": "很好，非常好！你超过了我，可喜可贺！"
        },
        {
          "role": "马塔伽",
          "text": "我在这里独自特训也是希望有一天能超过这个由我自己创造的成绩，可惜直到今天我也没有做到。"
        },
        {
          "role": "马塔伽",
          "text": "但你做到了，这证明是时候出去看看了，外面还有很多远比我优秀的勇士！"
        },
        {
          "role": "马塔伽",
          "text": "和他们切磋、交流的话，我的水平也会得到提高，有一天，我绝对能得到父亲和姐姐的认可！"
        },
        {
          "role": "马塔伽",
          "text": "阿科米蒂就算了，那家伙一点志气都没有，居然跟我是亲兄弟，真是耻辱。"
        },
        {
          "role": "旅行者",
          "text": "阿科米蒂…？"
        },
        {
          "role": "马塔伽",
          "text": "不，没什么，闲话到此为止。"
        },
        {
          "role": "马塔伽",
          "text": "勇士，以后也要坚持磨砺自己！"
        },
        {
          "role": "马塔伽",
          "text": "既然想要成为传奇，就要奋力向前冲！冲！冲！这就是我留给你的临别赠言。"
        },
        {
          "role": "马塔伽",
          "text": "勇士！用这条赛道练习得怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有进步。",
              "dialogues": [
                {
                  "role": "马塔伽",
                  "text": "懦弱！没有进步就等于退步！"
                }
              ]
            },
            {
              "text": "最近没空练习。",
              "dialogues": [
                {
                  "role": "马塔伽",
                  "text": "懒惰！在无意义的闲逛中浪费人生去了吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "该怎么说呢，马塔伽的字典里好像除了「向前」、「拼命」之类的词，没有其他。"
        },
        {
          "role": "马塔伽",
          "text": "不错，我的字典比别人的薄！因为除了奋斗和努力，其他的东西我统统不承认。"
        },
        {
          "role": "马塔伽",
          "text": "你们需要练习，我也需要，仅仅练习与龙的合作，我还不算全能的勇士！"
        },
        {
          "role": "马塔伽",
          "text": "我必须前往更大的舞台磨砺自己！也就是说，我会离开这里一阵子。"
        },
        {
          "role": "马塔伽",
          "text": "你们放心！这里的赛道我会保留，但是这座飞屋我会拆下来带走。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "打算去哪里？",
              "dialogues": [
                {
                  "role": "马塔伽",
                  "text": "唔…去看看我爸，还有姐姐吧。"
                }
              ]
            },
            {
              "text": "打算怎么锻炼？",
              "dialogues": [
                {
                  "role": "马塔伽",
                  "text": "唔…可能会先问问爸爸还有姐姐的意见吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯？马塔伽的语气怎么变弱了？"
        },
        {
          "role": "马塔伽",
          "text": "有什么不对！爱护、尊重家人也是勇士理应具备的美德！狭隘！"
        },
        {
          "role": "马塔伽",
          "text": "我爸爸是花羽会最专业的训练大师，我姐姐是最厉害的驭龙师！我为他们而骄傲！"
        },
        {
          "role": "派蒙",
          "text": "好啦，我没有拿他们开玩笑的意思。"
        },
        {
          "role": "旅行者",
          "text": "知道了，祝你顺利。"
        },
        {
          "role": "马塔伽",
          "text": "你也顺利！勇士！这次的临别赠言是："
        },
        {
          "role": "马塔伽",
          "text": "我想想…永不放弃，不计血泪，成为英雄！"
        },
        {
          "type": "subtitle",
          "text": "与马塔伽对话"
        },
        {
          "role": "马塔伽",
          "text": "你的表现还不错，好好加油你可以的…"
        },
        {
          "role": "马塔伽",
          "text": "你以为我会说这种话吗？不，伟大勇士的字典里没有什么「不错」、「凑活」！"
        },
        {
          "role": "马塔伽",
          "text": "只有「最好」！达不到这个标准的统统是失败！"
        },
        {
          "role": "马塔伽",
          "text": "只要你还有勇气，就再来！练到超过我为止！"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "马塔伽",
          "text": "我会成为勇士！不，我会成为英雄，在那之前就瞧好吧。"
        }
      ]
    }
  ]
}