{
  "quest_id": 76185,
  "chapter_num": null,
  "chapter_title": "猫咪与齿轮",
  "type": "wq",
  "route": "Cat and Cog",
  "stories": [
    {
      "story_id": 76185,
      "title": "猫咪与齿轮",
      "description": "前往秘闻馆放置茶桌并使用桑多涅落座后，与奈芙尔共度茶会时光吧…",
      "dialogues": [
        {
          "role": "奈芙尔",
          "text": "搭配着「情报」喝下的茶，味道就是不一样。"
        },
        {
          "role": "奈芙尔",
          "text": "嗯，美味的茶水点心。多谢桑多涅小姐的招待。"
        },
        {
          "role": "「木偶」",
          "text": "没什么，你中意就好。我还带了些阿舍鲁喜欢的零食。对不对？阿舍鲁？过来，乖。"
        },
        {
          "role": "阿舍鲁",
          "text": "喵~"
        },
        {
          "role": "奈芙尔",
          "text": "希望你同挪德卡莱，以及同「秘闻馆」的这份情谊，能够对未来我们之间的合作有所益处。"
        },
        {
          "role": "「木偶」",
          "text": "嗯，我也希望如此。来，阿舍鲁，尝尝这个。"
        },
        {
          "role": "奈芙尔",
          "text": "另外，关于之前向桑多涅小姐打听的…"
        },
        {
          "role": "「木偶」",
          "text": "哈哈，你这小肉垫真软。"
        },
        {
          "role": "奈芙尔",
          "text": "……"
        },
        {
          "role": "奈芙尔",
          "text": "桑多涅小姐…你该不会是借茶会的名义来我这里揉猫的吧？"
        },
        {
          "role": "「木偶」",
          "text": "欸…？有，有吗？没有的事！和「秘闻馆」的往来我也放在心上的！"
        },
        {
          "role": "奈芙尔",
          "text": "过来，阿舍鲁。"
        },
        {
          "role": "阿舍鲁",
          "text": "喵~"
        },
        {
          "role": "「木偶」",
          "text": "啊…"
        },
        {
          "role": "奈芙尔",
          "text": "那我们具体聊聊「往来」相关的事吧。"
        },
        {
          "role": "「木偶」",
          "text": "…啧。有…就算有一点点是想揉猫又怎样啦！"
        },
        {
          "role": "「木偶」",
          "text": "平时很多小动物都不喜欢机械，好不容易前段时间在这里研究「数秘阵列」和阿舍鲁混熟了，揉一下又怎样啦！"
        },
        {
          "role": "奈芙尔",
          "text": "哈…好吧好吧。"
        },
        {
          "role": "奈芙尔",
          "text": "去吧，阿舍鲁。反正我也管不了你喜欢蹭谁。"
        },
        {
          "role": "阿舍鲁",
          "text": "喵~"
        },
        {
          "role": "奈芙尔",
          "text": "揉个痛快之后别忘了聊正事啊…"
        },
        {
          "role": "「木偶」",
          "text": "说了我有放在心上的！"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "奈芙尔",
          "text": "哦，慢走。有空常来。"
        }
      ]
    }
  ]
}