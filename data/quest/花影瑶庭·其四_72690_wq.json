{
  "quest_id": 72690,
  "chapter_num": null,
  "chapter_title": "花影瑶庭·其四",
  "type": "wq",
  "route": "The Floral Courtyard: Part IV",
  "stories": [
    {
      "story_id": 72690,
      "title": "花影瑶庭·其四",
      "description": "容彩祭上，花匠柴染正在寻找有缘之人，体会花艺之道。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与柴染对话"
        },
        {
          "role": "柴染",
          "text": "两位，这一天终于来了。"
        },
        {
          "role": "柴染",
          "text": "对于「花影瑶庭」的构图之道，你们已经领会到了精髓。"
        },
        {
          "role": "柴染",
          "text": "是时候来一场花艺的真剑试炼了。"
        },
        {
          "role": "派蒙",
          "text": "等等？原来我们已经领会到精髓了吗？"
        },
        {
          "role": "派蒙",
          "text": "真剑试炼的意思是最难的题目吧！我突然有点害怕了…"
        },
        {
          "role": "旅行者",
          "text": "明明接触插花的时间还不长。"
        },
        {
          "role": "柴染",
          "text": "制作花材的手法的确需要长期的磨练，而规划「花庭」的图景与结构，更侧重意会和灵感。"
        },
        {
          "role": "柴染",
          "text": "只论后者，两位的确表现出了惊人的天赋，不再需要「花题」的锤炼了。"
        },
        {
          "role": "柴染",
          "text": "或许是因为，两位经历过迷人的旅程，见证过我无法想象的景致，才有了不同于平凡之人的心境吧。"
        },
        {
          "role": "派蒙",
          "text": "是，是这样吗…"
        },
        {
          "role": "派蒙",
          "text": "说起来，旅行者，我们的确去过不少地方了呢，原来一起旅行的过程中，我们也会获得更多灵感啊…"
        },
        {
          "role": "派蒙",
          "text": "那这段时间，我们一直在学习花艺，又消耗掉了多少灵感呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "旅程还会继续下去。",
            "灵感会越来越多的。"
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，有道理！"
        },
        {
          "role": "派蒙",
          "text": "谢谢你，柴染小姐！要不是有你点拨，我们还没发现我们居然有这方面的才能呢！"
        },
        {
          "role": "柴染",
          "text": "不必客气。请用至美的「花庭」为这次的花艺体验之旅划上句点吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "请出题吧。",
            "还有别的事…"
          ]
        },
        {
          "role": "柴染",
          "text": "那么，今天的花题是——"
        },
        {
          "role": "柴染",
          "text": "「斜枝宛虹，绘染斑彩」。"
        },
        {
          "role": "柴染",
          "text": "期待着你们技艺大成的「花影瑶庭」。"
        },
        {
          "role": "柴染",
          "text": "接下来的几天，我会一直守候在这里，引导容彩祭的客人们，让他们感受「花影瑶庭」的精妙之处。"
        },
        {
          "role": "柴染",
          "text": "两位也别忘了每天揭晓一道的「花题」哦，一共有四道「花题」等着你们作答呢。"
        },
        {
          "role": "柴染",
          "text": "当然，要是两位还有其他问题，我也会尽力为你们解答的。"
        }
      ]
    }
  ]
}