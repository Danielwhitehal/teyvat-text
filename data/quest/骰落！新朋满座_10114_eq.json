{
  "quest_id": 10114,
  "chapter_num": "决斗！召唤之巅！ 第二回合",
  "chapter_title": "骰落！新朋满座",
  "type": "eq",
  "route": "Roll! A Sea of New Acquaintances",
  "stories": [
    {
      "story_id": 40108,
      "title": "骰落！新朋满座",
      "description": "惊天一掷！璃月赛区风云迭起！然而，幕后的谜团却愈行愈奇…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到第二天白天（8-10点）"
        },
        {
          "role": "派蒙",
          "text": "时间差不多了，我们这就去璃月吧！「卡牌怪盗」的事件还在等着我们呢！"
        },
        {
          "type": "subtitle",
          "text": "前往璃月港调查「怪盗」的线索"
        },
        {
          "role": "派蒙",
          "text": "哇，璃月港还是和以前一样热闹呢！"
        },
        {
          "role": "夏洛蒂",
          "text": "「千船继至，万商云来」，说的就是这样一幅景象吗？嗯，还真是百闻不如一见。"
        },
        {
          "role": "百闻",
          "text": "几位旅途辛苦了，欢迎来到璃月港。凝光大人早已吩咐我在这里等候各位。"
        },
        {
          "role": "派蒙",
          "text": "咦？你是凝光身边的小秘书，叫百…百…"
        },
        {
          "role": "百闻",
          "text": "我是百闻，负责帮助凝光大人收集整理情报。"
        },
        {
          "role": "派蒙",
          "text": "对对对，百闻。另外两位是百识和百晓，我没记错。"
        },
        {
          "role": "夏洛蒂",
          "text": "凝光？是那位「璃月七星」的「天权星」凝光大人吗？"
        },
        {
          "role": "派蒙",
          "text": "没错，就是她。不过凝光找我们做什么呢？咦，不对…应该说凝光怎么会知道我们今天要来璃月港？"
        },
        {
          "role": "百闻",
          "text": "凝光大人手眼通天。没有什么事能钻出她手下的情报网。"
        },
        {
          "role": "百闻",
          "text": "这次，是想邀请这位枫丹记者夏洛蒂小姐，到玉京台小坐，谈一些合作上的事。"
        },
        {
          "role": "夏洛蒂",
          "text": "咦？找我？可我这才第一次到璃月港啊。"
        },
        {
          "role": "百闻",
          "text": "凝光大人早就听闻《蒸汽鸟报》有位记者办事利落、文笔犀利，报道看似抓人眼球，其核心却以事实至上。她对此颇为欣赏。"
        },
        {
          "role": "百闻",
          "text": "包括您因「独家新闻」揭露的真相触及到了某些利益阶层，而被远派他国报道「七圣召唤」一事，凝光大人也尽数知晓。"
        },
        {
          "role": "派蒙",
          "text": "什么？原来夏洛蒂你这么惨？"
        },
        {
          "role": "夏洛蒂",
          "text": "没什么没什么，这都是常有的事，我早习惯了。"
        },
        {
          "role": "夏洛蒂",
          "text": "倒是没想到凝光大人连这都知道，难道说是认识我们的老板吗？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，凝光知道什么都不奇怪啦。"
        },
        {
          "role": "百闻",
          "text": "二位如果感兴趣的话，凝光大人也欢迎你们一同前往。"
        },
        {
          "role": "夏洛蒂",
          "text": "咦？原来你们和凝光大人也这么熟？"
        },
        {
          "role": "派蒙",
          "text": "略熟略熟，只是经常出入「群玉阁」，被尊为贵客的程度啦。"
        },
        {
          "role": "旅行者",
          "text": "你还得意起来了…"
        },
        {
          "role": "派蒙",
          "text": "不过…工作上的事，我们就不去凑热闹了吧？"
        },
        {
          "role": "派蒙",
          "text": "还不如一边在城里打听「卡牌怪盗」的事，一边等夏洛蒂你回来。"
        },
        {
          "role": "夏洛蒂",
          "text": "真的可以吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "举手之劳。",
              "dialogues": []
            },
            {
              "text": "还能到处逛逛。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏洛蒂",
          "text": "那就辛苦你们了，我们到时候再互换情报吧。说实话，我对这位凝光大人也挺感兴趣的，还真想马上见一面。"
        },
        {
          "role": "百闻",
          "text": "那么，夏洛蒂小姐，请随我来。"
        },
        {
          "role": "夏洛蒂",
          "text": "嗯，我们待会儿见。"
        },
        {
          "role": "派蒙",
          "text": "没想到夏洛蒂还挺有两下子的嘛。之前那个「独家新闻」，也不知道具体是讲什么的。"
        },
        {
          "role": "派蒙",
          "text": "要是这次的事件被写成报道的话，我们也会出现在「独家新闻」里了！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，总有种要出名了的感觉。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们已经很出名了…",
              "dialogues": []
            },
            {
              "text": "还是先做好眼前的事…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你说得对，那我们就先从码头开始调查吧，那里人来人往的，说不定有人看到过卡牌交易呢。"
        },
        {
          "type": "subtitle",
          "text": "前往璃月码头打听消息"
        },
        {
          "type": "subtitle",
          "text": "向码头周围的人打听消息"
        },
        {
          "type": "subtitle",
          "text": "向永安打听消息",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "你好，方便向你打听个事吗？"
        },
        {
          "role": "永安",
          "text": "你说吧，只要是我…阿嚏！知道的事。"
        },
        {
          "role": "派蒙",
          "text": "你在这儿附近见到过有人在收集「七圣召唤」的牌背吗？"
        },
        {
          "role": "永安",
          "text": "牌背？…阿嚏！没怎么见到过。"
        },
        {
          "role": "永安",
          "text": "倒是刚才有个…阿嚏！稻妻模样的姑娘从我面前走过，我就…阿嚏！喷嚏打个不停。"
        },
        {
          "role": "派蒙",
          "text": "总感觉你还是多保重自己的身体吧…我们去其他地方问问。"
        },
        {
          "role": "永安",
          "text": "我没事，没事…千岩牢固，重嶂…阿嚏！不移。"
        },
        {
          "type": "subtitle",
          "text": "向观海打听消息",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "你好！我们想找你打听个事。"
        },
        {
          "role": "观海",
          "text": "啊？哦…你们问吧，反正船也开走了，我有的是时间…"
        },
        {
          "role": "派蒙",
          "text": "你最近在附近见到过收集牌背的人吗？就是很流行的那个「七圣召唤」的牌背。"
        },
        {
          "role": "观海",
          "text": "收集牌背？倒是偶尔会有人在附近打牌。但…我心思基本都在海上了…没怎么注意过。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那我们再找其他人问问。"
        },
        {
          "role": "观海",
          "text": "哎…下次不能起这么晚了…"
        },
        {
          "type": "subtitle",
          "text": "向老孙打听消息",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "你好！我们想打听个事。"
        },
        {
          "role": "老孙",
          "text": "哟，客人您尽管问，我们这里什么鱼都有！"
        },
        {
          "role": "派蒙",
          "text": "不是不是，我们想问问，你一直在这里做生意，有没有在附近见到过收集「七圣召唤」牌背的人？"
        },
        {
          "role": "老孙",
          "text": "「七圣召唤」？这我还真不知道，来我这儿都是买鱼的，没人打听过什么牌背的事。"
        },
        {
          "role": "派蒙",
          "text": "是吗？那抱歉打扰了，我们去其他地方问问。"
        },
        {
          "role": "老孙",
          "text": "客人要不买条鱼再走？我的鱼可都是「超·新鲜」的！"
        },
        {
          "type": "subtitle",
          "text": "与枫原万叶对话"
        },
        {
          "role": "派蒙",
          "text": "问下来没什么收获呢，我们还是换个地方打听吧。"
        },
        {
          "role": "？？？",
          "text": "二位，这是在找人吗？"
        },
        {
          "role": "派蒙",
          "text": "咦？这个声音是…万叶！"
        },
        {
          "role": "枫原万叶",
          "text": "好久不见，旅行者，派蒙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好久不见。",
              "dialogues": []
            },
            {
              "text": "最近还好吗？",
              "dialogues": [
                {
                  "role": "枫原万叶",
                  "text": "托你们的福，一切都好。"
                }
              ]
            }
          ]
        },
        {
          "role": "枫原万叶",
          "text": "最近大姐头回璃月办事，我也顺道在附近逛逛，没想到遇见了你们。"
        },
        {
          "role": "枫原万叶",
          "text": "看你们好像在打听什么事，不知道我能不能帮上忙？"
        },
        {
          "role": "派蒙",
          "text": "哦，事情是这样的…"
        },
        {
          "type": "subtitle",
          "text": "将最近发生的事告诉了万叶…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "枫原万叶",
          "text": "原来如此。港口的风倒是一如既往和煦惬意，我想你们要找的「卡牌怪盗」，并没有经过这里。"
        },
        {
          "role": "派蒙",
          "text": "这样啊…"
        },
        {
          "role": "枫原万叶",
          "text": "也不知这消息对你们来说是好是坏。对了…最近这附近倒是正在举办比赛，我也看过几眼。「七圣召唤」…近来似乎很是风靡。"
        },
        {
          "role": "派蒙",
          "text": "咦？难道万叶还没玩过「七圣召唤」吗？"
        },
        {
          "role": "枫原万叶",
          "text": "是啊，我总是个「观牌不语」的旁观者。"
        },
        {
          "role": "枫原万叶",
          "text": "前阵子大姐头带了一个小盒子上船，里面装着好多图案精美的卡牌，还跟船员们切磋了好几局，兴致高得连酒都多喝了不少。"
        },
        {
          "role": "派蒙",
          "text": "那个就是「秘典之盒」，是用来装卡牌和寻找附近牌手的小道具！"
        },
        {
          "role": "派蒙",
          "text": "要不万叶也来试试「七圣召唤」吧！规则挺简单的，平时还能和朋友们一起玩！"
        },
        {
          "role": "旅行者",
          "text": "机会难得。"
        },
        {
          "role": "枫原万叶",
          "text": "嗯…「以牌会友」，甚是风雅。那就拜托你们指导指导我了。"
        },
        {
          "role": "派蒙",
          "text": "包在我身上！经常看旅行者打牌，我也算得上是个大师牌手了！"
        },
        {
          "role": "派蒙",
          "text": "除了教你规则，还要给你弄个「秘典之盒」才行。"
        },
        {
          "role": "枫原万叶",
          "text": "但眼下更急切的，应该是「卡牌怪盗」的问题吧？"
        },
        {
          "role": "派蒙",
          "text": "也是哦…嘿嘿，差点光想着老朋友，忘记新朋友了。毕竟都答应夏洛蒂了。"
        },
        {
          "role": "派蒙",
          "text": "让我想想…接下来该去哪…"
        },
        {
          "role": "派蒙",
          "text": "咦？旅行者，你看那边。"
        },
        {
          "role": "派蒙",
          "text": "那不是在蒙德和迪奥娜聊天的稻妻快递员吗？居然在这里也碰上了。"
        },
        {
          "role": "枫原万叶",
          "text": "她腰间的那个标志…莫非是「狛荷屋」？"
        },
        {
          "role": "派蒙",
          "text": "咦？万叶知道这家公司吗？"
        },
        {
          "role": "枫原万叶",
          "text": "此前有所耳闻，他们家在稻妻专做快递业务。"
        },
        {
          "role": "派蒙",
          "text": "唔…她是不是遇到了什么麻烦？我们去和她打个招呼吧。"
        },
        {
          "type": "subtitle",
          "text": "向快递员少女打招呼"
        },
        {
          "role": "？？？",
          "text": "该往哪里走呢…"
        },
        {
          "role": "派蒙",
          "text": "你好！有什么需要帮忙的吗？"
        },
        {
          "role": "？？？",
          "text": "呜啊！吓我一跳…咦？你们是…之前在蒙德猫尾酒馆的人。"
        },
        {
          "role": "派蒙",
          "text": "嗯！我叫派蒙，这边是旅行者和枫原万叶。又遇到你了，好巧啊！"
        },
        {
          "role": "绮良良",
          "text": "你们好你们好，我叫绮良良，是稻妻快递公司「狛荷屋」旗下的快递员。"
        },
        {
          "role": "枫原万叶",
          "text": "「狛荷屋」的服务，向来因「准时」和「安全」广受赞誉，没想到你们还开辟了跨国业务。"
        },
        {
          "role": "绮良良",
          "text": "哇，在外国见到家乡人可真不容易！"
        },
        {
          "role": "绮良良",
          "text": "我们的跨国业务是最近才发展起来的，送国际快递简直就像公费出游！但我不熟悉其他城市，经常找不到路…"
        },
        {
          "role": "绮良良",
          "text": "有时为了赶时间，还不得不变回原来的样子，爬起墙来方便些。"
        },
        {
          "role": "绮良良",
          "text": "欸，你们知道璃月的「往生堂」怎么走吗？我都已经绕半天了。"
        },
        {
          "role": "派蒙",
          "text": "这个我们熟，现在就可以给你带路。"
        },
        {
          "role": "绮良良",
          "text": "真的吗？太谢谢你们了！"
        },
        {
          "type": "subtitle",
          "text": "为绮良良带路，前往往生堂"
        },
        {
          "type": "subtitle",
          "text": "与胡桃对话"
        },
        {
          "role": "胡桃",
          "text": "「天上太阳高高挂，手里骰子呼啦啦」…唔，可惜句尾没对上…"
        },
        {
          "role": "派蒙",
          "text": "喏，就是这里了。"
        },
        {
          "role": "胡桃",
          "text": "哎哟哟，旅行者和派蒙，你们怎么来这儿了？"
        },
        {
          "role": "胡桃",
          "text": "还带了那么多朋友…客人？交易伙伴？新的合作对象？"
        },
        {
          "role": "派蒙",
          "text": "咳咳…我来介绍一下，这位是枫原万叶，这位是绮良良…"
        },
        {
          "role": "枫原万叶",
          "text": "您好，久仰大名。"
        },
        {
          "role": "胡桃",
          "text": "嗯，各位新老朋友大家好，不知今日到往生堂来有何贵干？"
        },
        {
          "role": "胡桃",
          "text": "噢！难道是听说了我们最近正在举行的活动，不惜远渡重洋…"
        },
        {
          "role": "派蒙",
          "text": "不是不是，我们只是来给绮良良带路的。"
        },
        {
          "role": "绮良良",
          "text": "您就是往生堂堂主胡桃小姐吧？我是稻妻「狛荷屋」的快递员，这里有一份您的快递，希望您签收一下。"
        },
        {
          "role": "胡桃",
          "text": "我看看…没错没错，是我要的东西。"
        },
        {
          "role": "胡桃",
          "text": "这年头快递还真是方便啊…跑腿的活都不用麻烦客卿了。"
        },
        {
          "role": "胡桃",
          "text": "绮良良姑娘是什么都能送吗？大活人也能送吗？介于生死边缘之间的呢？"
        },
        {
          "role": "绮良良",
          "text": "欸？！这个…"
        },
        {
          "role": "派蒙",
          "text": "她尾巴都竖起来了。"
        },
        {
          "role": "胡桃",
          "text": "好吧…那拓展业务的事情就下次再聊吧。"
        },
        {
          "role": "绮良良",
          "text": "能…能再麻烦您几秒钟给我个五星好评吗？"
        },
        {
          "role": "胡桃",
          "text": "五星？那怎么够。这服务怎么着也得七星！不对，九星！"
        },
        {
          "role": "绮良良",
          "text": "欸，五星就够了，五星就够了。您的热情我心领了。"
        },
        {
          "role": "绮良良",
          "text": "那我就先告辞了，多谢你们为我指路。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用客气。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘿嘿，这都是小意思。"
                }
              ]
            },
            {
              "text": "快递都是你送吗？",
              "dialogues": [
                {
                  "role": "绮良良",
                  "text": "唔…那不一定。最近业务火爆，公司招了很多新人。不过跨国快递一般都是我送，毕竟我是妖怪，腿脚也比寻常人厉害嘛。"
                },
                {
                  "role": "派蒙",
                  "text": "也就是说，我们也许还会在路上碰到。"
                }
              ]
            }
          ]
        },
        {
          "role": "绮良良",
          "text": "嗯！我期待着和各位再次见面！呃…希望不是迷路的时候…"
        },
        {
          "role": "枫原万叶",
          "text": "刚才听闻堂主在此咏诗，不知是何来如此闲情？"
        },
        {
          "role": "胡桃",
          "text": "哟？这位小哥难道也对诗歌感兴趣吗？"
        },
        {
          "role": "枫原万叶",
          "text": "偶尔会琢磨些字词而已。"
        },
        {
          "role": "胡桃",
          "text": "哎呀，不必谦虚。本堂主阅人万千，见多识广，光看你的衣袖被风吹起的弧度，就知道你是位风雅之人了。"
        },
        {
          "role": "胡桃",
          "text": "我呢，正在为即将开始的决赛做准备，大伙儿也帮着出点主意？"
        },
        {
          "role": "派蒙",
          "text": "决赛？难道是「七圣召唤」的决赛吗？"
        },
        {
          "role": "胡桃",
          "text": "对对对，就是那个。"
        },
        {
          "role": "胡桃",
          "text": "这次的对手非同小可，平时兜兜转转，混迹人群之中，比赛时却像骗骗花那样破土而出。"
        },
        {
          "role": "胡桃",
          "text": "我有预感，这会是本堂主少有一遇的苦战。"
        },
        {
          "role": "派蒙",
          "text": "那不是应该一起想想策略吗？和吟诗有什么关系…"
        },
        {
          "role": "胡桃",
          "text": "光有「技」可不行，还得添「型」！"
        },
        {
          "role": "派蒙",
          "text": "啊？"
        },
        {
          "role": "胡桃",
          "text": "拿派蒙听得懂的东西打比方的话…一道菜好吃还不够，摆出来也要好看！这叫「花开两枝」。气势上也不能输呀！"
        },
        {
          "role": "派蒙",
          "text": "怎么又是这种听上去好像有点道理，又没什么道理的说法…"
        },
        {
          "role": "枫原万叶",
          "text": "嗯…面对生死攸关的对决，有的武士会在比试前互道敬意。二者或许有所共通。"
        },
        {
          "role": "胡桃",
          "text": "这位新朋友的理解能力很了不得嘛。"
        },
        {
          "role": "枫原万叶",
          "text": "过奖。依我个人之见，胡堂主的口号里不妨加入一些对比赛的期望，或是能够震慑对方的词句。"
        },
        {
          "role": "胡桃",
          "text": "嚯，我这算是碰上行家了呀！要不咱们这就来上一局？也好让我找找灵感热热身。"
        },
        {
          "role": "枫原万叶",
          "text": "嗯…我虽有心相陪，但我未曾实战，也没有自己的牌组。"
        },
        {
          "role": "旅行者",
          "text": "牌组可以用我的。"
        },
        {
          "role": "派蒙",
          "text": "机会正好！我也想看你们玩牌。大不了我给万叶来个突击训练吧！"
        },
        {
          "role": "枫原万叶",
          "text": "大家如此盛情，那我就恭敬不如从命了。"
        },
        {
          "type": "subtitle",
          "text": "派蒙向万叶解释了「七圣召唤」的规则…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "以上就是所有规则！包括我从旅行者那儿看到的小技巧也全都教给你了，万叶还跟得上吗？"
        },
        {
          "role": "枫原万叶",
          "text": "没问题，多谢派蒙老师。"
        },
        {
          "role": "派蒙",
          "text": "老…老师？嘿…嘿嘿…也，也没有那么厉害啦。"
        },
        {
          "role": "胡桃",
          "text": "怎么样，万叶小哥？有信心面对我这位小巷派打油诗人了吗？"
        },
        {
          "role": "枫原万叶",
          "text": "嗯，有劳胡堂主赐教了。"
        },
        {
          "role": "胡桃",
          "text": "决胜口号呢？"
        },
        {
          "role": "枫原万叶",
          "text": "口号吗…嗯…好，我想好了。"
        },
        {
          "role": "派蒙",
          "text": "真、真亏他接得上。"
        },
        {
          "role": "胡桃",
          "text": "好！有请来者报上名字！"
        },
        {
          "role": "派蒙",
          "text": "哇，气氛一下子就起来了呢！"
        },
        {
          "role": "旅行者",
          "text": "嘘…"
        },
        {
          "role": "枫原万叶",
          "text": "……"
        },
        {
          "role": "枫原万叶",
          "text": "「薄纸结新交，刀剑铮鸣方寸间，红叶燎如烟。」枫原万叶，向您讨教。"
        },
        {
          "role": "胡桃",
          "text": "哼哼…「天气好来鸟儿乐，火骰子一共有六个！」往生堂堂主胡桃，迎战！"
        },
        {
          "role": "旅行者",
          "text": "这口号都不挨着…"
        },
        {
          "role": "派蒙",
          "text": "噗嗤…"
        },
        {
          "role": "胡桃",
          "text": "我的回合！「起」！"
        },
        {
          "type": "subtitle",
          "text": "二人进行了一场激烈的对局…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "枫原万叶",
          "text": "哈，果然还是输了呀。胡堂主不愧是闯进了决赛的人。"
        },
        {
          "role": "派蒙",
          "text": "哇，刚才那局也太精彩了吧！"
        },
        {
          "role": "胡桃",
          "text": "还好本堂主送了万叶小哥的召唤物一程。"
        },
        {
          "role": "胡桃",
          "text": "你的表现，简直不像是第一次玩这游戏的人嘛！"
        },
        {
          "role": "枫原万叶",
          "text": "多亏派蒙老师教得好。"
        },
        {
          "role": "派蒙",
          "text": "欸？是…是吗？嘿嘿嘿…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙老师教得好。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "怎么连你也这样，我会害羞的啦，嘿嘿…"
                }
              ]
            },
            {
              "text": "派蒙老师得意得飘起来了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我本来就是飘着的啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "万叶呢？喜欢「七圣召唤」吗？"
        },
        {
          "role": "枫原万叶",
          "text": "嗯，卡牌技能多样，局势瞬息万变。亲身体验后，我能明白它为什么会风靡提瓦特了。"
        },
        {
          "role": "刻晴",
          "text": "看来世间又多了一位牌手。"
        },
        {
          "role": "派蒙",
          "text": "刻晴！你什么时候来的？"
        },
        {
          "role": "刻晴",
          "text": "在二位牌局开始后不久。看到大家如此投入，我也不想打断。"
        },
        {
          "role": "刻晴",
          "text": "这位就是枫原万叶先生吧？我听说过您的事迹。今日有缘一见，也是我的荣幸。"
        },
        {
          "role": "枫原万叶",
          "text": "不敢当。我也听大姐头提起过玉衡大人，应该说是我的荣幸。"
        },
        {
          "role": "刻晴",
          "text": "叫我刻晴就好。万叶先生牌技不错，第一次对局就能有如此领悟，真是不简单。"
        },
        {
          "role": "刻晴",
          "text": "有机会的话，之后我也想与您切磋一局。"
        },
        {
          "role": "派蒙",
          "text": "哇，这就遇上下一位对手了！"
        },
        {
          "role": "刻晴",
          "text": "很惊讶吗？如今玉京台几乎人人都会「七圣召唤」，工作之余偶尔也会来上一局。"
        },
        {
          "role": "枫原万叶",
          "text": "我很乐意。不过，我也不能一直借用旅行者的牌组，对局可能要等我拿到自己的「秘典之盒」后才行。"
        },
        {
          "role": "刻晴",
          "text": "哦，这没什么，待会儿到比赛会场就找牌手协会的成员为你置办。"
        },
        {
          "role": "刻晴",
          "text": "举手之劳，客气的话就不用说了。你是旅行者的朋友，那就是我们大家的朋友。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你，刻晴。",
              "dialogues": []
            },
            {
              "text": "真好啊，万叶。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "枫原万叶",
          "text": "那就有劳刻晴小姐了。"
        },
        {
          "role": "刻晴",
          "text": "另外，胡桃，决赛快要开始了，我是来通知你的。"
        },
        {
          "role": "胡桃",
          "text": "放心，本堂主看似在数砖块，耳朵都听着呢！"
        },
        {
          "role": "胡桃",
          "text": "准备工作一应俱全，可以说是势在必得咯！"
        },
        {
          "role": "刻晴",
          "text": "各位，要随我们一起前往会场吗？"
        },
        {
          "role": "旅行者",
          "text": "其实有一件事…"
        },
        {
          "role": "派蒙",
          "text": "对哦！正事正事…"
        },
        {
          "role": "派蒙",
          "text": "我们在调查跟「卡牌怪盗」有关的事件，不知道你们最近有没有见到过收集「七圣召唤」牌背的人？"
        },
        {
          "role": "胡桃",
          "text": "牌背？莫非印着宝箱的样子？"
        },
        {
          "role": "派蒙",
          "text": "对对对！就是那种！"
        },
        {
          "role": "胡桃",
          "text": "那人的脸上倒是没写「怪盗」两字，气质嘛…倒挺像潜在客户。"
        },
        {
          "role": "胡桃",
          "text": "今早我见他和重云打牌，还说输了的人就得交出牌背。最后那人险胜重云，擦了擦额头的汗，拿上牌背就走了。"
        },
        {
          "role": "派蒙",
          "text": "看来得直接找重云问问呢。"
        },
        {
          "role": "胡桃",
          "text": "那你们去无妄坡看看吧，他应该在那儿。"
        },
        {
          "role": "刻晴",
          "text": "容我多问一句，这位「卡牌怪盗」，还有什么可疑之举吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…除了知道他对牌背非常热衷之外，其他不太了解，但听说他还是做过偷别人牌这种事的！"
        },
        {
          "role": "刻晴",
          "text": "明白了，我会提醒千岩军多留个心眼。你们也凡事注意安全。"
        },
        {
          "role": "枫原万叶",
          "text": "我就先随旅行者一起去看看吧。"
        },
        {
          "role": "刻晴",
          "text": "嗯，之后再见。"
        },
        {
          "role": "旅行者",
          "text": "堂主比赛加油。"
        },
        {
          "role": "胡桃",
          "text": "有好友你的祝福，本堂主「咻」地一下就统统搞定了。"
        },
        {
          "role": "派蒙",
          "text": "那我们也出发去找重云吧！"
        },
        {
          "type": "subtitle",
          "text": "前往无妄坡寻找重云"
        },
        {
          "role": "阿方",
          "text": "呜呜呜呜呜…"
        },
        {
          "role": "重云",
          "text": "你先莫慌，一定会找到的。"
        },
        {
          "role": "派蒙",
          "text": "重云！找到你了。"
        },
        {
          "role": "重云",
          "text": "派蒙？旅行者？还有…"
        },
        {
          "role": "枫原万叶",
          "text": "在下枫原万叶。"
        },
        {
          "role": "重云",
          "text": "你好，我是重云，璃月方士。长话短说，这位孩子的朋友在玩捉迷藏时走丢了。"
        },
        {
          "role": "阿方",
          "text": "呜呜呜…我，我提醒过小郁不要藏太远的，但我在附近找了一圈，怎么都找不到她…"
        },
        {
          "role": "派蒙",
          "text": "这荒郊野岭的，要是迷路可就危险了！我们也来帮忙！你看到她往哪边去了吗？"
        },
        {
          "role": "阿方",
          "text": "嗯…我数数时偷看过一眼，她往那边去了…"
        },
        {
          "role": "派蒙",
          "text": "好，我们沿路找找。"
        },
        {
          "type": "subtitle",
          "text": "寻找「小郁」"
        },
        {
          "role": "派蒙",
          "text": "小郁——小郁你在吗——"
        },
        {
          "role": "枫原万叶",
          "text": "折断的树枝…压弯的矮草…嗯，这的确是小孩子躲藏过的痕迹。"
        },
        {
          "role": "派蒙",
          "text": "我们再往深一点的地方走走吧。"
        },
        {
          "type": "subtitle",
          "text": "击退盗宝团"
        },
        {
          "role": "派蒙",
          "text": "又是盗宝团！她不会遇到危险吧！"
        },
        {
          "type": "subtitle",
          "text": "与重云对话"
        },
        {
          "role": "派蒙",
          "text": "真是的…最近怎么老是遇到他们？"
        },
        {
          "role": "重云",
          "text": "各位，来看看这个。"
        },
        {
          "role": "派蒙",
          "text": "这是…「七圣召唤」的卡牌？"
        },
        {
          "role": "阿方",
          "text": "啊！那是小郁的牌！"
        },
        {
          "role": "阿方",
          "text": "小郁爸爸送了她一副牌，她一直很爱惜，不管到哪儿都带着。"
        },
        {
          "role": "派蒙",
          "text": "那就说明小郁来过这儿。可前面是个岔路口…我们该去哪边找呢…"
        },
        {
          "role": "枫原万叶",
          "text": "嗯？等等…阿方，小郁的父亲，除了卡牌之外，应该还送了她一个小盒子吧？"
        },
        {
          "role": "阿方",
          "text": "嗯，「秘典之盒」。我也有一个。"
        },
        {
          "role": "重云",
          "text": "哦！对啊！我怎么没有想到！"
        },
        {
          "role": "旅行者",
          "text": "牌手寻找功能！"
        },
        {
          "role": "枫原万叶",
          "text": "嗯，只要小郁还将盒子带在身边，我们就能借此知道她的确切位置了。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，快拿出我们的「秘典之盒」来看看！"
        },
        {
          "role": "派蒙",
          "text": "唔…周围这是…重云和阿方。有了！在那边显示还有一位牌手！应该就是小郁了！"
        },
        {
          "type": "subtitle",
          "text": "寻找「小郁」"
        },
        {
          "role": "阿方",
          "text": "小郁！"
        },
        {
          "role": "小郁",
          "text": "阿方？呜…对不起，我不该跑这么远的…"
        },
        {
          "role": "小郁",
          "text": "我藏到一半看到很多很凶的大人，我害怕…就，就一直跑到了这里…呜呜呜…"
        },
        {
          "role": "重云",
          "text": "放心吧，那些很凶的大人已经被我们赶走了。"
        },
        {
          "role": "重云",
          "text": "但无妄坡阴气甚重，以后最好不要再来此地玩耍。"
        },
        {
          "role": "阿方",
          "text": "好的好的，我们知道了，谢谢大哥哥们/大哥哥大姐姐。"
        },
        {
          "role": "小郁",
          "text": "谢谢哥哥们/哥哥姐姐…"
        },
        {
          "role": "重云",
          "text": "嗯，你们先莫要乱跑。一会儿我送你们回家。"
        },
        {
          "role": "派蒙",
          "text": "呼，还好是虚惊一场。"
        },
        {
          "role": "重云",
          "text": "也多亏这位万叶兄，想到了用「秘典之盒」来寻人的办法。"
        },
        {
          "role": "派蒙",
          "text": "这就是所谓的「盲点」吗？我们一直用它来玩牌，关键时候都不知道还能用来找人。"
        },
        {
          "role": "派蒙",
          "text": "这么一想，发明这功能的须弥学者还真是厉害。"
        },
        {
          "role": "派蒙",
          "text": "对了，重云，我们有事想问你…"
        },
        {
          "type": "subtitle",
          "text": "向重云讲述了「卡牌怪盗」的事…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "重云",
          "text": "我就觉得他对那牌背的执念有些不正！我居然…放走了一位「怪盗」！呼…冷静…冷静…"
        },
        {
          "role": "枫原万叶",
          "text": "人面易识而心难识，这不是你的错。"
        },
        {
          "role": "枫原万叶",
          "text": "换作是我，对方提出了一场比赛，也未必会觉得有何不妥。"
        },
        {
          "role": "派蒙",
          "text": "就是，这人狡猾得很，见对方大意就偷，偷不到就找其他办法。"
        },
        {
          "role": "枫原万叶",
          "text": "那人拿到卡牌之后，还说过什么吗？"
        },
        {
          "role": "重云",
          "text": "他当时急急忙忙收了东西就往港口方向去了。嗯…嘴里抱怨着去稻妻好远，还要坐很久的船之类的。"
        },
        {
          "role": "派蒙",
          "text": "看来这人还真喜欢自言自语啊…"
        },
        {
          "role": "派蒙",
          "text": "只能跟着这条线索追下去了。在此之前，我们还是先回一趟会场吧。"
        },
        {
          "role": "重云",
          "text": "那我就送阿方和小郁回去了。虽然还是有点不甘…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「怪盗」就交给我们吧。",
              "dialogues": [
                {
                  "role": "重云",
                  "text": "嗯，拜托了。"
                }
              ]
            },
            {
              "text": "别太上头。",
              "dialogues": [
                {
                  "role": "重云",
                  "text": "呼…我知道，我回去便静心打坐…多谢关心。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "噫…重云走后这里突然变得阴森森的，我们赶快回去吧。"
        },
        {
          "type": "subtitle",
          "text": "返回璃月比赛会场"
        },
        {
          "role": "刻晴",
          "text": "精彩的对局，真是叫人目不暇接。"
        },
        {
          "role": "派蒙",
          "text": "欸？又没赶上吗？本来以为能看上一眼的。"
        },
        {
          "role": "刻晴",
          "text": "你们来啦？重云那边情况如何？"
        },
        {
          "role": "派蒙",
          "text": "有些小波折，但从结果上来说算是顺利！胡桃呢？赢下比赛了吗？"
        },
        {
          "role": "胡桃",
          "text": "那是当然！说不上是「咻」地一下，但也算「咚锵」地拿下了！"
        },
        {
          "role": "胡桃",
          "text": "对手真不愧是牌中高人。我们互换两员大将之后，来到了最关键的一回合！"
        },
        {
          "role": "胡桃",
          "text": "本堂主闭眼敛息，将骰子握于手中，祈求着赛场上看得见和看不见的新老朋友多多保佑！"
        },
        {
          "role": "胡桃",
          "text": "你猜怎么着？"
        },
        {
          "role": "旅行者",
          "text": "怎么着？"
        },
        {
          "role": "胡桃",
          "text": "我聚「型」于「技」中，双手一挥！喊出了那句制胜口号！"
        },
        {
          "role": "派蒙",
          "text": "「火骰子一共有六个！」"
        },
        {
          "role": "胡桃",
          "text": "没错！本堂主定睛一看，桌上还真整整齐齐立着六个火骰子！自然是以蝶火燎原之势拿下了比赛！"
        },
        {
          "role": "旅行者",
          "text": "好家伙。"
        },
        {
          "role": "派蒙",
          "text": "这口号还真有用啊！"
        },
        {
          "role": "枫原万叶",
          "text": "胡堂主的打法如林间幽蝶般轻盈灵动。有了运气的加成，就好比双翅乘上顺风。"
        },
        {
          "role": "凝光",
          "text": "而「运气」，向来也是实力的一部分。旅行者，你不这么认为吗？"
        },
        {
          "role": "派蒙",
          "text": "凝光，夏洛蒂！你们工作聊完啦？"
        },
        {
          "role": "夏洛蒂",
          "text": "嗯！天权星大人思路透彻，见解高明！我都要羡慕起百闻小姐了。"
        },
        {
          "role": "夏洛蒂",
          "text": "哇，这位想必就是枫原万叶先生吧？"
        },
        {
          "role": "枫原万叶",
          "text": "很高兴认识你，夏洛蒂小姐。"
        },
        {
          "role": "夏洛蒂",
          "text": "大英雄的朋友果然也是大英雄！你可是上过《蒸汽鸟报》头版头条！"
        },
        {
          "role": "夏洛蒂",
          "text": "「少年武士接下无想之一刀」，这个话题在枫丹火了好一阵子。"
        },
        {
          "role": "胡桃",
          "text": "没想到没想到，本堂主居然在牌场上战胜了这么厉害的人物？"
        },
        {
          "role": "枫原万叶",
          "text": "都是旧日蛮勇，已经过去了。还是当下结识了如此之多的新朋友更令我感到愉快。"
        },
        {
          "role": "凝光",
          "text": "我看今日相识皆是缘分，不如待会儿由我请客，小聚一番。各位意下如何？"
        },
        {
          "role": "胡桃",
          "text": "哦？看来是给本堂主开的庆功宴啊！一定去一定去！"
        },
        {
          "role": "刻晴",
          "text": "你们先聊，我去把会场工作收个尾，晚些和大家会合。"
        },
        {
          "role": "旅行者",
          "text": "晚点见。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿…今晚我们就吃得饱饱，睡个好觉，明天再出发去稻妻吧！"
        },
        {
          "role": "夏洛蒂",
          "text": "哦？关于「怪盗」有新线索了？"
        },
        {
          "role": "派蒙",
          "text": "对啊，我们打听消息可是很厉害的！虽然…也有运气成分吧。"
        },
        {
          "role": "枫原万叶",
          "text": "我在璃月还有些事要办，就不随你们去稻妻了。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那万叶要记得好好练牌，小心我哪天突击检查哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真严格啊，派蒙老师。",
              "dialogues": []
            },
            {
              "text": "真负责啊，派蒙老师。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "关于你们所寻的那位「怪盗」，我近来有所耳闻。"
        },
        {
          "role": "派蒙",
          "text": "哇，凝光连这个都知道？"
        },
        {
          "role": "凝光",
          "text": "最近市面上出现了一种新的牌背，数量稀少，图案为宝箱模样。"
        },
        {
          "role": "凝光",
          "text": "一些牌手为了图个好彩头，愿意出高价收购。我便随手调查着这其中有无商业价值。"
        },
        {
          "role": "凝光",
          "text": "这时突然传来消息，璃月所有的宝箱牌背，全都在一夜间被收走了。"
        },
        {
          "role": "凝光",
          "text": "我本以为是个想要囤积居奇的商人，听描述才知是你们在寻找的「怪盗」。"
        },
        {
          "role": "夏洛蒂",
          "text": "这牌背除了稀少，还有什么不同寻常的地方吗？"
        },
        {
          "role": "凝光",
          "text": "很遗憾，我并没有入手这种牌背，无法准确回答你的问题。"
        },
        {
          "role": "凝光",
          "text": "只知道那做工是私人制品，谈不上多么精美。这也是我没有出手的原因。"
        },
        {
          "role": "夏洛蒂",
          "text": "唔…「怪盗」身后的谜题越来越奇妙了。"
        },
        {
          "role": "派蒙",
          "text": "没关系，他那么喜欢自言自语，总有一天会把所有秘密都说漏嘴的。"
        },
        {
          "role": "凝光",
          "text": "每场未知的旅途，都是一个谜题。无法预见答案，才更让我们享受过程中的乐趣。"
        },
        {
          "role": "凝光",
          "text": "就像这次结识诸位异国才俊的机会，于我而言就是一场惊喜。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（胡桃&枫原万叶）"
        },
        {
          "role": "胡桃",
          "text": "这么说来，北斗姐也会打「七圣召唤」？"
        },
        {
          "role": "枫原万叶",
          "text": "嗯，大姐头的牌技在南十字船队称得上数一数二了。"
        },
        {
          "role": "胡桃",
          "text": "要不万叶小哥帮我引荐引荐？我对北斗姐崇拜已久，早就想跟她交朋友啦，可一直没遇到机会。"
        },
        {
          "role": "枫原万叶",
          "text": "好。到时候还请堂主手下留情。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（凝光）"
        },
        {
          "role": "凝光",
          "text": "听闻「七圣召唤」的坊间比赛办得很是热闹，不少热爱牌戏的选手甚至在两边同时报了名。"
        },
        {
          "role": "凝光",
          "text": "我的话…偶尔迎迎潮流无妨，但还是对棋戏更感兴趣。"
        },
        {
          "role": "凝光",
          "text": "说到底，这些游艺只是形式不同。更珍贵的，还是朋友相聚这一事实。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（夏洛蒂&小千）"
        },
        {
          "role": "夏洛蒂",
          "text": "您好您好，我是来自枫丹「蒸汽鸟报社」的记者夏洛蒂。"
        },
        {
          "role": "夏洛蒂",
          "text": "请问方便抽点时间吗？我想对您做个简单采访。"
        },
        {
          "role": "小千",
          "text": "唉，你问吧。"
        },
        {
          "role": "夏洛蒂",
          "text": "您一路过关斩将，最后关头不敌往生堂的胡桃胡堂主，与冠军失之交臂，看起来相当遗憾。"
        },
        {
          "role": "夏洛蒂",
          "text": "请问您会如何评价这场比赛呢？"
        },
        {
          "role": "小千",
          "text": "…这。"
        },
        {
          "role": "小千",
          "text": "记者小姐，你要的是能写上报纸的回答，还是我的真实想法？"
        },
        {
          "role": "夏洛蒂",
          "text": "当然是真实想法。"
        },
        {
          "role": "小千",
          "text": "唉…"
        },
        {
          "role": "小千",
          "text": "虽然打牌七分靠技术，三分靠运气…但这一次投出六个同色骰，别说我只是个冒险家，就算我是仙人也打不过啊！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（大赛公告）"
        },
        {
          "role": "大赛公告",
          "text": "欢迎大家在大赛期间光临会场周边各类特色小吃摊。「清心薄荷凉糕」限量热卖中。"
        },
        {
          "role": "留言",
          "text": "这个「清心薄荷凉糕」真的那么好吃吗？我来好几次了，一次都没见到…"
        },
        {
          "role": "回复",
          "text": "兄弟是这几天才来的吧？听说这是仙人喜欢吃的东西，开售第一天就被抢完了。"
        },
        {
          "role": "回复",
          "text": "吃起来挺清爽的，就是的确有点苦。"
        },
        {
          "role": "回复",
          "text": "好苦。"
        },
        {
          "role": "回复",
          "text": "好苦好苦。"
        },
        {
          "role": "回复",
          "text": "好吃。"
        },
        {
          "role": "回复",
          "text": "可恶啊，我更好奇了！这点心什么时候返场？店家赶紧安排起来啊！"
        },
        {
          "role": "回复",
          "text": "说起来…仙人也会玩「七圣召唤」吗？"
        },
        {
          "role": "回复",
          "text": "有趣的东西谁都喜欢吧？"
        }
      ],
