{
  "quest_id": 74060,
  "chapter_num": null,
  "chapter_title": "智勇双拳",
  "type": "wq",
  "route": "Both Brains and Brawn",
  "stories": [
    {
      "story_id": 74060,
      "title": "智勇双拳",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往拳力斗技场"
        },
        {
          "role": "派蒙",
          "text": "欸？你是…格内薇芙对吧？你怎么也在这里？"
        },
        {
          "role": "格内薇芙",
          "text": "我来参加「拳力斗技」。倒是你们…难道你们也要参加？"
        },
        {
          "role": "罗西莫夫",
          "text": "我认识你们。金发的不能参赛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "歧视？",
              "dialogues": [
                {
                  "role": "格内薇芙",
                  "text": "你应该使用更准确的表达。我猜你是想说，旅行者和派蒙两位中，旅行者不得参赛。"
                },
                {
                  "role": "格内薇芙",
                  "text": "毕竟我也是金发，而你刚刚同意了让我参赛。"
                }
              ]
            },
            {
              "text": "我还没说要参加呢。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这场景感觉有些似曾相识…不过状况微妙地反过来了？之前不管是达希还是艾蒂安，都一个劲地怂恿我们参加…"
                }
              ]
            }
          ]
        },
        {
          "role": "罗西莫夫",
          "text": "我就这么说吧，在「拳力斗技」的世界里，观赏性比胜负更重要！"
        },
        {
          "role": "罗西莫夫",
          "text": "你们之前的那些「事迹」我也有所耳闻，让旅行者参加比赛，结果根本就毫无悬念。"
        },
        {
          "role": "罗西莫夫",
          "text": "毫无悬念的比赛没有观赏性可言！所以你要是来参赛，那我不如现在就把奖杯给你好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那太好了，拿来吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂！"
                }
              ]
            },
            {
              "text": "我可以只用一只手。",
              "dialogues": [
                {
                  "role": "罗西莫夫",
                  "text": "哦？那说不定还有几分看头…不行，还是不行，万一真的只用一只手就打完了比赛，那以后的场次还要怎么举办？"
                },
                {
                  "role": "罗西莫夫",
                  "text": "虽说观赏性至上，但是观众的预期管理也是很重要的。"
                }
              ]
            },
            {
              "text": "那让派蒙替我参赛。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那怎么行！我从来都是和旅行者并肩作战的！"
                }
              ]
            }
          ]
        },
        {
          "role": "罗西莫夫",
          "text": "我说要不这样，旅行者以教练的身份参加…就给她当教练好了。"
        },
        {
          "role": "罗西莫夫",
          "text": "最强的教练，配上最弱的选手，是个不错的噱头…哦，我是说「看点」。"
        },
        {
          "role": "罗西莫夫",
          "text": "虽说是娱乐赛，奖品也是很丰富的。多亏了这位小姐的同僚…或者应该说是前同僚？"
        },
        {
          "role": "罗西莫夫",
          "text": "除了特许券，优胜组还将获得枫达奖杯！只要在枫丹科学院出示枫达奖杯，就能随时免费畅饮枫达了！"
        },
        {
          "role": "派蒙",
          "text": "能随时免费畅饮枫达的奖杯？旅行者，我想要这个！"
        },
        {
          "role": "格内薇芙",
          "text": "如果旅行者愿意指导我和布瓦列特，并且我们有幸胜出的话，我非常愿意将枫达奖杯让给两位。"
        },
        {
          "role": "派蒙",
          "text": "欸？真的可以吗？这可是能随时免费畅饮枫达的奖杯啊！"
        },
        {
          "role": "格内薇芙",
          "text": "当然了。不如说，我在下到这里来之前…已经尝得够多了。"
        },
        {
          "role": "派蒙",
          "text": "话说回来，你这次也和布瓦列特组成一队吗？呜哇，该不会雷维和达希也来参赛了吧？"
        },
        {
          "role": "格内薇芙",
          "text": "据我所知，达希是没有参赛的。至于雷维，我想他也不需要参赛吧，毕竟之前拿走了我们的特许券。"
        },
        {
          "role": "旅行者",
          "text": "结果公布之后，他没有还给你们吗？"
        },
        {
          "role": "格内薇芙",
          "text": "没有。不仅如此，在那之后也再没见过他。或许他已经离开了吧。"
        },
        {
          "role": "派蒙",
          "text": "怎么这样！"
        },
        {
          "role": "格内薇芙",
          "text": "过去的失败可能有很多原因。但是现在，仅从效率的角度考虑，参加「拳力斗技」或许是更好的选择吧。"
        },
        {
          "role": "格内薇芙",
          "text": "当然，如果能得到旅行者的帮助的话，那就再好不过了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为了无限畅饮，我来训练你们。",
              "dialogues": []
            },
            {
              "text": "教练的报酬就只有奖杯吗？",
              "dialogues": [
                {
                  "role": "格内薇芙",
                  "text": "除了奖杯，我也愿意提供其他报酬，在我的能力范围内，尽可能优厚的报酬。"
                },
                {
                  "role": "派蒙",
                  "text": "听起来还挺不错的，旅行者，我们就帮帮他们吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "你们愿意帮忙吗？那真是太好了！旅行者教练、派蒙，和我一起去找布瓦列特吧，不知道他有没有成功招揽到新队友。"
        },
        {
          "type": "subtitle",
          "text": "寻找布瓦列特"
        },
        {
          "type": "subtitle",
          "text": "与布瓦列特对话"
        },
        {
          "role": "格内薇芙",
          "text": "布瓦列特，怎么样？他愿意加入我们的队伍吗？"
        },
        {
          "role": "龚古尔",
          "text": "哈哈，我拒绝。"
        },
        {
          "role": "布瓦列特",
          "text": "现在你知道结果了。"
        },
        {
          "role": "龚古尔",
          "text": "虽然侦探笑话很有趣，但是据我的观察，两位在战斗方面的实力可以说是和膨膨兽不相上下。"
        },
        {
          "role": "龚古尔",
          "text": "让我加入你们的队伍，就像是邀我加入甫一登场就要谢幕的演出。"
        },
        {
          "role": "龚古尔",
          "text": "如果有这样的闲工夫，我为什么不去为三枚券剧团的演出排练呢？"
        },
        {
          "role": "布瓦列特",
          "text": "你说的很有道理，但是有一点我要反驳。"
        },
        {
          "role": "龚古尔",
          "text": "请讲。"
        },
        {
          "role": "布瓦列特",
          "text": "虽然之前徒手格斗输给了罗西莫夫，但在那之后我改变了战法，现在至少能和坚盾重甲蟹打个平手了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "坚盾重甲蟹也要参赛？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "应该不可能吧！"
                },
                {
                  "role": "旅行者",
                  "text": "可惜，明明是美味的对手…"
                },
                {
                  "role": "派蒙",
                  "text": "？"
                }
              ]
            },
            {
              "text": "徒手格斗？和罗西莫夫？",
              "dialogues": [
                {
                  "role": "布瓦列特",
                  "text": "是的。现在我也意识到了，那的确是太过鲁莽的选择。所以我决定以后不要徒手。"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "请容我补充一点，旅行者同意对我们进行指导。相信有了旅行者教练的指导，我们胜出的几率会更大。"
        },
        {
          "role": "龚古尔",
          "text": "教练再厉害，也得看选手本身是不是那块料。你刚才说改变了战法？"
        },
        {
          "role": "布瓦列特",
          "text": "是的。近身战斗对我不利，所以我准备了很多瓶子…冰元素的瓶子。"
        },
        {
          "role": "布瓦列特",
          "text": "在赛场上能让对手动作迟缓，赛后还可以请对手喝冰镇枫达增进友谊。"
        },
        {
          "role": "派蒙",
          "text": "好羡慕…不对，冰元素瓶子原来是这么用的吗？"
        },
        {
          "role": "格内薇芙",
          "text": "我用斧子。"
        },
        {
          "role": "派蒙",
          "text": "等等，你不是枫丹科学院的研究员吗？用斧子？"
        },
        {
          "role": "格内薇芙",
          "text": "别担心，斧子对我来说是趁手的工具，因为研究遇到瓶颈时经常去劈柴解压。"
        },
        {
          "role": "旅行者",
          "text": "都不知道该从哪里问起了…"
        },
        {
          "role": "派蒙",
          "text": "要不还是别问那么多了…"
        },
        {
          "role": "龚古尔",
          "text": "我有一个提议，不如我们来一场预演吧。让我见识一下你们的本领，也让旅行者教练熟悉一下你们的作战风格，如何？"
        },
        {
          "role": "龚古尔",
          "text": "至于我要不要加入…就在预演之后再决定吧。"
        },
        {
          "role": "格内薇芙",
          "text": "唔…我认为这是很合理的提议。布瓦列特，你觉得呢？"
        },
        {
          "role": "布瓦列特",
          "text": "很好的提议，如果能早点说就更好了。害我绞尽脑汁想了那么多侦探笑话…"
        },
        {
          "role": "龚古尔",
          "text": "哈哈，虽然想说事不宜迟，我们现在就去拳力斗技场，但是…这位小姐，真的要穿这身衣服上场吗？"
        },
        {
          "role": "格内薇芙",
          "text": "有什么问题吗？我在劈柴时也是穿这身的…"
        },
        {
          "role": "龚古尔",
          "text": "还是换一身便于行动的装束吧。正好，剧团有演出用的戏服，你们等等。"
        },
        {
          "role": "？？？",
          "text": "龚古尔找到一套便于行动的衣物，交给了格内薇芙。"
        },
        {
          "role": "派蒙",
          "text": "她可是你的对手欸，你这样帮她…"
        },
        {
          "role": "龚古尔",
          "text": "如果她因为着装问题落败，那就是我胜之不武了。"
        },
        {
          "role": "格内薇芙",
          "text": "感谢你的体贴。不管预演的结果如何，你是个值得尊敬的对手。"
        },
        {
          "role": "龚古尔",
          "text": "哈哈，现在可以说这句话了，事不宜迟，我们现在就去拳力斗技场吧。只是暂时借一下场地，罗西莫夫应该会通融的。"
        },
        {
          "type": "subtitle",
          "text": "与罗西莫夫对话"
        },
        {
          "role": "格内薇芙",
          "text": "我们想暂时借用一下这里的场地，用作和龚古尔的训练。"
        },
        {
          "role": "罗西莫夫",
          "text": "就这点小事啊？当然没问题。"
        },
        {
          "role": "格内薇芙",
          "text": "旅行者教练和派蒙，就请两位在一旁观战了。"
        },
        {
          "role": "格内薇芙",
          "text": "实话实说，我和布瓦列特在战斗方面…尤其是这类战斗方面的经验很少。所以…"
        },
        {
          "role": "格内薇芙",
          "text": "<color=#00E1FFFF>旅行者教练如果有任何临场的判断，请直接指示。</color>"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "那我要是指挥错了呢…",
              "dialogues": [
                {
                  "role": "格内薇芙",
                  "text": "我相信你的判断。只要不是致命的错误，总有挽回的机会，对吧？"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "那么我们做完热身，就准备上场了。"
        },
        {
          "role": "派蒙",
          "text": "龚古尔总不会比坚盾重甲蟹更强吧？你们要加油啊！"
        },
        {
          "type": "subtitle",
          "text": "在比赛中获胜"
        },
        {
          "type": "subtitle",
          "text": "与龚古尔对话"
        },
        {
          "role": "龚古尔",
          "text": "确实有点本事。"
        },
        {
          "role": "布瓦列特",
          "text": "承让了！"
        },
        {
          "role": "布瓦列特",
          "text": "我等说这句话的机会等了好久了。"
        },
        {
          "role": "格内薇芙",
          "text": "可是我们毕竟有两个人。以龚古尔的高道德标准来看，也属于胜之不武的范畴吧。"
        },
        {
          "role": "龚古尔",
          "text": "不会，这是规则允许的，没有任何问题。而且，我也没有使出全力，毕竟你们都是新手。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没使出全力？真的假的？",
              "dialogues": []
            },
            {
              "text": "为什么不用全力？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "龚古尔",
          "text": "只是试试他们的本领，没必要用全力吧。万一受伤了，岂不是误事。"
        },
        {
          "role": "派蒙",
          "text": "好像也有些道理…话说回来，既然你都认可他们的实力了，那你现在愿意加入我们的队伍了吗？"
        },
        {
          "role": "龚古尔",
          "text": "哈哈，我拒绝。"
        },
        {
          "role": "派蒙",
          "text": "欸——"
        },
        {
          "role": "龚古尔",
          "text": "如果只有他们两个的话，我或许会加入吧。但是有旅行者的话，我的加入就有些多余了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我有这么厉害？我自己怎么不知道。",
              "dialogues": [
                {
                  "role": "龚古尔",
                  "text": "过分的谦虚与傲慢无异，你其实也是明白的吧。"
                }
              ]
            },
            {
              "text": "谢谢夸奖。",
              "dialogues": [
                {
                  "role": "龚古尔",
                  "text": "我只是说出了事实。"
                }
              ]
            }
          ]
        },
        {
          "role": "龚古尔",
          "text": "总之，有旅行者的指导，两位应该能打出精彩的比赛吧。至于我嘛，就在观众席拭目以待了。"
        },
        {
          "role": "龚古尔",
          "text": "对了，虽然我不会在场上与你们并肩作战，但是我很乐意提供一些场外援助。"
        },
        {
          "role": "龚古尔",
          "text": "考虑到两位现在的作战方式还是有些单调…我们去补充一些趁手的家伙吧。当然，还有一些教练或许用得上的东西。"
        },
        {
          "role": "龚古尔",
          "text": "这么一想，我们剧团的好东西还是不少，为什么演出效果却不理想呢？"
        },
        {
          "role": "旅行者",
          "text": "你说的好东西最好真的是好东西。"
        },
        {
          "role": "龚古尔",
          "text": "那当然是了。不废话了，眼见为实，我们去找埃尔瓦德吧。我为剧团订购的东西都堆在他的地盘了。"
        },
        {
          "type": "subtitle",
          "text": "前往「破烂骨头商店」"
        },
        {
          "role": "龚古尔",
          "text": "我为剧团订购的道具应该都在附近…都被装在不那么结实的木箱里了。"
        },
        {
          "role": "龚古尔",
          "text": "找到的话，<color=#00E1FFFF>就直接把箱子拆了吧</color>，不要紧的。"
        },
        {
          "type": "subtitle",
          "text": "与龚古尔对话"
        },
        {
          "role": "格内薇芙",
          "text": "斧子…得小心使用。"
        },
        {
          "type": "subtitle",
          "text": "打碎木箱回收剧团演出道具"
        },
        {
          "type": "subtitle",
          "text": "与龚古尔对话"
        },
        {
          "role": "派蒙",
          "text": "这都是些什么呀…剧团演出真的会用这些东西吗？"
        },
        {
          "role": "龚古尔",
          "text": "可以用不上，但是不能没有。这就是我的信条！"
        },
        {
          "role": "格内薇芙",
          "text": "我对演出之类的一窍不通…但既然龚古尔这么说，想必是有道理的。"
        },
        {
          "role": "布瓦列特",
          "text": "但我们要去的地方不是舞台吧？"
        },
        {
          "role": "龚古尔",
          "text": "既然是娱乐赛，那拳力斗技场也可以被称作是舞台了。期待你们在舞台上大放光彩。"
        },
        {
          "role": "龚古尔",
          "text": "有这些阵前准备，首战应该是稳了。另外，听说你们的对手是蓝色的大块头，我想他块头虽大，也不是你们的对手。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉龚古尔比我更适合当教练…",
              "dialogues": [
                {
                  "role": "龚古尔",
                  "text": "说笑了。我只是提供一点微不足道的协助罢了，之后的指导当然还得仰赖旅行者这样的专家。"
                }
              ]
            },
            {
              "text": "需要我做些什么吗？",
              "dialogues": [
                {
                  "role": "格内薇芙",
                  "text": "首战的对手应该不会那么难对付吧？还是和之前一样，赛中如果有任何临场的判断，请随时指示。"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "旅行者教练，回去找罗西莫夫问问正式比赛开始的时间吧。我们随时都可以上场，全看教练的安排。"
        },
        {
          "role": "龚古尔",
          "text": "我如果有空的话，也会去观赛的。预祝你们晋级成功。"
        },
        {
          "role": "派蒙",
          "text": "你人真好！谢谢你！"
        },
        {
          "role": "龚古尔",
          "text": "哈哈，谢谢布瓦列特的侦探笑话，我要把它们写进剧本里。几位如果有什么好的故事素材，也不要吝啬告诉我啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好啊，我有很多故事可以分享。",
              "dialogues": [
                {
                  "role": "龚古尔",
                  "text": "那真是太好了，等你有空的时候我们再细谈吧。"
                }
              ]
            },
            {
              "text": "那我要署名权和版权费。",
              "dialogues": [
                {
                  "role": "龚古尔",
                  "text": "这些都好商量！"
                }
              ]
            }
          ]
        },
        {
          "role": "布瓦列特",
          "text": "教练都要分身乏术了，现在还是先回去找罗西莫夫吧。"
        },
        {
          "type": "subtitle",
          "text": "与罗西莫夫对话"
        },
        {
          "role": "罗西莫夫",
          "text": "你们这就回来了？"
        },
        {
          "role": "旅行者",
          "text": "速战速决。"
        },
        {
          "role": "布瓦列特",
          "text": "速胜是速战速决，速败也是…"
        },
        {
          "role": "派蒙",
          "text": "怎么突然说起丧气话来了？"
        },
        {
          "role": "罗西莫夫",
          "text": "我猜，他是冰元素瓶子拿得久了所以寒心了，哈哈！"
        },
        {
          "role": "格内薇芙",
          "text": "唔？元素力有这种效果吗？果然，枫丹科学院的方针是正确的，比起元素力这种东西…"
        },
        {
          "role": "罗西莫夫",
          "text": "…你们要是准备好了，随时可以开赛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不解释一下笑话吗？",
              "dialogues": [
                {
                  "role": "格内薇芙",
                  "text": "什么笑话？"
                },
                {
                  "role": "罗西莫夫",
                  "text": "别提了！就当我没说过吧。"
                }
              ]
            },
            {
              "text": "我没问题。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "罗西莫夫",
          "text": "咳咳，说起首战对手的来历，还是有点意思的。他被人给塞进了桶里，桶上还贴了一张字条，上面写着「好好反省吧」。"
        },
        {
          "role": "罗西莫夫",
          "text": "显然，把他塞进桶里的人也来参加拳力斗技的娱乐赛了，如果他赢了你们，就有机会在拳场上给仇家一些颜色瞧瞧。"
        },
        {
          "role": "罗西莫夫",
          "text": "毕竟在拳场以外的地方是禁止私斗的，只有在这赛场上，才不会打赢受罚。虽然打输的话一样都得去医务室。"
        },
        {
          "role": "罗西莫夫",
          "text": "那么各位，准备好上场了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": [
                {
                  "role": "罗西莫夫",
                  "text": "那就请选手和教练都各就各位了。"
                }
              ]
            },
            {
              "text": "再等我一下。",
              "dialogues": [
                {
                  "role": "罗西莫夫",
                  "text": "没问题。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "在比赛中获胜"
        },
        {
          "type": "subtitle",
          "text": "与罗西莫夫对话"
        },
        {
          "role": "罗西莫夫",
          "text": "恭喜研究员和助手！首次参赛的新人首战获胜！"
        },
        {
          "role": "罗西莫夫",
          "text": "至于住在桶里的大哥，也请不要气馁，我们下次娱乐赛再见！"
        },
        {
          "type": "subtitle",
          "text": "与格内薇芙对话"
        },
        {
          "role": "布瓦列特",
          "text": "罗西莫夫这家伙，我可不是研究员助手啊。"
        },
        {
          "role": "格内薇芙",
          "text": "研究员助手也是很好的工作，我认为你可以考虑一下。不如说，枫丹科学院的工作应该比给侦探当助手更有保障。"
        },
        {
          "role": "布瓦列特",
          "text": "我会考虑的，如果之后能离开这里的话…"
        },
        {
          "role": "派蒙",
          "text": "说起来，你们为什么会组成一队啊？感觉你们的职业也没有交集，性格也很不一样呢。"
        },
        {
          "role": "布瓦列特",
          "text": "倒也不是完全没有交集。老实说，在下来之前我正在枫丹科学院调查。原本一切都很顺利，直到遇到了那个美露莘…"
        },
        {
          "role": "布瓦列特",
          "text": "我只是在收集证据而已，她却坚称是盗窃。"
        },
        {
          "role": "旅行者",
          "text": "你所谓的收集证据具体是指？"
        },
        {
          "role": "格内薇芙",
          "text": "将枫丹科学院的资料放进自己的口袋。被认为是盗窃也合情合理。"
        },
        {
          "role": "布瓦列特",
          "text": "是「有问题的资料」。但不管怎么说，我也认罪受罚了。"
        },
        {
          "role": "派蒙",
          "text": "听起来有事件的味道…"
        },
        {
          "role": "布瓦列特",
          "text": "委托的细节我无可奉告。毕竟涉及到委托人的隐私。"
        },
        {
          "role": "格内薇芙",
          "text": "他调查的对象我再熟悉不过了，我就是因为在发表会上打伤了那个人…"
        },
        {
          "role": "布瓦列特",
          "text": "这位女士，请停一下！你这不是把委托细节都给泄露了吗！"
        },
        {
          "role": "格内薇芙",
          "text": "哦！抱歉。这些事和现在的比赛没有关系，的确不应该让教练费心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "报酬加码的话就勉为其难地听一听。",
              "dialogues": [
                {
                  "role": "布瓦列特",
                  "text": "这种既受损又违反职业道德的事…"
                },
                {
                  "role": "派蒙",
                  "text": "他只是开个玩笑啦！对吧？"
                }
              ]
            },
            {
              "text": "枫丹科学院秘辛，好想知道啊！",
              "dialogues": [
                {
                  "role": "布瓦列特",
                  "text": "在「蒸汽鸟报」或者什么侦探小说上应该能看到不少吧…虽然不知道有几分可信。"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "说回正事，以教练的专业眼光来看，我们有哪些可以改善提升的点呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "力量。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？我觉得格内薇芙抡斧子的力气还挺大的…"
                },
                {
                  "role": "格内薇芙",
                  "text": "力量…的确很重要。但是想要在短期内快速提升或许有些难度吧…"
                },
                {
                  "role": "布瓦列特",
                  "text": "「纯洁之水」的效果也是有限的。"
                },
                {
                  "role": "派蒙",
                  "text": "想要在短期内看到成果的话，做些技巧训练也许会更好？"
                }
              ]
            },
            {
              "text": "命中率。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "的确，打不到的话就是白费力气呢。"
                }
              ]
            },
            {
              "text": "速度。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "只要速度够快，不仅可以闪避对方的攻击，还可以在同样的时间里多发出几次攻击！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔，既然格内薇芙和布瓦列特都要投掷…别管是冰元素瓶子还是演出用爆竹了，如果能扔得又快又准，应该能在赛场上取得优势吧？"
        },
        {
          "role": "布瓦列特",
          "text": "那咱们找个地方练习投掷技巧？"
        },
        {
          "role": "格内薇芙",
          "text": "如果有什么不会干扰到其他人的地方…"
        },
        {
          "role": "派蒙",
          "text": "海蚀裂隙那附近的空地…应该可以？总之，我们先过去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "前往海蚀裂隙"
        },
        {
          "type": "subtitle",
          "text": "与格内薇芙对话"
        },
        {
          "role": "派蒙",
          "text": "在这里练习投掷应该没问题吧！"
        },
        {
          "role": "格内薇芙",
          "text": "之前龚古尔给我们的那些道具里应该有能用得上的…"
        },
        {
          "role": "？？？",
          "text": "格内薇芙和布瓦列特布置好了场地…"
        },
        {
          "role": "布瓦列特",
          "text": "虽然有些简陋…不过应该够用。对了，如果教练能演示一下就更好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小事一桩。",
              "dialogues": []
            },
            {
              "text": "看好了，是这样解决的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "那就拜托教练了。"
        },
        {
          "type": "subtitle",
          "text": "为两人示范投掷技巧"
        },
        {
          "type": "subtitle",
          "text": "与布瓦列特对话"
        },
        {
          "role": "派蒙",
          "text": "怎么样？学会了吗？"
        },
        {
          "role": "布瓦列特",
          "text": "道理我都懂，可是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我再演示一遍？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "与其旅行者再演示一遍，不如让他们自己练一下？"
                }
              ]
            },
            {
              "text": "光懂道理没用吧，得自己上手。",
              "dialogues": [
                {
                  "role": "格内薇芙",
                  "text": "嗯，肌肉记忆是很重要的。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "说起来，布瓦列特戴着眼镜，视力不好也会影响到投掷的准头吧。"
        },
        {
          "role": "布瓦列特",
          "text": "哦，我这个是变装用的眼镜，没有度数。"
        },
        {
          "role": "派蒙",
          "text": "欸？那在赛场上也戴着它不碍事吗？"
        },
        {
          "role": "布瓦列特",
          "text": "只要把眼镜当成身体的一部分就好了。况且，摘了眼镜的话大家就认不出我了。"
        },
        {
          "role": "派蒙",
          "text": "怎么可能！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么可能！",
              "dialogues": []
            },
            {
              "text": "感觉所有人都长得好像…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布瓦列特",
          "text": "先不提眼镜了…到头来还是只能做这种朴素的训练啊，就像侦探助手的日常一样。到去过一百次的地方找一些微不足道的线索…"
        },
        {
          "role": "格内薇芙",
          "text": "脚踏实地的努力在任何领域都是有效的。教练都亲自示范了，你不应该在付出努力以前就否认努力是有效的。"
        },
        {
          "role": "派蒙",
          "text": "对啊，看不起脚踏实地的努力的家伙，最后肯定会吃亏的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不是想获胜吗？拿出点干劲来！",
              "dialogues": [
                {
                  "role": "布瓦列特",
                  "text": "是的教练！好的教练！"
                }
              ]
            },
            {
              "text": "那我陪你对练，我会使出全力。",
              "dialogues": [
                {
                  "role": "布瓦列特",
                  "text": "我现在就去练习投掷！"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "在赛前保持手感也是很重要的。之后我们就轮流训练吧，其中一个人练习投掷时另外一个人在一旁检查动作是否标准。"
        },
        {
          "role": "布瓦列特",
          "text": "就这么办吧。"
        },
        {
          "role": "格内薇芙",
          "text": "那么旅行者教练、派蒙，过一段时间，等下一轮比赛开始时，我们在赛场会合吧。"
        },
        {
          "role": "派蒙",
          "text": "好啊。布瓦列特可不要偷懒哦！"
        },
        {
          "type": "subtitle",
          "text": "于次日18点~22点前往拳力斗技场"
        },
        {
          "role": "格内薇芙",
          "text": "不知道下一场的对手会是谁…"
        },
        {
          "type": "subtitle",
          "text": "与罗西莫夫对话"
        },
        {
          "role": "派蒙",
          "text": "你已经到了呀，格内薇芙呢？"
        },
        {
          "role": "布瓦列特",
          "text": "她去换衣服了，比赛开始之前就会回来。"
        },
        {
          "role": "罗西莫夫",
          "text": "你们的对手倒是准备好了，随时都可以开始。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那等格内薇芙回来就开始吧。",
              "dialogues": [
                {
                  "role": "罗西莫夫",
                  "text": "期待各位的表现！"
                }
              ]
            },
            {
              "text": "我还有点事，稍等。",
              "dialogues": [
                {
                  "role": "罗西莫夫",
                  "text": "没问题！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "在比赛中获胜"
        },
        {
          "type": "subtitle",
          "text": "与罗西莫夫对话"
        },
        {
          "role": "罗西莫夫",
          "text": "要借用场地？当然没问题！"
        },
        {
          "role": "罗西莫夫",
          "text": "怎会如此！远道而来的异国武士居然输给了文弱研究员和助手！！"
        },
        {
          "role": "罗西莫夫",
          "text": "新人的好运还会继续吗！下一场比赛，让我们拭目以待！"
        },
        {
          "type": "subtitle",
          "text": "寻找格内薇芙"
        },
        {
          "type": "subtitle",
          "text": "与格内薇芙对话"
        },
        {
          "role": "尚帕隆",
          "text": "我警告你，在赛场以外的地方动手是要罪加一等的！"
        },
        {
          "role": "格内薇芙",
          "text": "事到如今我还在乎这个？"
        },
        {
          "role": "尚帕隆",
          "text": "你这暴力女，连脑子都是肌肉做的吗？难怪拿不出成果就想用假数据蒙混过关…"
        },
        {
          "role": "格内薇芙",
          "text": "我才是要警告你，你的指控没有切实的证据，你这是诽谤。"
        },
        {
          "role": "尚帕隆",
          "text": "这就急了？急也没用！"
        },
        {
          "role": "尚帕隆",
          "text": "你不如想想出去之后怎么给博絮埃先生谢罪吧，如果你还有机会出去。"
        },
        {
          "role": "尚帕隆",
          "text": "哈，这么说来我还得谢谢你呢，多亏了你学术造假的案子，博絮埃先生引咎卸任了。"
        },
        {
          "role": "尚帕隆",
          "text": "雷蒙多一个人怎么撑得起整个枫丹科学院的研究项目？等我出去了…"
        },
        {
          "role": "布瓦列特",
          "text": "虽说梅洛彼得堡是不见天日的地方，但没想到会有人不分时间不分场合就开始做梦呢。"
        },
        {
          "role": "尚帕隆",
          "text": "你又是谁？这跟你有什么关系？"
        },
        {
          "role": "布瓦列特",
          "text": "我？如您所见，我只是个助手，是个无名小卒，不值得一提。"
        },
        {
          "role": "布瓦列特",
          "text": "大家都是参赛选手，在赛场之外就和气一点嘛。我这儿有冰镇的健康饮料，很甜的，要不要来一杯？"
        },
        {
          "role": "尚帕隆",
          "text": "什么东西…不对，我又不是参赛选手。"
        },
        {
          "role": "布瓦列特",
          "text": "啧，居然不上当。"
        },
        {
          "role": "尚帕隆",
          "text": "我可没有沦落到要用蛮力证明自己的价值。不像某些人，比起枫丹科学院的实验室，山里的樵夫小屋才是合适的归宿…"
        },
        {
          "role": "？？？",
          "text": "格内薇芙给了对方一拳。"
        },
        {
          "role": "尚帕隆",
          "text": "你…私斗是…你们都看到了吧？！私斗可是禁止行为！"
        },
        {
          "role": "布瓦列特",
          "text": "哎呀抱歉，刚才摘了眼镜，我的视力真的很差，什么都没看到。"
        },
        {
          "role": "派蒙",
          "text": "怎么突然问我们？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我刚来，发生什么事了？",
              "dialogues": [
                {
                  "role": "尚帕隆",
                  "text": "好啊，一个两个都挺会演的嘛。"
                }
              ]
            },
            {
              "text": "是她单方面打你，不算私斗吧。",
              "dialogues": [
                {
                  "role": "布瓦列特",
                  "text": "要不你先还手？不过这样的话你也罪加一等了。"
                }
              ]
            }
          ]
        },
        {
          "role": "尚帕隆",
          "text": "得意忘形的混账东西…你们也得意不了多久了，等着瞧吧！我的「维埃利式强化机关」会证明一切的…"
        },
        {
          "role": "？？？",
          "text": "男人离开了…"
        },
        {
          "role": "派蒙",
          "text": "刚才到底是怎么回事呀？"
        },
        {
          "role": "格内薇芙",
          "text": "抱歉，让你们看笑话了。我…我其实是个急性子，虽然平时都努力保持理性客观中立…但是有时候还是忍不住…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "急性子也不能打人吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你刚才一句话不说，突然给他一拳，吓坏我了！"
                }
              ]
            },
            {
              "text": "他不会说话，迟早挨打。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我也觉得他说的话挺欠揍的…但是突然打人还是不太好吧？"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "嗯…抱歉，我已经在反省了。"
        },
        {
          "role": "派蒙",
          "text": "话说回来，他到底是谁啊？"
        },
        {
          "role": "布瓦列特",
          "text": "尚帕隆。他是枫丹科学院的高级研究员，原本和雷蒙多一派不睦，博絮埃失势之后他大概是觉得自己有机会了吧。"
        },
        {
          "role": "布瓦列特",
          "text": "但看来雷蒙多不准备给他这个机会。真遗憾哪，如果他能和雷蒙多平起平坐，那「蒸汽鸟报」怎么说也得为我留一个专栏版面。"
        },
        {
          "role": "派蒙",
          "text": "为什么？还有，你怎么知道得这么清楚？好可疑喔…"
        },
        {
          "role": "布瓦列特",
          "text": "因为我在枫丹科学院被捕…不对，进行现场取证的时候，主要调查的对象就是他嘛。那些有问题的资料也都是与他有关的。"
        },
        {
          "role": "布瓦列特",
          "text": "其实那时我和他见过几次。不过看他刚才的样子，完全没认出我。"
        },
        {
          "role": "派蒙",
          "text": "哦…"
        },
        {
          "role": "派蒙",
          "text": "等一下，你这不是泄露委托内容了吗！委托人的隐私呢！侦探的职业操守呢！"
        },
        {
          "role": "布瓦列特",
          "text": "他都在梅洛彼得堡了，说明委托已经作废了。不仅如此，我的好叔叔，之前给他发信询问，他只回复说少安毋躁…"
        },
        {
          "role": "布瓦列特",
          "text": "我就知道有蹊跷！看来他是早就知道，所以压根不打算帮我了，亏我这些年来一直替他跑腿，还任由他在小说里把我写成配角…"
        },
        {
          "role": "格内薇芙",
          "text": "他会出现在这里也不奇怪。他在枫丹科学院的风评可不怎么好，我想那些恶评并非空穴来风。"
        },
        {
          "role": "格内薇芙",
          "text": "啊…我的确是因为在发表会上把他打伤了才下来的，当然，还有一些其他原因…但是刚才说的他的风评不好是公开的事实。"
        },
        {
          "role": "格内薇芙",
          "text": "如果你们不相信我，可以去问其他枫丹科学院的相关人士…"
        },
        {
          "role": "旅行者",
          "text": "没这个必要。"
        },
        {
          "role": "派蒙",
          "text": "嗯。比起这个，他走之前的话反而比较让人在意呢。他不是没参加比赛吗？"
        },
        {
          "role": "派蒙",
          "text": "而且这不过是场娱乐赛而已，有什么搞阴谋诡计的必要吗…"
        },
        {
          "role": "格内薇芙",
          "text": "根据他一贯的做派，或许是想借这个机会展示自己的能力，攀附梅洛彼得堡的有力人士吧。"
        },
        {
          "role": "派蒙",
          "text": "枫丹科学院的工程师，我们之前也见过啦，比如克兰茨之类的…这个叫尚帕隆的有什么特殊的能力吗？"
        },
        {
          "role": "格内薇芙",
          "text": "他在专业上倒是没什么值得一提的建树，不过对于经营人脉和投机取巧还是很有一套的…唔…应该不至于吧？"
        },
        {
          "role": "布瓦列特",
          "text": "怎么了，难不成他能在这儿变出十二个比罗西莫夫更健硕的工程师来当我们的对手？"
        },
        {
          "role": "格内薇芙",
          "text": "笨蛋，比那个更麻烦。他刚才不是说了吗？「维埃利式强化机关」…"
        },
        {
          "role": "格内薇芙",
          "text": "他可能会让改造过的发条机关替他上场，那是和梅洛彼得堡生产的量产型警卫机关不同的，更强力的发条机关。"
        },
        {
          "role": "派蒙",
          "text": "这也太夸张了吧！而且，发条机关甚至都不是人类了，为什么可以参加「拳力斗技」的比赛啊？"
        },
        {
          "role": "布瓦列特",
          "text": "娱乐赛也没规定选手必须是人类。曾经还有人在废弃生产区抓到了坚盾重甲蟹，就让它代替自己参赛…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来打个平手是真事啊。",
              "dialogues": []
            },
            {
              "text": "好离谱。",
              "dialogues": [
                {
                  "role": "布瓦列特",
                  "text": "毕竟重点是娱乐嘛。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我是觉得不太可能啦…不过万一是真的，你们…"
        },
        {
          "role": "布瓦列特",
          "text": "那我就投降咯。虽然很对不起教练，但是那可不是我经过什么训练就能打败的对手。这点自知之明我还是有的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别放弃啊！我能做到你也能做到！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "旅行者，你想想你跟他的战力差距，这不是加油鼓劲能解决的问题吧！"
                }
              ]
            },
            {
              "text": "投降吧，这并不丢脸。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "想想看，这也是没办法的事吧？布瓦列特也只是个柔弱的助手而已…"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "…也不是完全没有胜算。如果能够利用芒荒能量互相湮灭的效果弱化发条机关的话…就算是我们也是有获胜的可能的。"
        },
        {
          "role": "格内薇芙",
          "text": "我有个点子，不过这里也不是说话的地方…不如我们先去生产区找一个光线更好的地方再说吧。"
        },
        {
          "type": "subtitle",
          "text": "前往生产区"
        },
        {
          "type": "subtitle",
          "text": "与布瓦列特对话"
        },
        {
          "role": "派蒙",
          "text": "格内薇芙，现在可以说了吧！到底是什么点子？"
        },
        {
          "role": "格内薇芙",
          "text": "直接说结论的话，就是之前说的，利用芒荒能量互相湮灭的效果弱化发条机关，制造进攻机会。"
        },
        {
          "role": "布瓦列特",
          "text": "这完全超出我的能力范围了，告辞。"
        },
        {
          "role": "格内薇芙",
          "text": "你先别走！不如说，此事非你不可。"
        },
        {
          "role": "格内薇芙",
          "text": "只要经过一定的处理，芒荒能量也是可以装进容器里的，哪怕是你的糖玻璃瓶子。"
        },
        {
          "role": "格内薇芙",
          "text": "因为我更熟悉发条机关的弱点…我是说，结构上的弱点。所以，接近进攻的任务交给我更合适。"
        },
        {
          "role": "派蒙",
          "text": "哦…听起来好像有点道理。而且正好之前布瓦列特有练习过投掷呢！命中率和速度应该都有提升才对。"
        },
        {
          "role": "布瓦列特",
          "text": "但是我根本就不懂什么芒荒能量互相湮灭之类的原理…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说实话我也完全不懂。",
              "dialogues": []
            },
            {
              "text": "只要用心感受，应该能理解的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "我们现在不是在做研究，不需要完全搞清楚原理，只要知道某个行动会导致某个结果就够了。"
        },
        {
          "role": "格内薇芙",
          "text": "先准备好场地吧。"
        },
        {
          "role": "？？？",
          "text": "格内薇芙和布瓦列特布置好了场地…"
        },
        {
          "role": "派蒙",
          "text": "…这也是龚古尔之前交给我们的舞台道具里的东西吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么舞台会用到这种东西？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…可能是以枫丹科学院为背景的教育话剧吧！芒荒的教育…之类的！"
                }
              ]
            },
            {
              "text": "他怎么什么都买？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "他之前不是说过宁可用不上也不能没有吗？真想看看三枚券剧团的仓库…要是有的话！"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "现在场地已经没问题了，至于芒荒能量相互湮灭的现象嘛…就劳烦旅行者教练演示一下了。"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "格内薇芙",
          "text": "教练演示一遍就足够了，之后就由我监督布瓦列特训练，直到他完全理解自己应该做什么。"
        },
        {
          "role": "布瓦列特",
          "text": "有这么难吗？应该不难吧？"
        },
        {
          "role": "格内薇芙",
          "text": "唉…那就看你的悟性了。"
        },
        {
          "type": "subtitle",
          "text": "为布瓦列特展示芒荒能量的湮灭效果"
        },
        {
          "type": "subtitle",
          "text": "与布瓦列特对话"
        },
        {
          "role": "布瓦列特",
          "text": "呃…我算是帮上忙了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你，布瓦列特。",
              "dialogues": [
                {
                  "role": "布瓦列特",
                  "text": "是真的感谢还是别有意味的感谢？"
                }
              ]
            },
            {
              "text": "你要是不出手那可帮大忙了。",
              "dialogues": [
                {
                  "role": "布瓦列特",
                  "text": "我就知道…"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "总之，旅行者教练、派蒙，我们还是下场比赛开始之前，在赛场见吧。"
        },
        {
          "role": "派蒙",
          "text": "好吧…布瓦列特，要活下来啊！"
        },
        {
          "role": "布瓦列特",
          "text": "为什么你的语气好像要和芒荒能量一起湮灭的是我？现在不是在演什么生离死别的场景吧！"
        },
        {
          "type": "subtitle",
          "text": "于次日18点~22点前往拳力斗技场"
        },
        {
          "role": "格内薇芙",
          "text": "我们一定会赢的…"
        },
        {
          "type": "subtitle",
          "text": "与罗西莫夫对话"
        },
        {
          "role": "派蒙",
          "text": "你好呀，布瓦列特。之前的训练有效果吗？"
        },
        {
          "role": "布瓦列特",
          "text": "我已经完全理解了芒荒能量互相湮灭的原理。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就麻烦你十六字以内概括一下吧。",
              "dialogues": []
            },
            {
              "text": "恭喜，这下真可以当研究员助手了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布瓦列特",
          "text": "抱歉我开玩笑的，其实我还是完全没理解…不过我很清楚自己该做什么。"
        },
        {
          "role": "罗西莫夫",
          "text": "那就好！这场的对手可是「重量级」，哈哈！"
        },
        {
          "role": "罗西莫夫",
          "text": "如何？准备好上场了吗？"
        },
        {
          "role": "布瓦列特",
          "text": "我没问题。待会儿临场指挥就拜托旅行者教练了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就开始吧。",
              "dialogues": [
                {
                  "role": "罗西莫夫",
                  "text": "请选手和教练各就各位！"
                }
              ]
            },
            {
              "text": "我还有点事，稍等。",
              "dialogues": [
                {
                  "role": "罗西莫夫",
                  "text": "没问题！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "在比赛中获胜"
        },
        {
          "type": "subtitle",
          "text": "与罗西莫夫对话"
        },
        {
          "role": "罗西莫夫",
          "text": "真是精彩的比赛！恭喜研究员和助手！以及他们的教练旅行者！"
        },
        {
          "role": "罗西莫夫",
          "text": "但是插播一条突发消息！那就是…现在进入加时赛环节！"
        },
        {
          "role": "罗西莫夫",
          "text": "看到两位在场上的活跃表现，我也热血沸腾，加时赛就让我来当两位的对手吧！"
        },
        {
          "role": "罗西莫夫",
          "text": "出招吧！"
        },
        {
          "type": "subtitle",
          "text": "在比赛中获胜"
        },
        {
          "type": "subtitle",
          "text": "与罗西莫夫对话"
        },
        {
          "role": "罗西莫夫",
          "text": "我输得心服口服。两位果真是人不可貌相啊，哈哈！"
        },
        {
          "role": "布瓦列特",
          "text": "之…之前也没说过有加…加时赛啊…累…累死我了…"
        },
        {
          "role": "罗西莫夫",
          "text": "意料之外的情节展开也是娱乐赛的一部分嘛！"
        },
        {
          "role": "罗西莫夫",
          "text": "就像赛场上的舞台用爆竹！还有散发香甜气味的糖玻璃瓶子！"
        },
        {
          "role": "罗西莫夫",
          "text": "话不多说，几位要现在领奖吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉忘了什么事…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "有吗？我完全想不到…那应该不是什么要紧的事吧！"
                }
              ]
            },
            {
              "text": "枫达奖杯！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "无限畅饮！"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "…尚帕隆到哪儿去了？"
        },
        {
          "role": "派蒙",
          "text": "对哦！"
        },
        {
          "role": "布瓦列特",
          "text": "他引以为傲的什么强化机关都被我们拆了，他本人留在这儿不是自取其辱？"
        },
        {
          "role": "格内薇芙",
          "text": "正因为如此，正因为我们拆了他引以为傲的作品，他应该不会善罢甘休。"
        },
        {
          "role": "罗西莫夫",
          "text": "你们可是冠军，而且胜过了我！无论面对怎样的强敌，肯定都不在话下。"
        },
        {
          "role": "布瓦列特",
          "text": "话…话是这么说，连续两场比赛下来消耗了不少体力，我现在只想找个地方坐下歇会儿…"
        },
        {
          "role": "布瓦列特",
          "text": "别说什么强敌了，现在就是来只狗我也打不过啊。"
        },
        {
          "role": "？？？",
          "text": "尚帕隆回来了，还带了一些「同伴」…"
        },
        {
          "role": "尚帕隆",
          "text": "我的「维埃利式强化机关」…你们居然拆了我的「维埃利式强化机关」！"
        },
        {
          "role": "尚帕隆",
          "text": "比赛还没结束！"
        },
        {
          "role": "格内薇芙",
          "text": "唔…交给我吧，我还能战斗！"
        },
        {
          "role": "派蒙",
          "text": "欸？你别逞强了！"
        },
        {
          "role": "旅行者",
          "text": "看来轮到我出手了。"
        },
        {
          "role": "派蒙",
          "text": "嗯！就让旅行者教练露一手给你们瞧瞧！"
        },
        {
          "type": "subtitle",
          "text": "击败发条机关"
        },
        {
          "type": "subtitle",
          "text": "与尚帕隆对话"
        },
        {
          "role": "尚帕隆",
          "text": "别拆了！你快停手！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有吗？我还没拆够呢。",
              "dialogues": [
                {
                  "role": "尚帕隆",
                  "text": "你…这都是摩拉，都是特许券啊！"
                }
              ]
            },
            {
              "text": "那就中场休息。",
              "dialogues": [
                {
                  "role": "尚帕隆",
                  "text": "你还想打下半场啊？！"
                }
              ]
            }
          ]
        },
        {
          "role": "尚帕隆",
          "text": "你们可真是一群疯子…我惹不起，惹不起！"
        },
        {
          "role": "尚帕隆",
          "text": "上次也是…我早该明白的。就当我倒霉吧，我认输，我走。"
        },
        {
          "role": "罗西莫夫",
          "text": "那我们去别处商量一下赔偿方案吧，看看，你把我心爱的比赛场地搞得一团乱…"
        },
        {
          "role": "罗西莫夫",
          "text": "对了，还得先给冠军队伍颁奖！这些是你们应得的奖励，请收好。"
        },
        {
          "role": "？？？",
          "text": "罗西莫夫和尚帕隆离开了…"
        },
        {
          "role": "派蒙",
          "text": "真是的，原来根本没什么大不了的嘛，害我们白费一些功夫…"
        },
        {
          "role": "派蒙",
          "text": "不过，旅行者战斗的样子还是很帅气的！嘿嘿。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是啊，好好学学。",
              "dialogues": [
                {
                  "role": "布瓦列特",
                  "text": "对我来说可能有些困难吧…"
                }
              ]
            },
            {
              "text": "也没有那么帅气啦。",
              "dialogues": [
                {
                  "role": "格内薇芙",
                  "text": "教练也太谦虚了。"
                }
              ]
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "之前约定好的冠军奖杯就交给旅行者教练和派蒙了，还有特许券…"
        },
        {
          "role": "格内薇芙",
          "text": "抱歉最后还是劳烦教练亲自出手，按道理应该再追加报酬，但是我们的确也很需要这些特许券，只能在能力范围内多给一些了…"
        },
        {
          "role": "派蒙",
          "text": "对哦，你们的特许券都被雷维给…没关系的啦，我们只取约定的那部分就好，你说呢，旅行者？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我没意见。",
              "dialogues": []
            },
            {
              "text": "我也不是铁石心肠之人…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "格内薇芙",
          "text": "旅行者教练、派蒙，感谢你们。"
        },
        {
          "role": "派蒙",
          "text": "话说回来，既然拿到了冠军，又获得了很多特许券，你们之后有什么打算吗？"
        },
        {
          "role": "格内薇芙",
          "text": "我在考虑离开这里之后的事…"
        },
        {
          "role": "格内薇芙",
          "text": "虽然之前说过，学术造假的指控没有切实的证据，但是同样的，我没能复现之前的实验结果也是事实…"
        },
        {
          "role": "格内薇芙",
          "text": "我会继续之前的研究，想办法证明自己。"
        },
        {
          "role": "布瓦列特",
          "text": "这里也挺不错的，不过还是梅洛彼得堡以外的地方适合我。对侦探来说，这里不论是客户还是工作都太少…基本就是没有吧！"
        },
        {
          "role": "布瓦列特",
          "text": "但是枫丹的侦探业竞争也太激烈了…唔，或许去外国拓展事业也是不错的选择。"
        },
        {
          "role": "布瓦列特",
          "text": "旅行者教练原本也是四处旅行的旅行者吧，说不定我们某天会在别处相见呢。"
        },
        {
          "role": "派蒙",
          "text": "看来你们都有自己的计划呢。那就祝你们都能实现自己的目标！"
        },
        {
          "role": "布瓦列特",
          "text": "希望下次再见的时候我已经不用在叔叔的小说里当配角了，哈哈。"
        },
        {
          "role": "格内薇芙",
          "text": "谢谢你们。也祝你们一切顺利！"
        },
        {
          "role": "布瓦列特",
          "text": "糖还够用吗…真浪费啊。"
        },
        {
          "role": "罗西莫夫",
          "text": "准备好观赛了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": [
                {
                  "role": "罗西莫夫",
                  "text": "那就开始吧。"
                }
              ]
            },
            {
              "text": "再等我一下。",
              "dialogues": [
                {
                  "role": "罗西莫夫",
                  "text": "没问题。"
                }
              ]
            }
          ]
        },
        {
          "role": "龚古尔",
          "text": "既然到了拳力斗技场，我就是「龚古尔四世」了。你们可以叫我「四世」。"
        }
      ]
    }
  ]
}