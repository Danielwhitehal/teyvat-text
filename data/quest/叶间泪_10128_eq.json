{
  "quest_id": 10128,
  "chapter_num": "游水酝诗籍 第二首",
  "chapter_title": "叶间泪",
  "type": "eq",
  "route": "Tears Among the Leaves",
  "stories": [
    {
      "story_id": 40124,
      "title": "叶间泪",
      "description": "行游采风、寻物赏景…在吟诗作对的欢笑间，似有淡淡的哀情显现…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到第二天白天（8-10点）"
        },
        {
          "role": "派蒙",
          "text": "时间差不多了，我们去会场看看吧。"
        },
        {
          "role": "派蒙",
          "text": "我还想知道重云遇到的到底是什么呢。"
        },
        {
          "type": "subtitle",
          "text": "前往活动会场"
        },
        {
          "role": "派蒙",
          "text": "哇，大家都来得好早。"
        },
        {
          "role": "温迪",
          "text": "今天阳光正好，等那片叶子飘过石门的时候，就为各位揭晓今天的诗歌主题吧。"
        },
        {
          "role": "胡桃",
          "text": "「两国诗歌握手言欢会」第二日的主题是——对对子！"
        },
        {
          "role": "诺艾尔",
          "text": "（对对子？我记得是璃月那边依据某些规则进行创作的文字艺术，像是…诗歌的填字游戏？）"
        },
        {
          "role": "胡桃",
          "text": "天对地，雨对风。大陆对长空。林猪对海虾，堇瓜对松茸！"
        },
        {
          "role": "胡桃",
          "text": "依据已有的上句，创作诗歌的下句。只要从身边事物出发得到灵感，就一点不难。"
        },
        {
          "role": "胡桃",
          "text": "上下句工整，意境与韵律相辅相成，在任何一种诗歌体裁中都是互通的嘛。"
        },
        {
          "role": "温迪",
          "text": "为了让大家多捕捉一些灵感之风，对出更为精彩的诗句，今天的大会特别加入「采风」环节。"
        },
        {
          "role": "米卡",
          "text": "（…「采风」？）"
        },
        {
          "role": "胡桃",
          "text": "所谓采风，就是到野外走走看看，把适合写进诗里的意象装进兜里。"
        },
        {
          "role": "胡桃",
          "text": "当然，在这过程中还请各位新老朋友注意安全。往生堂这个月的单子已经达标，再多的话开心的只有我一个。"
        },
        {
          "role": "温迪",
          "text": "总之，请大家尽情自由行动，在享受两地美丽风光的同时，构想优美的诗句吧！我们傍晚在此会合。"
        },
        {
          "role": "温迪",
          "text": "旅行者，能帮我召集行秋、重云，还有蒙德的几位朋友吗？有事想拜托你们。"
        },
        {
          "role": "派蒙",
          "text": "哦，是昨天的那件事吧！"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "温迪",
          "text": "嘿嘿，那就辛苦你啦。"
        },
        {
          "type": "subtitle",
          "text": "花了些时间将大家聚集到一起，简要描述了事情原委…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "温迪",
          "text": "简单来说，希望各位在外「采风」的同时，多留意一下。"
        },
        {
          "role": "重云",
          "text": "这样真的可以吗？明明是我自己遇到的问题，却要来麻烦大家…"
        },
        {
          "role": "米卡",
          "text": "重云先生别这么说，琴团长嘱咐过我们，大会的本意就是促进大家合作交流。互相帮忙，是最正常不过的事了。"
        },
        {
          "role": "诺艾尔",
          "text": "查明蒙德周边发生的异常，向骑士团汇报，也是我们的工作之一。"
        },
        {
          "role": "迪奥娜",
          "text": "我也不在意啦，正好顺路找些调酒的材料。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，就当成和朋友们去郊游，不也挺好吗？"
        },
        {
          "role": "旅行者",
          "text": "不必有负担。"
        },
        {
          "role": "行秋",
          "text": "我看你就老老实实接受这些好意吧。"
        },
        {
          "role": "重云",
          "text": "好吧，谢谢大家。这个人情我定会择日相报。"
        },
        {
          "role": "温迪",
          "text": "那我看，不如各位结成两队，分头行动。"
        },
        {
          "role": "米卡",
          "text": "为了搜索更多地方吗？"
        },
        {
          "role": "温迪",
          "text": "也不全是，哎呀，可别忘了我们的主题，是「诗歌大会」呀！"
        },
        {
          "role": "温迪",
          "text": "如果「采风」时看到的景色一模一样，要怎么想出独具特色的诗对呢？"
        },
        {
          "role": "重云",
          "text": "也对…但要怎么分组呢？"
        },
        {
          "role": "温迪",
          "text": "不如直接「抽签」？"
        },
        {
          "role": "派蒙",
          "text": "哦！越来越有郊游的感觉了呢！"
        },
        {
          "role": "米卡",
          "text": "（抽签吗…唔，要是和璃月朋友抽到了一起，说不上话怎么办…）"
        },
        {
          "role": "温迪",
          "text": "纸条在这里，有谁想先抽吗？"
        },
        {
          "role": "派蒙",
          "text": "我要第一个！"
        },
        {
          "type": "subtitle",
          "text": "众人依次完成了抽签…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "温迪",
          "text": "嗯，那就是旅行者和派蒙、迪奥娜、重云为一组，行秋、米卡和诺艾尔为另一组。"
        },
        {
          "role": "米卡",
          "text": "（太好了…还有诺艾尔前辈在…）"
        },
        {
          "role": "行秋",
          "text": "还请二位多多担待了。"
        },
        {
          "role": "米卡",
          "text": "不敢当，不敢当…"
        },
        {
          "role": "重云",
          "text": "我也有劳各位了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不必拘谨。",
              "dialogues": []
            },
            {
              "text": "很期待一起郊游。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "行秋",
          "text": "保重喽，各位傍晚再见。"
        },
        {
          "role": "迪奥娜",
          "text": "还有什么忘带的东西吗？我们也走吧。"
        },
        {
          "role": "重云",
          "text": "（哇…那耳朵和尾巴是真的吗？毛茸茸的…）"
        },
        {
          "role": "重云",
          "text": "好，迪奥娜小姐有什么想去的地方吗？"
        },
        {
          "role": "迪奥娜",
          "text": "叫我迪奥娜就好。既然要找东西的话，先去重云你遇到它的地方吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "出发吧，「采风」开始。",
              "dialogues": [
                {
                  "role": "重云",
                  "text": "嗯，那我来为大家带路。"
                }
              ]
            },
            {
              "text": "带路吧，重云队长。",
              "dialogues": [
                {
                  "role": "重云",
                  "text": "队长？你，你就别捉弄我啦。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "在不远处山头看着大会的魈也离开了…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "额外对话（温迪）"
        },
        {
          "role": "温迪",
          "text": "祝你们采风愉快，期待晚上的精彩诗对。"
        },
        {
          "type": "subtitle",
          "text": "随重云前往事件发生的地方"
        },
        {
          "role": "重云",
          "text": "出现地点就在那边，靠近水的地方。但当时起了些雾，没能看清它的形貌。"
        },
        {
          "role": "迪奥娜",
          "text": "唔…虽然风景很好看，但总觉得这附近有些荒凉。重云平时都到这样的地方散步吗？"
        },
        {
          "role": "重云",
          "text": "并不是「散步」，我是来练功的。"
        },
        {
          "role": "迪奥娜",
          "text": "练功？像骑士一样的战斗训练吗？"
        },
        {
          "role": "重云",
          "text": "唔，有所不同。我是璃月方士，平时练的是降妖驱邪那一类方术。"
        },
        {
          "role": "迪奥娜",
          "text": "降妖驱邪？"
        },
        {
          "role": "重云",
          "text": "我一直想向大家证明这很厉害，可惜…从没遇上机会。"
        },
        {
          "role": "派蒙",
          "text": "重云他是千年一遇的「纯阳之体」，妖邪们见到他都得躲着走呢。"
        },
        {
          "role": "迪奥娜",
          "text": "嗯？这不是好事吗？"
        },
        {
          "role": "重云",
          "text": "一点都不好，哪有遇不到妖邪的方士嘛…因为这体质的缘故，还常有人质疑我是个装神弄鬼的江湖骗子。"
        },
        {
          "role": "魈",
          "text": "此等体质，比如今方士流传下的术法更为稀有。还是珍惜为好。"
        },
        {
          "role": "重云",
          "text": "降魔大圣？"
        },
        {
          "role": "迪奥娜",
          "text": "是你们的熟人？"
        },
        {
          "role": "派蒙",
          "text": "嗯，这位是魈，是璃月的仙人。"
        },
        {
          "role": "迪奥娜",
          "text": "（仙人？还是第一次见到！）"
        },
        {
          "role": "迪奥娜",
          "text": "呃…你好，仙人先生。"
        },
        {
          "role": "魈",
          "text": "叫我魈便是。"
        },
        {
          "role": "迪奥娜",
          "text": "魈也来这里练功吗？还是来采风的？"
        },
        {
          "role": "魈",
          "text": "…我听闻这位方士的遭遇，心存疑虑，便跟来了。"
        },
        {
          "role": "魈",
          "text": "我已向客栈老板打过招呼。若有异动，当即赶回。毋需担忧。"
        },
        {
          "role": "重云",
          "text": "唔…啊…唉，真是不好意思，没想到还惊动了降魔大圣…"
        },
        {
          "role": "魈",
          "text": "我已巡视此地，并未发觉异常。你所遇之物恐非妖邪，或是早已离去。"
        },
        {
          "role": "重云",
          "text": "这样啊，白跑一趟了吗…"
        },
        {
          "role": "魈",
          "text": "既然无事，就此别过。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…等等！",
              "dialogues": []
            },
            {
              "text": "一起「采风」吧！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "对啊，反正现在没有其他人，魈也不用担心什么啦。"
        },
        {
          "role": "魈",
          "text": "可…"
        },
        {
          "role": "重云",
          "text": "我也想请上仙留步，机会难得，我…我还想多向上仙请教降妖除魔的经验。"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "魈",
          "text": "好吧。"
        },
        {
          "role": "迪奥娜",
          "text": "（感觉是位很内向的仙人呢…还是说璃月仙人都这样？）"
        },
        {
          "role": "派蒙",
          "text": "重云小队有了新成员呢！"
        },
        {
          "role": "重云",
          "text": "这…什么时候成我的小队了？既然上仙加入了，怎么说也得是…"
        },
        {
          "role": "派蒙",
          "text": "别在意别在意，迪奥娜之前说要找一些调酒的材料对吧？"
        },
        {
          "role": "迪奥娜",
          "text": "嗯，难得来一次璃月，就多收集些不一样的调料。"
        },
        {
          "role": "迪奥娜",
          "text": "我听说璃月的绝云椒椒能让人喉咙都烧起来，这是真的吗？我想加进酒里试试看！"
        },
        {
          "role": "重云",
          "text": "（欸？绝云椒椒？）"
        },
        {
          "role": "重云",
          "text": "呃…我觉得那样不会好喝吧…"
        },
        {
          "role": "迪奥娜",
          "text": "真的吗？那太好了！我们这就去采一些吧！"
        },
        {
          "role": "重云",
          "text": "欸…？"
        },
        {
          "type": "subtitle",
          "text": "采集新鲜的绝云椒椒（3/3）"
        },
        {
          "role": "迪奥娜",
          "text": "除了绝云椒椒之外，我还想要些史莱姆凝液或者鳅鳅宝玉。"
        },
        {
          "role": "重云",
          "text": "这…这真的能喝吗…感觉和香菱有一拼…"
        },
        {
          "type": "subtitle",
          "text": "击败水史莱姆（4/4）"
        },
        {
          "type": "subtitle",
          "text": "与迪奥娜对话"
        },
        {
          "role": "迪奥娜",
          "text": "好了，这些差不多就够了。"
        },
        {
          "role": "重云",
          "text": "…迪奥娜真的很认真地在钻研调酒之道呢。"
        },
        {
          "role": "迪奥娜",
          "text": "啊？怎么可能嘛！我最讨厌酒了！"
        },
        {
          "role": "迪奥娜",
          "text": "大人喝完酒后一副醉醺醺的样子，话也说不清，叫也不答应，有时候还直接在地板上睡一夜！这都是酒害的！"
        },
        {
          "role": "迪奥娜",
          "text": "所以我一定要调出最最最难喝的酒，让大家都知道酒的不好！就算以后天天要跑到璃月采绝云椒椒我都愿意！"
        },
        {
          "role": "重云",
          "text": "咦？需要花这么大的功夫吗？"
        },
        {
          "role": "迪奥娜",
          "text": "那当然！在这之前所有的尝试都失败了…那些酒鬼大叔非但不反思，还一遍遍夸我调得好，气死我了！"
        },
        {
          "role": "重云",
          "text": "这…这怎么可能？把那些东西胡乱放进去的话，怎么想都不会好喝吧？"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "迪奥娜",
          "text": "我又没骗人！你不相信的话，我现在就调给你看。"
        },
        {
          "role": "重云",
          "text": "欸？这倒…"
        },
        {
          "role": "迪奥娜",
          "text": "哼！给我等着。"
        },
        {
          "role": "重云",
          "text": "（糟了，难道她真的要加绝云椒椒？）"
        },
        {
          "role": "魈",
          "text": "…如果她所述为实，是否也是出于某种「体质」？"
        },
        {
          "role": "重云",
          "text": "可这不像是她自己的原因，除非…是受到了它者影响。莫不成是妖邪？"
        },
        {
          "role": "魈",
          "text": "不像。她身上并无邪祟气息，反倒有某种特殊的痕迹。{{黑幕|迪奥娜受到过泉水精灵的祝福}}"
        },
        {
          "role": "魈",
          "text": "以璃月的话说，这孩子有仙缘。"
        },
        {
          "role": "迪奥娜",
          "text": "我调好了，喏，给魈也调了一杯。"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "重云",
          "text": "（…这颜色，一定是加了绝云椒椒。）"
        },
        {
          "role": "迪奥娜",
          "text": "怎么了？你们有什么忌口吗？"
        },
        {
          "role": "迪奥娜",
          "text": "放心吧，我没加酒精。底味是史莱姆凝液，配料是绝云椒椒和青蛙腿。"
        },
        {
          "role": "重云",
          "text": "（这果然还是不会好喝的吧？）"
        },
        {
          "role": "旅行者",
          "text": "两位不用勉强。"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "魈",
          "text": "……！"
        },
        {
          "role": "重云",
          "text": "（魈上仙居然一饮而尽了！降魔大圣都喝了，我不喝岂不是不合礼节？）"
        },
        {
          "role": "重云",
          "text": "……！"
        },
        {
          "role": "派蒙",
          "text": "重云也喝下去了！他一会儿不会有事吧？"
        },
        {
          "role": "魈",
          "text": "这饮品…"
        },
        {
          "role": "重云",
          "text": "…好喝！{{黑幕|星星眼重云}}"
        },
        {
          "role": "重云",
          "text": "虽然有绝云椒椒的味道，但却一点也不突兀！和香菱做的菜，还有行秋那家伙捉弄我时捣鼓出来的饮品都不一样！"
        },
        {
          "role": "重云",
          "text": "入口清爽，只带有微微的酥麻，绝云椒椒的香味和青蛙腿滑而不腻的口感结合得恰到好处！"
        },
        {
          "role": "重云",
          "text": "更别提史莱姆了！我以前从不知道，原来史莱姆还带着一种绿草与清泉的芳香，自然的力量！太不可思议了！"
        },
        {
          "role": "派蒙",
          "text": "对吧！史莱姆最美味了！"
        },
        {
          "role": "迪奥娜",
          "text": "哈，又失败了。但怎么感觉重云话变多了…"
        },
        {
          "role": "旅行者",
          "text": "你没事吧？"
        },
        {
          "role": "重云",
          "text": "没事！我还能再来一杯！迪奥娜，再来一杯！"
        },
        {
          "type": "subtitle",
          "text": "在你们的指导下，迪奥娜嘟着嘴调了一杯冰镇饮品让重云服下…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "重云",
          "text": "我这是…呼…感觉冷静下来了。"
        },
        {
          "role": "重云",
          "text": "抱歉…让大家看到我出丑的样子了。"
        },
        {
          "role": "迪奥娜",
          "text": "没有啦，是我没事先确认重云你不能吃辣。"
        },
        {
          "role": "迪奥娜",
          "text": "没想到「纯阳之体」还真这么不方便。"
        },
        {
          "role": "重云",
          "text": "其实…在喝下之前，我也有些怀疑迪奥娜的话。"
        },
        {
          "role": "迪奥娜&重云",
          "text": "唉…"
        },
        {
          "role": "派蒙",
          "text": "总感觉，这俩人意外地相似呢…"
        },
        {
          "role": "魈",
          "text": "…嗯？"
        },
        {
          "role": "派蒙",
          "text": "魈，怎么了吗？"
        },
        {
          "role": "魈",
          "text": "你们看那边。"
        },
        {
          "role": "重云",
          "text": "树叶？"
        },
        {
          "role": "魈",
          "text": "叶上有字。"
        },
        {
          "role": "派蒙",
          "text": "欸？这都看得清吗？"
        },
        {
          "role": "旅行者",
          "text": "去捡起来看看吧。"
        },
        {
          "role": "派蒙",
          "text": "对对对，它快漂走了。"
        },
        {
          "type": "subtitle",
          "text": "捡起水中的树叶"
        },
        {
          "role": "重云",
          "text": "还真写着诗文，降魔大圣好眼力…"
        },
        {
          "role": "派蒙",
          "text": "我看看…"
        },
        {
          "type": "subtitle",
          "text": "落叶上的诗"
        },
        {
          "type": "subtitle",
          "text": "那晚的星空芬芳如花圃，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "一粒粒星辰像一只只蜜蜂，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在夜里贪食着美酒与梦。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "那晚的我们青涩如露珠，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "一束束月光像一绸绸蜂蜜，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在泉边甜润着你我的话语。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "但我转身将你弃离，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "心中的诗句再未出口。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "自那以后，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "星星不再眨眼，月光锐利如冰。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "我在水下将它们躲藏，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "却怎么也躲不过，你落入泉中的泪。",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "唔…感觉作者是在写和心上人第一次相遇的样子。"
        },
        {
          "role": "重云",
          "text": "不过，从后面几句看来，两人最终没有在一起。"
        },
        {
          "role": "魈",
          "text": "…为何要以落叶载诗？"
        },
        {
          "role": "魈",
          "text": "流水无心，若落叶随波逐流，此诗极有可能就此逸失。"
        },
        {
          "role": "魈",
          "text": "…难以理解。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "写诗有时只是为了有所寄托。",
              "dialogues": []
            },
            {
              "text": "是否有人看或许不重要",
              "dialogues": []
            }
          ]
        },
        {
          "role": "重云",
          "text": "没错，我也听行秋说过类似的话。"
        },
        {
          "role": "重云",
          "text": "以前说不出口，或者没来得及说出口的话，只要落成文字，就能寄托在诗歌之中。"
        },
        {
          "role": "迪奥娜",
          "text": "就像对着泉水倾诉心事吗？我小时候偶尔会那么做。"
        },
        {
          "role": "派蒙",
          "text": "这么说的话…这片叶子的主人，还是希望有人看到这首诗的吧？"
        },
        {
          "role": "迪奥娜",
          "text": "欸？那，那我们是不是也该回一首？"
        },
        {
          "role": "重云",
          "text": "可是我们又不知道作者是谁，该怎么回呢…"
        },
        {
          "role": "魈",
          "text": "…去上游，如何？"
        },
        {
          "role": "派蒙",
          "text": "上游？"
        },
        {
          "role": "魈",
          "text": "看笔墨字迹，应当写成不久。"
        },
        {
          "role": "魈",
          "text": "这枚枯叶既是顺流而下，若我们在同一水域的上游投下落叶，那它便有可能会漂到作者所在之处。"
        },
        {
          "role": "派蒙",
          "text": "哦！用落叶回诗，听起来好浪漫！"
        },
        {
          "role": "迪奥娜",
          "text": "但不能保证收得到吧？"
        },
        {
          "role": "重云",
          "text": "那就多写几片叶子，再多去几处！俗语说「功夫不负有心人」，总有一片会被看到的吧？"
        },
        {
          "role": "魈",
          "text": "也只能如此了。"
        },
        {
          "role": "派蒙",
          "text": "那我们就行动起来吧！"
        },
        {
          "type": "subtitle",
          "text": "前往上游放下回诗"
        },
        {
          "role": "派蒙",
          "text": "上游，上游！你想好写什么了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经写好了。"
        },
        {
          "type": "subtitle",
          "text": "写在叶上的回诗"
        },
        {
          "type": "subtitle",
          "text": "黑夜夺不去萤光，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "流水涤不走顽石，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "如若词句尚存，情意未变，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "微小而又坚定之物，亦能与世间天地对抗。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "愿如蜜的月光再度拥你们入怀。",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，真不愧是你，那我这就把叶子放下去！"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "多亏了魈的提议。",
              "dialogues": []
            },
            {
              "text": "感觉魈这次还挺积极。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "魈",
          "text": "…「没来得及说出的话」，若就此沉寂，未免有些可惜…"
        },
        {
          "role": "旅行者",
          "text": "魈也试着写写诗吧。"
        },
        {
          "role": "魈",
          "text": "我对诗词歌赋不甚通晓…"
        },
        {
          "role": "派蒙",
          "text": "我把叶子放好啦，看着它像小船一样漂下去了，晃晃悠悠的！"
        },
        {
          "role": "重云",
          "text": "我们抓紧时间吧，去几个地方放完，赶在天黑之前回会场。"
        },
        {
          "role": "派蒙",
          "text": "好，出发吧…吧？"
        },
        {
          "role": "派蒙",
          "text": "你们俩不会还有悄悄话没说完吧？"
        },
        {
          "role": "魈",
          "text": "…没什么。"
        },
        {
          "role": "魈",
          "text": "希望此番所作并非徒劳。"
        },
        {
          "type": "subtitle",
          "text": "和大家一起「采风」"
        },
        {
          "type": "subtitle",
          "text": "早些时候，另外一队…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "行秋",
          "text": "嗯，我看这里风景就不错。我们在这边找找灵感吧。"
        },
        {
          "role": "诺艾尔",
          "text": "是要安营吗？请稍等，我这就为大家支帐篷。"
        },
        {
          "role": "行秋",
          "text": "我们只是采风而已，倒不必如此劳烦…"
        },
        {
          "role": "米卡",
          "text": "那我就近侦察一圈，确保诸位的安全，顺便看看能不能捡到柴火和食材。"
        },
        {
          "role": "行秋",
          "text": "等等…侦察？"
        },
        {
          "role": "米卡",
          "text": "勘测周围环境，确保行进路线，这是野外行动的基础。"
        },
        {
          "role": "行秋",
          "text": "（蒙德的「采风」，原来这么复杂吗？）"
        },
        {
          "role": "行秋",
          "text": "（看他们如此自然…难道说，我才是比较奇怪的那一个？）"
        },
        {
          "role": "行秋",
          "text": "既然这样，我就随米卡一起「侦察」吧。"
        },
        {
          "role": "米卡",
          "text": "欸？啊…好的。"
        },
        {
          "role": "米卡",
          "text": "（我…我得赶快想一些话题。风景？天气？）"
        },
        {
          "role": "诺艾尔",
          "text": "嗯，营地就交给我吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（诺艾尔）"
        },
        {
          "role": "诺艾尔",
          "text": "二位放心去吧，帐篷我很快就能搭好。"
        },
        {
          "type": "subtitle",
          "text": "收集附近的木材（1/1）"
        },
        {
          "role": "米卡",
          "text": "行秋…呃，你…经常出来采风吗？"
        },
        {
          "role": "行秋",
          "text": "嗯，嫌家里太闷的时候，就会出来走走。"
        },
        {
          "role": "行秋",
          "text": "所谓「偷得浮生半日闲」嘛。"
        },
        {
          "role": "米卡",
          "text": "好厉害…啊，那边有木柴！"
        },
        {
          "type": "subtitle",
          "text": "收集附近的食材"
        },
        {
          "type": "subtitle",
          "text": "采集新鲜的树莓（3/3）"
        },
        {
          "type": "subtitle",
          "text": "整理物资"
        },
        {
          "role": "米卡",
          "text": "有了这些，加上我随身带的食材，应该能做出一顿不错的午餐。"
        },
        {
          "role": "行秋",
          "text": "米卡似乎对野外生活很有心得。"
        },
        {
          "role": "米卡",
          "text": "多谢夸奖！我…我之前跟随西风骑士团的大团长在外远征，负责勘探测绘的工作。"
        },
        {
          "role": "行秋",
          "text": "哦？听起来像是小说里游历各处，仗剑四方的角色呢。"
        },
        {
          "role": "米卡",
          "text": "欸？我没那么厉害啦…"
        },
        {
          "role": "米卡",
          "text": "真要是遇到了强大的敌人，也是交给队里实力更强的人解决…"
        },
        {
          "role": "行秋",
          "text": "米卡谦虚了。「侠」之境界不在武，而在于心。"
        },
        {
          "role": "行秋",
          "text": "只要胸怀帮助他人的仗义之心，无论行至何处、建树多寡，都能称之为「侠」。"
        },
        {
          "role": "米卡",
          "text": "（行秋的话有些复杂，而且都是我不曾思考过的方向…）"
        },
        {
          "role": "行秋",
          "text": "嗯？怎么了？我们是不是该回去了，别让诺艾尔久等。"
        },
        {
          "role": "米卡",
          "text": "啊，好的。"
        },
        {
          "type": "subtitle",
          "text": "回营地与诺艾尔对话"
        },
        {
          "role": "诺艾尔",
          "text": "你们回来了，还顺利吗？需要擦擦汗吗？"
        },
        {
          "role": "米卡",
          "text": "嗯，不用担心，周围没有危险。"
        },
        {
          "type": "subtitle",
          "text": "大家一起生起了火，处理了食材…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "不出多久，一顿美味的饭菜就做好了…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "米卡",
          "text": "诺艾尔前辈的手艺真好，每道菜都很美味。"
        },
        {
          "role": "行秋",
          "text": "嗯！了不起，没想到在野外还能吃到如此沁人心脾的餐食。"
        },
        {
          "role": "诺艾尔",
          "text": "咦？那行秋外出「采风」的时候，一般是吃些什么呢？"
        },
        {
          "role": "行秋",
          "text": "哦，我大多是从家里偷偷溜出来的，所以只会带一些简单的干粮。再随便摘些果子，就是一顿午饭了。"
        },
        {
          "role": "米卡",
          "text": "偷偷的意思…是离家出走吗？"
        },
        {
          "role": "行秋",
          "text": "没错。不过有时为了掩人耳目，也会谎称是外出办事。"
        },
        {
          "role": "诺艾尔",
          "text": "这…要是被发现的话，不会被关禁闭吗？"
        },
        {
          "role": "行秋",
          "text": "只要不被发现就好了嘛。"
        },
        {
          "role": "诺艾尔",
          "text": "……"
        },
        {
          "role": "诺艾尔",
          "text": "对了，你们刚才出去的时候，有聊什么有趣的话题吗？"
        },
        {
          "role": "米卡",
          "text": "哦，行秋和我聊到了有关「侠义」的事情。"
        },
        {
          "role": "米卡",
          "text": "对啊，按行秋的说法，诺艾尔前辈才该被称为「侠」吧？"
        },
        {
          "role": "诺艾尔",
          "text": "欸？我？"
        },
        {
          "role": "米卡",
          "text": "诺艾尔前辈不仅平时在骑士团乐于助人，就连外出训练时，也会帮蒙德的居民。"
        },
        {
          "role": "米卡",
          "text": "上次有块巨石挡了商路，你可是一剑就帮他们劈开了！"
        },
        {
          "role": "行秋",
          "text": "哦？听起来是侠心与武艺并存嘛。"
        },
        {
          "role": "诺艾尔",
          "text": "别…别突然就夸我呀…我们该讨论「采风」的正经事了…"
        },
        {
          "role": "米卡",
          "text": "胡桃小姐说适合装进兜里的…意象…我们只捡了柴火做了饭，还不知道要写些什么。"
        },
        {
          "role": "行秋",
          "text": "写什么都行。"
        },
        {
          "role": "行秋",
          "text": "观得石珀，便思人心是否明澈如玉；见到霓裳，就想其芳颜如此，是否也会如人一般有哀伤凋敝之时。"
        },
        {
          "role": "诺艾尔",
          "text": "要将自身情感与外物结合？"
        },
        {
          "role": "行秋",
          "text": "没错没错，这就是方法之一。"
        },
        {
          "role": "行秋",
          "text": "再比如，看远处桥头，有一女子凭栏倚望，似有心事，连流水都难抹其忧伤…"
        },
        {
          "role": "诺艾尔",
          "text": "咦？我昨天好像在会场见过她，是给我们出诗谜的那位。"
        },
        {
          "role": "诺艾尔",
          "text": "干脆过去打个招呼吧？"
        },
        {
          "type": "subtitle",
          "text": "与桥头的女子对话"
        },
        {
          "role": "行秋",
          "text": "你好，这位小姐，真巧啊，我们又见面了。"
        },
        {
          "role": "？？？",
          "text": "你们好。几位也是来此采风的吗？"
        },
        {
          "role": "行秋",
          "text": "嗯，介绍一下——我是行秋。这两位是诺艾尔与米卡。"
        },
        {
          "role": "诺艾尔",
          "text": "昨天的诗谜，多谢您关照了。"
        },
        {
          "role": "卡莉露",
          "text": "没什么，大家开心就好。我叫卡莉露。"
        },
        {
          "role": "米卡",
          "text": "…卡莉露小姐，是从枫丹来的吗？"
        },
        {
          "role": "卡莉露",
          "text": "没错，我旅行至此，正巧看到石门在举办诗歌大会，就一时兴起，过来玩玩。"
        },
        {
          "role": "行秋",
          "text": "昨日您出的诗谜意境独特，令我印象颇为深刻。您是专门钻研过璃月诗歌吗？"
        },
        {
          "role": "卡莉露",
          "text": "倒也没有，在旅途中和人聊天多了，自然而然就学会了这些。"
        },
        {
          "role": "诺艾尔",
          "text": "好厉害的领悟能力！"
        },
        {
          "role": "行秋",
          "text": "看卡莉露小姐在此桥头驻足，是在以流水为灵感作诗吗？"
        },
        {
          "role": "卡莉露",
          "text": "哈哈，诗倒尚未作成。我只是觉得这里的水流平静祥和，不知不觉就看入了神。"
        },
        {
          "role": "行秋",
          "text": "既然这样的话，我看时候也不早了，不知卡莉露小姐是否有意和我们一起返回会场，参加傍晚的大会呢？"
        },
        {
          "role": "卡莉露",
          "text": "…咦？这，真的可以吗？"
        },
        {
          "role": "行秋",
          "text": "我们不妨边走边讨论，说不定可以碰撞出新的灵感。"
        },
        {
          "role": "诺艾尔",
          "text": "我也想听听卡莉露小姐想出来的诗对，学习学习。"
        },
        {
          "role": "卡莉露",
          "text": "哈哈，既然大家都这么说了，那我就不再推脱了。"
        },
        {
          "type": "subtitle",
          "text": "返回活动会场"
        },
        {
          "type": "subtitle",
          "text": "几人一路有说有笑，回到了会场…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "温迪",
          "text": "哟呼，第一支小队准时到达。"
        },
        {
          "role": "行秋",
          "text": "咦？其他人还没回来吗？"
        },
        {
          "role": "派蒙",
          "text": "…快点，快点！"
        },
        {
          "role": "重云",
          "text": "呼…呼…没，没迟到吧？"
        },
        {
          "role": "行秋",
          "text": "你们这是去了多远的地方呀？"
        },
        {
          "role": "温迪",
          "text": "哈哈，大家都喘口气，来，深呼吸，一…二。别紧张，大会还没开始呢。"
        },
        {
          "role": "派蒙",
          "text": "呼…太好了，赶上了，累死我了…"
        },
        {
          "role": "旅行者",
          "text": "飞着也累吗…"
        },
        {
          "role": "派蒙",
          "text": "飞快了也会累的啦！"
        },
        {
          "role": "派蒙",
          "text": "再加上我还放了那么多叶子，手都酸了…"
        },
        {
          "role": "迪奥娜",
          "text": "哼，一看就是你们平时缺乏锻炼！"
        },
        {
          "role": "派蒙",
          "text": "咦？行秋你们路上还遇到了其他人呀？"
        },
        {
          "role": "行秋",
          "text": "嗯， 没错，这位是卡莉露，各位昨天应该也见过。"
        },
        {
          "role": "卡莉露",
          "text": "你们好。"
        },
        {
          "role": "派蒙",
          "text": "你好你好。嘿嘿，但可不只有你们请到了外援哟，我们也…"
        },
        {
          "role": "派蒙",
          "text": "欸？魈呢？什么时候不见的？"
        },
        {
          "role": "派蒙",
          "text": "魈——出来啊魈——！"
        },
        {
          "type": "subtitle",
          "text": "魈回到了对面的山头上…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "温迪",
          "text": "咳咳，那既然人都到得差不多了，我们就…欸，不对，另一位主持人还没到呢。"
        },
        {
          "role": "胡桃",
          "text": "哼哼哼，说是那公鸡白天要起早，团雀晚上要睡觉，我往生堂堂主胡桃，可是随叫随到！"
        },
        {
          "role": "派蒙",
          "text": "呃…这都第二天了，就不用来这些隆重的开场白啦…"
        },
        {
          "role": "胡桃",
          "text": "不不不，派蒙有所不知，这一出可不是为了我自己，而是要衬出我请到的这位特殊嘉宾——"
        },
        {
          "role": "钟离",
          "text": "胡堂主这声势浩大的作风，还是一如既往，令人印象深刻。"
        },
        {
          "role": "温迪",
          "text": "哎呀，真是惊喜！"
        },
        {
          "role": "行秋",
          "text": "钟离先生，别来无恙。"
        },
        {
          "role": "诺艾尔",
          "text": "行秋，这位钟离先生很厉害吗？"
        },
        {
          "role": "行秋",
          "text": "嗯，他在诸多方面都颇有造诣，在璃月港内很有名望。"
        },
        {
          "role": "胡桃",
          "text": "为大家介绍一下，这位呢，是往生堂的客卿，钟离先生。"
        },
        {
          "role": "胡桃",
          "text": "他上知天文，下知地理，古今文化、诗词典籍可谓无所不知，无所不晓。"
        },
        {
          "role": "胡桃",
          "text": "虽然是我的下属，但能力是够格的。此次专门请他来担任评委一职。"
        },
        {
          "role": "钟离",
          "text": "胡堂主谬赞了，我不过略通几句古诗而已。点评若有错漏之处，还请大家指正。"
        },
        {
          "role": "胡桃",
          "text": "行了行了，不用那么谦虚。不知道的还以为你紧张了。尽管点评就行了！"
        },
        {
          "role": "钟离",
          "text": "堂主放心。"
        },
        {
          "role": "胡桃",
          "text": "我数数，一二三四…嗯，两边数量也对得上。"
        },
        {
          "role": "迪奥娜",
          "text": "咦？我也被算上了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一起玩吧。",
              "dialogues": []
            },
            {
              "text": "会很开心的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪奥娜",
          "text": "好吧，那…那就当是帮你的忙好了。"
        },
        {
          "role": "胡桃",
          "text": "有这位枫丹友人在，是不是该改名叫「三国诗歌握手言欢会」…"
        },
        {
          "role": "胡桃",
          "text": "但仔细一看，派蒙最多只能算半个吧？旅行者这边就有些劣势了。"
        },
        {
          "role": "胡桃",
          "text": "本堂主也下场吧！在关键时刻帮帮忙，大家意下如何？"
        },
        {
          "role": "行秋",
          "text": "自然是越热闹越好。我也希望胡堂主玩得开怀。"
        },
        {
          "role": "胡桃",
          "text": "那就这么定了！场下观众也多多参与哦，为你们支持的队伍出一份力！"
        },
        {
          "role": "温迪",
          "text": "要我来计分吗？"
        },
        {
          "role": "胡桃",
          "text": "不用不用，分队只是形式，大伙都是朋友，不存在竞争关系。钟离评委觉得呢？"
        },
        {
          "role": "钟离",
          "text": "堂主所言极是。若要蒙德与枫丹朋友严守璃月格律规范，未免显得狭促。"
        },
        {
          "role": "钟离",
          "text": "既然是「握手言欢会」，不妨就以灵感为始，以欢谈作终，各位尽兴便好。"
        },
        {
          "role": "米卡",
          "text": "喔，太好了…我之前紧张得要命，还好要求不是很严格。"
        },
        {
          "role": "胡桃",
          "text": "好一个评委，说完了主持人该说的话，那主持…就交给温迪了。"
        },
        {
          "role": "温迪",
          "text": "没问题。"
        },
        {
          "role": "温迪",
          "text": "新老朋友们，大家拍拍脑袋换口新鲜空气。本次诗歌大会第二场活动——对对子，现在正式开始！"
        },
        {
          "role": "行秋",
          "text": "那我便来抛砖引玉。"
        },
        {
          "role": "行秋",
          "text": "请听上对——「新月轩雅间里品江湖百味。」"
        },
        {
          "role": "米卡",
          "text": "（这，这就已经想出来了吗？不愧是他…）"
        },
        {
          "role": "派蒙",
          "text": "新月轩，难道要对琉璃亭吗？可恶，这开头就把我难住了！"
        },
        {
          "role": "重云",
          "text": "（「新」对「旧」…对「古」？咦？我那次练功是不是路过这么一个地方，我记得当时天气不好…）"
        },
        {
          "role": "重云",
          "text": "…啊，有了！"
        },
        {
          "role": "重云",
          "text": "——「古城垣陋亭外观雷光千道。」"
        },
        {
          "role": "派蒙",
          "text": "哇！重云对上了！"
        },
        {
          "role": "钟离",
          "text": "嗯，「新月轩」是闻名璃月的餐馆，「古城垣」位于天衡山之上，两者同为地点，足以成对。"
        },
        {
          "role": "钟离",
          "text": "加之上句环境悠闲自得，下句景象惊险恶劣，画面上也得到了对应。"
        },
        {
          "role": "重云",
          "text": "（咦？我只是把那天的经历说了出来而已，居然，歪打正着？）"
        },
        {
          "role": "重云",
          "text": "既然如此，那我也出一对——"
        },
        {
          "role": "重云",
          "text": "「志有明蕴，隐轻策，足下再筹绝云。」"
        },
        {
          "role": "行秋",
          "text": "（重云这家伙，今天不简单嘛…）"
        },
        {
          "role": "钟离",
          "text": "大意是一人志向高远，但隐于市井，等待着机会登上青云。以地名为线索，颇具新意。"
        },
        {
          "role": "诺艾尔",
          "text": "……"
        },
        {
          "role": "诺艾尔",
          "text": "「德如石珀，着霓裳，胸中亦存琉璃。」"
        },
        {
          "role": "派蒙",
          "text": "哇，居然是诺艾尔！"
        },
        {
          "role": "钟离",
          "text": "好句。取石为喻，形容一个人德行高尚，内心纯洁剔透。以物名为线索，嗯，有水平。"
        },
        {
          "role": "行秋",
          "text": "很出色的对子。"
        },
        {
          "role": "诺艾尔",
          "text": "多亏采风时行秋的指点。"
        },
        {
          "role": "卡莉露",
          "text": "那我也为大家出一对——"
        },
        {
          "role": "卡莉露",
          "text": "「上至华光雾海，下入水泽荻洲，只为一道莲子禽蛋羹。」"
        },
        {
          "role": "迪奥娜",
          "text": "…莲子禽蛋羹？"
        },
        {
          "role": "派蒙",
          "text": "怎么了？迪奥娜想到下句了吗？"
        },
        {
          "role": "迪奥娜",
          "text": "没有，大家出的诗都很难，我理解都要一些时间呢。"
        },
        {
          "role": "迪奥娜",
          "text": "只是听到「莲子禽蛋羹」的时候，脑子里突然冒出了「树莓薄荷饮」。可能最近刚调过类似的东西吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            },
            {
              "text": "…有了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "「北逾坠星湖岸，南越风洗原野，再添两杯树莓薄荷饮。」{{黑幕|哑巴开口}}"
        },
        {
          "role": "卡莉露",
          "text": "真不愧是大家交口称赞的旅行者，这么快就对上了。"
        },
        {
          "role": "钟离",
          "text": "上下两句，都需要对各地风物特产有熟悉了解，二位旅者想必早已用自己的双脚行遍芳野。"
        },
        {
          "role": "迪奥娜",
          "text": "我也算帮上忙了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "帮大忙了。",
              "dialogues": []
            },
            {
              "text": "谢谢迪奥娜。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡桃",
          "text": "哎哎哎，我说客卿你别什么都叫好呀。要多质疑多提问，别怕得罪人，再怎么说，还有我罩着你嘛。"
        },
        {
          "role": "卡莉露",
          "text": "那我再出一对——"
        },
        {
          "role": "卡莉露",
          "text": "「『清心』无心，善治世人心。」"
        },
        {
          "role": "重云",
          "text": "是说「清心」这味药材的功效吗？唔…好难对。"
        },
        {
          "role": "旅行者",
          "text": "（清心…虽带「心」字，却没有「心」…）"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……！",
              "dialogues": []
            },
            {
              "text": "我想到了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "「『美梦』非梦，常安浮生梦。」{{黑幕|哑巴再开口}}"
        },
        {
          "role": "浣溪",
          "text": "美梦？这对得上吗？"
        },
        {
          "role": "钟离",
          "text": "哦？那我借胡堂主之言问一句，「美梦」何以对「清心」？"
        },
        {
          "role": "旅行者",
          "text": "[[「美梦」]]{{黑幕|魈的特色料理}}是一道点心。"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "哦！就是说吃了好吃的点心晚上睡得安稳对吧？你真厉害！"
        },
        {
          "role": "旅行者",
          "text": "（其实，也有魈守护大家夜晚安详的意味在。）"
        },
        {
          "type": "subtitle",
          "text": "魈转身离开了…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "钟离",
          "text": "哈哈，我也觉得是一好对。这分当给。"
        },
        {
          "role": "胡桃",
          "text": "当给当给，摊上个好评委什么分都当给——"
        },
        {
          "role": "胡桃",
          "text": "但要我说，大家对得也太规矩了吧？再放开些手脚也没问题啊！"
        },
        {
          "role": "行秋",
          "text": "哦？那不如请胡堂主接我一对——"
        },
        {
          "role": "行秋",
          "text": "「天上有月，月成圆，人也团圆。」"
        },
        {
          "role": "胡桃",
          "text": "「地下开饭，饭来碗，肉也满碗。」"
        },
        {
          "role": "行秋",
          "text": "欸？这…这是…"
        },
        {
          "role": "钟离",
          "text": "这是「无情对」。"
        },
        {
          "role": "钟离",
          "text": "上下句看似无关，但字词却…基本对应，各成一体。丝毫不比一般的对子简单。"
        },
        {
          "role": "胡桃",
          "text": "别说那么多啦，客卿你就说这分该不该给吧。"
        },
        {
          "role": "钟离",
          "text": "该给，自然是该给。{{黑幕|老板的分能不给？}}"
        },
        {
          "role": "行秋",
          "text": "咳咳…「琼玑八百里，问荻花何处不归离？」"
        },
        {
          "role": "胡桃",
          "text": "「林猪二十斤，气大锅哪口能装下？」"
        },
        {
          "role": "行秋",
          "text": "啊？"
        },
        {
          "role": "派蒙",
          "text": "原来这叫「无情对」吗？总感觉我也能对上两个呢。"
        },
        {
          "role": "迪奥娜",
          "text": "我想出来一个！"
        },
        {
          "role": "迪奥娜",
          "text": "「钩钩果钩不住兔兔伯爵。」"
        },
        {
          "role": "派蒙",
          "text": "哇，好可爱的对子！"
        },
        {
          "role": "雷温",
          "text": "「甜甜花甜不过芭芭拉！」"
        },
        {
          "role": "派蒙",
          "text": "欸？"
        },
        {
          "role": "温迪",
          "text": "哈哈，这位朋友的热情我们都感受到了，只可惜…少了一个字哟。"
        },
        {
          "role": "米卡",
          "text": "……"
        },
        {
          "role": "米卡",
          "text": "那…「骗骗花骗不过蹦蹦炸弹。」"
        },
        {
          "role": "胡桃",
          "text": "哦！这位蒙德的朋友很有才嘛！"
        },
        {
          "role": "米卡",
          "text": "（太…太好了，总算对上一个…）"
        },
        {
          "role": "诺艾尔",
          "text": "……"
        },
        {
          "role": "诺艾尔",
          "text": "「篝火毕剥，炉暖茶香，轻捧清泉之心。」"
        },
        {
          "role": "卡莉露",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "哇！诺艾尔又出了一个呢！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，快对呀，你最厉害了。"
        },
        {
          "role": "旅行者",
          "text": "…不如派蒙来对一个。"
        },
        {
          "role": "派蒙",
          "text": "欸？我吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "试试「无情对」。",
              "dialogues": []
            },
            {
              "text": "一一对应就行。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧，我试试…"
        },
        {
          "role": "派蒙",
          "text": "「篝火毕剥，炉暖茶香…」"
        },
        {
          "role": "派蒙",
          "text": "呃…「雷雨轰隆，剑寒心酸，暴打狂风之核！」"
        },
        {
          "role": "旅行者",
          "text": "好！"
        },
        {
          "role": "派蒙",
          "text": "欸？真的吗？"
        },
        {
          "role": "胡桃",
          "text": "嗯，不错不错，艰苦环境下挑战强敌的画面如在眼前，和对方悠闲读书的氛围也对得天衣无缝。"
        },
        {
          "role": "派蒙",
          "text": "是…是吗？嘿嘿…说不定，我也有这方面的天赋嘛。"
        },
        {
          "role": "钟离",
          "text": "…看来，已经无需我的点评了。"
        },
        {
          "type": "subtitle",
          "text": "会场越来越热闹，欢声笑语间，已至夜晚…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "主持人宣布今日活动结束后，人们才依依不舍地散去…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "呼，好开心呀！我后来又对上了好几个呢！旅行者，你都听见了吧！"
        },
        {
          "role": "诺艾尔",
          "text": "我也玩得很开心，没想到，璃月的诗对这么有趣。"
        },
        {
          "role": "派蒙",
          "text": "诺艾尔今天很厉害呀，出了好几个对子呢。"
        },
        {
          "role": "派蒙",
          "text": "特别是《清泉之心》那个，我差点就对不上来了！"
        },
        {
          "role": "卡莉露",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "卡莉露？"
        },
        {
          "role": "行秋",
          "text": "怎么了？卡莉露小姐，是累了吗？从刚才开始就看您状态不佳。"
        },
        {
          "role": "卡莉露",
          "text": "没事的，谢谢大家的关心。"
        },
        {
          "role": "卡莉露",
          "text": "唔…我有一个问题想问大家。"
        },
        {
          "role": "卡莉露",
          "text": "各位，难道都看过《清泉之心》的故事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "以前读过。",
              "dialogues": []
            },
            {
              "text": "还没看过。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "重云",
          "text": "我倒是没读过。"
        },
        {
          "role": "迪奥娜",
          "text": "我爸爸给我讲过哦，是一只泉水精灵与一位男孩的故事。"
        },
        {
          "role": "诺艾尔",
          "text": "嗯，离开了遥远故乡的泉水精灵，在月光下与一位少年相遇。"
        },
        {
          "role": "诺艾尔",
          "text": "少年向她吐露真心，泉水精灵聆听了少年的故事。"
        },
        {
          "role": "诺艾尔",
          "text": "久而久之，少年对这位泉水精灵有了思慕之情，但精灵那时不懂得人间的爱，害怕诺言终会落为悲剧，就…呃…"
        },
        {
          "role": "诺艾尔",
          "text": "（不知道迪奥娜的爸爸是怎么讲故事里接吻那段的呢…）"
        },
        {
          "role": "迪奥娜",
          "text": "泉水精灵就离开了那个少年，再也没出现过。"
        },
        {
          "role": "诺艾尔",
          "text": "啊，对，就是这样。后来，时光飞逝，少年也慢慢变老，但他一直相信这场相遇不是一个梦。"
        },
        {
          "role": "重云",
          "text": "原来是个有些悲伤的故事…"
        },
        {
          "role": "卡莉露",
          "text": "那你们是怎么看那位泉水精灵的呢？"
        },
        {
          "role": "行秋",
          "text": "我觉得她应当是出于好意才做了那样的决定。但这好意最终变为了误会，让人有些惋惜…"
        },
        {
          "role": "卡莉露",
          "text": "那你们认为，如果现在有机会的话，她应该回去见见那位少年吗？"
        },
        {
          "role": "派蒙",
          "text": "现在？是说故事里的少年变老之后吗？"
        },
        {
          "role": "米卡",
          "text": "唔…会不会太晚了些？如果二人又因此留下遗憾的话…"
        },
        {
          "role": "米卡",
          "text": "啊，抱歉，我好像太悲观了…"
        },
        {
          "role": "派蒙",
          "text": "如果我是那位少年的话…唔，好吧，我还是想再见一见那位精灵的，不管我变得多老了，毕竟是自己喜欢的人嘛。"
        },
        {
          "role": "卡莉露",
          "text": "这样吗…"
        },
        {
          "role": "温迪",
          "text": "哦？这里好热闹呀，大家还在研讨新的对子吗？有需要我帮忙的吗？"
        },
        {
          "role": "派蒙",
          "text": "卖唱的还是好好当主持人吧！你下场的话，对子要被你抢完的。"
        },
        {
          "role": "温迪",
          "text": "哈哈，想不到派蒙对我的评价那么高呀。"
        },
        {
          "role": "温迪",
          "text": "但对对子游戏已经到此为止啦，明天的活动内容，是「自由撰诗」！"
        },
        {
          "role": "米卡",
          "text": "要和大家分享自己写的诗吗？"
        },
        {
          "role": "温迪",
          "text": "没错，要是没信心的话，现在报名温迪老师的诗歌加强班，还来得及哦。"
        },
        {
          "role": "诺艾尔",
          "text": "我要参加！"
        },
        {
          "role": "米卡",
          "text": "我也要！"
        },
        {
          "role": "派蒙",
          "text": "别急着推荐课程啦…「自由」是有多自由？连一点要求都没有吗？"
        },
        {
          "role": "温迪",
          "text": "当然是「最大程度」的自由。体裁不限，内容不限，只要是发自内心的所思所想，就欢迎大家用诗歌写下来。"
        },
        {
          "role": "温迪",
          "text": "试试吧，是一个说出心里话的好机会哦！"
        },
        {
          "role": "派蒙",
          "text": "唔…感觉一下子方向好多。能写旅行，还能写旅行者给我做的好吃的…"
        },
        {
          "role": "派蒙",
          "text": "卡莉露也会来的吧？我也想看你写的诗！"
        },
        {
          "role": "卡莉露",
          "text": "嗯…好，我会来的。"
        },
        {
          "role": "温迪",
          "text": "唔，我鼻子也有点痒了…那就这么说好了，大家回去构思构思，睡个好觉，我们明天见！"
        }
      ],
