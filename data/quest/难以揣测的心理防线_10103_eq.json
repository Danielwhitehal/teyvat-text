{
  "quest_id": 10103,
  "chapter_num": "智巧灵蕈大竞逐 第四幕",
  "chapter_title": "难以揣测的心理防线",
  "type": "eq",
  "route": "Unfathomable Defenses",
  "stories": [
    {
      "story_id": 40084,
      "title": "难以揣测的心理防线",
      "description": "「月莲杯」的比赛仍在继续。收集了大量线索后，事情似乎出现了某种转机…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到第二天上午（8：00-10：00）"
        },
        {
          "type": "subtitle",
          "text": "参加比赛"
        },
        {
          "type": "subtitle",
          "text": "击败对手"
        },
        {
          "role": "铁骨双刀",
          "text": "是你们，见识浅薄的鼠辈。"
        },
        {
          "role": "派蒙",
          "text": "好大的口气！凭什么这么说！"
        },
        {
          "role": "铁骨双刀",
          "text": "对蕈兽投入多余的情感，何其软弱，何其可笑！这有悖于最强的驯兽师，海妮耶大人的理念。"
        },
        {
          "role": "派蒙",
          "text": "最强的驯兽师…"
        },
        {
          "role": "旅行者",
          "text": "我们会纠正海妮耶的想法。"
        },
        {
          "role": "铁骨双刀",
          "text": "别妄想了！软弱之人没有资格和海妮耶大人对阵，你们会止步于此！"
        },
        {
          "type": "subtitle",
          "text": "与对手对话"
        },
        {
          "role": "铁骨双刀",
          "text": "不可能！这绝无可能…难道是我对蕈兽的训练还不够严格吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…虽然打败了他，但总感觉高兴不起来呢。"
        },
        {
          "type": "subtitle",
          "text": "离开赛场"
        },
        {
          "type": "subtitle",
          "text": "与莱依拉交谈"
        },
        {
          "role": "莱依拉",
          "text": "旅行者，派蒙，我成功晋级了！"
        },
        {
          "role": "派蒙",
          "text": "太好了，莱依拉！你顺利完成了参赛的目标！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可喜可贺！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱依拉",
          "text": "我听说你们打败了那个一路过关斩将的「铁骨双刀」…为什么我感觉，你们好像有点不开心？"
        },
        {
          "role": "派蒙",
          "text": "怎么说呢…这个对手不太友善，说了很多奇怪的话…"
        },
        {
          "type": "subtitle",
          "text": "向莱依拉讲述了对决中的细节…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "莱依拉",
          "text": "原来是这样…总觉得这样的驯兽师有点…悲哀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "悲哀？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱依拉",
          "text": "嗯，那个人明明不了解海妮耶，只凭一个朦胧的印象去揣测她，甚至效仿她。海妮耶要是知道了这种事，大概也会苦恼的吧。"
        },
        {
          "role": "莱依拉",
          "text": "而且，那个驯兽师对原本可以成为好朋友的蘑菇伙伴这么严苛，不止自己受到了损失，还会影响其他选手的心态…"
        },
        {
          "role": "派蒙",
          "text": "对啊，我觉得莱依拉的心态就很好！大家都和你一样的话，比赛的气氛也会更和谐，更欢乐！"
        },
        {
          "role": "莱依拉",
          "text": "只是因为我的目标不高吧…只要能把「转转悠悠兽」带回去一起生活，我就很满足了。"
        },
        {
          "role": "莱依拉",
          "text": "接下来就轮到我们较量了。我们要友好、开心地比试一场，输赢不重要，当成朋友间的切磋就行。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一言为定！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好哦！让我们看看「转转悠悠兽」和「咚咚小圆帽」谁更厉害！赢了的一边要请输了的吃饭！"
        },
        {
          "role": "八重神子",
          "text": "看你们开开心心地作出约定，难道我错过了什么关键的讨论吗？"
        },
        {
          "role": "派蒙",
          "text": "神子，你总算出现了！上次你不声不响就走了，我们还有些线索…呃咳，还有些事想要和你商量！"
        },
        {
          "role": "八重神子",
          "text": "我也很苦恼呢，我抱着随便玩玩的想法参赛，结果反而进入了半决赛，只能挤出时间陪着左右加他们取材了。"
        },
        {
          "role": "八重神子",
          "text": "你们两个倒是不必担心，想必会进行一场非常和谐的比赛。我倒是要稍微认真一点了，毕竟对手是那个无比偏执的家伙呢。"
        },
        {
          "role": "莱依拉",
          "text": "确实，没想到情况会变成这样，八重小姐居然要和海妮耶对阵了…"
        },
        {
          "role": "派蒙",
          "text": "乐观一点，说不定神子就帮我们把海妮耶打败了呢！"
        },
        {
          "role": "派蒙",
          "text": "虽然那样就不能亲自说服海妮耶了，但我还是不希望神子输掉！"
        },
        {
          "type": "subtitle",
          "text": "参加半决赛"
        },
        {
          "type": "subtitle",
          "text": "与莱依拉切磋"
        },
        {
          "role": "莱依拉",
          "text": "我有点紧张，但也很期待！"
        },
        {
          "role": "莱依拉",
          "text": "请你们不要太拘束，「转转悠悠兽」带领的队伍经历过不少考验，实力也是不错的！让你们的伙伴拿出全力吧！"
        },
        {
          "role": "派蒙",
          "text": "那就接招吧，莱依拉，还有「转转悠悠兽」！"
        },
        {
          "type": "subtitle",
          "text": "与莱依拉对话"
        },
        {
          "role": "莱依拉",
          "text": "结果还是输了呀…"
        },
        {
          "role": "莱依拉",
          "text": "不过你和同伴们发挥得比平常还好，「转转悠悠兽」！我很尽兴，很开心！"
        },
        {
          "role": "莱依拉",
          "text": "谢谢你们！我和「转转悠悠兽」的比赛完美落幕了，如果被你以外的人打败，也许我们还会有点不服气呢。"
        },
        {
          "role": "派蒙",
          "text": "莱依拉和「转转悠悠兽」也很强哦，我们差一点就被你们压倒了呢！"
        },
        {
          "role": "派蒙",
          "text": "不在乎胜负，只是尽情发挥蕈兽们的本领，好好比拼一场…这种感觉真的很畅快。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也许这才是比赛该有的样子…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "要是每场比赛都像这样，不用在意其他因素就好了。但是现在神子还在和海妮耶对决！我超级不安！我们赶紧去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "离开赛场"
        },
        {
          "type": "subtitle",
          "text": "与八重神子对话"
        },
        {
          "role": "派蒙",
          "text": "咦…难道比赛已经结束了？这凝重的气氛…是神子赢了吗！"
        },
        {
          "role": "八重神子",
          "text": "你们的比赛也完满落幕了？花费了这么长的时间，看来是一场旗鼓相当的对决呢…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，看神子这轻松的口吻，肯定赢得很轻松！"
        },
        {
          "role": "八重神子",
          "text": "啊呀呀，我们这边的比赛确实没有任何悬念呢，我和「百雷遮罗」只用短短几招就——"
        },
        {
          "role": "八重神子",
          "text": "被海妮耶打败了。"
        },
        {
          "role": "派蒙",
          "text": "欸？"
        },
        {
          "role": "海妮耶",
          "text": "你那散漫的态度…是在戏弄我吗？"
        },
        {
          "role": "八重神子",
          "text": "呵呵，我可不敢轻视你，海妮耶小姐。毕竟你的意志格外坚定，甚至想要毁灭一整个物种，我怎么敢对你随便开玩笑呢？"
        },
        {
          "role": "八重神子",
          "text": "不过，要是你沿着这条路继续走下去，发现沿途所见的景象和想象的完全不同，你的执着又会转变成什么？我很期待哦…"
        },
        {
          "role": "海妮耶",
          "text": "不劳你操心。"
        },
        {
          "role": "八重神子",
          "text": "这就逃走了？"
        },
        {
          "role": "莱依拉",
          "text": "输掉比赛的明明是八重小姐，反而好像是海妮耶受到的打击更大？"
        },
        {
          "role": "八重神子",
          "text": "事态变得愈发有趣了，比赛刚开始，「百雷遮罗」就伤到了「火一」，海妮耶明显有些慌乱。"
        },
        {
          "role": "八重神子",
          "text": "我只不过是点破她还在自我欺骗的这个事实，她的心理防线就快要崩溃了，出人意料的脆弱呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "自我欺骗？",
              "dialogues": []
            },
            {
              "text": "心理防线？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "莫非，海妮耶并不像她说的那样绝情？她其实是关心「火一」的，只不过在神子面前暴露了？"
        },
        {
          "role": "八重神子",
          "text": "答对啦，现在正是深入她内心世界的好时机。能改变她的，就只有小家伙们啦。"
        },
        {
          "role": "派蒙",
          "text": "但现在海妮耶已经走远了，我们要去哪里找她呢？"
        },
        {
          "role": "八重神子",
          "text": "这种时候，她想必在怀疑，一直以来无比决绝的自己究竟受到了什么影响，居然有些动摇？"
        },
        {
          "role": "八重神子",
          "text": "答案就在你们三位身上。你们很清楚，她会去什么地方。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我，派蒙和莱依拉？",
              "dialogues": []
            },
            {
              "text": "难道说…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱依拉",
          "text": "我遇见旅行者和派蒙的那个地方？"
        },
        {
          "role": "派蒙",
          "text": "仔细想想，那天莱依拉提到要将蕈兽带回日常的生活，当成重要的同伴，海妮耶的脸色就变了…莱依拉的感觉真的没错！"
        },
        {
          "role": "派蒙",
          "text": "我们快点追上去，和海妮耶好好谈谈吧！"
        },
        {
          "role": "八重神子",
          "text": "小莱依拉，你就留下来吧？你想帮助海妮耶的心情我理解，不过她并不是你擅长应付的类型哦。这次就先交给小家伙们吧…"
        },
        {
          "role": "莱依拉",
          "text": "也是呢…万一我又不小心说错话，刺激了海妮耶，那反而更糟糕。而且大家的动作都好快，我追到一半就会累倒吧…"
        },
        {
          "role": "八重神子",
          "text": "怎么还不动身，小家伙？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里是之前找到的东西。",
              "dialogues": []
            },
            {
              "text": "请你过目，稍作分析。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "啊呀，收获比我想象得还要丰富呢。"
        },
        {
          "role": "八重神子",
          "text": "那我也给你加上「好运」的祝福吧，下次见面的时候，我再和你聊聊我的见解。"
        },
        {
          "type": "subtitle",
          "text": "前往谈话中提到的地点"
        },
        {
          "type": "subtitle",
          "text": "利用元素视野寻找海妮耶"
        },
        {
          "role": "海妮耶",
          "text": "嗯？你们是怎么找到这里的…"
        },
        {
          "role": "派蒙",
          "text": "我们是追着「火一」的痕迹找过来的，看见你刚才的状态，我们很不安！"
        },
        {
          "role": "派蒙",
          "text": "等等…你这是在安慰「火一」吗？"
        },
        {
          "role": "海妮耶",
          "text": "还真是讽刺…如果「火一」不是蕈兽，而是普通的动物，我大概会为此感到高兴。"
        },
        {
          "role": "海妮耶",
          "text": "下次见面就是决赛了，有什么想说的，就等到打败我以后再唠叨…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们想了解你的想法。",
              "dialogues": []
            },
            {
              "text": "我们想消除你的偏见。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海妮耶",
          "text": "你们的说辞和那个狐狸女人预测的完全一样…你们确实很单纯，很善良，把一些事情想得太过美好。"
        },
        {
          "role": "海妮耶",
          "text": "只凭我简单的转述，是不能让你们理解的。看看这个吧…"
        },
        {
          "role": "派蒙",
          "text": "这是？"
        },
        {
          "role": "海妮耶",
          "text": "这是我的祖辈们的记事簿，当年，他们在雨林中遭到了蕈兽的攻击，许多人身受重伤。"
        },
        {
          "role": "海妮耶",
          "text": "这件事在当时不值一提，甚至没有被任何文献记载。但我的家族成员自我小时候起，就反复把它念给我听，教导我蕈兽的威胁。"
        },
        {
          "role": "派蒙",
          "text": "原来以前发生过这样的事，难怪你这么仇视蕈兽…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们的确不清楚你的身世。",
              "dialogues": []
            },
            {
              "text": "但如今的情况不同了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "确实，如果你有这样的过去，应该更能理解这场比赛的可取之处，毕竟「意智宝珠」能让人们和蕈兽和谐相处…"
        },
        {
          "role": "海妮耶",
          "text": "事情没有那么简单，你们认为「意智宝珠」能让蕈兽变得温顺。以前也有学者来到村子里，用相似的道具做过实验。"
        },
        {
          "role": "海妮耶",
          "text": "但他们都失败了，丢盔弃甲逃走了。如今的「意智宝珠」也只能暂时压制蕈兽的凶恶本性，脱离了这种道具，蕈兽依然万分危险。"
        },
        {
          "role": "海妮耶",
          "text": "而且，宝珠的「理智增幅」会让蕈兽的元素力异常活跃，影响周围的环境，身体不够强健的人使用宝珠后，很快就会出现不适症状。"
        },
        {
          "role": "旅行者",
          "text": "元素力的异常…"
        },
        {
          "role": "派蒙",
          "text": "难道说莱依拉最近老是咳嗽，就是因为「意智宝珠」的这个缺点？"
        },
        {
          "role": "海妮耶",
          "text": "不用我多说，你们应该也明白，考特里亚是个学术疯子，他只想着扩大自己的影响力，推广驯兽活动。"
        },
        {
          "role": "海妮耶",
          "text": "那个埃尔欣根也是个见风使舵的家伙，看中了考特里亚的研究成果，用雄厚的资金宣传这场比赛，从而使人们对蕈兽放下戒心…"
        },
        {
          "role": "海妮耶",
          "text": "不管怎么样，我不相信他们，不相信凶恶的蕈兽可以和人们共处。但作为一个小小的退役佣兵，我的声音无法被任何人听见。"
        },
        {
          "role": "海妮耶",
          "text": "我只能在他们的规则里赢得胜利，争取我想要的结局，不让他们得逞。"
        },
        {
          "role": "海妮耶",
          "text": "原本我还有一丝希望，期待你们能帮我，结果是我太天真了。不管你们怎么想，怎么看待我，我都会打败你们，从你们身上踏过去。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "海妮耶！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海妮耶",
          "text": "这本笔记就像是我的过去，你们想要怎么处置它都无所谓了。反正等到决赛那天，我会宣布处死所有蕈兽…包括「火一」。"
        },
        {
          "role": "海妮耶",
          "text": "和我的过去永别。"
        },
        {
          "type": "subtitle",
          "text": "与派蒙进行讨论"
        },
        {
          "role": "派蒙",
          "text": "结果还是失败了，只有在赛场上打败海妮耶这一个选择了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "至少听到了她的真实想法。",
              "dialogues": []
            },
            {
              "text": "至少拿到了她的记事簿。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "海妮耶好像说过，以前也有学者尝试遏制蕈兽造成的灾害？这本笔记还有不少内容，我们再好好读一读吧。"
        },
        {
          "role": "派蒙",
          "text": "这是海妮耶的祖辈收集的…学者们的研究记录？"
        },
        {
          "role": "派蒙",
          "text": "唔，这部分的内容好复杂，字迹潦草，还有很多术语，怎么想都看不懂吧…"
        },
        {
          "role": "派蒙",
          "text": "不过，有很多眼熟的词语欸…好像在之前多莉给我们的文件上见过！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "笔记和文件有关联。",
              "dialogues": []
            },
            {
              "text": "我们结合两边的信息吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，我们仔细一点，对照着文件残卷，试着解读笔记的内容吧。"
        },
        {
          "role": "派蒙",
          "text": "捕获装置？枯化药剂？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "捕获装置使蕈兽温和。",
              "dialogues": []
            },
            {
              "text": "枯化药剂使蕈兽暴躁。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "原来是这样…当年袭击海妮耶祖辈的蕈兽，是被药剂影响后才失控的…学者们造出捕获装置，是为了抓住那些发狂的蕈兽。"
        },
        {
          "role": "派蒙",
          "text": "而且，现在的「花花琼脂」就是「枯化药剂」的改进版，「意智宝珠」也根本不是考特里亚的发明…"
        },
        {
          "role": "派蒙",
          "text": "考特里亚只不过是在捕获装置的基础上给自己搞了两个新包装，大骗子！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大骗子！！",
              "dialogues": []
            },
            {
              "text": "好啦，其实也不太意外。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "但考特里亚这么想推广「意智宝珠」，到底有什么目的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也许是想完成前人的试验…",
              "dialogues": []
            },
            {
              "text": "以此证明自己的能力…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那我们必须早点警告埃尔欣根，不能再资助考特里亚那家伙了。"
        },
        {
          "role": "派蒙",
          "text": "至于海妮耶…当时袭击她祖辈的蕈兽全都受到了刺激，这件事她完全不知情，难怪会觉得蕈兽不可饶恕呢…"
        },
        {
          "role": "派蒙",
          "text": "别担心，「咚咚小圆帽」，我相信你不会因为「花花琼脂」变得暴躁！毕竟关闭了「意智宝珠」后，你也是个好孩子！"
        },
        {
          "role": "派蒙",
          "text": "啊呀，你好像完全能听懂我的话了？越来越聪明了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等等，派蒙…",
              "dialogues": []
            },
            {
              "text": "「意智宝珠」并没有运转。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "咦？什么时候的事！完全没有注意到…"
        },
        {
          "role": "派蒙",
          "text": "也就是说，现在的「咚咚小圆帽」，正在凭自己本来的心性和我们共处吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "共处的经历影响了它。",
              "dialogues": []
            },
            {
              "text": "我们正在达成默契。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "所以说嘛！我绝不同意海妮耶关于蕈兽还会失控的推测！蕈兽里也有好蕈兽，就像「咚咚小圆帽」一样通人性！"
        },
        {
          "role": "派蒙",
          "text": "可是有一点，海妮耶说得有道理呢…「意智宝珠」不是万能的，只要那个缺点还在，蕈兽伙伴就不能一直待在普通人身边。"
        },
        {
          "role": "派蒙",
          "text": "我还以为可以和「咚咚小圆帽」一起继续旅行下去呢…就不能想想办法吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "先和伙伴们保持适当的距离…",
              "dialogues": []
            },
            {
              "text": "一边寻找改进宝珠的方法…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "虽然有点可惜，但目前看来，也只能这样了吧。"
        },
        {
          "role": "派蒙",
          "text": "现在距离决赛还有一段时间，我们要向教令院报告考特里亚的事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们不清楚考特里亚的势力…",
              "dialogues": []
            },
            {
              "text": "不能贸然打草惊蛇…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "确实呢…考特里亚能干出这种大事，肯定谋划了很久。如果我们打算戳穿他的事被他提前知道了，他应该也会提防我们的！"
        },
        {
          "role": "派蒙",
          "text": "不管怎么样，决赛的那天，我们一定要拿出全力！先打败海妮耶，让她别再固执，然后说服埃尔欣根，一起揭露考特里亚的阴谋！"
        }
      ]
    }
  ]
}