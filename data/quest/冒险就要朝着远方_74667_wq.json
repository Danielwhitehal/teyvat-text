  "chapter_title": "冒险就要朝着远方",
  "type": "wq",
  "route": "Another Horizon of Adventure",
  "stories": [
    {
      "story_id": 74667,
      "title": "冒险就要朝着远方",
      "description": "在枫丹廷，你又遇见了…凯瑟琳…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与凯瑟琳对话"
        },
        {
          "role": "凯瑟琳",
          "text": "向着星辰与深渊！欢迎来到冒险家协会，请问有什么可以帮您的吗？"
        },
        {
          "role": "派蒙",
          "text": "又，又是凯瑟琳。这一位应该也是「人偶」吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "应该是吧…",
              "dialogues": []
            },
            {
              "text": "应该没有第二种可能…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "请问我有什么可以帮您的吗？您是想要接取委托，还是发放委托？"
        },
        {
          "role": "旅行者",
          "text": "我只是顺便来看一眼…"
        },
        {
          "role": "凯瑟琳",
          "text": "这样啊…如果您遇见了任何和协会有关的问题，都可以来问我。"
        },
        {
          "role": "凯瑟琳",
          "text": "我会竭诚为您提供最完善的服务，解答一切能够解答的问题。"
        },
        {
          "role": "凯瑟琳",
          "text": "那么，感谢您对协会做出的贡献，冒险家。祝您的冒险旅途一帆风顺！"
        }
      ]
    }
  ]
}