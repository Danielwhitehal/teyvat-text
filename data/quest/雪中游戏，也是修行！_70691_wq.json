{
  "quest_id": 70691,
  "chapter_num": null,
  "chapter_title": "雪中游戏，也是修行！",
  "type": "wq",
  "route": "Playing in the Snow Counts as Training Too!",
  "stories": [
    {
      "story_id": 70691,
      "title": "雪中游戏，也是修行！",
      "description": "越野赛期间，可莉似乎有了不同寻常的遭遇，去看看她吧…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与可莉对话"
        },
        {
          "role": "可莉",
          "text": "荣誉骑士哥哥！这边这边！"
        },
        {
          "role": "可莉",
          "text": "可莉交到了新朋友！要和我们一起玩吗？"
        },
        {
          "role": "可莉",
          "text": "哥哥姐姐们教给我们一种新游戏，叫做「雪白迷踪」。"
        },
        {
          "role": "可莉",
          "text": "规则也不难，就是很特别的捉迷藏！"
        },
        {
          "role": "派蒙",
          "text": "哇哇，可莉、瑶瑶和早柚，你们交上朋友啦！"
        },
        {
          "role": "派蒙",
          "text": "听这个游戏的名字，像是「风行迷踪」的改进版？和你们一起玩，肯定非常有意思！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好呀好呀，捉迷藏！",
              "dialogues": []
            },
            {
              "text": "让我也认识一下可莉的新朋友~",
              "dialogues": []
            }
          ]
        },
        {
          "role": "早柚",
          "text": "阿嚏…虽然在营地里就不怎么冷了，但还是有点困…"
        },
        {
          "role": "早柚",
          "text": "唔？我是不是眼花了，怎么好像看到了旅行者和派蒙？"
        },
        {
          "role": "瑶瑶",
          "text": "你没有眼花哦，旅行者和派蒙确实来啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们好呀，瑶瑶和早柚！",
              "dialogues": []
            },
            {
              "text": "要一起来玩捉迷藏吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "可莉",
          "text": "动起来，开开心心玩游戏，就不会打瞌睡啦！"
        },
        {
          "role": "瑶瑶",
          "text": "那位严肃的[[堇葵]]小姐不是也说过吗，早柚在雪山多转转，也对自己的本领有好处？"
        },
        {
          "role": "早柚",
          "text": "呃，你们居然都记住了！"
        },
        {
          "role": "早柚",
          "text": "好吧…如果输给那几位同行，甚至是超级忍犬的话…之后偷懒肯定会被抓得更严！"
        },
        {
          "role": "早柚",
          "text": "看来这次出远门的修行，确实要认真起来了。"
        },
        {
          "role": "瑶瑶",
          "text": "没事哦，我准备了新做法的蔬菜炖肉，加入了绝云椒椒和胡椒的粉末。"
        },
        {
          "role": "瑶瑶",
          "text": "开玩之前吃几口，整场捉迷藏都不会冷哦。"
        },
        {
          "role": "早柚",
          "text": "太好了！待会儿，我先来一整碗！"
        },
        {
          "role": "派蒙",
          "text": "我也要，我也要！"
        },
        {
          "role": "可莉",
          "text": "那——雪山捉迷藏，准备开始啦！"
        },
        {
          "role": "派蒙",
          "text": "嘿呀！雪山到处都是白色，我躲起来，肯定不容易被发现！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（瑶瑶）"
        },
        {
          "role": "瑶瑶",
          "text": "旅行者，一起来玩「雪白迷踪」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来吧，开开心心捉迷藏！",
              "dialogues": [
                {
                  "role": "瑶瑶",
                  "text": "嗯！我提醒大家做好准备！"
                }
              ]
            },
            {
              "text": "瑶瑶专程来看比赛吗？",
              "dialogues": [
                {
                  "role": "瑶瑶",
                  "text": "没有哦，这次的事，说来也巧…"
                },
                {
                  "role": "瑶瑶",
                  "text": "再过不久，师姐要招待远方来的，戴着大厨高帽子的金发姐姐，正在忙着准备新鲜有趣的菜式。"
                },
                {
                  "role": "瑶瑶",
                  "text": "和烟绯姐姐闲聊的时候，师姐灵机一动，想到以前还没融合过璃月和蒙德的菜式，就打算到蒙德来找找食谱。"
                },
                {
                  "role": "瑶瑶",
                  "text": "不过，最近万民堂那边很忙，走不开，所以就由我跟着烟绯姐姐，代师姐来一趟。"
                },
                {
                  "role": "瑶瑶",
                  "text": "师父说，就当是我出门历练一回了。跟着烟绯姐姐，师父也放心。"
                },
                {
                  "role": "旅行者",
                  "text": "收获怎么样？"
                },
                {
                  "role": "瑶瑶",
                  "text": "很棒哦！除了饭馆里的本地特色的食谱，我还去大大的骑士团图书馆里，借了一些更深奥的，讲蒙德烹饪理论的书。"
                },
                {
                  "role": "瑶瑶",
                  "text": "回去以后，我会叮嘱师姐好好看完的，到时候，她应该就能想出「让人下巴都合不拢」的全新菜式了。"
                },
                {
                  "role": "瑶瑶",
                  "text": "当然，除了这些可以衡量价值和用途的东西，还有无价的收获——"
                },
                {
                  "role": "瑶瑶",
                  "text": "师傅说，「行走世间，广交朋友，是人生的一大乐趣」，这次认识了可莉妹妹和早柚姐姐，对我来说，再开心不过了。"
                },
                {
                  "role": "瑶瑶",
                  "text": "可莉的炸弹好有劲，正好弥补长枪难对付一群坏家伙的不足…还可以用来练习躲闪的步法，肯定能让人打下扎实的基本功…"
                },
                {
                  "role": "瑶瑶",
                  "text": "当然，对普通的习武之人，还是有点危险的，好在可莉明白这个道理，每次用炸弹都会确认周围没有一般人。"
                },
                {
                  "role": "瑶瑶",
                  "text": "早柚的伪装术也非常奇妙，以前我还没怎么了解过这种隐藏身形的特技…"
                },
                {
                  "role": "瑶瑶",
                  "text": "放在璃月的江湖传说中，熟练掌握这种技巧，来无影去无踪的武人，多半能成为无声惩恶扬善的大侠。"
                },
                {
                  "role": "瑶瑶",
                  "text": "下次再来的时候，我想带上七七，我觉得，我们四个应该很合得来！"
                }
              ]
            },
            {
              "text": "蒙德的饭菜合胃口吗？",
              "dialogues": [
                {
                  "role": "瑶瑶",
                  "text": "完全能接受哦，而且，让我意外的是，有些料理的口味，和璃月菜有着相通的地方，比如北地烟熏鸡..."
                },
                {
                  "role": "瑶瑶",
                  "text": "我给师姐借的那本书里还提到，以前的蒙德，还流行过专门腌制的酸口蔬菜…"
                },
                {
                  "role": "瑶瑶",
                  "text": "单看描述和配菜的方法，和师父说过的一种璃月特产很像，黑岩厂的人们很喜欢，真是有意思的巧合…"
                },
                {
                  "role": "瑶瑶",
                  "text": "回去的时候，我就带上一些耐放的蒙德料理，下次和七七郊游的时候，请她也尝尝。"
                },
                {
                  "role": "瑶瑶",
                  "text": "也要为你准备特制的一份！蒙德到处都是你的威风传说，传统的蒙德菜你应该很熟悉了。"
                },
                {
                  "role": "瑶瑶",
                  "text": "所以我也要开动脑筋，试着把轻策农家菜和蒙德的食材结合一下，给你一点惊喜！"
                }
              ]
            },
            {
              "text": "待会儿再来玩。",
              "dialogues": [
                {
                  "role": "瑶瑶",
                  "text": "没问题哦，我们一直都在！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（早柚）主营地北方岩石上"
        },
        {
          "role": "早柚",
          "text": "呼啊…旅行者，你可真有精神，难道一直不用休息的嘛？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "早柚的雪山之旅愉快吗？",
              "dialogues": [
                {
                  "role": "早柚",
                  "text": "唔…如果不算堇葵的训练科目，这次的工作还挺轻松的。"
                },
                {
                  "role": "早柚",
                  "text": "忘记告诉你了，堇葵是新上任的目付。这次「终末番」来雪山出差，她算是领队，盯我盯得比巫女姐姐还严…"
                },
                {
                  "role": "早柚",
                  "text": "之前，他们派人参加了一个什么推演，出来见了见世面…"
                },
                {
                  "role": "早柚",
                  "text": "那个叫[[玄理]]的代行带回了一堆报告，得到了大人物的支持，然后到处联络旗本，推行新的训练办法，连「终末番」也逃不了…"
                },
                {
                  "role": "早柚",
                  "text": "具体的细节我不明白…但，呜呼流也不是适合正面战斗的流派！一直抓着我，让我努力根本没用嘛…"
                },
                {
                  "role": "早柚",
                  "text": "最多，让我教教他们的新忍犬，那只咕咕丸，怎么样才能藏得更好，随时随地睡大觉。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "原来是被要求加训了…",
                      "dialogues": []
                    },
                    {
                      "text": "但你现在好像不忙哦？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "早柚",
                  "text": "这要多谢可莉和瑶瑶…"
                },
                {
                  "role": "早柚",
                  "text": "我们刚到蒙德，在骑士团办手续的时候，可莉被我衣服上的尾巴吸引，好奇地问了我好多问题…"
                },
                {
                  "role": "早柚",
                  "text": "然后，她就邀请我一起来到这个营地，找到了瑶瑶。玩了两盘捉迷藏以后，我们算是交上朋友了。"
                },
                {
                  "role": "早柚",
                  "text": "可莉居然有个专门的称号「火花骑士」…听起来，好像还蛮威风的？"
                },
                {
                  "role": "早柚",
                  "text": "情报说，骑士团里有专门称号的都是队长级的大人物，甚至，他们的团长姐姐都只是「狮牙骑士」，听起来…半斤八两的样子？"
                },
                {
                  "role": "早柚",
                  "text": "所以，在骑士团里，可莉应该和团长差不多厉害，说话一样有分量！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "这…对…对吗？",
                      "dialogues": []
                    },
                    {
                      "text": "这…没…没错！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "早柚",
                  "text": "总之，堇葵是这么想的，她对可莉很尊敬！可莉说要和我玩，堇葵就不敢来叫我去训练了！"
                },
                {
                  "role": "早柚",
                  "text": "和可莉、瑶瑶待在一起的时候，我感觉非常自在。"
                },
                {
                  "role": "早柚",
                  "text": "虽然总是被误会成她们的同龄人，但也能拿到更多零食和礼物，有种不一样的开心…"
                },
                {
                  "role": "早柚",
                  "text": "要是不用坐那么久的船，我每天也能睡个饱的话…说不定，我会经常来找可莉？"
                }
              ]
            },
            {
              "text": "早柚还对蒙德的什么感兴趣？",
              "dialogues": [
                {
                  "role": "早柚",
                  "text": "果酒湖里的…鲈鱼！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "欸？有点意外…",
                      "dialogues": []
                    },
                    {
                      "text": "难道是因为可莉的口味？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "早柚",
                  "text": "嗯…可莉给我看过她妈妈的画片，好高好高…"
                },
                {
                  "role": "早柚",
                  "text": "孩子的身高，一般不会输给爸爸妈妈，所以可莉以后也能长到那种个头！"
                },
                {
                  "role": "早柚",
                  "text": "可莉说过，她喜欢吃果酒湖里现炸的鲈鱼，她的妈妈也觉得鲈鱼好，说明果酒湖的鲈鱼吃了对身体棒，长个子！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "这好办，我给你捣鼓两条…",
                      "dialogues": []
                    },
                    {
                      "text": "我也略懂「可莉炸鱼法」…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "早柚",
                  "text": "真的吗？感觉，不用这么麻烦你！"
                },
                {
                  "role": "早柚",
                  "text": "仔细一想，买当天打捞上来的鱼，做成这里特色的烤鱼，应该也差不多？反正炸上来的鱼，也是要仔细烹饪后才能吃的…"
                },
                {
                  "role": "早柚",
                  "text": "我先自己试试看好了！"
                }
              ]
            },
            {
              "text": "你说得对，我也去休息一下…",
              "dialogues": [
                {
                  "role": "早柚",
                  "text": "嗯，虽然你已经不用长身体的样子，但多睡睡，总没错！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（堇葵&咕咕丸）主营地西北方断桥上"
        },
        {
          "role": "堇葵",
          "text": "怎么样，想要挑战霜铠王吗？"
        },
        {
          "role": "咕咕丸",
          "text": "咕⋯嗷！"
        },
        {
          "role": "堇葵",
          "text": "那就沉下心来修炼，总有一天能做到的！"
        },
        {
          "role": "堇葵",
          "text": "不久后的武道会上，你就有第一次表现的机会了…"
        },
        {
          "role": "堇葵",
          "text": "作为终末番最新一代的忍犬，我相信，你能走得比任何一位前辈都远…"
        },
        {
          "role": "堇葵",
          "text": "当然，除了直接战斗，搜寻的技巧也要加强。"
        },
        {
          "role": "堇葵",
          "text": "下一阶段的目标，就是在[[鹿野奈奈]]小姐所用时间的五倍以内，找出藏匿睡觉的早柚大师…有信心吗？"
        },
        {
          "role": "咕咕丸",
          "text": "嗷嗷！"
        }
      ],
      "collapse_ranges": [
        [
          23,
          25
        ],
        [
          26,
          28
        ],
        [
          29,
          37
        ]
      ]
    }
  ]
}