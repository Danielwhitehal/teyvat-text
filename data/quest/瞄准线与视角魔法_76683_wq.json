{
  "quest_id": 76683,
  "chapter_num": null,
  "chapter_title": "瞄准线与视角魔法",
  "type": "wq",
  "route": "Sightlines and Camera Tricks",
  "stories": [
    {
      "story_id": 76683,
      "title": "瞄准线与视角魔法",
      "description": "枫丹柔灯港的南侧，一座特别的演习场地被搭建了起来…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与夏沃蕾对话"
        },
        {
          "role": "夏沃蕾",
          "text": "…弹道终点的毁伤效果无可挑剔，散布水平也接近理想模型。"
        },
        {
          "role": "夏沃蕾",
          "text": "恰斯卡小姐，按照执律庭武器部门的评估模型，你的武器完全达到了「火炮级」水准。"
        },
        {
          "role": "夏沃蕾",
          "text": "只可惜，至少需要两个班组的人力，才能勉强在战场上部署您的「铳枪」，操作门槛太高了…"
        },
        {
          "role": "恰斯卡",
          "text": "谢谢你的认可，夏沃蕾警官。其实操作门槛过高也不是坏事，找希诺宁定做「灵枪·仪式杖」前，我们就达成了共识——"
        },
        {
          "role": "恰斯卡",
          "text": "「越是强大的武器，越需要严苛的使用标准。」"
        },
        {
          "role": "恰斯卡",
          "text": "除了武器本身的操作难度，我甚至认为，这类武器需要加上「道德认知锁」之类的机制。"
        },
        {
          "role": "恰斯卡",
          "text": "如此一来，才能保证武力被正确的人掌握，防止某种强力武器被不法之徒窃取后，造成巨大的危害。"
        },
        {
          "role": "蒂蕾娜",
          "text": "单论枫丹，偷取武器再进行犯罪的案例的确屡见不鲜，恰斯卡长官的担忧非常有道理。"
        },
        {
          "role": "派蒙",
          "text": "哇，好多老朋友！"
        },
        {
          "role": "派蒙",
          "text": "枫丹的执律庭，纳塔「花羽会」…还有蒙德的骑士？大家聚在一起，是在干什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "重开多方交流会？",
              "dialogues": []
            },
            {
              "text": "又一场联合演习？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "是的，旅行者一眼就理解了状况。"
        },
        {
          "role": "夏沃蕾",
          "text": "此前，特巡队曾派蒂蕾娜前往璃月参加联合推演。以这场推演为契机，各国部队之间的交流频率不断提升。{{#info:[[「安固诸方之述演」]]}}"
        },
        {
          "role": "夏沃蕾",
          "text": "这次便是枫丹和蒙德例行的一场「射击推理大会」，旨在提升三方战士的战场规划能力。"
        },
        {
          "role": "蒂蕾娜",
          "text": "另外，多亏西风骑士团的朋友牵线搭桥，纳塔「花羽会」的勇士们也加入了推演。"
        },
        {
          "role": "蒂蕾娜",
          "text": "「花羽会」的勇士们擅长在飞行中射击，简直给我们打开了新世界的大门！"
        },
        {
          "role": "派蒙",
          "text": "唔…骑士们应该是在远征的过程中和纳塔勇士认识的吧？我早应该想到！"
        },
        {
          "role": "派蒙",
          "text": "不过，「射击推理大会」是怎么回事？每个词都明白，连在一起就有点迷惑…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "射击不是开枪就完了吗？",
              "dialogues": []
            },
            {
              "text": "子弹也能参加推演的吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "啊哈，如果人人都有无限的弹药，只需要一直压住扳机，就能轻松搞定大部分敌人了。"
        },
        {
          "role": "恰斯卡",
          "text": "但战斗是个漫长的过程，射手能携带的弹药很有限，每一枪都需要尽可能打准，打得更有策略。"
        },
        {
          "role": "恰斯卡",
          "text": "所以，骑士团研发出了一款新式榴弹，帮助射手提升自己的理解能力，原理有些复杂…"
        },
        {
          "role": "夏沃蕾",
          "text": "至于具体的原理，就让西风骑士团的朋友简单说说吧。"
        },
        {
          "role": "赫得蔚格",
          "text": "来了来了，失礼了！刚刚整理报告太认真，都没发现荣誉骑士和白色小帮手…向你们致以问候！"
        },
        {
          "role": "赫得蔚格",
          "text": "我是赫得蔚格，西风骑士团「综务小队」的成员，负责这次推演记录事务，协调枪匠们与其他友军的工作…"
        },
        {
          "role": "赫得蔚格",
          "text": "说起来，这次的机关还和你们有关呢，你们还记得达达乌帕谷曾出现过的神秘丘丘萨满雕像吗？{{#info:[[「奇境谜丘探幽行」]]}}"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有点印象，很久以前的事。",
              "dialogues": []
            },
            {
              "text": "不记得了，不过没关系吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "连我都没什么印象了，还是请赫得蔚格简单说说吧？"
        },
        {
          "role": "赫得蔚格",
          "text": "嗯。古老的故事和零散的情报，我就先省略了——"
        },
        {
          "role": "赫得蔚格",
          "text": "根据「调查小队」的判断，那是一位古老的丘丘萨满的产物，「分汤者」[[丘尔德里克]]改造了一处无人秘境，用于练习军阵。"
        },
        {
          "role": "赫得蔚格",
          "text": "荣誉骑士当时击败了丘尔德里克的一道残影，使得秘境崩解，监督军阵的「乌帕诺之眼」散落而出。"
        },
        {
          "role": "赫得蔚格",
          "text": "「支援小队」获得样本后，对其仔细拆解分析，用了大半年时间吃透了其中的技术，结合了璃月「俯瞰机关」的设计…"
        },
        {
          "role": "赫得蔚格",
          "text": "从而制作了一种可视化的「观测榴弹」，打算用于远程侦察，保证射手在安全的位置获得信息。"
        },
        {
          "role": "派蒙",
          "text": "过程未免太曲折了…没想到我们不怎么上心就搞定的家伙，留下了这种神秘宝物！"
        },
        {
          "role": "夏沃蕾",
          "text": "就结果而言，在推演中，「观测榴弹」能让射手们看到弹头飞行过程中的景象，加深对弹道和障碍物的理解…"
        },
        {
          "role": "夏沃蕾",
          "text": "结合射击训练后的复盘会，「推理」更好的射击角度，优化目标分配的次序，大大提升作战效率。"
        },
        {
          "role": "恰斯卡",
          "text": "对于「花羽会」这边，龙骑士们骑乘绒翼龙战斗的难题之一，就是确认命中的效果。毕竟飞在天上，目标太远…"
        },
        {
          "role": "恰斯卡",
          "text": "有了这种「观测榴弹」，也能更加高效地进行「毁伤评估」…这个词是从特巡队学到的，非常精确的概念。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来还挺不错。",
              "dialogues": []
            },
            {
              "text": "能帮上忙就挺好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "赫得蔚格",
          "text": "目前，参与推演的人员已经完成了夏沃蕾和恰斯卡两位队长的所有想定。"
        },
        {
          "role": "赫得蔚格",
          "text": "距离完美完成「推理大会」，只差扩充战例样本了…"
        },
        {
          "role": "赫得蔚格",
          "text": "既然荣誉骑士也在，要不要来试试看？"
        },
        {
          "role": "蒂蕾娜",
          "text": "我举双手支持！"
        },
        {
          "role": "蒂蕾娜",
          "text": "「千灵映影节」的时候，我就发现了，旅行者是准度和灵感双双满分的射手。{{#info:[[「蔷薇与铳枪」]]}}"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯，确实非常合适。"
        },
        {
          "role": "夏沃蕾",
          "text": "从我个人的角度出发，我很好奇，这些年来，旅行者的射术进步到了什么等级。"
        },
        {
          "role": "夏沃蕾",
          "text": "从演练全局的角度，旅行者对「观测榴弹」的机制完全陌生，也正好为我们引入漂亮的对照组。"
        },
        {
          "role": "派蒙",
          "text": "我怎么觉得，抛开别的不说，「观测榴弹」本身的诞生，还和我们…挺有缘的？"
        },
        {
          "role": "派蒙",
          "text": "体验一下它的神奇效果，好像也挺有意思的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我当然要认真上阵。",
              "dialogues": []
            },
            {
              "text": "练练射击对我自己也有好处。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦，技多不压身，说不定之后的冒险中，还会碰到…只用铳枪打倒敌人的场合呢？"
        },
        {
          "role": "赫得蔚格",
          "text": "真是再好不过了，我这就着手准备场地，通知扮演目标的大家！"
        },
        {
          "role": "赫得蔚格",
          "text": "规则很简单：尽可能用更少的「调整弹道」次数，高效地击倒所有标靶…"
        },
        {
          "role": "夏沃蕾",
          "text": "事先提醒哦，这次的演练有点难度，上一任特巡队的射术教官昂吉安妮也只能勉强及格…"
        },
        {
          "role": "夏沃蕾",
          "text": "但我相信，你肯定会拿到令人眼前一亮的好成绩。"
        },
        {
          "role": "恰斯卡",
          "text": "当然，也不用有压力，要知道，有时候射击不仅仅需要技巧，还需要几片羽毛那么重的灵感，和一点点散布的运气。"
        },
        {
          "role": "恰斯卡",
          "text": "对你来说，别把它当成测试，而是一种放松的游戏，说不定还会收获意外的乐趣呢？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（恰斯卡）"
        },
        {
          "role": "恰斯卡",
          "text": "总算又见面了，旅行者，近来可好？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢关心！你在枫丹玩得如何？",
              "dialogues": [
                {
                  "role": "恰斯卡",
                  "text": "实话说，有好有坏，坏的放在前头——"
                },
                {
                  "role": "恰斯卡",
                  "text": "乘着灵枪越过开阔水域时，我太过靠近射击训练区，特巡队员们误以为我是浮空靶标，对我打了两轮齐射…"
                },
                {
                  "role": "恰斯卡",
                  "text": "还好当时空速够快，他们没有拿准提前量，一发未中，夏沃蕾队长也及时赶到，叫停了她们。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "挺倒霉的…",
                      "dialogues": []
                    },
                    {
                      "text": "没有误会和冲突就好…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "恰斯卡",
                  "text": "然后就只有好事了——"
                },
                {
                  "role": "恰斯卡",
                  "text": "我在城里逛了几圈，悠悠哉哉地欣赏了人造的精美建筑，华丽的机关与饰品，还有漂亮复杂的服饰。"
                },
                {
                  "role": "恰斯卡",
                  "text": "原本我还在担心，枫丹廷是座石材围堵着的城塞，视野不够开阔，会不会很压抑？"
                },
                {
                  "role": "恰斯卡",
                  "text": "实际上，和「花羽会」的居住体验截然相反，被高大的建筑包围时，不知怎么，有种奇妙的安全感。"
                },
                {
                  "role": "恰斯卡",
                  "text": "等到演习结束了，我还想再去城里转两圈。"
                }
              ]
            },
            {
              "text": "先聊聊你和特巡队的合作感受？",
              "dialogues": [
                {
                  "role": "恰斯卡",
                  "text": "高于预期，还不止一星半点。"
                },
                {
                  "role": "恰斯卡",
                  "text": "他们的纪律性非常强，虽然我已经可以预想到，一些部族勇士会嫌他们太死板，打起仗来就不该束手束脚…"
                },
                {
                  "role": "恰斯卡",
                  "text": "但，训练过基础水平参差不齐的新手后，我就慢慢明白了。"
                },
                {
                  "role": "恰斯卡",
                  "text": "在个体没有足够强横的实力时，合作与纪律是保证稳定战力的最后手段。"
                },
                {
                  "role": "恰斯卡",
                  "text": "因此，我有个不一定能实现的想法——"
                },
                {
                  "role": "恰斯卡",
                  "text": "带夏沃蕾队长回纳塔去，拉拢她加入「花羽会」战士的队伍。"
                },
                {
                  "role": "恰斯卡",
                  "text": "摩拉的问题不好说，毕竟枫丹这边的薪酬和消费水平都很高…我会尽可能想办法开出…摩拉以外，让她满意的价码。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你觉得特巡队比龙骑士厉害？",
                      "dialogues": []
                    },
                    {
                      "text": "我以为你会觉得勇士们更强。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "恰斯卡",
                  "text": "不，这不是实力谁高谁低的问题，重点在于取长补短。"
                },
                {
                  "role": "恰斯卡",
                  "text": "我为「花羽会」的战士们骄傲，始终相信龙骑士们能击败任何魔物。"
                },
                {
                  "role": "恰斯卡",
                  "text": "可正是因为了解与信任，我很清楚我们的短板。每场战斗中，我们都不可避免会承受一定的伤亡。"
                },
                {
                  "role": "恰斯卡",
                  "text": "以前，我们以部族的形式团结在一起，战斗中各司其事，有着看起来还算不错的配合。"
                },
                {
                  "role": "恰斯卡",
                  "text": "但论及把「应对损失」、「高效训练」、「补充战力」等流程组合起来，使得战士们的队伍更有韧性…"
                },
                {
                  "role": "恰斯卡",
                  "text": "枫丹的朋友们显然有着丰富的经验，值得我们深入学习，让自己变得更强大。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "好像理解你的意思了…",
                      "dialogues": []
                    },
                    {
                      "text": "不是很明白，你继续…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "恰斯卡",
                  "text": "管理队伍，安排训练，进行精准的指挥…这几方面，夏沃蕾队长是枫丹数一数二的专家了吧？"
                },
                {
                  "role": "恰斯卡",
                  "text": "她的专业技能对于追求团队力量的战士而言…就像饿鬼眼中，炉火上冒着油的烤肉。"
                },
                {
                  "role": "旅行者",
                  "text": "她对枫丹确实很重要哦。"
                },
                {
                  "role": "旅行者",
                  "text": "完全称得上是灵魂人物之一。"
                },
                {
                  "role": "恰斯卡",
                  "text": "嗯…可惜，枫丹肯定不会放她走的。"
                },
                {
                  "role": "恰斯卡",
                  "text": "挖友军的墙角，也不是堂堂正正的部族勇士该干的事。"
                },
                {
                  "role": "恰斯卡",
                  "text": "就当我开了个不怎么恰当的玩笑吧。"
                }
              ]
            },
            {
              "text": "一切都好，待会儿再聊。",
              "dialogues": [
                {
                  "role": "恰斯卡",
                  "text": "看来还是老样子啊，忙得不可开交。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（夏沃蕾）"
        },
        {
          "role": "夏沃蕾",
          "text": "感觉怎么样，旅行者？找到充分利用每发弹药的灵感了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像有，但平时不太用得到？",
              "dialogues": [
                {
                  "role": "夏沃蕾",
                  "text": "多一项技能，就多一项选择，说不定，之后你偶尔会遇到特殊的环境，导致习惯的战斗技巧受到限制。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "到时候，使用铳枪这类远程投射武器战斗，不失为一种选择。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "好像也有道理。",
                      "dialogues": []
                    },
                    {
                      "text": "那我要多来请教你。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "夏沃蕾",
                  "text": "不，不必用「请教」这种字眼，应该说交流心得。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "蒂蕾娜向我描述过你以前射击的表现，我觉得，你也完全能成为全提瓦特最顶尖的射手，打出新的远射记录。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "当然，实战射击、城区战斗和靶场挑战，有着截然不同的特性。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "你多用几回铳枪，找到其中的奥秘，绝对不在话下。"
                }
              ]
            },
            {
              "text": "先说说和纳塔朋友相处得如何？",
              "dialogues": [
                {
                  "role": "夏沃蕾",
                  "text": "那我直言不讳了。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "我想招募恰斯卡小姐，目前预期的底薪是每年六千万摩拉。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "多少？",
                      "dialogues": []
                    },
                    {
                      "text": "是不是把百说成了千？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "夏沃蕾",
                  "text": "没口误，就是这个数字。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "以执律庭的经验来看，想要打造一种机关，拥有与恰斯卡小姐相当的机动性与火力…"
                },
                {
                  "role": "夏沃蕾",
                  "text": "可能需要上百亿摩拉的预算，分属多家机构的数千名工程师，以及十年以上的技术攻关、研发与测试过程，还未必能成功。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "恰斯卡小姐和她的灵枪，说是「飞在天上的摩拉保险箱」，都不为过。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "看她打击标靶时，我会自动把她开的每一枪，换算成普通铳枪和火炮的成本…"
                },
                {
                  "role": "夏沃蕾",
                  "text": "从效能来说，可以用，开这个年薪的话，我们实在太赚了。划算程度甚至要让黑心商人叹为观止。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "这好像也不是摩拉的问题了…",
                      "dialogues": []
                    },
                    {
                      "text": "她有在「花羽会」的职责哦。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "夏沃蕾",
                  "text": "我明白。她还是纳塔的「古名」持有者，纳塔整个国家的重要人物之一。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "所以我也只能和你表达一下意愿。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "我会思考其他的方法，尽可能向恰斯卡小姐借用力量，让特巡队的能力发展得更为全面。"
                }
              ]
            },
            {
              "text": "有没有什么工作外的话题？",
              "dialogues": [
                {
                  "role": "夏沃蕾",
                  "text": "问得好。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "我觉得，恰斯卡小姐十分适合出演犯罪题材的映影，而且绝对要在女主角的位置上…"
                },
                {
                  "role": "夏沃蕾",
                  "text": "嗯，带有悬疑色彩的超常冒险也挺不错。比如探查遗迹，发掘古老的力量，与神秘势力开展周旋…"
                },
                {
                  "role": "夏沃蕾",
                  "text": "下次再见到泽维尔导演的时候，我要和他简单说说这个想法。"
                }
              ]
            },
            {
              "text": "我再去找找。",
              "dialogues": [
                {
                  "role": "夏沃蕾",
                  "text": "嗯，切勿心急。仔细感受铳枪机件的运转，观察曳光弹道和命中的信号…灵光闪烁的那一瞬间迟早会找上你的。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（蒂蕾娜&昂吉安妮）"
        },
        {
          "role": "蒂蕾娜",
          "text": "真的不再打一场了吗，教官？"
        },
        {
          "role": "昂吉安妮",
          "text": "我已经打出最佳成绩了，你也看到了嘛，我有点打不动了，在花哨的新推演面前，只能勉强及格…"
        },
        {
          "role": "蒂蕾娜",
          "text": "但及格线是夏沃蕾队长的成绩的六成呀！除了你，大家全都不及格了呀，哪有什么打不动…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（继续听听…）",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "你现在不打的话，以后就再也看不到你拿铳枪的样子了。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "我都完全没感觉，时间过得这么快…"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "呜…呜呜…"
                },
                {
                  "role": "昂吉安妮",
                  "text": "哎？你这小妞，哭什么？"
                },
                {
                  "role": "昂吉安妮",
                  "text": "只是退役了而已，又不是再也不见面了！"
                },
                {
                  "role": "昂吉安妮",
                  "text": "想见我还不容易，找个店，每周请我吃顿饭。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "好好好，不止黄油汐藻，你想吃德波大饭店都行！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "但…不能每周…每个月一次吧？"
                },
                {
                  "role": "昂吉安妮",
                  "text": "无所谓啦，你安排什么，我都能接受。"
                },
                {
                  "role": "昂吉安妮",
                  "text": "不过，说正经的…以后我们这一拨的新人，全都交给你了。"
                },
                {
                  "role": "昂吉安妮",
                  "text": "要好好看住[[玛因]]和[[萝克珊]]，防止她们工作得太忘我。"
                },
                {
                  "role": "昂吉安妮",
                  "text": "也别让新人输给当年的你自己啊，但凡他们有一点怠惰，就狠狠踢他们的屁股！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "我会的！狠狠踢他们的屁股！"
                },
                {
                  "role": "昂吉安妮",
                  "text": "那好哦，我的妹妹们叫我去纳塔度假，可能之后有那么两个月不在枫丹…"
                },
                {
                  "role": "昂吉安妮",
                  "text": "度假一回来，我就要来检查你的成果！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "一定不会让你失望的，教官！"
                }
              ]
            },
            {
              "text": "（还是让她们单独聊吧…）",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（赫得蔚格）"
        },
        {
          "role": "赫得蔚格",
          "text": "其实真没想到，荣誉骑士也会来参加这次推演，阵仗还挺大的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "朋友，你还做什么别的工作？",
              "dialogues": [
                {
                  "role": "赫得蔚格",
                  "text": "…「负责背黑锅」…"
                },
                {
                  "role": "赫得蔚格",
                  "text": "开玩笑的！其实是各种经典的文员工作。无论什么事，都由我在骑士团、沫芒宫和纳塔勇士之间负责交涉。"
                },
                {
                  "role": "赫得蔚格",
                  "text": "这样可以避免中间太多人来回讨论的摩擦成本。"
                },
                {
                  "role": "赫得蔚格",
                  "text": "合作过程中的一些流程问题，也由我跑腿。还要管理交流队伍的整体出差费用…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那蛮辛苦的。",
                      "dialogues": []
                    },
                    {
                      "text": "那祝你顺利。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "赫得蔚格",
                  "text": "这不是见到你了吗？还有传奇射手，千步距离上打出一角分之内散布的夏沃蕾特巡队长…"
                },
                {
                  "role": "赫得蔚格",
                  "text": "以及不能用常理来评估的龙骑士恰斯卡，射击技术离谱得像是给双手装上了稳定机关。"
                },
                {
                  "role": "赫得蔚格",
                  "text": "工作再杂再累，我都赚大了，让我倒贴工资我都值呀！"
                },
                {
                  "role": "赫得蔚格",
                  "text": "而且，我发现铳枪还蛮适合我的。之前我受了伤，再也没希望用佩剑战斗了…"
                },
                {
                  "role": "赫得蔚格",
                  "text": "结果推演里，我拿着科赫的铳枪上去试了几场，成绩还不错，以后说不定能用这武器重返一线！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "人好像也不算多？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "赫得蔚格",
                  "text": "以早期技术交流会的标准来看，很厉害了！远程、支援和综务三支小队的人手混编呢！"
                },
                {
                  "role": "赫得蔚格",
                  "text": "要不是第五小队副队长以奇特的理由推脱，光这里的骑士团兵力，就能剿灭一大支魔物部队了吧。"
                },
                {
                  "role": "赫得蔚格",
                  "text": "更不用说那位枫丹队长，和纳塔龙骑士们的兵力了！"
                }
              ]
            },
            {
              "text": "你忙你的，我先走了。",
              "dialogues": [
                {
                  "role": "赫得蔚格",
                  "text": "你才是大忙人，和我这么客气，我受宠若惊！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（科赫）"
        },
        {
          "role": "科赫",
          "text": "荣誉骑士，枪匠科赫向你问好！祝你测距精准，打出理想的弹道。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是…",
              "dialogues": [
                {
                  "role": "科赫",
                  "text": "我是常态驻守荆夫港的支援小队成员，这次被派来负责维护演习中用到的装备。"
                },
                {
                  "role": "科赫",
                  "text": "批量装备铳枪前，除了远程小队，我和骑兵小队的弓弩射手合作得也挺多，所以算是[[霍肯]]和赫得蔚格的老朋友…"
                },
                {
                  "role": "科赫",
                  "text": "结果这次，刚有联合演习的消息，赫得蔚格就直接指名我来带枪匠的队。"
                },
                {
                  "role": "科赫",
                  "text": "正合我意，能让我好好见识枫丹新型铳枪的性能！"
                }
              ]
            },
            {
              "text": "关于「观测榴弹」的其他原理…",
              "dialogues": [
                {
                  "role": "科赫",
                  "text": "猜你想问：榴弹的变向机制。"
                },
                {
                  "role": "科赫",
                  "text": "哈哈，其实原理也不难，榴弹本体采用的无烟火药能量较低，速度并不夸张。"
                },
                {
                  "role": "科赫",
                  "text": "配合观测机关周围的黏着装置，就能实现命中后附着在目标上，然后点燃后部侧面的示踪剂，发出命中信号。"
                },
                {
                  "role": "科赫",
                  "text": "弹头里余下的空间，都用来装填变向用的火药了，远程控制它指向想要的目标后，就可以点燃这些发射药，飞向下一个目标。"
                },
                {
                  "role": "科赫",
                  "text": "因此，在推演中，「观测榴弹」就能进行次数有限的变向。"
                },
                {
                  "role": "科赫",
                  "text": "这完全符合推演的主题——「用有限的射击次数，打出最完美的弹道。」"
                }
              ]
            },
            {
              "text": "待会儿再来和你聊。",
              "dialogues": [
                {
                  "role": "科赫",
                  "text": "了解，我随时在此待命。"
                }
              ]
            }
          ]
        }
      ],
