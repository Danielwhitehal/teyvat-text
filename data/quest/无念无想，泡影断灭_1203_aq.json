{
  "quest_id": 1203,
  "chapter_num": "第二章 第二幕",
  "chapter_title": "无念无想，泡影断灭",
  "type": "aq",
  "route": "Stillness, the Sublimation of Shadow",
  "stories": [
    {
      "story_id": 2008,
      "title": "在审判的雷鸣声中",
      "description": "木漏茶室空无一人，太郎丸在不安地吠叫，一种不祥的预感涌上你的心头。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到第二天，再次前往木漏茶室"
        },
        {
          "role": "派蒙",
          "text": "在稻妻城的日子好像也还不错呢，不过…好像到了托马和绫华所说的「下一步行动」的时间了吧？"
        },
        {
          "role": "派蒙",
          "text": "还是到木漏茶室集合，准备好了就去见他们吧？"
        },
        {
          "type": "subtitle",
          "text": "前往木漏茶室"
        },
        {
          "role": "派蒙",
          "text": "奇怪，今天怎么这么安静，和平时完全不一样。"
        },
        {
          "role": "太郎丸",
          "text": "汪汪…汪！"
        },
        {
          "role": "派蒙",
          "text": "难道说，又是这种双簧演出吗？"
        },
        {
          "role": "派蒙",
          "text": "托马——托马——"
        },
        {
          "role": "太郎丸",
          "text": "汪！汪！…汪！"
        },
        {
          "role": "派蒙",
          "text": "喂——不要再躲了，我已经看见你啦——"
        },
        {
          "role": "派蒙",
          "text": "嗯？完全没有人回应，托马跑到哪里去了？"
        },
        {
          "role": "太郎丸",
          "text": "汪汪汪！汪！"
        },
        {
          "role": "派蒙",
          "text": "咦？平时一直那么老实的太郎丸，今天好像很急躁的样子…"
        },
        {
          "type": "subtitle",
          "text": "神里绫华行色匆匆地进入了茶室…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "神里绫华",
          "text": "两位，有看到托马吗？"
        },
        {
          "role": "派蒙",
          "text": "我们还以为他跟你在一起呢，发生什么事了吗？"
        },
        {
          "role": "神里绫华",
          "text": "糟糕…我在来这里的路上，听说托马被天领奉行的人抓走了。"
        },
        {
          "role": "神里绫华",
          "text": "我没办法判断消息是真是假，就立刻跑过来确认。如果托马没有按照约定出现在这里，意味着传闻大概率是真的。"
        },
        {
          "role": "神里绫华",
          "text": "雷电将军会在千手百眼神像前，举办第一百颗神之眼的「狩眼仪式」。"
        },
        {
          "role": "神里绫华",
          "text": "而那第一百颗神之眼的持有者…也就是即将被公开狩眼的对象，恐怕…就是托马。"
        },
        {
          "role": "派蒙",
          "text": "难道托马之前听说的，天领奉行正在筹备的「仪式」，刚好就是为他准备的「狩眼仪式」？"
        },
        {
          "role": "神里绫华",
          "text": "应该…是的，将军和天领奉行的人准备以第一百颗神之眼的「狩眼仪式」，来证明眼狩令的阶段性成果。"
        },
        {
          "role": "神里绫华",
          "text": "…不行，我必须去救他！"
        },
        {
          "role": "太郎丸",
          "text": "汪汪！汪！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "冷静。",
              "dialogues": []
            },
            {
              "text": "但「白鹭公主」也代表了社奉行。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是呀，如果你亲自过去的话，不就代表社奉行要和雷电将军为敌了吗？"
        },
        {
          "role": "派蒙",
          "text": "公然反抗雷电将军的话，社奉行那些普通人也会被牵连进来吧…"
        },
        {
          "role": "神里绫华",
          "text": "这也是没办法的事…时间已经不多了，仪式就要开始，我不能就这样放弃托马。"
        },
        {
          "role": "神里绫华",
          "text": "他是我的朋友，明明不久之前，我们大家还一起…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他也是我的朋友，我去救他。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫华",
          "text": "可是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你刚才说过吧？——时间不多了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫华",
          "text": "……"
        },
        {
          "role": "神里绫华",
          "text": "…嗯，我会…等你们平安回来。"
        },
        {
          "role": "派蒙",
          "text": "放心吧，绫华，事关朋友的性命，我们绝对不会失手的！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（太郎丸）"
        },
        {
          "role": "太郎丸",
          "text": "汪汪…汪！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（神里绫华）"
        },
        {
          "role": "神里绫华",
          "text": "请务必小心…"
        },
        {
          "type": "subtitle",
          "text": "前往「狩眼仪式」现场"
        },
        {
          "type": "subtitle",
          "text": "在民众的注视下，「狩眼仪式」即将开始。托马在行刑台上被反绑双手，等待雷电将军取走他的神之眼，镶嵌在千手百眼神像之上。然而当托马的神之眼离开它原本的主人，向将军手中飞去时，你无法忍受朋友在面前遭此不幸，愤然出手夺下了神之眼。目睹你的大胆行径，雷电将军似乎打算亲自动手。一刹那，光影崩乱，身边的所有人也失去了踪迹，你被隔绝在了一片孤寂而古老的空间。尘世七执政中的雷之神向你举起了刀…",
          "narration": true,
          "color": "gray"
        },
        {
          "type": "subtitle",
          "text": "过场动画"
        },
        {
          "role": "雷电将军",
          "text": "不需要神之眼就可以驱动元素力…"
        },
        {
          "role": "雷电将军",
          "text": "你…是个「例外」"
        },
        {
          "role": "雷电将军",
          "text": "例外…是永恒的敌人"
        },
        {
          "type": "subtitle",
          "text": "雷电将军从胸口拔出太刀…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "雷电将军",
          "text": "我会将你，砌进神像里"
        },
        {
          "type": "subtitle",
          "text": "雷电将军撕裂空间将你拖入一个隔绝的空间之内…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "击败雷电将军"
        },
        {
          "role": "雷电将军",
          "text": "你是离永恒相去最远之人，我很感兴趣。"
        },
        {
          "role": "雷电将军",
          "text": "是你的话，我可要亲自确认才稳妥。"
        },
        {
          "type": "subtitle",
          "text": "元素战技和元素爆发被封锁后，画面中央会显示：裁决之时将至，「神罚」即将降下…",
          "narration": true
        },
        {
          "role": "雷电将军",
          "text": "能够直面雷电的威光，这一点，值得赞赏。"
        },
        {
          "type": "subtitle",
          "text": "过场动画"
        },
        {
          "type": "subtitle",
          "text": "你向雷电将军刺出一剑，却被雷电将军轻松反杀…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "你回到了千手百眼神像前，瘫倒在了地上…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "醒醒，快醒醒！"
        },
        {
          "type": "subtitle",
          "text": "雷电将军正欲向你砍出最后一刀，所幸被即使脱困的托马救下…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "托马带你逃离了这里…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "幕府军士",
          "text": "将、将军，刚才那个人…"
        },
        {
          "role": "雷电将军",
          "text": "将他纳入「眼狩令」"
        },
        {
          "role": "雷电将军",
          "text": "下次见面，我会再斩一刀"
        },
        {
          "type": "subtitle",
          "text": "雷之神的威势难以抵挡，一招不慎你便被击晕。雷电将军准备在众人面前将你处决，以示惩戒。危急时刻，托马挣脱束缚，提起身旁长枪掷向将军，趁其分神抵挡时将你带走。雷电将军冷淡地看着你们仓皇逃离的背影，不欲再追，而是下达了通缉命令…",
          "narration": true,
          "color": "gray"
        }
      ],
      "collapse_ranges": [
        [
          35,
          36
        ],
        [
          37,
          38
        ],
        [
          41,
          47
        ],
        [
          53,
          61
        ]
      ]
    },
    {
      "story_id": 2009,
      "title": "以反抗之人的名义",
      "description": "与雷电将军的初次见面，发生了超乎预想的冲突。被稻妻通缉的你，现在唯有投靠珊瑚宫的反抗军才能扭转局面。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "逃离鸣神岛，前往踏鞴砂寻找反抗军"
        },
        {
          "type": "subtitle",
          "text": "你们一路狼狈逃跑，中途在木漏茶室附近停下了脚步。",
          "narration": true,
          "color": "gray"
        },
        {
          "role": "派蒙",
          "text": "怎么在这里停下来了？"
        },
        {
          "role": "托马",
          "text": "你不记得了吗，对于我来说，躲在木漏茶室是这附近最安全的地方了。"
        },
        {
          "role": "托马",
          "text": "只不过短时间里我应该没办法从这里出去。之后的事情，只能交给你们了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们该怎么办？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "托马",
          "text": "去踏鞴砂，找反抗军。"
        },
        {
          "role": "托马",
          "text": "不出意外的话，幕府军很快就会通缉我们。愿意收留我们的势力不多，但反抗军是个例外。"
        },
        {
          "role": "派蒙",
          "text": "我还记得，绫华说过…是那个…珊瑚宫组织的！反抗眼狩令的组织！"
        },
        {
          "role": "托马",
          "text": "没错，最初是海祇岛的「现人神巫女」珊瑚宫心海组织，目前由其部下五郎率领，正在跟幕府军交战。"
        },
        {
          "role": "托马",
          "text": "不过，我们社奉行跟反抗军来往并不密切，主要是双方都无法相信彼此。"
        },
        {
          "role": "托马",
          "text": "但你们不同…在我看来，反抗军应该没有拒绝你们的理由。"
        },
        {
          "role": "托马",
          "text": "唯一的危险，是我们暂时不清楚反抗军的具体位置，需要你们在路上打听一下。"
        },
        {
          "role": "托马",
          "text": "期间可能会穿过幕府军的领地，请务必多加小心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你也是。",
              "dialogues": [
                {
                  "role": "托马",
                  "text": "放心吧，我对于躲藏还是有一手的，不会被他们轻易找到。"
                }
              ]
            },
            {
              "text": "我出发了。",
              "dialogues": [
                {
                  "role": "托马",
                  "text": "嗯，我也准备藏到茶室里了。下次见面不知道是什么时候，祝你们一路顺风。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "继续拖下去的话，天领奉行的人可能就要找过来了。"
        },
        {
          "role": "派蒙",
          "text": "我们也快点出发吧！"
        },
        {
          "type": "subtitle",
          "text": "在踏鞴砂打探情报"
        },
        {
          "type": "subtitle",
          "text": "你们走到九条阵屋前，听见了两名巡逻的士兵正在交流…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "高山",
          "text": "哈欠…听说了吗，通缉名单上好像多了两个人，上头还说要重点关照一下。"
        },
        {
          "role": "石原",
          "text": "现在我们的主力都在前线作战，哪有办法「重点关照」？等下巡逻的时候，咱俩盯着点就是了。"
        },
        {
          "role": "高山",
          "text": "也不知道前线的战况怎么样了。"
        },
        {
          "role": "高山",
          "text": "上次听到消息，说反抗军已经被我们逼到「无想刃狭间」的西北边了，不知真假。"
        },
        {
          "role": "石原",
          "text": "假的吧，「无想刃狭间」都靠近反抗军大后方了。我们虽然目前占据上风，但他们应该也没有那么不堪。"
        },
        {
          "role": "石原",
          "text": "不管了，我们只是负责巡逻的，做好本职工作就好。"
        },
        {
          "role": "高山",
          "text": "说的也是…唉，干活吧。"
        },
        {
          "role": "派蒙",
          "text": "「无想刃狭间」的西北边…原来反抗军的后方在那里呀。不过为了保险起见，我们还是再多打听一下吧。"
        },
        {
          "type": "subtitle",
          "text": "继续向前探查"
        },
        {
          "type": "subtitle",
          "text": "你们继续向前，在海岸边遇到了两名逃难出来的人…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "坂本",
          "text": "这么巧，你也是逃出来的？"
        },
        {
          "role": "治一郎",
          "text": "是啊。你打算去哪？"
        },
        {
          "role": "坂本",
          "text": "想先去「绯木村」看看，虽说有些不好的传闻，但总比在战场上过日子好。"
        },
        {
          "role": "坂本",
          "text": "你呢？"
        },
        {
          "role": "治一郎",
          "text": "别提了，我原本在「名椎滩」短暂歇息，那里已经乱成一团了。"
        },
        {
          "role": "治一郎",
          "text": "反抗军这段时间作战不顺，主要还是正面战场的力量太薄弱了，很难跟幕府军抗衡。"
        },
        {
          "role": "治一郎",
          "text": "原本战线还要再靠前一点，不过反抗军连续后退两次，就到了「名椎滩」了。"
        },
        {
          "role": "治一郎",
          "text": "我刚从那边逃出来，太危险了…乱军之中谁也不认识谁，见面就亮兵器，吓得我行李都扔了，一路逃到了这里。"
        },
        {
          "role": "治一郎",
          "text": "我觉得我们还得继续跑，现在局势瞬息万变，跑得越远越好。"
        },
        {
          "role": "坂本",
          "text": "我也这么觉得，等会儿不妨一起走，还能相互照应一下…"
        },
        {
          "role": "派蒙",
          "text": "「名椎滩」…听他们的意思，反抗军和幕府军似乎正在那里交战，我们过去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "赶往战场前线"
        },
        {
          "type": "subtitle",
          "text": "你发现一名反抗军的人正被两名幕府武士威胁…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "快看！那是不是反抗军的人？"
        },
        {
          "role": "派蒙",
          "text": "他好像遇到了一些麻烦…我们先过去帮他解围吧！"
        },
        {
          "type": "subtitle",
          "text": "解救遭到围困的反抗军"
        },
        {
          "type": "subtitle",
          "text": "与反抗军成员对话"
        },
        {
          "role": "哲平",
          "text": "呼——得救了，我还以为自己要死掉了呢。"
        },
        {
          "role": "哲平",
          "text": "多谢你们出手相助，我是反抗军虾虎小队成员，哲平。"
        },
        {
          "role": "哲平",
          "text": "最近刚被调到前线，本来以为能立些功劳，没想到出师不利，让你们看笑话了。"
        },
        {
          "role": "哲平",
          "text": "对了，看你们的打扮，不像是反抗军…你们是来加入反抗军的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哲平",
          "text": "太好了！前几天还听到五郎大人抱怨，说这段时间人手不足，这下帮大忙了。"
        },
        {
          "role": "哲平",
          "text": "我来带你们去反抗军的军营…不过在那之前，我先给你们讲讲反抗军的现状吧。"
        },
        {
          "role": "哲平",
          "text": "就像你们看到的一样。我们反抗军，在正面战场一直处于劣势。"
        },
        {
          "role": "哲平",
          "text": "幕府军以维系「永恒」为目标，又有天领奉行的大将九条裟罗带队，实力非常强劲。"
        },
        {
          "role": "哲平",
          "text": "而我们这边…因为「眼狩令」的关系，连持有神之眼的人都少之又少。"
        },
        {
          "role": "哲平",
          "text": "目前还能顶住压力，一方面是靠珊瑚宫大人的各种奇谋妙计，另一方面是靠五郎大人与反抗军战士们的英勇奋战。"
        },
        {
          "role": "哲平",
          "text": "唉，如果我也有神之眼就好了。有了神之眼，既可以帮珊瑚宫大人和五郎大人分忧，又能够在战场上建功立业…"
        },
        {
          "role": "哲平",
          "text": "对了，我刚刚好像看到了你使用了元素力，你也拥有神之眼吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "他是特别的，不需要神之眼也可以使用元素力。"
        },
        {
          "role": "哲平",
          "text": "真的假的？这也太棒了吧…这不就意味着，「眼狩令」对你完全无效吗？"
        },
        {
          "role": "哲平",
          "text": "请务必允许我将你引荐给五郎大人！五郎大人肯定也会很欢迎你的！"
        },
        {
          "role": "哲平",
          "text": "这样我也算是做了一件大事…虽然我还是希望像你一样，能够轻轻松松撂倒几个幕府武士，用手里的剑建立真正的功勋。"
        },
        {
          "role": "哲平",
          "text": "事不宜迟，我们马上出发吧！"
        },
        {
          "type": "subtitle",
          "text": "前往面见反抗军将领五郎"
        },
        {
          "type": "subtitle",
          "text": "哲平带你们面见了反抗军大将五郎，陈述了事情经过。",
          "narration": true,
          "color": "gray"
        },
        {
          "role": "哲平",
          "text": "事情就是这样，五郎大人。"
        },
        {
          "role": "哲平",
          "text": "在我被幕府武士围攻的时候，是他们救了我。"
        },
        {
          "role": "哲平",
          "text": "而且他们不需要神之眼也能使用元素力，好强！让他们加入反抗军吧！"
        },
        {
          "role": "五郎",
          "text": "嗯…咳。"
        },
        {
          "role": "五郎",
          "text": "你应该已经听说了，反抗军当前的目标是击败幕府军、推翻眼狩令。"
        },
        {
          "role": "五郎",
          "text": "这并非是什么轻松的工作，每个踏入战场的人，都有牺牲的可能。"
        },
        {
          "role": "五郎",
          "text": "说说你参军的理由吧，反抗军不能容许没有战斗意志的人参军，我个人也希望你能考虑清楚。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于第一百颗神之眼…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "五郎",
          "text": "你是说第一百颗神之眼的「狩眼仪式」吗？虽然发生在稻妻城，但我们这边也有所耳闻。"
        },
        {
          "role": "五郎",
          "text": "据说仪式出了些乱子…真是奇怪，明明那位雷电将军都亲自出马…"
        },
        {
          "role": "五郎",
          "text": "为什么突然提起这件事，难道是有什么情报吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是我干的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "五郎",
          "text": "…啊？"
        },
        {
          "role": "派蒙",
          "text": "而且我们还和雷电将军打了一架，把第一百颗神之眼的持有者带走了呢。"
        },
        {
          "role": "派蒙",
          "text": "现在我们还在被幕府军通缉…所以才找到了这里。"
        },
        {
          "role": "五郎",
          "text": "说起来，近期作战的时候好像确实从幕府武士身上拿到了悬赏令。"
        },
        {
          "role": "五郎",
          "text": "「金发旅行者和会飞的神秘宠物」…原来说的就是你们吗？"
        },
        {
          "role": "派蒙",
          "text": "谁是「会飞的神秘宠物」啊！！"
        },
        {
          "role": "五郎",
          "text": "失敬失敬，两位的现状我了解了。我代表反抗军，正式欢迎两位的加入。"
        },
        {
          "role": "五郎",
          "text": "珊瑚宫大人目前并不在反抗军营地，我们也不知道她去了哪里。不过珊瑚宫大人临行前留下过嘱托，让我们一切照常即可。"
        },
        {
          "role": "五郎",
          "text": "我想先让哲平带你熟悉一下反抗军的环境，之后再拜托你支援前线作战，可以吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "为了反抗军！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哲平",
          "text": "我这边也没问题。"
        },
        {
          "role": "哲平",
          "text": "我以前就是后勤部队的，这种事对我来说已经轻车熟路了。"
        },
        {
          "role": "哲平",
          "text": "一定会让你感受到我们反抗军的热情的！"
        },
        {
          "role": "哲平",
          "text": "首先我们去看一下伤兵营吧，我有些朋友还躺在那里。"
        },
        {
          "role": "哲平",
          "text": "上次我答应过他们，如果有新成员的话，让他们也见一见。这样大家以后就是并肩作战的好朋友了！"
        },
        {
          "type": "subtitle",
          "text": "跟随哲平，帮助受伤的反抗军"
        },
        {
          "role": "德田",
          "text": "咳咳…这位就是我们的新队友吗？"
        },
        {
          "role": "将司",
          "text": "看上去很强的样子啊，等我伤好了，我们可以切磋切磋。"
        },
        {
          "role": "德田",
          "text": "停停，哪有一上来就要和新人干架的，再说你那伤没个十天半个月根本好不了。"
        },
        {
          "role": "德田",
          "text": "哲平，这位是你带回来的？你在前线还好吗？"
        },
        {
          "role": "哲平",
          "text": "哼哼…虽然幕府军确实比我们想象的要强很多，但我依然发挥了巨大的作用。"
        },
        {
          "role": "哲平",
          "text": "当时幕府军如潮水般涌来，但我丝毫不惧，拔剑上前，硬是以一己之力拖住了三四个幕府武士。"
        },
        {
          "role": "将司",
          "text": "可以啊你小子，什么时候变得这么厉害了？"
        },
        {
          "role": "哲平",
          "text": "这位更是了不得。眼见我就要力竭败退，他直接打倒在地。"
        },
        {
          "role": "哲平",
          "text": "听说他还搅乱了第一百颗神之眼的「狩眼仪式」，就连雷电将军都拿他没什么办法呢。"
        },
        {
          "role": "德田",
          "text": "太厉害了你们。"
        },
        {
          "role": "德田",
          "text": "不过…别的我还相信，他能正面对抗雷电将军，是不是有点夸张了？你怕不是没听过「无想的一刀」吧，哈哈。"
        },
        {
          "role": "德田",
          "text": "但不管怎样，原先我还在想最近输多赢少，是不是快撑不下去了。"
        },
        {
          "role": "德田",
          "text": "现在来看不管是新人还是哲平都比预想中可靠，我也得快点恢复好，重新回前线战斗才行。"
        },
        {
          "role": "将司",
          "text": "你这觉悟明显就不行，我现在都是带伤训练，虽然昨天伤口又崩了…"
        },
        {
          "role": "哲平",
          "text": "需要我找点伤药来吗？"
        },
        {
          "role": "哲平",
          "text": "前段时间我听说了一个偏方，只需要用「鬼兜虫」磨成粉，就可以制作出特效伤药。"
        },
        {
          "role": "哲平",
          "text": "据说敷上之后清清凉凉的，可以加速伤口痊愈。"
        },
        {
          "role": "将司",
          "text": "给我一份谢谢！"
        },
        {
          "role": "德田",
          "text": "我怎么听上去怪怪的…其实「钩钩果」就可以了吧，不过交给你们来判断好了。"
        },
        {
          "role": "哲平",
          "text": "那就交给新人来决定吧。我在这里准备一下…"
        },
        {
          "role": "哲平",
          "text": "如果你支持我的神奇偏方，就麻烦你帮忙带一些「鬼兜虫」回来，我来负责把它们捣碎、熬制成药剂。"
        },
        {
          "role": "哲平",
          "text": "如果你觉得「钩钩果」比较好，就麻烦你带一份回来了。我其实很推荐这个偏方的，说不定会有奇效呢！"
        },
        {
          "type": "subtitle",
          "text": "交付适合作为伤药的材料"
        },
        {
          "role": "哲平",
          "text": "辛苦了！你决定好要用哪一种药了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交付「鬼兜虫」",
              "dialogues": [
                {
                  "role": "哲平",
                  "text": "好欸！我就知道你会相信我的！"
                },
                {
                  "role": "哲平",
                  "text": "虽然我也不敢保证一定有效，但如果有效的话，大家就能快点恢复起来了。"
                },
                {
                  "role": "哲平",
                  "text": "把材料给我吧，制药的事情比较麻烦，我来就好。"
                },
                {
                  "role": "德田",
                  "text": "好疼好疼好疼——"
                },
                {
                  "role": "德田",
                  "text": "欸？突然又不疼了，麻酥酥的…"
                },
                {
                  "role": "将司",
                  "text": "看来确实有效果。可以啊哲平，等我康复了，一定跟你再好好切磋切磋。"
                },
                {
                  "role": "德田",
                  "text": "你怎么老想着跟别人切磋…不过这次确实多亏了哲平。"
                },
                {
                  "role": "德田",
                  "text": "虽然这药刚敷上去的时候，就像在伤口上撒盐一样，但现在有一种很清凉的感觉。我能感觉到，身体正在慢慢康复…虽然肯定不可能立刻好起来啦。"
                },
                {
                  "role": "德田",
                  "text": "我能感觉到，身体正在慢慢康复…虽然肯定不可能立刻好起来啦。"
                },
                {
                  "role": "德田",
                  "text": "谢谢你和这位新人的帮助了，等我从伤兵营出去，请你们喝酒。"
                },
                {
                  "role": "哲平",
                  "text": "嘿嘿…能帮上忙就好，那我先带新人去别处转转了，你们安心养伤。"
                },
                {
                  "role": "将司",
                  "text": "记得去训练营，跟他们切磋切磋！"
                },
                {
                  "role": "德田",
                  "text": "你赶紧休息吧…"
                },
                {
                  "role": "哲平",
                  "text": "训练营啊…确实，听说那边正在进行射术训练，我们也可以过去看看。"
                }
              ]
            },
            {
              "text": "交付「钩钩果」",
              "dialogues": [
                {
                  "role": "哲平",
                  "text": "这样啊…"
                },
                {
                  "role": "哲平",
                  "text": "没事啦，确实这样比较保险。"
                },
                {
                  "role": "哲平",
                  "text": "等下我们一起去换药吧。有了这些药，大家应该也能快一点好起来。"
                },
                {
                  "role": "哲平",
                  "text": "不管怎么样，谢谢你啦。"
                },
                {
                  "role": "德田",
                  "text": "嘶…别说，这药抹上去还真有点疼。"
                },
                {
                  "role": "德田",
                  "text": "虽然这种药比较常见，但药效却很不错。最主要的是，多谢你们帮忙换药了。"
                },
                {
                  "role": "将司",
                  "text": "嗯…还不够，感觉还可以再涂一点！"
                },
                {
                  "role": "将司",
                  "text": "我已经迫不及待地想要从这里出去，跟你们一起并肩作战了！"
                },
                {
                  "role": "德田",
                  "text": "但其实多涂一些也不会让你好得更快…你还是先把半夜偷偷训练的习惯改掉吧。"
                },
                {
                  "role": "德田",
                  "text": "多谢你们了，哲平，还有这位新人。"
                },
                {
                  "role": "德田",
                  "text": "对了，我听说训练营那边正在举办射术训练，你要不要带新人去看看？"
                },
                {
                  "role": "德田",
                  "text": "在那里可以认识更多反抗军士兵，也有助于新人更快地融入这里。"
                },
                {
                  "role": "哲平",
                  "text": "没问题，包在我身上！现在就出发吧！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（德田&将司）"
        },
        {
          "role": "德田",
          "text": "不知道什么时候才能回到前线…"
        },
        {
          "role": "将司",
          "text": "眼狩令不得人心，反抗军一定会赢的！"
        },
        {
          "type": "subtitle",
          "text": "跟随哲平，帮助训练中的反抗军"
        },
        {
          "role": "正二",
          "text": "唉，又没射中，难受。"
        },
        {
          "role": "正二",
          "text": "我刚刚数了一下，我射了整整十支箭，只有一根…"
        },
        {
          "role": "久彦",
          "text": "只有一根射中靶心？"
        },
        {
          "role": "正二",
          "text": "只有一根射中靶子。"
        },
        {
          "role": "久彦",
          "text": "这也太惨了…不过从这几天的情况来看，想要提升射箭的「技巧」，单纯的重复训练是不够的。"
        },
        {
          "role": "久彦",
          "text": "本来以为拉弓、瞄准、射箭，一气呵成，不会有什么难度。没想到是我想简单了…"
        },
        {
          "role": "久彦",
          "text": "按这个进度，不知道我们什么时候才能上战场。只能等下次教官来的时候，再向他请教一下了。"
        },
        {
          "role": "正二",
          "text": "可是最近战线吃紧，有实力的教官基本都去支援了。"
        },
        {
          "role": "正二",
          "text": "我们暂时也只能自己训练…唉，这样下去，我们真的能成为合格的反抗军士兵吗？"
        },
        {
          "role": "哲平",
          "text": "你们的烦恼，我听到了。"
        },
        {
          "role": "正二",
          "text": "哲平前辈？"
        },
        {
          "role": "哲平",
          "text": "没错！这次到来，也是为了向你们介绍一位新人。"
        },
        {
          "role": "哲平",
          "text": "他在正面战场以一己之力干掉了三四个幕府武士，不费吹灰之力。"
        },
        {
          "role": "哲平",
          "text": "而且勇敢地阻止了「狩眼仪式」，还从雷电将军手里活了下来！"
        },
        {
          "role": "正二",
          "text": "真的吗？那…您能教我们射箭吗？"
        },
        {
          "role": "正二",
          "text": "我们不会耽误您太多时间，只求您能再帮我们示范一次。因为之前的训练都比较匆忙，我们很难记住完整的射术要诀…"
        },
        {
          "role": "久彦",
          "text": "拜托了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "看好了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "正二",
          "text": "没问题，我们一定会认真学习的。"
        },
        {
          "type": "subtitle",
          "text": "失败时的对话"
        },
        {
          "role": "哲平",
          "text": "是不是有点紧张了？"
        },
        {
          "role": "哲平",
          "text": "这样可是没办法给他们做示范的，调整一下，再试一次吧。"
        },
        {
          "role": "哲平",
          "text": "加油！我相信你！"
        },
        {
          "type": "subtitle",
          "text": "再次尝试射箭演示"
        },
        {
          "role": "哲平",
          "text": "准备好了吗？"
        },
        {
          "role": "哲平",
          "text": "嗯嗯，这次一定没问题。利落地解决吧！"
        },
        {
          "type": "subtitle",
          "text": "为反抗军示范射箭技巧"
        },
        {
          "role": "哲平",
          "text": "怎么样，我就说这位新人很厉害吧？"
        },
        {
          "role": "正二",
          "text": "确实，现在我明白为什么自己射不中了。"
        },
        {
          "role": "正二",
          "text": "我姿势不够标准、力气不够大、握弓的手不够稳、没有考虑外界环境的影响…好在除了这些之外，我也没什么太大问题。"
        },
        {
          "role": "久彦",
          "text": "这问题已经挺多的了吧…"
        },
        {
          "role": "久彦",
          "text": "不过又看了一遍演示，我感觉自己受益良多。"
        },
        {
          "role": "久彦",
          "text": "至少这一次，我记住了「正确的方向」，只要朝这个方向继续努力下去，我就可以变得更强。"
        },
        {
          "role": "久彦",
          "text": "不瞒你说，战争之前，我其实也只是海祇岛上的一个普通人。"
        },
        {
          "role": "久彦",
          "text": "那时我与妻子活得很安逸，很少接触到战斗的事情。但「眼狩令」颁布之后，一切都变了…"
        },
        {
          "role": "久彦",
          "text": "我不能接受幕府军的所作所为，因此加入了反抗军。但现在看来，要走的路还有很长。"
        },
        {
          "role": "久彦",
          "text": "没有神之眼，也没有战斗天赋的我们，真的可以像他们一样活跃在战场上吗…"
        },
        {
          "role": "久彦",
          "text": "先不管了，多谢你和哲平前辈的帮忙，我们也要继续练习了。"
        },
        {
          "role": "哲平",
          "text": "不用想太多，前线有我们在，你们安心训练就好。"
        },
        {
          "role": "哲平",
          "text": "那，我带你去别的地方逛逛吧。"
        },
        {
          "role": "哲平",
          "text": "接下来去哪好呢…让我想想…"
        },
        {
          "role": "传令兵",
          "text": "不好了！幕府军过来偷袭了！！"
        },
        {
          "role": "传令兵",
          "text": "军营中还有很多伤兵，不能让幕府军进来。你们也过来帮忙，一起把幕府军赶出去！"
        },
        {
          "role": "哲平",
          "text": "怎么可能？按理来说他们打不到这里才对啊…"
        },
        {
          "role": "哲平",
          "text": "我们也过去看看吧，感觉这也是我立功的好机会！"
        },
        {
          "type": "subtitle",
          "text": "击败前来偷袭的幕府军小队"
        },
        {
          "role": "哲平",
          "text": "总算解决了…不过这里为什么会有幕府军的人？"
        },
        {
          "role": "哲平",
          "text": "按理来说，营地周围有许多负责巡逻的反抗军士兵，幕府军应该打不到这里才对。"
        },
        {
          "role": "哲平",
          "text": "难道说，有内鬼？"
        },
        {
          "role": "哲平",
          "text": "有人勾结幕府军，出卖我方情报，故意放任他们进攻营地…这样一来就解释得通了。"
        },
        {
          "role": "哲平",
          "text": "抓住内鬼，保护营地，这可是我建功立业的好时机啊！"
        },
        {
          "role": "传令兵",
          "text": "想什么呢。"
        },
        {
          "role": "传令兵",
          "text": "刚刚我仔细勘察了营地附近，发现营地附近的围墙出现了坍塌。"
        },
        {
          "role": "传令兵",
          "text": "幕府军应该是利用了这一点，从附近的悬崖上摸了过来，从围墙的空缺攻入了营地。"
        },
        {
          "role": "传令兵",
          "text": "只要把围墙重新修好，再增派人手在附近看守，应该就能杜绝这类隐患。"
        },
        {
          "role": "哲平",
          "text": "这样啊…好吧。正好附近就有木材和绳索，不如就交给我们来修吧。"
        },
        {
          "role": "哲平",
          "text": "我们来比赛吧，新人！不要小看我哦，我对于后勤工作可是很有信心的。这次就让你见识一下前辈的可靠之处！"
        },
        {
          "type": "subtitle",
          "text": "收集附近的维修材料"
        },
        {
          "type": "subtitle",
          "text": "维修营地围墙"
        },
        {
          "role": "哲平",
          "text": "好嘞，这样应该就没什么问题了。幕府军那帮家伙，插上翅膀也别想飞进来。"
        },
        {
          "role": "哲平",
          "text": "这样看来我又为反抗军做了一些贡献…不过怎么又是后勤相关的啊！"
        },
        {
          "role": "哲平",
          "text": "好不容易调到前线，本来想堂堂正正干出一番事业，这不是又回到之前的生活了吗？"
        },
        {
          "role": "派蒙",
          "text": "总觉得你好像对「前线」很执着…"
        },
        {
          "role": "哲平",
          "text": "就像五郎大人说的一样，我们都是因为有战斗意志才加入反抗军的。"
        },
        {
          "role": "哲平",
          "text": "虽然可以通过很多方式做出贡献，但如果可以的话，谁不想亲手撂倒几个幕府武士呢？"
        },
        {
          "role": "哲平",
          "text": "对了，我们已经基本逛完了军营，接下来去见五郎大人吧。"
        },
        {
          "role": "哲平",
          "text": "顺利的话，说不定还能领到几个上前线作战的任务。"
        },
        {
          "type": "subtitle",
          "text": "回去向五郎报告情况"
        },
        {
          "role": "哲平",
          "text": "奇怪…五郎大人不在吗？"
        },
        {
          "role": "甲斐田龙马",
          "text": "情况发生了一些变化，五郎大人正在前线率兵作战。"
        },
        {
          "role": "甲斐田龙马",
          "text": "不久之前，幕府军突然增援了正面战场，而且是由九条裟罗亲自带队。"
        },
        {
          "role": "甲斐田龙马",
          "text": "而我们这边…珊瑚宫大人已经很多天没有露面，她留下来的「锦囊」也基本用尽了。"
        },
        {
          "role": "甲斐田龙马",
          "text": "局势对我们非常不利，继续撤退的话，将对我方士气造成毁灭性打击。"
        },
        {
          "role": "甲斐田龙马",
          "text": "目前只能祈祷五郎大人能够挽回局势，不过可以预见，这一仗恐怕会很艰难。"
        },
        {
          "role": "哲平",
          "text": "我们也去前线吧。"
        },
        {
          "role": "哲平",
          "text": "既然有能力战斗，就不能留在这里坐视不管。"
        },
        {
          "role": "哲平",
          "text": "不能让幕府军通过踏鞴砂！"
        },
        {
          "type": "subtitle",
          "text": "前往前线战场"
        },
        {
          "type": "subtitle",
          "text": "你们火速赶往前线，正赶上幕府军大将九条裟罗正与五郎在阵前相互放话。",
          "narration": true,
          "color": "gray"
        },
        {
          "role": "九条裟罗",
          "text": "只有你在吗…我还以为这次能够见见你们那位「军师大人」。"
        },
        {
          "role": "九条裟罗",
          "text": "毕竟她确实给我们幕府军造成了很大麻烦，反抗军能够支撑到现在，也有她的功劳。"
        },
        {
          "role": "九条裟罗",
          "text": "但是也该结束了。兵力相差悬殊的情况下，计谋已经没有任何意义。"
        },
        {
          "role": "九条裟罗",
          "text": "我们已经摸清楚了反抗军的家底，忤逆将军大人的人都将受到惩罚。"
        },
        {
          "role": "五郎",
          "text": "我相信珊瑚宫大人，也相信我们反抗军的将士。"
        },
        {
          "role": "五郎",
          "text": "「眼狩令」绝非正确的道路，我们不会放弃抵抗。"
        },
        {
          "role": "九条裟罗",
          "text": "…无妨。还有一件事，你们应该已经拿到最新的通缉令了吧，那个金发的旅行者，现在应该在你们那里。"
        },
        {
          "role": "九条裟罗",
          "text": "如果你们愿意把他交出来，我可以给你们一些喘息的时间。毕竟在这个时间点寻求决战，对你我双方都没有好处。"
        },
        {
          "role": "五郎",
          "text": "难道说你们突然增兵，就是为了…"
        },
        {
          "role": "九条裟罗",
          "text": "他对将军大人很重要。"
        },
        {
          "role": "九条裟罗",
          "text": "但我想，他对于反抗军来说，应该可有可无。"
        },
        {
          "role": "五郎",
          "text": "…你错了，他对反抗军同样很重要。他已经加入了反抗军，现在是我的部下，我不会把他交出来的。"
        },
        {
          "role": "五郎",
          "text": "「反抗军不会出卖任何一名同伴」，这是珊瑚宫大人很早之前就定下来的规矩。"
        },
        {
          "role": "哲平",
          "text": "五郎大人！"
        },
        {
          "role": "五郎",
          "text": "哲平…还有你？你们怎么来了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来帮忙！",
              "dialogues": []
            },
            {
              "text": "我也是反抗军的一员。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "五郎",
          "text": "好，那这次我们并肩作战…"
        },
        {
          "role": "九条裟罗",
          "text": "又见面了…这次，我不会再放你们离开。"
        },
        {
          "role": "九条裟罗",
          "text": "我原以为，你投靠反抗军，会躲在他们身后寻求庇护。"
        },
        {
          "role": "九条裟罗",
          "text": "你能出现在这里，说明你比我想象的要勇敢。既然这样，我倒是有一个提议…"
        },
        {
          "role": "九条裟罗",
          "text": "这次的「阵前比武」，就由你代表反抗军出阵如何？"
        },
        {
          "role": "派蒙",
          "text": "「阵前比武」…那是什么？"
        },
        {
          "role": "五郎",
          "text": "战争开始之前，由双方各派出一名精锐将士进行对决。"
        },
        {
          "role": "五郎",
          "text": "对于优势方来说，进行比试的意义不大。但对于劣势方来说，这是提振士气的好机会。"
        },
        {
          "role": "五郎",
          "text": "不过，她的目的也很明显，是想借机将你抓过去…不要勉强，直接开战也没关系。"
        },
        {
          "role": "派蒙",
          "text": "要去战斗吗？旅行者，你来决定吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没事。",
              "dialogues": []
            },
            {
              "text": "我不会输。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "击败幕府军"
        },
        {
          "type": "subtitle",
          "text": "与「枪之鬼藤田」藤田三四郎比武",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "九条裟罗",
          "text": "处理掉所有威胁「永恒」的因素，这是将军大人的命令。"
        },
        {
          "role": "五郎",
          "text": "小心点，对面这家伙也很强。"
        },
        {
          "type": "subtitle",
          "text": "与「破竹之蛮虎」加山忠雄比武",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哲平",
          "text": "加油啊！"
        },
        {
          "role": "派蒙",
          "text": "居然是车轮战…旅行者，再坚持一下！"
        },
        {
          "type": "subtitle",
          "text": "与「九条之怀刃」高坂和泉比武",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "反抗军士兵",
          "text": "快看，我们这边连赢两场了！"
        },
        {
          "role": "反抗军士兵",
          "text": "幕府军并非不可战胜，我们也一定能赢！"
        },
        {
          "role": "五郎",
          "text": "士气正在渐渐高涨…你身上的「战斗意志」，也在影响着他们…"
        },
        {
          "type": "subtitle",
          "text": "与珊瑚宫心海对话"
        },
        {
          "role": "九条裟罗",
          "text": "果然有一套…看来这样比试下去也没有什么意义了。"
        },
        {
          "role": "九条裟罗",
          "text": "将士们，进攻！"
        },
        {
          "role": "九条裟罗",
          "text": "常道恢弘，鸣神永恒——"
        },
        {
          "role": "五郎",
          "text": "看来没办法避免战争了…迎战！"
        },
        {
          "role": "五郎",
          "text": "所有人，跟紧我！"
        },
        {
          "type": "subtitle",
          "text": "战场上拼杀声震天，反抗军暂居下风，五郎不由得担忧又急躁。然而此时，正如甘霖从天而降一般，反抗军的核心人物——珊瑚宫心海及时现身。埋伏已久的援军以她的指示为信号齐齐冲出，涌向战场，北斗与枫原万叶竟然也作为雇佣兵参与其中。眼见战机已失，九条裟罗也不得不下令撤退。",
          "narration": true,
          "color": "gray"
        },
        {
          "type": "subtitle",
          "text": "过场动画"
        },
        {
          "role": "九条裟罗",
          "text": "上！"
        },
        {
          "role": "幕府军士",
          "text": "冲啊——"
        },
        {
          "type": "subtitle",
          "text": "九条裟罗率领幕府军士发起进攻…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "五郎",
          "text": "抵住阵线，不要后退！"
        },
        {
          "type": "subtitle",
          "text": "一只鱼从天而降…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "五郎",
          "text": "珊瑚宫大人！"
        },
        {
          "role": "珊瑚宫心海",
          "text": "久等了，我的伏兵们"
        },
        {
          "role": "珊瑚宫心海",
          "text": "此刻正是良机！"
        },
        {
          "role": "枫原万叶",
          "text": "还真是沉的住气啊，军师大人"
        },
        {
          "role": "北斗",
          "text": "但愿你付得起雇佣军的价格"
        },
        {
          "role": "五郎",
          "text": "万叶！"
        },
        {
          "role": "枫原万叶",
          "text": "久违了，老友"
        },
        {
          "role": "反抗军士兵",
          "text": "冲啊"
        },
        {
          "type": "subtitle",
          "text": "在珊瑚宫心海率领的救兵的支援下，反抗军占据上风…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "九条裟罗",
          "text": "嘁…撤退！"
        },
        {
          "role": "珊瑚宫心海",
          "text": "你好，旅行者，第一次正式见面，还请允许我简单介绍一下自己。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "我叫做珊瑚宫心海，是反抗军的组织者，也是海祇岛的「现人神巫女」。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "也许你是第一次听到这个称谓…简单来说，海祇岛目前是我在管理，那里也是整个反抗军的大后方。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "我其实已经从北斗和万叶那里听说了你的事情，只是没想到你会来反抗军。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "之后，你有什么打算吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "暂时没有…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珊瑚宫心海",
          "text": "既然这样，不如去珊瑚宫坐坐？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "如今幕府军虽然暂时撤退，但战争还远远没有结束。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "「眼狩令」没有废止，天领奉行和雷电将军也没有停手的打算…问题并没有得到解决。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "我建议到珊瑚宫，商量之后的对策，不知你意下如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哲平",
          "text": "我…我也可以去吗？"
        },
        {
          "role": "哲平",
          "text": "我对海祇岛也很熟悉，可以继续帮你做向导。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当然可以。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珊瑚宫心海",
          "text": "五郎，这段时间辛苦你了。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "反抗军的实力本就比幕府军弱，我不在的这段时间里，你一定也吃了不少苦。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "之后还得麻烦你再留一段时间，一边盯防幕府军，一边救治伤员。我会请雇佣兵驻扎在这里，万叶也在，这样你的压力也会减轻许多。"
        },
        {
          "role": "五郎",
          "text": "放心吧，珊瑚宫大人！"
        },
        {
          "role": "珊瑚宫心海",
          "text": "我还有一些事，需要先回珊瑚宫处理…旅行者准备好之后，就去找哲平吧，他会带你去珊瑚宫。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "感谢你之前付出的一切努力。今日起，我将与你一同作战。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "为了…稻妻的未来。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（北斗）"
        },
        {
          "role": "北斗",
          "text": "能够悄无声息完成这种伏击的，只有我们「死兆星」号了。"
        },
        {
          "role": "北斗",
          "text": "怎么样，吓了一跳吧？其实我也吓到了，当时送你到了离岛，没想到会和你在踏鞴砂再见面。"
        },
        {
          "role": "北斗",
          "text": "不过不管身在哪里，你是我的老伙计这点是不会变的。"
        },
        {
          "role": "北斗",
          "text": "有什么需要帮助的就来找我吧，我会助你一臂之力的。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（枫原万叶）"
        },
        {
          "role": "枫原万叶",
          "text": "来的路上有看到关于你的悬赏令，不过我猜你也没那么容易被抓住。"
        },
        {
          "role": "枫原万叶",
          "text": "你见过雷电将军了吗？她还是和以前一样，充满压迫感吧。"
        },
        {
          "role": "枫原万叶",
          "text": "「无想的一刀」…真的无法企及吗？"
        },
        {
          "role": "枫原万叶",
          "text": "也许有一天，我们可以直面那种威压…这也是我回稻妻的目标啊。"
