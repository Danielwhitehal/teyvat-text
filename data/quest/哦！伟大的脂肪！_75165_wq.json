{
  "quest_id": 75165,
  "chapter_num": null,
  "chapter_title": "哦！伟大的脂肪！",
  "type": "wq",
  "route": "Sing, Ho, For the Greatness of Fat!",
  "stories": [
    {
      "story_id": 75165,
      "title": "哦！伟大的脂肪！",
      "description": "赞美伟大的脂肪！要成为伟大的战士就绝对不能抛弃脂肪！",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "让我试一试。"
        },
        {
          "role": "苏里奎",
          "text": "来试试看我准备的击罐挑战吧！这片场地原本是我为了锻炼自己准备的，借你用用也没什么问题。"
        },
        {
          "role": "苏里奎",
          "text": "你试一试就知道，大体型在实战中是多么的有力了！"
        },
        {
          "type": "subtitle",
          "text": "完成苏里奎的挑战"
        },
        {
          "role": "苏里奎",
          "text": "路过的勇士，既然会来到特特奥坎，你也是追寻力量的人吧。"
        },
        {
          "role": "苏里奎",
          "text": "或许你已经见过「沃陆之邦」的大力士们了，哼，多数都是些满身肌肉的人。"
        },
        {
          "role": "苏里奎",
          "text": "不过看你身材挺苗条的，应该还没有变成每天疯狂举重卧推的健身狂。"
        },
        {
          "role": "苏里奎",
          "text": "我跟你说，那些都是骗局，不要上当。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你讨厌锻炼吗？",
              "dialogues": []
            },
            {
              "text": "你讨厌肌肉吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "苏里奎",
          "text": "也不能这么说，但鼓吹肌肉，认为勇士的力量来自于肌肉，这肯定是胡说八道。"
        },
        {
          "role": "苏里奎",
          "text": "让我告诉你，古代英雄们的身上绝对不可能除了骨头就是肌肉。"
        },
        {
          "role": "苏里奎",
          "text": "他们的生存环境比今天恶劣得多，在实战中更追求生存与防御，一定会保存适量的脂肪。"
        },
        {
          "role": "苏里奎",
          "text": "他们的体型，应该就像我这样。"
        },
        {
          "role": "苏里奎",
          "text": "我这样微胖的体型才是过去英雄们的体型，兼具冲击力与灵活性的体型。"
        },
        {
          "role": "苏里奎",
          "text": "但部族的大家都不能认识到这一点，唉，太愚蠢了。"
        },
        {
          "role": "苏里奎",
          "text": "看你的表情，好像不太相信的样子…嗯，这样好了。"
        },
        {
          "role": "苏里奎",
          "text": "来试试看我准备的击罐挑战吧！这片场地原本是我为了锻炼自己准备的，借你用用也没什么问题。"
        },
        {
          "role": "苏里奎",
          "text": "你试一试就知道，大体型在实战中是多么的有力了！"
        },
        {
          "role": "旅行者",
          "text": "让我试一试。"
        },
        {
          "role": "旅行者",
          "text": "需要准备一下。"
        },
        {
          "role": "苏里奎",
          "text": "没问题，你准备好的话，随时可以再来。"
        },
        {
          "type": "subtitle",
          "text": "完成苏里奎的挑战"
        },
        {
          "role": "苏里奎",
          "text": "哼哼，你的成绩很不错，但比起我来，还差那么一点。"
        },
        {
          "role": "苏里奎",
          "text": "长期保持微胖体型、但又从来没有疏于训练的我，论灵活性和冲击力，绝对不是那些愚蠢的健身狂能比的。"
        },
        {
          "role": "苏里奎",
          "text": "放弃对肌肉的追求，和我一起赞美伟大的脂肪吧！"
        },
        {
          "type": "subtitle",
          "text": "完成苏里奎的挑战"
        },
        {
          "role": "旅行者",
          "text": "需要准备一下。"
        },
        {
          "role": "苏里奎",
          "text": "没问题，你准备好的话，随时可以再来。"
        },
        {
          "type": "subtitle",
          "text": "晚些时候来看看"
        },
        {
          "role": "伊伊马尼",
          "text": "来试试吧，以你最快的速度通过这片训练场，但注意<color=#00E1FFFF>不要打破任何罐子</color>！"
        },
        {
          "role": "伊伊马尼",
          "text": "看看你的成绩有多好，是否能超过我。"
        },
        {
          "type": "subtitle",
          "text": "完成伊伊马尼的挑战"
        },
        {
          "role": "伊伊马尼",
          "text": "路过的勇士，对，没错，就是你。"
        },
        {
          "role": "伊伊马尼",
          "text": "唉，太瘦了…你有好好吃饭吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "饭都被向导派蒙吃了。",
              "dialogues": [
                {
                  "role": "伊伊马尼",
                  "text": "不论你有什么理由或者苦衷，首先，饭必须好好吃！"
                }
              ]
            },
            {
              "text": "哇，是要请我吃饭吗？",
              "dialogues": [
                {
                  "role": "伊伊马尼",
                  "text": "倒不是这个意思…要是你肚子实在饿的话，我随身带的包里还有点烤肉。不过这个先放到一边…"
                }
              ]
            }
          ]
        },
        {
          "role": "伊伊马尼",
          "text": "既然你已经进入了特特奥坎，大概已经见过「沃陆之邦」的大力士了吧。"
        },
        {
          "role": "伊伊马尼",
          "text": "出于良心，我要给你一个忠告，绝对不要相信那些一个劲鼓吹肌肉的家伙。"
        },
        {
          "role": "伊伊马尼",
          "text": "神赐予我们的脂肪是宝贵的礼物，为了好看的肌肉，就戒掉所有好吃的东西，抛弃脂肪…"
        },
        {
          "role": "伊伊马尼",
          "text": "这么做就是笨到家了，林猪都会同情你。"
        },
        {
          "role": "伊伊马尼",
          "text": "而且要说什么是好看，吹捧肌肉好像也就是这几十年的事吧。"
        },
        {
          "role": "伊伊马尼",
          "text": "我爷爷说，他年轻的时候，大家还是比较喜欢微胖的身材。"
        },
        {
          "role": "伊伊马尼",
          "text": "所以，千万不要听人蛊惑，走上减肥的错误道路！"
        },
        {
          "role": "伊伊马尼",
          "text": "但如果有一天，你跟「沃陆之邦」里我那些亲戚们一样，为了追求力量而选择了减肥…"
        },
        {
          "role": "伊伊马尼",
          "text": "那我还有一句话：论敏捷，体型微胖的战士也可以做到像鱼一样灵活，论力量，那些瘦家伙根本不是我们的对手。"
        },
        {
          "role": "伊伊马尼",
          "text": "要问证据的话，这片训练场里的罐子就是证据。"
        },
        {
          "role": "伊伊马尼",
          "text": "以我的体型，要做到<color=#00E1FFFF>疾速通过而不打破罐子</color>轻而易举，这种程度的敏捷，就算是瘦子也未必做得到吧？"
        },
        {
          "role": "伊伊马尼",
          "text": "看你那要笑又不好意思笑的表情…没关系没关系，我就知道你不相信。"
        },
        {
          "role": "伊伊马尼",
          "text": "来试试吧，以你最快的速度通过这片训练场，但注意<color=#00E1FFFF>不要打破任何罐子</color>！"
        },
        {
          "role": "伊伊马尼",
          "text": "看看你的成绩有多好，是否能超过我。"
        },
        {
          "role": "旅行者",
          "text": "让我试一试。"
        },
        {
          "role": "旅行者",
          "text": "需要准备一下。"
        },
        {
          "role": "伊伊马尼",
          "text": "没问题，你准备好的话，随时可以再来。"
        },
        {
          "type": "subtitle",
          "text": "完成伊伊马尼的挑战"
        },
        {
          "role": "伊伊马尼",
          "text": "你的成绩很不错嘛，但是呢，说实话…这不是我夸口，我的最佳记录确实在你之上。"
        },
        {
          "role": "伊伊马尼",
          "text": "人嘛，总会有这么一两项自己做得好的事。"
        },
        {
          "role": "伊伊马尼",
          "text": "这下你相信了吧，我这种体型的战士未必不敏捷，所以饭一定要好好吃，不要胡乱减肥！"
        },
        {
          "type": "subtitle",
          "text": "完成伊伊马尼的挑战"
        },
        {
          "role": "旅行者",
          "text": "让我试一试。"
        },
        {
          "type": "subtitle",
          "text": "与前面的二人交谈"
        },
        {
          "role": "旅行者",
          "text": "需要准备一下。"
        },
        {
          "role": "伊伊马尼",
          "text": "没问题，你准备好的话，随时可以再来。"
        },
        {
          "role": "苏里奎",
          "text": "伊伊马尼，你好像又胖了，恭喜！"
        },
        {
          "role": "伊伊马尼",
          "text": "哈哈，谢谢你，苏里奎。"
        },
        {
          "role": "伊伊马尼",
          "text": "好消息，我这些天又劝住了一个想减肥的瘦子。"
        },
        {
          "role": "苏里奎",
          "text": "哦，很了不起啊，大好事！"
        },
        {
          "role": "苏里奎",
          "text": "欸，是你，怎么样，这几天有好好吃饭吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "吃饭很香。",
              "dialogues": [
                {
                  "role": "伊伊马尼",
                  "text": "很好，就应该多吃饭，吃得胖胖的才对。"
                }
              ]
            },
            {
              "text": "吃得不好。",
              "dialogues": [
                {
                  "role": "苏里奎",
                  "text": "这不好，没有什么事情比好好吃饭更重要。"
                }
              ]
            }
          ]
        },
        {
          "role": "苏里奎",
          "text": "伊伊马尼，我跟你说，这人的击罐记录很厉害，离我的最好成绩就差一点点。"
        },
        {
          "role": "伊伊马尼",
          "text": "他也在我这里接受过挑战，成绩也不错。"
        },
        {
          "role": "苏里奎",
          "text": "可以啊，没想到你这么厉害，居然差一点就超过我们两个。"
        },
        {
          "role": "伊伊马尼",
          "text": "我觉得他再长胖点，说不定真的能超过我们…"
        },
        {
          "role": "苏里奎",
          "text": "嗯，很有可能。虽然从我的角度来看，你有点太苗条了，还有长胖的空间，不过嘛…"
        },
        {
          "role": "苏里奎",
          "text": "我认可你了！"
        },
        {
          "role": "伊伊马尼",
          "text": "我也认可你了！"
        },
        {
          "role": "伊伊马尼",
          "text": "但我还是建议你每顿饭最好多吃点。"
        },
        {
          "role": "苏里奎",
          "text": "不要节食，不要减肥，我们会失望的。"
        }
      ]
    }
  ]
}