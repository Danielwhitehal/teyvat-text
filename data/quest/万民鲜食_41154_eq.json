{
  "quest_id": 41154,
  "chapter_num": null,
  "chapter_title": "万民鲜食",
  "type": "eq",
  "route": "Wanmin Fresh",
  "stories": [
    {
      "story_id": 41154,
      "title": "万民鲜食",
      "description": "璃月港的万民堂里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "卯师傅",
          "text": "好吧，我想想还有谁能出入绝云间的…"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "卯师傅",
          "text": "那就拜托你了。"
        },
        {
          "role": "卯师傅",
          "text": "送去绝云间可要小心，不要乱飞乱爬。我担心会触怒仙人的。"
        },
        {
          "role": "卯师傅",
          "text": "还有别沾染奇怪的元素，会破坏口感的。"
        },
        {
          "role": "随缘的铃官",
          "text": "唔…肚子饿了。"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "卯师傅",
          "text": "对，一位叫铃官的客人在我们这订了一份来来菜，说让我们晚些时候送去绝云间。"
        },
        {
          "role": "卯师傅",
          "text": "绝云间那是平常人能去的地方吗！"
        },
        {
          "role": "卯师傅",
          "text": "咳咳，总之麻烦你深入绝云间了，看能不能准时送到了。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "随缘的铃官",
          "text": "总算送来啦！谢谢你。"
        },
        {
          "role": "随缘的铃官",
          "text": "吃完感觉运气都回来了。"
        }
      ]
    }
  ]
}