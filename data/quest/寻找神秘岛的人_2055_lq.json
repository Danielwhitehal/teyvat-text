{
  "quest_id": 2055,
  "chapter_num": "流泉所归之处  第一幕",
  "chapter_title": "寻找神秘岛的人",
  "type": "lq",
  "route": "Those Searching for the Mysterious Island",
  "stories": [
    {
      "story_id": 15005,
      "title": "寻找神秘岛的人",
      "description": "在野外游历的你听到了两名游客的呼救声，你和派蒙决定施以援手…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往流泉之众驻地的野外游玩"
        },
        {
          "role": "派蒙",
          "text": "这里的景色很不错，还能偶尔看到鳍游龙，我们找几头野生的鳍游龙来合影吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "野生的咬人怎么办？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这…反正我觉得鳍游龙挺可爱的…"
        },
        {
          "role": "派蒙",
          "text": "哎？那里是…"
        },
        {
          "role": "卡嘉",
          "text": "救命！谁来帮帮我们？"
        },
        {
          "role": "派蒙",
          "text": "哇，野生的鳍游龙真的在咬人！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "见义勇为！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对，那两个人有危险，大名鼎鼎的旅行者和他的搭档绝不会袖手旁观！"
                }
              ]
            },
            {
              "text": "只能等下再合影了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是啊，没时间讲这个了。有人在呼救，我们不能袖手旁观吧？"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "击退鳍游龙"
        },
        {
          "role": "卡嘉",
          "text": "退…退后！"
        },
        {
          "role": "派蒙",
          "text": "不要慌，再坚持一下！"
        },
        {
          "role": "卡嘉",
          "text": "终于有人来了…救命！"
        },
        {
          "type": "subtitle",
          "text": "击败}}{{图标|鳍游龙|3}}{{黑幕|可以通过魂附直接完成",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "与被解救的游客对话"
        },
        {
          "type": "subtitle",
          "text": "落败的鳍游龙四散逃走了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "你们这身打扮，难道是须弥来的学者？"
        },
        {
          "role": "卡嘉",
          "text": "嗯，我是卡嘉，这位是我的前辈维兰德。真的非常感谢你们，刚刚太危险了…"
        },
        {
          "role": "派蒙",
          "text": "不用谢，对我们来说只是小事一桩啦。我是派蒙，这位是旅行者。"
        },
        {
          "role": "维兰德",
          "text": "唉…那些鳍游龙全都跑了，至少要活捉一只啊。"
        },
        {
          "role": "派蒙",
          "text": "活捉？"
        },
        {
          "role": "维兰德",
          "text": "对了，我看你们身手不错，要不我来做诱饵吸引那些鳍游龙，你们帮我活捉一只，我会支付报酬的！"
        },
        {
          "role": "派蒙",
          "text": "这…"
        },
        {
          "role": "卡嘉",
          "text": "非常抱歉，维兰德只是太专注于他的研究了，还请不要见怪…"
        },
        {
          "role": "派蒙",
          "text": "没关系没关系！话说回来，你们为什么要招惹野生的鳍游龙呢？还要活捉…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道你们也想合影？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "肯定跟这个没关系啦！"
        },
        {
          "role": "卡嘉",
          "text": "让两位见笑了，其实我和维兰德正在寻找传说中的神秘岛。据说有一条重要的线索就在这些鳍游龙身上，所以…"
        },
        {
          "role": "卡嘉",
          "text": "没有来自「流泉之众」的向导帮助，就贸然接触它们，果然很不明智啊。"
        },
        {
          "role": "派蒙",
          "text": "神秘岛？"
        },
        {
          "role": "卡嘉",
          "text": "嗯，一个来自「流泉之众」的传说提到了一座神秘的岛屿，维兰德相信他的研究目标就在这座岛上。"
        },
        {
          "role": "维兰德",
          "text": "咳咳…你们真的不考虑一下我刚刚的提议吗？"
        },
        {
          "role": "派蒙",
          "text": "刚刚的提议…我们才不会把一个大活人当诱饵呢！"
        },
        {
          "role": "维兰德",
          "text": "那继续谈也是浪费时间，得想想别的办法…"
        },
        {
          "role": "卡嘉",
          "text": "前辈！"
        },
        {
          "role": "维兰德",
          "text": "好吧…刚刚你们确实救了我和卡嘉，于情于理，我是该向你们道谢…非常感谢。"
        },
        {
          "role": "派蒙",
          "text": "好别扭啊…"
        },
        {
          "role": "维兰德",
          "text": "卡嘉，我们该走了。"
        },
        {
          "role": "卡嘉",
          "text": "真的非常抱歉，维兰德确实不太擅长处理人际关系…"
        },
        {
          "role": "派蒙",
          "text": "没关系，再见！"
        },
        {
          "role": "派蒙",
          "text": "真是稀奇，这样的两个人竟然能够结伴探险。"
        },
        {
          "role": "派蒙",
          "text": "不过话说回来，那位大姐姐提到的神秘岛真的让我很好奇呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙也想去？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，或许会有宝藏哦！"
        },
        {
          "role": "派蒙",
          "text": "这一路上，我们一起探索了那么多神奇的地方，找到这个神秘岛对我们来说也绝对不在话下！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但是什么情报都没有。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "也是…对了，那位大姐姐说这个神秘岛是「流泉之众」传说中的一座岛屿，或许我们可以到那里找人问问？"
        },
        {
          "role": "派蒙",
          "text": "事不宜迟，现在就开始我们的下一段冒险吧！"
        },
        {
          "role": "派蒙",
          "text": "虽说计划好了找人问问，但具体该找谁是个问题。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许可以直接找首领？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯…也对，那位大姐姐提到这个神秘岛和「流泉之众」的一个传说有关，那「流泉之众」的首领肯定知道。"
        }
      ]
    }
  ]
}