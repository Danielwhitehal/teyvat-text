{
  "quest_id": 74682,
  "chapter_num": null,
  "chapter_title": "参寻战记·觐见孤王！",
  "type": "wq",
  "route": "Search Chronicle: Audience with the Solitary King!",
  "stories": [
    {
      "story_id": 74682,
      "title": "参寻战记·觐见孤王！",
      "description": "尽管结识新伙伴的计划进展并不顺利，但兰吉特并不在意，并且已经准备开始新的挑战…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往「千年珍珠骏麟王庭」"
        },
        {
          "role": "兰吉特",
          "text": "终于还是走到了今天这一步啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "儿时的梦想呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰吉特",
          "text": "长大成人之后，终于理解了当年巡林官面露难色的理由…"
        },
        {
          "role": "兰吉特",
          "text": "咳，不管怎么说，至少尝试过了。"
        },
        {
          "role": "兰吉特",
          "text": "而且也知道了不该带着未经处理的爆炎树果实接近翠翎恐蕈…"
        },
        {
          "role": "兰吉特",
          "text": "闻到枯焦味道的时候已经晚了，差点被它散播的孢子淹没。"
        },
        {
          "role": "兰吉特",
          "text": "常常会忘记蕈兽毕竟不是蕈猪，是完全不同的物种呢。"
        },
        {
          "role": "派蒙",
          "text": "对哦，说起来，蕈兽应该算是菌类吧？"
        },
        {
          "role": "兰吉特",
          "text": "是啊，炖汤的话特别鲜美。"
        },
        {
          "role": "派蒙",
          "text": "呃，要不我们还是说回今天的挑战对象吧。"
        },
        {
          "role": "兰吉特",
          "text": "我还没想好怎么料理…哦！你是在说「交涉」，抱歉。"
        },
        {
          "role": "兰吉特",
          "text": "不知道两位听说过原海异种的两位霸主的故事没有，故事里形容千年珍珠骏麟都是用的孤傲、高洁这样的词。"
        },
        {
          "role": "兰吉特",
          "text": "相比之下，铁甲熔火帝皇听起来就像是什么不好惹的狠角色，强大但是暴戾。"
        },
        {
          "role": "派蒙",
          "text": "我还以为你会选听起来更强的那个挑战呢，毕竟之前也说过既然要讲故事，对手当然是越强越好。"
        },
        {
          "role": "兰吉特",
          "text": "铁甲熔火帝皇确实很强，可那毕竟是重甲蟹…相比之下，千年珍珠骏麟可是能飞的海马！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能飞的海马是不是应该叫天马？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你在意的居然是这个问题吗？"
                }
              ]
            },
            {
              "text": "对我来说都没有区别…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰吉特",
          "text": "不管怎么说，只要让我骑乘哪怕一次…"
        },
        {
          "role": "派蒙",
          "text": "好吧，看来你是要坚持到底了。"
        },
        {
          "role": "兰吉特",
          "text": "来都来了，总不能无功而返！准备好了的话，我们这就出发吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": []
            },
            {
              "text": "还有别的事，稍候。",
              "dialogues": [
                {
                  "role": "兰吉特",
                  "text": "没问题，我就在这儿等你。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（兰吉特）"
        },
        {
          "role": "兰吉特",
          "text": "现在出发吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "走吧。",
              "dialogues": []
            },
            {
              "text": "关于能飞的伙伴…",
              "dialogues": [
                {
                  "role": "兰吉特",
                  "text": "之前提到的昆图尔的故事，他的伙伴暝视龙就是能飞得很高的龙。"
                },
                {
                  "role": "兰吉特",
                  "text": "不如说，如果没有暝视龙伙伴的帮助，他恐怕也很难成功吧。"
                },
                {
                  "role": "兰吉特",
                  "text": "有个能飞的伙伴真不错啊…仔细想想，你的伙伴也是能飞的，怎么样，她有什么拿手的技能之类的吗？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "她能让很多食物瞬间消失。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "兰吉特",
                  "text": "哇，是厨子听了会开心的技能。"
                },
                {
                  "role": "兰吉特",
                  "text": "下次也让我给她做点好吃的吧。说起我的手艺，纳塔朋友都建议我留在纳塔做龙饭厨子，肯定大受欢迎。{{黑幕|是指只有龙能咽得下？ }}"
                },
                {
                  "role": "兰吉特",
                  "text": "你的伙伴肯定也会喜欢的！"
                }
              ]
            },
            {
              "text": "关于温泉…",
              "dialogues": [
                {
                  "role": "兰吉特",
                  "text": "枫丹好像也有几处热泉，足足能把人烫伤的那种。听说铁甲熔火帝皇的居所附近的水域就格外灼热…"
                },
                {
                  "role": "兰吉特",
                  "text": "不过纳塔温泉又是不一样的热，该怎么说呢，不管是身体还是心灵的伤痛都能被它治愈。"
                },
                {
                  "role": "兰吉特",
                  "text": "也因为这个，意外的叫人上瘾呢…"
                }
              ]
            },
            {
              "text": "还有别的事，稍候。",
              "dialogues": [
                {
                  "role": "兰吉特",
                  "text": "没问题，我就在这儿等你。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          21,
          23
        ]
      ]
    }
  ]
}