{
  "quest_id": 74706,
  "chapter_num": null,
  "chapter_title": "水族箱里的…明星？",
  "type": "wq",
  "route": "A Superstar... In the Aquarium?",
  "stories": [
    {
      "story_id": 74706,
      "title": "水族箱里的…明星？",
      "description": "芙宁娜似乎在欣赏水族箱…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往水族箱附近…"
        },
        {
          "role": "哥伦比娅",
          "text": "…这条呢？"
        },
        {
          "role": "芙宁娜",
          "text": "好像还是差一点…"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅，还有芙宁娜？你们在干嘛呢？"
        },
        {
          "role": "哥伦比娅",
          "text": "在和芙宁娜导演一起…「选角」？"
        },
        {
          "role": "芙宁娜",
          "text": "这么说倒也没错，只不过我们准备选的演员，是水族箱里的鱼。"
        },
        {
          "role": "派蒙",
          "text": "鱼都能演戏了？"
        },
        {
          "role": "芙宁娜",
          "text": "现在动物演员也不少见嘛。我们想选一条气质比较符合的鱼，拍摄一些映影中用来烘托氛围的空镜。"
        },
        {
          "role": "芙宁娜",
          "text": "只不过看了一圈下来，还没有找到太合适的。"
        },
        {
          "role": "哥伦比娅",
          "text": "要试着拜托旅行者和派蒙吗？很多问题他们都能解决。"
        },
        {
          "role": "派蒙",
          "text": "你这么信任我们倒是很高兴啦…但这个问题上…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们可以多找一些鱼？",
              "dialogues": []
            },
            {
              "text": "我们可以多下水看看？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芙宁娜",
          "text": "对哦！这水族馆就是你们负责经营的。"
        },
        {
          "role": "派蒙",
          "text": "也就是说，我们以后在下水的时候多留个心就行了？好像的确不难。"
        },
        {
          "role": "芙宁娜",
          "text": "那就这么说定了！我稍后将想象中符合气质的鱼告诉你们。"
        },
        {
          "role": "哥伦比娅",
          "text": "那你们现在就是「星探」了？"
        },
        {
          "role": "派蒙",
          "text": "你跟着芙宁娜还真是学到好多新词…"
        }
      ]
    }
  ]
}