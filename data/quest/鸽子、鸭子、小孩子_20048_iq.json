{
  "quest_id": 20048,
  "chapter_num": null,
  "chapter_title": "鸽子、鸭子、小孩子",
  "type": "iq",
  "route": "Pigeon, Duck, and Child",
  "stories": [
    {
      "story_id": 20048,
      "title": "鸽子、鸭子、小孩子",
      "description": "提米又在生闷气，但这次似乎并不是鸽子被吓走了这么简单…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与提米对话"
        },
        {
          "role": "提米",
          "text": "哇啊！又是你！鸽子又全都飞走了！"
        },
        {
          "role": "提米",
          "text": "我还在喂它们呢，你做什么啊？！"
        },
        {
          "role": "旅行者",
          "text": "抱歉。"
        },
        {
          "role": "提米",
          "text": "妈妈说，歉意要用实际行动来表示。"
        },
        {
          "role": "提米",
          "text": "桥上的鸽子是我的好朋友，我一直在喂它们。"
        },
        {
          "role": "提米",
          "text": "但最近附近的鸭子们经常来抢食物吃，搞得它们谁也吃不饱…"
        },
        {
          "role": "提米",
          "text": "我想请你帮我找三份小麦来，帮我喂下鸭子们，我也会在桥上把鸽子们也喂饱的。"
        },
        {
          "role": "提米",
          "text": "都吃饱了之后，它们一定会友好相处吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "提米",
                  "text": "那就拜托你啦。"
                },
                {
                  "role": "提米",
                  "text": "好好对待动物的话，你也可以和它们做朋友的。"
                }
              ]
            },
            {
              "text": "我不太想和鸽子做朋友…",
              "dialogues": [
                {
                  "role": "提米",
                  "text": "无论想不想做朋友…你都要先向它们道歉。"
                },
                {
                  "role": "提米",
                  "text": "所以——快点去找小麦啦！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找并持有三份小麦"
        },
        {
          "role": "提米",
          "text": "你找到小麦了吗？"
        },
        {
          "role": "旅行者",
          "text": "找好了。"
        },
        {
          "role": "提米",
          "text": "这些应该就够了。"
        },
        {
          "role": "提米",
          "text": "把这些带到湖边，喂给鸭子们吧。"
        },
        {
          "type": "subtitle",
          "text": "将小麦交给提米"
        },
        {
          "type": "subtitle",
          "text": "去湖边播撒小麦"
        },
        {
          "role": "提米",
          "text": "你找到小麦了吗？"
        },
        {
          "role": "旅行者",
          "text": "还正在找。"
        },
        {
          "role": "提米",
          "text": "好吧，一定要在鸭子们回家之前找到啊。"
        },
        {
          "role": "提米",
          "text": "鸽子？鸽子还没来呢，没关系，它们总会来的。"
        },
        {
          "type": "subtitle",
          "text": "与提米对话"
        },
        {
          "role": "提米",
          "text": "鸽子们怎么还不来呢…"
        },
        {
          "role": "提米",
          "text": "唔，它们吃饱了以后，肯定能和平共处了吧。"
        },
        {
          "role": "提米",
          "text": "下次走过的时候，记得不要再吓到鸽子了，它们好不容易才愿意回来。"
        },
        {
          "role": "旅行者",
          "text": "知道了…"
        },
        {
          "role": "提米",
          "text": "好啦，我原谅你了。这个给你，我最喜欢吃的蒙德土豆饼。"
        },
        {
          "role": "提米",
          "text": "要对世界保持善意啊…这是妈妈教我的。"
        },
        {
          "type": "subtitle",
          "text": "与生气的提米对话"
        },
        {
          "role": "提米",
          "text": "你都干了什么啊！我都看见了！鸭子们都…都…"
        },
        {
          "role": "旅行者",
          "text": "这也是为了鸽子们…"
        },
        {
          "role": "提米",
          "text": "走开啦！我再也不想看见你了！"
        },
        {
          "role": "提米",
          "text": "呜哇——我要回去告诉妈妈！"
        }
      ]
    }
  ]
}