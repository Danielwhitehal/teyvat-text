{
  "quest_id": 72279,
  "chapter_num": null,
  "chapter_title": "关于拯救狸猫合影板这件事",
  "type": "wq",
  "route": "About That Time We Saved the Tanuki Photo Board",
  "stories": [
    {
      "story_id": 72279,
      "title": "关于拯救狸猫合影板这件事",
      "description": "负责维护容彩祭秩序的同心木村似乎遇到了一些麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与托马对话"
        },
        {
          "role": "托马",
          "text": "嘿，在这里见到你们真是意外。"
        },
        {
          "role": "旅行者",
          "text": "你怎么来了？"
        },
        {
          "role": "托马",
          "text": "本来我是听说会展上出现了一位特别喜爱狸猫留影板的「人物」。"
        },
        {
          "role": "托马",
          "text": "毕竟是我社奉行操办的祭典，有这等「人物」出现，我当然要来认识一下。"
        },
        {
          "role": "托马",
          "text": "这红色的角…如果我没猜错的话，这位就是鼎鼎有名的荒泷派之主，荒泷一斗阁下吧？"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈——！托马兄弟果然有眼力！"
        },
        {
          "role": "荒泷一斗",
          "text": "神里家的无敌家政官，我也早就听过你的大名！"
        },
        {
          "role": "托马",
          "text": "初次见面，一斗兄弟抬爱了。"
        },
        {
          "role": "派蒙",
          "text": "呜哇！这两个人，这么快就称兄道弟起来了…"
        },
        {
          "role": "托马",
          "text": "没想到一斗兄弟和旅行者都在这里。"
        },
        {
          "role": "托马",
          "text": "我也勉强算是东道主，是有什么麻烦吗？尽管开口，不用和我客气。"
        },
        {
          "role": "派蒙",
          "text": "是一斗啦！他要…"
        },
        {
          "role": "荒泷一斗",
          "text": "没什么大不了，我们只是在商量决斗的方式罢了。"
        },
        {
          "role": "托马",
          "text": "噢——决斗的方式是吧…"
        },
        {
          "role": "托马",
          "text": "我倒有个提议，既然是要在容彩祭上决斗，或许可以来一场志愿者大比拼吧。"
        },
        {
          "role": "托马",
          "text": "一起为容彩祭添砖加瓦，各位觉得怎么样？"
        },
        {
          "role": "荒泷一斗",
          "text": "志愿者大比拼？听起来完全不能体现我荒泷派的豪情壮志啊…"
        },
        {
          "role": "荒泷一斗",
          "text": "我的兴趣只有两分。一分给旅行者，一分给托马兄弟。"
        },
        {
          "role": "阿守",
          "text": "老大的意思是…他的满分是一百分。"
        },
        {
          "role": "托马",
          "text": "哈哈，嗯，这份工作确实用不上豪情壮志，只需要一些耐心与奉献就够了。"
        },
        {
          "role": "托马",
          "text": "而且因为是志愿者，也没有什么报酬，只有远航之风的联名饮料，作为一点慰问…"
        },
        {
          "role": "托马",
          "text": "实在有些配不上荒泷派的身份，是我欠考虑了。"
        },
        {
          "role": "荒泷一斗",
          "text": "等等…你刚刚说什么慰问？"
        },
        {
          "role": "托马",
          "text": "噢，只是一点八重堂与远航之风联名的特别饮料，不值一提。"
        },
        {
          "role": "阿晃",
          "text": "老大！是那款饮料!"
        },
        {
          "role": "元太",
          "text": "干活就有饮料！"
        },
        {
          "role": "荒泷一斗",
          "text": "啊…托马兄弟，其实你不知道，我说的两分，其实满分就是两分。"
        },
        {
          "role": "荒泷一斗",
          "text": "毕竟我们荒泷派，最不缺的就是耐心与奉献！"
        },
        {
          "role": "荒泷一斗",
          "text": "你的点子非常豪爽畅快，热情奔放！简直是为本大爷量身定制，哈哈哈哈哈——！"
        },
        {
          "role": "荒泷一斗",
          "text": "旅行者，我们就来决斗这个吧，谁先完成志愿者的工作谁就赢了！你觉得怎么样？"
        },
        {
          "role": "派蒙",
          "text": "明明刚刚还一副没兴趣的样子喂。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "既然这样，其实也可以不决斗的…",
            "想要饮料可以直接和托马说…"
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "我堂堂荒泷铁血第一斗，行的正站得直，说要决斗，就一定决斗。"
        },
        {
          "role": "派蒙",
          "text": "其实只是不想让别人知道目的是特别饮料吧。"
        },
        {
          "role": "托马",
          "text": "既然如此，不如就让我来当一回裁判。"
        },
        {
          "role": "托马",
          "text": "志愿者的工作很简单，主要是帮助祭典上需要帮助的人们。"
        },
        {
          "role": "托马",
          "text": "我会把我这里已经收到的工作请求分发给你们。"
        },
        {
          "role": "托马",
          "text": "准备好了的话，我们现在就开始吧。"
        },
        {
          "role": "木村",
          "text": "这么多投诉…该怎么办呢？"
        },
        {
          "role": "旅行者",
          "text": "需要帮忙吗?"
        },
        {
          "role": "木村",
          "text": "啊，您应该就是上面说的…会来协助我们的那位旅行者吧？"
        },
        {
          "role": "木村",
          "text": "您来的太及时了，我们确实遇到了一点小麻烦。"
        },
        {
          "role": "木村",
          "text": "如您所知，现在这里正在举办容彩祭。"
        },
        {
          "role": "木村",
          "text": "容彩祭上除了一些商品展售外，还提供了很多免费的娱乐休闲项目。"
        },
        {
          "role": "木村",
          "text": "但是今天我们接到了好几起投诉，说有伙人霸占了一块狸猫合影板。"
        },
        {
          "role": "木村",
          "text": "他们一直赖着不走，搞得其他人都没法使用了。"
        },
        {
          "role": "木村",
          "text": "啊，真是头疼…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "不能把他们赶走吗?",
            "不能把他们抓起来吗？"
          ]
        },
        {
          "role": "木村",
          "text": "唔…我们当然也去交涉过了。只是设立休闲设施的初衷，是希望大家都能享受到会展的乐趣。"
        },
        {
          "role": "木村",
          "text": "原则上就是对所有人开放的，自然也没有规定使用时限…"
        },
        {
          "role": "木村",
          "text": "所以只要他们没有做出什么违法的事，就算像这样赖着不走…"
        },
        {
          "role": "木村",
          "text": "我们也没有什么好办法。"
        },
        {
          "role": "木村",
          "text": "所以，您能帮忙去协商一下吗？"
        },
        {
          "role": "木村",
          "text": "如果这些投诉不解决，被九条大人知道了。"
        },
        {
          "role": "木村",
          "text": "我这个月的奖金一定泡汤了…"
        },
        {
          "role": "派蒙",
          "text": "霸占合影板这种事情，听起来很像是那个家伙会做的呢！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们去看看吧？"
        },
        {
          "role": "木村",
          "text": "太感谢了！他们就在广场东边的狸猫合影板附近。"
        },
        {
          "role": "荒泷一斗",
          "text": "哎哟，旅行者，派蒙，别来无恙啊！"
        },
        {
          "role": "荒泷一斗",
          "text": "原来你们也逛容彩祭，果然是同好啊，本大爷没有看错你们。"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈——！"
        },
        {
          "role": "派蒙",
          "text": "真是幼稚。"
        },
        {
          "role": "派蒙",
          "text": "我们可是来帮人解决问题的。"
        },
        {
          "role": "荒泷一斗",
          "text": "噢——原来如此。谁有问题需要我解决吗？我们荒泷派义不容辞！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你猜呢？",
            "你们就是问题。"
          ]
        },
       
        {
          "role": "荒泷一斗",
          "text": "欸？！"
        },
        {
          "role": "派蒙",
          "text": "你们荒泷派就是问题啦！"
        },
        {
          "role": "派蒙",
          "text": "天领奉行说你们霸占了这块公用的合影板，搞得其他人都没法用了。"
        },
        {
          "role": "荒泷一斗",
          "text": "啊…这个…这个…没有这回事吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "已经收到了好几起投诉了。",
            "你要不要解释一下。"
          ]
        },
        
        {
          "role": "荒泷一斗",
          "text": "呃…这就说来话长了…阿守，你们来解释一下！"
        },
        {
          "role": "阿守",
          "text": "是！老大!"
        },
        {
          "role": "阿守",
          "text": "事情要从两个月前我们得知容彩祭举办开始讲起…"
        },
        {
          "role": "阿守",
          "text": "众所周知，容彩祭上会有很多文化书籍的展览和售卖。"
        },
        {
          "role": "阿守",
          "text": "老大英明神武，他认为在这种关键时刻，我们应该出一本刊物什么的来介绍荒泷派，方便宣传光辉的团队形象。"
        },
        {
          "role": "阿晃",
          "text": "老大说这样还可以卖点小钱，补贴家用。"
        },
        {
          "role": "荒泷一斗",
          "text": "咳咳…这不是重点。"
        },
        {
          "role": "派蒙",
          "text": "这就是重点吧！"
        },
        {
          "role": "阿守",
          "text": "最开始时间很充裕，有两个月，老大计划先写它个六十页。"
        },
        {
          "role": "阿晃",
          "text": "结果一个月过去了，只写了一行。"
        },
        {
          "role": "荒泷一斗",
          "text": "咳咳…这是为了保证文案的高质量。"
        },
        {
          "role": "派蒙",
          "text": "明明是拖延症吧！"
        },
        {
          "role": "阿守",
          "text": "我们只好减掉一些计划中的内容，还剩一个月的时间，如果能写二十页应该也不错。"
        },
        {
          "role": "阿晃",
          "text": "结果第二天老大搞来了一种叫做《七圣召唤》的卡牌游戏，大家都很喜欢。"
        },
        {
          "role": "元太",
          "text": "其实感觉就玩了几把，居然一下就过去了半个月！真是神奇的游戏啊。"
        },
        {
          "role": "荒泷一斗",
          "text": "咳咳…这是为了搜集写作素材。"
        },
        {
          "role": "派蒙",
          "text": "这种素材跟宣传荒泷派毫无关系吧！"
        },
        {
          "role": "阿守",
          "text": "总之还剩最后两周，刊物肯定是来不及了。"
        },
        {
          "role": "阿守",
          "text": "老大说干脆换成宣传彩页，这样只需要想一句口号就可以了。"
        },
        {
          "role": "派蒙",
          "text": "听起来终于靠谱了一点，想个口号应该花不了多久吧？"
        },
        {
          "role": "阿守",
          "text": "想口号确实很快，我们只用了半天就想出了三十句口号。"
        },
        {
          "role": "阿晃",
          "text": "但就是因为太多了，大家产生了分歧，最后花了整整一周才敲定。"
        },
        {
          "role": "阿守",
          "text": "这时候去印刷才发现，因为时间紧张，还要支付高额的加急费。"
        },
        {
          "role": "元太",
          "text": "我们…我们付不起！"
        },
        {
          "role": "荒泷一斗",
          "text": "咳咳…所谓慢工出细活，加急的印刷肯定会出问题。"
        },
        {
          "role": "荒泷一斗",
          "text": "咱们荒泷派，要做就做最好的！这才是本大爷选择放弃的原因！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "行吧。",
            "你们开心就好。"
          ]
        },
        {
          "role": "旅行者",
          "text": "行吧。"
        },
        {
          "role": "荒泷一斗",
          "text": "说得不错！不论是做鬼还是做人，最重要的就是开心。"
        },
        {
          "role": "荒泷一斗",
          "text": "这次祭典这么难得，不如带着大伙好好享受享受！"
        },
        {
          "role": "派蒙",
          "text": "你们享受的方式…就是霸占这块留影板？"
        },
        {
          "role": "阿守",
          "text": "啊…其实最开始，老大是要带我们来买一款饮料的，说是祭典特别限定款。"
        },
        {
          "role": "荒泷一斗",
          "text": "没错，那可不是普通饮料，是远航之风商店与八重堂联名研发的、著名小说《拜托了我的狐仙宫司》里出现过的特别饮料！"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "阿守",
          "text": "结果来祭典时，因为大家打扮的造型太别具一格，被工作人员拦下来了。"
        },
        {
          "role": "阿守",
          "text": "一定要让我们恢复原样才肯放我们进来…"
        },
        {
          "role": "元太",
          "text": "那可是花了大价钱、大心血才做好的造型啊！居然说我们影响市容风貌。"
        },
        {
          "role": "阿守",
          "text": "总之这样一来二去，等我们赶到远航之风摊位时，那款饮料已经售罄了…"
        },
        {
          "role": "阿守",
          "text": "大家都很沮丧，但也没办法，回头路上看到这块留影板，老大说也不能白来一趟，所以…"
        },
        {
          "role": "派蒙",
          "text": "所以就直接霸占了这里是吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "咳咳…公用的东西，怎么能叫霸占呢？"
        },
        {
          "role": "荒泷一斗",
          "text": "这是充分利用公共资源。"
        },
        {
          "role": "阿晃",
          "text": "老大说的对，我们让这块合影板充分发光发热！"
        },
        {
          "role": "元太",
          "text": "让它活得跟我们荒泷派一样，不浪费一分一秒！"
        },
        {
          "role": "派蒙",
          "text": "哦哟——居然能说得这么崇高…"
        },
        {
          "role": "旅行者",
          "text": "其实你们还可以去买买书。"
        },
        {
          "role": "阿守",
          "text": "因为在造型上花费了太多…只留下了买一杯饮料的钱…"
        },
        {
          "role": "阿守",
          "text": "买书的话已经完全不够了。"
        },
        {
          "role": "派蒙",
          "text": "那也不能因为没钱，就这样霸占着这块免费的合影板，这样别人都没法用了。"
        },
        {
          "role": "荒泷一斗",
          "text": "你们这样说的…也不是没道理。"
        },
        {
          "role": "派蒙",
          "text": "所以赶紧让出来啦！"
        },
        {
          "role": "荒泷一斗",
          "text": "嗯…嗯…"
        },
        {
          "role": "荒泷一斗",
          "text": "只是你们也知道吧，我荒泷派毕竟是个有名有姓的大组织。"
        },
        {
          "role": "荒泷一斗",
          "text": "说了要让这块合影板发光发热，就必须得让这块合影板发光发热。"
        },
        {
          "role": "荒泷一斗",
          "text": "如果随随便便就放弃计划，实在是行事没有章法，有损帮派威风！"
        },
        {
          "role": "荒泷一斗",
          "text": "但是…如果我们能用荒泷派的方式来解决这件事，那就没问题了。"
        },
        {
          "role": "派蒙",
          "text": "荒泷派的方式…我有不好的预感。"
        },
        {
          "role": "荒泷一斗",
          "text": "所以，和我荒泷天下第一斗来场热血豪情的爽快决斗吧！"
        },
        {
          "role": "荒泷一斗",
          "text": "如果你们赢了，本大爷就让出这块板子。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "不会是斗虫吧？",
            "太好了，我们来斗虫吧！"
          ]
        },
       
        {
          "role": "荒泷一斗",
          "text": "斗虫是个绝妙的点子！我最近抓到了一只超强的鬼兜虫战士，我叫它「深黯恶魔」！"
        },
        {
          "role": "荒泷一斗",
          "text": "但可惜，今天我没有把「深黯恶魔」带在身上…"
        },
        {
          "role": "派蒙",
          "text": "还好你没有带…"
        },
        {
          "role": "荒泷一斗",
          "text": "所以应该怎么决斗呢？真是难办，让我想想…"
        },
        {
          "role": "派蒙",
          "text": "哇，快看，那是托马吧？他也来逛祭典啦。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，关于决斗的方式，不如我们问问托马吧，他一定有很多点子。"
        },
        {
          "role": "派蒙",
          "text": "托马！托马！看这边！"
        },
        {
          "role": "托马",
          "text": "嘿，旅行者，派蒙！"
        },
        {
          "role": "托马",
          "text": "志愿者的工作很简单，主要是帮助祭典上需要帮助的人们。"
        },
        {
          "role": "托马",
          "text": "我会把我这里已经收到的工作请求分发给你们。"
        },
        {
          "role": "平泉",
          "text": "没想到这一次的容彩祭这么热闹…"
        },
        {
          "role": "石田",
          "text": "是志愿者吗？你们来的太及时了。"
        },
        {
          "role": "石田",
          "text": "想必两位已经看见了吧，我的摊位附近积了很多落叶灰尘。"
        },
        {
          "role": "石田",
          "text": "主要是因为这几天的客人太多了，好几次想去打扫一下却都没时间…"
        },
        {
          "role": "石田",
          "text": "能请你们帮忙清扫一下吗？实在感谢！"
        },
        {
          "role": "石田",
          "text": "这么快就清理完成了吗？真是麻烦你们了！"
        },
        {
          "role": "石田",
          "text": "你们这些志愿者真是热心肠，太感谢了。"
        },
        {
          "role": "鲸井小弟",
          "text": "大哥哥！快帮帮我！"
        },
        {
          "role": "派蒙",
          "text": "鲸井小弟居然也来逛祭典，我们现在可没空和你玩游戏噢！"
        },
        {
          "role": "鲸井小弟",
          "text": "不是游戏啦，我遇到麻烦了！"
        },
        {
          "role": "鲸井小弟",
          "text": "我本来听说祭典上会有新款式的手鞠卖，就想过来看看…"
        },
        {
          "role": "鲸井小弟",
          "text": "结果没有看见新手鞠，反而把自己的手鞠弄丢了…"
        },
        {
          "role": "鲸井小弟",
          "text": "呜呜呜，一定就在附近，刚刚还在的…"
        },
        {
          "role": "鲸井小弟",
          "text": "大哥哥！能帮我找一下吗？"
        },
        {
          "role": "派蒙",
          "text": "所以只要碰见你，无论如何都要找手鞠对吧…"
        },
        {
          "role": "石田",
          "text": "有你们帮忙真是太好了…"
        },
        {
          "role": "鲸井小弟",
          "text": "呜呜呜，我的手鞠在哪里…"
        },
        {
          "role": "鲸井小弟",
          "text": "太好了，这下以后又可以玩手鞠游戏了！"
        },
        {
          "role": "鲸井小弟",
          "text": "谢谢大哥哥！"
        },
        {
          "role": "平泉",
          "text": "你们是祭典的志愿者吧？"
        },
        {
          "role": "平泉",
          "text": "太好了，我正头疼这些货物要怎么办呢。最近实在是太忙了，港口的伙计们完全忙不过来。"
        },
        {
          "role": "平泉",
          "text": "但这些新鲜的豆乳得尽快送去仓库才行，否则放在外面，品质很快就会下降。"
        },
        {
          "role": "平泉",
          "text": "能帮忙把这些送去仓库吗？我的同事竹内在那里等着的，实在拜托了。"
        },
        {
          "role": "鲸井小弟",
          "text": "大哥哥，你们找到了我的手鞠吗？"
        },
        {
          "role": "竹内",
          "text": "哎呀，你们就是那些热心的志愿者吧。"
        },
        {
          "role": "竹内",
          "text": "瞧你们累的，快把货物放下，先好好休息会吧。"
        },
        {
          "role": "竹内",
          "text": "听说社奉行安排了远航之风，要给你们这些志愿者准备特别饮料作为感谢呢。"
        },
        {
          "role": "竹内",
          "text": "嘿嘿，其实这些豆乳，就是饮料的原材料之一哦，每天现做，绝对新鲜！"
        },
        {
          "role": "竹内",
          "text": "说起来，上一批加工好的豆乳，刚刚已经送去那边了，要不了多久，你们就可以一饱口福啦。"
        },
        {
          "role": "派蒙",
          "text": "欸？！远航之风的特别饮料里…有豆乳！"
        },
        {
          "role": "派蒙",
          "text": "一斗那个家伙不能喝豆制品的吧！"
        },
        {
          "role": "派蒙",
          "text": "我们得快点去远航之风等着他…"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈——！你们终于到了？本大爷已经提前很久就完成了哦。"
        },
        {
          "role": "荒泷一斗",
          "text": "就算是志愿者这种活，本大爷果然也是战无不胜啊哈哈哈哈！"
        },
        {
          "role": "荒泷一斗",
          "text": "旅行者，你输了哦。作为胜者的奖励，这杯特别饮料…"
        },
        {
          "role": "荒泷一斗",
          "text": "这杯远航之风与八重堂联名研发的、《拜托了我的狐仙宫司》里的无敌饮料！"
        },
        {
          "role": "荒泷一斗",
          "text": "本大爷就不客气地笑纳了！哈哈哈哈——！"
        },
        {
          "role": "荒泷一斗",
          "text": "饮料饮料，入我肚来！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "等等！有豆子！",
            "饮料里有豆子！"
          ]
        },
        {
          "type": "subtitle",
          "text": "咕嘟——嗨——一斗豪迈地举起饮料，一饮而尽。"
        },
        {
          "role": "荒泷一斗",
          "text": "呜哇哇哇哇嗷——好饮料！好饮料…"
        },
        {
          "role": "荒泷一斗",
          "text": "确实是好饮料…啧…就是怎么好像有点坏…"
        },
        {
          "role": "阿守",
          "text": "老大，他们说饮料里好像…"
        },
        {
          "role": "阿晃",
          "text": "好像有豆子！"
        },
        {
          "role": "荒泷一斗",
          "text": "哈？！"
        },
        {
          "type": "subtitle",
          "text": "一个豪迈的身影重重摔倒。"
        },
        {
          "role": "元太",
          "text": "老大倒了！老大倒了！"
        },
        {
          "role": "阿守",
          "text": "快！快送去医生那里！"
        },
        {
          "role": "托马",
          "text": "怎么回事，荒泷一斗不能喝豆制品？"
        },
        {
          "role": "阿晃",
          "text": "老大他豆子过敏！"
        },
        {
          "role": "托马",
          "text": "居然还有这种事…先不管了！快，你们带上荒泷一斗跟我来，我来安排医生，希望不是大问题。"
        },
        {
          "role": "托马",
          "text": "抱歉了，旅行者，没有考虑到这种事，真是我的疏忽。"
        },
        {
          "role": "托马",
          "text": "荒泷一斗就交给我吧，我保证会让他好好站起来。"
        },
        {
          "role": "托马",
          "text": "你放心吧，我们回头见。"
        },
        {
          "role": "卡琵莉亚",
          "text": "原来您的朋友豆子过敏，这种事虽然少见，但也确实听闻过。"
        },
        {
          "role": "卡琵莉亚",
          "text": "真抱歉小店的饮料造成了这种事情，实在有些过意不去。"
        },
        {
          "role": "卡琵莉亚",
          "text": "如果您不介意的话，希望您能收下这个。这是不含豆乳的特别饮料配方。"
        },
        {
          "role": "卡琵莉亚",
          "text": "看得出来，您的朋友很喜欢这款饮料，虽然去掉豆乳，口感会有一些变化，但相信更适合您的朋友。"
        },
        {
          "role": "卡琵莉亚",
          "text": "请一定要收下，这是小店的一点心意。"
        }
      ]
    }
  ]
}