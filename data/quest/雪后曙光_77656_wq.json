{
  "quest_id": 77656,
  "chapter_num": null,
  "chapter_title": "雪后曙光",
  "type": "wq",
  "route": "Daybreak After the Snow",
  "stories": [
    {
      "story_id": 77656,
      "title": "雪后曙光",
      "description": "在曙光车站，似乎有什么东西正等待着大家打理…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与阿罗夏对话"
        },
        {
          "role": "阿罗夏",
          "text": "柳明娜又跑去哪里玩了…"
        },
        {
          "role": "派蒙",
          "text": "哇…这个镇子感觉完全变了个样，好热闹呀。"
        },
        {
          "role": "派蒙",
          "text": "多了好多店铺…也来了好多人。"
        },
        {
          "role": "派蒙",
          "text": "唔…不知道沃雅妮莎她们在不在镇子上，这镇子也不小，怎么找她们呢…"
        },
        {
          "role": "柳明娜",
          "text": "汪！汪汪！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你好呀，你认识沃雅妮莎吗？",
            "你好呀，你认识奥黛塔吗？",
            "你好呀，你认识阿罗夏吗？"
          ]
        },
        {
          "role": "柳明娜",
          "text": "汪？汪汪汪…"
        },
        {
          "role": "派蒙",
          "text": "咦？这只小狗怎么一听见沃雅妮莎的名字，就一副很受不了的样子…"
        },
        {
          "role": "派蒙",
          "text": "对了，之前沃雅妮莎说，阿罗夏送了几只小狗过来护院…"
        },
        {
          "role": "派蒙",
          "text": "难道，这只小狗就是阿罗夏送来的？"
        },
        {
          "role": "柳明娜",
          "text": "汪！汪！"
        },
        {
          "role": "派蒙",
          "text": "它这是在…让我们跟上？走吧，旅行者，它也许要带我们去找阿罗夏呢。"
        },
        {
          "role": "沃雅妮莎",
          "text": "…你就贴嘛，哎呀你长得高，贴高点！"
        },
        {
          "role": "奥黛塔",
          "text": "…这里就好。"
        },
        {
          "role": "沃雅妮莎",
          "text": "哎，这么好看的贴纸，贴这里就看不见了啦。"
        },
        {
          "role": "沃雅妮莎",
          "text": "给我给我，阿罗夏的贴纸也给我，我一起贴上去。"
        },
        {
          "role": "沃雅妮莎",
          "text": "我要搬一把椅子过来，椅子…椅子…"
        },
        {
          "role": "柳明娜",
          "text": "汪！"
        },
        {
          "role": "阿罗夏",
          "text": "柳明娜？还有…呵，看来你确实等到旅行者了。"
        },
        {
          "role": "柳明娜",
          "text": "汪汪，汪！"
        },
        {
          "role": "沃雅妮莎",
          "text": "柳明娜真把旅行者带来了，真聪明，欸，这个给你吃。"
        },
        {
          "role": "柳明娜",
          "text": "汪汪！汪！"
        },
        {
          "role": "沃雅妮莎",
          "text": "嗯，很有活力嘛，等下排练的时候也要保持住喔。"
        },
        {
          "role": "柳明娜",
          "text": "汪？！汪汪——"
        },
        {
          "role": "沃雅妮莎",
          "text": "喂！怎么又跑了，我这不是在夸它吗…"
        },
        {
          "role": "阿罗夏",
          "text": "哈哈…可能柳明娜不太喜欢唱歌吧…"
        },
        {
          "role": "沃雅妮莎",
          "text": "这样啊…那它喜欢什么，跳舞？游泳？总不能又是打猎吧…"
        },
        {
          "role": "奥黛塔",
          "text": "它喜欢安静地和朋友待在一起。"
        },
        {
          "role": "沃雅妮莎",
          "text": "好吧，我确实不太懂怎么和小狗交朋友。"
        },
        {
          "role": "奥黛塔",
          "text": "你只是不懂怎么安静。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "看来，这里已经热闹起来了。",
            "小镇和车站都很漂亮，也很暖和。"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "嗯，那个炉子启动之后，能够提供稳定的暖源和能量。"
        },
        {
          "role": "阿罗夏",
          "text": "在一段时间里，这附近的人，应该都不用担心受冷了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "我也已经和认识的商人谈好了，他们会额外开一条商路通往这里。"
        },
        {
          "role": "沃雅妮莎",
          "text": "所以，镇子上的人基本上也不用担心缺乏生活必需品了。"
        },
        {
          "role": "奥黛塔",
          "text": "周围的匪徒和危险分子已经被扫除了。安全也不用担心。"
        },
        {
          "role": "旅行者",
          "text": "扫除他们的人…"
        },
        {
          "role": "奥黛塔",
          "text": "我顺手做的。主要是为了保障列车的通行安全。"
        },
        {
          "role": "派蒙",
          "text": "这么听起来，好像事情都搞定了呢，那你们现在是在…"
        },
        {
          "role": "沃雅妮莎",
          "text": "为这座餐厅举办最后的落成仪式！"
        },
        {
          "role": "奥黛塔",
          "text": "意思是，打扫。"
        },
        {
          "role": "阿罗夏",
          "text": "然后再…把这里想办法变成餐厅。沃雅妮莎大概是这个意思。"
        },
        {
          "role": "沃雅妮莎",
          "text": "哎呀，列车站旁边怎么能没有餐厅呢？「列车站美食」可是一种重要的美食种类啊。"
        },
        {
          "role": "阿罗夏",
          "text": "「列车站美食」…我只记得下车吃东西的时候，必须要时不时地看一眼列车动向，免得吃饱了肚子，却误了车…"
        },
        {
          "role": "奥黛塔",
          "text": "我一般不在车上吃。"
        },
        {
          "role": "沃雅妮莎",
          "text": "您谦虚了，亲爱的。您平时也不怎么吃。"
        },
        {
          "role": "沃雅妮莎",
          "text": "总而言之，我可不能浪费那一本好不容易买来的《列车站里的一百种美食》。"
        },
        {
          "role": "沃雅妮莎",
          "text": "平时没人吃我做的菜，现在可算有机会了，我绝对不会放过的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "沃雅妮莎平时会做菜么？",
            "一般用的食材是…"
          ]
        },
        {
          "role": "奥黛塔",
          "text": "……"
        },
        {
          "role": "阿罗夏",
          "text": "呃，旅行者，派蒙，关于这个…"
        },
        {
          "role": "沃雅妮莎",
          "text": "保密。等我研究好了，就请你们来吃，到时候一定要全部吃光喔。"
        },
        {
          "role": "沃雅妮莎",
          "text": "但在那之前，我们先把桌布铺好吧。"
        },
        {
          "role": "沃雅妮莎",
          "text": "旅行者，派蒙，你们愿意来帮忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "交给我吧。",
            "没问题。"
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！我就…飞上去打扫一下屋顶好了。"
        },
        {
          "role": "阿罗夏",
          "text": "桌椅应该都已经固定好了…嗯，很牢靠。"
        },
        {
          "role": "奥黛塔",
          "text": "这边的桌布就由我来铺吧。"
        },
        {
          "role": "沃雅妮莎",
          "text": "你订好了？我还准备自己去设计呢。"
        },
        {
          "role": "奥黛塔",
          "text": "那样的话，餐厅的色彩就太…复杂了。"
        },
        {
          "role": "奥黛塔",
          "text": "旅行者，麻烦搭把手。"
        },
        {
          "role": "沃雅妮莎",
          "text": "嘿…哟！又贴好了一张，奥黛塔，阿罗夏，还有旅行者和派蒙，你们要不要来试试？"
        },
        {
          "role": "沃雅妮莎",
          "text": "在至冬堡里，可找不到这种可以随意贴贴纸的机会。"
        },
        {
          "role": "奥黛塔",
          "text": "但你之前经常在门票后面贴贴纸。"
        },
        {
          "role": "沃雅妮莎",
          "text": "是啊，总要给幸运观众一点惊喜吧，下次你也试试？"
        },
        {
          "role": "奥黛塔",
          "text": "幸运观众会被吓到的。"
        },
        {
          "role": "沃雅妮莎",
          "text": "嗯…这样就打理得差不多了，来吧，进行最后一项仪式！"
        },
        {
          "role": "沃雅妮莎",
          "text": "我记得…让他们把招牌放在车厢旁边…啊，确实在，大家都出来吧。我们一起把它挂上去。"
        },
        {
          "role": "派蒙",
          "text": "这上面画着的…"
        },
        {
          "role": "沃雅妮莎",
          "text": "这是我，这是奥黛塔，这是阿罗夏，这可是我亲手画的，折腾了好几个晚上呢。"
        },
        {
          "role": "派蒙",
          "text": "噗，大家都好可爱喔。"
        },
        {
          "role": "阿罗夏",
          "text": "哈哈…图加林看了肯定会很高兴的。"
        },
        {
          "role": "奥黛塔",
          "text": "不出意外的形象。"
        },
        {
          "role": "沃雅妮莎",
          "text": "不然下次我画成舞鞋？"
        },
        {
          "role": "奥黛塔",
          "text": "舞鞋不能进锅，如果下次我们要一起开鞋店的话，可以。"
        },
        {
          "role": "旅行者",
          "text": "在叽叽喳喳的闹腾声里，大家一起合力把招牌挂了上去…"
        },
        {
          "role": "沃雅妮莎",
          "text": "呼啊…这样就好了，果然又气派又好看。"
        },
        {
          "role": "阿罗夏",
          "text": "大家过来喝点饮料吧，刚刚做好的。"
        },
        {
          "role": "派蒙",
          "text": "哇！我看看，旅行者也拿一杯吧。"
        },
        {
          "role": "沃雅妮莎",
          "text": "看起来还有模有样的呢，过几天再找几位店员，我们的「曙光餐厅」就可以正式开业了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "出于仪式感考虑，干脆给第一个来店里的客人免单吧。"
        },
        {
          "role": "沃雅妮莎",
          "text": "如果他不讨人喜欢，那免单的机会就留给下一个，就这样一直顺延…"
        },
        {
          "role": "米提亚",
          "text": "这里居然还有餐厅，正好正好，瓦列里总不能追到这里来吧…"
        },
        {
          "role": "米提亚",
          "text": "老板，给我来一份罐罐焖肉和一份红菜汤，还有一杯…"
        },
        {
          "role": "米提亚",
          "text": "咦？你们…这是…"
        },
        {
          "role": "奥黛塔",
          "text": "免单？"
        },
        {
          "role": "沃雅妮莎",
          "text": "等我考考他。"
        },
        {
          "role": "沃雅妮莎",
          "text": "欢迎光临，米提亚先生。"
        },
        {
          "role": "沃雅妮莎",
          "text": "在用餐之前，请您先回答我一个问题。"
        },
        {
          "role": "沃雅妮莎",
          "text": "我昨天演出的时候，演唱的是什么曲目呢？"
        },
        {
          "role": "米提亚",
          "text": "这真是巧了，沃雅妮莎小姐，没想到在这里也能遇见您…"
        },
        {
          "role": "沃雅妮莎",
          "text": "米提亚先生，我昨天演唱的曲目，是·什·么？"
        },
        {
          "role": "米提亚",
          "text": "您…您…嗨！您又在开玩笑了，昨天明明没有您的演出啊，哈哈哈…"
        },
        {
          "role": "沃雅妮莎",
          "text": "…哼。菜一会就来。"
        },
        {
          "role": "奥黛塔",
          "text": "……"
        }
      ]
    }
  ]
}