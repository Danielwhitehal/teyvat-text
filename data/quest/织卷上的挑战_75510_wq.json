  "stories": [
    {
      "story_id": 75510,
      "title": "织卷上的挑战",
      "description": "在「回声之子」领地附近，一位创作者正在向孩子们推荐她的新式游戏…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和维热对话"
        },
        {
          "role": "「小松果」",
          "text": "要我说，虽然「面具斗士」不能像「调停人」那样自由地飞来飞去，但只要找准机会，埋头冲刺，肯定能赢下对局！"
        },
        {
          "role": "「燃爆木头人」",
          "text": "呆子，不能太依赖直线行动的速度啊，转不过弯，撞不中，不就没有意义了嘛！"
        },
        {
          "role": "维热",
          "text": "好啦好啦，孩子们，可以认真讨论，但不能动气吵架哦。"
        },
        {
          "role": "「燃爆木头人」",
          "text": "没有啦，没有啦，我们只是…聊到强大的战士，都非常兴奋！"
        },
        {
          "role": "「小松果」",
          "text": "你可以放心的，维热姐姐！就算要比出个高低，我们也会讲道理，摆证据！"
        },
        {
          "role": "「燃爆木头人」",
          "text": "还有个方法——再来一局。"
        },
        {
          "role": "「小松果」",
          "text": "那就再来一局！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真热闹。",
              "dialogues": []
            },
            {
              "text": "发生什么了？",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "已完成魔神任务第五章第五幕「炽烈的还魂诗」"
        },
        {
          "role": "维热",
          "text": "新的客人，你好啊…"
        },
        {
          "role": "维热",
          "text": "等等，我好像在最近的织卷上见过你的画像，你是孩子们崇拜的「杜麦尼（希望）」！"
        },
        {
          "role": "维热",
          "text": "太好了，居然有幸遇见你…著名的「杜麦尼（希望）」，要不要来试试这个「互动织卷」？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「互动织卷」？",
              "dialogues": []
            },
            {
              "text": "会动的画卷？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维热",
          "text": "简单来说，就是结合了璃月剪纸戏、稻妻漫画和枫丹映影三种技术的幕布游戏。"
        },
        {
          "role": "维热",
          "text": "以本地著名的战士为原型，加入一些「跨界挑战」的设想，组合成新奇的故事。"
        },
        {
          "role": "维热",
          "text": "应该能为你带来有趣的体验，说不定，还能和你设想过的奇异挑战不谋而合！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我来试试看！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维热",
          "text": "好呀好呀，祝你玩得开心！如果有闲心，还请向我反馈意见哦~"
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务第五章第五幕「炽烈的还魂诗」"
        },
        {
          "role": "维热",
          "text": "新的客人，你好啊！"
        },
        {
          "role": "维热",
          "text": "看你的装束，应该是一位旅者吧？那我们是同行！"
        },
        {
          "role": "维热",
          "text": "要不要和孩子们一起，来试试我最近创作的这个「互动织卷」？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「互动织卷」？",
              "dialogues": []
            },
            {
              "text": "会动的画卷？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维热",
          "text": "简单来说，就是结合了璃月剪纸戏、稻妻漫画和枫丹映影三种技术的幕布游戏。"
        },
        {
          "role": "维热",
          "text": "以本地著名的战士为原型，加入一些「跨界挑战」的设想，组合成新奇的故事。"
        },
        {
          "role": "维热",
          "text": "说不定能给你带来非常新奇的体验呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我来试试看！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维热",
          "text": "好呀好呀，祝你玩得开心！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（维热）"
        },
        {
          "type": "subtitle",
          "text": "已完成魔神任务第五章第五幕「炽烈的还魂诗」"
        },
        {
          "role": "维热",
          "text": "尊敬的「杜麦尼（希望）」，享受游戏之余，也想和我聊聊天吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「互动织卷」…",
              "dialogues": [
                {
                  "role": "维热",
                  "text": "啊，你也对这个新兴的门类感兴趣吗？"
                },
                {
                  "role": "维热",
                  "text": "其实，许多画家和映影专业人士都在研究原理相似的作品。目的只有一个，让静止的画作动起来…"
                },
                {
                  "role": "维热",
                  "text": "要说我这边的特点，大概就是以纳塔的「漫画织卷」为题材，加入了富有讨论度的主题吧。"
                },
                {
                  "role": "维热",
                  "text": "而纳塔的「漫画织卷」本身又是本土故事与稻妻漫画的结合体，这样一来，我的作品就成了三个国家文化交融的产物…"
                },
                {
                  "role": "维热",
                  "text": "希望这样的作品能给大家带来笑容！"
                }
              ]
            },
            {
              "text": "关于你自己…",
              "dialogues": [
                {
                  "role": "维热",
                  "text": "我本人？很荣幸能得到英雄「杜麦尼（希望）」的关注…那我就简单说说我的经历吧。"
                },
                {
                  "role": "维热",
                  "text": "其实，我的主业是肖像画。我的家人自诩是「上流人士」，还在枫丹时，我经常为贵妇们画像。"
                },
                {
                  "role": "维热",
                  "text": "不过，几次前往灰河与乡野取材后，我接触到了许多热情而真诚的普通人。"
                },
                {
                  "role": "维热",
                  "text": "与讲究规矩，处处隐藏着规矩的所谓「上流社会」不同，他们有着一股自然、随性的亲和力。"
                },
                {
                  "role": "维热",
                  "text": "我想，为普通大众进行创作，也有着独一无二的快乐和意义。为此，我愿意拓展自己的舒适区，尝试许多新的作品形式。"
                },
                {
                  "role": "维热",
                  "text": "这次的「互动织卷」就是我的尝试之一，以后，我应该还会去其他国家学习不同形式的艺术。"
                }
              ]
            },
            {
              "text": "先不打扰了。",
              "dialogues": [
                {
                  "role": "维热",
                  "text": "嗯！我一直在这里陪着孩子们，要是你忙完了手头的要务，随时可以来找我们。"
                }
              ]
            }
          ]
        },
        {
