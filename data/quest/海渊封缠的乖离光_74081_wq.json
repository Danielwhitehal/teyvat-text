{
  "quest_id": 74081,
  "chapter_num": null,
  "chapter_title": "海渊封缠的乖离光",
  "type": "wq",
  "route": "Treacherous Light of the Depths",
  "stories": [
    {
      "story_id": 74081,
      "title": "海渊封缠的乖离光",
      "description": "在水下的神秘遗迹内遭遇了发出光线的神秘装置…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "哇…没想到水下居然有这么大的空间，还有奇怪的装置！"
        },
        {
          "role": "派蒙",
          "text": "不知道那个怪怪装置是做什么用的，但是这里看起来已经荒废很久了，也不像有人的样子…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们要小心一点！"
        },
        {
          "type": "subtitle",
          "text": "在遗迹内探索"
        },
        {
          "type": "subtitle",
          "text": "启动光学装置"
        },
        {
          "type": "subtitle",
          "text": "调查遗迹内的其他光学装置"
        },
        {
          "type": "subtitle",
          "text": "启动遗迹中央的光学装置"
        },
        {
          "type": "subtitle",
          "text": "击败发条机关"
        },
        {
          "type": "subtitle",
          "text": "继续向前探索"
        },
        {
          "type": "subtitle",
          "text": "调查神秘房间"
        },
        {
          "type": "subtitle",
          "text": "击败发条机关"
        },
        {
          "type": "subtitle",
          "text": "与研究员对话"
        },
        {
          "role": "瑟维妮",
          "text": "又是震动又是打斗声，还以为是伊斯丁豪斯先生回来了呢，原来是有人误启动了外面的装置…"
        },
        {
          "role": "瑟维妮",
          "text": "哎呀哎呀，梅雅德前辈的试验机…怎么会搞成这副模样。"
        },
        {
          "type": "subtitle",
          "text": "与研究员对话"
        },
        {
          "role": "派蒙",
          "text": "呃…我们、我们该不会闯大祸了吧？"
        },
        {
          "role": "瑟维妮",
          "text": "真奇怪，刚才感到一阵晃动…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也感觉到了。",
              "dialogues": []
            },
            {
              "text": "是你的错觉吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔，可能是因为我们刚才动了上层的装置…"
        },
        {
          "role": "瑟维妮",
          "text": "这里的门原本是锁上的吧？还特意放了一些发条机关在门口看守…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我请它们休息之后把门打开了。",
              "dialogues": []
            },
            {
              "text": "是啊，真奇怪，门怎么打开了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这、这也没办法嘛，是它们先攻击我们的，我们这算是正当防卫？"
        },
        {
          "role": "瑟维妮",
          "text": "梅雅德前辈的试验机…原本应该是停机状态吧。毕竟前辈自从在伊黎耶岛觅得了一块好场地，就几乎不回来了。"
        },
        {
          "role": "瑟维妮",
          "text": "想想也是，如果能在花园舞池那样风景优美的地方向众人展示研究成果，又有谁会愿意回到这种阴湿破败的研究室来呢。"
        },
        {
          "role": "瑟维妮",
          "text": "博絮埃先生卸任之后，大家就像这里的资材一样四散去了枫丹科学院的各处，就连沙发也没留下一个。"
        },
        {
          "role": "瑟维妮",
          "text": "只有试验机还留在这里，等那些不会回来的人。原本只是站在这里待机，对它们来说应该也不算什么吧，不过现在可好了。"
        },
        {
          "role": "瑟维妮",
          "text": "瞧瞧，给打得七零八落，发条都快掉出来啦。要是梅雅德前辈知道了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是我干的，对不起。",
              "dialogues": []
            },
            {
              "text": "有考虑对试验机的强度进行升级吗？",
              "dialogues": [
                {
                  "role": "瑟维妮",
                  "text": "梅雅德前辈的确这样做了。或许最终的成品能够符合你对强度的预期。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对不起…这、这个试验机很贵吗？如果要赔偿的话…"
        },
        {
          "role": "瑟维妮",
          "text": "不用紧张。我是想说，梅雅德前辈要是知道了，一定会笑出声的。"
        },
        {
          "role": "瑟维妮",
          "text": "毕竟他自己以前就常主动打断试验机的舞蹈，被打倒后又坐在原地哈哈大笑。"
        },
        {
          "role": "瑟维妮",
          "text": "对了，说了这么久，还没自我介绍呢。我是枫丹科学院的研究员，你们可以叫我瑟维妮。两位是？"
        },
        {
          "role": "派蒙",
          "text": "我是派蒙，他是旅行者，我们是…呃…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只是路过而已，绝对没有别的意思。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对！我们只是路过而已，绝对不是以为这里有什么宝藏所以才…"
                }
              ]
            },
            {
              "text": "请问这里有宝藏吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑟维妮",
          "text": "哦，你们是说会安排一些寻宝环节的废墟旅游？那你们可找错地方了，这里虽然看起来像废墟…不，实际上也是废墟吧。"
        },
        {
          "role": "瑟维妮",
          "text": "但是这里还没有被纳入废墟旅游的推荐地点哦。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那我们现在就走…"
        },
        {
          "role": "瑟维妮",
          "text": "…等等，你们知道新枫丹科学院吧？要走的话正好帮我一个忙，去新枫丹科学院找到希塞蕾前辈…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可是我们不去新枫丹科学院。",
              "dialogues": []
            },
            {
              "text": "我们还有别的宝藏要找。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑟维妮",
          "text": "这可怎么办呢，我还有工作没处理完，梅雅德前辈的试验机又被打坏了，需要尽快找人回收…"
        },
        {
          "role": "派蒙",
          "text": "唔唔…旅行者，不然我们还是帮她这个忙吧…"
        },
        {
          "role": "瑟维妮",
          "text": "太好了！既然你们同意帮忙捎话，那回收打孔纸带的工作也拜托你们好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "早知道不乱动外边的装置了…",
              "dialogues": [
                {
                  "role": "瑟维妮",
                  "text": "别这么说嘛，反正不是什么难事。"
                }
              ]
            },
            {
              "text": "没问题，交给我吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑟维妮",
          "text": "有了帮忙回收研究资料的名头，委托的报酬就可以报销了。"
        },
        {
          "role": "派蒙",
          "text": "欸？这么做真的没问题吗？"
        },
        {
          "role": "瑟维妮",
          "text": "毕竟确实协助了研究工作，名正言顺，当然没问题啦。"
        },
        {
          "role": "瑟维妮",
          "text": "而且如果真的不合规的话，会被事务员驳回的。那时就只好我自行承担委托的费用了。"
        },
        {
          "role": "旅行者",
          "text": "你们经常做这种事吗？"
        },
        {
          "role": "瑟维妮",
          "text": "我本人是没有啦。其他人的话我就不知道了，以前确实听过一些传闻，不过…哎呀，这也不是值得和外人讲的消息。"
        },
        {
          "role": "瑟维妮",
          "text": "要回收的打孔纸带有三份。应该说，书架上只有三份打孔纸带了。应该很容易就能找到的，就麻烦两位了。"
        },
        {
          "role": "瑟维妮",
          "text": "在此期间，我得再检查一下试验机，毕竟很久都没人维护过它们了…如果失控了就不好了。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那我们回收完打孔纸带再来找你确认。"
        },
        {
          "role": "奇怪的发条机关",
          "text": "（发条机关没有动作，好像在等待指令。）"
        },
        {
          "role": "奇怪的发条机关",
          "text": "（发条机关没有动作，好像在等待指令。）"
        },
        {
          "type": "subtitle",
          "text": "回收打孔纸带"
        },
        {
          "type": "subtitle",
          "text": "与瑟维妮对话"
        },
        {
          "role": "派蒙",
          "text": "要回收的就是这些打孔纸带对吧？"
        },
        {
          "role": "？？？",
          "text": "向瑟维妮出示了回收的打孔纸带…"
        },
        {
          "role": "瑟维妮",
          "text": "没错，就是这些。你们办事可真干练，一点也不拖泥带水。"
        },
        {
          "role": "派蒙",
          "text": "这么简单的工作，当然是咻咻地就完成啦。"
        },
        {
          "role": "瑟维妮",
          "text": "那也很了不起了。毫不夸张地说，有些同事真的会花费整整一天的时间，就为了找到一份材料…"
        },
        {
          "role": "瑟维妮",
          "text": "不说这些了。这些打孔纸带就麻烦两位送回给希塞蕾前辈了。"
        },
        {
          "role": "瑟维妮",
          "text": "告诉她我暂时还不会回去。哦，还有，请她联系梅雅德前辈尽快回收这里的试验机。"
        },
        {
          "role": "派蒙",
          "text": "好哦。那旅行者，我们原路返回？"
        },
        {
          "role": "瑟维妮",
          "text": "啊，那倒不必了。"
        },
        {
          "role": "瑟维妮",
          "text": "两位应该能够潜水吧？其实这边有条水路应该可以出去，之前为了防止踩空暂时封上了，我来帮你们打开通路。"
        },
        {
          "role": "派蒙",
          "text": "那太好了！旅行者，我们就从水路回去吧！"
        },
        {
          "role": "瑟维妮",
          "text": "打开通路的终端在里间，我去就好了。你们自行离开应该没问题吧？不会迷路吧？"
        },
        {
          "role": "派蒙",
          "text": "那你就太小瞧我们了！我可是提瓦特最好的向导，有我在，旅行者怎么会迷路呢？"
        },
        {
          "role": "瑟维妮",
          "text": "真可靠呀。那捎信和打孔纸带的事就拜托两位了，我就不远送了。"
        },
        {
          "type": "subtitle",
          "text": "通过水路离开房间"
        },
        {
          "type": "subtitle",
          "text": "通过水路离开"
        },
        {
          "type": "subtitle",
          "text": "前往新枫丹科学院"
        },
        {
          "type": "subtitle",
          "text": "找到希塞蕾并传达消息"
        },
        {
          "role": "派蒙",
          "text": "你好！关于瑟维妮小姐…"
        },
        {
          "role": "？？？",
          "text": "向希塞蕾说明了情况，并交付了回收的三份打孔纸带…"
        },
        {
          "role": "希塞蕾",
          "text": "我正担心她，在考虑要不要去看看她的情况呢，原来发生了这样的事。谢谢你们带回了她的消息…还有打孔纸带。"
        },
        {
          "role": "希塞蕾",
          "text": "没想到梅雅德的试验机居然还能运作，瑟维妮居然在这样危险的环境中继续工作，我得去找事务员商量回收事宜了。"
        },
        {
          "role": "希塞蕾",
          "text": "正好也可以打听一下报销的问题…还是瑟维妮脑子灵光。不过是否合规还得看事务员的判断，所以费用暂且由我垫付吧。"
        },
        {
          "role": "希塞蕾",
          "text": "不管怎么说，感谢你们的协助，完成委托的报酬还请两位收好。"
        },
        {
          "role": "派蒙",
          "text": "这里也有房间？好神秘哦，搞不好我们闯进了什么怪人的秘密实验室呢！"
        },
        {
          "role": "瑟维妮",
          "text": "打孔纸带放在里间的书架上了，你们找找看吧。其他的研究资料就…"
        },
        {
          "role": "瑟维妮",
          "text": "看看应该也没问题吧？反正没什么机密信息…"
        },
        {
          "role": "瑟维妮",
          "text": "打孔纸带应该就在书架上，你们找找看吧。其他的研究资料就…"
        },
        {
          "role": "瑟维妮",
          "text": "看看应该也没问题吧？反正没什么机密信息…"
        }
      ]
    }
  ]
}