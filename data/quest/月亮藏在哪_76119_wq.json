{
  "quest_id": 76119,
  "chapter_num": null,
  "chapter_title": "月亮藏在哪",
  "type": "wq",
  "route": "Where Does the Moon Hide?",
  "stories": [
    {
      "story_id": 76119,
      "title": "月亮藏在哪",
      "description": "在「银月之庭」，哥伦比娅似乎在和月灵玩耍…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同哥伦比娅见面"
        },
        {
          "role": "哥伦比娅",
          "text": "…这里吗？"
        },
        {
          "role": "月灵",
          "text": "~！"
        },
        {
          "role": "哥伦比娅",
          "text": "…哈。"
        },
        {
          "role": "派蒙",
          "text": "她们好像玩得很开心。"
        },
        {
          "role": "哥伦比娅",
          "text": "你们好。"
        },
        {
          "role": "努昂诺塔",
          "text": "！！"
        },
        {
          "role": "哥伦比娅",
          "text": "你也好，努昂诺塔。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是在玩新游戏吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，我在「旗舰」见到有人用杯子和朋友这样玩，就学来了。"
        },
        {
          "role": "哥伦比娅",
          "text": "他们把宝石扣进杯子里，在桌面上快速转动杯子。"
        },
        {
          "role": "哥伦比娅",
          "text": "等停下后，让对方猜测宝石究竟停留在哪个杯子里。"
        },
        {
          "role": "哥伦比娅",
          "text": "月灵们喜欢钻在布里转来转去的感觉，所以我以魔女小姐的帽子为原型，做了些改良。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很可爱。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "月灵",
          "text": "~！"
        },
        {
          "role": "派蒙",
          "text": "但话说回来你都去过「旗舰」了呀，有被人认出来吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "有人问起。我就说「我在扮演月神大人，很像吧？」。"
        },
        {
          "role": "派蒙",
          "text": "祈月之夜时的那招还真给你学会了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那些人会信吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "唔…好像半信半疑。但也没再多和我搭话了。"
        },
        {
          "role": "哥伦比娅",
          "text": "是我表演得不自然吗？下次再去其他地方多试几次。"
        },
        {
          "role": "派蒙",
          "text": "怎么听着是学坏了…"
        },
        {
          "role": "努昂诺塔",
          "text": "！！"
        },
        {
          "role": "哥伦比娅",
          "text": "努昂诺塔想邀请你来猜它躲在哪里，要和它玩一局吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好呀。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "请按「旗舰」的规矩，付十万摩拉作为押金。"
        },
        {
          "role": "派蒙",
          "text": "这部分就不用学了吧！"
        },
        {
          "type": "subtitle",
          "text": "同努昂诺塔玩耍，猜猜它藏在哪里"
        },
        {
          "role": "哥伦比娅",
          "text": "要开始了。"
        },
        {
          "role": "哥伦比娅",
          "text": "转起来吧。"
        },
        {
          "role": "哥伦比娅",
          "text": "猜猜看努昂诺塔在哪里呢？"
        },
        {
          "type": "subtitle",
          "text": "选对了"
        },
        {
          "role": "哥伦比娅",
          "text": "答对了。"
        },
        {
          "type": "subtitle",
          "text": "选错了"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，这次猜错了。"
        },
        {
          "type": "subtitle",
          "text": "使用元素视野"
        },
        {
          "role": "哥伦比娅",
          "text": "哈…"
        },
        {
          "type": "subtitle",
          "text": "使用元素视野，选择异样的帽子"
        },
        {
          "role": "哥伦比娅",
          "text": "作弊的是坏孩子。"
        },
        {
          "type": "subtitle",
          "text": "同哥伦比娅对话"
        },
        {
          "role": "努昂诺塔",
          "text": "……！"
        },
        {
          "type": "subtitle",
          "text": "选择正确"
        },
        {
          "role": "哥伦比娅",
          "text": "对你来说，是不是太简单了？"
        },
        {
          "role": "哥伦比娅",
          "text": "如果下次再玩的话，我会试着让帽子们转得更快一点。"
        },
        {
          "type": "subtitle",
          "text": "选择错误"
        },
        {
          "role": "哥伦比娅",
          "text": "很可惜，下次再挑战了试试吧。"
        },
        {
          "role": "派蒙",
          "text": "我有一个疑问！所以哥伦比娅刚才是怎么跟它们玩的呢？"
        },
        {
          "role": "派蒙",
          "text": "不用月矩力的话就什么都看不见，用了的话未免又看得太清楚…"
        },
        {
          "role": "哥伦比娅",
          "text": "我可以睁开眼睛呀。"
        },
        {
          "role": "派蒙",
          "text": "呃，这是我的盲点…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（哥伦比娅）"
        },
        {
          "role": "哥伦比娅",
          "text": "努昂诺塔说它很开心，下次再一起玩吧。"
        }
      ],
      "collapse_ranges": [
        [
          50,
          51
        ]
      ]
    }
  ]
}