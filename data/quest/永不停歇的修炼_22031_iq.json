{
  "quest_id": 22031,
  "chapter_num": null,
  "chapter_title": "永不停歇的修炼",
  "type": "iq",
  "route": "Ceaseless Training",
  "stories": [
    {
      "story_id": 22031,
      "title": "永不停歇的修炼",
      "description": "已经夺回武器的朝仓，似乎仍然在找人帮他锻炼武艺…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "找到发布委托的朝仓"
        },
        {
          "role": "朝仓",
          "text": "枪扎一线...喝！"
        },
        {
          "role": "旅行者",
          "text": "我来和你对练了。"
        },
        {
          "role": "朝仓",
          "text": "噢！是您啊阁下，您又接下我的委托了吗？非常感谢！"
        },
        {
          "role": "朝仓",
          "text": "您这样武艺高强的人愿意和我对练，实在是太好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "枪法比之前进步不少啊。",
              "dialogues": [
                {
                  "role": "朝仓",
                  "text": "哈哈…您可不要再调侃我了。"
                },
                {
                  "role": "朝仓",
                  "text": "我听说，枪这种武器被发明的目的之一，就是让我这种不怎么精通武艺的人也能拿着它战斗。"
                },
                {
                  "role": "朝仓",
                  "text": "毕竟这种武器又长又尖，就算是拿着的人不懂枪法，只是单纯地戳刺和挥舞，看起来都很有气势。"
                },
                {
                  "role": "朝仓",
                  "text": "不过，按这种原则…其实我感觉那种前面有三个尖的草叉更有威力…"
                }
              ]
            },
            {
              "text": "你不是已经拿回武器了么？",
              "dialogues": [
                {
                  "role": "朝仓",
                  "text": "武器虽然已经拿回来了，但并不能代表修炼就到此为止了。"
                },
                {
                  "role": "朝仓",
                  "text": "曾经会遇见海乱鬼这种家伙，未来很难说不会遇见更强大的敌人。"
                },
                {
                  "role": "朝仓",
                  "text": "绝不允许我的武器再次落入敌手，绝不允许武士荣耀再次受人践踏，这就是我追求的武士之道。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与朝仓对话"
        },
        {
          "role": "朝仓",
          "text": "哎呀，闲话就不说了，我可不能浪费您的时间。"
        },
        {
          "role": "旅行者",
          "text": "好，那我们开始吧。"
        },
        {
          "role": "朝仓",
          "text": "没问题，您多小心了。"
        },
        {
          "type": "subtitle",
          "text": "完成与朝仓的对练"
        },
        {
          "role": "朝仓",
          "text": "您刚才似乎走神了？步伐很混乱，攻击时的力道也时强时弱…"
        },
        {
          "role": "朝仓",
          "text": "这样可不行啊，请您再准备准备，我们等会再来一次吧。"
        },
        {
          "type": "subtitle",
          "text": "与朝仓对话"
        },
        {
          "role": "朝仓",
          "text": "呼、呼…阁下的武艺真是远超于我…"
        },
        {
          "role": "旅行者",
          "text": "我下次轻点…"
        },
        {
          "role": "朝仓",
          "text": "不！请阁下还是使出全力吧，不经历磨砺，我就不会成长。"
        },
        {
          "role": "朝仓",
          "text": "您之所以如此强大，应该也是经历了无数锻炼吧…"
        },
        {
          "role": "朝仓",
          "text": "恕我唐突，我真的很好奇，您是…怎么锻炼自己的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有一只巨龙帮我训练飞行。",
              "dialogues": [
                {
                  "role": "朝仓",
                  "text": "居、居然能和巨龙一起飞行，真是难以想象…"
                }
              ]
            },
            {
              "text": "有一匹巨狼帮我磨砺武艺。",
              "dialogues": [
                {
                  "role": "朝仓",
                  "text": "听起来真是…勇武无匹。真想见识一下您和那匹巨狼战斗的场景啊…"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "就是…顺便而已。"
        },
        {
          "role": "朝仓",
          "text": "哈哈哈，是这样吗？那您可绝对算得上是天赋异禀了。"
        },
        {
          "role": "朝仓",
          "text": "谢谢您和我对练，这场比试，在下铭记在心。这些报酬，请您收下吧。"
        }
      ]
    }
  ]
}