{
  "quest_id": 72658,
  "chapter_num": null,
  "chapter_title": "梦里生花",
  "type": "wq",
  "route": "Dreams of Bloom",
  "stories": [
    {
      "story_id": 72658,
      "title": "梦里生花",
      "description": "花匠咲耶似乎正为了某事而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与咲耶对话"
        },
        {
          "role": "咲耶",
          "text": "你好！想要试试亲手种植一盆花吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么种花？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "咲耶",
          "text": "哦，你有兴趣吗？不了解也没关系，我来和你简单说明一下。"
        },
        {
          "role": "咲耶",
          "text": "我是咲耶，是一个种花的花匠，同时也做一些和花有关的生意。"
        },
        {
          "role": "咲耶",
          "text": "哈哈哈，虽然说是生意，但其实大部分时候都是帮人送花，或者是帮哪家店制作「插花」啦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "插花是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "咲耶",
          "text": "咦？你不知道吗？「插花」在稻妻可是一项很重要的事情喔。"
        },
        {
          "role": "咲耶",
          "text": "虽然简单来说，「插花」就是将花卉和其他植物仔细裁剪处理后，以一个合适的方式摆放起来…"
        },
        {
          "role": "咲耶",
          "text": "但在具体制作上…剪裁花卉和植物时，需要细细地把握植物的状态，细心地为植物修剪掉不体面的地方…"
        },
        {
          "role": "咲耶",
          "text": "摆放时，又要根据具体的场景氛围来调整摆放的方式。有时候，甚至要细致到每一支花卉向外延伸的角度…"
        },
        {
          "role": "咲耶",
          "text": "这些细节，每个都需要细心考究，实在是…繁琐到了极点。"
        },
        {
          "role": "咲耶",
          "text": "就算是对我这个喜爱插花的人来说，这项工作也够让我疲惫的了…"
        },
        {
          "role": "咲耶",
          "text": "之前我在城里还有个店面，但街上实在太吵，我根本没法静下心来插花。"
        },
        {
          "role": "咲耶",
          "text": "所以我就关了店面，只在我的花田旁边接待客人。"
        },
        {
          "role": "咲耶",
          "text": "但是…虽然店里是清净了，但生意也少了一些…"
        },
        {
          "role": "咲耶",
          "text": "所以我特意设计了一个推广计划，来城里宣传一下我的「咲耶花屋」。"
        },
        {
          "role": "咲耶",
          "text": "我把这个计划叫做…「梦里生花」！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这计划具体是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "咲耶",
          "text": "具体来说，就是一个让顾客们亲手种出花，然后亲手制作插花的活动喔。"
        },
        {
          "role": "咲耶",
          "text": "如果你有兴趣，想要体验一下的话，就和我说一声吧。无论是种花和插花，都是很有趣的喔。"
        }
      ]
    }
  ]
}