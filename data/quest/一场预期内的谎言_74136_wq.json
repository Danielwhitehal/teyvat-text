{
  "quest_id": 74136,
  "chapter_num": null,
  "chapter_title": "一场预期内的谎言",
  "type": "wq",
  "route": "An Expected Lie",
  "stories": [
    {
      "story_id": 74136,
      "title": "一场预期内的谎言",
      "description": "接收这一批货物的人，居然是早已「死亡」的艾德温。 虽然他的精神状况似乎有些堪忧，还一直重复着「五」这个数字…但他似乎暗中指出了纳克目前所在的地点。 这位「死而复生」的研究员究竟想要做什么？但无论如何，抓住纳克才是现在的重中之重…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往纳克的藏身之处"
        },
        {
          "type": "subtitle",
          "text": "前往纳克的藏身之处"
        },
        {
          "type": "subtitle",
          "text": "打开密闭门"
        },
        {
          "type": "subtitle",
          "text": "继续寻找纳克"
        },
        {
          "type": "subtitle",
          "text": "与肖西韦尔对话"
        },
        {
          "role": "派蒙",
          "text": "原来他之前一直重复着「五」，是为了告诉我们解谜的方式啊…"
        },
        {
          "role": "派蒙",
          "text": "明明直接告诉我们就好了，为什么要这么别扭呢？"
        },
        {
          "role": "肖西韦尔",
          "text": "哼，谁知道这家伙在打什么鬼主意…不过，他好像一直在引着我们去找纳克。"
        },
        {
          "role": "肖西韦尔",
          "text": "这些潜水服，就放在那间屋子旁边，简直就像是专门为我们准备的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看来，是他找到了我们。",
              "dialogues": []
            },
            {
              "text": "无论如何，先处理纳克。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲希里耶",
          "text": "没有研究价值…我…我花了那么多心思…"
        },
        {
          "role": "派蒙",
          "text": "菲希里耶小姐…碎碎念了一路呢…"
        },
        {
          "role": "派蒙",
          "text": "不过…旅行者，你有没有一种被人盯着的感觉？我、我总觉得背后毛毛的…"
        },
        {
          "role": "肖西韦尔",
          "text": "…我走第一个，继续往里面探一探吧。"
        },
        {
          "type": "subtitle",
          "text": "继续寻找纳克"
        },
        {
          "type": "subtitle",
          "text": "与肖西韦尔对话"
        },
        {
          "role": "派蒙",
          "text": "好大一片空地，里面…什么也没有。我们不会扑了个空吧？"
        },
        {
          "role": "肖西韦尔",
          "text": "这周围的植物被特意清理过，修剪的痕迹还很新。"
        },
        {
          "role": "菲希里耶",
          "text": "…亏我还专门为他趟这摊浑水…"
        },
        {
          "role": "肖西韦尔",
          "text": "总之，我先一个人下去看看，你们陪着科学院小姐，如果情势太坏…就赶紧带她走。"
        },
        {
          "role": "肖西韦尔",
          "text": "但这里什么东西也没有，情势再坏应该也坏不到哪里…"
        },
        {
          "role": "肖西韦尔",
          "text": "吱——嘎嘎——"
        },
        {
          "role": "派蒙",
          "text": "呜哇！小心那边！有东西冲过来了！"
        },
        {
          "type": "subtitle",
          "text": "打倒来袭的机关"
        },
        {
          "type": "subtitle",
          "text": "击败纳克"
        },
        {
          "type": "subtitle",
          "text": "与纳克对话"
        },
        {
          "role": "纳克",
          "text": "科学院的走狗！舒瓦瑟尔和雷蒙多给了你们多少钱！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就给了一个头衔。",
              "dialogues": []
            },
            {
              "text": "一分钱也没给，我义务劳动。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "纳克",
          "text": "你…你…听我的，放开我，我的这台「场力发生装置」已经快完成了。"
        },
        {
          "role": "纳克",
          "text": "只要我能把始基动能核心和它联调成功，那…那我就是最伟大的动能工程师！"
        },
        {
          "role": "菲希里耶",
          "text": "…拿着别人的成果，还要成为最伟大的工程师。真是够无耻的。"
        },
        {
          "role": "菲希里耶",
          "text": "我总算知道，为什么当初艾德温前…先生，一直不愿意让你参与核心研究了。"
        },
        {
          "role": "纳克",
          "text": "艾德温根本不明白这东西的用处！你也是科学院的人…你知道这东西的价值。"
        },
        {
          "role": "纳克",
          "text": "帮帮我，我可以…可以和你一起开发，到时候，没有人能比我们的名气更高！"
        },
        {
          "role": "纳克",
          "text": "什么艾德温、雷蒙多、舒瓦瑟尔…没人能再压我们一头！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看来，雷蒙多的话是真的。",
              "dialogues": []
            },
            {
              "text": "之前忍得很辛苦吧，纳克先生。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲希里耶",
          "text": "艾德温…先生的成果，属于科学院。我只是前来回收，其余的事…我没兴趣。"
        },
        {
          "role": "派蒙",
          "text": "菲希里耶小姐…对艾德温的称呼突然变了…"
        },
        {
          "role": "纳克",
          "text": "别犯蠢了！小姑娘，你不知道孔锡尼先生能给我们多大的好处！"
        },
        {
          "role": "纳克",
          "text": "这些好处，就算给艾德温跑腿一万年也拿不到！艾德温和科学院只是想利用我们…我们必须要为自己想想！"
        },
        {
          "role": "菲希里耶",
          "text": "……"
        },
        {
          "role": "肖西韦尔",
          "text": "好，废话结束。你，闭上嘴。"
        },
        {
          "role": "纳克",
          "text": "你又是谁！"
        },
        {
          "role": "肖西韦尔",
          "text": "罩着柔灯港这块的人的，你再多说一句，就要吃拳头了。"
        },
        {
          "role": "肖西韦尔",
          "text": "旅行者，帮我捆上他，带上这什么心，我们该回去交差了。"
        },
        {
          "type": "subtitle",
          "text": "回去与勒马克汇合"
        },
        {
          "role": "纳克",
          "text": "艾德温…我就知道！是你把他们引过去…你嫉妒我！担心我的研究成果超越你！"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "是啊，我真嫉妒你这副无知又不自知的样子，怪不得你之前在科学院里活得那么好。"
        },
        {
          "role": "派蒙",
          "text": "要是舒瓦瑟尔看见这个场景，一定会昏过去吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他最好别醒过来。",
              "dialogues": []
            },
            {
              "text": "我也快要昏过去了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "你就跟着他们回科学院认错吧，我要继续去研究了…你没弄坏我的研究设备吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谁让你回去研究了？！",
              "dialogues": []
            },
            {
              "text": "你给我站住，站好了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "你们还要做什么？难道要把我抓回科学院，那样我还怎么进行研究？"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "雷蒙多那个蠢货一定把科学院里变得一团糟，还有舒瓦瑟尔那个白痴，哎哟…想想都头疼。"
        },
        {
          "role": "派蒙",
          "text": "把科学院变得一团糟的人就是你啊！别推卸责任！"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "我？好吧，现在科学院把中央实验室爆炸的责任全甩在我头上了，对吧？我当时都不在科学院里！"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "科学院里的蠢货太多了，就连倒杯咖啡都可能让研究设备停机，弄出一场爆炸也不奇怪。"
        },
        {
          "role": "旅行者",
          "text": "那你为什么不解释清楚？"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "解释？我才不给他们做替罪羊呢。我还有很多研究要做，绝不能浪费时间。"
        },
        {
          "role": "肖西韦尔",
          "text": "所以，你就和那个叫做孔锡尼的人搅在一起了？"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "喔，孔锡尼也好不到哪去…他连一台精密装置都买不到，全都要我自己亲手做。好在他愿意出钱，我的研究还算顺利…"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "但没想到，亲爱的纳克先生抱着那台连功能都不完整的核心原型机来了。"
        },
        {
          "role": "纳克",
          "text": "我已经改造过它了！我用的技术，你绝对开发不出来！"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "哈、哈、哈。纳克先生，现在没有孔锡尼需要你讨好，别骗自己了。你连一点研究员的自尊也没有吗？"
        },
        {
          "role": "纳克",
          "text": "你…！那些不完整的功能，只是因为你不知道如何弥补！我知道，我能做到！"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "是啊，现在你就拿着这台垃圾回科学院继续刨食吧，我有更重要的事要忙。那个叫菲什么的…这件事交给你了。"
        },
        {
          "role": "派蒙",
          "text": "这两个人怎么自顾自地吵个不停…"
        },
        {
          "role": "菲希里耶",
          "text": "…够了。"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "干什么，能不能别浪费我的时间了，我还要继续工作！"
        },
        {
          "role": "菲希里耶",
          "text": "我说…够了！"
        },
        {
          "role": "菲希里耶",
          "text": "艾德温·伊斯丁豪斯！你，是科学院爆炸的元凶！"
        },
        {
          "role": "菲希里耶",
          "text": "纳克！你，盗窃了科学院资产！"
        },
        {
          "role": "旅行者",
          "text": "还让科学院又爆炸了一次。"
        },
        {
          "role": "菲希里耶",
          "text": "你们伤害了科学院的利益…作为枫丹科学院特别调查员，我将把你们全部带回科学院，等待进一步处置！"
        },
        {
          "role": "纳克",
          "text": "可恶…"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "喔，拜托…"
        },
        {
          "role": "肖西韦尔",
          "text": "我和勒马克会帮忙押送这两个人的。忙前忙后了这么久…科学院总该给我们点报酬吧。"
        },
        {
          "role": "肖西韦尔",
          "text": "记住，在路上的时候把嘴闭紧点。不然你们就要提前到达终点了。"
        },
        {
          "type": "subtitle",
          "text": "向枫丹科学院回报"
        },
        {
          "role": "舒瓦瑟尔",
          "text": "菲希里耶小姐！旅行者，你们回来了！事情一定都办妥…"
        },
        {
          "role": "舒瓦瑟尔",
          "text": "喔，不…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！舒瓦瑟尔先生真的要昏过去啦！"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "没想到你又回科学院了，舒瓦瑟尔。我还以为你这辈子就只能和公章打交道了。"
        },
        {
          "role": "舒瓦瑟尔",
          "text": "这…这不可能！天哪！"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "雷蒙多，接任我工作的感觉如何，有什么值得向我汇报的工作吗？"
        },
        {
          "role": "雷蒙多",
          "text": "…真是一场美妙的再会啊，艾德温先生。"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "哈！瞧瞧这周围，你确实很适合做打扫工作。"
        },
        {
          "role": "纳克",
          "text": "…哼。他打扫得也不干净。"
        },
        {
          "role": "旅行者",
          "text": "主要是没把你打扫出去。"
        },
        {
          "role": "雷蒙多",
          "text": "非常感谢你们将这两个人带回来，荣誉高级研究员旅行者，还有菲希里耶小姐。"
        },
        {
          "role": "雷蒙多",
          "text": "枫丹科学院的霉运和动乱，将在今天彻底画上休止符。"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "哈哈哈，好啊，枫丹科学院将陷入一片死气沉沉的寂静，从此再无灵感跃动。"
        },
        {
          "role": "雷蒙多",
          "text": "你已经带着枫丹科学院内所有的灵感跃动得够精彩了，也该让一切平静下来了。"
        },
        {
          "role": "艾德温·伊斯丁豪斯",
          "text": "雷蒙多·哈文博特，你根本就不懂研究，领导不了枫丹动能工程科学院。"
        },
        {
          "role": "雷蒙多",
          "text": "但我懂如何在枫丹动能工程科学院里正确且正常地工作，艾德温·伊斯丁豪斯。"
        },
        {
          "role": "雷蒙多",
          "text": "你现在要做的，就是离研究和始基矿远一些，这样对所有人都好。"
        },
        {
          "role": "？？？",
          "text": "在一段时间后，执律庭的人赶到并带走了纳克与艾德温。谢天谢地，他们总算彻底离开枫丹科学院了…"
        },
        {
          "role": "舒瓦瑟尔",
          "text": "谢天谢地，我的噩梦总算彻彻底底地醒了…"
        },
        {
          "role": "舒瓦瑟尔",
          "text": "肖西韦尔先生和勒马克先生，对吧？我已经听人提起过你们对我院工作的协助。相应的谢礼正在安排，请你们在这里稍作休憩。"
        },
        {
          "role": "肖西韦尔",
          "text": "哈哈哈，我还真没想到，我这种人也能和科学院搭上关系。"
        },
        {
          "role": "舒瓦瑟尔",
          "text": "别这么说自己！亲爱的先生，您既真诚，又有热心肠，绝对是个好人！说不定以后我们还会请您来帮忙啊。"
        },
        {
          "role": "舒瓦瑟尔",
          "text": "而您…荣誉高级研究员，您又帮了科学院一个大忙，到底该如何感谢您呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别再弄出爆炸就行。",
              "dialogues": []
            },
            {
              "text": "能不能给我再升级一下头衔？",
              "dialogues": [
                {
                  "role": "舒瓦瑟尔",
                  "text": "唔，理论上您的这个头衔就已经是顶级了…但我可以尝试为您申请一下特别头衔。"
                },
                {
                  "role": "舒瓦瑟尔",
                  "text": "比如，首席荣誉高级研究员？哈哈哈哈！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸，说起来…菲希里耶小姐呢？"
        },
        {
          "role": "雷蒙多",
          "text": "…先让这位小姐自己冷静一下吧。看来，她幻想中的艾德温·伊斯丁豪斯，总算破灭了。"
        },
        {
          "role": "雷蒙多",
          "text": "艾德温和纳克也需要冷静一下…希望他们早日认清自己。"
        },
        {
          "role": "旅行者",
          "text": "他们会在梅洛彼得堡待一辈子吗？"
        },
        {
          "role": "雷蒙多",
          "text": "就他们的危险性来说，我希望他们永远也不要离开那里。"
        },
        {
          "role": "雷蒙多",
          "text": "但就枫丹科学院如今的情况来说…唉，希望我不要遇见那种非启用他们不可的事务…"
        },
        {
          "role": "雷蒙多",
          "text": "再次代表枫丹科学院感谢您，荣誉高级研究员。如果你还有什么想问的…我愿意再和您聊聊。"
        }
      ]
    }
  ]
}