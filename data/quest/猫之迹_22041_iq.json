{
  "quest_id": 22041,
  "chapter_num": null,
  "chapter_title": "猫之迹",
  "type": "iq",
  "route": "The Cat's Trail",
  "stories": [
    {
      "story_id": 22041,
      "title": "猫之迹",
      "description": "浅濑神社代宫司「寝子」似乎正在因为某事而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与寝子对话"
        },
        {
          "role": "「寝子」",
          "text": "汝等来了啊，来得正好，奴家正在发愁呢。"
        },
        {
          "role": "旅行者",
          "text": "发生什么事了？"
        },
        {
          "role": "「寝子」",
          "text": "汝等还记得「昆布丸」这个孩子吧？"
        },
        {
          "role": "「寝子」",
          "text": "这孩子去附近玩了之后，到现在也没有回来，奴家很担心。"
        },
        {
          "role": "「寝子」",
          "text": "拜托汝等，去附近找找「昆布丸」，再把它带回来吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "那就拜托汝了，快点找到「昆布丸」，把它带回神社来吧。"
                }
              ]
            },
            {
              "text": "只有它跑出去了吗？",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "只有这孩子…也许是上次奴家训斥了它，让它不高兴了吧。"
                },
                {
                  "role": "「寝子」",
                  "text": "这孩子，为什么总是这么不听话呢…"
                },
                {
                  "role": "「寝子」",
                  "text": "拜托汝了，快点找到「昆布丸」，把它带回神社来吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找「昆布丸」"
        },
        {
          "role": "「寝子」",
          "text": "拜托汝了，找到「昆布丸」后，就把它带回神社来吧。"
        },
        {
          "type": "subtitle",
          "text": "与寝子对话"
        },
        {
          "role": "「寝子」",
          "text": "怎么样，汝等找到昆布丸了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经找到了。"
        },
        {
          "role": "派蒙",
          "text": "欸！它又跑不见了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我这就接着抓它回来！",
              "dialogues": []
            },
            {
              "text": "我今天还不信了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "汝等，不用去找它了。"
        },
        {
          "role": "「寝子」",
          "text": "这孩子果然还在和奴家赌气…等会奴家自己再去教训一下那孩子。"
        },
        {
          "role": "「寝子」",
          "text": "明明都快成为一只大猫了，怎么还是这么任性，到时候要是惊到了来神社的人类可怎么办。"
        },
        {
          "role": "「寝子」",
          "text": "喔，这些东西给汝等，谢谢汝等帮忙了。"
        },
        {
          "role": "「寝子」",
          "text": "唉，为什么这孩子不能和「阿饭」一样听话呢…"
        }
      ]
    }
  ]
}