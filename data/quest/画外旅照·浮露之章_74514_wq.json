{
  "quest_id": 74514,
  "chapter_num": null,
  "chapter_title": "画外旅照·浮露之章",
  "type": "wq",
  "route": "Outside the Canvas, Inside the Lens: Dew-Kissed Chapter",
  "stories": [
    {
      "story_id": 74514,
      "title": "画外旅照·浮露之章",
      "description": "在枫丹，你又遇见了那位名为朝雾的画家…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与朝雾对话"
        },
        {
          "role": "朝雾",
          "text": "好…好冷，果然不该随便吹风的…"
        },
        {
          "role": "朝雾",
          "text": "欸？旅行者！派蒙！你们…阿嚏！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "朝雾？你怎么会在这里？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你的身体好了吗？居然能一个人来这么远的地方…"
        },
        {
          "role": "朝雾",
          "text": "我…那个…好，好得差不多啦！你看，我都不咳嗽了。"
        },
        {
          "role": "朝雾",
          "text": "哈哈…哈…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真的吗？",
              "dialogues": []
            },
            {
              "text": "我可要写信回去问了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "朝雾",
          "text": "呜哇！别啊！我承认了，我是自己偷偷跑出来的啦！"
        },
        {
          "role": "朝雾",
          "text": "我…我也没办法啊，老是窝在稻妻，怎么可能画出好看的画。"
        },
        {
          "role": "朝雾",
          "text": "就算有你帮我到处去留影，但说到底，画片肯定比不过实景啊。"
        },
        {
          "role": "朝雾",
          "text": "所以，我就拜托之前合作过的一个老师帮忙联系了一支商队，悄悄地出来旅行。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "亏你还把画具都背过来了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "朝雾",
          "text": "那当然。画板可是我的灵魂，怎么能随便丢下它们呢。"
        },
        {
          "role": "朝雾",
          "text": "而且我的画在枫丹也卖得很好呀，还有几个枫丹的作家，请我给他们的小说画封面了。"
        },
        {
          "role": "朝雾",
          "text": "不过…他们居然没有在小说中间插入插画的习惯呢。真没想到…"
        },
        {
          "role": "朝雾",
          "text": "对了，旅行者，刚巧你在这里…你愿意再帮我去取材吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "朝雾",
                  "text": "好欸！有你帮忙我就放心了。"
                }
              ]
            },
            {
              "text": "行吧。你可别乱跑。",
              "dialogues": [
                {
                  "role": "朝雾",
                  "text": "我知道啦。我可对付不了那些机关铁疙瘩。"
                },
                {
                  "role": "朝雾",
                  "text": "论起对付各类奇奇怪怪的魔物，当然还是你最在行啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "朝雾",
          "text": "好嘞…让我看看喔。正好我又接到了几个作家的约稿…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（朝雾）"
        },
        {
          "role": "朝雾",
          "text": "旅行者，取材的事又要麻烦你啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你会在枫丹待多久？",
              "dialogues": [
                {
                  "role": "朝雾",
                  "text": "唔，我才刚到枫丹不久呢，还没想过这件事。"
                },
                {
                  "role": "朝雾",
                  "text": "我都没去过枫丹的水下呢。我听说，枫丹的水下有好多壮观的景色。"
                },
                {
                  "role": "朝雾",
                  "text": "就是…我还要专门去学习潜水。有好多东西要记住，太难了…"
                },
                {
                  "role": "朝雾",
                  "text": "我还是先把枫丹的陆上景色都游览一遍吧。"
                },
                {
                  "role": "朝雾",
                  "text": "对了，还要寄一封信回去。呜哇…我不会被骂吧…"
                }
              ]
            },
            {
              "text": "枫丹人喜欢你的画吗？",
              "dialogues": [
                {
                  "role": "朝雾",
                  "text": "看那几位约稿的作家老师反映，他们对我的画还挺满意的。"
                },
                {
                  "role": "朝雾",
                  "text": "不过话说回来，枫丹的小说和稻妻的小说还真是不一样呢。"
                },
                {
                  "role": "朝雾",
                  "text": "特别是人名！唉，对我来说实在是太难记了…"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "朝雾",
                  "text": "嗯，再见。取材的事情就拜托你啦。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          19,
          21
        ]
      ]
    }
  ]
}