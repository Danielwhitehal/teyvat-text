{
  "quest_id": 74043,
  "chapter_num": null,
  "chapter_title": "依旧让人垂涎欲滴！",
  "type": "wq",
  "route": "Still Mouthwatering!",
  "stories": [
    {
      "story_id": 74043,
      "title": "依旧让人垂涎欲滴！",
      "description": "已经依照恩里的说法，取得了七个神秘核心。回去找恩里吧。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与恩里对话"
        },
        {
          "type": "subtitle",
          "text": "与恩里对话"
        },
        {
          "role": "恩里",
          "text": "嗯，确实收到了，七个神秘的核心。"
        },
        {
          "role": "旅行者",
          "text": "所以核心到底是干什么用的？"
        },
        {
          "role": "恩里",
          "text": "我怎么知道？老板只是说，需要七个这些神奇机器里的神奇核心。能弄到核心，就能赚大钱。"
        },
        {
          "role": "恩里",
          "text": "这样好了！我跟老板约好了今天在这里见面，汇报工作进度。你们当面问他吧？反正也要等他结帐，我才能跟你分钱。"
        },
        {
          "role": "派蒙",
          "text": "真拿你没办法。既然恩里这么说了，就等一会吧！"
        },
        {
          "role": "？？？",
          "text": "等了一会…"
        },
        {
          "role": "「老板」",
          "text": "亲爱的恩里，情况如何啊？"
        },
        {
          "role": "恩里",
          "text": "好得很，老板！您要的七个神秘核心都收集齐全了。来来，让我介绍一下，这是我的合伙人…叫啥来着？"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "「老板」",
          "text": "呃…"
        },
        {
          "role": "派蒙",
          "text": "呃呃…"
        },
        {
          "role": "恩里",
          "text": "哎？你们认识啊？那就好说了！事情是这样的，老板…"
        },
        {
          "role": "「老板」",
          "text": "哎吔！饶命啊！"
        },
        {
          "role": "派蒙",
          "text": "呜哇，这两个人好熟练…"
        },
        {
          "role": "恩里",
          "text": "老板别担心，没有生命危险的！"
        },
        {
          "role": "亨特",
          "text": "当然，当然。当然不会有生命危险。"
        },
        {
          "role": "特纳",
          "text": "就目前而言呢。"
        },
        {
          "role": "「老板」",
          "text": "就、就目前而言…？！"
        },
        {
          "role": "亨特",
          "text": "接下来呢…"
        },
        {
          "role": "特纳",
          "text": "是烤鸡，抑或是…烤鸡以外的东西，就取决于老板您的态度了。"
        },
        {
          "role": "「老板」",
          "text": "噫噫——"
        },
        {
          "role": "派蒙",
          "text": "你们怎么会在这里？"
        },
        {
          "role": "亨特",
          "text": "上次，我们…有幸相遇以后，我们决定监视恩里。"
        },
        {
          "role": "恩里",
          "text": "等等，为什么要监视我？"
        },
        {
          "role": "恩里",
          "text": "不对，归根到底，你们为什么要针对我！明明我只是在努力工作而已！"
        },
        {
          "role": "特纳",
          "text": "你拆掉的机器是枫丹科学院的人用来监测、优化水质的装置。"
        },
        {
          "role": "恩里",
          "text": "哎？不是用来制造污染的机器吗？"
        },
        {
          "role": "亨特",
          "text": "拆出来的核心包含着最先进的机芯和枫丹的水文数据。我们希望能…认识您的交易对象。"
        },
        {
          "role": "恩里",
          "text": "哎？哎？什么？为什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "恩里！你骗我！",
              "dialogues": [
                {
                  "role": "恩里",
                  "text": "不对不对，你是我的大恩人，我怎么可能骗你啊！"
                }
              ]
            },
            {
              "text": "震惊！我们被骗了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恩里",
          "text": "老板，你骗我！你竟然骗我把这么重要的东西弄坏了！"
        },
        {
          "role": "「老板」",
          "text": "我、我不是故意…我只是最下面的…"
        },
        {
          "role": "特纳",
          "text": "啊啊？老板，说的什么胡话我没听清，我还以为您说自己「不是故意」…您再说一遍？"
        },
        {
          "role": "「老板」",
          "text": "噫噫——"
        },
        {
          "role": "亨特",
          "text": "这位老板看来是累了。睁着眼晕过去了。"
        },
        {
          "role": "派蒙",
          "text": "呃呃，我、我们也不是故意的…"
        },
        {
          "role": "特纳",
          "text": "关于这个嘛。我们决定，不追究了。"
        },
        {
          "role": "派蒙",
          "text": "欸？没关系吗？"
        },
        {
          "role": "亨特",
          "text": "反正只要核心完好，其中的数据完好，机器根本没所谓。"
        },
        {
          "role": "特纳",
          "text": "上面说了没所谓。反正不能跟你们过不去。"
        },
        {
          "role": "旅行者",
          "text": "有什么跟我过不去的？"
        },
        {
          "role": "亨特",
          "text": "没什么，没什么。您瞧…"
        },
        {
          "role": "特纳",
          "text": "我们只是在散步而已。"
        },
        {
          "role": "亨特",
          "text": "真是偶遇，不是吗？美好的天气，美好的邂逅。"
        },
        {
          "role": "特纳",
          "text": "但是美好的邂逅总会结束。我们该…告别了。"
        },
        {
          "role": "亨特",
          "text": "就让美好的邂逅留在心中，或者…"
        },
        {
          "role": "特纳",
          "text": "忘了更好。忘了更好。"
        },
        {
          "role": "恩里",
          "text": "欸…所以我们没事了？"
        },
        {
          "role": "亨特",
          "text": "怎么，你想有什么事？"
        },
        {
          "role": "恩里",
          "text": "没事没事！哈哈，当然没事了！"
        },
        {
          "role": "恩里",
          "text": "唉，本来我还以为遇上了好心人，总算能通过劳动改变命运了。到头来，这世上还是坏人多！"
        },
        {
          "role": "特纳",
          "text": "…喂，恩里。来搭把手。"
        },
        {
          "role": "恩里",
          "text": "啊？"
        },
        {
          "role": "亨特",
          "text": "真是不幸啊，这位好心的老板神志不清了。"
        },
        {
          "role": "特纳",
          "text": "我们需要一位…"
        },
        {
          "role": "亨特",
          "text": "干活认真。"
        },
        {
          "role": "特纳",
          "text": "忠实可靠。"
        },
        {
          "role": "亨特",
          "text": "希望用劳动改变命运的…好朋友。"
        },
        {
          "role": "特纳",
          "text": "没错，一位好朋友。来帮忙把这位好老板带到我们的安全屋去。"
        },
        {
          "role": "亨特",
          "text": "我们才方便…好好跟这位好心的老板聊聊。"
        },
        {
          "role": "特纳",
          "text": "当然了，我们会充分地…表达我们的谢意。通过摩拉。"
        },
        {
          "role": "恩里",
          "text": "嗯？嗯！算我一个！"
        },
        {
          "role": "恩里",
          "text": "太好了！谢谢你们！也很感谢你们，那个…"
        },
        {
          "role": "旅行者",
          "text": "我是旅行者，她是派蒙。"
        },
        {
          "role": "恩里",
          "text": "谢谢你们，旅行者、派蒙！遇到你们以后，我的命运都改变啦！"
        },
        {
          "role": "派蒙",
          "text": "不用谢！要加油哦，恩里！不要再被骗了！"
        },
        {
          "role": "恩里",
          "text": "嗯！不会的！我要努力工作，成为大富翁！以后雇佣别人给我干活！"
        },
        {
          "role": "？？？",
          "text": "亨特、特纳和恩里将不省人事的愚人众挖了出来，带走了。"
        },
        {
          "role": "派蒙",
          "text": "希望恩里能获得幸福呢…"
        },
        {
          "role": "派蒙",
          "text": "等等！恩里说好的，给我们的报酬呢？！"
        },
        {
          "type": "subtitle",
          "text": "与恩里对话"
        },
        {
          "role": "恩里",
          "text": "抗议！抗议！为我劳动的权利抗议！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你要的核心…",
              "dialogues": [
                {
                  "role": "恩里",
                  "text": "哦？让我看看！"
                }
              ]
            },
            {
              "text": "为什么在这里抗议…",
              "dialogues": [
                {
                  "role": "恩里",
                  "text": "在哪里跌倒的，就要在哪里站起来！"
                }
              ]
            },
            {
              "text": "我要干什么来着？",
              "dialogues": [
                {
                  "role": "恩里",
                  "text": "真拿你没办法。在地上和水下的一些地方，有人部署了这种奇怪机器。识别的方法也很简单，机器的周围会产生很奇怪的光。"
                },
                {
                  "role": "恩里",
                  "text": "把它解决掉，把里面这种特定的核心带给我，一共<color=#00E1FFFF>需要七个</color>。拜托了！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "调查周围的情况"
        },
        {
          "type": "subtitle",
          "text": "与恩里对话"
        }
      ]
    }
  ]
}