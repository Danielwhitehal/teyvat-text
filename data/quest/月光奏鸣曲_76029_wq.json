{
  "quest_id": 76029,
  "chapter_num": null,
  "chapter_title": "月光奏鸣曲",
  "type": "wq",
  "route": "Moonlight Sonata",
  "stories": [
    {
      "story_id": 76029,
      "title": "月光奏鸣曲",
      "description": "在「银月之庭」，「少女」似乎遇到了一些困难…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同「少女」见面"
        },
        {
          "type": "subtitle",
          "text": "完成魔神任务「匿于阴影」"
        },
        {
          "role": "旅行者",
          "text": "（咦？琴声？看来哥伦比娅在给月灵们弹琴。）"
        },
        {
          "role": "旅行者",
          "text": "（上次来的时候琴还没修好。那已经是哥伦比娅还不认识大家的时候发生的事了…）"
        },
        {
          "type": "subtitle",
          "text": "不久之前…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「少女」",
          "text": "你们好。"
        },
        {
          "role": "派蒙",
          "text": "咦？哥伦比娅你要出门吗？"
        },
        {
          "role": "「少女」",
          "text": "嗯，出去修琴。"
        },
        {
          "role": "派蒙",
          "text": "…什么？"
        },
        {
          "role": "「少女」",
          "text": "有只月灵的琴坏了，它很珍惜这琴，我想帮它修好。"
        },
        {
          "role": "派蒙",
          "text": "月灵们还真是多才多艺…"
        },
        {
          "role": "「少女」",
          "text": "嗯，它经常在这里弹琴，我偶尔也会和着琴声唱歌。"
        },
        {
          "role": "派蒙",
          "text": "我之前就这么觉得了，你还真是宠月灵呢。"
        },
        {
          "role": "「少女」",
          "text": "它们一直陪着我，还经常给我带好玩的东西回来。"
        },
        {
          "role": "旅行者",
          "text": "（菈乌玛说过，这是因为月灵想让月神开心的天性使然吧。）"
        },
        {
          "role": "派蒙",
          "text": "不过我问一句，你打算怎么修好这琴呀？你不是说自己不能被别人看到吗？"
        },
        {
          "role": "「少女」",
          "text": "唔…以前我会拜托小动物或者月灵，让它们把要修的东西放到工匠家门口。"
        },
        {
          "role": "「少女」",
          "text": "工匠发现后，一般都会顺手把东西修好。不过有时也会发现不了，要等几天。"
        },
        {
          "role": "派蒙",
          "text": "听起来有些周折呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不如交给我们吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "放心吧，我们去的话说不定今天就能修好呢。"
        },
        {
          "role": "「少女」",
          "text": "…好吧。谢谢。"
        },
        {
          "role": "派蒙",
          "text": "别客气。顺带一提，你一般放在哪个工匠的家门口呀？"
        },
        {
          "role": "「少女」",
          "text": "我不知道她名字。她家门口有个大大的机械手，住在一个圆圆的，像海螺一样的家里。"
        },
        {
          "role": "旅行者",
          "text": "（难道说是…）"
        },
        {
          "role": "「少女」",
          "text": "里面还经常传来蛋卷的香味。"
        },
        {
          "role": "派蒙",
          "text": "我好像知道是谁了…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「少女」）"
        },
        {
          "role": "「少女」",
          "text": "你们似乎认识那位工匠，我在这里等你们吧。"
        },
        {
          "type": "subtitle",
          "text": "前往叮铃哐啷蛋卷工坊"
        },
        {
          "role": "派蒙",
          "text": "爱诺！你在家吗？"
        },
        {
          "role": "爱诺",
          "text": "哇！是派蒙的声音！"
        },
        {
          "role": "爱诺",
          "text": "你们好呀！是带着零食来看望爱诺的吗？"
        },
        {
          "role": "派蒙",
          "text": "就知道你会这么说，喏，来的路上就为你准备好了。"
        },
        {
          "role": "爱诺",
          "text": "快给我快给我，等下伊涅芙就要回来了。"
        },
        {
          "role": "爱诺",
          "text": "那么今天要和爱诺一起玩什么呢？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿…实际上，有件事情想拜托爱诺…"
        },
        {
          "type": "subtitle",
          "text": "旅行者拿出了破损的琴，爱诺的脸黑了下来冒出冷汗…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "爱诺",
          "text": "呜哇！拿…拿走拿走！快把那怪东西拿走！"
        },
        {
          "role": "派蒙",
          "text": "怪东西？是说这琴吗？"
        },
        {
          "role": "爱诺",
          "text": "说了我讨厌用科学和机械原理解释不通的东西…"
        },
        {
          "role": "爱诺",
          "text": "那个琴隔三差五就会出现在我家门口，但我每次把它修好后，它又会莫名其妙地不见了！"
        },
        {
          "role": "爱诺",
          "text": "我…我才不信有这种神神鬼鬼的东西呢！"
        },
        {
          "role": "派蒙",
          "text": "啊…看来这其中有些误会呢…"
        },
        {
          "role": "爱诺",
          "text": "误会？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是一位朋友的琴…",
              "dialogues": []
            },
            {
              "text": "那个朋友有些怕生…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，她其实没有恶意啦，每次悄悄拿走，也有些缘由在…"
        },
        {
          "role": "爱诺",
          "text": "真的吗？你没在骗我哦？"
        },
        {
          "role": "爱诺",
          "text": "那…那我就信你们，再修一次…这次就修得彻底一点…"
        },
        {
          "role": "爱诺",
          "text": "你们在这里等一下哦。"
        },
        {
          "role": "派蒙",
          "text": "爱诺还是挺可靠的呀，就是被悄悄放东西的行为吓到有些可怜…"
        },
        {
          "role": "「少女」",
          "text": "的确该回报她一下。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯…呃啊！你怎么突然出现在这里啦！这次是吓到我们啦！"
        },
        {
          "role": "「少女」",
          "text": "给你们点东西就回去。"
        },
        {
          "role": "派蒙",
          "text": "嗯？这是什么？"
        },
        {
          "role": "「少女」",
          "text": "是月灵收集的一些「宝物」，它想要谢谢这位工匠，觉得她会喜欢。"
        },
        {
          "role": "派蒙",
          "text": "哦~好多稀奇古怪的零件呢。好吧，我们收到了，待会儿就转交给爱诺。"
        },
        {
          "role": "派蒙",
          "text": "你回去的路上也要小心哦，别被人看见了。"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯？怎么了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那边…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "……！"
        },
        {
          "role": "伊涅芙",
          "text": "……"
        },
        {
          "role": "「少女」",
          "text": "……"
        },
        {
          "role": "伊涅芙",
          "text": "…相似度比对中…"
        },
        {
          "role": "派蒙",
          "text": "在和什么比对啦！"
        },
        {
          "role": "伊涅芙",
          "text": "与挪德卡莱月神像的人物相似度…百分之九十五…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是…是演员！",
              "dialogues": [
                {
                  "role": "伊涅芙",
                  "text": "检测到旅行者的心率上升…"
                }
              ]
            },
            {
              "text": "有…有误差！",
              "dialogues": [
                {
                  "role": "伊涅芙",
                  "text": "误差范围较小，推断结论可靠…"
                }
              ]
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "修好啦！这次应该再也不会坏了，顺带一提刚才的零…伊…伊涅芙！"
        },
        {
          "role": "伊涅芙",
          "text": "刚才的零…"
        },
        {
          "role": "爱诺",
          "text": "刚才的零件也很管用！"
        },
        {
          "role": "伊涅芙",
          "text": "……？"
        },
        {
          "role": "爱诺",
          "text": "嗯？你们身后这位是？"
        },
        {
          "role": "「少女」",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是琴的委托人！",
              "dialogues": []
            },
            {
              "text": "是怕生的客户！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "（总觉得有些眼熟…我在哪里见过这位姐姐吗？不管了，这不重要。派蒙给我的零食应该藏好了吧…）"
        },
        {
          "role": "派蒙",
          "text": "对…对！这些零件也是她送过来的，说是想感谢爱诺你帮忙修琴。"
        },
        {
          "role": "爱诺",
          "text": "嗯？我看看…哇！都是些古老的稀有零件欸！真的可以收下吗！"
        },
        {
          "role": "「少女」",
          "text": "…嗯。"
        },
        {
          "role": "爱诺",
          "text": "谢谢你！以后有什么要修的东西也可以来找我哦！"
        },
        {
          "role": "伊涅芙",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "呃…那，那我们差不多回去了。爱诺，伊涅芙，我们改天再找你们玩哦！"
        },
        {
          "role": "派蒙",
          "text": "（得赶快带「少女」离开，不然伊涅芙要认出来了！）"
        },
        {
          "role": "爱诺",
          "text": "好…好呀！那就改天见！"
        },
        {
          "role": "爱诺",
          "text": "（得赶快回去收拾一下，不然伊涅芙要发现零食屑了！）"
        },
        {
          "role": "伊涅芙",
          "text": "好，二位再见。"
        },
        {
          "type": "subtitle",
          "text": "你们和「少女」离开了…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "伊涅芙",
          "text": "…爱诺。"
        },
        {
          "role": "爱诺",
          "text": "怎…怎么了？"
        },
        {
          "role": "伊涅芙",
          "text": "这些零件需要供起来吗？"
        },
        {
          "role": "爱诺",
          "text": "啊？为什么？"
        },
        {
          "role": "伊涅芙",
          "text": "它们好像是「月神的赠物」。"
        },
        {
          "role": "爱诺",
          "text": "呃，伊涅芙你在说什么…我等下帮你检查检查线路吧…"
        }
      ],
      "collapse_ranges": [
        [
          1,
          4
        ],
        [
          28,
          29
        ]
      ]
    }
  ]
}