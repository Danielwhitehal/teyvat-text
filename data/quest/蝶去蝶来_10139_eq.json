{
  "quest_id": 10139,
  "chapter_num": "盛典与慧业 第一幕",
  "chapter_title": "蝶去蝶来",
  "type": "eq",
  "route": "Comings and Goings",
  "stories": [
    {
      "story_id": 40100,
      "title": "庆典开幕",
      "description": "派蒙不知从哪里听来了有关「学院庆典」的消息，到教令院去打听一下详情吧。",
      "dialogues": [
         {
          "type": "subtitle",
          "text": "前往教令院大厅打听消息"
        },
        {
          "role": "维卡斯",
          "text": "两位请留步…莫非你们就是大名鼎鼎的旅行者和派蒙？"
        },
        {
          "role": "派蒙",
          "text": "是呀。你是谁？"
        },
        {
          "role": "维卡斯",
          "text": "我是维卡斯，学院庆典策划委员会的成员。两位可曾听说过学院庆典？"
        },
        {
          "role": "旅行者",
          "text": "刚刚听说。"
        },
        {
          "role": "派蒙",
          "text": "没错，我们就是为了这个来的！"
        },
        {
          "role": "维卡斯",
          "text": "哦？看来我们的宣传效果还算不错。"
        },
        {
          "role": "维卡斯",
          "text": "两位既然对学院庆典感兴趣，不如就由我来简单介绍一下如何？"
        },
        {
          "role": "旅行者",
          "text": "那就多谢了。"
        },
        {
          "role": "维卡斯",
          "text": "咳咳…学院庆典是由教令院举办的盛会，有着非常悠久的历史。具体来说，可以细分成「学院游乐会」和「学院争霸赛」两部分。"
        },
        {
          "role": "维卡斯",
          "text": "「学院游乐会」每年都会举办。庆典期间，六个学派会在城中摆好摊位、招待游客，宣传自家学派有趣的地方，借此提高影响力。"
        },
        {
          "role": "维卡斯",
          "text": "而四年一度的「学院争霸赛」，则是让六个学派各自选出一名代表，来角逐最后的冠军宝座。"
        },
        {
          "role": "维卡斯",
          "text": "今年学院游乐会与学院争霸赛将会一同举办，所以城中的气氛也是空前热闹。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样！谢谢你啦，感觉你介绍的很详细呢！"
        },
        {
          "role": "维卡斯",
          "text": "不必客气。解答有关学院庆典的问题是我的职责，何况我其实有求于两位。"
        },
        {
          "role": "派蒙",
          "text": "欸？有什么需要我们帮忙的地方吗？"
        },
        {
          "role": "维卡斯",
          "text": "是这样的——对我们来说，今年的学院庆典至关重要。"
        },
        {
          "role": "维卡斯",
          "text": "小吉祥草王大人与贤者们拟定了一项计划，明年教令院会从沙漠中招募一些有天赋的人成为学者。"
        },
        {
          "role": "维卡斯",
          "text": "因此这一次的学院庆典，我们邀请了许多生活在沙漠的民众来参加，希望他们能提前感受教令院的氛围。"
        },
        {
          "role": "维卡斯",
          "text": "听说两位的名声在雨林和沙漠都很响亮，如果你们能参加学院庆典…特别是学院争霸赛的话，一定可以让更多人了解这场盛会。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我们并不是教令院的学者。",
            "不是只有每个学派的代表可以参加吗？"
          ]
        },
      
        {
          "role": "派蒙",
          "text": "对呀。难道说要我们加入某个学派？唔…但是当了学者，就要面对「考试」和「论文」了…"
        },
        {
          "role": "维卡斯",
          "text": "请放心，学院争霸赛的参赛者已经确定了。我是想请两位做我们的「特邀评论员」，观察并记录每一场比赛。"
        },
        {
          "role": "维卡斯",
          "text": "两位不必有什么压力，跟随着比赛，享受这一次的学院庆典就好。另外，我们也会准备一些酬劳，不会让你们白跑一趟。"
        },
        {
          "role": "派蒙",
          "text": "这样听上去还可以，你觉得呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "都有哪些参赛者？",
              "dialogues": [
                {
          "role": "维卡斯",
          "text": "等会儿到学院庆典现场，会有主持人详细介绍每一位参赛者。"
        },
        {
          "role": "维卡斯",
          "text": "其中或许会有一些你们认识的人，现在我就暂且卖个关子…"
        }
              ]
            },
            {
              "text": "还有其他的评论员吗？",
              "dialogues": [
                {
          "role": "维卡斯",
          "text": "有的。除了你们外，我们还找了两位评论员。"
        },
        {
          "role": "维卡斯",
          "text": "他们和你们的分工不太一样。等到了学院庆典现场，会有主持人跟你们细说。"
        }
              ]
            }    
            
            
          ]
        },
        
        {
          "role": "维卡斯",
          "text": "怎么样，要不要考虑接下这份委托？"
        },
        {
          "role": "旅行者",
          "text": "那我们试试吧。"
        },
        {
          "role": "派蒙",
          "text": "又能去学院庆典玩，还有酬劳可以拿，听起来很不错嘛！"
        },
        {
          "role": "维卡斯",
          "text": "学院庆典的主会场在「聚砂厅」附近的郊外，主持人名叫卡莉娜。你们把情况告诉她，她会帮你们安排妥当。"
        },
        {
          "role": "维卡斯",
          "text": "时间不早，学院争霸赛也快要开始了。祝两位特邀评论员一路顺风，有什么疑惑，可以随时过来找我。"
        },
        {
          "role": "派蒙",
          "text": "好，我们出发！"
        },
        {
          "role": "卡莉娜",
          "text": "各位，欢迎来到学院庆典现场！"
        },
        {
          "type": "subtitle",
          "text": "前往学院庆典的主会场"
        },
        {
          "role": "卡莉娜",
          "text": "接下来由我为大家揭晓本届学院争霸赛的奖品——"
        },
        {
          "role": "卡莉娜",
          "text": "丰厚奖金、项目资源、限定版七圣召唤卡牌…以及佩戴「才识之冠」的权利，不用我说大家也能猜到，这是荣誉的象征！"
        },
        {
          "role": "派蒙",
          "text": "她应该就是维卡斯说的卡莉娜了吧？"
        },
        {
          "role": "派蒙",
          "text": "看来她现在很忙，我们等会儿再找她吧。"
        },
        {
          "role": "阿莱",
          "text": "「才识之冠」…真是完美的艺术品…"
        },
        {
          "role": "艾莎",
          "text": "每次见到它，都会不自觉地沉醉在它的美丽中。有资格佩戴它的人，想必也是难得的天才吧。"
        },
        {
          "role": "卡莉娜",
          "text": "相信很多人已经见过「才识之冠」，或者听过有关它的传说了。"
        },
        {
          "role": "卡莉娜",
          "text": "二十年前，一位叫萨齐因的学者花重金将它买下，并捐献给了教令院。"
        },
        {
          "role": "卡莉娜",
          "text": "如今学院争霸赛提供的丰厚奖金，也正是来源于他的赞助。比赛开始前，请允许我向这位不在现场的学者致以感谢…"
        },
        {
          "role": "萨齐因",
          "text": "一切正在变糟…"
        },
        {
          "role": "萨齐因",
          "text": "一切都会变糟…一切只能变糟…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你是？",
            "这里是？"
          ]
        },
       
        {
          "role": "萨齐因",
          "text": "人性带来纷争，纷争导向毁灭。罪恶的种子从一开始就已经…"
        },
        {
          "role": "派蒙",
          "text": "喂——别发呆啦！"
        },
        {
          "role": "派蒙",
          "text": "刚刚叫你就没有反应，是没有休息好吗？不会又偷偷熬夜了吧？"
        },
        {
          "role": "旅行者",
          "text": "我刚才…"
        },
        {
          "role": "卡莉娜",
          "text": "好的，相信大家和我一样，已经迫不及待地想要见到比赛开始了！"
        },
        {
          "role": "卡莉娜",
          "text": "现在让我们有请六名「学院代表」上台。他们分别是——"
        },
        {
          "role": "卡莉娜",
          "text": "生论派代表，提纳里！"
        },
        {
          "role": "卡莉娜",
          "text": "素论派代表，赛诺！"
        },
        {
          "role": "卡莉娜",
          "text": "明论派代表，莱依拉！"
        },
        {
          "role": "卡莉娜",
          "text": "知论派代表，珐露珊！"
        },
        {
          "role": "卡莉娜",
          "text": "妙论派代表，卡维！"
        },
        {
          "role": "卡莉娜",
          "text": "以及因论派代表…咦？因论派代表还没有到场吗？"
        },
        {
          "role": "流浪者",
          "text": "像这种聒噪无用的介绍，还是趁早结束吧。"
        },
        {
          "role": "派蒙",
          "text": "啊？等等等下，因论派的代表怎么会是…"
        },
        {
          "role": "卡莉娜",
          "text": "来了！最后一位参赛选手，因论派代表——阿帽！"
        },
        {
          "role": "阿莱",
          "text": "原来这个人叫阿帽？我见过他…"
        },
        {
          "role": "派蒙",
          "text": "欸？你们知道他是谁吗？"
        },
        {
          "role": "艾莎",
          "text": "听说他是外国学者，挂名在因论派，写过不少时政分析的论文。"
        },
        {
          "role": "艾莎",
          "text": "因论派的学者大多不喜欢他的说话方式，不过这人平时神出鬼没，和其他人也没什么来往。"
        },
        {
          "role": "阿莱",
          "text": "抛去争议性不谈，他提出的许多观点也算鞭辟入里。"
        },
        {
          "role": "阿莱",
          "text": "因论派这几年人才凋敝，有名的几个又不在教令院，估计也是选无可选…"
        },
        {
          "role": "派蒙",
          "text": "总觉得有点奇怪，他不像是会来参加这种比赛的人吧？"
        },
        {
          "role": "旅行者",
          "text": "我也感到很疑惑。"
        },
        {
          "role": "卡莉娜",
          "text": "六位参赛者已经登台亮相，比赛很快就会开始！"
        },
        {
          "role": "卡莉娜",
          "text": "本届学院争霸赛的冠军究竟花落谁家？让我们一起拭目以待！"
        },
        {
          "role": "派蒙",
          "text": "这么一看，学院争霸赛有很多我们认识的人呢。"
        },
        {
          "role": "派蒙",
          "text": "对了，我们现在是特邀评论员吧？搞清楚每个人参赛的原因，应该也是我们的工作。"
        },
        {
          "role": "派蒙",
          "text": "等会儿打招呼的时候，我们顺便问问他们吧。特别是那家伙，总觉得他出现在这里有些奇怪…"
        },
        {
          "type": "subtitle",
          "text": "询问学院代表们的参赛原因",
          "narration": true,
          "color": "描述"
        },
         {
          "type": "subtitle",
          "text": "与提纳里和赛诺对话"
        },
        {
          "role": "提纳里",
          "text": "又见面了，两位。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们也来学院庆典玩啦！而且我们现在还是特邀评论员呢！"
        },
        {
          "role": "提纳里",
          "text": "是吗？我听说会有特邀评论员用留影机记录比赛过程，没想到是你们。"
        },
        {
          "role": "赛诺",
          "text": "既然我现在还在休假，那有句话一定要说。你们不觉得很有意思吗——"
        },
        {
          "role": "赛诺",
          "text": "真是个「巧合」，就像「桥」的下面总有「河」。"
        },
        {
          "role": "提纳里",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "说起来，提纳里是生论派的学院代表，赛诺是素论派的学院代表…"
        },
        {
          "role": "派蒙",
          "text": "但如果我没记错的话，你们应该都毕业了呀？毕业了也可以参加比赛吗？"
        },
        {
          "role": "提纳里",
          "text": "果然你们也是这个反应。我得知自己被选为学院代表时，其实比你们还要惊讶。"
        },
        {
          "role": "提纳里",
          "text": "后来我才知道，凡是在教令院待过的学者都有参赛资格，是否毕业并不影响。"
        },
        {
          "role": "派蒙",
          "text": "还有这种规则！"
        },
        {
          "role": "赛诺",
          "text": "还是有一些限制的。比如贤者不能参赛、每人最多参加一届比赛等等。"
        },
        {
          "role": "提纳里",
          "text": "没错。另外挑选学院代表的方式有两种，一种是自己报名，另一种是被学院半数以上的学者联名推荐。"
        },
        {
          "role": "派蒙",
          "text": "嗯…我猜提纳里应该是后一种！"
        },
        {
          "role": "赛诺",
          "text": "我听说有不少学者自发为「提纳里前辈」拉票。"
        },
        {
          "role": "提纳里",
          "text": "…有时候真想用力敲打一下那些后辈的脑壳，让他们把心思多用在学习上。"
        },
        {
          "role": "旅行者",
          "text": "不能拒绝吗？"
        },
        {
          "role": "提纳里",
          "text": "也可以拒绝。不过我仔细考虑了一下，这对我来说也是个机会。"
        },
        {
          "role": "提纳里",
          "text": "下个月在化城郭会有一场生态科普讲座，如果我参加学院争霸赛，就可以借用比赛的人气，提前做一些宣传。"
        },
        {
          "role": "提纳里",
          "text": "至于夺不夺冠，我倒并不是很在意。不像我旁边这位。"
        },
        {
          "role": "旅行者",
          "text": "赛诺是自己报名的？"
        },
        {
          "role": "赛诺",
          "text": "嗯，抓紧最后一点假期。我听说奖品有限定版七圣召唤卡牌，就主动报名了。"
        },
        {
          "role": "赛诺",
          "text": "这次的卡牌很珍贵，错过了会很可惜。"
        },
        {
          "role": "派蒙",
          "text": "难道说…是仅此一张的超级强力卡牌？"
        },
        {
          "role": "赛诺",
          "text": "不，是一张很常见的卡，但卡面上有一层闪烁的银色碎粒。"
        },
        {
          "role": "派蒙",
          "text": "啊？有什么用吗？"
        },
        {
          "role": "赛诺",
          "text": "非常帅气。"
        },
        {
          "role": "派蒙",
          "text": "呃…我的意思是除了帅气之外呢？"
        },
        {
          "role": "赛诺",
          "text": "这个理由已经足够。我会全力以赴拿下冠军，将它加入我的牌组。"
        },
        {
          "role": "提纳里",
          "text": "像我这样不怎么打牌的人很难理解…不过每个人都有自己的参赛理由，倒也不足为奇。"
        },
        {
          "role": "派蒙",
          "text": "也对。走，我们再去问问其他人的理由吧。"
        },
         {
          "type": "subtitle",
          "text": "与卡维、珐露珊、莱依拉对话"
        },
        {
          "role": "派蒙",
          "text": "卡维、珐露珊、莱依拉！"
        },
        {
          "role": "卡维",
          "text": "欸？啊…哦，是你们啊。你们怎么来了？"
        },
        {
          "role": "派蒙",
          "text": "我们现在可是特邀评论员哦！负责记录整个比赛过程！"
        },
        {
          "role": "珐露珊",
          "text": "哦？那就拜托你们拍下我夺冠的瞬间了。"
        },
        {
          "role": "珐露珊",
          "text": "记得镜头从下往上打，多拍点背影特写，这样更有前辈的感觉！"
        },
        {
          "role": "卡维",
          "text": "话不要说的太满，要夺冠的明明是我才对！"
        },
        {
          "role": "珐露珊",
          "text": "想和我斗，你们还太年轻了。不管是刹诃伐罗的小鬼头，还是梨多梵谛的小崽子…"
        },
        {
          "role": "莱依拉",
          "text": "刚刚我就想问…珐露珊前辈认识我吗？"
        },
        {
          "role": "珐露珊",
          "text": "嗯？你不记得了吗？有时候晚上在图书馆见到你，你还会主动向我打招呼呢！"
        },
        {
          "role": "莱依拉",
          "text": "什么…！我完全没有印象！"
        },
        {
          "role": "珐露珊",
          "text": "真是一件奇事。不过现在不是探究的时候，我是知论派名宿珐露珊，你是明论派的莱依拉吧？"
        },
        {
          "role": "莱依拉",
          "text": "是，是的。"
        },
        {
          "role": "珐露珊",
          "text": "好，那我们就算正式认识了。你看，多简单的事呀。"
        },
        {
          "role": "珐露珊",
          "text": "我很喜欢你这样尊重前辈的好孩子，要不要来我的研究小组？"
        },
        {
          "role": "卡维",
          "text": "珐露珊前辈…这已经属于跨学派挖人了吧？还是不要强求比较好。"
        },
        {
          "role": "珐露珊",
          "text": "我知道，不过最近招不到人啊，研究经费就那么一点…"
        },
        {
          "role": "珐露珊",
          "text": "等我夺冠后，情况肯定就不一样了——"
        },
        {
          "role": "派蒙",
          "text": "难道说珐露珊是为了增加研究经费，才来参加比赛的？"
        },
        {
          "role": "珐露珊",
          "text": "倒也不只是这样…怎么，你们对我参赛的理由很好奇？"
        },
        {
          "role": "珐露珊",
          "text": "噢，说起来你们是特邀评论员，会问这些倒也正常。"
        },
        {
          "role": "珐露珊",
          "text": "最近有很多刚入学的新人，他们也会关注这次比赛。如果我能拿下冠军，将来肯定有数不清的学者慕名而来。"
        },
        {
          "role": "珐露珊",
          "text": "再加上夺冠还能获得学院内的项目资源，研究经费也不再是问题了。不好意思啦两位后辈，这次的冠军我势在必得！"
        },
        {
          "role": "莱依拉",
          "text": "我也会努力拿下冠军，至少不能输得太难看…"
        },
        {
          "role": "派蒙",
          "text": "莱依拉是为什么来参赛的呢？"
        },
        {
          "role": "莱依拉",
          "text": "不知道为什么，有很多人推荐了我。我明明没有报名，睡起来却发现名字已经出现在公告板上了。"
        },
        {
          "role": "派蒙",
          "text": "那就和提纳里差不多嘛！"
        },
        {
          "role": "莱依拉",
          "text": "提纳里前辈也是这样吗？"
        },
        {
          "role": "莱依拉",
          "text": "我…很紧张。总担心会辜负大家的期待…已经好几个晚上没有睡好了。"
        },
        {
          "role": "珐露珊",
          "text": "别紧张，后辈。失败是每个人成长的必修课。"
        },
        {
          "role": "莱依拉",
          "text": "可是前辈，可是我不想失败呀。"
        },
        {
          "role": "卡维",
          "text": "嘶…糟了。大家的参赛理由都这么正面的吗？"
        },
        {
          "role": "旅行者",
          "text": "卡维是为什么来参赛呢？"
        },
        {
          "role": "卡维",
          "text": "一定要说吗？"
        },
        {
          "role": "派蒙",
          "text": "一定要说哦！我们会记录下来的！"
        },
        {
          "role": "卡维",
          "text": "呃…就是…你们懂的吧？我想购置一套房产…"
        },
        {
          "role": "派蒙",
          "text": "噢！我知道了，你是想从艾尔海森那搬出——"
        },
        {
          "role": "卡维",
          "text": "咳咳咳咳！咳！艾尔海森？什么艾尔海森？这里有他什么事？"
        },
        {
          "role": "旅行者",
          "text": "派蒙记错了吧。"
        },
        {
          "role": "派蒙",
          "text": "啊、啊噢——！哎呀，对啊！真奇怪，刚刚不小心说错了…"
        },
        {
          "role": "派蒙",
          "text": "就是说，你看上了争霸赛的奖金，想用它买一套房子，对吧？"
        },
        {
          "role": "卡维",
          "text": "没错。另外在我小的时候，老爹曾经参加过学院争霸赛，不过没能夺冠。"
        },
        {
          "role": "卡维",
          "text": "等我拿下冠军，就有资格戴上那顶冠冕了吧。说不定，还能替老爹完成一个梦想。"
        },
        {
          "role": "珐露珊",
          "text": "这个理由不错呢，挺有志气。"
        },
        {
          "role": "珐露珊",
          "text": "虽然有我在，后辈夺冠的机会不大，但假如你真的能戴上才识之冠，我觉得你父亲应该会很高兴。"
        },
        {
          "role": "卡维",
          "text": "…可能没什么高兴的机会了吧。老爹他很多年前就去世了。听说是去沙漠旅行，运气不好碰上了流沙。"
        },
        {
          "role": "珐露珊",
          "text": "没想到后辈还经历过这种事，真不容易。"
        },
        {
          "role": "卡维",
          "text": "……"
        },
        {
          "role": "卡维",
          "text": "都过去了，人还是要活在当下不是吗？换个话题吧，要是气氛因为我变得沉重就糟糕了。"
        },
        {
          "role": "珐露珊",
          "text": "好吧。刚刚你说想用比赛奖金买一套房子，是打算自己住吗？你现在住哪呢？"
        },
        {
          "role": "卡维",
          "text": "咳咳…这个…"
        },
        {
          "role": "珐露珊",
          "text": "怎么感觉有点奇怪…刚刚我还听到「艾尔海森」，他不是我们知论派的人吗？你们是不是藏着什么秘密没告诉我？"
        },
        {
          "role": "卡维",
          "text": "怎么可能，你多心了，哈哈哈…"
        },
        {
          "role": "派蒙",
          "text": "不、不关派蒙的事哦！我们先去采访别的参赛者了！"
        },
        {
          "type": "subtitle",
          "text": "与流浪者对话"
        },
        {
          "role": "派蒙",
          "text": "呃…你…"
        },
        {
          "role": "流浪者",
          "text": "叫我阿帽吧，这是我在因论派挂的名字。"
        },
        {
          "role": "派蒙",
          "text": "阿帽听上去只是绰号不是名字吧！"
        },
        {
          "role": "流浪者",
          "text": "一个普普通通的名字，我不能用吗？"
        },
        {
          "role": "派蒙",
          "text": "好吧。阿帽选手，你为什么会来参加学院争霸赛？"
        },
        {
          "role": "派蒙",
          "text": "我们现在是特邀评论员哦，希望你好好回答我们的问题。"
        },
        {
          "role": "流浪者",
          "text": "你们就算是风纪官也没用。我不回答的话，你们能怎么办？"
        },
        {
          "role": "派蒙",
          "text": "你这家伙！"
        },
        {
          "role": "流浪者",
          "text": "哼。不妨告诉你，我答应过别人，不会把此行的目的透露出去。"
        },
        {
          "role": "派蒙",
          "text": "你，你该不会秘密计划着什么吧？"
        },
        {
          "role": "流浪者",
          "text": "难说呢。你们猜猜我打算干什么？"
        },
        {
          "role": "派蒙",
          "text": "你你你，气死我了！"
        },
        {
          "role": "派蒙",
          "text": "不说算了！那我们不问你参赛的原因，换个问题，你为什么会加入因论派？"
        },
        {
          "role": "流浪者",
          "text": "你们还真是喜欢刨根问底啊，不回答是不是就要一直听你们聒噪下去？"
        },
        {
          "role": "流浪者",
          "text": "…我听说因论派有个叫亚卡巴的学者在研究踏鞴砂事件，就写了几篇文章驳斥他的观点。"
        },
        {
          "role": "流浪者",
          "text": "后来闲着无聊，就顺便点评了几句稻妻的社会问题。没想到被因论派的人当成了同学，还有人邀请我去参加什么讲座。"
        },
        {
          "role": "流浪者",
          "text": "从头到尾不过是愚昧之人的一厢情愿而已，这种误会几句话就能解释清楚。"
        },
        {
          "role": "流浪者",
          "text": "但小吉祥草王得知这件事之后，竟然自作主张给我办理了因论派的学籍…用的还是「阿帽」这个名字。"
        },
        {
          "role": "旅行者",
          "text": "原来是纳西妲…"
        },
        {
          "role": "流浪者",
          "text": "话就聊到这吧。比起我，你们不如费心关注一下别人。"
        },
        {
          "role": "流浪者",
          "text": "有人很快就要倒霉了，猜猜是谁？"
        },
        {
          "role": "派蒙",
          "text": "你这家伙，一点都不让人放心！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们可不能放松警惕，一定要好好盯着他！"
        },
        {
          "type": "subtitle",
          "text": "与主持人对话"
        },
        {
          "role": "卡莉娜",
          "text": "我已经听说了，两位就是维卡斯新找来的特邀评论员吧？"
        },
        {
          "role": "卡莉娜",
          "text": "刚刚看你们聊得正开心，我就在附近等了一会儿。不知道两位现在方便吗？"
        },
        {
          "role": "派蒙",
          "text": "我们也正想去找你呢！"
        },
        {
          "role": "卡莉娜",
          "text": "那真是太好了，请允许我向你们详细介绍一下特邀评论员的工作。"
        },
        {
          "role": "卡莉娜",
          "text": "首先有两样东西，请你们收好。"
        },
        {
          "role": "卡莉娜",
          "text": "第一个是教令院特制的留影机，希望两位用它记录比赛过程。"
        },
        {
          "role": "卡莉娜",
          "text": "第二个是比赛专用的提示器，它会帮你们标注参赛者的位置。另外如果有参赛者完成比赛任务，提示器也会发出声响。"
        },
        {
          "role": "派蒙",
          "text": "听上去是很方便的道具呢！"
        },
        {
          "role": "卡莉娜",
          "text": "除了你们之外，还有两位评论员。不过他们平时会呆在评论席附近，不会全程记录每一位参赛者的行动。"
        },
        {
          "role": "卡莉娜",
          "text": "说起来，那两位你们应该也认识…分别是艾尔海森先生与妮露小姐。"
        },
        {
          "role": "派蒙",
          "text": "啊！是他们呀！等下我们也去打个招呼好了！"
        },
        {
          "role": "卡莉娜",
          "text": "那我就不多耽误两位的时间了。不知道你们还有什么问题吗？"
        },
        {
          "role": "旅行者",
          "text": "你们见过一位白发中年男性吗？"
        },
        {
          "role": "卡莉娜",
          "text": "嗯？为什么这么问？"
        },
        {
          "role": "旅行者",
          "text": "之前好像看到他站在台子上。"
        },
        {
          "role": "卡莉娜",
          "text": "是吗？我还真没有注意到，请问你是什么时候看到他的呢？"
        },
        {
          "role": "旅行者",
          "text": "就在学院代表上台之前。"
        },
        {
          "role": "卡莉娜",
          "text": "奇怪…那时候我一直在舞台上，并没有看到有人走上来呀。"
        },
        {
          "role": "派蒙",
          "text": "是啊，我也没有看到！"
        },
        {
          "role": "卡莉娜",
          "text": "呵呵…我想大概率是你看错了。不过如果你有什么新的线索，也可以随时找我——"
        },
        {
          "role": "迪希雅",
          "text": "旅行者、派蒙！好久不见啦！"
        },
        {
          "role": "派蒙",
          "text": "迪希雅、坎蒂丝，你们也来学院庆典了！"
        },
        {
          "role": "卡莉娜",
          "text": "看来是两位的朋友到了？那我就先告辞了，祝你们在学院庆典玩得开心。"
        },
        {
          "role": "坎蒂丝",
          "text": "教令院给我们也发了邀请函，迪希雅就提出一起来看看。"
        },
        {
          "role": "坎蒂丝",
          "text": "村子里的人也希望我出来走走，我很难拒绝他们的好意…"
        },
        {
          "role": "迪希雅",
          "text": "既然来了就别想那么多啦。就算学院庆典称不上什么节日，也是须弥城有名的盛会了。"
        },
        {
          "role": "迪希雅",
          "text": "四面八方的商人都会过来摆摊，各种吃的、用的、穿的商品数都数不清！"
        },
        {
          "role": "迪希雅",
          "text": "我早就想帮你挑两件衣服了。哪有人工作和生活穿同一套衣服的？"
        },
        {
          "role": "坎蒂丝",
          "text": "我也很期待。呼…光是像这样放空自己、四处闲逛，我就已经很开心了。"
        },
        {
          "role": "迪希雅",
          "text": "旅行者、派蒙，你们要不要一起来？"
        },
        {
          "role": "派蒙",
          "text": "唔…我也很想跟你们一起玩，但我们还有工作要做呢！"
        },
        {
          "role": "迪希雅",
          "text": "真可惜。等你们有空的时候，再来一起逛街吧。"
        },
        {
          "role": "派蒙",
          "text": "好呀！"
        },
        {
          "role": "迪希雅",
          "text": "那我们先走一步，好的成衣与好的布料都是要抢的，去晚了可就没啦！噢对，还要买几件配饰…"
        },
        {
          "role": "坎蒂丝",
          "text": "不用着急，我觉得慢慢逛比较开心。"
        },
        {
          "role": "坎蒂丝",
          "text": "再见了两位，闲下来的时候，可以随时来找我们玩哦。"
        },
        {
          "role": "派蒙",
          "text": "没想到迪希雅和坎蒂丝会来，真期待和她们一起逛街呀。不过比赛好像要开始了，我们先去艾尔海森那边看看吧。"
        },
        {
          "type": "subtitle",
          "text": "前往评论席附近"
        },
        {
          "role": "艾尔海森",
          "text": "下面我将依照规定宣布第一轮比赛的内容，请听好——"
        },
        {
          "role": "艾尔海森",
          "text": "在刚才的开幕式上，教令院的工作人员放飞了几笼蝴蝶，有相当多的蝴蝶飞到了须弥城内。"
        },
        {
          "role": "艾尔海森",
          "text": "那些蝴蝶里，有三只是经过特殊培育的「迅捷飞蝶」。它们的长相与一般蝴蝶不同，飞行速度也快了一点。"
        },
        {
          "role": "艾尔海森",
          "text": "本轮比赛的目标是找到迅捷飞蝶，并带回我这里。找到蝴蝶的人按照带来的先后顺序，将会依次获得3点、2点、1点积分。"
        },
        {
          "role": "艾尔海森",
          "text": "以上即是第一轮比赛的全部内容。还有什么不明白的地方，可以找其他工作人员解答。"
        },
        {
          "role": "派蒙",
          "text": "艾尔海森还是老样子，一副公事公办的态度。"
        },
        {
          "role": "派蒙",
          "text": "说起来他又是为什么来当特邀评论员的呢？真让人好奇！"
        },
        {
          "role": "莱依拉",
          "text": "在广阔的须弥城里找三只不一样的蝴蝶，怎么想都不太可能…"
        },
        {
          "role": "提纳里",
          "text": "如果迅捷飞蝶的习性与普通蝴蝶相近的话…"
        },
        {
          "role": "赛诺",
          "text": "我先走了。将须弥城从内到外完整地搜一遍，需要花不少时间。"
        },
        {
          "role": "卡维",
          "text": "啊？这就走了？"
        },
        {
          "role": "赛诺",
          "text": "赢家永远在胜利的路上！"
        },
        {
          "role": "珐露珊",
          "text": "刹诃伐罗的后辈，我有一个计划，要不要考虑跟我合作？"
        },
        {
          "role": "卡维",
          "text": "合作？"
        },
        {
          "role": "派蒙",
          "text": "看来面对这种困难的比赛，每个人都有自己的打算。"
        },
        {
          "role": "派蒙",
          "text": "接下来该我们上场了吧？总之先观察一下，看看他们的反应吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯？等一下，你看！他好像和我们一样，也在观察其他参赛者？"
        },
        {
          "role": "流浪者",
          "text": "…哼。"
        },
        {
          "role": "派蒙",
          "text": "果然不能掉以轻心！"
        },


         {
          "type": "subtitle",
          "text": "额外对话（卡维与珐露珊）"
        },
        {
          "role": "珐露珊",
          "text": "还记得上次我们做的那些东西吗？"
        },
        {
          "role": "卡维",
          "text": "哦？你的意思是…"
        },
        {
          "role": "珐露珊",
          "text": "是它们出场的时候了。"
        },
        {
          "role": "派蒙",
          "text": "卡维和珐露珊好像在密谋着什么！"
        },
        {
          "role": "卡维",
          "text": "噢，我和珐露珊前辈在商讨怎么——"
        },
        {
          "role": "珐露珊",
          "text": "等一下！这里人多眼杂，还是暂时保密为好。不过你们应该很快就能看到了。"
        },
        {
          "role": "珐露珊",
          "text": "走吧，必须赶在别人之前行动！"
        },
        {
          "role": "卡维",
          "text": "好！事不宜迟，我们现在就去做准备。等会儿见！"
        },
         {
          "type": "subtitle",
          "text": "额外对话（提纳里与柯莱）"
        },

        {
          "role": "提纳里",
          "text": "嗯…大概就是需要这些了，有什么困难吗？"
        },
        {
          "role": "柯莱",
          "text": "大部分药剂我都有带，剩下的应该也可以买到。"
        },
        {
          "role": "派蒙",
          "text": "柯莱，你也来啦！"
        },
        {
          "role": "派蒙",
          "text": "提纳里，你想到什么好办法了吗？"
        },
        {
          "role": "提纳里",
          "text": "我猜生物的一些基础习性并不会因变异发生太大差别，所以想利用这一点将迅捷飞蝶诱骗出来。"
        },
        {
          "role": "提纳里",
          "text": "当然，也说不定我的猜测是错误的。每一次变异都意味着一种全新的可能性，特别是人工诱导的变异…"
        },
        {
          "role": "提纳里",
          "text": "具体情况只能等试验后再说。我和柯莱先去采买实验需要的各种药剂了，回头再见。"
        },
        {
          "role": "派蒙",
          "text": "嗯，再见啦！"
        },









        {
          "type": "subtitle",
          "text": "与莱依拉对话"
        },
        {
          "role": "莱依拉",
          "text": "唉…"
        },
        {
          "role": "派蒙",
          "text": "莱依拉看起来好像很苦恼？"
        },
        {
          "role": "莱依拉",
          "text": "是呀，完全想不到该怎么办。迅捷飞蝶是什么颜色的呢？会有特别的花纹吗？和普通的蝴蝶有什么区别呢？"
        },
        {
          "role": "莱依拉",
          "text": "我连这些最基础的问题都搞不懂，学过的知识派不上什么用场…"
        },
        {
          "role": "流浪者",
          "text": "我记得你们研究星象的人不是挺有本事的吗，用个占星术不就找到了？"
        },
        {
          "role": "莱依拉",
          "text": "你是…阿帽选手？"
        },
        {
          "role": "流浪者",
          "text": "难道是因为在白天用不了占星术？看来这个本领也不怎么好用。"
        },
        {
          "role": "莱依拉",
          "text": "不是的。即使是在白天，想用占星术的话也有办法，只要有星盘…"
        },
        {
          "role": "派蒙",
          "text": "那莱依拉为什么不用呢？"
        },
        {
          "role": "莱依拉",
          "text": "阿斯托洛吉斯·莫娜·梅姬斯图斯前辈曾说，用占星术过度谋取不该属于自己的利益的人，最终会失去星空的赐福。"
        },
        {
          "role": "莱依拉",
          "text": "啊，这是我从学术报刊上看到的。我很喜欢看莫娜前辈写的文章…"
        },
        {
          "role": "流浪者",
          "text": "想多了，力量只是工具而已。看来你并没有戴上冠冕的决心，那就带着不成熟的想法自求多福吧。"
        },
        {
          "role": "派蒙",
          "text": "什么嘛！自顾自地说了一大堆，又自顾自地走了！"
        },
        {
          "role": "莱依拉",
          "text": "抱歉，我是不是说错话了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "有自己的坚持是好事。",
            "只是观点不同而已。"
          ]
        },
        
        {
          "role": "莱依拉",
          "text": "谢谢你们。我还是决定不用占星术，去城里碰碰运气吧。"
        },
        {
          "role": "莱依拉",
          "text": "我其实还比较擅长观察，如果幸运的话，说不定能发现那种特别的蝴蝶…"
        },
        {
          "role": "贝西",
          "text": "快去城里看热闹啊！赛诺大人好像找到迅捷飞蝶了！"
        },
        {
          "role": "阿莱",
          "text": "真的假的！他人呢？"
        },
        {
          "role": "贝西",
          "text": "蝴蝶飞往高处，赛诺大人正在赶过去——"
        },
        {
          "role": "阿莱",
          "text": "我们现在就出发！"
        },
        {
          "role": "莱依拉",
          "text": "不愧是赛诺前辈…啊，你们是不是也过去看看比较好？赛诺前辈抓到蝴蝶，这一幕应该很值得记录吧。"
        },
        {
          "role": "莱依拉",
          "text": "等会儿我也会进城去找一找，到时候再见吧。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那我们先去赛诺那边，之后再看看其他人在做什么吧！"
        },
        {
          "type": "subtitle",
          "text": "与赛诺对话"
        },
        {
          "role": "派蒙",
          "text": "赛诺，可算找到你啦——等等，难道那就是迅捷飞蝶？"
        },
        {
          "role": "赛诺",
          "text": "呆在那别动…"
        },
        {
          "role": "派蒙",
          "text": "抓、抓到了！"
        },
        {
          "role": "派蒙",
          "text": "嗯？赛诺你怎么了？"
        },
        {
          "role": "赛诺",
          "text": "这不是要找的蝴蝶。这是——"
        },
        {
          "role": "卡维",
          "text": "呼…总算爬上来了。赛诺，听说你抓到迅捷飞蝶了，拜托让我看下长什么样子…"
        },
        {
          "role": "卡维",
          "text": "嘶…这不是我放出去的机械诱饵吗！我说你啊，不去抓迅捷飞蝶，抓我放的诱饵干什么？"
        },
        {
          "role": "珐露珊",
          "text": "等等后辈。换个角度想想，你做的假蝴蝶连赛诺都能骗过，这不是一件好事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你放的？",
            "诱饵？"
          ]
        },
      
        {
          "role": "卡维",
          "text": "是啊。以前有一次做室内设计的时候，我觉得墙上的假花太单调，就想放置一些会动的机械蝴蝶做点缀。"
        },
        {
          "role": "卡维",
          "text": "为了能做出小巧又灵活的机械蝴蝶，我特地向珐露珊前辈请教过。"
        },
        {
          "role": "卡维",
          "text": "然后不久前，我和珐露珊前辈取出了所有的机械蝴蝶，放飞到了城内——"
        },
        {
          "role": "派蒙",
          "text": "这么做有什么意义吗？"
        },
        {
          "role": "珐露珊",
          "text": "哼，连这个也要问，现在的年轻人真是少见多怪呀。"
        },
        {
          "role": "珐露珊",
          "text": "你们没玩过那个游戏吗？把纸片拴在竹竿上，带去花田挥呀挥，就能引来一大串蝴蝶。"
        },
        {
          "role": "赛诺",
          "text": "还真没玩过。"
        },
        {
          "role": "赛诺",
          "text": "嗯？你该不会是想…"
        },
        {
          "role": "珐露珊",
          "text": "没错。须弥城里面的蝴蝶，会将我们的机械诱饵当做同类，跟在它们的身后。"
        },
        {
          "role": "珐露珊",
          "text": "我们只要不停地放出和收回诱饵，就能将城内的蝴蝶一网打尽，之后再甄别其中的迅捷飞蝶就好！"
        },
        {
          "role": "派蒙",
          "text": "居然还有这种办法！"
        },
        {
          "role": "珐露珊",
          "text": "可不要小瞧前辈的智慧哦。在听到比赛内容的时候，我就已经想好取胜的方法了。"
        },
        {
          "role": "珐露珊",
          "text": "当然，也多亏了后辈能做出这么惟妙惟肖的机械蝴蝶。看来刹诃伐罗这些年也不算一无是处，起码在教书育人上还有点成绩。"
        },
        {
          "role": "卡维",
          "text": "我只是做好我擅长的事而已，点子还是前辈想出来的。"
        },
        {
          "role": "珐露珊",
          "text": "不必客气。等我们将城内的蝴蝶一网打尽，就平分这一轮比赛的积分…"
        },
        {
          "role": "珐露珊",
          "text": "快看，已经有机械诱饵飞回来了——不对，诱饵后面怎么是空的？是我开始眼花了吗？"
        },
        {
          "role": "派蒙",
          "text": "就是什么也没有啦！你们的方法好像失灵了！"
        },
        {
          "role": "赛诺",
          "text": "看来比赛还要继续下去了。我再去别处找找。"
        },
        {
          "role": "珐露珊",
          "text": "奇怪…难道说有什么东西引开了蝴蝶的注意力…"
        },
        {
          "role": "珐露珊",
          "text": "走，后辈！顺着诱饵飞回来的方向找一找！"
        },
        {
          "role": "派蒙",
          "text": "我们也跟上去看看！"
        },
        {
          "type": "subtitle",
          "text": "跟随卡维和珐露珊"
        },
        {
          "type": "subtitle",
          "text": "调查蝴蝶停驻的真相"
        },
        {
          "role": "派蒙",
          "text": "珐露珊、卡维，你们怎么停下来了？"
        },
        {
          "role": "珐露珊",
          "text": "原来是阿弥利多的小子…"
        },
        {
          "role": "派蒙",
          "text": "是提纳里！"
        },
        {
          "role": "提纳里",
          "text": "很神奇吧？蝴蝶驻足在这里，是因为我用了一种特别的熏香。"
        },
        {
          "role": "提纳里",
          "text": "我在熏香中添加了三种不同的花蜜，蝴蝶顺着香味找来，就会环绕在我的周围。"
        },
        {
          "role": "胡瓦",
          "text": "那蝴蝶的鼻子一定很灵敏吧！"
        },
        {
          "role": "胡瓦",
          "text": "说起来…蝴蝶有鼻子吗？我好像没见过。"
        },
        {
          "role": "提纳里",
          "text": "蝴蝶是没有鼻子的，它们的视力也不太好。"
        },
        {
          "role": "提纳里",
          "text": "但是蝴蝶可以靠触角分辨出气味，而且嗅觉相当发达，可以感知到很远之外的花香。"
        },
        {
          "role": "胡瓦",
          "text": "原来是这样！我以前也养过蝴蝶。我记得我曾经去野外采花，铺在盒子里，可是它没有吃…"
        },
        {
          "role": "提纳里",
          "text": "很正常。饲养蝴蝶虽然不算困难，但也有很多需要注意的地方。"
        },
        {
          "role": "提纳里",
          "text": "比如气温是否适宜、空气是否充足、空间是否宽敞等等。另外也要考虑挑选的食物是否合它的「胃口」。"
        },
        {
          "role": "提纳里",
          "text": "最重要的是不要出于好奇，时不时地打扰它休息，让它感受到压力。"
        },
        {
          "role": "胡瓦",
          "text": "对不起，我当时经常用手指去戳它的翅膀…"
        },
        {
          "role": "提纳里",
          "text": "人类会为了观赏而饲养很多生物，但并非所有的生物都适合被饲养。"
        },
        {
          "role": "提纳里",
          "text": "照看生命是一件很辛苦的工作，至少要提前学习一些相关知识，不能只靠一时冲动。"
        },
        {
          "role": "哈亚提",
          "text": "感觉你懂得好多！"
        },
        {
          "role": "哈比卜",
          "text": "我也有个问题。前不久我买到了一只圣金虫，但它一直没精打采的，能请您帮忙看看原因吗？"
        },
        {
          "role": "艾玛尔",
          "text": "我想养一只暝彩鸟，不知道要注意什么呢？"
        },
        {
          "role": "马哈",
          "text": "嗯——请问长鬓虎能养吗？"
        },
        {
          "role": "提纳里",
          "text": "好了，看得出来大家有很多问题想问。"
        },
        {
          "role": "提纳里",
          "text": "不过我正在参加学院争霸赛，没有时间一一解答。"
        },
        {
          "role": "提纳里",
          "text": "这样吧，下个月在化城郭会有一场生物科普讲座，到时候我会讲一些有趣的生物知识。"
        },
        {
          "role": "提纳里",
          "text": "大家如果感兴趣的话，可以过来听。如果有什么想问的问题，也可以提前准备好，我会在讲座后逐个回答。"
        },
        {
          "role": "胡瓦",
          "text": "好欸！我也要去！"
        },
        {
          "role": "提纳里",
          "text": "当然，希望大家问点正常的问题。比如长鬓虎能不能养…主要取决于你能不能打得过它。"
        },
        {
          "role": "派蒙",
          "text": "提纳里真的在宣传科普讲座，感觉效果很不错呢！"
        },
        {
          "role": "珐露珊",
          "text": "糟了，一不小心听了这么久！"
        },
        {
          "role": "珐露珊",
          "text": "不愧是柯莱的师父，还真有几分老师的派头。"
        },
        {
          "role": "卡维",
          "text": "前辈，我刚刚去附近转了转，这里的蝴蝶几乎全部被熏香引来了。"
        },
        {
          "role": "卡维",
          "text": "不过我们可以把机械诱饵放到更远的地方，避开这片区域。"
        },
        {
          "role": "珐露珊",
          "text": "那我们开始行动，不能让所有的蝴蝶都被抢走了！"
        },
        {
          "role": "派蒙",
          "text": "感觉比赛逐渐激烈起来了…旅行者，我们再去看看其他参赛者在做什么吧！"
        },
        {
          "type": "subtitle",
          "text": "观察记录其它参赛者的情况"
        },
        {
          "role": "派蒙",
          "text": "莱依拉！你这边有什么进展吗？"
        },
        {
          "role": "莱依拉",
          "text": "我已经找了很久了，暂时并没有看到迅捷飞蝶。"
        },
        {
          "role": "莱依拉",
          "text": "反而在屋顶上抓到了几只长得很像蝴蝶的机械机关，也不知道是从哪里来的。"
        },
        {
          "role": "派蒙",
          "text": "看来到处都有珐露珊和卡维放出来的机关…"
        },
        {
          "role": "莱依拉",
          "text": "我会再努力找一找。不过从刚刚开始，我注意到城里的蝴蝶少了很多。"
        },
        {
          "role": "莱依拉",
          "text": "应该是其他参赛者都想到了办法吧？我也会用心去观察的…嗯？"
        },
        {
          "role": "派蒙",
          "text": "这个是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "难道说…",
            "是迅捷飞蝶？"
          ]
        },
       
        {
          "role": "莱依拉",
          "text": "居然在这里碰到了。接下来…抓到它就好了吧？"
        },
        {
          "role": "莱依拉",
          "text": "请等一下…啊，飞走了——"
        },
        {
          "role": "派蒙",
          "text": "好快的速度！艾尔海森那家伙，还说什么「飞行速度快了一点」，明明快了好多！"
        },
        {
          "role": "莱依拉",
          "text": "等等！"
        },
        {
          "role": "派蒙",
          "text": "我们也跟上去！"
        },
        {
          "type": "subtitle",
          "text": "跟随莱依拉"
        },
        {
          "type": "subtitle",
          "text": "与迪希雅和坎蒂斯对话"
        },
        {
          "role": "迪希雅",
          "text": "哎，我突然想到，得给你也买一个化妆盒。"
        },
        {
          "role": "坎蒂丝",
          "text": "算了吧，感觉用不上。"
        },
        {
          "role": "迪希雅",
          "text": "平时或许用不上，但是准备一个也没坏处不是吗？"
        },
        {
          "role": "迪希雅",
          "text": "好啦，听我的准没错…"
        },
        {
          "role": "迪希雅",
          "text": "你是谁，找我有什么事吗？"
        },
        {
          "role": "莱依拉",
          "text": "请…请不要动…"
        },
        {
          "role": "迪希雅",
          "text": "让我不准动？谁派你来的？"
        },
        {
          "role": "坎蒂丝",
          "text": "迪希雅…"
        },
        {
          "role": "迪希雅",
          "text": "放心，小麻烦而已——你干什么？"
        },
        {
          "role": "坎蒂丝",
          "text": "你是在找这个吧。给你，拿好了。"
        },
        {
          "role": "迪希雅",
          "text": "蝴蝶？刚刚停在我头上吗？"
        },
        {
          "role": "莱依拉",
          "text": "你是——"
        },
        {
          "role": "坎蒂丝",
          "text": "好久不见，莱依拉。"
        },
        {
          "role": "迪希雅",
          "text": "朋友？唔，难道是之前提过的那个…"
        },
        {
          "role": "派蒙",
          "text": "对呀，你们两个什么时候认识的？"
        },
        {
          "role": "莱依拉",
          "text": "唔…有段时间了。我第一次梦游醒来的时候，发现自己不知道怎么到了阿如村。那时受过坎蒂丝小姐照顾…"
        },
        {
          "role": "坎蒂丝",
          "text": "是呀，她看起来不太好，我请她吃了些东西。我还听她说了很多难懂的东西。占卜，夜空，晚星…听上去都很浪漫呢。"
        },
        {
          "role": "坎蒂丝",
          "text": "对了，这个蝴蝶你不想要吗？我看你是追着它跑过来的。"
        },
        {
          "role": "坎蒂丝",
          "text": "我留着也没什么用，如果你不需要的话，我就放飞了？"
        },
        {
          "role": "迪希雅",
          "text": "还是收下吧，别客气。"
        },
        {
          "role": "派蒙",
          "text": "迅捷飞蝶明明速度那么快，坎蒂丝却很轻易地将它抓住了。"
        },
        {
          "role": "坎蒂丝",
          "text": "在我眼里并没有多快。我还担心自己会弄伤它，好在最后没出什么意外。"
        },
        {
          "role": "迪希雅",
          "text": "刚才抱歉啦，看你突然冲过来，还以为是哪里派来的刺客呢。"
        },
        {
          "role": "迪希雅",
          "text": "哈哈，虽然应该没有熬夜熬出黑眼圈的刺客。你是在参加比赛？再重要的比赛也不能忘了休息啊。"
        },
        {
          "role": "莱依拉",
          "text": "我会注意的，谢谢你们。"
        },
        {
          "role": "迪希雅",
          "text": "那我们继续去逛街了，回头再见。"
        },
        {
          "role": "派蒙",
          "text": "我们也先和莱依拉一起把迅捷飞蝶带回去吧！"
        },
        {
          "type": "subtitle",
          "text": "返回主会场"
        },
        {
          "role": "艾尔海森",
          "text": "看来已经有第三位参赛者带回了迅捷飞蝶。"
        },
        {
