        {
          "role": "黑蛋",
          "text": "我们的名字是…"
        },
        {
          "role": "黑蛋",
          "text": "伊比尼伯龙…"
        },
        {
          "role": "黑蛋",
          "text": "乌吉恩…"
        },
        {
          "role": "黑蛋",
          "text": "玛歌洁蒂…"
        },
        {
          "role": "黑蛋",
          "text": "卢沙里姆…"
        },
        {
          "role": "黑蛋",
          "text": "宁希基娅…"
        },
        {
          "role": "黑蛋",
          "text": "向所有能听见的你…致意…"
        },
        {
          "role": "黑蛋",
          "text": "朋友们…谢谢…我们在星空下…再见吧…"
        },
