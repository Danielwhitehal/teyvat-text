{
  "quest_id": 10228,
  "chapter_num": "望月·第三幕",
  "chapter_title": "望月者计划",
  "type": "wq",
  "route": "Project Moongazer",
  "stories": [
    {
      "story_id": 76131,
      "title": "望月者计划",
      "description": "在先前的冒险中，你们得知了一些很有分量的秘辛，可望月者计划与宁宁的谜团依旧没有解开，于是，你们决定出发调查此行的最后一站…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往月亮背面"
        },
        {
          "role": "哥伦比娅",
          "text": "准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": [
                {
                  "role": "哥伦比娅",
                  "text": "那我们出发了，像刚才一样跟紧我。"
                }
              ]
            },
            {
              "text": "稍等一下。",
              "dialogues": [
                {
                  "role": "哥伦比娅",
                  "text": "嗯，我就在这等你。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往月亮背面"
        },
        {
          "role": "黑蛋",
          "text": "所以，你们作为朋友是怎么相处的呢？"
        },
        {
          "role": "派蒙",
          "text": "唔…互相分享好吃的？"
        },
        {
          "role": "哥伦比娅",
          "text": "派蒙在美食方面品味很好，特别是零食。"
        },
        {
          "role": "哥伦比娅",
          "text": "我们也经常一起聊天、做游戏…就在银月之庭。"
        },
        {
          "role": "黑蛋",
          "text": "我记得那里，很漂亮，还有其它月灵，但我忘记了和她们交朋友…"
        },
        {
          "role": "派蒙",
          "text": "因为你只记得你的使命了嘛！没关系，等我们完成了这件事，再让哥伦比娅带你去就好了！"
        },
        {
          "role": "哥伦比娅",
          "text": "可以哦。"
        },
        {
          "role": "派蒙",
          "text": "到时候可以玩些热闹的派对游戏？反正那里不会吵到别人。"
        },
        {
          "role": "旅行者",
          "text": "月球派对也不会吵到别人吧？"
        },
        {
          "role": "派蒙",
          "text": "对哦…还是月球派对更新鲜！"
        },
        {
          "role": "黑蛋",
          "text": "嘿嘿，好像很有趣。"
        },
        {
          "role": "派蒙",
          "text": "快看！前面好像有东西！"
        },
        {
          "role": "哥伦比娅",
          "text": "我们快到了。"
        },
        {
          "role": "派蒙",
          "text": "好、好大！！这是什么武器基地吗？"
        },
        {
          "role": "派蒙",
          "text": "跟前面的感觉都不一样，好像很危险…"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，它看起来很冰冷，但不知道为什么，我有一种…奇怪的熟悉感。"
        },
        {
          "role": "派蒙",
          "text": "熟悉感？哥伦比娅以前进来过这里吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "我只在外围用月矩力探查过。所以我也不知道这种熟悉感从何而来。"
        },
        {
          "role": "哥伦比娅",
          "text": "我们深入探索一下吧。"
        },
        {
          "type": "subtitle",
          "text": "设法进入基地内部"
        },
        {
          "role": "派蒙",
          "text": "有什么东西过来了，快躲开！"
        },
        {
          "role": "派蒙",
          "text": "被那些探照灯射中大概会触发警报之类的吧，也要躲开。"
        },
        {
          "role": "派蒙",
          "text": "好、好多探照灯！快跟着货箱躲开它们！"
        },
        {
          "role": "派蒙",
          "text": "箱子挡在了前面，别撞上去了。"
        },
        {
          "role": "哥伦比娅",
          "text": "前面的探照灯太密集了，我们找找另外的路。"
        },
        {
          "role": "派蒙",
          "text": "那些飘着的东西感觉很危险，可不要碰到了。"
        },
        {
          "role": "派蒙",
          "text": "又是探照灯！还好这里也有一些货箱，快跟着它们。"
        },
        {
          "role": "派蒙",
          "text": "不好，好像被探照灯发现了！"
        },
        {
          "role": "哥伦比娅",
          "text": "我们加速冲过去。"
        },
        {
          "role": "派蒙",
          "text": "快看！那里是不是入口？"
        },
        {
          "type": "subtitle",
          "text": "设法进入基地内部"
        },
        {
          "role": "哥伦比娅",
          "text": "看起来，从这里可以深入这座基地。"
        },
        {
          "role": "派蒙",
          "text": "没想到这座基地居然还在好好地运行着，不可思议。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是强劲的龙族科技。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "那我们也不要去打扰它们吧。"
        },
        {
          "role": "派蒙",
          "text": "你是这么想的吗？我还以为有你在，我们可以直接把这里搜个底朝天呢！"
        },
        {
          "role": "黑蛋",
          "text": "你不怕变成来月亮时那样吗？差点就乘不上飞船了。"
        },
        {
          "role": "派蒙",
          "text": "啊…你不说我都忘了，真可恶！为什么基地里会有自爆系统这种东西啊…"
        },
        {
          "role": "派蒙",
          "text": "看来我们只能像以前一样，静悄悄地摸进去了。"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，我也很想知道里面有什么。潜入自己「家」的感觉还挺新奇。"
        },
        {
          "role": "哥伦比娅",
          "text": "而且站在这里，那种奇怪的熟悉感更深了…"
        },
        {
          "type": "subtitle",
          "text": "深入基地"
        },
        {
          "type": "subtitle",
          "text": "激活终端"
        },
        {
          "role": "派蒙",
          "text": "太好了！这里又有一个终端！"
        },
        {
          "role": "派蒙",
          "text": "轮到你表现了，黑蛋！"
        },
        {
          "role": "黑蛋",
          "text": "终端已激活，正在申请获得基地数据。"
        },
        {
          "role": "黑蛋",
          "text": "基地数据已获得。"
        },
        {
          "role": "黑蛋",
          "text": "开始检索「望月者计划」…无内容。"
        },
        {
          "role": "黑蛋",
          "text": "开始检索「卢沙里姆」…有了！"
        },
        {
          "role": "黑蛋",
          "text": "我在基地内部找到了一个卢沙里姆的研究室。"
        },
        {
          "role": "派蒙",
          "text": "哦？果然有收获，我们快去那里看看！"
        },
        {
          "role": "黑蛋",
          "text": "正在读取基地工程蓝图与路线，嗯…向前进就能抵达。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有什么其他情报吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "黑蛋",
          "text": "开始检索其他信息…嗯？「从星海间返回的漆黑之王」？"
        },
        {
          "role": "派蒙",
          "text": "这是什么？"
        },
        {
          "role": "黑蛋",
          "text": "信息显示，这座基地的存在…源自那位「漆黑之王」的意志。"
        },
        {
          "role": "黑蛋",
          "text": "它的建成时间，也比我们之前见过的设施要晚许多。它的底部通向月心，那里被挖出了一道罅缝。"
        },
        {
          "role": "黑蛋",
          "text": "源源不断的古月之力从月心罅缝涌出，成为了基地的能源。"
        },
        {
          "role": "黑蛋",
          "text": "它的目的，是将月球打造成…天基武器！"
        },
        {
          "role": "派蒙",
          "text": "天、天基武器？那难道那位「漆黑之王」是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大概就是归来的龙王尼伯龙根。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是龙王回来了？！我们也太厉害了吧，这是闯到什么地方来了？"
        },
        {
          "role": "派蒙",
          "text": "天理来完龙王来，龙王来完我们来！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "向着星辰与深渊。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这样说的话…前面的路我们得打起十二分警惕了。"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅，万一有不对劲的事，你要保护好我们呀…咦？哥伦比娅？哥伦比娅呢？"
        },
        {
          "role": "派蒙",
          "text": "旅行者！哥伦比娅不见了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…是什么时候？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "完全没有感觉到…黑蛋，你看见哥伦比娅了吗？"
        },
        {
          "role": "黑蛋",
          "text": "没有，我一直在读取终端里的信息…"
        },
        {
          "role": "派蒙",
          "text": "糟、糟糕了啊…保护我们的人居然不见了！有鬼啊！"
        },
        {
          "role": "旅行者",
          "text": "（哥伦比娅绝对不会不告而别，一定有其他原因。）"
        },
        {
          "role": "旅行者",
          "text": "（会和黑蛋有关吗？不，她一直在读取终端的信息。）"
        },
        {
          "role": "旅行者",
          "text": "（那难道是…？）"
        },
        {
          "role": "哥伦比娅",
          "text": "而且站在这里，那种奇怪的熟悉感更深了…"
        },
        {
          "role": "旅行者",
          "text": "（看来哥伦比娅消失的原因和她所说的熟悉感有关，这座基地里到底有什么？）"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们现在可怎么办呀？！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "去卢沙里姆的研究室。",
              "dialogues": [
                {
                  "role": "黑蛋",
                  "text": "嗯，那里一定有关于这座基地的秘密，或许也能找到关于哥伦比娅消失的线索。"
                }
              ]
            },
            {
              "text": "事已至此，先撤退吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我知道你是想开个玩笑让我别害怕…嗯…我要鼓起勇气！"
                },
                {
                  "role": "派蒙",
                  "text": "我们要去找哥伦比娅，我们不会把她丢在这里的！"
                },
                {
                  "role": "黑蛋",
                  "text": "我们应该去卢沙里姆的研究室。那里一定有关于这座基地的秘密，或许也能找到关于哥伦比娅消失的线索。"
                }
              ]
            }
          ]
        },
        {
          "role": "黑蛋",
          "text": "但我们的路线要经过前方的警戒设施，不能触发基地的全面警报。"
        },
        {
          "role": "派蒙",
          "text": "有没有办法关闭这些警戒设施？让我看看…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "观察（中间）",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那边就是通向卢沙里姆研究室的路线，但我们要先想办法关闭警戒设施。"
                }
              ]
            },
            {
              "text": "观察（左下）",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这个房间好像可以通向二楼。"
                }
              ]
            },
            {
              "text": "观察（左上、右上）",
              "dialogues": [
                {
                  "role": "黑蛋",
                  "text": "工程蓝图显示，左侧二楼和右侧二楼的房间是警戒控制室。"
                }
              ]
            },
            {
              "text": "观察（右下）",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好像已经崩塌了，没有能通过的路。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "看起来，我们要先走左边的房间上到二楼，那里是警戒控制室。"
        },
        {
          "role": "派蒙",
          "text": "找个办法，溜进去看看吧？"
        },
        {
          "type": "subtitle",
          "text": "设法关闭前方的警戒设施"
        },
        {
          "type": "subtitle",
          "text": "调查左侧控制室"
        },
        {
          "role": "派蒙",
          "text": "我们最好别被那些巡逻机器发现了。"
        },
        {
          "role": "派蒙",
          "text": "呜哇！是防卫机器！"
        },
        {
          "role": "派蒙",
          "text": "呼！还好你三两下就解决了。这下应该可以继续前进了。"
        },
        {
          "type": "subtitle",
          "text": "调查左侧控制室"
        },
        {
          "role": "派蒙",
          "text": "这个东西是不是可以关闭警戒设施？"
        },
        {
          "role": "黑蛋",
          "text": "没错，这就是警戒控制器。"
        },
        {
          "role": "黑蛋",
          "text": "但是似乎要在短时间内将这里和右侧房间的警戒控制器一起关闭才行。"
        },
        {
          "role": "派蒙",
          "text": "也就是说，关闭了这里的控制器后，要尽快抵达另一间控制室，对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白了。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "调查机关"
        },
        {
          "type": "subtitle",
          "text": "在时限内关闭两个警戒控制器"
        },
        {
          "role": "派蒙",
          "text": "前面也有巡逻机器，小心点。"
        },
        {
          "role": "派蒙",
          "text": "这个房间的东西好像都被埋了起来…"
        },
        {
          "type": "subtitle",
          "text": "继续前进"
        },
        {
          "role": "派蒙",
          "text": "太好了！警戒解除了。这样就能顺利前进了吧？"
        },
        {
          "role": "派蒙",
          "text": "这里又是什么地方？感觉戒备更加森严了！"
        },
        {
          "type": "subtitle",
          "text": "继续前进"
        },
        {
          "role": "派蒙",
          "text": "不好！被发现了！"
        },
        {
          "role": "黑蛋",
          "text": "这边！"
        },
        {
          "type": "subtitle",
          "text": "继续前进"
        },
        {
          "role": "派蒙",
          "text": "呼…这个地方好像暂时是安全的。"
        },
        {
          "type": "subtitle",
          "text": "设法穿过探照灯封锁区"
        },
        {
          "role": "派蒙",
          "text": "又是这么多探照灯…这要怎么过去？"
        },
        {
          "role": "黑蛋",
          "text": "能不能用什么制造一些视线盲区呢？"
        },
        {
          "type": "subtitle",
          "text": "在研究室内寻找线索"
        },
        {
          "role": "派蒙",
          "text": "这里就是卢沙里姆的研究室了吧？我们终于到了！"
        },
        {
          "role": "派蒙",
          "text": "赶快四处搜索一下看看吧。"
        },
        {
          "type": "subtitle",
          "text": "在研究室内寻找线索"
        },
        {
          "role": "派蒙",
          "text": "咦？这个东西好像还能用。"
        },
        {
          "role": "派蒙",
          "text": "会不会有什么情报呢，打开看看。"
        },
        {
          "type": "subtitle",
          "text": "望月者的摹刻·卷一"
        },
        {
          "type": "subtitle",
          "text": "（在此记录「星之黑体」传递的讯息，本篇为删去所有无关内容的关键信息通译版本，原本无法理解的词汇已使用我们自己的概念取代——卢沙里姆。）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "遥远世界的朋友啊，很高兴你能收到这条讯息。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "我不知道我们的声音能否被聆听到，但我想，它至少能为这冰冷的宇宙驱散一些死寂。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "如果真有一个你听见了，那说明一定存在着某种特别的引力捕捉了我们。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "所以，我希望你们的文明知道，在这片无垠的星空下，你们并不孤单。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在你接收到这段消息的时候，我们的时代应该已经落幕了。漆黑的毁灭正在宇宙间蔓延，它是一切生命的死敌。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "——请你们警惕。我们不知道你们身处何方，但我们发出这条讯息，希望它能在黑暗袭击你们前赶到。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "这条消息——它微不足道，但它是我们的光。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "希望它能鼓舞你们，因为在这片星空下，你们不是在独自地迎接未知与黑暗。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "如果可以，请继续发出你们的光吧，一束光很微弱，很容易被黑暗吞没。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "但只要在它消失前，有另一束光亮起，那么总有一天，总有一束光，会成为刺破夜幕的曙光。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "（给我的「女儿」，宁宁。月之女神为我们的计划提供的关键支持在月心，你可以通过罅隙抵达，别忘了去。）",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "这就是那只星空生物传递给龙族的消息吗…"
        },
        {
          "role": "黑蛋",
          "text": "原来是这样…"
        },
        {
          "role": "派蒙",
          "text": "所以说，望月者计划，指的就是把这样的消息重新发送入宇宙？"
        },
        {
          "role": "派蒙",
          "text": "只是这样的话，用那座「伊比尼伯龙之眼」就可以办到吧？"
        },
        {
          "role": "派蒙",
          "text": "是不是还有什么内容我漏看了？我再检查一下！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！末尾果然还有一段注脚！"
        },
        {
          "role": "派蒙",
          "text": "「给我的『女儿』，宁宁」"
        },
        {
          "role": "派蒙",
          "text": "宁宁？！等等…黑蛋，你是卢沙里姆的女儿？！"
        },
        {
          "role": "派蒙",
          "text": "那你怎么也变成了现在这个样子？！"
        },
        {
          "role": "黑蛋",
          "text": "怎么会…我不知道…我没有这些记忆。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们得去月心那里看看。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那、那哥伦比娅呢？还没找到她消失的线索…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她的消失或许也和月心有关。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦，她前面说的熟悉的感觉，也只可能是月心了…我们快走！"
        },
        {
          "type": "subtitle",
          "text": "前往月心"
        },
        {
          "type": "subtitle",
          "text": "抵抗重力异常"
        },
        {
          "role": "派蒙",
          "text": "怎、怎么回事？突然身体变得好重…"
        },
        {
          "role": "派蒙",
          "text": "我快要飞不起来了…"
        },
        {
          "role": "派蒙",
          "text": "怎么又飘起来了！"
        },
        {
          "role": "派蒙",
          "text": "我有点想吐…"
        },
        {
          "role": "派蒙",
          "text": "又、又来了！"
        },
        {
          "type": "subtitle",
          "text": "与哥伦比娅交谈"
        },
        {
          "role": "派蒙",
          "text": "咦？重力好像变正常了…"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅！你回来了！是你解决了刚才的问题吗？真是太及时了…"
        },
        {
          "role": "派蒙",
          "text": "我们真是好担心，你去了哪里呀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还好吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "很抱歉，我没想到，这个基地的深处居然通向了月心。那里凝聚了浓度极高的古月之力。"
        },
        {
          "role": "哥伦比娅",
          "text": "之前我用月矩力渗透这座基地的时候，无意中触碰到了，因此被那股力量卷入了月心。"
        },
        {
          "role": "派蒙",
          "text": "果然是去了月心…我差点以为这座基地闹鬼了呢！"
        },
        {
          "role": "派蒙",
          "text": "总之你没事就太好了，我们刚才发现了望月者计划的新线索，是…"
        },
        {
          "role": "哥伦比娅",
          "text": "派蒙，我已经在月心知晓了真相…"
        },
        {
          "role": "哥伦比娅",
          "text": "宁宁，我也知道你是谁了。"
        },
        {
          "role": "黑蛋",
          "text": "看来我的使命就在那里，请带我去吧。"
        },
        {
          "role": "哥伦比娅",
          "text": "唔…"
        },
        {
          "role": "派蒙",
          "text": "怎么了吗？哥伦比娅？你看起来不想让宁宁这么做…"
        },
        {
          "role": "哥伦比娅",
          "text": "宁宁她…无法在月心的环境中生存。"
        },
        {
          "role": "黑蛋",
          "text": "但我必须完成使命。"
        },
        {
          "role": "哥伦比娅",
          "text": "你的使命不在那里。"
        },
        {
          "role": "黑蛋",
          "text": "什么？"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，你的使命不在月心。你的使命在最初的地方。"
        },
        {
          "role": "派蒙",
          "text": "是…「伊比尼伯龙之眼」？"
        },
        {
          "role": "哥伦比娅",
          "text": "对，你的使命，是启动「伊比尼伯龙之眼」的望月者计划。"
        },
        {
          "role": "哥伦比娅",
          "text": "那需要一把由古月之力构成的信息钥匙，我可以再次前往月心，为你取来它，但这需要一些时间。"
        },
        {
          "role": "黑蛋",
          "text": "你是让我…回到「伊比尼伯龙之眼」等待吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "你觉得这样可以吗？"
        },
        {
          "role": "黑蛋",
          "text": "不，如果我不能亲自去拿钥匙…我就在这里等你。"
        },
        {
          "role": "黑蛋",
          "text": "你不回来…我就不会离开。"
        },
        {
          "role": "黑蛋",
          "text": "我想在这里…等着我的朋友回来…"
        },
        {
          "role": "哥伦比娅",
          "text": "我知道了，谢谢你，宁宁。我很快就回来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哥伦比娅，我和你一起去吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "好。"
        },
        {
          "role": "派蒙",
          "text": "那、那黑蛋怎么办？让她一个人呆在这里吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "别担心，我呼唤了玛歌，她正在过来的路上。"
        },
        {
          "role": "哥伦比娅",
          "text": "只是留在这里的话，这座基地没有别的危险。"
        },
        {
          "role": "派蒙",
          "text": "可是…我还是有点担心，干脆我留下来陪她吧。"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯？派蒙不想去看看月心的样子吗？"
        },
        {
          "role": "派蒙",
          "text": "我觉得黑蛋一个人在这里会孤单的。"
        },
        {
          "role": "派蒙",
          "text": "她是那个卢沙里姆的女儿哦…这件事她刚刚知道。"
        },
        {
          "role": "派蒙",
          "text": "这种消息一定需要好好消化一下吧？万一胡思乱想，跑到危险的地方去就不好了。"
        },
        {
          "role": "派蒙",
          "text": "所以，我还是在这里陪她等玛歌来吧。"
        },
        {
          "role": "派蒙",
          "text": "你们在里面看见了什么，回来告诉我就好啦。"
        },
        {
          "role": "黑蛋",
          "text": "谢谢你，派蒙。我会再多给你一点尊重。"
        },
        {
          "role": "派蒙",
          "text": "那我就再多给你一份零食吧，现在是你三我七了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙这次有了姐姐的样子。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，怎么不是呢？我可算看着黑蛋长大的哦！"
        },
        {
          "role": "派蒙",
          "text": "好啦，你们快去吧，早点去就早点回来，别让我们等太久。"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，旅行者，跟我来。"
        },
        {
          "type": "subtitle",
          "text": "跟随哥伦比娅前往月心"
        },
        {
          "role": "哥伦比娅",
          "text": "放心前进吧，脚下是安全的。"
        },
        {
          "role": "哥伦比娅",
          "text": "终点在下面，别害怕，我们一起。"
        },
        {
          "type": "subtitle",
          "text": "跃入月心深坑"
        },
        {
          "role": "哥伦比娅",
          "text": "我们下来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里就是月心吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "不，月心还在前面。这次有你同行，我们就得用常规方法进入那里。"
        },
        {
          "role": "哥伦比娅",
          "text": "至于这里…是那位漆黑龙王的杰作。"
        },
        {
          "role": "哥伦比娅",
          "text": "他将月球改造成了可怕的武器，这里就是武器的发射井。"
        },
        {
          "role": "哥伦比娅",
          "text": "而月心中的月亮本源力量，就成了射向提瓦特的炮火。"
        },
        {
          "role": "哥伦比娅",
          "text": "不过，那位原初之主最终还是败于天理手中。现在这里已经不会再有威胁了。"
        },
        {
          "role": "哥伦比娅",
          "text": "我们往前走吧。"
        },
        {
          "type": "subtitle",
          "text": "穿越发射井"
        },
        {
          "type": "subtitle",
          "text": "通过正确的路前进"
        },
        {
          "role": "哥伦比娅",
          "text": "我们正走在发射井的井壁上。你应该注意到了吧，这里的重力不太对劲。"
        },
        {
          "role": "哥伦比娅",
          "text": "似乎有一些机关在维护这个设备。"
        },
        {
          "role": "哥伦比娅",
          "text": "我们要挑一条对的路。"
        },
        {
          "role": "哥伦比娅",
          "text": "路在那边。"
        },
        {
          "type": "subtitle",
          "text": "通过正确的路前进"
        },
        {
          "role": "哥伦比娅",
          "text": "注意那些工程机关，别被它们阻碍了脚步。"
        },
        {
          "type": "subtitle",
          "text": "打开月心通道"
        },
        {
          "role": "哥伦比娅",
          "text": "重力又变化了，你还好吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "我们就快到了。"
        },
        {
          "type": "subtitle",
          "text": "打开月心通道"
        },
        {
          "role": "哥伦比娅",
          "text": "这道门下面，就是我们要去的地方了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像需要钥匙才能开门。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "钥匙就在你身上。"
        },
        {
          "role": "哥伦比娅",
          "text": "这里是卢沙里姆最后的研究场所，而上一个是月幕实验室，也就是现在的月海。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是…月海的古月之源？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "就是这个。"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯？是识别到了入侵者吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "不过它们拦不住我们。"
        },
        {
          "type": "subtitle",
          "text": "击败最后的防卫者"
        },
        {
          "role": "哥伦比娅",
          "text": "看起来，它似乎借用了一些月心的力量。"
        },
        {
          "role": "哥伦比娅",
          "text": "那些屏障要注意躲开。"
        },
        {
          "type": "subtitle",
          "text": "躲避高能冲击炮"
        },
        {
          "type": "subtitle",
          "text": "高能冲击发射准备",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "别被打中了。"
        },
        {
          "type": "subtitle",
          "text": "高能冲击即将发射",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "趁着间隙继续前进吧。"
        },
        {
          "type": "subtitle",
          "text": "击败最后的防卫者"
        },
        {
          "role": "哥伦比娅",
          "text": "我来解决重力问题，需要一小会儿。"
        },
        {
          "type": "subtitle",
          "text": "前往月心"
        },
        {
          "role": "哥伦比娅",
          "text": "这里就是月心了。很美，对吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "这里的古月之力浓度很高，不要和我分开。"
        },
        {
          "role": "哥伦比娅",
          "text": "我们往前去吧。"
        },
        {
          "role": "哥伦比娅",
          "text": "你现在一定想知道望月者计划是什么。"
        },
        {
          "role": "哥伦比娅",
          "text": "其实我们这一路的旅程，就是它的一部分。"
        },
        {
          "role": "哥伦比娅",
          "text": "伊比尼伯龙之眼。"
        },
        {
          "role": "哥伦比娅",
          "text": "乌吉恩圈。"
        },
        {
          "role": "哥伦比娅",
          "text": "星空生物捕捉站。"
        },
        {
          "role": "哥伦比娅",
          "text": "卢沙里姆的月幕实验所。"
        },
        {
          "role": "哥伦比娅",
          "text": "最后通往这里，月亮的生命本源与意志所在，月心。"
        },
        {
          "type": "subtitle",
          "text": "前往月心"
        },
        {
          "role": "哥伦比娅",
          "text": "旅程的终点到了，她就是开启望月者计划的钥匙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她是谁？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "是望月者计划的最后继承者，留在这里的印迹。"
        },
        {
          "role": "哥伦比娅",
          "text": "她会解释一切。"
        },
        {
          "role": "？？？",
          "text": "嘿！你好啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "我是宁希姬娅，你也可以叫我宁宁，是我的小名。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "你叫什么名字？伊比尼伯龙？乌吉恩？玛歌？还是卢沙里姆？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我是旅行者。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "嘿嘿，不用回答我，因为很遗憾，我已经不在了，这只是一段留言。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "但反过来想，其实一点也不遗憾，因为你来到了这里，这说明计划成功了，你继承了我们的使命。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "你一定还有很多疑惑，比如——「我到底是谁？」。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "让我告诉你，你是由月球意志创生的新生命，你是望月者计划的重要一环。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "「那这个计划究竟是什么呢？」，你肯定又在这么想…别着急，听我说。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "首先，请感谢三月女神，她们容许了我们的僭越，借用了月球本源的创生之力。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "其次，感谢我的老师卢沙里姆。他继承了所有人的研究成果，还成功搜集了大家的古月力信息。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "这样一来，我才能把信息汇聚于这片月心之海，当本源的创生之力被激发时，「砰」的一下——"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "一只可爱的黑色月灵，也就是你，诞生了。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "你可能会继承信息海洋中某位前辈的名字，也可能不会，但大概你能想起你有一个使命。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来这就是黑蛋的诞生…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "接下来，还要感谢玛歌前辈，她揭开了那位星空访客的本质——一种信息生命，她的研究是你诞生的基石。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "还有乌吉恩前辈，他付出生命，传递了那位访客所代表的文明最后向星空传递的消息。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "然后，是最初的望月者，伊比尼伯龙，他带着我们登上月亮，睁大了我们的眼睛，永不疲倦地望向璀璨星空。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "最后，继承者，还要感谢你，因为你即将献出自己，去望月者高塔启动计划的最后一环。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "你的使命，就是继续向宇宙发送我们曾经接收到的信息。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "「一束光很微弱，很容易被黑暗吞没，但只要在它消失前有另一束光亮起…」"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "「那么总有一天，总有一束光，会成为刺破夜幕的曙光。」"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "说到这里，你应该理解了吧？刚好，我的时间差不多也要到了…但没关系，我马上就来加入大家了。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "这样一想，搞不好，你继承的可能会是我的名字呢，哈哈。"
        },
        {
          "role": "宁希姬娅的印迹",
          "text": "该说再见了，去完成你的使命吧。最后…向你和所有的望月者（星空）致意。"
        },
        {
          "role": "哥伦比娅",
          "text": "就是这样。旅行者。"
        },
        {
          "role": "哥伦比娅",
          "text": "所有探寻过星空的学者，他们的信息都被融入了这片海洋，借着月球的意志，在未来的某天以黑蛋的模样再次诞生。"
        },
        {
          "role": "哥伦比娅",
          "text": "它们会本能地互相吞噬，来获取更多信息，直到脑海中的使命变清晰。"
        },
        {
          "role": "哥伦比娅",
          "text": "然后再走一遍我们所走过的路，来到这里，得知一切。"
        },
        {
          "role": "哥伦比娅",
          "text": "它们会用自己当作钥匙，打开伊比尼伯龙之眼的望月者模块。向宇宙重新发送消息。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "最后回归生命的循环…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，这个循环可能已经不止发生过一次了。"
        },
        {
          "role": "哥伦比娅",
          "text": "但是，向未知的星空发出声音，未必是一件安全的事。"
        },
        {
          "role": "哥伦比娅",
          "text": "龙族的学者一定也意识到了这点，所以开始研究月幕工程。"
        },
        {
          "role": "哥伦比娅",
          "text": "而在宁宁的年代，世界因为两位至高者的争斗，已是将要毁灭的样子。"
        },
        {
          "role": "哥伦比娅",
          "text": "可现在，提瓦特已经恢复了平静，至少现在如此。"
        },
        {
          "role": "旅行者",
          "text": "（如果这次发出的信号，最后却让星空中的黑暗注意到这里…）"
        },
        {
          "role": "哥伦比娅",
          "text": "我会依照承诺，把钥匙和信息交给宁宁。"
        },
        {
          "role": "哥伦比娅",
          "text": "但你觉得我们应该阻止宁宁完成她的使命，还是支持她？"
