        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": [
                {
                  "role": "哥伦比娅",
                  "text": "那我们走吧。"
                }
              ]
            },
            {
              "text": "稍等一下。",
              "dialogues": [
                {
                  "role": "哥伦比娅",
                  "text": "嗯，最好不要耽误太久。"
