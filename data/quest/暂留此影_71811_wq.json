  "chapter_title": "暂留此影",
  "type": "wq",
  "route": "Snapshots",
  "stories": [
    {
      "story_id": 71811,
      "title": "暂留此影",
      "description": "璃月港飞云商会的阿旭正在为了一架名叫「留影机」的机器而苦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将「画」送给顾客"
        },
        {
          "role": "阿山婆",
          "text": "嗯？你找我有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于「留影机」…"
        },
        {
          "role": "阿山婆",
          "text": "「留影机」…哦，前几天我是去飞云商会，拜托他们过来给我留个影的。"
        },
        {
          "role": "阿山婆",
          "text": "你是特意来把印出来的画送过来的吗？真是谢谢你了。"
        },
        {
          "type": "subtitle",
          "text": "将「画」送给顾客"
        },
        {
          "role": "茶博士刘苏",
          "text": "您有事找我？"
        },
        {
          "role": "旅行者",
          "text": "关于「留影机」…"
        },
        {
          "role": "茶博士刘苏",
          "text": "对，对，我前几天是去飞云商会，让他们过来给我留影的。"
        },
        {
          "role": "茶博士刘苏",
          "text": "怎么，画已经印出来了？给我看看…"
        },
        {
          "role": "茶博士刘苏",
          "text": "这还真不错，谢谢你专门跑一趟。"
        },
        {
          "type": "subtitle",
          "text": "向阿旭回报"
        },
        {
          "role": "阿山婆",
          "text": "那个「留影机」可真不错，唔…我要不要去买一台呢…"
        },
        {
          "role": "旅行者",
          "text": "关于「留影机」的事…"
        },
        {
          "role": "阿旭",
          "text": "你把东西都送到了吗？"
        },
        {
          "role": "旅行者",
          "text": "都送到了。"
        },
        {
          "role": "阿旭",
          "text": "谢谢谢谢，真是劳烦您了，我真是要忙晕头了…"
        },
        {
          "role": "阿旭",
          "text": "哦对了，这架「留影机」送给您，谢谢您帮忙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这怎么好意思…",
              "dialogues": []
            },
            {
              "text": "这东西挺贵吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿旭",
          "text": "没事，没事，您不是给我们帮了忙吗？"
        },
        {
          "role": "阿旭",
          "text": "这也不是什么贵重的东西，是我们去进货的时候，枫丹那边给我们的试用装。"
        },
        {
          "role": "阿旭",
          "text": "虽然和正式装的还是有点区别…但基本功能都有，您随便玩玩肯定是够的。"
        },
        {
          "role": "阿旭",
          "text": "然后…您要是觉着用得不错，您也帮我们四处宣传宣传…"
        },
        {
          "role": "阿旭",
          "text": "咳…总之谢谢您帮忙！这「留影机」您收好，收好。"
        }
      ]
    }
  ]
}