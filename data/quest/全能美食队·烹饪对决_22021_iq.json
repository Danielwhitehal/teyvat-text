{
  "quest_id": 22021,
  "chapter_num": null,
  "chapter_title": "全能美食队·烹饪对决",
  "type": "iq",
  "route": "The Gourmet Supremos: Cook-Off",
  "stories": [
    {
      "story_id": 22021,
      "title": "全能美食队·烹饪对决",
      "description": "全能美食队的旭东和龟井宗久似乎正在准备进行一场烹饪对决…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "对话旭东"
        },
        {
          "role": "旭东",
          "text": "我这道菜可是很厉害的，你可要做好准备！"
        },
        {
          "role": "龟井宗久",
          "text": "在下的这道菜同样很不错，请阁下也做好准备。"
        },
        {
          "role": "旅行者",
          "text": "你们干什么呢？"
        },
        {
          "role": "旭东",
          "text": "是你啊旅行者。是这样，芭尔瓦涅和朱莉出去搜集食材了，我们本来打算给她们准备准备饭菜。"
        },
        {
          "role": "旭东",
          "text": "但我和宗久大叔对于准备什么菜，有一点点分歧。"
        },
        {
          "role": "旭东",
          "text": "所以，我和宗久大叔就打算各自出一道菜切磋一下厨艺，顺便以此决定今天的菜色。"
        },
        {
          "role": "旭东",
          "text": "我打算做一道璃月特色菜「珍珠翡翠白玉汤」。"
        },
        {
          "role": "龟井宗久",
          "text": "在下则准备用拿手的「串串三味」来应战。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "需要我帮忙吗？",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "唔，如果你有空的话，我们确实需要一个负责评判味道高低的裁判…"
                }
              ]
            },
            {
              "text": "你们一定缺一个裁判。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "哈哈哈，可不是，我们正需要一个负责评判味道高低的裁判呢。"
                }
              ]
            }
          ]
        },
        {
          "role": "旭东",
          "text": "但我俩各自都只有一个人，而且每道菜要准备四个人的份，说不定会有些忙不过来。"
        },
        {
          "role": "旭东",
          "text": "在评判味道之前，还是请你先帮我们准备准备那道菜吧。"
        },
        {
          "role": "旭东",
          "text": "当然，你也只有一个人，所以你就挑一道你感兴趣的菜帮忙吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旭东，你忙得过来吗？",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "你也不用担心我，我好歹之前在璃月也是个开餐馆的，只是准备准备饭菜而已，难不倒我。"
                },
                {
                  "role": "旭东",
                  "text": "只不过，如果有人帮忙的话，饭菜能做得更精细一些就是了。"
                }
              ]
            },
            {
              "text": "宗久大叔，你忙得过来吗？",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "阁下凭自己喜好挑选即可，在下还在幕府之时，也经常一人准备好几个人的下酒菜，现在只是四人份而已，不成问题。"
                },
                {
                  "role": "龟井宗久",
                  "text": "但如果阁下愿施以援手，那在下的饭菜一定能做出更好的味道。"
                }
              ]
            }
          ]
        },
        {
          "role": "旭东",
          "text": "总之，你就挑一道你感兴趣的菜帮忙吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旭东，我来帮你。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "噢！那太好了，宗久大叔，你可要准备好，可别被我的菜一口气打倒了！"
                },
                {
                  "role": "龟井宗久",
                  "text": "在下可不会轻易认输的，阁下尽管放手施为。"
                }
              ]
            },
            {
              "text": "宗久大叔，我来帮你。",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "多谢阁下。旭东阁下，你可要小心了。"
                },
                {
                  "role": "旭东",
                  "text": "没问题，你就尽管放马过来吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "帮助旭东制作「珍珠翡翠白玉汤」"
        },
        {
          "role": "旭东",
          "text": "这样就做好了，多谢啦旅行者。这香味，闻着就好。"
        },
        {
          "role": "旭东",
          "text": "我先来尝尝…嗬，不错，食材炖煮的程度刚好，香气也很足。"
        },
        {
          "role": "旭东",
          "text": "可以说是一道「完美的珍珠翡翠白玉汤」了。"
        },
        {
          "role": "旭东",
          "text": "好嘞，宗久大叔，你的菜做得怎么样了？你也拿出来让旅行者品鉴一下吧。"
        },
        {
          "role": "龟井宗久",
          "text": "唔，在下失误了。在开始做菜的时候，才发现没有备足鸟蛋。"
        },
        {
          "role": "龟井宗久",
          "text": "虽然在下马上从旁边的树林里取了些鸟蛋，但其余的食材却都过了最佳的处理期。"
        },
        {
          "role": "龟井宗久",
          "text": "以这种新鲜度欠佳的食材制作的「串串三味」，已经不能称得上是一道好菜了。"
        },
        {
          "role": "龟井宗久",
          "text": "居然会如此疏忽，在下真是惭愧，在厨艺一道上，我还需要再多加训练才是。"
        },
        {
          "role": "龟井宗久",
          "text": "这次的比试，是在下输了。但下次，在下一定会赢过你的，旭东阁下。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要加油啊，大叔。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "嘿嘿，不过我也不是那么好战胜的啦。"
                },
                {
                  "role": "旭东",
                  "text": "对了旅行者，这些东西给你，收下吧，谢谢你陪我和大叔折腾到现在。"
                },
                {
                  "role": "旭东",
                  "text": "下次我们对决的时候，你可一定也要过来啊。"
                }
              ]
            },
            {
              "text": "其实我感觉味道还好啦…",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "不，就算是做菜，也要怀着追求极致之心，不断追求厨艺的「极意」，绝不能满意于「差不多」。"
                },
                {
                  "role": "龟井宗久",
                  "text": "这样，才能不断攀上厨艺之道上的一个个高点！"
                },
                {
                  "role": "旭东",
                  "text": "是…是！"
                },
                {
                  "role": "旅行者",
                  "text": "是…是！"
                },
                {
                  "role": "龟井宗久",
                  "text": "这既是武道，也是厨道，更是在下的为人之道。"
                },
                {
                  "role": "旭东",
                  "text": "啊…好！要加油啊，宗久大叔，要加油啊，哈哈…"
                },
                {
                  "role": "旭东",
                  "text": "呃啊…我对这种…这种严肃的人一点办法都没有…只有朱莉能对付宗久大叔，但是她现在又不在…"
                },
                {
                  "role": "旅行者",
                  "text": "完全被震慑住了…"
                },
                {
                  "role": "旭东",
                  "text": "咳，这次辛苦你了旅行者，这些东西请收下吧，我…"
                },
                {
                  "role": "龟井宗久",
                  "text": "旭东阁下，在下还想请教您一些厨艺上的问题，请问您现在有空吗？"
                },
                {
                  "role": "旭东",
                  "text": "啊？有！我有空，现在就来！马上就来…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "帮助龟井宗久制作「串串三味」"
        },
        {
          "role": "龟井宗久",
          "text": "嗯，这气味和外表…这道「串串三味」应该能称得上是「极意之串」了。"
        },
        {
          "role": "旅行者",
          "text": "极、极意之串？"
        },
        {
          "role": "龟井宗久",
          "text": "呵呵，就是一道完美的「串串三味」…看时间，旭东阁下的「珍珠翡翠白玉汤」应该也做好了。"
        },
        {
          "role": "旭东",
          "text": "那是当然了，这就是我做的「珍珠翡翠白玉汤」了。"
        },
        {
          "role": "旭东",
          "text": "虽然因为我没有分配好处理食材的时间，汤可能煮得稍微过了一点，但味道应该还过得去。"
        },
        {
          "role": "龟井宗久",
          "text": "请容在下尝尝。"
        },
        {
          "role": "龟井宗久",
          "text": "唔，确实略有一些焦糊味，虽然不至于坏掉一锅菜，但终究是有些瑕疵。"
        },
        {
          "role": "旭东",
          "text": "哈哈哈，这次赶得太急了，下次等我预先把食材都准备好，应该就不会有这个问题了。"
        },
        {
          "role": "旭东",
          "text": "这次是我输了，不过下次我可就不会犯这种错误了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是你大意了啊。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "哈哈哈…是啊，一个不留神就输给大叔了，下次对决的时候，我可要更仔细一点才行…"
                },
                {
                  "role": "旭东",
                  "text": "对了旅行者，这些东西给你，收下吧，谢谢你陪我和大叔折腾到现在。"
                },
                {
                  "role": "旭东",
                  "text": "下次我们对决的时候，你可一定也要过来啊。"
                }
              ]
            },
            {
              "text": "大叔的「极意之串」更胜一筹了啊。",
              "dialogues": [
                {
                  "role": "旭东",
                  "text": "极、极意之串？什么？"
                },
                {
                  "role": "龟井宗久",
                  "text": "意思就是「品质完美的串串三味」。"
                },
                {
                  "role": "龟井宗久",
                  "text": "所谓「极意」，正是绝不满意于「差不多」，不断追求极致之心。"
                },
                {
                  "role": "龟井宗久",
                  "text": "即便是做菜也是如此，只有怀着追求极致之心，才能不断攀上厨艺之道上的一个个高点！"
                },
                {
                  "role": "旭东",
                  "text": "是…是！"
                },
                {
                  "role": "旅行者",
                  "text": "是…是！"
                },
                {
                  "role": "龟井宗久",
                  "text": "这既是武道，也是厨道，更是在下的为人之道。"
                },
                {
                  "role": "龟井宗久",
                  "text": "旭东阁下，请来这边，容在下稍微为您讲一讲「极意」之道。"
                },
                {
                  "role": "旭东",
                  "text": "啊？这…这…大叔你稍等一下，旅行者，这些报酬你拿好…"
                },
                {
                  "role": "旭东",
                  "text": "呃啊…我对这种…这种严肃的人一点办法都没有…只有朱莉能对付宗久大叔，但是她现在又不在…"
                },
                {
                  "role": "旅行者",
                  "text": "你就好好去感受「极意厨道」吧。"
                },
                {
                  "role": "龟井宗久",
                  "text": "旭东阁下？"
                },
                {
                  "role": "旭东",
                  "text": "啊？我来了，现在就来！马上就来…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "帮助旭东增大火力"
        },
        {
          "role": "旭东",
          "text": "怎么样，你采到金鱼草了吗？"
        },
        {
          "type": "subtitle",
          "text": "帮助龟井宗久调小火力"
        },
        {
          "role": "龟井宗久",
          "text": "怎么样，您拿到鸟蛋了吗？"
        },
        {
          "type": "subtitle",
          "text": "将新鲜的金鱼草带给旭东"
        },
        {
          "type": "subtitle",
          "text": "将新鲜的鸟蛋带回给龟井宗久"
        },
        {
          "type": "subtitle",
          "text": "与旭东对话"
        },
        {
          "type": "subtitle",
          "text": "与龟井宗久对话"
        },
        {
          "type": "subtitle",
          "text": "对话旭东"
        },
        {
          "role": "旭东",
          "text": "那我们就开始吧。「珍珠翡翠白玉汤」要用到金鱼草、豆腐和莲蓬…"
        },
        {
          "role": "旭东",
          "text": "莲蓬…豆腐…幸好还有些剩下，但金鱼草好像不太够了…"
        },
        {
          "role": "旭东",
          "text": "旅行者，我在这里处理食材。为了保险起见，请你再帮我去找三份新鲜的金鱼草过来吧。"
        },
        {
          "type": "subtitle",
          "text": "对话龟井宗久"
        },
        {
          "role": "龟井宗久",
          "text": "多谢阁下愿意帮忙。这道名为「串串三味」的菜做法虽然简单，但却需要格外注意食材的新鲜度。"
        },
        {
          "role": "龟井宗久",
          "text": "其余的材料我都已经准备完毕，但鸟蛋却备少了一些…为了保险起见，阁下，能请您帮我去取两颗新鲜的鸟蛋过来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "那就拜托阁下了。"
                }
              ]
            },
            {
              "text": "你怎么会做这个的？",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "还在幕府内任职的时候，在下经常做这种小菜，和几位同僚用来下酒。"
                },
                {
                  "role": "龟井宗久",
                  "text": "但现在…"
                },
                {
                  "role": "龟井宗久",
                  "text": "往事就不提了，鸟蛋就拜托阁下了。"
                },
                {
                  "role": "龟井宗久",
                  "text": "我会在这里处理食材，您拿到了鸟蛋后，请尽快拿给我吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "采摘三份新鲜的金鱼草"
        },
        {
          "type": "subtitle",
          "text": "取得两颗新鲜的鸟蛋"
        }
      ]
    }
  ]
}