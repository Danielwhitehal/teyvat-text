{
  "quest_id": 76007,
  "chapter_num": null,
  "chapter_title": "转行总是令人焦虑",
  "type": "wq",
  "route": "The Stress of Changing Careers",
  "stories": [
    {
      "story_id": 76007,
      "title": "转行总是令人焦虑",
      "description": "在北方训练场，一名宝藏猎人突然热情地现身拦路…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "完成瓦伊诺设计的第一个挑战"
        },
        {
          "role": "瓦伊诺",
          "text": "我刚刚根据茜斯柯的意见调整完了第三项挑战，应该会很好玩的！"
        },
        {
          "type": "subtitle",
          "text": "完成瓦伊诺设计的第一个挑战"
        },
        {
          "type": "subtitle",
          "text": "去第二个挑战的位置，开启挑战"
        },
        {
          "role": "派蒙",
          "text": "「这是第二个挑战！从这里开始加入了地形的影响。啊，还有！后半段的时候靶子会移动，请边跑边打。」"
        },
        {
          "role": "派蒙",
          "text": "…这不是把挑战最有趣的部分提前透露出来了嘛！"
        },
        {
          "role": "派蒙",
          "text": "突然有点理解问题的所在了…好像，完全没有新鲜感了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "噢！刚才好像有什么东西晃过去了！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？我、我怎么没看到…是、是什么哇？"
                }
              ]
            },
            {
              "text": "嘘！轻一点！派蒙有没有听到…？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我、我什么都没听到啊…有奇怪的声音吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼，旅行者在故意吓唬我！明、明明什么都没有…吧？"
        },
        {
          "role": "派蒙",
          "text": "我要的新鲜感才不是这样的东西呢…坏心眼！作为惩罚，待会儿你、你要走在前面哦！"
        },
        {
          "type": "subtitle",
          "text": "完成瓦伊诺设计的第二个挑战"
        },
        {
          "type": "subtitle",
          "text": "完成瓦伊诺设计的第二个挑战"
        },
        {
          "type": "subtitle",
          "text": "与瓦伊诺对话"
        },
        {
          "role": "派蒙",
          "text": "瓦伊诺，我们已经知道训练场的问题在哪里了！"
        },
        {
          "role": "瓦伊诺",
          "text": "那个啊…那个已经不重要了。是时候准备后事了…"
        },
        {
          "role": "派蒙",
          "text": "欸？发生了什么？"
        },
        {
          "role": "瓦伊诺",
          "text": "所有的靶标，又都不见了…"
        },
        {
          "role": "派蒙",
          "text": "或许只是别人不小心拿走了吧？"
        },
        {
          "role": "瓦伊诺",
          "text": "不，之前也发生过这样的事。我当时重新买了一批材料，做了新的靶标，特意藏在了不起眼的角落。"
        },
        {
          "role": "瓦伊诺",
          "text": "这次也被偷走了的话，说明对方一定是故意的！"
        },
        {
          "role": "派蒙",
          "text": "刚才在那个洞里我也有种毛骨悚然的感觉，难、难道也和那些窃贼有关？"
        },
        {
          "role": "旅行者",
          "text": "那只是我在吓唬派蒙…"
        },
        {
          "role": "瓦伊诺",
          "text": "不，果然你们也察觉到了吗？那种被人盯上的感觉…我的直觉不会有错的。再说靶标又不那么值钱，谁会想偷呢？"
        },
        {
          "role": "瓦伊诺",
          "text": "我在做宝藏猎人的时候，虽然有意避免了那些过于危险的委托，但那么多年下来，要说没有积累下仇怨，也是自欺欺人…"
        },
        {
          "role": "瓦伊诺",
          "text": "将所有的靶标偷走，就是想要告诉我——下一个目标，就是我。"
        },
        {
          "role": "瓦伊诺",
          "text": "看来，转行还是晚了一步啊！真没想到，年纪轻轻就要为一份工作献出生命了…"
        },
        {
          "role": "派蒙",
          "text": "也有可能是瓦伊诺想多了嘛…"
        },
        {
          "role": "旅行者",
          "text": "抓到窃贼，一切就真相大白了。"
        },
        {
          "role": "瓦伊诺",
          "text": "你们…唔，真是令人感动…两位有时间的话，请一定要莅临我的追悼会！"
        },
        {
          "role": "派蒙",
          "text": "都说了不要总是想着追悼会的事嘛！说不定还有解决的办法呢！"
        },
        {
          "role": "瓦伊诺",
          "text": "唔，这就是来自小朋友的活力么…好吧，既然如此，那我就再挣扎一下好了。"
        },
        {
          "role": "瓦伊诺",
          "text": "起码在那些家伙找上门以前，还不能就这样放弃。毕竟，我几乎把所有的存款都投到训练场里了…"
        },
        {
          "role": "瓦伊诺",
          "text": "嗯，之前跟盗宝团打过不少交道，我的经验是——要抓住小偷，最好的办法还是设下诱饵。"
        },
        {
          "role": "瓦伊诺",
          "text": "那边的蛋卷工坊应该可以买到制作靶标的材料，我之前去过几次。既然是盯着靶标的窃贼，就用靶标来当作诱饵吧。"
        },
        {
          "role": "瓦伊诺",
          "text": "那么，小偷的事就拜托两位了！我就留在这里继续修理被他们破坏掉的第三项挑战。"
        },
        {
          "role": "瓦伊诺",
          "text": "你们好快，已经完成前面所有的挑战了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还没有…",
              "dialogues": [
                {
                  "role": "瓦伊诺",
                  "text": "那请先按照我设计的路线，完成前两项挑战吧。毕竟要给我提意见的话，还是多体验一下吧…"
                }
              ]
            },
            {
              "text": "抱歉，稍微有点迷路。",
              "dialogues": [
                {
                  "role": "瓦伊诺",
                  "text": "看来指示设计还不够清晰啊…就在那个方向。请完成了前面的挑战之后再来吧！"
                }
              ]
            },
            {
              "text": "只是随便看看。",
              "dialogues": [
                {
                  "role": "瓦伊诺",
                  "text": "原来是这样，那我接着调试第三个项目。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往蛋卷工坊，询问如何获得必要的材料"
        },
        {
          "role": "派蒙",
          "text": "你好！我叫派蒙，他是旅行者。我们是受瓦伊诺所托，想来问问有没有制作靶标的材料。"
        },
        {
          "role": "茜斯柯",
          "text": "瓦伊诺…？啊，你说的是「年纪轻轻」大叔吧！"
        },
        {
          "role": "茜斯柯",
          "text": "靶标又用完啦？他前几天才来买过，看来他的训练场生意真是越来越好了。"
        },
        {
          "role": "派蒙",
          "text": "真实情况可以说是完全相反。可以算得上是客人的，好像只有我们两个…"
        },
        {
          "role": "茜斯柯",
          "text": "啊…这、这是怎么一回事呢？"
        },
        {
          "role": "？？？",
          "text": "女孩看上去很关切的样子，于是将靶标神秘消失的事告诉了她。"
        },
        {
          "role": "茜斯柯",
          "text": "原来…生意不好吗？怪不得看上去没什么精神的样子。要不是你们告诉我的话，我们都完全不知道呢…"
        },
        {
          "role": "派蒙",
          "text": "「我们」指的是…？"
        },
        {
          "role": "茜斯柯",
          "text": "就是…附近的小孩子们。我们都知道「年纪轻轻」大叔需要靶标，大家如果收集到相关的材料，就会都囤起来卖给他…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "然后再想办法把他的靶标偷走吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "噢！这样的话，失去了靶标的瓦伊诺就会再来买材料，然后你们再把偷来的靶标当作材料卖回给他吗！"
                },
                {
                  "role": "茜斯柯",
                  "text": "唔…嗯。但、但是我们并没有偷东西…"
                }
              ]
            },
            {
              "text": "关于靶标被偷的事，你有头绪吗？",
              "dialogues": [
                {
                  "role": "茜斯柯",
                  "text": "…有。"
                },
                {
                  "role": "茜斯柯",
                  "text": "不过我们没有偷过东西…我们只是、只是把收回来的靶标再卖给了他而已。"
                },
                {
                  "role": "派蒙",
                  "text": "这样明明只有一份靶标，却被收了很多很多次钱！可怜的瓦伊诺…"
                }
              ]
            }
          ]
        },
        {
          "role": "茜斯柯",
          "text": "对不起，我们之前真的不知道，「年纪轻轻」大叔的生意并不好。我们都以为他买了那么多次靶标，大概很有钱吧…"
        },
        {
          "role": "派蒙",
          "text": "那是因为他为了让训练场能运营下去，一直在燃烧存款。"
        },
        {
          "role": "茜斯柯",
          "text": "实在太抱歉了，要是有什么是我能做的…"
        },
        {
          "role": "旅行者",
          "text": "那请告诉我，谁才是真正的小偷？"
        },
        {
          "role": "茜斯柯",
          "text": "这个…唔，好吧…是、是「地隐会」，但！他们不是坏人！"
        },
        {
          "role": "派蒙",
          "text": "「地隐会」是什么？"
        },
        {
          "role": "茜斯柯",
          "text": "这个不可以告诉你们呢…"
        },
        {
          "role": "派蒙",
          "text": "瓦伊诺现在非常需要我们的帮助！所以无论如何我们都要弄清楚，到底是谁偷走了那些靶标。"
        },
        {
          "role": "茜斯柯",
          "text": "好吧…其实我们也不知道。他们神出鬼没，我们从来没有见过他们的真面目。不过我觉得，大概就是像雷德·米勒那样的侠盗吧。"
        },
        {
          "role": "茜斯柯",
          "text": "我们偶尔会去和「地隐会」的人做交易。不管我们带去的东西是什么样的，他们回赠给我们的，都是很有价值的物品。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们就是用这个办法回收靶标的吧？",
              "dialogues": [
                {
                  "role": "茜斯柯",
                  "text": "嗯，没错。除了靶标之外，也会有摩拉、或者其他值钱的零件。对我们来说，真的是很大的帮助。"
                }
              ]
            },
            {
              "text": "做过交易但是却没见过他们？",
              "dialogues": [
                {
                  "role": "茜斯柯",
                  "text": "他们很谨慎的！我们每次都只是把东西放在固定的交易地点，没有直接见过面。"
                },
                {
                  "role": "派蒙",
                  "text": "你们就不好奇「地隐会」的身份吗？"
                },
                {
                  "role": "茜斯柯",
                  "text": "那肯定是…好奇的。但是他们有他们的规矩，既然要交易，当然要尊重他们的规矩了。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "奇怪，但是「地隐会」为什么要针对瓦伊诺呢？"
        },
        {
          "role": "茜斯柯",
          "text": "侠盗做事一定有侠盗的道理。所以我们才会觉得「年纪轻轻」大叔大概很有钱吧…真、真是对不起！"
        },
        {
          "role": "茜斯柯",
          "text": "如果你们想拿回大叔的靶标，可以试试收集<color=#00E1FFFF>老旧的便携轴承</color>去交换。"
        },
        {
          "role": "茜斯柯",
          "text": "只不过我不知道数量够不够…毕竟，前几天大叔才来买过一次。"
        },
        {
          "role": "派蒙",
          "text": "嗯，不管怎么样，只能先试试看了！"
        },
        {
          "type": "subtitle",
          "text": "去高处收集「老旧的便携轴承」"
        },
        {
          "role": "瓦伊诺",
          "text": "那些家伙也真是的，不过是一份工作而已，有必要紧追不舍到这个地步嘛！生活里明明充满了各种各样好玩的东西…"
        },
        {
          "role": "瓦伊诺",
          "text": "比如，来训练场玩打靶。"
        },
        {
          "type": "subtitle",
          "text": "与茜斯柯对话"
        },
        {
          "role": "派蒙",
          "text": "我们找到了三枚老旧的便携轴承！"
        },
        {
          "role": "茜斯柯",
          "text": "嗯，这个数量的话应该够用了。接下来的话…"
        },
        {
          "role": "派蒙",
          "text": "接下来就是去交易了吧？交易点在哪里呢？"
        },
        {
          "role": "茜斯柯",
          "text": "由…我来出面交易可不可以？"
        },
        {
          "role": "茜斯柯",
          "text": "我保证会告诉他们，让他们再也不要去找「年纪轻轻」大叔的！"
        },
        {
          "role": "旅行者",
          "text": "我们一定要弄清他们的身份才行。"
        },
        {
          "role": "派蒙",
          "text": "如果茜斯柯愿意相信素未谋面的「地隐会」，那就也请相信旅行者和我。"
        },
        {
          "role": "茜斯柯",
          "text": "派蒙说的有道理。本来在挪德卡莱这样的地方，「相信」就是很难的事吧？"
        },
        {
          "role": "茜斯柯",
          "text": "其实每次去山洞交易的时候，我也很害怕的。"
        },
        {
          "role": "茜斯柯",
          "text": "那里面黑漆漆的，能听到「悉悉索索」的声音，还有很多很多双眼睛盯着我看的感觉…"
        },
        {
          "role": "派蒙",
          "text": "瓦伊诺也提到过被人盯着的感觉！我们要找的果然就是他们。"
        },
        {
          "role": "茜斯柯",
          "text": "不过，他们真的不是坏人！"
        },
        {
          "role": "茜斯柯",
          "text": "每次走到用来交易的小箱子边，放下东西之后，我们都会闭上眼睛数到七十七。"
        },
        {
          "role": "茜斯柯",
          "text": "然后「嗖」的一声， 带去的东西就会被替换成他们的赠礼！"
        },
        {
          "role": "茜斯柯",
          "text": "是每一次！他们从来没有伤害过我们之中的任何人。"
        },
        {
          "role": "旅行者",
          "text": "为什么是七十七呢？"
        },
        {
          "role": "茜斯柯",
          "text": "我听说是因为雷德·米勒当年从总督宫里盗走了七十七件宝物！不过波泽娜说，是因为雷德·米勒手下有七十七个忠诚的伙伴…"
        },
        {
          "role": "派蒙",
          "text": "那为什么不是雷德·米勒当年从窗户里翻出来的时候，正好摔了七十七个跟头呢…"
        },
        {
          "role": "茜斯柯",
          "text": "摔了七十七个跟头就无法成为传说中的大盗了吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许数到七十八，就会被怪物吃掉？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "真、真的吗？旅行者是不是又在吓唬我了！"
                }
              ]
            },
            {
              "text": "再数下去的话，会犯困吧…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "在阴森的山洞里都会睡着吗？看来有我在身边守护，果然是一件令人安心的事呢！"
                }
              ]
            },
            {
              "text": "数到七十六的时候就可以睁眼了！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对呢，提前睁眼的话，不就能看到「地隐会」的真面目了吗！"
                },
                {
                  "role": "茜斯柯",
                  "text": "欸？竟然可以这样的吗？可是，不按照约定的办法去交易，感觉像是在作弊呢…"
                },
                {
                  "role": "派蒙",
                  "text": "反、反正是在阴暗的山洞里，应该不会被发现吧？"
                }
              ]
            }
          ]
        },
        {
          "role": "茜斯柯",
          "text": "总之呢，每个人的说法都不太一样，只有七十七这个数字是一致的。或许，你们说的才是真相也说不定呢。"
        },
        {
          "role": "茜斯柯",
          "text": "那么，就祝你们交易顺利了！我也会告诉大家「年纪轻轻」大叔的事，以后我们会尽力为他收集靶标的，不、不要钱！"
        },
        {
          "role": "茜斯柯",
          "text": "当然，我们也得尽快去跟他道歉才行…"
        },
        {
          "type": "subtitle",
          "text": "前往「地隐会」的交易点"
        },
        {
          "role": "波泽娜",
          "text": "今天的收获不错，嘿嘿！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请问，有没有制作靶标用的材料？",
              "dialogues": [
                {
                  "role": "波泽娜",
                  "text": "你也要买这个吗？之前没见过你呢…看来这东西很抢手嘛！"
                },
                {
                  "role": "波泽娜",
                  "text": "不过我今天好像没有收集到过，要不你找茜斯柯问问，她就在那边！"
                }
              ]
            },
            {
              "text": "打扰了。",
              "dialogues": [
                {
                  "role": "波泽娜",
                  "text": "再见！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "把「老旧的便携轴承」放在交易点"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "接下来要怎么办？要数数吗？还要闭上眼睛…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "从一开始数起…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯！那我们就闭上眼睛，你来数数吧。"
                },
                {
                  "role": "旅行者",
                  "text": "一。"
                },
                {
                  "role": "旅行者",
                  "text": "二。"
                },
                {
                  "role": "旅行者",
                  "text": "三。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "四。",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "你、你不是故意数得那么慢的吧？什么都看不见真的有点吓人…"
                        },
                        {
                          "role": "旅行者",
                          "text": "好吧，那就数快一点吧。"
                        }
                      ]
                    },
                    {
                      "text": "四五六七八九十…",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "呼，太好了，我还以为你真的要慢慢地数下去呢…"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "？？？",
                  "text": "越往后数，衣角就被派蒙拽得更紧了一些。"
                },
                {
                  "role": "？？？",
                  "text": "数到三十多的时候，周围似乎传来了「悉悉索索」的声音？"
                },
                {
                  "role": "？？？",
                  "text": "「五十…嗯？刚才是五十吗？」\\n「你刚才是不是差点睡着了…打起精神来！」"
                }
              ]
            },
            {
              "text": "七十七！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "竟然直接就数到了七十七！这样也会有用吗？不过不用闭上眼睛真是太好了。"
                },
                {
                  "role": "派蒙",
                  "text": "旅行者快看，是嗅嗅鼹鼠！"
                },
                {
                  "role": "旅行者",
                  "text": "「地隐会」的真实身份难道就是…"
                },
                {
                  "role": "派蒙",
                  "text": "欸？传说中神出鬼没的侠盗「地隐会」，是一群嗅嗅鼹鼠？这个名字倒还挺适合他们的。"
                },
                {
                  "role": "派蒙",
                  "text": "不过你们为什么要偷瓦伊诺的靶标呢？"
                },
                {
                  "role": "领头的嗅嗅鼹鼠",
                  "text": "？？"
                },
                {
                  "role": "派蒙",
                  "text": "好像完全没有听明白的样子…"
                },
                {
                  "role": "旅行者",
                  "text": "七十七？"
                },
                {
                  "role": "领头的嗅嗅鼹鼠",
                  "text": "吱吱唧！"
                },
                {
                  "role": "派蒙",
                  "text": "它回答你了！所以七十七是什么意思呢？雷德·米勒的七十七件宝物？七十七个伙伴？"
                },
                {
                  "role": "领头的嗅嗅鼹鼠",
                  "text": "吱吱唧！吱吱唧！"
                },
                {
                  "role": "派蒙",
                  "text": "难道说只是因为七十七听起来像吱吱唧吗？好像也没有那么像吧…七十七？吱吱唧？"
                },
                {
                  "role": "领头的嗅嗅鼹鼠",
                  "text": "吱吱唧！吱吱唧！"
                },
                {
                  "role": "派蒙",
                  "text": "所以到头来还是没有明白到底是什么意思嘛…"
                }
              ]
            },
            {
              "text": "七十——八！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔、唔啊！旅行者不要召唤怪物出来——欸？好、好像什么都没有发生呢…"
                },
                {
                  "role": "派蒙",
                  "text": "真是的…快点闭上眼睛，重新开始数吧。"
                },
                {
                  "role": "？？？",
                  "text": "被派蒙拽着的衣角好像一直在轻轻地发抖，还是赶紧数完吧！…七十五、七十六…呼，七十七！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "跟随嗅嗅鼹鼠"
        },
        {
          "type": "subtitle",
          "text": "跟随嗅嗅鼹鼠，收集靶标"
        },
        {
          "type": "subtitle",
          "text": "跟随嗅嗅鼹鼠，收集靶标"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "莱里",
          "text": "再找找吧，凭这些大概赢不过波泽娜。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请问，有没有制作靶标用的材料？",
              "dialogues": [
                {
                  "role": "莱里",
                  "text": "没有哦，那个我前几天已经卖完了。你去找茜斯柯问问吧，她那里可能还有。"
                }
              ]
            },
            {
              "text": "打扰了。",
              "dialogues": [
                {
                  "role": "莱里",
                  "text": "嗯，没关系。希望你能找到你想要的东西。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，这样的话，所有的靶标就都找到了呢！"
        },
        {
          "role": "派蒙",
          "text": "原来是用来当作垫窝的材料了，所以才盯上了瓦伊诺的吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "明明鼹鼠窝看起来比靶标豪华多了…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我也觉得！鼹鼠窝好像很舒适的样子。至于瓦伊诺的靶标嘛…大概有不是嗅嗅鼹鼠就理解不了的妙用吧。"
                }
              ]
            },
            {
              "text": "大概是因为靶标的颜色和花纹吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "拿来做装饰？唔，嗅嗅鼹鼠喜欢这种风格嘛…这大概就像茜斯柯所说的，「侠盗做事一定有侠盗的道理」吧！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不过就算这次我们把靶标都带走了，过几天也会被再偷回来的吧…要怎么办呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "下次带点礼物来给它们吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好主意！到时候就把礼物放在它们的「小藏宝间」门口。那我们回去找瓦伊诺吧。"
                }
              ]
            },
            {
              "text": "回去找瓦伊诺商量一下吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，一定有比靶标更适合用来做窝的东西！我们回去商量一下吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "将靶标还给瓦伊诺"
        },
        {
          "role": "茜斯柯",
          "text": "找到了吗？唔，不过这个数量可能不太够呢…再找找吧。"
        },
        {
          "role": "瓦伊诺",
          "text": "啊！你们回来了！我还在想是不是该准备后…唔，我是说没有遇到什么危险真是太好了。"
        },
        {
          "role": "派蒙",
          "text": "瓦伊诺就放心吧！偷走靶标的家伙绝对不是什么你曾经得罪的人！"
        },
        {
          "role": "瓦伊诺",
          "text": "真的吗？其实刚才，那个叫茜斯柯的孩子跑来向我道歉。她说偷走了靶标的人叫作「地隐会」，听起来名头很大呢…"
        },
        {
          "role": "旅行者",
          "text": "「地隐会」其实是一群嗅嗅鼹鼠。"
        },
        {
          "role": "瓦伊诺",
          "text": "嗅嗅鼹鼠？！你这么一说的话…我虽然时不时会有被紧盯的感觉，却并不会像以前遇到危险时那样感到毛骨悚然。"
        },
        {
          "role": "瓦伊诺",
          "text": "不过，它们为什么要偷走我的靶标呢？"
        },
        {
          "role": "？？？",
          "text": "将之前的发现全都告诉了瓦伊诺。"
        },
        {
          "role": "瓦伊诺",
          "text": "哈哈哈哈，原来是这样吗？害得我差点就要为自己预约追悼会的事宜了。看来得好好教训它们一下才行！"
        },
        {
          "role": "派蒙",
          "text": "可、可是它们也没有那么坏啦…"
        },
        {
          "role": "瓦伊诺",
          "text": "不不，我不是那个意思。你们刚才说，用几个老旧的便携轴承就换回了靶标。看来——"
        },
        {
          "role": "瓦伊诺",
          "text": "这个宝物汇率差，可以好好利用一下。"
        },
        {
          "role": "派蒙",
          "text": "欸？瓦伊诺的意思是说…"
        },
        {
          "role": "瓦伊诺",
          "text": "下次可以带上各种各样的礼物去拜访它们，会有意料之外的收获吧！"
        },
        {
          "role": "瓦伊诺",
          "text": "那么，之前偷走靶标的损失，或许很快就能弥补回来。"
        },
        {
          "role": "派蒙",
          "text": "那些损失…其实倒不是「地隐会」造成的。"
        },
        {
          "role": "瓦伊诺",
          "text": "嗯，我知道，茜斯柯都告诉我了。不过，我不打算让孩子们还钱。"
        },
        {
          "role": "瓦伊诺",
          "text": "她刚才叽叽喳喳给我提了很多意见。还答应我，会带上朋友们一起来玩我的训练场。"
        },
        {
          "role": "瓦伊诺",
          "text": "对我来说，这可比摩拉珍贵多了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "懂了，原来也是宝物汇率差。",
              "dialogues": []
            },
            {
              "text": "这就是宝藏猎人的嗅觉吧。",
              "dialogues": [
                {
                  "role": "瓦伊诺",
                  "text": "是「前」宝藏猎人啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "瓦伊诺",
          "text": "多谢你们。我想，我已经找到让训练场越来越好玩的门道了，希望之后能吸引更多的客人。"
        },
        {
          "role": "瓦伊诺",
          "text": "要试试吗？最后一个挑战！肯定比前两个好玩不少。"
        },
        {
          "role": "旅行者",
          "text": "好欸！"
        },
        {
          "role": "派蒙",
          "text": "有好玩的东西，我们怎么会错过呢！"
        },
        {
          "type": "subtitle",
          "text": "完成瓦伊诺的最终挑战"
        },
        {
          "role": "瓦伊诺",
          "text": "多亏了你们！我会好好参考你们和茜斯柯小朋友的意见的。希望以后客人会越来越多！"
        },
        {
          "type": "subtitle",
          "text": "与瓦伊诺对话"
        },
        {
          "role": "瓦伊诺",
          "text": "恭喜你们！第一组完成了全部挑战的选手！"
        },
        {
          "role": "派蒙",
          "text": "欸，你们看，刚才连「地隐会」都来给我们加油了。"
        },
        {
          "role": "旅行者",
          "text": "或许只是伺机偷取靶标而已。"
        },
        {
          "role": "瓦伊诺",
          "text": "得尽快帮它们找到比靶标更好的鼹鼠窝垫材才行。"
        },
        {
          "role": "瓦伊诺",
          "text": "啊对了！差点忘了给优胜选手的奖励！这都是我以前搜罗到的好东西，还挺值钱的呢！"
        },
        {
          "role": "瓦伊诺",
          "text": "不过那只是对「前」宝藏猎人瓦伊诺来说的。对现在的训练场老板瓦伊诺，已经没有什么价值了。"
        },
        {
          "role": "瓦伊诺",
          "text": "请你们务必收下，算作我对两位的答谢。"
        },
        {
          "role": "派蒙",
          "text": "那没有开训练场的我们，就不客气地收下这个宝藏了！"
        },
        {
          "role": "瓦伊诺",
          "text": "在说什么呢？我的训练场，将永远对两位免费开放。想来的时候，随时来找我！"
        }
      ]
    }
  ]
}