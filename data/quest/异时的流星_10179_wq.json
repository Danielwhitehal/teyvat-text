{
  "quest_id": 10179,
  "chapter_num": "夜莺之歌·终章",
  "chapter_title": "异时的流星",
  "type": "wq",
  "route": "A Star Out of Time",
  "stories": [
    {
      "story_id": 76101,
      "title": "终至破晓",
      "description": "成功回收了「螺旋剑」，得立刻返回皮拉米达城。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往皮拉米达城"
        },
        {
          "role": "派蒙",
          "text": "好紧张的气氛…"
        },
        {
          "type": "subtitle",
          "text": "与执灯人对话"
        },
        {
          "role": "奥拉维",
          "text": "叶洛亚！你可算回来了，尼基塔执灯长正等你呢！"
        },
        {
          "role": "派蒙",
          "text": "欸？尼基塔…执灯长？"
        },
        {
          "type": "subtitle",
          "text": "先完成任务「风起微澜」"
        },
        {
          "role": "派蒙",
          "text": "旅行者，「尼基塔」不就是委托我们去找「银灯芯」的那个老爷爷吗？"
        },
        {
          "type": "subtitle",
          "text": "先完成任务「逆位之塔」"
        },
        {
          "role": "派蒙",
          "text": "旅行者，「尼基塔」不就是我们在皮拉米达城碰到的那个老爷爷吗？"
        },
        {
          "role": "派蒙",
          "text": "我记得他明明说自己只是个普通的执灯士…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是啊…",
              "dialogues": []
            },
            {
              "text": "不，他怎么看都不像普通执灯士吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "老爷子可真是的…唉，你们就当是他的恶作剧吧。"
        },
        {
          "role": "叶洛亚",
          "text": "先不说这些了，我们去向他报告情况吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（奥拉维）"
        },
        {
          "role": "奥拉维",
          "text": "别耽搁了，执灯长在麦酒大厅等你们。"
        },
        {
          "type": "subtitle",
          "text": "向老爷子报告"
        },
        {
          "role": "叶洛亚",
          "text": "老爷子，我们回来了！"
        },
        {
          "role": "尼基塔",
          "text": "回来就好，苦壑崖的情况怎么样？"
        },
        {
          "type": "subtitle",
          "text": "简明扼要地说明了情况…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "尼基塔",
          "text": "果然如此啊…从这里也能清楚地观测到，厄布拉神柱完全被深渊力量…被那不死的妖魔「教授」给控制了。"
        },
        {
          "role": "尼基塔",
          "text": "但它目前还没有太大的动作，想来是那位爱莉厄小姐在全力与之抗衡。"
        },
        {
          "role": "尼基塔",
          "text": "她为我们争取来的难能可贵的时间，一点也不能浪费。"
        },
        {
          "role": "尼基塔",
          "text": "所幸在菲林斯和大家的帮助下，准备工作已经完成得差不多了。"
        },
        {
          "role": "尼基塔",
          "text": "有了你们带回来的「螺旋剑」，「德肋庇革劳诺之箭」也就成型了。"
        },
        {
          "role": "派蒙",
          "text": "呃…「德肋庇革劳诺之箭」是什么？是跟「银灯芯」、「螺旋剑」一样厉害的圣物吗？"
        },
        {
          "role": "尼基塔",
          "text": "哈哈，是比它们更厉害的东西。"
        },
        {
          "role": "尼基塔",
          "text": "五百年前，铸灯者力有未逮，只将那不死的妖魔封印于苦壑崖之下。但在那之后，铸灯者和初代咏月使也并未放弃。"
        },
        {
          "role": "尼基塔",
          "text": "为了在未来的某一天，彻底终结那不死的妖魔，他们用古老的技术打造了这把「弓矢」，由我们执灯人代代守护至今。"
        },
        {
          "role": "尼基塔",
          "text": "现在终于到了让它完成使命的时刻。"
        },
        {
          "role": "派蒙",
          "text": "哦…居然有这么厉害的箭，真想看看…它长什么样子呀？"
        },
        {
          "role": "尼基塔",
          "text": "傻孩子，你们早就见过了，不如说，我们就在「德肋庇革劳诺之箭」里。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "啊？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "难、难道是要把我们一起发射出去…怎么想都不可能吧！"
                }
              ]
            },
            {
              "text": "是要把我也发射出去吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "原来旅行者就是我们的最终决战兵器！…才不是吧！"
                }
              ]
            }
          ]
        },
        {
          "role": "尼基塔",
          "text": "这座麦酒大厅就是围绕「德肋庇革劳诺之箭」建造的，而你们带回的「螺旋剑」，正是它所缺失的箭头。"
        },
        {
          "role": "尼基塔",
          "text": "只要将「螺旋剑」装填进这里，就能让「德肋庇革劳诺之箭」进入发射准备了。"
        },
        {
          "role": "派蒙",
          "text": "可这不是壁炉吗？"
        },
        {
          "role": "叶洛亚",
          "text": "是壁炉，也是让「螺旋剑」化为「箭镞」的特殊装置。"
        },
        {
          "role": "尼基塔",
          "text": "趁那「恶卵」尚未孵化…用这传承至今的「弓矢」，将它彻底葬送吧！"
        },
        {
          "role": "尼基塔",
          "text": "在此期间，想必那不死的妖魔还会垂死挣扎吧，不管它送来多少爪牙，我们一定会替你们拦下。"
        },
        {
          "role": "尼基塔",
          "text": "发射「德肋庇革劳诺之箭」的重任，就交给你们了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（尼基塔）"
        },
        {
          "role": "尼基塔",
          "text": "去吧，将圣剑装填进去吧。"
        },
        {
          "type": "subtitle",
          "text": "装填「螺旋剑」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "装填",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往广场"
        },
        {
          "role": "尼基塔",
          "text": "那妖魔果然不会善罢甘休…"
        },
        {
          "role": "尼基塔",
          "text": "魔物就由我们来抵挡，你们去完成自己的使命！"
        },
        {
          "role": "派蒙",
          "text": "深渊魔物都入侵到这里了…！"
        },
        {
          "role": "叶洛亚",
          "text": "不要恋战，没时间耽搁了！"
        },
        {
          "type": "subtitle",
          "text": "激活增幅器"
        },
        {
          "type": "subtitle",
          "text": "乘上「月灵旅路」",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "role": "「众噩之蝰」",
          "text": "罪孽…无法洗刷的罪孽…"
        },
        {
          "role": "「众噩之蝰」",
          "text": "是你…是你让我落得如今的下场！"
        },
        {
          "type": "subtitle",
          "text": "未完成任务「以罪行惩戒罪人」"
        },
        {
          "role": "派蒙",
          "text": "根本听不懂！"
        },
        {
          "type": "subtitle",
          "text": "已完成任务「以罪行惩戒罪人」"
        },
        {
          "role": "派蒙",
          "text": "又是这个家伙！真是阴魂不散！"
        },
        {
          "type": "subtitle",
          "text": "击败嗜雷·兽境幼兽",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败深黯钓客",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败嗜雷·兽境猎犬嗜雷·兽境幼兽",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败嗜雷·兽境猎犬荒野狂狩士荒野幽徒",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "激活增幅器"
        },
        {
          "role": "叶洛亚",
          "text": "增幅器激活了！还有一处！"
        },
        {
          "type": "subtitle",
          "text": "激活剩余的增幅器"
        },
        {
          "type": "subtitle",
          "text": "乘上「月灵旅路」",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "role": "「末缀之劫」",
          "text": "渺小凡世不过柴薪…无人能生还…"
        },
        {
          "role": "「末缀之劫」",
          "text": "唯有忠心追随恩主…才可得苟延…"
        },
        {
          "type": "subtitle",
          "text": "未完成任务「物归原主」"
        },
        {
          "role": "派蒙",
          "text": "怎么都是这种让人听不懂的怪话！"
        },
        {
          "type": "subtitle",
          "text": "已完成任务「物归原主」"
        },
        {
          "role": "派蒙",
          "text": "欸？我们明明已经消灭过一次了…"
        },
        {
          "type": "subtitle",
          "text": "「末缀之劫」半血",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "叶洛亚",
          "text": "别让它逃了！快追上它！"
        },
        {
          "type": "subtitle",
          "text": "乘上「月灵旅路」",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败「末缀之劫」",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "激活剩余的增幅器"
        },
        {
          "role": "叶洛亚",
          "text": "好！操作间的门打开了！"
        },
        {
          "type": "subtitle",
          "text": "前往操作间"
        },
        {
          "type": "subtitle",
          "text": "乘上「月灵旅路」",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击溃「恶卵」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "启动",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "移动炮口以瞄准未孵化的「恶卵」",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "点按发射「德肋庇革劳诺之箭」",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "你叶洛亚一同推动面前的开关，德肋庇革劳诺之箭即刻朝着远方的高塔疾驰而去，爆发出一道巨大的光线…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "与叶洛亚对话"
        },
        {
          "role": "「教授」",
          "text": "通往魔天的门扉已经开启，此等微弱的月矩力能奈我何！"
        },
        {
          "role": "「教授」",
          "text": "但为何我会被困囿于此…我明白了，是三宝磨又一次拒绝了我。"
        },
        {
          "role": "爱莉厄",
          "text": "瞧瞧是谁来了，稀客呀。"
        },
        {
          "role": "「教授」",
          "text": "…谁在那里？"
        },
        {
          "role": "「教授」",
          "text": "这副模样…啊，是你，雷勒。太好了，我就知道你还活着。"
        },
        {
          "role": "「教授」",
          "text": "现在，命令三宝磨的力量臣服于我！拥有圣嗣之血的你一定能做到。毕竟和那三个废物不同，你是我最欣赏的弟子啊。"
        },
        {
          "role": "爱莉厄",
          "text": "哈，居然把我认作了雷勒…当年那个巧舌如簧的妖僧竟然昏聩至此，真是讽刺。"
        },
        {
          "role": "「教授」",
          "text": "不要犹豫，雷勒。你忘记我们共同的理想了吗？你不想取回那本应属于你的地位与身份了吗？"
        },
        {
          "role": "「教授」",
          "text": "为受欺凌和侮辱的人们创造「乐园」，让那些丑陋的妖精贵族都对你俯首，整个苍星王廷只有同为人类的我愿意帮你。"
        },
        {
          "role": "「教授」",
          "text": "如今，只差最后一步我就能登上群星的阶梯…当天穹之外的「乐园」降临时，唯有你我这样的受选之人才能够活下来。"
        },
        {
          "role": "「教授」",
          "text": "那时，所有的腐败与污秽都将被洗净，这不正是你所渴望的世界吗？"
        },
        {
          "role": "爱莉厄",
          "text": "不，那并非他想要的世界…都到这种时候了，还在试图施展你那拙劣的骗术吗？"
        },
        {
          "role": "爱莉厄",
          "text": "从一开始你就在利用他，所有的谎言都不过是为了让他替你取得三宝磨，你口中的那个「乐园」从来就只有你自己。"
        },
        {
          "role": "爱莉厄",
          "text": "就连他一开始会丢掉军官的身份成为大盗，也是因为你和阿尔维斯大公共同设下的圈套吧。"
        },
        {
          "role": "「教授」",
          "text": "……"
        },
        {
          "role": "爱莉厄",
          "text": "虽然你认错了人，不过继承了他身份与意志的我，当然也不会拒绝雷德·米勒之名。"
        },
        {
          "role": "爱莉厄",
          "text": "以雷德·米勒的名义，拉乌斯万格，妖僧，「教授」，不死的毒蛇…就由我为你的故事画上最后的句点吧。"
        },
        {
          "role": "叶洛亚",
          "text": "我们做到了…"
        },
        {
          "role": "叶洛亚",
          "text": "这次终于，将那不死的妖魔彻底葬送了…"
        },
        {
          "type": "subtitle",
          "text": "「那不死的毒蛇必将两度复活，再被三次击倒…直到被月下世界的英雄们彻底埋葬…」\n与英勇的执灯士们并肩作战，终于消灭了「教授」…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "之后，在皮拉米达城盘桓了数日…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "前往麦酒大厅"
        },
        {
          "role": "派蒙",
          "text": "叶洛亚应该在麦酒大厅等我们了，旅行者，我们走吧！"
        },
        {
          "type": "subtitle",
          "text": "与叶洛亚对话"
        },
        {
          "role": "叶洛亚",
          "text": "旅行者、派蒙！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们来啦！这里好热闹呀。"
        },
        {
          "role": "叶洛亚",
          "text": "这段时间大家都辛苦了，总算是将善后的工作也处理得差不多了，这才有时间组织宴会。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你也辛苦了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "我做的这些实在不算什么。而且，如果没有你们的协助，即使最终能够获胜，恐怕也会付出更多的牺牲…"
        },
        {
          "role": "派蒙",
          "text": "我们可是你的队员呢！就不要说这种见外的话啦。"
        },
        {
          "role": "叶洛亚",
          "text": "嗯，说得也是。啊，老爷子准备发言了。"
        },
        {
          "role": "尼基塔",
          "text": "各位战友，各位兄弟姐妹，今天我们汇聚一堂，不是为了单纯的欢庆，而是为了纪念这场来之不易的胜利。"
        },
        {
          "role": "尼基塔",
          "text": "在我们举杯之时，不要忘记那些再也无法与我们举杯同庆的人，他们以血肉为代价，兑现了誓言。"
        },
        {
          "role": "尼基塔",
          "text": "在此次的战役中，叶洛亚率领的「魇夜之莺」调查分队承担了最为艰巨的任务…"
        },
        {
          "role": "尼基塔",
          "text": "尤其是旅行者两位，在这危难之际仍义无反顾加入我们，在作战中发挥了不容忽视的作用。"
        },
        {
          "role": "尼基塔",
          "text": "他们不畏牺牲，迎难而上，从危难中为我们开拓了通向胜利的道路。"
        },
        {
          "role": "尼基塔",
          "text": "他们的功绩，所有为了生者和未来而奋斗的人的功绩，都将被永远铭刻于历史之中。"
        },
        {
          "role": "尼基塔",
          "text": "是的，我们胜利了！尽管付出了巨大的代价。我们可以流泪，可以哀悼，但绝不能被悲痛击垮。"
        },
        {
          "role": "尼基塔",
          "text": "因为我们所为之奋斗的「未来」将要到来，为了让火种传递，为了让引路的明灯继续照耀，我们还不能停下脚步。"
        },
        {
          "role": "尼基塔",
          "text": "但是，只在今日，让我们为了胜利，为了英勇不朽的战友们，也为了未来，干杯吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（叶洛亚）"
        },
        {
          "role": "叶洛亚",
          "text": "要是比约恩也在就好了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他一定会非常自豪的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "叶洛亚",
          "text": "是啊。过几天再去看看他好了，告诉他城里的近况，让他放心。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（安莱夫）"
        },
        {
          "role": "安莱夫",
          "text": "干杯！旅行者！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "干杯！",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "和众人一边谈笑，一边畅饮，度过了一段轻松愉快的时光…",
                  "narration": true,
                  "color": "描述"
                }
              ]
            },
            {
              "text": "你别喝太多了。",
              "dialogues": [
                {
                  "role": "安莱夫",
                  "text": "哈哈，知道知道！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（罗洛）"
        },
        {
          "role": "罗洛",
          "text": "旅行者，宴会的餐饮还合你的口味吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要是每天都有宴会就好了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "罗洛",
          "text": "每天吗？那或许有些勉强…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只是开个玩笑！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "罗洛",
          "text": "哈哈，是吗？不过也不是不能理解。希望今后能多一些像今天这样值得庆祝的日子。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（尼基塔）"
        },
        {
          "role": "尼基塔",
          "text": "辛苦你们了，今天就暂且放下责任，好好休息吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（奥拉维）"
        },
        {
          "role": "奥拉维",
          "text": "机会难得，自从老爷子让我当了分队长，就只有这种场合才有机会跟兄弟们叙叙旧了。"
        }
