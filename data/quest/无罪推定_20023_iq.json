{
  "quest_id": 20023,
  "chapter_num": null,
  "chapter_title": "无罪推定",
  "type": "iq",
  "route": "Presumption of Innocence",
  "stories": [
    {
      "story_id": 20023,
      "title": "无罪推定",
      "description": "维多利亚修女似乎正在思考一件事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "询问维多利亚修女"
        },
        {
          "role": "维多利亚",
          "text": "他到底有没有悔改呢…"
        },
        {
          "role": "旅行者",
          "text": "悔改什么？"
        },
        {
          "role": "维多利亚",
          "text": "每天都会有很多人到我这里，倾诉他们所犯下的罪孽，祈求神的原谅。"
        },
        {
          "role": "维多利亚",
          "text": "但如果只是口头说说，不付诸行动，那不就只是在浪费时间吗？"
        },
        {
          "role": "维多利亚",
          "text": "比如宁禄先生，他为自己酗酒的习惯忏悔了好多次，但一点改变都没有…"
        },
        {
          "role": "维多利亚",
          "text": "如果你有空的话，去帮我去看看他现在的情况吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "维多利亚",
                  "text": "对了，如果他又在喝酒，请带一些证据回来。"
                },
                {
                  "role": "维多利亚",
                  "text": "屡教不改的人…还是需要一点能深刻铭记的「教诲」。"
                }
              ]
            },
            {
              "text": "喝酒也算「罪孽」吗？",
              "dialogues": [
                {
                  "role": "维多利亚",
                  "text": "喝酒不算「罪孽」，但是因为喝酒，而让其他人陷入苦恼算是「罪孽」。"
                },
                {
                  "role": "维多利亚",
                  "text": "如果每个人都恣意妄为，那么这座蒙德城，总有一天也会陷入巨大的苦恼中。"
                },
                {
                  "role": "维多利亚",
                  "text": "所以，要将每一份刚冒头的「罪孽」掐断，好了，你快点去看看宁禄的情况吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "找到宁禄先生"
        },
        {
          "role": "宁禄",
          "text": "哈哈哈，我每天都指着这一杯…"
        },
        {
          "role": "旅行者",
          "text": "你不是说要戒酒吗？"
        },
        {
          "role": "宁禄",
          "text": "啊？！吓死我了…我还以为是我老婆呢。"
        },
        {
          "role": "宁禄",
          "text": "偶尔喝一点也无所谓吧，我可是辛苦工作了一天啊。"
        },
        {
          "role": "宁禄",
          "text": "好了好了，我再喝一点就回去了…优律也差不多该买完东西了。"
        },
        {
          "type": "subtitle",
          "text": "调查酒杯取证"
        },
        {
          "type": "subtitle",
          "text": "与酒保查尔斯对话"
        },
        {
          "role": "查尔斯",
          "text": "怎么？有事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于宁禄…"
        },
        {
          "role": "查尔斯",
          "text": "他今天已经喝了快半天了，你看，这是他喝的账单。"
        },
        {
          "role": "查尔斯",
          "text": "再这么下去，只能把优律小姐叫来了吧。"
        },
        {
          "role": "查尔斯",
          "text": "借用一下？也不是不行，可是你们要这个做什么？"
        },
        {
          "type": "subtitle",
          "text": "向维多利亚修女回报"
        },
        {
          "role": "维多利亚",
          "text": "人不会轻易从过去中学到任何教训，除非…有人亲口告诉他们。"
        },
        {
          "role": "维多利亚",
          "text": "调查的情况如何？"
        },
        {
          "role": "旅行者",
          "text": "这是宁禄的喝酒账单。"
        },
        {
          "role": "维多利亚",
          "text": "哼，果然是这样…不出所料。"
        },
        {
          "role": "维多利亚",
          "text": "无论过去经历了什么，只要没有真正吃到苦头，人们最终什么都不会记得…"
        },
        {
          "role": "维多利亚",
          "text": "好了，这是给你们的答谢，收下吧。"
        },
        {
          "role": "维多利亚",
          "text": "宁禄的那一份「答谢」，我也会好好思考的。"
        },
        {
          "type": "subtitle",
          "text": "找到宁禄先生"
        },
        {
          "type": "subtitle",
          "text": "观察宁禄先生的近况"
        },
        {
          "role": "维多利亚",
          "text": "人不会轻易从过去中学到任何教训，除非…有人亲口告诉他们。"
        },
        {
          "type": "subtitle",
          "text": "向维多利亚修女回报"
        },
        {
          "role": "昆恩",
          "text": "今天客人还是这么多啊，真是累死了…"
        },
        {
          "role": "维多利亚",
          "text": "调查的情况如何？"
        },
        {
          "role": "旅行者",
          "text": "宁禄正在努力戒酒。"
        },
        {
          "role": "维多利亚",
          "text": "正在努力戒酒…是这样吗。"
        },
        {
          "role": "旅行者",
          "text": "但是没有证据…"
        },
        {
          "role": "维多利亚",
          "text": "没关系，只要你们没有找到他喝酒的证据，我就可以认为他正在悔改了。"
        },
        {
          "role": "维多利亚",
          "text": "在没有证据之前，我一直相信，每个人都是无罪的。"
        },
        {
          "role": "维多利亚",
          "text": "但是…总是会有各种各样的证据，证明着他们的各种「罪孽」…真是好笑。"
        },
        {
          "role": "维多利亚",
          "text": "这是给你们的答谢，收下吧。希望你们不会有需要「悔罪」的那一天。"
        }
      ]
    }
  ]
}