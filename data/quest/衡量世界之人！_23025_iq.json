{
  "quest_id": 23025,
  "chapter_num": null,
  "chapter_title": "衡量世界之人！",
  "type": "iq",
  "route": "To Measure the World!",
  "stories": [
    {
      "story_id": 23025,
      "title": "衡量世界之人！",
      "description": "一名想要「测量世界」的学者，似乎遇到了研究的瓶颈…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与法伽尼对话"
        },
        {
          "role": "法伽尼",
          "text": "嘿——这位朋友，请问能否占用您一些时间？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么事？",
              "dialogues": []
            },
            {
              "text": "我很忙。",
              "dialogues": [
                {
                  "role": "法伽尼",
                  "text": "哦！请别这么说，有什么事情能比自己的居所坍圮在即还要严重？"
                },
                {
                  "role": "旅行者",
                  "text": "你家屋子…要塌了？"
                },
                {
                  "role": "法伽尼",
                  "text": "咳咳，那当然不是。但如果您住在一座屋子里，却从没见过这屋子的全貌，也没人保证过屋子的结构强度…"
                },
                {
                  "role": "法伽尼",
                  "text": "那每天生活在这屋子里，也是会有不安的吧？那么住在这个世界里也是一个道理。"
                }
              ]
            }
          ]
        },
        {
          "role": "法伽尼",
          "text": "您有没有想过这么一个问题：要是天塌下来该怎么办？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我觉得你多虑了…",
              "dialogues": []
            },
            {
              "text": "天应该塌不下来…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法伽尼",
          "text": "或许是吧，但天空为什么不会坍塌？大地又为什么不会陷落？如果不经过准确的测量，这些问题就永远不会有答案。"
        },
        {
          "role": "法伽尼",
          "text": "其实我已经有了一套完美的模型来解释这些问题，只是需要更多的观测数据来支撑…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "需要我帮忙吗？",
              "dialogues": []
            },
            {
              "text": "祝你好运，再见。",
              "dialogues": [
                {
                  "role": "法伽尼",
                  "text": "等、等等啊！您再考虑一下吧，只要我的成果能够发表，那可是开天辟地的大事！"
                },
                {
                  "role": "法伽尼",
                  "text": "到时候，您就是这篇伟大理论的协力者，我可以在文末的致谢列表里写上您的名字…"
                },
                {
                  "role": "法伽尼",
                  "text": "咕…要不然的话，第二作者的位置也不是不能…"
                },
                {
                  "role": "旅行者",
                  "text": "有这么着急吗…"
                },
                {
                  "role": "法伽尼",
                  "text": "要是再拿不出结果，我的研究经费怕是都要出问题…这可比天什么时候会塌要命得多。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "「第二作者」就算了…",
                      "dialogues": []
                    },
                    {
                      "text": "报酬合理就可以。",
                      "dialogues": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "role": "法伽尼",
          "text": "那您是愿意帮忙了吧，真是太感谢了！"
        },
        {
          "role": "法伽尼",
          "text": "其实我已经选定了一个绝佳的观测地点，只是那附近的魔物有些活跃…"
        },
        {
          "role": "法伽尼",
          "text": "拜托您驱离那些魔物，我好安心去做观测记录。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好的。",
              "dialogues": [
                {
                  "role": "法伽尼",
                  "text": "多谢了，我们这就上路吧。"
                }
              ]
            },
            {
              "text": "你也要到现场吗？",
              "dialogues": [
                {
                  "role": "法伽尼",
                  "text": "毕竟有些数据还是得亲眼去见证，才能发现误差产生的原因啊。"
                },
                {
                  "role": "法伽尼",
                  "text": "埋头对着纸堆计算，可是会离正解越算越远的——我们快点上路吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "击败目的地附近的魔物"
        },
        {
          "type": "subtitle",
          "text": "与法伽尼对话"
        },
        {
          "role": "法伽尼",
          "text": "嗯嗯…原来是这样吗？只要再引入这个变量，就能解释之前的误差…"
        },
        {
          "role": "法伽尼",
          "text": "不过这么一来，别的推论会不会也跟着改变呢…"
        },
        {
          "role": "旅行者",
          "text": "有进展了吗？"
        },
        {
          "role": "法伽尼",
          "text": "啊，不好意思，都忘了你还在这里…来，这是说好的报酬。"
        },
        {
          "role": "法伽尼",
          "text": "至于进展嘛…虽然解决了一些问题，但又好像出现了不少新问题…大概这就是做研究吧。"
        },
        {
          "role": "法伽尼",
          "text": "在得出最终的结论之前，可能还是得继续麻烦你了，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "与法伽尼对话"
        },
        {
          "role": "法伽尼",
          "text": "嘿——这位朋友，请问能否占用您一些时间？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有什么事？",
              "dialogues": []
            },
            {
