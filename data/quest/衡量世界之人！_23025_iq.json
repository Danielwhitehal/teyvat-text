                },
                {
                  "role": "旅行者",
                  "text": "有这么着急吗…"
                },
                {
                  "role": "法伽尼",
                  "text": "要是再拿不出结果，我的研究经费怕是都要出问题…这可比天什么时候会塌要命得多。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "「第二作者」就算了…",
                      "dialogues": []
                    },
                    {
                      "text": "报酬合理就可以。",
                      "dialogues": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "role": "法伽尼",
          "text": "那您是愿意帮忙了吧，真是太感谢了！"
        },
        {
          "role": "法伽尼",
          "text": "其实我找人订制了一组信标，可以自动采集推论必需的原始数据。"
        },
        {
          "role": "法伽尼",
          "text": "为了尽量排除地势干扰，这组信标最好设置在悬崖、山顶一类的高处。"
        },
        {
          "role": "法伽尼",
          "text": "可我这身板，怎么看都不是爬上爬下的料…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "法伽尼",
                  "text": "多谢了！采样地点就在附近，设置完告诉我就好。"
                }
              ]
            },
            {
              "text": "订制的时候没考虑这点吗？",
              "dialogues": [
                {
                  "role": "法伽尼",
                  "text": "咳…当时优先考虑仪器的灵敏度了，适用范围自然就得做些牺牲…"
                },
                {
                  "role": "法伽尼",
                  "text": "毕竟原始数据稍微带些误差，演算结果就会完全跑偏啊——总之就拜托你了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "设置信标"
        },
        {
          "role": "法伽尼",
          "text": "希望这次的数据不要再有误差了…"
        },
        {
          "type": "subtitle",
          "text": "与法伽尼对话"
        },
        {
          "role": "法伽尼",
          "text": "嗯？信标都已经设置完了吗？"
        },
        {
          "role": "旅行者",
          "text": "都设置好了。"
        },
        {
          "role": "法伽尼",
          "text": "真是太谢谢了，来，这是说好的报酬。"
        },
        {
          "role": "法伽尼",
          "text": "这下只要等它们采集完数据，就能证实之前的推论了！"
        },
        {
          "role": "法伽尼",
          "text": "不过话又说回来，我该怎么上去回收这些信标呢…"
        },
        {
          "type": "subtitle",
          "text": "与法伽尼对话"
        },
        {
          "role": "法伽尼",
          "text": "哦！旅行者，您可终于来了！"
        },
        {
          "role": "旅行者",
          "text": "研究还顺利吗？"
        },
        {
          "role": "法伽尼",
          "text": "托您的福，这几天的进展可不小，那些信标应该有在好好收集数据吧。"
        },
        {
          "role": "法伽尼",
          "text": "现在只要把那些数据回收，就能验证这几天提出的新猜想了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这几天就只是在猜想吗！",
              "dialogues": []
            },
            {
              "text": "这不是完全没有进展吗！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法伽尼",
          "text": "咳咳，也有对计算公式的优化、测量仪器的校准之类的，毕竟您看…"
        },
        {
          "role": "法伽尼",
          "text": "凭我这副身板，也没办法爬到您设置信标的地方去回收啊。"
        },
        {
          "role": "法伽尼",
          "text": "这回恐怕还是要麻烦您一趟，去收回那些信标了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧…",
              "dialogues": [
                {
                  "role": "法伽尼",
                  "text": "拜托了，旅行者，我会好好准备报酬的！"
                }
              ]
            },
            {
              "text": "下次可以先考虑好怎么回收…",
              "dialogues": [
                {
                  "role": "法伽尼",
                  "text": "我也不是没有想过，加装回收装置啊、拓宽适用范围啊之类的…"
                },
                {
                  "role": "法伽尼",
                  "text": "但是这一来要更多的预算，二来也不知道会不会影响数据精度…"
                },
                {
                  "role": "法伽尼",
                  "text": "总、总之这次还是要看您的了，拜托了，旅行者！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往设置信标处"
        },
        {
          "type": "subtitle",
          "text": "回收信标"
        },
        {
          "role": "法伽尼",
          "text": "希望这次的数据不要再有误差了…"
        },
        {
          "type": "subtitle",
          "text": "与法伽尼对话"
        },
        {
          "role": "法伽尼",
          "text": "什么？居然有魔物出现？这不应该呀，那片区域的环境参数明明…"
        },
        {
          "role": "法伽尼",
          "text": "难不成是信标本身也构成了变量？如果是运作时的轻微震动和声光吸引了魔物…"
        },
        {
          "role": "法伽尼",
          "text": "不会影响到采集的数据吧…啊，实在抱歉，我又自顾自地说话了。"
        },
        {
          "role": "法伽尼",
          "text": "我也没想到，居然会给您添额外的麻烦…这些报酬还请务必收下。"
        },
        {
          "role": "法伽尼",
          "text": "下次测量，一定要考虑得更谨慎些…"
        }
      ]
    }
  ]
}