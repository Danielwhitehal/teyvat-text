      "title": "鹿野奈奈的健康饮食计划",
      "description": "鸣神岛的鹿野奈奈需要十五根胡萝卜。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将十五根胡萝卜交给鹿野奈奈"
        },
        {
          "role": "旅行者",
          "text": "关于胡萝卜…"
        },
        {
          "role": "鹿野奈奈",
          "text": "挑食的小孩子都长不高哦，所以绝对不能挑食，料理里的胡萝卜也要吃。"
        },
        {
          "role": "鹿野奈奈",
          "text": "好了，你是接了委托的那位吧，那么十五根胡萝卜你也准备好了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": []
            },
            {
              "text": "还没有。",
              "dialogues": [
                {
                  "role": "鹿野奈奈",
                  "text": "那你准备好了之后，再拿给我吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与鹿野奈奈对话"
        },
        {
          "role": "鹿野奈奈",
          "text": "很好很好，这次我一定要看着那孩子把胡萝卜吃下去。"
        }
      ]
    }
  ]
