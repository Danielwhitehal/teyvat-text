{
  "quest_id": 70517,
  "chapter_num": null,
  "chapter_title": "残留的谜团？",
  "type": "wq",
  "route": "Any Unsolved Mysteries?",
  "stories": [
    {
      "story_id": 70517,
      "title": "残留的谜团？",
      "description": "这段时间，派蒙突然有了奇妙的预感，提议再去一趟金苹果群岛，在周围仔细看看…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往派蒙指示的地点"
        },
        {
          "role": "派蒙",
          "text": "这一带看起来很普通呢。"
        },
        {
          "role": "派蒙",
          "text": "好像找不到什么吃的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说漏嘴了，派蒙。",
              "dialogues": []
            },
            {
              "text": "难怪你这么积极。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "咳咳，调查秘密的过程中也是要吃东西的，这是人之常情嘛！"
        },
        {
          "role": "派蒙",
          "text": "再说了，最近我们图省事，吃了好多好多烧烤，你也有点腻了吧？"
        },
        {
          "role": "派蒙",
          "text": "如果我们能在沙滩上捡到贝壳或海螺，就把它们和水果一起炖着吃。"
        },
        {
          "role": "派蒙",
          "text": "鲜鲜的，甜甜的，弹弹的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来好黑暗，我才不要。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "试试看嘛，说不定会打开新世界的大门！"
                }
              ]
            },
            {
              "text": "听起来是派蒙会有的口感。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂！人家可不是水产！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "等等，旅行者，你看那边。"
        },
        {
          "role": "派蒙",
          "text": "突然出现的机关…好像有蹊跷？"
        },
        {
          "role": "派蒙",
          "text": "附近还有一些行李货物，是愚人众的东西吗？"
        },
        {
          "role": "旅行者",
          "text": "还真被派蒙说中了，好耶。"
        },
        {
          "role": "派蒙",
          "text": "我的预感果然很靠谱，好耶…"
        },
        {
          "role": "派蒙",
          "text": "什么好耶，呸呸呸！明明是我们有麻烦了！"
        },
        {
          "role": "派蒙",
          "text": "既然是和愚人众有关的东西，出现在这里，就很可能有阴谋。"
        },
        {
          "role": "派蒙",
          "text": "如果放着它们不管，说不定又会不停发展，变得很难办。"
        },
        {
          "role": "派蒙",
          "text": "总之，先试着处理那个机关吧？如果你觉得有必要，再调查一下愚人众的货物。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，拿出以前的干劲，搞定它们以后，我们就能安心找食材了！"
        }
      ]
    }
  ]
}