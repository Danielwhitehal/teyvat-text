{
  "quest_id": 22500,
  "chapter_num": null,
  "chapter_title": "成长的烦恼",
  "type": "iq",
  "route": "Growing Pains",
  "stories": [
    {
      "story_id": 22500,
      "title": "成长的烦恼",
      "description": "璐璐最近有些不开心，似乎正在因为某事而烦恼着…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与璐璐对话"
        },
        {
          "role": "璐璐",
          "text": "什么时候才能做好呢…"
        },
        {
          "role": "旅行者",
          "text": "今天没玩游戏吗？"
        },
        {
          "role": "璐璐",
          "text": "大哥哥，是你呀，最近不适合玩游戏呢。"
        },
        {
          "role": "璐璐",
          "text": "小蒙好像有点不开心，老是一个人发呆，阿飞也时不时就找不到人了。"
        },
        {
          "role": "璐璐",
          "text": "我问小蒙怎么了，小蒙也不和我说…总觉得，大家最近都有点奇怪。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "长大了就会这样。",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "人长大了，就会不开心吗？但是小蒙和阿飞都很想长大…"
                },
                {
                  "role": "璐璐",
                  "text": "如果是这样的话，那我还是先不长大比较好。"
                },
                {
                  "role": "璐璐",
                  "text": "先不说这个了，我有点小事，想请大哥哥帮忙。"
                }
              ]
            },
            {
              "text": "你也不开心吗？",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "我？我还好喔，不过…还是有点小事想请大哥哥帮忙。"
                }
              ]
            }
          ]
        },
        {
          "role": "璐璐",
          "text": "你能帮我去莺儿姐姐那里拿点东西吗？我和她已经说好了，那里应该已经把东西留给我了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "那就拜托大哥哥啦。"
                }
              ]
            },
            {
              "text": "从莺儿那里…",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "大哥哥可不要瞎想喔，我只是拜托莺儿姐姐帮忙做了点东西而已。"
                },
                {
                  "role": "璐璐",
                  "text": "总之，就拜托大哥哥啦。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与莺儿对话"
        },
        {
          "role": "莺儿",
          "text": "哎呀，又是你，这次来找我是想做什么呢？"
        },
        {
          "role": "旅行者",
          "text": "来取璐璐的东西。"
        },
        {
          "role": "莺儿",
          "text": "那孩子的东西啊…我记起来了，她确实让我帮她做一份香膏…"
        },
        {
          "role": "莺儿",
          "text": "不过，你们来得有些不巧…不知道为什么，自从那天你们来找我之后，突然有很多人来找我预定香膏。"
        },
        {
          "role": "莺儿",
          "text": "那么多订单，我还得打理店里的生意，一个人都要处理不来了。"
        },
        {
          "role": "莺儿",
          "text": "而且璐璐还是个孩子，平常我们大人用的香膏如果直接给她用的话，未免有些不太合适。"
        },
        {
          "role": "莺儿",
          "text": "我之前在想怎么调整香膏的配方，才刚刚想出个方案来，还没开始做呢。"
        },
        {
          "role": "莺儿",
          "text": "如果要加急的话，倒也不是不行，可是…"
        },
        {
          "role": "旅行者",
          "text": "三千摩拉够了吗？"
        },
        {
          "role": "莺儿",
          "text": "你可真是个急性子…好吧，就当看在我们情谊的份儿上，我会先做璐璐的那份香膏的。"
        },
        {
          "role": "莺儿",
          "text": "不过，白天我还得看店，只有晚上才能做些私事。"
        },
        {
          "role": "莺儿",
          "text": "请你晚上再来找我吧，我会先把准备工作做好的。"
        },
        {
          "role": "旅行者",
          "text": "我来帮你。"
        },
        {
          "role": "莺儿",
          "text": "嗯，这样也好，你在这种事上的丰富经验…我再清楚不过了，呵呵。"
        },
        {
          "role": "莺儿",
          "text": "我这边还有之前没用完的原料，我会去卯师傅的厨房处理一下。"
        },
        {
          "role": "莺儿",
          "text": "你先去采三株薄荷，再把薄荷拿到合成台上去制成精油吧，制作的手法你应该很了解了吧？"
        },
        {
          "role": "莺儿",
          "text": "把薄荷精油拿给我，我来帮忙把璐璐的香膏做好。"
        },
        {
          "type": "subtitle",
          "text": "等待夜晚降临"
        },
        {
          "type": "subtitle",
          "text": "与莺儿对话取得香膏"
        },
        {
          "role": "莺儿",
          "text": "香膏已经做好了，是我用薄荷精油特别制作的喔。"
        },
        {
          "role": "莺儿",
          "text": "来，拿好了，带回去给璐璐吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": []
            },
            {
              "text": "为什么是薄荷精油？",
              "dialogues": [
                {
                  "role": "莺儿",
                  "text": "稀释一些刺激性的成分…略微中和一下气味…"
                },
                {
                  "role": "莺儿",
                  "text": "话说回来，当时也真是没想到会收到璐璐的订单呢。"
                },
                {
                  "role": "莺儿",
                  "text": "情窦初开的年纪，回想一下真是令人脸红心跳啊，要是当时懂得再多一点的话…"
                },
                {
                  "role": "莺儿",
                  "text": "咳…好了，快点拿回去给璐璐吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找三株薄荷"
        },
        {
          "type": "subtitle",
          "text": "合成薄荷精油"
        },
        {
          "type": "subtitle",
          "text": "等待莺儿熬制香膏"
        },
        {
          "type": "subtitle",
          "text": "与莺儿交谈"
        },
        {
          "role": "莺儿",
          "text": "完成了，这就是我专门给璐璐制作的薄荷香膏了，赶紧拿回去给她吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": []
            },
            {
              "text": "璐璐要这个来做什么…",
              "dialogues": [
                {
                  "role": "莺儿",
                  "text": "这我可不知道，我也不会去问璐璐。"
                },
                {
                  "role": "莺儿",
                  "text": "每个女孩子的心底都会有一些自己的小秘密的，要做识趣的人才能招人喜欢呀。"
                },
                {
                  "role": "莺儿",
                  "text": "好了，快点把薄荷香膏带回去给璐璐吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "把香膏交给璐璐"
        },
        {
          "role": "旅行者",
          "text": "三千摩拉够了吗？"
        },
        {
          "role": "莺儿",
          "text": "唔，你身上的钱好像不够呢。"
        },
        {
          "role": "璐璐",
          "text": "大哥哥，你拿到香膏了吗？"
        },
        {
          "role": "旅行者",
          "text": "拿到了。"
        },
        {
          "role": "璐璐",
          "text": "谢谢大哥哥，莺儿姐姐做的香膏可真好。"
        },
        {
          "role": "璐璐",
          "text": "不知道小蒙和阿飞闻到了之后会是什么反应…"
        },
        {
          "role": "璐璐",
          "text": "不过，不管他们是什么反应，应该都很好玩吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他们会喜欢的。",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "这样就最好啦。"
                }
              ]
            },
            {
              "text": "你最喜欢和谁玩？",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "唔？没有「最喜欢」喔，小蒙和阿飞，都是我最好的朋友。"
                }
              ]
            }
          ]
        },
        {
          "role": "璐璐",
          "text": "谢谢大哥哥，我等会就回家试试看这盒香膏。"
        },
        {
          "role": "璐璐",
          "text": "如果合适的话，那我就可以一直用下去啦。"
        },
        {
          "role": "莺儿",
          "text": "记住了，是薄荷精油哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "薄荷精油怎么做…",
              "dialogues": [
                {
                  "role": "莺儿",
                  "text": "你已经全忘了？哼，明明之前才一起做过，居然忘得这么快…"
                },
                {
                  "role": "莺儿",
                  "text": "我再教你一次好了，先去采三株薄荷，再把薄荷拿到合成台上制成精油。"
                },
                {
                  "role": "莺儿",
                  "text": "把精油拿回来给我，其余的就交给我吧。"
                }
              ]
            },
            {
              "text": "薄荷精油有什么用…",
              "dialogues": [
                {
                  "role": "莺儿",
                  "text": "嗯…主要是中和一些刺激性的成分…"
                },
                {
                  "role": "莺儿",
                  "text": "不过，最重要的还是，薄荷的味道很适合璐璐这孩子。"
                },
                {
                  "role": "莺儿",
                  "text": "女孩子的香味可不应该仅仅是一种闻起来的味道而已…"
                },
                {
                  "role": "莺儿",
                  "text": "璐璐动人的活力，涉世未深的清纯，我会将它们都融进这一盒香膏中，呵呵。"
                }
              ]
            }
          ]
        },
        {
          "role": "莺儿",
          "text": "急什么呀，心急可吃不了热豆腐。"
        }
      ]
    }
  ]
}