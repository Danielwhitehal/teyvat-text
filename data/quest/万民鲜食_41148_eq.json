{
  "quest_id": 41148,
  "chapter_num": null,
  "chapter_title": "万民鲜食",
  "type": "eq",
  "route": "Wanmin Fresh",
  "stories": [
    {
      "story_id": 41148,
      "title": "万民鲜食",
      "description": "璃月港的万民堂里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "卯师傅",
          "text": "好吧，那你先忙你的去，我去找其他人帮忙…"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "卯师傅",
          "text": "那就拜托你了。"
        },
        {
          "role": "卯师傅",
          "text": "记得送的时候小心着点，不要沾了奇怪的东西。还有千万别用风之翼。"
        },
        {
          "role": "卯师傅",
          "text": "不然这摩拉肉里的肉，非全被颠出来不可…"
        },
        {
          "role": "好奇的子瑞",
          "text": "怎么还没送来，这都过了多长时间了…"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "卯师傅",
          "text": "对，一位叫子瑞的小伙子在我们这订了一份摩拉肉，钱已经付好了。"
        },
        {
          "role": "卯师傅",
          "text": "然后…他让我们晚些时候送到渌华池附近的一个地方。"
        },
        {
          "role": "卯师傅",
          "text": "我还要在这看着店，你愿意帮我去跑一趟吗？"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "好奇的子瑞",
          "text": "总算送到了，谢谢，谢谢。"
        },
        {
          "role": "好奇的子瑞",
          "text": "吃饱了之后我还得去周围逛逛。"
        },
        {
          "role": "好奇的子瑞",
          "text": "唉，这周围也没几块能入眼的石头…"
        }
      ]
    }
  ]
}