{
  "quest_id": 76186,
  "chapter_num": null,
  "chapter_title": "小小的尝试",
  "type": "wq",
  "route": "A Small Overture",
  "stories": [
    {
      "story_id": 76186,
      "title": "小小的尝试",
      "description": "前往霜月之坊放置茶桌并使用桑多涅落座后，与菈乌玛共度茶会时光吧…",
      "dialogues": [
        {
          "role": "菈乌玛",
          "text": "……"
        },
        {
          "role": "「木偶」",
          "text": "……"
        },
        {
          "role": "「木偶」",
          "text": "…「霜月之子」，最近还好吗？"
        },
        {
          "role": "菈乌玛",
          "text": "还不错。月神的回归，也让我们坚定了自己应走的道路。"
        },
        {
          "role": "「木偶」",
          "text": "是吗？那就好。"
        },
        {
          "role": "「木偶」",
          "text": "……"
        },
        {
          "role": "菈乌玛",
          "text": "……"
        },
        {
          "role": "「木偶」",
          "text": "哈…果然我们之间还是聊不了什么吗？"
        },
        {
          "role": "菈乌玛",
          "text": "这…恐怕是因为「霜月之子」与「愚人众」之间，有过太多不愉快的过往了吧。"
        },
        {
          "role": "菈乌玛",
          "text": "从我个人的角度来说，自然是感激桑多涅小姐你在保护挪德卡莱和迎回月神上的付出。但对其他人…"
        },
        {
          "role": "「木偶」",
          "text": "我懂。曾经的种种原因，让我们没能建立良好的友谊，哪怕是互利关系也没有。"
        },
        {
          "role": "「木偶」",
          "text": "可现在「愚人众」不再从「霜月之子」手中渴求什么了，我也提醒过自己的部下不要对「霜月之子」有所刁难。"
        },
        {
          "role": "「木偶」",
          "text": "从我个人的角度来说，既然大家都是邻居，就算做不到和谐共处，也还是以互相尊重的态度交往为好。"
        },
        {
          "role": "菈乌玛",
          "text": "这恐怕需要时间…"
        },
        {
          "role": "「木偶」",
          "text": "当然。但不如从一次次尝试开始吧。尝尝我泡的香草茶？"
        },
        {
          "role": "菈乌玛",
          "text": "香草茶？哈…"
        },
        {
          "role": "菈乌玛",
          "text": "嗯…居然能做到如此醇厚，是「霜月之子」的泡法？我记得外面的人不喜欢这种喝法，你是怎么…"
        },
        {
          "role": "「木偶」",
          "text": "学习。还有尊重。"
        },
        {
          "role": "菈乌玛",
          "text": "哈…看来，这的确是一次不错的尝试。"
        },
        {
          "role": "「木偶」",
          "text": "希望合你口味。"
        },
        {
          "role": "菈乌玛",
          "text": "嗯，我很喜欢。"
        },
        {
          "role": "菈乌玛",
          "text": "茶饮间的礼尚往来，向来都是邻居间友好相处的良好开端。"
        },
        {
          "role": "菈乌玛",
          "text": "我想，这次也不例外呢。"
        },
        {
          "role": "菈乌玛",
          "text": "十分美味的香草茶，桑多涅小姐。我从中感受到了你的用心。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "菈乌玛",
          "text": "好。下次就换我邀请你来「霜月之子」品茶吧。"
        }
      ]
    }
  ]
}