{
  "quest_id": 2061,
  "chapter_num": "花之归尘，羽之将坠 第一幕",
  "chapter_title": "特拉洛坎的失翼者",
  "type": "lq",
  "route": "The Wingless One of Tlalocan",
  "stories": [
    {
      "story_id": 15019,
      "title": "特拉洛坎的失翼者",
      "description": "在花羽会附近，似乎有位失意的人…",
      "dialogues": [
        {
          "role": "？？？",
          "text": "……♪"
        },
        {
          "role": "派蒙",
          "text": "咦？这是什么声音，好像是从那边的桥上传来的？"
        },
        {
          "role": "？？？",
          "text": "……♪"
        },
        {
          "role": "？？？",
          "text": "…呜…呜…"
        },
        {
          "role": "派蒙",
          "text": "哇，那个女孩怎么突然哭起来了？我、我们要不要去安慰一下？万一她做出什么傻事…"
        },
        {
          "role": "恰斯卡",
          "text": "最好不要。"
        },
        {
          "role": "恰斯卡",
          "text": "花羽会（特拉洛坎）的战士向来高傲，只会在无人处暴露自己的脆弱…哪怕是一名准「失翼者」。"
        },
        {
          "type": "subtitle",
          "text": "未开始第五章·第二幕「黑石湮落白石下」"
        },
        {
          "role": "派蒙",
          "text": "啊，你是圣火竞技场上人气很高的那位！恰…恰…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "恰斯卡。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "真高兴能被你记住名字，异国的旅行者，我也听说过你们。"
        },
        {
          "role": "派蒙",
          "text": "你们不是去参加「巡夜者战争」了吗？怎么会在这里？"
        },
        {
          "role": "恰斯卡",
          "text": "我很快就要出发了，只是在那之前，还有些放心不下的事情。"
        },
        {
          "type": "subtitle",
          "text": "完成第五章·第二幕「黑石湮落白石下」"
        },
        {
          "role": "派蒙",
          "text": "啊！是恰斯卡？"
        },
        {
          "role": "恰斯卡",
          "text": "很高兴见到你们，旅行者，派蒙。"
        },
        {
          "role": "恰斯卡",
          "text": "不过在相互寒暄之前，还是先稍微离远一些吧，别让科优尔发现我们了。"
        },
        {
          "role": "派蒙",
          "text": "你说的科优尔…就是桥上的那个女孩子吗？放着她不管真的没问题吗？要是她一个想不开…"
        },
        {
          "role": "恰斯卡",
          "text": "放心吧，阿尔帕长老派我过来，就是为了预防这种情况。如果真有个万一，我会随时飞去接应的。"
        },
        {
          "role": "恰斯卡",
          "text": "不过科优尔现在再怎么失落，也曾是以天空为目标的战士。她的心灵可没有那么脆弱。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "以天空为目标？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "嗯，在花羽会里有一支精英飞行队，会乘着绒翼龙在空中翱翔。"
        },
        {
          "role": "恰斯卡",
          "text": "但想要成为驰骋天空的骑士，既需要高超的技艺，又需要绒翼龙的认可，能通过试炼的人少之又少。"
        },
        {
          "role": "恰斯卡",
          "text": "科优尔为上次的飞行试炼已经做了好几年的准备，却还是失败了…所以才会这么伤心吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你说的准「失翼者」又是…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "一些屡次在飞行试炼中落选、未能取得绒翼龙认可的人，最后会心灰意懒，放弃对天空的向往…"
        },
        {
          "role": "恰斯卡",
          "text": "…也不再尝试挑战。这些人会被称作「失翼者」。"
        },
        {
          "role": "派蒙",
          "text": "然…然后就会被部族驱逐吗！"
        },
        {
          "role": "恰斯卡",
          "text": "嗯？怎么可能？他们可都是宝贵的战士。"
        },
        {
          "role": "恰斯卡",
          "text": "「绒翼龙会爱惜自己的每一根羽毛，部族会爱惜自己的每一个子民。」"
        },
        {
          "type": "subtitle",
          "text": "完成第五章·第四幕「命定将焚的虹光」"
        },
        {
          "role": "恰斯卡",
          "text": "尤其是在经历过先前的大战后…每一位年轻的战士，都肩负着我们的未来。"
        },
        {
          "role": "恰斯卡",
          "text": "每一只绒翼龙在学会飞行前都曾经跌下山崖，曾经的「失翼者」也可能重新燃起斗志。"
        },
        {
          "role": "恰斯卡",
          "text": "而在那之前，默默关注、守望着他们…就是我现在在做的事了。"
        },
        {
          "role": "派蒙",
          "text": "哦…希望她能快点振作起来！"
        },
        {
          "role": "恰斯卡",
          "text": "…不过听她的口哨声，似乎还是不太自信。这样的声音…是不会有绒翼龙响应召唤的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "口哨？",
              "dialogues": []
            },
            {
              "text": "召唤？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "嗯，花羽会的人会用口哨、号角来呼唤龙伙伴。科优尔应该也是想召唤一头绒翼龙，再尝试一下飞行吧。"
        },
        {
          "role": "恰斯卡",
          "text": "但绒翼龙们比花羽会的战士还要高傲，像这样缺乏信心的哨声，是无法打动他们的。"
        },
        {
          "role": "恰斯卡",
          "text": "无法通过试炼，又无法召来绒翼龙…这样下去她的信心恐怕会更受打击…那她就真离成为「失翼者」不远了。"
        },
        {
          "role": "派蒙",
          "text": "我、我们能不能想办法帮帮她？"
        },
        {
          "role": "恰斯卡",
          "text": "谢谢你们的好意。科优尔的飞行技巧并不差，但想要重返天空，就必须靠自己跨过心里的坎。"
        },
        {
          "role": "恰斯卡",
          "text": "我先回近处潜伏，免得她真做出什么傻事来。等到这事了结，我再请你们去花羽会好好转转吧。"
        },
        {
          "role": "科优尔",
          "text": "……♪"
        },
        {
          "role": "派蒙",
          "text": "科优尔还是没有放弃啊！虽然恰斯卡说了要靠她自己走出来，但这么下去也不是办法…"
        },
        {
          "role": "派蒙",
          "text": "唔…要是刚巧有一头「绒翼龙」，能飞到她的眼前就好了！至少能帮她恢复信心…"
        },
        {
          "role": "旅行者",
          "text": "（好像也不是没有办法…）"
        },
        {
          "type": "subtitle",
          "text": "魂附为绒翼龙接近科优尔"
        },
        {
          "type": "subtitle",
          "text": "魂附后与科优尔对话"
        },
        {
          "role": "科优尔",
          "text": "是绒…绒翼龙！我…我没在做梦吧！我真的召唤来了！"
        },
        {
          "role": "科优尔",
          "text": "我还以为这辈子都不会再被你们认可了…谢谢！谢谢你…"
        },
        {
          "role": "旅行者",
          "text": "（看起来她的心情已经好多了…接下来再找个时机飞走…）"
        },
        {
          "role": "科优尔",
          "text": "请问——可以现在就陪我做飞行训练吗！"
        },
        {
          "role": "旅行者",
          "text": "（——！！）"
        },
        {
          "role": "科优尔",
          "text": "我有好好反思过！上次失败一定是过弯速度还不够！只要能针对这点勤练「钟摆机动」、「半滚倒转」…"
        },
        {
          "role": "旅行者",
          "text": "（完了…这些动作一个都没听过…随随便便就陪她训练会很危险吧？）"
        },
        {
          "role": "科优尔",
          "text": "——还有「落叶飘」和「蛇形制动」我也想试试！"
        },
        {
          "role": "旅行者",
          "text": "（糟了，连背着人普通飞行都没试过…再不找机会飞走的话…）"
        },
        {
          "role": "？？？",
          "text": "——♪"
        },
        {
          "role": "科优尔",
          "text": "欸？这口哨声…难道还有其他人在呼唤绒翼龙？"
        },
        {
          "role": "旅行者",
          "text": "（——好机会！）"
        },
        {
          "role": "科优尔",
          "text": "啊！等…等等——"
        },
        {
          "type": "subtitle",
          "text": "你借着哨声匆匆飞远…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "回去查看科优尔的情况"
        },
        {
          "role": "派蒙",
          "text": "不知道科优尔现在的心情怎么样了…我们快回桥上看看吧！"
        },
        {
          "type": "subtitle",
          "text": "与恰斯卡和科优尔对话"
        },
        {
          "role": "科优尔",
          "text": "恰斯卡姐姐！我刚刚召唤来绒翼龙了，它们果然还是愿意回应我的！"
        },
        {
          "role": "科优尔",
          "text": "…只可惜附近不知道有谁也在召唤它，我还没来得及骑上去，它就飞走了…"
        },
        {
          "role": "恰斯卡",
          "text": "是吗？还真不凑巧…不过能召来一次，就能有第二次，只要继续坚持，总能通过试炼的。"
        },
        {
          "role": "科优尔",
          "text": "嗯！还好没有轻易放弃。"
        },
        {
          "role": "派蒙",
          "text": "嗨，恰斯卡！科优尔怎么样了？"
        },
        {
          "role": "科优尔",
          "text": "欸？你们是谁…为什么会知道我的名字…"
        },
        {
          "role": "恰斯卡",
          "text": "咳，这两位…是我的朋友，旅行者和派蒙。"
        },
        {
          "role": "恰斯卡",
          "text": "我前几天跟他们聊起过你，说部族里有位很有潜力的后辈…"
        },
        {
          "role": "科优尔",
          "text": "啊！原来您就是那位旅行者？潜、潜力什么的…我差点都要成「失翼者」了，哪有什么潜力…"
        },
        {
          "role": "科优尔",
          "text": "不过话说回来…明明是头一次见面，但总觉得…好像已经在哪见过了？"
        },
        {
          "role": "恰斯卡",
          "text": "嗯…估计是在圣火竞技场之类的地方吧，旅行者最近的足迹遍布纳塔，在哪遇见过都不奇怪。"
        },
        {
          "role": "科优尔",
          "text": "…是这样吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是、是这样吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔帕",
          "text": "——科优尔！恰斯卡！"
        },
        {
          "role": "阿尔帕",
          "text": "我找了你们可久了，原来是在这里。"
        },
        {
          "role": "科优尔",
          "text": "啊，阿尔帕长老！您怎么来了？"
        },
        {
          "role": "阿尔帕",
          "text": "飞行试炼要重新启动了，我是来专程通知你的。"
        },
        {
          "role": "科优尔",
          "text": "重新启动？为什么这么突然…还要您亲自来通知…"
        },
        {
          "role": "阿尔帕",
          "text": "说来惭愧，上次试炼开始前我们没来得及检查场地，试炼中没发挥好的人也很多…"
        },
        {
          "role": "阿尔帕",
          "text": "所以我们事后重新检查了一遍，发现场地里存在不少问题。上次的试炼结果，或多或少也有受到一些影响。"
        },
        {
          "role": "阿尔帕",
          "text": "必须承认，这是我们的失职。虽然称不上弥补…但尽快来通知你们试炼重启的事，也算是我的一点歉意吧。"
        },
        {
          "role": "科优尔",
          "text": "这、这样啊…"
        },
        {
          "role": "阿尔帕",
          "text": "恰斯卡，你身边这两位…是旅行者和派蒙吗？"
        },
        {
          "role": "派蒙",
          "text": "欸？原来你也认识我们…"
        },
        {
          "role": "阿尔帕",
          "text": "情报收集是战士的基本，况且两位在纳塔的声名也不算小了。我一直想请你们来花羽会做一回客。"
        },
        {
          "role": "派蒙",
          "text": "做客？——会有好吃的吗！"
        },
        {
          "role": "阿尔帕",
          "text": "当然会有。花羽会向来崇敬强大的战士，如果能邀请到你们，怎么招待都不为过。"
        },
        {
          "type": "subtitle",
          "text": "完成第五章·第四幕「命定将焚的虹光」"
        },
        {
          "role": "阿尔帕",
          "text": "况且在之前的大战里，如果没有你们，深渊造成的灾害只会更大…我想代表部族，感谢一下两位。"
        },
        {
          "role": "派蒙",
          "text": "「强大的战士」？连我也算上了吗…嘿嘿，你人真好！"
        },
        {
          "role": "阿尔帕",
          "text": "自然要算。仅以「飞行技巧」而论，你的「强大」即使在花羽会里也很难得一见。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要这么说还真是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "旅行者！我觉得花羽会的人都是好人！必须去转转！"
        },
        {
          "type": "subtitle",
          "text": "完成魔神任务：第五章·幕间「万火归一」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "之前匆匆经过的时候…",
              "dialogues": []
            },
            {
              "text": "是没来得及好好看看。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔帕",
          "text": "可惜我现在还得去通知其他人试炼重启的事…事关下一代的未来，片刻也不能怠慢。"
        },
        {
          "role": "科优尔",
          "text": "长老！我也一起去吧，我也希望大家能快点听到这消息。"
        },
        {
          "role": "阿尔帕",
          "text": "嗯…那么恰斯卡，能麻烦你招待一下两位贵客吗？"
        },
        {
          "role": "恰斯卡",
          "text": "当然可以。"
        },
        {
          "role": "阿尔帕",
          "text": "那我们之后就在部族的曜石图腾柱下再见。一起走吧，科优尔。"
        },
        {
          "role": "科优尔",
          "text": "好的！"
        },
        {
          "type": "subtitle",
          "text": "阿尔帕和科优尔乘上绒翼龙，振翅飞远…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "恰斯卡",
          "text": "嗯，她们已经飞得挺远了…那么我就直接问了。"
        },
        {
          "role": "恰斯卡",
          "text": "…刚刚响应科优尔呼唤的绒翼龙——其实是你的安排吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "——！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "我从小就跟绒翼龙在一起生活，看到那头龙飞近的时候，就觉得有些不自然。"
        },
        {
          "role": "恰斯卡",
          "text": "…他的举止和气息，甚至还有一点你的影子？所以我就在猜，是不是你用了什么法子。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你…能看出来吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "那头绒翼龙被科优尔请求骑乘的时候还显得很局促，所以我吹响了口哨，给他制造了一点离开的契机…"
        },
        {
          "role": "恰斯卡",
          "text": "…看你的表情，应该是有帮上忙了？"
        },
        {
          "role": "恰斯卡",
          "text": "放心吧，「强者不应该随便暴露自己的底牌」，所以我不会继续追问，也不会往外说什么没根据的猜测。"
        },
        {
          "role": "恰斯卡",
          "text": "何况是你的话…即使有什么异于常人的能力，我相信也一定只会用于正途。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不过我这算不算欺骗了科优尔…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "科优尔缺的不是技术而是信心，你只是「调停」了她跟自己的「矛盾」而已，不用在意过程。"
        },
        {
          "role": "恰斯卡",
          "text": "你要是不出手，我也会考虑去请我「妈妈」来演一场戏…不过到时候万一被科优尔认出来，这矛盾就更难解了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "总之没好心办坏事就好…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "嗯，接下来你们要是有空，就跟我一块去花羽会转转吧。"
        },
        {
          "type": "subtitle",
          "text": "前往花羽会"
        },
        {
          "type": "subtitle",
          "text": "与恰斯卡对话"
        },
        {
          "role": "柯梯米",
          "text": "——喝！哈！"
        },
        {
          "role": "娅特兰",
          "text": "——嘿呀！"
        },
        {
          "role": "卡帕可",
          "text": "看好了！接招！"
        },
        {
          "role": "派蒙",
          "text": "欸欸？他们这是在…打架吗？要去调解一下吗？"
        },
        {
          "role": "恰斯卡",
          "text": "没事的，他们只是在日常训练而已。"
        },
        {
          "role": "派蒙",
          "text": "训练？连这么小的孩子也要吗？"
        },
        {
          "role": "恰斯卡",
          "text": "花羽会是战士的部族。在古老的过去，曾经承担梭巡援护纳塔全境的职责，是最精锐的特种部队。"
        },
        {
          "role": "恰斯卡",
          "text": "虽然现在的情况也有所变化，不过尚武的习惯还是留了下来。"
        },
        {
          "role": "柯梯米",
          "text": "咦，是恰斯卡回来了？"
        },
        {
          "role": "娅特兰",
          "text": "恰斯卡姐姐！"
        },
        {
          "role": "卡帕可",
          "text": "你能来陪我们训练吗？"
        },
        {
          "role": "恰斯卡",
          "text": "真不凑巧，我还要带旅行者和派蒙到处转转，还是等下次吧。"
        },
        {
          "role": "柯梯米",
          "text": "旅行者…派蒙…啊！是那个传说中的战士…和那个传说中的「飞行高手」吗！"
        },
        {
          "role": "派蒙",
          "text": "传说中的…没错没错！就是我们！"
        },
        {
          "role": "柯梯米",
          "text": "真厉害啊…不靠绒翼龙就能飞起来…就连恰斯卡姐姐也不能只靠自己飞那么久吧？"
        },
        {
          "role": "卡帕可",
          "text": "那个！旅行者哥哥！能指导一下我的剑术吗！"
        },
        {
          "role": "娅特兰",
          "text": "旅行者哥哥！能尝尝我家的「火山蛋糕」吗？"
        },
        {
          "role": "恰斯卡",
          "text": "咳！旅行者是来做客的，一会儿还要去见阿尔帕长老，你们都先克制点。"
        },
        {
          "role": "恰斯卡",
          "text": "柯梯米，与其羡慕别人拥有自己没有的天赋，不如先刻苦锻炼自己的技艺吧？"
        },
        {
          "role": "恰斯卡",
          "text": "卡帕可，在讨论「剑术」之前，先把自己的基础打好，今天挥剑的次数达标了吗？"
        },
        {
          "role": "恰斯卡",
          "text": "还有娅特兰…不要随时随地见缝插针地推荐你们家的商品。"
        },
        {
          "role": "柯梯米&娅特兰&卡帕可",
          "text": "好…"
        },
        {
          "type": "subtitle",
          "text": "在恰斯卡的「劝解」下，孩子们终于不再围着你们吵闹…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "恰斯卡",
          "text": "抱歉，这些孩子一听见你们的名字就激动得过了头，希望你们不要介意。"
        },
        {
          "role": "恰斯卡",
          "text": "这是娅特兰硬塞过来的「火山蛋糕」，说是给你们的赔礼。"
        },
        {
          "role": "派蒙",
          "text": "哇…好香欸！旅行者你也尝尝？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实不错。",
              "dialogues": []
            },
            {
              "text": "味道还行。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "你们喜欢就好，娅特兰知道了也会高兴的。"
        },
        {
          "role": "派蒙",
          "text": "说起来…那些孩子都很亲近你呢！我之前还以为你会更加…嗯…「孤傲」一点？"
        },
        {
          "role": "恰斯卡",
          "text": "「孤傲」？要说的话…确实也有过那么一段时期…差不多是我刚来花羽会的时候吧？"
        },
        {
          "role": "恰斯卡",
          "text": "…但身为「调停人」，可不能孤傲，否则不必动手就能调停的矛盾，也会变成不得不动手的死局…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "把两边都打到愿意和解…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "没错，就是这种——不过只要还有得选，我会尽力避免这种局面。"
        },
        {
          "role": "恰斯卡",
          "text": "曾经有人跟我说过，靠武力达成的和解过不了几天就会瓦解，能用对话、交情解决的话，对各方都好。"
        },
        {
          "role": "恰斯卡",
          "text": "尽管有些时候，各自拥有强大的武力，就是各方愿意好好说话的前提。"
        },
        {
          "role": "派蒙",
          "text": "确、确实…"
        },
        {
          "role": "娅特兰",
          "text": "喂——恰斯卡姐姐！"
        },
        {
          "role": "柯梯米",
          "text": "库斯可叔叔已经听说你回来了！正要过来抓你呢！"
        },
        {
          "role": "恰斯卡",
          "text": "嗯？是吗…谢了。"
        },
        {
          "role": "恰斯卡",
          "text": "旅行者，派蒙，我先走一步，回头在前面的图腾柱下再见吧。那地方很明显，应该不需要我带路。"
        },
        {
          "role": "派蒙",
          "text": "欸欸——你这是想逃…逃…"
        },
        {
          "role": "恰斯卡",
          "text": "——调停一起矛盾最好的方法，就是在它产生之前先一步避开。"
        },
        {
          "role": "卡帕可",
          "text": "不愧是恰斯卡姐姐，连逃跑都那么洒脱！"
        },
        {
          "role": "恰斯卡",
          "text": "详情我会回头再说，麻烦你们帮我应付一下…抱歉了，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "与恰斯卡分头行动"
        },
        {
          "type": "subtitle",
          "text": "与库斯可对话"
        },
        {
          "role": "库斯可",
          "text": "唔…金发的异乡人，白色的飞行物…你们是旅行者和派蒙？"
        },
        {
          "role": "库斯可",
          "text": "听说恰斯卡是跟你们一起回来的，看样子是又被她给逃了啊…"
        },
        {
          "role": "派蒙",
          "text": "呃…请问你是？"
        },
        {
          "role": "库斯可",
          "text": "还能是谁？——我就是她的养父！"
        },
        {
          "role": "库斯可",
          "text": "我们之前约好三个月要检查一次，看看深渊对她的影响有没有加剧…可她今年已经整整爽约三回了啊！三回！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "深渊的影响？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "库斯可",
          "text": "唉…这孩子小时候被深渊力量侵染，成了弃婴。还好有野生的绒翼龙捡到了她悉心照料，这才活了下来。"
        },
        {
          "role": "库斯可",
          "text": "后来她被巡逻的骑士们发现，带回了花羽会…但那时候的她简直就是一头野兽！"
        },
        {
          "role": "库斯可",
          "text": "一不留神就跟人打了起来，还老是跑出部族不见踪影，比起人更愿意亲近龙…不如说就是一头人形的龙！"
        },
        {
          "role": "派蒙",
          "text": "…这就是她说的，比较「孤傲」的时期吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来可不止是「孤傲」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "库斯可",
          "text": "后来我们发现，是被深渊侵染的经历，在她心里埋下了「争斗」的种子，开始试着帮她控制…"
        },
        {
          "role": "库斯可",
          "text": "虽然主要还是靠她自己。现在的她，总算是有个「人」样了。"
        },
        {
          "role": "派蒙",
          "text": "也、也不用担心啦，她现在看起来很稳定呀？应该只是不想让家人操心，才总是躲着体检吧？"
        },
        {
          "role": "库斯可",
          "text": "…这我当然知道。如果深渊的影响加剧，她自己就会警觉，不会这么不当回事。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那不是更不用担心了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "库斯可",
          "text": "但之前每次检查，深渊是没动静了，她自个儿却消停不下来——每次不是添了道伤口，就是多了块淤青！"
        },
        {
          "role": "库斯可",
          "text": "这家伙…一定是又背着我们去做什么危险的事了！所以才老是躲着不检查！"
        },
        {
          "role": "派蒙",
          "text": "原、原来是这样…的确像是她会做的事…"
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务：第五章·第四幕「命定将焚的虹光」"
        },
        {
          "role": "库斯可",
          "text": "唉…恰斯卡是这样，她妹妹也是这样，每天追着姐姐在战线上跑…不知道哪天会出事。"
        },
        {
          "role": "库斯可",
          "text": "你们要是遇见她俩，就帮我多劝几句吧！别管她们爱不爱听。"
        },
        {
          "type": "subtitle",
          "text": "完成魔神任务：第五章·第四幕「命定将焚的虹光」"
        },
        {
          "role": "库斯可",
          "text": "唉…从前这些事，都是葵可在盯着。现在葵可不在了…我不希望恰斯卡哪天也出事。"
        },
        {
          "role": "库斯可",
          "text": "尤其是在葵可离开后，她做事就越来越冒险了…简直就像是想弥补什么…"
        },
        {
          "role": "库斯可",
          "text": "你们要是遇见她，就帮我多劝几句吧，别管她爱不爱听。"
        },
        {
          "role": "库斯可",
          "text": "要是真不想检查也不要紧，但可千万不要再随随便便涉险了！"
        },
        {
          "role": "恰斯卡",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "在这之后，库斯可拉着你们又念了不少恰斯卡与妹妹的旧事…\n你们耐心地听这位有些絮叨的父亲讲到了最后。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "额外对话（库斯可）"
        },
        {
          "role": "库斯可",
          "text": "唉…抱歉了，平时没什么机会跟别人说道她们俩的事，一不留神就拉着你们讲了那么久。"
        },
        {
          "role": "库斯可",
          "text": "我也该回去处理工作了，恰斯卡她…就麻烦你们帮我说两句了。"
        },
        {
          "type": "subtitle",
          "text": "前往曜石图腾柱"
        },
        {
          "role": "派蒙",
          "text": "不知不觉过了好久呢…该去找恰斯卡了吧？记得是在北边的图腾柱那儿？"
        },
        {
          "type": "subtitle",
          "text": "与阿尔帕对话"
        },
        {
          "role": "派蒙",
          "text": "嘿，恰斯卡！阿尔帕！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "让你们久等了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "没事，是我老爹拉着你们念叨了吧，他都说了什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你小时候三天离家出走一次的事…",
              "dialogues": []
            },
            {
              "text": "同龄人每三个就有一个被你打过的事…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "嗯…那时候我是有点冲动了。"
        },
        {
          "role": "派蒙",
          "text": "只是有点吗！"
        },
        {
          "role": "阿尔帕",
          "text": "哈哈…现在回想起来，带你回花羽会、交给库斯可一家抚养…都还像是昨天一样。"
        },
        {
          "role": "阿尔帕",
          "text": "…谁都想不到，那个野孩子能长成花羽会最强的战士吧。"
        },
        {
          "role": "派蒙",
          "text": "欸？当初是你带回恰斯卡的吗？"
        },
        {
          "role": "恰斯卡",
          "text": "阿尔帕长老那时就已经是老练的绒翼龙骑士了，是她在空中巡逻的时候发现了我，又找到了我的绒翼龙「妈妈」。"
        },
        {
          "role": "恰斯卡",
          "text": "「妈妈」那时也觉得我应该试着回归人类的社会…可惜小时候不懂事，前前后后跟大家闹过不少矛盾。"
        },
        {
          "role": "阿尔帕",
          "text": "不过现在，你已经是全纳塔最懂调停矛盾的人了…时间过得可真快啊。"
        },
        {
          "role": "阿尔帕",
          "text": "等到哪天我彻底飞不动了，花羽会和飞行队，就要靠你看着了。"
        },
        {
          "role": "恰斯卡",
          "text": "我的性格你也知道，比起指挥调度，还是独自飞在最前头比较适合我。"
        },
        {
          "role": "恰斯卡",
          "text": "…所以还是请长老你再多坚持几年，等科优尔她们成长起来吧。"
        },
        {
          "role": "阿尔帕",
          "text": "你呀，真是…"
        },
        {
          "role": "派蒙",
          "text": "欸…你们部族难道不是那种，「谁强谁来当老大！」的风格吗？"
        },
        {
          "role": "恰斯卡",
          "text": "花羽会确实信奉「强大」，但「强大」的定义绝不止是武力。"
        },
        {
          "role": "阿尔帕",
          "text": "呵呵，要是论单打独斗，别说全是精英的飞行队了，花羽会里随便找一个战士，都能轻松打败我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还以为你是武斗派的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔帕",
          "text": "让你失望了吗？我从前也是个尚武的战士，可惜少不更事，为了证明自己，跑去「烬城」奥奇卡纳塔冒险…"
        },
        {
          "role": "阿尔帕",
          "text": "结果不但颗粒无收，还受了不小的伤。虽然捡回一条命，但从此跟「强大」这两个字就无缘了。"
        },
        {
          "role": "恰斯卡",
          "text": "就算身负暗伤，也还是凭经验跟意志成为了统领飞行队的长老——这不也是「强大」的表现吗？"
        },
        {
          "role": "阿尔帕",
          "text": "哈…先不提这些了。旅行者、派蒙，我准备了一桌薄酒，还请不要客气。"
        },
        {
          "role": "派蒙",
          "text": "好耶，就等你这句话了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刚刚不是才吃过「火山蛋糕」吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿——点心是装在另一个胃里的！"
        },
        {
          "role": "派蒙",
          "text": "呼…好饱好饱…"
        },
        {
          "role": "阿尔帕",
          "text": "喜欢的话，两位可以在花羽会里多留一会儿…"
        },
        {
          "role": "瓦尔米",
          "text": "阿…阿尔帕长老！有…有要紧事！"
        },
        {
          "role": "阿尔帕",
          "text": "…嗯？"
        },
        {
          "role": "恰斯卡",
          "text": "怎么了？有什么情况，需要我去处理吗？"
        },
        {
          "role": "阿尔帕",
          "text": "唔…是部族外的一支商队，说要来跟我们谈一项合作。"
        },
        {
          "role": "阿尔帕",
          "text": "怎么偏偏在这个时候…部族里还有几位「失翼者」没通知到，飞行试炼的场地也没检查…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好紧凑的日程…",
              "dialogues": []
            },
            {
              "text": "这就是长老吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "这些部族内的事务，就交给我去处理吧，上了年纪，就不要太折腾自己了。"
        },
        {
          "role": "派蒙",
          "text": "那我们也跟恰斯卡一起去帮忙吧！毕竟吃了人家这么多好东西…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就当饭后消消食。",
              "dialogues": []
            },
            {
              "text": "无功不受禄。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿尔帕",
          "text": "呵，那就多谢各位了。剩下几位「失翼者」恰斯卡都认识…皮希加现在是「游靶气球」的管理人…"
        },
        {
          "role": "阿尔帕",
          "text": "瓦斯卡尔多半还在沉迷「目随羽视」，朱南一直在飞行平台上眺望烬城…我就把他们，都托付给你们了。"
        },
        {
          "type": "subtitle",
          "text": "与失翼者们对话（3/3）"
        },
        {
          "role": "穆托塔",
          "text": "…皮希加，你真的不打算再考虑一下吗？"
        },
        {
          "role": "皮希加",
          "text": "谢啦，老大。不过我感觉，现在的日子也没什么不好…"
        },
        {
          "role": "恰斯卡",
          "text": "皮希加，飞行试炼要重启了…嗯？穆托塔你也在？"
        },
        {
          "role": "穆托塔",
          "text": "啊，是阿尔帕让你们来的吗？我正在跟皮希加谈这件事呢。"
        },
        {
          "role": "穆托塔",
          "text": "部族现在的情况你也知道…像你这样有经验的战士，不该一直待在这里。"
        },
        {
          "role": "皮希加",
          "text": "老大，你说的那都是多少年前的事了？我成为「失翼者」都已经那么久，从前的身手早就已经生疏了。"
        },
        {
          "role": "皮希加",
          "text": "如果部族有需要，我一定会出一份力，但再参加飞行试炼…实在是没必要了。"
        },
        {
          "role": "皮希加",
          "text": "这么多年来我也看开了，不是每个人都有阿尔帕长老的毅力…能摆脱「失翼者」的身份重返天空。"
        },
        {
          "role": "皮希加",
          "text": "但我也没必要成为那么伟大的人吧，就算没有绒翼龙的认可，我也能靠热气球飞起来…"
        },
        {
          "role": "皮希加",
          "text": "每天折腾折腾我的热气球，看看乘客们的反应和表情…就已经很充实了。"
        },
        {
          "role": "恰斯卡",
          "text": "能找到一件自己喜欢的事，不比通过飞行试炼容易。这不是坏事。"
        },
        {
          "role": "穆托塔",
          "text": "唉，好吧…那我也不强求你了。"
        },
        {
          "role": "皮希加",
          "text": "啊，对了，你们要是有空的话，可以来坐坐这儿的热气球哦。只要在天上飞一圈，你们肯定就会理解我啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有事情…",
              "dialogues": []
            },
            {
              "text": "下次一定。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "皮希加",
          "text": "没事，要想试试的话，随时可以来找我！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（穆托塔）"
        },
        {
          "role": "穆托塔",
          "text": "没想到会是恰斯卡来通知…阿尔帕这家伙，总算知道分点工作出去了啊。"
        },
        {
          "role": "瓦斯卡尔",
          "text": "飞行试炼？事到如今还有什么意义…不管再来多少次，绒翼龙都不会认可我这种玩物丧志的人吧？哈哈…"
        },
        {
          "role": "恰斯卡",
          "text": "瓦斯卡尔，绒翼龙是不会因为这点事拒绝你的。"
        },
        {
          "role": "瓦斯卡尔",
          "text": "那就是因为别的事拒绝我咯？没有斗志、没有天赋…不是每个人都像你一样，生来就是这块料。"
        },
        {
          "role": "瓦斯卡尔",
          "text": "你们也不用在我这浪费时间了，去找那些还没认清现实的家伙吧。"
        },
        {
          "role": "瓦斯卡尔",
          "text": "至于我…呵，有那时间，还不如再多玩几把「目随羽视」呢！"
        },
        {
          "role": "派蒙",
          "text": "「失翼者」里也会有这种人呀…"
        },
        {
          "role": "恰斯卡",
          "text": "他曾经也是燃烧着斗志的战士，但光有斗志…是没办法让绒翼龙认可的。"
        },
        {
          "role": "派蒙",
          "text": "绒翼龙们都这么严格的吗？我看「游靶气球」和「目随羽视」里也有不少看起来很随便的龙啊？"
        },
        {
          "role": "恰斯卡",
          "text": "跟人游乐是一码事，背负着他人的性命飞向天空，就是另一码事了。"
        },
        {
          "role": "恰斯卡",
          "text": "让实力未济的人上背，有危险的不只是人，就连绒翼龙也会因为骑手的失误落入险境。"
        },
        {
          "role": "恰斯卡",
          "text": "所以即便知道会伤到「失翼者」的心，但该拒绝的时候，还是必须拒绝…这是我们跟绒翼龙的共识。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（瓦斯卡尔）"
        },
        {
          "role": "瓦斯卡尔",
          "text": "啧…下一把！下一把一定能中！"
        },
        {
          "role": "朱南",
          "text": "唉…"
        },
        {
          "role": "恰斯卡",
          "text": "朱南，又在看奥奇卡纳塔吗？"
        },
        {
          "role": "朱南",
          "text": "…恰斯卡？你们找我有什么事吗？"
        },
        {
          "role": "恰斯卡",
          "text": "飞行试炼要重新召开了。要再去试试吗？"
        },
        {
          "role": "朱南",
          "text": "你好像忘了「失翼者」的定义？我们就是失败过太多次，已经放弃了重试，才会被叫做「失翼者」。"
        },
        {
          "role": "朱南",
          "text": "虽然阿尔帕长老每次都会不厌其烦地来通知…但又能有什么改变呢？该考不过的还是考不过。"
        },
        {
          "role": "恰斯卡",
          "text": "这次的场地会进行大修，飞起来应该会比过去更加顺畅——科优尔也打算再试一次。"
        },
        {
          "role": "朱南",
          "text": "……！"
        },
        {
          "role": "朱南",
          "text": "不…还是算了。真正有资格加入飞行队的人，是不会被这点区别影响的…"
        },
        {
          "role": "朱南",
          "text": "无论在什么地方都能飞得得心应手…就像你跟阿尔帕长老一样。"
        },
        {
          "role": "科优尔",
          "text": "——朱南！飞行试炼…欸，恰斯卡、旅行者？你们已经在了啊。"
        },
        {
          "role": "科优尔",
          "text": "那朱南你应该也知道试炼重启的事了？快跟我一起去训练吧！"
        },
        {
          "role": "朱南",
          "text": "这…我没打算参加…"
        },
        {
          "role": "科优尔",
          "text": "为什么？你不是一直拿阿尔帕长老当偶像吗？"
        },
        {
          "role": "科优尔",
          "text": "她当初负伤成为「失翼者」，还外出漂泊了好多年…最后不也是振作起来了吗？"
        },
        {
          "role": "朱南",
          "text": "我…我没有她那样的毅力…况且再试一次的话，说不定就又得在她面前失败一次…"
        },
        {
          "role": "科优尔",
          "text": "唉，你怎么还在纠结这种事——那你就当做是来指导我的吧，怎么样？"
        },
        {
          "role": "朱南",
          "text": "这…我…"
        },
        {
          "role": "科优尔",
          "text": "别这个那个的了，有什么事——都等飞起来再说吧！"
        },
        {
          "role": "朱南",
          "text": "我…等等！你跑慢点！我跟不上了！"
        },
        {
          "role": "派蒙",
          "text": "…居然还能这么鼓舞人的啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "被强行振作了啊。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "恰斯卡",
          "text": "呵，她们俩从小就是好朋友。要调解朱南心里的矛盾，科优尔是最好的人选。"
        },
        {
          "role": "恰斯卡",
          "text": "被你帮助过的科优尔，转头去鼓舞了其他人…我常听人说冲突和矛盾会一环接一环地出现。"
        },
        {
          "role": "恰斯卡",
          "text": "但有些时候，情况也会反过来呢。"
        }
      ],
