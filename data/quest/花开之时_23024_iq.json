  "stories": [
    {
      "story_id": 23024,
      "title": "花开之时",
      "description": "瓦尔坦与古尔根的须弥蔷薇似乎快要绽放了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与瓦尔坦和古尔根对话"
        },
        {
          "role": "瓦尔坦",
          "text": "二位，你们终于来了。"
        },
        {
          "role": "古尔根",
          "text": "时间正好，万事齐全了！"
        },
        {
          "role": "旅行者",
          "text": "为什么这么兴奋？"
        },
        {
          "role": "派蒙",
          "text": "难道说，之前的蔷薇要开花了？"
        },
        {
          "role": "瓦尔坦",
          "text": "没错，哈哈哈！这都是多亏了你帮忙啊，旅行者。"
        },
        {
          "role": "古尔根",
          "text": "虽然这株蔷薇还没有盛开，但根据整个植株的形态可以判断，它的生命力极其旺盛！"
        },
        {
          "role": "瓦尔坦",
          "text": "旅行者，如果你有兴趣的话，就来近距离观察一下吧。"
        },
        {
          "role": "瓦尔坦",
          "text": "哈哈哈，说不定，它会在你们面前盛开呢。"
        },
        {
          "role": "旅行者",
          "text": "那我可要好好看看…"
        },
        {
          "role": "派蒙",
          "text": "真，真的吗？在这么短的时间里开花？"
        },
        {
          "role": "派蒙",
          "text": "好期待！"
        },
        {
          "type": "subtitle",
          "text": "与瓦尔坦和古尔根对话"
        },
        {
          "role": "古尔根",
          "text": "两位，请俯身贴近点看吧，这样就能把所有细节看得一清二楚。"
        },
        {
          "role": "？？？",
          "text": "和两位药农一同细致观察了尚未盛开的蔷薇…"
        },
        {
          "role": "派蒙",
          "text": "没有动静啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看不出什么迹象…",
              "dialogues": []
            },
            {
              "text": "腿都站麻了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "古尔根",
          "text": "哎呀…也许是这株蔷薇有些不好意思在你们面前盛开吧…"
        },
        {
          "role": "瓦尔坦",
          "text": "不过，根据蔷薇的生长规律，最迟明天，肯定会开花的。"
        },
        {
          "role": "瓦尔坦",
          "text": "旅行者，请你明天再过来吧！"
        },
        {
          "type": "subtitle",
          "text": "与瓦尔坦和古尔根对话"
        },
        {
          "role": "古尔根",
          "text": "两位，请俯身贴近点看吧，这样就能把所有细节看得一清二楚。"
        },
        {
          "role": "？？？",
          "text": "和两位药农一同细致观察了尚未盛开的蔷薇…"
        },
        {
          "role": "派蒙",
          "text": "没有动静啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看不出什么迹象…",
              "dialogues": []
            },
            {
              "text": "腿都站麻了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "古尔根",
          "text": "哎呀…也许是这株蔷薇有些不好意思在你们面前盛开吧…"
        },
        {
          "role": "瓦尔坦",
          "text": "不过，根据蔷薇的生长规律，最迟明天，肯定会开花的。"
        },
        {
          "role": "瓦尔坦",
          "text": "旅行者，请你明天再过来吧！"
        },
        {
          "type": "subtitle",
          "text": "等待到第二天（6点到8点）"
        },
        {
          "type": "subtitle",
          "text": "与瓦尔坦和古尔根对话"
        },
        {
          "role": "瓦尔坦",
          "text": "旅行者，你们来得正好，这株蔷薇总算盛开了！"
        },
        {
          "role": "古尔根",
          "text": "多亏了你的帮忙，这简直是我见过长势最好的蔷薇了。"
        },
        {
          "role": "瓦尔坦",
          "text": "实在太感谢你们了，还请你收下这点谢礼！"
        },
        {
          "role": "旅行者",
          "text": "可喜可贺！"
        },
        {
          "role": "派蒙",
          "text": "蔷薇开花了，我们也很开心哦！"
        },
        {
          "role": "瓦尔坦",
          "text": "呼…这下子总算可以按时向「健康之家」那边交货了。"
        },
        {
          "role": "瓦尔坦",
          "text": "希望这株蔷薇能帮上他们的忙…"
        },
        {
          "type": "subtitle",
          "text": "等待到第二天（6点到8点）"
        },
        {
          "type": "subtitle",
          "text": "与瓦尔坦和古尔根对话"
        },
        {
          "role": "瓦尔坦",
          "text": "旅行者，你来得正好，蔷薇终于盛开了！"
        },
        {
          "role": "瓦尔坦",
          "text": "多亏了你的帮忙，这简直是我见过长势最好的蔷薇了。"
        },
        {
          "role": "古尔根",
          "text": "「健康之家」的医生们应该也会惊叹吧！"
        },
        {
          "role": "瓦尔坦",
          "text": "事不宜迟，我这就去把这株花给移出来…"
        },
        {
          "role": "古尔根",
          "text": "等等，这是…什么动静？"
        },
        {
          "role": "？？？",
          "text": "花田中爆发出了异样的躁动…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！是骗骗花！怎么会出现在这里？！"
        },
        {
          "role": "古尔根",
          "text": "糟了！花田！它要把花田毁掉了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来解决它！",
              "dialogues": []
            },
            {
              "text": "你们都退开！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸…欸？那只骗骗花…怎么逃跑了？"
        },
        {
          "role": "古尔根",
          "text": "怎么会…怎么会这样！"
        },
        {
          "role": "古尔根",
          "text": "我们的蔷薇，最重要的草药…居然变成魔物逃走了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "并不是「变成」…",
              "dialogues": []
            },
            {
              "text": "也许一开始就…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瓦尔坦",
          "text": "你的意思是…这株蔷薇之所以生长缓慢，就是因为这只骗骗花在捣乱？"
        },
        {
          "role": "古尔根",
          "text": "这么一说！完全没有作用的肥料…两倍的浇水量…"
        },
        {
          "role": "古尔根",
          "text": "我，我们原来一直在照顾这只骗骗花吗？！"
        },
        {
          "role": "瓦尔坦",
          "text": "可恶…它到底是怎么混进花里面的，完全没发现啊！"
        },
        {
          "role": "旅行者",
          "text": "我们有时也会被骗。"
        },
        {
          "role": "瓦尔坦",
          "text": "唉，这次可真的糟糕了，周围的药田也全都被糟蹋了…"
        },
        {
          "role": "古尔根",
          "text": "只能去向「健康之家」的医生们说明情况，然后尽快再种一批了啊…"
        }
      ]
    }
  ]
}