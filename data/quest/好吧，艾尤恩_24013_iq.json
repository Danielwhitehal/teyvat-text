{
  "quest_id": 24013,
  "chapter_num": null,
  "chapter_title": "好吧，艾尤恩",
  "type": "iq",
  "route": "Alright, Iaune, Alright",
  "stories": [
    {
      "story_id": 24013,
      "title": "好吧，艾尤恩",
      "description": "艾尤恩正在咖啡店里唉声叹气…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与艾尤恩对话"
        },
        {
          "role": "艾尤恩",
          "text": "唉，我真是想不通，为什么会这样…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "艾尤恩？",
              "dialogues": []
            },
            {
              "text": "今天你休息吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾尤恩",
          "text": "旅行者，真高兴见到你。你是来喝咖啡的吗？让我来请你一杯吧。"
        },
        {
          "role": "派蒙",
          "text": "你怎么啦？看起来脸色好难看，是又被谁逼着熬夜了吗？"
        },
        {
          "role": "艾尤恩",
          "text": "谢谢关心。这次是我自己的问题。"
        },
        {
          "role": "艾尤恩",
          "text": "我最近正在思考…我工作的意义究竟是什么。"
        },
        {
          "role": "艾尤恩",
          "text": "我一直认为复律庭是一个公正，高效，人人都愿意互帮互助的强力机构。"
        },
        {
          "role": "艾尤恩",
          "text": "在复律庭的管理下，整个枫丹廷都会朝着更好的方向发展。"
        },
        {
          "role": "艾尤恩",
          "text": "但现在看来，它就像是一个破破烂烂的机关屋子。齿轮，杠杆，旋臂乱七八糟地耷拉着…只有外壳却一直保持光鲜亮丽。"
        },
        {
          "role": "艾尤恩",
          "text": "它之所以能运转起来，只是因为一系列的巧合与教训，而不是精密地思考和设计。"
        },
        {
          "role": "艾尤恩",
          "text": "我…我想做些什么，但根本无从下手。我怕只要做错了一件事，就会让这间机关屋子整个垮塌掉。"
        },
        {
          "role": "艾尤恩",
          "text": "虽然洛耶茨先生时常和我说，让我放宽心，就算我再怎么犯错，状况也不可能比现在更糟…"
        },
        {
          "role": "派蒙",
          "text": "这，这算是安慰吗…"
        },
        {
          "role": "艾尤恩",
          "text": "唉，抱歉，我不该和你抱怨这些。我今天之所以出来散心，主要原因也是想暂时逃避这些事…"
        },
        {
          "role": "旅行者",
          "text": "我来给你调杯咖啡吧。"
        },
        {
          "role": "艾尤恩",
          "text": "真的？你会调咖啡吗？真是太厉害了，我之前也想学，但总是没时间。"
        },
        {
          "role": "艾尤恩",
          "text": "那就拜托你了，我会在这里等着的…希望工作别在咖啡厅里追上我。"
        },
        {
          "type": "subtitle",
          "text": "与阿鲁埃对话"
        },
        {
          "role": "阿鲁埃",
          "text": "旅行者，你是来店里帮忙的吗？非常欢迎！"
        },
        {
          "role": "派蒙",
          "text": "不是啦，我们只是想给一个朋友调一杯咖啡，他现在好像…嗯…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他现在有点难过。",
              "dialogues": []
            },
            {
              "text": "他现在压力很大。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿鲁埃",
          "text": "你们说的那个朋友。是坐在那边的艾尤恩吗？"
        },
        {
          "role": "旅行者",
          "text": "你认识他？"
        },
        {
          "role": "阿鲁埃",
          "text": "我和洛耶茨是老朋友了。他和我提起过，说他们办公室里来了一位聪明又勤恳的小伙子，就是艾尤恩。"
        },
        {
          "role": "阿鲁埃",
          "text": "不用担心他。刚刚去复律庭里工作的年轻人，总是会沮丧一段时间的。"
        },
        {
          "role": "阿鲁埃",
          "text": "等他们找到一个只属于自己的位置后，心情就会放松下来了。"
        },
        {
          "role": "派蒙",
          "text": "老板，你怎么这么有经验呀？"
        },
        {
          "role": "阿鲁埃",
          "text": "因为我也曾经是复律庭里占着坑的一个萝卜。"
        },
        {
          "role": "阿鲁埃",
          "text": "但我不满意自己只做个萝卜，就离开了我的坑，然后…来开了这家咖啡厅。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来发生了很多事…",
              "dialogues": []
            },
            {
              "text": "总感觉里面有很多故事…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿鲁埃",
          "text": "哈哈哈，也许吧。但现在我只不过是个咖啡厅的老板罢了。"
        },
        {
          "role": "阿鲁埃",
          "text": "好了，你们不是还要给艾尤恩做一杯咖啡吗？我去调试一下仪器，你们准备好了就来找我吧。"
        },
        {
          "type": "subtitle",
          "text": "与阿鲁埃对话"
        },
        {
          "role": "旅行者",
          "text": "准备好了。"
        },
        {
          "role": "阿鲁埃",
          "text": "需要用的材料我都帮你准备好了，就放在那边，快点开始调制吧。"
        },
        {
          "type": "subtitle",
          "text": "为艾尤恩调制咖啡"
        },
        {
          "role": "派蒙",
          "text": "唔…这次要用什么材料来调制咖啡呢？"
        },
        {
          "type": "subtitle",
          "text": "为艾尤恩调制咖啡"
        },
        {
          "role": "派蒙",
          "text": "听起来不错呢，那就开始调制吧。"
        },
        {
          "role": "？？？",
          "text": "开始调制咖啡…"
        },
        {
          "role": "派蒙",
          "text": "唔…闻起来就很香！快把这杯咖啡端给艾尤恩，让他打起精神来吧！"
        },
        {
          "type": "subtitle",
          "text": "将咖啡带给艾尤恩"
        },
        {
          "role": "艾尤恩",
          "text": "旅行者，你…你还真给我调了杯咖啡吗？这怎么好意思，太麻烦你了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用客气。",
              "dialogues": []
            },
            {
              "text": "赶紧喝了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾尤恩",
          "text": "…这咖啡！比复律庭里供应的那些咖啡好喝多了！不…不如说根本就不是一个层次的咖啡。"
        },
        {
          "role": "艾尤恩",
          "text": "要是能天天喝到这种咖啡，我也不会每天下午都昏昏欲睡了。"
        },
        {
          "role": "艾尤恩",
          "text": "谢谢你的咖啡，喝完这杯之后，我又得去工作了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要加油。",
              "dialogues": []
            },
            {
              "text": "打起精神来。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾尤恩",
          "text": "那当然了。我必须得快点成长，早日成为洛耶茨先生那样能独当一面的人才行。"
        },
        {
          "role": "艾尤恩",
          "text": "唉，但在那之前，我还得做多少噩梦呢…"
        }
      ]
    }
  ]
}