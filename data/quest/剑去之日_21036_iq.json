  "stories": [
    {
      "story_id": 21036,
      "title": "剑去之日",
      "description": "古华派弟子孙宇，正在努力锻炼着…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与孙宇对话"
        },
        {
          "role": "孙宇",
          "text": "旅行者，我们又见面了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还在锻炼吗？",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "是的，只不过…实在是有些辛苦。也不知道我是真的实力不济，还是用错了锻炼方法…"
                }
              ]
            },
            {
              "text": "你师妹还不理你？",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "咳…师妹她…最近总是说城里有事要处理，一直也没回来过…"
                },
                {
                  "role": "孙宇",
                  "text": "我去找她说过几次，但她都只是让芷若出来挡住我，始终也不肯见我。"
                },
                {
                  "role": "孙宇",
                  "text": "唉，我也不知道怎么劝好她…"
                }
              ]
            }
          ]
        },
        {
          "role": "孙宇",
          "text": "先不说这些了。上次和你同行时，你的招式和动作都给了我很大启发。"
        },
        {
          "role": "孙宇",
          "text": "旅行者，请你今天再陪我出去锻炼一次吧。"
        },
        {
          "role": "孙宇",
          "text": "还是和上次一样，「对抗敌人」和「越野训练」两项，你方便陪我进行哪项锻炼？"
        },
        {
          "role": "旅行者",
          "text": "对抗敌人。"
        },
        {
          "role": "孙宇",
          "text": "好！我早就想要把我学习的剑术用在实处了…"
        },
        {
          "role": "旅行者",
          "text": "只怕你看不清我的动作。"
        },
        {
          "role": "孙宇",
          "text": "这…阁下武艺竟如此高强？哈哈哈，那就只能请阁下把动作稍稍放慢些啦。"
        },
        {
          "role": "孙宇",
          "text": "我看看…附近就有一处魔物的聚集地，咱们就先去那里好了。"
        },
        {
          "role": "旅行者",
          "text": "越野训练。"
        },
        {
          "role": "孙宇",
          "text": "那就太好了，那位冒险家帮我规划了一条越野路线…唉，我能进来这里锻炼，也是托了她的福。"
        },
        {
          "role": "孙宇",
          "text": "她说我只要尽快到达终点就好…但我每次用的时间都实在太长…"
        },
        {
          "role": "孙宇",
          "text": "所以，我想拜托你为我示范一下如何快速「越野」，我会在后面努力跟上的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "你可别被我甩远了。",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "咳…我…我努力跟上，但说实话，我的脚力实在是有限啊…"
                }
              ]
            }
          ]
        },
        {
          "role": "孙宇",
          "text": "那就拜托你了，我们先去训练地点吧。"
        },
        {
          "role": "旅行者",
          "text": "越野训练。"
        },
        {
          "role": "孙宇",
          "text": "那就太好了，我们还是按照之前的那条越野路线锻炼吧。"
        },
        {
          "role": "孙宇",
          "text": "那位冒险家说，我只要尽快到达终点就好…但我每次用的时间都实在太长…"
        },
        {
          "role": "孙宇",
          "text": "所以，我想拜托你为我示范一下如何快速「越野」，我会在后面努力跟上的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "你可别被我甩远了。",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "咳…我…我努力跟上，但说实话，我的脚力实在是有限啊…"
                }
              ]
            }
          ]
        },
        {
          "role": "孙宇",
          "text": "那就拜托你了，我们先去训练地点吧。"
        },
        {
          "role": "孙宇",
          "text": "旅行者，我们又见面了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还在锻炼吗？",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "是的，只不过…实在是有些辛苦。也不知道我是真的实力不济，还是用错了锻炼方法…"
                },
                {
                  "role": "孙宇",
                  "text": "先不说这些了。上次和你同行时，你的招式和动作都给了我很大启发。"
                },
                {
                  "role": "孙宇",
                  "text": "旅行者，请你今天再陪我出去锻炼一次吧。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你之前在这里锻炼过？",
                      "dialogues": []
                    },
                    {
                      "text": "你居然能到这里锻炼…",
                      "dialogues": [
                        {
                          "role": "孙宇",
                          "text": "唉，说来惭愧。我听说此处地势颇险，魔物众多，觉得很适合作为锻炼的场所。但没想到，这里却不是那么容易进来…"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "孙宇",
                  "text": "还好我偶然遇见了一位好心的冒险家，她愿意帮我一把，以「一同执行协会委托」为理由把我带进这里。"
                },
                {
                  "role": "孙宇",
                  "text": "她还帮我规划锻炼计划，给我各种建议…但同时，我也得和她一起处理各种冒险家协会的委托。"
                }
              ]
            },
            {
              "text": "你师妹还不理你？",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "咳…师妹她…最近总是说城里有事要处理，一直也没回来过…"
                },
                {
                  "role": "孙宇",
                  "text": "我去找她说过几次，但她都只是让芷若出来挡住我，始终也不肯见我。"
                },
                {
                  "role": "孙宇",
                  "text": "唉，我也不知道怎么劝好她…"
                }
              ]
            }
          ]
        },
        {
          "role": "孙宇",
          "text": "咳，我们还是先说正事吧，旅行者。"
        },
        {
          "role": "孙宇",
          "text": "是这样，我初步给自己拟定了一个训练的计划，其中包括了「对抗敌人」和「越野训练」两项。"
        },
        {
          "role": "孙宇",
          "text": "旅行者，你看你方便陪我进行哪一项训练？"
        },
        {
          "type": "subtitle",
          "text": "打倒所有敌人"
        },
        {
          "type": "subtitle",
          "text": "开始「锻炼」"
        },
        {
          "type": "subtitle",
          "text": "在限时时间内抵达终点"
        },
        {
          "type": "subtitle",
          "text": "与孙宇对话"
        },
        {
          "role": "孙宇",
          "text": "呼…呼…真是难以对付…"
        },
        {
          "role": "孙宇",
          "text": "抱歉，让你见笑了。看来我还是没多少长进…"
        },
        {
          "role": "孙宇",
          "text": "我还是需要多多锻炼…多谢了旅行者，这些报酬给你，请收下吧。"
        },
        {
          "role": "旅行者",
          "text": "你要怎么离开璃月？"
        },
        {
          "role": "孙宇",
          "text": "唔…我现在打算的是，搭那位客商的船，从水路向外旅行。"
        },
        {
          "role": "孙宇",
          "text": "第一站…我想先去枫丹看看，然后在那里待一段时间，之后再做打算。"
        },
        {
          "role": "孙宇",
          "text": "唉，也不知道我能不能说服师妹和我同行…"
        },
        {
          "role": "孙宇",
          "text": "呼…呼…真是难以对付…"
        },
        {
          "role": "孙宇",
          "text": "抱歉，让你见笑了。没想到正式对敌时，我会这么紧张…"
        },
        {
          "role": "孙宇",
          "text": "总之我…我还是需要多多锻炼。多谢了旅行者，这些报酬给你，请收下吧。"
        },
        {
          "role": "旅行者",
          "text": "你真的要离开璃月？"
        },
        {
          "role": "孙宇",
          "text": "我还没有完全想好，我还得再想想，顺便…再尝试说服一下师妹。"
        },
        {
          "type": "subtitle",
          "text": "与孙宇对话"
        },
        {
          "role": "孙宇",
          "text": "呼…呼…呼…你怎么…怎么能跑得这么快…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是你跑得太慢了。",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "甘拜下风…甘拜下风…"
                }
              ]
            },
            {
              "text": "你还得多多锻炼啊。",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "你说得…说得对…"
                }
              ]
            }
          ]
        },
        {
          "role": "孙宇",
          "text": "谢谢你给我做示范，旅行者，这些报酬请你收下吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于小雀儿…",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "师妹她…唉，依然不肯理我。我，我也不知怎么劝她…"
                },
                {
                  "role": "孙宇",
                  "text": "唉…此事，怎么会如此难以两全…"
                }
              ]
            },
            {
              "text": "关于那位冒险家…",
              "dialogues": [
                {
                  "role": "孙宇",
                  "text": "她？呃…我是在冒险家协会遇见她的。"
                },
                {
                  "role": "孙宇",
                  "text": "她说自己接受了协会的委托，来层岩巨渊这里办事，听说我想进来，就把我顺便带上了。"
                },
                {
                  "role": "孙宇",
                  "text": "不过作为交换…我得帮她一起执行委托，不过大部分都是寻物的委托，倒也不繁重。"
                },
                {
                  "role": "孙宇",
                  "text": "只是她…实在太爱说话了，我实在是不擅应付啊…"
                }
              ]
            }
          ]
        },
        {
          "role": "孙宇",
          "text": "呼…呼…呼…你怎么…怎么能跑得这么快…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是你跑得太慢了。",
