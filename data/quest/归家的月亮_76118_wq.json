{
  "quest_id": 76118,
  "chapter_num": null,
  "chapter_title": "归家的月亮",
  "type": "wq",
  "route": "The Homebound Moon",
  "stories": [
    {
      "story_id": 76118,
      "title": "归家的月亮",
      "description": "在「银月之庭」，哥伦比娅似乎遇到了一些困难…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同哥伦比娅见面"
        },
        {
          "role": "哥伦比娅",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "你有没有闻到一股好香的味道…"
        },
        {
          "role": "哥伦比娅",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅一个人在胡吃海喝！"
        },
        {
          "role": "哥伦比娅",
          "text": "旅行者，派蒙…"
        },
        {
          "role": "派蒙",
          "text": "她吃得好开心…"
        },
        {
          "role": "哥伦比娅",
          "text": "你们要不要也尝一点？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你吃你吃。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "难得看到你在这里吃东西的样子，是你特意从外面买回来的吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "是菈乌玛送来的。"
        },
        {
          "role": "派蒙",
          "text": "噢！她还是很照顾你的嘛！"
        },
        {
          "role": "哥伦比娅",
          "text": "前提是我不能离开这里。"
        },
        {
          "role": "派蒙",
          "text": "这是软禁吧？！你就被这些东西收买了吗？！"
        },
        {
          "role": "哥伦比娅",
          "text": "她还带了些有趣的书本、精巧的玩具…"
        },
        {
          "role": "派蒙",
          "text": "简直像出差的妈妈和留守家中的孩子…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "菈乌玛解释原因了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "她让我最近都别出门，尤其不要去霜月之子那边。"
        },
        {
          "role": "哥伦比娅",
          "text": "我问了来送餐的小动物们，但它们也受到了菈乌玛的指示，每一只都保持着沉默。"
        },
        {
          "role": "派蒙",
          "text": "这…"
        },
        {
          "role": "哥伦比娅",
          "text": "我猜她可能是在准备什么吧，和我有关的。"
        },
        {
          "role": "哥伦比娅",
          "text": "放心吧，我原本也不觉得待在这里有什么无聊的。饭菜好吃，合我胃口，不出门也挺好。"
        },
        {
          "role": "哥伦比娅",
          "text": "况且，如果是霜月之子的大家在准备什么的话，我更不该出于好奇心而去打乱大家的计划。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要不我们去探探口风？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是啊，说得我也好奇了。"
        },
        {
          "role": "哥伦比娅",
          "text": "可以呀，不过你们最好做点心理准备哦。"
        },
        {
          "role": "哥伦比娅",
          "text": "她恐怕猜得出你们会来见我，可能什么都不会对你们讲。"
        },
        {
          "type": "subtitle",
          "text": "同菈乌玛见面"
        },
        {
          "role": "派蒙",
          "text": "重修库塔尔神像？！"
        },
        {
          "role": "菈乌玛",
          "text": "正是。"
        },
        {
          "role": "菈乌玛",
          "text": "她不再是没有翅膀，只能孤独望着天外之月的「库塔尔」''月之少女'' 了。"
        },
        {
          "role": "菈乌玛",
          "text": "我们见证了她舒展双翼的模样，知晓了她重获生命的自由。"
        },
        {
          "role": "菈乌玛",
          "text": "所以，与之相对，神像也该好好修缮一番了。"
        },
        {
          "role": "派蒙",
          "text": "听着倒是不错呀。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你告诉霜月之子其他人了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菈乌玛",
          "text": "嗯。我为大家讲述了月神的牺牲与重临。"
        },
        {
          "role": "菈乌玛",
          "text": "以及在那片柔光的引领下，我们是如何对抗那污染世界的力量。"
        },
        {
          "role": "菈乌玛",
          "text": "对于月神回归这件事，众人无不喜悦。我便借此机会传达了哥伦比娅的想法。"
        },
        {
          "role": "菈乌玛",
          "text": "她想将我们视作家人，也想被我们看作是家人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大家怎么说？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菈乌玛",
          "text": "……"
        },
        {
          "role": "索妮齐娅",
          "text": "月神大人…"
        },
        {
          "role": "洛乌佳",
          "text": "把月神大人当家人这件事…真的不会太僭越吗？"
        },
        {
          "role": "菈乌玛",
          "text": "我相信，这正是哥伦比娅内心真实的愿望。"
        },
        {
          "role": "库涅贡妲",
          "text": "（咏月使大人竟然真的直接叫月神大人「哥伦比娅」！）"
        },
        {
          "role": "菈乌玛",
          "text": "诸位或许仍能记得，我前些时日说过的那句话。"
        },
        {
          "role": "菈乌玛",
          "text": "「路当以真相铺就，当由我们自己铺就。」"
        },
        {
          "role": "菈乌玛",
          "text": "我不会要求每个人都与我做出同等选择，但在今日，我也有一句良言想与各位分享。"
        },
        {
          "role": "菈乌玛",
          "text": "「如果想要邀请月光驻留，首先便需打开紧闭的门户。」"
        },
        {
          "role": "菈乌玛",
          "text": "…就是这样，根据这几天的情况来看，似乎比我预期的还要乐观一些。"
        },
        {
          "role": "马西捷",
          "text": "菈乌玛大人，新一批石材已经运到仓库了。"
        },
        {
          "role": "菈乌玛",
          "text": "知道了，我马上过去。"
        },
        {
          "role": "菈乌玛",
          "text": "刚才我说的话，包括你见到的这些景象，能暂时对哥伦比娅保密吗？我想为她准备一个惊喜。"
        },
        {
          "role": "派蒙",
          "text": "我知道是好心啦，但你们月神和信奉月神的人还真是喜欢惊喜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们会守密的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那个，菈乌玛，封口费…我是说，今天的飨月餐还有没有多余的…"
        },
        {
          "role": "菈乌玛",
          "text": "哈，我来为两位准备。对了，还有一件事…"
        },
        {
          "type": "subtitle",
          "text": "向哥伦比娅回报"
        },
        {
          "role": "哥伦比娅",
          "text": "你们回来了。"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅，你猜得一点没错，菈乌玛她什么都没和我们说呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她好像挺忙碌的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这几天我们会在这里陪你的！你就好好期待吧！"
        },
        {
          "role": "哥伦比娅",
          "text": "期待什么？"
        },
        {
          "role": "派蒙",
          "text": "呃…！没，没什么，我们也不知道！"
        },
        {
          "role": "哥伦比娅",
          "text": "呵呵…好吧，那我就先期待有你们相伴的这几天吧。"
        },
        {
          "role": "长翎鹮",
          "text": "！！"
        },
        {
          "role": "派蒙",
          "text": "噢！送菜的来了。欸？菜呢？"
        },
        {
          "role": "长翎鹮",
          "text": "！！"
        },
        {
          "role": "哥伦比娅",
          "text": "它说「时间到了」。你们知道是什么意思吗？"
        },
        {
          "role": "派蒙",
          "text": "噢噢噢我明白了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哥伦比娅。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "嗯？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不是蒙着眼睛么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，怎么了？"
        },
        {
          "role": "派蒙",
          "text": "但你蒙着眼睛也能用月矩力观察外界的模样对吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "没错，不如说，这样的感知还更清晰一些。"
        },
        {
          "role": "派蒙",
          "text": "那…那如果让你先别去感知外面发生了什么变化的话，可以吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "是「惊喜」，对吗？"
        },
        {
          "role": "派蒙",
          "text": "看来你已经猜到了啊…"
        },
        {
          "role": "哥伦比娅",
          "text": "好的，我知道了，那我把手交给你们。"
        },
        {
          "type": "subtitle",
          "text": "前往库塔尔神像"
        },
        {
          "role": "派蒙",
          "text": "我们到了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可以睁开眼睛了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "（她真的睁眼了！）"
        },
        {
          "role": "旅行者",
          "text": "（平时说顺嘴了…）"
        },
        {
          "role": "哥伦比娅",
          "text": "好美。"
        },
        {
          "role": "哥伦比娅",
          "text": "这对翅膀，让它显得更完整了。"
        },
        {
          "role": "菈乌玛",
          "text": "这是我等「霜月之子」送给哥伦比娅你的礼物。"
        },
        {
          "role": "菈乌玛",
          "text": "庆祝我们的神明从此能够自由翱翔，她的指尖终于触碰到了「家」的所在。"
        },
        {
          "role": "哥伦比娅",
          "text": "…从前的我看到这神像，只会浮现出自己出生时迷茫的心情。"
        },
        {
          "role": "哥伦比娅",
          "text": "现在，我感受到的则是「家」的温暖。"
        },
        {
          "role": "哥伦比娅",
          "text": "或许就像这尊雕像，尽管已经拥有了翅膀，但我依旧选择于此处栖身。"
        },
        {
          "role": "哥伦比娅",
          "text": "…谢谢你们。"
        },
        {
          "role": "菈乌玛",
          "text": "除此之外，还有一份礼物，不过需要跟着我多走一段路。"
        },
        {
          "role": "派蒙",
          "text": "欸？还有惊喜吗？"
        },
        {
          "role": "菈乌玛",
          "text": "我和同胞们在林中筹办了一场简单的欢迎宴会。"
        },
        {
          "role": "菈乌玛",
          "text": "哥伦比娅，从今往后，这里也将成为你的家园。"
        },
        {
          "role": "菈乌玛",
          "text": "当你想家的时候，就请你安心留下来，多喝几杯粗茶吧。"
        },
        {
          "role": "哥伦比娅",
          "text": "好呀，我会的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "正好，月亮升起来了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菈乌玛",
          "text": "我们走吧。"
        },
        {
          "role": "菈乌玛",
          "text": "希望每一个夜晚，都同那日的祈月之夜一样美好。"
        },
        {
          "role": "菈乌玛",
          "text": "欢迎回家，哥伦比娅。"
        }
      ]
    }
  ]
}