{
  "quest_id": 79072,
  "chapter_num": null,
  "chapter_title": "《飞帽匠》",
  "type": "wq",
  "route": "\"Flying Hatter\"",
  "stories": [
    {
      "story_id": 79072,
      "title": "《飞帽匠》",
      "description": "在星轨王城中，有一位对帽子格外有兴趣的人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与德维特对话"
        },
        {
          "role": "德维特",
          "text": "哎呀，真是荣幸。您就是那位旅行者吧，旁边这位一定是您的同伴派蒙小姐。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，没错，就是我们啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们有这么出名？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "德维特",
          "text": "星轨王城里的消息，总是比其他地方更灵通一些。"
        },
        {
          "role": "德维特",
          "text": "不得不说，您来得正好，我正好做完了这副名为「飞帽」的游戏。"
        },
        {
          "role": "德维特",
          "text": "虽然我不能像那篇《飞帽匠》里的帽子匠一样，让所有人都拥有一顶漂亮的帽子。"
        },
        {
          "role": "德维特",
          "text": "但我相信，这副「飞帽」游戏，一定能将欢乐带给所有游玩它的人。"
        },
        {
          "role": "德维特",
          "text": "我还为这款游戏设计了三种完全不同的玩法…呃，当然！规则也绝不复杂。"
        },
        {
          "role": "德维特",
          "text": "我相信，您只要玩上一局，就能完全理解了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要试试！",
              "dialogues": [
                {
                  "role": "德维特",
                  "text": "没问题，请到这边来。"
                }
              ]
            },
            {
              "text": "暂时没空…",
              "dialogues": [
                {
                  "role": "德维特",
                  "text": "别担心，等您有空了再来找我吧，我这段时间会一直待在这里。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（德维特）"
        },
        {
          "role": "德维特",
          "text": "您是想玩「飞帽」吗？欢迎！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要试试！",
              "dialogues": [
                {
                  "role": "德维特",
                  "text": "没问题，请到这边来。"
                }
              ]
            },
            {
              "text": "关于《飞帽匠》…",
              "dialogues": [
                {
                  "role": "德维特",
                  "text": "您对这故事有兴趣。哈哈哈，那我就讲给您听听吧，这故事倒也不长。"
                },
                {
                  "role": "德维特",
                  "text": "唔…故事的开头嘛，还得从一位手艺高超的帽子匠说起。"
                },
                {
                  "role": "德维特",
                  "text": "这位帽子匠能做出全世界最好的帽子，店门口每天都被堵得水泄不通，但他依旧能把每一顶帽子都做得整整齐齐，漂漂亮亮。"
                },
                {
                  "role": "德维特",
                  "text": "有人说，他甚至被一位女神拜托，做了足足十顶式样各不相同的漂亮礼帽。"
                },
                {
                  "role": "德维特",
                  "text": "女神为了感谢他的手艺，愿意为他实现一个愿望。但帽子匠却说，自己没什么尚未实现的愿望。"
                },
                {
                  "role": "德维特",
                  "text": "他喜欢做帽子，大家也喜欢他做的帽子，这就足够了。"
                },
                {
                  "role": "德维特",
                  "text": "女神认可了这个高尚的回答，但也说，自己的承诺依然有效。"
                },
                {
                  "role": "德维特",
                  "text": "无论何时，只要帽子匠愿意，她就会马上为他实现愿望。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "（继续听下去。）",
                      "dialogues": [
                        {
                          "role": "德维特",
                          "text": "但是，还没等帽子匠想出自己真正希望被实现的愿望，贵族手下的士兵们突然上门。"
                        },
                        {
                          "role": "德维特",
                          "text": "「大人命令你，为他打造出最好的帽子。」士兵盛气凌人地说道。"
                        },
                        {
                          "role": "德维特",
                          "text": "「好的，等我做好后，就为大人送过去，但在那之前，我还要…」"
                        },
                        {
                          "role": "德维特",
                          "text": "「不！你现在只能为大人做帽子。」士兵打断了帽子匠的话。在刀剑和长矛的寒光下，帽子匠不得不跟着士兵离开了。"
                        },
                        {
                          "role": "德维特",
                          "text": "在王宫里，贵族盛情地接待了他，还举办了盛大的宴席。"
                        },
                        {
                          "role": "德维特",
                          "text": "「来吧！为我做出最好的帽子，哈哈哈，最有权力的人，就要配上最好的帽子！」贵族哈哈大笑，但帽子匠却吃不下一点东西。"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "（继续听下去。）",
                              "dialogues": [
                                {
                                  "role": "德维特",
                                  "text": "帽子匠明白，自己再也无法离开王宫了。他听说过这位贵族的事迹——这吝啬鬼只爱搜刮，成天只想着将所有宝贵之物收归己有。"
                                },
                                {
                                  "role": "德维特",
                                  "text": "但他并不是侠盗或巫师，只是一个帽子匠，帽子也无法帮助他骗过守卫，越过高墙。"
                                },
                                {
                                  "role": "德维特",
                                  "text": "但是，悲伤的帽子匠突然想起了女神的承诺，这或许就是他的救命稻草。于是他推开窗子，暗自祈祷——"
                                },
                                {
                                  "role": "德维特",
                                  "text": "「亲爱的女神，请你帮我逃出牢笼，还有许多人等着我为他们做上一顶好帽子。」"
                                },
                                {
                                  "role": "德维特",
                                  "text": "「我想自由地为所有人做帽子——这就是我的愿望。」"
                                },
                                {
                                  "type": "choice",
                                  "role": "旅行者",
                                  "options": [
                                    {
                                      "text": "（继续听下去。）",
                                      "dialogues": [
                                        {
                                          "role": "德维特",
                                          "text": "在愿望许完后的下一刹那，帽子匠怀里那顶尚未完工的帽子突然自己跳了起来，猛地扣在了他的头上。"
                                        },
                                        {
                                          "role": "德维特",
                                          "text": "帽子匠的整个身子都随着那顶帽子飘了起来，他一下子飞出了窗户，高高地越过了目瞪口呆的守卫，和戒备森严的高墙。"
                                        },
                                        {
                                          "role": "德维特",
                                          "text": "身后的箭矢如雨点般射来，但都被风轻轻吹走。愕然的守卫们只能看着帽子匠飞离了贵族的官邸。"
                                        },
                                        {
                                          "role": "德维特",
                                          "text": "在那以后，就再也没人在城里见过这位帽子匠，他在城里的帽子店也被恼羞成怒的贵族给拆掉了。"
                                        },
                                        {
                                          "role": "德维特",
                                          "text": "但帽子匠的好邻居们知道，这位聪明的好工匠依然在为人们的帽子而工作。"
                                        },
                                        {
                                          "role": "德维特",
                                          "text": "如果想要找帽子匠订做帽子，就要在午夜时分，用果酱在树皮上写下自己的请求，再把树皮和做帽子的钱放在最高的那根烟囱上。"
                                        },
                                        {
                                          "role": "德维特",
                                          "text": "在一个星期之内，一顶带着青草香气的漂亮新帽子就会出现在窗台上。"
                                        },
                                        {
                                          "role": "德维特",
                                          "text": "从此，人们都这么称呼他——那位「飞帽匠」。"
                                        }
                                      ]
                                    },
                                    {
                                      "text": "（还是先不听了…）",
                                      "dialogues": []
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "text": "（还是先不听了…）",
                              "dialogues": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "（还是先不听了…）",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "暂时没空…",
              "dialogues": [
                {
                  "role": "德维特",
                  "text": "别担心，等您有空了再来找我吧，我这段时间会一直待在这里。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          11,
          13
        ]
      ]
    }
  ]
}