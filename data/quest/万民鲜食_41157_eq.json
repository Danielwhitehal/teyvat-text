{
  "quest_id": 41157,
  "chapter_num": null,
  "chapter_title": "万民鲜食",
  "type": "eq",
  "route": "Wanmin Fresh",
  "stories": [
    {
      "story_id": 41157,
      "title": "万民鲜食",
      "description": "璃月港的万民堂里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "卯师傅",
          "text": "好吧，我想想还有谁有这个本事…"
        },
        {
          "role": "旅行者",
          "text": "好吧，我去这就去送。"
        },
        {
          "role": "卯师傅",
          "text": "那麻烦了。"
        },
        {
          "role": "卯师傅",
          "text": "在孤云阁那里要小心啊，别让不吉利的东西攻击了。"
        },
        {
          "role": "好奇的子瑞",
          "text": "怎么还没送来，这都过了多长时间了…"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "卯师傅",
          "text": "对，子瑞这小子在我们这订了一份莲子禽蛋羹。他人应该好像撒脱到孤云阁那边去了。"
        },
        {
          "role": "卯师傅",
          "text": "璃月的小年轻怎么尽去些稀奇古怪的地方！"
        },
        {
          "role": "卯师傅",
          "text": "总之这份莲子禽蛋羹，麻烦你帮忙送到去了。不要乱飞，可能会把羹洒出来。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "好奇的子瑞",
          "text": "感激不尽啊，吃饱了之后我要快点回璃月港。"
        }
      ]
    }
  ]
}