{
  "quest_id": 71054,
  "chapter_num": null,
  "chapter_title": "潜身敌营无人知",
  "type": "wq",
  "route": "Undetected Infiltration",
  "stories": [
    {
      "story_id": 71054,
      "title": "潜身敌营无人知",
      "description": "行迹奇怪的盗宝团原来是千岩军所假扮，千岩军顺势委托你们，不如一同前去盗宝团的营地剿匪…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与投降的盗宝团成员对话"
        },
        {
          "role": "彦博",
          "text": "你来了，我就知道你会帮忙的。"
        },
        {
          "role": "彦博",
          "text": "盗宝团的走私犯们应该会在东边的大营地里和愚人众进行交易，而在通往大营的道路上，他们还设立了三个小营地。"
        },
        {
          "role": "彦博",
          "text": "根据线人的情报，它们分别是东南边的<color=#00E1FFFF>炊事营地</color>、更东边的<color=#00E1FFFF>兵器营地</color>，与东北边的<color=#00E1FFFF>炼金营地</color>。如果我们事先突袭这三个营地，大概能够截断他们的物资供应。"
        },
        {
          "role": "彦博",
          "text": "恰好因为前阵子群玉阁的事情，在这里巡逻的千岩军人力不足，让这帮家伙猖狂了一段时间，他们现在戒备松懈了不少，正适合我们突袭。"
        },
        {
          "role": "彦博",
          "text": "只不过…因为之前的误会，我现在能支援的人手应该只够巩固一个分支营地，但如果你有需要的话，我们一定会加以支援的。"
        },
        {
          "role": "彦博",
          "text": "停手，停手！请听我们解释！！"
        },
        {
          "role": "派蒙",
          "text": "你们不是盗宝团吗？乖乖去自首就好啦，有什么好解释的！"
        },
        {
          "role": "彦博",
          "text": "千岩军，层岩巨渊辖区，中队长彦博。很高兴见到你们，旅行者。"
        },
        {
          "role": "彦博",
          "text": "呃…和…很有名的小飞侠。"
        },
        {
          "role": "派蒙",
          "text": "喂，怎么到我这里就忘了名字啦！我是派蒙！"
        },
        {
          "role": "彦博",
          "text": "哈哈…失礼、失礼。实在不好意思…但我们大概产生了一点小误会。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等等…你们不是盗宝团？",
              "dialogues": [
                {
                  "role": "彦博",
                  "text": "当然不是，恰恰相反。"
                }
              ]
            },
            {
              "text": "你们是…千岩军？",
              "dialogues": [
                {
                  "role": "彦博",
                  "text": "哈哈，抱歉事先没来得及解释…我们还以为你是来搞破坏的。"
                },
                {
                  "role": "派蒙",
                  "text": "唔…某种意义上也没错吧…"
                }
              ]
            }
          ]
        },
        {
          "role": "彦博",
          "text": "咳咳，这么说吧。这处作坊以前确实是盗宝团占据的据点没错。"
        },
        {
          "role": "彦博",
          "text": "工人撤走以后，那些见缝就钻的家伙就进来了…一开始还只是盗采矿石和琉璃晶砂搞走私，和我们的巡逻队玩捉迷藏。"
        },
        {
          "role": "彦博",
          "text": "后来他们贼胆越来越大，居然敢占据矿工留下的旧仓库，自己打造廉价的破烂首饰拿出去卖了！唉，真是…让人看了心疼呀。"
        },
        {
          "role": "旅行者",
          "text": "让人看了心疼？"
        },
        {
          "role": "彦博",
          "text": "这么粗糙的首饰只能骗骗第一次来璃月的游客，或者没见识的读书人吧…要想以低价打入璃月的市场？哼，恐怕是要砸牌子了。"
        },
        {
          "role": "派蒙",
          "text": "他们本来也没有牌子呀！"
        },
        {
          "role": "彦博",
          "text": "哈哈，你说的没错。拿这些东西牟利发财，也太没品位了…"
        },
        {
          "role": "彦博",
          "text": "所以我们来了，收拾了原来占据这里的盗宝团，装扮成他们的样子潜伏在了这里…嗯，已经是前段时间的事情了。"
        },
        {
          "role": "彦博",
          "text": "现在我们又摸清他们的头目们与「愚人众」的一支部队有联络，疑似在交易什么危险物资。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于愚人众与盗宝团的联络…",
              "dialogues": [
                {
                  "role": "彦博",
                  "text": "尽管之前我们挫败了愚人众的图谋，但他们在璃月的野外仍存在一些残党活动…这些家伙的专业性和战斗力都不容小觑，对我们来说极其危险。"
                },
                {
                  "role": "彦博",
                  "text": "假如盗宝团和他们沆瀣一气，勾结起来对抗我们的话…会是一个很让人头疼的安全问题。"
                }
              ]
            },
            {
              "text": "关于危险物资…",
              "dialogues": [
                {
                  "role": "彦博",
                  "text": "我的线人说那些愚人众在用大批摩拉和军用物资，向盗宝团购买什么东西…但他只发现了食物和生活物品，或许是障眼法。"
                }
              ]
            }
          ]
        },
        {
          "role": "彦博",
          "text": "总之，我们万事俱备，只欠总攻。只需要把他们一锅端，就能搞清楚他们在捣什么鬼了。"
        },
        {
          "role": "派蒙",
          "text": "结果没想到我们来了…"
        },
        {
          "role": "彦博",
          "text": "唉…我们知道你们很厉害，但没想到这么能打…现在可好，你们把我的队伍打趴下了一大半…"
        },
        {
          "role": "彦博",
          "text": "当然啦，我们驻扎在这里另有一个原因是…此处恰好坐落了一座「七星阵法」的「磐键」。我们可不能让它落在盗宝团这群心术不正的家伙手里。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "唔…抱歉。",
              "dialogues": [
                {
                  "role": "彦博",
                  "text": "哈哈哈，没关系！我们没看出是你们，是我们的过错…此前就有命令下来要我为你们让路，结果谁能想到你们这么快就来了！"
                }
              ]
            },
            {
              "text": "这么说，我们真的打错人了。",
              "dialogues": [
                {
                  "role": "彦博",
                  "text": "嗯，不过我不怪你们的。我们有错在先啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哇…千岩军的大哥原来这么好说话的！那我们可以走了吧？"
        },
        {
          "role": "彦博",
          "text": "我不怪你们，不代表璃月的律法会放过你们。嘿嘿，实在抱歉。"
        },
        {
          "role": "派蒙",
          "text": "欸——！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "下次请把话说完！",
              "dialogues": []
            },
            {
              "text": "分明是故意的吧！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "彦博",
          "text": "嗯…让我看看：寻衅滋事；干扰千岩军公务；蓄意破坏「七星阵法」；再加上一个…破坏既有现场…"
        },
        {
          "role": "彦博",
          "text": "再减去千岩军当事人的谅解…如果一切顺利的话呢，恭喜二位客人，可以在璃月港多住五到十年了！"
        },
        {
          "role": "派蒙",
          "text": "欸？？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我可以请律师吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…请给我们律师名单！"
                }
              ]
            },
            {
              "text": "早知道不如下手更重一点…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼，我们只不过打了看起来很讨厌的人而已啦！谁让你们都穿着盗宝团的衣服！"
                }
              ]
            }
          ]
        },
        {
          "role": "彦博",
          "text": "咳咳…但是…！请听我把话说完！"
        },
        {
          "role": "彦博",
          "text": "但是，合法市民或国外旅客可以运用任何合法手段协助千岩军办案，并且获得应得的奖励或补偿…这也是璃月律法的规定。"
        },
        {
          "role": "彦博",
          "text": "所以两位英雄，刚才那一架可不是白打的哦。"
        },
        {
          "role": "旅行者",
          "text": "帮助你们的话，我们会获得什么？"
        },
        {
          "role": "彦博",
          "text": "查封的赃物是不能随便动的，但如果两位愿意帮忙的话，抓捕过程中偶遇的财物…唔，比如「盗宝团的秘密宝藏！」之类的，由你们处理就好。"
        },
        {
          "role": "彦博",
          "text": "另外呢，我和同僚们也凑了些摩拉，希望两位不会嫌弃…唉，毕竟这种意外而来的「帮助」，事先并没有算进预算里…"
        },
        {
          "role": "派蒙",
          "text": "唔…也就是说，我们不用坐大牢，还有宝贝拿！对吧？"
        },
        {
          "role": "彦博",
          "text": "是的。"
        },
        {
          "role": "派蒙",
          "text": "好！那我们就勉为其难地答应啦！请你带路吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等等…！",
              "dialogues": []
            },
            {
              "text": "我还没…！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "彦博",
          "text": "好了，就请两位英雄不必客气啦…我先去集结点待命了，还望你们一定跟上来，不然我们可要提前行动咯。"
        },
        {
          "role": "派蒙",
          "text": "对呀，我们快跟上吧！"
        },
        {
          "role": "旅行者",
          "text": "喂…！"
        },
        {
          "role": "派蒙",
          "text": "快点啦，我们这是在协助千岩军办案呢！而且不是也有好多摩拉拿嘛！"
        },
        {
          "type": "subtitle",
          "text": "与走私营地前的千岩军彦博汇合"
        },
        {
          "role": "旅行者",
          "text": "我建议先处理<color=#00E1FFFF>炊事营地</color>。"
        },
        {
          "role": "彦博",
          "text": "明白，我们会紧急把他们的伙食都运走的。"
        },
        {
          "role": "彦博",
          "text": "准备好了吗？我们出发！"
        },
        {
          "role": "旅行者",
          "text": "先清剿<color=#00E1FFFF>炼金营地</color>能够削弱他们。"
        },
        {
          "role": "彦博",
          "text": "很好，我们这就去查封他们的炼金设备。"
        },
        {
          "role": "旅行者",
          "text": "先清剿<color=#00E1FFFF>兵器营地</color>会更方便。"
        },
        {
          "role": "彦博",
          "text": "好的，他们很快就会发现自己没有武器可用了。"
        },
        {
          "type": "subtitle",
          "text": "清理盗宝团的后勤营地"
        },
        {
          "type": "subtitle",
          "text": "清理盗宝团的后勤营地"
        },
        {
          "role": "彦博",
          "text": "请你放心吧，我们会尽快把这些食物运走的。"
        },
        {
          "role": "彦博",
          "text": "现在就看你的了，祝你一切顺利。"
        },
        {
          "type": "subtitle",
          "text": "清理盗宝团的后勤营地"
        },
        {
          "role": "彦博",
          "text": "他们的炼金设备还挺业余的…哼，刚刚抓捕时不小心磕碰了一下，已经几乎不能使用了。"
        },
        {
          "role": "彦博",
          "text": "我们这边会尽快查封这些赃物，下面就要多赖英雄帮忙了。"
        },
        {
          "role": "彦博",
          "text": "他们的弩箭保养的不错，可惜现在是我们的了。让我看看光是这些武器能判他们多少年吧…"
        },
        {
          "role": "彦博",
          "text": "我们这边已经搞定啦，接下来就要拜托你们了。"
        },
        {
          "type": "subtitle",
          "text": "解决大营里的盗宝团走私团伙"
        },
        {
          "type": "subtitle",
          "text": "向彦博回报战果"
        },
        {
          "role": "彦博",
          "text": "真是精彩！感谢你的帮助，对了，这里是说好的奖励。"
        },
        {
          "role": "派蒙",
          "text": "好耶！好多摩拉！欸…你什么时候把衣服也换了…？"
        },
        {
          "role": "彦博",
          "text": "你们打架的时候呀…咳咳，呃，我是说，那不重要…为了防止你们打得兴起，又把我们误伤一遍，把制服换回来还是有必要的啦。"
        },
        {
          "role": "彦博",
          "text": "千岩军永远感谢你们的帮助。啊，遵照我们的约定，请四处看看有没有你需要的东西吧。"
        },
        {
          "role": "彦博",
          "text": "呃…我是说，除了那些我们正在查封的赃物以外。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "恭喜你啦，任务圆满完成。",
              "dialogues": [
                {
                  "role": "彦博",
                  "text": "哈哈，当然，幸好有你们帮忙，我们才能这么顺利。"
                }
              ]
            },
            {
              "text": "这下我们不用受牢狱之灾了吧？",
              "dialogues": [
                {
                  "role": "彦博",
                  "text": "当然，你们是协助千岩军…唔，受千岩军协助破获走私大案的首功英雄，我们怎敢请你进大牢呢？"
                }
              ]
            }
          ]
        },
        {
          "role": "彦博",
          "text": "嗯，我的意思是…只要别像这些小贼一样，凡事妄图走捷径，我们就不会找你的麻烦。"
        },
        {
          "role": "派蒙",
          "text": "哼，我们才不是那样的家伙呢！"
        },
        {
          "role": "彦博",
          "text": "哈哈，说得也是呀…"
        },
        {
          "role": "彦博",
          "text": "唉，话说回来，像你这样会使用元素力的人，不论行善或是作恶，都是不容小觑的力量…"
        },
        {
          "role": "彦博",
          "text": "我们需要几个星期或者几个月才能完成的任务，对你们来说可能是轻而易举的事…而如果把元素力用来作恶的话，也会以很小的代价，造成恐怖的破坏。"
        },
        {
          "role": "彦博",
          "text": "所以呀，我也并不觉得没有「神之眼」是一件坏事。"
        },
        {
          "role": "彦博",
          "text": "我曾见过有些人，为强求非人的力量而不惜付出自身生命的代价，最终却只是做了别人的工具、傀儡，你说说，这值得吗？"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "彦博",
          "text": "这世上还是没有神之眼的无力之人占了多数，而真正能够理解他们、保护他们的也多是同样的普通人。"
        },
        {
          "role": "彦博",
          "text": "身为这样的普通人，能够为保护大多数人而履行职责，不得不说是我的荣幸。"
        },
        {
          "role": "彦博",
          "text": "如果哪天，不再有人获得神之眼，甚至守护璃月港的仙人也逝去了…我想我也不会放弃这份职责。"
        },
        {
          "role": "彦博",
          "text": "啊，抱歉…自言自语扯了很多没用的话，留你太久了吧？"
        },
        {
          "role": "彦博",
          "text": "好了，我们还需要查验和登记赃物，就不多闲聊了。"
        },
        {
          "role": "彦博",
          "text": "我代表同僚再次感谢你的帮助，愿你今后的旅途一路顺利。千岩牢固，重嶂不移。"
        }
      ]
    }
  ]
}