{
  "quest_id": 10009,
  "chapter_num": "未归的熄星 其四",
  "chapter_title": "古星命定之地",
  "type": "eq",
  "route": "Where Ancient Stars Align",
  "stories": [
    {
      "story_id": 41114,
      "title": "古星命定之地",
      "description": "这些从天而降的陨石，曾是属于某个人的「命星」。古老的它因何坠落？燃尽的它要去向何方？带着直面答案的勇气，你逐步走向秘密。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "向莫娜打听占卜的进度"
        },
        {
          "role": "派蒙",
          "text": "咦，菲谢尔在等我们吗？"
        },
        {
          "role": "奥兹",
          "text": "来得可真是时候。虽然不舍，也必须和各位说出这番话了。"
        },
        {
          "role": "菲谢尔",
          "text": "暂且与本皇女辞别吧，同行者。一路上你展现了非凡的勇气，这股嘉奖的风正是为你而起。"
        },
        {
          "role": "派蒙",
          "text": "哎哎哎？怎么突然道别呀？"
        },
        {
          "role": "旅行者",
          "text": "菲谢尔，你要走了吗？"
        },
        {
          "role": "奥兹",
          "text": "大陨石加剧了昏睡现象，连身强体壮的士兵也支撑不住。现在到处都缺乏人手。"
        },
        {
          "role": "奥兹",
          "text": "皇女与我要代替士兵看护那些患者，剩下的事就交给你们了。"
        },
        {
          "role": "菲谢尔",
          "text": "旅行者…再见了。"
        },
        {
          "role": "菲谢尔",
          "text": "你是很好的聆听者，愿意陪我聊天。"
        },
        {
          "role": "菲谢尔",
          "text": "平时，即使在协会里，许多冒险家愿意跟我搭档，也只是为了从我的话里听出奥兹侦察的结果而已…"
        },
        {
          "role": "菲谢尔",
          "text": "这次的一小段旅途，是一场很好的冒险。突然说要走，我也…"
        },
        {
          "role": "派蒙",
          "text": "咦？菲谢尔的说话方式，是不是有点不像平常的那种…？"
        },
        {
          "role": "菲谢尔",
          "text": "！！！"
        },
        {
          "role": "菲谢尔",
          "text": "（啊——啊啊啊刚才不小心出神了…！）"
        },
        {
          "role": "奥兹",
          "text": "小，小姐的意思是…你们是如此勇敢，又有常人难及的智慧，任何谜题在你们面前都会化为乌有！"
        },
        {
          "role": "派蒙",
          "text": "怎么这次奥兹「翻译」的方向完全反过来了。"
        },
        {
          "role": "奥兹",
          "text": "咳，咳咳…小姐想说，如果是你们几位，一定可以抵达幻象背后的真相。"
        },
        {
          "role": "菲谢尔",
          "text": "咳咳…唔，没错。你们是皇女的扈从。断罪的骑士，你要带领他们走出黑暗，回归光明之地。"
        },
        {
          "role": "莫娜",
          "text": "谁是你的扈从啊…"
        },
        {
          "role": "旅行者",
          "text": "奥兹，菲谢尔，谢谢你们。"
        },
        {
          "role": "奥兹",
          "text": "还会再见的，等一切结束，再约着喝杯酒吧。"
        },
        {
          "role": "莫娜",
          "text": "哎，可惜了两个好帮手。"
        },
        {
          "role": "莫娜",
          "text": "别愁眉苦脸的，说个好消息吧，我有新发现了。"
        },
        {
          "role": "莫娜",
          "text": "我从大陨石上刮来一些粉末帮助占卜，卓有成效哦！"
        },
        {
          "role": "莫娜",
          "text": "这些坠落的石头已经存在成百上千年，莱纳德应该是很久之前的人了。"
        },
        {
          "role": "莫娜",
          "text": "陨石传递着他的意志，也就是说，千百年来他的愿望一直没有减弱。"
        },
        {
          "role": "莫娜",
          "text": "一个热切渴望登上山顶的古人…我敢断定，他和你一样，也是冒险家。"
        },
        {
          "role": "派蒙",
          "text": "冒险家？难怪这么想爬上雪山！"
        },
        {
          "role": "莫娜",
          "text": "目前的办法几乎是跟时间赛跑，我们很被动。必须转换思路，从根本上解决问题。"
        },
        {
          "role": "派蒙",
          "text": "我支持！我认为现在应该把重心放在莱纳德身上！"
        },
        {
          "role": "莫娜",
          "text": "嗯…如果陨石承载了某种愿望，那这些石头就正如菲谢尔所说，算是某种形式的「诅咒」…"
        },
        {
          "role": "莫娜",
          "text": "真难得，她蒙对了…咳咳，算了，优雅的占星术士不该这样评价别人。"
        },
        {
          "role": "莫娜",
          "text": "总之，我们只要去解开诅咒就好。"
        },
        {
          "role": "旅行者",
          "text": "现在就出发吧，派蒙。"
        },
        {
          "role": "派蒙",
          "text": "好！"
        },
        {
          "role": "派蒙",
          "text": "既然要调查从前的冒险家，就该从{{颜色|蓝|冒险家协会}}入手！"
        },
        {
          "type": "subtitle",
          "text": "询问蒙德的凯瑟琳"
        },
        {
          "role": "凯瑟琳",
          "text": "叫这个名字的冒险家有好几个，我也不敢断论。"
        },
        {
          "role": "凯瑟琳",
          "text": "但我有印象看过叫这个名字的人写的书，不如去图书馆看看吧？"
        },
        {
          "role": "凯瑟琳",
          "text": "但我记得，有一本作者名叫莱纳德的书，你们不如去{{颜色|蓝|图书馆}}看看吧？"
        },
        {
          "type": "subtitle",
          "text": "前往蒙德图书馆寻找线索"
        },
        {
          "type": "subtitle",
          "text": "查看丽莎桌前的索引目录"
        },
        {
          "role": "派蒙",
          "text": "作者，莱纳德…莱纳德…有了！"
        },
        {
          "role": "派蒙",
          "text": "索引上说，莱纳德的冒险家手册在图书馆{{颜色|蓝|一楼}}的{{颜色|蓝|西北角}}。"
        },
        {
          "role": "派蒙",
          "text": "西北角…应该就是那边吧！"
        },
        {
          "type": "subtitle",
          "text": "搜寻莱纳德的著作"
        },
        {
          "role": "派蒙",
          "text": "找到了！冒险家手册《山与海之书》，作者莱纳德！"
        },
        {
          "role": "派蒙",
          "text": "可是，这本书居然缺字少页，根本看不懂！"
        },
        {
          "role": "派蒙",
          "text": "怎么这样，呜…该不会白来了吧…"
        },
        {
          "role": "旅行者",
          "text": "别放弃，拿给莫娜看看。"
        },
        {
          "role": "派蒙",
          "text": "啊，对哦，说不定她有办法。"
        },
        {
          "type": "subtitle",
          "text": "将莱纳德的著作带给莫娜"
        },
        {
          "role": "派蒙",
          "text": "找到他的书了！"
        },
        {
          "role": "莫娜",
          "text": "快给我看看！"
        },
        {
          "role": "旅行者",
          "text": "内容有缺损，完全不连贯。"
        },
        {
          "role": "莫娜",
          "text": "哼哼，我就知道会这样。"
        },
        {
          "role": "莫娜",
          "text": "如果是一般的占星术士，多半已经投降了！"
        },
        {
          "role": "莫娜",
          "text": "但我莫娜可是未来的占星术第一人，没有什么东西能难倒我。"
        },
        {
          "role": "莫娜",
          "text": "用星盘推算缺漏的部分填入其中，再进行解读…"
        },
        {
          "role": "莫娜",
          "text": "呼——！终于看完了…"
        },
        {
          "role": "派蒙",
          "text": "说了什么呀！"
        },
        {
          "role": "莫娜",
          "text": "和我想的一样，莱纳德是一名两千年前的冒险家。"
        },
        {
          "role": "莫娜",
          "text": "他毕生的梦想就是登上一座名叫「尖帽子峰」的雪山。"
        },
        {
          "role": "派蒙",
          "text": "两千年？这些陨石是…古代人的「命之座」？！"
        },
        {
          "role": "莫娜",
          "text": "他的命之座由于某种原因被召唤到大地上。关于这点，我认为和愚人众有关。"
        },
        {
          "role": "派蒙",
          "text": "同意，稀奇古怪的事情就数他们干得最多。"
        },
        {
          "role": "莫娜",
          "text": "这些陨石内含元素力，以一种精神暗示的方式辐射了周围居民，使他们陷入梦境。"
        },
        {
          "role": "莫娜",
          "text": "另外如果我猜得没错，这批陨石中应该有一颗类似核心的存在，是莱纳德精神的结晶。"
        },
        {
          "role": "旅行者",
          "text": "它会在哪里呢？"
        },
        {
          "role": "莫娜",
          "text": "如果我是莱纳德，这颗核心一定会按我所想，从空中抵达生前没能登上的山顶。"
        },
        {
          "role": "派蒙",
          "text": "核心会在尖帽子峰吗？可是…尖帽子峰在哪里呀？我都没听说过这个地方。"
        },
        {
          "role": "莫娜",
          "text": "我也是第一次知道。对比书中地图与现在的蒙德地形，我发现，尖帽子峰已经不存在了。"
        },
        {
          "role": "派蒙",
          "text": "那么大一座雪山也会消失吗？！"
        },
        {
          "role": "莫娜",
          "text": "我在书上读到过，风神巴巴托斯为了他的人民，曾经动用神力吹散冰雪，也改变了蒙德的地貌。"
        },
        {
          "role": "莫娜",
          "text": "过去的山峰被一望无垠的大海取代了。但若将那座山放入海中，以它曾经的高度，还是会留下一些痕迹的。"
        },
        {
          "role": "莫娜",
          "text": "——峰顶露出水面的部分，如今叫做…"
        },
        {
          "role": "莫娜",
          "text": "{{颜色|蓝|「马斯克礁」}}。"
        },
        {
          "type": "subtitle",
          "text": "根据书中提示，前往马斯克礁"
        },
        {
          "role": "莫娜",
          "text": "哦？这就是从前的尖帽子峰吗？变得好小呢。"
        },
        {
          "role": "派蒙",
          "text": "哎，有人先到了？这里是什么观光景点吗？"
        },
        {
          "role": "派蒙",
          "text": "啊！是你！"
        },
        {
          "role": "「散兵」",
          "text": "唔…嗯？是你们？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是怎么找到这里的？",
              "dialogues": []
            },
            {
              "text": "你是刚睡醒吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "他这个样子，难道是刚从梦境里出来？"
        },
        {
          "role": "莫娜",
          "text": "竟然有人能凭自己的力量苏醒过来…怎么可能？"
        },
        {
          "role": "「散兵」",
          "text": "哼，你们做不到，不代表我也做不到。"
        },
        {
          "role": "「散兵」",
          "text": "你们来晚了一步，我的「研究」已经完成了。"
        },
        {
          "role": "派蒙",
          "text": "果然这一切都是你们愚人众搞的花样吗？！"
        },
        {
          "role": "「散兵」",
          "text": "别那么紧张，我今天没时间陪你们玩。下回再找你的麻烦也不迟。"
        },
        {
          "role": "旅行者",
          "text": "等等！你到底有什么目的！"
        },
        {
          "role": "莫娜",
          "text": "你刚才进入了那个众人共通的雪山梦境吧？你对莱纳德的事知道多少？"
        },
        {
          "role": "「散兵」",
          "text": "莱纳德？什么莱纳德…哼，不管了，现在可不是关心杂鱼的时候。"
        },
        {
          "role": "「散兵」",
          "text": "我发现了…更可怕、更重要的事呀。"
        },
        {
          "role": "派蒙",
          "text": "嗯？"
        },
        {
          "role": "旅行者",
          "text": "是什么？"
        },
        {
          "role": "「散兵」",
          "text": "星空本身，就是个巨大的谎言。"
        },
        {
          "role": "莫娜",
          "text": "星空…谎言？这是什么意思？"
        },
        {
          "role": "派蒙",
          "text": "是想反驳莫娜的什么占星术理论吗？那也不用说「星空本身是谎言」吧。"
        },
        {
          "role": "派蒙",
          "text": "在夜里，抬头往天上看，不就能直接看到星星吗？这种常识…"
        },
        {
          "role": "「散兵」",
          "text": "哈…哈哈哈哈哈哈！还在说这种天真的话！"
        },
        {
          "role": "「散兵」",
          "text": "不过，这也不是你的错，因为直到不久之前，我也是这样相信的…"
        },
        {
          "role": "莫娜",
          "text": "直到刚才？你是指…"
        },
        {
          "role": "「散兵」",
          "text": "哼，我可没空再陪你们探讨这些了。"
        },
        {
          "role": "「散兵」",
          "text": "「丑角」那家伙…把这种任务交给我，居然不事先预警可能的「发现」…是想故意吓我一跳吗？！"
        },
        {
          "role": "「散兵」",
          "text": "我现在必须去确认「真相」。那么，再见了，菜鸟们！"
        },
        {
          "type": "subtitle",
          "text": "击败散兵的手下"
        },
        {
          "role": "莫娜",
          "text": "他就这么走了？还说我们是菜鸟？！"
        },
        {
          "role": "莫娜",
          "text": "竟敢小看我，可恶…看来是时候让他们领教天才的怒火了！"
        },
        {
          "role": "派蒙",
          "text": "真是一场恶战啊！"
        },
        {
          "role": "莫娜",
          "text": "这就是惹恼我的下场！"
        },
        {
          "role": "旅行者",
          "text": "莫娜真厉害。"
        },
        {
          "role": "莫娜",
          "text": "当然了！派蒙，你也觉得我很厉害对吧？对吧对吧？"
        },
        {
          "role": "派蒙",
          "text": "是啊是啊，没有莫娜，我们恐怕会陷入更大的麻烦。"
        },
        {
          "role": "莫娜",
          "text": "哼，听见没有！愚人众执行官！坏男人！"
        },
        {
          "role": "莫娜",
          "text": "不过看他刚才那么震惊的样子，也不像在撒谎。难道师父教导我占星术时所说的「虚假之天」还有其他含义？"
        },
        {
          "role": "莫娜",
          "text": "啊…咳咳，我走神了。那么，去完成我们最重要的工作吧。"
        },
        {
          "role": "派蒙",
          "text": "{{颜色|蓝|陨石的核心}}，一定就在这里附近！"
        },
        {
          "type": "subtitle",
          "text": "销毁陨石核心"
        },
        {
          "role": "派蒙",
          "text": "哇，这就是核心吗，和其他陨石不太一样呢！有种…明亮的感觉？"
        },
        {
          "role": "莫娜",
          "text": "这块石头上有着惊人的元素力和意念。确实是核心没错。"
        },
        {
          "role": "旅行者",
          "text": "我们…应该破坏它吗？"
        },
        {
          "role": "莫娜",
          "text": "嗯，不把它清理掉，人们就不会醒来……这块核心就是一切事件的根源。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，加油啊！"
        },
        {
          "role": "莫娜",
          "text": "没想到，原来是这么一回事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "攀爬的人，试图抵达未知的高峰。",
              "dialogues": []
            },
            {
              "text": "执着的人，愿将意志传递给未来。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莫娜",
          "text": "人类的信念，竟然可以在天空中留存千年…"
        },
        {
          "role": "莫娜",
          "text": "哎，果然占星学是个厉害的东西呀！"
        },
        {
          "role": "派蒙",
          "text": "为什么突然说到这上面去了？"
        },
        {
          "role": "莫娜",
          "text": "能和星星交流，就能掌握从古到今所有秘密，当然啦，能做到这种事的占星术士除了我也没有几个。"
        },
        {
          "role": "旅行者",
          "text": "莫娜，这次太谢谢你了。"
        },
        {
          "role": "莫娜",
          "text": "干、干嘛啊，突然这么认真…"
        },
        {
          "role": "莫娜",
          "text": "话说回来，那个叫菲谢尔的女孩子，还真是神奇。"
        },
        {
          "role": "派蒙",
          "text": "我也觉得！她明明…呃…怎么说呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是个充满奇思妙想的人。",
              "dialogues": []
            },
            {
              "text": "是个异想天开的怪人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "虽然是这样啦，但你回忆一下…她说的好像也没错呢。"
        },
        {
          "role": "派蒙",
          "text": "难道说，她就是那种用错误过程得出正确结果的人？"
        },
        {
          "role": "莫娜",
          "text": "说不定真是这样。"
        },
        {
          "role": "派蒙",
          "text": "我最没想到的是，尖帽子峰居然变成了一座小岛！"
        },
        {
          "role": "莫娜",
          "text": "过去的高山成了海中一块小小的陆地。现在的蒙德人只要坐上船，几乎都能到那里吧？"
        },
        {
          "role": "派蒙",
          "text": "那岂不是人人都能登上尖帽子峰了？"
        },
        {
          "role": "旅行者",
          "text": "人人都能抵达山顶了呢。"
        },
        {
          "role": "派蒙",
          "text": "莱纳德会高兴吗？虽然尖帽子峰是个意外，但现在的蒙德人在风神帮助下已经能够飞翔了。"
        },
        {
          "role": "派蒙",
          "text": "有了翅膀，人就能去到更高更远的地方，探索更多未知的角落。"
        },
        {
          "role": "旅行者",
          "text": "（莱纳德，你的心愿实现了吗？）"
        },
        {
          "role": "派蒙",
          "text": "好了，处理完陨石核心，睡着的人一定会慢慢醒来。"
        },
        {
          "role": "派蒙",
          "text": "我们也算是顺利完成了冒险家协会的委托吧！"
        },
        {
          "role": "旅行者",
          "text": "嗯，希望大家…早日恢复。"
        }
      ]
    }
  ]
}