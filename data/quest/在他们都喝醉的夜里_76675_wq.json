{
  "quest_id": 76675,
  "chapter_num": null,
  "chapter_title": "在他们都喝醉的夜里",
  "type": "wq",
  "route": "On This Intoxicating Night",
  "stories": [
    {
      "story_id": 76675,
      "title": "在他们都喝醉的夜里",
      "description": "西风骑士团的远征军们，似乎在期待着什么…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "在西风戍垒与法尔伽对话"
        },
        {
          "role": "法尔伽",
          "text": "…北方有[[纳尼娜]]看着，东边就让[[洛朗]]去吧…嗯，就先这样。"
        },
        {
          "role": "派蒙",
          "text": "你好呀，法尔伽！"
        },
        {
          "role": "法尔伽",
          "text": "哦？荣誉骑士和派蒙？怎么逛到这营地来了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "到处转着转着就遇上了…",
              "dialogues": []
            },
            {
              "text": "打扰到你们了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "没有的事，西风骑士团的营地，就是荣誉骑士的营地，你直接把这儿当成家就好。"
        },
        {
          "role": "法尔伽",
          "text": "不过下次过来也可以提前打声招呼，我好让后勤班多准备点好酒好菜来招待你。"
        },
        {
          "role": "派蒙",
          "text": "这里就是远征军的营地吗，人比想象的要少欸…"
        },
        {
          "role": "法尔伽",
          "text": "远征军里留在这的人不多。剩下的人也被分配到各处巡逻，要说的话…呵，确实有点冷清。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "剩下的人都在做什么？",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务：空月之歌·第四幕「回望湮灭的月光」"
        },
        {
          "role": "法尔伽",
          "text": "收集跟深渊相关的各项情报，当然，目前主要是在应付狂猎。"
        },
        {
          "type": "subtitle",
          "text": "完成魔神任务：空月之歌·第四幕「回望湮灭的月光」"
        },
        {
          "role": "法尔伽",
          "text": "收集挪德卡莱各地的情报。虽然雷利尔已经被封印了，但这里的风波还没有彻底平息。"
        },
        {
          "type": "subtitle",
          "text": "完成魔神任务：空月之歌·第八幕「真实之月」"
        },
        {
          "role": "法尔伽",
          "text": "收集跟深渊相关的各项情报。虽然挪德卡莱暂时安稳了些，但还是得警惕深渊卷土重来。"
        },
        {
          "role": "法尔伽",
          "text": "情报是行军的基础，不只是敌人的动向，还有地理环境、天气变化，都能成为左右战局的胜负手。"
        },
        {
          "role": "法尔伽",
          "text": "往后西风骑士团还打算跟北大陆情报网建立长期合作，把这个临时驻地变成一个情报站点。"
        },
        {
          "role": "派蒙",
          "text": "情、情报站点？难道是枫丹谍战小说里的那种…"
        },
        {
          "role": "法尔伽",
          "text": "哈哈，怎么可能呢！你在那种书里见过这么不设防的营地吗？"
        },
        {
          "role": "法尔伽",
          "text": "这些年里我们一路远征，发现提瓦特各地都出现过不同的深渊灾害。它们狡猾异常、形态多变。"
        },
        {
          "role": "法尔伽",
          "text": "我希望通过北大陆情报网把远征军的见闻分享出去，也希望继续借此收集深渊的资料。"
        },
        {
          "role": "法尔伽",
          "text": "对抗深渊可不是一国一家的事。每天都有无数阵风吹进吹出的挪德卡莱…应该是最适合设立这站点的地方吧。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样…这就是「骑士精神」吧！"
        },
        {
          "role": "法尔伽",
          "text": "「精神」是挺好，但现实嘛…现在这个站点才刚建立没多久，连周边的地形情报都还不完整。"
        },
        {
          "role": "法尔伽",
          "text": "旅行者，你要是在附近收集到建材、情报什么的，也记得顺手带些回来？"
        },
        {
          "role": "法尔伽",
          "text": "放心，西风骑士团绝对不会亏待自家的「荣誉骑士」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "包在我身上！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "呵，又是一场新的「远征」啊。"
        },
        {
          "role": "温弗里德",
          "text": "大——大团长！不好了大团长！"
        },
        {
          "role": "法尔伽",
          "text": "嗯？什么情况？"
        },
        {
          "role": "温弗里德",
          "text": "今天预定要来的那位客人…被困在山下了！"
        },
        {
          "role": "法尔伽",
          "text": "什么！难道是…那位客人？"
        },
        {
          "role": "温弗里德",
          "text": "对！就是他！我们的人手都还在其他地方巡逻，现在该从哪里调派…"
        },
        {
          "role": "法尔伽",
          "text": "——不用调人了！你指个路，我亲自去！两位，我们回头再见！"
        },
        {
          "type": "subtitle",
          "text": "法尔伽风风火火地离开了…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "…呜哇，头一次见法尔伽这么紧张…那位客人究竟是什么来头？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道是…重要线人？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "感觉有可能！我们也跟上去帮把手吧！"
        },
        {
          "type": "subtitle",
          "text": "前往寻找「重要人物」"
        },
        {
          "role": "重要线人？",
          "text": "救——救命啊！"
        },
        {
          "type": "subtitle",
          "text": "为「重要人物」解围"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|生物|苍绒狼}} × 3",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "查看「重要人物」的情况"
        },
        {
          "role": "派蒙",
          "text": "——嘿，你没事吧？"
        },
        {
          "role": "杜纳塔斯",
          "text": "没、没事…呼，还好你们来得及时，要不然就真赶不上日落了。"
        },
        {
          "role": "法尔伽",
          "text": "…万幸，看起来我们的「重要物资」没出什么大事。"
        },
        {
          "role": "派蒙",
          "text": "呃，是什么物资这么重要…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这就是酒吧。",
              "dialogues": []
            },
            {
              "text": "怎么闻都是酒吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "好眼光——这是我们从晨曦酒庄专门订购的蒲公英酒！最纯正的蒙德风味！"
        },
        {
          "role": "杜纳塔斯",
          "text": "一路从蒙德运过来，可费了我们好大的劲呢。"
        },
        {
          "role": "法尔伽",
          "text": "哈哈，辛苦了老板！晚上的酒会，你也来喝一杯吧？我们可都盼着你来呢！"
        },
        {
          "role": "派蒙",
          "text": "…所以你之前这么着急，就只是为了赶晚上的酒会？难得看你正经一次，居然还是为了这么不正经的事…"
        },
        {
          "role": "法尔伽",
          "text": "嗯？喝酒不就是一等一的正经事吗？我都想现在就来上一杯了。"
        },
        {
          "role": "杜纳塔斯",
          "text": "等、等一等——现在恐怕不太方便！"
        },
        {
          "role": "派蒙",
          "text": "是啊是啊，起码先干正事…"
        },
        {
          "role": "杜纳塔斯",
          "text": "这酒是特殊定制的，需要长时间滚动防止沉淀来保持口感！现在静置了这么久，估计口感…起码打了九折！"
        },
        {
          "role": "法尔伽",
          "text": "九折？可恶！那可绝对不能现在喝了。"
        },
        {
          "role": "派蒙",
          "text": "…行吧，你们高兴就好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要怎么恢复口感？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "杜纳塔斯",
          "text": "我们原本专门找人造了滚动酒桶的机关…不过刚刚像是摔坏了，现在么…估计只能靠人力让它滚起来了吧。"
        },
        {
          "role": "法尔伽",
          "text": "唔，所以是要{{颜色|蓝|持续打击木桶，让它滚动到目的地}}吗…听起来很像西风骑士团的传统力量训练啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "西风骑士团还有这训练项目？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "嗯，这种训练既要控制出手的力度，又要控制打击的角度，提防木桶偏离路线。是许多骑士的入门训练。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来还有点意思。",
              "dialogues": []
            },
            {
              "text": "荣誉骑士也想试试。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "哦？「荣誉骑士」也会对骑士团的基础训练感兴趣吗？嗯…离洛朗他们回营也还有一点时间。"
        },
        {
          "role": "法尔伽",
          "text": "那就交给你了，荣誉骑士。放心，要是一不小心把酒桶滚得太远就跟我说一声，我来帮你扔回原位。"
        },
        {
          "type": "subtitle",
          "text": "运送酒桶"
        },
        {
          "type": "subtitle",
          "text": "玩法教学"
        },
        {
          "role": "[[文件",
          "text": "教程：运送酒桶·1.png|500px|center]]"
        },
        {
          "type": "subtitle",
          "text": "使用普通攻击与重击击打酒桶时，可以令其往攻击方向滚动。\n若不慎使酒桶过度偏离方向，可以同法尔伽交谈，请他帮忙复位。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "酒桶偏离道路时"
        },
        {
          "role": "法尔伽",
          "text": "嗯…是不是不太顺利？头一次上手难免出错，需要帮忙的话尽管说一声。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（法尔伽）"
        },
        {
          "role": "法尔伽",
          "text": "嗯？需要我帮你把酒桶复位吗？还是想要闲聊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请帮忙复位…",
              "dialogues": [
                {
                  "role": "法尔伽",
                  "text": "好嘞，别放弃，再来一次！"
                }
              ]
            },
            {
              "text": "想聊会天…",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "第一段路"
                },
                {
                  "role": "法尔伽",
                  "text": "之前教导诺艾尔的时候，她一紧张就会把木桶打碎一地，然后说什么也要独自打扫干净。"
                },
                {
                  "role": "法尔伽",
                  "text": "时间一久…她打扫清理的本领，就冠绝整个骑士团了。呵，虽然她本人也没意识到，这其实也是一种「进步」。"
                },
                {
                  "type": "subtitle",
                  "text": "第二段路"
                },
                {
                  "role": "法尔伽",
                  "text": "头一次让雷泽尝试这项训练的时候，他花了整整一天才完成。你猜是为什么？"
                },
                {
                  "role": "法尔伽",
                  "text": "——其中有四分之一天用来移动木桶，四分之三天用来理解我在说什么。"
                },
                {
                  "type": "subtitle",
                  "text": "第三段路"
                },
                {
                  "role": "法尔伽",
                  "text": "关于「火花骑士」需不需要参与这些基础训练，琴和阿贝多曾经认真找我讨论过。"
                },
                {
                  "role": "法尔伽",
                  "text": "基本的骑士训练有助于培养品性…但「火花骑士」毕竟年纪尚小…所以我决定听取她本人的意见。"
                },
                {
                  "role": "法尔伽",
                  "text": "…于是她开开心心地带着炸弹去了训练场。结果我们一致同意，在她稍微再长大一点之前，不再讨论这个议题。"
                },
                {
                  "type": "subtitle",
                  "text": "第四段路"
                },
                {
                  "role": "法尔伽",
                  "text": "说起来，你应该还没见过洛恩吧？那小子我行我素惯了，到了训练的日子也不见人影。"
                },
                {
                  "role": "法尔伽",
                  "text": "后来一问，他说自己跑去捅魔物的老巢了，至于木桶训练嘛…不会还手的目标，他没兴趣。"
                }
              ]
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "之前教导诺艾尔的时候，她一紧张就会把木桶打碎一地，然后说什么也要独自打扫干净。"
        },
        {
          "role": "法尔伽",
          "text": "时间一久…她打扫清理的本领，就冠绝整个骑士团了。呵，虽然她本人也没意识到，这其实也是一种「进步」。"
        },
        {
          "role": "法尔伽",
          "text": "头一次让雷泽尝试这项训练的时候，他花了整整一天才完成。你猜是为什么？"
        },
        {
          "role": "法尔伽",
          "text": "——其中有四分之一天用来移动木桶，四分之三天用来理解我在说什么。"
        },
        {
          "role": "法尔伽",
          "text": "关于「火花骑士」需不需要参与这些基础训练，琴和阿贝多曾经认真找我讨论过。"
        },
        {
          "role": "法尔伽",
          "text": "基本的骑士训练有助于培养品性…但「火花骑士」毕竟年纪尚小…所以我决定听取她本人的意见。"
        },
        {
          "role": "法尔伽",
          "text": "…于是她开开心心地带着炸弹去了训练场。结果我们一致同意，在她稍微再长大一点之前，不再讨论这个议题。"
        },
        {
          "role": "法尔伽",
          "text": "说起来，你应该还没见过洛恩吧？那小子我行我素惯了，到了训练的日子也不见人影。"
        },
        {
          "role": "法尔伽",
          "text": "后来一问，他说自己跑去捅魔物的老巢了，至于木桶训练嘛…不会还手的目标，他没兴趣。"
        },
        {
          "role": "派蒙",
          "text": "好累…光是看你打就觉得手都酸了，有没有什么偷懒的法子？"
        },
        {
          "type": "subtitle",
          "text": "使用獭懒羊撞击酒桶时"
        },
        {
          "role": "法尔伽",
          "text": "居然是用这种方式解决的吗！嗯…不赖，智慧也是力量的一种。"
        },
        {
          "type": "subtitle",
          "text": "与骑士们交谈"
        },
        {
          "role": "温弗里德",
          "text": "啊！大团长！荣誉骑士！他们回来了——"
        },
        {
          "role": "艾克贝特",
          "text": "回来了——他们回来了——大家！快来迎接！"
        },
        {
          "role": "派蒙",
          "text": "哇呜，居然这么受欢迎…还真有点不好意思呢。"
        },
        {
          "role": "莱夫赫姆",
          "text": "——我隔着几百米就从风里闻出来了！是蒲公英酒的味道！"
        },
        {
          "role": "温弗里德",
          "text": "还是晨曦酒庄出产的特制品！回来了…我的回忆…全都回来了！"
        },
        {
          "role": "派蒙",
          "text": "呃…所以你们迎接的对象不是我们吧…"
        },
        {
          "role": "艾克贝特",
          "text": "嗯…就是这个味道…跟记忆里的一模一样！"
        },
        {
          "role": "莱夫赫姆",
          "text": "真好啊，这么多年了…"
        },
        {
          "role": "温弗里德",
          "text": "我还以为，自己已经忘记晨曦酒庄的酒是什么味道的了。"
        },
        {
          "role": "艾克贝特",
          "text": "酒的味道没变…那清泉镇的老家，应该也什么都没变吧？应该…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            },
            {
              "text": "是的，我去过。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾克贝特",
          "text": "…谢谢你，荣誉骑士！"
        },
        {
          "role": "法尔伽",
          "text": "…好了，别那么激动，还有人没回营吧？等人齐了再开封。你们先去做酒会的准备吧。"
        },
        {
          "role": "温弗里德",
          "text": "是！我们这就去准备！"
        },
        {
          "role": "法尔伽",
          "text": "…看，我说过的吧：喝酒可是一等一的正经事。"
        },
        {
          "role": "派蒙",
          "text": "呜呜…蜜酱胡萝卜煎肉…甜甜花酿鸡…居然能在这吃到这么正宗的蒙德菜…"
        },
        {
          "role": "派蒙",
          "text": "咦…法尔伽呢？好像没看到他？总不能是在哪个角落里喝到醉了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "以他的酒量没可能吧？",
              "dialogues": []
            },
            {
              "text": "我去找找，你接着吃。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好…我再吃完一盘就去找你！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（派蒙）"
        },
        {
          "role": "派蒙",
          "text": "再吃一盘…最后一盘！"
        },
        {
          "type": "subtitle",
          "text": "寻找法尔伽"
        },
        {
          "role": "法尔伽",
          "text": "为大家带回美酒的「主角」，怎么跑到这角落里来了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我倒想问你呢？",
              "dialogues": []
            },
            {
              "text": "怎么一个人喝酒？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "嗯…其实我杯里的是「特制品」中的「特制品」，只能一个人喝…"
        },
        {
          "role": "法尔伽",
          "text": "——不过被你发现就没办法了，就分你一杯吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…我就知道。",
              "dialogues": []
            },
            {
              "text": "果然是苹果酿。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "抱歉啦，开个玩笑！我身边现在是一滴酒都没有。你要是想喝的话，回头可以去找[[欧蜜涅]]，她那边管够。"
        },
        {
          "role": "法尔伽",
          "text": "一个营地里总得留下一个没醉的人，来看住喝醉的同伴跟夜里的危险——这是我在远征之初就立下的规矩。"
        },
        {
          "role": "法尔伽",
          "text": "真不凑巧啊，今天刚刚好轮到我来当这个不能醉的人。"
        },
        {
          "role": "法尔伽",
          "text": "…所以在他们都喝醉的夜里，我是不能醉的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真就刚刚好这么巧？",
              "dialogues": []
            },
            {
              "text": "在蒲公英酒送到的这天？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "谁知道呢？没准命运就是这么喜欢捉弄人？要是晚个一天到，说不定就轮着我在下面畅饮了？"
        },
        {
          "role": "法尔伽",
          "text": "但要是晚个一天，没准你就不会凑巧来到这个营地，也不会凑巧赶上我们的酒会，更没机会像现在这样对话。"
        },
        {
          "role": "法尔伽",
          "text": "什么样的选择会引向什么样的结果，在时候到来之前，谁都说不准。"
        },
        {
          "role": "法尔伽",
          "text": "就像我决定从蒙德出发远征的时候，也没想到会一路走到今天。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "发起远征的目的…是狂猎吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "嗯…从结果来说，确实如此。但在出发的时候，我只「知道」会有一场席卷提瓦特的深渊灾厄正在北方酝酿。"
        },
        {
          "role": "法尔伽",
          "text": "我们也用了些时间来动员筹备…但敌人会在哪里、以什么形式出现？"
        },
        {
          "role": "法尔伽",
          "text": "…这些对出发时的我们而言依旧是未知。只能一路收集情报，做好任何可能用得上的准备。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只有这点情报就发起远征了？",
              "dialogues": []
            },
            {
              "text": "不是说情报是行军的基础吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "呵，学得很快嘛！但很可惜，敌人可不会乖乖等着我们准备万全。"
        },
        {
          "role": "法尔伽",
          "text": "在我们犹犹豫豫的时候，深渊也正戕害无数人的性命。早一刻出征，就能早一刻改变他们的命运。"
        },
        {
          "role": "法尔伽",
          "text": "——光是知道这条情报，就足够支撑我们发起这场「远征」了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不愧是「北风骑士」…",
              "dialogues": []
            },
            {
              "text": "不愧是「西风骑士团」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "别那么见外，「荣誉骑士」！你不是也一样吗？你的旅途同样改变了许多人的命运。"
        },
        {
          "role": "法尔伽",
          "text": "无论是从前的蒙德、特瓦林…还是如今的挪德卡莱、远征军…还有我。"
        },
        {
          "role": "法尔伽",
          "text": "现在能围着篝火唱着诗歌，喝着美酒畅想未来…都离不开旅行者，你的出现。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…我真有那么厉害吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "…哈哈，谁又能说得清呢？毕竟命运就是这么捉摸不定的东西。但只要还活着，就总还有希望。"
        },
        {
          "role": "法尔伽",
          "text": "今晚喝不上的酒，明天也能喝——他们会记得帮我留上一杯的。只要还活着，就有美酒和朋友在明天等着！"
        },
        {
          "role": "法尔伽",
          "text": "所以，旅行者，干了这一杯！敬明天！敬希望！"
        },
        {
          "type": "subtitle",
          "text": "解锁功能「共建聚所·西风戍垒」",
          "narration": true,
          "color": "描述"
        }
