{
  "quest_id": 10181,
  "chapter_num": "谐律上的咏叙诗·第三章",
  "chapter_title": "法沙利亚狂想曲",
  "type": "wq",
  "route": "Pharsalia's Rhapsody",
  "stories": [
    {
      "story_id": 74194,
      "title": "通往卡皮托林的阶梯",
      "description": "穿过危险的海沟，终于到达了古代雷穆利亚沉没的王城。接下来便要前往「黄金宫殿」，与波爱修斯一决高下…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "继续前进"
        },
        {
          "type": "subtitle",
          "text": "与斯库拉对话"
        },
        {
          "role": "派蒙",
          "text": "呼，终于，我们总算是到了！"
        },
        {
          "role": "派蒙",
          "text": "那就是黄金宫殿嘛，看起来像是个巨大的管风琴啊，你们的至尊为什么会把宫殿修成这样呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看起来保存得相当完好。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是喔，和在上面见到的景象完全不同。"
                }
              ]
            },
            {
              "text": "和上面完全不同。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "确实呢，就像是刚刚才被水淹没的一样。"
                }
              ]
            }
          ]
        },
        {
          "role": "呜斯先生",
          "text": "当然是因为这座由巨船改造而来的宫殿，设计上就是用来演奏大乐章的巨大乐器啊。"
        },
        {
          "role": "呜斯先生",
          "text": "看到从那里延伸出来的水道了吗？虽然现在已经破碎了，但是过去至尊的乐章就是从这里传播到全地的。"
        },
        {
          "role": "派蒙",
          "text": "居然是乐器？！那整座宫殿？"
        },
        {
          "role": "派蒙",
          "text": "呜啊…那它演奏的时候，岂不是整片水域都会振动？如果靠太近，说不定我会像豆腐一样被震散啦…"
        },
        {
          "role": "呜斯先生",
          "text": "喵喵？豆腐是什么？"
        },
        {
          "role": "派蒙",
          "text": "欸？呜斯先生没吃过吗，那要解释起来有点困难…有机会下次带你去吃好啦，不过猫的话能吃豆腐吗？"
        },
        {
          "role": "斯库拉",
          "text": "不愧是「永恒之城」…果然，雷穆斯，他的意志还在保护着这里。难怪那无耻叛徒能够苟延残喘至今…"
        },
        {
          "role": "呜斯先生",
          "text": "哼，想必波爱修斯就是在那宫殿里面蛰伏了数千年，这才逃过了时间的磨损吧。"
        },
        {
          "role": "呜斯先生",
          "text": "然后在此期间，一点点掌握了「福波斯」的力量…"
        },
        {
          "role": "派蒙",
          "text": "好不容易到了这里，我们也该去会会那个没礼貌的家伙了，说不定他看到我们全来了会大吃一惊呢！"
        },
        {
          "role": "斯库拉",
          "text": "那我们就暂别吧。"
        },
        {
          "role": "派蒙",
          "text": "欸？你不和我们一起去吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你该不会是害怕了吧？",
              "dialogues": [
                {
                  "role": "斯库拉",
                  "text": "你怎么会这样想，老夫是实在不想再见到那个家伙了。"
                }
              ]
            },
            {
              "text": "已经帮了很大忙了。",
              "dialogues": [
                {
                  "role": "斯库拉",
                  "text": "哈哈，老夫自己也甚是畅快呢！但老夫可实在不想再见到那个家伙了。"
                }
              ]
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "那个妖鬼说的话我一句都不想再听到，全都是骗人的鬼话，可耻的谎言，你们也要小心别上那个家伙的当了！"
        },
        {
          "role": "斯库拉",
          "text": "再说就算和你们一起，老夫也帮不上什么忙，现在的我只是暂时寄宿在这个由灵露构成的躯体当中。"
        },
        {
          "role": "斯库拉",
          "text": "真要打起来，老夫也没有任何还手之力…"
        },
        {
          "role": "斯库拉",
          "text": "老夫自己倒是没什么要紧，但是雷穆斯所交给我的「乐章」，要是因此被他夺走了，那可就得不偿失了。"
        },
        {
          "role": "斯库拉",
          "text": "我们就暂时在这里分开吧，虽说帮不上什么忙，但用水流送你们一程还是做得到的，需要的话就来找老夫吧。"
        },
        {
          "role": "斯库拉",
          "text": "无论如何，等你们打败了那个叛徒，我们还会见面的。"
        },
        {
          "role": "斯库拉",
          "text": "到那个时候，或许老夫也终于能有机会弥补当初的遗憾了。"
        },
        {
          "type": "subtitle",
          "text": "玩法教学（龙裔的亲王·斯库拉）"
        },
        {
          "type": "subtitle",
          "text": "斯库拉是在遥远的过去统领龙裔的亲王，虽然已经失去了肉身但仍然有着操纵水流的力量。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在靠近他一定范围内，可以召唤出高速的水流移动到他身边；与其交互，则可令他召唤激流，将角色送往目标位置。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在考虑要前往何处时，瞄准特定物件，他或许还会有其它的话想说…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "斯库拉会在深海中四处巡游。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "在探索旧日之海时，斯库拉会依据角色所在的海域进行移动。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "额外对话（斯库拉）"
        },
        {
          "role": "斯库拉",
          "text": "旅行者，你也要小心别上那个家伙的当了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你真的不和我们一起…",
              "dialogues": [
                {
                  "role": "斯库拉",
                  "text": "现在老夫也帮不上什么忙…等你们打败了那个叛徒，再来找老夫吧。"
                },
                {
                  "role": "斯库拉",
                  "text": "到那个时候，或许老夫也终于能够弥补当初的遗憾了。"
                }
              ]
            },
            {
              "text": "没事了。",
              "dialogues": [
                {
                  "role": "斯库拉",
                  "text": "嗯，等你们打败了那个叛徒之后再来找老夫吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（呜斯先生）妙音花旁"
        },
        {
          "role": "呜斯先生",
          "text": "感觉要是把这些妙音花的节奏调整一致，说不定会有什么好事发生呢…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（呜斯先生）壁画旁"
        },
        {
          "role": "呜斯先生",
          "text": "这里的壁画和褪色城堡里的一样都是利用「乐章」的力量绘制而成的…"
        },
        {
          "role": "呜斯先生",
          "text": "不过先别管这些了，还是先去找波爱修斯算账吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（呜斯先生）谐律院"
        },
        {
          "role": "呜斯先生",
          "text": "看起来这孩子是被那两条黄金鱼困在这里了啊…要是能想办法把它们引开的话…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（呜斯先生）卡皮托利姆·旧宫"
        },
        {
          "role": "呜斯先生",
          "text": "突然想起来，那时好像有位来自枫丹的使者，曾被波爱修斯关在这里的某处…"
        },
        {
          "type": "subtitle",
          "text": "前往「黄金宫殿」"
        },
        {
          "role": "波爱修斯",
          "text": "卡西奥多，我的挚友，我就知道你会来。"
        },
        {
          "role": "呜斯先生",
          "text": "……"
        },
        {
          "role": "波爱修斯",
          "text": "啊，还有不请自来的蛮族…"
        },
        {
          "role": "派蒙",
          "text": "说到底，你根本不算是这里的主人呀。再说了，是呜斯先生带我们来到这里的，所以我们其实也不算不请自来吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "相比之下还是你比较无礼。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对呀！而且我们都听说了！你做过的那些坏事…"
        },
        {
          "role": "波爱修斯",
          "text": "聒噪的蝼蚁…不要打扰我和卡西奥多之间的谈话！"
        },
        {
          "role": "呜斯先生",
          "text": "旅行者，派蒙，这里就先交给我吧。"
        },
        {
          "role": "呜斯先生",
          "text": "波爱修斯，既然我已依约前来，你也应当信守承诺释放地上之人的灵魂。"
        },
        {
          "role": "呜斯先生",
          "text": "他们不应遭受这样的无妄之灾…而你我之间的仇怨就留给我们两人吧。"
        },
        {
          "role": "波爱修斯",
          "text": "你竟然称之为无妄之灾？"
        },
        {
          "role": "波爱修斯",
          "text": "难道你没有见到我们的那些同族吗？被禁锢在这无光的深水之下，如同行尸走肉一般！"
        },
        {
          "role": "波爱修斯",
          "text": "他们难道就不应该生活在阳光之下的土地上吗？"
        },
        {
          "role": "波爱修斯",
          "text": "若说我将地上之人的灵魂暂时囚禁于此乃是无妄之灾，那我们的同族数千年以来所承受的那些苦难又算是什么？"
        },
        {
          "role": "波爱修斯",
          "text": "听好了，地上之人所要遭受的惩罚才刚刚开始！"
        },
        {
          "role": "呜斯先生",
          "text": "不，禁锢了他们的是你，把我们的同族变成怪物的也是你。"
        },
        {
          "role": "呜斯先生",
          "text": "他们…我们曾经有过选择，只要我们摒弃旧日的仇怨，水的主人答应过接纳我们进入新的国度。"
        },
        {
          "role": "呜斯先生",
          "text": "而你却利用了他们，利用了他们的痛苦，利用了他们对你的信任，把他们变成了实现你野心的工具。"
        },
        {
          "role": "波爱修斯",
          "text": "那是他们的选择，他们选择了旧日的秩序，而不是你所带来的，甜蜜的死亡。"
        },
        {
          "role": "波爱修斯",
          "text": "就像他们当初把至尊赐予他们的指挥棒交给了我们一样，我们有责任引导他们走上正确的道路。"
        },
        {
          "role": "呜斯先生",
          "text": "你这个厚颜无耻的叛徒，背叛了至尊的信任，致使国家灭亡的罪魁祸首，居然还有脸这样大言不惭！"
        },
        {
          "role": "波爱修斯",
          "text": "哈！想必是你听信了那恶龙的谗言，比起你的同族和战友，你却宁愿相信国家的仇敌！"
        },
        {
          "role": "波爱修斯",
          "text": "我效忠的是伟大的雷穆利亚，是我们高贵的理想，而不是某个神，某个王。"
        },
        {
          "role": "波爱修斯",
          "text": "从雷穆斯下达了那条悖逆命令的那一刻起，他就不配被称为至尊了，因此，也就没有什么背叛。相反，我从他的错误中拯救了国家。"
        },
        {
          "role": "波爱修斯",
          "text": "他勾结了国家的敌人，命令恶龙夷平我们的城市，甚至试图毁掉大乐章，让人们重回「法图纳」的桎梏之下。"
        },
        {
          "role": "波爱修斯",
          "text": "面对他这样疯狂的行径，我们怎么可能无动于衷？"
        },
        {
          "role": "呜斯先生",
          "text": "于是你背叛了至尊，关闭了雅努斯之门…最后「福波斯」的力量失控，整个王城才坠入了水下…"
        },
        {
          "role": "波爱修斯",
          "text": "你还不肯睁开眼睛好好看看事实吗？是雷穆斯背叛了我们，背叛了「福波斯」，这才是悲剧的序章。"
        },
        {
          "role": "波爱修斯",
          "text": "而我为了重现过去的乐章，在这深海之中苦苦编织破碎的旋律，光是这样就耗费了数千年。"
        },
        {
          "role": "呜斯先生",
          "text": "不对…乐章在你的手上变得刺耳，那些充满痛苦与仇恨的不和谐音都在控诉你的暴行。"
        },
        {
          "role": "波爱修斯",
          "text": "呵，可曲调的和谐与否又是由谁来决定的？难道不是绝对的力量吗？雷穆斯正因未能参透这一点，才向蛮族与恶龙屈膝。"
        },
        {
          "role": "波爱修斯",
          "text": "不过已经无所谓了。因为如今颠倒的世界就要被纠正，而我将成为新的至尊！"
        },
        {
          "role": "呜斯先生",
          "text": "这不可能，波爱修斯，你只是个凡人！凡人是不可能成为神明的…"
        },
        {
          "role": "波爱修斯",
          "text": "你忘了吗，卡西奥多？雷穆斯的理想，不就是让所有人都成为「神」，并掌握自己的命运吗？"
        },
        {
          "role": "波爱修斯",
          "text": "你不记得了吗？我们在黄金城堡中研究并记录的那些术式，它们所导向的终点，不也正是如此吗？"
        },
        {
          "role": "呜斯先生",
          "text": "不，但是我们并不知道终点之后究竟有些什么，如果知道的话，在数千年前就已经…"
        },
        {
          "role": "波爱修斯",
          "text": "时过境迁，现在情况不同了。卡西奥多，加入我吧，我已经准备好了，这是只有我们一起才能够完成的。"
        },
        {
          "role": "波爱修斯",
          "text": "我已分离掉灵魂中的一切杂质，取得真实的意志，距离踏上天梯也只有一步之遥。"
        },
        {
          "role": "波爱修斯",
          "text": "只要将分散在水中的全部意志汇聚为一，加上由雷穆斯亲手分离出的，你的灵魂。"
        },
        {
          "role": "波爱修斯",
          "text": "两种心智合二为一，雷穆利亚会再次成为一体！再灌入精钢与精石制成的不朽身躯。"
        },
        {
          "role": "波爱修斯",
          "text": "我…不，我们将会重新「受肉」，成为新的至尊…不止如此，我还会获得雷穆斯也未曾掌握的，动摇世界本质的力量。"
        },
        {
          "role": "波爱修斯",
          "text": "我将逆转命运的时轮，带回旧日的世界，使大地重归正义。而地上之人只能屈服于我们的意志。"
        },
        {
          "role": "波爱修斯",
          "text": "就如颂歌中所说的那样，「使意志发号施令，其余则俯首倾听。」"
        },
        {
          "role": "呜斯先生",
          "text": "你知道我不会认同你的，你玷污了至尊的理想。"
        },
        {
          "role": "呜斯先生",
          "text": "而我会践行自己的正义。"
        },
        {
          "role": "波爱修斯",
          "text": "无所谓，只要进入了「福波斯」的旋律中，你自然便会理解然后加入我的。"
        },
        {
          "type": "subtitle",
          "text": "波爱修斯抬手，呜斯先生被乐章的力量笼罩。情急之下，你冲上前去…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "探索神秘空间"
        },
        {
          "role": "旅行者",
          "text": "（这里是…黄金的宫殿。）"
        },
        {
          "role": "旅行者",
          "text": "（我又进到雷穆斯的记忆当中了吗？）"
        },
        {
          "role": "旅行者",
          "text": "（但是氛围…与之前不同。）"
        },
        {
          "role": "波爱修斯",
          "text": "欢迎来到我的宫殿，我的乐章，异邦人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "波爱修斯？！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "波爱修斯",
          "text": "何必这样惊讶，我们不是已经见过很多次了么。"
        },
        {
          "role": "波爱修斯",
          "text": "不论是我留在真实世界中的幻影，还是在雷穆斯留下的记忆宫殿当中。"
        },
        {
          "role": "波爱修斯",
          "text": "不过这里并非是雷穆斯的记忆所产生的幻景，而是属于我的「乐章」，我的金色舞台。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "果然…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里充满了痛苦的哀鸣…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "波爱修斯",
          "text": "是吗，异邦人，我不知道你从何而来…"
        },
        {
          "role": "波爱修斯",
          "text": "看起来你不是从原初之海诞生的人类，甚至也不像是来自地上的生灵。"
        },
        {
          "role": "波爱修斯",
          "text": "我看不见你灵魂的成色，也无法触碰它。"
        },
        {
          "role": "波爱修斯",
          "text": "无论如何，这并非你的战争，我与地上之人的仇怨也与你无关。"
        },
        {
          "role": "波爱修斯",
          "text": "我不知道你为什么要阻碍我们的事业。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为了呜斯先生…",
              "dialogues": [
                {
                  "role": "波爱修斯",
                  "text": "你们短暂的友谊能胜过我们同族亲缘的份量吗？"
                },
                {
                  "role": "波爱修斯",
                  "text": "我和卡西奥多…我们是雷穆斯亲手所造的新人（魔像），也是如今仅存的孑遗。"
                },
                {
                  "role": "波爱修斯",
                  "text": "与其他同族相比，他的灵魂就如同无法融入水中的灵露。"
                },
                {
                  "role": "波爱修斯",
                  "text": "除我以外，只有他拥有真正的意志，也只有我们的结合才能达成完整的「自我」。"
                },
                {
                  "role": "波爱修斯",
                  "text": "「我们的意志乃是一体。」在歌剧的终幕，他会回到我们中间，这也是他的「命运」。"
                },
                {
                  "role": "波爱修斯",
                  "text": "异邦人，你还有什么话要说吗？{{#info:第三次选择选项时消失}}"
                }
              ]
            },
            {
              "text": "为了拯救佩特莉可镇的居民…",
              "dialogues": [
                {
                  "role": "波爱修斯",
                  "text": "那些人…他们并非是你的同胞，也不是你的臣民。"
                },
                {
                  "role": "波爱修斯",
                  "text": "相反，你的力量要远远强于他们，他们在你面前应该连蝼蚁都算不上。"
                },
                {
                  "role": "波爱修斯",
                  "text": "弱者应该屈服于强者，难道不是这个世界的公理吗？"
                },
                {
                  "role": "波爱修斯",
                  "text": "你却说要保护他们，这究竟是无疆的慈悲，还是单纯的愚蠢呢。"
                },
                {
                  "role": "波爱修斯",
                  "text": "异邦人，你还有什么话要说吗？{{#info:第三次选择选项时消失}}"
                }
              ]
            },
            {
              "text": "为了世界的正义…",
              "dialogues": [
                {
                  "role": "波爱修斯",
                  "text": "正义？你该不会是认真的吧？"
                },
                {
                  "role": "波爱修斯",
                  "text": "就算拥有连我也无法看透的力量，但你若是以为仅靠蛮力便能打败我，那可就是外乡人的天真了。"
                },
                {
                  "role": "波爱修斯",
                  "text": "我早已与充盈整个深海的「乐章」融为一体。即便你侥幸击毁了我的肉身，但只要苦痛的海水仍在流动，只要仇恨的记忆尚未泯灭…"
                },
                {
                  "role": "波爱修斯",
                  "text": "我的意志就不会消亡，我就仍然是整个现世的梦魇。"
                },
                {
                  "role": "波爱修斯",
                  "text": "除非你像卡西奥多…像那只野猫一样自我放逐，做看守旧日监牢的狱卒…但我想你这样的尊贵之人是不会做到这种程度的。"
                },
                {
                  "role": "波爱修斯",
                  "text": "放下你那多余的同情心吧！对于罪有应得的人而言，获得审判不才是正义吗？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "罪有应得…他们是无辜的。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "波爱修斯",
                  "text": "无辜？没有一个枫丹人是无辜的！他们都是曾与我们为敌的蛮族的后裔…"
                },
                {
                  "role": "波爱修斯",
                  "text": "他们的祖先夺走了本应属于我们的国家，他们当然也要为此付出代价，这就是他们的原罪！"
                },
                {
                  "role": "波爱修斯",
                  "text": "异邦人，你还有什么话要说吗？{{#info:第三次选择选项时消失}}"
                }
              ]
            }
          ]
        },
        {
          "role": "波爱修斯",
          "text": "无论如何，既然你执意要坏我的好事，那我也只能让你暂居在我的宫殿当中了。"
        },
        {
          "role": "波爱修斯",
          "text": "我无法困住你太久，不过这样也足够了。等我成为神明，登上至尊之位后，在新世界再见吧。"
        },
        {
          "role": "波爱修斯",
          "text": "在此之前，就先让我的乐队陪你打发会时间好了。"
        },
        {
          "type": "subtitle",
          "text": "击退魔像"
        },
        {
          "type": "subtitle",
          "text": "出现{{图标|魔像禁卫|3}}（可不击败）",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "何人的声音",
          "text": "旅行者，旅行者…"
        },
        {
          "role": "何人的声音",
          "text": "不要害怕，我会帮助你…"
        },
        {
          "type": "subtitle",
          "text": "探索神秘空间"
        },
        {
          "type": "subtitle",
          "text": "青色的旋律没入了魔像的身体，魔像们接连倒下…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "「████」",
          "text": "旅行者！终于找到你了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是…",
              "dialogues": [
                {
                  "role": "卡西奥多",
                  "text": "我是卡西奥多，你之前应该在至尊的记忆中见过我吧，不过以这种样子见面还是第一次。"
                }
              ]
            },
            {
              "text": "卡西奥多…",
              "dialogues": [
                {
                  "role": "卡西奥多",
                  "text": "没错，是我，你之前应该在至尊的记忆中见过我吧，不过以这种样子见面还是第一次。"
                }
              ]
            },
            {
              "text": "呜斯先生…",
              "dialogues": [
                {
                  "role": "卡西奥多",
                  "text": "哈哈，虽然你应该在至尊的记忆中见过我以前的样子，不过以这种形态见面还是第一次吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "卡西奥多",
          "text": "时间有限，身处于波爱修斯的乐章宫殿中，要维持这样的形体并不容易。"
        },
        {
          "role": "卡西奥多",
          "text": "我们还是尽量长话短说吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里到底是什么地方？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡西奥多",
          "text": "这里是波爱修斯，由他的灵魂具象化所产生的空间。"
        },
        {
          "role": "卡西奥多",
          "text": "与你之前曾经进入过的，至尊的记忆空间一样，都是因为乐章的力量才得以维持的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刚才…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡西奥多",
          "text": "刚才他利用乐章的力量，把我们拉入了这里。"
        },
        {
          "role": "卡西奥多",
          "text": "因为距离「福波斯」力量的中心，黄金宫殿太过接近，他的力量已经能够直接干涉现世了。"
        },
        {
          "role": "卡西奥多",
          "text": "如果真的让他获得了超越真实的力量，整个地上世界说不定都会被拉入这里。"
        },
        {
          "role": "卡西奥多",
          "text": "到时候，他的狂想将会取代真实的世界，如今的枫丹也会变回数千年前的样子。"
        },
        {
          "role": "卡西奥多",
          "text": "就像在佩特莉可镇发生的那样…不，甚至比那还要更糟。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他真的会成为神明吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡西奥多",
          "text": "这要看如何定义神明了，只是制造虚假的幻梦并不难做到。但如果想要超越命运的话，则绝无可能。"
        },
        {
          "role": "卡西奥多",
          "text": "如果真的有那么简单，我们在数千年前就已经成功了。"
        },
        {
          "role": "卡西奥多",
          "text": "他现在所能做的，不过是将更多无辜的人拉入他所制造的噩梦中，成为行尸走肉的傀儡罢了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "必须阻止他…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡西奥多",
          "text": "的确，但是在这里是无法做到的，你必须要回到真实的世界当中去。"
        },
        {
          "role": "卡西奥多",
          "text": "而我会协助你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡西奥多",
          "text": "不用担心，他暂时还不打算对我做什么。而且就在刚才，我已经想到了彻底消灭波爱修斯的办法。"
        },
        {
          "role": "卡西奥多",
          "text": "波爱修斯在真实的世界中为自己准备了一副强大的躯体，并且打算在黄金的宫殿当中进行「受肉」的仪式。"
        },
        {
          "role": "卡西奥多",
          "text": "只要能让他放下戒备，将分散在深水中的「乐章」汇聚在那一个身躯当中…"
        },
        {
          "role": "卡西奥多",
          "text": "再趁此机会，将他连同那个肉身彻底消灭…一切就都结束了。"
        },
        {
          "role": "卡西奥多",
          "text": "旅行者，这件事情只有你能做到。"
        },
        {
          "role": "卡西奥多",
          "text": "「福波斯」的乐章中没有你的命运，波爱修斯也无法干涉你的灵魂。"
        },
        {
          "role": "卡西奥多",
          "text": "你是一切计划中的例外，或许至尊的记忆将你引导到这里就是为了…"
        },
        {
          "role": "卡西奥多",
          "text": "快走吧，我的力量已经无法维持了。"
        },
        {
          "role": "卡西奥多",
          "text": "在真实的世界再见吧，或许这一次终于可以结束这漫长的噩梦了。"
        },
        {
          "type": "subtitle",
          "text": "与斯库拉对话"
        },
        {
          "role": "派蒙",
          "text": "呜啊，你终于醒过来了！"
        },
        {
          "role": "派蒙",
          "text": "我都要担心死了，我还以为…还以为你和镇上的大家一样，被那个家伙夺走灵魂了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我没事了，派蒙。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "呜呜，那真的是太好了！"
                },
                {
                  "role": "派蒙",
                  "text": "你晕过去之后，波爱修斯和呜斯先生也随着那阵音波一起消失了，就剩我一个人在这里…"
                }
              ]
            },
            {
              "text": "我是晕过去了吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对啊，你晕过去之后，波爱修斯和呜斯先生也随着那阵音波一起消失了，就剩我一个人在这里…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "后来大家伙也找过来了，虽然也没帮上什么忙…"
        },
        {
          "role": "斯库拉",
          "text": "这也是无可奈何之事，毕竟老夫现在只是寄宿在灵露当中的灵魂，就算雷穆斯那家伙把最后的「乐章」交给了老夫…"
        },
        {
          "role": "斯库拉",
          "text": "但要驱使「乐章」的力量对付波爱修斯，那又是另一回事了。"
        },
        {
          "role": "派蒙",
          "text": "虽然旅行者算是平安无事地醒过来了，但是呜斯先生去哪了啊，该不会是被那个家伙…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我见到他了。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "你将在波爱修斯的灵魂宫殿中发生的事情告诉了大家。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "欸？那呜斯先生就自己一个人留在那里了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他应该有自己的计划，别太担心了。",
              "dialogues": []
            },
            {
              "text": "的确令人担心…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "不管怎么说，按他的想法，我们还有击溃那个无耻妖鬼的机会。但前提是你们能够进入黄金宫殿…"
        },
        {
          "role": "派蒙",
          "text": "那大家伙你…"
        },
        {
          "role": "斯库拉",
          "text": "看老夫做什么。"
        },
        {
          "role": "派蒙",
          "text": "大家伙不是曾经率领大群龙蜥进攻雷穆利亚的王城吗？相比之下，送我们进入黄金宫殿应该轻松得多吧！"
        },
        {
          "role": "斯库拉",
          "text": "小东西个头小，心思倒是不少。但此事没有你想的这样容易。"
        },
        {
          "role": "斯库拉",
          "text": "我们龙裔的力量都来自于强大的肉体，而寄宿在灵露中的我，剩下的只有微不足道的精神力了。"
        },
        {
          "role": "斯库拉",
          "text": "击碎雅努斯之门已经几乎耗尽了我的精力，更何况黄金宫殿受到「乐章」力量的保护，与石头门不可同日而语。"
        },
        {
          "role": "派蒙",
          "text": "那样的话岂不是完蛋了！难道我们要眼睁睁地看着那个波爱修斯把呜斯先生吞掉吗！"
        },
        {
          "role": "斯库拉",
          "text": "真是急性子啊，小东西。老夫只是说自己无能为力，但你们并不是啊。"
        },
        {
          "role": "斯库拉",
          "text": "既然保护宫殿的是「乐章」的力量，那么能破除这保护的也必是「乐章」的力量。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可是我所掌握的「乐章」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对呀！保护宫殿的「乐章」…不是那个叫什么「福波斯」的超——厉害的家伙吗？我们要怎么赢过它…"
        },
        {
          "role": "斯库拉",
          "text": "赢不过的话，就从它那里借就好了！"
        },
        {
          "role": "斯库拉",
          "text": "在过去，「福波斯」的意志曾经随着金色的水道流淌进雷穆利亚的每一个角落。"
        },
        {
          "role": "斯库拉",
          "text": "虽然现在水道早已破碎，但如果能将眼前的这段水道重新连接起来的话…"
        },
        {
          "role": "斯库拉",
          "text": "黄金宫殿的大门也会像那时一样再度打开吧。毕竟，「乐章」上就是这样写的嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来值得一试。",
              "dialogues": []
            },
            {
              "text": "或许也别无他法了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "方才老夫在四处寻找雷穆斯留下的遗存时也发现了一些痕迹。还有未被那妖鬼所统合的「乐章」碎片散落在这片海域。"
        },
        {
          "role": "斯库拉",
          "text": "跟随老夫来吧，若能找到并利用它们的力量，或许就能逆转时光，重现水道旧日的模样。"
        },
        {
          "role": "派蒙",
          "text": "哦，感觉很有希望呢！既然如此，那我们就赶紧动身吧！"
        },
        {
          "type": "subtitle",
          "text": "修复金色水道"
        },
        {
          "type": "subtitle",
          "text": "跟随斯库拉，寻找修复金色水道的方法。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "额外对话（斯库拉）"
        },
        {
          "role": "斯库拉",
          "text": "若能利用这些散落的「乐章」力量，或许就能重现水道旧日的模样了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于散落的「乐章」…",
              "dialogues": [
                {
                  "role": "斯库拉",
                  "text": "嗯，你应该也见过这种以绘画的形式记录下来的「乐章」吧。"
                },
                {
                  "role": "斯库拉",
                  "text": "在过去，雷穆斯麾下的乐师们曾将这些旋律绘满在每一块巨岩与石壁之上。"
                },
                {
                  "role": "斯库拉",
                  "text": "但如今只有这些金蜂会听从「乐章」的召唤了。"
                }
              ]
            },
            {
              "text": "没事了。",
              "dialogues": [
                {
                  "role": "斯库拉",
                  "text": "嗯，先想办法修好水道吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "完成「重建金色水道·其之一」、「重建金色水道·其之二」后，任务推进到下一阶段",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往金色水道附近"
        },
        {
          "role": "派蒙",
          "text": "这样我们就算是把水道重新连接起来了吧！"
        },
        {
          "role": "派蒙",
          "text": "接下来就回去找大家伙吧。"
        },
        {
          "role": "派蒙",
          "text": "唔…也不知道呜斯先生怎么样了，我们得快点行动才行了！"
        },
        {
          "role": "派蒙",
          "text": "欸？旅行者，你怎么啦，该不会又被…"
        },
        {
          "type": "subtitle",
          "text": "与斯库拉对话"
        },
        {
          "type": "subtitle",
          "text": "「我做了一个梦，在那个梦里，就连凡人也能拥有自由的意志与未定的命运…哈，果然美妙的乐曲还真是够难写的啊…梦该醒了。」",
          "narration": true,
          "color": "描述1"
        },
        {
          "role": "斯库拉",
          "text": "雷穆斯，老夫必须提醒你…"
        },
        {
          "role": "斯库拉",
          "text": "在老夫看来，你的国家，你所编织的乐章，恐怕已经超出了你的控制。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "虽然老夫对众水的僭主所创造，你所抚育的这些生灵从未抱有过什么期待，但他们堕落的程度也实在让老夫惊讶。"
        },
        {
          "role": "斯库拉",
          "text": "你和你的臣民所创造出的文明，它的光辉超过地上曾有的一切，但如今却只剩下深不见底的黑暗。"
        },
        {
          "role": "斯库拉",
          "text": "以文明与秩序为名的暴行，甚至比纯粹的野蛮更加残酷。就连最为残暴的龙蜥，也不会进行这般毫无意义的杀戮。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这些我当然知道…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "你知道，但是你却无动于衷吗？又或者是无能为力？"
        },
        {
          "role": "斯库拉",
          "text": "不，只要你想的话，你能轻易地抹杀掉那些罪有应得的凡人，但是你却做不到。"
        },
        {
          "role": "斯库拉",
          "text": "因为你爱人类，这是你身为僭主所必须承受的诅咒。"
        },
        {
          "role": "斯库拉",
          "text": "到了老夫该离开的时候了…老夫不会帮助他们去杀戮那些无辜的凡人，但也无意阻止他们。"
        },
        {
          "role": "斯库拉",
          "text": "你曾经向众水的僭主许诺，要用她交给你的纯水，创造出一个没有纷争，永恒幸福的世界。"
        },
        {
          "role": "斯库拉",
          "text": "我也是因为想要看看那个未来，才会随你来到地上，但结果却是这样…你失败了，雷穆斯，你无法战胜「命运（法图纳）」。"
        },
        {
          "role": "斯库拉",
          "text": "鲜血将再度染红高海，高天对它的造物竟也如此残忍。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我有一个计划…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "哦？你总是有很多计划，雷穆斯。但现在你的计划已经全都搞砸了，你甚至都还没弄明白问题出在哪里。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你要听听吗，这是最后一个了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "我记得你说服我离开原海的时候也是这么说的…那你说吧，在我离开这里回到原海，回到众水的僭主身边之前。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（……）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "……"
        },
        {
          "role": "斯库拉",
          "text": "哈哈哈哈，有趣，太有趣了！"
        },
        {
          "role": "斯库拉",
          "text": "何等自私又何等无私的计划，也只有你才能想出这样的主意！"
        },
        {
          "role": "斯库拉",
          "text": "竟然将老夫也算计进去了，还真是恣意妄为啊，凡人的僭主。"
        },
        {
          "role": "斯库拉",
          "text": "不过，老夫很喜欢。"
        },
        {
          "role": "斯库拉",
          "text": "让老夫率领龙蜥一族，将你那傲慢而愚蠢的子民踩在脚下，想想就觉得畅快。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但这只是一个仪式，一场戏剧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "放心，老夫会像你说的那样，手下留情的。"
        },
        {
          "role": "斯库拉",
          "text": "但是如果这样做了，你作为魔神的生命也会到此结束。除了「乐章」之外，什么都不会留下，你考虑清楚了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当然。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我所开启的魔盒，也将由我来关闭。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "那就好，老夫接受你的提议。如果真的到了那个时候，老夫也会用老夫的力量，加上你的乐章一起…"
        },
        {
          "role": "斯库拉",
          "text": "砸碎「福波斯」的锁链，让你的子民重获自由。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那么，请接受…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我最后的，「乐章」吧。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "「竖琴筑起的城邦，又在簧管声中倾倒，上天为我们安排的，是好坏相抵的命运。」",
          "narration": true,
          "color": "描述1"
        },
        {
          "type": "subtitle",
          "text": "前往金色水道附近"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你又看到雷穆斯的记忆了吗？"
        },
        {
          "role": "派蒙",
          "text": "欸？这次不会又是那个没礼貌的大坏蛋吧？"
        },
        {
          "role": "派蒙",
          "text": "感觉就算是做梦，看见那个家伙也够晦气的了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我想我已经知道雷穆斯的计划了…",
              "dialogues": []
            },
            {
              "text": "必须要打碎「福波斯」才行…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为此，需要演奏斯库拉的乐章。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸？你怎么突然说起这个啦，你到底在记忆里看到什么了？"
        },
        {
          "role": "斯库拉",
          "text": "有趣，雷穆斯的力量还萦绕在深海当中尚未消散，而现在老夫也终于来到了这里，你知道这意味着什么吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "条件已经达成了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "不错，老夫也正是为了弥补这千年的憾事才会和你们一起来到这里的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "问题只剩下「福波斯」到底…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "等等，我都糊涂了！所以到底要用乐章干什么啊？你们两个倒是达成理解了，那现在岂不是只有我被排除在外？"
        },
        {
          "role": "派蒙",
          "text": "这太不公平了！快说给我听听！"
        },
        {
          "role": "斯库拉",
          "text": "雷穆斯，他所交给老夫的最后的「乐章」，也就是所谓「安魂曲」，是使「福波斯」自毁的命令。"
        },
        {
          "role": "斯库拉",
          "text": "他牺牲自己，释放了「乐章」的力量，再由老夫控制他所唤醒的原初的蛮荒之力。"
        },
        {
          "role": "斯库拉",
          "text": "这样便能将他的臣民们从那顽石的身躯中解放出来，使他们重获原本的血肉的身躯，消灭人为制造的种族隔阂。"
        },
        {
          "role": "斯库拉",
          "text": "他曾嘱咐老夫，切记不可将这个计划透露给他的臣民，因为唯有让他们认识到自己的局限，才能放下偏见与傲慢。"
        },
        {
          "role": "斯库拉",
          "text": "不过看起来，旅行者已经通过那家伙留下来的记忆拼出了计划的全貌。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样…可他的牺牲最后还是被浪费掉了…"
        },
        {
          "role": "斯库拉",
          "text": "但是既然老夫的灵魂已经重获自由，如今也终于有了弥补的机会。"
        },
        {
          "role": "斯库拉",
          "text": "现在，雷穆斯曾经的臣民，他们迷途的灵魂仍然被囚禁在雕像当中，如果能够打败那妖鬼…"
        },
        {
          "role": "斯库拉",
          "text": "借助「安魂曲」的力量，他们的灵魂将得到解放，回归高海与永恒不息的生死循环。"
        },
        {
          "role": "斯库拉",
          "text": "这样老夫也算完成了他的愿望了吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许这也是我来到这里的理由。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯库拉",
          "text": "这就是所谓的因缘际会吧，异邦人。"
        }
      ],
