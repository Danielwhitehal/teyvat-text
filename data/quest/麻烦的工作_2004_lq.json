                      ]
                    },
                    {
                      "text": "否",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "冰雾花",
              "dialogues": [
                {
                  "role": "唐娜",
                  "text": "冰雾花呀…在那边的角落里呢，千万不要直接用手拿哦，会冻伤的。"
                },
                {
                  "role": "唐娜",
                  "text": "你想选这个吗？嗯…有点稀奇的品味呢。"
                },
                {
                  "role": "唐娜",
                  "text": "只是丽莎小姐好像常用雷的元素力吧？不知道会不会有危险…"
                },
                {
                  "role": "派蒙",
                  "text": "确定选择{{颜色|蓝|「冰雾花」}}吗？选好可就{{颜色|蓝|不能改}}了哦！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "是",
                      "dialogues": [
                        {
                          "role": "丽莎",
                          "text": "嗯？满溢着冰元素的花吗，在我这里可是很危险的。"
                        },
                        {
                          "role": "丽莎",
                          "text": "雷元素和冰元素相遇的话会发生什么，你好像没有做好功课呢。"
                        },
                        {
                          "role": "丽莎",
                          "text": "工作结束后来图书馆，我给你做「元素体系」的特训吧，还是记不住的话就让你亲自尝尝「超导」的滋味哦。"
                        }
                      ]
                    },
                    {
                      "text": "否",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "蔷薇",
              "dialogues": [
                {
                  "role": "唐娜",
                  "text": "这蔷薇是前些日子从一个旅行商人那里买来的。"
                },
                {
                  "role": "唐娜",
                  "text": "店长说或许会有人喜欢的…仅此一束哦。"
                },
                {
                  "role": "派蒙",
                  "text": "确定选择{{颜色|蓝|「蔷薇」}}吗？选好可就{{颜色|蓝|不能改}}了哦！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "是",
                      "dialogues": [
                        {
                          "role": "丽莎",
                          "text": "嗯~看得出你很花心思了呢，还是说你有听过「蔷薇魔女」的名号？"
                        },
                        {
                          "role": "丽莎",
                          "text": "本以为回到蒙德就没机会再见到新鲜的蔷薇了…"
                        },
                        {
                          "role": "丽莎",
                          "text": "看来是个好兆头。"
                        }
                      ]
                    },
                    {
                      "text": "否",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "塞西莉亚",
              "dialogues": [
                {
                  "role": "唐娜",
                  "text": "塞西莉亚花呀，是店长推荐的吗？"
