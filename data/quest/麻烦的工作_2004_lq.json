                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "丽莎会喜欢什么花？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "芙萝拉",
                  "text": "「丽莎小姐会喜欢的花」吗？"
                },
                {
                  "role": "芙萝拉",
                  "text": "虽然没怎么和丽莎小姐来往，但一看上去就是很有气质的姐姐呢！"
                },
                {
                  "role": "芙萝拉",
                  "text": "嗯…嗯，对对…果然还是要{{颜色|蓝|「塞西莉亚花」}}！"
                }
              ]
            },
            {
              "text": "蒲公英",
              "dialogues": [
                {
                  "role": "唐娜",
                  "text": "蒲公英是店长芙萝拉小姐最喜欢的，也一直作为本店的特色。"
