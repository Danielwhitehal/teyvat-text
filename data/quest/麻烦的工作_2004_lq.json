{
  "quest_id": 2004,
  "chapter_num": "沙漏之章 第一幕",
  "chapter_title": "麻烦的工作",
  "type": "lq",
  "route": "Troublesome Work",
  "stories": [
    {
      "story_id": 10100,
      "title": "麻烦的工作",
      "description": "图书馆的管理员丽莎，似乎正在对工作上的一些事情感到恼火…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "去图书馆找丽莎"
        },
        {
          "type": "subtitle",
          "text": "与丽莎对话"
        },
        {
          "role": "丽莎",
          "text": "呵欠…借阅图书请自觉登记，禁书区书籍暂不外借…"
        },
        {
          "role": "丽莎",
          "text": "哦？原来是你啊，小可爱。"
        },
        {
          "role": "丽莎",
          "text": "能见到你真好，比午后的一杯浓茶更提神呢。"
        },
        {
          "role": "派蒙",
          "text": "明明是工作时间，却一副完全心不在焉的样子…"
        },
        {
          "role": "丽莎",
          "text": "反正除了琴之外，又有谁会对工作那么认真呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "轻易否定了其他人的努力！",
              "dialogues": []
            },
            {
              "text": "听你说得琴很可怜的样子…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "所以来找姐姐有什么事吗？"
        },
        {
          "role": "丽莎",
          "text": "…还是说只是想来看看我？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是来看你的！",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "呀，你好像很擅长讨人欢心呢，有点出乎我的意料了。"
                }
              ]
            },
            {
              "text": "嗯…好像也没什么事…",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "既然没事，那就是来看我的咯？"
                },
                {
                  "role": "丽莎",
                  "text": "呵呵，好了，先不拿你们寻开心了。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那么图书管理员小姐，有什么你推荐的书吗？"
        },
        {
          "role": "丽莎",
          "text": "推荐的书吗…可惜我比较推荐的书都是在禁书区的，暂时不外借哦。"
        },
        {
          "role": "派蒙",
          "text": "这股好像很危险的气息是怎么回事…"
        },
        {
          "role": "丽莎",
          "text": "哦，对了。{{颜色|蓝|《提瓦特游览指南》}}你们有兴趣吗？"
        },
        {
          "role": "丽莎",
          "text": "是旅行者的话，会对你们有帮助吧。"
        },
        {
          "role": "派蒙",
          "text": "哦！听起来是一本很实用的书呢。"
        },
        {
          "role": "派蒙",
          "text": "能借给我们看一下吗？"
        },
        {
          "role": "丽莎",
          "text": "那我就勉为其难地为你们查一下清单…"
        },
        {
          "role": "派蒙",
          "text": "这是丽莎的工作吧，为什么会勉为其难呀！"
        },
        {
          "role": "丽莎",
          "text": "啊呀…真是不巧，现在是「出借中」的状态，虽然还书日期已经到了…"
        },
        {
          "role": "丽莎",
          "text": "这么说来好像还有几本书也是过期未还的样子，真是…"
        },
        {
          "role": "丽莎",
          "text": "…令人恼火。"
        },
        {
          "role": "派蒙",
          "text": "唔！是我的幻觉吗，周围的雷元素浓度好像突然提高了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "汗毛都竖起来了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "唉…麻烦的工作。我要去回收这些逾期未还的书本了。"
        },
        {
          "role": "丽莎",
          "text": "想早点拿到{{颜色|蓝|《提瓦特游览指南》}}的话，不如你们也陪我一起？"
        },
        {
          "role": "派蒙",
          "text": "现在的丽莎好像很可怕，还是答应她比较好…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "唔，好、好的！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "真是善解人意的小可爱。让我看看，第一站是…"
        },
        {
          "role": "丽莎",
          "text": "…「荣光之风」吗，那么我们一会儿在{{颜色|蓝|纪念品商店}}见吧。"
        },
        {
          "type": "subtitle",
          "text": "与玛乔丽沟通还书的事"
        },
        {
          "role": "丽莎",
          "text": "你来了，旅行者。那么我们就开始吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "玛乔丽小姐，关于你借的书…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "玛乔丽小姐，最近有什么有意思的货品吗？"
        },
        {
          "role": "丽莎",
          "text": "嗯？干嘛用那种眼神看着我，这么值得纪念的日子，想要挑个纪念品是理所当然的吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哪里值得纪念了…",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "说的是呢…那今天就作为「初次与旅行者出门为麻烦的工作浪费生命纪念日」吧。"
                },
                {
                  "role": "派蒙",
                  "text": "好长！"
                }
              ]
            },
            {
              "text": "那还书的事…",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "难得都这样出来了，稍稍搁置一下正事也没什么问题吧。"
                },
                {
                  "role": "丽莎",
                  "text": "毕竟生活已经那样辛苦了嘛。"
                }
              ]
            },
            {
              "text": "作为…初次约会的纪念？",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "欸，原来你是这样认为的吗。"
                },
                {
                  "role": "丽莎",
                  "text": "嗯，倒也没什么不好啦，像你这个年纪，总会有这样那样的幻想吧？"
                }
              ]
            }
          ]
        },
        {
          "role": "玛乔丽",
          "text": "哈哈哈…想要纪念品啊，放心放心，这里肯定有丽莎小姐中意的。"
        },
        {
          "role": "玛乔丽",
          "text": "不如就让这位来挑吧，如何，更有纪念意义吧？"
        },
        {
          "role": "派蒙",
          "text": "咦！让旅行者来吗！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…那我就试试吧。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "给丽莎挑选纪念品"
        },
        {
          "role": "玛乔丽",
          "text": "挑一个吧，总有她喜欢的。"
        },
        {
          "type": "subtitle",
          "text": "（挑选丽莎会喜欢的纪念品）",
          "narration": true,
          "color": "蓝"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "南瓜裤",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "这个啊，蓬蓬软软的穿起来很舒服哦，特别能彰显小女孩、哦不，女士的可爱。"
                },
                {
                  "role": "玛乔丽",
                  "text": "毕竟很多手工娃娃也都穿着类似的南瓜裤呢，可以看做是可爱的证明。"
                },
                {
                  "role": "丽莎",
                  "text": "南瓜裤？穿这种幼女的衣物外出的话，会被认为是不知廉耻吧，莫非你有什么奇怪的兴趣？"
                },
                {
                  "role": "派蒙",
                  "text": "确定选择{{颜色|蓝|「南瓜裤」}}吗？选好可就{{颜色|蓝|不能改}}了哦！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "是。",
                      "dialogues": [
                        {
                          "role": "丽莎",
                          "text": "唔，算了，如果是你送的话，我就偶尔在家当做睡衣穿穿好了。"
                        }
                      ]
                    },
                    {
                      "text": "否",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "残破的绘卷",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "这是冒险家协会的伙计们从遗迹里淘出来的宝贝哦。"
                },
                {
                  "role": "玛乔丽",
                  "text": "虽然破了点，但上面画的东西…至少有千年历史了吧，虽然我是看不太懂啦。"
                },
                {
                  "role": "丽莎",
                  "text": "欸，这莫非是《北境流风考》遗失的第三卷…居然会在这里。"
                },
                {
                  "role": "派蒙",
                  "text": "确定选择{{颜色|蓝|「残破的绘卷」}}吗？选好可就{{颜色|蓝|不能改}}了哦！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "是。",
                      "dialogues": [
                        {
                          "role": "丽莎",
                          "text": "你可真有眼光呢小可爱，这是研究古时人们对元素力理解的绝佳素材，那我可就收下了。"
                        }
                      ]
                    },
                    {
                      "text": "否",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "巫毒娃娃",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "穿着南瓜裤的娃娃，我前面说的就是这个，很可爱吧？"
                },
                {
                  "role": "玛乔丽",
                  "text": "嗯…好像确实还稍微有些毛骨悚然？莫非有什么别的用处…"
                },
                {
                  "role": "丽莎",
                  "text": "巫毒娃娃？伤脑筋呢，我有做了什么让你这么不开心的事吗？"
                },
                {
                  "role": "派蒙",
                  "text": "确定选择{{颜色|蓝|「巫毒娃娃」}}吗？选好可就{{颜色|蓝|不能改}}了哦！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "是。",
                      "dialogues": [
                        {
                          "role": "丽莎",
                          "text": "有传说，收到巫毒娃娃的人会被降下恶毒的诅咒呢，虽说这种级别对我没什么用就是了。"
                        },
                        {
                          "role": "丽莎",
                          "text": "这种传说你应该不知道吧？看在你是旅行者的份儿上，我就当没发生过好了。"
                        }
                      ]
                    },
                    {
                      "text": "否",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "生锈的大剑",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "哦~这个也是新到的货，三个冒险家一起从遗迹里扛回来的大家伙。"
                },
                {
                  "role": "玛乔丽",
                  "text": "充满了历史的沉重感，对吧？虽然本身也已经够沉重的了。"
                },
                {
                  "role": "丽莎",
                  "text": "唔？好奇怪的品味。送我这个，还不如一句「让我成为守护你的剑」来得实在呢。"
                },
                {
                  "role": "派蒙",
                  "text": "确定选择{{颜色|蓝|「生锈的大剑」}}吗？选好可就{{颜色|蓝|不能改}}了哦！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "是。",
                      "dialogues": [
                        {
                          "role": "丽莎",
                          "text": "其实倒也不是彻底没用，这个重量的话，有空就借给雷泽进行强化训练吧。"
                        }
                      ]
                    },
                    {
                      "text": "否",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "问问玛乔丽。",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "欸？你问我？唔…丽莎小姐的话，感觉很有学者的气质？"
                },
                {
                  "role": "玛乔丽",
                  "text": "哦对了，听说她对{{颜色|蓝|历史研究}}很感兴趣。"
                }
              ]
            },
            {
              "text": "等等再来",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "嗯，时间差不多了。那么玛乔丽女士，请把《温妮莎传奇》…"
        },
        {
          "role": "玛乔丽",
          "text": "丽莎小姐原来也崇拜温妮莎大人呀，早说嘛！我这边有很多推荐的纪念品…"
        },
        {
          "role": "玛乔丽",
          "text": "比如这个刻有温妮莎名字的狮牙吊坠、这个温妮莎大人颁发过的骑士勋章…"
        },
        {
          "role": "丽莎",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "丽莎指的是你借过的书本。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛乔丽",
          "text": "啊…抱歉抱歉，说起温妮莎大人我有些激动了。"
        },
        {
          "role": "玛乔丽",
          "text": "原来那本书已经逾期了嘛，我还一直带在身上的…"
        },
        {
          "role": "玛乔丽",
          "text": "明明看到丽莎小姐就应该想起来的，哈哈哈……给。"
        },
        {
          "role": "丽莎",
          "text": "唉…看在你那么仰慕温妮莎大人的份儿上…下次请一定注意。"
        },
        {
          "role": "玛乔丽",
          "text": "呃，好的！没问题，丽莎小姐。"
        },
        {
          "role": "丽莎",
          "text": "那我们也该去找下一本书了。"
        },
        {
          "type": "subtitle",
          "text": "与莎拉沟通还书的事"
        },
        {
          "role": "莎拉",
          "text": "欢迎光临「猎鹿人」，是两位一起吗？"
        },
        {
          "role": "派蒙",
          "text": "三位！"
        },
        {
          "role": "莎拉",
          "text": "哈哈真不好意思，请随意坐吧，需要点菜可以叫我哦。"
        },
        {
          "role": "派蒙",
          "text": "果然还是要先吃饭，再谈书的事情吗？"
        },
        {
          "role": "丽莎",
          "text": "那当然，先做那些麻烦的工作的话，连好吃的饭菜也会变味了吧。"
        },
        {
          "role": "派蒙",
          "text": "那么严重吗！"
        },
        {
          "type": "subtitle",
          "text": "根据丽莎的喜好来点选菜品"
        },
        {
          "role": "丽莎",
          "text": "呵欠…快先点菜吧旅行者，我对你的品味很是期待哦。"
        },
        {
          "type": "subtitle",
          "text": "（挑选适合丽莎口味的料理吧）",
          "narration": true,
          "color": "蓝"
        },
        {
          "type": "subtitle",
          "text": "额外对话（莎拉）"
        },
        {
          "role": "莎拉",
          "text": "欢迎光临「猎鹿人」餐馆，您好您好，请问几位？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于丽莎的口味…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莎拉",
          "text": "欸？想问丽莎小姐的喜好？"
        },
        {
          "role": "莎拉",
          "text": "以前偶尔见到她和琴团长来吃下午茶，好像…主要会点{{颜色|蓝|蔬菜类}}的吧？"
        },
        {
          "role": "莎拉",
          "text": "淑女总是要控制体态的嘛~！唔…我是不是也应该减减肥了呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "烤肉排",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "是「猎鹿人」的招牌呢，你想要的话，试试也不错。"
                },
                {
                  "role": "派蒙",
                  "text": "确定选择{{颜色|蓝|「烤肉排」}}吗？选好可就{{颜色|蓝|不能改}}了哦！"
                }
              ]
            },
            {
              "text": "北地烟熏鸡",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "似乎是酒馆里最常见的下酒菜吧，因为口味比较重，还蛮受那些酒客欢迎的。"
                },
                {
                  "role": "派蒙",
                  "text": "确定选择{{颜色|蓝|「北地烟熏鸡」}}吗？选好可就{{颜色|蓝|不能改}}了哦！"
                }
              ]
            },
            {
              "text": "萝卜时蔬汤",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "蔬菜汤吗，材料的品质、置入的顺序、火候的控制都很有讲究的吧，有趣。"
                },
                {
                  "role": "丽莎",
                  "text": "虽然我刚说的这些都是药剂学的技巧啦，不过据说很久以前的魔女们都很喜欢熬汤的哦。"
                },
                {
                  "role": "派蒙",
                  "text": "确定选择{{颜色|蓝|「萝卜时蔬汤」}}吗？选好可就{{颜色|蓝|不能改}}了哦！"
                }
              ]
            },
            {
              "text": "满足沙拉",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "沙拉这种吃法呢，就好比直接堆砌元素力，一味追求野性的力量而忽视了精细控制的做法。"
                },
                {
                  "role": "丽莎",
                  "text": "是魔导学新手常犯的错误，但如果那份元素力本身就强大到可以解决一切问题…那另当别论。"
                },
                {
                  "role": "派蒙",
                  "text": "确定选择{{颜色|蓝|「满足沙拉」}}吗？选好可就{{颜色|蓝|不能改}}了哦！"
