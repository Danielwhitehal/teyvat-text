                    {
                      "text": "否",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "等下再来。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "好了，那么回到正经事上来。唐娜小姐，你知道我们来的目的吗？"
        },
        {
          "role": "唐娜",
          "text": "正经事？来买花不是正经事吗？"
        },
        {
          "role": "丽莎",
          "text": "呼啊——果然又是这样，不把，书本，当一回事呢…"
        },
        {
          "role": "丽莎",
          "text": "{{颜色|蓝|《白之公主与六侏儒》}}，还记得吗？"
        },
        {
          "role": "唐娜",
          "text": "啊！啊啊、那个…那个——"
        },
        {
          "role": "唐娜",
          "text": "唔…怎么办…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "唐娜看起来好紧张的样子…",
              "dialogues": []
            },
            {
              "text": "发生什么事了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "唐娜",
          "text": "…我，我把书给弄丢了…"
        },
        {
          "role": "丽莎",
          "text": "……"
        },
        {
          "role": "唐娜",
          "text": "…前一段时间我想起来还书的日期快到了，正准备送回图书馆。"
        },
        {
          "role": "唐娜",
          "text": "结果发现不管哪里都找不到了…陆陆续续找了几天也没有找到。"
        },
        {
          "role": "唐娜",
          "text": "像是被人拿走了的样子，明明我就一直放在床头的…"
        },
        {
          "role": "派蒙",
          "text": "糟了糟了，丽莎会不会做出很可怕的事来…"
        },
        {
          "role": "丽莎",
          "text": "嗯？我都听见了哦。"
        },
        {
          "role": "派蒙",
          "text": "啊——"
        },
        {
          "role": "丽莎",
          "text": "如果真的是被人拿走了的话，唐娜就没做错什么哦。"
        },
        {
          "role": "丽莎",
          "text": "那么这笔账就要算在，偷书人，的身上了呢…"
        },
        {
          "role": "丽莎",
          "text": "而且要付出三倍…不，十倍的代价。"
        },
        {
          "role": "派蒙",
          "text": "果然还是很可怕！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那么怎样才能找回丢失的书呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "这一点就放心好了，只要我还是图书管理员，就不会丢失任何一本书。"
        },
        {
          "role": "丽莎",
          "text": "我在每一本书上都做了特定的元素标记，一定会留下蛛丝马迹的。"
        },
        {
          "role": "派蒙",
          "text": "难道说…丽莎其实对工作非常认真？明明平时是那般懒散的样子…"
        },
        {
          "role": "丽莎",
          "text": "小可爱，听说你也有很强的元素感知力…不妨你来试试？"
        },
        {
          "role": "派蒙",
          "text": "元素感知力？唔哦，我知道了！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，靠{{颜色|蓝|「元素视野」}}找一找线索吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（唐娜）"
        },
        {
          "role": "唐娜",
          "text": "呼…怎么会弄丢了呢…"
        },
        {
          "type": "subtitle",
          "text": "寻找书籍留下的元素痕迹"
        },
        {
          "type": "subtitle",
          "text": "与丽莎一起分析线索"
        },
        {
          "role": "丽莎",
          "text": "从痕迹来看，确实是被偷走的可能性比较大呢。"
        },
        {
          "role": "派蒙",
          "text": "果然不是唐娜小姐的错吗。"
        },
        {
          "role": "丽莎",
          "text": "又不是禁书区的书，有什么偷走的必要呢…"
        },
        {
          "role": "丽莎",
          "text": "真是奇怪的占有欲。"
        },
        {
          "role": "派蒙",
          "text": "那现在该怎么办？"
        },
        {
          "role": "丽莎",
          "text": "虽然是很微弱的{{颜色|蓝|元素力}}反应，但看得出来偷书人已经把书带往城外了。"
        },
        {
          "role": "丽莎",
          "text": "旅行者应该也能看得到吧？"
        },
        {
          "role": "丽莎",
          "text": "就循着踪迹瞧瞧他的目的地在哪儿吧。"
        }
      ],
