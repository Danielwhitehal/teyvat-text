{
  "quest_id": 22046,
  "chapter_num": null,
  "chapter_title": "神社大扫除",
  "type": "iq",
  "route": "Shrine Cleanup",
  "stories": [
    {
      "story_id": 22046,
      "title": "神社大扫除",
      "description": "「浅濑神社代宫司」寝子似乎正在为某事而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与寝子对话"
        },
        {
          "role": "「寝子」",
          "text": "神社又有些乱了啊…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "「寝子」",
          "text": "唔喵，是汝等啊，来得正好。"
        },
        {
          "role": "「寝子」",
          "text": "一段时间没打扫，神社的屋子周围，又有了好多污渍。"
        },
        {
          "role": "「寝子」",
          "text": "这样子可不能接待来神社的人类啊…"
        },
        {
          "role": "「寝子」",
          "text": "汝等，能和上次一样，帮奴家打扫一下神社吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不是有大祐和悦子吗？",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "奴家可不会去主动找那两个绿绿的人类说话。"
                },
                {
                  "role": "「寝子」",
                  "text": "那个高高的人类，看奴家的眼神总是很奇怪…"
                },
                {
                  "role": "「寝子」",
                  "text": "另外一个绿绿的人类，又总是那副提不起劲的样子。"
                },
                {
                  "role": "「寝子」",
                  "text": "喵喵，无论怎么想，都是两个靠不住的人类。"
                }
              ]
            },
            {
              "text": "可以拜托大岛先生…",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "那个石头人类一直在忙个不停，不知道在咚咚咚地敲什么…"
                },
                {
                  "role": "「寝子」",
                  "text": "明明石头已经敲好了，为什么还在咚咚咚呢，真烦…"
                }
              ]
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "总之，就拜托汝等了。就和上次一样，用长棍子和水「打扫」，汝等明白了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": []
            },
            {
              "text": "差不多明白了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「寝子」",
          "text": "总之，这件事就拜托汝等了，奴家…"
        },
        {
          "role": "「寝子」",
          "text": "奴家在这里等着汝等，喵喵。"
        },
        {
          "type": "subtitle",
          "text": "打扫浅濑神社周围的污渍"
        },
        {
          "role": "「寝子」",
          "text": "总之，「打扫」就拜托汝等了，奴家就在这里等着汝等，喵喵。"
        },
        {
          "type": "subtitle",
          "text": "向寝子回报"
        },
        {
          "role": "「寝子」",
          "text": "喔，汝等已经「打扫」完了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经打扫完了。"
        },
        {
          "role": "「寝子」",
          "text": "喵喵，那就好，汝等果然非常可靠啊。"
        },
        {
          "role": "「寝子」",
          "text": "神社真是越来越像样了，等阿响回来了之后，她一定会非常高兴的。"
        },
        {
          "role": "「寝子」",
          "text": "奴家一定要好好打理神社才行…喵喵…"
        }
      ]
    }
  ]
}