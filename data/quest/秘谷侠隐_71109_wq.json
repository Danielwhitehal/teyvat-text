{
  "quest_id": 71109,
  "chapter_num": null,
  "chapter_title": "秘谷侠隐",
  "type": "wq",
  "route": "Shrouded Vale, Hidden Hero",
  "stories": [
    {
      "story_id": 71109,
      "title": "秘谷侠隐",
      "description": "探索古华留下的秘密。",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "哇啊，没想到这破破烂烂的王山厅里，居然还真的藏了这么深的秘密…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我也没想到！",
            "可能这就叫「人不可貌相」…"
          ]
        },
        {
          "role": "派蒙",
          "text": "而且，黄三爷好像也不知道有这种地方…等等，难道这里就是传说中的「古华藏宝室」吗？！"
        },
        {
          "role": "派蒙",
          "text": "而且…旅行者你看，那边的台子上好像有什么东西在发光！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "是宝藏！",
            "是机关？"
          ]
        },
        {
          "role": "派蒙",
          "text": "总之，我们快点过去看看吧！"
        },
        {
          "role": "碑铭",
          "text": "「…天其难谌，臻而见眷者罕。命其靡常，盛而未衰者鲜…获目于天，犹有径路所穷之时，况复天目未及者…」"
        },
        {
          "role": "碑铭",
          "text": "「…遗此碑宇，且问来许。行至绝处，自当何如？」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "（触碰石碑。）",
            "（离开。）"
          ]
        },
        {
          "role": "派蒙",
          "text": "欸？这把剑上好像写了什么？让我看看…"
        },
        {
          "role": "古剑铭文",
          "text": "「…抚剑长歌去，斫龙歃血还。神光似游电，寒浪欲摧山…」"
        },
        {
          "role": "古剑铭文",
          "text": "「…斩虎天衡下，刺蛟云海间。功成拂衣后，永同烟水闲…」"
        },
        {
          "role": "派蒙",
          "text": "旁边好像还有一块石碑…咦，这下面的字迹好像不太一样？"
        },
        {
          "role": "古老的摹刻",
          "text": "「…本欲遗鱼羊丰肴于此，奈何日久必腐。且留食谱于此，足下可自烹之。甚美。」"
        },
        {
          "role": "古老的摹刻",
          "text": "「…此外别无他物，唯此剑与此景。」"
        },
        {
          "role": "古老的摹刻",
          "text": "「…行至绝处，当何如？足下已知。」"
        },
        {
          "role": "歪歪扭扭的摹刻",
          "text": "「…不取…遗宝，仅留一…自此…」"
        },
        {
          "role": "歪歪扭扭的摹刻",
          "text": "「请从绝处…读我…」"
        },
        {
          "role": "派蒙",
          "text": "呜哇…下面这几行字儿歪歪扭扭的，根本看不懂写了什么！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "大概就是他什么都没拿的意思吧。",
            "我也看不懂…"
          ]
        },
        {
          "role": "派蒙",
          "text": "呜呜，到头来都没找到什么价值连城的宝藏，白期待一场了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "就是啊！",
            "没事没事，我做料理给你吃。"
          ]
        },
        {
          "role": "派蒙",
          "text": "不过，没想到在这种绝境，还能看到这样的风景…至少算是物有所值了吧？"
        }
      ]
    }
  ]
}