  "type": "iq",
  "route": "Post-Sale Service",
  "stories": [
    {
      "story_id": 22037,
      "title": "售后服务",
      "description": "肥料店「葱茏之愿」的店主瓦希德似乎接到了顾客的抱怨…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与瓦希德对话"
        },
        {
          "role": "瓦希德",
          "text": "糟了…怎么会这样？"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "瓦希德",
          "text": "旅行者，我正在找你呢！"
        },
        {
          "role": "瓦希德",
          "text": "你还记得绀田传助这个顾客吗？他前几天过来店里，问了问关于肥料的事。"
        },
        {
          "role": "旅行者",
          "text": "他对肥料还满意吗？"
        },
        {
          "role": "瓦希德",
          "text": "满意不满意的…倒也不能这么说，严格来说，我觉得绀田传助先生应该是「迷茫」。"
        },
        {
          "role": "旅行者",
          "text": "迷茫？"
        },
        {
          "role": "瓦希德",
          "text": "呃是这样的，你上次去宣传了之后，绀田先生确实也按照你说的方法施用了我们的肥料。"
        },
        {
          "role": "瓦希德",
          "text": "但是，虽然这之后庄稼确实长了起来，但同时…地里还莫名其妙地冒了大量的蘑菇…"
        },
        {
          "role": "瓦希德",
          "text": "绀田先生来说了之后，说实话，我也有点茫然。"
        },
        {
          "role": "瓦希德",
          "text": "但不管怎么样，这种情况应该和施用在地里的肥料脱不开关系。"
        },
        {
          "role": "瓦希德",
          "text": "旅行者，能拜托你再去绀田村一趟，帮绀田先生清理一下田里的那些蘑菇吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "瓦希德",
                  "text": "那就拜托你了，我要在店里再查一下资料，看看到底是什么原因导致了这个情况…"
                },
                {
                  "role": "瓦希德",
                  "text": "唉，要是爱拉尼在这里就好了，她肯定能很快找出原因来。"
                }
              ]
            },
            {
              "text": "不如让爱拉尼研究一下这问题？",
              "dialogues": [
                {
                  "role": "瓦希德",
                  "text": "如果她在的话，肯定能很快找出原因来。"
                },
                {
                  "role": "瓦希德",
                  "text": "但是她到现在还没回来，不知道到底去了哪里。"
                },
                {
                  "role": "瓦希德",
                  "text": "只能拜托你了，旅行者，我要在店里再查一下资料，看看到底是什么原因导致了这个情况…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与绀田传助对话"
        },
        {
          "role": "绀田传助",
          "text": "这些蘑菇到底是怎么回事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来清理蘑菇了！",
              "dialogues": []
            },
            {
              "text": "对不起，给您添蘑菇了！",
              "dialogues": [
                {
                  "role": "绀田传助",
                  "text": "添蘑菇？呃，我家的餐桌上可不太缺蘑菇。"
                }
              ]
            }
          ]
        },
        {
          "role": "绀田传助",
          "text": "你这次是从瓦希德先生那边过来，帮我清理蘑菇的吗？"
        },
        {
          "role": "绀田传助",
          "text": "唔，那就拜托你了，那些田里的蘑菇实在是太多了，我这把老骨头可摘不完。"
        },
        {
          "role": "绀田传助",
          "text": "这些蘑菇，怎么长得这么快…"
        },
        {
          "role": "绀田传助",
          "text": "这些蘑菇，怎么长得这么快？"
        },
        {
          "type": "subtitle",
          "text": "摘除田地里的蘑菇"
        },
        {
          "type": "subtitle",
          "text": "与绀田传助对话"
        },
        {
          "role": "绀田传助",
          "text": "你都摘干净了吗？"
        },
        {
          "role": "旅行者",
          "text": "摘来的蘑菇都在这里了。"
        },
        {
          "role": "绀田传助",
          "text": "只有这些吗？我印象里，地里长出的蘑菇不止这些啊，是不是没摘干净啊…"
        },
        {
          "role": "绀田传助",
          "text": "但无论如何我都要谢谢你，年轻人。这些东西给你，就当做是报酬吧。"
        },
        {
          "role": "绀田传助",
          "text": "不过，这肥料还真是厉害啊，居然能让蘑菇长这么快，要是庄稼也能长这么快就好了。"
        },
        {
          "role": "绀田传助",
          "text": "等我有空了之后，一定要再买点回来试试…"
        },
        {
          "type": "subtitle",
          "text": "与绀田传助对话"
        },
        {
          "role": "绀田传助",
          "text": "你都摘干净了吗？"
        },
        {
          "role": "旅行者",
          "text": "摘来的蘑菇都在这里了。"
        },
        {
          "role": "绀田传助",
          "text": "地里长出的蘑菇还真不少啊，看来是都摘干净了。"
        },
        {
          "role": "绀田传助",
          "text": "谢谢你了年轻人，没你帮忙，我都不知道怎么办了。这些东西给你，就当做是报酬吧。"
        },
        {
          "role": "绀田传助",
          "text": "不过，这肥料还真是厉害啊，居然能让蘑菇长这么快，要是庄稼也能长这么快就好了。"
        },
        {
          "role": "绀田传助",
          "text": "等我有空了之后，一定要再买点回来试试…"
        }
      ]
    }
  ]
}