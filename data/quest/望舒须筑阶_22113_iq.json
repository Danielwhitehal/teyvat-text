{
  "quest_id": 22113,
  "chapter_num": null,
  "chapter_title": "望舒须筑阶",
  "type": "iq",
  "route": "Stairway to Wangshu",
  "stories": [
    {
      "story_id": 22113,
      "title": "望舒须筑阶",
      "description": "望舒客栈的淮安想要修理客栈楼梯上的另一道断口，正在找人帮忙…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与淮安对话"
        },
        {
          "role": "淮安",
          "text": "真是，坏事怎么就扎着堆来…"
        },
        {
          "role": "旅行者",
          "text": "还在修楼梯吗？"
        },
        {
          "role": "淮安",
          "text": "您来得正好。上次谢谢您了，然后…这次还得麻烦您。"
        },
        {
          "role": "淮安",
          "text": "这断口有点大，木板不够用了，我又买了一批，本来是让客栈里的搬运工去接货。"
        },
        {
          "role": "淮安",
          "text": "但是没想到，他在路上被一群怪物袭击，慌里慌张地跑回来，木板全给丢路上了。"
        },
        {
          "role": "淮安",
          "text": "这个人被吓了个好歹，把丢木板的地方指出来之后，怎么说都不愿意回去了…"
        },
        {
          "role": "淮安",
          "text": "我思来想去，只能麻烦您了，您能帮我去把那些木板拿回来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "淮安",
                  "text": "那就麻烦您了，我在这等着您。"
                }
              ]
            },
            {
              "text": "这断口这么大…",
              "dialogues": [
                {
                  "role": "淮安",
                  "text": "您别这么看着我，这段不是怪物砸的，这得多大块头才能砸成这样…"
                },
                {
                  "role": "淮安",
                  "text": "这断口是这么来的…客栈里呢，曾经先后来了两个客人，两人之间有点私怨，之前是一追一躲，一直没遇见。"
                },
                {
                  "role": "淮安",
                  "text": "结果，这两位都准备在我们这客栈投宿，上楼梯的时候，互相遇见了。"
                },
                {
                  "role": "淮安",
                  "text": "然后这两位就玩了命打呗…打了一阵，把楼梯都打断了这么大一截，我去分了半天才分开。"
                },
                {
                  "role": "淮安",
                  "text": "我这个气啊…当时就多收了他们三天房钱。"
                },
                {
                  "role": "淮安",
                  "text": "好了，闲话就说到这，您快些帮我把木板拿回来吧，我赶紧把这给修了。"
                },
                {
                  "role": "淮安",
                  "text": "要是再这么折腾一次，我也不收额外房钱了，谁砸断的，谁给我当场修好…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "搜集5块木板"
        },
        {
          "role": "淮安",
          "text": "您拿到木板了吗？"
        },
        {
          "role": "旅行者",
          "text": "没找到…"
        },
        {
          "role": "淮安",
          "text": "请您快着点吧，您把木板拿回来，我就即刻开工。"
        },
        {
          "type": "subtitle",
          "text": "与淮安对话"
        },
        {
          "role": "淮安",
          "text": "您拿到木板了吗？"
        },
        {
          "role": "旅行者",
          "text": "拿到了。"
        },
        {
          "role": "淮安",
          "text": "太好了，这些怪物真是烦人。"
        },
        {
          "role": "淮安",
          "text": "这些就够了，实在是谢谢您，我这就开工。"
        },
        {
          "type": "subtitle",
          "text": "与淮安对话"
        },
        {
          "role": "淮安",
          "text": "这下子全部都修好了，怎么样，我的手艺还不错吧。"
        },
        {
          "role": "淮安",
          "text": "这样客栈的客人们也方便多了。哈哈哈。"
        },
        {
          "role": "淮安",
          "text": "对了，这些您拿好，实在是辛苦您了。"
        },
        {
          "role": "淮安",
          "text": "您有空的话，可以多来坐坐，喝杯茶，吃点点心，我们这厨子的手艺，还是不错的。"
        }
      ]
    }
  ]
}