{
  "quest_id": 20016,
  "chapter_num": null,
  "chapter_title": "餐品订单",
  "type": "iq",
  "route": "Food Delivery",
  "stories": [
    {
      "story_id": 20016,
      "title": "餐品订单",
      "description": "为了满足顾客的需要，猎鹿人餐馆持续提供着送餐服务。但是因为顾客众多，餐馆里的人手严重不足，莎拉小姐想要找一个人来帮忙送餐。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往猎鹿人餐馆询问莎拉"
        },
        {
          "type": "subtitle",
          "text": "与莎拉对话"
        },
        {
          "role": "莎拉",
          "text": "餐品外送订单"
        },
        {
          "role": "莎拉",
          "text": "旅行者！你来的正好…"
        },
        {
          "role": "莎拉",
          "text": "抱歉，虽然你饿着肚子，但是能不能请你帮我个忙？"
        },
        {
          "role": "莎拉",
          "text": "最近的送餐订单越来越多，我一般是先把订单按照地区分好，然后再标好是谁订的。"
        },
        {
          "role": "莎拉",
          "text": "但是这份<color=#00E1FFFF>嘟嘟莲海鲜羹</color>的订餐人标签被我弄丢了，只知道订餐的人在清泉镇。"
        },
        {
          "role": "莎拉",
          "text": "你能帮我把这份<color=#00E1FFFF>嘟嘟莲海鲜羹</color>送去清泉镇，再找找是谁订的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧，但是…",
              "dialogues": [
                {
                  "role": "莎拉",
                  "text": "等你回来的时候，会有一顿大餐做回报的！"
                },
                {
                  "role": "莎拉",
                  "text": "拜托了！"
                }
              ]
            },
            {
              "text": "太饿了，我只是来吃饭的。",
              "dialogues": [
                {
                  "role": "莎拉",
                  "text": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "询问舒特"
        },
        {
          "role": "旅行者",
          "text": "请问是你订的餐么？"
        },
        {
          "role": "害怕的舒特",
          "text": "不是，我订的不是这一份。"
        },
        {
          "type": "subtitle",
          "text": "询问莫罗"
        },
        {
          "role": "旅行者",
          "text": "请问是你订的餐么？"
        },
        {
          "role": "胆小的莫罗",
          "text": "嗯，不是我订的…这一份不是。"
        },
        {
          "type": "subtitle",
          "text": "询问帕拉德"
        },
        {
          "role": "旅行者",
          "text": "请问是你订的餐么？"
        },
        {
          "role": "冒失的帕拉德",
          "text": "订餐？你找错人了。"
        },
        {
          "type": "subtitle",
          "text": "把餐费交给莎拉"
        },
        {
          "role": "莎拉",
          "text": "交付餐费"
        },
        {
          "role": "莎拉",
          "text": "你回来了，餐品送到了吗？"
        },
        {
          "role": "旅行者",
          "text": "这是餐费。"
        },
        {
          "role": "莎拉",
          "text": "我看看…没错，太感谢了！"
        },
        {
          "role": "莎拉",
          "text": "还有，这份<color=#00E1FFFF>蟹黄火腿焗时蔬</color>给你，刚刚做好的，赶紧趁热吃了吧。"
        }
      ]
    }
  ]
}