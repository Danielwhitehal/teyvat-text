  "stories": [
    {
      "story_id": 75664,
      "title": "荣花演武，开幕！",
      "description": "火神玛薇卡同意了举办荣花演武，相关的比赛会场也搭建完成。现在可以去报名参加正赛了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与巴罗对话"
        },
        {
          "role": "巴罗",
          "text": "旅行者和派蒙！哈哈，终于见到真人了。"
        },
        {
          "role": "巴罗",
          "text": "欢迎来到荣花演武的主会场。我已经听首领们说过了，你们是来报名参赛的吧？"
        },
        {
          "role": "派蒙",
          "text": "是呀！不过我们还不是很了解，比赛的具体内容是什么呢？"
        },
        {
          "role": "巴罗",
          "text": "既然这样，由我来为你们简单介绍一下规则吧。"
        },
        {
          "role": "巴罗",
          "text": "首先呢，荣花演武会分成「进攻战」和「守备战」。"
        },
        {
          "role": "巴罗",
          "text": "守备战很好理解嘛，就是阻止对手进攻部族；进攻战要复杂一些，它是假定部族已经失守，现在要吹响反攻的号角。"
        },
        {
          "role": "巴罗",
          "text": "为了让比赛更有趣味性，我们制作了特殊的仪式道具。进攻方需要为它积蓄能量，破坏掉对手的特殊结界。"
        },
        {
          "role": "巴罗",
          "text": "还有，即使是比赛，我们也不想见到纯粹的暴力与冲突。打坏的东西要重新修好，另外遇到魔物也请及时清剿。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…我已经有点听晕了。旅行者，你记住了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "差不多…",
              "dialogues": []
            },
            {
              "text": "没记住…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "巴罗",
          "text": "没关系，有什么问题都可以来问我。而且比赛并不复杂，亲身参与几次，很快就能掌握要领。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（巴罗）"
        },
        {
          "role": "巴罗",
          "text": "荣花演武正在如火如荼地举办，两位想加入哪个部族呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "报名参赛。",
              "dialogues": []
            },
            {
              "text": "询问规则。",
              "dialogues": [
                {
                  "role": "巴罗",
                  "text": "需要我再帮你们介绍一下规则吗？没问题。"
                },
                {
                  "role": "巴罗",
                  "text": "首先呢，荣花演武会分成「进攻战」和「守备战」。"
                },
                {
                  "role": "巴罗",
                  "text": "守备战很好理解嘛，就是阻止对手进攻部族；进攻战要复杂一些，它是假定部族已经失守，现在要吹响反攻的号角。"
                },
                {
                  "role": "巴罗",
                  "text": "为了让比赛更有趣味性，我们制作了特殊的仪式道具。进攻方需要为它积蓄能量，破坏掉对手的特殊结界。"
                },
                {
                  "role": "巴罗",
                  "text": "还有，即使是比赛，我们也不想见到纯粹的暴力与冲突。打坏的东西要重新修好，另外遇到魔物也请及时清剿。"
                }
              ]
            },
            {
              "text": "闲聊。",
              "dialogues": [
                {
                  "role": "巴罗",
                  "text": "呼…这次参加比赛的人真不少，两位应该也遇到熟人了吧？"
                },
                {
                  "role": "巴罗",
                  "text": "我的朋友也去了比赛现场。等眼前的工作告一段落，我也要去现场为他加油。"
                },
                {
                  "role": "巴罗",
                  "text": "哈哈，希望大家都能在比赛中发挥出全部实力！打个痛快，闹个尽兴！"
                }
              ]
            },
            {
              "text": "离开。",
              "dialogues": []
            }
          ]
        }
      ],
