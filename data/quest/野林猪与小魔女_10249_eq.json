        ]
      ]
    },
    {
      "story_id": 40243,
      "title": "礼貉出逃记",
      "description": "早柚又睡着了？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与早柚对话"
        },
        {
          "role": "早柚",
          "text": "呼噜…"
        },
        {
          "role": "派蒙",
          "text": "早——柚——怎么又睡着啦。你很累吗？"
        },
        {
          "role": "早柚",
          "text": "累…搬完凳子，又指挥大礼貉跑了好长一段路…真是辛苦我自己了，需要奖励自己睡一觉。"
        },
        {
          "role": "派蒙",
          "text": "大狸貉？"
        },
        {
          "role": "早柚",
          "text": "我就知道肯定会有人听成「狸」。大礼貉的「礼」是礼貌的「礼」，不是狸猫的「狸」！是很有礼貌的大貉貉。"
        },
        {
          "role": "派蒙",
          "text": "好的。是礼貌不是狸猫。"
        },
        {
          "role": "早柚",
          "text": "大礼貉是我的幻想朋友。一般情况下大家都看不见它嘛，所以我也没给你们正式介绍过。"
        },
        {
          "role": "派蒙",
          "text": "果然小朋友们都有幻想朋友呢！"
        },
        {
          "role": "早柚",
          "text": "嘘——「小朋友」这个称呼听上去会长不高，我是即将独当一面的忍者。嗯…即将。"
        },
        {
          "role": "早柚",
          "text": "在独当一面前，跟好朋友共同当一面也没什么关系吧…"
        },
        {
          "role": "早柚",
          "text": "而且…大家看不见大礼貉在帮我，所以在别人眼中我还是独当一面的样子哦。"
        },
        {
          "role": "派蒙",
          "text": "感觉怪怪的…独当一面是这么用的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哈哈，很有想象力的理解。",
              "dialogues": []
            },
            {
              "text": "我很好奇大礼貉长什么样子。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "早柚",
          "text": "真的吗？太好了，只需要打开这个忍术装置就可以跟它一起训练！"
        },
        {
          "role": "早柚",
          "text": "最近忙着跟小魔女们玩，落下了很多训练任务…"
        },
        {
          "role": "派蒙",
          "text": "训练任务？好呀早柚，想让我们帮你做任务，自己偷懒是吧！"
        },
        {
          "role": "早柚",
          "text": "这个那个…不是这样的！"
        },
        {
          "role": "早柚",
          "text": "这是老师离开前留给我的逃跑训练装置。如你们所见，我的逃跑技术已经相当熟练了。"
        },
        {
          "role": "早柚",
          "text": "属于我自己的训练任务早就完成了，我要偷的不是这个懒。"
        },
        {
          "role": "早柚",
          "text": "哎…大礼貉比我还懒，都快跟不上我的脚步了。不行啊，要逃就要一起逃。所以现在要做的是训练大礼貉的任务。"
        },
        {
          "role": "早柚",
          "text": "我想偷的是这个懒…"
        },
        {
          "role": "派蒙",
          "text": "这不还是偷懒吗！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就再帮你偷一次懒吧。",
              "dialogues": []
            },
            {
              "text": "我也想偷一次懒。等会再来！",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（早柚）"
        },
        {
          "role": "早柚",
          "text": "能帮我训练大礼貉逃跑吗？就帮我偷一次懒吧，就一次。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就再帮你偷一次懒吧。",
              "dialogues": []
            },
            {
              "text": "我也想偷一次懒。等会再来！",
              "dialogues": []
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          24,
          26
        ]
      ]
    },
    {
      "story_id": 40232,
      "title": "猎魔演练",
      "description": "布伦妮似乎在忙着记笔记…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与布伦妮对话"
        },
        {
          "role": "布伦妮",
          "text": "通过元素配合获取伤害增益…也就是说，只要作战策略得当，即便是魔女也并非不能战胜…"
        },
        {
          "role": "布伦妮",
          "text": "刚才的冰霜骗骗花，是种典型的拟态植物魔物，不像是魔女派来的魔物。"
        },
        {
          "role": "布伦妮",
          "text": "面对遁地和冰刺攻击，走位尤其重要，旅行者的身法就够我学好久了，还有他的招式…总之先抄下来…"
        },
        {
          "role": "布伦妮",
          "text": "「猎魔演练·改·第16稿」…搞定！"
        },
        {
          "role": "派蒙",
          "text": "布伦妮，你在记笔记吗？"
        },
        {
          "role": "布伦妮",
          "text": "呜哇！吓我一跳，你走路怎么没脚步声啊？"
        },
        {
          "role": "派蒙",
          "text": "我用飞的呀！"
        },
        {
          "role": "布伦妮",
          "text": "你们刚才都听到了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听到了猎魔演练。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "既然如此，接下来我要说一个事，希望你们听完不要太惊讶。"
        },
        {
          "role": "布伦妮",
          "text": "艾莉丝给我的书里夹着几张稿纸，有非常神奇的魔法——能将纸上的内容复现在幻想秘境中。"
        },
        {
          "role": "布伦妮",
          "text": "我知道这有点难以想象。这么说吧，就像人能进入童话书里的世界一样。"
        },
        {
          "role": "派蒙",
          "text": "哦，不就是希穆兰卡嘛，我们早就去过了。{{#info:[[欢夏！邪龙？童话国！]]}}"
        },
        {
          "role": "布伦妮",
          "text": "（什么卡？没听过！不会真有本能进去的童话书吧…）"
        },
        {
          "role": "派蒙",
          "text": "所以布伦妮在上面写了什么童话？我们能进去看看吗？"
        },
        {
          "role": "布伦妮",
          "text": "稿纸就这几张，怎么能浪费在那些不切实际的东西上，当然要用来增值自己啊。"
        },
        {
          "role": "布伦妮",
          "text": "自学完这本教材后，我写了一套战斗训练计划，假以时日，一定能亲手打败艾莉丝！"
        },
        {
          "role": "派蒙",
          "text": "欸？你们不是朋友吗？为什么要打败她呢？"
        },
        {
          "role": "布伦妮",
          "text": "（完蛋，兴奋过头说漏嘴了…）"
        },
        {
          "role": "派蒙",
          "text": "我懂了…"
        },
        {
          "role": "布伦妮",
          "text": "（瞒不住了吗…）"
        },
        {
          "role": "派蒙",
          "text": "你们肯定是特别要好的朋友吧！"
        },
        {
          "role": "布伦妮",
          "text": "欸？"
        },
        {
          "role": "派蒙",
          "text": "旅行者也有这样的朋友哦，那家伙只要一有机会就会邀请旅行者跟他打架切磋。{{#info:[[达达利亚]]}}"
        },
        {
          "role": "派蒙",
          "text": "毕竟他是鼎鼎大名的旅行者嘛，所以，布伦妮想提升武艺的话，找他也行哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "啊？又我？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "对哦！我干嘛偷偷抄技巧呀，直接请活的高手亲自教我不是更快吗！"
        },
        {
          "role": "布伦妮",
          "text": "可以请你参与到我的演练中来吗？你的战斗示范一定很有参考价值。"
