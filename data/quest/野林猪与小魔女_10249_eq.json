{
  "quest_id": 10249,
  "chapter_num": "幻友绮旅 其一",
  "chapter_title": "野林猪与小魔女",
  "type": "eq",
  "route": "The Forest Boar and the Little Witch",
  "stories": [
    {
      "story_id": 40228,
      "title": "野林猪与小魔女",
      "description": "经历不少事件后，你们决定去秋沙钱汤放松放松…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "最近大大小小的事件一桩接一桩，呼…神经都绷紧了。"
        },
        {
          "role": "派蒙",
          "text": "不如，我们去秋沙钱汤好好放松一下，养精蓄锐再出发吧！"
        },
        {
          "type": "subtitle",
          "text": "前往秋沙钱汤"
        },
        {
          "role": "精神的路人",
          "text": "听说有只发狂的野林猪在镇守之森外围乱窜，你前几天不还去过那附近散步吗，有看见野林猪吗？"
        },
        {
          "role": "疲惫的路人",
          "text": "唔…没有…"
        },
        {
          "role": "精神的路人",
          "text": "没有吗…那有见过奇怪的小孩吗？还是那片地方，就这两天，有个小孩到处打听魔女的下落。"
        },
        {
          "role": "精神的路人",
          "text": "那附近的传闻有点古怪啊…我们也过去探探真假吧！"
        },
        {
          "role": "疲惫的路人",
          "text": "我就算了吧。我想回家休息了，刚加完班太累了。"
        },
        {
          "role": "精神的路人",
          "text": "我先送你回家吧，你这状态…真担心你路上晕倒。"
        },
        {
          "role": "派蒙",
          "text": "你听见了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听见了，野林猪！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是魔女啦！不会是我们认识的魔女吧？呃…好在意…要不，我们先去看看怎么回事吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说起认识的人就不累了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "人之常情嘛！难道你不好奇吗？"
        },
        {
          "role": "派蒙",
          "text": "魔女出现必有大事发生！乌龙事件倒还好，但万一是真的，说不定能尽早帮上忙呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "其实我也是这么想的，走吧。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往传闻之地"
        },
        {
          "role": "派蒙",
          "text": "好像就在这附近了，我看看啊…野林猪…呃…魔女…"
        },
        {
          "role": "派蒙",
          "text": "没发现异样…看来是我们多虑了，警报解除！想想也是，我们什么时候在附近见过野林猪了…"
        },
        {
          "role": "派蒙",
          "text": "魔女就更不用说了，才不会无端出现在这种荒郊野外，她们都忙着干大事。"
        },
        {
          "role": "？？？",
          "text": "刻板印象。"
        },
        {
          "role": "？？？",
          "text": "魔女们为了取乐背地里可没少干无聊的事，让无辜的人遭殃，因此猎人有责任将她…"
        },
        {
          "role": "？？？",
          "text": "…嗯？你们？你们是艾莉丝的亲信！"
        },
        {
          "role": "？？？",
          "text": "你是鼎鼎大名的旅行者，你是派蒙。"
        },
        {
          "role": "派蒙",
          "text": "欸？！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…猎人？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "等、等一下，我重说。"
        },
        {
          "role": "布伦妮",
          "text": "我叫布伦妮，是艾莉丝的…朋友！对，朋友。受她邀请来这边处理一件…呃…「魔女相关事件」。"
        },
        {
          "role": "布伦妮",
          "text": "因某些不可抗因素我跟她失联了，所以…"
        },
        {
          "role": "派蒙",
          "text": "她就是那个打听魔女下落的奇怪的小孩？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看起来很像。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "我都听见了！请不要露出那种眼神，我不是那种到处乱晃的怪小孩！"
        },
        {
          "role": "布伦妮",
          "text": "我只是…忙着做专业调查。总之我认识艾莉丝！"
        },
        {
          "role": "派蒙",
          "text": "真的假的？你好像有点心虚？"
        },
        {
          "role": "布伦妮",
          "text": "你们不信？看，这些是艾莉丝给我的，都是魔女的道具。"
        },
        {
          "role": "布伦妮",
          "text": "你的话，应该能感应到这上面的魔法气息。"
        },
        {
          "role": "派蒙",
          "text": "铃铛，锤子，还有一本…破破旧旧的书？虽然看上去也不算普通，但好像不符合魔女的…呃…审美？"
        },
        {
          "role": "布伦妮",
          "text": "不对劲。就算你不认识这些魔女道具，至少这本素论派经典教材你没理由认不出来。"
        },
        {
          "role": "布伦妮",
          "text": "坊间传闻金色旅者身旁的小旅伴在须弥教令院有着很高的造诣，读过不少书…"
        },
        {
          "role": "布伦妮",
          "text": "这可是八十年前的好货，经典中的经典。"
        },
        {
          "role": "派蒙",
          "text": "我？我吗？原来坊间对我的评价这么高！"
        },
        {
          "role": "派蒙",
          "text": "咳呃…确实是本好东西，刚、刚刚没说完呢。"
        },
        {
          "role": "派蒙",
          "text": "呀——这铃铛怎么突然响起来了！"
        },
        {
          "role": "布伦妮",
          "text": "从理论上讲，它能感应到「局地性异常魔力波动」。"
        },
        {
          "role": "派蒙",
          "text": "啊？"
        },
        {
          "role": "布伦妮",
          "text": "简单来说，就是有不寻常力量在附近涌现啦！"
        },
        {
          "role": "布伦妮",
          "text": "哈，都搞错这么多回了，这次总该是魔女了！"
        },
        {
          "role": "派蒙",
          "text": "什么跟什么呀？我都听糊涂了…你是说魔女在附近？"
        },
        {
          "role": "布伦妮",
          "text": "总之快跟上，很快你们就知道我没撒谎了。"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|沾染「魔法气息」的团子牛奶}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "跟上布伦妮，查看情况"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调查",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哇，是魔物！说好的魔女呢！"
        },
        {
          "role": "布伦妮",
          "text": "走太急锤子忘拿了！我去捡回来，可以请你先把魔物清理掉吗…对不起，谢谢你。"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|冰霜骗骗花|1}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "与布伦妮对话"
        },
        {
          "role": "派蒙",
          "text": "还好有你在，反应真快！"
        },
        {
          "role": "布伦妮",
          "text": "跟传闻一样，战斗力高得离谱，谢谢你出手啊。刚刚是我太鲁莽了，向你们道歉。"
        },
        {
          "role": "布伦妮",
          "text": "我没撒谎！艾莉丝说过，铃铛响起，魔女就有概率出现…只是没想到概率这么低。"
        },
        {
          "role": "派蒙",
          "text": "好啦，我相信你！"
        },
        {
          "role": "派蒙",
          "text": "如果是艾莉丝的道具，的确会有各种意想不到的功能，这点我们深有体会，对吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "艾莉丝的话应该是事实。",
              "dialogues": []
            },
            {
              "text": "但不一定是事实的全部…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "…我就知道。"
        },
        {
          "role": "派蒙",
          "text": "快看，这里有张卡片。"
        },
        {
          "role": "[[file",
          "text": "活动任务-野林猪与小魔女-卡片.png|center|300px]]"
        },
        {
          "role": "派蒙",
          "text": "「拥有幻想朋友的小朋友们，愿意一起做一件大好事吗？请找到面团大王。」"
        },
        {
          "role": "派蒙",
          "text": "上面还画了一只野林猪…难道是传闻里发疯乱窜的野林猪？"
        },
        {
          "role": "布伦妮",
          "text": "又是她的阴谋？"
        },
        {
          "role": "派蒙",
          "text": "你说什么？"
        },
        {
          "role": "布伦妮",
          "text": "…我怀疑这是坏人的阴谋，用小孩子熟悉的事物来引诱他们。"
        },
        {
          "role": "布伦妮",
          "text": "利用别人的幻想朋友来做陷阱，无耻！缺德！绝对不能原谅。"
        },
        {
          "role": "派蒙",
          "text": "这么严重…那也太坏了！我们不能坐视不理啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "先查清楚吧，最好是一场误会。",
              "dialogues": []
            },
            {
              "text": "但如果是真的，绝不姑息！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "又来了！这次该不会又是魔物吧…"
        },
        {
          "role": "布伦妮",
          "text": "有了前车之鉴，你们谨慎一些也合理，要不要跟上还是你们自己做决定吧。"
        },
        {
          "role": "派蒙",
          "text": "怎么办？我们也不能放着她一个人在这吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "走吧。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "跟上布伦妮的步伐"
        },
        {
          "role": "布伦妮",
          "text": "是魔女的据点！这次一定没错！"
        },
        {
          "role": "可莉",
          "text": "哒哒哒。冲呀，全都可以炸完～"
        },
        {
          "role": "？？？",
          "text": "炸飞！哈哈！统统炸飞！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可莉小心——",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "传闻是真的！发疯乱窜的野林猪…居然还会说话，而且说的话也太可怕了吧，到底要炸飞什么呀？"
        },
        {
          "role": "布伦妮",
          "text": "难道可莉说的话就不可怕吗？"
        },
        {
          "role": "可莉",
          "text": "咦？荣誉骑士哥哥和小派蒙！还有布伦妮姐姐！"
        },
        {
          "role": "派蒙",
          "text": "原来你们认识啊？"
        },
        {
          "role": "可莉",
          "text": "嗯。布伦妮姐姐不久前才搬到蒙德，她经常找可莉玩烤问游戏，可莉很喜欢！"
        },
        {
          "role": "派蒙",
          "text": "拷问？！"
        },
        {
          "role": "布伦妮",
          "text": "喂可莉，不是说好了不要随便告诉别人吗！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可莉她怎么你了？",
              "dialogues": []
            },
            {
              "text": "你怎么可莉她了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "不是你们想的那样，听我解释，是回答问题就能吃烤点心的游戏！"
        },
        {
          "role": "派蒙",
          "text": "还有这种游戏？我也想玩！"
        },
        {
          "role": "可莉",
          "text": "好呀，那下次小派蒙也一起，人越多火越大，烤起来就越热闹！"
        },
        {
          "role": "布伦妮",
          "text": "咳！先别管这个了！可莉怎么会在这里？这家伙没伤着你吧？"
        },
        {
          "role": "可莉",
          "text": "不是家伙是爆米花噢，它是可莉的新朋友，我们刚刚在玩，它不会伤害可莉的。"
        },
        {
          "role": "派蒙",
          "text": "等等…它跟这张卡片上画的一样欸！"
        },
        {
          "role": "可莉",
          "text": "这是面团大王画的求助卡！这个任务已经被魔女会领走啦。"
        },
        {
          "role": "布伦妮",
          "text": "魔女会？！可莉，魔女们在哪？能告诉姐姐吗？"
        },
        {
          "role": "可莉",
          "text": "可以哟。就在这个秘密基地里。可莉现在去喊她们，咻地一下就回来！"
        },
        {
          "role": "布伦妮",
          "text": "我说过吧，这次一定没错，魔女果然在附近。"
        },
        {
          "role": "派蒙",
          "text": "既然是魔女不是魔物，那为什么要摆出作战姿势啊？"
        },
        {
          "role": "布伦妮",
          "text": "你有所不知…"
        },
        {
          "role": "可莉",
          "text": "我们来啦——"
        },
        {
          "role": "可莉",
          "text": "小魔女会登场！"
        },
        {
          "role": "可莉",
          "text": "刚刚我们商量了一下，瑶瑶说我们应该叫小魔女会，因为小魔女们还没有长大。"
        },
        {
          "role": "布伦妮",
          "text": "（什么？！小魔女会又是怎么回事啊…之前没说有小魔女会啊…）"
        },
        {
          "role": "可莉",
          "text": "这是可莉创办的小魔女会哦。我是小魔女可莉。"
        },
        {
          "type": "subtitle",
          "text": "可莉（Klee）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「火花骑士」「嘟嘟可最好的朋友」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「蒙德新晋涂鸦画家」等等",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "且永远都是——",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「最棒最听话最可爱的好孩子（妈妈说的）」",
          "narration": true
        },
        {
          "role": "瑶瑶",
          "text": "旅行者和派蒙，又见面啦。嘻嘻，每次见你们都特别高兴，总会有好事发生。"
        },
        {
          "role": "瑶瑶",
          "text": "可莉说有新朋友来秘密基地了，礼节上我们应该重新自我介绍一下，就由我先开始吧。"
        },
        {
          "role": "瑶瑶",
          "text": "我是小魔女瑶瑶，家乡在璃月。最近才加入小魔女会，请多多指教。"
        },
        {
          "type": "subtitle",
          "text": "瑶瑶（Yaoyao）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「体贴热心的小大人」「萝卜料理烹饪小能手」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「成语活学活用（尽管有时错用）标兵」等等",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "还有就是——",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「歌尘浪市真君最小最强弟子」",
          "narration": true
        },
        {
          "role": "布伦妮",
          "text": "哦…你好。"
        },
        {
          "role": "瑶瑶",
          "text": "七七，轮到你啦。不着急哦，就按刚刚排练的来，还记得要说什么吗？"
        },
        {
          "role": "七七",
          "text": "嗯。我是小魔女七七。本子上是这么写的，说完了。"
        },
        {
          "type": "subtitle",
          "text": "七七（Qiqi）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「刮花了白马仙人的车（已经忘了）」「柔软体操健儿」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「冰冰凉凉冻冻小手」等等",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "不得不提的是——",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「玉京台片区儿童速记比赛第七名」",
          "narration": true
        },
        {
          "role": "七七",
          "text": "旅行者，派蒙，一直在心里，不用写也能记住。"
        },
        {
          "role": "七七",
          "text": "新朋友，新面孔，我会努力记住。"
        },
        {
          "role": "早柚",
          "text": "呼…啊…到我了？两位老朋友好，新朋友你也好，小魔女早柚，参上。"
        },
        {
          "type": "subtitle",
          "text": "早柚（Sayu）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「忍法：逃跑术宗家」「高效休眠与成长学高手」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「『不倒貉貉』中之人」等等",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "同时还是——",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「终末番最具潜力的忍者」",
          "narration": true
        },
        {
          "role": "布伦妮",
          "text": "呃…小朋…小魔女们好，叫我布伦妮就好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小魔女会！太可爱了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "还有跟艾莉丝和尼可一样的登场魔法，有模有样的嘛。"
        },
        {
          "role": "可莉",
          "text": "嘻嘻。妈妈是很厉害的大魔女，所以可莉是很厉害的小魔女！"
        },
        {
          "role": "派蒙",
          "text": "布伦妮，原来你说魔女在附近指的就是小魔女呀？"
        },
        {
          "role": "布伦妮",
          "text": "当、当然。小魔女当然也是魔女。"
        },
        {
          "role": "布伦妮",
          "text": "（是艾莉丝的授意？她们听命于大魔女会吗…）"
        },
        {
          "role": "可莉",
          "text": "…布伦妮姐姐是好人！是可莉的朋友。妈妈也说布伦妮姐姐是她的朋友。"
        },
        {
          "role": "布伦妮",
          "text": "朋友？！你妈妈真这么说的？"
        },
        {
          "role": "派蒙",
          "text": "为什么她一脸震惊的样子，刚刚不是她自己说跟艾莉丝是朋友吗？"
        },
        {
          "role": "可莉",
          "text": "小派蒙和布伦妮姐姐，要加入小魔女会吗？"
        },
        {
          "role": "瑶瑶",
          "text": "来加入我们吧！一起分享秘密基地里的零食和玩具。"
        },
        {
          "role": "可莉",
          "text": "还有妈妈做的出场魔法！她说可莉也能像她那样把这个好看的魔法挂在其他小魔女身上。"
        },
        {
          "role": "布伦妮",
          "text": "我就免了吧。早就不玩过家家的游戏了。"
        },
        {
          "role": "派蒙",
          "text": "先不说有零食畅吃这种好事，登场魔法不管看多少次都觉得很酷！你觉得呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "报告，我们家派蒙想报名参加！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呃！等一等…我还没做好准备呢。别忘了，艾莉丝最喜欢给人下各种考验了，说不定可莉也遗传了这一点。"
        },
        {
          "role": "派蒙",
          "text": "现在信誓旦旦，万一没通过考验就要闹笑话了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "放心，有我在呢。",
              "dialogues": []
            },
            {
              "text": "今天必须让派蒙当上小魔女！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呜…旅行者…"
        },
        {
          "role": "派蒙",
          "text": "那、请问一下各位小魔女，要通过什么试炼才能加入小魔女会呢？"
        },
        {
          "role": "早柚",
          "text": "既然可莉发出了邀请，只要派蒙同意了就算加入了。我们也是这么加入的。"
        },
        {
          "role": "可莉",
          "text": "没错哦。"
        },
        {
          "role": "派蒙",
          "text": "意外地简单呢！"
        },
        {
          "role": "布伦妮",
          "text": "很正常，小孩子的世界很简单。复杂规则都是无聊的大人创造出来的。"
        },
        {
          "role": "派蒙",
          "text": "好！那我现在算是小魔女了吗？我的登场魔法会长什么样啊…好期待…"
        },
        {
          "role": "可莉",
          "text": "妈妈说，登场魔法上的内容是非常重要的第一印象，应该让熟悉小魔女的人先想好。"
        },
        {
          "role": "可莉",
          "text": "只要在心里想好就可以了哦。然后牵着可莉的手，魔法就能传递啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我来想吧！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘻嘻，说到最熟悉我的人肯定非你莫属，那就拜托你了！"
        },
        {
          "role": "派蒙",
          "text": "我其实还挺好奇的，在你印象里，我会是一个怎样的小魔女呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "威风凛凛的小魔女！",
              "dialogues": []
            },
            {
              "text": "可可爱爱的小魔女！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "可莉",
          "text": "小派蒙，把手伸出来。"
        },
        {
          "role": "可莉",
          "text": "好啦！小魔女派蒙试试自我介绍吧。"
        },
        {
          "role": "派蒙",
          "text": "这样就好了？我来试试，咳——"
        },
        {
          "role": "派蒙",
          "text": "大家好，我是小魔女派蒙！"
        },
        {
          "type": "subtitle",
          "text": "威风凛凛的小魔女"
        },
        {
          "type": "subtitle",
          "text": "派蒙（Paimon）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「最强场外应援」「旅行经费操盘手」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「学识正以惊人速度增长的预备『帝利耶悉』」等等",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "无论如何——",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「派蒙是最好的伙伴」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "可可爱爱的小魔女"
        },
        {
          "type": "subtitle",
          "text": "派蒙（Paimon）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「席卷餐桌的白色旋风」「起难听绰号大师」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「身型小小辈分大大头衔多多」等等",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "无论如何——",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「派蒙是最好的伙伴」",
          "narration": true
        },
        {
          "role": "布伦妮",
          "text": "恭喜恭喜。那个…各位小魔女，是不是也该开始做正事了呢？它好像不太正常…"
        },
        {
          "role": "派蒙",
          "text": "刚才可莉说小魔女会领了任务…现在我也是小魔女会的一员，要好好了解状况才行！"
        },
        {
          "role": "派蒙",
          "text": "可以给我们详细讲讲吗？"
        },
        {
          "role": "早柚",
          "text": "爆米花的事情好复杂…要说好久，还是先找个能坐下来的地方吧，站着太累了。"
        },
        {
          "role": "可莉",
          "text": "好耶，那我们开茶会吧！茶会最适合一起说好多好多话啦。"
        },
        {
          "role": "瑶瑶",
          "text": "好主意。我负责去准备茶会上的零食和点心。"
        },
        {
          "role": "早柚",
          "text": "我负责摆凳子。"
        },
        {
          "role": "可莉",
          "text": "可莉要去选玩具，放在茶会上给大家玩。"
        },
        {
          "role": "七七",
          "text": "喔…"
        },
        {
          "role": "瑶瑶",
          "text": "七七，我们一起，你也挑点喜欢吃的。"
        },
        {
          "role": "可莉",
          "text": "荣誉骑士哥哥和布伦妮姐姐，这个秘密基地你们可以随便逛随便玩哦，小魔女会欢迎你们。"
        },
        {
          "role": "布伦妮",
          "text": "行吧…只能找个歇脚的地方边看书边等了。"
        },
        {
          "type": "subtitle",
          "text": "等待小魔女茶会开始"
        },
        {
          "type": "subtitle",
          "text": "与可莉对话"
        },
        {
          "type": "subtitle",
          "text": "完成任务嘟嘟可满垒大传球",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与瑶瑶和七七对话"
        },
        {
          "type": "subtitle",
          "text": "完成任务团团月桂手牵手",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与早柚对话"
        },
        {
          "type": "subtitle",
          "text": "完成任务礼貉出逃记",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与布伦妮对话"
        },
        {
          "type": "subtitle",
          "text": "完成任务猎魔演练",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "参加小魔女茶会"
        },
        {
          "role": "派蒙",
          "text": "小魔女的茶会似乎准备好了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等待茶会开始",
              "dialogues": []
            }
          ]
        },
        {
          "role": "可莉",
          "text": "铛铛铛——欢迎来到小魔女的茶会！"
        },
        {
          "role": "派蒙",
          "text": "布伦妮，你要喝什么？手够得着吗？我帮你拿。"
        },
        {
          "role": "布伦妮",
          "text": "咳，那就来杯热茶吧，不加糖谢谢。"
        },
        {
          "role": "早柚",
          "text": "秘密基地没有茶叶哦，太苦了，我们都不爱喝。"
        },
        {
          "role": "七七",
          "text": "热的，不喜欢。团子牛奶，凉凉的，跟椰奶一样，喜欢。"
        },
        {
          "role": "布伦妮",
          "text": "那没办法了，我喝团子牛奶好了。"
        },
        {
          "role": "派蒙",
          "text": "我看你本来就盯着这个吧！"
        },
        {
          "role": "布伦妮",
          "text": "还是赶紧开会吧！"
        },
        {
          "role": "布伦妮",
          "text": "这只会讲话的野林猪到底是…"
        },
        {
          "role": "可莉",
          "text": "爆米花是幻想朋友！"
        },
        {
          "role": "布伦妮",
          "text": "幻想朋友？！"
        },
        {
          "role": "布伦妮",
          "text": "不对，不应该啊。一般来说，在现实世界中，我们是看不见别人的幻想朋友的。"
        },
        {
          "role": "派蒙",
          "text": "对哦，刚刚聊到你们的幻想朋友，都是通过魔法，仙术或者忍术我们才能看见。"
        },
        {
          "role": "派蒙",
          "text": "以前，倒是还借助过丽莎的眼镜型探测仪…{{#info:温迪传说任务第一幕[[若你困于无风之地]]}}"
        },
        {
          "role": "布伦妮",
          "text": "你们怎么判断它就是幻想朋友的？"
        },
        {
          "role": "爆米花",
          "text": "幻想朋友！真的朋友！"
        },
        {
          "role": "可莉",
          "text": "可莉不知道哦，但可莉相信爆米花！"
        },
        {
          "role": "布伦妮",
          "text": "好吧…我换个问题，你们怎么找到它的？"
        },
        {
          "role": "瑶瑶",
          "text": "我们在外面玩的时候捡到面团大王求助卡，一路找过去就找到了面团大王和爆米花。"
        },
        {
          "role": "可莉",
          "text": "面团大王是好人！爆米花在流浪，是面团大王先发现爆米花的。"
        },
        {
          "role": "爆米花",
          "text": "好人，哈哈，好哈，哈人。"
        },
        {
          "role": "派蒙",
          "text": "呃…它一直这样吗？看起来不太能正常交流啊…"
        },
        {
          "role": "七七",
          "text": "独自一个流浪的时候，不太好，又生气，跑得也快…面团大王看起来很苦恼。"
        },
        {
          "role": "七七",
          "text": "跟小魔女在一起好多了，有时说话，有时还会笑。"
        },
        {
          "role": "布伦妮",
          "text": "幻想朋友大多基于儿童的想象产生，它亲近小孩倒也合理。"
        },
        {
          "role": "派蒙",
          "text": "那就不奇怪了，我总结一下，就是说爆米花在流浪，被面团大王捡到了…"
        },
        {
          "role": "派蒙",
          "text": "面团大王又找来了小魔女会帮忙，分工合作！"
        },
        {
          "role": "可莉",
          "text": "嗯！小魔女会负责陪着爆米花，面团大王专心调查，我们约好了明天会合。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看来是一场误会。",
              "dialogues": []
            },
            {
              "text": "求助卡并不是坏人的策划。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "…我也没说一定是。我说的是怀疑。"
        },
        {
          "role": "派蒙",
          "text": "那我们小魔女会接下来有什么计划？"
        },
        {
          "role": "可莉",
          "text": "可莉决定用小魔女的办法去帮助爆米花！"
        },
        {
          "role": "布伦妮",
          "text": "比如说？会用到跟大魔女一脉相承的魔法吗？"
        },
        {
          "role": "可莉",
          "text": "可莉也不知道哦，可莉第一次当小魔女…布伦妮姐姐觉得小魔女应该做什么？"
        },
        {
          "role": "布伦妮",
          "text": "你们才是小魔女吧，怎么问起我来了…"
        },
        {
          "role": "布伦妮",
          "text": "（等等，倒是个套取内幕信息的好机会…）"
        },
        {
          "role": "布伦妮",
          "text": "咳，不妨从模仿开始吧！可莉，你妈妈的大魔女会里都有些什么成员呀？她们各自擅长做什么呢？"
        },
        {
          "role": "可莉",
          "text": "唔…有妈妈。妈妈跟可莉一样，喜欢跟朋友们一起大冒险！"
        },
        {
          "role": "可莉",
          "text": "有一个会讲预言的魔女阿姨。"
        },
        {
          "role": "早柚",
          "text": "是睡觉！没睡好，才变成这样。没有问题是睡觉解决不了的，我们都该去睡觉…"
        },
        {
          "role": "可莉",
          "text": "有一个话很多的魔女阿姨。"
        },
        {
          "role": "瑶瑶",
          "text": "不能随便下这样的结论，我们暂时还做不到虑周草密，呃不对，虑周藻密，那么更应该郑重其事。"
        },
        {
          "role": "瑶瑶",
          "text": "在弄清缘由前，要好好陪爆米花玩，别让他到处游荡吓到路人，等面团大王的好消息！"
        },
        {
          "role": "可莉",
          "text": "有一个喜欢写故事的魔女阿姨。"
        },
        {
          "role": "七七",
          "text": "「睡觉」划掉，还剩「大冒险」，「玩」…都写下来了。"
        },
        {
          "role": "可莉",
          "text": "还有一个很聪明的魔女阿姨。还有…还有忘了。"
        },
        {
          "role": "派蒙",
          "text": "呃…快动啊，我的脑子！"
        },
        {
          "role": "派蒙",
          "text": "有了！既然幻想朋友来自于小朋友，不如试着问问关于它的小朋友的事？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "聪明啊派蒙！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那个，爆米花，你的小朋友呢？你们怎么分开了呀？"
        },
        {
          "role": "爆米花",
          "text": "嚯！哈！砸砸砸！小焰很难受，我要帮她！你要帮她！"
        },
        {
          "role": "布伦妮",
          "text": "小焰是它的小朋友吧…她怎么了？要怎么帮她？"
        },
        {
          "role": "爆米花",
          "text": "……"
        },
        {
          "role": "早柚",
          "text": "面团大王交代过，爆米花很可能失忆了，能记住的事情不多。"
        },
        {
          "role": "七七",
          "text": "跟七七一样，记不住。但又不一样，爆米花不写字。"
        },
        {
          "role": "爆米花",
          "text": "小焰会写！"
        },
        {
          "role": "爆米花",
          "text": "撞翻眼泪虫，踢飞鼻涕怪，管它多么凶和坏，一拳打到太空外！"
        },
        {
          "role": "瑶瑶",
          "text": "这段顺口溜爆米花念了好多遍呢。"
        },
        {
          "role": "爆米花",
          "text": "凶神恶煞都打败，统统装进大麻袋！"
        },
        {
          "role": "派蒙",
          "text": "小焰写的？好有性格！"
        },
        {
          "role": "爆米花",
          "text": "炸飞！嚯嚯！"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯…从她的作品能体会到。说不定她长大后会是个狂野派诗人？"
        },
        {
          "role": "爆米花",
          "text": "大画家！大美食家！大映影师！"
        },
        {
          "role": "布伦妮",
          "text": "喂，高期待对成长而言是一种压力好不好。万一她长大后都没做到呢？"
        },
        {
          "role": "爆米花",
          "text": "小焰最好！怎么样都好！"
        },
        {
          "role": "布伦妮",
          "text": "记得她长什么样吗？我们帮你去找她。"
        },
        {
          "role": "爆米花",
          "text": "……"
        },
        {
          "role": "爆米花",
          "text": "爱小辫子…爱花裙子，爱笑。还有…哇吼！"
        },
        {
          "role": "布伦妮",
          "text": "确实很难沟通呢…"
        },
        {
          "role": "派蒙",
          "text": "好像没有更多线索了，我们应该怎么办？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刚才提到面团大王也在调查…",
              "dialogues": []
            },
            {
              "text": "我们就等明天一起汇总线索吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "只能等明天会一会所谓的「面团大王」了。那，先散会？"
        },
        {
          "role": "可莉",
          "text": "好耶！我们可以去玩噜！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（可莉&瑶瑶&七七&早柚）"
        },
        {
          "role": "可莉",
          "text": "大家，小魔女会已经创办3天了！距离100天还有…还有…唔…不会算。"
        },
        {
          "role": "可莉",
          "text": "但是距离10天还有7天！10哦，要两只手都用上才能数得完的大数字哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真热闹呀。",
              "dialogues": []
            },
            {
              "text": "小魔女们为什么会聚在稻妻？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑶瑶",
          "text": "上次在雪山见过早柚和可莉后，我们就约定好要一起出来玩了。{{#info:[[「炽魂斗士的雪界之旅」]]}}"
        },
        {
          "role": "瑶瑶",
          "text": "最近收到早柚的邀请，我就立刻去请示师父和白术先生，他们都同意我带着七七过来交朋友。"
        },
        {
          "role": "七七",
          "text": "没来过的地方，樱花，好看。红红的女孩很爱笑，会睡觉的女孩，唔…很会睡觉。"
        },
        {
          "role": "派蒙",
          "text": "可莉呢？可莉是自己来的吗？"
        },
        {
          "role": "可莉",
          "text": "可莉来过稻妻，可莉认识路！妈妈说了，可莉会长大，会有自己的世界，她很支持可莉来找朋友玩！{{#info:[[堇庭华彩真说]]}}"
        },
        {
          "role": "可莉",
          "text": "阿贝多哥哥和小杜林哥哥送我上船，船上有很多冒险家哥哥姐姐陪着可莉，一下船，早柚就在码头等着可莉啦。"
        },
        {
          "role": "早柚",
          "text": "哼哼。这次聚会是终末番对我执行了高难度任务的嘉奖！那位大人批了假期和经费，还让巫女姐姐帮忙招待过来的朋友。"
        },
        {
          "role": "派蒙",
          "text": "真好啊。看到你们几个玩得这么好，不知道为什么，有种很幸福的感觉…"
        },
        {
          "role": "可莉",
          "text": "好多朋友，就像好多嘟嘟可一样，可莉很开心！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（布伦妮&爆米花）"
        },
        {
          "role": "布伦妮",
          "text": "爆米花是吧，你快回忆一下，是不是被一个长得很好看的女人抓过来的？"
        },
        {
          "role": "爆米花",
          "text": "撞翻眼泪虫！炸！炸飞！"
        },
        {
          "role": "布伦妮",
          "text": "想起来了？你也不能原谅她对吧！没猜错的话她就是所谓的面团大王。"
        },
        {
          "role": "爆米花",
          "text": "踢飞鼻涕怪！炸！炸飞！"
        },
        {
          "role": "布伦妮",
          "text": "那你有没有见过一只长得很可爱的小狗？它也是幻想朋友。"
        },
        {
          "role": "爆米花",
          "text": "炸！炸飞！统统装进大麻袋！"
        },
        {
          "role": "布伦妮",
          "text": "什么嘛…根本不是在回答我啊…"
        }
      ],
      "collapse_ranges": [
        [
          282,
