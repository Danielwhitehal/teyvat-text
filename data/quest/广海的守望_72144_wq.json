{
  "quest_id": 72144,
  "chapter_num": null,
  "chapter_title": "广海的守望",
  "type": "wq",
  "route": "Hiromi's Watch",
  "stories": [
    {
      "story_id": 72144,
      "title": "广海的守望",
      "description": "役人广海似乎在烦恼着什么，或许正需要人去帮忙…",
      "dialogues": [
        {
          "role": "广海",
          "text": "喂，可疑的外国人！在这里鬼鬼祟祟的做什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我只是路过。",
              "dialogues": []
            },
            {
              "text": "也不知道谁才更可疑…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "外国人，如果没有要事请不要打扰我，不然就请随我到远国监司待问。"
        },
        {
          "role": "广海",
          "text": "虽然我不知道你是怎么来到这里的，但妨碍武士公务可是重罪。"
        },
        {
          "role": "广海",
          "text": "勘定奉行大人若是得知，定会从严发落。"
        },
        {
          "role": "广海",
          "text": "为了你自身的安全，我劝你离我远点。"
        },
        {
          "role": "旅行者",
          "text": "勘定奉行？"
        },
        {
          "role": "广海",
          "text": "怎么？如今的外国人，连奉行大人都不怕了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里不是勘定辖地。",
              "dialogues": []
            },
            {
              "text": "你没有在工作吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "你…！"
        },
        {
          "role": "广海",
          "text": "你说的没错…但就算武士也有权享受自己的闲暇，你们外国人是不会懂的！"
        },
        {
          "role": "旅行者",
          "text": "你在做什么？"
        },
        {
          "role": "广海",
          "text": "与你无关。"
        },
        {
          "role": "广海",
          "text": "好了，这次就…放你一马，请不要打扰我了。"
        },
        {
          "role": "旅行者",
          "text": "别紧张，问问而已。"
        },
        {
          "role": "广海",
          "text": "请不要在我执勤时问无聊的问题。"
        },
        {
          "role": "广海",
          "text": "好了，请不要再打扰我了，请自觉离开吧。"
        },
        {
          "role": "旅行者",
          "text": "关于广海…"
        },
        {
          "role": "阿顺",
          "text": "他呀，是个好人…只可惜还是个大男孩，还需要时间慢慢长大。"
        },
        {
          "role": "阿顺",
          "text": "不过要我看，不成熟也比长坏了强。"
        },
        {
          "role": "阿顺",
          "text": "他有他的生计，有他的职责…"
        },
        {
          "role": "阿顺",
          "text": "不敢做出抉择，也不全是他的错吧。"
        },
        {
          "role": "阿顺",
          "text": "不过至少，他还有得选。"
        },
        {
          "role": "广海",
          "text": "…你怎么又来了？有话请快说！"
        },
        {
          "role": "广海",
          "text": "请不要妨碍我等人！"
        },
        {
          "role": "旅行者",
          "text": "在远离辖区的地方等人？"
        },
        {
          "role": "广海",
          "text": "你想说什么？"
        },
        {
          "role": "旅行者",
          "text": "等的不是正经人吧？"
        },
        {
          "role": "广海",
          "text": "当、当然不…你在质疑奉行方的公务人员吗！"
        },
        {
          "role": "广海",
          "text": "我是在执行公务，在这里等待…专业线人…接头…"
        },
        {
          "role": "旅行者",
          "text": "声音越来越小了呢。"
        },
        {
          "role": "广海",
          "text": "够了！离开，不然就以妨碍公务的罪名，请你跟我到远国监司走一趟！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好呀。",
              "dialogues": []
            },
            {
              "text": "悉听尊便。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "？！"
        },
        {
          "role": "广海",
          "text": "你就不怕被奉行大人治罪，被驱逐出境吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的把柄更明显吧？",
              "dialogues": []
            },
            {
              "text": "我自有门路。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "……"
        },
        {
          "role": "广海",
          "text": "此事…还请你不要向奉行大人申诉。"
        },
        {
          "role": "广海",
          "text": "不过…还不知…阁下想要了解些什么？"
        },
        {
          "role": "广海",
          "text": "我只是小小的役人而已，职责之外，所知甚少，恐怕帮不上忙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我能帮上你的忙。",
              "dialogues": []
            },
            {
              "text": "只是看不惯你们。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "想不到身为外国人，却懂得武士的仁义，实在佩服…"
        },
        {
          "role": "旅行者",
          "text": "一介役职，如此油滑。"
        },
        {
          "role": "广海",
          "text": "好啦，请不要再挖苦我了…我为刚刚的失礼深感抱歉，希望阁下能接受我的歉意。"
        },
        {
          "role": "广海",
          "text": "对了，还不知道阁下该如何称呼？"
        },
        {
          "role": "旅行者",
          "text": "叫我旅行者就好。"
        },
        {
          "role": "广海",
          "text": "旅行者阁下，既然你热心帮忙，我确实有事相求…"
        },
        {
          "role": "广海",
          "text": "是这样的，我曾有一位自幼相识的国外老友。「锁国令」下达后，就再也没有相见。"
        },
        {
          "role": "广海",
          "text": "我很担心她的安危，所以开始养成了投漂流瓶寄信的习惯。"
        },
        {
          "role": "广海",
          "text": "只是，直到现在都没有收到回信。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你说漂流瓶？",
              "dialogues": []
            },
            {
              "text": "你说了「漂流瓶」，是吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "小雀儿",
          "text": "有什么话请找我师兄说吧，反正你也不爱听我说话。"
        },
        {
          "role": "小雀儿",
          "text": "哼…就没人爱听我说话…"
        },
        {
          "role": "广海",
          "text": "是这个没错！里面还有她的徽章。"
        },
        {
          "role": "广海",
          "text": "真不知该如何感谢你…"
        },
        {
          "role": "旅行者",
          "text": "不介意我拆开读一读吧？"
        },
        {
          "role": "广海",
          "text": "欸？什么？请不要…"
        },
        {
          "role": "旅行者",
          "text": "「还记得『乌有亭』吗？」"
        },
        {
          "role": "广海",
          "text": "唔…？"
        },
        {
          "role": "旅行者",
          "text": "「我们会在那里相聚…」"
        },
        {
          "role": "广海",
          "text": "等等——"
        },
        {
          "role": "旅行者",
          "text": "「酒钱也随信寄来了。」"
        },
        {
          "role": "广海",
          "text": "好了，我说…"
        },
        {
          "role": "旅行者",
          "text": "「如果收到这封信的您…」"
        },
        {
          "role": "广海",
          "text": "请不要再念了！旅行者阁下，这样太没教养了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "瞧你强作正经的样子。",
              "dialogues": []
            },
            {
              "text": "写信时表情也这样？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "请不要再戏弄我了！如果想要帮忙就请直说吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抱歉。",
              "dialogues": []
            },
            {
              "text": "请你继续。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "近来，她的一位…老友告知我她还活得好好的。他们都是游历天地的冒险家，所以我很信任他的情报。"
        },
        {
          "role": "广海",
          "text": "奈何我这边职务在身，不可能远行冒险…"
        },
        {
          "role": "广海",
          "text": "本想拜托他替我送信，约好了在这里碰面传递口信。"
        },
        {
          "role": "广海",
          "text": "可是他一心宝藏，急匆匆地直奔了鸣神岛北端的古代遗迹…结果直到今天都音讯全无。"
        },
        {
          "role": "广海",
          "text": "我已经来过好几趟了，每天都会抽时间在这里等他。可我也不能总是糊弄上司开小差…"
        },
        {
          "role": "广海",
          "text": "所以此番希望能拜托旅行者阁下随我直接找到他，同他面议。"
        },
        {
          "role": "广海",
          "text": "那处遗迹如果我一个人去寻找，势必浪费很多时间…"
        },
        {
          "role": "广海",
          "text": "但如果旅行者阁下愿意一同前去的话，借助您的帮助，说不定可以不耽误任何事情。"
        },
        {
          "role": "广海",
          "text": "顺便，恰好漂流瓶在你的手里…也可以一并交到她的手上。"
        },
        {
          "role": "广海",
          "text": "这件事拜托旅行者阁下，还不知意下如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧。",
              "dialogues": []
            },
            {
              "text": "我们去会会他吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "嗯嗯，我们这就出发吧！"
        },
        {
          "type": "subtitle",
          "text": "前往鸣神岛北端寻找阿顺的踪迹"
        },
        {
          "role": "阿顺",
          "text": "欸，你怎么来了？而且还带着人？"
        },
        {
          "role": "阿顺",
          "text": "这和上次说的可不一样，我们不是说好单独见面了吗？"
        },
        {
          "role": "阿顺",
          "text": "哦，我明白了…如果是「那件」案子的话，告诉你的同事，现在还不是时候。"
        },
        {
          "role": "广海",
          "text": "不是那件案子…是上个星期，你答应我的那件事…"
        },
        {
          "role": "阿顺",
          "text": "不是那件？那是哪件…这阵子我可是守法得很，一件案子都没犯过！"
        },
        {
          "role": "阿顺",
          "text": "我们约好的不是这个时候啊，距离上次抓我坐牢也才半个月…"
        },
        {
          "role": "阿顺",
          "text": "哦，我明白了…你是想提前抓了我领功吧！"
        },
        {
          "role": "广海",
          "text": "你什么都没明白…你这种人抓了能领到什么功！"
        },
        {
          "role": "阿顺",
          "text": "你这么说可就太伤人了，我多少算是盗宝团的干部…在道上也是有名声的。"
        },
        {
          "role": "阿顺",
          "text": "哦，我明白了…你一定是——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是盗宝团的人？",
              "dialogues": []
            },
            {
              "text": "解释一下，大人？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "唉…"
        },
        {
          "role": "阿顺",
          "text": "盗宝团都不知道，你同事是新来的？"
        },
        {
          "role": "广海",
          "text": "你闭嘴。"
        },
        {
          "role": "广海",
          "text": "是这样的，旅行者阁下…这位阿顺，是我的线人。恳请阁下千万不要对此多加议论…"
        },
        {
          "role": "广海",
          "text": "今天我与这位外国…朋友来，正是想拜托你告知「大姐」的下落，我…很想和她再次联络。"
        },
        {
          "role": "阿顺",
          "text": "哦——哈哈哈哈哈！"
        },
        {
          "role": "广海",
          "text": "笑什么，你有什么毛病吗！"
        },
        {
          "role": "旅行者",
          "text": "你有什么毛病吗！"
        },
        {
          "role": "阿顺",
          "text": "哈哈哈哈哈，你可真有意思！"
        },
        {
          "role": "阿顺",
          "text": "不瞒你说，旅行者。我们三个人从尿裤子的年纪就认识了。"
        },
        {
          "role": "阿顺",
          "text": "那时候没有「锁国令」。广海这家伙，也不像现在这样死板。"
        },
        {
          "role": "阿顺",
          "text": "唉，瞧瞧奉行府的规训，把一个好孩子变成了什么样子。"
        },
        {
          "role": "广海",
          "text": "把一个好孩子变成了保护民众的奉公者，把一个坏孩子变成了盗宝团的贼。"
        },
        {
          "role": "阿顺",
          "text": "行了行了，「锁国令」推行之前，你不就早知道我们的身份了？"
        },
        {
          "role": "阿顺",
          "text": "她也是因为顾虑这点才离开稻妻的。"
        },
        {
          "role": "阿顺",
          "text": "我猜你又在信里写了「乌有亭」吧？我也挺怀念的。"
        },
        {
          "role": "阿顺",
          "text": "「锁国令」下达的前一天，我们还在那里喝了饯别酒。"
        },
        {
          "role": "阿顺",
          "text": "你的小心思，谁都看得出来。"
        },
        {
          "role": "阿顺",
          "text": "就是可惜了，你们的将军并不喜欢外国来的漂流客。"
        },
        {
          "role": "广海",
          "text": "…请直接谈正事。"
        },
        {
          "role": "阿顺",
          "text": "这也算不得正事吧？"
        },
        {
          "role": "阿顺",
          "text": "好啦，不逗你了。这个忙我真心想帮，但可惜…帮不上。"
        },
        {
          "role": "广海",
          "text": "什么意思？"
        },
        {
          "role": "阿顺",
          "text": "…说来话长。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我有一点想打人。",
              "dialogues": [
                {
                  "role": "广海",
                  "text": "巧了，我也是。"
                }
              ]
            },
            {
              "text": "讲重点。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿顺",
          "text": "我和「大姐」不久前在绝云间踩点，绝云间你知道吧？"
        },
        {
          "role": "阿顺",
          "text": "那里是仙人的居所，金色的石珀闪闪发光、还有那幽蓝的夜泊石…"
        },
        {
          "role": "阿顺",
          "text": "天赐的珍奇异宝都在里面埋藏着，传说那些个仙人呀，就这么…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "讲重点！",
              "dialogues": []
            },
            {
              "text": "我去过。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿顺",
          "text": "哦…好的，好的。我和「大姐」不是在绝云间踩点吗…起初一切顺利，我们的踪迹就连仙人都瞒过了…"
        },
        {
          "role": "阿顺",
          "text": "本来我们约好踩完点去吃些好的犒劳犒劳自己，正往回走呢…"
        },
        {
          "role": "阿顺",
          "text": "哪知在那重岩叠嶂云海之间，只听倏忽一声尖啸！又听唰唰两声剑响！"
        },
        {
          "role": "阿顺",
          "text": "再听仆仆两声闷响，又听那一男一女两声怒喝合为一声——「大胆贼人，哪里逃！」"
        },
        {
          "role": "阿顺",
          "text": "我和「大姐」一齐心说「完了！」乃是遇上了古华派的侠侣！话说那位大侠，他那叫一个…"
        },
        {
          "role": "旅行者",
          "text": "讲重点！！"
        },
        {
          "role": "阿顺",
          "text": "男的叫孙宇，女的叫小雀儿。没了。"
        },
        {
          "role": "阿顺",
          "text": "然后我和「大姐」分道扬镳，不知道她跑到哪去了。"
        },
        {
          "role": "广海",
          "text": "感谢旅行者阁下帮忙，为我省下不少时间…"
        },
        {
          "role": "广海",
          "text": "搜索范围缩小了不少，接下来只需要…去问问那两位侠客？就有希望找到她了。"
        },
        {
          "role": "广海",
          "text": "这个漂流瓶，和她的徽章…必须交给她我才能安心。"
        },
        {
          "role": "广海",
          "text": "旅行者阁下，虽然很不好意思，但可否再次辛苦你…"
        },
        {
          "role": "旅行者",
          "text": "你不亲自去吗？"
        },
        {
          "role": "广海",
          "text": "我…还有自己的职责，不便离开。"
        },
        {
          "role": "阿顺",
          "text": "「我还有自己的职责，不便离开~」"
        },
        {
          "role": "阿顺",
          "text": "哼，没出息！"
        },
        {
          "role": "阿顺",
          "text": "领着役人的那点破津贴，看别人脸色过着一成不变的日子，还把自己当回事了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": [
                {
                  "role": "广海",
                  "text": "……"
                }
              ]
            },
            {
              "text": "你相信他的话吗？",
              "dialogues": [
                {
                  "role": "广海",
                  "text": "阿顺很讨厌，也不是什么好人，但可以信任。"
                },
                {
                  "role": "阿顺",
                  "text": "哼，亏你还有点良心。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿顺",
          "text": "反正时候不早了，你也该回去当差了。"
        },
        {
          "role": "阿顺",
          "text": "唉，叫我怎么说才好…你又想要做一个好役人，做一个奉行大人的跟屁虫…"
        },
        {
          "role": "阿顺",
          "text": "又放不下从儿时保存至今的情谊，忘记不了心里的悸动…"
        },
        {
          "role": "阿顺",
          "text": "即使她和你不再是同类了。"
        },
        {
          "role": "阿顺",
          "text": "你自己不敢做选择，只把该做的工作推给别人…"
        },
        {
          "role": "阿顺",
          "text": "…总有一天，选择会自己找上你。"
        },
        {
          "role": "阿顺",
          "text": "到时候，你会避无可避的。"
        },
        {
          "role": "广海",
          "text": "……"
        },
        {
          "role": "广海",
          "text": "…少教训我了。"
        },
        {
          "role": "阿顺",
          "text": "没错，没错，我是外国小贼，你是役职大人，应该你教训我才对。"
        },
        {
          "role": "阿顺",
          "text": "旅行者，我猜这次又要辛苦你一趟了。"
        },
        {
          "role": "阿顺",
          "text": "不陪你的役人朋友过家家了，我也有自己的职责要做。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还好吗？",
              "dialogues": []
            },
            {
              "text": "需要我帮忙吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "我还好，没事的。"
        },
        {
          "role": "广海",
          "text": "他说的…不是完全没有道理。"
        },
        {
          "role": "广海",
          "text": "不过这次，还是辛苦你了，旅行者阁下。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还真是倔强…",
              "dialogues": []
            },
            {
              "text": "但我只帮这一次。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "感谢你…下一次机会，我会自己好好把握的。"
        },
        {
          "role": "广海",
          "text": "再不回去的话上司要怪罪了。再次感谢旅行者阁下的帮助。"
        },
        {
          "role": "广海",
          "text": "请保重，有事到离岛找我就好。"
        },
        {
          "type": "subtitle",
          "text": "前往绝云间，寻找孙宇与小雀儿"
        },
        {
          "role": "孙宇",
          "text": "啊，是旅行者啊。足下的高义大名，璃月港无人不知，无人不晓。请问此次前来是…"
        },
        {
          "role": "旅行者",
          "text": "你说话怪怪的。"
        },
        {
          "role": "孙宇",
          "text": "想必那是因为，敝人正在教师妹学习待人接物的礼仪，正所谓「人无信不立，人无礼…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请不必多礼。",
              "dialogues": []
            },
            {
              "text": "鸡皮疙瘩起来了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "孙宇",
          "text": "请问有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "我在找一个女贼。"
        },
        {
          "role": "孙宇",
          "text": "哦，原来是追捕贼人的侠义之举，古华派定然支持！那么需要我们帮助吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她曾被你们追捕过。",
              "dialogues": []
            },
            {
              "text": "请问还有印象吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "孙宇",
          "text": "你这么一说，我倒是有点印象。"
        },
        {
          "role": "孙宇",
          "text": "那是大概一周前的事情了，我和师妹本在此仙境修习云游，哪知被两个小贼滋扰了清静。"
        },
        {
          "role": "孙宇",
          "text": "于是，我二人便替天行道，为这绝云间的诸位仙人清理家园净土…"
        },
        {
          "role": "孙宇",
          "text": "我们追逐那二贼从云翳深处直到那琥牢山，只见二贼身影忽起忽落，忽起忽落，忽起忽落…"
        },
        {
          "role": "旅行者",
          "text": "然后呢…？"
        },
        {
          "role": "孙宇",
          "text": "然后便少了一个贼影。我当即便道：「师妹！莫中了贼人奸计！」于是偕同小雀儿直追那女贼…"
        },
        {
          "role": "孙宇",
          "text": "我们在琥牢山忽上忽下，忽左忽右，忽前忽后，忽岩壁忽洞穴，忽云间忽深涧…"
        },
        {
          "role": "孙宇",
          "text": "简而言之，忽起忽落，忽起忽落，忽起忽落…"
        },
        {
          "role": "旅行者",
          "text": "再然后呢…？"
        },
        {
          "role": "孙宇",
          "text": "只听噗通一声！！"
        },
        {
          "role": "孙宇",
          "text": "那女贼便不见了身影。"
        },
        {
          "role": "孙宇",
          "text": "我与小雀儿搜寻半晌，也未曾见过一个人影…想必是不幸跌落山涧了吧。"
        },
        {
          "role": "孙宇",
          "text": "又或者，她其实轻功超群，早已溜之大吉，也并非全无可能。"
        },
        {
          "role": "孙宇",
          "text": "这便是我所知道的全部了，不知能否帮上你的忙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "多谢大侠相助。",
              "dialogues": []
            },
            {
              "text": "至少不是完全没用…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "孙宇",
          "text": "能帮上忙就好。顺便，我见山巅有几株清心生得格外可爱，不知可否——"
        },
        {
          "role": "旅行者",
          "text": "就此告辞！"
        },
        {
          "type": "subtitle",
          "text": "前往琥牢山，寻找「大姐」的踪迹"
        },
        {
          "type": "subtitle",
          "text": "与「大姐」对话"
        },
        {
          "role": "胭儿",
          "text": "咳咳…咳…！哈…哈…呼，终于出来了…"
        },
        {
          "role": "胭儿",
          "text": "多谢救我一命…陌生…人…？"
        },
        {
          "role": "胭儿",
          "text": "欸？！是你！"
        },
        {
          "role": "旅行者",
          "text": "你是…"
        },
        {
          "role": "胭儿",
          "text": "你不是那个…那个…！"
        },
        {
          "role": "旅行者",
          "text": "啊，「那个」啊…"
        },
        {
          "role": "胭儿",
          "text": "对！还有轻策庄那个…那个…！"
        },
        {
          "role": "旅行者",
          "text": "嗯嗯！就是「那个」！"
        },
        {
          "role": "胭儿",
          "text": "对对对！啊，所以…螭的遗骸，真的有用吗…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没用。",
              "dialogues": []
            },
            {
              "text": "眼见为实。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胭儿",
          "text": "啊——哈哈哈哈！"
        },
        {
          "role": "胭儿",
          "text": "原来在轻策庄就是你把我的小兄弟们都打趴下了，可真有你的。"
        },
        {
          "role": "胭儿",
          "text": "不管怎么说，这次多谢你救我脱险了。"
        },
        {
          "role": "胭儿",
          "text": "不然不知这破琥珀要把我封多久…里面可是难受死了…"
        },
        {
          "role": "胭儿",
          "text": "绝云间的仙人呀，个个小心眼！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "仙人救了你一命。",
              "dialogues": []
            },
            {
              "text": "还在人家地盘上呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胭儿",
          "text": "嘿嘿，你说的也对。"
        },
        {
          "role": "胭儿",
          "text": "当时我是为了躲避那对神经病侠侣，才不小心掉进这深坑里的。"
        },
        {
          "role": "胭儿",
          "text": "也是多亏此地的吐口水真君把我用琥珀层层包裹起来，我才毫发未伤。"
        },
        {
          "role": "胭儿",
          "text": "只不过这位真君呀，顾头不顾尾。完事也不把我放出来…"
        },
        {
          "role": "旅行者",
          "text": "仙人在惩罚小贼吧。"
        },
        {
          "role": "胭儿",
          "text": "你说的也有道理，哈哈哈哈哈！"
        },
        {
          "role": "胭儿",
          "text": "笑也笑够了…别愣着呀，我们快点离开这里吧。"
        },
        {
          "type": "subtitle",
          "text": "救出胭儿"
        },
        {
          "type": "subtitle",
          "text": "与胭儿对话"
        },
        {
          "role": "旅行者",
          "text": "是在等谁吗？"
        },
        {
          "role": "广海",
          "text": "…是又如何。"
        },
        {
          "role": "胭儿",
          "text": "所以，你一定是有事相求才来找我吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只是恰好路过。",
              "dialogues": []
            },
            {
              "text": "你怎么知道？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胭儿",
          "text": "你骗不过我。"
        },
        {
          "role": "胭儿",
          "text": "外来旅者的呆脸，再努力也是存不住秘密的。"
        },
        {
          "type": "subtitle",
          "text": "与胭儿对话"
        },
        {
          "role": "广海",
          "text": "旅行者阁下，请问有消息了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "暂时还没有。",
              "dialogues": []
            },
            {
              "text": "我还在努力。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "这样啊…"
        },
        {
          "role": "广海",
          "text": "没关系。如果找到了她，请尽快告诉我。"
        },
        {
          "type": "subtitle",
          "text": "与胭儿对话"
        },
        {
          "role": "胭儿",
          "text": "哦哦，是礼物吗？谢谢！"
        },
        {
          "role": "旅行者",
          "text": "是广海的心意。"
        },
        {
          "role": "胭儿",
          "text": "广海…那是谁啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们不认识的吗？",
              "dialogues": []
            },
            {
              "text": "他说他很想你。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胭儿",
          "text": "抱歉，我可不能认识抓贼的差人。"
        },
        {
          "role": "胭儿",
          "text": "尤其是笨蛋，尤其不行。"
        },
        {
          "role": "胭儿",
          "text": "不过…请替我谢谢他归还我的徽章。"
        },
        {
          "role": "胭儿",
          "text": "还有，「乌有亭」，不错的名字。有时间的话我会去喝几杯的。"
        },
        {
          "role": "胭儿",
          "text": "喝几杯，顺便认识认识那个笨蛋好了。"
        },
        {
          "type": "subtitle",
          "text": "回去找广海"
        },
        {
          "role": "阿顺",
          "text": "有话快说，盗宝团可浪费不起时间。"
        },
        {
          "role": "广海",
          "text": "怎么样，有「大姐」的消息了吗？"
        },
        {
          "role": "旅行者",
          "text": "我们说过话了。"
        },
        {
          "role": "广海",
          "text": "她怎么说？会不会已经忘记我了？"
        },
        {
          "role": "旅行者",
          "text": "她不认识广海。"
        },
        {
          "role": "广海",
          "text": "可是…！"
        },
        {
          "role": "旅行者",
          "text": "因为她不能认识差人。"
        },
        {
          "role": "广海",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "笨蛋尤其不行。"
        },
        {
          "role": "广海",
          "text": "唔…"
        },
        {
          "role": "旅行者",
          "text": "不过她觉得…"
        },
        {
          "role": "广海",
          "text": "她觉得？"
        },
        {
          "role": "旅行者",
          "text": "可以试着认识一下。"
        },
        {
          "role": "广海",
          "text": "欸…？"
        },
        {
          "role": "旅行者",
          "text": "像是约会邀请呢。"
        },
        {
          "role": "广海",
          "text": "欸！欸？！你是这么理解的吗！"
        },
        {
          "role": "旅行者",
          "text": "很奇怪吗…？"
        },
        {
          "role": "广海",
          "text": "没、没有…我只是…这样的回复…我还没准备好如何接受。"
        },
        {
          "role": "旅行者",
          "text": "我替你赴约也可以。"
        },
        {
          "role": "广海",
          "text": "唔…！这个就不用了！我自己会好好把握的！"
        },
        {
          "role": "广海",
          "text": "只是…她没有提到何时去「认识一下」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "恐怕是不便透露。",
              "dialogues": []
            },
            {
              "text": "毕竟是盗宝团的人…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "广海",
          "text": "你说的也对…不管怎样，谢谢你了，旅行者阁下。"
        },
        {
          "role": "广海",
          "text": "或许我还需要时间消化她说的话，但幸好，得到的并不是令我失望的结果。"
        },
        {
          "role": "广海",
          "text": "这段时间辛苦你了，实在是不好意思。这里是你的报酬。"
        },
        {
          "role": "旅行者",
          "text": "别忘了，「乌有亭」。"
        },
        {
          "role": "广海",
          "text": "嗯嗯，谢谢！"
        },
        {
          "role": "广海",
          "text": "顺便，旅行者阁下，祝你在稻妻一切顺利。"
        }
      ]
    }
  ]
}