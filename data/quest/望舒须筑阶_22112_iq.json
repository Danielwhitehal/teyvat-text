{
  "quest_id": 22112,
  "chapter_num": null,
  "chapter_title": "望舒须筑阶",
  "type": "iq",
  "route": "Stairway to Wangshu",
  "stories": [
    {
      "story_id": 22112,
      "title": "望舒须筑阶",
      "description": "望舒客栈的淮安想要修理客栈楼梯上的一道断口，正在找人帮忙…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与淮安对话"
        },
        {
          "role": "淮安",
          "text": "看来还是不修不行啊…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "淮安",
          "text": "哦，是您啊。瞧瞧，这上客栈的楼梯断了。"
        },
        {
          "role": "淮安",
          "text": "这么大的一截断口，路过的人太容易摔下去了…"
        },
        {
          "role": "淮安",
          "text": "怎么断的？哦，之前有一群怪物想要冲进客栈，我就出去处理了一下。"
        },
        {
          "role": "淮安",
          "text": "结果没收住手，把一个大块头怪物打了过来，一下子就把楼梯给砸烂了。"
        },
        {
          "role": "淮安",
          "text": "说要修，结果一直没空出时间来，现在客人越来越多，这楼梯实在是不修不行了。"
        },
        {
          "role": "淮安",
          "text": "这里还算好修，我一个人就能修好了。"
        },
        {
          "role": "淮安",
          "text": "如果有空的话，您能帮我去拿点木板来吗？我在这守着，免得又有人失足…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "淮安",
                  "text": "那就麻烦您了，我专门买了一批木板来修这里，就放在客栈底下了。"
                },
                {
                  "role": "淮安",
                  "text": "您去看看，然后拿几块给我吧。"
                }
              ]
            },
            {
              "text": "要是再被砸烂…",
              "dialogues": [
                {
                  "role": "淮安",
                  "text": "那不能，我又不是年轻的时候了…再来一次，我绝对能收住手。"
                },
                {
                  "role": "淮安",
                  "text": "不过，还是先得修好再说。为了这，我还专门买了一批木板，就放在客栈底下。"
                },
                {
                  "role": "淮安",
                  "text": "劳烦您，帮我下去拿点上来吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "搜集5块木板"
        },
        {
          "role": "淮安",
          "text": "您找到了吗？"
        },
        {
          "role": "旅行者",
          "text": "还没有。"
        },
        {
          "role": "淮安",
          "text": "木板我都放在客栈底下了，应该挺好找的。"
        },
        {
          "role": "淮安",
          "text": "您去找找吧，我在这守着，免得又有人急匆匆地过来，一个不小心就下去了…"
        },
        {
          "type": "subtitle",
          "text": "与淮安对话"
        },
        {
          "role": "淮安",
          "text": "您找到了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了。"
        },
        {
          "role": "淮安",
          "text": "我看看…差不多够了，辛苦您了。"
        },
        {
          "role": "淮安",
          "text": "我这就开工，得赶紧把这修好了…"
        },
        {
          "type": "subtitle",
          "text": "与淮安对话"
        },
        {
          "role": "淮安",
          "text": "行了，这样就可以走人了，应该也不会有人摔下去了。"
        },
        {
          "role": "旅行者",
          "text": "和楼梯看着不太搭…"
        },
        {
          "role": "淮安",
          "text": "不太搭？这也没办法，我也不是专业的木匠。"
        },
        {
          "role": "淮安",
          "text": "呼…不过，这还只是第一个，还有一个断口得修。"
        },
        {
          "role": "淮安",
          "text": "不过，今天就到这吧，客栈还开着，我还得去接待客人。"
        },
        {
          "role": "淮安",
          "text": "楼梯得修，生意也得做啊…辛苦您了，这些您拿着吧。"
        }
      ]
    }
  ]
}