{
  "quest_id": 20503,
  "chapter_num": null,
  "chapter_title": "磨刀不误砍柴工",
  "type": "iq",
  "route": "Sharpening the Axe Won't Hinder the Work",
  "stories": [
    {
      "story_id": 20503,
      "title": "磨刀不误砍柴工",
      "description": "为了迎接之后的冒险，派蒙觉得应该先做好准备。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和铁匠瓦格纳交谈"
        },
        {
          "role": "瓦格纳",
          "text": "什么事？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想看看武器。",
              "dialogues": [
                {
                  "role": "瓦格纳",
                  "text": "都在那边，自己挑吧。想要更称手的，我也能定做。"
                }
              ]
            },
            {
              "text": "想帮派蒙看看武器。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "没听说这回事啊！要让我打头阵吗？"
                },
                {
                  "role": "瓦格纳",
                  "text": "这么小一只，嗯，那要定做了。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "原来还能定做…"
        },
        {
          "role": "瓦格纳",
          "text": "当然。贩卖，定做，精炼，都是铁匠铺的生意。"
        },
        {
          "role": "瓦格纳",
          "text": "只要你有矿石就行。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在哪里能找到矿石？",
              "dialogues": [
                {
                  "role": "瓦格纳",
                  "text": "哪里都有。"
                }
              ]
            },
            {
              "text": "你这里卖吗？",
              "dialogues": [
                {
                  "role": "瓦格纳",
                  "text": "找别人去，我自己都不够用。"
                }
              ]
            }
          ]
        },
        {
          "role": "瓦格纳",
          "text": "这样吧，看你迷迷糊糊的，我把附近铁块比较多的地方告诉你。"
        },
        {
          "role": "瓦格纳",
          "text": "如果你能把铁块带回来，我就帮你锻造。"
        },
        {
          "role": "旅行者",
          "text": "好的，谢谢。"
        },
        {
          "role": "瓦格纳",
          "text": "用不着。那我继续忙了。"
        },
        {
          "type": "subtitle",
          "text": "收集3个铁块带给瓦格纳"
        },
        {
          "type": "subtitle",
          "text": "和铁匠瓦格纳交谈"
        },
        {
          "role": "瓦格纳",
          "text": "干嘛？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "采到铁块了。",
              "dialogues": []
            },
            {
              "text": "你之前让我去采铁块…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瓦格纳",
          "text": "哦对，好像有这么回事，我都忙忘了。"
        },
        {
          "role": "瓦格纳",
          "text": "还行吧，看这成色，不是不能用。"
        },
        {
          "role": "瓦格纳",
          "text": "想委托锻造"
        },
        {
          "role": "瓦格纳",
          "text": "以后找到了矿石，都可以来找我。"
        },
        {
          "role": "瓦格纳",
          "text": "当然，最好是在我不忙的时候。"
        },
        {
          "role": "旅行者",
          "text": "感觉你心情不好。"
        },
        {
          "role": "瓦格纳",
          "text": "打铁要全神贯注，我不喜欢和客人闲聊。"
        },
        {
          "role": "瓦格纳",
          "text": "手艺好，生意就好，做其他的都是投机取巧。"
        },
        {
          "role": "瓦格纳",
          "text": "没事的话，我就继续忙了。"
        }
      ]
    }
  ]
}