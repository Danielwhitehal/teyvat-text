{
  "quest_id": 40187,
  "chapter_num": null,
  "chapter_title": "终回：八奇炼桃都",
  "type": "wq",
  "route": "Final Stanza: The Sanctification of Tao Dou",
  "stories": [
    {
      "story_id": 40187,
      "title": "终回：八奇炼桃都",
      "description": "在众人的努力下，边界危机终被化解。璃月港里，香菱好像有什么事情找你…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后"
        },
        {
          "type": "subtitle",
          "text": "去找香菱"
        },
        {
          "role": "香菱",
          "text": "嘿！旅行者，派蒙。"
        },
        {
          "role": "派蒙",
          "text": "香菱！找我们有什么事呀！"
        },
        {
          "role": "香菱",
          "text": "哈哈，我还能有什么事，当然就是祭祭五脏庙的事啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "终于要吃上饭了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "嗯！应该有空吧？不能再推脱了。"
        },
        {
          "role": "派蒙",
          "text": "一直没空的可不是我们呀，是胡桃那个家伙！"
        },
        {
          "role": "香菱",
          "text": "谁让她是堂主呢，架子大得很哦！不多来几个人都约不到。"
        },
        {
          "role": "香菱",
          "text": "不过你们放心，这回都说好了，我们逼着她不许找借口。"
        },
        {
          "role": "派蒙",
          "text": "哦？还有别人出手吗？"
        },
        {
          "role": "香菱",
          "text": "嘿嘿，是行秋啦，他说早想约大家一起聚一聚了，可是你们也知道他太爷爷的事吧，所以一直不方便。"
        },
        {
          "role": "香菱",
          "text": "不过海灯节那晚，行秋太爷爷突然就醒了，别提他有多高兴了，这才有机会出来，我们当然一拍即合啦。"
        },
        {
          "role": "派蒙",
          "text": "哇！老太公没事了吗？"
        },
        {
          "role": "香菱",
          "text": "嗯，大夫都看了，没一点毛病。"
        },
        {
          "role": "香菱",
          "text": "行秋说，他太爷爷一醒来就大吃特吃，和派蒙一样，胃口好得不得了，家人们这会开始担心，老太公别又撑坏了。"
        },
        {
          "role": "派蒙",
          "text": "怎么感觉像我一样不是什么好话呢。"
        },
        {
          "role": "香菱",
          "text": "当然是好话呀，派蒙的胃口是一种积极的人生态度哦。人生得意须尽吃，莫使金箸空对月呀！"
        },
        {
          "role": "派蒙",
          "text": "哎呀，香菱说得真好！我就是带着这种理念才一步一步走到今天的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有这回事？我怎么不知道。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼哼，就有！人生得意须尽吃，莫使…莫使什么来着？"
        },
        {
          "role": "香菱",
          "text": "哈哈，小派蒙，把你的理念留到饭桌上再说吧。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，没问题！那我们在哪里吃饭呢？"
        },
        {
          "role": "香菱",
          "text": "在遗珑埠，就今晚，行秋他们都还在那边呢。对了，胡桃说她还有一位特别嘉宾。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哪位？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "晚上到了你们就知道了嘛。"
        },
        {
          "role": "派蒙",
          "text": "啊！我大概猜到是谁了，嘿嘿，但是我不说。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也猜到了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸？你猜是谁啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也不说。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼，那我们晚上看看谁猜的比较准！"
        },
        {
          "type": "subtitle",
          "text": "等待到晚上（18：00-22：00）"
        },
        {
          "type": "subtitle",
          "text": "前往遗珑埠"
        },
        {
          "role": "重云",
          "text": "要说谁更厉害的话，我选万象风角灵官。毕竟他是奇门算术开派祖师。"
        },
        {
          "role": "蓝砚",
          "text": "嗯！我也投我祖宗爷爷一票。再加上玄燕仙子！"
        },
        {
          "role": "嘉明",
          "text": "那我就要选连山二贤了，那些世外高人都是深藏不露的，小说里都是这样写的啦。你说咧？"
        },
        {
          "role": "行秋",
          "text": "如果是武侠小说，我可能也会这么选。"
        },
        {
          "role": "行秋",
          "text": "但很不巧，我读过《竹林月夜》，所以我认为最强的是桃都三仙里的白马仙子。她身上肯定有秘密。"
        },
        {
          "role": "香菱",
          "text": "咦？没人选云来钓叟吗？连玉衡大人都说，她的剑法来自云来钓叟的抛竿姿势呢。"
        },
        {
          "role": "嘉明",
          "text": "话是这么讲…不过好像少了点排场喔？"
        },
        {
          "role": "行秋",
          "text": "唔…可钓鱼客里出大神，这倒也是事实。"
        },
        {
          "role": "胡桃",
          "text": "嗨，你们都错啦！最厉害的当然是无妄姥爷和幽蝶仙子，要是没有他们，可就没有今天的往生堂呢。"
        },
        {
          "role": "重云",
          "text": "这样说也很有道理。"
        },
        {
          "role": "派蒙",
          "text": "哎呀，原来大家都到啦！"
        },
        {
          "role": "胡桃",
          "text": "旅行者，派蒙，你们总算来了。欢迎欢迎！"
        },
        {
          "role": "派蒙",
          "text": "呀！胡桃，你的帽子！"
        },
        {
          "role": "胡桃",
          "text": "这回眼睛很尖嘛，派蒙。是啦，我又做了一根梅枝哦。"
        },
        {
          "role": "派蒙",
          "text": "哦~这下你和旅行者的成一对了。"
        },
        {
          "role": "派蒙",
          "text": "话说回来，你们在干什么呢？"
        },
        {
          "role": "蓝砚",
          "text": "我们在讨论八奇里谁比较厉害。"
        },
        {
          "role": "嘉明",
          "text": "哈哈哈，都是你有你讲他有他讲而已，不会有结论的。"
        },
        {
          "role": "重云",
          "text": "嗯，除非我们有那种轻小说里的眼镜，戴上就能看见大家的战斗力。"
        },
        {
          "role": "香菱",
          "text": "哈哈，重云是被行秋传染了轻小说吗？"
        },
        {
          "role": "行秋",
          "text": "旅行者，欢迎你。我听家人说，你和胡桃完成了一个很有风险的祭仪，所以太爷爷的病才能好。"
        },
        {
          "role": "行秋",
          "text": "大恩不言谢，今后不论遇到何种麻烦，都欢迎来与我们飞云商会商量。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有其他人的功劳呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "行秋",
          "text": "嗯，我知道，父亲和大哥会一一择日登门拜访。"
        },
        {
          "role": "胡桃",
          "text": "有什么好谢的啦，行秋，不如你现在就乖乖承认，最厉害的是无妄姥爷和幽蝶仙子吧？"
        },
        {
          "role": "香菱",
          "text": "哎呀，别再讨论这种没有结果的事啦！既然大家都到了，我们就快吃饭吧。"
        },
        {
          "role": "香菱",
          "text": "派蒙，快，传授人生理念的时候到了。"
        },
        {
          "role": "派蒙",
          "text": "我、我吗？呃…我想想…好像是人生得意须尽吃，莫使…莫使什么来着？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "莫使金箸空对月。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哦对对，就是这个。"
        },
        {
          "role": "嘉明",
          "text": "哇，派蒙，连人生信条都讲得磕磕绊绊的？小心人生也磕磕绊绊喔。加油！喊多一次来听听！"
        },
        {
          "role": "派蒙",
          "text": "人生得意须尽吃！莫使金箸空对月！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很有精神。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，那我们可以开吃了吗？"
        },
        {
          "role": "香菱",
          "text": "派蒙，你是不是忘了，还有一位特别嘉宾？"
        },
        {
          "role": "派蒙",
          "text": "对哦！我想起来了，其实我早就猜到是谁了啦，但是我不说。"
        },
        {
          "role": "胡桃",
          "text": "咦？派蒙的语气有点心虚呢，其实根本猜不出来吧？"
        },
        {
          "role": "派蒙",
          "text": "哎呀，我真的猜出来了，就是那个人…旅行者，快帮帮我呀！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是云堇吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡桃",
          "text": "没错！就是我们的好云堇，看来你也没忘记她说的话。"
        },
        {
          "role": "胡桃",
          "text": "看，云堇上台了。"
        },
        {
          "role": "利兴",
          "text": "哇！那不是云翰社的当家吗？"
        },
        {
          "role": "捷悟",
          "text": "真走运，没想到云先生来遗珑埠了。"
        },
        {
          "role": "云堇",
          "text": "诸位有礼了。"
        },
        {
          "role": "云堇",
          "text": "今夜再唱一曲八奇炼桃都，给几位错过海灯节的好友。没有那晚的舞台，还请不要见怪。"
        },
        {
          "role": "派蒙",
          "text": "呜哇！云堇专门唱给你们这些错过的人听呢！"
        },
        {
          "role": "胡桃",
          "text": "嘘！她要开始啦。"
        },
        {
          "role": "云堇",
          "text": "想那桃都狂言"
        },
        {
          "role": "云堇",
          "text": "妖嘶嘶怪喧喧树下吵闹，有情鬼无缘人唯我令号。"
        },
        {
          "role": "云堇",
          "text": "离愁界入红尘怨火焦燎，骨作刀血化马九霄直捣，尔的野心可笑——"
        },
        {
          "role": "云堇",
          "text": "补天济世传灯火，戈枪剑戟影婆娑。"
        },
        {
          "role": "云堇",
          "text": "生死阴阳可奈何，你害生肥己种因果。"
        },
        {
          "role": "云堇",
          "text": "天道中正不多少，贪欲有余是尔过。"
        },
        {
          "role": "云堇",
          "text": "萌誓愿除魔非是我，共八门刀起桃都落。"
        },
        {
          "role": "云堇",
          "text": "身前力竭销魂魄，身后有人代辨清浊。"
        },
        {
          "role": "云堇",
          "text": "折柳洒泪落田陌，来年飞燕衔枝荡春波。"
        },
        {
          "type": "subtitle",
          "text": "尾声"
        },
        {
          "role": "魈",
          "text": "那日，你该陪同旅行者一起进入边界。"
        },
        {
          "role": "夜兰",
          "text": "降魔大圣恐怕是关心则乱。要有什么事连旅行者也犯难，我就更派不上用场了。"
        },
        {
          "role": "夜兰",
          "text": "况且，是凝光差我去了层岩巨渊，我也分身乏术。"
        },
        {
          "role": "夜兰",
          "text": "降魔大圣若是不满意，不如改日去玉京台，告她一状如何？"
        },
        {
          "role": "魈",
          "text": "呵，向天权…告天权？"
        },
        {
          "role": "夜兰",
          "text": "降魔大圣把玉衡星放在哪里了，她可不怕找谁的麻烦。"
        },
        {
          "role": "魈",
          "text": "罢了，最后无事便好。"
        },
        {
          "role": "夜兰",
          "text": "嗯，望舒客栈真是个好地方啊。"
        },
        {
          "role": "魈",
          "text": "整个璃月都是好地方。"
        },
        {
          "role": "夜兰",
          "text": "哈哈，说的不错。"
        },
        {
          "role": "夜兰",
          "text": "店家，再来一份沾露虾仁，带辣碟的。"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "夜兰",
          "text": "还要一份杏仁豆腐。"
        },
        {
          "role": "北斗",
          "text": "危机解除，我们的天权大人怎么还板着一张脸啊？"
        },
        {
          "role": "凝光",
          "text": "托胡堂主与旅行者的福，问题算是圆满解决了。可危机的原因我们仍尚未知晓。"
        },
        {
          "role": "凝光",
          "text": "船长消息灵通，应当知道，最近纳塔同样发生了关乎地脉与生死的大事。"
        },
        {
          "role": "凝光",
          "text": "我在想，其中是否有某种更加隐秘的联系呢？"
        },
        {
          "role": "北斗",
          "text": "要有那种事，不可能只在璃月与纳塔，我会托生意伙伴，帮你留意其它地界的风声。"
        },
        {
          "role": "北斗",
          "text": "至于现在嘛，我建议你还是先把心思收回来，别辜负了美景佳节。"
        },
        {
          "role": "凝光",
          "text": "呵呵，怎么会？我像是刻晴那种不懂劳逸结合的人吗？"
        },
        {
          "role": "北斗",
          "text": "那你怎么还戴着这支老钗？我的那份酬劳，不是让你去买支新的吗？"
        },
        {
          "role": "凝光",
          "text": "不多确认几次，我怎么敢动北斗船长的钱？万一某人心不诚，拿我开涮呢？"
        },
        {
          "role": "北斗",
          "text": "哈哈哈哈，你这女人，非让我替你挑吗？行行，走，跟我一起去街市逛逛。"
        },
        {
          "role": "凝光",
          "text": "哎呀，北斗船长什么时候这么善解人意了？"
        },
        {
          "role": "北斗",
          "text": "哈哈，少说那些，走不走啊？"
        },
        {
          "role": "凝光",
          "text": "有何不可？"
        },
        {
          "role": "刻晴",
          "text": "甘雨，还在忙吗？辛苦你了。"
        },
        {
          "role": "甘雨",
          "text": "欸？刻晴…没有啦，我也没有做什么了不起的事。这次的问题，全靠旅行者和胡堂主才是。"
        },
        {
          "role": "刻晴",
          "text": "别妄自菲薄呀，他们(她们)两个当然是最大的功臣。"
        },
        {
          "role": "刻晴",
          "text": "不过我们也没有辜负大家的信任，总务司响应得很快，不是吗？"
        },
        {
          "role": "刻晴",
          "text": "虽然明面上，这次的事件不比当初的魔神之灾，但若危机爆发出来，后果就很难说了。"
        },
        {
          "role": "甘雨",
          "text": "嗯…对了，说起这个，其实我一直有个疑惑。那八门七门的阵法，我在月海亭的资料里从未见过。"
        },
        {
          "role": "刻晴",
          "text": "噢，你在想阵法的来历啊，那是凝光变出来的。"
        },
        {
          "role": "甘雨",
          "text": "欸？"
        },
        {
          "role": "刻晴",
          "text": "哈哈，只是说笑。"
        },
        {
          "role": "刻晴",
          "text": "那日，撰有此阵法的箓笺，是凭空出现在玉京台的，连夜兰都没能查到来历。"
        },
        {
          "role": "甘雨",
          "text": "凭空出现的？那…凝光是不是太过冒险了？"
        },
        {
          "role": "刻晴",
          "text": "看似冒险，但若深想一些，就明白其中的合理之处…"
        },
        {
          "role": "刻晴",
          "text": "放眼璃月，既知危机，又晓秘法，还能在玉京台避夜兰耳目、雪中送炭之人…有几位？"
        },
        {
          "role": "甘雨",
          "text": "啊…难道是师父他们…？"
        },
        {
          "role": "甘雨",
          "text": "我明白了。"
        },
        {
          "role": "闲云",
          "text": "往生堂那丫头，真有几分了不起。"
        },
        {
          "role": "闲云",
          "text": "早前只因为帝君在那当什么客卿，本仙才对她有些兴趣，如今方知其中真意啊。"
        },
        {
          "role": "削月筑阳真君",
          "text": "话虽如此，但能听见留云借风这番称赞，倒是稀奇得很。"
        },
        {
          "role": "闲云",
          "text": "如何稀奇了？"
        },
        {
          "role": "理水叠山真君",
          "text": "若是以往，想必是「那丫头虽有两把刷子，但若换我们申鹤甘雨，也不差几分。」"
        },
        {
          "role": "闲云",
          "text": "哼！本仙岂是那种凡事喜欢扒高抬己之辈？那丫头有此大义，不值得本仙一句称赞？"
        },
        {
          "role": "萍姥姥",
          "text": "呵呵呵，当然是值得。我在璃月港住久了，早已知道往生堂这地方，代代有英才啊。"
        },
        {
          "role": "削月筑阳真君",
          "text": "歌尘说得不错。昔日那魔神桃都与我等虽非敌，亦非友，若不是他仍心系众生，甘愿自炼己身，平定幽冥…"
        },
        {
          "role": "削月筑阳真君",
          "text": "莫说八奇，就是再来八仙，又奈他何？那之后他身化边界，不想竟由凡人维护至今，可叹，可叹。"
        },
        {
          "role": "理水叠山真君",
          "text": "话说回来，那往生堂小女，姓甚名谁，我倒还不知。"
        },
        {
          "role": "钟离",
          "text": "堂主姓胡，名桃。"
        },
        {
          "role": "削月筑阳真君",
          "text": "蝴蝶的蝴？"
        },
        {
          "role": "钟离",
          "text": "胡闹的胡。"
        },
        {
          "role": "削月筑阳真君",
          "text": "淘气的淘？"
        },
        {
          "role": "钟离",
          "text": "桃都的桃。"
        },
        {
          "role": "理水叠山真君",
          "text": "噢，蝴蝶的蝴，桃都的桃，好名字，人如其名的好名字。"
        },
        {
          "role": "闲云",
          "text": "是胡闹的胡，胡搅蛮缠、胡吃海喝的胡！"
        },
        {
          "role": "理水叠山真君",
          "text": "你看你，我不就是活跃一下气氛吗？怎么？她胡闹得，我胡闹不得？"
        },
        {
          "role": "闲云",
          "text": "哦？你几时改的名号啊？胡山胡水真君？"
        },
        {
          "role": "萍姥姥",
          "text": "呵呵，还是来喝茶吧，这是帝君从轻策带回的鬼山灵芽，颇为罕见，莫要错了时机。"
        },
        {
          "role": "萍姥姥",
          "text": "希望来年也有好茶喝啊。"
        },
        {
          "role": "钟离",
          "text": "嗯，会的。"
        }
      ]
    }
  ]
}