{
  "quest_id": 71051,
  "chapter_num": null,
  "chapter_title": "水生环境调查",
  "type": "wq",
  "route": "Hydrological Investigation in The Chasm",
  "stories": [
    {
      "story_id": 71051,
      "title": "水生环境调查",
      "description": "从层岩巨渊中钓出了奇怪的物件，究竟是什么呢，交由须弥学者海迪夫调查后，说要放到水边激活才可知道其真相…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "钓起任务道具"
        },
        {
          "role": "派蒙",
          "text": "嗯？怎么感觉钓上来了奇怪的东西…唔，这东西能吃吗？不如待会儿回营地的时候找人问问看吧。"
        },
        {
          "type": "subtitle",
          "text": "与海迪夫对话"
        },
        {
          "role": "旅行者",
          "text": "关于奇怪的物件…"
        },
        {
          "role": "海迪夫",
          "text": "嗯？这是你钓鱼钓到的，钓鱼？唔…这东西粗看起来倒像是我们钓鱼用的鱼饵。"
        },
        {
          "role": "海迪夫",
          "text": "钓鱼是能钓出这种东西的活动吗…？阿妮萨学姐在海祇岛也天天钓鱼，没见到她钓出什么成果来啊。"
        },
        {
          "role": "海迪夫",
          "text": "该说不愧是你吗？"
        },
        {
          "role": "海迪夫",
          "text": "我看看，这个东西…能够感受到它有很可怕的水元素含量。"
        },
        {
          "role": "海迪夫",
          "text": "层岩巨渊的地下水中，富含的元素量之多，确实有点不太正常…难道是因为有这些东西在地下水里生长的缘故吗？"
        },
        {
          "role": "海迪夫",
          "text": "不过这个东西从水里拿出来以后，元素就在不断流失，说不定必须得放在水边才会有产生效果。"
        },
        {
          "role": "旅行者",
          "text": "放在水边？"
        },
        {
          "role": "海迪夫",
          "text": "放到水边，用水元素激活，大概就能知道这东西是什么作用了。"
        },
        {
          "role": "海迪夫",
          "text": "这样吧，你去激活它，反正东西也是你钓上来的，发生什么事就告诉我吧。"
        },
        {
          "role": "海迪夫",
          "text": "要是有什么研究价值的话，我会支付你报酬的。"
        },
        {
          "type": "subtitle",
          "text": "将奇怪物件放至水边"
        },
        {
          "type": "subtitle",
          "text": "利用水元素反应激活奇怪物件"
        },
        {
          "role": "派蒙",
          "text": "怎么才刚把那个东西放到水边，就游出来了一只岩龙蜥啊！"
        },
        {
          "type": "subtitle",
          "text": "击败出现的水岩龙蜥"
        },
        {
          "type": "subtitle",
          "text": "告诉海迪夫在水边发生的事"
        },
        {
          "role": "旅行者",
          "text": "关于放在水边的奇怪物件…"
        },
        {
          "role": "海迪夫",
          "text": "嗯？你把那个东西放在水边了…"
        },
        {
          "role": "海迪夫",
          "text": "怎么样，有发生什么特殊反应之类的吗？"
        },
        {
          "role": "旅行者",
          "text": "出现了岩龙蜥…"
        },
        {
          "role": "海迪夫",
          "text": "岩龙蜥？那个东西放到水里变成了岩龙蜥？"
        },
        {
          "role": "海迪夫",
          "text": "哦，不是那个东西变成的，而是岩龙蜥看到那个东西之后就游出来了…"
        },
        {
          "role": "海迪夫",
          "text": "吓了我一跳，要是这个东西入水直接变成岩龙蜥，那我的世界观的立柱都要崩塌了。"
        },
        {
          "role": "旅行者",
          "text": "那个东西到底是…"
        },
        {
          "role": "海迪夫",
          "text": "说来也简单，该怎么说明好呢，这样吧，让我先猜一猜，那只岩龙蜥，有没有什么特别之处…"
        },
        {
          "role": "海迪夫",
          "text": "比如说，元素附着属性是水之类的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像是这样的…",
              "dialogues": [
                {
                  "role": "海迪夫",
                  "text": "那就对了。"
                }
              ]
            },
            {
              "text": "没看见…",
              "dialogues": [
                {
                  "role": "海迪夫",
                  "text": "难道是因为解决得太快了所以根本没在意到吗…真是厉害啊，不愧是传说中的旅行者。"
                },
                {
                  "role": "海迪夫",
                  "text": "不过根据我的推测…"
                }
              ]
            }
          ]
        },
        {
          "role": "海迪夫",
          "text": "那只岩龙蜥应该可以调用水元素。"
        },
        {
          "role": "海迪夫",
          "text": "层岩巨渊的地下水，水元素含量很高，特殊的聚集点就会养出类似你钓上来的水草一样的事物。"
        },
        {
          "role": "海迪夫",
          "text": "岩龙蜥，当然了，其他生长在层岩巨渊的亲水生物也一样，靠食用这种富含水元素的水草来提升自己的力量。"
        },
        {
          "role": "海迪夫",
          "text": "所以那个东西其实就是…富含水元素的水草！"
        },
        {
          "role": "旅行者",
          "text": "只是水草吗…"
        },
        {
          "role": "海迪夫",
          "text": "嗯，就是水草，不过富有如此元素量的水草…"
        },
        {
          "role": "海迪夫",
          "text": "正常环境可长不出来，除非有什么非常纯净又巨大的能量影响了水源…不说这个了，这些水草…"
        },
        {
          "role": "海迪夫",
          "text": "说不定有一天也会生出意识变成元素生物，真是值得好好研究一番啊。"
        },
        {
          "type": "subtitle",
          "text": "海迪夫相关任务都完成后"
        },
        {
          "role": "海迪夫",
          "text": "先不说其他的了。"
        },
        {
          "role": "海迪夫",
          "text": "在层岩巨渊的这几天，你做了很多，我都不知道应该怎么感谢你了。"
        },
        {
          "role": "海迪夫",
          "text": "如果再给你钱，也实在是太过生分了。"
        },
        {
          "role": "旅行者",
          "text": "其实你一定要给的话…"
        },
        {
          "role": "海迪夫",
          "text": "别开玩笑了，我怎么能做出给你一笔钱了事，这种不解风情的行为。"
        },
        {
          "role": "海迪夫",
          "text": "那不是在污辱你吗！"
        },
        {
          "role": "海迪夫",
          "text": "来，收好这封信吧，如果你以后有机会去须弥，遇到了什么麻烦，或有什么需要帮助的，那就拿着这封信找普尔比鲁尼一门的人！"
        },
        {
          "role": "海迪夫",
          "text": "我们一定会尽全力帮助你的。"
        },
        {
          "role": "海迪夫",
          "text": "「往来的人情，比黄金还宝贵。」"
        },
        {
          "role": "海迪夫",
          "text": "这句须弥谚语，说的就是这样的情形吧。"
        }
      ]
    }
  ]
}