{
  "quest_id": 10097,
  "chapter_num": "杯中遥吟之歌 第一幕",
  "chapter_title": "自远方吹来的音讯",
  "type": "eq",
  "route": "Sounds From Afar",
  "stories": [
    {
      "story_id": 40078,
      "title": "自远方吹来的音讯",
      "description": "丰收季到来，蒙德的冒险家协会开始接到大量居民的求助委托，你和派蒙也收到凯瑟琳的求援赶回了蒙德…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "去蒙德冒险家协会看看"
        },
        {
          "role": "派蒙",
          "text": "最近蒙德是不是迎来「风花节」了呀？"
        },
        {
          "role": "派蒙",
          "text": "要说我对它的印象…轻风吹来花香，空气里到处都是甜津津的味道，唯一的缺点就是接不到委托…"
        },
        {
          "role": "派蒙",
          "text": "哼，我不信这个邪，总还是有人会需要我们的！走吧，这就回去看看。"
        },
        {
          "role": "派蒙",
          "text": "你好呀，凯瑟琳。"
        },
        {
          "role": "凯瑟琳",
          "text": "二位好，很高兴能在节日期间见到你们。"
        },
        {
          "role": "派蒙",
          "text": "那…有什么可以交给我们的委托吗？"
        },
        {
          "role": "凯瑟琳",
          "text": "唔，这就让我有些为难了。"
        },
        {
          "role": "凯瑟琳",
          "text": "按照蒙德人的习惯，「风花节」的礼物应该由自己亲手准备。"
        },
        {
          "type": "subtitle",
          "text": "前往冒险家协会"
        },
        {
          "role": "凯瑟琳",
          "text": "让我核对一下…嗯，清单上的任务都完成了。旅行者，派蒙，辛苦你们了。"
        },
        {
          "role": "凯瑟琳",
          "text": "多亏你们收到联络后及时赶回来协助，否则最近这么多委托，还真不知道该怎么办才好。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，小菜一碟啦。这两天工作虽然不少，但要做的基本上就只有搬搬货物、护送一下车队什么的。"
        },
        {
          "role": "派蒙",
          "text": "之前听你说人手不够，还以为会有什么艰巨的任务等着我们呢。"
        },
        {
          "role": "凯瑟琳",
          "text": "二位是资深的冒险家，请你们处理这些事的确有些大材小用，不过，蒙德每年到这个时候都会遇到类似的情况。"
        },
        {
          "role": "派蒙",
          "text": "咦，为什么？"
        },
        {
          "role": "旅行者",
          "text": "因为到了「丰收的季节」吧。"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者说得没错。最近是收获谷物和水果的好时节，对于以美酒闻名提瓦特的蒙德来说，也到了年中最重要的「酿酒季」。"
        },
        {
          "role": "凯瑟琳",
          "text": "农户们都在抓紧时间出售新鲜的农产品，各大酒商也会收购优质的酿造原料。"
        },
        {
          "role": "派蒙",
          "text": "原来如此，难怪这两天经常听到有人讨论酒的话题。"
        },
        {
          "role": "菲恩",
          "text": "欸，你说什么？真的吗？"
        },
        {
          "role": "伯恩哈德",
          "text": "千真万确，代理团长正召集大家去总部大厅集合呢！快点快点，再不走就要来不及了！"
        },
        {
          "role": "菲恩",
          "text": "喂，等等我！"
        },
        {
          "role": "派蒙",
          "text": "那两位西风骑士…怎么看起来慌慌张张的？"
        },
        {
          "role": "凯亚",
          "text": "哟，这不是旅行者和派蒙吗，你们好啊。"
        },
        {
          "role": "派蒙",
          "text": "是凯亚，来得刚好！为什么大家都在往骑士团的方向跑呀？"
        },
        {
          "role": "旅行者",
          "text": "需要我们帮忙吗？"
        },
        {
          "role": "凯亚",
          "text": "哈哈，别担心，不是什么需要你们出手的情况。"
        },
        {
          "role": "凯亚",
          "text": "事情是这样的：刚刚骑士团收到了一封大团长的来信，代理团长稍后会在总部大厅召开会议和大家一起拆阅这封信件。"
        },
        {
          "role": "派蒙",
          "text": "原来如此，那我就放心…不不对，等一下，你刚才说什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刚刚骑士团收到了…",
              "dialogues": []
            },
            {
              "text": "「大团长的来信」？！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "西风骑士团的大团长，不就是…不就是那个传说中带队远征的法尔伽吗？！"
        },
        {
          "role": "派蒙",
          "text": "凯亚，法尔伽信上说了什么，远征队现在情况怎么样，他们什么时候回来？"
        },
        {
          "role": "凯亚",
          "text": "哟，没想到派蒙比我还关心大团长，你呀，很八卦嘛？"
        },
        {
          "role": "派蒙",
          "text": "很正常吧，如果有一个你经常听说却从没见过的人，你也会非常惦记的嘛！琴团长还老说他是骑士团的「当代传奇」，真吊胃口。"
        },
        {
          "role": "派蒙",
          "text": "再说远征队离开了这——么长时间，我们可是从没听说过他们的具体动向。"
        },
        {
          "role": "凯亚",
          "text": "哈哈哈，代理团长的评价还真是客气。"
        },
        {
          "role": "凯亚",
          "text": "那位老兄在他成为传奇的路上啊，也是给身边不少人添了麻烦。这些等之后有时间再跟你们慢慢说。"
        },
        {
          "role": "凯亚",
          "text": "看你们这么有兴趣，要不要跟我一起回骑士团听听？"
        },
        {
          "role": "凯亚",
          "text": "荣誉骑士也有段时间没露面了，大家都很想你。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那我们就过去看看吧。凯瑟琳，我们先走一步啦。"
        },
        {
          "role": "凯瑟琳",
          "text": "好的，几位请慢走。"
        },
        {
          "type": "subtitle",
          "text": "前往西风骑士团"
        },
        {
          "role": "凯亚",
          "text": "嗯，看样子人差不多到齐了。"
        },
        {
          "role": "丽莎",
          "text": "嗨，小可爱、小派蒙，没想到你们也来了，是听说了信的事情吗？"
        },
        {
          "role": "派蒙",
          "text": "对，刚刚我们在冒险家协会附近碰到了凯亚。"
        },
        {
          "role": "派蒙",
          "text": "哇…说起来，我之前还从没在大厅里见到这么多人呢。"
        },
        {
          "role": "派蒙",
          "text": "感觉自己也跟着紧张了起来…"
        },
        {
          "role": "凯亚",
          "text": "哈哈，你也大投入了吧？就凭我对大团长的了解，他既然还有闲工夫写信，要说的十有八九不是正经事。总之不是坏消息。"
        },
        {
          "role": "丽莎",
          "text": "凯亚说得夸张了些，不过我也认同这个结论哦。"
        },
        {
          "role": "丽莎",
          "text": "毕竟，米卡不是那种脸上藏得住事的孩子呢。"
        },
        {
          "role": "旅行者",
          "text": "米卡？那是谁？"
        },
        {
          "role": "丽莎",
          "text": "你看，就是楼梯前面，站在琴旁边的那个孩子。"
        },
        {
          "role": "丽莎",
          "text": "他之前是优拉队里的测绘员，在勘测方面很有天赋，性格也踏实。远征队出发的时候，他还被大团长任命为队里的前侦骨干。"
        },
        {
          "role": "丽莎",
          "text": "这次的信就是他带回来的。"
        },
        {
          "role": "琴",
          "text": "各位，请安静一下。既然人员已经到齐，那我们现在开始宣读大团长的来信。"
        },
        {
          "role": "琴",
          "text": "米卡，交给你了。"
        },
        {
          "role": "米卡",
          "text": "是…是！琴团长！"
        },
        {
          "role": "米卡",
          "text": "嗯咳…大家好，我是游击小队的测绘员米卡，此前跟随远征队在外执行任务，下面由我代为朗读法尔伽大团长的来信。"
        },
        {
          "role": "米卡",
          "text": "「西风骑士团收：大家好，我是法尔伽。」"
        },
        {
          "role": "米卡",
          "text": "「首先要告诉大家的是：请你们放心，远征队所有成员目前都平安无事。」"
        },
        {
          "role": "伯恩哈德",
          "text": "太好了！"
        },
        {
          "role": "菲恩",
          "text": "哈啊，我手心都出汗了…"
        },
        {
          "role": "琴",
          "text": "……"
        },
        {
          "role": "米卡",
          "text": "那个…大家，我可以继续了吗？"
        },
        {
          "role": "琴",
          "text": "继续吧，米卡。"
        },
        {
          "role": "米卡",
          "text": "「好了，我猜现在你们可以放松心情听下面的内容了。在炉火边写这封信时，我和远征队正在提瓦特的北境驻扎休整。」"
        },
        {
          "role": "米卡",
          "text": "「我曾告诉过你们，远征队此行的目的是某个往昔遗留的危险秘密。我目前依旧只能言尽于此，但你们不用担心任务的进展。」"
        },
        {
          "role": "米卡",
          "text": "「这两个月，我们遇到了一个意想不到的人——愚人众的执行官『队长』。」"
        },
        {
          "role": "派蒙",
          "text": "什么，「队长」？"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "米卡",
          "text": "「我知道愚人众此前在蒙德的嚣张举动，但从结果上来说，『队长』这次并没有和我们作对。」"
        },
        {
          "role": "米卡",
          "text": "「（我猜是因为这次至冬国和我们是一条绳上的蚂蚱）。」"
        },
        {
          "role": "米卡",
          "text": "「那家伙用面具掩盖住了一切，让人无法判断他的经历和出身，但他确实是个钢铁般的人，作为凡人，甚至有挑战神的无畏。」"
        },
        {
          "role": "米卡",
          "text": "「我怀疑他拿着可莉的蜡笔都能捅爆遗迹守卫身上那个眼睛一样的核心（你们就别试了）。」"
        },
        {
          "role": "米卡",
          "text": "「侦察兵发现三天前『队长』已经奉命前往了纳塔，今后不用分出精力提防他，我们也能睡个好觉了。」"
        },
        {
          "role": "米卡",
          "text": "「我承认他的某些行动帮上了点忙，但从这个角度看，还是算他欠我们的吧。」"
        },
        {
          "role": "米卡",
          "text": "「现在的蒙德应该已经快要迎来归风佳酿节」了吧，很遗憾，今年还不能和你们一起共度佳节。」"
        },
        {
          "role": "米卡",
          "text": "「大家无时无刻不在怀念蒙德的美酒，还有那些与你们一同度过的日子。」"
        },
        {
          "role": "米卡",
          "text": "「和蒙德人民一起好好庆祝节日，顺便替我们多喝几杯，晨曦酒庄每年佳酿节限供的葡萄酒就好。」"
        },
        {
          "role": "米卡",
          "text": "「愿巴巴托斯大人保佑蒙德，愿我们的思念也能够跟随归风回到你们身边。法尔伽。」"
        },
        {
          "role": "米卡",
          "text": "「又：如果你们要问『队长』和我谁更厉害，我可是大团长！队长咱们骑士团有十个呢，啊哈哈哈。」"
        },
        {
          "role": "米卡",
          "text": "信到这里就结束了，我念完了，谢谢大家。"
        },
        {
          "role": "琴",
          "text": "辛苦你了，米卡。"
        },
        {
          "role": "米卡",
          "text": "琴团长，那个…我发现信最后那页的背面，好像还写了一些东西…"
        },
        {
          "role": "米卡",
          "text": "「又又：信纸不够用就写在这里了，丽莎，下面是给你的留言」…啊，好像是大团长写给丽莎小姐的。"
        },
        {
          "role": "丽莎",
          "text": "哦，给我的？"
        },
        {
          "role": "琴",
          "text": "既然是特别的留言…丽莎，我们私下再聊吧。"
        },
        {
          "role": "琴",
          "text": "各位，正如大团长所说，再过几天就是「佳酿节」了，我们很幸运能在这时收到远征队一切平安的消息。"
        },
        {
          "role": "琴",
          "text": "虽然他们无法回到蒙德和我们共度节日，但佳酿节始终是大家的期盼。"
        },
        {
          "role": "琴",
          "text": "为了在外努力的远征队，也为了辛勤的蒙德人民，希望大家能够坚守岗位，恪尽职责。"
        },
        {
          "role": "琴",
          "text": "当然，休息期间也请适度放松，享受这个久违的节日。"
        },
        {
          "role": "琴",
          "text": "今天的会议就到这里，解散。"
        },
        {
          "role": "派蒙",
          "text": "我没听错吧，居然还提到了愚人众的『队长』…呃…感觉是很重要的事…"
        },
        {
          "role": "派蒙",
          "text": "但先别管什么愚人众了，「佳酿节」听起来是可以免费吃喝的节日？！真的吗？还有更多消息吗！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不出意料…",
              "dialogues": []
            },
            {
              "text": "不愧是你。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "小可爱们，要不要一起去找琴聊聊？刚才人太多，连打招呼的机会都没有呢。"
        },
        {
          "role": "派蒙",
          "text": "好呀好呀，我们赶快过去吧。"
        },
        {
          "type": "subtitle",
          "text": "前往团长办公室"
        },
        {
          "role": "琴",
          "text": "丽莎，你来了，大团长的信就在桌上。"
        },
        {
          "role": "琴",
          "text": "旅行者，派蒙，好久不见。刚才事务有些忙，没能跟你们多说几句，抱歉。"
        },
        {
          "role": "琴",
          "text": "如果最近有空的话，在蒙德多待一段时间怎么样？我们很快就要庆祝「佳酿节」了。"
        },
        {
          "role": "丽莎",
          "text": "别看琴这样，她从前些日子起就在念叨你们了哦。"
        },
        {
          "role": "琴",
          "text": "丽莎…"
        },
        {
          "role": "丽莎",
          "text": "呵呵…你们先聊着，我去看看信。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也很想念蒙德。",
              "dialogues": []
            },
            {
              "text": "我也很想念大家。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是啊！蒙德也算是我们旅行的起点，有很多珍贵的回忆呢。"
        },
        {
          "role": "派蒙",
          "text": "对了，琴团长，关于「佳酿节」，我和旅行者都不太熟悉，你能和我们讲讲吗？"
        },
        {
          "role": "琴",
          "text": "嗯，当然。"
        },
        {
          "role": "琴",
          "text": "「佳酿节」和「羽球节」、「风花节」一样，是十分古老的蒙德节日，同时也是秋季最重要的节日。"
        },
        {
          "role": "琴",
          "text": "蒙德每年秋天都刮西风，传说，这是因为丰收时节酿酒的香气太过诱人，引来了酷爱饮酒的风神。"
        },
        {
          "role": "琴",
          "text": "无论身处何方，他都会化作轻风回归故乡。"
        },
        {
          "role": "派蒙",
          "text": "唔…是很像风神给人的印象呢…"
        },
        {
          "role": "琴",
          "text": "因此，蒙德人也把西风称为「归风」，「佳酿节」最早就是为了迎接巴巴托斯大人而设立的节日。"
        },
        {
          "role": "琴",
          "text": "过去每到这个时候，家家户户都要酿制新酒，这些酒会被封存起来，至少要留到第二年佳酿节的「归风日」再启封。"
        },
        {
          "role": "琴",
          "text": "人们打开陈酿，便意味着邀请风神共饮。传说，如果风神对酒的味道感到满意，就会欣然唤来微风，为人们送上珍贵的祝福。"
        },
        {
          "role": "旅行者",
          "text": "「珍贵的祝福」？"
        },
        {
          "role": "派蒙",
          "text": "按照他的性格，难道是祝福大家…来年也能喝到好酒？"
        },
        {
          "role": "琴",
          "text": "祝福的具体内容…我确实不清楚。"
        },
        {
          "role": "琴",
          "text": "这些故事年代久远，详细的内容已经失传了。"
        },
        {
          "role": "派蒙",
          "text": "有些故事流传久了完全会变成别的样子呢！比如现在的蒙德人会为「风之花是什么花」产生争执…"
        },
        {
          "role": "丽莎",
          "text": "这就是所谓人文传承的一环了。"
        },
        {
          "role": "琴",
          "text": "嗯，说回现在，「归风日」敬献风神的传统仍然保留着。佳酿节也一直是蒙德人分享丰收喜悦品尝美酒的节日。"
        },
        {
          "role": "琴",
          "text": "每年这个时候，都有很多漂泊在外的蒙德人回到故乡。对于无法回乡的游子来说，佳酿节也是他们最想念家乡和亲人的时候。"
        },
        {
          "role": "派蒙",
          "text": "哦！难怪大团长会在信里说，「希望我们的思念能够跟随归风回到你们身边」。"
        },
        {
          "role": "琴",
          "text": "至于今年的活动.我们联合了西风教会和冒险家协会，准备在清泉镇外的果酒湖畔共同庆祝节庆期间还会开设传统的「美酒集市」。"
        },
        {
          "role": "派蒙",
          "text": "「美酒集市」？"
        },
        {
          "role": "琴",
          "text": "最早是酒商和农户们交易酿酒原料的市场。"
        },
        {
          "role": "琴",
          "text": "如今的话…不仅会有成品的美酒佳酿，还有很多这个季节才有的果饮和小吃，民众们也可以在集市上出售二手物品或手工制品。"
        },
        {
          "role": "琴",
          "text": "骑士团准备趁这个机会进行义卖活动，为城里需要帮助的老人和孩子们筹集些资金。"
        },
        {
          "role": "派蒙",
          "text": "哇，听起来还挺有意思的。"
        },
        {
          "role": "琴",
          "text": "有空时就去逛逛吧，希望你们能有所收获。对了，丽莎，大团长给你的留言说了什么事吗？"
        },
        {
          "role": "丽莎",
          "text": "嗯，我正想和你们商量呢。大团长说，有一件和雷泽「身世」有关的事要交给我处理。"
        },
        {
          "role": "旅行者",
          "text": "雷泽的身世？"
        },
        {
          "role": "派蒙",
          "text": "雷泽之前告诉过我们，是奔狼领的狼群把他养大的。"
        },
        {
          "role": "派蒙",
          "text": "他不知道自己的父母是谁，用他的话说，狼群是「卢皮卡」——也就是他的家人。"
        },
        {
          "role": "丽莎",
          "text": "嗯，我了解的情况也差不多。"
        },
        {
          "role": "丽莎",
          "text": "但大团长信上说，座钟右侧书架第三列最上面的柜子里，放着一个木盒，里面装着雷泽父母留给他的东西，「是时候该给他了」。"
        },
        {
          "role": "派蒙",
          "text": "这么说来，大团长其实认识雷泽的父母？"
        },
        {
          "role": "丽莎",
          "text": "看来是这样。大团长与雷泽的渊源，不仅仅是在奔狼领遇到了他，并教他剑术这么简单。"
        },
        {
          "role": "派蒙",
          "text": "哇，那我们赶快去找雷泽吧！亲生父母的消息，对他来说一定很重要！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，你先等等。",
              "dialogues": []
            },
            {
              "text": "丽莎似乎有什么担忧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "真是瞒不过你的眼睛，小可爱。"
        },
        {
          "role": "丽莎",
          "text": "从未联系过的亲生父母，这话题对于普通孩子来说也不太轻松。"
        },
        {
          "role": "丽莎",
          "text": "更何况雷泽一直生活在奔狼领， 对人类社会接触不深…我不确定他是否做好了准备……"
        },
        {
          "role": "琴",
          "text": "但大团长应该是有分寸的。或许他正是考虑到雷泽的情况，才选择了现在这个时机？"
        },
        {
          "role": "丽莎",
          "text": "琴的说法也有道理。小可爱们，能拜托你们去找雷泽谈谈吗？"
        },
        {
          "role": "丽莎",
          "text": "雷泽一直把我当作师父，即使心里不愉快也会有所保留。你们是雷泽信任的朋友，大概比我更适合和他聊起这件事。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "放心吧，这件事交给我们。",
              "dialogues": []
            },
            {
              "text": "我们会和雷泽好好谈谈。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "那就拜托你们了。"
        },
        {
          "role": "丽莎",
          "text": "可以的话，记得多给他一些鼓励。这个年纪的孩子，最需要关怀和支持。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（丽莎）"
        },
        {
          "role": "丽莎",
          "text": "教育、引导…这也是为师者的责任。在你们回来之前，我会好好做准备的。"
        },
        {
          "role": "丽莎",
          "text": "快出发吧，小可爱们。雷泽就拜托你们了。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（琴）"
        },
        {
          "role": "琴",
          "text": "旅行者，还有什么想聊的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于远征队…",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "嗯，多亏米卡送信回来。大家能平安无事，就是对我最大的鼓舞了。"
                },
                {
                  "role": "琴",
                  "text": "但我没有想到的是，愚人众的执行官，「队长」竟然会出现。"
                },
                {
                  "role": "琴",
                  "text": "就算大团长措辞的风格一贯有些…特别，我也从没见过他对别人有这么高的评价…"
                },
                {
                  "role": "琴",
                  "text": "旅行者，如果你们在今后的旅途中遇到这位「队长」，务必要提高警惕。他的实力不容小觑。"
                }
              ]
            },
            {
              "text": "关于米卡…",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "米卡此前告诉我，大团长让他完成送信任务后，重新回到优拉的游击小队任职，不再需要回到远征队复命。"
                },
                {
                  "role": "琴",
                  "text": "测绘员通常会被安排在行军的先头部队中，肩负着探索未知区域的使命。这样看来，远征队那边的压力确实小了很多…"
                },
                {
                  "role": "琴",
                  "text": "说起来，你和米卡说过话吗？他在不熟悉的人面前总会身体僵硬、站得笔直…"
                },
                {
                  "role": "琴",
                  "text": "希望他可以多一点自信啊。"
                }
              ]
            },
            {
              "text": "关于「佳酿节」…",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "不用担心，准备工作在逐步推进。"
                },
                {
                  "role": "琴",
                  "text": "作为荣誉骑土的你，我分配给你的职责是…"
                },
                {
                  "role": "琴",
                  "text": "「尽情享受这个节日吧」，如何？"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "再见，祝你们在佳酿节期间过得开心。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "分支对话（凯亚和米卡）"
        },
        {
          "role": "米卡",
          "text": "哇，你、你好，那个…你是要找凯亚队长吧，请不用在意我！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "其实是来找你。",
              "dialogues": []
            },
            {
              "text": "想和你打个招呼。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "米卡",
          "text": "欸，不是吧，怎么办？！啊，凯亚队长…我、我该说点什么？"
        },
        {
          "role": "凯亚",
          "text": "哈哈，米卡，你在远征队待了那么长时间，怎么还是老样子？"
        },
        {
          "role": "凯亚",
          "text": "你不是刚刚还问我龙灾的事吗？现在站在你面前的，就是传说中的荣誉骑士啊。"
        },
        {
          "role": "派蒙",
          "text": "哼哼，没错，还有传说中的派蒙！"
        },
        {
          "role": "米卡",
          "text": "你…你们好，你们好强，我…我很佩服。呃…我还要去找优莅队长报到，不好意思先失陪了！"
        },
        {
          "role": "派蒙",
          "text": "啊，走掉了…真可惜，我还想多问问他远征队的事呢。"
        },
        {
          "role": "凯亚",
          "text": "可惜啊可惜，不过别在意，在他眼中，你们可是「全城瞩目的焦点」。"
        },
        {
          "role": "凯亚",
          "text": "时间能解决这些问题的。等下次见面，说不定就能自然地相处了。"
        },
        {
          "role": "凯亚",
          "text": "分享个秘诀给你们，可以试着和他聊聊野外探索话题，很容易获取他的信任哦。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（凯亚）"
        },
        {
          "role": "凯亚",
          "text": "怎么样，跟我走这一趟，挺有乐趣的吧？"
        },
        {
          "role": "凯亚",
          "text": "听说你们会留在蒙德跟大家一起过「佳酿节」，那就祝你们玩得开心了。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（菲恩和伯恩哈德）"
        },
        {
          "role": "伯恩哈德",
          "text": "远征队竟然会遇上那个愚人众的「队长」，呼，真是惊险。"
        },
        {
          "role": "菲恩",
          "text": "怕什么，我们可是有大团长啊。一个大团长…至少也能顶十个队长吧？"
        },
        {
          "role": "菲恩",
          "text": "不是，你就别操心远征队了。咱们骑士图义卖筹款的摊位是交给你负责的吧你准备得怎么样了？"
        },
        {
          "role": "伯恩哈德",
          "text": "唉，其实我还没想好该卖些什么…"
        },
        {
          "type": "subtitle",
          "text": "离开骑士团总部"
        },
        {
          "role": "派蒙",
          "text": "雷泽平时都在奔狼领附近吧！"
        },
        {
          "role": "派蒙",
          "text": "不知道他听说了这件事之后，会有怎样的反应…"
        },
        {
          "type": "subtitle",
          "text": "前往奔狼领"
        },
        {
          "role": "派蒙",
          "text": "咦，你看，这里有一个捕猎用的陷阱，像是清泉镇的猎人们会用的…"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "使用元素视野查看周围…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "嗯？你发现什么了吗？"
        },
        {
          "role": "旅行者",
          "text": "陷阱附近有雷元素的痕迹。"
        },
        {
          "role": "派蒙",
          "text": "雷元素痕迹…难道是雷泽吗？奇怪，我记得他之前都会避开猎人们活动的。"
        },
        {
          "role": "派蒙",
          "text": "总之，我们先顺着痕迹找找看吧。"
        },
        {
          "type": "subtitle",
          "text": "用元素视野追随雷元素痕迹"
        },
        {
          "role": "派蒙",
          "text": "快看，前面还有一个陷阱！你也能感受到雷元素吗？"
        },
        {
          "role": "派蒙",
          "text": "雷元素的痕迹向奔狼领深处延伸了，我们继续向里面走吧。"
        },
        {
          "role": "派蒙",
          "text": "雷泽——你在吗？"
        },
        {
          "type": "subtitle",
          "text": "跟雷泽对话"
        },
        {
          "role": "杜拉夫",
          "text": "好，这下最后一个陷阱也布置好了。雷泽，辛苦你跟着我跑了这么久。"
        },
        {
          "role": "雷泽",
          "text": "没关系。跑，我擅长。…嗯？"
        },
        {
          "role": "杜拉夫",
          "text": "雷泽，怎么了？"
        },
        {
          "role": "雷泽",
          "text": "味道…很熟悉。远方回来的，朋友。"
        },
        {
          "role": "派蒙",
          "text": "雷泽——"
        },
        {
          "role": "派蒙",
          "text": "咦，原来杜拉夫先生也在！你们是在一起打猎吗？"
        },
        {
          "role": "杜拉夫",
          "text": "对，这不最近到了丰收季，野林猪动不动就跑到镇上和酒庄附近找东西吃。"
        },
        {
          "role": "杜拉夫",
          "text": "踩烂作物、撞塌葡萄架那都是轻的，要是伤到人问题就大了。"
        },
        {
          "role": "杜拉夫",
          "text": "西风骑士团找我们猎人一起想办法，把野林猪拦在安全距离外。"
        },
        {
          "role": "雷泽",
          "text": "和棕色猫叔叔，抓野林猪，保护大家。"
        },
        {
          "role": "派蒙",
          "text": "哇，雷泽进步很大嘛！我记得你之前还经常躲着猎人们呢。"
        },
        {
          "role": "杜拉夫",
          "text": "呵呵，你别说，这次还多亏了雷泽。有他帮忙跟狼群沟通，我们在附近活动时，就不用担心彼此误伤了。"
        },
        {
          "role": "雷泽",
          "text": "能帮大家，和卢皮卡，开心。但…要说很多话，累。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这也是进步的证明。",
              "dialogues": []
            },
            {
              "text": "为你高兴。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！不过我们这次过来，是有重要的事要告诉你…"
        },
        {
          "type": "subtitle",
          "text": "把法尔伽来信的事告诉了雷泽…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "雷泽",
          "text": "唔…"
        },
        {
          "role": "雷泽",
          "text": "我…不知道。"
        },
        {
          "role": "派蒙",
          "text": "雷泽。你是不想知道亲生父母的事吗？"
        },
        {
          "role": "雷泽",
          "text": "想知道。但…不想知道。"
        },
        {
          "role": "派蒙",
          "text": "唔，又想知道又不想知道的意思吗，好复杂呢…"
        },
        {
          "role": "杜拉夫",
          "text": "旅行者，你来帮我看看刚才布置的陷阱。我们给雷泽留点空间让他消化消化情绪。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么了？",
              "dialogues": []
            },
            {
              "text": "你好像有话要说。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "杜拉夫",
          "text": "嗯，听雷泽那么说，我大致有些猜想。"
        },
        {
          "role": "杜拉夫",
          "text": "最近我们总是一起打猎, 这孩子话很少，但相处久了多少也知道他的性格。"
        },
        {
          "role": "杜拉夫",
          "text": "我觉得，他是想接近自己亲生父母的，只不过对未知事物的恐惧大过了其他东西。"
        },
        {
          "role": "杜拉夫",
          "text": "我也是当爸爸的人了，对孩子的事还算有一些经验。"
        },
        {
          "role": "杜拉夫",
          "text": "迪奥娜小时候，我要是出去打猎回来晚了，接下来的几天里，她都会紧紧盯着我的一举一动，生怕我是不要她了。"
        },
        {
          "role": "派蒙",
          "text": "你是说，雷泽也会担心自己是被亲生父母抛弃的…"
        },
        {
          "role": "杜拉夫",
          "text": "是的，我想这是最关键的问题，真要出了这种情况，我们也不好劝他。另外，我还有其他顾虑…"
        },
        {
          "role": "杜拉夫",
          "text": "雷泽正在以自己的步调成长，很多问题一-时半会儿得不出结论，但总是-点点在改变。"
        },
        {
          "role": "杜拉夫",
          "text": "不过，现在他父母的消息..很可能会迫使他要在短时间内想清楚自己从何而来，又要往何处去。"
        },
        {
          "role": "派蒙",
          "text": "杜拉夫先生的想法跟丽莎小姐很像呢，这就是成熟大人的思考方式吗…"
        },
        {
          "role": "派蒙",
          "text": "站在另一个立场的话…我记得琴团长的说法，更像是信赖他人，相信直觉！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你怎么想？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "既然这是他早晚要面对的…",
              "dialogues": []
            },
            {
              "text": "作为朋友我会陪他一起…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "杜拉夫",
          "text": "我明白了。哈哈，他能有你这样的朋友，我也放心了。"
        },
        {
          "role": "旅行者",
          "text": "派蒙，不如这样…"
        },
        {
          "type": "subtitle",
          "text": "向派蒙描述了计划的措辞…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "好！我明白了！那我们过去吧，别让他等久了。"
        },
        {
          "role": "派蒙",
          "text": "雷泽，你考虑得怎么样了？"
        },
        {
          "role": "雷泽",
          "text": "还在想…心里，怪怪的…像被钩钩果扎到。"
        },
        {
          "role": "旅行者",
          "text": "你觉得法尔伽是怎样的人？"
        },
        {
          "role": "雷泽",
          "text": "法尔伽？唔…高高的，很厉害，喜欢笑。"
        },
        {
          "role": "旅行者",
          "text": "那你相信法尔伽吗？"
        },
        {
          "role": "雷泽",
          "text": "嗯，相信。"
        },
        {
          "role": "雷泽",
          "text": "…他对我好，给我名字，教我战斗。他去做重要的事…我，很想他。"
        },
        {
          "role": "派蒙",
          "text": "雷泽，你知道吗，他信纸都写完了，却还想起来要把那些字挤在背面，特地麻烦丽莎把你父母的东西交给你…"
        },
        {
          "role": "派蒙",
          "text": "这就说明他认为那些东西对你有特殊的意义哦。"
        },
        {
          "role": "派蒙",
          "text": "更重要的是…无论你遇到什么事，旅行者和我，还有丽莎，还有所有的你认识的朋友，都会陪在你身边的。"
        },
        {
          "role": "旅行者",
          "text": "别担心，不会有事的。"
        },
        {
          "role": "杜拉夫",
          "text": "说得没错!「棕色猫叔叔」也支持你。"
        },
        {
          "role": "雷泽",
          "text": "…嗯，谢谢。想好了，我要…和你们，去找师父。"
        },
        {
          "role": "杜拉夫",
          "text": "哈哈，真是个不错的小伙子！"
        },
        {
          "role": "杜拉夫",
          "text": "你们赶紧去忙吧。这边活儿干得差不多，我也得赶快回家了。趁着佳酿节还没开始，赶紧多陪陪女儿，哈哈哈…"
        },
        {
          "role": "派蒙",
          "text": "下次见，杜拉夫先生。"
        },
        {
          "type": "subtitle",
          "text": "返回团长办公室"
        },
        {
          "role": "派蒙",
          "text": "丽莎小姐，我们把雷泽带来了。"
        },
        {
          "role": "雷泽",
          "text": "师父好。我来，看东西。"
        },
        {
          "role": "丽莎",
          "text": "嗯，小狼狼状态不错嘛。看来她们两个已经跟你解释过事情的来龙去脉了。"
        },
        {
          "role": "丽莎",
          "text": "你看，就是这个木盒子，我只是把它取来，还没动过。如果你已经决定了，就亲手打开它吧。"
        },
        {
          "role": "雷泽",
          "text": "嗯，想好了。"
        },
        {
          "role": "木盒",
          "text": "「咔嚓——」"
        },
        {
          "role": "派蒙",
          "text": "咦，箱子里…怎么都是些杂物？还以为一定会有信之类的东西呢。"
        },
        {
          "role": "派蒙",
          "text": "难难难道…时间隔得太久，法尔伽把木盒子记混了！"
        },
        {
          "role": "雷泽",
          "text": "有气味。"
        },
        {
          "role": "派蒙",
          "text": "气味？什么气味？"
        },
        {
          "role": "雷泽",
          "text": "很久很久以前…闻过。气味，是…他们的味道。"
        },
        {
          "role": "雷泽",
          "text": "人类的…爸爸妈妈的味道。"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "丽莎",
          "text": "真难得啊，竞然还能记得小时候闻过的味道。"
        },
        {
          "role": "派蒙",
          "text": "雷泽的嗅觉真厉害，野性也算是一种天赋吧…我们再看看还有没有其他线索！"
        },
        {
          "role": "派蒙",
          "text": "唔，这个毛线手偶歪歪斜斜的，是手工品吧…欸？这个看起来应该是遗迹守卫的零件？"
        },
        {
          "role": "派蒙",
          "text": "等等…你们看，这个酒瓶不是空的，里面还有大半瓶酒的样子！"
        },
        {
          "role": "派蒙",
          "text": "上面还贴着一张纸条，「千」…「千风佳酿」。"
        },
        {
          "role": "丽莎",
          "text": "哦？酒瓶里装的是「千风佳酿」？"
        },
        {
          "role": "雷泽",
          "text": "师父，知道？"
        },
        {
          "role": "丽莎",
          "text": "嗯，据说，「千风佳酿」是蒙德人最早学会酿造的酒。"
        },
        {
          "role": "丽莎",
          "text": "之所以叫这个名字，有人说是因为要放入许多种原料，也有人说，是因为各家酿出来的味道都不一样。"
        },
        {
          "role": "丽莎",
          "text": "我记得有书籍里记载，它的酿造方法千奇百怪，出品的味道也难以控制。"
        },
        {
          "role": "丽莎",
          "text": "这种特性对酒商来说太难把握，他们更愿意选择那些配方稳定的酒作为商品。"
        },
        {
          "role": "丽莎",
          "text": "所以，你就很难在市集和酒馆里见到「千风佳酿」了。"
        },
        {
          "role": "丽莎",
          "text": "小狼狼，看来这瓶酒是你的父母亲手制作的。"
        },
        {
          "role": "派蒙",
          "text": "这么说，它应该是很重要的东西吧…啊，有了！雷泽，既然你的鼻子很灵，要不要打开它闻闻看?说不定能知道些什么！"
        },
        {
          "role": "雷泽",
          "text": "好。"
        },
        {
          "role": "雷泽",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "欸，他闻得好投入…好像还笑了？"
        },
        {
          "role": "丽莎",
          "text": "怎么样？"
        },
        {
          "role": "雷泽",
          "text": "甜的，凉的，一点点苦…喜欢。很多种…各种东西，都在一起。"
        },
        {
          "role": "雷泽",
          "text": "但是，和本来的味道，不一样…"
        },
        {
          "role": "派蒙",
          "text": "就连雷泽也分辨不出来吗？"
        },
        {
          "role": "雷泽",
          "text": "我再，闻闻。"
        },
        {
          "role": "雷泽",
          "text": "……"
        },
        {
          "role": "雷泽",
          "text": "唔…"
        },
        {
          "role": "丽莎",
          "text": "好啦，雷泽，不用为难自己了。当一个方法走不通的时候，我们应该怎么办呢？"
        },
        {
          "role": "雷泽",
          "text": "换…方法。"
        },
        {
          "role": "丽莎",
          "text": "没错哦，你把师父的话记住了呢。"
        },
        {
          "role": "丽莎",
          "text": "马上就到佳酿节了，对酒有研究的人都会聚在蒙德，一定有人知道「千风佳酿」的详细情况。"
        },
        {
          "role": "派蒙",
          "text": "哦！有道理呢！"
        },
        {
          "role": "旅行者",
          "text": "（温迪会来吧？）"
        },
        {
          "role": "丽莎",
          "text": "开幕式很热闹，小可爱和小派蒙不能错过哦。雷泽也刚好跟着一起到现场去打听打听。"
        },
        {
          "role": "雷泽",
          "text": "嗯。试试…多问。"
        },
        {
          "role": "派蒙",
          "text": "我们会陪你一起的，放心啦。我们俩…唔…就像你在杜拉夫先生和狼群之间起到的作用一样！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "奇妙的比喻…",
              "dialogues": []
            },
            {
              "text": "说好会陪你的。",
              "dialogues": [
                {
                  "role": "雷泽",
                  "text": "好。那，我先回去。人类的爸爸妈妈的事，要告诉，卢皮卡。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！开幕式再见！"
        },
        {
          "type": "subtitle",
          "text": "分支对话（丽莎）"
        },
        {
          "role": "丽莎",
          "text": "看到雷泽跨出了第一步，我这个当师父的倍感欣慰呢。"
        },
        {
          "role": "丽莎",
          "text": "小可爱，陪雷泽跑来跑去累了吧。不如休息一下，姐姐给你倒杯茶？"
        },
        {
          "type": "subtitle",
          "text": "等到佳酿节开幕（两天后8-10点）"
        },
        {
          "type": "subtitle",
          "text": "关于「千风佳酿」的确切情报，还是到佳酿节的会场上，找对美酒颇有研究的人打听一下吧。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "分支对话（蕾娅）"
        },
        {
          "type": "subtitle",
          "text": "此分支对话无语音",
          "narration": true
        },
        {
          "role": "蕾娅",
          "text": "丰收季野林猪出没频繁，运送货物时要特别注意安全。"
        },
        {
          "role": "蕾娅",
          "text": "骑士团已经和清泉镇的猎人们一起想办法驱逐野林猪了，听说还有个能和狼沟通的年轻人也来帮忙了…"
        },
        {
          "type": "subtitle",
          "text": "分支对话（格奥尔格）"
        },
        {
          "type": "subtitle",
          "text": "此分支对话无语音",
          "narration": true
        },
        {
          "role": "格奥尔格",
          "text": "你也是来布置店铺的吗？"
        },
        {
          "role": "格奥尔格",
          "text": "这次的美酒集市场地选在清泉镇外，不仅景色优美，运送货品过来也挺方便。"
        },
        {
          "role": "格奥尔格",
          "text": "不过因为我们天使的馈赠店铺面积大，布置准备还是要花相当长时间。"
        },
        {
          "type": "subtitle",
          "text": "前往佳酿节会场"
        },
        {
          "role": "琴",
          "text": "感谢各位的等待，今年，「佳酿节」顺利拉开了帷幕。"
        },
        {
          "role": "琴",
          "text": "希望在此期间，蒙德居民与其他来自各地的游客们，共享美酒，体会丰收的喜悦。"
        },
        {
          "role": "琴",
          "text": "等到「归风日」当天，我们会在此进行举杯仪式，迎接风神巴巴托斯的回归。"
        },
        {
          "role": "琴",
          "text": "听凭风引！"
        },
        {
          "role": "众人",
          "text": "听凭风引！"
        },
        {
          "role": "派蒙",
          "text": "雷泽！原来你已经到了。"
        },
        {
          "role": "雷泽",
          "text": "唔。好多…人…"
        },
        {
          "role": "派蒙",
          "text": "走，我们偷偷溜去找人！"
        },
        {
          "role": "雷泽",
          "text": "找…谁？"
        },
        {
          "role": "派蒙",
          "text": "一个卖唱的，他消息灵通又爱喝酒，或许会知道哦。"
        },
        {
          "type": "subtitle",
          "text": "与温迪交谈"
        },
        {
          "role": "派蒙",
          "text": "卖唱的——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好久不见。",
              "dialogues": []
            },
            {
              "text": "见到你真好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "旅行者，派蒙，你们好啊。啊哈哈，我就知道一定会在这个美妙的节日见到你们。"
        },
        {
          "role": "派蒙",
          "text": "说得真好听，我才不会被骗呢。你嘴里说的美妙是指疯狂喝酒吧。"
        },
        {
          "role": "温迪",
          "text": "哈哈哈，别这么说嘛，这个节日能带给大家的，可远远不止这些呢。"
        },
        {
          "role": "温迪",
          "text": "噢？哎呀，这不是雷泽嘛。最近过得好吗？"
        },
        {
          "role": "雷泽",
          "text": "还好。有事…问。"
        },
        {
          "role": "派蒙",
          "text": "对，雷泽有事要问你。卖唱的，你知道「千风佳酿」吧？"
        },
        {
          "role": "温迪",
          "text": "嗯，好怀念的名字，我想想…上次听到是什么时候来着？"
        },
        {
          "role": "温迪",
          "text": "雷泽的父母给他留了-个盒子，里面放着半瓶酒，标签上写着「千风佳酿」。"
        },
        {
          "role": "派蒙",
          "text": "听说是一种很有历史的酒，制法特别古老…就来问问你。"
        },
        {
          "role": "雷泽",
          "text": "好闻。但是，不知道，有什么。"
        },
        {
          "role": "温迪",
          "text": "原来是这样，是想知道「千风佳酿」的做法吗？那你们又问对人了。我知道一首歌谣，它的名字.嗯，刚好也叫做「千风佳酿」呢。"
        },
        {
          "role": "温迪",
          "text": "本来想留到「归风日」再念的，但为了朋友，就不管这些啦。怎么样，要不要现在就读点给你们听听？"
        },
        {
          "role": "雷泽",
          "text": "歌谣…不好懂。但是，要听。"
        },
        {
          "role": "温迪",
          "text": "是个不错的回答，那我开始喽。"
        },
        {
          "type": "subtitle",
          "text": "温迪："
        },
        {
          "type": "subtitle",
          "text": "「我们把这些东西封进桶，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "等啊，等啊，等着风起涌。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "把佳酿的瓶口先蜡上，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "南风和煦，北风猛。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "温迪："
        },
        {
          "type": "subtitle",
          "text": "「佳酿味道像什么？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "蒙德的名字，自由的梦。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "究竟是什么发酵成佳酿？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "探索的勇气，慈爱的温柔。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "温迪："
        },
        {
          "type": "subtitle",
          "text": "「守护的执着一如初，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "伴着千风起祝颂，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "酸汁变甜，糙桶润透，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "等啊，等啊，等着风起涌。」",
          "narration": true
        },
        {
          "role": "温迪",
          "text": "嘿嘿，谢谢大家的掌声。刚才的歌谣，对你们有帮助吗？"
        },
        {
          "role": "雷泽",
          "text": "和酒很像，有点甜，有点晕。意思，不明白。"
        },
        {
          "role": "派蒙",
          "text": "别说雷泽了，我也这么觉得！的确是在说酿酒这件事，但根本没什么细节嘛！"
        },
        {
          "role": "温迪",
          "text": "哈哈，朦胧而浪漫，这也是蒙德诗歌的特色嘛。"
        },
        {
          "role": "派蒙",
          "text": "真要说酿酒材料的话…唔…唔…"
        },
        {
          "role": "派蒙",
          "text": "「探索的勇气，慈爱的温柔，守护的执着，千风…祝颂…」"
        },
        {
          "role": "派蒙",
          "text": "完全看不出来具体是指什么呀！"
        },
        {
          "role": "派蒙",
          "text": "喂喂，卖唱的，我看你明明什么都知道，那就给点提示呀？"
        },
        {
          "role": "温迪",
          "text": "哎呀，我可不是什么严厉的老师。但歌谣里没唱的内容，我也没办法为你们编出来呀。"
        },
        {
          "role": "温迪",
          "text": "想要知道芬芳的秘密，只能靠你们亲自动手喽？"
        },
        {
          "role": "派蒙",
          "text": "动手的意思…是要我们自己去酿酒吗？而且…酿个酒就能知道很多事吗？卖唱的，你没骗人吧？"
        },
        {
          "role": "温迪",
          "text": "我们认识这么久，你还不相信我的诚意吗？好伤心呢。"
        },
        {
          "role": "雷泽",
          "text": "…我信。我…想试试。"
        },
        {
          "role": "雷泽",
          "text": "我想，自己酿酒，找答案。"
        },
        {
          "role": "雷泽",
          "text": "知道，酒怎么做，也…能知道，爸爸妈妈的酒里，有什么。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "做一样的事，或许也能明白…",
              "dialogues": []
            },
            {
              "text": "他们是怎样的人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "雷泽",
          "text": "对。"
        },
        {
          "role": "雷泽",
          "text": "想知道…他们的事。"
        },
        {
          "role": "派蒙",
          "text": "既然雷泽都这么说了，还是要相信卖唱的呀。试试吧，第一次酿酒的新手，就算失败也不可耻！"
        },
        {
          "type": "subtitle",
          "text": "罗莎莉亚默默转身离开",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "温迪",
          "text": "放心放心，自由一点，没你们想得那么难。"
        },
        {
          "role": "温迪",
          "text": "只要怀着快乐真诚的心情投入材料，就一定能获得想要的结果。"
        },
        {
          "role": "雷泽",
          "text": "……"
        },
        {
          "role": "雷泽",
          "text": "歌谣，我说给，师父听。"
        },
        {
          "role": "雷泽",
          "text": "然后，还要…自己想一想。"
        },
        {
          "role": "派蒙",
          "text": "很有志气嘛，那我们就约两天后再见怎么样？地点的话，就在这里吧！"
        },
        {
          "role": "雷泽",
          "text": "好。我记住了。我们，到时候见。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（温迪）"
        },
        {
          "role": "温迪",
          "text": "嗯，我也觉得还没聊够呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想再听一遍歌谣…",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "哦？那我就再演奏一次前半段吧。"
                },
                {
                  "role": "温迪",
                  "text": "「我们把这些东西封进桶，等啊，等啊，等着风起涌。把佳酿的瓶口先蜡上，南风和煦，北风猛。」"
                },
                {
                  "role": "温迪",
                  "text": "「佳酿味道像什么？蒙德的名字，自由的梦。究竟是什么发酵成佳酿？探索的勇气，慈爱的温柔。」"
                },
                {
                  "role": "温迪",
                  "text": "「守护的执着一如初，伴着千风起祝颂，酸汁变甜，糙桶润透，等啊，等啊，等着风起涌。」"
                }
              ]
            },
            {
              "text": "关于「佳酿节」…",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "蒙德的每个节日我都很喜欢，但对佳酿节，我还是有那么一点偏爱的。"
                },
                {
                  "role": "温迪",
                  "text": "要知道，西风吹完风神就要睡觉了，剩下的冬天交给风神不管的北风。"
                },
                {
                  "role": "温迪",
                  "text": "所以，可以说是冬眠前的大餐哦！"
                }
              ]
            },
            {
              "text": "关于雷泽…",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "那个孩子的事情，你不用太担心。"
                },
                {
                  "role": "温迪",
                  "text": "循着旅途寻找快乐与自由，是蒙德人最擅长的事情啦。"
                },
                {
                  "role": "温迪",
                  "text": "你也一样，要找到你的快乐。啊哈哈，因为在我看来，你的心情非常重要哦。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "再见。别着急，慢慢寻找你们的答案吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "分支对话（丽莎和雷泽）"
        },
        {
          "type": "subtitle",
          "text": "此对话在骑士团琴的办公室",
          "narration": true
        },
        {
          "role": "丽莎",
          "text": "原来如此…还真是有意思的歌谣呢。"
        },
        {
          "role": "雷泽",
          "text": "已经，明白？"
        },
        {
          "role": "丽莎",
          "text": "呵呵…我是你的师父嘛，脑袋不动得快一点可不行。"
        },
        {
          "role": "丽莎",
          "text": "小狼狼，也可以按自己的理解先想一想，这样更容易进步哦。"
        },
        {
          "role": "雷泽",
          "text": "嗯。"
        }
      ],
