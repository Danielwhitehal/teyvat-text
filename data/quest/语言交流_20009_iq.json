  "chapter_title": "语言交流",
  "type": "iq",
  "route": "Language Exchange",
  "stories": [
    {
      "story_id": 20009,
      "title": "语言交流",
      "description": "艾拉·马斯克想要找一群丘丘人练习丘丘语口语。她自称已经有了「完善的语言基础」和「充沛的交流经验」…只是一直没有实际交流过。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与艾拉·马斯克对话"
        },
        {
          "role": "艾拉·马斯克",
          "text": "旅行者，这里，过来这里！"
        },
        {
          "role": "艾拉·马斯克",
          "text": "别惊动了那些丘丘人，你怎么总是直挺挺地往营地里面冲呀…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "算了，不管这些了，我一直在研究丘丘人的语言，但是比起记录，我更想要研究口语。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "好不容易在这里遇见了一个完整的丘丘人营地，我可不能放过这个机会。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "所以，旅行者，你能和我一起去这营地里面，找个丘丘人来练习口语吗？"
        },
        {
          "role": "旅行者",
          "text": "好的，我现在就去抓一个…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "等等！别直接冲进去，这些到底是谁教你的啊？！"
        },
        {
          "role": "艾拉·马斯克",
          "text": "等会和我一起，我们找一个丘丘人，友好地对话吧。"
        },
        {
          "role": "旅行者",
          "text": "还是你自己去吧。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "不行！这是个宝贵的学习机会，就算你想偷懒，我也不会放你走的！"
        },
        {
          "type": "subtitle",
          "text": "和艾拉·马斯克一起前往丘丘人营地"
        },
        {
          "role": "艾拉·马斯克",
          "text": "这里刚好有个丘丘人醒着。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "就这位了，我们快点过去吧。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "小心点，过去的时候别吵醒其他丘丘人。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "不然他们肯定会误会，以为我们是准备来攻击他们。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "要是这样，肯定不能顺利地对话了。"
        },
        {
          "type": "subtitle",
          "text": "与艾拉·马斯克对话"
        },
        {
          "type": "subtitle",
          "text": "击退生气的丘丘人"
        },
        {
          "role": "艾拉·马斯克",
          "text": "小心点，过去的时候别吵醒其他丘丘人。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "不然他们肯定会误会，以为我们是准备来攻击他们。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "要是这样，肯定不能顺利地对话了。"
        },
        {
          "type": "subtitle",
          "text": "与艾拉·马斯克对话"
        },
        {
          "role": "艾拉·马斯克",
          "text": "还好有你在，不然我都不知道怎么收场了。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "我觉得我没说错什么地方呀，到底是哪里的发音出问题了？"
        },
        {
          "role": "艾拉·马斯克",
          "text": "我回去得再好好研究一下…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "都说了别惊醒其他的丘丘人了，你难道从来没有「悄悄接近」丘丘人营地的经验吗？"
        },
        {
          "role": "艾拉·马斯克",
          "text": "唉，这个营地已经没有丘丘人了，大好的机会就被这么浪费了。只能下次再说了。"
        },
        {
          "type": "subtitle",
          "text": "接近醒着的丘丘人，不能吵醒其他丘丘人"
        },
        {
          "type": "subtitle",
          "text": "前往询问艾拉·马斯克"
        },
        {
          "type": "subtitle",
          "text": "与艾拉·马斯克对话"
        }
      ]
    }
  ]
}