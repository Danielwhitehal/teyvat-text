{
  "quest_id": 70504,
  "chapter_num": null,
  "chapter_title": "卸去铠甲之时",
  "type": "wq",
  "route": "When They Take Off Their Armor",
  "stories": [
    {
      "story_id": 70504,
      "title": "卸去铠甲之时",
      "description": "「请问，有人见过凯亚队长吗？」「凯亚先生啊，你要往酒馆里去找。呵呵…新来的吧？加油哦。」",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与凯亚和罗莎莉亚对话",
          "narration": true
        },
        {
          "role": "凯亚",
          "text": "那我就要一杯午后之…"
        },
        {
          "role": "罗莎莉亚",
          "text": "一开口就为难别人，真有你的。"
        },
        {
          "role": "凯亚",
          "text": "哎呀，只是想看她如何应对嘛。倒是没想到罗莎莉亚小姐今天也来喝酒了。"
        },
        {
          "role": "凯亚",
          "text": "酒馆里刁钻的客人那么多，旅行者不早点积累起经验可不行啊。"
        },
        {
          "role": "派蒙",
          "text": "凯亚还是那么油嘴滑舌！"
        },
        {
          "role": "凯亚",
          "text": "冤枉啊，我是一片好意！你不是应该感谢我吗？比如说，给我来一杯简简单单的月夜暗巷什么的。"
        },
        {
          "role": "凯亚",
          "text": "啊对，要大杯！"
        },
        {
          "role": "罗莎莉亚",
          "text": "给我随便来一杯。有茶香的饮品都行，量不用太大。"
        },
        {
          "role": "旅行者",
          "text": "明白了，请稍等片刻。"
        },
        {
          "role": "凯亚",
          "text": "慢慢来。等待美味出品的时间，也是很令人兴奋的。"
        },
         {
          "type": "subtitle",
          "text": "为凯亚和罗莎莉亚调制饮品"
        },
        {
          "role": "派蒙",
          "text": "怎么了，不合罗莎莉亚的口味吗？"
        },
        {
          "role": "旅行者",
          "text": "我可以重做一杯…"
        },
        {
          "role": "罗莎莉亚",
          "text": "不，不是针对你。我只是很少喝茶，这种味道会让我想起一些事。"
        },
        {
          "role": "凯亚",
          "text": "跟教会有关的？"
        },
        {
          "role": "罗莎莉亚",
          "text": "嗯。有一次教会办活动，我没去，没想到芭芭拉给我留了一份茶和点心…"
        },
        {
          "role": "罗莎莉亚",
          "text": "点心放得太久口感很差，她偷偷收走了，"
        },
        {
          "role": "派蒙",
          "text": "罗莎莉亚现在的神态，可真是少见呢。"
        },
        {
          "role": "凯亚",
          "text": "看来蒙德要多一个红茶爱好者了。"
        },
        {
          "role": "罗莎莉亚",
          "text": "那还是酒好。"
        },
        {
          "role": "旅行者",
          "text": "凯亚呢，对饮品满意吗？"
        },
        {
          "role": "凯亚",
          "text": "如果我挑几个瑕疵出来，你是不是会帮我重做一杯？"
        },
        {
          "role": "凯亚",
          "text": "哈哈哈，开玩笑的，我怎么会做这种招你讨厌的事呢。"
        },
        {
          "role": "派蒙",
          "text": "唉，凯亚的思维总是这么跳跃！真亏罗莎莉亚能跟他一起喝酒…"
        },
        {
          "role": "罗莎莉亚",
          "text": "是吗？我根本不关心他的思维。喝酒，就只聊酒。"
        },
        {
          "role": "罗莎莉亚",
          "text": "何况，你也好，这里的老板也好…凯亚只会试探自己感兴趣的人或事。"
        },
        {
          "role": "凯亚",
          "text": "喂！咱们好歹也是酒友吧，你怎么出卖我？"
        },
        {
          "role": "罗莎莉亚",
          "text": "这就算出卖了？根本无所谓吧。"
        },
        {
          "role": "罗莎莉亚",
          "text": "平时生活中「正经人」可太多了。还是酒馆里人人松散的气氛更适合我。"
        },
        {
          "role": "凯亚",
          "text": "哦？到批评正经人的时段了吗？"
        },
        {
          "role": "凯亚",
          "text": "说起这个，我认识的某个人，应该能排进「蒙德正经人榜」前三吧。"
        },
        {
          "role": "凯亚",
          "text": "要说程度…哦，应该这么形容。他已经正经到被当面这样评价表情也完全不会变化的地步了。"
        },
        {
          "role": "派蒙",
          "text": "居然还有这种排名？"
        },
        {
          "role": "凯亚",
          "text": "当然啦。我想想…还有连续喝酒天数排行、最长工作时间排行、厨房杀手排行、禁忌知识储备量排行…"
        },
        {
          "role": "派蒙",
          "text": "蒙德人也太闲了啦！"
        },
        {
          "role": "罗莎莉亚",
          "text": "不用上班的人，有那么多吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "呜，就没有什么能让我和她一起上榜的排行吗？"
                }
              ]
            },
            {
              "text": "我大概知道都在指谁…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "呜，就没有什么能让我和她一起上榜的排行吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "凯亚",
          "text": "有啊，比如「最佳酒保」。"
        },
        {
          "role": "派蒙",
          "text": "真，真的吗！"
        },
        {
          "role": "派蒙",
          "text": "太好了，旅行者，我们也在这里一起留下我们的名字了！"
        },
        {
          "role": "罗莎莉亚",
          "text": "……."
        },
        {
          "role": "罗莎莉亚",
          "text": "哼，这种氛围倒是不错嘛。"
        },
        {
          "role": "凯亚",
          "text": "可不是嘛，光看着她们就觉得开心。"
        },
        {
          "role": "凯亚",
          "text": "极富感染力的氛围，嗯，会成为酒馆一大卖点的呢。看来「最佳酒保」称号给对人了。"
        },
        {
          "role": "派蒙",
          "text": "嗯？"
        },
        {
          "role": "凯亚",
          "text": "没什么，这次多谢两位款待。"
        },
        {
          "role": "罗莎莉亚",
          "text": "嗯，我差不多也该回去了。"
        },
        {
          "role": "罗莎莉亚",
          "text": "另外，红茶味道很好，之后我会试着自己泡泡看…如果早上起得来的话。"
        },
        {
          "role": "凯亚",
          "text": "那就再见喽？"
        },
        {
          "role": "旅行者",
          "text": "下次见。"
        }
      ]
    }
  ]
}