      "title": "雅瓦娜尼的苹果需求",
      "description": "须弥城的雅瓦娜尼想要五个苹果。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将五个苹果交给雅瓦娜尼"
        },
        {
          "role": "雅瓦娜尼",
          "text": "语言是一切社会历史学科的基础，从语言学入手是完全合理的，这个死脑筋…"
        },
        {
          "role": "旅行者",
          "text": "关于苹果…"
        },
        {
          "role": "雅瓦娜尼",
          "text": "阿芬迪先生提醒过我，如果有人来讨论委托相关的事情，我最好用便于理解的表达方式回答。"
        },
        {
          "role": "雅瓦娜尼",
          "text": "那我简单点说吧，你准备好五个苹果了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": []
            },
            {
              "text": "还没有。",
              "dialogues": [
                {
                  "role": "雅瓦娜尼",
                  "text": "嗯，等你准备好了再来找我吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与雅瓦娜尼对话"
        },
        {
          "role": "雅瓦娜尼",
          "text": "谢谢，在阿芬迪先生那里挂委托还挺方便的，不用多做解释，事情就能办成。"
        }
      ]
    }
  ]
