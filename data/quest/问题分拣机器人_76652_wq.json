{
  "quest_id": 76652,
  "chapter_num": null,
  "chapter_title": "问题分拣机器人",
  "type": "wq",
  "route": "Problem-Sorting Robot",
  "stories": [
    {
      "story_id": 76652,
      "title": "问题分拣机器人",
      "description": "蛋卷工坊中，爱诺正为一个出了问题的机器人大感烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "过段时间回工坊看看"
        },
        {
          "type": "subtitle",
          "text": "回蛋卷工坊看看"
        },
        {
          "role": "爱诺",
          "text": "最近怎么这么不顺利，能不能让我睡个好觉！"
        },
        {
          "role": "伊涅芙",
          "text": "稍安勿躁，爱诺，「不顺利」中也藏着「顺利」。等你度过了「不」，之后就是「顺利」。"
        },
        {
          "role": "爱诺",
          "text": "是吗？伊涅芙，你回来之后好像变得更会安慰人了，是旅行者教你的吗？"
        },
        {
          "role": "伊涅芙",
          "text": "谢谢，我也不知道。"
        },
        {
          "role": "伊涅芙",
          "text": "请去休息吧，我会替你检查这些分拣机器人。"
        },
        {
          "role": "爱诺",
          "text": "不行！我要用扳手挨个敲一遍它们的脑袋，看看到底是哪个坏东西在造反。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "欸？旅行者，和派蒙？是你们哦。"
        },
        {
          "role": "派蒙",
          "text": "你们好呀，爱诺，伊涅芙！"
        },
        {
          "role": "爱诺",
          "text": "距离我们上次见面过去多久了啦？唔…好像不太久，但是记不清了。昨天晚上没睡好，今天脑袋不灵光。"
        },
        {
          "role": "爱诺",
          "text": "不管怎么说，见到你们，我的心情变好了一点。"
        },
        {
          "role": "伊涅芙",
          "text": "爱诺，你看，「顺利」就藏在「不顺利」中。"
        },
        {
          "role": "爱诺",
          "text": "嗯？"
        },
        {
          "role": "伊涅芙",
          "text": "你遇到了烦恼，心情很差，但你努力地面对它，很快，旅行者和派蒙出现了，他们让你心情变好。"
        },
        {
          "role": "伊涅芙",
          "text": "这就是说明：「不」已经过去，「顺利」已经到来。"
        },
        {
          "role": "爱诺",
          "text": "真的吗？你好像有点说服我了…"
        },
        {
          "role": "派蒙",
          "text": "哎呀，爱诺怎么心情不好呀？有什么烦恼和我们说说，我们一定帮帮忙！"
        },
        {
          "role": "爱诺",
          "text": "只是些小事啦，最近总有人半夜在工坊外面打架，叮铃哐啷吵得我睡不着。就在昨晚，甚至还打到工坊里来啦！"
        },
        {
          "role": "派蒙",
          "text": "这就是叮铃哐啷蛋卷工坊的含义吗？啊不对不对…那些是什么人？听起来很危险！"
        },
        {
          "role": "伊涅芙",
          "text": "请放心，是一伙盗宝团，他们偷了愚人众的东西，所以正在被追缉。"
        },
        {
          "role": "派蒙",
          "text": "欸？盗宝团？本地的帮派很有志气啊…居然敢把手伸到愚人众的兜兜里。"
        },
        {
          "role": "派蒙",
          "text": "啊，不对不对，不管怎么样…深夜扰民的帮派真是太可恶了！"
        },
        {
          "role": "爱诺",
          "text": "之前伊涅芙不在，我只能躲在工坊里偷偷诅咒他们，好在伊涅芙终于回来了，哼哼…！全部要他们好看！"
        },
        {
          "role": "伊涅芙",
          "text": "昨天晚上我已经把他们都清扫出去了。不会有人再来打扰你，爱诺。"
        },
        {
          "role": "爱诺",
          "text": "嘿嘿，伊涅芙最好了。"
        },
        {
          "role": "派蒙",
          "text": "伊涅芙好厉害！所以问题已经解决了呀？"
        },
        {
          "role": "爱诺",
          "text": "睡不好的问题是解决了，可今天早上我的「淘金小弟」又出故障了。就是这些家伙，它们本来会从垃圾堆里挑出有用的宝贝。"
        },
        {
          "role": "派蒙",
          "text": "哇，那你们也很厉害哦。"
        },
        {
          "role": "爱诺",
          "text": "夸奖的话先暂停啦，现在它们中有一个叛徒！"
        },
        {
          "role": "伊涅芙",
          "text": "嗯，今天早上这些分拣机器人捡回来了一些无用的东西，从占比估算，应该是某一个个体出现了功能故障。"
        },
        {
          "role": "爱诺",
          "text": "你们说，是不是昨晚那帮人把「小弟」打坏了，对吧？我的「小弟」怎么会随随便便自己坏掉！"
        },
        {
          "role": "派蒙",
          "text": "那得让他们赔钱！"
        },
        {
          "role": "爱诺",
          "text": "嗯嗯，我们现在就先把坏「小弟」找出来，再看看是哪里的问题。"
        },
        {
          "role": "派蒙",
          "text": "要怎么找呢？"
        },
        {
          "role": "爱诺",
          "text": "先用凶狠的眼神观察！让它们感到压力，心虚的家伙就会开始汗流浃背。"
        },
        {
          "role": "派蒙",
          "text": "原来是心理攻势…可它们真的会流汗吗？"
        },
        {
          "role": "爱诺",
          "text": "如果不行，那再一个一个拉去小房间审问。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不可以直接拆掉检修吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "那样好像有点不公平。还有两个勤劳的好「小弟」呢，如果把它们当成坏「小弟」一样拆掉，难道不会让它们伤心吗？"
        },
        {
          "role": "派蒙",
          "text": "呃…那好吧…喂！你们三个听见了吗，谁犯了错，自己站出来，不要牵连其他人！我们会…会…"
        },
        {
          "role": "派蒙",
          "text": "我们会怎么样来着？"
        },
        {
          "role": "爱诺",
          "text": "我们会从轻发落！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（用凶狠的眼神来回巡视「小弟」。）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "旅行者，你还挺入戏的嘛！发现什么不对劲了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "左边的「小弟」有问题。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "明明是右边那个吧！"
                }
              ]
            },
            {
              "text": "中间的「小弟」有问题。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "明明是右边那个吧！"
                }
              ]
            },
            {
              "text": "右边的「小弟」有问题。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "哦！就是右边那个家伙！它在我们的心理攻势下露出马脚了！"
        },
        {
          "role": "爱诺",
          "text": "旅行者，帮我抓住它！"
        },
        {
          "type": "subtitle",
          "text": "抓住坏「小弟」"
        },
        {
          "type": "subtitle",
          "text": "抓住其他机器人"
        },
        {
          "role": "爱诺",
          "text": "搞错啦，不是这个！"
        },
        {
          "type": "subtitle",
          "text": "和爱诺交谈"
        },
        {
          "role": "派蒙",
          "text": "爱诺，伊涅芙，我们抓住它了！接下来是不是要检查一下？"
        },
        {
          "role": "伊涅芙",
          "text": "检测到外观一切正常，推测因受攻击而产生故障的可能性减小。"
        },
        {
          "role": "爱诺",
          "text": "难道真的是核心的问题？让我拆开来看看。"
        },
        {
          "role": "派蒙",
          "text": "不好！它要逃跑了！"
        },
        {
          "role": "爱诺",
          "text": "快追！"
        },
        {
          "role": "派蒙",
          "text": "欸…那个是不是它？怎么变得那么大了！"
        },
        {
          "role": "伊涅芙",
          "text": "不，那些是已经报废的分拣机器人。它竟然可以与它们相连接。"
        },
        {
          "role": "爱诺",
          "text": "老实说啊，我已经开始好奇了，这看起来不是简单的故障…"
        },
        {
          "role": "爱诺",
          "text": "我们先把它抓出来吧！"
        },
        {
          "type": "subtitle",
          "text": "抓住坏「小弟」"
        },
        {
          "role": "爱诺",
          "text": "旅行者，你可以把它吸出来！"
        },
        {
          "type": "subtitle",
          "text": "和爱诺交谈"
        },
        {
          "role": "派蒙",
          "text": "终于抓住他了，这下连我都开始好奇了，这个「小弟」到底是怎么回事？"
        },
        {
          "role": "奇怪的淘金小弟",
          "text": "哼，真没见识！"
        },
        {
          "role": "派蒙",
          "text": "欸？！你…你会说话？！爱诺，这应该吗？"
        },
        {
          "role": "爱诺",
          "text": "不可能…虽然我给「淘金小弟」添加了说话的功能，但也都是预设的语音…"
        },
        {
          "role": "爱诺",
          "text": "它们不可能像伊涅芙那样拥有自主意识，毕竟核心完全不是一个级别…"
        },
        {
          "role": "派蒙",
          "text": "可它好像可以交流的样子，难道是核心升级了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你叫什么名字？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奇怪的淘金小弟",
          "text": "怎样？跟你有什么关系啊？"
        },
        {
          "role": "派蒙",
          "text": "这家伙怎么这么嚣张！简直像是我们被它抓住了一样！"
        },
        {
          "role": "奇怪的淘金小弟",
          "text": "不然呢？你们再不离开，我就把你们通通抓起来，送进梅洛彼得…！"
        },
        {
          "role": "伊涅芙",
          "text": "梅洛彼得？那是什么地方？"
        },
        {
          "role": "奇怪的淘金小弟",
          "text": "就是、就是…就是…咦？梅洛彼得什么来着…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "梅洛彼得堡？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奇怪的淘金小弟",
          "text": "梅洛彼得堡…好像是这个名字…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是从枫丹来的吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奇怪的淘金小弟",
          "text": "干嘛？不要一上来就打听女孩子的私生活！"
        },
        {
          "role": "派蒙",
          "text": "喂！什么女孩子，你不是个垃圾分类机器人吗？"
        },
        {
          "role": "奇怪的淘金小弟",
          "text": "是女孩子！"
        },
        {
          "role": "爱诺",
          "text": "这太不对劲了，虽然不知道发生了什么…但它肯定不是原本的「淘金小弟」…"
        },
        {
          "role": "爱诺",
          "text": "决定了，就把你拆开来看看是怎么回事吧！"
        },
        {
          "role": "奇怪的淘金小弟",
          "text": "不要对我动手动脚啊！救命！"
        },
        {
          "role": "爱诺",
          "text": "我也是女孩子！"
        },
        {
          "role": "奇怪的淘金小弟",
          "text": "女孩子也不行！"
        },
        {
          "role": "伊涅芙",
          "text": "旅行者，派蒙，抱歉，爱诺兴趣来了就会全神贯注。请给她一些时间吧，她会弄清楚发生了什么。"
        },
        {
          "role": "伊涅芙",
          "text": "如果你们也想知道，明天的这时候再来工坊看看吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（爱诺&伊涅芙&奇怪的淘金小弟）"
        },
        {
          "role": "爱诺",
          "text": "我要动手了哦！"
        },
        {
          "role": "奇怪的淘金小弟",
          "text": "啊啊！"
        },
        {
          "role": "伊涅芙",
          "text": "别害怕，爱诺不会伤害你的。"
        },
        {
          "type": "subtitle",
          "text": "等待到第二天（8:00-24:00）"
        },
        {
          "type": "subtitle",
          "text": "和爱诺交谈"
        },
        {
          "role": "爱诺",
          "text": "真奇怪，我用的明明是挪德卡莱普通机械的核心…"
        },
        {
          "role": "派蒙",
          "text": "爱诺，伊涅芙，我们来啦。"
        },
        {
          "role": "伊涅芙",
          "text": "你们好，欢迎。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "爱诺找到原因了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "故障的原因倒是找到啦，可是问题反而变得更多了。"
        },
        {
          "role": "派蒙",
          "text": "为什么啊？"
        },
        {
          "role": "伊涅芙",
          "text": "故障机器人的核心不对，不是爱诺原本使用的核心，而是一颗来自枫丹发条机关的核心。"
        },
        {
          "role": "派蒙",
          "text": "核心变了？！那我们要把它找回来吗？！"
        },
        {
          "role": "爱诺",
          "text": "不用着急啦，原本的核心都是我从各种垃圾上拆下来的，很普通，就算丢一百个也没关系。"
        },
        {
          "role": "爱诺",
          "text": "问题是现在的这颗核心，它非常高级，有很多连我也不懂的功能模块…"
        },
        {
          "role": "派蒙",
          "text": "居然是这样？这就是它会说话的原因？和伊涅芙一样？"
        },
        {
          "role": "爱诺",
          "text": "不知道，不过我能看出来，这颗核心应该经历过一次严重的爆炸，大部分模块都已经损毁了，没有一个地方是我能修的…"
        },
        {
          "role": "派蒙",
          "text": "连爱诺都办不到吗…"
        },
        {
          "role": "伊涅芙",
          "text": "虽然这枚核心来自枫丹，但使用的是一种冷门的技术，除非有相关知识，否则没有人能快速取得突破。"
        },
        {
          "role": "爱诺",
          "text": "话是这么说，但我也不是毫无收获啦，嘿嘿，我还是在损毁的数据片段中挖出了一个有意义的符号，是一个字——「莎」。"
        },
        {
          "role": "派蒙",
          "text": "莎？这是它的名字吗？"
        },
        {
          "role": "爱诺",
          "text": "我猜不是，但一定有重要意义！因为这个字是在核心最底层发现的，那是被保护得最好的地方，所以才有机会遗留下来。"
        },
        {
          "role": "派蒙",
          "text": "被保护得最好的地方…？"
        },
        {
          "role": "伊涅芙",
          "text": "如果我的核心将要损坏，我会把有关爱诺的数据放在那种地方。"
        },
        {
          "role": "爱诺",
          "text": "呸呸！霉霉飞飞！伊涅芙，你的核心才不会坏呢，不要说不吉利的话！"
        },
        {
          "role": "伊涅芙",
          "text": "只是情景的模拟说明。"
        },
        {
          "role": "爱诺",
          "text": "不管，快跟我念，呸呸！霉霉飞飞！"
        },
        {
          "role": "伊涅芙",
          "text": "呸呸，霉霉飞飞，这样吗？"
        },
        {
          "role": "爱诺",
          "text": "这才对嘛。"
        },
        {
          "role": "派蒙",
          "text": "噫…"
        },
        {
          "role": "爱诺",
          "text": "话说回来，在这颗核心的底层，应该还存在些完好并有意义的数据，不然它应该说不了话才对。"
        },
        {
          "role": "爱诺",
          "text": "小数据~我要慢慢把你们挖出来~一个都别跑~"
        },
        {
          "role": "派蒙",
          "text": "好神秘的核心啊…可它都这么不简单了，怎么会跑到「淘金小弟」里来呢？"
        },
        {
          "role": "爱诺",
          "text": "恭喜派蒙！你找到了最大的问题！"
        },
        {
          "role": "爱诺",
          "text": "不知道是谁在什么时候，把一颗虽然损毁、但还是很有研究价值的核心和「淘金小弟」原本的捡破烂核心掉了包。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "会不会和愚人众或盗宝团有关系。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "恭喜旅行者！你发现了最可能的答案！"
        },
        {
          "role": "爱诺",
          "text": "它故障的前一天发生了什么？一队愚人众追着一伙盗宝团打进了工坊。"
        },
        {
          "role": "爱诺",
          "text": "会不会这枚核心就是盗宝团从愚人众手里偷来的？情急之下又把它塞进了「淘金小弟」里，又把淘金小弟的核心让出去交差。"
        },
        {
          "role": "爱诺",
          "text": "是不是很合理？伊涅芙，我是不是很聪明？"
        },
        {
          "role": "伊涅芙",
          "text": "当然。虽然以上只是爱诺的推测。但我们从秘闻馆取得了一些相互印证的情报——"
        },
        {
          "role": "伊涅芙",
          "text": "一支隶属于「木偶」的部队前日返回至冬时货物失窃，失窃物品不详。盗窃者是一伙只有三人的盗宝团。"
        },
        {
          "role": "伊涅芙",
          "text": "首领为一名白发戴兜帽的女子，余下是一名粉色头发和一名蓝紫色头发的男子。"
        },
        {
          "role": "派蒙",
          "text": "哇哦，这就是那个有志气的本地帮派吧！"
        },
        {
          "role": "伊涅芙",
          "text": "他们是最近开始活跃的，秘闻馆那边推测，可能是外地流窜过来的人马。"
        },
        {
          "role": "爱诺",
          "text": "不要管他们啦，反正雅珂达说了只是一些小鱼小虾。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你们现在打算怎么办？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，如果真是那伙盗宝团偷偷放的，他们肯定还会再来的。"
        },
        {
          "role": "爱诺",
          "text": "那就来吧，如果他们态度还行的话，我就请他们吃蛋卷。"
        },
        {
          "role": "爱诺",
          "text": "如果态度很恶劣，伊涅芙会请他们甜甜圈吃到饱。"
        },
        {
          "role": "派蒙",
          "text": "那他们要是偷偷溜进来把核心偷走怎么办？"
        },
        {
          "role": "爱诺",
          "text": "嘿嘿，我早就想到了，所以今天就要把它藏起来。"
        },
        {
          "role": "爱诺",
          "text": "伊涅芙，请把阿莎莎它们叫出来吧。"
        },
        {
          "role": "爱诺",
          "text": "当当当当，我打算把阿莎莎藏进报废的淘金小弟里面。"
        },
        {
          "role": "阿莎莎",
          "text": "谁给你替我起名的权力？"
        },
        {
          "role": "爱诺",
          "text": "我们总得用一个名字叫你吧。"
        },
        {
          "role": "阿莎莎",
          "text": "郎…郎勃罗？"
        },
        {
          "role": "爱诺",
          "text": "这是什么奇怪的名字啊？也是你从数据废墟里搜出来的吗，一点也不淑女。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "阿莎莎·郎勃罗呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "噢，如果是姓氏的话，好像还可以接受。那就这么决定了，阿莎莎·郎勃罗！你没有意见吧？"
        },
        {
          "role": "爱诺",
          "text": "有意见我也不管你，谁让你随便跑到别人家里来。以后你就给我好好在这里打工哦！"
        },
        {
          "role": "阿莎莎·郎勃罗",
          "text": "哼！"
        },
        {
          "role": "派蒙",
          "text": "它好像很不情愿的样子…"
        },
        {
          "role": "伊涅芙",
          "text": "不，它其实并没有情愿或不情愿的情感。"
        },
        {
          "role": "派蒙",
          "text": "欸？什么意思？"
        },
        {
          "role": "爱诺",
          "text": "因为它的核心已经被毁得不成样子啦。它现在说的话，它的语气，都只是对数据废墟中残留片段的模拟。"
        },
        {
          "role": "爱诺",
          "text": "说得再清楚一些，假如「莎」代表了某个人的话，现在的阿莎莎就是在模仿那个人说话。"
        },
        {
          "role": "派蒙",
          "text": "居然是这样…"
        },
        {
          "role": "爱诺",
          "text": "嗯，不说那些了，我们先干正事吧！把阿莎莎藏起来。"
        },
        {
          "role": "爱诺",
          "text": "旅行者，你来试试怎么样？很有意思的。"
        },
        {
          "type": "subtitle",
          "text": "把「阿莎莎」藏起来"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "拼合",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿莎莎·郎勃罗",
          "text": "啊…啊…啊…"
        },
        {
          "type": "subtitle",
          "text": "和爱诺交谈"
        },
        {
          "role": "爱诺",
          "text": "做得很漂亮嘛！旅行者也很有当机械师的天赋。"
        },
        {
          "role": "爱诺",
          "text": "谢谢你们，这下我有了一个更厉害的「淘金小弟」。"
        },
        {
          "role": "爱诺",
          "text": "阿莎莎，你以后要认真干活噢，我会给你发工资的。"
        },
        {
          "role": "阿莎莎·郎勃罗",
          "text": "谁稀罕啦！"
        },
        {
          "role": "爱诺",
          "text": "你的脾气真是不太好，给你戴一朵花花。希望你能温柔一点，呐~"
        },
        {
          "role": "爱诺",
          "text": "嗯，这下子看起来可爱多了。"
        },
        {
          "role": "爱诺",
          "text": "对了，旅行者，派蒙，要是以后你们也捡到了没用的材料，比如螺丝螺母什么的，可以送来我这里。"
        },
        {
          "role": "爱诺",
          "text": "我能把它们都变成花花，或者用来升级我的操作台，嘿嘿。当然不会让你们白干活，报酬一定会让你们愿意天天来的。"
        },
        {
          "role": "爱诺",
          "text": "成交吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当然。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "太好咯！果然还是伊涅芙说的对呀。「不顺利」中也藏着「顺利」。等你度过了「不」，之后就是「顺利」。"
        },
        {
          "role": "爱诺",
          "text": "你们的旅途一定也会是这样。"
        },
        {
          "type": "subtitle",
          "text": "解锁功能「共建聚所·叮铃哐啷蛋卷工坊」",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "额外对话1（爱诺&阿莎莎·郎勃罗）"
        },
        {
          "role": "爱诺",
          "text": "阿莎莎，最近你总能从垃圾堆里挑出有用的宝贝，是不是变聪明了？"
        },
        {
          "role": "阿莎莎·郎勃罗",
          "text": "哼，我比你聪明一万倍。"
        },
        {
          "role": "爱诺",
          "text": "哎呀，比聪明更膨胀的原来是嚣张。再这样我就要把你的花花摘掉，它开始让你认不清自己啦。"
        },
        {
          "role": "阿莎莎·郎勃罗",
          "text": "不许摘！那不是花花。"
        },
        {
          "role": "爱诺",
          "text": "明明就是我上次给你戴的花花。"
        },
        {
          "role": "阿莎莎·郎勃罗",
          "text": "总之不许摘！"
        },
        {
          "role": "爱诺",
          "text": "为什么？"
        },
        {
          "role": "阿莎莎·郎勃罗",
          "text": "因为那是我的聪明草。"
        },
        {
          "type": "subtitle",
          "text": "额外对话2（爱诺&伊涅芙）"
        },
        {
          "role": "爱诺",
          "text": "伊涅芙，让我考考你吧，家鸭和野鸭的区别是什么？"
        },
        {
          "role": "伊涅芙",
          "text": "家鸭是家鸭，野鸭是野鸭。"
        },
        {
          "role": "爱诺",
          "text": "没错，就是这样。"
        },
        {
          "role": "爱诺",
          "text": "我再考考你，它们和重拳出击鸭的区别是什么呢？"
        },
        {
          "role": "伊涅芙",
          "text": "重拳出击鸭是重拳出击鸭。"
        },
        {
          "role": "爱诺",
          "text": "错误！家鸭和野鸭都是鸭，但是重拳出击鸭不是鸭。"
        },
        {
          "role": "伊涅芙",
          "text": "原来如此，那…机器人是人吗？"
        },
        {
          "role": "爱诺",
          "text": "当然不是。"
        },
        {
          "role": "伊涅芙",
          "text": "所以，我不是人。"
        },
        {
          "role": "爱诺",
          "text": "你是伊涅芙，独一无二的伊涅芙，爱诺的伊涅芙。"
        },
        {
          "role": "爱诺",
          "text": "就像我是爱诺，独一无二的爱诺，伊涅芙的爱诺那样。"
        },
        {
          "role": "伊涅芙",
          "text": "明白了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话3（爱诺&伊涅芙）"
        },
        {
          "role": "伊涅芙",
          "text": "救——命——啊——"
        },
        {
          "role": "派蒙",
          "text": "是爱诺！嘿嘿，你在这里干什么呀？"
        },
        {
          "role": "爱诺",
          "text": "是你们呀，你们来的正好，我在玩呢，嘿嘿，要一起吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "伊涅芙没有和你一起玩吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "当然有呀，她最喜欢和我一起玩了。"
        },
        {
          "role": "派蒙",
          "text": "欸？她在哪里呀？"
        },
        {
          "role": "爱诺",
          "text": "喏。"
        },
        {
          "role": "伊涅芙",
          "text": "救——命——啊——"
        },
        {
          "role": "爱诺",
          "text": "这就是伊涅芙最喜欢玩的「叮铃哐啷爱诺翱翔」，她说这样既能开拓视野，又能活动筋骨。"
        },
        {
          "role": "派蒙",
          "text": "可是她在喊救命欸！"
        },
        {
          "role": "爱诺",
          "text": "那是为了娱乐效果啦，不信你们看。"
        },
        {
          "role": "爱诺",
          "text": "伊涅芙，该回家啦！"
        },
        {
          "role": "伊涅芙",
