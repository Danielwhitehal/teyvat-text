{
  "quest_id": 75076,
  "chapter_num": null,
  "chapter_title": "浮羽之滨的迷局",
  "type": "wq",
  "route": "The Mystery of Tecoloapan Beach",
  "stories": [
    {
      "story_id": 75076,
      "title": "浮羽之滨的迷局",
      "description": "靠近迷雾中的海岛时，传来了奇怪的话语声，这海岛深处又隐藏着怎样的过往呢…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "解开迷雾中海岛的秘密"
        },
        {
          "type": "subtitle",
          "text": "揭开海岛的封印"
        },
        {
          "role": "萨卡乌",
          "text": "海上的迷雾最近越发深重了，啊…真是让人忧心…"
        },
        {
          "role": "萨卡乌",
          "text": "难道那个传说是真的？"
        },
        {
          "role": "旅行者",
          "text": "什么传说？"
        },
        {
          "role": "萨卡乌",
          "text": "呃…啊，这就要看异邦的勇士你要听什么样的传说了…"
        },
        {
          "role": "萨卡乌",
          "text": "关于海面上浮岛与巨大涂鸦的故事，有两个来由，一个更像故事，一个更像真实的传说。"
        },
        {
          "role": "萨卡乌",
          "text": "异邦的勇士，你想要听哪一个呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于故事…",
              "dialogues": [
                {
                  "role": "萨卡乌",
                  "text": "嗯，更像故事的那边总是比较浪漫啦…迷雾浮岛中涂鸦的来源，是一部名为《奎伊露和乌库库的故事》中的一部分。"
                },
                {
                  "role": "萨卡乌",
                  "text": "据说名叫奎伊露的少女为了与她的太阳父亲联系，而在那海滨之处留下了巨大的涂鸦。"
                },
                {
                  "role": "萨卡乌",
                  "text": "她的太阳父亲在天上看到涂鸦，于是将她从地上接走…大致就是这样的故事。"
                },
                {
                  "role": "萨卡乌",
                  "text": "那看上去令人不安的迷雾，据说是太阳父亲给予地上部族民的惩罚，因为部族民夺去了他女儿的力量。"
                }
              ]
            },
            {
              "text": "关于真实的传说…",
              "dialogues": [
                {
                  "role": "萨卡乌",
                  "text": "关于真实的传说嘛…据说很久以前，有很邪恶的巫师扮作大灵的样子，蛊惑了部族的勇士。"
                },
                {
                  "role": "萨卡乌",
                  "text": "后来，部族的勇士们不得不用巨大的涂鸦，将那个黑漆漆的邪恶巫师关在了涂鸦的封印之下…"
                },
                {
                  "role": "萨卡乌",
                  "text": "海面之所以会变成这个样子，据说是因为邪恶的巫师会突破封印，从封印中跑出来为非作歹的预兆。"
                }
              ]
            }
          ]
        },
        {
          "role": "萨卡乌",
          "text": "唉，不管是传说还是故事，迷雾自海上升起，都不是什么吉兆。"
        },
        {
          "role": "萨卡乌",
          "text": "异邦的勇士啊…那里现在说不定很危险，一定要小心，最好不要靠近啊…"
        },
        {
          "type": "subtitle",
          "text": "继续揭开海岛的封印"
        },
        {
          "type": "subtitle",
          "text": "继续揭开海岛的封印"
        },
        {
          "type": "subtitle",
          "text": "前往被涂鸦封印的中心"
        },
        {
          "type": "subtitle",
          "text": "与深渊魔物化作的大灵显化身战斗"
        },
        {
          "type": "subtitle",
          "text": "与大灵显化身对话"
        },
        {
          "role": "虚弱的大灵显化身",
          "text": "啊，终于…异邦的勇士啊，若不是你相助，恐怕此处早已被漆黑的大敌占据…"
        },
        {
          "role": "虚弱的大灵显化身",
          "text": "…许久之前，此处的部族住民受到漆黑大敌显化的造型的蛊惑，诸多夜魂亦被深渊纠缠。"
        },
        {
          "role": "虚弱的大灵显化身",
          "text": "受封之处，即便是夜之化身的力量也被一点点蚕食…此处的封印隔绝了外界，也隔绝了部族之人信念的来源。"
        },
        {
          "role": "虚弱的大灵显化身",
          "text": "唯有揭开封印，才有一战之力…"
        },
        {
          "role": "虚弱的大灵显化身",
          "text": "多谢你啊，异邦的勇士…夜魂得以回归迷梦的故土，避免污秽的瘤瘿占据夜神的国度。"
        },
        {
          "role": "虚弱的大灵显化身",
          "text": "啊，终于，可以回归夜的静谧之处了…"
        },
        {
          "type": "subtitle",
          "text": "返回地上"
        }
      ]
    }
  ]
}