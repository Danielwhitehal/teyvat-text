{
  "quest_id": 73058,
  "chapter_num": null,
  "chapter_title": "兰迦鲁的涂鸦",
  "type": "wq",
  "route": "Aragaru's Drawing",
  "stories": [
    {
      "story_id": 73058,
      "title": "兰迦鲁的涂鸦",
      "description": "帮助兰迦鲁击败了盘踞在茸蕈窟中的镀金旅团，但镀金旅团的目的，似乎与兰迦鲁忘却的一段友情有关…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "欸？是镀金旅团！他们在这里干什么？"
        },
        {
          "role": "派蒙",
          "text": "这里一定还有很多他们的同伙，不知道他们是不是冲着兰那罗来的呢…"
        },
        {
          "role": "派蒙",
          "text": "唔，好在意！我们快去教训一下他们！"
        },
        {
          "role": "「法罗赫之子」",
          "text": "啊，原来是你。卢妮雅向你问好！"
        },
        {
          "type": "subtitle",
          "text": "和兰迦鲁对话"
        },
        {
          "role": "兰迦鲁",
          "text": "金色的那菈，白色的飞飞！又见到你们啦！"
        },
        {
          "role": "派蒙",
          "text": "呜哇，下次突然出现请打声招呼啦！又吓我一跳！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们不是坏人。",
              "dialogues": []
            },
            {
              "text": "我们帮你打跑了坏人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰迦鲁",
          "text": "哼…你们说的有道理啦…所以，看起来不像坏蛋的金色那菈和白飞飞，可以再帮我一个忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "乐意效劳，我是旅行者。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我是派蒙，这次可别忘啦！"
        },
        {
          "role": "兰迦鲁",
          "text": "这次…？呃…咳咳，我是兰迦鲁！"
        },
        {
          "role": "派蒙",
          "text": "我们和你一起来过这里哦，但是你忘记啦…唔，好难解释！旅行者，我们一起给他讲讲吧？"
        },
        {
          "type": "subtitle",
          "text": "你们具言了与兰迦鲁冒险的所见所闻。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "兰迦鲁",
          "text": "这样吗…虽然我不记得了，但不知为什么，我愿意相信你们…而且你们有我送的花，我能感知到她在。"
        },
        {
          "role": "兰迦鲁",
          "text": "啊，对了！坏蛋那菈留下了营地，我们去找找看他们留下了什么东西，说不定能知道他们在盘算什么！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（兰迦鲁）"
        },
        {
          "role": "兰迦鲁",
          "text": "去看看坏蛋那菈的营地吧！一定能知道他们是来做什么的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是怎么分辨坏蛋的？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰迦鲁",
          "text": "唔…不知道，说不清楚！但是我知道，那菈旅行者和白飞飞一定不是坏人！兰迦鲁相信！"
        },
        {
          "type": "subtitle",
          "text": "粗糙的涂鸦"
        },
        {
          "role": "粗糙的涂鸦",
          "text": "（粗糙幼稚的涂鸦，似乎是很久以前的兰那罗与孩子们留下的。）"
        },
        {
          "role": "派蒙",
          "text": "这些符文…一定也与那些镀金旅团的「雇主」有关吧。"
        },
        {
          "type": "subtitle",
          "text": "粗糙的涂鸦"
        },
        {
          "role": "粗糙的涂鸦",
          "text": "（粗糙幼稚的涂鸦，似乎是很久以前的兰那罗与孩子们留下的。）"
        },
        {
          "role": "派蒙",
          "text": "唔…不知道那些与兰那罗同行的小孩子，现在长成了什么样的大人呢…"
        },
        {
          "type": "subtitle",
          "text": "粗糙的涂鸦"
        },
        {
          "role": "粗糙的涂鸦",
          "text": "（粗糙幼稚的涂鸦，似乎是很久以前的兰那罗与孩子们留下的。）"
        },
        {
          "role": "派蒙",
          "text": "你说，我们也会遗忘这些故事吗？就像留下了这些的孩子那样……"
        },
        {
          "type": "subtitle",
          "text": "粗糙的涂鸦"
        },
        {
          "role": "粗糙的涂鸦",
          "text": "（粗糙幼稚的涂鸦，似乎是很久以前的兰那罗与孩子们留下的。）"
        },
        {
          "role": "派蒙",
          "text": "这些对于兰那罗和孩子们，到底意味着什么呢？"
        },
        {
          "type": "subtitle",
          "text": "调查镀金旅团的营地"
        },
        {
          "type": "subtitle",
          "text": "调查粗糙的涂鸦前光点",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "这里…嗯，只有一些物资而已。"
        },
        {
          "type": "subtitle",
          "text": "调查营地",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "没有呢，但他们为什么在这里扎营呀…"
        },
        {
          "type": "subtitle",
          "text": "靠近雇主的命令",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "欸？这是什么呀？信封吗？我们仔细看看吧！"
        },
        {
          "type": "subtitle",
          "text": "雇主的命令"
        },
        {
          "type": "subtitle",
          "text": "搜寻并捕获名为『兰那罗』的小型植物个体，完好无损地带回教令院。会面地点届时而定。此种生物可能无法通过目击得见，如有可能，请令少年少女与之交流，借机诱捕。必要时保护其安全。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "请切记，保护好这枝风干的花朵，可能它是能令你们与名为『兰那罗』的生物沟通之关键。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "或许你们会抱怨此次行程荒唐无聊，但在抱怨之前请好好想想，完成法罗赫老爹的女儿亲自交予的委托…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "…能够为你们带来多大的利益与名声。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "——熙蔓·法罗赫扎德",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "原来这些坏家伙背后有人操纵呢…"
        },
        {
          "type": "subtitle",
          "text": "和兰迦鲁对话"
        },
        {
          "role": "兰迦鲁",
          "text": "怎么样，有发现什么吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…只发现了语焉不详的命令，还有这个！一朵风干的花！"
        },
        {
          "role": "兰迦鲁",
          "text": "欸…！这个，可以给我吗？"
        },
        {
          "role": "派蒙",
          "text": "这个是坏人留下的，你就不怕有毒…什么的吗？"
        },
        {
          "role": "兰迦鲁",
          "text": "不需要担心，我见过这朵花…那个人，我应该见过…请你交给我，好吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请你拿去吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰迦鲁",
          "text": "谢谢你！那菈旅行者和白飞飞！"
        },
        {
          "type": "subtitle",
          "text": "兰迦鲁将风干的小花带去了无郁稠林…",
          "narration": true,
          "color": "描述"
        }
      ],
