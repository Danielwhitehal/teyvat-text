  "chapter_title": "冒险家测验·起飞方式",
  "type": "iq",
  "route": "Adventurer Exam: Taking Flight",
  "stories": [
    {
      "story_id": 20067,
      "title": "冒险家测验·起飞方式",
      "description": "蒙德城的安娜真的想要成为冒险家…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "安娜",
          "text": "到底是哪里出了问题…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "安娜",
          "text": "旅行者…呜…"
        },
        {
          "role": "安娜",
          "text": "自从上次你给我辅导之后，我又很认真地学习了很久。"
        },
        {
          "role": "安娜",
          "text": "然后，我就请杰克来帮我做了一次模拟考试。"
        },
        {
          "role": "安娜",
          "text": "结果…结果考下来，我不及格…"
        },
        {
          "role": "安娜",
          "text": "真不知道是哪里出了问题…旅行者，你能再辅导我一下吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "（难道上次有答案错了…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安娜",
          "text": "那就拜托你了，旅行者！"
        },
        {
          "role": "安娜",
          "text": "唔…第一个问题是，在飞行时，最多可以同时几人共用一架风之翼？"
        },
        {
          "role": "安娜",
          "text": "喔…我差不多了解了！不过光听理论也不行…"
        },
        {
          "role": "安娜",
          "text": "旅行者，能请你为我演示一下风之翼的操纵方式吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "你可要看好了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安娜",
          "text": "那就拜托你啦，我们赶紧出发吧！"
        },
        {
          "type": "subtitle",
          "text": "为安娜演示操纵风之翼的方法"
        },
        {
          "role": "旅行者",
          "text": "一架风之翼只可由一人使用。"
        },
        {
          "role": "安娜",
          "text": "原来如此…"
        },
        {
          "type": "subtitle",
          "text": "为安娜演示操纵风之翼的方法"
        },
        {
          "role": "旅行者",
          "text": "这取决于风之翼操纵者的水平。"
        },
        {
          "role": "安娜",
          "text": "原来如此…"
        },
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "旅行者",
          "text": "这取决于风之翼操纵者的体重。"
        },
        {
          "role": "安娜",
          "text": "原来如此…"
        },
        {
          "role": "安娜",
          "text": "你操纵风之翼的手法可真是太厉害了，怪不得安柏小姐要我来请教你呢。"
        },
        {
          "role": "安娜",
          "text": "嘿嘿，有你给我辅导，我肯定能通过飞行执照的考试。"
        },
        {
          "role": "安娜",
          "text": "谢谢你啦，这些东西请你收下，我先回去复习了。"
        },
        {
          "role": "安娜",
          "text": "唔…我的风之翼用什么颜色比较好呢…"
        },
        {
          "role": "安娜",
          "text": "蓝色？绿色？不然都要一点好了…"
        },
        {
          "role": "安娜",
          "text": "第二个问题是，使用风之翼起飞时，需要注意什么？"
        },
        {
          "role": "旅行者",
          "text": "需采取合理的起飞动作与起飞地点。"
        },
        {
          "role": "安娜",
          "text": "是这样吗…"
        }
      ]
    }
  ]
}