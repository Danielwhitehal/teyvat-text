{
  "quest_id": 41155,
  "chapter_num": null,
  "chapter_title": "猎鹿急送",
  "type": "eq",
  "route": "Good Hunter Express",
  "stories": [
    {
      "story_id": 41155,
      "title": "猎鹿急送",
      "description": "蒙德城的猎鹿人餐馆里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "莎拉",
          "text": "好吧…那我等等有没有别人能接这个委托。"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "莎拉",
          "text": "那就最好了，谢谢你。"
        },
        {
          "role": "莎拉",
          "text": "路上注意安全，不要被废墟里的东西袭击了。也记得别跑太快，会把菜漏了的。"
        },
        {
          "role": "莎拉",
          "text": "好了，快点把这道菜送过去吧，凉了就不好吃了。"
        },
        {
          "role": "卖力的西瑞",
          "text": "我饿了。"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "莎拉",
          "text": "是的，西瑞今天又定了一份蒙德烤鱼，然后就去风龙废墟了。麻烦你帮忙，赶快送过去。"
        },
        {
          "role": "莎拉",
          "text": "这份蒙德烤鱼，请注意不要沾染上什么奇怪的元素，不然味道也会变怪的。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "卖力的西瑞",
          "text": "太好了！吃完了才有力气从这个鬼地方回去。"
        }
      ]
    }
  ]
}