{
  "quest_id": 71831,
  "chapter_num": null,
  "chapter_title": "身后事·归于山中",
  "type": "wq",
  "route": "Hereafter: Return to the Mountains",
  "stories": [
    {
      "story_id": 71831,
      "title": "身后事·归于山中",
      "description": "王平安承诺要为「铜雀」重修庙宇。不知道那座庙现在修得如何了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "回到铜雀雕像所在地"
        },
        {
          "role": "王平安",
          "text": "香炉就在那边，您要敬香的话就过去吧。"
        },
        {
          "type": "subtitle",
          "text": "与王平安对话"
        },
        {
          "role": "王平安",
          "text": "这庙看着还算不错…"
        },
        {
          "role": "旅行者",
          "text": "确实很不错。"
        },
        {
          "role": "王平安",
          "text": "欸？您来得倒是刚刚好，这庙才修好不久，我刚给工匠们结完钱呢。"
        },
        {
          "role": "王平安",
          "text": "唉…没想到居然花了这么多钱，我辛苦赚的那些钱，已经全部砸里面了…"
        },
        {
          "role": "王平安",
          "text": "不过无论如何，这庙建好了就行。"
        },
        {
          "role": "王平安",
          "text": "您想去庙里敬敬香吗？我还专门托人做了一个新香炉呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好。",
              "dialogues": []
            },
            {
              "text": "你也敬香了？",
              "dialogues": [
                {
                  "role": "王平安",
                  "text": "那当然。庙刚建好之后，我可是敬了一柱上好的香，刚刚才烧完了。"
                }
              ]
            }
          ]
        },
        {
          "role": "王平安",
          "text": "这几柱香您拿着，香炉就在那边。"
        },
        {
          "type": "subtitle",
          "text": "向铜雀敬香"
        },
        {
          "type": "subtitle",
          "text": "与王平安对话"
        },
        {
          "role": "王平安",
          "text": "您敬好香了吧，感觉怎么样？"
        },
        {
          "role": "旅行者",
          "text": "还不错。"
        },
        {
          "role": "王平安",
          "text": "那就好。希望这座庙以后香火会盛一点…"
        },
        {
          "role": "王平安",
          "text": "我会暂时待在这里一段时间。这里很清静，是个进行编写工作的好地方。"
        },
        {
          "role": "王平安",
          "text": "我得尽快整理一下我之前搜集的那些资料，然后继续编写那本有关「护法夜叉」的书。"
        },
        {
          "role": "王平安",
          "text": "您以后有空的话，也可以多来这庙里看看。"
        },
        {
          "role": "王平安",
          "text": "想要敬香的话，直接找我拿香就好了。"
        },
        {
          "role": "王平安",
          "text": "唉，其实我还想把周围也再整修一下…"
        },
        {
          "role": "王平安",
          "text": "路得重新铺一遍，两边要加上围栏，旁边还要再做个花圃…"
        }
      ]
    }
  ]
}