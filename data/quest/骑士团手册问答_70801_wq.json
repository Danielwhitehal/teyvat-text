  "stories": [
    {
      "story_id": 70801,
      "title": "骑士团手册问答",
      "description": "斯万先生万事万物都要遵照骑士团手册来行事，因为旅行者最开始不是西风骑士，所以他不会问旅行者，但是在旅行者获授荣誉骑士之后，斯万就会时不时地拿骑士团手册里的条目来问旅行者。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与斯万对话"
        },
        {
          "type": "subtitle",
          "text": "与斯万对话"
        },
        {
          "role": "旅行者",
          "text": "准备好了。"
        },
        {
          "role": "斯万",
          "text": "好，那我们就开始吧。"
        },
        {
          "role": "旅行者",
          "text": "西风骑士团可真严格…"
        },
        {
          "role": "斯万",
          "text": "全都对了，不愧是荣誉骑士，这么点小问题果然难不住你。"
        },
        {
          "role": "斯万",
          "text": "说实话，这里面的一些问题，就连一些蒙德本地人也答不上来。"
        },
        {
          "role": "斯万",
          "text": "对了，这些礼物请您收下。"
        },
        {
          "role": "旅行者",
          "text": "西风骑士团可真严格…"
        },
        {
          "role": "斯万",
          "text": "唔…很遗憾，您没有全答对。"
        },
        {
          "role": "斯万",
          "text": "但是对于您来说，已经很不错了，这些礼物请您收下。"
        },
        {
          "role": "旅行者",
          "text": "西风骑士团可真严格…"
        },
        {
          "role": "斯万",
          "text": "唔…很遗憾，您没有全答对。"
        },
        {
          "role": "斯万",
          "text": "但是对于您来说，已经很不错了，这些礼物请您收下。"
        },
        {
          "role": "旅行者",
          "text": "我还要再读一读…"
        },
        {
          "role": "斯万",
          "text": "好吧…您就再好好读一读吧。"
        },
        {
          "role": "旅行者",
          "text": "风龙废墟。"
        },
        {
          "role": "旅行者",
          "text": "陌生而可敬的旅行者。"
        },
        {
          "role": "旅行者",
          "text": "代理团长。"
        },
        {
          "role": "斯万",
          "text": "请您听好我的问题。"
        },
        {
          "role": "斯万",
          "text": "位于蒙德西北方的古城遗址。曾经是传说中高塔暴君的都城。但那里被风龙占据，成为其临时避难所。"
        },
        {
          "role": "斯万",
          "text": "我的问题是，西风骑士团对于那片遗址的正式定名…"
        },
        {
          "role": "旅行者",
          "text": "风龙遗迹。"
        },
        {
          "role": "旅行者",
          "text": "风龙遗址。"
        },
        {
          "role": "斯万",
          "text": "答对了，那片遗址的名字确实是「风龙废墟」。"
        },
        {
          "role": "斯万",
          "text": "这个名字是…您为了方便记忆，自己随便取的吗？"
        },
        {
          "role": "斯万",
          "text": "骑士团对于那片遗址的正式命名是「风龙废墟」才对。"
        }
      ]
    }
  ]
}