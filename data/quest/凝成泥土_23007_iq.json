  "stories": [
    {
      "story_id": 23007,
      "title": "凝成泥土",
      "description": "须弥城的阿金，似乎对平时常用的泥土材料产生了一些新的想法…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与阿金对话"
        },
        {
          "role": "阿金",
          "text": "有没有更好用的材料呢…"
        },
        {
          "role": "旅行者",
          "text": "什么材料？"
        },
        {
          "role": "阿金",
          "text": "抱歉，我又在自言自语了。最近天气变化莫测，房屋出问题的情况很多，我有点忙不过来。"
        },
        {
          "role": "旅行者",
          "text": "你不是做陶器的吗？"
        },
        {
          "role": "阿金",
          "text": "是这样没错，但我也是泥瓦匠，都是和泥土打交道的事，也没差啦。"
        },
        {
          "role": "阿金",
          "text": "你听过那句话吗？「做学问就像盖房子，要想起高楼，就要打好地基。」"
        },
        {
          "role": "阿金",
          "text": "「想要扩展学术理论，就要夯实根基，正所谓基础不牢，地动山摇…」"
        },
        {
          "role": "阿金",
          "text": "上面的聪明人总把这话挂在嘴边，虽然我不是很懂，但你看，他们把建房子看得和做学问一样重要。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那只是比喻…",
              "dialogues": []
            },
            {
              "text": "应该不是这么解读的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿金",
          "text": "不管怎么说，提到房屋的基础，就会想到建材。"
        },
        {
          "role": "阿金",
          "text": "泥土作为粘合与支撑材料，如果能强化它的强度与适应性，房子就会更坚固，我也不用这么忙了。"
        },
        {
          "type": "subtitle",
          "text": "前往阿金推荐的地点"
        },
        {
          "role": "阿金",
          "text": "目前我有几个想法，今天的话…我想找一些浸有史莱姆凝液的泥土。"
        },
        {
          "role": "阿金",
          "text": "我找人打听到了一处史莱姆的聚集地，旅行者，你能帮我去取些泥土回来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "阿金",
                  "text": "那就拜托你了，打不打倒那些史莱姆都行，只要取一些它们聚集地附近的泥土回来就好。"
                },
                {
                  "role": "阿金",
                  "text": "我把那片史莱姆聚集地的方位给你标在地图上…"
                }
              ]
            },
            {
              "text": "你自己不去吗？",
              "dialogues": [
                {
                  "role": "阿金",
                  "text": "我也想自己去，但我还要去解决一些坛坛罐罐的问题。"
                },
                {
                  "role": "阿金",
                  "text": "放心吧，我会为你准备好合适的报酬的，这件事就拜托你了。"
                },
                {
                  "role": "阿金",
                  "text": "请你去这里找一找吧，我帮你标在地图上…"
                },
                {
                  "role": "阿金",
                  "text": "那就拜托你了，打不打倒那些史莱姆都行，只要取一些它们聚集地附近的泥土回来就好。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往阿金标记的地点，取得泥土"
        },
        {
          "role": "阿金",
          "text": "目前我有几个想法，今天的话…我想找一些经常与元素生物接触的土壤。"
        },
        {
          "role": "阿金",
          "text": "骗骗花就不错，它们生长的地方，泥土很可能有与众不同的特点。"
        },
        {
          "role": "阿金",
          "text": "但我只是个泥瓦匠，总不可能拿罐子去砸翻那些骗骗花…"
        },
        {
          "role": "阿金",
          "text": "旅行者，能请你帮我这个忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "阿金",
                  "text": "那就拜托你了，请你帮我带回来一份骗骗花根系上的泥土吧。"
                },
                {
                  "role": "阿金",
                  "text": "我告诉你一个地方，那里据说有骗骗花出现…"
                }
              ]
            },
            {
              "text": "你自己不去吗？",
              "dialogues": [
                {
                  "role": "阿金",
                  "text": "我也想自己去，但我还要去解决一些坛坛罐罐的问题。"
                },
                {
                  "role": "阿金",
                  "text": "放心吧，我会为你准备好合适的报酬的，这件事就拜托你了。"
                },
                {
                  "role": "阿金",
                  "text": "请你去这里找一找吧，我帮你标在地图上…"
                },
                {
                  "role": "阿金",
                  "text": "那就拜托你了，请你帮我带回来一份骗骗花根系上的泥土吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往阿金推荐的地点"
        },
        {
          "role": "阿金",
          "text": "目前我有几个想法，今天的话…我想找一些常年阴湿的土壤。"
        },
        {
          "role": "阿金",
          "text": "水分充足，粘合性强，用来解决开裂问题再适合不过了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "阿金",
                  "text": "你愿意帮忙就太好了，请你去这里找一找吧，我帮你标在地图上…"
                },
                {
                  "role": "阿金",
                  "text": "暴露在外面的普通土壤不行，最好能往深处挖一挖。那就交给你了。"
                }
              ]
            },
            {
              "text": "你自己不去吗？",
              "dialogues": [
                {
                  "role": "阿金",
                  "text": "我也想自己去，但我还要去解决一些坛坛罐罐的问题。"
                },
                {
                  "role": "阿金",
                  "text": "放心吧，我会为你准备好合适的报酬的，这件事就拜托你了。"
                },
                {
                  "role": "阿金",
                  "text": "请你去这里找一找吧，我帮你标在地图上…"
                },
                {
                  "role": "阿金",
                  "text": "暴露在外面的普通土壤不行，最好能往深处挖一挖…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往阿金标记的地点，取得泥土"
        },
        {
          "type": "subtitle",
          "text": "前往阿金推荐的地点"
        },
        {
          "type": "subtitle",
          "text": "前往阿金标记的地点，取得泥土"
        },
        {
          "type": "subtitle",
          "text": "将泥土交给阿金"
        },
        {
          "role": "阿金",
          "text": "我需要的泥土已经找到了吗？"
        },
        {
          "type": "subtitle",
          "text": "与阿金对话"
        },
        {
          "role": "阿金",
          "text": "我想要的就是这个，帮大忙了。"
        },
        {
          "role": "阿金",
          "text": "这泥土摸起来就黏黏的，是混合了一些史莱姆凝液吗？不知道能不能和其他泥土凝成一块…"
        },
        {
          "role": "阿金",
          "text": "不过，总之还是非常谢谢你帮忙。这是报酬，还请你收下。"
        },
        {
          "role": "阿金",
          "text": "哎呀，不如就把这些泥土叫做「凝成泥土」好了…"
        },
        {
          "role": "阿金",
          "text": "我想要的就是这个，帮大忙了。我等会就把这些泥土拿回去试验。"
        },
        {
          "role": "阿金",
          "text": "非常谢谢你。这是报酬，还请你收下。"
        },
        {
          "role": "阿金",
          "text": "如果能把许多材质不同的泥土混合在一起的话，做出来的泥土会不会更加耐用呢…"
        },
        {
          "role": "阿金",
          "text": "嗯，我想要的就是这个，帮大忙了。"
        },
        {
          "role": "阿金",
          "text": "不过…比我想象中要更软啊。粘合力没问题，但支撑力可能不太够…"
        },
        {
          "role": "阿金",
          "text": "但没关系，上面的聪明人也经常说，「高楼不是一日建成的。」"
        },
        {
          "role": "阿金",
          "text": "我所想要的这种泥土，想必也不是随随便便就能够做好的吧…"
        },
        {
          "role": "阿金",
          "text": "非常谢谢你帮忙。这里是你的报酬，还请你收下。"
        },
        {
          "role": "阿金",
          "text": "之后，再尝试一些其他的选择吧…"
        }
      ]
    }
  ]
}