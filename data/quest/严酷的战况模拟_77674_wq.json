{
  "quest_id": 77674,
  "chapter_num": null,
  "chapter_title": "严酷的战况模拟",
  "type": "wq",
  "route": "A Grueling Combat Simulation",
  "stories": [
    {
      "story_id": 77674,
      "title": "严酷的战况模拟",
      "description": "在冒险家协会总部旁，专注于研究危险现象的冒险家塔拉利欣正在进行某种模拟训练…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与塔拉利欣对话"
        },
        {
          "role": "塔拉利欣",
          "text": "失败了？"
        },
        {
          "role": "列斯诺娃",
          "text": "又失败了…"
        },
        {
          "role": "列斯诺娃",
          "text": "你的数据绝对设计得有问题，就算把特殊任务营的那群战斗专家找过来，也没人能打通！"
        },
        {
          "role": "塔拉利欣",
          "text": "那就加强练习，仔细反思。模拟训练又不止射击，建造防御工事也很重要。"
        },
        {
          "role": "列斯诺娃",
          "text": "可你自己演示的时候，不也失误一次就全场崩盘了？"
        },
        {
          "role": "塔拉利欣",
          "text": "对啊，这才是「影域」该有的危险程度。"
        },
        {
          "role": "塔拉利欣",
          "text": "只要稍微简单一点，普通射手都会产生幻觉——「我有机会在影域里生存下来」。"
        },
        {
          "role": "塔拉利欣",
          "text": "不用最严苛的标准去训练，怎么能在严酷的环境中做到万无一失呢？"
        },
        {
          "role": "列斯诺娃",
          "text": "行…说得也有道理。"
        },
        {
          "role": "列斯诺娃",
          "text": "我再回去琢磨琢磨，我就不信了，一局都打不过？"
        },
        {
          "role": "派蒙",
          "text": "垂头丧气地走掉了啊…"
        },
        {
          "role": "派蒙",
          "text": "听起来，她好像被你设计的这种桌上游戏打得晕头转向？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难度太夸张确实会让人焦虑。",
              "dialogues": []
            },
            {
              "text": "别要求太极限的手法比较好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔拉利欣",
          "text": "游戏？对你们来说可能确实是轻松愉快的消遣。但「影域战况想定」的主题，就足以让知情人感到紧张了。"
        },
        {
          "role": "塔拉利欣",
          "text": "我制作它的本意，是从思维策略的层面进行模拟训练。"
        },
        {
          "role": "塔拉利欣",
          "text": "对于至冬的冒险家、猎人和战士而言，「影域」始终是隐藏在风雪深处的伤人利剑。"
        },
        {
          "role": "塔拉利欣",
          "text": "谁也不知道里面具体的情况，只能将零零碎碎的情报拼凑起来，去揣测内部有多凶险。"
        },
        {
          "role": "塔拉利欣",
          "text": "然后设想出一个战斗草案，以此磨练自己的本领。万一哪天不走运，真的掉进那种鬼地方了，至少有点存活的希望。"
        },
        {
          "role": "塔拉利欣",
          "text": "只不过，现在就连我都只能勉强在最佳状态下撑过几个回合，更别说他们了…"
        },
        {
          "role": "派蒙",
          "text": "呜…听起来比想象中严肃很多。"
        },
        {
          "role": "派蒙",
          "text": "这方面，旅行者倒是经验丰富，应该能在至冬排得上前列？"
        },
        {
          "role": "塔拉利欣",
          "text": "…确实…但…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "如果报酬还算可观…",
              "dialogues": []
            },
            {
              "text": "我可以帮忙打个样。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔拉利欣",
          "text": "现在的问题是：什么样的价格才配得上旅行者的独家演示？"
        },
        {
          "role": "塔拉利欣",
          "text": "我心里也没底，就先用我的存款垫付三个S级委托的酬劳，然后以事实成果要求协会拨款。"
        },
        {
          "role": "塔拉利欣",
          "text": "如果还不够，就只能去找北国银行贷款了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "倒也不至于借钱。",
              "dialogues": []
            },
            {
              "text": "诚意到位就行。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，如果是让所有人受益的事，我们也不会狮子大开口…"
        },
        {
          "role": "派蒙",
          "text": "应该说，从来没有乱开价！帮到许多人这件事本身，就让我和旅行者心满意足了。"
        },
        {
          "role": "塔拉利欣",
          "text": "那真是感激不尽！"
        },
        {
          "role": "塔拉利欣",
          "text": "我得用冰水洗洗眼睛，做好准备，认真观看旅行者的演示。"
        },
        {
          "role": "塔拉利欣",
          "text": "请听我简单介绍一下模拟的规则…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（塔拉利欣）"
        },
        {
          "role": "塔拉利欣",
          "text": "旅行者的状态似乎很不错，现在就开始影域模拟战斗吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就开始吧。",
              "dialogues": [
                {
                  "role": "塔拉利欣",
                  "text": "嗯，请注意利用各种掩体和机关。找到最节省心力的战斗方式，或许对长时间在「影域」中活动有益…"
                }
              ]
            },
            {
              "text": "聊聊你自己？",
              "dialogues": [
                {
                  "role": "塔拉利欣",
                  "text": "我？我叫塔拉利欣·果戈里，是冒险家协会总部的一名普通文员…"
                },
                {
                  "role": "塔拉利欣",
                  "text": "如果你对不久前的「冒险家发展大会和竞技大赛」还有印象…我有幸在会上帮忙协调部分事务。{{#info:[[「险境征者竞锋大赛」]]}}"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "普通文员要探查影域？",
                      "dialogues": []
                    },
                    {
                      "text": "普通文员写这种推演？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "塔拉利欣",
                  "text": "只是个人兴趣…加上一些不怎么走运的经验，让我对「影域」的了解程度，比普通人深那么一点…"
                },
                {
                  "role": "塔拉利欣",
                  "text": "我也想献出自己的力量，减少冒险家们因为「影域」受到的伤害。"
                },
                {
                  "role": "塔拉利欣",
                  "text": "尽管从协会了解的案例看，从「影域」中生还，并保留基本神智的概率，不足万分之九…"
                },
                {
                  "role": "塔拉利欣",
                  "text": "但我们不能就此认定，落入「影域」就是必死的境地。全力拼搏总比直接放弃要强。"
                },
                {
                  "role": "塔拉利欣",
                  "text": "将枪械和运用工事的能力锻炼至炉火纯青的境界，或许就能争取到一线生机呢？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你的想法倒像个士兵。",
                      "dialogues": []
                    },
                    {
                      "text": "你很相信武器和战术。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "塔拉利欣",
                  "text": "嗯，或许是被叔父和他的挚友们影响了吧。"
                },
                {
                  "role": "塔拉利欣",
                  "text": "我小的时候，就藏不住心里对枪械的那股喜爱劲，总是拿着[[戈尔坚科]]叔父的猎枪，不停把玩。"
                },
                {
                  "role": "塔拉利欣",
                  "text": "叔父就会在[[西多连科]]、[[诺莫科诺夫]]和[[瓦西里]]大伯叫他去打猎时带上我。"
                },
                {
                  "role": "塔拉利欣",
                  "text": "他们教我怎么在三百步的距离上一击放倒最凶暴的野兽，教我怎么在雪地里隐藏自己的踪迹…"
                },
                {
                  "role": "塔拉利欣",
                  "text": "第五次狩猎后，就让我去独自应对一些魔物，考验我「化距离为防护」的思维。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "很不错的经历。",
                      "dialogues": []
                    },
                    {
                      "text": "你童年就成了专家。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "塔拉利欣",
                  "text": "可惜，后来叔父和三位大伯走上了不同的道路，打交道的次数慢慢变少了…"
                },
                {
                  "role": "塔拉利欣",
                  "text": "哪怕西多连科、诺莫科诺夫和瓦西里大伯有一位还在至冬，戈尔坚科叔父也不会轻敌，结果被卷入影域事故…"
                },
                {
                  "role": "塔拉利欣",
                  "text": "啊，抱歉，有点啰嗦了…不能一味沉浸在回忆和假设里，还是让我们看向前方吧。"
                }
              ]
            },
            {
              "text": "还有其他人参加推演吗？",
              "dialogues": [
                {
                  "role": "塔拉利欣",
                  "text": "在刚才那位冒险家之前，还有12人试过，不过成绩都逊色于她，全都没能完成第一个推演。"
                },
                {
                  "role": "塔拉利欣",
                  "text": "她叫列斯诺娃，实力可观，能够相当轻松地独立完成A级委托，进步速度也很快…"
                },
                {
                  "role": "塔拉利欣",
                  "text": "论综合能力，我认为她和[[琪琪科娃]]小妹处于同一水平，达到了[[阿罗夏]]先生的一成…甚至两成，前途无量。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你认识阿罗夏？",
                      "dialogues": []
                    },
                    {
                      "text": "你和阿罗夏合作过？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "塔拉利欣",
                  "text": "我间接受过他的帮助，也出于职业习惯，根据一些零散的情报，简单评估过他的实力，结论相当惊人…"
                },
                {
                  "role": "塔拉利欣",
                  "text": "当然，阿罗夏先生并不认识我，毕竟他直接或间接帮到的人可不少，我只希望有一天也能回报他。"
                },
                {
                  "role": "塔拉利欣",
                  "text": "说回协会这边。列斯诺娃的未婚夫[[拉多米尔]]也回到至冬堡了，这使她精神抖擞。"
                },
                {
                  "role": "塔拉利欣",
                  "text": "不过，列斯诺娃有点不擅长制定计划和分配时间，总是错过集合的节点，好几次让整支队伍缺员行动…"
                },
                {
                  "role": "塔拉利欣",
                  "text": "之前的冒险家大赛中，她先后被[[纳蒂亚]]女士和[[梨香]]轻松超越，完全没机会登上榜单。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "…是个有趣的家伙。",
                      "dialogues": []
                    },
                    {
                      "text": "…是个冒失的家伙。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "塔拉利欣",
                  "text": "要是她之后能稍微改改这个习惯，我想招募她，与其他两位可靠的兄弟一同协助[[岚姐]]…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "岚姐吗？",
                      "dialogues": []
                    },
                    {
                      "text": "她的情况如何？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "塔拉利欣",
                  "text": "她说着「先练练手」和「不用担心」，带着刚组好的枪械，去野外进行「战斗露营」了。"
                },
                {
                  "role": "塔拉利欣",
                  "text": "可能，在迈出关键的那一步前，她想将自己对至冬的适应力提升至最佳区间。"
                },
                {
                  "role": "塔拉利欣",
                  "text": "多做准备总归是好的，如果你对后续事宜感兴趣，请等着我们的好消息。"
                }
              ]
            },
            {
              "text": "待会儿再来。",
              "dialogues": [
                {
                  "role": "塔拉利欣",
                  "text": "明白了，那我继续整理数据。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（列斯诺娃）冒险家协会旁"
        },
        {
          "role": "列斯诺娃",
          "text": "啊，你也被塔拉利欣拉着进行推演了吗？我看你和他聊了很久。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没错，有什么问题吗？",
              "dialogues": [
                {
                  "role": "列斯诺娃",
                  "text": "我不太擅长和他打交道，祝你好运。"
                },
                {
                  "role": "列斯诺娃",
                  "text": "除了这次推演，塔拉利欣总把自己要去收拾的事说得轻描淡写…无论有多棘手。"
                },
                {
                  "role": "列斯诺娃",
                  "text": "派给别人的任务，哪怕只是找一只猫，都要再三叮嘱，让别人千万谨慎行事，生怕别人下错哪一级台阶崴了脚。"
                },
                {
                  "role": "列斯诺娃",
                  "text": "他总让我感觉，我不适合当冒险家，不适合团队合作…"
                }
              ]
            },
            {
              "text": "的确，不过我要先走了。",
              "dialogues": [
                {
                  "role": "列斯诺娃",
                  "text": "那有缘再见。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          33,
          35
        ],
        [
          36,
          38
        ]
      ]
    }
  ]
}