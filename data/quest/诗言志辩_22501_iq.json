{
  "quest_id": 22501,
  "chapter_num": null,
  "chapter_title": "诗言志辩",
  "type": "iq",
  "route": "The Essence of Poetry",
  "stories": [
    {
      "story_id": 22501,
      "title": "诗言志辩",
      "description": "陨石雨纷纷而落，清昼诗兴大发，说什么也要去陨石坠落之处吟诗…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与清昼对话"
        },
        {
          "role": "清昼",
          "text": "嗯…这一句还是不妥，不妥。唉，说不得还是要去看看…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "清昼",
          "text": "您好您好，在下清昼，自诩诗客。"
        },
        {
          "role": "清昼",
          "text": "最近我偶得妙诗一句，却始终不知道如何能续，思索至今，始终不得头绪…"
        },
        {
          "role": "清昼",
          "text": "最近天有异象，众多陨石坠地，此类景观实在人间少有。"
        },
        {
          "role": "清昼",
          "text": "我想，要是能去陨石近前一观，搜得些许灵感，那下一句诗说不定就能水到渠成…"
        },
        {
          "role": "旅行者",
          "text": "不，不太合适…"
        },
        {
          "role": "清昼",
          "text": "不太合适？您这又是从何说起？"
        },
        {
          "type": "subtitle",
          "text": "劝说清昼远离陨石"
        },
        {
          "role": "清昼",
          "text": "您说的「不太合适」，到底是指什么？"
        },
        {
          "role": "旅行者",
          "text": "摸到陨石的话会陷入昏睡…"
        },
        {
          "role": "清昼",
          "text": "唔，这件事我也有所耳闻，但如果只是近观一番，想必也没有什么大碍。"
        },
        {
          "role": "旅行者",
          "text": "你能保证绝不摸陨石吗？"
        },
        {
          "role": "清昼",
          "text": "这个…这个我心中自有分寸。"
        },
        {
          "role": "旅行者",
          "text": "有更好的方法能观察陨石。"
        },
        {
          "role": "清昼",
          "text": "更好的方法…哦，这么一说，我到近前去只见陨石，不见周围事物…确实有些狭隘了…"
        },
        {
          "role": "旅行者",
          "text": "在这也能写诗…"
        },
        {
          "role": "清昼",
          "text": "这可不行，如果只是安居一隅，闭门造车，写的诗也只会是些无病呻吟的白烂话。"
        },
        {
          "role": "旅行者",
          "text": "陨石附近有魔物。"
        },
        {
          "role": "清昼",
          "text": "哈哈，我也曾访遍璃月胜迹，毒虫猛兽也见得多了。如果路上真的艰险…大不了，我雇人陪我同去就是。"
        },
        {
          "role": "旅行者",
          "text": "不必强求惊世骇俗…"
        },
        {
          "role": "清昼",
          "text": "您这句话说得倒对，佳句本天成，妙手偶得之。但是，这句诗困扰我太久，我想快点接下去啊…"
        },
        {
          "role": "旅行者",
          "text": "见了陨石也不一定有灵感…"
        },
        {
          "role": "清昼",
          "text": "哈哈哈，您也是小看了我，如果我亲眼见得陨石，必定能出佳作。"
        },
        {
          "role": "旅行者",
          "text": "万一陷入昏睡…"
        },
        {
          "role": "清昼",
          "text": "这你大可放心，我心中自有分寸。但是，触摸陨石就会陷入昏睡，那昏睡之人，又会梦到什么呢…"
        },
        {
          "role": "清昼",
          "text": "真是让人好奇…咳咳！咳，我只是说说，你放心吧，我绝不会把自己置于险地。"
        },
        {
          "role": "旅行者",
          "text": "你确定能解决所有危险？"
        },
        {
          "role": "清昼",
          "text": "我去的时候，自然会雇人与我同行，以防万一。"
        },
        {
          "role": "旅行者",
          "text": "现在可难得雇到人。"
        },
        {
          "role": "清昼",
          "text": "呃，这个…这个…这个倒真是个问题…"
        },
        {
          "role": "旅行者",
          "text": "有灵感也未必能出佳句。"
        },
        {
          "role": "清昼",
          "text": "哈哈，非是自夸，清昼虽无大才，但坊间亦有不少诗句流传，您不必怀疑我的能力。"
        },
        {
          "role": "旅行者",
          "text": "你原来写的就挺好。"
        },
        {
          "role": "清昼",
          "text": "您谬赞了，但清昼自诩诗客，如果久无新诗，实在有愧于心…"
        },
        {
          "role": "清昼",
          "text": "您苦心劝说的好意，清昼心领。"
        },
        {
          "role": "清昼",
          "text": "至于是否前往陨石坠落之处，容我再思索一番…"
        },
        {
          "role": "清昼",
          "text": "我思来想去，你的担心不无道理，我还是不去陨石旁边自找麻烦了。"
        },
        {
          "role": "旅行者",
          "text": "那就好…"
        },
        {
          "role": "清昼",
          "text": "况且，好诗未必一定以新奇词句见长，于细微处见博大胸怀才更妙。"
        },
        {
          "role": "清昼",
          "text": "以花草等微小之物入诗，或许也能写出妙句，但世间咏花的诗文实在数量众多…"
        },
        {
          "role": "清昼",
          "text": "唔，俗话说「旁观者清」，以你看来，何种花入诗合适？"
        },
        {
          "role": "清昼",
          "text": "唔…我思来想去，陨石是难得一见的异象，还是去看看才好。"
        },
        {
          "role": "旅行者",
          "text": "你…"
        },
        {
          "role": "清昼",
          "text": "但是，如果我直接到陨石前近观，未免被陨石吸引了视线，只见陨石，不见周遭世界。"
        },
        {
          "role": "清昼",
          "text": "「一叶障目」是诗客大敌。如果一开始就一味观察陨石，反而做不出好诗。"
        },
        {
          "role": "清昼",
          "text": "所以，我想要先远观陨石，概览周遭，然后再近前细观…"
        },
        {
          "role": "清昼",
          "text": "然后…这个，呃，路上魔物众多，我又暂时没法雇到人与我同去…"
        },
        {
          "role": "清昼",
          "text": "不知道您愿不愿意帮我个忙，去扫清了堵路的那些魔物？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "清昼",
                  "text": "好！好好好，那就劳烦您了。"
                }
              ]
            },
            {
              "text": "你先答应我不会去摸陨石…",
              "dialogues": [
                {
                  "role": "清昼",
                  "text": "这个…我，我答应你就是。哎呀，既然知道触摸陨石就会昏睡不醒，我又怎么会自涉险地…"
                },
                {
                  "role": "清昼",
                  "text": "不过…不知道那些触摸陨石后昏睡之人，会做什么样的梦…我还真是挺好奇…"
                },
                {
                  "role": "清昼",
                  "text": "咳咳，咳！那个，我开玩笑而已，请您快去扫清魔物吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "清昼",
          "text": "你找到霓裳花了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了。"
        },
        {
          "role": "清昼",
          "text": "那这些花我就收下了。"
        },
        {
          "role": "清昼",
          "text": "唉，佳句难得…佳句难得啊。"
        },
        {
          "role": "旅行者",
          "text": "霓裳花。"
        },
        {
          "role": "清昼",
          "text": "嗯，倒也不错。现在天有异象，霓裳花倒一如往常地盛开。"
        },
        {
          "role": "清昼",
          "text": "两相对比，说不定也会有些趣味…"
        },
        {
          "role": "清昼",
          "text": "能拜托你去采三朵霓裳花回来吗？有了实物，或许我就能有思路了。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "清昼",
          "text": "那就拜托你了。"
        },
        {
          "role": "清昼",
          "text": "你找到冰雾花了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了。"
        },
        {
          "role": "清昼",
          "text": "那这些花我就收下了。"
        },
        {
          "role": "清昼",
          "text": "唉，佳句难得…佳句难得啊。"
        },
        {
          "role": "旅行者",
          "text": "冰雾花。"
        },
        {
          "role": "清昼",
          "text": "冰雾花，嗯…假如能将天降的陨石与冰雾花两相对比，说不定能出一首好诗。"
        },
        {
          "role": "清昼",
          "text": "能拜托你去采三朵冰雾花回来吗？有了实物，或许我就能有思路了。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "清昼",
          "text": "那就拜托你了。"
        },
        {
          "type": "subtitle",
          "text": "采摘3朵霓裳花"
        },
        {
          "type": "subtitle",
          "text": "采摘3朵冰雾花"
        },
        {
          "type": "subtitle",
          "text": "向清昼回报"
        },
        {
          "role": "清昼",
          "text": "触摸陨石的人会长睡不醒…那他们到底做着什么样的梦呢…"
        },
        {
          "type": "subtitle",
          "text": "向清昼回报"
        },
        {
          "role": "清昼",
          "text": "哈哈哈，以陨石和花做诗，古往今来怕是也没几个人了…"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "role": "清昼",
          "text": "哈哈哈，以陨石和花做诗，古往今来怕是也没几个人了…"
        },
        {
          "type": "subtitle",
          "text": "与清昼对话"
        },
        {
          "role": "清昼",
          "text": "这就是陨石吗…怪了，怪了…"
        },
        {
          "role": "旅行者",
          "text": "别去摸陨石。"
        },
        {
          "role": "清昼",
          "text": "啊？是您啊…我知道了，您就放心吧，我心里自然有数。"
        },
        {
          "role": "清昼",
          "text": "辛苦您了，这几份小小礼物，聊表心意，还请收下。"
        },
        {
          "role": "清昼",
          "text": "这陨石还真是奇异…嗯…"
        },
        {
          "role": "派蒙",
          "text": "呜哇…他已经完全进入状态了。"
        },
        {
          "role": "派蒙",
          "text": "不过，他真的把话听进去了吗？真让人担心…"
        },
        {
          "type": "subtitle",
          "text": "向清昼回报"
        },
        {
          "role": "清昼",
          "text": "辛苦您了，小小礼物不成敬意，还请收下。"
        },
        {
          "role": "清昼",
          "text": "花与陨石…哈哈哈，倒也有几分新奇感…"
        },
        {
          "type": "subtitle",
          "text": "向清昼回报"
        },
        {
          "role": "清昼",
          "text": "辛苦您了，小小礼物不成敬意，还请收下。"
        },
        {
          "role": "清昼",
          "text": "花与陨石…哈哈哈，倒也有几分新奇感…"
        }
      ]
    }
  ]
}