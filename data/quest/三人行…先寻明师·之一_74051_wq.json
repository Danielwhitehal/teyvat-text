{
  "quest_id": 74051,
  "chapter_num": null,
  "chapter_title": "三人行…先寻明师·之一",
  "type": "wq",
  "route": "In Expert Company? (I)",
  "stories": [
    {
      "story_id": 74051,
      "title": "三人行…先寻明师·之一",
      "description": "在枫丹廷，你遇见了一群璃月人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "打倒所有魔物，取回映影机"
        },
        {
          "type": "subtitle",
          "text": "与邱老板一行人对话"
        },
        {
          "role": "邱老板",
          "text": "太好了，映影机完好无损，里面的映影也没有被破坏…"
        },
        {
          "role": "邱老板",
          "text": "谢天谢地，我还以为又要从头开拍了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们为什么在这里拍映影？",
              "dialogues": []
            },
            {
              "text": "看起来你们也不是枫丹人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "邱老板",
          "text": "这事情就说来话长了…"
        },
        {
          "role": "邱老板",
          "text": "庄里的人大部分都是做茶叶生意的，但我们…对茶叶生意没什么兴趣…"
        },
        {
          "role": "邱老板",
          "text": "所以就转了行，去帮庄里的茶叶商拍宣传用的记录映影。"
        },
        {
          "role": "弈丰",
          "text": "其实是做茶叶生意的人太多，我们原本的生意比不过他们啦。"
        },
        {
          "role": "兴晔",
          "text": "店里的好手也一个接一个地跑去别家干活，再做茶叶生意，我们就没饭吃了。"
        },
        {
          "role": "邱老板",
          "text": "你们两个…就不能说点好听的吗？！"
        },
        {
          "role": "邱老板",
          "text": "给庄里的茶叶拍宣传映影这件事，赚得也不少了。"
        },
        {
          "role": "弈丰",
          "text": "可是，最近庄里也有其他人开始拍宣传映影了啊。"
        },
        {
          "role": "兴晔",
          "text": "有的映影里还有人唱戏呢，派头可大了。"
        },
        {
          "role": "邱老板",
          "text": "所以我们才来枫丹，寻求映影专家的建议啊！"
        },
        {
          "role": "旅行者",
          "text": "所以，你们是来枫丹学拍摄映影的？"
        },
        {
          "role": "邱老板",
          "text": "没错。我们找到了一个名叫热塞尔的「映影专家」。"
        },
        {
          "role": "邱老板",
          "text": "他很擅长在映影中用光影来…那什么来着？"
        },
        {
          "role": "弈丰",
          "text": "「叙事」。"
        },
        {
          "role": "邱老板",
          "text": "对！用光影来「叙事」。"
        },
        {
          "role": "邱老板",
          "text": "有了热塞尔先生的指导，我们一定能拍出整个翘英庄里最好的映影！"
        },
        {
          "role": "兴晔",
          "text": "老板，你上个月才说要拍出整个璃月里最好的映影。"
        },
        {
          "role": "邱老板",
          "text": "做生意就是要合理地调整自己对未来的预期…你懂什么？"
        },
        {
          "role": "邱老板",
          "text": "总之，感谢您的帮忙，旅行者，这些钱请您收下。"
        },
        {
          "role": "邱老板",
          "text": "兴晔、弈丰，把东西赶紧架起来！今天必须把样片拍完，拿过去给热塞尔先生看。"
        },
        {
          "role": "邱老板",
          "text": "注意打光！镜头要…这么对着光源，打出一个…有高级质感的光线！"
        },
        {
          "role": "邱老板",
          "text": "你们都看过那本书了吧，光影要有质感，质感你们明白吗？"
        },
        {
          "role": "兴晔",
          "text": "老板，虽然热塞尔先生的那本书我们的确都看过了…"
        },
        {
          "role": "弈丰",
          "text": "但就凭这个镜头，就算我们再折腾，拍出来的光线质感也高级不到哪去啊…"
        },
        {
          "role": "邱老板",
          "text": "拜托您了，冒险家，请快点帮我们把映影机拿回来吧。"
        },
        {
          "role": "兴晔",
          "text": "唉，什么时候才能回翘英庄啊…"
        },
        {
          "role": "弈丰",
          "text": "这次的拍摄之行，真是多灾多难…"
        }
      ]
    }
  ]
}