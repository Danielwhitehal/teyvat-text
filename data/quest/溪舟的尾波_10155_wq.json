{
  "quest_id": 10155,
  "chapter_num": "水仙的追迹·第四幕",
  "chapter_title": "溪舟的尾波",
  "type": "wq",
  "route": "Rowboat's Wake",
  "stories": [
    {
      "story_id": 74078,
      "title": "溪舟的尾波",
      "description": "「顺着溪波漂流而下，荡漾在金色的余晖之中…」",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安对话，重新封印胎海入口"
        },
        {
          "role": "安",
          "text": "准备好离开了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "走吧。",
              "dialogues": [
                {
                  "role": "安",
                  "text": "嗯嗯，出发吧。"
                },
                {
                  "type": "subtitle",
                  "text": "使用水仙十字圣剑的力量，重新封住了入口…",
                  "narration": true,
                  "color": "描述"
                },
                {
                  "type": "subtitle",
                  "text": "「原来是这样。」\n差点拯救世界的人说道，「圣剑并不需要是一把剑。甚至可以是个金发的异乡人。」\n「冒险团中从来不出手的妹妹，终于拿起了一次圣剑。」\n话语间，你们回到了水仙十字结社…",
                  "narration": true,
                  "color": "描述"
                }
              ]
            },
            {
              "text": "再等等。",
              "dialogues": [
                {
                  "role": "纳齐森科鲁兹",
                  "text": "这里已经不存一事，只有被压制的磅礴生命之力。"
                },
                {
                  "role": "纳齐森科鲁兹",
                  "text": "不过你感兴趣的话，就再看看吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与大家对话"
        },
        {
          "role": "卡特皮拉",
          "text": "我就知道你们会整整齐齐地回来。"
        },
        {
          "role": "派蒙",
          "text": "我们才是应该高兴，你和西摩尔没事就太好啦！"
        },
        {
          "role": "西摩尔",
          "text": "实际上伴随着水位上升，底层很快就被淹没了。警戒机械也一起泡水报废了。"
        },
        {
          "role": "西摩尔",
          "text": "我是被卡特皮拉先生夹在胳膊底下带上来的。"
        },
        {
          "role": "卡特皮拉",
          "text": "不过我说整整齐齐，确实一个人都没少。但是这里怎么多了一个…"
        },
        {
          "role": "安",
          "text": "我来介绍一下，这个是纳齐森科鲁兹。或者说它残余的一点点自我。"
        },
        {
          "role": "卡特皮拉",
          "text": "…大师。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "有所进步，卡特皮拉。比数百年前更像是人了。"
        },
        {
          "role": "卡特皮拉",
          "text": "我本以为再次见到你我会更加激动。但是如今却异常平静。"
        },
        {
          "role": "卡特皮拉",
          "text": "这几百年我看了很多书，理解了一些你的教导，也理解了其中一些理论的荒谬。"
        },
        {
          "role": "西摩尔",
          "text": "已更新个体「纳齐森科鲁兹」的形象记录。请不要轻举妄动，纳齐森科鲁兹。"
        },
        {
          "role": "安",
          "text": "笨狗，这次不开启广域歼灭模式了吗？"
        },
        {
          "role": "西摩尔",
          "text": "我判断他对各位所能构成的威胁等级低。无论如何，请不要轻举妄动，纳齐森科鲁兹。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "是阿兰·吉约丹的创造物啊。原本我以为它有很好的前景，能够实现古代人的魔像所未能实现的…但一切都无所谓了。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "出于求知的目的，能让我看看内部结构吗？"
        },
        {
          "role": "安",
          "text": "西摩尔可是我们的同伴！"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "行。"
        },
        {
          "role": "卡特皮拉",
          "text": "「拯救世界」通常都是自我精神疾病治疗的诗意修辞。"
        },
        {
          "role": "卡特皮拉",
          "text": "不论是护着蜡烛不熄走完巡礼，还是撰写小说让虚构入侵现实。"
        },
        {
          "role": "卡特皮拉",
          "text": "在最后你的精神病好转了吗？"
        },
        {
          "role": "卡特皮拉",
          "text": "大师，如今你已见识到水仙十字结社的终结了。之后你有什么打算？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "你这句「大师」的称呼多少带着对落魄者的讽刺吧。不过我接受了。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "你应该知道，你的诞生了吧？"
        },
        {
          "role": "卡特皮拉",
          "text": "我已不在意这种事了。只是你玩弄生命，这种漠视我会鄙夷。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我也一样接受了。"
        },
        {
          "role": "派蒙",
          "text": "你这不就是自暴自弃，「随便别人怎么说」的消极态度吗？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "那么回答你的问题吧。我之前对这两位的提议仍然有效，我会为他们展示奥秘，回答疑问。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "既然如此…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请你带着安去寻找她诞生的真相吧。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "和纳齐森科鲁兹讲述了另一个「玛丽安」的事…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "原来院长和玛丽安之后发生了这样的事。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "没问题，我来帮助你们。这也是我应该做的。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "一起去那个镜中的王国吧。"
        },
        {
          "role": "卡特皮拉",
          "text": "那么，关于派蒙之前的愿望，我能做的已经做到了。接下来的事情，我就不掺和了。"
        },
        {
          "role": "派蒙",
          "text": "咦？什么愿望？"
        },
        {
          "role": "卡特皮拉",
          "text": "你的记性还不如我呢。你不是说，要我帮助你们、帮助安和西摩尔吗？"
        },
        {
          "role": "派蒙",
          "text": "啊！对喔！不过，为什么不跟我们一起来呢？"
        },
        {
          "role": "卡特皮拉",
          "text": "接下来的事情。恐怕对安和那位玛丽安，都是很个人的事情。像我这样的角色，没有出场的必要。"
        },
        {
          "role": "卡特皮拉",
          "text": "但你们，旅行者和派蒙不一样。你们是故事中的「勇者」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙勇者！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "派蒙的话，倒应该是…"
        },
        {
          "role": "派蒙",
          "text": "是什么？嗯？卡特皮拉，你是不是要说什么很坏心眼的话！"
        },
        {
          "role": "卡特皮拉",
          "text": "怎么会呢。派蒙当然是勇者身边善良的向导小妖精吧。"
        },
        {
          "role": "派蒙",
          "text": "喔…好、好吧！倒也不是不行啦！"
        },
        {
          "role": "卡特皮拉",
          "text": "等你们那边结束以后，就让我们这些曾经为人的东西，再一块聚聚吧。"
        },
        {
          "role": "西摩尔",
          "text": "那我应该与旅行者先生同行吗？"
        },
        {
          "role": "卡特皮拉",
          "text": "当然还有西摩尔，一直都在寻找任务终点的你，也需要一个交待吧。"
        },
        {
          "role": "西摩尔",
          "text": "很抱歉，我无法理解。"
        },
        {
          "role": "安",
          "text": "西摩尔，你就和卡特皮拉一块等等我们吧。"
        },
        {
          "role": "卡特皮拉",
          "text": "嗯，就是这么回事。等时候差不多了，我就会带着你去找他们。"
        },
        {
          "role": "西摩尔",
          "text": "了解。"
        },
        {
          "role": "安",
          "text": "谢谢你，卡特皮拉。谢谢你，西摩尔。"
        },
        {
          "role": "安",
          "text": "那我们出发吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯！我们去找玛丽安吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（西摩尔）"
        },
        {
          "role": "西摩尔",
          "text": "我无法理解「需要一个交代」是什么意思。"
        },
        {
          "role": "西摩尔",
          "text": "我的运行需要的是能源与指令，而不是「交代」。"
        },
        {
          "role": "西摩尔",
          "text": "但是…维持频繁报错的最高指令系统和逻辑模块也让「西摩尔」接近崩溃了。"
        },
        {
          "role": "西摩尔",
          "text": "或许，我确实也…需要一些帮助。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卡特皮拉）"
        },
        {
          "role": "卡特皮拉",
          "text": "快点去吧，我还得等着你们成功了才能聚首呢。"
        },
        {
          "role": "卡特皮拉",
          "text": "至于我为什么毫不担心这件事是否顺利…"
        },
        {
          "role": "卡特皮拉",
          "text": "纳齐森科鲁兹确实是个很可靠的指导，有他在不会有什么问题的。"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点"
        },
        {
          "type": "subtitle",
          "text": "与安、派蒙和纳齐森科鲁兹对话"
        },
        {
          "role": "派蒙",
          "text": "喂，这比上次还要糟糕啊…现在怎么全部都变回原样了！"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "名字叫安的至纯之水啊，现在开始事无巨细地想象这里所有阻碍都消退的样子。"
        },
        {
          "role": "派蒙",
          "text": "这样做有用吗？"
        },
        {
          "role": "安",
          "text": "上次卡特皮拉说，故事的意义已经消失了。所以想象东西存在也没有用了。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "对于低阶的求道者来说是这样的。但是你也是此地的主人。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "确实有人觉得世界没有意义，只是痛苦的囚笼。但是你既然执掌此地，那就改写空白、赋予它意义。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "狂妄自大地认为自己高于世界才能引发奇迹。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我若不是坚信自己能凌驾于世界末日之上，也无法通达如此位格。"
        },
        {
          "role": "安",
          "text": "所以你也是相信世界有意义的吗？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "不然我做出如此多的计划去拯救世界是为了什么呢？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "不，或许卡特皮拉说的对吧。拯救世界，只是为了证明自己值得被拯救。"
        },
        {
          "role": "派蒙",
          "text": "这句话听不太懂。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "为了给黑暗世界希望，把自己化成光芒的人，在死后才被允许进入永恒的光之王国。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "为了承担世界上所有罪孽而死的人，难道他不值得被拯救吗？"
        },
        {
          "role": "派蒙",
          "text": "似乎懂了似乎又没懂…"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "不重要。我的教导已经不会有人认真听了。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "名叫安的纯水啊，我刚才说的，你能做到吗？"
        },
        {
          "role": "安",
          "text": "让我来试试吧。"
        },
        {
          "type": "subtitle",
          "text": "与安对话"
        },
        {
          "role": "派蒙",
          "text": "哇…"
        },
        {
          "role": "派蒙",
          "text": "安，你好厉害！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "安，你好厉害！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安",
          "text": "……"
        },
        {
          "role": "安",
          "text": "谢谢。但是，为什么我一点也不觉得厉害…"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "因为这对你而言，自是理所应当的事情。你只不过是稍微「想起了」自己的源流。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "继续前进吧。"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "安，你很有天分。要不要继承水仙十字之……"
        },
        {
          "role": "安",
          "text": "不要！"
        },
        {
          "role": "安",
          "text": "让我看看我能做点什么。"
        },
        {
          "role": "「玛丽安」",
          "text": "回去吧。"
        },
        {
          "role": "派蒙",
          "text": "呜啊，在背后！"
        },
        {
          "role": "安",
          "text": "让我来！"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "看来已经对魔法得心应手了。"
        },
        {
          "role": "安",
          "text": "这样上去比较快。"
        },
        {
          "type": "subtitle",
          "text": "躲避炮击，并突破「水泡阵地」"
        },
        {
          "role": "「玛丽安」",
          "text": "为什么要这样逼迫我？"
        },
        {
          "role": "「玛丽安」",
          "text": "…我必须要保护好这里。"
        },
        {
          "role": "派蒙",
          "text": "呜啊，这数量这布置，根本是无盲区轰炸啊！"
        },
        {
          "role": "安",
          "text": "我也一样有需要保护的人们。"
        },
        {
          "role": "安",
          "text": "旅行者骑士！"
        },
        {
          "role": "「玛丽安」",
          "text": "回去吧。"
        },
        {
          "role": "安",
          "text": "旅行者骑士，我相信你！"
        },
        {
          "role": "「玛丽安」",
          "text": "回去吧！"
        },
        {
          "role": "安",
          "text": "纳齐森科鲁兹，你…你要被炸回去了记得快点跟回来。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "毫不掩饰地区别对待啊。"
        },
        {
          "type": "subtitle",
          "text": "与安对话"
        },
        {
          "role": "「玛丽安」",
          "text": "回去吧…"
        },
        {
          "role": "「玛丽安」",
          "text": "这是我的哀求…"
        },
        {
          "role": "派蒙",
          "text": "虽然「玛丽安」的语气确实越来越弱，从命令变成了恳请…"
        },
        {
          "role": "派蒙",
          "text": "但是这个阵势根本不像是求人啊。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "安，你还能继续突破自己吗？"
        },
        {
          "role": "安",
          "text": "嗯，我明白的。都走到这一步了，就已经没有回去的道理了。"
        },
        {
          "role": "安",
          "text": "「玛丽安」，对不起。但是我们一定要通过此处。"
        },
        {
          "role": "派蒙",
          "text": "全部，被安弄没了？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "抗拒真相是没有意义的。安只是否定了徒劳的抵抗而已。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我们继续前进吧。"
        },
        {
          "role": "派蒙",
          "text": "这里的门关上了！那我们要怎么进去…"
        },
        {
          "role": "派蒙",
          "text": "呃，不进去的话就不能到那个晕乎乎的走廊和房间，就不能跳下去到打那个纳西索斯的地方…"
        },
        {
          "role": "安",
          "text": "没关系。我来给我们这次拜访一个意义。"
        },
        {
          "role": "安",
          "text": "利迪尔也只是「红女皇」的梦中人。但这一次，梦该醒了。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "没错。就是这样。"
        },
        {
          "type": "subtitle",
          "text": "进入「高塔」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "进入",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前进"
        },
        {
          "role": "「玛丽安」",
          "text": "为什么…为什么，你们就不愿意让我们静静地待在这里呢？"
        },
        {
          "role": "派蒙",
          "text": "玛丽安！"
        },
        {
          "role": "派蒙",
          "text": "我们…这次我们应该有办法帮上你的忙！让我们进来吧！"
        },
        {
          "role": "「玛丽安」",
          "text": "不需要！我不需要！请回去吧！求求你们…"
        },
        {
          "role": "安",
          "text": "「莉利丝公主」。在故事的结尾，你应该过上幸福快乐的生活。我不会放弃的。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "这面屏障是由极其坚硬的抗拒意志构成的。但是圣剑已经在你的手上，旅行者。"
        },
        {
          "role": "派蒙",
          "text": "啊，我记得圣剑可以割舍一切从水中来的意志…"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "没错。你很聪明。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白了。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抱歉。稍微忍耐一会，玛丽安。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「玛丽安」",
          "text": "……"
        },
        {
          "role": "「玛丽安」",
          "text": "不要再过来了。这里很温暖，这样就很好。"
        },
        {
          "role": "「玛丽安」",
          "text": "不要带着期待靠近我，不要带着这种坚决的表情走过来。"
        },
        {
          "role": "「玛丽安」",
          "text": "让我一个人在这里待着吧。直到约束形体的意识消散…"
        },
        {
          "type": "subtitle",
          "text": "击碎「抗拒的意志」"
        },
        {
          "role": "「玛丽安」",
          "text": "没有人需要拯救，这样就很好。"
        },
        {
          "role": "「玛丽安」",
          "text": "让我一个人在这里腐败吧。直到所有的一切崩溃为一滩污水…"
        },
        {
          "role": "「玛丽安」",
          "text": "求求你们住手，不要再过来了，这里就是我们的安眠处。"
        },
        {
          "role": "「玛丽安」",
          "text": "为什么要这样，真相就那么重要吗？"
        },
        {
          "role": "「玛丽安」",
          "text": "永远沉湎于过去的梦难道不行吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许真相确实不重要。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但是未来很重要。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "没错。就算你们都视我为大罪之人，我也没有片刻放弃过未来。"
        },
        {
          "role": "「玛丽安」",
          "text": "你是？！"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "没错，是我纳齐森科…"
        },
        {
          "role": "「玛丽安」",
          "text": "雷内！"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "…是的，我是雷内。变成了这样的姿态。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "见到「你们」和这位，安，我很高兴。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "现在你们的状态可以说是超越了人类与纯水精灵，乃是超越者的形态。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "一如人之于猿猴，超人之于人。你们现在就是整个枫丹的意义。"
        },
        {
          "role": "派蒙",
          "text": "…但是，现在是说这种话的时候吗？"
        },
        {
          "role": "派蒙",
          "text": "纳齐森科鲁兹，一点也不考虑别人的心情！"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "抱歉。是我制造的局势间接害你们变成了这样。"
        },
        {
          "role": "安",
          "text": "没关系。「玛丽安」，我已经原谅了他。"
        },
        {
          "role": "安",
          "text": "请看一下这个。"
        },
        {
          "role": "「玛丽安」",
          "text": "这个是！"
        },
        {
          "role": "[[file",
          "text": "开启的「宝物」内容.png|center|500px]]"
        },
        {
          "role": "「玛丽安」",
          "text": "这正是，我一直想要保护的永恒啊。"
        },
        {
          "role": "「玛丽安」",
          "text": "雷内。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "嗯。"
        },
        {
          "role": "「玛丽安」",
          "text": "我还是无法原谅纳齐森科鲁兹。但是，雷内是另一码事。"
        },
        {
          "role": "「玛丽安」",
          "text": "……"
        },
        {
          "role": "「玛丽安」",
          "text": "水仙十字院本来是我们的家，为什么最后变成了这样呢？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "大概从阿兰这家伙每次都要和我出演水仙勇者和邪龙的那一刻起就注定了吧。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我也一样怀念着一切。但是救世的妄想中诞生了纳齐森科鲁兹，那可真是一段漫长的梦啊。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "不过我从梦中被拽出来了，现在该你了。"
        },
        {
          "role": "安",
          "text": "接受自己的过往和接下来怎么活并不矛盾。卡特皮拉是这么和我说的。"
        },
        {
          "role": "安",
          "text": "现在世界末日也被制止了。未来有很多很多的可能。"
        },
        {
          "role": "安",
          "text": "我向你保证，未来不只有痛苦。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "如果你接受不了自己，其实可以让安与你融合。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "然后再用水仙十字圣剑将莉利丝与小玛丽安的人格分开来。"
        },
        {
          "role": "「玛丽安」",
          "text": "不必了，我愿意接受这个过去。小小勇者安的冒险是属于她自己的。"
        },
        {
          "role": "「玛丽安」",
          "text": "我会作为自己活下去的。我会去看看，雷内你押上一切想拯救的世界，是什么样的。"
        },
        {
          "role": "派蒙",
          "text": "欸？水仙十字圣剑…"
        },
        {
          "type": "subtitle",
          "text": "圣剑上的光芒消失了…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "原来如此啊。玛丽安，你的意志已经传达到了。圣剑的使命已经完成，它在故事中的意义已经消弭了。"
        },
        {
          "role": "派蒙",
          "text": "唔，虽然不是很懂，但意思就是说，以后旅行者用不了之前那招很厉害的「开辟十字斩」了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那样也不错。",
              "dialogues": []
            },
            {
              "text": "真遗憾。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "话说回来吧，你说要看看外面。但现在外面是吉约丹的世界，应该不怎么样吧。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "不过，如果你能喜欢，那就比什么都好。"
        },
        {
          "role": "「玛丽安」",
          "text": "安、雷内，我们一起去旅行，好吗？"
        },
        {
          "role": "安",
          "text": "嗯！当然！"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我的话…虽然很遗憾，不过请允许我拒绝。我还有需要做的事情。"
        },
        {
          "role": "「玛丽安」",
          "text": "好吧…没办法，那记得给我留个地址，我要写信给你，跟你讲我和安在旅途中见到的东西。"
        },
        {
          "role": "「玛丽安」",
          "text": "就像以前，你和雅各布跟我讲在须弥看到的东西那样。"
        },
        {
          "role": "安",
          "text": "不过，旅程恐怕还得请先等等。卡特皮拉确实说过要聚聚什么的…"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "是的。他应该就要到了。请各位稍微等等吧。"
        },
        {
          "role": "派蒙",
          "text": "真拿你们没办法，那我们先跟玛丽安聊聊吧，旅行者！"
        },
        {
          "type": "subtitle",
          "text": "与大家对话"
        },
        {
          "role": "卡特皮拉",
          "text": "或许我本该祝酒，说「敬，曾为人类的我们。」"
        },
        {
          "role": "卡特皮拉",
          "text": "但是我们三个人这模样，似乎没办法喝酒啊。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "有什么事情刚才出发前不能说的吗？"
        },
        {
          "role": "卡特皮拉",
          "text": "我只是在给你机会。你有些事情，刚才不方便说吧。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "被你看出来了吗？唉，没办法。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我的力量已经消耗过多，现在无法维持了。"
        },
        {
          "role": "安",
          "text": "但是…怎么会这样？"
        },
        {
          "role": "安",
          "text": "好不容易才…"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "…趁着我还没有消失，和我说说你们这几百年的感悟吧。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我想知道，你们做了什么样的梦。"
        },
        {
          "role": "安",
          "text": "……"
        },
        {
          "role": "安",
          "text": "直到遇到旅行者骑士…旅行者和派蒙之前，我一直在追寻莉利丝公主。"
        },
        {
          "role": "安",
          "text": "就算后来知道了真相，我只是谁人的梦。我也没有难过。"
        },
        {
          "role": "安",
          "text": "因为我已经完成最好最大的冒险。可能换取的奖励，就是让我由梦成真吧。"
        },
        {
          "role": "卡特皮拉",
          "text": "我只是在监狱、书海中来回，偶尔会梦到自己的前世碎片。"
        },
        {
          "role": "卡特皮拉",
          "text": "以前也曾怀疑过，究竟是蝴蝶变成了我，还是我成为了蝴蝶。"
        },
        {
          "role": "卡特皮拉",
          "text": "但是清醒了才发现，自己只是毛毛虫。蝴蝶当然也是我，只不过未来还是过去就难说了。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "梦啊，魔法啊，回忆啊，神秘哲学啊。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我曾经奉为珍宝的东西，在这一刻的我看来却仿佛敝屣。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "在第一个十年中，我用尽所有的力量避免我的意志消散。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "在接下来的年岁中，我用强烈的意志构造着体内的宇宙，以此抵抗袭来的命运。如此坚持了下来。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "对你们来说也一样吧。在已经化成废墟的，我们曾经的家，构建起这么美丽的梦。这是很了不起的事情。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "「玛丽安」说得没错，这里很温暖。"
        },
        {
          "role": "安",
          "text": "嗯。我知道。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "现在我累了。安，请让我留在这里吧。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "再见了。"
        },
        {
          "type": "subtitle",
          "text": "他一次也没有把名字变回「雷内」。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "「人生，如果只是一个梦呢？」…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "…喔！所以，之前我们和安经历的冒险故事，是这么来的呀。"
        },
        {
          "role": "派蒙",
          "text": "难怪从中间开始就乱七八糟的，因为根本没写完嘛！"
        },
        {
          "role": "玛丽安",
          "text": "嗯，一直没想好结局。"
        },
        {
          "role": "玛丽安",
          "text": "那时候，一切已经四分五裂了。但越是这样，我们就越想要一个简单的、快乐的结局…"
        },
        {
          "role": "派蒙",
          "text": "这么说来，你一会儿说「我」，一会儿说「我们」…你究竟是玛丽安还是他们老是提到的纯水精灵莉利丝呢？"
        },
        {
          "role": "玛丽安",
          "text": "不知道。不过，已经无所谓了。"
        },
        {
          "role": "派蒙",
          "text": "安！卡特皮拉！你们回来啦！"
        },
        {
          "role": "玛丽安",
          "text": "雷内呢？"
        },
        {
          "role": "安",
          "text": "他…"
        },
        {
          "role": "卡特皮拉",
          "text": "…他有些疲劳，所以就去休息了。"
        },
        {
          "role": "派蒙",
          "text": "哼！希望他以后好好改过自新，不要再做坏事了！"
        },
        {
          "role": "卡特皮拉",
          "text": "西摩尔，你可以过来了。"
        },
        {
          "role": "西摩尔",
          "text": "了解。"
        },
        {
          "role": "西摩尔",
          "text": "……"
        },
        {
          "role": "西摩尔",
          "text": "玛丽安小姐！玛丽安小姐…"
        },
        {
          "role": "玛丽安",
          "text": "……"
        },
        {
          "role": "西摩尔",
          "text": "…您的新发色与瞳色真是光彩照人。"
        },
        {
          "role": "玛丽安",
          "text": "真是的，笨狗。你就只会说这些吗？"
        },
        {
          "role": "西摩尔",
          "text": "我的语言中枢无法表达现在正在处理的逻辑与信息。"
        },
        {
          "role": "玛丽安",
          "text": "我知道。你还是和以前一样…"
        },
        {
          "role": "玛丽安",
          "text": "…对不起。我很想你…"
        },
        {
          "role": "玛丽安",
          "text": "…是喔，原来还发生了这样的事情呀。还有雅各布…"
        },
        {
          "role": "西摩尔",
          "text": "旅行者先生与派蒙小姐的陈述大致上与事实没有出入，仅有一点需要补充。"
        },
        {
          "role": "西摩尔",
          "text": "战斗中我的机体出力水平远低于预期，这是因为有超过百分之三十的部件因为过去在厄里那斯的那次战斗损毁与缺乏护养导致的。"
        },
        {
          "role": "西摩尔",
          "text": "希望您正确评估我的性能，不要因此将我废弃。"
        },
        {
          "role": "玛丽安",
          "text": "当然不会！"
        },
        {
          "role": "安",
          "text": "你一直很坚强、很勇敢。你比「我们」要强韧多了，西摩尔。"
        },
        {
          "role": "西摩尔",
          "text": "肯定。我的设计者阿兰·吉约丹是枫丹最优秀的工程师，构成我的零件在当时也代表着枫丹的材料学与工艺精度的最高水平。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "倒不是这个意思就是了…",
              "dialogues": []
            },
            {
              "text": "西摩尔，你好强大！",
              "dialogues": [
                {
                  "role": "西摩尔",
                  "text": "谢谢您的正确评估。"
                },
                {
                  "role": "派蒙",
                  "text": "虽然安想表达的不是这个就是了…"
                }
              ]
            }
          ]
        },
        {
          "role": "西摩尔",
          "text": "接下来的指令是什么，玛丽安小姐？"
        },
        {
          "role": "玛丽安&安",
          "text": "……"
        },
        {
          "role": "安",
          "text": "就由你来说吧，玛丽安。因为，对西摩尔而言，我只是安而已。"
        },
        {
          "role": "玛丽安",
          "text": "西摩尔，你想做什么？"
        },
        {
          "role": "西摩尔",
          "text": "我的首要指令是代替阿兰·吉约丹陪伴在小姐身边，保护小姐。"
        },
        {
          "role": "玛丽安",
          "text": "笨蛋，这是老哥…是阿兰的指令。我想问的是，你「想」做什么？"
        },
        {
          "role": "西摩尔",
          "text": "…我曾经答应玛梅赫小姐，在找到主人以后，我会返回她之前的空间坐标，向她表达谢意。"
        },
        {
          "role": "玛丽安",
          "text": "你做得很对，乖狗狗。"
        },
        {
          "role": "西摩尔",
          "text": "？"
        },
        {
          "role": "安",
          "text": "玛丽安，你曾经送给我这么一句话，你还记得吗？"
        },
        {
          "role": "玛丽安",
          "text": "嗯。西摩尔，我希望你「成为自己命运的主人」。在你未来的时光里，去做你「想」做的事情、你认为正确的事情。"
        },
        {
          "role": "西摩尔",
          "text": "玛丽安小姐…"
        },
        {
          "role": "西摩尔",
          "text": "我是否应该如此理解：我过去的接受的指令，如今已经全部解除？"
        },
        {
          "role": "玛丽安",
          "text": "是的。现在，请你再回答我一次。西摩尔，你想做什么？"
        },
        {
          "role": "西摩尔",
          "text": "我想继续陪伴在您身边，玛丽安小姐，但我也想陪伴玛梅赫小姐。我判断这两者在现实物理的时空关系下是难以兼容的。"
        },
        {
          "role": "玛丽安",
          "text": "这也未必。接下来，我们会踏上旅程，去看看这个世界。而玛梅赫小姐是个画家对吧？"
        },
        {
          "role": "玛丽安",
          "text": "就让我们的旅程彼此交会吧。让我们在沙漠、在森林、在雪原，在失落的夷斯古城、阿卡狄亚、黄金的亥珀波瑞亚留下足迹。"
        },
        {
          "role": "玛丽安",
          "text": "我们将一起分享旅途中的风景和故事，你觉得如何，西摩尔？"
        },
        {
          "role": "西摩尔",
          "text": "我认为您的提议十分合理，玛丽安小姐。但我需要先征求玛梅赫小姐的同意。"
        },
        {
          "role": "玛丽安",
          "text": "嗯，那当然。就约在这个地方见面吧…"
        },
        {
          "role": "玛丽安",
          "text": "我也很想见见那位一直陪着你的小画家呢。"
        },
        {
          "role": "西摩尔",
          "text": "已录入坐标。"
        },
        {
          "role": "玛丽安",
          "text": "那么，接下来…"
        },
        {
          "role": "安",
          "text": "旅行者、派蒙、还要卡特皮拉…你们都是最勇敢、最厉害的。谢谢你们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不叫我骑士了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安",
          "text": "那个故事已经结束了。对我、对「我们」而言，现在的你是最为真实，又最为重要的人。"
        },
        {
          "role": "玛丽安",
          "text": "而不仅仅是故事中，饰演骑士的角色呢。"
        },
        {
          "role": "安",
          "text": "正如故事中的圣剑已经完成了它的使命，重新成为了一把剑。故事中的骑士也重新回归为人。"
        },
        {
          "role": "派蒙",
          "text": "唔，怎么感觉听不懂你们是在夸旅行者还是批评旅行者…"
        },
        {
          "role": "安",
          "text": "当然是夸赞旅行者呀。"
        },
        {
          "role": "玛丽安",
          "text": "你们为无法结束的故事带来了完结，又带来了新的故事。"
        },
        {
          "role": "安",
          "text": "我们永远不会忘记。"
        },
        {
          "role": "派蒙",
          "text": "真是的，不用这么客气啦！"
        },
        {
          "role": "卡特皮拉",
          "text": "能够参与这样的故事，对我而言也颇有收获。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "希望你们有美好的旅程。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛丽安",
          "text": "嗯！我相信，我们将来一定还会再相遇的！"
        },
        {
          "role": "西摩尔",
          "text": "那么，我也应该前往玛梅赫小姐所在的地方了。"
        },
        {
          "role": "派蒙",
          "text": "我们也一起去吧！卡特皮拉，跟我们一起来吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "走吧，西摩尔。",
              "dialogues": []
            },
            {
              "text": "卡特皮拉，一起见证到最后吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "行，我也送你们一程吧。"
        },
        {
          "type": "subtitle",
          "text": "获得武器{{图标|水仙十字之剑}}",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "额外对话（玛丽安&安）"
        },
        {
          "role": "安",
          "text": "玛丽安，现在对你而言，你最想去的地方是哪里呢？"
        },
        {
          "role": "玛丽安",
          "text": "我想想…「玛丽安」在过去的回忆，在想象的世界里待得太久了。"
        },
        {
          "role": "玛丽安",
          "text": "现在的世界，应该跟几百年前有了很大的变化吧。"
        },
        {
          "role": "玛丽安",
          "text": "我想亲眼看看，玻璃幕墙外的世界。我想看到新的故事。"
        },
        {
          "role": "安",
          "text": "你会害怕吗，玛丽安？"
        },
        {
          "role": "安",
          "text": "虽然知道故事一定会有结局，但是很难想象一切就这样结束了。从我诞生的时刻开始，水仙十字王国就是我的全部…"
        },
        {
          "role": "玛丽安",
          "text": "我明白，你比我更加不安。你是为了这个故事才诞生的。可是从今往后，你要去开启真正属于「安」的故事了。"
        },
        {
          "role": "玛丽安",
          "text": "而我，也要从过去的巨大影子里逐渐迈出脚步。无论是莉利丝的回忆，还是玛丽安·吉约丹的回忆，都不能代表现在的我。"
        },
        {
          "role": "玛丽安",
          "text": "我们都有好长的路呢，安。"
        },
        {
          "role": "玛丽安",
          "text": "但我相信，你一定没问题的。"
        },
        {
          "role": "玛丽安",
          "text": "如果害怕了，我们就回到这里。"
        },
        {
          "role": "玛丽安",
          "text": "即便已成废墟，只要有种子飘到这里，就会开出新的花朵。只要我们还存在于此，就能建起新的家园。"
        },
        {
          "type": "subtitle",
          "text": "前往海沫村"
        },
        {
          "role": "玛梅赫",
          "text": "旅行者和派蒙，还有——"
        },
        {
          "role": "玛梅赫",
          "text": "西摩尔！"
        },
        {
          "role": "玛梅赫",
          "text": "你知道回来啊？！"
        },
        {
          "role": "派蒙",
          "text": "玛梅赫听起来像是有点生气…"
        },
        {
          "role": "西摩尔",
          "text": "是的。就算没有旅行者和派蒙，我的空间定位与导航模块也能让我回到这里。"
        },
        {
          "role": "玛梅赫",
          "text": "好厉害！"
        },
        {
          "role": "派蒙",
          "text": "原来玛梅赫没有生气，只是惊讶吗？"
        },
        {
          "role": "玛梅赫",
          "text": "我就知道你不会带着象征我的生命、我的诞生的「信物」消失不见，我也知道旅行者、派蒙，一定会带着西摩尔回来。"
        },
        {
          "role": "西摩尔",
          "text": "回到您的身边，是我「想」做的事情。虽然这个概念我并未完全理解，但我的逻辑驱使我这么做。我认为这是正确的事情。"
        },
        {
          "role": "玛梅赫",
          "text": "好复杂，听不懂，不过没所谓！只要你回来了就好。"
        },
        {
          "role": "玛梅赫",
          "text": "唔，还有这位是…"
        },
        {
          "role": "卡特皮拉",
          "text": "你好。不必太在意我，我只是随行的伙伴。"
        },
        {
          "role": "玛梅赫",
          "text": "是喔？不过，你的颜色很有趣。但不管怎么说，看到西摩尔，我真的好开心。"
        },
        {
          "role": "玛梅赫",
          "text": "「父亲大人」通过旅行者留下那些话以后，就陷入沉默了。然后西摩尔也走了。那段时间，我一直好难过。"
        },
        {
          "role": "派蒙",
          "text": "（唔，看来你发呆的时候发生的事情，玛梅赫都不知道…）"
        },
        {
          "role": "玛梅赫",
          "text": "海沫村的大家在这段时间里，一直在帮助我。所以，「父亲大人」说的话，我才真的明白过来…"
        },
        {
          "role": "玛梅赫",
          "text": "喔，对了！和她们在一起的时候，我一直在学新的画风！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "比原来的还要新奇吗？",
              "dialogues": []
            },
            {
              "text": "比原来的…还要新奇吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛梅赫",
          "text": "应该是更容易让大家理解的风格吧！现在就连海沫村的美露莘们，也能看明白我画的东西，而不只是说「哦哦真好看」了！"
        },
        {
          "role": "派蒙",
          "text": "哇！好期待！无价之宝级别的名作！"
        },
        {
          "role": "玛梅赫",
          "text": "嘿嘿。"
        },
        {
          "role": "派蒙",
          "text": "对了，说到画画，之前玛丽安好像提过…"
        },
        {
          "type": "subtitle",
          "text": "西摩尔传达了一同旅行的提案。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "玛梅赫",
          "text": "嗯？还有这么好的事情！"
        },
        {
          "role": "玛梅赫",
          "text": "我们立刻开始吧。环绕大陆的艺术创作之旅！"
        },
        {
          "role": "玛梅赫",
          "text": "现在立刻马上！我要收拾画具和行李，你在这里坐着等我！"
        },
        {
          "role": "西摩尔",
          "text": "好的，玛梅赫小姐。"
        },
        {
          "role": "派蒙",
          "text": "喂！立刻就付诸行动了，好厉害。"
        },
        {
          "role": "屋里的玛梅赫",
          "text": "那当然啦，如果不付诸行动，梦想就永远只是个梦想不是吗？"
        },
        {
          "role": "屋里的玛梅赫",
          "text": "颜料、颜料…"
        },
        {
          "role": "西摩尔",
          "text": "请允许我在等待的期间向你们表达谢意，旅行者先生、派蒙小姐，还有卡特皮拉先生。"
        },
        {
          "role": "西摩尔",
          "text": "这是基于我自己的判断，如玛丽安小姐所说的，我「想」表达的谢意。在你们的帮助下，我终于完成了我应当完成的任务。"
        },
        {
          "role": "西摩尔",
          "text": "只不过我尚且无法理解「我希望你成为自己命运的主人」的意思。因为命运是人类试图对事件进行理解时创造的概念，而非实在。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，被西摩尔说得我也不知道怎么解释好了…"
        },
        {
          "role": "卡特皮拉",
          "text": "她们不是说过了吗？你做你想做的事情就好。"
        },
        {
          "role": "卡特皮拉",
          "text": "只要你一直做你想做的事情，你就是自己命运的主人。"
        },
        {
          "role": "西摩尔",
          "text": "原来如此。那么，此刻我想做的就是坐在这里，等待玛梅赫小姐。"
        },
        {
          "role": "派蒙",
          "text": "好喔，希望你们一路顺风！"
        },
        {
          "role": "屋里的玛梅赫",
          "text": "谢谢派蒙！"
        },
        {
          "role": "屋里的玛梅赫",
          "text": "送给他们的画、送给他们的画…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "乖狗狗，要保护好玛梅赫。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "西摩尔",
          "text": "肯定。这也是我想做的事。"
        },
        {
          "type": "subtitle",
          "text": "和卡特皮拉一起来到了海沫村外…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "卡特皮拉",
          "text": "…那么，水仙十字的故事就这样结束了。我也该走上我自己的路了。"
        },
        {
          "role": "派蒙",
          "text": "卡特皮拉，你要到哪里去？"
        },
        {
          "role": "卡特皮拉",
          "text": "派蒙，这是个好问题。自古以来只有意志最坚定、最强韧的人找到了它的答案。"
        },
        {
          "role": "派蒙",
          "text": "喂！"
        },
        {
          "role": "卡特皮拉",
          "text": "开玩笑的。就现在而言，唯一能确定的就是，我还欠莉诺尔半个故事，但我还没有想好故事的结尾，我需要…"
        },
        {
          "role": "卡特皮拉",
          "text": "有很多事情需要思考。目的地没有决定，但我有些需要追寻的事物。"
        },
        {
          "role": "派蒙",
          "text": "是喔…"
        },
        {
          "role": "卡特皮拉",
          "text": "那么再见喽，旅行者、派蒙。认识你们或许是在我的这个「人生」中，最幸运的事情之一。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "再见，卡特皮拉。",
              "dialogues": []
            },
            {
              "text": "彼此，卡特皮拉。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！保重喔，卡特皮拉！真实身份别被人发现啦！会很麻烦的喔！"
        },
        {
          "type": "subtitle",
          "text": "这位丘丘人笑了笑，转身走了。",
          "narration": true,
          "color": "描述"
        }
      ],
