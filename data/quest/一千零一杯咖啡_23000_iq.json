{
  "quest_id": 23000,
  "chapter_num": null,
  "chapter_title": "一千零一杯咖啡",
  "type": "iq",
  "route": "1,001 Cups of Coffee",
  "stories": [
    {
      "story_id": 23000,
      "title": "一千零一杯咖啡",
      "description": "普斯帕咖啡馆内的玛达赫，正苦恼于没有新的故事可讲…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与玛达赫对话"
        },
        {
          "role": "旅行者",
          "text": "以前在蒙德…"
        },
        {
          "role": "玛达赫",
          "text": "嗯？风神眷顾的蒙德吗…我听商队的人说，那里出现了一头掀起狂风的巨龙，应该会是个不错的题材。"
        },
        {
          "role": "玛达赫",
          "text": "但从商队那边能打听到的，也只是一些断断续续，听起来还不太靠谱的传言。"
        },
        {
          "role": "玛达赫",
          "text": "比如说…「一名背生双翼的旅行者破空而来，在万米高空之上与巨龙展开追逐！」什么的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实是在空中追击过…",
              "dialogues": []
            },
            {
              "text": "其实是靠风之翼啦…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛达赫",
          "text": "唔，再比如说…「他只身潜入教会，盗取了寄宿着风神伟力的强大武器！」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实是潜入过教会…",
              "dialogues": []
            },
            {
              "text": "「天空之琴」不是什么武器。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛达赫",
          "text": "欸！那这条呢？「最后他看破巨龙弱点，击碎旧日创口。沐浴着龙血成为不死之身！」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实是要瞄准某处…",
              "dialogues": []
            },
            {
              "text": "只是在净化影响心智的毒血。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "以前在璃月…"
        },
        {
          "role": "玛达赫",
          "text": "嗯？璃月吗…我听商队的人说，那里的诸方势力在神明陨落之际明争暗斗，应该会是个不错的题材。"
        },
        {
          "role": "玛达赫",
          "text": "但从商队那边能打听到的，也只是一些断断续续，听起来还不太靠谱的传言。"
        },
        {
          "role": "玛达赫",
          "text": "比如说…「一名旅行者着手操办了送仙典仪，成为各方势力争相拉拢的对象」什么的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实是参与了送仙典仪…",
              "dialogues": []
            },
            {
              "text": "其实都是在和某人跑腿…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛达赫",
          "text": "唔，再比如说…「他与漩涡之魔神在海上鏖战，就连那座群玉阁都被凌厉的剑气波及，生生坠入海中！」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实是跟魔神对峙过…",
              "dialogues": []
            },
            {
              "text": "击退魔神的关键是群玉阁。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛达赫",
          "text": "欸！那这条呢？「最后他凭一己之力调停了仙凡间的矛盾，璃月港就此迎来了新的时代。」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实是平息了矛盾…",
              "dialogues": []
            },
            {
              "text": "是靠璃月人的共同努力。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "以前在稻妻…"
        },
        {
          "role": "玛达赫",
          "text": "嗯？雷神庇佑的稻妻吗…我听商队的人说，那里有人忤逆了神明颁布的「眼狩令」，应该会是个不错的题材。"
        },
        {
          "role": "玛达赫",
          "text": "但从商队那边能打听到的，都是一些断断续续，听起来还不太靠谱的传言…"
        },
        {
          "role": "玛达赫",
          "text": "比如说，「一位异乡人向愚人众执行官发起决斗，一刀就将对手化为灰烬！」什么的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实是赢下了决斗…",
              "dialogues": []
            },
            {
              "text": "降下制裁的是将军啦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛达赫",
          "text": "唔，再比如说，「他直面将军的威压，毫发无伤地从『无想的一刀』下逃出生天！」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实是从刀下逃生了…",
              "dialogues": []
            },
            {
              "text": "挡下那一刀的是别人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛达赫",
          "text": "欸！那这条呢？「最后他从千手百眼神像中汲取力量，扭转了神明的意志…」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实改变了将军的心意…",
              "dialogues": []
            },
            {
              "text": "制胜关键是大家的「愿望」。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "等候至次日晚间（19-21点）"
        },
        {
          "type": "subtitle",
          "text": "前往咖啡馆与玛达赫对话"
        },
        {
          "role": "玛达赫",
          "text": "欸，这故事都还没开始说，客人怎么就全走光了…"
        },
        {
          "role": "玛达赫",
          "text": "完了，这回是真的连咖啡也要喝不起了…"
        },
        {
          "role": "旅行者",
          "text": "你遇到什么麻烦了吗？"
        },
        {
          "role": "玛达赫",
          "text": "呃，您是…旅行者？唉…就跟您见着的一样，我平时会在这咖啡馆里讲讲故事，换点咖啡钱。"
        },
        {
          "role": "玛达赫",
          "text": "不过最近愿意捧场的听众越来越少，再这么下去，我怕是连咖啡沫都喝不起了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "像是蒙德的吟游诗人吗…",
              "dialogues": []
            },
            {
              "text": "像是璃月的说书人吗…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛达赫",
          "text": "呃…虽然我没亲眼见过，不过听起来，应该差不太多？"
        },
        {
          "role": "玛达赫",
          "text": "不过，这古代英雄的传说再怎么精彩，也架不住每天都讲…果然还是得找点新的故事。"
        },
        {
          "role": "玛达赫",
          "text": "唉，最好还得是发生在须弥之外的事情，一来足够新鲜好玩，二来嘛…"
        },
        {
          "role": "玛达赫",
          "text": "我也好再加工处理，也不担心被人说不对…反正大家都没听过…咳！"
        },
        {
          "role": "玛达赫",
          "text": "不过在那之前，我自己还是得先明白要讲的那些故事…"
        },
        {
          "role": "玛达赫",
          "text": "您看，我其实也搜集了不少世界各地的故事，比如风龙啦，送仙典仪啦…"
        },
        {
          "role": "玛达赫",
          "text": "但这些故事都是我从人家那边打听来的，故事内容肯定被添油加醋过，不太可靠。"
        },
        {
          "role": "玛达赫",
          "text": "旅行者，我从冒险家协会那边听说过，您是在到处旅行，对吧？"
        },
        {
          "role": "玛达赫",
          "text": "能不能请您和我说说，您在世界各地的见闻？"
        },
        {
          "role": "玛达赫",
          "text": "这样的话，我也能修正一下我搜集来的这些故事，不至于讲得太离谱…"
        },
        {
          "role": "玛达赫",
          "text": "当然！我讲故事拿到的报酬，也会分给您一份！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这倒是没问题…",
              "dialogues": [
                {
                  "role": "玛达赫",
                  "text": "那就拜托您了！您准备讲哪段见闻？"
                },
                {
                  "role": "旅行者",
                  "text": "故事到处都能打听吧。"
                },
                {
                  "role": "玛达赫",
                  "text": "这个么，我其实也搜集了不少世界各地的故事，比如风龙啦，送仙典仪啦…"
                },
                {
                  "role": "玛达赫",
                  "text": "但这些故事传到我耳朵里，都不知道被转了多少道，内容肯定被添油加醋过，不太可靠。"
                },
                {
                  "role": "玛达赫",
                  "text": "还是得听您这样游历过四方的旅行者讲讲，我才能修正好这些故事，不至于讲得太离谱。"
                }
              ]
            },
            {
              "text": "添油加醋到什么程度？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "添油加醋到什么程度？"
        },
        {
          "role": "玛达赫",
          "text": "咳…就是那种，听起来就知道是胡说八道的程度…"
        },
        {
          "role": "玛达赫",
          "text": "哈哈哈…比如什么背生双翼的骑士，一人一剑镇压魔神的剑客…我等会给您详细讲讲…"
        },
        {
          "role": "玛达赫",
          "text": "那我们就开始吧，您准备讲哪段见闻？"
        },
        {
          "type": "subtitle",
          "text": "前往咖啡馆与玛达赫对话"
        },
        {
          "role": "玛达赫",
          "text": "唉…您也来了啊，旅行者。今天的故事感觉怎么样？"
        },
        {
          "role": "旅行者",
          "text": "故事挺离谱的…"
        },
        {
          "role": "玛达赫",
          "text": "嗯…和其他客人的评价一样呢。看来是我修饰过度，反而忘了「真实感」。"
        },
        {
          "role": "玛达赫",
          "text": "唉…看来我还得再改改这故事…"
        },
        {
          "role": "玛达赫",
          "text": "多谢您提供的素材，这些报酬还请收下。"
        },
        {
          "role": "玛达赫",
          "text": "以后还有什么故事，记着分享给我啊！"
        },
        {
          "role": "玛达赫",
          "text": "嘿！您也来了啊，旅行者。今天的故事感觉怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还挺有意思。",
              "dialogues": []
            },
            {
              "text": "不错的故事。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛达赫",
          "text": "哈哈，和其他客人的评价一样呢。一个新的时代里，会出现新的英雄、新的故事。"
        },
        {
          "role": "玛达赫",
          "text": "多亏了他们，我们这行才能干得长远…哦，当然也得谢谢您，这下我应该能喝杯好点的咖啡了。"
        },
        {
          "role": "玛达赫",
          "text": "多谢您提供的素材，这些报酬还请收下。"
        },
        {
          "role": "玛达赫",
          "text": "以后还有什么故事，记着分享给我啊！"
        }
      ]
    }
  ]
}