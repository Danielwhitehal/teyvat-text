{
  "quest_id": 10131,
  "chapter_num": "",
  "chapter_title": "已逝去的末日",
  "type": "wq",
  "route": "Apocalypse Lost",
  "stories": [
    {
      "story_id": 73305,
      "title": "居尔城的记忆",
      "description": "在古老的「演习场」发生了奇特的震动，根据利露帕尔所言，此事或许与居尔城的久远过去有关…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "地面上的这些「格子」…好像缺了点什么呢？"
        },
        {
          "role": "利露帕尔",
          "text": "眼力不错…缺少的正是「棋子」。"
        },
        {
          "type": "subtitle",
          "text": "将{{图标|「渡魂之舟」}}、{{图标|「圣显厅」}}、{{图标|「边境堡垒」}}、{{图标|「赤王之柱」}}、{{图标|「居尔城神殿」}}布置在「棋盘」上",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与利露帕尔对话"
        },
        {
          "role": "利露帕尔",
          "text": "…小心，在地下深处，有奇特的震动。"
        },
        {
          "role": "派蒙",
          "text": "欸？你有感觉到什么吗？"
        },
        {
          "role": "利露帕尔",
          "text": "没什么…是演习。"
        },
        {
          "role": "派蒙",
          "text": "哦哦，没什么啦，是「演习」！"
        },
        {
          "role": "派蒙",
          "text": "等等——什么「演习」啦！"
        },
        {
          "role": "利露帕尔",
          "text": "嘘…它们来了。"
        },
        {
          "type": "subtitle",
          "text": "击败元能构装体"
        },
        {
          "role": "利露帕尔",
          "text": "小心！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|元能构装体·重塑仪|2}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|元能构装体·力场发生器|2}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|元能构装体·勘探机|2}}",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "利露帕尔",
          "text": "解决了，我就知道这些家伙对您来说是小意思。"
        },
        {
          "role": "利露帕尔",
          "text": "啊…您看，居尔城。"
        },
        {
          "type": "subtitle",
          "text": "「棋子」的出现"
        },
        {
          "type": "subtitle",
          "text": "与利露帕尔对话"
        },
        {
          "role": "利露帕尔",
          "text": "请将我与那座「棋子」相连吧。"
        },
        {
          "role": "派蒙",
          "text": "相…相连…？那是什么意思…"
        },
        {
          "role": "利露帕尔",
          "text": "从它的表面找到突出物，然后插入我瓶子的插槽里，就这么简单。"
        },
        {
          "role": "派蒙",
          "text": "欸…还有那种东西吗？你的瓶子看起来明明挺光滑的…也没有能插的地方呀！"
        },
        {
          "role": "利露帕尔",
          "text": "你看不到而已。"
        },
        {
          "role": "派蒙",
          "text": "哦…"
        },
        {
          "role": "利露帕尔",
          "text": "因为是我刚刚胡编的。"
        },
        {
          "role": "派蒙",
          "text": "哦…喂——！"
        },
        {
          "role": "利露帕尔",
          "text": "噗…好了，不开玩笑了。我的大人，您只需要带着我，接触那座「棋子」即可。"
        },
        {
          "type": "subtitle",
          "text": "调查「棋子」"
        },
        {
          "type": "subtitle",
          "text": "与利露帕尔对话"
        },
        {
          "role": "利露帕尔",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "唔…利露帕尔，你还好吗？怎么突然没反应啦…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嘘…",
              "dialogues": []
            },
            {
              "text": "利露帕尔？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "等等，你看…她在发光呢。和平时不太一样…"
        },
        {
          "type": "subtitle",
          "text": "镇灵的魔瓶微微闪光，似乎与「棋子」的振动同调。\n你听到时间在流逝，就像监牢中的水滴声…似乎长达一生，又或短则一瞬。\n而利露帕尔没有说话。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "然后，迷雾中你看到了那座巨城，庞大、臃肿而冷漠。\n大地张开裂口，吞没了居尔城的一切…\n而它的城门就在那里，镶嵌在山壁之上，它如此丑陋，仿佛集聚了古老世界的一切污秽，却免于为众目所观…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "利露帕尔",
          "text": "它在那里，居尔城。我记起来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我的头好痛…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呜哇，你们怎么回事啦…下次再这样提前通知我呀！不要总是吓我一跳！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "对不起啦，派蒙。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼，反正我是生气啦！"
                }
              ]
            },
            {
              "text": "我没事的，派蒙。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼，每次你都这么说！"
                }
              ]
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "噗…小孩子一样呢，好啦，不要担心了。我会把他还给你的，小家伙。"
        },
        {
          "role": "利露帕尔",
          "text": "到时候，他还要赔偿你好多好吃的呢…嗯，还有「牟拉」，你们的钱币，对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是「摩拉」…我为什么要纠正你。",
              "dialogues": []
            },
            {
              "text": "不要擅自替我下决定…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这还差不多嘛…我记下来咯！好吃的，还有摩拉！"
        },
        {
          "role": "利露帕尔",
          "text": "好了，儿童时间结束，我们前往居尔城吧，我的大人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们为什么要去那里？",
              "dialogues": [
                {
                  "role": "利露帕尔",
                  "text": "为什么？我不知道…或许理由根本不重要，但我需要去那里。所以，我的大人…"
                },
                {
                  "role": "利露帕尔",
                  "text": "如果非要一个理由，那么就是我希望您见证我的过去，见证我的教训。"
                }
              ]
            },
            {
              "text": "居尔城…那里有什么？",
              "dialogues": [
                {
                  "role": "利露帕尔",
                  "text": "什么都没有，什么也没有留下…"
                },
                {
                  "role": "利露帕尔",
                  "text": "残留在那里的，只有鬼魂的回忆、无法复原的碎梦和复仇甜美的余味…我会这样说。"
                },
                {
                  "role": "利露帕尔",
                  "text": "虽然这个请求有点过分…但我希望您见证我的过去，见证我的教训。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "虽然没头没尾的…我也没听太懂就是啦，但你这话说得好像要告别一样，是发生什么事了吗？"
        },
        {
          "role": "利露帕尔",
          "text": "哈哈，没什么…只是，有些东西，我想要让你们见识一下。"
        },
        {
          "role": "派蒙",
          "text": "什么嘛，一把年纪了说话还支支吾吾的！"
        },
        {
          "role": "利露帕尔",
          "text": "总之，请您跟着我前来吧，我为您指引居尔城的位置…"
        },
        {
          "type": "subtitle",
          "text": "接触「棋子」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "接触「棋子」",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与利露帕尔对话"
        },
        {
          "role": "派蒙",
          "text": "呜哇！刚刚我们还在「棋子」旁边，「唰——」的一下就到这里啦！"
        },
        {
          "role": "派蒙",
          "text": "这是怎么回事呀，好厉害！"
        },
        {
          "role": "利露帕尔",
          "text": "呵呵，还想再来一遍吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "再来一遍，再来一遍！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "收敛点啦！你是小孩子吗！"
                }
              ]
            },
            {
              "text": "还是不了，我有点晕…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…这么说来，我也有点晕晕的…"
                }
              ]
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "很正常，坐标偏转了。可能是因为老化的原因…"
        },
        {
          "role": "派蒙",
          "text": "欸…这不是我们最初来过的那座峡谷吗？你带我们来这里干什么呀？这里有什么值得一看的东西吗？"
        },
        {
          "role": "利露帕尔",
          "text": "问题太多了，小家伙。"
        },
        {
          "role": "利露帕尔",
          "text": "奇怪…应该就在这里的…啊，在这！"
        },
        {
          "type": "subtitle",
          "text": "打开居尔城的大门"
        },
        {
          "role": "利露帕尔",
          "text": "沉入大地裂口的居尔城，如今重现在您的面前。"
        },
        {
          "role": "利露帕尔",
          "text": "哦…看来这里又被另一批住民占据了，除掉它们吧，我的大人。"
        },
        {
          "type": "subtitle",
          "text": "击败元能构装体"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|元能构装体·重塑仪|2}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "获取利露帕尔的碎片"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "获取",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与利露帕尔对话"
        },
        {
          "type": "subtitle",
          "text": "随着闪光的碎片汇入利露帕尔的魔瓶，你感到自身的力量也被抽离了少许…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "「希鲁伊，正是胡拉姆丁。」\n头戴黄铜面具者如是说。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "「你名下的人必不留后；我必从你神的庙中除灭诸多偶像；我必因你卑鄙，使你归于坟墓。」\n头戴黄铜面具者如是说。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "从镇灵恍惚的目光中，你望见了居尔城被黑暗吞没时的景象…\n居尔城自古如蓄水大池，如今住民却如洪流般四散奔逃。\n毫无智性的镇灵从冷酷的机械、兵士们的武器之中喷涌…朱红的酒，石榴的汁液随之而至，爆散而出…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "石榴翻滚开裂，又被践踏成泥、混作一团…饱满或萎缩、富贵或卑贱…猩红的果实纷纷呼号着胡拉姆丁的到来——生命的欢乐，复仇的欢欣。\n汁液的滋味甜美醇厚如醴，泉涌满城，化作红色的汪洋大海…\n大海先淹没奴隶，然后主子才漂浮在黑夜的汪洋中哀嚎。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "最后，你望见黄铜面具的王。他遁入阴影，遁入希琳的怀抱…\n她的容颜苍老模糊，生命与理智的痕迹如夜风中的尘埃般消逝了。\n还有那化为黑色魔兽的基斯拉王…他们皆是你的血脉，但你却为此欣喜不已——你为报应而狂喜。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "居尔城啊，你的创伤无法救治，你的羞耻为众目所观…\n听见这消息的人必鼓掌欢呼——\n因为谁没受过你无休止的暴虐呢？",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "利露帕尔",
          "text": "「居尔城啊，你的创伤无法救治，你的羞耻为众目所观…」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            },
            {
              "text": "所以…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "奥尔玛兹曾是利露帕尔的爱人，他因镇灵的爱而从牧羊人成为人中之王。"
        },
        {
          "role": "利露帕尔",
          "text": "我曾以为他会是超越凡人的伴侣，我愚蠢地爱上他的双眼…但为王的虚荣与自私终究攫住了他…"
        },
        {
          "role": "利露帕尔",
          "text": "他与朝生暮死的凡人诸王没有任何区别…只知徜徉在征服与迫害的迷梦之中，以流沙为基搭建宫阙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "于是，你谋害了他…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "我说过，我惩罚了他。由父及子，直至三代。"
        },
        {
          "role": "利露帕尔",
          "text": "基斯拉·帕维兹拉万，希琳，皆是我的血脉…我用血的阴谋、蜜的极刑，与狂暴的野心，惩罚了他们所有人。"
        },
        {
          "role": "利露帕尔",
          "text": "不仅如此…唉，不仅如此。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「惩罚」…",
              "dialogues": []
            },
            {
              "text": "关于居尔城的结局…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "虚荣的帕维兹拉万，我的爱子…他想要无穷的权力，我便给了他。"
        },
        {
          "role": "利露帕尔",
          "text": "我为他设计了用镇灵残魄驱使的机械，在深黑的梦中启发他建立起流水般吞吐人工造物的庞大机械…"
        },
        {
          "role": "利露帕尔",
          "text": "它们带来了无穷的财富，却也夺走了劳役者的生命力，剥夺了农人的财产。"
        },
        {
          "role": "利露帕尔",
          "text": "王公与富商们纷纷含泪激赏——这是凡人的凯旋，这是奴役的结束。但我明知，只有我明晓…"
        },
        {
          "role": "利露帕尔",
          "text": "奴隶的取缔，正是无穷残虐奴役的开始——奴隶主被解脱了抚养奴隶的义务，而奴隶被剥夺了免于饥馁的小小恩惠…"
        },
        {
          "role": "派蒙",
          "text": "我…我已经开始听不懂了…你这是在说什么呀…？"
        },
        {
          "role": "利露帕尔",
          "text": "贫苦伴生仇恨，仇恨催化野心…富裕蔓生贪婪，贪婪亦燃发野心。"
        },
        {
          "role": "利露帕尔",
          "text": "野心令他逼迫王后希琳——亦是他的亲生姐姐产出无智性的畸形镇灵…而她的痛苦取悦了我，也给我力量…"
        },
        {
          "role": "利露帕尔",
          "text": "…令我得以将他们的骨肉抚养长大。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是说希鲁伊…",
              "dialogues": [
                {
                  "role": "利露帕尔",
                  "text": "希鲁伊，就是「黄铜面具」胡拉姆丁。贱民与奴隶视他为女主人的使者，视他如苦难中降临的拯救者。"
                },
                {
                  "role": "利露帕尔",
                  "text": "于是，他引导他们拥抱正义…拥抱灭亡。"
                }
              ]
            },
            {
              "text": "「黄铜面具」…",
              "dialogues": [
                {
                  "role": "利露帕尔",
                  "text": "啊…胡拉姆丁，就是戴黄铜面具的希鲁伊王。「女主人的使者」、「穷困者与奴隶的拯救者」，哈哈，高明的骗子。"
                },
                {
                  "role": "利露帕尔",
                  "text": "终究，他引导那些追随他的人归于漆黑的灭亡…连同这整座居尔城，被大地吞入漆黑的裂口。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "利露帕尔",
          "text": "嗯？原来你还在这呢，小家伙…怎么不说话了呢？"
        },
        {
          "role": "派蒙",
          "text": "嗯…只是，我完全没听懂…而且，听起来好可怕。"
        },
        {
          "role": "利露帕尔",
          "text": "没什么，没什么…我刚刚所说的都是我的过去，与我的命运。"
        },
        {
          "role": "派蒙",
          "text": "哦…我…我不知道该说什么啦…"
        },
        {
          "role": "利露帕尔",
          "text": "多谢您的陪伴，我才能再度回到女主人的花园…"
        },
        {
          "role": "派蒙",
          "text": "欸…为什么突然说这个呀…？"
        },
        {
          "role": "利露帕尔",
          "text": "居尔城，是我的命运之地。我要返回这座城中，还有使命在等着我。"
        },
        {
          "role": "派蒙",
          "text": "唔…因为你以前做了很多错事，所以你要回去弥补…是这样吗？"
        },
        {
          "role": "利露帕尔",
          "text": "错事…？噗…我没什么做错的事。但我的孩子们还在那里，她和希鲁伊…一定很寂寞吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的意思是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "漆黑的力量愈发强大了…能直面它的，只有母亲的力量。"
        },
        {
          "role": "利露帕尔",
          "text": "我曾以为我能利用漆黑的深渊，对我所憎恨的施以惩罚…但我业已遭受了报应…进入居尔城，直面它的报复，也将是我的使命。"
        },
        {
          "role": "利露帕尔",
          "text": "我的大人…很抱歉，没能多陪在您的身边一会儿，没能多熟悉您片刻。"
        },
        {
          "role": "利露帕尔",
          "text": "但我明白，命运一定会驱使我们再次相见。您拥有不受腐化的品质，我相信…我的选择会是正确的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的选择…？",
              "dialogues": []
            },
            {
              "text": "你要离开了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "常理来说，并非主人选择镇灵，而是镇灵选择主人。即使离去，我想我们的联系也不会这样简单地结束…"
        },
        {
          "role": "利露帕尔",
          "text": "所以…请接受我的最后一件礼物。"
        },
        {
          "role": "利露帕尔",
          "text": "请您将我捧在耳边…再一次。"
        },
        {
          "type": "subtitle",
          "text": "你将魔瓶轻轻捧在耳边…\n伴随着一阵轻笑，你听到有人用无比柔和雅致的语言在你的耳旁柔声低语…\n她所倾诉的东西就像泉流一样难测，但你一字不落地听懂了。\n最后，话语消散，仅在你的耳廓留下一丝清冷的余韵…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "透过她的指点，你熟识了古代的韵文…\n但她却不再言语。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "欸…你看，瓶子里的光变暗了…利露帕尔，你还好吗？"
        },
        {
          "role": "派蒙",
          "text": "利露帕尔…利露帕尔…？"
        },
        {
          "role": "利露帕尔",
          "text": "（瓶子的光芒渐暗，又逐渐恢复了闪烁。但她已经不再言语。）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她离开了…",
              "dialogues": []
            },
            {
              "text": "居尔城…在等待着她。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这样吗…结果，真的是告别呀…我们以后还会再见到她吗…？"
        },
        {
          "role": "派蒙",
          "text": "唔…我们…也回去吧？"
        },
        {
          "type": "subtitle",
          "text": "石碑（无名的石碑·其一）"
        },
        {
          "role": "无名的石碑·其一",
          "text": "「我儿基斯拉，我儿…」"
        },
        {
          "role": "无名的石碑·其一",
          "text": "「基斯拉，基斯拉·帕维兹拉万，自我所出，因我而亡的孩子…」"
        },
        {
          "role": "无名的石碑·其一",
          "text": "「你曾以为王权能够令人脱离奴役的枷锁，令凡人脱离诸神的藩篱…」"
        },
        {
          "role": "无名的石碑·其一",
          "text": "「你曾用尖啸的机械建起齐天的宫阙，化绿洲为阡陌交通的耕地…」"
        },
        {
          "role": "无名的石碑·其一",
          "text": "「但以名为自由的奴役建起的帝国，终将覆灭于同一个谎言…」"
        },
        {
          "role": "无名的石碑·其一",
          "text": "「愿千百种骄傲充斥你心，直到天地翻覆，令至卑至贱者翻转到你的头上…」"
        },
        {
          "role": "无名的石碑·其一",
          "text": "「到那日，奥尔玛兹的野心终得获应报。」"
        }
      ],
