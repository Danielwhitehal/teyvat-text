{
  "quest_id": 70667,
  "chapter_num": null,
  "chapter_title": "牌手等级突破·二",
  "type": "wq",
  "route": "Ascension Challenge II",
  "stories": [
    {
      "story_id": 70667,
      "title": "牌手等级突破·二",
      "description": "「七圣召唤」的牌手协会认定你已经具有了进行等级突破试炼的资格。赢下突破挑战的牌局，成为「专家牌手」吧！希望你能感受到「七圣召唤」的乐趣！",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往「猫尾酒馆」"
        },
        {
          "role": "旅行者",
          "text": "进行突破挑战！"
        },
        {
          "role": "「小王子」",
          "text": "喵…「哎呀，要来进行牌手等级突破的试炼吗…嗯，旅行者确实已经拥有了挑战的资格，那我这就…」"
        },
        {
          "role": "「小王子」",
          "text": "「这就让恕筠准备突破试炼所用的牌局吧，可要小心应对呀…」"
        },
        {
          "type": "subtitle",
          "text": "与「小王子」进行突破对局"
        },
        {
          "type": "subtitle",
          "text": "与「小王子」对话"
        },
        {
          "role": "「小王子」",
          "text": "喵…「嗯，旅行者得要再小心一点才行啊，先调整一下，之后再来挑战吧？」"
        },
        {
          "role": "「小王子」",
          "text": "「我相信你是有足以完成试炼的实力的…」"
        },
        {
          "role": "「小王子」",
          "text": "喵！「真是了不起，恭喜你突破了牌手等级的试炼，现在已经是专家牌手了！」"
        },
        {
          "role": "「小王子」",
          "text": "「这样就有资格挑战更多的牌手了…对了，虽然之前你就已经可以了，但我再提醒一下，你可以在邀请板悬挂战书…」"
        },
        {
          "role": "「小王子」",
          "text": "喵…「这样，想要挑战你的牌手都能撕下你的战书。哼，不知道对手是谁的对局，有的时候也是挺有趣的事…」"
        },
        {
          "role": "「小王子」",
          "text": "「毕竟，相约进行牌局，也是一种相遇的方式。」"
        },
        {
          "role": "「小王子」",
          "text": "喵！「啊！扯远了，那么作为专家牌手的特权，现在的旅行者有资格购买一些牌面好看的不得了的卡…」"
        },
        {
          "role": "「小王子」",
          "text": "「嗯嗯…旅行者，勿忘游乐之心，希望你能感受到『七圣召唤』的乐趣！」"
        }
      ]
    }
  ]
}