{
  "quest_id": 73508,
  "chapter_num": null,
  "chapter_title": "暂别时的约定",
  "type": "wq",
  "route": "Parting Arrangement",
  "stories": [
    {
      "story_id": 73508,
      "title": "暂别时的约定",
      "description": "「灵蕈棋阵」的测试已接近尾声，是时候去给海妮耶和贝尔福一些反馈了…",
      "dialogues": [
        {
          "role": "贝尔福",
          "text": "这些天来多谢你们了，「黄金流星」旅行者和「白银伴星」！"
        },
        {
          "role": "贝尔福",
          "text": "我记录下了你们每次游玩「灵蕈棋阵」的过程，根据你们的游玩记录，可以得出许多数据。"
        },
        {
          "role": "贝尔福",
          "text": "你们属于「顶尖水准」的试玩者，将你们的记录和普通试玩者的相结合，就能分析出稳妥的改进方案。"
        },
        {
          "role": "海妮耶",
          "text": "当然，最后还要请你们发表关于总体风格的建议。"
        },
        {
          "role": "海妮耶",
          "text": "你们的反馈不止对「灵蕈棋阵」这个游戏有正面意义，还在一定程度上影响着下一届大赛的玩法。"
        },
        {
          "role": "贝尔福",
          "text": "还请你们大概说说自己的倾向。比如…是更重视趣味性，还是竞技性呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我更看重与伙伴们的合作。",
            "我更倾向于战斗的华丽和爽快。",
            "我没什么所谓，开心就好！"
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦！比赛和对抗确实很重要，不过，我们希望之后的挑战更能考验我们和蕈兽伙伴的默契！"
        },
        {
          "role": "海妮耶",
          "text": "和蕈兽伙伴们的默契吗…我明白了。"
        },
        {
          "role": "海妮耶",
          "text": "贝尔福先生，记得我之前和你说过的，最重要的理念吧？"
        },
        {
          "role": "贝尔福",
          "text": "理解！下次大赛，我会争取设计一些考验你们配合的挑战，让你们和蕈兽伙伴在高效的沟通中发挥全力！"
        },
        {
          "role": "海妮耶",
          "text": "你们两位还真是一点都没变呢…"
        },
        {
          "role": "海妮耶",
          "text": "总之，这样一来，本次「灵蕈棋阵」的测试就大功告成了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "有劳你们了！",
            "记得报酬哦。"
          ]
        },
        {
          "role": "派蒙",
          "text": "好耶！完成工作后，我们就能拿到一笔辛苦费，买些好吃的犒劳自己啦！"
        },
        {
          "role": "派蒙",
          "text": "等等…不对不对！我们是下次大赛的主办方，而海妮耶和贝尔福在为下次大赛做准备…"
        },
        {
          "role": "派蒙",
          "text": "海妮耶是我们的好帮手，理论上来说，贝尔福也算是我们的员工了…"
        },
        {
          "role": "派蒙",
          "text": "那是不是应该…唔…由我们给好帮手辛苦费，给员工发工资？"
        },
        {
          "role": "海妮耶",
          "text": "不不不！你们未免也太好心了！这都是我自愿开展的工作，我也有非常多的收获！"
        },
        {
          "role": "海妮耶",
          "text": "我毕竟也算是个商业人士，这次开发并运营「灵蕈棋阵」的经验和履历，对于我们这类人弥足珍贵。"
        },
        {
          "role": "海妮耶",
          "text": "要是这份工作对外开放，不知道会有多少人拿着一大笔钱来求你们授权呢！"
        },
        {
          "role": "海妮耶",
          "text": "而且，「灵蕈棋阵」盈利后，贝尔福先生投入的钱也有着落了，他还会将大部分收入交给我。"
        },
        {
          "role": "海妮耶",
          "text": "我会将一部分收入储存起来，作为下次大赛的预备资金，一部分用来好好照顾蕈兽伙伴们。"
        },
        {
          "role": "海妮耶",
          "text": "不止是「咚咚小圆帽」它们，还有诸如「信风舞姬」那样的，选手们托我照顾的伙伴。"
        },
        {
          "role": "海妮耶",
          "text": "也就是说，你们帮助我们改进了「灵蕈棋阵」，可以带来大量的收益，还为蕈兽伙伴们提供了保障。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样吗…虽然听不太懂什么盈利，收入之类的，但感觉好像，所有人都有很大的收获？"
        },
        {
          "role": "派蒙",
          "text": "那我也更有成就感了！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，有机会的话，我们也和须弥的朋友们说说「灵蕈棋阵」的事，让更多人知道这个游戏吧！"
        },
        {
          "role": "旅行者",
          "text": "当然当然！"
        },
        {
          "role": "海妮耶",
          "text": "接下来，我就要和蕈兽伙伴们先行一步，去城外会合助手，回营地去了。"
        },
        {
          "role": "海妮耶",
          "text": "如果离开营地太久，留守的蕈兽伙伴们会担心的。"
        },
        {
          "role": "海妮耶",
          "text": "贝尔福先生还会在这里继续宣传测试版的「灵蕈棋阵」，如果你们还没尽兴，可以继续玩玩。"
        },
        {
          "role": "贝尔福",
          "text": "对，玩个痛快吧！"
        },
        {
          "role": "派蒙",
          "text": "呜，海妮耶要走了吗？要带着「咚咚小圆帽」它们离开了？"
        },
        {
          "role": "派蒙",
          "text": "我还想和「咚咚小圆帽」再玩一会儿呢…"
        },
        {
          "role": "派蒙",
          "text": "不过…这次见到海妮耶后，我越来越安心了。"
        },
        {
          "role": "派蒙",
          "text": "特别是确认了蕈兽伙伴们都健健康康，和我们的默契一点也没有减少！"
        },
        {
          "role": "海妮耶",
          "text": "放心，也许不过多久，我们就会再见面的。"
        },
        {
          "role": "海妮耶",
          "text": "虽说你们经常四处旅行，但我也有办法和你们联络。比如通过冒险家协会把信件转达给你们。"
        },
        {
          "role": "海妮耶",
          "text": "我保证，之后与你们再见时，我和蕈兽伙伴们都健健康康，精力充沛！"
        },
        {
          "role": "海妮耶",
          "text": "请静候佳音吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯！我们相信你，海妮耶！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "加油啊，海妮耶。",
            "照顾好蕈兽伙伴们。",
            "也别忘了照顾好自己。"
          ]
        },
        {
          "role": "海妮耶",
          "text": "那就下次再见了，「黄金流星」旅行者和「白银伴星」派蒙！"
        }
      ]
    }
  ]
}