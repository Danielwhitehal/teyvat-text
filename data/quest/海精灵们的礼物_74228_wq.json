{
  "quest_id": 74228,
  "chapter_num": null,
  "chapter_title": "海精灵们的礼物",
  "type": "wq",
  "route": "A Gift From the Sea Spirits",
  "stories": [
    {
      "story_id": 74228,
      "title": "海精灵们的礼物",
      "description": "在枫丹水色温柔的海边，你与派蒙遇到了一位需要帮助的美露莘…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "到水畔散步"
        },
        {
          "role": "芙佳",
          "text": "你好呀，亲爱的美露莘小姐，需要帮助吗？"
        },
        {
          "role": "芙佳",
          "text": "啊，是旅行者和派蒙！好久不见，你们好！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来是芙佳，你也好。",
              "dialogues": []
            },
            {
              "text": "又在找漂亮石头吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芙佳",
          "text": "嘿嘿，真了解我，让你猜对啦。"
        },
        {
          "role": "芙佳",
          "text": "海沫村的伙伴们正在为那维莱特大人准备惊喜礼物，是大家一起缝制的新衣服哦！我正要去找些用来装饰的宝石和贝壳呢。"
        },
        {
          "role": "旅行者",
          "text": "哇，是惊喜礼物！"
        },
        {
          "role": "派蒙",
          "text": "哇，是惊喜礼物！"
        },
        {
          "role": "派蒙",
          "text": "不过就这样告诉我们了，没关系吗？"
        },
        {
          "role": "芙佳",
          "text": "哎呀！"
        },
        {
          "role": "芙佳",
          "text": "抱歉，因为第一次做这种事，一不小心就说漏嘴了。"
        },
        {
          "role": "芙佳",
          "text": "不知为何，看着大家一起热火朝天地朝着同一个目标努力，心情总是平静不下来…"
        },
        {
          "role": "派蒙",
          "text": "我懂我懂，被氛围感染，感觉自己有使不完的干劲，对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就像一起组乐队。",
              "dialogues": [
                {
                  "role": "芙佳",
                  "text": "确实有些像呢！大家虽然用着不同的乐器，却和谐地演奏出了同一首歌。"
                }
              ]
            },
            {
              "text": "就像一起犯罪。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "不对吧！"
                },
                {
                  "role": "派蒙",
                  "text": "求你了，请不要在法治国度说这种话…"
                },
                {
                  "role": "芙佳",
                  "text": "唔…大家一起保守秘密，悄悄行动…好像，也不是没有相似之处？"
                },
                {
                  "role": "派蒙",
                  "text": "糟糕，芙佳要被你带坏了，这下怎么和那维莱特交代…"
                },
                {
                  "role": "派蒙",
                  "text": "总之先停止集体犯罪的话题，说回新衣服的事情吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "说起来，怎么突然想要给那维莱特送礼物呀？"
        },
        {
          "role": "芙佳",
          "text": "这个嘛，当然是因为那维莱特大人经常给海沫村的美露莘们寄礼物，我们商量了一下，决定给那维莱特大人亲手制作回礼。"
        },
        {
          "role": "芙佳",
          "text": "芙洛姐姐负责设计图纸，然后大家一起选材料、缝衣服…而瑟琳姐姐负责在事态失控前「紧急避险」。"
        },
        {
          "role": "派蒙",
          "text": "事态失控？紧急避险？"
        },
        {
          "role": "派蒙",
          "text": "唔…用美露莘的手来做衣服确实需要付出更多努力，但能发生什么坏事呢？"
        },
        {
          "role": "芙佳",
          "text": "这要看每个人对坏事的定义了。"
        },
        {
          "role": "芙佳",
          "text": "让玛梅赫在巨大的画布上画画，然后把画做成睡袍算吗？"
        },
        {
          "role": "派蒙",
          "text": "哇，这个嘛…"
        },
        {
          "role": "旅行者",
          "text": "我觉得那维莱特会喜欢的。"
        },
        {
          "role": "芙佳",
          "text": "嘿嘿，我也这么认为！"
        },
        {
          "role": "芙佳",
          "text": "不过瑟琳姐姐说，还是做套能让那维莱特大人体面穿出门的衣服比较好。"
        },
        {
          "role": "芙佳",
          "text": "我们让见多识广的洛梅找来不少时尚杂志，又咨询了希格雯姐姐人类眼中「体面」的定义，最终决定服装主题为「严肃地放松」。"
        },
        {
          "role": "派蒙",
          "text": "「严肃地放松」…不知为何脑子里出现了那维莱特板着脸在海里游泳的样子…"
        },
        {
          "role": "旅行者",
          "text": "是不是还拿着贝壳？"
        },
        {
          "role": "派蒙",
          "text": "啊？"
        },
        {
          "role": "芙佳",
          "text": "哦对了，贝壳！光顾着聊天，差点忘了我负责的部分…"
        },
        {
          "role": "芙佳",
          "text": "抱歉，我得失陪啦，不能因为自己贪玩耽误其他美露莘的时间。"
        },
        {
          "role": "芙佳",
          "text": "我要赶快去找些亮闪闪的贝壳和石头磨成闪粉，用来染色的汐藻也不知道还够不够…"
        },
        {
          "role": "旅行者",
          "text": "既然如此，那我要说出那句话了…"
        },
        {
          "role": "派蒙",
          "text": "「交给我们吧！」"
        },
        {
          "role": "派蒙",
          "text": "这家伙可会找东西了，保证按时按量完成任务！"
        },
        {
          "role": "芙佳",
          "text": "真的可以吗？太感谢了！"
        },
        {
          "role": "芙佳",
          "text": "那就请旅行者帮我找几个最亮最闪的苍晶螺吧，我记得附近的水域就有不少，两三个应该足够了。"
        },
        {
          "role": "派蒙",
          "text": "放心吧，二三十个都没问题！"
        },
        {
          "role": "芙佳",
          "text": "不用这么多啦！"
        },
        {
          "role": "芙佳",
          "text": "那我就专心在这里找宝石，祝我们好运，等会儿见！"
        },
        {
          "type": "subtitle",
          "text": "与美露莘对话"
        },
        {
          "role": "芙佳",
          "text": "多谢你们帮忙！要注意安全哦！"
        },
        {
          "type": "subtitle",
          "text": "寻找潜入水下的方法"
        },
        {
          "type": "subtitle",
          "text": "采集最亮最闪的苍晶螺"
        },
        {
          "role": "洛梅",
          "text": "那维莱特大人，可以问您一个问题吗？"
        },
        {
          "role": "那维莱特",
          "text": "当然，请讲。"
        },
        {
          "role": "洛梅",
          "text": "听说璃月有纸里包火，可以实现一切愿望的灯。是真的吗？"
        },
        {
          "role": "薇尔妲",
          "text": "纸里包火？不会坏掉吗？岂不是很危险？"
        },
        {
          "role": "芙佳",
          "text": "对哦。如果你的愿望是烧掉整个家，那应该能实现吧。"
        },
        {
          "role": "芙洛",
          "text": "天哪芙佳，你这玩笑是从谁那里学来的？"
        },
        {
          "role": "芙佳",
          "text": "欸？不是玩笑哦？"
        },
        {
          "role": "那维莱特",
          "text": "这个…的确有类似的东西，叫做「霄灯」。"
        },
        {
          "role": "那维莱特",
          "text": "使用得当的话是不会有危险的，只是并不能真的实现愿望…抱歉。"
        },
        {
          "role": "嘉莱娜",
          "text": "哎呀，那维莱特大人为什么要道歉啦。"
        },
        {
          "role": "那维莱特",
          "text": "呵…仅听我描述大概会很无趣。这样如何，等我有空去璃月，给你们带一些回来。"
        },
        {
          "role": "洛梅",
          "text": "好耶！要是能多拍点画片回来，就更好了！"
        },
        {
          "role": "那维莱特",
          "text": "嗯，一定。"
        },
        {
          "type": "subtitle",
          "text": "查看芙佳的情况"
        },
        {
          "role": "派蒙",
          "text": "芙佳！你还好吗？"
        },
        {
          "role": "芙佳",
          "text": "呜…没想到挖宝石还挖到了重甲蟹…"
        },
        {
          "role": "旅行者",
          "text": "（重甲蟹？不是龙蜥吗？）"
        },
        {
          "role": "芙佳",
          "text": "没关系，没关系，我没有受伤…抱歉，让你们担心了…"
        },
        {
          "role": "芙佳",
          "text": "还好刚刚有只龙蜥出现，一口就吞掉了坏螃蟹！"
        },
        {
          "role": "派蒙",
          "text": "欸？！原来龙蜥会吃大螃蟹吗？"
        },
        {
          "role": "旅行者",
          "text": "重点是这个？"
        },
        {
          "role": "芙佳",
          "text": "可能并不喜欢吃吧，我看龙蜥的表情不是很开心…"
        },
        {
          "role": "旅行者",
          "text": "重点是这个？"
        },
        {
          "role": "派蒙",
          "text": "对哦，重点应该是…呃，这里为什么会有龙蜥？"
        },
        {
          "role": "芙佳",
          "text": "不知道，以前从没在附近见过。"
        },
        {
          "role": "芙佳",
          "text": "那维莱特大人叮嘱过，有些龙蜥很友善，而有些则很危险，所以不要轻易靠近。"
        },
        {
          "role": "芙佳",
          "text": "呼…看来我运气不错，遇到了可爱的龙蜥呢。"
        },
        {
          "role": "旅行者",
          "text": "（可爱的…龙蜥？…难道…）"
        },
        {
          "role": "派蒙",
          "text": "那下次再见到它的话，要好好跟它道谢哦。"
        },
        {
          "role": "芙佳",
          "text": "嗯，一定会的，还会请它吃好吃的！就是不知道它喜欢吃什么，首先排除大螃蟹…"
        },
        {
          "role": "旅行者",
          "text": "汐藻。"
        },
        {
          "role": "芙佳",
          "text": "汐藻吗？没想到那么大只的龙蜥喜欢吃这种…"
        },
        {
          "role": "芙佳",
          "text": "欸，汐藻！什么时候出现的？"
        },
        {
          "role": "派蒙",
          "text": "咦？原来这堆汐藻不是芙佳找来的吗？"
        },
        {
          "role": "芙佳",
          "text": "不，我还没来得及下水呢…难道是哪位好心人听到了我们刚才的谈话留下的吗？"
        },
        {
          "role": "旅行者",
          "text": "没准是好心的精灵。"
        },
        {
          "role": "芙佳",
          "text": "看来今天运气真的很好，时尚杂志上的运势占卜专栏竟然没有骗人…"
        },
        {
          "role": "芙佳",
          "text": "那星辰保佑，让我们的礼物能顺利送到吧！"
        },
        {
          "role": "旅行者",
          "text": "一定会的。"
        },
        {
          "role": "派蒙",
          "text": "对了，给！这些是我们收集的苍晶螺，怎么样，够用吗？"
        },
        {
          "role": "芙佳",
          "text": "够了够了，哇好闪，芙佳要睁不开眼睛了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "夸张了。",
              "dialogues": [
                {
                  "role": "芙佳",
                  "text": "嘿嘿，是我表达感谢的独特方式啦。"
                }
              ]
            },
            {
              "text": "我是戴着墨镜找的。",
              "dialogues": [
                {
                  "role": "芙佳",
                  "text": "原来如此，那我也要买一副，用来找石头用…"
                },
                {
                  "role": "派蒙",
                  "text": "别听他胡说，没有这回事啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "芙佳",
          "text": "那么，我的宝石，你们的苍晶螺，还有好心精灵送的汐藻都到手了，任务圆满完成！"
        },
        {
          "role": "芙佳",
          "text": "如果一切都这样顺利，过几天衣服就能做好啦。"
        },
        {
          "role": "芙佳",
          "text": "旅行者，派蒙，到时候我们会把礼物送去沫芒宫，你们愿意一起来看看成品吗？"
        },
        {
          "role": "旅行者",
          "text": "当然。"
        },
        {
          "role": "芙佳",
          "text": "嘿嘿，那我们不如相约在沫芒宫见吧？一定会有很多美露莘想一起来的。"
        },
        {
          "role": "派蒙",
          "text": "好呀，期待你们的好消息！"
        },
        {
          "type": "subtitle",
          "text": "等待至两天后（14-16点）"
        },
        {
          "type": "subtitle",
          "text": "前往沫芒宫"
        },
        {
          "role": "派蒙",
          "text": "哇，好久没见沫芒宫门口这么热闹了！芙佳说得没错，果然有很多美露莘…"
        },
        {
          "role": "派蒙",
          "text": "咦，不对劲，怎么感觉气氛有些紧张？"
        },
        {
          "role": "艾尤恩",
          "text": "欸？这位小姐…"
        },
        {
          "role": "洛梅",
          "text": "复律官先生！请问在沫芒宫工作开心吗？"
        },
        {
          "role": "艾尤恩",
          "text": "是…是在问我这个问题？"
        },
        {
          "role": "艾尤恩",
          "text": "这个，说不上开心还是不开心…虽然在这工作有一段时间了，但我总觉得自己还是个新人…"
        },
        {
          "role": "洛梅",
          "text": "嗯，也就是说…沫芒宫的工作每天都激动人心，让人感觉像是精力充沛的年轻人，对吧？"
        },
        {
          "role": "艾尤恩",
          "text": "激动人心？不不，更多的是紧张…"
        },
        {
          "role": "嘉莱娜",
          "text": "紧张刺激？原来复律官的工作也这么惊险吗，我还以为只有逐影庭是这样的呢。"
        },
        {
          "role": "艾尤恩",
          "text": "不不，没有刺激，不能有刺激。如果一项工作刺激到了你的神经，那就证明中间某个流程大错特错了…"
        },
        {
          "role": "薇尔妲",
          "text": "是这样吗？瑟琪前辈没说过呢。"
        },
        {
          "role": "艾尤恩",
          "text": "瑟琪前辈…啊，是逐影庭的瑟琪警官吗？那难道您也是警官…"
        },
        {
          "role": "嘉莱娜",
          "text": "才不是哪！要论实力，肯定是我先通过考核才对！"
        },
        {
          "role": "芙洛",
          "text": "嘉莱娜，现在不是争强好胜的时候吧？这位先生都紧张得冒汗了。"
        },
        {
          "role": "洛梅",
          "text": "真的吗？听说一个人如果在接受采访时显得十分紧张，那就说明是记者问对问题了。"
        },
        {
          "role": "洛梅",
          "text": "咳咳。这位复律官先生，你的工作生活中是否有难言之隐？"
        },
        {
          "role": "艾尤恩",
          "text": "请等一下。采访？我现在是在接受采访吗？"
        },
        {
          "role": "洛梅",
          "text": "对啊。"
        },
        {
          "role": "艾尤恩",
          "text": "不对，不对不对。"
        },
        {
          "role": "艾尤恩",
          "text": "根据条例，复律官严禁接受私人采访，更不用说是来历不明的…"
        },
        {
          "role": "艾尤恩",
          "text": "不好意思，请问这位美露莘小姐，您姓甚名谁，现就职于哪家报社？"
        },
        {
          "role": "洛梅",
          "text": "唔…特约记者洛梅，来自《漂浮海獭报》。"
        },
        {
          "role": "芙佳",
          "text": "（一听就是现编的…！洛梅，新闻的真实性呢？！）"
        },
        {
          "role": "艾尤恩",
          "text": "嘶…枫丹廷有这种报纸吗？我得…我得回去翻下备忘录…"
        },
        {
          "role": "芙洛",
          "text": "这位先生，您还好吗？您现在看起来一副神经被刺激到了的样子…"
        },
        {
          "role": "艾尤恩",
          "text": "…对了，流程！各位小姐，要不请先在这里稍等片刻，我去找出版办公室的同事…"
        },
        {
          "role": "芙佳",
          "text": "（天哪，谁还记得我们本来只是想问那维莱特大人的办公室怎么走，却不知为何变成了洛梅的采访训练…）"
        },
        {
          "role": "洛耶茨",
          "text": "艾尤恩先生！可算找到你了。"
        },
        {
          "role": "洛耶茨",
          "text": "好心的柯妮莉娅小姐给我们泡的茶都快放冷了，你到底在…天哪。发生什么事了，怎么这么多美露莘？"
        },
        {
          "role": "艾尤恩",
          "text": "啊，洛耶茨先生，请帮帮忙吧，我一个人接待这些美露莘小姐实在有些吃力，还要同时应付采访…"
        },
        {
          "role": "洛耶茨",
          "text": "采访？我没听说有这个日程。哪家报纸的？"
        },
        {
          "role": "艾尤恩",
          "text": "《漂浮海獭报》。"
        },
        {
          "role": "洛耶茨",
          "text": "啊…真的吗？你们拿着的标志可不像是海獭啊。"
        },
        {
          "role": "芙佳",
          "text": "当然不是，这位是我们这次要来找的目标。"
        },
        {
          "role": "艾尤恩",
          "text": "啊？这个蓝色的生物不会指的是我吧？看着不像啊…"
        },
        {
          "role": "嘉莱娜",
          "text": "呀！什么叫蓝色的生物，这位是尊敬的那维莱特大人！"
        },
        {
          "role": "艾尤恩",
          "text": "啊？！"
        },
        {
          "role": "洛耶茨",
          "text": "嗯…"
        },
        {
          "role": "洛耶茨",
          "text": "艾尤恩先生，请不要大惊小怪。我理解最近繁忙的工作和稀少的睡眠让你有些神经紧绷，但还请冷静。"
        },
        {
          "role": "洛耶茨",
          "text": "你应该也知道，美露莘眼中的世界与我们的大不相同，所以没准最高审判官在她们的视野中就是这般…形象，对吗？"
        },
        {
          "role": "嘉莱娜",
          "text": "嗯…差不多吧！其实那维莱特大人在每个美露莘的眼中都略有不同，所以我们选取了中间值。"
        },
        {
          "role": "洛耶茨",
          "text": "啊，中间值吗，我明白了。原来如此，明智的选择。"
        },
        {
          "role": "洛耶茨",
          "text": "那么，请问各位小姐找那维莱特大人有何要事？"
        },
        {
          "role": "薇尔妲",
          "text": "我们是来送礼…"
        },
        {
          "role": "芙佳",
          "text": "…礼、礼炮！我们是来给那维莱特大人放礼炮的，嘿嘿。"
        },
        {
          "role": "芙佳",
          "text": "（好险，这次可不能再把礼物说漏嘴了…）"
        },
        {
          "role": "洛耶茨",
          "text": "…放礼炮？在沫芒宫？在最高审判官的办公室？"
        },
        {
          "role": "艾尤恩",
          "text": "洛耶茨先生，请冷静，您也开始大惊小怪了…"
        },
        {
          "role": "派蒙",
          "text": "那个，旅行者…你能不能说句话，我有点害怕…"
        },
        {
          "role": "旅行者",
          "text": "抱歉，我天生不爱说话。"
        },
        {
          "role": "派蒙",
          "text": "那算我求你，快别看热闹了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像在看实景话剧。",
              "dialogues": []
            },
            {
              "text": "一不留神看入了迷。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不是不能理解你的感受，但洛耶茨先生好像真的要去叫警卫了…"
        },
        {
          "role": "派蒙",
          "text": "等下他如果真把那维莱特叫出来，美露莘们精心准备的惊喜就要泡汤了，场面一定会更加局促…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你说服我了。",
              "dialogues": []
            },
            {
              "text": "我们上。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "上？怎么上？上哪去？"
        },
        {
          "role": "旅行者",
          "text": "芙佳，以及亲爱的朋友们，你们好哇！"
        },
        {
          "role": "芙佳",
          "text": "旅行者，派蒙！"
        },
        {
          "role": "洛耶茨",
          "text": "欸？"
        },
        {
          "role": "艾尤恩",
          "text": "…洛耶茨先生？"
        },
        {
          "role": "洛耶茨",
          "text": "请问几位是一起的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是的，我们约好了一起拜访那维莱特。",
              "dialogues": []
            },
            {
              "text": "是的，我们约好了一起拜访蓝色生物。",
              "dialogues": [
                {
                  "role": "洛耶茨",
                  "text": "哈哈哈…原来您听到了啊。"
                }
              ]
            }
          ]
        },
        {
          "role": "洛耶茨",
          "text": "那就稳妥了。那维莱特大人正在办公室内，似乎也没有其他访客。您请进吧。"
        },
        {
          "role": "艾尤恩",
          "text": "什么，不需要确认身份信息之类的吗？"
        },
        {
          "role": "洛耶茨",
          "text": "不用不用。"
        },
        {
          "role": "洛耶茨",
          "text": "您瞧，艾尤恩先生总是在埋头苦干，导致对到访过沫芒宫的客人印象不深…"
        },
        {
          "role": "旅行者",
          "text": "没关系，是我这边冒昧打扰…"
        },
        {
          "role": "洛耶茨",
          "text": "您真是客气。我们就不耽误您和美露莘朋友们的时间了，只是有一点…"
        },
        {
          "role": "派蒙",
          "text": "哎？什么呀？"
        },
        {
          "role": "洛耶茨",
          "text": "在沫芒宫，尤其是办公室里，最好保持手中的物品不要高于头顶。"
        },
        {
          "role": "洛耶茨",
          "text": "各位同僚都是极其热心的人，难免会认为你们有特殊的请求要提。"
        },
        {
          "role": "芙洛",
          "text": "明白了。这个牌子是大家害怕在枫丹廷里走散才举起来作为标志用的，既然目的地已经到了，那么芙佳…"
        },
        {
          "role": "芙佳",
          "text": "好的姐姐，我马上收起来…"
        },
        {
          "role": "派蒙",
          "text": "原来是带路用的呀！"
        },
        {
          "role": "派蒙",
          "text": "没关系，有我和旅行者，大家绝对不会迷路的。来吧，那维莱特的办公室走这边…"
        },
        {
          "role": "艾尤恩",
          "text": "洛耶茨先生…"
        },
        {
          "role": "洛耶茨",
          "text": "不用愁眉苦脸啦。那位旅行者是最高审判官的朋友，不会出问题的。"
        },
        {
          "role": "洛耶茨",
          "text": "而且就算出了什么问题，和你我又有什么关系呢。我们可都在柯妮莉娅小姐那里喝茶呢。"
        },
        {
          "role": "洛耶茨",
          "text": "啊，原来是您。"
        },
        {
          "role": "艾尤恩",
          "text": "旅行者！有一阵没见了，最近可好？"
        },
        {
          "role": "旅行者",
          "text": "一切顺利，井井有条。"
        },
        {
          "role": "艾尤恩",
          "text": "哈哈，真好啊。如您所见，这里也还是老样子…"
        },
        {
          "role": "洛耶茨",
          "text": "呵呵，请问您和美露莘们是一起的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是的，我们约好了一起拜访那维莱特。",
              "dialogues": []
            },
            {
              "text": "是的，我们约好了一起拜访蓝色生物。",
              "dialogues": [
                {
                  "role": "洛耶茨",
                  "text": "哈哈哈…原来您听到了啊。只是口误，您可得替我俩保密啊。"
                }
              ]
            }
          ]
        },
        {
          "role": "洛耶茨",
          "text": "总之…很好！问题突然解决了。"
        },
        {
          "role": "洛耶茨",
          "text": "那维莱特大人正在办公室内，似乎也没有其他访客。您请进吧。"
        },
        {
          "role": "旅行者",
          "text": "打扰了…"
        },
        {
          "role": "洛耶茨",
          "text": "您真是客气。我们就不耽误您和美露莘朋友们的时间了，只是有一点…"
        },
        {
          "role": "派蒙",
          "text": "哎？什么呀？"
        },
        {
          "role": "洛耶茨",
          "text": "在沫芒宫，尤其是办公室里，最好保持手中的物品不要高于头顶。"
        },
        {
          "role": "洛耶茨",
          "text": "各位同僚都是极其热心的人，难免会认为你们有特殊的请求要提。"
        },
        {
          "role": "芙洛",
          "text": "明白了。这个牌子是大家害怕在枫丹廷里走散才举起来作为标志用的，既然目的地已经到了，那么芙佳…"
        },
        {
          "role": "芙佳",
          "text": "好的姐姐，我马上收起来…"
        },
        {
          "role": "派蒙",
          "text": "原来是带路用的呀！"
        },
        {
          "role": "派蒙",
          "text": "没关系，有我和旅行者，大家绝对不会迷路的。来吧，那维莱特的办公室走这边…"
        },
        {
          "role": "洛耶茨",
          "text": "各位慢走啊，慢走。"
        },
        {
          "type": "subtitle",
          "text": "与芙佳对话，带美露莘们去见那维莱特"
        },
        {
          "role": "芙佳",
          "text": "那就麻烦你带我们去那维莱特大人的办公室啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "跟我走跟我走…",
              "dialogues": []
            },
            {
              "text": "稍等一下哦。",
              "dialogues": [
                {
                  "role": "芙佳",
                  "text": "没问题，等你哦！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "带美露莘们去见那维莱特"
        },
        {
          "role": "洛耶茨",
          "text": "和美露莘们交流总是会更累一些，用平常的办法不起效呢…"
        },
        {
          "role": "艾尤恩",
          "text": "我也有点…真想不明白为什么。"
        },
        {
          "role": "洛耶茨",
          "text": "嗯？"
        },
        {
          "role": "艾尤恩",
          "text": "您想啊，美露莘们善良又聪明，寿命也长得很，其实很适合做我们的工作，不是吗？"
        },
        {
          "role": "洛耶茨",
          "text": "艾尤恩啊…"
        },
        {
          "role": "洛耶茨",
          "text": "你刚刚已经把她们不适合做复律官的原因全讲出来了。"
        },
        {
          "role": "那维莱特",
          "text": "果然是你们…"
        },
        {
          "role": "那维莱特",
          "text": "我刚刚听到有美露莘说话的声音，就靠近窗口看了看…结果角度不对，什么也看不到。"
        },
        {
          "role": "那维莱特",
          "text": "…没遇到什么麻烦吧？"
        },
        {
          "role": "派蒙",
          "text": "没有没有！呃，算是没有吧…"
        },
        {
          "role": "？？？",
          "text": "和那维莱特简单说明了事情经过…"
        },
        {
          "role": "那维莱特",
          "text": "原来如此…"
        },
        {
          "role": "那维莱特",
          "text": "咳…洛梅，此事的确你有错在先。如果对其他人有请求，必须提前征求同意，并且不能影响他人的正常生活与工作。"
        },
        {
          "role": "那维莱特",
          "text": "尤其像采访这种事情，更要谨慎。"
        },
        {
          "role": "洛梅",
          "text": "抱歉，我明白了…"
        },
        {
          "role": "旅行者",
          "text": "《漂浮海獭报》急需改进。"
        },
        {
          "role": "那维莱特",
          "text": "什么报？"
        },
        {
          "role": "洛梅",
          "text": "请不要在意！我…我立刻去跟那两位先生道歉！"
        },
        {
          "role": "芙洛",
          "text": "道歉也要先礼貌地打招呼哦！"
        },
        {
          "role": "那维莱特",
          "text": "（嗯，这样就可以了吧…我真不擅长做说教工作啊…）"
        },
        {
          "role": "那维莱特",
          "text": "那么，言归正传。各位来找我是需要什么帮助吗？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿…这个嘛，还是请美露莘们自己来讲吧！"
        },
        {
          "role": "芙佳",
          "text": "呃…"
        },
        {
          "role": "芙佳",
          "text": "（糟糕，大家一直忙着做礼物，却没想过怎么送才能让那维莱特大人感受到惊喜！）"
        },
        {
          "role": "嘉莱娜",
          "text": "（这个时候要是真的有礼炮就好了，砰地一下一定很…不对不对，办公室里应该不能放礼炮吧？）"
        },
        {
          "role": "薇尔妲",
          "text": "（要是最开朗的洛梅在就好了…洛梅，现在才是最需要你的时候…！）"
        },
        {
          "role": "洛梅",
          "text": "我回来啦！两位先生都是很好的人，不仅没有责怪我，还请我喝了茶。"
        },
        {
          "role": "洛梅",
          "text": "咦，怎么衣服还没有送出去呀？我都喝过两杯啦。"
        },
        {
          "role": "芙洛",
          "text": "（啊！非常洒脱地说出来了！）"
        },
        {
          "role": "那维莱特",
          "text": "衣服？"
        },
        {
          "role": "派蒙",
          "text": "呃，啊…这个…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "事已至此。",
              "dialogues": []
            },
            {
              "text": "干脆给个痛快吧！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芙佳",
          "text": "嗯，旅行者说得对…"
        },
        {
          "role": "？？？",
          "text": "美露莘们你一嘴我一嘴地说明了「惊喜礼物」及其由来…"
        },
        {
          "role": "？？？",
          "text": "只是不知为何，送礼的和收礼的都略显局促。"
        },
        {
          "type": "subtitle",
          "text": "送美露莘们返回"
        },
        {
          "role": "洛梅",
          "text": "跟你们说哦，上次在杂志上看到…"
        },
        {
          "role": "嘉莱娜",
          "text": "欸？真的吗，不会是骗人的吧…"
        },
        {
          "role": "那维莱特",
          "text": "……"
        },
        {
          "role": "那维莱特",
          "text": "出来吧，是我。"
        },
        {
          "role": "珀西芙",
          "text": "那位来客，珀西芙！珀西芙！"
        },
        {
          "role": "派蒙",
          "text": "哇，是珀西芙！原来你和那维莱特认识？"
        },
        {
          "role": "那维莱特",
          "text": "「珀西芙」？原来你们是这么称呼她的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道传说中的「那位来客」就是…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "竟然是这个意思吗！想当初我可是思考了很久，差点晚上失眠…"
                }
              ]
            },
            {
              "text": "有机会讲给赛诺听。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "有道理，他一定会视作挑战的…"
                }
              ]
            }
          ]
        },
        {
          "role": "芙佳",
          "text": "你好…？"
        },
        {
          "role": "珀西芙",
          "text": "呜…美露莘…邦邦…"
        },
        {
          "role": "那维莱特",
          "text": "芙佳，我来介绍一下。这位就是帮助过你的龙蜥…呃，龙蜥姐姐。"
        },
        {
          "role": "芙佳",
          "text": "原来龙蜥能够变成美露莘的样子吗？真好，这样我们就能拉手啦！"
        },
        {
          "role": "芙佳",
          "text": "谢谢你救了我，我请你吃好吃的好不好？"
        },
        {
          "role": "珀西芙",
          "text": "汐…汐藻？"
        },
        {
          "role": "芙佳",
          "text": "嗯？嗯！汐藻！"
        },
        {
          "role": "珀西芙",
          "text": "汐藻！汐藻！汐藻汐藻！"
        },
        {
          "role": "芙洛",
          "text": "是很喜欢吃汐藻的意思吗？"
        },
        {
          "role": "薇尔妲",
          "text": "也就是说，你把自己最喜欢的食物送给了我们…哇，真的很感谢你。"
        },
        {
          "role": "那维莱特",
          "text": "谢谢你，珀西芙。"
        },
        {
          "role": "珀西芙",
          "text": "珀西芙！那位来客，邦邦！"
        },
        {
          "role": "芙洛",
          "text": "既然如此，大家不如一起在这里野餐吧？"
        },
        {
          "role": "洛梅",
          "text": "我来准备吃的！在沫芒宫给大家添了不少麻烦，该我将功补过啦。"
        },
        {
          "role": "芙佳",
          "text": "那我去给珀西芙准备汐藻！"
        },
        {
          "role": "？？？",
          "text": "大家忙活了一阵，一起享用了美味的食物。"
        },
        {
          "role": "？？？",
          "text": "虽然珀西芙几乎只吃了汐藻（并且吃光了），但能看出很开心的样子。"
        }
      ]
    }
  ]
}