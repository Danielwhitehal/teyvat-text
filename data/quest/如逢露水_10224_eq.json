{
  "quest_id": 10224,
  "chapter_num": "三川游艺绮梦谭·后夜",
  "chapter_title": "如逢露水",
  "type": "eq",
  "route": "As Though Kissed by Dew",
  "stories": [
    {
      "story_id": 40193,
      "title": "如逢露水",
      "description": "我知道这好梦，如露水般短暂，然而，然而。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与一斗对话"
        },
        {
          "role": "荒泷一斗",
          "text": "哦！挚友，听说你们昨晚去了「秋沙钱汤」对吧？"
        },
        {
          "role": "荒泷一斗",
          "text": "我打算叫上所有人，再去「秋沙钱汤」好好地庆上一回功！怎么样？你也去吧！"
        },
        {
          "role": "派蒙",
          "text": "欸，可是昨晚不是已经去过一次了吗…"
        },
        {
          "role": "荒泷一斗",
          "text": "呃…你看这不是还有昨晚没去成的吗？比如阿忍…五郎…还有绫人兄弟…"
        },
        {
          "role": "久岐忍",
          "text": "简单来说，是老大听说过后，自己很想去。"
        },
        {
          "role": "荒泷一斗",
          "text": "总…总之！你要是逛得差不多了，就来跟我说一声，大家一起去泡！温！泉！"
        },
        {
          "type": "subtitle",
          "text": "随一斗离开会场"
        },
        {
          "role": "荒泷一斗",
          "text": "怎么样？要出发了吗？要出发了吗！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要出发了！",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "好嘞！目标——「秋沙钱汤」！"
                }
              ]
            },
            {
              "text": "再等等…",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "你不会也跟阿晃他们一样沉迷游艺了吧…虽然游艺是很好玩，但先泡完温泉也不迟嘛！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往「秋沙钱汤」"
        },
        {
          "type": "subtitle",
          "text": "在一斗的连番催促下，众人再次前往秋沙钱汤…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG1.png|center|600px]]"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈！这里应该就是最热的了！今天我们就来比一比，谁能在温泉里坚持最久！"
        },
        {
          "role": "托马",
          "text": "呵呵，一斗兄如此盛情，我又怎么能不奉陪呢？"
        },
        {
          "role": "久岐忍",
          "text": "我说…这又不是在蒸桑拿…"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG2.png|center|600px]]"
        },
        {
          "role": "早柚",
          "text": "温泉…好暖和…呼呼…"
        },
        {
          "role": "派蒙",
          "text": "不、不要在浴池里睡着啊！"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG3.png|center|600px]]"
        },
        {
          "role": "五郎",
          "text": "唔…毛皮变得好重，感觉有点头晕…"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈！五郎兄弟！可别说这就不行了啊！"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG4.png|center|600px]]"
        },
        {
          "role": "九条裟罗",
          "text": "喂——浴场内禁止喧哗！"
        },
        {
          "type": "subtitle",
          "text": "与此同时，在另一边…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG5-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG5-空.png|center|600px]]"
        },
        {
          "role": "神里绫人",
          "text": "呵呵，一斗兄弟还是那么有精神啊。"
        },
        {
          "role": "神里绫华",
          "text": "兄长，对局中分神可不好哦。"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG6-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG6-空.png|center|600px]]"
        },
        {
          "role": "宵宫",
          "text": "嚯嚯——比赛已经来到了最焦灼的阶段！旅行者会怎么应对呢！两位大师！你们有什么看法？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯…如果是我的话，会考虑步步为营，巩固优势。"
        },
        {
          "role": "鹿野院平藏",
          "text": "唔，积极进攻，险中求胜…也是一个好办法。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（稳扎稳打…）",
              "dialogues": []
            },
            {
              "text": "（搏上一把！）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫人",
          "text": "哦？竟有如此妙手？看来我败局已定，不必继续了。那按照之前抽签的顺序，接下来就该轮到…"
        },
        {
          "type": "subtitle",
          "text": "稳扎稳打"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG7-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG7-空.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "搏上一把"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG9-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG9-空.png|center|600px]]"
        },
        {
          "role": "神里绫人",
          "text": "绫华，要玩得开心哦。"
        },
        {
          "type": "subtitle",
          "text": "稳扎稳打"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG8-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG8-空.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "搏上一把"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG10-荧.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "活动任务-如逢露水-CG10-空.png|center|600px]]"
        },
        {
          "role": "神里绫华",
          "text": "啊…好！好的！旅行者，请多指教…"
        },
        {
          "role": "旅行者",
          "text": "（绫人这家伙，怕不是想让绫华多玩一会儿故意输的吧…）"
        },
        {
          "role": "蓝川丞",
          "text": "老板！这「三川花祭」可真不错！这几天来我们这儿的游客数量，比平时翻了三倍啊！"
        },
        {
          "role": "蓝川丞",
          "text": "这个月的营业金额…恐怕能上这个数！"
        },
        {
          "role": "梦见月瑞希",
          "text": "很不错嘛，看来这个月，说不定能正面击败八重堂…"
        },
        {
          "role": "八重神子",
          "text": "什么事情这么高兴？怎么不叫上我？"
        },
        {
          "role": "梦见月瑞希",
          "text": "啊哈…也没什么…"
        },
        {
          "role": "八重神子",
          "text": "哦，我倒是有个好消息忘了跟你分享…"
        },
        {
          "role": "八重神子",
          "text": "「三川花祭」的三成收益，都会划到八重堂的账上哦。这个月应该能创纪录了吧？来恭喜我吧。"
        },
        {
          "role": "梦见月瑞希",
          "text": "什么——！"
        },
        {
          "role": "蓝川丞",
          "text": "那…那不如，恭喜老板在第三百三十三次挑战八重堂营收的尝试中，取得了亚军的好成绩！"
        },
        {
          "role": "八重神子",
          "text": "呵呵呵…"
        },
        {
          "role": "影",
          "text": "…祝愿今夜，人人皆得「好梦」。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（千织）"
        },
        {
          "role": "千织",
          "text": "嗯？好久不见，旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是从枫丹赶来的吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "千织",
          "text": "嗯，既属于妖也属于人的盛大祭典，即便我身在水之国度也有所耳闻。"
        },
        {
          "role": "千织",
          "text": "恰好绫华给我发了邀请，就试着回来看看了…稻妻如今的气氛，似乎比我出走时好了许多。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（绮良良）"
        },
        {
          "role": "绮良良",
          "text": "——「狛荷屋」，竭诚为您服务！…啊，原来是你呀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你这是在…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "绮良良",
          "text": "是「会场寄送服务」哟！你看，要是在摊位上抢购了一堆东西，背着逛祭典不是会非——常麻烦吗？"
        },
        {
          "role": "绮良良",
          "text": "这种时候，就安心把东西交给「狛荷屋」吧！我们会安安稳稳地将您的心爱之物护送到家！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（枫原万叶）"
        },
        {
          "role": "枫原万叶",
          "text": "「天也醉樱花，云脚乱蹒跚…」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "万叶没去玩游艺吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "枫原万叶",
          "text": "你们不是也被这里吸引了吗？虽是为祭典而来，但影向山的绯樱，也还是一如既往地引人驻足呢。"
        },
        {
          "role": "枫原万叶",
          "text": "游艺那边我打算花上几天慢慢感受。山在观山色，雨来听雨声…既然是来游玩的，自然得随性些？"
        }
      ],
      "collapse_ranges": [
        [
          74,
