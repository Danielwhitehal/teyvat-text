{
  "quest_id": 76512,
  "chapter_num": null,
  "chapter_title": "赛事终场，冠军落定",
  "type": "wq",
  "route": "Final Match Concludes, Champion Decided",
  "stories": [
    {
      "story_id": 76512,
      "title": "赛事终场，冠军落定",
      "description": "武艺比拼已然结束，是时候决定最后的冠军了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与万叶对话"
        },
        {
          "role": "枫原万叶",
          "text": "比试进行到现在，旅行者应该已经心中有数了。"
        },
        {
          "role": "泽西切",
          "text": "咳咳，让我回忆一下台词…"
        },
        {
          "role": "泽西切",
          "text": "精妙绝伦的比赛总算落下了帷幕，现在，到了公布比赛结果的环节。"
        },
        {
          "role": "泽西切",
          "text": "有请我们的最终试炼者旅行者，选出你心目中的冠军。"
        },
        {
          "role": "派蒙",
          "text": "这次是由旅行者来决定冠军？喔…还真是头一回，旅行者成了最关键的评委！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我选帅狗狗「咕咕丸」。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯嗯，我也觉得「咕咕丸」最厉害，有着「太郎丸」的风范！"
                },
                {
                  "role": "「咕咕丸」",
                  "text": "呜嗷！嗷！"
                },
                {
                  "role": "堇葵",
                  "text": "太棒了，「咕咕丸」！你的努力开花结果，得到了最华丽的回应！"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "意料之中的结果，恭喜两位稻妻朋友。"
                },
                {
                  "role": "「减七琶音」",
                  "text": "飒爽的忍犬先生的确很强，我支持。"
                }
              ]
            },
            {
              "text": "「缟玛瑙」的表现最突出。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "个子高高，拿大剑的愚人众…确实很难对付呢…"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "我？感谢你的认可，这是对我最大的鼓舞。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "大家打得都不赖，可能我更走运，对上了旅行者的节奏。"
                },
                {
                  "role": "「咕咕丸」",
                  "text": "嗷！"
                },
                {
                  "role": "堇葵",
                  "text": "看到了吗，「咕咕丸」？要好好向「缟玛瑙」学习哦。"
                },
                {
                  "role": "「减七琶音」",
                  "text": "不愧是斯捷潘尼扬中尉，瓦列里少校也会为你骄傲的。"
                }
              ]
            },
            {
              "text": "我认为冠军是「减七琶音」",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…说起来，和我们在枫丹较量过的礼帽愚人众，有一些就是这位小姐教导出来的？那确实厉害！"
                },
                {
                  "role": "「减七琶音」",
                  "text": "啊呀，这可真是承蒙厚爱…以后得多为旅行者准备豪华甜点才行了。"
                },
                {
                  "role": "「咕咕丸」",
                  "text": "咕？"
                },
                {
                  "role": "堇葵",
                  "text": "如果你也想吃布达诺娃小姐的蛋糕，那可得加油变强哦。"
                },
                {
                  "role": "「缟玛瑙」",
                  "text": "哎呀，到底是役人部队的老教官，拼不过，拼不过。"
                }
              ]
            }
          ]
        },
        {
          "role": "泽西切",
          "text": "虽说没有热闹的颁奖环节，但诸位注重实战，平日也低调行事。"
        },
        {
          "role": "泽西切",
          "text": "来自旅行者的认可，是挪德卡莱最高一级的荣耀，远超普普通通的镀金奖杯与勋章。"
        },
        {
          "role": "派蒙",
          "text": "哼哼~你们可能是全提瓦特头一回被旅行者这样颁奖的战士哦。"
        },
        {
          "role": "「缟玛瑙」",
          "text": "无需更多奖励点缀，我们已经尽兴了。"
        },
        {
          "role": "「缟玛瑙」",
          "text": "是吧，布达诺娃？"
        },
        {
          "role": "「减七琶音」",
          "text": "当然，下次不妨由我们役人部队出资，把比赛办得更热闹。"
        },
        {
          "role": "「减七琶音」",
          "text": "最好有着百人级别的初赛，这样，最后说不定会出现许多情报之外，且暂无归属的高人。"
        },
        {
          "role": "「缟玛瑙」",
          "text": "有道理。掷弹兵们也乐于赞助这种赛事，我会提前给瓦列里少校写好方案的。"
        },
        {
          "role": "堇葵",
          "text": "终末番也…呃…如果经费达到千万摩拉级，就不谈出钱的问题了，忍犬部队还会积极参与赛事的。"
        },
        {
          "role": "「咕咕丸」",
          "text": "呜…"
        },
        {
          "role": "枫原万叶",
          "text": "感谢各位的好意，我想，如果这类比拼有着个别强势的出资方，性质可能就变了。"
        },
        {
          "role": "枫原万叶",
          "text": "三位能否抵抗诱惑，不向名次靠前的强者抛出橄榄枝，招募那些自由之士？"
        },
        {
          "role": "派蒙",
          "text": "啊，万叶的意思难道是…"
        },
        {
          "role": "枫原万叶",
          "text": "正是因此，由相对中立的冒险家协会来承办，才是最佳的选择。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "比赛的性质的确要纯粹。",
              "dialogues": []
            },
            {
              "text": "确实不能加入其他目的哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯…我好像也明白了！那就由我派蒙来说难听的话——"
        },
        {
          "role": "派蒙",
          "text": "虽然这次，两位愚人众的参赛选手都很礼貌，但你们有些同事特别凶，一见我们就直接开打。"
        },
        {
          "role": "派蒙",
          "text": "要是愚人众来当比赛的股东，你们肯定会招募名次靠前的选手，那不就成了…我们帮你们物色高手，来揍我们自己了吗？"
        },
        {
          "role": "「缟玛瑙」",
          "text": "哈哈，被看穿了…"
        },
        {
          "role": "「缟玛瑙」",
          "text": "理解你们的说法，但我也不能替别人做承诺。"
        },
        {
          "role": "「缟玛瑙」",
          "text": "不同的部队有不同的任务和做派，我这个小小的尉官的话，什么都不算。"
        },
        {
          "role": "「减七琶音」",
          "text": "枫原先生说得在理， 旅行者和派蒙向导的担忧也很现实。"
        },
        {
          "role": "堇葵",
          "text": "好了，你们两个就别打鬼主意了，只要像「咕咕丸」一样，享受纯粹的战斗就行！"
        },
        {
          "role": "「咕咕丸」",
          "text": "嗷！呜嗷！"
        },
        {
          "role": "「缟玛瑙」",
          "text": "说得也是，作为最基层的战士，没必要多想长官们才该操心的杂务，打得尽兴才是关键。"
        },
        {
          "role": "「缟玛瑙」",
          "text": "下次再比拼时，我一定会拿出更强的技巧！"
        },
        {
          "role": "「减七琶音」",
          "text": "而我…会为你们每位都带足蛋糕~"
        },
        {
          "type": "subtitle",
          "text": "额外对话（泽西切）"
        },
        {
          "role": "泽西切",
          "text": "这次得到的情报满满当当，就当商业的礼尚往来，回赠「秘闻馆」好了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还想复盘…",
              "dialogues": [
                {
                  "role": "泽西切",
                  "text": "要回忆之前战斗的细节吗？那请便。"
                }
              ]
            },
            {
              "text": "对奈芙尔有利，我支持！",
              "dialogues": [
                {
                  "role": "泽西切",
                  "text": "其实奈芙尔小姐之前也提供过很关键的情报，帮过我所属的执灯人小队很多次…算我欠「秘闻馆」的。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（枫原万叶）"
        },
        {
          "role": "枫原万叶",
          "text": "这次挪德卡莱之旅令我相当欣喜，除去别致的自然风光，别开生面的武艺对决，也给了我独到的启示。"
        },
        {
          "role": "枫原万叶",
          "text": "你的加入，则让比拼中可以深思的细节骤增数倍，值得用几篇旅记来记述…"
        },
        {
          "role": "枫原万叶",
          "text": "我差不多要动身回「南十字」船队了，等到旅记写完，再请你拨冗一阅。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "以后也要这样多多合作。",
              "dialogues": []
            },
            {
              "text": "下回可以一起到处游览。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "枫原万叶",
          "text": "嗯，这类机会还有不少，期待下次与你再见。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（堇葵&「咕咕丸」）"
        },
        {
          "role": "「咕咕丸」",
          "text": "嗷嗷！嗷嗷！"
        },
        {
          "role": "堇葵",
          "text": "看来「咕咕丸」打了个痛快。"
        },
        {
          "role": "堇葵",
          "text": "由衷感谢您的赐教，希望以后还能得到您的指导。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「减七琶音」）"
        },
        {
          "role": "「减七琶音」",
          "text": "哎呀，比赛结果让大家都很满意，我也要回去继续上班了。"
        },
        {
          "role": "「减七琶音」",
          "text": "世事无常，谁也说不准将来会发生的事…或许哪天，您有了自己的队伍，我也被愚人众解雇了…就来投奔您？"
        },
        {
          "role": "「减七琶音」",
          "text": "到时候，还请别嫌弃我太弱。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「缟玛瑙」）"
        },
        {
          "role": "「缟玛瑙」",
          "text": "这下，我可以和战友们说，我跟旅行者痛痛快快打了一场，让他们羡慕到抱头嚎叫…"
        },
        {
          "role": "「缟玛瑙」",
          "text": "假设以后有幸在至冬再见，还想和你切磋一番。"
        }
      ],
      "collapse_ranges": [
