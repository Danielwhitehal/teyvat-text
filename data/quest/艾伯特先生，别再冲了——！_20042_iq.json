{
  "quest_id": 20042,
  "chapter_num": null,
  "chapter_title": "艾伯特先生，别再冲了——！",
  "type": "iq",
  "route": "Stop, Albert. Stop!",
  "stories": [
    {
      "story_id": 20042,
      "title": "艾伯特先生，别再冲了——！",
      "description": "有可疑的人在教堂周围徘徊，维多利亚修女正在寻找愿意处理这件事的人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与维多利亚对话"
        },
        {
          "role": "维多利亚",
          "text": "…真是麻烦，到底躲哪去了？"
        },
        {
          "role": "旅行者",
          "text": "你在找什么？"
        },
        {
          "role": "维多利亚",
          "text": "找？哦…我正在找一个可疑的家伙。"
        },
        {
          "role": "维多利亚",
          "text": "那个叫艾伯特的男人，白天一直鬼鬼祟祟地在教堂边上打转。"
        },
        {
          "role": "维多利亚",
          "text": "看着就不怀好意，我担心他在预谋什么可怕的事。"
        },
        {
          "role": "维多利亚",
          "text": "你能去把艾伯特赶走吗？"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "维多利亚",
          "text": "风神保佑您。"
        },
        {
          "role": "旅行者",
          "text": "要直接找西风骑士团吗？"
        },
        {
          "role": "维多利亚",
          "text": "我也想过这样做。"
        },
        {
          "role": "维多利亚",
          "text": "但我没有他什么直接的把柄，西风骑士团也介入不了…"
        },
        {
          "role": "维多利亚",
          "text": "风神在上，请你快点去把他赶走吧。"
        },
        {
          "type": "subtitle",
          "text": "在教堂附近找到艾伯特"
        },
        {
          "role": "旅行者",
          "text": "好吧…"
        },
        {
          "role": "艾伯特",
          "text": "那就拜托你了，冲吧！"
        },
        {
          "role": "旅行者",
          "text": "为了让你赶紧离开…"
        },
        {
          "role": "艾伯特",
          "text": "喂，都说了我做的不是坏事啊！"
        },
        {
          "role": "艾伯特",
          "text": "好了，等落叶打扫完之后，我就会离开了。"
        },
        {
          "role": "旅行者",
          "text": "西风骑士团会来打扫一切的。"
        },
        {
          "role": "艾伯特",
          "text": "这是在做好事！别动不动通知骑士团啊！"
        },
        {
          "role": "艾伯特",
          "text": "怕了你了，好啦好啦我知道了，打扫完落叶之后我就会走了…"
        },
        {
          "type": "subtitle",
          "text": "清扫落叶堆"
        },
        {
          "type": "subtitle",
          "text": "与艾伯特对话"
        },
        {
          "role": "艾伯特",
          "text": "芭芭拉冲呀！"
        },
        {
          "role": "艾伯特",
          "text": "咳，你找我有事情吗？"
        },
        {
          "role": "艾伯特",
          "text": "落叶都扫除掉了吗？"
        },
        {
          "role": "旅行者",
          "text": "全部扫除了。"
        },
        {
          "role": "艾伯特",
          "text": "辛苦了，教堂一下子就干净了很多，这样子芭芭拉小姐也会轻松不少吧…"
        },
        {
          "role": "艾伯特",
          "text": "对了，你可别告诉芭芭拉小姐啊。"
        },
        {
          "role": "艾伯特",
          "text": "本来我是想帮她分忧的，可别反而让她困扰了。"
        },
        {
          "role": "艾伯特",
          "text": "放心啦，按照我们说好的，我现在就离开。"
        },
        {
          "role": "艾伯特",
          "text": "再见了…不对，我们下次再见。"
        },
        {
          "type": "subtitle",
          "text": "到教堂内向维多利亚报告"
        },
        {
          "role": "艾伯特",
          "text": "为了蒙德城，和芭芭拉小姐，要认真打扫落叶！"
        },
        {
          "role": "维多利亚",
          "text": "关于艾伯特先生…"
        },
        {
          "role": "维多利亚",
          "text": "艾伯特离开了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经走了。"
        },
        {
          "role": "维多利亚",
          "text": "总算解决了…你刚才为什么去清除落叶了？"
        },
        {
          "role": "维多利亚",
          "text": "算了，这样也好，免得那个艾伯特又找到了借口，借着清除落叶来接近教堂。"
        },
        {
          "role": "维多利亚",
          "text": "这些是给你的谢礼，收下吧，愿风神保佑你。"
        },
        {
          "role": "维多利亚",
          "text": "没什么事的话，我要继续工作了，你也去忙自己的吧。"
        }
      ]
    }
  ]
}