{
  "quest_id": 10062,
  "chapter_num": "炽魂斗士的雪界之旅 其三",
  "chapter_title": "冲！冲！菲耶蒂娜！",
  "type": "eq",
  "route": "Go, Fietena, Go!",
  "stories": [
    {
      "story_id": 40220,
      "title": "冲！冲！菲耶蒂娜！",
      "description": "现在该为梦想而奔跑了，拼尽全力吧！",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到第二天的早上8点"
        },
        {
          "type": "subtitle",
          "text": "前往越野赛场地"
        },
        {
          "role": "派蒙",
          "text": "马上比赛就要开始了，大家准备得怎么样？我们一路过来看到好多人。"
        },
        {
          "role": "爱拉尼",
          "text": "我准备好了毛巾、热汤还有保暖的毛毯，嗯…应该已经不缺什么了吧。"
        },
        {
          "role": "爱拉尼",
          "text": "按我们之前商量好的安排，队长她们现在应该正在热身。"
        },
        {
          "role": "爱拉尼",
          "text": "等大家正式开跑之后，我就去终点守着，随时准备递上水和毛毯。"
        },
        {
          "role": "明妮",
          "text": "我刚从家里过来，比赛很快就要开始了，大家的热身还没结束吗？"
        },
        {
          "role": "爱拉尼",
          "text": "的确是有点久了啊…"
        },
        {
          "role": "派蒙",
          "text": "按理说，瓦雷莎和希诺宁都不是拖拉的人呀…我们过去看看情况好了。"
        },
        {
          "role": "明妮",
          "text": "那就拜托你们了。"
        },
        {
          "type": "subtitle",
          "text": "前往特战队的营地"
        },
        {
          "role": "派蒙",
          "text": "欸，瓦雷莎她们终于从帐篷里出来了。"
        },
        {
          "role": "派蒙",
          "text": "大家怎么了，一脸沉重的样子？"
        },
        {
          "role": "希诺宁",
          "text": "义刚发烧了。"
        },
        {
          "role": "瓦雷莎",
          "text": "呜…怪我没有留心…之前听到义刚打喷嚏，问了他几次，他总是说自己没事。"
        },
        {
          "role": "希诺宁",
          "text": "他一定是不想影响比赛才硬撑着，直到今天发现自己发了烧，完全没力气动弹。"
        },
        {
          "role": "瓦雷莎",
          "text": "我们跟组委会联系过了，药品和保暖方面目前都跟上了，他们还派了专人看护，不用太过担心。"
        },
        {
          "role": "派蒙",
          "text": "可是…马上就要比赛了吧？这下是不是直接少了一位参赛队员…"
        },
        {
          "role": "瓦雷莎",
          "text": "是啊，怎么办呢…"
        },
        {
          "role": "瓦雷莎",
          "text": "这个比赛对大家都很重要，更何况明妮的父母也在终点看着…除非…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我上吧。",
              "dialogues": []
            },
            {
              "text": "我试试看？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "我们想过。毕竟大家一起训练过，你了解赛道，身体素质和户外经验也都足够…"
        },
        {
          "role": "希诺宁",
          "text": "但在这种时候拉你入伙，就像紧要关头给你派了个不可推脱的工作，让人不太忍心。"
        },
        {
          "role": "瓦雷莎",
          "text": "最重要的是，旅行者你愿意吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "比赛对明妮很重要吧。",
              "dialogues": []
            },
            {
              "text": "不能让大家白来蒙德。",
              "dialogues": []
            },
            {
              "text": "「炽魂斗士不会轻言放弃。」",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瓦雷莎",
          "text": "呜…不愧是「杜麦尼」，不管到了哪里，你都是我们的英雄，骄傲和希望！"
        },
        {
          "role": "希诺宁",
          "text": "好了，时间有限，晚点再感动。"
        },
        {
          "role": "希诺宁",
          "text": "简单说明一下，我们四个的接力顺序是：我、旅行者、瓦雷莎，最后是明妮。"
        },
        {
          "role": "希诺宁",
          "text": "你的越野路线是一段上坡路，记得保留体力，不要一口气冲太猛。"
        },
        {
          "role": "希诺宁",
          "text": "和我交接后，沿指示向前跑，瓦雷莎会在神像处等你。"
        },
        {
          "role": "瓦雷莎",
          "text": "嗯！我们一定可以的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "明白了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "那我们就出发吧，去起跑线。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（汤义刚）"
        },
        {
          "role": "昏睡的义刚",
          "text": "（发烧中的病人正在昏睡，比赛迫在眉睫，还是先跟大家一起前往赛场吧。）"
        },
        {
          "type": "subtitle",
          "text": "前往赛道起点"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备比赛",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "等待比赛开始"
        },
        {
          "role": "杜拉夫",
          "text": "各位选手，各位观众，大家好！"
        },
        {
          "role": "杜拉夫",
          "text": "我，杜拉夫，受组委会任命，担任本次龙脊雪山国际越野赛的裁判。"
        },
        {
          "role": "杜拉夫",
          "text": "希望各支队伍在遵守比赛规则的同时，超越自我，跑出好成绩。"
        },
        {
          "role": "杜拉夫",
          "text": "同时也提醒大家，雪山地形崎岖，为了防止意外，大家应当尽量保持在赛道上行走。"
        },
        {
          "role": "杜拉夫",
          "text": "组委会已经提前清理过赛道，但雪山环境复杂，赛道之外依然会有危险。"
        },
        {
          "role": "杜拉夫",
          "text": "选手们注意：一旦身体不适，无法坚持跑完全程，或者意外受伤，请到赛道一侧休息。组委会工作人员会尽快赶到并救助伤者。"
        },
        {
          "role": "明妮",
          "text": "队长，义刚呢，怎么没看到他？这马上就要开跑了呀。"
        },
        {
          "role": "希诺宁",
          "text": "明妮，义刚发烧了，现在人还昏着，没法来参赛了。"
        },
        {
          "role": "明妮",
          "text": "什么？怎么会？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别担心，有我。",
              "dialogues": []
            },
            {
              "text": "我来跑义刚这段。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "放轻松，明妮，他很强的，有我们在你们说不定能拿到第一名呢。"
        },
        {
          "role": "明妮",
          "text": "我…我放心，谢谢你们帮忙！"
        },
        {
          "role": "杜拉夫",
          "text": "…接下来，由我来介绍各支参赛队伍："
        },
        {
          "role": "杜拉夫",
          "text": "来自须弥的「沙之行者」，来自稻妻的「飞雷稻光」。"
        },
        {
          "role": "杜拉夫",
          "text": "来自璃月的「夕阳」，以及枫丹的「灰手」。"
        },
        {
          "role": "杜拉夫",
          "text": "由冒险家组成的队伍「向山」，还有清泉镇镇民们组成的队伍「神行猎手」。"
        },
        {
          "role": "杜拉夫",
          "text": "最后，由各国参赛者组成的混合队伍——「炽魂斗士」。"
        },
        {
          "role": "派蒙",
          "text": "其他队伍的选手看起来都很厉害啊。"
        },
        {
          "role": "瓦雷莎",
          "text": "不要慌，不要紧张！现在该想想菲耶蒂娜了，各位，拿出勇气来！"
        },
        {
          "role": "瓦雷莎",
          "text": "有我们在一起，什么阻碍都能翻越！翻不过去的就用冲撞顶开！"
        },
        {
          "role": "希诺宁",
          "text": "不是谁都像你…算了，我同意，这种时候可不能说丧气话。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看我的吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "明妮",
          "text": "我也会努力，相信大家，相信自己！"
        },
        {
          "role": "杜拉夫",
          "text": "接下来，请选手们各就位。"
        },
        {
          "role": "杜拉夫",
          "text": "准备，开跑！"
        },
        {
          "type": "subtitle",
          "text": "冲！希诺宁！冲！"
        },
        {
          "type": "subtitle",
          "text": "你们的目标是冠军，请努力超过其他选手吧！\n使用希诺宁的元素战技可快速移动！",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "路人语音"
        },
        {
          "type": "subtitle",
          "text": "加油啊！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "落后太多时"
        },
        {
          "type": "subtitle",
          "text": "很遗憾，已落后前列选手较远距离。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "希诺宁",
          "text": "气温降低了…啊，好冷。"
        },
        {
          "type": "subtitle",
          "text": "补给点语音"
        },
        {
          "type": "subtitle",
          "text": "来这里补充体力！",
          "narration": true
        },
        {
          "role": "希诺宁",
          "text": "旅行者就在前面了，赶快和他接力。"
        },
        {
          "type": "subtitle",
          "text": "补给点语音"
        },
        {
          "type": "subtitle",
          "text": "看着点路！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与旅行者交接棒"
        },
        {
          "role": "希诺宁",
          "text": "旅行者！我来了！"
        },
        {
          "role": "旅行者",
          "text": "好，交给我吧！"
        },
        {
          "type": "subtitle",
          "text": "冲！旅行者！冲！"
        },
        {
          "role": "旅行者",
          "text": "记得这一段都是上坡路，注意保持速度。"
        },
        {
          "type": "subtitle",
          "text": "路人语音"
        },
        {
          "type": "subtitle",
          "text": "好样的！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "补给点语音"
        },
        {
          "type": "subtitle",
          "text": "坚持住！",
          "narration": true
        },
        {
          "role": "旅行者",
          "text": "瓦雷莎应该就在神像那里等我，加油。"
        },
        {
          "type": "subtitle",
          "text": "与瓦雷莎交接棒"
        },
        {
          "role": "旅行者",
          "text": "呼，瓦雷莎，我跑完了。"
        },
        {
          "role": "瓦雷莎",
          "text": "谢谢你，旅行者，接下来该我上了！"
        },
        {
          "type": "subtitle",
          "text": "冲！瓦雷莎！冲！"
        },
        {
          "role": "瓦雷莎",
          "text": "这里绕路太浪费时间，就从缺口处跳下去吧。"
        },
        {
          "role": "瓦雷莎",
          "text": "这里是下坡，一口气冲下去，明妮就在前面了！"
        },
        {
          "type": "subtitle",
          "text": "路人语音"
        },
        {
          "type": "subtitle",
          "text": "嘿，这速度！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与明妮交接棒"
        },
        {
          "role": "瓦雷莎",
          "text": "明妮！接下来就交给你了，我会在后面跟着的！"
        },
        {
          "role": "明妮",
          "text": "好，我来最后冲刺。"
        },
        {
          "type": "subtitle",
          "text": "跟随明妮"
        },
        {
          "type": "subtitle",
          "text": "离明妮太远时"
        },
        {
          "type": "subtitle",
          "text": "请跟上明妮。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "你与明妮间的距离过远。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "明妮",
          "text": "有魔物！幸好不在赛道上，离它们远些就好。"
        },
        {
          "role": "明妮",
          "text": "大家提前到赛道边等我了吗？我来了。"
        },
        {
          "role": "稻妻选手",
          "text": "…不行…没力气了，路要看不清了。是往这里跑吧…"
        },
        {
          "role": "稻妻选手",
          "text": "不对，这不是赛道！"
        },
        {
          "role": "稻妻选手",
          "text": "啊，别过来。"
        },
        {
          "role": "希诺宁",
          "text": "糟了！"
        },
        {
          "role": "晕头转向的稻妻选手",
          "text": "…救命！"
        },
        {
          "role": "明妮",
          "text": "没关系…我可以继续…名次，我一定要拿到。"
        },
        {
          "role": "明妮",
          "text": "我不想拖大家的后腿。"
        },
        {
          "role": "瓦雷莎",
          "text": "我相信你，明妮。"
        },
        {
          "role": "希诺宁",
          "text": "我也相信你。"
        },
        {
          "role": "旅行者",
          "text": "我来帮你了。"
        },
        {
          "role": "明妮",
          "text": "我知道我应该继续向前，但是抱歉，我没办法视而不见。"
        },
        {
          "role": "明妮",
          "text": "快到我这里来！"
        },
        {
          "role": "希诺宁",
          "text": "面对受伤的人，怎么可能放着不管。瓦雷莎！旅行者！"
        },
        {
          "role": "瓦雷莎",
          "text": "当然！"
        },
        {
          "role": "瓦雷莎",
          "text": "明妮先带伤员往终点走，接下来的交给我们。"
        },
        {
          "type": "subtitle",
          "text": "消灭伤人魔物"
        },
        {
          "role": "安柏",
          "text": "怎么回事，有选手受伤了吗？"
        },
        {
          "role": "瓦雷莎",
          "text": "安柏小姐，出意外了！"
        },
        {
          "role": "安柏",
          "text": "明白了，我来支援！"
        },
        {
          "role": "瓦雷莎",
          "text": "这个坏家伙就由我们赶走。"
        },
        {
          "role": "希诺宁",
          "text": "旅行者，我们一起！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|丘丘霜铠王|1}}{{图标|冰箭丘丘人|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "向队友了解比赛结果"
        },
        {
          "role": "爱拉尼",
          "text": "别自责了，明妮，这不能怪你。"
        },
        {
          "role": "汤义刚",
          "text": "你已经做得很好了…咳。"
        },
        {
          "role": "明妮",
          "text": "义刚，不用安慰我了。你身体要紧，强撑着过来已经很不容易了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "比赛结果怎么样？",
              "dialogues": []
            },
            {
              "text": "明妮身体怎么样？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "旅行者…"
        },
        {
          "role": "明妮",
          "text": "我来吧。抱歉，荣誉骑士，我带着伤员走到终点的时候，其他队伍的选手都已经跑完很久了。"
        },
        {
          "role": "明妮",
          "text": "救生员已经把人带走检查了，我们队…没有拿到一个像样的成绩，对不起。"
        },
        {
          "role": "明妮",
          "text": "明明你们在前面跑得那么快，却因为我被拖累了。"
        },
        {
          "role": "希诺宁",
          "text": "明妮…"
        },
        {
          "role": "明妮",
          "text": "看到那个人受伤的时候，其实我很犹豫。"
        },
        {
          "role": "明妮",
          "text": "大家已经努力了这么多天，如果我没有回去拉他的话，我们的成绩就不是现在这样。"
        },
        {
          "role": "明妮",
          "text": "救生员和安柏小姐就在附近，你们也离得不远，如果我不去拉他，他也不会有生命危险。"
        },
        {
          "role": "明妮",
          "text": "但我没办法忍住…"
        },
        {
          "role": "瓦雷莎",
          "text": "没关系的，明妮，我们明白。"
        },
        {
          "role": "瓦雷莎",
          "text": "面对受伤的人，怎么可能置之不理呢？"
        },
        {
          "role": "瓦雷莎",
          "text": "「是炽魂斗士的话，一定会握上那双渴求帮助的手。」"
        },
        {
          "role": "爱拉尼",
          "text": "欸，这句话的出处是哪里？"
        },
        {
          "role": "瓦雷莎",
          "text": "是我刚编的，嘿嘿…"
        },
        {
          "role": "明妮",
          "text": "…队长，谢谢你。"
        },
        {
          "role": "雪琳",
          "text": "明妮！"
        },
        {
          "role": "雪琳",
          "text": "还好没出大事，刚才吓死我了。"
        },
        {
          "role": "莫里茨",
          "text": "孩子，什么东西都没你的生命重要…"
        },
        {
          "role": "雪琳",
          "text": "下次别这样吓唬我们了。"
        },
        {
          "role": "明妮",
          "text": "爸爸妈妈，对不起…"
        },
        {
          "type": "subtitle",
          "text": "因为一个小小插曲，你们并没有获得理想的成绩。虽然有些不甘心，但现实就是这样，汗水未必能浇灌出花朵。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "不过你们的欢笑与付出都真实地存在过，在未来某一天它或许可以结出别的成果。\n明妮的表情有些苦涩，但也有些释然。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "杜拉夫",
          "text": "明妮选手，你的身体怎么样？"
        },
        {
          "role": "明妮",
          "text": "啊，裁判先生，我还好，没什么问题。"
        },
        {
          "role": "明妮",
          "text": "…您是刚才的…"
        },
        {
          "role": "谦三",
          "text": "您好，我是「飞雷稻光」队的谦三，受您关照我没受什么大伤，非常感谢。"
        },
        {
          "role": "杜拉夫",
          "text": "几位，「飞雷稻光」全队和我们组委会协商了一下。"
        },
        {
          "role": "杜拉夫",
          "text": "明妮选手回身救助他人的行为值得赞赏，组委会一致认为如果不是这个意外，你们的成绩会更好。"
        },
        {
          "role": "杜拉夫",
          "text": "目前，「炽魂斗士」队的排名不足以拿到奖牌，但我们评估之后认为你们应当获得一项荣誉。"
        },
        {
          "role": "杜拉夫",
          "text": "在前几名的奖牌之外，组委会将为你们颁发一块特别奖牌，鼓励你们以生命为先的行动。"
        },
        {
          "role": "明妮",
          "text": "谢谢你，杜拉夫叔叔。爸爸，妈妈，我会按照约定的…"
        },
        {
          "role": "莫里茨",
          "text": "行，那就按照我们之间的约定来吧。"
        },
        {
          "role": "莫里茨",
          "text": "…在保证安全的情况下，你可以去外面旅行了，明妮。"
        },
        {
          "role": "明妮",
          "text": "欸？爸爸，但是我…"
        },
        {
          "role": "莫里茨",
          "text": "在我看来，你已经拿到一个足够好的「名次」了。"
        },
        {
          "role": "雪琳",
          "text": "呵呵，是啊。喏，还有奖牌为证呢。"
        },
        {
          "role": "莫里茨",
          "text": "依我看，不如我们全家一起出去旅游一趟吧，就去你最喜欢的八重堂。"
        },
        {
          "role": "莫里茨",
          "text": "我倒要看看，能不能找到适合你老爸老妈看的漫画。"
