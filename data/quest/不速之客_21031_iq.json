{
  "quest_id": 21031,
  "chapter_num": null,
  "chapter_title": "不速之客",
  "type": "iq",
  "route": "Uninvited Guests",
  "stories": [
    {
      "story_id": 21031,
      "title": "不速之客",
      "description": "望舒客栈的淮安似乎正在为某事发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与淮安对话"
        },
        {
          "role": "淮安",
          "text": "哎哟…还是得想个办法…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "淮安",
          "text": "是您啊，唉…别提了。"
        },
        {
          "role": "淮安",
          "text": "最近客栈的生意越来越好，来店里住的人也越来越多。"
        },
        {
          "role": "淮安",
          "text": "有的一个人过来找清净，有的拖家带口过来旅游。"
        },
        {
          "role": "淮安",
          "text": "唉，虽然客栈生意好我很高兴，但这周围有很多魔物徘徊。"
        },
        {
          "role": "淮安",
          "text": "如果有哪个小朋友跑出去玩，或者是哪位老人出去散步的时候遇见那群魔物的话…"
        },
        {
          "role": "淮安",
          "text": "为了防止这种事发生，我得出去驱赶一下客栈周围的魔物。"
        },
        {
          "role": "淮安",
          "text": "但我一个人，也驱赶不了多少魔物…"
        },
        {
          "role": "淮安",
          "text": "旅行者，你能帮我一把吗？报酬肯定不会少你的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "你的身手应该不错。",
              "dialogues": [
                {
                  "role": "淮安",
                  "text": "我？这个…您谬赞，算是过得去吧。"
                },
                {
                  "role": "淮安",
                  "text": "但是就凭我一个人，也不可能把那些魔物全部都打倒…"
                }
              ]
            }
          ]
        },
        {
          "role": "淮安",
          "text": "那就拜托您了。我之前就注意到了几处魔物的营地，里面有不少危险的魔物。"
        },
        {
          "role": "淮安",
          "text": "而且，还有另外一群魔物偷偷摸到了客栈附近，还扎起了营…"
        },
        {
          "role": "淮安",
          "text": "唔…"
        },
        {
          "role": "淮安",
          "text": "这样吧，那些危险的魔物就交给我了，您帮我处理一下那些客栈周围的魔物就好。"
        },
        {
          "role": "淮安",
          "text": "把那些魔物赶走之后，我们再来客栈里碰头。"
        },
        {
          "role": "淮安",
          "text": "这些魔物，真是够烦人的…"
        },
        {
          "type": "subtitle",
          "text": "前往魔物营地，并打倒所有魔物"
        },
        {
          "role": "派蒙",
          "text": "完全没什么线索呢…到底是谁打倒的这些魔物，难道…是哪位冒险家？"
        },
        {
          "role": "派蒙",
          "text": "唔…好在意啊…"
        },
        {
          "role": "派蒙",
          "text": "不过，既然这些魔物已经被打倒了，现在回去告诉淮安这个消息也行。"
        },
        {
          "type": "subtitle",
          "text": "在四周搜索"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "魈",
          "text": "…是你啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你怎么在这？",
              "dialogues": []
            },
            {
              "text": "那些魔物是你…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "魈",
          "text": "路遇魔物，便随手处理了。"
        },
        {
          "role": "魈",
          "text": "这一带不太安宁，你…"
        },
        {
          "role": "旅行者",
          "text": "我会多加小心。"
        },
        {
          "role": "魈",
          "text": "好。我另有要事，先行一步。"
        },
        {
          "type": "subtitle",
          "text": "向淮安回报"
        },
        {
          "role": "淮安",
          "text": "你们回来了，哎哟…那些魔物真是难对付…"
        },
        {
          "role": "旅行者",
          "text": "你把那些魔物都打倒了？"
        },
        {
          "role": "淮安",
          "text": "哈哈哈，是的，颇费了一番功夫，年纪大了终归是有些力不从心啊。"
        },
        {
          "role": "淮安",
          "text": "您应该也已经把那些魔物都解决掉了吧？"
        },
        {
          "role": "旅行者",
          "text": "关于魔物营地…"
        },
        {
          "role": "淮安",
          "text": "魔物全都被打倒了…但是营地里却没有人影？"
        },
        {
          "role": "淮安",
          "text": "这倒是怪了，难道是哪位路过的冒险家，顺手打倒了那些魔物？"
        },
        {
          "role": "淮安",
          "text": "总之，还是谢谢您帮我去周围巡查，这些报酬请您收下。"
        },
        {
          "type": "subtitle",
          "text": "向淮安回报"
        },
        {
          "role": "淮安",
          "text": "你们回来了，哎哟…那些魔物真是难对付…"
        },
        {
          "role": "旅行者",
          "text": "你把那些魔物都打倒了？"
        },
        {
          "role": "淮安",
          "text": "哈哈哈，是的，颇费了一番功夫，年纪大了终归是有些力不从心啊。"
        },
        {
          "role": "淮安",
          "text": "您应该也已经把那些魔物都解决掉了吧？"
        },
        {
          "role": "旅行者",
          "text": "关于魈…"
        },
        {
          "role": "淮安",
          "text": "那位小爷居然…不过，他为什么…"
        },
        {
          "role": "淮安",
          "text": "算了，我还是别去揣测那位小爷的意思了。"
        },
        {
          "role": "淮安",
          "text": "总之，还是谢谢您帮我去周围巡查，这些报酬请您收下。"
        }
      ]
    }
  ]
}