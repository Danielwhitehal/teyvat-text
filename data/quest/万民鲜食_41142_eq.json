{
  "quest_id": 41142,
  "chapter_num": null,
  "chapter_title": "万民鲜食",
  "type": "eq",
  "route": "Wanmin Fresh",
  "stories": [
    {
      "story_id": 41142,
      "title": "万民鲜食",
      "description": "璃月港的万民堂里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "卯师傅",
          "text": "行吧，我再去找别人帮忙…"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "卯师傅",
          "text": "那就麻烦你了，实在帮大忙了。"
        },
        {
          "role": "卯师傅",
          "text": "拿好了，就是这份珍珠翡翠白玉汤，送的时候记得当心点，别被撞翻了，也千万别用风之翼，不然弄洒了都不知道。"
        },
        {
          "role": "卯师傅",
          "text": "还有就是，别沾了奇怪的东西。不然可能串了味道…"
        },
        {
          "role": "卯师傅",
          "text": "好了，快点把这菜送过去吧，凉了就不好了。"
        },
        {
          "role": "寡言的廷方",
          "text": "还没送到…真是太慢了。"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "卯师傅",
          "text": "对，是有一份。早些时候，一个叫廷方的客人在我这点了一份珍珠翡翠白玉汤，预付好了钱，要我过一会送到遁玉陵去。"
        },
        {
          "role": "卯师傅",
          "text": "我还得在这照顾店面，实在是没空给他送过去，你如果愿意帮忙的话，那就太好了。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "寡言的廷方",
          "text": "多谢。"
        },
        {
          "role": "寡言的廷方",
          "text": "……"
        },
        {
          "role": "寡言的廷方",
          "text": "厨子的手艺，不错。"
        }
      ]
    }
  ]
}