      "description": "伽拉蒂雅需要10瓶盐。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将10瓶盐交给伽拉蒂雅"
        },
        {
          "role": "旅行者",
          "text": "关于盐…"
        },
        {
          "role": "伽拉蒂雅",
          "text": "你好，你是来讨论食盐供应的事情的吗？"
        },
        {
          "role": "伽拉蒂雅",
          "text": "那你一定已经准备好了足够多的盐吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
