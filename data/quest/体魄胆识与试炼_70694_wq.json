{
  "quest_id": 70694,
  "chapter_num": null,
  "chapter_title": "体魄胆识与试炼",
  "type": "wq",
  "route": "Strength, Courage, and Trials",
  "stories": [
    {
      "story_id": 70694,
      "title": "体魄胆识与试炼",
      "description": "来自「沃陆之邦」的「邦邦滚石」似乎正和你的老朋友计划着什么热血的活动…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与「邦邦滚石」对话"
        },
        {
          "role": "宵宫",
          "text": "邦邦小姐，腰还疼吗？"
        },
        {
          "role": "「邦邦滚石」",
          "text": "目前没事了…热敷当真见效快！"
        },
        {
          "role": "宵宫",
          "text": "嘿嘿，用慢速火药加热湿绷带的方法，可得把握好时间哦，不然就会把绷带点燃。"
        },
        {
          "role": "派蒙",
          "text": "这种加热绷带的方法，可能只有宵宫才能想到了！"
        },
        {
          "role": "「邦邦滚石」",
          "text": "等等…看看这是谁来了！名副其实的大英雄，和他的白色伙伴！"
        },
        {
          "role": "「邦邦滚石」",
          "text": "漫画织卷里的场景，要在我眼前上演了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们这是在疗伤？",
              "dialogues": []
            },
            {
              "text": "刚刚经历过战斗吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「邦邦滚石」",
          "text": "不打紧！只不过是在野外转悠，找了些以前没怎么见过的强敌练手！"
        },
        {
          "role": "「邦邦滚石」",
          "text": "宵宫小姐才是，我不小心扭到腰咕噜噜摔成雪球滚下来的时候，帮了我大忙！"
        },
        {
          "role": "派蒙",
          "text": "哇啊…听着就疼…"
        },
        {
          "role": "宵宫",
          "text": "哈哈，按照《炽魂斗士战记》的说法，「我只是一个路过的战士罢了」…"
        },
        {
          "role": "宵宫",
          "text": "而且是自由的雇佣战士！骑士团已经给我行动许可了，可以自行击退魔物。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来，还有魔物在徘徊？",
              "dialogues": []
            },
            {
              "text": "那需要谨慎，附近还有平民。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好像不妙啊，要不要通知骑士团那边，再派一些人手来支援？"
        },
        {
          "role": "宵宫",
          "text": "确实不能怠慢，不过情况也不算紧急啦。"
        },
        {
          "role": "宵宫",
          "text": "骑士团的专业人士已经把「国际越野赛」场地周围的魔物清理完了，剩下的都是一些游荡不定的家伙。"
        },
        {
          "role": "宵宫",
          "text": "说实话，参加越野赛的选手们中，也不乏武力不错的冒险家。"
        },
        {
          "role": "宵宫",
          "text": "他们有体魄，有胆识，让他们像普通人一样，处处小心魔物，人家反而觉得自己被看轻了呢。"
        },
        {
          "role": "「邦邦滚石」",
          "text": "所以，按照冒险家协会的办事传统，我们就地组成团队，将处理这些魔物当成了一种试炼。"
        },
        {
          "role": "「邦邦滚石」",
          "text": "正是——「斗魂试炼」，在清剿魔物的基础上，尽量模仿英雄们的战斗风格，实现对自我的超越！"
        },
        {
          "role": "派蒙",
          "text": "这个思路，确实很符合「沃陆之邦」的作风！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我要加入！",
              "dialogues": []
            },
            {
              "text": "我也不能缺席！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宵宫",
          "text": "好啊！很久没看见旅行者露一手了！"
        },
        {
          "role": "宵宫",
          "text": "非常期待，现在你的身手…漂亮得像是哪种烟花？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「邦邦滚石」）"
        },
        {
          "role": "「邦邦滚石」",
          "text": "状态怎么样，旅行者老板，要不要来露两手？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "开始「斗魂试炼」吧！",
              "dialogues": [
                {
                  "role": "「邦邦滚石」",
                  "text": "这气势太强了，我得好好观战！"
                }
              ]
            },
            {
              "text": "朋友，你本来是做什么工作的？",
              "dialogues": [
                {
                  "role": "「邦邦滚石」",
                  "text": "我啊？给你打工的！"
                },
                {
                  "role": "「邦邦滚石」",
                  "text": "哈哈，先别意外，我平常干最多的活儿，是帮瓦雷莎的店打杂。外出做生意的时候搬搬货，不出远门的时候管管仓库。"
                },
                {
                  "role": "「邦邦滚石」",
                  "text": "不过瓦雷莎说过，如果大英雄有需要，在关键的时刻，整个水果店和果园都支援给你！"
                },
                {
                  "role": "「邦邦滚石」",
                  "text": "所以理论上，我也是你的后备员工。"
                },
                {
                  "role": "「邦邦滚石」",
                  "text": "之前去枫丹做生意的时候，我也确实给你投过简历，不知道你还有没有印象。"
                },
                {
                  "role": "「邦邦滚石」",
                  "text": "有印象的话，是我最大的荣幸。"
                },
                {
                  "role": "「邦邦滚石」",
                  "text": "没印象的话，下次来「沃陆之邦」的时候，容我请您尝尝云岩裂叶风味的颗粒果汁，说不定就记住我了！"
                }
              ]
            },
            {
              "text": "先去处理些点别的事。",
              "dialogues": [
                {
                  "role": "「邦邦滚石」",
                  "text": "理解理解，那您先忙！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          25,
          27
        ]
      ]
    }
  ]
}