{
  "quest_id": 79027,
  "chapter_num": null,
  "chapter_title": "最后的宝藏",
  "type": "wq",
  "route": "The Final Treasure",
  "stories": [
    {
      "story_id": 79027,
      "title": "最后的宝藏",
      "description": "「大肉丸」似乎有什么事想要拜托我们，具体的详情，就去问问他吧…",
      "dialogues": [
        {
          "role": "「大肉丸」",
          "text": "欸呀，你们来啦，我还以为你们每天用那个什么翅膀，在海岛间飞来飞去…"
        },
        {
          "role": "「大肉丸」",
          "text": "早就忘了泡在水里的老伙计「大肉丸」啦。"
        },
        {
          "role": "派蒙",
          "text": "我们这不就想起你了嘛！"
        },
        {
          "role": "派蒙",
          "text": "对了，你之前说要帮忙的，是什么事呀…"
        },
        {
          "role": "「大肉丸」",
          "text": "其实也不是什么重要的事…上次你们不是帮我找到了我身躯的碎片嘛。"
        },
        {
          "role": "「大肉丸」",
          "text": "该怎么说呢，不知道是因为达成了一些心愿…还是这片海域让我能开口说话的力量在逐渐消退…"
        },
        {
          "role": "「大肉丸」",
          "text": "最近清醒的时候少，睡着的时候倒是越来越多啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "难道和那个装置有关？",
            "被装置的关闭影响了。"
          ]
        },
        {
          "role": "「大肉丸」",
          "text": "原来如此，是因为什么装置，我才能够变成旅行者你的浪船，也可以开口与你交流…"
        },
        {
          "role": "派蒙",
          "text": "啊…那等装置的影响结束以后，「大肉丸」岂不是不能再开口说话了！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，不如我们快想些办法…"
        },
        {
          "role": "「大肉丸」",
          "text": "哈哈，不用啦，派蒙…能够像现在这样与你们说话，我已经感到十分满足了。"
        },
        {
          "role": "「大肉丸」",
          "text": "呀…这么一想，我身为一艘船却能在过去几日和你们那样畅快交流，本身就是如梦幻一般的美好之事呀。"
        },
        {
          "role": "「大肉丸」",
          "text": "不过我现在还有一事相求…"
        },
        {
          "role": "旅行者",
          "text": "但说无妨…"
        },
        {
          "role": "「大肉丸」",
          "text": "之前不是一直说，等找到我的身体以后，就带着你们在这儿兜风嘛，只不过我的身体早就变成了那个样子…"
        },
        {
          "role": "「大肉丸」",
          "text": "宝藏大部分也被带走，没留下什么好东西…"
        },
        {
          "role": "「大肉丸」",
          "text": "但是这次，我以大海盗船之名起誓，一定会有了不起的大宝藏的！就当是再被我骗一次，跟我一起去吧！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，「大肉丸」说不定马上就没法说话了…"
        },
        {
          "role": "派蒙",
          "text": "而且…那可是有宝藏呢！我们就一起去吧，旅行者！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "真拿你没办法。",
            "既然都这么说了…"
          ]
        },
        {
          "role": "派蒙",
          "text": "那我们现在就出发吧！"
        },
        {
          "role": "「大肉丸」",
          "text": "好嘞，那就请两位立刻上船吧！"
        },
        {
          "role": "派蒙",
          "text": "真是险呀，感觉刚才差点就要被击沉了！"
        },
        {
          "role": "派蒙",
          "text": "「越石丸」，了不起！"
        },
        {
          "role": "「大肉丸」",
          "text": "哈哈，会说话的船也不过是船罢了，能够穿越雷暴，旅行者精湛的驾驶技术才是真的功不可没。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "要再来一次吗？",
            "谢谢夸奖。"
          ]
        },
        {
          "role": "「大肉丸」",
          "text": "哈哈，那还是别了。"
        },
        {
          "role": "「大肉丸」",
          "text": "唉，刚才的雷暴，恐怕是因为受到了我的影响，这么看来，这片海域的环境已经变得没那么稳定啦…"
        },
        {
          "role": "「大肉丸」",
          "text": "不过，也是正好…旅行者，派蒙，宝藏就在上面哦！"
        },
        {
          "role": "派蒙",
          "text": "这不是我们第一次找宝藏的地方吗，上面只有「越石丸」你的半截断船而已吧！"
        },
        {
          "role": "「大肉丸」",
          "text": "这次上面肯定有宝藏啦，这可是…怎么说的来着，这可是「大海盗船的直觉」啊！"
        },
        {
          "role": "派蒙",
          "text": "是嘛…对了，之前「越石丸」说有两件事要告诉我们，一件事是你记起了你的名字，另一件事是什么呀…"
        },
        {
          "role": "「大肉丸」",
          "text": "哈哈哈，我还以为你忘记了呢，剩下的一件事，就等你们回来再告诉你们吧！"
        },
        {
          "role": "派蒙",
          "text": "「越石丸」、「越石丸」！"
        },
        {
          "role": "派蒙",
          "text": "我们找到宝藏啦，你看，是一艘海盗船的模型呢！这次你的直觉终于准了一次！"
        },
        {
          "role": "派蒙",
          "text": "对了对了，你之前说，要告诉我们的第二件事到底是什么呀！"
        },
        {
          "role": "「大肉丸」",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "「越石丸」。"
        },
        {
          "role": "「大肉丸」",
          "text": "（其名为「越石丸」的船并没有作出任何反应…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "派蒙…",
            "「越石丸」已经不能说话了…"
          ]
        },
        {
          "role": "派蒙",
          "text": "…哼，还说我们回来就告诉我们。"
        },
        {
          "role": "派蒙",
          "text": "「越石丸」…真是个大骗子！"
        }
      ]
    }
  ]
}