  "chapter_title": "猎鹿急送",
  "type": "eq",
  "route": "Good Hunter Express",
  "stories": [
    {
      "story_id": 41158,
      "title": "猎鹿急送",
      "description": "蒙德城的猎鹿人餐馆里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "",
          "text": "没事的，我可以慢慢等，来报复一下瓦里特先生。"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "",
          "text": "太谢谢你了。"
        },
        {
          "role": "",
          "text": "送的时候千万要稳当一些，不要沾染元素，也不要步幅过大。"
        },
        {
          "role": "",
          "text": "好了，快点把这道菜送过去吧，瓦里特这家伙大家都知道性子很急。"
        },
        {
          "role": "",
          "text": "怎么还不来？"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "",
          "text": "是的，瓦里特先生今天定了一份渔人吐司，然后就去蒙德璃月交界处的石门那里了。"
        },
        {
          "role": "",
          "text": "究竟什么人点了吐司这种便携食物还要人外送的啊…"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "",
          "text": "总算送来了，谢谢，谢谢。快点给我吧。吃完了我还得去干活呢。"
        }
      ]
    }
  ]
}