{
  "quest_id": 10188,
  "chapter_num": "",
  "chapter_title": "她的宫殿正坍塌向风雪",
  "type": "wq",
  "route": "Her Palace Collapses Into the Blizzard",
  "stories": [
    {
      "story_id": 77160,
      "title": "曾为灵魂的木舟",
      "description": "为了令「灰眸」回归和寻回自己的身躯，得取得「灰眸」被分离出去的力量…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "取得全部的「灰眸」碎片"
        },
        {
          "type": "subtitle",
          "text": "取得全部的「灰眸」碎片"
        },
        {
          "type": "subtitle",
          "text": "取得全部的「灰眸」碎片"
        },
        {
          "type": "subtitle",
          "text": "与「灰眸」进行对话"
        },
        {
          "role": "派蒙",
          "text": "嗯…「无忧的庭院」，现在我们收集齐「眼镜」所有的力量了…"
        },
        {
          "role": "派蒙",
          "text": "现在应该就能打开这个奇怪的树的大门，「眼镜」也能重新获得肉体了吧。"
        },
        {
          "role": "「灰眸」",
          "text": "按照…创造我的人的说法，是这样的。"
        },
        {
          "role": "派蒙",
          "text": "创造你的人…啊，难道是之前碰到的奇怪的女人？"
        },
        {
          "role": "旅行者",
          "text": "放肆！什么奇怪的女人！"
        },
        {
          "role": "派蒙",
          "text": "肯定不是你现在说的奇怪女人啦！"
        },
        {
          "role": "派蒙",
          "text": "…就是那个，在那个有火鸟的叽里咕噜镇子和全是雪精的城堡里出现的那位。我记得名字是阿克…"
        },
        {
          "role": "「灰眸」",
          "text": "阿克西妮娅小姐，是的，根据现在恢复的记忆来看，她一度是白沙皇麾下的研究机关「谧源所」的一员…"
        },
        {
          "role": "「灰眸」",
          "text": "她制造我是为了…能够引导某种强大的力量，创造能够让所有人都不再痛苦的「明日」的世界…"
        },
        {
          "role": "「灰眸」",
          "text": "那是舍弃了嫉妒、仇恨、私心的国度，是众生的手掌托举而起的「无忧庭院」，如是…"
        },
        {
          "role": "「灰眸」",
          "text": "「如是，光辉的世界将降临，人与人，甚至人与神之间将再无差别。」"
        },
        {
          "role": "派蒙",
          "text": "人与神之间没有差别的世界，唔，很难想象要怎么样才能做到…"
        },
        {
          "role": "「灰眸」",
          "text": "「那是神无需利用神力，而人无需倚靠神明的，纯粹的人的世界。」"
        },
        {
          "role": "「灰眸」",
          "text": "…记忆里，计划的结果是这样。"
        },
        {
          "role": "「灰眸」",
          "text": "不过具体如何做到…抱歉，我无法得知最终计划的全貌，对于整个计划来说，我也不过是计划中的「道具」。"
        },
        {
          "role": "派蒙",
          "text": "我懂了，「眼镜」就是合成台，能够合成很多了不起的东西，但是合成台不会自己跑来跑去吃合成的素材。"
        },
        {
          "role": "「灰眸」",
          "text": "真是十分恰当的比喻，不过恕我提醒，派蒙小姐，在现在的至冬，炼金术并不是官方支持的学术方向…"
        },
        {
          "role": "派蒙",
          "text": "对、对哦…哎，反正周围也没有人能听到啦！"
        },
        {
          "role": "「灰眸」",
          "text": "…不过，我应该追寻最后的力量吗？"
        },
        {
          "role": "「灰眸」",
          "text": "如果，在打开门扉之后，我所记起的并非是我想要记起的一切，又该如何是好。"
        },
        {
          "role": "「灰眸」",
          "text": "如果，如果那是我被制造出来的唯一的原因，命定的用途…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就等想起来后再做决定。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是啊，在什么都不知道的时候做决定肯定不好，不管怎么样，都得把一切都想起来嘛。"
                }
              ]
            },
            {
              "text": "合成台想要合成有什么错！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "说得没错！就算有错也是乱用合成台的人的问题。"
                },
                {
                  "role": "派蒙",
                  "text": "呜都怪你们…不知道为什么脑子里出现了「呼哧呼哧」像狗一样喘着气的合成台。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "总之…「眼镜」帮了我们很多的忙，就算「眼镜」最开始造出来不是为了这个，但是对我们来说，「眼镜」也很有用！"
        },
        {
          "role": "旅行者",
          "text": "到时候回到我们身边就好。"
        },
        {
          "role": "「灰眸」",
          "text": "…是吗。"
        },
        {
          "role": "派蒙",
          "text": "而且之前还说了很多找回身体就要一起做的事嘛！烤火，打雪仗，在冰原上跑来跑去，我们约好的！"
        },
        {
          "role": "「灰眸」",
          "text": "是的，我期待…在寻回身躯之后与二位一同冒险。"
        },
        {
          "role": "「灰眸」",
          "text": "虽然在旅途中无数次这样想过…能够将我从那里带出来的是您，能与二位相遇真是太好了。"
        },
        {
          "role": "「灰眸」",
          "text": "最后的力量…一切的答案，就在门扉之后…"
        },
        {
          "role": "「灰眸」",
          "text": "现在，请打开这扇门扉吧。"
        },
        {
          "type": "subtitle",
          "text": "打开「无忧庭院」的门扉"
        },
        {
          "role": "「灰眸」",
          "text": "这里就是，「无忧庭院」的门扉，现在要尝试将我的力量归还至此处，打开这扇门吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是的，开始归还吧…",
              "dialogues": [
                {
                  "role": "「灰眸」",
                  "text": "那么，现在开始归还的仪式，去推开…「庭院的门扉」吧。"
                }
              ]
            },
            {
              "text": "不，之后再来吧…",
              "dialogues": [
                {
                  "role": "「灰眸」",
                  "text": "嗯，或许再做些准备比较好。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与阿克西妮娅对话"
        },
        {
          "role": "派蒙",
          "text": "终于打开了，刚才真的好冷哦。"
        },
        {
          "role": "派蒙",
          "text": "「眼镜」的身体应该就能重塑了吧…咦，「眼镜」呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「眼镜」？",
              "dialogues": []
            },
            {
              "text": "「灰眸」？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "怎么回事，连那个蓝色的眼镜都不见了…"
        },
        {
          "role": "阿克西妮娅",
          "text": "不必担心…一度分裂的躯体，依附于死物的意识都已回到了应该回到的位置。"
        },
        {
          "role": "阿克西妮娅",
          "text": "「灰眸」就暂且放在我手中一会儿吧，对我来说这也是种物归原主。"
        },
        {
          "role": "派蒙",
          "text": "啊，是你…阿克、阿克西妮娅！"
        },
        {
          "role": "阿克西妮娅",
          "text": "是的，我很高兴你记住了我的名字，派蒙。"
        },
        {
          "role": "派蒙",
          "text": "「眼镜」…"
        },
        {
          "role": "阿克西妮娅",
          "text": "别担心，他会醒来的，但是得花一点点时间。"
        },
        {
          "role": "派蒙",
          "text": "哦哦，然后他的身体就会修复如初，变成原来的人的样子了？"
        },
        {
          "role": "阿克西妮娅",
          "text": "不会了，他会进入一具「他人的身躯」…蜕化成真正的「原人」，这可能和你们的想象有些出入。"
        },
        {
          "role": "派蒙",
          "text": "等等…我有点没有明白，他不是想要找回自己的身躯吗？"
        },
        {
          "role": "阿克西妮娅",
          "text": "并非如此。"
        },
        {
          "role": "阿克西妮娅",
          "text": "对于忘记了过去，一无所知，只有「找回从前躯体」这一念头的他来说，这或许是件残忍的事…"
        },
        {
          "role": "阿克西妮娅",
          "text": "不过他从一开始就并不是为了「回到从前的身躯」，而是为了「融合和改造更高位的身躯」而准备的。"
        },
        {
          "role": "阿克西妮娅",
          "text": "如果他回想起一切，应该也能理解的吧。"
        },
        {
          "role": "派蒙",
          "text": "「融合和改造更高位的身躯…」咦，也就是说，他的身体和力量都会到别的人的身体里吗？"
        },
        {
          "role": "阿克西妮娅",
          "text": "嗯，就是这样。"
        },
        {
          "role": "派蒙",
          "text": "可是，他自己的身体已经没了，这里哪还有身体可以给他用啦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来是盯上了派蒙的身体…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸，我才不要，不过、唔，不过是「眼镜」的话，也不是不能稍微隔出来一点点…"
                },
                {
                  "role": "阿克西妮娅",
                  "text": "哈哈，如果融合进派蒙的身体的话，就会变成别的问题了。"
                }
              ]
            },
            {
              "text": "难道是我？",
              "dialogues": [
                {
                  "role": "阿克西妮娅",
                  "text": "哈哈，真是有趣的笑话，这世上没有人能够动摇或是触碰你。"
                },
                {
                  "role": "阿克西妮娅",
                  "text": "当然了，也没有人能够融合或者改造你，所以你并不是最好的选择。"
                }
              ]
            }
          ]
        },
        {
          "role": "阿克西妮娅",
          "text": "旅行者，其实很好猜到哦，在这个地方有一副身躯，白冕宫，这个昔日北国之王的埋骨之地…"
        },
        {
          "role": "旅行者",
          "text": "白沙皇的…躯体？"
        },
        {
          "role": "派蒙",
          "text": "啊？白沙皇，他都死了那么多年了，岂不是已经变成一堆骨头了…"
        },
        {
          "role": "阿克西妮娅",
          "text": "白沙皇陛下比较特殊，他的身躯即便是在他的意识消亡后也…保持着活性。"
        },
        {
          "role": "阿克西妮娅",
          "text": "就像，「沙皇白桦」。其实是他从未真正死去的躯壳向外渴求…而不断生长的神经。白桦…唉，这怎么看都不像是树吧。"
        },
        {
          "role": "阿克西妮娅",
          "text": "五百年了，沙皇陛下的身躯仍在渴求…"
        },
        {
          "role": "派蒙",
          "text": "怎么会…也就是白沙皇身体还活着？身体居然…能够活那么久？"
        },
        {
          "role": "阿克西妮娅",
          "text": "因为他是特殊的，虽然不及降临者，但他仍然高贵。他是古国亥珀波瑞亚科技的最高结晶，拥有以光赋予的魂魄…"
        },
        {
          "role": "阿克西妮娅",
          "text": "亥珀波瑞亚人甚至试图用原初冰龙的血肉作为材料打造他的身体…只为了他能够企及「那一位」曾拥有的权柄。"
        },
        {
          "role": "派蒙",
          "text": "那一位是…哪一位？"
        },
        {
          "role": "阿克西妮娅",
          "text": "随提瓦特共同诞生的意志，最原初的光界力的主人，亦称「尼伯龙根」，众龙王的王。"
        },
        {
          "role": "阿克西妮娅",
          "text": "在他被毁灭之后，「原初之人」，也即「那菈延」的座位空悬。"
        },
        {
          "role": "阿克西妮娅",
          "text": "高天之上，不可称名的主人的冷酷又如高悬的利剑…呵，或者说高悬的长钉更为恰当…所以…"
        },
        {
          "role": "旅行者",
          "text": "他们想要…制造自己的「神明」。"
        },
        {
          "role": "派蒙",
          "text": "他们因此…造出了白沙皇…唔，不过那时候应该不能叫白沙皇，应该是…「原初之人」？"
        },
        {
          "role": "阿克西妮娅",
          "text": "他们「试图」造出，不过实验失控了，不然黄金城应该仍然屹立在这片土地…甚至此处不会如现在，是冰封千里的冻土。"
        },
        {
          "role": "阿克西妮娅",
          "text": "根据我们在影域中找到的残缺的记录所述，冰之龙王的尸骸，其失控的权能…导致整个至冬化作原初之冰的圣土。"
        },
        {
          "role": "阿克西妮娅",
          "text": "甚至连范围内的地脉都受到影响，变成了凝结纯化的晶矿…直到，那一位垂眸，而高天之钉降下。"
        },
        {
          "role": "派蒙",
          "text": "呃啊…咦，可是既然失败了，白沙皇到底是怎么来的？"
        },
        {
          "role": "阿克西妮娅",
          "text": "失控了，并非失败…在那场实验和冲击结束的千年之后，沙皇陛下自冰龙的尸骸中醒来。"
        },
        {
          "role": "阿克西妮娅",
          "text": "只是因为实验并未完成，所以他的力量并不完整…而那时亥珀波瑞亚已被没入影域，雪域之国唯有妖精的身影…"
        },
        {
          "role": "阿克西妮娅",
          "text": "世人以为沙皇陛下是某类强大的妖精，实则真实的身份要比那高贵多啦…"
        },
        {
          "role": "阿克西妮娅",
          "text": "制造他的亥珀波瑞亚已然灭亡，他大可以抛之不管，可他还是接受了…接受了自己是「失败的原初之人」这件事。"
        },
        {
          "role": "阿克西妮娅",
          "text": "包括…这代表的一切责任与后果。"
        },
        {
          "role": "阿克西妮娅",
          "text": "他甚至愿意在这魔兽横行的冻土之国接纳人类，仍然愿意…成为真正的「原人」。"
        },
        {
          "role": "阿克西妮娅",
          "text": "这是他不应被辜负的「慈爱」。"
        },
        {
          "role": "阿克西妮娅",
          "text": "而…「眼镜」，也就是那无数次实验后造出的「雏原人」，就是让沙皇陛下成为「原初之人」的钥匙。"
        },
        {
          "role": "阿克西妮娅",
          "text": "本来…本来应该在更早的时候就开始的，如今甚至变成了沙皇陛下的遗志…"
        },
        {
          "role": "阿克西妮娅",
          "text": "不过多亏了你们，旅行者与派蒙，这一伟愿终于有望完成。"
        },
        {
          "role": "阿克西妮娅",
          "text": "这并不是轻松的活，我本来打算花上二十年来做这件事呢。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，虽然没听太懂，但总归是被谢谢了呢…"
        },
        {
          "role": "旅行者",
          "text": "然后呢…"
        },
        {
          "role": "旅行者",
          "text": "…制造出「原初之人」以后？"
        },
        {
          "role": "派蒙",
          "text": "是哦，之前就一直说的，「无忧的庭院」，到底是什么…"
        },
        {
          "role": "阿克西妮娅",
          "text": "「那是『明日』的世界，舍弃了嫉妒、仇恨、私心的国度。众人如最初那样彼此相爱，而这爱的时间是永恒。」"
        },
        {
          "role": "阿克西妮娅",
          "text": "「如是，光辉的世界将降临，人与人，甚至人与神之间将再无差别。」"
        },
        {
          "role": "阿克西妮娅",
          "text": "…至少这是他向我们述说的愿景。不过在我的理解里，他所说的爱并没有那么复杂，是一种灵性的漫溢。"
        },
        {
          "role": "阿克西妮娅",
          "text": "只是这种漫溢会因为世间诸多苦痛而枯竭，于是，原本的流溢者会变成汲取者，无私变得贪婪，猜忌取代信任…"
        },
        {
          "role": "派蒙",
          "text": "唔，好难理解哦。"
        },
        {
          "role": "阿克西妮娅",
          "text": "派蒙很喜欢吃东西，比如，就比如「甜甜花酿鸡」…第一次吃的时候，派蒙一定会吃得很开心吧。"
        },
        {
          "role": "派蒙",
          "text": "是啊，我一下子吃了两只呢。"
        },
        {
          "role": "阿克西妮娅",
          "text": "嗯…但是第二次吃的时候就没有第一次吃好吃了，第三次吃也没有第二次吃好吃，或许有一天就会吃腻。"
        },
        {
          "role": "派蒙",
          "text": "应该不会吃腻啦，我相信「甜甜花酿鸡」…不过…唔，确实是第一次吃到的「甜甜花酿鸡」最好吃…"
        },
        {
          "role": "阿克西妮娅",
          "text": "然后你就会想要吃到更好吃的东西，如此反复，结果只是为了填补心中「想要获得第一次吃的感动」的那个空洞。"
        },
        {
          "role": "阿克西妮娅",
          "text": "许多欲与恶如是横生，但是，反过来…不管吃什么，无论什么时候吃，无论是第几次，都能够获得那份感动呢？"
        },
        {
          "role": "派蒙",
          "text": "哇，这听上去像是什么梦里的世界…"
        },
        {
          "role": "阿克西妮娅",
          "text": "这就是「明日」的世界。无论做什么，内心都能充盈这种感动，而诸多感动中，最为显著的就是爱吧…"
        },
        {
          "role": "阿克西妮娅",
          "text": "那会是不灭的，固定的，永恒之爱，而后，正因充斥这份永恒之爱，世界变为不再苦恼也没有痛苦的国度。"
        },
        {
          "role": "旅行者",
          "text": "但不再变化了。"
        },
        {
          "role": "阿克西妮娅",
          "text": "是的，因为…时间与变化是摧折，会在每一秒里伤害爱之永远。"
        },
        {
          "role": "派蒙",
          "text": "等等？什么叫不会变化？"
        },
        {
          "role": "旅行者",
          "text": "就是所有吃的都会变成一个味道…"
        },
        {
          "role": "派蒙",
          "text": "欸，怎么回事，我可没听说过会变成这样？"
        },
        {
          "role": "派蒙",
          "text": "啊…因为吃什么东西都超级开心，所以吃的东西就变得无所谓了？"
        },
        {
          "role": "阿克西妮娅",
          "text": "是呀…派蒙真的比想象中聪明很多呢。"
        },
        {
          "role": "阿克西妮娅",
          "text": "塑造这样的世界，第一步就是利用影域…光或许很快会将目光投射入影域，不过那也需要一些时间…"
        },
        {
          "role": "阿克西妮娅",
          "text": "用影域覆盖至冬，然后是整个世界，让所有的爱都定格在无始无终的空间里，如是达成——「无忧的庭院」。"
        },
        {
          "role": "阿克西妮娅",
          "text": "令选择失去意义，令被选择和不被选择再无差别。这样的世界里，甚至「深渊」也会变得「可爱」起来吧。"
        },
        {
          "role": "派蒙",
          "text": "不对不对，唔…"
        },
        {
          "role": "派蒙",
          "text": "「眼镜」，「眼镜」还说等拿回身体要和我们干各种不同的事，「眼镜」肯定也不想要这样的世界！"
        },
        {
          "role": "阿克西妮娅",
          "text": "没关系的，派蒙，旅行者，甚至「雏原人」，无论你们愿意与否…你们都能在无忧的世界拥有一席之地。"
        },
        {
          "role": "旅行者",
          "text": "这种世界不要也罢…"
        },
        {
          "role": "阿克西妮娅",
          "text": "真可惜，我以为你们会理解，看来我们的理念有分歧，不过没有关系，最终的理解终究会到来…"
        },
        {
          "role": "阿克西妮娅",
          "text": "那看来，我已经是你们想要阻止的对象了…我，还是不想和你们动手，所以，这是我的选择。"
        },
        {
          "role": "派蒙",
          "text": "不行，不许走！"
        },
        {
          "type": "subtitle",
          "text": "追上阿克西妮娅"
        },
        {
          "type": "subtitle",
          "text": "跃入影域"
        },
        {
          "type": "subtitle",
          "text": "追上阿克西妮娅"
        },
        {
          "type": "subtitle",
          "text": "跃入影域"
        },
        {
          "type": "subtitle",
          "text": "追上阿克西妮娅"
        },
        {
          "type": "subtitle",
          "text": "追上阿克西妮娅"
        },
        {
          "type": "subtitle",
          "text": "追上阿克西妮娅"
        },
        {
          "type": "subtitle",
          "text": "与阿克西妮娅对话"
        },
        {
          "role": "阿克西妮娅",
          "text": "这样就可以了，只要…再等待一小会儿…"
        },
        {
          "role": "派蒙",
          "text": "哇，那是什么，好大的奇怪的家伙…"
        },
        {
          "role": "派蒙",
          "text": "不对不对，重点不是那个！"
        },
        {
          "role": "派蒙",
          "text": "阿克西妮娅，你这个坏家伙，快把「眼镜」还给我们！"
        },
        {
          "role": "阿克西妮娅",
          "text": "看来你们很喜欢「灰眸」…如果我曾经的同僚也能意识到这件造物的价值就好了。"
        },
        {
          "role": "阿克西妮娅",
          "text": "…虽然肉体已然进行转化，但意识却还没有完全入主…沙皇陛下…"
        },
        {
          "role": "派蒙",
          "text": "啊，这个就是…"
        },
        {
          "role": "阿克西妮娅",
          "text": "这就是沙皇陛下原本的神躯，只不过在和我们交谈，或与妖精们同行的时候会化作类人妖精的化身。"
        },
        {
          "role": "阿克西妮娅",
          "text": "死后，他无法维持化身，这才是他原本的姿态，几近超越者之姿的魁伟之体。"
        },
        {
          "role": "阿克西妮娅",
          "text": "我有跟你们说过吗，「雏原人」的脸是根据白沙皇陛下类人化身的面孔调整的。"
        },
        {
          "role": "旅行者",
          "text": "把「眼镜」还回来…"
        },
        {
          "role": "派蒙",
          "text": "对，我才不想知道你刚才说的那些东西——"
        },
        {
          "role": "阿克西妮娅",
          "text": "好啊，给你们好了。"
        },
        {
          "role": "阿克西妮娅",
          "text": "「灰眸」本就是为了承载「雏原人」的意识…令他不至于在将血肉献给沙皇陛下后消失…"
        },
        {
          "role": "阿克西妮娅",
          "text": "本来，其实是为了留下「他」而制作的。"
        },
        {
          "role": "阿克西妮娅",
          "text": "现在，对我来说它已然用尽。我将它正式赠予你，我相信你能够好好使用它。"
        },
        {
          "role": "阿克西妮娅",
          "text": "所有权，移交给…旅行者。"
        },
        {
          "role": "派蒙",
          "text": "…「眼镜」？"
        },
        {
          "role": "「灰眸」",
          "text": "已回归初始状态，「灰眸」为您服务…"
        },
        {
          "role": "旅行者",
          "text": "这并不是「他」。"
        },
        {
          "role": "派蒙",
          "text": "这个才不是「眼镜」，这个只是…只是那个工具，这只是一个空壳！"
        },
        {
          "role": "阿克西妮娅",
          "text": "很抱歉，「他」的意识现在应该已经成为原初之人、光之巨人的核心。"
        },
        {
          "role": "阿克西妮娅",
          "text": "这是我无法还给你们的，不过没有关系，很快，你们就不会为此感觉悲伤…因为——"
        },
        {
          "role": "「原初之人」",
          "text": "…唉。"
        },
        {
          "role": "阿克西妮娅",
          "text": "因为——「原初之人」已经醒来。"
        },
        {
          "role": "「原初之人」",
          "text": "旅行者，派蒙…还有，阿克西妮娅。"
        },
        {
          "role": "派蒙",
          "text": "「眼镜」？"
        },
        {
          "role": "「原初之人」",
          "text": "嗯，是我…我回想起了一切，阿克西妮娅，真是漫长的时光啊，不管是对你还是对我来说。"
        },
        {
          "role": "「原初之人」",
          "text": "不过正因如此，不得不感叹命运之荒谬，这明明是我仍然身为「雏形」之时，极力想要避免的情况才对。"
        },
        {
          "role": "阿克西妮娅",
          "text": "因为命运就是这样，无论如何也会将你推至悬崖，犹如恶客来访。"
        },
        {
          "role": "派蒙",
          "text": "极力避免的情况…？"
        },
        {
          "role": "「原初之人」",
          "text": "是啊，为此我稍稍劝说了卡谢伊，帕芙琳娜和阿尔维斯，在她想要真正开启最终的实验之前阻止她。"
        },
        {
          "role": "「原初之人」",
          "text": "毕竟「原初之人」所能持有的权柄对于拥有纷杂欲望的人和妖精来说是一种剧毒…"
        },
        {
          "role": "派蒙",
          "text": "啊…所以，火鸟镇子那个蓝藻，那个雪孃，还有新基捷城的矮灵大公，他们之所以背叛了阿克西妮娅，是因为你？"
        },
        {
          "role": "派蒙",
          "text": "欸——"
        },
        {
          "role": "「原初之人」",
          "text": "我向他们许诺，以这样的方式就能够阻止阿克西妮娅，也能够令他们获得他们想要的东西。"
        },
        {
          "role": "「原初之人」",
          "text": "他们多多少少各自有自己想要成为超越一切的生命的理想…或是野心。要利用这点倒很简单。"
        },
        {
          "role": "「原初之人」",
          "text": "相对来说，我们的阿克西妮娅，我们可爱的阿克西妮娅啊，她的坚定反而更加异常，不是吗。"
        },
        {
          "role": "「原初之人」",
          "text": "我引诱他们瓜分我，切碎我，引诱他们背叛阿克西妮娅…因为…"
        },
        {
          "role": "「原初之人」",
          "text": "因为我一旦成为「原初之人」，拥有了超越者之位…就像现在…无论如何，世界的变革就要产生了。"
        },
        {
          "role": "「原初之人」",
          "text": "「兽」嗤笑我，因为它自认贯彻了自己的使命。而我，则用尽全力试图从我的使命中逃离，却最终还是回到了这里。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不想成为「原初之人」。",
              "dialogues": []
            },
            {
              "text": "你不想创造新的世界…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「原初之人」",
          "text": "是啊，因为…唉，阿克西妮娅…"
        },
        {
          "role": "「原初之人」",
          "text": "依照那新规划诞生的世界里，阿克西妮娅，你没有为自己留下位置，对吗？"
        },
        {
          "role": "派蒙",
          "text": "咦？"
        },
        {
          "role": "阿克西妮娅",
          "text": "…是的，我愿意相信永恒之爱的国度，我因相信沙皇陛下而相信他的愿景。"
        },
        {
          "role": "阿克西妮娅",
          "text": "那是永爱的国度，但失去对爱的信任的人就会被驱逐出新世界的宏图。进入新世界？我没有这个资格。"
        },
        {
          "role": "「原初之人」",
          "text": "驱逐？不如说是被杀死。永恒之爱，永恒的漫溢，永恒的欣喜…可不信任爱与喜悦的人却无法进入这个国度。"
        },
        {
          "role": "「原初之人」",
          "text": "但恰恰唯有不信任爱与喜悦的人…才会真的作出那样残忍的规划…哼，这一点，「慈爱」的白沙皇却早已料及。"
        },
        {
          "role": "阿克西妮娅",
          "text": "这是他的伟大之处，他选择了我，这是我的使命，我生存的唯一的理由…即使，我无法进入新世界——"
        },
        {
          "role": "阿克西妮娅",
          "text": "我也要亲眼看见它降临于我尸骸打造的基石之上。"
        },
        {
          "role": "阿克西妮娅",
          "text": "…那么你呢，你真的仍然相信不靠沙皇陛下的规划，就能达成所谓的爱之永恒吗。"
        },
        {
          "role": "阿克西妮娅",
          "text": "阿尔维斯、卡谢伊和帕芙琳娜各自的追求已然如融雪破灭…没有人能够经受岁月的消磨，灵魂的枯竭，梦想的干瘪。"
        },
        {
          "role": "阿克西妮娅",
          "text": "为了让那雀跃的灵性驻留于心间…这世上的所有人付出的还不够多吗，但没人能够成功。"
        },
        {
          "role": "阿克西妮娅",
          "text": "事到如今，你又能作出什么样的选择？"
        },
        {
          "role": "「原初之人」",
          "text": "阿克西妮娅，你明知道在我回忆起一切之后就无法拒绝你。更何况已然成为「原初之人」，其实我已经别无选择。"
        },
        {
          "role": "派蒙",
          "text": "所以…「眼镜」，你真的要打开那个「无忧庭院」的大门？"
        },
        {
          "role": "旅行者",
          "text": "或许还有别的选项？"
        },
        {
          "role": "「原初之人」",
          "text": "我很感激你们，旅行者和派蒙，即使到了现在还愿意给我放弃的机会。"
        },
        {
          "role": "「原初之人」",
          "text": "但…遗憾的是，我无法令她的规划成空。所以，如果你们不愿意看到那样的场面，还请二位阻止…阻止我和她。"
        },
        {
          "role": "「原初之人」",
          "text": "不过在那之前，旅行者，我有要向阿克西妮娅展示的东西…我希望你能回答我的一个问题…"
        },
        {
          "role": "「原初之人」",
          "text": "你为了你的血亲而奔走，你踱涉过了几乎整个世界…为了理解她，为了追寻你与她之间错过的所有，为了站在她的面前。"
        },
        {
          "role": "「原初之人」",
          "text": "可是如果你们之间的隔阂太厚，最终你发现，你找到的并非你想象中的她，你曾经一度深爱的血亲已不是你的血亲…"
        },
        {
          "role": "「原初之人」",
          "text": "她变了，她变作另一个人，她变成别的你永远未曾设想的模样…"
        },
        {
          "role": "派蒙",
          "text": "呃，怎么会有这样的问题，旅行者的妹妹才不会变呢！"
        },
        {
          "role": "「原初之人」",
          "text": "这只是个假设，不用那么紧张，派蒙。"
        },
        {
          "role": "「原初之人」",
          "text": "你会怎么做，旅行者，我想…知道你的答案。"
        },
        {
          "role": "旅行者",
          "text": "如果她变了…"
        },
        {
          "role": "旅行者",
          "text": "那我就会重新爱上她…"
        },
        {
          "role": "旅行者",
          "text": "无论多少遍。"
        },
        {
          "role": "阿克西妮娅",
          "text": "……"
        },
        {
          "role": "「原初之人」",
          "text": "感谢你，旅行者，太好了，这比我想象中能得到的答案还要好上太多倍。"
        },
        {
          "role": "「原初之人」",
          "text": "时间已至，「无忧的庭院」已然要开启，真可惜啊——"
        },
        {
          "role": "「原初之人」",
          "text": "「可是，有什么办法呢？谁在爱，谁就应该与他所爱的人分担命运。」"
        },
        {
          "type": "subtitle",
          "text": "击败阿克西妮娅"
        },
        {
          "type": "subtitle",
          "text": "击败「原初之人」"
        },
        {
          "type": "subtitle",
          "text": "击败「原初之人」"
        },
        {
          "type": "subtitle",
          "text": "击败「原初之人」"
        },
        {
          "type": "subtitle",
          "text": "击败「原初之人」"
        },
        {
          "type": "subtitle",
          "text": "找到解除困境的办法"
        },
        {
          "type": "subtitle",
          "text": "顺着道路前往「原初之人」背后"
        },
        {
          "type": "subtitle",
          "text": "击败「原初之人」"
        },
        {
          "type": "subtitle",
          "text": "击败「原初之人」"
        },
        {
          "type": "subtitle",
          "text": "击败「原初之人」"
        },
        {
          "type": "subtitle",
          "text": "清理列车上的神经"
        },
        {
          "type": "subtitle",
          "text": "最后的对话"
        },
        {
          "role": "？？？",
          "text": "通往世界的门扉被关闭了。\\n始作俑者像是抖落死蛾黏附肩上的鳞翼…\\n在几次颤动中褪去巨人的形体。\\n然后，「他」出现了…"
        },
        {
          "role": "？？？",
          "text": "曾寄于「灰眸」中的意志…\\n事到如今竟然真的拥有了与常人无二的身躯。\\n拥有了与雪原的沙皇年幼时一般无二的样貌。"
        },
        {
          "role": "？？？",
          "text": "于是这个影中世界只剩下了卵中的人与卵外的人。\\n只剩下了背叛者和被背叛者。\\n只剩下了…\\n在第一次睁眼时便爱上眼前人的人，与不知爱也不知忧愁的被爱者。"
        },
        {
          "role": "阿克西妮娅",
          "text": "到头来…我还没来得及，我还没来得及做任何事…"
        },
        {
          "role": "阿克西妮娅",
          "text": "真可惜啊，那明明是我唯一需要完成的伟业。"
        },
        {
          "role": "「原初之人」",
          "text": "在我看来，你已经做得足够多了…在这样的地方，你居然坚持了那么漫长的岁月。"
        },
        {
          "role": "「原初之人」",
          "text": "你怀有那么强烈的愿望啊，甚至命运的枝条也为你倾垂…以至于你可以从这里逃脱。"
        },
        {
          "role": "阿克西妮娅",
          "text": "我能从影域的封锁中脱离…其实大多还是伊兹梅洛的功劳…他说这是他能为我做的最后的事了。"
        },
        {
          "role": "阿克西妮娅",
          "text": "但我还是失败了，失去了一切…唉，现在我们会坠到哪里去呢？"
        },
        {
          "role": "「原初之人」",
          "text": "会坠到影域的无穷远处去吧，向下坠落一个又一个五百年。"
        },
        {
          "role": "「原初之人」",
          "text": "但这对我来说是最好的结局了。"
        },
        {
          "role": "阿克西妮娅",
          "text": "是吗？"
        },
        {
          "role": "「原初之人」",
          "text": "是的，阿克西妮娅，这里没有白沙皇陛下，这里没有「原初之人」，这里没有至冬的宫廷小丑，雪孃和各色的妖精。"
        },
        {
          "role": "「原初之人」",
          "text": "这里只有我和你，在这里…连「名字」都不需要。"
        },
        {
          "role": "阿克西妮娅",
          "text": "这就是你想要的？"
        },
        {
          "role": "「原初之人」",
          "text": "…这就是我想要的，这就是最好的，在这影域里如小小核桃壳一般的世界，最后只有我与你两个人。"
        },
        {
          "role": "阿克西妮娅",
          "text": "…我曾以为，我永远没有踏入这样的世界的资格…"
        },
        {
          "role": "阿克西妮娅",
          "text": "…是啊，旅行者是对的，为何要畏惧爱的消逝呢，为何执着于爱的永恒…"
        },
        {
          "role": "阿克西妮娅",
          "text": "如果一个人有相信爱的勇气，那便不会执着于失去…我若相信它存在，那么失去了又如何呢？"
        },
        {
          "role": "阿克西妮娅",
          "text": "再一次爬起，抖落身上的泥灰，再一次去追逐，去夺取，去奔赴，去爱吧！"
        },
        {
          "role": "阿克西妮娅",
          "text": "为何要…为何要…"
        },
        {
          "role": "「原初之人」",
          "text": "阿克西妮娅…"
        },
        {
          "role": "阿克西妮娅",
          "text": "哈…我曾厌恨这个被蛋壳困锁的天地，没想到到头来却只是打造出了另一重的蛋壳。"
        },
        {
          "role": "「原初之人」",
          "text": "也许因为命运从来就是这样，无论如何也会将你推至悬崖，犹如恶客来访。"
        },
        {
          "role": "阿克西妮娅",
          "text": "这次居然轮到你来对我说这句话了。"
        },
        {
          "role": "阿克西妮娅",
          "text": "…我曾经那样愤怒啊，在得知整个世界的真相时，曾怀着那样的愤懑问沙皇陛下："
        },
        {
          "role": "阿克西妮娅",
          "text": "「如果一枚卵的存在并非为了其中的生命能够破壳而出，那它诞生在这宇宙中的意义又是为了什么？」"
        },
        {
          "role": "阿克西妮娅",
          "text": "但我未曾从他那里得到想要的答案。"
        },
        {
          "role": "「原初之人」",
          "text": "你曾这样想，原来如此。"
        },
        {
          "role": "「原初之人」",
          "text": "那现在呢，阿克西妮娅，你仍然这样想吗？你做了那么多啊，可曾试探出问题的答案？"
        },
        {
          "role": "阿克西妮娅",
          "text": "大概吧，答案其实就是…唉，你，你早就知道了，对吗？"
        },
        {
          "role": "「原初之人」",
          "text": "…你曾以为我太过自私。"
        },
        {
          "role": "「原初之人」",
          "text": "但无论是什么形式的爱，无论是付出还是占有，你向外的爱带来的都是一种向内的映射。"
        },
        {
          "role": "「原初之人」",
          "text": "爱世界也是为了爱自己…"
        },
        {
          "role": "「原初之人」",
          "text": "但这也是伟大的，因为世事本来就是如此，令自我得到拯救的愿望要那样强烈，才能由己及人地去拯救这个世界。"
        },
        {
          "role": "「原初之人」",
          "text": "虽然我一直觉得应该先爱自己才能去爱世界，否则就会形成谬误，就如今日。"
        },
        {
          "role": "「原初之人」",
          "text": "但你是了不起的，阿克西妮娅。"
        },
        {
          "role": "阿克西妮娅",
          "text": "…真是廉价的夸奖。"
        },
        {
          "role": "「原初之人」",
          "text": "真伤心，那夸奖毫无疑问出自我的真心。"
        },
        {
          "role": "阿克西妮娅",
          "text": "哼…"
        },
        {
          "role": "阿克西妮娅",
          "text": "是啊，原来所有一切，帕芙琳娜，卡谢伊，阿尔维斯，包括你，还有…还有沙皇陛下，所有一切你们想要的东西…"
        },
        {
          "role": "阿克西妮娅",
          "text": "为何我现在才发觉，其实我也曾那样真切地渴望过啊…"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "终于…呼，终于从那个影域里跑出来了。"
        },
        {
          "role": "派蒙",
          "text": "「眼镜」，阿克西妮娅…还有白沙皇的身躯都不见了，他们会到哪里去呢？"
        },
        {
          "role": "旅行者",
          "text": "应该不会再出现了…"
        },
        {
          "role": "派蒙",
          "text": "呜，你说「眼镜」会不会，其实还藏在那个，阿克西妮娅留给你的那个机关里。"
        },
        {
          "role": "派蒙",
          "text": "很多故事不是都这样演的嘛，以为要消失了的家伙，「哇」地一下又出现了。"
        },
        {
          "role": "派蒙",
          "text": "不如让我看看。"
        },
        {
          "role": "？？？",
          "text": "于是派蒙尝试了很多次。 \\n但是回应她的只是语调冰冷的声音。 \\n于是你们知道，即便有些能力还与从前一样，但「眼镜」现在真的只是「一副眼镜」了。"
        },
        {
          "role": "派蒙",
          "text": "他真的，掉到那么深的地方了。"
        },
        {
          "role": "派蒙",
          "text": "活该让他选择要打开那个什么「无忧的庭院」啦…不过，他选择帮阿克西妮娅的时候还是挺帅气的。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，如果有一天，你要和整个世界为敌了，我也一定会像那样站在你这边的。"
        },
        {
          "role": "旅行者",
          "text": "我也一样，派蒙。"
        },
        {
          "role": "派蒙",
          "text": "嗯！"
        },
        {
          "role": "派蒙",
          "text": "啊…说起来，原本在这里的白沙皇身躯不见了，现在我们又在边上…要是被人发现，这可解释不清楚啦！"
        },
        {
          "role": "派蒙",
          "text": "快、我们还是快点先逃跑吧！"
        }
      ]
    }
  ]
}