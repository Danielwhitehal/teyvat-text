{
  "quest_id": 76121,
  "chapter_num": null,
  "chapter_title": "夜空中的月亮·三月",
  "type": "wq",
  "route": "The Moon Adorning the Night: The Three Moons",
  "stories": [
    {
      "story_id": 76121,
      "title": "夜空中的月亮·三月",
      "description": "在「银月之庭」，哥伦比娅似乎有想做的事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同哥伦比娅见面"
        },
        {
          "role": "哥伦比娅",
          "text": "♪~"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅，你好呀，你今天心情很好嘛！"
        },
        {
          "role": "哥伦比娅",
          "text": "哈…上来吧。"
        },
        {
          "role": "派蒙",
          "text": "噢！你是又想玩「月亮棋」了吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，很久没玩了，有点想念。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "规则还和以前一样吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不会因为你变成了三月女神，每次你都能多动几颗棋子吧？"
        },
        {
          "role": "哥伦比娅",
          "text": "那就变成作弊了，我不会用这种方式赢的。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我知道的啦，开个小玩笑。"
        },
        {
          "role": "哥伦比娅",
          "text": "那么，我们开始吧？"
        },
        {
          "type": "subtitle",
          "text": "同哥伦比娅玩月亮棋"
        },
        {
          "type": "subtitle",
          "text": "玩法教学"
        },
        {
          "role": "将代表「月亮」的棋子放上棋盘，我方三个棋子连成一条线时，即为胜利。注意",
          "text": "任意一方的棋子大于三颗时，最先进入棋盘的棋子将会消失。"
        },
        {
          "type": "subtitle",
          "text": "长时间闲置"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "原来你喜欢深思熟虑后再做决定，嗯，没事，我们有很多时间。"
        },
        {
          "role": "哥伦比娅",
          "text": "忘了怎么将「月亮」放上「夜空」吗？要不要我帮你？"
        },
        {
          "role": "哥伦比娅",
          "text": "不喜欢这个游戏吗？我觉得还挺有意思。"
        },
        {
          "type": "subtitle",
          "text": "长时间看向哥伦比娅"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯？你是在盯着我看吗？我感觉得到。"
        },
        {
          "role": "哥伦比娅",
          "text": "我的脸上…有关于「月亮」的答案吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "棋盘在那边哦。"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "这样对吗…？"
        },
        {
          "role": "哥伦比娅",
          "text": "我想想…"
        },
        {
          "role": "哥伦比娅",
          "text": "唔…"
        },
        {
          "role": "哥伦比娅",
          "text": "月亮…月亮…"
        },
        {
          "role": "哥伦比娅",
          "text": "这里怎么样？"
        },
        {
          "type": "subtitle",
          "text": "随机语音",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "平局"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯…月升月落，真是漫长。"
        },
        {
          "role": "哥伦比娅",
          "text": "我们的月亮谁都不让谁呢。"
        },
        {
          "role": "哥伦比娅",
          "text": "是不是…快平手了？"
        },
        {
          "type": "subtitle",
          "text": "玩家胜利"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，是你的「月亮」获胜了。"
        },
        {
          "role": "哥伦比娅",
          "text": "这片夜空属于你了。"
        },
        {
          "role": "哥伦比娅",
          "text": "啊…一不小心就…"
        },
        {
          "type": "subtitle",
          "text": "哥伦比娅胜利"
        },
        {
          "role": "哥伦比娅",
          "text": "这次是我赢了。"
        },
        {
          "role": "哥伦比娅",
          "text": "我的三个月亮连起来了。"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，这样就赢了。"
        },
        {
          "type": "subtitle",
          "text": "与哥伦比娅在游戏中度过了一段愉快的时光…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "哥伦比娅",
          "text": "三个月亮连成一条线…"
        },
        {
          "role": "派蒙",
          "text": "怎么了？还在想刚刚那盘棋的输赢吗？"
        },
        {
          "role": "哥伦比娅",
          "text": "哦，没有。只是…如今回看这游戏，会有些不可思议的感觉。"
        },
        {
          "role": "派蒙",
          "text": "对哦，你获得了三个月亮的力量，那已经不只是能主宰夜空这种级别的东西了。"
        },
        {
          "role": "哥伦比娅",
          "text": "嗯，我也会想，若是当初三位月之女神没有产生分歧的话，世界的命运说不定就变得不一样了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她们看起来如何？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "唔…我最先见到的是虹月女神，桑娜妲。她比我想象中活泼一些，像个贪玩的妹妹。"
        },
        {
          "role": "哥伦比娅",
          "text": "恒月女神艾莉亚是三位女神中最稳重的一位，富有领导力，对他人也很温柔。啊，就像菈乌玛一样呢。"
        },
        {
          "role": "哥伦比娅",
          "text": "霜月女神卡侬…看起来是位既智慧，又有远见的女神。也就是她，把自己的月亮让给了我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来都是善良的神明…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "哥伦比娅",
          "text": "没错，尽管有所分歧，但她们都爱着提瓦特这个世界，爱着这个家。"
        },
        {
          "role": "哥伦比娅",
          "text": "当我说起未来的事情，她们看起来都很欣慰。一种为这个世界仍有如此丰富的未来感到高兴的样子。"
        },
        {
          "role": "哥伦比娅",
          "text": "也正因如此，她们才给予我力量，帮我回到了这个「家」。"
        },
        {
          "role": "派蒙",
          "text": "唔…真想见她们一面，对她们好好道一声谢呢…"
        },
        {
          "role": "哥伦比娅",
          "text": "我也这么想，不过…那大概是不可能的事了吧…"
        },
        {
          "role": "哥伦比娅",
          "text": "好在这个世界仍在前行，她们所保护的人类也活了下来，传唱着她们的故事。"
        },
        {
          "role": "派蒙",
          "text": "没错！只要好好地过日子，不让坏蛋毁了这个世界，就是对三位女神最好的感谢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还真会说…",
              "dialogues": []
            },
            {
              "text": "那派蒙每天都在感谢…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那当然！我绝对每天都会把日子过得开开心心的！"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅也是哦！每天都应该吃饱睡好，想玩游戏了就来找我们吧！"
        },
        {
          "role": "哥伦比娅",
          "text": "哈哈，好呀。"
        },
        {
          "role": "哥伦比娅",
          "text": "以后玩「月亮棋」的时候，我或许都会想起那三位善良的女神吧…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（哥伦比娅）"
        },
        {
          "role": "哥伦比娅",
          "text": "我会继承她们的月光…"
        }
      ],
      "collapse_ranges": [
