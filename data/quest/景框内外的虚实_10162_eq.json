{
  "quest_id": 10162,
  "chapter_num": "铳枪与蔷薇 第二幕",
  "chapter_title": "景框内外的虚实",
  "type": "eq",
  "route": "Fiction and Reality Inside and Outside the Frame",
  "stories": [
    {
      "story_id": 40133,
      "title": "景框内外的虚实",
      "description": "映影拍摄顺利展开，留影机内记录的故事，似乎也在取景框外的某处上演…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到第二天早晨（8-10点）"
        },
        {
          "role": "派蒙",
          "text": "终于到集合的时候了！我昨晚做梦都在拍映影呢！"
        },
        {
          "role": "派蒙",
          "text": "我记得今天的集合地点是德波大饭店，快出发吧！"
        },
        {
          "type": "subtitle",
          "text": "前往德波大饭店进行拍摄"
        },
        {
          "role": "派蒙",
          "text": "绫华！宵宫！你们已经到啦？"
        },
        {
          "role": "神里绫华",
          "text": "二位早上好，我们从泽维尔先生那里听说了，你们昨天下午的进展很顺利。"
        },
        {
          "role": "派蒙",
          "text": "绫华呢？你们昨天有去哪里玩吗？"
        },
        {
          "role": "神里绫华",
          "text": "昨日分别之后，哥哥就去沫芒宫拜访最高审判官那维莱特先生了。"
        },
        {
          "role": "神里绫华",
          "text": "我本来也想一同前往，但哥哥说他一个人去就行，让我多观览枫丹的风景，感受当地文化。"
        },
        {
          "role": "神里绫华",
          "text": "所以，我就和宵宫一起乘巡轨船去了伊黎耶岛的歌剧院。"
        },
        {
          "role": "宵宫",
          "text": "结果歌剧院旁边有两位机关人偶在跳舞欸！你们知道的吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "歌裴莉娅的葬送…",
              "dialogues": []
            },
            {
              "text": "还有科培琉司的劫罚…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宵宫",
          "text": "对对对，就是那个！哇，那也太神奇了吧！"
        },
        {
          "role": "神里绫华",
          "text": "我们在那边坐了很久，感觉怎么都看不厌。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们第一次也是这样的。"
        },
        {
          "role": "宵宫",
          "text": "后来我们还去海边游泳了！准确来说是潜水吧，我还是第一次在水下呼吸！"
        },
        {
          "role": "宵宫",
          "text": "我牵着绫华的手，我们一起数数，三、二、一…然后「噗通」一下闷进水里。"
        },
        {
          "role": "宵宫",
          "text": "一开始我还是不敢张口，等到实在憋不住了才下定决心大吸一口。哈哈，结果没什么味道！一点也不像想象中的咸！"
        },
        {
          "role": "宵宫",
          "text": "但回过神来，我居然已经在正常呼吸了！好奇妙的感觉！听绫华说我太过紧张，都把她手给捏疼了。她倒是适应得很快。"
        },
        {
          "role": "神里绫华",
          "text": "我心想旅行者能做到，那我们一定也可以。就安心地潜下去了。"
        },
        {
          "role": "神里绫华",
          "text": "枫丹的海底的确很漂亮。我喜欢那些在水中盛开的海露花，看起来像夜晚街道上的烛灯。"
        },
        {
          "role": "宵宫",
          "text": "还有好多在稻妻看都没看到过的生物！"
        },
        {
          "role": "宵宫",
          "text": "那种会「咻咻咻」发出刀光一样的鱼，还有见到人就「嗡嗡嗡」的胖胖鱼！"
        },
        {
          "role": "派蒙",
          "text": "哦，是「猎刀鳐」和「膨膨兽」吧。"
        },
        {
          "role": "宵宫",
          "text": "哈哈，「膨膨兽」这名字好可爱。这要是回去和老爹还有大伯们说，他们恐怕都不会相信吧！"
        },
        {
          "role": "神里绫华",
          "text": "宵宫在海里游了好久，直到天黑我们才乘坐巡轨船回到枫丹廷。我都担心她今天会累到睡懒觉。"
        },
        {
          "role": "宵宫",
          "text": "我也怕自己起不来！晚上睡觉都感觉自己还在随着海浪一摇一摆的呢！"
        },
        {
          "role": "宵宫",
          "text": "但今早睁眼，想到能和大家一起拍映影，就一下子有精神了！"
        },
        {
          "role": "派蒙",
          "text": "说到拍映影，其他人去哪儿了？"
        },
        {
          "role": "神里绫华",
          "text": "哥哥和泽维尔先生一起，在和饭店老板协商拍摄场地的相关事宜，应该很快就会到。"
        },
        {
          "role": "神里绫华",
          "text": "其他人…"
        },
        {
          "role": "千织",
          "text": "我们来了。"
        },
        {
          "role": "夏沃蕾",
          "text": "抱歉到的晚了些，我刚结束特巡队早晨十公里的晨练。"
        },
        {
          "role": "派蒙",
          "text": "多少？"
        },
        {
          "role": "芙宁娜",
          "text": "啊——困死我了。在楼下就听到你们聊天的声音，真羡慕各位有用不完的活力。"
        },
        {
          "role": "神里绫华",
          "text": "几位早。"
        },
        {
          "role": "芙宁娜",
          "text": "早，谁能帮我去点杯咖啡？多点奶少点糖。"
        },
        {
          "role": "神里绫华",
          "text": "我去帮您拿一杯吧。"
        },
        {
          "role": "千织",
          "text": "你别去，过来这边坐好，我帮你化妆。要是衣服沾上咖啡渍就麻烦了。"
        },
        {
          "role": "宵宫",
          "text": "我去我去！这是助理该干的活嘛！"
        },
        {
          "role": "芙宁娜",
          "text": "她精神看起来真好，是有什么调理的秘诀吗？"
        },
        {
          "role": "派蒙",
          "text": "宵宫她一直都是这样的啦。倒是芙宁娜看起来很疲惫，是不习惯早起吗？"
        },
        {
          "role": "芙宁娜",
          "text": "当然不是！我可是花了一整晚从头到尾重新读了一遍小说，把我觉得需要删改和强调的段落都圈出来了。"
        },
        {
          "role": "派蒙",
          "text": "哇，没想到你对这件事这么上心！"
        },
        {
          "role": "芙宁娜",
          "text": "呵，再怎么说我也曾是枫丹人气第一的明星。怎么可能是浪得虚名？该认真的时候我还是会认真的。"
        },
        {
          "role": "芙宁娜",
          "text": "我扮演「神」的时候都尽心尽力，又有什么理由不认真演绎「自己」的人生呢？"
        },
        {
          "role": "宵宫",
          "text": "芙宁娜导演，您的咖啡来了。"
        },
        {
          "role": "芙宁娜",
          "text": "嗯，谢谢你。不管是这个称呼还是咖啡的香气，都如同清晨鸟儿的啼鸣一般沁人心脾。"
        },
        {
          "role": "泽维尔",
          "text": "看来大家都准时到场了。"
        },
        {
          "role": "神里绫人",
          "text": "已经和这里的老板协商好了，饭店二楼的区域可以作为取景地，供我们随意使用。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？那太好了！"
        },
        {
          "role": "神里绫人",
          "text": "他很看好这部映影，也希望这能为他招揽更多的客人。"
        },
        {
          "role": "神里绫人",
          "text": "那么，泽维尔先生，接下来就交给你了。"
        },
        {
          "role": "泽维尔",
          "text": "好的，谢谢。"
        },
        {
          "role": "泽维尔",
          "text": "先向大家介绍两位新成员——"
        },
        {
          "role": "泽维尔",
          "text": "这是我们团队的道具师，薇若妮卡。她将负责映影拍摄时所用到的道具。"
        },
        {
          "role": "泽维尔",
          "text": "这位是我们的灯光师，博诺。负责拍摄时的灯光设备和氛围照明。"
        },
        {
          "role": "派蒙",
          "text": "哦！真的有专业制作团队的感觉了呢！"
        },
        {
          "role": "泽维尔",
          "text": "请允许我，先向各位致以我最诚挚的谢意。"
        },
        {
          "role": "泽维尔",
          "text": "就在昨天，投资人告诉我资金跟不上的时候，我真的以为这部映影要拍不下去了。"
        },
        {
          "role": "泽维尔",
          "text": "但没想到，出现了这么多愿意帮我的人，我真的…真的太谢谢你们了。"
        },
        {
          "role": "神里绫华",
          "text": "别这么说，泽维尔先生。我们都很荣幸加入你的映影团队。"
        },
        {
          "role": "神里绫人",
          "text": "还在稻妻的时候，您的作品就给我留下了很深的印象。"
        },
        {
          "role": "神里绫人",
          "text": "日后，这部作品一定会成为枫丹与稻妻文化沟通的桥梁。"
        },
        {
          "role": "芙宁娜",
          "text": "我是为了故事才来的，我可不敢想象这部片子没了最好的导演会变成什么样。"
        },
        {
          "role": "泽维尔",
          "text": "总之，我向大家保证。作为这部映影的制片人，我一定不惜一切确保它能顺利上映。"
        },
        {
          "role": "泽维尔",
          "text": "这不是我一个人的映影，他包含着诸位的心意，还有咱们即将为其付出的无限心血！"
        },
        {
          "role": "泽维尔",
          "text": "那么我宣布，映影《两个铳枪手》，正式开拍！"
        },
        {
          "role": "泽维尔",
          "text": "芙宁娜导演，现场就交给你了。"
        },
        {
          "role": "芙宁娜",
          "text": "好了好了，大家都看过来！"
        },
        {
          "role": "芙宁娜",
          "text": "第一场先拍两位铳枪手在伯爵家的懵懂阶段，灯光和道具师布置一下现场、两位主演先去一旁化妆、群众演员过一下站位…"
        },
        {
          "role": "派蒙",
          "text": "哦，芙宁娜做导演还真有两下子呢。"
        },
        {
          "role": "芙宁娜",
          "text": "都听清楚了吗？我可不希望待会儿有人像伞雀一样在拍摄现场到处乱转。"
        },
        {
          "role": "芙宁娜",
          "text": "好了，都动起来！等场景布置好就开拍！让这部映影如海啸般席卷枫丹吧！"
        },
        {
          "role": "芙宁娜",
          "text": "呃，我是说…给人震撼的那种，不是淹没的那种…"
        },
        {
          "role": "派蒙",
          "text": "虽然好像还是有些心理阴影…"
        },
        {
          "role": "派蒙",
          "text": "总之，我们也去看看有什么能帮上忙的吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（芙宁娜）"
        },
        {
          "role": "芙宁娜",
          "text": "我这里没什么需要帮忙的，去看看其他人吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（神里绫华&夏沃蕾）"
        },
        {
          "role": "神里绫华",
          "text": "…铳枪，原来长这个样子呀。"
        },
        {
          "role": "夏沃蕾",
          "text": "不完全是。"
        },
        {
          "type": "subtitle",
          "text": "寻找需要帮忙的人"
        },
        {
          "role": "宵宫",
          "text": "放这里就可以了吗？"
        },
        {
          "role": "博诺",
          "text": "再往左边一点。"
        },
        {
          "role": "宵宫",
          "text": "好的！"
        },
        {
          "role": "派蒙",
          "text": "宵宫，需要帮忙吗？"
        },
        {
          "role": "宵宫",
          "text": "哦，没事没事，我不忙，灯光布置和放烟花很像，想象着它等下会营造出的氛围，可有意思了！"
        },
        {
          "role": "宵宫",
          "text": "我记得旅行者负责摄影，派蒙负责场记是吧？哈哈，真适合你们呢。"
        },
        {
          "role": "派蒙",
          "text": "咦？是因为我飞着打板很方便吗？"
        },
        {
          "role": "宵宫",
          "text": "这也有啦，但我说的不是这种适合。"
        },
        {
          "role": "宵宫",
          "text": "我是觉得，你们一路旅行相伴，合作起来一定会非常默契！毕竟摄影师需要在场记打板后才开始拍摄，我没记错吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "其实在打板前就开始了。",
              "dialogues": []
            },
            {
              "text": "只是后期把打板器剪掉。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宵宫",
          "text": "原来是这样吗！哈哈哈，映影还真是神奇！"
        },
        {
          "role": "博诺",
          "text": "宵宫小姐，那边的灯也拜托了！"
        },
        {
          "role": "宵宫",
          "text": "好！这就来！"
        },
        {
          "role": "宵宫",
          "text": "那我先去帮忙了，待会儿再聊。这么多人合作拍一部映影的感觉，真的好令人激动！"
        },
        {
          "role": "派蒙",
          "text": "宵宫还真是乐在其中。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们的确像宵宫说的那样有默契吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那还用说？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，能听到你这么说真好！"
        },
        {
          "role": "千织",
          "text": "……"
        },
        {
          "role": "神里绫人",
          "text": "绫华和我提起过你，说你们儿时感情不错。"
        },
        {
          "role": "千织",
          "text": "别说话，我在思考你眼睛的妆容。"
        },
        {
          "role": "神里绫人",
          "text": "为了贴合故事主角？"
        },
        {
          "role": "千织",
          "text": "为了解决「懵懂」这场戏的问题。"
        },
        {
          "role": "神里绫人",
          "text": "是我眼旁的皱纹太深了？"
        },
        {
          "role": "千织",
          "text": "是你眼里的城府太深了。"
        },
        {
          "role": "神里绫人",
          "text": "哈，还是和以前一样直言不讳。"
        },
        {
          "role": "千织",
          "text": "…安静。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（千织）"
        },
        {
          "role": "千织",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "准备开始拍摄"
        },
        {
          "role": "神里绫华",
          "text": "这个就是铳枪吗？"
        },
        {
          "role": "薇若妮卡",
          "text": "只是根据铳枪的样子制作的道具。"
        },
        {
          "role": "夏沃蕾",
          "text": "做得不错，你见过真枪？"
        },
        {
          "role": "薇若妮卡",
          "text": "只在书本和报纸上见过。这是我参考着图片上的比例和形状制作的。"
        },
        {
          "role": "薇若妮卡",
          "text": "需要拍摄的时候，在枪口涂上一些特制的火药，就能展现出开枪时的火光和烟雾。"
        },
        {
          "role": "夏沃蕾",
          "text": "也就是说，枪械的后坐力需要演员去展现。"
        },
        {
          "role": "薇若妮卡",
          "text": "没错，还有枪响其实也是通过后期剪辑加入。"
        },
        {
          "role": "夏沃蕾",
          "text": "谢谢你，薇若妮卡。我知道该从哪里入手指导了。"
        },
        {
          "role": "夏沃蕾",
          "text": "不过，铳枪的齿轮和撞针处要再调整一下，加一些金属摩擦的痕迹会更加真实。"
        },
        {
          "role": "夏沃蕾",
          "text": "另外每次拍摄前用油擦一遍，这会显得枪械经过细心保养。"
        },
        {
          "role": "薇若妮卡",
          "text": "我明白了。"
        },
        {
          "role": "神里绫华",
          "text": "不愧是夏沃蕾小姐，看来您平时经常和枪械打交道。"
        },
        {
          "role": "夏沃蕾",
          "text": "我每天都会保养自己的枪械，从不懈怠。对铳枪手来说，这就和吃饭睡觉一样不会忘。"
        },
        {
          "role": "神里绫华",
          "text": "我也会每天保养自己的刀剑，熟悉它的形状、重量，让它成为自己身体的一部分。"
        },
        {
          "role": "夏沃蕾",
          "text": "这样在关键时候，它才不会背叛你。"
        },
        {
          "role": "神里绫华",
          "text": "没错，看来在这方面，我们有很多相似之处。"
        },
        {
          "role": "派蒙",
          "text": "感觉她们二人找到了共同话题呢。"
        },
        {
          "role": "夏沃蕾",
          "text": "我使用的铳枪和这个道具不太一样，不过我还是能告诉你一些要点。"
        },
        {
          "role": "神里绫华",
          "text": "好的，那就烦请您赐教了。"
        },
        {
          "role": "夏沃蕾",
          "text": "首先最重要的一点，枪口永远不要对着别人。不管是真枪还是假枪，枪在手中还是在桌上。对敌人那是另一回事。"
        },
        {
          "role": "神里绫华",
          "text": "我明白了。"
        },
        {
          "role": "夏沃蕾",
          "text": "举枪时手伸直、与肩平齐，眼睛穿过表尺和准星瞄向目标。"
        },
        {
          "role": "神里绫华",
          "text": "这样吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "差不多，试着说台词。"
        },
        {
          "role": "神里绫华",
          "text": "…这就是你的末路。"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯，身子再侧一些，这样你留给敌人的目标更小，肩膀放松。我来示范一次。"
        },
        {
          "role": "夏沃蕾",
          "text": "…这就是你的末路。"
        },
        {
          "role": "神里绫人",
          "text": "……"
        },
        {
          "role": "神里绫人",
          "text": "…失陪一下，千织小姐。"
        },
        {
          "role": "神里绫人",
          "text": "芙宁娜导演，有件事想和您商量。"
        },
        {
          "role": "芙宁娜",
          "text": "嗯？你说吧。"
        },
        {
          "role": "神里绫华",
          "text": "这样？"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯，好多了。"
        },
        {
          "role": "神里绫人",
          "text": "…您觉得怎么样？"
        },
        {
          "role": "芙宁娜",
          "text": "嗯，我看到了，你说的有道理，但你确定要这么做吗？"
        },
        {
          "role": "神里绫人",
          "text": "这样或许更合适。"
        },
        {
          "role": "芙宁娜",
          "text": "好吧。看你那么坚持…我知道了。"
        },
        {
          "role": "芙宁娜",
          "text": "咳咳，绫华小姐，夏沃蕾小姐，能到我这边来一下吗？"
        },
        {
          "role": "派蒙",
          "text": "咦？什么事，这就要开拍了吗？"
        },
        {
          "role": "神里绫华",
          "text": "我们过去吧。"
        },
        {
          "role": "夏沃蕾",
          "text": "什么事？"
        },
        {
          "role": "芙宁娜",
          "text": "那我直接问吧。夏沃蕾小姐，你愿意来出演铳枪手这个角色吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "…什么？"
        },
        {
          "role": "神里绫人",
          "text": "准确来说，是我想将我的角色让给夏沃蕾小姐。"
        },
        {
          "role": "神里绫华",
          "text": "可是…哥哥…"
        },
        {
          "role": "神里绫人",
          "text": "别担心，绫华，这对我来说反倒是好事。"
        },
        {
          "role": "神里绫人",
          "text": "我原本还在想，要怎么在拍摄之余抽出时间，去联系沫芒宫的人推进文化合作事宜，听说这里的手续很复杂。"
        },
        {
          "role": "神里绫人",
          "text": "现在，我可以专心把精力放在工作上了。而且，你知道我不太适合抛头露面的演戏工作。"
        },
        {
          "role": "神里绫华",
          "text": "…真的没关系吗？"
        },
        {
          "role": "芙宁娜",
          "text": "从导演的角度，我也觉得原著里两个铳枪手的关系有需要改进的地方。"
        },
        {
          "role": "芙宁娜",
          "text": "故事里的哥哥在事件中占据了主导，盛气凌人。这让妹妹的戏份被压了下去，无法体现二者相互扶持、相依为命的主题。"
        },
        {
          "role": "芙宁娜",
          "text": "但要是把两位主角换成年龄相仿的姐妹…这部片子反倒更有看头。"
        },
        {
          "role": "芙宁娜",
          "text": "而且我看到你指导绫华小姐的样子了，那冷酷威严的气质正是扮演铳枪手的不二人选。"
        },
        {
          "role": "神里绫人",
          "text": "当然，说了这么多，最后还是得看夏沃蕾小姐的意见。"
        },
        {
          "role": "夏沃蕾",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "我记得夏沃蕾很喜欢这本小说吧？她应该会想演的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要看工作方不方便。",
              "dialogues": []
            },
            {
              "text": "要看她喜不喜欢演戏。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "…好，我接下这个角色。"
        },
        {
          "role": "芙宁娜",
          "text": "那就没什么问题了，我现在就着手剧本的修改。"
        },
        {
          "role": "芙宁娜",
          "text": "灯光、道具、服装，马上根据演员的情况调整。"
        },
        {
          "role": "芙宁娜",
          "text": "啊，我有预感，这一定会是个超越原著的故事！"
        },
        {
          "role": "神里绫人",
          "text": "多谢夏沃蕾小姐，你帮了我很大的忙。"
        },
        {
          "role": "夏沃蕾",
          "text": "您言重了，我喜欢这个角色，这么说来该是我谢你。"
        },
        {
          "role": "神里绫华",
          "text": "既然是哥哥的考量，那我也不再担心。"
        },
        {
          "role": "神里绫华",
          "text": "走吧，夏沃蕾小姐，接下来还拜托你多多关照了。"
        },
        {
          "role": "夏沃蕾",
          "text": "叫我夏沃蕾就好。"
        },
        {
          "role": "千织",
          "text": "你就是这么解决我化妆遇到的难题？"
        },
        {
          "role": "神里绫人",
          "text": "你说笑了，我更多还是为了公事。"
        },
        {
          "role": "千织",
          "text": "得了吧，这理由哄不到我。绫华口中的「哥哥」可是能同时处理十件事的人。你肯定还有别的理由。"
        },
        {
          "role": "神里绫人",
          "text": "或许是吧。绫华一直说想出来看看，像旅行者那样拓宽自己的眼界。"
        },
        {
          "role": "神里绫人",
          "text": "但我觉得，她需要的不只是他国不同的风景，还需要一些不同的朋友。如果一直有「哥哥」在身旁，朋友就不那么容易交到了。"
        },
        {
          "role": "千织",
          "text": "你这个「哥哥」就继续宠着妹妹吧。"
        },
        {
          "role": "派蒙",
          "text": "绫人！好可惜啊，我还想看你是怎么演铳枪手的呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「这就是对你的制裁！」",
              "dialogues": []
            },
            {
              "text": "「这就是正义！」",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫人",
          "text": "二位就别寻我开心了。我打赌你们心里也觉得我不适合说出这些台词。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，其实，我还真想象不出。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "接下来要去工作吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫人",
          "text": "嗯，约了沫芒宫的人晚些见面。现在有更多时间准备了。"
        },
        {
          "role": "芙宁娜",
          "text": "摄影师准备！场记准备！演员准备！第一场戏要开拍了！"
        },
        {
          "role": "神里绫人",
          "text": "去吧，绫华就拜托你们了。"
        },
        {
          "role": "派蒙",
          "text": "嗯，放心吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "包在我们身上。",
              "dialogues": []
            },
            {
              "text": "工作顺利。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "神里绫人",
          "text": "嗯，期待各位的成片。"
        },
        {
          "role": "芙宁娜",
          "text": "好了，各就各位。我简单说一下这场戏的要点——"
        },
        {
          "role": "芙宁娜",
          "text": "这是两位主角还住在伯爵家时发生的事，她们被家中人排挤、恶语相向，但还无法理解发生了什么，这个懵懂的度要把握好。"
        },
        {
          "role": "芙宁娜",
          "text": "夏沃蕾扮演姐姐「图利佩」，绫华小姐扮演妹妹「爱芮丝」。摄影师注意在关键时候给到主角特写。"
        },
        {
          "role": "芙宁娜",
          "text": "那么，全场安静！三、二、一，开始！"
        },
        {
          "role": "派蒙",
          "text": "嘿！"
        },
        {
          "role": "「爱芮丝」",
          "text": "…姐姐。母亲她已经出去很久了。"
        },
        {
          "role": "「图利佩」",
          "text": "可能是绕路去采花了吧，母亲她喜欢花。"
        },
        {
          "role": "「瑞莲」",
          "text": "爱芮丝、图利佩，我回来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（给母亲近景）",
              "dialogues": []
            },
            {
              "text": "（给环境远景）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「爱芮丝」",
          "text": "…母亲！您这次去的好久，我和姐姐都担心死了。"
        },
        {
          "role": "「瑞莲」",
          "text": "抱歉抱歉，我这不是回来了吗？看，这是你们爱吃的苹果馅饼。"
        },
        {
          "role": "「图利佩」",
          "text": "母亲…你手上的淤青是怎么回事？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（给母亲特写）",
              "dialogues": []
            },
            {
              "text": "（给「图利佩」特写）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「瑞莲」",
          "text": "咦？有吗？那…一定是昨天干活的时候不小心碰到的吧。"
        },
        {
          "role": "「图利佩」",
          "text": "可早上我都没看到这些淤青。"
        },
        {
          "role": "「瑞莲」",
          "text": "那一定是我出去的时候不小心摔倒了吧。"
        },
        {
          "role": "「瑞莲」",
          "text": "说起来，你们在家里玩得还愉快吗？"
        },
        {
          "role": "「爱芮丝」",
          "text": "……"
        },
        {
          "role": "「瑞莲」",
          "text": "怎么了？爱芮丝。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（拍摄「爱芮丝」）",
              "dialogues": []
            },
            {
              "text": "（拍摄周围环境）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「爱芮丝」",
          "text": "其实，大家都不愿意和我们玩。"
        },
        {
          "role": "「图利佩」",
          "text": "他们还抢走了爱芮丝的玩偶，朝我们吐唾沫。"
        },
        {
          "role": "「瑞莲」",
          "text": "……"
        },
        {
          "role": "「爱芮丝」",
          "text": "他们骂我们是…是…"
        },
        {
          "role": "「瑞莲」",
          "text": "嘘嘘嘘…没事，没事…女儿们，听我说…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（拍摄三人的全景）",
              "dialogues": []
            },
            {
              "text": "（依次拍摄每个人的特写）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「瑞莲」",
          "text": "不管别人怎么说，这都不重要，他们无法用单纯的词语来将你们定义。"
        },
        {
          "role": "「瑞莲」",
          "text": "你们所拥有的人生，正如你们的名字一样，是无比绚烂的花朵。"
        },
        {
          "role": "「瑞莲」",
          "text": "或许它现在仍含苞未放，但总有一天，它会绽放得比任何东西都要美丽。"
        },
        {
          "role": "「瑞莲」",
          "text": "不要让现在的土壤，掐灭了花儿将来的盛放。懂了吗？我的乖女儿们。"
        },
        {
          "role": "芙宁娜",
          "text": "——停！"
        },
        {
          "role": "芙宁娜",
          "text": "这条不错，演员的情感也很到位，可以保留。"
        },
        {
          "role": "芙宁娜",
          "text": "另外，场记下次打板时不要喊出声音。"
        },
        {
          "role": "派蒙",
          "text": "呃，好…好的…"
        },
        {
          "role": "神里绫华",
          "text": "…太好了，我还担心刚才自己太紧张。夏沃蕾你呢？"
        },
        {
          "role": "夏沃蕾",
          "text": "我没什么，台词没有太多难度，应该是导演为我改过。"
        },
        {
          "role": "埃兰",
          "text": "呵呵，两位演得都不错，完全不像是第一次接触映影。再有些自信也可以哟。"
        },
        {
          "role": "神里绫华",
          "text": "谢谢您的鼓励。"
        },
        {
          "role": "芙宁娜",
          "text": "演员就位！我们再多试几个角度后就进入下一场！"
        },
        {
          "type": "subtitle",
          "text": "拍摄稳步进行，芙宁娜将细节调整至她满意之后，进入了第二场拍摄…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "芙宁娜",
          "text": "这场是两位主角回到家中发现母亲遇害的戏，准备好，三、二、一，开始！"
        },
        {
          "role": "「爱芮丝」",
          "text": "母亲，我们回来了。"
        },
        {
          "role": "「爱芮丝」",
          "text": "…母亲不在吗？"
        },
        {
          "role": "「图利佩」",
          "text": "……！"
        },
        {
          "role": "「爱芮丝」",
          "text": "怎么了，姐姐？"
        },
        {
          "role": "「图利佩」",
          "text": "爱芮丝，别过来！"
        },
        {
          "role": "「爱芮丝」",
          "text": "欸？为什么…"
        },
        {
          "role": "「爱芮丝」",
          "text": "…！母亲！"
        },
        {
          "role": "「爱芮丝」",
          "text": "姐姐…母亲她…"
        },
        {
          "role": "「图利佩」",
          "text": "……"
        },
        {
          "role": "「图利佩」",
          "text": "这茶杯里…是毒药。"
        },
        {
          "role": "「爱芮丝」",
          "text": "这杯子的样式…"
        },
        {
          "role": "「图利佩」",
          "text": "嘁…这帮贵族，连藏都不打算藏一下吗！"
        },
        {
          "role": "「爱芮丝」",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "「爱芮丝」流下了眼泪…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「图利佩」",
          "text": "……"
        },
        {
          "role": "「图利佩」",
          "text": "…爱芮丝，该走了。"
        },
        {
          "role": "「爱芮丝」",
          "text": "…走？母亲已经不在了…我们还能去哪里…"
        },
        {
          "role": "「图利佩」",
          "text": "去哪里都行，我们得离开这个家。"
        },
        {
          "role": "「爱芮丝」",
          "text": "可是…难道就让那些人…"
        },
        {
          "role": "「图利佩」",
          "text": "我们会报仇的，我向你保证…但不是现在…"
        },
        {
          "role": "「爱芮丝」",
          "text": "……"
        },
        {
          "role": "「图利佩」",
          "text": "…走吧。"
        },
        {
          "role": "「爱芮丝」",
          "text": "不，等等…"
        },
        {
          "role": "「爱芮丝」",
          "text": "不能让母亲就这么死去…至少…让我在她胸前放上一朵蔷薇…"
        },
        {
          "role": "「爱芮丝」",
          "text": "我们，不就是为了给母亲买这个才出去的吗…"
        },
        {
          "role": "「图利佩」",
          "text": "…好。"
        },
        {
          "role": "「图利佩」",
          "text": "…再见了，母亲。我们一定会为你报仇的。"
        },
        {
          "role": "芙宁娜",
          "text": "——停！"
        },
        {
          "role": "芙宁娜",
          "text": "漂亮，演得太出色了！"
        },
        {
          "role": "宵宫",
          "text": "我的天，绫华你也太厉害了吧！那些眼泪是真的吗？怎么流出来的？"
        },
        {
          "role": "夏沃蕾",
          "text": "我也很惊讶。"
        },
        {
          "role": "神里绫华",
          "text": "谢谢你们的肯定。其实，我只是听到导演喊「开始」之后，就告诉自己什么都不要想，单纯去感受故事中主角的心情，融入在其中。"
        },
        {
          "role": "神里绫华",
          "text": "这和练习剑道的心得相仿，什么都不想，专注于体会眼前的一切。"
        },
        {
          "role": "芙宁娜",
          "text": "（这姑娘…难不成是个演戏的天才？）"
        },
        {
          "role": "芙宁娜",
          "text": "大家静一静，我们要开始下一场了！"
        },
        {
          "type": "subtitle",
          "text": "与夏沃蕾对话"
        },
        {
          "type": "subtitle",
          "text": "一天的拍摄时间很快过去…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "呼！这就结束了吗？打板器我都还没玩够呢。"
        },
        {
          "role": "派蒙",
          "text": "怎么样？胳膊酸吗？你可是一直在举着摄像机呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有一点…",
              "dialogues": []
            },
            {
              "text": "但很有趣…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "二位辛苦了。"
        },
        {
          "role": "派蒙",
          "text": "夏沃蕾也演得不错呢。"
        },
        {
          "role": "夏沃蕾",
          "text": "这部小说我翻了很多次，能参透主角心理。"
        },
        {
          "role": "夏沃蕾",
          "text": "怎么样？还记得我昨天的请求吗？"
        },
        {
          "role": "派蒙",
          "text": "哦！玩得太高兴差点忘了…"
        },
        {
          "role": "派蒙",
          "text": "是说案件手法和故事里的挺像对吧？唔…具体是哪里比较像呢？"
        },
        {
          "role": "夏沃蕾",
          "text": "故事里的主角成长后，成为了两位铳枪手，每次都使用铳枪进行复仇。"
        },
        {
          "role": "夏沃蕾",
          "text": "除此之外，他们还会在死者身上放上一朵虹彩蔷薇，以此发出「我们回来了」的信号。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道说…",
              "dialogues": []
            },
            {
              "text": "现场也有这种花？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "没错，你很敏锐。就是小说中的虹彩蔷薇。"
        },
        {
          "role": "派蒙",
          "text": "欸！这，这真的让人越来越在意了。"
        },
        {
          "role": "派蒙",
          "text": "特别是看完今天的剧本，连我也止不住会想是不是真有什么隐情…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你觉得呢？你脑袋聪明，我听你的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只是协助的话…",
              "dialogues": []
            },
            {
              "text": "那我们加入…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "好。我代表枫丹特巡队感谢你的正义感。"
        },
        {
          "role": "夏沃蕾",
          "text": "事不宜迟，我们现在就出发去调查。跟我走吧。"
        },
        {
          "role": "派蒙",
          "text": "欸？现在吗？我都拍了一天戏，好累…"
        },
        {
          "role": "夏沃蕾",
          "text": "有价值的情报往往在天黑以后才露面，它们仿佛海上的孤岛，要是不打起精神，你就会在迷雾中与之擦身而过。"
        },
        {
          "role": "夏沃蕾",
          "text": "我喜欢的一本书里说的。"
        },
        {
          "type": "subtitle",
          "text": "前往莱舒的发条工坊进行调查"
        },
        {
          "role": "派蒙",
          "text": "我们现在要去哪里调查呢？"
        },
        {
          "role": "夏沃蕾",
          "text": "先去几处买零件的工坊吧，如果罪犯需要自己制造枪械，就很有可能光顾这些地方。"
        },
        {
          "role": "利弗",
          "text": "欢迎光临莱舒的发条工坊，几位有什么需要吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "我想知道最近有没有什么人来买过一些比较特别的零件。"
        },
        {
          "role": "利弗",
          "text": "特别的零件？您指的是…"
        },
        {
          "role": "夏沃蕾",
          "text": "就是不会用在发条玩具上，而是用在枪械上的那种。"
        },
        {
          "role": "利弗",
          "text": "这…瞧您说的，我们可不会卖那种…"
        },
        {
          "role": "夏沃蕾",
          "text": "我不是找你麻烦，单纯在调查案件，希望你配合一下。"
        },
        {
          "role": "利弗",
          "text": "老实说，我也不知道什么零件是能用在枪上的…"
        },
        {
          "role": "夏沃蕾",
          "text": "有没有以个人名义来购置零件的人？"
        },
        {
          "role": "利弗",
          "text": "买玩具的人倒是不少，但购置零件的都是以公司名义过来进货的老顾客。"
        },
        {
          "role": "夏沃蕾",
          "text": "这样吗…我知道了，谢谢你的配合。"
        },
        {
          "role": "利弗",
          "text": "这是小店应该做的。"
        },
        {
          "type": "subtitle",
          "text": "前往博蒙特工坊进行调查"
        },
        {
          "role": "伊丝黛莱",
          "text": "嗯？这不是夏沃蕾吗？保养铳枪的油又用完了？"
        },
        {
          "role": "夏沃蕾",
          "text": "伊丝黛莱小姐，我想了解一下最近有没有人在你这里订购过枪械的零件。"
        },
        {
          "role": "伊丝黛莱",
          "text": "哦，在查案啊？让我想想…"
        },
        {
          "role": "伊丝黛莱",
          "text": "好像还真没有，虽然最近千灵映影节有一些人拜托我制作枪械道具，但我都拒绝了。"
        },
        {
          "role": "派蒙",
          "text": "咦？这是为什么？"
        },
        {
          "role": "伊丝黛莱",
          "text": "不赚钱呀！我的机械都是为了做真家伙准备的，没精力专门为节日做一个新的模具。"
        },
        {
          "role": "夏沃蕾",
          "text": "那有人向你讨过什么零件吗？"
        },
        {
          "role": "伊丝黛莱",
          "text": "这…我平时的废铜烂铁都卖到灰河那边去的，不会单独给别人。"
        },
        {
          "role": "夏沃蕾",
          "text": "我知道了，谢谢你的配合。"
        },
        {
          "role": "伊丝黛莱",
          "text": "别客气，只要铳枪队多光顾我生意就行。"
        },
        {
          "role": "派蒙",
          "text": "好像没有什么值得追下去的信息。"
        },
        {
          "role": "夏沃蕾",
          "text": "目前还没有，我们接下来去灰河。"
        },
        {
          "role": "派蒙",
          "text": "欸？没问题吗？特巡队队长出现在那种地方的话，不会受欢迎的吧？"
        },
        {
          "role": "夏沃蕾",
          "text": "哦，这样吗，原来你们不知道啊。"
        },
        {
          "role": "派蒙",
          "text": "知道什么？"
        },
        {
          "role": "夏沃蕾",
          "text": "我就是在灰河长大的。"
        },
        {
          "type": "subtitle",
          "text": "前往灰河进行调查"
        },
        {
          "type": "subtitle",
          "text": "在灰河进行调查"
        },
        {
          "role": "夏沃蕾",
          "text": "你好，我想打听一些事。"
        },
        {
          "role": "埃米雷德",
          "text": "我什么都不知道。"
        },
        {
          "role": "夏沃蕾",
          "text": "别紧张，我没想逮捕谁。"
        },
        {
          "role": "埃米雷德",
          "text": "一开始都这么说。"
        },
        {
          "role": "夏沃蕾",
          "text": "是真的，我用这个向你保证。"
        },
        {
          "role": "派蒙",
          "text": "我，我没看错吧？特巡队队长在贿赂民众！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嘘！",
              "dialogues": []
            },
            {
              "text": "不说就是没发生。",
              "dialogues": []
            },
            {
              "text": "另外这叫收买。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "埃米雷德",
          "text": "看来你不是一般的警备队。"
        },
        {
          "role": "埃米雷德",
          "text": "想知道什么？"
        },
        {
          "role": "夏沃蕾",
          "text": "最近灰河有没有什么和铳枪有关的事件？大大小小都可以。"
        },
        {
          "role": "埃米雷德",
          "text": "铳枪啊…我只知道从两星期前开始，晚上就经常传来几声巨响，把我吵得从梦里吓醒。"
        },
        {
          "role": "夏沃蕾",
          "text": "枪响？"
        },
        {
          "role": "埃米雷德",
          "text": "大概吧，在这里区别不大。"
        },
        {
          "role": "埃米雷德",
          "text": "谁家房檐掉了、哪里管道突然炸了…总之都响得很。但我说的那几次都是在入睡后听见的。"
        },
        {
          "role": "夏沃蕾",
          "text": "知道具体位置吗？"
        },
        {
          "role": "埃米雷德",
          "text": "记不清。"
        },
        {
          "role": "夏沃蕾",
          "text": "是记不清，还是要再想想？"
        },
        {
          "role": "埃米雷德",
          "text": "你觉得呢？"
        },
        {
          "role": "夏沃蕾",
          "text": "那麻烦再想想。"
        },
        {
          "role": "派蒙",
          "text": "她又递摩拉了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我看不见。",
              "dialogues": []
            },
            {
              "text": "可能只是果果软糖。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "埃米雷德",
          "text": "是南边水道的尽头。我有次睡得浅，出去看过。但没敢走近。"
        },
        {
          "role": "埃米雷德",
          "text": "我知道的就这些。"
        },
        {
          "role": "夏沃蕾",
          "text": "行，我相信你。"
        },
        {
          "role": "埃米雷德",
          "text": "谢谢你的果果软糖了。"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "夏沃蕾",
          "text": "没什么好惊讶的，我说过自己在这里长大，这些手段我都清楚。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么手段？",
              "dialogues": [
                {
                  "role": "夏沃蕾",
                  "text": "看来你很能保守秘密。"
                }
              ]
            },
            {
              "text": "我也想要果果软糖。",
              "dialogues": [
                {
                  "role": "夏沃蕾",
                  "text": "真可惜，我刚刚分完了。"
                },
                {
                  "role": "夏沃蕾",
                  "text": "我倒是还带了很多其他罪恶的食品，薯条、炸鸡、洋葱圈…"
                },
                {
                  "role": "夏沃蕾",
                  "text": "但消灭罪恶是我的职责，就不用你出手了。"
                }
              ]
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "我们继续吧。"
        },
        {
          "role": "夏沃蕾",
          "text": "好久不见，泰托。"
        },
        {
          "role": "泰托",
          "text": "…有话直说。"
        },
        {
          "role": "夏沃蕾",
          "text": "我想打听一下最近有没有人在讨论关于铳枪的话题。"
        },
        {
          "role": "泰托",
          "text": "「情报」是有价格的。"
        },
        {
          "role": "夏沃蕾",
          "text": "听说最近野外强盗猖獗，白淞镇的物资受到了影响，我多支援一些人力帮忙如何？"
        },
        {
          "role": "泰托",
          "text": "呵呵，还是和以前一样好说话。"
        },
        {
          "role": "泰托",
          "text": "一个月前有兄弟晚上喝多了，弄丢了把枪，结果三天后在酒馆角落里找到了。"
        },
        {
          "role": "派蒙",
          "text": "这有什么奇怪的？就是他自己忘在那里了吧？"
        },
        {
          "role": "泰托",
          "text": "这里是灰河，朋友，酒馆里但凡有没主的值钱东西，哪怕是只耗子都留不到第二天。"
        },
        {
          "role": "泰托",
          "text": "结果那支铳枪却被还回来了，完好无损，没开过火，图什么？"
        },
        {
          "role": "夏沃蕾",
          "text": "我猜是因为那枪有前科。"
        },
        {
          "role": "泰托",
          "text": "怕弹痕被逐影庭查出来？或许吧。如果真是这样，那犯人还真是谨慎。"
        },
        {
          "role": "夏沃蕾",
          "text": "我没说有人犯案。"
        },
        {
          "role": "泰托",
          "text": "在灰河，知道谁被杀了就和知道自己今天穿了什么一样简单。"
        },
        {
          "role": "泰托",
          "text": "是住在东边那家伙对吧？我向来不喜欢他。每次只点一杯酒，眼睛里都是坏点子。"
        },
        {
          "role": "派蒙",
          "text": "丢枪的那人是谁呀？"
        },
        {
          "role": "泰托",
          "text": "省省吧，就算去问，他也不会向一位特巡队队长，或是一位陌生人承认自己有枪的。"
        },
        {
          "role": "夏沃蕾",
          "text": "…他说得对。"
        },
        {
          "role": "泰托",
          "text": "我知道你是在这里长大的，夏沃蕾。"
        },
        {
          "role": "泰托",
          "text": "尽管「刺玫会」欢迎你，但你离开得久了，有好多人不认识你。还有好多人不喜欢特巡队。"
        },
        {
          "role": "夏沃蕾",
          "text": "我知道。"
        },
        {
          "role": "泰托",
          "text": "所以，为了你的安全，给你个建议，最好少在这里抛头露面。"
        },
        {
          "role": "夏沃蕾",
          "text": "我想来就来想走就走。而且鉴于工作原因，恐怕还会多来几次。"
        },
        {
          "role": "泰托",
          "text": "…好吧，反正建议我是给了。"
        },
        {
          "role": "派蒙",
          "text": "坏了的木板和碎掉的木桶，还有一些…酒瓶？"
        },
        {
          "role": "夏沃蕾",
          "text": "仔细看，派蒙。"
        },
        {
          "role": "派蒙",
          "text": "嗯？"
        },
        {
          "role": "夏沃蕾",
          "text": "虽然被清理过一次，但这明显就是被铳枪子弹穿透的焦痕。"
        },
        {
          "role": "夏沃蕾",
          "text": "也就是说，有人在这里练过枪。酒瓶和木桶是用来当靶子的。"
        },
        {
          "role": "派蒙",
          "text": "会是那位凶手吗！"
        },
        {
          "role": "夏沃蕾",
          "text": "我猜是的。虽然灰河有枪的人不少，但没人会这么在意自己留下的弹痕，更别说花功夫清理掉了。"
        },
        {
          "role": "夏沃蕾",
          "text": "走吧，我们继续调查。"
        },
        {
          "type": "subtitle",
          "text": "观察"
        },
        {
          "type": "subtitle",
          "text": "碎掉的木桶和酒瓶…其中一些有着被子弹穿透的焦痕…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与夏沃蕾对话"
        },
        {
          "role": "夏沃蕾",
          "text": "应该就只有这些信息了。"
        },
        {
          "role": "派蒙",
          "text": "感觉这里的线索比上面多呢！"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯，假设这些线索都指向我们的嫌疑人，那么大体能得到以下推论——"
        },
        {
          "role": "夏沃蕾",
          "text": "一个月前，有人捡到了一把枪，将它带回家后可能经过拆卸，弄清枪支构造后，又还了回去。"
        },
        {
          "role": "夏沃蕾",
          "text": "经过几星期时间，他自己拼凑出了一把铳枪，带到灰河来练习打靶。"
        },
        {
          "role": "夏沃蕾",
          "text": "然后在几天前，他找到了自己的目标，实施犯罪，并且像小说中那样，放上了一朵虹彩蔷薇。"
        },
        {
          "role": "派蒙",
          "text": "…唔，虽然听你这么一说是顺的，但还是很难知道凶手是谁。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于死者…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "死者生活在灰河，据说常年独来独往，生活状况窘迫。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "故事中的是「贵族」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "嗯…这也是我没弄清的地方。"
        },
        {
          "role": "夏沃蕾",
          "text": "如果真的像小说中那样有隐情的话，这应该是一场仇杀。但调查结果是，死者没有明显的仇人。"
        },
        {
          "role": "夏沃蕾",
          "text": "他本身坏事没有少做，只是没有那种会让人对他开一枪后留下蔷薇的仇人。"
        },
        {
          "role": "夏沃蕾",
          "text": "犯人…到底在传达什么信息，又是在向谁传达呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小说作者的嫌疑…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "我们一开始就排查过了。"
        },
        {
          "role": "夏沃蕾",
          "text": "他声称案发当日一整天都在歌剧院，那里的检票员也证实了他的说法。"
        },
        {
          "role": "派蒙",
          "text": "也就是说，他有不在场证明。"
        },
        {
          "role": "夏沃蕾",
          "text": "不只是这样，他还缺少「动机」。"
        },
        {
          "role": "夏沃蕾",
          "text": "他有一个完整的家庭，父母健在。我深入调查过，他是六岁时被领养的，走的是正规手续。六岁前在孤儿院也有记录。"
        },
        {
          "role": "夏沃蕾",
          "text": "小说中两个主角的母亲被杀也是在他们十岁以后的事了。虽然小说有可能改编了事实，但我不愿意被这个思维套进去。"
        },
        {
          "role": "夏沃蕾",
          "text": "更重要的是我和他说过话，他不像是敢拿起枪去杀人的角色。"
        },
        {
          "role": "派蒙",
          "text": "那现在怎么办？听起来线索还是断了…"
        },
        {
          "role": "夏沃蕾",
          "text": "我没指望一天就抓到犯人，调查还需要时间。"
        },
        {
          "role": "夏沃蕾",
          "text": "…这样吧，我们这几天就正常拍摄映影，拍摄结束后再四处调查一番。线索总会出现的。"
        },
        {
          "role": "派蒙",
          "text": "可你不是还说这些「情报的孤岛」，会很容易和你擦身而过吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "派蒙，书里还有一句话我没告诉你。"
        },
        {
          "role": "派蒙",
          "text": "…是什么呀？"
        },
        {
          "role": "夏沃蕾",
          "text": "——但只要你在迷雾中航行得够久，总有一天会撞上一座孤岛的。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（夏沃蕾）"
        },
        {
          "role": "夏沃蕾",
          "text": "怎么了？特巡队队长在灰河长大很奇怪吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉很意外…",
              "dialogues": [
                {
                  "role": "夏沃蕾",
                  "text": "我也很意外。有段时间，我还觉得自己再也没机会加入警备队了。"
                }
              ]
            },
            {
              "text": "感觉很难…",
              "dialogues": [
                {
                  "role": "夏沃蕾",
                  "text": "爬上来的过程吗？的确很难。"
                }
              ]
            }
          ]
        },
        {
          "role": "夏沃蕾",
          "text": "但只要你实力够硬，功绩够多…总有一天会被认可。"
        },
        {
          "role": "夏沃蕾",
          "text": "反过来说，灰河也造就了我，在某些方面。"
        },
        {
          "role": "夏沃蕾",
          "text": "比如怎样同罪人交易，怎样同罪人一样思考…"
        },
        {
          "role": "夏沃蕾",
          "text": "当然，这就当作我们之间的秘密吧。"
        }
      ],
