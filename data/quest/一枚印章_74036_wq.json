{
  "quest_id": 74036,
  "chapter_num": null,
  "chapter_title": "一枚印章",
  "type": "wq",
  "route": "A Certain Stamp",
  "stories": [
    {
      "story_id": 74036,
      "title": "一枚印章",
      "description": "复律庭的艾尤恩正在勤恳工作…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到第二天早上（8点~12点）"
        },
        {
          "type": "subtitle",
          "text": "与艾尤恩对话"
        },
        {
          "role": "艾尤恩",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "艾尤恩？",
              "dialogues": []
            },
            {
              "text": "你…写好了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾尤恩",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "艾尤恩！"
        },
        {
          "role": "艾尤恩",
          "text": "啊！？怎么了！我写完了，我已经写完了啊！"
        },
        {
          "role": "旅行者",
          "text": "是我啦，你写完了吗？"
        },
        {
          "role": "艾尤恩",
          "text": "是您啊，我刚才…我刚才肯定是睡着了，抱歉。"
        },
        {
          "role": "艾尤恩",
          "text": "洛耶茨先生和瑟米安先生陪了我半宿，在他们的指导下，我总算是把那篇倡议书赶出来了。"
        },
        {
          "role": "艾尤恩",
          "text": "但我太累了，所以闭眼休息了一会，没想到一下子睡到现在…"
        },
        {
          "role": "艾尤恩",
          "text": "我得先去找塞勒，把这份倡议书盖上复律庭的公章，再把倡议书拿去给迪福尔先生盖章，最后再正式印发…这件事就结了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来很简单嘛。",
              "dialogues": []
            },
            {
              "text": "总算不像之前那么复杂了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "艾尤恩",
          "text": "可不是。而且我听说塞勒那边还引入了一台新型印章机，这台机器同时兼顾了便利性和保密性，预备在整个复律庭推广。"
        },
        {
          "role": "艾尤恩",
          "text": "你瞧，洛耶茨先生还给了我一把钥匙呢。每一个部门都必须凭这把钥匙去启动印章机…总之，听起来还挺正式的。"
        },
        {
          "role": "派蒙",
          "text": "不然，你还是睡一会吧？感觉你走路都要走不稳了。"
        },
        {
          "role": "派蒙",
          "text": "反正只是去盖个章，而且还有那个…印章机，不用这么急急忙忙的呀。"
        },
        {
          "role": "艾尤恩",
          "text": "不，不能再耽搁时间了，咱们这就出发吧，只是盖个章，应该不会费太多时间。"
        },
        {
          "type": "subtitle",
          "text": "前去盖章"
        },
        {
          "role": "塞勒",
          "text": "这机器可真难操作，唉…"
        },
        {
          "role": "艾尤恩",
          "text": "塞勒，现在能盖章吗？"
        },
        {
          "role": "塞勒",
          "text": "能！当然能，你带钥匙来了吧？先在这里签个字吧。"
        },
        {
          "role": "艾尤恩",
          "text": "我还以为你们有了这件机器之后，就不用签字了呢。"
        },
        {
          "role": "塞勒",
          "text": "这个嘛…这个机器最终还是得人来操作，那可不就得签字作保吗？"
        },
        {
          "role": "塞勒",
          "text": "但是这机器的保密性可是一流的，没有钥匙的话，就算是我也没法让它动起来。"
        },
        {
          "role": "塞勒",
          "text": "把文件放下面吧，一定要对准。再把钥匙插进这个孔里。"
        },
        {
          "role": "派蒙",
          "text": "这就是那个「自动盖章机」吗？看起来还真…普通呢…"
        },
        {
          "role": "艾尤恩",
          "text": "这样是吧，然后我就扭一下…"
        },
        {
          "role": "塞勒",
          "text": "等会，保持这个姿势先别动，我还得给你留个影。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不怕泄密吗？",
              "dialogues": []
            },
            {
              "text": "为什么还要留影？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塞勒",
          "text": "这是引进这台机器的时候，卡尔西先生给我们定下的规定，必须要用留影机给来盖章的人进行留档…"
        },
        {
          "role": "塞勒",
          "text": "我得挪个位置…别拍到这份文件了。"
        },
        {
          "role": "塞勒",
          "text": "最近复律庭里有人说马上就要下来一份文件，专门规制留影机泄密这件事。我可不想当那个被打的出头鸟…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们也往外面站站吧，要是被拍进去的话，说不定我们也会卷入什么「秘密事件」里呢。"
        },
        {
          "role": "？？？",
          "text": "塞勒小心翼翼地留好了影…"
        },
        {
          "role": "塞勒",
          "text": "…拍好了，你开机器吧。"
        },
        {
          "role": "艾尤恩",
          "text": "我扭了啊，这机器怎么没动静？"
        },
        {
          "role": "塞勒",
          "text": "不可能，我刚修过这台机器，总不能又坏了吧？让我检查一下，别担心，很快就好。"
        },
        {
          "role": "？？？",
          "text": "塞勒低头检查起了机器…"
        },
        {
          "role": "塞勒",
          "text": "怪了，什么毛病也没有啊…"
        },
        {
          "role": "旅行者",
          "text": "重新插拔钥匙看看？"
        },
        {
          "role": "艾尤恩",
          "text": "好吧，我来试试看。"
        },
        {
          "role": "？？？",
          "text": "艾尤恩拔出钥匙，又重新插了回去。机器依旧没有动静…"
        },
        {
          "role": "艾尤恩",
          "text": "没有动静啊，塞勒，想想办法！"
        },
        {
          "role": "塞勒",
          "text": "也许是你没有把文件的位置对准？你得把文件卡在这些卡扣上才行，里面都有隐藏的触发机括呢。"
        },
        {
          "role": "旅行者",
          "text": "文件和机器有关系吗？"
        },
        {
          "role": "塞勒",
          "text": "当然，不然这台机器怎么知道有文件在下面等着盖章呢，这可是一台自动盖章机，又不是由我手动操作的。"
        },
        {
          "role": "艾尤恩",
          "text": "天哪…好吧，好吧！我这就把文件重新放一遍，对准所有卡扣。"
        },
        {
          "role": "？？？",
          "text": "艾尤恩拿出文件，重新摆放进去。机器依旧没有动静…"
        },
        {
          "role": "艾尤恩",
          "text": "没作用，它还是一动不动。"
        },
        {
          "role": "塞勒",
          "text": "不对啊，上次我只是拍了一下，这机器就继续工作了。"
        },
        {
          "role": "旅行者",
          "text": "那我去拍拍它。"
        },
        {
          "role": "艾尤恩",
          "text": "我们已经不得不诉诸如此…接近于祈祷的行为来维修机器了吗？"
        },
        {
          "role": "塞勒",
          "text": "至少我们还有祈祷的机会不是？"
        },
        {
          "role": "旅行者",
          "text": "（轻轻拍打这台机器。）"
        },
        {
          "role": "艾尤恩",
          "text": "（这台机器用沉默给了你回答…）"
        },
        {
          "role": "旅行者",
          "text": "（略微用力地拍打这台机器。）"
        },
        {
          "role": "艾尤恩",
          "text": "（这台机器就连抗议也懒得做出…）"
        },
        {
          "role": "旅行者",
          "text": "（狠狠地拍打这台机器！）"
        },
        {
          "role": "艾尤恩",
          "text": "（这台机器沉默少许，烦躁地发出了一阵稀里哗啦的声音，就像是刚睡醒的人跌跌撞撞地摔下了床…）"
        },
        {
          "role": "派蒙",
          "text": "呜哇！什么声音，这台机器里面是不是全部坏掉了啊！"
        },
        {
          "role": "艾尤恩",
          "text": "（…然后，这台机器踉跄着找到了它的拖鞋，摸索一阵，终于打开灯，嗡嗡地运转了起来。）"
        },
        {
          "role": "派蒙",
          "text": "居，居然运转了…"
        },
        {
          "role": "？？？",
          "text": "自动盖章机疲惫，坚定却又极富耐心地工作了起来。 在几人近乎绝望的注视下，机器以仿佛玳龟爬行一般的速度降下了印章。印章迈着步子，在文件上疑惑地蹒跚，转悠了一会后，只能无奈地坐下休憩。 最后，机器颤抖着将印章收了回去…"
        },
        {
          "role": "塞勒",
          "text": "我就说它能正常工作！"
        },
        {
          "role": "艾尤恩",
          "text": "我真不知道这机器究竟哪里好了，说是自动，但它盖章的速度比手动还慢啊。"
        },
        {
          "role": "塞勒",
          "text": "但它的保密性十分优秀。你瞧，我们三个人就算是这样，也没能把印章拿出来私自盖戳。"
        },
        {
          "role": "艾尤恩",
          "text": "别在这种地方自鸣得意，要是有一天这台机器彻底坏了，卡尔西先生也不在，那又该怎么办？"
        },
        {
          "role": "塞勒",
          "text": "嗯…那也没关系，我还有一枚备用钥匙。"
        },
        {
          "role": "艾尤恩",
          "text": "那是用来打开这台机器的吗？"
        },
        {
          "role": "塞勒",
          "text": "不，那是用来打开卡尔西先生办公室里的一个箱子，里面放着一枚备用公章。"
        },
        {
          "role": "艾尤恩",
          "text": "…旅行者，我们赶紧回去把这份文件给装订好，交给迪福尔先生吧。"
        },
        {
          "role": "艾尤恩",
          "text": "我真是等不及从这场噩梦中解脱了。"
        },
        {
          "type": "subtitle",
          "text": "回去处理文件"
        },
        {
          "role": "艾尤恩",
          "text": "这里的用词要再斟酌一下才行…应该怎么写才好…"
        },
        {
          "role": "艾尤恩",
          "text": "好了，公章齐全，装订完成，接下来只要交给迪福尔先生，就万事大吉了。"
        },
        {
          "role": "艾尤恩",
          "text": "我今天晚上一定要好好睡一觉，把这些事全都忘在脑后，明天再请个假，去找伊丝黛莱…"
        },
        {
          "role": "柯妮莉娅",
          "text": "艾尤恩先生，您现在有空吗？"
        },
        {
          "role": "艾尤恩",
          "text": "我有，您有什么事吗？难道报销的单据这么快就下来了？"
        },
        {
          "role": "柯妮莉娅",
          "text": "那倒不是，但…那维莱特大人让人来告诉我，让我问问您，为什么要单独报销一个键帽，而不是一整台打字机。"
        },
        {
          "role": "艾尤恩",
          "text": "因为…因为我只掉了一个键帽啊，为什么非得报销一整台打字机呢？"
        },
        {
          "role": "派蒙",
          "text": "唔，道理确实是这样啦…"
        },
        {
          "role": "柯妮莉娅",
          "text": "但我们的报销清单上有打字机，却没有键帽，所以键帽是一个全新的报销条目。"
        },
        {
          "role": "柯妮莉娅",
          "text": "您必须得写一份书面文件递交给那维莱特大人，详细说明您为什么只报销一枚键帽…"
        },
        {
          "role": "派蒙",
          "text": "总感觉我们现在不是在讨论一件正经事，而是在讲什么冷笑话…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有这个必要吗？",
              "dialogues": [
                {
                  "role": "艾尤恩",
                  "text": "所以，你要我给…你要我给那维莱特大人单独写一份报告，解释我弄丢了一枚键帽？"
                },
                {
                  "role": "柯妮莉娅",
                  "text": "枢律庭说，是那维莱特大人亲自下的要求。"
                },
                {
                  "role": "艾尤恩",
                  "text": "才怪！枢律庭无论做什么都会说「这是那维莱特大人亲自下的要求」！"
                },
                {
                  "role": "洛耶茨",
                  "text": "但没人敢赌这说法到底是不是真的。好了艾尤恩，冷静下来听我说。"
                },
                {
                  "role": "洛耶茨",
                  "text": "你作为复律官，最高审判官的命令对你来说具有行政意义上的强制性。简单来说就是，你不得不写。"
                },
                {
                  "role": "洛耶茨",
                  "text": "这不是一件坏事，你正好借此机会让那维莱特大人瞧瞧你的文笔。可不是每一个人都有机会向他做单独书面报告的啊。"
                },
                {
                  "role": "艾尤恩",
                  "text": "但是，我…"
                },
                {
                  "role": "旅行者",
                  "text": "喔…糟糕…"
                },
                {
                  "role": "加特尼奥",
                  "text": "嗨！朋友们，好消息，我们抓到一个用留影机泄密的现行犯！完全可以作为反面典型写进倡议书里。"
                },
                {
                  "role": "加特尼奥",
                  "text": "这位知法犯法的现行犯，就是让我们提醒所有人不要用留影机泄密的卡尔西先生。"
                },
                {
                  "role": "派蒙",
                  "text": "这个人…就是因为他，艾尤恩才会每天熬夜写稿子！他怎么自己先犯错了呀！"
                },
                {
                  "role": "加特尼奥",
                  "text": "他用留影机拍摄了好几张自己办公室的画片，又把这些画片送给了记者。"
                },
                {
                  "role": "加特尼奥",
                  "text": "在其中的一张画片里，他把自己的会议记录给拍了进去。现在民众发现，会议记录的内容和他之前做的演讲根本挨不上边。"
                },
                {
                  "role": "加特尼奥",
                  "text": "现在外面已经传得沸沸扬扬，卡尔西的办公室马上又要成为枫丹最大的笑料了。"
                },
                {
                  "role": "派蒙",
                  "text": "等一下啦！会议记录和演讲有什么关系？"
                },
                {
                  "role": "加特尼奥",
                  "text": "几乎所有演讲稿的内容都是从会议记录中整理出来的，当然有关系。"
                },
                {
                  "role": "旅行者",
                  "text": "那怎么会挨不上边？"
                },
                {
                  "role": "加特尼奥",
                  "text": "喔，这很正常。会议记录最大的作用，是告诉我们哪些东西不能出现在演讲稿里。"
                },
                {
                  "role": "加特尼奥",
                  "text": "卡尔西才不知道自己要讲什么，他连自己的想法都没有，全都靠他手下的那几位小伙子提醒他。"
                },
                {
                  "role": "艾尤恩",
                  "text": "等等，卡尔西先生目前在哪？"
                },
                {
                  "role": "加特尼奥",
                  "text": "在我们的办公室等待调查，毕竟是泄露了带有密级的文件，还闹得满城风雨…想必他得在里面待段时间了。"
                },
                {
                  "role": "艾尤恩",
                  "text": "那我写的文件怎么办！我什么都写好了，连章都盖好了，我…咳咳咳…咳咳！"
                },
                {
                  "role": "派蒙",
                  "text": "没，没关系呀，写都写好了，总是能发出来的。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "不会白写的，你冷静点。",
                      "dialogues": []
                    },
                    {
                      "text": "放轻松，肯定会有办法的。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "瑟米安",
                  "text": "艾尤恩！艾尤恩，你在吗？"
                },
                {
                  "role": "艾尤恩",
                  "text": "瑟米安先生，您总算来了，快点帮我拿个主意吧！"
                },
                {
                  "role": "瑟米安",
                  "text": "先别说这个，你的那枚键帽，已经报销了吗？"
                },
                {
                  "role": "艾尤恩",
                  "text": "可不是吗？我甚至还要为这枚键帽给那维莱特大人专门写一份报告呢。"
                },
                {
                  "role": "瑟米安",
                  "text": "噢…见鬼。"
                },
                {
                  "role": "瑟米安",
                  "text": "你看，这是你的那枚键帽吗？"
                },
                {
                  "role": "艾尤恩",
                  "text": "您是…从哪拿到的？"
                },
                {
                  "role": "瑟米安",
                  "text": "就在我的桌子底下，准是清洁人员打扫地面的时候，不小心把它扫了过来，有人看见之后，就放在了我桌上。"
                },
                {
                  "role": "瑟米安",
                  "text": "我还以为是我的打字机键帽，就收了起来。但今天一看…我的打字机完好无缺，所以…"
                },
                {
                  "role": "艾尤恩",
                  "text": "这场噩梦，到底什么时候能醒…"
                },
                {
                  "role": "艾尤恩",
                  "text": "旅行者，我工作的意义到底是…"
                },
                {
                  "role": "？？？",
                  "text": "艾尤恩晕倒在了地上…"
                }
              ]
            },
            {
              "text": "这是不是有点荒谬…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑟米安",
          "text": "欸！艾尤恩！"
        },
        {
          "role": "？？？",
          "text": "艾尤恩被火速运去了医生所在处…"
        },
        {
          "role": "瑟米安",
          "text": "这是我的错！要是早点找到键帽，事情也不会变成这样。"
        },
        {
          "role": "旅行者",
          "text": "这根本就不是键帽的问题好吗？！"
        },
        {
          "role": "派蒙",
          "text": "对呀！所有事情都乱七八糟，艾尤恩都不知道该做什么啦！"
        },
        {
          "role": "派蒙",
          "text": "加特尼奥和迪福尔也跑没影了…这群人到底怎么回事呀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "艾尤恩很在意工作的意义。",
              "dialogues": []
            },
            {
              "text": "艾尤恩不知道工作的意义何在。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "洛耶茨",
          "text": "唉，这位好小伙子总是会思考这种问题。"
        },
        {
          "role": "洛耶茨",
          "text": "「工作的意义」这种宏大的话题，并不是三言两语就能够讲完的。"
        },
        {
          "role": "洛耶茨",
          "text": "一直思考这种问题，只会让自己心里所担负的压力越来越大。"
        },
        {
          "role": "旅行者",
          "text": "那你们知道这问题的答案吗？"
        },
        {
          "role": "瑟米安",
          "text": "不，我从不思考这问题，我只是工作。"
        },
        {
          "role": "洛耶茨",
          "text": "而我嘛…虽然有时候也会思考这问题，但我有自己排解压力的方法。"
        },
        {
          "role": "洛耶茨",
          "text": "要是您真的想要找到这问题的答案…也许我们可以找时间聊一聊。"
        },
        {
          "role": "洛耶茨",
          "text": "但现在，我得先买点水果，去陪陪艾尤恩这小伙子了。"
        },
        {
          "role": "瑟米安",
          "text": "这是正事，我也去帮艾尤恩写一份病假申请，他的确该好好休息。"
        },
        {
          "role": "洛耶茨",
          "text": "不错，咱们各安其职嘛，那事情就这样办。"
        },
        {
          "role": "洛耶茨",
          "text": "旅行者，那咱们下次再见了。"
        },
        {
          "role": "瑟米安",
          "text": "唔，奇怪…病假申请表我放在哪了…"
        }
      ]
    }
  ]
}