{
  "quest_id": 22004,
  "chapter_num": null,
  "chapter_title": "独钓江雪",
  "type": "iq",
  "route": "Fishing Jiangxue",
  "stories": [
    {
      "story_id": 22004,
      "title": "独钓江雪",
      "description": "正在垂钓的江雪，似乎在等待着什么…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与江雪交谈"
        },
        {
          "role": "江雪",
          "text": "到底什么时候才会上钩呢…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么？"
        },
        {
          "role": "江雪",
          "text": "我正在钓一条鱼，一条有点大的鱼。"
        },
        {
          "role": "江雪",
          "text": "我的一位朋友很喜欢做菜，我钓条大鱼给他，想必他会很高兴。"
        },
        {
          "role": "江雪",
          "text": "只不过，周围总是会有怪物过来捣乱，为了解决它们，那条鱼跑了又跑。"
        },
        {
          "role": "江雪",
          "text": "你身上的元素气息不错，愿意帮我解决一下那群怪物，让我能把那条鱼钓起来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "江雪",
                  "text": "那就拜托你了。"
                }
              ]
            },
            {
              "text": "你怎么知道…",
              "dialogues": [
                {
                  "role": "江雪",
                  "text": "我也曾经有过神之眼，虽然懒得再用，但是元素还是勉强能感觉到的。"
                },
                {
                  "role": "江雪",
                  "text": "既然有元素的力量傍身，那些怪物对你来说，想必也是小菜一碟吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "可是，你怎么知道什么时候会有怪物来…"
        },
        {
          "role": "江雪",
          "text": "何须知道，抬眼一看就是，你看看你们后面。"
        },
        {
          "role": "派蒙",
          "text": "后面…"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "type": "subtitle",
          "text": "与江雪交谈"
        },
        {
          "role": "派蒙",
          "text": "打，打倒了，完全没有看到动作…"
        },
        {
          "role": "派蒙",
          "text": "你到底是谁呀。"
        },
        {
          "role": "江雪",
          "text": "一个钓鱼的人。"
        },
        {
          "role": "旅行者",
          "text": "可疑…"
        },
        {
          "role": "江雪",
          "text": "不错，我确实很可疑，但是这世界上有很多可疑的人。"
        },
        {
          "role": "江雪",
          "text": "比如旁边那家客栈里有个厨子，之前很喜欢耍刀，现在很喜欢做菜，面颇狠，心很善。"
        },
        {
          "role": "江雪",
          "text": "比如客栈里有一位老板，她说自己是蒙德人，却没有蒙德人认识她。"
        },
        {
          "role": "江雪",
          "text": "还有…比如你能用元素的力量，却没有神之眼。"
        },
        {
          "role": "江雪",
          "text": "但是有些「可疑」一看就不是「可怕」，所以不用担心。"
        },
        {
          "role": "江雪",
          "text": "这是给你的谢礼，拿好，我要继续钓鱼了。"
        }
      ]
    }
  ]
}