{
  "quest_id": 74679,
  "chapter_num": null,
  "chapter_title": "散布小于一角分！",
  "type": "wq",
  "route": "Spread Out Less Than an Arcminute!",
  "stories": [
    {
      "story_id": 74679,
      "title": "散布小于一角分！",
      "description": "「千灵映影节」期间，你与派蒙遇见了一位特别的警备队员，她似乎正在寻找试玩活动的客人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与工作人员对话"
        },
        {
          "role": "蒂蕾娜",
          "text": "进入阵位，全员列队，铳枪抵肩，迅速瞄准，精确射击，拒止敌人！"
        },
        {
          "role": "蒂蕾娜",
          "text": "欢迎参与「特巡队」的特别活动，体验铳枪射手的快乐！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "铳枪？",
              "dialogues": []
            },
            {
              "text": "射手？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "提到了我们不太熟悉的概念呢…"
        },
        {
          "role": "派蒙",
          "text": "不过看这位警备队员的摊位，难道她说的活动也和「千灵映影节」有关吗？"
        },
        {
          "role": "蒂蕾娜",
          "text": "啊！是「超天顶领队级战力」！您居然出现了？"
        },
        {
          "role": "蒂蕾娜",
          "text": "如果有您帮忙宣传，那我一定能完成任务指标！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你说谁呢？",
              "dialogues": []
            },
            {
              "text": "听不明白。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呃啊，那个什么什么战力，又是我和旅行者的奇怪外号吗？"
        },
        {
          "role": "蒂蕾娜",
          "text": "没错没错，这是你们两位在一部分警备队员之中流传的美称！"
        },
        {
          "role": "蒂蕾娜",
          "text": "我曾与你们有过一面之缘，不过…我这种普通路人般的平庸射手，没能给你们留下深刻的印象…也再正常不过了。"
        },
        {
          "role": "蒂蕾娜",
          "text": "当成初次见面也完全没问题！我是「特巡队」的新晋成员蒂蕾娜，负责队内的各种杂活。"
        },
        {
          "role": "蒂蕾娜",
          "text": "「特巡队」希望借助「千灵映影节」的热度，举办一个宣传活动，招募市民当中的潜在人才。"
        },
        {
          "role": "蒂蕾娜",
          "text": "所以，噔噔！两位请看桌上的这个模拟射击装置「千步拦射角分间」！"
        },
        {
          "role": "派蒙",
          "text": "这个装置…像是一个小小的枫丹廷模型？"
        },
        {
          "role": "蒂蕾娜",
          "text": "啊哈！不止是枫丹廷哦，这个沙盘还可以切换区域，更换成野外的风景，当然，那远不如枫丹廷壮观…"
        },
        {
          "role": "蒂蕾娜",
          "text": "配合枫丹科学院之前为我们研究的特殊光学目镜，就能模拟「特巡队」射手在高处打击敌人时的情景！"
        },
        {
          "role": "派蒙",
          "text": "总之，听起来就是一种…模拟铳枪使用情景，瞄准目标并射击的游戏，没错吧？"
        },
        {
          "role": "派蒙",
          "text": "不过这个名字好复杂，拦射和角分又是什么意思…"
        },
        {
          "role": "蒂蕾娜",
          "text": "咳咳，我根据夏沃蕾队长教导我们的一句名言总结出了这个活动名，超级厉害的目标！"
        },
        {
          "role": "蒂蕾娜",
          "text": "「作为优秀的铳枪射手，应当追求的终极准度，是在千步级别的距离上，打出低于一角分的散布！」"
        },
        {
          "role": "蒂蕾娜",
          "text": "虽然以目前量产铳枪的加工精度，和我们射手的视力，别说千步了，一百步以上的散布低于一角分都是天方夜谭…"
        },
        {
          "role": "蒂蕾娜",
          "text": "但以夏沃蕾队长的实力，说不定真的能做到！"
        },
        {
          "role": "派蒙",
          "text": "你慢点你慢点，我都被你说晕了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "技术名词也不用搞那么清楚。",
              "dialogues": []
            },
            {
              "text": "只管开开心心玩游戏就行啦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蒂蕾娜",
          "text": "「超天顶领队级战力」说得对！有的东西不用计较那么多，照做就好了！"
        },
        {
          "role": "蒂蕾娜",
          "text": "我刚入队的时候，夏沃蕾队长也是这么教我的！"
        },
        {
          "role": "蒂蕾娜",
          "text": "总之，请两位收下这份目镜，配合桌上的模拟装置，就能开始游戏了！"
        },
        {
          "role": "派蒙",
          "text": "话都说到这份上了，我们就试试看吧？"
        },
        {
          "role": "派蒙",
          "text": "本来我也有点好奇，用铳枪这样的武器射击目标是什么感觉呢？说不定还挺有趣的！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（蒂蕾娜）"
        },
        {
          "role": "蒂蕾娜",
          "text": "「超天顶领队级战力」，请问还有什么指示吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来一局「千步拦射角分间」！",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "没问题！这个游戏不会真正的消耗弹药，也不用维护靶标。你甚至可以一口气玩几千局，打掉几万个靶标！"
                }
              ]
            },
            {
              "text": "关于铳枪…",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "嗯？您也想定制铳枪吗？"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "虽然我不明白铳枪的内部原理，但我听同事提到过几位优秀的枪匠。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "相比量产铳枪，枪匠们仔细打造的产品在使用寿命，精度和弹道稳定上，都有着更卓越的表现…"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "如果使用严格控制公差的优质弹药，更是能打出令人瞠目结舌的成绩！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "不过，我记得一般市民不能随意持有铳枪来着，好像要一套相当复杂的流程…"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "等到我回了「特巡队」的驻地，我帮您好好问问！"
                }
              ]
            },
            {
              "text": "回见！",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "您客气了，「超天顶领队级战力」！我随时在这里恭候您的到来！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          31,
          33
        ]
      ]
    }
  ]
}