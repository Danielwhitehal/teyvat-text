{
  "quest_id": 72161,
  "chapter_num": null,
  "chapter_title": "武者的宿命",
  "type": "wq",
  "route": "Fate of a Fighter",
  "stories": [
    {
      "story_id": 72161,
      "title": "武者的宿命",
      "description": "名椎滩的破船上躲藏着一位沉默的伤兵，似乎已与战事稍歇的八酝岛及其上百千悲剧融于一体…",
      "dialogues": [
        {
          "role": "稻叶久藏",
          "text": "是外国人？有趣…"
        },
        {
          "role": "稻叶久藏",
          "text": "如果是游客的话，那你可来错地方了。"
        },
        {
          "role": "旅行者",
          "text": "你在做什么？"
        },
        {
          "role": "稻叶久藏",
          "text": "怎么，你是幕府的人？"
        },
        {
          "role": "旅行者",
          "text": "不是。"
        },
        {
          "role": "稻叶久藏",
          "text": "那就管好自己的事。"
        },
        {
          "role": "派蒙",
          "text": "这个家伙，怎么这么讨人厌！"
        },
        {
          "role": "旅行者",
          "text": "我是幕府派来的。"
        },
        {
          "role": "稻叶久藏",
          "text": "嗯，你们这些外国人…"
        },
        {
          "role": "稻叶久藏",
          "text": "在奉行大人面前摇尾乞怜，讨得点残渣剩饭，又在稻妻武士面前趾高气扬…"
        },
        {
          "role": "稻叶久藏",
          "text": "打探来打探去、到处搅混水不说…现在还专程跑来这条破船上，也不知有何贵干。"
        },
        {
          "role": "稻叶久藏",
          "text": "可惜呀，我不过一介伤兵，没什么能招待你的。"
        },
        {
          "role": "稻叶久藏",
          "text": "所以还要烦请大人自己用腿走出去。"
        },
        {
          "role": "派蒙",
          "text": "这家伙完全不会好好说话吗！"
        },
        {
          "role": "稻叶久藏",
          "text": "好了，你们太吵了。"
        },
        {
          "role": "稻叶久藏",
          "text": "临走前给你们一句忠告吧：别在八酝岛待太久，这座岛已经被诅咒了。"
        },
        {
          "role": "旅行者",
          "text": "诅咒…？"
        },
        {
          "role": "稻叶久藏",
          "text": "听不懂吗？这座岛被诅咒了。"
        },
        {
          "role": "稻叶久藏",
          "text": "停滞的战争、大人们的欲望、小人物的绝望、无辜受难者的憎恨，老人临终时弥漫满屋的药剂气味…"
        },
        {
          "role": "稻叶久藏",
          "text": "总而言之，就是诅咒。"
        },
        {
          "role": "稻叶久藏",
          "text": "趁你还没被压垮，赶紧离开吧。"
        },
        {
          "role": "派蒙",
          "text": "唔…完全听不懂，真是个怪人。"
        },
        {
          "type": "subtitle",
          "text": "解救被围困的武士"
        },
        {
          "type": "subtitle",
          "text": "与武士对话。"
        },
        {
          "role": "稻叶久藏",
          "text": "我累了，恕不待客。"
        },
        {
          "role": "稻叶久藏",
          "text": "哼，真是丢人…"
        },
        {
          "role": "派蒙",
          "text": "明明救了你一命，你还骂我们丢人！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他在说他自己…",
              "dialogues": []
            },
            {
              "text": "是武士特有的矫揉造作…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "稻叶久藏",
          "text": "想不到我会落到被外国人搭救，又任之评头论足的境地…"
        },
        {
          "role": "派蒙",
          "text": "唔…话说回来，武士先生，你还好吗？"
        },
        {
          "role": "稻叶久藏",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看起来挺有精神的…",
              "dialogues": []
            },
            {
              "text": "很明显自尊受了伤…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "稻叶久藏",
          "text": "我欠你们一个人情，外国人。"
        },
        {
          "role": "稻叶久藏",
          "text": "还有，刚才打得不错。"
        },
        {
          "role": "旅行者",
          "text": "旅行者，有幸相识。"
        },
        {
          "role": "稻叶久藏",
          "text": "少蹬鼻子上脸了，外国人…"
        },
        {
          "role": "稻叶久藏",
          "text": "…稻叶藤三郎久藏，叫我久藏就好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那些是什么人？",
              "dialogues": []
            },
            {
              "text": "你为什么会被围攻？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "稻叶久藏",
          "text": "是海贼，名椎滩一带有不少他们的据点。"
        },
        {
          "role": "稻叶久藏",
          "text": "流窜的贼人、失去主业的矿工和渔民、「眼狩令」逃犯，或者战争两方的逃兵，有时就会扎堆啸聚，堕落成贼匪…妄图逃脱大御所大人的制御。"
        },
        {
          "role": "稻叶久藏",
          "text": "「浮浪人」也好，「海乱鬼」也好，一群无法无天之徒…我们前阵子一直在清剿他们，直到叛军毁掉了岛上的镇物…"
        },
        {
          "role": "稻叶久藏",
          "text": "踏鞴砂与矿场的难民纷纷逃离，其中一些鼠辈投奔此间，充实了海贼的队伍，他们就更加肆无忌惮了。"
        },
        {
          "role": "稻叶久藏",
          "text": "刚刚那群海贼是从南边营地来的，他们盯上了这艘船上的货物。"
        },
        {
          "role": "稻叶久藏",
          "text": "只可惜我碍了他们的事，呵呵…"
        },
        {
          "role": "旅行者",
          "text": "这不是你的船？"
        },
        {
          "role": "稻叶久藏",
          "text": "这艘？原本是珊瑚宫叛军的船。我也不太清楚…总之我来到这里的时候，船上就已经没有人影了。"
        },
        {
          "role": "稻叶久藏",
          "text": "于是，我就住下来了，像寄居蟹一样活到现在。"
        },
        {
          "role": "稻叶久藏",
          "text": "这么长时间以来，这还是我头一次说这么多话。真是累人…"
        },
        {
          "role": "稻叶久藏",
          "text": "对了，如果你不介意的话，顺便帮我一个忙吧…等我养好伤，欠下的人情总会还你。"
        },
        {
          "role": "稻叶久藏",
          "text": "我刚刚提过，周围的海贼营地，帮我清理掉。"
        },
        {
          "role": "稻叶久藏",
          "text": "只有这样，野狗一样的海贼才不会继续来骚扰我。或许还能威慑其他海贼营寨，令他们不敢轻易打这艘破船的主意。"
        },
        {
          "role": "稻叶久藏",
          "text": "那就让我再看看你的本事，如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小菜一碟。",
              "dialogues": []
            },
            {
              "text": "去去就回。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "稻叶久藏",
          "text": "哼，净是大话…"
        },
        {
          "role": "稻叶久藏",
          "text": "对了，外国人——"
        },
        {
          "role": "稻叶久藏",
          "text": "别太得意了，下去时小心别摔坏了腿。"
        },
        {
          "type": "subtitle",
          "text": "清理海贼营地"
        },
        {
          "type": "subtitle",
          "text": "向稻叶久藏回报情况"
        },
        {
          "role": "稻叶久藏",
          "text": "怎么又是你？"
        },
        {
          "role": "稻叶久藏",
          "text": "我不是跟你说过——唉，算了。随你高兴吧。"
        },
        {
          "role": "稻叶久藏",
          "text": "别弄乱了我的东西，船上补给还够分你一点。满意了就快点离开。"
        },
        {
          "role": "旅行者",
          "text": "需要帮忙吗？"
        },
        {
          "role": "稻叶久藏",
          "text": "不需要。你没看到我过得很好吗？"
        },
        {
          "role": "旅行者",
          "text": "但你的伤口…"
        },
        {
          "role": "稻叶久藏",
          "text": "那是我的伤口，不是你的。"
        },
        {
          "role": "派蒙",
          "text": "喂，我们是出于好心才问的！"
        },
        {
          "role": "稻叶久藏",
          "text": "那我也出于好心回答你们：别烦我了。"
        },
        {
          "role": "旅行者",
          "text": "我可以帮你。"
        },
        {
          "role": "稻叶久藏",
          "text": "怎么帮我，把我交给幕府军吗？"
        },
        {
          "role": "稻叶久藏",
          "text": "哈哈，我劝你别犯傻了…我会被当成逃兵的。九条大人对逃兵从不留情面。"
        },
        {
          "role": "稻叶久藏",
          "text": "你要是真想帮我，就让我一个人好好静静吧。"
        },
        {
          "role": "派蒙",
          "text": "哇，这个油盐不进的家伙！"
        },
        {
          "role": "稻叶久藏",
          "text": "你回来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "都解决了。",
              "dialogues": []
            },
            {
              "text": "足够安生一阵子了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哇…突然气氛好奇怪…"
        },
        {
          "role": "稻叶久藏",
          "text": "拜托你这个局外人做这种脏活，实在抱歉。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不像这么客气的人。",
              "dialogues": []
            },
            {
              "text": "伤口好些了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "稻叶久藏",
          "text": "……"
        },
        {
          "role": "稻叶久藏",
          "text": "药草已经用完了。"
        },
        {
          "role": "稻叶久藏",
          "text": "之前用来外敷的已经见底了，但伤口还没有消肿…"
        },
        {
          "role": "稻叶久藏",
          "text": "不过…没必要担心我，我还撑得住。"
        },
        {
          "role": "稻叶久藏",
          "text": "去关心你自己的事情吧，走吧。"
        },
        {
          "role": "旅行者",
          "text": "像个小孩子一样。"
        },
        {
          "role": "稻叶久藏",
          "text": "…？"
        },
        {
          "role": "稻叶久藏",
          "text": "你说什么…？"
        },
        {
          "role": "派蒙",
          "text": "在说你呀，就像个小孩子一样。"
        },
        {
          "role": "派蒙",
          "text": "明明情况很糟糕，就差哭着鼻子喊救命了，可还是强撑着装硬汉…一点也不坦诚。"
        },
        {
          "role": "派蒙",
          "text": "只有小孩子才会这样做。"
        },
        {
          "role": "派蒙",
          "text": "而且久藏先生，你可不要忘了——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还欠着我们人情。",
              "dialogues": []
            },
            {
              "text": "我们是来帮忙的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "稻叶久藏",
          "text": "哼…真拿你们没办法…"
        },
        {
          "role": "稻叶久藏",
          "text": "那就请帮我弄来些鸣草吧，在这座岛上随处可见。叶片饱满的最好，方便榨出浆液外敷消炎…"
        },
        {
          "role": "稻叶久藏",
          "text": "就这样吧。让我小睡一会，别再烦我了。"
        },
        {
          "type": "subtitle",
          "text": "采摘12支鸣草"
        },
        {
          "role": "稻叶久藏",
          "text": "你回来了，在岛上注意安全。"
        },
        {
          "role": "旅行者",
          "text": "你看这些够吗？"
        },
        {
          "type": "subtitle",
          "text": "与稻叶久藏对话"
        },
        {
          "role": "稻叶久藏",
          "text": "把草药捣成药糊还要很长时间，你可以走了。"
        },
        {
          "role": "稻叶久藏",
          "text": "…不，我不是在赶你走…"
        },
        {
          "role": "稻叶久藏",
          "text": "过一段时间再回来吧，能有个人聊聊天…也不错。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白的。",
              "dialogues": []
            },
            {
              "text": "好好养伤。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "稻叶久藏",
          "text": "保重，外国人。"
        },
        {
          "type": "subtitle",
          "text": "等待到翌日上午（次日10点—12点），与稻叶久藏对话。"
        },
        {
          "type": "subtitle",
          "text": "向稻叶久藏回报情况"
        },
        {
          "role": "稻叶久藏",
          "text": "…附近的鼠辈又开始蠢蠢欲动了。"
        },
        {
          "role": "稻叶久藏",
          "text": "喂，外国人。在附近游荡的话，请小心海贼。"
        },
        {
          "role": "旅行者",
          "text": "谢谢。"
        },
        {
          "role": "稻叶久藏",
          "text": "应该的。"
        },
        {
          "role": "旅行者",
          "text": "他们不是我的对手。"
        },
        {
          "role": "稻叶久藏",
          "text": "哈哈，净说大话…"
        },
        {
          "role": "稻叶久藏",
          "text": "等你把他们都驱逐干净，再跟我说这种话吧！"
        },
        {
          "role": "旅行者",
          "text": "一言为定。"
        },
        {
          "role": "稻叶久藏",
          "text": "嗯，一言为定。"
        },
        {
          "role": "稻叶久藏",
          "text": "外国人，最近如何？"
        },
        {
          "role": "稻叶久藏",
          "text": "抱歉，这里不是待客的好地方。"
        },
        {
          "role": "稻叶久藏",
          "text": "不过…我很高兴你能来。"
        },
        {
          "role": "旅行者",
          "text": "你看起来好多了。"
        },
        {
          "role": "稻叶久藏",
          "text": "嗯，又欠你一个人情。"
        },
        {
          "role": "稻叶久藏",
          "text": "哈哈，真可惜我又撑下来了。"
        },
        {
          "role": "派蒙",
          "text": "这不是好事吗。有什么可惜的啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "接下来有什么打算？",
              "dialogues": []
            },
            {
              "text": "有想过回去吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "稻叶久藏",
          "text": "我还没想好接下来怎么做，不过我想我不会回去。"
        },
        {
          "role": "稻叶久藏",
          "text": "虽然九条政仁公子人还不错，但是他家的老头子正叫唤着抓逃兵立威呢。"
        },
        {
          "role": "稻叶久藏",
          "text": "我可不能撞到他的刀口上…"
        },
        {
          "role": "稻叶久藏",
          "text": "或许我会脱下这身甲胄吧，就这样一个人过日子也不错…"
        },
        {
          "role": "稻叶久藏",
          "text": "直到平静的日子没办法让我自欺欺人，记忆告诉我自己依然是那个染血的伤兵…"
        },
        {
          "role": "稻叶久藏",
          "text": "唉…总之，以后的事，谁知道呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "…"
                }
              ]
            },
            {
              "text": "……",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "……"
                }
              ]
            }
          ]
        },
        {
          "role": "稻叶久藏",
          "text": "话说回来，我从未质疑过大御所大人的一切决定，所以我想，即使离去也不会有什么悔恨吧？"
        },
        {
          "role": "派蒙",
          "text": "唔…话题突然变沉重了…"
        },
        {
          "role": "稻叶久藏",
          "text": "啊，说到这里…我也该去拜访一下老战友了，他们还一直在这座岛上陪着我呢。"
        },
        {
          "role": "稻叶久藏",
          "text": "稻妻的传统是献上「血斛」，一种娇贵妖艳的花朵…是武人宿命的象征。"
        },
        {
          "role": "稻叶久藏",
          "text": "顺便，如果你接下来在旅途中遇到了我的老战友们，也请劳烦停留一下，认识认识他们吧。"
        },
        {
          "type": "subtitle",
          "text": "清除周围怪物营地废弃"
        }
      ]
    }
  ]
}