{
  "quest_id": 74142,
  "chapter_num": null,
  "chapter_title": "追寻",
  "type": "wq",
  "route": "Pursuit",
  "stories": [
    {
      "story_id": 74142,
      "title": "追寻·其二",
      "description": "决定再次进入「冥想」的世界，寻找夏诺蒂拉。",
      "dialogues": [
        {
          "role": "「揭示之书」",
          "text": "（书页上的内容依旧是由无法理解的图形、字母与古语，以及几何图形构成。但集中精神后，似乎能渐渐理解其中的内容了。）"
        },
        {
          "role": "派蒙",
          "text": "旅行者，还要进行「冥想」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "夏诺蒂拉还没找到。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这次也拜托你稍等我片刻。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…好吧！反正也就是一眨眼功夫的事情啦。我一点也不担心！"
        },
        {
          "role": "派蒙",
          "text": "你要注意安全喔，旅行者。"
        },
        {
          "role": "「揭示之书」",
          "text": "（书页边缘渐渐变得模糊。无比陌生而又无比亲切的世界闯入了视野。在这里…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毋须担心。",
              "dialogues": [
                {
                  "role": "阅读",
                  "text": "（书页边缘渐渐变得模糊。无比陌生而又无比亲切的世界闯入了视野。在这里…）"
                }
              ]
            },
            {
              "text": "我先准备一下。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "（若选择“我先准备一下。”）与「揭示之书」交互"
        },
        {
          "role": "阅读",
          "text": "（书页上的内容依旧是由无法理解的图形、字母与古语，以及几何图形构成。但集中精神后，似乎能渐渐理解其中的内容了。）"
        },
        {
          "role": "派蒙",
          "text": "[玩家]，你准备好了吗？我会在这里乖乖等你的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯。",
              "dialogues": [
                {
                  "role": "阅读",
                  "text": "（书页边缘渐渐变得模糊。无比陌生而又无比亲切的世界闯入了视野。在这里…）"
                }
              ]
            },
            {
              "text": "暂时算了。",
              "dialogues": [
                {
                  "role": "阅读",
                  "text": "……"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与「夏诺蒂拉」对话"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏诺蒂拉",
          "text": "咦，旅行者哥哥…我们不是刚刚才见过面吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么时候的事？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏诺蒂拉",
          "text": "唔，我也说不准耶…毕竟，在这种地方根本不知道时间嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "夏诺蒂拉，跟我走吧。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里很不正常。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏诺蒂拉",
          "text": "但是，正常与不正常，难道不是我们决定的吗？"
        },
        {
          "role": "夏诺蒂拉",
          "text": "嗯…我也没有别的意思，但这里对我来说真的很好。这里充满生机与色彩，在那边的世界我从来没见过这样的景象。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我只见到一朵向日葵…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏诺蒂拉",
          "text": "真的？哇！在什么地方？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "之前我们遇到小狗的地方。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏诺蒂拉",
          "text": "喔！那我先出发啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等等…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "继续追寻"
        },
        {
          "type": "subtitle",
          "text": "战斗"
        },
        {
          "type": "subtitle",
          "text": "继续追寻"
        },
        {
          "role": "夏诺蒂拉",
          "text": "啊！是[玩家]哥哥。咦，派蒙没和你一起吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那个裂隙…你在看什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏诺蒂拉",
          "text": "咦？什么裂隙呀，这不是镜子吗？"
        },
        {
          "role": "夏诺蒂拉",
          "text": "唔，这么说来，我确实有在找的东西。"
        },
        {
          "role": "夏诺蒂拉",
          "text": "我一直在找「谜镜」的线索…应该是像画一样的东西，和「揭示之书」一样，也能够让人「冥想」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于四象限与格式塔的「画」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏诺蒂拉",
          "text": "…是喔，原来在那样的地方。嗯！谢谢[玩家]哥哥！"
        },
        {
          "type": "subtitle",
          "text": "战斗"
        },
        {
          "type": "subtitle",
          "text": "前往呼救声传来的地方"
        },
        {
          "role": "夏诺蒂拉",
          "text": "咿…救命…"
        },
        {
          "role": "旅行者",
          "text": "（声音是从那边传来的。要赶紧。）"
        },
        {
          "type": "subtitle",
          "text": "战斗"
        },
        {
          "role": "夏诺蒂拉",
          "text": "是[玩家]哥哥！救命…"
        },
        {
          "type": "subtitle",
          "text": "与夏诺蒂拉对话"
        },
        {
          "role": "夏诺蒂拉",
          "text": "呜呜…谢谢你，[玩家]哥哥…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "发生什么事了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏诺蒂拉",
          "text": "我不知道…我只是想来看看开放的向日葵，还有可爱的小狗…"
        },
        {
          "role": "夏诺蒂拉",
          "text": "但在路上，突然出现了一个很可怕的怪物追我。同时，天变得越来越黑…而且有很多不同的声音，说我听不懂的东西…"
        },
        {
          "role": "夏诺蒂拉",
          "text": "我害怕极了，就跟着金色的光，一直往前跑。"
        },
        {
          "role": "夏诺蒂拉",
          "text": "每当怪物接近我，整个世界就会变黑一点…花园、宫殿、大树和花朵都不见了，变得好阴暗，只剩下废墟…"
        },
        {
          "role": "夏诺蒂拉",
          "text": "然后，怪物追上我…呜呜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "已经不用担心了。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「小狗」，把她送回去吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「小狗」",
          "text": "小姐，别再来了。这里什么也没有，而外面还有一整个属于你的世界呢。"
        },
        {
          "role": "夏诺蒂拉",
          "text": "咦？你就是小狗吗…但是…"
        },
        {
          "role": "夏诺蒂拉",
          "text": "…我们还能再见面吗？这个世界还能变成美丽的花园吗？"
        },
        {
          "role": "「小狗」",
          "text": "不会的。再见了。"
        },
        {
          "role": "「小狗」",
          "text": "还有你。我再问你一次，我在你眼里，到底是什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "狗。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「小狗」",
          "text": "嗯，那就好。你已经赶走了不应该来到这里的人物，多亏了你，这个世界的崩解也停下了。"
        },
        {
          "role": "「小狗」",
          "text": "但继续待在这里也是不明智的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我想也是。把我送回去吧。",
              "dialogues": [
                {
                  "role": "「小狗」",
                  "text": "你很明智。那么别了。"
                }
              ]
            },
            {
              "text": "到底是怎么回事？",
              "dialogues": [
                {
                  "role": "「小狗」",
                  "text": "原本这里已经要彻底瓦解了。不该来到这里的人物到了这里，撼动了这个世界的根基。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "我所看到的现象，就是这么来的吗？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "「小狗」",
                  "text": "我不可能知道你体验过什么，毕竟我不是你。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那你又是谁？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "「小狗」",
                  "text": "…我是谁并不重要。重要的是这个妄想世界的主人。"
                },
                {
                  "role": "「小狗」",
                  "text": "他们相信他们能拯救世界，却不知道这个世界是否需要被拯救。或许他们记忆中的世界只不过是永远失去的向日葵盛开的午后。"
                },
                {
                  "role": "「小狗」",
                  "text": "但那些是他们的故事，不是我的故事。我只是他们对一位朋友的记忆。他们曾相信他们能拯救我，但最终…"
                },
                {
                  "role": "「小狗」",
                  "text": "蝶而化茧，茧破而幼虫出，最后幼虫走向未曾诞生的虚无。"
                },
                {
                  "role": "「小狗」",
                  "text": "不过这些都无所谓，因为现在的我已经什么都不剩下了。我只是他们的记忆中，对于「拯救我」这件事的执着所留下的影子。"
                },
                {
                  "role": "「小狗」",
                  "text": "但我也不会因此记恨他们，因为即使他们随着割舍而变化，这个记忆与妄想所构成的世界当中的我，仍然证明了他们的执着。"
                },
                {
                  "role": "「小狗」",
                  "text": "作为曾经的朋友，我很满足。无论我变成什么模样，我都会永远感念过去一起的友谊。"
                },
                {
                  "role": "「小狗」",
                  "text": "好了，就说到这吧。你也感受到了这里对你的影响吧？"
                },
                {
                  "role": "「小狗」",
                  "text": "别了。你和我不会再见。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "记录：[[万国诸卷拾遗/枫丹#揭示之书内]]",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "苏醒"
        },
        {
          "type": "subtitle",
          "text": "与夏诺蒂拉对话"
        },
        {
          "role": "派蒙",
          "text": "哇！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，我…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这次也好快！我还来不及眨眼呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…那就好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好啦！罪魁祸首也回来啦，夏诺蒂拉，你害得旅行者好担心！"
        },
        {
          "role": "夏诺蒂拉",
          "text": "我…"
        },
        {
          "role": "夏诺蒂拉",
          "text": "呜呜，对不起…"
        },
        {
          "role": "派蒙",
          "text": "哎？呃…我没有在责备你啦！夏诺蒂拉不哭，我给你吃好吃的…"
        },
        {
          "role": "派蒙",
          "text": "（发生了什么呀？）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（里面遇到了一些危险。）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "（是喔…）"
        },
        {
          "role": "派蒙",
          "text": "不哭不哭，夏诺蒂拉好勇敢！来，夏诺蒂拉，这是我最喜欢的野菇鸡肉串，给你做奖励！"
        },
        {
          "role": "夏诺蒂拉",
          "text": "呜呜…谢谢派蒙…嗯…"
        },
        {
          "role": "夏诺蒂拉",
          "text": "（咀嚼）"
        },
        {
          "role": "夏诺蒂拉",
          "text": "呜哇，好怪的味道，这就是人吃的饭吗…"
        },
        {
          "role": "派蒙",
          "text": "什么嘛！你不吃那还给我！"
        },
        {
          "role": "夏诺蒂拉",
          "text": "但是…谢谢派蒙。还有谢谢[玩家]哥哥，谢谢你救了我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "之后有什么打算？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夏诺蒂拉",
          "text": "不知道，但我再也不想看书了。"
        },
        {
          "role": "派蒙",
          "text": "…夏诺蒂拉，这是否有点极端了？"
        },
        {
          "role": "夏诺蒂拉",
          "text": "唔，但是「揭示之书」真的很可怕…"
        },
        {
          "role": "派蒙",
          "text": "（所以到底发生了什么呀？）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（你要去了才知道。）",
              "dialogues": []
            },
            {
              "text": "（还好你没去。）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "（什么嘛！真气人…）"
        },
        {
          "role": "夏诺蒂拉",
          "text": "…总之，我不要呆在这里了，我要和大家一起住在海沫村里。"
        },
        {
          "role": "派蒙",
          "text": "那就对啦！别的美露莘会好好照顾你的！"
        },
        {
          "role": "夏诺蒂拉",
          "text": "嗯。谢谢你们，[玩家]哥哥、派蒙。"
        }
      ]
    }
  ]
}