  "stories": [
    {
      "story_id": 23037,
      "title": "良药难求",
      "description": "阿如村的马鲁夫似乎遇见了一些麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与马鲁夫对话"
        },
        {
          "role": "马鲁夫",
          "text": "唉，这种病可不好治啊，看来还是得请扎卡里亚医生帮帮忙…"
        },
        {
          "role": "旅行者",
          "text": "遇到什么重病患者了吗？"
        },
        {
          "role": "马鲁夫",
          "text": "欸？是旅行者啊…倒也不是什么重病患者，就是有个病人头疼的有些厉害。"
        },
        {
          "role": "马鲁夫",
          "text": "虽然我也给他开过药了，但药效却不怎么明显。"
        },
        {
          "role": "旅行者",
          "text": "不能开其他的药吗？"
        },
        {
          "role": "马鲁夫",
          "text": "咳…我哪会啊。现在我手头的药方，基本上都是我自己摸索出来的…"
        },
        {
          "role": "马鲁夫",
          "text": "这些药方治疗一些小病小痛还可以，一遇见症状稍微重点的病症就很难起效了。"
        },
        {
          "role": "马鲁夫",
          "text": "还好城里「健康之家」的扎卡里亚医生答应过我，可以帮我置办药方和药物…"
        },
        {
          "role": "马鲁夫",
          "text": "旅行者，你能帮我个忙吗？"
        },
        {
          "role": "马鲁夫",
          "text": "我现在还有一些患者要治疗，实在是走不开，你能帮我去城里找一下扎卡里亚医生，请他帮我开一个药方吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "马鲁夫",
                  "text": "那就拜托你了，旅行者。"
                }
              ]
            },
            {
              "text": "扎卡里亚会来村里吗？",
              "dialogues": [
                {
                  "role": "马鲁夫",
                  "text": "扎卡里亚医生偶尔会托人送点药过来，但他太忙了，实在是没什么空来村里。"
                },
                {
                  "role": "马鲁夫",
                  "text": "总之药方的事就拜托你了，旅行者。"
                }
              ]
            }
          ]
