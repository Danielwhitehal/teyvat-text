        },
        {
          "type": "subtitle",
          "text": "与马鲁夫对话"
        },
        {
          "role": "马鲁夫",
          "text": "旅行者！你回来了，扎卡里亚医生怎么说？"
        },
        {
          "role": "旅行者",
          "text": "关于扎卡里亚的药方…"
        },
        {
          "role": "马鲁夫",
          "text": "就用他原来给我开的那种药汤做基底？这样啊…我再仔细看看药方。"
        },
        {
          "role": "马鲁夫",
          "text": "咦？这药方…扎卡里亚医生开药方时的笔迹还是这么难读啊。"
        },
        {
          "role": "马鲁夫",
          "text": "旅行者，扎卡里亚医生和你说过这种药方的制作方式和所需的药材吧？"
        },
        {
          "role": "马鲁夫",
          "text": "你也帮我回忆一下吧，要是我制作的时候出错了，你可要提醒我啊。"
        },
        {
          "role": "马鲁夫",
          "text": "这里写的药材是…呃…真是难读…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "星蕈。",
              "dialogues": []
            },
            {
              "text": "赤念果。",
              "dialogues": []
            },
            {
              "text": "薄荷。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马鲁夫",
          "text": "要用什么方式煮药汤来着？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "全程大火。",
              "dialogues": []
            },
            {
              "text": "全程小火。",
              "dialogues": []
            },
            {
              "text": "先用大火，再用小火。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马鲁夫",
          "text": "药汤要煮大概多长时间？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "煮到药材浮起来。",
              "dialogues": []
            },
            {
              "text": "煮到药材软烂。",
              "dialogues": []
