{
  "quest_id": 70666,
  "chapter_num": null,
  "chapter_title": "牌手等级突破·一",
  "type": "wq",
  "route": "Ascension Challenge I",
  "stories": [
    {
      "story_id": 70666,
      "title": "牌手等级突破·一",
      "description": "「七圣召唤」的牌手协会认定你已经具有了进行等级突破试炼的资格。赢下突破挑战的牌局，成为「高级牌手」吧！希望你能感受到「七圣召唤」的乐趣！",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往「猫尾酒馆」"
        },
        {
          "role": "旅行者",
          "text": "进行突破挑战！"
        },
        {
          "role": "「小王子」",
          "text": "喵…「哎呀，要来进行牌手等级突破的试炼吗…嗯，旅行者确实已经拥有了挑战的资格，那我这就…」"
        },
        {
          "role": "「小王子」",
          "text": "「这就让恕筠准备突破试炼所用的牌局吧，可要小心应对呀…」"
        },
        {
          "type": "subtitle",
          "text": "与「小王子」进行突破对局"
        },
        {
          "type": "subtitle",
          "text": "与「小王子」对话"
        },
        {
          "role": "「小王子」",
          "text": "喵…「嗯，旅行者得要再小心一点才行啊，先调整一下，之后再来挑战吧？」"
        },
        {
          "role": "「小王子」",
          "text": "「我相信你是有足以完成试炼的实力的…」"
        },
        {
          "role": "「小王子」",
          "text": "喵！「真是了不起，恭喜你突破了牌手等级的试炼，现在已经是高级牌手了！」"
        },
        {
          "role": "「小王子」",
          "text": "喵？「只是完成一次试炼就成为了高级牌手？哎呀，因为世上大部分人把打牌视为玩乐，所以不太认真对待…」"
        },
        {
          "role": "「小王子」",
          "text": "「也就是说，认真玩乐的人反倒才是少数，但是，就算是玩乐，也有认真投入的价值。」"
        },
        {
          "role": "「小王子」",
          "text": "喵！「啊，对了，现在你获得了我的认可，也可以挑战酒馆里其他的家伙设下的牌局，嗯…他们应该会喜欢你的。」"
        },
        {
          "role": "旅行者",
          "text": "其他的家伙？"
        },
        {
          "role": "「小王子」",
          "text": "喵。「嗯，当然和我一样，是酒馆里的猫…可别小看他们。」"
        },
        {
          "role": "「小王子」",
          "text": "喵~「到时候就让恕筠为他们执牌吧，好了，按照惯例，得说一句那个！」"
        },
        {
          "role": "「小王子」",
          "text": "「旅行者，希望你能感受到『七圣召唤』的乐趣！」"
        }
      ]
    }
  ]
}