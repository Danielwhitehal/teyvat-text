{
  "quest_id": 72655,
  "chapter_num": null,
  "chapter_title": "直面悠远的回响",
  "type": "wq",
  "route": "Facing Distant Echoes",
  "stories": [
    {
      "story_id": 72655,
      "title": "直面悠远的回响",
      "description": "准备工作已经全部完成，只欠前去地下遗迹直面神秘的古代机械了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与慕珍对话"
        },
        {
          "role": "慕珍",
          "text": "我们终于找到目标的位置了！好耶，可以回船上睡觉了！"
        },
        {
          "role": "派蒙",
          "text": "欸——？这就事不关己了吗！"
        },
        {
          "role": "慕珍",
          "text": "怎么可能啦，既然离我们所需的东西只剩一步之遥了，我们现在就出发，捕猎遗迹机械吧！"
        },
        {
          "role": "派蒙",
          "text": "刚刚还以为你要回船上！"
        },
        {
          "role": "派蒙",
          "text": "唉，算了，我们也一起去吧！"
        },
         {
          "type": "subtitle",
          "text": "前往遗迹地点"
        },
        {
          "role": "慕珍",
          "text": "哈哈，就是这里啦！"
        },
        {
          "role": "慕珍",
          "text": "原来在这里也有地下遗迹…唔。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么了？",
              "dialogues": []
            },
            {
              "text": "有什么发现吗？",
              "dialogues": []
            }
          ]
        },
        
        {
          "role": "慕珍",
          "text": "没、没什么。"
        },
        {
          "role": "派蒙",
          "text": "咦，是身体不舒服了吗？"
        },
        {
          "role": "慕珍",
          "text": "哈哈，我平时不怎么下船，看到遗迹入口这种大场面，还有点心虚罢了。"
        },
        {
          "role": "派蒙",
          "text": "这算什么大场面啦！"
        },
        {
          "role": "慕珍",
          "text": "好啦，大姐头的订单还等着完成，想必旅行者你也很好奇遗迹里潜藏的秘密吧！"
        },
        {
          "role": "慕珍",
          "text": "所以，就请冒险经验丰富的旅行者来打头阵吧？"
        },
        {
          "role": "旅行者",
          "text": "真拿你没办法…"
        },
        {
          "role": "派蒙",
          "text": "真是拿你没办法，我们走吧！"
        },
        {
          "role": "慕珍",
          "text": "怎么，还需要点准备运动吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于遗迹…",
              "dialogues": []
            },
            {
              "text": "关于神秘的机械…",
              "dialogues": []
            }

          ]
        },
        {
          "role": "慕珍",
          "text": "毕竟我是航船技术官，陆地上的历史我了解的不太多，抱歉啦。"
        },
        {
          "role": "慕珍",
          "text": "不过这些遗迹，我想都与五百年前那场大灾难有关…"
        },
        {
          "role": "慕珍",
          "text": "我也是从小听老水手们提起过那场大灾，据说不论海陆都没有幸免深渊的侵袭…"
        },
        {
          "role": "慕珍",
          "text": "不过对我来说，和吓唬小孩的鬼故事差不多啦。"
        },
        {
          "role": "慕珍",
          "text": "毕竟亲眼所见的可怕，才是真的可怕！"
        }
      ]
    }
  ]
}