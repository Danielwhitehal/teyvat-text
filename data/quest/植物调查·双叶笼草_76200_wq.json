{
  "quest_id": 76200,
  "chapter_num": null,
  "chapter_title": "植物调查·双叶笼草",
  "type": "wq",
  "route": "Plant Research: Twinleaf Pitcher Plants",
  "stories": [
    {
      "story_id": 76200,
      "title": "植物调查·双叶笼草",
      "description": "在伦波岛的某处突然生出大片的双叶笼草…",
      "dialogues": [
        {
          "role": "？？？",
          "text": "快速做好了调查的准备…"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点开启调查"
        },
        {
          "type": "subtitle",
          "text": "与宝藏猎人对话"
        },
        {
          "role": "莉奈娅",
          "text": "（前阵子还什么都没有，现在居然长出这么多双叶笼草…）"
        },
        {
          "role": "莉奈娅",
          "text": "（说不定是什么动物带来了双叶笼草的种子，不过放任它们这样下去可不行呀…）"
        },
        {
          "role": "朱卡",
          "text": "小妹妹，耽误你一点时间，想问问你在附近看到过一只虎纹猫吗？"
        },
        {
          "role": "莉奈娅",
          "text": "虎纹猫？好像没有。露米有看到吗？"
        },
        {
          "role": "露米",
          "text": "呀吼？"
        },
        {
          "role": "莉奈娅",
          "text": "看来露米也没有印象…你们的猫丢了吗？我可以帮忙找找看！这一带的环境我还挺熟悉的…"
        },
        {
          "role": "玛尔佳",
          "text": "喂，朱卡！我们哪有什么闲钱雇佣冒险家啊，再说了，不就是只笨猫，大不了不要它了。"
        },
        {
          "role": "朱卡",
          "text": "玛尔佳，别说这种话，它要是听到了会伤心的。"
        },
        {
          "role": "玛尔佳",
          "text": "它根本听不到吧！要是听得到，也不会我们喊了半天也没回音。"
        },
        {
          "role": "莉奈娅",
          "text": "这点小事就不用委托费啦，而且我正好要在附近调查，就当是顺便好了。走吧，露米！"
        },
        {
          "role": "莉奈娅",
          "text": "（前阵子还什么都没有，现在居然长出这么多双叶笼草…）"
        },
        {
          "role": "莉奈娅",
          "text": "（说不定是什么动物带来了双叶笼草的种子，不过放任它们这样下去可不行呀…）"
        },
        {
          "type": "subtitle",
          "text": "寻找虎纹猫"
        },
        {
          "role": "玛尔佳",
          "text": "笨猫…到底跑到哪里去了…"
        },
        {
          "role": "朱卡",
          "text": "再找找看吧。"
        },
        {
          "role": "莉奈娅",
          "text": "露米，你也觉得它就在这儿？"
        },
        {
          "role": "露米",
          "text": "呀吼吼！"
        },
        {
          "role": "？？？",
          "text": "解救了被困的虎纹猫…"
        },
        {
          "role": "莉奈娅",
          "text": "他们要找的就是你吧，看起来没什么皮外伤，不过要是再晚点就不好说了。"
        },
        {
          "role": "莉奈娅",
          "text": "总之，先去找你的伙伴吧！"
        },
        {
          "type": "subtitle",
          "text": "与宝藏猎人对话"
        },
        {
          "role": "玛尔佳",
          "text": "笨猫——到底在哪里…欸？你找到它了！"
        },
        {
          "role": "莉奈娅",
          "text": "它被那边的双叶笼草困住了，虽然是植物，但却是食肉的掠食者呢，消化月萤虫也只需要几天…"
        },
        {
          "role": "莉奈娅",
          "text": "幸好发现得早，它现在只是有点虚弱，要是再晚些就不好说了。"
        },
        {
          "role": "朱卡",
          "text": "居、居然这么危险…"
        },
        {
          "role": "玛尔佳",
          "text": "还不都怪它自己要往这儿钻，真是只笨猫。"
        },
        {
          "role": "莉奈娅",
          "text": "公平地说，这可不能怪它，是因为双叶笼草会散发一种特殊的气味，对人没什么影响，但昆虫之类的却会被吸引。"
        },
        {
          "role": "莉奈娅",
          "text": "双叶笼草就是用这种方式捕食的。这一带的双叶笼草多得有点异常了，所以就连小动物也被影响了。"
        },
        {
          "role": "玛尔佳",
          "text": "哦…哦，总之这草莫名其妙长这么多，肯定不是好事对吧。"
        },
        {
          "role": "莉奈娅",
          "text": "嗯，如果放任不管的话，可能会造成危害…"
        },
        {
          "role": "玛尔佳",
          "text": "好，那除草就交给我们了。朱卡，你也来帮忙！"
        },
        {
          "role": "玛尔佳",
          "text": "让那笨猫吃了这么久苦头的家伙，我们也得好好回敬一下。"
        },
        {
          "role": "？？？",
          "text": "和两个宝藏猎人一起清除掉了在这一带异常生长的双叶笼草…"
        },
        {
          "role": "玛尔佳",
          "text": "呼——总算结束了。我们也该回那夏镇了…小姑娘，多谢了，帮我们找到这只笨猫，要是没有你帮忙，它还不知道要被困多久。"
        },
        {
          "role": "朱卡",
          "text": "不过说起来，要不是刚才玛尔佳喊得那么大声，说不定我们早就找到它了…"
        },
        {
          "role": "玛尔佳",
          "text": "要、要你多嘴！总之，它现在安全回来了不就行了吗。"
        },
        {
          "role": "莉奈娅",
          "text": "（虽然她嘴上笨猫、笨猫地叫，其实还是很关心同伴的嘛。）"
        },
        {
          "role": "莉奈娅",
          "text": "是呀，它现在平安无事才是最重要的。野外还是很危险的，你们也要多留意。"
        },
        {
          "role": "朱卡",
          "text": "谢谢你，我们会的。"
        },
        {
          "role": "玛尔佳",
          "text": "也祝你调查顺利。那就再见咯。"
        }
      ]
    }
  ]
}