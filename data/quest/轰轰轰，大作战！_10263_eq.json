{
  "quest_id": 10263,
  "chapter_num": "叮铃哐啷大作战·终局",
  "chapter_title": "轰轰轰，大作战！",
  "type": "eq",
  "route": "Boom Boom Boooom! A Grand Battle!",
  "stories": [
    {
      "story_id": 40206,
      "title": "轰轰轰，大作战！",
      "description": "与雅珂达约定日期到了，不知她是否带回了好消息…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后"
        },
        {
          "role": "派蒙",
          "text": "两天的时间到了，我们先到工坊看看雅珂达有没有找到什么线索吧。"
        },
        {
          "type": "subtitle",
          "text": "前往叮铃哐啷蛋卷工坊"
        },
        {
          "role": "派蒙",
          "text": "你好啊，伊涅芙！"
        },
        {
          "role": "伊涅芙",
          "text": "你们好，这几天辛苦你们照顾爱诺了。"
        },
        {
          "role": "派蒙",
          "text": "没什么啦，毕竟我们承诺了嘛——雅珂达已经到这里来了吗？肯定已经找到新的线索了吧？"
        },
        {
          "role": "雅珂达",
          "text": "…先听我讲。"
        },
        {
          "role": "雅珂达",
          "text": "那天从霜月之子回来之后，我重点调查了那个阿斯科，他有主动收购的意图，肯定嫌疑最大，但是…"
        },
        {
          "role": "雅珂达",
          "text": "即便我动用了老板的人脉，也没有找到可以证明他与此事有关的证据，事后来看，他竟然是所有商人里最清白的那一个。"
        },
        {
          "role": "雅珂达",
          "text": "至于其他商人，我一个个查了过去，也没有找到任何线索，他们当中的很多人甚至不知道我们去过霜月之子的事。"
        },
        {
          "role": "雅珂达",
          "text": "这个幕后黑手的手段十分高明，他完美地隐藏了自己。"
        },
        {
          "role": "雅珂达",
          "text": "要揪出这样的人物，根本不是两天之内能办成的事…"
        },
        {
          "role": "派蒙",
          "text": "所以结论是？"
        },
        {
          "role": "伊涅芙",
          "text": "归纳…精简…得出结论，过去的两天中，雅珂达没能找到任何有用的线索。"
        },
        {
          "role": "雅珂达",
          "text": "能不能想办法修饰下？这个结论该怎么说给爱诺那家伙听？"
        },
        {
          "role": "派蒙",
          "text": "真的什么办法也没有了吗？"
        },
        {
          "role": "雅珂达",
          "text": "非要说的话，就是把那些黑市商人都找过来，挨个审问，或者挨个搜查他们的私人仓库…"
        },
        {
          "role": "爱诺",
          "text": "这倒也是个办法。"
        },
        {
          "role": "雅珂达",
          "text": "我只是随口一说…你以为那些人可以随便动？就拿那个阿斯科来说，你要动他还不如把挪德卡莱掀个底朝天呢。"
        },
        {
          "role": "伊涅芙",
          "text": "「把挪德卡莱掀个底朝天」，这确实是爱诺考虑过的备用方案。"
        },
        {
          "role": "雅珂达",
          "text": "总不能真的这么做吧？"
        },
        {
          "role": "伊涅芙",
          "text": "如果这是爱诺的最终决定，我会支持她。"
        },
        {
          "role": "爱诺",
          "text": "回来之后，我想了很久，铛铛七分甜身上的某些技术确实会被外面的坏蛋盯上。"
        },
        {
          "role": "爱诺",
          "text": "其实，工坊里的大家，包括伊涅芙，多多少少都会被那些坏蛋盯上。"
        },
        {
          "role": "爱诺",
          "text": "如果这次不能把铛铛七分甜救回来，他们就会继续打其他伙伴的主意。"
        },
        {
          "role": "爱诺",
          "text": "所以，就算要把挪德卡莱掀个底朝天，也必须把铛铛七分甜救回来。"
        },
        {
          "role": "派蒙",
          "text": "爱诺…"
        },
        {
          "role": "爱诺",
          "text": "刚刚不是提到了有个嫌疑最大的家伙吗？那就先从他开始！"
        },
        {
          "role": "显像机关",
          "text": "哔哔，哔哔。"
        },
        {
          "role": "伊涅芙",
          "text": "…有人寄来了一封信，希望能由旅行者启封。"
        },
        {
          "role": "派蒙",
          "text": "哦？先拿来看看。"
        },
        {
          "type": "subtitle",
          "text": "某位商人的来信"
        },
        {
          "type": "subtitle",
          "text": "好久不见啊，旅行者！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前不久，我偶然听说了你正面临的困扰。你一直是我的优质客户，我也自然要想办法为你解忧。我已经准备好了一个绝佳的服务方案，保证可以解决你的问题，还请光临小店洽谈！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "当然了，考虑到大家都是熟人，所以我可以给你打八折哦！优惠多多，不容错过！",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "这个语气…不会错的，就是她了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不会错的，是多莉。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "她似乎有能帮到我们的办法？"
        },
        {
          "role": "派蒙",
          "text": "多莉提供的服务…该怎么说呢？"
        },
        {
          "role": "雅珂达",
          "text": "那个多莉…在挪德卡莱算是很有特色的商人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "试试吧。",
              "dialogues": []
            },
            {
              "text": "总好过掀翻整个挪德卡莱。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱诺",
          "text": "嗯…有旅行者的建议，我愿意试一试！就让伊涅芙继续看家吧，这一次我一定要把铛铛七分甜带回来！"
        },
        {
          "role": "伊涅芙",
          "text": "那就拜托大家代我照顾爱诺了。"
        },
        {
          "role": "派蒙",
          "text": "雅珂达这次也要跟着一起去吗？果然还是放心不下爱诺？"
        },
        {
          "role": "雅珂达",
          "text": "唉…爱诺那家伙暂且不谈，你们以为笨蛋机器人只拜托了你们吗？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（伊涅芙）"
        },
        {
          "role": "伊涅芙",
          "text": "这里就交给我吧，这次也辛苦你们了。"
        },
        {
          "type": "subtitle",
          "text": "前往多莉的店铺"
        },
        {
          "role": "派蒙",
          "text": "上次那个老爷爷好像不在？"
        },
        {
          "role": "？？？",
          "text": "哎呀哎呀，好久不见啊，旅行者和派蒙，看来你们收到我的信了。"
        },
        {
          "role": "派蒙",
          "text": "果然是多莉！"
        },
        {
          "role": "多莉",
          "text": "前两天，我听店员说起你们来调查的事。"
        },
        {
          "role": "多莉",
          "text": "据说有个胆大包天的毛贼前往叮铃哐啷蛋卷工坊行窃，偷走了工坊主人最重要的伙伴之一！"
        },
        {
          "role": "爱诺",
          "text": "对对，就是这样！"
        },
        {
          "role": "多莉",
          "text": "旅行者一直是我的优质客户，既然旅行者想要帮助工坊的主人，那么我自然不能袖手旁观。"
        },
        {
          "role": "多莉",
          "text": "我自己也调查了一下，并为大家准备了一个绝佳的方案！"
        },
        {
          "role": "多莉",
          "text": "盯上那个机器人伙伴的黑市商人特别多，要揪出那个毛贼，肯定无从下手，那不如换个解决问题的思路。"
        },
        {
          "role": "多莉",
          "text": "换言之，与其纠结「是谁偷走了机器人伙伴」的问题，不如先解决「机器人伙伴被偷到哪里去了」的问题！"
        },
        {
          "role": "派蒙",
          "text": "她说的好像还真有些道理…"
        },
        {
          "role": "多莉",
          "text": "锵锵！我恰好认识一位专家，她长年处理走私案件，特别擅长追踪赃物，绝对是帮助各位的不二之选！"
        },
        {
          "role": "多莉",
          "text": "当然，与其优秀的业务能力相对应，她的佣金也一直居高不下。"
        },
        {
          "role": "多莉",
          "text": "不过不用担心，我承诺了要给旅行者八折优惠的。"
        },
        {
          "role": "多莉",
          "text": "不如这样，你们直接按照折扣价把佣金付给我，我来帮你们向那位专家砍价，省心又省力！"
        },
        {
          "role": "多莉",
          "text": "要是专家体谅我的辛苦，能多给一些折扣，剩下的摩拉就当是我的辛苦费了，好不好？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你就直接说要收多少吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "多莉",
          "text": "打八折…八十万摩拉，怎么样？"
        },
        {
          "role": "派蒙",
          "text": "八十万…真的不能再低了？"
        },
        {
          "role": "多莉",
          "text": "再低…总得让我赚一些辛苦费吧？"
        },
        {
          "role": "爱诺",
          "text": "如果能找到铛铛七分甜，八十万摩拉的佣金很值了，这笔摩拉可以让我来出！"
        },
        {
          "role": "多莉",
          "text": "好嘞，这就帮您联系那位专家！"
        },
        {
          "role": "派蒙",
          "text": "算了，爱诺急着把同伴救回来，也管不了那么多了。"
        },
        {
          "role": "多莉",
          "text": "锵锵！专家正好就在附近，我就不打扰你们洽谈了。"
        },
        {
          "type": "subtitle",
          "text": "已完成？？？"
        },
        {
          "role": "派蒙",
          "text": "这不是瑟琪吗？我记得她是海沫村的美露莘！"
        },
        {
          "role": "瑟琪",
          "text": "旅行者和派蒙？没想到能在这里见到你们。"
        },
        {
          "type": "subtitle",
          "text": "未完成？？？"
        },
        {
          "role": "派蒙",
          "text": "美露莘？"
        },
        {
          "role": "瑟琪",
          "text": "旅行者和派蒙？没想到能在这里见到你们，我是瑟琪，我很早就听说过你们了。"
        },
        {
          "role": "雅珂达",
          "text": "竟然能请到美露莘？据我所知，枫丹的美露莘是一种十分神奇的生物，她们拥有普通人类无法企及的感官和洞察力。"
        },
        {
          "role": "爱诺",
          "text": "真的吗？听上去很厉害！"
        },
        {
          "role": "雅珂达",
          "text": "有这位美露莘帮忙，肯定能找到铛铛七分甜的下落，看来这笔费用花得很值啊。"
        },
        {
          "role": "派蒙",
          "text": "不，你们不了解多莉…"
        },
        {
          "role": "瑟琪",
          "text": "费用？你们在说什么啊？"
        },
        {
          "role": "瑟琪",
          "text": "旅行者对于美露莘来说简直就是传说中的英雄，能帮上旅行者的忙是我的荣幸，我一摩拉都不会收的。"
        },
        {
          "role": "多莉",
          "text": "真没想到旅行者是被这位专家崇敬的英雄人物！这么说，我最后能赚到的辛苦费是…八十万摩拉！"
        },
        {
          "role": "多莉",
          "text": "嘿嘿，谢谢客户捧场！不过，说到底还是因为旅行者的英雄事迹，我才能抓住这次商机…"
        },
        {
          "role": "多莉",
          "text": "那就这样，下次的交易，我给旅行者预留五折优惠！"
        },
        {
          "role": "派蒙",
          "text": "到最后还是让这个奸商赚到了…对了，瑟琪为什么会到这里来？"
        },
        {
          "role": "瑟琪",
          "text": "说来话长，有一名逐影庭的美露莘探员正在追查一桩走私案，她从枫丹一路追到挪德卡莱，到现在都还没回过家。"
        },
        {
          "role": "瑟琪",
          "text": "大家都很担心，我又正好在休假，于是大家就安排我到这里来探望她。"
        },
        {
          "role": "瑟琪",
          "text": "我的事就先放一边吧，听这位须弥商人说，你们是想让我帮忙寻找被掳走的伙伴？"
        },
        {
          "role": "瑟琪",
          "text": "请先向我描述一下这位伙伴的特征，最好详细一些，然后带我去你们最后见到它的地方。"
        },
        {
          "role": "爱诺",
          "text": "好的，没问题！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（多莉）"
        },
        {
          "role": "多莉",
          "text": "摩拉，嘿嘿…啊，谢谢惠顾！"
        },
        {
          "type": "subtitle",
          "text": "前往侦察单元消失的地点"
        },
        {
          "role": "爱诺",
          "text": "就是这里了，我记得很清楚，那架侦察单元就是在这个方向消失的。"
        },
        {
          "role": "瑟琪",
          "text": "嗯…我大致了解过这种飞行机械，它们的续航时间一般都不会太长，飞到这里来估计已经到极限了。"
        },
        {
          "role": "瑟琪",
          "text": "肯定有人在这里接应那架侦察单元，我建议在附近找人问问。"
        },
        {
          "role": "派蒙",
          "text": "那里就有一些人，或许可以找他们问一下？"
        },
        {
          "role": "派蒙",
          "text": "你好，我们想问一下…"
        },
        {
          "role": "盗宝团头目",
          "text": "哪来的小屁孩儿？不想惹麻烦就别来烦人。"
        },
        {
          "role": "瑟琪",
          "text": "这下就难办了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑟琪",
          "text": "从法律的角度出发，即便是犯罪嫌疑人也有保持沉默的权利，我们无法命令对方回答问题。"
        },
        {
          "role": "雅珂达",
          "text": "你担心这个？好说，挪德卡莱没有法律。"
        },
        {
          "role": "爱诺",
          "text": "叮铃哐啷军团，上！"
        },
        {
          "type": "subtitle",
          "text": "在爱诺的「询问」下，对方终于愿意开口。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "盗宝团头目",
          "text": "有话好好说，想问什么就直接问好了！"
        },
        {
          "role": "瑟琪",
          "text": "你们有没有看到一伙背负着重物的人从这里经过？如果有的话，他们朝哪个方向去了？"
        },
        {
          "role": "盗宝团头目",
          "text": "这样的人，每天都有不少…"
        },
        {
          "role": "瑟琪",
          "text": "嗯…算上提前蹲守的时间，还有撤离的时间…"
        },
        {
          "role": "瑟琪",
          "text": "确切来说，是两天前的下午四点钟到晚上十点钟之间，曾经出现在附近的，离开时背负着重物的人。"
        },
        {
          "role": "盗宝团头目",
          "text": "这样讲的话…我好像想起来了，那天确实有一伙鬼鬼祟祟的家伙，下午来，晚上走，我记得他们朝那个方向去了。"
        },
        {
          "role": "瑟琪",
          "text": "那个方向…考虑到他们掳走的机器人伙伴还同时被很多黑市商人盯着，他们能选择的路线是有限的，再考虑一下负重…"
        },
        {
          "role": "瑟琪",
          "text": "我大概知道他们的下一处落脚点在哪里了。"
        },
        {
          "type": "subtitle",
          "text": "前往瑟琪推测的地点"
        },
        {
          "role": "派蒙",
          "text": "是这里吗？到处都看不到人啊。"
        },
        {
          "role": "瑟琪",
          "text": "假设他们的体力属于正常成年人类该有的水平，再用他们的负重进行推算，来到这里之后，他们就不得不停下来休息了。"
        },
        {
          "role": "瑟琪",
          "text": "这样一来，就会留下很多痕迹。"
        },
        {
          "role": "雅珂达",
          "text": "痕迹？什么样的痕迹？在我看来，这里和普通的野外没多少区别…"
        },
        {
          "role": "瑟琪",
          "text": "有很多啊，这里，还有那里…哦，人类的话好像很难注意到呢。我把留下痕迹的地方指出来，请大家帮忙查看一下吧。"
        },
        {
          "type": "subtitle",
          "text": "调查附近的痕迹"
        },
        {
          "type": "subtitle",
          "text": "调查树枝"
        },
        {
          "role": "旅行者",
          "text": "（这几根树枝是谁落下的？是做饭用的柴火？）"
        },
        {
          "type": "subtitle",
          "text": "调查炉灶"
        },
        {
          "type": "subtitle",
          "text": "调查侦察单元",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "爱诺",
          "text": "这是那天的侦察单元！但是铛铛七分甜不在这里…"
        },
        {
          "role": "瑟琪",
          "text": "嗯…跟我预料的差不多，接应侦察单元之后，为了掩人耳目，他们把侦察单元和货物一起带走了。"
        },
        {
          "role": "瑟琪",
          "text": "但一路走到这里之后体力实在撑不住。他们争论一番，考虑到这里很难被人发现，就丢下侦察单元，只带着货物离开了。"
        },
        {
          "role": "瑟琪",
          "text": "这里有一串脚印，应该就是他们离开时留下的。"
        },
        {
          "role": "爱诺",
          "text": "只靠一串脚印的话，我们能确认他们去了哪里吗？"
        },
        {
          "role": "瑟琪",
          "text": "唔…这串脚印还是能提供一些线索，脚印里有一种特殊的沙粒，明显不属于我们经过的地方。"
        },
        {
          "role": "瑟琪",
          "text": "如果我的推断没错，这些沙粒是那些盗窃犯从他们日常活动的地方带出来的，那里很可能就是他们的老巢。"
        },
        {
          "role": "雅珂达",
          "text": "特殊的沙粒…我想起来了，月矩力试验设计局所在的帕哈岛有一个叫做绯沙盐沼的地方，那里有一大片沙滩！"
        },
        {
          "role": "瑟琪",
          "text": "那里应该就是我们的目的地。"
        },
        {
          "role": "爱诺",
          "text": "美露莘真厉害，我好想养一只！"
        },
        {
          "type": "subtitle",
          "text": "瑟琪吹响了哨子…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "瑟琪",
          "text": "不能对美露莘说这种话的…"
        },
        {
          "role": "派蒙",
          "text": "既然已经找到最后的线索了，我们抓紧时间吧。"
        },
        {
          "type": "subtitle",
          "text": "前往绯沙盐沼"
        },
        {
          "role": "爱诺",
          "text": "这里果然有一处营地！但我看不到铛铛七分甜在哪里，是被藏在里面了？"
        },
        {
          "role": "雅珂达",
          "text": "有这么多人守着，硬闯进去恐怕不现实…"
        },
        {
          "role": "瑟琪",
          "text": "很抱歉，只能到这里了。再往里走，我帮不上什么忙。"
        },
        {
          "role": "爱诺",
          "text": "瑟琪不用道歉，你已经帮了我很多，就算是偷吃甜食，我也愿意分一大块给你。"
        },
        {
          "role": "爱诺",
          "text": "接下来就不要跟着我们了，因为我准备做一些很过分的事，瑟琪这样的好孩子不适合做这样的事。"
        },
        {
          "role": "瑟琪",
          "text": "嗯…好吧。"
        },
        {
          "role": "派蒙",
          "text": "爱诺？"
        },
        {
          "role": "爱诺",
          "text": "就像我说过的那样，叮铃哐啷蛋卷工坊的老大来拯救她的同伴了！"
        },
        {
          "type": "subtitle",
          "text": "攻入敌方营地"
        },
        {
          "type": "subtitle",
          "text": "清扫敌方目标"
        },
        {
          "type": "subtitle",
          "text": "击败拦路的敌人，深入营地",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "哇，是咻咻咻间谍1号？"
        },
        {
          "role": "爱诺",
          "text": "现在是咻咻咻战士1号！"
        },
        {
          "role": "雅珂达",
          "text": "爱诺这家伙果然还是造出了危险的东西…"
        },
        {
          "role": "爱诺",
          "text": "我们跟着它往里面冲就行，这里的坏蛋都挡不住它！"
        },
        {
          "role": "慌乱的盗宝团成员",
          "text": "这是什么东西？救，救命啊！"
        },
        {
          "role": "强装镇定的盗宝团成员",
          "text": "别跑！怕什么，把它拦下来！啊…"
        },
        {
          "type": "subtitle",
          "text": "寻找铛铛七分甜"
        },
        {
          "role": "派蒙",
          "text": "终于到最里面了——那是什么？"
        },
        {
          "role": "？？？",
          "text": "嗡嗡…"
        },
        {
          "role": "雅珂达",
          "text": "好强的威力，难道…"
        },
        {
          "role": "爱诺",
          "text": "铛铛七分甜的核心在那个铁皮壳子里面…它已经被改装了！"
        },
        {
          "role": "？？？",
          "text": "哈哈，我一点也不意外，经过我改良的作品，果然比你那些幼稚的玩具更强大！"
        },
        {
          "role": "派蒙",
          "text": "是那个黑市的柜台？竟然是你？"
        },
        {
          "role": "尤斯塔奇",
          "text": "想要完成一项震惊世界的事业，居于幕后才是最聪明的选择。"
        },
        {
          "role": "尤斯塔奇",
          "text": "当然，我承认你们的到来让我有些意外，你们本应该盯着那些黑市商人晕头转向才对…"
        },
        {
          "role": "雅珂达",
          "text": "原来是你在刻意误导我们…"
        },
        {
          "role": "尤斯塔奇",
          "text": "好好想想，为什么第一张公告就有你们想要的线索？"
        },
        {
          "role": "尤斯塔奇",
          "text": "柜台是信息流转的地方，只要稍微安排一下每个人能看到的信息，就能让绝大多数人为我所用。"
        },
        {
          "role": "雅珂达",
          "text": "最初偷走铛铛七分甜的人，还有后来抢走铛铛七分甜的人，都是你？"
        },
        {
          "role": "尤斯塔奇",
          "text": "是又怎么样？现在已经不用瞒着你们了。"
        },
        {
          "role": "尤斯塔奇",
          "text": "挪德卡莱是个赢家通吃的世界，有了这台原型机，我能赚到的摩拉足以让我和其他势力平起平坐，轮不到你来指责我！"
        },
        {
          "role": "雅珂达",
          "text": "就凭从爱诺那里偷来的技术？"
        },
        {
          "role": "尤斯塔奇",
          "text": "偷？我是在妥善利用她浪费的天赋！"
        },
        {
          "role": "尤斯塔奇",
          "text": "了解到挪德卡莱的月矩力之后，我最先想到将它和机械结合能有多么广阔的前景！可是在我千里迢迢来到这里之后…"
        },
        {
          "role": "尤斯塔奇",
          "text": "无论是那些死板的原住民，还是垄断了月矩力研究项目的愚人众，都对我提出的合作嗤之以鼻。"
        },
        {
          "role": "尤斯塔奇",
          "text": "反倒是这个丫头，每天都只会制作一些幼稚的玩具，却可以创建自己的工坊，在各大势力之间经营得风生水起！"
        },
        {
          "role": "尤斯塔奇",
          "text": "甚至还能自行研发出这种跨时代的机械，眼看着就要左右机械造物的市场格局…"
        },
        {
          "role": "尤斯塔奇",
          "text": "她的位置，本来应该是我的！"
        },
        {
          "role": "派蒙",
          "text": "这种话说出来真的不会脸红吗？"
        },
        {
          "role": "爱诺",
          "text": "不用再啰嗦了，快把铛铛七分甜还给我！"
        },
        {
          "role": "尤斯塔奇",
          "text": "那就要看你们的本事了！"
        },
        {
          "type": "subtitle",
          "text": "坚持下去"
        },
        {
          "role": "派蒙",
          "text": "被改装后的铛铛七分甜威力这么大吗？"
        },
        {
          "role": "雅珂达",
          "text": "敲也敲不动…"
        },
        {
          "role": "爱诺",
          "text": "听我的，不要攻击它，只要坚持一段时间就好。"
        },
        {
          "role": "爱诺",
          "text": "铛铛七分甜绝对不会变成战争兵器的！"
        },
        {
          "type": "subtitle",
          "text": "在'''被改造的铛铛七分甜'''的攻击中坚持下来",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "被改造的铛铛七分甜",
          "text": "嗡…嗡…"
        },
        {
          "role": "尤斯塔奇",
          "text": "怎么回事？技术人员！赶紧看一下！"
        },
        {
          "role": "技术人员",
          "text": "这…负责浓缩月矩力的核心停止工作了，这种核心运转时似乎需要消耗一种特定的媒介物质…"
        },
        {
          "role": "尤斯塔奇",
          "text": "什么样的物质？"
        },
        {
          "role": "技术人员",
          "text": "这种味道…是某种甜品？"
        },
        {
          "role": "尤斯塔奇",
          "text": "什么！？"
        },
        {
          "role": "爱诺",
          "text": "有什么好惊讶的？铛铛七分甜是负责烤制甜品的机器人，但如果它只能看着别人吃，那就太可怜了。"
        },
        {
          "role": "爱诺",
          "text": "所以在最初设计时，我就决定让铛铛七分甜也能吃甜品，这样等甜品烤出来之后，它可以和大家一起分享。"
        },
        {
          "role": "技术人员",
          "text": "我大概明白了，这种核心必须要消耗蛋糕之类的甜品，才能让浓缩月矩力的系统运转起来。"
        },
        {
          "role": "技术人员",
          "text": "如果只是用来烤制甜品，它的功率输出完全跟得上。"
        },
        {
          "role": "技术人员",
          "text": "但如果是要改造成战争兵器，把整个挪德卡莱的面粉和糖都集中起来也经不起消耗…"
        },
        {
          "role": "尤斯塔奇",
          "text": "你现在才看出来？赶紧把这个愚蠢的功能改装掉！"
        },
        {
          "role": "技术人员",
          "text": "老板，这个是固化在系统里的，以我的水平甚至无法在最初就发现它，更别说改装了…"
        },
        {
          "role": "爱诺",
          "text": "你明白了吧？铛铛七分甜绝对不会变成战争兵器的，把它还给我。"
        },
        {
          "role": "尤斯塔奇",
          "text": "它本可以是一项跨时代的发明，帮我成就一番事业，结果现在只能是一种可笑的厨具…就因为你那种幼稚而又愚蠢的想法？"
        },
        {
          "role": "尤斯塔奇",
          "text": "不行，至少要先把这个原型机留下来，只要它能撑到我拉来投资…来人，把原型机抢回来！"
        },
        {
          "role": "爱诺",
          "text": "你敢…"
        },
        {
          "role": "爱诺",
          "text": "伊涅芙！"
        },
        {
          "role": "派蒙",
          "text": "还有大家！"
        },
        {
          "role": "伊涅芙",
          "text": "爱诺，保护工坊的同伴向来不仅仅是老大的责任——启动歼灭模式。"
        },
        {
          "type": "subtitle",
          "text": "夺回伙伴"
        },
        {
          "type": "subtitle",
          "text": "与爱诺对话"
        },
        {
          "role": "派蒙",
          "text": "可恶！竟然让那个坏蛋跑了。"
        },
        {
          "role": "雅珂达",
          "text": "不用追了，挪德卡莱没有法律，但挪德卡莱有规矩，等这里发生的事被捅出去后，会有人收拾他的。"
        },
        {
          "role": "瑟琪",
          "text": "你们没事吧？在挪德卡莱，似乎没有报警这种概念，所以我想办法联系到了你们的朋友。"
        },
        {
          "role": "派蒙",
          "text": "哦，原来是多亏了瑟琪啊！"
        },
        {
          "role": "爱诺",
          "text": "对了，铛铛七分甜呢？"
        },
        {
          "role": "阿索",
          "text": "…工坊的主人，刚刚的混战中，我和族人一起夺回了这个机器人的核心，现在把它交还给你，就当是作为致歉的补充。"
        },
        {
          "role": "阿索",
          "text": "请您一定要保管好这种技术，或者说，这种技术只有被保管在您的手中，我们才能安心啊。"
        },
        {
          "role": "爱诺",
          "text": "不要再说那些事情了，反正…我知道你们不是坏蛋了，这样就行了吧？"
        },
        {
          "role": "爱诺",
          "text": "伊涅芙，我们回家吧。对了，回去之后我要吃甜品，这个月的摄入量重新开始算！"
        }
      ],
