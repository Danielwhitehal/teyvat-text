{
  "quest_id": 2056,
  "chapter_num": "流泉所归之处  第二幕",
  "chapter_title": "神秘岛的传说",
  "type": "lq",
  "route": "The Legend of the Mysterious Island",
  "stories": [
    {
      "story_id": 15006,
      "title": "神秘岛的传说",
      "description": "被勾起好奇心的你们决定前往流泉之众，向部族首领打听有关神秘岛的传说。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往寻找流泉之众的首领"
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务第五章·第一幕中的「温泉之乡」"
        },
        {
          "role": "派蒙",
          "text": "「流泉之众」的首领应该在这里吧？"
        },
        {
          "role": "阿米娜",
          "text": "有人找我？哦？这不是旅行者和他的搭档嘛。"
        },
        {
          "role": "派蒙",
          "text": "首领是个…小孩子？你怎么知道我们？"
        },
        {
          "role": "阿米娜",
          "text": "作为部族的首领，我当然要收集任何可能会对纳塔产生重大影响的情报，这样才能想出更好的点子。"
        },
        {
          "type": "subtitle",
          "text": "已完成该任务"
        },
        {
          "role": "阿米娜",
          "text": "有人找我？哦？这不是旅行者和他的搭档嘛。"
        },
        {
          "role": "阿米娜",
          "text": "两位专门来找我，是有什么需要帮忙的地方吗？"
        },
        {
          "role": "派蒙",
          "text": "我们想去神秘岛！"
        },
        {
          "role": "阿米娜",
          "text": "神秘岛…"
        },
        {
          "role": "派蒙",
          "text": "有什么问题吗？"
        },
        {
          "role": "阿米娜",
          "text": "两位应该已经知道这座岛与我们「流泉之众」的一个传说有关吧？"
        },
        {
          "role": "派蒙",
          "text": "嗯，不过话说回来，这个传说具体讲了什么我们倒还没了解过。"
        },
        {
          "role": "阿米娜",
          "text": "那不妨先让我给两位介绍一下。"
        },
        {
          "role": "阿米娜",
          "text": "传说「流泉之众」的初代首领是彼时全纳塔最优秀的向导，他发现了许多人迹罕至的秘境，也找到了数不清的宝藏。"
        },
        {
          "role": "阿米娜",
          "text": "为了再一次证明自己，他重新踏上旅途，寻找传说中的神秘岛。这一路历经艰险，但他最终成功抵达目的地。"
        },
        {
          "role": "阿米娜",
          "text": "那座岛散发着金色的光芒，是无尽宝藏的埋藏之地。但是他没有取回任何宝藏，而是留下了前往神秘岛的线索。"
        },
        {
          "role": "阿米娜",
          "text": "此后，无数后来者向那座传说中的岛屿发起了挑战。毕竟，只要成功到达那里，财富和名望就全部唾手可得。"
        },
        {
          "role": "派蒙",
          "text": "哦哦，原来是这样！那可以告诉我们如何前往神秘岛吗？"
        },
        {
          "role": "阿米娜",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "呃，我懂了，这恐怕是「流泉之众」的最高机密，不能对外人讲，对吧？"
        },
        {
          "role": "阿米娜",
          "text": "其实恰恰相反，这个传说还有找到神秘岛所需要的线索都是公开的。"
        },
        {
          "role": "派蒙",
          "text": "那…"
        },
        {
          "role": "阿米娜",
          "text": "不要担心，我愿意解答两位的疑问，只是作为交换，我也想请两位帮我一个忙，如何？"
        },
        {
          "role": "派蒙",
          "text": "这个当然没问题，具体要做什么？"
        },
        {
          "role": "阿米娜",
          "text": "那我先道谢了，请两位容我仔细说明一下。"
        },
        {
          "role": "阿米娜",
          "text": "实不相瞒，「流泉之众」内部也有败类。不久前我接到举报，有几名族人合伙骗取游客的钱财。"
        },
        {
          "role": "阿米娜",
          "text": "作为「流泉之众」的首领，我对此感到十分惭愧…"
        },
        {
          "role": "派蒙",
          "text": "竟然有这种事？"
        },
        {
          "role": "阿米娜",
          "text": "而他们的目标，就是想前往神秘岛的游客。"
        },
        {
          "role": "阿米娜",
          "text": "据举报人说，他们会假借向导的身份骗取这些游客的信任，以带领游客前往神秘岛的名义诱导游客进行高额消费。"
        },
        {
          "role": "阿米娜",
          "text": "他们的手段很高明，游客被骗的每一笔钱都被他们包装成了某种合法的旅游消费，难以直接用来给他们定罪。"
        },
        {
          "role": "阿米娜",
          "text": "所以，我希望能有人主动接触他们，假装被骗，并暗中收集足够强力的证据。"
        },
        {
          "role": "阿米娜",
          "text": "只是…我身边的人他们肯定能认出来，因此这个计划一直无法执行。"
        },
        {
          "role": "派蒙",
          "text": "哦，我明白了，我和旅行者都是外来游客，正好可以引他们上钩！"
        },
        {
          "role": "阿米娜",
          "text": "嗯，此外据我所知，两位的身手也相当不错，那么就算那些骗子起了别的歹心，两位也完全能够自保，对吧？"
        },
        {
          "role": "派蒙",
          "text": "当然，只是几个骗子的话，旅行者能把他们全揍扁！"
        },
        {
          "role": "阿米娜",
          "text": "这样就再好不过了，那么请收好这个。"
        },
        {
          "role": "[[文件",
          "text": "世界任务-神秘岛的传说-阿米娜的钱袋.png|center|150px]]"
        },
        {
          "role": "派蒙",
          "text": "哇，好多摩拉，这是额外的报酬？"
        },
        {
          "role": "阿米娜",
          "text": "如果真的能抓住那些败类，两位想要额外的报酬也未尝不可，不过这笔钱有别的用处。"
        },
        {
          "role": "阿米娜",
          "text": "两位肯定要先消费几次才能降低对方的警惕，我当然不能让两位自掏腰包。"
        },
        {
          "role": "阿米娜",
          "text": "这笔钱两位可以随意使用，请尽量多收集一些证据。"
        },
        {
          "role": "派蒙",
          "text": "真不愧是首领，想得这么周到，那就交给我们吧！"
        },
        {
          "role": "阿米娜",
          "text": "那些人出没的区域我已经在地图上圈了出来，接下来就拜托两位了。"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|阿米娜的钱袋}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿米娜）"
        },
        {
          "role": "阿米娜",
          "text": "必须是切实的证据才可以，拜托了。"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点引诱骗子露面"
        },
        {
          "role": "派蒙",
          "text": "就是这里了，让我看看哪个像是骗子。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对了，我们是来假装被骗的，那要怎么做才能引出骗子呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "聊一聊神秘岛？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "也对，说起来，神秘岛上的无尽宝藏到底是什么，我真的有些好奇呢！不知道有没有人真的见过那些宝藏的样子？"
        },
        {
          "role": "卡乌鲁",
          "text": "两位远方的来客可是想前往神秘岛？"
        },
        {
          "role": "派蒙",
          "text": "你是…哦，旅行者，我们这算是把人引出来了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，注意伪装。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "咳咳，阁下有什么事吗？"
        },
        {
          "role": "卡乌鲁",
          "text": "在下路过时偶然听到两位在谈论有关神秘岛的事，那么想必两位是被这个传说吸引而来，想要寻找神秘岛的游客吧？"
        },
        {
          "role": "派蒙",
          "text": "你好，我是派蒙，这位是旅行者，我们确实准备寻找传说中的神秘岛！"
        },
        {
          "role": "卡乌鲁",
          "text": "那样的话，作为一名合格的向导，我可不能放任游客踏上如此凶险的旅途啊。"
        },
        {
          "role": "派蒙",
          "text": "哦？"
        },
        {
          "role": "卡乌鲁",
          "text": "诚如传说所言，只要成功到达神秘岛，财富和名望，全部唾手可得。"
        },
        {
          "role": "卡乌鲁",
          "text": "不过与之对应，这一路上也充满了艰难险阻。普通人想要到达那里，难如登天。"
        },
        {
          "role": "卡乌鲁",
          "text": "说到这里，就不得不提到我们向导存在的意义了。我们的使命就是带领游客避开危险，找到捷径，最终抵达目的地。"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来是在推销自己？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡乌鲁",
          "text": "两位不必多虑，这是我必须强调的一点。"
        },
        {
          "role": "卡乌鲁",
          "text": "虽然找到神秘岛的线索是和传说故事一起公开的，但是先祖留下的线索就像藏宝图上的谜语一样难懂。"
        },
        {
          "role": "卡乌鲁",
          "text": "只有接受了先祖传承的向导才能正确解读这些线索，擅自行动的游客往往会迷路，或者遭遇不必要的危险。"
        },
        {
          "role": "派蒙",
          "text": "编得倒挺有道理…"
        },
        {
          "role": "卡乌鲁",
          "text": "我和两位还算有缘，不如就由我来担任两位的向导，如何？"
        },
        {
          "role": "派蒙",
          "text": "嗯…请问你的佣金是多少？"
        },
        {
          "role": "卡乌鲁",
          "text": "不用担心，我不准备向两位收取佣金。"
        },
        {
          "role": "派蒙",
          "text": "竟然不收钱？"
        },
        {
          "role": "卡乌鲁",
          "text": "带领游客成功抵达神秘岛对我们「流泉之众」的向导来说是一份崇高的荣誉，这份荣誉本身就价值千金。"
        },
        {
          "role": "派蒙",
          "text": "说得我都要信了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不要只听他怎么说。",
              "dialogues": []
            },
            {
              "text": "还要看他想做什么。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧，那就承蒙关照了！"
        },
        {
          "role": "卡乌鲁",
          "text": "两位请随我来。"
        },
        {
          "type": "subtitle",
          "text": "跟随骗子向导"
        },
        {
          "role": "基耶霍",
          "text": "嗯？两位是想跟鳍游龙合影吗？"
        },
        {
          "role": "派蒙",
          "text": "真的可以合影啊？"
        },
        {
          "role": "卡乌鲁",
          "text": "咳咳！"
        },
        {
          "role": "基耶霍",
          "text": "哦？哦…两位是来向阿塔祈求启示的吧？"
        },
        {
          "role": "派蒙",
          "text": "阿塔？启示？"
        },
        {
          "role": "基耶霍",
          "text": "嘘，小声些，大声直呼其名会被阿塔厌恶的。"
        },
        {
          "role": "卡乌鲁",
          "text": "抱歉，是我没有及早向两位游客说明。如两位所见，阿塔便是由这位前辈负责侍奉的一头鳍游龙长老。"
        },
        {
          "role": "卡乌鲁",
          "text": "它在族群内部威望极高，并且远比其他鳍游龙见多识广，据说它真的到达过神秘岛。"
        },
        {
          "role": "卡乌鲁",
          "text": "因此，只有通过它给出的启示，我们才能找到接下来的路。"
        },
        {
          "role": "派蒙",
          "text": "是这样吗？那么怎样才能让它给我们启示？难道鳍游龙长老会说话？"
        },
        {
          "role": "卡乌鲁",
          "text": "两位只要慢慢靠近阿塔就好，它确认两位身上的气息后，就会给出启示——当然，是以鳍游龙的语言。"
        },
        {
          "role": "卡乌鲁",
          "text": "不过不要担心，在「流泉之众」做向导，需要具备的基本功之一就是解读鳍游龙的语言。"
        },
        {
          "role": "卡乌鲁",
          "text": "我可以理解阿塔给出的启示，带领两位继续前进。"
        },
        {
          "role": "派蒙",
          "text": "那就…先试一下。"
        },
        {
          "role": "基耶霍",
          "text": "咳咳！一人一万摩拉。"
        },
        {
          "role": "派蒙",
          "text": "哎！？"
        },
        {
          "role": "基耶霍",
          "text": "呃…阿塔给出启示需要回忆过往，这对鳍游龙来说十分消耗精力，帮它调养要花很多钱！"
        },
        {
          "role": "卡乌鲁",
          "text": "很抱歉，在找到线索的过程中确实会产生类似的支出，不过只要能成功到达神秘岛，这些花费完全不值一提。"
        },
        {
          "role": "派蒙",
          "text": "…果然来了，我就知道不可能免费。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "先付钱吧，别让他起疑心。",
              "dialogues": []
            },
            {
              "text": "顺便收集证据。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哦！我有个办法，我估计刚刚有关鳍游龙的说法是他们瞎编的，那我们就要一张收据，证明他们欺诈游客。"
        },
        {
          "role": "派蒙",
          "text": "这样一来，他们就赖不掉了！"
        },
        {
          "role": "基耶霍",
          "text": "怎么聊了那么久…那这样如何？我附赠和阿塔合照的服务，这种机会可很难得哦！"
        },
        {
          "role": "派蒙",
          "text": "哦？那这算是意外收获！我们赶紧付钱吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你开心就好。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（基耶霍&卡乌鲁）"
        },
        {
          "role": "基耶霍",
          "text": "记住，要慢一点，可不要吓到阿塔。"
        },
        {
          "role": "卡乌鲁",
          "text": "不要担心，我会帮两位解读阿塔给出的启示。"
        },
        {
          "type": "subtitle",
          "text": "尝试靠近阿塔并合照"
        },
        {
          "role": "派蒙",
          "text": "哇，真的不会咬我们哎！"
        },
        {
          "role": "基耶霍",
          "text": "要合影的话，现在可以摆姿势了。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯！"
        },
        {
          "role": "阿塔",
          "text": "（阿塔发出了一阵意义不明的叫声。）"
        },
        {
          "role": "卡乌鲁",
          "text": "阿塔已经给出启示了！让我仔细听一下…我懂了！"
        },
        {
          "role": "派蒙",
          "text": "刚刚的叫声真的有什么特殊的含义吗？"
        },
        {
          "role": "卡乌鲁",
          "text": "嗯，毕竟鳍游龙的语言只有我这样的向导才能听懂呢，我们可以按照指示前往下一个地点了。"
        },
        {
          "role": "基耶霍",
          "text": "这是合照的画片，两位收好，包装免费。"
        },
        {
          "role": "派蒙",
          "text": "你这边提供收据吗？"
        },
        {
          "role": "基耶霍",
          "text": "你想要当然可以，给。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿！"
        },
        {
          "role": "卡乌鲁",
          "text": "两位请随我来吧。"
        },
        {
          "role": "派蒙",
          "text": "首领给的钱还剩很多，不如继续演一下，多收集些证据？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我同意。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼，我倒要看看这个骗子还能怎么骗人。"
        },
        {
          "type": "subtitle",
          "text": "在卡乌鲁的带领下，你们获得了一个又一个「线索」，也支付了一笔又一笔费用。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这个骗子也太贪心了吧？每次都能编出一个奇奇怪怪的理由，让我们付的钱一次比一次多。"
        },
        {
          "role": "派蒙",
          "text": "有这么多证据，现在把他揪到首领那里，肯定能定他的罪！"
        },
        {
          "role": "派蒙",
          "text": "不过…话说回来，已经花了这么多钱，我倒真想看看他能不能带我们去神秘岛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "多一些证据不是坏事。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡乌鲁",
          "text": "抱歉让两位久等了，所有线索都已集齐，我成功为两位找到了一条通往神秘岛的捷径！"
        },
        {
          "role": "派蒙",
          "text": "那…那就启程吧！"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|卡乌鲁推荐的探险装备}}、{{图标|与阿塔的合照}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "按照启示前往指定地点"
        },
        {
          "role": "卡乌鲁",
          "text": "就是在这里，阳光的轨迹将指明前路——只要涉过湍流，夕阳的光辉即可揭示一切。"
        },
        {
          "role": "卡乌鲁",
          "text": "阿塔的启示已经向我们指明了目的地，就在对岸！"
        },
        {
          "role": "派蒙",
          "text": "这就要到了吗？这一路上感觉什么惊险的环节都没有…"
        },
        {
          "role": "卡乌鲁",
          "text": "正如之前所说，这是我找到的一条捷径，两位花了这么多钱却还要受苦的话，岂不显得我这个向导无能？"
        },
        {
          "role": "卡乌鲁",
          "text": "事不宜迟，我们需要在日落前到达那里。"
        },
        {
          "type": "subtitle",
          "text": "抵达「神秘岛」"
        },
        {
          "role": "卡乌鲁",
          "text": "根据启示，目的地已在脚下！"
        },
        {
          "role": "派蒙",
          "text": "啊？神秘岛该不会是指…"
        },
        {
          "role": "卡乌鲁",
          "text": "我已经按照约定带领两位找到神秘岛，那么就此别过了。"
        },
        {
          "role": "派蒙",
          "text": "等一下！你说这里是神秘岛？那宝藏在哪里？这些木牌还有人造灯光…假得不能再假了好吗？"
        },
        {
          "role": "卡乌鲁",
          "text": "宝藏只是传说里的说法，我可没有对此做过任何保证，神秘岛为什么不能是这个样子的？"
        },
        {
          "role": "派蒙",
          "text": "哼，看来你已经露出本来面目了，那我们也没必要继续演戏。"
        },
        {
          "role": "派蒙",
          "text": "我们受「流泉之众」的首领委托，前来收集你诈骗游客的证据！有了那些收据，你这次可跑不了了！"
        },
        {
          "role": "卡乌鲁",
          "text": "哼…那些收据上写了什么？"
        },
        {
          "role": "派蒙",
          "text": "写了…哎？怎么字迹都消失了？"
        },
        {
          "role": "卡乌鲁",
          "text": "带你们走这么远就是为了等字迹消失。现在，就算你们回去找那些收费的人，也会发现他们用的都是化名，查无此人。"
        },
        {
          "role": "卡乌鲁",
          "text": "你们说我诈骗游客？我还要说你们诬告呢。没有事的话，我就先告辞了。"
        },
        {
          "role": "派蒙",
          "text": "可恶，他还想跑！我们快追上去！"
        },
        {
          "type": "subtitle",
          "text": "你们快步追上卡乌鲁，却发现他已经被几名「流泉之众」的族人拦住去路。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "是首领！"
        },
        {
          "role": "卡乌鲁",
          "text": "首领怎么到这里来了…"
        },
        {
          "role": "阿米娜",
          "text": "我一直派人暗中跟随，多谢你们，现在终于能给他的诈骗行为定罪了。"
        },
        {
          "role": "卡乌鲁",
          "text": "定罪？他们手里可没有我犯罪的证据。即便是首领，不讲证据的话也无法服众吧？"
        },
        {
          "role": "派蒙",
          "text": "真是不好意思，我们被他摆了一道，到手的证据都没了…"
        },
        {
          "role": "阿米娜",
          "text": "不急，先搜一下。"
        },
        {
          "role": "卡乌鲁",
          "text": "你们想干什么？把手拿开，那是我的钱！"
        },
        {
          "role": "阿米娜",
          "text": "这个标记…看来你带他们两位来这里之前就已经分赃了。"
        },
        {
          "role": "卡乌鲁",
          "text": "什么意思？"
        },
        {
          "role": "阿米娜",
          "text": "旅行者和派蒙今天使用的摩拉都是我提供的，上面有特殊的标记。"
        },
        {
          "role": "卡乌鲁",
          "text": "什么…"
        },
        {
          "role": "阿米娜",
          "text": "那么，这笔本应在他们手中的钱却落到了你的手上，总该有个理由吧？"
        },
        {
          "role": "阿米娜",
          "text": "现在没有收据能证明产生过交易，你刚刚又否认是诈骗所得…难道是抢劫？"
        },
        {
          "role": "派蒙",
          "text": "抢劫…这个罪名可就更重了哦！"
        },
        {
          "role": "卡乌鲁",
          "text": "这，唉…好吧，我承认是诱导他们进行了几次消费…非说是诈骗的话…"
        },
        {
          "role": "阿米娜",
          "text": "证人就在旁边。"
        },
        {
          "role": "卡乌鲁",
          "text": "好吧，是诈骗…"
        },
        {
          "role": "派蒙",
          "text": "好耶！不愧是「流泉之众」的首领！"
        },
        {
          "role": "阿米娜",
          "text": "真不明白为什么会有那么多人上当，明明细想一下就能发现漏洞。"
        },
        {
          "role": "阿米娜",
          "text": "他声称能找到前往神秘岛的捷径，为什么不自己去寻找宝藏，反而来当别人的向导？"
        },
        {
          "role": "派蒙",
          "text": "说起来确实如此，「流泉之众」的向导们有没有找到神秘岛的宝藏？"
        },
        {
          "role": "阿米娜",
          "text": "我可以将这个问题和之前的疑问一起向两位解答，其实答案很简单——"
        },
        {
          "role": "阿米娜",
          "text": "根本不存在前往神秘岛的捷径，甚至绝大多数人都缺少前往神秘岛的必要条件。"
        },
        {
          "role": "阿米娜",
          "text": "不满足这个条件的话，即便是来自「流泉之众」的向导，也很难通过自身能力来解决拦路的难题。"
        },
        {
          "role": "阿米娜",
          "text": "因此，即便通往神秘岛的线索是公开的，历来到达那里的人还是寥寥无几。"
        },
        {
          "role": "派蒙",
          "text": "条件？什么条件？"
        },
        {
          "role": "阿米娜",
          "text": "我想先问一下，两位觉得真正的神秘岛之旅会是什么样子的？"
        },
        {
          "role": "派蒙",
          "text": "这…应该是和同伴共同战胜艰险之后，看到了传说中的美景，收获了一段动人的故事，对了，还找到了珍贵的宝藏！"
        },
        {
          "role": "阿米娜",
          "text": "关键是什么？是「和同伴共同战胜艰险」。"
        },
        {
          "role": "阿米娜",
          "text": "据说初代首领启程寻找神秘岛的时候，陪同他的不是出钱的客户，也不是观光的游客，而是他的挚友们。"
        },
        {
          "role": "阿米娜",
          "text": "传说中也有这样的描述——只有愿意将生命托付给彼此的人，才能携手抵达神秘岛。"
        },
        {
          "role": "阿米娜",
          "text": "因此，这个到达神秘岛的必要条件，就是可以互相托付生命的好朋友。"
        },
        {
          "role": "派蒙",
          "text": "是这样啊…"
        },
        {
          "role": "阿米娜",
          "text": "在我看来，旅行者和派蒙并不缺少可以互相托付的伙伴。"
        },
        {
          "role": "阿米娜",
          "text": "但可惜的是，你们两位都不是有经验的向导，如果另外雇佣的话，用金钱维系关系的双方恐怕无法将生命托付给彼此吧。"
        },
        {
          "role": "派蒙",
          "text": "确实如此…"
        },
        {
          "role": "阿米娜",
          "text": "不过不必沮丧，我相信生养我的这片土地不会让两位失望。"
        },
        {
          "role": "阿米娜",
          "text": "天边的岛屿也好，这里的遗迹也好，感觉都可以提供一段精彩的冒险，不是吗？"
        },
        {
          "role": "阿米娜",
          "text": "告诉你们一个秘密，我的长辈说，这座遗迹下面就藏着前往天空的方法哦！"
        },
        {
          "type": "subtitle",
          "text": "完成世界任务「溯往者不可追」"
        },
        {
          "role": "阿米娜",
          "text": "哎？已经有人发现了吗？"
        },
        {
          "role": "阿米娜",
          "text": "无妨，如果两位还想去其他地方冒险，我也可以提供一些建议。"
        },
        {
          "role": "派蒙",
          "text": "嗯，谢谢你的建议！不过按照以往的经验，如果发现什么地方去不了，我和旅行者都会很不甘心呢…"
        },
        {
          "role": "阿米娜",
          "text": "哦…这一点我理解，如果两位还是想前往神秘岛，我不会阻拦，只是建议你们先找到一位可以互相托付生命的向导。"
        },
        {
          "role": "派蒙",
          "text": "可以互相托付生命的向导？不知道什么时候才能在这里遇到啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许不需要等太久。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "未完成魔神任务第五章·第二幕中的「坠入永夜」"
        },
        {
          "role": "派蒙",
          "text": "嗯，我也有这种预感，那先去其他地方冒险也可以！"
        },
        {
          "type": "subtitle",
          "text": "已完成该任务"
        },
        {
          "role": "派蒙",
          "text": "哦哦！我们可以去找玛拉妮啊！"
        },
        {
          "role": "阿米娜",
          "text": "看来你们已经做好决定了，那我就先在这里告别，额外的报酬我会让助理支付给两位，感谢两位的帮助。"
        },
        {
          "role": "派蒙",
          "text": "嗯！再见！"
        }
      ],
