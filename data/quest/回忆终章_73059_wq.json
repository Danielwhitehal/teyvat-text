{
  "quest_id": 73059,
  "chapter_num": null,
  "chapter_title": "回忆终章",
  "type": "wq",
  "route": "Memory's Final Chapter",
  "stories": [
    {
      "story_id": 73059,
      "title": "回忆终章",
      "description": "尽管失却的回忆如同流水般逝去不返，但友谊却随着时间得以新生…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "到达无郁稠林"
        },
        {
          "type": "subtitle",
          "text": "和海亚姆对话"
        },
        {
          "type": "subtitle",
          "text": "心声（海亚姆）"
        },
        {
          "role": "海亚姆",
          "text": "（那首歌该怎么唱来着…石榴…？苹果…？）"
        },
        {
          "role": "海亚姆",
          "text": "「石榴歌唱，苹果鼓掌…」"
        },
        {
          "role": "派蒙",
          "text": "你好呀，海亚姆先生！你怎么在这里？"
        },
        {
          "role": "海亚姆",
          "text": "哦哦，你好，你好。白色的小朋友，和…唉…抱歉，孩子，我的脑袋不太清楚了，时间稍微一长就记不住名字…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "叫我旅行者就好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "哈哈…好啊，你们就是之前…"
        },
        {
          "role": "派蒙",
          "text": "对！我们就是那两个「杰万」——勇敢的年轻人！"
        },
        {
          "role": "海亚姆",
          "text": "嗯…所以，告诉我，「兰那罗」，他们还记得我吗？还记得我们所有人吗？"
        },
        {
          "role": "派蒙",
          "text": "欸…这个…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他们还记得你。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "……"
                },
                {
                  "role": "海亚姆",
                  "text": "这样啊…但我看不到他们了，也听不到他们如何想念我…真是遗憾。"
                }
              ]
            },
            {
              "text": "他们不记得你了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "但是…我们还可以和他们重新交朋友呀！"
                }
              ]
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "呵呵…我看不到他们了。我太老了，看不到他们的样子，听不到他们的声音…错过了，都错过了。"
        },
        {
          "role": "海亚姆",
          "text": "咳咳…抱歉，我先离开了。或许只有期待奇迹了吧…"
        },
        {
          "role": "海亚姆",
          "text": "奇迹不能去理解，不能去追求，只能等待呀。"
        },
        {
          "type": "subtitle",
          "text": "海亚姆蹒跚着离开了…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "和兰那罗们对话"
        },
        {
          "role": "派蒙",
          "text": "欸，你看，原来他们三个藏在这里呀！"
        },
        {
          "role": "兰纳真",
          "text": "兰纳迦，他来啦，他们来啦！"
        },
        {
          "role": "兰迦鲁",
          "text": "嗯嗯，来啦，来啦！"
        },
        {
          "role": "兰纳迦",
          "text": "来啦，那菈旅行者，白色的飞飞。欢迎你们，我们三个。"
        },
        {
          "role": "兰纳迦",
          "text": "到了，月亮。到啦，种下花朵的时刻。你们准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我准备好了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，我也是！"
        },
        {
          "role": "兰纳迦",
          "text": "那么…兰纳真，兰迦鲁，我们开始仪式吧。"
        },
        {
          "role": "兰纳迦",
          "text": "「归去，归去，花园的梦，森林的记忆…」"
        },
        {
          "role": "兰纳真",
          "text": "「迎接吧，让我们：」"
        },
        {
          "role": "兰纳真",
          "text": "「渐浓的睡梦，不散的欢欣。」"
        },
        {
          "role": "兰迦鲁",
          "text": "「庆贺呀，让我们：」"
        },
        {
          "role": "兰迦鲁",
          "text": "「石榴歌唱，苹果鼓掌！」"
        },
        {
          "type": "subtitle",
          "text": "兰那罗们种下干瘪的花朵，随着歌谣在风中回荡，花朵奇迹般地重返了新生…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "哇…这三朵花，又活过来了！"
        },
        {
          "role": "兰纳迦",
          "text": "是呀，因为…是慈悯的，「无郁夷摩」。所以，她要让记忆有重新焕发的机会。"
        },
        {
          "role": "兰纳真",
          "text": "嗯！即使我们不再记得你们啦，记忆也会…唔，融进叶脉和根系中间，变成绿叶，变成年轮！"
        },
        {
          "role": "兰迦鲁",
          "text": "或者变成肉肉的虫虫，给别的虫虫吃，别的虫虫留下滋养草木的东西，让我们全都长大大！"
        },
        {
          "role": "派蒙",
          "text": "可是…你们还是不记得我们了，对吗？"
        },
        {
          "role": "兰纳迦",
          "text": "嗯…因为，并不专属于你我，记忆…过去经历的事情，我们，已经分给了森林里的所有草木…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰纳真",
          "text": "但是没关系呀，我们已经是新的朋友了，对吧！"
        },
        {
          "role": "兰迦鲁",
          "text": "嗯！新朋友！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（兰纳真）"
        },
        {
          "role": "兰纳真",
          "text": "你好！新朋友！"
        },
        {
          "role": "兰纳真",
          "text": "希望你能一直记得，我们的歌！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（兰纳迦）"
        },
        {
          "role": "兰纳迦",
          "text": "你好，金色的那菈和白飞飞。"
        },
        {
          "role": "兰纳迦",
          "text": "谢谢你们，虽然回不来了，以前的记忆…但可以信任的朋友，你们是的。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（兰迦鲁）"
        },
        {
          "role": "兰迦鲁",
          "text": "谢谢你们！那菈旅行者和白飞飞！"
        },
        {
          "role": "兰迦鲁",
          "text": "以后也要一起玩呀！"
        },
        {
          "type": "subtitle",
          "text": "观察"
        },
        {
          "role": "复生的花朵",
          "text": "（风干的花朵恢复了鲜活的神采，似乎老去的时光重又回返一般…）"
        }
      ],
