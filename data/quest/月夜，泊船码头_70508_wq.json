{
  "quest_id": 70508,
  "chapter_num": null,
  "chapter_title": "月夜，泊船码头",
  "type": "wq",
  "route": "Docked on a Moonlit Night",
  "stories": [
    {
      "story_id": 70508,
      "title": "月夜，泊船码头",
      "description": "「跟你说，今天我遇到了位好客人。仪态优雅，谈吐得当，出手还阔绰。」「你卖出去了什么？」「商业机密。」",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与北斗和凝光对话",
          "narration": true
        },
        {
          "role": "凝光",
          "text": "能在这里见到你，真叫人高兴。"
        },
        {
          "role": "旅行者",
          "text": "两位怎么会来这里？"
        },
        {
          "role": "派蒙",
          "text": "等等，你们俩该不会是结伴来的吧？"
        },
        {
          "role": "北斗",
          "text": "这位大人心血来潮说要好好休个假，就决定来这一带旅游了。"
        },
        {
          "role": "北斗",
          "text": "不过嘛，我俩对旅游的理解好像不太一样。山都没上几座，就到这里歇着了，真是富贵病啊。"
        },
        {
          "role": "凝光",
          "text": "这话说的，真叫人难过。我可是投你所好，特意挑了能喝酒的地方。"
        },
        {
          "role": "凝光",
          "text": "只可惜大船长见多识广，对这座小酒馆意见颇多呢。"
        },
        {
          "role": "北斗",
          "text": "好吧，这顿我请，行了吧？"
        },
        {
          "role": "派蒙",
          "text": "北斗要请客？那我们有份吗？"
        },
        {
          "role": "旅行者",
          "text": "派蒙，我们是酒保啦。"
        },
        {
          "role": "派蒙",
          "text": "对哦，习惯性蹭上了…"
        },
        {
          "role": "旅行者",
          "text": "两位贵客，喝点什么？"
        },
        {
          "role": "凝光",
          "text": "给我来一小杯桦树吧。最好能酸一些。"
        },
        {
          "role": "北斗",
          "text": "大杯的暮色，谢啦。"
        },
        {
          "role": "旅行者",
          "text": "明白了，请稍等片刻。"
        },
        {
          "type": "subtitle",
          "text": "为北斗和凝光调制饮品",
          "narration": true
        },
        {
          "role": "凝光",
          "text": "……"
        },
        {
          "role": "北斗",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "怎、怎么样？你们别不说话呀，我好紧张！"
        },
        {
          "role": "凝光",
          "text": "嗯…忆苦思甜的味道呢。"
        },
        {
          "role": "北斗",
          "text": "白手起家的味道？得是什么味儿啊。"
        },
        {
          "role": "凝光",
          "text": "呵呵…酸中带甜，余味很足。"
        },
        {
          "role": "北斗",
          "text": "唔…做小本生意却发现卖水果赚不到钱的味道？"
        },
        {
          "role": "凝光",
          "text": "何必说得那么明白呢。过去的事，就随它去吧。"
        },
        {
          "role": "北斗",
          "text": "哈哈，谁能想到高高在上的天权星也有沿街兜售水果的岁月啊。"
        },
        {
          "role": "北斗",
          "text": "就像我，看着也不像渔民出身对吧？"
        },
        {
          "role": "凝光",
          "text": "怎么会呢。要我说的话…"
        },
        {
          "role": "凝光",
          "text": "北斗船长这双一眼看透海水的眼睛，这副乘风破浪勇往直前的热心肠，向来是像极了依海而生的人。"
        },
        {
          "role": "北斗",
          "text": "喂喂，这话可不是损我的吧？"
        },
        {
          "role": "凝光",
          "text": "损你又没有什么好处。"
        },
        {
          "role": "北斗",
          "text": "知道你嘴巴厉害了。今天我请客，你给我点到为止。"
        },
        {
          "role": "凝光",
          "text": "嗯…那我想多喝几杯。"
        },
        {
          "role": "旅行者",
          "text": "是要续杯吗？"
        },
        {
          "role": "旅行者",
          "text": "竭诚为您服务！"
        },
        {
          "role": "派蒙",
          "text": "酒保，安排起来！"
        },
        {
          "role": "北斗",
          "text": "气势不错嘛！那我也再来一杯！"
        },
        {
          "role": "凝光",
          "text": "蒙德的果汁真不错，要是每天都能喝到该多好。"
        },
        {
          "role": "北斗",
          "text": "嗯？开玩笑吗？别告诉我你想开通日落果贸易专线…"
        },
        {
          "role": "凝光",
          "text": "听着有趣得很呢。"
        },
        {
          "role": "北斗",
          "text": "当真？"
        },
        {
          "role": "凝光",
          "text": "玩笑而已。相关贸易早就有一定规模了，不用我出手。"
        },
        {
          "role": "凝光",
          "text": "旅行者，今天多谢了。哪天你要是想找份闲差，不妨来我身边做专职酒保。"
        },
        {
          "role": "北斗",
          "text": "也可以来「死兆星」号上。我们大伙都爱喝酒，你要是过来，就能一起喝酒吃肉了，保证过瘾。"
        },
        {
          "role": "凝光",
          "text": "北斗船长这是在跟我竞争人才吗？你这又是何必，想喝旅行者亲自调制的饮品，来群玉阁上就行。"
        },
        {
          "role": "旅行者",
          "text": "（我真受欢迎！）"
        },
        {
          "role": "派蒙",
          "text": "她们好像偷偷把你卖了呢…"
        },
        {
          "role": "旅行者",
          "text": "有机会的话…"
        },
        {
          "role": "旅行者",
          "text": "一定都去，一定都去…"
        }
      ]
    }
  ]
}