{
  "quest_id": 24007,
  "chapter_num": null,
  "chapter_title": "他们的童年·某一篇章",
  "type": "iq",
  "route": "Their Childhood: A Certain Passage",
  "stories": [
    {
      "story_id": 24007,
      "title": "他们的童年·某一篇章",
      "description": "韦吕和洛薇似乎又在玩什么游戏，但奥雷勒却不见踪影…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与洛薇对话"
        },
        {
          "role": "韦吕",
          "text": "洛薇？你找到什么好东西了吗？"
        },
        {
          "role": "洛薇",
          "text": "没有呀，这里什么也没有！"
        },
        {
          "role": "旅行者",
          "text": "你们在做什么呢？"
        },
        {
          "role": "韦吕",
          "text": "大哥哥，我们正在「寻宝」呢，嘿嘿…你要不要和我们一起呀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "寻宝？",
              "dialogues": [
                {
                  "role": "洛薇",
                  "text": "别听韦吕吹牛啦，其实我们就是想在这里捞一些零件上来。"
                },
                {
                  "role": "韦吕",
                  "text": "这些零件就是宝物…咦？这里应该有啊…"
                }
              ]
            },
            {
              "text": "怎么没看见奥雷勒？",
              "dialogues": [
                {
                  "role": "韦吕",
                  "text": "哥哥去城里找德勒吕叔叔啦，他说有些问题想要请教。"
                },
                {
                  "role": "韦吕",
                  "text": "我们呢，就只能乖乖听话不乱跑…一直在这里「寻宝」啦。"
                },
                {
                  "role": "韦吕",
                  "text": "嘿嘿…大哥哥要不要和我们一起呀？"
                },
                {
                  "role": "洛薇",
                  "text": "别听韦吕吹牛啦，其实我们就是想在这里捞一些零件上来。"
                },
                {
                  "role": "韦吕",
                  "text": "这些零件就是宝物…咦？这里应该有啊…"
                }
              ]
            }
          ]
        },
        {
          "role": "洛薇",
          "text": "唔…看来这里是找不到了，我换个地方吧？"
        },
        {
          "role": "韦吕",
          "text": "行！我们再往前面走走。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我和你们一起去吧。",
              "dialogues": []
            },
            {
              "text": "可不要到处乱跑。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "韦吕",
          "text": "呜哇，大哥哥说话的语气好像哥哥…"
        },
        {
          "role": "韦吕",
          "text": "那我们再往前走走，我记得这附近的水里有很多零件的啊…"
        },
        {
          "type": "subtitle",
          "text": "寻找「宝物」"
        },
        {
          "role": "洛薇",
          "text": "只有一些烂纸板啊…没有零件。"
        },
        {
          "role": "韦吕",
          "text": "奇怪，我昨天才在这里捞出来了好几枚齿轮的。"
        },
        {
          "type": "subtitle",
          "text": "寻找「宝物」"
        },
        {
          "role": "韦吕",
          "text": "找到啦！这枚齿轮很完整，你看，还有一整根轴承呢。"
        },
        {
          "role": "洛薇",
          "text": "太好了，这些都能用上！"
        },
        {
          "type": "subtitle",
          "text": "寻找「宝物」"
        },
        {
          "role": "洛薇",
          "text": "这是…破衣服？都泡掉色了…"
        },
        {
          "role": "韦吕",
          "text": "这里难道被人捞过了吗？怎么什么零件都没有…"
        },
        {
          "type": "subtitle",
          "text": "与洛薇对话"
        },
        {
          "role": "洛薇",
          "text": "我看看…这枚齿轮可以用，这个轴承如果锯开的话…"
        },
        {
          "role": "旅行者",
          "text": "你找这个做什么？"
        },
        {
          "role": "洛薇",
          "text": "我想要自己做一个发条人偶。其实…我之前一直在悄悄地学习相关的知识啦。"
        },
        {
          "role": "洛薇",
          "text": "等我学好了，就要做一个大大的发条机关，给爸爸一个惊喜！"
        },
        {
          "role": "洛薇",
          "text": "我去爸爸房里看了好多书，也按照书上的方法做过一些简单的部件了。"
        },
        {
          "role": "洛薇",
          "text": "只要再加把劲，我一定能完成我想做的那个发条机关！"
        },
        {
          "role": "洛薇",
          "text": "但我可不能在城里研究发条和机械，否则马上就会被我爸爸发现，那样就给不了他惊喜了。"
        },
        {
          "role": "韦吕",
          "text": "所以，这里就成了洛薇研究发条机械的秘密基地啦，而我嘛…就是她的助手。"
        },
        {
          "role": "洛薇",
          "text": "多说无益，助手！开始研究吧！今天我们必须做出一个能动的机关胳膊！"
        },
        {
          "role": "韦吕",
          "text": "是！开始研究吧！"
        }
      ]
    }
  ]
}