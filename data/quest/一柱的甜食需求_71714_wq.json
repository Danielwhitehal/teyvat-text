      "story_id": 71714,
      "title": "一柱的甜食需求",
      "description": "璃月港的一柱需要一份杏仁豆腐。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将一份杏仁豆腐交给一柱"
        },
        {
          "role": "旅行者",
          "text": "关于杏仁豆腐…"
        },
        {
          "role": "一柱",
          "text": "你好，你是看到我的委托了吧。怎么样，你准备好一份杏仁豆腐了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": []
            },
            {
              "text": "还没有。",
              "dialogues": [
                {
                  "role": "一柱",
                  "text": "那你准备好了之后，就请快点拿给我吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与一柱对话"
        },
        {
          "role": "一柱",
          "text": "好的，这份杏仁豆腐我就收下了。"
        },
        {
          "role": "一柱",
          "text": "这些请你收下吧，谢谢你帮我的忙。"
        },
        {
          "role": "一柱",
          "text": "希望这份杏仁豆腐能让一弦的心情好一些…"
        }
      ]
    }
  ]
