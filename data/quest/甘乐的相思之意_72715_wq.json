  "stories": [
    {
      "story_id": 72715,
      "title": "甘乐的相思之意",
      "description": "鸣神岛的甘乐需要五束绯樱绣球。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将五束绯樱绣球交给甘乐"
        },
        {
          "role": "旅行者",
          "text": "关于绯樱绣球…"
        },
        {
          "role": "甘乐",
          "text": "你是看到了我的委托才来的吧，那五束绯樱绣球你是否准备好了呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": []
            },
            {
              "text": "还没有。",
              "dialogues": [
                {
                  "role": "甘乐",
                  "text": "那你准备好了之后，再拿给我吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与甘乐对话"
        },
        {
          "role": "甘乐",
          "text": "谢谢你。自从我的恋人去了遥远的战场…之后就音信全无。"
        },
        {
          "role": "甘乐",
          "text": "这些日子里，我每时每刻都在忧心，只有看到神樱花的时候，才会略感平静。"
        },
        {
          "role": "甘乐",
          "text": "毕竟，他走之前曾经指着神樱向我发誓，他会平安归来。"
        }
      ]
    }
  ]
}