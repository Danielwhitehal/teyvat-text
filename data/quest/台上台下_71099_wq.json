{
  "quest_id": 71099,
  "chapter_num": null,
  "chapter_title": "台上台下",
  "type": "wq",
  "route": "On the Stage, Behind the Stage",
  "stories": [
    {
      "story_id": 71099,
      "title": "台上台下",
      "description": "和裕茶馆的茶博士刘苏正在烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与刘苏对话"
        },
        {
          "role": "茶博士刘苏",
          "text": "嘿呀，晦气！不讲了，我今天绝对不讲了。"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "茶博士刘苏",
          "text": "这个小戏台子太气人，几十年了都没修过，台上的人稍微一动弹，它就要嘎吱嘎吱响。"
        },
        {
          "role": "茶博士刘苏",
          "text": "老早就跟我们东家范二爷说了这戏台得换新的，他总找借口说没有好木匠，不乐意换。"
        },
        {
          "role": "茶博士刘苏",
          "text": "今天我正在台上讲《海山履云记》呢，我这摆个架势它就要嘎吱一声。"
        },
        {
          "role": "茶博士刘苏",
          "text": "别提多破坏气氛了，台下观众都乐了，还有几个坏东西给我喝倒彩。"
        },
        {
          "role": "茶博士刘苏",
          "text": "我今天不忍了，一定得找个好木匠，直接带到二爷跟前，看他还有什么理由不换。"
        },
        {
          "role": "茶博士刘苏",
          "text": "我记得你是冒险家协会的对吧，我直接委托你也是一样的，你帮我找个木匠行不行？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么找？",
              "dialogues": []
            },
            {
              "text": "找哪个木匠？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "茶博士刘苏",
          "text": "也是，一看你就不是璃月人，你哪儿认识好木匠。"
        },
        {
          "role": "茶博士刘苏",
          "text": "这样吧，轻策庄「范木堂」路爷的手艺特别出名，请你代我问问他老人家愿不愿意来帮这个忙。"
        },
        {
          "role": "茶博士刘苏",
          "text": "要是他没有空，派个徒弟来也行。"
        },
        {
          "role": "茶博士刘苏",
          "text": "让范木堂的木匠给我们造戏台肯定是够了，要是造得好，以后云老板来登台我们也有面子。"
        },
        {
          "role": "茶博士刘苏",
          "text": "哎呀绝了，我这个理由想得可太好了，不由得二爷不答应哈哈。"
        },
        {
          "role": "茶博士刘苏",
          "text": "你放心，要是能把木匠带回来，酬金肯定不会拖欠你的。"
        },
        {
          "role": "旅行者",
          "text": "明白了。"
        },
        {
          "role": "茶博士刘苏",
          "text": "那就靠你了，我每天都在茶馆，有结果了回来找我就成。"
        },
        {
          "type": "subtitle",
          "text": "前往轻策庄寻找路爷"
        },
        {
          "role": "茶博士刘苏",
          "text": "二爷哟，再不上点儿心，生意都要被三碗不过港全抢啦。"
        },
        {
          "type": "subtitle",
          "text": "与路爷对话"
        },
        {
          "role": "路爷",
          "text": "这年轻人，风尘仆仆的，急什么，坐下来喝杯茶嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "路爷…",
              "dialogues": []
            },
            {
              "text": "有件事…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "向路爷解释了刘苏的委托…"
        },
        {
          "role": "路爷",
          "text": "哦哦，造新戏台不难，但找我是找错人喽。"
        },
        {
          "role": "路爷",
          "text": "轻策庄到璃月港那么远呢，我去璃月港了谁来照看「范木堂」呀？"
        },
        {
          "role": "路爷",
          "text": "更何况我这老胳膊老腿，哪儿走得动那么远的路，年纪大啦，经不起折腾。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那不麻烦范木堂了。",
              "dialogues": []
            },
            {
              "text": "佣金只能给别人了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "路爷",
          "text": "哎别急啊，你都大老远来一趟了，我给你推荐个能干又利索的人吧。"
        },
        {
          "role": "路爷",
          "text": "他虽然还不是我的徒弟，但我有心…"
        },
        {
          "role": "大雨",
          "text": "路爷，村长要的椅子一套四只，除了最后一只木头不够，其他我都打好了。"
        },
        {
          "role": "若心",
          "text": "辛苦大雨帮村子里干活了。"
        },
        {
          "role": "路爷",
          "text": "正好，说到他他就到。我刚才是想说，你找大雨也是一样的。"
        },
        {
          "role": "大雨",
          "text": "找我？路爷还没收我当徒弟呢，我可不能代表范木堂。"
        },
        {
          "role": "路爷",
          "text": "就你话多，人家是代璃月港的和裕茶馆来的，要请我们上门去造个新戏台。"
        },
        {
          "role": "大雨",
          "text": "哦，请「我们」去造戏台？我跟路爷合起来算是「我们」，村长奶奶您听见了吧？"
        },
        {
          "role": "若心",
          "text": "听见了，呵呵老路啊，大雨这孩子放着别的木匠师傅不跟，跑到范木堂跟着你学。"
        },
        {
          "role": "若心",
          "text": "他做事又快又好心还诚，你也差不多得了，收了人家当徒弟吧。"
        },
        {
          "role": "路爷",
          "text": "知道了知道了，我都让他代我上门给人家干活了，我这什么意思你们还不明白吗？"
        },
        {
          "role": "大雨",
          "text": "谢谢师父！"
        },
        {
          "role": "路爷",
          "text": "大雨，师父给你派的第一件活就是给和裕茶馆造戏台，好好干，不要丢了我的脸。"
        },
        {
          "role": "大雨",
          "text": "小意思，在群玉阁上建戏台的木匠我给他打过下手。"
        },
        {
          "role": "路爷",
          "text": "少吹点牛吧，和裕茶馆的老戏台用了几十年都没换，你这次去也得给人家造一个结实的。"
        },
        {
          "role": "若心",
          "text": "哦，闹了半天原来是范二哥要换戏台，他怎么拖到今天还在用那个小戏台…"
        },
        {
          "role": "大雨",
          "text": "行，我把手上这最后一把椅子打完就出发。"
        },
        {
          "role": "大雨",
          "text": "这位小哥，不好意思你还要等等。"
        },
        {
          "role": "大雨",
          "text": "这最后一把椅子还缺三根松木，我去砍点松木。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还要等等？",
              "dialogues": []
            },
            {
              "text": "等不了了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "大雨",
          "text": "那要不然您原地掏三根松木出来也行。"
        },
        {
          "role": "旅行者",
          "text": "明白了…"
        },
        {
          "role": "大雨",
          "text": "真掏啊？那要不然您受点累，再给一份红染料吧。"
        },
        {
          "role": "旅行者",
          "text": "你等着！"
        },
        {
          "role": "大雨",
          "text": "嘿嘿，您大人有大量，别跟我计较。"
        },
        {
          "type": "subtitle",
          "text": "收集家具材料"
        },
        {
          "role": "若心",
          "text": "范二哥真是的，怎么拖到今天才想起来造新戏台啊…"
        },
        {
          "role": "若心",
          "text": "他年轻时候就抠门，到老了这毛病是越来越严重了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许不是因为抠门。",
              "dialogues": []
            },
            {
              "text": "或许不只是因为抠门。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "若心",
          "text": "哎呀我还不知道他啊，二哥都多大年纪了，还跟自己过不去…"
        },
        {
          "role": "若心",
          "text": "算了不提了，待会儿云家的小姑娘要来做客，我过会儿得回去收拾收拾。"
        },
        {
          "type": "subtitle",
          "text": "与大雨对话"
        },
        {
          "role": "大雨",
          "text": "您受累，三根松木和一份红染料有了没？"
        },
        {
          "role": "大雨",
          "text": "您瞧好吧。"
        },
        {
          "role": "？？？",
          "text": "大雨忙活了一阵。"
        },
        {
          "role": "大雨",
          "text": "最后一把椅子也打好了，村长奶奶拿好，这下我该去和裕茶馆干活啦。"
        },
        {
          "role": "大雨",
          "text": "师父您等着啊，我大概几天就回了。"
        },
        {
          "role": "路爷",
          "text": "嗯，去吧去吧。"
        },
        {
          "role": "大雨",
          "text": "成，那我现在出发，差不多明天晚上就能赶到了。"
        },
        {
          "role": "大雨",
          "text": "我们和裕茶馆见。"
        },
        {
          "type": "subtitle",
          "text": "等到第二天（18:00~21:00）"
        },
        {
          "type": "subtitle",
          "text": "前往和裕茶馆"
        },
        {
          "role": "大雨",
          "text": "怎么意思？闹了半天，你们没商量好啊？"
        },
        {
          "role": "大雨",
          "text": "哦我懂了，刘苏刘先生想造新戏台，但他说话不算数，得听范二爷的，范二爷又不想造，得。"
        },
        {
          "role": "大雨",
          "text": "你俩商量好了再给我个准话吧，我也赶了老久的路，先到边上候着去了。"
        },
        {
          "role": "大雨",
          "text": "唉，这叫什么事儿啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以我白跑了？",
              "dialogues": []
            },
            {
              "text": "说好的酬金呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "茶博士刘苏",
          "text": "别急别急，我再说说。"
        },
        {
          "role": "茶博士刘苏",
          "text": "二爷啊，我们今天要是心疼造戏台这点小钱，以后就要亏大钱了。"
        },
        {
          "role": "茶博士刘苏",
          "text": "你想啊，每次云老板在我们这儿登台，人家耍花枪那么一亮相，还没等观众叫好，戏台子先响起来了。"
        },
        {
          "role": "茶博士刘苏",
          "text": "你说尴尬不尴尬？本来云翰社就是挂靠在我们这儿，到时候人家一不高兴去了别处，我们就亏大了。"
        },
        {
          "role": "范二爷",
          "text": "凭云老板跟我的交情，她是不会这么干的。"
        },
        {
          "role": "茶博士刘苏",
          "text": "您还以为我们高枕无忧呢？我可听说最近大家都爱去三碗不过港，不爱上我们这儿来。"
        },
        {
          "role": "茶博士刘苏",
          "text": "那田铁嘴名头都比我大了，您倒是有点忧患意识啊。"
        },
        {
          "role": "茶博士刘苏",
          "text": "云老板给茶馆挣了这么多钱，我们造个戏台这点钱出不起？"
        },
        {
          "role": "云堇",
          "text": "谁叫我呀？哦，是刘苏先生，今天是怎么了，生这么大气？"
        },
        {
          "role": "茶博士刘苏",
          "text": "没有没有，说不上生气。云老板今天过来，是安排了戏吗？"
        },
        {
          "role": "云堇",
          "text": "倒不是，只是想来茶馆喝喝茶，顺便来看望看望二爷和刘苏先生。"
        },
        {
          "role": "云堇",
          "text": "啊，巧得很，原来旅行者也来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没想到你来了…",
              "dialogues": [
                {
                  "role": "云堇",
                  "text": "有缘自然能相会，我可不觉得意外呢。"
                }
              ]
            },
            {
              "text": "刚刚想到云堇…",
              "dialogues": [
                {
                  "role": "云堇",
                  "text": "你真是的，就爱开玩笑。"
                }
              ]
            }
          ]
        },
        {
          "role": "范二爷",
          "text": "哈哈哈，还是云老板说话中听，来来来，我托人从翘英庄捎了新茶，我们泡它一壶。"
        },
        {
          "role": "云堇",
          "text": "二爷，我刚在楼下听到茶馆的戏台要修了，您终于肯动这个老物件了啊。"
        },
        {
          "role": "范二爷",
          "text": "咳咳…这个不着急，我还要从长计议…"
        },
        {
          "role": "云堇",
          "text": "哦？从长计议…"
        },
        {
          "role": "云堇",
          "text": "说起来，您知道我去轻策庄，是在哪家吃的饭吗？"
        },
        {
          "role": "范二爷",
          "text": "别卖关子了，你又去看若心了吧。"
        },
        {
          "role": "云堇",
          "text": "您一猜就准！若心前辈还问起今天的和裕茶馆什么样呢，我说一切都跟她年轻时一样，然后她说…"
        },
        {
          "role": "范二爷",
          "text": "她说什么？"
        },
        {
          "role": "云堇",
          "text": "哎呀我忘了。"
        },
        {
          "role": "范二爷",
          "text": "你这个云丫头，平时记性挺好，怎么今天这么重要的事还能忘了。"
        },
        {
          "role": "范二爷",
          "text": "算了，一切保持原样，她也会开心的吧。"
        },
        {
          "role": "范二爷",
          "text": "你们年轻人就喜欢新东西，一点不念旧，说多了你们也不懂，就知道催我，哼。"
        },
        {
          "role": "云堇",
          "text": "别生气嘛二爷，先喝茶先喝茶，我来给大家泡。旅行者和刘苏先生来帮我取点茶叶吧。"
        },
        {
          "type": "subtitle",
          "text": "与云堇一同去「泡茶」"
        },
        {
          "role": "茶博士刘苏",
          "text": "云先生，我还在想二爷怎么就不愿意造戏台呢，明明是百利无一害的事。"
        },
        {
          "role": "茶博士刘苏",
          "text": "你一试探我才明白，还是你聪慧。"
        },
        {
          "role": "茶博士刘苏",
          "text": "二爷念旧我是能明白，就是没想到，这都几十年了，他还惦记着以前的事。"
        },
        {
          "role": "云堇",
          "text": "这下就都明白了。"
        },
        {
          "role": "旅行者",
          "text": "我没明白。"
        },
        {
          "role": "云堇",
          "text": "这是以前的旧事，既然你也被卷进来了，那告诉你也无妨。"
        },
        {
          "role": "云堇",
          "text": "范二爷年轻的时候也能唱，和若心前辈常年搭戏，他们两个总在台上扮一对，大概二爷心里当了真吧。"
        },
        {
          "role": "云堇",
          "text": "不过，若心前辈其实另有心上人，后来她逐渐厌倦了舞台生活，就和她那位一道去了轻策庄。"
        },
        {
          "role": "云堇",
          "text": "不知道中间出了什么变故，那位没能和若心前辈在轻策庄团聚，她就孤身留在了那里，直到现在。"
        },
        {
          "role": "云堇",
          "text": "二爷知道我常去轻策庄看望若心前辈，总跟我打听她的近况。"
        },
        {
          "role": "云堇",
          "text": "可见他还是念着若心前辈，不愿意造新戏台也是想给过去留个念想。"
        },
        {
          "role": "茶博士刘苏",
          "text": "唉，既然这个戏台对二爷这么重要，那新戏台肯定是修不了了，木匠也白请了…"
        },
        {
          "role": "云堇",
          "text": "这也未必，我有办法，刘苏先生等着看吧。"
        },
        {
          "role": "茶博士刘苏",
          "text": "你当真有好办法？只要能修成，我事后一定好好谢谢云老板。"
        },
        {
          "role": "云堇",
          "text": "多了我也不需要，刘苏先生单给我讲一场《裁雨声》吧，这回我想听完，旅行者也可以一起。"
        },
        {
          "role": "旅行者",
          "text": "感觉云堇和平时不太一样。"
        },
        {
          "role": "茶博士刘苏",
          "text": "我们茶馆和云翰社的交情多厚哪，云老板跟我们当然比跟别人亲近。"
        },
        {
          "role": "茶博士刘苏",
          "text": "您放心，以后一定单独给你们开一场。"
        },
        {
          "role": "云堇",
          "text": "好了，我们「茶」也喝完了，该去跟二爷说道说道了。"
        },
        {
          "type": "subtitle",
          "text": "与范二爷对话"
        },
        {
          "role": "云堇",
          "text": "二爷，我们刚刚正喝着茶，我突然想起来若心前辈跟我说什么了。"
        },
        {
          "role": "范二爷",
          "text": "哦，她说什么呀？"
        },
        {
          "role": "云堇",
          "text": "她说：「二哥总爱跟自己过不去，听着让人难过。」"
        },
        {
          "role": "范二爷",
          "text": "唉，还是她明白我。"
        },
        {
          "role": "范二爷",
          "text": "不过，她好像也不怎么怀念这个旧物件啊，只有我还在自己跟自己较劲。"
        },
        {
          "role": "范二爷",
          "text": "我坚持不让别人动这个戏台不是自讨没趣吗？算了算了，你们修吧。"
        },
        {
          "role": "云堇",
          "text": "二爷这是有情有义，怎么能说是自讨没趣呢？您这么说我可不爱听。"
        },
        {
          "role": "云堇",
          "text": "戏台还是要修的，但也不能破坏了二爷的念想。"
        },
        {
          "role": "大雨",
          "text": "你们终于肯动工了啊？好，我这就安排。"
        },
        {
          "role": "大雨",
          "text": "我准备的图纸你们可以看看，群玉阁上那座大戏台就是照着这份图纸打造的。"
        },
        {
          "role": "大雨",
          "text": "按照这个设计，这两边的墙都要打掉哈，还有…"
        },
        {
          "role": "云堇",
          "text": "不着急，这个戏台我想还是得修旧如旧，既然是木地板响动影响演出，那就先修修地板。"
        },
        {
          "role": "云堇",
          "text": "其余的往后再说，刘苏先生，这样可以吗？"
        },
        {
          "role": "茶博士刘苏",
          "text": "只要这戏台修完了不再影响平时演出，具体怎么修都听云老板和二爷安排。"
        },
        {
          "role": "大雨",
          "text": "啊，就这样？不造新戏台了？"
        },
        {
          "role": "范二爷",
          "text": "我看这样好，还是云老板的主意妙。"
        },
        {
          "role": "范二爷",
          "text": "正巧修戏台用的木板也不用额外采购，码头上就有现成的。"
        },
        {
          "role": "范二爷",
          "text": "这位…旅行者还得麻烦你走一遭，这次跑腿的酬金稍后一起给你结算好了。"
        },
        {
          "role": "旅行者",
          "text": "可以。"
        },
        {
          "role": "大雨",
          "text": "…好吧，一起交给我好了。"
        },
        {
          "type": "subtitle",
          "text": "前往码头仓库获取木板"
        },
        {
          "type": "subtitle",
          "text": "将木板交给大雨"
        },
        {
          "role": "大雨",
          "text": "行吧，这几块木板应该够用了，我这就开工。"
        },
        {
          "role": "范二爷",
          "text": "不错不错，果然修旧如旧。"
        },
        {
          "role": "旅行者",
          "text": "什么都没变啊…"
        },
        {
          "role": "范二爷",
          "text": "这位年轻师傅，麻烦你从轻策庄走了这么远的路，工钱方面，你出个价吧。"
        },
        {
          "role": "大雨",
          "text": "我还以为接了个大活，结果只要修补几块木板，那就简单了。"
        },
        {
          "role": "大雨",
          "text": "我是个新人，也不跟你多要，两顿饭钱就差不多了，你给八千吧。"
        },
        {
          "role": "范二爷",
          "text": "这个价格真是公道，很好很好，不过我只能出两千。"
        },
        {
          "role": "大雨",
          "text": "什么？你不如直接叫我打白工算了。"
        },
        {
          "role": "茶博士刘苏",
          "text": "我们二爷是这样的，砍价讲究一个对截拦腰砍。"
        },
        {
          "role": "茶博士刘苏",
          "text": "每逢讲价都是先砍一半，再削一半，比较…嗯…「精打细算」。"
        },
        {
          "role": "大雨",
          "text": "好家伙，你这个老板真够抠门的。"
        },
        {
          "role": "范二爷",
          "text": "就补了几块木板嘛，两千两千，多一摩拉我也给不出了。"
        },
        {
          "role": "大雨",
          "text": "算了，这也是我第一件委托，这个哑巴亏我吃了，回头老板你给多宣传宣传我们范木堂啊。"
        },
        {
          "role": "范二爷",
          "text": "当然当然，那是一定。"
        },
        {
          "role": "范二爷",
          "text": "这位年轻朋友，你也辛苦了，酬金我不会亏你的。"
        },
        {
          "role": "范二爷",
          "text": "你觉得这份图纸怎么样，我看画得很仔细啊，应该值不少钱。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": [
                {
                  "role": "旅行者",
                  "text": "……"
                }
              ]
            },
            {
              "text": "真抠门。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "范二爷",
          "text": "啊哈哈，不精打细算怎么做生意呢？"
        },
        {
          "role": "范二爷",
          "text": "还有云老板，你一上门就帮我解决了一个小麻烦，我该怎么谢你呢？"
        },
        {
          "role": "云堇",
          "text": "二爷说笑了，这有什么谢不谢的。"
        },
        {
          "role": "云堇",
          "text": "我今天到茶馆来，本来是想看看您家「星燕」姑娘，请她陪我一起去看摇滚演出。"
        },
        {
          "role": "范二爷",
          "text": "哦哦，这个云丫头，又想听那个什么摇滚演出了啊？来跟我串供了是吧，呵呵。"
        },
        {
          "role": "云堇",
          "text": "这怎么是串供呢，我只是好久没见「星燕」了，很想念她这个好朋友。"
        },
        {
          "role": "云堇",
          "text": "要是我们戏社的人问起来，您知道…"
        },
        {
          "role": "范二爷",
          "text": "我知道了，「你问云老板啊？云老板来找我家『星燕』一起绣了半天的花。」"
        },
        {
          "role": "范二爷",
          "text": "我到时候就这么说，你满意不满意呀？"
        },
        {
          "role": "云堇",
          "text": "那就说定了。"
        }
      ]
    }
  ]
}