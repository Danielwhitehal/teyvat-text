{
  "quest_id": 10028,
  "chapter_num": "盛夏！海岛？大冒险！ 其二",
  "chapter_title": "夏日征程！千万要注意安全",
  "type": "eq",
  "route": "Summer Vacation: Proceed With Caution",
  "stories": [
    {
      "story_id": 40011,
      "title": "夏日征程！千万要注意安全",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "看似独立于一切地域之外的海岛，却藏有大量不为人知的机关和秘密。一行人暂时在此驻扎，开启了共同的临海夏日生活…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "◆回到营地"
        },
        {
          "type": "subtitle",
          "text": "◆休息至翌日上午（次日早8点-10点）"
        },
        {
          "type": "subtitle",
          "text": "◆聊聊有关岛屿的事"
        },
        {
          "role": "派蒙",
          "text": "唔…天气真好，我都睡迷糊了…"
        },
        {
          "role": "派蒙",
          "text": "早上好！哇，你们这身打扮是？！"
        },
        {
          "role": "芭芭拉",
          "text": "嘿嘿，好看吗？"
        },
        {
          "role": "芭芭拉",
          "text": "我们都换了夏装哦！虽然来这里并不是为了玩…无论如何都不想错过美丽的夏日海景呢。"
        },
        {
          "role": "琴",
          "text": "不、不会很奇怪吧？"
        },
        {
          "role": "琴",
          "text": "如此飘逸轻便的服装，肯定不适合我…咳！失礼了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有这种事。",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "是吗…谢谢你，旅行者。"
                }
              ]
            },
            {
              "text": "琴穿得非常好看！",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "是吗…谢谢你，旅行者。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不过琴团长会特意准备夏装，真叫人意外呀。"
        },
        {
          "role": "芭芭拉",
          "text": "不不，按照姐姐的性格才不会自己准备呢，是我和丽莎小姐为她选的哦。"
        },
        {
          "role": "派蒙",
          "text": "直接脱口而出「姐姐」了…而且自己完全没有注意到，芭芭拉已经沉醉于夏日了！"
        },
        {
          "role": "琴",
          "text": "夏装…真是说来话长啊。"
        },
        {
          "role": "琴",
          "text": "本以为丽莎给的口袋里是应急妙计，没想到，里面居然是一套夏装…"
        },
        {
          "role": "派蒙",
          "text": "连配饰都带齐了，该说不愧是丽莎吗？"
        },
        {
          "role": "琴",
          "text": "骑士团的各位无时无刻不想着让我休假…看来是我平时真的把自己逼得太紧了吗…"
        },
        {
          "role": "可莉",
          "text": "大家快来可莉这边！"
        },
        {
          "role": "琴",
          "text": "是可莉的声音！"
        },
        {
          "role": "可莉",
          "text": "有奇怪的东西——！"
        },
        {
          "role": "派蒙",
          "text": "怎么了？奇怪的东西是指什么？"
        },
        {
          "role": "可莉",
          "text": "有个奇怪的东西漂在上面哦。"
        },
        {
          "role": "琴",
          "text": "细长的装置，应该是浮标。"
        },
        {
          "role": "芭芭拉",
          "text": "可是，昨天在海上航行的时候，我们好像没有看到这个装置…"
        },
        {
          "role": "可莉",
          "text": "一定是嘟嘟大魔王放的！"
        },
        {
          "role": "派蒙",
          "text": "一夜之间冒出来的奇怪装置，不简单哦。"
        },
        {
          "role": "可莉",
          "text": "他一直没来找我，是不承认我吗…还是说…"
        },
        {
          "role": "可莉",
          "text": "他是不是在等我，要我去找他？"
        },
        {
          "role": "芭芭拉",
          "text": "突然出现在海上的浮标，会有什么用意吗？"
        },
        {
          "role": "旅行者",
          "text": "靠近看看就知道了。"
        },
        {
          "role": "派蒙",
          "text": "是啊，光在岸上猜测也解决不了问题。"
        },
        {
          "role": "芭芭拉",
          "text": "可以吗？"
        },
        {
          "role": "琴",
          "text": "还是主动确认一下比较好。"
        },
        {
          "role": "琴",
          "text": "很难说海上究竟有什么在等着我们…以防万一，希望大家做好战斗的准备。"
        },
        {
          "role": "琴",
          "text": "各自收拾妥当后，请到我这里集合，我们一起坐船过去。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不愧是大家的琴团长！",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "过、过奖了，这是我的职责所在。"
                }
              ]
            },
            {
              "text": "即使穿着夏装也很可靠。",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "过、过奖了，这是我的职责所在。"
                }
              ]
            }
          ]
        },
        {
          "role": "琴",
          "text": "那么，准备工作就拜托各位了。"
        },
        {
          "type": "subtitle",
          "text": "◆依次确认战备情况"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "琴",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "海面上的浮标到底意味着什么呢…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "关于群岛…",
                      "dialogues": [
                        {
                          "role": "琴",
                          "text": "我们来这里，既有信的指引，也有温迪和特瓦林的帮助…一切实在太过巧合，我有些担心。"
                        },
                        {
                          "role": "琴",
                          "text": "不过，我之所以会在这里，就是为了保护各位。所以请放心，不论发生什么事，我都会与你们一同面对。"
                        }
                      ]
                    },
                    {
                      "text": "关于夏装…",
                      "dialogues": [
                        {
                          "role": "琴",
                          "text": "啊…夏、夏装啊，那个是…是丽莎给我准备的惊喜。我猜，应该还有芭芭拉的建议。"
                        },
                        {
                          "role": "琴",
                          "text": "刚才芭芭拉也说，难得来海岛，一定要换上夏装才有气氛。"
                        },
                        {
                          "role": "琴",
                          "text": "可是，我不太习惯这样的装扮…唉，但愿这身打扮不会太过奇怪。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "芭芭拉",
              "dialogues": [
                {
                  "role": "芭芭拉",
                  "text": "唔…有什么是我能做的呢…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "关于群岛…",
                      "dialogues": [
                        {
                          "role": "芭芭拉",
                          "text": "我从刚才就想说了，这里的大海真美啊。"
                        },
                        {
                          "role": "芭芭拉",
                          "text": "大海与阳光…梦寐以求的夏天呢！"
                        },
                        {
                          "role": "芭芭拉",
                          "text": "真想面朝大海办一场演出啊，效果肯定不错。"
                        }
                      ]
                    },
                    {
                      "text": "关于夏装…",
                      "dialogues": [
                        {
                          "role": "芭芭拉",
                          "text": "怎么样？这件衣服…还不错吧？"
                        },
                        {
                          "role": "芭芭拉",
                          "text": "我特地选了跟海岛气氛比较搭的装扮，想给大家一个惊喜。"
                        },
                        {
                          "role": "芭芭拉",
                          "text": "啊，请别担心！就算穿着夏装，芭芭拉也是非常可靠的伙伴哦！"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "可莉",
              "dialogues": [
                {
                  "role": "可莉",
                  "text": "嗯，要带蹦蹦炸弹、嘟嘟可…还有我自己！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "关于浮标…",
                      "dialogues": [
                        {
                          "role": "可莉",
                          "text": "海上那些东西，肯定是嘟嘟大魔王放的！他是坏人哦！"
                        },
                        {
                          "role": "可莉",
                          "text": "不过，可莉会勇敢面对他，为了嘟嘟可，可莉会努力！"
                        },
                        {
                          "role": "可莉",
                          "text": "荣誉骑士姐姐，谢谢你帮可莉的忙。"
                        }
                      ]
                    },
                    {
                      "text": "关于夏天…",
                      "dialogues": [
                        {
                          "role": "可莉",
                          "text": "可莉喜欢夏天！但也不是只喜欢夏天…"
                        },
                        {
                          "role": "可莉",
                          "text": "可莉还喜欢秋天，啊对了，春天和冬天也喜欢！"
                        },
                        {
                          "role": "可莉",
                          "text": "虽然冬天很冷，但可莉有蹦蹦炸弹，觉得冷的话，用炸弹就好啦。"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆向琴汇报"
        },
        {
          "role": "琴",
          "text": "准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还没有。",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "不用着急，慢慢收拾就好。我会在这里等着你们的。"
                }
              ]
            },
            {
              "text": "准备好了。",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "那么，各位就请随我一同到海上去吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆调查神秘装置"
        },
        {
          "type": "subtitle",
          "text": "◆调查神秘装置"
        },
        {
          "type": "subtitle",
          "text": "◆调查神秘装置"
        },
        {
          "type": "subtitle",
          "text": "◆与众人讨论岛屿的变化"
        },
        {
          "role": "派蒙",
          "text": "怎么会有这种事，这片海域实在太神秘了！"
        },
        {
          "role": "芭芭拉",
          "text": "整片陆地都升了上来！"
        },
        {
          "role": "可莉",
          "text": "大魔王，大魔王，哇咿！我来抓你啦，嘎——！"
        },
        {
          "role": "派蒙",
          "text": "小可莉，永远这么有精神啊。"
        },
        {
          "role": "琴",
          "text": "地面震动之前，我有听到类似机关的声音。依我看，这片海面下有着非常巨大的机关。"
        },
        {
          "role": "琴",
          "text": "整片海岛位于机关构架出的底盘上，机关启动，将各个岛屿一并托出水面。"
        },
        {
          "role": "派蒙",
          "text": "应该不是吧？我总觉得这更像是某个人刻意的作为…"
        },
        {
          "role": "琴",
          "text": "怎么想都不可思议…用信件把我们引来这里，再以这样的机关挑战我们，所谓的嘟嘟大魔王绝非无能之辈。"
        },
        {
          "role": "旅行者",
          "text": "我也这么觉得。"
        },
        {
          "role": "芭芭拉",
          "text": "唉，假日的气氛一下就消失了…"
        },
        {
          "role": "琴",
          "text": "……"
        },
        {
          "role": "琴",
          "text": "总之，我会打起精神做好最高级别的警戒。"
        },
        {
          "role": "派蒙",
          "text": "琴团长，雷厉风行的时候真帅气呀！"
        },
        {
          "role": "旅行者",
          "text": "派蒙和我也会多加留心。"
        },
        {
          "role": "琴",
          "text": "感谢你们的理解。"
        },
        {
          "role": "可莉",
          "text": "找到了，大魔王！"
        },
        {
          "role": "可莉",
          "text": "就在那边的岛上，嘿嘿，抓到你了哦！"
        },
        {
          "role": "可莉",
          "text": "既然要可莉来找你，那可莉就来啦！蹦蹦炸弹，预备——！我们一起跑！"
        },
        {
          "role": "芭芭拉",
          "text": "那是…海中央的平台？"
        },
        {
          "role": "琴",
          "text": "确实有东西出现了。各位，可以靠近查看，但请务必保持警戒。"
        },
        {
          "type": "subtitle",
          "text": "◆前往中央平台"
        },
        {
          "type": "subtitle",
          "text": "◆探讨面前的「神秘人士」"
        },
        {
          "role": "琴",
          "text": "各位，请小心！"
        },
        {
          "role": "派蒙",
          "text": "那是…个子很高大的人吗？"
        },
        {
          "role": "芭芭拉",
          "text": "很像是人，又不太对劲？"
        },
        {
          "role": "可莉",
          "text": "嘟嘟大魔王，可莉来见你啦！你可以…呃…判、判…嗯？"
        },
        {
          "role": "派蒙",
          "text": "「审判」！"
        },
        {
          "role": "可莉",
          "text": "你可以「审判」可莉了！"
        },
        {
          "role": "派蒙",
          "text": "啊——！这孩子在说什么呀！"
        },
        {
          "role": "琴",
          "text": "她根本不明白那句话的意思吧…"
        },
        {
          "role": "可莉",
          "text": "喂，大魔王——！你怎么不理我呀？"
        },
        {
          "role": "可莉",
          "text": "是不是可莉来得太慢，惹你生气了？那…对不起嘛！"
        },
        {
          "role": "芭芭拉",
          "text": "向对方道歉了？可莉这孩子，思维有点跳跃吧…"
        },
        {
          "role": "可莉",
          "text": "大——魔——王——！"
        },
        {
          "role": "芭芭拉",
          "text": "看起来，对方没有要理睬可莉的意思呢。"
        },
        {
          "role": "琴",
          "text": "是人型的机械吧。没有反应，应该是已经损坏了。"
        },
        {
          "role": "芭芭拉",
          "text": "你认识那个吗？"
        },
        {
          "role": "琴",
          "text": "只是猜测。它跟海岛的整体气氛格格不入…看衣着，倒像是从稻妻漂流而来。"
        },
        {
          "role": "派蒙",
          "text": "稻妻？那不是很远的地方吗？"
        },
        {
          "role": "旅行者",
          "text": "它也是异乡人吗？"
        },
        {
          "role": "琴",
          "text": "但以稻妻眼下的情况，又怎么会发生这种事…"
        },
        {
          "role": "派蒙",
          "text": "没反应的异乡人…好神奇，是有人把它带来这里吗？"
        },
        {
          "role": "可莉",
          "text": "呜哇——大魔王不动了！"
        },
        {
          "role": "琴",
          "text": "可莉…也许大魔王只是累了。"
        },
        {
          "role": "派蒙",
          "text": "对对，大魔王应该是睡着了吧？等你等得不耐烦，就呼——地睡过去了！"
        },
        {
          "role": "芭芭拉",
          "text": "嗯，我们陪可莉去别处玩，等大魔王睡醒再来找他。"
        },
        {
          "role": "可莉",
          "text": "…真的…？"
        },
        {
          "role": "芭芭拉",
          "text": "当然啦，你要相信我们。"
        },
        {
          "role": "可莉",
          "text": "唔…不对，可莉想到了！"
        },
        {
          "role": "可莉",
          "text": "这个不是大魔王，真正的大魔王还在别的地方。"
        },
        {
          "role": "琴",
          "text": "欸？是、是吗？"
        },
        {
          "role": "可莉",
          "text": "可莉不会放弃，大魔王，等着吧，我们来找你！"
        },
        {
          "role": "派蒙",
          "text": "又跑掉了…小孩子的精神真好呢。"
        },
        {
          "role": "芭芭拉",
          "text": "可莉，等等我们！"
        },
        {
          "type": "subtitle",
          "text": "◆探查周围环境"
        },
        {
          "type": "subtitle",
          "text": "◆听听大家的看法"
        },
        {
          "role": "芭芭拉",
          "text": "荣誉骑士，请看这里！"
        },
        {
          "role": "派蒙",
          "text": "唔…？这是什么…"
        },
        {
          "role": "芭芭拉",
          "text": "叠放的石块和小小的花朵…"
        },
        {
          "role": "芭芭拉",
          "text": "这种感觉，好像是在纪念某个人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好敏锐的感知力。",
              "dialogues": [
                {
                  "role": "芭芭拉",
                  "text": "说得我都不好意思了…"
                }
              ]
            },
            {
              "text": "不愧是祈礼牧师。",
              "dialogues": [
                {
                  "role": "芭芭拉",
                  "text": "说得我都不好意思了…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "可这附近只有那个没反应的稻妻机械而已呀。"
        },
        {
          "role": "芭芭拉",
          "text": "难道是在纪念它？"
        },
        {
          "role": "琴",
          "text": "或许，它也曾做出过值得他人纪念的事。"
        },
        {
          "role": "芭芭拉",
          "text": "……"
        },
        {
          "role": "琴",
          "text": "我们所见到的这些布设，足以证明这片海域中有人类存在过。可光凭这些，无法推导究竟是怎样的人类文明。"
        },
        {
          "role": "琴",
          "text": "迄今为止我们也没有见到任何人类或是人类的墓冢…"
        },
        {
          "role": "可莉",
          "text": "琴团长，可莉去那边看看可以吗？"
        },
        {
          "role": "琴",
          "text": "可以，务必注意安全。"
        },
        {
          "role": "可莉",
          "text": "嗯！"
        },
        {
          "role": "旅行者",
          "text": "这片海岛上究竟有多少秘密？"
        },
        {
          "role": "琴",
          "text": "可莉还小，比较缺乏危机感，但旅行者，我希望我们都能清醒地了解现状。"
        },
        {
          "role": "琴",
          "text": "坦白说，一开始我以为那封信只是恶作剧。"
        },
        {
          "role": "派蒙",
          "text": "我们也这么想。"
        },
        {
          "role": "芭芭拉",
          "text": "我也是，可会是谁给这样的小孩子寄恶作剧信件呢？"
        },
        {
          "role": "琴",
          "text": "知道这座岛屿的人本就是少数，引导我们解开机关更是布局巧妙…"
        },
        {
          "role": "琴",
          "text": "说不定，这些不是恶作剧而是谋划已久的陷阱。我们绝对不能掉以轻心。"
        },
        {
          "role": "芭芭拉",
          "text": "可莉，怎么了？"
        },
        {
          "role": "可莉",
          "text": "你说…大魔王会不会不想见可莉？"
        },
        {
          "role": "芭芭拉",
          "text": "为什么呢？"
        },
        {
          "role": "可莉",
          "text": "因为嘟嘟可喜欢可莉，可莉也喜欢嘟嘟可，大魔王没法把我们分开，就只能不见我们…"
        },
        {
          "role": "可莉",
          "text": "呜…可莉很怕他把我们分开。"
        },
        {
          "role": "芭芭拉",
          "text": "……"
        },
        {
          "role": "芭芭拉",
          "text": "可莉看，这是什么？"
        },
        {
          "role": "可莉",
          "text": "是羽球！"
        },
        {
          "role": "芭芭拉",
          "text": "我听姐…咳！听琴团长说过，可莉一直想玩羽球对不对？"
        },
        {
          "role": "可莉",
          "text": "对，可莉想过羽球节！"
        },
        {
          "role": "芭芭拉",
          "text": "这是我为可莉做的特制羽球，只要可莉想玩，天天都是羽球节，好不好？"
        },
        {
          "role": "可莉",
          "text": "好——！"
        },
        {
          "role": "旅行者",
          "text": "感受到祈礼牧师的温柔了…"
        },
        {
          "role": "芭芭拉",
          "text": "所以可莉，打起精神来。见到大魔王以后，我们大家都会帮你说服他，让他允许你和嘟嘟可在一起。"
        },
        {
          "role": "可莉",
          "text": "嗯！"
        },
        {
          "role": "旅行者",
          "text": "大家一起加油找到他。"
        },
        {
          "role": "可莉",
          "text": "好！"
        },
        {
          "role": "派蒙",
          "text": "交给我们吧，一定会帮可莉找到那个家伙的。"
        },
        {
          "role": "派蒙",
          "text": "就算不知道什么时候才能找到、不知道在哪里才能找到…也、也总会找到的吧，嗯！"
        },
        {
          "role": "派蒙",
          "text": "在那之前，就先到附近尽情搜索吧！"
        }
      ]
    }
  ]
}