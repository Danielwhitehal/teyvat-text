{
  "quest_id": 72670,
  "chapter_num": null,
  "chapter_title": "我，游学者",
  "type": "wq",
  "route": "I, Researcher",
  "stories": [
    {
      "story_id": 72670,
      "title": "我，游学者",
      "description": "在学者胡塞尼从稻妻返回须弥的途中，你们再次相遇了…",
      "dialogues": [
         {
          "type": "subtitle",
          "text": "与胡塞尼对话"
        },
        {
          "role": "胡塞尼",
          "text": "咳，咳咳…"
        },
        {
          "role": "旅行者",
          "text": "你好。"
        },
        {
          "role": "胡塞尼",
          "text": "你好你好，终于等到一个看起来合适的人了，咳咳。"
        },
        {
          "role": "胡塞尼",
          "text": "而且还是熟人，这下我不用担心样本不够了嘿嘿。"
        },
        {
          "role": "胡塞尼",
          "text": "等了这半天，不是老年人就是小孩子，完全不够用…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是？",
              "dialogues": [
                {
          "role": "胡塞尼",
          "text": "啊，这么快就把我忘了吗？"
        },
        {
          "role": "胡塞尼",
          "text": "我又不是什么图谋不轨的恶人，不用这样假装不认识我吧。"
        }
              ]
            },
            {
              "text": "…你打算做什么！",
              "dialogues": [
                {
          "role": "胡塞尼",
          "text": "我看起来像是那种绑架路人做实验的疯狂学者吗？别用这种防贼一样的口气嘛。"
        }
              ]
            }
          ]
        },
        
        {
          "role": "胡塞尼",
          "text": "你仔细看看，是我啊，我们在稻妻的离岛还见过面的，咳咳。"
        },
        {
          "role": "旅行者",
          "text": "真的很可疑。"
        },
        {
          "role": "胡塞尼",
          "text": "看起来你真是忘记我了，唉，那就来自我介绍一次吧。"
        },
        {
          "role": "胡塞尼",
          "text": "我是须弥「教令院」的学者胡塞尼，为了在稻妻开展调研项目，一路跋涉好不容易抵达稻妻。"
        },
        {
          "role": "胡塞尼",
          "text": "可惜…咳…要在稻妻开展调研实在限制太多。"
        },
        {
          "role": "胡塞尼",
          "text": "虽然我最终也不是一无所获，但是跟这一路的颠簸坎坷比起来，总有点得不偿失。"
        },
        {
          "role": "胡塞尼",
          "text": "研究经费已经所剩无几了，我只能取道璃月回「教令院」，不过我还是希望利用回程的时间做点补救…"
        },
        {
          "role": "胡塞尼",
          "text": "我想，不如继续在曾经获得「教令院」肯定的「导能原盘」项目上下功夫。"
        },
        {
          "role": "胡塞尼",
          "text": "至于「导能原盘」，不知道你记不记得。"
        },
        {
          "role": "胡塞尼",
          "text": "那是一件珍贵的古代遗物，能够借助无所不在的地脉，增强使用者的力量。"
        },
        {
          "role": "胡塞尼",
          "text": "咳咳，这个研究项目仍在初期阶段，我之前上交的调查报告也只相当于完整研究的绪论部分。"
        },
        {
          "role": "胡塞尼",
          "text": "要弄明白整个「导能原盘」的运作原理与应用可能性，还有许多工作要做。"
        },
        {
          "role": "胡塞尼",
          "text": "所以我正在这里征召志愿者，邀请他们使用「导能原盘」，以获得更多的新数据，支撑我的研究。"
        },
        {
          "role": "胡塞尼",
          "text": "我…咳…可不是什么可疑分子，你别误会了。"
        },
        {
          "role": "旅行者",
          "text": "原来如此。"
        },
        {
          "role": "胡塞尼",
          "text": "没错…咳…那么我现在可以问了，旅行者，你愿不愿意成为志愿者，帮忙试用「导能原盘」呢？"
        },
        {
          "role": "旅行者",
          "text": "可以试试。"
        },
        {
          "role": "胡塞尼",
          "text": "请先允许我表达感谢，你一直乐于为追求智慧这项事业做出奉献。"
        },
        {
          "role": "胡塞尼",
          "text": "不过在我将「导能原盘」正式交你保管之前，还是让我们先来做一个小小的热身活动吧。"
        },
        {
          "role": "胡塞尼",
          "text": "这也是为了确认志愿者是否有能力自保…咳…毕竟，负责任的学术项目是不会拿志愿者的生命安全冒险的。"
        },
        {
          "role": "胡塞尼",
          "text": "如果你已经准备好了的话，就到指定的地点去，试着清理那里的营地吧。"
        },
        {
          "role": "胡塞尼",
          "text": "我会在这里等你回来，一定要注意安全。"
        },
         {
          "type": "subtitle",
          "text": "清理望舒客栈西三处营地"
        },
         {
          "type": "subtitle",
          "text": "向胡塞尼回报"
        },
        {
          "role": "胡塞尼",
          "text": "你们回来了？"
        },
        {
          "role": "旅行者",
          "text": "毫发无伤。"
        },
        {
          "role": "胡塞尼",
          "text": "哈哈…咳，是我多虑了，你的实力很强，我可以放心地把「导能原盘」交你保管了。"
        },
        {
          "role": "胡塞尼",
          "text": "「导能原盘」的使用方法简单易懂，你看到就明白了。"
        },
        {
          "role": "胡塞尼",
          "text": "不过使用时务必小心，这可是真正的古代遗物，如果弄丢了或者弄坏了，我就得倒大霉了。"
        },
        {
          "role": "胡塞尼",
          "text": "你可以先熟悉一下「导能原盘」，之后再尝试测试工作。"
        },
        {
          "role": "胡塞尼",
          "text": "怎么样，能理解「导能原盘」的使用方法吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
             {
              "text": "不算太复杂。",
              "dialogues": [
                {
          "role": "胡塞尼",
          "text": "的确，和「教令院」里的某些器械比起来，「导能原盘」算是比较易用了。"
                }
              ]
            },
            {
              "text": "有点不明白。",
              "dialogues": [
                {
          "role": "胡塞尼",
          "text": "这很正常。放心，作为非专业人士，你只需掌握基础操作就足够了。"
        }
              ]
            }
          ]
        },
        
        {
          "role": "胡塞尼",
          "text": "以你的水平，如果扩大测试规模，应该也没问题。"
        },
        {
          "role": "胡塞尼",
          "text": "我听路过的冒险家说，他们新发现了一处奇特的秘境。"
        },
        {
          "role": "胡塞尼",
          "text": "因为之前似乎没有人发现过这个地方，所以其中汇聚的魔物数量不少，能力也比野外游荡的魔物强。"
        },
        {
          "role": "胡塞尼",
          "text": "如果把那里当作测试场地的话，一定能获得更全面的数据。"
        },
        {
          "role": "胡塞尼",
          "text": "毕竟你之前的表现…咳…实话说很出色，「导能原盘」中留下的记录反而有限。"
        },
        {
          "role": "胡塞尼",
          "text": "是你的话，出入这种秘境大概不是难事吧。"
        },
        {
          "role": "旅行者",
          "text": "那还用说。"
        },
        {
          "role": "胡塞尼",
          "text": "要是别人这么说，我八成不信，但是你的话，我觉得肯定没问题哈哈…咳咳。"
        },
        {
          "role": "胡塞尼",
          "text": "那我来帮你把秘境地点标注在地图上吧，测试任务就拜托你了。"
        }
      ]
    }
  ]
}