{
  "quest_id": 10048,
  "chapter_num": "炽魂斗士的雪界之旅 其一",
  "chapter_title": "闪亮的斗士们登场",
  "type": "eq",
  "route": "The Shining Warriors Take the Stage",
  "stories": [
    {
      "story_id": 40217,
      "title": "闪亮的斗士们登场",
      "description": "白雪纷飞时，你们回到了龙脊雪山脚下…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "查看宣传单"
        },
        {
          "type": "subtitle",
          "text": "查看邀请函"
        },
        {
          "role": "[[文件",
          "text": "传说任务-闪亮的斗士们登场-宣传单.png|center|600px]]"
        },
        {
          "type": "subtitle",
          "text": "毅力！勇气！速度！龙脊雪山国际越野赛即将拉开帷幕！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "这是每一位跑者都向往的高难度赛事，这是证明自身能力的最佳场合。凭借毅力、勇气以及速度，沿龙脊雪山山道进行长距离越野跑，克服雪山的复杂地形以及寒冷天气， 证明自己, 跑出风采！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "龙脊雪山越野赛即将开跑，本届赛事有来自纳塔、须弥、稻妻、璃月以及蒙德的多支队伍参赛。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "我们邀请每一位有此自信的选手前来参加，也欢迎热情的观众来为选手加油喝彩。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "龙脊雪山国际越野赛组委会",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往龙脊雪山"
        },
        {
          "role": "派蒙",
          "text": "是比赛的宣传单啊。「龙脊雪山国际越野赛」…嗯，以前没有听说过呢。"
        },
        {
          "role": "派蒙",
          "text": "既然是国际赛事，应该会很热闹吧，有空的时候去雪山看看好了。"
        },
        {
          "type": "subtitle",
          "text": "与安柏对话"
        },
        {
          "role": "派蒙",
          "text": "好多帐篷啊，之前来雪山的时候，这里可没有这么热闹。"
        },
        {
          "role": "派蒙",
          "text": "欸！旅行者，快看，是安柏！"
        },
        {
          "role": "派蒙",
          "text": "你好呀，安柏。"
        },
        {
          "role": "安柏",
          "text": "啊，是荣誉骑士和派蒙，又见面啦！抱歉，刚才忙着说话，都没注意到你们来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好，安柏。",
              "dialogues": []
            },
            {
              "text": "在忙什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "我正和海因茨先生说比赛的事呢。对了，你们怎么到雪山来了，该不会还有委托要做吧？"
        },
        {
          "role": "派蒙",
          "text": "没有没有，我们收到了比赛的宣传单，有点好奇，就来看看啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "凑热闹我等不到明天。",
              "dialogues": []
            },
            {
              "text": "来看看有没有老朋友。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "那你们可找对人了！正巧，我和海因茨先生都是大赛组委会的工作人员。"
        },
        {
          "role": "海因茨",
          "text": "你好，荣誉骑士，这位想必就是派蒙了吧。"
        },
        {
          "role": "海因茨",
          "text": "我是骑士团第一小队的佐官海因茨，很荣幸见到你们。"
        },
        {
          "role": "海因茨",
          "text": "比赛还没有正式开始，现在正是发放观众票和嘉宾票的阶段。"
        },
        {
          "role": "海因茨",
          "text": "来，请两位收下，这是给你们预留的嘉宾票。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你们。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "两人",
          "text": "不客气。"
        },
        {
          "role": "派蒙",
          "text": "我记得传单上提到过一个「龙脊雪山国际越野赛组委会」，安柏说的组委会就是它吗？"
        },
        {
          "role": "安柏",
          "text": "没错，这届组委会由西风骑士团成员和清泉镇镇民代表共同组成。"
        },
        {
          "role": "安柏",
          "text": "具体来说，我和海因茨先生负责管理报名流程和赛场安全，清泉镇的各位负责裁判和后援管理。"
        },
        {
          "role": "安柏",
          "text": "要是遇到问题，尽管找我们！我们会保障所有参赛者和观众开心享受比赛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "安柏一如既往可靠。",
              "dialogues": []
            },
            {
              "text": "我们会来观赛的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海因茨",
          "text": "这届比赛的规模比以往都要大，来了不少外国选手，甚至还有纳塔人，肯定很精彩。"
        },
        {
          "role": "安柏",
          "text": "哦，我知道你想到谁了。"
        },
        {
          "role": "安柏",
          "text": "是那支队伍吧…其中一位成员的头发是粉色的，头上还有一对气派的白色大角。"
        },
        {
          "role": "安柏",
          "text": "她的胃口尤其惊人呢！有位工作人员跟我说，他们特别喜欢和这位朋友同桌吃饭。"
        },
        {
          "role": "安柏",
          "text": "哈哈，她吃起饭来特别香，看得别人都想多添一碗饭。"
        },
        {
          "role": "安柏",
          "text": "还有一位成员身上有一条黄黑斑纹的尾巴，一看就很好摸…"
        },
        {
          "role": "安柏",
          "text": "不过她的样子酷酷的，我没好意思提这个要求。"
        },
        {
          "role": "派蒙",
          "text": "这个描述…我怎么觉得是认识的人？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "像瓦雷莎和希诺宁。",
              "dialogues": []
            },
            {
              "text": "我们去打个招呼吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "噢噢，是熟人啊！"
        },
        {
          "role": "安柏",
          "text": "要去找她们的话，那支队伍的营地在那里，就是那个画着特别图案的帐篷。"
        },
        {
          "role": "安柏",
          "text": "她们的营地挺漂亮的，还放了不少漫画书。"
        },
        {
          "role": "派蒙",
          "text": "看到了看到了，我们一会儿就去瞧瞧，谢啦。"
        },
        {
          "role": "安柏",
          "text": "对了，如果方便的话，能帮我向她们借一本漫画书吗？"
        },
        {
          "role": "安柏",
          "text": "那支队伍里的选手总是在聊漫画，听得我特别好奇，但我有事要忙，又走不开。"
        },
        {
          "role": "派蒙",
          "text": "没问题，包在我们身上。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（海因茨）"
        },
        {
          "role": "海因茨",
          "text": "赛道还在布置阶段，要参观的话现在还不是时候。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（安柏）"
        },
        {
          "role": "安柏",
          "text": "比赛开始的那一天，记得来观赛哦。"
        },
        {
          "type": "subtitle",
          "text": "前去寻找熟人"
        },
        {
          "role": "派蒙",
          "text": "你好，请问瓦雷莎和希诺宁在这里吗？"
        },
        {
          "role": "？？？",
          "text": "哦，是找队长和副队长的。"
        },
        {
          "role": "爱拉尼",
          "text": "…旅行者？我还差点以为自己认错了，真的是你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "爱拉尼，你的论文怎么样了？",
              "dialogues": [
                {
                  "role": "爱拉尼",
                  "text": "拜托你不要一见面就说这么残忍的话，现在是难得的假期时间。"
                },
                {
                  "role": "爱拉尼",
                  "text": "再怎么为论文头疼，我也是血肉做的人，是会被反复折磨人的现实打倒的。"
                },
                {
                  "role": "爱拉尼",
                  "text": "我已经被论文打倒了，让我在地上躺一会儿再重新面对吧，在这里就不要提这事了，我求你。"
                }
              ]
            },
            {
              "text": "我们见过吗？",
              "dialogues": [
                {
                  "role": "爱拉尼",
                  "text": "不记得我吗…倒也正常，经历过那么多大事，人的记性早晚会麻木。"
                },
                {
                  "role": "爱拉尼",
                  "text": "我是爱拉尼，教令院诃般荼…下面一点点的帝利耶悉哈哈。"
                },
                {
                  "role": "爱拉尼",
                  "text": "不过只要我完成了毕业论文，早晚能成为诃般荼的！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哎呀，到处都是熟人，提瓦特真小。"
        },
        {
          "role": "派蒙",
          "text": "既然大家都认识瓦雷莎和希诺宁，那就好解释了。"
        },
        {
          "role": "派蒙",
          "text": "我们听说她们来雪山这里比赛了，就来打招呼了，嘿嘿。"
        },
        {
          "role": "爱拉尼",
          "text": "瓦雷莎和希诺宁现在不在，不介意的话，可以先在营地里等等看。"
        },
        {
          "role": "派蒙",
          "text": "好啊，你们的帐篷很有特色呢…喔，这里果然有好多漫画。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "安柏没说错。",
              "dialogues": []
            },
            {
              "text": "看来是漫画迷。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对了，有个朋友跟我们说，她听见你们聊漫画聊得热火朝天，觉得很有意思。"
        },
        {
          "role": "派蒙",
          "text": "不知道你们在聊的是什么漫画，能告诉我们吗？我也有点好奇。"
        },
        {
          "role": "爱拉尼",
          "text": "漫画？原来你们也对漫画感兴趣吗？呵呵，果然。"
        },
        {
          "role": "？？？",
          "text": "所谓「烈度」与「烈度」终会相互吸引，「最强」与「最强」定会相遇，就是这个意思吧。"
        },
        {
          "role": "爱拉尼",
          "text": "那么，既然你诚心诚意地问了…"
        },
        {
          "role": "汤义刚",
          "text": "我汤义刚就大发慈悲地告诉你。"
        },
        {
          "role": "汤义刚",
          "text": "这部漫画就是我们「炽魂斗士特战队」的圣典——《炽魂斗士战记》。"
        },
        {
          "role": "爱拉尼",
          "text": "你接下来会问，炽魂斗士是一群什么人？「炽魂斗士特战队」又是一个什么样的组织？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谁问了？",
              "dialogues": []
            },
            {
              "text": "不是，我没问。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱拉尼",
          "text": "义刚，告诉我，炽魂斗士的原则是什么！"
        },
        {
          "role": "汤义刚",
          "text": "「第一：认为用眼泪和劝诫足以维持和平的话，就太天真了！」"
        },
        {
          "role": "汤义刚",
          "text": "「第二：就算耗尽了生命，永恒的黑暗也不会为我俯首，但我依然坚持战斗！」"
        },
        {
          "role": "爱拉尼",
          "text": "我们「特战队」誓死追随炽魂斗士，我们的宣言是——"
        },
        {
          "role": "汤义刚",
          "text": "绝不畏惧失败与痛苦，永远守护爱与想象！"
        },
        {
          "role": "爱拉尼",
          "text": "顺带一提，刚才说到的两条炽魂斗士原则，出自《炽魂斗士战记》第六册·暗域魔影篇。"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱拉尼",
          "text": "怎…怎么一点反应都没有？你们难道不觉得，自己内心深处的热情被点燃了那么一瞬？"
        },
        {
          "role": "派蒙",
          "text": "说实话，没有。你的解释有点抽象，我没听懂。"
        },
        {
          "role": "汤义刚",
          "text": "这是何等的挫败。"
        },
        {
          "role": "希诺宁",
          "text": "别再点燃「热情」了，燃烧过头的话，你们一个个都要化成灰了。"
        },
        {
          "role": "爱拉尼",
          "text": "太好了，副队长回来了。你听我说…"
        },
        {
          "role": "希诺宁",
          "text": "好了，我看旅行者和派蒙的表情，就知道是什么情况了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谁给我解释一下。",
              "dialogues": []
            },
            {
              "text": "（疑惑地挠头）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "刚才爱拉尼和汤义刚，一定是对你说了一些…不太好理解的话，对吧？你就理解成是开玩笑吧。"
        },
        {
          "role": "希诺宁",
          "text": "他们刚才所说的「台词」，都是出自一部由八重堂出版的长篇战斗漫画《炽魂斗士战记》。"
        },
        {
          "role": "希诺宁",
          "text": "而那个「炽魂斗士特战队」，你可以简单理解为「漫画兴趣小组」。"
        },
        {
          "role": "派蒙",
          "text": "哦…喔！这下清楚多了，那你们这个兴趣小组，为什么会在蒙德聚会呢？"
        },
        {
          "role": "希诺宁",
          "text": "我不知道。但他们肯定会用氛围啦，热血啦之类的话回答你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "斩钉截铁地说出来了呢…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "爱拉尼肯定也不知道，如果你问的话，他们肯定会用…"
        },
        {
          "role": "汤义刚",
          "text": "我们是炽魂斗士嘛！蓬勃的青春热血，就要搭配最有挑战性的场地，才能绽放出光彩！"
        },
        {
          "role": "希诺宁",
          "text": "…这样的话来回答你。"
        },
        {
          "role": "希诺宁",
          "text": "实际上，是他们的一位队员明妮推荐了这次聚会的举办场地，也提议了这次「雪山越野赛」。"
        },
        {
          "role": "希诺宁",
          "text": "在多方考虑之后，他们认为这个方案很不错，就按照明妮的建议继续推进了下去。"
        },
        {
          "role": "希诺宁",
          "text": "所以最后，「炽魂斗士特战队」和我，就来到了这里。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我们能借漫画书吗？",
              "dialogues": []
            },
            {
              "text": "我的朋友能来看漫画吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱拉尼",
          "text": "能的能的，我来之前想着说不定能遇到对漫画感兴趣的人，特意多带了几本。"
        },
        {
          "role": "爱拉尼",
          "text": "你的朋友是哪一位，在这附近吗？"
        },
        {
          "role": "派蒙",
          "text": "其实我们是替组委会的朋友安柏来借的，就是那个扎着红色蝴蝶结，性格很活泼的骑士，你们有印象吗？"
        },
        {
          "role": "爱拉尼",
          "text": "噢，我记得她，她可热心了！那我直接把漫画拿去给她好了。"
        },
        {
          "role": "汤义刚",
          "text": "我和你一起去吧。"
        },
        {
          "role": "希诺宁",
          "text": "那正好，就辛苦你们了。旅行者，你还想和瓦雷莎打招呼对吧？她正在训练场地那边呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "希诺宁不一起来吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "…我才想歇一会。行吧，既然你都说了，那就走吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（安柏&爱拉尼&汤义刚）"
        },
        {
          "role": "安柏",
          "text": "谢谢啦，今晚休息的时候我可算有书看了。"
        },
        {
          "role": "爱拉尼",
          "text": "不用客气，能多一个同好我们也很开心。"
        },
        {
          "role": "汤义刚",
          "text": "没错没错。"
        },
        {
          "type": "subtitle",
          "text": "前往训练场地寻找瓦雷莎"
        },
        {
          "role": "希诺宁",
          "text": "瓦雷莎今天一直在和明妮一起训练，她们俩已经练了大半天。"
        },
        {
          "role": "希诺宁",
          "text": "雪山这么冷，也该回去了吧。"
        },
        {
          "role": "派蒙",
          "text": "瓦雷莎，我们来看你们训练啦。"
        },
        {
          "role": "瓦雷莎",
          "text": "欸，是派蒙的声音？派蒙——旅行者——好想你们呀！"
        },
        {
          "type": "subtitle",
          "text": "瓦雷莎一把抱住了派蒙…",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "和希诺宁一起解释了与众人相遇的前后经过。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "瓦雷莎",
          "text": "啊哈哈！爱拉尼和义刚，怎么用了漫画里的台词来开场哇？"
        },
        {
          "role": "派蒙",
          "text": "就是就是，连我都接不上话！"
        },
        {
          "role": "瓦雷莎",
          "text": "如果是我，开头应该会说「力量啊，爆开吧！」"
        },
        {
          "role": "希诺宁",
          "text": "你这话也挺不好接的。"
        },
        {
          "role": "希诺宁",
          "text": "而且，其他人和你见面的时候，谁都还没来得及说话，就见到你把明妮举起来转了好几圈。"
        },
        {
          "role": "瓦雷莎",
          "text": "呜啊，现在想想怪不好意思的。"
        },
        {
          "role": "瓦雷莎",
          "text": "毕竟这是我们第一次见面，之前只停留在互相写信、寄插画的环节。"
        },
        {
          "role": "瓦雷莎",
          "text": "这回认出明妮的时候，我一不小心就激动了，嘿嘿。"
        },
        {
          "role": "派蒙",
          "text": "不过，既然你俩是一起来的，为什么刚才介绍大家的时候，希诺宁说的是「『炽魂斗士特战队』和我」？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听着好像不是一队的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "因为我本来就不是这个兴趣小组的成员，[[妮佩卡]]才是，这一趟我也算是替她来的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "妮佩卡？",
              "dialogues": []
            },
            {
              "text": "她现在情况如何？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "希诺宁",
          "text": "一切正常。能吃能睡，学习的进度也没落下，不仅迷上了看漫画书，甚至还认识了明妮这位笔友。"
        },
        {
          "role": "希诺宁",
          "text": "妮佩卡时不时地就来我耳朵旁边念叨，说明妮既能画画又会做漫画道具，还挺擅长开导人，是个很好很好的人…"
        },
        {
          "role": "希诺宁",
          "text": "听她的描述，我还一度怀疑过明妮的年龄。但这次过来一看，没想到明妮的年纪真的这么小。"
        },
        {
          "role": "希诺宁",
          "text": "听说明妮提议大家参加「雪山越野赛」，妮佩卡也想来。"
        },
        {
          "role": "希诺宁",
          "text": "但…她也知道自己的身体状况，所以就拜托我替她参加，也向明妮问好。"
        },
        {
          "role": "瓦雷莎",
          "text": "欸嘿嘿，我之前就做好了旅行的准备，所以我和希诺宁就正好同行了。"
        },
        {
          "role": "希诺宁",
          "text": "是啊，还莫名其妙给我冠了个副队长的名号…"
        },
        {
          "role": "瓦雷莎",
          "text": "当，当然了！希诺宁的实力，绝对是队长级的！就是那种…队长级的副队长！"
        },
        {
          "role": "希诺宁",
          "text": "既然是有队长的实力，到底为什么还要做副队长？算了算了，我差点被你绕进去了。"
        },
        {
          "role": "希诺宁",
          "text": "反正这次过来，我也主要是为了给妮佩卡买点《炽魂斗士战记》的…呃…"
        },
        {
          "role": "瓦雷莎",
          "text": "周边！"
        },
        {
          "role": "希诺宁",
          "text": "好吧，周边。大概就是一些徽章、画着角色的纸、漫画的复制稿、画着漫画角色的硬木板…"
        },
        {
          "role": "希诺宁",
          "text": "瓦雷莎，你为什么用这种疑惑的表情看我，哪里错了么？"
        },
        {
          "role": "瓦雷莎",
          "text": "没错，完全没问题。只不过，听希诺宁这么一本正经地介绍周边，总感觉有点奇妙。"
        },
        {
          "role": "瓦雷莎",
          "text": "全能大工匠希诺宁，抱着成箱成箱的周边回去的画面…哇啊，想不出来！"
        },
        {
          "role": "瓦雷莎",
          "text": "这么多，都是妮佩卡要的吗？"
        },
        {
          "role": "希诺宁",
          "text": "没有。以妮佩卡的性格，她并不会开口要什么礼物。"
        },
        {
          "role": "希诺宁",
          "text": "但以我对妮佩卡的了解，她收到这些…周边的时候，会很高兴的。"
        },
        {
          "role": "瓦雷莎",
          "text": "那是当然啦，能拿到这种礼物，妮佩卡肯定会特别开心的！嘿嘿，希诺宁这么懂妮佩卡，简直就是妮佩卡的姐姐呢。"
        },
        {
          "role": "希诺宁",
          "text": "这么说也没错，我们本来就是家人。至于了解…我和妮佩卡相处时间不长，算略微了解吧。"
        },
        {
          "role": "明妮",
          "text": "呼啊…俯卧撑…瓦雷莎…我做完俯卧撑了。"
        },
        {
          "role": "瓦雷莎",
          "text": "好，那就是做完第四组了，嗯，稍微休息一下吧。"
        },
        {
          "role": "瓦雷莎",
          "text": "明妮，我来给你介绍，这两位是我和希诺宁在纳塔认识的朋友：旅行者和派蒙。"
        },
        {
          "role": "明妮",
          "text": "金色头发…飞着的白色…简直就像…蒙德的荣誉骑士？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "正是在下。",
              "dialogues": []
            },
            {
              "text": "你也认识我？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "明妮",
          "text": "真的是本人！我哥哥在酒馆工作，经常带回来一些小道消息。"
        },
        {
          "role": "明妮",
          "text": "酒客们说，你们走到哪个国家名声就响到哪个国家。感觉就像漫画里画的那样，特别厉害。"
        },
        {
          "role": "明妮",
          "text": "我能问问你们印象最深的冒险经历吗？"
        },
        {
          "type": "subtitle",
          "text": "你沉思片刻，看着身边的两位纳塔友人，你决定讲述一部分在纳塔所经历的事。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "明妮",
          "text": "太震撼了，原来菲耶蒂娜生活过的国家真有那么奇妙！"
        },
        {
          "role": "瓦雷莎",
          "text": "还有还有哦，我们「沃陆之邦」旁边还有一座大火山，时不时地就会往外喷出火球！虽然很危险，但特别适合英雄的试炼！"
        },
        {
          "role": "明妮",
          "text": "瓦雷莎你知道的，我一直都很想离开蒙德去外面的世界看看。"
        },
        {
          "role": "瓦雷莎",
          "text": "可以的哦！我听说，蒙德人是很自由的，应该…去哪里都没事吧？"
        },
        {
          "role": "明妮",
          "text": "可是…"
        },
        {
          "role": "明妮",
          "text": "如果要像荣誉骑士这样，一路坚持走下去，碰到什么危险都不退缩，得有很坚韧的内心才能做到吧。"
        },
        {
          "role": "瓦雷莎",
          "text": "确实，很少有人像旅行者这么厉害…但我们也可以在自己的路上努力嘛！"
        },
        {
          "role": "瓦雷莎",
          "text": "别忘了，保持韧性，坚定向前，这也是菲耶蒂娜的精神之一！"
        },
        {
          "role": "明妮",
          "text": "也对。嗯，我要加油！"
        },
        {
          "role": "明妮",
          "text": "而且为了和父母的约定，我也得努力练习，跑出成绩。"
        },
        {
          "role": "希诺宁",
          "text": "约定？之前没有听你提起过。"
        },
        {
          "role": "明妮",
          "text": "啊…那个啊…"
        },
        {
          "role": "瓦雷莎",
          "text": "没事的，每次赛前，我也会和伊安珊老师约好，这次的表现一定要比上次更好。"
        },
        {
          "role": "瓦雷莎",
          "text": "虽然不好说最后能发挥到什么程度，但有的时候，有一点压力才会有动力嘛。"
        },
        {
          "role": "瓦雷莎",
          "text": "不过，也不能忘了要「玩得开心」喔！最开始，就是为了和大家一起高高兴兴地玩，才有了这次的雪山聚会！"
        },
        {
          "role": "明妮",
          "text": "我知道的！瓦雷莎姐姐，不过…怎么说也是比赛，嘿嘿，我还是想要拿个好成绩的。"
        },
        {
          "role": "瓦雷莎",
          "text": "好！既然你那么想，我来陪你继续练习吧！"
        },
        {
          "role": "明妮",
          "text": "好的！瓦雷莎姐姐，我会跟上你的！"
        },
        {
          "role": "希诺宁",
          "text": "行了。你们不是刚刚练习完么，瓦雷莎也许无所谓，但明妮还是先歇着吧。"
        },
        {
          "role": "明妮",
          "text": "我还可…"
        },
        {
          "role": "明妮",
          "text": "咕噜噜…"
        },
        {
          "role": "希诺宁",
          "text": "听这声响，是该吃饭的时候了。"
        },
        {
          "role": "派蒙",
          "text": "对啊，要先吃好，才能练好！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "得合理膳食。",
              "dialogues": []
            },
            {
              "text": "保持适量训练。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瓦雷莎",
          "text": "没错，饮食也是训练里的重要环节！我把伊安珊老师的特别食谱分享给你，保证你明天精力满满！"
        },
        {
          "role": "明妮",
          "text": "真的？瓦雷莎姐姐知道蒙德有哪些菜适合训练后吃吗？"
        },
        {
          "role": "瓦雷莎",
          "text": "不太清楚欸，但吃东西这种事…相信肚子的直觉就好！"
        },
        {
          "role": "瓦雷莎",
          "text": "先从兽肉旋风开始好了…然后吃薄荷酱烤鱼、塔塔可、夹心土豆泥、粒果肉汤还有苹果卷卷！"
        },
        {
          "role": "明妮",
          "text": "欸——这些全都要吃完吗？！"
        },
        {
          "role": "瓦雷莎",
          "text": "嗯嗯，放开肚子，享受食物的美味，不知不觉就会吃完的！"
        },
        {
          "type": "subtitle",
          "text": "返回营地"
        },
        {
          "role": "瓦雷莎",
          "text": "对了，马上就到营地了，刚才听希诺宁说的时候，我就想着一定不能忘了这件事。"
        },
        {
          "role": "瓦雷莎",
          "text": "给！《炽魂斗士战记》的第二册。之前我感觉，大家说不定会想看，就多带了几本漫画来。"
        },
        {
          "role": "[[文件",
          "text": "传说任务-闪亮的斗士们登场-炽魂斗士战记·第二册.png|150px|center]]"
        },
        {
          "role": "瓦雷莎",
          "text": "可惜打包行李的时候没有带上第一册，给朋友介绍漫画的话，其实送第一册比较合适…"
        },
        {
          "role": "瓦雷莎",
          "text": "闲下来的时候可以翻翻看，要是你也喜欢就太好了，我们就有了超超超厉害的同好！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你。",
              "dialogues": []
            },
            {
              "text": "有空我会看的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瓦雷莎",
          "text": "那我们就去和大家会合了，有空的话，请来找我们玩哦。"
        },
        {
          "role": "[[文件",
          "text": "炽魂斗士战记·第二册-CG1.png|center|600px]]"
        },
        {
          "role": "菲耶蒂娜",
          "text": "我们要永远这样被动防守吗？万杰鲁老师，你们到底在等什么？"
        },
        {
          "role": "[[文件",
          "text": "炽魂斗士战记·第二册-CG2.png|center|600px]]"
        },
        {
          "role": "万杰鲁",
          "text": "菲耶蒂娜，别这样毛毛躁躁。想要取胜，时机可是很重要的。"
        },
        {
          "role": "[[文件",
          "text": "炽魂斗士战记·第二册-CG3.png|center|600px]]"
        },
        {
          "role": "玛薇卡",
          "text": "终于现身了。"
        },
        {
          "role": "[[文件",
          "text": "炽魂斗士战记·第二册-CG4.png|center|600px]]"
        },
        {
          "role": "玛薇卡",
          "text": "万杰鲁说得没错。菲耶蒂娜，如何判断时机就是我要教给你的第一课。"
        },
        {
          "role": "玛薇卡",
          "text": "魔兽们的首领已经现身，击败它才是扭转战局的关键。"
        },
        {
          "role": "玛薇卡",
          "text": "接下来就是真正的战场了，你敢面对吗？菲耶蒂娜。"
        },
        {
          "role": "菲耶蒂娜",
          "text": "我…"
        },
        {
          "role": "[[文件",
          "text": "炽魂斗士战记·第二册-CG5.png|center|600px]]"
        },
        {
          "role": "玛薇卡",
          "text": "等待的价值就在这里，来吧！"
        },
        {
          "role": "[[文件",
          "text": "炽魂斗士战记·第二册-CG6.png|center|600px]]"
        },
        {
          "role": "孟尼力克",
          "text": "听万杰鲁说，这是菲耶蒂娜第一次上战场啊。"
        },
        {
          "role": "图帕克",
          "text": "害怕的话，可以躲到前辈们身后。"
        },
        {
          "role": "万杰鲁",
          "text": "哈哈，那你们就小看这丫头了。"
        },
        {
          "role": "[[文件",
          "text": "炽魂斗士战记·第二册-CG7.png|center|600px]]"
        },
        {
          "role": "菲耶蒂娜",
          "text": "别开玩笑了，前辈们。正因为是第一次上战场，所以才不能毫无作为。"
        },
        {
          "role": "[[文件",
          "text": "炽魂斗士战记·第二册-CG8.png|center|600px]]"
        },
        {
          "role": "菲耶蒂娜",
          "text": "火神大人负责控制魔兽首领，而我们负责打扫战场。"
        },
        {
          "role": "菲耶蒂娜",
          "text": "这就是大家的战略对吧？"
        },
        {
          "role": "[[文件",
          "text": "炽魂斗士战记·第二册-CG9.png|center|600px]]"
        },
        {
          "role": "菲耶蒂娜",
          "text": "那就一起上吧，我不会后退！"
        },
        {
          "role": "派蒙",
          "text": "怎么到这里就结束了，菲耶蒂娜她们的战斗好精彩，我想看接下来的情节！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们有空的时候去找瓦雷莎她们吧，去问问下一册的内容。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（晕头转向的稻妻选手&无奈的稻妻选手）"
        },
        {
          "role": "晕头转向的稻妻选手",
          "text": "这雪山的路也太绕了，我刚刚差点走错营地。"
        },
        {
          "role": "无奈的稻妻选手",
          "text": "虽然这里的地形确实复杂，但你在自己家都能找不到厕所，我很难说这到底是谁的问题。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（自信满满的须弥选手）"
        },
        {
          "role": "自信满满的须弥选手",
          "text": "这里的条件比沙漠好多了，吃的也不错。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（悠闲的清泉镇选手）"
        },
        {
          "role": "悠闲的清泉镇选手",
          "text": "重在参与，重在参与。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（满腹狐疑的璃月选手&正在练武的璃月选手）"
        },
        {
          "role": "满腹狐疑的璃月选手",
          "text": "我们是来跑接力越野赛的，不去赛道上走走就在这里静坐能行吗？"
        },
        {
          "role": "正在练武的璃月选手",
          "text": "慌什么，每逢大事要有静气，静坐是为了修心。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（冻得发抖的枫丹选手&冻得打喷嚏的枫丹选手）"
        },
