{
  "quest_id": 10141,
  "chapter_num": "盛典与慧业 第三幕",
  "chapter_title": "人聚人散",
  "type": "eq",
  "route": "Gatherings and Partings",
  "stories": [
    {
      "story_id": 40103,
      "title": "冠冕之争",
      "description": "学院争霸赛来到了第二轮，这一次比赛地点在沙漠。到阿如村的分会场看看吧…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到第二天早上7点"
        },
        {
          "role": "派蒙",
          "text": "刚刚我听说风纪官好像抓捕了一批混进城中的镀金旅团…会不会就是之前策划绑架萨齐因的那些人？"
        },
        {
          "role": "派蒙",
          "text": "我们去教令院找阿拉夫问问吧！"
        },
        {
          "type": "subtitle",
          "text": "向阿拉夫询问调查情况"
        },
        {
          "role": "阿拉夫",
          "text": "你们来了。很抱歉我刚审完犯人，还没来得及派人去通知你们。"
        },
        {
          "role": "派蒙",
          "text": "问出什么了吗？"
        },
        {
          "role": "阿拉夫",
          "text": "怎么说呢，很多让人意想不到的事情。"
        },
        {
          "role": "阿拉夫",
          "text": "干绑票的那些佣兵比想象中好抓，我让人假扮成萨齐因，没多久就把他们钓出来了。"
        },
        {
          "role": "阿拉夫",
          "text": "问题是审完之后才知道，雇他们来的人，好像就是萨齐因自己的孩子。"
        },
        {
          "role": "派蒙",
          "text": "孩子找人绑架自己的父亲？为什么要这么做？"
        },
        {
          "role": "阿拉夫",
          "text": "谁知道呢…进城的佣兵只是一小部分，还有很多人留在城外接应。"
        },
        {
          "role": "阿拉夫",
          "text": "我们正准备抽调人手，去将他们一网打尽。你们要不要也一起来？"
        },
        {
          "role": "派蒙",
          "text": "好吧，正好我们也去看看到底是怎么回事。"
        },
        {
          "type": "subtitle",
          "text": "前往绑架犯的营地"
        },
        {
          "role": "派蒙",
          "text": "阿拉夫，你确定是这里吗？我怎么觉得怪怪的？"
        },
        {
          "role": "派蒙",
          "text": "是这里没错。只是不知道他们为什么倒在地上…"
        },
        {
          "type": "subtitle",
          "text": "调查绑架案的真相"
        },
        {
          "role": "利瓦尔",
          "text": "老大，好像又有人来了…"
        },
        {
          "role": "麦扎尔",
          "text": "我说，兄弟们只是拿钱办事，罪不至此吧。冤有头债有主，雇我们绑架萨齐因的是这位。"
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "怎么回事？你们是被谁打成这个样子的？"
        },
        {
          "role": "麦扎尔",
          "text": "你和他们不是一伙儿的？"
        },
        {
          "role": "派蒙",
          "text": "他们？你说的是谁呀？"
        },
        {
          "role": "麦扎尔",
          "text": "有个飞在天上的小鬼，不由分说把我们打了一顿。之后没多久，又来了一个穿绿衣服的男人，找我们问话。"
        },
        {
          "role": "阿拉夫",
          "text": "我已经问清楚了。幕后主使就是这位，萨齐因的儿子西瓦尼。"
        },
        {
          "role": "阿拉夫",
          "text": "你们有什么想问的，现在都可以问。之后我会把他们一起逮捕，带回教令院审问。"
        },
        {
          "role": "派蒙",
          "text": "你为什么要雇人绑架萨齐因呢？"
        },
        {
          "role": "西瓦尼",
          "text": "哼，这还用问吗？二十年了，他不知道躲在哪里逍遥快活，根本不顾我的死活。"
        },
        {
          "role": "西瓦尼",
          "text": "更可气的是，他把产业交托给教令院打理，还立下合同，说这些产业总有一天要留给他欣赏的天才。"
        },
        {
          "role": "西瓦尼",
          "text": "那本该是我的东西，凭什么要拱手让人？他不给我，我就从他的手里夺过来。"
        },
        {
          "role": "旅行者",
          "text": "你该不会是想…"
        },
        {
          "role": "西瓦尼",
          "text": "不错！他不是说，他会躲在暗处观看比赛吗？"
        },
        {
          "role": "西瓦尼",
          "text": "那我就雇人抓住他，强迫他修改自己签下的合同。若是教令院不答应，我就强迫萨齐因承认，我就是那个他认可的天才！"
        },
        {
          "role": "旅行者",
          "text": "你们找到他了吗？"
        },
        {
          "role": "西瓦尼",
          "text": "没有。那老家伙太会藏了，不知道躲在哪里看笑话呢。"
        },
        {
          "role": "西瓦尼",
          "text": "二十年前我就觉得他疯了，一个疯子什么都能干得出来…"
        },
        {
          "role": "旅行者",
          "text": "你了解「才识之冠」吗？"
        },
        {
          "role": "西瓦尼",
          "text": "才识之冠？你是说他捐给教令院的那个？"
        },
        {
          "role": "西瓦尼",
          "text": "我知道那破玩意儿很贵，当初为了买它，萨齐因变卖了好些产业。"
        },
        {
          "role": "西瓦尼",
          "text": "买回来之后，家里还闹过鬼，有时路过收藏室，能听见里面有人尖着嗓子说话。"
        },
        {
          "role": "西瓦尼",
          "text": "另外，萨齐因把它捐给教令院之前，曾经把自己关在收藏室里，一连好多天研究那个冠冕。"
        },
        {
          "role": "西瓦尼",
          "text": "不过那时候他已经精神不正常了，做什么我们都不觉得奇怪。"
        },
        {
          "role": "派蒙",
          "text": "你说他精神不正常，是怎么回事？"
        },
        {
          "role": "西瓦尼",
          "text": "那时候我还小，也记不太清楚了。印象里他去沙漠考察，很多年都没有回来。"
        },
        {
          "role": "西瓦尼",
          "text": "有一天他终于回到家，却像是变了个人一样，念叨着旁人听不懂的话，没日没夜地写论文。"
        },
        {
          "role": "西瓦尼",
          "text": "我想去看看他写了什么，却被他赶出了房间。之后他带着写好的论文又出去了一趟，回来之后就和教令院签订了合同。"
        },
        {
          "role": "西瓦尼",
          "text": "现在想想，或许当时的他已经不是我的父亲了，而是披着萨齐因外皮的…从沙漠回来的魔鬼。"
        },
        {
          "role": "派蒙",
          "text": "不要讲得这么吓人啦！我听着都觉得害怕！"
        },
        {
          "role": "西瓦尼",
          "text": "你们爱信不信，我知道的已经都说了。我只拜托你们一件事，如果你们碰巧遇见了萨齐因，帮我告诉他——"
        },
        {
          "role": "西瓦尼",
          "text": "不管他是在外面研究什么，在我眼里他都是个混蛋。"
        },
        {
          "role": "阿拉夫",
          "text": "说完了？那就跟我们走吧。"
        },
        {
          "role": "阿拉夫",
          "text": "这次闹事的主谋，我们已经抓捕完毕了。多谢你提供的情报。"
        },
        {
          "role": "阿拉夫",
          "text": "你还有什么担心的问题吗？"
        },
        {
          "role": "旅行者",
          "text": "「才识之冠」…"
        },
        {
          "role": "派蒙",
          "text": "的确，艾尔海森留下的笔记中也提到了那个冠冕…"
        },
        {
          "role": "阿拉夫",
          "text": "艾尔海森大人也在关注这件事？"
        },
        {
          "role": "阿拉夫",
          "text": "我有一个想法。如果你们认为冠冕有问题，不妨联系主办方，暂时停止比赛，仔细调查一番。"
        },
        {
          "role": "派蒙",
          "text": "有道理！那我们现在就回主会场，把这件事告诉卡莉娜吧！"
        },
        {
          "type": "subtitle",
          "text": "前往主会场寻找工作人员"
        },
        {
          "role": "派蒙",
          "text": "卡莉娜！"
        },
        {
          "role": "卡莉娜",
          "text": "呼…你们终于回来了。"
        },
        {
          "role": "卡莉娜",
          "text": "真是让我一顿好找，你们刚刚去哪了？第三轮比赛已经开始了。"
        },
        {
          "role": "派蒙",
          "text": "我们刚刚去抓了一些盯上萨齐因的坏人…"
        },
        {
          "role": "派蒙",
          "text": "不对，这不是重点！才识之冠可能有问题，我们想好好调查一下它！"
        },
        {
          "role": "卡莉娜",
          "text": "才识之冠有问题？不应该吧。"
        },
        {
          "role": "卡莉娜",
          "text": "二十年来，每届比赛都会用到才识之冠，从来没出过什么问题啊？你们哪里来的消息？"
        },
        {
          "role": "旅行者",
          "text": "是我们的一些推测。"
        },
        {
          "role": "卡莉娜",
          "text": "这件事很重要，让我想想…"
        },
        {
          "role": "卡莉娜",
          "text": "实不相瞒，在第三轮比赛开始之前，我们已经将冠冕放在无郁稠林里了。"
        },
        {
          "role": "卡莉娜",
          "text": "第三轮比赛的内容，正是到无郁稠林中找出冠冕，然后将冠冕带出来，放到指定的台子上。最先将冠冕放好的人会得到4点积分。"
        },
        {
          "role": "卡莉娜",
          "text": "考虑到之前参赛者的分数没有拉开差距，第一个放好冠冕的人很可能就是最后的冠军。"
        },
        {
          "role": "卡莉娜",
          "text": "所以我猜这轮比赛应该很激烈。你们未必赶得上…"
        },
        {
          "role": "旅行者",
          "text": "总要试一试。"
        },
        {
          "role": "卡莉娜",
          "text": "我会将冠冕的位置标注出来，也请你们立刻前往现场查看情况，希望不要出什么事情…"
        },
        {
          "role": "派蒙",
          "text": "好！我们马上出发！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卡莉娜）"
        },
        {
          "role": "卡莉娜",
          "text": "为什么偏偏是这一届…"
        },
        {
          "type": "subtitle",
          "text": "回收「才识之冠」"
        },
        {
          "type": "subtitle",
          "text": "额外对话（艾尔海森&妮露）"
        },
        {
          "type": "subtitle",
          "text": "你们路过终点时询问艾尔海森和妮露当前情况…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "艾尔海森、妮露，你们看到其他参赛者了吗？"
        },
        {
          "role": "妮露",
          "text": "没有，暂时还没有人完成比赛…发生什么事了吗？"
        },
        {
          "role": "派蒙",
          "text": "那个冠冕可能有问题…对了，艾尔海森，你也在这里，你应该知道什么吧？"
        },
        {
          "role": "艾尔海森",
          "text": "你指什么？"
        },
        {
          "role": "派蒙",
          "text": "你——算了！我们先去把冠冕找回来，然后再来问你！"
        },
        {
          "role": "派蒙",
          "text": "奇怪，是因为无郁稠林的影响吗？提示器好像暂时不能用了…我们直接去找冠冕吧！"
        },
        {
          "type": "subtitle",
          "text": "你们来到埋藏才识之冠的地方…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "等下，这里好像是空的！"
        },
        {
          "role": "派蒙",
          "text": "难道说冠冕已经被人取走了？旅行者，不如我们去终点那里等！"
        },
        {
          "type": "subtitle",
          "text": "返回终点处查看情况"
        },
        {
          "type": "subtitle",
          "text": "[https://www.bilibili.com/video/BV1oP411y7wZ?p=1 过场动画]"
        },
        {
          "role": "艾尔海森",
          "text": "看来莱依拉选手率先拿到了冠冕…"
        },
        {
          "role": "艾尔海森",
          "text": "不过想抵达终点并不容易"
        },
        {
          "type": "subtitle",
          "text": "珐露珊拦在了前方并催使机械装置抢夺…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "莱依拉生成护盾抵挡…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "妮露",
          "text": "阿帽选手也到了"
        },
        {
          "type": "subtitle",
          "text": "流浪者抢过莱依拉手上的才识之冠，并将珐露珊的机械装置打飞在地…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "提纳里向流浪者射出箭矢，但都被躲过…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "流浪者继续向终点飞去并打飞了空中飞来的赤沙之杖…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "妮露",
          "text": "珐露珊选手的机械装置好像失控了…"
        },
        {
          "role": "艾尔海森",
          "text": "比赛逐渐白热化"
        },
        {
          "role": "艾尔海森",
          "text": "哦？"
        },
        {
          "role": "艾尔海森",
          "text": "卡维选手终于姗姗来迟"
        },
        {
          "type": "subtitle",
          "text": "场面逐渐混乱，卡维趁机抓住珐露珊的机械装置飞向流浪者…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "在赛诺和流浪者打得难解难分之时，卡维趁机抓住了被打飞的才识之冠…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "妮露",
          "text": "是卡维选手的工具箱！"
        },
        {
          "role": "妮露",
          "text": "它将冠冕拋到了卡维手上…"
        },
        {
          "role": "妮露",
          "text": "咦？"
        },
        {
          "type": "subtitle",
          "text": "卡维历经万难来到了终点前…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "突然卡维听到了某人的话语…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "萨齐因",
          "text": "对"
        },
        {
          "role": "萨齐因",
          "text": "就是这样"
        },
        {
          "role": "萨齐因",
          "text": "把王冠放上去…"
        },
        {
          "role": "萨齐因",
          "text": "你会得到你想要的一切。"
        },
        {
          "role": "卡维",
          "text": "你谁啊"
        },
        {
          "role": "卡维",
          "text": "不要在我脑袋里说话…！"
        },
        {
          "role": "萨齐因",
          "text": "如果是你的话"
        },
        {
          "role": "萨齐因",
          "text": "应该不会让我失望。"
        },
        {
          "role": "卡维",
          "text": "莫名其妙…"
        },
        {
          "role": "赛诺",
          "text": "不太对劲…"
        },
        {
          "type": "subtitle",
          "text": "卡维摇摇晃晃将冠冕放到台子上，眼前突然出现了一个身影…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与卡维对话"
        },
        {
          "role": "？？？",
          "text": "终于等到了…能够继承我财产的人…能够继承我研究的人。"
        },
        {
          "role": "？？？",
          "text": "来，卡维。好孩子，到我这来…"
        },
        {
          "role": "卡维",
          "text": "…你怎么知道我的名字？你到底是谁？"
        },
        {
          "role": "萨齐因",
          "text": "我名萨齐因。当然，准确来说，我只是萨齐因的一小块意识碎片而已。"
        },
        {
          "role": "萨齐因",
          "text": "真是一种奇妙的缘分…看到你，我会想起曾经见过的一个人。但你比他更坚强，更明白世事的不易。你有资格继承我的一切。"
        },
        {
          "role": "萨齐因",
          "text": "孩子们，这是我们第一次见面。但接下来我要说的话很重要，希望你们帮我做一个见证。"
        },
        {
          "role": "萨齐因",
          "text": "在本次学院争霸赛中，每个人的表现都很出色。教令院总是有很多奇才，你们每个人都是特别的。"
        },
        {
          "role": "萨齐因",
          "text": "但是，如果要我选出一位继任者，我会选择你，卡维。不仅是因为你夺得了冠军，而且因为你有着和我相似的性格。"
        },
        {
          "role": "卡维",
          "text": "…我？和你？"
        },
        {
          "role": "萨齐因",
          "text": "是啊，我们都是可怜的理想主义者，这是我们痛苦的根源。"
        },
        {
          "role": "萨齐因",
          "text": "二十八年前，我来到沙漠，在那里定居了整整八年。你觉得我在那里看到了什么？争乱、厮杀，无穷无尽。"
        },
        {
          "role": "萨齐因",
          "text": "围绕水源的争抢、对商队的劫掠、对民众的盘剥，一天都没有停过。防沙壁外的世界，与我认知中的完全是两个样子。"
        },
        {
          "role": "萨齐因",
          "text": "我为我看到的一切深感痛苦，所以我迫切地想要找出一条路来拯救他们。"
        },
        {
          "role": "卡维",
          "text": "所以…你找到答案了吗？"
        },
        {
          "role": "萨齐因",
          "text": "我是因论派出身的学者，自然会用因论派的知识去寻找答案。"
        },
        {
          "role": "萨齐因",
          "text": "我研究历史、分析社会，做了无数人性的实验，甚至与沙漠深处那些自称为「失落学派」的学者接触——"
        },
        {
          "role": "萨齐因",
          "text": "然后，我发现答案其实根本就不存在。"
        },
        {
          "role": "萨齐因",
          "text": "我无法将过错简单地推给任何一方势力，因为罪孽镌刻在人性之上。人性带来纷争，纷争导向毁灭，这是人力无法逆转的必然。"
        },
        {
          "role": "萨齐因",
          "text": "我研究的是如何从历史中取得教训，可结论竟然是历史中没有任何教训，一切都只能朝着更糟的方向发展！"
        },
        {
          "role": "萨齐因",
          "text": "我不知道我所学的一切到底有什么意义，沉重的虚无感让我无法再面对生活的一切，于是我决定结束自己的生命。"
        },
        {
          "role": "萨齐因",
          "text": "但先前一个偶然的机会，让我得到了这枚可以存放部分意识的冠冕。我将自己的经历录入其中，又让教令院代为打理我的家产。"
        },
        {
          "role": "艾尔海森",
          "text": "果然，与教令院签订的「合同」，其实更像是你的「遗嘱」。"
        },
        {
          "role": "艾尔海森",
          "text": "可既然你已经对这个世界绝望，又为什么还要做这些事？"
        },
        {
          "role": "萨齐因",
          "text": "先前已经说过，我做过许多关于人性的实验。你可以理解为，这是我众多实验的最后一个。"
        },
        {
          "role": "萨齐因",
          "text": "教令院不缺天才，每代都有闪耀的明星。重赏之下必有勇夫，我盼望着有一天，有人能解开人性的死结，让世界走向正确的方向。"
        },
        {
          "role": "艾尔海森",
          "text": "也就是说，你想要的继承者，既要是天才，又要能体会普通人的痛苦。这样才能对人性、对社会、对这个世界有更清晰的认知。"
        },
        {
          "role": "卡维",
          "text": "……"
        },
        {
          "role": "艾尔海森",
          "text": "你是否想过，财富会麻痹人心，令他们失去对外界痛苦的感知。继承你财富的理想主义者未必能走到最后。"
        },
        {
          "role": "萨齐因",
          "text": "你很聪明。但我知道，你并非能够理解我想法的那类人——对我来说，这也是实验的一部分，是我对人性的考察。"
        },
        {
          "role": "萨齐因",
          "text": "无论继承者因我的研究而痛苦，还是沉溺于虚假的快乐之中，我的研究都会更进一步。"
        },
        {
          "role": "萨齐因",
          "text": "我为世界的本质感到痛苦，我为沉重的历史感到惋惜，我为未竟的研究感到遗憾。"
        },
        {
          "role": "萨齐因",
          "text": "所以，卡维，亲爱的孩子…你将为我所用。"
        },
        {
          "role": "卡维",
          "text": "你…确定要将所有的东西送给我，交由我来处置？"
        },
        {
          "role": "萨齐因",
          "text": "我相信我的眼光。戴上冠冕，替我走完这条路吧。"
        },
        {
          "type": "subtitle",
          "text": "过场动画"
        },
        {
          "role": "萨齐因",
          "text": "那些结论会让你感到痛苦吗？"
        },
        {
          "role": "萨齐因",
          "text": "还是说大量的财富会让你感到麻木呢？"
        },
        {
          "role": "萨齐因",
          "text": "我期待着你的答案。"
        },
        {
          "role": "萨齐因",
          "text": "我所做的研究，已经全部寄放在阿——"
        },
        {
          "type": "subtitle",
          "text": "卡维将才识之冠砸在了地上…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "卡维",
          "text": "说够了吧"
        },
        {
          "role": "卡维",
          "text": "我的人生已经很倒霉了，"
        },
        {
          "role": "卡维",
          "text": "不想再招惹更多痛苦的事情。"
        },
        {
          "role": "卡维",
          "text": "你的钱我不会要。"
        },
        {
          "role": "卡维",
          "text": "你不是说，你观察了许多正在遭受苦难的人吗？"
        },
        {
          "role": "卡维",
          "text": "那就用你留下的产业去帮助那些人吧。"
        },
        {
          "type": "subtitle",
          "text": "萨齐因的嘴角勾起了一种不易察觉的微笑，随后就消失了…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "询问卡维身体情况"
        },
        {
          "role": "卡维",
          "text": "这样就结束了吧。"
        },
        {
          "role": "派蒙",
          "text": "卡维…"
        },
        {
          "role": "提纳里",
          "text": "你没事吧？身体感觉怎么样？"
        },
        {
          "role": "卡维",
          "text": "我…没事…唔…"
        },
        {
          "role": "卡维",
          "text": "谢谢你提纳里，别担心。"
        },
        {
          "role": "提纳里",
          "text": "别太勉强自己。"
        },
        {
          "role": "妮露",
          "text": "卡维先生…"
        },
        {
          "role": "艾尔海森",
          "text": "虽然冠冕被卡维选手摔碎，但他在摔碎前就已完成比赛。"
        },
        {
          "role": "艾尔海森",
          "text": "按规则，他是第三轮比赛的胜者，从总积分来看，也是本届学院争霸赛的冠军。"
        },
        {
          "role": "艾尔海森",
          "text": "作为学院争霸赛的冠军，以及萨齐因亲自拟定的继承者，卡维选手享有对萨齐因所有财产的继承权。"
        },
        {
          "role": "艾尔海森",
          "text": "我再问一次，你确定要捐出萨齐因所有的财产吗？"
        },
        {
          "role": "卡维",
          "text": "我刚刚说过了。他觉得这个世界不好，那就用他留下来的产业去做一些改变。"
        },
        {
          "role": "卡维",
          "text": "单纯的否定不能促成任何结果。我和他…不一样。"
        },
        {
          "role": "艾尔海森",
          "text": "好。作为书记官，我会将这件事记入档案。"
        },
        {
          "role": "艾尔海森",
          "text": "至于这些财产具体的使用细节，赛后将由贤者亲自与你沟通。"
        },
        {
          "role": "卡维",
          "text": "…就这样吧。"
        },
        {
          "role": "卡维",
          "text": "我不知道那个人的研究是否正确，也不知道该怎么帮他去完成。"
        },
        {
          "role": "卡维",
          "text": "我只知道，让一切停在这里，所有参赛者就不会感到痛苦。"
        },
        {
          "role": "卡维",
          "text": "我们不会是最后一届，将来还会有人来到这个比赛…还会有未来的学者继续为这个赛事前赴后继。"
        },
        {
          "role": "卡维",
          "text": "萨齐因的话会让人痛苦。所以…到此为止，不要再继续传播下去了。"
        },
        {
          "role": "卡维",
          "text": "我们都是学者，贸然推翻他的观点也是独断傲慢。没关系，这份责任我来背负就好。"
        },
        {
          "role": "卡维",
          "text": "对我来说这样就好。我也…只能做到这么多。"
        },
        {
          "role": "艾尔海森",
          "text": "……"
        },
        {
          "role": "艾尔海森",
          "text": "说得不错，陈述了大部分人渴望却未必敢去执行的正义和理想。"
        },
        {
          "role": "艾尔海森",
          "text": "虽然在我看来还是那么可笑。你早已察觉到自身的问题，仅仅是碍于自尊心不愿承认。"
        },
        {
          "role": "艾尔海森",
          "text": "不过你的这些观点很适合在领奖台上发表。我谨代表本次比赛组委会祝贺你获得冠军，卡维选手。"
        },
        {
          "role": "卡维",
          "text": "哈？别搞错了，我不需要没有诚意的赞扬！"
        },
        {
          "role": "卡维",
          "text": "另外现在不是辩论的场合，请你专注评论比赛而不是我的观念。"
        },
        {
          "role": "妮露",
          "text": "恭喜你，卡维先生！也请您准备一下出席颁奖仪式…"
        }
      ],
      "collapse_ranges": [
