  "stories": [
    {
      "story_id": 71814,
      "title": "海上拾玉",
      "description": "在群玉阁撞击了那个海里的东西后，海上还零星地飘着群玉阁的碎片，千岩军大坤正在找人来清理这些碎片…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "在北面码头清理水面上的漂浮物"
        },
        {
          "role": "大坤",
          "text": "唉，挺好的一个群玉阁，就这么没了…"
        },
        {
          "type": "subtitle",
          "text": "在南面码头清理水面上的漂浮物"
        },
        {
          "type": "subtitle",
          "text": "向大坤回报"
        },
        {
          "role": "大坤",
          "text": "你们已经清扫完了吗？"
        },
        {
          "role": "旅行者",
          "text": "发现了这些东西…"
        },
        {
          "role": "大坤",
          "text": "嗯…这些摩拉你就自己收着吧，数量也不太多，就当做你帮忙的报酬吧。"
        },
        {
          "role": "大坤",
          "text": "这个盒子我就不知道是什么了，不然你把它拿给百闻看看吧。"
        },
        {
          "role": "大坤",
          "text": "她就在月海亭那边办公，也许她知道这是什么。"
        },
        {
          "type": "subtitle",
          "text": "把盒子交给百闻"
        },
        {
          "role": "百闻",
          "text": "您好，有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "在海上捡到了这个…"
        },
        {
          "role": "百闻",
          "text": "嗯？请给我看看。"
        },
        {
          "role": "百闻",
          "text": "没错，这确实是群玉阁上的东西。"
        },
        {
          "role": "旅行者",
          "text": "那具体是…"
        },
        {
          "role": "百闻",
          "text": "是一些文册，还有一些没有审阅过的公文。居然还这么完好，真是出乎意料。"
        },
        {
          "role": "百闻",
          "text": "不过，能找到这些，确实也能节省一点工作量，毕竟现在这个情况，善后工作真是做不完。"
        },
        {
          "role": "百闻",
          "text": "哦对了，谢谢您帮忙把这些拿来，这些给您，就当是谢礼吧。"
        },
        {
          "role": "百闻",
          "text": "您好，有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "在海上捡到了这个…"
        },
        {
          "role": "百闻",
          "text": "嗯？请给我看看。"
        },
        {
          "role": "百闻",
          "text": "没错，这确实是群玉阁上的东西。"
        },
        {
          "role": "旅行者",
          "text": "那具体是…"
        },
        {
          "role": "百闻",
          "text": "是一些文册，还有一些没有审阅过的公文。居然还这么完好，真是出乎意料。"
        },
        {
          "role": "百闻",
          "text": "虽然这些文件都已经过期了…但还是谢谢您帮忙把这些拿来，这些给您，就当是谢礼吧。"
        }
      ]
    }
  ]
