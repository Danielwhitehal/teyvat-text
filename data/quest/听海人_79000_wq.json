  "stories": [
    {
      "story_id": 79000,
      "title": "听海人",
      "description": "在金苹果群岛中的「双双岛」中，你发现了一枚奇怪的海螺。而海螺里的那些声音，似乎还在暗示着什么…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "找到啦！宝藏，宝藏，里面会有什么呢…"
        },
        {
          "role": "派蒙",
          "text": "咦？上面怎么有锁。还、还是密码锁…需要密码才能打开吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这锁应该能直接砸开…",
              "dialogues": []
            },
            {
              "text": "要想想开锁的方法。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "等一下！直接砸的话，要是里面的东西也被砸坏了怎么办？"
        },
        {
          "role": "派蒙",
          "text": "我们还是想想打开锁的方法吧。"
        },
        {
          "role": "派蒙",
          "text": "但既然这个箱子装着的东西是「传家宝」，而且这箱子还是用「密码」的形式锁住的…"
        },
        {
          "role": "派蒙",
          "text": "那就是说，锁住这个箱子的人认为，自己所留下的「密码」能很容易就被记住…"
        },
        {
          "role": "派蒙",
          "text": "看来我们唯一的希望，就只有那些保存着声音的海螺了。"
        },
        {
          "role": "派蒙",
          "text": "再好好听一下那些海螺里的声音吧，希望那些声音里真的有「密码」的线索…"
        },
        {
          "role": "上锁的箱子",
          "text": "（需要输入正确的密码才能打开这个箱子。密码的「第一位」应该输入什么呢…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "输入「一」",
            "输入「二」",
            "输入「三」",
            "输入「四」",
            "输入「五」"
          ]
        },
        {
          "role": "旅行者",
          "text": "输入「一」"
        },
        {
          "role": "上锁的箱子",
          "text": "（需要输入正确的密码才能打开这个箱子。密码的「第二位」应该输入什么呢…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "输入「一」",
            "输入「二」",
            "输入「三」",
            "输入「四」",
            "输入「五」"
          ]
        },
        {
          "role": "旅行者",
          "text": "输入「一」"
        },
        {
          "role": "上锁的箱子",
          "text": "（需要输入正确的密码才能打开这个箱子。密码的「第三位」应该输入什么呢…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "输入「一」",
            "输入「二」",
            "输入「三」",
            "输入「四」",
            "输入「五」"
          ]
        },
        {
          "role": "旅行者",
          "text": "输入「一」"
        },
        {
          "role": "上锁的箱子",
          "text": "（需要输入正确的密码才能打开这个箱子。密码的「第四位」应该输入什么呢…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "输入「一」",
            "输入「二」",
            "输入「三」",
            "输入「四」",
            "输入「五」"
          ]
        },
        {
          "role": "旅行者",
          "text": "输入「一」"
        },
        {
          "role": "上锁的箱子",
          "text": "（尝试打开密码锁…）"
        },
        {
          "type": "subtitle",
          "text": "打开箱子"
        },
        {
          "role": "上锁的箱子",
          "text": "打开了！快看看里面有什么东西吧。"
        }
        
      ]
    }
