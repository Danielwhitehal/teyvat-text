{
  "quest_id": 10021,
  "chapter_num": "风花节 其一",
  "chapter_title": "花与云之诗",
  "type": "eq",
  "route": "Ode to Flower and Cloud",
  "stories": [
    {
      "story_id": 41410,
      "title": "花与云之诗",
      "description": "闲暇的时候，去蒙德街头找找有什么事可做吧！",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "到蒙德街头逛逛"
        },
        {
          "role": "派蒙",
          "text": "最近似乎有点闲呢，去找些事做吧！"
        },
        {
          "type": "subtitle",
          "text": "与莎拉对话"
        },
        {
          "role": "派蒙",
          "text": "喂~你这里有没有我们能帮忙的事呀？"
        },
        {
          "role": "莎拉",
          "text": "最近是风花节呢，不好意思，没有能交给你们的事哦。"
        },
        {
          "role": "派蒙",
          "text": "唔？没有吗？"
        },
        {
          "role": "派蒙",
          "text": "那我们去别的地方问问吧。"
        },
        {
          "type": "subtitle",
          "text": "与玛乔丽对话"
        },
        {
          "role": "派蒙",
          "text": "你好，有没有需要我们帮忙的事？"
        },
        {
          "role": "玛乔丽",
          "text": "哈哈哈哈，你可真会开玩笑！现在是风花节，有事也不能交给你们做呀！"
        },
        {
          "role": "派蒙",
          "text": "哎？哎…？"
        },
        {
          "role": "派蒙",
          "text": "怪了，我们直接去冒险家协会看看吧！"
        },
        {
          "type": "subtitle",
          "text": "与凯瑟琳对话"
        },
        {
          "role": "派蒙",
          "text": "凯瑟琳，有没有要交给我们的委托呀！"
        },
        {
          "role": "凯瑟琳",
          "text": "抱歉，风花节期间，委托少了许多。我这里也没有什么能交给你们的工作呢。"
        },
        {
          "role": "派蒙",
          "text": "哎——？连冒险家协会也这样？！"
        },
        {
          "role": "派蒙",
          "text": "怎么办呀，旅行者，我们、我们不会是失业了吧！"
        },
        {
          "role": "旅行者",
          "text": "万万没想到呢。"
        },
        {
          "role": "派蒙",
          "text": "不行，我不死心！我要再试一次！"
        },
        {
          "type": "subtitle",
          "text": "与花店的芙萝拉对话"
        },
        {
          "role": "派蒙",
          "text": "芙萝拉，你这里有需要我们帮忙的工作吗？"
        },
        {
          "role": "芙萝拉",
          "text": "呼呼，没有哦。"
        },
        {
          "role": "派蒙",
          "text": "也、也是因为那个风花节吗？风花节到底是什么呀？"
        },
        {
          "role": "芙萝拉",
          "text": "呼呼…你们不知道风花节吗？"
        },
        {
          "role": "派蒙",
          "text": "风花节…？是起风的节日，还是种花的节日？"
        },
        {
          "role": "芙萝拉",
          "text": "风花节是蒙德城的传统节日，也是属于自由和爱情的节日。风花节庆典，更是蒙德城的狂欢。"
        },
        {
          "role": "芙萝拉",
          "text": "每年这个时候，人们会向风神巴巴托斯大人献上「风之花」以示崇敬与爱意。除此之外，也有送花给心爱、重要的人的传统哦…"
        },
        {
          "role": "芙萝拉",
          "text": "每到风花节，店里就忙得要命…对我来说也算是一种幸福的烦恼，呼呼。"
        },
        {
          "role": "旅行者",
          "text": "「风之花」是什么？"
        },
        {
          "role": "芙萝拉",
          "text": "「风之花」是风花节的象征，代表着自由与风之精神的花卉哦。"
        },
        {
          "role": "派蒙",
          "text": "那「风之花」到底是什么花呢？"
        },
        {
          "role": "芙萝拉",
          "text": "呼呼…那就说来话长啦…"
        },
        {
          "role": "芙萝拉",
          "text": "我祖母说，「风之花」诞生的时候她都还没有出生呢，应该是几百年前了吧。"
        },
        {
          "role": "芙萝拉",
          "text": "原因我也不清楚，但人们似乎都会选择蒲公英作为送礼用的「风之花」。"
        },
        {
          "role": "派蒙",
          "text": "也就是说，蒙德人口中的「风之花」就是蒲公英！"
        },
        {
          "role": "芙萝拉",
          "text": "呼呼…大概是吧，其实我也不确定哦，但我们家一直都这样觉得。"
        },
        {
          "role": "昆恩",
          "text": "不对！"
        },
        {
          "role": "昆恩",
          "text": "咳咳，你们说的话正好被我听见，忍不住就…你们是在聊「风之花」吗？"
        },
        {
          "role": "派蒙",
          "text": "是水果摊的昆恩呀，你也要加入我们吗？"
        },
        {
          "role": "昆恩",
          "text": "不不，我只是来纠正一下，「风之花」不是蒲公英，而是风车菊。"
        },
        {
          "role": "芙萝拉",
          "text": "啊呀，昆恩，你好呀。"
        },
        {
          "role": "昆恩",
          "text": "芙萝拉，最近来你店里买风车菊的人应该不少吧？"
        },
        {
          "role": "芙萝拉",
          "text": "呼呼…是哦！"
        },
        {
          "role": "昆恩",
          "text": "看到没有，这就是我们风车菊派在贡献销量！"
        },
        {
          "role": "昆恩",
          "text": "风车菊既是蒙德的象征，也是风车的化身，代表着风与自由。「风之花」，非它莫属啊！"
        },
        {
          "role": "昆恩",
          "text": "信我的准没错！蒙德正统的「风之花」，绝对是风车菊。"
        },
        {
          "role": "芙萝拉",
          "text": "哎~？"
        },
        {
          "role": "贝雅特丽奇",
          "text": "唔？是这样吗？"
        },
        {
          "role": "芙萝拉",
          "text": "呀，贝雅，你也来了。"
        },
        {
          "role": "贝雅特丽奇",
          "text": "「风之花」…难道不是塞西莉亚花吗？"
        },
        {
          "role": "派蒙",
          "text": "啊？是吗？"
        },
        {
          "role": "芙萝拉",
          "text": "哎~？「风之花」是塞西莉亚花…我还是第一次听说…"
        },
        {
          "role": "昆恩",
          "text": "怎、怎么可能！"
        },
        {
          "role": "昆恩",
          "text": "听我说，「风之花」的定义确实还有争议，但蒙德人普遍认为，「风之花」不是蒲公英就是风车菊。"
        },
        {
          "role": "昆恩",
          "text": "这两种花各有历史，你到处问问就知道了！反而是塞西莉亚花，我、我可从没听过啊。"
        },
        {
          "role": "贝雅特丽奇",
          "text": "你说什么！"
        },
        {
          "role": "昆恩",
          "text": "实话实说而已嘛，别瞪我呀…"
        },
        {
          "role": "贝雅特丽奇",
          "text": "你！哼，算了，不跟你说了。"
        },
        {
          "role": "昆恩",
          "text": "哎？贝雅？贝雅！"
        },
        {
          "role": "昆恩",
          "text": "奇怪，怎么生气了…"
        },
        {
          "role": "昆恩",
          "text": "我说错什么了？大家关于「风之花」的认识，就是这样的呀…"
        },
        {
          "role": "派蒙",
          "text": "呃…呃…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抱歉，我也不明白。",
              "dialogues": []
            },
            {
              "text": "我是新来的，不了解本地风俗。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芙萝拉",
          "text": "呼呼，不要吵架，不要吵架哦。"
        },
        {
          "role": "昆恩",
          "text": "要不，一会儿收摊我去找她道个歉吧，唉…"
        },
        {
          "role": "昆恩",
          "text": "虽然没明白她为什么生气，却接受了该道歉的事实。也许这就是生活吧。"
        },
        {
          "role": "芙萝拉",
          "text": "瞧他们俩的模样，可真有节日氛围呢。"
        },
        {
          "role": "芙萝拉",
          "text": "毕竟风花节，是属于自由、风之神与情人的节日呀。"
        },
        {
          "role": "派蒙",
          "text": "啊哈…是这样啊…"
        },
        {
          "role": "派蒙",
          "text": "可你们连「风之花」是什么都无法达成统一呢。"
        },
        {
          "role": "芙萝拉",
          "text": "说得也是。但你不觉得，这才是蒙德人吗？"
        },
        {
          "role": "芙萝拉",
          "text": "美食美酒，还有鲜花，旅行者，希望你也能在这次庆典中获得快乐。"
        },
        {
          "role": "派蒙",
          "text": "听起来是个非常开心的节日呀，虽然对于所谓的「风之花」还有不少疑问…"
        },
        {
          "role": "派蒙",
          "text": "我们四处走走，多观察一下吧。"
        },
        {
          "type": "subtitle",
          "text": "前往蒙德广场"
        },
        {
          "role": "派蒙",
          "text": "啊！是卖唱的！"
        },
        {
          "type": "subtitle",
          "text": "与温迪对话"
        },
        {
          "role": "派蒙",
          "text": "卖唱的，你在干什么呀？周围居然围了这么多人！"
        },
        {
          "role": "温迪",
          "text": "呀，来得正好。看看我的众多学生，怎么样？厉害吧？"
        },
        {
          "role": "派蒙",
          "text": "学生？唔…？"
        },
        {
          "role": "派蒙",
          "text": "你是说那些正在抓耳挠腮的人吗？"
        },
        {
          "role": "温迪",
          "text": "怎么能说是抓耳挠腮呢？人家正在积极开动脑筋构思爱的辞藻啊~"
        },
        {
          "role": "派蒙",
          "text": "根本不明白，只觉得很可疑…"
        },
        {
          "role": "温迪",
          "text": "哈哈，你们应该已经听说风花节的事了吧？"
        },
        {
          "role": "温迪",
          "text": "像这样沉浸在节日氛围中的蒙德，你们喜欢吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很热闹，很让人开心。",
              "dialogues": []
            },
            {
              "text": "还不太明白节日该怎么过。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "派蒙，你呢？"
        },
        {
          "role": "派蒙",
          "text": "要是你用好吃的东西贿赂我，我就回答喜欢！"
        },
        {
          "role": "温迪",
          "text": "唔，那就是喜欢吧。说起来，最近你们似乎无事可做呀？"
        },
        {
          "role": "温迪",
          "text": "大白天到处闲逛，既没有委托，也没有可以帮助的人…"
        },
        {
          "role": "温迪",
          "text": "啊哈哈，认识到这一点，你们才算是初步了解风花节哦！"
        },
        {
          "role": "派蒙",
          "text": "什么嘛！很得意的样子！"
        },
        {
          "role": "温迪",
          "text": "风花节不只属于风神，也属于渴望爱情的蒙德人。想要收获爱情的话，节日期间任何事都要亲力亲为。"
        },
        {
          "role": "温迪",
          "text": "不仅如此，也有人借着这个节日完成其他感情诉求。你们接不到委托很正常，这就是风花节的传统。"
        },
        {
          "role": "温迪",
          "text": "不过别担心，有我在，你们绝不会感到寂寞。"
        },
        {
          "role": "温迪",
          "text": "而且，也是时候带领你们深入了解蒙德的人文风俗了。所以来吧，成为我的助手！"
        },
        {
          "role": "派蒙",
          "text": "什么…什么助手？"
        },
        {
          "role": "温迪",
          "text": "啊哈哈哈，看见这些烦恼的居民了吗？"
        },
        {
          "role": "温迪",
          "text": "他们来向我请教爱情妙招，说是要学习写情诗的方法。我当然答应啦，这样就能收取学费了。"
        },
        {
          "role": "温迪",
          "text": "稍后，他们会来向我倾诉感情上的烦恼。而我会根据他们的立场和困境，提供建议。"
        },
        {
          "role": "温迪",
          "text": "本来这些是我的工作，但…看你闲得难受，就交给你了。"
        },
        {
          "role": "温迪",
          "text": "你走过那么多地方，见多识广，这些经验千万不能浪费啊，还请帮帮他们吧！"
        },
        {
          "role": "派蒙",
          "text": "把差使人说得这么好听，卖唱的，你很缺钱吗？"
        },
        {
          "role": "温迪",
          "text": "风花节有限量的新酒，我得攒些钱才能加入狂欢购物啊。"
        },
        {
          "role": "派蒙",
          "text": "唔唔唔…酒鬼…"
        },
        {
          "role": "温迪",
          "text": "那么，开始吧。当然啦，我也会陪着你的。"
        },
        {
          "role": "温迪",
          "text": "我会在一旁提示你，你可以根据我的提示给出建议。哈哈，是不是简单又轻松？"
        },
        {
          "role": "派蒙",
          "text": "真是自说自话的家伙呀！"
        },
        {
          "role": "温迪",
          "text": "别这么说嘛，你可是蒙德人民最信任的荣誉骑士，给你一点表现的机会也是理所应当。"
        },
        {
          "type": "subtitle",
          "text": "再说一遍",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "温迪",
          "text": "听好了，如果看见我做这个动作，就代表我支持对方继续进取，博得先机。"
        },
        {
          "role": "温迪",
          "text": "而做这个动作，代表我认为对方应该保持现状，不要太过心急。"
        },
        {
          "role": "温迪",
          "text": "至于这个动作，代表我认为对方应该趁早放弃，减少不必要的情感投入。"
        },
        {
          "role": "温迪",
          "text": "旅行者，你记住了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能再说一遍吗？",
              "dialogues": [
                {
                  "role": "温迪",
                  "text": "好，这回你要听仔细了。"
                },
                {
                  "type": "subtitle",
                  "text": "再说一遍↑",
                  "narration": true,
                  "color": "描述"
                }
              ]
            },
            {
              "text": "都记住了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "温迪",
          "text": "那就这么说定喽！"
        },
        {
          "type": "subtitle",
          "text": "倾听并解决蒙德居民的烦恼"
        },
        {
          "role": "派蒙",
          "text": "听说你向那边的吟游诗人寻求帮助？我们是他的助手，说出你的烦恼吧！"
        },
        {
          "role": "玛文",
          "text": "咦？！我、我好不容易才做好心理准备说给诗人先生听的，突然换人…"
        },
        {
          "role": "派蒙",
          "text": "别害羞呀，不论向谁求助，最终你都要把话说给你心中的那个人听，不是吗？"
        },
        {
          "role": "派蒙",
          "text": "大胆一点，说出来就对啦！"
        },
        {
          "role": "玛文",
          "text": "也是呢。其实…其实，我有喜欢的人。"
        },
        {
          "role": "玛文",
          "text": "她叫玛拉，既可爱又勤劳，一有时间就帮着家中务农。有时太累了，还会直接在路边的长椅上打瞌睡。"
        },
        {
          "role": "派蒙",
          "text": "是城里哪家的姑娘？"
        },
        {
          "role": "玛文",
          "text": "不不，她住在清泉镇，离我有一定距离。而且，由于我家人的原因…"
        },
        {
          "role": "玛文",
          "text": "总、总之…因为我们两家背景相差较大，父亲一直反对我们在一起。"
        },
        {
          "role": "玛文",
          "text": "不过我和玛拉说好的！想见面的时候，就一起到摘星崖去看星星。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，听起来发展得很好呀。"
        },
        {
          "role": "玛文",
          "text": "是的，所以我想商量的…比起玛拉，更多是关于我父亲。"
        },
        {
          "role": "玛文",
          "text": "父亲比较保守，又很严格。但也怪我，从未好好地向他说出真心话。"
        },
        {
          "role": "玛文",
          "text": "我…我在想，如果我借着这次机会向父亲献上「风之花」并正式征求他的同意，他会不会支持我们呢？"
        },
        {
          "role": "派蒙",
          "text": "你打算怎么说？"
        },
        {
          "role": "玛文",
          "text": "我想告诉他，虽然玛拉家不富裕，可她善良的心与勤劳的双手是多少钱也买不来的好东西！"
        },
        {
          "role": "玛文",
          "text": "会不会太幼稚了…我、我怕他骂我，呜呜…"
        },
        {
          "role": "派蒙",
          "text": "哎呀…"
        },
        {
          "role": "温迪",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我支持你，勇敢地进取吧。",
              "dialogues": [
                {
