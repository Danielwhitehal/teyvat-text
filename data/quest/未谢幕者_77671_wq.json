{
  "quest_id": 77671,
  "chapter_num": null,
  "chapter_title": "未谢幕者",
  "type": "wq",
  "route": "One Yet to Take a Bow",
  "stories": [
    {
      "story_id": 77671,
      "title": "未谢幕者",
      "description": "听说凌晨的科洛列夫茨基剧院时不时会传出诡异的琴声，还有人还看到幽灵的影子在墙上跳舞…",
      "dialogues": [
        
        {
          "role": "旅行者",
          "text": "（科洛列夫茨基剧院还真是热闹…看来歌舞艺术在这边真的很受欢迎。）"
        },
        {
          "role": "雅朵娃",
          "text": "…不会吧！幽灵？好吓人！"
        },
        {
          "role": "旅行者",
          "text": "（嗯？那边在聊什么？）"
        },
        {
          "role": "塔伊希娅",
          "text": "真的真的！好多人都在说这事，一到凌晨剧院里就会传出诡异的琴声，有人还看到幽灵的影子在墙上跳舞！"
        },
        {
          "role": "旅行者",
          "text": "（幽灵？在剧院里？）"
        },
        {
          "role": "旅行者",
          "text": "（幽灵？可剧院地脉异常的问题不是已经解决了吗？还是说…）"
        },
        {
          "role": "雅朵娃",
          "text": "别又是骗人的流言吧？"
        },
        {
          "role": "塔伊希娅",
          "text": "可我昨晚真的听见了！那声音很瘆人，我都不知道要怎么跟你形容…"
        },
        {
          "role": "旅行者",
          "text": "（有些在意…等凌晨再来看看吧。）"
        },
        {
          "type": "subtitle",
          "text": "夜探科洛列夫茨基剧院"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "（别说，这里的灯全部熄灭之后，剧院里还真有些阴森…是太空旷的缘故吗？）"
        },
        {
          "role": "旅行者",
          "text": "…！什么声音？"
        },
        {
          "role": "旅行者",
          "text": "（只是风啊…是谁没关好窗户吗？）"
        },
        {
          "role": "旅行者",
          "text": "…？"
        },
        {
          "role": "旅行者",
          "text": "（真的是…琴声？但…怎么听起来这么让人不舒服…）"
        },
        {
          "role": "旅行者",
          "text": "…！"
        },
        {
          "role": "奥黛塔",
          "text": "…是谁？"
        },
        {
          "role": "旅行者",
          "text": "（这声音？是从哪里？！）"
        },
        {
          "role": "奥黛塔",
          "text": "…是你？"
        },
        {
          "role": "旅行者",
          "text": "奥…奥黛塔？"
        },
        {
          "role": "奥黛塔",
          "text": "是我。"
        },
        {
          "role": "奥黛塔",
          "text": "在期待什么？幽灵吗？"
        },
        {
          "role": "旅行者",
          "text": "…原来你知道传言。"
        },
        {
          "role": "奥黛塔",
          "text": "知道。诡异的琴声和跳舞的幽灵。"
        },
        {
          "role": "奥黛塔",
          "text": "喏，这就是「幽灵」的真身。"
        },
        {
          "role": "旅行者",
          "text": "（这是个…摆件？装饰？）"
        },
        {
          "role": "奥黛塔",
          "text": "看样子你好像不认识这东西。这是个音乐盒，小时候母亲送我的生日礼物。"
        },
        {
          "role": "奥黛塔",
          "text": "它原本能奏出好听的琴音，但时间一久，内部结构老化，就变成了…"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "奥黛塔",
          "text": "很难听吧？"
        },
        {
          "role": "奥黛塔",
          "text": "要彻底修好它得花些时间。但…我平时白天的日程很忙，家里又没有合适的工具，所以只能半夜偷偷跑到休息室…"
        },
        {
          "role": "旅行者",
          "text": "（难道说她就是从那扇没关好的窗户溜进来的…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你刚才说…",
            "休息室？"
          ]
        },
        {
          "role": "奥黛塔",
          "text": "嗯，这里就是我的休息室。不像吗？"
        },
        {
          "role": "旅行者",
          "text": "（比我想象中更冷清呢…看来她真把精力都用在了舞蹈上…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "抱歉…",
            "我不该擅自闯进来…"
          ]
        },
        {
          "role": "奥黛塔",
          "text": "没事，我们都一样。不应该这个时间出现在这里。"
        },
        {
          "role": "奥黛塔",
          "text": "不过，一般人在听到琴声，或是看到「幽灵」的时候就已经逃走了。你胆子还挺大。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "关于音乐盒…",
            "我能帮上什么忙吗？"
          ]
        },
        {
          "role": "奥黛塔",
          "text": "…早就听说你很热心。原来传闻不假。"
        },
        {
          "role": "奥黛塔",
          "text": "但不用了，谢谢。这是我自己的东西，我想自己修好它。"
        },
        {
          "role": "奥黛塔",
          "text": "……"
        },
        {
          "role": "奥黛塔",
          "text": "…不过，如果能随便帮我收集一些合适的材料，并为我保守这个秘密的话，我会很感激。"
        },
        {
          "role": "旅行者",
          "text": "放心交给我。"
        },
        {
          "role": "奥黛塔",
          "text": "另外…我看你好像对我休息室的装饰不太满意。要是你想按你的想法装点一下的话，我也没有意见。"
        },
        {
          "role": "奥黛塔",
          "text": "就当是为我保守秘密的…奖励？"
        },
        {
          "role": "旅行者",
          "text": "（…奖励？）"
        },
        {
          "role": "奥黛塔",
          "text": "不对吗？沃雅妮莎说，粉丝们挤破头皮都想要进演员们的休息室看一眼。"
        },
        {
          "role": "奥黛塔",
          "text": "哦，不过，在修好音乐盒之前，能辛苦你忍一忍吗？暂时不要装饰休息室。"
        },
        {
          "role": "旅行者",
          "text": "…为什么？"
        },
        {
          "role": "奥黛塔",
          "text": "这样能吓跑那些不速之客。很清净。"
        },
        {
          "role": "旅行者",
          "text": "在那之后，奥黛塔花了不少时间，将音乐盒修好了大半…"
        }
      ]
    }
  ]
}