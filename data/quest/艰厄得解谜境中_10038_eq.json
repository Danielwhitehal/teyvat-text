{
  "quest_id": 10038,
  "chapter_num": "谜境悬兵 其一",
  "chapter_title": "艰厄得解谜境中",
  "type": "eq",
  "route": "A Tricky Situation",
  "stories": [
    {
      "story_id": 40020,
      "title": "艰厄得解谜境中",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "稻妻的局势已趋于稳定，但你和派蒙并没有闲下来。你们打算前往冒险家协会，接受新的委托…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往稻妻城内的冒险家协会"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，你来得正好。"
        },
        {
          "role": "凯瑟琳",
          "text": "冒险家协会接到了一件委托，情况稍有些复杂。根据我们的判断，你应该是处理它的最佳人选。"
        },
        {
          "role": "旅行者",
          "text": "能比千手百眼还复杂吗？"
        },
        {
          "role": "凯瑟琳",
          "text": "不愧是你呢，那我就直说了。这次的委托人来自璃月，是一位造型独特的音乐人。"
        },
        {
          "role": "凯瑟琳",
          "text": "她持有一份临时「通行凭证」，不过马上就要到期了，为了不被驱逐，才想请熟悉相关事务的人帮她重新办理。"
        },
        {
          "role": "旅行者",
          "text": "听起来不过如此啊…"
        },
        {
          "role": "派蒙",
          "text": "不要一副很失望的样子行不行！你这是看热闹不嫌事大呀！"
        },
        {
          "role": "派蒙",
          "text": "不过，来自璃月、造型独特的音乐人小姐？好像在哪见过…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：派蒙，记性不行啊。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…啊！我想到了！"
                }
              ]
            },
            {
              "text": "旅行者：是她吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…啊！我想到了！"
                }
              ]
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "嗯？难道是两位的熟人吗？那位小姐在发布委托后，先行前往天领奉行了，你们可以到那里跟她会合。"
        },
        {
          "role": "凯瑟琳",
          "text": "不过听说最近天领奉行事务繁忙，恐怕没空为她解决问题…"
        },
        {
          "role": "派蒙",
          "text": "如果是那个人的话，说不定正在天领奉行门口大肆摇滚呢！"
        },
        {
          "role": "旅行者",
          "text": "也不至于啦。"
        },
        {
          "role": "派蒙",
          "text": "唔…但摇滚本身就很厉害对吧？赶快去看看，否则万一她因为扰乱治安被逮捕就糟了！"
        },
        {
          "type": "subtitle",
          "text": "前往天领奉行府"
        },
        {
          "role": "矢田幸喜",
          "text": "站岗结束后，还要去检查左侧楼道的防备…"
        },
        {
          "role": "矢田幸喜",
          "text": "要是人手再多一点就好了…"
        },
        {
          "role": "派蒙",
          "text": "这个大叔好像很忙，我们还是不要打扰他了吧。"
        },
        {
          "type": "subtitle",
          "text": "与辛焱对话"
        },
        {
          "role": "派蒙",
          "text": "果然是辛焱！哼哼，我的直觉好准。"
        },
        {
          "role": "旅行者",
          "text": "明明刚才还说想不起来…"
        },
        {
          "role": "辛焱",
          "text": "哎？旅行者和派蒙？你们居然也在稻妻？！"
        },
        {
          "role": "辛焱",
          "text": "这可真是他乡遇故知啊，难道你们是来看演出的？那可能要让你们失望了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：演出？",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "唉，说来话长了…"
                }
              ]
            },
            {
              "text": "旅行者：失望？",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "唉，说来话长了…"
                }
              ]
            }
          ]
        },
        {
          "role": "辛焱",
          "text": "你们知道「虹色巡回」吗？不知道也没关系，其实…我也是不久前才听说的。"
        },
        {
          "role": "辛焱",
          "text": "仔细想想，整件事从一开始就很不靠谱啊！"
        },
        {
          "role": "辛焱",
          "text": "主办方说，这场音乐盛典发源于枫丹，在全提瓦特赫赫有名，但没有任何一个璃月人听说过。"
        },
        {
          "role": "辛焱",
          "text": "他就那样站在路边，像叫卖日落果一样…我看他可怜才问他的。"
        },
        {
          "role": "派蒙",
          "text": "怎么说呢…你人真好…"
        },
        {
          "role": "辛焱",
          "text": "不过他给我看了不少资料，「虹色巡回」在枫丹确实是重磅级的音乐盛典。"
        },
        {
          "role": "辛焱",
          "text": "据说只要登上这个舞台，就意味着你的音乐受到大众喜爱。"
        },
        {
          "role": "派蒙",
          "text": "哇，那岂不是能一战成名！"
        },
        {
          "role": "辛焱",
          "text": "对吧？我也是这么想的！我希望更多人了解我的摇滚，所以，我当然要去参加「虹色巡回」啦。"
        },
        {
          "role": "辛焱",
          "text": "香菱还做了加油鼓劲的便当给我！可是…可是那个主办…他们…"
        },
        {
          "role": "辛焱",
          "text": "他们居然半路遭遇海难，没法准时抵达稻妻，还让渔船带话到稻妻，又让稻妻官兵全城通告「虹色巡回」取消了！"
        },
        {
          "role": "辛焱",
          "text": "就这么取消了啊！本来应该参加演出的我居然成了最后一个知情人…不仅领不到主办方申请的「通行凭证」，手里这张临时凭证还马上就要过期了，真是倒了大霉！"
        },
        {
          "role": "派蒙",
          "text": "明明是对演出最热心的一个，却遇到了最大的麻烦…"
        },
        {
          "role": "派蒙",
          "text": "真是好惨啊…"
        },
        {
          "role": "旅行者",
          "text": "是啊。"
        },
        {
          "role": "辛焱",
          "text": "唉…可能这就是音乐人的磨难吧。"
        },
        {
          "role": "辛焱",
          "text": "不过我也不是第一次遇到这种最终没能演出的情况…好了，抱怨就到此为止。不说丧气话！"
        },
        {
          "role": "派蒙",
          "text": "振作得好快？！"
        },
        {
          "role": "辛焱",
          "text": "我可是摇滚乐手，顽强是我们的灵魂！所以，我马上采取行动，双管齐下，一边去冒险家协会托人办事，一边自己来天领奉行打听。"
        },
        {
          "role": "辛焱",
          "text": "不过…我都在这儿站了半天了。天领奉行的那些武士不知道在折腾什么，忙个没停，根本没功夫理我。"
        },
        {
          "role": "派蒙",
          "text": "怎么这样！他们该不会根本就没什么事情可忙，只是在偷懒吧！"
        },
        {
          "role": "辛焱",
          "text": "没事没事啦，出门在外难免如此。旅行者，听北斗姐说你来稻妻有一阵了，应该知道些本地的办事方法吧？能不能帮帮我？"
        },
        {
          "role": "旅行者",
          "text": "好说好说，这个我熟。"
        },
        {
          "role": "辛焱",
          "text": "太好了！办好「通行凭证」后，我就给你写一首热情澎湃的曲子，当做谢礼！"
        },
        {
          "type": "subtitle",
          "text": "与天领奉行府的官员交涉"
        },
        {
          "role": "矢田幸喜",
          "text": "哎？怎么又是你？刚不是说了我们现在很忙，请你稍等一下嘛。"
        },
        {
          "role": "辛焱",
          "text": "大叔稍等啊，我让行家跟你说！"
        },
        {
          "role": "旅行者",
          "text": "请问九条裟罗小姐在吗？"
        },
        {
          "role": "矢田幸喜",
          "text": "九条裟罗大人…哦，你就是大人提过的那位旅行者？"
        },
        {
          "role": "矢田幸喜",
          "text": "这位外国小姐是你的朋友？"
        },
        {
          "role": "派蒙",
          "text": "对呀！她是被人放了鸽子才滞留在境内的，想来延长临时「通行凭证」的许可期，你就给个面子，别刁难外地人啦！"
        },
        {
          "role": "矢田幸喜",
          "text": "各位可能误会了，我们真不是刻意怠慢这位小姐，实在是天领奉行上下都忙，最近出了大事，我们也人手不足啊。"
        },
        {
          "role": "矢田幸喜",
          "text": "这位小姐之所以还在排队等候，不是她来得晚前面人多，而是因为根本没有人能抽空处理「通行凭证」之类的小事。"
        },
        {
          "role": "派蒙",
          "text": "小事…大事？"
        },
        {
          "role": "矢田幸喜",
          "text": "唉，以我的立场不便透露太多。九条裟罗大人就在院内，几位还请亲自问问她。就让大人来决定要不要把事情告知你们吧。"
        },
        {
          "role": "旅行者",
          "text": "看来也只能这样了。"
        },
        {
          "role": "派蒙",
          "text": "原来他们真的很忙啊…"
        },
        {
          "role": "辛焱",
          "text": "没关系！大叔一个当差的也不容易啊，我能明白的。"
        },
        {
          "type": "subtitle",
          "text": "进入天领奉行府"
        },
        {
          "role": "矢田幸喜",
          "text": "九条裟罗大人就在院内，几位还请亲自问问她吧。"
        },
        {
          "type": "subtitle",
          "text": "与九条裟罗对话"
        },
        {
          "role": "九条裟罗",
          "text": "诸君，列阵！跟随先头部队到城外集结！"
        },
        {
          "role": "九条裟罗",
          "text": "哦？旅行者？还有这几位，有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "抱歉打扰你工作了。"
        },
        {
          "role": "九条裟罗",
          "text": "无妨。你们突然造访天领奉行府，莫非是遇上麻烦了？"
        },
        {
          "role": "九条裟罗",
          "text": "有什么需要我帮忙的，请讲。"
        },
        {
          "role": "派蒙",
          "text": "太好了，总算是来了个能拍板的人！"
        },
        {
          "role": "九条裟罗",
          "text": "原来是这样。你的这位朋友难得来稻妻演出，却遇上了这种事，令人遗憾。"
        },
        {
          "role": "九条裟罗",
          "text": "天领奉行最近人事变动频繁，又遭遇了棘手情况，人手实在不足。没能及时注意到你朋友的诉求，是我们这边的问题。抱歉。"
        },
        {
          "role": "派蒙",
          "text": "很少见到你们乱成这样，是出什么大事了吗？"
        },
        {
          "role": "九条裟罗",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "我们没有刺探机密的意思。"
        },
        {
          "role": "派蒙",
          "text": "对对！我们就是随便问问…"
        },
        {
          "role": "辛焱",
          "text": "原来有这么大的情况在…你别在意，是我来得不是时候。"
        },
        {
          "role": "旅行者",
          "text": "或者我们打个商量好吗？"
        },
        {
          "role": "派蒙",
          "text": "对啊！要不然这样，你告诉我们出了什么麻烦，能帮的忙我们一定帮，作为交换，你就帮辛焱把「通行凭证」续期，怎么样？"
        },
        {
          "role": "九条裟罗",
          "text": "…眼下各方面人手稀缺，如果是你们这种实力的帮手…"
        },
        {
          "role": "九条裟罗",
          "text": "我明白了。事情是这样的，近期，荒海地区突然出现了一座无名秘境，力量骇人的魔物正在从中源源不断地涌出。"
        },
        {
          "role": "派蒙",
          "text": "天领奉行应该很擅长对付魔物吧？"
        },
        {
          "role": "九条裟罗",
          "text": "秘境是计划外的压力，我已派出斥候前往调查。"
        },
        {
          "role": "九条裟罗",
          "text": "原本我想亲自带队赶往事发地，但要是在前线停留太久，天领奉行府就会遭遇无人监守的局面…怎么想都有些不妥。"
        },
        {
          "role": "辛焱",
          "text": "你缺的是战力，那我们来帮忙，应该可以吧！对吗，旅行者？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：我也认为这是上策。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对，我们帮你一个忙，你也帮我们一个忙，多好呀！"
                }
              ]
            },
            {
              "text": "旅行者：我们的实力有保证。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对，我们帮你一个忙，你也帮我们一个忙，多好呀！"
                }
              ]
            }
          ]
        },
        {
          "role": "辛焱",
          "text": "呃…这么说会不会有些太势利了…"
        },
        {
          "role": "九条裟罗",
          "text": "不，非常感谢各位。如你所说，这的确是眼下最好的处理办法。"
        },
        {
          "role": "九条裟罗",
          "text": "如果换作别人，我一定不会答应这个要求。但就连稻妻的至高之神——将军大人，也已认可旅行者的实力，交给你们，我很放心。"
        },
        {
          "role": "辛焱",
          "text": "我说，你好像在稻妻干了一些不得了的事啊…"
        },
        {
          "role": "辛焱",
          "text": "也是。之前就听香菱他们说过，你是个干大事的人…"
        },
        {
          "role": "辛焱",
          "text": "九条裟罗小姐，请问我们接下来应该去哪里？"
        },
        {
          "role": "九条裟罗",
          "text": "我马上带各位前往事发地点。但因为我还没来得及前往现场，安全性方面恐怕无法准确预估…"
        },
        {
          "role": "九条裟罗",
          "text": "保险起见，请各位随身携带足够多的战斗装备和后勤物资。"
        },
        {
          "role": "派蒙",
          "text": "要是能报销就好了！"
        },
        {
          "role": "九条裟罗",
          "text": "说得对，那我即刻向府内申请…"
        },
        {
          "role": "辛焱",
          "text": "等一下！我记得办「通行凭证」要交一定费用吧？就用那个抵吧，我们这边的开支交给我。"
        },
        {
          "role": "旅行者",
          "text": "辛焱好大方！"
        },
        {
          "role": "辛焱",
          "text": "也不是，其实…下船前北斗姐给了我一袋钱让我花销，我存着也是存着，而且…嘿嘿，都这么麻烦你们几位了，总得有点表示。"
        },
        {
          "role": "辛焱",
          "text": "袋子里的钱我们几个分了吧！就当准备军饷了。"
        },
        {
          "role": "九条裟罗",
          "text": "您…真是一位善解人意的贤良之人。"
        },
        {
          "role": "辛焱",
          "text": "小事小事，别客气，就是…我那个证…"
        },
        {
          "role": "九条裟罗",
          "text": "稍后我会亲自跟进这件事，请放心。"
        },
        {
          "role": "辛焱",
          "text": "好好好，那就谢谢了！"
        },
        {
          "role": "派蒙",
          "text": "谈妥啦，那我们一起前去镇压秘境吧！"
        },
        {
          "role": "辛焱",
          "text": "走吧！我也去开开眼，就当旅游了！"
        },
        {
          "type": "subtitle",
          "text": "前往秘境一带，调查情况"
        },
        {
          "type": "subtitle",
          "text": "查看伤兵的情况"
        },
        {
          "role": "渡部",
          "text": "九条裟罗大人，您总算来了！"
        },
        {
          "role": "渡部",
          "text": "我们刚到秘境入口展开调查，就遭遇了魔物的袭击。"
        },
        {
          "role": "渡部",
          "text": "虽然我们全力将大部分魔物打回了秘境内，但…还是有个别漏网之鱼向东南方逃走了。"
        },
        {
          "role": "渡部",
          "text": "不少同伴受了伤，我擅自判断应当优先安置伤员，就没能继续追击它们。实在是非常抱歉！"
        },
        {
          "role": "九条裟罗",
          "text": "东南方向？糟了，沿途一定还有普通人…"
        },
        {
          "role": "九条裟罗",
          "text": "各位，情况紧急，我们暂且兵分两路。我带兵追击逃走的魔物，这里就交给各位了。"
        },
        {
          "role": "九条裟罗",
          "text": "这么说或许有些多余，但请务必注意安全。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：请放心。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你就放心去吧，我们有经验啦！"
                }
              ]
            },
            {
              "text": "旅行者：我们是专业的。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你就放心去吧，我们有经验啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "渡部",
          "text": "啊…对了！秘境里时不时会有魔物偷跑出来，几位千万要守住大门，不要放跑它们，否则…"
        },
        {
          "role": "九条裟罗",
          "text": "渡部！相信我的判断！"
        },
        {
          "role": "渡部",
          "text": "是、是的！九条裟罗大人！"
        },
        {
          "role": "派蒙",
          "text": "走掉了呢。"
        },
        {
          "role": "辛焱",
          "text": "真是个雷厉风行的人啊。"
        },
        {
          "role": "派蒙",
          "text": "她也算是部队的领袖，难免如此啦。"
        },
        {
          "role": "派蒙",
          "text": "那我们也赶快去守住秘境的大门吧！"
        },
        {
          "type": "subtitle",
          "text": "前往秘境，守住大门"
        },
        {
          "role": "渡部",
          "text": "必须赶快救助伤员，稳住阵脚…"
        },
        {
          "role": "渡部",
          "text": "无论如何，天领奉行一定要控制事态！"
        },
        {
          "role": "派蒙",
          "text": "虽然现在的情况不妙，但他并没有受到打击呢，真是个意志坚强的武士！"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "type": "subtitle",
          "text": "调查秘境周围的情况"
        },
        {
          "role": "派蒙",
          "text": "一张…小纸片？"
        },
        {
          "role": "派蒙",
          "text": "是个纸人？难道是武士落下的护身符吗？"
        },
        {
          "role": "辛焱",
          "text": "这个纸人…似乎和传说中的「式神」很像。"
        },
        {
          "role": "旅行者",
          "text": "「式神」？"
        },
        {
          "role": "辛焱",
          "text": "对。我为了写歌词，到处寻找创作灵感，了解过不少提瓦特各地的传说。"
        },
        {
          "role": "辛焱",
          "text": "据说稻妻有一种凝聚着符法的剪纸，会跟随主人行动，有些还能斩妖除魔，保佑家门安康。"
        },
        {
          "role": "派蒙",
          "text": "听起来有点像是璃月的符箓啊仙术什么的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：听起来比派蒙能打…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这是什么话呀！我明明是专业的提瓦特向导，还是你最好的朋友，你居然要拿我的战斗力开涮！"
                }
              ]
            },
            {
              "text": "旅行者：听起来比五分之一野猪能打…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这是什么话呀！我明明是专业的提瓦特向导，还是你最好的朋友，你居然要拿我的战斗力开涮！"
                }
              ]
            }
          ]
        },
        {
          "role": "辛焱",
          "text": "等等！你们看，这个「式神」…它、它是动了吗？"
        },
        {
          "role": "派蒙",
          "text": "小纸片，这位小纸片！听得到吗？你会不会说话？能沟通吗？"
        },
        {
          "role": "「式大将」",
          "text": "这里是…啊！我昏倒了？"
        },
        {
          "role": "「式大将」",
          "text": "糟糕…我是…噢，对了！你们有没有看到那些出逃的魔物，它们去哪了？"
        },
        {
          "role": "辛焱",
          "text": "刚才有些魔物在这附近活动，它们都被我们干掉了。"
        },
        {
          "role": "「式大将」",
          "text": "呼…谢谢你们，还好没有放跑它们…万一有伤亡，我会非常过意不去…"
        },
        {
          "role": "派蒙",
          "text": "你是「式神」吗？那些怪物，该不会是你放出去的吧？"
        },
        {
          "role": "辛焱",
          "text": "但据我所知，「式神」都是用来驱邪除魔的才对，你又是什么情况？"
        },
        {
          "role": "「式大将」",
          "text": "我叫「式大将」，非常抱歉，第一次见面就让各位看到我如此不成熟的一面。"
        },
        {
          "role": "「式大将」",
          "text": "各位所在的这处秘境，名叫「诀箓阴阳寮」，我是这里的「寮司」，主管寮内一切事务。"
        },
        {
          "role": "「式大将」",
          "text": "「诀箓阴阳寮」与我一同沉睡多年，但就在几天前，这座秘境不知受到何种力量的影响，竟然、竟然擅自让魔物复苏，还打开了大门…"
        },
        {
          "role": "「式大将」",
          "text": "其实…我好像失去了一部分记忆，只记得自己一醒来就面对着如同噩梦的景象，下意识想要阻止它们。"
        },
        {
          "role": "「式大将」",
          "text": "没想到那些魔物一被击败就会变成符纸。看见那些符纸，我才想起来，它们应该和我一样属于这座阴阳寮…是「阴阳术」的造物。"
        },
        {
          "role": "辛焱",
          "text": "「阴阳术」的造物？不太明白你的意思…"
        },
        {
          "role": "「式大将」",
          "text": "抱歉…我暂时还不能给出明确的解释…"
        },
        {
          "role": "旅行者",
          "text": "你又是怎样的存在？"
        },
        {
          "role": "「式大将」",
          "text": "我…我…非常抱歉！身为「式神」，我只知道自己是「寮司」，却连主人是谁、被创造出来的目的是什么都想不起来，我这是何等失态啊！"
        },
        {
          "role": "派蒙",
          "text": "也就是说，你根本不知道自己是好人还是坏人？"
        },
        {
          "role": "派蒙",
          "text": "不过没关系呀，一般失忆患者回到熟悉的地方就有可能想起些什么。要不，你回秘境里看看吧？"
        },
        {
          "role": "「式大将」",
          "text": "是的，我正准备回到阴阳寮中。"
        },
        {
          "role": "「式大将」",
          "text": "虽然对自身还有许多疑问，但我能感觉到，我的力量与这座秘境同源…或许不需要怀疑，与它就是一体的。"
        },
        {
          "role": "「式大将」",
          "text": "我…应该能完全控制它！不知为何，我总是有这样的想法…"
        },
        {
          "role": "派蒙",
          "text": "大家都说「式神」是驱邪斩魔的帮手，那说不定你就是被放在这里镇守大门的呀！"
        },
        {
          "role": "派蒙",
          "text": "书里常有那种故事吧？失去记忆的人，忘了自己以前拥有过强大力量，一旦想起来，立刻就变得天下无敌啦！"
        },
        {
          "role": "「式大将」",
          "text": "实不相瞒，我也有这种念头。可以的话，各位能不能助我一臂之力呢？"
        },
        {
          "role": "派蒙",
          "text": "所以当务之急是要帮你找回记忆对吧？找回了记忆，你也许就能重新控制秘境，不再让魔物出逃了。"
        },
        {
          "role": "辛焱",
          "text": "旅行者，过来一下！"
        },
        {
          "role": "辛焱",
          "text": "这个「式大将」刚刚醒来，还失忆了…你相信它说的话吗？"
        },
        {
          "role": "旅行者",
          "text": "…很难判断。"
        },
        {
          "role": "辛焱",
          "text": "假如它真是这座秘境的守门人，那就是我们的同伴。但…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：不排除有相反的可能。",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "…嗯，对。害人之心不可有，防人之心不可无。"
                }
              ]
            },
            {
              "text": "旅行者：万一它是为了制造魔物。",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "…嗯，对。害人之心不可有，防人之心不可无。"
                }
              ]
            }
          ]
        },
        {
          "role": "辛焱",
          "text": "再说，究竟是谁建造了这座秘境，秘境里又为何有这么多魔物…对于这个地方，我们还需要深入了解。"
        },
        {
          "role": "辛焱",
          "text": "倒是派蒙，好像很相信对方呢，看来是有着澄澈剔透的童心啊。"
        },
        {
          "role": "旅行者",
          "text": "派蒙对可爱的纸片有好感。"
        },
        {
          "role": "辛焱",
          "text": "派蒙，稍等一下。我认为搞清状况之前不该贸然行动。"
        },
        {
          "role": "「式大将」",
          "text": "嗯…我能理解。毕竟我失去了记忆，又跟这座阴阳寮有着千丝万缕的联系，你们对我有所顾虑也很正常。"
        },
        {
          "role": "辛焱",
          "text": "不如让我来验证一下你的真心吧。"
        },
        {
          "role": "派蒙",
          "text": "真心？听起来有什么不得了的事要发生了…！"
        },
        {
          "role": "辛焱",
          "text": "或许你们不信，但我们热衷音乐的人，能够使用一种肉眼无法看见的特殊语言。这种语言同样作用在你们身上，它将以音乐为媒介来传递。"
        },
        {
          "role": "旅行者",
          "text": "原来如此，我明白了。"
        },
        {
          "role": "派蒙",
          "text": "什么语言？也说给我听听啊！"
        },
        {
          "role": "辛焱",
          "text": "这种语言非常诚实，只会触动人心底最真诚的部分。接下来，我会借这种语言进行一次「测试」，来判断「式大将」是否值得信赖。"
        },
        {
          "role": "「式大将」",
          "text": "音乐？我对此并无研究…但如果各位需要考验，那不论是怎样的「测试」我都愿意接受。我只希望能解决眼前的危机。"
        },
        {
          "role": "辛焱",
          "text": "那就听好了，瞧好了！"
        },
        {
          "role": "辛焱",
          "text": "如何？被我的音乐震撼了吧？"
        },
        {
          "role": "旅行者",
          "text": "虽然演奏的手法很精彩…"
        },
        {
          "role": "派蒙",
          "text": "但你只是弹奏了一首曲子而已，这也能叫「测试」吗？"
        },
        {
          "role": "辛焱",
          "text": "刚才我说的那种语言就藏在我的乐曲中。你们看不到它，但它会进入你们的心中…引发你们的思考。"
        },
        {
          "role": "辛焱",
          "text": "不同的灵魂会对这种语言作出不同反应。只要告诉我答案，我就能判断你们的灵魂是什么颜色！"
        },
        {
          "role": "派蒙",
          "text": "哎？真的这么厉害吗？！"
        },
        {
          "role": "辛焱",
          "text": "善良的心，因命运捉弄而被迫作恶的心，还有习惯了不幸、早已封闭起来的心…相信我，这是三种不同的颜色。"
        },
        {
          "role": "辛焱",
          "text": "来吧，「式大将」。告诉我，你从我的音乐中感觉到了什么？"
        },
        {
          "role": "「式大将」",
          "text": "抱歉，我…不太明白。"
        },
        {
          "role": "「式大将」",
          "text": "我从没听过这种风格的乐曲，无法理解暗藏其中的奥妙…"
        },
        {
          "role": "「式大将」",
          "text": "可是，我的躯体，我的灵魂…假如我有灵魂，一定已经被这种旋律带动起来了。我能看到你所描绘的世界。"
        },
        {
          "role": "旅行者",
          "text": "世界？"
        },
        {
          "role": "「式大将」",
          "text": "我不知该怎么说…我像是漫无目的地走在路上，四周都是大雾，我还受伤了…头很痛。"
        },
        {
          "role": "「式大将」",
          "text": "四周迷雾笼罩，雾中不时传来窸窸窣窣的声音，我有些担忧，生怕危险将我吞没，可也没有别的办法，只能继续前进。"
        },
        {
          "role": "「式大将」",
          "text": "没人告诉我终点是哪里，但我总觉得，有人在终点等着我…"
        },
        {
          "role": "旅行者",
          "text": "真是细致。"
        },
        {
          "role": "派蒙",
          "text": "呜哇…一张纸片，居然能感受到这么多内容，岂不是显得我很失败？我只能想到许多人围在一起烤鱼什么的…"
        },
        {
          "role": "「式大将」",
          "text": "烤鱼！其实，我也隐约看到了那样的场面…我和看不清脸孔的人一起烤鱼。"
        },
        {
          "role": "「式大将」",
          "text": "那片迷雾的尽头是一片篝火，人们围坐在火边，用竹签串起新捕捞上来的河鱼…我成了一个普通人，和他们一起享用晚餐。"
        },
        {
          "role": "「式大将」",
          "text": "…总觉得，等翌日太阳升起，我还会离开这堆火继续走下去。"
        },
        {
          "role": "辛焱",
          "text": "无尽的旅途…没有战斗吗？"
        },
        {
          "role": "辛焱",
          "text": "你听着我的旋律，居然不会联想到战斗…有点意思！"
        },
        {
          "role": "「式大将」",
          "text": "嗯？应该要联想到战斗吗？"
        },
        {
          "role": "辛焱",
          "text": "不，不用。我认为你答得很好。之前请几位朋友试听过这首曲子。说实话…你的答案，居然跟她们差不多。"
        },
        {
          "role": "辛焱",
          "text": "明明有着丰富的层次和陡变的转折点，你却坚持了这样一种想象，或许我可以认为…你的思维与我那些朋友很接近。"
        },
        {
          "role": "辛焱",
          "text": "哈哈，没错，就是她们！"
        },
        {
          "role": "辛焱",
          "text": "所谓志同道合，对吧！就冲着这个答案，我信任「式大将」的为人。"
        },
        {
          "role": "「式大将」",
          "text": "…真的可以吗？我只是随口说了一些感受而已，没想到你会如此果断地选择信任我。"
        },
        {
          "role": "辛焱",
          "text": "一看你就不懂行啦！我啊，最信任的就是乐曲中的语言。你就当是它告诉我你值得信任好了。"
        },
        {
          "role": "辛焱",
          "text": "音乐没有依据，它就是自由本身。「式大将」，你能从千万种想象里选中这条征途，我想，你和我们之间或许有着缘分。"
        },
        {
          "role": "「式大将」",
          "text": "非常感谢，辛焱小姐！"
        },
        {
          "role": "辛焱",
          "text": "别客气，我信任你，本质上是相信自己的乐感，相信以乐会友。你就当是我的一点小傲慢好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：我姑且保留意见。",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "是啊，这只是我的个人判断，旅行者你有你的标准。反正之后我们都会一起行动，你就当卖我个面子，带上「式大将」吧。"
                }
              ]
            },
            {
              "text": "旅行者：我也相信辛焱的判断。",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "对吧？哈哈哈哈，你也是个音乐品味很好的人啊，到底是我的朋友！"
                }
              ]
            }
          ]
        },
        {
          "role": "「式大将」",
          "text": "各位！这份恩情我、我一定会牢记于心！只要能找回记忆，我就应该能为大家做些什么了…"
        },
        {
          "role": "辛焱",
          "text": "好了好了，也不是图你什么才帮你的啦，放轻松，眼下最重要的是调整好状态。"
        },
        {
          "role": "辛焱",
          "text": "旅行者，那我们做好战斗准备，到秘境里一探究竟吧！"
        },
        {
          "role": "辛焱",
          "text": "在九条裟罗小姐回来前解决问题的话，一切就能顺利收场了。"
        },
        {
          "role": "旅行者",
          "text": "那就出发吧。"
        },
        {
          "role": "派蒙",
          "text": "对我们这种级别的冒险家来说，无论怎样的秘境都只是小菜一碟哦！"
        },
        {
          "type": "subtitle",
          "text": "进入「诀箓阴阳寮」"
        },
        {
          "type": "subtitle",
          "text": "与「式大将」对话"
        },
        {
          "role": "辛焱",
          "text": "奇怪，这座「诀箓阴阳寮」里似乎没有什么特别之处？"
        },
        {
          "role": "「式大将」",
          "text": "看起来是这样没错，但我能隐约感觉到法力在恢复…呼，舒服些了。"
        },
        {
          "role": "派蒙",
          "text": "等等！喂你们看，那边、那边…不会是有个人在吧？"
        },
        {
          "role": "「式大将」",
          "text": "秘境内有人？这…有些不可思议啊，一般人不会贸然闯入这种秘境才对…"
        },
        {
          "role": "旅行者",
          "text": "那个轮廓有些熟悉…"
        },
        {
          "role": "公子",
          "text": "哦？还以为是谁，原来是…"
        },
        {
          "role": "旅行者",
          "text": "这个声音是…！"
        },
        {
          "role": "公子",
          "text": "刚才听见脚步声我还在想，什么样的人才敢闯进如此危险的秘境。"
        },
        {
          "role": "派蒙",
          "text": "啊！是你！"
        },
        {
          "role": "公子",
          "text": "没想到…哈哈，听见你的声音，我就明白了。"
        },
        {
          "role": "公子",
          "text": "好久不见，旅行者，你的胆子更大了。"
        },
        {
          "role": "派蒙",
          "text": "「公子」！你怎么会在这里？"
        },
        {
          "role": "派蒙",
          "text": "难道…难道这座秘境是你们搞的鬼！"
        },
        {
          "role": "辛焱",
          "text": "什么…谁？公…子？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：这位是「公子」。",
              "dialogues": [
                {
                  "role": "公子",
                  "text": "你好你好，叫我达达利亚就行。我是…"
                }
              ]
            },
            {
              "text": "旅行者：也可以叫他达达利亚。",
              "dialogues": [
                {
                  "role": "公子",
                  "text": "你好你好，叫我达达利亚就行。我是…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我来说！他出现在这里就说明…接下来可能没好事！"
        },
        {
          "role": "公子",
          "text": "哎哎哎，这么久没见，你就这样说我吗？"
        },
        {
          "role": "派蒙",
          "text": "你、你自己心里清楚！"
        },
        {
          "role": "派蒙",
          "text": "不过，辛焱似乎不知道「公子」跟璃月那些瓜葛…要告诉她吗？呜…总觉得以她的性格，知道了会让现状变得更麻烦吧…"
        },
        {
          "role": "公子",
          "text": "（那个小姑娘…打扮虽然有些特别，但应该是璃月人吧？看来，我得决断要不要说实话了。）"
        },
        {
          "role": "派蒙",
          "text": "唔…不然这样好了！"
        },
        {
          "role": "公子",
          "text": "其实…"
        },
        {
          "role": "派蒙",
          "text": "这个人是我们在蒙德认识的冒险家朋友！「公子」是我们给他起的外号！"
        },
        {
          "role": "公子",
          "text": "哎？"
        },
        {
          "role": "旅行者",
          "text": "哎？"
        },
        {
          "role": "派蒙",
          "text": "这个达达利亚总是把事情搞砸！明明知道情况危险，也会不管不顾地执行下去，对冒险家来说绝对是大忌！所以我们都很忌惮他。"
        },
        {
          "role": "公子",
          "text": "…啊，对！对对，我是个冒险家！之前给旅行者和派蒙添了许多麻烦的那种，抱歉抱歉呀。"
        },
        {
          "role": "旅行者",
          "text": "（好像明白派蒙的想法了。）"
        },
        {
          "role": "辛焱",
          "text": "原来是蒙德人啊。你好，我是辛焱，璃月人，喜欢摇滚！"
        },
        {
          "role": "公子",
          "text": "你好你好，你也是来这座秘境探险的吗？"
        },
        {
          "role": "辛焱",
          "text": "是啊，我们想找出秘境中魔物横行的原因。"
        },
        {
          "role": "辛焱",
          "text": "据这位「式大将」说，这座秘境名叫「诀箓阴阳寮」，里面存在着很多用「阴阳术」制造出来的危险魔物。"
        },
        {
          "role": "公子",
          "text": "外放危险魔物的秘境…究竟是什么来头？"
        },
        {
          "role": "公子",
          "text": "我也是偶然闯入这里，对其中的秘密很感兴趣。探求真相是冒险家的天性，我可以加入你们一起行动吗？作为报答，我会帮忙的。"
        },
        {
          "role": "公子",
          "text": "我打起架来可是很厉害的哦？"
        },
        {
          "role": "辛焱",
          "text": "旅行者，你觉得呢？"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "公子",
          "text": "你不会不要我吧？不能这样，旅行者，我的实力你是知道的！"
        },
        {
          "role": "旅行者",
          "text": "好吧，大家一起走。"
        },
        {
          "role": "公子",
          "text": "嗯，谢啦。"
        },
        {
          "role": "辛焱",
          "text": "帮「式大将」寻回记忆的帮手又多了一个，人多力量大！"
        },
        {
          "role": "公子",
          "text": "「式大将」，是指你们身边那个小纸人吧？"
        },
        {
          "role": "公子",
          "text": "唔…样貌很是讨喜啊，看这简约的身姿，流畅的五官，真像是我弟弟会喜欢的小东西。"
        },
        {
          "role": "「式大将」",
          "text": "呃…是在表扬我吗？"
        },
        {
          "role": "派蒙",
          "text": "我觉得是，你就当表扬收下吧。"
        },
        {
          "role": "「式大将」",
          "text": "好的，我也想为新伙伴说明一下现状。"
        },
        {
          "role": "公子",
          "text": "你说你是这里的「寮司」…可我进来时并没遇到你，也就是说，那时候你已经昏迷了？"
        },
        {
          "role": "「式大将」",
          "text": "我想是的。"
        },
        {
          "role": "辛焱",
          "text": "小哥，你要不是动作特别快，就是来得特别早，对吧？"
        },
        {
          "role": "公子",
          "text": "小哥？哈哈哈，我喜欢这个称呼！真亲切啊，被人这么喊，居然让我回想起自己家的妹妹来了…"
        },
        {
          "role": "公子",
          "text": "根据刚才的信息，「式大将」有一定可能是这座秘境的看守者。"
        },
        {
          "role": "公子",
          "text": "我们很快就能确认这一点了。「式大将」说过进入秘境之后法力一直在恢复，或许，越往前走，他就能吸收越多力量。"
        },
        {
          "role": "辛焱",
          "text": "「式大将」，你现在有想起什么吗？或者，感觉有什么不同吗？"
        },
        {
          "role": "公子",
          "text": "听说「式神」的一切都来源于符法，那么力量越强，它恢复记忆的可能性就越大。"
        },
        {
          "role": "「式大将」",
          "text": "回到寮里一段时间，我依稀感到…我能控制这座秘境的某些部分。这是属于「寮司」的能力。"
        },
        {
          "role": "公子",
          "text": "这间房间里的魔物已经被我收拾干净了。它们一被打败就变回了残破的符纸。"
        },
        {
          "role": "公子",
          "text": "战斗很让人快乐，不过说来惭愧，我没能找到继续前进的方法。「式大将」，你是「寮司」的话，应该有头绪吧？"
        },
        {
          "role": "「式大将」",
          "text": "请允许我试一试…喝！"
        },
        {
          "role": "辛焱",
          "text": "哇！门开了！"
        },
        {
          "role": "派蒙",
          "text": "呃…总觉得后背发凉，里面、里面好阴森啊，我不要走在最前面…"
        },
        {
          "role": "旅行者",
          "text": "有股危险的气息。"
        },
        {
          "role": "公子",
          "text": "是魔物的气息…战斗的芳香。"
        },
        {
          "role": "公子",
          "text": "这里的魔物很强，前方等着我们的想必是更多恶战。说真的，我喜欢这样…各位朋友，你们也应该学会享受战斗。"
        },
        {
          "role": "辛焱",
          "text": "管他什么强敌，看我把它们都烧光！"
        },
        {
          "role": "派蒙",
          "text": "那你们保护我们哦！尤其是我！"
        },
        {
          "role": "旅行者",
          "text": "「式大将」？怎么了？"
        },
        {
          "role": "「式大将」",
          "text": "声音…我听见有个声音在回响。"
        },
        {
          "role": "「式大将」",
          "text": "这里曾经是…嗯，是我的领域。在这座秘境里，我能做到的事绝不只有开启房门和机关。"
        },
        {
          "role": "「式大将」",
          "text": "我也能战斗，我似乎…就应该懂得战斗才对。"
        },
        {
          "role": "「式大将」",
          "text": "各位！我想起一些有关战斗的技巧。请允许我以「式札」和「阴阳术」配合你们一同战斗。"
        },
        {
          "type": "subtitle",
          "text": "进入「噩兆幽伏之寮」"
        },
        {
          "type": "subtitle",
          "text": "前往「噩兆幽伏之寮」的深处"
        },
        {
          "type": "subtitle",
          "text": "进入「噩兆幽伏之寮」"
        },
        {
          "type": "subtitle",
          "text": "与「式大将」对话"
        },
        {
          "role": "公子",
          "text": "真不错。如此凶险的战斗…我曾在那个地方体验过。"
        },
        {
          "role": "派蒙",
          "text": "你好像很兴奋？就这么爱打架吗？"
        },
        {
          "role": "公子",
          "text": "当然！我享受无止境的战斗。赌上性命，竭尽全力，付诸一切…"
        },
        {
          "role": "派蒙",
          "text": "嗯…带上「公子」，的确是个明智之举呢。我们处理魔物的速度更快了！"
        },
        {
          "role": "辛焱",
          "text": "注意脚下！喂，那是什么？"
        },
        {
          "role": "辛焱",
          "text": "地上这个小纸人，跟「式大将」长得好像啊！"
        },
        {
          "role": "「式大将」",
          "text": "我知道这是什么。这是我的「拓本」，以我为蓝本制造的量产「式神」，承载着我的力量，或许，还有几分记忆…"
        },
        {
          "role": "「式大将」",
          "text": "现在就回收它吧。"
        },
        {
          "role": "辛焱",
          "text": "如何？想起什么没有？"
        },
        {
          "role": "「式大将」",
          "text": "晴之介…"
        },
        {
          "role": "派蒙",
          "text": "晴之介？"
        },
        {
          "role": "「式大将」",
          "text": "惟神晴之介，我的主人。"
        },
        {
          "role": "「式大将」",
          "text": "他是稻妻最初的「阴阳师」，精通符法。他创造了我和这座秘境，并在这里隐居了很久。"
        },
        {
          "role": "公子",
          "text": "你的主人果然是这里的创造者。"
        },
        {
          "role": "辛焱",
          "text": "可是，他造出你和秘境的目的是什么？"
        },
        {
          "role": "「式大将」",
          "text": "抱歉…目前还不清楚。"
        },
        {
          "role": "派蒙",
          "text": "会不会是「阴阳术」狂人呀？发现自己的阴阳术很厉害，于是制造这么一个地方，闭门修行，想让自己变得更厉害…"
        },
        {
          "role": "公子",
          "text": "有可能哦。沉迷某种学术的人，总是能干出惊天动地的事。"
        },
        {
          "role": "公子",
          "text": "比如这个惟神晴之介，他醉心于「阴阳术」，特意造出这座秘境来锻炼自己。"
        },
        {
          "role": "公子",
          "text": "却没想到，秘境出了差错，「阴阳术」失控，使得「式神」都变成了魔物。"
        },
        {
          "role": "派蒙",
          "text": "呜啊！「式神」还会变成魔物的吗？！"
        },
        {
          "role": "辛焱",
          "text": "不、不是吧！听起来很晦气啊！"
        },
        {
          "role": "公子",
          "text": "只是瞎猜而已，毕竟这里也没有「式神」、符纸之外的媒介了嘛。听我说，出了这么大的事，稻妻当局肯定会发现吧？于是就派人封印这里，「式大将」也陷入了沉睡…"
        },
        {
          "role": "「式大将」",
          "text": "不。虽然我现在还想不起晴之介的面容，也不记得与他相处是什么感觉…但有一点我能肯定——"
        },
        {
          "role": "「式大将」",
          "text": "以他的才能，应该不会在「阴阳术」方面犯下如此大的错误。而且，我总感觉他不是那么没有责任心的人…"
        },
        {
          "role": "公子",
          "text": "是吗？那就只有一个不太好的猜测了哦。"
        },
        {
          "role": "公子",
          "text": "假如惟神晴之介是个恶人，创造这座秘境只是想要不断强化「阴阳术」，最终创造出可以成为武器的魔物…"
        },
        {
          "role": "公子",
          "text": "那他就会是不折不扣的麻烦了。而你，是惟神晴之介的帮凶。"
        },
        {
          "role": "「式大将」",
          "text": "恶人的…帮凶？把魔物当成…武器？"
        },
        {
          "role": "辛焱",
          "text": "喂小哥，现在下结论为时过早了吧？"
        },
        {
          "role": "辛焱",
          "text": "「式大将」通过了我的「测试」，在我这边是值得信赖的对象。我不喜欢你这么说它。"
        },
        {
          "role": "公子",
          "text": "再说…被当成兵器，好像不是什么坏事吧？"
        },
        {
          "role": "旅行者",
          "text": "（被当成兵器吗…）"
        },
        {
          "role": "旅行者",
          "text": "（这是他的认知。）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：（他在这里，不是巧合。）",
              "dialogues": [
                {
                  "role": "公子",
                  "text": "穿过那道门，应该就能抵达下一个房间。"
                }
              ]
            },
            {
              "text": "旅行者：（他也在寻找线索。）",
              "dialogues": [
                {
                  "role": "公子",
                  "text": "穿过那道门，应该就能抵达下一个房间。"
                }
              ]
            }
          ]
        },
        {
          "role": "公子",
          "text": "我们大家注意找找「式大将」的「拓本」吧，那个能帮它恢复记忆。"
        },
        {
          "role": "公子",
          "text": "没准我们还能在最深处见到惟神晴之介本尊呢？不知道那家伙能不能打，我想会会他。"
        },
        {
          "role": "「式大将」",
          "text": "…我们继续前进吧。"
        },
        {
          "type": "subtitle",
          "text": "前往「噩兆幽伏之寮」的深处"
        },
        {
          "type": "subtitle",
          "text": "与辛焱对话"
        },
        {
          "role": "派蒙",
          "text": "咦？怎么回到外面来了？"
        },
        {
          "role": "派蒙",
          "text": "我们不是穿过那道门了吗？难道那不是进入下一间房间的门吗？"
        },
        {
          "role": "辛焱",
          "text": "糟了，「式大将」和小哥在哪？不会还在秘境里吧？"
        },
        {
          "role": "辛焱",
          "text": "不行…进不去了，它在排斥外来者。"
        },
        {
          "role": "旅行者",
          "text": "秘境不允许我们进入？"
        },
        {
          "role": "派蒙",
          "text": "好像有隐隐约约的震动？难道，秘境里有什么机关在运行？"
        },
        {
          "role": "辛焱",
          "text": "…啧，这下可麻烦了。"
        },
        {
          "role": "辛焱",
          "text": "不能贸然行动…旅行者，派蒙，我们等一等吧。"
        },
        {
          "role": "九条裟罗",
          "text": "各位！"
        },
        {
          "role": "派蒙",
          "text": "欸！九条裟罗，你这么快就回来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：（幸好达达利亚不在。）",
              "dialogues": [
                {
                  "role": "九条裟罗",
                  "text": "谈不上快。那些魔物很狡猾，擅长与人周旋，浪费了我们不少时间。"
                }
              ]
            },
            {
              "text": "旅行者：（否则会有些难收场。）",
              "dialogues": [
                {
                  "role": "九条裟罗",
                  "text": "谈不上快。那些魔物很狡猾，擅长与人周旋，浪费了我们不少时间。"
                }
              ]
            }
          ]
        },
        {
          "role": "九条裟罗",
          "text": "你们进展如何？"
        },
        {
          "role": "派蒙",
          "text": "其实，刚才…"
        },
        {
          "role": "辛焱",
          "text": "我们打败秘境门口的魔物之后，就再也没有其他魔物出逃了。"
        },
        {
          "role": "辛焱",
          "text": "不过，很快秘境里就开始不断传出声响，应该是有什么大事发生了…我们担心风险太大，想等声音停下再进去。"
        },
        {
          "role": "九条裟罗",
          "text": "…嗯，我能感受到一股抗拒之力。"
        },
        {
          "role": "九条裟罗",
          "text": "眼下光是拦截逃跑的魔物就已耗费不少人力，深入秘境探查真相的难度更大…得做好万全准备。"
        },
        {
          "role": "渡部",
          "text": "九条裟罗大人！伤兵的情况不容乐观，但我们发现回程路上还有几只零散的魔物…"
        },
        {
          "role": "渡部",
          "text": "在下斗胆，请您亲自掠阵护送伤员回城！"
        },
        {
          "role": "九条裟罗",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：不用担心我们。",
              "dialogues": [
                {
                  "role": "九条裟罗",
                  "text": "没办法了，各位。我打算先将伤兵撤回稻妻城，随后请调精锐部队出征此地。你们已经帮了大忙，请随我们一同回城。"
                }
              ]
            },
            {
              "text": "旅行者：去帮助更需要你的人。",
              "dialogues": [
                {
                  "role": "九条裟罗",
                  "text": "没办法了，各位。我打算先将伤兵撤回稻妻城，随后请调精锐部队出征此地。你们已经帮了大忙，请随我们一同回城。"
                }
              ]
            }
          ]
        },
        {
          "role": "辛焱",
          "text": "九条小姐，你是担心我们受累才说这话的吧？其实完全没有哦！我们能应付这里，你就放心去吧。"
        },
        {
          "role": "辛焱",
          "text": "这扇大门，我们会帮你牢牢看住的。"
        },
        {
          "role": "九条裟罗",
          "text": "我对几位，实在过意不去…"
        },
        {
          "role": "辛焱",
          "text": "嘿嘿，帮人帮到底嘛。"
        },
        {
          "role": "派蒙",
          "text": "对对，你不在的时候，我们还在附近生火烤鱼吃呢，可舒服了！"
        },
        {
          "role": "辛焱",
          "text": "我刚才有了新的灵感，想要作曲一首，纪念这次惊涛骇浪的稻妻之旅。"
        },
        {
          "role": "九条裟罗",
          "text": "你们的贡献，我们天领奉行所有人都会铭记在心。等此事结束，我会酬谢各位。"
        },
        {
          "role": "九条裟罗",
          "text": "最近这段时间，就有劳诸位盯住这座秘境了。"
        },
        {
          "role": "九条裟罗",
          "text": "我会让渡部在这一带待命，有什么意外情况，还请及时联系他。"
        },
        {
          "role": "派蒙",
          "text": "辛焱，你刚才是不是故意不提我们进过秘境的事呀？嘿嘿…我发现了哦！"
        },
        {
          "role": "辛焱",
          "text": "很聪明嘛，咱们也算是心意相通了。"
        },
        {
          "role": "辛焱",
          "text": "目前秘境的事还没查清，要是把官家人牵扯进来，可能会有更多问题…"
        },
        {
          "role": "辛焱",
          "text": "先说好，我不是偏心「式大将」啊！只是觉得记忆对它很重要，至少在它知道自己的真实来历前…不要被人误会。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：就像达达利亚推测的。",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "嗯，被人误会的感觉很糟糕…我有类似的经历。有时候大家太轻信表象了，又不愿意付出耐心…"
                }
              ]
            },
            {
              "text": "旅行者：人们确实可能误会它。",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "嗯，被人误会的感觉很糟糕…我有类似的经历。有时候大家太轻信表象了，又不愿意付出耐心…"
                }
              ]
            }
          ]
        },
        {
          "role": "辛焱",
          "text": "每人一个眼神，误会就已经顶天了！被误解的人想解释都难，这样不好。"
        },
        {
          "role": "辛焱",
          "text": "摇滚是好音乐，却也是遭人误解的事物…「式大将」是我用我的语言挑选出的同伴，我会用我的方式帮助它。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：这种做法有风险。",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "是的，我们要抢在九条裟罗回来前证明「式大将」的清白。"
                }
              ]
            },
            {
              "text": "旅行者：我们是在跟九条竞速。",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "是的，我们要抢在九条裟罗回来前证明「式大将」的清白。"
                }
              ]
            }
          ]
        },
        {
          "role": "辛焱",
          "text": "我想请你们帮我保密，先别让「式大将」知道天领奉行的人打算征讨这座秘境。"
        },
        {
          "role": "派蒙",
          "text": "辛焱真贴心啊，时时刻刻照顾失忆患者的心情。"
        },
        {
          "role": "辛焱",
          "text": "哈哈哈，这不是应该的嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：（辛焱负责给予信任…）",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "嗯？又有声音了！我看看啊…"
                }
              ]
            },
            {
              "text": "旅行者：（我…负责决断。）",
              "dialogues": [
                {
                  "role": "辛焱",
                  "text": "嗯？又有声音了！我看看啊…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "等等我，我也…"
        },
        {
          "role": "旅行者",
          "text": "派蒙，过来一下！"
        },
        {
          "role": "派蒙",
          "text": "好复杂，头好晕…"
        },
        {
          "role": "派蒙",
          "text": "不过，到了必须坦白一切的时候，我会努力的！"
        },
        {
          "role": "派蒙",
          "text": "我要好好表现，可不能输给一个小纸人了！"
        },
        {
          "role": "辛焱",
          "text": "旅行者，快来看看！"
        },
        {
          "role": "「式大将」",
          "text": "呜…还是失败了！"
        },
        {
          "role": "辛焱",
          "text": "「式大将」！你没事吧？"
        },
        {
          "role": "「式大将」",
          "text": "我没事，就是刚才为了抵抗寮内的排斥损耗了一些力量。"
        },
        {
          "role": "「式大将」",
          "text": "刚才那扇门应该是一个布置成门扉模样的机关，只要有人触碰它，整座阴阳寮就会将内部所有房间打乱重组。"
        },
        {
          "role": "「式大将」",
          "text": "变化期间，没有人能进去。"
        },
        {
          "role": "「式大将」",
          "text": "唉，都怪我。我对秘境的掌控力还远远不够…否则，绝不会像现在这样狼狈…"
        },
        {
          "role": "派蒙",
          "text": "先别忙着自责了，「公子」人呢？不会还在里面吧？"
        },
        {
          "role": "「式大将」",
          "text": "我不敢确定…但那位先生身上有股不可思议的气质。"
        },
        {
          "role": "「式大将」",
          "text": "他和一般人不一样…战斗对他来说不是负担而是兴趣。他不会为此感到恐惧。这样的人…也许能征服这座秘境。"
        },
        {
          "role": "派蒙",
          "text": "虽然那家伙麻烦了点，但也不能让他不明不白地死掉呀！他是队伍里最强的帮手了吧！"
        },
        {
          "role": "辛焱",
          "text": "那个小哥一路上都表现得游刃有余，我想，我们也要相信他的本事。"
        },
        {
          "role": "辛焱",
          "text": "既然连「式大将」都进不去，那就只有等了。可我不喜欢等待…总觉得很被动。"
        },
        {
          "role": "辛焱",
          "text": "唉，闲着也是闲着，我先想想作曲的事吧。「式大将」，你想听新曲吗？"
        },
        {
          "role": "「式大将」",
          "text": "非常乐意，但我有些心神不宁…"
        },
        {
          "role": "派蒙",
          "text": "你是「式神」啊，居然比我们还要心神不宁吗？"
        },
        {
          "role": "「式大将」",
          "text": "各位是冒着生命危险在帮我，我很明白。所以，你们在秘境内的经历、遭遇的战斗、受到的伤害…都是我必须背负之事。"
        },
        {
          "role": "辛焱",
          "text": "有一种东西，越受到压迫就越是反弹，越被束缚就越冲向自由。我喜欢它，一直追求那样可贵的韧劲。"
        },
        {
          "role": "派蒙",
          "text": "是你说的摇滚乐吧？"
        },
        {
          "role": "辛焱",
          "text": "对！既刚强又柔韧，我想成为那样的存在，永远顽强，永远不被眼前的逆境打垮。"
        },
        {
          "role": "「式大将」",
          "text": "…我明白了，辛焱小姐。就让我们一同静候时机吧。"
        },
        {
          "role": "辛焱",
          "text": "哈哈，这才像话嘛！"
        },
        {
          "role": "辛焱",
          "text": "那旅行者，如果你有其他事要忙，我们就先分头行动吧。"
        },
        {
          "role": "辛焱",
          "text": "等到秘境开放，我们再到附近会合！"
        }
      ]
    }
  ]
}