{
  "quest_id": 40033,
  "chapter_num": null,
  "chapter_title": "万端珊瑚事件簿·稍欠灵光",
  "type": "wq",
  "route": "Bantan Sango Case File: The Truth (Just About) Comes to Light",
  "stories": [
    {
      "story_id": 40033,
      "title": "万端珊瑚事件簿·稍欠灵光",
      "description": "龙二似乎找到了更多的线索，依旧需要调查…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往万端珊瑚侦探社"
        },
        {
          "role": "龙二",
          "text": "是你们啊。来得正好。"
        },
        {
          "role": "龙二",
          "text": "我刚刚考察完几处可疑的地点。"
        },
        {
          "role": "龙二",
          "text": "其中有一处营地是由那个帽…"
        },
        {
          "role": "龙二",
          "text": "咳咳，是由那个「黑影」看守的。如果没有什么别的问题的话…"
        },
        {
          "role": "旅行者",
          "text": "昨天说的「调查」…"
        },
        {
          "role": "龙二",
          "text": "那个的话，我现在还什么都不知道。"
        },
        {
          "role": "派蒙",
          "text": "咦？不是珊瑚让你去调查的吗？"
        },
        {
          "role": "龙二",
          "text": "没错，但是…该怎么说呢？"
        },
        {
          "role": "龙二",
          "text": "比如说，「熟透了的堇瓜」和「门帘上的泥手印」，对我而言，是毫无关联的事物。"
        },
        {
          "role": "龙二",
          "text": "但在珊瑚社长的脑海中就能成为解开「寄木细工」的关键。"
        },
        {
          "role": "派蒙",
          "text": "「熟透了的堇瓜」和「门帘上的泥手印」…它们之间有什么关系呀？"
        },
        {
          "role": "龙二",
          "text": "只是打个比方。我依照她的指示，在八酝岛和镇守之森调查了一些地点，将我的见闻报告给她。"
        },
        {
          "role": "龙二",
          "text": "而她能从我报告的现象中得到什么结论，就只有她自己知道了。"
        },
        {
          "role": "龙二",
          "text": "只有鹿野院先生能和她的思维并驾齐驱…"
        },
        {
          "role": "旅行者",
          "text": "鹿野院？"
        },
        {
          "role": "龙二",
          "text": "天领奉行的人。之前查案的时候，有幸和他见过面。"
        },
        {
          "role": "龙二",
          "text": "是个…气质独特的人。如果见到了，你一定能一眼认出来。"
        },
        {
          "role": "龙二",
          "text": "总之，小动物就拜托你了。"
        },
        {
          "role": "派蒙",
          "text": "我还是好在意「熟透了的堇瓜」…"
        },
        {
          "type": "subtitle",
          "text": "前往调查点进行解救"
        },
        {
          "type": "subtitle",
          "text": "向龙二回报"
        },
        {
          "role": "龙二",
          "text": "辛苦你们了！太好了！这下子应该对上了…"
        },
        {
          "role": "龙二",
          "text": "嗯？怎么还少了几只…"
        },
        {
          "role": "派蒙",
          "text": "呜哇，怎么会这样。感觉没完没了的。"
        },
        {
          "role": "龙二",
          "text": "确实，有时候查案需要很大的耐心。如果不凑巧走错了方向的话，可能也会竹篮打水一场空。"
        },
        {
          "role": "龙二",
          "text": "至少我们目前已经找回了很多小动物了，所以大方向应该是对的。"
        },
        {
          "role": "龙二",
          "text": "只是，可能我们遗漏了什么线索，或者没想到什么地方而已，所以陷入了僵局。不过我相信这是暂时的。"
        },
        {
          "role": "派蒙",
          "text": "我懂了！你是说，我们缺了一点噼咔的感觉！"
        },
        {
          "role": "龙二",
          "text": "噼咔的感觉…也可以这么说吧。而且我们进展并不算慢，这都是多亏了旅行者和派蒙，所以不用沮丧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "（居然听懂了派蒙的话…）",
            "（龙二已经很了解派蒙了…）"
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我总感觉你说得很有道理。"
        },
        {
          "role": "龙二",
          "text": "过奖了，不过是探案累积下来的经验罢了。"
        },
        {
          "role": "龙二",
          "text": "埋得越深的谜题，越有探究的价值。"
        },
        {
          "role": "龙二",
          "text": "只可惜目前也没有其他信息了，嗯…"
        },
        {
          "role": "龙二",
          "text": "这样好了，我先回去和珊瑚社长报告一下现在的情况。"
        },
        {
          "role": "龙二",
          "text": "珊瑚社长一定能想到些什么我们没想到的地方。"
        },
        {
          "role": "派蒙",
          "text": "嗯！你说话很有道理，所以听你的！"
        },
        {
          "role": "龙二",
          "text": "那就这么说定了。老样子，到时候我们老地方见。"
        },
        {
          "role": "龙二",
          "text": "万一我被什么事情缠住脱不开身，你们直接找珊瑚社长就行。"
        }
      ]
    }
  ]
}