{
  "quest_id": 76197,
  "chapter_num": null,
  "chapter_title": "矿物调查·寒涌石",
  "type": "wq",
  "route": "Mineral Research: Icy Pebbles",
  "stories": [
    {
      "story_id": 76197,
      "title": "矿物调查·寒涌石",
      "description": "希汐岛西侧的海滩散布着许多寒涌石…",
      "dialogues": [
        {
          "role": "？？？",
          "text": "(test)台词文本"
        },
        {
          "role": "维贾米",
          "text": "当年在海上漂泊时，我曾听到过不知从何处传来的召唤，其他人无动于衷，但我却很快被迷住了。"
        },
        {
          "role": "奥妮",
          "text": "一定是来自异界的声音吧，我也听到过。"
        },
        {
          "role": "维贾米",
          "text": "后来我才意识到，那召唤中包含了一切未能抵达彼岸的梦想，可以说是怨念的集合。"
        },
        {
          "role": "奥妮",
          "text": "你应该带上寒涌石，透过中间的孔，就可以看到是谁在召唤你了。"
        },
        {
          "role": "维贾米",
          "text": "但当时我还是个年轻气盛的毛头小子，哪怕看到危险也只会觉得是机遇，于是就这么一头撞了进去。"
        },
        {
          "role": "奥妮",
          "text": "听说寒涌石中间的孔就是通向异界的门扉…不过，该怎么穿过去呢？"
        },
        {
          "role": "维贾米",
          "text": "而在那之后…大海的风浪啊，带走了我的财富、荣誉还有家人。"
        },
        {
          "role": "维贾米",
          "text": "在野心和欲望的驱使下的冒险，从来不会有好的结果。"
        },
        {
          "role": "奥妮",
          "text": "啊，卡住了。"
        },
        {
          "role": "莉奈娅",
          "text": "我来帮你取下来吧。下次可再别这么做了哦。"
        },
        {
          "role": "奥妮",
          "text": "莉奈娅姐姐，你怎么有空回来了？"
        },
        {
          "role": "莉奈娅",
          "text": "我来附近收集寒涌石，看到你们在聊天，就来打个招呼。"
        },
        {
          "role": "奥妮",
          "text": "对哦，如果是莉奈娅姐姐，说不定真的可以用寒涌石打开通往异界的门扉…"
        },
        {
          "role": "莉奈娅",
          "text": "就算是我也不行，之前不是和你说过吗？那只是穿凿附会的民间传说而已，没什么可靠的依据…"
        },
        {
          "role": "维贾米",
          "text": "原来行不通啊？"
        },
        {
          "role": "莉奈娅",
          "text": "原来你在听啊。"
        },
        {
          "role": "维贾米",
          "text": "咳…不，我已经不再是过去的我了，现在的我知足常乐，别无所求。"
        },
        {
          "role": "奥妮",
          "text": "这样，真可惜。那我也来帮莉奈娅姐姐收集寒涌石吧。"
        },
        {
          "role": "莉奈娅",
          "text": "好呀，那就麻烦你啦。"
        },
        {
          "role": "？？？",
          "text": "在奥妮的帮助下，很快收集完毕…"
        },
        {
          "role": "莉奈娅",
          "text": "谢谢你，不过我已经收集好啦。"
        },
        {
          "role": "奥妮",
          "text": "好吧，那我就去莫雷谷找莫雷爷爷他们了。再见啦。"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点开启调查"
        },
        {
          "role": "？？？",
          "text": "快速做好了调查的准备…"
        },
        {
          "type": "subtitle",
          "text": "采集寒涌石"
        },
        {
          "role": "旅行者",
          "text": "（附近似乎有些值得调查的，如果是对本地生态十分了解的<color=#FFCC33FF>莉奈娅</color>，或许会有所收获…）"
        },
        {
          "role": "维贾米",
          "text": "这片平静的大海，是我们这些浪迹天涯之人的最终归宿啊。"
        },
        {
          "type": "subtitle",
          "text": "与奥妮对话"
        },
        {
          "role": "奥妮",
          "text": "待会儿去莫雷谷找莫雷爷爷他们好了…"
        }
      ]
    }
  ]
}