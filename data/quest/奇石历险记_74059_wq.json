{
  "quest_id": 74059,
  "chapter_num": null,
  "chapter_title": "奇石历险记",
  "type": "wq",
  "route": "Strange Stone Chronicle",
  "stories": [
    {
      "story_id": 74059,
      "title": "奇石历险记",
      "description": "将切瑟尔试作的钟表带给芙佳，或许便能建起一条新的生产线了。",
      "dialogues": [
        {
          "role": "切瑟尔",
          "text": "啊，是你们，之前卖我宝石的…"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，我记得你上次说，要用我们卖给你的宝石制作成好看的首饰，不知道做出来没有啦？"
        },
        {
          "role": "派蒙",
          "text": "我们一直很期待呢！"
        },
        {
          "role": "切瑟尔",
          "text": "这个嘛…那恐怕要让你们失望了。"
        },
        {
          "role": "派蒙",
          "text": "欸？"
        },
        {
          "role": "切瑟尔",
          "text": "虽然我是想要把那个做成镶嵌在首饰上的宝石啦。但是这种矿石的硬度实在太高，要进行精细的手工打磨也很困难…"
        },
        {
          "role": "切瑟尔",
          "text": "而且最要命的是，没想到在切割打磨后，矿石就失去了一开始的光泽。"
        },
        {
          "role": "切瑟尔",
          "text": "总的来说，就是完全不适合制作成什么工艺品。"
        },
        {
          "role": "派蒙",
          "text": "唔，没想到会这样，我们还以为这种石头真的能有什么用处呢…"
        },
        {
          "role": "切瑟尔",
          "text": "用处嘛，倒也不能说完全没有…"
        },
        {
          "role": "？？？",
          "text": "一边说着，切瑟尔一边将一台机械钟表摆到了柜台上。"
        },
        {
          "role": "切瑟尔",
          "text": "你们看这次新做的机械钟表，可就用到了那种矿石呢。"
        },
        {
          "role": "切瑟尔",
          "text": "本来我都觉得是自己看走了眼，准备把这些石头处理掉了…"
        },
        {
          "role": "切瑟尔",
          "text": "结果有些钟表匠看到了那些加工失败的矿石，由于矿石的硬度很高的缘故，他们就拿来做了钟表里面的机芯零件。"
        },
        {
          "role": "切瑟尔",
          "text": "没想到因为硬度高抗磨损，作为机芯零件，这种矿石与之前用的材料相比，使用效果要好多了。"
        },
        {
          "role": "切瑟尔",
          "text": "但是如果用来制作钟表的话，对货源稳定的要求就更高了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这个倒是好说…",
              "dialogues": []
            },
            {
              "text": "直接和芙佳联系的话…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "你们将芙佳和矿脉的事情告诉了切瑟尔。"
        },
        {
          "role": "切瑟尔",
          "text": "原来如此，那还真是巧了！这款试作型的钟表采用了新发明的防水蚌式结构，原本就有打算让美露莘也能方便使用。"
        },
        {
          "role": "切瑟尔",
          "text": "既然这样的话，能拜托你们把这个钟表带给那位芙佳小姐，顺便帮我提前说明一下吗？"
        },
        {
          "role": "切瑟尔",
          "text": "毕竟我也没有和美露莘做生意的经验…如果芙佳小姐能够提供稳定的货源的话，就能建立一条新的生产线了。"
        },
        {
          "role": "切瑟尔",
          "text": "后面我也会亲自上门联络的！在以后的钟表的设计上，也可以加入美露莘的风格…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，听起来如果能成功的话，对芙佳也很有好处呢！"
        },
        {
          "role": "派蒙",
          "text": "说不定借此机会，芙佳也能拥有自己的宝石工坊了，我们就回去找芙佳说说看吧！"
        },
        {
          "role": "切瑟尔",
          "text": "那就拜托你们了！"
        },
        {
          "type": "subtitle",
          "text": "将钟表带给芙佳"
        },
        {
          "role": "芙佳",
          "text": "是旅行者哥哥和派蒙，好久不见！"
        },
        {
          "role": "芙佳",
          "text": "你们是还想要收集上次那种奇怪的石头吗？"
        },
        {
          "role": "派蒙",
          "text": "唔，虽然也没错啦，不过这个说来话长…"
        },
        {
          "role": "？？？",
          "text": "你们将从切瑟尔那里得来的钟表交给了芙佳，并且把切瑟尔想要利用奇异矿石制作钟表的事情告诉了她。"
        },
        {
          "role": "芙佳",
          "text": "好、好厉害，原来这样的石头还能用来做成这种东西吗？！"
        },
        {
          "role": "派蒙",
          "text": "欸？不过只有机芯里的宝石是用那个石头做的啦…"
        },
        {
          "role": "芙佳",
          "text": "竟然在水下也能滴滴答答地响，这样的钟表还是第一次见！"
        },
        {
          "role": "派蒙",
          "text": "唔，我记得切瑟尔是说采用了什么蚝式结构？还是蚌式结构来着？"
        },
        {
          "role": "芙佳",
          "text": "嘿嘿，光是听到钟表里面的声音就开心起来了！"
        },
        {
          "role": "芙佳",
          "text": "没想到就算是这种普通的石头，也会有适合它自己的用途…"
        },
        {
          "role": "芙佳",
          "text": "以前我一直觉得只有像姐姐那样，用稀有的宝石才能做出了不起的作品，没想到普通的石头也能做成这么厉害的东西…"
        },
        {
          "role": "旅行者",
          "text": "无论是什么都有其用处。"
        },
        {
          "role": "芙佳",
          "text": "嗯嗯，芙佳对自己也突然有自信起来了。"
        },
        {
          "role": "？？？",
          "text": "芙佳小心翼翼地把钟表摆在了好看的地方。"
        },
        {
          "role": "派蒙",
          "text": "既然如此，芙佳就准备好矿石，到时候卖给切瑟尔就好了啦。"
        },
        {
          "role": "派蒙",
          "text": "这样的话，芙佳也能像姐姐一样，拥有一个自己的宝石工坊了吧！"
        },
        {
          "role": "派蒙",
          "text": "芙佳这里有这么多各种各样的石头，说不定也都能找到各自的用处呢！"
        },
        {
          "role": "芙佳",
          "text": "嗯嗯，我会好好准备的，谢谢你们！"
        },
        {
          "role": "芙佳",
          "text": "之后如果你们想要找什么石头的话，也请随时来找我！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，不用谢啦！"
        },
        {
          "role": "切瑟尔",
          "text": "如果芙佳小姐能够提供稳定的货源的话，说不定就能批量生产这种新式的钟表了。"
        },
        {
          "role": "切瑟尔",
          "text": "总之就拜托你们了！"
        }
      ]
    }
  ]
}