  "chapter_title": "葛罗丽的心愿",
  "type": "wq",
  "route": "Glory's Wish",
  "stories": [
    {
      "story_id": 70701,
      "title": "葛罗丽的心愿",
      "description": "蒙德城的葛罗丽需要三份蒲公英籽。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将三份蒲公英籽交给葛罗丽"
        },
        {
          "role": "旅行者",
          "text": "关于蒲公英籽…"
        },
        {
          "role": "葛罗丽",
          "text": "呀，您是看见了我的请求，所以来帮忙吗？谢谢您专门跑一趟…"
        },
        {
          "role": "葛罗丽",
          "text": "请问您拿了蒲公英籽过来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是蒲公英籽。",
              "dialogues": [
                {
                  "role": "葛罗丽",
                  "text": "请您把蒲公英籽放在我的手上…谢谢您。"
                }
              ]
            },
            {
              "text": "还没有拿到。",
              "dialogues": [
                {
                  "role": "葛罗丽",
                  "text": "好吧，如果您拿到了蒲公英籽，就请尽快给我吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与葛罗丽对话"
        },
        {
          "role": "葛罗丽",
          "text": "嗯…确实是蒲公英籽，谢谢您。"
        },
        {
          "role": "葛罗丽",
          "text": "对了，这是一点小礼物，请您收下吧。"
        },
        {
          "role": "葛罗丽",
          "text": "希望我的心愿能顺利传递出去…"
        }
      ]
    }
  ]
}