  "quest_id": 79026,
  "chapter_num": null,
  "chapter_title": "极夜幻想剧·王女执剑记！",
  "type": "wq",
  "route": "Drama Phantasmagoria: Tale of the Sword-Wielding Princess!",
  "stories": [
    {
      "story_id": 79026,
      "title": "极夜幻想剧·王女执剑记！",
      "description": "伟大皇女的忠诚子民，在此为所有来客献上特别的演出，一个关于爱与勇气的故事…",
      "dialogues": [
        {
          "role": "暮夜剧团团长",
          "text": "欢迎！欢迎！"
        },
        {
          "role": "暮夜剧团团长",
          "text": "欢迎！"
        },
        {
          "role": "暮夜剧团团长",
          "text": "您就是大名鼎鼎的旅行者！还有最好的伙伴——派蒙阁下！"
        },
        {
          "role": "派蒙",
          "text": "哇！你怎么知道我们的名字？"
        },
        {
          "role": "暮夜剧团团长",
          "text": "岛上的贵客，我当然知道，因为我！"
        },
        {
          "role": "旅行者",
          "text": "你？"
        },
        {
          "role": "暮夜剧团团长",
          "text": "我就是大名鼎鼎的暮夜剧团团长！"
        },
        {
          "role": "旅行者",
          "text": "原来真的有人自称大名鼎鼎。"
        },
        {
          "role": "",
          "text": "虽然你说自己大名鼎鼎，可是我们没听说过你呀。"
        },
        {
          "role": "暮夜剧团团长",
          "text": "没关系！现在两位已经听说了！"
        },
        {
          "role": "暮夜剧团团长",
          "text": "经过紧锣密鼓的筹备，我们的舞台剧「王女执剑记」就要首演了！"
        },
        {
          "role": "暮夜剧团团长",
          "text": "演出一共五幕，每幕分为上下两场…"
        },
        {
          "role": "暮夜剧团团长",
          "text": "贵宾们来得正是时候！马上序幕就要开演！请您就坐！"
        },
        {
          "role": "暮夜剧团团长",
          "text": "后台还有些事情需要处理，且容我先行告退。"
        },
        {
          "role": "暮夜剧团团长",
          "text": "暮夜剧团，倾力打造的舞台剧，马上开幕，请您欣赏！"
        }
      ]
    }
  ]
}