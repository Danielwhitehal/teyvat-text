{
  "quest_id": 74669,
  "chapter_num": null,
  "chapter_title": "光影研学·旖旎水界",
  "type": "wq",
  "route": "Studies in Light and Shadow: A Fontaine of Enchantment",
  "stories": [
    {
      "story_id": 74669,
      "title": "光影研学·旖旎水界",
      "description": "在枫丹郊外，一位名叫布列松的人似乎遇见了什么麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "向水边的人搭话"
        },
        {
          "role": "派蒙",
          "text": "咦？前面那个人在做什么呢？旁边还放了一台…留影机？"
        },
        {
          "role": "派蒙",
          "text": "看起来也不像是在钓鱼…我们过去看看吧。"
        },
        {
          "role": "布列松",
          "text": "布列松，你要相信自己…相信自己，所有的器材都准备好了…"
        },
        {
          "role": "布列松",
          "text": "只要…呼…只要你下水…下水证明一下这些器材的可靠性，一切就大功告成…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么呢？"
        },
        {
          "role": "布列松",
          "text": "哎哟！您是从哪冒出来的，怎么连一点声响都没有？！"
        },
        {
          "role": "布列松",
          "text": "我吓得差点栽进水里…要是我刚才没稳住，枫丹留影技术就没有未来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抱歉啦。",
              "dialogues": []
            },
            {
              "text": "也没想到你反应这么大…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不过，你不会游泳吗？"
        },
        {
          "role": "旅行者",
          "text": "看起来你也是个枫丹人啊。"
        },
        {
          "role": "布列松",
          "text": "谁…谁说枫丹人一定要会游泳了？也不是每一个璃月人都会做菜，每一个蒙德人都会作诗吧？"
        },
        {
          "role": "布列松",
          "text": "我不和您说了，好不容易才借来这一套潜水设备，今天我必须去水下留影一趟…"
        },
        {
          "role": "派蒙",
          "text": "原来是这样啊…"
        },
        {
          "role": "旅行者",
          "text": "这留影机有什么特别之处？"
        },
        {
          "role": "布列松",
          "text": "特别之处？这台留影机是由我布列松·卡蒂亲自改造过的，这就是它的「特别之处」。"
        },
        {
          "role": "布列松",
          "text": "我的改造方法既严谨，又巧妙，采用的材料也都是最好的。"
        },
        {
          "role": "布列松",
          "text": "镜头更是比其他留影机好上无数倍，在水下留影时，画片的质量没有丝毫折损！"
        },
        {
          "role": "布列松",
          "text": "但协会里的那群家伙…对我的新技术根本不在意，还说什么留影主要靠留影者的技术，留影器材不重要…"
        },
        {
          "role": "布列松",
          "text": "等我拍出几张漂亮的画片，准能让这群压根不懂留影器材重要性的家伙闭嘴！"
        },
        {
          "role": "布列松",
          "text": "呼…布列松，你要相信自己…相信自己…水温很合适，水里也没有会吃人的鱼…"
        },
        {
          "role": "布列松",
          "text": "我…我…哎哟！这潜水服真能管用吗？说不定它会在水底突然爆裂啊！"
        },
        {
          "role": "布列松",
          "text": "然后我就会被暗流卷到水底，谁也发现不了我，天哪，哎哟…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "实在不行，我可以帮忙啦…",
              "dialogues": []
            },
            {
              "text": "不然…我帮你去水下留影吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布列松",
          "text": "真的吗？！您愿意帮我？慷慨的好先生，您真是我的大救星！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还是得付我报酬。",
              "dialogues": []
            },
            {
              "text": "但报酬要按照协会的规矩。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布列松",
          "text": "我当然不可能让您白帮我跑这一趟，您一定能拿到一大笔报酬。"
        },
        {
          "role": "布列松",
          "text": "对了，我还得把几处水底的好风景标在您的地图上…"
        },
        {
          "role": "布列松",
          "text": "还有一些地上的，呃…应该是在这附近…这是全新的器材，得多找几个地方测试一下。"
        },
        {
          "role": "布列松",
          "text": "这样就行了，枫丹留影技术的未来，还有我的留影机器材事业，就全部拜托给您了。"
        },
        {
          "role": "布列松",
          "text": "我就…呃…在岸上等着您。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "布列松",
          "text": "您回来了，是有什么事想问我吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于你的身份…",
              "dialogues": [
                {
                  "role": "布列松",
                  "text": "我？我就是一名枫丹冒险家协会的冒险家。同时也是协会内「留影机爱好协会」的成员。"
                },
                {
                  "role": "布列松",
                  "text": "但「留影机爱好协会」里的人总是说，画片的质量好坏，取决于留影者的留影技术高低。"
                },
                {
                  "role": "布列松",
                  "text": "我听说，甚至有一群人为了锻炼自己的技术，故意用那些技术落后的留影机进行留影…真是自找麻烦。"
                },
                {
                  "role": "布列松",
                  "text": "而我就不一样，我认为更好的器材，就能带来更好的画片。"
                },
                {
                  "role": "布列松",
                  "text": "他们觉得我不懂艺术，哼…我看是他们不懂留影！"
                },
                {
                  "role": "布列松",
                  "text": "这帮人迟早会明白，技术！关键是技术！"
                }
              ]
            },
            {
              "text": "你为什么不敢潜水？",
              "dialogues": [
                {
                  "role": "布列松",
                  "text": "呃…就像有人不喜欢吃蘑菇，有些人吃鱼会吐，每个人的身体情况都不一样啊。"
                },
                {
                  "role": "布列松",
                  "text": "我受不了水底那种黑漆漆的环境，只要待久了我就会喘不过气。"
                },
                {
                  "role": "布列松",
                  "text": "有时候还会四肢发麻，脑袋发晕，然后在不自觉的情况下，丢下手里的留影机…"
                },
                {
                  "role": "布列松",
                  "text": "自从我弄丢了第五台留影机之后，我就真的不太想潜水留影了…"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "布列松",
                  "text": "行，那留影的事就拜托您了。我就在岸上等着您。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          31,
          33
        ]
      ]
    }
  ]
}