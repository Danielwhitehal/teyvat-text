{
  "quest_id": 72692,
  "chapter_num": null,
  "chapter_title": "容彩诗镜·其二",
  "type": "wq",
  "route": "Irodori Poetry: Part II",
  "stories": [
    {
      "story_id": 72692,
      "title": "容彩诗镜·其二",
      "description": "莱内正在创作新的诗歌，似乎这次也需要你帮助取材…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与大伴对话"
        },
        {
          "role": "大伴",
          "text": "哈哈，我听说像风一样自由地飞行是所有蒙德人的梦想，这句诗可说是极有莱内先生的风格了。"
        },
        {
          "role": "莱内",
          "text": "只可惜我小时候并不喜欢出门。如果那时候能有大伴先生作陪的话，可能我现在就有飞行执照了。"
        },
        {
          "role": "大伴",
          "text": "小哥你来得正好，我和莱内先生正在创作新诗。"
        },
        {
          "role": "旅行者",
          "text": "要我帮忙搜集灵感吗？"
        },
        {
          "role": "莱内",
          "text": "哈哈，你说对了。这两天在大伴先生的指导下，我试着创作了一首稻妻风格的诗，可惜技法还很稚嫩。"
        },
        {
          "role": "莱内",
          "text": "我和大伴先生相见恨晚，这首诗写的就是「友情」。其中有一句，我想描写动物结伴而游的情景。"
        },
        {
          "role": "莱内",
          "text": "既然是稻妻风格的诗，能参考的，就只有稻妻土地上独有的动物了。"
        },
        {
          "role": "派蒙",
          "text": "说到稻妻土地上独有的动物，我们平常也见到了不少呢，地上跑的，天上飞的…"
        },
        {
          "role": "派蒙",
          "text": "不过动物们都出没在野外，旅行者，我们就去野外找找吧。"
        },
        {
          "role": "莱内",
          "text": "朋友，那就拜托你了，帮我拍摄四张内容不同的稻妻动物画片吧。"
        },
        {
          "role": "莱内",
          "text": "朋友，画片已经准备好了吗？"
        },
        {
          "role": "旅行者",
          "text": "在这里。"
        },
        {
          "role": "莱内",
          "text": "让我看看…嗯，很好，我已经有些想法了！"
        },
        {
          "role": "莱内",
          "text": "朋友，这次我也根据你带来的画片，写了不同版本的诗句，就由你来选选看用哪一句吧。"
        },
        {
          "role": "大伴",
          "text": "游遍川海啊，听起来要花很久。不过有朋友相伴，也是一件乐事啊。"
        },
        {
          "role": "莱内",
          "text": "朋友，既然大伴先生和你都很喜欢这一句，那就这么决定了。"
        },
        {
          "role": "大伴",
          "text": "莱内先生的诗，与画片相得益彰，伴着画片读诗，诗也越发生动。"
        },
        {
          "role": "大伴",
          "text": "小哥，其实最近我也正在写一首诗，明天也要劳你相助了。"
        },
        {
          "role": "旅行者",
          "text": "大伴先生也需要画片吗？"
        },
        {
          "role": "大伴",
          "text": "呵呵，我们明天再详谈吧。"
        }
      ]
    }
  ]
}