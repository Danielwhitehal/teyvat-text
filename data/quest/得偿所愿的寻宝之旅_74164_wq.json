        },
        {
          "role": "尤维尔",
          "text": "纳蒂亚，你这家伙，之前不是跟你说过了吗？不要多嘴…"
        },
        {
          "role": "纳蒂亚",
          "text": "对不起，尤维尔，我又忘记了。"
        },
        {
          "role": "纳蒂亚",
          "text": "你们好，陌生人。尤维尔现在有很重要的工作需要完成，工作内容是保密的，所以请不要多问，也请不要打扰。"
        },
        {
          "role": "派蒙",
          "text": "呃，可是我们…"
        },
        {
          "role": "尤维尔",
          "text": "抱歉，她以前脑壳受过伤，后来就经常忘事，说话有些颠三倒四的…"
        },
        {
          "role": "尤维尔",
          "text": "对了，纳蒂亚，你跟他们回岸上去吧，去「锈舵」歇会儿。"
        },
        {
          "role": "派蒙",
          "text": "那你呢？感觉你的气色不怎么好欸，该不会是已经在这儿…"
        },
        {
          "role": "纳蒂亚",
          "text": "不是的，训练是很辛苦的，尤维尔要努力完成训练科目才能加入枫丹舰队。"
        },
        {
          "role": "尤维尔",
          "text": "还是纳蒂亚懂我。所以你们快走吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你训练加油，我们走了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "别真走呀！我猜他就是不好意思向我们求助…真是奇怪，遇到困难找人帮忙并不是丢脸的事情呀。"
                }
              ]
            },
            {
              "text": "桨都没了就别硬撑了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "就是，遇到困难的时候向路过的冒险家求助，这并不可耻嘛。"
                }
              ]
            }
          ]
        },
        {
          "role": "尤维尔",
          "text": "我、我都说了我没事，不信我现在就做几个俯卧撑给你们看！"
        },
        {
          "role": "派蒙",
          "text": "哇！你别乱动，木板会翻的！"
        },
        {
          "type": "subtitle",
          "text": "前往「锈舵」"
        },
        {
          "role": "尤维尔",
          "text": "又没让你们救我…你们这是多管闲事。丑话说在前头，我可没有摩拉付给你们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我帮了你为什么还要挨你的骂？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "眼前有人落水我们总不能见死不救吧…这才不是多管闲事呢。"
                }
              ]
            },
            {
              "text": "我助人为乐向来不求回报。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "毕竟我们的口头禅就是「不能放着不管」。"
                }
              ]
            }
          ]
        },
        {
          "role": "尤维尔",
          "text": "怎么可能有这种好事，我不相信这世上有什么无缘无故的善意。如果我是个美少女，你们出于同情搭救我那还可以想象…"
        },
        {
          "role": "尤维尔",
          "text": "但事实是我这相貌就像城里糖果店里没有包装纸的怪味糖果，正常人看都不会多看一眼，更别提伸手去拿了。"
        },
        {
          "role": "尤维尔",
          "text": "你们救我如果不是为了摩拉，肯定就是为了什么不可告人的目的…"
        },
        {
          "role": "派蒙",
          "text": "哇这人的心理怎么这么扭曲…不管你信不信，我们就是老好人啦。而且就算没有摩拉，讲道理，你应该说句谢谢才对！"
        },
        {
          "role": "纳蒂亚",
          "text": "谢谢你们，陌生人，谢谢你们帮了尤维尔。我也想帮他，但总是帮不上，都怪我太没用。"
        },
        {
          "role": "尤维尔",
          "text": "别这么说，纳蒂亚…"
        },
        {
          "role": "派蒙",
          "text": "对了，还没有自我介绍呢。我是派蒙，这家伙是旅行者。"
        },
        {
          "role": "尤维尔",
          "text": "可、可恶，是想让我记住债主的名字吗…"
        },
        {
          "role": "纳蒂亚",
          "text": "谢谢你，旅行者。但是对不起，难得你们把名字告诉我，可是我之后多半又会忘掉。"
        },
        {
          "role": "派蒙",
          "text": "…欸？"
        },
        {
          "role": "尤维尔",
          "text": "…之前不是说过吗，她脑壳受过伤，后来就经常忘事。别看她现在这个样子，听说以前可是在逐影庭任职的精英呢。"
        },
        {
          "role": "尤维尔",
          "text": "不过要不是因为她现在这个样子，也不会跟我这样的人混在一起…"
        },
        {
          "role": "纳蒂亚",
          "text": "嗯。受重伤的时候是尤维尔救了我，但是我也没有摩拉给他，所以给他帮忙。不过我经常忘事，不知道自己到底有没有帮上忙…"
        },
        {
          "role": "尤维尔",
          "text": "别担心，你帮了我不少。我一个人肯定办不到，幸好有你。"
        },
        {
          "role": "纳蒂亚",
          "text": "是这样吗？那一定是我忘记了。不过，太好了，原来我并不是一点用处也没有。"
        },
        {
          "role": "纳蒂亚",
          "text": "两位要讨债的话，可以等到尤维尔发财之后吗？等我们找到宝藏，一定就可以偿清债务了。"
        },
        {
          "role": "派蒙",
          "text": "我们不是讨债人啦！话说回来，你们这么执着于宝藏和发财，难道是因为尤维尔其实欠了很多债…？"
        },
        {
          "role": "尤维尔",
          "text": "我实话说吧，是为了给她治病。你们也看到了，她的健忘有多严重…"
        },
        {
          "role": "尤维尔",
          "text": "要知道她以前可是被叫做「博识的纳蒂亚」，有着过目不忘的本领。"
        },
        {
          "role": "尤维尔",
          "text": "现在想完全恢复是不太可能了，我想至少让她重新过上正常的生活吧…但就算是这样，治疗费也需要一大笔钱。"
        },
        {
          "role": "尤维尔",
          "text": "我既没知识又没本领，只好赌运气啦！但是我的赌运真的很稳定，一次都没赌赢过。"
        },
        {
          "role": "尤维尔",
          "text": "本以为能在那座塔里或者附近找到些什么值钱的玩意儿，结果除了贝壳就是章鱼，章鱼甚至还会抢东西。"
        },
        {
          "role": "尤维尔",
          "text": "现在不光是钱袋和冒险的家当都被大浪带走了，就连找皮托租来的潜水套装也沉水了。哈哈，我已经无计可施了。"
        },
        {
          "role": "旅行者",
          "text": "你突然变得好健谈。"
        },
        {
          "role": "尤维尔",
          "text": "因为我是很卑鄙的。这些话说出来，你们这么善良的人肯定就不好意思向我讨要报酬了，对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想得美，我先给你记在账上。",
              "dialogues": []
            },
            {
              "text": "那也改变不了你走投无路的现状。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "纳蒂亚",
          "text": "没有关系，我能潜水。我可以把尤维尔的钱袋子和潜水套装打捞上来，这样我们就可以还清债务，重新开始了。"
        },
        {
          "role": "纳蒂亚",
          "text": "而且，我的信物也找不到了，大概是也掉进了水里，我要去找找看。"
        },
        {
          "role": "尤维尔",
          "text": "什么？！这么重要的事应该早点说啊！美露莘的信物是很重要的东西吧？比什么钱袋子潜水套装重要多了…"
        },
        {
          "role": "纳蒂亚",
          "text": "是这样吗？虽然不是很明白，但是我懂了。之前我怕耽误尤维尔锻炼，如果耽误了锻炼，尤维尔就不能加入枫丹舰队了。"
        },
        {
          "role": "尤维尔",
          "text": "…舰、舰队的事就别提了！你独自潜水没问题吗？万一碰到打劫的章鱼…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，要不我们陪纳蒂亚一起去吧，感觉让她独自潜水打捞的确不太放心呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的钱袋子很好，现在它是我的了。",
              "dialogues": [
                {
                  "role": "尤维尔",
                  "text": "我就知道…算了，只要你们能保护纳蒂亚找回她的信物，区区钱袋子也不算什么…"
                },
                {
                  "role": "派蒙",
                  "text": "旅行者只是在开玩笑啦！"
                }
              ]
            },
            {
              "text": "毕竟俗话说，「不能放着不管」。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "尤维尔",
          "text": "那现在既然你们要帮忙潜水打捞，能不能顺便帮我找找<color=#00E1FFFF>其他装备，三脚架之类</color>…应该都<color=#00E1FFFF>在我们原来扎营的地方附近的水域</color>…"
        },
        {
          "role": "派蒙",
          "text": "可以是可以…就当是帮人帮到底吧！"
        },
        {
          "role": "纳蒂亚",
          "text": "嗯。谢谢…谢谢？"
        },
        {
          "role": "派蒙",
          "text": "纳蒂亚该不会已经把我忘掉了吧？这么快？！我叫派蒙！"
        },
        {
          "role": "纳蒂亚",
          "text": "现在知道了，你是派蒙。谢谢你，派蒙。"
        },
        {
          "role": "尤维尔",
          "text": "注意安全！就拜托你们了。"
        },
        {
          "type": "subtitle",
          "text": "打捞失物"
        },
        {
          "role": "尤维尔",
          "text": "想来打探我们这边的进展？我一个字都不会说的。"
        },
        {
          "role": "纳蒂亚",
          "text": "对不起。但是我们没有在找「十字铃兰学会」留下的宝藏。"
        },
        {
          "role": "尤维尔",
          "text": "最重要的是纳蒂亚的信物，其次是潜水套装…只要有潜水套装，我就能自己潜水了。当然，其他东西也不是不重要，但是…"
        },
        {
          "role": "尤维尔",
          "text": "钱袋子…我、我是想给报酬的，但是就那么点，你们应该瞧不上吧…"
        },
        {
          "role": "尤维尔",
          "text": "紧张？我一点都不紧张啊？"
        },
        {
          "role": "尤维尔",
          "text": "……"
        },
        {
          "role": "尤维尔",
          "text": "我的发型没乱吧？看起来不奇怪吧？不会留下新的丢脸证据吧？"
        },
        {
          "type": "subtitle",
          "text": "回「锈舵」找尤维尔"
        },
        {
          "role": "派蒙",
          "text": "我们回来了！我数数…纳蒂亚的信物找到了，三脚架和潜水套装也是，不过潜水套装有些损坏…对了，钱袋子也找到了！"
        },
        {
          "role": "旅行者",
          "text": "鼓钱袋和瘪钱袋，你掉了哪个？"
        },
        {
          "role": "派蒙",
          "text": "我们不是只找到一个钱袋子吗？别开玩笑了，还是先给他吧。这可是要拿去给纳蒂亚治病用的。"
        },
        {
          "role": "尤维尔",
          "text": "是的，虽然不多，但是谢…谢谢你们帮我们把它找回来。"
        },
        {
          "role": "尤维尔",
          "text": "怎么感觉比之前…比之前多了？"
        },
        {
          "role": "派蒙",
          "text": "欸？难、难道说是我们打劫了球球章鱼？"
        },
        {
          "role": "尤维尔",
          "text": "可恶…我的夙敌居然这样轻易就被你们给击败了，你们果然不是常人…"
        },
        {
          "role": "派蒙",
          "text": "夙敌？是说球球章鱼吗？"
        },
        {
          "role": "尤维尔",
          "text": "是啊，我和纳蒂亚在这里扎营探索的这段时间，每次潜水都会和它们发生冲突…我们之间的争斗可以说是难分胜负。"
        },
        {
          "role": "尤维尔",
          "text": "我原本立下志愿，总有一天要靠自己的本领打败它，彻底击溃这个值得敬佩的对手。没想到它居然先败在了你们手上…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抱歉，我好像打搅你们了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "？"
                }
              ]
            },
            {
              "text": "没事，你可以找我报仇代替。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "先不提尤维尔打不打得过你…这是可以代替的事情吗！"
                }
              ]
            }
          ]
        },
        {
          "role": "尤维尔",
          "text": "对了，趁你们潜水的工夫，我找到一张纸页，是之前寻宝时捡到的，贴身放着，没有打湿。"
        },
        {
          "role": "尤维尔",
          "text": "但是上面写的东西我全看不懂！像旅行者这样有知识的冒险家说不定能解读吧。"
        },
        {
          "role": "尤维尔",
          "text": "我猜这东西肯定有很高的价值，就交给你们当作谢礼了。"
        },
        {
          "role": "派蒙",
          "text": "那我们就先收下了。"
        },
        {
          "role": "纳蒂亚",
          "text": "我们还在水下找到了漂亮的海螺。尤维尔，送给你。"
        },
        {
          "role": "尤维尔",
          "text": "哦，谢啦。"
        },
        {
          "role": "？？？",
          "text": "尤维尔接过小小的海螺，端详了一阵…"
        },
        {
          "role": "尤维尔",
          "text": "真稀罕，这个海螺的形状很像你老家的那个，是吧？难怪你会觉得它好看。这叫什么…睹物思情？是不是看到它就想家了？"
        },
        {
          "role": "纳蒂亚",
          "text": "唔，不是的。之前忘记了，就像其他事情那样，不过看到它我就想起来，我在别处也见过。比海沫村的小，但比这个大。"
        },
        {
          "role": "纳蒂亚",
          "text": "是一个研究者的收藏品，他研究很多东西，和尤维尔不一样，他有很多知识，也有很多摩拉。"
        },
        {
          "role": "纳蒂亚",
          "text": "但是那是很久以前的事情了，他留下了很多遗产…水下避难所，我记得有人说过，那里有宝物。"
        },
        {
          "role": "纳蒂亚",
          "text": "是谁说的呢…对不起，我想不起来了。"
        },
        {
          "role": "派蒙",
          "text": "纳蒂亚老是在说对不起，可这并不是你的错啊，不用一直道歉的。"
        },
        {
          "role": "尤维尔",
          "text": "没错，要我说，纳蒂亚简直太了不起了，当然，如果能记起这个有宝物的水下避难所的位置那就更了不起了…"
        },
        {
          "role": "派蒙",
          "text": "到头来你最关心的还是宝物啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还有人性吗？",
              "dialogues": []
            },
            {
              "text": "我也刚想问记不记得位置来着…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "呜呜我们家的旅行者什么时候也变成这种冷酷无情缺乏人性的冒险家了…"
                }
              ]
            }
          ]
        },
        {
          "role": "尤维尔",
          "text": "我就是卑鄙，关心宝物的下落就是我的人性的体现！别管是传说中的宝藏还是研究者的遗产，我都想要！我想要发财！"
        },
        {
          "role": "尤维尔",
          "text": "只要能发财，我就能找枫丹最好的医生给纳蒂亚看病，那样…那样她就可以不用总是跟着我露宿野外了…"
        },
        {
          "role": "纳蒂亚",
          "text": "尤维尔一定可以发财的，到时我们都可以不用露宿野外。虽然很模糊，但是我记得水下避难所的大概位置。"
        },
        {
          "role": "尤维尔",
          "text": "那我们这就出发吧！潜水套装的气罐虽然坏了一个，但还有备用的，这次潜水应该够了。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们也一起去看看吧？我也好在意宝物到底是什么…"
        },
        {
          "role": "尤维尔",
          "text": "两位也一起来吧！不管怎么说，两位也帮了我们不少，找到宝物我一定分两位一份…不，两份！"
        },
        {
          "type": "subtitle",
          "text": "前往「水下避难所」"
        },
        {
          "type": "subtitle",
          "text": "击退球球章鱼"
        },
        {
          "type": "subtitle",
          "text": "进入「水下避难所」"
        },
        {
          "type": "subtitle",
          "text": "与尤维尔对话"
        },
        {
          "role": "纳蒂亚",
          "text": "就是这里了。我记得，之前来过。"
        },
        {
          "role": "派蒙",
          "text": "这里真的会有宝物吗？感觉挺普通的…"
        },
        {
          "role": "尤维尔",
          "text": "不愧是见多识广的冒险家，对这样的神秘场所不屑一顾。刚才也是，轻易就击败了我的夙敌…亲眼见识，不得不服。"
        },
        {
          "role": "尤维尔",
          "text": "要是一只也就罢了，我可没有信心从一群原海异种的包围中脱身。说起来我小时候的确被球球章鱼包围过，还差点溺水。"
        },
        {
          "role": "尤维尔",
          "text": "当时多亏一个好心的美露莘救了我，还带我到一个布置豪华的房间休息…跟这地方还挺像的。"
        },
        {
          "role": "旅行者",
          "text": "你跟美露莘还挺有缘分的。"
        },
        {
          "role": "尤维尔",
          "text": "的确，美露莘都对我很好。不过，我和人类的缘分很少，这样也算扯平了吧。"
        },
        {
          "role": "尤维尔",
          "text": "别说这些了，发财要紧！"
        },
        {
          "role": "尤维尔",
          "text": "我们分开找找看有没有传说中的宝物吧。"
        },
        {
          "type": "subtitle",
          "text": "寻找宝物的线索"
        },
        {
          "role": "调查",
          "text": "（费了一番力气打开箱子，里面只有齑粉…或者说灰尘。箱子里之前究竟装了些什么？还是不要想了…）"
        },
        {
          "role": "调查",
          "text": "（将脖子仰到几乎不能再向后弯折的角度才勉强看清，过高的书架上放了一些显然与研究无关的，颇有闲趣的读物。）"
        },
        {
          "role": "调查",
          "text": "（抽屉里装了一些发黄的空白纸页，和许多空墨水瓶。）"
        },
        {
          "role": "调查",
          "text": "（摊开的乐谱之下好像有什么…）"
        },
        {
          "role": "派蒙",
          "text": "这是什么？字写得好难辨认，像小孩子写的…不过真奇怪，上面说的事看着有点像…真有这么巧的事吗？"
        },
        {
          "role": "纳蒂亚",
          "text": "旅行者、派蒙，你们人真好，就像尤维尔一样。"
        },
        {
          "type": "subtitle",
          "text": "与尤维尔对话"
        },
        {
          "role": "派蒙",
          "text": "这里真的有宝物吗？我们什么都没有找到…只找到一份奇怪的留言，看起来像小孩子写的…"
        },
        {
          "role": "尤维尔",
          "text": "我们这边也没有收获。不过奇怪的留言…说不定是研究员留下的宝物线索呢！他们有钱人就喜欢搞这些花里胡哨的…"
        },
        {
          "role": "？？？",
          "text": "将找到的留言交给了尤维尔…"
        },
        {
          "role": "尤维尔",
          "text": "哎哟，这字写得真难看，简直像哪里的小鬼乱涂乱画…"
        },
        {
          "role": "尤维尔",
          "text": "……"
        },
        {
          "role": "尤维尔",
          "text": "…啊？"
        },
        {
          "role": "派蒙",
          "text": "怎么了？有什么发现吗？"
        },
        {
          "role": "尤维尔",
          "text": "我找到宝物了。"
        },
        {
          "role": "派蒙",
          "text": "欸？！所以这上面真的有宝物的线索吗？我都没看出来…"
        },
        {
          "role": "尤维尔",
          "text": "该怎么说呢，字写得最丑的最后一行写的是…"
        },
        {
          "role": "尤维尔",
          "text": "「今天的经历对我来说就像宝物一样，美露莘对我很好，等我长大了，我也要当一个能帮助别人的人。」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以这份留言根本就是你…",
              "dialogues": []
            },
            {
              "text": "所以这里根本没有什么值钱宝物。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "也、也不能说不值钱啦！对本人来说，这应该算是「无价之宝」，对吧？"
                }
              ]
            }
          ]
        },
        {
          "role": "尤维尔",
          "text": "够了…你们也觉得很滑稽吧。哈哈…我也不敢相信，这么肉麻的话居然是我自己写的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "字很难看，但道理没错。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这么一说，的确，是率直的善良小孩会写的话呢！但是这些年究竟发生了什么才让尤维尔变成别扭的大人…"
                }
              ]
            },
            {
              "text": "没事，大家都有这种青涩的时期。",
              "dialogues": [
                {
                  "role": "尤维尔",
                  "text": "为什么你明明看着年纪不大却一副过来人的样子啊！这不是显得我更丢脸了吗！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对了！我突然想到，纳蒂亚之前不是说过吗？她是听别人说这里有宝物…"
        },
        {
          "role": "派蒙",
          "text": "而这个故事里只有一个美露莘！就是救了小孩子尤维尔的那个美露莘！尤维尔还记得当时救了自己的美露莘吗？"
        },
        {
          "role": "尤维尔",
          "text": "美露莘都长得差不多，我哪分得清…再说了，我连自己在这里留下了这么丢脸的证据的事都忘得一干二净了…"
        },
        {
          "role": "派蒙",
          "text": "那…纳蒂亚还记得吗？看到这里的一切，有没有想起来一点什么？"
        },
        {
          "role": "纳蒂亚",
          "text": "我…"
        },
        {
          "role": "纳蒂亚",
          "text": "…对不起，我不记得了。"
        },
        {
          "role": "派蒙",
          "text": "纳蒂亚还是想不起来吗？唉…我还以为这个故事能有个超——级温馨的结尾呢，真可惜…"
        },
        {
          "role": "尤维尔",
          "text": "我不知道你想听什么样的故事…但是我肯定不是你想听的故事里的主角，所以别想了，也别再逼纳蒂亚想起来了。"
        },
        {
          "role": "尤维尔",
          "text": "我满足不了你的期待，甚至满足不了小时候的我自己的期待。我长大了，但是没长本事，结果就是帮不了任何人。"
        },
        {
          "role": "尤维尔",
          "text": "之前还夸口说要找到宝物分给你们两份呢…哈哈，要不我把这烂纸片撕一半给你们吧。"
        },
        {
          "role": "纳蒂亚",
          "text": "尤维尔之前救了我，并不是帮不了任何人。现在也在想办法帮我，只是尤维尔暂时运气不好，我也忘事太多…"
        },
        {
          "role": "旅行者",
          "text": "虽然没发财，但是也不算全无收获。"
        },
        {
          "role": "纳蒂亚",
          "text": "嗯。帮尤维尔找回了珍贵的回忆。珍贵的回忆就是宝物，尤维尔应该知道的。"
        },
        {
          "role": "尤维尔",
          "text": "可是不是值钱的东西，就没法给你治病…"
        },
        {
          "role": "纳蒂亚",
          "text": "没关系，只是暂时运气不好。尤维尔应该打起精神来，毕竟，总是摆出灰心丧气的表情，好运也会逃走的。"
        },
        {
          "role": "纳蒂亚",
          "text": "旅行者、派蒙，对不起，让你们白跑一趟。可是，可以再拜托你们一件事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你先说吧。",
              "dialogues": []
            },
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "纳蒂亚",
                  "text": "可是我还没有说是什么事…"
                },
                {
                  "role": "派蒙",
                  "text": "不、不自觉就脱口而出了，真是可怕！"
                }
              ]
            }
          ]
        },
        {
          "role": "纳蒂亚",
          "text": "我想拜托你们，帮我和尤维尔拍一张画片。如果有画片的话，之后看到画片就能记起今天的事。"
        },
        {
          "role": "纳蒂亚",
          "text": "记得旅行者和派蒙帮了我们很多忙，等尤维尔发财了要记得还债。"
        },
        {
          "role": "派蒙",
          "text": "这个就不用记了！不过只是留影的话，小事一桩！就交给我们吧。"
        },
        {
          "type": "subtitle",
          "text": "为尤维尔和纳蒂亚留影"
        },
        {
          "role": "派蒙",
          "text": "你们准备好了吗？要换个位置或者姿势之类的吗？"
        },
        {
          "role": "派蒙",
          "text": "唔，尤维尔是不是坐下比较好？坐在哪里取景比较好看呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "坐长椅中间吧。",
              "dialogues": [
                {
                  "role": "尤维尔",
                  "text": "好吧…那纳蒂亚就站我旁边。这样可以吗？"
                },
                {
                  "role": "派蒙",
                  "text": "哦，除了尤维尔的表情硬得像块石头，看起来还不错！"
                }
              ]
            },
            {
              "text": "坐单人椅吧。",
              "dialogues": [
                {
                  "role": "尤维尔",
                  "text": "穿着潜水服根本坐不下去吧…"
                },
                {
                  "role": "派蒙",
                  "text": "感觉会很挤…要不就站着好了。"
                }
              ]
            },
            {
              "text": "坐圆凳吧。",
              "dialogues": [
                {
                  "role": "尤维尔",
                  "text": "认真的吗？不如让纳蒂亚坐。纳蒂亚，你坐吧。"
                },
                {
                  "role": "纳蒂亚",
                  "text": "我不坐。尤维尔，你坐。"
                },
                {
                  "role": "派蒙",
                  "text": "呃…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "总之先这样吧！我们要拍咯！"
        },
