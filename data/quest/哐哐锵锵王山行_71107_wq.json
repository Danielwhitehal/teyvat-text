{
  "quest_id": 71107,
  "chapter_num": null,
  "chapter_title": "哐哐锵锵王山行",
  "type": "wq",
  "route": "A Wangshan Walk to Remember",
  "stories": [
    {
      "story_id": 71107,
      "title": "哐哐锵锵王山行",
      "description": "在黄三爷的邀请下，来到了传说中埋藏古华派遗宝的重地「王山厅」…",
      "dialogues": [
        {
          "role": "文四爷",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "呃…请问这里是？"
        },
        {
          "role": "文四爷",
          "text": "王山厅。"
        },
        {
          "role": "文四爷",
          "text": "要是迷路的话…沿着那边那条路一直往前走，就能到遗珑埠了。"
        },
        {
          "role": "派蒙",
          "text": "咦，王山厅？我好像在哪里听说过这个名字…"
        },
        {
          "role": "派蒙",
          "text": "呜啊，我想起来了！「王山厅」…就是古华派的本堂吧！"
        },
        {
          "role": "文四爷",
          "text": "…正是。"
        },
        {
          "role": "派蒙",
          "text": "唔，没想到会在这种地方…那个，我们可以进去参观吗？"
        },
        {
          "role": "文四爷",
          "text": "参观？没想到这种深山僻壤，居然还有外人想要参观…"
        },
        {
          "role": "文四爷",
          "text": "既然如此，那就让我去把师兄找来，让他带两位参观好了。我只是个粗人，讷口拙舌，不懂待人接客。"
        },
        {
          "role": "文四爷",
          "text": "请两位在此稍歇，容我去趟遗珑埠，顷刻便回。"
        },
        {
          "type": "subtitle",
          "text": "话音未落，一闪身的功夫，文四爷的身影就消失在了层林中…"
        },
        {
          "role": "派蒙",
          "text": "呜哇，好厉害！一下子就不见了！"
        },
        {
          "role": "旅行者",
          "text": "原来如此，这就是轻功…"
        },
        {
          "role": "派蒙",
          "text": "不对，等等，他刚才说的是遗珑埠？！那要等到什么时候啦！"
        },
        {
          "role": "派蒙",
          "text": "唔，不过，既然是会轻功的人，说不定从这里到遗珑埠也用不了多久…"
        },
        {
          "role": "旅行者",
          "text": "还是先等等吧。"
        },
        {
          "type": "subtitle",
          "text": "不多时，文四爷带着另外一个人回来了…"
        },
        {
          "role": "黄三爷",
          "text": "哎哟，慢点儿，慢点儿！我这把老骨头，可跟不上你的速度…"
        },
        {
          "role": "文四爷",
          "text": "…我已经很慢了。说到底，还不是因为你的功夫搁下了太久，身上都放了肉…"
        },
        {
          "role": "黄三爷",
          "text": "行了，行了，当着外人就别说这些了！"
        },
        {
          "role": "派蒙",
          "text": "呃，这位老先生是…"
        },
        {
          "role": "黄三爷",
          "text": "在下古华派黄三，也有些人管我叫「穿云箭」。"
        },
        {
          "role": "派蒙",
          "text": "「穿云箭」…是说射箭很厉害的意思吗？"
        },
        {
          "role": "黄三爷",
          "text": "哈哈，不过是年轻时别人对我身法的形容罢了，不必放在心上。"
        },
        {
          "role": "文四爷",
          "text": "哼，什么别人的形容，明明就是自称…"
        },
        {
          "role": "黄三爷",
          "text": "你就先别说话了！呼…总之，两位是来参观王山厅的吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是的。",
              "dialogues": [
                {
          "role": "黄三爷",
          "text": "哈哈，好呀！以少侠的身手，说不定还能找到古华宗师留下的遗宝呢！"
        }
              ]
            },
            {
              "text": "不是，只是路过而已…",
              "dialogues": [
                {
          "role": "黄三爷",
          "text": "是吗…唉，只可惜王山厅内尚有遗宝，若是就此埋没群山之中…可惜，可惜呀！"
        }
              ]
            }  
          ]
        },
        
        {
          "role": "派蒙",
          "text": "欸，遗宝？！"
        },
        {
          "role": "文四爷",
          "text": "……"
        },
        {
          "role": "黄三爷",
          "text": "不错！古华宗师当初开山立派之时，曾在王山厅内暗设十二密室，置以遗世珍宝。"
        },
        {
          "role": "文四爷",
          "text": "嗬，「十二密室」，头头是道的，原来你还专门数过啊…"
        },
        {
          "role": "黄三爷",
          "text": "啧…"
        },
        {
          "role": "文四爷",
          "text": "你继续，你继续。"
        },
        {
          "role": "黄三爷",
          "text": "王山厅乃是依山凿石而建，其中结构错综复杂，千百年里，只有寥寥几间密室曾被发现，尚有一些，连本门弟子都不知其所在。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "（就是用来吸引游客的噱头吧…）",
            "（应该不会有人上这种当才对…）"
          ]
        },
        {
          "role": "派蒙",
          "text": "真的吗？！旅行者，旅行者，我们去看看吧！有古华派的遗宝欸！"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "唔，为什么要露出那种表情啦！你难道不心动吗？要是能找到被遗忘的宝藏，我们可就发财啦！"
        },
        {
          "role": "旅行者",
          "text": "好好，那我就陪着派蒙去吧。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，太好啦！我就知道旅行者一定会感兴趣的！"
        },
        {
          "role": "旅行者",
          "text": "不过，参观王山厅的费用是多少？"
        },
        {
          "role": "黄三爷",
          "text": "费用？哈哈，少侠说笑了，我们是正经的古华派传人，打算邀请有识之士前来游览，又不是什么招摇撞骗的江湖骗子！"
        },
        {
          "role": "文四爷",
          "text": "……"
        },
        {
          "role": "黄三爷",
          "text": "分文不取！如何，少侠是否有意随我一同参观，探寻我等古华派的悠久历史？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好，正合我意！",
              "dialogues": [
                {
          "role": "黄三爷",
          "text": "哈哈，少侠果然豪爽！"
        }
              ]
            },
            {
              "text": "既然不要钱，那就去看看吧…",
              "dialogues": []
            }
            
            
          ]
        },       
        {
          "role": "黄三爷",
          "text": "不过，王山厅毕竟是古华派的重地。按照规矩，非本门弟子想要进入王山厅，就必须要先通过两道试炼才行。"
        },
        {
          "role": "黄三爷",
          "text": "换句话说，就是要先看看少侠您的身手如何！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "哼，可别小瞧人了！",
            "好麻烦…"
          ]
        },
        {
          "role": "黄三爷",
          "text": "自然，自然！对少侠而言，这两道试炼定是有如探囊取物，反掌观纹一般！"
        },
        {
          "role": "黄三爷",
          "text": "只是门派规矩如此，我们也不敢擅作变更，还望少侠见谅。"
        },
        {
          "role": "旅行者",
          "text": "所以，我具体要做些什么？"
        },
        {
          "role": "黄三爷",
          "text": "很简单——两位，请随我来！"
        },
        {
          "role": "文四爷",
          "text": "两位，注意安全。"
        },
        {
          "role": "派蒙",
          "text": "好耶！那我们也快点出发吧，旅行者，我已经等不及啦！"
        },
        {
          "type":"subtitle",
          "text":"前往王山厅"
        },
        {
          "role": "文四爷",
          "text": "（不是…这些古董玩意你也不多修缮一下，怎么能拿出来！万一…）"
        },
        {
          "role": "黄三爷",
          "text": "（嘿，你不懂了不是…我要是修缮了，人家看了漆都是新的，还怎么愿意来玩…来习武呢！这历史沧桑感就是…那什么…嗨！）"
        },
        {
          "role": "黄三爷",
          "text": "（…再说了，咱老哥俩哪有那闲钱呢…）"
        },
        {
          "role": "黄三爷",
          "text": "哎呀，哎呀…欢迎！两位终于来了，这里便是我等古华派的重地——王山厅！"
        },
        {
          "role": "文四爷",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "呃…这位是？"
        },
        {
          "role": "黄三爷",
          "text": "哈哈，不必在意，这位是我师弟，江湖人称「踏雪剑」的文四爷。"
        },
        {
          "role": "文四爷",
          "text": "见过了两位，欢迎欢迎。"
        },
        {
          "role": "黄三爷",
          "text": "不过，王山厅毕竟是古华派的重地。按照规矩，非本门弟子想要进入王山厅，就必须要先通过两道试炼才行。"
        },
        {
          "role": "黄三爷",
          "text": "换句话说，就是要先看看少侠您的身手如何！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哼，可别小瞧人了！",
              "dialogues": [
                {
          "role": "文四爷",
          "text": "（好嘛，看看这傻小子…）"
        }
              ]
            },
            {
              "text": "好麻烦…",
              "dialogues": []
            } 
            
            
          ]
        },
        
        {
          "role": "黄三爷",
          "text": "自然，自然！对少侠而言，这两道试炼定是有如探囊取物，反掌观纹一般！"
        },
        {
          "role": "黄三爷",
          "text": "只是门派规矩如此，我们也不敢擅作变更，还望少侠见谅。"
        },
        {
          "role": "派蒙",
          "text": "呜呜…没办法了，为了古华在「十二密室」中遗留的宝藏…"
        },
        {
          "role": "文四爷",
          "text": "「十二密室」？嗬，跟客人说得头头是道的，原来你还专门数过啊…"
        },
        {
          "role": "黄三爷",
          "text": "啧…"
        },
        {
          "role": "文四爷",
          "text": "你继续，你继续。"
        },
        {
          "role": "旅行者",
          "text": "所以，我具体要做些什么？"
        },
        {
          "role": "黄三爷",
          "text": "很简单——两位，请随我来！"
        },
        {
          "type":"subtitle",
          "text":"了解试炼规则"
        },
        {
          "role": "黄三爷",
          "text": "两位请看，这便是古华宗师留下的「望梅之阵」！"
        },
        {
          "role": "黄三爷",
          "text": "遥想当年，古华宗师正是在这些石桩上，苦修轻身之法，终成一代大师！那边的古树，亦是由古华宗师亲手栽下…"
        },
        {
          "role": "派蒙",
          "text": "呜哇，全都东倒西歪的，甚至还有断了一半的…"
        },
        {
          "role": "旅行者",
          "text": "应该是年久失修的缘故吧…"
        },
        {
          "role": "黄三爷",
          "text": "咳…自然不是！这是为了增加修习的难度，仅此而已！毕竟，在实战中，哪里有整整齐齐的石桩可以踩呢！"
        },
        {
          "role": "派蒙",
          "text": "不，实战中也没有人会踩这玩意儿吧！"
        },
        {
          "role": "黄三爷",
          "text": "总之，第一道试炼，便是请少侠在规定时间内依次踏过由我指出的石桩，一展身法！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哼，小事一桩！",
              "dialogues": []
            },
            {
              "text": "好麻烦…",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "加油呀，旅行者！要想拿到宝藏…咳，我是说，要想通过试炼，可不能怕麻烦！"
        }
              ]
            }   
          ]
        },
        {
          "role": "黄三爷",
          "text": "那么，就请少侠上前！"
        },
        {
          "type":"subtitle",
          "text": "完成试炼"
        },
        {
          "role": "黄三爷",
          "text": "好，好身法！少侠矫若飞燕，滴水不染，可谓轻功盖世，不愧是当今豪杰！"
        },


        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "哼哼，不过如此！",
            "差点就掉下去了…"
          ]
        },
        {
          "role": "派蒙",
          "text": "呃…用风之翼也能算得上是身法吗？"
        },
        {
          "role": "黄三爷",
          "text": "哈哈，小朋友，看来你对传统武学还是不够了解啊。"
        },
        {
          "role": "黄三爷",
          "text": "我且问你，侠客仗剑纵横世间，擒尽盗匪，败尽贼寇，依凭的是侠客自己的本领，还是剑的本领？"
        },
        {
          "role": "派蒙",
          "text": "这个…当然是侠客本人的本领啦！"
        },
        {
          "role": "黄三爷",
          "text": "不错！再锋利的神兵，若是落到不懂用剑的人手里，也是徒劳无益。"
        },
        {
          "role": "黄三爷",
          "text": "依循此理，能将风之翼用得如此出神入化，自然也是少侠身法高超的明证。古华功法讲究如臂使指，正是如此！"
        },
        {
          "role": "派蒙",
          "text": "唔，你说得好像有点道理，但是好像又完全没有道理…"
        },
        {
          "role": "黄三爷",
          "text": "总之，恭喜少侠顺利通过第一重试炼！第二道试炼还需移步演武场，两位，请随我来！"
        },
        {
          "role": "旅行者",
          "text": "我是不会输的！"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，我也会给你加油的！"
        },
        {
          "type":"subtitle",
          "text": "前往下一处场地"
        },
        {
          "role": "黄三爷",
          "text": "两位请看，此处便是演武场！"
        },
        {
          "role": "黄三爷",
          "text": "想当年，古华派的名声在璃月无人不知、无人不晓，靠的是什么？靠的就是在这里练出来的一手枪剑本事！"
        },
        {
          "role": "黄三爷",
          "text": "所谓「枪剑双绝」，就是一朝一夕辛苦练习的成果！"
        },
        {
          "role": "旅行者",
          "text": "（一个人都没有…）"
        },
        {
          "role": "黄三爷",
          "text": "这第二道试炼嘛，便是「枪剑试炼」！稍等，容我先把练习用具搬出来…"
        },
        {
          "type": "subtitle",
          "text": "黄三爷不知从何处搬出了一堆蒙尘的竹制假人…"
        },
        {
          "role": "黄三爷",
          "text": "呼，累死我了…好！总之，就请少侠用这些假人来一展身手吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "呃，所以我要做什么？",
            "难道是要我在两秒内打倒所有假人…"
          ]
        },
        {
          "role": "黄三爷",
          "text": "请看，这些假人之中，有些穿着蓝色的衣服，有些穿着红色的衣服。"
        },
        {
          "role": "黄三爷",
          "text": "战场形势瞬息万变，需要精准判断出敌人和盟友。要想通过这道试炼，就必须要在规定时间内击中所有穿着红色衣服的假人！"
        },
        {
          "role": "黄三爷",
          "text": "但若是失手打中穿着蓝色衣服的假人，那就算是失败了，还请少侠留神！"
        },
        {
          "role": "派蒙",
          "text": "唔唔，所以就是要精准打中所有穿着红色衣服的假人，但是不能打到穿着蓝色衣服的假人…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哼，轻而易举，看我大展神威！",
              "dialogues": [
                 {
          "role": "黄三爷",
          "text": "好，好志气！既然如此，就请少侠试剑！"
        }
              ]
            },
            {
              "text": "派蒙，能再说一遍吗？",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "欸？我想想，好像是说，要精准打中所有穿着…唔，穿着蓝色衣服的假人，但是不能打中穿着红色衣服的假人…"
        },
        {
          "role": "黄三爷",
          "text": "说反了，说反了！是要打中所有穿着红色衣服的假人，但是不能打到穿着蓝色衣服的假人！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请再说一遍？",
              "dialogues": [
                {
          "role": "黄三爷",
          "text": "啊？这个，是要打中所有穿着…咳，总之，请少侠意会！"
        }
              ]
            },
            {
              "text": "原来如此，第二道试炼是绕口令…",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "不是啦！虽然我也已经听糊涂了…总之，只要打中一种颜色的假人就好了吧？应、应该是红色没错…"
        }
              ]
            }
          ]
        }
              ]
            }
          ]
        },
        {
          "type":"subtitle",
          "text":"完成试炼，得到黄三爷的评价"
        },
        {
          "role": "派蒙",
          "text": "好耶！这样就算是顺利过关啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text":  "哼哼，根本难不倒我！",
              "dialogues": []
            },
            {
              "text": "好麻烦，应该没有别的试炼了吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "黄三爷",
          "text": "好，好功夫！少侠果真眼明手捷，不费吹灰之力就打倒了所有目标！哪怕是在本门弟子当中，也罕有能与少侠比肩之人呀！"
        },
        {
          "role": "黄三爷",
          "text": "莫非少侠其实是别派的掌门，来此微服私访不成？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不错，我其实是派蒙派蒙派的掌门…",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "？"
        },
        {
          "role": "黄三爷",
          "text": "啊呀！原来是派…呃，原来是别派的掌门，失敬失敬——"
        },
        {
          "role": "派蒙",
          "text": "什么乱七八糟的，旅行者你也不要胡说啦！毕竟我们已经习惯战斗了，辨别目标这种事情还是很简单的！"
        }
              ]
            },
            {
              "text": "…啊？",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "不至于啦…毕竟我们已经习惯战斗了嘛，辨别目标这种事情还是很简单的！"
        }
              ]
            } 
          ]
        },
        
        {
          "role": "黄三爷",
          "text": "哈哈哈，以少侠的身手，觉得简单也是理所当然！"
        },
        {
          "role": "黄三爷",
          "text": "总之，既然少侠已经顺利通过了两重试炼，那自然也就有了觐见王山厅的资格。请随我来！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，王山厅的遗宝，我们来啦！"
        },

        {
          "type":"subtitle",
          "text":"打开王山厅的大门"
        },      
        {
          "role": "黄三爷",
          "text": "两位请看，此处便是我派千年重地——王山厅！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "哇！",
            "（什么玩意儿，破破烂烂的…）"
          ]
        },
        {
          "role": "黄三爷",
          "text": "遥想当年古华宗师开山立派之时，此处殿宇何其雄峙，各路豪杰聚义于此，觥筹交错，行歌之声不绝于耳…"
        },
        {
          "role": "黄三爷",
          "text": "就是仙家灵境，又如何比得上这王山厅！"
        },
        {
          "role": "派蒙",
          "text": "唔，话说回来，「王山厅」到底是什么意思啊？"
        },
        {
          "role": "黄三爷",
          "text": "哈哈，我且说给你听！传说古华宗师仗剑行侠世间之时，贼匪不敢妄动，郊野太平如市…"
        },
        {
          "role": "黄三爷",
          "text": "山中盗寇畏古华威名如同畏虎——虎乃是百兽之王，受宗师荫庇的百姓便将此地称作「王山厅」，以表恩敬。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来如此！",
              "dialogues": []
            },
            {
              "text": "那不是应该叫「威虎山」之类的吗？",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "太奇怪啦！还是「王山厅」听上去比较帅气吧！"
        }
              ]
            }           
          ]
        },
        {
          "role": "黄三爷",
          "text": "咳…总之呀，自那之后，千百年间，我古华派于此地不断精进，修习功法…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "哦！",
            "（最后就精进成了这样吗…）"
          ]
        },
        {
          "role": "黄三爷",
          "text": "来！由我引两位细细观览一番，先随我绕过这「古华试剑石」…"
        },
        {
          "role": "派蒙",
          "text": "（旅行者，旅行者，注意看呀，说不定就能找到遗宝的线索啦！）"
        },
        {
          "type":"subtitle",
          "text":"跟随黄三爷游览王山厅"
        },
        {
          "role": "派蒙",
          "text": "咦？这里为什么锁上了呀？"
        },
        {
          "role": "黄三爷",
          "text": "哈哈，这里是藏书阁，我等古华派的功法秘籍都藏在此处，因此也只能对本门弟子开放。"
        },
        {
          "role": "派蒙",
          "text": "唔，原来如此…那我们就不进去好了！"
        },
        {
          "role": "黄三爷",
          "text": "好！如此一来，王山厅的游览便也就告一段落了！"
        },
        {
          "role": "派蒙",
          "text": "欸？等等，这就结束啦？遗宝呢？"
        },
        {
          "role": "黄三爷",
          "text": "哈哈，遗宝这种东西，毕竟是可遇不可求嘛！要知道，千百年间，多少弟子都想要找到宗师留下的宝物，但终究也没人发现…"
        },
        {
          "role": "派蒙",
          "text": "唔唔…既然如此，那我们就再在附近找一找！"
        },
        {
          "role": "黄三爷",
          "text": "且慢！少侠若是想要继续探索古华派的奥秘，按照江湖规矩，您得先展示点儿诚意吧？"
        },
        {
          "role": "黄三爷",
          "text": "就拿古华宗师来说吧——想当初，他教授弟子枪剑双绝的功夫，也是要收学费的…"
        },
        {
          "role": "派蒙",
          "text": "欸？！可我们又不是古华派的弟子呀！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "就是就是！",
            "明明说好了不收费！"
          ]
        },
        {
          "role": "派蒙",
          "text": "更何况，我也没听说过，古华派还会骗人摩拉！"
        },
        {
          "role": "黄三爷",
          "text": "这…什么叫骗！咳，我们也未必要收摩拉，只是江湖规矩如此！想当初，古华宗师收的也不是摩拉，而是稻米和咸肉…"
        },
        {
          "role": "派蒙",
          "text": "欸？所以你们不是要钱的，是要饭的？"
        },
        {
          "role": "黄三爷",
          "text": "这个…唉，也罢，若是没有摩拉的话，给我做顿饭吃也好！先人都是如此，少侠作为当世英杰，自然也该意思意思不是？"
        },
        {
          "role": "黄三爷",
          "text": "毕竟，我们讲究「雪中送炭，锦上添花」，全凭自愿，只要心意到了就行。可不是向少侠强索财物——只是少侠莫要问心有愧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "对喔，我是当世英杰…",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "不不不，旅行者，别被他绕进去啦！"
        }
              ]
            },
            {
              "text": "倘若我问心无愧呢？",
              "dialogues": [
                {
          "role": "黄三爷",
          "text": "你，你……"
        }
              ]
            }
          ]
        },
        
        {
          "role": "派蒙",
          "text": "哼，所以你就是想要吃的对吧！那我们就做给你吃好啦！"
        },
        {
          "role": "派蒙",
          "text": "（旅行者，旅行者，我想到了一个好办法！）"
        },
        {
          "role": "旅行者",
          "text": "（好办法？）"
        },
        {
          "role": "派蒙",
          "text": "（嘿嘿…你一会儿就知道啦！跟我来！）"
        },
        {
          "type": "subtitle",
          "text": "去一旁听听派蒙的点子"
        },
        {
          "role": "派蒙",
          "text": "哼哼，那家伙不是说「古华当年收的是稻米和咸肉」嘛，那我们就按照他的要求，给他做一份咸肉好啦！"
        },
        {
          "type": "subtitle",
          "text": "派蒙一改平日里懒洋洋的态度，气呼呼地独自搭起了篝火…"
        },
        {
          "role": "派蒙",
          "text": "既然是「咸肉」的话，不管多咸都没有问题吧？"
        },
        {
          "role": "派蒙",
          "text": "总之，先把肉烤好…"
        },
        {
          "role": "派蒙",
          "text": "呜啊，总觉得有些浪费食物…不对不对，已经顾不了那么多啦！哼，要怪也是怪那家伙！"
        },
        {
          "role": "派蒙",
          "text": "接下来就该往里面放盐啦！嘿嘿，旅行者，就交给你吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这样做会不会稍微有点过分…",
            "（撒一小撮盐。）"
          ]
        },
        {
          "role": "派蒙",
          "text": "要、要说过分的话，那家伙借着什么「遗宝」的名头，把我们诓到这里来、还想骗吃骗喝，这才叫过分呢！"
        },
        {
          "role": "派蒙",
          "text": "像这样的家伙，就应该好好给他上一课才行！否则的话，他以后说不定还会去骗别人…你说对吧，旅行者？"
        },
        {
          "role": "旅行者",
          "text": "（撒一小撮盐。）"
        },
        {
          "role": "派蒙",
          "text": "真是的，还可以再多加一点嘛！就像这样——"
        },
        {
          "role": "旅行者",
          "text": "（放两份盐。）"
        },
        {
          "role": "派蒙",
          "text": "嗯，嗯，这就对啦，再多加点！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "（放两份盐。）",
            "（放三份盐。）"
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "（放三份盐。）",
            "（放四份盐！）"
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "（放四份盐！）",
            "（放「适量」的盐！）"
          ]
        },
        {
          "role": "派蒙",
          "text": "算了…还是太慢了，干脆把剩下的东西全部倒进去好啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那就全倒进去吧…",
            "那就全倒进去吧！"
          ]
        },
        {
          "role": "派蒙",
          "text": "锵！完成啦！这就是派蒙特制的咸肉料理！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "真是让人垂涎欲滴！",
            "好像有什么奇怪的东西掉进去了…"
          ]
        },
        {
          "role": "旅行者",
          "text": "真是让人垂涎欲滴！"
        },
        {
          "role": "派蒙",
          "text": "真是让人心情舒畅！"
        },
        {
          "role": "派蒙",
          "text": "总之，我们快点把这个交给黄三爷吧！"
        },
        {
          "type": "subtitle",
          "text": "将派蒙的特制料理交给黄三爷"
        },
        {
          "role": "派蒙",
          "text": "黄三爷，我们回来啦！"
        },
        {
          "role": "黄三爷",
          "text": "哦！少侠行事果真如迅雷风烈！短短一时半霎，便已经准备好了如此珍肴异馔——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "哈哈，承让！",
            "某种意义上也算是「异馔」吧…"
          ]
        },
        {
          "type": "subtitle",
          "text": "黄三爷吃下了派蒙特制的咸肉料理…一秒钟都不到，便连盘带肉丢到了一旁，以奔雷走电之势冲向了不远处的水潭，咕嘟咕嘟猛喝了几大口…"
        },
        {
          "role": "黄三爷",
          "text": "…咳！这、这是什么东西！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好，好身法！",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "是…是呀，不愧是江湖人称「穿云箭」的黄三爷，连旅行者和我都差点没追上…"
        },
        {
          "role": "派蒙",
          "text": "不对，重点错啦！这可是我们特制的咸肉料理！毕竟，是你自己说的「雪中送炭，锦上添花」嘛！只要心意到了就行，这就是我们的心意！"
        }
              ]
            },
            {
              "text": "呃，不用客气？",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "嘿嘿，是你自己说的「雪中送炭，锦上添花」嘛！只要心意到了就行，这就是我们的心意！"
        }
              ]
            }
          ]
        },
        
        {
          "role": "黄三爷",
          "text": "你…！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "行了，我早就看出你的把戏了。",
            "打算拿我们当普通游客坑是吧？"
          ]
        },
        {
          "role": "派蒙",
          "text": "哼，就是就是！还说什么遗宝，只是想骗吃骗喝吧！真以为千岩军不会抓人吗！"
        },
        {
          "role": "黄三爷",
          "text": "等等！您先别急着找千岩军！我好歹也是武林中人，正经的古华派前辈…一把年纪因为坑骗游客吃牢饭，说出去未免也太丢人了！"
        },
        {
          "role": "派蒙",
          "text": "知道丢人就别做这种事儿呀！"
        },
        {
          "role": "黄三爷",
          "text": "更何况，我也不是在骗你们…这王山厅内，虽说没有什么十二密室，但确有遗宝存在，只是我们这些后世弟子也不清楚它的位置。"
        },
        {
          "role": "派蒙",
          "text": "有什么区别吗！哼，我们这就去告诉千岩军，说你为老不尊，故意坑骗游客，骗吃骗喝，还有还有——"
        },
        {
          "role": "黄三爷",
          "text": "行吧，行吧！我在这儿接待了这么久的游客，像你们这么实诚的还真不多…"
        },
        {
          "role": "黄三爷",
          "text": "这样，为了报答两位不去举报我的情义，我破例把藏书阁的钥匙交给两位。藏书阁中无数武学秘籍，自然也算得上是「遗宝」吧？"
        },
        {
          "type": "subtitle",
          "text": "黄三爷不知从何处掏出了一大串钥匙…"
        },
        {
          "role": "派蒙",
          "text": "呃，这些钥匙是…"
        },
        {
          "role": "黄三爷",
          "text": "都是一样的，都是一样的。藏书阁的备用钥匙。"
        },
        {
          "role": "派蒙",
          "text": "为什么会有这么多备用钥匙啦！"
        },
        {
          "role": "黄三爷",
          "text": "哈哈，这不是上了岁数，怕钥匙丢了嘛。来，这一把两位拿好。"
        },
        {
          "role": "旅行者",
          "text": "这要丢不也是一起丢了吗…"
        },
        {
          "role": "派蒙",
          "text": "就是啊…不对，我们刚才还威胁要举报你呢，怎么突然就把这么重要的东西交给我们了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "是啊，毕竟是真正的古华派秘籍…",
            "你就不怕我们是坏人吗？"
          ]
        },
        {
          "role": "黄三爷",
          "text": "实不相瞒，先前那些游客付的摩拉，我都拿来维护这些埋起来的玩意儿了。"
        },
        {
          "role": "黄三爷",
          "text": "如今的古华派…呵，人走茶凉。依然留在王山厅的，依然有心回到这里打理打理的，也就只剩下我们几个老头子咯。"
        },
        {
          "role": "黄三爷",
          "text": "只可惜呀，我们也上了岁数，有心无力…你们两个也看到了，这地方还是破破烂烂的，我们能做的最多也就是扫扫灰，仅此而已。"
        },
        {
          "role": "黄三爷",
          "text": "哈哈，古华宗师若是泉下有知，想必也会笑话我们这些后世的弟子无能吧。"
        },
        {
          "role": "派蒙",
          "text": "黄三爷…"
        },
        {
          "role": "黄三爷",
          "text": "只是这古华派千年的传承，总不能跟我们这些老东西一齐入棺材吧？我刚才也看出来了，你们两个是好人…好人现在可不多见呐。"
        },
        {
          "role": "黄三爷",
          "text": "愿意陪着我这个糟老头子胡闹，让这地方重新有点生气儿…我就觉得，把藏书交给你们，而不是烂在这里，到底是值得的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我明白了。",
            "行吧…"
          ]
        },
        {
          "role": "黄三爷",
          "text": "哈哈…罢了，罢了，这话说得我都有点儿牙碜。就当我是担心两位前去报官，才把钥匙给两位的好了。"
        },
        {
          "role": "黄三爷",
          "text": "少侠…不，{M小伙子}{F小姑娘}，想在这里待多久就待多久，不必拘礼。至于藏书阁里的书籍…若是看中了，随意带走也无妨。"
        },
        {
          "role": "黄三爷",
          "text": "那么，请便吧。"
        }
      ]
    }
  ]
}