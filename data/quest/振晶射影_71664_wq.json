{
  "quest_id": 71664,
  "chapter_num": null,
  "chapter_title": "振晶射影",
  "type": "wq",
  "route": "Vibro-Crystal Projections",
  "stories": [
    {
      "story_id": 71664,
      "title": "振晶射影",
      "description": "某位枫丹的科研专家似乎正在层岩巨渊进行着深奥的研究…",
      "dialogues": [
         {
          "type": "subtitle",
          "text": "前往璃月的冒险家协会"
        },
        {
          "role": "凯瑟琳",
          "text": "总算等到你了，旅行者。"
        },
        {
          "role": "凯瑟琳",
          "text": "最近冒险家协会接到了一份相当重要的委托，根据我的经验，你是最合适的人选。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "相当重要的委托…",
            "似曾相识的对话…"
          ]
        },
        
        {
          "role": "派蒙",
          "text": "不用这么客气啦，凯瑟琳小姐，我们早就习惯了！"
        },
        {
          "role": "派蒙",
          "text": "如果委托的报酬不够丰厚，凯瑟琳小姐也不会来麻烦我们的，对吧？"
        },
        {
          "role": "凯瑟琳",
          "text": "咳咳，倒也没错呢…不愧是你们，每次都这么爽快。"
        },
        {
          "role": "凯瑟琳",
          "text": "那我就直说好了，这次的委托人名叫帕特里克，是一位来自枫丹的科研专家。"
        },
        {
          "role": "凯瑟琳",
          "text": "他希望能雇佣几位助手，帮助他进行科研，目前他正在层岩巨渊外围进行考察。"
        },
        {
          "role": "凯瑟琳",
          "text": "虽然不清楚科研的详细内容，但你们对这种委托已经是轻车熟路了吧。"
        },
        {
          "role": "旅行者",
          "text": "确实如此…"
        },
        {
          "role": "派蒙",
          "text": "那就按照惯例办事吧，我们先去层岩巨渊附近看看！"
        },
         {
          "type": "subtitle",
          "text": "前往层岩巨渊外围，寻找帕特里克"
        },
        {
          "role": "帕特里克",
          "text": "不能再拖延下去了，必须尽快进入验证环节…实在不行，我就只能亲自上阵了。"
        },
        {
          "role": "帕特里克",
          "text": "「意外受伤，被迫中止研究。」靠这个借口应该能多拖延一会儿…"
        },
        {
          "role": "帕特里克",
          "text": "反正只要不把命给搭上，就比回去接受审判要划算！"
        },
        {
          "role": "派蒙",
          "text": "他在这里自言自语什么呢？打个招呼吧，旅行者。"
        },
        {
          "role": "旅行者",
          "text": "你好，请问是帕特里克先生吗？"
        },
        {
          "role": "帕特里克",
          "text": "吓死我了！你们两个是从哪冒出来的…怎么还知道我的名字？"
        },
        {
          "role": "帕特里克",
          "text": "等等，你们不会也是便衣的千岩军吧？还要来驱赶我吗？我已经出示过实地考察的许可了！"
        },
        {
          "role": "帕特里克",
          "text": "我保证，绝对不会深入禁区的！不信你去问那位杀气腾腾的、黑色短发的小姐！"
        },
        {
          "role": "派蒙",
          "text": "虽然不知道你说的人是谁，但别紧张啦。"
        },
        {
          "role": "派蒙",
          "text": "我们是友善、专业的冒险家。我们接到了协会的委托，来帮你解决麻烦啦。"
        },
        {
          "role": "帕特里克",
          "text": "原来是救兵？太好了！你们总算到了，我的研究项目终于有救了，要不然我早晚有一天要被它害死…"
        },
        {
          "role": "派蒙",
          "text": "看来你被你的研究项目给折磨得不轻啊。"
        },
        {
          "role": "帕特里克",
          "text": "这是什么话！研究这一行为本身是神圣而高洁的！折磨我的只是一些「附加因素」罢了。"
        },
        {
          "role": "派蒙",
          "text": "「附加因素」？比如说？"
        },
        {
          "role": "帕特里克",
          "text": "科研失败就会死。"
        },
        {
          "role": "派蒙",
          "text": "……？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "…像一句自暴自弃的话。",
            "哦，有点好笑。"
          ]
        },
        {
          "role": "帕特里克",
          "text": "唉，我可没在开玩笑。"
        },
        {
          "role": "帕特里克",
          "text": "独立的研究者进行科研需要申请资金，只要使用这笔资金，就等于承担了枫丹的社会责任。"
        },
        {
          "role": "帕特里克",
          "text": "花费了大笔资金还没能取得成果，就无异于罪人，可是会被审判的！"
        },
        {
          "role": "帕特里克",
          "text": "要是我空手而归，等待着我的大概不止「浪费公共财产」，还有占用「学术资源」等好几十项罪名。"
        },
        {
          "role": "帕特里克",
          "text": "这些罪名会给我带来最严重的惩罚…财产亏空，身败名裂还是小事，被审判的话，真的有可能会死掉！"
        },
        {
          "role": "派蒙",
          "text": "欸？这也太过分了吧！"
        },
        {
          "role": "派蒙",
          "text": "所以你才那么慌张，花一大笔钱聘请助手么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "枫丹这个国家还真是可怕。",
              "dialogues": [
                {
          "role": "帕特里克",
          "text": "可怕的是「附加因素」！我美丽的故乡是无罪的！"
        }
              ]
            },
            {
              "text": "这种「附加因素」还真是恐怖。",
              "dialogues": [
                {
          "role": "帕特里克",
          "text": "但它有利有弊，只要不沦为罪人，还是能享受到各种便利的。出身于枫丹的人都曾受益于它。"
        }
              ]
            }    
            
            
          ]
        },
        
        {
          "role": "派蒙",
          "text": "冷静一点啦，我们明白情况有多严重了。这项科研关系到你的未来，你的性命。"
        },
        {
          "role": "派蒙",
          "text": "都交给我们吧，我们会帮你搞定一切的！"
        },
        {
          "role": "帕特里克",
          "text": "事到如今，我也只能依靠你们了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你需要我们怎么做呢？",
            "请解释一下你的科研项目。"
          ]
        },
        {
          "role": "帕特里克",
          "text": "嗯，那就进入正题吧。我的研究项目名叫「振晶映射」。"
        },
        {
          "role": "帕特里克",
          "text": "简单来说，就是激发矿藏宝石所含有的元素力，将这种元素力作为能源使用。"
        },
        {
          "role": "派蒙",
          "text": "听起来好方便啊！也许能用来制作实用又好玩的机器…"
        },
        {
          "role": "派蒙",
          "text": "不过，这些宝石和你说的什么晶什么映，又有什么关系呢？"
        },
        {
          "role": "旅行者",
          "text": "「振晶」就属于这种宝石吧。"
        },
        {
          "role": "帕特里克",
          "text": "答对了！不久之前，有人在激发宝石时发现，有一类特殊宝石之间能产生奇妙的共鸣。"
        },
        {
          "role": "帕特里克",
          "text": "并将这样的宝石统称为「振晶」。"
        },
        {
          "role": "帕特里克",
          "text": "「振晶」中的「响振晶」受到特定的刺激后，可以放出能量，激发「应振晶」的共鸣。"
        },
        {
          "role": "帕特里克",
          "text": "两种「振晶」所放出的能量会相互叠加，成倍增幅，无比强大！我将这种共鸣命名为「映射」现象，"
        },
        {
          "role": "帕特里克",
          "text": "目前项目已经进行到了关键阶段——验证我推导的「映射关系」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我有一种预感…",
            "我已经明白了…"
          ]
        },
        {
          "role": "派蒙",
          "text": "我猜，你需要我们去检验你的理论，借助那些「振晶」的力量打败魔物，证明你所说的「映射关系」…"
        },
        {
          "role": "帕特里克",
          "text": "完全正确！你们的悟性很高啊！"
        },
        {
          "role": "帕特里克",
          "text": "我挑选了一片合适的区域，布置了许多组「振晶」的方碑。做好了准备的话，就告诉我吧。"
        },
        {
          "role": "帕特里克",
          "text": "我会向你们仔细说明需要验证的项目，根据我的提示去战斗就可以了。"
        },
        {
          "role": "派蒙",
          "text": "这么说来，还真是我们最熟悉的工作呢，甚至觉得有点无聊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我倒有点兴趣…",
            "不如你来试试？"
          ]
        },
        
        {
          "role": "派蒙",
          "text": "你打败过那么多强大的敌人，手脚加在一起都数不过来了吧，搞定这种委托，当然是小菜一碟！"
        },
        {
          "role": "帕特里克",
          "text": "真有气势！璃月可真是个好地方啊，不止出产宝石的原矿，还有这么可靠的冒险家！"
        },
        {
          "role": "帕特里克",
          "text": "不枉我跋山涉水，为了节省材料的费用赶到这里来。"
        },
        {
          "role": "帕特里克",
          "text": "本来我还在为预算超支苦恼，这下倒好，支付了你们的佣金后，资金余下两成。"
        },
        {
          "role": "帕特里克",
          "text": "事成之后，就用这笔钱雇佣一个报社写手，在新闻头版发布我的成果，好好宣传一番吧。"
        },
        {
          "role": "帕特里克",
          "text": "标题我已经想好了，就叫「震惊！帕特里克对振晶的真经实论！」"
        },
        {
          "role": "派蒙",
          "text": "正经一点啦！这个标题怎么看都不像是学术文章吧？"
        },
        {
          "role": "帕特里克",
          "text": "标题一定要奇怪，要引人瞩目，这样才能拉到投资！到时候，我们还可以商量分红的事。"
        },
        {
          "role": "派蒙",
          "text": "分红？不明白你在说什么…"
        },
        {
          "role": "帕特里克",
          "text": "如果「振晶映射」的理论被用来生产商品，我就能拿到不少利润，到时可以按一定比例分给你们哦。"
        },
        {
          "role": "帕特里克",
          "text": "当然，前提是研究的进展顺利…"
        },
        {
          "role": "派蒙",
          "text": "居然还有这种好事吗？好呀好呀，我更有干劲了！标题什么的我不管了，随你喜欢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "派蒙…",
            "口水要流出来了…"
          ]
        },
        {
          "role": "派蒙",
          "text": "总之，旅行者，我们就早早开工，快快收工吧！"
        },
        {
          "role": "派蒙",
          "text": "然后就能和帕特里克先生商量分红的事了，嘿嘿…"
        }
      ]
    }
  ]
}