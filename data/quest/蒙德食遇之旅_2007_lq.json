{
  "quest_id": 2007,
  "chapter_num": "长杓之章 第一幕",
  "chapter_title": "蒙德食遇之旅",
  "type": "lq",
  "route": "Mondstadt Gastronomy Trip",
  "stories": [
    {
      "story_id": 11000,
      "title": "狩猎中的小厨师",
      "description": "在一个风清日朗的日子，你和派蒙散步到了清泉镇附近…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "接近林中的少女"
        },
        {
          "type": "subtitle",
          "text": "与少女交谈"
        },
        {
          "role": "？？？",
          "text": "小声点，我正在打猎呢。"
        },
        {
          "role": "？？？",
          "text": "早就听说蒙德有很多好食材，现在一看果然名不虚传！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是猎人？",
              "dialogues": []
            },
            {
              "text": "你是冒险家？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "不不不，我是个厨师，立志走遍各地，搜寻珍奇食材的厨师！"
        },
        {
          "role": "香菱",
          "text": "我叫香菱，从璃月港来，你们呢？"
        },
        {
          "role": "旅行者",
          "text": "我叫旅行者。"
        },
        {
          "role": "派蒙",
          "text": "你好啊，我是派蒙。"
        },
        {
          "role": "香菱",
          "text": "派蒙！"
        },
        {
          "role": "派蒙",
          "text": "怎么了？为什么突然盯着我看？"
        },
        {
          "role": "香菱",
          "text": "好奇妙的生物，这个可以吃吗?"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她是我的好朋友。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "可惜了，朋友那就是不能吃的。"
                }
              ]
            },
            {
              "text": "当然可以。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "不可以！派蒙不是吃的！"
                }
              ]
            }
          ]
        },
        {
          "role": "香菱",
          "text": "你们的关系真好，其实我也有这样的好朋友，叫作锅巴。"
        },
        {
          "role": "派蒙",
          "text": "名字怎么还是吃的啊！"
        },
        {
          "role": "香菱",
          "text": "哈哈，因为很可爱啊。"
        },
        {
          "role": "香菱",
          "text": "对了对了，你们可以帮我狩猎吗？"
        },
        {
          "role": "香菱",
          "text": "这里有好多猎物，全都是绝佳的食材。"
        },
        {
          "role": "香菱",
          "text": "我一个人实在是抓不过来，放走了又太可惜了！"
        },
        {
          "role": "派蒙",
          "text": "听起来好麻烦…"
        },
        {
          "role": "香菱",
          "text": "别这么说嘛，等下送给你们好吃的！"
        },
        {
          "role": "派蒙",
          "text": "好、好吃的？一言为定，旅行者可擅长这个了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一点立场都没有啊…",
              "dialogues": []
            },
            {
              "text": "别无视我的意见啊。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "嘿嘿，别在意别在意，你的朋友都已经答应了。"
        },
        {
          "role": "香菱",
          "text": "不管用什么方法，只要能带回来兽肉就好。"
        },
        {
          "role": "香菱",
          "text": "那就交给你们了！"
        },
        {
          "type": "subtitle",
          "text": "帮助香菱收集兽肉"
        },
        {
          "type": "subtitle",
          "text": "将三块兽肉交给香菱"
        },
        {
          "role": "香菱",
          "text": "哇，有这么多，一部分用来煎，一部分配上蘑菇炒，还有些和史莱姆凝液试试看…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她瞬间就入迷了…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我们很自然地被忽略了…"
                }
              ]
            },
            {
              "text": "我想尝尝史莱姆凝液！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘿嘿，旅行者你终于能理解我的喜好了。"
                }
              ]
            }
          ]
        },
        {
          "role": "香菱",
          "text": "啊啊，不好意思不好意思，一不小心就去想菜谱了。"
        },
        {
          "role": "香菱",
          "text": "这个是答应送你们的好吃的。现在就尝尝看吧！把感想告诉我！"
        },
        {
          "role": "派蒙",
          "text": "我们是被当成试菜员了吗？"
        },
        {
          "role": "派蒙",
          "text": "哦哦！这、这个…太好吃了！"
        },
        {
          "role": "派蒙",
          "text": "可以告诉我们是怎么做的吗！"
        },
        {
          "role": "香菱",
          "text": "嘿嘿，当然可以了！只不过我还没有写成菜谱，我想想看…"
        },
        {
          "role": "香菱",
          "text": "要不然这样吧！我现在再做一次，你们就照着学！看遍肯定就明白了吧！"
        },
        {
          "role": "派蒙",
          "text": "这么复杂的菜看一次也记不住啦..而且锅和调味料都没有。"
        },
        {
          "role": "香菱",
          "text": "哎呀，这还不简单。"
        },
        {
          "role": "香菱",
          "text": "锅用岩板，油用刚刚猎到的野猪的油，搬石头堆成灶，木头和茅草生旺火。"
        },
        {
          "role": "香菱",
          "text": "糖用甜甜花，至于盐，我之前在一个洞穴里找到了很多崖盐，够用好几天的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这、这也太轻车熟路了…",
              "dialogues": []
            },
            {
              "text": "听起来就很费事！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "嘿嘿，我总按捺不住尝试新菜的心情。但又不能每次出都带好锅碗瓢盆什么的。"
        },
        {
          "role": "香菱",
          "text": "稍等下，我现在就去准备。"
        },
        {
          "role": "艾伦",
          "text": "喂！你们在这里干什么啊！"
        },
        {
          "role": "艾伦",
          "text": "这里是野猪们的栖息地，是不可以打猎的！把它们都吓跑了怎么办？"
        },
        {
          "role": "艾伦",
          "text": "我们猎人不做杀鸡取卵的事。"
        },
        {
          "role": "香菱",
          "text": "啊！我懂我懂！"
        },
        {
          "role": "香菱",
          "text": "只有最适合的环境才能诞生这么鲜美的肉质！如果被吓跑的话…"
        },
        {
          "role": "香菱",
          "text": "不行不行，那绝对是美食界…不对，是全人类的一大损失！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是有个性的理解方式。",
              "dialogues": []
            },
            {
              "text": "其实完全没懂吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "对不起，没想到会造成这么大的影响！"
        },
        {
          "role": "艾伦",
          "text": "唉，你们去和杜拉夫先生道个歉吧。"
        },
        {
          "role": "艾伦",
          "text": "他是我们这些猎人的领头人，他很看重狩猎的规矩，现在特别生气。"
        },
        {
          "role": "旅行者",
          "text": "现在该怎么办？"
        },
        {
          "role": "香菱",
          "text": "我觉得应该去和他道歉的，毕竟做错了事嘛。"
        },
        {
          "role": "旅行者",
          "text": "让我们陪你一起去吧。"
        },
        {
          "role": "香菱",
          "text": "嘿嘿，谢谢你们。那这件事结束之后我再做菜给你们吃！"
        },
        {
          "role": "派蒙",
          "text": "好的，放心吧，就算你忘了我都会记住的。"
        },
        {
          "role": "派蒙",
          "text": "那就出发吧，那位杜拉夫先生他应该就在清泉镇。"
        }
      ]
    },
    {
      "story_id": 11001,
      "title": "料理之约",
      "description": "散步途中，你们偶然遇到了-位奇妙的少女。名叫香菱的少女来自璃月，是一位厨师，为了搜寻珍奇食材，她邀你们一道打猎。但你们私自狩猎野猪的行为似乎惹恼了猎户们的领头人杜拉夫，你们不得不去向他道歉。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "陪香菱去清泉镇"
        },
        {
          "type": "subtitle",
          "text": "向杜拉夫道歉"
        },
        {
          "role": "杜拉夫",
          "text": "你就是香菱，是吧？"
        },
        {
          "role": "香菱",
          "text": "对不起，杜拉夫先生，是我的不对。"
        },
        {
          "role": "杜拉夫",
          "text": "你做的那些事我都听说了。既然你人都来了——"
        },
        {
          "role": "派蒙",
          "text": "好、好可怕！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "暴、暴力是不对的！",
              "dialogues": []
            },
            {
              "text": "真要动手的话…冲着我来吧！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "杜拉夫",
          "text": "——请帮帮我们推广我们的肉产品吧！"
        },
        {
          "role": "香菱",
          "text": "…啊？"
        },
        {
          "role": "杜拉夫",
          "text": "不好意思，唐突了点，我这就跟你们解释。"
        },
        {
          "role": "杜拉夫",
          "text": "清泉镇向来以高品质的肉类闻名，但它的名声不应该只局限在蒙德。"
        },
        {
          "role": "杜拉夫",
          "text": "正好我听说大厨香菱来了蒙德，我就马上叫艾伦把你请过来了。"
        },
        {
          "role": "派蒙",
          "text": "大厨？"
        },
        {
          "role": "杜拉夫",
          "text": "你没听过吗？在璃月港独树一帜，主打平民菜品的「万民堂」，就是香菱掌厨。"
        },
        {
          "role": "杜拉夫",
          "text": "她对食材有独特的理解，做出来的菜深受当地居民喜爱，在游客中也是好评如潮。"
        },
        {
          "role": "香菱",
          "text": "嘿嘿，说得太夸张啦。我只是想做出便宜又好吃的东西而已。"
        },
        {
          "role": "杜拉夫",
          "text": "像香菱这样一流的大厨，用流的肉做出一流的料理，我们清泉镇的肉就能声名远扬了。"
        },
        {
          "role": "香菱",
          "text": "可是…这个请求我觉得我做不到。"
        },
        {
          "role": "香菱",
          "text": "我只考虑过怎么做出好吃的菜，没限制过食材，更没做过宣传。"
        },
        {
          "role": "杜拉夫",
          "text": "反正肉也是你想用的食材，我觉得没什么区别吧。"
        },
        {
          "role": "香菱",
          "text": "有区别，有很大的区别！比如我要加史莱姆凝液进去你会同意吗？"
        },
        {
          "role": "杜拉夫",
          "text": "这、这确实有点…不能用稍微正常一点的食材吗？"
        },
        {
          "role": "香菱",
          "text": "食材是没有正常不正常的！无论是什么只要方法得当，都能做出美味佳肴！"
        },
        {
          "role": "香菱",
          "text": "我不能让材料束缚我的灵感，那样做出来的东西注定是无聊的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "气场突然变得好强…",
              "dialogues": []
            },
            {
              "text": "这就是大厨的执着吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "杜拉夫",
          "text": "唉，既然态度这么坚决，那就算了吧。但是真的很可惜啊…"
        },
        {
          "type": "subtitle",
          "text": "跟上打算离开的香菱"
        },
        {
          "role": "派蒙",
          "text": "其实也不用拒绝得这么坚决吧我们不是来道歉的吗？"
        },
        {
          "role": "香菱",
          "text": "道歉是道歉，但是，嗯…做菜和这个是两回事。"
        },
        {
          "role": "香菱",
          "text": "嗯，这个味道？"
        },
        {
          "role": "香菱",
          "text": "好香啊。"
        },
        {
          "type": "subtitle",
          "text": "在香味的源头和香菱对话"
        },
        {
          "role": "香菱",
          "text": "你好，你做的这个料理我可以尝尝看吗？"
        },
        {
          "role": "布洛克",
          "text": "不好意思，这几天的份都预定满了，想吃的话要排到七天以后，可以吗？"
        },
        {
          "role": "派蒙",
          "text": "这么受欢迎啊…那一定很好吃！"
        },
        {
          "role": "旅行者",
          "text": "奇怪，明明有这么受欢迎的厨师…"
        },
        {
          "role": "派蒙",
          "text": "对哦，为什么杜拉夫先生还要找香菱啊？"
        },
        {
          "role": "布洛克",
          "text": "唉…可能是他觉得蒙德比起璃月港那种全大陆的商业枢纽，口味不够大众吧。"
        },
        {
          "role": "布洛克",
          "text": "但我不服气！我从来不觉得我做出来的肉会输给谁！"
        },
        {
          "role": "香菱",
          "text": "那就破例给我露一手嘛，或许我还能提一些建议什么的。"
        },
        {
          "role": "布洛克",
          "text": "普通人只会说「好吃」之类没用的话，你又不是呃…等等…你就是香菱？！"
        },
        {
          "role": "香菱",
          "text": "嗯，对啊。"
        },
        {
          "role": "布洛克",
          "text": "原来就是你！那你定也很会做肉了。"
        },
        {
          "role": "布洛克",
          "text": "其实我这里还留了一块今天最好的肉，如果让你来做烤肉，你会怎么做？"
        },
        {
          "role": "香菱",
          "text": "那要看肉质和脂肪含量了，这块肉我应该会岩烤，搭配海盐，绝云椒椒和清心花。"
        },
        {
          "role": "布洛克",
          "text": "清心花？！它遇热油香味会大量释放，比生冷时浓郁好几倍，肉的香味都会被盖掉的！"
        },
        {
          "role": "香菱",
          "text": "我知道的哦，但这清心花不是肉排的香料，而是配菜。"
        },
        {
          "role": "香菱",
          "text": "我尝试过，只要火候得当，过了油的清心花花瓣的苦味会被去除，变成口感爽脆的点心。"
        },
        {
          "role": "香菱",
          "text": "再选取长在高山上的绝云椒椒。低湿度和大温差，使得它能够产生特殊的干香风味。"
        },
        {
          "role": "香菱",
          "text": "海盐的咸，绝云椒椒的辣，肉排油脂的鲜香，汇聚在花瓣上，咬下去还有植物的清香。"
        },
        {
          "role": "布洛克",
          "text": "花里胡哨的，这不是喧宾夺主了吗？！"
        },
        {
          "role": "布洛克",
          "text": "烤肉就是烤肉，肉香被盖住了还吃什么？"
        },
        {
          "role": "派蒙",
          "text": "呜哇，别吵架，不要吵架啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "已经听不到其他人的声音了…",
              "dialogues": []
            },
            {
              "text": "这就是所谓的棋逢对手吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "哼，既然这样，烹饪的问题就用烹饪来解决好了！"
        },
        {
          "role": "香菱",
          "text": "我要和你切磋厨艺！"
        },
        {
          "role": "布洛克",
          "text": "完全没问题，要是连我的料理都比不过，那就证明杜拉夫是看走眼了。"
        },
        {
          "role": "香菱",
          "text": "好啊，那这样吧，如果我赢了，我获胜的料理就用来宣传清泉镇！"
        },
        {
          "role": "布洛克",
          "text": "你输了的话，就在「万民堂」的菜单上加上我的这道菜。"
        },
        {
          "role": "布洛克",
          "text": "上面还要写上，清泉镇肉类大师布洛克之作。"
        },
        {
          "role": "香菱",
          "text": "一言为定！"
        },
        {
          "role": "香菱",
          "text": "我先走一步去找食材了！在璃月等你们！"
        },
        {
          "role": "派蒙",
          "text": "喂，等等啊！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，只能跟上去了。"
        }
      ]
    },
    {
      "story_id": 11002,
      "title": "一锤定音的食材",
      "description": "然而杜拉夫却没有责备香菱，而是请她推广清泉镇的肉产品。坚守原则的香菱拒绝为了宣传而烹饪，正打算离开时却意外地被清泉镇大厨布洛克的料理所吸引。交谈中，两人在如何处理食材的问题上产生了分歧，约定以料理决一高下。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "寻找前往璃月的香菱"
        },
        {
          "type": "subtitle",
          "text": "与香菱交谈"
        },
        {
          "role": "香菱",
          "text": "应该是在这个附近吧…"
        },
        {
          "role": "派蒙",
          "text": "已经想到要找什么了吗？"
        },
        {
          "role": "香菱",
          "text": "当然没有！"
        },
        {
          "role": "派蒙",
          "text": "那为什么会这么理直气壮啊！"
        },
        {
          "role": "香菱",
          "text": "这是我的风格嘛，如果在做一道菜之前就想好了要做什么，那注定就是一份没有惊喜的料理。"
        },
        {
          "role": "香菱",
          "text": "同样，如果在找到之前就想好了要找什么，那也是没有惊喜的。"
        },
        {
          "role": "派蒙",
          "text": "这也太粗放了…"
        },
        {
          "role": "香菱",
          "text": "放心吧，「万民堂」的招牌菜都是这么来的。"
        },
        {
          "role": "香菱",
          "text": "先在周围随便看看吧，如果我看到中意的材料我会告诉你的。"
        },
        {
          "type": "subtitle",
          "text": "沿路向上，寻找合适的食材"
        },
        {
          "type": "subtitle",
          "text": "采集三朵莲蓬"
        },
        {
          "role": "香菱",
          "text": "快看快看，那里有好多莲蓬，都好新鲜！"
        },
        {
          "role": "香菱",
          "text": "莲子和肉搭配…说不定可以有！"
        },
        {
          "role": "香菱",
          "text": "去把莲蓬都采回来吧。"
        },
        {
          "type": "subtitle",
          "text": "继续前进，寻找合适的食材"
        },
        {
          "role": "香菱",
          "text": "嘿嘿，有这些应该就够了。"
        },
        {
          "role": "香菱",
          "text": "难得来璃月，我们顺路过去看看吧，可能还会有其他的好东西。"
        },
        {
          "type": "subtitle",
          "text": "采集三个绝云椒椒"
        },
        {
          "role": "香菱",
          "text": "啊，这个是绝云椒椒！"
        },
        {
          "role": "派蒙",
          "text": "听上去有点可爱呢。"
        },
        {
          "role": "香菱",
          "text": "名字是挺可爱的，但味道就很刺激了。"
        },
        {
          "role": "香菱",
          "text": "据我观察蒙德人很少吃辛辣的食物，正好可以用上这个。"
        },
        {
          "role": "香菱",
          "text": "把它摘下来吧，多摘几个！"
        },
        {
          "type": "subtitle",
          "text": "与香菱交谈"
        },
        {
          "role": "香菱",
          "text": "总觉得还缺点什么…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么？",
              "dialogues": []
            },
            {
              "text": "不够印象深刻吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "嗯，少一种「噼咔」的感觉。"
        },
        {
          "role": "派蒙",
          "text": "这么一说确实不够「噼咔」呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「噼咔」？！",
              "dialogues": []
            },
            {
              "text": "为什么派蒙能明白？！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼哼哼。"
        },
        {
          "role": "香菱",
          "text": "布洛克虽然守规矩了点，但还是有很强的实力的。"
        },
        {
          "role": "香菱",
          "text": "她一定会使用最得意的食材，想要取胜，就需要一道令人耳目一新的菜…"
        },
        {
          "role": "香菱",
          "text": "比如凉拌海兽肉啊，干煸清心花啊，史莱姆滑野蘑菇之类的！"
        },
        {
          "role": "派蒙",
          "text": "史、史莱姆滑野蘑菇？！"
        },
        {
          "role": "香菱",
          "text": "哈哈，我知道听着有点奇怪，但味道绝对是一级棒！"
        },
        {
          "role": "香菱",
          "text": "有机会做给你们尝尝吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好想吃。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "嘿嘿，味道不会让你失望的，就是卖相稍微有一点点奇怪。"
                }
              ]
            },
            {
              "text": "不、不用了。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "欸？明明就很好吃的…"
                }
              ]
            }
          ]
        },
        {
          "role": "香菱",
          "text": "先不说这个了，我想起来上次有个地方我还没去过。"
        },
        {
          "role": "香菱",
          "text": "我的直觉告诉我会有什么好东西，我们去找找看吧！"
        }
      ]
    },
    {
      "story_id": 11003,
      "title": "意外的收获",
      "description": "香菱认为只凭莲蓬和绝云椒椒这样的食材还不足以取胜,为了寻找特别的食材她再次踏上寻找之路。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往香菱提到的地方"
        },
        {
          "role": "香菱",
          "text": "那、那是…！"
        },
        {
          "role": "派蒙",
          "text": "有人受伤了！"
        },
        {
          "type": "subtitle",
          "text": "与香菱和瑟瑟发抖的人交谈"
        },
        {
          "role": "奥拉夫",
          "text": "好…好冷。"
        },
        {
          "role": "香菱",
          "text": "他的身子好冷！得赶快帮他暖暖才行！"
        },
        {
          "role": "派蒙",
          "text": "那在这里生火吧！"
        },
        {
          "role": "香菱",
          "text": "嗯，最好还能有一碗热汤。"
        },
        {
          "role": "香菱",
          "text": "旅行者，我在这里照顾他，能麻烦你去准备一份美味的热汤吗？"
        },
        {
          "role": "香菱",
          "text": "我记得来的路上有个丘丘人营地，那里多半就有能做汤的地方。"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "香菱",
          "text": "好的，准备好了就尽快回来！"
        },
        {
          "type": "subtitle",
          "text": "分支对话（奥拉夫）"
        },
        {
          "role": "奥拉夫",
          "text": "好冷啊…里面冷死了…"
        },
        {
          "type": "subtitle",
          "text": "分支对话（香菱）"
        },
        {
          "role": "香菱",
          "text": "我们来的时候路过了一个丘丘人营地，那里应该有能做汤的地方。"
        },
        {
          "role": "香菱",
          "text": "我在这里照顾他，麻烦你去准备一碗美味的热汤，给他暖暖身子吧！"
        },
        {
          "type": "subtitle",
          "text": "烹制「美味的萝卜时蔬汤」"
        },
        {
          "type": "subtitle",
          "text": "给猎人送上做好的汤"
        },
        {
          "role": "奥拉夫",
          "text": "哈啊…哈啊…好多了。"
        },
        {
          "role": "奥拉夫",
          "text": "谢谢你们，这碗汤真好喝。"
        },
        {
          "role": "旅行者",
          "text": "怎么会冻成这个样子？"
        },
        {
          "role": "奥拉夫",
          "text": "我本来在追一只野猪，追了好远，它逃进了那边的地下遗迹里。"
        },
        {
          "role": "奥拉夫",
          "text": "我追进去，却遇到了一棵好大好大的急冻树。"
        },
        {
          "role": "奥拉夫",
          "text": "我被冻僵了，清醒之后就跑了出来，但跑到这里身子就使不上劲了。"
        },
        {
          "role": "香菱",
          "text": "急冻树？一棵树，还会攻击人？"
        },
        {
          "role": "奥拉夫",
          "text": "是啊，我以前只是听别人说过，亲眼见到还是头一次。"
        },
        {
          "role": "派蒙",
          "text": "听起来好危险.我们还是不要靠近那个遗迹吧。"
        },
        {
          "role": "香菱",
          "text": "说不定会很好吃！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…啊？",
              "dialogues": []
            },
            {
              "text": "这也能联想到吃的？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "就是这个！一锤定音的食材，肯定会很好吃的！"
        },
        {
          "role": "派蒙",
          "text": "冷静啊，这么凶猛的植物真的能吃吗？"
        },
        {
          "role": "香菱",
          "text": "不试试看怎么知道，快，我们出发吧！"
        },
        {
          "role": "派蒙",
          "text": "又跑掉了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们要先走一步了。",
              "dialogues": []
            },
            {
              "text": "你先回清泉镇吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥拉夫",
          "text": "没事，不用管我，但一定要阻止她，很危险的。"
        }
      ],
      "collapse_ranges": [
        [
          12,
          13
        ],
        [
          14,
          16
        ]
      ]
    },
    {
      "story_id": 11004,
      "title": "远古的馈赠",
      "description": "听说遗迹中有巨大的急冻树，香菱产生了兴趣，急急忙忙跑进了地下遗迹。你们担心香菱冲动之下遇到危险，紧跟着也进入了遗迹。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "追上闯入遗迹的香菱"
        },
        {
          "role": "派蒙",
          "text": "别冲这么快呀，遗迹里很危险的。"
        },
        {
          "role": "香菱",
          "text": "食材的鲜度是不等人的！"
        },
        {
          "role": "香菱",
          "text": "别挡路别挡路！"
        },
        {
          "role": "派蒙",
          "text": "没想到这么能打…"
        },
        {
          "role": "派蒙",
          "text": "看来能到处收集食材，靠的不只是气势呢。"
        },
        {
          "type": "subtitle",
          "text": "深入遗迹，寻找食材"
        },
        {
          "type": "subtitle",
          "text": "与香菱交谈"
        },
        {
          "role": "香菱",
          "text": "急冻树，急冻树，好吃的~急冻树~"
        },
        {
          "role": "派蒙",
          "text": "急冻树~"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你太捧场了吧。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "那是你太拘谨了！拿到珍稀的食材，这世界上还会有比这更开心的事吗？"
                }
              ]
            },
            {
              "text": "急冻树~",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "哈哈哈，为什么你们唱出来就怪怪的。"
                }
              ]
            }
          ]
        },
        {
          "role": "香菱",
          "text": "啊，这边好像还有什么东西"
        },
        {
          "role": "派蒙",
          "text": "这就是猎人先生说的他在追的野猪吧。"
        },
        {
          "role": "派蒙",
          "text": "但这种花纹从来没有见过…"
        },
        {
          "role": "香菱",
          "text": "我好像见过这个纹路！我想想，我想想…啊对了，是《璃月风物志》！"
        },
        {
          "role": "香菱",
          "text": "这种花纹.嗯，不会错的！这是已经灭绝了三百多年的野猪！"
        },
        {
          "role": "派蒙",
          "text": "欸？！这么长时间，但为什么会还活着？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "因为被冻住了吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "有道理。"
                }
              ]
            },
            {
              "text": "因为比较长寿？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那也太长寿了吧！"
                }
              ]
            }
          ]
        },
        {
          "role": "香菱",
          "text": "书里讲过，这种野猪就是因为肉质太鲜美，所以被捕杀灭绝了。"
        },
        {
          "role": "香菱",
          "text": "急冻树和野猪，捡到两个宝贝了！"
        },
        {
          "role": "旅行者",
          "text": "这下胜券在握了。"
        },
        {
          "role": "香菱",
          "text": "嗯，我们这就回清泉镇吧！"
        }
      ]
    },
    {
      "story_id": 11005,
      "title": "料理对决",
      "description": "得到了珍稀的食材之后，香菱终于做好了进行料理对决的准备。两位大厨之间的胜负即将开始。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "回到清泉镇，参加料理对决"
        },
        {
          "role": "奥拉夫",
          "text": "这里…真的是清泉镇没错吧？"
        },
        {
          "role": "杜拉夫",
          "text": "是的啊，我都回答了很多次了，但是你要找的人我一个都不认识。"
        },
        {
          "role": "奥拉夫",
          "text": "不可能啊，他们都住在清泉镇，都是我的邻居和朋友。"
        },
        {
          "role": "杜拉夫",
          "text": "这就奇怪了，到底是怎么回事啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道说？",
              "dialogues": []
            },
            {
              "text": "我大概明白了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你想到什么了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这位猎人也是三百多年前幸存下来的。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸欸——！人类可以活这么长时间吗？"
                }
              ]
            },
            {
              "text": "他说的是很久以前的清泉镇。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "很久以前…难道是几百年前？！"
                }
              ]
            }
          ]
        },
        {
          "role": "香菱",
          "text": "这这这…这真的说得通吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他和野猪都被冻僵了。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "哦哦，是不是和食材保鲜的道理一样啊！"
                }
              ]
            },
            {
              "text": "冰冻可以保鲜，这么说你更容易理解吧。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "嘿嘿，你这么解释我一下子就明白啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "杜拉夫",
          "text": "但就算这么说，还是难以置信。"
        },
        {
          "role": "派蒙",
          "text": "可是…不是这样的话，也没有更合理的说法了。"
        },
        {
          "role": "杜拉夫",
          "text": "那…你叫什么名字？"
        },
        {
          "role": "奥拉夫",
          "text": "我叫奥拉夫。"
        },
        {
          "role": "杜拉夫",
          "text": "啊？这个名字，我在族谱上见过！"
        },
        {
          "role": "杜拉夫",
          "text": "虽然记不得辈分，但确实是有这个名字的！"
        },
        {
          "role": "香菱",
          "text": "也就说，是曾曾曾曾.好多个曾的祖父了！"
        },
        {
          "role": "旅行者",
          "text": "其实也没隔得那么远。"
        },
        {
          "role": "派蒙",
          "text": "居然还有这么神奇的事啊。"
        },
        {
          "role": "香菱",
          "text": "嘿嘿，虽然时间晚了这么久，还是团圆了，皆大欢喜皆大欢喜！"
        },
        {
          "role": "香菱",
          "text": "奥拉夫先生有没有兴趣来看我们的料理对决啊？"
        },
        {
          "role": "杜拉夫",
          "text": "哦哦，对了，对决的事情我听布洛克说了，我已经把场地布置好了。"
        },
        {
          "role": "杜拉夫",
          "text": "都跟我来吧。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（杜拉夫）"
        },
        {
          "role": "杜拉夫",
          "text": "蒙德和璃月的料理碰撞，想想就让人觉得兴奋。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（奥拉夫）"
        },
        {
          "role": "奥拉夫",
          "text": "我们原来都是烤一烤就直接吃，现在居然有这么多花样了…"
        },
        {
          "type": "subtitle",
          "text": "分支对话（布洛克）"
        },
        {
          "role": "布洛克",
          "text": "怎么？来打探敌情？"
        },
        {
          "role": "布洛克",
          "text": "哼哼，我已经拿到了必胜的材料，你们不可能赢的。"
        },
        {
          "type": "subtitle",
          "text": "分支对话（齐格芙丽雅）"
        },
        {
          "role": "齐格芙丽雅",
          "text": "好香啊…偷吃一点应该没关系吧？"
        },
        {
          "role": "齐格芙丽雅",
          "text": "不行不行，我是来帮忙的…比赛要紧，比赛要紧！"
        },
        {
          "type": "subtitle",
          "text": "在料理对决现场与香菱交谈"
        },
        {
          "role": "香菱",
          "text": "我们的食材已经都准备好了，你呢？"
        },
        {
          "role": "布洛克",
          "text": "当然准备好了。对决的时候，齐格芙丽雅会担任我的副手。"
        },
        {
          "role": "杜拉夫",
          "text": "那现在开始比赛，我就来当这个评委了。"
        },
        {
          "role": "杜拉夫",
          "text": "放心，虽然我认识布洛克时间更长，但我会公正评判的。"
        },
        {
          "role": "香菱",
          "text": "那就拜托你了。旅行者，派蒙，我们快去做准备吧！"
        },
        {
          "role": "派蒙",
          "text": "我们还要参加吗？"
        },
        {
          "role": "香菱",
          "text": "当然了，布洛克都找了副手，你们就当我的副手吧！关键时候都靠你们了！"
        },
        {
          "role": "派蒙",
          "text": "什么时候变成副手了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "奉陪到底吧。",
              "dialogues": []
            },
            {
              "text": "拿她没办法…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧，为了好吃的我也会努力的！"
        },
        {
          "type": "subtitle",
          "text": "在料理对决中协助香菱"
        },
        {
          "role": "香菱",
          "text": "首先是食材的问题，肉排需要点缀，但食材里我没找到很合适的。嗯，我想想…"
        },
        {
          "role": "香菱",
          "text": "啊，我想到了，用白萝卜吧！白萝卜削成泥，或者切成丝都很爽口。"
        },
        {
          "role": "香菱",
          "text": "还能雕成花来装饰！一举两得！"
        },
        {
          "role": "香菱",
          "text": "麻烦你去找一下白萝卜吧，这附近应该就有。对了对了，要洗干净！因为是直接入菜的！"
        },
        {
          "type": "subtitle",
          "text": "寻找白萝卜"
        },
        {
          "role": "香菱",
          "text": "麻烦找些白萝卜回来，记得要去湖边洗干净哦？"
        },
        {
          "type": "subtitle",
          "text": "前往湖边清洗白萝卜"
        },
        {
          "type": "subtitle",
          "text": "过场对话"
        },
        {
          "role": "派蒙",
          "text": "呜哇！是史莱姆！吓死人了！"
        },
        {
          "role": "派蒙",
          "text": "这里离对决的地方这么近，它们会不会去现场捣乱啊？"
        },
        {
          "role": "派蒙",
          "text": "要不然还是消灭它们吧，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "将洗干净的白萝卜交给香菱"
        },
        {
          "role": "香菱",
          "text": "哇，又大又水灵，太完美了，谢谢你们！"
        },
        {
          "role": "香菱",
          "text": "嗯，我想想看，要不然…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！你看，香菱，锅都烧起来了！"
        },
        {
          "role": "香菱",
          "text": "啊啊啊！不好！这样会烧焦的！"
        },
        {
          "role": "香菱",
          "text": "旅行者，快帮我把锅的火控制下来！记得别用水去浇啊，不然也白做了！"
        },
        {
          "type": "subtitle",
          "text": "控制三口锅的火势"
        },
        {
          "role": "香菱",
          "text": "块把火压下去，要烧焦了！"
        },
        {
          "type": "subtitle",
          "text": "继续帮助香菱"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "成功控制火势",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "谢谢你，总算全都保住了，我尝了一下，味道还算过得去。"
                }
              ]
            },
            {
              "text": "未成功控制火势",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "啊啊…全都烧焦了，呜呜呜，只好再做一些了。"
                }
              ]
            }
          ]
        },
        {
          "role": "香菱",
          "text": "对了，我在考虑主菜是不是单薄了一些，想要有一些变化。"
        },
        {
          "role": "香菱",
          "text": "帮我做一份野菇鸡肉串吧！外面咔嚓咔嚓，里面滴答滴答的那种！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听不懂…",
              "dialogues": []
            },
            {
              "text": "派蒙帮我翻译一下！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "就是要美味的，最美味的那种！"
        },
        {
          "type": "subtitle",
          "text": "烹饪「美味的野菇鸡肉串」"
        },
        {
          "role": "香菱",
          "text": "咔嚓咔嚓，滴答滴答~咔嚓咔嚓，滴答滴答~"
        },
        {
          "type": "subtitle",
          "text": "将「美味的野菇鸡肉串」交给香菱"
        },
        {
          "role": "香菱",
          "text": "好香啊，旅行者，你真是有做菜的天赋！"
        },
        {
          "role": "香菱",
          "text": "现在主菜的制作很顺利，但距离完美…可能还差点特别的感觉。"
        },
        {
          "role": "派蒙",
          "text": "感觉？"
        },
        {
          "role": "香菱",
          "text": "就是那种「噼咔」的感觉！"
        },
        {
          "role": "派蒙",
          "text": "啊啊，原来是「噼咔」的感觉！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么你又理解了！",
              "dialogues": []
            },
            {
              "text": "所以这到底是外语还是方言啊！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "香菱",
          "text": "如果只是这样端上去，太浪费这么好的材料了。"
        },
        {
          "role": "香菱",
          "text": "我想想看…啊啊，如果能有什么能增添风味的东西就好了。"
        },
        {
          "role": "派蒙",
          "text": "风味？"
        },
        {
          "role": "香菱",
          "text": "对，最好是就在这附近有的，很少用来入菜的生物。"
        },
        {
          "role": "香菱",
          "text": "天上飞的，地上爬的都行，可以是昆虫，或者…蹦蹦跳跳的？"
        },
        {
          "role": "派蒙",
          "text": "真的要加听起来这么恐怖的东西进去吗？"
        },
        {
          "role": "香菱",
          "text": "没事啦，相信我的直觉！"
        },
        {
          "role": "派蒙",
          "text": "好吧…"
        },
        {
          "type": "subtitle",
          "text": "找到符合描述的食材"
        },
        {
          "type": "subtitle",
          "text": "询问香菱对食材是否满意"
        },
        {
          "role": "派蒙",
          "text": "真的要加这种东西进去吗…"
        },
        {
          "role": "派蒙",
          "text": "总感觉会怪怪的。"
        },
        {
          "role": "香菱",
          "text": "放心放心，谢谢你们找来这么好的东西，我现在要专心料理了。"
        },
        {
          "role": "香菱",
          "text": "如果还有需要帮忙的事，还要再麻烦你们了，嘿嘿！"
        },
        {
          "type": "subtitle",
          "text": "询问香菱是否还需帮忙"
        },
        {
          "role": "香菱",
          "text": "对了对了，配菜。还需要一道配菜！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来做吧。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "欸？没问题吗？"
                }
              ]
            },
            {
              "text": "就算我不说也会让我来做吧。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "谢谢！你很了解我嘛，嘿嘿。"
                }
              ]
            }
          ]
        },
        {
          "role": "香菱",
          "text": "那么这个就交给你了,这是我临时写的！"
        },
        {
          "role": "香菱",
          "text": "里面提到的材料也全都给你们。"
        },
        {
          "role": "派蒙",
          "text": "这就是你之前给我们吃的那个菜的食谱吗？！"
        },
        {
          "role": "香菱",
          "text": "是的，我又改良了一下，把多出来的璃月食材用上了。"
        },
        {
          "role": "派蒙",
          "text": "这么难的料理，真的能做好吗…"
        },
        {
          "role": "香菱",
          "text": "料理技术不重要，重要的是热爱！这是爸爸告诉我的。"
        },
        {
          "role": "香菱",
          "text": "你们帮了我这么多忙，一定也非常热爱料理吧。"
        },
        {
          "role": "香菱",
          "text": "我相信你们，绝对能做出最美味的配菜的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "我喜欢这么有自信的回答！"
                }
              ]
            },
            {
              "text": "希望不会拖后腿。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "别这么想，烹饪是件很快乐的事，放轻松放轻松！"
                }
              ]
            }
          ]
        },
        {
          "role": "香菱",
          "text": "准备好，最后冲刺啦！"
        },
        {
          "type": "subtitle",
          "text": "烹饪「美味的翡玉什锦袋」"
        },
        {
          "type": "subtitle",
          "text": "将「美味的翡玉什锦袋」交给香菱"
        },
        {
          "role": "香菱",
          "text": "哇，香味在很远的地方就已经飘过来了！"
        },
        {
          "role": "香菱",
          "text": "一切就绪，准备出菜！我们一定会赢的！"
        },
        {
          "type": "subtitle",
          "text": "与杜拉夫交谈，等待结果"
        },
        {
          "role": "杜拉夫",
          "text": "真是美味的大餐，居然能吃到这么好吃的东西。"
        },
        {
          "role": "杜拉夫",
          "text": "两位大厨的手艺我都尝过了，实在是难分高下。"
        },
        {
          "role": "杜拉夫",
          "text": "不过既然是比赛就要有胜负，在这里我宣布"
        },
        {
          "role": "杜拉夫",
          "text": "香菱的料理更胜一筹。"
        },
        {
          "role": "香菱",
          "text": "耶！赢啦！太好了！"
        },
        {
          "role": "布洛克",
          "text": "唉，本来以为我的「野猪王在争夺地盘的决斗后负伤的胜者刚刚长好的那块新鲜嫩肉」是不会输的啊。"
        },
        {
          "role": "布洛克",
          "text": "果然还是敌不过已经灭绝的野猪肉的味道。"
        },
        {
          "role": "杜拉夫",
          "text": "什么？这居然是用已经灭绝的猪肉做的？"
        },
        {
          "role": "香菱",
          "text": "对啊，全都做成料理了。"
        },
        {
          "role": "杜拉夫",
          "text": "那我岂不是一口吃掉了几十万摩拉！"
        },
        {
          "role": "杜拉夫",
          "text": "要是拿去卖的话，能顶得上镇子几年狩猎的收入了吧！"
        },
        {
          "role": "香菱",
          "text": "哈哈，好吃就可以了，摩拉什么的不重要啦。"
        },
        {
          "role": "香菱",
          "text": "对了，既然评审已经结束了，大家都来尝尝吧！我做了很多的！"
        },
        {
          "role": "香菱",
          "text": "我也尝尝布洛克的手艺。"
        },
        {
          "role": "布洛克",
          "text": "这种美味…唉，输得心服口服呢。"
        },
        {
          "role": "齐格芙丽雅",
          "text": "输是输了，但能吃到这么好吃的菜，我也满足了！麻烦再来一份！"
        },
        {
          "role": "香菱",
          "text": "原来这个也这么美味，这层次分明的口感…"
        },
        {
          "role": "香菱",
          "text": "要是我没有这块美味的肉，还有旅行者做得这么棒的配菜，胜负真不好说啊。"
        },
        {
          "role": "派蒙",
          "text": "轮到我来吃了！"
        },
        {
          "role": "奥拉夫",
          "text": "我也尝一点吧。"
        },
        {
          "role": "奥拉夫",
          "text": "这…这味道？！"
        },
        {
          "role": "奥拉夫",
          "text": "是清泉镇…不，应该说是以前的清泉镇的味道。"
        },
        {
          "role": "旅行者",
          "text": "好吃到哭了…"
        },
        {
          "role": "奥拉夫",
          "text": "呜呜，这是-这是，最后几口那个时代的味道了…"
        },
        {
          "role": "香菱",
          "text": "啊啊，别伤心，别伤心，你想要这种味道的话，我还可以做的！"
        },
        {
          "role": "奥拉夫",
          "text": "真、真的吗？但是那种古代野猪已经灭绝了…"
        },
        {
          "role": "香菱",
          "text": "是这样没错，但是味道没有灭绝啊，用其他的材料还可以做出来的。"
        },
        {
          "role": "香菱",
          "text": "给食客带来笑容，这就是厨师的使命啊！"
        },
        {
          "role": "奥拉夫",
          "text": "谢谢你，呜…呜呜呜呜…"
        },
        {
          "type": "subtitle",
          "text": "接受香菱的感谢"
        },
        {
          "role": "香菱",
          "text": "非常感谢你，没有你的帮忙，还不知道会怎么样呢。"
        },
        {
          "role": "派蒙",
          "text": "也多亏你，我尝到了好多好多好吃的东西。"
        },
        {
          "role": "派蒙",
          "text": "好饱好饱。"
        },
        {
          "role": "旅行者",
          "text": "接下来打算去哪里？"
        },
        {
          "role": "香菱",
          "text": "不知道，打算回一趟璃月港，但可能中途就改变了计划。"
        },
        {
          "role": "香菱",
          "text": "因为我不喜欢计划这种东西嘛。"
        },
        {
          "role": "香菱",
          "text": "说不定你又会在野外的某个地方遇到我。"
        },
        {
          "role": "派蒙",
          "text": "真是洒脱啊。"
        },
        {
          "role": "香菱",
          "text": "我觉得你很有料理的天赋，旅行者，翡玉什锦袋完成得很好。"
        },
        {
          "role": "香菱",
          "text": "有空来「万民堂」吧！说好了请你们吃好吃的！"
        },
        {
          "role": "香菱",
          "text": "如果想学的话，还能教你几道创新菜！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一言为定。",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "一言为定！"
                }
              ]
            },
            {
              "text": "史莱姆滑野蘑菇就免了…",
              "dialogues": [
                {
                  "role": "香菱",
                  "text": "啊？为什么你会知道我在想什么？！"
                }
              ]
            }
          ]
        },
        {
          "role": "香菱",
          "text": "嘿嘿，那我们有机会再见啦，旅行者！"
        }
      ],
      "collapse_ranges": [
        [
          23,
          24
        ],
        [
          25,
          26
        ],
        [
          27,
          29
        ],
