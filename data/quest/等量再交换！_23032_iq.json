{
  "quest_id": 23032,
  "chapter_num": null,
  "chapter_title": "等量再交换！",
  "type": "iq",
  "route": "Equivalent Exchange Once More",
  "stories": [
    {
      "story_id": 23032,
      "title": "等量再交换！",
      "description": "在须弥城里，你看见了一个熟悉的身影…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与维克多对话"
        },
        {
          "role": "维克多",
          "text": "旅行者，你来得正好。"
        },
        {
          "role": "旅行者",
          "text": "你的木雕怎么样了？"
        },
        {
          "role": "维克多",
          "text": "呃…我偷偷做木雕的事被弗谢沃洛德先生给发现了…"
        },
        {
          "role": "维克多",
          "text": "不过，他倒是也没怎么发脾气，就是让我工作的时候别做闲事…还找我要了个小兔子的木雕。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他不会也有孩子要哄吧…",
              "dialogues": []
            },
            {
              "text": "你们愚人众真有童心…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维克多",
          "text": "弗谢沃洛德先生说，我做的木雕很有至冬的风格，他很喜欢。"
        },
        {
          "role": "维克多",
          "text": "我听人说，弗谢沃洛德先生一直因为命令在外奔波，已经很久没有回过至冬陪过家人了。"
        },
        {
          "role": "维克多",
          "text": "我觉得，也许他和我不一样，是真的想家了吧…"
        },
        {
          "role": "维克多",
          "text": "唉，闲话就说到这，旅行者，我又找哈马维订了一批木头，请你帮我去看看吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "报酬准备好。",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "你就放心吧，这次都是真金白银的报酬。"
                }
              ]
            },
            {
              "text": "你不想回至冬吗？",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "我倒是还好…我在至冬又没什么亲人，也习惯一个人到处跑了。而且在须弥我过得还挺舒服的…"
                },
                {
                  "role": "维克多",
                  "text": "我之前说想回至冬，只不过是因为蒙德太无聊啦…咳！"
                },
                {
                  "role": "维克多",
                  "text": "总之这件事就拜托你了，报酬我会准备好的。"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "旅行者，你来得正好，快来帮我个忙。"
        },
        {
          "role": "旅行者",
          "text": "你又在折腾什么…"
        },
        {
          "role": "维克多",
          "text": "我正在尝试用至冬的烹饪方法来制作须弥的料理呢。"
        },
        {
          "role": "维克多",
          "text": "不过，须弥的香料有好多我都不认识，只能一点点试错…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这也是愚人众的工作吗？",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "呃…调查香料的质量，这当然是算在后勤工作的范围里啦。"
                }
              ]
            },
            {
              "text": "你过得还挺开心啊…",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "啊？这个…一般开心吧，毕竟每天还要工作呢。"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "我们说正事，因为我…调查香料的工作排期安排得太紧，所以材料的消耗量也很大。"
        },
        {
          "role": "维克多",
          "text": "我在和弗谢沃洛德先生讨论后，决定委托兰巴德先生帮我们采购香料。"
        },
        {
          "role": "维克多",
          "text": "我们经常去这位先生的餐厅吃饭，很信任他在食材方面的眼光。"
        },
        {
          "role": "维克多",
          "text": "旅行者，请你帮我去问问兰巴德先生香料的采购情况吧。"
        },
        {
          "role": "维克多",
          "text": "顺便…再问问他有没有准备好吃的，看这样子也快到饭点了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": []
            },
            {
              "text": "后一个才是重点吧！",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "这也是我工作的一环啊！我是那种玩忽职守，只惦记吃饭的人吗？你就相信我吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "可惜弗谢沃洛德先生一直在外工作，不然我都想把你介绍给他了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我可不想认识愚人众。",
              "dialogues": []
            },
            {
              "text": "我可不想加入愚人众。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维克多",
          "text": "就是打个招呼啦，我们俩又不是什么身居要职的大员，两个管后勤的人，能给你带来什么麻烦？"
        },
        {
          "role": "维克多",
          "text": "总之，这件事就拜托你了，旅行者。"
        },
        {
          "role": "维克多",
          "text": "这些香料怎么这么贵…"
        },
        {
          "role": "旅行者",
          "text": "你还没买到香料吗？"
        },
        {
          "role": "维克多",
          "text": "旅行者！你可算是来了，那个…我问你个事…"
        },
        {
          "role": "维克多",
          "text": "你，你包里还有蒙德的「风车菊」吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你怎么突然提起这个？",
              "dialogues": []
            },
            {
              "text": "你要风车菊干嘛？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维克多",
          "text": "我之前不是在忙香料的事吗？在和兰巴德讨论的时候，我听他提起了一种叫做「香包」的东西。"
        },
        {
          "role": "维克多",
          "text": "具体来说，就是把各种花晒干放在小布囊里，讲究的人还会洒一点香水在上面…"
        },
        {
          "role": "维克多",
          "text": "这种「香包」可是很受女性欢迎的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没想到啊，维克多…",
              "dialogues": []
            },
            {
              "text": "你是真想在须弥定居啊…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维克多",
          "text": "不，不是！你往哪边想了？上次我们不是提起过，给莉莉寄信这件事吗？"
        },
        {
          "role": "维克多",
          "text": "我想了半天，决定还是给莉莉写一封信，毕竟当时我连再见都没说，实在是说不过去…"
        },
        {
          "role": "维克多",
          "text": "当然啦，我是绝对做不好香包这种东西的，制作材料也不够，所以只能拜托朱特帮我搜集各种材料。"
        },
        {
          "role": "维克多",
          "text": "但他店里的那些香料价钱太高了，我可买不起…所以我也和他做了一个「等量交换」。"
        },
        {
          "role": "维克多",
          "text": "简单来说，就是我拿一些稀奇的植物给他，而他则帮我注意一下稀奇的香料。"
        },
        {
          "role": "维克多",
          "text": "上次我答应朱特，要帮他找一株「风车菊」回来，但我现在也没办法回蒙德…"
        },
        {
          "role": "维克多",
          "text": "旅行者，你能帮我这个忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "报酬准备好。",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "没问题，肯定给你准备足！"
                }
              ]
            },
            {
              "text": "这不会又是愚人众的计划吧…",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "怎么可能，这要是愚人众的计划，弗谢沃洛德先生就会直接去找人拨款了，我为什么还要单独请你帮忙…"
                },
                {
                  "role": "维克多",
                  "text": "再说了，我现在恨不得从愚人众彻底离开，根本不想再操心什么愚人众的计划。"
                },
                {
                  "role": "维克多",
                  "text": "我真是受够了被人处处提防了…"
                },
                {
                  "role": "维克多",
                  "text": "哎，你可不要和别人说啊，不然我准要被叫去谈话了…"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "那这件事就拜托你了，我就在这等着你。"
        },
        {
          "role": "维克多",
          "text": "不过，给莉莉的信我要怎么开头呢…"
        },
        {
          "type": "subtitle",
          "text": "与哈马维对话"
        },
        {
          "role": "哈马维",
          "text": "真是倒霉…"
        },
        {
          "role": "旅行者",
          "text": "关于维克多的木头…"
        },
        {
          "role": "哈马维",
          "text": "你是说那个愚人众找我订的木头吧。"
        },
        {
          "role": "哈马维",
          "text": "唉，别提了，我就说和愚人众做生意不会有好运气。"
        },
        {
          "role": "哈马维",
          "text": "那批木头运到一半就被魔物袭击了，人是全跑回来了，但车毁了，木头都丢在了半路上。"
        },
        {
          "role": "哈马维",
          "text": "唉，现在这情况，我是不敢过去了，一时半会也找不到人去赶走那些魔物…"
        },
        {
          "role": "旅行者",
          "text": "我不是愚人众…"
        },
        {
          "role": "哈马维",
          "text": "你不是愚人众吗？那你怎么帮他做事？奇怪…"
        },
        {
          "role": "哈马维",
          "text": "无论如何，那辆车我暂时是拉不回来了，我只能等到能雇到人之后再想办法。"
        },
        {
          "role": "哈马维",
          "text": "如果你着急要木头的话，我把那辆车大概的地方给你标在地图上，你自己过去看看吧。"
        },
        {
          "role": "哈马维",
          "text": "唉，只要和愚人众沾边果然就遇不上好事…"
        },
        {
          "type": "subtitle",
          "text": "前往货车所在地点"
        },
        {
          "role": "维克多",
          "text": "没想到，我还能把木雕手艺重新捡起来…"
        },
        {
          "type": "subtitle",
          "text": "打倒所有蕈兽，并拿回木板"
        },
        {
          "role": "哈马维",
          "text": "唉，只要和愚人众沾边果然就遇不上好事…"
        },
        {
          "type": "subtitle",
          "text": "向哈马维回报"
        },
        {
          "role": "哈马维",
          "text": "唉，只要和愚人众沾边果然就遇不上好事…"
        },
        {
          "role": "旅行者",
          "text": "关于维克多的木头…"
        },
        {
          "role": "哈马维",
          "text": "这木头是…你已经把魔物都赶走了？看不出来，你还挺能打的…"
        },
        {
          "role": "哈马维",
          "text": "多谢你了，我等会就找人和我一起过去，把木头给弄回来。"
        },
        {
          "role": "哈马维",
          "text": "唉，只要和愚人众沾边果然就遇不上好事…"
        },
        {
          "type": "subtitle",
          "text": "与维克多对话"
        },
        {
          "role": "维克多",
          "text": "怎么样，我买的木头已经到了吗？"
        },
        {
          "role": "？？？",
          "text": "向维克多叙述了事情的过程…"
        },
        {
          "role": "维克多",
          "text": "又是魔物？我怎么感觉全世界的货车都很容易被魔物袭击…"
        },
        {
          "role": "维克多",
          "text": "算了，反正木头能送回来就行。"
        },
        {
          "role": "维克多",
          "text": "喏，这是说好的报酬，好好数一数吧。"
        },
        {
          "role": "维克多",
          "text": "还有…那个，莉莉还好吗？"
        },
        {
          "role": "维克多",
          "text": "我走的时候也没和那丫头当面道别，她没生气吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她很好。",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "那就行，咳…你别这么看着我，我就是关心一下啊！"
                }
              ]
            },
            {
              "text": "你自己回去看看她呗。",
              "dialogues": [
                {
                  "role": "维克多",
                  "text": "那弗谢沃洛德先生非得踢我不可，算了吧。"
                },
                {
                  "role": "维克多",
                  "text": "我也不太敢直接寄信过去。"
                },
                {
                  "role": "维克多",
                  "text": "收到一封来自愚人众的信，听起来就不像什么好事，哈哈哈…"
                }
              ]
            }
          ]
        },
        {
          "role": "维克多",
          "text": "不说这些了，再数数报酬吧，旅行者，我可是一分都没少你的。"
        },
        {
          "type": "subtitle",
          "text": "与兰巴德对话"
        },
        {
          "role": "兰巴德",
          "text": "你好，请问有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于维克多的委托…"
        },
        {
          "role": "兰巴德",
          "text": "噢，你是说他拜托我采购的香料吧，都已经采购好了，过会我就把东西送过去。"
        },
        {
          "role": "兰巴德",
          "text": "午饭嘛…哎呀，今天的客人有点多，食材都用得差不多了…"
        },
        {
          "role": "兰巴德",
          "text": "这样好了，旅行者，请你帮我去拿两个土豆回来吧。"
        },
        {
          "role": "兰巴德",
          "text": "作为回报…我也会给你做一道「绿汁脆球」的，拜托你了。"
        },
        {
          "type": "subtitle",
          "text": "与兰巴德对话"
        },
        {
          "role": "朱特",
          "text": "你拿到风车菊了吗？"
        },
        {
          "type": "subtitle",
          "text": "与兰巴德对话"
        },
        {
          "role": "兰巴德",
          "text": "太好了，这些就足够了，请你稍等一下…"
        },
        {
          "role": "？？？",
          "text": "兰巴德开始了烹饪…"
        },
        {
          "role": "兰巴德",
          "text": "完成了，这份「绿汁脆球」是给你的，其余两份「绿汁脆球」你就带回去给那两个人吧。"
        },
        {
          "type": "subtitle",
          "text": "与维克多对话"
        },
        {
          "role": "维克多",
          "text": "弗谢沃洛德先生一天到晚都在外忙碌，我听说他已经很多年没回至冬了。真不知道他是怎么撑下来的…"
        },
        {
          "role": "维克多",
          "text": "怎么样，兰巴德怎么说？"
        },
        {
          "role": "？？？",
          "text": "向维克多叙述了事情的过程…"
        },
        {
          "role": "维克多",
          "text": "兰巴德果然是个靠谱的老板啊，人也很好。"
        },
        {
          "role": "维克多",
          "text": "不像其他人，一看见我们是愚人众，本能地就开始提防我们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这怪你们自己好吗？",
              "dialogues": []
            },
            {
              "text": "这纯粹是愚人众的错…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "维克多",
          "text": "哎，这道菜闻着真不错啊，弗谢沃洛德先生应该也会很喜欢的。"
        },
        {
          "role": "旅行者",
          "text": "你这家伙…"
        },
        {
          "role": "维克多",
          "text": "这是说好的报酬，数一数吧旅行者，好好数一数。"
        },
        {
          "type": "subtitle",
          "text": "与朱特对话"
        },
        {
          "role": "朱特",
          "text": "风车菊会是什么气味呢…"
        },
        {
          "role": "旅行者",
          "text": "关于维克多的委托…"
        },
        {
          "role": "朱特",
          "text": "没错，我确实和他约定好了，他帮我去找各种稀奇的植物，我则帮他想办法做香包。"
        },
        {
          "role": "朱特",
          "text": "你是他请来帮忙的人吧，如果拿到风车菊的话，直接给我就行了。"
        },
        {
          "type": "subtitle",
          "text": "与朱特对话"
        },
        {
          "type": "subtitle",
          "text": "与朱特对话"
        },
        {
          "role": "朱特",
          "text": "这就是风车菊吗？唔，确实是一种有趣的植物…"
        },
        {
          "role": "朱特",
          "text": "这株风车菊我就收下了，香包的事我会继续想办法的。"
        },
        {
          "type": "subtitle",
          "text": "与维克多对话"
        },
        {
          "role": "兰巴德",
          "text": "你拿到土豆了吗？"
        },
        {
          "role": "维克多",
          "text": "旅行者，事情怎么样了？"
        },
        {
          "role": "？？？",
          "text": "向维克多叙述了事情的经过…"
        },
        {
          "role": "维克多",
          "text": "太好了，多谢你帮忙，旅行者。"
        },
        {
          "role": "维克多",
