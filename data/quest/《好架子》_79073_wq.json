{
  "quest_id": 79073,
  "chapter_num": null,
  "chapter_title": "《好架子》",
  "type": "wq",
  "route": "\"Good Shelf\"",
  "stories": [
    {
      "story_id": 79073,
      "title": "《好架子》",
      "description": "在赐福森林里，有一位纸蛙似乎制造了一件有趣的事物。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与许迪对话"
        },
        {
          "role": "许迪",
          "text": "欢迎！尊敬的客人，欢迎您来到「赐福森林」！"
        },
        {
          "role": "许迪",
          "text": "您是来森林里旅行，还是准备去参观雨歌塘的跳跃比赛？无论如何，都祝您开心。"
        },
        {
          "type": "subtitle",
          "text": "未完成任务「直至世界尽头」"
        },
        {
          "role": "许迪",
          "text": "您也要记得避开那只不知道何时会前来造访的巨龙！可别让他耽误了您的行程！"
        },
        {
          "role": "许迪",
          "text": "唉，我之前还想着送那位龙一些「纸模」呢。这样也许能让他心情好些。不要再来吹翻我的架子…"
        },
        {
          "role": "许迪",
          "text": "但是…那位龙明显不乐意听我叫喊，每次都自顾自飞走…"
        },
        {
          "type": "subtitle",
          "text": "完成任务「直至世界尽头」"
        },
        {
          "role": "许迪",
          "text": "如今，我们也不用担心有一只巨龙突然前来造访了。不得不说，您来得正是时候！"
        },
        {
          "role": "许迪",
          "text": "我听说，那位龙如今可是有了一副好脾气。"
        },
        {
          "role": "许迪",
          "text": "我正打算带着些「纸模」去看望他。希望那位龙能喜欢。"
        },
        {
          "role": "许迪",
          "text": "喔！天哪，我居然忘了为您介绍我的杰出作品，还有这台杰出的架子。"
        },
        {
          "role": "许迪",
          "text": "请您看向这里！瞧瞧这台「赠礼箱」，我迄今为止制作过的所有纸模都在里面了。"
        },
        {
          "role": "许迪",
          "text": "为了制作它们，我走…喔，应该说是「跳」遍了整个世界，也结交了无数朋友。"
        },
        {
          "role": "许迪",
          "text": "比如，总是想拉我去风场里尝试飞行的飞鼠克朗谢，和我一样喜欢做模型的德维特…当然啦，还有那位总是板着脸的埃洛夫。"
        },
        {
          "role": "许迪",
          "text": "他们都很慷慨，愿意让我以他们为原型制作纸模，把这有趣的小玩意与大家分享！"
        },
        {
          "role": "许迪",
          "text": "来，拿上这些「星游币」，就算是我对您的欢迎礼吧。把它们塞进这台「赠礼箱」里，扭动把手。看看露珠会赐予您什么礼物。"
        },
        {
          "role": "许迪",
          "text": "但是，如果您用完了这些硬币之后，还想继续扭动「赠礼箱」的话，就得自己想办法拿到硬币啦。"
        },
        {
          "role": "许迪",
          "text": "至于怎么拿到硬币…哈哈哈，您可以去问问我的那些好朋友们，他们会有主意的。"
        },
        {
          "role": "许迪",
          "text": "拿到礼物之后，您可以把它们摆在我身后这台好架子上。"
        },
        {
          "role": "许迪",
          "text": "严肃地来说，这台架子才是我制作「赠礼箱」和制作「纸模」的动力…"
        },
        {
          "role": "许迪",
          "text": "但这就牵涉到一个不那么简练的故事了…如果您希望的话，我之后也愿意讲给您听。"
        },
        {
          "role": "许迪",
          "text": "现在，就请您扭动「赠礼箱」吧，露珠在上，祝您拿到心仪的礼物，也拿到一整天的好心情。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（许迪）"
        },
        {
          "role": "许迪",
          "text": "您好呀，客人。欢迎您来扭动「赠礼箱」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于这些「纸模」…",
              "dialogues": [
                {
                  "role": "许迪",
                  "text": "喔！这些纸模都是以我的朋友们为原型设计的，他们慷慨地答应了我的请求。"
                },
                {
                  "role": "许迪",
                  "text": "您瞧瞧，这一架飞鼠纸模的原型是克朗谢，他总是念叨着要我去尝试飞行…我试过了！但是，我待在地上的时间总是比在空中的长。"
                },
                {
                  "role": "许迪",
                  "text": "这一架积木人纸模的原型是德维特，他热爱旅行，爱做积木模型，更爱他的那些帽子。"
                },
                {
                  "role": "许迪",
                  "text": "我上一次见德维特的时候，他还在星轨王城待着，专心折腾着他的那些帽子呢。"
                },
                {
                  "role": "许迪",
                  "text": "啊！您得看看这个，必须得看看这个，严肃的发条卫兵，值得敬爱的埃洛夫。"
                },
                {
                  "role": "许迪",
                  "text": "他不爱说话，但总是尽忠职守。唔…我记得，这位好卫兵最近似乎正忙着训练——他总是忙着训练。"
                },
                {
                  "role": "许迪",
                  "text": "抱歉，看来我有些啰嗦了，您如果要去扭动「赠礼箱」，就请快去。"
                },
                {
                  "role": "许迪",
                  "text": "露珠在上，您一定会拿到一份好礼物，和一整天的好心情。"
                }
              ]
            },
            {
              "text": "关于「好架子」的故事…",
              "dialogues": [
                {
                  "role": "许迪",
                  "text": "您想听这个？没问题，让我为您简洁地介绍一下这篇流传甚广的故事。"
                },
                {
                  "role": "许迪",
                  "text": "传说中，世界上曾经存在过一个由各色的架子所组成的王国。"
                },
                {
                  "role": "许迪",
                  "text": "架子们各司其职，各自承载着所需承载的物件…但是，有一个被刚刚打造出来的架子却心生不满。"
                },
                {
                  "role": "许迪",
                  "text": "「为什么那个架子能承载珠宝，那个架子能保存画作，而我却只能装些过期的水果？」"
                },
                {
                  "role": "许迪",
                  "text": "「够了！我真是受够了，我要从这离开，去承载那些能证明我价值的东西！」"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "（继续听下去。）",
                      "dialogues": [
                        {
                          "role": "许迪",
                          "text": "然后，那个架子就开始了旅行。在旅途里，他为一个大富豪保管过满满一架子珠宝，帮一个有名的画家保存价值连城的画作。"
                        },
                        {
                          "role": "许迪",
                          "text": "但是，富豪因病去世后，他之前的友人们突然翻脸，将所有的珠宝瓜分一空。"
                        },
                        {
                          "role": "许迪",
                          "text": "那位著名的画家逐渐没了灵感，当他画不出好画后，先前他圈揽的名声也露出了獠牙。"
                        },
                        {
                          "role": "许迪",
                          "text": "他被人打上了无能的标签，最后痛苦地把所有画都拿出来付之一炬，自己也发誓再也不画画了。"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "（继续听下去。）",
                              "dialogues": [
                                {
                                  "role": "许迪",
                                  "text": "这个架子曾经拥有了梦想中的一切，但又尽数失去。架子疲惫不堪…他曾经崭新又漂亮，但现在却陈旧不已，还缺了好几层。"
                                },
                                {
                                  "role": "许迪",
                                  "text": "他曾经是富豪的架子，画家的架子…但那些曾经填塞在他生命里的东西已经消失了，现在他又是谁？"
                                },
                                {
                                  "role": "许迪",
                                  "text": "最后，架子回到了王国里。他去了图书馆的角落，就那么孤独地待着。"
                                },
                                {
                                  "role": "许迪",
                                  "text": "「我是一个无能的架子。」架子悲伤地想到：「没了那些珠宝和画作，我就没有价值。」"
                                },
                                {
                                  "type": "choice",
                                  "role": "旅行者",
                                  "options": [
                                    {
                                      "text": "（继续听下去。）",
                                      "dialogues": [
                                        {
                                          "role": "许迪",
                                          "text": "但是，就当孤独和悲伤即将把架子摧垮的时候，一个抱着书的女孩路过了他面前。"
                                        },
                                        {
                                          "role": "许迪",
                                          "text": "「天哪！一个空架子！真是救命了！」女孩高兴地叫道：「亲爱的架子，我能把这些书交给你保管么？」"
                                        },
                                        {
                                          "role": "许迪",
                                          "text": "「可以。但我是个没价值的架子，不知道能否帮上你的忙。」架子悲伤地说道。"
                                        },
                                        {
                                          "role": "许迪",
                                          "text": "「但是…你的柜架很大，既平整，又结实。」女孩讶异地说道：「无论怎么看，你都是一个很棒的架子，能装下很多书。」"
                                        },
                                        {
                                          "type": "choice",
                                          "role": "旅行者",
                                          "options": [
                                            {
                                              "text": "（继续听下去。）",
                                              "dialogues": [
                                                {
                                                  "role": "许迪",
                                                  "text": "架子向女孩诚恳地讲述了自己的故事，他曾经装载过财富和荣耀，但失落和背叛也同时被他纳入其中。"
                                                },
                                                {
                                                  "role": "许迪",
                                                  "text": "如今他一无所有，绝不能称得上是一个有价值的好架子。"
                                                },
                                                {
                                                  "role": "许迪",
                                                  "text": "「亲爱的架子，你为什么为这件事烦恼？」女孩笑着说：「你总是履行自己的职责，妥妥当当地装着所有东西。」"
                                                },
                                                {
                                                  "role": "许迪",
                                                  "text": "「妥善保管那些事物，正是你的价值所在。被你保管的事物，怎么能定义你的好坏？」"
                                                },
                                                {
                                                  "role": "许迪",
                                                  "text": "「所以，现在请您再履行职责，帮帮忙，妥善保管这些书吧。」"
                                                },
                                                {
                                                  "role": "许迪",
                                                  "text": "「我每天都会来整理它们，我们也可以每天讨论这个话题。」"
                                                },
                                                {
                                                  "type": "choice",
                                                  "role": "旅行者",
                                                  "options": [
                                                    {
                                                      "text": "（继续听下去。）",
                                                      "dialogues": [
                                                        {
                                                          "role": "许迪",
                                                          "text": "从那之后，王国里的架子们都听说，在一个图书馆中，有一个既聪明，又沉稳，无比可靠的架子。"
                                                        },
                                                        {
                                                          "role": "许迪",
                                                          "text": "他从不会因为自己承载事物的价值而或喜或忧，只是诚实地保管着所有东西。"
                                                        },
                                                        {
                                                          "role": "许迪",
                                                          "text": "那些新打造的架子们常常前去拜访，向他请问各种问题。"
                                                        },
                                                        {
                                                          "role": "许迪",
                                                          "text": "而提到他时，那些新架子们总是会如此称呼——"
                                                        },
                                                        {
                                                          "role": "许迪",
                                                          "text": "「喔！那位『好架子』！」"
                                                        }
                                                      ]
                                                    },
                                                    {
                                                      "text": "（还是先不听了…）",
                                                      "dialogues": []
                                                    }
                                                  ]
                                                }
                                              ]
                                            },
                                            {
                                              "text": "（还是先不听了…）",
                                              "dialogues": []
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "text": "（还是先不听了…）",
                                      "dialogues": []
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "text": "（还是先不听了…）",
                              "dialogues": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "（还是先不听了…）",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "许迪",
                  "text": "下次再见，愿露珠保佑您。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
