{
  "quest_id": 24018,
  "chapter_num": null,
  "chapter_title": "另有他职",
  "type": "iq",
  "route": "Other Duties",
  "stories": [
    {
      "story_id": 24018,
      "title": "另有他职",
      "description": "瑟米安似乎正在为某事而苦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与瑟米安对话"
        },
        {
          "role": "瑟米安",
          "text": "莉诺蕾娅怎么又生气了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "瑟米安？",
              "dialogues": [
                {
                  "role": "瑟米安",
                  "text": "旅行者？竟能在此幸会尊下，真我之荣幸。"
                },
                {
                  "role": "旅行者",
                  "text": "好好说话。"
                },
                {
                  "role": "瑟米安",
                  "text": "抱歉。我之前总是做书面工作，不由自主地就会使用太多的形容词。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你在这里做什么？",
                      "dialogues": []
                    },
                    {
                      "text": "你看上去有点发愁。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "瑟米安",
                  "text": "唉，别提了。我正准备和莉诺蕾娅一起去看歌剧，但在出发之前，她突然收到了她同事寄来的一封信。"
                },
                {
                  "role": "瑟米安",
                  "text": "我们一边走，她一边读信。等我们到了歌剧院，她也彻底把信读完了。然后就…"
                },
                {
                  "role": "瑟米安",
                  "text": "…跑去角落生闷气，拿着笔记本猛写猛划，我怎么安慰她也不听。"
                },
                {
                  "role": "瑟米安",
                  "text": "喔，莉诺蕾娅是我的女朋友。"
                },
                {
                  "role": "瑟米安",
                  "text": "如果不是今天这个情况，她一定会很高兴见到你们的…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你好像已经很习惯了。",
                      "dialogues": [
                        {
                          "role": "瑟米安",
                          "text": "我和莉诺蕾娅在一起这么长时间，她的脾气我当然已经习惯了。"
                        }
                      ]
                    },
                    {
                      "text": "你知道她为什么生气吗？",
                      "dialogues": [
                        {
                          "role": "瑟米安",
                          "text": "唉，还能是什么事。一定又和那群机关鱼有关。她总是被这些「环境保护」的事搞得心烦意乱。"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "瑟米安",
                  "text": "这个时候，我一般会找点礼物送给她。无论如何，至少要将她的注意力转向好事上去。"
                }
              ]
            },
            {
              "text": "你是…复律庭里的那位…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑟米安",
          "text": "不然她就会一直闷闷不乐，这样对身体可不好。"
        },
        {
          "role": "瑟米安",
          "text": "旅行者…不如这次由你来帮我拿主意，怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是你的对象。",
              "dialogues": []
            },
            {
              "text": "我可不擅长这件事。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑟米安",
          "text": "哎呀，我所挑选的礼物全都是莉诺蕾娅喜欢的，你不用担心自己挑选的东西弄糟她的心情。"
        },
        {
          "role": "瑟米安",
          "text": "我只是需要一个局外人…嗯，帮我出出主意。俗话说「旁观者清」呀。"
        },
        {
          "role": "瑟米安",
          "text": "你瞧，我一般会送花或者香水。"
        },
        {
          "role": "瑟米安",
          "text": "请您来帮我拿个主意吧。"
        },
        {
          "role": "旅行者",
          "text": "还是送花吧。"
        },
        {
          "role": "瑟米安",
          "text": "你和我的想法一模一样！一束芳香四溢的花，肯定能让莉诺蕾娅心情好起来。"
        },
        {
          "role": "瑟米安",
          "text": "她喜欢的花有三种…<color=#00E1FFFF>虹彩蔷薇</color>，<color=#00E1FFFF>海露花</color>和<color=#00E1FFFF>柔灯铃</color>。"
        },
        {
          "role": "瑟米安",
          "text": "旅行者，你能帮我拿一束花回来吗？这三种里的哪一种都行。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你自己怎么不去？",
              "dialogues": [
                {
                  "role": "瑟米安",
                  "text": "我…暂时走不开呀。要是莉诺蕾娅转头看不见我的话，接下来两周我都别想和她说话了。"
                }
              ]
            },
            {
              "text": "你没准备吗？",
              "dialogues": [
                {
                  "role": "瑟米安",
                  "text": "我倒是订了花，但要等到歌剧结束之后才送过来啊。"
                },
                {
                  "role": "瑟米安",
                  "text": "看现在的情况，莉诺蕾娅肯不肯和我去看歌剧都是两说呢。"
                }
              ]
            }
          ]
        },
        {
          "role": "瑟米安",
          "text": "只能拜托你了，旅行者！"
        },
        {
          "role": "旅行者",
          "text": "你现在的劲头，可比工作时候高多了。"
        },
        {
          "role": "瑟米安",
          "text": "这不一样！在复律庭工作时最需要的就是心态稳定，而和心爱的人约会时，最需要的就是热情！"
        },
        {
          "role": "派蒙",
          "text": "知道了，知道了。呜哇，这个人又开始傻笑了…"
        },
        {
          "role": "旅行者",
          "text": "不如送香水试试。"
        },
        {
          "role": "瑟米安",
          "text": "我也正巧这么想！莉诺蕾娅的香水正好快用完了，这个主意非常不错。"
        },
        {
          "role": "瑟米安",
          "text": "我们俩经常在城里的卡嘉妮那里买香水，旅行者，请你快帮我跑一趟吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你自己怎么不去？",
              "dialogues": [
                {
                  "role": "瑟米安",
                  "text": "我…暂时走不开呀。要是莉诺蕾娅转头看不见我的话，接下来两周我都别想和她说话了。"
                }
              ]
            },
            {
              "text": "你没准备吗？",
              "dialogues": [
                {
                  "role": "瑟米安",
                  "text": "我们俩是看歌剧来的，就算要买香水，也是看完歌剧之后散步时顺便买啊。"
                },
                {
                  "role": "瑟米安",
                  "text": "再说了，这伊黎耶岛上哪有卖香水的呢…总之，就拜托你了，旅行者！"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "你现在的劲头，可比工作时候高多了。"
        },
        {
          "role": "瑟米安",
          "text": "这不一样！在复律庭工作时最需要的就是心态稳定，而和心爱的人约会时，最需要的就是热情！"
        },
        {
          "role": "旅行者",
          "text": "知道了，知道了。"
        },
        {
          "role": "瑟米安",
          "text": "我之前在卡嘉妮那边预付过一笔钱，你过去挑好香水之后，直接拿走就行了。"
        },
        {
          "role": "瑟米安",
          "text": "请务必快一些！也不能让莉诺蕾娅等太久…"
        },
        {
          "role": "派蒙",
          "text": "呜哇，这个人又开始傻笑了…"
        },
        {
          "role": "旅行者",
          "text": "试试…鱼苗？"
        },
        {
          "role": "瑟米安",
          "text": "当然可以！你和我想一起去了，我也正想准备一瓶新鱼苗送给莉诺蕾娅！"
        },
        {
          "role": "瑟米安",
          "text": "既然莉诺蕾娅正在为自己的事业烦恼，那我正好用她的事业来鼓励她。"
        },
        {
          "role": "瑟米安",
          "text": "请您帮我跑一趟吧，去枫丹廷里找一个叫巴塔索的人，他是莉诺蕾娅的同事，手里一定有好鱼苗。"
        },
        {
          "role": "派蒙",
          "text": "你就这么确定吗？要是这个人手里根本就没有鱼苗呢？"
        },
        {
          "role": "瑟米安",
          "text": "我…其实一直在请这位先生教我如何养鱼，也从他那里买了不少优质鱼苗…当然了，这些莉诺蕾娅都不知道。"
        },
        {
          "role": "瑟米安",
          "text": "对了，我给您标个地点，那位先生经常在那里出现。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你真值得敬佩…",
              "dialogues": []
            },
            {
              "text": "你也太喜欢莉诺蕾娅小姐了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑟米安",
          "text": "哎呀，因为莉诺蕾娅很可爱嘛…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们快去拿鱼苗，让他一个人在这里傻笑吧…"
        },
        {
          "role": "瑟米安",
          "text": "莉诺蕾娅怎么又生气了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "瑟米安？",
              "dialogues": []
            },
            {
              "text": "你是…复律庭里的那位…",
              "dialogues": []
            }
          ]
        },
        {
