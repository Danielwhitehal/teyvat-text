        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "末日时钟？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "当时间走到午夜，末日就会来临。"
