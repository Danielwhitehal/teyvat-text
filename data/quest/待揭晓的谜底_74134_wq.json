{
  "quest_id": 74134,
  "chapter_num": null,
  "chapter_title": "待揭晓的谜底",
  "type": "wq",
  "route": "Riddles Awaiting Answers",
  "stories": [
    {
      "story_id": 74134,
      "title": "待揭晓的谜底",
      "description": "来到了奇妙的房间，卡特皮拉回忆起了一些信息…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与卡特皮拉对话"
        },
        {
          "type": "subtitle",
          "text": "未完成任务「尚未结束的故事」与「最后的问题」"
        },
        {
          "role": "派蒙",
          "text": "呜啊，这里是什么地方啊？"
        },
        {
          "role": "卡特皮拉",
          "text": "熟悉的布置正在唤醒我的记忆。没错，这里就是「水仙十字结社」。"
        },
        {
          "role": "派蒙",
          "text": "你是说，这里就是我们要找的「水仙十字结社」吗？"
        },
        {
          "role": "卡特皮拉",
          "text": "虽然没有了仪式道具，也很久没有执行「驱散仪式」了。"
        },
        {
          "role": "卡特皮拉",
          "text": "但是毫无疑问，这里就是曾经枫丹的罪人们集合的地方。"
        },
        {
          "role": "派蒙",
          "text": "「驱散仪式」又是什么啦！不过这个不重要啦。"
        },
        {
          "role": "派蒙",
          "text": "你能注意到什么线索吗？那种我们这种外行会一眼看漏的那种。"
        },
        {
          "type": "subtitle",
          "text": "已完成任务「尚未结束的故事」或「最后的问题」"
        },
        {
          "role": "派蒙",
          "text": "这里就是「水仙十字结社」了！"
        },
        {
          "role": "卡特皮拉",
          "text": "没有了仪式道具，也很久没有执行「驱散仪式」了。不过⋯"
        },
        {
          "role": "卡特皮拉",
          "text": "没错，熟悉的布置正在唤醒我的记忆。是这里没错。"
        },
        {
          "role": "派蒙",
          "text": "或许有些我们没注意到的线索，卡特皮拉一下子就能认出来吧。"
        },
        {
          "role": "派蒙",
          "text": "怎么样，有发现什么吗？"
        },
        {
          "role": "卡特皮拉",
          "text": "满眼都是再也无法追上我的过去与曾经、回忆与残影。这些算吗？"
        },
        {
          "role": "派蒙",
          "text": "唔，虽然打断你的追忆往昔很没礼貌，不过我想这些没什么用吧。"
        },
        {
          "role": "卡特皮拉",
          "text": "或许是吧。但是我的过去也和大罪的核心「水仙十字结社」息息相关。"
        },
        {
          "role": "卡特皮拉",
          "text": "或许有些回忆能够帮助到你们呢。"
        },
        {
          "role": "派蒙",
          "text": "那你讲讲你的回忆吧，卡特皮拉。"
        },
        {
          "role": "卡特皮拉",
          "text": "我得事先说明，几百年前的我也处在内阵之外，对事件的全貌不甚了解。"
        },
        {
          "role": "卡特皮拉",
          "text": "不过我接受过纳齐森科鲁兹的亲自教导，他应该是一切的源头。"
        },
        {
          "role": "派蒙",
          "text": "纳齐森科鲁兹⋯那不就是——"
        },
        {
          "role": "卡特皮拉",
          "text": "「我们每个人身上都沉睡着一个先知，每当他醒来，世界上又多一份邪恶」⋯"
        },
        {
          "role": "卡特皮拉",
          "text": "他就是这样的一个人。"
        },
        {
          "type": "subtitle",
          "text": "初次选择"
        },
        {
          "role": "派蒙",
          "text": "那旅行者，趁这个机会，你有什么想问的吗？"
        },
        {
          "type": "subtitle",
          "text": "第二次之后"
        },
        {
          "role": "派蒙",
          "text": "还有什么其他的问题吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于卡特皮拉自己…",
              "dialogues": [
                {
                  "role": "卡特皮拉",
                  "text": "你问我吗，我还以为之前的越狱过程里我们都很熟悉了呢。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "不过我也知道，你想问的是更加深层的东西。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "「现在，我将做一件史无前例，后无来者的艰巨工作…」"
                },
                {
                  "role": "卡特皮拉",
                  "text": "「…我要把一个人的真面目，丝毫不加隐藏地揭露在世人面前。而这个人，便是我自己。」"
                },
                {
                  "role": "派蒙",
                  "text": "唔，总感觉卡特皮拉说起话来一套一套的。我都不知道怎么当捧哏。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "这不是因为莉诺尔已经回去了嘛。我们需要面对更加复杂的世界了。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "九岁以下的时间结束了，接下来大概需要十六岁左右的阅历——"
                },
                {
                  "role": "派蒙",
                  "text": "嗯…嗯？只需要十六岁左右的阅历就够了吗？"
                },
                {
                  "role": "卡特皮拉",
                  "text": "我在这具身体最初听到的话语正是纳齐森科鲁兹的声音。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "除了之前就提到的水仙十字圣剑的救赎之力，他还说道："
                },
                {
                  "role": "卡特皮拉",
                  "text": "「身体只是躯壳，就算是丘之民的肉体，也可以承载智慧的意识。」"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "是他创造了你？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "卡特皮拉",
                  "text": "或许如此吧。我也尝试追查过自身的起源，不过得到的答案模糊不清。"
                },
                {
                  "role": "派蒙",
                  "text": "卡特皮拉好可怜。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "我自己倒也没有这种感觉。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "因为我发现大部分人类也并不明白自己来到世界的原因。他们一样可以开心的活着。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "而且说是「创造我」也不太对。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "怎么说？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "卡特皮拉",
                  "text": "创造是神的功业——如果我们把上面那个叫做神的话。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "你知道水仙十字的教谕中，创造人最重要的部分是什么吗？"
                },
                {
                  "role": "派蒙",
                  "text": "是什么？"
                },
                {
                  "role": "卡特皮拉",
                  "text": "是想象。事无巨细的想象一个人，就像是纯水精灵事无巨细地想象林野间的生命形态。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "有一个故事就是说强大的法师与祭司想象自己的儿子，最后却发现，自己也是别人的想象。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "对不起，扯远了。不过我总觉得似乎这些事情和你们的疑问有关。"
                },
                {
                  "role": "派蒙",
                  "text": "虽然不是很明白的样子…"
                }
              ]
            },
            {
              "text": "关于水仙十字结社…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你既然对这里有种熟悉的感觉，能和我们讲讲这里的事吗？"
                },
                {
                  "role": "卡特皮拉",
                  "text": "其实在我记忆里，「水仙十字结社」的众人还是比较面貌和善的。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "只不过纳齐森科鲁兹的教导有许多激进之处，或许会让人难以接受。"
                },
                {
                  "role": "派蒙",
                  "text": "听起来就不太妙…"
                },
                {
                  "role": "卡特皮拉",
                  "text": "纳齐森科鲁兹依照古制，会使用圣剑来主持仪式。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "璃月古法称之「斩三尸」，须弥古法则叫「断我执」。他则称呼这件事为「自我割舍」。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "他认为人的自我意志是阻碍，如果不小心求道过程中获得了神之眼，那就走入不可回头的歧途了。"
                },
                {
                  "role": "派蒙",
                  "text": "那…舍弃自我之后，人会怎么样呢？"
                },
                {
                  "role": "卡特皮拉",
                  "text": "其实还挺正常的。据说人看不清世界的真相，就是因为有一个自我在身体里有意地过滤五感。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那好像就没那么可怕了。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "卡特皮拉",
                  "text": "只是我不知道，纳齐森科鲁兹收集那些自我与意志，最终是为了什么呢？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "能再讲讲水仙十字的别的事吗？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "卡特皮拉",
                  "text": "下次吧。能说的太多了，让我整理一下思维。"
                }
              ]
            },
            {
              "text": "关于多年前的事情…",
              "dialogues": [
                {
                  "role": "卡特皮拉",
                  "text": "多年以前，现在称之为「奇械公」的吉约丹和纳齐森科鲁兹有过激烈的对抗。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "当年吉约丹还叫「护国的白骑士」呢…"
                },
                {
                  "role": "派蒙",
                  "text": "噗。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "和「荣誉骑士」比哪个更厉害？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "卡特皮拉",
                  "text": "那我还是觉得「幻光蝶蛾之蛹」更厉害。"
                },
                {
                  "role": "派蒙",
                  "text": "噗啊哈哈哈，这是什么奇怪的头衔啦！"
                },
                {
                  "role": "卡特皮拉",
                  "text": "…是结社给我安的头衔。你看，我是卡特皮拉。也就是结蛹、完全变态，然后化蝶的那种生命。"
                },
                {
                  "role": "派蒙",
                  "text": "对、对不起哦。"
                },
                {
                  "role": "卡特皮拉",
                  "text": "可能包含着让我最后成人的希冀吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "虽然知道了很多事情…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但是似乎还有许多疑问…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "我需要去翻阅一下文献，然后看看能不能拼凑出所有过往。"
        },
        {
          "role": "卡特皮拉",
          "text": "所以我可能有时候会不在这里。"
        },
        {
          "role": "派蒙",
          "text": "现在的枫丹对你有些危险。"
        },
        {
          "role": "卡特皮拉",
          "text": "我会用伪装和我一直以来赖以生存的一些手段去处理这些事情的。"
        },
        {
          "type": "subtitle",
          "text": "未完成任务「尚未结束的故事」与「最后的问题」"
        },
        {
          "role": "卡特皮拉",
          "text": "如果有什么值得一说的新发现，我会立刻告诉你们的。"
        },
        {
          "role": "卡特皮拉",
          "text": "或者我不在的时候，就像是健忘的冒险家一样，留个纸条。"
        },
        {
          "role": "派蒙",
          "text": "唔，那好吧，你一定要注意安全啊。"
        },
        {
          "role": "卡特皮拉",
          "text": "你们也是。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们会等你的。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "卡特皮拉离开了此地。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "未完成任务「尚未结束的故事」但已完成「最后的问题」"
        },
        {
          "role": "西摩尔",
          "text": "否定的。危险。危险。检测到水仙十字结社残党活动。"
        },
        {
          "role": "西摩尔",
          "text": "旅行者先生，派蒙小姐，请立刻找安全的地方回避。"
        },
        {
          "role": "西摩尔",
          "text": "广域歼灭模式启动。"
        },
        {
          "role": "派蒙",
          "text": "呜啊，西摩尔冷静一点。这个人是…"
        },
        {
          "role": "卡特皮拉",
          "text": "护国白骑士的「这是我自己的小发明」，又见面了。"
        },
        {
          "role": "西摩尔",
          "text": "肯定。我是…（嘈杂的机械音）的试做产品，拥有大量大胆的设计要素。"
        },
        {
          "role": "西摩尔",
          "text": "…此话题优先级降权。请你立刻束手就擒。"
        },
        {
          "role": "卡特皮拉",
          "text": "西摩尔，听我说，我现在已经对旅行者先生投降啦。"
        },
        {
          "role": "西摩尔",
          "text": "是这样吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "对的对的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡特皮拉",
          "text": "我是卡特皮拉，你当然知道吧。话说，你要保护的小姑娘现在怎么样了？"
        },
        {
          "role": "卡特皮拉",
          "text": "…等等，我为什么会说出这样的话。"
        },
        {
          "role": "派蒙",
          "text": "怎么了？"
        },
        {
          "role": "西摩尔",
          "text": "没错，我是在寻找我应该保护的主人，玛——"
        },
        {
          "role": "卡特皮拉",
          "text": "玛丽安。或者，叫她玛丽安·吉约丹。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…玛丽安·吉约丹！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "西摩尔",
          "text": "…（嘈杂的机械音），…（嘈杂的机械音逐渐清晰），吉约丹。"
        },
        {
          "role": "西摩尔",
          "text": "没错，我的设计者。吉约丹。"
        },
        {
          "role": "派蒙",
          "text": "卡特皮拉，这也是你几百年前的回忆逐渐转醒了吗？"
        },
        {
          "role": "卡特皮拉",
          "text": "不是的。这是我诞生前的记忆。仿佛是大象在静思的时候回忆起前世一样。"
        },
        {
          "role": "西摩尔",
          "text": "不能理解。前世并不存在。"
        },
        {
          "role": "卡特皮拉",
          "text": "对你来说是这样啦。"
        },
        {
          "role": "卡特皮拉",
          "text": "看来，通过你我遇到了意想不到的突破点。或许可以找到关于自己诞生的秘密。"
        },
        {
          "role": "西摩尔",
          "text": "虽然不能明白，但是很乐意为您提供了帮助。"
        },
        {
          "role": "派蒙",
          "text": "如果是这样的话，我们一起来交换一下情报吧。"
        },
        {
          "role": "派蒙",
          "text": "正好西摩尔也在场，或许卡特皮拉能索引出特别的记录呢。"
        },
        {
          "role": "西摩尔",
          "text": "虽然不明白。但是判断可行度：高。"
        },
        {
          "type": "subtitle",
          "text": "分享了信息…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "卡特皮拉",
          "text": "雅各布出现了啊…"
        },
        {
          "role": "卡特皮拉",
          "text": "我对这一切另有猜测，但是要证明猜想，还需要去实地调查一番。西摩尔如果能够同行就更好了。"
        },
        {
          "role": "西摩尔",
          "text": "这是对记录恢复有利的决定。我会与你同行。"
        },
        {
          "role": "卡特皮拉",
          "text": "很好。那么，旅行者、派蒙，等我能够九分确信时，我再来告诉你们。"
        },
        {
          "role": "派蒙",
          "text": "好的哦。"
        },
        {
          "type": "subtitle",
          "text": "已完成任务「尚未结束的故事」但未完成「最后的问题」"
        },
        {
          "role": "安",
          "text": "呼啊~"
        },
        {
          "role": "派蒙",
          "text": "欸？安，你醒啦！"
        },
        {
          "role": "安",
          "text": "嗯…早上好，派蒙，还有旅行者骑士。"
        },
        {
          "role": "派蒙",
          "text": "喔，对了！我来介绍一下，这位是纯水精灵安，是我们的朋友。安，这位是…"
        },
        {
          "role": "卡特皮拉",
          "text": "我的名字是卡特皮拉，很荣幸见到您，安。"
        },
        {
          "role": "安",
          "text": "你、你好，卡特皮拉…我们是不是见过？"
        },
        {
          "role": "卡特皮拉",
          "text": "我的记忆很不好了，所以说不定确实见过。冒昧问一下，您和红女皇是什么关系？"
        },
        {
          "role": "安",
          "text": "红女皇…那是谁，我并不知道，但是这种隐约熟悉的感觉。"
        },
        {
          "role": "卡特皮拉",
          "text": "那我换个名字吧。您和莉利丝是什么关系呢？"
        },
        {
          "role": "安",
          "text": "你为什么会知道这个名字？"
        },
        {
          "role": "安",
          "text": "我和派蒙还有旅行者骑士一起经历了许多冒险，才知道她只不过故事中的角色罢了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是怎么回事？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊对啊，这是怎么回事？卡特皮拉你认识莉利丝吗？"
        },
        {
          "role": "卡特皮拉",
          "text": "是吗？我大概知道情况了。"
        },
        {
          "role": "卡特皮拉",
          "text": "我也是为谜语所害的人，所以我绝对不会在此故弄玄虚，我应当知无不言。"
        },
        {
          "role": "卡特皮拉",
          "text": "莉利丝确有其人，她也是一位纯水精灵。在社内被纳齐森科鲁兹称呼为「红女皇」。"
        },
        {
          "role": "派蒙",
          "text": "怎么会这样！那这个莉利丝后来怎么样了？"
        },
        {
          "role": "卡特皮拉",
          "text": "我不知道。但是我有一个猜测。"
        },
        {
          "role": "安",
          "text": "可以和我说吗？"
        },
        {
          "role": "卡特皮拉",
          "text": "如果只是猜想的话，那就不值一提。而且聪明的你，不是早就猜到了吗？"
        },
        {
          "role": "派蒙",
          "text": "猜到什么啊？"
        },
        {
          "role": "安",
          "text": "你见到我的第一句话…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「我的名字是卡特皮拉…」",
              "dialogues": []
            }
          ]
