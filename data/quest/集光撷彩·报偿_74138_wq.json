{
  "quest_id": 74138,
  "chapter_num": null,
  "chapter_title": "集光撷彩·报偿",
  "type": "wq",
  "route": "Radiant Harvest: Compensation",
  "stories": [
    {
      "story_id": 74138,
      "title": "集光撷彩·报偿",
      "description": "回收「荧光紫水母」的时限已近，是时候去找基肖恩问问现况了…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "这段时间我们抓了不少水母呢，不知道基肖恩说的生态恢复得怎么样了…"
        },
        {
          "role": "派蒙",
          "text": "现在就去找他看看吧，希望他还没被警备队抓走…"
        },
        {
          "type": "subtitle",
          "text": "与基肖恩对话"
        },
        {
          "role": "基肖恩",
          "text": "嘿，回来了吗？你们刚才可错过了一场好戏啊。"
        },
        {
          "role": "派蒙",
          "text": "好戏？发生什么事了？"
        },
        {
          "role": "基肖恩",
          "text": "刚刚我带着回收来的水母，在这里等奥格劳先生核查。结果奥格劳先生还没来，之前的买家倒是找上门了。"
        },
        {
          "role": "基肖恩",
          "text": "他们说自从放生了前几批水母，这人也精神了，生意也顺畅了，一定是做了好事，有神明眷顾！所以就想找我再买一批去放生。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我这边还在抓…",
              "dialogues": []
            },
            {
              "text": "你居然还在卖…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔唔…旅行者抓，基肖恩先生卖，买家再去放生…喂！你难道是在用这个方法赚钱吗？！"
        },
        {
          "role": "基肖恩",
          "text": "没有！没有！怎么可能！？我可不想再被警备队的人找麻烦了！"
        },
        {
          "role": "基肖恩",
          "text": "咳咳…我跟他们说明了好久，放生这些水母有害无益，可他们就是不听！"
        },
        {
          "role": "基肖恩",
          "text": "愣是觉得自己最近走了好运，就是因为做了这种…他们所认为的好事。"
        },
        {
          "role": "基肖恩",
          "text": "还觉得我接连倒霉，也是囚禁水母带给我的报应。唉…这帮人到底在想什么…"
        },
        {
          "role": "基肖恩",
          "text": "我们还在争辩着呢，奥格劳先生就来了，直接把这群人扣了回去。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好运到头了。",
              "dialogues": []
            },
            {
              "text": "自作自受呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基肖恩",
          "text": "…说到底，不去了解生物的习性和生态就胡乱放生，为的究竟是这些生命，还是自己的好运呢？"
        },
        {
          "role": "派蒙",
          "text": "最后还被警备队抓走了…看起来也没多少好运嘛？"
        },
        {
          "role": "基肖恩",
          "text": "哈，顺带一提，警备队已经免了我的牢狱之灾，多亏有你们帮忙了。"
        },
        {
          "role": "基肖恩",
          "text": "除了之前说好的报酬，我还准备了一点纪念品，请不要客气。"
        },
        {
          "type": "subtitle",
          "text": "基肖恩取出了一只水母球…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "欸…这个是？「荧光紫水母」？看着比之前的小好多…"
        },
        {
          "role": "基肖恩",
          "text": "没错，昨天我从库存的水母苗里挑了一些合适的样本，挨个记录编号后又多出了几只，我想…不如就送给你们，做个纪念吧。"
        },
        {
          "role": "基肖恩",
          "text": "剩下的水母我会带回去继续培育，看看怎么让它们在自然环境下野化。"
        },
        {
          "role": "基肖恩",
          "text": "而且我也打算留下一些「荧光紫水母」的样本，研究研究聚集发光的成因…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看起来还挺可爱的…",
              "dialogues": []
            },
            {
              "text": "放水里游起来会不会更可爱…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "基肖恩",
          "text": "等、等等——你可千万别再把它们放生了啊！！"
        }
      ]
    }
  ]
}