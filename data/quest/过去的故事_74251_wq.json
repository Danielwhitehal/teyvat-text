{
  "quest_id": 74251,
  "chapter_num": null,
  "chapter_title": "过去的故事",
  "type": "wq",
  "route": "Stories of the Past",
  "stories": [
    {
      "story_id": 74251,
      "title": "过去的故事",
      "description": "前往沫芒宫附近放置茶桌并使用桑多涅落座后，与那维莱特共度茶会时光吧…",
      "dialogues": [
        {
          "role": "那维莱特",
          "text": "感谢你的邀请，吉约丹小姐。我想，这些纯净水应该是你为此次茶会特意准备的。"
        },
        {
          "role": "「木偶」",
          "text": "这没什么。身为枫丹最高审判官的那维莱特大人百忙中能够抽空来喝杯…水，是我的荣幸。"
        },
        {
          "role": "那维莱特",
          "text": "吉约丹小姐有什么和愚人众有关的公事要与我商谈吗？"
        },
        {
          "role": "「木偶」",
          "text": "不，和愚人众无关，这次是私事。也没到什么商谈的程度。我就是想向你打听一位曾经的熟人。"
        },
        {
          "role": "那维莱特",
          "text": "曾经的熟人…哦，是说阿兰·吉约丹阁下吧？那位伟大的「奇械公」。"
        },
        {
          "role": "「木偶」",
          "text": "嗯，没错。他曾经是怎样一个人？我听闻他年轻时也算是你的部下。"
        },
        {
          "role": "那维莱特",
          "text": "嗯…"
        },
        {
          "role": "那维莱特",
          "text": "吉约丹先生为人真诚，脚踏实地。在获封「护国的白骑士」后也不曾见他露出过骄傲的神情。"
        },
        {
          "role": "那维莱特",
          "text": "他大多数时间都潜心于研究机械，不问身外之事。"
        },
        {
          "role": "「木偶」",
          "text": "唔…年轻时就这样吗？也不知这到底是年少老成还是不谙世事。"
        },
        {
          "role": "那维莱特",
          "text": "不过…这样的他在那次失去了家人和朋友之后，就变了不少。"
        },
        {
          "role": "「木偶」",
          "text": "格式塔吗…还有，厄里那斯…"
        },
        {
          "role": "那维莱特",
          "text": "没错。与我一同签署搜查格式塔的命令时，他看起来很…无奈。"
        },
        {
          "role": "「木偶」",
          "text": "过往的隔阂与疏离导向了如今的境地，他一定也是在内疚吧。"
        },
        {
          "role": "那维莱特",
          "text": "嗯，自那之后他变得更加沉默寡言。我们之间的来往也更少了。"
        },
        {
          "role": "那维莱特",
          "text": "在受封「奇械公」的称谓时，他对台下人说了一句话——"
        },
        {
          "role": "那维莱特",
          "text": "「静谧而谦卑地生活，比一昧追求无止境的完美，更容易追寻到幸福。」"
        },
        {
          "role": "「木偶」",
          "text": "呵…他晚年也的确这么做了。"
        },
        {
          "role": "「木偶」",
          "text": "我猜，那句话他不只是说给台下的人听，也是说给自己听的吧。"
        },
        {
          "role": "那维莱特",
          "text": "吉约丹小姐对此怎么看？"
        },
        {
          "role": "「木偶」",
          "text": "我吗？哼，我不会对他的领悟或他的生活方式做什么评价，就像他不曾要求我去过任何一种生活一样。"
        },
        {
          "role": "「木偶」",
          "text": "我也无心去重走他的老路，去过他理想中的日子。我有我自己的人生。"
        },
        {
          "role": "「木偶」",
          "text": "哈…多谢。这让我更加了解了他一些。"
        },
        {
          "role": "那维莱特",
          "text": "不必客气。我也很高兴能与吉约丹先生的后人分享过去的故事。"
        },
        {
          "role": "那维莱特",
          "text": "很高兴能一边品水一边与吉约丹小姐分享过去的故事。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "那维莱特",
          "text": "好。祝你前路顺利。"
        }
      ]
    }
  ]
}