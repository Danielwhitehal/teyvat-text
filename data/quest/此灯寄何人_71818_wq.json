{
  "quest_id": 71818,
  "chapter_num": null,
  "chapter_title": "此灯寄何人",
  "type": "wq",
  "route": "The Gift of a Lantern",
  "stories": [
    {
      "story_id": 71818,
      "title": "此灯寄何人",
      "description": "轻策庄的小白似乎正为某事而做着准备…",
      "dialogues": [
        {
          "role": "小白",
          "text": "希望江城爷爷能喜欢那盏霄灯…"
        },
        {
          "role": "小白",
          "text": "你好啊，旅行者。上次真是太谢谢你了，轻策庄好久没有这么热闹过了。"
        },
        {
          "role": "旅行者",
          "text": "不用客气。"
        },
        {
          "role": "小白",
          "text": "往年只有我和阿芷在，最多给孩子们做点霄灯，陪老人唠点家常，再稍微做一些好吃的…"
        },
        {
          "role": "小白",
          "text": "这次多亏了你，才能过上一个热热闹闹的海灯节。"
        },
        {
          "role": "小白",
          "text": "不过热闹归热闹…我还是想去探望一下庄里的老人。今天我准备去看看江城爷爷。"
        },
        {
          "role": "小白",
          "text": "如果你愿意的话，就一起来吧。"
        },
        {
          "role": "旅行者",
          "text": "那我们一起吧。"
        },
        {
          "role": "小白",
          "text": "嗯，好的，那我们先去江城爷爷那里吧。"
        },
        {
          "role": "江城",
          "text": "老婆子，你回来啦？"
        },
        {
          "role": "旅行者",
          "text": "抱歉，你认错人了…"
        },
        {
          "role": "江城",
          "text": "嗨，我可还没老糊涂呢…怎么会认不出你…"
        },
        {
          "role": "江城",
          "text": "我刚刚还念叨着你呢，你看这大过年的，是不是该给咱女儿添件新衣裳了…"
        },
        {
          "role": "江城",
          "text": "哟…这回你还多带了个人回来…啊，是你找来的裁缝吗？我俩又想到一块儿去了？"
        },
        {
          "role": "小白",
          "text": "江城爷爷，是我，小白啊。前两天我还给你送过豆腐，这么快就不记得我了？"
        },
        {
          "role": "江城",
          "text": "啊…小白…是小白啊！记得记得！就前一阵子，你爹爹还在跟我夸你呢…"
        },
        {
          "role": "江城",
          "text": "欸…那是什么时候的事儿来着…老婆子，你还记得不…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "…还记得。",
            "当然记得。"
          ]
        },
        {
          "role": "旅行者",
          "text": "…还记得。"
        },
        {
          "role": "江城",
          "text": "嗬！我就说，我的记性怎么可能差了…还有，还有…"
        },
        {
          "role": "小白",
          "text": "江城爷爷，您歇一会，别太累了…"
        },
        {
          "role": "小白",
          "text": "旅行者，要不你先去帮江城爷爷打扫一下屋子吧，我来陪他聊会儿天。"
        },
        {
          "role": "旅行者",
          "text": "交给我了。"
        },
        {
          "role": "小白",
          "text": "那就拜托你了。"
        },
        {
          "role": "江城",
          "text": "唉…老婆子，你也来和小白唠两句…她爹爹的手艺这么好…"
        },
        {
          "role": "江城",
          "text": "这豆腐啊，就是卖去璃月港，也是一顶一的好！"
        },
        {
          "role": "江城",
          "text": "唔，小白啊，你是来做什么的来着…"
        },
        {
          "role": "旅行者",
          "text": "是来送霄灯的。"
        },
        {
          "role": "江城",
          "text": "霄灯…啊…是霄灯…哎呀，年年都麻烦你啦，小白…"
        },
        {
          "role": "江城",
          "text": "老婆子，你还记得吧，之前我编霄灯的手艺可好啦，那周围的人，都找我编。"
        },
        {
          "role": "江城",
          "text": "每年过海灯节的时候，那些霄灯啊，可真好看…你等着，我这就去给你挂霄灯去…"
        },
        {
          "role": "旅行者",
          "text": "我来挂霄灯吧。"
        },
        {
          "role": "江城",
          "text": "嗯，也好，那你可小心点啊，可别碰着摔着了…"
        },
        {
          "role": "小白",
          "text": "材料都已经搜集好了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经搜集好了。"
        },
        {
          "role": "小白",
          "text": "谢谢你。"
        },
        {
          "role": "江城",
          "text": "霄灯挂好了？好看，真好看，来年一定又是个好年呐。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "一定会的。",
            "肯定会的。"
          ]
        },
        {
          "role": "旅行者",
          "text": "一定会的。"
        },
        {
          "role": "小白",
          "text": "那江城爷爷，我们还有点事，就先走了，回头再来看您。"
        },
        {
          "role": "江城",
          "text": "行、行，年轻人，总有自己要忙的事…忙不完的事…"
        },
        {
          "role": "旅行者",
          "text": "再见。"
        },
        {
          "role": "江城",
          "text": "欸，老婆子…别忘了看看咱家的地…"
        },
        {
          "role": "小白",
          "text": "刚才多谢了，旅行者，要是我一个人去，说不定就要忙得手忙脚乱了。"
        },
        {
          "role": "小白",
          "text": "大过节的，我也不太想让江城爷爷总是一个人呆着…"
        },
        {
          "role": "旅行者",
          "text": "那你自己…"
        },
        {
          "role": "小白",
          "text": "嗯…我等一下也会回去打理打理磨坊里的事。"
        },
        {
          "role": "小白",
          "text": "那个磨坊是我父亲留下来的，他过世后，我辞去了璃月的工作，回来继承了他的磨坊和手艺。"
        },
        {
          "role": "小白",
          "text": "怎么说呢，在一样的环境里，做和他一样的事情，我总能回忆起很多事来。"
        },
        {
          "role": "小白",
          "text": "特别是在海灯节的时候，我总会想起父亲从前和我说过的许多话…"
        },
        {
          "role": "小白",
          "text": "啊对了，光顾着给江城爷爷做霄灯了，我还得给自己做一盏才行。"
        },
        {
          "role": "小白",
          "text": "不过材料都用光了，没有留自己的份…"
        },
        {
          "role": "小白",
          "text": "现在再去搜集材料，怕是来不及了…旅行者，能请你帮我搜集一些来吗？"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "小白",
          "text": "那就拜托你啦。"
        },
        {
          "role": "江城",
          "text": "原来是小白啊…你爹爹最近都还好吗？"
        },
        {
          "role": "小白",
          "text": "嗯…他…他很好的。磨坊的生意也没落下，璃月港的人，都跑来庄里买我们的豆腐呢。"
        },
        {
          "role": "江城",
          "text": "嘿嘿…那可不是，你爹爹做的豆腐可是我们轻策庄的好东西…"
        },
        {
          "role": "江城",
          "text": "霄灯…霄灯…真好看哪…"
        },
        {
          "role": "小白",
          "text": "旅行者，那就麻烦你就挂霄灯了，我在这看着江城爷爷。"
        },
        {
          "role": "小白",
          "text": "真是太感谢啦，等会儿我就给自己编一盏霄灯。"
        },
        {
          "role": "小白",
          "text": "之前我和父亲也一起放过很多次霄灯，等编好霄灯之后，我会自己去放飞的。"
        },
        {
          "role": "小白",
          "text": "希望…他能看见这盏霄灯。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "一定能看见的。",
            "祝你海灯节快乐。"
          ]
        },
        {
          "role": "旅行者",
          "text": "一定能看见的。"
        },
        {
          "role": "小白",
          "text": "多谢你了，祝你海灯节快乐。"
        }
      ]
    }
  ]
}