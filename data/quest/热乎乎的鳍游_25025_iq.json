  "chapter_title": "热乎乎的鳍游",
  "type": "iq",
  "route": "Steaming Hot Swim",
  "stories": [
    {
      "story_id": 25025,
      "title": "热乎乎的鳍游",
      "description": "「流泉之众」的佩蕾·努伊似乎遇见了一些小麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与佩蕾·努伊对话"
        },
        {
          "role": "佩蕾·努伊",
          "text": "拜托啦，稍微上岸来一下好不好？我要打扫这边的池子。"
        },
        {
          "role": "懒懒的鳍游龙",
          "text": "呜…"
        },
        {
          "role": "佩蕾·努伊",
          "text": "乖孩子，上来啦。不然我可要把你抱上来了！"
        },
        {
          "role": "懒懒的鳍游龙",
          "text": "呜！"
        },
        {
          "role": "佩蕾·努伊",
          "text": "呜哇…一下子就游走了，这怎么能抱住它呢…"
        },
        {
          "role": "旅行者",
          "text": "你在做什么呢？"
        },
        {
          "role": "佩蕾·努伊",
          "text": "欸？你是来泡温泉的吗？不好意思，我正在清理这边的池子，可能你要稍等一会了。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "而且，这孩子说什么也不肯上岸来。唉…我还有很多池子要清理啊。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "难道是我前几天强行把它抱出来，让这孩子生气了吗？真是难搞…"
        },
        {
          "role": "旅行者",
          "text": "我来试试把它哄出来吧。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "唔…行啊。换个人去哄也是一种方法。那就拜托你了。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "这孩子也不知道是怎么了。明明之前我只要摸摸它的<color=#00E1FFFF>头</color>或者<color=#00E1FFFF>肚子</color>，就能乖乖听话…"
        },
        {
          "role": "旅行者",
          "text": "我帮忙去清理其他池子吧。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "你愿意帮忙？那真是太好了，我真的忙不过来了。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "唔…那就请你先去清理那边的池子吧。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "我前几天已经清理过池底了，你只需要把浮在温泉上的那些杂物拣出来就行。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "那就拜托你了，我继续哄这孩子。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "唉…这孩子也不知道是怎么了。明明之前我只要摸摸它的头或者肚子，就能乖乖听话…"
        },
        {
          "type": "subtitle",
          "text": "尝试和懒懒的小鳍游龙交流"
        },
        {
          "role": "懒懒的鳍游龙",
          "text": "呜…？呜呜，呜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（摸摸它的头…）",
              "dialogues": [
                {
                  "role": "懒懒的鳍游龙",
                  "text": "呜？呜！呜呜——"
                },
                {
                  "role": "懒懒的鳍游龙",
                  "text": "（小鳍游龙似乎很高兴的样子，乖乖待在岸边，这样应该就能把它抱到岸上了…）"
                },
                {
                  "role": "？？？",
                  "text": "小鳍游龙总算安静了下来。你小心翼翼地把它抱上了岸…"
                }
              ]
            },
            {
              "text": "（摸摸它的肚子…）",
              "dialogues": [
                {
                  "role": "懒懒的鳍游龙",
                  "text": "呜呜？呜呜——"
                },
                {
                  "role": "懒懒的鳍游龙",
                  "text": "（小鳍游龙似乎很高兴的样子，乖乖待在岸边，这样应该就能把它抱到岸上了…）"
                }
              ]
            },
            {
              "text": "（尝试直接抱起来…）",
              "dialogues": [
                {
                  "role": "懒懒的鳍游龙",
                  "text": "呜！呜，呜呜！"
                },
                {
                  "role": "懒懒的鳍游龙",
                  "text": "（小鳍游龙似乎不太高兴，泼得你满脸是水。）"
                },
                {
                  "role": "懒懒的鳍游龙",
                  "text": "（小鳍游龙期待地看着你。最好换一个方法再哄哄它…）"
                }
              ]
            }
          ]
        },
        {
          "role": "佩蕾·努伊",
          "text": "你是玩开心了，我可得回去换一身衣服了…"
        },
        {
          "role": "懒懒的鳍游龙",
          "text": "呜呜！呜——"
        },
        {
          "role": "旅行者",
          "text": "你怎么全身都湿透了…"
        },
        {
          "role": "佩蕾·努伊",
          "text": "咳，陪着这孩子好好玩了一场，它总算是肯听话上来了。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "你已经收拾好那边的温泉了吧？真是多谢你了，这些东西给你，就当做是报酬吧。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "等我收拾好其他温泉，可得回去换一身…咦？那孩子去哪了？"
        },
        {
          "role": "懒懒的鳍游龙",
          "text": "呜！呜——"
        },
        {
          "role": "佩蕾·努伊",
          "text": "喂！回来！那边的温泉还没收拾好啊！"
        },
        {
          "role": "？？？",
          "text": "小鳍游龙欢快地跳向了另一口温泉，佩蕾·努伊在后面大喊着追了上去…"
        },
        {
          "role": "佩蕾·努伊",
          "text": "咦？那孩子怎么自己爬上岸了？难道是…玩累了？"
        },
        {
          "role": "佩蕾·努伊",
          "text": "…无论如何，还是多谢你帮忙，这些报酬收下吧。我也要去给那孩子准备点好吃的…"
        },
        {
          "role": "佩蕾·努伊",
          "text": "咦？它在哪呢？不，不会又跑去温泉里去了吧！"
        },
        {
          "role": "懒懒的鳍游龙",
          "text": "呜！呜——"
        },
        {
          "role": "佩蕾·努伊",
          "text": "喂！回来！那边的温泉还没收拾好啊！"
        },
        {
          "role": "？？？",
          "text": "小鳍游龙欢快地跳向了另一口温泉，佩蕾·努伊在后面大喊着追了上去…"
        },
        {
          "type": "subtitle",
          "text": "向佩蕾·努伊回报"
        },
        {
          "role": "懒懒的鳍游龙",
          "text": "呼啊…新朋友…呼…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（摸摸它的头…）",
              "dialogues": [
                {
                  "role": "懒懒的鳍游龙",
                  "text": "新朋友！呼啊——"
                },
                {
                  "role": "懒懒的鳍游龙",
                  "text": "（小鳍游龙似乎很高兴的样子，乖乖待在岸边…）"
                },
                {
                  "role": "懒懒的鳍游龙",
                  "text": "呼啊，玩够了。休息…"
                },
                {
                  "role": "？？？",
                  "text": "小鳍游龙打了个哈欠，慢悠悠地爬上了岸…"
                }
              ]
            },
            {
              "text": "（摸摸它的肚子…）",
              "dialogues": [
                {
                  "role": "懒懒的鳍游龙",
                  "text": "新朋友！呼啊——"
                },
                {
                  "role": "懒懒的鳍游龙",
                  "text": "（小鳍游龙似乎很高兴的样子，乖乖待在岸边…）"
                }
              ]
            },
            {
              "text": "（尝试直接抱起来…）",
              "dialogues": [
                {
                  "role": "懒懒的鳍游龙",
                  "text": "不行！想要玩，不走！"
                },
                {
                  "role": "懒懒的鳍游龙",
                  "text": "（小鳍游龙似乎不太高兴，泼得你满脸是水。）"
                },
                {
                  "role": "懒懒的鳍游龙",
                  "text": "（小鳍游龙期待地看着你。最好换一个方法再哄哄它…）"
                }
              ]
            }
          ]
        },
        {
          "role": "佩蕾·努伊",
          "text": "哈哈哈，看来你挺讨那孩子喜欢的嘛，一下子就把它哄出来了。"
        },
        {
          "role": "佩蕾·努伊",
          "text": "多谢你了，这些报酬给你。我也要去给那孩子准备点好吃的…"
        },
        {
          "role": "佩蕾·努伊",
          "text": "咦？它在哪呢？不，不会又跑去温泉里去了吧！"
        },
        {
          "role": "懒懒的鳍游龙",
          "text": "呜！呜——"
        },
        {
          "role": "佩蕾·努伊",
          "text": "喂！回来！那边的温泉还没收拾好啊！"
        },
        {
          "role": "？？？",
          "text": "小鳍游龙欢快地跳向了另一口温泉，佩蕾·努伊在后面大喊着追了上去…"
        },
        {
          "type": "subtitle",
          "text": "收拾温泉里的杂物"
        },
        {
          "role": "佩蕾·努伊",
          "text": "唉，这孩子为什么闹别扭呢…"
        },
        {
          "type": "subtitle",
          "text": "向佩蕾·努伊回报"
        }
      ]
    }
  ]
}