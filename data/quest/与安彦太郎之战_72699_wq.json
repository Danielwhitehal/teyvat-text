{
  "quest_id": 72699,
  "chapter_num": null,
  "chapter_title": "与安彦太郎之战",
  "type": "wq",
  "route": "Versus Yasuhiko Tarou",
  "stories": [
    {
      "story_id": 72699,
      "title": "与安彦太郎之战",
      "description": "坚称「此身为战斗而生」、有着自己奇妙想法的武士，安彦太郎，在此等候多时了。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安彦太郎对话"
        },
        {
          "role": "安彦太郎",
          "text": "不知阁下的剑技到底水平如何，这一战我非常期待。"
        },
        {
          "role": "旅行者",
          "text": "你怎么也…"
        },
        {
          "role": "安彦太郎",
          "text": "其实，我之前说有四位武者，是把自己也算在其中了。"
        },
        {
          "role": "安彦太郎",
          "text": "虽说我是这场决斗的主办人，但无奈参与者实在太少…"
        },
        {
          "role": "安彦太郎",
          "text": "更何况，此身为战斗而生，既然遇到了强大的对手，就没有不与对方一战的道理！"
        },
        {
          "role": "安彦太郎",
          "text": "哈哈，我想说这句台词很久了！"
        },
        {
          "role": "派蒙",
          "text": "喂，这人到底行不行啊！"
        },
        {
          "role": "旅行者",
          "text": "不能轻敌。"
        },
        {
          "role": "安彦太郎",
          "text": "说得好！阁下这种对所有对手一视同仁的态度，让我肃然起敬。"
        },
        {
          "role": "安彦太郎",
          "text": "之前，如果不是因为我以貌取人，看轻了第四位武者，那场战斗也不会输得那么惨。"
        },
        {
          "role": "安彦太郎",
          "text": "不过现在，我已经不是当时的我了！那么，旅行者，开始比试吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "来吧。",
            "等等，让我准备一下。"
          ]
        },
        {
          "role": "安彦太郎",
          "text": "来吧。"
        }
      ]
    }
  ]
}