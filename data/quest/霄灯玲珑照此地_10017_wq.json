{
  "quest_id": 10017,
  "chapter_num": "",
  "chapter_title": "霄灯玲珑照此地",
  "type": "wq",
  "route": "Beneath Splendent Lanterns",
  "stories": [
    {
      "story_id": 41359,
      "title": "玲珑霄灯图之三",
      "description": "璃月港冒险家协会的小千似乎还在招揽人过去试玩「玲珑霄灯图」…",
      "dialogues": [
        {
          "role": "小千",
          "text": "欢迎试玩「玲珑霄灯图」…"
        },
        {
          "role": "旅行者",
          "text": "这次也准备了不一样的图案吗？"
        },
        {
          "role": "小千",
          "text": "当然啦，毕竟被你连续解开了两次，这次我可是真的去换了难度最高的几盏灯。"
        },
        {
          "role": "小千",
          "text": "不过，图当然还是三个拼成一个完整的，难度还是在<color=#00E1FFFF>「连轴」</color>上。"
        },
        {
          "role": "小千",
          "text": "嘿嘿，你就自己去体会一下吧，这次的图案是<color=#00E1FFFF>「仙鹤」</color>哦。"
        },
        {
          "role": "小千",
          "text": "拼好了图之后，你就可以去找宝藏去啦。"
        },
        {
          "role": "小千",
          "text": "居、居然又拼好了…"
        },
        {
          "role": "小千",
          "text": "这也难不倒你吗…你果然是个很厉害的冒险家啊…"
        },
        {
          "role": "小千",
          "text": "快去看看屏风吧，宝藏的线索都隐藏在里面了。"
        },
        {
          "role": "小千",
          "text": "那些宝藏可都是协会特意准备的，祝你们寻宝开心。"
        },
        {
          "role": "小千",
          "text": "你想要玩这个的话，就等晚上再来吧。"
        },
        {
          "role": "小千",
          "text": "这次要拼出来的图案是<color=#00E1FFFF>「鹤」</color>。"
        },
        {
          "role": "小千",
          "text": "怎么样，寻宝之旅还顺利吗？"
        },
        {
          "role": "旅行者",
          "text": "已经找到全部宝藏了。"
        },
        {
          "role": "小千",
          "text": "你居然真的把三张图都解完了…你还挺厉害的…"
        },
        {
          "role": "小千",
          "text": "咳，对于你这种实力高超的冒险家，我们协会也特别准备了一份大礼。"
        },
        {
          "role": "小千",
          "text": "看到对面那些宝箱了吗？打开吧，里面的东西都归你了。"
        },
        {
          "role": "旅行者",
          "text": "我拿了之后…"
        },
        {
          "role": "小千",
          "text": "后面的人当然就没了，冒险就是这样，战利品谁先拿到就归谁。"
        },
        {
          "role": "小千",
          "text": "好了，祝你在海灯节玩得开心。"
        }
      ]
    }
  ]
}