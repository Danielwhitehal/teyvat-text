{
  "quest_id": 72237,
  "chapter_num": null,
  "chapter_title": "安提戈努斯",
  "type": "wq",
  "route": "Antigonus",
  "stories": [
    {
      "story_id": 72237,
      "title": "安提戈努斯",
      "description": "在悬空牢知道了一些故事，你决定前去寻找…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆与悬空牢的残影对话"
        },
        {
          "role": "？？？",
          "text": "啊，你是过来接我们走的地走官吗？"
        },
        {
          "role": "？？？",
          "text": "这么年轻啊，应该只是地走官的候补吧。"
        },
        {
          "role": "？？？",
          "text": "嘿，毕竟污蔑了我们三人的清白，地走官大人们脸上挂不住，让手下的年轻人跑腿致歉，也能理解啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "未接取[[龙蛇藏归辑录]]任务",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这什么跟什么啊？"
                },
                {
                  "role": "？？？",
                  "text": "你们不是官员啊…这下可麻烦了，该不会是把我们忘了吧…"
                },
                {
                  "role": "大仓",
                  "text": "我叫大仓，是蒙受了不白之冤被关到这里的。我们三个都是。"
                },
                {
                  "role": "大仓",
                  "text": "死马当活马医吧。你既然能靠自己来悬空牢，身手肯定也不一般。去救救那个家伙吧。"
                }
              ]
            },
            {
              "text": "已接取[[龙蛇藏归辑录]]任务",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你们就是偷走《日月前事》的嫌疑人吗？"
                },
                {
                  "role": "大仓",
                  "text": "什么嫌疑人，我叫大仓。我们可是真的被冤枉了啊。"
                },
                {
                  "role": "大仓",
                  "text": "不说有的没的了。你是不是来放我们走的吧？如果不是那应该就是来追那个家伙的吧？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那个家伙？"
        },
        {
          "role": "大仓",
          "text": "就是第三个人呗。我和他不熟，旁边这个和他关系好点。你们可赶紧去问问他吧。"
        },
        {
          "role": "大仓",
          "text": "逃走的那家伙虽然性子烈了一点。但我保证和我俩一样都是无辜的。"
        },
        {
          "role": "大仓",
          "text": "都渊下宫最后一日了，可别闹出什么人命。"
        },
        {
          "type": "subtitle",
          "text": "◆与悬空牢的残影对话"
        },
        {
          "role": "？？？",
          "text": "你先别管书不书、冤枉不冤枉的事情了。赶紧去找安贞吧！"
        },
        {
          "role": "派蒙",
          "text": "安贞？"
        },
        {
          "role": "大岛",
          "text": "啊，就是和我们一起被关在这里的第三个人。我叫大岛，他叫安提戈努斯，鸣神岛式的名字叫做安贞。"
        },
        {
          "role": "大岛",
          "text": "他也是地走官的候补，性格刚烈，体能超群。他就是抓着悬崖的一点点小凸起爬上去逃走的。"
        },
        {
          "role": "大岛",
          "text": "很恐怖吧。这正常人能办到吗？"
        },
        {
          "role": "旅行者",
          "text": "好像我也办得到。"
        },
        {
          "role": "大岛",
          "text": "你们这群志愿当上地走官的家伙，在我心里已经锻炼到不算人类了。"
        },
        {
          "role": "大岛",
          "text": "我听说地走官的试炼，要求候选人双手抱起一只脚，然后站在圆圈里。"
        },
        {
          "role": "大岛",
          "text": "其余的十二个地走官开始拿枪扎他，如果他一夜没有受伤就算是合格。"
        },
        {
          "role": "大岛",
          "text": "你既然也是地走官候补，你告诉我是不是真的？"
        },
        {
          "role": "旅行者",
          "text": "据我所知是假的…"
        },
        {
          "role": "大岛",
          "text": "不会吧。地走官测试难道更加夸张吗？"
        },
        {
          "role": "大岛",
          "text": "快给我讲讲！"
        },
        {
          "role": "旅行者",
          "text": "安贞的事情不是更急吗…"
        },
        {
          "role": "大岛",
          "text": "对、对哦。咳咳…"
        },
        {
          "role": "大岛",
          "text": "他说他会一路留下什么「尼奥」的图案做标记。"
        },
        {
          "role": "大岛",
          "text": "是渊下宫没有的生物。会飞，有翅膀，象征自由什么的。"
        },
        {
          "role": "派蒙",
          "text": "那不就是鸟吗？"
        },
        {
          "role": "大岛",
          "text": "对对。是这个名字，「鸟」。"
        },
        {
          "role": "大岛",
          "text": "他和我说了他的计划。等他爬上去拿到事先准备好的装备，就会去蛇心之地。他说他有一些坎瑞亚使节团的线索。"
        },
        {
          "role": "大岛",
          "text": "他承诺说赌上性命也要证明我们三个的清白。晚些时候要是官员或者巫女来找我们俩，把他们指到蛇心之地去。"
        },
        {
          "role": "大岛",
          "text": "就算他倒下了，他也要用鸟的图案留下线索，把来者引向能证明我们三人清白的证据那里。"
        },
        {
          "role": "大岛",
          "text": "如果不出意外，你们顺着鸟图案就能找到他。"
        },
        {
          "role": "大岛",
          "text": "人命关天，快点去吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（大仓）"
        },
        {
          "role": "大仓",
          "text": "我们是无辜的啊。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（大岛）"
        },
        {
          "role": "大岛",
          "text": "快去找安贞吧。然后把他带回来，再把我们合理合法地放了。"
        },
        {
          "type": "subtitle",
          "text": "◆寻找安贞的下落"
        },
        {
          "role": "派蒙",
          "text": "唔，虽然很想给他们自由。"
        },
        {
          "role": "派蒙",
          "text": "不过他们只是过去的残影。他们后来的故事应该是个圆满结局吧。"
        },
        {
          "role": "派蒙",
          "text": "被释放之后，他们离开了渊下宫，在海祇岛生活，然后过完了一生。"
        },
        {
          "type": "subtitle",
          "text": "◆与安贞的残影对话"
        },
        {
          "role": "？？？",
          "text": "你们是…"
        },
        {
          "role": "派蒙",
          "text": "你就是安贞吗？"
        },
        {
          "role": "安贞",
          "text": "没错，是我。我感觉…有点奇怪…"
        },
        {
          "role": "安贞",
          "text": "我记得我一直在追那群家伙，然后拔下来了一个核心丢在营地里。之后我因为自己也受伤挺重的，有点发困。"
        },
        {
          "role": "安贞",
          "text": "现在醒来看到你们，我觉得还挺精神的。我是不是快死了回光返照了？"
        },
        {
          "role": "旅行者",
          "text": "…"
        },
        {
          "role": "安贞",
          "text": "先不说这些了。你们是来捉拿我回去的吗？我已经证明了自己的清白。"
        },
        {
          "role": "安贞",
          "text": "是坎瑞亚的家伙，他们偷走了图书馆的书。我虽然是接待他们的保镖卫士，但我绝无可能和他们沆瀣一气。"
        },
        {
          "role": "安贞",
          "text": "我在这边追查到了使团的踪迹，打倒了他们所有人。"
        },
        {
          "role": "安贞",
          "text": "我为了停下他们的机关巨物，和它周旋了很久。最后我扯下了它的核心。但是我也因此受了重伤。"
        },
        {
          "role": "安贞",
          "text": "失去动力的机器压在了丢失的书上面。我已经没办法把它取出来了。"
        },
        {
          "role": "派蒙",
          "text": "白夜国的地走官可真厉害啊…"
        },
        {
          "role": "安贞",
          "text": "你们不是地走官或者候补吗？唉，无所谓了。最早地走官都是对抗深海龙蜥的勇士，后来才变成执法人员、幽冥判官的。"
        },
        {
          "role": "安贞",
          "text": "核心就在营地里。你们不信我的话，可以拿着核心去看看。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "安贞",
          "text": "我听闻鸣神岛的使节谈到过鸟这种生物。有翅膀，能够在高天里飞翔。"
        },
        {
          "role": "安贞",
          "text": "太梦幻了，你们可以想象吗？"
        },
        {
          "role": "安贞",
          "text": "也有人认为，它们是神明的使者，会特地前来传达人的命运。"
        },
        {
          "role": "安贞",
          "text": "如果有人因为流放之罚而最终曝尸荒野的话，同一种鸟还会过来啄食他的凡躯。"
        },
        {
          "role": "安贞",
          "text": "我对这种生灵很着迷。如果今天以后，还有机会见到天光，我一定要养一只鸟。"
        },
        {
          "type": "subtitle",
          "text": "◆拾取遗迹机关的核心"
        },
        {
          "type": "subtitle",
          "text": "◆找到废弃的遗迹守卫"
        },
        {
          "type": "subtitle",
          "text": "◆启动遗迹守卫"
        },
        {
          "type": "subtitle",
          "text": "◆获得《日月前事》"
        },
        {
          "type": "subtitle",
          "text": "◆与安贞的残影对话"
        },
        {
          "role": "安贞",
          "text": "你们拿到书了吗？"
        },
        {
          "role": "派蒙",
          "text": "拿到了。安贞你确实是无辜的。"
        },
        {
          "role": "安贞",
          "text": "从刚才的话来看，你们并不是地走官，有点可惜。不然就能现场正式承认我的无罪了。"
        },
        {
          "role": "安贞",
          "text": "不然就能立刻证明我的清白了。"
        },
        {
          "role": "安贞",
          "text": "我现在感觉非常精神，但是之前那种流血过多的疲倦感也很真实。我是不是真的快要死了所以回光返照啊？"
        },
        {
          "role": "派蒙",
          "text": "唔…"
        },
        {
          "role": "安贞",
          "text": "唉，我问你啊，陌生人。被白夜国所判的冤罪，是罪孽吗？"
        },
        {
          "role": "旅行者",
          "text": "…"
        },
        {
          "role": "安贞",
          "text": "如果此刻的我，因为这种难以平复的心境，被常世大神留为罪影。这是罪孽吗？"
        },
        {
          "role": "安贞",
          "text": "我，有罪吗？"
        },
        {
          "role": "旅行者",
          "text": "你没有罪。"
        },
        {
          "role": "派蒙",
          "text": "喂，旅行者，你要小心点说话。让他意识到了…意识到那件事的话，他会消失的。"
        },
        {
          "role": "旅行者",
          "text": "你只是安贞留下的残影。"
        },
        {
          "role": "安贞",
          "text": "…"
        },
        {
          "role": "旅行者",
          "text": "你是无罪的，我会让所有人知道。"
        },
        {
          "role": "安贞",
          "text": "哼哼，是吗。原来我只是生前的一个影子。"
        },
        {
          "role": "安贞",
          "text": "原来，我是无罪的啊。"
        },
        {
          "type": "subtitle",
          "text": "安贞的残影开始背诵断章——",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "「我究竟触犯了哪一条神律…不幸的人为什么要仰仗神明？",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "我的作为是否有意义，既然我的虔诚之行换取了负罪之名？」",
          "narration": true,
          "color": "描述"
        }
      ],
      "collapse_ranges": [
