{
  "quest_id": 72197,
  "chapter_num": null,
  "chapter_title": "执望三千里",
  "type": "wq",
  "route": "Gazing Three Thousand Miles Away",
  "stories": [
    {
      "story_id": 72197,
      "title": "执望三千里",
      "description": "战争与「祟神」给小小的长次带来了太多烦恼，如何才能让长次走出迷惘呢…？",
      "dialogues": [
        {
          "role": "长次",
          "text": "总之，谢谢你们的努力！我们下次有缘再见吧！"
        },
        {
          "role": "长次",
          "text": "你好，旅行者！最近过得如何？"
        },
        {
          "role": "派蒙",
          "text": "挺好的，你呢！"
        },
        {
          "role": "旅行者",
          "text": "我的话被派蒙抢掉啦！"
        },
        {
          "role": "派蒙",
          "text": "哈哈，只怪你自己反应慢！"
        },
        {
          "role": "旅行者",
          "text": "我看派蒙是想加餐了吧？"
        },
        {
          "role": "派蒙",
          "text": "当然啦，我天天都想！"
        },
        {
          "role": "旅行者",
          "text": "我的意思是，你就是「加餐」。"
        },
        {
          "role": "派蒙",
          "text": "喂——！"
        },
        {
          "role": "长次",
          "text": "噗…哈哈哈哈哈！"
        },
        {
          "role": "长次",
          "text": "好啦好啦，你们别吵啦。"
        },
        {
          "role": "长次",
          "text": "我这边也还不错，不过还有件事想要拜托一下。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说吧，什么事？",
              "dialogues": []
            },
            {
              "text": "我尽力而为。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "嗯，也没有别的要求啦，只是需要旅行者再帮我开采一些晶石。"
        },
        {
          "role": "长次",
          "text": "请相信我，我一定会好好报答你的…只要你相信我。"
        },
        {
          "role": "旅行者",
          "text": "我相信你，可是…"
        },
        {
          "role": "长次",
          "text": "可是…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么？",
              "dialogues": []
            },
            {
              "text": "你答应过给我一个解释。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对呀，我们还不知道你为什么这么需要蛇骨晶石呢！"
        },
        {
          "role": "长次",
          "text": "嗯…我需要钱旅行才能找到妈妈，所以要用矿石来换钱。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可是幕府垄断了晶矿市场。",
              "dialogues": []
            },
            {
              "text": "你知道晶矿不好卖吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "我知道，我会自己找门路的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你在做危险的事情。",
              "dialogues": []
            },
            {
              "text": "我在担心你的安危。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "长次，我们已经是朋友了，对吧？"
        },
        {
          "role": "派蒙",
          "text": "说不定这次，我们还能再帮到你呢？"
        },
        {
          "role": "派蒙",
          "text": "而且，你答应要报答我们了。那么可能危及你自己，导致我们拿不到回报的事情，我们也是有权了解的，对吧？"
        },
        {
          "role": "旅行者",
          "text": "这是什么市侩哲学…"
        },
        {
          "role": "长次",
          "text": "噗…派蒙说的没错啦。"
        },
        {
          "role": "长次",
          "text": "我收集晶矿也不完全是为了赚钱。"
        },
        {
          "role": "长次",
          "text": "我一直在想…假如爸爸妈妈也像大家一样，得了「祟神」带来的病…"
        },
        {
          "role": "长次",
          "text": "或许这些晶石能用来制药也不一定。因为它们也是大蛇的骨骸上生出来的嘛…"
        },
        {
          "role": "长次",
          "text": "而且保本先生也提到过，这些晶石可能有用。"
        },
        {
          "role": "派蒙",
          "text": "可是…这也不是百分百准确的假说吧？"
        },
        {
          "role": "长次",
          "text": "嗯，但我们也没有别的假说了。"
        },
        {
          "role": "长次",
          "text": "等找到妈妈…或许还有爸爸，我就带他们去须弥。听说那里有治疗这种怪病的方法。"
        },
        {
          "role": "长次",
          "text": "但在那之前，我也不能放弃任何一分治疗的希望。"
        },
        {
          "role": "长次",
          "text": "好啦，我说的也够多了，还愿意帮这个忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不用问也会的。",
              "dialogues": []
            },
            {
              "text": "希望你能好好利用那些晶石。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "谢谢！我不会忘记的！"
        },
        {
          "role": "旅行者",
          "text": "我们发现了一封信。"
        },
        {
          "role": "派蒙",
          "text": "请你自己看看吧…"
        },
        {
          "role": "长次",
          "text": "唔…好吧…"
        },
        {
          "role": "长次",
          "text": "我会读的。"
        },
        {
          "role": "旅行者",
          "text": "她的选择可能有些自私…"
        },
        {
          "role": "旅行者",
          "text": "但请不要为此责怪她。"
        },
        {
          "role": "长次",
          "text": "…我明白的。"
        },
        {
          "role": "长次",
          "text": "但我会继续找她，只有找到她，这些东西才真正有意义。"
        },
        {
          "role": "派蒙",
          "text": "这孩子…怎么这么执拗呀。"
        },
        {
          "role": "长次",
          "text": "这些晶石应该足够了。接下来我就要启程去冒险咯！"
        },
        {
          "role": "派蒙",
          "text": "还是好担心这孩子…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "照顾好自己。",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "嗯！"
                },
                {
                  "role": "派蒙",
                  "text": "喂，长次你不要再满嘴跑舌头啦！还好是遇上了我们…不然会被打的！"
                },
                {
                  "role": "派蒙",
                  "text": "还有还有，遇到坏人想要套话，也不要对他们讲实话！一定要乱胡诌！"
                },
                {
                  "role": "派蒙",
                  "text": "还有还有…"
                },
                {
                  "role": "旅行者",
                  "text": "派蒙变成老外婆了呢。"
                },
                {
                  "role": "派蒙",
                  "text": "这么小的孩子自己一个人出去冒险，谁会放心啦！"
                },
                {
                  "role": "旅行者",
                  "text": "我相信他。"
                },
                {
                  "role": "派蒙",
                  "text": "…真是的。"
                },
                {
                  "role": "长次",
                  "text": "哈哈哈哈！谢谢你们。"
                },
                {
                  "role": "长次",
                  "text": "希望我们以后还会见面。"
                },
                {
                  "role": "派蒙",
                  "text": "一定要注意安全呀…"
                },
                {
                  "role": "长次",
                  "text": "我没问题的！"
                },
                {
                  "role": "长次",
                  "text": "接下来我应该会去踏鞴砂，妈妈曾在那里工作过。或许还有人能告诉我她是否经过那边。"
                },
                {
                  "role": "长次",
                  "text": "再然后…我会想办法去鸣神岛。然后搭一艘至冬国的商船…之后的事情，随机应变。"
                },
                {
                  "role": "派蒙",
                  "text": "……"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你知道自己在说什么吗？",
                      "dialogues": []
                    },
                    {
                      "text": "你了解自己面对的风险吗？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "长次",
                  "text": "如果只因为不知道会面对怎样的风险，就不去做的话…这个世界上也不会有冒险家这种职业了吧？"
                },
                {
                  "role": "派蒙",
                  "text": "哇…这孩子真是气人…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "好吧…",
                      "dialogues": []
                    },
                    {
                      "text": "一定要小心。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "长次",
                  "text": "哈哈哈，放心啦！"
                },
                {
                  "role": "长次",
                  "text": "你们也一路平安！顺便，旅行者，希望你也能早日找到亲人。我是说，如果你也在追寻亲人的话。"
                },
                {
                  "role": "派蒙",
                  "text": "嗯！借你吉言！"
                }
              ]
            },
            {
              "text": "一定常联系。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "那么不耽搁你们的旅途啦，旅行者和小派蒙！"
        },
        {
          "role": "长次",
          "text": "祝你们一路顺风！"
        },
        {
          "role": "长次",
          "text": "你们好，又见面了！"
        },
        {
          "role": "派蒙",
          "text": "且慢——让我猜猜…"
        },
        {
          "role": "旅行者",
          "text": "「拜托再给我弄来一大堆晶石…」"
        },
        {
          "role": "派蒙",
          "text": "「…我有急用，呜呜…」"
        },
        {
          "role": "旅行者",
          "text": "这就是你想说的吧！"
        },
        {
          "role": "长次",
          "text": "哈哈哈哈哈，当然不是啦！"
        },
        {
          "role": "旅行者",
          "text": "你的旅途如何？"
        },
        {
          "role": "长次",
          "text": "还好，只是还没有找到妈妈的踪迹…"
        },
        {
          "role": "派蒙",
          "text": "没关系，我们也会帮忙的，对吧？旅行者？"
        },
        {
          "role": "旅行者",
          "text": "我们尽力而为。"
        },
        {
          "role": "长次",
          "text": "嗯，我就知道旅行者可以信赖！"
        },
        {
          "role": "长次",
          "text": "旅行者，没想到又能在这里看见你！"
        },
        {
          "role": "派蒙",
          "text": "好久不见啦！八酝岛外的世界怎么样？"
        },
        {
          "role": "长次",
          "text": "这里比家乡富裕很多，也有更多好吃的料理、好玩的东西。但是…我不太喜欢。"
        },
        {
          "role": "派蒙",
          "text": "欸？为什么？"
        },
        {
          "role": "长次",
          "text": "这里的人都缺少了些什么…"
        },
        {
          "role": "长次",
          "text": "从前在八酝岛生活的时候，大御所大人对我来说遥远安详…我们不会在意她在哪里，但是我们相信她就在这里，注视保护着我们，规定我们怎么过日子，成为什么样的人…"
        },
        {
          "role": "长次",
          "text": "但是在这里，大御所大人覆盖一切，威压一切…"
        },
        {
          "role": "长次",
          "text": "唉，我也说不清楚啦…"
        },
        {
          "role": "长次",
          "text": "对了，关于我的妈妈…你有发现什么吗？"
        },
        {
          "role": "旅行者",
          "text": "我们还在努力。"
        },
        {
          "role": "长次",
          "text": "没关系的，有消息再告诉我也不迟。"
        }
      ]
    }
  ]
}