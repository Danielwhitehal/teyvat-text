{
  "quest_id": 40199,
  "chapter_num": null,
  "chapter_title": "隐行谛勘，秽金之罪",
  "type": "wq",
  "route": "Covert Investigation, Dirty Money Misdeeds",
  "stories": [
    {
      "story_id": 40199,
      "title": "隐行谛勘，秽金之罪",
      "description": "夏日已至，在派蒙的提议下，你们前往遗珑埠品尝解暑祛火的绿茶，却意外遇见了正在忙碌的夜兰…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往遗珑埠品茶"
        },
        {
          "role": "派蒙",
          "text": "呼~天气慢慢热起来了，稍微运动一下，就像被关进了蒸笼里，完全提不起精神…"
        },
        {
          "role": "派蒙",
          "text": "是谁说的来着？绿茶能解暑祛火…不如，我们就趁着清闲，去遗珑埠品品茶？"
        },
        {
          "role": "派蒙",
          "text": "欸，那边在喝茶的人…不是夜兰吗？"
        },
        {
          "role": "夜兰",
          "text": "她好像在和朋友聚会？我们来得正巧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（不对，这个气氛…）",
              "dialogues": []
            },
            {
              "text": "（周围有不怀好意的视线…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸，不上去打招呼吗？"
        },
        {
          "role": "夜兰",
          "text": "前前后后忙了这么久，应该没有漏网之鱼了吧，埃德勒警官？"
        },
        {
          "role": "夜兰",
          "text": "外勤办案的时间应当还有几天，正好用来犒赏自己，适当度个假？"
        },
        {
          "role": "埃德勒",
          "text": "多谢您热情招待，夜兰小姐，这阵子简直忙掉了我半条命…"
        },
        {
          "role": "埃德勒",
          "text": "唔哎…十三个据点啊…那些家伙简直都是盗宝鼬成精！乌泱泱抓出那么一大批人的时候，我都怀疑冤枉了谁！"
        },
        {
          "role": "埃德勒",
          "text": "好在，终于把这帮经济犯一锅端掉了！现在，我就要去翘英庄，找我那位工程师同学安心叙叙旧。"
        },
        {
          "role": "夜兰",
          "text": "别忘了带些茶叶和点心，给执律庭的朋友们当礼物。"
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "埃德勒离开，两个在旁边窃听的人偷偷跟了上去…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "啊，夜兰的朋友走掉了，我还以为能认识一下呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（旁听的两人问题很大啊…）",
              "dialogues": []
            },
            {
              "text": "（夜兰不应该忽略了他们？）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "又是令人惊喜的偶遇啊，请坐。"
        },
        {
          "role": "夜兰",
          "text": "店家，请沏一壶品相最好的「云来白毫」，再补两套茶具。"
        },
        {
          "role": "夜兰",
          "text": "看你的眼神，应该对刚刚窥伺我们的那两人，很感兴趣吧？"
        },
        {
          "role": "派蒙",
          "text": "咦！什么叫窥伺？刚刚有其他人吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那两人显然不怀好意。",
              "dialogues": []
            },
            {
              "text": "你和你的枫丹朋友被窃听了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "可不止被窃听哦，他们可能已经派人跟上了埃德勒警官，针对我们的行动路线，开始采取对应措施了。"
        },
        {
          "role": "派蒙",
          "text": "我，我有点明白了！夜兰你是不是在对付什么奇怪的罪犯…"
        },
        {
          "role": "派蒙",
          "text": "那些家伙居然敢反过来跟踪你？未免也太胆大包天了！"
        },
        {
          "role": "夜兰",
          "text": "如果不是习惯了铤而走险的家伙，又怎么轮得到我来对付呢？我还想把功绩留给其他同行，好好休假呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能让你亲自出手，事情很严重？",
              "dialogues": []
            },
            {
              "text": "如此特殊的团体，犯了什么罪？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "涉案金额或达十位数的…「摩拉除痕」。"
        },
        {
          "role": "派蒙",
          "text": "摩拉厨…厨什么？不对，十位数…十位数是多少来着！"
        },
        {
          "role": "夜兰",
          "text": "简单来说，某位枫丹商人持有大量来路不正的摩拉，枫丹的执法机构可能根据种种痕迹锁定这笔钱。"
        },
        {
          "role": "夜兰",
          "text": "为了避免这笔钱被追查，牵连自己，就需要将其置换成合法的摩拉。"
        },
        {
          "role": "夜兰",
          "text": "于是，这名商人想到了一个点子——高价值艺术品的拍卖。"
        },
        {
          "role": "夜兰",
          "text": "他四处购买收藏品，运回枫丹后，将其包装成艺术价值极高的珍品，炒出高价。"
        },
        {
          "role": "夜兰",
          "text": "等到拍卖时，他用赃款买下自己炒上高价的收藏品。经过中间周转，除去差价后到手的摩拉就「干净」了。"
        },
        {
          "role": "夜兰",
          "text": "利用这一手段，这名商人不仅洗清了自己手中的赃款，甚至开始帮其他罪犯除痕，并因此得到了「黑钱领主」的称号。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这收藏品与璃月有关吧。",
              "dialogues": []
            },
            {
              "text": "否则也不会惊动到你。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "没办法，谁让沉玉谷的商品精美实惠，又历史悠久呢？茶具，瓷器，玉玦和石雕，都可以被包装成价值连城的艺术品。"
        },
        {
          "role": "夜兰",
          "text": "以璃月的商品为媒介，从事如此见不得人的勾当，长此以往，会对璃月的贸易造成难以估量的恶劣影响。"
        },
        {
          "role": "夜兰",
          "text": "为此，正好又在枫丹度假的我，就只能立刻回到工作状态了。"
        },
        {
          "role": "派蒙",
          "text": "唔…夜兰的解释还比较好懂？简直像…把钱从左手换到右手…只是经过了一个骗人的幌子！"
        },
        {
          "role": "派蒙",
          "text": "不过，既然你们已经明白了对方犯罪的方法，顺着这个线索，不就能揪出他了吗？"
        },
        {
          "role": "派蒙",
          "text": "比如在拍卖会上埋伏好，等到那个坏家伙出现，买下自己炒高价的璃月商品时，就冲上去把他铐起来！"
        },
        {
          "role": "夜兰",
          "text": "很敏锐嘛，派蒙，可惜还是不够谨慎哦。"
        },
        {
          "role": "夜兰",
          "text": "如果你是这一切的幕后黑手，你会轻易亲自现身，在别人眼皮底下东奔西走，忙活这一切吗？"
        },
        {
          "role": "派蒙",
          "text": "这么说来，好像确实不能轻易暴露呢…如果我是坏人，就让旅行者跑腿？"
        },
        {
          "role": "派蒙",
          "text": "不对不对，就算我成了坏人，旅行者也不会变坏，那我就…收下一大群小弟，帮我买货，干脏活！"
        },
        {
          "role": "派蒙",
          "text": "哦…哦哦哦哦哦…这下连我都理解了！"
        },
        {
          "role": "派蒙",
          "text": "就算追查到了那些有问题的收藏品，只要那个幕后黑手「黑钱领主」不亲自现身参加拍卖会，还是很难办！"
        },
        {
          "role": "夜兰",
          "text": "不止最后参加拍卖的人哦，来境外买收藏品、中转回国内，作为卖家与拍卖会沟通…这些事，他都有部下掩护。"
        },
        {
          "role": "夜兰",
          "text": "追查用来交易的收藏品，本身也是件复杂的任务，因为他采取了大量中转的措施，交易痕迹相当混乱。"
        },
        {
          "role": "夜兰",
          "text": "放长线，钓大鱼，才是眼下最理智的做法。"
        },
        {
          "role": "夜兰",
          "text": "最终目的是用轨迹清晰的鱼饵，避开所有障眼法，揪出隐藏在幕后的「黑钱领主」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以，你们有意让对方旁听。",
              "dialogues": []
            },
            {
              "text": "你们刚才在假装放松警惕。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我，我还以为你们真的是结束工作了，在放松呢…"
        },
        {
          "role": "夜兰",
          "text": "看来你完全上道了。"
        },
        {
          "role": "夜兰",
          "text": "在此之前，我已和千岩军沟通，协助埃德勒警官突袭了「黑钱领主」的众多据点，抓获了这个团体几乎所有的成员。"
        },
        {
          "role": "夜兰",
          "text": "而刚才那两位则是「黑钱领主」最重要的代理人，直接与他沟通的心腹。"
        },
        {
          "role": "夜兰",
          "text": "一位是枫丹古董协会的高级成员科德，负责拍卖事务，一位则是须弥船东多达马尼，从事货运行业多年…"
        },
        {
          "role": "夜兰",
          "text": "我们以相当自然的方式「漏掉」了谨慎的他们，会让他们以为自己走运幸存，采取紧急措施，处理钱款与货品。"
        },
        {
          "role": "夜兰",
          "text": "为此，那两人立刻追踪埃德勒警官，应当是想确认她的行踪，协助他们在璃月最后的部下安全地转移物资。"
        },
        {
          "role": "夜兰",
          "text": "现在，我要趁着他们的视线集中在埃德勒警官身上，打他们个出其不意。"
        },
        {
          "role": "夜兰",
          "text": "怎么样，有兴趣跟我同行吗？"
        },
        {
          "role": "夜兰",
          "text": "我很期待哦，你会在探案这一领域展现出怎样的才华呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也不能容忍罪犯们胡来。",
              "dialogues": []
            },
            {
              "text": "我也想和你一起工作试试。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！既然都遇上了这么重要的案件，我们肯定不能装作没看见！"
        },
        {
          "role": "派蒙",
          "text": "既是帮夜兰你，也是帮沉玉谷的大家，还有…唔…璃月的商界！"
        },
        {
          "role": "夜兰",
          "text": "令人欣赏的责任感啊，旅行者和派蒙…"
        },
        {
          "role": "夜兰",
          "text": "但也别忘了自己的利益。按枫丹流行的说法，最后给你们的酬劳，会对标「顶级探员」执行最危险外勤任务的薪资。"
        },
        {
          "role": "夜兰",
          "text": "万事开头难，好在，开头的线索已经有了眉目。"
        },
        {
          "role": "夜兰",
          "text": "「黑钱领主」的团体异常谨慎，所以，我们要从「反侦察」切入正轨。"
        },
        {
          "role": "夜兰",
          "text": "我有一种猜想…现在，我们先去东北方位转转，验证他们是否如我所料吧。"
        },
        {
          "type": "subtitle",
          "text": "前往可疑区域"
        },
        {
          "role": "夜兰",
          "text": "嗯，就从这里开始调查好了。"
        },
        {
          "type": "subtitle",
          "text": "跟随夜兰在沉玉谷东北荒无人烟的区域穿行…\n在夜兰的引导下，从隐秘的位置对海滩进行了一番侦察，成为了「暗中观察的眼哨」。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "并没有直接发现「黑钱领主」团伙的成员。周围的环境似乎也没有什么异常之处。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "结果…这里好像是普普通通的野外？根本没有坏家伙的痕迹嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别心急嘛，派蒙。",
              "dialogues": []
            },
            {
              "text": "还不是直接抓坏蛋的时候。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "嗯，旅行者已经明白自己要扮演怎样的角色了，进入状态的速度确实不比顶级探员逊色。"
        },
        {
          "role": "夜兰",
          "text": "现阶段，我们需要「布饵」，这鱼饵就是「黑钱领主」的赃物。所以「找到关键的物品」，比找人更重要。"
        },
        {
          "role": "夜兰",
          "text": "要找到赃物，锁定对方藏匿的据点，就是重中之重了。"
        },
        {
          "role": "夜兰",
          "text": "你难道没有觉得，这里的视野很棒吗？"
        },
        {
          "role": "派蒙",
          "text": "这么一说…好像可以看到遗珑埠的港口，远处水面的船，还有一座塔…那座塔是干什么的来着？"
        },
        {
          "role": "夜兰",
          "text": "是千岩军的灯塔，平时负责守望水域。必要时，则会打出频闪灯语，承担一定的通信作用。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像明白了这里的优势…",
              "dialogues": [
                {
                  "role": "夜兰",
                  "text": "哦？说说看？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "窥伺千岩军有利于他们行动…",
                      "dialogues": []
                    },
                    {
                      "text": "这里十分适合反侦察？",
                      "dialogues": []
                    },
                    {
                      "text": "要避开危险的路线运输赃物？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "夜兰",
                  "text": "八九不离十了。"
                }
              ]
            },
            {
              "text": "其实不太明白这里的特别之处…",
              "dialogues": [
                {
                  "role": "夜兰",
                  "text": "可以大胆猜猜看。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "观察千岩军，自己躲起来？",
                      "dialogues": []
                    },
                    {
                      "text": "在这里放哨，取得主动权？",
                      "dialogues": []
                    },
                    {
                      "text": "应该是观察点，而不是据点。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "夜兰",
                  "text": "你看，你的直觉非常准嘛。"
                }
              ]
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "千岩军百年如一日，不断派遣巡逻部队，将沉玉谷重点地区的治安维持得无可挑剔。"
        },
        {
          "role": "夜兰",
          "text": "利用这里的视野优势，观察千岩军的灯语，尽力推测千岩军的行动规律，能最大程度帮助「黑钱领主」转运赃物。"
        },
        {
          "role": "夜兰",
          "text": "那么，附近应当会有「黑钱领主」的眼哨留下的痕迹…"
        },
        {
          "role": "派蒙",
          "text": "太…太复杂了，完全跟不上你们的思路…"
        },
        {
          "role": "夜兰",
          "text": "总之，拿着这部{{颜色|蓝|「综像勘录仪」}}，调查并记录附近的情况吧，细心寻找线索，必定不会空手而归。"
        },
        {
          "type": "subtitle",
          "text": "获得小道具{{图标|综像勘录仪}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "综像勘录仪"
        },
        {
          "type": "subtitle",
          "text": "特殊的留影探案设备，可以在拍摄状态下移动、缩放，从多个位置和角度调查现场，发现隐藏的线索。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "装备道具并与夜兰对话"
        },
        {
          "type": "subtitle",
          "text": "玩法教学（综像勘录仪）"
        },
        {
          "type": "subtitle",
          "text": "使用「综像勘录仪」时，可以在拍摄状态下移动，调整调查现场的位置。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "同时，该设备还具有缩放功能，可以站在高处拍摄一定距离外的目标…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "得益于特殊的镜头组，「综像勘录仪」还可以捕捉到肉眼无法看到的特殊痕迹…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "将可疑物体放大并置于镜头正中，一段时间后便将自动留影并完成取证…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "未装备道具"
        },
        {
          "role": "夜兰",
          "text": "装备好{{颜色|蓝|「综像勘录仪」}}后，再开始调查吧。"
        },
        {
          "role": "夜兰",
          "text": "怎么样，准备就绪了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可以开始调查了。",
              "dialogues": [
                {
                  "role": "夜兰",
                  "text": "请细心观察，许多线索可能并不起眼…"
                },
                {
                  "type": "subtitle",
                  "text": "与夜兰一同前往了调查区域…",
                  "narration": true,
                  "color": "描述"
                }
              ]
            },
            {
              "text": "稍等，我再检查一下。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "调查可疑区域"
        },
        {
          "type": "subtitle",
          "text": "对照图片，找出岛上可疑之处"
        },
        {
          "type": "subtitle",
          "text": "反向盯梢点"
        },
        {
          "role": "[[file",
          "text": "谛踪匿行-反向盯梢点.png|center|500px]]"
        },
        {
          "type": "subtitle",
          "text": "这是本区域此前场景的留影，由璃月千岩军通过俯瞰机关摄制。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "离开区域时"
        },
        {
          "role": "派蒙",
          "text": "查案要紧，还是不要离开调查区域吧！"
        },
        {
          "role": "派蒙",
          "text": "柴火痕迹还很新，看来没几天前，就有人在这里做过饭！"
        },
        {
          "role": "派蒙",
          "text": "呜…这条船的摆放好像有问题，看起来，最近被人使用过！"
        },
        {
          "role": "夜兰",
          "text": "微微隆起的土包？浮土被浪卷走了吗…地下显然藏着什么东西。"
        },
        {
          "type": "subtitle",
          "text": "与夜兰对话"
        },
        {
          "role": "夜兰",
          "text": "收获还不错。"
        },
        {
          "role": "夜兰",
          "text": "一柄钥匙，应当可以打开某扇关键的门；鸽子传信筒中，则有着许多暗语写成的短讯。"
        },
        {
          "role": "[[file",
          "text": "活动任务-隐行谛勘，秽金之罪-钥匙.png|center|150px]]"
        },
        {
          "role": "派蒙",
          "text": "噫…真的在这里藏着一些作案工具…那帮家伙未免也太大胆了！"
        },
        {
          "role": "派蒙",
          "text": "不怕观察千岩军的时候，被千岩军发现，抓起来好好调查吗？"
        },
        {
          "role": "夜兰",
          "text": "这些器物表明，「黑钱领主」的眼哨有很大概率伪装成了渔民，他们的心理素质足够死硬…"
        },
        {
          "role": "夜兰",
          "text": "如果眼哨坚持宣称，自己只是找了个清静的地方歇脚，没有关键证据，千岩军也不可能扣押一个平民，对其深入调查。"
        },
        {
          "role": "派蒙",
          "text": "呃…我都能想象出那人死皮赖脸的模样了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好在，我们找到了这些东西。",
              "dialogues": []
            },
            {
              "text": "利用这些线索，能推进调查。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "藏匿器物的痕迹还很新，说明部署在这里的眼哨另有一人并未被埃德勒抓捕，还在活动。"
        },
        {
          "role": "夜兰",
          "text": "我们需要警惕，不能让对方意识到，我们还在追踪调查。"
        },
        {
          "type": "subtitle",
          "text": "夜兰显然有备而来，取出一套精巧的工具组，首先原样复刻了那柄钥匙，随后针对性记录了传信筒中的暗语片段…\n随后，夜兰将现场恢复成了原状，完全看不出有过调查的痕迹。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "夜兰",
          "text": "好了，既然我的猜想得到了验证，黑钱领主确实在这里安插了眼哨，那么，藏匿货物的据点会在哪呢…"
        },
        {
          "role": "夜兰",
          "text": "你怎么看，旅行者？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像有点思路了…",
              "dialogues": [
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "监视行动的时间很敏感…",
                      "dialogues": []
                    },
                    {
                      "text": "传信要快捷？",
                      "dialogues": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "没什么头绪…",
              "dialogues": [
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "但既然要传递紧要信息…",
                      "dialogues": []
                    },
                    {
                      "text": "总要考虑信鸽的飞行时间？",
                      "dialogues": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "完美的直觉，之后似乎不用对你进行过多的暗示了。"
        },
        {
          "role": "夜兰",
          "text": "以信鸽的速度，在较短时间内能够飞行的距离，画一个敏感圈…"
        },
        {
          "role": "夜兰",
          "text": "再避开灯塔的视野，与人多眼杂的道路…"
        },
        {
          "role": "派蒙",
          "text": "推算出来的位置是…暝垣山北边的浅滩？"
        },
        {
          "role": "夜兰",
          "text": "这样看来，是一片相当可疑的区域，充分利用了山体的掩护，还有着俗语中「灯下黑」的便捷。"
        },
        {
          "role": "夜兰",
          "text": "下一站的目的地很明确了，我们动身吧。"
        },
        {
          "type": "subtitle",
          "text": "前往下个线索区"
        },
        {
          "role": "派蒙",
          "text": "看起来，依然只是一片普普通通的野外呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但有了上次的经验…",
              "dialogues": []
            },
            {
              "text": "越普通，越可能藏着玄机…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "别放过任何可疑的迹象哦，我相信你们。"
        },
        {
          "type": "subtitle",
          "text": "装备道具并与夜兰对话"
        },
        {
          "role": "夜兰",
          "text": "这次的线索可能隐藏得更深，准备好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可以开始调查了。",
              "dialogues": [
                {
                  "role": "夜兰",
                  "text": "嗯，拿出之前那种细致的洞察力，我相信你。"
                },
                {
                  "type": "subtitle",
                  "text": "在可疑的区域开始了调查…",
                  "narration": true,
                  "color": "描述"
                }
              ]
            },
            {
              "text": "稍等，我再检查一下。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "调查可疑区域"
        },
        {
          "type": "subtitle",
          "text": "对照图片，找出附近可疑之处"
        },
        {
          "type": "subtitle",
          "text": "关键据点"
        },
        {
          "role": "[[file",
          "text": "谛踪匿行-关键据点.png|center|500px]]"
        },
        {
          "type": "subtitle",
          "text": "这是本区域此前场景的留影，由璃月千岩军通过俯瞰机关摄制。",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "这是…箱子的碎片？还很新…应该是搬东西的时候不小心打碎了箱子？"
        },
        {
          "role": "派蒙",
          "text": "树枝上挂着一盏灯！我都能猜到，肯定有人趁着半夜在这里干过活！"
        },
        {
          "role": "夜兰",
          "text": "浅滩上有大量脚印，重物拖拽的痕迹延伸到草地深处，说明有人搬运过重物。"
        },
        {
          "role": "夜兰",
          "text": "石头的位置与以前不同了，似乎是想掩盖什么东西…"
        },
        {
          "type": "subtitle",
          "text": "与夜兰对话"
        },
        {
          "role": "派蒙",
          "text": "找到了找到了！这就是那些家伙藏匿货物的据点了吧…还挺隐蔽呢！"
        },
        {
          "role": "夜兰",
          "text": "令人惊叹的效率，我开始期待你独自探案的潜力了…"
        },
        {
          "role": "夜兰",
          "text": "好了，让我们试试看，上个哨点找到的那柄钥匙，能否带来更多惊喜。"
        },
        {
          "role": "夜兰",
          "text": "嗯，终究是在客场行动，他们没法布置更多诱饵了，这倒是方便了我们。"
        },
        {
          "role": "夜兰",
          "text": "接下来就交给我吧，进入他们的藏身处后，每一步都需要小心谨慎，不能留下任何痕迹。"
        },
        {
          "role": "夜兰",
          "text": "请在外面帮我放风，避免我们在调查期间和对方撞个正着。"
        },
        {
          "role": "派蒙",
          "text": "好！虽然我们没有干过这样的活，但我相信旅行者，让他保护你！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "夜兰肯定算准了时机…",
              "dialogues": []
            },
            {
              "text": "那些家伙不会回来的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "也，也对哦…夜兰做事好像从来不留破绽呢…"
        },
        {
          "type": "subtitle",
          "text": "开启据点的大门后，夜兰仔细观察，确认据点的内部构造是一般的地窖…\n碍于施工不便，对方并未完全封闭据点的顶部和侧墙，偶尔会有水分从土壤析出，在据点中流淌…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "于是，夜兰以纤薄的水元素覆盖双手。\n如此一来，即便她需要接触据点中的器物，随着时间推移，水汽自然蒸发，也会带走她的行动痕迹。\n随后，夜兰谨慎地进入了隐秘据点，开始探查封存其中的商品…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "夜兰",
          "text": "一切就绪，我记录了据点内所有瓷器、花瓶和茶叶的特征。"
        },
        {
          "role": "夜兰",
          "text": "在拍卖会的现场，我们就能借助这些特征，盯住试图拍下对应收藏品的买家，进而不断放长鱼线…"
        },
        {
          "role": "派蒙",
          "text": "动作好快，未免也太熟练了啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "接下来怎么办？",
              "dialogues": []
            },
            {
              "text": "下一步行动呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "放松，放松。枫丹的拍卖会相当之多，我们不可能对每场拍卖会加以监控，那太过浪费人力。"
        },
        {
          "role": "夜兰",
          "text": "所以，我会在附近潜伏下来，一面监视这里的情况，一面破解他们用来传讯的暗语。"
        },
        {
          "role": "夜兰",
          "text": "等到那两名犯人转移这批货品，再针对性排查此后即将召开的拍卖会。"
        },
        {
          "role": "派蒙",
          "text": "明白了，现在我们要做的，就是等！"
        },
        {
          "role": "派蒙",
          "text": "等到他们自己露出破绽，然后跟上去，揪出幕后黑手，哐哐给他两拳！"
        },
        {
          "role": "夜兰",
          "text": "带着那两人在翘英庄转悠几圈后，埃德勒警官也会等待他们离开，并反向进行追踪。"
        },
        {
          "role": "夜兰",
          "text": "加上之前给他们施加的巨大压力，我想，不用多久，他们就会沉不住气的。"
        },
        {
          "role": "夜兰",
          "text": "到时候，我们就在遗珑埠的港口附近会合吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（埃德勒）"
        },
        {
          "role": "埃德勒",
          "text": "啊，是旅行者准领队！听夜兰小姐说，您也加入这次行动了…"
        },
        {
          "role": "埃德勒",
          "text": "那一切稳得不能再稳了，「黑钱领主」和他最后的几个部下都该洗好脖子，乖乖等死！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你回来了？好快！",
              "dialogues": [
                {
                  "role": "埃德勒",
                  "text": "毕竟只是帮夜兰小姐引开那帮家伙的注意力嘛，任务不重，时间要求其实挺宽松的。"
                },
                {
                  "role": "埃德勒",
                  "text": "科德和多达马尼那俩厮，跟得很紧，见我和[[沃特蒙泰涅]]坐下吃甜点，好几个小时没动弹，就假装是观光买茶的游客。"
                },
                {
                  "role": "埃德勒",
                  "text": "我提前和沃特蒙泰涅打好了招呼，让她告诉附近的店家，给那些坏人狠狠加价，店家就随手多写了两个零。"
                },
                {
                  "role": "埃德勒",
                  "text": "结果那两家伙，为了不显得自己可疑，还真掏钱买了，给我和沃特蒙泰涅乐开了花！"
                },
                {
                  "role": "埃德勒",
                  "text": "给翘英庄的乡亲们增加一点营收，也算是给他们赔个不是。毕竟，引着犯人到处逛，到了他们庄里，多少有点晦气。"
                },
                {
                  "role": "埃德勒",
                  "text": "那就用钱财补偿尽可能除掉这股晦气好了。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "感觉你说话的方式很璃月。",
                      "dialogues": []
                    },
                    {
                      "text": "你的用词有股亲切感…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "埃德勒",
                  "text": "啊哈，那说明我做的功课还算到位，天赋也还不错。"
                },
                {
                  "role": "埃德勒",
                  "text": "四年级做同桌的时候，沃特蒙泰涅就说过，我学老师说话的腔调可像了！这天赋倒是给我的工作带来了不少好处…"
                },
                {
                  "role": "埃德勒",
                  "text": "「干探员这行的，理应走到哪，就融入当地的氛围。和孩子们说话就可爱点，和璃月友人说话就文雅礼貌，或者接地气…」"
                },
                {
                  "role": "埃德勒",
                  "text": "「和罪犯们聊天，就该粗暴用词不离口，骂脏点。」"
                },
                {
                  "role": "埃德勒",
                  "text": "格罗里夏尔队长的原话如是说。"
                },
                {
                  "role": "埃德勒",
                  "text": "话说回来，我还没听过他骂人呢。这次押送犯人回去以后，说不定就有机会见识队长最有攻击性，最狂野的粗口了"
                },
                {
                  "role": "埃德勒",
                  "text": "真期待啊！"
                }
              ]
            },
            {
              "text": "不要说这种反派一样的话…",
              "dialogues": [
                {
                  "role": "埃德勒",
                  "text": "没事没事，我在孩子们面前会学着童话书里的口吻讲故事，不会教坏他们的。在正式执行公务的时候，也会注意语气！"
                },
                {
                  "role": "埃德勒",
                  "text": "对付穷凶极恶的罪犯，必须在狠劲上压倒他们，这样才不会被他们的气焰压制。"
                },
                {
                  "role": "埃德勒",
                  "text": "我不介意成为罪犯们口中的「刽子手」、「断头台」。不过，这么威风的称呼，还是留给您这种大人物比较好。"
                },
                {
                  "role": "埃德勒",
                  "text": "您也来试着恶狠狠地说话吧！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那…我以后多凶凶坏人？",
                      "dialogues": [
                        {
                          "role": "埃德勒",
                          "text": "好呀好呀，多凶多凶！"
                        },
                        {
                          "role": "埃德勒",
                          "text": "以你的实力和威望，对着恶棍随便凶一下，他们都会吓到丢魂吧！"
                        }
                      ]
                    },
                    {
                      "text": "我要讲礼貌，不可以教坏派蒙。",
                      "dialogues": [
                        {
                          "role": "埃德勒",
                          "text": "哎，说得也对。我的同事都说，你的那位伙伴派蒙啊，乖巧机灵又可爱，确实不能给伙伴造成不好的影响。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "所以…你可以偷偷凶人！"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "最后几个部下？",
              "dialogues": [
                {
                  "role": "埃德勒",
                  "text": "是的，毕竟这次的行动已经进行了好几个月，夜兰小姐出手又利落干脆，效率高得让我无比羡慕。"
                },
                {
                  "role": "埃德勒",
                  "text": "现在，「黑钱领主」身边只剩他最关键的心腹了，行动能力大大受限，被我们逮住也只是时间问题…"
                },
                {
                  "role": "埃德勒",
                  "text": "难道说，您觉得抓到的犯人太少，成就感不够吗？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "没事，不求最多但求最重要。",
                      "dialogues": [
                        {
                          "role": "埃德勒",
                          "text": "既然如此，下次，如果您还有协助探案的意愿，我就专挑困难的案情留给您，让您尽情享受打败狡诈罪犯的过程！"
                        }
                      ]
                    },
                    {
                      "text": "确实，多多抓犯人非常重要。",
                      "dialogues": [
                        {
                          "role": "埃德勒",
                          "text": "实在抱歉，下次，如果您还有协助探案的意愿，我就早点想办法邀请您，让您尽情多抓犯罪团伙的成员，也抓个乌泱泱一片！"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "其实还想了解对方的情况。",
              "dialogues": [
                {
                  "role": "埃德勒",
                  "text": "你是说，「黑钱领主」团队的情报吗？主要想听哪方面的内容呢？请尽管问，我都可以回答！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "关于「摩拉除痕」的细节…",
                      "dialogues": [
                        {
                          "role": "埃德勒",
                          "text": "嗯，夜兰小姐应该给你说过基本的逻辑了——通过买下虚假估值的拍卖品，经过多重交易，把脏的钱变干净。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "除了利用拍卖会保护供货者和交易者个人隐私的法律漏洞，在执行环节，他们还玩了不少花样。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "比如，他用来买下国外收藏品的摩拉，本身就经过了重重转手，甚至以物易物再换回摩拉，以此来逃脱监管。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "在外地买东西时，他们也会通过让部下变装、花钱委托别人帮忙等方式，使得交易记录几乎完全不可被追查。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "这些收藏品在参加拍卖会前都属于普通货物，运往枫丹的过程中，执法单位很难定位它们，就算找到了也很难把它们怎么样。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "是不是听起来很无赖，很让人恼火？"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "谢谢，已经咬牙切齿了。",
                              "dialogues": []
                            },
                            {
                              "text": "一般，只是想多给他们几拳。",
                              "dialogues": []
                            }
                          ]
                        },
                        {
                          "role": "埃德勒",
                          "text": "其实「黑钱领主」还有别的洗钱渠道呢！包括但不限于虚假的慈善基金、投资映影项目、空壳商会…"
                        },
                        {
                          "role": "埃德勒",
                          "text": "那家伙本身就吞并了这种勾当的所有同行，所以花招多得不得了。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "好在，现在正义的一方夺得了上风。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "在枫丹本土，得益于刺玫会的有力协助，我们已经把上述花招中的大部分拆开掰碎，切作细末了。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "至于这种拍卖品洗钱的方式，现在也被我们控制得七七八八，只留最后的几个开口，以便我们追查主谋。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "有您来协助，打出一锤定音的关键重击，彻底干掉「黑钱领主」，完全只是时间问题了！"
                        }
                      ]
                    },
                    {
                      "text": "罪犯们会怎么样？",
                      "dialogues": [
                        {
                          "role": "埃德勒",
                          "text": "好问题。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "此事涉及璃月和枫丹两国，除去「黑钱领主」自身四个层级的部下外，有大量不知情的人员被卷入其中。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "经过双方商议，目前采取的方案是，先由璃月一方将全数境内罪犯管控，审讯，录下口供，作为案件记录的主体。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "随后由枫丹方将其中的枫丹人引渡回国，查处所有与其相关的财产，并进一步杜绝相关罪犯漏网的可能。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "等到主犯黑钱领主落网，双方会再次进行商议，共同组建团体，对所有罪犯进行正式审理。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "据我的判断，只是帮忙买点东西的、不知情的本地人，应该只会被要求上缴从犯罪团伙手中获得的钱财，然后接受批评教育…"
                        },
                        {
                          "role": "埃德勒",
                          "text": "团伙中第三级的罪犯开始，面临的牢狱之灾就该十年起步了。"
                        },
                        {
                          "role": "埃德勒",
                          "text": "至于「黑钱领主」，他必须牢底坐穿！"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "一起加油破案吧！",
              "dialogues": [
                {
                  "role": "埃德勒",
                  "text": "好！期待您的发挥！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（萝克珊&阿林）"
        },
        {
          "role": "萝克珊",
          "text": "坏家伙都在这里了吗，林上校？"
        },
        {
          "role": "阿林",
          "text": "没错，这里是最后一批完成审讯，录完口供的罪犯，之前的五批已经押送到船上了。"
        },
        {
          "role": "萝克珊",
          "text": "数量还挺多的…这些枫丹的败类，就由我们好好教训，不会再放他们出来丢人现眼了。"
        },
        {
          "role": "萝克珊",
          "text": "真是辛苦你了，林上校！"
        },
        {
          "role": "萝克珊",
          "text": "等你来枫丹，我一定请你到特巡队餐厅的美露莘用餐区吃一顿，那边的黄油汐藻，口味一绝，最适合犒劳勤恳干活的我们！"
        },
        {
          "role": "阿林",
          "text": "实在感谢，不过，在下职务在身，可见的十年内，都不会离开沉玉谷。希望再远的将来能有机会吧。"
        },
        {
