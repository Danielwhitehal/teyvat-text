{
  "quest_id": 72185,
  "chapter_num": null,
  "chapter_title": "异国的披萨",
  "type": "wq",
  "route": "Pizza From Another Land",
  "stories": [
    {
      "story_id": 72185,
      "title": "异国的披萨",
      "description": "「木南料亭」的木南杏奈小姐似乎正在被什么事困扰…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与木南杏奈对话"
        },
        {
          "type": "subtitle",
          "text": "与松本对话"
        },
        {
          "role": "松本",
          "text": "唉，这个世界上还有能满足我味蕾的新奇菜肴吗？"
        },
        {
          "role": "旅行者",
          "text": "关于「木南料亭」的披萨…"
        },
        {
          "role": "松本",
          "text": "你说那个披萨啊，味道确实不错，还融合了不少本地的食材。"
        },
        {
          "role": "松本",
          "text": "不过，我之前也尝过正宗的「烤蘑菇披萨」。"
        },
        {
          "role": "松本",
          "text": "我记得，那种披萨是由奶酪，卷心菜和蘑菇做成的来着…"
        },
        {
          "role": "松本",
          "text": "哈哈哈，我个人是觉得，这种异国的食物，最好还是保持着异国的特色比较好啦。"
        },
        {
          "type": "subtitle",
          "text": "向木南杏奈回报"
        },
        {
          "role": "木南杏奈",
          "text": "旅行者，你回来了。"
        },
        {
          "role": "木南杏奈",
          "text": "怎么样，你有问到什么吗？"
        },
        {
          "role": "旅行者",
          "text": "关于客人们的反馈…"
        },
        {
          "role": "木南杏奈",
          "text": "原汁原味的「烤蘑菇披萨」啊…嗯，倒是可以试试看。"
        },
        {
          "role": "木南杏奈",
          "text": "要准备的材料是奶酪、卷心菜和蘑菇…"
        },
        {
          "role": "木南杏奈",
          "text": "其余的材料店里倒是有，可是这个奶酪，店里平时也没储备多少…"
        },
        {
          "role": "木南杏奈",
          "text": "旅行者，能请你帮我去拿一份奶酪来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "木南杏奈",
                  "text": "那就拜托你了，只要一份奶酪就好。"
                }
              ]
            },
            {
              "text": "店里平时都不用奶酪的吗？",
              "dialogues": [
                {
                  "role": "木南杏奈",
                  "text": "也不能说完全不用，只能说用得很少。"
                },
                {
                  "role": "木南杏奈",
                  "text": "毕竟，店里的这些菜，也没几道要用到奶酪的，所以储备得很少…"
                },
                {
                  "role": "木南杏奈",
                  "text": "总之，就拜托你了旅行者，请帮我带一份奶酪回来吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "将奶酪带回给木南杏奈"
        },
        {
          "role": "木南杏奈",
          "text": "你把食材带回来了吗？"
        },
        {
          "type": "subtitle",
          "text": "与木南杏奈对话"
        },
        {
          "role": "木南杏奈",
          "text": "谢谢你，有这些食材就够了。"
        },
        {
          "role": "木南杏奈",
          "text": "原汁原味的蒙德「烤蘑菇披萨」，不知道能不能顺利做出来…"
        },
        {
          "role": "木南杏奈",
          "text": "完成了！"
        },
        {
          "role": "木南杏奈",
          "text": "这披萨…看上去还不错…"
        },
        {
          "role": "木南杏奈",
          "text": "谢谢你帮忙，旅行者，这些东西请你收下吧。"
        },
        {
          "role": "木南杏奈",
          "text": "我等会就去仔细品尝一下这份披萨的味道…"
        },
        {
          "role": "木南杏奈",
          "text": "如果还不错的话…应该很快就能作为新品正式推出啦。"
        }
      ]
    }
  ]
}