{
  "quest_id": 10129,
  "chapter_num": "游水酝诗籍 第三首",
  "chapter_title": "幽潭心",
  "type": "eq",
  "route": "Heart of the Deep",
  "stories": [
    {
      "story_id": 40126,
      "title": "幽潭心",
      "description": "落叶载着往事流过…故事中的二人，还能否将那段遥远的感情弥合…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等到第二天白天（8-10点）"
        },
        {
          "role": "派蒙",
          "text": "休息得好饱，我们这就去会场吧！"
        },
        {
          "role": "派蒙",
          "text": "其他人会写什么样的诗呢，好期待呀。"
        },
        {
          "type": "subtitle",
          "text": "前往活动会场"
        },
        {
          "role": "派蒙",
          "text": "欸，怎么感觉人变少了？"
        },
        {
          "role": "重云",
          "text": "两位早。行秋说他想认真写两首，晚点再来和大家会合。"
        },
        {
          "role": "米卡",
          "text": "诺艾尔前辈今天也有其他任务在身，让我转告各位不用等她。"
        },
        {
          "role": "派蒙",
          "text": "好吧。还有卡莉露呢？卡莉露怎么也没有来？"
        },
        {
          "role": "迪奥娜",
          "text": "我很早就来了，没见到她呀。"
        },
        {
          "role": "重云",
          "text": "在说那位蓝色头发的小姐吗？我晨练的时候在荻花洲附近的桥头看到她了。"
        },
        {
          "role": "重云",
          "text": "她好像有些难过的样子。我没敢搭话…"
        },
        {
          "role": "派蒙",
          "text": "难过的样子？唔…怎么办，该不会是昨晚我们说错什么话了吧？我有些担心…"
        },
        {
          "role": "旅行者",
          "text": "一起去找找吧。"
        },
        {
          "role": "米卡",
          "text": "我同意，如果卡莉露小姐遇到了什么困难，我想帮上她的忙。"
        },
        {
          "role": "迪奥娜",
          "text": "欸？都要去吗？那我也去。"
        },
        {
          "role": "重云",
          "text": "那就先从桥的附近找起吧？趁大家来得都早。"
        },
        {
          "role": "派蒙",
          "text": "对，我们快去快回。"
        },
        {
          "type": "subtitle",
          "text": "寻找卡莉露"
        },
        {
          "role": "米卡",
          "text": "欸？这里也是我们昨天遇到卡莉露小姐的地方！"
        },
        {
          "role": "米卡",
          "text": "刚见面的时候，她也是一副心事重重的样子。"
        },
        {
          "role": "派蒙",
          "text": "离我们放叶子的地方还挺近…"
        },
        {
          "role": "米卡",
          "text": "叶子？"
        },
        {
          "role": "派蒙",
          "text": "对哦，昨天全在忙着对对子了…"
        },
        {
          "type": "subtitle",
          "text": "和众人讲述了昨天采风时发生的事…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "米卡",
          "text": "原来是这样…"
        },
        {
          "role": "米卡",
          "text": "唔…我在想，卡莉露小姐会不会就是放下那片叶子的人呢？"
        },
        {
          "role": "派蒙",
          "text": "欸？为什么？"
        },
        {
          "role": "米卡",
          "text": "啊，抱歉，我没什么根据，这仅仅是我的猜想罢了…"
        },
        {
          "role": "米卡",
          "text": "卡莉露小姐当时的样子，和诗里那种悲伤的感觉很像…"
        },
        {
          "role": "重云",
          "text": "真要这么说的话…这里也的确是水流的上游…"
        },
        {
          "role": "迪奥娜",
          "text": "…嗯？"
        },
        {
          "role": "迪奥娜",
          "text": "欸！你们快看，那里那里！又一片树叶！"
        },
        {
          "role": "派蒙",
          "text": "…真的！好像还写了字！"
        },
        {
          "role": "派蒙",
          "text": "我们快追上去吧！"
        },
        {
          "type": "subtitle",
          "text": "追赶树叶"
        },
        {
          "role": "派蒙",
          "text": "可恶…它漂得好快…"
        },
        {
          "type": "subtitle",
          "text": "你们继续追赶",
          "narration": true,
          "color": "gray"
        },
        {
          "role": "迪奥娜",
          "text": "派蒙不能飞过去捡吗？"
        },
        {
          "role": "派蒙",
          "text": "欸？可…可我不会游泳，万一飞太快掉到水里…"
        },
        {
          "type": "subtitle",
          "text": "你们继续追赶",
          "narration": true,
          "color": "gray"
        },
        {
          "role": "重云",
          "text": "它停下来了！"
        },
        {
          "role": "派蒙",
          "text": "…趁现在！"
        },
        {
          "type": "subtitle",
          "text": "捡起树叶"
        },
        {
          "role": "派蒙",
          "text": "呼…总算是追上了…"
        },
        {
          "role": "米卡",
          "text": "上面的字还完整吗？没有被打湿吧？"
        },
        {
          "role": "派蒙",
          "text": "能看清的，我看看上面写了什么…"
        },
        {
          "type": "subtitle",
          "text": "落叶上的诗"
        },
        {
          "type": "subtitle",
          "text": "情愫虽存，时光已逝。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "泉水旁的少年，如今白鬓逶迟。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "只待溪流与梦想汇入同一片大海，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "我们才会在无尽的诗篇中双手相执。",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "咦？这内容和我们昨天回的诗有关欸！她一定捡到了我们的叶子吧！"
        },
        {
          "role": "派蒙",
          "text": "「泉水」，「少年」…"
        },
        {
          "role": "派蒙",
          "text": "唔，这么一看，还真像卡莉露写的。"
        },
        {
          "role": "迪奥娜",
          "text": "她真的好在意那个故事呀。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，其实我一开始看到卡莉露就在猜…"
        },
        {
          "role": "派蒙",
          "text": "你说她会不会是…"
        },
        {
          "role": "旅行者",
          "text": "还是先找到她最重要。"
        },
        {
          "role": "米卡",
          "text": "按照水域的流向和风力的影响…各位，请跟我来。"
        },
        {
          "type": "subtitle",
          "text": "跟随米卡"
        },
        {
          "role": "米卡",
          "text": "我们已经到比较上游的地方了，大家分散开，在附近找找吧。"
        },
        {
          "role": "派蒙",
          "text": "卡莉露——卡莉露——"
        },
        {
          "type": "subtitle",
          "text": "驱赶魔物"
        },
        {
          "type": "subtitle",
          "text": "你们看到了远处的卡莉露…",
          "narration": true,
          "color": "gray"
        },
        {
          "role": "派蒙",
          "text": "呀！卡莉露被丘丘人围住了，我们快去帮帮她！"
        },
        {
          "type": "subtitle",
          "text": "与卡莉露对话"
        },
        {
          "role": "派蒙",
          "text": "呼…卡莉露你没事吧？"
        },
        {
          "role": "派蒙",
          "text": "呃…！这这这，这是什么？"
        },
        {
          "type": "subtitle",
          "text": "驱散魔物后，你们却不见卡莉露身影，转而发现一只水形幻灵…",
          "narration": true,
          "color": "gray"
        },
        {
          "role": "迪奥娜",
          "text": "好大一颗水珠！"
        },
        {
          "role": "重云",
          "text": "这，这不就是我那天看到的非人之物吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…大水珠？",
              "dialogues": []
            },
            {
              "text": "…卡莉露？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "…咦？大家为什么这样看着我？"
        },
        {
          "role": "？？？",
          "text": "…！难道说，我的身形…"
        },
        {
          "role": "米卡",
          "text": "这声音…的确是卡莉露小姐。"
        },
        {
          "role": "？？？",
          "text": "怎么会这样…请稍等一下…"
        },
        {
          "type": "subtitle",
          "text": "在众人的注视下，水珠慢慢变回了卡莉露的模样…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "卡莉露",
          "text": "唔…是消耗得太快了吗…"
        },
        {
          "role": "重云",
          "text": "这…这是怎么回事？卡莉露小姐，莫非是仙物吗？"
        },
        {
          "role": "卡莉露",
          "text": "不…抱歉瞒了大家这么久…我其实，是一只很久以前从枫丹流落至此的纯水精灵…"
        },
        {
          "role": "重云",
          "text": "纯水精灵？"
        },
        {
          "role": "米卡",
          "text": "啊，我听大团长说起过。纯水精灵是枫丹前代水神的眷属，在前代水神死后离开枫丹，逃往各国…"
        },
        {
          "role": "卡莉露",
          "text": "没错…但，说实话，我已经有些不记得自己是怎么逃到这里来的了…"
        },
        {
          "role": "卡莉露",
          "text": "家乡的风景还有浅浅的印象，但沿途的风光实在记不真切…"
        },
        {
          "role": "卡莉露",
          "text": "只知道我来到蒙德的时候，已经失去了大部分力量，甚至无法维持稳定的实体…"
        },
        {
          "role": "卡莉露",
          "text": "最后，我在一处名叫「清泉镇」的地方定居了下来，慢慢恢复着自己的力量…"
        },
        {
          "role": "卡莉露",
          "text": "清泉镇僻静幽美，水流清澈无瑕，就和住在那里人们的心灵一样。"
        },
        {
          "role": "迪奥娜",
          "text": "你就是清泉镇的「泉水精灵」？"
        },
        {
          "role": "卡莉露",
          "text": "是啊，迪奥娜，我记得你哟。小时候，你经常在夜晚来到泉边和我说话。"
        },
        {
          "role": "迪奥娜",
          "text": "真的吗？你没在骗我哦？"
        },
        {
          "role": "米卡",
          "text": "（我，我还一直以为那只是清泉镇的传说…）"
        },
        {
          "role": "卡莉露",
          "text": "那个你很喜欢的小鱼抱枕，是叫「泡泡」对吧？"
        },
        {
          "role": "迪奥娜",
          "text": "…对！"
        },
        {
          "role": "迪奥娜",
          "text": "（小时候的那些，都不是梦！）"
        },
        {
          "role": "派蒙",
          "text": "这么说来…落叶诗上写的事情…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "月光像一绸绸蜂蜜…",
              "dialogues": []
            },
            {
              "text": "泉水旁的少年白鬓逶迟…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡莉露",
          "text": "原来是这样吗…是你们拾到了我的树叶…"
        },
        {
          "role": "卡莉露",
          "text": "没错…那本《清泉之心》中的泉水精灵，就是我。"
        },
        {
          "role": "派蒙",
          "text": "难怪你那么在意！"
        },
        {
          "role": "派蒙",
          "text": "那，故事里的男孩…"
        },
        {
          "role": "卡莉露",
          "text": "…就是芬奇。"
        },
        {
          "role": "卡莉露",
          "text": "不论是从前还是现在，我都喜欢聆听人们梦中的话语。"
        },
        {
          "role": "卡莉露",
          "text": "或美丽、或悲伤、或充斥着我当时无法理解的感情…"
        },
        {
          "role": "卡莉露",
          "text": "有一晚，一位男孩来到了泉边，他滴下的眼泪比任何一束月光都易碎，又比任何一粒露珠都纯净…"
        },
        {
          "role": "卡莉露",
          "text": "我喜欢人类，更想要了解人类，想了解这泪珠中我所不知的情感为何物…"
        },
        {
          "role": "旅行者",
          "text": "你们成为了朋友。"
        },
        {
          "role": "卡莉露",
          "text": "没错，我们经常相约在星空下相见，互相分享自己的故事。"
        },
        {
          "role": "卡莉露",
          "text": "有时彻夜不寐，我们还比赛，谁先听到枝头的第一声鸟叫，谁先辨出夏天的第一声蝉鸣…"
        },
        {
          "role": "派蒙",
          "text": "听起来真不错呢。"
        },
        {
          "role": "卡莉露",
          "text": "但…后来就如书中所写，我在芬奇眼中看到了我还无法回应的情感…"
        },
        {
          "role": "卡莉露",
          "text": "我深知纯水精灵的命运与人类不同，也不愿因自己的迟拙，让芬奇写下来日会后悔的篇章…"
        },
        {
          "role": "卡莉露",
          "text": "所以，我逃走了，再也没在他面前出现过…"
        },
        {
          "role": "迪奥娜",
          "text": "卡莉露…"
        },
        {
          "role": "卡莉露",
          "text": "我的力量恢复得很慢，就算几十年过去…实体也只够维持有限的时间…"
        },
        {
          "role": "卡莉露",
          "text": "我原本希望芬奇能够迈开脚步前行，在「夜空里所有星星熄灭的时候」与我相见。"
        },
        {
          "role": "卡莉露",
          "text": "但在看到了如此多的故事，感受了如此多的梦境之后，我渐渐理解了芬奇的心意…"
        },
        {
          "role": "卡莉露",
          "text": "这份想要回应他的心情，在我胸中不断涌动回荡，让我再也无法按捺。"
        },
        {
          "role": "卡莉露",
          "text": "但我也怕，现在去见他的话，带给他的只有失望…还有不得不离别的痛楚…"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "重云",
          "text": "（还真是个艰难的选择…）"
        },
        {
          "role": "米卡",
          "text": "……"
        },
        {
          "role": "米卡",
          "text": "请你去见他吧！"
        },
        {
          "role": "卡莉露",
          "text": "欸？"
        },
        {
          "role": "米卡",
          "text": "我认识芬奇爷爷，他是个很善良的人！在我刚学测绘遇到困难的时候，他经常鼓励我不要泄气，多尝试，多冒险！"
        },
        {
          "role": "米卡",
          "text": "他也常和我说自己以前的故事，但从没有露出过遗憾，或者悲伤后悔的表情！"
        },
        {
          "role": "米卡",
          "text": "而且，那么热爱冒险的芬奇爷爷，现在依旧每天守在水边，像是在等待什么。"
        },
        {
          "role": "米卡",
          "text": "我相信，他一定很认真看待自己对卡莉露小姐的感情！期待有一天能再见到你！"
        },
        {
          "role": "米卡",
          "text": "既然你也想见芬奇爷爷，那还有什么好犹豫的呢！"
        },
        {
          "role": "卡莉露",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "米卡…",
              "dialogues": []
            },
            {
              "text": "说得好！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "米卡",
          "text": "…欸？啊！我，我刚才，好像有些激动了…只是…觉得一定要把这些说出来…"
        },
        {
          "role": "卡莉露",
          "text": "……"
        },
        {
          "role": "卡莉露",
          "text": "我明白了，我已经决定好了。"
        },
        {
          "role": "卡莉露",
          "text": "我要回去见芬奇一面。"
        },
        {
          "role": "米卡",
          "text": "…真的吗？太好了！"
        },
        {
          "role": "卡莉露",
          "text": "不过…想请大家帮我点忙…"
        },
        {
          "role": "派蒙",
          "text": "尽管说吧！我们什么忙都帮！"
        },
        {
          "role": "卡莉露",
          "text": "能请大家随我回清泉镇，帮我把芬奇叫到身边吗？"
        },
        {
          "role": "卡莉露",
          "text": "我的实体已经无法维持太久…我担心会被其他人看到刚才的样子…"
        },
        {
          "role": "迪奥娜",
          "text": "包在我身上！我和芬奇爷爷可熟了。"
        },
        {
          "role": "卡莉露",
          "text": "另外…也请大家帮我和芬奇保守这个秘密…我不希望清泉镇的流水，因此变得嘈杂起来…"
        },
        {
          "role": "旅行者",
          "text": "请放心。"
        },
        {
          "role": "重云",
          "text": "嗯，我也会替你保守秘密的。"
        },
        {
          "role": "米卡",
          "text": "我也答应卡莉露小姐。"
        },
        {
          "role": "卡莉露",
          "text": "好…那就有劳大家了…"
        },
        {
          "role": "卡莉露",
          "text": "啊…"
        },
        {
          "role": "派蒙",
          "text": "怎么了？这就要变回大水珠了吗？"
        },
        {
          "role": "卡莉露",
          "text": "不…请原谅我有些多虑。做完决定以后，又开始担心，自己能否将内心的情感表达清楚…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我有办法…",
              "dialogues": []
            },
            {
              "text": "为他写一首诗吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡莉露",
          "text": "诗啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "传达埋藏在心里的感情…",
              "dialogues": []
            },
            {
              "text": "传达没机会说出的感情…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡莉露",
          "text": "……"
        },
        {
          "role": "卡莉露",
          "text": "好，那就为芬奇写一首诗。"
        },
        {
          "role": "卡莉露",
          "text": "主题就叫…「清泉之心」吧。"
        },
        {
          "type": "subtitle",
          "text": "前往清泉镇"
        },
        {
          "role": "卡莉露",
          "text": "……！"
        },
        {
          "role": "米卡",
          "text": "…没事吧？"
        },
        {
          "role": "卡莉露",
          "text": "…没什么…只是我恐怕…难以维持现在的形态了。"
        },
        {
          "role": "迪奥娜",
          "text": "那…那卡莉露在这里等一下，我这就叫芬奇爷爷过来！"
        },
        {
          "role": "卡莉露",
          "text": "…慢点，迪奥娜…芬奇老了，走路不能急…"
        },
        {
          "role": "卡莉露",
          "text": "我还能…再撑一会儿…"
        },
        {
          "role": "迪奥娜",
          "text": "好，撑住撑住。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（米卡&卡莉露）"
        },
        {
          "role": "米卡",
          "text": "…还行吗？要不要我扶着卡莉露小姐？"
        },
        {
          "role": "派蒙",
          "text": "我也可以让你靠一下…"
        },
        {
          "role": "卡莉露",
          "text": "…谢谢各位。"
        },
        {
          "type": "subtitle",
          "text": "与老芬奇对话"
        },
        {
          "role": "迪奥娜",
          "text": "芬奇爷爷！"
        },
        {
          "role": "老芬奇",
          "text": "哟，这不是迪奥娜吗？今天回来得可真早。"
        },
        {
          "role": "迪奥娜",
          "text": "今天情况特殊。芬奇爷爷，能跟我来一下吗？"
        },
        {
          "role": "老芬奇",
          "text": "哦？这是要去哪呀？"
        },
        {
          "role": "迪奥娜",
          "text": "就后面的小瀑布那里。"
        },
        {
          "role": "老芬奇",
          "text": "哈哈，迪奥娜是猎到了什么好东西吗？"
        },
        {
          "role": "迪奥娜",
          "text": "哎呀！跟我来就行，是有特别特别重要的事情！"
        },
        {
          "role": "老芬奇",
          "text": "可是，待会儿你爸爸还约了我去…"
        },
        {
          "role": "迪奥娜",
          "text": "芬奇爷爷！"
        },
        {
          "role": "老芬奇",
          "text": "啊，好好好，别着急，我跟你走就是了…"
        },
        {
          "role": "迪奥娜",
          "text": "嗯，来，我扶着您。"
        },
        {
          "role": "老芬奇",
          "text": "（哎哟哟，这杜拉夫家的闺女，急起来还真和她爸爸一个样…）"
        },
        {
          "type": "subtitle",
          "text": "与卡莉露对话"
        },
        {
          "role": "卡莉露",
          "text": "……"
        },
        {
          "role": "迪奥娜",
          "text": "这边这边，芬奇爷爷，您慢点走。"
        },
        {
          "role": "老芬奇",
          "text": "咦？这是怎么回事？怎么那么多朋友？"
        },
        {
          "role": "老芬奇",
          "text": "连米卡也在？哈哈，最近工作还顺利吗？"
        },
        {
          "role": "老芬奇",
          "text": "还有几位外国朋友？我没糊涂吧？今天不是我生日呀。"
        },
        {
          "role": "重云",
          "text": "芬奇爷爷，您好，我是重云，和大家在诗歌大会上认识的，这位是…"
        },
        {
          "role": "卡莉露",
          "text": "…芬奇。"
        },
        {
          "role": "老芬奇",
          "text": "……！这声音…卡莉露？"
        },
        {
          "role": "卡莉露",
          "text": "…没想到，你还记得？"
        },
        {
          "role": "老芬奇",
          "text": "…记得，哈哈哈，记得，怎么可能不记得？"
        },
        {
          "role": "老芬奇",
          "text": "不过，你当初可不是这个样子哟…那时的你，更像是从童话里走出来的…"
        },
        {
          "role": "老芬奇",
          "text": "哎呀，瞧我，童话里的精灵变成什么样都不奇怪吧…"
        },
        {
          "role": "卡莉露",
          "text": "哈…都过了这么久，你还是能逗我开心。"
        },
        {
          "role": "老芬奇",
          "text": "谁叫你总是在晚上出现嘛…我还真怀疑过那些是不是梦…"
        },
        {
          "role": "卡莉露",
          "text": "…让你久等了，芬奇。"
        },
        {
          "role": "老芬奇",
          "text": "…不久，不久，一晃眼的事而已。"
        },
        {
          "role": "卡莉露",
          "text": "…芬奇，你愿意听我给你写的诗吗？"
        },
        {
          "role": "老芬奇",
          "text": "诗？你还写诗啦？听，当然听…你的每句话我都听…"
        },
        {
          "role": "卡莉露",
          "text": "…那么，就让我给你念一段泉水精灵的故事吧——"
        },
        {
          "type": "subtitle",
          "text": "过场动画（[https://www.bilibili.com/video/BV1Eu4y1p7EU?p=1 清泉之心]）"
        },
        {
          "role": "卡莉露",
          "text": "我来自遥远的地方"
        },
        {
          "role": "卡莉露",
          "text": "山河是我眠床"
        },
        {
          "role": "卡莉露",
          "text": "四季予我衣裳"
        },
        {
          "role": "卡莉露",
          "text": "我寻找栖身的花圃"
        },
        {
          "role": "卡莉露",
          "text": "随着银砂般的月光一齐飘荡"
        },
        {
          "role": "卡莉露",
          "text": "流风与清泉邀我停驻"
        },
        {
          "role": "卡莉露",
          "text": "「安睡吧，安睡吧，旅途令你疲惫。」"
        },
        {
          "role": "卡莉露",
          "text": "「回荡吧，回荡吧，落花为你点缀。」"
        },
        {
          "role": "卡莉露",
          "text": "我晨间弹奏幽涧的石琴"
        },
        {
          "role": "卡莉露",
          "text": "夜晚倾听梦想的歌吹"
        },
        {
          "role": "卡莉露",
          "text": "一位男孩的泪珠泛起波澜"
        },
        {
          "role": "卡莉露",
          "text": "比星空下任何歌声都要浪漫"
        },
        {
          "role": "卡莉露",
          "text": "他将过往与将来织成多彩的花冠"
        },
        {
          "role": "卡莉露",
          "text": "我则消融梦境的边界"
        },
        {
          "role": "卡莉露",
          "text": "作为报偿"
        },
        {
          "role": "卡莉露",
          "text": "「看哪，看哪，他的爱慕溢于眼眉。」"
        },
        {
          "role": "卡莉露",
          "text": "「答应吧，快答应吧，趁着美梦未褪。」"
        },
        {
          "role": "卡莉露",
          "text": "猫儿与流萤催我应允"
        },
        {
          "role": "卡莉露",
          "text": "可我不懂人间的曲调"
        },
        {
          "role": "卡莉露",
          "text": "又怎能与它合鸣？"
        },
        {
          "role": "卡莉露",
          "text": "溪流与梦想汇入沧洋"
        },
        {
          "role": "卡莉露",
          "text": "晶蝶点水的须臾"
        },
        {
          "role": "卡莉露",
          "text": "星河下的少年白发成长"
        },
        {
          "role": "卡莉露",
          "text": "我蹒跚学习人类的一切"
        },
        {
          "role": "卡莉露",
          "text": "将易碎的云朵拼成柔软的诗行"
        },
        {
          "role": "卡莉露",
          "text": "正如种子向往土壤，林木追逐太阳"
        },
        {
          "role": "卡莉露",
          "text": "曾经懵懂的曲调在心中奏响"
        },
        {
          "role": "卡莉露",
          "text": "侧耳听去"
        },
        {
          "role": "卡莉露",
          "text": "原来它声声都唱着你的名字"
        },
        {
          "role": "卡莉露",
          "text": "现在，我将我的梦送给你"
        },
        {
          "role": "卡莉露",
          "text": "愿你的夜晚似清泉般甘甜"
        },
        {
          "role": "卡莉露",
          "text": "现在，我将我的心送给你"
        },
        {
          "role": "卡莉露",
          "text": "愿你接受这份"
        },
        {
          "role": "卡莉露",
          "text": "迟来的诺言"
        },
        {
          "role": "老芬奇",
          "text": "……"
        },
        {
          "role": "老芬奇",
          "text": "对…这才是我第一次见到你时的样子嘛…"
        },
        {
          "role": "老芬奇",
          "text": "好久…真的过去好久了…"
        },
        {
          "role": "卡莉露",
          "text": "…芬奇，我…"
        },
        {
          "role": "老芬奇",
          "text": "好啦，都明白，从你的诗里，我全都明白了…"
        },
        {
          "role": "卡莉露",
          "text": "…谢谢你，芬奇，请你收下这个吧。"
        },
        {
          "role": "老芬奇",
          "text": "好漂亮啊…"
        },
        {
          "role": "卡莉露",
          "text": "是我的力量凝成的一粒水滴。"
        },
        {
          "role": "卡莉露",
          "text": "…芬奇，我无法拥有人类的实体，无法陪伴在你身边，下次幻化出人类的形体，不知要等多久…"
        },
        {
          "role": "卡莉露",
          "text": "但只要你将这粒水珠带在身边，那么我们的心，不论相隔多远，都彼此相连。"
        },
        {
          "role": "卡莉露",
          "text": "我永远与清泉同在，今后，你若呼唤我，我便会在梦里与你相见。"
        },
        {
          "role": "旅行者",
          "text": "（就像一颗真正的「清泉之心」…）"
        },
        {
          "role": "派蒙",
          "text": "这也太浪漫了吧！"
        },
        {
          "role": "旅行者",
          "text": "嘘…！"
        },
        {
          "role": "老芬奇",
          "text": "哈哈哈，你还真是学会了好多东西呢，也不怕孩子们在一旁看着…"
        },
        {
          "role": "卡莉露",
          "text": "…你不喜欢吗？"
        },
        {
          "role": "老芬奇",
          "text": "怎么可能不喜欢？没有比这更幸福的事了…"
        },
        {
          "role": "老芬奇",
          "text": "我都害怕，自己睡下去就再也不想醒过来…"
        },
        {
          "role": "卡莉露",
          "text": "欸？这…这可不行…"
        },
        {
          "role": "老芬奇",
          "text": "哈哈哈，刚才那句是玩笑，你啊，还有好多东西要学呢。"
        },
        {
          "role": "卡莉露",
          "text": "这样吗…"
        },
        {
          "role": "迪奥娜",
          "text": "（嘿嘿，芬奇爷爷和卡莉露看起来都很开心，真好啊…）"
        },
        {
          "role": "卡莉露",
          "text": "迪奥娜，谢谢你把芬奇带过来，我也不曾忘记你这位朋友。"
        },
        {
          "role": "迪奥娜",
          "text": "我当时找你聊天的时候，没有吵到你吧？"
        },
        {
          "role": "卡莉露",
          "text": "当然没有，你是这片星空下我少有的朋友。"
        },
        {
          "role": "卡莉露",
          "text": "我给予你的赠礼，同样会陪伴着你长大。"
        },
        {
          "role": "迪奥娜",
          "text": "…嗯？"
        },
        {
          "role": "重云",
          "text": "（难道说，迪奥娜调出美味饮料的体质，是这位精灵祝福的结果吗？）"
        },
        {
          "role": "重云",
          "text": "（我的纯阳之体…是否也是某人的「礼物」呢？）"
        },
        {
          "role": "卡莉露",
          "text": "……"
        },
        {
          "role": "卡莉露",
          "text": "…这具形体，快要消散了。"
        },
        {
          "role": "卡莉露",
          "text": "芬奇…"
        },
        {
          "role": "老芬奇",
          "text": "嗯？"
        },
        {
          "role": "卡莉露",
          "text": "…我从没有后悔过遇见你，也从没后悔过那天夜里同你搭话。在这漫长的时光中，哪怕一刻也没有。"
        },
        {
          "role": "老芬奇",
          "text": "…我又何尝不是呢？"
        },
        {
          "role": "卡莉露",
          "text": "和人们传下的故事不同…那晚，我没有给予你那个吻…"
        },
        {
          "role": "卡莉露",
          "text": "这代表誓约与爱的礼物，就现在赠予你吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…派蒙！闭眼！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "啊？"
                }
              ]
            },
            {
              "text": "…迪奥娜！闭眼！",
              "dialogues": [
                {
                  "role": "迪奥娜",
                  "text": "欸？"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "礼貌地闭上了眼…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "老芬奇",
          "text": "好啦，好啦…"
        },
        {
          "role": "老芬奇",
          "text": "她已经走了…"
        },
        {
          "role": "派蒙",
          "text": "欸？卡莉露…还没来得及道别。"
        },
        {
          "role": "迪奥娜",
          "text": "芬奇爷爷…"
        },
        {
          "role": "老芬奇",
          "text": "放心吧，她一点都没走远…"
        },
        {
          "role": "老芬奇",
          "text": "就像她说的，她与清泉同在…就在我们周围，就在我们梦中…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（老芬奇）"
        },
        {
          "role": "老芬奇",
          "text": "孩子啊，让我再待一会儿吧…"
        },
        {
          "type": "subtitle",
          "text": "返回活动会场"
        },
        {
          "role": "温迪",
          "text": "哦？你们回来啦！看上去状态比之前更好呢。"
        },
        {
          "role": "温迪",
          "text": "胡堂主快人一步，这会儿已经在谈出诗集的事了。"
        },
        {
          "role": "温迪",
          "text": "就等着今天「自由撰诗」的稿件到手，用她的话说这叫「一条龙」服务。"
        },
        {
          "role": "行秋",
          "text": "你们去哪儿了？可让我好等！"
        },
        {
          "role": "温迪",
          "text": "一定是灵感不足，紧急采风去了吧？说不定还恰好在途中听到了不错的诗歌？"
        },
        {
          "role": "派蒙",
          "text": "卖唱的！难道你一开始就…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙…！",
              "dialogues": []
            },
            {
              "text": "咳咳，约定…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔！对…你，你一开始就想请我们吃顿好吃的！"
        },
        {
          "role": "温迪",
          "text": "咦？有那样的事吗？"
        },
        {
          "role": "旅行者",
          "text": "我觉得这事值一顿。"
        },
        {
          "role": "温迪",
          "text": "哈哈，好吧，既然旅行者都这么说了，看来这次请客我逃不掉喽。"
        },
        {
          "role": "温迪",
          "text": "那就麻烦迪奥娜为我们调两杯好喝的喽？"
        },
        {
          "role": "迪奥娜",
          "text": "哼！想得美。放平时我才不会答应呢，但看在我今天心情好的份上…"
        },
        {
          "role": "行秋",
          "text": "咦？所以你们到底干嘛去了？这种心照不宣的氛围是怎么回事？"
        },
        {
          "role": "重云",
          "text": "错觉错觉，一定是你的错觉啦。"
        },
        {
          "role": "米卡",
          "text": "没…没错，我们只是…去远一些的地方采风了。"
        },
        {
          "role": "行秋",
          "text": "哦？连米卡都这么说…"
        },
        {
          "role": "行秋",
          "text": "重云，要不你偷偷告诉我发生了什么，我想起了一个你一定感兴趣的凶宅情报！"
        },
        {
          "role": "行秋",
          "text": "我敢说，这次恐怕连你的「纯阳之体」都起不了作用！"
        },
        {
          "role": "重云",
          "text": "多谢你的好心，但这次就不必了。"
        },
        {
          "role": "重云",
          "text": "我开始觉得…有这「纯阳之体」，或许也不是什么坏事…"
        },
        {
          "role": "行秋",
          "text": "咦？怎…怎么回事？"
        },
        {
          "role": "行秋",
          "text": "这当中果然还是发生了什么吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（聆听泉水歌声）"
        },
        {
          "type": "subtitle",
          "text": "清泉镇右下角锚点旁可以聆听歌声",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "歌声旋律是清泉镇夜晚BGM",
          "narration": true
        },
        {
          "role": "（聆听…）",
          "text": "（愉快的歌声…）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（胡桃&纪芳）"
        },
        {
          "type": "subtitle",
          "text": "胡桃和纪芳在璃月港玩具摊摊主阿山婆对面",
          "narration": true
        },
        {
          "role": "纪芳",
          "text": "…你不是要出书吗？"
        },
        {
          "role": "胡桃",
          "text": "对呀。"
        },
        {
          "role": "纪芳",
          "text": "…书呢？"
        },
        {
          "role": "胡桃",
          "text": "等诗来就有了。"
        },
        {
          "role": "纪芳",
          "text": "…诗呢？"
        },
        {
          "role": "胡桃",
          "text": "诗在路上了。"
        },
        {
          "role": "纪芳",
          "text": "…不是，胡堂主，你这诗还没来，我怎么跟你聊生意？"
        },
        {
          "role": "胡桃",
          "text": "我这不是先来和老板你谈谈妥嘛。"
        },
        {
          "role": "纪芳",
          "text": "我总要看看内容再决定卖不卖，怎么卖吧？"
        },
        {
          "role": "胡桃",
          "text": "哎呀呀，光是堂主我刚才给你看的几句，就足以撑起这本书的销量了吧！"
        },
        {
          "role": "纪芳",
          "text": "…就凭「林猪二十斤」？"
        },
        {
          "role": "胡桃",
          "text": "还有「地下开饭」那个呀！见多识广的钟离客卿可都说是好诗对！这不做个什么宣传宣传？"
        },
        {
          "role": "纪芳",
          "text": "…堂主，我们这都是小本生意。要是成本进去了但没人买，亏的是我的钱。"
        },
        {
          "role": "胡桃",
          "text": "放心放心，我和你担保，这诗集印出来，绝对惊天地泣鬼神！"
        },
        {
          "role": "胡桃",
          "text": "这不，我来的路上就听见了些鬼魂的哭声呢！你不信的话，我叫来给你听听？"
        },
        {
          "role": "纪芳",
          "text": "…这就免了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（魈）"
        },
        {
          "type": "subtitle",
          "text": "魈在铜雀庙旁锚点的旁边",
          "narration": true
        },
        {
          "role": "魈",
          "text": "…是你。"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "魈",
          "text": "依你所言，试着作了首诗…"
        },
        {
          "role": "魈",
          "text": "把心绪落于纸上，胸中倒是平静不少…"
        },
        {
          "role": "魈",
          "text": "他们…真的能听见吗…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（不知何人放于此处的诗）"
        },
        {
          "type": "subtitle",
          "text": "在铜雀庙内可以找到一首诗",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "千年浮沉定，生涯不老身。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "未灭胸中火，万般难舍恩。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "见山怀其高，见水念其幽。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "重会南柯下，幸知已还真。",
          "narration": true
        }
      ],
