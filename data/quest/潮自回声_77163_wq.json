{
  "quest_id": 77163,
  "chapter_num": null,
  "chapter_title": "潮自回声",
  "type": "wq",
  "route": "The Tides Echo Themselves",
  "stories": [
    {
      "story_id": 77163,
      "title": "潮自回声",
      "description": "汐歌洞窟里，似乎多了一些奇异的东西…",
      "dialogues": [
        {
          "type":"subtitle",
          "text": "与沃雅妮莎对话"
        },
        
        {
          "role": "沃雅妮莎",
          "text": "♪~"
        },
        {
          "role": "沃雅妮莎",
          "text": "嗯，这些冰柱果然已经很好用了。接下来要练什么呢…"
        },
        {
          "role": "沃雅妮莎",
          "text": "旅行者，刚好你来了，来来，你也试试这冰柱。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "怎、怎么用？",
            "我也要唱吗？"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "不用啊，喏，拿着这个，它能让这些冰柱响起来。"
        },
        {
          "role": "沃雅妮莎",
          "text": "快去吧，让我听听你能演奏出什么曲子。"
        },
        {
          "role": "沃雅妮莎",
          "text": "怎么样，我的这间私人练歌房确实不错吧？你刚才的曲子也很有新意。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "还是差了一点意思。",
            "没有能把这些冰柱震碎…"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "噗…如果这是你的追求，那你之后可要多多练习。"
        },
        {
          "role": "沃雅妮莎",
          "text": "——必要的话，我也可以提供指导，当然，也不能白指导。"
        },
        {
          "role": "旅行者",
          "text": "你要的报酬是…"
        },
        {
          "role": "沃雅妮莎",
          "text": "现在没想好，等我想出好玩的报酬之后再告诉你，在那之前，先欠着吧。"
        },
        {
          "role": "沃雅妮莎",
          "text": "嘻嘻，就这么说定了，之后有空的话，可要多多过来练习啊。"
        }
      ]
    }
  ]
}