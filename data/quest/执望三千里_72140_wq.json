{
  "quest_id": 72140,
  "chapter_num": null,
  "chapter_title": "执望三千里",
  "type": "wq",
  "route": "Gazing Three Thousand Miles Away",
  "stories": [
    {
      "story_id": 72140,
      "title": "执望三千里",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆与长次对话"
        },
        {
          "role": "长次",
          "text": "外国来的人们，请来看看吧，八酝岛最好的蛇骨晶矿！"
        },
        {
          "role": "长次",
          "text": "请您过过眼吧，这种品质的晶石以往是直供幕府的，现在折价卖给你们这样的冒险家，一定能为您炼出削铁如泥的利器！"
        },
        {
          "role": "旅行者",
          "text": "请问价钱多少？"
        },
        {
          "role": "长次",
          "text": "唔…让我算算，五枚晶石是三十万摩拉，十五枚晶石九十万摩拉，一批一次三十枚晶石…一百八十万摩拉，谢谢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好贵！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你不如直接去拦路抢劫好啦！"
                }
              ]
            },
            {
              "text": "你看这个小精灵值这么多吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你是什么意思啦！"
                }
              ]
            }
          ]
        },
        {
          "role": "长次",
          "text": "哈哈，我懂的。对你们外国人来说，远在异乡摩拉比什么都重要。难免多有算计，不舍花费。"
        },
        {
          "role": "长次",
          "text": "毕竟矿坑已经停产了嘛，因为打仗，还有…大人们经常说的什么「祟神」在岛上作乱…"
        },
        {
          "role": "长次",
          "text": "我家的矿石也是卖一枚少一枚的，所以价格难免会稍微偏高一些。"
        },
        {
          "role": "长次",
          "text": "再说，这也算「风险溢价」吧～"
        },
        {
          "role": "派蒙",
          "text": "「风险溢价」？是什么意思呀…"
        },
        {
          "role": "旅行者",
          "text": "「风险溢价」是什么意思呀…"
        },
        {
          "role": "长次",
          "text": "唔…就是，我身为小孩子，却像大人一样赚钱。还要承担被天领奉行发现的风险，这就是「风险溢价」！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来如此。",
              "dialogues": []
            },
            {
              "text": "可还是觉得哪里怪怪的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "不想买也没关系的，我一直在这附近，等你们什么时候改变主意了，可以随时来找我。"
        },
        {
          "role": "派蒙",
          "text": "这孩子怎么说话怪里怪气的…"
        },
        {
          "role": "旅行者",
          "text": "你的父母呢？"
        },
        {
          "role": "长次",
          "text": "谢谢关心，他们过得很好！"
        },
        {
          "role": "长次",
          "text": "我的父母都是矿工，这些矿石就是他们开采的！以往工头叔叔会把大家采到的矿石收集起来上交城里的大人，登记封箱后运去踏鞴砂。"
        },
        {
          "role": "长次",
          "text": "不过既然现在打仗了，城里的大人也不会来了…"
        },
        {
          "role": "长次",
          "text": "我们就自己卖矿石，自己的摩拉自己赚！"
        },
        {
          "role": "长次",
          "text": "您看，成色这么好的晶石以前只能卖给幕府，现在冒险家和旅行者也可以买到了，价格公道，品质无瑕！"
        },
        {
          "role": "长次",
          "text": "而且我现在也能像大人一样赚钱了，所以打仗也不算是坏事，您说对吧？"
        },
        {
          "role": "派蒙",
          "text": "哇…真不知道这孩子是天生就这么乐观，还是话里有话…"
        },
        {
          "role": "长次",
          "text": "唔…对了。请问可以拜托您帮个忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么人人都找我帮忙？",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "嘿嘿，因为你们一看就是好人嘛！是小孩可以信任的那种！"
                },
                {
                  "role": "长次",
                  "text": "再说了，我听说璃月有句话，「买卖不成仁义在」。我们稻妻的武士也最讲究仁义了！"
                },
                {
                  "role": "派蒙",
                  "text": "哇啊，这孩子，怎么还引经据典的…"
                }
              ]
            },
            {
              "text": "请说吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "是这样的，因为最近的那些事情，矿井已经封闭了。"
        },
        {
          "role": "长次",
          "text": "而且那些晶石太坚硬太重了…我一个人实在采不过来。"
        },
        {
          "role": "派蒙",
          "text": "呀，是谁刚才还说自己能像大人一样赚钱啦？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "像大人一样支使别人为自己赚钱吧。",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "嘿嘿，说的也对。"
                },
                {
                  "role": "派蒙",
                  "text": "好气啊，居然还大大方方地承认了！"
                }
              ]
            },
            {
              "text": "所以你要拜托我们采矿？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "没错，十二枚，谢谢！"
        },
        {
          "role": "派蒙",
          "text": "谁会帮你呀，满嘴跑舌头的油滑小孩！"
        },
        {
          "role": "长次",
          "text": "别生气嘛，我是不会让你们白跑一趟的。回报很丰厚哦！"
        },
        {
          "role": "长次",
          "text": "等矿石卖掉，我们五五分账！"
        },
        {
          "role": "派蒙",
          "text": "完全卖不出去吧！"
        },
        {
          "role": "长次",
          "text": "唔，你们要是等不及的话…就这样吧。我把你们采到的矿石五折卖给你们，收益我们五五分账！"
        },
        {
          "role": "长次",
          "text": "算下来我亏了好多呢！哼哼，没见过这么划算的生意吧？"
        },
        {
          "role": "派蒙",
          "text": "倒是没见过这么不要脸的生意人…"
        },
        {
          "role": "长次",
          "text": "唔，这样吗…那我就只能亮出「那个」了…"
        },
        {
          "role": "派蒙",
          "text": "「那个」…？什么啊…"
        },
        {
          "role": "长次",
          "text": "是财宝！满满的一箱财宝哦！"
        },
        {
          "role": "派蒙",
          "text": "哇！是财宝！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别被他带跑了。",
              "dialogues": []
            },
            {
              "text": "又在说大话了吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…对哦…旅行者你说得对！"
        },
        {
          "role": "派蒙",
          "text": "哼…你先拿出来我才会信。"
        },
        {
          "role": "长次",
          "text": "拿不出来。"
        },
        {
          "role": "派蒙",
          "text": "那你还卖关子！"
        },
        {
          "role": "长次",
          "text": "不要着急，我是说，财物实在太多、太沉了，单靠我一个人是拿不出来的啦…"
        },
        {
          "role": "长次",
          "text": "不过，我可以告诉你们藏宝地点在哪里。绝对可信。"
        },
        {
          "role": "长次",
          "text": "怎么样，有兴趣吗？"
        },
        {
          "role": "派蒙",
          "text": "虽然这孩子怎么看都不靠谱的样子…但既然有财宝可拿…"
        },
        {
          "role": "派蒙",
          "text": "就这么放弃也太可惜了…旅行者，你说呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧。",
              "dialogues": []
            },
            {
              "text": "可不许骗我。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "放心吧，不会骗你的！"
        },
        {
          "type": "subtitle",
          "text": "◆搜集12枚晶化骨髓"
        },
        {
          "role": "长次",
          "text": "你回来啦。带回晶石了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "带回来了。",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "谢谢，这些就够了！"
                },
                {
                  "role": "派蒙",
                  "text": "该告诉我们「财宝」在哪里了吧？"
                },
                {
                  "role": "长次",
                  "text": "好的，藏宝的地方就在矿场旁边，很容易就能看到。"
                },
                {
                  "role": "派蒙",
                  "text": "谢啦！旅行者，我们快去吧！"
                }
              ]
            },
            {
              "text": "正在路上。",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "不用急，一路平安！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆取得长次所说的「财宝」"
        },
        {
          "role": "派蒙",
          "text": "那孩子说的就是这里了吧，我们快动手挖出来吧！"
        },
        {
          "role": "派蒙",
          "text": "欸——这是什么呀…只有这些吗？"
        },
        {
          "role": "派蒙",
          "text": "可恶，果然被他骗了！"
        },
        {
          "type": "subtitle",
          "text": "◆与长次对质"
        },
        {
          "role": "长次",
          "text": "你们回来了！"
        },
        {
          "role": "派蒙",
          "text": "哼，骗子！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "骗子！",
              "dialogues": []
            },
            {
              "text": "根本没有财宝吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "唔…不瞒你说，我们矿工家庭本就贫困…现在遇到这些事端，更是雪上加霜…"
        },
        {
          "role": "长次",
          "text": "我是穷人家的孩子，没见过太大数目的摩拉…"
        },
        {
          "role": "长次",
          "text": "给你们的这些，对我来说，已经是珍贵的财宝了…"
        },
        {
          "role": "派蒙",
          "text": "欸…"
        },
        {
          "role": "旅行者",
          "text": "那请问…"
        },
        {
          "role": "长次",
          "text": "请说…"
        },
        {
          "role": "旅行者",
          "text": "三十枚晶石的价格是…？"
        },
        {
          "role": "长次",
          "text": "一百八十万摩拉！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没见过太大数目的摩拉…？",
              "dialogues": []
            },
            {
              "text": "可胃口却不小…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "唔…这个…不是你说的那样…！"
        },
        {
          "role": "长次",
          "text": "我只是…我只有这些给你…"
        },
        {
          "role": "派蒙",
          "text": "唉，你呀…"
        },
        {
          "role": "旅行者",
          "text": "派蒙，你和他说吧。"
        },
        {
          "role": "派蒙",
          "text": "要我说，小孩子就要有小孩子的样子！不要总是学大人的坏榜样…"
        },
        {
          "role": "长次",
          "text": "我不是小孩子了…！"
        },
        {
          "role": "旅行者",
          "text": "所以学会了像大人一样骗人？"
        },
        {
          "role": "长次",
          "text": "可是…可是…"
        },
        {
          "role": "派蒙",
          "text": "你一定是看到大人坑蒙拐骗，就能赚到钱，就能让别人心甘情愿为自己做事，对吧？"
        },
        {
          "role": "长次",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "但那些是糟糕的大人，他们只会伤害别人来满足自己。"
        },
        {
          "role": "派蒙",
          "text": "你也不希望别人被伤害吧？"
        },
        {
          "role": "派蒙",
          "text": "虽然不知道你经历了什么…"
        },
        {
          "role": "派蒙",
          "text": "但这样很不好！没有人喜欢被戏弄、被利用的！"
        },
        {
          "role": "旅行者",
          "text": "尤其是贪财又缺根弦的人。"
        },
        {
          "role": "派蒙",
          "text": "对！尤其是——不对…旅行者你在说谁呀！"
        },
        {
          "role": "派蒙",
          "text": "哼，别打岔啦！总之，如果你真的需要帮忙的话，我们会想办法帮助你。"
        },
        {
          "role": "派蒙",
          "text": "但不应该这样欺骗别人，知道了吗？"
        },
        {
          "role": "旅行者",
          "text": "派蒙也做老师了呢。"
        },
        {
          "role": "派蒙",
          "text": "哼哼，毕竟跟你一起旅行这么久，不是毫无收获嘛。"
        },
        {
          "role": "长次",
          "text": "…嗯，我明白了。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？"
        },
        {
          "role": "长次",
          "text": "嗯，我不会再欺骗你们了…不过…"
        },
        {
          "role": "长次",
          "text": "不过，你们还会帮我吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只要你真的需要帮助。",
              "dialogues": []
            },
            {
              "text": "只要报酬公道。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "只要别再骗人！"
        },
        {
          "role": "长次",
          "text": "嗯，嗯，那我就…不再耽误时间了。"
        },
        {
          "role": "长次",
          "text": "希望下次再见，旅途平安！"
        },
        {
          "role": "派蒙",
          "text": "唉…也不知道他听进去了没有。"
        },
        {
          "type": "subtitle",
          "text": "◆休息到翌日上午11点-下午14点，与长次对话。"
        },
        {
          "role": "长次",
          "text": "你好！想不到又能见面，真开心！"
        },
        {
          "role": "长次",
          "text": "今天也来买晶石吗？"
        },
        {
          "role": "旅行者",
          "text": "叫我旅行者就好。"
        },
        {
          "role": "长次",
          "text": "好的，旅行者！"
        },
        {
          "role": "长次",
          "text": "请看看今天的晶石吧，这一批是直供踏鞴砂的晶石！"
        },
        {
          "role": "长次",
          "text": "不会让你们失望的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还是不了…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "已经被你骗过一次啦，谁还会上当呀！"
                },
                {
                  "role": "长次",
                  "text": "嘿嘿～"
                },
                {
                  "role": "派蒙",
                  "text": "哇啊，这孩子好讨厌！"
                },
                {
                  "role": "旅行者",
                  "text": "你一直一个人卖矿石吗？"
                }
              ]
            },
            {
              "text": "最近过得如何？",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "还不错，谢谢关心！"
                }
              ]
            },
            {
              "text": "岛上有点冷清…",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "以前岛上很热闹，但自从开始打仗以后，大家都陆陆续续搬走了…矿场也空荡荡的了。"
                },
                {
                  "role": "长次",
                  "text": "大家有的往北走了，有的往南走了，现在还没有回来…岛上少了好多人，冷清了好多。"
                },
                {
                  "role": "长次",
                  "text": "不过这也不一定是坏事，对吧？小孩子太多了就是麻烦，我早就不是小孩子了…大人就应该自己照顾自己，和自己玩才对。"
                },
                {
                  "role": "旅行者",
                  "text": "你一直一个人卖矿石吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "长次",
          "text": "嗯！我长大了，能赚钱了！小孩子才怕孤单，不敢一个人做事情。"
        },
        {
          "role": "派蒙",
          "text": "你之前不是说你的父母也在吗？"
        },
        {
          "role": "长次",
          "text": "嗯，他们在安全的地方…"
        },
        {
          "role": "派蒙",
          "text": "这样啊…"
        },
        {
          "role": "旅行者",
          "text": "（派蒙，不要问了。）"
        },
        {
          "role": "长次",
          "text": "那个，旅行者之前答应会帮忙了，是吧…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是啊。",
              "dialogues": []
            },
            {
              "text": "怎么了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "我想…能不能再麻烦旅行者采一些晶石出来？"
        },
        {
          "role": "旅行者",
          "text": "然后你再高价卖给别人？"
        },
        {
          "role": "长次",
          "text": "嗯…"
        },
        {
          "role": "派蒙",
          "text": "唔…完全把我们当免费矿工了呢。"
        },
        {
          "role": "长次",
          "text": "不是的，不是这这样的…我只是…"
        },
        {
          "role": "长次",
          "text": "我真的、真的很需要钱…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你需要钱做什么呢？",
              "dialogues": []
            },
            {
              "text": "我也是。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "那个…个中原因，我会和你们说的，不过…请帮完我这个忙，好吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧。",
              "dialogues": []
            },
            {
              "text": "但别忘了解释。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "嗯，谢谢你！我会在这里等着你的！"
        },
        {
          "type": "subtitle",
          "text": "◆搜集晶化骨髓12枚"
        },
        {
          "role": "长次",
          "text": "旅行者，你回来啦。带回晶石了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "带回来了。",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "谢谢！这些应该就够了。"
                },
                {
                  "role": "派蒙",
                  "text": "所以我们要的解释呢？"
                },
                {
                  "role": "长次",
                  "text": "欸，什么解释？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你需要钱做什么？",
                      "dialogues": []
                    },
                    {
                      "text": "你需要晶石做什么？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "长次",
                  "text": "我想离开这个岛。"
                },
                {
                  "role": "长次",
                  "text": "大家要么走了，要么生病了…八酝岛已经没有几个人了。"
                },
                {
                  "role": "长次",
                  "text": "…我不想天天打仗，也不想活在「祟神」的包围中…我想远离这里，离开这座岛。"
                },
                {
                  "role": "旅行者",
                  "text": "那你的父母呢？"
                },
                {
                  "role": "派蒙",
                  "text": "对呀，你不管父母了吗？"
                },
                {
                  "role": "长次",
                  "text": "我说过了…他们在安全的地方呀。"
                },
                {
                  "role": "长次",
                  "text": "嗯…旅行者，这种不开心的事情，我们还是以后再接着聊吧？"
                },
                {
                  "role": "长次",
                  "text": "哈哈，放心啦，我又不会逃跑。"
                },
                {
                  "role": "长次",
                  "text": "这样吧…旅行者有时间来我家吧，我家就在这附近。到时候我们再继续聊！"
                },
                {
                  "role": "派蒙",
                  "text": "欸！别不等别人回话就离开呀！"
                },
                {
                  "role": "派蒙",
                  "text": "这孩子真是的！"
                }
              ]
            },
            {
              "text": "正在路上。",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "不用急，多在这里歇一会也好。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆前往长次的家"
        },
        {
          "role": "长次",
          "text": "旅行者！没想到你真的来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里就是你的家吗？",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "怎么样，还不错吧？"
                }
              ]
            },
            {
              "text": "肚子有点饿了…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "咕噜咕噜…我也是呢…"
                }
              ]
            }
          ]
        },
        {
          "role": "长次",
          "text": "哎呀…真是对不起！请你们到我家来，缺忘了做饭招待…实在太疏忽了。"
        },
        {
          "role": "长次",
          "text": "唔，不过家里只剩下堇瓜了呢…"
        },
        {
          "role": "长次",
          "text": "虽然吃惯了堇瓜，那这个招待客人可不行…"
        },
        {
          "role": "长次",
          "text": "这样吧，麻烦你们再稍等一下，我再去搜集一些食材回来，然后就为你准备饭菜。"
        },
        {
          "role": "派蒙",
          "text": "我可等不及了，让我们也来帮忙吧！"
        },
        {
          "role": "长次",
          "text": "可是，这怎么好意思…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没关系的，我习惯帮忙了。",
              "dialogues": []
            },
            {
              "text": "就当做饭前运动好了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "好吧，这是我家制作渡来禽肉用的菜谱，请看一下。"
        },
        {
          "role": "长次",
          "text": "这道菜最初是幕府的外国人泽维尔教给我们的。听他说很适合矿工补充能量呢！"
        },
        {
          "role": "长次",
          "text": "家里的堇瓜足够了，所以不必交给我，也还有小麦可以磨成面粉。"
        },
        {
          "role": "长次",
          "text": "但是既然要做禽肉料理，没有禽肉是不行的，而且还需要鸟蛋作为配菜。"
        },
        {
          "role": "长次",
          "text": "虽然都不是什么罕见的食材，不过以现在八酝岛上的条件…既然旅行者有意帮忙，就请找一下这几样吧。"
        },
        {
          "role": "长次",
          "text": "要麻烦客人做这些，真是对不起…"
        },
        {
          "role": "派蒙",
          "text": "好啦，你就不要再客气啦！"
        },
        {
          "type": "subtitle",
          "text": "◆学习并制作「渡来禽肉」"
        },
        {
          "role": "长次",
          "text": "需要的食材是{{颜色|蓝|面粉}}、{{颜色|蓝|禽肉}}和{{颜色|蓝|鸟蛋}}，忘记的话请随时找我问就好！"
        },
        {
          "role": "长次",
          "text": "旅行者，你们回来了！"
        },
        {
          "role": "长次",
          "text": "好了，不耽搁了。我们一起来做渡来禽肉吧！"
        },
        {
          "role": "派蒙",
          "text": "好耶，渡来禽肉！"
        },
        {
          "role": "旅行者",
          "text": "好耶，渡来禽肉！"
        },
        {
          "role": "长次",
          "text": "好耶，渡来禽肉！"
        },
        {
          "role": "长次",
          "text": "哈哈，好啦。让我给你们介绍一下做法吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "简要讲讲就好。",
              "dialogues": []
            },
            {
              "text": "事无巨细地为我介绍吧！",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "这道菜很好做的！我们先来把堇瓜切好焯水，鸟蛋打出蛋液。"
                },
                {
                  "role": "长次",
                  "text": "如果对刀工有自信的话，堇瓜片可以切成自己喜欢的形状哦！"
                },
                {
                  "role": "长次",
                  "text": "然后，禽肉放在砧板上，从中间剖开，展开成稍厚的肉片，然后腌制一段时间…"
                },
                {
                  "role": "长次",
                  "text": "然后把禽肉片放入面粉包裹…面粉太多的话请记得稍稍拍掉。再将禽肉均匀进入蛋液。"
                },
                {
                  "role": "长次",
                  "text": "然后将油烧熟，便忘了用筷子试探，有一连串小气泡从筷子上涌出即可。"
                },
                {
                  "role": "长次",
                  "text": "然后，把裹了面粉的禽肉片放进油锅翻炸…唔，三、四分钟。再添火升温，直到表皮金黄，就可以捞出来了。"
                },
                {
                  "role": "长次",
                  "text": "油不要烧得太急，不然会炸焦，可是假如不够热的话，太多油渗入面衣，表皮会变得绵软，那样会很难吃的。"
                },
                {
                  "role": "长次",
                  "text": "然后把炸好的禽肉排取出来，放在纸上吸油，然后切分成条块。"
                },
                {
                  "role": "长次",
                  "text": "最后，用堇瓜片装饰，再配上家里的酱汁…锵锵完成！"
                }
              ]
            }
          ]
        },
        {
          "role": "长次",
          "text": "你看，就这么简单！"
        },
        {
          "role": "旅行者",
          "text": "长次很有烹饪天赋呢。"
        },
        {
          "role": "派蒙",
          "text": "之前还真是没看出来你这么擅长做菜呢，光是听你介绍，我肚子都开始咕咕叫了。"
        },
        {
          "role": "长次",
          "text": "嗯，这是妈妈交给我的食谱，是她最擅长的料理。"
        },
        {
          "role": "长次",
          "text": "嘿嘿，不如先试做一下吧？"
        },
        {
          "role": "长次",
          "text": "以往都是妈妈教我做饭，这还是我第一次教别人做饭呢。"
        },
        {
          "role": "长次",
          "text": "既然旅行者是了不起的冒险家，渡来禽肉也不过是小菜一碟吧？"
        },
        {
          "role": "派蒙",
          "text": "哇好气！他在小瞧我们！"
        },
        {
          "role": "派蒙",
          "text": "哼，我们就做给他看！"
        },
        {
          "type": "subtitle",
          "text": "◆与长次分享自己做的料理"
        },
        {
          "role": "长次",
          "text": "好耶！那就请旅行者开始吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "'''交付美味的「[[渡来禽肉]]」'''",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "唔——嗯！好吃！旅行者有成为名厨的潜质呢！"
                },
                {
                  "role": "派蒙",
                  "text": "哇…好香！旅行者，不如我们在这里合伙开家料亭好了！"
                },
                {
                  "role": "派蒙",
                  "text": "我是认真的哦！"
                }
              ]
            },
            {
              "text": "'''交付普通的「[[渡来禽肉]]」'''",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "待补",
                  "narration": true
                }
              ]
            },
            {
              "text": "'''交付奇怪的「[[渡来禽肉]]」'''",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "唔嗯…呃…哈哈，是没尝过的异国风味呢。"
                },
                {
                  "role": "派蒙",
                  "text": "哪个「异国」啊！深渊吗？ ！"
                },
                {
                  "role": "派蒙",
                  "text": "长次请不要勉强啦！你还在长大，就别吃这个了…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆解决长次的烦恼"
        },
        {
          "role": "长次",
          "text": "谢谢你们，我好久没有吃过这道料理了…以前都是妈妈给我做的，她做的很好吃，谁做的也比不上。"
        },
        {
          "role": "长次",
          "text": "唔…真想每天都不用只吃堇瓜，每天都吃禽肉料理。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我也是！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "每天都吃的话…",
              "dialogues": []
            },
            {
              "text": "会吃腻的吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "如果是妈妈做的，就不会腻。"
        },
        {
          "role": "长次",
          "text": "……"
        },
        {
          "role": "长次",
          "text": "我努力攒钱就是为了离开八酝岛，吃更多好吃的料理，也给更多人做好吃的料理！"
        },
        {
          "role": "长次",
          "text": "听说离岛那边只剩下一条往至冬国去的往返航线还没被关闭…可能我还有机会吧。"
        },
        {
          "role": "长次",
          "text": "听大人们说，只要有足够多的摩拉，就连奉行大人本人都会开眼让我们出海的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么转移话题？",
              "dialogues": []
            },
            {
              "text": "关于你的妈妈…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "……"
        },
        {
          "role": "长次",
          "text": "她离开了。"
        },
        {
          "role": "派蒙",
          "text": "哦…"
        },
        {
          "role": "旅行者",
          "text": "抱歉…"
        },
        {
          "role": "长次",
          "text": "没事的，一定也是很想知道吧。"
        },
        {
          "role": "长次",
          "text": "岛上开始下雨后第十天，妈妈就走了。"
        },
        {
          "role": "长次",
          "text": "信也好，纸条也好，也没有留下…"
        },
        {
          "role": "长次",
          "text": "不知道为什么，我很早就感觉她会离开。尤其是矿场的叔叔阿姨们给爸爸立碑的那天…"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "长次",
          "text": "那天妈妈很生气，我从来没见过她发那么大的火…妈妈相信爸爸还活着，我也相信着。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "以前这里是什么样呢…？",
              "dialogues": []
            },
            {
              "text": "幕府没有干涉这里吗…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "城里的大人每隔一阵子会来收购矿石，对我们指手画脚的。"
        },
        {
          "role": "长次",
          "text": "但我们自己的事情都是我们自己开会解决。城里人有城里人的规矩，大御所大人也给我们安排了自己的规矩…"
        },
        {
          "role": "长次",
          "text": "如果不是打仗的话，我再过两年也要参会「旁听」了，但我不太懂那些。"
        },
        {
          "role": "长次",
          "text": "他们说这是什么「义务」…不过我才不喜欢和一群大人挤在一起，太无聊了。"
        },
        {
          "role": "长次",
          "text": "……"
        },
        {
          "role": "长次",
          "text": "可是现在大家都不在了。"
        },
        {
          "role": "派蒙",
          "text": "…所以你想要离开？"
        },
        {
          "role": "长次",
          "text": "妈妈应该是去找爸爸了吧…我也要去找她。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可是从哪里开始呢？",
              "dialogues": []
            },
            {
              "text": "说不定她还没离开这个岛…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "我会先在八酝岛寻找的。可能会去问问那个叫保本的医生叔叔…可是他好像讨厌我，每次远远啊看到就躲着我…"
        },
        {
          "role": "长次",
          "text": "然后，我可能会去找爸爸的工友…之前听说梶先生还在岛上，他或许知道关于妈妈的事。"
        },
        {
          "role": "旅行者",
          "text": "可是有很多海贼出没。"
        },
        {
          "role": "长次",
          "text": "嗯…海贼叔叔那边也可以求助…虽然他们和幕府的大人们合不来，但对我们也还算亲切。"
        },
        {
          "role": "长次",
          "text": "他们说不定会同意带我一起出海。"
        },
        {
          "role": "长次",
          "text": "再然后…唔，那个人不行，他很可怕。"
        },
        {
          "role": "旅行者",
          "text": "谁？"
        },
        {
          "role": "长次",
          "text": "绯木村的村长鹫津…他以前是个很好的人，但现在…很奇怪。"
        },
        {
          "role": "长次",
          "text": "他很可怕，总是远远地盯着我家自言自语。我总觉得他会对我…或者对妈妈做坏事。"
        },
        {
          "role": "长次",
          "text": "希望妈妈没有遇见过他。"
        },
        {
          "role": "长次",
          "text": "啊，说起鹫津…我可不可以再拜托旅行者一件事？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请说无妨。",
              "dialogues": []
            },
            {
              "text": "与那位鹫津有关？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "嗯，鹫津以前在岛上搭了一些神龛，原本是为了用供奉来安抚大蛇的灵魂…"
        },
        {
          "role": "长次",
          "text": "毕竟我们总要直接接触蛇骨晶矿，时间长了难免会生病嘛。"
        },
        {
          "role": "长次",
          "text": "但是自从矿场关闭之后，鹫津也越来越不对劲，越来越可怕了…他供奉神龛的方式也越来越…疯狂。"
        },
        {
          "role": "长次",
          "text": "再后来，这样评论鹫津的大人也一个一个消失了…"
        },
        {
          "role": "长次",
          "text": "话说回来，妈妈以前经常去附近的神龛为爸爸和我祈祷，在哪里献上绯樱绣球的花瓣。"
        },
        {
          "role": "长次",
          "text": "我想去那边看看她是否有留下什么信息…可是又害怕会遇到鹫津，我不能靠近那边。"
        },
        {
          "role": "长次",
          "text": "所以…所以…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请你放心吧。",
              "dialogues": []
            },
            {
              "text": "我会帮你去看看的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "那就太感谢旅行者了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "长次",
          "text": "你回来了，旅行者！"
        },
        {
          "role": "长次",
          "text": "不来吃点东西，或者喝点水吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢，不了。",
              "dialogues": []
            },
            {
              "text": "先等我完成委托。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "辛苦你了！"
        },
        {
          "type": "subtitle",
          "text": "◆调查神龛"
        },
        {
          "role": "派蒙",
          "text": "这就是长次所说的神龛了吧？"
        },
        {
          "role": "神龛",
          "text": "（看起来很普通的神龛，并没有任何奇特的元素痕迹。）"
        },
        {
          "role": "神龛",
          "text": "（这座神龛朴素却优雅，木造的龛体微微闪烁着流光，以端庄的沉默迎接来客的供奉。）"
        },
        {
          "role": "神龛",
          "text": "（神龛旁边散落着许多神樱花瓣，看起来不像是自然所成，却像是有人特意在这里撒下了绯樱绣球。）"
        },
        {
          "role": "派蒙",
          "text": "唔…这里也没有痕迹呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看，绯樱绣球…",
              "dialogues": []
            },
            {
              "text": "是长次妈妈的供品…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦，长次提到他妈妈会在神龛供奉这个的！"
        },
        {
          "role": "派蒙",
          "text": "这么多花瓣出现在这里…应该不会是偶然。"
        },
        {
          "role": "派蒙",
          "text": "我们快回去告诉他吧！"
        },
        {
          "type": "subtitle",
          "text": "◆和长次对话"
        },
        {
          "role": "长次",
          "text": "旅行者，你们回来啦！"
        },
        {
          "role": "旅行者",
          "text": "我们调查了神龛。"
        },
        {
          "role": "派蒙",
          "text": "可惜你的妈妈并没有在那里留下什么信息…"
        },
        {
          "role": "长次",
          "text": "这样啊…"
        },
        {
          "role": "派蒙",
          "text": "但有人在那里留下了很多绯樱绣球的花瓣。"
        },
        {
          "role": "旅行者",
          "text": "是她供奉的花。"
        },
        {
          "role": "长次",
          "text": "欸…？"
        },
        {
          "role": "派蒙",
          "text": "唔，对不起，长次，我们也没能找到更多信息…"
        },
        {
          "role": "长次",
          "text": "没事的，我明白了。"
        },
        {
          "role": "长次",
          "text": "这些天辛苦旅行者了。"
        },
        {
          "role": "长次",
          "text": "接下来…我需要自己想想怎么办才好。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不去找奉行方吗？",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "唔…谢谢，不了。我们不信任城里的人。"
                }
              ]
            },
            {
              "text": "我可以帮忙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "谢谢，但我不想在麻烦你了。"
        },
        {
          "role": "长次",
          "text": "而且…这件事上，我不想被别人照顾。"
        },
        {
          "role": "派蒙",
          "text": "现在的孩子也太早熟了吧…"
        },
        {
          "role": "长次",
          "text": "这不是早熟啦…就是…我没有了最可以依靠的人，也不想依靠别人。仅此而已。"
        },
        {
          "role": "长次",
          "text": "旅行者，如果你也有亲人要追寻，应该能理解我吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "孤独在所难免。",
              "dialogues": []
            },
            {
              "text": "要珍惜值得依靠的伙伴。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "嗯…说的很有道理，我会牢记的。"
        },
        {
          "role": "长次",
          "text": "好啦，就不耽误你们时间啦。祝你们旅途平安。"
        },
        {
          "role": "长次",
          "text": "很快我也要踏上自己的旅途了吧…"
        },
        {
          "role": "派蒙",
          "text": "那也祝你平安！"
        },
        {
          "type": "subtitle",
          "text": "后续隐藏剧情，无任务"
        },
        {
          "type": "subtitle",
          "text": "◆和长次对话"
        },
        {
          "role": "长次",
          "text": "你好，旅行者！最近过得如何？"
        },
        {
          "role": "派蒙",
          "text": "挺好的，你呢？"
        },
        {
          "role": "旅行者",
          "text": "我的话被派蒙抢掉啦！"
        },
        {
          "role": "派蒙",
          "text": "哈哈，只怪你自己反应慢！"
        },
        {
          "role": "旅行者",
          "text": "我看派蒙是想加餐了吧？"
        },
        {
          "role": "派蒙",
          "text": "当然啦，我天天都想！"
        },
        {
          "role": "旅行者",
          "text": "我的意思是，你就是「加餐」。"
        },
        {
          "role": "派蒙",
          "text": "喂——！"
        },
        {
          "role": "长次",
          "text": "噗…哈哈哈哈哈！"
        },
        {
          "role": "长次",
          "text": "好啦好啦，你们别吵啦。"
        },
        {
          "role": "长次",
          "text": "我这边也还不错，不过还有件事想要拜托一下。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说吧，什么事？",
              "dialogues": []
            },
            {
              "text": "我尽力而为。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "嗯，也没有别的要求啦，只是需要旅行者再帮我开采一些晶石。"
        },
        {
          "role": "长次",
          "text": "请相信我，我一定会好好报答你的…只要你相信我。"
        },
        {
          "role": "旅行者",
          "text": "我相信你，可是…"
        },
        {
          "role": "长次",
          "text": "可是…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么？",
              "dialogues": []
            },
            {
              "text": "你答应过给我一个解释。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对呀，我们还不知道你为什么这么需要晶化骨髓呢！"
        },
        {
          "role": "长次",
          "text": "嗯…我需要钱旅行才能找到妈妈，所以要用矿石来换钱。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可是幕府垄断了晶矿市场。",
              "dialogues": []
            },
            {
              "text": "你知道晶矿不好卖吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "我知道，我会自己找门路的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你在做危险的事情。",
              "dialogues": []
            },
            {
              "text": "我在担心你的安危。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "长次，我们已经是朋友了，对吧？"
        },
        {
          "role": "派蒙",
          "text": "说不定这次，我门还能再帮到你呢？"
        },
        {
          "role": "派蒙",
          "text": "而且，你答应要报答我们了。那么可能危及你自己，导致我们拿不到回报得事情，我们也是有权了解的，对吧？"
        },
        {
          "role": "旅行者",
          "text": "这是什么市侩哲学…"
        },
        {
          "role": "长次",
          "text": "噗…派蒙说的没错啦。"
        },
        {
          "role": "长次",
          "text": "我收集晶矿也不完全是为了赚钱。"
        },
        {
          "role": "长次",
          "text": "我一直在想…假如爸爸妈妈也像大家一样，得了「祟神」带来的病…"
        },
        {
          "role": "长次",
          "text": "或许这些晶石能用来制药也不一定。因为它们也是大蛇的骨骸上生出来的嘛…"
        },
        {
          "role": "长次",
          "text": "而且保本先生也提到过，这些晶石可能有用。"
        },
        {
          "role": "派蒙",
          "text": "可是…这也不是百分百准确的假说吧？"
        },
        {
          "role": "长次",
          "text": "嗯，但我们也没有别的假说了。"
        },
        {
          "role": "长次",
          "text": "等找到妈妈…或许还有爸爸，我就带他们去须弥。听说那里有治疗这种怪病的方法。"
        },
        {
          "role": "长次",
          "text": "但在那之前，我也不能放弃任何一分治疗的希望。"
        },
        {
          "role": "长次",
          "text": "好啦，我说的也够多了，还愿意帮这个忙吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不用问也会的。",
              "dialogues": []
            },
            {
              "text": "希望你能好好利用那些晶石。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "长次",
          "text": "谢谢！我不会忘记的！"
        },
        {
          "type": "subtitle",
          "text": "◆搜集12枚晶化骨髓，再次和长次对话"
        },
        {
          "role": "长次",
          "text": "旅行者，你回来啦。带回晶石了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "带回来了。",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "这些晶化骨髓应该足够了。接下来我就要启程去冒险咯。"
                },
                {
                  "role": "派蒙",
                  "text": "还是好担心这孩子…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "照顾好自己。",
                      "dialogues": []
                    },
                    {
                      "text": "一定常联系。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "长次",
                  "text": "嗯！"
                },
                {
                  "role": "派蒙",
                  "text": "喂，长次你不要再满嘴跑舌头啦！还好是遇上了我们…不然会被打的！"
                },
                {
                  "role": "派蒙",
                  "text": "还有还有，遇到坏人想要套话，也不要对他们讲实话！一定要乱胡诌！"
                },
                {
                  "role": "派蒙",
                  "text": "还有还有…"
                },
                {
                  "role": "旅行者",
                  "text": "派蒙变成老外婆了呢。"
                },
                {
                  "role": "派蒙",
                  "text": "这么小的孩子自己一个人出去冒险，谁会放心啦！"
                },
                {
                  "role": "旅行者",
                  "text": "我相信他。"
                },
                {
                  "role": "派蒙",
                  "text": "…真是的。"
                },
                {
                  "role": "长次",
                  "text": "哈哈哈哈！谢谢你们。"
                },
                {
                  "role": "长次",
                  "text": "希望我们以后还会见面。"
                },
                {
                  "role": "派蒙",
                  "text": "一定要注意安全呀…"
                },
                {
                  "role": "长次",
                  "text": "我没问题的！"
                },
                {
                  "role": "长次",
                  "text": "接下来我应该会去踏鞴砂，妈妈曾在那里工作过。或许还有人能告诉我她是否经过那边。"
                },
                {
                  "role": "长次",
                  "text": "再然后…我会想办法去鸣神岛，然后搭一艘至冬国的商船…之后的事情，随机应变。"
                },
                {
                  "role": "派蒙",
                  "text": "……"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你知道自己在说什么吗？",
                      "dialogues": []
                    },
                    {
                      "text": "你了解自己面对的风险吗？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "长次",
                  "text": "如果只因为不知道会面对怎样的风险，就不去做的话…这个世界上也不会有冒险家这种职业了吧？"
                },
                {
                  "role": "派蒙",
                  "text": "哇…这孩子真是气人…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "好吧…",
                      "dialogues": []
                    },
                    {
                      "text": "一定要小心。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "长次",
                  "text": "哈哈哈，放心啦！"
                },
                {
                  "role": "长次",
                  "text": "你们也一路平安！顺便，旅行者，希望你也能早日找到亲人。"
                },
                {
                  "role": "派蒙",
                  "text": "嗯！借你吉言！"
                }
              ]
            },
            {
              "text": "正在路上。",
              "dialogues": [
                {
                  "role": "长次",
                  "text": "不用急，多在这里歇一会也好。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "◆在踏鞴砂和长次对话"
        },
        {
          "role": "长次",
          "text": "你们好，又见面了！"
        },
        {
          "role": "派蒙",
          "text": "且慢——让我猜猜…"
        },
        {
          "role": "旅行者",
          "text": "「拜托再给我弄来一大堆晶化骨髓…」"
        },
        {
          "role": "派蒙",
          "text": "「…我有急用，呜呜…」"
        },
        {
          "role": "旅行者",
          "text": "这就是你想说的吧！"
        },
        {
          "role": "长次",
          "text": "哈哈哈哈哈，当然不是啦！"
        },
        {
          "role": "旅行者",
          "text": "你的旅途如何？"
        },
        {
          "role": "长次",
          "text": "还好，只是还没有找到妈妈的踪迹…"
        },
        {
          "role": "派蒙",
          "text": "没关系，我们也会帮忙的，对吧？旅行者？"
        },
        {
          "role": "旅行者",
          "text": "我们尽力而为。"
        },
        {
          "role": "长次",
          "text": "我就知道旅行者可以信赖！"
        },
        {
          "type": "subtitle",
          "text": "◆在鸣神岛和长次对话"
        },
        {
          "role": "长次",
          "text": "旅行者，没想到又能在这里看见你！"
        },
        {
          "role": "派蒙",
          "text": "好久不见啦！八酝岛外的世界怎么样？"
        },
        {
          "role": "长次",
          "text": "这里比家乡富裕很多，也有更多好吃的料理、好玩的东西。但是…我不太喜欢。"
        },
        {
          "role": "派蒙",
          "text": "欸？为什么？"
        },
        {
          "role": "长次",
          "text": "这里的人都缺少了些什么…"
        },
        {
          "role": "长次",
          "text": "从前在八酝岛生活的时候，大御所大人对我来说遥远安详…我们不会在意她在哪里，但是我们相信她就在这里，注视保护着我们，规定我们怎么过日子，成为什么样的人…"
        },
        {
          "role": "长次",
          "text": "但是在这里，大御所大人覆盖一切，威压一切…"
        },
        {
          "role": "长次",
          "text": "唉，我也说不清楚啦…"
        },
        {
          "role": "长次",
          "text": "对了，关于我的妈妈…你有发现什么吗？"
        },
        {
          "role": "旅行者",
          "text": "我们还在努力。"
        },
        {
          "role": "长次",
          "text": "没关系的，有消息再告诉我也不迟。"
        }
      ],
      "collapse_ranges": [
        [
          221,
          225
        ],
        [
          259,
          326
        ]
      ]
    }
  ]
}