{
  "quest_id": 20037,
  "chapter_num": null,
  "chapter_title": "触不可及的恋人",
  "type": "iq",
  "route": "Long Distance Love",
  "stories": [
    {
      "story_id": 20037,
      "title": "触不可及的恋人",
      "description": "西风骑士古德温正记挂着在蒙德城里的恋人，正在找人帮他送信回去问候…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "古德温先生好像有烦恼"
        },
        {
          "type": "subtitle",
          "text": "和古德温对话"
        },
        {
          "role": "古德温",
          "text": "信就拜托你了。唉，我真想回蒙德城去见见葛罗丽，但是…"
        },
        {
          "role": "古德温",
          "text": "…唉，真想直接回蒙德城算了…"
        },
        {
          "role": "古德温",
          "text": "呃，旅行者！那个，你能帮我个忙吗？"
        },
        {
          "role": "古德温",
          "text": "如你所见，我是一名西风骑士，正在野外执行巡逻任务。"
        },
        {
          "role": "古德温",
          "text": "我和我的女朋友说好，隔段时间就会寄封信给她报平安。"
        },
        {
          "role": "古德温",
          "text": "结果我居然忙到忘记了，哈哈哈…请你把这封<color=#00E1FFFF>信</color>帮我送给她吧，她叫<color=#00E1FFFF>葛罗丽</color>…"
        },
        {
          "role": "旅行者",
          "text": "等等，葛罗丽？"
        },
        {
          "role": "派蒙",
          "text": "那位盲眼的…收集蒲公英的…"
        },
        {
          "role": "派蒙",
          "text": "喂！葛罗丽小姐说的古德温，原来就是你吗？！"
        },
        {
          "role": "古德温",
          "text": "咦，为什么你们会认识葛罗丽？"
        },
        {
          "role": "旅行者",
          "text": "我们帮过她的忙。"
        },
        {
          "role": "古德温",
          "text": "她、她找你们帮忙？是要做什么危险的事吗？你们…"
        },
        {
          "role": "派蒙",
          "text": "葛罗丽小姐只是拜托我们帮她搜集蒲公英啦。说是撒在空中的话，可以把心愿传达给你。"
        },
        {
          "role": "古德温",
          "text": "啊，蒲公英…确实像是葛罗丽会做的事。"
        },
        {
          "role": "旅行者",
          "text": "你不是离开蒙德城很久了吗？"
        },
        {
          "role": "古德温",
          "text": "本来应该是这样。算了…我就说了吧。"
        },
        {
          "role": "古德温",
          "text": "你有没有听说，大团长把五分之四骑士带出蒙德的事？"
        },
        {
          "role": "古德温",
          "text": "是的，我也是骑士团远征队的一员…但在出征之前，我因为弄丢了葛罗丽的信物，想要寻找，却掉了队…"
        },
        {
          "role": "古德温",
          "text": "到现在也没找到归队的方法，只能一直在这附近转悠…"
        },
        {
          "role": "古德温",
          "text": "我也不好意思回蒙德城，就这么灰溜溜地回去，西风骑士们都会怎么看我啊！"
        },
        {
          "role": "古德温",
          "text": "还有葛罗丽，我答应她，会在世界各地给她寄信和礼物，把「全世界」都带给她。"
        },
        {
          "role": "古德温",
          "text": "要是她知道我连蒙德都没走出去…的…话…"
        },
        {
          "role": "派蒙",
          "text": "原来是面子问题呀"
        },
        {
          "role": "古德温",
          "text": "拜托了，你能帮我把这封<color=#00E1FFFF>信</color>送给<color=#00E1FFFF>葛罗丽</color>吗？说不定，她还在为我担心…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "古德温",
                  "text": "那就拜托你了，旅行者，千万帮我保密啊！"
                }
              ]
            },
            {
              "text": "你干脆也用蒲公英好了…",
              "dialogues": [
                {
                  "role": "古德温",
                  "text": "我想对葛罗丽说的话太多了，蒲公英怎么可能载得动嘛。"
                },
                {
                  "role": "古德温",
                  "text": "信就拜托你了，千万帮我保密！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "将信送给葛罗丽"
        },
        {
          "role": "葛罗丽",
          "text": "您好…啊，这个声音，是之前的那位旅行者吧。"
        },
        {
          "role": "葛罗丽",
          "text": "请问您找我有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "有人托我带给你一封信。"
        },
        {
          "role": "葛罗丽",
          "text": "信？谁会给我写信…"
        },
        {
          "role": "葛罗丽",
          "text": "难道是古德温？"
        },
        {
          "role": "葛罗丽",
          "text": "您遇见他了吗？他还好吧，他说过自己会什么时候回来…"
        },
        {
          "role": "葛罗丽",
          "text": "抱歉，他现在一定很忙，请您忘了我刚说的话吧，不要再给他压力了。"
        },
        {
          "role": "葛罗丽",
          "text": "能请您现在就帮我念念这封信吗？"
        },
        {
          "role": "葛罗丽",
          "text": "请小声一点，我们两个人听得到就好啦…"
        },
        {
          "role": "旅行者",
          "text": "好的。"
        },
        {
          "role": "葛罗丽",
          "text": "您念得真不错…难道，您经常给人念信吗？"
        },
        {
          "role": "旅行者",
          "text": "信就写到这里了。"
        },
        {
          "role": "葛罗丽",
          "text": "璃月港…古德温真的去了很远的地方啊。"
        },
        {
          "role": "葛罗丽",
          "text": "谢谢你，我会珍藏这封信的，再见到<color=#00E1FFFF>古德温</color>的时候，记得替我向他问声好。"
        },
        {
          "type": "subtitle",
          "text": "向古德温回报"
        },
        {
          "role": "古德温",
          "text": "信送到了吗？"
        },
        {
          "role": "旅行者",
          "text": "葛罗丽向你问好。"
        },
        {
          "role": "古德温",
          "text": "呼…我这么久没联系她，还好她没生气。"
        },
        {
          "role": "派蒙",
          "text": "你一直在蒙德周围，为什么会知道璃月港的事？"
        },
        {
          "role": "古德温",
          "text": "那个啊，呃…这些故事我都是听大团长说的，他去过很多地方。"
        },
        {
          "role": "古德温",
          "text": "好了，谢谢你，帮了我这么大的忙。"
        },
        {
          "role": "古德温",
          "text": "这些蒲公英籽给你们，都是我采的…"
        },
        {
          "role": "古德温",
          "text": "下次葛罗丽还想搜集蒲公英的话，请你们继续照顾她吧，麻烦你们了。"
        }
      ]
    }
  ]
}