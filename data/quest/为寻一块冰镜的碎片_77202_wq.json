{
  "quest_id": 77202,
  "chapter_num": null,
  "chapter_title": "为寻一块冰镜的碎片",
  "type": "wq",
  "route": "For an Ice Mirror Fragment",
  "stories": [
    {
      "story_id": 77202,
      "title": "为寻一块冰镜的碎片",
      "description": "在冰窟中发现了在雪山上迷路的人留下的笔记…他还存活吗？还能挽救他的生命吗…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "唔，帐篷里没有人，不过也没有太多的积雪…"
        },
        {
          "role": "派蒙",
          "text": "什么人会到这里来呢…真是奇怪。"
        },
        {
          "role": "派蒙",
          "text": "这个是什么，冒险手记吗…"
        },
        {
          "role": "派蒙",
          "text": "「风雪就像面具一样扣在了脸上，眼睛都睁不开，根本找不到路，别说是去赫斯珀利德斯之馆，回家的路也…」"
        },
        {
          "role": "派蒙",
          "text": "「还好，找到了能够躲避风雪的山洞，可食物已经见底…也许一开始就不该…不行，这一定是对我的考验。」"
        },
        {
          "role": "派蒙",
          "text": "「我一定要到公馆，去见见那位大人…去见识见识真正的臻冰技艺。」"
        },
        {
          "role": "派蒙",
          "text": "「可是该怎么出去呢…也许，可以顺着这个山洞往前再探探…」"
        },
        {
          "role": "派蒙",
          "text": "「唔，好像已经适应这份温度，周围都开始变得暖和一点了。」"
        },
        {
          "role": "派蒙",
          "text": "哇，这个人没事吧，感觉都已经快冻出幻觉了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他这不是暖和起来了嘛。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "在冰天雪地里觉得暖和才是最可怕的！"
                }
              ]
            },
            {
              "text": "看上去确实有点严重…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是啊…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "他留下的手记里说，他顺着山洞往前…我们也往前看看吧，不知道他还有没有救…"
        },
        {
          "type": "subtitle",
          "text": "在洞穴探索"
        },
        {
          "type": "subtitle",
          "text": "救助冰窟中的人"
        },
        {
          "role": "派蒙",
          "text": "还好，没有直接落进水里…"
        },
        {
          "role": "马尔托斯",
          "text": "小、小心…这块冰开始动起来了…"
        },
        {
          "role": "派蒙",
          "text": "不用担心，我们会把你带出去的。"
        },
        {
          "type": "subtitle",
          "text": "在冰河上漂流直至靠岸"
        },
        {
          "role": "某人的冒险手记",
          "text": "「风雪就像面具一样扣在了脸上，眼睛都睁不开，根本找不到路，别说是去赫斯珀利德斯之馆，回家的路也…」"
        },
        {
          "role": "某人的冒险手记",
          "text": "「还好，找到了能够躲避风雪的山洞，可食物已经见底…也许一开始就不该…不行，这一定是对我的考验。」"
        },
        {
          "role": "某人的冒险手记",
          "text": "「我一定要到公馆，去见见那位大人…去见识见识真正的臻冰技艺。」"
        },
        {
          "role": "某人的冒险手记",
          "text": "「可是该怎么出去呢…也许，可以顺着这个山洞往前再探探…」"
        },
        {
          "role": "某人的冒险手记",
          "text": "「唔，好像已经适应这份温度，周围都开始变得暖和一点了。」"
        },
        {
          "type": "subtitle",
          "text": "和马尔托斯对话"
        },
        {
          "role": "马尔托斯",
          "text": "呼、呼…吓死了…要是掉进水里，那真的要…小命不保。"
        },
        {
          "role": "马尔托斯",
          "text": "感谢两位，我…我叫马尔托斯…抱歉…"
        },
        {
          "role": "派蒙",
          "text": "为什么要抱歉？"
        },
        {
          "role": "马尔托斯",
          "text": "…我本来想提醒二位那块冰不太坚固，可是，在那上面，不知道为什么，说不出话来。"
        },
        {
          "role": "派蒙",
          "text": "一定是因为那时候你身子太过虚弱…不过，现在好些了吗？"
        },
        {
          "role": "马尔托斯",
          "text": "现在好些了，多谢二位…呼…还不知道，两位恩人的名字是…"
        },
        {
          "role": "？？？",
          "text": "向马尔托斯作了自我介绍。"
        },
        {
          "role": "马尔托斯",
          "text": "旅行者和派蒙，原来如此。"
        },
        {
          "role": "派蒙",
          "text": "…不过马尔托斯，你到这里来，是为了什么呀。冰天雪地的…"
        },
        {
          "role": "马尔托斯",
          "text": "臻冰雕塑，我是来学习臻冰雕塑的…"
        },
        {
          "role": "派蒙",
          "text": "臻冰雕塑？"
        },
        {
          "role": "马尔托斯",
          "text": "对！咳咳…我本来是想去赫斯珀利德斯之馆，馆的主人是精通臻冰技艺的雪精的王公…"
        },
        {
          "role": "马尔托斯",
          "text": "许多佳作都出自她手，就连至冬宫广场中心的雪花，新基捷王公府前仿晶矿的雕塑，都是她的作品…"
        },
        {
          "role": "马尔托斯",
          "text": "人类虽然无法如妖精那般驱使臻冰…但是亦可用锤与凿雕琢出同样的美。"
        },
        {
          "role": "马尔托斯",
          "text": "感谢二位的帮忙，我离公馆又更近一步啦！"
        },
        {
          "role": "派蒙",
          "text": "啊，你还要去山上的公馆啊！"
        },
        {
          "role": "马尔托斯",
          "text": "都到了这步，回头反而会不太甘心呐…"
        },
        {
          "role": "派蒙",
          "text": "可是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "前进可以，等风雪小一些吧。",
              "dialogues": []
            },
            {
              "text": "得休息好了再走哦？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马尔托斯",
          "text": "会的。"
        },
        {
          "role": "？？？",
          "text": "你在这里为他生起了火，并分给了他一些食物与水。"
        },
        {
          "role": "派蒙",
          "text": "吃饱喝足，身体暖和了，这样才好继续前进！"
        },
        {
          "role": "马尔托斯",
          "text": "…真、真是太感谢了。"
        },
        {
          "role": "马尔托斯",
          "text": "两位，如果我能学成，我一定，一定为两位做一尊了不起的雕像！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "记得把我做高大一些…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那、那我也要…"
                }
              ]
            },
            {
              "text": "记得把派蒙做可爱一些…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "什么叫可爱一些啦，我现在不可爱吗！"
                }
              ]
            }
          ]
        },
        {
          "role": "马尔托斯",
          "text": "哈哈，到时候，一定会让二位满意的！"
        }
      ]
    }
  ]
}