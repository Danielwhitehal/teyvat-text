{
  "quest_id": 10004,
  "chapter_num": "海灯节 第四天",
  "chapter_title": "海灯节 第四天",
  "type": "eq",
  "route": "Lantern Rite: Day 4",
  "stories": [
    {
      "story_id": 40004,
      "title": "托风问故人$UNRELEASED",
      "description": "为忙碌至极的千岩军稍微搭了把手以后，终于有一个小队表示，可以抽出人力来加强戒备了。而怀疑此事只是杯水车薪的你，回到了现场，想要再发现一些有用的线索或踪迹。出乎意料地，在堆放易燃材料的现场，你遇到了同样在查看可疑痕迹的璃月仙人——魈。建设现场角落的暗处，被人画下了一个符号。「如果在仙与魔的世界，有什么东西失去桎梏，那就是我的责任。」「但这次的威胁来自人类的世界——你们的世界，所以这是你的责任，人类旅者。」仙人是这样对你说的。为了问明这个符号的来历，你想到了之前在蒙德结识的那位，黑白通吃、游走于灰色地带的骑士…$UNRELEASED",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "在蒙德寻找凯亚$UNRELEASED"
        },
        {
          "type": "subtitle",
          "text": "与凯亚对话$UNRELEASED"
        },
        {
          "role": "凯亚",
          "text": "旅行者，嚯，好久不见。"
        },
        {
          "role": "派蒙",
          "text": "凯亚，我们去璃月海灯节了！"
        },
        {
          "role": "凯亚",
          "text": "怎么样，海灯节有趣吗？"
        },
        {
          "role": "派蒙",
          "text": "好吃！"
        },
        {
          "role": "凯亚",
          "text": "那你好好期待蒙德的羽球节吧。应该也不会让你失望的。"
        },
        {
          "role": "旅行者",
          "text": "说正事吧，派蒙。"
        },
        {
          "role": "派蒙",
          "text": "啊，对了。凯亚，事情是这样的。"
        },
        {
          "role": "凯亚",
          "text": "嗯…建灯用的木、纸、油这些材料…无论怎么想，都很容易滑向危险的方向…"
        },
        {
          "role": "凯亚",
          "text": "哼哼，很有意思，你们为什么觉得我会认识这个符号呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "因为凯亚神通广大，值得信任。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是的！"
                },
                {
                  "role": "凯亚",
                  "text": "呵呵呵，不敢当，我哪有那种本事。"
                },
                {
                  "role": "派蒙",
                  "text": "出现了！骑士「谦虚」的品德。"
                },
                {
                  "role": "凯亚",
                  "text": "哼哼，在璃月呆了一阵子，变得牙尖嘴利了啊。"
                }
              ]
            },
            {
              "text": "因为凯亚黑白通吃，可以依赖。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "没错！"
                },
                {
                  "role": "凯亚",
                  "text": "啧啧。作为荣誉骑士，要慎言啊。"
                },
                {
                  "role": "凯亚",
                  "text": "什么叫黑白通吃？我们西风骑士团是不和敌人做交易的。"
                },
                {
                  "role": "凯亚",
                  "text": "这就是骑士「诚实」的品德。"
                }
              ]
            }
          ]
        },
        {
          "role": "凯亚",
          "text": "回到正题吧。这是跨国犯罪组织「盗宝团」的符号。"
        },
        {
          "role": "凯亚",
          "text": "你如果有兴趣的话，我可以安排你和线人见一面哦。"
        },
        {
          "role": "派蒙",
          "text": "西风骑士团不是不和敌人做交易吗？"
        },
        {
          "role": "凯亚",
          "text": "——那是我凯亚的线人，不是西风骑士团的啊。"
        },
        {
          "role": "凯亚",
          "text": "晚些时候，去风起地吧。我会安排线人去赴会的。"
        },
        {
          "role": "派蒙",
          "text": "谢谢你，凯亚。"
        },
        {
          "role": "凯亚",
          "text": "记住了，「酒中出真知」。"
        },
        {
          "role": "派蒙",
          "text": "嗯？"
        },
        {
          "type": "subtitle",
          "text": "与凯亚的线人对话$UNRELEASED"
        },
        {
          "role": "宁禄",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "你就是凯亚先生推荐来的线人吗？"
        },
        {
          "role": "宁禄",
          "text": "什么线人？不是。"
        },
        {
          "role": "派蒙",
          "text": "可是，在这个约好的地方，只有你啊…"
        },
        {
          "role": "宁禄",
          "text": "什么约好的？不知道。"
        },
        {
          "role": "派蒙",
          "text": "哇，真是让人烦躁的态度！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「酒中出真知。」",
              "dialogues": [
                {
                  "role": "宁禄",
                  "text": "嗯，是自己人。"
                },
                {
                  "role": "派蒙",
                  "text": "这个形式上的流程有什么意义！？"
                }
              ]
            },
            {
              "text": "都、都在酒里。",
              "dialogues": [
                {
                  "role": "宁禄",
                  "text": "嗯…"
                },
                {
                  "role": "派蒙",
                  "text": "……"
                },
                {
                  "role": "宁禄",
                  "text": "嗯，虽然暗号错了，但如果都在酒里，那真知也应该在酒里。"
                },
                {
                  "role": "宁禄",
                  "text": "没错。是自己人。"
                },
                {
                  "role": "派蒙",
                  "text": "这个形式上的流程有什么意义！？"
                }
              ]
            }
          ]
        },
        {
          "role": "宁禄",
          "text": "有什么想问的吗？"
        },
        {
          "role": "派蒙",
          "text": "事情是这样的…"
        },
        {
          "role": "宁禄",
          "text": "这样吗？"
        },
        {
          "role": "派蒙",
          "text": "有什么内部的消息吗？"
        },
        {
          "role": "宁禄",
          "text": "我觉得这应该不是盗宝团所为。"
        },
        {
          "role": "宁禄",
          "text": "盗宝团能够打下横跨多国的基业，是因为他们永远遵循一个最根本的原则。"
        },
        {
          "role": "宁禄",
          "text": "——「富贵险中求」都是骗人的鬼话，稳扎稳打才是人间正道。"
        },
        {
          "role": "宁禄",
          "text": "璃月港可是有仙人守护的，尤其是在海灯节期间…"
        },
        {
          "role": "宁禄",
          "text": "所以对海灯节出手，这事我们——对不起，角色没缓过来——这事盗宝团绝不会做。"
        },
        {
          "role": "宁禄",
          "text": "而且…璃月那里的盗宝团组织，最近收到了一封匿名信。"
        },
        {
          "role": "派蒙",
          "text": "匿名信？难道是有人准备栽赃盗宝团？"
        },
        {
          "role": "宁禄",
          "text": "这就不得而知了。但我可以告诉你们这封信在盗宝团的哪个分部手里。"
        },
        {
          "role": "宁禄",
          "text": "…好了，已经帮你们标在地图上了。"
        },
        {
          "role": "派蒙",
          "text": "嗯，很有收获！旅行者，我们要努力抓住这唯一的线索啊！"
        },
        {
          "role": "宁禄",
          "text": "那么，如果没什么别的事情，我就回去继续盗…我是说，回去监视盗宝团了。"
        },
        {
          "type": "subtitle",
          "text": "根据情报寻找盗宝团$UNRELEASED"
        },
        {
          "type": "subtitle",
          "text": "击败盗宝团$UNRELEASED"
        },
        {
          "role": "贝儿",
          "text": "英雄大人，神仙哥哥！手下留情！$UNRELEASED"
        },
        {
          "role": "伶俐鬼",
          "text": "那匿名信一纸胡言乱语，不必这般兵戎相向的！拿去便是！$UNRELEASED"
        },
        {
          "role": "派蒙",
          "text": "真巧，我早就这么觉得了。$UNRELEASED"
        },
        {
          "role": "派蒙",
          "text": "旅行者，来看看匿名信的内容吧。$UNRELEASED"
        },
        {
          "role": "魈",
          "text": "原来如此，那么就让这两位前去赴会吧。$UNRELEASED"
        },
        {
          "role": "魈",
          "text": "寄信之人可能对海灯节图谋不轨，似乎准备纵火焚城。$UNRELEASED"
        },
        {
          "role": "贝儿",
          "text": "如此甚好。你们也好，我们也好。只是…$UNRELEASED"
        },
        {
          "role": "伶俐鬼",
          "text": "只是，他们两人和我们两人，未免体形相差太大了吧。$UNRELEASED"
        },
        {
          "role": "派蒙",
          "text": "不用担心，乔装打扮之后就认不出来了。$UNRELEASED"
        },
        {
          "role": "贝儿",
          "text": "虽然我觉得哪里不对，但是既然有仙人撑腰，应该不要紧吧。$UNRELEASED"
        },
        {
          "role": "伶俐鬼",
          "text": "那…那璃月安危就托付两位了，我们盗宝团也不希望全城尽毁啊。$UNRELEASED"
        },
        {
          "role": "魈",
          "text": "既然如此，我们就这样讲定了。$UNRELEASED"
        },
        {
          "role": "旅行者",
          "text": "请等等…$UNRELEASED"
        },
        {
          "role": "魈",
          "text": "怎么了？$UNRELEASED"
        },
        {
          "role": "旅行者",
          "text": "我们下一次见面的地方…$UNRELEASED"
        },
        {
          "role": "魈",
          "text": "嗯？$UNRELEASED"
        },
        {
          "role": "旅行者",
          "text": "希望是能看到明霄灯的地方。$UNRELEASED"
        },
        {
          "role": "魈",
          "text": "…我不喜欢人来人往之处，尤其是每年的这几天里。$UNRELEASED"
        },
        {
          "role": "魈",
          "text": "非要在那里不可吗？$UNRELEASED"
        },
        {
          "role": "旅行者",
          "text": "是的！$UNRELEASED"
        },
        {
          "role": "魈",
          "text": "…我明白了。我会在那里等你的消息的。$UNRELEASED"
        },
        {
          "type": "subtitle",
          "text": "与盗宝团成员对话$UNRELEASED"
        },
        {
          "role": "贝儿",
          "text": "朋友，你走错地方了。无论您想去哪里，都往那边去吧。$UNRELEASED"
        },
        {
          "role": "派蒙",
          "text": "那边不是璃月港吗？$UNRELEASED"
        },
        {
          "role": "贝儿",
          "text": "当然是去璃月港了，因为这里什么都没有啊。$UNRELEASED"
        },
        {
          "role": "伶俐鬼",
          "text": "要吃喝住宿？那可以去那边的望舒客栈。价格公道，态度一流，风景绝好。$UNRELEASED"
        },
        {
          "role": "旅行者",
          "text": "我们想看「那封匿名信」。$UNRELEASED"
        },
        {
          "role": "贝儿",
          "text": "你为什么会知道这件事？$UNRELEASED"
        },
        {
          "role": "派蒙",
          "text": "…是、是璃月的仙人告诉我们的！$UNRELEASED"
        },
        {
          "role": "贝儿",
          "text": "你这句话也编得也太假了吧。$UNRELEASED"
        },
        {
          "role": "魈",
          "text": "不错。是我委托他们来调查的。$UNRELEASED"
        },
        {
          "role": "魈",
          "text": "现在，还有什么问题吗？$UNRELEASED"
        },
        {
          "role": "贝儿",
          "text": "你…你是「护法夜叉」？！$UNRELEASED"
        },
        {
          "role": "派蒙",
          "text": "见到仙人，为什么反而是这种想要开打的语气？$UNRELEASED"
        },
        {
          "role": "伶俐鬼",
          "text": "不是我们不信您是仙人…但大家想，开开眼界。$UNRELEASED"
        },
        {
          "role": "贝儿",
          "text": "您也知道，我们盗宝团不做什么大奸大恶之事。$UNRELEASED"
        },
        {
          "role": "伶俐鬼",
          "text": "您要真是仙人的话，劳烦手下留情。$UNRELEASED"
        },
        {
          "role": "贝儿",
          "text": "当然，如果不是真正仙人…$UNRELEASED"
        },
        {
          "role": "伶俐鬼",
          "text": "那就休怪我们兵器不长眼睛了。$UNRELEASED"
        }
      ]
    }
  ]
}