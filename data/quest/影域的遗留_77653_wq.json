{
  "quest_id": 77653,
  "chapter_num": null,
  "chapter_title": "影域的遗留",
  "type": "wq",
  "route": "Remnants of the Shadow Realm",
  "stories": [
    {
      "story_id": 77653,
      "title": "影域的遗留",
      "description": "你想起了之前和阿罗夏一起发现的台座，它似乎与影域有关联…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与阿罗夏对话"
        },
        {
          "role": "阿罗夏",
          "text": "这个台座的用途…我也很在意。"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "目前可以确认的是，它也是一种影域科技。"
        },
        {
          "role": "旅行者",
          "text": "这位是…"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "你好，我是塔佩兹尼科夫，阿罗夏的朋友。"
        },
        {
          "role": "阿罗夏",
          "text": "之前我不是说过要从呼啸社找个熟人过来吗？就是这位。他对这些影域科技很有研究。"
        },
        {
          "role": "阿罗夏",
          "text": "话说回来，你知道这个台座是用来做什么的吗？"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "从我刚刚的观察来看，它似乎是一种用来浏览信息的设备，不过需要某种权限来解锁…"
        },
        {
          "role": "旅行者",
          "text": "让我来试试。"
        },
        {
          "role": "「灰眸」",
          "text": "确认操作权限…已激活。"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "看上去，使用这个台座就可以查看与那些科技造物有关的信息。"
        },
        {
          "role": "旅行者",
          "text": "确实如此。"
        },
        {
          "role": "阿罗夏",
          "text": "看来我们搞清楚这东西的用处了。"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "旅行者手中的这张权限卡也很特殊，它能激活这个台座，还能打开屏障。"
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "不过，肯定需要先解锁对应的权限，这应该和卡面上的图案有关吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这些科技的使用方法…",
            "能向你请教吗？"
          ]
        },
        {
          "role": "塔佩兹尼科夫",
          "text": "请教…你太高看我了，我对这些科技造物只能算略知一二，但我愿意尽我所能，解答你的疑问。"
        }
      ]
    }
  ]
}