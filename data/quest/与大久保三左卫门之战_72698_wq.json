  "stories": [
    {
      "story_id": 72698,
      "title": "与大久保三左卫门之战",
      "description": "为主家守门却没防住翻墙的盗贼而被逐的浪人武士，大久保三左卫门，参上！",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与大久保三左卫门对话"
        },
        {
          "role": "大久保三左卫门",
          "text": "你就是旅行者吗？"
        },
        {
          "role": "旅行者",
          "text": "没错。"
        },
        {
          "role": "大久保三左卫门",
          "text": "很好，让我来领教领教你的本事。"
        },
        {
          "role": "大久保三左卫门",
          "text": "就把这场比试，当作我与那位「最强武者」决斗前的预演吧。"
        },
        {
          "role": "旅行者",
          "text": "「最强武者」？"
        },
        {
          "role": "大久保三左卫门",
          "text": "你不必知道，毕竟你很快就会成为我的手下败将。来，让我们开始吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "来吧。",
            "等等，让我准备一下。"
          ]
        },
        {
          "role": "大久保三左卫门",
          "text": "那么，别怪我剑下不留情了。"
        }
      ]
    }
  ]
}