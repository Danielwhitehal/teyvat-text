{
  "quest_id": 72730,
  "chapter_num": null,
  "chapter_title": "荒泷极意堂堂斗虫大试合！",
  "type": "wq",
  "route": "Almighty Arataki Extraordinary and Exhilarating Extreme Beetle Brawl!",
  "stories": [
    {
      "story_id": 72730,
      "title": "荒泷极意堂堂斗虫大试合！",
      "description": "最近你和派蒙的状态特别不错，打算多多接取冒险家协会的委托！可在冒险家协会附近，你们却遇到了正在大声密谋的荒泷派…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆前往冒险家协会"
        },
        {
          "role": "派蒙",
          "text": "嗯…最近我们的状态还不错，是时候接几个新的委托，把这种劲头维持下去了！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们去冒险家协会看看吧，说不定凯瑟琳小姐正等着我们呢！"
        },
        {
          "type": "subtitle",
          "text": "◆旁听荒泷派的讨论"
        },
        {
          "role": "阿守",
          "text": "老大，不能就这么算了啊！"
        },
        {
          "role": "阿守",
          "text": "你好不容易打响了「真剑斗虫大鬼王」的名号，怎么能让那个小鬼得逞！"
        },
        {
          "role": "阿晃",
          "text": "对，那个小鬼一定使诈了，他暗算了老大！"
        },
        {
          "role": "荒泷一斗",
          "text": "你们两个，慌什么！"
        },
        {
          "role": "荒泷一斗",
          "text": "之前的那一仗，本大爷也有点轻敌。谁让那个小鬼看起来太普通了嘛！不算数，不算数！"
        },
        {
          "role": "荒泷一斗",
          "text": "别管那小鬼耍了什么把戏，我们就按计划，摆开「荒泷极意堂堂斗虫大试合」的阵势，再拿出本大爷锤炼多年的「赤红一杵」！"
        },
        {
          "role": "荒泷一斗",
          "text": "到时候，满场都是观众们为本大爷叫好的呼声，再加上「赤红一杵」碾压性的实力…"
        },
        {
          "role": "荒泷一斗",
          "text": "那个小鬼绝对会吓得两腿发抖吧，什么伎俩都使不出来！本大爷轻轻松松就能把他拿下，啊哈哈哈哈哈哈哈哈哈！"
        },
        {
          "role": "阿守",
          "text": "老大英明！！！"
        },
        {
          "role": "阿晃",
          "text": "可是，忍姐不知道什么时候才会回来，要举办这场「荒泷极意堂堂斗虫大试合」，从什么地方下手才好？"
        },
        {
          "role": "阿晃",
          "text": "根据「荒泷极上盛世豪鼓大祭典」的经验，我们需要提前向天领奉行报备，拿到活动举办许可…好像还有个场地租用凭证。"
        },
        {
          "role": "阿晃",
          "text": "这些好像都需要经费，考虑到要把「极意大试合」举办得比「豪鼓大祭典」更热闹，至少得花三倍的摩拉…"
        },
        {
          "role": "荒泷一斗",
          "text": "停停停停停！一听到天领奉行这四个字，我就头疼得厉害！"
        },
        {
          "role": "荒泷一斗",
          "text": "至于经费…大不了我们就别做一休三了！加把劲，做二休四！这样我们加起来多做了四天工，整整多赚四倍摩拉，肯定够了！"
        },
        {
          "role": "阿晃",
          "text": "不愧是老大！这样一来，我们只需要考虑参战的将士了！参战的将士也不用太强，能帮老大应付对方的杂兵就行！"
        },
        {
          "role": "阿守",
          "text": "对哦！那小鬼说过，他还会带五个斗虫好手过来，和我们公正对决。问题是荒泷派里精通斗虫的，就只有老大你了…"
        },
        {
          "role": "阿守",
          "text": "要是他们对老大发起车轮战，就算老大的实力再强，也会吃不消的！"
        },
        {
          "role": "荒泷一斗",
          "text": "你们两个！明明还没开始准备，怎么就畏手畏脚了？"
        },
        {
          "role": "荒泷一斗",
          "text": "拿出荒泷派的志气来！这点小问题，本大爷会想办法解决的！"
        },
        {
          "role": "荒泷一斗",
          "text": "要不然，先去把以前斗虫的小友们找过来，商量一下？或者去长野原烟花店看看，问问她能不能参战…"
        },
        {
          "role": "荒泷一斗",
          "text": "不成！那样的话，本大爷败给一个小鬼的事，很快就会传遍整个花见坂，谁丢得起那个脸！"
        },
        {
          "role": "派蒙",
          "text": "嗯哼！放牛的，你又在搞什么名堂？"
        },
        {
          "role": "荒泷一斗",
          "text": "喂！吓死本大爷了，你们什么时候来的！"
        },
        {
          "role": "派蒙",
          "text": "居然还好意思问我们，我们站在这里很久了哦。"
        },
        {
          "role": "派蒙",
          "text": "我和旅行者本来想去冒险家协会，结果远远就看见你们在这里吵吵嚷嚷，说着一大堆不明所以的话…"
        },
        {
          "role": "旅行者",
          "text": "「极意堂堂斗虫试合」？"
        },
        {
          "role": "荒泷一斗",
          "text": "是「大」试合！少了一个大字，可就完全不够热血了！"
        },
        {
          "role": "荒泷一斗",
          "text": "我的挚友啊，如果你也多多斗虫，一定能明白斗虫激动人心的地方！"
        },
        {
          "role": "派蒙",
          "text": "所以说，你是不是被什么人打败了，正琢磨着怎么挽回面子？"
        },
        {
          "role": "荒泷一斗",
          "text": "话可不能这么说，那都是暗算，暗算！"
        },
        {
          "role": "阿守",
          "text": "没错，有个叫「花角玉将」的小鬼，看准老大和其他小友切磋后的疲劳时期，突然加入对局，向老大发起了挑战。"
        },
        {
          "role": "阿守",
          "text": "用一只大得夸张的鬼兜虫，哐哐两下就把老大的虫子挑翻了。"
        },
        {
          "role": "阿守",
          "text": "还说什么，要让老大了解「斗虫强者的真实世界」…"
        },
        {
          "role": "荒泷一斗",
          "text": "喂，阿守！不用把我战败的过程说得这么清楚！"
        },
        {
          "role": "旅行者",
          "text": "好像明白了原委…"
        },
        {
          "role": "荒泷一斗",
          "text": "言归正传，我好像听说过，我的挚友无论干什么都很有天赋，两三下就能学会一门新技艺，而且比大部分人还厉害…"
        },
        {
          "role": "派蒙",
          "text": "我已经猜到你要说什么了，放牛的！"
        },
        {
          "role": "派蒙",
          "text": "你是不是想拜托我们帮你报仇，打败那个什么「花角玉将」，让我们打白工了？"
        },
        {
          "role": "荒泷一斗",
          "text": "打白工？飞行矮堇瓜，我荒泷一斗是那么不讲义气的人吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "要是我的挚友答应帮我，我就包下你们两个月的午饭，每天都请你们吃一碗招牌拉面，怎么样？"
        },
        {
          "role": "派蒙",
          "text": "每，每天一碗？那我们确实可以考虑考虑…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一斗居然这么阔绰？",
              "dialogues": []
            },
            {
              "text": "难道打工挣了大钱？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿晃",
          "text": "哈哈哈，这可是老大用宝贵的胜利换来的！"
        },
        {
          "role": "阿晃",
          "text": "之前有一位小友自称「真剑斗虫大鬼王」，老大听说后很不服气，就向他发起了挑战。如果那位小友输了，就要让出这个称号。"
        },
        {
          "role": "阿晃",
          "text": "经过长达一天一夜的九十二次苦战，老大终于险胜一场！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么听起来…",
              "dialogues": []
            },
            {
              "text": "像是对方受不了了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿守",
          "text": "不过，那位小友想用他家拉面摊「每天免费吃一碗招牌拉面」的优惠券，让老大网开一面，两个月后就把这个称号还给他。"
        },
        {
          "role": "阿守",
          "text": "虽然不知道他家的拉面有多少斤两，但光冲这个分量，就是很诱人的提议。"
        },
        {
          "role": "阿守",
          "text": "而且，凭老大斗虫技艺的进步速度，两个月后肯定会有更威风的绰号，这笔生意确实很划算！"
        },
        {
          "role": "阿守",
          "text": "只不过，我们都忘了问那位小友，他家的拉面摊在哪…"
        },
        {
          "role": "荒泷一斗",
          "text": "咳咳咳！都打住，都打住！过程不重要！总之，这些拉面都送给我的挚友和飞行矮堇瓜了！"
        },
        {
          "role": "派蒙",
          "text": "等等，我们还没想好呢！"
        },
        {
          "role": "荒泷一斗",
          "text": "我已经向「玉将」发出战书了，他也答应，会带着几个外援，应对我们荒泷派的攻势。"
        },
        {
          "role": "荒泷一斗",
          "text": "至于场地，我好像知道要去哪了。首先要拜托我的挚友，把天领奉行那边的复杂手续统统搞定！"
        },
        {
          "role": "荒泷一斗",
          "text": "事不宜迟，我的挚友，还有飞行矮堇瓜，现在就出发吧！"
        },
        {
          "role": "派蒙",
          "text": "话都说到这份上了，好像也推脱不了了…看一斗这么激动，我们就跟过去看看吧。"
        },
        {
          "role": "派蒙",
          "text": "反正学学斗虫，帮他打败对手就行了吧？听起来也不复杂！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也想吃招牌拉面到撑。",
              "dialogues": []
            },
            {
              "text": "我也想试试斗虫的乐趣。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…难道放牛的有什么「孩子气光环」吗？你也被影响了啦！"
        },
        {
          "type": "subtitle",
          "text": "前往天领奉行，帮助荒泷派办理了举办「荒泷极意堂堂斗虫大试合」的手续，随后来到了一斗所说的场地…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "◆前往「斗虫大试合」的场地"
        },
        {
          "type": "subtitle",
          "text": "◆与荒泷一斗对话"
        },
        {
          "role": "荒泷一斗",
          "text": "不错，阿守和阿晃准备的原材料都就位了，我们开始布置场地吧！"
        },
        {
          "type": "subtitle",
          "text": "根据以前的经验，试着搭建了「荒泷极意堂堂斗虫大试合」的擂台…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈哈哈！这擂台很有气势嘛，不错不错！"
        },
        {
          "role": "荒泷一斗",
          "text": "我的挚友，没想到你在这方面也有才能！"
        },
        {
          "role": "荒泷一斗",
          "text": "配合本大爷这精妙的宣传画，气氛不能更到位了，啊哈哈哈哈哈哈哈！"
        },
        {
          "role": "阿晃",
          "text": "旅行者好木工！老大好画功！"
        },
        {
          "role": "派蒙",
          "text": "可是，这里好像离稻妻城太远了，真的会有人过来看吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "没问题没问题！以本大爷的名气，还怕没人来看吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "听说容彩祭的时候，这里就举办了一场[[「堇庭华彩」#孤剑争逐|剑术比试]]，当然也是鬼兜虫对决的不二之选！"
        },
        {
          "role": "荒泷一斗",
          "text": "接下来，是时候给你们看看我天下无敌的鬼兜虫「赤红一杵」了。"
        },
        {
          "role": "派蒙",
          "text": "居然还真是红色的鬼兜虫，好威风！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就像被火元素影响了一样…",
              "dialogues": []
            },
            {
              "text": "确实有一股独特的威慑力…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "放牛的，没想到你还挺用功的，从哪找来了这么一只鬼兜虫啊？"
        },
        {
          "role": "派蒙",
          "text": "能让我凑近看看吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "哈！随便看随便看，仔细观瞻一番吧！不过，我可不会随随便便就把培养「赤红一杵」的秘密告诉你们！"
        },
        {
          "role": "派蒙",
          "text": "嗯？怎么有股熟悉的香味，好像是落落莓的果酱？"
        },
        {
          "role": "荒泷一斗",
          "text": "这！一定是你的错觉，你太饿了！"
        },
        {
          "role": "阿守",
          "text": "说起来，老大，你还没给「震慑涂装」加上保护涂层吧？要是下雨的话，我们花了九千摩拉才买到的那瓶舶来果酱，就都白费了…"
        },
        {
          "role": "荒泷一斗",
          "text": "没问题！反正「荒泷极意堂堂斗虫大试合」还没开始，还有时间给「赤红一杵」涂上最后的保护层。"
        },
        {
          "role": "荒泷一斗",
          "text": "你们先去准备传单，拉拢足够的观众。本大爷就在这里稍微指点一下挚友和飞行矮堇瓜，带他们上手。"
        },
        {
          "role": "荒泷一斗",
          "text": "然后，我们就先一起吃个饭，庆祝一下吧。哎呀，做了这么多事，真是辛苦本大爷了，哈…"
        },
        {
          "role": "「花角玉将」",
          "text": "哦？没想到你们的阵仗还挺大？"
        },
        {
          "role": "阿晃",
          "text": "出现了！「花角玉将」！"
        },
        {
          "role": "荒泷一斗",
          "text": "不应该啊！你是怎么知道这个地方的？"
        },
        {
          "role": "「花角玉将」",
          "text": "「真剑斗虫大鬼王」，你该不会忘了吧？斗虫的强者能够互相感应，上次不也是这样吗？"
        },
        {
          "role": "「花角玉将」",
          "text": "难道说，你还不知道该怎么面对我们，正在慌张地做准备？"
        },
        {
          "role": "荒泷一斗",
          "text": "什，什么话！要知道…没有和鬼兜虫心意合一时，本大爷会隐藏强者的气息，尽量保持低调！"
        },
        {
          "role": "荒泷一斗",
          "text": "我只是小看了你的洞察力！"
        },
        {
          "role": "派蒙",
          "text": "哦？他就是打败过一斗的人吗？看起来的确只是个普通的小孩呢…"
        },
        {
          "role": "派蒙",
          "text": "但他说话的风格很特别，感觉…和放牛的天生就要对着干！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "其实他们很合拍吧…",
              "dialogues": []
            },
            {
              "text": "先让他们寒暄一番…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "「花角玉将」！能找到这里来，算你有点本事，值得我「真剑斗虫大鬼王」再认真一点！"
        },
        {
          "role": "荒泷一斗",
          "text": "你们很快就会后悔了，因为你们这一次的行动太莽撞，就像是提前把脑袋伸过来挨揍。"
        },
        {
          "role": "「花角玉将」",
          "text": "嗯，这次的态度更自信了，看来你也拿出了最强的底牌。"
        },
        {
          "role": "「花角玉将」",
          "text": "最开始就让你一败涂地的话，一定会错过很多乐子。就由我的部下先陪你们玩玩吧。"
        },
        {
          "role": "荒泷一斗",
          "text": "哼！想用小弟来试探我们吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "那我们这边就派出飞行矮…"
        },
        {
          "role": "荒泷一斗",
          "text": "咳咳，不行，飞行矮堇瓜代表我荒泷派出战，气势绝不能输给那小鬼，那称号也得威风一点…"
        },
        {
          "role": "荒泷一斗",
          "text": "我明白了，就让「破空白铁小堇瓜」给你们一点教训！"
        },
        {
          "role": "派蒙",
          "text": "噫！为什么是我？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "速度提升型的派蒙？",
              "dialogues": []
            },
            {
              "text": "防御强化型的派蒙？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿晃",
          "text": "老大！现在就要和他们对决吗？"
        },
        {
          "role": "阿守",
          "text": "我们还没来得及宣传这场比试呢，你的挚友和挚友的瓜也还没经历过斗虫的实战。"
        },
        {
          "role": "荒泷一斗",
          "text": "对哦！但那小鬼都打上门来了，本大爷不可能当缩头乌龟！宣传的事之后再说！"
        },
        {
          "role": "荒泷一斗",
          "text": "至于斗虫的技巧，我会在旁边指导飞行矮堇瓜的…不对，是「破空白铁小堇瓜」！实战也是一种学习，输掉也没关系！"
        },
        {
          "role": "派蒙",
          "text": "好过分…还没开打就假设我会输…"
        },
        {
          "role": "荒泷一斗",
          "text": "白铁小堇瓜！你要拿出荒泷派的气势来！"
        },
        {
          "role": "荒泷一斗",
          "text": "让你第一个出战，可是我深思熟虑的策略！这个策略的灵感，可是我从阿忍那里听说过的璃月故事！"
        },
        {
          "role": "荒泷一斗",
          "text": "「用我方最弱去迎战对方的最强，我方中等迎战对方最弱，我方最强迎战敌方中等，这样一来，就能保证三局两胜！」"
        },
        {
          "role": "荒泷一斗",
          "text": "虽然你的确很有天分，但没多少实战的经验，在我们这一群斗虫强者中间，只能算是呆瓜。"
        },
        {
          "role": "荒泷一斗",
          "text": "派一个斗虫呆瓜上阵，就能让对方的一位好手失去用武之地，我们这边真是赚大了！哈哈哈哈哈哈哈！"
        },
        {
          "role": "派蒙",
          "text": "可是，按这个说法，你要亲自去和他们的头儿「花角玉将」一较高下，你不才是我们这边最弱的那个吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "等等，是这样吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "你…你好烦啊！我没说过我的策略和故事里完全一样吧！"
        },
        {
          "role": "派蒙",
          "text": "行啦行啦，我上就我上，我可不想被小瞧！"
        },
        {
          "role": "派蒙",
          "text": "看好了哦，我派蒙可绝不是斗虫呆瓜！"
        },
        {
          "type": "subtitle",
          "text": "◆与「电气鞘翅」对话"
        },
        {
          "role": "「电气鞘翅」",
          "text": "真是平平无奇的对手，出战的鬼兜虫也花里胡哨…"
        },
        {
          "role": "「电气鞘翅」",
          "text": "肤浅！外观根本是无所谓的东西，鬼兜虫最重要的「性能」，是对雷之力的共鸣。"
        },
        {
          "role": "「电气鞘翅」",
          "text": "所以说，挑选鬼兜虫的眼光，就决定了斗虫生涯的一切！"
        },
        {
          "role": "派蒙",
          "text": "什么奇怪的理论…就连我都明白，最重要的应该是实战的表现吧？应该把主要的精力花费在训练斗虫的技巧上吧！"
        },
        {
          "role": "荒泷一斗",
          "text": "就是啊！小堇瓜说得对！"
        },
        {
          "role": "荒泷一斗",
          "text": "你斗都不会斗，还谈什么性能！"
        },
        {
          "role": "荒泷一斗",
          "text": "听好了，白铁小堇瓜！你要观察对方鬼兜虫的动作，及时让我方鬼兜虫避开攻击，挑准对方出招后的破绽，发起猛攻！"
        },
        {
          "role": "荒泷一斗",
          "text": "只要进入攻击范围，「赤红一杵」就会给对方狠狠一击！"
        },
        {
          "role": "派蒙",
          "text": "也就是说，对方准备攻击时，我就让鬼兜虫后退，对方露出破绽时，我就让鬼兜虫前进，打他个措手不及！"
        },
        {
          "role": "派蒙",
          "text": "听起来很简单嘛，我试试看！旅行者听了一遍，应该也学会了！"
        },
        {
          "role": "「电气鞘翅」",
          "text": "居然临阵学习斗虫的技巧？可别把人看扁了啊！"
        },
        {
          "role": "「电气鞘翅」",
          "text": "那就别废话了，拿出你们的鬼兜虫，让我看看你们的斤两吧！"
        },
        {
          "type": "subtitle",
          "text": "◆击败「电气鞘翅」"
        },
        {
          "type": "subtitle",
          "text": "◆与「花角玉将」对话"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，轻轻松松！是我「破空白铁小堇瓜」派蒙赢啦！"
        },
        {
          "role": "阿晃&阿守",
          "text": "小堇瓜威武！！！"
        },
        {
          "role": "荒泷一斗",
          "text": "哦哟！哦哟哟！你还挺有天分嘛，白铁小堇瓜！狠狠地给了他们一个下马威！"
        },
        {
          "role": "荒泷一斗",
          "text": "待会儿奖励你一碗鸟蛋烧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，强！",
              "dialogues": []
            },
            {
              "text": "对手，逊！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「电气鞘翅」",
          "text": "「花角玉将」，我居然败给了一个新手…我愧对你！"
        },
        {
          "role": "「花角玉将」",
          "text": "放宽心，放宽心。看来对方找来的援军不是等闲之辈，我们也要让其他部将备甲上阵了。"
        },
        {
          "role": "「花角玉将」",
          "text": "「真剑斗虫大鬼王」，没想到你在如此之短的时间内就找来了可靠的将士，稳住了阵脚。"
        },
        {
          "role": "「花角玉将」",
          "text": "从今往后，我每天都会派遣一名部将，来到你们的主场掠阵。"
        },
        {
          "role": "「花角玉将」",
          "text": "你可要撑到最后啊，不然，你们荒泷派的战书就会成为斗虫界的笑柄哦…"
        },
        {
          "role": "荒泷一斗",
          "text": "喂喂喂，走什么呀？难不成是怕了！"
        },
        {
          "role": "荒泷一斗",
          "text": "突然出现又突然开溜，嘴上还嚣张得很，真让人恼火…"
        },
        {
          "role": "派蒙",
          "text": "听他的意思，「花角玉将」还会派出好几个部下来挑战我们，那岂不是再过不久就要开始对决了？"
        },
        {
          "role": "荒泷一斗",
          "text": "没错，看来我们的时间不够了，来不及把「极意堂堂斗虫大试合」办成荒泷派最盛大的活动了…"
        },
        {
          "role": "荒泷一斗",
          "text": "还好，相比热闹的气氛，现在本大爷更看重之后的对决！"
        },
        {
          "role": "荒泷一斗",
          "text": "刚才飞行矮…呃咳！刚才「破空白铁小堇瓜」打败劲敌，一战成名，看得本大爷斗志昂扬！"
        },
        {
          "role": "荒泷一斗",
          "text": "让本大爷想起了我还是个斗虫新手时，第一次向花见坂的强者发起挑战的情景…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "斗志倒是有了。",
              "dialogues": []
            },
            {
              "text": "可也还不算成名吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "难道说，放牛的也有刚刚学会斗虫，就打翻了某个老手的高光时刻？"
        },
        {
          "role": "阿晃",
          "text": "当时老大一败涂地…"
        },
        {
          "role": "阿守",
          "text": "就是因为当时被打败了，才会被白铁小堇瓜大人斗虫时的英姿打动吧。"
        },
        {
          "role": "荒泷一斗",
          "text": "不重要，那些事都不重要了！"
        },
        {
          "role": "荒泷一斗",
          "text": "接下来，「真剑斗虫大鬼王」，「破空白铁小堇瓜」，还有…「鬼王的左膀右臂」旅行者！"
        },
        {
          "role": "荒泷一斗",
          "text": "我们三人要团结一心，好好对付「花角玉将」和他的部众！"
        },
        {
          "role": "荒泷一斗",
          "text": "迎战每个对手之前，我们都要商量对策。只要我们获胜的次数比对方更多，「花角玉将」就必须亲自迎战我！"
        },
        {
          "role": "派蒙",
          "text": "总觉得进入正题的节奏有点快呢。"
        },
        {
          "role": "派蒙",
          "text": "但刚才斗虫的感觉还不错，而且帮放牛的赢过对方后，还有两月份的拉面，不如就专心一点，好好配合放牛的吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还没上场表演呢。",
              "dialogues": []
            },
            {
              "text": "我也要威风一回哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈哈哈哈！这才像话嘛！只要好好听本大爷指挥，拿出全力应战，绝对能把「花角玉将」打得落花流水！"
        },
        {
          "type": "subtitle",
          "text": "◆第一天至第五天剧情"
        },
        {
          "type": "subtitle",
          "text": "第一天派来的打手「怪力三十三」",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「怪力三十三」",
          "text": "荒泷派，我来和你们决斗了！"
        },
        {
          "role": "荒泷一斗",
          "text": "怎么回事？「花角玉将」那家伙又派了个小孩来出战？"
        },
        {
          "role": "荒泷一斗",
          "text": "该不会是人手不够了，想要草草应付我们了事吧！"
        },
        {
          "role": "「怪力三十三」",
          "text": "…你不重要。"
        },
        {
          "role": "「怪力三十三」",
          "text": "吵吵闹闹的人，一般都是杂鱼。"
        },
        {
          "role": "「怪力三十三」",
          "text": "这位金发的大哥哥/大姐姐很沉稳，有一股强者的气势。他才是你们荒泷派的老大吧？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿嘿，这位朋友的眼光很毒辣嘛！多夸旅行者几句！"
        },
        {
          "role": "荒泷一斗",
          "text": "啊？你在胡说八道什么！"
        },
        {
          "role": "荒泷一斗",
          "text": "我的挚友确实强得没边，但这次，他只是我们荒泷派的外援！帮派的名字写得清清楚楚，老大当然永远是我荒泷一斗了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我就给名字加上限时前缀。",
              "dialogues": []
            },
            {
              "text": "老大的位置借我坐几天？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦，荒泷派的实力先放在一边，当老大究竟是什么感觉呢？我也有点好奇了！"
        },
        {
          "role": "派蒙",
          "text": "如果你答应我们，我也可以是「荒泷（三天后到期）派蒙」，或者「荒泷派派蒙（临时老大）」！"
        },
        {
          "role": "荒泷一斗",
          "text": "喂喂喂！你们两个！不要被对手带偏了啊！她明显是…想让我们起内讧！她在耍阴谋！"
        },
        {
          "role": "荒泷一斗",
          "text": "等到本大爷战胜了她的老大，她就要为这番大话后悔，慌慌张张收回它了！"
        },
        {
          "role": "「怪力三十三」",
          "text": "拉倒吧…你们荒泷派内部的事，我可不关心，我只想和厉害的对手较量一番！"
        },
        {
          "role": "「怪力三十三」",
          "text": "先让我领教一下这位大哥哥/大姐姐的斗虫本领吧！"
        },
        {
          "type": "subtitle",
          "text": "战斗对话"
        },
        {
          "role": "派蒙",
          "text": "加油哦，旅行者！斗虫对你来说，肯定是小菜一碟啦！"
        },
        {
          "role": "荒泷一斗",
          "text": "对！我的挚友，记住我和白铁小堇瓜说的要点，抓准时机，打她个手忙脚乱！"
        },
        {
          "role": "「怪力三十三」",
          "text": "想得美，我可不会给你们躲闪的机会！"
        },
        {
          "role": "赢得「切磋」或「锐意」级挑战的胜利",
          "text": "居然连撞碎大石头的一击都能挡下？好强！"
        },
        {
          "role": "赢得「狂热」级挑战的胜利",
          "text": "我的鬼兜虫明明使出了全力，还是赢不过吗…"
        },
        {
          "type": "subtitle",
          "text": "第二天派来的打手「金龟奇术番长」",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「金龟奇术番长」",
          "text": "不严谨，不优雅，不精彩，不奇妙，什么都不搭。"
        },
        {
          "role": "荒泷一斗",
          "text": "你在神神叨叨什么，评价你那些败下阵来的同伴吗？"
        },
        {
          "role": "「金龟奇术番长」",
          "text": "……"
        },
        {
          "role": "「金龟奇术番长」",
          "text": "说的是你们斗虫的风格。"
        },
        {
          "role": "荒泷一斗",
          "text": "啊？你的脑袋被漂浮灵砸过吗？本大爷又不是来表演节目的！本大爷讲究的是热血、强劲和势不可当！你要来领教一下吗？"
        },
        {
          "role": "「金龟奇术番长」",
          "text": "想起了不好的回忆…我不能和你这种大大咧咧的家伙对阵。"
        },
        {
          "role": "「金龟奇术番长」",
          "text": "唔，这位金发的先生/小姐看起来很好对付…决定了！我要挑战他！"
        },
        {
          "role": "荒泷一斗",
          "text": "噗…哈哈哈哈哈哈哈！"
        },
        {
          "role": "荒泷一斗",
          "text": "我的挚友，听见了吗？他说你好对付！你快来好好招待这家伙！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哈哈，我就不客气啦！",
              "dialogues": []
            },
            {
              "text": "呜呜，请不要欺负我…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "真是让人看不懂呢，这些人根本就没有收集对手的情报嘛，一个接一个地过来送战果。"
        },
        {
          "role": "派蒙",
          "text": "「花角玉将」的团队简直就像是散装的！策略这方面远远不如我们三个嘛！"
        },
        {
          "type": "subtitle",
          "text": "战斗对话"
        },
        {
          "role": "「金龟奇术番长」",
          "text": "鬼兜虫之间的决斗，理应表现得很有观赏性，甚至是艺术性。可你们好像并不理解…"
        },
        {
          "role": "派蒙",
          "text": "呃，有点矫情过头了啦。明明爽快和开心最重要！只强调观赏性，不就变成演戏了吗！"
        },
        {
          "role": "荒泷一斗",
          "text": "就是啊，白铁小堇瓜都明白这个道理！就让我的挚友来好好给你上一课吧！"
        },
        {
          "role": "赢得「切磋」或「锐意」级挑战的胜利",
          "text": "不合理，不对劲，不应如此啊！你们只是走运罢了！"
        },
        {
          "role": "赢得「狂热」级挑战的胜利",
          "text": "太狼狈，太落魄，太不中用了！我技不如人！"
        },
        {
          "type": "subtitle",
          "text": "第三天派来的打手「造笼师」",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「造笼师」",
          "text": "「破空白铁小堇瓜」！我来替「电气鞘翅」报仇了！准备好你的鬼兜虫吧！"
        },
        {
          "role": "「造笼师」",
          "text": "淘汰你以后，我会把荒泷派的成员挨个击败！"
        },
        {
          "role": "派蒙",
          "text": "噫…这次倒是个成年人，不过怎么比之前的孩子更起劲了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙不要怕。",
              "dialogues": []
            },
            {
              "text": "把他变成你的战果。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "白铁小堇瓜，人家点名要和你比拼了，你的气势可不能输给他。"
        },
        {
          "role": "荒泷一斗",
          "text": "带上「赤红一杵」，尽管放手去打吧！"
        },
        {
          "type": "subtitle",
          "text": "战斗对话"
        },
        {
          "role": "派蒙",
          "text": "开打开打！我「破空白铁小堇瓜」的第二战！"
        },
        {
          "role": "派蒙",
          "text": "不过…为什么对方的鬼兜虫都那么大呢？好像有点不公平…"
        },
        {
          "role": "荒泷一斗",
          "text": "不用在意！鬼兜虫太大的话，就会变得很笨重，远远不如我们的「赤红一杵」！"
        },
        {
          "role": "「造笼师」",
          "text": "你们那种羸弱的鬼兜虫…别说赢过我了，就算送给我，我都不愿意浪费一个虫笼来装它！"
        },
        {
          "role": "赢得「切磋」或「锐意」级挑战的胜利",
          "text": "当真失算了！没想到，你还挺有两手啊！"
        },
        {
          "role": "赢得「狂热」级挑战的胜利",
          "text": "果然，斗虫的强弱与年龄无关，看的是天分…我败得彻底！"
        },
        {
          "type": "subtitle",
          "text": "第四天派来的打手「千日喧哗大飞车」",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「千日喧哗大飞车」",
          "text": "你们三个，谁是老大？站出来面对我！"
        },
        {
          "role": "「千日喧哗大飞车」",
          "text": "我「千日喧哗大飞车」可是精锐中的精锐，代表「花角玉将」大人，来取你们荒泷派老大的首级！"
        },
        {
          "role": "派蒙",
          "text": "呜哇，好凶好凶！说话也好狠！这次好像真的来了个强人…"
        },
        {
          "role": "荒泷一斗",
          "text": "什么乱七八糟的！还有，你的称号里居然也用了「大」字，是想和本大爷抢风头吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "本大爷揍的就是你这种精锐！"
        },
        {
          "role": "「千日喧哗大飞车」",
          "text": "好，好高的男人，居然还是…鬼族！"
        },
        {
          "role": "「千日喧哗大飞车」",
          "text": "如此豪气飒爽的家伙，怎么会玩斗虫这种小孩喜欢的游戏…真是见了鬼了！"
        },
        {
          "role": "荒泷一斗",
          "text": "你说什么？你在小瞧斗虫吗？真是胆大包天！"
        },
        {
          "role": "荒泷一斗",
          "text": "根本不懂斗虫精髓的家伙，必须由热爱斗虫的人来修正！本大爷就好好教训你一回！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "教训他！教训他！",
              "dialogues": []
            },
            {
              "text": "修正他！修正他！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对对对，可不能让他一直这么嚣张！就看你的了，放牛的！"
        },
        {
          "role": "「千日喧哗大飞车」",
          "text": "没办法了…来就来，谁怕谁！"
        },
        {
          "type": "subtitle",
          "text": "战斗对话"
        },
        {
          "role": "派蒙",
          "text": "不准轻视斗虫哦，那个什么什么飞车！就算是我，现在也明白斗虫的乐趣了！"
        },
        {
          "role": "荒泷一斗",
          "text": "不止是乐趣，斗虫承载了大家对变强的向往，还有拼搏的精神！没法理解这一点的人，还来斗什么虫！"
        },
        {
          "role": "「千日喧哗大飞车」",
          "text": "啧！居然还有我吵不过的人…但只凭嘴皮子，在我这里可讨不到好处！"
        },
        {
          "role": "赢得「切磋」或「锐意」级挑战的胜利",
          "text": "啧！这下我的面子快要挂不住了…还不能退缩！"
        },
        {
          "role": "赢得「狂热」级挑战的胜利",
          "text": "好有气势的对手！这股豪情，让我输得心服口服！"
        },
        {
          "type": "subtitle",
          "text": "第五天与「花角玉将」对决",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "「花角玉将」",
          "text": "难能可贵，难能可贵！"
        },
        {
          "role": "「花角玉将」",
          "text": "真没想到，荒泷派居然能打败这么多斗虫强者。看来你们对斗虫也有着独特的理解…"
        },
        {
          "role": "「花角玉将」",
          "text": "我收回之前的成见。接下来，我会将你们当成值得尊敬的对手，全力和你们比试一场！"
        },
        {
          "role": "派蒙",
          "text": "放牛的，到你这个老大登场的时候啦！"
        },
        {
          "role": "派蒙",
          "text": "可别把之前的话当真！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "出阵吧，「真剑斗虫大鬼王」！",
              "dialogues": []
            },
            {
              "text": "大激斗，鬼王对玉将！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈哈哈，那是当然了！最后对决，也一定会是我赢！"
        },
        {
          "role": "荒泷一斗",
          "text": "虽然不知道你到底是怎么指导部下的，但结果已经没有悬念了，是本大爷的荒泷派更胜一筹！"
        },
        {
          "role": "荒泷一斗",
          "text": "准备接招吧！「花角玉将」！"
        },
        {
          "type": "subtitle",
          "text": "战斗对话"
        },
        {
          "role": "「花角玉将」",
          "text": "不会错…经历了这么多磨砺后，你们的「赤红一杵」也进步了。至少在气势上，远远凌驾于打败「电气鞘翅」的那时候。"
        },
        {
          "role": "荒泷一斗",
          "text": "哟？你还挺有眼光嘛！主要的功劳，当然还是本大爷在指挥！"
        },
        {
          "role": "赢得「切磋」或「锐意」级挑战的胜利",
          "text": "有一手！你的打法给了我莫大的惊喜，但我还没拿出全力！"
        },
        {
          "role": "赢得「狂热」级挑战的胜利",
          "text": "哈哈哈！不错不错！我们之间的战斗快要触及斗虫的绝境了，再来再来！"
        }
