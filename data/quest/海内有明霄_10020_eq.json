{
  "quest_id": 10020,
  "chapter_num": "海灯节 其三",
  "chapter_title": "海内有明霄",
  "type": "eq",
  "route": "Light Upon the Sea",
  "stories": [
    {
      "story_id": 41313,
      "title": "海内有明霄",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "海灯节仍在继续，而你在魈、凯亚和千岩军的帮助下，挫败了一场让人啼笑皆非的「阴谋」，也将策划了这场「阴谋」的笨贼抓获，交给了千岩军处置。 今天，你准备按照约定去望舒客栈向魈回报这件事的情况…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "回望舒客栈向魈回报"
        },
        {
          "type": "subtitle",
          "text": "与魈对话"
        },
        {
          "role": "魈",
          "text": "如何，事情了结了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经了结了，但是…"
        },
        {
          "role": "魈",
          "text": "如此就好。"
        },
        {
          "role": "旅行者",
          "text": "真的不去看明霄灯吗？"
        },
        {
          "role": "魈",
          "text": "不去。我说过了，不喜欢人来人往之处，尤其是每年的这几天里。"
        },
        {
          "role": "旅行者",
          "text": "今年的明霄灯是「移霄导天真君」。"
        },
        {
          "role": "派蒙",
          "text": "对，是一只看上去很神气很神气的鹿哦，我们一起去看看吧？"
        },
        {
          "role": "魈",
          "text": "「移霄导天真君」…"
        },
        {
          "role": "魈",
          "text": "但终究只是座霄灯罢了，人造的死物，无趣。"
        },
        {
          "role": "魈",
          "text": "你们自去城里，看个热闹就是。"
        },
        {
          "type": "subtitle",
          "text": "与菲尔戈黛特对话"
        },
        {
          "role": "菲尔戈黛特",
          "text": "看来，你们又和魈一起办了件大事啊。"
        },
        {
          "role": "淮安",
          "text": "动静可不小啊，我们在这里都听说了。"
        },
        {
          "role": "菲尔戈黛特",
          "text": "不过，眼看着今年的海灯节又要结束了，他还是没去看看…"
        },
        {
          "role": "淮安",
          "text": "嗨…这么多年了，我就没见过那位去过海灯节。"
        },
        {
          "role": "淮安",
          "text": "要我说，你就是让我把海灯节给搬过来，都比请那位去海灯节要容易…"
        },
        {
          "role": "派蒙",
          "text": "把海灯节给…搬过来…"
        },
        {
          "role": "旅行者",
          "text": "好主意。"
        },
        {
          "role": "派蒙",
          "text": "对啊！既然魈不去海灯节，那我们就把海灯节搬过来给他好了！"
        },
        {
          "role": "淮安",
          "text": "嗯？这玩笑话…如何当真？要怎么「搬过来」？"
        },
        {
          "role": "派蒙",
          "text": "在逛海灯节的时候，我们学了怎么编「霄灯」，还找到了一个卖特色小吃的摊子…"
        },
        {
          "role": "派蒙",
          "text": "很多好吃的，漂亮的霄灯，还有…嗯…过往的英雄，和他以前的好朋友们。"
        },
        {
          "role": "派蒙",
          "text": "这不就是海灯节的全部吗？"
        },
        {
          "role": "菲尔戈黛特",
          "text": "这么说倒也没错，可是要在哪里布置才好…"
        },
        {
          "role": "淮安",
          "text": "要这么说的话，那我寻思着，地方得宽敞点，还得搭个摊子才行，嗯…客栈底下也许还有点空间。"
        },
        {
          "role": "淮安",
          "text": "我们一起去下面选个地方吧。我大概知道你们想要个什么样的摊子了…"
        },
        {
          "role": "淮安",
          "text": "唔…应该有些样式可以参考的，我想想…"
        },
        {
          "type": "subtitle",
          "text": "寻找放置小摊的合适地点"
        },
        {
          "type": "subtitle",
          "text": "继续寻找合适地点"
        },
        {
          "type": "subtitle",
          "text": "继续寻找合适地点"
        },
        {
          "type": "subtitle",
          "text": "与淮安对话"
        },
        {
          "role": "淮安",
          "text": "这里还不错，嗯…也很僻静，很合适。"
        },
        {
          "role": "淮安",
          "text": "那就这里了，我刚才寻思了寻思，也想好怎么建你们要的那种小摊了。"
        },
        {
          "role": "淮安",
          "text": "你们稍等啊，我看看，该从哪先开始…"
        },
        {
          "role": "淮安",
          "text": "成了，差不多就是这样了，你们看看。"
        },
        {
          "role": "旅行者",
          "text": "掌柜的，你这木工…"
        },
        {
          "role": "淮安",
          "text": "哎呀，一点点小手艺，不值一提，很多年前学的，我都忘得差不多了。"
        },
        {
          "role": "淮安",
          "text": "这下子摊子有了，我还顺便在上面摆了点「霄灯」，看着还不错吧？"
        },
        {
          "role": "旅行者",
          "text": "编霄灯你也会？"
        },
        {
          "role": "淮安",
          "text": "哎呀，我这个年纪的璃月人，基本上都会编霄灯。"
        },
        {
          "role": "淮安",
          "text": "对了，大过节的…请客总得吃点好的吧，你们想好请那位吃什么了吗？"
        },
        {
          "role": "派蒙",
          "text": "吃…「杏仁豆腐」！我们之前请魈吃过的！"
        },
        {
          "role": "旅行者",
          "text": "还有「烤吃虎鱼」。"
        },
        {
          "role": "淮安",
          "text": "「杏仁豆腐」和「烤吃虎鱼」是吧…行，没问题，我这就让言笑去准备去。"
        },
        {
          "role": "淮安",
          "text": "正好客栈里备着材料，这么几道小菜，他应该很快就能做完。"
        },
        {
          "role": "淮安",
          "text": "那你们先上去请那位下来吧，你们下来的时候，菜应该就已经做好了。"
        },
        {
          "type": "subtitle",
          "text": "与魈对话"
        },
        {
          "role": "魈",
          "text": "还有何事？"
        },
        {
          "role": "旅行者",
          "text": "想请你一起去海灯节。"
        },
        {
          "role": "魈",
          "text": "…我不喜欢人来人往的地方，你自己去游玩就好。"
        },
        {
          "role": "旅行者",
          "text": "不用你去璃月港。"
        },
        {
          "role": "魈",
          "text": "…什么意思？"
        },
        {
          "role": "旅行者",
          "text": "我把海灯节搬过来了。"
        },
        {
          "role": "魈",
          "text": "「搬过来」？"
        },
        {
          "role": "派蒙",
          "text": "哎呀，就是在客栈下面摆了好多好吃的，好多霄灯，周围也没有多少人。"
        },
        {
          "role": "旅行者",
          "text": "还准备了「杏仁豆腐」和「烤吃虎鱼」…"
        },
        {
          "role": "派蒙",
          "text": "我们快点下去吧，不然菜都要凉啦！"
        },
        {
          "type": "subtitle",
          "text": "与魈一起用餐"
        },
        {
          "role": "淮安",
          "text": "怎么样，言笑的手艺还不错吧？吃好了就快进城去吧，我估摸着，也差不多要到放「明霄灯」的时候了。"
        },
        {
          "role": "菲尔戈黛特",
          "text": "你居然还真把他给请下来了，这么多年了，我还是第一次看见他这个模样…"
        },
        {
          "role": "派蒙",
          "text": "怎么样，我们给你搬过来的海灯节看上去是不是很好吃？"
        },
        {
          "role": "魈",
          "text": "这就是你们搬来的海灯节？人类的行为，非要如此怪异吗？"
        },
        {
          "role": "魈",
          "text": "你们做这些事，意义何在？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：为了让你参加一次海灯节。",
              "dialogues": [
                {
                  "role": "魈",
                  "text": "…是这样吗？人的心思真是难以揣测。"
                }
              ]
            },
            {
              "text": "旅行者：海灯节是所有人的节日。",
              "dialogues": [
                {
                  "role": "魈",
                  "text": "…是这样吗？人的心思真是难以揣测。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你们别光顾着说话了，快点吃东西吧，不然菜都要凉了。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我先开始吃啦！"
        },
        {
          "role": "派蒙",
          "text": "好啦，东西也吃好了，应该是去看「明霄灯」的时候啦。"
        },
        {
          "role": "旅行者",
          "text": "魈也一起去吧。"
        },
        {
          "role": "魈",
          "text": "你们去吧，我对那些东西不感兴趣。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：不然，你送送我们也行。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对啊，就算你不想去看「明霄灯」，那…那你送我们过去总可以吧。"
                }
              ]
            },
            {
              "text": "旅行者：拜托了，护法夜叉大人。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对啊，就算你不想去看「明霄灯」，那…那你送我们过去总可以吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "从这里去璃月港很远喔，野外也很危险的…对吧，很危险的！"
        },
        {
          "role": "派蒙",
          "text": "不用送我们进城啦，只…需要送到城外就好了。"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "魈",
          "text": "…呼。"
        },
        {
          "role": "魈",
          "text": "那好，我送你们到城外。"
        },
        {
          "role": "派蒙",
          "text": "没问题！我们这就出发吧 ！"
        },
        {
          "type": "subtitle",
          "text": "前往璃月港"
        },
        {
          "type": "subtitle",
          "text": "与魈对话"
        },
        {
          "role": "魈",
          "text": "到这里为止吧。我就不陪你们进城了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：等一下。",
              "dialogues": [
                {
                  "role": "魈",
                  "text": "还有什么事？"
                }
              ]
            },
            {
              "text": "旅行者：（…算了，在这里就能看到。）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "明明海灯节纪念的英雄里也包括你…为什么你却不想去看灯呢？"
        },
        {
          "role": "魈",
          "text": "我…不喜欢人群。"
        },
        {
          "role": "魈",
          "text": "无忧无虑的，安详的人群…我和他们不一样。"
        },
        {
          "role": "魈",
          "text": "我和杀戮并存太久，已经习惯了那种苦行。和幸福的人一起，只会让我…"
        },
        {
          "role": "魈",
          "text": "…这个话题到此为止吧。"
        },
        {
          "role": "魈",
          "text": "再会。"
        },
        {
          "role": "旅行者",
          "text": "真的不和我一起看灯吗？"
        },
        {
          "role": "魈",
          "text": "你这么喜欢凑热闹？"
        },
        {
          "role": "旅行者",
          "text": "你猜猜看。"
        },
        {
          "role": "派蒙",
          "text": "喂！这都是正当娱乐活动，不要说是凑热闹呀！"
        },
        {
          "role": "魈",
          "text": "…正当的…"
        },
        {
          "role": "魈",
          "text": "罢了。去看你的灯吧。"
        },
        {
          "role": "魈",
          "text": "但注意安全。遇到任何危险，就直呼我名吧。"
        },
        {
          "role": "旅行者",
          "text": "你又不在城里，赶得过来吗？"
        },
        {
          "role": "魈",
          "text": "随时随地。"
        },
        {
          "role": "魈",
          "text": "不论是你，还是璃月。所有的灯火，所有祈求平安的愿望，我都已经听到了。"
        },
        {
          "type": "subtitle",
          "text": "回到璃月港"
        }
      ]
    }
  ]
}