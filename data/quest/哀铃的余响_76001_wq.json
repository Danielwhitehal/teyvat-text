{
  "quest_id": 76001,
  "chapter_num": null,
  "chapter_title": "哀铃的余响",
  "type": "wq",
  "route": "The Bell of Mourning Echoes",
  "stories": [
    {
      "story_id": 76001,
      "title": "哀铃的余响",
      "description": "漫步黑渊的战士仍在履行尚未完成的誓约…",
      "dialogues": [
        {
          "role": "卢什涅",
          "text": "拜托了。"
        },
        {
          "role": "派蒙",
          "text": "欸？这是什么？是刚才那个奇怪的人的东西吗…"
        },
        {
          "role": "查看",
          "text": "「为了家园与炉火。」"
        },
        {
          "role": "旅行者",
          "text": "（交还装备。）"
        },
        {
          "role": "苏霍维赫",
          "text": "劳烦两位将遗物带去伦波岛东的战场遗址，带去他的墓前吧。愿他的灵魂得以安息的那一日尽早到来…"
        },
        {
          "role": "派蒙",
          "text": "说起来，看他的打扮应该是执灯人…曾经是执灯人吧。"
        },
        {
          "role": "派蒙",
          "text": "那夏镇也有执灯人呢，要不找他们问问？说不定他们会知道些什么。"
        },
        {
          "type": "subtitle",
          "text": "前往那夏镇，寻找执灯人了解情况"
        },
        {
          "role": "查看",
          "text": "…有狂猎的气息…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你听到了吗？这声音难道是…"
        },
        {
          "role": "查看",
          "text": "…你是追猎狂猎之人，还是它们之中的一员？…"
        },
        {
          "role": "派蒙",
          "text": "打扰一下！有件事想问问两位…"
        },
        {
          "role": "？？？",
          "text": "向两位执灯士出示了此前得到的物件，并讲述了与身着执灯人服饰的怪人并肩作战，击退狂猎的事…"
        },
        {
          "role": "卢什涅",
          "text": "难道是西格德？他…直到现在也无法安息啊，要是我能更加…"
        },
        {
          "role": "苏霍维赫",
          "text": "别这么说，这不是你一个人的责任。只要狂猎尚存，他就不会停止战斗…我们所能做的，只有尽力完成自己的使命而已。"
        },
        {
          "role": "派蒙",
          "text": "所以西格德他也曾经是执灯人的一员，对吧？"
        },
        {
          "role": "苏霍维赫",
          "text": "是的，他是了不起的执灯长。在狂猎的大军席卷挪德卡莱时，他英勇地战斗到了最后一刻。"
        },
        {
          "role": "苏霍维赫",
          "text": "据说警铃响起时，失却了心智的魔物就像是为之胆寒一样，不敢贸然向前…没想到他的遗物会被两位找到。"
        },
        {
          "role": "苏霍维赫",
          "text": "如果可以的话，请两位将遗物带去伦波岛东的战场遗址，带去他的墓前。"
        },
        {
          "role": "旅行者",
          "text": "放心交给我们吧。"
        },
        {
          "role": "苏霍维赫",
          "text": "感谢。愿他的灵魂得以安息的那一日尽早到来…"
        },
        {
          "type": "subtitle",
          "text": "将遗物交还至西格德的墓前"
        },
        {
          "type": "subtitle",
          "text": "将遗物交还至西格德的墓前"
        },
        {
          "role": "旅行者",
          "text": "（做好准备…）"
        },
        {
          "role": "旅行者",
          "text": "（暂时离去。）"
        }
      ]
    }
  ]
}