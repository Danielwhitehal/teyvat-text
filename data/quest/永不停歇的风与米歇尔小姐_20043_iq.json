{
  "quest_id": 20043,
  "chapter_num": null,
  "chapter_title": "永不停歇的风与米歇尔小姐",
  "type": "iq",
  "route": "Michelle Never Stops!",
  "stories": [
    {
      "story_id": 20043,
      "title": "永不停歇的风与米歇尔小姐",
      "description": "米歇尔小姐正在去工作的路上，但看起来她已经很疲惫了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与米歇尔小姐对话"
        },
        {
          "role": "米歇尔",
          "text": "腰怎么这么痛…"
        },
        {
          "role": "旅行者",
          "text": "你怎么了？"
        },
        {
          "role": "米歇尔",
          "text": "我正准备去工作，但是突然腰很痛。"
        },
        {
          "role": "米歇尔",
          "text": "我已经和昆恩约好去他的水果摊帮忙，现在只能休息一下再去了…"
        },
        {
          "role": "米歇尔",
          "text": "唉，但是光待在这里也只是耽误事。"
        },
        {
          "role": "米歇尔",
          "text": "你能帮我去问问昆恩，他需要我做什么工作吗？我也好做些准备。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "米歇尔",
                  "text": "那就拜托你了，我只要休息一会就好。"
                }
              ]
            },
            {
              "text": "这看着不远…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂，这么点小事，帮个忙也没关系吧！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与昆恩对话"
        },
        {
          "role": "米歇尔",
          "text": "腰好痛…应该休息一下就好了吧…"
        },
        {
          "role": "昆恩",
          "text": "怎么还没送来，糟糕了…"
        },
        {
          "role": "旅行者",
          "text": "发生什么了？"
        },
        {
          "role": "昆恩",
          "text": "啊…摊子里的日落果卖光了，我刚去订了几批日落果。"
        },
        {
          "role": "昆恩",
          "text": "但是到现在也没送来…好多客人都在等着买呢。"
        },
        {
          "role": "昆恩",
          "text": "光是优律小姐就来了三趟了，她就只要<color=#00E1FFFF>三颗日落果</color>，我可不想失去这个老顾客啊！"
        },
        {
          "role": "昆恩",
          "text": "我还要看摊子…要是谁能帮我去城外找点日落果回来就好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很急的话，我能帮忙。",
              "dialogues": [
                {
                  "role": "昆恩",
                  "text": "你愿意帮忙吗？那太好了，就拜托你了！"
                }
              ]
            },
            {
              "text": "米歇尔小姐马上就来…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "等一下！米歇尔小姐那个样子，怎么出去摘果子啊！"
                },
                {
                  "role": "派蒙",
                  "text": "我们来帮忙吧！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "收集日落果"
        },
        {
          "type": "subtitle",
          "text": "将日落果交给昆恩"
        },
        {
          "role": "昆恩",
          "text": "你找到<color=#00E1FFFF>日落果</color>了吗？"
        },
        {
          "role": "旅行者",
          "text": "还没有。"
        },
        {
          "role": "昆恩",
          "text": "拜托你了，城外应该有很多<color=#00E1FFFF>日落果</color>，我要看着摊子，请快去快回啊！"
        },
        {
          "role": "昆恩",
          "text": "你找到日落果了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经找好了。"
        },
        {
          "role": "昆恩",
          "text": "谢谢，这些应该就够优律小姐买了。"
        },
        {
          "role": "昆恩",
          "text": "唉，但是很多客人们还是走掉了，一个人果然还是忙不过来啊。"
        },
        {
          "role": "昆恩",
          "text": "哦对了，谢谢你们帮忙，要给你们谢礼才行，稍等一下…"
        },
        {
          "role": "派蒙",
          "text": "谢礼就不用了，我们有事情拜托你…"
        },
        {
          "role": "旅行者",
          "text": "关于米歇尔小姐…"
        },
        {
          "role": "昆恩",
          "text": "米歇尔小姐…你们遇见她了吗？"
        },
        {
          "role": "昆恩",
          "text": "希望我交给她一点轻松的工作？"
        },
        {
          "role": "昆恩",
          "text": "可我一开始就只准备让她帮忙看店啊。"
        },
        {
          "role": "派蒙",
          "text": "是，是这样吗？"
        },
        {
          "role": "昆恩",
          "text": "不过现在客人们都走了，看来是不用人看店了…"
        },
        {
          "role": "昆恩",
          "text": "麻烦你们告诉米歇尔小姐，让她回去休息吧。"
        },
        {
          "role": "昆恩",
          "text": "我等会准备去看看那批货到底怎么回事…"
        },
        {
          "type": "subtitle",
          "text": "与米歇尔小姐对话"
        },
        {
          "role": "米歇尔",
          "text": "你们问昆恩先生了吗？"
        },
        {
          "role": "旅行者",
          "text": "昆恩先生请你回去休息。"
        },
        {
          "role": "派蒙",
          "text": "昆恩先生的店里今天没有什么工作喔，请回去好好休息吧！"
        },
        {
          "role": "米歇尔",
          "text": "是吗，呼…看来要去找别的事做了呢。"
        },
        {
          "role": "派蒙",
          "text": "咦，咦？！你不去休息吗？好不容易不用工作了…"
        },
        {
          "role": "米歇尔",
          "text": "你们感受一下四周，巴巴托斯大人的风还在勤劳地工作着。"
        },
        {
          "role": "米歇尔",
          "text": "我们这些被他庇佑着的人，也没有偷懒的道理。"
        },
        {
          "role": "米歇尔",
          "text": "不过，你是去做什么事了，怎么出了这么多汗？"
        },
        {
          "role": "米歇尔",
          "text": "看来你也是个忙碌的人呢。不过这样也好，借助着辛勤的汗水，才能更清晰地感受到巴巴托斯大人的风。"
        },
        {
          "role": "米歇尔",
          "text": "来，这瓶牛奶给你，快点喝掉，然后继续加油吧，工作可是永无止境的。"
        }
      ]
    }
  ]
}