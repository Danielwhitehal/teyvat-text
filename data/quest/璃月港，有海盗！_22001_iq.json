{
  "quest_id": 22001,
  "chapter_num": null,
  "chapter_title": "璃月港，有海盗！",
  "type": "iq",
  "route": "Pirate Invasion, in Liyue Harbor!",
  "stories": [
    {
      "story_id": 22001,
      "title": "璃月港，有海盗！",
      "description": "有一群孩子想要玩一场海盗游戏…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与璐璐、阿飞、小蒙对话"
        },
        {
          "role": "阿飞",
          "text": "小蒙，今天总轮到我做船长了吧？"
        },
        {
          "role": "小蒙",
          "text": "璐璐，我已经连着好几天做船长了，也该阿飞扮了…"
        },
        {
          "role": "璐璐",
          "text": "可我觉得小蒙的船长扮得很好呀，我想你接着做船长。"
        },
        {
          "role": "旅行者",
          "text": "你们在做什么？"
        },
        {
          "role": "阿飞",
          "text": "大哥哥，我们在玩游戏。本来说好了这次轮到我做船长…"
        },
        {
          "role": "阿飞",
          "text": "可璐璐总是说，小蒙扮船长的时候更好玩。"
        },
        {
          "role": "阿飞",
          "text": "唉，璐璐总是这样…不过，她觉得这样好的话，那就这样吧。"
        },
        {
          "role": "阿飞",
          "text": "大哥哥，你有空再扮一次海盗吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧…",
              "dialogues": [
                {
                  "role": "阿飞",
                  "text": "结果，我这次还是个服务生。"
                }
              ]
            },
            {
              "text": "我想做个好人。",
              "dialogues": [
                {
                  "role": "阿飞",
                  "text": "哎呀，我还想做船长呢…"
                }
              ]
            }
          ]
        },
        {
          "role": "阿飞",
          "text": "就和上次一样，大哥哥准备好了之后，就过来吧。"
        },
        {
          "type": "subtitle",
          "text": "与「服务生」阿飞对话"
        },
        {
          "role": "阿飞",
          "text": "你准备好了吗？"
        },
        {
          "role": "旅行者",
          "text": "准备好了。"
        },
        {
          "role": "阿飞",
          "text": "行吧，那就开始。"
        },
        {
          "role": "阿飞",
          "text": "真是的，当服务生有什么好玩的。"
        },
        {
          "role": "阿飞",
          "text": "璐璐和小蒙就知道自己玩开心…"
        },
        {
          "role": "旅行者",
          "text": "那个，抢劫…"
        },
        {
          "role": "阿飞",
          "text": "海盗吗？对不起，我这个穷服务生没有什么东西给你抢。"
        },
        {
          "role": "阿飞",
          "text": "哼，如果想抢的话，去找个更有钱的人…等等。"
        },
        {
          "role": "阿飞",
          "text": "喂！你们是来抢劫的吧，船长很有钱，你们可以去抢他！"
        },
        {
          "role": "派蒙",
          "text": "咦，咦？！你不是这艘船上的服务生吗？"
        },
        {
          "role": "阿飞",
          "text": "是啊，所以我知道船长在哪。"
        },
        {
          "role": "阿飞",
          "text": "哼，不就是个船长吗？有什么了不起的…"
        },
        {
          "role": "阿飞",
          "text": "走，我带你们去找船长！"
        },
        {
          "type": "subtitle",
          "text": "跟随阿飞找到船长"
        },
        {
          "role": "阿飞",
          "text": "就是这！船长在这了，大哥哥！"
        },
        {
          "role": "小蒙",
          "text": "你怎么把海盗带过来了啊！你不是应该带着海盗到处绕圈，然后我带着璐璐跑掉吗？"
        },
        {
          "role": "阿飞",
          "text": "凭什么你陪着璐璐跑，我就要在这拖住海盗？"
        },
        {
          "role": "阿飞",
          "text": "那我直接把你交给海盗，我不是一样可以带着璐璐跑吗？"
        },
        {
          "role": "小蒙",
          "text": "你…北斗姐姐说了，不可以随便出卖朋友！"
        },
        {
          "role": "阿飞",
          "text": "那北斗姐姐说船长就应该带着人跑吗？！"
        },
        {
          "role": "小蒙",
          "text": "你…我再也不把莲蓬分给你吃了！"
        },
        {
          "role": "阿飞",
          "text": "不吃就不吃！谁稀罕似的！"
        },
        {
          "role": "派蒙",
          "text": "他们怎么就吵起来了…"
        },
        {
          "role": "璐璐",
          "text": "大哥哥，不用担心，我有办法。"
        },
        {
          "role": "璐璐",
          "text": "他们最喜欢吃莲蓬了，有好吃的东西，他们绝对会安静下来的。"
        },
        {
          "role": "璐璐",
          "text": "你能帮我去找点莲蓬回来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好的。",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "谢谢大哥哥，请快去快回呀。"
                }
              ]
            },
            {
              "text": "他们最喜欢的应该不是莲蓬…",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "唔…大哥哥在说什么呢？那他们最喜欢什么呢？"
                },
                {
                  "role": "璐璐",
                  "text": "总之，请先找点莲蓬来吧，总不能让他们总是这么吵呀。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与「船长」小蒙对话"
        },
        {
          "type": "subtitle",
          "text": "找到莲蓬"
        },
        {
          "type": "subtitle",
          "text": "安抚小蒙和阿飞"
        },
        {
          "role": "璐璐",
          "text": "大哥哥，你找到莲蓬了吗？"
        },
        {
          "role": "？？？",
          "text": "找到了。"
        },
        {
          "role": "阿飞",
          "text": "你…！"
        },
        {
          "role": "小蒙",
          "text": "你…！"
        },
        {
          "role": "璐璐",
          "text": "你们别吵了，吵了这么久不累吗？"
        },
        {
          "role": "璐璐",
          "text": "只是玩个游戏，别这么生气，大家都是朋友呀。"
        },
        {
          "role": "璐璐",
          "text": "喏，新摘的莲蓬，快点吃吧。"
        },
        {
          "role": "璐璐",
          "text": "吃完了之后，我们再好好商量一下。"
        },
        {
          "role": "璐璐",
          "text": "排好谁做船长，谁做服务员的顺序，不就好了吗？"
        },
        {
          "role": "小蒙",
          "text": "好吧…"
        },
        {
          "role": "阿飞",
          "text": "嗯…"
        },
        {
          "role": "派蒙",
          "text": "真的安静下来了…"
        },
        {
          "role": "璐璐",
          "text": "怎么样，我就说吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你怎么知道要这么做？",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "我们一起玩了很久，我当然知道啦。"
                }
              ]
            },
            {
              "text": "璐璐真厉害…",
              "dialogues": [
                {
                  "role": "璐璐",
                  "text": "谢谢大哥哥，北斗姐姐才厉害呢。"
                },
                {
                  "role": "璐璐",
                  "text": "我长大之后，也能成为她那样的人吗…"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}