{
  "quest_id": 70555,
  "chapter_num": null,
  "chapter_title": "特调佳作，列为经典",
  "type": "wq",
  "route": "A Special Blend, A Timeless Masterpiece",
  "stories": [
    {
      "story_id": 70555,
      "title": "特调佳作，列为经典",
      "description": "运营调饮小站一段时间后，你的作品广受好评，即将成为新的经典…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与法尔伽等人对话"
        },
        {
          "role": "派蒙",
          "text": "旅行者，收工啦？"
        },
        {
          "role": "派蒙",
          "text": "听说，在我跟着格兰菲狄小姐捣鼓外送订单的时候，你把事情办得超漂亮嘛！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这次我的灵感很多哦…",
              "dialogues": []
            },
            {
              "text": "和大家聊天找到了点子…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "法尔伽",
          "text": "…总之，荣誉骑士是目前蒙德最有才华的调饮师之一。"
        },
        {
          "role": "法尔伽",
          "text": "考虑到从业时间，我觉得，他甚至有潜力追上猫尾酒馆的那位小小传说。"
        },
        {
          "role": "格兰菲狄",
          "text": "我无条件支持这个决策，大团长，这段时间实在有劳荣誉骑士了。"
        },
        {
          "role": "格兰菲狄",
          "text": "饮品小站还会营业一段时间，确保做好迎接远征队员的万全准备。找到合适的店面后，还会试点常态开放…"
        },
        {
          "role": "派蒙",
          "text": "好欸！骑士团的大家都要有美味饮料喝了！"
        },
        {
          "role": "法尔伽",
          "text": "不愧是赫塔的亲传弟子，格兰菲狄考虑得很周到！"
        },
        {
          "role": "格兰菲狄",
          "text": "还有，荣誉骑士开发的新品特调…如果您不介意，要留下配方，将它们作为正式饮品，加入小站的清单吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "完全没关系，大家一起喝！",
              "dialogues": []
            },
            {
              "text": "介意的话…好像有点小气？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…嗯…感觉旅行者好像还有什么愿望没有说…我来猜猜看？"
        },
        {
          "role": "派蒙",
          "text": "以你的性格，应该会要求…标注每一杯特调的来历！"
        },
        {
          "role": "派蒙",
          "text": "让客人们知道，你是为了谁，受了谁的启发，才完成了这些厉害的作品！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "完全正确！派蒙最懂我！",
              "dialogues": []
            },
            {
              "text": "这一点对大家都很重要！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "格兰菲狄",
          "text": "没有任何问题！如果你们还有需求，我可以请专人拟定文书，申请这些特调的专利。"
        },
        {
          "role": "法尔伽",
          "text": "哈哈哈哈，希望以后新招募的酒保，也能领会我们荣誉骑士的奇妙手法…"
        },
        {
          "role": "法尔伽",
          "text": "不说调出旗鼓相当的杰作，还原荣誉骑士的七成功力，就算顶尖高手！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（格兰菲狄）"
        },
        {
          "role": "格兰菲狄",
          "text": "万分感谢两位长官！接下来，饮品小站就由我们继续运营下去，请你们放心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要加油喔。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对对对，加油呀格兰菲狄小姐！"
        },
        {
          "role": "派蒙",
          "text": "以后你就是…「勤劳调饮骑士」了，下次见面的时候，你的技术肯定会变得更厉害！"
        },
        {
          "role": "格兰菲狄",
          "text": "很棒的称号…我将以此为荣！"
        }
      ],
      "collapse_ranges": [
        [
          19,
          24
        ]
      ]
    }
  ]
}