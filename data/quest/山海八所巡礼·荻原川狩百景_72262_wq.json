{
  "quest_id": 72262,
  "chapter_num": null,
  "chapter_title": "山海八所巡礼·荻原川狩百景",
  "type": "wq",
  "route": "Eight Locales Over Mountains and Seas: One Hundred Sights of Dihua",
  "stories": [
    {
      "story_id": 72262,
      "title": "山海八所巡礼·荻原川狩百景",
      "description": "之前答应了五百藏「带吉法师去外面修行」的请求。这回就去荻花洲看看璃月独有的水景吧。",
      "dialogues": [
         {
          "type": "subtitle",
          "text": "前往能望到荻花洲的地方"
        },
        {
          "role": "「吉法师」",
          "text": "哇。这里的大海，漂亮。"
        },
        {
          "role": "派蒙",
          "text": "欸？荻花洲不是大海啦。"
        },
        {
          "role": "旅行者",
          "text": "但荻花洲的水域确实和海连在一起…"
        },
        {
          "role": "派蒙",
          "text": "嗯，说得也是…不过，如果要说荻花洲是海，感觉还是不对。"
        },
        {
          "role": "「吉法师」",
          "text": "呶…不是很明白。「大海」和「不是大海」，区别是什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "水的味道？",
              "dialogues": [
                {
          "role": "「吉法师」",
          "text": "喔！森林的溪水有点甜味，所以不是海。"
        },
        {
          "role": "派蒙",
          "text": "但是，如果果酒湖里都是果酒的话，应该算什么呢…？"
        },
        {
          "role": "旅行者",
          "text": "那样的话温迪会很快乐吧。"
        }
              ]
            },
            {
              "text": "陆地主体之外的大型水域是海？",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "哇，听起来好严谨的答案！但是，这样的话，问题又回到了「分界」上呢。"
        },
        {
          "role": "「吉法师」",
          "text": "旅行者刚刚说，荻花洲的水和大海连在一起。那「陆地煮煮」和不是「陆地煮煮」，区别又是什么哩？"
        },
        {
          "role": "派蒙",
          "text": "…虽然听起来严谨，却没有解决任何问题呢！"
        }
              ]
            },
            {
              "text": "这些概念都是人强加的。没有意义。",
              "dialogues": [
                {
          "role": "旅行者",
          "text": "荻花洲觉得自己是大海，就是大海。"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师觉得自己是仙人，就是仙人呶？"
        },
                {
          "role": "派蒙",
          "text": "喂！吉法师别听的。旅行者，你在说什么呀…"
        },
        
        {
          "role": "派蒙",
          "text": "…不过，虽然是歪理，也不是完全没道理啦。吉法师想成为什么样的妖狸，就能成为什么样的妖狸！说不定未来能变成仙狸呢！"
        },
        {
          "role": "「吉法师」",
          "text": "仙狸！耶！"
        }
              ]
            }          
          ]
        },
        
        {
          "role": "派蒙",
          "text": "不过，这个问题先放一边，吉法师是不是越来越会说话了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "按照之前五百藏的说法…",
            "出发前，五百藏好像说过…"
          ]
        },
        {
          "role": "派蒙",
          "text": "五百藏说了什么来着？「吾辈乃是名震天下的妖狸」…不对，不是这个…"
        },
        {
          "role": "派蒙",
          "text": "「想挠肚皮，呜呶呶。」…「咿！」…也不是…"
        },
        {
          "role": "「吉法师」",
          "text": "呶哈哈，派蒙学得好像。好好笑哦。"
        },
        {
          "role": "旅行者",
          "text": "「适应吉法师的气息…」"
        },
        {
          "role": "派蒙",
          "text": "啊，对哦！我们越适应吉法师的气息，就越能理解吉法师的意思。"
        },
        {
          "role": "「吉法师」",
          "text": "还有修行呶！和旅行者、派蒙一起，吉法师学会了好多好多事情！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
             {
              "text": "派蒙可是个好向导呢。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "欸…"
        },
        {
          "role": "派蒙",
          "text": "那么久以前的事，旅行者还记得呀。好开心。"
        },
        {
          "role": "「吉法师」",
          "text": "嗯！谢谢派蒙和旅行者。"
        }
              ]
            },
            {
              "text": "一起冒险的伙伴，能一起成长。",
              "dialogues": [
                {
          "role": "「吉法师」",
          "text": "嗯！伙伴。"
        },
                 {
          "role": "派蒙",
          "text": "最好的伙伴！"
        }
        
              ]
              
            }      
            
            
          ]
        },
        
        {
          "role": "「吉法师」",
          "text": "这里的「不知道算不算大海」很漂亮，后面还有好高好高的漂亮房子。帮吉法师拍照？"
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "type": "subtitle",
          "text": "为吉法师拍照"
        },
        {
          "role": "「吉法师」",
          "text": "呜呶呶…为什么…"
        },
        {
          "role": "派蒙",
          "text": "吉法师真是的！怎么就冲进丘丘人的据点里了呢？"
        },
        {
          "role": "「吉法师」",
          "text": "本来以为…能和丘丘人一起玩…"
        },
        {
          "role": "派蒙",
          "text": "欸？为什么这么想？丘丘人是很危险的魔物…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text":  "噗，丘丘人也没有很危险啦…",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "喂！吉法师可不是像你这样身经百战的旅行者啦！"
        }
              ]
            },
            {
              "text": "哎吔，非常恐怖！",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "也不用这样吓唬他啦！"
        }
              ]
            }      
           
            
          ]
        },
        
        {
          "role": "旅行者",
          "text": "在镇守之森第一次见面的时候…"
        },
        {
          "role": "派蒙",
          "text": "对呀，当时吉法师不是被丘丘人包围着，变成了什么东西躲起来了吗？"
        },
        {
          "role": "「吉法师」",
          "text": "刚刚见到你们的时候…我想想…我想想…啊，对了。"
        },
        {
          "role": "「吉法师」",
          "text": "那时候，是在和丘丘人捉迷藏。森林里的丘丘人，是不会攻击妖狸的。而且，经常陪我们玩。"
        },
        {
          "role": "派蒙",
          "text": "欸？是形成了什么和谐共生的关系吗…"
        },
        {
          "role": "「吉法师」",
          "text": "不知道为什么，这里的丘丘人会这样。呜呶呶…"
        },
        {
          "role": "派蒙",
          "text": "总之，在外面要多加小心啦！即使是丘丘人…不对，应该说，正因为是丘丘人…"
        },
        {
          "role": "派蒙",
          "text": "呜哇，好复杂…旅行者，你来帮我说！"
        },
        {
          "role": "旅行者",
          "text": "要学会分辨好人和坏人。"
        },
        {
          "role": "派蒙",
          "text": "嗯！这样才能在外面，保护好自己。"
        },
        {
          "role": "旅行者",
          "text": "但是也不要忘了善良和开放的心。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，没错！这样才能容纳美好的事物。"
        },
        {
          "role": "「吉法师」",
          "text": "呶…"
        },
        {
          "role": "「吉法师」",
          "text": "旅行者和派蒙说得好复杂，吉法师听不懂。"
        },
        {
          "role": "「吉法师」",
          "text": "但是，吉法师知道，你们是好人。所以，吉法师要学你们。"
        },
        {
          "role": "派蒙",
          "text": "好啦，不说这个了。先跟旅行者学习钓鱼吧！"
        },
        {
          "role": "「吉法师」",
          "text": "嗯！钓鱼！"
        },
         {
          "type": "subtitle",
          "text": "与吉法师对话"
        },
        {
          "role": "派蒙",
          "text": "拍好了！"
        },
        {
          "role": "派蒙",
          "text": "接下来的话…"
        },
        {
          "role": "派蒙",
          "text": "嗯，就这么办吧！吉法师，钓过鱼吗？"
        },
        {
          "role": "「吉法师」",
          "text": "钓鱼？"
        },
        {
          "role": "派蒙",
          "text": "看来没试过呢！走，我们到水边去吧！"
        },
        {
          "role": "「吉法师」",
          "text": "好！"
        },
        {
          "type": "subtitle",
          "text": "跟上吉法师"
        },
        {
          "role": "「吉法师」",
          "text": "好想玩水呶。"
        },
        {
          "role": "旅行者",
          "text": "现在不可以，会把鱼儿吓跑的。"
        },
        {
          "role": "「吉法师」",
          "text": "嗯。知道了。"
        },
        {
          "type": "subtitle",
          "text": "前往目的地"
        },
        {
          "role": "派蒙",
          "text": "嗯，这边应该不错！"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师想玩水！"
        },
        {
          "role": "派蒙",
          "text": "喂，现在不行！会把鱼儿吓跑的！"
        },
        {
          "type": "subtitle",
          "text": "简单扼要地教了教钓鱼的基础。虽说教学尽量简明扼要，但究竟能听懂多少呢…"
        },
        {
          "role": "「吉法师」",
          "text": "鱼儿！"
        },
        {
          "role": "旅行者",
          "text": "听明白了吗？"
        },
        {
          "role": "「吉法师」",
          "text": "呶哈哈，鱼儿好笨哦。会被吃的东西骗。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙也一样。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "喂！"
        }
              ]
            },
            {
              "text": "吉法师也一样。",
              "dialogues": [
                {
          "role": "「吉法师」",
          "text": "呶？"
        }
              ]
            },
            {
              "text":  "我也一样。",
              "dialogues": []
            }        
          ]
        },
        
        {
          "role": "派蒙",
          "text": "毕竟，追求美食的心谁都有嘛！"
        },
        {
          "role": "派蒙",
          "text": "那么，旅行者，就拜托你给吉法师露一手啦！"
        },
        {
          "type": "subtitle",
          "text": "在指定地点钓上3条鱼"
        },
        {
          "type": "subtitle",
          "text": "与吉法师对话"
        },
        {
          "role": "「吉法师」",
          "text": "呶，为什么不能直接到水里去抓鱼呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有的鱼是捉不到的。",
              "dialogues": []
            },
            {
              "text": "虽然麻烦，但可能比较有趣。",
              "dialogues": []
            },
            {
              "text": "这也是一种修行。",
              "dialogues": []
            }         
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，钓鱼也是一种很好的修行方式喔！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
             {
              "text": "吉法师，你来试试。",
              "dialogues": [
                {
          "role": "「吉法师」",
          "text": "呶？"
        }
              ]
            },
            {
              "text": "派蒙，你来试试。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "派蒙会被拖到海里去的啦！"
        }
              ]
            }   
          ]
        },
        
        {
          "type": "subtitle",
          "text": "最终还是让吉法师来尝试钓鱼。应该算是理所应当吧，并没有什么收获。最终三人放弃了钓鱼，在水边玩闹了一番。"
        },
        {
          "role": "派蒙",
          "text": "虽然被水弄湿很不舒服，但玩水真开心呢！"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师很开心！不过，钓鱼好难。"
        },
        {
          "role": "派蒙",
          "text": "嗯，不过如果学会钓鱼，说不定能结交意想不到的朋友，对吧旅行者？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没错。",
              "dialogues": []
            },
            {
              "text": "没错，不过伙食开销也可能会变大。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "喂！"
        }
              ]
            }     
          ]
        },
        {
          "role": "「吉法师」",
          "text": "虽然不是很明白，不过又好像明白了呶。"
        },
        {
          "role": "「吉法师」",
          "text": "和旅行者、派蒙一起玩，很开心。旅行者和派蒙是吉法师的好朋友。"
        },
        {
          "role": "「吉法师」",
          "text": "修行真好！"
        },
        {
          "role": "派蒙",
          "text": "这么说来，一开始五百藏定下的目标，是去八个地方修行…"
        },
        {
          "role": "派蒙",
          "text": "龙脊雪山、孤云阁、蒙德城、璃月港、琥牢山，加上今天…这次修行，已经完成一大半了！"
        },
        {
          "role": "「吉法师」",
          "text": "是的呶…"
        },
        {
          "role": "派蒙",
          "text": "嗯，接下来应该去什么地方呢…"
        },
        {
          "role": "旅行者",
          "text": "交给你了。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，是旅行者很少有机会说的台词！"
        },
        {
          "role": "派蒙",
          "text": "嗯，交给我吧！"
        },
        {
          "role": "「吉法师」",
          "text": "交给派蒙呶！"
        }
      ]
    }
  ]
}