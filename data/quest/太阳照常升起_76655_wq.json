{
  "quest_id": 76655,
  "chapter_num": null,
  "chapter_title": "太阳照常升起",
  "type": "wq",
  "route": "The Sun Rises Once More",
  "stories": [
    {
      "story_id": 76655,
      "title": "太阳照常升起",
      "description": "太阳总会刺穿阴霾洒下希望…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与菲林斯对话"
        },
        {
          "role": "派蒙",
          "text": "菲林斯，你也上来了啊？"
        },
        {
          "role": "菲林斯",
          "text": "两位辛苦了，有人维护之后，这座灯塔的状态好了很多。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，举手之劳。不过就算我们再怎么维护灯塔，这里还是那么黑，总有灯塔照不到的地方。"
        },
        {
          "role": "菲林斯",
          "text": "是的，和外面不同，坟场里的时间仿佛永远停在了夜晚，停在了那场战斗结束的晚上。"
        },
        {
          "role": "菲林斯",
          "text": "我原本无意改变这里的环境，是你们点亮了灯塔，推动了这里的时间。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "会影响你的生活吗？",
              "dialogues": [
                {
                  "role": "菲林斯",
                  "text": "如果你想问这样是否会给我带来不便，答案是否定的。"
                }
              ]
            },
            {
              "text": "这是意外，抱歉。",
              "dialogues": [
                {
                  "role": "菲林斯",
                  "text": "请不要道歉，我并不厌恶这种改变。"
                }
              ]
            }
          ]
        },
        {
          "role": "菲林斯",
          "text": "生命是轮回，即便没有我们，这座岛上的鬼魂们也会逐渐消散，回到地脉中去。"
        },
        {
          "role": "菲林斯",
          "text": "所以不用担心灯塔无法照亮整座岛，随着鬼魂逐渐消失，笼罩这里的雾气也会变淡。"
        },
        {
          "role": "菲林斯",
          "text": "太阳总要升起。"
        }
      ]
    }
  ]
}