{
  "quest_id": 40200,
  "chapter_num": null,
  "chapter_title": "余醺一瞬，月境之约",
  "type": "wq",
  "route": "An Instant of Intoxication, A Meeting by Moonlight",
  "stories": [
    {
      "story_id": 40200,
      "title": "余醺一瞬，月境之约",
      "description": "彻底摧毁「黑钱领主」的摩拉除痕团体后，夜兰总算得到了闲暇的时间，邀请你在枫丹共度假期…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与夜兰一同前往枫丹廷"
        },
        {
          "role": "夜兰",
          "text": "夜景不错…"
        },
        {
          "role": "夜兰",
          "text": "清新的海露花香、街角香水店的芬芳、还有醇厚的咖啡豆味，在夜风中相融，氛围相当闲适。"
        },
        {
          "role": "夜兰",
          "text": "如果能找到一间楼顶露台的小酒馆，小酌两杯起泡葡萄酒，就能收获一场绝妙的微醺体验了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "现在是清净的假期，那就喝吧！",
              "dialogues": []
            },
            {
              "text": "刚刚完成一桩大案，尽情喝吧！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "好呀…那就陪我找找看吧，隐伏在城中的宝藏酒馆，会不会藏着惊喜的酒单？"
        },
        {
          "role": "夜兰",
          "text": "不过，在那之前，趁着卡布里埃商会还没打烊，和我一起去挑选几种香水，搭配这身装束？"
        },
        {
          "role": "夜兰",
          "text": "还有精密的钟表，暗藏趣意的发条摆设，和工艺独特的首饰，值得一看的纪念品还不少。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "工作越久越想消费吗？",
              "dialogues": []
            },
            {
              "text": "购物意愿爆发的时机正好！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "有提瓦特见识最广博，审美最独到的旅者陪着我，我当然要抓住这个机会，请你好好当一回参谋啦…"
        },
        {
          "role": "夜兰",
          "text": "嗯…心满意足了，的确是一次不错的异国旅程。"
        },
        {
          "role": "夜兰",
          "text": "如果能将时长放宽，慢慢游玩个三五天，还能消除仓促带来的遗憾。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不是说要好好享受假期吗？",
              "dialogues": []
            },
            {
              "text": "怎么好像又要回去工作一样…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "没办法，下一桩差事已经来了。"
        },
        {
          "role": "夜兰",
          "text": "除了为这次的案件写一份正式报告，协助建设更完善的货物通关体系，我还要准备动身，前往下一个任务地点——"
        },
        {
          "role": "夜兰",
          "text": "挪德卡莱。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我和派蒙的下一站也是那里。",
              "dialogues": []
            },
            {
              "text": "有什么紧急情况惊动了你吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "别紧张，只是和一位情报伙伴见个面，确定以后互利共赢的方案，还有互不干扰的边界。"
        },
        {
          "role": "夜兰",
          "text": "详情以后再谈吧。为了纪念这次尽兴的枫丹之旅，一起合张影，如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也是为了纪念你领我上道。",
              "dialogues": []
            },
            {
              "text": "也是为了纪念我们成功合作。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "没错，我可以将我的后背毫无保留地交给你了，新晋王牌探员旅行者。"
        },
        {
          "role": "夜兰",
          "text": "就用最关键的「综像勘录仪」，来完成这张意义重大的留影吧。"
        },
        {
          "role": "夜兰",
          "text": "希望在挪德卡莱再见时，我们还能像这次一样，完美合作。"
        },
        {
          "type": "subtitle",
          "text": "荧"
        },
        {
          "role": "[[file",
          "text": "活动任务-余醺一瞬，月境之约-CG-荧.png|center|1100px]]"
        },
        {
          "type": "subtitle",
          "text": "空"
        },
        {
          "role": "[[file",
          "text": "活动任务-余醺一瞬，月境之约-CG-空.png|center|1100px]]"
        },
        {
          "type": "subtitle",
          "text": "额外对话（派蒙）"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，旅行者，我回来啦！"
        },
        {
          "role": "派蒙",
          "text": "我跟着埃德勒警官，好好审讯了那些坏人…感觉，学到了不少新本领！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "玩得开心吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯！让坏家伙们说出自己作案的动机，然后后悔认错的感觉，像是给不好的事情划上了一个句号，挺有意思的！"
                },
                {
                  "role": "派蒙",
                  "text": "你和夜兰呢？夜兰好好享受了假期嘛？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "我们也玩得很尽兴。",
                      "dialogues": []
                    },
                    {
                      "text": "约好在挪德卡莱再见。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "以前还没有什么概念，现在仔细一想，夜兰还真是个大忙人啊！"
                },
                {
                  "role": "派蒙",
                  "text": "能把这——么——多的坏家伙揪出来，抓起来，还表现得悠悠哉哉，不怎么累…"
                },
                {
                  "role": "派蒙",
                  "text": "唔…下次见面的时候，我也问问看好了，能不能和她学学安排时间，保持活力的秘诀好了。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "最近你好上进欸！",
                      "dialogues": []
                    },
                    {
                      "text": "好学派蒙！夸夸！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "欸嘿嘿，只是想多多帮你的忙而已啦！"
                },
                {
                  "role": "派蒙",
                  "text": "你一直在变强，我也要努力一点才行嘛！"
                }
              ]
            },
            {
              "text": "有用力凶坏人吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "有，有吧？"
                },
                {
                  "role": "派蒙",
                  "text": "我的额头有点酸，一定是扮凶脸太久，眼睛瞪太大了！"
                },
                {
                  "role": "派蒙",
                  "text": "那些家伙一发现，我是旅行者最好最好的伙伴，全都吓得不轻，叽里咕噜老实交代了。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那我以后也凶一点…",
                      "dialogues": []
                    },
                    {
                      "text": "变成超绝恐怖大王…",
                      "dialogues": []
                    },
                    {
                      "text": "岂不是坏人直接吓跑了…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "唔…想象了一下，好像想象不出来…"
                },
                {
                  "role": "派蒙",
                  "text": "毕竟旅行者一直很温和嘛，最凶最凶的时候都不吓人，和我说话的时候都慢悠悠的~"
                },
                {
                  "role": "派蒙",
                  "text": "面对一般的坏家伙，你也不可能真的特别特别生气，到动真格发火…大凶特凶的程度吧？"
                },
                {
                  "role": "派蒙",
                  "text": "我们也算是见识过大风大浪了，心胸开阔，不和一般坏蛋们一般见识！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "也对，不和一般坏家伙计较！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "有了这次的经验，接下来的冒险，我们肯定会更得心应手啦！"
                },
                {
                  "role": "派蒙",
                  "text": "希望不管遇见什么情况，旅行者都要从从容容，不慌不忙…"
                },
                {
                  "role": "派蒙",
                  "text": "这样，我也能安安心心，我们都能在打败坏家伙后开开心心！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好啦，是时候开始下一次冒险了，我们继续出发吧！"
        }
      ],
      "collapse_ranges": [
        [
          27,
          31
        ]
      ]
    }
  ]
}