  "stories": [
    {
      "story_id": 72133,
      "title": "远吕羽氏遗事·序",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆在跟梶对话前，与镇物对话"
        },
        {
          "role": "观察",
          "text": "形状奇特的石灯，似乎放射着令人不安的能量。"
        },
        {
          "role": "派蒙",
          "text": "这个石灯笼好奇怪…让人感觉怪不舒服的。"
        },
        {
          "role": "派蒙",
          "text": "欸，好像灯柱上写着什么字?"
        },
        {
          "role": "观察",
          "text": "「路过的旅人，关于此镇物如有疑问，请至无想刃狭间，与梶先生商谈。」"
        },
        {
          "role": "观察",
          "text": "字看起来很新，似乎是不久前写下的。下面还有几列被雨水洗濯模糊的小字："
        },
        {
          "role": "观察",
          "text": "「…请转告梶先生，我们试过…但可惜…或许在附近能找到…」"
        },
        {
          "role": "观察",
          "text": "「…请梶先生尽快一同来避难地点，他的家人很想他。」"
        },
        {
          "role": "派蒙",
          "text": "这个梶先生似乎对石灯笼很在意的样子，我们不如去无想刃狭间问问他吧?"
        },
        {
          "type": "subtitle",
          "text": "◆与梶对话"
        },
        {
          "role": "梶",
          "text": "你好！抱歉打扰，外国人。希望你能听我一言。"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "梶",
          "text": "请不要在这座岛上久留，近来「祟神」弥漫得范围越来越广了。"
        },
        {
          "role": "旅行者",
          "text": "「祟神」？"
        },
        {
          "role": "梶",
          "text": "是啊，自从珊瑚宫来的人毁掉了岛上的镇压蛇神残魂的镇物，「祟神」就散布了全岛…"
        },
        {
          "role": "梶",
          "text": "如你所见，阴云遮天蔽日，雨也下个不停，这都是「祟神」所为。"
        },
        {
          "role": "梶",
          "text": "这段时间里，矿工们一个接一个病倒、失去理智，流亡他岛…"
        },
        {
          "role": "梶",
          "text": "大家都走了，本岛已经剩不下几个居民了。"
        },
        {
          "role": "梶",
          "text": "不过讽刺的是，多亏了「祟神」作乱，幕府和叛军打仗也没以前那么拼命了。"
        },
        {
          "role": "梶",
          "text": "哼，话说回来，要不是他们打仗破坏了大御所殿下的镇物，岛上哪会这样一团糟！"
        },
        {
          "role": "梶",
          "text": "奉行呀、龙呀蛇的，跟我又有什么关系！他们打仗又没问过我的意见！"
        },
        {
          "role": "旅行者",
          "text": "你还留在这里做什么？"
        },
        {
          "role": "梶",
          "text": "做什么？这里是我的家。"
        },
        {
          "role": "旅行者",
          "text": "你的家人呢？"
        },
        {
          "role": "梶",
          "text": "在安全的地方，谢谢你的关心。他们也在等我接他们回来吧。"
        },
        {
          "role": "梶",
          "text": "岛上没人是自愿离开的。我们在这里是一家人，去了别处，就只能做别人的雇工。"
        },
        {
          "role": "梶",
          "text": "所以总的有人留下，想办法把这里打扫干净，让他们有家可回。"
        },
        {
          "role": "梶",
          "text": "唉，真是头疼…"
        },
        {
          "role": "旅行者",
          "text": "我能帮上忙吗？"
        },
        {
          "role": "梶",
          "text": "如果是别的小毛头这样唐突地要求帮忙，我恐怕要笑出声了。"
        },
        {
          "role": "梶",
          "text": "不过你身为外国旅人，能深入稻妻国境如此之远，也不像是没本事的人。"
        },
        {
          "role": "梶",
          "text": "我就直说吧，那边的镇物困扰我很久了，希望你能找到办法将它修复。"
        },
        {
          "role": "梶",
          "text": "这里的气氛如此糟糕，一定是因为这些镇物遭到了破坏的缘故。"
        },
        {
          "role": "梶",
          "text": "不过在接近镇物时一定要小心，如果注视它的话，它会向你释放一股能量…"
        },
        {
          "role": "梶",
          "text": "虽然无害，但让人感觉很不舒服，就像…它在将你拒之身外一样。"
        },
        {
          "role": "梶",
          "text": "镇物似乎少了什么部件，或许把它缺少的东西放回去就能修好它。"
        },
        {
          "role": "梶",
          "text": "当然，这只是我的猜测，到现在我也没搞清楚它到底是哪里失灵了。"
        },
        {
          "role": "梶",
          "text": "所以，如果你想帮忙的话，这座政务就先拜托你来修复了。"
        },
        {
          "role": "梶",
          "text": "不过我还是那句话，如果你也没办法的话，还请不要在这里久留。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "梶",
          "text": "怎么？这么快就把镇物修复了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还没有。",
              "dialogues": []
            },
            {
              "text": "还正在努力。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梶",
          "text": "哦哦，没关系的，请慢慢来。"
        },
        {
          "role": "梶",
          "text": "实在不行的话也请不要勉强，请别在这个危险的地方逗留太久。"
        }
      ],
      "collapse_ranges": [
        [
          39,
          43
        ]
      ]
    },
    {
      "story_id": 72129,
      "title": "远吕羽氏遗事·其一",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "◆观察镇物"
        },
        {
          "role": "鸣神磐柱",
          "text": "你注视着镇物，忽然一股奇特的能量似乎涌向了你。"
        },
        {
          "role": "鸣神磐柱",
          "text": "你意识到它并非抗拒着你，而是向你要求着什么……"
        },
        {
          "role": "派蒙",
          "text": "唔…这座镇物好像少了些什么东西，我们去附近找找看吧？"
        },
        {
          "role": "派蒙",
          "text": "使用元素视野调查一下附近弥散的元素痕迹，说不定能发现什么呢！"
        },
        {
          "type": "subtitle",
          "text": "◆寻找缺失部件修复镇物"
        },
        {
          "role": "派蒙",
          "text": "好耶，到手！"
        },
        {
          "role": "旅行者",
          "text": "（是这个吗？）"
        },
        {
          "role": "派蒙",
          "text": "石灯亮起来了！欸，好像天气也变好了呢…"
        },
        {
          "type": "subtitle",
          "text": "◆返回与梶对话"
        },
        {
          "role": "梶",
          "text": "有一手啊，外国人！云层明显消散了许多，看起来我的猜测没错。"
        },
        {
          "role": "梶",
          "text": "接下来在蛇神之首与蛇骨矿洞还有两处镇物需要修复。"
        },
        {
          "role": "梶",
          "text": "如果你不介意的话，这两座镇物也还麻烦你了。"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "梶",
          "text": "非常感谢你的帮助，虽然我也不是什么有钱人，但我保证不会亏待你的。"
        },
        {
          "role": "梶",
          "text": "虽然不知道什么时候才有希望，但亲友回家的日子又近了一天…"
        },
        {
          "role": "梶",
          "text": "顺便一提，等你那边差不多了就到岛西侧找我吧，无名砦那边也曾受到过叛军的侵扰，或许与这场异变脱不了干系。"
        }
      ]
    },
    {
