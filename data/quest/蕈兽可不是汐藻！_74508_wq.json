{
  "quest_id": 74508,
  "chapter_num": null,
  "chapter_title": "蕈兽可不是汐藻！",
  "type": "wq",
  "route": "Fungi Are Not Tidalga!",
  "stories": [
    {
      "story_id": 74508,
      "title": "蕈兽可不是汐藻！",
      "description": "特巡队员蒂蕾娜离开后，「小小灵蕈大幻戏」又迎来了一位特别的美露莘玩家…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与摊位旁的两人对话"
        },
        {
          "type": "subtitle",
          "text": "一段时间后，你与派蒙来到了「小小灵蕈大幻戏」的摊位前…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "昂吉安妮",
          "text": "哼哼！滑滑弹弹软软嫩嫩的蕈兽真是太棒了！我还要继续玩这个游戏！"
        },
        {
          "role": "旅行者",
          "text": "这位是？"
        },
        {
          "role": "昂吉安妮",
          "text": "本小姐是昂吉安妮，蒂蕾娜进入特巡队之前的教官！"
        },
        {
          "role": "昂吉安妮",
          "text": "我和蒂蕾娜不一样，不一样哦！不会因为你们是「超天顶领队级战力」就对你们畏畏缩缩！"
        },
        {
          "role": "派蒙",
          "text": "这个很嚣张的美露莘…居然是蒂蕾娜以前的教官？"
        },
        {
          "role": "海妮耶",
          "text": "别紧张，「黄金流星」和「白银伴星」。"
        },
        {
          "role": "海妮耶",
          "text": "不久前，蒂蕾娜小姐接到了别的任务，回到特巡队的驻地去了。"
        },
        {
          "role": "海妮耶",
          "text": "昂吉安妮小姐是蒂蕾娜小姐请来，代替她负责活动场地安保的专业人士。"
        },
        {
          "role": "海妮耶",
          "text": "她也非常喜欢「小小灵蕈大幻戏」，和我玩得很开心。"
        },
        {
          "role": "昂吉安妮",
          "text": "没错，无论是桌上的游戏，还是现实里圆圆的蕈兽！"
        },
        {
          "role": "昂吉安妮",
          "text": "滑滑弹弹软软嫩嫩，就像汐藻一样…嘿嘿嘿…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你怎么流口水了？",
              "dialogues": []
            },
            {
              "text": "不许吃蕈兽伙伴！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "昂吉安妮",
          "text": "才不会吃！抱着蹭一下也没关系吧！海妮耶都不介意我捏捏「欢腾之火」呢！"
        },
        {
          "role": "派蒙",
          "text": "那，那你也只能捏捏「欢腾之火」！「咚咚小圆帽」只有我和旅行者才能抱！"
        },
        {
          "role": "昂吉安妮",
          "text": "干嘛这么小气！我全都要！"
        },
        {
          "role": "昂吉安妮",
          "text": "海妮耶说过，你们是这个游戏的专家，那不如就和我比划比划？"
        },
        {
          "role": "昂吉安妮",
          "text": "如果我赢了，我也要揉捏「咚咚小圆帽」！"
        },
        {
          "role": "派蒙",
          "text": "可恶，被她瞧不起了！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们上吧，让她见识一下「小小灵蕈大幻戏」的第一代玩家的力量！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有「月莲杯初代冠军」！",
              "dialogues": []
            },
            {
              "text": "还有「智巧勇武双连星」！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对对对！我们那么多威风的外号可不是白白得来的呢，哪有随便就被打败的道理！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（昂吉安妮）"
        },
        {
          "role": "昂吉安妮",
          "text": "嘿嘿…滑滑弹弹软软嫩嫩的蕈兽…也会喜欢吃汐藻吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这个先放一边，再来一局！",
              "dialogues": [
                {
                  "role": "昂吉安妮",
                  "text": "来就来！谁怕谁！"
                }
              ]
            },
            {
              "text": "抱着你的汐藻做梦吧！",
              "dialogues": [
                {
                  "role": "昂吉安妮",
                  "text": "哼！蕈兽还没试过呢，你怎么就肯定蕈兽不喜欢呢！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          23,
          25
        ]
      ]
    }
  ]
}