{
  "quest_id": 76125,
  "chapter_num": null,
  "chapter_title": "无人的庭园",
  "type": "wq",
  "route": "The Empty Courtyard",
  "stories": [
    {
      "story_id": 76125,
      "title": "无人的庭园",
      "description": "今日，「银月之庭」内寂静无声…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往银月之庭"
        },
        {
          "type": "subtitle",
          "text": "事件之后，你和派蒙再次前往银月之庭…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "旅行者",
          "text": "（哥伦比娅，果然不在这里…）"
        },
        {
          "role": "派蒙",
          "text": "难道哥伦比娅真的…"
        },
        {
          "role": "旅行者",
          "text": "（她踏入了「月之门」，没人知道门内有什么，但那是个将极为强大的猎月人都彻底撕碎了的地方…）"
        },
        {
          "role": "旅行者",
          "text": "（如果我当时…）"
        },
        {
          "role": "派蒙",
          "text": "哥伦比娅？"
        },
        {
          "role": "月灵",
          "text": "……"
        },
        {
          "role": "月灵",
          "text": "…？"
        },
        {
          "role": "派蒙",
          "text": "是你们啊…"
        },
        {
          "role": "月灵",
          "text": "~"
        },
        {
          "role": "派蒙",
          "text": "你们…也在等哥伦比娅回来吗？"
        },
        {
          "role": "努昂诺塔",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "就连你也…"
        },
        {
          "role": "努昂诺塔",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "呜…不要那么难过嘛，打起精神来…"
        },
        {
          "role": "派蒙",
          "text": "大家一起难过的话，不就像是…不就像是…"
        },
        {
          "role": "派蒙",
          "text": "我才不要这么想呢…"
        },
        {
          "role": "旅行者",
          "text": "（……）"
        },
        {
          "role": "旅行者",
          "text": "（…我不能沉溺在自责之中。）"
        },
        {
          "role": "旅行者",
          "text": "（哥伦比娅不是为了看到这样的局面才做出的牺牲，更何况…）"
        },
        {
          "role": "旅行者",
          "text": "我…还没有放弃。"
        },
        {
          "role": "旅行者",
          "text": "哥伦比娅，她的每一位朋友，都不会就此放弃…"
        },
        {
          "role": "旅行者",
          "text": "再给我们一点时间。我没法向各位许诺什么，但我一定会尽力…"
        },
        {
          "role": "月灵",
          "text": "……"
        },
        {
          "role": "努昂诺塔",
          "text": "~！"
        },
        {
          "role": "派蒙",
          "text": "它们，这是在…鼓励我们？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "谢谢你们…"
        },
        {
          "role": "派蒙",
          "text": "想要陪你们做点什么吗？"
        },
        {
          "role": "月灵",
          "text": "……"
        },
        {
          "role": "月灵",
          "text": "~！"
        },
        {
          "type": "subtitle",
          "text": "未完成「月光奏鸣曲·遐音」"
        },
        {
          "role": "派蒙",
          "text": "这只月灵…有点心神不宁的样子呢…"
        },
        {
          "type": "subtitle",
          "text": "完成「月光奏鸣曲·遐音」"
        },
        {
          "role": "派蒙",
          "text": "这只月灵…似乎是喜欢弹琴的那只。"
        },
        {
          "role": "派蒙",
          "text": "要不你弹点什么吧？听到熟悉的旋律，说不定就可以稍稍安下心来…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "熟悉的旋律…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "演奏哥伦比娅常哼的歌…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "…它们睡着了。"
        },
        {
          "role": "派蒙",
          "text": "看起来小家伙们很久都没有好好休息过了…"
        },
        {
          "role": "派蒙",
          "text": "我们悄悄离开这里吧。"
        },
        {
          "type": "subtitle",
          "text": "月灵睡着了，你们打算离开，并在洞口看见一位熟人…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "「木偶」",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "桑多涅！你怎么会在这里？"
        },
        {
          "role": "「木偶」",
          "text": "随便出门散散心不行吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她没有回来。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「木偶」",
          "text": "我想也是。"
        },
        {
          "role": "「木偶」",
          "text": "奇迹怎么可能没有代价呢。"
        },
        {
          "role": "派蒙",
          "text": "你要往哪个方向走？我是说…好不容易遇见了，要不要再一起走一段？"
        },
        {
          "role": "「木偶」",
          "text": "算了吧，今天心情不好，说出来的话不会好听。"
        },
        {
          "role": "「木偶」",
          "text": "而且我看，这里最不需要的就是安慰。"
        }
      ]
    }
  ]
}