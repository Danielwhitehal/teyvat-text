{
  "quest_id": 74009,
  "chapter_num": null,
  "chapter_title": "一条枫丹信息",
  "type": "wq",
  "route": "A Fontainian Message",
  "stories": [
    {
      "story_id": 74009,
      "title": "一条枫丹信息",
      "description": "在原本遇到维吉尔的地方，结识了两位有着相同目标的…好心人。是时候向维吉尔讨个说法了。",
      "dialogues": [
        {
          "role": "桑尼",
          "text": "这可真是巧遇啊，这可真是。您说对吧？亲爱的卢卡。"
        },
        {
          "role": "卢卡",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "你们是？"
        },
        {
          "role": "桑尼",
          "text": "您瞧瞧我，可真是失礼。我是桑尼，朋友们有时候管我叫「白手套」。而这位「渔夫」卢卡，在特定的人群中小有名气。"
        },
        {
          "role": "派蒙",
          "text": "喔，你们好！我是…"
        },
        {
          "role": "桑尼",
          "text": "我明白，我明白，您是派蒙，而这位金发的先生是旅行者。"
        },
        {
          "role": "派蒙",
          "text": "咦？你认识我们吗？"
        },
        {
          "role": "桑尼",
          "text": "当然认识，当然！只不过在今天之前，我认识您与旅行者，就如同我认识那维莱特大人，不过是单方面的。"
        },
        {
          "role": "桑尼",
          "text": "像二位这样杰出的人物，一旦踏上了我们枫丹的土地，自然会有小小鸟跟我们说喽。"
        },
        {
          "role": "旅行者",
          "text": "原来我们这么有名吗？"
        },
        {
          "role": "桑尼",
          "text": "您瞧瞧您，真是谦虚！这么说吧，您出现在我们枫丹，对某些人而言，就像炸弹出现在欧庇克莱的大舞台上。"
        },
        {
          "role": "桑尼",
          "text": "——当然，是好的方面！您说对吧？亲爱的卢卡。"
        },
        {
          "role": "派蒙",
          "text": "呃，这个要怎样才是好的方面…"
        },
        {
          "role": "桑尼",
          "text": "唔…我不善言辞，您觉得呢？亲爱的卢卡？"
        },
        {
          "role": "卢卡",
          "text": "林尼与琳妮特的魔术演出。炸弹、逃脱表演。爆炸性新闻。"
        },
        {
          "role": "桑尼",
          "text": "精辟！您瞧，我就想不出这样的说法。"
        },
        {
          "role": "派蒙",
          "text": "原、原来如此…"
        },
        {
          "role": "派蒙",
          "text": "不过，为什么你叫「白手套」呀？你明明没戴手套…"
        },
        {
          "role": "桑尼",
          "text": "喔，这可是个刁钻问题。该怎么向您解释好呢？"
        },
        {
          "role": "桑尼",
          "text": "设想您戴着白手套。这时，只要摸到脏东西，手套上就会留下污渍，对吧？所以，我的职责就是找到脏东西，然后处理掉。"
        },
        {
          "role": "派蒙",
          "text": "是喔…也就是负责清洁工作的人？"
        },
        {
          "role": "桑尼",
          "text": "说得好，亲爱的派蒙！我就没办法这么精简扼要地总结我的工作性质。"
        },
        {
          "role": "派蒙",
          "text": "所以，枫丹廷的街道这么整洁，都是多亏了桑尼这样的人！"
        },
        {
          "role": "桑尼",
          "text": "哈哈哈，您说话可真中听！您就当做是这样吧。"
        },
        {
          "role": "派蒙",
          "text": "是喔…不过清洁工还需要带刀吗？"
        },
        {
          "role": "桑尼",
          "text": "您就当做是清理一些顽固垃圾的时候，才要派上用场的小道具吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯，我明白了！那，卢卡是因为很会钓鱼，所以才叫「渔夫」吗？"
        },
        {
          "role": "桑尼",
          "text": "嗯——倒也不完全是这样，不完全是这样。您瞧，在我们枫丹，不是有各种各样的鱼吗？"
        },
        {
          "role": "桑尼",
          "text": "而教人如何与缤纷多彩的鱼群愉快地相处、平静地相处，就是他的特长。我说得对吗？亲爱的卢卡。"
        },
        {
          "role": "卢卡",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "咦？我不明白…如果是这样的话，那——"
        },
        {
          "role": "桑尼",
          "text": "哎呀呀，亲爱的派蒙，您可真会问问题。问的问题都很刁钻、很有水准呢。真希望能多与您聊聊，好好回答您的问题。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，别问了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？好吧…那桑尼、卢卡，你们有什么事吗？"
                }
              ]
            },
            {
              "text": "找我们有什么事吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "桑尼",
          "text": "您瞧，我们对「潜水」非常感兴趣，非常感兴趣。我们枫丹的水下充满了数之不尽的财富，无论是自然的还是前人留下的。"
        },
        {
          "role": "桑尼",
          "text": "听说，最近您在这里认识了一位好朋友，与他一同入水。您本领高强，甚至不需要潜水护具。您说对吧？亲爱的卢卡。"
        },
        {
          "role": "卢卡",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "你们想问维吉尔的事。"
        },
        {
          "role": "桑尼",
          "text": "没错。我们想问维吉尔的事。"
        },
        {
          "role": "派蒙",
          "text": "维吉尔…那个坏家伙！啊啊，气死我了！"
        },
        {
          "role": "？？？",
          "text": "和派蒙一起，事无巨细地向「白手套」桑尼与「渔夫」卢卡说明了此前的经历。"
        },
        {
          "role": "桑尼",
          "text": "原来如此，原来如此。非常感谢。"
        },
        {
          "role": "派蒙",
          "text": "不用谢！哼，那个坏东西，我可忘不了。"
        },
        {
          "role": "桑尼",
          "text": "——当然我们很感谢二位坦诚说明了关于维吉尔的遭遇。但我更感激的是，二位并不是他的朋友。不然的话…"
        },
        {
          "role": "桑尼",
          "text": "这么说吧：不然的话，之于你我，多少都会有些不便。您说对吧？亲爱的卢卡。"
        },
        {
          "role": "卢卡",
          "text": "应该对付不来。"
        },
        {
          "role": "桑尼",
          "text": "我想也是，我想也是。真是太感谢了。"
        },
        {
          "role": "派蒙",
          "text": "你在说什么呀…？"
        },
        {
          "role": "旅行者",
          "text": "他们是维吉尔的敌人。"
        },
        {
          "role": "派蒙",
          "text": "喔！"
        },
        {
          "role": "桑尼",
          "text": "您这话可真令人伤心，尊敬的先生。我可没有敌人，只有许多朋友，维吉尔也是其中之一。只不过，亲爱的维吉尔…"
        },
        {
          "role": "桑尼",
          "text": "我们需要和他好好「聊聊」。您应该能理解吧？亲爱的旅行者。"
        },
        {
          "role": "桑尼",
          "text": "当然，也自然是要为您与派蒙讨个说法。否则的话，对二位贵客就太失礼了，不是吗？"
        },
        {
          "role": "派蒙",
          "text": "那个，我没听懂…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他是「白手套」。知道这个就行了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是喔…？"
                }
              ]
            },
            {
              "text": "这些事情，不用太明白…",
              "dialogues": [
                {
                  "role": "桑尼",
                  "text": "身处世间，太过明白的话，多少有些无趣，不是吗？尊敬的先生。"
                }
              ]
            }
          ]
        },
        {
          "role": "桑尼",
          "text": "我们已经找到了维吉尔和他的朋友们的据点。我们不妨在据点会合，您看如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么要我们一起…",
              "dialogues": [
                {
                  "role": "桑尼",
                  "text": "尊敬的先生！维吉尔对您做出了如此冒犯的事情，我和卢卡若是不与您打招呼，就…和他聊聊的话，那可太失礼了。"
                },
                {
                  "role": "卢卡",
                  "text": "……"
                },
                {
                  "role": "桑尼",
                  "text": "您瞧，卢卡也明白这样的道理。"
                }
              ]
            },
            {
              "text": "好。走吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼！我也要跟维吉尔聊聊！让他向我们道歉！"
        },
        {
          "role": "桑尼",
          "text": "哈哈哈，您可真善良。那我们在目的地会合吧，二位。"
        },
        {
          "type": "subtitle",
          "text": "前往目的地"
        },
        {
          "role": "维吉尔",
          "text": "请您听我解释…这一切都是误会…"
        },
        {
          "role": "维吉尔",
          "text": "桑尼先生…您想，我们也只是想着这门生意很有赚头，上边又不同意，才想着…想着先赚一笔，将收入交给组织，嗯！"
        },
        {
          "role": "派蒙",
          "text": "可恶，居然无视我喔！"
        },
        {
          "role": "维吉尔",
          "text": "我对组织绝对没有怨言…对了，我是被那些坏人骗了，才会做出这样愚蠢的事情…"
        },
        {
          "role": "桑尼",
          "text": "真是了不起，了不起。旅行者，您的身手真是名不虚传。您不这么认为吗？亲爱的卢卡。"
        },
        {
          "role": "卢卡",
          "text": "厉害。真的很强。"
        },
        {
          "role": "维吉尔",
          "text": "看在过去的情分上…桑尼先生…卢卡先生…"
        },
        {
          "role": "卢卡",
          "text": "……"
        },
        {
          "role": "维吉尔",
          "text": "哎吔！不、不要…"
        },
        {
          "role": "桑尼",
          "text": "卢卡。客人还在呢。我们可不能做出失礼的事情，让他们不愉快。"
        },
        {
          "role": "卢卡",
          "text": "明白。"
        },
        {
          "role": "派蒙",
          "text": "哼！维吉尔，你知道错了吧！"
        },
        {
          "role": "维吉尔",
          "text": "啊啊，我错了，我错了…请多多谅解…"
        },
        {
          "role": "派蒙",
          "text": "知错就好，以后可不能再这样了！"
        },
        {
          "role": "桑尼",
          "text": "亲爱的维吉尔以后绝对不会这样了，派蒙、旅行者，我以我「白手套」桑尼的名誉，和我父亲与儿子的名誉保证。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们走吧，派蒙…",
              "dialogues": []
            },
            {
              "text": "你们打算怎么做？",
              "dialogues": [
                {
                  "role": "桑尼",
                  "text": "身处世间，太过明白的话，多少有些无趣，不是吗？尊敬的先生。"
                },
                {
                  "role": "桑尼",
                  "text": "如果您实在好奇的话，我们会先慢慢跟他…聊聊。就不耽误二位的时间了。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！谢谢你们，桑尼、卢卡。看来枫丹还是好人比坏人多！"
        },
        {
          "role": "桑尼",
          "text": "再见，希望我们还有机会合作，亲爱的派蒙、尊敬的先生。"
        },
        {
          "role": "维吉尔",
          "text": "噫…"
        },
        {
          "type": "subtitle",
          "text": "与二人对话"
        },
        {
          "role": "桑尼",
          "text": "尊敬的先生、亲爱的派蒙。"
        },
        {
          "role": "桑尼",
          "text": "请看，这里就是维吉尔最近使用的据点。"
        },
        {
          "role": "看起来似乎有点坏的人",
          "text": "真是的，维吉尔大哥怎么还没回来…"
        },
        {
          "role": "看起来稍微有点危险的人",
          "text": "他要再不回来，我就忍不住…忍不住要喝这批乐斯了…"
        },
        {
          "role": "看起来不太正经的人",
          "text": "喂，别闹！那可是好不容易才搞来的货。如果敢乱动，维吉尔大哥可不会跟你客气。"
        },
        {
          "role": "桑尼",
          "text": "真是遗憾。亲爱的维吉尔似乎还没回来呢。不过，我们可以先和他们「聊聊」。"
        },
        {
          "role": "派蒙",
          "text": "呃，他们看起来…好像不太好聊…"
        },
        {
          "role": "桑尼",
          "text": "这可未必，您觉得呢？亲爱的卢卡。"
        },
        {
          "role": "卢卡",
          "text": "没有问题。"
        },
        {
          "role": "派蒙",
          "text": "喂！真的没问题吗？总感觉，他们应该会直接动手吧！"
        },
        {
          "role": "桑尼",
          "text": "哎呀！您可真是思虑周全，亲爱的派蒙。如果发生了那样的事情，就太不幸了。"
        },
        {
          "role": "桑尼",
          "text": "…对他们来说哪。"
        },
        {
          "type": "subtitle",
          "text": "与这些人「聊聊」"
        },
        {
          "role": "桑尼",
          "text": "好了，亲爱的维吉尔…您可真是让人伤脑筋，我们该拿您怎么办呢？"
        },
        {
          "role": "维吉尔",
          "text": "对不起、对不起…"
        },
        {
          "role": "桑尼",
          "text": "哎呀，您这可不行。您也明白，时光飞逝，回头的窗口早已过去。在我们当中，也有我们的正义。有些生意，是万万不能碰的。"
        },
        {
          "role": "维吉尔",
          "text": "但…但是，桑尼先生，您听我说，它能带来的利润…"
        },
        {
          "role": "桑尼",
          "text": "唉，真是的。钱、钱、钱、钱、钱，您就只在乎这个吗？身为枫丹人的骄傲呢？难道您乐意看着这种饮料，毒害我们的同胞吗？"
        },
        {
          "role": "卢卡",
          "text": "呸！"
        },
        {
          "role": "桑尼",
          "text": "哎？真罕见，卢卡竟然为了您表达了这么丰富的情绪。您瞧，亲爱的维吉尔，您可真是不得了，不得了呢。"
        },
        {
          "role": "维吉尔",
          "text": "桑尼先生，那个…请您相信我，都、都是因为那些卑鄙小人，他们骗了我，我、我才会…"
        },
        {
          "role": "桑尼",
          "text": "废物！给我闭嘴！"
        },
        {
          "role": "维吉尔",
          "text": "哎吔——！"
        },
        {
          "role": "桑尼",
          "text": "我最看不起你这种渣滓。都到这个地步了，你还以为你骗得了我？啊？是你的脑子不好，还是你觉得我的脑子不好？啊？！"
        },
        {
          "role": "桑尼",
          "text": "竟然还想害旅行者。你也不看看你找上的标的是什么人物？啊？居然能带出这样的蠢货，事后我可要找他聊聊…"
        },
        {
          "role": "桑尼",
          "text": "…不过这部分就不劳您操心了，亲爱的维吉尔。"
        },
        {
          "type": "subtitle",
          "text": "与维吉尔对话"
        }
      ]
    }
  ]
}