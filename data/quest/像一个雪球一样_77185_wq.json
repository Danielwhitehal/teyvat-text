{
  "quest_id": 77185,
  "chapter_num": null,
  "chapter_title": "像一个雪球一样",
  "type": "wq",
  "route": "Just Like a Snowball",
  "stories": [
    {
      "story_id": 77185,
      "title": "像一个雪球一样",
      "description": "帮助孩子们推出合适大小的完美雪球",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "我等会再来。"
        },
        {
          "type": "subtitle",
          "text": "和米罗斯拉娃对话"
        },
        {
          "role": "安菲萨",
          "text": "嘿嘿…马上就可以用雪球堆雪人了，听起来就很好玩，老大！"
        },
        {
          "role": "米罗斯拉娃",
          "text": "这是件严肃的事情，安菲萨，我们需要合适大小的雪球，才能堆出最为完美的雪人——团队配合也要像堆雪人一样，精益求精。"
        },
        {
          "role": "米罗斯拉娃",
          "text": "不过，我们「野蛮熊」确实需要更多的人手了，至少，现在得找一个能制作完美雪球的人…"
        },
        {
          "role": "旅行者",
          "text": "我可是堆雪人的高手！"
        },
        {
          "role": "米罗斯拉娃",
          "text": "咦？看起来很有自信的大人，那你试试吧，如果你能推出完美雪球，我就给你些奖励！"
        },
        {
          "role": "克雷廖夫",
          "text": "记住，雪球的尺寸一分一厘都不能差哦…"
        },
        {
          "role": "米罗斯拉娃",
          "text": "克雷廖夫，要求倒也没有这么严苛啦。"
        },
        {
          "type": "subtitle",
          "text": "帮助米罗斯拉娃推出完美雪球"
        },
        {
          "type": "subtitle",
          "text": "和米罗斯拉娃对话"
        },
        {
          "role": "米罗斯拉娃",
          "text": "如此完美的雪球…只需要我稍加装饰——现在我将为这个雪人命名为「首领」，现在它是「野蛮熊」的重要成员了！"
        },
        {
          "role": "米罗斯拉娃",
          "text": "当然，现在还有两个雪人还亟待制作…现在你要继续尝试吗？"
        },
        {
          "role": "旅行者",
          "text": "当然，趁热打铁！"
        },
        {
          "type": "subtitle",
          "text": "帮助克雷廖夫推出完美雪球"
        },
        {
          "type": "subtitle",
          "text": "和米罗斯拉娃对话"
        },
        {
          "role": "米罗斯拉娃",
          "text": "这个雪人就由克雷廖夫来装饰命名吧…雪人达到合格标准后，带点个人特色完全可以接受。"
        },
        {
          "role": "克雷廖夫",
          "text": "唔…我想好了，那它的名字就叫「克雷廖夫二号」。"
        },
        {
          "role": "米罗斯拉娃",
          "text": "呃啊，不错的想法，就差安菲萨的了，还请你继续帮帮忙。"
        },
        {
          "role": "旅行者",
          "text": "好哦。"
        },
        {
          "type": "subtitle",
          "text": "帮助安菲萨推出完美雪球"
        },
        {
          "role": "旅行者",
          "text": "我等会再来尝试…"
        },
        {
          "type": "subtitle",
          "text": "和「野蛮熊」三人组对话"
        },
        {
          "role": "安菲萨",
          "text": "哇，是超级漂亮的雪人！我要叫它…嗯，「超级大大雪怪」！我们一起冲锋！"
        },
        {
          "role": "米罗斯拉娃",
          "text": "不错的名字，很有气势，现在我们的雪人分队也总算是建立完毕了。"
        },
        {
          "role": "米罗斯拉娃",
          "text": "多谢你，这份报酬归你了。可惜，你的年龄有点大了，不然我将破格把你招入「野蛮熊」。"
        }
      ]
    }
  ]
}