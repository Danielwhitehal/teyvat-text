{
  "quest_id": 2014,
  "chapter_num": "古闻之章 第一幕",
  "chapter_title": "盐花",
  "type": "lq",
  "route": "Sal Flore",
  "stories": [
    {
      "story_id": 11020,
      "title": "旧日之影",
      "description": "行至珠钿舫，你和派蒙偶然认出了一张熟悉的面孔…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往珠钿舫"
        },
        {
          "role": "钟离",
          "text": "哦？没想到会在这里遇见你们。"
        },
        {
          "role": "宛烟",
          "text": "这两位是你的朋友吗？"
        },
        {
          "role": "钟离",
          "text": "嗯，前段时间有幸识得，荧，见多识广，博学多才。与之相处，倍感投缘。"
        },
        {
          "role": "钟离",
          "text": "刚刚我们聊到「历史上的岩王帝君」这个话题，你有兴趣听一听吗？"
        },
        {
          "role": "翰学",
          "text": "这位先生，好像轻看了岩王爷的神力。作为专业的考古学家，我想纠正他的一些观点。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他、他其实…",
              "dialogues": []
            },
            {
              "text": "也许没人比他更懂…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "翰学",
          "text": "我们正在讨论，「历史上第一枚摩拉」的下落。"
        },
        {
          "role": "派蒙",
          "text": "历史上的第一枚摩拉？"
        },
        {
          "role": "逸轩",
          "text": "众所周知，在岩王爷的指引下，璃月先民冶炼矿石，用最初的货物与世间诸国展开贸易。"
        },
        {
          "role": "逸轩",
          "text": "如今的璃月，掌握了全大陆摩拉的唯一铸造之权。而世上第一枚摩拉，应该就是在数千年前，岩王爷亲手铸造的。"
        },
        {
          "role": "宛烟",
          "text": "根据我的考证…再加上一点猜测，我认为这枚具有历史意义的摩拉，可能是作为一种「信物」，秘密传承了下来。"
        },
        {
          "role": "宛烟",
          "text": "比如…掌管璃月的「七星」，会不会在每一代上任之前，都有什么不为外人所知的仪式…"
        },
        {
          "role": "翰学",
          "text": "不不不，按照我的研究，这「第一枚摩拉」的地位，可没这么简单。"
        },
        {
          "role": "翰学",
          "text": "众所周知，摩拉是一种触媒。直到今天，也流传着利用摩拉在神秘学中的功效，来强化武器的奇术。"
        },
        {
          "role": "翰学",
          "text": "世上第一枚摩拉，一定蕴含着最强的力量。所以我的下一本历史著作，就是要大胆论证我十年来潜心研究的最新成果！"
        },
        {
          "role": "翰学",
          "text": "那就是——岩王爷用这枚摩拉作为触媒，强化了一刀一剑。"
        },
        {
          "role": "派蒙",
          "text": "一刀一剑？"
        },
        {
          "role": "翰学",
          "text": "哼哼哼，到时就请购买著作阅读全文了。现在我只揭秘一小部分：得到刀就可以成为璃月至尊，拔出剑就可以加冕璃月之王——"
        },
        {
          "role": "钟离",
          "text": "…不敢苟同。"
        },
        {
          "role": "翰学",
          "text": "嗯？"
        },
        {
          "role": "钟离",
          "text": "且不提这刀剑考据的真实性…所谓摩拉，所谓金钱，诞生的初衷，只是一种方便「契约」签立的筹码而已。"
        },
        {
          "role": "钟离",
          "text": "引导人类利用摩拉进行交易，才是帝君本意。"
        },
        {
          "role": "钟离",
          "text": "想必「世上第一枚摩拉」，也只是被帝君当作普通的钱币，简简单单地花掉了吧…"
        },
        {
          "role": "逸轩",
          "text": "唔…我觉得翰学先生的假说很有道理，倒是这位钟离先生，无凭无据的，就这么看轻岩王爷的深远谋划？"
        },
        {
          "role": "钟离",
          "text": "不…我的说法不含褒贬，只是在陈述一种事实。"
        },
        {
          "role": "翰学",
          "text": "得了吧，是你懂岩王爷还是我懂岩王爷？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他、他其实…",
              "dialogues": []
            },
            {
              "text": "也许没人比他更懂…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "钟离",
          "text": "历史之事，我只略通一二，岂敢自诩。但如果观念没有分歧，研讨也就失去了意义。"
        },
        {
          "role": "逸轩",
          "text": "那我问你，千百年前，璃月港大兴土木，岩王爷传授人民建筑技艺。他使用的示范模型，全是用摩拉熔铸的，对吧？"
        },
        {
          "role": "钟离",
          "text": "确有此事。"
        },
        {
          "role": "翰学",
          "text": "好，你说，如果不是因为看重摩拉的神力特质，岩王爷又为何要做出如此奢侈的行为？"
        },
        {
          "role": "钟离",
          "text": "这很容易解释。因为对帝君来说，摩拉是最容易获得的，成本最低的材料。"
        },
        {
          "role": "翰学",
          "text": "唔、唔…"
        },
        {
          "role": "旅行者",
          "text": "就像在说别人的故事一样。"
        },
        {
          "role": "钟离",
          "text": "呵呵，本来就是岩王帝君的故事啊。"
        },
        {
          "role": "宛烟",
          "text": "……"
        },
        {
          "role": "宛烟",
          "text": "这位先生！那个…我有些考古学方面的问题，想换一个安静的地方，向你请教。不知会不会打扰先生？"
        },
        {
          "role": "钟离",
          "text": "哦，这倒无妨。不过，不知我的这位朋友方便一起来吗？说不定她能提供更多帮助。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我吗？",
              "dialogues": []
            },
            {
              "text": "就当作来听听故事吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宛烟",
          "text": "先生都这么说了，那当然欢迎！我们走吧。"
        },
        {
          "type": "subtitle",
          "text": "去船尾了解宛烟的问题"
        },
        {
          "role": "宛烟",
          "text": "接下来说的话，对岩神有些不敬，会招来很多白眼，所以…还是安静的地方比较好。"
        },
        {
          "role": "宛烟",
          "text": "方才见先生谈吐不凡，思维清晰，最关键的是不轻信吹嘘与演绎，非常客观。"
        },
        {
          "role": "宛烟",
          "text": "所以我想问先生一个问题，或许能得到与普通学者不同的答案…先生觉得，被岩神杀死的魔神，全都是邪恶的吗？"
        },
        {
          "role": "钟离",
          "text": "…善与恶，暂且不论。岩王帝君尊重「契约」，所以死于他手的魔神，一定是打破了某种「契约」。"
        },
        {
          "role": "派蒙",
          "text": "嗯，至少滥杀无辜这种事，岩王爷是不会做的吧。"
        },
        {
          "role": "宛烟",
          "text": "可是，我在考古的时候，了解到一些关于「盐之魔神」的传说。"
        },
        {
          "role": "宛烟",
          "text": "「盐之魔神」赫乌莉亚…她是一位善良的魔神，却还是在战争中被摩拉克斯…"
        },
        {
          "role": "宛烟",
          "text": "被摩拉克斯，用不光彩的手段…暗杀了。"
        },
        {
          "role": "派蒙",
          "text": "啊？不会吧！"
        },
        {
          "role": "钟离",
          "text": "这…确实是说来话长的一段历史。但故事的真相，可能并不是你想知道的那种。"
        },
        {
          "role": "宛烟",
          "text": "没关系，请把你知道的历史都告诉我吧！这件事…这件事，我已经调查很久了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "钟离看起来有点为难。",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "不…只是，该从哪里说起呢。"
                }
              ]
            },
            {
              "text": "是这么复杂的故事吗？",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "嗯，不知该从哪里说起。"
                }
              ]
            }
          ]
        },
        {
          "role": "克列门特",
          "text": "哦，在这在这！钟离先生！哎呀，找了好久，没想到你在这里。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "愚人众？！",
              "dialogues": []
            },
            {
              "text": "老实点！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "放下武器！保持距离！不然…不然我要报告千岩军了！"
        },
        {
          "role": "克列门特",
          "text": "首先我就没有拿武器啊？！"
        },
        {
          "role": "克列门特",
          "text": "呃…反应不用这么激烈，我是至冬国来的考古研究员，不是来找麻烦的。"
        },
        {
          "role": "派蒙",
          "text": "愚人众每次都这么说…"
        },
        {
          "role": "克列门特",
          "text": "这次，已经和璃月总务司报备过了。你们想看的话，我这里有官方的许可文书。"
        },
        {
          "role": "克列门特",
          "text": "我会在璃月进行一段时间的考古勘探，所有的勘探结果，都会和官方共享。"
        },
        {
          "role": "克列门特",
          "text": "而我听说，往生堂有位客卿，名叫钟离，博古通今，知识渊博。我就向往生堂支付了重金，聘请他当我的顾问。"
        },
        {
          "role": "钟离",
          "text": "也就是说，是往生堂的工作，对吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么办？",
              "dialogues": []
            },
            {
              "text": "我觉得谨慎一点比较好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "钟离",
          "text": "既然是工作，那就没办法了。身为往生堂的客卿，就要尊重这个身份。"
        },
        {
          "role": "克列门特",
          "text": "果然是通情达理之人！那我们现在就出发吧！"
        },
        {
          "role": "宛烟",
          "text": "稍等，如果是考古的话，我也可以一起去吗？我也是考古学家，可以提供很多帮助。"
        },
        {
          "role": "钟离",
          "text": "那刚刚的话题，路上有机会再继续讲吧。对了，荧，你也一起来吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么？",
              "dialogues": []
            },
            {
              "text": "其实我不太懂考古。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "钟离",
          "text": "接下来的经历，或许会对你未来的旅途有所帮助。"
        },
        {
          "role": "钟离",
          "text": "那是七神体系建立之前的故事…虽然魔神已逝，不可能是你的寻访目标，但至少，也能为你的旅行见闻增添一些意义。"
        },
        {
          "role": "克列门特",
          "text": "等等，这是考古小队，不是观光团！人太多了！"
        },
        {
          "role": "钟离",
          "text": "可是，我这位朋友，有一项无人能及的寻宝天赋，对我们的考古之行大有裨益。"
        },
        {
          "role": "克列门特",
          "text": "哦？什么天赋呢？"
        },
        {
          "role": "钟离",
          "text": "——绝不会漏过任何一个视线之内的宝箱。"
        },
        {
          "role": "派蒙",
          "text": "我也擅长这个！"
        },
        {
          "role": "克列门特",
          "text": "…确实有点吸引力，行吧行吧。"
        },
        {
          "role": "克列门特",
          "text": "事不宜迟，我们先去看看，不久前那位「漩涡之魔神」被群玉阁镇压时，会不会有什么东西冲刷上岸？"
        },
        {
          "role": "克列门特",
          "text": "古物也好，痕迹也好，要是有一点点魔神肢体的碎片就更好了…总之，说不定能有大收获呢。"
        }
      ]
    },
    {
      "story_id": 11021,
      "title": "漩涡之遗",
      "description": "偶遇钟离之后，你得知愚人众克列门特正在组建考古小队，除了自告奋勇加入的考古学家宛烟之外，钟离也被聘请成为顾问。虽然你信不过愚人众，但在钟离的邀请下，你还是加入了这支考古小队，而你们的第一个调查目标，则是「漩涡之魔神」奥赛尔。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "一同前往孤云阁"
        },
        {
          "type": "subtitle",
          "text": "与众人交谈"
        },
        {
          "role": "克列门特",
          "text": "唔，这地方，怎么看起来这么普通…真的能找到有价值的东西吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯？我觉得挺壮观的呀。"
        },
        {
          "role": "克列门特",
          "text": "我不是说风景，而是…既然发生了一场大战，总该有些不同寻常的地方吧，但现在，唉，甚至不知道该从哪儿找起。"
        },
        {
          "role": "钟离",
          "text": "此处名为孤云阁，如果想要研究魔神，或是魔神战争时期的历史，这里都是绝佳的场所。"
        },
        {
          "role": "钟离",
          "text": "相传，岩王帝君以岩为枪，投入此片海域，将魔神刺穿并镇压。"
        },
        {
          "role": "钟离",
          "text": "那些岩枪经历了长年的风化，最终形成了此番别致的景象。"
        },
        {
          "role": "派蒙",
          "text": "这、这么大的山，居然是岩王爷的武器？"
        },
        {
          "role": "钟离",
          "text": "如今残存于我们眼前的，不过冰山一角。当年帝君投下的岩枪，无论数量还是体积，都远超于此。"
        },
        {
          "role": "钟离",
          "text": "只不过因为角度各异，柱体又过于巨大，受到海水侵蚀，或是重力影响，很多都整体沉入了海底。"
        },
        {
          "role": "钟离",
          "text": "所以，除了后来的风化，起初的崩落也是孤云阁的重要成因之一。"
        },
        {
          "role": "克列门特",
          "text": "那…能和这么夸张的力量对抗的魔神，应该也很强吧。"
        },
        {
          "role": "钟离",
          "text": "是的，这就是孤云阁的研究价值所在。"
        },
        {
          "role": "钟离",
          "text": "与那段历史有关的物件大多沉于深海，但「漩涡之魔神」掀起了滔天巨浪，也给了这些东西重见天日的机会。"
        },
        {
          "role": "克列门特",
          "text": "也就是说，只要仔细找找，肯定就能赚得盆满钵满…"
        },
        {
          "role": "克列门特",
          "text": "啊，我是说，肯定会收获颇丰，是吧？这我就安心了。"
        },
        {
          "role": "克列门特",
          "text": "反正带了这么多人，我觉得分头寻找效率会更高。"
        },
        {
          "role": "钟离",
          "text": "嗯，那么，我和我的这位朋友同行吧，虽然我略懂一些杂学，但在专业的考古学家面前，还是不班门弄斧了。"
        },
        {
          "role": "宛烟",
          "text": "欸？我、我吗？"
        },
        {
          "role": "克列门特",
          "text": "怎么啦？这不是你的本职工作，有必要这么惊讶吗？"
        },
        {
          "role": "宛烟",
          "text": "我知道了…那、那我就为他带路了。"
        },
        {
          "role": "钟离",
          "text": "嗯，如果收集到了什么珍贵或者稀奇的东西，我想想…就到对岸汇合吧。"
        },
        {
          "role": "钟离",
          "text": "那古老的魔神，应该留下了不少元素痕迹，追踪痕迹应该会事半功倍。"
        },
        {
          "role": "派蒙",
          "text": "荧，那就交给你啦，用「元素视野」看一看吧。"
        },
        {
          "type": "subtitle",
          "text": "使用「元素视野」寻找古物"
        },
        {
          "type": "subtitle",
          "text": "击败周围的敌人，打开宝箱"
        },
        {
          "role": "派蒙",
          "text": "为什么这里也有敌人啊！"
        },
        {
          "role": "钟离",
          "text": "因为孤云阁本来就是镇压魔神的地方，魔神的残渣至今还影响着这里。"
        },
        {
          "type": "subtitle",
          "text": "继续用「元素视野」寻找古物"
        },
        {
          "type": "subtitle",
          "text": "击败幻形兽，回收古物"
        },
        {
          "role": "派蒙",
          "text": "它们⋯为什么会聚集在这里？"
        },
        {
          "role": "钟离",
          "text": "可能是中间的那件东西，残留了魔神的力量，所以对它们很有吸引力吧。"
        },
        {
          "role": "钟离",
          "text": "不过，水生的幻形兽啊。唔，总之，「契约」在身，个人喜悉就要放在一边。打败它们，回收遗物吧。"
        },
        {
          "role": "钟离",
          "text": "原来只是一块石板…不过纹饰着实独特。"
        },
        {
          "role": "钟离",
          "text": "这样应该就足够分析出一些信息了，我们回去吧。"
        },
        {
          "type": "subtitle",
          "text": "与另一队汇合"
        },
        {
          "role": "克列门特",
          "text": "…你这也叫考古学家？！这也看不出来，那也不认识，你到底行不行啊！"
        },
        {
          "role": "宛烟",
          "text": "术、术业有专攻不是很正常的事吗！我已经很努力地讲解了！"
        },
        {
          "role": "派蒙",
          "text": "别吵架别吵架，到底发生什么了啊？"
        },
        {
          "role": "克列门特",
          "text": "这家伙，口口声声说自己是考古学家，却对这周围的遗迹一窍不通！还没有我懂得多！"
        },
        {
          "role": "克列门特",
          "text": "我只能靠直觉…我是说，经验，带了点好像有价值的东西回来。唉，真是耽误时间！"
        },
        {
          "role": "宛烟",
          "text": "我…我一直都在研究「盐之魔神」，对海里的东西不懂，也很正常吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（作为学者，确实有点奇怪…）",
              "dialogues": []
            },
            {
              "text": "（专注一个领域，也不该缺乏通识…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宛烟",
          "text": "倒是你，一直在问我这个值多少摩拉、那个值多少摩拉！文物的价值难道就是摩拉吗！"
        },
        {
          "role": "克列门特",
          "text": "这、这…文物的价值，用摩拉来衡量，不是最直白吗！也很符合璃月的传统吧！"
        },
        {
          "role": "钟离",
          "text": "没关系，两位稍安勿躁，我们倒是带回来了一些不错的东西，可以一起看看。"
        },
        {
          "role": "钟离",
          "text": "唔…"
        },
        {
          "role": "钟离",
          "text": "很遗憾，你们带回来的这些东西，虽然确实是被「漩涡之魔神」带上岸的，可惜都与魔神无关，只是出自附近海域而已。"
        },
        {
          "role": "钟离",
          "text": "相比之下，还是我们找到的这块石板，表面有神秘的纹饰，且微存魔神之力，或许会对研究有所帮助。"
        },
        {
          "role": "克列门特",
          "text": "快、快把它给我！"
        },
        {
          "role": "克列门特",
          "text": "嘿嘿，有了这个，就不算毫无收获了。魔神的力量，哼哼，这个才是好东西啊…"
        },
        {
          "role": "克列门特",
          "text": "咳咳，但是，这其他的东西应该也还值几个钱，能收回雇佣顾问的成本——都归我了！"
        },
        {
          "role": "派蒙",
          "text": "一定要有魔神的力量残留在上面，才有研究的价值吗？"
        },
        {
          "role": "宛烟",
          "text": "不是的，我追寻「盐之魔神」的历史，是因为历史能讲述文化，还有信仰…"
        },
        {
          "role": "宛烟",
          "text": "至于你，就只是想借考古的名义发财吧！"
        },
        {
          "role": "克列门特",
          "text": "胡说！我是至冬国的专业考古研究员，如假包换！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（不，就是想借考古的名义发财吧…）",
              "dialogues": []
            },
            {
              "text": "（不，是想收集魔神残余的力量吧…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "钟离",
          "text": "哦，对了，那个茶杯，最好别卖掉。"
        },
        {
          "role": "克列门特",
          "text": "啊？为什么？"
        },
        {
          "role": "钟离",
          "text": "那不是古代的东西，是凝光的收藏，跟着群玉阁一起掉下来的。如果你不想惹恼七星的话…"
        },
        {
          "role": "克列门特",
          "text": "呃，我知道了…明明我看成色还不错。"
        },
        {
          "role": "宛烟",
          "text": "你看，你就是想拿去卖钱！"
        },
        {
          "role": "克列门特",
          "text": "那、那又怎么样！研究和卖钱，二者兼顾不好吗？脑筋这么死板干什么！"
        },
        {
          "role": "克列门特",
          "text": "好！接下来就没必要待在这里了。对了，那个「盐之魔神」，我也挺感兴趣，下一站就去「地中之盐」吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "宛烟",
          "text": "你啊！简直掉进钱眼里了！"
        },
        {
          "role": "克列门特",
          "text": "你才是，天天挖文物，脑子里进灰了吧！"
        },
        {
          "role": "派蒙",
          "text": "还、还在吵…我们别打扰了吧…"
        }
      ],
      "collapse_ranges": [
        [
          65,
          68
        ]
      ]
    },
    {
      "story_id": 11022,
      "title": "深锁之迹",
      "description": "孤云阁一行，关于「漩涡之魔神」奥赛尔的收获寥寥，克列门特和宛烟还因为观念不同发生了激烈的争吵，这都让克列门特很不开心。他在争吵中听到宛烟提起了「盐之魔神」的故事,为了不让此行一无所获，他决定带队前往地中之盐碰碰运气。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "一同前往地中之盐"
        },
        {
          "type": "subtitle",
          "text": "与众人交谈"
        },
        {
          "role": "克列门特",
          "text": "我听说，「地中之盐」曾经是「盐之魔神」的子民生活的地方，所以，嘿嘿…有价值的文物应该遍地都是吧。"
        },
        {
          "role": "钟离",
          "text": "传说中，在「盐之魔神」赫乌莉亚的庇护下，她的子民的确享受过一段时间的富庶生活。"
        },
        {
          "role": "钟离",
          "text": "不过这个传说流传了很长时间，光顾此处的拾荒者与盗宝团不计其数，野外应该不会剩下多少有价值的东西。"
        },
        {
          "role": "克列门特",
          "text": "啧，真扫兴…早知道这么穷酸就不来了。"
        },
        {
          "role": "宛烟",
          "text": "关于这个，我知道在这洞穴深处有一处遗迹，和「盐之魔神」有关。其实那也是「地中之盐」这个名字最初的由来。"
        },
        {
          "role": "宛烟",
          "text": "只不过，这个遗迹的入口，被神秘的力量封印了，一直都没有人能够解开。"
        },
        {
          "role": "宛烟",
          "text": "所以目前，封印的由来和解除方法，都是「盐之魔神」的研究中，非常重要的课题。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "和子民有关？",
              "dialogues": []
            },
            {
              "text": "和帝君有关？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宛烟",
          "text": "不知道，没有切实的证据。但封印存在的意义，多半是为了隐藏某种事实。"
        },
        {
          "role": "宛烟",
          "text": "「盐之魔神」善良仁慈，被众人爱戴，也有很强的权能，不会留下什么见不得人的东西。"
        },
        {
          "role": "宛烟",
          "text": "那…想要藏匿事实的，很可能就是凶手，摩拉克斯。"
        },
        {
          "role": "派蒙",
          "text": "这不像是岩王爷会干出来的事…"
        },
        {
          "role": "克列门特",
          "text": "这种事无所谓了，这么听起来，遗迹里面一定还放着「盐之魔神」的各种宝物？！"
        },
        {
          "role": "宛烟",
          "text": "你究竟有没有听人说话，唉…里面就算有「盐之魔神」的遗物，解不开封印又有谁进得去呢？"
        },
        {
          "role": "克列门特",
          "text": "哎呀，我们不是有钟离先生在嘛！他看起来什么都懂，一个封印而已，难不倒他的。"
        },
        {
          "role": "宛烟",
          "text": "这个封印已经存在很长时间了，关于它的一切都是谜，就算是钟离先生也…"
        },
        {
          "role": "钟离",
          "text": "——略懂门道。"
        },
        {
          "role": "宛烟",
          "text": "…欸？欸欸？！"
        },
        {
          "role": "钟离",
          "text": "坊间传闻中，流传着诸多与封印有关的碎片，看似杂乱无章，但其实暗含解印之法。"
        },
        {
          "role": "钟离",
          "text": "宛烟女士方才提到有一个可能和解封有关的机关，我们不妨就先去看看。"
        },
        {
          "role": "宛烟",
          "text": "那…既然钟离先生这么说，好吧，那我来带路。"
        },
        {
          "type": "subtitle",
          "text": "前往第一处机关所在地"
        },
        {
          "type": "subtitle",
          "text": "寻找能完整看到残骸上图案的位置"
        },
        {
          "role": "宛烟",
          "text": "虽然我找到了一个可能和解封有关的机关，但即便解开了那个，封印还是纹丝不动。"
        },
        {
          "role": "宛烟",
          "text": "就是这里了，此处散落了一些残骸，如果组合起来，特别像和「盐之魔神」有关的东西。"
        },
        {
          "role": "宛烟",
          "text": "参照一旁的提示，从某个特殊的角度看过去，就能破解这个机关了。"
        },
        {
          "role": "宛烟",
          "text": "看吧，虽然机关确实是解开了，但封印那边并没有什么动静…"
        },
        {
          "role": "钟离",
          "text": "那是因为，其实还有另一重机关，需一并开启。"
        },
        {
          "role": "宛烟",
          "text": "另、另一重是指？"
        },
        {
          "role": "钟离",
          "text": "接下来，就由我来引路吧。"
        },
        {
          "type": "subtitle",
          "text": "前往第二处机关所在地"
        },
        {
          "role": "宛烟",
          "text": "这个地方…啊，我想起来了，好像是有几个奇怪的元素方碑。原来是有联系的…"
        },
        {
          "role": "宛烟",
          "text": "怪不得，以前为了调查这个封印，我还专门请来了持有「神之眼」的人。"
        },
        {
          "role": "宛烟",
          "text": "结果方碑被点亮之后什么都没发生，然后就熄灭了…"
        },
        {
          "role": "钟离",
          "text": "实际上，不仅是需要同时启动，这里的石碑如果不按照正确的顺序点亮，依旧无法解开封印。"
        },
        {
          "role": "钟离",
          "text": "此处的玄机，藏于一句讲述魔神战争的话中。"
        },
        {
          "role": "钟离",
          "text": "「南出天衡，东入瑶光，西登绝云，北访轻策，诸地萧条，生灵涂炭。璃月广袤，竟难容一处安宁。」"
        },
        {
          "role": "克列门特",
          "text": "南出…东什么？璃月人说话怎么这么难懂！"
        },
        {
          "role": "宛烟",
          "text": "我、我好像对这句话有印象！"
        },
        {
          "role": "钟离",
          "text": "没错，这句话讲述的内容，也和「盐之魔神」有关。"
        },
        {
          "role": "钟离",
          "text": "这位善良仁慈的神，为了给饱受战乱之苦的人类，提供一个安全的去处，冒着危险走遍了璃月各地。"
        },
        {
          "role": "钟离",
          "text": "那个年代，诸神交战，战火纷飞，哪怕只是片刻的和平，都是一种奢侈。"
        },
        {
          "role": "钟离",
          "text": "而她最终寻到的——就是现在被我们称为「地中之盐」的这块土地。"
        },
        {
          "role": "宛烟",
          "text": "可惜…这份安宁，最后还是被摩拉克斯打破了。"
        },
        {
          "role": "克列门特",
          "text": "别再说这些古时候的故事了，既然有了线索，赶快打开封印吧，快点快点！只要能打开封印，怎么都行！"
        },
        {
          "role": "钟离",
          "text": "旅行者，天衡在南，瑶光在东，绝云在西，轻策在北。"
        },
        {
          "role": "钟离",
          "text": "有了这些提示，你一定有眉目了吧？"
        },
        {
          "type": "subtitle",
          "text": "根据钟离提示，点亮附近的方碑"
        },
        {
          "role": "宛烟",
          "text": "快看！封印真的被打开了！不愧是钟离先生！"
        },
        {
          "role": "钟离",
          "text": "略懂一二而已。"
        },
        {
          "role": "钟离",
          "text": "尘封已久的秘密，是时候为人知晓了。"
        },
        {
          "type": "subtitle",
          "text": "前往封印解除的地方"
        },
        {
          "role": "钟离",
          "text": "在进入遗迹之前，我有个提议，可以避免在孤云阁那样无谓的争吵。"
        },
        {
          "role": "宛烟",
          "text": "嗯，先生请讲。"
        },
        {
          "role": "钟离",
          "text": "请你们二位签订契约。契约的内容是：「顺次取物，每次一件」。"
        },
        {
          "role": "钟离",
          "text": "为示诚意，你们选取即可，不用把我列入序列。"
        },
        {
          "role": "旅行者",
          "text": "我也不用了。"
        },
        {
          "role": "派蒙",
          "text": "喂喂喂，这么好的机会，不要放弃得这么快嘛！"
        },
        {
          "role": "克列门特",
          "text": "我不同意！这意思是…我要和这个半吊子考古学家，平分收获？不可能！绝对不可能！"
        },
        {
          "role": "宛烟",
          "text": "我不同意！哼！他就只会糟蹋「盐之魔神」留下的文物吧！我，我也不能接受。"
        },
        {
          "role": "钟离",
          "text": "那么…若「契约」不能成立，我就不能继续担当顾问了。"
        },
        {
          "role": "钟离",
          "text": "这遗迹中藏着什么宝物和陷阱，就全凭两位的阅历去鉴别。"
        },
        {
          "role": "克列门特",
          "text": "这、这…唉，这家伙我真的信不过。行吧，既然是被封印的「盐之魔神」的遗迹，就算只能拿一半，也够赚了。"
        },
        {
          "role": "宛烟",
          "text": "要我答应契约…也行。我只有一个要求，钟离先生。"
        },
        {
          "role": "宛烟",
          "text": "如果发现了「盐之魔神」的真相，请你一定要公正地判断，就算那真相是对摩拉克斯不利的。"
        },
        {
          "role": "钟离",
          "text": "交换条件如此，我可以接受。"
        },
        {
          "role": "钟离",
          "text": "那么，我们走吧。"
        }
      ]
    },
    {
      "story_id": 11023,
      "title": "慈盐之末",
      "description": "借助钟离的知识，你们顺利地解开了封印，但在进入遗迹之前，钟离向宛烟与克列门特提出了一个契约：「顺次取物，每次一件」。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "向下进入洞穴"
        },
        {
          "type": "subtitle",
          "text": "探索洞穴，进入遗迹"
        },
        {
          "role": "宛烟",
          "text": "这、这是…「雕像」？"
        },
        {
          "role": "钟离",
          "text": "不。他们是人。"
        },
        {
          "role": "克列门特",
          "text": "啊？！"
        },
        {
          "role": "钟离",
          "text": "这些人，恐怕是当年「盐之魔神」的信徒吧。"
        },
        {
          "role": "克列门特",
          "text": "怎么会弄成这样的…？"
        },
        {
          "role": "宛烟",
          "text": "遗迹深处…究竟藏着什么？"
        },
        {
          "type": "subtitle",
          "text": "向前探索，寻找魔神古物"
        },
        {
          "role": "宛烟",
          "text": "这个里面，有装了一半的盐。"
        },
        {
          "role": "克列门特",
          "text": "不过就是个盐罐子而已，看来「盐之魔神」是个穷酸的魔神啊。"
        },
        {
          "role": "钟离",
          "text": "据我了解，它并不普通。虽然只有一半，但永远都有一半——换句话说，就是无尽。"
        },
        {
          "role": "克列门特",
          "text": "什么？！我就算一直往外面倒，里面的盐也不会减少吗！"
        },
        {
          "role": "钟离",
          "text": "正是。"
        },
        {
          "role": "宛烟",
          "text": "能够产生无穷无尽的盐，果然，「盐之魔神」所拥有的权能是很强大的！"
        },
        {
          "role": "克列门特",
          "text": "折腾了这么久，终于让我遇到宝贝了！这东西归我了！"
        },
        {
          "role": "克列门特",
          "text": "我只需要把盐倒出来，搞个几千几万袋，靠卖盐都能发财了！"
        },
        {
          "role": "宛烟",
          "text": "喂！「盐之魔神」的遗产，怎么可以用来做这么肤浅的事！"
        },
        {
          "role": "钟离",
          "text": "如果克列门特先生想要这个盐盏，那么按照契约，下一件物品，就是属于宛烟女士的。"
        },
        {
          "role": "克列门特",
          "text": "没问题没问题，哼哼，怎么会有比这个还值钱的东西呢？"
        },
        {
          "role": "宛烟",
          "text": "既然有「契约」，我也没必要和他争抢…"
        },
        {
          "role": "钟离",
          "text": "那么，我们继续前进吧。"
        },
        {
          "type": "subtitle",
          "text": "继续向前探索与寻找"
        },
        {
          "role": "克列门特",
          "text": "哼，一把尺子而已，看起来就没什么用。"
        },
        {
          "role": "宛烟",
          "text": "这是…我记得没错的话，这个应该是一种量器？"
        },
        {
          "role": "钟离",
          "text": "确实如此。但「盐之魔神」亦有权能在此。"
        },
        {
          "role": "钟离",
          "text": "这盐尺一旦插进地面，土壤之上就会像涨水那样，被盐覆盖。"
        },
        {
          "role": "钟离",
          "text": "越是深入，盐粒就会越多，换言之，就是盐的「丰收」。"
        },
        {
          "role": "克列门特",
          "text": "这、这…这不是比盐盏还要厉害？！"
        },
        {
          "role": "钟离",
          "text": "那么，按照契约，这盐尺就属于宛烟女士了。"
        },
        {
          "role": "克列门特",
          "text": "不行！我不同意！钱是我出的，这场探索也是我组织的，凭什么要我吃亏！"
        },
        {
          "role": "克列门特",
          "text": "而且这小姑娘一点用都没有，为什么要把东西送给她！"
        },
        {
          "role": "派蒙",
          "text": "他果然还是这么做了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "唉…",
              "dialogues": []
            },
            {
              "text": "既然说了这种话…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "钟离",
          "text": "那也就是，你想破坏「契约」了？"
        },
        {
          "role": "克列门特",
          "text": "破坏又怎么样？这遗迹里的机关，我也差不多看明白了。所以，你已经没用了。"
        },
        {
          "role": "克列门特",
          "text": "说到底，我是雇佣你的人。凭什么我要按照你的规矩来做事？"
        },
        {
          "role": "钟离",
          "text": "因为你立下了契约。"
        },
        {
          "role": "钟离",
          "text": "岩王帝君曾说，「契约既成，食言者当受食岩之罚。」"
        },
        {
          "role": "克列门特",
          "text": "那是你们璃月的神，我是至冬来的，我…"
        },
        {
          "role": "钟离",
          "text": "「食岩之罚」，你自己感受一下吧…可不会太轻松的。"
        },
        {
          "type": "subtitle",
          "text": "惩罚克列门特"
        },
        {
          "role": "钟离",
          "text": "你的收获，也由我没收了。"
        },
        {
          "role": "钟离",
          "text": "你没有继续前进的资格了，就这样离开吧。"
        },
        {
          "role": "克列门特",
          "text": "可恶…你给我等着！"
        },
        {
          "type": "subtitle",
          "text": "与钟离和宛烟交谈"
        },
        {
          "role": "派蒙",
          "text": "说是考古勘探，终于还是装不下去了呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "幸好早有提防。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "就是，幸好我已经有敏锐的嗅觉了。"
                }
              ]
            },
            {
              "text": "以后派蒙可别变成他那样。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我喜欢摩拉，但我不干坏事！"
                }
              ]
            }
          ]
        },
        {
          "role": "钟离",
          "text": "克列门特的错误，在于贪欲。但在贪欲之外，也还有许多令人想要违背契约的诱惑。"
        },
        {
          "role": "钟离",
          "text": "面对「渴望之物」，究竟有多少人能够克制欲望、遵循契约…"
        },
        {
          "role": "钟离",
          "text": "不如，就趁这个机会讲清楚吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯？要讲什么？"
        },
        {
          "role": "钟离",
          "text": "这一个临时的考古小队，其实没有人是来「考古」的。"
        },
        {
          "role": "宛烟",
          "text": "为、为什么这么说？"
        },
        {
          "role": "钟离",
          "text": "这位女士，你缺乏最基本的考古常识，文物也不识几件，但在「盐之魔神」上的知识，又特别精通。"
        },
        {
          "role": "钟离",
          "text": "比起考古与文物，还是「盐之魔神」本身，才更让你感兴趣吧。"
        },
        {
          "role": "钟离",
          "text": "你在珠钿舫提到的那些关于盐之魔神的传说，据我所知，是在「银原厅」流传得最多…"
        },
        {
          "role": "宛烟",
          "text": "别、别再说了！"
        },
        {
          "role": "宛烟",
          "text": "…先生你果然博学多才，我鼓起勇气向你提问，看来是正确的选择。"
        },
        {
          "role": "宛烟",
          "text": "——没错，我不是什么考古学家。我来自璃月「七星八门」中的一门，主管盐业的「银原厅」。"
        },
        {
          "role": "宛烟",
          "text": "我们的祖辈，就是在魔神战争席卷大陆的苦难时期里，曾受「盐之魔神」庇护的子民。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说起来，从没听你喊过「帝君」…",
              "dialogues": []
            },
            {
              "text": "说起来，从没听你喊过「岩王爷」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对喔，这样一提醒的话，确实很少有璃月人会把「摩拉克斯」挂在嘴上…"
        },
        {
          "role": "宛烟",
          "text": "在战争中，摩拉克斯暗杀了我们的神！他嫉妒「盐之魔神」的权能，让我们流离失所！"
        },
        {
          "role": "宛烟",
          "text": "我…我们恨他！但璃月是摩拉克斯的璃月，历史一定是任由他粉饰的…"
        },
        {
          "role": "宛烟",
          "text": "所以，我想要证明！摩拉克斯也有罪恶！他手上沾着血，他有残忍无情的一面！"
        },
        {
          "role": "钟离",
          "text": "……"
        },
        {
          "role": "宛烟",
          "text": "我们签过「契约」，要直面真相，对吧，钟离先生！对这件事，你要有公正的判断！"
        },
        {
          "role": "钟离",
          "text": "那是自然。而且，璃月已经不再是摩拉克斯的璃月了。"
        },
        {
          "role": "钟离",
          "text": "跟我走吧，一切答案就在前方。"
        },
        {
          "type": "subtitle",
          "text": "继续深入探索"
        },
        {
          "type": "subtitle",
          "text": "观察房间内的断剑"
        },
        {
          "role": "宛烟",
          "text": "这是…剑吗？"
        },
        {
          "role": "宛烟",
          "text": "啊！是断裂的剑！这就是证据！证明「盐之魔神」曾经是反抗过的！只是没能抵挡摩拉克斯下的毒手！"
        },
        {
          "role": "宛烟",
          "text": "相比「盐盏」和「盐尺」，这「剑」的力量，一定是远远超越它们的！"
        },
        {
          "role": "宛烟",
          "text": "如果能修好这把剑，就能向其他人展示「盐之魔神」曾经的权能了…"
        },
        {
          "role": "派蒙",
          "text": "看起来…确实很像战败之后留下的东西。"
        },
        {
          "role": "钟离",
          "text": "两段断剑，以考古角度来看，是两件文物。按照「顺次取物，每次一件」的契约，你只能带走其中之一。"
        },
        {
          "role": "宛烟",
          "text": "为、为什么？虽说是顺次取物，可是，克列门特已经…"
        },
        {
          "role": "钟离",
          "text": "是的，但是「每次一件」仍然有效。想要同时取走两件文物，是不可以的。"
        },
        {
          "role": "宛烟",
          "text": "这、这…"
        },
        {
          "role": "派蒙",
          "text": "唔…钟离，她不是恶意，也没有争抢，是不是可以通融一下？"
        },
        {
          "role": "钟离",
          "text": "「契约」不可通融，若不遵守，就是破坏。"
        },
        {
          "role": "宛烟",
          "text": "不行！如果只带走一半，那、那就没办法修好，也没办法重现「盐之魔神」的权能…"
        },
        {
          "role": "宛烟",
          "text": "无论如何，为了我对她的信仰…"
        },
        {
          "role": "宛烟",
          "text": "即使是破坏契约，我也在所不惜…"
        },
        {
          "role": "钟离",
          "text": "你已经下定决心了吗？那么，这是有代价的。"
        },
        {
          "role": "派蒙",
          "text": "钟离！"
        },
        {
          "role": "钟离",
          "text": "这就意味着，你要承受「食岩之罚」了。"
        },
        {
          "role": "宛烟",
          "text": "那也…没关系。「盐之魔神」为保护她的信徒，连生命都愿意付出。我的牺牲，微不足道。"
        },
        {
          "role": "宛烟",
          "text": "你要怎样惩罚都没关系，只要让我带回…我信仰的证明！"
        },
        {
          "role": "派蒙",
          "text": "不、不可以打女孩子啊！"
        },
        {
          "role": "钟离",
          "text": "…如果那样就能获得解脱，说不定是更轻松的方法。但…"
        },
        {
          "role": "钟离",
          "text": "作为「惩罚」，我会告诉你「真相」。"
        },
        {
          "role": "宛烟",
          "text": "什么？"
        },
        {
          "role": "宛烟",
          "text": "真相？你说真相…是对我的惩罚？"
        },
        {
          "role": "钟离",
          "text": "是的。接下来你将听到的事实，就是你破坏了「契约」的代价。"
        },
        {
          "role": "钟离",
          "text": "——很遗憾，盐之魔神，赫乌莉亚，并不是一位权能强大的魔神。"
        },
        {
          "role": "钟离",
          "text": "相反，她过于弱小——过于迁就、过于柔弱，是绝无可能登上七神之位的…败者。"
        },
        {
          "role": "宛烟",
          "text": "你说什么…？！"
        },
        {
          "role": "钟离",
          "text": "魔神战争时期，尘世间的魔神们为了争夺提瓦特大陆，拼尽了全部的力量与智慧。"
        },
        {
          "role": "钟离",
          "text": "但赫乌莉亚选择了逃避。她认为只要在争斗发生之前就放弃，战争就永远不会波及到自己和子民。"
        },
        {
          "role": "钟离",
          "text": "可是，在漫长的战争岁月里，「退让」是不会有止境的。"
        },
        {
          "role": "钟离",
          "text": "在无底线的退让中，赫乌莉亚失去了所有土地，只剩下最后的容身之所。"
        },
        {
          "role": "宛烟",
          "text": "不…不…没可能的…"
        },
        {
          "role": "钟离",
          "text": "在她最后的时刻，她连一把能举起来保护子民的兵刃，都没有了。"
        },
        {
          "role": "宛烟",
          "text": "连兵刃都没有？可是，这剑…"
        },
        {
          "role": "钟离",
          "text": "是的，这把断剑并非「盐之魔神」的遗物，而是…杀死她的凶器。"
        },
        {
          "role": "宛烟",
          "text": "凶器…？"
        },
        {
          "role": "宛烟",
          "text": "不！这是假的，你说的都是假的，你想要迷惑我对神明的信心！"
        },
        {
          "role": "钟离",
          "text": "我说过，我只陈述事实。"
        },
        {
          "role": "宛烟",
          "text": "岂有此理！你…你也是摩拉克斯的信徒，你别想骗我！"
        },
        {
          "role": "派蒙",
          "text": "喂！喂，别跑啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "对她来说打击太大了。",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "毕竟，这是惩罚。若非如此，我也不想讲出这么残酷的事。"
                }
              ]
            },
            {
              "text": "钟离说的，的确是「真相」吧。",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "嗯，不然也不会把「真相」当作惩罚了。我也不想讲出这么残酷的事。"
                }
              ]
            }
          ]
        },
        {
          "role": "钟离",
          "text": "我们也继续往深处走吧。在那里…恐怕会有，令她无论如何都不得不接受「真相」的东西。"
        },
        {
          "type": "subtitle",
          "text": "追上宛烟"
        },
        {
          "role": "派蒙",
          "text": "这些「雕像」，是在…逃跑？"
        },
        {
          "role": "派蒙",
          "text": "前面究竟还有什么…"
        },
        {
          "role": "钟离",
          "text": "是盐，还有背叛。"
        },
        {
          "role": "宛烟",
          "text": "…这一路上的，都是什么？"
        },
        {
          "role": "宛烟",
          "text": "他们，看到了什么…又做了什么？"
        },
        {
          "role": "宛烟",
          "text": "然后…又发生了什么？"
        },
        {
          "role": "钟离",
          "text": "既然你无法信任我，那我们就继续向前吧。"
        },
        {
          "role": "钟离",
          "text": "那时候发生的一切，这扇门后留下的痕迹，都会如实记录。"
        },
        {
          "type": "subtitle",
          "text": "与宛烟交谈，见证真相"
        },
        {
          "role": "钟离",
          "text": "这里就是现场，赫乌莉亚形骸溃散，只留下些许盐迹。临终的画面，也定格于此。"
        },
        {
          "role": "宛烟",
          "text": "……"
        },
        {
          "role": "钟离",
          "text": "故事的后续是：她的子民中，有人终于意识到，这位仁善却柔弱的魔神，在战争中保护不了任何人。"
        },
        {
          "role": "钟离",
          "text": "魔神战争是很残酷的。与其让她经受战败后的折磨，不如，赐予她相对轻松的解脱。"
        },
        {
          "role": "派蒙",
          "text": "可是，这些「雕像」…又是怎么回事？"
        },
        {
          "role": "钟离",
          "text": "再怎么弱小的魔神，死亡时流失的力量，也非凡人之躯所能承受。"
        },
        {
          "role": "钟离",
          "text": "没能逃走的人，全都变成了这副模样。"
        },
        {
          "role": "钟离",
          "text": "未经此灾的盐神子民离开了她的领地，前往璃月，请求岩王帝君的庇护。"
        },
        {
          "role": "钟离",
          "text": "他们的后代害怕赫乌莉亚留下的魔神残渣，害怕她施予他们永世的诅咒…"
        },
        {
          "role": "钟离",
          "text": "于是，他们冒着危险回到这里，将剑折断、供奉，希望能够平息她留下的怒火。"
        },
        {
          "role": "钟离",
          "text": "但其实他们是多此一举了。这位直到最后都没有反抗过的魔神，又怎么会对自己的子民…心怀忿怒呢？"
        },
        {
          "role": "宛烟",
          "text": "我…我…就算是这样，我不接受…"
        },
        {
          "role": "宛烟",
          "text": "骗局…虚假的历史…一切…都…"
        },
        {
          "role": "宛烟",
          "text": "别想动摇…我的信仰…"
        },
        {
          "role": "宛烟",
          "text": "（少女跑开）"
        },
        {
          "role": "派蒙",
          "text": "这一次，钟离也真是不留情呢…"
        },
        {
          "role": "钟离",
          "text": "这就是她要付出的代价了，但…这也并不失为一件好事。"
        },
        {
          "role": "钟离",
          "text": "看她的模样，恐怕还会继续动摇一阵…不过，即使不能马上解脱，只是认清现实，也还不错。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你对盐之魔神的遭遇太熟悉了。",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "嗯，在很久很久以前，赫乌莉亚的故事对我来说，也是一份告诫。"
                }
              ]
            },
            {
              "text": "解印的办法，不只是道听途说吧。",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "真是敏锐，不过…也只是因为我活得比较长而已。"
                }
              ]
            }
          ]
        },
        {
          "role": "钟离",
          "text": "信仰一位已经逝去的神，实在没有什么好处。"
        },
        {
          "role": "钟离",
          "text": "…不论是对赫乌莉亚的信仰，还是对摩拉克斯的信仰，都是一样的。"
        },
        {
          "role": "旅行者",
          "text": "璃月人总有一天也会明白的。"
        },
        {
          "role": "钟离",
          "text": "好了。接下来，陪我去一趟「孤云阁」如何？"
        },
        {
          "role": "派蒙",
          "text": "嗯？钟离要做什么？"
        },
        {
          "role": "钟离",
          "text": "唉…"
        },
        {
          "role": "钟离",
          "text": "重游故地，又讲了这么多故事…"
        },
        {
          "role": "钟离",
          "text": "难免对那些故人，心生怀念了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "观察雕像",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（看上去有点诡异的雕像，似乎是用盐做的。）",
                  "narration": true
                }
              ]
            },
            {
              "text": "观察盐化信徒",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（他定格在了一个虔诚的姿势。不对，也有可能是…害怕？）",
                  "narration": true
                }
              ]
            },
            {
              "text": "观察盐化信徒",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（他拼命地想要逃离什么，多半是预感到有大事将要发生了。）",
                  "narration": true
                }
              ]
            },
            {
              "text": "观察盐化信徒",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（他手里原本应该握着什么，摆出了非常用力的姿势。看来，多半就是他了…）",
                  "narration": true
                }
              ]
            },
            {
              "text": "观察盐花",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "（一切的中心，无论曾有什么存在于此，如今只留下了盐花。）",
                  "narration": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "story_id": 11024,
      "title": "万象之录",
      "description": "遗迹之内，克列门特和宛烟都因为各自的原因违背了契约，作为惩罚，克列门特被剥夺了收获，赶出了遗迹，而宛烟，则是得知了令她信仰幻灭的真相——「盐之魔神」因为过于善良与软弱，招来了背叛与灭亡。作为见证者，心情复杂的你，跟随钟离回到了孤云阁。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "抵达孤云阁，与钟离交谈"
        },
        {
          "role": "钟离",
          "text": "之前对你提过，孤云阁之下，镇压了很多旧日的魔神。"
        },
        {
          "role": "钟离",
          "text": "如今仙众已将璃月交给凡人，而赫乌莉亚的时代，是更久远的过去。她留下的「盐盏」与「盐尺」，不应该回到璃月港。"
        },
        {
          "role": "钟离",
          "text": "让它们留在这里，既是沉眠，也是返乡…"
        },
        {
          "role": "旅行者",
          "text": "所以钟离要我做什么呢？"
        },
        {
          "role": "钟离",
          "text": "我亲手终结了一个时代。我一直在想，如何记录那些…被我终结的历史。"
        },
        {
          "role": "钟离",
          "text": "历史可以记录，但历史并不可靠，这次的事也证明了这点。时间拥有强大的力量，历史会在岁月中扭曲…"
        },
        {
          "role": "钟离",
          "text": "我需要找到更好的「记录」，才能铭刻真实的历史。"
        },
        {
          "role": "钟离",
          "text": "刻石曾是一种久远的「记录」。但看似不变的磐石、看似不变的世界与我…或许也都会在某一天消失。"
        },
        {
          "role": "派蒙",
          "text": "钟离…"
        },
        {
          "role": "钟离",
          "text": "所以，旅行者，我想到了你。"
        },
        {
          "role": "钟离",
          "text": "你是远渡重天、跨越星海之人。把历史刻在你的记忆里，就可以在未来某日，随你一同前往别的世界。"
        },
        {
          "role": "钟离",
          "text": "身为旅行者的你，只要能够「记录」，那么，提瓦特的时代与历史，就获得了一种「存在的备份」…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "原来这才是找我同行的理由。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "任重而道远啊。"
                }
              ]
            },
            {
              "text": "原来不是为了让我找宝箱啊。",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "哈哈哈…祝你离开提瓦特以后，在星海之间也能捡到宝箱。"
                },
                {
                  "role": "钟离",
                  "text": "我有「财富之神」的别号，所以这句话是有效力的。"
                }
              ]
            }
          ]
        },
        {
          "role": "钟离",
          "text": "那么，接下来，就是将「盐盏」与「盐尺」投入海中的时刻了。"
        },
        {
          "role": "派蒙",
          "text": "啊？为什么要扔进海里？"
        },
        {
          "role": "钟离",
          "text": "刚才我说过吧？这里镇压了很多旧日的魔神。"
        },
        {
          "role": "钟离",
          "text": "也包括被「群玉阁」重锁深海的「漩涡之魔神」，奥赛尔…"
        },
        {
          "type": "subtitle",
          "text": "过场动画"
        },
        {
          "role": "钟离",
          "text": "数千年前，璃月纷乱不止，"
        },
        {
          "role": "钟离",
          "text": "我与众仙荡涤四方。"
        },
        {
          "role": "钟离",
          "text": "岩枪镇压诸魔神之地，孤云阁…"
        },
        {
          "role": "钟离",
          "text": "历经千载，最终也只留下坊间的掌故与传说。"
        },
        {
          "role": "钟离",
          "text": "奥赛尔…你我是敌非友。"
        },
        {
          "role": "钟离",
          "text": "但旧时代的对立，也只是旧时代的回忆而已。"
        },
        {
          "role": "钟离",
          "text": "赫乌莉亚的遗物，就由你来吞噬吧。"
        },
        {
          "role": "钟离",
          "text": "璃月港的神迹，从此又少了一分。"
        },
        {
          "role": "钟离",
          "text": "…地天之间的万象，只留待后人评说。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（钟离）"
        },
        {
          "role": "钟离",
          "text": "我还想在这里多待一会儿，以后能像此番追忆的机会，只怕会越来越少了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「盐之魔神」，有点可怜…",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "在魔神战争的年代，断定事物善恶是非的标准，都和现在不同。"
                },
                {
                  "role": "钟离",
                  "text": "当然…现在的我，也希望她能生在一个更加温柔的时代。"
                }
              ]
            },
            {
              "text": "遗物会增强奥赛尔的力量吗？",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "虽然「盐盏」与「盐尺」仍具权能，可对奥赛尔来说，不值一提。"
                },
                {
                  "role": "钟离",
                  "text": "若有朝一日他恢复元气，卷土重来…呵，一定会再次被击败吧。"
                }
              ]
            },
            {
              "text": "你接下来要去做什么？",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "好问题，如果是以前，可能会给你特别具体的答案。"
                },
                {
                  "role": "钟离",
                  "text": "但现在…嗯，大概是想要继续履行往生堂客卿的职责。"
                },
                {
                  "role": "钟离",
                  "text": "不过，如果这次的旅途你乐在其中的话，下次「记录」，不妨再结伴同行吧。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
