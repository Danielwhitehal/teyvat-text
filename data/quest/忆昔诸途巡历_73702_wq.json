{
  "quest_id": 73702,
  "chapter_num": null,
  "chapter_title": "忆昔诸途巡历",
  "type": "wq",
  "route": "The Recollector's Path",
  "stories": [
    {
      "story_id": 73702,
      "title": "忆昔诸途巡历",
      "description": "训练已经到了尾声阶段，离真正获得祖尔宛的认可只差最后一步…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与祖尔宛对话"
        },
        {
          "role": "祖尔宛",
          "text": "与上次相见时相比，表情开朗了许多嘛。看来训练进行得很顺利？"
        },
        {
          "role": "斯露莎",
          "text": "嗯，经过这几段反思我已经获得了成长。如果是现在的话…"
        },
        {
          "role": "祖尔宛",
          "text": "就可以算得上是称职的花灵勇者了？"
        },
        {
          "role": "斯露莎",
          "text": "还…还没有，毕竟还有最后的训练没有完成。"
        },
        {
          "role": "斯露莎",
          "text": "直到所有的任务完成，并且最终获得前辈的认可之后，「双角的花冠」才真正属于我…"
        },
        {
          "role": "祖尔宛",
          "text": "哦？看来之前说已经脱离了叛逆期，的确不假。"
        },
        {
          "role": "斯露莎",
          "text": "前、前辈怎么还记得这个？快忘了吧！"
        },
        {
          "role": "祖尔宛",
          "text": "呵呵，不管怎么说，看你恢复精神了就好。"
        },
        {
          "role": "祖尔宛",
          "text": "旅行者和派蒙，斯露莎究竟是否配得上「双角的花冠」，也请两位见证到最后吧。"
        },
        {
          "role": "祖尔宛",
          "text": "我会在终点处等候，那就稍后再见了。"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点完成试炼，与斯露莎对话"
        },
        {
          "role": "斯露莎",
          "text": "曾经的荼泥黑渊…过去的灾厄的中心…"
        },
        {
          "role": "派蒙",
          "text": "真没想到斯露莎真的熄灭了「焚真之天象」，解决了这里的大麻烦…"
        },
        {
          "role": "祖尔宛",
          "text": "熄灭「焚真之天象」也在花灵勇者的职责之内，斯露莎只是做了自己当做的。"
        },
        {
          "role": "旅行者",
          "text": "多亏了米希尔和拉沙鲁的协助。"
        },
        {
          "role": "派蒙",
          "text": "嗯，还有我们也出了不少力呢。"
        },
        {
          "role": "斯露莎",
          "text": "好啊，吾之「谒颂主」还有白飘飘，居然将我这个主角抛下不谈。"
        },
        {
          "role": "派蒙",
          "text": "哇，感觉之前那个嚣张的斯露莎又回来了！"
        },
        {
          "role": "斯露莎",
          "text": "唔…经过这阵子的相处，「谒颂主」和白飘飘还是对我有所怀疑吗？我这可不是什么没来由的盲目嚣张啊。"
        },
        {
          "role": "斯露莎",
          "text": "哼哼，要知道，我已经完全理解了自己过去的失误。"
        },
        {
          "role": "斯露莎",
          "text": "过去我一度将声名看得比行动本身更重要，但现在我知道了，这是舍本逐末的行为。"
        },
        {
          "role": "斯露莎",
          "text": "就像「西摩格」是因为它的牺牲而成为神鸟，我也将会因为我所行之事而被当作花灵勇者，为人所称颂传唱。"
        },
        {
          "role": "斯露莎",
          "text": "而且，我也完成了前辈指定的全部训练，这下就算是前辈也该承认我的确是个称职的勇者，的确配得上「双角的花冠」了。"
        },
        {
          "role": "祖尔宛",
          "text": "我当然对灵光的选择没有异议。"
        },
        {
          "role": "斯露莎",
          "text": "…欸？"
        },
        {
          "role": "祖尔宛",
          "text": "怎么？这时候我该提出反对意见吗？"
        },
        {
          "role": "斯露莎",
          "text": "不…只是…只是我没想到前辈居然会这样爽快地认可…"
        },
        {
          "role": "旅行者",
          "text": "还以为至少会刁难两句。"
        },
        {
          "role": "祖尔宛",
          "text": "啊呀，我可不是什么坏心眼的长者。"
        },
        {
          "role": "斯露莎",
          "text": "对了，关于勇者的职责…我并没有从花冠得到有关的知识…"
        },
        {
          "role": "斯露莎",
          "text": "是因为我作为勇者还是不完全的吗？难道说还需要经过什么其他的训练…"
        },
        {
          "role": "祖尔宛",
          "text": "这个嘛…虽然勇者的称号的确是花灵传承的一部份，具体的职责却是随时代改变的。"
        },
        {
          "role": "斯露莎",
          "text": "嗯嗯。"
        },
        {
          "role": "祖尔宛",
          "text": "简单来说，就是没有具体要做哪些事的规定，也没有什么是否合格的评判标准。通常来说，灵光的选择就代表了最终的结果。"
        },
        {
          "role": "斯露莎",
          "text": "欸？也就是说…"
        },
        {
          "role": "祖尔宛",
          "text": "我是不会没收「双角的花冠」的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这下不用担心头顶凉飕飕了。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "重点不在这里吧！"
        }
              ]
            },
            {
              "text": "不是想没收也没收不了吗？",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "对啊，祖尔宛自己也说了，灵光的选择就代表最终的结果。即使是祖尔宛也不能轻易修改这个结果吧？"
        },
        {
          "role": "祖尔宛",
          "text": "呵呵…真的不行吗？"
        },
        {
          "role": "派蒙",
          "text": "呜…有点可怕…"
        }
              ]
            }
          ]
        },
        
        {
          "role": "斯露莎",
          "text": "我知道了！这一定也是考验的一环。"
        },
        {
          "role": "派蒙",
          "text": "斯露莎好像明白了什么？"
        },
        {
          "role": "斯露莎",
          "text": "白飘飘可真是健忘呀，我刚刚还说过呢！经过这些训练，除了磨练行动力和洞察力，最重要的是我理解了自己过去的错误。"
        },
        {
          "role": "斯露莎",
          "text": "如果因为结果其实不会改变而轻忽训练的过程，那不就重蹈覆辙了吗？所以，这一定是前辈留给我的最后的考验。"
        },
        {
          "role": "斯露莎",
          "text": "对于名副其实的花灵勇者来说，当然是不在话下了。这可是前辈充分信赖我的表现啊。"
        },
        {
          "role": "祖尔宛",
          "text": "真没想到居然被斯露莎给看穿了，不愧是灵光选中的花灵。"
        },
        {
          "role": "祖尔宛",
          "text": "不过斯露莎能有这样的改变，或许也多亏了旅行者和派蒙两位吧。"
        },
        {
          "role": "斯露莎",
          "text": "嗯！吾之「谒颂主」和他的同伴白飘飘，的确是可塑之才。"
        },
        {
          "role": "斯露莎",
          "text": "虽然想说有我自己就绰绰有余了…不过，的确是因为他们的帮助，我才得以熄灭「焚真之天象」。"
        },
        {
          "role": "祖尔宛",
          "text": "没想到在短短的时间里，斯露莎竟能蜕变得如此可靠。"
        },
        {
          "role": "斯露莎",
          "text": "嗯！只要是勇者的职责所在，前辈就放心交给我好了！"
        },
        {
          "role": "派蒙",
          "text": "总觉得这一切都是祖尔宛的安排…不过看斯露莎的开心的样子，也许这样也挺好的？"
        }
      ]
    }
  ]
}