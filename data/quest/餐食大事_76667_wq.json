  "stories": [
    {
      "story_id": 76667,
      "title": "餐食大事",
      "description": "负责发放餐食的莉莉希似乎遇见了一些麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "和莉莉希对话"
        },
        {
          "role": "莉莉希",
          "text": "…呜…早知道就多准备一些白灵果了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（上次菈乌玛在这里的时候…）",
              "dialogues": []
            },
            {
              "text": "（好像是在发放餐食…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莉莉希",
          "text": "旅行者，您好，您是来领「飨月餐」的么？抱歉，您可能要稍等一下了…"
        },
        {
          "role": "旅行者",
          "text": "「飨月餐」是什么？"
        },
        {
          "role": "莉莉希",
          "text": "咦？您上次不是拿到过么…喔，上次是菈乌玛大人主持的，好像没告诉您这种餐食的正式名…"
        },
        {
          "role": "莉莉希",
          "text": "简单来说呢，「飨月餐」就是我们「霜月之子」为有需要之人免费发放的餐食啦。"
        },
        {
          "role": "莉莉希",
          "text": "我们「霜月之子」原本就有接济求助者的传统，最开始，只是限于希汐岛周围…"
        },
        {
          "role": "莉莉希",
          "text": "但在菈乌玛大人的主持和大家的努力下，我们也逐渐扩大了「飨月餐」的发放范围。"
        },
        {
          "role": "莉莉希",
          "text": "菈乌玛大人说，这也是为了将月神的赐福遍施众人，就是那句，嗯…"
        },
        {
          "role": "莉莉希",
          "text": "「采获所得首例珍果，须置于月光祭坛。此非奉神，乃是为迷途的猎人留存…」"
        },
        {
          "role": "莉莉希",
          "text": "留存…留存什么来着…"
        },
        {
          "role": "莉莉希",
          "text": "咳，总之！这家店呢，就是发放「飨月餐」的主要地点之一，哼哼，我可是几乎一个人在打理这里喔，厉害吧？"
        },
        {
          "role": "莉莉希",
          "text": "虽然在那夏镇里发放「飨月餐」遇见了很多困难…但我相信菈乌玛大人所说的，这样一定能帮助更多需要帮助的人！"
        },
        {
          "role": "莉莉希",
          "text": "不过…昨天准备食材的时候，我忘记把箱子盖盖紧了，早上起来的时候，好多果子都被小鸟们啄破，完全用不了。"
        },
        {
          "role": "莉莉希",
          "text": "剩下的白灵果压根做不了多少「飨月餐」，呜…这下怎么办…"
        },
        {
          "role": "旅行者",
          "text": "我去帮你准备一些。"
        },
        {
          "role": "莉莉希",
          "text": "您、您愿意帮我？太感谢了，太感谢了——那…就请您帮我拿<color=#00E1FFFF>五颗白灵果</color>来吧，这些就够用了！"
        },
        {
          "role": "莉莉希",
          "text": "等您拿来了之后，我一定会给您做一份最好吃的「飨月餐」！"
        },
        {
          "role": "莉莉希",
          "text": "您回来了？请问，您拿到白灵果了么？"
        },
        {
          "type": "subtitle",
          "text": "与莉莉希对话"
        },
        {
          "role": "旅行者",
          "text": "喏，这些够用了么？"
        },
        {
          "role": "莉莉希",
          "text": "够用了！太感谢了，太感谢了！请您稍等，我去给您做一份最好吃的「飨月餐」！"
        },
        {
          "role": "？？？",
          "text": "莉莉希奔向后厨，开始热火朝天地做起了「飨月餐」…"
        },
        {
          "role": "莉莉希",
          "text": "做好啦，请您品尝吧。"
        },
        {
          "role": "莉莉希",
          "text": "再次感谢您的帮助，下次如果您肚子饿了，请尽管过来吧，我会为您专门准备一份的。"
        },
        {
          "type": "subtitle",
          "text": "将五颗白灵果交给莉莉希"
        },
        {
          "type": "subtitle",
          "text": "与莉莉希对话"
        },
        {
          "role": "旅行者",
          "text": "喏，这些够用了么？"
        },
        {
          "role": "莉莉希",
          "text": "够用了！太感谢了，太感谢了！请您稍等，我去给您做一份最好吃的「飨月餐」！"
        },
        {
          "role": "？？？",
          "text": "莉莉希奔向后厨，开始热火朝天地做起了「飨月餐」…"
        },
        {
          "role": "莉莉希",
          "text": "做好啦，请您品尝吧。"
        },
        {
          "role": "莉莉希",
          "text": "再次感谢您的帮助，下次如果您肚子饿了，请尽管过来吧，我会为您专门准备一份的。"
        }
      ]
    }
  ]
