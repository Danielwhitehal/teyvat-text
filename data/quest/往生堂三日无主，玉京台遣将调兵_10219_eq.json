{
  "quest_id": 10219,
  "chapter_num": "春曦画桃符·第二回",
  "chapter_title": "往生堂三日无主，玉京台遣将调兵",
  "type": "eq",
  "route": "The Funeral Parlor Has No Master, Yujing Terrace Calls the Troops",
  "stories": [
    {
      "story_id": 40185,
      "title": "往生堂三日无主，玉京台遣将调兵",
      "description": "两天过去了，你们打算去往生堂看看胡桃回来了没有…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后"
        },
        {
          "role": "派蒙",
          "text": "呼！两天过去了，不知道胡桃她们办完事了没有，我们去往生堂看看吧？"
        },
        {
          "type": "subtitle",
          "text": "前往往生堂"
        },
        {
          "role": "派蒙",
          "text": "仪倌小姐，又是我们，嘿嘿。"
        },
        {
          "role": "摆渡人",
          "text": "两位好，是来找堂主的吧？很遗憾她还没有回来。"
        },
        {
          "role": "派蒙",
          "text": "欸？这都两天了吧？胡桃还没有回来？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这种情况很常见吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "摆渡人",
          "text": "唔…虽不常见，但也不稀罕。堂主性子异于常人，一连消失十天半月的事也干过。"
        },
        {
          "role": "派蒙",
          "text": "噢，这样听起来，好像也不是什么大问题，胡桃果然是胡桃。"
        },
        {
          "role": "嘉明",
          "text": "唷！这不是旅行者和派蒙吗！好久没见了吧？海灯节快乐！"
        },
        {
          "role": "派蒙",
          "text": "是嘉明，你好呀！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "海灯节快乐，嘉明。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，怎么会在这里碰到你啊？"
        },
        {
          "role": "嘉明",
          "text": "接了趟镖要送到沉玉谷，正好老爸又催我回家过节，顺风顺水又顺路咯。"
        },
        {
          "role": "派蒙",
          "text": "等等！往生堂送回沉玉谷的货…该不会是…飞云商会？"
        },
        {
          "role": "嘉明",
          "text": "不是吧？派蒙，你老实讲，算命在哪里学的？这么准的？"
        },
        {
          "role": "派蒙",
          "text": "哎呀，我们前两天才见过行秋，稍微听说了一些…"
        },
        {
          "role": "嘉明",
          "text": "吓我一跳，我还在想是哪漏了风声，镖局交代过，这次要低调点…原来你们知道，那我就不用藏来藏去了。"
        },
        {
          "role": "嘉明",
          "text": "仪倌小姐，东西都在吗？我点点先，没问题就让伙计来拉走咯。"
        },
        {
          "role": "摆渡人",
          "text": "都备好了，我带您进去看看吧。"
        },
        {
          "role": "派蒙",
          "text": "等下嘉明，想问问你，据说不卜庐的白先生还在给老太公想办法，是没起效果吗？"
        },
        {
          "role": "嘉明",
          "text": "白先生的事我不是很清楚…但飞云商会的大少爷说了，今天只是把东西送回去先，好做准备。"
        },
        {
          "role": "嘉明",
          "text": "看上去就是做多个打算而已，放心啦，应该还没到那个地步。"
        },
        {
          "role": "派蒙",
          "text": "原来如此，旅行者，我们要不要去看看行秋呀？"
        },
        {
          "role": "嘉明",
          "text": "行秋少爷？已经回沉玉谷了喔，和他大哥一起的，说去看看祖屋要不要修缮什么的…别扑空啦。"
        },
        {
          "role": "派蒙",
          "text": "欸？怎么感觉还是有点不妙啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等会去问问白术吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！他应该知道现在的情况。"
        },
        {
          "role": "嘉明",
          "text": "那我也去干活先啦，忙完约饮茶啊！"
        },
        {
          "role": "派蒙",
          "text": "白术！你怎么在这？我们正打算去找你呢。"
        },
        {
          "role": "长生",
          "text": "真是无巧不成书，他也在找你们。"
        },
        {
          "role": "白术",
          "text": "嗯，旅行者，这件事可能必须要拜托你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "老太公出问题了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "白术",
          "text": "老太公那边还稳定，现在有问题的是七七。"
        },
        {
          "role": "派蒙",
          "text": "七七？她怎么了？也昏迷了？"
        },
        {
          "role": "白术",
          "text": "她前日出门采药，至今未归，按原计划，当日就应该返回的。"
        },
        {
          "role": "派蒙",
          "text": "那…会不会是药比较难采，爬山耽搁了，又或者贪玩，去了别的地方？"
        },
        {
          "role": "白术",
          "text": "七七体质特殊，每次出发前，我们都会协定好返回时间，记在她的小手册上。"
        },
        {
          "role": "长生",
          "text": "小手册的规矩就是，药没采到，可以，超时回家，不行。但到现在为止，已经超过一天多了。"
        },
        {
          "role": "派蒙",
          "text": "欸？！这种情况以前出现过吗？"
        },
        {
          "role": "长生",
          "text": "没有，所以我们担心她在山上遇到了麻烦。昨天就去冒险家协会发布了委托。"
        },
        {
          "role": "白术",
          "text": "但我常与冒险家打交道，其中也有平庸之辈，光凭他们去寻七七，我放心不下。"
        },
        {
          "role": "长生",
          "text": "是啊，今早就有速度快的冒险家回来了，说七七失踪的地方闹鬼，吓人得很。至于七七本人，当然是没找到。"
        },
        {
          "role": "白术",
          "text": "所以，现在能让人完全信任的，只有旅行者你了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "七七在哪里采药的？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "白术",
          "text": "轻策山，无妄坡。"
        },
        {
          "role": "派蒙",
          "text": "又是轻策山？"
        },
        {
          "role": "白术",
          "text": "嗯，或许…轻策山确实出现了我们不了解的危机。"
        },
        {
          "role": "白术",
          "text": "昨日我又接诊了两位新病患，他们的症状和蒂玛乌斯与老太公如出一辙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "先不说别的了，我们立刻出发。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没错，先去找七七比较要紧。等我们消息吧。"
        },
        {
          "role": "白术",
          "text": "那就拜托两位了。"
        },
        {
          "type": "subtitle",
          "text": "去无妄坡寻找失踪的七七"
        },
        {
          "type": "subtitle",
          "text": "寻找七七"
        },
        {
          "role": "派蒙",
          "text": "不知道是不是心理作用，我感觉这里比以前更古怪了…希望七七不要有事啊。"
        },
        {
          "type": "subtitle",
          "text": "击退魔物"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|打手丘丘人|3}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|火斧丘丘暴徒|1}}{{图标|射手丘丘人|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "查看魔物附近的藤人"
        },
        {
          "role": "派蒙",
          "text": "快看！这不是蓝师傅的小藤人吗？难道她来过这里？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也就是说，胡桃可能也来过。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "她们两个…哦，我知道了！胡桃和蓝砚是抓鬼来了！"
        },
        {
          "role": "派蒙",
          "text": "冒险家协会的人说无妄坡闹鬼，胡桃很懂这些，蓝砚师傅的藤人上有降魔印，她肯定也懂！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那七七呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…我想想哦…七七是僵尸，僵尸关节不灵活，跑得慢，然后被鬼抓住了，所以就失踪了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "有理有据，但不太令人信服。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼，我们再在附近找找吧，找到了就知道了。"
        },
        {
          "role": "派蒙",
          "text": "欸？什么声音？"
        },
        {
          "role": "派蒙",
          "text": "呜哇！不会真有鬼吧？！"
        },
        {
          "role": "夜兰",
          "text": "两位，请止步。"
        },
        {
          "role": "派蒙",
          "text": "夜…夜兰？怎么是你？！我还以为真闹鬼呢，原来是闹夜兰啊…"
        },
        {
          "role": "夜兰",
          "text": "呵呵，我先前吓跑了几个菜鸟冒险家，不过似乎吓不倒你们。前面的区域有危险，不要再往前了。"
        },
        {
          "role": "派蒙",
          "text": "可是…我们是来找七七的，她就在这附近失踪了，现在可能更有危险。"
        },
        {
          "role": "夜兰",
          "text": "这件事我知情，冒险家协会的线人来报过。"
        },
        {
          "role": "夜兰",
          "text": "我在山腰处发现了一个药篓，可能是七七的东西，但她本人，应该不在此地了。"
        },
        {
          "role": "派蒙",
          "text": "欸？七七不在这山上吗？"
        },
        {
          "role": "夜兰",
          "text": "附近我已经掘地三尺，全部调查过一遍，我们现在落脚之处还算安全，再往前就未可知了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你也在找七七？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "夜兰",
          "text": "不，我在调查这片区域的不明异变。"
        },
        {
          "role": "夜兰",
          "text": "大约一个月前，总务司注意到，轻策庄老人患病的数据异常增多，而且是不明疾病。"
        },
        {
          "role": "派蒙",
          "text": "啊，白术也遇到了类似的事！他也怀疑轻策庄有问题。"
        },
        {
          "role": "夜兰",
          "text": "但后来我们发现，问题的源头并不在轻策庄内，而是我们现在站的地方，无妄坡。"
        },
        {
          "role": "夜兰",
          "text": "轻策庄的老人距离不远，身体素质也不如年轻人，首当其冲，最受影响。"
        },
        {
          "role": "派蒙",
          "text": "居然是无妄坡么…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许胡桃和蓝砚知道什么。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没错，可她们现在也都不见了…"
        },
        {
          "role": "夜兰",
          "text": "我知道她们可能在哪里。"
        },
        {
          "role": "派蒙",
          "text": "在哪里？！"
        },
        {
          "role": "夜兰",
          "text": "在一个没法轻易抵达的地方。来吧，先跟我回去见凝光。"
        },
        {
          "role": "派蒙",
          "text": "见…见凝光？"
        },
        {
          "role": "夜兰",
          "text": "你们这是什么表情？不会以为我透露了这么多秘密情报，会轻易放你们离开吧？"
        },
        {
          "role": "派蒙",
          "text": "欸？！你要干什么？！"
        },
        {
          "role": "夜兰",
          "text": "开玩笑的。胡堂主的事，凝光一清二楚。结合现在的情况，我猜测胡堂主、蓝砚还有七七，应该都在一处。"
        },
        {
          "role": "夜兰",
          "text": "走吧，见到凝光，你们就都知道了。"
        },
        {
          "type": "subtitle",
          "text": "去见凝光"
        },
        {
          "role": "北斗",
          "text": "若是以往，这事怕是办不了。"
        },
        {
          "role": "北斗",
          "text": "我陪你倒无所谓，但死兆星的兄弟，不能不放他们回去过节。"
        },
        {
          "role": "凝光",
          "text": "理应如此。但我想听的…是下一句话。"
        },
        {
          "role": "北斗",
          "text": "哈哈哈哈！你这女人，满肚子弯弯绕…行了行了！"
        },
        {
          "role": "北斗",
          "text": "惊门孤云阁是吧？我会安排的。"
        },
        {
          "role": "凝光",
          "text": "我就知道船长大义，不能推辞。"
        },
        {
          "role": "北斗",
          "text": "好话省点说，多匀些到兄弟们的工钱里去。海灯节，五倍起啊。"
        },
        {
          "role": "凝光",
          "text": "船长坑起我来是一点不手软呀。罢了，你那份也少不了的。"
        },
        {
          "role": "北斗",
          "text": "哪里的话，我坑谁也坑不了天权大人啊。这样，我的那份就送你了，去买支新钗子。"
        },
        {
          "role": "北斗",
          "text": "这事就不用我代劳了吧？哈哈哈。"
        },
        {
          "role": "北斗",
          "text": "哈！这不是旅行者和派蒙吗？"
        },
        {
          "role": "派蒙",
          "text": "北斗！你好呀！"
        },
        {
          "role": "北斗",
          "text": "小派蒙，好久不见，你还是这么活泼，是个好苦力啊，等会凝光少不了你活干。"
        },
        {
          "role": "派蒙",
          "text": "啊？"
        },
        {
          "role": "北斗",
          "text": "哈哈，事情急，先走了啊几位。"
        },
        {
          "role": "北斗",
          "text": "哦对了，海灯节快乐。"
        },
        {
          "role": "凝光",
          "text": "夜兰真是知我心意，我还没开口，她就把两位请来了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "北斗说你要抓我们当苦力。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "北斗船长向来爱开我玩笑。"
        },
        {
          "role": "夜兰",
          "text": "也差不多吧。旅行者和派蒙去过那边，比所有人都合适。"
        },
        {
          "role": "派蒙",
          "text": "那边？哪边？"
        },
        {
          "role": "凝光",
          "text": "两位，我知道你们正在寻人，我就开门见山，不浪费时间了。"
        },
        {
          "role": "凝光",
          "text": "据我所知，胡桃胡堂主，七七姑娘，蓝砚姑娘，她们三人应该被困于边界了。"
        },
        {
          "role": "派蒙",
          "text": "边界？！是…是那个边界？"
        },
        {
          "role": "夜兰",
          "text": "就是那个边界，璃月的生死边界。"
        },
        {
          "role": "派蒙",
          "text": "等等等一下，你们也知道边界吗？不对…你们怎么知道我和旅行者去过？"
        },
        {
          "role": "夜兰",
          "text": "嗯？"
        },
        {
          "role": "派蒙",
          "text": "啊…夜兰…好吧…你真厉害…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确定她们在生死边界？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "我知道你心有疑惑，眼下时间紧张，我便简要说明如今的状况。"
        },
        {
          "role": "凝光",
          "text": "一月前，总务司发现轻策老人异常患病一事。"
        },
        {
          "role": "凝光",
          "text": "半月后，胡堂主来告知，璃月生死边界可能有异动。总务司派出了人手，确实在无妄坡一带感知到不祥之气。"
        },
        {
          "role": "凝光",
          "text": "三日前，胡堂主再次前来，称已做好准备，要去璃月生死边界一探究竟。"
        },
        {
          "role": "凝光",
          "text": "我们约定两日后再见，如今日子已过，堂主仍未出现，我便托夜兰前去调查。"
        },
        {
          "role": "夜兰",
          "text": "堂主最后出现的地点就在无妄坡。另外，七七与蓝砚的踪迹也消失在那里。十有八九，她们都受困于边界。"
        },
        {
          "role": "派蒙",
          "text": "连胡桃都被困住了？看来边界真的有问题…"
        },
        {
          "role": "凝光",
          "text": "情况大致如此，两位既有探索生死边界的经历，能否前去救援胡堂主一行？"
        },
        {
          "role": "派蒙",
          "text": "如果真是这样，不问我们也会去的！"
        },
        {
          "role": "派蒙",
          "text": "但有个问题，上次我们去边界有胡桃带路，我们自己也没办法打开入口。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "凝光应该有办法吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "去望舒客栈请降魔大圣，他有法可解。"
        },
        {
          "role": "派蒙",
          "text": "哦！是魈啊。"
        },
        {
          "role": "凝光",
          "text": "呵呵，在你们来前，夜兰正计划前往边界，自然联络过此事。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "明白了，那现在就出发吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "旅行者，兹事体大，务必要保证胡堂主她们的安全。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等我好消息。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "嗯，那我便在此静候佳音。"
        },
        {
          "role": "夜兰",
          "text": "多亏有他们。否则，能否安全带回胡堂主，我也没把握。"
        },
        {
          "role": "凝光",
          "text": "但很可惜，夜兰，你眼下还不能休息。"
        },
        {
          "role": "夜兰",
          "text": "…我倒也没那么天真。还有什么事？"
        },
        {
          "role": "凝光",
          "text": "生、杜、惊、伤四门阵眼的位置已经知道了。"
        },
        {
          "role": "夜兰",
          "text": "哦？"
        },
        {
          "role": "凝光",
          "text": "生、杜二门已有刻晴、甘雨负责，先前北斗船长也应下来，惊门由南十字舰队镇守。"
        },
        {
          "role": "凝光",
          "text": "余下伤门，我思来想去，除了降魔大圣，没有再比你合适的了。"
        },
        {
          "role": "夜兰",
          "text": "嗯？哦…"
        },
        {
          "role": "夜兰",
          "text": "…层岩巨渊。"
        },
        {
          "role": "凝光",
          "text": "正是。另四门的位置正在推演，应该也要不了多久。"
        },
        {
          "role": "凝光",
          "text": "照胡堂主的说法，若遇上最坏情况，或许要依靠这传说中的八门七门大阵。"
        },
        {
          "role": "夜兰",
          "text": "……"
        },
        {
          "role": "凝光",
          "text": "有何顾虑？尽管说来。"
        },
        {
          "role": "夜兰",
          "text": "虽然我还不够了解这阵法，但按照目前的情报来看，若要布此大阵，代价是要隐去一人吧？"
        },
        {
          "role": "凝光",
          "text": "……"
        },
        {
          "role": "凝光",
          "text": "唉，此事我心中也无定数…日后再提吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（凝光）"
        },
        {
          "role": "凝光",
          "text": "两位已有好消息了？"
        },
        {
          "role": "派蒙",
          "text": "还…还没有，我们马上就出发了！"
        },
        {
          "type": "subtitle",
          "text": "去望舒客栈请降魔大圣"
        },
        {
          "role": "派蒙",
          "text": "魈！原来你已经在这啦。"
        },
        {
          "role": "魈",
          "text": "怎么是你们？夜兰呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "玉京台的战术调整了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "魈",
          "text": "你们可知此行危险？"
        },
        {
          "role": "派蒙",
          "text": "没事啦，旅行者什么地方没去过哦，对吧？"
        },
        {
          "role": "魈",
          "text": "生死边界本就神秘，如今又有不明异变，或许是三步一危，五步一难。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "无论如何，我们都要把人带回来。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "就是就是，我们都答应凝光了。"
        },
        {
          "role": "魈",
          "text": "…能否替我回告，换别人来。"
        },
        {
          "role": "派蒙",
          "text": "欸？！我们不行吗？"
        },
        {
          "role": "魈",
          "text": "若是夜兰，她家传秘法，又身经百战，我暂且放心。若是旅行者，万一在里面有何差池…"
        },
        {
          "role": "派蒙",
          "text": "原来你在担心旅行者啊，但他也是身经百战啦！"
        },
        {
          "role": "魈",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "旅行者，快想想办法！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们还答应了钟离。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "啊？什么…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（拿出钟离给的帝钱）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "噢…噢！这个啊…没错没错，这是钟离给的护身符呢，上面还有岩王帝君符号，对吧？"
        },
        {
          "role": "派蒙",
          "text": "他告诉我们，要好好把胡桃带回来哦，不然有我们好果子吃！"
        },
        {
          "role": "魈",
          "text": "不必诓我，这钱虽有帝君符号，但全无帝君法力，赝品而已。"
        },
        {
          "role": "派蒙",
          "text": "呃…钟离这家伙真不靠谱！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "魈在担心什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "魈",
          "text": "我身负恶瘴，恐惊扰边界，只能在外搜寻入口，无法陪同深入。"
        },
        {
          "role": "派蒙",
          "text": "原来你是怕出了事没法帮忙啊？哎呀，我理解你的心情…但是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "现在有更应该担心的人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没错！胡桃最了解边界了，如果她回不来，我们其他人都不知道该怎么办的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "而且我们也去过边界的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没错没错，我们可是除了胡桃以外第二有经验的人哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "相信我们吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "魈",
          "text": "唉…"
        },
        {
          "role": "魈",
          "text": "既如此，你们抓紧我。"
        },
        {
          "type": "subtitle",
          "text": "前往无妄坡"
        },
        {
          "role": "派蒙",
          "text": "呜哇！魈速度好快！"
        },
        {
          "role": "魈",
          "text": "边界应当就在附近。"
        },
        {
          "role": "派蒙",
          "text": "说起来，魈也会打开边界的法术吗？"
        },
        {
          "role": "魈",
          "text": "平衡生死向来是往生堂之责，我并不懂其中法门。"
        },
        {
          "role": "魈",
          "text": "但如今边界异动，死气溢出，必有泄口，我们循迹即可。"
        },
        {
          "role": "魈",
          "text": "靖妖傩舞！"
        },
        {
          "role": "派蒙",
          "text": "好厉害…魈能看见死气吗？"
        },
        {
          "role": "魈",
          "text": "三眼五显，能窥异常，死气与否，到头便知。走。"
        },
        {
          "type": "subtitle",
          "text": "寻找死气的源头"
        },
        {
          "type": "subtitle",
          "text": "攻击死气团将其暂时驱散",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "有…有魔物！"
        },
        {
          "role": "魈",
          "text": "沾了死气发狂么…你们退后，交给我。"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|丘丘人|3}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "进入生死边界"
        },
        {
          "role": "魈",
          "text": "就是这里了。"
        },
        {
          "role": "派蒙",
          "text": "看来刚才魈看到的果然是死气！"
        },
        {
          "role": "魈",
          "text": "但如先前所说，为了避免情况恶化，我不能进去，全靠你们了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "放心吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "魈",
          "text": "嗯…头靠过来一点。"
        },
        {
          "role": "魈",
          "text": "迦毗琉璃！印！"
        },
        {
          "role": "派蒙",
          "text": "欸？魈这是…？"
        },
        {
          "role": "魈",
          "text": "我在你额上留下了一道降魔印，能与我共享视野，助你窥见死气。边界中情况不明，或许有用。"
        },
        {
          "role": "魈",
          "text": "若你们寻至受困者，便唤我名，我会打开通道，接你们出来。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，魈真周到！那我们进去啦。"
        },
        {
          "role": "魈",
          "text": "万事小心。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（魈）"
        },
        {
          "role": "魈",
          "text": "万事小心。"
        },
        {
          "type": "subtitle",
          "text": "步入「边界」"
        },
        {
          "type": "subtitle",
          "text": "故地重来，此处却已生不明灾殃，连往生堂堂主都受困其中，你意深入，还需万事小心。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "寻找受困的三人"
        },
        {
          "role": "派蒙",
          "text": "这里…感觉和以前有点像，但看起来又有点不一样了…"
        },
        {
          "type": "subtitle",
          "text": "使用魈的法术寻找异常",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "攻击死气节点驱散死气",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|火斧丘丘暴徒|1}}{{图标|丘丘人|3}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "没有路了…要跳下去吗？上次好像也是这么做的。"
        },
        {
          "role": "派蒙",
          "text": "欸？快走到头了吧？还是没有发现胡桃她们…"
        },
        {
          "role": "派蒙",
          "text": "而且这里和之前一样仙气飘飘，根本不像出了问题的样子啊…要不用魈的法术看看吧？"
        },
        {
          "type": "subtitle",
          "text": "使用魈的法术寻找异常",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|丘丘人|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "欸？！那个是蓝师傅的小藤人吧？逃走了！我们追上去！"
        },
        {
          "role": "派蒙",
          "text": "小藤人上有死气啊…这是怎么回事？我们再找找看还有没有别的。"
        },
        {
          "role": "派蒙",
          "text": "为什么蓝师傅会把小藤人留在这里…像是什么阵法一样，我猜不止这两个小藤人，一定还有！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！这是哪里？发生了什么？这里看起来好可怕…难道现在的才是真实的边界吗？！"
        },
        {
          "role": "派蒙",
          "text": "看来要再跳一次了…"
        },
        {
          "role": "七七",
          "text": "七七，困…"
        },
        {
          "role": "胡桃",
          "text": "不能睡！七七，你吸了太多死气，睡着就醒不来了！"
        },
        {
          "role": "七七",
          "text": "可是，困…"
        },
        {
          "role": "蓝砚",
          "text": "听我说，七七，你一点也不困，你是世界第一清醒，就算所有人都睡着了，你也是清醒的。"
        },
        {
          "role": "七七",
          "text": "世界，睡着…七七，醒着…"
        },
        {
          "role": "胡桃",
          "text": "蓝姑娘真厉害，催眠还能反着来。"
        },
        {
          "role": "蓝砚",
          "text": "但这样下去也不是办法…"
        },
        {
          "role": "胡桃",
          "text": "再坚持一会，我马上就要找到出口的规律了。"
        },
        {
          "role": "七七",
          "text": "七七，想做梦…"
        },
        {
          "role": "蓝砚",
          "text": "七七…加油啊！"
        },
        {
          "role": "胡桃",
          "text": "做梦？那不难办，七七，我来帮你做梦，听好了，你的梦是这样的…"
        },
        {
          "role": "胡桃",
          "text": "太阳当空照，七七去采药。"
        },
        {
          "role": "七七",
          "text": "七七…采药…"
        },
        {
          "role": "胡桃",
          "text": "爬上一座山，山上有座庙。"
        },
        {
          "role": "七七",
          "text": "山上…有庙…"
        },
        {
          "role": "胡桃",
          "text": "庙里有个老道士，名字叫胡桃！"
        },
        {
          "role": "七七",
          "text": "胡…胡桃？"
        },
        {
          "role": "胡桃",
          "text": "胡桃看见七七来，一把揪住往土里埋！岩王爷来了都找不到！"
        },
        {
          "role": "七七",
          "text": "别！别埋！救救…"
        },
        {
          "role": "胡桃",
          "text": "这下不困了吧？"
        },
        {
          "role": "七七",
          "text": "不困了，好吓人…"
        },
        {
          "role": "蓝砚",
          "text": "嗯？"
        },
        {
          "role": "蓝砚",
          "text": "糟了，胡堂主，我布下的幻阵被破了！"
        },
        {
          "role": "胡桃",
          "text": "是那些发狂的魔物吗？"
        },
        {
          "role": "七七",
          "text": "魔物…"
        },
        {
          "role": "蓝砚",
          "text": "别害怕七七，我们保护你。"
        },
        {
          "role": "派蒙",
          "text": "胡桃！蓝师傅，还有七七，终于找到你们了！"
        },
        {
          "role": "胡桃",
          "text": "哇？原来是你们！"
        },
        {
          "role": "七七",
          "text": "旅行者，和派蒙…"
        },
        {
          "role": "蓝砚",
          "text": "吓死我了，还以为连魔物都能破我的幻阵。你们怎么找过来的？"
        },
        {
          "role": "胡桃",
          "text": "是那位天权大人吧？我失了约，她果然有所行动。"
        },
        {
          "role": "派蒙",
          "text": "胡桃真聪明！她早就有打算了，我们没来，也会有别人来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里很危险，先出去再说吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蓝砚",
          "text": "可这里的空间一直在变化，胡堂主好几次发现了出口，但没等我们赶到就关上了。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们可是有备而来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（喊出魈的名字）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "魈",
          "text": "人已…找到？"
        },
        {
          "role": "胡桃",
          "text": "原来降魔大圣也来了，多谢！"
        },
        {
          "role": "魈",
          "text": "不必…我来打开通道…"
        },
        {
          "role": "七七",
          "text": "魔，魔物！"
        },
        {
          "role": "蓝砚",
          "text": "糟了，它们一定是感知到这里有死气的出口。"
        },
        {
          "role": "胡桃",
          "text": "哼，管他什么魔物，本堂主统统送走。"
        },
        {
          "role": "魈",
          "text": "我需要一分钟…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，快拦住那些魔物！"
        },
        {
          "role": "七七",
          "text": "七七，来帮忙。"
        },
        {
          "type": "subtitle",
          "text": "击退魔物"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|火斧丘丘暴徒|1}}{{图标|打手丘丘人|2}}{{图标|射手丘丘人|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|火斧丘丘暴徒|1}}{{图标|雷斧丘丘暴徒|1}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|冲锋丘丘人|2}}{{图标|冰箭丘丘人|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与魈交谈"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，魈，你看，就说我们可以的吧。"
        },
        {
          "role": "魈",
          "text": "出来了就好。"
        },
        {
          "role": "蓝砚",
          "text": "这位就是传说中的降魔大圣吗？"
        },
        {
          "role": "魈",
          "text": "不必多礼，都还好吗？"
        },
        {
          "role": "胡桃",
          "text": "我们都还好，就是七七吸收了太多死气。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "具体是怎么回事？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "七七",
          "text": "七七，采药，发现洞…"
        },
        {
          "role": "七七",
          "text": "想堵住…"
        },
        {
          "role": "七七",
          "text": "结果，掉进去了…"
        },
        {
          "role": "蓝砚",
          "text": "七七姑娘似乎不是一般人，她居然能吸收死气，要是我这么干一定已经…"
        },
        {
          "role": "胡桃",
          "text": "虽然七七…体质特殊，但这样一定也有风险。"
        },
        {
          "role": "派蒙",
          "text": "那我们先把她送回不卜庐看看吧？"
        },
        {
          "role": "魈",
          "text": "我来。你们还有任务在身，先回玉京台为好。"
        },
        {
          "role": "派蒙",
          "text": "说的也是…凝光一定等得像热锅上的史莱姆一样了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我觉得不至于。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "总之我们先回去吧，其它事等会再说。"
        },
        {
          "type": "subtitle",
          "text": "返回玉京台"
        },
        {
          "role": "派蒙",
          "text": "凝光！凝光！我们把人都带回来啦！"
        },
        {
          "role": "凝光",
          "text": "旅行者身手了得，甚至比我预估还要快一点。"
        },
        {
          "role": "派蒙",
          "text": "什么嘛，还以为你会很着急呢，结果稳坐玉京台，一点也不慌嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我说吧，她完全不像史莱姆。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "呵呵，要是连旅行者都不能信任，我都不知道该信任谁了。"
        },
        {
          "role": "胡桃",
          "text": "真不好意思啦，天权大人，通常来说，本堂主是不会迟到的，这次耽搁了一天，多多包涵啦！"
        },
        {
          "role": "凝光",
          "text": "胡堂主说笑了。同意你一人前往边界，是我草率了，让你们受困，我也有一份责任。"
        },
        {
          "role": "胡桃",
          "text": "怎么能这么说，我都没想到情况会有这么糟啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这么糟是有多糟？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "我也想知道，危机到了什么程度，比从前又如何？"
        },
        {
          "role": "胡桃",
          "text": "严重得多，多得多得多得多。"
        },
        {
          "role": "蓝砚",
          "text": "欸？这种事不止一次了吗？我都没听说过。"
        },
        {
          "role": "胡桃",
          "text": "嗯，边界可不是地里自然长出来的东西，它就像一座老宅，也会出问题。"
        },
        {
          "role": "胡桃",
          "text": "短则数十年，长则数百年，要有人维护才行，至于维护工，当然就是我们往生堂的人啦。"
        },
        {
          "role": "胡桃",
          "text": "但从前最多只是死气外溢的小问题，用秘法就全烧干净了。但这次前所未见，连边界里面都天翻地覆了。"
        },
        {
          "role": "凝光",
          "text": "堂主可知原因？"
        },
        {
          "role": "胡桃",
          "text": "我也还不清楚。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "会是因为深渊吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡桃",
          "text": "可我暂时还没发现深渊留下的痕迹。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你是想到纳塔了吧！我也感觉有点像…不过又好像有些不同…"
        },
        {
          "role": "派蒙",
          "text": "纳塔的夜神之国相当于璃月的生死边界吗？"
        },
        {
          "role": "凝光",
          "text": "那边的危机我有所耳闻，但据我所知，夜神之国是真正的死者之地。边界…则更像是隔开生死的关隘。"
        },
        {
          "role": "胡桃",
          "text": "没错，这头是生，那头是死。如果这道关隘崩塌，恐怕会重现数千年前幽冥颠倒、生死混沌的乱象。"
        },
        {
          "role": "派蒙",
          "text": "难怪病人的问题是衰老…减寿…"
        },
        {
          "role": "胡桃",
          "text": "这就是死入侵生的一种表现…"
        },
        {
          "role": "蓝砚",
          "text": "那我们现在该怎么办？"
        },
        {
          "role": "胡桃",
          "text": "光靠焚烧死气，可能已经处理不了了，问题的核心还在边界。天权大人，我之前提到的八门七门大阵，有眉目吗？"
        },
        {
          "role": "凝光",
          "text": "有，而且已经推演出四门的阵眼了，剩下的也无需多久。"
        },
        {
          "role": "胡桃",
          "text": "这么快？不愧是天权大人！"
        },
        {
          "role": "凝光",
          "text": "侥幸所得，实为我璃月气运。"
        },
        {
          "role": "派蒙",
          "text": "等下等下！你们说的，不会是那个八奇炼桃都的大阵吧？！"
        },
        {
          "role": "胡桃",
          "text": "就是那个。你们也看到边界的样子了，除了重新来过，我想不到别的办法了。"
        },
        {
          "role": "派蒙",
          "text": "重新炼一个边界？！"
        },
        {
          "role": "胡桃",
          "text": "不是重新炼一个边界，是把有问题的边界重新炼一炼，听起来有点像，但是难度小很多哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "八门七门大阵究竟是什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡桃",
          "text": "所谓八门，其实是璃月地脉中八个关键的节点，生死休杜，开景惊伤，它们可以引导地脉之力。"
        },
        {
          "role": "派蒙",
          "text": "那七门呢？"
        },
        {
          "role": "胡桃",
          "text": "是发动阵法的条件，持阵者从八门中择一镇压邪恶，再借地脉之力隐去自身，如此可斩断邪恶退路。"
        },
        {
          "role": "派蒙",
          "text": "…隐去？"
        },
        {
          "role": "蓝砚",
          "text": "就是连同邪恶一起隐于地脉，不现人世了。"
        },
        {
          "role": "派蒙",
          "text": "那…那这不是同归于尽吗？我们要布这个阵吗？那岂不是…"
        },
        {
          "role": "胡桃",
          "text": "哎呀，放心放心，之所以大家会这么认为，是因为传说中的幽蝶仙子因此而牺牲。"
        },
        {
          "role": "胡桃",
          "text": "但那可是炼魔神呢，虽然今天的事也很严重，但还远远没到那个程度。边界也没有完全毁掉，又不需要重新炼一个。"
        },
        {
          "role": "胡桃",
          "text": "依我看，持阵者只要能承受过量死气的冲击，就不会危及生命。"
        },
        {
          "role": "凝光",
          "text": "哦？胡堂主此言可有依据？"
        },
        {
          "role": "胡桃",
          "text": "依据就是，我比在座的各位都懂，什么是生死幽冥。嘿嘿，怎么样？没人想反驳吧？"
        },
        {
          "role": "胡桃",
          "text": "嗯，没有人说话，看来大家都同意我了。那就等天权大人推演出余下四门位置，我们再计划下一步的行动吧。"
        },
        {
          "role": "凝光",
          "text": "胡堂主…"
        },
        {
          "role": "胡桃",
          "text": "欸？天权大人有别的意见吗？"
        },
        {
          "role": "凝光",
          "text": "不…我是另有件事想请教。或许有些冒犯，如果胡堂主不愿意回答，就当我没问过。"
        },
        {
          "role": "胡桃",
          "text": "什么事啊？"
        },
        {
          "role": "凝光",
          "text": "胡堂主认为，十数年前的无妄坡之灾，跟今天的边界危机是否有联系？"
        },
        {
          "role": "胡桃",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "咦？十几年前的无妄坡？有发生过什么吗？"
        },
        {
          "role": "蓝砚",
          "text": "是什么自然灾害吧？那边原来好像有村子的，后来山洪还是什么，死了一些人，剩下的也就都搬走了。"
        },
        {
          "role": "蓝砚",
          "text": "啊…不过这倒解释不了，为什么无妄坡会变成今天这种不见天日的模样，难道…其中还有隐情？"
        },
        {
          "role": "胡桃",
          "text": "呼…"
        },
        {
          "role": "胡桃",
          "text": "天权大人，这两件事没有联系。"
        },
        {
          "role": "凝光",
          "text": "嗯，这样我就放心了。各位，我们两天后再在这里见吧，那时就能知道全八门的位置。"
        },
        {
          "role": "胡桃",
          "text": "那大家，我有不少事情还要准备，就先回往生堂啦。"
        },
        {
          "role": "蓝砚",
          "text": "好，没事的话，那我也先走一步啦。"
        },
        {
          "role": "派蒙",
          "text": "对了，蓝砚，我都忘了问呢，之前你来找胡桃，是早就知道边界的问题了吗？"
        },
        {
          "role": "蓝砚",
          "text": "哈哈，这个啊？我该早点跟你们说的，要不等会来冒险家协会找我吧？我想先写封信，给家里报个平安，再问点事情。"
        },
        {
          "role": "派蒙",
          "text": "那我们一会在冒险家协会见哦！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（凝光）"
        },
        {
          "role": "凝光",
          "text": "嗯…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "凝光还在思考什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "十数年前的无妄坡之灾，我始终心有不宁。但既然胡堂主认为两者无关，我也不好再问…"
        },
        {
          "type": "subtitle",
          "text": "去冒险家协会与蓝砚见面"
        },
        {
          "role": "蓝砚",
          "text": "旅行者，派蒙！这边这边！你们来的正是时候，我刚把信寄回去。"
        },
        {
          "role": "蓝砚",
          "text": "话说，你们是不是都以为我会什么厉害的法术，预测到了边界的危机？"
        },
        {
          "role": "派蒙",
          "text": "对啊对啊，都说沉玉谷蓝氏会什么奇门术，很厉害，难道不是吗？"
        },
        {
          "role": "蓝砚",
          "text": "唉，你们都误会啦，蓝氏确实有奇门术传承，族谱里记载的祖宗，也确实有那位万象风角灵官。"
        },
        {
          "role": "蓝砚",
          "text": "但我们早就从宗家分出来啦，祖先的奇门术在我爷爷这里，已经几乎算是江湖把戏了。"
        },
        {
          "role": "蓝砚",
          "text": "说直接一点，他就是在遗珑埠给人卜卦算命为生的，赚的还没我做手工品多呢。"
        },
        {
          "role": "派蒙",
          "text": "欸？那你怎么会来找胡桃啊？"
        },
        {
          "role": "蓝砚",
          "text": "其实是前段时间，爷爷的卜卦出问题了，姻缘卦、事业卦倒还好，偏偏寿数卦，无论算谁，一概是短命，可把爷爷吓坏了。"
        },
        {
          "role": "蓝砚",
          "text": "为了避免被客人打骂，爷爷索性收摊回家，关起门来，日算夜算，最后只算出了三个字：往生堂。可他也不知道这是什么意思。"
        },
        {
          "role": "蓝砚",
          "text": "恰好那时，我被总务司邀请来筹办街会，就想着不如顺道来往生堂看看，也许胡堂主会知道些什么。"
        },
        {
          "role": "派蒙",
          "text": "啊…那这样说…其实爷爷并没有算错？他算到了危机爆发的后果，也算到了往生堂有办法！"
        },
        {
          "role": "蓝砚",
          "text": "现在看来，可能是这样，现在所有生者都面临着死的威胁，但只有我们这些人知道。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那这藤人是怎么回事？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蓝砚",
          "text": "欸？这不是我留在莺儿小姐店里的吗？这其实是正宗的奇门术法，上面刻了降魔古印，可以吸收阴邪之气，替人挡灾。"
        },
        {
          "role": "蓝砚",
          "text": "没想到居然到了你这里，哈哈，看来是缘分啊，不嫌弃的话，你就留着吧。"
        },
        {
          "role": "蓝砚",
          "text": "初来璃月港时，我路过一家大宅，感觉阴冷得很，就做了这个藤人，交给了那家的少爷。"
        },
        {
          "role": "蓝砚",
          "text": "之后在蒂玛乌斯那，我也感觉到同样的气息，就又做了个藤人，留在了春香窑。"
        },
        {
          "role": "蓝砚",
          "text": "再之后我追着胡堂主来到无妄坡，她却消失不见了，我四处转转，发现了七七姑娘，她正挤在一个山缝缝里，好像堵住了什么。"
        },
        {
          "role": "蓝砚",
          "text": "我去拉她，没拉出来，反而和她一起掉进了个十分阴冷的地方，现在你们知道了，那里就是边界。"
        },
        {
          "role": "蓝砚",
          "text": "后来我们在边界乱转，遇见了胡堂主，她点了香，还拿一根烧火棍四处烧死气。"
        },
        {
          "role": "蓝砚",
          "text": "可惜死气实在太多了，不仅烧不完，还把我们进去的口子遮住了，我们就这样被困在了里面。多亏后来你们来了！"
        },
        {
          "role": "派蒙",
          "text": "原来是这么回事啊…果然蓝砚你们家也是很厉害的嘛！你不是还在里面布了幻阵嘛？"
        },
        {
          "role": "蓝砚",
          "text": "那其实和小藤人一样，是我跟一位宗家的姐姐学的啦。她自小修习奇门要术，我写信回去，也是有问题想要问她。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于八门七门大阵？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蓝砚",
          "text": "这你都猜得到？没错，我就是想确认，八门七门大阵究竟是不是必须要隐去一人，也许我姐姐会知道。"
        },
        {
          "role": "派蒙",
          "text": "欸？可胡桃不是说不会吗？她说只要能承受住死气就好了。"
        },
        {
          "role": "蓝砚",
          "text": "嗯…我当然也希望是这样，但还是有些不安。我和胡堂主虽然才认识不久，但我感觉…她是一个喜欢藏心事的人。"
        },
        {
          "role": "蓝砚",
          "text": "别看她话不少，好听的也说，不好听的也说，但她几乎不说她在想什么，好像已经把所有事都安排好了一样。"
        },
        {
          "role": "派蒙",
          "text": "你该不会是指…她骗了我们…？"
        },
        {
          "role": "蓝砚",
          "text": "倒也不是骗…不过你们还记得刚才天权大人提到十多年前无妄坡的事吗？"
        },
        {
          "role": "派蒙",
          "text": "记得！胡桃说和现在的危机没关系。难道…有关系？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于那件事，蓝砚知道什么吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蓝砚",
          "text": "我以前只知道有洪水，但考虑现在的情况，说不定也和边界有关，这更能解释无妄坡现在的诡异天气。"
        },
        {
          "role": "蓝砚",
          "text": "我还听本家的姐姐说过，那次往生堂有在无妄坡设坛，我原以为是奠事，但现在看，也有可能是某种针对边界的法事。"
        },
        {
          "role": "蓝砚",
          "text": "那次做法事的人，是上两代往生堂堂主，胡堂主的爷爷和父亲。"
        },
        {
          "role": "派蒙",
          "text": "胡桃的爷爷和父亲？！她好像从来没提过她父亲…你这样说，难道还真有内情？"
        },
        {
          "role": "蓝砚",
          "text": "嗯…可刚才连天权大人问话，胡堂主都不说…我跟她认识才两天，就更不好说什么了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们去胡桃那看看吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸？要去问她吗…？以我们和她的关系…她要是不愿意说怎么办？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那也不能强求了。",
              "dialogues": []
            },
            {
              "text": "派蒙去按着她的头，让她老实交代。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那也太没礼貌了啊！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唉，总之先过去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（蓝砚）"
        },
        {
          "role": "蓝砚",
          "text": "希望能快点收到回信。"
        },
        {
          "type": "subtitle",
          "text": "去往生堂看看胡桃"
        },
        {
          "role": "胡桃",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "胡桃！"
        },
        {
          "role": "胡桃",
          "text": "旅行者，派蒙！怎么，这才刚分开，就想我啦？"
        },
        {
          "role": "派蒙",
          "text": "是呀，所以来找你玩啦。嘿嘿，你刚才在看什么呀？"
        },
        {
          "role": "胡桃",
          "text": "看好东西哦，但是不给你们看。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "该不会偷偷藏了我的画片吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡桃",
          "text": "哈哈，这个玩笑开得不好，不吉利。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不吉利？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡桃",
          "text": "这幅画上的人，我最近总是梦到，除了我都已经不在啦。"
        },
        {
          "role": "胡桃",
          "text": "哈哈，不开玩笑了，给你们看吧。"
        },
        {
          "role": "派蒙",
          "text": "哦？这是…？"
        },
        {
          "role": "胡桃",
          "text": "嗯，我爷爷和我老爹。要不是这幅画，我都不记得老爹长什么样子了。他走的时候，我就那么大，都还不记事。"
        },
        {
          "role": "胡桃",
          "text": "关于老爹的事，也全是爷爷告诉我的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以老爹是…？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡桃",
          "text": "十多年前在无妄坡，边界异动，他用护摩秘法焚烧死气，却不慎沾染太多，当场把自己送走。"
        },
        {
          "role": "派蒙",
          "text": "啊？怎么会这样…那今天的无妄坡…"
        },
        {
          "role": "胡桃",
          "text": "嗯，也是因为老爹的失败，不仅搭进去了自己，大半个村子的人也没能幸免，无妄坡还变成了现在这个样子。"
        },
        {
          "role": "胡桃",
          "text": "后来，是爷爷替他收了尾。而爷爷驾鹤西归时，也还未过花甲…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "爷爷也受了影响？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡桃",
          "text": "爷爷当然说没有，但他身体一直很好，原本一定能多活几年的…"
        },
        {
          "role": "派蒙",
          "text": "胡桃…你不会是在怪你老爹吧…"
        },
        {
          "role": "胡桃",
          "text": "怎么不怪？如果他是一介纨绔，学艺不精，我都不会怪他，但他是个天才，他的法术比我们都要厉害啊。"
        },
        {
          "role": "胡桃",
          "text": "爷爷总说我有天赋，八岁就学会了往生术法，但老爹呢，八岁都已经能独立主持祭仪、焚烧死气了。"
        },
        {
          "role": "胡桃",
          "text": "可这样的人，却连那种小问题都没能解决，让人怎么不怪？"
        },
        {
          "role": "派蒙",
          "text": "但…但那又是因为什么呢？"
        },
        {
          "role": "胡桃",
          "text": "因为他是一个不称职的往生堂堂主。历代堂主在离开时，都会把自己的物品带走，最多留下一两件，其他全烧干净。"
        },
        {
          "role": "胡桃",
          "text": "爷爷就只留下了往生堂的帽子，老爹倒好，留了一大堆东西，还有这张毫无意义的画片…"
        },
        {
          "role": "派蒙",
          "text": "这说明你们是他重要的人吧…"
        },
        {
          "role": "胡桃",
          "text": "不，这只能说明他的舍不得。而他失败的原因，也就是舍不得。"
        },
        {
          "role": "胡桃",
          "text": "就是因为他舍不得变老的爷爷，还小的我，舍不得大家都在的世界。"
        },
        {
          "role": "胡桃",
          "text": "所以他在最后关头才会犹豫，才会畏惧，才会心神不稳，输给了死亡，连累那么多人。"
        },
        {
          "role": "胡桃",
          "text": "干我们这行，见得最多的，就是舍不得。但要是当了堂主啊，最忌讳的，也是舍不得。"
        },
        {
          "role": "胡桃",
          "text": "爷爷总说，生于生时，亡于亡刻…往生堂的一切，就在这八个字里。"
        },
        {
          "role": "胡桃",
          "text": "可惜老爹左耳朵进，右耳朵出，真是不像话。"
        },
        {
          "role": "派蒙",
          "text": "你也不用把他说成这样嘛…他肯定也不希望这样的…"
        },
        {
          "role": "胡桃",
          "text": "小派蒙还不明白，正因为是老爹，我才可以这么说他。"
        },
        {
          "role": "胡桃",
          "text": "天底下所有的老爹，都不会责怪女儿的任性的。因为他们害怕自己不在了，女儿就不能再当一个可以随便任性的小朋友了。"
        },
        {
          "role": "胡桃",
          "text": "所以，我就是要这么任性地说他，万一被他听去，一定就能知道我过得很好，也就能放心了吧…"
        },
        {
          "role": "胡桃",
          "text": "好啦，这就是无妄坡以前的事啦。还想知道什么吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你告诉我们这些。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡桃",
          "text": "嘿嘿，是不是以为我会瞒着？我们什么关系呀。"
        },
        {
          "role": "胡桃",
          "text": "而且你才把我从边界捞回来，我还在想要怎么感谢你呢。当然是有问必答，无问也必答。"
        },
        {
          "role": "派蒙",
          "text": "那我最后确认一个问题哦！胡桃今天说的，八门七门大阵不会有人有事，是真的吧？"
        },
        {
          "role": "胡桃",
          "text": "没错，我是这么认为的！"
        },
        {
          "role": "派蒙",
          "text": "那我就放心了。"
        },
        {
          "role": "胡桃",
          "text": "别想那么多啦，还有两天的时间，多去街会上玩玩吧。旅行者说的哦，要劳逸结合。"
        },
        {
          "role": "胡桃",
          "text": "两天后，我们就在玉京台见吧，这一次，我们要把死亡烧成灰。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（胡桃）"
        },
        {
          "role": "胡桃",
          "text": "快好好休息吧，两天后还有要紧事等着我们呢。"
        }
      ],
