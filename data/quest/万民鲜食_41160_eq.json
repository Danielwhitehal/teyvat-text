{
  "quest_id": 41160,
  "chapter_num": null,
  "chapter_title": "万民鲜食",
  "type": "eq",
  "route": "Wanmin Fresh",
  "stories": [
    {
      "story_id": 41160,
      "title": "万民鲜食",
      "description": "璃月港的万民堂里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "卯师傅",
          "text": "好吧，我想想别的法子…"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "卯师傅",
          "text": "那麻烦了。"
        },
        {
          "role": "卯师傅",
          "text": "路上小心，别沾了奇怪的元素，也注意别受伤。"
        },
        {
          "role": "寡言的廷方",
          "text": "确实，我，饿了。"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "卯师傅",
          "text": "是的。有个叫做廷方的人，在我们这订了一份珍珠翡翠白玉汤，之后人就往青墟浦走了。"
        },
        {
          "role": "卯师傅",
          "text": "我也不知道他有什么隐情啦。不过我们厨子保证自己做出来的东西味道无可挑剔。"
        },
        {
          "role": "卯师傅",
          "text": "这份珍珠翡翠白玉汤，要麻烦你帮忙送过去了。不要乱飞，可能会把羹洒出来。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "寡言的廷方",
          "text": "感激。卯师傅手艺还是比言笑要好。"
        }
      ]
    }
  ]
}