{
  "quest_id": 71528,
  "chapter_num": null,
  "chapter_title": "暂无止境的斗虫之路！",
  "type": "wq",
  "route": "Provisionally Perpetual Beetle Battle!",
  "stories": [
    {
      "story_id": 71528,
      "title": "暂无止境的斗虫之路！",
      "description": "经历了「荒泷甲光烈烈斗虫大修行」后，荒泷一斗似乎意识到了，鬼兜虫的力量终究是有极限的，一个大胆的新计划正在他的脑海中慢慢成形…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "对战「天崩石裂超级强者」"
        },
        {
          "role": "「超级强者的随行厨神」",
          "text": "哟！各位好呀，最近玩得还开心吗？"
        },
        {
          "role": "派蒙",
          "text": "香菱，锅巴！你们终于来了！放牛的（「真剑斗虫大鬼王」）现在可正在劲头上呢。"
        },
        {
          "role": "荒泷一斗",
          "text": "总算等到这一天了！"
        },
        {
          "role": "荒泷一斗",
          "text": "锅巴兄！就让你见识一下，经历了「荒泷甲光烈烈大修行」后，本大爷…哦不，是我和「赤红一杵」的实力！"
        },
        {
          "role": "荒泷一斗",
          "text": "然后，就要麻烦你教教我了——如何跟「赤红一杵」，还有「水晶岛梆梆旋风」这些甲壳生物交流！"
        },
        {
          "role": "荒泷一斗",
          "text": "等到我成为了斗虫界最有名望的强者，我就要…在荒泷派的鬼兜虫本阵，为你打造一座特大特威风的雕像！"
        },
        {
          "role": "「天崩石裂超级强者」",
          "text": "♪~"
        },
        {
          "role": "荒泷一斗",
          "text": "什么！这就是是锅巴兄自备的鬼兜虫吗…"
        },
        {
          "role": "派蒙",
          "text": "质感看起来很不一般！"
        },
        {
          "role": "「花角玉将」",
          "text": "不像是正常鬼兜虫的甲壳，而是某种坚韧的木质材料，难道它穿上了装甲？"
        },
        {
          "role": "烟绯",
          "text": "姥姥听说了「荒泷甲光烈烈斗虫大修行」的前因后果，觉得「锅巴可能收徒」这件事很有意思…"
        },
        {
          "role": "烟绯",
          "text": "正好，[[闲云|有位朋友]]给她制作了许多园艺机关，用来打理花坛里的霓裳花，名为「花羽叶月神机」。"
        },
        {
          "role": "「超级强者的随行厨神」",
          "text": "「花羽叶月神机」可以化形为各种动物，自然地融入环境。松鼠、蝴蝶、团雀都不在话下，当然也包括鬼兜虫。"
        },
        {
          "role": "「超级强者的随行厨神」",
          "text": "所以，师父给了锅巴一个「花羽叶月神机」，让它化形为鬼兜虫的模样，且来与你一战。"
        },
        {
          "role": "派蒙",
          "text": "真的只是园艺机关而已吗？"
        },
        {
          "role": "派蒙",
          "text": "香菱的师父是萍姥姥…萍姥姥的朋友…萍姥姥的朋友！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是谁来着？",
              "dialogues": []
            },
            {
              "text": "先别剧透…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "机关怎么可能模拟鬼兜虫的特点嘛！难道锅巴兄是想试探我们的实力，所以故意用了很弱的家伙来对阵？"
        },
        {
          "role": "「花角玉将」",
          "text": "还是小心为妙，鬼王，我好像感知不到那只机关鬼兜虫的气息…或者说，深不见底。"
        },
        {
          "role": "荒泷一斗",
          "text": "机关又不是活的，你感觉不到气势很正常。"
        },
        {
          "role": "荒泷一斗",
          "text": "呃咳，虽说锅巴兄的确强得没边，但强者也需要趁手的武器和默契的伙伴。我和「赤红一杵」的组合可不是吃素的哦！"
        },
        {
          "role": "荒泷一斗",
          "text": "开始对决吧，我会用接下来的一招一式，向锅巴兄好好证明我们的实力！"
        },
        {
          "role": "「天崩石裂超级强者」",
          "text": "♪——"
        },
        {
          "role": "挑战",
          "text": "'''强者的最终考验？'''"
        },
        {
          "type": "subtitle",
          "text": "斗虫大修行即将开始…",
          "narration": true,
          "color": "描述1"
        },
        {
          "type": "subtitle",
          "text": "击败「花羽叶月神机」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "专注难度挑战成功",
              "dialogues": [
                {
                  "role": "「天崩石裂超级强者」",
                  "text": "♪~"
                }
              ]
            },
            {
              "text": "倾力难度挑战成功",
              "dialogues": [
                {
                  "role": "「天崩石裂超级强者」",
                  "text": "♪♪♪~"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与荒泷一斗一行对话"
        },
        {
          "role": "派蒙",
          "text": "呜啊！放牛的（「真剑斗虫大鬼王」）居然这么顺利地打赢了「花羽叶月神机」！"
        },
        {
          "role": "荒泷一斗",
          "text": "成功了！赢了！我和「赤红一杵」胜过了锅巴兄（「天崩石裂超级强者」）！"
        },
        {
          "role": "荒泷一斗",
          "text": "接下来…嗯，咳咳！我要等不及了！"
        },
        {
          "role": "荒泷一斗",
          "text": "希望锅巴兄能肯定我的实力，要教教我，怎么和甲壳生物交流…"
        },
        {
          "role": "锅巴",
          "text": "♪~"
        },
        {
          "role": "荒泷一斗",
          "text": "嗯？明明被我小胜一局，锅巴兄怎么好像更高兴了？"
        },
        {
          "role": "荒泷一斗",
          "text": "难道说…是为我突飞猛进的实力而惊喜吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "这怎么好意思呢！哈哈哈哈哈哈不用这么夸我的锅巴兄！都是锅巴兄太谦虚，使用了普普通通的机关…"
        },
        {
          "role": "烟绯",
          "text": "看样子，锅巴觉得热身结束了，可以启用这台「花羽叶月神机」的最大力道了。"
        },
        {
          "role": "香菱",
          "text": "锅巴，我们就按照之前约定好的，把园艺机关的出力从千分之一调整到百分之一吧？"
        },
        {
          "role": "香菱",
          "text": "再大的话，可能会把一斗先生的鬼兜虫直接打晕。"
        },
        {
          "role": "锅巴",
          "text": "♪！"
        },
        {
          "role": "派蒙",
          "text": "果然，我一点也不意外呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哎呀！千分之一！",
              "dialogues": []
            },
            {
              "text": "哎呜！这怎么打！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「花角玉将」",
          "text": "结果还真是深不见底…"
        },
        {
          "role": "荒泷一斗",
          "text": "等等！慢着！"
        },
        {
          "role": "荒泷一斗",
          "text": "千分之一？个十百千…千？"
        },
        {
          "role": "荒泷一斗",
          "text": "别别别开玩笑了，刚才那种级别的力量，只有…千分之一的力道？"
        },
        {
          "role": "锅巴",
          "text": "♪？"
        },
        {
          "role": "烟绯",
          "text": "锅巴有点疑惑，你不是想训练鬼兜虫，打败「水晶岛梆梆旋风」吗？"
        },
        {
          "role": "香菱",
          "text": "毕竟体型的差距摆在这里嘛，「花羽叶月神机」要搬开砂锅大小的石头，肯定需要这么多力气。"
        },
        {
          "role": "香菱",
          "text": "更别说比锅巴和我…甚至比你个子还大的「水晶岛梆梆旋风」了！"
        },
        {
          "role": "荒泷一斗",
          "text": "不可能，比刚才强两倍的对手还好说，强十倍…就已经不是输多少次才能打赢的问题了！"
        },
        {
          "role": "荒泷一斗",
          "text": "至于一千倍，简直是在做梦！"
        },
        {
          "role": "荒泷一斗",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "「一种战术行不通的时候，就要换个思路，我和旅行者在其他地方旅行的时候，常常灵活思考！」"
        },
        {
          "role": "派蒙",
          "text": "「只盯着一种方法做事的话，再用力也解决不了问题！」"
        },
        {
          "role": "荒泷一斗",
          "text": "锅巴兄，我明白了！"
        },
        {
          "role": "荒泷一斗",
          "text": "我要学习机关术！为「赤红一杵」打造一套装甲，让它突破自己的上限！"
        },
        {
          "role": "荒泷一斗",
          "text": "或者干脆…制造一台由「赤红一杵」驾驶的，更大的机关鬼兜虫，由我来指挥它操纵机关！"
        },
        {
          "role": "锅巴",
          "text": "？！"
        },
        {
          "role": "派蒙",
          "text": "鬼兜虫驾驶机关鬼兜虫…真的能办到这种事吗？还算是斗虫吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "敢想就能做到！",
              "dialogues": []
            },
            {
              "text": "我超相信一斗！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "见识到了「花羽叶月机关」的力量后，我意识到了…鬼兜虫的力量终究是有极限的！"
        },
        {
          "role": "荒泷一斗",
          "text": "阿忍和玉将…尤其是「破空白铁小堇瓜」都提醒过我！认输很可耻，但一点都不知道变通的话，未免也太笨了！"
        },
        {
          "role": "荒泷一斗",
          "text": "锅巴兄为我指明了一条新的道路——用机关术强化鬼兜虫！"
        },
        {
          "role": "荒泷一斗",
          "text": "这样一来，就算有着超大的体型差距，本大爷的鬼兜虫，也不会输给那只「水晶岛梆梆旋风」！"
        },
        {
          "role": "锅巴",
          "text": "♪♪？"
        },
        {
          "role": "烟绯",
          "text": "唔，这方面的事，锅巴好像完全不懂？"
        },
        {
          "role": "香菱",
          "text": "机关术这一类的东西，应该要托师父问问那位朋友，看看她乐不乐意…"
        },
        {
          "role": "荒泷一斗",
          "text": "那就麻烦锅巴兄，厨神小姐和大恩人引荐…"
        },
        {
          "role": "久岐忍",
          "text": "嗯哼？"
        },
        {
          "role": "久岐忍",
          "text": "老大…你也想在璃月留学？"
        },
        {
          "role": "荒泷一斗",
          "text": "阿忍！你什么时候来的！"
        },
        {
          "role": "久岐忍",
          "text": "约定的时间到了，再不往港口赶过去，我们用最后的摩拉买到的船票就要报废了。"
        },
        {
          "role": "荒泷一斗",
          "text": "你你你…你先等等！这边还在讨论很重要的事。"
        },
        {
          "role": "久岐忍",
          "text": "我都听到了。"
        },
        {
          "role": "久岐忍",
          "text": "你主动提出要「学」什么东西，我倒是挺欣慰的，这方面的经验，我可以直接写一本小手册给你。"
        },
        {
          "role": "久岐忍",
          "text": "可惜在璃月留学需要资金，比荒泷派平常的开销多出许多倍的资金。这笔钱，你心里有数吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "大大大大不了…回稻妻以后，好好做一段时间的工！"
        },
        {
          "role": "荒泷一斗",
          "text": "又不是没有打过工，挣过摩拉！我刚刚都说出那样的话了，当然做好了心理准备！只要多出点力，多少钱都挣得到！"
        },
        {
          "role": "荒泷一斗",
          "text": "而且，我也不打算抛下你和荒泷派的兄弟们不管！一个人跑老远去钻研学问，还算个什么老大！"
        },
        {
          "role": "荒泷一斗",
          "text": "要学就大家一起学！凑够所有人的学费，全荒泷派一起来留学，一起变强，到时候，我们就成了「天下无敌的荒泷派」！"
        },
        {
          "role": "久岐忍",
          "text": "老大？你什么时候…学会说这种漂亮话了？"
        },
        {
          "role": "派蒙",
          "text": "好！放牛的（「真剑斗虫大鬼王」）难得说出这种豪言壮语，你可要说到做到哦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大男子汉言出必行！",
              "dialogues": []
            },
            {
              "text": "不求别人只靠自己！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "嘿！不过具体要做什么工，每天得挣多少钱，我还没仔细算过…"
        },
        {
          "role": "「花角玉将」",
          "text": "既然如此，鬼王，我就留在璃月好了。一方面可以跟着厨神姐姐，仔细询问学习机关术的事宜。"
        },
        {
          "role": "「花角玉将」",
          "text": "另一方面，「荒泷甲光烈烈斗虫大修行」刚刚被宣传开来，我可以考察更多斗虫强者，还有对培养鬼兜虫有益的食物。"
        },
        {
          "role": "「花角玉将」",
          "text": "要是「鬼王的左膀右臂」殿下和「破空白铁小堇瓜」大人还想斗虫，或复盘，我也可以在这里陪他们继续玩。"
        },
        {
          "role": "荒泷一斗",
          "text": "好啊！正合我意，玉将！"
        },
        {
          "role": "荒泷一斗",
          "text": "那就按照惯例，我转告你的祖父，让他不必担心。"
        },
        {
          "role": "荒泷一斗",
          "text": "我很期待！下次再见面的时候，你会给我们带来什么样的惊喜！"
        },
        {
          "role": "香菱",
          "text": "先说好哦，我也不敢打包票，能说动那位仙人赐教…我和烟绯会尽力试试的，接下来就都看缘分了！"
        },
        {
          "role": "「花角玉将」",
          "text": "那位大师掌握如此之强的技艺，再高傲也没关系！重要的是，我也得替鬼王，替整个荒泷派表达诚心…"
        },
        {
          "role": "「花角玉将」",
          "text": "所以我必须好好考察一下，献上什么样的礼物，才能配得上制造这「花羽叶月神机」的高强本领。"
        },
        {
          "role": "久岐忍",
          "text": "再晚就来不及了，老大。"
        },
        {
          "role": "荒泷一斗",
          "text": "唉…没辙了！"
        },
        {
          "role": "久岐忍",
          "text": "旅行者，派蒙，烟绯师姐，香菱小姐和锅巴先生，你们肯陪着老大举办这场斗虫大会，真是万分感谢…"
        },
        {
          "role": "久岐忍",
          "text": "请收下这份谢礼，希望它能在你们之后的旅途中派上用场。"
        },
        {
          "role": "派蒙",
          "text": "哇啊，真的准备了礼物…阿忍好细心！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "开心开心！",
              "dialogues": []
            },
            {
              "text": "双赢双赢！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "是时候道别了，我的挚友，「破空白铁小堇瓜」，锅巴兄，厨神小姐还有大恩人！"
        },
        {
          "role": "荒泷一斗",
          "text": "用不了多久！我们还会再见面的！"
        },
        {
          "role": "锅巴",
          "text": "♪♫♩♪♬~"
        },
        {
          "role": "派蒙",
          "text": "就知道你要说这句话，放牛的（「真剑斗虫大鬼王」）！"
        },
        {
          "role": "派蒙",
          "text": "有志气是好事，不过也不要操之过急哦！还是要多听听阿忍的意见，考虑现实情况，劳逸结合！"
        },
        {
          "role": "派蒙",
          "text": "当然，我也希望——下次见面的时候，你真的能做出…超~级~大的，鬼兜虫驾驶的机关鬼兜虫！"
        },
        {
          "role": "「水晶岛梆梆旋风」",
          "text": "……"
        },
        {
          "role": "「水晶岛梆梆旋风」",
          "text": "？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（「天崩石裂超级强者」）"
        },
        {
          "role": "「超级强者的随行厨神」",
          "text": "哟，旅行者！要再和锅巴玩一局吗？锅巴似乎还想再试试「花羽叶月神机」的本领！"
        },
        {
          "role": "「天崩石裂超级强者」",
          "text": "♪~"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我就扮一回一斗！",
              "dialogues": [
                {
                  "role": "「超级强者的随行厨神」",
                  "text": "好耶！再来一次斗虫大较量！"
                },
                {
                  "role": "「天崩石裂超级强者」",
                  "text": "♪！"
                }
              ]
            },
            {
              "text": "「万民堂」重新开业的准备如何了？",
              "dialogues": [
                {
                  "role": "「超级强者的随行厨神」",
                  "text": "店里已经不那么忙啦，所以我和锅巴才能一直在这里玩斗虫，谢谢关心！"
                },
                {
                  "role": "「超级强者的随行厨神」",
                  "text": "食材都补充得差不多了，再过几天应该就能照常营业！"
                },
                {
                  "role": "「超级强者的随行厨神」",
                  "text": "如果你和派蒙还没吃够，那欢迎随时再来！"
                },
                {
                  "role": "「天崩石裂超级强者」",
                  "text": "♪~"
                }
              ]
            },
            {
              "text": "先走了，下次再来！",
              "dialogues": [
                {
                  "role": "「超级强者的随行厨神」",
                  "text": "没问题，下回再见咯！"
                },
                {
                  "role": "「天崩石裂超级强者」",
                  "text": "♪！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（「花角玉将」）"
        },
        {
          "role": "「花角玉将」",
          "text": "「鬼王的左膀右臂」殿下，有什么我能帮你们的事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "给我也整一只鬼兜虫！",
              "dialogues": [
                {
                  "role": "「花角玉将」",
                  "text": "好！完全不在话下！"
                },
                {
                  "role": "「花角玉将」",
                  "text": "不过，斗虫强者和鬼兜虫之间的相性，还需要很长的时间来观察…"
                },
                {
                  "role": "「花角玉将」",
                  "text": "凭借之前和您斗虫的经历，我大概能推测出最符合您斗风格的鬼兜虫。当然，对我而言也是一个重大的考验。"
                },
                {
                  "role": "「花角玉将」",
                  "text": "我得好好想想了，要去什么样的地点，才能抓到那种鬼兜虫…"
                },
                {
                  "role": "「花角玉将」",
                  "text": "就要麻烦您耐心等待了，希望下次见面时，我能给你一份完美的答卷！"
                }
              ]
            },
            {
              "text": "关于送礼的事…",
              "dialogues": [
                {
                  "role": "「花角玉将」",
                  "text": "啊呀，你是说我们要给那位大师的礼物吗？"
                },
                {
                  "role": "「花角玉将」",
                  "text": "说实话，我一时还没有很好的点子…"
                },
                {
                  "role": "「花角玉将」",
                  "text": "那位大师能制作出无比精妙的「花羽叶月神机」，或许，买些精密的机械加工设备，好好包装在礼盒中，能让那位大师满意…"
                },
                {
                  "role": "「花角玉将」",
                  "text": "不过我手里只剩两百万摩拉了，怕是很难买到最顶尖的装置，入不了那位大师的法眼。"
                },
                {
                  "role": "「花角玉将」",
                  "text": "而且我也不知道要在璃月待多久，自己吃住也要花费摩拉，得想想办法扩充行动资金了…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "两百万好像也不少吧…",
                      "dialogues": []
                    },
                    {
                      "text": "这些钱都是你自己的？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "「花角玉将」",
                  "text": "小部分是我平常节省伙食费攒下来的，大部分是我祖父给我的。"
                },
                {
                  "role": "「花角玉将」",
                  "text": "我的祖父以前是很厉害的冒险家，每次带着他的鬼兜虫出远门，都会被好运眷顾，找到一大笔财宝。"
                },
                {
                  "role": "「花角玉将」",
                  "text": "所以他非常支持我的斗虫事业，每隔一段时间，都会给我一笔存款，我也没有乱花，总有一天要把这笔钱花在最重要的地方！"
                },
                {
                  "role": "「花角玉将」",
                  "text": "之前，我看荒泷派的经济情况实在不好，提出要支援鬼王一笔资金，鬼王每次都拒绝了，还说…"
                },
                {
                  "role": "「花角玉将」",
                  "text": "「哪有让盟友出钱的道理！本大爷和荒泷派可是有骨气的！」"
                },
                {
                  "role": "「花角玉将」",
                  "text": "我尊重鬼王的气节，所以，买到了送给那位大师的礼物后，我也会向鬼王报销的…不管需要几百万摩拉！"
                }
              ]
            },
            {
              "text": "回见了，玉将！",
              "dialogues": [
                {
                  "role": "「花角玉将」",
                  "text": "好啊，您先忙，「鬼王的左膀右臂」殿下！"
                }
              ]
            }
          ]
        }
      ],
