        {
          "type": "subtitle",
          "text": "帮小月在沙滩上寻找星螺"
        },
        {
          "type": "subtitle",
          "text": "与小月对话"
        },
        {
          "role": "小月",
          "text": "你找到星螺了吗？"
        },
