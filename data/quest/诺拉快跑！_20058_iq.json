{
  "quest_id": 20058,
  "chapter_num": null,
  "chapter_title": "诺拉快跑！",
  "type": "iq",
  "route": "Nora, Run!",
  "stories": [
    {
      "story_id": 20058,
      "title": "诺拉快跑！",
      "description": "诺拉想要去风神像上玩，但是葛瑞丝修女并不同意…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与诺拉对话"
        },
        {
          "role": "诺拉",
          "text": "呜…怎么办呢…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "诺拉",
          "text": "你看见风神像了吗？往上看，很高很高的地方…就是风神大人手的那个地方。"
        },
        {
          "role": "诺拉",
          "text": "我想要上去玩…但是，葛瑞丝阿姨一定不会让我爬上去的…"
        },
        {
          "role": "诺拉",
          "text": "拜托拜托，拜托你去和葛瑞丝阿姨说话吧，别让她看过来，我爬得很快，一下子就能爬上去…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧…",
              "dialogues": [
                {
                  "role": "诺拉",
                  "text": "那就拜托你啦！"
                }
              ]
            },
            {
              "text": "太危险了。",
              "dialogues": [
                {
                  "role": "诺拉",
                  "text": "没关系啦，我可是很厉害的。"
                }
              ]
            }
          ]
        },
        {
          "role": "诺拉",
          "text": "总之，就拜托你去吸引住葛瑞丝阿姨了，我这就去…"
        },
        {
          "role": "葛瑞丝",
          "text": "诺拉，不准去！"
        },
        {
          "role": "葛瑞丝",
          "text": "呼…稍微走神了一会，她居然来麻烦您了，抱歉。"
        },
        {
          "role": "诺拉",
          "text": "怎么这样！就是上去玩一玩…"
        },
        {
          "role": "葛瑞丝",
          "text": "不行就是不行，你父亲也不会允许的。"
        },
        {
          "role": "葛瑞丝",
          "text": "还有您，请您也别迁就她。要是您做这种危险的事情，肯定也有人会担心的吧。"
        },
        {
          "type": "subtitle",
          "text": "与诺拉对话"
        },
        {
          "role": "诺拉",
          "text": "呜…"
        },
        {
          "role": "旅行者",
          "text": "要上去做什么？"
        },
        {
          "role": "诺拉",
          "text": "葛瑞丝阿姨说，如果想要向谁说悄悄话，只要告诉蒲公英，然后撒出去，风神大人就会把蒲公英和悄悄话一起带给那个人。"
        },
        {
          "role": "诺拉",
          "text": "而且撒的地方越高，心愿就能传达地越快…"
        },
        {
          "role": "诺拉",
          "text": "葛罗丽姐姐就拜托过冒险家，帮自己去风神像上撒过蒲公英…结果隔了几天，古德温哥哥就回信了！"
        },
        {
          "role": "诺拉",
          "text": "诺拉也有悄悄话告诉爸爸，而且也找好蒲公英了！"
        },
        {
          "role": "诺拉",
          "text": "但是…葛瑞丝阿姨一直不许，一直说等我长大之后，才能回去和爸爸一起住。"
        },
        {
          "role": "诺拉",
          "text": "到底怎么样才能长大得更快呢，我也在很努力地锻炼了，但还是这么矮…"
        },
        {
          "role": "诺拉",
          "text": "嗯…我经常看见你在城里飞来飞去，你能教教我，平时你都是怎么飞的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "诺拉",
                  "text": "嘻嘻，那我就在旁边看啦。这次，总是在葛瑞丝阿姨的允许范围内了吧。"
                }
              ]
            },
            {
              "text": "要一起飞吗？",
              "dialogues": [
                {
                  "role": "诺拉",
                  "text": "不行不行，葛瑞丝阿姨看见了，又要训我了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "到达目标"
        },
        {
          "role": "诺拉",
          "text": "用了分钟就飞到了，真厉害。"
        },
        {
          "role": "诺拉",
          "text": "你还能再试试吗？如果能飞得再快一点…"
        },
        {
          "role": "诺拉",
          "text": "我就…就送你很好的宝物。"
        },
        {
          "type": "subtitle",
          "text": "与诺拉对话"
        },
        {
          "role": "诺拉",
          "text": "唔…上次你是这么飞的吗？我记得会更帅气一点呢。"
        },
        {
          "role": "旅行者",
          "text": "这次就这样吧…"
        },
        {
          "role": "诺拉",
          "text": "好吧…好好休息。"
        },
        {
          "role": "诺拉",
          "text": "好厉害！我长大了之后，也能这样飞吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可以的。",
              "dialogues": [
                {
                  "role": "诺拉",
                  "text": "那我要快点长大，等爸爸工作完了，我就要和他一起去玩！"
                }
              ]
            },
            {
              "text": "还要考飞行执照呢。",
              "dialogues": [
                {
                  "role": "诺拉",
                  "text": "飞行执照…那是什么？听着好像就挺难的。"
                }
              ]
            }
          ]
        },
        {
          "role": "诺拉",
          "text": "不过，长大之后应该就不难了吧。"
        },
        {
          "role": "诺拉",
          "text": "谢谢你啦，这些给你，是我悄悄搜集的宝物，就给你做礼物吧。"
        },
        {
          "role": "诺拉",
          "text": "快点收好…还有，别和葛瑞丝阿姨说啊！"
        },
        {
          "type": "subtitle",
          "text": "与诺拉对话"
        },
        {
          "role": "旅行者",
          "text": "再来一次。"
        },
        {
          "role": "诺拉",
          "text": "好嘞！我会在旁边好好看着的。"
        },
        {
          "role": "旅行者",
          "text": "我去稍微休息一下…"
        },
        {
          "role": "诺拉",
          "text": "那要快点喔。"
        },
        {
          "role": "葛瑞丝",
          "text": "唉，诺拉…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你在照顾她吗？",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "哦，因为一些原因，她的母亲…暂时不在家里，目前是由我来照顾。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "还有其他几个需要照顾的孩子，都是由我来负责，这也是修女的责任之一呢。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "我就好像突然多了很多孩子一样，他们都是好孩子，和葛罗丽也都很处得来。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "唔…我照顾时间最长的提米，都开始叫我葛瑞丝妈妈了呢。"
                }
              ]
            },
            {
              "text": "诺拉的爸爸…",
              "dialogues": [
                {
                  "role": "葛瑞丝",
                  "text": "是巴顿先生，他之前因为太喜欢喝酒，家里出了很大的问题。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "教会和西风骑士团都警告过他几次，但他一直没有悔改的意思，最后还是迪卢克老爷帮的忙。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "维多利亚修女的意思是，现在的巴顿不适合照顾诺拉，所以干脆把诺拉交给教会照顾，让巴顿先生一个人反省一段时间。"
                },
                {
                  "role": "葛瑞丝",
                  "text": "但是，诺拉也在长大，「爸爸在努力工作，不能去打扰」的借口也不能用了吧…"
                },
                {
                  "role": "葛瑞丝",
                  "text": "风神大人的蒲公英，也不是哪都能到的啊。"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}