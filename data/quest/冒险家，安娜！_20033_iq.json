{
  "quest_id": 20033,
  "chapter_num": null,
  "chapter_title": "冒险家，安娜！",
  "type": "iq",
  "route": "Anna the Adventurer!",
  "stories": [
    {
      "story_id": 20033,
      "title": "冒险家，安娜！",
      "description": "蒙德城的安娜，似乎已经成功地成为了一位冒险家。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "安娜",
          "text": "旅行者！快看快看，我这身衣服怎么样？好不好看？"
        },
        {
          "role": "旅行者",
          "text": "这身衣服…难道？！"
        },
        {
          "role": "安娜",
          "text": "没错！我已经通过冒险家协会的考试了，正式成为一名冒险家啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很帅气！",
              "dialogues": []
            },
            {
              "text": "恭喜你！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安娜",
          "text": "嘿嘿，谢谢你。我还想让哥哥也试试看呢，结果他怎么样都不肯去…"
        },
        {
          "role": "安东尼",
          "text": "我对冒险没什么兴趣…再说了，我们俩都做了冒险家，谁来照顾爸妈啊？"
        },
        {
          "role": "安娜",
          "text": "那我们就把爸妈都带上，一起去世界各地旅行啊！"
        },
        {
          "role": "安东尼",
          "text": "你啊…行了，既然当上了冒险家，那就好好干，家里的事我来打理就好。"
        },
        {
          "role": "安东尼",
          "text": "但是！一定要注意安全，不要把自己弄伤了，也不要太累…"
        },
        {
          "role": "安娜",
          "text": "知道啦知道啦！我要出去执行委托了！"
        },
        {
          "role": "安娜",
          "text": "旅行者，你要和我一起去吗？我还想请教你许多有关冒险家的问题呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "出发吧！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安娜",
          "text": "好，我看看啊…这次的委托是…"
        },
        {
          "role": "安娜",
          "text": "护送货运热气球！"
        },
        {
          "type": "subtitle",
          "text": "与安娜一同完成冒险家协会的委托"
        },
        {
          "type": "subtitle",
          "text": "与安娜一同完成冒险家协会的委托"
        },
        {
          "role": "安东尼",
          "text": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…"
        },
        {
          "role": "旅行者",
          "text": "你不希望她做冒险家吗？"
        },
        {
          "role": "安东尼",
          "text": "……"
        },
        {
          "role": "安东尼",
          "text": "我尊重我妹妹的梦想。"
        },
        {
          "role": "安东尼",
          "text": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。"
        },
        {
          "role": "安东尼",
          "text": "作为她的哥哥，我…会全力支持她。"
        },
        {
          "role": "安东尼",
          "text": "就这样。"
        },
        {
          "type": "subtitle",
          "text": "与安娜对话"
        },
        {
          "role": "安娜",
          "text": "完成啦！谢谢你旅行者，这次的护送任务很顺利呢。"
        },
        {
          "role": "安娜",
          "text": "不过，冒险家平时去执行的委托，都是这种事情吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "会有其他委托的。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你的语气也太无奈了…"
                }
              ]
            },
            {
              "text": "你慢慢就会知道了…",
              "dialogues": [
                {
                  "role": "安娜",
                  "text": "喂，你的表情不要这么疲惫啊…"
                }
              ]
            }
          ]
        },
        {
          "role": "安娜",
          "text": "是这样吗…好嘞！那我要继续努力了！"
        },
        {
          "role": "安娜",
          "text": "等我攒够了钱，就带着哥哥和爸爸妈妈一起出去旅行！"
        },
        {
          "role": "安娜",
          "text": "哥哥他之前一直想出去旅行的，可是…因为我生病了，他必须留下来照顾我。"
        },
        {
          "role": "安娜",
          "text": "现在我的病已经好了，也成为了冒险家。"
        },
        {
          "role": "安娜",
          "text": "嘿嘿，是时候帮我哥哥完成一些梦想啦。"
        }
      ]
    }
  ]
}