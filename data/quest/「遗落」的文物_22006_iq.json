{
  "quest_id": 22006,
  "chapter_num": null,
  "chapter_title": "「遗落」的文物",
  "type": "iq",
  "route": "The Lost Relic",
  "stories": [
    {
      "story_id": 22006,
      "title": "「遗落」的文物",
      "description": "宝儿自称弄丢了一件贵重的文物，正在焦急地搜索。看起来，她似乎很需要有人来帮忙…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与宝儿交谈"
        },
        {
          "role": "宝儿",
          "text": "到底在哪呢…"
        },
        {
          "role": "旅行者",
          "text": "你又丢了什么…"
        },
        {
          "role": "宝儿",
          "text": "这次没有「丢」，是刚开始找啦！但是——无论如何都找不到啊！"
        },
        {
          "role": "宝儿",
          "text": "到底在哪里，好不容易锁定了位置…"
        },
        {
          "role": "宝儿",
          "text": "你也来和我一起找找吧，这种贵重的文物，绝不能流落在外！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧…",
              "dialogues": [
                {
                  "role": "宝儿",
                  "text": "那你去那边，我继续搜索这里。"
                },
                {
                  "role": "宝儿",
                  "text": "一定要把它找出来！"
                }
              ]
            },
            {
              "text": "这次又是什么文物…",
              "dialogues": [
                {
                  "role": "宝儿",
                  "text": "是一件…一件…呃，年代很久远！可以追溯到…一千，啊不，魔神战争时期。"
                },
                {
                  "role": "宝儿",
                  "text": "总之，是件很贵重的文物，绝不能让它流落在外！你也帮我找找吧！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找宝儿丢失的东西"
        },
        {
          "role": "宝儿",
          "text": "到底在哪呢…"
        },
        {
          "role": "旅行者",
          "text": "这次又是什么文物…"
        },
        {
          "role": "宝儿",
          "text": "是一件…一件…呃，年代很久远！可以追溯到…一千，啊不，魔神战争时期。"
        },
        {
          "role": "宝儿",
          "text": "总之，是件很贵重的文物，绝不能让它流落在外！你也帮我找找吧！"
        },
        {
          "type": "subtitle",
          "text": "解救索拉雅"
        },
        {
          "type": "subtitle",
          "text": "询问索拉雅"
        },
        {
          "role": "索拉雅",
          "text": "05索拉雅闲置对话测试（给宝儿）"
        },
        {
          "role": "索拉雅",
          "text": "谢谢你，旅行者，呼…刚才吓死我了，盗宝团真是越来越猖狂了。"
        },
        {
          "role": "旅行者",
          "text": "你是谁？"
        },
        {
          "role": "索拉雅",
          "text": "我叫索拉雅，是一名游学者，正在这里做研究。"
        },
        {
          "role": "索拉雅",
          "text": "几天前，我循着线索找到了一处遗迹，在里面找到了一枚记载着魔神战争时期历史的玉盘。"
        },
        {
          "role": "索拉雅",
          "text": "但是我取出玉盘之后，刚刚走出遗迹，就被盗宝团袭击了，我跑了一段，还是被他们追上了…"
        },
        {
          "role": "索拉雅",
          "text": "要是没有你们，我和玉盘可能都会有危险，再次感谢你。"
        },
        {
          "role": "旅行者",
          "text": "你也是学者？"
        },
        {
          "role": "索拉雅",
          "text": "…也？还有学者在这里研究吗，那这位的名字是…"
        },
        {
          "role": "索拉雅",
          "text": "宝儿…等一下，在刚才袭击我的盗宝团里，我听见有人说「怎么能让宝儿独吞宝物」。"
        },
        {
          "role": "索拉雅",
          "text": "居然有这么巧的事情…抱歉，能详细和我说说你遇见的那个「宝儿」吗？"
        },
        {
          "role": "旅行者",
          "text": "事情是这样的…"
        },
        {
          "role": "索拉雅",
          "text": "…那位「宝儿」给你指定的地点，恰好都是我选定过的。这样的「巧合」，实在是太巧了。"
        },
        {
          "role": "索拉雅",
          "text": "如果她真是盗宝团的成员，那么按照我的推测，也许我早就被盗宝团跟踪了，他们想跟着我…「捡现成的」。"
        },
        {
          "role": "索拉雅",
          "text": "那个「宝儿」想要独吞财物，于是自己一个人抢先行事，但凭她一个人，实在是搜索不了这么大的范围，所以…"
        },
        {
          "role": "索拉雅",
          "text": "看来…你也许被利用了呢，旅行者。恐怕这次的位置，也是她早就瞄好的，只不过她的同伙和我，都比你早来了一步。"
        },
        {
          "role": "索拉雅",
          "text": "不用紧张，这些暂时只是猜测，但是「宝儿」这个名字…听着就十分可疑，像是个假名，或者代号。"
        },
        {
          "role": "索拉雅",
          "text": "旅行者，你能帮我敷衍一下她吗？无论怎样，也不能把这枚玉盘交给可疑的人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "索拉雅",
                  "text": "谢谢你，不过你这么空手回去，她说不定会起疑。"
                },
                {
                  "role": "索拉雅",
                  "text": "这样，我这里有一个不那么贵重的小玩意，你带回去给她。"
                },
                {
                  "role": "索拉雅",
                  "text": "虽然只是蝇头小利，但也足够让她消停一会的了。"
                }
              ]
            },
            {
              "text": "空手回去会让她怀疑…",
              "dialogues": [
                {
                  "role": "索拉雅",
                  "text": "嗯…有道理，那这样，我这里有一个不那么贵重的小玩意，你带回去给她。"
                },
                {
                  "role": "索拉雅",
                  "text": "虽然只是点蝇头小利，但也足够让她消停一会的了。"
                }
              ]
            }
          ]
        },
        {
          "role": "索拉雅",
          "text": "好了，你快点回去吧，虽然你刚才把她的同伙打跑了，但是她既然一个人单独行动，那她的同伙肯定也没法把你的事马上告诉她。"
        },
        {
          "role": "索拉雅",
          "text": "对了，如果下次她再支使你去找什么，而且你真有发现的话，可以带来给我。我平时一般会待在望舒客栈里。"
        },
        {
          "role": "索拉雅",
          "text": "呼，虽然我能做的事也很有限…但是能保护一件文物是一件吧。"
        },
        {
          "type": "subtitle",
          "text": "与宝儿交谈"
        },
        {
          "role": "宝儿",
          "text": "05宝儿对话测试（给宝儿）"
        },
        {
          "type": "subtitle",
          "text": "与宝儿交谈"
        },
        {
          "role": "宝儿",
          "text": "怎么去了这么久，你有什么发现？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "找到了这个。",
              "dialogues": [
                {
                  "role": "宝儿",
                  "text": "哈…虽然看着品相不错，但和我要找的那个东西，差别还是有点大啊…"
                },
                {
                  "role": "宝儿",
                  "text": "不过，这个也是文物，就交给我保管吧。放心，我一定会让它充分发挥价值的。"
                }
              ]
            },
            {
              "text": "这个是你要找的东西吗？",
              "dialogues": [
                {
                  "role": "宝儿",
                  "text": "虽然品相不错，但这个不是我要找的东西。"
                },
                {
                  "role": "宝儿",
                  "text": "哦对了，你不知道怎么保存文物，说不定会损坏它。"
                },
                {
                  "role": "宝儿",
                  "text": "这个东西就由我来保管吧，我会让它充分发挥价值的。"
                }
              ]
            }
          ]
        },
        {
          "role": "宝儿",
          "text": "辛苦你了，这些东西是给你的，收下吧。"
        },
        {
          "role": "宝儿",
          "text": "唉，可是那个文物还流落在外，真让人担心…"
        }
      ]
    }
  ]
}