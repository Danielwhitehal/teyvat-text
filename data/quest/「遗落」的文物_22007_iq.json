{
  "quest_id": 22007,
  "chapter_num": null,
  "chapter_title": "「遗落」的文物",
  "type": "iq",
  "route": "The Lost Relic",
  "stories": [
    {
      "story_id": 22007,
      "title": "「遗落」的文物",
      "description": "宝儿自称弄丢了一件贵重的文物，正在焦急地搜索。看起来，她似乎很需要有人来帮忙…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与宝儿交谈"
        },
        {
          "role": "宝儿",
          "text": "到底掉哪去了…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "宝儿",
          "text": "哎呀，是这样…我在一处遗迹考察的时候，突然被怪物袭击…"
        },
        {
          "role": "宝儿",
          "text": "我慌里慌张地逃跑，结果，把刚刚挖出来的文物忘在了原地。"
        },
        {
          "role": "宝儿",
          "text": "那群怪物离开之后，我又折返回去，但是文物已经不见了…"
        },
        {
          "role": "宝儿",
          "text": "我在周围找了半天也没找到，不知道是不是被怪物拿走了…"
        },
        {
          "role": "宝儿",
          "text": "你能帮我去找找吗？如果找到文物的话，就用这个盒子装好吧。"
        },
        {
          "type": "subtitle",
          "text": "寻找宝儿丢失的东西"
        },
        {
          "role": "宝儿",
          "text": "到底掉哪去了…"
        },
        {
          "role": "旅行者",
          "text": "只用这个盒子…"
        },
        {
          "role": "宝儿",
          "text": "喂，你仔细看看啊，我可是用衣服在里面垫了好几层的。"
        },
        {
          "role": "宝儿",
          "text": "我可是专业的学者，怎么可能犯低级错误。"
        },
        {
          "role": "宝儿",
          "text": "好了，文物就拜托你了，我可拿那些怪物没办法…"
        },
        {
          "type": "subtitle",
          "text": "与派蒙交谈"
        },
        {
          "role": "派蒙",
          "text": "唔，能找的地方好像都找遍了…还是没找到呢。"
        },
        {
          "role": "派蒙",
          "text": "要接着找吗？还是回去再问问宝儿？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "再找找吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好吧，那我们再仔细找找。"
                }
              ]
            },
            {
              "text": "回去吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，回去再仔细问问吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "从魔物手里拿回宝儿的东西"
        },
        {
          "type": "subtitle",
          "text": "与宝儿交谈"
        },
        {
          "role": "宝儿",
          "text": "你找到文物了吗？"
        },
        {
          "role": "旅行者",
          "text": "找到了。"
        },
        {
          "role": "宝儿",
          "text": "我来看看，哇…居然真的是文物…"
        },
        {
          "role": "宝儿",
          "text": "咳，看起来…这个也不是我丢的文物，但是，也很有价值！"
        },
        {
          "role": "宝儿",
          "text": "这个文物就交给我这个专业人士来保管，你们就放心吧，嘿嘿…辛苦你们啦。"
        },
        {
          "type": "subtitle",
          "text": "寻找宝儿丢失的东西"
        }
      ]
    }
  ]
}