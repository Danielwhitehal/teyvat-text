{
  "quest_id": 41153,
  "chapter_num": null,
  "chapter_title": "望舒外送",
  "type": "eq",
  "route": "Wangshu Take-Away",
  "stories": [
    {
      "story_id": 41153,
      "title": "望舒外送",
      "description": "璃月的望舒客栈里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "言笑",
          "text": "你还是这么忙啊…那我想想找谁帮忙。"
        },
        {
          "role": "旅行者",
          "text": "好吧，我去这就去送。"
        },
        {
          "role": "言笑",
          "text": "那你快去吧。"
        },
        {
          "role": "寡言的廷方",
          "text": "差不多该到了吧。"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "言笑",
          "text": "廷方这人…这个客人，点了一份水煮黑背鲈。他人应该往轻策庄去了。"
        },
        {
          "role": "言笑",
          "text": "这份水煮黑背鲈，比较看重汤汁。不要乱飞乱爬，把汤搅了。麻烦一定要在早点送到。"
        },
        {
          "role": "言笑",
          "text": "如果路上不慎发生了意外，你回到找我，我再做一次。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "寡言的廷方",
          "text": "多谢。"
        },
        {
          "role": "寡言的廷方",
          "text": "言笑的手艺，还行。"
        }
      ]
    }
  ]
}