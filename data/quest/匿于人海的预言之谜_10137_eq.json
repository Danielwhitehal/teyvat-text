{
  "quest_id": 10137,
  "chapter_num": "风花节 其二",
  "chapter_title": "匿于人海的预言之谜",
  "type": "eq",
  "route": "A Riddle Amidst the Crowds",
  "stories": [
    {
      "story_id": 40098,
      "title": "匿于人海的预言之谜",
      "description": "尽管现有的线索寥寥无几，你和砂糖仍努力想要解开预言中的谜题…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至约定时间（两天后8-12点）"
        },
        {
          "role": "派蒙",
          "text": "到约定的日子了，我们去跟砂糖会合吧！"
        },
        {
          "type": "subtitle",
          "text": "与砂糖对话"
        },
        {
          "role": "派蒙",
          "text": "砂糖！我们来啦！"
        },
        {
          "role": "砂糖",
          "text": "旅行者，派蒙！我也才刚到不久，做了些整理工作。"
        },
        {
          "role": "砂糖",
          "text": "噢对，柯莱刚才路过这边，让我们记得去找她，她在旅店里收拾东西。"
        },
        {
          "role": "砂糖",
          "text": "听她说提纳里先生和赛诺先生都出门了，她想来帮我们，就没跟他们走。"
        },
        {
          "role": "旅行者",
          "text": "明白了。你这边进展如何？"
        },
        {
          "role": "砂糖",
          "text": "还可以，换过思路之后有了新方向。唔，请允许我简单说一下…"
        },
        {
          "role": "砂糖",
          "text": "我觉得，那则预言中所说的四个命题分别指向四个不同领域。也就是说，写下预言的人其实是想考验阅读者的智慧…"
        },
        {
          "role": "砂糖",
          "text": "但一个人很难同时具备所有智慧，所以我们应该勇敢大胆发问，去找懂行的人搜集意见。"
        },
        {
          "role": "砂糖",
          "text": "另外这则预言中有两项看起来需要我们找特定的「人」，说不定我们认识的人都可能成为预言的答案呢。"
        },
        {
          "role": "派蒙",
          "text": "也就是说，接下来需要开动脑筋，列举帮得上我们的人！"
        },
        {
          "role": "砂糖",
          "text": "是的，我们可以分类讨论，为四个命题拟定四组相关人选。"
        },
        {
          "role": "旅行者",
          "text": "有道理呢。"
        },
        {
          "role": "派蒙",
          "text": "那么先从第一组开始吧！第一个命题我记得是…「不存在的花」。"
        },
        {
          "role": "砂糖",
          "text": "我的话，还是会想到阿贝多先生。炼金术最可能与「不存在的花」有关，阿贝多先生是这方面的专家。"
        },
        {
          "role": "旅行者",
          "text": "砂糖你也是人选之一哦。"
        },
        {
          "role": "派蒙",
          "text": "对呀，砂糖可是研究过四倍大种子甜甜花的炼金术士，说不定那种不存在的花说的就是四倍大种子甜甜花！"
        },
        {
          "role": "砂糖",
          "text": "咦我也算？…嘿嘿…"
        },
        {
          "role": "派蒙",
          "text": "对了，提纳里也算吧？他是巡林官，精通植物学，如果要找什么花，问他应该是最快的了。"
        },
        {
          "role": "砂糖",
          "text": "嗯，那我把提纳里先生也列入名单。"
        },
        {
          "role": "砂糖",
          "text": "接下来是第二组。命题是，「绝不迷失的指路者」。"
        },
        {
          "role": "派蒙",
          "text": "呃，好抽象啊…是指那种不会走丢的人吗？"
        },
        {
          "role": "砂糖",
          "text": "还要能够为人指明方向，看起来没那么简单…"
        },
        {
          "role": "旅行者",
          "text": "占星术士？"
        },
        {
          "role": "派蒙",
          "text": "是说莫娜对吧？确实可以算！"
        },
        {
          "role": "砂糖",
          "text": "莫娜小姐的话…对，她看起来很自信，也能通过占卜为人指明方向。"
        },
        {
          "role": "派蒙",
          "text": "班尼特算不算？"
        },
        {
          "role": "旅行者",
          "text": "欸？为什么是他？"
        },
        {
          "role": "派蒙",
          "text": "你想啊，班尼特的运气特别差，也就是说我们只要跟他反着来，就能找到正确方向，对吧？"
        },
        {
          "role": "砂糖",
          "text": "唔唔…好像也不是没有道理…"
        },
        {
          "role": "派蒙",
          "text": "先记下来吧，反正找人花不了太长时间，少一个不如多一个。"
        },
        {
          "role": "砂糖",
          "text": "啊！我想到了，侦察骑士安柏小姐能算是符合这个命题的人选吗？"
        },
        {
          "role": "派蒙",
          "text": "噢，她方向感很好，很合适呀！这么说来，我和这家伙最早来蒙德路上就被她指引过方向呢。"
        },
        {
          "role": "砂糖",
          "text": "安柏小姐果然是一位称职的好向导。"
        },
        {
          "role": "派蒙",
          "text": "还有其他人选吗？"
        },
        {
          "role": "砂糖",
          "text": "让我想一想…啊，或许还有一位。"
        },
        {
          "role": "砂糖",
          "text": "阿贝多先生帮西风骑士团游击小队的米卡先生做过一整套装备。米卡先生是他们队的测绘员，很擅长找路。"
        },
        {
          "role": "砂糖",
          "text": "他还教过周围人测距法，我想，他应该不太迷路，也能为他人指明方向。"
        },
        {
          "role": "派蒙",
          "text": "嗯，那把他也列上吧。"
        },
        {
          "role": "砂糖",
          "text": "等等，马上就到我跟柯莱约定的时间了，但她还没出现。抱歉旅行者，派蒙，我们换个地方继续聊好吗？"
        },
        {
          "role": "派蒙",
          "text": "噢！你是要去看看柯莱的情况对不对？走吧，我们一起！"
        },
        {
          "type": "subtitle",
          "text": "与柯莱对话"
        },
        {
          "role": "砂糖",
          "text": "柯莱，抱歉我们提前过来了…你还好吗？"
        },
        {
          "role": "柯莱",
          "text": "啊！砂糖，我、我在准备东西…"
        },
        {
          "role": "柯莱",
          "text": "什么，已经到约定时间了？实在对不起，我…"
        },
        {
          "role": "旅行者",
          "text": "（柯莱似乎在包装一些小礼物似的东西，还紧张地藏起来了？难道是要送给谁吗？）"
        },
        {
          "role": "砂糖",
          "text": "别紧张，我们也才会合没多久，怕你不认识路，特地来接你的。"
        },
        {
          "role": "柯莱",
          "text": "嗯嗯，我这就加入你们！所以，砂糖提过的那件事进展还顺利吗？"
        },
        {
          "type": "subtitle",
          "text": "砂糖将四个命题与刚才讨论的结果告知柯莱…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "砂糖",
          "text": "讨论到一半，我们继续聊吧。"
        },
        {
          "role": "派蒙",
          "text": "接下来是第三个命题，「不撒谎的人」…唔，你们会想到谁？"
        },
        {
          "role": "旅行者",
          "text": "也许…迪卢克？"
        },
        {
          "role": "派蒙",
          "text": "呃…不一定吧，他那样的身份，很难完全不说谎才对。"
        },
        {
          "role": "旅行者",
          "text": "（对哦，迪卢克暗中担当着蒙德的暗夜英雄…被人问起也向来否认这一身份。没有说实话呢。）"
        },
        {
          "role": "柯莱",
          "text": "那…那凯亚先生呢？人缘很好的骑兵队长，不过…"
        },
        {
          "role": "派蒙",
          "text": "你也觉得不对吧？他那个样子，一看就很会撒谎啦！绝对不可能老老实实过日子的。"
        },
        {
          "role": "柯莱",
          "text": "无法反驳…"
        },
        {
          "role": "派蒙",
          "text": "卖唱的，啊我是说那个吟游诗人啦，也不符合标准，那家伙满嘴胡话。还有其他人吗？"
        },
        {
          "role": "砂糖",
          "text": "代理团长琴小姐是一位非常有威望的女性，但据我所知，她为了照顾身边的人，偶尔会在各种方面给大家打掩护…"
        },
        {
          "role": "砂糖",
          "text": "比如丽莎小姐泡在图书馆里错过了巡逻时间，琴小姐会说「丽莎身体抱恙」之类的话。"
        },
        {
          "role": "砂糖",
          "text": "她还会哄可莉小姐，说是有大怪物来抓晚上不乖乖睡觉的小朋友…这样是不是就不符合标准了？"
        },
        {
          "role": "派蒙",
          "text": "呃…确实算是撒了谎，可要为这种善意的谎言把她排除在外，总觉得…"
        },
        {
          "role": "旅行者",
          "text": "预言真严格啊…"
        },
        {
          "role": "派蒙",
          "text": "是我们太严格了吧！"
        },
        {
          "role": "砂糖",
          "text": "我觉得，教堂的罗莎莉亚小姐看上去不太撒谎。"
        },
        {
          "role": "砂糖",
          "text": "啊，柯莱应该不认识罗莎莉亚小姐对吧？是一位威风凛凛，看起来很不好接近的修女。"
        },
        {
          "role": "旅行者",
          "text": "为什么你会这样想？"
        },
        {
          "role": "砂糖",
          "text": "很久以前她路过炼金铺，找我打听过阿贝多先生的事。"
        },
        {
          "role": "砂糖",
          "text": "我记得当时我问她：是找阿贝多先生有事吗？她居然说，对阿贝多先生这样的聪明人感到好奇，才来询问身为助手的我。"
        },
        {
          "role": "砂糖",
          "text": "她当时的表情就像在说，并没有什么特别的理由，想问就问了…完全不掩饰目的。"
        },
        {
          "role": "砂糖",
          "text": "所以我想，她可能是一个不屑于撒谎的人。"
        },
        {
          "role": "派蒙",
          "text": "罗莎莉亚看起来很会打架，是个惹不起的狠角色。如果有什么需要撒谎的地方，她直接动手就行了吧？"
        },
        {
          "role": "砂糖",
          "text": "我也这么想！而且，听教堂的修女们提过，罗莎莉亚小姐翘唱诗班都是随时消失，借口都懒得找。"
        },
        {
          "role": "派蒙",
          "text": "好狠的人，把她写进名单吧！"
        },
        {
          "role": "柯莱",
          "text": "如果是这样，我觉得赛诺先生也可以算进人选！"
        },
        {
          "role": "派蒙",
          "text": "对哦，赛诺看起来根本懒得撒谎，和罗莎莉亚的情况有点像哦。"
        },
        {
          "role": "派蒙",
          "text": "我再提名一个人，雷泽！他根本就学不会撒谎，对吧？"
        },
        {
          "role": "砂糖",
          "text": "我也想到一位，见习骑士诺艾尔小姐！她是个非常真诚的人，看起来就不太会说谎话。"
        },
        {
          "role": "派蒙",
          "text": "记下来记下来！"
        },
        {
          "role": "砂糖",
          "text": "…等等，还有一位…常年位于炼金台旁的…"
        },
        {
          "role": "派蒙",
          "text": "欸？你是指…蒂玛乌斯？"
        },
        {
          "role": "砂糖",
          "text": "嗯，他…呃，其实…其实蒂玛乌斯最近沉浸在恋爱中。"
        },
        {
          "role": "砂糖",
          "text": "他还发过誓，在追到心爱的女孩之前绝不说虚伪的话，绝不偷懒什么的…"
        },
        {
          "role": "派蒙",
          "text": "蒂玛乌斯有喜欢的人了？！"
        },
        {
          "role": "砂糖",
          "text": "没错。"
        },
        {
          "role": "派蒙",
          "text": "他喜欢的人是谁啊？你认识吗？"
        },
        {
          "role": "砂糖",
          "text": "我也还没见过呢，只知道是一位璃月女孩…蒂玛乌斯说，对方说话很有趣，气质动人，长相也非常迷人。"
        },
        {
          "role": "旅行者",
          "text": "说的全是好话，等于没说…"
        },
        {
          "role": "砂糖",
          "text": "说到这个，帮助蒂玛乌斯追到心爱的女孩也是我今年风花节的目标之一！"
        },
        {
          "role": "柯莱",
          "text": "可是，这种事要怎么帮呢？"
        },
        {
          "role": "砂糖",
          "text": "帮他一起想给女孩子写信用什么样的信纸信封、送什么样的礼物、怎么包装…之类的。"
        },
        {
          "role": "柯莱",
          "text": "我懂我懂，这个我在道成林也干过！之前帮一位女性巡林员给心仪的同事递过情书…"
        },
        {
          "role": "砂糖",
          "text": "是的，就是这样！啊还有，我把他负责的一些课题相关的杂事做掉了。作为感谢，他还送了我一个新做的制冷装置呢。"
        },
        {
          "role": "派蒙",
          "text": "好用吗？"
        },
        {
          "role": "砂糖",
          "text": "呃…很有观赏性。"
        },
        {
          "role": "柯莱",
          "text": "那不就是白做了嘛。"
        },
        {
          "role": "派蒙",
          "text": "哼，好吧，这家伙完全沉浸在爱情里，我们就相信他说的话，把他也写上好了。"
        },
        {
          "role": "砂糖",
          "text": "那么，最后是「永不完结的传说」。听到这个命题，你们会想到谁呢？"
        },
        {
          "role": "派蒙",
          "text": "丽莎？图书管理员嘛是最了解书本的人，传说什么的，应该都是用书的形式记录下来的吧？"
        },
        {
          "role": "旅行者",
          "text": "不一定，但有道理。"
        },
        {
          "role": "砂糖",
          "text": "说起「传说」，我会联想到儿童读物、绘本之类的。"
        },
        {
          "role": "派蒙",
          "text": "柯莱怎么样？听说她刚开始跟着提纳里学习的时候看过很多儿童读物。"
        },
        {
          "role": "柯莱",
          "text": "原来我也可以算吗？"
        },
        {
          "role": "砂糖",
          "text": "当然可以啦，我记下来。"
        },
        {
          "role": "旅行者",
          "text": "这个命题适合砂糖吗？"
        },
        {
          "role": "砂糖",
          "text": "我的话，比较喜欢看《炼金物质图谱分析与妙用》、《神奇的合成原理》还有《生命推论》之类的书…"
        },
        {
          "role": "派蒙",
          "text": "好吧…连标题都不太能听懂…"
        },
        {
          "role": "砂糖",
          "text": "唔…可莉小姐或许也可以哦。她的母亲艾莉丝女士是著名的游记作者，我猜她一定也接触过不少传说、传奇类故事。"
        },
        {
          "role": "派蒙",
          "text": "好，那把小可莉也加上！"
        },
        {
          "role": "砂糖",
          "text": "嗯，这样就差不多了。接下来，最好去找这张名单上的人打听有关预言的事。"
        },
        {
          "role": "柯莱",
          "text": "全部都要找一遍吗？人数有点多呢。"
        },
        {
          "role": "砂糖",
          "text": "是啊，我在想，我们要不要试试看分头行动？能有效提高效率。"
        },
        {
          "role": "派蒙",
          "text": "好啊好啊！"
        },
        {
          "role": "砂糖",
          "text": "我还想了一个搜集反馈的办法…"
        },
        {
          "type": "subtitle",
          "text": "砂糖将刚才想到的办法告诉大家…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "没问题，就这么办。"
        },
        {
          "role": "砂糖",
          "text": "旅行者和派蒙是老搭档了，你们一起吧，我和柯莱一组。"
        },
        {
          "role": "派蒙",
          "text": "那你们这边就交给厉害的柯莱和超可靠的砂糖喽！"
        },
        {
          "role": "柯莱",
          "text": "…好，我一定会帮上忙的！我是厉害的柯莱，嗯！"
        },
        {
          "role": "派蒙",
          "text": "嗯，无敌的派蒙和旅行者也马上出发！"
        },
        {
          "type": "subtitle",
          "text": "前往图书馆，寻找丽莎"
        },
        {
          "role": "砂糖",
          "text": "我打算先找据点最稳定的人，第一站就去图书馆吧，丽莎小姐应该会在的。"
        },
        {
          "role": "柯莱",
          "text": "据点…用词好有趣…"
        },
        {
          "role": "砂糖",
          "text": "那…「窝点」？也不太对…"
        },
        {
          "role": "柯莱",
          "text": "或者…「老巢」？"
        },
        {
          "type": "subtitle",
          "text": "寻找丽莎"
        },
        {
          "role": "砂糖",
          "text": "到丽莎小姐的老巢了！"
        },
        {
          "role": "柯莱",
          "text": "（总觉得我错误的用词把砂糖带跑了…怎么办…）"
        },
        {
          "role": "砂糖",
          "text": "丽莎小姐，请问…咦？"
        },
        {
          "role": "阿贝多",
          "text": "砂糖，柯莱？你们怎么来了。"
        },
        {
          "role": "赛诺",
          "text": "柯莱，「可」算「来」了。"
        },
        {
          "role": "提纳里",
          "text": "算我求求你，不要再说谐音梗冷笑话了，你很想用这种方式在异国他乡出名吗？"
        },
        {
          "role": "柯莱",
          "text": "咦？丽莎小姐不在吗？"
        },
        {
          "role": "阿贝多",
          "text": "很震惊吧？她出门了。这里只有正在查资料的我们。"
        },
        {
          "role": "赛诺",
          "text": "除了我。我没在查，只是找师姐扑空了。"
        },
        {
          "role": "砂糖",
          "text": "原来丽莎小姐是…赛诺先生的师姐？"
        },
        {
          "role": "赛诺",
          "text": "嗯，她在须弥的导师也是我的恩师，我们都算素论派学生。"
        },
        {
          "role": "砂糖",
          "text": "原来如此…不对不对，我们是有事要打听才过来的！各位，我和柯莱在研究一则预言，希望你们能帮忙给些意见。"
        },
        {
          "role": "阿贝多",
          "text": "什么样的预言？"
        },
        {
          "type": "subtitle",
          "text": "砂糖和柯莱你一言我一语，将有关预言和先前与旅行者一起整理信息的事告知在场众人…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "赛诺",
          "text": "原来如此…找他们俩是为了「不存在的花」，找我是为了「不撒谎的人」。"
        },
        {
          "role": "柯莱",
          "text": "啊啊不用急着给出答案的！我们只是来知会大家这件事，相关内容可以慢慢想，有任何线索欢迎写信到砂糖信箱。"
        },
        {
          "role": "赛诺",
          "text": "砂糖信箱？"
        },
        {
          "role": "砂糖",
          "text": "嗯，来的路上我想过了，这些问题看起来不着边际，却很可能涉及到很多值得探讨的细节…三言两语恐怕说不清。"
        },
        {
          "role": "砂糖",
          "text": "所以，我打算在炼金台旁立一个信箱，方便大家把想说的话写下来给到我们。"
        },
        {
          "role": "砂糖",
          "text": "不过也不用叫砂糖信箱啦。我认为可以叫砂糖和柯莱的信箱，或者砂糖和柯莱和旅行者以及派蒙的信箱…"
        },
        {
          "role": "柯莱",
          "text": "啊哈哈，也不必在这种地方使用枚举法…"
        },
        {
          "role": "提纳里",
          "text": "是个好办法，比口头交流可靠得多。"
        },
        {
          "role": "赛诺",
          "text": "的确，说到撒不撒谎，这种事平时不可能挂在嘴边说吧。"
        },
        {
          "role": "阿贝多",
          "text": "明白了，那等我们准备完毕，就把信投到你们的信箱里。"
        },
        {
          "role": "柯莱",
          "text": "嗯，麻烦你们了。那我们先把这几位勾掉，接着去找其他人…"
        },
        {
          "role": "砂糖",
          "text": "嗯嗯，我记下来了。"
        },
        {
          "role": "提纳里",
          "text": "她们俩都很内向，没想到能相处得这么好。"
        },
        {
          "role": "赛诺",
          "text": "你觉不觉得，柯莱回到蒙德就变得很爱吐槽别人？"
        },
        {
          "role": "提纳里",
          "text": "确实有点。"
        },
        {
          "role": "阿贝多",
          "text": "出门走走，见见以前的朋友，对身心很有好处。"
        },
        {
          "role": "阿贝多",
          "text": "从以前走过的路上找回年轻的感觉，很有意义不是吗？"
        },
        {
          "role": "赛诺",
          "text": "…我第一次遇到柯莱的时候，她可不知道幸福、年轻是什么意思。"
        },
        {
          "role": "赛诺",
          "text": "现在不一样了。魔鳞病能痊愈，对她来说至关重要。"
        },
        {
          "role": "提纳里",
          "text": "柯莱是个很敏感的孩子，而且内向。阿贝多应该看得出来。"
        },
        {
          "role": "提纳里",
          "text": "我照顾她的这阵子，据我观察，她本性很活泼，只是…经历了很多事，才变成这样。"
        },
        {
          "role": "阿贝多",
          "text": "来蒙德找植物找画家什么的，都是借口吧？"
        },
        {
          "role": "赛诺",
          "text": "也不能这么说，柯莱和七圣召唤都很重要。"
        },
        {
          "role": "提纳里",
          "text": "这种时候你回答「是」不行吗？"
        },
        {
          "role": "赛诺",
          "text": "好吧，是的。我们确实担心柯莱，她偷偷来过几次蒙德，心情却没有明显起色。"
        },
        {
          "role": "阿贝多",
          "text": "不妨多给她些时间。我觉得，她或许能在砂糖的帮助下解开心结。"
        },
        {
          "role": "提纳里",
          "text": "这是你身为砂糖指导者的自信吧。"
        },
        {
          "role": "阿贝多",
          "text": "可以这么说。提到这个，据说你们须弥学者会因为学术关系构筑起特殊的社会关系？"
        },
        {
          "role": "提纳里",
          "text": "以你们的观点来看或许是的。须弥情况比较特殊，之所以被称为学城，也是因为须弥的一切资源都很容易跟学术挂钩。"
        },
        {
          "role": "提纳里",
          "text": "在须弥，学术资源等同于社会资源，甚至就连为了做学问构建家庭关系也不是什么新鲜事。"
        },
        {
          "role": "提纳里",
          "text": "不过我们三个不是那种以学术为基础构建起的社会关系就是了，首先，我们就不会一起写论文。"
        },
        {
          "role": "阿贝多",
          "text": "哦？原来论文才是学术家庭的核心。"
        },
        {
          "role": "赛诺",
          "text": "我们几个的关系，比较像兄妹吧？纯净无污染，没有任何学术力量介入的兄妹关系。"
        },
        {
          "role": "提纳里",
          "text": "我不太想承认，但这话也没错就是了。"
        },
        {
          "role": "阿贝多",
          "text": "能理解，我也有个妹妹。兄长保护妹妹是理所当然的事。"
        },
        {
          "role": "阿贝多",
          "text": "你们说的都符合我对学者之城的想象。家庭本就是社会关系的交汇点，为了共同目的构建出的家庭，说不定还更牢靠些。"
        },
        {
          "role": "阿贝多",
          "text": "话说回来，你们二位谁比较年长？"
        },
        {
          "role": "提纳里",
          "text": "还是不聊这个了吧。"
        },
        {
          "role": "赛诺",
          "text": "从年龄上说，当然我是大哥了。他不愿意承认而已。"
        },
        {
          "role": "提纳里",
          "text": "你的心态更年轻，做小弟也合适。或者我们可以推选柯莱做家里的大姐。"
        },
        {
          "role": "赛诺",
          "text": "不行…我愿意承认自己是弟弟的瞬间，只有打牌抽到后手时！"
        },
        {
          "type": "subtitle",
          "text": "寻找符合预言的人选"
        },
        {
          "type": "subtitle",
          "text": "告别砂糖与柯莱之后…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "另一边就交给她俩了，希望她们一切顺利！我想想…我们要先去哪里呢？"
        },
        {
          "role": "派蒙",
          "text": "啊，要不去公告板附近碰碰运气吧？"
        },
        {
          "role": "派蒙",
          "text": "白天应该有人会在那出没，说不定能遇到要找的人哦！"
        },
        {
          "type": "subtitle",
          "text": "前往蒙德公告板附近"
        },
        {
          "role": "派蒙",
          "text": "有了有了！哇，好几个人都在！"
        },
        {
          "role": "派蒙",
          "text": "咦？甚至还有丽莎小姐？"
        },
        {
          "role": "旅行者",
          "text": "各位，好久不见。"
        },
        {
          "role": "班尼特",
          "text": "噢！旅行者和派蒙！好久不见啦，最近好吗？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们还不错哦！"
        },
        {
          "role": "丽莎",
          "text": "小可爱们这么惊讶，是因为我吗？"
        },
        {
          "role": "雷泽",
          "text": "师父…不在老地方。"
        },
        {
          "role": "丽莎",
          "text": "我又不是长在椅子上了，偶尔也要出来走走的嘛。"
        },
        {
          "role": "丽莎",
          "text": "今天正好米卡过来，我带他认识一下班尼特和雷泽。他们都常在野外跑，互相也好有个关照。"
        },
        {
          "role": "米卡",
          "text": "你们好，我是米卡。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "之前见过了，你好。",
              "dialogues": []
            },
            {
              "text": "初次见面，你好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "米卡",
          "text": "请、请多关照…"
        },
        {
          "role": "班尼特",
          "text": "不用这么拘谨啦，他们是我们的老朋友了，人很好的。"
        },
        {
          "role": "雷泽",
          "text": "风花节，好玩？"
        },
        {
          "role": "派蒙",
          "text": "还没怎么玩呢，我们在帮忙调查一则预言。"
        },
        {
          "role": "班尼特",
          "text": "预言？什么预言？"
        },
        {
          "role": "米卡",
          "text": "好的坏的？"
        },
        {
          "type": "subtitle",
          "text": "将有关预言和先前跟砂糖柯莱一起整理信息的事告知在场众人…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "丽莎",
          "text": "哎呀，听上去很有意思呢。"
        },
        {
          "role": "班尼特",
          "text": "你们的名单上甚至有我…我真能帮上忙吗？"
        },
        {
          "role": "雷泽",
          "text": "相信自己！"
        },
        {
          "role": "米卡",
          "text": "对对，相信自己！班尼特是很厉害的冒险家。"
        },
        {
          "role": "班尼特",
          "text": "好，那我要大胆提出我的观点！可是，可是我不太擅长组织语言…呃…"
        },
        {
          "role": "派蒙",
          "text": "不用现在就想完的，砂糖说过她会在蒙德炼金台旁边做个信箱，你们方便的时候把想法写下来投到那里面就好啦。"
        },
        {
          "role": "丽莎",
          "text": "很周全高效的想法，不愧是砂糖。"
        },
        {
          "role": "雷泽",
          "text": "我会想，等我。"
        },
        {
          "role": "班尼特",
          "text": "你们还要通知其他人对吧？那你们先忙吧，不用在意我们这边！我们准备完就会去给你们投信的。"
        },
        {
          "role": "派蒙",
          "text": "嗯，那我们先走一步！"
        },
        {
          "role": "派蒙",
          "text": "下一站就去摘星崖那边看看吧！说不好会有人在。"
        },
        {
          "role": "派蒙",
          "text": "就算运气不好没遇上…高处视野好，再找起人来也更方便。"
        },
        {
          "role": "丽莎",
          "text": "小可爱们辛苦了，别太劳累哦。累了可以到姐姐这里来坐一坐，喝杯茶。"
        },
        {
          "type": "subtitle",
          "text": "前往望风山地"
        },
        {
          "type": "subtitle",
          "text": "此时，砂糖和柯莱来到了望风山地…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "柯莱",
          "text": "下一站，我看看我的笔记…往这个方向。"
        },
        {
          "role": "砂糖",
          "text": "明白了，请跟我走！"
        },
        {
          "type": "subtitle",
          "text": "寻找符合预言的人选"
        },
        {
          "role": "砂糖",
          "text": "太好了，那边有人在。"
        },
        {
          "role": "柯莱",
          "text": "安柏？！优菈也在，哇…"
        },
        {
          "role": "可莉",
          "text": "咦？砂糖姐姐！还有那个披着长围巾的姐姐！"
        },
        {
          "role": "安柏",
          "text": "柯莱，我们刚巧说到你！噢对，这位你可能不认识，我来介绍一下，诺艾尔，西风骑士团的女仆小姐。"
        },
        {
          "role": "诺艾尔",
          "text": "柯莱小姐你好，前几次你来蒙德的时候我们都没能见面，很高兴在这里遇到你。"
        },
        {
          "role": "柯莱",
          "text": "啊你、你好！我是柯莱…"
        },
        {
          "role": "优菈",
          "text": "不要那么隆重，随便一点啦，现在又不是外交时间。"
        },
        {
          "role": "砂糖",
          "text": "可莉小姐怎么在这里？是准备去炸鱼吗？"
        },
        {
          "role": "可莉",
          "text": "不是哦，可莉在跟骑士们一起巡逻！"
        },
        {
          "role": "砂糖",
          "text": "这么一说，在这里的除了我和柯莱全是女性骑士呢…"
        },
        {
          "role": "柯莱",
          "text": "以前听说过，但亲眼看到这么年轻的骑士还是很震惊…"
        },
        {
          "role": "可莉",
          "text": "柯莱姐姐是做什么的呢？"
        },
        {
          "role": "柯莱",
          "text": "我在道成林当见习巡林员。"
        },
        {
          "role": "可莉",
          "text": "见习…？"
        },
        {
          "role": "柯莱",
          "text": "就是还没有成为正式巡林官，仍在准备的意思。"
        },
        {
          "role": "诺艾尔",
          "text": "和我一样呢，我也在为成为西风骑士而努力。"
        },
        {
          "role": "优菈",
          "text": "说是这么说，但我们的巡逻没那么正式。更像是在闲聊。"
        },
        {
          "role": "柯莱",
          "text": "（呃…我不能紧张，必须马上找个话题融入大家！不要紧张…不要紧张柯莱…不要因为遇到安柏她们就乱了阵脚…）"
        },
        {
          "role": "砂糖",
          "text": "我来猜猜看，是不是在聊最近的客人？"
        },
        {
          "role": "安柏",
          "text": "是啊，最近城里来了好几位须弥的客人，大家都在偷偷商量布置一些惊喜呢。"
        },
        {
          "role": "优菈",
          "text": "安柏！"
        },
        {
          "role": "安柏",
          "text": "啊！对不起我…我…"
        },
        {
          "role": "安柏",
          "text": "欸嘿嘿，还好没有说具体是什么惊喜。"
        },
        {
          "role": "柯莱",
          "text": "（不行啊，这里要接什么话？我想不出…）"
        },
        {
          "role": "砂糖",
          "text": "实不相瞒，我们也遇到一件有些惊喜的事情哦。"
        },
        {
          "role": "可莉",
          "text": "什么样的惊喜？可莉要听！"
        },
        {
          "role": "柯莱",
          "text": "（砂糖帮我开了个好头，太好了，就这么顺着说…）"
        },
        {
          "type": "subtitle",
          "text": "砂糖和柯莱以「惊喜」为切入点，将有关预言和先前与旅行者一起整理信息的事告知在场众人…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "诺艾尔",
          "text": "好有趣的预言…我完全猜不到答案呢。"
        },
        {
          "role": "优菈",
          "text": "明白了，是需要人帮你们打听消息对吧？我也尽力。"
        },
        {
          "role": "柯莱",
          "text": "谢谢你，优菈小姐。"
        },
        {
          "role": "优菈",
          "text": "朋友之间别客气。"
        },
        {
          "role": "砂糖",
          "text": "不用着急想回复，我们会在炼金台边准备一只信箱，大家有线索的话随时写信给我们就好。"
        },
        {
          "role": "可莉",
          "text": "可莉会写的！"
        },
        {
          "role": "优菈",
          "text": "有意思，大家都写吧，想到什么就寄过去。"
        },
        {
          "role": "安柏",
          "text": "放心交给我们吧！不过在那之前，我们得先把巡逻的路线走完。"
        },
        {
          "role": "砂糖",
          "text": "是从哪里到哪里呢？"
        },
        {
          "role": "安柏",
          "text": "今天要从望风山地走到蒙德城门哦。要不是你们还有事在身，我也想请你们加入。"
        },
        {
          "role": "砂糖",
          "text": "……"
        },
        {
          "role": "砂糖",
          "text": "没关系，反正以后还要巡逻，我们可以忙完预言的事再来加入你们。"
        },
        {
          "role": "柯莱",
          "text": "啊对，那…那我们就先回去了！"
        },
        {
          "role": "诺艾尔",
          "text": "再见，路上小心！"
        },
        {
          "role": "砂糖",
          "text": "你还好吗柯莱？"
        },
        {
          "role": "柯莱",
          "text": "呃…很明显？"
        },
        {
          "role": "砂糖",
          "text": "没有那么明显，只是能看出来你有心事。"
        },
        {
          "role": "柯莱",
          "text": "那就已经很明显了…唉。"
        },
        {
          "role": "砂糖",
          "text": "有烦恼可以说给我听，我愿意帮忙。"
        },
        {
          "role": "柯莱",
          "text": "…砂糖…"
        },
        {
          "role": "柯莱",
          "text": "我…我其实，有些不知道怎么跟安柏她们相处。"
        },
        {
          "role": "砂糖",
          "text": "可你们是很好的朋友吧？"
        },
        {
          "role": "柯莱",
          "text": "嗯，我非常重视安柏这个朋友…"
        },
        {
          "role": "柯莱",
          "text": "…我也不知道。仔细想想，一切或许都是我自己的问题。"
        },
        {
          "role": "柯莱",
          "text": "以前在蒙德时我非常不成熟，警戒心又重，对谁都不好…安柏几乎是追在我背后跟我做朋友。"
        },
        {
          "role": "柯莱",
          "text": "如果没有她，我可能没法像今天这样站在这里。正因如此，我才特别仰慕她，想模仿她，成为她这样的人。"
        },
        {
          "role": "柯莱",
          "text": "…可是这些年过去，我明白了一个道理…我不可能成为安柏。"
        },
        {
          "role": "柯莱",
          "text": "倒不如说，我有那种想法才可笑。我和她从头到脚就没有什么一样的地方。我性格又…不太好，容易紧张，容易多想…"
        },
        {
          "role": "砂糖",
          "text": "柯莱…别这么说。"
        },
        {
          "role": "柯莱",
          "text": "……"
        },
        {
          "role": "柯莱",
          "text": "砂糖，你…愿不愿意听听我以前的事？"
        },
        {
          "type": "subtitle",
          "text": "两个女孩放慢脚步，缓缓走到一处风景好些的地方坐下。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "借着微风，柯莱将自己的过去娓娓道来…从童年一直说到魔鳞病痊愈。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "砂糖",
          "text": "……"
        },
        {
          "role": "砂糖",
          "text": "（虽然我已经听说过她大概的情况，但…为什么她要遇到这种事呢？）"
        },
        {
          "role": "柯莱",
          "text": "对不起，才认识没多久就忍不住跟你说这些…我也讨厌自己的性格，动不动就陷入矛盾纠结，总是找地方倒苦水…"
        },
        {
          "role": "砂糖",
          "text": "不不不，没关系的！我，我真的很高兴你愿意跟我说这些。"
        },
        {
          "role": "砂糖",
          "text": "你知道吗？对我来说，能听到别人说心里话反而是一种认可。"
        },
        {
          "role": "砂糖",
          "text": "因为我…呃…你应该已经发现了，我的聊天水平不太高，又总是困在自己感兴趣的话题里说个不停…"
        },
        {
          "role": "砂糖",
          "text": "但前两天我跟你说炼金术的事，你也没有嫌弃。现在你跟我说这些，反倒让我平衡了不少。"
        },
        {
          "role": "砂糖",
          "text": "听你说刚才那些话之前，我根本想不到你有这么多烦恼。说到底，我们是一样的人啊。"
        },
        {
          "role": "柯莱",
          "text": "…真的吗？"
        },
        {
          "role": "砂糖",
          "text": "真的！每个人都有自己的问题，我觉得我很有发言权！"
        },
        {
          "role": "砂糖",
          "text": "你说的那些感觉，我能明白。内向的人想融入人群，本来就要花比别人多几倍的力气。"
        },
        {
          "role": "砂糖",
          "text": "开口前在肚子里打草稿，生怕说错一句话导致冷场什么的…我完全理解！另外，跟着天才学习也不是一件容易事…"
        },
        {
          "role": "砂糖",
          "text": "认识你之前，我真的从来没有遇到过跟我这么像的人。"
        },
        {
          "role": "柯莱",
          "text": "……"
        },
        {
          "role": "砂糖",
          "text": "我…不太会安慰人，也不会劝你非要想开什么。就这样坐一会儿吧，不用想话题，我们一起坐一会儿。"
        },
        {
          "role": "柯莱",
          "text": "（砂糖真的不说话了。但不知为什么，我不觉得拘谨。或许就像她说的，我们很相似。）"
        },
        {
          "role": "柯莱",
          "text": "（在须弥的时候，我也经常找个地方看风景。我总是独自做这件事，没想到今天身边居然多了一个伙伴…）"
        },
        {
          "role": "柯莱",
          "text": "（…蒙德的风，好柔软啊。）"
        },
        {
          "role": "砂糖",
          "text": "你看那边的云，是不是有点像我的试管？"
        },
        {
          "role": "柯莱",
          "text": "…呃…我…我不觉得…对不起…"
        },
        {
          "role": "砂糖",
          "text": "好吧，那我们可能还有一点点距离…至少在视野上。"
        },
        {
          "role": "柯莱",
          "text": "……"
        },
        {
          "role": "柯莱",
          "text": "…谢谢你砂糖，说出来好受多了。"
        },
        {
          "role": "砂糖",
          "text": "对吧？我也会对着烧瓶说话的。下次有机会一定要给你看我的四倍大种子甜甜花和四倍大种子风之花。"
        },
        {
          "role": "柯莱",
          "text": "四倍什么？？"
        },
        {
          "role": "砂糖",
          "text": "是我很厉害的作品。我觉得是你的话，或许可以欣赏哦。"
        },
        {
          "role": "柯莱",
          "text": "哦、哦！好的，请务必给我看看！"
        },
        {
          "role": "砂糖",
          "text": "有饼干哦，尝一块吗？有奶酪味和番茄味。"
        },
        {
          "role": "柯莱",
          "text": "好啊，唔…我要这个奶酪味的！"
        },
        {
          "role": "安柏",
          "text": "…嗯，嗯！她们在看风景呢！"
        },
        {
          "role": "可莉",
          "text": "要过去陪她们玩吗？"
        },
        {
          "role": "优菈",
          "text": "不用。让她们俩坐一会儿吧。"
        },
        {
          "role": "安柏",
          "text": "柯莱现在最需要的不是我们，而是一个过去完全不认识她的，「崭新」的朋友。"
        },
        {
          "role": "可莉",
          "text": "不明白…不一样吗？"
        },
        {
          "role": "安柏",
          "text": "不一样哦，可莉再长大一点就会明白啦。人必须从不同的朋友身上汲取不同力量，对现在的柯莱而言，只有我是不够的。"
        },
        {
          "type": "subtitle",
          "text": "前往摘星崖附近"
        },
        {
          "type": "subtitle",
          "text": "另外一边，寒风呼啸的摘星崖之上…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "到摘星崖啦，这里会有我们要找的人吗？"
        },
        {
          "role": "？？？",
          "text": "救命——！千万不要放手求求你了！"
        },
        {
          "role": "？？？",
          "text": "…啧。"
        },
        {
          "role": "派蒙",
          "text": "好大的动静，快过去看看！"
        },
        {
          "role": "派蒙",
          "text": "蒂玛乌斯？！还有罗莎莉亚和莫娜？这是什么组合…"
        },
        {
          "role": "莫娜",
          "text": "我也想问，这是什么组合？"
        },
        {
          "role": "罗莎莉亚",
          "text": "好久不见。"
        },
        {
          "role": "旅行者",
          "text": "各位好。风花节快乐。"
        },
        {
          "role": "莫娜",
          "text": "看你们气色，最近过得还不错对吧？"
        },
        {
          "role": "派蒙",
          "text": "对，怎么说都比趴在地上这位过得好多了…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "请不要说这种话，我也是在为生活奋斗啊！"
        },
        {
          "role": "莫娜",
          "text": "还敢说，要不是这位修女小姐出手，你说不定已经受重伤甚至死了！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "我明白，我明白…实在太感谢了，我不知该怎么报答您。"
        },
        {
          "role": "罗莎莉亚",
          "text": "不用客气，举手之劳。"
        },
        {
          "role": "莫娜",
          "text": "确实是举手之劳，举手将蒂玛乌斯从坠落的危险中拉了回来…"
        },
        {
          "role": "派蒙",
          "text": "发生什么了？蒂玛乌斯差点坠崖？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "其实…我今天是来摘星崖采花的，路上遇到莫娜小姐，她看了看星盘，劝我最好不要上山，容易遇到危险。"
        },
        {
          "role": "派蒙",
          "text": "可你还是上来了…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "…是的，我有不得不去做的事！"
        },
        {
          "role": "莫娜",
          "text": "唉，就为了给心上人送花，命都不要了？"
        },
        {
          "role": "罗莎莉亚",
          "text": "确实不太会在这地方遇到寻死的人。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "才不是寻死，我、我也没想到会成真啊…莫娜小姐说「容易遇到危险」，我想着小心些就没事了…实在抱歉，我知错了。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "听我说，风花节属于渴望爱情的蒙德人，我是来追逐爱的！"
        },
        {
          "role": "派蒙",
          "text": "好吧，那罗莎莉亚为什么会在这里？"
        },
        {
          "role": "罗莎莉亚",
          "text": "找个人少的地方躲清静，没想到随手救了个人。"
        },
        {
          "role": "莫娜",
          "text": "难怪水占盘显示的结果不是百分百危险。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "啊哈哈…对了，旅行者和派蒙来摘星崖有什么事吗？"
        },
        {
          "role": "派蒙",
          "text": "是来碰运气的哦！今天要找很多人，我们到处跑呢。对了，刚好也要找你们几位。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "欸？"
        },
        {
          "type": "subtitle",
          "text": "将有关预言和先前跟砂糖柯莱一起整理信息、准备信箱的事告知在场众人…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "罗莎莉亚",
          "text": "原来是这样。那我们准备好线索，投到信箱里就可以了？"
        },
        {
          "role": "蒂玛乌斯",
          "text": "居然还有这种预言…更没想到我也有幸被列入参考对象！"
        },
        {
          "role": "蒂玛乌斯",
          "text": "不过，我谈恋爱的事大家都知道了啊…嘿嘿…"
        },
        {
          "role": "蒂玛乌斯",
          "text": "我之所以出现在这里，是为了给我心仪的女子送去最适合她的塞西莉亚花。她…"
        },
        {
          "role": "莫娜",
          "text": "打住！我们谁都没问，请你不要自说自话进入女朋友的话题。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "噢…被看出来了…"
        },
        {
          "role": "莫娜",
          "text": "既然你们需要线索，身为天才占星术士，我当然会写信过去啦。等我的亲笔信吧。"
        },
        {
          "role": "罗莎莉亚",
          "text": "去忙吧，不耽搁你们时间了。"
        },
        {
          "role": "派蒙",
          "text": "那我们先回去跟大家会合啦！"
        },
        {
          "role": "旅行者",
          "text": "再见，蒂玛乌斯请注意安全。"
        },
        {
          "role": "蒂玛乌斯",
          "text": "好的！哎呀，真是不好意思…谢谢啦！"
        },
        {
          "type": "subtitle",
          "text": "前往炼金台附近"
        },
        {
          "role": "派蒙",
          "text": "我们回来啦！不过，还是你们俩动作更快。"
        },
        {
          "role": "柯莱",
          "text": "辛苦了，还顺利吗？"
        },
        {
          "role": "派蒙",
          "text": "话都带到了，没问题的。"
        },
        {
          "role": "砂糖",
          "text": "我们早到一点，刚才一起把信箱做完了。"
        },
        {
          "role": "砂糖",
          "text": "今天运气真好，材料都是附近的店家白送给我们的！就是委屈柯莱手指被木刺扎到…"
        },
        {
          "role": "柯莱",
          "text": "没事没事，我老在雨林活动，木刺什么的都是小问题，已经处理过了。"
        },
        {
          "role": "砂糖",
          "text": "今天日程上的事都做完了，接下来只要等大家把信寄过来就好。"
        },
        {
          "role": "砂糖",
          "text": "旅行者和派蒙好好休息一下吧，我会负责查收信箱的。"
        },
        {
          "role": "派蒙",
          "text": "砂糖真可靠，就像阿贝多一样！有你们在的地方，我们都会比较轻松。"
        },
        {
          "role": "砂糖",
          "text": "别这样，我都不好意思了…"
        },
        {
          "role": "派蒙",
          "text": "不过我现在饿得不行了…喂，是不是该请我吃饭了？"
        },
        {
          "role": "旅行者",
          "text": "好吧，那我们先告辞了。"
        },
        {
          "role": "柯莱",
          "text": "我陪砂糖把多余的材料送还给店家，你们快去吃点东西，别饿坏了。"
        },
        {
          "role": "砂糖",
          "text": "现在解散也没问题。等一切准备妥当，我们再在这里碰面，汇总信息。"
        },
        {
          "role": "派蒙",
          "text": "好！"
        },
        {
          "type": "subtitle",
          "text": "前往猎鹿人餐馆"
        },
        {
          "role": "派蒙",
          "text": "我要这个，这个还有这个…"
        },
        {
          "role": "旅行者",
          "text": "派蒙在使劲花我的摩拉呢…"
        },
        {
          "role": "派蒙",
          "text": "真的很饿嘛！而且你也要吃的，又不是我吃独食。"
        },
        {
          "type": "subtitle",
          "text": "这时才发现，肚子确实有些饿了…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "跟派蒙一起狠狠饱餐了一顿。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "呼啊——！好饱好饱…"
        },
        {
          "role": "旅行者",
          "text": "（吃饱了坐在路边看看风景，感觉也不错。）"
        },
        {
          "role": "贝雅特丽奇",
          "text": "东西都准备好了吧？我们下午五点碰面去我家怎么样？"
        },
        {
          "role": "昆恩",
          "text": "当然，我带了酒和熏制火腿，你父母会喜欢的。"
        },
        {
          "role": "贝雅特丽奇",
          "text": "我说…我们认识这么久，你也该记住我家不吃火腿只吃培根了吧？"
        },
        {
          "role": "艾琳",
          "text": "唔…今天记得买牛奶回家…"
        },
        {
          "role": "玛格丽特",
          "text": "有空可以来我这里坐坐哦。"
        },
        {
          "role": "温迪",
          "text": "在看风景？"
        },
        {
          "role": "派蒙",
          "text": "卖唱的！你也来吃饭吗？"
        },
        {
          "role": "旅行者",
          "text": "需要给你点些什么吗？"
        },
        {
          "role": "温迪",
          "text": "要请我吃饭？可惜啊，见你们之前才刚喝过酒。"
        },
        {
          "role": "温迪",
          "text": "这份心意先保留吧，以后有的是机会。"
        },
        {
          "role": "温迪",
          "text": "我是来给你们送好消息的，感谢我吧！"
        },
        {
          "role": "派蒙",
          "text": "什么好消息？"
        },
        {
          "role": "温迪",
          "text": "看看就知道了。"
        },
        {
          "role": "旅行者",
          "text": "（这是…）"
        },
        {
          "role": "旅行者",
          "text": "（纸条上是一幅简易地图和一段咒语般的句子。）"
        },
        {
          "role": "派蒙",
          "text": "这是什么呀？"
        },
        {
          "role": "温迪",
          "text": "是你们最需要的东西。预言的谜底哦。"
        },
        {
          "role": "旅行者",
          "text": "——！！"
        },
        {
          "role": "温迪",
          "text": "前往地图所示的地点，就能找到你们要的那盏灯。不过嘛…"
        },
        {
          "role": "温迪",
          "text": "如果我是你，我不会擅自前去揭露答案。如你所见，有不少人在为这个答案操心出力呢。"
        },
        {
          "role": "温迪",
          "text": "秘密就像陈年佳酿，大家聚在一起开封才更有意义。"
        },
        {
          "role": "旅行者",
          "text": "…我明白了。"
        },
        {
          "role": "温迪",
          "text": "那就先这样，你们忙吧，等解决完预言的事也可以来找我闲聊哦。"
        },
        {
          "role": "温迪",
          "text": "有空的话，我们还可以一起办个情诗速成班。"
        },
        {
          "role": "派蒙",
          "text": "你又要办这个啦？"
        },
        {
          "role": "温迪",
          "text": "是啊，不过今年没有其他学员，只能拿你们凑数啦。"
        },
        {
          "role": "温迪",
          "text": "好了，回头见。"
        },
        {
          "role": "派蒙",
          "text": "每次见到温迪，他看起来都好悠闲，真羡慕…"
        },
        {
          "role": "？？？",
          "text": "不介意和我聊聊天吧？"
        },
        {
          "role": "派蒙",
          "text": "咦？你是…？"
        },
        {
          "role": "斯嘉莉",
          "text": "你们好啊，叫我斯嘉莉就好。"
        },
        {
          "role": "斯嘉莉",
          "text": "和你一样，我也是从别处来到蒙德的旅人。"
        },
        {
          "role": "斯嘉莉",
          "text": "我请你喝一杯怎么样？"
        },
        {
          "role": "旅行者",
          "text": "谢谢，今天不喝。"
        },
        {
          "role": "斯嘉莉",
          "text": "嗯，没有否定我的好意呢，看得出你在过去的旅行中遇到过不少人。"
        },
        {
          "role": "派蒙",
          "text": "看得出来吗？我们是很有经验的冒险家哦。"
        },
        {
          "role": "斯嘉莉",
          "text": "看得出。所以我才跟你们搭话的。"
        },
        {
          "role": "斯嘉莉",
          "text": "我刚才去商店街买东西，碰巧听到了你们在炼金铺旁的谈话。几位是在研究一则神奇的预言对吧？"
        },
        {
          "role": "派蒙",
          "text": "嗯，确实是很神奇的预言呢…"
        },
        {
          "role": "斯嘉莉",
          "text": "它听起来很有蒙德风情，不觉得吗？所以我想冒昧请求，假如你们找到了答案，能也告诉我一声吗？"
        },
        {
          "role": "旅行者",
          "text": "你也对预言感兴趣吗？"
        },
        {
          "role": "斯嘉莉",
          "text": "比起预言，我对蒙德这个国家更有兴趣。"
        },
        {
          "role": "斯嘉莉",
          "text": "我出生在遥远的异国，但我的亲人朋友曾在蒙德长住过。他们都说蒙德是个浪漫的好地方，推荐我来看看。"
        },
        {
          "role": "斯嘉莉",
          "text": "最近刚巧是跟那个人有关的纪念日，我特地过来一趟，想看看她看过的风景。"
        },
        {
          "role": "派蒙",
          "text": "那你觉得蒙德怎么样？"
        },
        {
          "role": "斯嘉莉",
          "text": "确实无愧于浪漫自由的名号。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们也都这么想。"
        },
        {
          "role": "斯嘉莉",
          "text": "那预言的事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白了。",
              "dialogues": []
            },
            {
              "text": "如果我能找到答案的话。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "斯嘉莉",
          "text": "谢谢，你真友好。很高兴认识你。"
        },
        {
          "role": "斯嘉莉",
          "text": "那我就先不打扰了，二位慢慢享受，愿你们拥有美好的一天。"
        },
        {
          "role": "派蒙",
          "text": "看她的打扮，的确不是本地人呢。不知道她的故乡在哪？"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "斯嘉莉",
          "text": "「请为我寻来不存在的花，为我找到永不迷失的指路者。」"
        },
        {
          "role": "斯嘉莉",
          "text": "「为我找出不撒谎的忠诚之人，为我寻觅永不结束的传说…」"
        },
        {
          "role": "斯嘉莉",
          "text": "……"
        },
        {
          "role": "罗莎莉亚",
          "text": "……"
        },
        {
          "role": "斯嘉莉",
          "text": "没想到在这看似自由的蒙德城里，居然也有您这样暗中跟随我的人。"
        },
        {
          "role": "罗莎莉亚",
          "text": "……"
        },
        {
          "role": "斯嘉莉",
          "text": "也祝您拥有美好的一天，小姐。"
        },
        {
          "type": "subtitle",
          "text": "彩蛋（丽莎&赛诺）"
        },
        {
          "role": "丽莎",
          "text": "赛诺小师弟，好久不见了。风花节期间能在蒙德见到你，实在是惊喜。"
        },
        {
          "role": "赛诺",
          "text": "丽莎师姐应该早就听说我到蒙德了吧。"
        },
        {
          "role": "丽莎",
          "text": "哎呀，瞒不过你呢。但我一点都不着急，我们早晚都会见面的。"
        },
        {
          "role": "赛诺",
          "text": "是啊，就像老师说的，我们这些遵循同样意志的人总会在某处相遇。"
        },
        {
          "role": "丽莎",
          "text": "居勒什老师说话总是那么诗意呢。单就这点而言，我继承他比较多，小师弟你呢…"
        },
        {
          "role": "丽莎",
          "text": "嗯，还是比较像老师机灵古怪的一面。"
        },
        {
          "role": "赛诺",
          "text": "师姐，我现在已经是大风纪官了，你这些描述不合适吧。而且我的冷笑话说得比老师好多了。"
        },
        {
          "role": "丽莎",
          "text": "是吗？我听说你在蒙德就只是冒险家赛诺呢。"
        },
        {
          "role": "赛诺",
          "text": "…也有道理。"
        },
        {
          "role": "丽莎",
          "text": "这个时节的蒙德，还不错吧？"
        },
        {
          "role": "赛诺",
          "text": "嗯。很好的地方。这一次来，多少能体会到你退学回这里的原因了。"
        },
        {
          "role": "丽莎",
          "text": "师姐我向来是很明智的哦。"
        },
        {
          "role": "赛诺",
          "text": "老师如果能像师姐这么懂得变通，他的前半生应该会好过得多。顽固对自己没有好处。"
        },
        {
          "role": "丽莎",
          "text": "老师卸任以后你都敢说他坏话了，可见他真的变了很多。"
        },
        {
          "role": "丽莎",
          "text": "至于顽固…许多学者都容易顽固。我不希望那种氛围影响你，所以才希望你多来蒙德走走，体会「自由」。"
        },
        {
          "role": "丽莎",
          "text": "我听说柯莱的事了。童年带来的影响还没完全消失，但我这次见到她了，她看起来比从前好得多。"
        },
        {
          "role": "丽莎",
          "text": "你算她半个师长吧？嗯，你们俩还真有点像。赫曼努比斯之力也让你痛苦过。"
        },
        {
          "role": "赛诺",
          "text": "过去的事都过去了。老师也没有像上级希望的那样，把我这个沙漠人当作祭司之力的试验品来看待。"
        },
        {
          "role": "赛诺",
          "text": "而且，我能拥有如今的生活多亏了老师。他收养我，教我知识，指导我怎样融入须弥的生活…我很感激。"
        },
        {
          "role": "丽莎",
          "text": "你很有天赋，天赋有时也会成为诅咒。但也是因为有了你这个学生兼养子，老师才能变得不那么顽固。"
        },
        {
          "role": "丽莎",
          "text": "作为师姐，我很为你们高兴。…哎，真怀念这种一不小心就把天聊得很严肃的感觉啊。"
        },
        {
          "role": "赛诺",
          "text": "师姐，严格来说你也是我们的一份子，相当于家中长姐。姐姐继承父亲的谈吐风格并不奇怪。"
        },
        {
          "role": "丽莎",
          "text": "那你不应该叫我师姐，要叫我丽莎姐姐。"
        },
        {
          "role": "赛诺",
          "text": "…呃…这就不用了。"
        },
        {
          "role": "丽莎",
          "text": "哈哈哈，怎么像小时候一样支支吾吾了？"
        }
      ],
