  "route": "Garcia's Paean: The Echo of Someone",
  "stories": [
    {
      "story_id": 23017,
      "title": "加尔恰的赞歌·某人的回响",
      "description": "在加尔恰身边，似乎多了一个人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与加尔恰对话"
        },
        {
          "role": "加尔恰",
          "text": "旅，旅行者！您来得正好，我正和迦雅喝完咖啡，准备回去继续工作呢。我为你介绍…"
        },
        {
          "role": "迦雅",
          "text": "这就是你之前提到的人吗？很荣幸见到您，我是迦雅，一个…嗯…跳舞的人。"
        },
        {
          "role": "旅行者",
          "text": "你好，加尔恰之前提到过你。"
        },
        {
          "role": "迦雅",
          "text": "嘻嘻，是这样么？那样就最好了，我还以为他只会记得他的机器，还有路通呢。"
        },
        {
          "role": "路通",
          "text": "您大可把我排除在外，小姐，我相信加尔恰先生也乐见此事。"
        },
        {
          "role": "迦雅",
          "text": "那可不行，要是没了你，加尔恰一定会把最后一分钱也花光的。"
        },
        {
          "role": "路通",
          "text": "这话我不敢苟同，小姐，我相信加尔恰先生无论如何都会留出两杯咖啡钱的。"
        },
        {
          "role": "加尔恰",
          "text": "三杯！"
        },
        {
          "role": "路通",
          "text": "我总会为您这灵活的同情心而惊叹，加尔恰先生。"
        },
        {
          "role": "加尔恰",
          "text": "说，说正事！旅行者，我还是在收购盗宝团所携带的那种徽印，如果你找到的话，可以直接卖给我。"
        },
        {
          "role": "加尔恰",
          "text": "我最近也…赚了点钱，你大可不用担心报酬的事。"
        },
        {
          "type": "subtitle",
          "text": "拿到盗宝团所携带的徽印，并带给加尔恰"
        },
        {
          "role": "加尔恰",
          "text": "您拿到那种徽印了吗？"
        },
        {
          "type": "subtitle",
          "text": "与加尔恰对话"
        },
        {
          "role": "加尔恰",
          "text": "嗯…这些徽印应该足够我试验了。"
        },
        {
          "role": "加尔恰",
          "text": "这是报酬，请您收好…"
        },
        {
          "role": "加尔恰",
          "text": "旅行者，您这种眼神是什么意思？盯得我发慌…"
        },
        {
          "role": "加尔恰",
          "text": "咳！我要去工作了，我现在就要去工作了…"
        },
        {
          "type": "subtitle",
          "text": "与加尔恰对话"
        },
        {
          "role": "加尔恰",
          "text": "啊，这几枚徽印的品质，看上去真不错…"
        },
        {
          "role": "加尔恰",
          "text": "这是报酬，请您收好…"
        },
        {
          "role": "加尔恰",
          "text": "旅行者，您这种眼神是什么意思？盯得我发慌…"
        },
        {
          "role": "加尔恰",
          "text": "咳！我要去工作了，我现在就要去工作了…"
        }
      ]
    }
  ]
}