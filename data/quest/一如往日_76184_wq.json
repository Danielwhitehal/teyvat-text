{
  "quest_id": 76184,
  "chapter_num": null,
  "chapter_title": "一如往日",
  "type": "wq",
  "route": "Just Like Old Times",
  "stories": [
    {
      "story_id": 76184,
      "title": "一如往日",
      "description": "前往月矩力实验设计局高处放置茶桌并使用桑多涅落座后，与众人共度茶会时光吧…",
      "dialogues": [
        {
          "role": "「公子」",
          "text": "哟，真是新奇。想不到我还有一天能被邀请参加桑多涅你的茶会。"
        },
        {
          "role": "「木偶」",
          "text": "要是你的茶会礼仪好一些的话，我以前说不定还会考虑考虑多邀请你几次。"
        },
        {
          "role": "「仆人」",
          "text": "同意。而且最好不要每次都提出要和我们当中的人比试一番。"
        },
        {
          "role": "「公子」",
          "text": "你们怎么和我家里的哥哥姐姐一样，老这么说我。没办法，以前在野外接受师父训练的时候，不太注意这些。"
        },
        {
          "role": "「木偶」",
          "text": "算了，能这么聚在一起的机会也不多。还是安心享受当下的时光吧。"
        },
        {
          "role": "「公子」",
          "text": "哦？这就是你的最新机器？"
        },
        {
          "role": "「木偶」",
          "text": "她叫法洁欧。全功能通用型自动机关。"
        },
        {
          "role": "「公子」",
          "text": "这么看来，普隆尼亚那个大家伙是真的无法被修复了吗…我很遗憾，桑多涅。"
        },
        {
          "role": "「木偶」",
          "text": "没事的，我…"
        },
        {
          "role": "「公子」",
          "text": "我很遗憾没能和他打上一场。"
        },
        {
          "role": "「木偶」",
          "text": "我就知道…"
        },
        {
          "role": "「公子」",
          "text": "那个大家伙看起来真的挺强，法洁欧看起来…"
        },
        {
          "role": "「木偶」",
          "text": "…你是想说她看起来很弱吗？"
        },
        {
          "role": "「公子」",
          "text": "呃…哈哈，没有没有。只是，看起来没普隆尼亚那个大家伙那么强而已。"
        },
        {
          "role": "「木偶」",
          "text": "啧，普隆尼亚是算术机械，他的战斗能力是我在不影响他算力的基础上添加的。"
        },
        {
          "role": "「木偶」",
          "text": "但法洁欧无需处理复杂的术式，换言之，她的所有算力，都能够用于处理战斗模块。"
        },
        {
          "role": "「公子」",
          "text": "也就是…比普隆尼亚更厉害的意思？真的假的…"
        },
        {
          "role": "「木偶」",
          "text": "我看你是真的想开开眼界是吧？"
        },
        {
          "role": "「公子」",
          "text": "先说好，打坏了我可不付维修费。"
        },
        {
          "role": "「木偶」",
          "text": "我可不付医药费。"
        },
        {
          "role": "「仆人」",
          "text": "（哎…果然还是发展成这样了。）"
        },
        {
          "role": "「少女」",
          "text": "（嚼嚼…）"
        },
        {
          "role": "「公子」",
          "text": "不错的茶会。早知道我以前就该多参加几次。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "「公子」",
          "text": "好啊，我们下次再见！"
        }
      ]
    }
  ]
}