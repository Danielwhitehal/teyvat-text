{
  "quest_id": 73056,
  "chapter_num": null,
  "chapter_title": "兰纳迦的回忆",
  "type": "wq",
  "route": "Aranaga's Memory",
  "stories": [
    {
      "story_id": 73056,
      "title": "兰纳迦的回忆",
      "description": "你们在森林中遇到了一位名叫海亚姆的老人，他似乎曾与兰那罗们有着一段过往。不如回应他的求助…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "心声（？？？）"
        },
        {
          "role": "？？？",
          "text": "（哈哈，森林好起来了…）"
        },
        {
          "role": "？？？",
          "text": "哈哈，真是有趣…真是有意思。好起来了，这片森林…好起来了啊…"
        },
        {
          "role": "派蒙",
          "text": "你好！老爷爷，你是迷路了吗？"
        },
        {
          "role": "？？？",
          "text": "嗯…嗯？麋鹿…？啊，你们是在叫我吗？哈哈，迷路，是吧？没有的事，没有的事…"
        },
        {
          "role": "海亚姆",
          "text": "你们好呀，孩子们。我是生论派的陀裟多，吉亚斯·海亚姆，哈哈…叫我海亚姆就好。"
        },
        {
          "role": "派蒙",
          "text": "唔…你好呀，海亚姆先生！"
        },
        {
          "role": "海亚姆",
          "text": "不…像这样，压下舌尖，拱起舌中…海——然后双唇呈圆形…亚——最后，自然而然地抿起嘴唇…姆——"
        },
        {
          "role": "派蒙",
          "text": "呃…海——亚——姆——"
        },
        {
          "role": "海亚姆",
          "text": "对啦！真不错！好，金发的孩子，你再来一遍。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "海——亚——姆——",
              "dialogues": [
                {
                  "role": "海亚姆",
                  "text": "哈哈，不错！比白色的小东西强多了！你看，我早说过我也能去教语音学的！"
                }
              ]
            },
            {
              "text": "海亚姆先生，你在这里做什么呢？",
              "dialogues": [
                {
                  "role": "海亚姆",
                  "text": "嗯…你发音太快了，太急促了。不过没关系…慢下来就好。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "所以，海亚姆先生…既然你没有迷路，那来这种地方做什么呀？"
        },
        {
          "role": "海亚姆",
          "text": "为什么？呵呵…我是森林学者呀。对我们森林学者来说，森林就像家一样。我怎么会在久违的家里迷路呢？"
        },
        {
          "role": "派蒙",
          "text": "哦……"
        },
        {
          "role": "海亚姆",
          "text": "这片森林深受「死域」的困扰。过去三十年里植物无论种类还是数量都在迅速减少，而有害的蕈类却越来越多…"
        },
        {
          "role": "海亚姆",
          "text": "但最近这段时间里，「死域」却消失了。很多曾经消失的植物如今重新生长了出来，蕈类的繁殖也有所收敛。"
        },
        {
          "role": "海亚姆",
          "text": "这种情况，我只在六十年前见到过一次…所以为了验证我的一点不成熟的想法，我就来到了这里。"
        },
        {
          "role": "派蒙",
          "text": "这样啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于验证想法…",
              "dialogues": [
                {
                  "role": "海亚姆",
                  "text": "哈哈，六十年前的事情了…可不要期待我这老家伙记得多清楚。但我相信，「死域」的清除，和那件事情有关。"
                },
                {
                  "role": "海亚姆",
                  "text": "所以，接下来，我要进入这个洞穴里面采集一些样本，验证我的猜想。"
                }
              ]
            },
            {
              "text": "需要我们帮助吗？",
              "dialogues": [
                {
                  "role": "海亚姆",
                  "text": "哈哈…谢谢你们，热情的孩子。我这把老骨头虽然不灵活了，但脑子还好使，可不要小看我呀。"
                },
                {
                  "role": "海亚姆",
                  "text": "毕竟，我知道怎样让森林高兴，森林就不会让我受伤害。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这样呀…洞里的「无留陀」虽然没有了，可还是很危险呀。"
        },
        {
          "role": "海亚姆",
          "text": "哈哈，对我来说没什么的…"
        },
        {
          "role": "海亚姆",
          "text": "唔，等等…你刚刚说什么？洞里的…？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「无留陀」？",
              "dialogues": []
            },
            {
              "text": "「死域」？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "嗯…再想想，我可能确实需要你们帮忙。"
        },
        {
          "role": "派蒙",
          "text": "哼哼，你看我说什么来着！"
        },
        {
          "role": "海亚姆",
          "text": "嘿嘿，请恕我冒昧…但还没有问过两位朋友的名字呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "叫我旅行者就好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "而我是派蒙！派——蒙——！"
        },
        {
          "role": "海亚姆",
          "text": "派蒙？派蒙…哈哈，很有趣的名字…我还是头一次听说有人…或者小精灵，叫这个名字呢。"
        },
        {
          "role": "海亚姆",
          "text": "啊，抱歉，抱歉。没有冒犯的意思…我是说这个小东西。"
        },
        {
          "role": "派蒙",
          "text": "什么小东西！已经很冒犯了吧！"
        },
        {
          "role": "海亚姆",
          "text": "好了，闲话不多说，请两位「杰万」随我一同来吧。"
        },
        {
          "role": "派蒙",
          "text": "「杰万」…？那是什么？"
        },
        {
          "role": "海亚姆",
          "text": "是我们家乡古老的语言，意思是「勇敢的年轻人」。"
        },
        {
          "role": "海亚姆",
          "text": "准确来说，是…「面对庞大的邪恶而不熟视无睹，直面无垠的不公而不退避求和的年轻人」。"
        },
        {
          "role": "派蒙",
          "text": "哼哼，那不就是我们么！"
        },
        {
          "role": "海亚姆",
          "text": "哦？这么有自觉吗？哈哈，那就跟我来吧。"
        },
        {
          "role": "派蒙",
          "text": "欸？海亚姆老爷爷，你的腿脚真的能跟上我们吗？"
        },
        {
          "role": "海亚姆",
          "text": "哈哈…我可有二三十年的森林考察经验，不要小瞧老年人的体能呀！你们尽管走便是，我很快就能跟上。"
        },
        {
          "type": "subtitle",
          "text": "前往「无郁夷摩」"
        },
        {
          "type": "subtitle",
          "text": "和海亚姆对话"
        },
        {
          "type": "subtitle",
          "text": "心声（海亚姆）"
        },
        {
          "role": "海亚姆",
          "text": "（新的植物长出来了…森林正在恢复活力，真好啊…）"
        },
        {
          "role": "海亚姆",
          "text": "我要调查的，主要是三个地点。哈哈，三十年前来到这里的记忆应该还没有消退干净…我还能给你们指出来。"
        },
        {
          "role": "海亚姆",
          "text": "总之，辛苦你们相陪了。"
        },
        {
          "role": "派蒙",
          "text": "不要客气啦，海亚姆先生！这都是我们「杰万」应该做的！"
        },
        {
          "type": "subtitle",
          "text": "调查特定地点的植物（2/2）"
        },
        {
          "role": "海亚姆",
          "text": "哈！你瞧！看看这个！"
        },
        {
          "role": "派蒙",
          "text": "欸？是新植物吗？怎么突然这么兴奋？"
        },
        {
          "role": "海亚姆",
          "text": "不是，不是新植物，但更让人开心！…瞧瞧呀，我们的「秘密城堡」！哈！破败成什么样子了！"
        },
        {
          "role": "派蒙",
          "text": "欸…？「秘密城堡」？"
        },
        {
          "role": "海亚姆",
          "text": "哈哈！学士奥马尔回来了！他带着群星的秘密回来了！伊尔凡，熙蔓，你们在哪里！还不出来欢迎我吗！"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "呃…咳咳，抱歉，孩子们。我…我有点太兴奋了。"
        },
        {
          "role": "海亚姆",
          "text": "岁数大了总是这样，越是现在的事，就越糊涂；越是小时候的事，就越怀念，嘿嘿…"
        },
        {
          "role": "海亚姆",
          "text": "伊尔凡，熙蔓，他们是我的朋友，我们一起搭建了这座「城堡」，我们三个。"
        },
        {
          "role": "海亚姆",
          "text": "那时候，伊尔凡是大乐师，熙蔓是元帅，我是占星学士。我们偶尔也会轮换，小孩子嘛…玩腻了就会换着来。"
        },
        {
          "role": "海亚姆",
          "text": "伊尔凡弹得一手好琴；熙蔓她个子高，胳膊壮，没人打得过；而我呢？哈哈，读书多一点，家里多点摩拉而已。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这里是你儿时玩耍的地方？",
              "dialogues": [
                {
                  "role": "海亚姆",
                  "text": "不，这里是我们的秘密国度，我很严肃的。我们和他们约好了切莫相忘，长大后举「复国军」回来光复城堡…"
                }
              ]
            },
            {
              "text": "这些都是你和玩伴留下来的吗…？",
              "dialogues": [
                {
                  "role": "海亚姆",
                  "text": "不，不全是。最初我们还约定了，等长大以后，举「复国军」回来光复这里…呵呵。"
                },
                {
                  "role": "海亚姆",
                  "text": "我后来在教令院做植物学研究，正巧回来把这里改造了一番，一波一波搬来又搬走了不少垃圾。"
                }
              ]
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "呵呵，二十年过去，他们或许都已经忘记了…这里就被我当做了研究森林的小小据点，一直运作到三十年前。"
        },
        {
          "role": "海亚姆",
          "text": "再后来，「无留陀」来了，「复国军」却还是没影儿。呵呵，也对…小孩子的约定，怎么能抵挡死亡的到来呢？"
        },
        {
          "role": "派蒙",
          "text": "可是…既然你还记得他们，他们一定也还记得你的吧！请不要灰心呀，海亚姆先生！"
        },
        {
          "role": "海亚姆",
          "text": "灰心？不会的。儿时的记忆，共同的「幻想朋友」，不属于大人的世界。可能会有点遗憾，但…时光不复回呀。"
        },
        {
          "role": "派蒙",
          "text": "「幻想朋友」…你是说兰那罗吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙…！嘘！",
              "dialogues": []
            },
            {
              "text": "就你话多，派蒙！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "……"
        },
        {
          "role": "海亚姆",
          "text": "哈哈…我差点忘记了，我是请你们来帮我为新生植物采样的，不是来闲聊的。"
        },
        {
          "role": "海亚姆",
          "text": "请原谅我这糟老头子话太多，我们继续吧。"
        },
        {
          "role": "海亚姆",
          "text": "有意思…这里的植物看起来…重新焕发生机了啊。「无郁夷摩」重新发挥作用了…真是神奇。"
        },
        {
          "role": "派蒙",
          "text": "欸…海亚姆先生也知道「无郁夷摩」吗？我还以为只有兰那罗知道…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，嘘！",
              "dialogues": []
            },
            {
              "text": "派蒙…！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "「兰那罗」，是吗？你们也看到过他们啊…"
        },
        {
          "role": "派蒙",
          "text": "欸…？嗯…是、是的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么了，海亚姆先生？",
              "dialogues": []
            },
            {
              "text": "你也见过兰那罗吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "「伊兰杳随蔷薇没，夷王神杯何所终…」"
        },
        {
          "role": "海亚姆",
          "text": "我们继续吧，去下一个地点。"
        },
        {
          "type": "subtitle",
          "text": "前往海亚姆所在地点"
        },
        {
          "role": "海亚姆",
          "text": "就是这里，就是这里！就在这里采样吧！请小心采摘几棵样本吧！"
        },
        {
          "type": "subtitle",
          "text": "调查新生的植物"
        },
        {
          "type": "subtitle",
          "text": "额外对话（海亚姆）"
        },
        {
          "role": "海亚姆",
          "text": "这里的植物长势真不错呀…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于植物…",
              "dialogues": [
                {
                  "role": "海亚姆",
                  "text": "我还从没想过，被「无留陀」侵犯过的土地，仍然能够重新孕育出供植物葱茏生长的养分。"
                }
              ]
            },
            {
              "text": "关于「幻想朋友」…",
              "dialogues": [
                {
                  "role": "海亚姆",
                  "text": "孩子们叫「兰那罗」的奇特生物体，说它们是「幻想朋友」…无疑是不准确的。"
                },
                {
                  "role": "海亚姆",
                  "text": "因为教令院的探测仪也无法看到它们，只有那些幼小的孩子们才能证明它们存在。"
                },
                {
                  "role": "海亚姆",
                  "text": "所以，生论派对这种生物的归类是「未确认生物」。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "和海亚姆对话"
        },
        {
          "role": "海亚姆",
          "text": "看呀，看呀…这里的植物长势真好！被「无留陀」蹂躏过的土壤，还是能生出有精神的植物来嘛！"
        },
        {
          "role": "海亚姆",
          "text": "哈哈，「无郁夷摩」呀「无郁夷摩」，你这个老小子！活力还是蛮足的嘛！"
        },
        {
          "role": "派蒙",
          "text": "哇，海亚姆先生好像突然变年轻了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙也突然变得会说话了！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你是什么意思啦！"
                }
              ]
            },
            {
              "text": "好耶！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "虽然不是很清楚，但是好耶！"
                }
              ]
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "嗯…你采摘的这些应该够了，辛苦你们陪我来跑一趟了。既然没有其他事情，我们离开这里吧。"
        },
        {
          "role": "海亚姆",
          "text": "哈哈，真好呀…有了这些样本，或许对「死域」秘密和弱点的研究，会有更多进展吧…"
        },
        {
          "role": "海亚姆",
          "text": "辛苦两位了，我们顺原路回去吧…我还有东西交给你们。"
        },
        {
          "role": "派蒙",
          "text": "好耶，是谢礼！"
        },
        {
          "role": "海亚姆",
          "text": "呵呵，算是吧。"
        },
        {
          "type": "subtitle",
          "text": "返回海亚姆的营地"
        },
        {
          "role": "海亚姆",
          "text": "谢谢你们，两位「杰万」。辛苦你们陪一个糟老头子跑了一趟。"
        },
        {
          "role": "海亚姆",
          "text": "对了，如果不介意的话…虽然不是什么贵重的东西。这个给你们，留作纪念吧。"
        },
        {
          "role": "派蒙",
          "text": "哇…是什么呀？是什么呀？"
        },
        {
          "role": "海亚姆",
          "text": "你们应该见过，这朵风干的小花。"
        },
        {
          "role": "派蒙",
          "text": "欸——！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是…",
              "dialogues": []
            },
            {
              "text": "兰那罗们…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "没错。而如果我没有猜错的话…他们也一定给了你同样的礼物吧？"
        },
        {
          "role": "海亚姆",
          "text": "呵呵…我就知道，我们的相遇不是单纯的巧合…我从不相信巧合这种事。"
        },
        {
          "role": "海亚姆",
          "text": "这朵花就交给你了。拜托你，交给我们共同的朋友吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯，可以是可以啦，只是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他们应该不记得我了。",
              "dialogues": [
                {
                  "role": "海亚姆",
                  "text": "……"
                }
              ]
            },
            {
              "text": "他们可能不记得你了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海亚姆",
          "text": "我也看不到他们了啊…我甚至无法相信，他们真的存在，还是说…仅仅是我的童年幻想而已…"
        },
        {
          "role": "海亚姆",
          "text": "但我还是要坚持，孩子们，把这个交给他们吧…趁你还能遇到他们，趁奇迹还有发生的可能。"
        },
        {
          "type": "subtitle",
          "text": "和兰纳迦对话"
        },
        {
          "role": "兰纳迦",
          "text": "为什么来这里，你们？"
        },
        {
          "role": "派蒙",
          "text": "哇啊！吓我一跳！"
        },
        {
          "role": "兰纳迦",
          "text": "知道我的名字，你们。但没有在这里见过你们，兰纳迦。"
        },
        {
          "role": "兰纳迦",
          "text": "所以…为什么来这里，你们？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这个问题不太好解释…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "虽然很多事情你都记不起来了，但是我们没有恶意的！我们一直都站在你们这边！一直都会帮助「无郁夷摩」！"
                },
                {
                  "role": "兰纳迦",
                  "text": "「无郁夷摩」…你们知道？"
                }
              ]
            },
            {
              "text": "我们是朋友。",
              "dialogues": [
                {
                  "role": "兰纳迦",
                  "text": "朋友…？"
                }
              ]
            }
          ]
        },
        {
          "role": "兰纳迦",
          "text": "哼…看起来不像是坏蛋，你们。"
        },
        {
          "role": "兰纳迦",
          "text": "但请不要逗留，在这里。尽快离开吧，你们。还在恢复，森林…所以，还不应该逗留，新的客人。"
        },
        {
          "role": "派蒙",
          "text": "欸…等等呀！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们有东西要交给你！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰纳迦",
          "text": "东西，给我？"
        },
        {
          "role": "兰纳迦",
          "text": "给我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就是这个。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰纳迦",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "你看，记起来了吗？你也给过我们一样的花呢！"
        },
        {
          "role": "兰纳迦",
          "text": "真的…和我是朋友，你们？很重要的花，为什么有，你们？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这个嘛…",
              "dialogues": []
            },
            {
              "text": "说来话长…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "你们向兰纳迦具言了此前的一切冒险，以及从死域中拯救「无郁夷摩」的经历。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "兰纳迦",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "怎么样，记起来了吗！"
        },
        {
          "role": "兰纳迦",
          "text": "不明白，不记得…"
        },
        {
          "role": "派蒙",
          "text": "欸——！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "唉……",
              "dialogues": []
            },
            {
              "text": "这也在意料之中…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰纳迦",
          "text": "但是，谢谢你们。我的园地，如果还记得，你们。请你们来吧。"
        },
        {
          "role": "兰纳迦",
          "text": "很重要的花，会种下，兰纳迦。"
        },
        {
          "type": "subtitle",
          "text": "兰纳迦带着花朵离开了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "离开了…呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他离开了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "不过，他还邀请我们一起去他的园地…说明他也不抗拒和我们做朋友，对吧？有时间我们一起去看看吧！"
                }
              ]
            },
            {
              "text": "但他留下了邀请。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯…说的是呢，我们有时间去看看兰纳迦吧？"
                }
              ]
            }
          ]
        }
