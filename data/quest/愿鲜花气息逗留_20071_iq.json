{
  "quest_id": 20071,
  "chapter_num": null,
  "chapter_title": "愿鲜花气息逗留",
  "type": "iq",
  "route": "Fresh Flora",
  "stories": [
    {
      "story_id": 20071,
      "title": "愿鲜花气息逗留",
      "description": "为了帮芙萝拉小姐确认「冷藏花卉」的效果，你需要再次前往雪山，取回之前埋进雪中的花卉…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与芙萝拉对话"
        },
        {
          "role": "芙萝拉",
          "text": "这边这边，来这边。"
        },
        {
          "role": "芙萝拉",
          "text": "你还记得上次我拜托你放进雪山的那些花吗？"
        },
        {
          "role": "芙萝拉",
          "text": "现在已经过了一天了，我想要看看冷藏的效果。"
        },
        {
          "role": "芙萝拉",
          "text": "你愿意帮我去雪山上，把那些花拿回来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "芙萝拉",
                  "text": "那就拜托你啦，我就在这里等你，请快去快回吧。"
                }
              ]
            },
            {
              "text": "我放哪了来着…",
              "dialogues": [
                {
                  "role": "芙萝拉",
                  "text": "你不记得了吗？是<color=#00E1FFFF>七天神像旁边</color>，<color=#00E1FFFF>山里的水边</color>，还有一个<color=#00E1FFFF>洞窟附近</color>哦。"
                },
                {
                  "role": "芙萝拉",
                  "text": "我再帮你在地图上标记一次吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往雪山回收包裹"
        },
        {
          "type": "subtitle",
          "text": "回收雪山中七天神像附近的包裹"
        },
        {
          "type": "subtitle",
          "text": "回收雪山中七天神像附近的包裹"
        },
        {
          "role": "芙萝拉",
          "text": "之前存在雪山上的花怎么样啦？"
        },
        {
          "role": "旅行者",
          "text": "加上这次的都在这里了。"
        },
        {
          "role": "芙萝拉",
          "text": "都拿到了吗 ？太好了，快给我看看。"
        },
        {
          "role": "芙萝拉",
          "text": "呼呼，看起来不错呀，嗯…看来这个方法确实可行。"
        },
        {
          "role": "芙萝拉",
          "text": "不过，雪山距离蒙德城有些太远了，总不能每次都麻烦你，以后得想个方便的办法才行…"
        },
        {
          "role": "芙萝拉",
          "text": "总之，谢谢你来帮忙呀，这些是给你的谢礼，请拿着吧。"
        },
        {
          "type": "subtitle",
          "text": "回收雪山中水域边的包裹"
        },
        {
          "type": "subtitle",
          "text": "击败出现的魔物"
        },
        {
          "type": "subtitle",
          "text": "回收洞窟附近的包裹"
        },
        {
          "type": "subtitle",
          "text": "将回收的花交给芙萝拉"
        },
        {
          "role": "芙萝拉",
          "text": "之前存在雪山上的花怎么样啦？"
        },
        {
          "role": "旅行者",
          "text": "只拿到一份…"
        },
        {
          "role": "芙萝拉",
          "text": "其他的花是没能取回来吗？唔…好吧，毕竟雪山里的情况，确实很难预料呢。"
        },
        {
          "role": "芙萝拉",
          "text": "但只有这一份的话，就没法对比着看了，只能以后再找机会了…"
        },
        {
          "role": "芙萝拉",
          "text": "这次辛苦你帮忙，这是给你准备的报酬哦，以后说不定还要麻烦你。"
        },
        {
          "type": "subtitle",
          "text": "将回收的花交给芙萝拉"
        },
        {
          "type": "subtitle",
          "text": "向芙萝拉道歉"
        },
        {
          "role": "芙萝拉",
          "text": "花怎么样啦？"
        },
        {
          "role": "旅行者",
          "text": "对不起…"
        },
        {
          "role": "芙萝拉",
          "text": "嗯？怎么了？"
        },
        {
          "role": "旅行者",
          "text": "我不小心把盒子和花弄坏了…"
        },
        {
          "role": "芙萝拉",
          "text": "弄、弄坏了？！"
        },
        {
          "role": "芙萝拉",
          "text": "呜…那可是我专门挑出来的花，那么好的花，可不是能轻易找到的…"
        },
        {
          "role": "芙萝拉",
          "text": "雪山真有这么危险吗？连你这样的冒险家都会失手，连一盒花都…"
        },
        {
          "role": "芙萝拉",
          "text": "不过，还是谢谢你帮我跑这一趟，这些东西给你，请收下吧，我要去打理店里的花了。"
        },
        {
          "role": "芙萝拉",
          "text": "唉，不然…我还是再用莎拉小姐的办法试试吧…"
        }
      ]
    }
  ]
}