{
  "quest_id": 10054,
  "chapter_num": "飞彩镌流年 其三",
  "chapter_title": "飞星聚彩，愿刻华年",
  "type": "eq",
  "route": "The Stars Inscribe the Year's Wishes",
  "stories": [
    {
      "story_id": 40037,
      "title": "飞星聚彩，愿刻华年",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "意料之外的烟花失窃案，让刻晴越发忙碌…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "等待至约定时间（次日8点至12点）"
        },
        {
          "type": "subtitle",
          "text": "与刻晴会合"
        },
        {
          "role": "行秋",
          "text": "放心，轻策庄一切安好。我和重云分头看守，他在外，我在内，没问题的。"
        },
        {
          "role": "刻晴",
          "text": "嗯。我的调查也有了些进展。"
        },
        {
          "type": "subtitle",
          "text": "旅行者、派蒙走来",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "行秋",
          "text": "准备行动了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：来得早不如来得巧！",
              "dialogues": []
            },
            {
              "text": "旅行者：我也去！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我们一起行动吧！"
        },
        {
          "role": "刻晴",
          "text": "旅行者，派蒙，来得正好。"
        },
        {
          "role": "刻晴",
          "text": "这段时间我四处搜查，找到了有关盗宝团的线索。除去车辙痕迹，路上还有极少量的烟花包装纸碎屑。"
        },
        {
          "role": "刻晴",
          "text": "我追着线索找到了失踪的货物，却没见到盗宝团的人。"
        },
        {
          "role": "旅行者",
          "text": "他们逃走了？"
        },
        {
          "role": "刻晴",
          "text": "比起逃走，更像是掉以轻心。我猜那里是他们用来囤积赃物的据点。他们可能认为囤货地点足够隐蔽，就没安排多少守卫。"
        },
        {
          "role": "刻晴",
          "text": "烟花数量惊人，我想，应该不只是轻策庄的份…放在别处的烟花也遭到了盗窃，所有赃物都汇总在那里。"
        },
        {
          "role": "刻晴",
          "text": "我已经让驻守轻策庄的千岩军火速赶往总务司报信了，总务司会召集人手，以囤货地点为中心展开搜查。"
        },
        {
          "role": "派蒙",
          "text": "既然已经通知千岩军，那应该不用你亲自出马了吧？"
        },
        {
          "role": "刻晴",
          "text": "盗宝团向来狡猾，也许还安置了别的游击人员。如果他们察觉到异样，临时把烟花运走，那我们的线索就又断了。我得盯紧一点。"
        },
        {
          "role": "派蒙",
          "text": "你、你是不是在想，如果人数不多，就一个人去把他们全打倒？"
        },
        {
          "role": "刻晴",
          "text": "哈，如此鲁莽，不是我的作风。我只想做好侦查工作而已。"
        },
        {
          "role": "刻晴",
          "text": "不过嘛，现在有你们帮忙，我觉得这个想法也不是不行。"
        },
        {
          "role": "派蒙",
          "text": "认真地考虑起来了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：（不能让刻晴独自前去。）",
              "dialogues": []
            },
            {
              "text": "旅行者：盗宝团而已，没问题啦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "刻晴",
          "text": "好。事不宜迟，我们出发吧。"
        },
        {
          "type": "subtitle",
          "text": "行秋"
        },
        {
          "role": "行秋",
          "text": "对付贼人，务必要注意安全。"
        },
        {
          "type": "subtitle",
          "text": "前往刻晴所说的地点"
        },
        {
          "role": "刻晴",
          "text": "这群盗宝团应该是想回来检查烟花。"
        },
        {
          "role": "刻晴",
          "text": "二位，请躲藏起来，我们静观其变。"
        },
        {
          "role": "修永",
          "text": "老大，这么多烟花够用了吧？"
        },
        {
          "role": "兴修",
          "text": "你小子胡说什么呢！就这么点，怎么可能够啊！"
        },
        {
          "role": "修永",
          "text": "可是，老大…要是还想弄到更多烟花，我们就得进城去偷了啊！"
        },
        {
          "role": "兴修",
          "text": "唔…实在不行，弄点没亮光只会响出声儿的那种…那种叫什么来着，闷爆竹？就那个也行！"
        },
        {
          "role": "兴修",
          "text": "总之我们的目标是，到时候尽可能弄出大动静！"
        },
        {
          "role": "兴修",
          "text": "只有把那群千岩军全引过去，其他兄弟才好下手，懂吗？"
        },
        {
          "role": "修永",
          "text": "懂了，老大英明！嘿嘿，这次肯定能捞一票大的！"
        },
        {
          "role": "修永",
          "text": "不过老大，兄弟们全出去放哨了，留在这儿的人…是不是有点少？"
        },
        {
          "role": "兴修",
          "text": "放心吧，海灯节有的是事儿，够千岩军忙了，他们绝对不可能来这里。所有人，打起精神来！再弄几批货，我们差不多就要…"
        },
        {
          "type": "subtitle",
          "text": "俊明跑来",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "俊明",
          "text": "老大！老大！不好了，不好了！"
        },
        {
          "role": "兴修",
          "text": "怎么了？"
        },
        {
          "role": "俊明",
          "text": "消、消息漏了！千岩军…千岩军已经来了，还把我们散出去的暗哨都拔了！"
        },
        {
          "role": "俊明",
          "text": "要不是有个兄弟点爆烟花示警，我都没法溜出来！老大，我们快逃吧！"
        },
        {
          "role": "兴修",
          "text": "千岩军是怎么知道消息的…还来得这么快…"
        },
        {
          "role": "兴修",
          "text": "不管了！烟花就放这儿，我们先撤！留得青山在，不怕没柴烧！"
        },
        {
          "role": "刻晴",
          "text": "看来，到我们出手的时候了。"
        },
        {
          "role": "旅行者",
          "text": "好！"
        },
        {
          "role": "派蒙",
          "text": "一起上！"
        },
        {
          "type": "subtitle",
          "text": "击败盗宝团成员"
        },
        {
          "role": "刻晴",
          "text": "放下兵器，束手就擒！"
        },
        {
          "role": "兴修",
          "text": "不长眼的东西,敢挡大爷的路!看我一刀…"
        },
        {
          "role": "兴修",
          "text": "哎?!等等…"
        },
        {
          "role": "兴修",
          "text": "你、你是…玉衡星刻晴?!"
        },
        {
          "role": "刻晴",
          "text": "哼,你认得我,算是有几分眼力。"
        },
        {
          "role": "刻晴",
          "text": "我重申一次,放下兵器,束手就擒!"
        },
        {
          "role": "兴修",
          "text": "没想到,会在荒郊野岭撞上玉衡星…"
        },
        {
          "role": "兴修",
          "text": "兄弟们,跑不掉就和他们拼了!咱们上!"
        },
        {
          "type": "subtitle",
          "text": "击败盗宝团成员后",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "刻晴",
          "text": "敬酒不吃吃罚酒。"
        },
        {
          "role": "兴修",
          "text": "栽在玉衡星手里，我…我认了。"
        },
        {
          "role": "刻晴",
          "text": "换我问话了。你们囤积大量烟花，是在打什么主意？"
        },
        {
          "role": "兴修",
          "text": "我们…我们只是…"
        },
        {
          "role": "刻晴",
          "text": "坦白从宽。"
        },
        {
          "role": "兴修",
          "text": "我…唉！罢了。"
        },
        {
          "role": "兴修",
          "text": "这些烟花，是我们预备偷偷运进城里的。我们想赶在海灯节开幕的时候点燃它们…"
        },
        {
          "role": "兴修",
          "text": "烟花又响又亮，一旦点燃肯定会引起大乱，我们想着，趁机冲进城里，捞一笔就走…"
        },
        {
          "role": "兴修",
          "text": "可是…可是数量似乎…不太够，所以…"
        },
        {
          "role": "刻晴",
          "text": "哦？如此说来，你们安排了不止一队人在外盗取烟花，是吗？"
        },
        {
          "role": "兴修",
          "text": "呃，是…原本派了很多兄弟去偷烟花，可突然听说，有个不走心的让飞云商会抓住扭送官府了…"
        },
        {
          "role": "兴修",
          "text": "我、我也觉得奇怪啊！又关飞云商会什么事儿了，我们偷的明明是官家的…"
        },
        {
          "role": "兴修",
          "text": "啊咳咳！不不，总之…我担心这个被抓的小子把整件事供出来。"
        },
        {
          "role": "兴修",
          "text": "谁能想到，才没过多久，就…被您逮住了…"
        },
        {
          "role": "派蒙",
          "text": "喂！你们的人刚刚是不是说过，千岩军也来了？"
        },
        {
          "role": "俊明",
          "text": "是啊。千岩军也不知怎么…似乎提前得知我们布下了暗哨…"
        },
        {
          "role": "俊明",
          "text": "他们无声无息地，几乎把暗哨都给拔光了…要不是有人通风报信，咱们都得被抓…"
        },
        {
          "role": "派蒙",
          "text": "现在不也是被抓了嘛。"
        },
        {
          "role": "俊明",
          "text": "呃…这、这…"
        },
        {
          "role": "刻晴",
          "text": "看来，千岩军是把那个盗宝团的嘴给撬开了。"
        },
        {
          "role": "刻晴",
          "text": "这附近说不定还有盗宝团残党，安全起见，我们先换地方。"
        },
        {
          "role": "刻晴",
          "text": "旅行者，我想请你帮忙把这批盗宝团押送回轻策庄交给驻守的千岩军。"
        },
        {
          "role": "刻晴",
          "text": "我再检查一番，之后也会赶回那里。"
        },
        {
          "role": "旅行者",
          "text": "你要注意安全。"
        },
        {
          "role": "刻晴",
          "text": "嗯，你也是。稍后我们在轻策庄见。"
        },
        {
          "type": "subtitle",
          "text": "返回轻策庄"
        },
        {
          "role": "朋义",
          "text": "唉，这可是我能弄到的最后一批烟花了，千万不要出问题啊…"
        },
        {
          "role": "景澄",
          "text": "您就放心吧。玉衡星大人亲自出马，又有我们在此驻守，保准安全。"
        },
        {
          "role": "行秋",
          "text": "所言甚是。嗯？旅行者，你回来了啊。"
        },
        {
          "role": "行秋",
          "text": "后头还跟着两个人，莫非…"
        },
        {
          "role": "旅行者",
          "text": "他们就是偷烟花的人。"
        },
        {
          "type": "subtitle",
          "text": "将擒下贼人的全过程告知众人…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "重云",
          "text": "深入敌营，实在有些危险啊。要是我也一起跟去就好了…"
        },
        {
          "role": "行秋",
          "text": "别这么说嘛，旅行者的实力你我都知道。不过真没想到，我们竟然误打误撞做了件大好事？"
        },
        {
          "role": "派蒙",
          "text": "对啊！太巧了吧！"
        },
        {
          "role": "行秋",
          "text": "看来，侠者大义本就存在于天地之间，机缘一到，自会有奇事造访啊。"
        },
        {
          "role": "朋义",
          "text": "你你你，你们这两个坏东西！就是你们偷了烟花？！哎哟，真是气死我了…"
        },
        {
          "role": "景澄",
          "text": "您、您冷静啊！总之，人抓到了就好，真是谢谢你啦旅行者。不过…刻晴大人怎么没和你一起回来？"
        },
        {
          "role": "派蒙",
          "text": "刻晴说她担心附近还有其他盗宝团，要在四周搜查一番。"
        },
        {
          "role": "景澄",
          "text": "这样啊…刻晴大人办事果然周全。刚才也有一批千岩军过来了，应该是总务司的安排。"
        },
        {
          "role": "景澄",
          "text": "听说大部分逃跑的盗宝团成员都已被逮捕归案，我们也可以稍稍放心些了。"
        },
        {
          "role": "景澄",
          "text": "这几个盗宝团成员交给我们就好，稍后由我押送回城，保证让他们和他们的同党一同受审。"
        },
        {
          "role": "行秋",
          "text": "这么一来，事情也算解决了。虽然很想留下来看看烟花…但我们也该走了。"
        },
        {
          "role": "派蒙",
          "text": "行秋，你赶着回飞云商会，莫非是有什么工作吗？"
        },
        {
          "role": "旅行者",
          "text": "居然这么忙？"
        },
        {
          "role": "行秋",
          "text": "节庆期间，难免有些忙碌。不过别担心，家丁会帮着处理的，再不济，重云也能来帮忙啊。"
        },
        {
          "role": "重云",
          "text": "你怎么还给我找事干啊？"
        },
        {
          "role": "行秋",
          "text": "身为好友，这不是应该的嘛！忙完才能出去玩，这个道理你总是明白的吧。"
        },
        {
          "role": "重云",
          "text": "嗯…也不是不行。"
        },
        {
          "role": "行秋",
          "text": "正所谓「众人拾柴火焰高」，只要把工作合理分配给适合的人，就不会有问题了。"
        },
        {
          "role": "重云",
          "text": "我倒觉得，能说会道才是顺利把工作分配出去的前提…"
        },
        {
          "role": "行秋",
          "text": "好了好了，别介意，忙完我请客！"
        },
        {
          "role": "行秋",
          "text": "那我们就先告辞了，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "重云行秋一行人离开了…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "朋义",
          "text": "说起来，旅行者，你知道刻晴大人什么时候回来吗？"
        },
        {
          "role": "朋义",
          "text": "我带来轻策庄的第二批烟花数量有限，有些担心点起来阵仗不够大…我在想，要是能把那群贼人偷走的烟花找回来就好了…"
        },
        {
          "type": "subtitle",
          "text": "远处放起两支烟花",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "派蒙",
          "text": "喂，是爆炸声！难道…难道是烟花…是盗宝团干的吗？！"
        },
        {
          "role": "旅行者",
          "text": "是刻晴的方向！"
        },
        {
          "role": "派蒙",
          "text": "糟糕，那她不就遇到敌人了吗？我们快去帮她！"
        },
        {
          "type": "subtitle",
          "text": "朋义"
        },
        {
          "role": "朋义",
          "text": "烟花爆炸，会是盗宝团所为吗？虽然不清楚具体情况，但刻晴大人一定要平安无事啊！拜托了，旅行者！"
        },
        {
          "type": "subtitle",
          "text": "景澄"
        },
        {
          "role": "景澄",
          "text": "老实点！敢给海灯节添乱，真是胆大包天。等回了总务司，一定重重地判你们！"
        },
        {
          "type": "subtitle",
          "text": "兴修"
        },
        {
          "role": "兴修",
          "text": "唉…这次算是栽了…"
        },
        {
          "type": "subtitle",
          "text": "俊明"
        },
        {
          "role": "俊明",
          "text": "千岩军这次怎么来得这么快…"
        },
        {
          "type": "subtitle",
          "text": "前往声音源头处"
        },
        {
          "role": "刻晴",
          "text": "怎、怎么搞的…"
        },
        {
          "type": "subtitle",
          "text": "旅行者、派蒙跑来",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "派蒙",
          "text": "喂——！刻晴！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：刻晴！",
              "dialogues": []
            },
            {
              "text": "旅行者：盗宝团在哪？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "刻晴",
          "text": "欸？盗宝团？"
        },
        {
          "role": "派蒙",
          "text": "刚才我们听见爆炸的声音了，是不是盗宝团又在用烟花通风报信呀？"
        },
        {
          "role": "刻晴",
          "text": "啊…不。是我看见几根烟花落在地上，就…随手摆弄了一下。"
        },
        {
          "role": "刻晴",
          "text": "没想到一不小心点燃了导线，没等我反应过来，烟花已经…已经上天了…"
        },
        {
          "role": "旅行者",
          "text": "原来是这样啊。"
        },
        {
          "role": "派蒙",
          "text": "没有敌人？那就好…我们还以为你被坏蛋包围了呢！"
        },
        {
          "role": "刻晴",
          "text": "抱歉，让你们担心绝非我的本意。幸好附近没有余党了，这件事也算是告一段落。"
        },
        {
          "role": "派蒙",
          "text": "太好啦！这样一来烟花失窃案就算是顺利解决啦，还好没让那群坏家伙得逞。"
        },
        {
          "role": "派蒙",
          "text": "不然，那么多好看的烟花都被他们浪费了，我们看什么啊？"
        },
        {
          "role": "旅行者",
          "text": "就是。"
        },
        {
          "role": "派蒙",
          "text": "对了对了，刻晴既然是「烟花会」负责人，肯定知道烟花的最佳观赏地点吧？"
        },
        {
          "role": "刻晴",
          "text": "这是当然。观赏烟花的最佳地点，非群玉阁莫属。"
        },
        {
          "role": "刻晴",
          "text": "放心吧，我记得我们的约定。不过现在我得去一趟总务司，给烟花案收尾。"
        },
        {
          "role": "刻晴",
          "text": "相关事务交给我就好，你们二位辛苦了。趁着闲暇，可以先去城里逛逛，等我忙完就来跟你们会合。"
        },
        {
          "role": "派蒙",
          "text": "好吧…要来哦！"
        },
        {
          "role": "刻晴",
          "text": "嗯，一言为定。"
        },
        {
          "type": "subtitle",
          "text": "刻晴先行离开了…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "唉，刻晴好忙啊。"
        },
        {
          "role": "派蒙",
          "text": "「忙完来跟你们会合」…我们真的能等到她忙完的时候吗？"
        },
        {
          "role": "派蒙",
          "text": "我算是明白为什么凝光小姐会担心她了，再这么下去，她真要错过海灯节啦。"
        },
        {
          "role": "旅行者",
          "text": "去找钟离吧。"
        },
        {
          "role": "派蒙",
          "text": "对哦，说好要跟他见面的呢！刚巧，我们也搜集了一些有关「休息」的看法。"
        },
        {
          "role": "派蒙",
          "text": "钟离说过他会在「三碗不过港」等我们，快去那里找他吧！"
        },
        {
          "type": "subtitle",
          "text": "前往「三碗不过港」"
        },
        {
          "type": "subtitle",
          "text": "意料之外的烟花失窃案让刻晴越发忙碌。但别忘了，还得找个好理由说服她调整工作强度…",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "咦，那是…"
        },
        {
          "type": "subtitle",
          "text": "旅行者、派蒙走向「三碗不过港」",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "云堇",
          "text": "先生所言甚是。您的建议我都谨记于心，相信会对下次演出大有帮助。"
        },
        {
          "role": "钟离",
          "text": "云先生客气。能听取建议，难怪云先生的戏越唱越好。"
        },
        {
          "role": "云堇",
          "text": "非也非也。我虽然年轻，倒也有些傲慢，可不是什么话都听得进耳。先生学识过人，才能说服我。"
        },
        {
          "type": "subtitle",
          "text": "旅行者、派蒙走来",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "派蒙",
          "text": "钟离！我们回来啦！"
        },
        {
          "role": "钟离",
          "text": "哦？"
        },
        {
          "role": "云堇",
          "text": "嗯？原来你们也认识。"
        },
        {
          "role": "派蒙",
          "text": "认识认识！"
        },
        {
          "role": "旅行者",
          "text": "略有交情，略有交情。"
        },
        {
          "role": "云堇",
          "text": "不是什么人都有机会认识像钟离先生这样渊博低调的人的。"
        },
        {
          "role": "云堇",
          "text": "旅行者，你人缘还真好。"
        },
        {
          "role": "钟离",
          "text": "云先生谬赞。我一介闲人，能有幸结识旅行者，实在是面上有光。"
        },
        {
          "role": "派蒙",
          "text": "还真敢说啊他…"
        },
        {
          "role": "旅行者",
          "text": "（完全不敢拆穿呢。）"
        },
        {
          "role": "云堇",
          "text": "是有事要谈对吧？我就不打扰了。刚好稍后约了辛焱，请容我先走一步，二位慢聊。"
        },
        {
          "role": "钟离",
          "text": "云先生慢走。"
        },
        {
          "role": "派蒙",
          "text": "哦哦，回头见啦！"
        },
        {
          "role": "钟离",
          "text": "二位，此行可有收获？"
        },
        {
          "role": "旅行者",
          "text": "我们问了大家的意见…"
        },
        {
          "type": "subtitle",
          "text": "向钟离转述了大家对「休息」一事的看法…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "钟离",
          "text": "这种种意见，在你看来又是如何？"
        },
        {
          "role": "旅行者",
          "text": "我认为可以串成故事。"
        },
        {
          "role": "派蒙",
          "text": "对对！来这里的路上我就在编了，我们的目标是用浅显易懂的故事说服刻晴，没错吧？"
        },
        {
          "role": "派蒙",
          "text": "我认为，用「吃」做主题就行！"
        },
        {
          "role": "派蒙",
          "text": "好吃的东西谁会不喜欢，说到吃也各有心得，选这个角度，百发百中呀。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：简单但不失哲理的思考。",
              "dialogues": []
            },
            {
              "text": "旅行者：独属于派蒙的智慧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼哼，这次我可是很有信心的哦！"
        },
        {
          "role": "派蒙",
          "text": "假设有个璃月厨师，厨艺了得，做饭好吃…"
        },
        {
          "role": "派蒙",
          "text": "他在璃月港里开了一家大大大——酒楼，每天都有许多客人上门吃饭，所以他每天都忙个不停。"
        },
        {
          "role": "派蒙",
          "text": "然后然后，呃…唔…后面应该怎么编来着…"
        },
        {
          "role": "旅行者",
          "text": "他做的菜越来越难吃？"
        },
        {
          "role": "派蒙",
          "text": "好像可以！不过为什么呢，明明刚才还说他很会做饭的啊。"
        },
        {
          "role": "旅行者",
          "text": "不都是你说的吗！"
        },
        {
          "role": "钟离",
          "text": "不必急于陈述结果，再多说些厨师的事，如何？"
        },
        {
          "role": "派蒙",
          "text": "厨师的事…好坏都行吗？"
        },
        {
          "role": "钟离",
          "text": "没错。知其人，才可论其心。我想先认识一下你口中的角色。"
        },
        {
          "role": "派蒙",
          "text": "我倒是没想这么多啦…<旅行者>，还是你来吧！"
        },
        {
          "role": "钟离",
          "text": "既然听了别人许多观点，不妨也将其融入故事。有理有据，更能服人。"
        },
        {
          "role": "派蒙",
          "text": "哦！我想想…留云借风真君是怎么说的来着…"
        },
        {
          "role": "派蒙",
          "text": "「种果得果，等的便是这份收获的喜悦！」"
        },
        {
          "role": "钟离",
          "text": "学得倒是有几分神韵。"
        },
        {
          "role": "派蒙",
          "text": "是吧？我想起来啦，她说过，要是废寝忘食地制作机关，以至于没空亲自验收成果…"
        },
        {
          "role": "派蒙",
          "text": "那就相当于厨师不吃自己做的菜，肯定会出问题。"
        },
        {
          "role": "钟离",
          "text": "本末倒置，不可取。"
        },
        {
          "role": "派蒙",
          "text": "对对，她也是这么说的！那故事的大厨就该是这样，做得一手好菜，却不会亲自享用。"
        },
        {
          "role": "钟离",
          "text": "不享用自己做出的佳肴，一定有其原因。"
        },
        {
          "role": "派蒙",
          "text": "嗯，因为他很忙嘛！每天要亲自接待客人，亲自点单，亲自进厨房做菜…"
        },
        {
          "role": "派蒙",
          "text": "这些事就够他受的了，每天从早忙到晚，根本没时间休息，自然就没什么时间吃饭了。"
        },
        {
          "role": "旅行者",
          "text": "已经有点离谱了吧…"
        },
        {
          "role": "派蒙",
          "text": "讲故事嘛，就是要夸张，要爆炸！砰！像烟花一样！"
        },
        {
          "role": "钟离",
          "text": "大厨不愿将深爱的事业交给伙计，又过于信任自身手艺，凡事都要亲力亲为。"
        },
        {
          "role": "派蒙",
          "text": "一听就是劳碌命啊…"
        },
        {
          "role": "旅行者",
          "text": "「众人拾柴火焰高」！"
        },
        {
          "role": "派蒙",
          "text": "对对，他就是不懂这个道理！"
        },
        {
          "role": "派蒙",
          "text": "好像还有一句重要的话…唔…是什么来着…"
        },
        {
          "role": "派蒙",
          "text": "想起来了，「休息是为了更好地工作」！烟绯说的！"
        },
        {
          "role": "派蒙",
          "text": "大厨越来越忙，忙得腰都弯了，眼圈都黑了！客人们也劝过他，关店几日，好好休息，可大厨完全听不进去。"
        },
        {
          "role": "钟离",
          "text": "迷雾障目，也难怪只顾眼前琐事，望不清远处高山。"
        },
        {
          "role": "派蒙",
          "text": "到后来，大厨的精神越来越差，菜的味道也大不如从前…客人又说不过他，又吃不到好吃的，渐渐就不来店里啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：……",
              "dialogues": []
            },
            {
              "text": "旅行者：不休息的后果真严重啊。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "钟离",
          "text": "休憩二字，向来重要。虽说人生在世各有难处，但…勉强终究不是良策。"
        },
        {
          "role": "钟离",
          "text": "故事简单，道理却很充分。听者若有心，便能参透个中真谛。"
        },
        {
          "role": "派蒙",
          "text": "什么意思？是我编的故事很好吗？"
        },
        {
          "role": "钟离",
          "text": "真诚可使人明志，忠言能指点迷津。确实是好。"
        },
        {
          "role": "钟离",
          "text": "玉衡星才智傲人，定能领悟你们想要传达的话语。"
        },
        {
          "role": "派蒙",
          "text": "真的？太好啦！"
        },
        {
          "role": "钟离",
          "text": "案件告结，她也该感到疲惫了。此时进言，应是恰当之举。"
        },
        {
          "role": "钟离",
          "text": "依我看，二位必会马到成功。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，钟离就是会说话！你能这么说，我们就放心啦。"
        },
        {
          "role": "派蒙",
          "text": "走，快去找刻晴吧！"
        },
        {
          "type": "subtitle",
          "text": "事后对话"
        },
        {
          "type": "subtitle",
          "text": "钟离"
        },
        {
          "role": "钟离",
          "text": "祝你顺利，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "前往总务司寻找刻晴"
        },
        {
          "role": "刻晴",
          "text": "此事暂告一段落，但我们不能懈怠。轻策庄周围加强巡逻，其他烟花布置点人手也要合理调配，以免再有类似事件发生。"
        },
        {
          "role": "景澄",
          "text": "是，刻晴大人。"
        },
        {
          "role": "刻晴",
          "text": "对了，上次总务司说过要千岩军增加值守路线，这件事执行得怎么样了？"
        },
        {
          "role": "景澄",
          "text": "都安排下去了，只是…种种原因，城内还有几处死角未被纳入路线。"
        },
        {
          "role": "刻晴",
          "text": "新的巡守图做好了吗？给我一份，我有空就过去看看。"
        },
        {
          "role": "景澄",
          "text": "明白！巡守图还在绘制，还请您等一等。"
        },
        {
          "type": "subtitle",
          "text": "旅行者、派蒙走来",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "刻晴",
          "text": "嗯。还有…"
        },
        {
          "role": "景澄",
          "text": "刻晴大人，您的好友来了。"
        },
        {
          "role": "派蒙",
          "text": "刻晴，你怎么还在忙呀，不去看烟花了吗？"
        },
        {
          "role": "刻晴",
          "text": "欸？不是约在群玉阁吗，你们怎么到这儿来了？"
        },
        {
          "role": "旅行者",
          "text": "是你说让我们四处逛逛。"
        },
        {
          "role": "派蒙",
          "text": "我们照你说的在城里逛了一圈，景色很不错，要是你也在就更好啦！所以，是还有什么事没做完吗？"
        },
        {
          "role": "刻晴",
          "text": "急倒是不急，小事而已。我本想尽快处理…"
        },
        {
          "role": "景澄",
          "text": "无论什么事，交给我们就好，刻晴大人，您忙了这么久，也该休息了。如果我没猜错，旅行者就是来请您休息的吧。"
        },
        {
          "role": "旅行者",
          "text": "嗯，有事要告诉刻晴。"
        },
        {
          "role": "派蒙",
          "text": "是非常重要的事哦！必须现在马上拉着你到旁边去说的那种！"
        },
        {
          "role": "刻晴",
          "text": "是…是这样吗？那景澄，这里就有劳你了。"
        },
        {
          "role": "景澄",
          "text": "明白。"
        },
        {
          "role": "刻晴",
          "text": "旅行者，派蒙，我们去群玉阁上说吧。那边景色更好，人也少些，适合谈话。"
        },
        {
          "type": "subtitle",
          "text": "刻晴、旅行者、派蒙来到群玉阁",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "刻晴",
          "text": "嗯，到这里应该可以了。"
        },
        {
          "role": "刻晴",
          "text": "具体是谈些什么呢？"
        },
        {
          "role": "旅行者",
          "text": "我们这儿有个故事…"
        },
        {
          "role": "派蒙",
          "text": "嗯！想请你就着美丽的风景听个故事，可以吗？"
        },
        {
          "role": "刻晴",
          "text": "好，我洗耳恭听。"
        },
        {
          "role": "派蒙",
          "text": "事情是这样的，我们刚才听人说，提瓦特出了件大事！有个超厉害的厨师，遇到麻烦啦！"
        },
        {
          "role": "刻晴",
          "text": "哦？是璃月名厨吗？琉璃亭的人，还是新月轩的人？"
        },
        {
          "role": "派蒙",
          "text": "不是不是，是…是蒙德大厨！非常厉害的那种！"
        },
        {
          "role": "派蒙",
          "text": "原本他的餐馆开在城门口，厨艺非常厉害，做菜又快又好。客人们总去他那里用餐，渐渐地，人越来越多了。"
        },
        {
          "role": "派蒙",
          "text": "旁边花店的店员看他这么忙碌，就劝他：「先生，是时候找些帮厨的人啦。」"
        },
        {
          "role": "派蒙",
          "text": "可大厨不乐意，他说，这些上好食材只有经他的手才能成为佳肴，别人帮不了他。"
        },
        {
          "role": "刻晴",
          "text": "自信的人才能做出好菜，他应该是个不错的厨师吧。"
        },
        {
          "role": "派蒙",
          "text": "他周围的人也是这么想的，但没想到，才过了半年，这家店就无人问津啦！"
        },
        {
          "role": "刻晴",
          "text": "嗯？"
        },
        {
          "role": "派蒙",
          "text": "很惊讶对吧？那你要不要猜猜原因？"
        },
        {
          "role": "刻晴",
          "text": "唔…是大厨忙到生病了，还是…？"
        },
        {
          "role": "派蒙",
          "text": "嘟嘟——！回答错误！<旅行者>你来说！"
        },
        {
          "role": "旅行者",
          "text": "是因为他太顽固了。"
        },
        {
          "role": "派蒙",
          "text": "回答正确！大厨就是因为顽固才变成那样的哦！"
        },
        {
          "role": "派蒙",
          "text": "他呀，实在是太忙了，每天都想着把菜做得更好，让客人宾至如归…却忘了自己也是个要吃饭要睡觉的人。"
        },
        {
          "role": "派蒙",
          "text": "他忙得没空吃饭，自然也不会去尝自己做出来的美味佳肴。"
        },
        {
          "role": "派蒙",
          "text": "困了也不愿找人帮忙，总是觉得，只有他才能做出世界上最好吃的东西。"
        },
        {
          "role": "派蒙",
          "text": "到后来，人们觉得自己帮不上他，陆续从他身旁离开了。而他自己，也因为忘了菜肴最初的味道，变得不再厉害啦。"
        },
        {
          "role": "派蒙",
          "text": "最后，连店都倒啦！"
        },
        {
          "role": "刻晴",
          "text": "……"
        },
        {
          "role": "刻晴",
          "text": "…原来如此，过分自信，反而使人失望，操之过急，却失了立场。"
        },
        {
          "role": "刻晴",
          "text": "……"
        },
        {
          "role": "刻晴",
          "text": "所以，故事说完了？"
        },
        {
          "role": "派蒙",
          "text": "哎?对、对啊…应该…应该没了吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：编得有些粗糙,抱歉。",
              "dialogues": []
            },
            {
              "text": "旅行者：还请不要笑话我们。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "咦,不是说我编了个好故事吗?"
        },
        {
          "role": "刻晴",
          "text": "编？"
        },
        {
          "role": "派蒙",
          "text": "啊!不、不是,我们只是…"
        },
        {
          "role": "刻晴",
          "text": "…噗。"
        },
        {
          "role": "刻晴",
          "text": "嗯…怎么说呢,这个故事确实简单,也没有令人惊喜的后续。"
        },
        {
          "role": "旅行者",
          "text": "……！"
        },
        {
          "role": "刻晴",
          "text": "凡事知而后动,尽力即可。我当然懂得这个道理,只是事情落到自己身上,偶尔也会失去分寸。"
        },
        {
          "role": "旅行者",
          "text": "是叫「迷雾障目」,对吧?"
        },
        {
          "role": "刻晴",
          "text": "是啊。走上高山,便会看到山间云烟,登上船只,便会望见海上迷雾。所以才要不时看看自己身在何处,要拔开迷雾,看清真心。"
        },
        {
          "role": "派蒙",
          "text": "那此时此刻,刻晴的真心是什么呀?"
        },
        {
          "role": "刻晴",
          "text": "我的真心…"
        },
        {
          "role": "刻晴",
          "text": "……"
        },
        {
          "role": "刻晴",
          "text": "我的真心,应该是让时间变慢一些。趁此机会到城中走走,见见该见的人,看看该看的烟花。"
        },
        {
          "role": "刻晴",
          "text": "回想起来,从前的我办事比现在更急躁,与我共事的人熬不过三个月便会辞职…"
        },
        {
          "role": "刻晴",
          "text": "你说得没错,分寸感确实非常重要。"
        },
        {
          "role": "刻晴",
          "text": "不过我也是有在进步的哦!应该看得出来吧？"
        },
        {
          "role": "刻晴",
          "text": "而且,我答应过你和派蒙…"
        },
        {
          "role": "刻晴",
          "text": "我们说好了,要一起欣赏今年的「烟花会」。所以…"
        },
        {
          "role": "旅行者",
          "text": "所以…"
        },
        {
          "role": "刻晴",
          "text": "海灯节快乐,旅行者,派蒙。能与你们相聚于此,我非常高兴。"
        },
        {
          "role": "刻晴",
          "text": "本次「烟花会」由我负责,我已竭尽全力做到我眼中的最好。无论如何,都希望你们能享受这次盛会。"
        },
        {
          "role": "刻晴",
          "text": "能像这样停下来看看烟花,看看璃月港,实在是令人幸福。"
        },
        {
          "role": "旅行者",
          "text": "刻晴，海灯节快乐。"
        },
        {
          "role": "派蒙",
          "text": "海灯节快乐！"
        },
        {
          "role": "刻晴",
          "text": "海灯节快乐。还有…谢谢你们。"
        },
        {
          "type": "subtitle",
          "text": "「岁华流彩」PV字幕"
        },
        {
          "role": "百识",
          "text": "大人"
        },
        {
          "role": "百识",
          "text": "凝光大人为您准备的东西"
        },
        {
          "role": "百识",
          "text": "已经送到了"
        },
        {
          "role": "刻晴",
          "text": "旅行者"
        },
        {
          "role": "刻晴",
          "text": "你在这里等我一会儿"
