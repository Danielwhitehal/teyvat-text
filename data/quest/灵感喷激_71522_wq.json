{
  "quest_id": 71522,
  "chapter_num": null,
  "chapter_title": "灵感喷激",
  "type": "wq",
  "route": "Inspiration Eruption",
  "stories": [
    {
      "story_id": 71522,
      "title": "灵感喷激",
      "description": "从蒙德来的比勒似乎正在思考着什么…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与比勒对话"
        },
        {
          "role": "比勒",
          "text": "这种游戏可真是太具有灵感了，哈哈哈！"
        },
        {
          "role": "旅行者",
          "text": "有什么新游戏？"
        },
        {
          "role": "比勒",
          "text": "旅行者！你来得正好，我正好在找人来试玩我制作的这种游戏呢。"
        },
        {
          "role": "比勒",
          "text": "朝这边看，我把这种游戏命名为「灵感喷激」。"
        },
        {
          "role": "比勒",
          "text": "它完美地复原了我们诗人创作诗歌时的全过程！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是说喝酒，喝酒和喝酒吗？",
              "dialogues": [
                {
                  "role": "比勒",
                  "text": "哈哈哈，您真幽默，用酒来刺激灵感的确是个好主意。"
                },
                {
                  "role": "比勒",
                  "text": "但要是想创作出真正出色的诗歌，光喝酒可不够。"
                }
              ]
            },
            {
              "text": "你详细说说呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "比勒",
          "text": "在一次诗歌创作中，最开始我们得四处寻找灵感。"
        },
        {
          "role": "比勒",
          "text": "有些人喜欢到处旅行、有些人喜欢独自沉思，还有些人嘛…格外喜欢用酒来刺激自己的思维。"
        },
        {
          "role": "比勒",
          "text": "这是最艰难的阶段，因为在寻找灵感的过程中，我们几乎感受不到灵感究竟在何处。"
        },
        {
          "role": "比勒",
          "text": "在大部分时间里，我们会觉得一无所获，变得烦躁又忧郁…"
        },
        {
          "role": "比勒",
          "text": "但实际上，在我们不自觉的情况下，灵感其实已经悄悄在我们的头脑中累积。"
        },
        {
          "role": "比勒",
          "text": "当某个契机到来，这些灵感就会一口气喷发而出，形成一首优秀的诗歌…或者是一幅画，或者其他什么。"
        },
        {
          "role": "旅行者",
          "text": "这也能做成游戏吗？"
        },
        {
          "role": "比勒",
          "text": "哈哈哈，当然！这诗歌的创作过程清晰明确，十分容易理解。"
        },
        {
          "role": "比勒",
          "text": "恰好蒙德城里有好几位擅长制作桌面游戏的先生，他们对我的想法十分感兴趣。"
        },
        {
          "role": "比勒",
          "text": "我们进行了几次充分的讨论，在集思广益下，这个名为「灵感喷激」的游戏就完美出炉了。"
        },
        {
          "role": "比勒",
          "text": "您要是感兴趣的话，现在就可以试玩。"
        },
        {
          "role": "比勒",
          "text": "要是多玩几局，说不定您也能学会创作诗歌呢！"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "比勒",
          "text": "怎么？您想要再寻找寻找灵感吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "想要试玩。",
              "dialogues": [
                {
                  "role": "比勒",
                  "text": "没问题，请来这边。好好感受灵感吧！"
                }
              ]
            },
            {
              "text": "还有别的事。",
              "dialogues": [
                {
                  "role": "比勒",
                  "text": "好吧，等您想玩了，直接过来这边就好。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          19,
          21
        ]
      ]
    }
  ]
}