{
  "quest_id": 20517,
  "chapter_num": null,
  "chapter_title": "惊喜大礼",
  "type": "iq",
  "route": "A Surprise Gift",
  "stories": [
    {
      "story_id": 20517,
      "title": "惊喜大礼",
      "description": "鲁道夫先生想要送自己的妻子吉丽安娜小姐一份礼物，但是却不知道送什么才好，他正为此而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与鲁道夫对话"
        },
        {
          "role": "鲁道夫",
          "text": "送什么好呢…"
        },
        {
          "role": "旅行者",
          "text": "送什么好呢…"
        },
        {
          "role": "鲁道夫",
          "text": "嗯？你也要送礼物给别人吗？"
        },
        {
          "role": "鲁道夫",
          "text": "哎呀…挑礼物确实是个费脑筋的事情…"
        },
        {
          "role": "鲁道夫",
          "text": "我想要送个礼物给我妻子吉丽安娜，却怎么想都想不到好的。"
        },
        {
          "role": "鲁道夫",
          "text": "唉，送礼物这种事就是这样，虽然看起来选项众多，但对于送礼的人来说，基本上不可能挑出自己觉得完全适合的那一个…"
        },
        {
          "role": "鲁道夫",
          "text": "唉，我是真想不出来了…又想着去问问城里的人，却又不知道从谁问起比较好。"
        },
        {
          "role": "鲁道夫",
          "text": "到底问谁比较好呢？"
        },
        {
          "role": "旅行者",
          "text": "开纪念品店的玛乔丽小姐…"
        },
        {
          "role": "鲁道夫",
          "text": "玛乔丽？哦！对啊，她开着那家纪念品店，一定有不少好东西。"
        },
        {
          "role": "鲁道夫",
          "text": "那么，拜托你帮我去跑一趟吧。莉莉出去玩了，我得在这等她回来，吉丽安娜也还在工作。"
        },
        {
          "role": "鲁道夫",
          "text": "而且我要给她个惊喜，千万不能让她知道这件事…"
        },
        {
          "role": "旅行者",
          "text": "卖水果的昆恩…"
        },
        {
          "role": "鲁道夫",
          "text": "他啊，嗨…他能有什么好主意。"
        },
        {
          "role": "鲁道夫",
          "text": "我是挑不好给吉丽安娜的礼物，他啊，如果有一天他要给贝雅特丽奇送礼物，怕是比我还纠结。"
        },
        {
          "role": "鲁道夫",
          "text": "不过，去问问他也行，说不定真能给他蒙对了…"
        },
        {
          "role": "鲁道夫",
          "text": "那就拜托你帮我跑一趟了，莉莉出去玩了，我得在这等她回来。"
        },
        {
          "role": "旅行者",
          "text": "「猎鹿人」的莎拉小姐…"
        },
        {
          "role": "鲁道夫",
          "text": "呃，在餐馆里能找到什么特别的礼物吗…"
        },
        {
          "role": "鲁道夫",
          "text": "不过，不去看看也不知道情况…实在不行，打包几份好吃的回来也不错。"
        },
        {
          "role": "鲁道夫",
          "text": "那就拜托你了，帮我去跑一趟吧。莉莉出去玩了，我得在这等她回来。"
        },
        {
          "role": "鲁道夫",
          "text": "这孩子，也不知道是去哪玩了…"
        },
        {
          "role": "旅行者",
          "text": "薇尔小姐也许会有好建议…"
        },
        {
          "role": "鲁道夫",
          "text": "薇尔？你和她很熟吗，我感觉这个人还挺神秘的…"
        },
        {
          "role": "鲁道夫",
          "text": "她真能给出好建议吗…但是去问问倒也没事。"
        },
        {
          "role": "鲁道夫",
          "text": "不过，不知道为什么，吉丽安娜突然多了很多工作，跑里跑外的，都看不着人了。"
        },
        {
          "role": "鲁道夫",
          "text": "莉莉刚出去玩了，我得在这等她回来…只能麻烦你去帮我去问问薇尔小姐了。"
        },
        {
          "type": "subtitle",
          "text": "与玛乔丽对话"
        },
        {
          "role": "旅行者",
          "text": "关于礼物…"
        },
        {
          "role": "玛乔丽",
          "text": "礼物？我这里倒是有很多，你是挑来做什么的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "鲁道夫先生要送人礼物…",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "鲁道夫先生，礼物？我这里倒是有很多好东西，但你也得先说清是送给谁的啊。"
                },
                {
                  "role": "玛乔丽",
                  "text": "光一句用来送人，可是挑不到好礼物的喔。"
                },
                {
                  "role": "玛乔丽",
                  "text": "吉丽安娜小姐？啊，我知道了，是鲁道夫先生的妻子吧。"
                }
              ]
            },
            {
              "text": "送给吉丽安娜小姐的礼物…",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "送给吉丽安娜小姐的礼物？是你要送吗？你得把送礼物的人也告诉我啊。"
                },
                {
                  "role": "玛乔丽",
                  "text": "是鲁道夫先生啊…给吉丽安娜小姐的礼物，唔…"
                }
              ]
            },
            {
              "text": "鲁道夫要送吉丽安娜礼物…",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "唔…你还挺擅长帮人挑礼物的嘛，各种条件都说得很清楚，我知道情况了。"
                },
                {
                  "role": "玛乔丽",
                  "text": "是鲁道夫先生，想送自己的妻子吉丽安娜小姐一份礼物对吧？"
                }
              ]
            }
          ]
        },
        {
          "role": "玛乔丽",
          "text": "我想一想，嗯，对，我这里确实有一份礼物，她应该会喜欢。"
        },
        {
          "role": "玛乔丽",
          "text": "不过嘛，嘿嘿，你带够钱了吗？这份礼物可是要900摩拉。"
        },
        {
          "role": "旅行者",
          "text": "我，我真没带够钱…"
        },
        {
          "role": "玛乔丽",
          "text": "不带够钱就来置办东西，你是想我把这份礼物白给你吗？"
        },
        {
          "role": "玛乔丽",
          "text": "呼…好了好了，别站在店门口一脸为难，人家会误会的。"
        },
        {
          "role": "玛乔丽",
          "text": "好了好了，我知道了。这样，你去帮我拿点风车菊回来吧，拿回来之后，我就把这份礼物给你。"
        },
        {
          "role": "玛乔丽",
          "text": "客人可真是豪爽！好，我已经把礼物包好了，请拿好。"
        },
        {
          "role": "玛乔丽",
          "text": "对了，可别拆开了啊，礼物这种东西，讲究的就是一个「惊喜」。"
        },
        {
          "role": "玛乔丽",
          "text": "而且，擅自拆开人家的礼物，可算不上是礼貌行为啊。"
        },
        {
          "role": "鲁道夫",
          "text": "这礼物可真难挑啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么要送礼物给吉丽安娜？",
              "dialogues": [
                {
                  "role": "鲁道夫",
                  "text": "为什么？什么为什么…你看你这问题问的。"
                },
                {
                  "role": "鲁道夫",
                  "text": "礼物这种东西嘛，最大的价值是给人惊喜，让人开心，"
                },
                {
                  "role": "鲁道夫",
                  "text": "我想让我的妻子开心一下，这不是很平常的事吗？"
                }
              ]
            },
            {
              "text": "你经常送礼物给吉丽安娜吗？",
              "dialogues": [
                {
                  "role": "鲁道夫",
                  "text": "啊…倒也不是经常啦，呃…就是周末的时候送一次，周一的时候送一次，然后节日和生日的时候送几次…"
                },
                {
                  "role": "鲁道夫",
                  "text": "也不算经常送，也不算经常送啦，哈哈哈哈哈。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与鲁道夫对话"
        },
        {
          "role": "鲁道夫",
          "text": "你从玛乔丽那拿到礼物了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "拿到了。",
              "dialogues": [
                {
                  "role": "鲁道夫",
                  "text": "哦！谢谢你…咦？是买到的？"
                }
              ]
            },
            {
              "text": "买到了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鲁道夫",
          "text": "呃，花，花了多少钱，我来补给你。"
        },
        {
          "role": "鲁道夫",
          "text": "毕竟是我送给吉丽安娜的礼物，可不能花你的钱，也不能花吉丽安娜的…"
        },
        {
          "role": "鲁道夫",
          "text": "我偷偷攒了点，你等会，我找找看…这些应该够了吧。"
        },
        {
          "role": "鲁道夫",
          "text": "希望吉丽安娜能喜欢这份礼物…"
        },
        {
          "type": "subtitle",
          "text": "将风车菊交给玛乔丽"
        },
        {
          "type": "subtitle",
          "text": "与鲁道夫对话"
        },
        {
          "role": "旅行者",
          "text": "小意思，我付了。"
        },
        {
          "role": "鲁道夫",
          "text": "你从玛乔丽那拿到礼物了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "拿到了。",
              "dialogues": [
                {
                  "role": "鲁道夫",
                  "text": "谢谢你，你付了多少钱，我来补给你…"
                }
              ]
            },
            {
              "text": "换到了…",
              "dialogues": [
                {
                  "role": "鲁道夫",
                  "text": "换到了？玛乔丽小姐要你用风车菊交换…"
                },
                {
                  "role": "鲁道夫",
                  "text": "她要风车菊做什么…算了，这些请你收下吧，算是答谢了。"
                }
              ]
            }
          ]
        },
        {
          "role": "鲁道夫",
          "text": "希望吉丽安娜能喜欢这份礼物…"
        },
        {
          "role": "玛乔丽",
          "text": "喂，你身上的钱好像不够啊，再去攒攒钱吧。"
        },
        {
          "role": "玛乔丽",
          "text": "这份「礼物」我可不打折，等你弄到钱了再来买吧。"
        },
        {
          "role": "旅行者",
          "text": "关于礼物…"
        },
        {
          "type": "subtitle",
          "text": "与莎拉对话"
        },
        {
          "role": "旅行者",
          "text": "关于送给吉丽安娜小姐的礼物…"
        },
        {
          "role": "莎拉",
          "text": "鲁道夫先生要送吉丽安娜小姐礼物？可是，你来问我…是要订什么特色餐品吗？"
        },
        {
          "role": "莎拉",
          "text": "除了特色餐品，我这也找不到什么特别的礼物了。"
        },
        {
          "role": "莎拉",
          "text": "好吧，你坚持的话，我去做一份特色餐品也不是不行啦…"
        },
        {
          "role": "莎拉",
          "text": "那我去做菜，你帮我把这份餐送给诺玛小姐吧，这是她订的。"
        },
        {
          "role": "莎拉",
          "text": "这份菜要趁热吃才行，一定要快点送过去啊，别让菜凉了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": [
                {
                  "role": "莎拉",
                  "text": "那就拜托了你，快去吧。"
                }
              ]
            },
            {
              "text": "我出发了！",
              "dialogues": [
                {
                  "role": "莎拉",
                  "text": "哦！那就拜托你啦！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与诺玛对话"
        },
        {
          "role": "诺玛",
          "text": "应该马上就到了吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "让您久等了！",
              "dialogues": [
                {
                  "role": "诺玛",
                  "text": "呜哇！吓我一跳，你们送餐的速度真快啊。"
                }
              ]
            },
            {
              "text": "这是您订的餐吗？",
              "dialogues": [
                {
                  "role": "诺玛",
                  "text": "呜哇！吓我一跳，是，是我订的餐没错…你们的速度可真快啊。"
                }
              ]
            }
          ]
        },
        {
          "role": "诺玛",
          "text": "温度也还不错，不用重新再热了，辛苦你了。"
        },
        {
          "role": "诺玛",
          "text": "为什么在城里也要点餐？啊…这个…"
        },
        {
          "role": "诺玛",
          "text": "因为成品餐很方便嘛，也省得洗碗和打扫厨房了。"
        },
        {
          "role": "诺玛",
          "text": "而且，我也只会做那么几道菜，老公他早就吃腻了吧…"
        },
        {
          "type": "subtitle",
          "text": "与莎拉对话"
        },
        {
          "role": "旅行者",
          "text": "菜凉透了…"
        },
        {
          "role": "莎拉",
          "text": "呃，这份菜已经凉透了啊。"
        },
        {
          "role": "莎拉",
          "text": "没办法，我重新做一份给你们吧…这次要抓紧啊。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "莎拉",
          "text": "好了，抓紧送过去吧。"
        },
        {
          "type": "subtitle",
          "text": "与莎拉对话"
        },
        {
          "role": "旅行者",
          "text": "餐品送到了。"
        },
        {
          "role": "莎拉",
          "text": "你们把菜送过去了？太好了，那份餐很容易凉，凉了就不好吃了。"
        },
        {
          "role": "莎拉",
          "text": "给吉丽安娜小姐的特色餐品也做好了。哼哼，同是女孩子，吉丽安娜小姐绝对会很喜欢这份餐品的，而且，这份餐她肯定也一看就明白…"
        },
        {
          "role": "莎拉",
          "text": "好了，快点送过去吧，这份倒是不用着急趁热送过去。毕竟，现在也许不是吃的时候…"
        },
        {
          "role": "莎拉",
          "text": "嗯…怎么说呢，要吃的时候，热一热就好了。至于什么时候吃，就交给吉丽安娜小姐自己判断啦。"
        },
        {
          "role": "莎拉",
          "text": "对了，可别自己偷偷摸摸拆开吃掉了啊，我可没空做第二份了！"
        },
        {
          "type": "subtitle",
          "text": "与鲁道夫对话"
        },
        {
          "role": "鲁道夫",
          "text": "你从莎拉小姐那拿到礼物了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "拿到了。",
              "dialogues": [
                {
                  "role": "鲁道夫",
                  "text": "还真拿到了，到底是什么礼物呢…"
                },
                {
                  "role": "鲁道夫",
                  "text": "不能看？好吧，估计也就是些好吃的吧…"
                }
              ]
            },
            {
              "text": "是特色餐品。",
              "dialogues": [
                {
                  "role": "鲁道夫",
                  "text": "特色餐品？到底是什么特色呢…"
                }
              ]
            }
          ]
        },
        {
          "role": "鲁道夫",
          "text": "女孩之间的秘密…到底是什么菜，弄这么神秘。"
        },
        {
          "role": "鲁道夫",
          "text": "算了，我就相信莎拉小姐吧。这些给你，谢谢你帮我的忙。"
        },
        {
          "role": "鲁道夫",
          "text": "希望吉丽安娜喜欢这份礼物…"
        },
        {
          "type": "subtitle",
          "text": "与昆恩对话"
        },
        {
          "role": "昆恩",
          "text": "贝雅特丽奇这个家伙…"
        },
        {
          "role": "旅行者",
          "text": "关于送给吉丽安娜小姐的礼物…"
        },
        {
          "role": "昆恩",
          "text": "鲁道夫先生要送自己妻子礼物…"
        },
        {
          "role": "昆恩",
          "text": "这种问题你为什么会来问我？我可没有这方面的经验。而且我也没时间想这个…"
        },
        {
          "role": "昆恩",
          "text": "什么？贝雅特丽奇？那，那家伙和这件事有什么关系！你别乱想好不好？"
        },
        {
          "role": "昆恩",
          "text": "好了好了，我来帮你想想行了吧，不过你得帮我个忙。"
        },
        {
          "role": "昆恩",
          "text": "我订的一批新货到现在也没有来，你去帮我找找吧，等你回来了，我估计也就想明白了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "昆恩",
                  "text": "那就拜托你了。"
                }
              ]
            },
            {
              "text": "关于贝雅特丽奇…",
              "dialogues": [
                {
                  "role": "昆恩",
                  "text": "你这个人，不要哪壶不开提哪壶！"
                },
                {
                  "role": "昆恩",
                  "text": "快去帮我找找货啊，我就在这，帮你想那个「特别的礼物」…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找货车"
        },
        {
          "type": "subtitle",
          "text": "保护货车"
        },
        {
          "type": "subtitle",
          "text": "与昆恩对话"
        },
        {
          "role": "鲁道夫",
          "text": "莎拉小姐…到底能有什么好主意呢？"
        },
        {
