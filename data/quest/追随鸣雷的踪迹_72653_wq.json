  "quest_id": 72653,
  "chapter_num": null,
  "chapter_title": "追随鸣雷的踪迹",
  "type": "wq",
  "route": "Tracking the Thunder",
  "stories": [
    {
      "story_id": 72653,
      "title": "追随鸣雷的踪迹",
      "description": "此前的发现为慕珍的研究带来了新的突破，但调查仍需再接再厉…",
      "dialogues": [
        {
          "role": "慕珍",
          "text": "旅行者，你回来了！"
        },
        {
          "role": "慕珍",
          "text": "你之前带回的那些晶片，我在船上研究了一番。看起来它们还很…「年轻」。"
        },
        {
          "role": "慕珍",
          "text": "这说明它们来自于新形成的元素结团…嗯，打个比方说，就像不久前才留在雪地上的、更深些的脚印。"
        },
        {
          "role": "慕珍",
          "text": "而现在呢，我希望你能帮我调查一下那些更「浅」的脚印…逆着它们的方向，往源头追查！"
        },
        {
          "role": "慕珍",
          "text": "所谓「更浅的脚印」呢，就是指那些已经凝结到一定程度，在地面附近沉积的雷元素聚合体。"
        },
        {
          "role": "慕珍",
          "text": "如果能够取得一定量的样本加以分类对比，或许能够画出大致的路线图…"
        },
        {
          "role": "派蒙",
          "text": "什么…深浅脚印、路线图的…没听懂呢…"
        },
        {
          "role": "旅行者",
          "text": "唔…确实难懂呢。"
        },
        {
          "role": "慕珍",
          "text": "哈哈，我打的比方可能有点不太贴切，不过你到了报告地点，自然就会知道了。"
        },
        {
          "role": "慕珍",
          "text": "好了，闲话不多说，快点出发吧！"
        }
      ]
    }
  ]
}