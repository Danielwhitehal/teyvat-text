    {
      "story_id": 74656,
      "title": "伊斯梅诺的泡泡桔需求",
      "description": "伊斯梅诺需要5个泡泡桔。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将5个泡泡桔交给伊斯梅诺"
        },
        {
          "role": "伊斯梅诺",
          "text": "你也是出来散步的吗？"
        },
        {
          "role": "旅行者",
          "text": "关于泡泡桔…"
        },
        {
          "role": "伊斯梅诺",
          "text": "那么年轻的朋友，你带了泡泡桔来吧？请分我一些，我们边吃边聊。"
        },
        {
          "role": "伊斯梅诺",
          "text": "雕塑是无言的诗，不要在饿着肚子的时候欣赏它们。这是一位决斗者在他人生最后一次决斗中告诉我的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "准备好了。",
              "dialogues": []
            },
            {
              "text": "还没准备好。",
              "dialogues": [
                {
                  "role": "伊斯梅诺",
                  "text": "我按照从别人那里听说的，准备了答谢你的泡泡桔的钱。这样的话，我好像该等到你准备好了再给…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与伊斯梅诺对话"
        },
        {
          "role": "伊斯梅诺",
          "text": "谢谢你。看你的表情，好像对那位决斗者更感兴趣？那是很久之前的事了…"
        },
        {
          "role": "伊斯梅诺",
          "text": "（陷入沉思）"
        }
      ]
    }
  ]
}