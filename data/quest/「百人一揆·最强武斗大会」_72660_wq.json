{
  "quest_id": 72660,
  "chapter_num": null,
  "chapter_title": "「百人一揆·最强武斗大会」",
  "type": "wq",
  "route": "Hyakunin Ikki: The Greatest Battle",
  "stories": [
    {
      "story_id": 72660,
      "title": "「百人一揆·最强武斗大会」",
      "description": "在稻妻城，似乎有人在寻找格外出众的战士…",
      "dialogues": [
        {
          "role": "茅葺一庆",
          "text": "嗨！那边那位异乡人，有兴趣战斗吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
             {
              "text": "我是身经百战的战士。",
              "dialogues": [
                {
          "role": "茅葺一庆",
          "text": "太好了，我果然没看错人。"
        }
              ]
            },
            {
              "text": "有什么委托吗？",
              "dialogues": [
                {
          "role": "茅葺一庆",
          "text": "也不算是委托吧。总之…"
        }
              ]
            }
          ]
        },      
        {
          "role": "茅葺一庆",
          "text": "事情是这样的，最近似乎又有人在秘密举办「百人一揆」了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "百人一首？",
              "dialogues": [
                {
          "role": "茅葺一庆",
          "text": "不不不，是百人一揆。百人一首是什么呀…"
        }
              ]
            },
            {
              "text": "愿闻其详。",
              "dialogues": []
            }
          ]
        },
        
        {
          "role": "茅葺一庆",
          "text": "过去模仿天狗的「天狗党人」当中，曾经流传过某种传统仪式。简单来说，是这样的——"
        },
        {
          "role": "茅葺一庆",
          "text": "时令不景气时、心情低落时；或是有值得庆贺的喜事发生时；或者只是单纯感到无聊的时候…"
        },
        {
          "role": "茅葺一庆",
          "text": "就是通过酣畅淋漓的打斗，来进行庆祝、或者消除晦气。"
        },
        {
          "role": "旅行者",
          "text": "好像什么时候都能举办…"
        },
        {
          "role": "茅葺一庆",
          "text": "…仔细一想，似乎确实是这样。"
        },
        {
          "role": "茅葺一庆",
          "text": "总之，我们换个地方说话吧。城里人多口杂，不太方便…"
        },
        {
          "type": "subtitle",
          "text": "与茅葺对话"
        },
        {
          "role": "茅葺一庆",
          "text": "我们到了。"
        },
        {
          "role": "茅葺一庆",
          "text": "只要踏入这扇看起来十分可疑的大门，就能进入百人一揆的场馆。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "好兴奋。",
            "好可疑。"
          ]
        },
        {
          "role": "茅葺一庆",
          "text": "虽然「天狗党」早已因为有违公序良俗而被取缔，但不时还会有人秘密举办百人一揆的乱斗大会。"
        },
        {
          "role": "茅葺一庆",
          "text": "而来自世界各地渴求争斗的魔物、冒险者、战士，冥冥之中也会被它吸引，在它的舞台上酣畅淋漓地大打出手。"
        },
        {
          "role": "茅葺一庆",
          "text": "你可以和志同道合的同伴、战友一起去参战。毕竟，所谓「百人」，自然是人数越多越好啦。"
        },
        {
          "role": "茅葺一庆",
          "text": "你看起来是云游四海的冒险家，想必有愿意与你一同参加的朋友吧。"
        },
        {
          "role": "旅行者",
          "text": "你不参加吗？"
        },
        {
          "role": "茅葺一庆",
          "text": "我吗？我会以旁观者的身份参与，为你喝彩。"
        },
        {
          "role": "茅葺一庆",
          "text": "其实，我的目的是写出最精彩的格斗小说，斩获八重堂的「这本小说真厉害」大奖。"
        },
        {
          "role": "茅葺一庆",
          "text": "而我的直觉告诉我，你一定会是格斗场上最耀眼的明星。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我会尽力。",
            "那当然。"
          ]
        },
        {
          "role": "茅葺一庆",
          "text": "小说的名字我已经想好了，就叫《百人一揆～最强武斗大会篇～》。如果有朝一日你在八重堂书店里看见这本书，那其中一定会有金发的异邦战士登场。"
        },
        {
          "role": "茅葺一庆",
          "text": "我很期待你的表现。"
        }
      ]
    }
  ]
}