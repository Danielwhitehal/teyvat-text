{
  "quest_id": 10170,
  "chapter_num": "炼金与经营 其一",
  "chapter_title": "神奇药剂",
  "type": "eq",
  "route": "Potions Most Potent",
  "stories": [
    {
      "story_id": 40144,
      "title": "神奇药剂",
      "description": "丽莎难得地在为某事而忙碌着…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "有段时间没回骑士团了，不知道琴团长和丽莎她们在忙些什么？不如回去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "与丽莎对话"
        },
        {
          "role": "丽莎",
          "text": "是你呀小可爱。今天怎么有空过来了。"
        },
        {
          "role": "丽莎",
          "text": "是想看看书，还是看看姐姐我呀？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来看看丽莎。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "呵呵，你还是这么贴心。"
                }
              ]
            },
            {
              "text": "正好路过…",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "顺便来找我聊聊天吗？"
                }
              ]
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "不过今天有些不巧，我正好在处理一项工作，暂时没法招待你们喝下午茶了。"
        },
        {
          "role": "派蒙",
          "text": "哇，丽莎居然在认真工作，也太少见了吧？"
        },
        {
          "role": "丽莎",
          "text": "确实是呢，上次像这样埋头研究，好像还是在教令院的时候吧。"
        },
        {
          "role": "丽莎",
          "text": "久违地认真思考，还挺累人的呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道是在写论文…",
              "dialogues": []
            },
            {
              "text": "难道是在做课题…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "呵呵，看你这么有兴趣，要考虑加入进来吗？"
        },
        {
          "role": "丽莎",
          "text": "陪姐姐一起重温学生时代如何？"
        },
        {
          "role": "派蒙",
          "text": "不要突然把工作塞给别人啊！"
        },
        {
          "role": "丽莎",
          "text": "旅行者不愿意吗？这可是难得的，跟姐姐一起携手攻克难关的机会呀。顺带一提，报酬也会相当丰厚哦？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "愿闻其详。",
              "dialogues": []
            },
            {
              "text": "要先看看是什么事。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "你应该知道，骑士团一直在进行炼金术的相关研究。"
        },
        {
          "role": "丽莎",
          "text": "但是大多数的课题都在实验室里进行，民众对炼金术的了解程度不是很高。"
        },
        {
          "role": "丽莎",
          "text": "这样的结果就是，花了许多资金投入的研究课题，却没能产生更广泛的作用。"
        },
        {
          "role": "丽莎",
          "text": "于是，琴打算在普通民众间推广炼金术的成果…现阶段来说，就是炼金药剂哦。"
        },
        {
          "role": "丽莎",
          "text": "平时除了图书馆的事情，我也会帮忙管理骑士团的药剂供应。"
        },
        {
          "role": "丽莎",
          "text": "再加上药剂学是我以前的研究方向之一，在琴看来，我就成了这份工作最合适的人选。"
        },
        {
          "role": "丽莎",
          "text": "但要兼顾民众的日常需求，就得对炼制的材料做一些调整，炼制的方式也要做适当简化…"
        },
        {
          "role": "丽莎",
          "text": "一来二去，原以为简单的课题，逐渐变得越来越复杂呢。"
        },
        {
          "role": "派蒙",
          "text": "难道说，是要我们帮忙研究吗？可是炼金术的理论，我们了解得也不是很多呀。"
        },
        {
          "role": "丽莎",
          "text": "呵呵，不是的，姐姐已经想好了更适合你们的工作哦。"
        },
        {
          "role": "丽莎",
          "text": "虽然炼制技术的研究正在稳步推进，但如果不实际收集民众的使用反馈，就没办法知道能不能满足大家的需要。"
        },
        {
          "role": "丽莎",
          "text": "可如果要一边研发药剂，一边收集反馈，就需要效率更高的方式了。"
        },
        {
          "role": "丽莎",
          "text": "我想到的办法是，直接开一家售卖炼金药剂的商店。这样就能一边炼制药剂，一边了解大家的日常需求了。"
        },
        {
          "role": "派蒙",
          "text": "哦！把两项工作合并成一项…不愧是丽莎能想出来的方法呢！"
        },
        {
          "role": "丽莎",
          "text": "是呀，而最适合这份工作的，当然就是我们骑士团的精锐——旅行者了。"
        },
        {
          "role": "丽莎",
          "text": "在教令院的时候，同学之间也会互相给对方的课题帮忙呢。"
        },
        {
          "role": "丽莎",
          "text": "小可爱难道不想体会一下这种青春洋溢的生活吗？"
        },
        {
          "role": "派蒙",
          "text": "说的好听，其实还是想偷懒吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就当是为了丽莎吧。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "呵呵，我就知道你最可靠了。"
                }
              ]
            },
            {
              "text": "就当是挑战一下自己。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "嗯，你果然很有干劲呢。"
                }
              ]
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "等工作告一段落，姐姐会亲自准备报酬的。"
        },
        {
          "role": "丽莎",
          "text": "店铺的前期准备已经完成了，接下来的事情，我们直接到那边再聊吧。"
        },
        {
          "type": "subtitle",
          "text": "前往店铺"
        },
        {
          "role": "丽莎",
          "text": "这里就是我们要开店的地方了。"
        },
        {
          "role": "派蒙",
          "text": "哇，这么多的准备，都是丽莎一个人做完的吗？"
        },
        {
          "role": "丽莎",
          "text": "这是骑士团的大家一起努力的成果哦。"
        },
        {
          "role": "丽莎",
          "text": "开店所需的启动资金，是琴特意筹备的。炼制药剂所需的药材和设备，得到了阿贝多和砂糖的支持。"
        },
        {
          "role": "丽莎",
          "text": "至于后续的物资补充，则是由后勤小队来负责。"
        },
        {
          "role": "丽莎",
          "text": "现在又有了你们的加入，姐姐身上的担子减轻了不少呢。"
        },
        {
          "role": "丽莎",
          "text": "这些天，骑士团已经对店铺做了一系列宣传。等我们准备好了，就可以正式开业啦。"
        },
        {
          "role": "丽莎",
          "text": "事不宜迟，接下来你就用这几种药材，试着炼制药剂吧。"
        },
        {
          "type": "subtitle",
          "text": "尝试炼制药剂"
        },
        {
          "role": "丽莎",
          "text": "炼金之旅开始啦，就用这些药材尝试炼制，找找灵感吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（丽莎）"
        },
        {
          "role": "丽莎",
          "text": "只要把药材放进炼金釜，按照步骤操作，就能炼制出药剂了。"
        },
        {
          "type": "subtitle",
          "text": "阅读（告示牌）"
        },
        {
          "role": "阅读",
          "text": "西风骑士团特许经营，专业技术认证，实用又可靠的炼金药剂火热促销中！"
        },
        {
          "type": "subtitle",
          "text": "尝试上架售卖"
        },
        {
          "role": "丽莎",
          "text": "看起来药剂已经完成了呢，接下来就可以上架售卖了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（丽莎）"
        },
        {
          "role": "丽莎",
          "text": "试着将炼好的药剂放到那边的货架上吧。"
        },
        {
          "type": "subtitle",
          "text": "结束当前经营周期"
        },
        {
          "role": "派蒙",
          "text": "这样开店的准备就算完成了吧！我们在那边休息一段时间，等待客人来吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（丽莎）"
        },
        {
          "role": "丽莎",
          "text": "哎呀，已经准备妥当了吗？该让骑士团的各位把开业公告张贴起来了。"
        },
        {
          "type": "subtitle",
          "text": "与丽莎对话"
        },
        {
          "role": "丽莎",
          "text": "嗯，你已经顺利卖出第一批药剂了呢，这是个好的开始。"
        },
        {
          "role": "丽莎",
          "text": "至于之后要炼制什么样的药剂，就要参考市场消息了。"
        },
        {
          "role": "丽莎",
          "text": "根据近期发生的一些新闻，来推测人们需要什么样的药剂，这是经营的必备技巧哦。"
        },
        {
          "role": "派蒙",
          "text": "呃，听起来有点难度呢…"
        },
        {
          "role": "丽莎",
          "text": "呵呵…别担心，姐姐已经贴心地帮你整理好了最近的市场消息。"
        },
        {
          "type": "subtitle",
          "text": "市场情报（2~4周期）"
        },
        {
          "type": "subtitle",
          "text": "猎鹿人餐厅正在为热爱战斗的冒险家研发全新菜品。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "蒙德的花店店主想让鲜花生长得更加繁茂，开放时间更长。",
          "narration": true
        },
        {
          "role": "丽莎",
          "text": "怎么样，对接下来要出售的药剂有什么想法了吗？"
        },
        {
          "role": "丽莎",
          "text": "那么就试试培育新的药材吧。这些药材经过了生物炼金技术的处理，带有不同的功效和特征。"
        },
        {
          "role": "丽莎",
          "text": "根据加入药材的种类不同，最终炼制出的药剂也会发生变化。可以多尝试不同的组合哦。"
        },
        {
          "role": "丽莎",
          "text": "好了，你去实际尝试一下吧。"
        },
        {
          "type": "subtitle",
          "text": "尝试培育药材"
        },
        {
          "type": "subtitle",
          "text": "额外对话（丽莎）"
        },
        {
          "role": "丽莎",
          "text": "去试试培育新的药材吧。"
        },
        {
          "type": "subtitle",
          "text": "与丽莎对话"
        },
        {
          "role": "丽莎",
          "text": "看来你对培育流程也熟悉起来了吧？"
        },
        {
          "role": "丽莎",
          "text": "啊，后勤小队的骑士已经到了呢，她会定期提供新的物资补给，你们待会去找她聊聊吧。"
        },
        {
          "role": "丽莎",
          "text": "再之后就是你自由发挥的时间啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那丽莎负责什么呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，怎么变成了只有我们在忙里忙外…丽莎你的工作呢！"
        },
        {
          "role": "丽莎",
          "text": "我吗？当然是要确保小可爱能顺利掌握经营和炼金的技巧了。"
        },
        {
          "role": "丽莎",
          "text": "姐姐会一直支持你的，加油哦。"
        },
        {
          "role": "派蒙",
          "text": "我就知道会变成这样…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（丽莎）"
        },
        {
          "role": "丽莎",
          "text": "小可爱有什么疑问吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于炼制药剂。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "只要把药材放进炼金釜，按照步骤操作，就能炼制出药剂了。"
                },
                {
                  "role": "丽莎",
                  "text": "根据加入药材的种类不同，最终炼制出的药剂也会发生变化。可以多尝试不同的组合。"
                }
              ]
            },
            {
              "text": "关于培育药材。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "这批药材经过了生物炼金技术的处理，带有不同的功效和特征。可以根据想要炼制的药剂，培育对应的药材哦。"
                }
              ]
            },
            {
              "text": "关于市场消息。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "具体要炼制什么样的药剂，就要参考市场消息了。"
                },
                {
                  "role": "丽莎",
                  "text": "姐姐已经贴心地将近期的市场消息都整理好了，你在货架那边就能看到啦。"
                }
              ]
            },
            {
              "text": "没什么了。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "呵呵，有问题的话要及时跟姐姐说哦。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与芙里达对话"
        },
        {
          "role": "芙里达",
          "text": "荣誉骑士旅行者，和她/他的侍从派蒙，你们好呀！后勤小队骑士芙里达，向你们致以问候！"
        },
        {
          "role": "派蒙",
          "text": "哇，我的大名已经远近皆知了吗。不过侍从是什么啦，我是她/他的伙伴才对！"
        },
        {
          "role": "芙里达",
          "text": "哦，抱歉，不小心就沿用了流行小说的用法。"
        },
        {
          "role": "芙里达",
          "text": "你们的事迹可以说是传说一般的存在，真是令人羡慕…"
        },
        {
          "role": "芙里达",
          "text": "我也想成为四处冒险的游侠骑士，这样的生活一定很有趣吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说不定以后有机会呢。",
              "dialogues": [
                {
                  "role": "芙里达",
                  "text": "是啊，我也是这么期待着的！"
                }
              ]
            },
            {
              "text": "其实也没有这么轻松。",
              "dialogues": [
                {
                  "role": "芙里达",
                  "text": "我想也是，小说里的游侠骑士都会经历很多危险…"
                }
              ]
            }
          ]
        },
        {
          "role": "芙里达",
          "text": "无论如何，现在还是好好完成眼前的工作吧。"
        },
        {
          "role": "芙里达",
          "text": "我收到代理团长的指示，要全力支持你们的经营事业。"
        },
        {
          "role": "芙里达",
          "text": "你们有什么需要，都可以向我提出哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "物资采购。",
              "dialogues": [
                {
                  "role": "芙里达",
                  "text": "最近新到了一批物资，请看看有什么需要哦。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "芙里达",
                  "text": "祝你们经营顺利！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（芙里达）"
        },
        {
          "role": "芙里达",
          "text": "你们好！芙里达今天也会全力为你们应援的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "物资采购。",
              "dialogues": []
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "芙里达",
                  "text": "祝你们经营顺利！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
