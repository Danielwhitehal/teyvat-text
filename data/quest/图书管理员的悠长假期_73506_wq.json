{
  "quest_id": 73506,
  "chapter_num": null,
  "chapter_title": "图书管理员的悠长假期",
  "type": "wq",
  "route": "A Librarian's Long and Carefree Vacation",
  "stories": [
    {
      "story_id": 73506,
      "title": "图书管理员的悠长假期",
      "description": "联络员阿芬迪正在为悉般多摩学院的一项长期研究寻找合适的志愿者…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与阿芬迪对话"
        },
        {
          "role": "阿芬迪",
          "text": "你好，欢迎来到聚砂厅，有兴趣接一些委托工作吗？"
        },
        {
          "role": "派蒙",
          "text": "有没有那种毫不费力，站着就能拿摩拉拿到手软的工作？我们很有兴趣。"
        },
        {
          "role": "阿芬迪",
          "text": "这…这样的委托确实还没有，不过我这里有一些比较简单的居民请求，报酬分别在几万摩拉不等。"
        },
        {
          "role": "派蒙",
          "text": "唔…几万摩拉吗？感觉有点不够花呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "摩拉越多越好。",
              "dialogues": []
            },
            {
              "text": "想要亮晶晶的石头。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊。阿芬迪先生，有没有报酬更高些的委托？"
        },
        {
          "role": "阿芬迪",
          "text": "啊这样吗？我想想…最近悉般多摩学院开设了一个地脉调研项目，正在有偿招募志愿者。"
        },
        {
          "role": "阿芬迪",
          "text": "悉般多摩学院里有不少学者专攻地脉研究，对地脉数据的需求很大，时常需要进入秘境调查地脉异常。"
        },
        {
          "role": "阿芬迪",
          "text": "这段时间里他们有些人手不足，找了不少本院学生帮忙还不够，不得不大量招募志愿者。"
        },
        {
          "role": "阿芬迪",
          "text": "他们的报酬开得很高，相应的，对志愿者本身的素质要求也很严格。你们有兴趣吗？"
        },
        {
          "role": "旅行者",
          "text": "有什么要求？"
        },
        {
          "role": "阿芬迪",
          "text": "好，我来按招募流程确认下吧，首先：「你是否能够熟练使用一种以上的武器？」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我在单手剑领域颇有心得。",
              "dialogues": []
            },
            {
              "text": "其实我诸武精通。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿芬迪",
          "text": "很好，那么「你对元素的了解如何？是否能够使用元素力？」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我非常了解元素反应。",
              "dialogues": []
            },
            {
              "text": "我使用元素力战斗的经验很丰富。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿芬迪",
          "text": "嗯，旅行者是吧，我这里登记上了。志愿者需要的物资和报酬我之后会协调。"
        },
        {
          "role": "阿芬迪",
          "text": "不过具体的工作接洽还得找加福尔先生，但他今天有位重要访客需要接待，应该不在教令院内。"
        },
        {
          "role": "阿芬迪",
          "text": "按照院内访客接待标准流程，他今天应该会带访客去普斯帕咖啡馆。等访客接待时间结束，你们可以去和他谈谈。"
        },
        {
          "role": "阿芬迪",
          "text": "真是的，跟我联络的时候还说是急着招募志愿者，怎么还中途去接待访客了，到底什么人这么重要…"
        },
        {
          "type": "subtitle",
          "text": "进入普斯帕咖啡馆"
        },
        {
          "role": "加福尔",
          "text": "这里的咖啡，你还熟悉吗？"
        },
        {
          "role": "？？？",
          "text": "当然，这是我以前最常喝的饮品，怎么会不熟悉呢。"
        },
        {
          "role": "？？？",
          "text": "加福尔师兄，嗯…现在应该是加福尔老师了吧，我们明明是老熟人，何必一个劲地兜圈子呢？"
        },
        {
          "role": "？？？",
          "text": "又是叙旧，又是咖啡的，你有什么想说的就直说吧。"
        },
        {
          "role": "派蒙",
          "text": "那个人就是我们要找的加福尔吧，不过他好像正忙着和别人说话，要不我们先等一等。"
        },
        {
          "role": "加福尔",
          "text": "其实也没有什么特别的事情，自从你离开教令院之后，我们当初的项目和计划就没了主心骨。"
        },
        {
          "role": "加福尔",
          "text": "居勒什老师也很失望，他一直很看重你这个得意弟子。"
        },
        {
          "role": "加福尔",
          "text": "丽莎，你离开教令院，实在是件非常可惜的事情。"
        },
        {
          "role": "加福尔",
          "text": "以你的聪明才智，如果当初留在教令院的话，现在都能拿下诃般荼的位置了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（是丽莎！）",
              "dialogues": []
            },
            {
              "text": "（丽莎怎么会出现在这里？）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我没听错吧，那不是西风骑士团的图书管理员丽莎小姐吗？"
        },
        {
          "role": "派蒙",
          "text": "我听说，丽莎好像曾经在须弥教令院学习过，不过那都是过去的事了，现在丽莎到这里是要做什么呢？"
        },
        {
          "role": "丽莎",
          "text": "我猜得没错的话，你是想旧话重提，拉我回来？"
        },
        {
          "role": "加福尔",
          "text": "呵呵，我听说你现在是在蒙德的西风骑士团里担任图书管理员？要我说，真的是屈才了。"
        },
        {
          "role": "加福尔",
          "text": "何必浪费自己的时间，去为保管图书这种小事劳心费神呢，你的时间明明是最宝贵的东西。"
        },
        {
          "role": "加福尔",
          "text": "只要你肯回到学院来，立刻就能有大把项目供你主持，现在正是学院需要用人的时候，有些重要项目…"
        },
        {
          "role": "丽莎",
          "text": "哈…所以说来说去，还是想拉我回去咯，居勒什老师应该不知道你这么做吧。"
        },
        {
          "role": "加福尔",
          "text": "实际上，恩师他早就有心叫你回来参与院内的工作了。"
        },
        {
          "role": "丽莎",
          "text": "…哦是吗？加福尔老师，欺骗他人可不是好做法哦。"
        },
        {
          "role": "丽莎",
          "text": "我为什么只在学院里待了两年就离开了，老师他是最清楚的，所以他绝对不会提出这种要求。"
        },
        {
          "role": "丽莎",
          "text": "放弃蒙德的生活，以素论派学者的身份重回教令院么…求取智慧所需要的代价我自己已经再也支付不起了。"
        },
        {
          "role": "丽莎",
          "text": "所以啊，就别再挖空心思拉我回去了。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，原来丽莎曾经是素论派的学者吗？从来都没听她本人提过啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "小点声。",
              "dialogues": []
            },
            {
              "text": "嘘，派蒙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "而且保管图书可是很重要的工作，我从不觉得那是浪费时间。"
        },
        {
          "role": "丽莎",
          "text": "「智慧蕴藏在世界的每个角落，绝不可轻视点滴中的智慧」，这可是老师常挂在嘴边的话。"
        },
        {
          "role": "丽莎",
          "text": "优秀的学者是不会忽视细节的，加福尔师兄，果然还是叫你师兄更习惯，你刚才的说辞在细节上犯了错误。"
        },
        {
          "role": "丽莎",
          "text": "而且还有个细节你也没有注意到，此刻，有两个人正在偷听我们说话，已经半天了呢。"
        },
        {
          "role": "加福尔",
          "text": "……"
        },
        {
          "role": "丽莎",
          "text": "两位，找我们有什么事吗？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，你好丽莎。"
        },
        {
          "role": "旅行者",
          "text": "好久不见，丽莎。"
        },
        {
          "role": "丽莎",
          "text": "我就说嘛，果然是你们两个呀。"
        },
        {
          "role": "丽莎",
          "text": "好久不见哟，小可爱，派蒙。"
        },
        {
          "role": "加福尔",
          "text": "…两位有什么事情吗？"
        },
        {
          "role": "派蒙",
          "text": "啊那个，其实我们是来应征参与悉多…呃…悉般多摩学院的地脉调研项目的，刚在阿芬迪先生那里登记过。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "正巧遇到了丽莎。",
              "dialogues": []
            },
            {
              "text": "不想打扰你们说话。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "地脉调研项目？难道小可爱你们进入了教令院？"
        },
        {
          "role": "旅行者",
          "text": "只是担任项目志愿者。"
        },
        {
          "role": "派蒙",
          "text": "对，听联络员阿芬迪先生说，有个学术项目正在有偿招募志愿者，我们这才过来找加福尔先生了解情况。"
        },
        {
          "role": "丽莎",
          "text": "有偿招募志愿者？加福尔师兄，学院内部这么缺人吗？还是你们有什么非要外人来做不可的计划…"
        },
        {
          "role": "加福尔",
          "text": "没有没有，这只是出于常规地脉监测需求才有的项目，一切操作都符合安全标准。"
        },
        {
          "role": "加福尔",
          "text": "投入大量人力去收集地脉数据，我们也是不得已…要是你肯回来帮忙主持一些事务，就不用搞这么麻烦了。"
        },
        {
          "role": "丽莎",
          "text": "我没记错的话，收集地脉数据是需要调查人员深入秘境的，危险性不小。"
        },
        {
          "role": "派蒙",
          "text": "在离开蒙德之后，旅行者和我经历了不少战斗，探索秘境这种小事不算什么啦。"
        },
        {
          "role": "丽莎",
          "text": "这么久不见，你们好像又经历了不少有趣的事。"
        },
        {
          "role": "派蒙",
          "text": "是呀，所以丽莎不用担心。"
        },
        {
          "role": "加福尔",
          "text": "既然两位是来应征参与项目的，那就请稍等一下，等到我和丽莎谈完事情…"
        },
        {
          "role": "丽莎",
          "text": "加福尔师兄，抱歉，我是不会答应你的。"
        },
        {
          "role": "加福尔",
          "text": "真的一点转圜余地都没有吗？"
        },
        {
          "role": "丽莎",
          "text": "当初执意告别教令院，这个决定我至今没有后悔，将来的话…想必也不会后悔。"
        },
        {
          "role": "加福尔",
          "text": "本来以为过了这么久再和你聊，会得到不一样的答复，唉，丽莎你还是跟以前一样固执。"
        },
        {
          "role": "加福尔",
          "text": "你都说到这份上了，再强行游说就是我自讨没趣了。"
        },
        {
          "role": "加福尔",
          "text": "既然这样，我也有不少没处理完的事务，就不再打扰了，几天之后的学院聚会再见吧。"
        },
        {
          "role": "丽莎",
          "text": "嗯，放心吧师兄，学院聚会我会准时到场的。"
        },
        {
          "role": "加福尔",
          "text": "至于两位志愿者，稍后你们有空的时候，请来无郁稠林找我，还有志愿者的工作需要你们协助。"
        },
        {
          "role": "加福尔",
          "text": "对了还有最后一件事，丽莎…"
        },
        {
          "role": "丽莎",
          "text": "怎么了，师兄？"
        },
        {
          "role": "加福尔",
          "text": "祝你在蒙德顺利。"
        },
        {
          "role": "丽莎",
          "text": "…我会的。"
        },
        {
          "role": "丽莎",
          "text": "好了，小可爱，派蒙，说客已经离开了，我们可以好好坐下来聊聊了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说客？",
              "dialogues": []
            },
            {
              "text": "是指加福尔吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "呵呵，教令院内部似乎发生了什么不得了的事，我的这位师兄啊，正在为他自己的前程奔走呢。"
        },
        {
          "role": "派蒙",
          "text": "对了，丽莎怎么会来到须弥呢？骑士团那里没关系吗？"
        },
        {
          "role": "丽莎",
          "text": "当然是因为琴给我放了一个带薪长假，既然是难得的假期，为什么不去旅行一番，放松心情呢？"
        },
        {
          "role": "丽莎",
          "text": "不知道你们听说过没有，我曾经在须弥教令院的悉般多摩学院进修过两年。"
        },
        {
          "role": "丽莎",
          "text": "不过毕业之后我没有留在教令院，而是直接回到了蒙德，成为了骑士团的图书管理员。"
        },
        {
          "role": "派蒙",
          "text": "所以丽莎才会到须弥来吧，这样既可以四处游玩，又能看望以前的朋友和老师。"
        },
        {
          "role": "旅行者",
          "text": "丽莎为什么会离开教令院呢？"
        },
        {
          "role": "丽莎",
          "text": "你们很好奇吗？嗯…告诉你们应该也没关系吧，毕竟那都是很久之前的事了。"
        },
        {
          "role": "丽莎",
          "text": "非要说的话，只能归结为理念不合吧。"
        },
        {
          "role": "丽莎",
          "text": "当初在教令院的时候，居勒什老师非常赏识我，邀我参与了许多教令院的核心项目。"
        },
        {
          "role": "丽莎",
          "text": "不过后来，其中的大部分项目都失败了。说实话，为了获得超人的智慧，他们走得太远了，失败也是自然。"
        },
        {
          "role": "丽莎",
          "text": "我不想再参与这种疯狂的事情，就选择了离开。好了，现在你们都知道了，要记得为我保密哦。"
        },
        {
          "role": "派蒙",
          "text": "唔…听起来发生过不少事。"
        },
        {
          "role": "丽莎",
          "text": "所以就算是居勒什老师亲自来游说，我也是不会再回教令院去的。"
        },
        {
          "role": "丽莎",
          "text": "比起没日没夜地做实验，还是早晨十点之后再工作，每天有固定下午茶的生活更适合我。"
        },
        {
          "role": "派蒙",
          "text": "我就知道，其实丽莎是讨厌麻烦才选择做图书管理员的吧。"
        },
        {
          "role": "旅行者",
          "text": "是丽莎的风格。"
        },
        {
          "role": "丽莎",
          "text": "工作那么麻烦的事，还是要悠哉一点才好，而且定期休假可是很重要的。"
        },
        {
          "role": "丽莎",
          "text": "唉，可惜刚到须弥没多久，还没来得及到化城郭去看望那个孩子{{黑幕|柯莱}}，就被加福尔师兄找到了。"
        },
        {
          "role": "丽莎",
          "text": "说了这么半天，你们呢？小可爱和派蒙又是为什么来到须弥的呢？"
        },
        {
          "type": "subtitle",
          "text": "和丽莎讲述了来到须弥后的见闻。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "已完成须弥魔神任务",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "这样啊…原来他们竟然执着到了这个地步，甚至想要超越神明…"
                },
                {
                  "role": "丽莎",
                  "text": "看来，在我不知道的时候，你们又被卷入了不得了的事里。"
                },
                {
                  "role": "丽莎",
                  "text": "但就算是这种程度的危机，最后也还是被你们顺利解决了，小可爱，你的能力还真是不可估量。"
                },
                {
                  "role": "丽莎",
                  "text": "完成了这样的壮举，现在的你应该有许多后事要处理吧，原本我还想邀你们一起在须弥四处逛逛…"
                }
              ]
            },
            {
              "text": "未完成须弥魔神任务",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "这样啊…你们原本是打算向智慧之神小吉祥草王打听情报，才会来到须弥的。"
                },
                {
                  "role": "丽莎",
                  "text": "比起我这个游客，你们的事似乎紧迫得多呢。"
                },
                {
                  "role": "丽莎",
                  "text": "原本我还想一起在须弥四处逛逛，这样看来，好像现在并不是合适的时机。"
                }
              ]
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "真是遗憾啊，明明是好不容易遇到的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也不是完全没空。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "哦？小可爱你其实也很想和我一道四处散心吗？那可太好了。"
                }
              ]
            },
            {
              "text": "以后再一起转转吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "接下来的几天我打算在须弥城内观光，最后再从化城郭那里取道璃月返回蒙德。"
        },
        {
          "role": "丽莎",
          "text": "说不定你不经意间，就会在须弥城或是化城郭遇到我哟。"
        },
        {
          "role": "丽莎",
          "text": "嗯，这么想想，不期中的偶然邂逅的确有种浪漫的情调，很符合旅行的氛围。"
        },
        {
          "role": "丽莎",
          "text": "遇到我的话，记得要打个招呼，不然姐姐我会寂寞的，呵呵。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "丽莎",
          "text": "我记得，刚才你们和加福尔师兄约定好了，要去无郁稠林和他接洽地脉调研工作。"
        },
        {
          "role": "丽莎",
          "text": "你们要是这就打算去找他可以先离开哦。至于我，应该还会在普斯帕咖啡馆里坐一会儿吧。"
        },
        {
          "role": "丽莎内心",
          "text": "（现在的小可爱还真是变得不得了了，以后又会成长到什么程度呢？）"
        },
        {
          "type": "subtitle",
          "text": "前往无郁稠林"
        },
        {
          "type": "subtitle",
          "text": "额外对话（加福尔内心）"
        },
        {
          "role": "加福尔",
          "text": "（这么好的机会不知道珍惜，这家伙真让人搞不懂。）"
        },
        {
          "role": "加福尔",
          "text": "你们来了啊，看样子是已经做好准备了？"
        },
        {
          "role": "旅行者",
          "text": "是的。"
        },
        {
          "role": "加福尔",
          "text": "很好，那么我先来说明一下吧。"
        },
        {
          "role": "加福尔",
          "text": "我们悉般多摩学院长期与地脉打交道，需要时刻监测地脉涌流情况，这次的调研项目也是出于这个需求设立的。"
        },
        {
          "role": "加福尔",
          "text": "由于须弥境内的秘境中时常出现地脉的异常涌流，所以我们不得不定期派人深入各处秘境记录地脉情况。"
        },
        {
          "role": "加福尔",
          "text": "因为秘境内部的情况往往比较危险，所以我们设立的原则是「只派遣具有战斗能力的人员」。"
        },
        {
          "role": "加福尔",
          "text": "你们需要做的就是进入秘境深处，记录地脉的异常情况。注意，如果遇到危险情况，请优先保护好自己。"
        },
        {
          "role": "加福尔",
          "text": "好，我的说明就是这些了。准备好的话，你们就可以进入秘境了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话"
        },
        {
          "role": "加福尔",
          "text": "倒是多派点人手啊，就这么点人根本处理不过来。算了，能处理多少是多少吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于丽莎…",
              "dialogues": [
                {
                  "role": "加福尔",
                  "text": "所以你们是在蒙德和丽莎认识的？她真的普普通通地在当图书管理员？"
                },
                {
                  "role": "旅行者",
                  "text": "是的，有什么问题？"
                },
                {
                  "role": "加福尔",
                  "text": "真是没想到，蒙德有什么吸引她的，值得这样浪费自己的才华。"
                },
                {
                  "role": "加福尔",
                  "text": "…好吧，我知道你是丽莎的朋友，我不会再找她说那件事了，你就别瞪我了。"
                },
                {
                  "role": "加福尔",
                  "text": "我也是好心给她提供机会，她不愿意就算了。"
                }
              ]
            },
            {
              "text": "关于素论派…",
              "dialogues": [
                {
                  "role": "加福尔",
                  "text": "是啊，我们学院需要定期监测地脉运行情况，这是学院的研究基础之一。"
                },
                {
                  "role": "加福尔",
                  "text": "又有专业素养，又能独立承担秘境内地脉探索工作的人才实在不够，早就说了要多拨点人过来…"
                },
                {
                  "role": "加福尔",
                  "text": "找不到专业学者过来，我也只能招募志愿者了，唉。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "加福尔",
                  "text": "这处秘境的探索清理工作就交给你了。"
                }
              ]
            }
          ]
        },
        {
          "role": "加福尔内心",
          "text": "（千万别受伤，不然还得付补偿金…我不想拿自己存的钱垫付啊。）"
        },
        {
          "type": "subtitle",
          "text": "第二天到第七天丽莎对话彩蛋"
        },
        {
          "type": "subtitle",
          "text": "丽莎第二天{{黑幕|2月1号}}在兰巴德酒馆二楼",
          "narration": true
        },
        {
          "role": "丽莎",
          "text": "小可爱，我们果然遇到了呢。"
        },
        {
          "role": "旅行者",
          "text": "这里不太好找。"
        },
        {
          "role": "丽莎",
          "text": "欸，有吗？不过须弥城毕竟是我曾经生活过的地方，故地重游，忍不住就想去各种偏僻的小店看看。"
        },
        {
          "role": "丽莎",
          "text": "让人遗憾的是，有家我以前常去的成衣店居然已经倒闭很久了。"
        },
        {
          "role": "丽莎",
          "text": "我本来还想多买些饰品和衣服，送给骑士团里的女孩子们的，嗯…有点可惜啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "丽莎买了新衣服。",
              "dialogues": []
            },
            {
              "text": "丽莎的新衣服很漂亮。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "我还在想小可爱什么时候才会注意到这件新衣服呢，怎么样，你觉得好看吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很显气质。",
              "dialogues": []
            },
            {
              "text": "风格优雅。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "从别人嘴里听到称赞的话，果然让人开心，谢谢你哦，小可爱。"
        },
        {
          "role": "丽莎",
          "text": "这件衣服是我找到了那家成衣店的店主，请她特别定制的。"
        },
        {
          "role": "丽莎",
          "text": "穿上就想起了以前在教令院的时光，那时候可真是忙碌呀…"
        },
        {
          "role": "丽莎",
          "text": "不过我手下的研究人员也从来不敢偷懒，不像某些借书不还的家伙，只用雷元素力来惩罚他们是不是太宽容了呢…"
        },
        {
          "type": "subtitle",
          "text": "丽莎第三天{{黑幕|2月2号}}在梅娜卡里商铺",
          "narration": true
        },
        {
          "role": "丽莎",
          "text": "小可爱，我们又遇到了呀。"
        },
        {
          "role": "旅行者",
          "text": "丽莎在看什么？"
        },
        {
          "role": "丽莎",
          "text": "这家店的彩绘器皿做得非常精致，买几个放回去做装饰应该不错。"
        },
        {
          "role": "丽莎",
          "text": "还有那几个盘子，如果用它们来盛装茶点，就算是在工作的琴应该也会被吸引吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这些好像都不出售。",
              "dialogues": []
            },
            {
              "text": "只是展示用的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "不出售吗？哎呀，真是的，既然不出售，干嘛放在店里呢。"
        },
        {
          "role": "丽莎",
          "text": "真让人失望，明明都这么漂亮…"
        },
        {
          "type": "subtitle",
          "text": "丽莎第四天{{黑幕|2月3号}}在大巴扎毛毯店",
          "narration": true
        },
        {
          "role": "丽莎",
          "text": "小可爱，你也是来大巴扎看演出的吗？"
        },
        {
          "role": "旅行者",
          "text": "丽莎喜欢吗？"
        },
        {
          "role": "丽莎",
          "text": "嗯，这里的演出节目挺有趣的。我甚至在想，要不要把某些节目的形式记下来，下次羽球节或许用得上。"
        },
        {
          "role": "丽莎",
          "text": "说笑话之类的还好办，可以让凯亚来，但是跳舞的话，有点困难呢。"
        },
        {
          "role": "旅行者",
          "text": "丽莎看过这里的舞蹈吗？"
        },
        {
          "role": "丽莎",
          "text": "昨天有个可爱的红头发女孩子{{黑幕|妮露}}跳了一场舞，我就在前排哦，真是漂亮呀。"
        },
        {
          "role": "丽莎",
          "text": "忍不住就想，要是能在蒙德看同样的舞蹈就好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "得说服妮露去蒙德演出。",
              "dialogues": []
            },
            {
              "text": "那有点困难。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "其实我觉得难点在于，怎么让游击小队队长优莅对须弥舞蹈产生兴趣，而且还得找到既美丽又能让她接受的服装。"
        },
        {
          "role": "旅行者",
          "text": "居然在打优菈的主意吗？"
        },
        {
          "role": "丽莎",
          "text": "优拉在有的方面意外地单纯，比起请演员去蒙德，我觉得诱骗…啊不，「请」她跳舞要容易得多。"
        },
        {
          "type": "subtitle",
          "text": "丽莎第五天{{黑幕|2月4号}}在教令院传送锚点往下走{{黑幕|艾尔海森家门口}}",
          "narration": true
        },
        {
          "role": "丽莎",
          "text": "咦，怎么在教令院附近见到你了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "丽莎不进教令院吗？",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "其实我刚从大门出来不久。"
                }
              ]
            },
            {
              "text": "丽莎刚离开教令院吗？",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "是呀，刚走到这里就遇到你了。"
                }
              ]
            }
          ]
        },
        {
          "role": "丽莎",
          "text": "居勒什老师还有几位师兄，以前共事过的另外几位研究员，大家聚在一起又见了一次。"
        },
        {
          "role": "丽莎",
          "text": "时间过得真快啊，看大家的样子能感觉到他们都忙得不得了呢。"
        },
        {
          "role": "丽莎",
          "text": "我的确是松散了一点。呵呵…他们一定很羡慕吧。"
        },
        {
          "role": "丽莎",
          "text": "话虽这么说，下个月还是少吃点蛋糕吧，得提防长胖呢。"
        },
        {
          "type": "subtitle",
          "text": "丽莎第六天{{黑幕|2月5号}}在化城郭",
          "narration": true
        },
        {
          "role": "丽莎",
          "text": "是叫作萨古吗，好乖巧的小狗。"
        },
        {
          "role": "旅行者",
          "text": "丽莎喜欢搜救犬吗？"
        },
        {
          "role": "丽莎",
          "text": "听话的小狗我当然喜欢，特别是那种会露出肚皮给你抚摸，用湿漉漉的眼睛看着你的小狗。"
        },
        {
          "role": "丽莎",
          "text": "其实我一直想养一条狗，它不仅能够用可爱治愈我一天的心情，有时还能起到震慑作用。"
        },
        {
          "role": "丽莎",
          "text": "不过养狗的话，要定期给它梳理毛发，清扫粪便，未免太麻烦了。"
        },
        {
          "role": "丽莎",
          "text": "养宠物就是这点麻烦，我果然不适合养宠物。"
        },
        {
          "type": "subtitle",
          "text": "彩蛋对话（阿米尔）"
        },
        {
          "role": "旅行者",
          "text": "关于你身旁的女士…"
        },
        {
          "role": "阿米尔",
          "text": "哎呀，你小点声。你是说那位女士的名字是丽莎吗？"
        },
        {
          "role": "阿米尔",
          "text": "丽莎…丽莎，真是美丽又优雅的名字。"
        },
        {
          "role": "阿米尔",
          "text": "可惜你没看到，刚才她和我说话了，问了萨古的名字，嘿嘿…"
        },
        {
          "role": "阿米尔",
          "text": "看样子，她也是对动物怀有爱心的人。不过，她好像不太懂得该怎么跟动物打交道。"
        },
        {
          "role": "阿米尔",
          "text": "这点从她刚才抚摸萨古的样子就看得出来，不过没关系，我可以教她。"
        },
        {
          "role": "阿米尔",
          "text": "我们可以一起养很多条狗，一起…"
        },
        {
          "role": "阿米尔",
          "text": "……"
        },
        {
          "role": "阿米尔",
          "text": "（沉浸在幻想中自言自语）"
        },
        {
          "type": "subtitle",
          "text": "丽莎第七天{{黑幕|2月6号}}在化城郭柯莱小屋旁边",
          "narration": true
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "已完成须弥魔神任务",
              "dialogues": [
                {
                  "role": "柯莱",
                  "text": "放心吧，丽莎小姐，我现在很好。"
                },
                {
                  "role": "旅行者",
                  "text": "你们好。"
                },
                {
                  "role": "柯莱",
                  "text": "是旅行者！你怎么来这儿啦。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "来看看柯莱。",
                      "dialogues": []
                    },
                    {
                      "text": "居然又遇到了丽莎。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "丽莎",
                  "text": "小可爱经常来探望小柯莱吗？"
                },
                {
                  "role": "柯莱",
                  "text": "旅行者他非常热心，之前在化城郭帮了我们不少忙呢。"
                },
                {
                  "role": "旅行者",
                  "text": "我和柯莱是很好的朋友。"
                },
                {
                  "role": "丽莎",
                  "text": "看样子，小柯菜在须弥认识了不少新朋友呢。"
                },
                {
                  "role": "柯莱",
                  "text": "而且我也有努力认字，现在我已经能读一些简单的句子了！"
                },
                {
                  "role": "柯莱",
                  "text": "师父和须弥的大家都很关照我，不过我从来没有忘记蒙德的朋友们，最近我一直想找个时间回去探望一次。"
                },
                {
                  "role": "柯莱",
                  "text": "丽莎小姐，大家怎么样？都还好吗？安柏好吗？凯亚先生好吗？琴小姐…"
                },
                {
                  "role": "丽莎",
                  "text": "哈哈，小柯菜不要着急哦，等我慢慢跟你说…"
                },
                {
                  "role": "丽莎",
                  "text": "抱歉，小可爱，给我一点时间，让我和小柯莱好好说说蒙德的事吧。"
                }
              ]
            },
            {
              "text": "未完成须弥魔神任务",
              "dialogues": [
                {
                  "role": "柯莱",
                  "text": "放心吧，丽莎小姐，我现在很好。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你们好。",
                      "dialogues": []
                    },
                    {
                      "text": "居然又遇到了丽莎。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "丽莎",
                  "text": "我来这里是想探望一位以前的朋友，但没想到她已经在这里当上了见习巡林员呀。"
                },
                {
                  "role": "柯莱",
                  "text": "嘿嘿，这其实没什么，我只是想帮上提纳里师父的忙。"
                },
                {
                  "role": "丽莎",
                  "text": "看样子，小柯菜在须弥认识了不少新朋友呢。"
                },
                {
                  "role": "柯莱",
                  "text": "而且我也有努力认字，现在我已经能读一些简单的句子了！"
                },
                {
                  "role": "柯莱",
                  "text": "师父和须弥的大家都很关照我，不过我从来没有忘记蒙德的朋友们，最近我一直想找个时间回去探望一次。"
                },
                {
                  "role": "柯莱",
                  "text": "丽莎小姐，大家怎么样？都还好吗？安柏好吗？琴小姐好吗？凯亚先生…"
                },
                {
                  "role": "丽莎",
                  "text": "哈哈，小柯菜不要着急哦，等我慢慢跟你说…"
                },
                {
                  "role": "丽莎",
                  "text": "抱歉，小可爱，给我一点时间，让我和小柯莱好好说说蒙德的事吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（柯莱内心）"
        },
        {
          "role": "柯莱",
          "text": "（呜…安柏怎么没有来…哎呀我该怎么跟丽莎小姐问安柏的事，啊我好混乱。）"
        }
      ],
      "collapse_ranges": [
