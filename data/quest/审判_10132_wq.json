{
  "quest_id": 10132,
  "chapter_num": "山中好长日·第三章",
  "chapter_title": "审判",
  "type": "wq",
  "route": "Judgment",
  "stories": [
    {
      "story_id": 76096,
      "title": "最后的审判",
      "description": "总算从无想之间回到了柱殿…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往柱殿中心"
        },
        {
          "type": "subtitle",
          "text": "与伊斯托利亚对话"
        },
        {
          "role": "伊斯托利亚",
          "text": "琳德，我不能让你就这样回到人间。"
        },
        {
          "role": "伊斯托利亚",
          "text": "但是我又一次因为懦弱没有开口。"
        },
        {
          "role": "伊斯托利亚",
          "text": "我知道，你这样回到尘世里，会做出什么样的选择。"
        },
        {
          "role": "彩特琳德",
          "text": "需要告别的事物都已经告别完了。只是这样而已。"
        },
        {
          "role": "派蒙",
          "text": "你们，你们在说什么啊…我怎么听不懂。"
        },
        {
          "role": "派蒙",
          "text": "我们不是在讨论怎么具现出通天之路，然后去教训梅兰塔吗？"
        },
        {
          "role": "伊斯托利亚",
          "text": "上一个，为了我们所有人去面见了梅兰塔…"
        },
        {
          "role": "伊斯托利亚",
          "text": "献出了自己所有记忆的人，正是琳德的姐姐劳姆希尔妲。"
        },
        {
          "role": "彩特琳德",
          "text": "什么？！"
        },
        {
          "role": "伊斯托利亚",
          "text": "那时候，梅兰塔的疯狂已经初现端倪。他惩罚了许多人。"
        },
        {
          "role": "伊斯托利亚",
          "text": "毕竟我们并不是机械，寿命又长得没有尽头。忘却的总归会回来。"
        },
        {
          "role": "伊斯托利亚",
          "text": "她听说了梅兰塔愈发不讲道理的暴政，见到了被谪罚的大方广众人。"
        },
        {
          "role": "伊斯托利亚",
          "text": "我告诉她，把这里的一切当成是并不愉快的天堂一瞥就好了。"
        },
        {
          "role": "伊斯托利亚",
          "text": "不必为此生气，不必为此悲伤。她既然也是被尼西里塔送上来的，小右可以送她回去。"
        },
        {
          "role": "彩特琳德",
          "text": "就这样原模原样回去了又能如何？"
        },
        {
          "role": "伊斯托利亚",
          "text": "她也是这么说的。哈哈，你们真像啊。"
        },
        {
          "role": "彩特琳德",
          "text": "听过很多次了。"
        },
        {
          "role": "伊斯托利亚",
          "text": "但是她开朗健谈，你则内敛沉稳。"
        },
        {
          "role": "彩特琳德",
          "text": "很多人也会这么说。"
        },
        {
          "role": "派蒙",
          "text": "等等，你之前说过吧。现在空之神殿的神明不在，通天之路不会用过一次就消散。"
        },
        {
          "role": "派蒙",
          "text": "所以我们是走彩特琳德姐姐留下来的路上去吗？"
        },
        {
          "role": "伊斯托利亚",
          "text": "如果是这样，我的作战会议指导意见就是：「冲上去，狠狠揍他」了。"
        },
        {
          "role": "伊斯托利亚",
          "text": "不知道梅兰塔与希尔妲说了什么。在那之后愤怒的梅兰塔斩断了你姐姐回忆留下的通天之路。"
        },
        {
          "role": "伊斯托利亚",
          "text": "而希尔妲也已经离开了这里。"
        },
        {
          "role": "派蒙",
          "text": "那岂不是说，我们现在还得有人献出所有的记忆才能上去了？"
        },
        {
          "role": "派蒙",
          "text": "对了，如果靠小右呢？"
        },
        {
          "role": "派蒙",
          "text": "它不是和那个坏东西一个物种吗？既然梅兰塔可以来往上下，小右努力一下也可以吧？"
        },
        {
          "role": "伊斯托利亚",
          "text": "隔绝最高处「非有非无有之殿」与空无边殿的空间被叫做「无所有廊」..."
        },
        {
          "role": "伊斯托利亚",
          "text": "「无所有廊」的力量源自神殿本身。它是离去的规则，守望们则是维持的规则。"
        },
        {
          "role": "伊斯托利亚",
          "text": "小右只是守望者幼体，对此并无支配力。"
        },
        {
          "role": "派蒙",
          "text": "那怎么办啊？"
        },
        {
          "role": "伊斯托利亚",
          "text": "我来献出自己的记忆。"
        },
        {
          "role": "派蒙",
          "text": "伊斯托利亚，可是你…"
        },
        {
          "role": "伊斯托利亚",
          "text": "我说过，这是因为我的怯懦。因为我知晓的真实，那些历史与知识，太过沉重。"
        },
        {
          "role": "伊斯托利亚",
          "text": "我犹豫了。这一点被希尔妲看了出来。"
        },
        {
          "role": "彩特琳德",
          "text": "比起你，一个普通人痛苦的一生确实是微不足道的代价了。"
        },
        {
          "role": "派蒙",
          "text": "不行不行。伊斯托利亚，大家都说你是人类中的瑰宝。还是换个人吧。"
        },
        {
          "role": "派蒙",
          "text": "但是我和旅行者，唔，还有很重要的事情要去做。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不对哦，派蒙。所有人都是平等的。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "责任重大不是牺牲他人的理由。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "去问其他人愿不愿意放弃经历的一切，确实也有点…"
        },
        {
          "role": "彩特琳德",
          "text": "让我来吧。"
        },
        {
          "role": "派蒙",
          "text": "彩特琳德！"
        },
        {
          "role": "伊斯托利亚",
          "text": "你又说了和你姐姐一样的话，但是这一次我绝对不会同意了。"
        },
        {
          "role": "伊斯托利亚",
          "text": "如今你在这里体会了纵观古今的历史，还见识到了世界所有的不可思议。"
        },
        {
          "role": "伊斯托利亚",
          "text": "难道这一切，都不能唤起你对这个世界的一丝丝留念吗？"
        },
        {
          "role": "伊斯托利亚",
          "text": "如今我想到那个问题的答案了。哲学的根本问题是明天要不要自杀。"
        },
        {
          "role": "彩特琳德",
          "text": "……"
        },
        {
          "role": "伊斯托利亚",
          "text": "你看，你犹豫了。哪怕一秒的犹豫都说明这个问题有答案：明天值得活下去。"
        },
        {
          "role": "彩特琳德",
          "text": "不，伊斯托利亚。智慧如你，也弄错了两件事。"
        },
        {
          "role": "伊斯托利亚",
          "text": "请你论述。"
        },
        {
          "role": "彩特琳德",
          "text": "尼西里塔为什么选择姐姐？"
        },
        {
          "role": "彩特琳德",
          "text": "以及我真的只是因为巧合，才被送上来了吗？"
        },
        {
          "role": "伊斯托利亚",
          "text": "你的姐姐说过，她真的只是因为巧合。"
        },
        {
          "role": "伊斯托利亚",
          "text": "疗养院宣布关闭，但还没动迁的时候，她在午夜散步。结果遇到了尼西里塔。"
        },
        {
          "role": "彩特琳德",
          "text": "才不是巧合。你听着：因为，拯救自己就是拯救世界。"
        },
        {
          "role": "伊斯托利亚",
          "text": "这…"
        },
        {
          "role": "彩特琳德",
          "text": "如果姐姐不忘记一切，她一定会自杀。"
        },
        {
          "role": "彩特琳德",
          "text": "我现在明白为什么敢肯定我的姐姐一定还活着了。一段重新开始的人生，想必充满了希望吧。"
        },
        {
          "role": "彩特琳德",
          "text": "我在唐泽荣一{{#info:[[万国诸卷拾遗/枫丹#表彰状]]}}的小说里看到过这么一段话："
        },
        {
          "role": "彩特琳德",
          "text": "「救世主在黑暗的世界里牺牲自己，自愿被钉缚于十字上。因此他的灵魂才得以获救，升入光的王国。」"
        },
        {
          "role": "彩特琳德",
          "text": "这太酷了不是吗？治疗了自己的忧郁，还拯救了世界。"
        },
        {
          "role": "彩特琳德",
          "text": "这个机会我是不会让给你的。"
        },
        {
          "role": "伊斯托利亚",
          "text": "啊…"
        },
        {
          "role": "伊斯托利亚",
          "text": "我有一瞬间的恍惚，还以为是希尔妲在说这话。但是她应该不会这样说话。"
        },
        {
          "role": "彩特琳德",
          "text": "那当然了。她可不怎么看书，这些话自然没有办法说得像我一样引经据典。"
        },
        {
          "role": "彩特琳德",
          "text": "派蒙和旅行者，你们也不许有意见。"
        },
        {
          "role": "彩特琳德",
          "text": "等我失去记忆回到地上时，还需要你们告诉我：我是谁，我要去往何处。"
        },
        {
          "role": "派蒙",
          "text": "你这话叫我怎么接啊？我们明明才刚认识，就要重新认识一次了。"
        },
        {
          "role": "彩特琳德",
          "text": "「精彩到让人愿意失忆了再看一次的小说」可是最高的评价啊。你们也是这个级别的朋友。"
        },
        {
          "role": "派蒙",
          "text": "别说这种俏皮话了，我会难过的。"
        },
        {
          "role": "彩特琳德",
          "text": "所以伊斯托利亚，请带我们去吧。"
        },
        {
          "role": "派蒙",
          "text": "还有什么别的事情要处理吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "出发吧…",
              "dialogues": [
                {
                  "role": "伊斯托利亚",
                  "text": "唉…"
                }
              ]
            },
            {
              "text": "再等等。",
              "dialogues": [
                {
                  "role": "彩特琳德",
                  "text": "嗯，我等你。等下一起见证吧。"
                },
                {
                  "type": "subtitle",
                  "text": "再次对话",
                  "narration": true,
                  "color": "灰"
                },
                {
                  "role": "彩特琳德",
                  "text": "怎么样？准备好了吗？"
                },
                {
                  "role": "伊斯托利亚",
                  "text": "琳德，你再考虑一下吧。"
                },
                {
                  "role": "彩特琳德",
                  "text": "不了。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "出发吧…",
                      "dialogues": [
                        {
                          "role": "伊斯托利亚",
                          "text": "唉…"
                        }
                      ]
                    },
                    {
                      "text": "再等等。",
                      "dialogues": [
                        {
                          "role": "彩特琳德",
                          "text": "嗯，我等你。等下一起见证吧。"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "构筑登天之阶"
        },
        {
          "type": "subtitle",
          "text": "来到了上层…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "伊斯托利亚",
          "text": "彩特琳德，现在我还能最后劝你一次吗？"
        },
        {
          "role": "彩特琳德",
          "text": "伊斯托利亚先生，你的辩论已经失败了。"
        },
        {
          "role": "彩特琳德",
          "text": "既然下面我姐姐的墓是空着的，你就不担心我就此离开直接躺在里面吗？"
        },
        {
          "role": "伊斯托利亚",
          "text": "好吧。"
        },
        {
          "role": "伊斯托利亚",
          "text": "你姐姐记忆变现出的登天之阶虽然被斩断，但应该还留有一半。"
        },
        {
          "role": "伊斯托利亚",
          "text": "或许这次你的记忆会和希尔妲的记忆混合在一起，呈现出奇特的景象。"
        },
        {
          "role": "派蒙",
          "text": "那是不是彩特琳德还有可能保留一半的记忆？"
        },
        {
          "role": "伊斯托利亚",
          "text": "我上次解释过了，献出所有的记忆和通过无所有廊没有关系。"
        },
        {
          "role": "伊斯托利亚",
          "text": "让你回顾一眼，只是慈悲。"
        },
        {
          "role": "派蒙",
          "text": "是哦，那是不是会看到一些隐私？我们一起去会不会不太方便。"
        },
        {
          "role": "彩特琳德",
          "text": "「向你献上远在你出生前多年的一个傍晚看到的一朵黄玫瑰的记忆。」"
        },
        {
          "role": "彩特琳德",
          "text": "「向你献出我对于你的诠释，与你有关的一切理论，以及关于你的真实而奇异的消息。」<ref>阿根廷诗人豪尔赫·路易斯·博尔赫斯《我用什么才能留住你》（What Can I Hold You with?）</ref>"
        },
        {
          "role": "彩特琳德",
          "text": "你们还需要回答关于我的一切问题呢。"
        },
        {
          "role": "彩特琳德",
          "text": "请随意看吧。这是重新塑造一个真实的我不可或缺的部分。"
        },
        {
          "role": "彩特琳德",
          "text": "如果是我姐姐的隐私我们一起看。居然忘记了我这个妹妹一个人环游世界去了。"
        },
        {
          "role": "派蒙",
          "text": "你这话听起来完全是真的坏心眼，不像是逞强。"
        },
        {
          "role": "派蒙",
          "text": "而且突然彩特琳德的话就多起来了。"
        },
        {
          "role": "彩特琳德",
          "text": "是吗？"
        },
        {
          "role": "彩特琳德",
          "text": "伊斯托利亚，我们就在这里构筑无所有廊的登天之阶吗？"
        },
        {
          "role": "伊斯托利亚",
          "text": "是的。"
        },
        {
          "role": "彩特琳德",
          "text": "那就开始吧。"
        },
        {
          "type": "subtitle",
          "text": "探索无所有廊"
        },
        {
          "type": "subtitle",
          "text": "来到了无所有廊…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "呜啊，这里就是无所有廊吗？"
        },
        {
          "role": "派蒙",
          "text": "无论怎么样，先前进看看吧。"
        },
        {
          "type": "subtitle",
          "text": "击破木箱",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "彩特琳德",
          "text": "我还以为是一段乏味的长廊呢。"
        },
        {
          "role": "彩特琳德",
          "text": "设计这个的神可真是个好人啊。"
        },
        {
          "role": "派蒙",
          "text": "首先排除是抓走旅行者的神。"
        },
        {
          "type": "subtitle",
          "text": "使用「复原核心」复原折叠的空间",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "那里好像有什么东西。"
        },
        {
          "type": "subtitle",
          "text": "调查书堆"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调查",
              "dialogues": []
            }
          ]
        },
        {
          "role": "彩特琳德",
          "text": "这是，姐姐的笔迹。"
        },
        {
          "role": "派蒙",
          "text": "啊，这是之前在下面没有收集到的书信吗？"
        },
        {
          "role": "彩特琳德",
          "text": "不是，只是一些寄语和姐姐写的一首小诗。"
        },
        {
          "role": "彩特琳德",
          "text": "确实不是告别。姐姐应该还活着。"
        },
        {
          "role": "派蒙",
          "text": "这个我们能看吗？"
        },
        {
          "role": "彩特琳德",
          "text": "你们会看到的。"
        },
        {
          "type": "subtitle",
          "text": "继续向前探索"
        },
        {
          "type": "subtitle",
          "text": "进入气流",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "回忆…"
        },
        {
          "type": "subtitle",
          "text": "飘浮文字"
        },
        {
          "type": "subtitle",
          "text": "「踩上城市的屋顶，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "童年时嬉笑跑过的街道和我不再熟悉。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「步入蓝天，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "…风车挥手作别，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "我和最喜欢的面包店渐渐远离。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「异国的花坞，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "被水浸没的夏色。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「归入水中，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "…孩提时幻想的沉船没有宝藏，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "只有蓝色的忧郁。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「奇装异服的枫丹老绅士，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "急匆匆走下了巡轨船…」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「走入了熙攘的人群里。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「玉色群山里，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "吞吐雾气的兽…」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「远离了港集，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "驮兽铃铛的渐稀。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「记不住名字的天空之都」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「风…」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「离群索居的人们啊。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「阵雨落下，",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "水色的柳枝会落下叶子吗？」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「还有…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "镇守之森的妖狸…」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「我明白的，我明白的。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「这世界其实就是如此美丽啊。」",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与彩特琳德对话"
        },
        {
          "role": "彩特琳德",
          "text": "姐姐的诗…"
        },
        {
          "role": "彩特琳德",
          "text": "全是情感，没有一点文学素养。"
        },
        {
          "role": "彩特琳德",
          "text": "不过，也不赖。"
        },
        {
          "role": "派蒙",
          "text": "彩特琳德，你现在还记得我们是谁吗？"
        },
        {
          "role": "彩特琳德",
          "text": "伊斯托利亚说过了，离开这里的时候，我的记忆才会迅速消褪。"
        },
        {
          "role": "彩特琳德",
          "text": "现在我没什么问题。"
        },
        {
          "role": "彩特琳德",
          "text": "刚才看到的，其实全都是小时候姐姐给我读过书时，我们幻想过的外面的世界。"
        },
        {
          "role": "彩特琳德",
          "text": "枫丹高海之下是否真的有沉船宝藏，稻妻的镇守之森里是不是真的有妖怪？"
        },
        {
          "role": "彩特琳德",
          "text": "世界上真的有兰那罗这种神奇的精灵吗？我已经长大，再也看不到他们了吗？"
        },
        {
          "type": "subtitle",
          "text": "完成世界任务「森林书」"
        },
        {
          "role": "派蒙",
          "text": "世界上真的有兰那罗哦！他们以记忆为力量。"
        },
        {
          "role": "彩特琳德",
          "text": "那我也是兰那罗了。"
        },
        {
          "type": "subtitle",
          "text": "未完成世界任务「森林书」"
        },
        {
          "role": "派蒙",
          "text": "更神奇的事物我们都见过，肯定是存在的。"
        },
        {
          "role": "彩特琳德",
          "text": "好想见一见兰那罗啊。"
        },
        {
          "role": "彩特琳德",
          "text": "从此以后，被选拔的人来往空无边殿与这里的通天之塔——"
        },
        {
          "role": "彩特琳德",
          "text": "将永远只是两个女孩子对世界美好的憧憬。"
        },
        {
          "role": "彩特琳德",
          "text": "这也是一种永恒吧。"
        },
        {
          "type": "subtitle",
          "text": "破损的棺椁"
        },
        {
          "role": "破损的棺椁",
          "text": "（悠久的时间洗去了一切痕迹和气息。但是你就是知道，这里曾经沉睡着你最重要的人。）"
        },
        {
          "role": "破损的棺椁",
          "text": "（前进吧。旅行吧。直到你们再度相会。）"
        },
        {
          "type": "subtitle",
          "text": "调查（便签）"
        },
        {
          "type": "subtitle",
          "text": "（用双语写成，上方的语言完全不认识。）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "你们这收押设施还挺精巧，我从内部破解了好多年才逃出来。不用太烦恼，我虽然只是个小说家，但是我游历诸多星球，看了不少悬疑、推理故事。脑子好点也没什么奇怪的。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "如果你们几个看到这张纸条，放心，这个收押容器应该没弄坏。应该。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "被关在里面的日子里，我都无聊到把《少薇郁》的大结局想出来了。不得不说，这件事你们做得太不地道了。虽然宇宙间本无普遍适用的道德和规矩，但是二话不说就把人关起来，有些不讲道理了吧。你们也没让边境管理人员和我接触啊。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "而且我连你们本地的稿费都拿了，现在和我说我非法入境？估计出版社那边（好像叫八重堂来着？）都在发动读者四处找我了。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "不过这么多年了，估计也没人在乎结局了。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "以双语（仙女座星云帝国与本地）留言，可以互印，减少语言歧义。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "进入「非有非无有之殿」"
        },
        {
          "role": "梅兰塔",
          "text": "人子…不，你是！"
        },
        {
          "role": "梅兰塔",
          "text": "我的造主啊，我的造主啊。为何你要选择她/他抛弃了我。"
        },
        {
          "role": "派蒙",
          "text": "它突然生气起来了？"
        },
        {
          "role": "梅兰塔",
          "text": "把他们赶回去。"
        },
        {
          "type": "subtitle",
          "text": "击败守护者"
        },
        {
          "role": "派蒙",
          "text": "只是赶回去？"
        },
        {
          "role": "派蒙",
          "text": "哦对哦，这里死不了人。"
        },
        {
          "role": "彩特琳德",
          "text": "所以姐姐敢来和他讲道理。"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|辖域守护者|2}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|辖域守护者|3}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "找到并击败隐藏的敌人"
        },
        {
          "type": "subtitle",
          "text": "玩法教学"
        },
        {
          "role": "[[文件",
          "text": "教程：切片辖域守护者·隐匿型·1.png|500px|center]]"
        },
        {
          "type": "subtitle",
          "text": "在空之神殿的部分区域，有时会见到这些特殊的隐形守护者。只有发现它们留下的破绽，将它们分别击破，才能脱离这些区域。",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "呜哇，闪得我眼睛都花了…"
        },
        {
          "type": "subtitle",
          "text": "一段时间未找到时"
        },
        {
          "role": "派蒙",
          "text": "…嗯？好像一直在同样的地方打转？"
        },
        {
          "role": "派蒙",
          "text": "居然藏在这里！"
        },
        {
          "role": "派蒙",
          "text": "好像抵达新的区域了。"
        },
        {
          "role": "派蒙",
          "text": "又找到一个！"
        },
        {
          "role": "派蒙",
          "text": "哦，看来又是新的区域。"
        },
        {
          "role": "派蒙",
          "text": "呜哇！好吓人…"
        },
        {
          "role": "派蒙",
          "text": "现在该结束了吧！"
        },
        {
          "type": "subtitle",
          "text": "与守望者对话"
        },
        {
          "role": "梅兰塔",
          "text": "异邦人，既然你并非人之子，我该怎么称呼你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我叫旅行者，以及…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "人之子是什么意思？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梅兰塔",
          "text": "众生之统领所造之始祖、始祖之后代，皆属人子。胎海假人，特蒙恩赦，亦算此类。"
        },
        {
          "role": "梅兰塔",
          "text": "但，你不是。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "神明为什么要抓走我的妹妹/哥哥？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梅兰塔",
          "text": "无法回答，只因为我也无法理解。"
        },
        {
          "role": "梅兰塔",
          "text": "我本以为只是追究僭越之举。但恐怕背后还有其他意义，一如光暗生原人之异端神话。"
        },
        {
          "role": "派蒙",
          "text": "你这家伙为什么变得有问必答了？"
        },
        {
          "role": "梅兰塔",
          "text": "此乃铭刻于我魂体的规则。人子既已奉献一切寻求一解，我当代行造主之职责知无不言。"
        },
        {
          "role": "梅兰塔",
          "text": "人子终将遗忘一切。须臾之解答、永恒之解脱，亦是神明慈仁。"
        },
        {
          "role": "派蒙",
          "text": "那你为什么要这么严苛地对待空无边殿的那些人啊？"
        },
        {
          "role": "梅兰塔",
          "text": "此亦是规则。造主不在、虚无堕天，我必须把持我主之准绳。"
        },
        {
          "role": "梅兰塔",
          "text": "此处仅为保存。任何革新与进化皆是不被许可之物。"
        },
        {
          "role": "彩特琳德",
          "text": "我没记错的话，你叫梅兰塔是吧？"
        },
        {
          "role": "梅兰塔",
          "text": "人子，我知晓你的名字。"
        },
        {
          "role": "梅兰塔",
          "text": "彩特琳德。"
        },
        {
          "role": "彩特琳德",
          "text": "我姐姐是怎么和你介绍我的？"
        },
        {
          "role": "梅兰塔",
          "text": "她说，她与我道理不通，但是有朝一日她的妹妹会来打败我。"
        },
        {
          "role": "彩特琳德",
          "text": "听到了吗？其实你们才是被我卷进来的受害者。"
        },
        {
          "role": "派蒙",
          "text": "呃。原来我们真是为了一点点报酬被雇过来的打手。尼西里塔太坏了！"
        },
        {
          "role": "梅兰塔",
          "text": "尼西里塔，背叛者，堕落者！"
        },
        {
          "role": "梅兰塔",
          "text": "放弃了自己的职责，却谎称开眼！"
        },
        {
          "role": "梅兰塔",
          "text": "我们守望者只应沉默地于此世界之柱殿守望。"
        },
        {
          "role": "派蒙",
          "text": "突然激动了起来。你也是看别人自由比自己不自由还难受的类型啊。"
        },
        {
          "role": "彩特琳德",
          "text": "不过我姐姐算错了一点。"
        },
        {
          "role": "彩特琳德",
          "text": "我是个内向的人，不擅长说话。就算我看过很多书，懂很多道理。"
        },
        {
          "role": "彩特琳德",
          "text": "我嘛，能不交流就尽量少交流。让你改变想法的另有其人。"
        },
        {
          "role": "彩特琳德",
          "text": "旅行者，麻烦你了。"
        },
        {
          "type": "subtitle",
          "text": "战胜「忧郁」"
        },
        {
          "role": "梅兰塔",
          "text": "如此索求樊笼之外的风景吗，可知索求亦是堕落的开端…"
        },
        {
          "role": "梅兰塔",
          "text": "星之主人之子，应受此难。"
        },
        {
          "type": "subtitle",
          "text": "操纵小右，从浮现的空间裂隙中抽取力量，以反击梅兰塔",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "梅兰塔",
          "text": "诸多虚相，尽皆破却——"
        },
        {
          "role": "梅兰塔",
          "text": "百界千如，倾毁一旦。"
        },
        {
          "type": "subtitle",
          "text": "击败'''梅兰塔'''",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "与守望者对话"
        },
        {
          "role": "梅兰塔",
          "text": "尼西里塔！尼西里塔！"
        },
        {
          "role": "梅兰塔",
          "text": "我明白了，我明白了。"
        },
        {
          "role": "梅兰塔",
          "text": "神不在其座，造物皆是自由的。"
        },
        {
          "role": "彩特琳德",
          "text": "梅兰塔。"
        },
        {
          "role": "梅兰塔",
          "text": "你要说什么？"
        },
        {
          "role": "彩特琳德",
          "text": "这也是我一直以来和忧郁的情绪相伴得到的一些经验，不过现在说可能有点太迟了。"
        },
        {
          "role": "彩特琳德",
          "text": "如果你感到了不可遏制的忧郁，那是生理病变，早点就医、积极配合治疗。"
        },
        {
          "role": "梅兰塔",
          "text": "和你姐姐一样，莫名其妙。"
        },
        {
          "role": "梅兰塔",
          "text": "呵呵。我们这种因为规则具现的…怪物，病了应该找谁呢？"
        },
        {
          "role": "彩特琳德",
          "text": "殴打病人现在有负罪感吗？"
        },
        {
          "role": "派蒙",
          "text": "彩特琳德，怎么感觉你和人混熟了之后坏坏的。"
        },
        {
          "role": "彩特琳德",
          "text": "内向的人心里都阴暗。"
        },
        {
          "role": "彩特琳德",
          "text": "你也看不了现在的我多久了。"
        },
        {
          "role": "派蒙",
          "text": "又说这种悲伤的话。"
        },
        {
          "role": "彩特琳德",
          "text": "我内心阴暗嘛。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "梅兰塔。我还有问题。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梅兰塔",
          "text": "还有什么就快问吧，我已经快要消失了。"
        },
        {
          "role": "梅兰塔",
          "text": "自作主张处理了玷污空间之理的画师{{#info:[[「莫基」]]}}，斩断了无所有廊的通路。"
        },
        {
          "role": "梅兰塔",
          "text": "这都是僭越之举，我的叛逆已经引发了规则内的自灭。"
        },
        {
          "role": "梅兰塔",
          "text": "我甚至不愿意回答你的提问，但是恐怕这种反抗也会加速我的消失。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于我的血亲…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梅兰塔",
          "text": "你不是来到了这里吗？你不是还有自由的意志与无拘的双足吗？你自己去找啊！"
        },
        {
          "role": "梅兰塔",
          "text": "又不是像我一样，翅膀先被自己束缚，然后又被折断。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你为什么要虐待众人？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梅兰塔",
          "text": "虐待？这是让他们回到应有的姿态。升入天国，居然不喜神圣的不变唱随，还在欣羡人间的腐朽。"
        },
        {
          "role": "梅兰塔",
          "text": "我明白了。我在嫉妒。我嫉妒他们，嫉妒堕天的尼西里塔。我嫉妒变化，嫉妒自由，嫉妒…生命。"
        },
        {
          "role": "梅兰塔",
          "text": "我以为，只要我一个人做得够好。我的造主归来之时，她会表扬我。这就足够抚慰我，足以证明其他所有人都错了。"
        },
        {
          "role": "梅兰塔",
          "text": "她为什么不愿意回头。为什么不问我是否愿意和她一起离开…"
        },
        {
          "role": "彩特琳德",
          "text": "你如果以前也这么死板无情的话，不难理解为什么。你要是叛逆一些的话，说不定就真喊上你了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "彩特琳德有什么想问的吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "彩特琳德",
          "text": "还有我的事吗？我想想啊。为什么疗养院会有魔性之山的传说？"
        },
        {
          "role": "梅兰塔",
          "text": "…曾经深渊灾害爆发。驻守在这里的骑士们死战不退。战报传回荆夫港时，是这么写的："
        },
        {
          "role": "梅兰塔",
          "text": "「去往风息山的人，无人归还。」"
        },
        {
          "role": "彩特琳德",
          "text": "我明白了。所以是误传。没有诅咒，只有安息的战士。西风的安息处。"
        },
        {
          "role": "梅兰塔",
          "text": "我的时间已经不多了。我好恨，我恨你们所有人。但是我无比想要维持意识的连续性。"
        },
        {
          "role": "梅兰塔",
          "text": "你和你姐姐——爱一切、爱所有人的凡人，渴望着结束。而我如此希望活下去，却要面临终结。"
        },
        {
          "role": "梅兰塔",
          "text": "尼西里塔，我好忧愁…"
        },
        {
          "type": "subtitle",
          "text": "返回柱殿中心"
        },
        {
          "type": "subtitle",
          "text": "与伊斯托利亚对话"
        },
        {
          "role": "派蒙",
          "text": "伊斯托利亚，我们把梅兰塔教育了一顿。"
        },
        {
          "role": "伊斯托利亚",
          "text": "看天色变化就能看出来你们成功了。"
        },
        {
          "role": "伊斯托利亚",
          "text": "梅兰塔说了什么对你们有用的消息吗？"
        },
        {
          "type": "subtitle",
          "text": "和伊斯托利亚讲了刚才的事情…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "伊斯托利亚",
          "text": "唉，「守望者」一词的原始意思，正是觉醒者、开眼者。"
        },
        {
          "role": "伊斯托利亚",
          "text": "闭眼的守望，只能被黑暗蒙蔽。但是觉醒，却也是违背了造主的意志，会被视为堕落。"
        },
        {
          "role": "伊斯托利亚",
          "text": "小右。我们教你、陪你玩，待你不薄啊。你是大家一起养大的。"
        },
        {
          "role": "伊斯托利亚",
          "text": "等你长大了，要记得我们的好啊。"
        },
        {
          "role": "小右",
          "text": "？"
        },
        {
          "role": "派蒙",
          "text": "话说，那个关于光暗原人的异端神话，你有什么头绪吗？"
        },
        {
          "role": "伊斯托利亚",
          "text": "我也不清楚梅兰塔具体在说什么。我第一时间想到的是被天使们列为异端的托喻。"
        },
        {
          "role": "伊斯托利亚",
          "text": "光明的神创造了如同自己一般的躯体，却被黑暗之王夺走。"
        },
        {
          "role": "伊斯托利亚",
          "text": "于是光明与黑暗的力量就在这个躯体之内互相争夺。同时兼具光暗的原初之人因此才有善恶。"
        },
        {
          "role": "伊斯托利亚",
          "text": "这算是流传比较少的原初之人神话了。"
        },
        {
          "role": "派蒙",
          "text": "太过简略了，好像没什么帮助啊。"
        },
        {
          "role": "伊斯托利亚",
          "text": "一时间也想不到别的了。"
        },
        {
          "role": "彩特琳德",
          "text": "伊斯托利亚，不和我说再见吗？"
        },
        {
          "role": "伊斯托利亚",
          "text": "我愧对于你，还有你姐姐。"
        },
        {
          "role": "彩特琳德",
          "text": "其实，前半程不说话的时候，我都在想一个东西。"
        },
        {
          "role": "派蒙",
          "text": "是什么？"
        },
        {
          "role": "彩特琳德",
          "text": "我的墓志铭应该写什么。"
        },
        {
          "role": "彩特琳德",
          "text": "哦，派蒙不要想歪。我们毕竟也不是长生不死的嘛。这个总会用上的。"
        },
        {
          "role": "彩特琳德",
          "text": "但是前半程我一直没有什么点子。毕竟姐姐假墓碑的墓志铭写得很好嘛。"
        },
        {
          "role": "彩特琳德",
          "text": "就在刚才，我想到了。"
        },
        {
          "role": "伊斯托利亚",
          "text": "是什么呢？"
        },
        {
          "role": "彩特琳德",
          "text": "我的墓志铭是「未完待续」。"
        },
        {
          "role": "彩特琳德",
          "text": "是不是和「只活一次不算数」不相上下？"
        },
        {
          "role": "伊斯托利亚",
          "text": "人是不断发展的叙事，不应只以生命为界限。"
        },
        {
          "role": "彩特琳德",
          "text": "那么，再见了，伊斯托利亚。"
        },
        {
          "role": "伊斯托利亚",
          "text": "再见，琳德。见到了希尔妲代我向她问好。"
        },
        {
          "role": "彩特琳德",
          "text": "我不保证记得这件事。也不能保证她还能记得你。"
        },
        {
          "role": "彩特琳德",
          "text": "走吧，旅行者和派蒙，送我下去吧。然后我们再重新认识一下。"
        },
        {
          "type": "subtitle",
          "text": "和彩特琳德一起离开"
        },
        {
          "role": "彩特琳德",
          "text": "活着真是什么都能见到啊。"
        },
        {
          "role": "彩特琳德",
          "text": "刚才就想说了，对梅兰塔的时候你们真是厉害…但是…"
        },
        {
          "role": "彩特琳德",
          "text": "你们做了什么来着？"
        },
        {
          "role": "彩特琳德",
          "text": "你们是谁来着？"
        },
        {
          "role": "派蒙",
          "text": "记忆消褪开始了吗？"
        },
        {
          "role": "彩特琳德",
          "text": "我是，谁？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你叫彩特琳德。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对，然后我叫派蒙，这位是旅行者。我们是你的好朋友！"
        },
        {
          "role": "彩特琳德",
          "text": "我们是朋友？"
        },
        {
          "role": "派蒙",
          "text": "没错，我们是一起经历过大风大浪、穿越过刀山火海的好朋友。"
        },
        {
          "role": "彩特琳德",
          "text": "是吗？"
        },
        {
          "role": "彩特琳德",
          "text": "我能感觉到，一定是的。"
        },
        {
          "role": "派蒙",
          "text": "然后你的姐姐为了换心情最近去环游世界了。总有一天你们会相见的。"
        },
        {
          "role": "派蒙",
          "text": "她和你一样，可能暂时不记得你了。但是你们血脉相连，还有一样的面庞。"
        },
        {
          "role": "派蒙",
          "text": "见面第一时间就一定能认出来对方。"
        },
        {
          "role": "彩特琳德",
          "text": "我还有个姐姐。"
        },
        {
          "role": "派蒙",
          "text": "啊，你可以无视这个墓碑！"
        },
        {
          "role": "派蒙",
          "text": "这个墓碑是你姐姐给自己立着玩的，代表自己重获新生。"
        },
        {
          "role": "派蒙",
          "text": "你姐姐绝对还活着！"
        },
        {
          "role": "彩特琳德",
          "text": "我姐姐…"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯。"
        },
        {
          "role": "彩特琳德",
          "text": "她怎么这么无聊啊。"
        },
        {
          "role": "派蒙",
          "text": "呃。"
        },
        {
          "role": "派蒙",
          "text": "总之你的手提箱里应该有你自己的一些信息，看一看应该就知道了。"
        },
        {
          "role": "彩特琳德",
          "text": "嗯，我知道了。"
        },
        {
          "role": "派蒙",
          "text": "还有哦，你是个非常了不起的人。"
        },
        {
          "role": "派蒙",
          "text": "拯救过一个世界那种程度的了不起。"
        },
        {
          "role": "彩特琳德",
          "text": "我吗？"
        },
        {
          "role": "派蒙",
          "text": "大家都非常感激你。所以你要骄傲地活着。"
        },
        {
          "role": "派蒙",
          "text": "有人欺负你了让你不愉快了，就写信给旅行者，没有什么是他摆不平的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你现在有什么想做的事情吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "彩特琳德",
          "text": "我也不知道。但是我好像是几天没吃饭一样饿。"
        },
        {
          "role": "派蒙",
          "text": "我也饿了我也饿了。我要立刻吃东西。"
        },
        {
          "role": "派蒙",
          "text": "赶紧把你的背包倒空。我要吃好多野菇鸡肉串。"
        }
      ],
