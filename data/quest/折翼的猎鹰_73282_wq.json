{
  "quest_id": 73282,
  "chapter_num": null,
  "chapter_title": "折翼的猎鹰",
  "type": "wq",
  "route": "The Fallen Falcon",
  "stories": [
    {
      "story_id": 73282,
      "title": "折翼的猎鹰",
      "description": "马塞拉转告你说塔德菈在你们最初相遇的地点等候着你，似乎有什么要紧事找你…",
      "dialogues": [
        {
          "role": "马塞拉",
          "text": "啊，您来了！请您留步，这恐怕是我最后一次拜托您了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请说吧，有什么需要帮忙的？",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "是塔德菈，她想要找您谈谈。"
                }
              ]
            },
            {
              "text": "我还有别的事情要忙…",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "请您务必听我说…塔德菈想要找您谈谈。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸…什么事呀，这么正式的。"
        },
        {
          "role": "马塞拉",
          "text": "北方的遗迹，你们最初遇见的地方附近…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你说什么…？",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "北方的遗迹，你们最初遇见的地方附近…别忘了。"
                }
              ]
            },
            {
              "text": "我明白了。",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "嗯，请您好好待她。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（马塞拉）"
        },
        {
          "role": "'心声'",
          "text": "（…清晨的水雾蒸腾之前，正午的蜃景成形之前，我的猎鹰便已起飞…）"
        },
        {
          "role": "马塞拉",
          "text": "北方的遗迹，你们最初遇见的地方附近…"
        },
        {
          "role": "马塞拉",
          "text": "这是她的选择…希望您能够加以尊重。"
        },
        {
          "type": "subtitle",
          "text": "前往塔德菈等候的地点"
        },
        {
          "type": "subtitle",
          "text": "与塔德菈对话"
        },
        {
          "type": "subtitle",
          "text": "心声（塔德菈）"
        },
        {
          "role": "塔德菈",
          "text": "（…心跳，平静不下来…开心？还是害怕？很害怕，但也很期待…）"
        },
        {
          "role": "塔德菈",
          "text": "你果然会来，我很开心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我听说你在找我。",
              "dialogues": []
            },
            {
              "text": "最近过得如何？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "我一直觉得这个时刻的沙漠，很好看。我很喜欢。"
        },
        {
          "role": "塔德菈",
          "text": "但是可惜…一直没有机会和朋友一起，在这里，就这样看太阳慢慢落下。"
        },
        {
          "role": "派蒙",
          "text": "是啊，整个沙漠都被染成红色了…很漂亮，好安静…"
        },
        {
          "role": "派蒙",
          "text": "不过，塔德菈，你专门叫我们来就是为了这个吗？"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "塔德菈",
          "text": "对于塔尼特，你是客人，对「猎鹰」来说，也是潜在的「猎物」…但我希望，活下来的是你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "所以，对不起…"
        },
        {
          "type": "subtitle",
          "text": "击败塔德菈"
        },
        {
          "role": "塔德菈",
          "text": "唔呃…！很痛…但很开心！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|镀金旅团·灵风猎手}}'''塔德菈'''",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "塔德菈",
          "text": "请…不要…遗忘我…"
        },
        {
          "role": "派蒙",
          "text": "塔德菈？塔德菈！欸…她…"
        },
        {
          "role": "利露帕尔",
          "text": "这是她出于自己的意志所做的选择…不再作为「猎鹰」，而是作为「朋友」而活。"
        },
        {
          "type": "subtitle",
          "text": "获得道具{{图标|塔德菈的翎羽}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与马塞拉对质"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调查",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "可恶…马塞拉那家伙不见了！"
        },
        {
          "role": "利露帕尔",
          "text": "他留下了这张字条…哼，老狐狸。"
        },
        {
          "type": "subtitle",
          "text": "整洁的字条"
        },
        {
          "type": "subtitle",
          "text": "若您看到这张字条，那么我已经深入峡谷之中的避难所了。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "若您的首级还在两肩中间，请不要为塔德菈的选择悲伤。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "这场狩猎并非结束，而是风暴的开始。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "塔尼特长老，猎人马塞拉，特为您发出警告。",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "他说的这些…看不明白是什么意思呢…"
        },
        {
          "role": "利露帕尔",
          "text": "看来出于某种压力，这家伙离开了部落…并且给您留下了警告。哼，塔尼特…暗潮汹涌呢。"
        }
      ],
      "collapse_ranges": [
