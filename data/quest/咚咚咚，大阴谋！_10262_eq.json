{
  "quest_id": 10262,
  "chapter_num": "叮铃哐啷大作战·纷扰",
  "chapter_title": "咚咚咚，大阴谋！",
  "type": "eq",
  "route": "Boong Boong Bwoooom! A Grand Plot!",
  "stories": [
    {
      "story_id": 40205,
      "title": "咚咚咚，大阴谋！",
      "description": "约定的日期到了，你们动身前往那个「非法黑市」进行调查…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后"
        },
        {
          "type": "subtitle",
          "text": "前往与雅珂达约定的地点"
        },
        {
          "role": "派蒙",
          "text": "你好啊，雅珂达。哇，那里果然来了好多人！"
        },
        {
          "role": "雅珂达",
          "text": "可不要小瞧了我的情报网。这样吧，我们先查一查这里的交易记录，那个小偷有可能在这里出手他偷到的东西…"
        },
        {
          "role": "爱诺",
          "text": "喂！是哪个坏蛋偷走了我的机器人伙伴？站出来，好好交代！"
        },
        {
          "role": "雅珂达",
          "text": "（不是这么查的…）"
        },
        {
          "role": "黑市商人们",
          "text": "……"
        },
        {
          "role": "好奇的商人",
          "text": "这位莫非就是那个工坊的主人？"
        },
        {
          "role": "急切的商人",
          "text": "来得正好，更方便谈生意嘛。"
        },
        {
          "role": "爱诺",
          "text": "你们…你们谁是那个小偷？"
        },
        {
          "role": "好奇的商人",
          "text": "什么小偷？这里只有生意人。我想订制一种机械，价钱都好说！"
        },
        {
          "role": "急切的商人",
          "text": "那个机器人女仆是你造出来的吧？这种技术卖不卖？我也想拥有一个机器人女仆！"
        },
        {
          "role": "爱诺",
          "text": "你们…都闪开！"
        },
        {
          "role": "雅珂达",
          "text": "咳咳！连最基本的规矩都不懂，怪不得沦落到在这种非法黑市里做生意。"
        },
        {
          "role": "雅珂达",
          "text": "就算工坊的主人愿意和你们做交易，也得通过这里的柜台来谈，明白吗？"
        },
        {
          "role": "雅珂达",
          "text": "爱诺这家伙的机械造物放眼整个挪德卡莱都是抢手货，也不能怪这帮商人如此热情。"
        },
        {
          "role": "爱诺",
          "text": "无论是伊涅芙还是铛铛七分甜，都不是用来买卖的，这里的大人都让我很讨厌。"
        },
        {
          "role": "爱诺",
          "text": "不过，旅行者说得对，这里的大人就算做贼也不会心虚，我的方法行不通…"
        },
        {
          "role": "派蒙",
          "text": "你真的想用那种方法把小偷揪出来啊？"
        },
        {
          "role": "雅珂达",
          "text": "没见过世面吧？这里的商人眼里只有钱，而道德在他们眼里不值钱。"
        },
        {
          "role": "雅珂达",
          "text": "线索还是得从柜台那边找，跟我来。"
        },
        {
          "type": "subtitle",
          "text": "前往柜台"
        },
        {
          "role": "尤斯塔奇",
          "text": "这位不就是那个叮铃哐啷蛋卷工坊的主人吗？久仰久仰！请问我有什么能帮到您的地方？"
        },
        {
          "role": "雅珂达",
          "text": "让我来吧…长话短说，最近有没有人在这里交易来自叮铃哐啷蛋卷工坊的机械造物？"
        },
        {
          "role": "尤斯塔奇",
          "text": "…不瞒您说，我们只是个提供交易的平台，从来不会过问客户的交易内容——这也正是我们平台的一大优势。"
        },
        {
          "role": "尤斯塔奇",
          "text": "客户想买什么或者想卖什么，可以自行在告示牌上张贴告示，寻找合适的交易人选。"
        },
        {
          "role": "雅珂达",
          "text": "这么随便？怪不得是非法黑市…"
        },
        {
          "role": "派蒙",
          "text": "哇，第一张告示的内容好像就是重金收购爱诺最新制作的机械造物！？"
        },
        {
          "role": "爱诺",
          "text": "铛铛七分甜是被偷走的，你竟然允许这种交易，你也是坏蛋？"
        },
        {
          "role": "尤斯塔奇",
          "text": "话可不能这么讲啊，就像我说的那样，我们从来不会过问客户的交易内容。"
        },
        {
          "role": "尤斯塔奇",
          "text": "在我们看来，对客户之间的争端保持中立才是专业的表现。"
        },
        {
          "role": "爱诺",
          "text": "…铛铛七分甜是我的伙伴，我才不要让它像一件商品那样被卖来卖去。"
        },
        {
          "role": "尤斯塔奇",
          "text": "喂喂，可不能撕啊！至少在今天闭市之前，我都得保证让这张告示留在告示牌上，还请见谅。"
        },
        {
          "role": "派蒙",
          "text": "你刚刚还说过要对客户之间的争端保持中立…"
        },
        {
          "role": "尤斯塔奇",
          "text": "哎呀，张贴这张告示的是付费客户…"
        },
        {
          "role": "尤斯塔奇",
          "text": "您看，平台还是要赚钱的，如果您愿意支付更多的摩拉，倒是可以新贴一张告示，把那张覆盖掉。"
        },
        {
          "role": "雅珂达",
          "text": "唉…每个地方都有自己的规矩，这样闹也没有意义。我们不是找到线索了吗？先看看这张告示说了些什么。"
        },
        {
          "role": "雅珂达",
          "text": "让我看看…重金求购一台机械造物，从风格来看是叮铃哐啷蛋卷工坊的作品，详情可面谈…"
        },
        {
          "role": "雅珂达",
          "text": "根据线人提供的情报，目前这种机械造物仅发现一台，且已落入霜月之子手中…"
        },
        {
          "role": "雅珂达",
          "text": "只要能提供一台这样的机械造物，必有重金酬谢…"
        },
        {
          "role": "派蒙",
          "text": "在霜月之子手中？难道…"
        },
        {
          "role": "爱诺",
          "text": "工坊位于霜月之坊和那夏镇之间，如果有霜月之子的族民想去镇里办事，就要从工坊路过。"
        },
        {
          "role": "爱诺",
          "text": "时间久了，我和伊涅芙都不对他们设防…"
        },
        {
          "role": "派蒙",
          "text": "这样看来，还真有可能是霜月之子的人偷的？他们为什么要偷爱诺的机器人伙伴？"
        },
        {
          "role": "爱诺",
          "text": "…看来他们也馋上了铛铛七分甜烤制的甜品，所以才对它下手。"
        },
        {
          "role": "派蒙",
          "text": "啊？"
        },
        {
          "role": "爱诺",
          "text": "伊涅芙总是严格控制我的甜食摄入量，所以我设计了铛铛七分甜。只要输入配方，提供原料，它就能自动烤制甜品！"
        },
        {
          "role": "雅珂达",
          "text": "能烤制甜品的机器人？就为了这个？"
        },
        {
          "role": "？？？",
          "text": "哈哈，你觉得这样的说法真的能瞒过挪德卡莱的各方势力吗？工坊的主人。"
        },
        {
          "role": "爱诺",
          "text": "你又是谁？"
        },
        {
          "role": "雅珂达",
          "text": "这不是阿斯科吗？他在我老板那里也算是有头有脸的人物…不过话说回来，这样的人物为什么要来这里做生意？"
        },
        {
          "role": "阿斯科",
          "text": "有的生意可以和伏尼契商会做，而有的生意就必须来这里做。"
        },
        {
          "role": "阿斯科",
          "text": "但只要是能赚钱的生意，我都感兴趣——你们刚刚看到的告示就是我派人贴的。"
        },
        {
          "role": "爱诺",
          "text": "原来想买卖铛铛七分甜的人是你？那你也是坏蛋！"
        },
        {
          "role": "阿斯科",
          "text": "不要这样，在商言商嘛。"
        },
        {
          "role": "阿斯科",
          "text": "我确实对你那件作品很感兴趣，之前尝试过从那些霜月之子手中收购，可惜这些信徒都太死板了，不肯松口。"
        },
        {
          "role": "阿斯科",
          "text": "看来还是得找正主谈，那种机械造物能不能再造一台？我愿意出高价收购，把那张告示上的价格再翻十倍也可以。"
        },
        {
          "role": "爱诺",
          "text": "我才不跟坏蛋谈…"
        },
        {
          "role": "雅珂达",
          "text": "那个告示上没有限定手段，换言之，去偷去抢都可以…"
        },
        {
          "role": "雅珂达",
          "text": "只是一台可以烤蛋糕的机器人而已，不至于让阁下做这么不体面的事吧？"
        },
        {
          "role": "雅珂达",
          "text": "不如把线人提供的情报向我们透漏一些，也算是让叮铃哐啷蛋卷工坊欠阁下一个人情？"
        },
        {
          "role": "阿斯科",
          "text": "可是根据我收到的情报，它成功移植了「轰隆隆月矩力能量炮」所使用的技术，一旦被改造成兵器，必定威力惊人。"
        },
        {
          "role": "雅珂达",
          "text": "什么？"
        },
        {
          "role": "阿斯科",
          "text": "看看那门大炮吧，它能将月矩力浓缩成极具破坏性的能量，然而它太巨大，太笨重，既无法量产，也无法运输。"
        },
        {
          "role": "阿斯科",
          "text": "再加上每次发射都需要大量时间来筹备弹药…总而言之，根本无法成为一件商品。"
        },
        {
          "role": "阿斯科",
          "text": "不过，如果能将其小型化，量产化，虽然无法复现那门大炮的威力，但可以得到一种完美的商品。"
        },
        {
          "role": "阿斯科",
          "text": "另外，请你们仔细想想，这或许就是霜月之子盯上这个机械造物的原因。"
        },
        {
          "role": "阿斯科",
          "text": "在他们的教义里，月矩力是一种圣洁的神力，不容亵渎。"
        },
        {
          "role": "阿斯科",
          "text": "那夏镇的大炮将月矩力作为一种对抗「狂猎」，保护居民的手段，在他们看来倒也不是不能接受。"
        },
        {
          "role": "阿斯科",
          "text": "但如果将那种大炮使用的技术变成一种商品，任由其流入黑市，无论是谁，只要花钱就可以掌控月矩力的威能…"
        },
        {
          "role": "阿斯科",
          "text": "对于那些霜月之子而言，这完全是渎神之举。"
        },
        {
          "role": "阿斯科",
          "text": "所以，不如把这种技术转卖给我吧，就当是把这些麻烦交给我来承担，很划算，不是吗？"
        },
        {
          "role": "雅珂达",
          "text": "你这家伙该不会是又造出了什么危险的东西吧？"
        },
        {
          "role": "爱诺",
          "text": "我已经说过了，铛铛七分甜能烤制甜品，超好吃的甜品，它才不是什么战争兵器！"
        },
        {
          "role": "爱诺",
          "text": "铛铛七分甜是我的伙伴，我一定会把它救回来的，你死心吧！"
        },
        {
          "role": "阿斯科",
          "text": "跟正主也没得谈…真遗憾啊。"
        },
        {
          "role": "派蒙",
          "text": "接下来，我们该怎么办？"
        },
        {
          "role": "爱诺",
          "text": "至少我们知道小偷在霜月之子那里吧，只要我们过去，然后…唔…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "或许可以找菈乌玛帮忙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦！"
        },
        {
          "role": "雅珂达",
          "text": "稍等一下，我必须提醒你们，要是那个商人说的都是真的，事情就很难办了，可要有心理准备哦。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（尤斯塔奇）"
        },
        {
          "role": "尤斯塔奇",
          "text": "真的不考虑一下这里的付费项目吗？"
        },
        {
          "type": "subtitle",
          "text": "查看（告示牌）"
        },
        {
          "role": "告示牌",
          "text": "告示牌上张贴了许多告示，新贴的告示大多覆盖在旧的上面，看上去杂乱无章，但似乎又被人精心打理过。"
        },
        {
          "role": "告示牌",
          "text": "不少告示中存在攻讦同行的内容，但这类告示却被有意摆在显眼的地方。"
        },
        {
          "type": "subtitle",
          "text": "前往霜月之坊"
        },
        {
          "role": "派蒙",
          "text": "你好啊，菈乌玛！"
        },
        {
          "role": "菈乌玛",
          "text": "旅行者和派蒙？愿月光联系着你我，不论日夜。嗯…心中烦扰，不妨直言。"
        },
        {
          "role": "派蒙",
          "text": "你又看出来啦？"
        },
        {
          "role": "菈乌玛",
          "text": "沐浴着月光的愁容正如满月的暗斑，于阴晴之间流露心绪。"
        },
        {
          "role": "雅珂达",
          "text": "让她先别说话，果然闹情绪了…咏月使大人，请先听我讲。"
        },
        {
          "type": "subtitle",
          "text": "雅珂达仔细讲述了你们来这里的原因，她的措辞很小心。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "雅珂达",
          "text": "目前都还只是猜测…"
        },
        {
          "role": "菈乌玛",
          "text": "请稍等片刻。"
        },
        {
          "role": "菈乌玛",
          "text": "前几日，确实有一些族人带回了某种机械造物，请随我前去与他们当面对质，个中是非，自可辨明。"
        },
        {
          "type": "subtitle",
          "text": "与族人对质"
        },
        {
          "role": "阿索",
          "text": "愿月光联系着你我，咏月使大人，请问您找我们有什么事？"
        },
        {
          "type": "subtitle",
          "text": "菈乌玛转述了你们来到这里的原因。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "阿索",
          "text": "偷盗？我们怎么会做这种事？这是凭空污蔑！"
        },
        {
          "role": "阿索",
          "text": "我们确实带回了一种危险的机械造物，但它并非是我们偷来的，而是从一伙匪徒手里抢到的。"
        },
        {
          "role": "菈乌玛",
          "text": "若有误会，那就向客人们澄清。"
        },
        {
          "role": "阿索",
          "text": "我记得那是几天前，在附近的野外…"
        },
        {
          "role": "阿索",
          "text": "嗯？那些人在干什么？"
        },
        {
          "role": "急躁的盗宝团成员",
          "text": "还没好吗？我们得在被那帮原住民发现之前完成测试！"
        },
        {
          "role": "冒失的盗宝团成员",
          "text": "就不能去其他地方吗？这活儿干得提心吊胆…"
        },
        {
          "role": "急躁的盗宝团成员",
          "text": "蠢货，没听雇主说吗？这玩意儿对月矩力有特殊的需求，要不然也不用跑到这个地方来。闭上嘴，抓紧时间！"
        },
        {
          "role": "冒失的盗宝团成员",
          "text": "别喊，让我想想，应该是这里…"
        },
        {
          "role": "阿索",
          "text": "什么！？"
        },
        {
          "role": "急躁的盗宝团成员",
          "text": "你干了什么？这动静不被人注意到才怪！"
        },
        {
          "role": "冒失的盗宝团成员",
          "text": "这…至少我们验证了这玩意儿的威力，不是吗？肯定可以回去交差了！"
        },
        {
          "role": "急躁的盗宝团成员",
          "text": "唉，算是吧，那就收拾东西赶紧撤！"
        },
        {
          "role": "阿索",
          "text": "站住！放下你们持有的危险物品！"
        },
        {
          "role": "急躁的盗宝团成员",
          "text": "这么快？这玩意儿还能再启动一次吗？"
        },
        {
          "role": "冒失的盗宝团成员",
          "text": "刚刚的操作我也记不清了…这我可搬不动啊。"
        },
        {
          "role": "急躁的盗宝团成员",
          "text": "唉…赶紧跑吧，最重要的是我们不能被抓了现行！"
        },
        {
          "role": "阿索",
          "text": "就是这样，我们没能抓到人，但是我们截获了他们手中的那种机械造物。"
        },
        {
          "role": "雅珂达",
          "text": "爱诺，我再确认一下，你不会又造出了什么危险的东西吧？"
        },
        {
          "role": "派蒙",
          "text": "或许这是另一个误会？阿索看到的那种机械造物不一定就是铛铛七分甜吧？"
        },
        {
          "role": "爱诺",
          "text": "嗯…那种机械造物上面有没有这个标识？"
        },
        {
          "role": "阿索",
          "text": "嗯，有的。"
        },
        {
          "role": "爱诺",
          "text": "这是我为伙伴特别设计的标识，每次加标识的时候都会特殊处理一下，就算拆卸改装也绝对抹不掉。"
        },
        {
          "role": "爱诺",
          "text": "所以，那确实是铛铛七分甜…"
        },
        {
          "role": "菈乌玛",
          "text": "既然误会已经澄清，就物归原主吧。"
        },
        {
          "role": "阿索",
          "text": "恕我直言，咏月使大人，我认为不能如此草率。"
        },
        {
          "role": "阿索",
          "text": "那种机械造物和那夏镇的大炮在原理上十分相似，但我们不能对它们一视同仁。"
        },
        {
          "role": "阿索",
          "text": "那夏镇的大炮利用月矩力一次次地击退了「狂猎」，守护了这片土地，我一直将其视为一种月神赐予的庇佑。"
        },
        {
          "role": "阿索",
          "text": "然而那种机械造物…它更像是一种商品，很容易就会被恶徒掌控，用于满足他们的私欲。"
        },
        {
          "role": "阿索",
          "text": "据我所知，这位工坊的主人经常与挪德卡莱的各大势力进行交易。"
        },
        {
          "role": "阿索",
          "text": "我怀疑她制作这种机械造物正是为了向他人出售，一旦让它流入黑市，继而被滥用…"
        },
        {
          "role": "爱诺",
          "text": "铛铛七分甜是我的伙伴，它不是用来买卖的！"
        },
        {
          "role": "阿索",
          "text": "…这只是你的一面之词，我们可不能冒险。一旦让心怀不轨的人拿到了这种造物，圣洁的月光必将遭到亵渎！"
        },
        {
          "role": "雅珂达",
          "text": "（我就说过，事情会变得很难办，这次趟进浑水了…）"
        },
        {
          "role": "阿索",
          "text": "在我看来，最好的处理方法还是销毁这种危险的造物，并防止类似的造物再次出现…"
        },
        {
          "role": "爱诺",
          "text": "你说什么？你们想销毁铛铛七分甜？"
        },
        {
          "role": "阿索",
          "text": "还请理解我们的苦衷…"
        },
        {
          "role": "爱诺",
          "text": "你们都是坏蛋！给我让开！"
        },
        {
          "type": "subtitle",
          "text": "深入霜月之子的营地"
        },
        {
          "role": "派蒙",
          "text": "爱诺，冷静一下！"
        },
        {
          "role": "阿索",
          "text": "快住手，我们不会让你带走那个危险的机械造物！"
        },
        {
          "role": "爱诺",
          "text": "再说一遍，铛铛七分甜是伙伴！"
        },
        {
          "type": "subtitle",
          "text": "进入战斗",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "劝阻爱诺"
        },
        {
          "role": "阿索",
          "text": "请…请冷静些！"
        },
        {
          "role": "派蒙",
          "text": "爱诺！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不能再胡闹了，爱诺！",
              "dialogues": [
                {
                  "role": "爱诺",
                  "text": "可是，他们说要销毁铛铛七分甜…"
                },
                {
                  "role": "派蒙",
                  "text": "我们当然不会让这件事发生，但胡来是解决不了问题的。"
                }
              ]
            },
            {
              "text": "我不会让爱诺的伙伴出事。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，还请相信我们，先冷静一下，这样胡来是绝对不行的！"
                },
                {
                  "role": "爱诺",
                  "text": "我…"
                }
              ]
            }
          ]
        },
        {
          "role": "赫莉米",
          "text": "不好了，一大批飞行机械偷袭了我们存储物资的地方，那台机械造物被抢走了！"
        },
        {
          "role": "阿索",
          "text": "这个时候？难道是盯准了我们和这个女孩儿起冲突的时机…"
        },
        {
          "role": "派蒙",
          "text": "哇，好多侦察单元！"
        },
        {
          "role": "雅珂达",
          "text": "肯定是那些黑市商人安排的，我们果然还被盯着！"
        },
        {
          "role": "爱诺",
          "text": "旅行者，我可以直接在这里搭建一段临时的月灵旅路，麻烦你请月灵来帮忙！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，把它们打下来！"
        },
        {
          "type": "subtitle",
          "text": "击落侦察单元"
        },
        {
          "type": "subtitle",
          "text": "击毁侦察单元"
        },
        {
          "type": "subtitle",
          "text": "阻止敌人带走铛铛七分甜",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这么多侦察单元，劫走铛铛七分甜的是哪一个？"
        },
        {
          "role": "爱诺",
          "text": "都是障眼法，通通打下来！"
        },
        {
          "role": "派蒙",
          "text": "怎么才能把这些侦察单元打下来呢？"
        },
        {
          "role": "爱诺",
          "text": "用月矩力抓取那些石头，就能把它们打下来了！"
        },
        {
          "type": "subtitle",
          "text": "安慰爱诺"
        },
        {
          "role": "派蒙",
          "text": "最后一架，肯定就在上面了！啊，往那边逃了！"
        },
        {
          "role": "爱诺",
          "text": "看我的！不许跑！"
        },
        {
          "role": "派蒙",
          "text": "爱诺，危险！"
        },
        {
          "role": "爱诺",
          "text": "可恶…"
        },
        {
          "role": "派蒙",
          "text": "爱诺——"
        },
        {
          "type": "subtitle",
          "text": "你接住了从空中掉下的爱诺…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "爱诺",
          "text": "唔…旅行者？对了，那架侦察单元…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你没事才最重要。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呼…真是太危险了，你这样也很乱来的！"
        },
        {
          "role": "雅珂达",
          "text": "没事就好…身手不错嘛，旅行者，我还以为必须要我出手呢。"
        },
        {
          "role": "雅珂达",
          "text": "（幸亏没出事，不然的话，我真的想不到该怎么跟伊涅芙交代啊…）"
        },
        {
          "role": "爱诺",
          "text": "根本不是没事！铛铛七分甜还是被抢走了…我是叮铃哐啷蛋卷工坊的老大，我不能在这时候哭…"
        },
        {
          "role": "菈乌玛",
          "text": "请容我代替族人向你致歉，如果没有他们的阻拦，或许你的伙伴就不会被劫走。"
        },
        {
          "role": "阿索",
          "text": "咏月使大人…"
        },
        {
          "role": "菈乌玛",
          "text": "如果她真的将那种机械造物视为谋利的手段，大可以重新制作，又何必展示这种足以让你们羞愧的勇气呢？"
        },
        {
          "role": "菈乌玛",
          "text": "即便是满月的光华，也无法在她的心绪上映出瑕疵，而你们那颗苛求的心，却已经要没入月华所无法触及的阴影之中了。"
        },
        {
          "role": "阿索",
          "text": "…请也接受我的道歉。"
        },
        {
          "role": "派蒙",
          "text": "误会解开了就好。"
        },
        {
          "role": "菈乌玛",
          "text": "所以，请不要悲伤。「心绪无瑕之人，总能得到月光的指引。」"
        },
        {
          "role": "菈乌玛",
          "text": "你一定能找回同伴，有需要的话，我也愿意安排族人向你提供帮助。"
        },
        {
          "role": "爱诺",
          "text": "…嗯。"
        },
        {
          "role": "派蒙",
          "text": "但是话说回来，接下来该去哪里找？"
        },
        {
          "role": "雅珂达",
          "text": "结论很明显，动手的是那个非法黑市的商人，恐怕对方早就料到爱诺和霜月之子之间会发生冲突，就钻了这个空子。"
        },
        {
          "role": "雅珂达",
          "text": "更确切一点来说，最初把铛铛七分甜偷走的人可能也是他安排的，所以他早就知道铛铛七分甜在这里，能提前布局。"
        },
        {
          "role": "雅珂达",
          "text": "目前来看，嫌疑最大的肯定是那个阿斯科，不过，好像也不能完全排除其他商人的嫌疑…"
        },
        {
          "role": "派蒙",
          "text": "确实如此…看来雅珂达肯定知道去哪里查。"
        },
        {
          "role": "雅珂达",
          "text": "（又要我来？刚刚说过了，那里的商人都有嫌疑，黑市一散，谁知道都能跑到什么地方去？唉…刚刚不该卖弄的。）"
        },
        {
          "role": "派蒙",
          "text": "雅珂达肯定也是见不得爱诺这么伤心，接下来也要仰仗你了呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "雅珂达，仰仗你了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "雅珂达",
          "text": "（…这让我怎么拒绝啊？）"
        },
        {
          "role": "雅珂达",
          "text": "好吧，至少…至少先给我两天时间。"
        },
        {
          "role": "派蒙",
          "text": "再等两天，看来也是没办法的事呢。爱诺，现在有这么多人帮忙，不用担心的。"
        },
        {
          "role": "爱诺",
          "text": "我知道的…谢谢大家。"
        }
      ],
