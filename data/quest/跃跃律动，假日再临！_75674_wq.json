{
  "quest_id": 75674,
  "chapter_num": null,
  "chapter_title": "跃跃律动，假日再临！",
  "type": "wq",
  "route": "Disco in Motion, Holiday Emotion!",
  "stories": [
    {
      "story_id": 75674,
      "title": "跃跃律动，假日再临！",
      "description": "纳塔的讯使捎来消息，邀请你与派蒙回到悠悠度假村，参加独特的「舞力派对」…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "纳塔的讯使在冒险家协会留了言，说是「流泉之众」、「回声之子」和「花羽会」正在悠悠度假村举办派对。"
        },
        {
          "role": "派蒙",
          "text": "有种熟悉的感觉呢…应该会非常好玩！我们抽空过去看看吧？"
        },
        {
          "type": "subtitle",
          "text": "前往悠悠度假村"
        },
        {
          "role": "昂吉安妮",
          "text": "如此如此…这般这般…小贼们肯定会跪地哭号…"
        },
        {
          "role": "昂吉安妮",
          "text": "这种时候「失误放跑」一个小贼，他肯定会惊恐地回去通风报信，你再悄悄尾随…"
        },
        {
          "role": "昂吉安妮",
          "text": "就能在小贼们商量对策的时候，踹开他们老巢的大门，给他们恐怖映影般的惊吓！"
        },
        {
          "role": "努斯妲",
          "text": "您说得很有道理，昂吉安妮小姐。对付油盐不进的恶人，的确要用超出常理的手段。"
        },
        {
          "role": "努斯妲",
          "text": "纳塔不像枫丹，有那么繁琐…咳，「严格的执法程序」！我会好好利用这个优势。"
        },
        {
          "role": "努斯妲",
          "text": "之前我抓到了几个漏网的龙贩子，就用您说的办法，再把北边的走私犯也一窝端掉。"
        },
        {
          "role": "昂吉安妮",
          "text": "到时候记得给我捷报哦，我超期待的！"
        },
        {
          "role": "昂吉安妮",
          "text": "嗨呀…现在我不再是执律庭的成员了，按照保密条例，[[蒂蕾娜]]也不能向我汇报她的工作情况。"
        },
        {
          "role": "昂吉安妮",
          "text": "总感觉，自己还有一些本领没和有需要的人分享…要不要，干脆写一本回忆录？"
        },
        {
          "role": "昂吉安妮",
          "text": "嗯，只对各国执法人员发售的回忆录！我这150年的工作经验应该能帮上忙。"
        },
        {
          "role": "努斯妲",
          "text": "我支持！等你好好享受这次派对，玩得身心舒畅，创作起来肯定也必定更顺利…"
        },
        {
          "role": "努斯妲",
          "text": "到时候请给我留一本签名版的！"
        },
        {
          "role": "昂吉安妮",
          "text": "第一个送你！这次跳舞跳个尽兴，我回去就租一台打字机，立刻开写！"
        },
        {
          "role": "派蒙",
          "text": "美露莘和…努斯妲？"
        },
        {
          "role": "派蒙",
          "text": "又一对没想过的组合，在聊什么呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来是很有趣的内容？",
              "dialogues": []
            },
            {
              "text": "听起来是很危险的内容？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "努斯妲",
          "text": "好呀，我们的「杜麦尼」登场了！领舞者就位，派对进入正题！"
        },
        {
          "role": "努斯妲",
          "text": "当务之急是告诉你们特大好消息——我们第二次「舞力聚会」已经开始了！"
        },
        {
          "role": "努斯妲",
          "text": "还有全新的参与者：来自枫丹旅游团的昂吉安妮小姐，和她的三位伙伴！"
        },
        {
          "role": "努斯妲",
          "text": "另外，多亏「乌沙博蒂」[[卡齐娜]]和[[芭芭拉|蒙德的偶像小姐]]，枫丹客人和这边的阿夏都学会了全新的舞步！"
        },
        {
          "role": "派蒙",
          "text": "等等等等，信息一下子接受得太多了…"
        },
        {
          "role": "派蒙",
          "text": "意思是，除了之前跳舞的大家和小龙，还有美露莘和…阿夏？"
        },
        {
          "role": "努斯妲",
          "text": "对哦！所以我们能在更新更欢快的音乐里，跳出更尽兴的舞蹈。"
        },
        {
          "role": "努斯妲",
          "text": "作为领舞的「杜麦尼」也能展现自己对所有节拍的适应力！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "热闹点确实更好。",
              "dialogues": []
            },
            {
              "text": "人多的派对更欢乐。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "昂吉安妮",
          "text": "等等，努斯妲叫你「杜麦尼」…旅行者就是「杜麦尼」吗？"
        },
        {
          "role": "昂吉安妮",
          "text": "教我跳舞的那位「回声之子」小勇士说，她的师父是纳塔最最厉害的「杜麦尼」，也很会跳舞…"
        },
        {
          "role": "昂吉安妮",
          "text": "绕了半天，原来就是你啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那现在我是你的师祖了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "噗…那我也是昂吉安妮师祖那一辈的啦。"
                },
                {
                  "role": "昂吉安妮",
                  "text": "不行不行，怎么感觉地位降了两档…"
                },
                {
                  "role": "昂吉安妮",
                  "text": "各论各的，各论各的！"
                }
              ]
            },
            {
              "text": "特巡队警官的情报不够广呀。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "就是就是，看来你这个教官也有大意的时候嘛，怎么能不收集邻国的重要信息呢？"
                },
                {
                  "role": "昂吉安妮",
                  "text": "话不能这么说，我又没有在境外行动的需求。和我无关的事情，干嘛要去管？"
                },
                {
                  "role": "昂吉安妮",
                  "text": "知道的事情越多，有时候越容易心乱，明白吗？这个叫做情报集中度的管理！"
                }
              ]
            }
          ]
        },
        {
          "role": "昂吉安妮",
          "text": "话说回来，跳舞这种事情很看天分的。"
        },
        {
          "role": "昂吉安妮",
          "text": "说不定我就是小说主角级别的天才，练了两天就跳得和你差不多呢？"
        },
        {
          "role": "昂吉安妮",
          "text": "当然，也没必要比个高下，我的意思是…最好摇的节奏，最时髦的舞步，我都能跟上！"
        },
        {
          "role": "派蒙",
          "text": "对的对的，跳舞这种事，开心就好！就算只能卡准节奏摇摆摇摆，也是好好参与！"
        },
        {
          "role": "努斯妲",
          "text": "看来，一切都准备就绪了？"
        },
        {
          "role": "努斯妲",
          "text": "如果「杜麦尼」想先和朋友们聊聊天，她们都在那边等着你！"
        },
        {
          "role": "努斯妲",
          "text": "这边也随时可以让大家聚集起来，奏响音乐，开启派对的正题！"
        },
        {
          "type": "subtitle",
          "text": "舞力聚会教程（气泡文字）"
        },
        {
          "role": "努斯妲",
          "text": "先来找找跳舞的状态吧！"
        },
        {
          "role": "努斯妲",
          "text": "注意音乐中的{{颜色|描述|鼓点}}！"
        },
        {
          "role": "努斯妲",
          "text": "所有动作都在{{颜色|描述|两声鼓点}}后开始。"
        },
        {
          "role": "努斯妲",
          "text": "就像…"
        },
        {
          "role": "努斯妲",
          "text": "接下来，请看{{颜色|描述|聚光灯}}！"
        },
        {
          "role": "努斯妲",
          "text": "灯光{{颜色|描述|变色}}时，我会开始演示动作。"
        },
        {
          "role": "努斯妲",
          "text": "聚光灯照到你时，请做出同样的动作。"
        },
        {
          "role": "努斯妲",
          "text": "这次新增了{{颜色|描述|长按}}的动作。"
        },
        {
          "role": "努斯妲",
          "text": "{{颜色|描述|按住}}长按转身。"
        },
        {
          "role": "努斯妲",
          "text": "{{颜色|描述|松开}}时回转！"
        },
        {
          "role": "努斯妲",
          "text": "试着跟上长按动作！"
        },
        {
          "role": "努斯妲",
          "text": "按住…一、二、三、四…"
        },
        {
          "role": "努斯妲",
          "text": "松手！"
        },
        {
          "role": "努斯妲",
          "text": "按住…一、二、三、四…"
        },
        {
          "role": "努斯妲",
          "text": "松手！"
        },
        {
          "role": "努斯妲",
          "text": "巩固练习时间！跟着我做！"
        },
        {
          "role": "努斯妲",
          "text": "这次舞蹈还有{{颜色|描述|共舞}}段落。"
        },
        {
          "role": "努斯妲",
          "text": "你需要和我同时做动作。"
        },
        {
          "role": "努斯妲",
          "text": "看清我做的动作。"
        },
        {
          "role": "努斯妲",
          "text": "然后…"
        },
        {
          "role": "努斯妲",
          "text": "最后，让我们尽情律动吧！"
        },
        {
          "type": "subtitle",
          "text": "连击将获得额外评分！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "额外对话（努斯妲）"
        },
        {
          "role": "努斯妲",
          "text": "您已经轻车熟路了呀，旅行者！这次的舞者队伍，还有美露莘和阿夏加盟，看她们跳舞，非常惬意吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "跳舞跳舞，现在开始！",
              "dialogues": [
                {
                  "role": "努斯妲",
                  "text": "啊哈哈！就是这样！释放热情，跟着节奏摇摆！"
                }
              ]
            },
            {
              "text": "先聊两句，努斯妲？",
              "dialogues": [
                {
                  "role": "努斯妲",
                  "text": "好呀好呀，我要先向你报喜——"
                },
                {
                  "role": "努斯妲",
                  "text": "之前，我为了提升滞空拳法，加强基础力量的训练，去「沃陆之邦」旅居了一段时间…"
                },
                {
                  "role": "努斯妲",
                  "text": "正好也借机练习了鼓术，现在鼓打得还算不错！"
                },
                {
                  "role": "努斯妲",
                  "text": "按[[伊安珊]]大师的评价，再加强一下双踩和复合跳的律动感，我就能演奏比较前卫的曲目了。"
                },
                {
                  "role": "努斯妲",
                  "text": "如果以后，您打算组建自己的乐队，一时间找不到鼓手…"
                },
                {
                  "role": "努斯妲",
                  "text": "不嫌弃的话，我可以来帮忙！"
                }
              ]
            },
            {
              "text": "这次还有些朋友没来？",
              "dialogues": [
                {
                  "role": "努斯妲",
                  "text": "哦？您大概是指…[[塔拉内]]和[[「弯刀大叔」]]？"
                },
                {
                  "role": "努斯妲",
                  "text": "他们最近忙得不可开交，确实有点遗憾！"
                },
                {
                  "role": "努斯妲",
                  "text": "之前须弥好像发生了什么不得了的风波，举行了一场规模庞大的搬迁。"
                },
                {
                  "role": "努斯妲",
                  "text": "好在，听说危险的问题已经被解决了…于是他们又要搬回原来的地方。"
                },
                {
                  "role": "努斯妲",
                  "text": "搬家这种事情总是非常麻烦的嘛，何况是两次。整理东西，彻底打扫屋子什么的，都很费时间…"
                },
                {
                  "role": "努斯妲",
                  "text": "以塔拉内和「弯刀大叔」的性格，自己搞定了最麻烦的事，肯定还会去帮邻居。"
                },
                {
                  "role": "努斯妲",
                  "text": "所以这次，就只有一些相对清闲的「炽光猎兽」成员来玩了。"
                },
                {
                  "role": "努斯妲",
                  "text": "不过我相信，下次他们肯定会第一时间到场，我已经准备好酒了！"
                }
              ]
            },
            {
              "text": "待会儿再来跳舞。",
              "dialogues": [
                {
                  "role": "努斯妲",
                  "text": "没问题！您可以先享受享受这次舞力聚会的美食，让心情和状态达到最棒的状态！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（昂吉安妮&玛因&瑟琪&梅内娅&莫乌）"
        },
        {
          "role": "昂吉安妮",
          "text": "跳舞，好玩！"
        },
        {
          "role": "玛因",
          "text": "好玩。"
        },
        {
          "role": "瑟琪",
          "text": "好好玩！"
        },
        {
          "role": "梅内娅",
          "text": "莫乌也开心起来了吧？"
        },
        {
          "role": "莫乌",
          "text": "呜啊~"
        },
        {
          "role": "昂吉安妮",
          "text": "总之，梅内娅邀请我们来这里度假，真是太棒了。"
        },
        {
          "role": "瑟琪",
          "text": "确实是特别特别好的地方，以后还要多来。"
        },
        {
          "role": "昂吉安妮",
          "text": "哼哼，本小姐可是攒了好多好多摩拉。"
        },
        {
          "role": "昂吉安妮",
          "text": "想吃什么，想玩什么都行，我买单，不要客气！"
        },
        {
          "role": "玛因",
          "text": "谢谢长官。"
        },
        {
          "role": "昂吉安妮",
          "text": "不要叫长官，现在叫姐姐就行！"
        },
        {
          "role": "众美露莘",
          "text": "谢谢昂吉安妮姐姐！"
        }
      ],
      "collapse_ranges": [
