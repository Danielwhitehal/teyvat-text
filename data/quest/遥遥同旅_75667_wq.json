  "stories": [
    {
      "story_id": 75667,
      "title": "遥遥同旅",
      "description": "在悠悠度假村，你遇见了一个正在讲述故事的人…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与胡伊鲁对话"
        },
        {
          "role": "胡伊鲁",
          "text": "你好，旅行者。如果有空的话，你愿意听我讲一个故事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是关于什么的故事？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "胡伊鲁",
          "text": "唔…简单来说，是一个有关于旅行，伙伴和家人的故事。"
        },
        {
          "role": "胡伊鲁",
          "text": "在我们「流泉之众」里，曾经有一位著名的旅行家，名叫阿凯马伊。"
        },
        {
          "role": "胡伊鲁",
          "text": "他和自己的伙伴，鳍游龙卡乌卡乌一起踏上了旅途，立志走遍整个纳塔，吃遍所有美食。"
        },
        {
          "role": "胡伊鲁",
          "text": "每当他们抵达一个地方，阿凯马伊都会和自己的伙伴一起，寻找一块最漂亮的石头作为纪念。"
        },
        {
          "role": "胡伊鲁",
          "text": "他们去了无数个地方，寻找到了许多漂亮的石头，也尝到了许多美食。"
        },
        {
          "role": "胡伊鲁",
          "text": "据说当他们回到「流泉之众」时，阿凯马伊的身材都和我一样了。"
        },
        {
          "role": "胡伊鲁",
          "text": "咳，当然这不是重点。重点在于，他们在旅途上遇见了许多奇妙的故事。"
        },
        {
          "role": "胡伊鲁",
          "text": "旅行者，如果你愿意的话，我可以将这些故事一一告诉你。"
        },
        {
          "role": "胡伊鲁",
          "text": "我保证，这些故事绝对值得你略作驻足。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（胡伊鲁）"
        },
        {
          "role": "胡伊鲁",
          "text": "你好，旅行者。如果有空的话，你愿意听我讲一个故事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我听听看",
              "dialogues": [
                {
                  "role": "胡伊鲁",
                  "text": "请坐在这边吧，我保证，这些故事绝对值得你略作驻足。"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "胡伊鲁",
                  "text": "再见。请先去忙吧，如果想要听故事，随时都可以回来找我。"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
