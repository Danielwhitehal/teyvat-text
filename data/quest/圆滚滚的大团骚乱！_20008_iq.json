  "chapter_title": "圆滚滚的大团骚乱！",
  "type": "iq",
  "route": "Big Pudgy Problem!",
  "stories": [
    {
      "story_id": 20008,
      "title": "圆滚滚的大团骚乱！",
      "description": "史莱姆突然在蒙德城的码头出现，在码头附近的阿瑟尔似乎被卷入其中…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往码头查看详情"
        },
        {
          "type": "subtitle",
          "text": "消灭史莱姆"
        },
        {
          "type": "subtitle",
          "text": "和阿瑟尔对话"
        },
        {
          "role": "阿瑟尔",
          "text": "谢谢，谢谢你救了我。"
        },
        {
          "role": "阿瑟尔",
          "text": "这些史莱姆突然冒出来，我没想到史莱姆会在这里出现，没来得及跑就被它们围住了。"
        },
        {
          "role": "阿瑟尔",
          "text": "你们千万别告诉我爸。我爸本来要我一直呆在家里。他说最近这周围的史莱姆都特别凶。"
        },
        {
          "role": "阿瑟尔",
          "text": "而且史莱姆都开始出现在蒙德城周围了，我已经闷在家里好几天了，今天是偷跑出来的。"
        },
        {
          "role": "阿瑟尔",
          "text": "如果你们愿意的话，能去前面看看吗，如果有史莱姆的话，就请消灭它们吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "阿瑟尔",
                  "text": "太好了！我总算能安心去玩了。"
                }
              ]
            },
            {
              "text": "还有别的急事。",
              "dialogues": [
                {
                  "role": "阿瑟尔",
                  "text": "可，可是，我不敢告诉我爸…能处理这事的只有你，拜托你了！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往异常地点"
        },
        {
          "type": "subtitle",
          "text": "用「风」驱散尘埃"
        },
        {
          "type": "subtitle",
          "text": "消灭全部史莱姆"
        }
      ]
    }
  ]
}