{
  "quest_id": 72280,
  "chapter_num": null,
  "chapter_title": "「御建鸣神主尊大御所大人像」购入须知",
  "type": "wq",
  "route": "Buyer's Guide to the Statue of Her Excellency, the Almighty Narukami Ogosho, God of Thunder",
  "stories": [
    {
      "story_id": 72280,
      "title": "「御建鸣神主尊大御所大人像」购入须知",
      "description": "在限量售卖「御建鸣神主尊大御所大人像」的天顶屋前，似乎发生了什么事情…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与九条裟罗对话"
        },
        {
          "role": "九条裟罗",
          "text": "…五歌仙广场的拥堵已缓解不少，但眼下还未到放松的时刻。兹事体大，决不能掉以轻心，都明白了吗？"
        },
        {
          "role": "阳斗",
          "text": "是！九条裟罗大人！"
        },
        {
          "role": "派蒙",
          "text": "嘿！裟罗——"
        },
        {
          "role": "九条裟罗",
          "text": "哦，是你们？有什么新情况吗。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有什么新的情况…",
              "dialogues": [
                {
                  "role": "九条裟罗",
                  "text": "是么，如此最好。"
                }
              ]
            },
            {
              "text": "关于先前丢书的事…",
              "dialogues": [
                {
                  "role": "九条裟罗",
                  "text": "无论如何，问题解决就好。"
                },
                {
                  "role": "旅行者",
                  "text": "给你们添麻烦了。"
                },
                {
                  "role": "九条裟罗",
                  "text": "职责所在，何来麻烦？"
                }
              ]
            }
          ]
        },
        {
          "role": "九条裟罗",
          "text": "天领奉行奉命维持本次容彩祭的秩序与治安，如有事端，尽管告诉我就是。"
        },
        {
          "role": "派蒙",
          "text": "你们看起来好忙啊，是发生什么大事了吗？"
        },
        {
          "role": "九条裟罗",
          "text": "大事倒也谈不上。这几天我们收到了不少报告，「故意插队」、「倒卖商品」…"
        },
        {
          "role": "九条裟罗",
          "text": "以及「好事之徒霸占拍照板」…虽然都是些小事，一一登记备案，却也要耗去不少人力。"
        },
        {
          "role": "旅行者",
          "text": "辛，辛苦了…"
        },
        {
          "role": "九条裟罗",
          "text": "不过，能收到这么多求助，也从侧面证明，天领奉行正在逐步取回民众的信任吧。"
        },
        {
          "role": "九条裟罗",
          "text": "卫护容彩祭是将军大人的御令，也是难得让民众对天领奉行改观的机会，不容有失。哪怕再累些，也是应有之义了。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，不过再怎么忙，你也还是来这儿了呢——是想去买将军大人的人偶吧？我们也挺想买一个呢。"
        },
        {
          "role": "九条裟罗",
          "text": "什么「人偶」…咳咳，我只是在附近例行巡逻，马上就会离开的。"
        },
        {
          "role": "派蒙",
          "text": "不用那么害羞啦，欸嘿嘿，其实神子有一回告诉过我们，你从前来买人偶的时候，可起了个大早排在第一位呢！"
        },
        {
          "role": "九条裟罗",
          "text": "宫司大人，怎么连这些事都…唉，罢了。"
        },
        {
          "role": "九条裟罗",
          "text": "我素以崇敬之心对待此事，从来无意掩饰。只是有一件事，请你们务必更正。"
        },
        {
          "role": "派蒙",
          "text": "哦？是什么啊？"
        },
        {
          "role": "九条裟罗",
          "text": "那不是什么「人偶」——是「御建鸣神主尊大御所大人像」造型的塑像，明白了吗？"
        },
        {
          "role": "派蒙",
          "text": "御…御建…鸣…明，明白了。"
        },
        {
          "role": "九条裟罗",
          "text": "这次的「御建鸣神主尊大御所大人像」，是初次发售的新款，这一批次的总数不过三百尊，每人限购一尊。"
        },
        {
          "role": "九条裟罗",
          "text": "不少人从凌晨就开始排队，你们在这个时间点来，恐怕是已经错过了。"
        },
        {
          "role": "派蒙",
          "text": "这…真没想到…那裟罗你一定是起了个大早来排的吧？你排到了吗？"
        },
        {
          "role": "九条裟罗",
          "text": "若是放在平日，我自当亲手迎回「御建鸣神主尊大御所大人像」，但眼下还是容彩祭的公务更重要。"
        },
        {
          "role": "九条裟罗",
          "text": "早在店铺开张之前，我们就已经到岗。虽然不舍，但这次也只能放弃了…"
        },
        {
          "role": "派蒙",
          "text": "这样啊…真可惜…"
        },
        {
          "role": "九条裟罗",
          "text": "所以——我已托人代为购买。"
        },
        {
          "role": "派蒙",
          "text": "——原来还能找代购啊！"
        },
        {
          "role": "派蒙",
          "text": "不是说每人限购一个吗？这么热门的人偶…应，应该不好找人代购吧！"
        },
        {
          "role": "九条裟罗",
          "text": "我原本也在为此发愁，但八重宫司大人说是念在我等连日操劳的份上，就找了一位「专业人士」前来帮忙。"
        },
        {
          "role": "九条裟罗",
          "text": "虽然不知道是哪位「专业人士」，但估计是鸣神大社或社奉行所属，我也不便多问。算算时间，应该已经拿到了吧。"
        },
        {
          "role": "九条裟罗",
          "text": "这次幸亏有宫司大人相助，不然这「代购」，确实不好找。"
        },
        {
          "role": "九条裟罗",
          "text": "既要有「起早」的毅力，又要有「高大」的体格，才能抢到最热门的商品…"
        },
        {
          "role": "派蒙",
          "text": "「起早」的毅力，「高大」的体格…"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "？？？",
          "text": "……！"
        },
        {
          "role": "九条裟罗",
          "text": "——嗯？什么声音？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是风声吧。",
              "dialogues": []
            },
            {
              "text": "是树叶吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "九条裟罗",
          "text": "是吗…也罢，我已在这待了挺久，该去下一个会场巡逻了。旅行者，祝你们在容彩祭上，诸事平安。"
        },
        {
          "type": "subtitle",
          "text": "调查奇怪的木桶"
        },
        {
          "role": "早柚",
          "text": "唔…被发现了…"
        },
        {
          "role": "派蒙",
          "text": "早柚！你怎么在这？欸，难道说，你就是…那个「专业人士」？"
        },
        {
          "role": "早柚",
          "text": "嘘——小声点，她说不定还没走远！"
        },
        {
          "role": "旅行者",
          "text": "早柚…你该不会又偷懒了吧。"
        },
        {
          "role": "早柚",
          "text": "没有！我…我为了买到人偶，从昨晚开始就守在这儿了。只是没想到，等啊等啊…眼睛就有点花了…"
        },
        {
          "role": "早柚",
          "text": "——我那时候真的只是想小睡一下，就一下而已！"
        },
        {
          "role": "旅行者",
          "text": "简单来说，就是睡过头吧。"
        },
        {
          "role": "早柚",
          "text": "呜…要是没买到人偶，那个天领奉行的天狗，就会把我抓起来的！"
        },
        {
          "role": "旅行者",
          "text": "不至于不至于…"
        },
        {
          "role": "派蒙",
          "text": "唔欸，神子究竟都跟你说了些什么啊…"
        },
        {
          "role": "早柚",
          "text": "事到如今，只能牺牲掉这个月的工资，从已经买到的人手里收购一个了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我来帮你砍价吧。",
              "dialogues": []
            },
            {
              "text": "我很擅长讲价哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "早柚",
          "text": "真的吗！那太好了…这是我的工资袋…一，一定要省着花哦！"
        },
        {
          "type": "subtitle",
          "text": "向路人询问"
        },
        {
          "role": "康拉德",
          "text": "唉…难得来稻妻一趟，又专门起了个大早，结果还是没排到。"
        },
        {
          "role": "康拉德",
          "text": "这首批发售的数量，比预想中的少了好多啊。下一批也不知道要等到什么时候。"
        },
        {
          "role": "康拉德",
          "text": "这来都来了，要不然…买点别的纪念品来代替吗…"
        },
        {
          "role": "玲花",
          "text": "咦，你们也没有买到吗？真奇怪…我早上过来排队的时候，还专门问过了已经买到的朋友。"
        },
        {
          "role": "玲花",
          "text": "她从凌晨就开始排队，差不多是第一百来位拿到的。而我和她差了不过一百五十位，算起来，应该也可以排到啊？"
        },
        {
          "role": "玲花",
          "text": "嗯…不行，一会儿得去找店主问个明白！"
        },
        {
          "role": "顺平",
          "text": "哼哼，看你们的表情，是没买到这次发售的「御建鸣神主尊大御所大人像」吧？"
        },
        {
          "role": "顺平",
          "text": "卖？我可不打算卖，这可是我花了好大功夫才收到的，你们还是找别人去吧。"
        },
        {
          "type": "subtitle",
          "text": "与早柚对话"
        },
        {
          "type": "subtitle",
          "text": "在附近询问多时，仍旧无果…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "早柚",
          "text": "怎么会，这下真的要完蛋了…"
        },
        {
          "role": "派蒙",
          "text": "好像有不少人都说自己没排到呢，会不会是店家点错数量了？要不然…我们去天顶屋问问吧？"
        },
        {
          "role": "早柚",
          "text": "呜…总比完全没希望了要好…"
        },
        {
          "type": "subtitle",
          "text": "前往天顶屋询问"
        },
        {
          "role": "枫",
          "text": "…实在抱歉，今早我有事不在，请了其他人看店，所以详情我也不是很清楚。但看账目的话，确实是售出了三百份。"
        },
        {
          "role": "康拉德",
          "text": "话说后面这些人偶，就不能摆出来卖吗？"
        },
        {
          "role": "枫",
          "text": "抱歉，这些…都是店里展示用的样品。"
        },
        {
          "role": "枫",
          "text": "各位客人也不必太过遗憾，这次在容彩祭上限量发售的塑像，还只是第一批，将来也还有买到的机会…"
        },
        {
          "role": "玲花",
          "text": "可是等下一批发售，要到什么时候啊？"
        },
        {
          "role": "玲花",
          "text": "还有这位小哥，专程从蒙德赶过来，来得比我还早，起码往前排了五十多位。"
        },
        {
          "role": "玲花",
          "text": "连他也没买到，这数量怎么想都对不上吧？"
        },
        {
          "role": "康拉德",
          "text": "呃…我不太清楚稻妻这边开祭典的情况，不过感觉…确实是卖得特别快啊？"
        },
        {
          "role": "枫",
          "text": "真的是非常抱歉，但今早的账目我已经再三查看过了，应该没有问题…"
        },
        {
          "role": "玲花",
          "text": "嗯…要不然，去请天领奉行的人来调查一下？"
        },
        {
          "role": "早柚",
          "text": "天领…奉行？不——不行！"
        },
        {
          "role": "枫",
          "text": "嗯？你们是…"
        },
        {
          "role": "旅行者",
          "text": "这位是社奉行的「专业人士」。"
        },
        {
          "role": "玲花",
          "text": "咦？这些事情，是归社奉行管的吗？"
        },
        {
          "role": "早柚",
          "text": "欸…唔…没，没错！这件事，我们会去追查的，就…就不用去找天领奉行了！他们也是很忙的嘛，哈哈…"
        },
        {
          "role": "派蒙",
          "text": "奇怪，早柚怎么突然这么有干劲了…"
        },
        {
          "role": "早柚",
          "text": "嘘——要是报告给天领奉行，那个九条裟罗…肯定会来找我问情况啊！到时候，我没买到人偶的事情不就…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕竟是神子找的「专业人士」…",
              "dialogues": []
            },
            {
              "text": "「应该」是最早来排队的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "早柚",
          "text": "总，总之不到万不得已，千万不要惊动天领奉行啊！"
        },
        {
          "role": "玲花",
          "text": "嗯…既然已经有人在调查了，那我就先等一个结果吧。"
        },
        {
          "role": "康拉德",
          "text": "反正来都来了…那，买不到人偶的话，我再看看别的吧。"
        },
        {
          "role": "枫",
          "text": "感谢两位的理解，等调查结果出来，我们一定会尽快公告的。"
        },
        {
          "role": "派蒙",
          "text": "不过，说是要调查，我们现在也没什么线索啊。不会真的只是客人们数错了吧？要是能有个证人，从头排到尾就好了…"
        },
        {
          "role": "旅行者",
          "text": "好像确实有一位从头就在的…"
        },
        {
          "role": "早柚",
          "text": "是，是说我吗…可惜了，我一直在睡觉…"
        },
        {
          "role": "旅行者",
          "text": "睡着的时候有没有听见什么声音？"
        },
        {
          "role": "早柚",
          "text": "声音？让我想想…"
        },
        {
          "role": "康拉德",
          "text": "…选好了，就这些吧。"
        },
        {
          "role": "枫",
          "text": "多谢惠顾！欢迎您下次光临。"
        },
        {
          "role": "早柚",
          "text": "「多谢」…「惠顾」？我想起来了，今早听到了好多次「多谢惠顾」！"
        },
        {
          "role": "派蒙",
          "text": "欸！多少次？正好三百吗？"
        },
        {
          "role": "早柚",
          "text": "这个，就有点…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "也不用数清具体次数…",
              "dialogues": []
            },
            {
              "text": "每次结账用的时间大概是？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "早柚",
          "text": "嗯，嗯…嗯——啊，每次听见「多谢惠顾」…隔了至少十六个呼噜！"
        },
        {
          "role": "派蒙",
          "text": "居然还能这样算吗！"
        },
        {
          "role": "早柚",
          "text": "十六个呼噜，差不多是一分钟，加上前后备货、中间搬箱子的时间…唔…"
        },
        {
          "role": "旅行者",
          "text": "至少需要五个小时。"
        },
        {
          "role": "早柚",
          "text": "对！现在距离开卖也才过去四个多小时，所以数量肯定有问题！"
        },
        {
          "role": "早柚",
          "text": "也，也就是说，就算我现在才醒，也还是有希望买到的！大概…"
        },
        {
          "role": "旅行者",
          "text": "…也不能说完全没有希望嘛。"
        },
        {
          "role": "早柚",
          "text": "总，总之！现在任务失败，肯定是有坏人做了手脚，不是因为早柚偷懒！"
        },
        {
          "role": "派蒙",
          "text": "那么，究竟是谁在做坏事呢？"
        },
        {
          "role": "早柚",
          "text": "唔，这次限购管得很严，不仅每人只能买一份，连身份都要专门核实登记…所以不会有人多排多买。"
        },
        {
          "role": "旅行者",
          "text": "难怪每次结账的时间都不短…"
        },
        {
          "role": "派蒙",
          "text": "有裟罗他们在维持秩序，也不会有人随便插队吧？"
        },
        {
          "role": "旅行者",
          "text": "排除其他可能…"
        },
        {
          "role": "旅行者",
          "text": "剩下的就是…"
        },
        {
          "role": "派蒙",
          "text": "如果真的有坏人动了手脚，那肯定会想办法，再把弄到的人偶高价卖出去吧！"
        },
        {
          "role": "派蒙",
          "text": "我们去找刚刚那位花大功夫收到的人问问吧！说不定会有什么线索。"
        },
        {
          "type": "subtitle",
          "text": "与顺平对话"
        },
        {
          "role": "顺平",
          "text": "想知道我收购「御建鸣神主尊大御所大人像」的门路？哼哼，想都别想！"
        },
        {
          "role": "派蒙",
          "text": "欸？为什么啊？又不是要收走你的人偶…"
        },
        {
          "role": "顺平",
          "text": "别问了，不说就是不说。"
        },
        {
          "role": "早柚",
          "text": "怎么会这样…"
        },
        {
          "role": "旅行者",
          "text": "因为是内部人员卖给你的吧。"
        },
        {
          "role": "顺平",
          "text": "你——你怎么知道的？"
        },
        {
          "role": "旅行者",
          "text": "我们是「专业人士」。"
        },
        {
          "role": "早柚",
          "text": "欸？欸…对，我们，我们是「专业人士」！"
        },
        {
          "role": "顺平",
          "text": "唉，好吧，既然你们都猜到了的话…先说好，可不要随便声张啊。"
        },
        {
          "role": "顺平",
          "text": "我一早就来排队，结果第一批塑像却早早地卖完了。我不甘心，就跑到天顶屋后门，想找店员打探下一批发售的时间…"
        },
        {
          "role": "顺平",
          "text": "没想到却看见他正在把一箱又一箱的塑像往外搬！我当时就想上去问这是怎么一回事，然后就…"
        },
        {
          "role": "旅行者",
          "text": "然后他就用人偶让你封口了？"
        },
        {
          "role": "顺平",
          "text": "这，是没错…不过我也是好好付了钱，从店员手里正正当当给买下的！"
        },
        {
          "role": "九条裟罗",
          "text": "正不正当，可不由你说了算。"
        },
        {
          "role": "顺平",
          "text": "啊，是…天领奉行？"
        },
        {
          "role": "九条裟罗",
          "text": "天领奉行接到线报，有人趁容彩祭囤积居奇，高价倒卖。虽然这些塑像并非战略物资，价格涨跌也是正常的市场现象…"
        },
        {
          "role": "九条裟罗",
          "text": "但内部人员借职权之便伪造假账，挪用货品，却已经是不折不扣的违法了！"
        },
        {
          "role": "九条裟罗",
          "text": "我们已经调查过天顶屋的情况，账目虽然无误，但钱箱中的摩拉，却有两袋被掺了石块。"
        },
        {
          "role": "顺平",
          "text": "这…这怎么会…"
        },
        {
          "role": "九条裟罗",
          "text": "作为证据，请上缴你的「御建鸣神主尊大御所大人像」。至于你的损失，等不法之徒落网后，会如数退还给你的。"
        },
        {
          "role": "顺平",
          "text": "唉，好吧，没想到，他居然还造了假账…"
        },
        {
          "type": "subtitle",
          "text": "顺平乖乖上缴了人偶…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "没想到，裟罗你们这么快就注意到他们的动静了啊。"
        },
        {
          "role": "九条裟罗",
          "text": "我们也是刚刚得到线索，还没调齐人手缉捕…嗯？这位是…"
        },
        {
          "role": "早柚",
          "text": "噫！被抓住了…"
        },
        {
          "role": "旅行者",
          "text": "这位是早柚…"
        },
        {
          "role": "九条裟罗",
          "text": "哦？你就是宫司大人请来的「专业人士」吗？我正想着怎么一直没见到你呢…"
        },
        {
          "role": "早柚",
          "text": "呃…我们…正忙着调查人偶…啊，调查「御建鸣神主尊大御所大人像」数量不对的事情…"
        },
        {
          "role": "九条裟罗",
          "text": "是吗，有劳你们了，不过接下来有天领奉行接手，应该不会出大问题了。"
        },
        {
          "role": "早柚",
          "text": "呃…"
        },
        {
          "role": "九条裟罗",
          "text": "嗯？"
        },
        {
          "role": "早柚",
          "text": "呃…其实…关于「御建鸣神主尊」…"
        },
        {
          "role": "旅行者",
          "text": "其实早柚昨晚就来排队了哦。"
        },
        {
          "role": "九条裟罗",
          "text": "是吗？真是辛苦你了，那么「御建鸣神主尊大御所大人像」现在何处…"
        },
        {
          "role": "旅行者",
          "text": "——然后撞见了偷藏塑像的现场！"
        },
        {
          "role": "派蒙",
          "text": "哦——对对对，然后早柚一整晚都在调查店员的底细呢！结果赶回来的时候，刚好错过了发售时间…"
        },
        {
          "role": "早柚",
          "text": "…是，是！要是没被偷藏的话，我赶回来的时候，就刚好能买到了！"
        },
        {
          "role": "九条裟罗",
          "text": "这样吗…结果，还是没能买到吗。"
        },
        {
          "role": "早柚",
          "text": "呜…对不起…"
        },
        {
          "role": "九条裟罗",
          "text": "…此事是因歹人作恶而起，眼下当以公务为重，速速制定缉捕方案——你也不必太过自责了。"
        },
        {
          "role": "早柚",
          "text": "嗯…"
        },
        {
          "role": "九条裟罗",
          "text": "根据情报，嫌犯已开始在会场附近高价倒卖，但位置十分隐蔽，行动也很谨慎。"
        },
        {
          "role": "九条裟罗",
          "text": "直接追击，可能让他们铤而走险，销毁证物；暗中包围，就需要有人先去吸引他们的注意…"
        },
        {
          "role": "九条裟罗",
          "text": "既然你们已经彻夜调查，摸清了这人的底细，想要取得他的信任，想来也没有比你们更合适的人物了。"
        },
        {
          "role": "九条裟罗",
          "text": "不知诸位，是否愿意再助天领奉行一臂之力？"
        },
        {
          "role": "早柚",
          "text": "欸？欸…没错！就交给我们吧，哈哈，哈…"
        },
        {
          "type": "subtitle",
          "text": "前往会场附近的交易地点"
        },
        {
          "role": "清刚",
          "text": "嗯？你们是哪位介绍来的？现在风头正紧，如果不是旧客介绍，恕不接待。"
        },
        {
          "role": "旅行者",
          "text": "撞见你藏东西的那位。"
        },
        {
          "role": "清刚",
          "text": "啧…原来是那家伙。行吧，好歹也算是从这儿买过货的人…"
        },
        {
          "role": "清刚",
          "text": "不过先说好了，这东西可正紧俏着呢，就别想用跟他一样的价格买下了。"
        },
        {
          "role": "派蒙",
          "text": "又涨价了？这才过去几个小时啊！"
        },
        {
          "role": "清刚",
          "text": "哼，你不想买我还不想卖呢，这升值空间可大得很，要不是急着脱手…呵，你看现在哪里还有得收啊。"
        },
        {
          "role": "早柚",
          "text": "唔…旅行者，记得多跟他讲一会儿价…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你这人偶它保值吗？",
              "dialogues": []
            },
            {
              "text": "能不能再小刀一下？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "清刚",
          "text": "别叨叨了，直接报个价钱吧。"
        },
        {
          "type": "subtitle",
          "text": "佯装购买拖延时间"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "(价格合适)",
              "dialogues": [
                {
                  "role": "清刚",
                  "text": "成交，那么我们这就约个时间拿货吧。"
                },
                {
                  "role": "派蒙",
                  "text": "等等！我，我感觉，价格还是有点高…"
                },
                {
                  "role": "清刚",
                  "text": "高？哼，过上几天，还要再翻一番呢！"
                }
              ]
            },
            {
              "text": "(价格较低)",
              "dialogues": [
                {
                  "role": "清刚",
                  "text": "啧，行吧行吧，要不是急着出手，哼…"
                },
                {
                  "role": "派蒙",
                  "text": "等等！我，我感觉，还能再谈一谈…"
                },
                {
                  "role": "清刚",
                  "text": "这还谈什么呢？你到底要不要吧！"
                }
              ]
            },
            {
              "text": "(价格过低)",
              "dialogues": [
                {
                  "role": "清刚",
                  "text": "喂，就这么点儿钱，你干脆叫我白送给你得了！"
                },
                {
                  "role": "清刚",
                  "text": "嗯…不行不行，按现在的行情，还得再高点儿。"
                }
              ]
            },
            {
              "text": "(失败)",
              "dialogues": [
                {
                  "role": "清刚",
                  "text": "够了，我可没功夫陪你们耗下去了。"
                }
              ]
            }
          ]
        },
        {
          "role": "清刚",
          "text": "你们就是来消遣我的吧？不想买就别在这儿胡搅蛮缠了。吵吵闹闹的，都来不及换地方了…"
        },
        {
          "role": "九条裟罗",
          "text": "不必换了——以公谋私，伪造账目，罪证确凿，跟我们到奉行所走一趟吧。"
        },
        {
          "role": "清刚",
          "text": "——天领奉行？什么时候…难道是，刚才讲价…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，束手就擒吧！"
        },
        {
          "type": "subtitle",
          "text": "天领奉行众将店员押回了奉行所…早柚也高兴地保下了工资。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "九条裟罗",
          "text": "多谢诸位协助，他已将藏匿货品的地点供出，我们正派人前去收缴。"
        },
        {
          "role": "派蒙",
          "text": "这下好了，等天顶屋清点好了上架，我们就能重新排队买到了吧？"
        },
        {
          "role": "早柚",
          "text": "这次…一定要完成任务！"
        },
        {
          "role": "九条裟罗",
          "text": "…恐怕不行。被藏匿的货品，要作为证据在奉行所保留一段时间。短时间内，应该不能重新上架了。"
        },
        {
          "role": "派蒙",
          "text": "这，怎么会这样…"
        },
        {
          "role": "九条裟罗",
          "text": "…烦请你们将此事告知店主，我先行一步，回奉行所看看情况。"
        },
        {
          "type": "subtitle",
          "text": "将情况告知枫"
        },
        {
          "role": "派蒙",
          "text": "裟罗虽然什么都没说，但其实…还是有点伤心吧？"
        },
        {
          "role": "早柚",
          "text": "呜…真的没什么办法了吗…"
        },
        {
          "role": "枫",
          "text": "…原来如此，辛苦你们了。我们会尽快拟好补偿方案，再贴出告示的。"
        },
        {
          "role": "旅行者",
          "text": "那我们就先告辞了…"
        },
        {
          "role": "枫",
          "text": "啊，请稍等——这是我们店里展示用的「御建鸣神主尊大御所大人像」，虽说是样品…"
        },
        {
          "role": "枫",
          "text": "但我想…不如就送给你们，作为答谢吧。"
        },
        {
          "role": "枫",
          "text": "这次也怪我们店里审查不周，才给各位添了麻烦。小小赠礼，难表歉意，但还请你们务必收下。"
        },
        {
          "role": "早柚",
          "text": "真，真的吗？"
        },
        {
          "role": "旅行者",
          "text": "把这个给裟罗怎么样？"
        },
        {
          "role": "早柚",
          "text": "嗯…只要把这只人偶交给裟罗，就算完成任务了吧。"
        },
        {
          "role": "早柚",
          "text": "不好…紧张了半天，突然放心下来，马上就想睡觉了…"
        },
        {
          "role": "早柚",
          "text": "旅行者，拜托你…再把这只人偶送到奉行所吧…呼呼…"
        },
        {
          "role": "早柚",
          "text": "早柚…终于不用再工作了…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（枫、早柚）"
        },
        {
          "role": "枫",
          "text": "这次也怪我们店里审查不周，才给各位添了麻烦。小小赠礼，难表歉意，但还请你们务必收下。"
        },
        {
          "role": "早柚",
          "text": "（将耳朵贴近木桶，可以听见细微的鼾声…还是不要打扰她的美梦了。）"
        },
        {
          "type": "subtitle",
          "text": "前往奉行所与裟罗对话"
        },
        {
          "role": "派蒙",
          "text": "裟罗——你看我们给你带什么来了！"
        },
        {
          "role": "九条裟罗",
          "text": "嗯，这难道是…？"
        },
        {
          "type": "subtitle",
          "text": "取出「御建鸣神主尊大御所大人像」，解释了来龙去脉…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "之前忙来忙去的，都没好好欣赏过呢。仔细一看，这做工可真不赖啊…"
        },
        {
          "role": "九条裟罗",
          "text": "那是当然。这是由八重堂最顶尖的绘师设计原型，稻妻城最老练的漆器师傅手工打造…"
        },
        {
          "role": "九条裟罗",
          "text": "若非如此，又怎能还原出将军大人庄严宝相的千分之一？"
        },
        {
          "role": "九条裟罗",
          "text": "想要让容光常驻，历久弥新，还需要选购特制的神龛，悉心供奉。"
        },
        {
          "role": "九条裟罗",
          "text": "务须时时勤拂拭，勿使染尘埃，最好再请位匠人上门保养…"
        },
        {
          "role": "派蒙",
          "text": "裟罗…裟罗！"
        },
        {
          "role": "九条裟罗",
          "text": "嗯？怎么了，这「御建鸣神主尊大御所大人像」的保养之道，我总结了五条要旨，这第一条都还没有说完呢…"
        },
        {
          "role": "影",
          "text": "这小小人偶，竟有如此多的说法…却未听神子与我提起。"
        },
        {
          "role": "九条裟罗",
          "text": "——将…将军大人？！您怎么会…"
        },
        {
          "role": "影",
          "text": "闲来无事，出天守阁看看而已。嗯？这人偶，可是你买下的？"
        },
        {
          "role": "九条裟罗",
          "text": "这…是…是…"
        },
        {
          "role": "九条裟罗",
          "text": "——是他。"
        },
        {
          "role": "派蒙",
          "text": "欸欸——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没错。",
              "dialogues": []
            },
            {
              "text": "是我。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "影",
          "text": "哦？旅行者，没想到你也会中意这些小物件。"
        },
        {
          "role": "九条裟罗",
          "text": "将军大人…容彩祭的防务尚未布置妥当，请恕属下先行告退了。"
        },
        {
          "role": "影",
          "text": "嗯，有劳你们了。"
        },
        {
          "type": "subtitle",
          "text": "裟罗低着头离开了…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "裟罗的背影…看起来有点伤心。"
        },
        {
          "role": "影",
          "text": "…旅行者，天守阁中还有一只人偶，是八重堂送来的样品。放着于我也无用处，不如送给你们。"
        },
        {
          "role": "旅行者",
          "text": "可这里已经有一只了…"
        },
        {
          "role": "影",
          "text": "君无戏言。既然已经说了要赠予你们，要怎么处置，自然随你们便——再转赠他人，也并无不可。"
        },
        {
          "role": "影",
          "text": "若是嫌转送麻烦，我直接差人从府上送去亦可…只是这送礼之人，自当写你的名字。"
        },
        {
          "role": "派蒙",
          "text": "咦…为什么要弄得那么麻烦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙…",
              "dialogues": []
            },
            {
              "text": "不要再问了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "影",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "送到天领奉行府上就好。",
              "dialogues": []
            },
            {
              "text": "送礼人就写「旅行者」吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "影",
          "text": "如此甚好，我回去就差人准备。"
        },
        {
          "role": "影",
          "text": "对了，祝你们在容彩祭上，顺遂无虞，皆得所愿。"
        }
      ],
      "collapse_ranges": [
        [
          202,
          204
        ]
      ]
    }
  ]
}