{
  "quest_id": 22045,
  "chapter_num": null,
  "chapter_title": "猫的留影",
  "type": "iq",
  "route": "Shadow of the Cat",
  "stories": [
    {
      "story_id": 22045,
      "title": "猫的留影",
      "description": "在浅濑神社工作的大岛纯平似乎正在为木雕的事而发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与大岛纯平对话"
        },
        {
          "role": "大岛纯平",
          "text": "嗯…这种感觉不太对啊…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "大岛纯平",
          "text": "旅行者！你来得正好，我正想找你呢！"
        },
        {
          "role": "大岛纯平",
          "text": "最近我制作木雕的时候，总觉得…制作出来的木雕没有灵性…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕竟是木雕嘛。",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "哎呀，不能这么说…"
                }
              ]
            },
            {
              "text": "你要追求什么样的「灵性」？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "嗯…怎么和你形容呢？简单来说，我想要的「灵性」就是一种…活力。"
        },
        {
          "role": "大岛纯平",
          "text": "你看，代宫司大人虽然平时都在睡觉，但偶尔也会起来转悠的。"
        },
        {
          "role": "大岛纯平",
          "text": "转悠的时候，代宫司大人偶尔就会跳一跳，扑扑落叶，或者是伸伸懒腰什么的…"
        },
        {
          "role": "大岛纯平",
          "text": "这些动作，就是我想要的那种活力。我想…以这种动作为原型制作的雕像，应该也有着我想要的那种「灵性」…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你直接去观察呗…",
              "dialogues": []
            },
            {
              "text": "寝子不就在那边吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "哎呀，我这…不是不好意思去嘛…"
        },
        {
          "role": "大岛纯平",
          "text": "代宫司大人怎么说都是发我工钱的老板，总是蹲在它旁边观察，总感觉会惹代宫司大人不高兴…"
        },
        {
          "role": "大岛纯平",
          "text": "你应该和代宫司大人关系很好吧，就请你帮我去拍几张画片回来给我参考吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道了。",
              "dialogues": []
            },
            {
              "text": "如果拍不到那种动作…",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "没关系，不用专门拍那种大动作，以我现在的技术，也雕不好那种大动作…"
                },
                {
                  "role": "大岛纯平",
                  "text": "只要拍下代宫司大人的一些小姿态，就足够我练习了。"
                }
              ]
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "那就拜托你了，拍好画片之后，就快点拿来给我吧。"
        },
        {
          "type": "subtitle",
          "text": "从右侧为寝子拍摄画片"
        },
        {
          "role": "大岛纯平",
          "text": "拍画片的事就拜托你了，拍到画片之后就快拿来给我吧。"
        },
        {
          "type": "subtitle",
          "text": "从左侧为寝子拍摄画片"
        },
        {
          "role": "「寝子」",
          "text": "唔？汝等在做什么呢？"
        },
        {
          "role": "旅行者",
          "text": "在拍画片。"
        },
        {
          "role": "「寝子」",
          "text": "…那是什么？汝等，真是奇怪啊。"
        },
        {
          "role": "「寝子」",
          "text": "算了，汝等继续吧，只要别把神社弄乱了就行。"
        },
        {
          "type": "subtitle",
          "text": "将画片交给大岛纯平"
        },
        {
          "role": "大岛纯平",
          "text": "怎么样，你们拍到画片了吗？"
        },
        {
          "role": "旅行者",
          "text": "已经拍到了。"
        },
        {
          "role": "大岛纯平",
          "text": "我看看…喔！这角度，这姿态，真不错！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "气势…",
              "dialogues": []
            },
            {
              "text": "这些能做参考吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "绝对没问题，这些画片用来做参考再好不过了。"
        },
        {
          "role": "大岛纯平",
          "text": "谢谢你帮忙旅行者，这些东西请你收下，我等会就去接着练习木雕。"
        },
        {
          "role": "大岛纯平",
          "text": "哎呀，真不错…"
        }
      ]
    }
  ]
}