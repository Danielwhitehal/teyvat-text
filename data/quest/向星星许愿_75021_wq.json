{
  "quest_id": 75021,
  "chapter_num": null,
  "chapter_title": "向星星许愿",
  "type": "wq",
  "route": "To Wish Upon a Star",
  "stories": [
    {
      "story_id": 75021,
      "title": "向星星许愿",
      "description": "在野外遇到了寻找星星碎片的小孩…",
      "dialogues": [
        {
          "role": "奥尔科",
          "text": "爸爸肯定也会高兴的…"
        },
        {
          "role": "奥尔科",
          "text": "哥哥在犹豫什么？快把失散的碎片放回星星上吧。"
        },
        {
          "role": "奥尔科",
          "text": "哇！好厉害，你们找到全部的星星碎片了！"
        },
        {
          "role": "奥尔科",
          "text": "我平时给卡卡妈妈帮忙，攒下不少零花钱，这些摩拉全给你们，把星星碎片卖给我吧。"
        },
        {
          "role": "派蒙",
          "text": "星星碎片？你知道它们是做什么用的吗？呃，在这之前，你一个小孩子为什么独自在这种地方呀？"
        },
        {
          "role": "奥尔科",
          "text": "…别人都叫我奥尔科，你们也可以这样叫我。虽然现在的名字不过是个代号罢了…"
        },
        {
          "role": "奥尔科",
          "text": "我就是为了收集星星碎片才到这里来的，你们也看到下面的大石头了吧，那就是从天上掉下来的星星。"
        },
        {
          "role": "奥尔科",
          "text": "只要把失散的碎片交还给它，就能获得失去的力量…拜托了，哥哥姐姐，我真的很需要这些星星碎片…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来好可疑…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯…不过也算是线索吧，要不就我们一起试试看？"
                }
              ]
            },
            {
              "text": "还有这种好事？那更不能给你了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对方只是个小孩子而已，不用这么较真吧。而且他说的话也不知道是真是假，不如就我们一起试试看？"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "话说回来，什么星星碎片、失去的力量…听起来就像是小说里的情节呢。"
        },
        {
          "role": "奥尔科",
          "text": "你们都没听说过奎伊露和乌库库的故事吗？这个就送给你们好了，爸爸给我讲过很多遍，我已经倒背如流了。"
        },
        {
          "role": "奥尔科",
          "text": "但现在要紧的是，我们先一起下去吧。"
        },
        {
          "role": "？？？",
          "text": "和奥尔科一起来到「坠落的星星」前…"
        },
        {
          "role": "奥尔科",
          "text": "哥哥，快把失散的碎片放回星星上吧。哇…我会觉醒什么力量呢？说不定能去到天上…嘿嘿。"
        },
        {
          "role": "派蒙",
          "text": "喂，你在这里干什么呢？"
        },
        {
          "role": "奥尔科",
          "text": "…哇！吓死我了，万一掉下去了你怎么赔我？隐藏力量还没有觉醒的现在，我只是个无力的小孩啊。"
        },
        {
          "role": "派蒙",
          "text": "啊，抱歉，我不是故意要吓你的。不过…隐藏力量？是很厉害的绝招之类的吗？"
        },
        {
          "role": "奥尔科",
          "text": "既然是隐藏起来的力量，我哪会知道它到底是什么。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好有道理。",
              "dialogues": []
            },
            {
              "text": "小小年纪，歪理倒是不少。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥尔科",
          "text": "先不说这些了，你们能帮我找回星星碎片吗？我平时给卡卡妈妈帮忙，攒下不少零花钱，这些摩拉全给你们。"
        },
        {
          "role": "派蒙",
          "text": "既然有求于人，至少先报上名来吧。顺带一提，我是派蒙，他是旅行者。"
        },
        {
          "role": "奥尔科",
          "text": "现在的名字不过是个代号罢了…别人都叫我奥尔科，你们也可以这样叫我。那星星碎片的事，你们愿意帮忙吗？"
        },
        {
          "role": "派蒙",
          "text": "唔，说到底，星星碎片到底是什么东西呀？听起来不像是能轻易找到的东西呢。"
        },
        {
          "role": "奥尔科",
          "text": "那是星星从天上掉下来的时候失散的碎片，只要把它们找到并且放回原处，就能获得曾经失去的力量。"
        },
        {
          "role": "奥尔科",
          "text": "你们瞧，从天上掉下来的星星就在下面，在那儿肯定可以找到星星碎片的线索。好心的哥哥姐姐，帮帮我嘛。"
        },
        {
          "role": "派蒙",
          "text": "好啦好啦，那就帮你这一次。不过话说回来，什么星星碎片、失去的力量…就像是小说里的情节呢。"
        },
        {
          "role": "奥尔科",
          "text": "你们都没听说过奎伊露和乌库库的故事吗？这个就送给你们好了，爸爸给我讲过很多遍，我已经倒背如流了。"
        },
        {
          "role": "奥尔科",
          "text": "但现在要紧的是，我们先一起下去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "和奥尔科一起下去"
        },
        {
          "type": "subtitle",
          "text": "与奥尔科对话"
        },
        {
          "role": "奥尔科",
          "text": "呼——我一个人肯定下不来，谢谢你们。"
        },
        {
          "role": "派蒙",
          "text": "这个就是天上掉下来的星星吗？这么凑近看的话…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "啊啊体内涌出了神秘的力量！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？！真的吗？不对，不是还没找到失散的碎片吗！"
                },
                {
                  "role": "派蒙",
                  "text": "话说回来，这里真的有碎片的线索吗？一点头绪也没有…"
                }
              ]
            },
            {
              "text": "好怪的石头。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "的确很独特…不过是我太迟钝了吗？并没有感受到神秘的力量…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那我们接下来该怎么办呢？"
        },
        {
          "role": "奥尔科",
          "text": "只有靠大力了吧。<color=#00E1FFFF>用嵴锋龙那么大的力气拍拍它</color>说不定就能知道失散的碎片在哪里了。"
        },
        {
          "role": "奥尔科",
          "text": "大部分的问题都可以靠蛮力解决，爸爸是这么说的。但我还没有觉醒力量，也没有自己的龙…就拜托哥哥姐姐了。"
        },
        {
          "type": "subtitle",
          "text": "收集失散的星星碎片"
        },
        {
          "type": "subtitle",
          "text": "与奥尔科对话"
        },
        {
          "role": "派蒙",
          "text": "应该就这些了吧？这次的委托比想象中简单很多呢！不过，真的有这么神奇吗？之前还有点半信半疑的…"
        },
        {
          "role": "旅行者",
          "text": "派蒙也想觉醒隐藏力量吗？"
        },
        {
          "role": "派蒙",
          "text": "那当然啦，要是有什么超强宝箱搜寻能力，或者超级大力可以一拳一个魔物，不是很便利嘛！旅行者难道不想要吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我需要更多力量！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦哦！"
                }
              ]
            },
            {
              "text": "我已经够强了所以不需要。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？不是都说，在追求力量的路上是不应该有尽头的…"
                }
              ]
            }
          ]
        },
        {
          "role": "奥尔科",
          "text": "哥哥，快把失散的碎片放回星星上吧。哇…我会觉醒什么力量呢？说不定能去到天上…嘿嘿。"
        },
        {
          "type": "subtitle",
          "text": "将失散的碎片归还"
        },
        {
          "type": "subtitle",
          "text": "等待隐藏力量觉醒…"
        },
        {
          "type": "subtitle",
          "text": "与奥尔科对话"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你有感觉到什么不可思议的力量吗？"
        },
        {
          "role": "旅行者",
          "text": "没什么特别的感觉。"
        },
        {
          "role": "派蒙",
          "text": "这块大石头也没什么变化呢，没有发出神秘光芒，也没有突然震动起来或者干脆裂开。"
        },
        {
          "role": "派蒙",
          "text": "呃，会不会是刚才念的咒语不对？虽然听起来像模像样的…"
        },
        {
          "role": "派蒙",
          "text": "但是我们在遗迹探险时偶尔也会遇到这种情况呢！只是记错了某个密码或者暗号，机关就完全没反应。"
        },
        {
          "role": "奥尔科",
          "text": "真奇怪…这些话是别人告诉我的，说是只要这样做了，就能解放隐藏的力量。"
        },
        {
          "role": "奥尔科",
          "text": "告诉我这件事的人当时念完之后没过一会儿就捂着眼睛发出痛苦的声音，但是在那之后就获得了能分辨宝石价值的「魔眼」呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哇，真是太酷了！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "欸？我倒是觉得相当可疑呢。"
                }
              ]
            },
            {
              "text": "这症状听起来有点耳熟…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卡卡妈妈",
          "text": "哎哟！可算让我找到了，小傻瓜，怎么跑到这种地方来！你爸爸找不到你，在家都急坏了。"
        },
        {
          "role": "奥尔科",
          "text": "我都跟他说了到吃饭时间会自己回去的，有必要让卡卡妈妈知道吗…"
        },
        {
          "role": "卡卡妈妈",
          "text": "还顶嘴呢。旁边两个小朋友也别在下边耽搁了，在下面呆久了谁知道有什么危险！"
        },
        {
          "role": "？？？",
          "text": "带奥尔科一起回到了地面，并且说明了情况…"
        },
        {
          "role": "卡卡妈妈",
          "text": "唉，他说的那些东西，都是小孩子乱想，也难为你们陪他胡闹。"
        },
        {
          "role": "卡卡妈妈",
          "text": "这孩子因为从小妈妈不在身边，爸爸眼睛又不方便，没人管教，顽皮得很。我作为邻居虽然也想帮衬点，但毕竟精力有限。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样。我就知道！哪会有这么好的事，只是收集几个石头碎片就能获得神秘力量什么的。"
        },
        {
          "role": "奥尔科",
          "text": "我这不是顽皮，是为了爸爸…"
        },
        {
          "role": "卡卡妈妈",
          "text": "小傻瓜，就是不肯听比你懂得多的人的劝告。这次倒是平安无事，但万一哪天酿成大祸不就晚了么？"
        },
        {
          "role": "卡卡妈妈",
          "text": "行了行了，你先老实跟我回去。"
        },
        {
          "role": "奥尔科",
          "text": "好吧，不过在那之前…哥哥姐姐，我们说好的，这些摩拉全都给你们。"
        },
        {
          "role": "卡卡妈妈",
          "text": "你们收下吧，不能让他做个言而无信的人。"
        },
        {
          "role": "派蒙",
          "text": "既然你们这样说…那我们就不推辞了。"
        },
        {
          "role": "奥尔科",
          "text": "嗯，说不定以后还要麻烦你们呢，这次失败了，不代表下次就不会成功嘛。"
        },
        {
          "role": "派蒙",
          "text": "欸？"
        },
        {
          "role": "卡卡妈妈",
          "text": "你这孩子…"
        },
        {
          "role": "奥尔科",
          "text": "卡卡妈妈，我们走吧，别让爸爸等急了。好心的哥哥姐姐，那就再见咯！"
        }
      ]
    }
  ]
}