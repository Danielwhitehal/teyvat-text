{
  "quest_id": 74507,
  "chapter_num": null,
  "chapter_title": "小小灵蕈大幻戏！",
  "type": "wq",
  "route": "Lil' Fungi's Fun-Tastic Fiesta!",
  "stories": [
    {
      "story_id": 74507,
      "title": "小小灵蕈大幻戏！",
      "description": "在枫丹廷利奥奈区繁华的街道上，你与派蒙居然发现了一闪而过的蕈兽影踪…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往蕈兽出没的位置调查"
        },
        {
          "role": "派蒙",
          "text": "咦？难道是我眼花了吗？"
        },
        {
          "role": "派蒙",
          "text": "刚才，前边飘过去的好像是…一只蕈兽？难道有蕈兽入侵枫丹了？"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们快跟过去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "与摊位旁的两人对话"
        },
        {
          "role": "蒂蕾娜",
          "text": "多谢配合，资质审查已完成，你的伙伴们也都很安全，不会对枫丹市民和生态环境造成任何威胁。"
        },
        {
          "role": "蒂蕾娜",
          "text": "根据《枫丹外来物种管理法》与《利奥奈区商业行为规范》，你可以继续举办活动了。"
        },
        {
          "role": "？？？",
          "text": "有劳你了，蒂蕾娜小姐。"
        },
        {
          "role": "？？？",
          "text": "没想到在枫丹举办活动的流程居然这么复杂，比在奥摩斯港多出十来个环节，看来我之前做的准备还不够啊…"
        },
        {
          "role": "蒂蕾娜",
          "text": "不用客气，更不必自责，你和你的蕈兽伙伴属于特别的来客。"
        },
        {
          "role": "蒂蕾娜",
          "text": "执律庭很少接触蕈兽这一外来物种，有必要谨慎行事，所以花了不少时间来观察和评估。"
        },
        {
          "role": "蒂蕾娜",
          "text": "接下来，我会将你的委托转达给其他警备队员。"
        },
        {
          "role": "蒂蕾娜",
          "text": "如果见到了传说中的「黄金流星」和「白银伴星」，队员们会通知他们(她们)，请两位贵客直接来这里找你的…"
        },
        {
          "role": "蒂蕾娜",
          "text": "预祝你们的「小小灵蕈大幻戏」活动举办顺利，在枫丹廷玩得开心…如有需要，我随叫随到。"
        },
        {
          "role": "？？？",
          "text": "啊，看来不用麻烦你们了，他们(她们)已经找过来了。"
        },
        {
          "role": "蒂蕾娜",
          "text": "慢着慢着！你说的「黄金流星」和「白银伴星」…居然是这两位…「超天顶领队级战力」？"
        },
        {
          "role": "派蒙",
          "text": "哇啊！你们俩的话题怎么突然转向我们了？还有这奇奇怪怪的称号…"
        },
        {
          "role": "？？？",
          "text": "你们两位还是一如既往啊——神采奕奕，容光焕发，一出现就令人安心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谁？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你你你，你是哪位？我们之前见过吗？"
                },
                {
                  "role": "？？？",
                  "text": "嗯…你们两位没印象了，是我的失误，我应该尽力你们保持联络，多写几封信的。"
                },
                {
                  "role": "？？？",
                  "text": "很久以前，须弥举办了一场「月莲杯驯兽师大赛」。当时，我抱着偏执的想法参加了比赛，想要做些危险的事…"
                },
                {
                  "role": "？？？",
                  "text": "是你们打醒了我，让我改过自新，不再仇视善良的蕈兽伙伴，而是找到一条与它们共同生活的正确道路。"
                },
                {
                  "role": "？？？",
                  "text": "那次大赛最后，你成为了「月莲杯驯兽师大赛」的最终决定人，而我承诺，会为你献出全力，继续把大赛办好…"
                }
              ]
            },
            {
              "text": "我是不是在哪里见过你？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这个声音，总觉得有点耳熟，但我们以前认识这样的淑女吗？"
                },
                {
                  "role": "派蒙",
                  "text": "看你的样子，晒得有点黑的皮肤，似乎不是枫丹本地人？"
                },
                {
                  "role": "派蒙",
                  "text": "等等，我好像有点印象了，虽然有点不敢相信…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "难道说，你是…海妮耶？一直帮我们照顾着「咚咚小圆帽」和其他蕈兽伙伴的海妮耶？"
        },
        {
          "role": "海妮耶",
          "text": "没错，确实是我，好久不见了，「黄金流星」和「白银伴星」，两位老板！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "新衣服很漂亮！",
              "dialogues": []
            },
            {
              "text": "谈吐也好礼貌！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你现在的样子，我们根本认不出来嘛！变化太太太…太大了，说话的方式也不一样了！"
        },
        {
          "role": "派蒙",
          "text": "为什么会这样呢？难道说…是为了带着蕈兽伙伴们在枫丹旅游的…仪式感？"
        },
        {
          "role": "蒂蕾娜",
          "text": "咳咳，其实枫丹廷对游客没有着装要求，就算穿着朴素的猎户服装，也不会被人冷眼相待的…"
        },
        {
          "role": "蒂蕾娜",
          "text": "海妮耶小姐着装已经不止于满足仪式感了，而是太优雅了，优雅至极！"
        },
        {
          "role": "海妮耶",
          "text": "实在感谢！得到了你们的肯定，我更有底气了。"
        },
        {
          "role": "海妮耶",
          "text": "言归正传，这次我来枫丹，是为了给正式的蕈兽大赛寻找可靠的投资方，并用预热活动宣传蕈兽的可爱之处，提前吸引受众。"
        },
        {
          "role": "海妮耶",
          "text": "左右加说，我们正在进行跨国的商业事务，枫丹人非常讲究穿衣打扮的细节，我们要入乡随俗才行。"
        },
        {
          "role": "海妮耶",
          "text": "所以左右加为我准备了预热活动的方案，订制了这身服装，还对我进行了一番特训，改善了我的言行举止。"
        },
        {
          "role": "派蒙",
          "text": "左右加？这个名字…好像是那位被我们打败后，一直跟着你取材，帮你照顾蕈兽伙伴的轻小说作家？"
        },
        {
          "role": "派蒙",
          "text": "没想到左右加居然还懂这些…异国的礼节！她居然这么博学的吗！"
        },
        {
          "role": "海妮耶",
          "text": "不止如此，如果你们对以前玩过的桌上游戏「灵蕈棋阵」还有印象，那也可以来试试全新的「小小灵蕈大幻戏」。"
        },
        {
          "role": "海妮耶",
          "text": "之前，「灵蕈棋阵」的玩法是「指挥小小灵蕈们，战胜场地内的棋阵机关」。"
        },
        {
          "role": "海妮耶",
          "text": "游戏刚刚推出时的反响还不错，但缺乏长久游玩的潜力，很快就没了热度…"
        },
        {
          "role": "海妮耶",
          "text": "所以左右加结合各种文献和小说的描述，将棋阵机关换成了模拟强大对手的棋子，为游戏增添了各种多变性。"
        },
        {
          "role": "海妮耶",
          "text": "现在，左右加正在《蒸汽鸟报》报社商量刊登广告，宣传游戏的事宜。"
        },
        {
          "role": "派蒙",
          "text": "我好像明白了…你说的预热活动，「小小灵蕈大幻戏」，就是桌上的这款游戏吗？"
        },
        {
          "role": "派蒙",
          "text": "强大的对手？也就是说，要指挥蕈兽伙伴们的棋子，去和其他的生物较量，双方都能移动吗？"
        },
        {
          "role": "派蒙",
          "text": "听起来游戏整个变复杂了很多…不过，按照以往的经验，你是不是还要处理一些细节上的事，先完善这个游戏？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哈哈，是我们擅长的领域！",
              "dialogues": []
            },
            {
              "text": "有我们能帮上忙的工作吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蒂蕾娜",
          "text": "咳咳，已经不劳两位担心了。需要解决的难题，我们都事先处理完了。"
        },
        {
          "role": "蒂蕾娜",
          "text": "海妮耶小姐与她的「小小灵蕈大幻戏」得到了来自枫丹科学院的…那什么来着，枫达项目组的赞助，一切都准备停当了。"
        },
        {
          "role": "蒂蕾娜",
          "text": "就算有还没处理完的杂活，本人…特巡队干活最勤快的蒂蕾娜，也不会允许你们两位贵客受累的！"
        },
        {
          "role": "蒂蕾娜",
          "text": "毕竟你们可是「超天顶领队级战力」，而海妮耶小姐是重要的外国商客，杂活什么的大可以交给普通的警备队员！"
        },
        {
          "role": "派蒙",
          "text": "原，原来这位小姐是警备队员吗？我还以为是海妮耶雇来的帮手呢…真可靠！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "失敬失敬！",
              "dialogues": []
            },
            {
              "text": "有劳有劳！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蒂蕾娜",
          "text": "噫！「超天顶领队级战力」肯定我了…我得到了顶级战士的认可！"
        },
        {
          "role": "蒂蕾娜",
          "text": "呃咳！现在不是在乎这个的时候…"
        },
        {
          "role": "蒂蕾娜",
          "text": "作为特巡队的新人，我有义务监视外来生物，并为特别的客人提供最高级的帮助，搞定普通警备队员处理不了的麻烦。"
        },
        {
          "role": "蒂蕾娜",
          "text": "要是蕈兽相关的活动能为枫丹廷带来可观的经济收益…我也算是积累了一些战斗之外的履历，能被队长更重视了…"
        },
        {
          "role": "派蒙",
          "text": "别这么严肃嘛，只是一个游戏而已，轻松一点！"
        },
        {
          "role": "派蒙",
          "text": "在我的印象里，和善良的蕈兽伙伴有关的事情，能让人把一切烦恼都忘掉，开开心心！"
        },
        {
          "role": "海妮耶",
          "text": "正好，我有一个提议。"
        },
        {
          "role": "海妮耶",
          "text": "之前我和左右加试玩过几百次「小小灵蕈大幻戏」，不过，我们只代表了两种游玩者，而客人们的思维各不相同。"
        },
        {
          "role": "海妮耶",
          "text": "正好，「黄金流星」和「白银伴星」的性格和阅历都很特别，而蒂蕾娜小姐又很负责…"
        },
        {
          "role": "海妮耶",
          "text": "如果你们两位进行几次对局，应该能探索出这个玩法的许多极限，有助于改进它的设计。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好耶！是新游戏！",
              "dialogues": []
            },
            {
              "text": "本来也想试试看！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "蒂蕾娜",
          "text": "既然是「超天顶领队级战力」都很感兴趣的游戏，又能为我的履历写下光彩的记录…我当然乐意奉陪！"
        },
        {
          "role": "蒂蕾娜",
          "text": "不过，我明白，我在各方面的实力都远不如你，也请你不要太凶狠！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（蕈兽）"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，原来我之前猜得没错，真的是…「咚咚小圆帽」和「欢腾之火」！"
        },
        {
          "role": "咚咚小圆帽",
          "text": "♪~"
        },
        {
          "role": "欢腾之火",
          "text": "♫~"
        },
        {
          "role": "派蒙",
          "text": "请你们等一下哦！我们和海妮耶，还有蒂蕾娜小姐说完正事，马上就来陪你们玩！"
        },
        {
          "type": "subtitle",
          "text": "游玩「小小灵蕈大幻戏」"
        },
        {
          "role": "蒂蕾娜",
          "text": "来吧，试着对局一次！"
        },
        {
          "role": "蒂蕾娜",
          "text": "不过，我明白，我在各方面的实力都远不如你，也请你不要太凶狠！"
        },
        {
          "type": "subtitle",
          "text": "与摊位旁的两人对话"
        },
        {
          "role": "蒂蕾娜",
          "text": "好强…太强了…就算是桌上游戏，也近乎无懈可击！"
        },
        {
          "role": "蒂蕾娜",
          "text": "请，请再来两局，多多教导我！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我真有这么厉害？",
              "dialogues": []
            },
            {
              "text": "奉承我也没用哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "你的说法未免也太夸张了啦，我们明明只是在玩一个游戏而已嘛。"
        },
        {
          "role": "蒂蕾娜",
          "text": "请别谦虚！这个桌上游戏可以反映游玩者的「小队指挥」思维——"
        },
        {
          "role": "蒂蕾娜",
          "text": "每只「小小灵蕈」的阵位，应对的目标，发动战技的节奏，互相支援的时机…都大有讲究！"
        },
        {
          "role": "蒂蕾娜",
          "text": "你没有接受过执律庭的小队指挥训练，就能如此娴熟地发动「联合作战」的攻势…"
        },
        {
          "role": "蒂蕾娜",
          "text": "你已经不是「超天顶领队级战力」了，而是名副其实的「超天顶领队」！"
        },
        {
          "role": "蒂蕾娜",
          "text": "有意向来执律庭任职吗？你一定很快就能坐上小队长的位置，然后进一步成长为关键的骨干…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好啊！工资开多少？",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "这个嘛…我不太确定，我记得几年前普通警备队员的月工资好像是30万摩拉吧…现在应该涨了一些？"
                },
                {
                  "role": "派蒙",
                  "text": "每个月30万摩拉是多少来着？我总觉得这个数字有点熟悉…{{黑幕|派蒙一个月的饭费}}<ref>[[旅行者语音]]-关于枫原万叶…</ref>"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "还不够派蒙吃的呢！",
                      "dialogues": []
                    },
                    {
                      "text": "我难道不值几千万？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "蒂蕾娜",
                  "text": "没…没办法！毕竟执律庭只是执行机构，大部分资金来源都是枫丹市民们的税款，工资当然不会特别高…"
                }
              ]
            },
            {
              "text": "哎吔！我不想上班！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "要是在一个固定的地方停留下来，每天上班，旅行者就不能干自己的正事了。"
                },
                {
                  "role": "派蒙",
                  "text": "我也不想每天早早就被叫起床去工作…还是自由自在比较好，想去哪里就去哪里。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "而且日常饭菜有更多选择。",
                      "dialogues": []
                    },
                    {
                      "text": "而且吃的东西有更多花样。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "对哦，各种各样的美食也很重要！总是呆在同一个地方，饭菜也迟早会吃腻的，还是要时不时换着来！"
                }
              ]
            }
          ]
        },
        {
          "role": "海妮耶",
          "text": "我理解你对「黄金流星」和「白银伴星」的敬重，蒂蕾娜小姐。"
        },
        {
          "role": "海妮耶",
          "text": "可惜，根据我的消息，他们要在提瓦特四处游历，顺带帮各国的人解决难题，清剿魔物…"
        },
        {
          "role": "海妮耶",
          "text": "作为他们善行的受益者，我也希望有更多人接受他们的帮助。"
        },
        {
          "role": "蒂蕾娜",
          "text": "是这样吗…"
        },
        {
          "role": "蒂蕾娜",
          "text": "把正义与和平的种子播撒到全提瓦特，的确比只照顾枫丹的治安要伟大得多！"
        },
        {
          "role": "蒂蕾娜",
          "text": "那我就只有…再和你们多玩几局游戏，尽量领会你们两位的思想了！"
        },
        {
          "role": "派蒙",
          "text": "话说回来，可不能忘了，还有一件重要的事，海妮耶…"
        },
        {
          "role": "海妮耶",
          "text": "我猜，你是想问「咚咚小圆帽」没错吧？"
        },
        {
          "role": "海妮耶",
          "text": "「咚咚小圆帽」和「欢腾之火」就在旁边，蒂蕾娜小姐还特意给蕈兽伙伴们安排了一位照顾生活的朋友呢。"
        },
        {
          "role": "海妮耶",
          "text": "按照惯例，这回我也有准备特别的「妙妙琼脂」。"
        },
        {
          "role": "海妮耶",
          "text": "你们可以一边和蕈兽伙伴们玩，一边和伙伴们一起吃零食！"
        },
        {
          "role": "派蒙",
          "text": "好好好！海妮耶的准备越来越周到了！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们分别和蒂蕾娜再玩一局「小小灵蕈大幻戏」，就去看看「咚咚小圆帽」吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（海妮耶）"
        },
        {
          "role": "海妮耶",
          "text": "果然，无论「月莲杯大赛」、「灵蕈棋阵」还是这「小小灵蕈大幻戏」，你们的策略都非同寻常，我应该拿出最正式的态度！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "再玩一局「小小灵蕈大幻戏」。",
              "dialogues": [
                {
                  "role": "海妮耶",
                  "text": "没问题！如果尝试搭配不同的「小小灵蕈」，可能会有意想不到的惊喜。"
                }
              ]
            },
            {
              "text": "态度？",
              "dialogues": [
                {
                  "role": "海妮耶",
                  "text": "咳咳，「黄金流星」和「白银伴星」，两位老板！「小小灵蕈大幻戏」的游玩体验感觉如何？"
                },
                {
                  "role": "旅行者",
                  "text": "叫老板未免有点见外了！"
                },
                {
                  "role": "派蒙",
                  "text": "对哦，我们是朋友嘛！这样一叫，感觉变成了上下级的关系，有点…什么来着…距离感！"
                },
                {
                  "role": "海妮耶",
                  "text": "我的考虑是，在公开场合，我属于驯兽师大赛主办方的员工，而你们两位是最高决策者。"
                },
                {
                  "role": "海妮耶",
                  "text": "「大型活动筹备要点五百问」这本书里说，应当随时注重礼节和规矩，称呼自然也不能随意使用。"
                },
                {
                  "role": "海妮耶",
                  "text": "说不定，之后我还要占用两位一点时间，和两位一起去见赞助商，洽谈大赛的后续事项。"
                },
                {
                  "role": "海妮耶",
                  "text": "比如这次「小小灵蕈大幻戏」的赞助者，枫达的项目组。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那我也不是不能当一会儿老板…",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "可是，我们两个完全不会商人的话术啊，说不定我们到场了，反而会被对方看出破绽来…"
                        },
                        {
                          "role": "派蒙",
                          "text": "「这两个被叫老板的家伙完全不懂行嘛，我可以把条件开得更苛刻一点！」"
                        },
                        {
                          "role": "派蒙",
                          "text": "而我们又说不出什么反驳的话，结果搞得场面很尴尬…"
                        }
                      ]
                    },
                    {
                      "text": "不要啦，老板还要负责背黑锅…",
                      "dialogues": [
                        {
                          "role": "海妮耶",
                          "text": "背黑锅？你的意思是…对方如果觉得我们的活动表现不好，会觉得一切都是最高决策者的责任吗？"
                        },
                        {
                          "role": "派蒙",
                          "text": "嗯…也有可能是，你管我们两个叫老板，我们还有点名气，他们只能记住我们，出事了也只怪罪我们。"
                        },
                        {
                          "role": "派蒙",
                          "text": "就算到时候解释起来肯定也很费工夫。"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "这样一想，我们反而会给海妮耶添麻烦吧！"
                },
                {
                  "role": "海妮耶",
                  "text": "有道理…我之前还没想到过这一层可能。"
                },
                {
                  "role": "海妮耶",
                  "text": "我明白了，在处理这种人情世故的领域，我的经验比起你们还是差得很多。"
                },
                {
                  "role": "海妮耶",
                  "text": "那我之后还是要谨慎地使用这个称呼…不，应该要更全面地考虑和非佣兵的人打交道的细节！"
                }
              ]
            },
            {
              "text": "我们更关心你的个人情况…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对哦，海妮耶，我们好久不见了，你发生了这~么大的变化，肯定经历了很多很多事！"
                },
                {
                  "role": "海妮耶",
                  "text": "我？我感觉我之前的生活倒是挺平静的。"
                },
                {
                  "role": "海妮耶",
                  "text": "上次从奥摩斯港回去以后，左右加又教了我很多字词和语法，帮我好好读完了很多书。"
                },
                {
                  "role": "海妮耶",
                  "text": "我感觉，我的知识量应该勉强能碰到…最下级的学生的门槛了。"
                },
                {
                  "role": "海妮耶",
                  "text": "作为回报，我帮助左右加锻炼了体能，教了她更多雨林生存和战斗的技巧。"
                },
                {
                  "role": "海妮耶",
                  "text": "或许是左右加对佣兵生活很感兴趣的缘故吧，她一直热情高涨。我带她去见了以前的佣兵朋友，她和佣兵们很快就混熟了。"
                },
                {
                  "role": "海妮耶",
                  "text": "让我惊奇的是，返程途中，我们遇上了一些魔物…"
                },
                {
                  "role": "海妮耶",
                  "text": "左右加居然跳上去几斧就把那些魔物都打倒了，她真的很有天分！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "可以期待你入学教令院了！",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "对哦对哦！既然海妮耶都读了这么多书，岂不是也可以去教令院深造一番了！"
                        },
                        {
                          "role": "海妮耶",
                          "text": "还不至于！我只要照顾好蕈兽伙伴们就心满意足了，完全不需要什么学位证书…"
                        }
                      ]
                    },
                    {
                      "text": "可以期待左右加的大作了！",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "真的欸，之前我还觉得，左右加看起来特别文弱，没想到还这么能打！"
                        },
                        {
                          "role": "派蒙",
                          "text": "身为一个亲身体验过驯兽师大赛，雨林生活，还有佣兵冒险的作家…左右加写出来的故事肯定很不一样！"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "海妮耶",
                  "text": "总之，感谢你们对我们的关心。我们最近都过得很充实，每天都充满干劲！"
                }
              ]
            },
            {
              "text": "还是先聊聊蕈兽伙伴们…",
              "dialogues": [
                {
                  "role": "海妮耶",
                  "text": "放心吧，「黄金流星」！"
                },
                {
                  "role": "海妮耶",
                  "text": "上次我和左右加在奥摩斯港采购了许多物资，扩建了营地，之后还拿到了改进口味的「妙妙琼脂」。"
                },
                {
                  "role": "海妮耶",
                  "text": "「咚咚小圆帽」和其他伙伴在营地里吃好喝好，不出门也有爬架、秋千和跷跷板玩，不会无聊。"
                },
                {
                  "role": "海妮耶",
                  "text": "出门的时候，蕈兽伙伴们和蕈猪、暝彩鸟、驮兽都非常合得来，有的时候还会一起乘着驮兽去散步。"
                },
                {
                  "role": "派蒙",
                  "text": "听…听着我都想去玩了！"
                },
                {
                  "role": "海妮耶",
                  "text": "不过，之前负责改进「意智宝珠」的努查赫小姐遇到了难题，似乎要大改技术方向。"
                },
                {
                  "role": "海妮耶",
                  "text": "新型宝珠的开发资金也有着很大缺口，不可能完全以预期的速度完成。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "有拖延也不是不能理解。",
                      "dialogues": []
                    },
                    {
                      "text": "毕竟是超级重要的装置。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "唔…确实马虎不得！慢一点也没办法…如果我也懂研究就好了，至少能帮帮忙！"
                },
                {
                  "role": "海妮耶",
                  "text": "这次来枫丹，除了为活动寻找靠谱的赞助商和提前进行宣传，还想抽空寻找懂这行的技术人员。"
                },
                {
                  "role": "海妮耶",
                  "text": "好在，枫丹科学院的枫达项目组不仅支援了我们大量的资金，还说要帮我们寻找相应的人才。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "那么代价是什么呢？",
                      "dialogues": []
                    },
                    {
                      "text": "天下没有免费煎蛋…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "还是有点不放心，发明枫达的那些人，真的没有向你提什么要求吗？"
                },
                {
                  "role": "海妮耶",
                  "text": "要求当然是有的，那就是「冠名权」和「唯一供应商」——"
                },
                {
                  "role": "海妮耶",
                  "text": "以后的驯兽师大赛可能就不叫「月莲杯」而是「枫达杯」了，具体的名字，他们会仔细考虑。"
                },
                {
                  "role": "海妮耶",
                  "text": "主办方向到场的所有观众出售的饮品，也必须全都换成枫达，或枫达的衍生品。"
                },
                {
                  "role": "派蒙",
                  "text": "嗯…感觉，好像没什么问题？"
                },
                {
                  "role": "派蒙",
                  "text": "听起来，他们只是想借助驯兽师大赛来给枫达打广告…"
                },
                {
                  "role": "派蒙",
                  "text": "不对不对，论名气，好像我们的驯兽师大赛，反而是沾光的那一边，不管怎么想，都是我们赚了！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "现在也没有别的竞争商品！",
                      "dialogues": [
                        {
                          "role": "派蒙",
                          "text": "没错！我们为蕈兽伙伴们争取到了重要的资金，也不会有什么损失，不赚白不赚！"
                        },
                        {
                          "role": "海妮耶",
                          "text": "我也和左右加、贝尔福先生一起仔细确认过，之前的合同里没有任何陷阱，这一点是我必须做好的！"
                        }
                      ]
                    },
                    {
                      "text": "以后就让新赞助商来竞价！",
                      "dialogues": [
                        {
                          "role": "海妮耶",
                          "text": "竞价？意思是让新的赞助商和枫达项目组比一比谁出的价钱更高，就给谁冠名吗？"
                        },
                        {
                          "role": "派蒙",
                          "text": "还有这种办法？旅行者，你怎么总有这么多好点子！"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "听海妮耶这么一细说，我感觉形势大好！"
                },
                {
                  "role": "派蒙",
                  "text": "说不定，你们的这次枫丹之行，会是很多事情的突破口呢。"
                },
                {
                  "role": "海妮耶",
                  "text": "那就借你吉言了，「白银伴星」！"
                }
              ]
            },
            {
              "text": "稍后再见！",
              "dialogues": [
                {
                  "role": "海妮耶",
                  "text": "嗯，看来你们有事要忙了。"
                },
                {
                  "role": "海妮耶",
                  "text": "请别担心，我们还会在这里停留一段时间的！随时都可以来找我继续游玩「小小灵蕈大幻戏」，或者叙叙旧！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（蒂蕾娜）"
        },
        {
          "role": "蒂蕾娜",
          "text": "领队！如果有空的话，请再指导我几回吧！我想成为…战术大师！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就再教导你一次！",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "遵命！请别手下留情！"
                }
              ]
            },
            {
              "text": "我怎么就成领队了！",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "啊对不起，我已经在设想你进入特巡队后的情景了…虽然我还开不出几千万摩拉的月工资。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "但如果你见到了夏沃蕾队长，说不定她会专门写一封推荐书，给你开出这个价格的月薪！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "夏沃蕾？",
                      "dialogues": []
                    },
                    {
                      "text": "队长？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "蒂蕾娜",
                  "text": "夏沃蕾是我们「特巡队」的队长，说是枫丹最伟大的铳枪射手之一也不为过！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "我们「特巡队」有着使用铳枪的传统，而夏沃蕾队长可以将铳枪像手指一样灵活地使用！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "据说她能用最普通的量产铳枪，在上百步的距离外，一枪打灭蜡烛的火焰，而不损害蜡烛本体。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "目前「特巡队」每个分队的现任领队，都是她亲自教导，或者严格考核过的神射手。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "而我作为一个刚刚加入特巡队不久的新人，只能勉强在一百五十步左右的距离上，打中…你脑袋这么大的目标。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "哎吔！这什么枪法！",
                      "dialogues": [
                        {
                          "role": "蒂蕾娜",
                          "text": "呜呜，被嫌弃了…"
                        }
                      ]
                    },
                    {
                      "text": "哎哟？这么准的吗？",
                      "dialogues": [
                        {
                          "role": "蒂蕾娜",
                          "text": "没有啦没有啦！以你的实力，随便练练就能超过我！"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "蒂蕾娜",
                  "text": "我练习射击弹药数还不够多，我会再加把劲的！争取这个月打够…2000次演习！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "总之，以后有机会的话，我也会向你介绍一些铳枪射击的知识！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "请再考虑考虑加入「特巡队」，或者至少挂上一个「特别队员」身份的事！"
                }
              ]
            },
            {
              "text": "先谈谈你自己…",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "我？我目前只是个「特巡队」的新人，没什么值得称赞的战绩…"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "所以我才会被派来对接海妮耶小姐的「小小灵蕈大幻戏」活动。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "当然，并不是说，「特巡队」认为这是很低级的杂活。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "确定「海妮耶小姐带来的这些蕈兽伙伴没有危险」后，我才接管了这项工作，并近距离收集信息。"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "要是真的遭遇了危险的魔物，必要情况下，特巡队会派出若干射手与警卫机关配合作战…"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "在警卫机关的引导下，将目标魔物引入「火力杀伤区」，再由埋伏起来的射手打出交叉火力…"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "这样一来，就能让目标陷入进退两难的处境，在不过度损害警卫机关服役寿命的情况下歼灭敌人。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "听起来很厉害哦！",
                      "dialogues": [
                        {
                          "role": "蒂蕾娜",
                          "text": "没有没有，这还只是最基本的战术之一！"
                        }
                      ]
                    },
                    {
                      "text": "能这样对付我吗？",
                      "dialogues": [
                        {
                          "role": "蒂蕾娜",
                          "text": "请别开玩笑了，你可不是假想敌…应该说，除了队长亲自带队出动，没有什么常规战术能压制你吧…"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "蒂蕾娜",
                  "text": "要是你对特巡队的战术感兴趣，下次，我可以带一本手册，再向你介绍介绍！"
                },
                {
                  "role": "蒂蕾娜",
                  "text": "请再考虑考虑加入「特巡队」，或者至少挂上一个「特别队员」身份的事！"
                }
              ]
            },
            {
              "text": "那你先自我反思一下…",
              "dialogues": [
                {
                  "role": "蒂蕾娜",
                  "text": "好…好的！呜呜…我还是太弱了啊…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（咚咚小圆帽&欢腾之火）"
        },
        {
          "role": "派蒙",
          "text": "「咚咚小圆帽」，还有「欢腾之火」，好久不见啦，好想你们！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "捏捏蕈兽伙伴们！",
              "dialogues": [
                {
                  "role": "咚咚小圆帽",
                  "text": "♪~"
                },
                {
                  "role": "欢腾之火",
                  "text": "♫~"
                },
                {
                  "role": "派蒙",
                  "text": "让我也抱抱「咚咚小圆帽」，捏捏「欢腾之火」！"
                },
                {
                  "role": "咚咚小圆帽",
                  "text": "♪♪~"
                },
                {
                  "role": "欢腾之火",
                  "text": "♫♫~"
                },
                {
                  "role": "派蒙",
                  "text": "咦？等等…"
                },
                {
                  "role": "派蒙",
                  "text": "虽然外表看起来没什么变化，但好像感觉…「咚咚小圆帽」和「欢腾之火」都长胖了一点？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "说明伙伴们平常的伙食很好！",
                      "dialogues": []
                    },
                    {
                      "text": "说明海妮耶她们照顾得用心！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "嘿嘿，再这样下去，说不定「咚咚小圆帽」和「欢腾之火」有一天会变得比我们大很多…"
                },
                {
                  "role": "派蒙",
                  "text": "到时候，一起去旅行的时候，「咚咚小圆帽」就可以把我们顶在脑袋上，飞高高！"
                },
                {
                  "role": "派蒙",
                  "text": "要是「咚咚小圆帽」累了，就换「欢腾之火」来背我们，我们也可以找一只驮兽，一起骑着驮兽旅行！"
                },
                {
                  "role": "咚咚小圆帽",
                  "text": "♪♪♪！"
                },
                {
                  "role": "欢腾之火",
                  "text": "♫♫♫！"
                },
                {
                  "role": "派蒙",
                  "text": "说到一起去旅行，蕈兽伙伴们就特别开心，超级期待的样子！"
                },
                {
                  "role": "派蒙",
                  "text": "要是以后完成了「意智宝珠」的改进，蕈兽伙伴们能不受限制地自由行动了…"
                },
                {
                  "role": "派蒙",
                  "text": "我们要去哪些地方玩呢？旅行者，我们好像确实可以计划一下了？"
                }
              ]
            },
            {
              "text": "投喂蕈兽伙伴们。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好哦！这次我们也有新口味的「妙妙琼脂」，我们要给蕈兽伙伴投喂哪种好呢？"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "投喂「炸鱼薯条味妙妙琼脂」。",
                      "dialogues": [
                        {
                          "role": "咚咚小圆帽",
                          "text": "♪~"
                        },
                        {
                          "role": "欢腾之火",
                          "text": "♫~"
                        },
                        {
                          "role": "派蒙",
                          "text": "没想到蕈兽伙伴们居然也喜欢炸鱼薯条？"
                        },
                        {
                          "role": "派蒙",
                          "text": "完全不挑食呢！胃口好，身体肯定棒！"
                        }
                      ]
                    },
                    {
                      "text": "投喂「咖啡味妙妙琼脂」。",
                      "dialogues": [
                        {
                          "role": "咚咚小圆帽",
                          "text": "！"
                        },
                        {
                          "role": "欢腾之火",
                          "text": "！"
                        },
                        {
                          "role": "派蒙",
                          "text": "蕈兽伙伴们好像变得更有精神了呢！"
                        },
                        {
                          "role": "派蒙",
                          "text": "「咖啡味妙妙琼脂」里，难道真的有咖啡吗？"
                        }
                      ]
                    },
                    {
                      "text": "投喂「枫达味妙妙琼脂」。",
                      "dialogues": [
                        {
                          "role": "咚咚小圆帽",
                          "text": "？"
                        },
                        {
                          "role": "欢腾之火",
                          "text": "？"
                        },
                        {
                          "role": "派蒙",
                          "text": "蕈兽伙伴们…好像要飘起来了！"
                        },
                        {
                          "role": "派蒙",
                          "text": "原来，原来蕈兽伙伴们，不能吃气泡很多的食物吗…"
                        }
                      ]
                    }
                  ]
                },
                {
                  "role": "派蒙",
                  "text": "嗯…既然来了枫丹，发现了新的美食，我们也可以把它们推荐给海妮耶，做成新口味的「妙妙琼脂」！"
                }
              ]
            },
            {
              "text": "旁边这位是…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔，看样子，好像是蒂蕾娜小姐带来的警卫机关？"
                },
                {
                  "role": "派蒙",
                  "text": "难道我们不在的时候，它一直在陪蕈兽伙伴们玩？"
                },
                {
                  "role": "观察警卫机关",
                  "text": "（这台警卫机关似乎点了一下头，发出机件运转的低音。）"
                },
                {
                  "type": "subtitle",
                  "text": "观察警卫机关；（不知为什么，它明明没有说话，却给人一种优雅的感觉。）",
                  "narration": true
                },
                {
                  "role": "派蒙",
                  "text": "好有礼貌！那我，那我要给你起一个好听的外号…"
                },
                {
                  "role": "派蒙",
                  "text": "就叫你…「有礼貌礼帽小姐」！"
                },
                {
                  "type": "subtitle",
                  "text": "观察「有礼貌礼帽小姐」；（这台警卫机关身上的部件似乎在隐隐闪光，闪光的节奏欢腾。）",
                  "narration": true
                },
                {
                  "role": "派蒙",
                  "text": "嘿嘿，它好像很满意的样子！"
                },
                {
                  "role": "派蒙",
                  "text": "蕈兽伙伴们交到你这个新朋友肯定也很开心，「有礼貌礼帽小姐」！"
                }
              ]
            },
            {
              "text": "暂时离去…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那，那我们有空了，还是要来陪蕈兽伙伴们玩哦！"
                }
              ]
            }
          ]
