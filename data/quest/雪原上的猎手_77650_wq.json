{
  "quest_id": 77650,
  "chapter_num": null,
  "chapter_title": "雪原上的猎手",
  "type": "wq",
  "route": "Hunter on the Snowfields",
  "stories": [
    {
      "story_id": 77650,
      "title": "雪原上的猎手",
      "description": "漫步在雪原上的你偶遇了正藏身在某处雪堆后面的阿罗夏，按照他的说法，这对于一名猎人来说是很正常的行为，然而你很快发现他选择的「猎物」有些特别…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与阿罗夏对话"
        },
        {
          "role": "阿罗夏",
          "text": "嗯…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "阿罗夏？",
            "在这里做什么？"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "旅行者？嘘！我打猎呢，小心惊到猎物。"
        },
        {
          "role": "阿罗夏",
          "text": "不用那么奇怪，在至冬的野外，「猎物」可以代指很多事情，比如一伙妖精帮派的成员。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "妖精帮派？第一次听说…",
            "妖精帮派？有所耳闻…"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "总之，你只要知道他们是一帮不太好惹的妖精就行了。"
        },
        {
          "role": "阿罗夏",
          "text": "妖精帮派不是愚人众那种能上得了台面的组织，但同样根基不浅。"
        },
        {
          "role": "旅行者",
          "text": "那为什么要惹他们？"
        },
        {
          "role": "阿罗夏",
          "text": "在至冬这边，能被称作「猎物」的大多都不好惹，但猎人还是得干活，要讨生活嘛。"
        },
        {
          "role": "阿罗夏",
          "text": "有传闻说，妖精帮派里有些人在能源协会那儿有自己的路子，他们手里囤积着不少克什尼克晶矿。"
        },
        {
          "role": "阿罗夏",
          "text": "当然，这些晶矿全部是用来走私的，不会出现在严冬计划的统计账本上，就算被抢了也不会有官方的人来追查。"
        },
        {
          "role": "旅行者",
          "text": "帮派的人会来追查吧？"
        },
        {
          "role": "阿罗夏",
          "text": "不用担心，我说过，妖精帮派是上不了台面的组织。"
        },
        {
          "role": "阿罗夏",
          "text": "等这些晶矿被分给那些挨冻的村民，难不成他们还敢在冬契军眼皮子底下去挨家挨户回收？"
        },
        {
          "role": "阿罗夏",
          "text": "至于我…他们查不到我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "说是讨生活…",
            "结果还是为村民着想啊。"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "我只是想做些该做的，另外严格来说这算「黑吃黑」，不是什么高尚的事。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "也加我一个吧。",
            "我不怕那些帮派。"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "多个帮手总是好事，不过…好吧，凭你的身手，肯定不会有事的。"
        },
        {
          "role": "图加林",
          "text": "汪汪！"
        },
        {
          "role": "阿罗夏",
          "text": "乖，坐下，里面有「角」吗？"
        },
        {
          "role": "图加林",
          "text": "汪！"
        },
        {
          "role": "阿罗夏",
          "text": "有「爪子」吗？"
        },
        {
          "role": "图加林",
          "text": "汪！"
        },
        {
          "role": "阿罗夏",
          "text": "是帮派里的「角」，手里都有家伙…里面的「角」有多少？比十个多吗？"
        },
        {
          "role": "图加林",
          "text": "汪？"
        },
        {
          "role": "阿罗夏",
          "text": "啧…它现在还是数不到十。"
        },
        {
          "role": "图加林",
          "text": "呜…"
        },
        {
          "role": "阿罗夏",
          "text": "看来得亲自过去确认下，我有把握摸清对方的具体人数，不过得靠近些。"
        },
        {
          "role": "阿罗夏",
          "text": "旅行者，你先陪着图加林在附近藏一下，等我的信号。"
        },
        {
          "type": "subtitle",
          "text": "探听帮派人员的虚实"
        },
        {
          "role": "阿罗夏",
          "text": "打扰了，这里原来有人住吗？"
        },
        {
          "role": "帮派成员",
          "text": "哪里来的小子？你想干什么？"
        },
        {
          "role": "阿罗夏",
          "text": "我只是个路过的猎人，在附近打猎，把身上的火水都用光了，得赶紧找个地方取暖…"
        },
        {
          "role": "帮派成员",
          "text": "不想惹麻烦的话就赶紧离开！"
        },
        {
          "role": "阿罗夏",
          "text": "嗯…门外面两个，门里面三个，这个数量的话…看来不用担心会放跑谁了。"
        },
        {
          "role": "帮派成员",
          "text": "你到底想干什么？"
        },
        {
          "role": "阿罗夏",
          "text": "我说过了，打猎。"
        },
        {
          "role": "旅行者",
          "text": "枪声响了，就是现在！"
        },
        {
          "type": "subtitle",
          "text": "消灭驻守的帮派成员"
        },
        {
          "type": "subtitle",
          "text": "与阿罗夏商议"
        },
        {
          "role": "阿罗夏",
          "text": "这里一块晶矿都没有？那他们守着这个小屋是要干什么？"
        },
        {
          "role": "阿罗夏",
          "text": "一把钥匙和一张…卡片？你觉得它们是做什么用的？"
        },
        {
          "role": "旅行者",
          "text": "暂时没有头绪。"
        },
        {
          "role": "阿罗夏",
          "text": "这张卡片先收起来吧，至于这把钥匙，它应该和那边的门有关系。"
        },
        {
          "role": "阿罗夏",
          "text": "倒也合理，最近这段时间，私藏晶矿可是一件很敏感的事，他们肯定会把手里的货藏到更隐秘的地方。"
        },
        {
          "role": "旅行者",
          "text": "我们去更里面看看吧。"
        },
        {
          "role": "阿罗夏",
          "text": "嗯，先试试这把钥匙能不能开门。"
        },
        {
          "type": "subtitle",
          "text": "打开被锁住的门"
        },
        {
          "type": "subtitle",
          "text": "与阿罗夏商议"
        },
        {
          "role": "阿罗夏",
          "text": "倒霉，怎么什么都没有？"
        },
        {
          "role": "图加林",
          "text": "汪！"
        },
        {
          "role": "阿罗夏",
          "text": "这些冰…"
        },
        {
          "role": "旅行者",
          "text": "是死路吗？"
        },
        {
          "role": "阿罗夏",
          "text": "不，这些冰很新，看上去是用来临时封住什么，我们想找的晶矿恐怕被藏在更深的地方。"
        },
        {
          "role": "阿罗夏",
          "text": "一连设置了两道保险，看来他们藏在这里的晶矿数目不小。"
        },
        {
          "role": "旅行者",
          "text": "得想办法融化这些冰。"
        },
        {
          "role": "阿罗夏",
          "text": "好说，这些冰形成的时间还不长，花不了多少力气。"
        },
        {
          "type": "subtitle",
          "text": "融化坚冰，进入洞口"
        },
        {
          "role": "阿罗夏",
          "text": "先不管其他的，至少它确实能帮我们开路。"
        },
        {
          "role": "阿罗夏",
          "text": "不过，明明是用来开路的道具，却交给在外面盯梢的人拿着，还特地封死了洞口…"
        },
        {
          "role": "阿罗夏",
          "text": "看来这张卡对他们来说确实很重要，绝对不能落到别人手上，要确认万无一失了才能使用。"
        },
        {
          "role": "旅行者",
          "text": "你觉得有蹊跷？"
        },
        {
          "role": "阿罗夏",
          "text": "仅仅为了一批值钱的古董，需要这么谨慎吗？"
        },
        {
          "role": "阿罗夏",
          "text": "只能先进去看看再说，这张卡还有那个台座就等以后有时间再来研究吧。"
        },
        {
          "type": "subtitle",
          "text": "继续推进"
        },
        {
          "role": "矮小的妖精",
          "text": "你们别过来！"
        },
        {
          "role": "阿罗夏",
          "text": "先停一下，这里怎么也有帮派成员？"
        },
        {
          "role": "旅行者",
          "text": "要动手吗？"
        },
        {
          "role": "阿罗夏",
          "text": "事情跟我一开始想的不一样，还是先观察一下吧。对面好像是两拨人，得用瞄准镜才能看清楚…"
        },
        {
          "role": "矮小的妖精",
          "text": "都别过来！引爆开关就在我手上！"
        },
        {
          "role": "魁梧的妖精",
          "text": "冷静些！我说过了，只要你们把路让开，乖乖走人，就不为难你们。"
        },
        {
          "role": "矮小的妖精",
          "text": "「老阁下」立过规矩，在野外发现的宝贝，见者有份！"
        },
        {
          "role": "矮小的妖精",
          "text": "承蒙「老阁下」照顾，肯定有一份要上交给伊兹梅洛家，剩下的就是我们的辛苦费。"
        },
        {
          "role": "矮小的妖精",
          "text": "但你竟然要我们空手走人？「律」可不是这样说的！"
        },
        {
          "role": "阿罗夏",
          "text": "分赃不均？"
        },
        {
          "role": "魁梧的妖精",
          "text": "你以为你们占领了一座金库？你们只是堵住了通往金库的路。"
        },
        {
          "role": "魁梧的妖精",
          "text": "你们试过了，但是根本进不去吧？你们本来就什么也拿不到！"
        },
        {
          "role": "矮小的妖精",
          "text": "…是又怎么样？我们先发现了这里，总该有些辛苦费吧？「老阁下」…"
        },
        {
          "role": "魁梧的妖精",
          "text": "「老阁下」已经死了，你指望兹梅伊能撑得起台面？行了，让开吧！"
        },
        {
          "role": "矮小的妖精",
          "text": "沃罗宁娜阁下呢，你难道不怕沃罗宁娜阁下？"
        },
        {
          "role": "魁梧的妖精",
          "text": "你…"
        },
        {
          "role": "矮小的妖精",
          "text": "说到底，大伙儿都是因为「老阁下」的照顾才愿意在至冬这团炉灰里相安无事地混日子，他立的规矩谁都不能改。"
        },
        {
          "role": "矮小的妖精",
          "text": "这段日子，哪家都不好过。但要是有人违背了「律」，我…我必会跟沃罗宁娜阁下好好说道说道！"
        },
        {
          "role": "魁梧的妖精",
          "text": "敬酒不吃吃罚酒！"
        },
        {
          "role": "矮小的妖精",
          "text": "都别过来！大不了一起埋在这里！"
        },
        {
          "role": "魁梧的妖精",
          "text": "住手！你真想死在这里？"
        },
        {
          "role": "矮小的妖精",
          "text": "都是在道上混的，别把我当蠢货耍。盯梢的弟兄早就告诉我了，你们进来的时候留下了一批人，从外面封死了洞口。"
        },
        {
          "role": "矮小的妖精",
          "text": "你本来就没打算让我们活着出去，要不是有这些炸药，我们早就被干掉了。"
        },
        {
          "role": "魁梧的妖精",
          "text": "哼…"
        },
        {
          "role": "矮小的妖精",
          "text": "可不是我们先不讲情面的，没想到你们…居然会为了这些古董做到这种地步。"
        },
        {
          "role": "矮小的妖精",
          "text": "看来把它们卖掉能赚的摩拉远比我想象中要多——这些摩拉有我们的一份！"
        },
        {
          "role": "魁梧的妖精",
          "text": "古董？卖掉换摩拉？就是因为你这种目光短浅的蠢货太多了，我们才一直被人踩在脚底下！"
        },
        {
          "role": "矮小的妖精",
          "text": "少废话！还是好好谈一笔交易吧。"
        },
        {
          "role": "阿罗夏",
          "text": "原来是遇到了另一拨黑吃黑的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "听上去…",
            "他们没在这里私藏晶矿。"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "说是值钱的古董…妖精帮派确实也会走私这种东西。"
        },
        {
          "role": "阿罗夏",
          "text": "古董可没办法直接分给村民，还得找门路换成摩拉…也行，总不能白来一趟。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那个妖精拿着引爆开关…",
            "我们也不好动手。"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "交给我。"
        },
        {
          "type": "subtitle",
          "text": "消灭帮派成员"
        },
        {
          "role": "阿罗夏",
          "text": "这是？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我见过这个。",
            "它与我的枪有关。"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "明显也不是这个时代的造物，难道这就是他们说的古董？"
        },
        {
          "role": "阿罗夏",
          "text": "周围没有其他看上去很值钱的东西…这个能卖吗？"
        },
        {
          "role": "旅行者",
          "text": "难说…"
        },
        {
          "role": "阿罗夏",
          "text": "总不会真的白跑一趟吧…嗯？那个装置…"
        },
        {
          "role": "阿罗夏",
          "text": "我想起来了，不久前有个妖精帮派曾经到处收购白沙皇时期的图纸，我以为是值钱的东西，抢了一张看。"
        },
        {
          "role": "阿罗夏",
          "text": "图纸上画的似乎就是这种装置。"
        },
        {
          "role": "旅行者",
          "text": "这种装置是做什么用的？"
        },
        {
          "role": "阿罗夏",
          "text": "我也不清楚，我只记得要让它运转起来的话，就得把这些管道连通，清理掉那些冻住管道的冰应该就可以。"
        },
        {
          "role": "阿罗夏",
          "text": "既然妖精帮派的成员这么重视这种装置，不如我们试试它到底能做什么。"
        },
        {
          "type": "subtitle",
          "text": "消灭帮派成员"
        },
        {
          "role": "魁梧的妖精",
          "text": "掩护我！"
        },
        {
          "role": "阿罗夏",
          "text": "麻烦…"
        },
        {
          "role": "旅行者",
          "text": "跑了一个，怎么办？"
        },
        {
          "role": "阿罗夏",
          "text": "随他去吧，外面的人都被我们干掉了，他要叫人就得回总部，一路上花的时间足够我们把这里的古董都搬走。"
        },
        {
          "role": "阿罗夏",
          "text": "我们去里面看看吧。"
        },
        {
          "type": "subtitle",
          "text": "继续探索"
        },
        {
          "role": "阿罗夏",
          "text": "这个是…看上去不是这个时代的，我对这些古代造物了解得不多。"
        },
        {
          "role": "旅行者",
          "text": "似乎有特殊的用途…"
        },
        {
          "role": "阿罗夏",
          "text": "如果你好奇的话，我在呼啸社有一个熟人，他对这些东西很有研究，之后有机会我可以喊他过来帮忙看一看。"
        },
        {
          "role": "阿罗夏",
          "text": "这个东西明显搬不走，我们还是先看看有什么能带走的吧。"
        },
        {
          "role": "阿罗夏",
          "text": "不过，有这种屏障挡路，没法继续往里走啊…"
        },
        {
          "role": "「灰眸」",
          "text": "检测到…影域屏障机关，或许可以用相应的权限卡解锁。"
        },
        {
          "role": "旅行者",
          "text": "「灰眸」有反应…"
        },
        {
          "role": "阿罗夏",
          "text": "权限卡？难道是我们之前拿到的那张卡…它兴许就是用在这里的，试一下吧。"
        },
        {
          "type": "subtitle",
          "text": "设法解除屏障，与阿罗夏商议"
        },
        {
          "role": "阿罗夏",
          "text": "刚刚是怎么回事？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "之前在影域里捡到的东西…",
            "似乎对它有反应。"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "影域？这张卡，这里的东西…和影域有关？"
        },
        {
          "role": "阿罗夏",
          "text": "看来确实需要找一个专业的人，来研究一下这些东西该怎么用。"
        },
        {
          "role": "阿罗夏",
          "text": "先不管其他的，至少它确实能帮我们开路。"
        },
        {
          "role": "阿罗夏",
          "text": "不过，明明是用来开路的道具，却交给在外面盯梢的人拿着，还特地封死了洞口…"
        },
        {
          "role": "阿罗夏",
          "text": "看来这张卡对他们来说确实很重要，绝对不能落到别人手上，要确认万无一失了才能使用。"
        },
        {
          "role": "旅行者",
          "text": "你觉得有蹊跷？"
        },
        {
          "role": "阿罗夏",
          "text": "仅仅为了一批值钱的古董，需要这么谨慎吗？"
        },
        {
          "role": "阿罗夏",
          "text": "只能先进去看看再说，这张卡还有那个台座就等以后有时间再来研究吧。"
        },
        {
          "type": "subtitle",
          "text": "与阿罗夏商讨现状"
        },
        {
          "role": "阿罗夏",
          "text": "好暖和…难道是个炉子？"
        },
        {
          "role": "魁梧的妖精",
          "text": "情报果然没错，这里有克什尼克之炬的原型机，那位大人的计划需要那个时代的科技…"
        },
        {
          "role": "图加林",
          "text": "汪汪！"
        },
        {
          "role": "阿罗夏",
          "text": "图加林，先别动。"
        },
        {
          "role": "魁梧的妖精",
          "text": "真冷静，看来你注意到我攥在手里的东西。不错，我趁乱捡走了那个蠢货的引爆开关，并做了一些必要的改装。"
        },
        {
          "role": "魁梧的妖精",
          "text": "现在，我的手只要一松开，它就会引爆。"
        },
        {
          "role": "阿罗夏",
          "text": "没有去喊人，而是直接折返回来，你就不怎么冷静了。"
        },
        {
          "role": "魁梧的妖精",
          "text": "不要废话！手下全都被人干掉，还丢掉了耗费大量人力才拿到的权限卡，要是我带着这些消息回去…"
        },
        {
          "role": "魁梧的妖精",
          "text": "那位大人会直接把我宰了。"
        },
        {
          "role": "魁梧的妖精",
          "text": "这里的设施还有那张权限卡，对于那位大人来说都十分重要，快交出来！"
        },
        {
          "role": "阿罗夏",
          "text": "……"
        },
        {
          "role": "魁梧的妖精",
          "text": "你们也对这种技术有图谋？我知道了，肯定是其他势力派你们过来的。是能源协会，还是「卢契烬」？"
        },
        {
          "role": "阿罗夏",
          "text": "你想多了，我跟那些势力可没关系。"
        },
        {
          "role": "魁梧的妖精",
          "text": "别想耍我！老爷子死后，「高桌」就认为我们没有利用价值了。"
        },
        {
          "role": "魁梧的妖精",
          "text": "我们冒着危险在影域里挖到的东西，到头来都会变成那些老爷们的资产——我说过了，让你的狗趴下！乖乖别动！"
        },
        {
          "role": "阿罗夏",
          "text": "图加林，趴下。"
        },
        {
          "role": "图加林",
          "text": "呜…汪！"
        },
        {
          "role": "魁梧的妖精",
          "text": "这…"
        },
        {
          "role": "阿罗夏",
          "text": "「趴下」是准备攻击，「坐下」才是乖乖别动。"
        },
        {
          "role": "魁梧的妖精",
          "text": "你到底是哪个势力的人？"
        },
        {
          "role": "阿罗夏",
          "text": "我只是一个路过的猎人。"
        },
        {
          "type": "subtitle",
          "text": "在图加林的帮助下，你们拆除了引爆开关。"
        },
        {
          "role": "阿罗夏",
          "text": "克尼什克之炬的原型机？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "它似乎牵扯到很多事…",
            "该怎么处置呢？"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "嗯…它看上去像是个炉子，也能像炉子那样发光发热，那就把它当成炉子用。"
        },
        {
          "role": "阿罗夏",
          "text": "它确实有特殊的地方，我见过很多烧晶矿的炉子，它比那些炉子都强，能让这么大一块地方全都暖和起来。"
        },
        {
          "role": "阿罗夏",
          "text": "这里正好可以当成一个避难所，我把那些可能挨冻的村民都接引过来，这样比分发晶矿方便多了。"
        },
        {
          "role": "阿罗夏",
          "text": "嗯，总算没白来一趟。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "那些帮派的阴谋…",
            "你不关心吗？"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "我知道，沿着这条线索查下去，说不定能办成一些惊天动地的大事。"
        },
        {
          "role": "阿罗夏",
          "text": "但在这个过程中，肯定要把枪口对准更多人…其实我不喜欢做这种事。"
        },
        {
          "role": "阿罗夏",
          "text": "我忽然想到一个问题，你觉得猎人和冒险家的区别是什么？"
        },
        {
          "role": "阿罗夏",
          "text": "面对未知的荒野，猎人捕获猎物后就会回头，而冒险家总是想走得更远一些。"
        },
        {
          "role": "阿罗夏",
          "text": "所以，那张权限卡还有这里能找到的枪械部件，都交给你处理吧。"
        },
        {
          "role": "阿罗夏",
          "text": "作为冒险家协会里最出名的那一个，那些惊天动地的大事总会找上你的，不是吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "阿罗夏…",
            "你做的事也很有意义。"
          ]
        },
        {
          "role": "阿罗夏",
          "text": "当然，我知道。"
        },
        {
          "role": "阿罗夏",
          "text": "我们先把那些村民接引过来吧。"
        },
        {
          "role": "旅行者",
          "text": "你和阿罗夏一起将一批村民接引到了这里。"
        },
        {
          "role": "阿罗夏",
          "text": "刚刚带人来的时候才发现这里还有另一个出口，赶时间的话可以从这里进出，更方便些。"
        },
        {
          "role": "阿罗夏",
          "text": "挺好，不算白来，这一趟多亏有你帮忙。"
        },
        {
          "role": "旅行者",
          "text": "不用谢。"
        },
        {
          "role": "阿罗夏",
          "text": "客套归客套，报酬我已经准备好了，先收下吧。以后如果你有需要帮忙的事，我肯定也得出一份力。"
        }
      ]
    }
  ]
}