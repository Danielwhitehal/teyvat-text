{
  "quest_id": 1105,
  "chapter_num": "第一章 第四幕·报幕",
  "chapter_title": "戴因斯雷布",
  "type": "wq",
  "route": "Dainsleif",
  "stories": [
    {
      "story_id": 18000,
      "title": "拾枝者·戴因斯雷布",
      "description": "蒙德城冒险家协会的凯瑟琳小姐似乎有什么事想要告诉你…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与蒙德的凯瑟琳对话"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，请过来这边。"
        },
        {
          "role": "凯瑟琳",
          "text": "您加入冒险家协会也有一段时间了，冒险活动开展得还顺利吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "正在招募同伴…",
              "dialogues": []
            },
            {
              "text": "要是同伴能再多点就好了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "嗯…也是，就冒险活动这一方面来说，除了自身的实力之外，可靠的伙伴也是不可或缺的。"
        },
        {
          "role": "凯瑟琳",
          "text": "毕竟在冒险的过程中，多一个人就多一份照应呢。不过，想要招募到可靠的同伴，应该也不是件容易的事。"
        },
        {
          "role": "派蒙",
          "text": "那是呀，而且像我这么可靠的向导也很难找呢。"
        },
        {
          "role": "凯瑟琳",
          "text": "对了，我这里倒是有一些消息，说不定能对您有所帮助…"
        },
        {
          "role": "凯瑟琳",
          "text": "嗯…我看看记录。有了，最近蒙德城里来了一位陌生人，那位陌生人和您一样是金发，但衣着十分不同寻常。"
        },
        {
          "role": "派蒙",
          "text": "金发…衣着不同寻常的陌生人。总感觉这样的形容之前就听过一次了…"
        },
        {
          "role": "派蒙",
          "text": "等等，等一下，难道…"
        },
        {
          "role": "旅行者",
          "text": "难道…！"
        },
        {
          "role": "派蒙",
          "text": "那位陌生人的脸，和…和她的样子像不像？！"
        },
        {
          "role": "凯瑟琳",
          "text": "咦？和荣誉骑士吗？差别还挺大的呢，是一个很高大的男人，还戴着一个眼罩…"
        },
        {
          "role": "旅行者",
          "text": "看来只是凯亚的远亲…"
        },
        {
          "role": "派蒙",
          "text": "喂，这又和凯亚那家伙有什么关系？为什么眼罩会成为亲属关系的证明物啦。"
        },
        {
          "role": "凯瑟琳",
          "text": "那位陌生人和凯亚先生之间的关系，我倒是不知道，因为他拒绝了协会的邀约…"
        },
        {
          "role": "凯瑟琳",
          "text": "不过，如果您有兴趣的话，倒是可以去找找他。说不定…他会愿意接受您的委托呢。"
        },
        {
          "role": "凯瑟琳",
          "text": "毕竟有的冒险家虽然不愿意被协会束缚，却很容易接受来自另一位冒险家的邀约。"
        },
        {
          "role": "凯瑟琳",
          "text": "而且，如果那位陌生人真是位实力强大的冒险家，一定能对您的冒险有很大帮助。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他已经拒绝了协会…",
              "dialogues": []
            },
            {
              "text": "他可能不容易交流吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "请您自信一些，您可是西风骑士团的「荣誉骑士」啊。"
        },
        {
          "role": "凯瑟琳",
          "text": "您的事迹到现在为止还被那些吟游诗人们不断地传唱呢。"
        },
        {
          "role": "旅行者",
          "text": "好吧，关于那位陌生人的信息…"
        },
        {
          "role": "凯瑟琳",
          "text": "嗯…有关他的消息…您可以先去问问劳伦斯先生。"
        },
        {
          "role": "凯瑟琳",
          "text": "他是驻守城门的骑士，说不定会知道一些关于那位陌生人的事。"
        },
        {
          "role": "凯瑟琳",
          "text": "祝您顺利，冒险家。"
        },
        {
          "type": "subtitle",
          "text": "向劳伦斯打听那位「陌生人」的消息"
        },
        {
          "role": "劳伦斯",
          "text": "啊…荣誉骑士，您有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于戴着眼罩的陌生人…"
        },
        {
          "role": "劳伦斯",
          "text": "戴着眼罩、衣着奇异的金发陌生人？我想想啊…有点印象。"
        },
        {
          "role": "劳伦斯",
          "text": "最开始，他在蒙德城里到处走动，因为看起来就很可疑嘛，我就想稍微观察一下。"
        },
        {
          "role": "劳伦斯",
          "text": "但我的跟踪很快就被他甩掉了…不过，这种小事，应该还不至于拜托侦察骑士，从空中去追踪吧。"
        },
        {
          "role": "劳伦斯",
          "text": "有琴团长在，应该也不用担心一个只是外表可疑的人，会影响蒙德城的安危。"
        },
        {
          "role": "派蒙",
          "text": "唔，但如果是琴团长本人，也许会比劳伦斯作出更认真的反应呢。"
        },
        {
          "role": "劳伦斯",
          "text": "哈哈，确实。不过反过来说，这种可能引起琴团长过度反应的事，好像就更不应该告诉她了？"
        },
        {
          "role": "劳伦斯",
          "text": "对了，听说在我注意他之前，他在瓦格纳的铁匠铺待了一会，不知道和瓦格纳说了什么。"
        },
        {
          "role": "劳伦斯",
          "text": "你去问问瓦格纳吧，说不定他也知道一点关于那家伙的消息。"
        },
        {
          "role": "劳伦斯",
          "text": "不知道这次的陌生人，又会带来什么麻烦事…"
        },
        {
          "type": "subtitle",
          "text": "向瓦格纳打听那位「陌生人」的消息"
        },
        {
          "role": "瓦格纳",
          "text": "怎么，你有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于戴着眼罩的陌生人…"
        },
        {
          "role": "瓦格纳",
          "text": "我记得，他前几天确实来过这里，说是想要买一批锻造材料。"
        },
        {
          "role": "瓦格纳",
          "text": "但是他说的那些材料，我几乎全都没有听说过。"
        },
        {
          "role": "瓦格纳",
          "text": "他又看了一会我铺子里的剑，然后就离开了。我听说，他有时候会去「天使的馈赠」里喝酒。"
        },
        {
          "role": "瓦格纳",
          "text": "哈哈哈，西风骑士和冒险家协会，要是想抓住他的行踪，那大概是唯一可能的地方吧。"
        },
        {
          "role": "派蒙",
          "text": "「天使的馈赠」？啊，那么迪卢克老爷也一定注意到那位陌生人了吧。"
        },
        {
          "role": "派蒙",
          "text": "唔，总之我们先去「天使的馈赠」看看吧。"
        },
        {
          "role": "瓦格纳",
          "text": "那家伙说的那些锻造材料，真的存在吗…"
        },
        {
          "type": "subtitle",
          "text": "向查尔斯打听那位「陌生人」的消息"
        },
        {
          "role": "查尔斯",
          "text": "葡萄汁，还是苹果酿？"
        },
        {
          "role": "旅行者",
          "text": "对我完全没有酒的选项啊…"
        },
        {
          "role": "派蒙",
          "text": "查尔斯先生，请问您见过一位戴着眼罩的金发陌生人吗？"
        },
        {
          "role": "查尔斯",
          "text": "见过，他每天晚上都会来光顾，只喝酒，不吃其他的东西。"
        },
        {
          "role": "查尔斯",
          "text": "而且他在点了酒之后，偶尔还会自己调制一下。"
        },
        {
          "role": "查尔斯",
          "text": "其他的事我不知道，但就酒的品种挑选，和他的调酒手法来说，他是一位对酒颇有品味的先生。"
        },
        {
          "role": "派蒙",
          "text": "那迪卢克老爷对他有什么看法吗？"
        },
        {
          "role": "查尔斯",
          "text": "我刚才说的就是迪卢克老爷的看法，「一位对酒颇有品味的先生」。"
        },
        {
          "role": "派蒙",
          "text": "不愧是迪卢克，果然只有他已经全都调查完了…"
        },
        {
          "role": "查尔斯",
          "text": "如果您想找那位先生的话…他昨天刚刚预订了一瓶新酒，今天应该也会光顾。"
        },
        {
          "role": "查尔斯",
          "text": "一楼的客人太多，声音太嘈杂，您要等的话，就去二楼等一下吧。"
        },
        {
          "role": "查尔斯",
          "text": "那位客人应该会在晚上光顾，您可以先去二楼等等。"
        },
        {
          "type": "subtitle",
          "text": "去酒馆二楼靠栏杆的座位坐下等待"
        },
        {
          "type": "subtitle",
          "text": "旅行者和派蒙在二楼开始了等待…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "查尔斯",
          "text": "啊，欢迎光临，先生。您预订的酒已经准备好了。"
        },
        {
          "role": "派蒙",
          "text": "那个人真的来了，我们快下去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "前往酒馆一楼，寻找那位「陌生人」"
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "你好，我是冒险家协会的冒险家…"
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "您好，我是西风骑士团的荣誉骑士…"
        },
        {
          "role": "派蒙",
          "text": "完全没有搭理我们的意思啊…"
        },
        {
          "role": "旅行者",
          "text": "那个…我是旅行者…"
        },
        {
          "role": "？？？",
          "text": "旅行者…哼。你为什么要旅行？"
        },
        {
          "role": "旅行者",
          "text": "为了寻找失散的亲人。"
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "role": "？？？",
          "text": "这个理由还算不错…坐吧，坐对面。"
        },
        {
          "role": "派蒙",
          "text": "这…这算是搭上话了吗？真是个奇怪的人。"
        },
        {
          "role": "？？？",
          "text": "你旁边的这个小东西…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是应急食品。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂！完全不对！"
                }
              ]
            },
            {
              "text": "是最好的伙伴。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯，我们是最好的伙伴！"
                }
              ]
            }
          ]
        },
        {
          "role": "？？？",
          "text": "旅行的时候有人陪着，倒也不错。"
        },
        {
          "role": "戴因斯雷布",
          "text": "我的名字是戴因斯雷布。你找我有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "其实…是冒险家活动的招募…"
        },
        {
          "role": "戴因斯雷布",
          "text": "好。"
        },
        {
          "role": "旅行者",
          "text": "…啊？"
        },
        {
          "role": "派蒙",
          "text": "（明明是这么冷淡的人…这样答应下来，让人非常不安！）"
        },
        {
          "role": "戴因斯雷布",
          "text": "但是，你要提前支付我报酬。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "报，报酬…",
              "dialogues": []
            },
            {
              "text": "要，要多少？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "戴因斯雷布",
          "text": "500摩拉，和三个问题。"
        },
        {
          "role": "戴因斯雷布",
          "text": "500摩拉一次性支付，三个问题稍后再问。"
        },
        {
          "role": "旅行者",
          "text": "就…这些？"
        },
        {
          "role": "戴因斯雷布",
          "text": "就这些。"
        },
        {
          "role": "派蒙",
          "text": "这种报酬，更加让人不安了，总觉得会有什么问题…"
        },
        {
          "role": "旅行者",
          "text": "这500摩拉您收好…"
        },
        {
          "role": "戴因斯雷布",
          "text": "我收下了。那么还有三个问题，你得在这里回答我。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "答错了的话会怎样？",
              "dialogues": []
            },
            {
              "text": "我必须要全部答对吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "戴因斯雷布",
          "text": "对一个问题的「回答」没有对错之分，只是不同「态度」的昭示。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "戴因斯雷布",
          "text": "第一个问题。"
        },
        {
          "role": "戴因斯雷布",
          "text": "蒙德城的龙灾，是你和那位…自称温迪的风神，联手解决的。在你看来，终结龙灾的关键是谁？"
        },
        {
          "role": "旅行者",
          "text": "你怎么知道温迪是…！"
        },
        {
          "role": "戴因斯雷布",
          "text": "我知道一切我应该知道的事。"
        },
        {
          "role": "戴因斯雷布",
          "text": "回答我的问题吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是温迪。",
              "dialogues": []
            },
            {
              "text": "是我。",
              "dialogues": []
            },
            {
              "text": "是所有齐心协力的蒙德人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "戴因斯雷布",
          "text": "这就是你的回答吗…我知道了。"
        },
        {
          "role": "戴因斯雷布",
          "text": "第二个问题。"
        },
        {
          "role": "戴因斯雷布",
          "text": "护佑璃月港数千年的岩王帝君，用自己的神之心，订下了内容未知的，所谓「终结一切契约的契约」。"
        },
        {
          "role": "戴因斯雷布",
          "text": "你认为，在失去了神明以后，璃月港又会由谁来守护？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "仙人们。",
              "dialogues": []
            },
            {
              "text": "璃月七星。",
              "dialogues": []
            },
            {
              "text": "璃月港里的所有人。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "戴因斯雷布",
          "text": "这就是你的回答吗…我知道了。"
        },
        {
          "role": "戴因斯雷布",
          "text": "最后一个问题。"
        },
        {
          "role": "戴因斯雷布",
          "text": "这个世界上，有得到了「神之眼」的人，和没有得到「神之眼」的人。"
        },
        {
          "role": "戴因斯雷布",
          "text": "你认为，对神灵而言，这两种人里，哪一种更加重要？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "拥有「神之眼」的人。",
              "dialogues": []
            },
            {
              "text": "没有「神之眼」的人。",
              "dialogues": []
            },
            {
              "text": "也许都不重要。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "戴因斯雷布",
          "text": "这就是你的回答吗…我知道了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "三个问题中至少两个选择第三个选项",
              "dialogues": [
                {
                  "role": "戴因斯雷布",
                  "text": "果然你和她非常相似。"
                }
              ]
            },
            {
              "text": "其他选择组合",
              "dialogues": [
                {
                  "role": "戴因斯雷布",
                  "text": "看来…你还是和她不一样。"
                }
              ]
            }
          ]
        },
        {
          "role": "旅行者",
          "text": "什么意思？你说的「她」是在说谁？"
        },
        {
          "role": "戴因斯雷布",
          "text": "……"
        },
        {
          "role": "戴因斯雷布",
          "text": "500摩拉我收下了，你对世界的认知…我也多少了解了一些。那么，按照约定，你可以「委托」我做事了。"
        },
        {
          "role": "戴因斯雷布",
          "text": "不过，我只接受和「深渊教团」有关的委托。"
        },
        {
          "role": "戴因斯雷布",
          "text": "我和你一样，正在旅行之中。你是为了寻找亲人，而我，是为了对抗深渊。"
        },
        {
          "role": "旅行者",
          "text": "我倒是遇见过一些「深渊法师」…"
        },
        {
          "role": "戴因斯雷布",
          "text": "嗯，这些侍奉深渊的怪物，是「深渊教团」在这世上散播混乱的爪牙。"
        },
        {
          "role": "戴因斯雷布",
          "text": "而我这次来到蒙德，是追踪着「深渊使徒」的痕迹…"
        },
        {
          "role": "派蒙",
          "text": "深渊使徒？"
        },
        {
          "role": "戴因斯雷布",
          "text": "是深渊中的一种更扭曲的怪物，深渊法师们的统领。"
        },
        {
          "role": "旅行者",
          "text": "这么说来，龙灾之后，好像一直…"
        },
        {
          "role": "派蒙",
          "text": "啊，对哦！龙灾之后，我们好像就一直在璃月，和愚人众这种「人类内部的」恶势力纠缠…"
        },
        {
          "role": "派蒙",
          "text": "一直没有「非人的」深渊教团什么事呢。"
        },
        {
          "role": "戴因斯雷布",
          "text": "恐怕…这其中也是有什么原因的吧。"
        },
        {
          "role": "戴因斯雷布",
          "text": "或许…它们是被某人命令，刻意绕开了你的行进路线。"
        },
        {
          "role": "派蒙",
          "text": "听上去好危险…是为了在更合适的时机埋伏我们吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "它们打不倒我。",
              "dialogues": []
            },
            {
              "text": "我会打倒它们的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！我们可是很厉害的。"
        },
        {
          "role": "戴因斯雷布",
          "text": "（真是…和她一模一样的气势。）"
        },
        {
          "role": "戴因斯雷布",
          "text": "也好，我们去实地看看吧。根据我手上的一些线索，深渊教团曾经重新进入过「西风之鹰的庙宇」。"
        },
        {
          "role": "戴因斯雷布",
          "text": "在那里汇合吧。你对深渊的疑惑，或许在那里会有解答。"
        },
        {
          "type": "subtitle",
          "text": "前往「西风之鹰」庙宇"
        },
        {
          "role": "戴因斯雷布",
          "text": "这座无人供奉的庙宇里，确实有「深渊」的痕迹。"
        },
        {
          "role": "戴因斯雷布",
          "text": "「西风之鹰」…虽能凭风翱翔，但始终也只是徘徊在神明的光芒之下…"
        },
        {
          "role": "旅行者",
          "text": "你在说什么？"
        },
        {
          "role": "戴因斯雷布",
          "text": "没什么，我们快点进去吧。"
        },
        {
          "type": "subtitle",
          "text": "进入「西风之鹰」庙宇"
        },
        {
          "type": "subtitle",
          "text": "继续向前探索"
        },
        {
          "role": "戴因斯雷布",
          "text": "深渊的气息越来越重了，不远了。"
        },
        {
          "role": "派蒙",
          "text": "深渊使徒，到底长什么样呢？唔…是不是和深渊法师差不多…"
        },
        {
          "role": "戴因斯雷布",
          "text": "我们先继续往前吧，如果能见到那怪物，那么我不解释你们也能清楚了。"
        },
        {
          "type": "subtitle",
          "text": "与戴因斯雷布对话"
        },
        {
          "role": "戴因斯雷布",
          "text": "只发现了那些深渊法师吗？看来，深渊使徒可能已经离开了。"
        },
        {
          "role": "旅行者",
          "text": "能多说说深渊教团的事吗？"
        },
        {
          "role": "戴因斯雷布",
          "text": "「深渊」…"
        },
        {
          "role": "戴因斯雷布",
          "text": "是混乱，也是毁灭，是一团不可捉摸的癫狂混沌，侵蚀这个世界的根基。"
        },
        {
          "role": "戴因斯雷布",
          "text": "这就是身为神灵眷属的「东风之龙」，也无法抵挡深渊力量侵蚀的理由。"
        },
        {
          "role": "戴因斯雷布",
          "text": "而深渊中的怪物别无他求，只为颠覆神灵治下的世界…"
        },
        {
          "role": "派蒙",
          "text": "戴因对深渊真是了解。"
        },
        {
          "role": "戴因斯雷布",
          "text": "呵呵，我与「深渊」…缘分不浅。"
        },
        {
          "role": "戴因斯雷布",
          "text": "好了，闲聊就到这里。我们该往奔狼领去了。"
        },
        {
          "role": "戴因斯雷布",
          "text": "根据我最近的追迹，深渊教团出现过的另一个地点，可能就在那头老狼的领土上。"
        },
        {
          "role": "戴因斯雷布",
          "text": "或许，我们可以在那里找到深渊使徒。"
        },
        {
          "type": "subtitle",
          "text": "离开「西风之鹰」的庙宇"
        },
        {
          "type": "subtitle",
          "text": "前往奔狼领"
        },
        {
          "role": "派蒙",
          "text": "已经进入奔狼领的范围了，戴因在前面等我们吗？"
        },
        {
          "role": "派蒙",
          "text": "狼群说不定不喜欢他，还是快点去和他汇合吧。"
        },
        {
          "type": "subtitle",
          "text": "与戴因斯雷布对话"
        },
        {
          "role": "戴因斯雷布",
          "text": "奔狼领之主，北风的王狼…"
        },
        {
          "role": "戴因斯雷布",
          "text": "徒有尖牙和利爪，却只是屈居于此。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你认识它吗？",
              "dialogues": []
            },
            {
              "text": "你和他很熟悉？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "戴因斯雷布",
          "text": "不，我不认识那头老狼，它也不认识我。"
        },
        {
          "role": "戴因斯雷布",
          "text": "我之所以知道这些，是因为我曾经的一位旅伴，想要听它的故事。"
        },
        {
          "role": "戴因斯雷布",
          "text": "好了，我们还是去看看「深渊使徒」有没有来过这里吧。"
        },
        {
          "role": "派蒙",
          "text": "从哪里开始找呢？——唔，戴因站在这里，难道是和这堆奇怪的篝火有关？"
        },
        {
          "role": "戴因斯雷布",
          "text": "没错。火焰上漂浮着的，正是「深渊」的咒语。"
        },
        {
          "role": "戴因斯雷布",
          "text": "以教团的行事风格，或许在附近还有类似留存。在附近多搜索一下吧。"
        },
        {
          "type": "subtitle",
          "text": "分支对话"
        },
        {
          "role": "戴因斯雷布",
          "text": "果然，这里也有「深渊」的爪牙…在附近多搜索一下吧。"
        },
        {
          "type": "subtitle",
          "text": "在奔狼领搜索与深渊教团有关的线索"
        },
        {
          "role": "派蒙",
          "text": "篝火边的魔物…是不是被深渊教团驱使的呢？有点吓人…先打倒它们吧。"
        },
        {
          "role": "派蒙",
          "text": "呼…这样应该就可以了。快去看看那堆篝火吧。"
        },
        {
          "role": "派蒙",
          "text": "看这堆篝火的样子，好像也和「深渊」有关呢…"
        },
        {
          "type": "subtitle",
          "text": "在奔狼领搜索与深渊教团有关的线索"
        },
        {
          "role": "派蒙",
          "text": "又是那种飘着咒语的篝火！"
        },
        {
          "role": "派蒙",
          "text": "看来，「深渊」真的在这附近活动过…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！这群魔物是从哪里冒出来的…快打倒它们吧！"
        },
        {
          "type": "subtitle",
          "text": "与戴因斯雷布对话"
        },
        {
          "role": "戴因斯雷布",
          "text": "你已经搜索完了吗？"
        },
        {
          "role": "旅行者",
          "text": "发现了很多深渊教团的痕迹…"
        },
        {
          "role": "戴因斯雷布",
          "text": "我刚才在这附近也搜索了一阵，确实有一些痕迹。"
        },
        {
          "role": "戴因斯雷布",
          "text": "但是，那些都只是深渊法师留下的痕迹，没有更深层的「深渊」力量存在。"
        },
        {
          "role": "戴因斯雷布",
          "text": "看来，即使是深渊使徒，也不太愿意招惹北风的王狼。"
        },
        {
          "role": "戴因斯雷布",
          "text": "我们也离开吧，那头老狼唯一值得夸赞的，就只有它的领地观念了。"
        },
        {
          "role": "派蒙",
          "text": "唔，线索又断了，只能放弃了吗？"
        },
        {
          "role": "戴因斯雷布",
          "text": "不，还有最后一个地方可去。"
        },
        {
          "role": "戴因斯雷布",
          "text": "行动起来吧，我在「风龙废墟」等你。"
        },
        {
          "type": "subtitle",
          "text": "前往风龙废墟"
        },
        {
          "role": "戴因斯雷布",
          "text": "我听说了你们在「龙灾」中的事迹。你们来的时候，这里被叫做「风龙废墟」。"
        },
        {
          "role": "戴因斯雷布",
          "text": "但现在这个地名的重点，应该是「废墟」，而不是「风龙」了吧。"
        },
        {
          "role": "戴因斯雷布",
          "text": "其实在我的记忆里，这片废墟大部分时间都与那条龙没什么关系。"
        },
        {
          "role": "戴因斯雷布",
          "text": "我第一次见到「旧蒙德」废墟的时候，「东风之龙」还未堕落，更不会来此筑巢。"
        },
        {
          "role": "派蒙",
          "text": "欸？可是，我记得特瓦林出事的时候，是在几百年前…"
        },
        {
          "role": "戴因斯雷布",
          "text": "不必深究。"
        },
        {
          "role": "戴因斯雷布",
          "text": "曾经封印着这座废墟的「导光机关」你应该还有印象吧？"
        },
        {
          "role": "戴因斯雷布",
          "text": "如果「深渊教团」对这座废墟有兴趣的话，那他们一定不会错过这些机关。"
        },
        {
          "role": "戴因斯雷布",
          "text": "我们就先去一处「导光机关」看看情况吧。"
        },
        {
          "type": "subtitle",
          "text": "深入风龙废墟"
        },
        {
          "role": "派蒙",
          "text": "看前面，有好多魔物聚集在一起了！"
        },
        {
          "type": "subtitle",
          "text": "打倒所有魔物"
        },
        {
          "type": "subtitle",
          "text": "与戴因斯雷布对话"
        },
        {
          "role": "派蒙",
          "text": "结果，我们还是没能见到「深渊使徒」呢。"
        },
        {
          "role": "旅行者",
          "text": "有点遗憾。"
        },
        {
          "role": "戴因斯雷布",
          "text": "不必直视那种怪物…这不该说是「遗憾」吧。但我想，以后你一定会与它们有所交集。"
        },
        {
          "role": "派蒙",
          "text": "不不…你说得对。既然是厉害的怪物，那就算见到了，最好也绕着走…"
        },
        {
          "role": "戴因斯雷布",
          "text": "哈…旅行中的危险，如果绕着走就能解决问题的话，那就再好不过了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你对旅行似乎很了解。",
              "dialogues": []
            },
            {
              "text": "经验之谈。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "戴因斯雷布",
          "text": "只是曾经…与那位旅伴一起旅行的时候，有所经历罢了。"
        },
        {
          "role": "派蒙",
          "text": "唔，戴因，你总说旅伴、旅伴的…"
        },
        {
          "role": "派蒙",
          "text": "你的那位旅伴，现在在哪里呀？"
        },
        {
          "role": "戴因斯雷布",
          "text": "她…"
        },
        {
          "role": "戴因斯雷布",
          "text": "她不再旅行了。"
        },
        {
          "role": "戴因斯雷布",
          "text": "因为，旅行实在是太让人疲惫了。"
        },
        {
          "role": "派蒙",
          "text": "这样啊。那么，戴因为什么还在一个人旅行呢？"
        },
        {
          "role": "戴因斯雷布",
          "text": "我…还有一些事，没有办完。等办完了之后，我也会回家休息。"
        },
        {
          "role": "派蒙",
          "text": "有家能回，也是好事呀。我们旅行的时候，经常不得不在野外露宿呢。"
        },
        {
          "role": "派蒙",
          "text": "喂，旅行者，等你找到了亲人，我们也去哪里安个家吧？"
        },
        {
          "role": "派蒙",
          "text": "蒙德的渔人吐司很好吃，璃月的万民堂也很不错…"
        },
        {
          "role": "派蒙",
          "text": "嗯…总之，一定要安在一个有很多好吃东西的地方。"
        },
        {
          "role": "旅行者",
          "text": "你想得也太远了…"
        },
        {
          "role": "戴因斯雷布",
          "text": "家…"
        },
        {
          "role": "戴因斯雷布",
          "text": "嗯，等你的旅途到达了终点，再考虑停留于何处吧。"
        },
        {
          "role": "戴因斯雷布",
          "text": "在旅途之中，就先…"
        },
        {
          "role": "旅行者",
          "text": "…那边的山崖上，有熟悉的气息。"
        },
        {
          "role": "派蒙",
          "text": "咦？什么熟悉的气息？"
        },
        {
          "role": "旅行者",
          "text": "上次来风龙废墟，也有一瞬间…"
        },
        {
          "role": "戴因斯雷布",
          "text": "熟悉的气息么…？除了可能是熟识的人，还可能是熟识的魔物。"
        },
        {
          "role": "旅行者",
          "text": "难道是…「深渊」？"
        },
        {
          "role": "戴因斯雷布",
          "text": "不管是哪方，如果想要弄清楚，直接过去看看就是。"
        },
        {
          "role": "戴因斯雷布",
          "text": "从那边可以迅速去到山崖上，出发吧。"
        },
        {
          "type": "subtitle",
          "text": "追上戴因斯雷布"
        },
        {
          "role": "派蒙",
          "text": "戴因先生走得真快…"
        },
        {
          "role": "派蒙",
          "text": "我们也快点用前面的风场飞上去吧。"
        },
        {
          "role": "戴因斯雷布",
          "text": "你说的那种「熟悉的气息」，还能感受到吗？"
        },
        {
          "role": "旅行者",
          "text": "就在附近。"
        },
        {
          "role": "派蒙",
          "text": "但这周围…无论是人还是魔物，什么都没有啊。"
        },
        {
          "role": "戴因斯雷布",
          "text": "确实，没有什么异常的地方…和我上次来这里的时候，景色也没有差别。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你说「上次」？",
              "dialogues": []
            },
            {
              "text": "你也来过这里吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "戴因斯雷布",
          "text": "上次旅行的时候，我的旅伴带我来过这里。"
        },
        {
          "role": "派蒙",
          "text": "那，戴因，你自己呢？你自己最喜欢的地方是哪里？"
        },
        {
          "role": "戴因斯雷布",
          "text": "我？我已经…记不清了。"
        },
        {
          "role": "戴因斯雷布",
          "text": "那一次旅行，我只是一直陪着我的那位旅伴，仅此而已。"
        },
        {
          "role": "戴因斯雷布",
          "text": "…嗯？"
        },
        {
          "type": "subtitle",
          "text": "跟随戴因斯雷布"
        },
        {
          "role": "戴因斯雷布",
          "text": "遗迹守卫的脚印…在这里也有遗迹守卫游荡吗？"
        },
        {
          "role": "戴因斯雷布",
          "text": "真是连一株蒲公英都不得安宁…"
        },
        {
          "type": "subtitle",
          "text": "上前观察蒲公英"
        },
        {
          "type": "subtitle",
          "text": "相关视频"
        },
        {
          "type": "subtitle",
          "text": "与戴因斯雷布对话"
        },
        {
          "role": "派蒙",
          "text": "你刚才怎么了啊，怎么在原地发呆这么久？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这株蒲公英…",
              "dialogues": []
            },
            {
              "text": "我…感受到她了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸？你，你是说…感受到妹妹了吗？！"
        },
        {
          "role": "派蒙",
          "text": "可是，这是怎么回事…你刚才只是摸了蒲公英一下而已啊。"
        },
        {
          "role": "旅行者",
          "text": "刚才，手触碰的瞬间…"
        },
        {
          "role": "戴因斯雷布",
          "text": "……"
        },
        {
          "role": "戴因斯雷布",
          "text": "或许，这株蒲公英上，带着「只有你能感受到」的气息。"
        },
        {
          "role": "戴因斯雷布",
          "text": "至于原因…难道是它经历了什么，「与你有关」的时刻吗？"
        },
        {
          "role": "派蒙",
          "text": "你说的这些可能性都太模糊了，一点头绪都没有啊…"
        },
        {
          "role": "旅行者",
          "text": "但无论如何，都要查清…！"
        },
        {
          "role": "戴因斯雷布",
          "text": "不要焦急。"
        },
        {
          "role": "戴因斯雷布",
          "text": "烦恼与焦虑是心智之敌，你的旅程才刚刚开始，不是吗？"
        },
        {
          "role": "戴因斯雷布",
          "text": "至少，现在你知道了，她还在这个世界上。"
        },
        {
          "role": "戴因斯雷布",
