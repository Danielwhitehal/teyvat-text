{
  "quest_id": 10071,
  "chapter_num": "",
  "chapter_title": "四礁觅宝记",
  "type": "wq",
  "route": "The Treasure of the Four Skerries",
  "stories": [
    {
      "story_id": 79020,
      "title": "秘宝所藏",
      "description": "似乎有海盗在金苹果群岛的海域上藏起了宝藏，并且将线索一分为四，找到所有的线索，寻得宝藏吧！",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "我看看，嗯…这说不定是什么宝藏的地图！"
        },
        {
          "role": "旅行者",
          "text": "真的吗？"
        },
        {
          "role": "派蒙",
          "text": "哼，我闻到了宝藏的味道，肯定是这样的！"
        },
        {
          "role": "派蒙",
          "text": "你看，留下图的是「海盗赤穗百目鬼一众」，总觉得是在哪里听到过的名字！"
        },
        {
          "role": "派蒙",
          "text": "而且你看，「秘宝所藏之处…」果然有秘宝！"
        },
        {
          "role": "派蒙",
          "text": "嗯，接下来是…「其中隐秘…一分为四…」"
        },
        {
          "role": "派蒙",
          "text": "一分为四，是把什么东西分成了四个的意思吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "宝藏有四份？",
            "藏宝线索有四份？"
          ]
        },
        {
          "role": "派蒙",
          "text": "不知道…"
        },
        {
          "role": "派蒙",
          "text": "不过这边说「置于四座大岛礁石之处」，应该是说藏在金苹果群岛上的四座岛的礁石…"
        },
        {
          "role": "派蒙",
          "text": "啊，这里不就是礁石吗！"
        },
        {
          "role": "旅行者",
          "text": "看来有四份的是藏宝线索…"
        },
        {
          "role": "派蒙",
          "text": "而且还在四个岛的礁石附近！"
        },
        {
          "role": "派蒙",
          "text": "说起金苹果群岛的四个岛，那就肯定是最大的四个了！"
        },
        {
          "role": "派蒙",
          "text": "我们就去其他三个岛的礁石附近找找看吧！"
        },
        {
          "role": "派蒙",
          "text": "这下我们四个线索全部拿到啦…"
        },
        {
          "role": "派蒙",
          "text": "…唔，完全看不懂到底藏在哪里…"
        },
        {
          "role": "派蒙",
          "text": "这个以什么什么为心，是什么意思啊？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "是要根据距离画圆的意思…",
            "心就是圆心吧…"
          ]
        },
        {
          "role": "派蒙",
          "text": "是这样啊，这样就能在地图上画出四个圈，唔，这个以船长为半径…到底是多长啊…"
        },
        {
          "role": "旅行者",
          "text": "不如参考见过的船…"
        },
        {
          "role": "派蒙",
          "text": "嗯，那就把以前在港口看见的大船当参考…唔…"
        },
        {
          "type": "subtitle",
          "text": "派蒙按照提示在地图上画出了四个圈"
        },
        {
          "role": "派蒙",
          "text": "这样就画出四个圈了，宝藏就在四个圈都覆盖到的地方…"
        },
        {
          "role": "派蒙",
          "text": "嗯，那就是藏宝藏的地方了！"
        },
        {
          "role": "派蒙",
          "text": "原来这就是「赤穗百目鬼一众」藏的秘宝，不过…他们那个时候就能把秘宝藏在云阶上吗…"
        },
        {
          "role": "派蒙",
          "text": "总觉得有点奇怪…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "还有布丁岛的山…",
            "还有双双岛上的夜鸦船长…"
          ]
        },
        {
          "role": "派蒙",
          "text": "对啊，那不都是因为机器影响才出现的嘛…难道这个宝藏真的是他们藏起来的吗…"
        },
        {
          "role": "旅行者",
          "text": "可能是宝藏想被找到吧…"
        },
        {
          "role": "派蒙",
          "text": "嗯，也可能是藏下秘宝的人，希望秘宝被找到的想法，被机器影响了呢……"
        },
        {
          "role": "派蒙",
          "text": "不过无论如何，秘宝就归我们啦！"
        }
      ]
    },
    {
      "story_id": 79028,
      "title": "宝藏线索·破破岛",
      "description": "前往破破岛的礁石附近，看看有没有海盗们留下的，关于宝藏的线索…",
      "dialogues": []
    },
    {
      "story_id": 79029,
      "title": "宝藏线索·双双岛",
      "description": "前往双双岛的礁石附近，看看有没有海盗们留下的，关于宝藏的线索…",
      "dialogues": [
        {
          "role": "夜鸦船长",
          "text": "清理掉里面的丘丘人了？真是感谢你们！"
        },
        {
          "role": "夜鸦船长",
          "text": "来吧，我这就告诉你们穿越海上的迷雾，找到线索的办法…"
        },
        {
          "role": "夜鸦船长",
          "text": "如果你们准备好，就去礁石的另一边找我吧！"
        },
        {
          "role": "派蒙",
          "text": "这里有一座雕像？"
        },
        {
          "role": "夜鸦船长",
          "text": "唉…"
        },
        {
          "role": "派蒙",
          "text": "你好，为什么在这个山洞口唉声叹气的呀…"
        },
        {
          "role": "夜鸦船长",
          "text": "我呀，最近住在这个山洞里…"
        },
        {
          "role": "派蒙",
          "text": "居然住在这种山洞里！"
        },
        {
          "role": "夜鸦船长",
          "text": "我也没办法！谁叫岛上突然来了群什么剧团演员，每天敲敲打打的，吵得人根本没法睡觉…所以才找到这里，稍微安静一点。"
        },
        {
          "role": "夜鸦船长",
          "text": "但是不知道从哪里来了一群丘丘人占领了我的歇息之处，我只能在外面吹冷风啦！"
        },
        {
          "role": "夜鸦船长",
          "text": "唉…我在心中暗自发誓，如果有人能帮我，我就告诉他…"
        },
        {
          "role": "派蒙",
          "text": "告诉他什么呀？"
        },
        {
          "role": "夜鸦船长",
          "text": "告诉那个帮助我的人寻找到传说中海盗秘宝的线索！虽然我也只知道四分之一啦…"
        },
        {
          "role": "派蒙",
          "text": "四分之一的线索？"
        },
        {
          "role": "夜鸦船长",
          "text": "看起来你们也是寻求秘宝之人，怎么样，帮我解决里面的丘丘人，我就把线索的位置告诉你。"
        },
        {
          "role": "夜鸦船长",
          "text": "据说得到四份线索，就能找到曾经流落在此的海盗留下的宝藏呢！"
        },
        {
          "role": "派蒙",
          "text": "一言为定！"
        },
        {
          "role": "夜鸦船长",
          "text": "怎么样，准备好了吗！"
        },
        {
          "role": "夜鸦船长",
          "text": "待会儿我会先行一步，在途径的礁石上告诉你们如何进行正确的航行！"
        },
        {
          "role": "夜鸦船长",
          "text": "好了，看到那边那块石头了没，首先，你们得先往那个方向去！"
        },
        {
          "role": "夜鸦船长",
          "text": "怎么样，你们解决里面的丘丘人了吗？"
        }
      ]
    },
    {
      "story_id": 79030,
      "title": "宝藏线索·危危岛",
      "description": "前往危危岛的礁石附近，看看有没有海盗们留下的，关于宝藏的线索…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "从这个礁石出发，顺着星河的方向，是天上的银河的方向吧！我们这就出发吧！"
        }
      ]
    },
    {
      "story_id": 79031,
      "title": "宝藏线索·布丁岛",
      "description": "前往布丁岛的礁石附近，看看有没有海盗们留下的，关于宝藏的线索…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "我看看，这上面写着…"
        },
        {
          "role": "派蒙",
          "text": "唔…树叶全红之时…真是难懂，旅行者，是要我们到什么地方去的意思吗？"
        },
        {
          "role": "派蒙",
          "text": "什么呀，还以为找到了呢，结果还是跟上次一样…"
        },
        {
          "role": "派蒙",
          "text": "「待树叶红黄相间之时，自西方登岛，可见塔楼。」"
        },
        {
          "role": "派蒙",
          "text": "唔，我知道了，有塔楼的只有一种情况！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，看来得把山变成那种样子才行！"
        }
      ]
    }
  ]
}