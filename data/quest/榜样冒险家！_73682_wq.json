{
  "quest_id": 73682,
  "chapter_num": null,
  "chapter_title": "榜样冒险家！",
  "type": "wq",
  "route": "Exemplary Adventurer!",
  "stories": [
    {
      "story_id": 73682,
      "title": "榜样冒险家！",
      "description": "佳酿节期间，名为莱妮的冒险家似乎正在筹办一场特别的挑战活动…",
      "dialogues": [
        {
          "role": "莱妮",
          "text": "可让我一阵好等啊，两位胆识卓绝的朋友！请抓紧这大好的机会，和我一起领略冒险的艺术，尝试超越本我吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "冒险艺术？",
            "超越本我？"
          ]
        },
        {
          "role": "旅行者",
          "text": "冒险艺术？"
        },
        {
          "role": "",
          "text": "唔，虽然不知道你在说什么，但好像很厉害！能不能再解释一下？"
        },
        {
          "role": "莱妮",
          "text": "当然没问题…慢着，我认识你…居然是您！"
        },
        {
          "role": "莱妮",
          "text": "抗击风魔龙的空战豪杰，不倦执勤的委托粉碎机，隐秘宝箱的寻踪人，未知迷雾的破除者…"
        },
        {
          "role": "莱妮",
          "text": "如果您带头参加这次活动，一定能拉动大家的热情，推进这项伟大的事业！"
        },
        {
          "role": "旅行者",
          "text": "好大一串称号？"
        },
        {
          "role": "",
          "text": "从来没听过欸！"
        },
        {
          "role": "莱妮",
          "text": "这些称号通常出现酒桌上、篝火周围和孩子们的睡前故事里，只靠人们口口相传，您没听过也很正常。"
        },
        {
          "role": "莱妮",
          "text": "总之，您活跃的身影鼓励着成百上千位冒险家，给了大家不断变强的动力！"
        },
        {
          "role": "",
          "text": "原来旅行者在蒙德的冒险家协会已经这么有名了吗？那我呢，我有什么称号吗？"
        },
        {
          "role": "莱妮",
          "text": "咳咳！我好像听朋友说过，有人称你为…「如鸟羽般轻灵，如北风般豪爽的派蒙大人」。"
        },
        {
          "role": "莱妮",
          "text": "「鸟羽般轻灵」形容的是你小巧敏捷的身姿，「北风般豪爽」说的是你和北风骑士不相上下的，令人羡慕的好胃口！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "怎么好像是在开玩笑…",
            "怎么好像是刚刚编的…"
          ]
        },
        {
          "role": "旅行者",
          "text": "怎么好像是在开玩笑…"
        },
        {
          "role": "",
          "text": "有点听不明白…但都叫我派蒙大人了，应该很威风吧！我会牢牢记下来的！"
        },
        {
          "role": "",
          "text": "我决定了！不管你有什么请求，我派蒙大人和…呃…和豪杰粉碎机、空战宝箱与委托破除人旅行者都会帮你到底的！"
        },
        {
          "role": "",
          "text": "刚才你好像提到了冒险，超越之类的词，我猜，是不是协会要举办一场特别的挑战活动？"
        },
        {
          "role": "莱妮",
          "text": "完全正确！你们应该听说过，冒险家协会经常为新人开展特训。正好在佳酿节期间，渐强的西风捎来了特别的「风种子」。"
        },
        {
          "role": "莱妮",
          "text": "这些「风种子」可以强化冒险家们的能力，让大家体验变强后的美妙感受，也算是给了冒险家们一个努力的目标。"
        },
        {
          "role": "莱妮",
          "text": "所以塞琉斯会长让我在这些「风种子」散落的区域周围探查一番，找出凶悍魔物和盗匪的所在地。"
        },
        {
          "role": "莱妮",
          "text": "参加试炼的冒险家们需要谨慎运用特别的「风种子」，击败这些敌人。达成技艺的升华，精神的突破，以及对未来的展望！"
        },
        {
          "role": "莱妮",
          "text": "怎么样，有没有觉得很兴奋！"
        },
        {
          "role": "",
          "text": "哼哼，果然没错，我的直觉很准嘛！"
        },
        {
          "role": "",
          "text": "反正我们已经吃饱喝足了，不活动一下的话，也许会变胖呢。"
        },
        {
          "role": "莱妮",
          "text": "对吧对吧！赶快卷起袖子来试试吧！如果你们参与了这场试炼，相信会有很多冒险家慕名而来的。"
        },
        {
          "role": "莱妮",
          "text": "接下来，我会给你们指出首个挑战区域。"
        },
        {
          "role": "莱妮",
          "text": "放手去干吧，我会记录你们的英姿，并向其他冒险家好好宣传的！"
        }
      ]
    }
  ]
}