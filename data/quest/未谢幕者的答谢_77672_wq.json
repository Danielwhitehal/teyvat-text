{
  "quest_id": 77672,
  "chapter_num": null,
  "chapter_title": "未谢幕者的答谢",
  "type": "wq",
  "route": "The Unbowed One's Gratitude",
  "stories": [
    {
      "story_id": 77672,
      "title": "未谢幕者的答谢",
      "description": "有了这些材料，奥黛塔应该就能将她的八音盒彻底修好了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与奥黛塔对话"
        },
        {
          "role": "奥黛塔",
          "text": "这样应该就修好了…"
        },
        {
          "role": "奥黛塔",
          "text": "我看看…"
        },
        {
          "role": "旅行者",
          "text": "终于迎来这一刻了。"
        },
        {
          "role": "奥黛塔",
          "text": "闭上眼睛。"
        },
        {
          "role": "旅行者",
          "text": "欸？"
        },
        {
          "role": "奥黛塔",
          "text": "我已经尽我所能，但维修毕竟不是我的专业领域。"
        },
        {
          "role": "奥黛塔",
          "text": "如果它还存在某些故障的话，我不希望先被你看见了…所以，请你闭上眼睛。"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "…！"
        },
        {
          "role": "旅行者",
          "text": "（这应该是…成功了吧？）"
        },
        {
          "role": "旅行者",
          "text": "现在可以睁眼了吗？"
        },
        {
          "role": "奥黛塔",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "…奥黛塔？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "（悄悄睁眼…）",
            "（等奥黛塔回复…）"
          ]
        },
        {
          "role": "奥黛塔",
          "text": "……"
        },
        {
          "role": "奥黛塔",
          "text": "抱歉，刚才情绪有些激动。"
        },
        {
          "role": "奥黛塔",
          "text": "没想到隔了那么久，它竟然还能奏出那么轻柔的旋律，就和从前一样。"
        },
        {
          "role": "旅行者",
          "text": "（所以…刚才叫我闭眼的真正原因，是不想被看到自己情绪波动的样子吧…）"
        },
        {
          "role": "旅行者",
          "text": "愿意聊聊吗？"
        },
        {
          "role": "奥黛塔",
          "text": "…好吧，如果你能保密。"
        },
        {
          "role": "奥黛塔",
          "text": "之前和你提过，这是一份生日礼物。其实它也是我从母亲那里收到的最后一份生日礼物。"
        },
        {
          "role": "奥黛塔",
          "text": "原因很复杂。在那之后家里变得有些拮据，日子则是过得越来越忙碌…"
        },
        {
          "role": "奥黛塔",
          "text": "但最主要的，还是我和母亲的关系渐渐疏远了。"
        },
        {
          "role": "奥黛塔",
          "text": "她总说我的舞蹈里缺少情感的温度，我则是叛逆地躲进冰层之中，默默对抗着她的教导。"
        },
        {
          "role": "奥黛塔",
          "text": "近来，我终于意识到了当年的幼稚，我从家里的阁楼上找到了它…这个美好岁月的记录者。"
        },
        {
          "role": "奥黛塔",
          "text": "讽刺的是，它的声音和你最初在剧院里听到的那样，扭曲，艰涩，控诉着我这些年对它和亲人的冷遇。"
        },
        {
          "role": "奥黛塔",
          "text": "我不禁想…"
        },
        {
          "role": "奥黛塔",
          "text": "如果能够修好一个在时间中失真的音乐盒，是否也能修复一段被自己消磨过的亲情？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我很难给你直接答案。",
            "但我建议你尝试。"
          ]
        },
        {
          "role": "奥黛塔",
          "text": "我会的。"
        },
        {
          "role": "奥黛塔",
          "text": "而且，我今晚就打算这么做。"
        },
        {
          "role": "奥黛塔",
          "text": "但我该先感谢你。虽然本不想依靠别人的帮助，但维修能够那么顺利，还是多亏你提供的材料。"
        },
        {
          "role": "奥黛塔",
          "text": "而且，你把这里装饰得很典雅。很符合我的审美。"
        },
        {
          "role": "奥黛塔",
          "text": "不过…这样就吓不跑那些爱凑热闹的人了呢，有些可惜。"
        },
        {
          "role": "奥黛塔",
          "text": "今后的演出，我会记得给你留票的。"
        }
      ]
    }
  ]
}