{
  "quest_id": 25035,
  "chapter_num": null,
  "chapter_title": "嘿！你的信！",
  "type": "iq",
  "route": "Hey, Your Letter!",
  "stories": [
    {
      "story_id": 25035,
      "title": "嘿！你的信！",
      "description": "「悬木人」的米齐卡，最近遇见了一些麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与米齐卡对话"
        },
        {
          "role": "米齐卡",
          "text": "这群冒失鬼。怎么又丢失了好几份快件。都说了在送东西的时候不要玩那些花里胡哨的动作…"
        },
        {
          "role": "旅行者",
          "text": "发生什么事了吗？"
        },
        {
          "role": "米齐卡",
          "text": "有几个「讯使」又不听劝，把人家寄出去的快件弄丢了。"
        },
        {
          "role": "米齐卡",
          "text": "唉，他们都意识不到，这是在损坏我们「悬木人」的声誉吗？"
        },
        {
          "role": "米齐卡",
          "text": "送东西就好好送东西，遇见山坡就正常越过去，有什么必要半路突然开始玩滑行？"
        },
        {
          "role": "米齐卡",
          "text": "我说了好多次，但那群年轻人就是听不进去。成天就想着追求刺激…"
        },
        {
          "role": "米齐卡",
          "text": "唉，我还得托人去把那些快件找回来。谁有空呢？我想想…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我可以帮忙。",
              "dialogues": [
                {
                  "role": "米齐卡",
                  "text": "你…愿意帮我？那就太好了。"
                },
                {
                  "role": "米齐卡",
                  "text": "我一时半会也找不到能帮忙的人，如果我自己去找，那「讯使长屋」就没人看店了。"
                }
              ]
            },
            {
              "text": "那些快件，很大吗？",
              "dialogues": [
                {
                  "role": "米齐卡",
                  "text": "不大。但就因为它们不大，每次找起来都很麻烦，唉，那群粗心的小子…"
                },
                {
                  "role": "米齐卡",
                  "text": "…如果你有空的话。愿意帮我去找找那些快件吗？"
                },
                {
                  "role": "米齐卡",
                  "text": "现在「讯使长屋」里的人手也不够，如果我自己去找，那就没人看店了。"
                },
                {
                  "role": "旅行者",
                  "text": "没问题，我来帮忙。"
                },
                {
                  "role": "米齐卡",
                  "text": "那就太好了！真是多谢！"
                }
              ]
            }
          ]
        },
        {
          "role": "米齐卡",
          "text": "我也不会让你大海捞针的。我知道那群小子一般会从哪里走，也大概能猜到那些快件的丢失地点。"
        },
        {
          "role": "米齐卡",
          "text": "我这就给你划出那些快件的丢失地点，就拜托你了。"
        },
        {
          "type": "subtitle",
          "text": "寻找丢失的快件"
        },
        {
          "role": "派蒙",
          "text": "按照标记…快件应该就在附近了。"
        },
        {
          "role": "派蒙",
          "text": "我们仔细在周围找一找吧，唔…会在哪里呢…"
        },
        {
          "type": "subtitle",
          "text": "寻找丢失的快件"
        },
        {
          "role": "米齐卡",
          "text": "一份…两份，还差几份…"
        },
        {
          "type": "subtitle",
          "text": "向米齐卡回报"
        },
        {
          "role": "米齐卡",
          "text": "怎么样？你找到那些快件了吗？"
        },
        {
          "type": "subtitle",
          "text": "与米齐卡对话"
        },
        {
          "role": "米齐卡",
          "text": "两份…三份…齐了。太好了，那些丢失的快件都找回来了。"
        },
        {
          "role": "米齐卡",
          "text": "…等会，这份快件是不是归图达玛送来着？"
        },
        {
          "role": "米齐卡",
          "text": "这些报酬给你，谢谢你帮忙。"
        },
        {
          "role": "米齐卡",
          "text": "呼…我真是要找图达玛这小子好好聊一聊了！"
        }
      ]
    }
  ]
}