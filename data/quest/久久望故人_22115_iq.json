{
  "quest_id": 22115,
  "chapter_num": null,
  "chapter_title": "久久望故人",
  "type": "iq",
  "route": "For Old Time's Sake",
  "stories": [
    {
      "story_id": 22115,
      "title": "久久望故人",
      "description": "轻策庄的常九爷说自己去「无妄坡」取材，却迟迟没有回来，若心奶奶有些担心…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与若心对话"
        },
        {
          "role": "若心",
          "text": "唉，这小常…怎么还不回来。"
        },
        {
          "role": "旅行者",
          "text": "小常是…"
        },
        {
          "role": "若心",
          "text": "小常啊，就是你们喊的「常九爷」。"
        },
        {
          "role": "若心",
          "text": "唉，我叫他小常叫习惯了，一直就这么叫了…"
        },
        {
          "role": "若心",
          "text": "昨天晚上，他说要出去给自己的小说取材，我也没在意，就随口叮嘱了他两句早点回来。"
        },
        {
          "role": "若心",
          "text": "结果，到现在他也没回来。我真担心他是出了什么事。"
        },
        {
          "role": "若心",
          "text": "但我这老身子骨，也不好出去找他，能拜托你们，帮我去找找小常吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我们吧。",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "那就太好了，就拜托你们了。"
                }
              ]
            },
            {
              "text": "您知道他去哪了吗？",
              "dialogues": [
                {
                  "role": "若心",
                  "text": "唉，他还能去哪，还不是北边的「无妄坡」。"
                },
                {
                  "role": "若心",
                  "text": "请你们帮我去看看他吧，这么长时间了，可别出了什么意外。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找常九爷"
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物"
        },
        {
          "type": "subtitle",
          "text": "与常九爷对话"
        },
        {
          "role": "常九爷",
          "text": "嘿…这群怪物，真是讨人嫌…"
        },
        {
          "role": "常九爷",
          "text": "我就是来给我的新小说取个材，材没取到，倒是撞上了这群怪物。"
        },
        {
          "role": "常九爷",
          "text": "谢谢你们了啊，要不是你们，我还真不知道怎么脱身呢。"
        },
        {
          "role": "旅行者",
          "text": "若心奶奶很担心你。"
        },
        {
          "role": "常九爷",
          "text": "担心我？我有什么可担心的，我都这么大人了，知道怎么照顾自己。呃…这么点意外，其实我自己也能处理，就是有点费劲…"
        },
        {
          "role": "常九爷",
          "text": "不过，还是谢谢你们了…我就快点回去吧，免得她老人家又唠叨个不停。"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "就这么走掉了啊…我们也回去吧。"
        },
        {
          "role": "派蒙",
          "text": "咦？地上好像有什么东西…是常九爷掉的吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…先过去捡起来看看吧。"
        },
        {
          "type": "subtitle",
          "text": "搜集书页"
        },
        {
          "type": "subtitle",
          "text": "将书页交给常九爷"
        },
        {
          "role": "若心",
          "text": "唉，这小常…怎么还不回来。"
        },
        {
          "role": "旅行者",
          "text": "常九爷去「无妄坡」做什么？"
        },
        {
          "role": "若心",
          "text": "他啊，说要去那里给小说取材，说什么那里僻静，容易有灵感。"
        },
        {
          "role": "若心",
          "text": "但这轻策庄里谁不知道，他到底是去那里做什么。"
        },
        {
          "role": "常九爷",
          "text": "唉，到底怎么才能写出一本好小说…"
        },
        {
          "role": "旅行者",
          "text": "这些是你掉的吗？"
        },
        {
          "role": "常九爷",
          "text": "什么？哦…这确实是我的，这些都是我写的废稿，本来就是丢到河里去销毁的。"
        },
        {
          "role": "常九爷",
          "text": "你们还把它们捡回来…这上面的字都看不清了。"
        },
        {
          "role": "旅行者",
          "text": "这上面写了什么？"
        },
        {
          "role": "常九爷",
          "text": "哦，是我写给我妹子的故事，这几章都是废稿了。你是不知道啊，小时候，这丫头天天缠着我，要我给她讲故事。"
        },
        {
          "role": "常九爷",
          "text": "可惜啊，我之前没时间写，就写了个开头给她，让她自己先看，准备以后有时间再慢慢写给她。"
        },
        {
          "role": "常九爷",
          "text": "但是那丫头突然有一天就不见了，我怎么找都找不着…"
        },
        {
          "role": "常九爷",
          "text": "哼，准是她家里人不喜欢我，不想她和我在一起，就找了个机会，不声不响地带着她，整家从轻策庄里搬走了。"
        },
        {
          "role": "常九爷",
          "text": "他们就瞧好吧，等我发了家，一准让他们刮目相看！然后，我就把我写给我妹子的那本书，给弄到全世界去卖！"
        },
        {
          "role": "常九爷",
          "text": "这样，无论她们现在住在哪，都能知道我老常已经混出了头！不是当年那个我了！"
        },
        {
          "role": "常九爷",
          "text": "然后…我就一定能和她再见面…不过在那之前，我还是先得把这本书给写完了。"
        },
        {
          "role": "常九爷",
          "text": "…对不住，说着说着就唠叨起来了。唉，我还是再想想怎么写好我的那本书吧…"
        },
        {
          "type": "subtitle",
          "text": "与若心对话"
        },
        {
          "role": "常九爷",
          "text": "写到哪了来着…"
        },
        {
          "role": "旅行者",
          "text": "你妹子的名字是…"
        },
        {
          "role": "常九爷",
          "text": "你问这个做什么…她平时都不乐意我叫她大名，说太生分了，所以我一直叫她的小名。"
        },
        {
          "role": "常九爷",
          "text": "不过，这么多年过去了，那丫头估计也长大了，再叫她小名也有点不太像话…"
        },
        {
          "role": "常九爷",
          "text": "再见面的时候，我也得叫她大名了啊…喂，别想了啊，我可不会把我妹子的名字告诉你，小名大名都没门。"
        },
        {
          "role": "若心",
          "text": "唉，这个小常啊…"
        },
        {
          "role": "旅行者",
          "text": "常九爷已经回来了。"
        },
        {
          "role": "若心",
          "text": "哦，我已经看见他了，真是辛苦你们了。"
        },
        {
          "role": "若心",
          "text": "他和小时候一样，就爱到处闯祸，总是说自己长大了，其实就是长不大…"
        },
        {
          "role": "若心",
          "text": "好啦，你们也别太操心了，这是小常他自己的事情。"
        },
        {
          "role": "若心",
          "text": "谢谢你们帮我跑了一趟。这是给你们的，收下吧。"
        },
        {
          "role": "若心",
          "text": "你们还有自己的事吧，赶紧去忙吧。别和小常似的，为了所谓的「出人头地」、「刮目相看」，耽误了正视自己的机会…"
        },
        {
          "role": "若心",
          "text": "唉…凡人不是仙，人生在世…何苦来哉，何苦来哉…"
        }
      ]
    }
  ]
}