  "chapter_title": "通路计划",
  "type": "wq",
  "route": "Project Connectivity",
  "stories": [
    {
      "story_id": 73690,
      "title": "通路计划",
      "description": "刹诃伐罗学院的达雅似乎正在因为某事而忙碌着…",
      "dialogues": [
        {
          "role": "达雅",
          "text": "你好，我是刹诃伐罗学院的达雅！你也是来参加学院游乐会的吗？"
        },
        {
          "role": "达雅",
          "text": "这是我们学院推出的游玩项目：「通路计划」！"
        },
        {
          "role": "达雅",
          "text": "怎么样？要不要试着玩一玩呀？"
        },
        {
          "role": "旅行者",
          "text": "我记得刹诃伐罗学院是研究…"
        },
        {
          "role": "达雅",
          "text": "我们学院的研究很多都与机关和建筑有关。"
        },
        {
          "role": "达雅",
          "text": "咳，说远了…为了参与这次学院游乐会，我们学院里的很多学生群策群力…"
        },
        {
          "role": "达雅",
          "text": "最终，研究出了「通路计划」这个游玩项目！"
        },
        {
          "role": "达雅",
          "text": "简单来说，游玩者需要用我们已经准备好的各种物件搭建道路。"
        },
        {
          "role": "达雅",
          "text": "无论是架桥啦，铺梯啦…最终的目标，就是搭建出一条可以供人通行，并且直达终点的道路。"
        },
        {
          "role": "达雅",
          "text": "在搭建完毕后，我们还会进行一次最终检验…就像是验收搭建好的建筑一样。"
        },
        {
          "role": "达雅",
          "text": "总之，只要能搭建出一条安全的道路，就算是获胜啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "听上去很复杂…",
            "我没什么建筑天赋…"
          ]
        },
        {
          "role": "旅行者",
          "text": "听上去很复杂…"
        },
        {
          "role": "达雅",
          "text": "哈哈哈，不用担心，这又不是在现实里建设建筑。"
        },
        {
          "role": "达雅",
          "text": "就算是搭建失误，道路垮塌了也没关系，只要重新搭建就好，我们也不会限定尝试次数的。"
        },
        {
          "role": "达雅",
          "text": "只要发挥想象力，搭出一条漂亮的道路就好啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我想试试看。",
            "还有别的事。"
          ]
        },
        {
          "role": "旅行者",
          "text": "我想试试看。"
        },
        {
          "role": "达雅",
          "text": "没问题，那么就请看向这边…"
        }
      ]
    }
  ]
}