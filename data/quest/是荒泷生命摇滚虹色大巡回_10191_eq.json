{
  "quest_id": 10191,
  "chapter_num": "荒泷生命摇滚虹色大巡回·下",
  "chapter_title": "是荒泷生命摇滚虹色大巡回",
  "type": "eq",
  "route": "...It's the Iridescent Arataki Rockin' for Life Tour de Force of Awesomeness!",
  "stories": [
    {
      "story_id": 40158,
      "title": "是荒泷生命摇滚虹色大巡回",
      "description": "在众人（特别是你）的倾力付出下，演出场地终于准备就绪，是时候开始最后的庆典了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与德沃沙克交谈"
        },
        {
          "role": "德沃沙克",
          "text": "多谢两位，终于，这下清单上的事项就全部完成了。"
        },
        {
          "role": "德沃沙克",
          "text": "请让我来做最后的准备，我们第二天在这里见吧，到时候就可以开始最后的庆典了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（德沃沙克）"
        },
        {
          "role": "德沃沙克",
          "text": "请让我来做庆典晚会最后的准备吧。"
        },
        {
          "type": "subtitle",
          "text": "等待至次日14时-16时"
        },
        {
          "type": "subtitle",
          "text": "与一斗交谈"
        },
        {
          "role": "荒泷一斗",
          "text": "挚友啊！你们来了，多亏了你们，现在的场子比想象中还要好！哈哈哈哈哈哈！"
        },
        {
          "role": "久岐忍",
          "text": "完全是一副准备就绪的样子了。旅行者，派蒙，多谢你们。"
        },
        {
          "role": "派蒙",
          "text": "不要说这么见外的话啦，你们这样可一点也不摇滚哦。"
        },
        {
          "role": "荒泷一斗",
          "text": "矮堇瓜，你倒是学得很快嘛！我还听说，今晚你也打算要上台，和本大爷掰掰手腕？"
        },
        {
          "role": "派蒙",
          "text": "我…我就是随便说说的…真是的！德沃沙克这家伙！"
        },
        {
          "role": "荒泷一斗",
          "text": "不敢了吧，毕竟本大爷可是连续好多届的荒泷豪歌会冠军。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙啊，你，不够摇滚。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "呜哇！我就是谦逊！谦逊！我摇滚着呢！"
                }
              ]
            },
            {
              "text": "派蒙，你不会输给一斗的！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘿嘿，你这么觉得吗？其实我也这么觉得！"
                }
              ]
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "那就来比一比啊。"
        },
        {
          "role": "派蒙",
          "text": "比！比就比，谁怕谁啊？哼！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "话说回来，你们找到狗了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "…那个倒是完全走进死胡同了，五郎兄弟说不知道，阿守他们在稻妻城也没打听到什么。"
        },
        {
          "role": "荒泷一斗",
          "text": "难道那只狗真在天守阁？所以才找不到？"
        },
        {
          "role": "派蒙",
          "text": "你可不要又随便闯进天守阁啊，不然裟罗会很头疼的。"
        },
        {
          "role": "荒泷一斗",
          "text": "你说得对，总是麻烦那家伙，本大爷也许真的会遭雷劈…"
        },
        {
          "role": "荒泷一斗",
          "text": "所以这次只是往天守阁里扔了些小纸条，希望那个雷电将军能看到，然后把狗交出来。"
        },
        {
          "role": "派蒙",
          "text": "喂喂，那也是很危险的行为吧…"
        },
        {
          "role": "久岐忍",
          "text": "看来鹿野院同心的猜测是正确的，可能这就只是个乡野传说而已。"
        },
        {
          "role": "荒泷一斗",
          "text": "太遗憾了！只可惜现在时间不够了，本大爷得去找个地方，排练一下今晚的表演。"
        },
        {
          "role": "荒泷一斗",
          "text": "矮堇瓜，歌词和曲谱就在那边的乐曲排练区，晚上可别临阵脱逃！"
        },
        {
          "role": "派蒙",
          "text": "少嚣张了，放牛的，让我们看看谁才是最摇滚的那个！"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈哈！那我们就今晚见了！"
        },
        {
          "role": "派蒙",
          "text": "等会我也要去乐曲排练区练习一下，我可不想输给一斗那家伙！"
        },
        {
          "role": "久岐忍",
          "text": "对了，旅行者，这次我们送了不少邀请函，有一些朋友已经到了，刚才还打听了你，想去见见他们吗？"
        },
        {
          "role": "派蒙",
          "text": "哇哦！是荒泷派请来的大家吗？不知道都有谁呢，我们这会先去找找他们吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（久岐忍）"
        },
        {
          "role": "久岐忍",
          "text": "旅行者，要去见见朋友们吗？"
        },
        {
          "type": "subtitle",
          "text": "见一见参加盛会的朋友们"
        },
        {
          "role": "珊瑚宫心海",
          "text": "这位希娜小姐…好像有几分眼熟…服饰也…"
        },
        {
          "role": "五郎",
          "text": "珊瑚宫大人，我也有这样的感觉…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "她看起来简直就像…"
        },
        {
          "role": "五郎",
          "text": "就像…？"
        },
        {
          "role": "派蒙",
          "text": "五郎！心海！好久不见！"
        },
        {
          "role": "五郎",
          "text": "好久不见，旅行者和派蒙！"
        },
        {
          "role": "珊瑚宫心海",
          "text": "见到你们真高兴。我们刚才还去了阿忍小姐那边找你们，呵呵。"
        },
        {
          "role": "派蒙",
          "text": "没想到你们也来参加荒泷派的音乐节呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听说是五郎安排的场地。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "五郎",
          "text": "这不算什么。"
        },
        {
          "role": "五郎",
          "text": "前些天我在《闲事月刊》收到了这样的咨询，就想着不如帮帮忙，原来是那位荒泷一斗阁下。"
        },
        {
          "role": "五郎",
          "text": "况且，珊瑚宫大人也很支持这件事。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "嗯…来自异国的摇滚音乐节，应该能吸引不少游客前来观光吧，况且，关于生命的主题也颇有意义。"
        },
        {
          "role": "派蒙",
          "text": "说到主题，据说是跟一只战场中的小狗有关呢，可惜那个好像只是个传言，你们听过…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "略有耳闻…但也不清楚内情呢。"
        },
        {
          "role": "五郎",
          "text": "唔…我也一样。"
        },
        {
          "role": "派蒙",
          "text": "回答得太快了吧！"
        },
        {
          "role": "珊瑚宫心海",
          "text": "呵呵，是因为荒泷一斗阁下早就前来打听过了。其实我们也很想帮忙。"
        },
        {
          "role": "五郎",
          "text": "没错，没错…啊，那个，其实我也有事想请教你们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么事？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "五郎",
          "text": "你们有没有觉得，这位希娜小姐的容貌很眼熟呢，我总觉得在哪里见过…"
        },
        {
          "role": "派蒙",
          "text": "呃…这个…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "似曾相识…但…",
              "dialogues": [
                {
                  "role": "五郎",
                  "text": "但想不起来了吗？"
                }
              ]
            },
            {
              "text": "没有，完全没见过这样的人。",
              "dialogues": [
                {
                  "role": "五郎",
                  "text": "难道是我的错觉…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哎呀，就是长得跟谁比较像嘛！旅行者和他妹妹/她哥哥不也很像吗？这点事一点也不奇怪，你不要多想了。"
        },
        {
          "role": "五郎",
          "text": "原来如此…这样说也有道理…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们还是先溜吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（珊瑚宫心海&五郎）"
        },
        {
          "role": "五郎",
          "text": "到底像谁呢…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "呵呵…"
        },
        {
          "role": "托马",
          "text": "真厉害啊，宵宫小姐。居然把烟花送到了这么远的地方。"
        },
        {
          "role": "宵宫",
          "text": "因为之前答应过一斗，要给他们的祭典准备烟花，可不能食言呀。"
        },
        {
          "role": "派蒙",
          "text": "嘿！托马！宵宫~"
        },
        {
          "role": "宵宫",
          "text": "旅行者，派蒙，你们也来了！太好了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好久不见！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "托马",
          "text": "哈哈，这下真要好好感谢荒泷派了，要不是他们办的这个活动，还不知道什么时候能跟旅行者再见。"
        },
        {
          "role": "宵宫",
          "text": "听出来了吗，托马先生在埋怨你们呢，都不回来见见老朋友。"
        },
        {
          "role": "托马",
          "text": "说得没错，虽然旅途很重要，但是累了要记得回来休息，有我们负责接风洗尘。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢托马，还有宵宫。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宵宫",
          "text": "跟我们客气什么啦。对了，我要跟你们分享一件好玩的事。"
        },
        {
          "role": "宵宫",
          "text": "听一斗说，这次音乐节的主题，来自于一只在战场上救助小动物的狗。好神奇啊！"
        },
        {
          "role": "宵宫",
          "text": "消息灵通的托马先生知道这件事吗？"
        },
        {
          "role": "托马",
          "text": "可真是难倒我了，看来我的朋友里面还少了一只关键的狗啊，哈哈。"
        },
        {
          "role": "托马",
          "text": "不过如果说真有这么一件事，我觉得跟海祇岛有关。"
        },
        {
          "role": "托马",
          "text": "因为不管那家伙身手多好，要想不留痕迹、神出鬼没地出入战场，得有人帮忙掩盖行踪才行吧。"
        },
        {
          "role": "托马",
          "text": "据我所知，幕府军中不存在这种事。"
        },
        {
          "role": "派蒙",
          "text": "所以那其实是一只珊瑚宫军的狗，专门负责在战场救助小动物？"
        },
        {
          "role": "宵宫",
          "text": "有点奇怪…在打仗的时候专门派一只狗去救小动物…珊瑚宫军真的有这份精力吗？"
        },
        {
          "role": "派蒙",
          "text": "哦，那就不是珊瑚宫军这边的，那就还是幕府军那边的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "幕府军也没这精力吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "托马",
          "text": "所以依我看，更大的可能，这是德沃沙克先生编出来的故事，为了表达某种东西。"
        },
        {
          "role": "托马",
          "text": "毕竟他是个摇滚艺术家，就是负责用摇滚来表达我们不懂的东西吧？"
        },
        {
          "role": "宵宫",
          "text": "是不是就像看烟花一样，不用问，只要去感受就好了？"
        },
        {
          "role": "派蒙",
          "text": "唔…我好像又能理解了。果然宵宫也是艺术家，烟花艺术家。"
        },
        {
          "role": "宵宫",
          "text": "嘿嘿，那今晚可不要错过本艺术家的环节哦！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（托马&宵宫）"
        },
        {
          "role": "宵宫",
          "text": "看来托马先生对艺术也有一番见解呀。"
        },
        {
          "role": "托马",
          "text": "艺术吗？织毛衣算不算？"
        },
        {
          "role": "宵宫",
          "text": "当然算！织毛衣艺术家！"
        },
        {
          "role": "托马",
          "text": "但是感觉不怎么摇滚的样子，今天的场合就完全用不上啊。"
        },
        {
          "role": "宵宫",
          "text": "那不如…把摇滚两个字织在毛衣上，然后发给大家穿。"
        },
        {
          "role": "托马",
          "text": "欸？好主意！下次我试试。"
        },
        {
          "role": "鹿野院平藏",
          "text": "嘿嘿，旅行者，你来了。这几天有收到我寄过来的信吗？"
        },
        {
          "role": "派蒙",
          "text": "喔喔喔喔！难道平藏已经有眉目了吗？"
        },
        {
          "role": "鹿野院平藏",
          "text": "眉目是有一点，但还少了拼图的最后一块。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "平藏都知道了些什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹿野院平藏",
          "text": "眼下我还不能断言什么。不过我猜测，这个传言跟社奉行还有珊瑚宫双方都有关系。"
        },
        {
          "role": "派蒙",
          "text": "社奉行？！珊瑚宫？！在打仗的时候？！"
        },
        {
          "role": "鹿野院平藏",
          "text": "嘘——不要那么激动啦，还只是猜测。"
        },
        {
          "role": "鹿野院平藏",
          "text": "我已经写信回了所里，不用多久就能收到回复了，大和田与力应该能帮忙找到我需要的。"
        },
        {
          "role": "鹿野院平藏",
          "text": "所以也请你们耐心地等一等吧。"
        },
        {
          "role": "鹿野院平藏",
          "text": "要不是不想错过今晚一斗老兄上台献唱，我就自己回所里一趟了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "话说回来，今晚派蒙也会上台。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹿野院平藏",
          "text": "哇哦，居然这么有看点？我留下来真是太正确了。"
        },
        {
          "role": "鹿野院平藏",
          "text": "今晚神之嘴能否力压花见坂摇滚魔王晋级神之嗓呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是飞行摇滚艺术食品。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "鹿野院平藏",
          "text": "哈哈哈哈！我拭目以待！"
        },
        {
          "role": "派蒙",
          "text": "你们两个！不要又给我取什么奇怪的外号啊！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（鹿野院平藏）"
        },
        {
          "role": "鹿野院平藏",
          "text": "如果是九条裟罗大人收到了我的信，她不会故意不给我回信吧？"
        },
        {
          "type": "subtitle",
          "text": "前往乐曲排练区寻找德沃沙克"
        },
        {
          "role": "派蒙",
          "text": "哎呀，没想到居然来了这么多朋友，我得好好练习一下，不然今晚一定会丢人的。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们快去乐曲排练区吧。"
        },
        {
          "role": "派蒙",
          "text": "嘿！德沃沙克大叔！你果然还在这里呢。"
        },
        {
          "role": "德沃沙克",
          "text": "嗯，我在检查晚上要用的设备、曲谱和歌词。"
        },
        {
          "role": "德沃沙克",
          "text": "听阿忍小姐说，轻小说在稻妻很受欢迎，所以我修改了一下旋律和歌词，现在是更适合荒泷派和轻小说的版本。"
        },
        {
          "role": "派蒙",
          "text": "摇滚乐加轻小说…轻摇滚乐！"
        },
        {
          "role": "德沃沙克",
          "text": "哈哈，倒也没那么大变化，只是删掉了那只狗的戏份，把它换成了一斗兄喜欢的鬼兜虫。"
        },
        {
          "role": "德沃沙克",
          "text": "毕竟能办成这次活动，一斗兄功不可没，这就算对他的感谢吧。"
        },
        {
          "role": "派蒙",
          "text": "欸？删掉了狗的戏份？可那不是这次音乐节的…的…动机吗？"
        },
        {
          "role": "德沃沙克",
          "text": "就因为只是一个动机而已。如果把它换成鬼兜虫，或你或我或别的什么，它的精神也存在着。"
        },
        {
          "role": "派蒙",
          "text": "精神？什么精神？"
        },
        {
          "role": "德沃沙克",
          "text": "唔…摇滚精神？"
        },
        {
          "role": "派蒙",
          "text": "说了等于没说嘛…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是不是关注那只狗的人太多了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "德沃沙克",
          "text": "呵呵，朋友们，我们只要好好感受音乐就好。"
        },
        {
          "role": "派蒙",
          "text": "好吧…德沃沙克大叔，那你能不能让我先感受一下…"
        },
        {
          "role": "派蒙",
          "text": "因为我也要准备准备，晚上可不能让那个放牛的一个人出风头！"
        },
        {
          "role": "德沃沙克",
          "text": "当然没问题，看来派蒙小姐也决定要上台了啊。"
        },
        {
          "role": "德沃沙克",
          "text": "请收好曲谱和歌词吧。这下真是令人期待。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，让我看看，歌名是…"
        },
        {
          "role": "派蒙",
          "text": "转生成为鬼兜虫…然后撞翻世界…"
        },
        {
          "role": "派蒙",
          "text": "呜哇！这是什么奇怪的歌名，这就是摇滚？"
        },
        {
          "role": "德沃沙克",
          "text": "是轻摇滚。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我也想看看。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "旅行者，你先不要看嘛，就好好等着吧，让我晚上唱给你听！"
        },
        {
          "role": "派蒙",
          "text": "我一定比那个放牛的更摇滚！"
        },
        {
          "type": "subtitle",
          "text": "时间流逝…夜幕降临…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "音乐爱好者们纷纷上台，献出自己拿手的乐曲。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "人群涌动，越来越热的氛围中，不时有声声欢呼。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "很快，最后的时刻到来了。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "观赏最后的演出…"
        },
        {
          "role": "德沃沙克",
          "text": "亲爱的女士们，先生们！"
        },
        {
          "role": "德沃沙克",
          "text": "今夜是欢庆的夜晚，没有人应该感到悲伤——"
        },
        {
          "role": "德沃沙克",
          "text": "站在不歇的摇滚夜之尾上，我谨以最崇高的敬意，邀请今晚最后两位嘉宾——"
        },
        {
          "role": "德沃沙克",
          "text": "荒泷一斗阁下！"
        },
        {
          "role": "德沃沙克",
          "text": "派蒙小姐！"
        },
        {
          "role": "德沃沙克",
          "text": "两位将为我们带来本次庆典最后的主题歌曲——"
        },
        {
          "role": "德沃沙克",
          "text": "《转生成为鬼兜虫然后撞翻世界》！"
        },
        {
          "role": "德沃沙克",
          "text": "有请！！！"
        },
        {
          "type": "subtitle",
          "text": "过场动画（[https://www.bilibili.com/video/BV1Pm421g7rG 「荒泷生命摇滚堇瓜飞行大合唱」]）"
        },
        {
          "role": "荒泷一斗",
          "text": "黑鸦 羽箭没入双翅下"
        },
        {
          "role": "荒泷一斗",
          "text": "妖狸熄灭的火炬 是最后的变化"
        },
        {
          "role": "派蒙",
          "text": "鼬鼬我呀 遗产足足五百摩拉"
        },
        {
          "role": "派蒙",
          "text": "喔喔~两百留给老爸"
        },
        {
          "role": "派蒙",
          "text": "剩…"
        },
        {
          "role": "荒泷一斗",
          "text": "剩下三百给老妈"
        },
        {
          "role": "荒泷一斗",
          "text": "三只将军蟹 数一数十根爪"
        },
        {
          "role": "派蒙",
          "text": "一群陆鳗鳗"
        },
        {
          "role": "派蒙",
          "text": "沉睡在生锈老家"
        },
        {
          "role": "荒泷一斗",
          "text": "所以赶快转生成为鬼兜虫吧"
        },
        {
          "role": "派蒙",
          "text": "使出勇敢利角冲刺"
        },
        {
          "role": "荒泷一斗",
          "text": "要在世界的丑脸上扎出朵"
        },
        {
          "role": "荒泷一斗&派蒙",
          "text": "羞红的花~"
        },
        {
          "type": "subtitle",
          "text": "不歇的摇滚夜之尾…"
        },
        {
          "type": "subtitle",
          "text": "庆典在热闹的氛围中结束了，观众三三两两地散场…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "但你和朋友们来到了台侧，准备迎接两位耀眼的摇滚艺术家…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "宵宫",
          "text": "原来这就是摇滚乐呀，跟我想象的还不太一样呢。"
        },
        {
          "role": "托马",
          "text": "跟我以前听过的也不一样…可能是一种新奇的摇滚类型吧。"
        },
        {
          "role": "荒泷一斗",
          "text": "怎么样？本大爷的表演还可以吗？矮堇瓜应该已经完全被比下去了吧？哈哈哈哈哈！"
        },
        {
          "role": "派蒙",
          "text": "少臭屁了，放牛的，明明你才是惨败的那个！"
        },
        {
          "role": "宵宫",
          "text": "别争啦，我觉得你们两个都很厉害啊！"
        },
        {
          "role": "托马",
          "text": "没错，简直让我们大开眼界！"
        },
        {
          "role": "久岐忍",
          "text": "可以称为旗鼓相当的对手。"
        },
        {
          "role": "荒泷一斗",
          "text": "真的吗？挚友你觉得呢？你觉得刚才我们谁更摇滚？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我觉得是一斗。",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "哈哈哈哈哈哈！不愧是我的挚友——花见坂摇滚天王，前来觐见！"
                },
                {
                  "role": "派蒙",
                  "text": "呜哇！旅行者，我生气了，决定不理你一分钟！"
                }
              ]
            },
            {
              "text": "我觉得是派蒙。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哼哼，旅行者可是会永远站在我这边哦，小小放牛的，可笑可笑！"
                },
                {
                  "role": "荒泷一斗",
                  "text": "哈？矮堇瓜，旅行者是怕你伤心，才故意这样说的，本大爷不会跟你一般见识！"
                }
              ]
            },
            {
              "text": "你们都很摇滚。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…真的吗？真的是这么想的吗？"
                },
                {
                  "role": "荒泷一斗",
                  "text": "好！本大爷相信，挚友永远不会骗人，所以本大爷承认了…"
                },
                {
                  "role": "荒泷一斗",
                  "text": "矮堇瓜…你，够摇滚！"
                }
              ]
            },
            {
              "text": "天气真不错啊，哈哈。",
              "dialogues": [
                {
                  "role": "荒泷一斗",
                  "text": "不要这么随便转移话题啊！"
                }
              ]
            }
          ]
        },
        {
          "role": "德沃沙克",
          "text": "哈哈，大家就别再争论这些了。无论是一斗兄还是派蒙小姐的演唱，都让我十分感动…"
        },
        {
          "role": "德沃沙克",
          "text": "没有大家的帮助，就没有这场音乐节，我都不知道要如何感谢。"
        },
        {
          "role": "荒泷一斗",
          "text": "沙克兄！说这种话真是太见外了。要不是遇见了你，我都还不知道什么是摇滚精神！"
        },
        {
          "role": "宵宫",
          "text": "摇滚精神…那是什么？摇滚乐也有精神吗？"
        },
        {
          "role": "荒泷一斗",
          "text": "是摇摇晃晃往前滚的精神！就像我们荒泷派一样！"
        },
        {
          "role": "派蒙",
          "text": "才不是呢，德沃沙克大叔，快用标准答案批评一下这个自以为是的家伙。"
        },
        {
          "role": "德沃沙克",
          "text": "呵呵，标准答案吗？可摇滚是一种感受，我们感受的都是自己的故事。"
        },
        {
          "role": "托马",
          "text": "难怪…我刚才就觉得，摇滚精神就像歌里的那只鬼兜虫，遇到什么困难都不会害怕，勇往直前地冲刺。"
        },
        {
          "role": "托马",
          "text": "看来不是我的感受能力太差，哈哈。"
        },
        {
          "role": "派蒙",
          "text": "那宵宫呢？"
        },
        {
          "role": "宵宫",
          "text": "我啊…因为我一直以为会在歌词里听到那只狗的故事嘛，最后却没有…"
        },
        {
          "role": "宵宫",
          "text": "我就在想，这是不是一种寓意？如果没有那只狗，也许就没有受伤的小动物…"
        },
        {
          "role": "宵宫",
          "text": "没有受伤的小动物，就说明没有战争，没有战争，就说明世界和平…"
        },
        {
          "role": "派蒙",
          "text": "噢！原来宵宫的摇滚精神是世界和平！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那阿忍呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "久岐忍",
          "text": "我吗？我倒没想那么多，我主要在担心，老大这次把小纸条丢进了天守阁。不知道会不会被天领奉行找麻烦？"
        },
        {
          "role": "托马",
          "text": "哈哈！这样看，忍小姐的摇滚精神是保护荒泷派。"
        },
        {
          "role": "荒泷一斗",
          "text": "阿忍，不用担心那种小事，要是那个雷电将军看见了小纸条，一定也会来参加我们的庆典的！"
        },
        {
          "role": "派蒙",
          "text": "我也觉得肯定没问题啦，不然平藏现在就该把一斗抓起来了！"
        },
        {
          "role": "派蒙",
          "text": "咦？对了，平藏去哪了？还有心海和五郎好像也不见了…"
        },
        {
          "role": "久岐忍",
          "text": "噢，刚刚鹿野院同心说所里有急事，所以没来得及跟你们告别，不过他留了一个东西给你们，就在那边。"
        },
        {
          "role": "久岐忍",
          "text": "至于另外两位，说是今晚还有政务会议，也先行离开了，托我转告你们一声。"
        },
        {
          "role": "德沃沙克",
          "text": "这几位行程如此匆忙，都赶来参加了庆典，看来一斗兄所言非虚，荒泷派确实是在本地小有实力的组织。"
        },
        {
          "role": "德沃沙克",
          "text": "一斗兄，能和你合作，我感到十分荣幸。"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈哈！沙克兄，记功劳的时候，可别忘了旅行者！"
        },
        {
          "role": "荒泷一斗",
          "text": "不少朋友都是冲着他来的，所以如果有下次，一定要想办法把他请上台。"
        },
        {
          "role": "荒泷一斗",
          "text": "怎么样？挚友，下次也让我们看看你的摇滚精神吧！"
        },
        {
          "role": "五郎",
          "text": "珊瑚宫大人，那位天领奉行的侦探似乎…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "五郎，不用太在意，「小狗商会」是我们与社奉行共同的计划。能避人自然更好，但终究不是目的。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "至少在当时成功救下了一些人，这就足够了。"
        },
        {
          "role": "五郎",
          "text": "我更担心的是珊瑚宫大人的声望…毕竟那时，救下的伤者里也有幕府方的人…"
        },
        {
          "role": "五郎",
          "text": "如果有心人以此做文章…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "别担心，也许这是一个契机。"
        },
        {
          "role": "五郎",
          "text": "契机？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "如今我们与鸣神岛都走在共处的路上。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "如果人们知道了战时，我们与社奉行所做的努力，也未必是件坏事。"
        },
        {
          "role": "五郎",
          "text": "原来如此…"
        },
        {
          "role": "珊瑚宫心海",
          "text": "五郎，依我看，与其担心这个，不如多担心一下希娜小姐吧。"
        },
        {
          "role": "五郎",
          "text": "欸？希娜小姐？"
        },
        {
          "role": "珊瑚宫心海",
          "text": "听说希娜小姐也在《闲事月刊》供职，人气颇高，容貌青春靓丽。"
        },
        {
          "role": "珊瑚宫心海",
          "text": "在安抚人心方面的天赋，好像也不逊于你。所以说，是你的劲敌哦。"
        },
        {
          "role": "五郎",
          "text": "咳咳…珊瑚宫大人，我明白了，我会努力的！"
        },
        {
          "role": "八重神子",
          "text": "哎呀，我今天才知道，水之国度的摇滚乐，居然能引动雷光。"
        },
        {
          "role": "影",
          "text": "神子，前几日，有奇怪的纸条飞入天守阁，要求我交出一只狗…所以我来看看所为何事。"
        },
        {
          "role": "八重神子",
          "text": "哈哈，我还以为你有了养宠物的爱好。"
        },
        {
          "role": "影",
          "text": "另外，裟罗也交予了我一封邀请函。"
        },
        {
          "role": "影",
          "text": "虽然不曾听闻荒泷之名…但既是臣民之愿，我也当许以回应吧。"
        },
        {
          "role": "八重神子",
          "text": "呵呵，回应那鬼族的小家伙么…"
        },
        {
          "role": "八重神子",
          "text": "那这位枫丹的音乐家该如何回应才好呀？他的音乐，似乎是在谈论战争呢…"
        },
        {
          "role": "影",
          "text": "战争…"
        },
        {
          "role": "影",
          "text": "或许我的答案也不能完美…"
        },
        {
          "role": "影",
          "text": "但我知道，战争不应再起，世人也不应再受其苦。"
        },
        {
          "role": "八重神子",
          "text": "嗯…"
        },
        {
          "role": "八重神子",
          "text": "可若那更大的战争要来呢？"
        },
        {
          "role": "影",
          "text": "若一定要来…"
        },
        {
          "role": "影",
          "text": "…便以此身，前去应战吧。"
        },
        {
          "role": "八重神子",
          "text": "哎呀，要是真到了那一天…"
        },
        {
          "role": "八重神子",
          "text": "今晚的人们，应该都会站在你身边吧。"
        },
        {
          "type": "subtitle",
          "text": "鹿野院平藏的留言"
        },
        {
          "type": "subtitle",
          "text": "哎呀呀，真抱歉。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "收到了所里的消息，有新案子要我立刻处理，只好先走一步啦。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "之前你关心的狗的事，我已拿到证据。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "但大和田与力叮嘱我不可以跟无关人士透露，所以…真不好意思啦！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "但是的但是，很不巧，我又不小心把东西丢了，是那个「小狗商会」的一份收治明细。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "我想应该就在附近吧？能拜托你找找吗？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "找到了的话，确认看看是不是那份证据，然后找个时间再还我吧，万分感谢！",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "「小狗商会」的收治明细"
        },
        {
          "type": "subtitle",
          "text": "…今日收治宠物…",
          "narration": true
        },
        {
          "role": "十一号盗宝鼬",
          "text": "大郎，6岁。"
        },
        {
          "type": "subtitle",
          "text": "…今日收治宠物…",
          "narration": true
        },
        {
          "role": "十二号盗宝鼬",
          "text": "长次，8岁。"
        },
        {
          "type": "subtitle",
          "text": "…今日收治宠物…",
          "narration": true
        },
        {
          "role": "八号陆鳗鳗",
          "text": "康奎尔，35岁。"
        },
        {
          "type": "subtitle",
          "text": "…今日收治宠物…",
          "narration": true
        },
        {
          "role": "三号将军蟹",
          "text": "小春，25岁。"
        },
        {
          "type": "subtitle",
          "text": "…今日收治宠物…",
          "narration": true
        },
        {
          "role": "五号妖狸",
          "text": "久住，60岁。"
        },
        {
          "type": "subtitle",
          "text": "…今日收治宠物…",
          "narration": true
        },
        {
          "role": "九号陆鳗鳗",
          "text": "德沃沙克，40岁。"
        },
        {
          "type": "subtitle",
          "text": "上月份宠物均已妥善救助，多数安置于离岛。个别特殊情况者，通过专门途径送往外国。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "额外对话（朗清）"
        },
        {
          "role": "朗清",
          "text": "嘿！旅行者，最后那演出可真不错啊，你看了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我觉得还差点意思。",
              "dialogues": [
                {
                  "role": "朗清",
                  "text": "嗯，这也正常，毕竟就连《摩拉的制作办法》这种书也有人不喜欢。"
                },
                {
                  "role": "朗清",
                  "text": "所以只要选择看自己喜欢的书，听自己喜欢的音乐就可以了。"
                }
              ]
            },
            {
              "text": "我也觉得不错。",
              "dialogues": [
                {
                  "role": "朗清",
                  "text": "是吧？原来还有这样的摇滚乐，跟我和芳芳在枫丹听到的都不一样呢。我打算回去之后搜集搜集相关的书籍。"
                },
                {
                  "role": "朗清",
                  "text": "以后有空多来我们万文集舍做客啊。"
                }
              ]
            },
            {
              "text": "我觉得特别好。",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "初次"
                },
                {
                  "role": "朗清",
                  "text": "你这么喜欢吗？那我有个东西一定要送你，哈哈。"
                },
                {
                  "role": "朗清",
                  "text": "之前带来的文创品发完了，没给你留一份，我都不好意思呢，这回可算找到机会了。"
                },
                {
                  "role": "朗清",
                  "text": "那位背吉他的枫丹音乐家，他同意我把最后的歌词收录下来，当作音乐周边售卖。"
                },
                {
                  "role": "朗清",
                  "text": "就是这个，请收下吧。虽然不值钱，但你喜欢的话，至少能当一个纪念。"
                },
                {
                  "type": "subtitle",
                  "text": "再次"
                },
                {
                  "role": "朗清",
                  "text": "看得出来，不然你也不会特意来跟我又说一遍。哈哈。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（德沃沙克）"
        },
        {
          "role": "德沃沙克",
          "text": "你好啊，旅行者，多亏了你们，庆典才能圆满完成。不过我还会在这里待一段时间，欣赏一下美景。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还想再试试演奏曲目。",
              "dialogues": [
                {
                  "role": "德沃沙克",
                  "text": "当然没问题，请。"
                }
              ]
            },
            {
              "text": "稍后再来。",
              "dialogues": [
                {
                  "role": "德沃沙克",
                  "text": "没问题，我还会在这里待一段时间，随时都可以过来。"
                }
              ]
            }
          ]
        }
      ],
