{
  "quest_id": 76182,
  "chapter_num": null,
  "chapter_title": "花园小聚",
  "type": "wq",
  "route": "A Garden Gathering",
  "stories": [
    {
      "story_id": 76182,
      "title": "花园小聚",
      "description": "前往隐居处放置茶桌并使用桑多涅落座后，与哥伦比娅共度茶会时光吧…",
      "dialogues": [
        {
          "role": "「少女」",
          "text": "这就是你曾经生活的地方吗？真漂亮。"
        },
        {
          "role": "「木偶」",
          "text": "以前更漂亮。我打理花园可是很有一手的。"
        },
        {
          "role": "「少女」",
          "text": "哈哈。"
        },
        {
          "role": "「木偶」",
          "text": "你又傻笑什么…"
        },
        {
          "role": "「少女」",
          "text": "想象了一下那时的桑多涅蹲在花丛边的样子，觉得很可爱。"
        },
        {
          "role": "「少女」",
          "text": "我等下可以进屋看看吗？"
        },
        {
          "role": "「木偶」",
          "text": "当然，我已经把灰尘都清理过一遍了。"
        },
        {
          "role": "「少女」",
          "text": "你今后打算怎么处理这个家？"
        },
        {
          "role": "「木偶」",
          "text": "嗯…果然还是想留下它。有时间就回来打理一下吧。"
        },
        {
          "role": "「少女」",
          "text": "没时间的话，我也可以来帮你打理。"
        },
        {
          "role": "「少女」",
          "text": "这里和曾经你房间给我的感觉一样，令人安心。我很喜欢。"
        },
        {
          "role": "「木偶」",
          "text": "哼…随你便吧。"
        },
        {
          "role": "「少女」",
          "text": "…这里真美。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "「少女」",
          "text": "嗯。我们以后再来吧。"
        }
      ]
    }
  ]
}