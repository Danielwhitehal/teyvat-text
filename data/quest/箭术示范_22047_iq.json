{
  "quest_id": 22047,
  "chapter_num": null,
  "chapter_title": "箭术示范",
  "type": "iq",
  "route": "Archery Demonstration",
  "stories": [
    {
      "story_id": 22047,
      "title": "箭术示范",
      "description": "海祇岛的正二似乎正在因为自己的射箭技艺不够好而烦恼…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与正二对话"
        },
        {
          "role": "正二",
          "text": "又没射中…到底是哪里出了问题…"
        },
        {
          "role": "旅行者",
          "text": "你还在练习射箭吗？"
        },
        {
          "role": "正二",
          "text": "您是上次的…多谢您上次为我做射箭的示范！"
        },
        {
          "role": "正二",
          "text": "多亏了您，我已经…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能百发百中了？",
              "dialogues": []
            },
            {
              "text": "能百步穿靶了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "正二",
          "text": "呃，倒也没有到这种地步…"
        },
        {
          "role": "正二",
          "text": "不过，现在我射出的十支箭里，已经有五支能上靶了…这都是多亏了您的示范。"
        },
        {
          "role": "正二",
          "text": "虽然离教官的要求还有一段距离，但我还是会继续努力的。"
        },
        {
          "role": "正二",
          "text": "对了，既然您在这里，能再为我做做示范吗？"
        },
        {
          "role": "正二",
          "text": "有了您的示范，我一定能进步得更快。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "正二",
                  "text": "谢谢您，我一定会认真学习的！"
                },
                {
                  "role": "正二",
                  "text": "示范的事情就拜托您了，我一定会认真学习的。"
                }
              ]
            },
            {
              "text": "上次的问题都解决了吗？",
              "dialogues": [
                {
                  "role": "正二",
                  "text": "您是说…姿势不标准、力气不够大、握弓的手不够稳…那些问题吗？"
                },
                {
                  "role": "正二",
                  "text": "老实说，我还在一步步地解决它们呢。"
                },
                {
                  "role": "正二",
                  "text": "不过除了这些问题之外，我更担心的是…如果真的上了战场，我还能把学习到的技艺发挥出来吗…"
                },
                {
                  "role": "正二",
                  "text": "咳，但在烦恼这些问题之前，我还是得先锻炼好我的武艺才行。"
                },
                {
                  "role": "正二",
                  "text": "示范的事情就拜托您了，我一定会认真学习的。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "为正二做射箭示范"
        },
        {
          "type": "subtitle",
          "text": "找正二重新布置标靶"
        },
        {
          "role": "正二",
          "text": "怎么了，您刚才射箭的时候，好像出了点失误…"
        },
        {
          "role": "旅行者",
          "text": "能重新布置一下标靶吗？"
        },
        {
          "role": "正二",
          "text": "没问题，我这就去布置标靶，等会您直接过去就好。"
        },
        {
          "type": "subtitle",
          "text": "与正二对话"
        },
        {
          "role": "正二",
          "text": "您的射箭技艺，还是和之前一样精湛。"
        },
        {
          "role": "旅行者",
          "text": "看清楚了吗？"
        },
        {
          "role": "正二",
          "text": "是的，无论是您握弓的姿势，还是您拉弓的方法…我都认真看清楚了！"
        },
        {
          "role": "正二",
          "text": "但是，怎么说呢…越是看您的示范，越是能感觉到我和您之间的差距，唉…"
        },
        {
          "role": "正二",
          "text": "先、先不说这些了，这些东西请您收下，多谢您愿意为我做示范。"
        },
        {
          "role": "正二",
          "text": "我等会就回去自己接着训练了，下次的目标，就定在…十支箭里上靶七箭吧…"
        }
      ]
    }
  ]
}