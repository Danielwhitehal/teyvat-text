  "stories": [
    {
      "story_id": 20054,
      "title": "无人注意的盖伊",
      "description": "盖伊先生正在忧郁着…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与盖伊对话"
        },
        {
          "role": "盖伊",
          "text": "唉，天天守门，哪里有什么工作细节能写…"
        },
        {
          "role": "盖伊",
          "text": "不，不如说是连工作内容都没有啊…"
        },
        {
          "role": "旅行者",
          "text": "你怎么了？"
        },
        {
          "role": "盖伊",
          "text": "哦，这个啊…是我老爹的事，他叫特纳，在晨曦酒庄工作。我当了西风骑士之后，他一直很高兴，来信也尽是问我工作情况啦什么的…"
        },
        {
          "role": "盖伊",
          "text": "但我就在这守门啊！还守的是个压根没多少人走的侧门。"
        },
        {
          "role": "盖伊",
          "text": "老爹还一直盼着我成就个什么伟业…守个门怎么能成就伟业嘛。"
        },
        {
          "role": "盖伊",
          "text": "但是他身子一直不好，要是知道我在这守门，说不定就气出个好歹来，所以我在信里说，我一直随着骑士团的精锐在野外战斗…"
        },
        {
          "role": "盖伊",
          "text": "但是一个劲地写信，一点证据没有，老爹肯定要疑心。"
        },
        {
          "role": "盖伊",
          "text": "你是准备出去冒险吧，能帮我去找点战利品吗？给我的信增添一点可信度…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "盖伊",
                  "text": "太感谢了。"
                }
              ]
            },
            {
              "text": "你不如自己去…",
              "dialogues": [
                {
                  "role": "盖伊",
                  "text": "虽然守门没什么前途，但是这也是骑士团分配给我的工作。"
                },
                {
                  "role": "盖伊",
                  "text": "我可不敢擅离职守…要是丢了这份工作，老爹非气昏过去不可…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "收集1个「牢固的箭簇」"
        },
        {
          "type": "subtitle",
          "text": "收集1个「破损的面具」"
        },
        {
          "type": "subtitle",
          "text": "收集1个「史莱姆凝液」"
        },
        {
          "type": "subtitle",
          "text": "收集1个「导能绘卷」"
        },
        {
          "type": "subtitle",
          "text": "收集1个「沉重号角」"
        },
        {
          "type": "subtitle",
          "text": "将战利品和信交给特纳"
        },
        {
          "role": "特纳",
          "text": "你好，客人，欢迎来到晨曦酒庄…"
        },
        {
          "role": "旅行者",
          "text": "这是盖伊的信。"
        },
        {
          "role": "特纳",
          "text": "他写信给我了吗？谢谢，还麻烦你给我带来…"
        },
        {
          "role": "特纳",
          "text": "和骑士团的骑士们一起在野外清除丘丘人？"
        },
        {
          "role": "特纳",
          "text": "他才刚进去没多久，就已经开始在外出任务了吗？"
        },
        {
          "role": "旅行者",
          "text": "这是他的战利品。"
        },
        {
          "role": "派蒙",
          "text": "盖伊先生很厉害哦，一口气把那些丘丘人都消灭掉了！"
        },
        {
          "role": "派蒙",
          "text": "我们都是在旁边亲眼看到的！"
        },
        {
          "role": "特纳",
          "text": "哦…哦，是这样吗…还真是丘丘人的战利品…"
        },
        {
          "role": "特纳",
          "text": "哼，这些普普通通的东西嘛，老头子我年轻时也能轻易拿到…"
        },
        {
          "role": "特纳",
          "text": "不过，那小子也算是在努力吧！"
        },
        {
          "role": "特纳",
          "text": "客人，实在是麻烦您了，您要不在这休息一下？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用了。",
              "dialogues": [
                {
                  "role": "特纳",
                  "text": "好，您急着回去对吧，就不耽误您了。"
                }
              ]
            },
            {
              "text": "您要给他回信吗？",
              "dialogues": [
                {
                  "role": "特纳",
                  "text": "不用了，哼…他还要继续努力才行。"
                }
              ]
