{
  "quest_id": 41340,
  "chapter_num": null,
  "chapter_title": "佳节里的小问题",
  "type": "wq",
  "route": "A Very Festive Problem",
  "stories": [
    {
      "story_id": 41340,
      "title": "佳节里的小问题",
      "description": "",
      "dialogues": [
        {
          "role": "志华",
          "text": "哎哟，我得再歇一会…"
        },
        {
          "role": "阿桂",
          "text": "不好意思，过节还要麻烦你，每年海灯节「不卜庐」的患者都会变多，实在是有点忙不过来。"
        },
        {
          "role": "旅行者",
          "text": "为什么会这样…"
        },
        {
          "role": "阿桂",
          "text": "海灯节的时候，大家都会放下工作陪伴家人，自然也少不了各种饭宴，香醇美酒，鸡鸭鱼肉…"
        },
        {
          "role": "阿桂",
          "text": "这样一来，难免消化不良，或者闹出这样那样的病症…"
        },
        {
          "role": "阿桂",
          "text": "虽然我总是劝人「切忌暴饮暴食」，但逢上了佳节良宵，这种劝告实在是没什么效用。"
        },
        {
          "role": "阿桂",
          "text": "刚刚又有几家人联系我，让我去送治消化不良和胃病的药。可「不卜庐」的事也不能放下…"
        },
        {
          "role": "阿桂",
          "text": "旅行者，如果你愿意的话，能帮忙去送几份药吗？"
        },
        {
          "role": "阿桂",
          "text": "所以送药的事就只能拜托你帮忙了，旅行者。"
        },
        {
          "role": "旅行者",
          "text": "我明白了。"
        },
        {
          "role": "阿桂",
          "text": "谢谢你，这里是药，麻烦你们尽快送到观海和志华的手上吧。"
        },
        {
          "role": "志华",
          "text": "是不是吃了什么不干净的东西…"
        },
        {
          "role": "旅行者",
          "text": "关于阿桂的药…"
        },
        {
          "role": "志华",
          "text": "哦！谢谢，这个就是我找阿桂开的胃药吧？我确实有些消化不良…这肚子难受得紧…"
        },
        {
          "role": "志华",
          "text": "我其实就在市集里逛了一会，吃了一会，一不小心就吃多了…"
        },
        {
          "role": "旅行者",
          "text": "你都吃了些什么…"
        },
        {
          "role": "志华",
          "text": "唔…炒饭，鱼生，水果，好多好多虾，对了，还有很好喝的酒！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "难怪会有胃病…",
            "就算是过节也不能太放纵。"
          ]
        },
        {
          "role": "旅行者",
          "text": "难怪会有胃病…"
        },
        {
          "role": "志华",
          "text": "所以才需要吃药嘛。但是你想，要是过节都不能想吃什么就吃什么，日子过得是不是就太没意思了？"
        },
        {
          "role": "志华",
          "text": "总之，谢谢你们的药，我也趁这个机会，稍微歇一会儿吧。"
        },
        {
          "role": "观海",
          "text": "唔唔，哎哟…真难受…你、你有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于阿桂的药…"
        },
        {
          "role": "观海",
          "text": "哦哦，谢谢你们！是我订的…来得真及时。"
        },
        {
          "role": "观海",
          "text": "哎呀，有药吃就好多了，我估计我是晚上吹海风引了风寒…"
        },
        {
          "role": "旅行者",
          "text": "不是消化不良吗…"
        },
        {
          "role": "观海",
          "text": "怎么可能？我的肠胃好得很，给你讲，我之前一顿饭能吃下三条烤鱼呢。"
        },
        {
          "role": "观海",
          "text": "就算是现在，吃饭喝酒的时候，周围的朋友也没有谁是我的对手。"
        },
        {
          "role": "观海",
          "text": "好了，不说了，我赶快吃药，接下来还有一场酒局呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "总之要保重身体。",
            "身体垮掉再想修养就晚了。"
          ]
        },
        {
          "role": "旅行者",
          "text": "总之要保重身体。"
        },
        {
          "role": "观海",
          "text": "哈哈哈，没关系啦，又不是老头子。"
        },
        {
          "role": "观海",
          "text": "不过谢谢你的好意，我会注意的。"
        },
        {
          "role": "阿桂",
          "text": "你来了，霄灯已经做好了吗？"
        },
        {
          "role": "旅行者",
          "text": "这是霄灯。"
        },
        {
          "role": "阿桂",
          "text": "辛苦你了。"
        },
        {
          "role": "阿桂",
          "text": "辛苦你们了，药应该都送到了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "感觉他们还会接着犯病…",
            "感觉只能治一时…"
          ]
        },
        {
          "role": "旅行者",
          "text": "感觉他们还会接着犯病…"
        },
        {
          "role": "阿桂",
          "text": "没办法，如果不注意生活习惯，肠胃病很难根治，只有再次生病的时候再对症下药。"
        },
        {
          "role": "阿桂",
          "text": "不过这下子，我也终于可以喘口气了…"
        },
        {
          "role": "旅行者",
          "text": "关于霄灯…"
        },
        {
          "role": "阿桂",
          "text": "放霄灯？我们…一般不会放啦，放霄灯是为了许愿的，「不卜庐」能许什么愿呢？"
        },
        {
          "role": "阿桂",
          "text": "别的商家都希望生意兴隆，但治病救人的药庐总不能期待这种事吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "阿桂先生是善良的人。",
            "阿桂先生很诚实啊。"
          ]
        },
        {
          "role": "旅行者",
          "text": "阿桂先生是善良的人。"
        },
        {
          "role": "阿桂",
          "text": "不过就我个人来说，我还是想放盏灯的，毕竟过节嘛…"
        },
        {
          "role": "阿桂",
          "text": "但霄灯我做了几天了，因为太忙，现在也只开了个头。"
        },
        {
          "role": "阿桂",
          "text": "趁现在短暂的休息时间，我也只能多编两下，等到霄灯做好，海灯节怕是都结束了。"
        },
        {
          "role": "旅行者",
          "text": "我来帮忙。"
        },
        {
          "role": "阿桂",
          "text": "真、真的吗？那就谢谢你了，感激不尽！"
        },
        {
          "role": "阿桂",
          "text": "我的愿望，果然还是希望所有的璃月的居民，都能无病无灾。"
        },
        {
          "role": "旅行者",
          "text": "那「不卜庐」的生意…"
        },
        {
          "role": "阿桂",
          "text": "哈哈，所以说是我个人的愿望嘛。"
        },
        {
          "role": "阿桂",
          "text": "我愿意为人抓药，是因为我不想看到有人因为病痛而受折磨。"
        },
        {
          "role": "阿桂",
          "text": "老话说得好，「但愿世间人无病，何愁架上药生尘」。"
        },
        {
          "role": "阿桂",
          "text": "哈哈，而且只要大家都健健康康的，我也不会那么忙了，应该也是件好事…"
        },
        {
          "role": "阿桂",
          "text": "啊，糟了！我想起来，还有一家的药没有送到！"
        },
        {
          "role": "阿桂",
          "text": "抱歉，我要先走了！祝你们海灯节快乐！"
        },
        {
          "role": "旅行者",
          "text": "白术先生和七七呢？"
        },
        {
          "role": "阿桂",
          "text": "七七出去采药了，现在还没有回来，可能因为记性不好，又在哪里迷路了吧…"
        },
        {
          "role": "阿桂",
          "text": "至于白术先生，可能是在钻研医术，还是在做什么其他的事吧，总之也不是我应该过问的事。"
        },
        {
          "role": "旅行者",
          "text": "没有其他帮忙的人吗？"
        },
        {
          "role": "阿桂",
          "text": "这个…现在店里暂时没人有空…"
        },
        {
          "role": "阿桂",
          "text": "这霄灯又规整又结实，呵呵，我的手艺可比这差远了。"
        },
        {
          "role": "阿桂",
          "text": "那等到晚上，我们就去把这盏霄灯放起来吧，我知道一个不错的地方。"
        },
        {
          "role": "阿桂",
          "text": "放灯之前的这段时间，我要好好想想，究竟许什么愿望…"
        },
        {
          "role": "阿桂",
          "text": "嗯…还有多少家要送药的来着…"
        },
        {
          "role": "阿桂",
          "text": "你们来啦，愿望我已经写在霄灯上了。"
        },
        {
          "role": "阿桂",
          "text": "现在时候也正好…我们马上放飞霄灯吧。"
        },
        {
          "role": "阿桂",
          "text": "我的愿望，果然还是希望所有的璃月的居民，都能无病无灾。"
        },
        {
          "role": "旅行者",
          "text": "那「不卜庐」的生意…"
        },
        {
          "role": "阿桂",
          "text": "哈哈，所以说是我个人的愿望嘛。"
        },
        {
          "role": "阿桂",
          "text": "我愿意为人抓药，是因为我不想看到有人因为病痛而受折磨。"
        },
        {
          "role": "阿桂",
          "text": "老话说得好，「但愿世间人无病，何愁架上药生尘」。"
        },
        {
          "role": "阿桂",
          "text": "哈哈，而且只要大家都健健康康的，我也不会那么忙了，应该也是件好事…"
        },
        {
          "role": "阿桂",
          "text": "啊，糟了！我想起来，还有一家的药没有送到！"
        },
        {
          "role": "阿桂",
          "text": "抱歉，我要先走了！祝你们海灯节快乐！"
        },
        {
          "role": "阿桂",
          "text": "唔…药还够不够啊…"
        }
      ]
    }
  ]
}