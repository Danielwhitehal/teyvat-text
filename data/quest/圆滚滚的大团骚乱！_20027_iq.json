{
  "quest_id": 20027,
  "chapter_num": null,
  "chapter_title": "圆滚滚的大团骚乱！",
  "type": "iq",
  "route": "Big Pudgy Problem!",
  "stories": [
    {
      "story_id": 20027,
      "title": "圆滚滚的大团骚乱！",
      "description": "史莱姆突然在晨曦酒庄出现，在酒庄附近的特纳似乎被卷入其中…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前去查看详请"
        },
        {
          "type": "subtitle",
          "text": "消灭史莱姆"
        },
        {
          "type": "subtitle",
          "text": "和特纳对话"
        },
        {
          "role": "特纳",
          "text": "谢谢，谢谢你，旅行者…"
        },
        {
          "role": "特纳",
          "text": "我本来是想去看看葡萄藤的情况，结果却撞上这倒霉事…"
        },
        {
          "role": "特纳",
          "text": "唉，请你别告诉我儿子，他是城里的西风骑士。他平时工作肯定也很辛苦吧。"
        },
        {
          "role": "特纳",
          "text": "我这个老头子的一点小麻烦，就不要让他再烦心了。"
        },
        {
          "role": "特纳",
          "text": "但是最近，酒庄附近总是会出现史莱姆，我每天都在担心葡萄藤会被史莱姆给毁了，睡也睡不好。"
        },
        {
          "role": "特纳",
          "text": "如果你们有空的话，就帮我老头子一个忙，再去周围看看，把史莱姆都赶走，别让它们再来破坏了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": [
                {
                  "role": "特纳",
                  "text": "太好了，我总算能休息一下了。"
                }
              ]
            },
            {
              "text": "还有别的事。",
              "dialogues": [
                {
                  "role": "特纳",
                  "text": "唉，本来说我自己来也行…但是老头子我真的动不了了，年轻人，你就帮帮我吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往异常地点"
        },
        {
          "type": "subtitle",
          "text": "用「风」驱散尘埃"
        },
        {
          "type": "subtitle",
          "text": "消灭全部史莱姆"
        }
      ]
    }
  ]
}