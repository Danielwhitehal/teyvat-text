{
  "quest_id": 25031,
  "chapter_num": null,
  "chapter_title": "小小人儿，快长大…？",
  "type": "iq",
  "route": "Grow Up Quickly, Littl'Un...?",
  "stories": [
    {
      "story_id": 25031,
      "title": "小小人儿，快长大…？",
      "description": "在「回声之子」部族中，考古学家塔莫蕾正焦急万分…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与塔莫蕾对话"
        },
        {
          "role": "塔莫蕾",
          "text": "糟糕了…这下可糟糕了…"
        },
        {
          "role": "旅行者",
          "text": "阿蕾梅的训练出问题了？"
        },
        {
          "role": "塔莫蕾",
          "text": "旅行者！你来得正好，谢天谢地…"
        },
        {
          "role": "塔莫蕾",
          "text": "没时间解释了，请你快帮我去救救人！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是你的朋友？",
              "dialogues": []
            },
            {
              "text": "是你的熟人？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔莫蕾",
          "text": "算…算是吧。我们俩都因为论文崩溃过好几轮，还在图书馆里抱头痛哭过…"
        },
        {
          "role": "塔莫蕾",
          "text": "啊啊啊——现在不是说这些的时候！那家伙根本不听我的劝！"
        },
        {
          "role": "塔莫蕾",
          "text": "说什么为了论文在所不惜，然后带着她的那个护卫，成天在野外乱逛！"
        },
        {
          "role": "塔莫蕾",
          "text": "结果她到现在都没有回来！部族这边也抽不出人手去救人…"
        },
        {
          "role": "塔莫蕾",
          "text": "旅行者，请你快去救救她！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧，我做这个很熟练。",
              "dialogues": []
            },
            {
              "text": "你们教令院的人真的是啊…",
              "dialogues": [
                {
                  "role": "塔莫蕾",
                  "text": "那家伙…唉，只能说她的运气真是差到头了。这次来纳塔，她还说什么要为论文做最后一搏…"
                }
              ]
            }
          ]
        },
        {
          "role": "塔莫蕾",
          "text": "这件事只能拜托你了！全都靠你了，旅行者！"
        },
        {
          "type": "subtitle",
          "text": "营救塔莫蕾的朋友"
        },
        {
          "type": "subtitle",
          "text": "营救塔莫蕾的朋友"
        },
        {
          "role": "塔莫蕾",
          "text": "实在不行，你就不能不写那个论文吗？啊啊啊——"
        },
        {
          "type": "subtitle",
          "text": "与塔莫蕾的朋友对话"
        },
        {
          "role": "爱拉尼",
          "text": "谢谢你，谢谢你帮忙…"
        },
        {
          "role": "娜赞",
          "text": "要是能把那个破包早点丢开，我一个人就能解决他们。"
        },
        {
          "role": "爱拉尼",
          "text": "那我们来纳塔就白来了！我才不要嘞！"
        },
        {
          "role": "旅行者",
          "text": "等等，你是…爱拉尼？"
        },
        {
          "role": "爱拉尼",
          "text": "欸？你…你是旅行者！真的是你！"
        },
        {
          "role": "旅行者",
          "text": "旁边这位小姐，难道是…"
        },
        {
          "role": "娜赞",
          "text": "娜赞。盗宝团。我们应该见过，你忘记了？"
        },
        {
          "role": "爱拉尼",
          "text": "呼啊…你真是我的大救星，救了我多少次了？一次，两次…"
        },
        {
          "role": "娜赞",
          "text": "别算我那次。那次是你自己不想走的。"
        },
        {
          "role": "爱拉尼",
          "text": "我才没算那次呢，而且什么叫我自己不想走，我都付过钱给你啦。"
        },
        {
          "role": "娜赞",
          "text": "你那么一点钱，随便吃吃喝喝就花光了。"
        },
        {
          "role": "旅行者",
          "text": "你不会又是为了论文来的吧？"
        },
        {
          "role": "爱拉尼",
          "text": "嘿嘿…我都努力那么久了，总不能白费吧…"
        },
        {
          "role": "爱拉尼",
          "text": "这次我可是从教令院里申请了专门的经费，课题也确认好了，没有人和我冲撞。"
        },
        {
          "role": "爱拉尼",
          "text": "而且，我还有娜赞给我做护卫，坏蛋全都给她打跑啦。"
        },
        {
          "role": "娜赞",
          "text": "是因为我们没油水可捞，他们也不愿意惹麻烦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那你们刚才…",
              "dialogues": []
            },
            {
              "text": "结果还是惹上麻烦了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "娜赞",
          "text": "…这家伙把自己装文献的包捂得死紧，从「回声之子」那边一直走到这里。"
        },
        {
          "role": "娜赞",
          "text": "说实话，就算是以我的眼光来看，她也像是一个怀里捂着宝贝的笨蛋。"
        },
        {
          "role": "娜赞",
          "text": "一个捂着宝贝的人，走在这种前后都无人的荒郊野外，旁边只有一个护卫…无论是谁都会想要搏一把。"
        },
        {
          "role": "爱拉尼",
          "text": "没错！我的包里就是宝贝。这些可都是我的实地采访记录，还有各类文献的抄本。"
        },
        {
          "role": "爱拉尼",
          "text": "有了它们，我的那篇论文一定能够写出来！"
        },
        {
          "role": "爱拉尼",
          "text": "哼，这篇论文的主题可是「归火圣夜巡礼」。绝对的重量级，肯定足够我毕业了。"
        },
        {
          "role": "爱拉尼",
          "text": "哎呀，也多亏了塔莫蕾给我出的主意。真不愧是我的好朋友，嘿嘿嘿。"
        },
        {
          "role": "爱拉尼",
          "text": "再次谢谢你啦，旅行者，要是没有你，那些坏蛋不仅会弄坏我的书，还会抢走我的钱！"
        },
        {
          "role": "爱拉尼",
          "text": "前段时间我帮人家整理书籍和规整资料，好不容易才挣了一些钱，被抢走的话，就没钱买新的资料了。"
        },
        {
          "role": "娜赞",
          "text": "嗯，但你最终还是会把所有钱都用来买书。如果不是我把你的钱包拿走，我们就要饿肚子了。"
        },
        {
          "role": "爱拉尼",
          "text": "也，也没有买那么多啦…"
        },
        {
          "role": "爱拉尼",
          "text": "哎呀，先不聊了。我们还要去「流泉之众」那边取材呢。"
        },
        {
          "role": "爱拉尼",
          "text": "那就再见啦！等下次见面的时候我的论文肯定完成了！到时候我一定请你吃一顿好吃的！"
        },
        {
          "type": "subtitle",
          "text": "向塔莫蕾回报"
        },
        {
          "role": "塔莫蕾",
          "text": "怎么样？情况怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "爱拉尼挺安全的。",
              "dialogues": []
            },
            {
              "text": "她继续去取材了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔莫蕾",
          "text": "呼啊…吓死我了。你再不回来，我就要自己冲出去了。"
        },
        {
          "role": "塔莫蕾",
          "text": "那个笨蛋就不能选个简单点的题目吗？以她的能力，肯定能蹭个及格分顺利毕业。"
        },
        {
          "role": "塔莫蕾",
          "text": "每次都选这么大的题目…做半天准备，最后一场空。"
        },
        {
          "role": "塔莫蕾",
          "text": "啊…抱歉，自顾自说了这么多。谢谢你帮忙，这些报酬请收下吧。"
        },
        {
          "role": "塔莫蕾",
          "text": "唉，那个笨蛋。为什么非得这么折腾自己呢…"
        }
      ]
    }
  ]
}