  "chapter_title": "腰痛的痕迹",
  "type": "iq",
  "route": "Traces of Back Pain",
  "stories": [
    {
      "story_id": 24021,
      "title": "腰痛的痕迹",
      "description": "整理着资料的沙尔梅似乎遇见了什么麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与沙尔梅对话"
        },
        {
          "role": "沙尔梅",
          "text": "痛…这箱子怎么这么重…"
        },
        {
          "role": "旅行者",
          "text": "你没事吧？"
        },
        {
          "role": "沙尔梅",
          "text": "荣誉高级研究员，又见到您了。真不好意思…我…我的腰好像受伤了，好痛…"
        },
        {
          "role": "沙尔梅",
          "text": "我之前准备去把一个箱子搬过来，整理一下里面装着的资料。"
        },
        {
          "role": "沙尔梅",
          "text": "我…我没想到那个箱子会有那么重，搬起来的时候一个没站住，所有的力量都吃在腰上。"
        },
        {
          "role": "沙尔梅",
          "text": "我现在…感觉腰都要断了，哎哟…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要我背你去看医生吗？",
              "dialogues": []
            },
            {
              "text": "我可以叫人过来。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "沙尔梅",
          "text": "不、不用…我之前也伤过腰，只要休息一下就好…"
        },
        {
          "role": "派蒙",
          "text": "到底是装着多少文件，会有这么重啊…"
        },
        {
          "role": "沙尔梅",
          "text": "应该是…很多很多卷宗吧，之前院内曾经推广过一段时间的「留痕式办公」。"
        },
        {
          "role": "沙尔梅",
          "text": "简单来说，就是院内所有的研究事务都必须留下纸质的办理证明。"
        },
        {
          "role": "沙尔梅",
          "text": "在这个办公方式推广之后，整个科学院的纸张消耗直接增长了五倍…"
        },
        {
          "role": "沙尔梅",
          "text": "因为文件太多，每一个办公室甚至被迫设立了一个「文材整理」的岗位，专门来将文件分门别类…"
        },
        {
          "role": "派蒙",
          "text": "也就说，所有事情都要记在纸上？听起来就好麻烦…"
        },
        {
          "role": "沙尔梅",
          "text": "是啊。后来这个办公方式也渐渐淡化，只在小范围内实行了。"
        },
        {
          "role": "沙尔梅",
          "text": "先不说这些…荣誉高级研究员，能请您帮我拿一下卷宗箱吗？虽然腰痛，但我还得快点整理好里面的卷宗才行…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧。",
              "dialogues": []
            },
            {
              "text": "你就好好休息吧。",
              "dialogues": [
                {
                  "role": "沙尔梅",
                  "text": "没事，我整理卷宗只用手，不用腰。您就放心吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "沙尔梅",
          "text": "那就请您，帮我把进门<color=#00E1FFFF>左边桌子</color>上的那个卷宗箱拿过来吧。"
        },
        {
          "role": "沙尔梅",
          "text": "拜托您了。那个卷宗箱很重，请您一定要小心，别和我一样…把腰伤到了…"
        },
        {
          "role": "沙尔梅",
          "text": "那就请您，帮我把进门<color=#00E1FFFF>右边桌子</color>上的那个卷宗箱拿过来吧。"
        },
        {
          "role": "沙尔梅",
          "text": "拜托您了。那个卷宗箱很重，请您一定要小心，别和我一样…把腰伤到了…"
        },
        {
          "type": "subtitle",
          "text": "帮沙尔梅取来卷宗箱"
        },
        {
          "type": "subtitle",
          "text": "帮沙尔梅取来卷宗箱"
        },
        {
          "type": "subtitle",
          "text": "帮沙尔梅取来卷宗箱"
        },
        {
          "type": "subtitle",
          "text": "帮沙尔梅取来卷宗箱"
        },
        {
          "type": "subtitle",
          "text": "与沙尔梅对话"
        },
        {
          "role": "沙尔梅",
          "text": "太好了，就是这个卷宗箱，您真是帮了大忙。"
        },
        {
          "role": "沙尔梅",
          "text": "这些东西请您收下吧。等我…哎哟！等我…好一点之后，就继续工作…"
        },
        {
          "role": "沙尔梅",
          "text": "唉，院里什么时候才能给我派个帮手过来…"
        },
        {
          "type": "subtitle",
          "text": "与沙尔梅对话"
        },
        {
          "role": "沙尔梅",
          "text": "怎么样？您帮我把卷宗箱取回来了吗？"
        },
        {
          "role": "沙尔梅",
          "text": "欸？您好像拿错卷宗箱了，不过…也没关系，这个箱子里也有许多要整理的资料。"
        },
        {
          "role": "沙尔梅",
          "text": "这些东西请您收下吧。等我…哎哟！等我…好一点之后，就继续工作…"
        },
        {
          "role": "沙尔梅",
          "text": "唉，院里什么时候才能给我派个帮手过来…"
        },
        {
          "type": "subtitle",
          "text": "与沙尔梅对话"
        },
        {
          "type": "subtitle",
          "text": "与沙尔梅对话"
        },
        {
          "type": "subtitle",
          "text": "与沙尔梅对话"
        },
        {
          "role": "沙尔梅",
          "text": "您…您怎么把两个卷宗箱都拿来了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "忘记该拿哪个了！",
              "dialogues": [
                {
                  "role": "沙尔梅",
                  "text": "噗…真有您的作风，谢谢啦。这两个卷宗箱里都有我要整理的文件。"
                }
              ]
            },
            {
              "text": "我觉得你应该都用得上。",
              "dialogues": [
                {
                  "role": "沙尔梅",
                  "text": "您的直觉还真准。这两个卷宗箱里的确都有我要整理的文件。"
                }
              ]
            }
          ]
        },
        {
          "role": "沙尔梅",
          "text": "既然您把它们都拿来了，那我也该开始工作啦，这可是一份庞大的工作量啊。"
        },
        {
          "role": "沙尔梅",
          "text": "这些东西请您收下吧。再次感谢您帮忙，荣誉高级研究员。"
        },
        {
          "role": "沙尔梅",
          "text": "唉，院里什么时候才能给我派个帮手过来…"
        }
      ]
    }
  ]
