{
  "quest_id": 10140,
  "chapter_num": "盛典与慧业 第二幕",
  "chapter_title": "沙起沙落",
  "type": "eq",
  "route": "Beginnings and Endings",
  "stories": [
    {
      "story_id": 40101,
      "title": "沙漠竞逐",
      "description": "学院争霸赛来到了第二轮，这一次比赛地点在沙漠。到阿如村的分会场看看吧…",
      "dialogues": [
         {
          "type": "subtitle",
          "text": "等待到第二天上午10点"
        },
        {
          "type": "subtitle",
          "text": "前往位于阿如村的分会场"
        },
        {
          "role": "卡维",
          "text": "我说…你的黑眼圈看起来比上一轮更严重啊。没事吗？"
        },
        {
          "role": "莱依拉",
          "text": "多谢卡维前辈关心。我这几天有点失眠…"
        },
        {
          "role": "莱依拉",
          "text": "就算不停催促自己入睡，脑袋里也总是想着比赛的事，不知不觉就熬到天亮了。"
        },
        {
          "role": "卡维",
          "text": "唉…能理解，我被设计图折磨的时候也这样。"
        },
        {
          "role": "莱依拉",
          "text": "卡维前辈有什么好办法吗？"
        },
        {
          "role": "卡维",
          "text": "说实话，没有。不如说很多事从来都没有速效解决法，只能忍耐，或者就这么熬过去。"
        },
        {
          "role": "卡维",
          "text": "唔…大概就像生病一样？有时没法对症下药，就只能等它自然痊愈。"
        },
        {
          "role": "卡维",
          "text": "我不清楚你在苦恼什么，只是能感觉到你身上那股强烈的焦虑和压抑。不过…比赛快要开始了，打起精神来吧。"
        },
        {
          "role": "莱依拉",
          "text": "好的…也祝前辈比赛顺利。"
        },
        {
          "role": "艾尔海森",
          "text": "看来人已经到齐了。接下来我将宣布第二轮比赛内容。"
        },
        {
          "role": "艾尔海森",
          "text": "阿如村附近的这片区域中，现在埋藏着三台地脉干扰器。"
        },
        {
          "role": "艾尔海森",
          "text": "这种机器能够模拟地脉紊乱的效果，时刻干预着区域内的环境，你们的目标是将它们关停。"
        },
        {
          "role": "艾尔海森",
          "text": "最先完成比赛的三个人，按照关停机器的顺序依次获得4点、3点、2点积分。"
        },
        {
          "role": "艾尔海森",
          "text": "需要强调的是，每个人只能携带定量的水和食物，另外离开比赛区域会视作本轮弃权。"
        },
        {
          "role": "珐露珊",
          "text": "怎么样后辈，这次还要不要继续合作？"
        },
        {
          "role": "珐露珊",
          "text": "看在上一轮的份上，这次我可以考虑先帮你拿到积分。"
        },
        {
          "role": "卡维",
          "text": "不用了前辈，这一带我来过很多次，机械更是我的专长之一。找到地脉干扰器对我来说轻松得很呢。"
        },
        {
          "role": "珐露珊",
          "text": "可以，年轻人有自信是好事。我也对这附近很熟悉，看看我们谁先找到机器吧。"
        },
        {
          "role": "珐露珊",
          "text": "不过除了我们之外，还有一个夺冠热门人选，需要小心应对…"
        },
        {
          "role": "派蒙",
          "text": "夺冠热门人选！是谁呀？"
        },
        {
          "role": "珐露珊",
          "text": "嘘。看到了吗，就是提纳里那小子。"
        },
        {
          "role": "珐露珊",
          "text": "上一轮他拿了第一名，如果这一轮还是他最先关停机器，就可以提前宣布学院争霸赛结束了。"
        },
        {
          "role": "珐露珊",
          "text": "我听说前不久你们一起解决了道成林的地脉泄漏问题，这次也是机器模拟的地脉紊乱，对他来说完全是轻车熟路…"
        },
        {
          "role": "派蒙",
          "text": "有道理，这么看提纳里获胜的可能性确实很高！"
        },
        {
          "role": "珐露珊",
          "text": "那小子已经有柯莱这么好的徒弟了，再让他拿到冠军，岂不是什么好事都让后辈占了？"
        },
        {
          "role": "珐露珊",
          "text": "作为前辈，我要阻止这种不公平的情况出现。我先出发了！"
        },
        {
          "role": "卡维",
          "text": "我也走了，回头再见。"
        },
        {
          "role": "赛诺",
          "text": "…你还好吗？"
        },
        {
          "role": "提纳里",
          "text": "现在还好，走一步看一步吧。"
        },
        {
          "role": "莱依拉",
          "text": "只有这么一点水吗？"
        },
        {
          "role": "妮露",
          "text": "很抱歉，但是比赛的规则是这样的。"
        },
        {
          "role": "妮露",
          "text": "这一轮比赛，表面上是比拼关停机器的速度，其实也是在考验恶劣条件下的生存能力。"
        },
        {
          "role": "莱依拉",
          "text": "果然比我预想中难多了。"
        },
        {
          "role": "莱依拉",
          "text": "要么速战速决找到机器，要么就只能节约体力等待机会…我明白了。我也准备去沙漠了，谢谢你。"
        },
        {
          "role": "妮露",
          "text": "不客气，请一定要注意安全哦。"
        },
        {
          "role": "派蒙",
          "text": "嗯…大家都已经出发了。"
        },
        {
          "role": "派蒙",
          "text": "这次我们要先去谁那边呢？嗯…让我想想…"
        },
        {
          "role": "派蒙",
          "text": "对了！珐露珊不是说，提纳里是这次的夺冠热门吗？我们就先去找他吧！"
        },
        {
          "type": "subtitle",
          "text": "寻找提纳里"
        },
        {
          "role": "派蒙",
          "text": "提纳里！提纳里——"
        },
        {
          "role": "派蒙",
          "text": "奇怪，提示器指引的位置就在这附近才对呀。"
        },
        {
          "role": "派蒙",
          "text": "提纳里——听得到吗——"
        },
        {
          "role": "旅行者",
          "text": "在那边。"
        },
        {
          "role": "派蒙",
          "text": "真的欸，提纳里怎么昏倒了…我们快去帮忙！"
        },
        {
          "role": "派蒙",
          "text": "提纳里，你没事吧？"
        },
        {
          "role": "提纳里",
          "text": "好…好热…"
        },
        {
          "role": "派蒙",
          "text": "原来是热的！难道说提纳里不习惯在沙漠中行动？"
        },
        {
          "role": "提纳里",
          "text": "没错…以前每次来沙漠，我都会准备很多水，来避免这种情况。"
        },
        {
          "role": "提纳里",
          "text": "这次水很快喝完了，再加上地脉紊乱的影响，脑袋就开始晕晕的。"
        },
        {
          "role": "提纳里",
          "text": "说起来，我祖先中的巴螺迦修那其实来自沙漠。然而物种迁徙…往往就不能适应原先的环境…"
        },
        {
          "role": "派蒙",
          "text": "现在不是说这些的时候。得快点去找水——"
        },
        {
          "role": "流浪者",
          "text": "人类真是脆弱。血肉之躯，连应对外界环境剧烈变化都做不到。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你怎么会在这？",
            "你觉得自己很「坚强」？"
          ]
        },
       
        {
          "role": "流浪者",
          "text": "拿着。给他喝。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？这水是普通的水吧…喂！你这就走了？"
        },
        {
          "role": "旅行者",
          "text": "看起来真的是普通的水。"
        },
        {
          "role": "派蒙",
          "text": "真是搞不懂他在想什么。不过还是先把水给提纳里比较重要…"
        },
        {
          "type": "subtitle",
          "text": "提纳里喝完水后，稍微清醒了一些…"
        },
        {
          "role": "提纳里",
          "text": "多谢你们，我感觉好一些了。"
        },
        {
          "role": "派蒙",
          "text": "也不光是我们啦，其实刚刚——"
        },
        {
          "role": "赛诺",
          "text": "总算找到了。"
        },
        {
          "role": "派蒙",
          "text": "赛诺！你也来了！"
        },
        {
          "role": "赛诺",
          "text": "有点担心，所以过来看看。你还能坚持下去吗？"
        },
        {
          "role": "提纳里",
          "text": "尾巴上的毛都烤干了，我觉得没必要硬撑下去。"
        },
        {
          "role": "提纳里",
          "text": "看来我不太适合这一轮比赛，既然这样，不如早点回阿如村休息。"
        },
        {
          "role": "派蒙",
          "text": "咦？提纳里打算弃权吗？"
        },
        {
          "role": "提纳里",
          "text": "嗯。有第一轮的积分打底，就算第二轮颗粒无收，下一轮仍然有逆转的机会。"
        },
        {
          "role": "提纳里",
          "text": "现在退赛还能提前养精蓄锐，继续耗下去反而没什么意义了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "好果断…",
            "我也支持。"
          ]
        },
        
        {
          "role": "赛诺",
          "text": "明智的判断。我们送你回去吧。"
        },
        {
          "role": "提纳里",
          "text": "呃…不用，我自己也能回去…"
        },
        {
          "role": "派蒙",
          "text": "好啦！不用跟我们客气——走，我们出发，回阿如村！"
        },
        {
          "type": "subtitle",
          "text": "带提纳里回去休息"
        },
        {
          "role": "派蒙",
          "text": "提纳里，你身体还是不舒服吗？要不要再休息一下？"
        },
        {
          "role": "赛诺",
          "text": "正好有阴凉的地方，可以待一会儿。"
        },
        {
          "role": "提纳里",
          "text": "好吧，听你们的。"
        },
        {
          "role": "莱依拉",
          "text": "赛诺前辈、提纳里前辈，还有旅行者和派蒙…"
        },
        {
          "role": "派蒙",
          "text": "莱依拉也在！"
        },
        {
          "role": "莱依拉",
          "text": "嗯，阳光太晒了，我在这里躲一躲。"
        },
        {
          "role": "莱依拉",
          "text": "你们呢？难道说，是已经完成比赛了？"
        },
        {
          "role": "提纳里",
          "text": "没有你想的那么厉害。我准备弃权，赛诺和旅行者正要送我回阿如村。"
        },
        {
          "role": "莱依拉",
          "text": "弃…弃权？这也可以吗？"
        },
        {
          "role": "提纳里",
          "text": "我记得规则上应该允许吧，艾尔海森说过，离开比赛范围会被视作当轮弃权。"
        },
        {
          "role": "赛诺",
          "text": "比赛前我问你还好吗？如果那时候你直接弃赛，也就不用遭罪了。"
        },
        {
          "role": "提纳里",
          "text": "总要试一试。试一试发现做不到，再放弃也不迟。"
        },
        {
          "role": "提纳里",
          "text": "等回去我一定要多做几种防晒精油。下次来沙漠之前还是要做好充足的准备。"
        },
        {
          "role": "提纳里",
          "text": "说起来，你是莱依拉选手吧。我感觉你的状态也不好，没事吗？"
        },
        {
          "role": "莱依拉",
          "text": "我刚进沙漠的时候也有点头晕，在这里休息了一会儿，已经好多了。"
        },
        {
          "role": "派蒙",
          "text": "不要勉强自己呀！"
        },
        {
          "role": "莱依拉",
          "text": "放心。我只是…"
        },
        {
          "role": "赛诺",
          "text": "压力很大？"
        },
        {
          "role": "莱依拉",
          "text": "欸…赛诺前辈能看出来吗？"
        },
        {
          "role": "赛诺",
          "text": "我在审问犯人的时候，见过他们露出和你差不多的表情。"
        },
        {
          "role": "莱依拉",
          "text": "其实，直到现在，我也不知道自己有什么资格做明论派的代表。"
        },
        {
          "role": "莱依拉",
          "text": "很多人都是因为传言才投票选我，但那些传言在我看来很缥缈。反倒是他们对我的期待，让我不知该如何是好。"
        },
        {
          "role": "莱依拉",
          "text": "就算是平时经常指责我的人，这次也投了我的名字，我觉得自己也该有所回应…"
        },
        {
          "role": "提纳里",
          "text": "这份「期待」让你感受到压力了吗？"
        },
        {
          "role": "莱依拉",
          "text": "是的。我听说提纳里前辈也是被投票选上来的，前辈是怎么应对这种压力的呢？"
        },
        {
          "role": "提纳里",
          "text": "说实话，我身上并没有什么压力。"
        },
        {
          "role": "提纳里",
          "text": "首先，投射在你身上的期待未必都是善意的。真正愿意为你考虑的人，不会希望你勉强自己。"
        },
        {
          "role": "提纳里",
          "text": "然后…我们是学者，学者的本职工作是跟知识打交道，而不是回应他人的期待。"
        },
        {
          "role": "提纳里",
          "text": "就像我来参加比赛，是为了宣传下个月在化城郭举办的科普讲座。我当然会在比赛中尽我所能，但不会背上额外的压力。"
        },
        {
          "role": "提纳里",
          "text": "我觉得你也可以找一个更明确的目标，这样应该会好一些。"
        },
        {
          "role": "莱依拉",
          "text": "我明白了，多谢提纳里前辈的教导。"
        },
        {
          "role": "提纳里",
          "text": "呼…说了这么多，嗓子又开始冒烟了。"
        },
        {
          "role": "赛诺",
          "text": "我的水壶里还剩一些。"
        },
        {
          "role": "提纳里",
          "text": "不用了，这里离阿如村也不远，我自己走回去就行了。你不是还想要限定卡牌吗？赶紧继续比赛吧。"
        },
        {
          "role": "赛诺",
          "text": "放心，我会背负着你的意志战斗下去。"
        },
        {
          "role": "提纳里",
          "text": "…不要说得好像我已经断气了一样。"
        },
        {
          "role": "提纳里",
          "text": "旅行者、派蒙，还有莱依拉，我先走了，比赛结束后再见。"
        },
        {
          "role": "赛诺",
          "text": "我也继续去找地脉干扰器了。"
        },
        {
          "role": "派蒙",
          "text": "莱依拉，你好一些了吗？"
        },
        {
          "role": "莱依拉",
          "text": "嗯，刚刚和提纳里前辈聊了聊，我感觉心里好受多了。"
        },
        {
          "role": "莱依拉",
          "text": "从家乡来到教令院已经过去了很长时间，在这里的每一天都很宝贵，当然…也有点辛苦。"
        },
        {
          "role": "莱依拉",
          "text": "各种复杂的星象模型、数不清的随堂测验，还有绞尽脑汁才能勉强做完的论文…就像一块块滚动的巨石，催促着我不停向前跑。"
        },
        {
          "role": "莱依拉",
          "text": "当我被选为学院代表时，我总觉得身后的巨石又多了一块。每次闭上眼睛我就会想，如果我搞砸了的话，一定会有很多人感到失望吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "我们不会感到失望。",
            "我们更希望莱依拉开心。"
          ]
        },
        
        {
          "role": "莱依拉",
          "text": "是啊，我想这就是提纳里前辈想要告诉我的。"
        },
        {
          "role": "莱依拉",
          "text": "你们不会阻止提纳里前辈退赛，也不会对我感到失望，因为我们是好朋友。"
        },
        {
          "role": "派蒙",
          "text": "没错，所以莱依拉不要不开心啦！"
        },
        {
          "role": "莱依拉",
          "text": "不过，提纳里前辈也说，希望我能够有更明确的参赛目标。现在我还没有，我会仔细想一想的。"
        },
        {
          "role": "莱依拉",
          "text": "不耽误你们时间啦，你们还要记录其他参赛者的事呢。说不定我们在聊天的时候，其他人已经有进展了…"
        },
        {
          "role": "派蒙",
          "text": "那我们先去其他参赛者那里看看。不过先去找谁呢？提纳里已经弃权了，赛诺刚刚见过…"
        },
        {
          "role": "莱依拉",
          "text": "要不要去珐露珊前辈那里呢？我听说珐露珊前辈对沙漠很了解，应该进展很快…"
        },
        {
          "role": "派蒙",
          "text": "好，那我们先去找珐露珊！"
        },
        {
          "type": "subtitle",
          "text": "寻找珐露珊"
        },
        {
          "role": "派蒙",
          "text": "珐露珊，你这边有什么进展吗？"
        },
        {
          "role": "珐露珊",
          "text": "你们来得正好，我正准备从这里往下挖。"
        },
        {
          "role": "派蒙",
          "text": "欸？难道说你已经找到地脉干扰器了吗？"
        },
        {
          "role": "珐露珊",
          "text": "这点小问题怎么可能难倒我？"
        },
        {
          "role": "珐露珊",
          "text": "进入沙漠不久，我就发现一个元能构装体的行动轨迹不太正常，一路跟了过来。"
        },
        {
          "role": "珐露珊",
          "text": "到这附近的时候，它突然就不见了，说明这里肯定有问题。"
        },
        {
          "role": "派蒙",
          "text": "不愧是珐露珊，这么快就想到办法了！"
        },
        {
          "role": "珐露珊",
          "text": "谁让我的经验更丰富呢？先不提这个，现在有人完成比赛了吗？"
        },
        {
          "role": "派蒙",
          "text": "还没有呢！"
        },
        {
          "role": "珐露珊",
          "text": "那看来我就是第一个了。提纳里那小子呢？"
        },
        {
          "role": "旅行者",
          "text": "提纳里弃赛了。"
        },
        {
          "role": "珐露珊",
          "text": "啊？为什么？"
        },
        {
          "role": "派蒙",
          "text": "他不太擅长在沙漠里行动…"
        },
        {
          "role": "珐露珊",
          "text": "哼，没想到他还有这样的弱点，还要多多锻炼才行呀。"
        },
        {
          "role": "珐露珊",
          "text": "其他人的情况怎么样？梨多梵谛的小丫头还在苦恼吗？"
        },
        {
          "role": "派蒙",
          "text": "提纳里跟她讲了一些道理，现在莱依拉看起来好多了。赛诺刚刚出发开始找干扰器，阿帽…我们也不知道他在想什么。"
        },
        {
          "role": "珐露珊",
          "text": "卡维呢？他也没有找到地脉干扰器吗？"
        },
        {
          "role": "派蒙",
          "text": "没有吧，不然我们的指示器会响的。"
        },
        {
          "role": "珐露珊",
          "text": "奇怪，他怎么也磨磨蹭蹭的？以他的水平，不应该这么久了还没消息。"
        },
        {
          "role": "珐露珊",
          "text": "我这边已经没什么悬念了，你们到他那里去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "观察记录卡维的情况"
        },
        {
          "role": "卡维",
          "text": "都说了别跟着我！我身上就只有这么点吃的，全给你们了。"
        },
        {
          "role": "沙狐",
          "text": "呜——"
        },
        {
          "role": "卡维",
          "text": "叫也没有用，没有就是没有！我身上只剩下半壶水，不可能给你们的。"
        },
        {
          "role": "卡维",
          "text": "没有水在沙漠寸步难行，等会儿我还得去找东西。"
        },
        {
          "role": "卡维",
          "text": "梅赫拉克，你帮我拦住它们！"
        },
        {
          "role": "梅赫拉克",
          "text": "哔啵！"
        },
        {
          "role": "派蒙",
          "text": "卡维！原来你在这里呀！"
        },
        {
          "role": "派蒙",
          "text": "珐露珊让我们来看看你，你在做什么？"
        },
        {
          "role": "卡维",
          "text": "唉，提起来就生气。我在沙漠里走了没多久，就被这些家伙缠上了。"
        },
        {
          "role": "卡维",
          "text": "不知道为什么，它们没有离开比赛区域，还被地脉干扰器搞得晕头转向。"
        },
        {
          "role": "卡维",
          "text": "见到我之后，索性赖着不走，还从我这骗去了为数不多的食物。"
        },
        {
          "role": "梅赫拉克",
          "text": "哔啵！"
        },
        {
          "role": "沙狐",
          "text": "呜——"
        },
        {
          "role": "卡维",
          "text": "啊，不是让你帮忙拦一下它们吗？"
        },
        {
          "role": "派蒙",
          "text": "卡维，这个会飞的大铁块是你的吗？"
        },
        {
          "role": "卡维",
          "text": "嗯，这是我的工具箱，叫梅赫拉克。"
        },
        {
          "role": "派蒙",
          "text": "工具箱？看起来好高级…你好呀，你能听懂我说话吗？"
        },
        {
          "role": "梅赫拉克",
          "text": "哔啵？"
        },
        {
          "role": "旅行者",
          "text": "它是怎么来的？"
        },
        {
          "role": "卡维",
          "text": "我出门要带东西嘛，有个实用的手提箱总是好事。"
        },
        {
          "role": "派蒙",
          "text": "可它看起来也不是普通的手提箱呀。"
        },
        {
          "role": "卡维",
          "text": "说来话长了，之前我在沙漠工作，遇到过一支商队。他们手上有个宝贝，是从陵墓里挖来的机械核心。"
        },
        {
          "role": "卡维",
          "text": "那个核心很明显出自赤王文明，赤王的技术由来至今未能判明，妙论派内部也是观点众多。"
        },
        {
          "role": "卡维",
          "text": "我们现有的理论还不能解开这些谜，所以，难得看到这么完整的零件，我就掏出身上所有的钱买下来了。"
        },
        {
          "role": "卡维",
          "text": "前阵子我想做个可以放东西又能脱手的自动手提箱，正好有这个零件，就以它为核心，制作了梅赫拉克。"
        },
        {
          "role": "卡维",
          "text": "它理解不了很复杂的命令，但可以充当我的助手，帮我完成测绘之类的工作。"
        },
        {
          "role": "卡维",
          "text": "最重要的是它不会说话，不会一张嘴就让人恼火。"
        },
        {
          "role": "梅赫拉克",
          "text": "哔啵！"
        },
        {
          "role": "卡维",
          "text": "哦，这么说来，上次多谢你帮忙隐瞒我现在住在艾尔海森家的事。"
        },
        {
          "role": "旅行者",
          "text": "本来也是派蒙说漏嘴了。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，对不起啦…"
        },
        {
          "role": "卡维",
          "text": "唉，真希望这种生活早点结束，我的人生能回到正确的轨道上。"
        },
        {
          "role": "卡维",
          "text": "不知道从什么时候开始，生活越来越糟。可能要追溯到我母亲改嫁去枫丹，或者从我在图书馆向艾尔海森搭话开始…"
        },
        {
          "role": "卡维",
          "text": "又或者是因为卡萨扎莱宫掏空了我的钱包，欠款到现在还没有还完。什么时候才是个头啊！"
        },
        {
          "role": "沙狐",
          "text": "呜——！！"
        },
        {
          "role": "卡维",
          "text": "仔细想想，你们也和我一样不走运。"
        },
        {
          "role": "卡维",
          "text": "被困在地脉紊乱的地方，对你们也是一种无妄之灾…好吧，我先送你们从这里出去。"
        },
        {
          "role": "派蒙",
          "text": "但是，卡维你不是还要找地脉干扰器吗？"
        },
        {
          "role": "卡维",
          "text": "话是没错，也不能放着它们不管吧…"
        },
        {
          "role": "卡维",
          "text": "先不想那么多了，越想越头疼。把它们送出去，然后我再去找地脉干扰器。"
        },
        {
          "role": "卡维",
          "text": "没时间闲聊了，我先走了！"
        },
        {
          "role": "派蒙",
          "text": "总觉得卡维很矛盾…那么想要冠军奖金，又放不下他想帮助的对象…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "是有点奇怪…",
            "本来也无法兼顾吧…"
          ]
        },
        
        {
          "role": "派蒙",
          "text": "上次见他就觉得了，他好像很容易陷入困境呢。"
        },
        {
          "role": "派蒙",
          "text": "我也不想说这种话，可那种性格的人弱点好多，很容易被人抓住把柄的吧。"
        },
        {
          "role": "旅行者",
          "text": "派蒙说出事实的样子好残忍…"
        },
        {
          "role": "派蒙",
          "text": "有人已经完成比赛了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好快。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "对呀，会是谁呢？我们去找艾尔海森问问吧！"
        }
              ]
            },
            {
              "text":  "会是谁呢？",
              "dialogues": [
             {
          "role": "派蒙",
          "text": "我也很好奇！我们去找艾尔海森问问吧！"
        }
              ]
            }      
          ]
        },
         {
          "type": "subtitle",
          "text": "返回位于阿如村的分会场"
        },
        
        {
          "role": "妮露",
          "text": "我们已经核实完毕。赛诺先生，恭喜你最先完成比赛。"
        },
        {
          "role": "派蒙",
          "text": "原来是赛诺最先找到地脉干扰器！"
        },
        {
          "role": "赛诺",
          "text": "我是素论派出身，熟悉有关地脉的知识，找到干扰器对我来说并非难事。"
        },
        {
          "role": "妮露",
          "text": "正好旅行者和派蒙也在，赛诺先生要不要说一说感想呢？"
        },
        {
          "role": "赛诺",
          "text": "感想吗？我的朋友倒在了比赛的路上，所以我绝不能输。"
        },
        {
          "role": "赛诺",
          "text": "「过往的牵绊将开辟新的未来，友情之证连接着我们，此刻的我不会输给任何人。」"
        },
        {
          "role": "赛诺",
          "text": "…这是我很喜欢的作品「召唤王」中的台词，也是我现在的感想。"
        },
        {
          "role": "派蒙",
          "text": "我觉得幸亏提纳里不在，不然应该会敲他的脑袋…"
        },
        {
          "role": "旅行者",
          "text": "很有赛诺的风格。"
        },
        {
          "role": "妮露",
          "text": "不知不觉已经快到晚上了，想必选手们的水与食物已经耗尽，比赛将变得越来越艰难。"
        },
        {
          "role": "赛诺",
          "text": "类似的场面在「召唤王」里也出现过，非常经典。"
        },
        {
          "role": "妮露",
          "text": "艾尔海森先生有什么看法？"
        },
        {
          "role": "艾尔海森",
          "text": "我对「召唤王」没有什么感想。"
        },
        {
          "role": "派蒙",
          "text": "很显然妮露不是在问这个吧！"
        },
        {
          "role": "艾尔海森",
          "text": "夜晚的沙漠比白天更危险，比赛应该接近尾声了。目前只剩下珐露珊、莱依拉和卡维还在坚持。"
        },
        {
          "role": "妮露",
          "text": "不知道下一个找到地脉干扰器的会是谁呢…"
        },
        {
          "role": "派蒙",
          "text": "欸？只剩下三个人了吗？提纳里弃权，赛诺完成比赛…对了，阿帽呢？"
        },
        {
          "role": "艾尔海森",
          "text": "不久前也弃赛了。"
        },
        {
          "role": "派蒙",
          "text": "真不知道他在想什么…"
        },
        {
          "role": "派蒙",
          "text": "不过就像艾尔海森说的，比赛应该接近尾声啦。我们去看看其他参赛者在做什么吧！"
        },
        {
          "type": "subtitle",
          "text": "观察记录其他参赛者的情况"
        },
        {
          "role": "莱依拉",
          "text": "又见面了。我突然想到，你们也跑了这么远的路，会不会很辛苦？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text":  "还好。",
              "dialogues": [
                 {
          "role": "莱依拉",
          "text": "是吗？感觉你们好厉害…"
        }
              ]
            },
            {
              "text": "是有一点…",
              "dialogues": [
                 {
          "role": "莱依拉",
          "text": "那我们在这里休息一会。"
        }
              ]
            }      
           
         
          ]
        },
       
        {
          "role": "莱依拉",
          "text": "夜晚的沙漠开始变冷了。风里带着砂砾，吹在脸上会有点疼。"
        },
        {
          "role": "莱依拉",
          "text": "有人完成比赛了吗？"
        },
        {
          "role": "派蒙",
          "text": "赛诺已经关停一个地脉干扰器了。莱依拉有什么新的发现吗？"
        },
        {
          "role": "莱依拉",
          "text": "我绕着比赛区域走了一圈，并没有找到地脉干扰器。"
        },
        {
          "role": "莱依拉",
          "text": "不过，我想通了一件很重要的事。"
        },
        {
          "role": "旅行者",
          "text": "什么事？"
        },
        {
          "role": "莱依拉",
          "text": "明论派的同学们确实是出于不同的理由，才把我推选为学院代表的。也许很多人只是想看我的笑话而已。"
        },
        {
          "role": "莱依拉",
          "text": "但是，我觉得一定也有很多人，是真心对我抱有期待的。"
        },
        {
          "role": "莱依拉",
          "text": "我想回应他们的期待，想让他们不后悔写下我的名字。"
        },
        {
          "role": "派蒙",
          "text": "咦？但是莱依拉不会感到有压力吗？"
        },
        {
          "role": "莱依拉",
          "text": "要说压力，当然也还是有一些的。只是对现在的我来说，这已经不是「必须做的事」，而是「我想做的事」。"
        },
        {
          "role": "莱依拉",
          "text": "听起来或许没有很大的变化，但是我已经放松下来了，不用担心。"
        },
        {
          "role": "派蒙",
          "text": "这样啊，太好啦！"
        },
        {
          "role": "莱依拉",
          "text": "然后，因为终于放松下来，不自觉地就会很困…"
        },
        {
          "role": "莱依拉",
          "text": "我稍微打个盹…就一小会儿…"
        },
        {
          "role": "莱依拉",
          "text": "……"
        },
        {
          "role": "莱依拉",
          "text": "嗯？比赛还没结束啊，这孩子，也有点太紧张了吧？"
        },
        {
          "role": "派蒙",
          "text": "你是！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "「梦游模式的莱依拉」？",
            "「另一个莱依拉」？"
          ]
        },
        
        {
          "role": "莱依拉",
          "text": "好久不见，我也好久没出来透透气了。"
        },
        {
          "role": "莱依拉",
          "text": "既然出来了，就先帮她完成比赛。比赛内容是什么来着？要找地脉干扰器是吗？"
        },
        {
          "role": "莱依拉",
          "text": "让我看看…其实她已经把信息都收集得差不多了，我帮她完成最后的收尾工作吧。"
        },
        {
          "role": "莱依拉",
          "text": "旅行者、派蒙，跟我来。"
        },
        {
          "type": "subtitle",
          "text": "跟随「另一个莱依拉」行动"
        },
        {
          "type": "subtitle",
          "text": "与莱依拉对话"
        },
        {
          "role": "莱依拉",
          "text": "是这个吧？我把它关掉了，这附近的地脉应该恢复正常了。"
        },
        {
          "role": "派蒙",
          "text": "好厉害！"
        },
        {
          "role": "莱依拉",
          "text": "我说了，并不是我的功劳，我只是负责收尾而已。"
        },
        {
          "role": "莱依拉",
          "text": "等会儿她应该就醒了。之后大概会再迷茫一段时间，然后去汇报自己关停了地脉干扰器的事情吧。"
        },
        {
          "role": "莱依拉",
          "text": "你们要在这里待一会儿吗？还是去看看其他参赛者？"
        },
        {
          "role": "派蒙",
          "text": "让我看看提示器…咦！卡维和珐露珊好像正在朝同一个地方走！"
        },
        {
          "role": "莱依拉",
          "text": "也许是他们要找到最后一台地脉干扰器了。说起卡维前辈，真是个有趣的人。"
        },
        {
          "role": "派蒙",
          "text": "咦？为什么这么说？"
        },
        {
          "role": "莱依拉",
          "text": "第二轮比赛前，卡维前辈曾经跟另一个我聊过天。他说烦恼就像生病，不是总能对症下药的，有时要等它自愈。"
        },
        {
          "role": "莱依拉",
          "text": "但依我看，他的问题比另一个我严重得多…那时候另一个我只是没找到想做的事，才会迷茫困惑。"
        },
        {
          "role": "莱依拉",
          "text": "卡维前辈有想做的事，他清楚地知道他必须拿到奖金，又表现得很矛盾…"
        },
        {
          "role": "莱依拉",
          "text": "他明明没有第二个人格，却好像…也没法跟自己完全和解。"
        },
        {
          "role": "莱依拉",
          "text": "…我不太擅长描述那种感觉。一个人笑着，可心里并不快乐，而是有些哀伤。"
        },
        {
          "role": "莱依拉",
          "text": "不过往好处想，也许他比我有经验，更能处理这些问题。"
        },
        {
          "role": "莱依拉",
          "text": "啊，你们去现场记录吧？对你们来说这应该也是本轮比赛的「收尾」。"
        },
        {
          "role": "派蒙",
          "text": "好吧，那我们先走了！你说的事我们也记得了！"
        },
        {
          "type": "subtitle",
          "text": "寻找卡维和珐露珊"
        },
        {
          "role": "珐露珊",
          "text": "按理来说就在这边…"
        },
        {
          "role": "卡维",
          "text": "总算找到了…"
        },
        {
          "role": "珐露珊",
          "text": "卡维？你该不会…"
        },
        {
          "role": "卡维",
          "text": "珐露珊前辈！我还以为前辈早就已经完成比赛了…"
        },
        {
          "role": "派蒙",
          "text": "珐露珊、卡维——"
        },
        {
          "role": "派蒙",
          "text": "啊，看来莱依拉已经完成比赛了。"
        },
        {
          "role": "卡维",
          "text": "没想到我和珐露珊前辈同时找到地脉干扰器…其他参赛者那边怎么样了？"
        },
        {
          "role": "派蒙",
          "text": "提纳里和阿帽弃权，赛诺和莱依拉已经完成比赛，只剩下你们两个啦！"
        },
        {
          "role": "派蒙",
          "text": "奇怪，我记得珐露珊不是很早之前就开始挖掘了吗？"
        },
        {
          "role": "珐露珊",
          "text": "是啊，我一直往下挖，没挖到地脉干扰器，反而挖进了一座遗迹里。"
        },
        {
          "role": "珐露珊",
          "text": "我掉到了很深的地方。里面漆黑一片，我花了好大力气才解开机关，回到地上。"
        },
        {
          "role": "派蒙",
          "text": "总觉得…也挺厉害的…"
        },
        {
          "role": "卡维",
          "text": "这么短的时间走完别人一个星期的路，不愧是前辈…"
        },
        {
          "role": "珐露珊",
          "text": "你呢？为什么也来得这么晚？"
        },
        {
          "role": "卡维",
          "text": "路上遇到了很多迷路的沙狐，我将它们带到了比赛区边缘…回来的时候口干舌燥，突然眼前一黑，估计是被晒晕了吧。"
        },
        {
          "role": "卡维",
          "text": "等我醒过来的时候已经是晚上了，我用最后一点体力找到了这里。"
        },
        {
          "role": "珐露珊",
          "text": "真是奇特的理由…我说，你真的没问题吗？一个人晕倒在沙漠里什么的，听上去就很危险吧。"
        },
        {
          "role": "珐露珊",
          "text": "你说你很熟悉沙漠，遇到问题却这样处理，有些不符合你那天才之名吧。"
        },
        {
          "role": "卡维",
          "text": "啊哈哈，确实有些问题，不过这跟天不天才没关系，是我的选择。"
        },
        {
          "role": "卡维",
          "text": "…做法确实不妥，但不这样做，我总觉得不太舒服，心里隐约有种负罪感。所以…"
        },
        {
          "role": "珐露珊",
          "text": "…哼，现在的年轻人一个比一个奇怪。"
        },
        {
          "role": "珐露珊",
          "text": "说回正题。看来我们都很笃定最后一台地脉干扰器就在这里，那就先把它挖出来吧。"
        },
        {
          "type": "subtitle",
          "text": "合力挖出了最后一台地脉干扰器。"
        },
        {
          "role": "珐露珊",
          "text": "果然，就是它了，我们想的没错。不过这次要怎么算呢？"
        },
        {
          "role": "卡维",
          "text": "呼…"
        },
        {
          "role": "珐露珊",
          "text": "怎么了后辈，一副松了口气的样子？"
        },
        {
          "role": "卡维",
          "text": "噢，没什么，只是在想这个环节终于结束了。"
        },
        {
          "role": "卡维",
          "text": "…应该不会再有什么与我们无关的动物被卷进危险里了吧。"
        },
        {
          "role": "卡维",
          "text": "至于积分…等会儿去再抽一次签吧，也没有更好的办法了。"
        },
        {
          "role": "派蒙",
          "text": "好，那我们先回阿如村吧。感觉你们两个都需要先喝点水，休息一下。"
        },
        {
          "type": "subtitle",
          "text": "返回分会场查看比赛结果"
        },
        {
          "role": "妮露",
          "text": "看来第二轮比赛结束了。不知道珐露珊小姐和卡维先生谁更快一些呢？…嗯？珐露珊小姐呢？"
        },
        {
          "role": "卡维",
          "text": "珐露珊前辈去喝水了，马上就来。我们几乎是同时找到，所以想再抽一次签。"
        },
        {
          "role": "艾尔海森",
          "text": "你很容易沉迷于一些事物，比如抽签。"
        },
        {
          "role": "卡维",
          "text": "我没有沉迷！不要把运气不好说成是我自己乐意！"
        },
        {
          "role": "艾尔海森",
          "text": "是吗？那换个说法，你与抽签有着奇妙的缘分。"
        },
        {
          "role": "妮露",
          "text": "那我去准备抽签用到的盒子与纸条，两位稍等…"
        },
        {
          "role": "卡维",
          "text": "……"
        },
        {
          "role": "珐露珊",
          "text": "噢，又要抽签了呢，看看前辈我的手气。"
        },
        {
          "role": "？？？",
          "text": "在紧张却短暂的抽签过后，卡维顺利中签…"
        },
        {
          "role": "卡维",
          "text": "我中签了！你们看到了吗？这次是我抽中了！"
        },
        {
          "role": "妮露",
          "text": "恭喜卡维先生。"
        },
        {
          "role": "派蒙",
          "text": "卡维的运气变好了呢！"
        },
        {
          "role": "卡维",
          "text": "真是太不容易了。呜呜…"
        },
        {
          "role": "珐露珊",
          "text": "不枉你在沙漠里吃了那么多苦头呢，这次的分数就归你啦。"
        },
        {
          "role": "艾尔海森",
          "text": "……"
        },
        {
          "role": "妮露",
          "text": "这样完成第二轮比赛的，分别是赛诺、莱依拉、卡维三位选手。"
        },
        {
          "role": "妮露",
          "text": "目前排名的话，让我算算…"
        },
        {
          "role": "妮露",
          "text": "赛诺先生和莱依拉小姐各有4点积分，并列第一。往后依次是提纳里、珐露珊、卡维和阿帽选手。"
        },
        {
          "role": "妮露",
          "text": "下一轮比赛将会是最后一轮。在那之前，希望大家好好休息。"
        },
        {
          "role": "妮露",
          "text": "我听说学院游乐会的摊位推出了一些新的玩法，如果感兴趣的话也可以去逛逛。我们下一轮比赛再见了。"
        }
      ]
    },
    {
      "story_id": 40102,
      "title": "疑案浮现",
      "description": "第二轮比赛落幕，心里却总有些事放不下…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "到学院摊位玩"
        },
        {
          "role": "派蒙",
          "text": "旅行者，总觉得你好像有什么心事？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（比赛开始前见到的白发男子…）",
              "dialogues": []
            },
            {
              "text": "（第一轮比赛结束后听到的密谈…）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "坎蒂丝",
          "text": "旅行者、派蒙，总算找到你们了。"
        },
        {
          "role": "派蒙",
          "text": "咦，出什么事了吗？"
        },
        {
          "role": "迪希雅",
          "text": "你们有没有觉得这次学院庆典有些奇怪？"
        },
        {
          "role": "迪希雅",
          "text": "刚刚我和坎蒂丝在咖啡馆，好像见到了来这里办事的佣兵。他们还特地乔装打扮了一番，装作只是来逛街的游客。"
        },
        {
          "role": "迪希雅",
          "text": "但再怎么装，身上的血腥味是掩盖不掉的。看他们那副贼眉鼠眼的样子，接的估计还是绑票、暗杀这种下三滥的活儿。"
        },
        {
          "role": "坎蒂丝",
          "text": "我们听了一会儿，他们的目标好像是一个叫「萨齐因」的人。"
        },
        {
          "role": "派蒙",
          "text": "萨齐因？是不是开幕式的时候，卡莉娜提起过的那个人？"
        },
        {
          "role": "派蒙",
          "text": "据说「才识之冠」还有比赛的奖金都是他赞助的。不过这个人好像一直没有露面…"
        },
        {
          "role": "迪希雅",
          "text": "听上去是个有钱人吧，那就不奇怪了。"
        },
        {
          "role": "迪希雅",
          "text": "这年头镀金旅团的日子也不好过，很多佣兵团会接一些「私活」，盯上的都是有钱有势的大人物。"
        },
        {
          "role": "迪希雅",
          "text": "用他们的话说叫开张吃半年，只要干成一票，捞到的赎金能让他们潇洒好些日子。"
        },
        {
          "role": "坎蒂丝",
          "text": "因为学院庆典，须弥城一下子来了很多游客，他们估计也是借机混进来的。"
        },
        {
          "role": "坎蒂丝",
          "text": "我和迪希雅原本想直接抓住对方，但他们很警觉，找借口溜走了。"
        },
        {
          "role": "迪希雅",
          "text": "要不是不想在城里大打出手，第一时间就该把他们绑了。"
        },
        {
          "role": "迪希雅",
          "text": "按规矩这事应该谁来管？风纪官？还是三十人团？"
        },
        {
          "role": "派蒙",
          "text": "嗯…如果赛诺在的话，他应该会管。要不我们先回一趟教令院，把消息告诉风纪官吧。"
        },
        {
          "role": "派蒙",
          "text": "迪希雅、坎蒂丝，这次多谢你们啦！"
        },
        {
          "role": "坎蒂丝",
          "text": "没什么，我们也是碰巧听到。"
        },
        {
          "role": "迪希雅",
          "text": "是啊，不用放在心上。真让他们得逞了，镀金旅团的名声只会变得更差。"
        },
        {
          "role": "迪希雅",
          "text": "这里毕竟是须弥城，我和坎蒂丝不方便动手，就交给你们了。"
        },
        {
          "role": "坎蒂丝",
          "text": "需要帮助的话，来咖啡馆找我们就好。"
        },
        {
          "role": "派蒙",
          "text": "刚刚我总觉得你有什么心事，难道也是在思考学院庆典的问题？听迪希雅和坎蒂丝说完之后，我也感觉这背后好像藏着一些秘密…"
        },
        {
          "role": "派蒙",
          "text": "嗯…这么干想下去也不是办法。走，我们去教令院找风纪官吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（迪希雅&坎蒂丝）"
        },
        {
          "role": "迪希雅",
          "text": "没想到有人敢在学院庆典期间动手，看来萨齐因的财产有很大的诱惑力啊。"
