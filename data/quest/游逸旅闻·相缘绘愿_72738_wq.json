{
  "quest_id": 72738,
  "chapter_num": null,
  "chapter_title": "游逸旅闻·相缘绘愿",
  "type": "wq",
  "route": "Travelers' Tales: Destiny Drawn",
  "stories": [
    {
      "story_id": 72738,
      "title": "游逸旅闻·相缘绘愿",
      "description": "稻妻鸣神大社，似乎发生了一些新鲜事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往鸣神大社"
        },
        {
          "role": "八重神子",
          "text": "嗯，差不多就这样吧。简单清扫一下就好了…"
        },
        {
          "role": "八重神子",
          "text": "哎呀？小家伙，你来得可真巧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "来得巧？哪里巧了？",
              "dialogues": []
            },
            {
              "text": "等一会，这个开场白…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "瞧瞧你，脑子里肯定在想：「唉，这女人肯定又要把什么麻烦事推给我了。」"
        },
        {
          "role": "八重神子",
          "text": "放心吧，只是本社刚刚做好整修，正准备推出全新的业务。"
        },
        {
          "role": "八重神子",
          "text": "还没来得及对外公布呢，你就过来了。这不是巧了么？"
        },
        {
          "role": "八重神子",
          "text": "喏，看到我旁边的赛钱箱了没？以后啊，这里就要多一个许愿的地方了。"
        },
        {
          "role": "旅行者",
          "text": "不是已经有御神签了么？"
        },
        {
          "role": "八重神子",
          "text": "那可不一样。御神签那边是看运势，而这边嘛…则是用来「许愿」的。"
        },
        {
          "role": "八重神子",
          "text": "只需要闭上眼想着自己的愿望，再把愿望写上绘马，再挂在旁边的架子上，说不定愿望就会实现喔。"
        },
        {
          "role": "旅行者",
          "text": "什么愿望都可以？"
        },
        {
          "role": "八重神子",
          "text": "当然了。不过，究竟能实现哪些，就只能看护佑着咱们的神明啦。"
        },
        {
          "role": "八重神子",
          "text": "我这个没用的宫司，最多也只能帮你在人缘上想想办法了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能遇见新朋友的话很好。",
              "dialogues": []
            },
            {
              "text": "和老朋友们见面也不错…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "八重神子",
          "text": "如果这就是你的心愿，那就去试试吧，来，拿着这些「签文簿纸」。"
        },
        {
          "role": "八重神子",
          "text": "这是我在写「御神签」的时候剩下的，送给你了。"
        },
        {
          "role": "八重神子",
          "text": "把愿望写在上面再许愿，也许会更灵验喔。"
        },
        {
          "role": "旅行者",
          "text": "真的？"
        },
        {
          "role": "八重神子",
          "text": "哎呀，我什么时候骗过你？快去许愿吧，小家伙。"
        },
        {
          "role": "八重神子",
          "text": "记住了，先把愿望写在「签文簿纸」上，再把簿纸贴在绘马上，最后把绘马挂在架子上…"
        },
        {
          "role": "八重神子",
          "text": "这样，许愿就完成了。"
        },
        {
          "role": "八重神子",
          "text": "嗯，很诚心嘛，不错不错。"
        },
        {
          "role": "旅行者",
          "text": "这真的有用吗…"
        },
        {
          "role": "八重神子",
          "text": "好啦，继续忙去吧小家伙。但记得要竖起耳朵，瞪大眼睛。"
        },
        {
          "role": "八重神子",
          "text": "说不定，你想要遇见的那个人，就在某个拉面摊上吃拉面呢。"
        }
      ]
    }
  ]
}