{
  "quest_id": 10250,
  "chapter_num": "幻友绮旅 其二",
  "chapter_title": "若你遗忘梦的入口",
  "type": "eq",
  "route": "If You Should Forget the Entrance to Dreams",
  "stories": [
    {
      "story_id": 40240,
      "title": "若你遗忘梦的入口",
      "description": "「面团大王」和它的同族按照约定来到小魔女们的秘密基地，还带来了新的线索…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至第二天8-10点"
        },
        {
          "type": "subtitle",
          "text": "前往秘密基地"
        },
        {
          "role": "可莉",
          "text": "面团大王来啦，欸？还有没见过的姐姐。"
        },
        {
          "role": "百日白白音",
          "text": "你们好，我叫百日白白音。我的食梦貘同族，小白，也就是大家口中的面团大王，已经将事件经过回报到族群里了。"
        },
        {
          "role": "百日白白音",
          "text": "旅行者和派蒙？没想到你们也在，最近还好吗？"
        },
        {
          "role": "派蒙",
          "text": "白音！真巧啊，我们本来要去秋沙钱汤泡温泉来着，只是临时遇到点事改变了行程。"
        },
        {
          "role": "百日白白音",
          "text": "随时欢迎你们来。瑞希姐姐出差了，把族群内的事务暂托给我打理…我…我会努力做好的！"
        },
        {
          "role": "派蒙",
          "text": "等等，听起来你今天过来就是为了处理我们遇到的事件啊，真的太巧了。"
        },
        {
          "role": "布伦妮",
          "text": "原来你们一直说的面团大王是食梦貘？"
        },
        {
          "role": "布伦妮",
          "text": "《提瓦特冷门生物科普·稻妻篇》有食梦貘的图文简介，憨态可掬，如绵软的面团，部分也可化为人形…"
        },
        {
          "role": "布伦妮",
          "text": "通过吞食人类噩梦来帮助人类调节情绪，是一种很友好的妖怪。"
        },
        {
          "role": "布伦妮",
          "text": "顺便一提，在136页。"
        },
        {
          "role": "百日白白音",
          "text": "谢谢这位博学的小朋友…也很感谢其他小朋友参与帮忙。"
        },
        {
          "role": "可莉",
          "text": "小魔女哦，我们是小魔女会。"
        },
        {
          "role": "百日白白音",
          "text": "好、好的。感谢小魔女会。"
        },
        {
          "role": "百日白白音",
          "text": "关于那位幻想朋友…我们召集平时在野外巡逻的食梦貘讨论了一个晚上，情况有些复杂…"
        },
        {
          "role": "布伦妮",
          "text": "可莉，你带着小魔女们陪爆米花先到那边去玩好不好？"
        },
        {
          "role": "可莉",
          "text": "唔，可以啊，大家都跟我来！"
        },
        {
          "role": "派蒙",
          "text": "噢？你还特意支开她们？"
        },
        {
          "role": "布伦妮",
          "text": "因为听这位小姐的语气，接下来的话题会牵扯到不太妙的内容吧。"
        },
        {
          "role": "布伦妮",
          "text": "我知道小孩子过早接触社会的黑暗面不是好事，谨慎为上。"
        },
        {
          "role": "派蒙",
          "text": "可你不也是…小孩子嘛…"
        },
        {
          "role": "布伦妮",
          "text": "我又听见了！你就不能在心里说吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "布伦妮很关心她们几个呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "反、反正她们听得坐不住的时候也会嚷嚷着去玩，只是提前了一点而已…"
        },
        {
          "role": "百日白白音",
          "text": "呵呵…其实没到社会黑暗面那么严重啦…容我先说明一下事件进展吧。"
        },
        {
          "role": "百日白白音",
          "text": "小白，也就是面团大王将爆米花委托给小朋，呃，小魔女会后，在那附近发现了这个。"
        },
        {
          "role": "派蒙",
          "text": "咦…这是什么？看着让人不太舒服…"
        },
        {
          "role": "百日白白音",
          "text": "简单来说，这是一种由负面情绪积压而成的情绪碎片，来自某个噩梦。"
        },
        {
          "role": "百日白白音",
          "text": "这种碎片本身就是情绪实体化的表现，爆米花身上也有跟这个碎片相同的气息。"
        },
        {
          "role": "百日白白音",
          "text": "我们推测它接触过这个碎片，并受到同样的实体化影响。"
        },
        {
          "role": "布伦妮",
          "text": "实体化…所以我们才能在现实世界里看得见幻想朋友。"
        },
        {
          "role": "百日白白音",
          "text": "幻想朋友本来是人类潜意识中积极情感的汇集体，但目前的状况，它受噩梦碎片的影响，变得混沌…"
        },
        {
          "role": "派蒙",
          "text": "所以爆米花才会像现在这样喜怒无常，记忆混乱！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我还有个问题…",
              "dialogues": []
            },
            {
              "text": "关于爆米花所属的人类朋友…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯，我们在开小魔女的茶会时问过关于它的小朋友的事，爆米花提过小焰很难受，需要帮忙。"
        },
        {
          "role": "百日白白音",
          "text": "根据已有的线索，大概率是因为小焰做了噩梦，爆米花又被噩梦碎片影响变成了这样。"
        },
        {
          "role": "布伦妮",
          "text": "你们是食梦貘，跟梦有关的事情一定有办法！"
        },
        {
          "role": "布伦妮",
          "text": "一定要帮帮爆米花！它变成这样它的小朋友一定也在着急！"
        },
        {
          "role": "百日白白音",
          "text": "按照经验，食梦貘吃掉这些负面情绪后，受影响的对象就能恢复正常了，不管是它还是这个噩梦的主人。"
        },
        {
          "role": "百日白白音",
          "text": "但我们正要行动时又收到了其他食梦貘的情报，还有三个地方有跟这个碎片相似的气味，请看。"
        },
        {
          "role": "[[file",
          "text": "活动任务-若你遗忘梦的入口-地图.png|center|400px]]"
        },
        {
          "role": "布伦妮",
          "text": "也就是说，还有三枚这样的噩梦碎片散落在这些地方？"
        },
        {
          "role": "百日白白音",
          "text": "嗯。这个碎片中的情绪很不稳定，我们担心贸然先吞食掉一枚会引起其他碎片不可预料的反应…"
        },
        {
          "role": "百日白白音",
          "text": "最好先找齐所有的噩梦碎片，集中同时处理掉会比较保险。"
        },
        {
          "role": "百日白白音",
          "text": "可如你所见…我们食梦貘大部分同族都是这种圆圆滚滚的身材，短短的腿跑步不快，圆圆的手也很难抓握工具…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "包在我们身上！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "百日白白音",
          "text": "真的吗？实在是感激不尽！这张地图请你们先收好。"
        },
        {
          "role": "百日白白音",
          "text": "容我再补充一句，噩梦碎片聚集很多负面能量，很可能会引起周遭环境的变化。"
        },
        {
          "role": "百日白白音",
          "text": "建议优先关注环境中不寻常的地方，说不定噩梦碎片就在附近。"
        },
        {
          "role": "百日白白音",
          "text": "我会再征集几位同族，明天带着空空的肚子和处理噩梦需要的材料上门。"
        },
        {
          "role": "派蒙",
          "text": "原来噩梦不是一口吃掉就行，还需要特殊处理的啊？"
        },
        {
          "role": "百日白白音",
          "text": "其、其实就是各种调味料啦…对于我们来说，噩梦的味道不算太好，如果有调味选择的话会好很多…"
        },
        {
          "role": "派蒙",
          "text": "哦、哦好的。真是辛苦你们了。"
        },
        {
          "role": "百日白白音",
          "text": "哪里的话，那么我先回去忙了。小白会留在这边帮忙照顾爆米花，祝大家顺利！我们明天见。"
        },
        {
          "role": "早柚",
          "text": "我们什么时候出发？"
        },
        {
          "role": "派蒙",
          "text": "呜哇？！你什么时候来到我身后的，为什么一点动静都没有。"
        },
        {
          "role": "早柚",
          "text": "哼哼。忍者走路不能发出声音，不然就很难溜去偷懒了。"
        },
        {
          "role": "早柚",
          "text": "其实，我还学了新的忍术，掩护之貉——"
        },
        {
          "role": "可莉&瑶瑶",
          "text": "噔噔！"
        },
        {
          "role": "七七",
          "text": "噔噔。"
        },
        {
          "role": "可莉",
          "text": "小派蒙，我们都听见了哟，我们什么时候出发。"
        },
        {
          "role": "瑶瑶",
          "text": "爆米花是我们的朋友，我们也想为他出一份力。"
        },
        {
          "role": "布伦妮",
          "text": "带这么多小孩一起出门，要顾及的事情太多了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没关系，有我在呢。",
              "dialogues": []
            },
            {
              "text": "而且还有你这位靠谱的小孩在。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "我不是小孩了！"
        },
        {
          "role": "布伦妮",
          "text": "（算了，旅行最能看清一个人，说不定有机会找到魔女的弱点…）"
        },
        {
          "role": "布伦妮",
          "text": "那…我们简单收拾一下就出发吧。"
        },
        {
          "type": "subtitle",
          "text": "准备齐全后出发"
        },
        {
          "type": "subtitle",
          "text": "额外对话（可莉&瑶瑶&七七&早柚）"
        },
        {
          "role": "可莉",
          "text": "我要带好多好多炸弹，把路上的坏蛋炸上天！"
        },
        {
          "role": "瑶瑶",
          "text": "我带了伞，可以遮雨挡太阳。还准备了很多驱虫的草药，给大家包起来了，应该能帮上忙！"
        },
        {
          "role": "瑶瑶",
          "text": "给。你们放在口袋里，在野外就不怕被虫子咬啦。布伦妮和旅行者那份我也包好了。"
        },
        {
          "role": "七七",
          "text": "不小心摔跤了，不要哭。来找七七，帮忙冰敷…"
        },
        {
          "role": "早柚",
          "text": "稻妻的路很复杂，小魔女们要一起行动，不要单独离队，迷路了就在原地等，我会来找大家的。"
        },
        {
          "role": "早柚",
          "text": "噢，还有布伦妮和旅行者，小魔女会也要保护好他们！"
        },
        {
          "role": "派蒙",
          "text": "嗯，了解了。旅行者一直都是保护别人的角色，这次就让小魔女会保护他吧！"
        },
        {
          "role": "派蒙",
          "text": "还有，我准备了顶饱好吃又不脏手的零食，很适合在野外快速补充能量！饿了就找我拿噢。"
        },
        {
          "role": "布伦妮",
          "text": "我准备好了，随时可以出发。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就出发吧！",
              "dialogues": [
                {
                  "role": "布伦妮",
                  "text": "我来看看食梦貘给的地图，离这里最近的是镇守之森内部…我们走！"
                }
              ]
            },
            {
              "text": "再等等，马上准备好。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找噩梦碎片"
        },
        {
          "role": "派蒙",
          "text": "地图上标的就是这里了吧？是一片小树林耶。"
        },
        {
          "role": "早柚",
          "text": "这里的每一棵树我都睡过，曾经获得早柚偷懒胜地大赏第五名的好成绩！"
        },
        {
          "role": "瑶瑶",
          "text": "曾经？"
        },
        {
          "role": "早柚",
          "text": "被巫女姐姐发现后就跌到第七名了。"
        },
        {
          "role": "布伦妮",
          "text": "分组搜索吧，提高效率。"
        },
        {
          "role": "布伦妮",
          "text": "我爬树还可以，我可以负责一棵。早柚的技术就更不用说了，剩下的…"
        },
        {
          "role": "可莉",
          "text": "布伦妮姐姐，我们来赛跑吧！从这里开始跑过去，比比看谁最快找到线索！"
        },
        {
          "role": "布伦妮",
          "text": "我还没说完——"
        },
        {
          "role": "瑶瑶",
          "text": "走吧走吧~活络活络筋骨。"
        },
        {
          "role": "可莉",
          "text": "荣誉骑士哥哥，你来喊预备开跑好不好？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "各就各位~",
              "dialogues": []
            }
          ]
        },
        {
          "role": "瑶瑶",
          "text": "七七一会要跟紧我哦！"
        },
        {
          "role": "可莉",
          "text": "小派蒙可以带着可莉飞吗？"
        },
        {
          "role": "派蒙",
          "text": "呃…好像有点难度呀…"
        },
        {
          "role": "早柚",
          "text": "呜呼流的逃跑术从来没有输过。"
        },
        {
          "role": "布伦妮",
          "text": "我到底为什么要跟着你们一起疯啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "预备——跑！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "早柚",
          "text": "冲呀——"
        },
        {
          "role": "布伦妮",
          "text": "不可能输给小孩。"
        },
        {
          "role": "瑶瑶",
          "text": "哎呀，你怎么还在原地，她们都跑远了。来，牵紧我。"
        },
        {
          "type": "subtitle",
          "text": "在小树林区域寻找噩梦碎片"
        },
        {
          "role": "瑶瑶",
          "text": "七七，刚刚跑那一段累吗？累的话可以先歇一会哦。"
        },
        {
          "role": "七七",
          "text": "七七不累。瑶瑶流汗了，我帮你擦擦。"
        },
        {
          "role": "七七",
          "text": "白术先生说，出了汗容易着凉，要快擦干。"
        },
        {
          "role": "瑶瑶",
          "text": "你这也记住了呀？不愧是不卜庐的好帮手。"
        },
        {
          "role": "七七",
          "text": "我记不住的…笔记有写，我刚刚看的。上面还写了：找饿梦碎片。"
        },
        {
          "role": "瑶瑶",
          "text": "不是这个「饿」字，回头教你写吧，我们先找碎片。加油，发挥我们在璃月采药采萝卜的本领！"
        },
        {
          "role": "可莉",
          "text": "全都炸下来——"
        },
        {
          "role": "派蒙",
          "text": "不行不行，「放火烧山，可莉完蛋！」你忘了吗？"
        },
        {
          "role": "可莉",
          "text": "这里没有骑士团也要遵守吗？"
        },
        {
          "role": "派蒙",
          "text": "所以可莉才更要好好表现，让骑士团的大家知道可莉是乖孩子，下次会更加放心让可莉出来玩。"
        },
        {
          "role": "可莉",
          "text": "可莉要当乖孩子！可莉还要跟小魔女们去很多很多地方玩！"
        },
        {
          "role": "派蒙",
          "text": "嗯！那可莉负责检查树底，我飞上去看看，可以吗？"
        },
        {
          "role": "可莉",
          "text": "好的，小派蒙小心！可莉也会小心的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抬头看",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "这树还真不好爬。还好在挪德卡莱没少爬屋顶，没想到这门手艺居然在这派上用场了。"
        },
        {
          "role": "布伦妮",
          "text": "食梦貘说重点关注与环境中格格不入且不合常理的地方…我看看…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抬头看",
              "dialogues": []
            }
          ]
        },
        {
          "role": "早柚",
          "text": "啊…这个宝座还是那么舒服，让人想睡…不能睡！"
        },
        {
          "role": "早柚",
          "text": "我带了薄荷…嗯，打起精神早柚！早找到，早睡觉。"
        },
        {
          "type": "subtitle",
          "text": "查看布伦妮的新发现"
        },
        {
          "role": "布伦妮",
          "text": "欸？！好大的尾巴啊！不对劲吧！"
        },
        {
          "role": "？？？",
          "text": "喵嗷——？！"
        },
        {
          "type": "subtitle",
          "text": "布伦妮用力地扯了扯眼前的尾巴，一声惨烈的猫叫随即传来…大家都闻声围了过去。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "绮良良",
          "text": "痛痛痛…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "绮良良？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "绮良良",
          "text": "旅行者和派蒙！见到你们瞬间就清醒了，你们好呀！还有一群小朋友…都是你们的朋友？小朋友们好呀。"
        },
        {
          "role": "可莉",
          "text": "大猫猫你好，我们是小魔女哟！"
        },
        {
          "role": "派蒙",
          "text": "绮良良怎么会在这呀？"
        },
        {
          "role": "绮良良",
          "text": "今天快递不多，我送完过来这边磨爪子，磨着磨着就困了，就打了个盹…然后，睡着睡着，尾巴就被扯了一下…"
        },
        {
          "role": "布伦妮",
          "text": "抱歉，是我搞错了。我以为你的尾巴是我们在找的东西…"
        },
        {
          "role": "布伦妮",
          "text": "没猜错的话你是猫又？那本冷门生物科普也介绍过，在第…嘶…"
        },
        {
          "role": "派蒙",
          "text": "这次也记得第几页吗？"
        },
        {
          "role": "布伦妮",
          "text": "（糟了，没记住。别看着我呀…）"
        },
        {
          "role": "布伦妮",
          "text": "总之我送你毛线球当赔礼吧？"
        },
        {
          "role": "绮良良",
          "text": "毛线球！呃…不用不用，只是刚被惊醒还没反应过来而已，没那么夸张啦。"
        },
        {
          "role": "绮良良",
          "text": "这位小朋友懂的真多啊…"
        },
        {
          "role": "布伦妮",
          "text": "我不是小…哎，算了。"
        },
        {
          "role": "派蒙",
          "text": "说起来，绮良良有发现这附近有什么异常的地方吗？"
        },
        {
          "role": "绮良良",
          "text": "要说异常的话…我平时习惯在那棵树下打盹，今天不知怎么的，睡得很不舒服，所以才爬到这棵树上睡。"
        },
        {
          "role": "布伦妮",
          "text": "你们聊，我去看看！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（可莉&瑶瑶&七七&早柚&绮良良）"
        },
        {
          "role": "早柚",
          "text": "猫又姐姐，还有其他适合偷懒睡觉的地点推荐吗？"
        },
        {
          "role": "绮良良",
          "text": "这个嘛…有时候是纸箱，有时候是奶奶的腿上…"
        },
        {
          "role": "可莉",
          "text": "大猫猫姐姐，我认识一个小猫猫姐姐{{#info:[[迪奥娜]]|info}}，她只有一根尾巴，长大后会跟你一样有两根尾巴吗？"
        },
        {
          "role": "绮良良",
          "text": "应该不会吧…除非她也是猫又一族的妖怪。"
        },
        {
          "role": "七七",
          "text": "姐姐，妖怪和妖邪有什么区别？"
        },
        {
          "role": "绮良良",
          "text": "呃…妖邪是什么？"
        },
        {
          "role": "瑶瑶",
          "text": "我猜是好妖和坏妖的区别。就像好人和坏人那样。"
        },
        {
          "role": "派蒙",
          "text": "没错没错。绮良良跟面团大王一样都是很好的妖怪。"
        },
        {
          "type": "subtitle",
          "text": "与布伦妮对话，查看情况"
        },
        {
          "role": "布伦妮",
          "text": "果然，这里真的有噩梦碎片！"
        },
        {
          "role": "布伦妮",
          "text": "先收起来吧，我们乘胜追击，赶紧去下一处地方找吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好，我们立刻出发。",
              "dialogues": [
                {
                  "role": "布伦妮",
                  "text": "嗯。下一个地方在绀田村东边…路线我记住了，出发。"
                }
              ]
            },
            {
              "text": "越急越容易出错，歇一会再出发吧。",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "再次对话",
                  "narration": true,
                  "color": "灰"
                },
                {
                  "role": "布伦妮",
                  "text": "我们赶紧乘胜追击，去下一处地方找吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找噩梦碎片"
        },
        {
          "role": "布伦妮",
          "text": "好，有了前面的经验，这次大家分工应该很明确了吧。"
        },
        {
          "role": "布伦妮",
          "text": "我们先各自在附近调查，有情况就大声通知大家，明白吗？"
        },
        {
          "role": "可莉&瑶瑶&早柚&派蒙&旅行者",
          "text": "明白！"
        },
        {
          "role": "七七",
          "text": "明白。"
        },
        {
          "role": "布伦妮",
          "text": "你、你怎么也跟着她们一起喊啊…解散。"
        },
        {
          "type": "subtitle",
          "text": "调查可疑地点"
        },
        {
          "type": "subtitle",
          "text": "气泡文字（可莉）"
        },
        {
          "role": "可莉",
          "text": "嘟嘟可有新发现吗？"
        },
        {
          "role": "可莉",
          "text": "唔…没有。"
        },
        {
          "role": "可莉",
          "text": "也没有。好想炸开地面看看…"
        },
        {
          "role": "可莉",
          "text": "不行不行，可莉要当乖孩子。"
        },
        {
          "role": "可莉",
          "text": "这里也没有哦。"
        },
        {
          "role": "可莉",
          "text": "但可莉不会放弃！冲呀！"
        },
        {
          "role": "可莉",
          "text": "嘟嘟可有新发现吗？"
        },
        {
          "role": "可莉",
          "text": "可莉来帮忙！"
        },
        {
          "type": "subtitle",
          "text": "气泡文字（早柚&布伦妮）"
        },
        {
          "role": "早柚",
          "text": "不要在这里睡着啊早柚…"
        },
        {
          "role": "早柚",
          "text": "困…不能睡！我要帮上忙！"
        },
        {
          "role": "早柚",
          "text": "先活动活动清醒一下吧。"
        },
        {
          "role": "布伦妮",
          "text": "一眼看去没有什么异常…"
        },
        {
          "role": "布伦妮",
          "text": "先分析地理环境。"
        },
        {
          "role": "布伦妮",
          "text": "很好，什么都没分析出来…"
        },
        {
          "role": "布伦妮",
          "text": "停停停早柚，我眼睛要花了…"
        },
        {
          "role": "早柚",
          "text": "哈！精神多了！"
        },
        {
          "role": "早柚",
          "text": "你有什么发现没？"
        },
        {
          "role": "布伦妮",
          "text": "咳！还、还没呢…一起找吧？"
        },
        {
          "role": "早柚",
          "text": "噩梦碎片不该到梦里找吗？"
        },
        {
          "role": "布伦妮",
          "text": "一定有不对劲的地方…"
        },
        {
          "type": "subtitle",
          "text": "气泡文字（瑶瑶&七七）"
        },
        {
          "role": "瑶瑶",
          "text": "这边没有，去那边看看！"
        },
        {
          "role": "七七",
          "text": "好。"
        },
        {
          "role": "七七",
          "text": "碎片。碎片。有了。"
        },
        {
          "role": "瑶瑶",
          "text": "真的吗？我看看！"
        },
        {
          "role": "七七",
          "text": "石头的碎片可以吗？"
        },
        {
          "role": "瑶瑶",
          "text": "不太对哦，我们去那边找找看吧！"
        },
        {
          "role": "七七",
          "text": "……"
        },
        {
          "role": "瑶瑶",
          "text": "这是…"
        },
        {
          "role": "七七",
          "text": "这里的草。想采回去给白先生。"
        },
        {
          "role": "七七",
          "text": "也许可以做药材。"
        },
        {
          "role": "瑶瑶",
          "text": "有道理欸，放我背篓里吧！"
        },
        {
          "role": "瑶瑶",
          "text": "好了，走吧。"
        },
        {
          "role": "瑶瑶",
          "text": "没有…但没关系，会找到的！"
        },
        {
          "role": "七七",
          "text": "瑶瑶，重不重？"
        },
        {
          "role": "七七",
          "text": "背篓换我背一会吧。"
        },
        {
          "role": "瑶瑶",
          "text": "不重，我背着就行，谢谢七七。"
        },
        {
          "role": "七七",
          "text": "找碎片…"
        },
        {
          "role": "瑶瑶",
          "text": "七七跟紧我哦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调查",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哇有摩拉！快捡！"
        },
        {
          "type": "subtitle",
          "text": "获得{{图标|摩拉|1000}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "调查",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "什么嘛，只是堇瓜而已…"
        },
        {
          "type": "subtitle",
          "text": "出现{{图标|堇瓜|2}}",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "查看小魔女们的新发现"
        },
        {
          "role": "可莉",
          "text": "荣誉骑士哥哥，小派蒙，布伦妮姐姐，快过来——"
        },
        {
          "role": "派蒙",
          "text": "来啦——有什么发现吗？"
        },
        {
          "role": "可莉",
          "text": "大发现！是虫虫排大队！可莉没见过！"
        },
        {
          "role": "七七",
          "text": "我也没见过。哇…"
        },
        {
          "role": "早柚",
          "text": "这是鬼兜虫，在稻妻很常见。"
        },
        {
          "role": "瑶瑶",
          "text": "我在师父的小花园里见过蚂蚁搬家，它们也在搬家吗？但怎么不拿行李？"
        },
        {
          "role": "布伦妮",
          "text": "奇怪，鬼兜虫习惯昼伏夜出，为了躲避天敌，白天它们应该潜伏在草丛或者石缝这些阴凉的地方才对。"
        },
        {
          "role": "可莉",
          "text": "布伦妮姐姐懂好多！"
        },
        {
          "role": "布伦妮",
          "text": "咳咳。鬼兜虫依赖树汁和野果为生，夜晚才是它们的活跃期，所以晚上碰见它们的概率会更高。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "学到了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "荒泷一斗",
          "text": "学到了！"
        },
        {
          "role": "派蒙",
          "text": "放牛的！你怎么在这？"
        },
        {
          "role": "荒泷一斗",
          "text": "矮堇瓜，又见面了！本大爷当然是在寻找更大更强的鬼兜虫啊！强者永远在进步的路上！倒是你们，在这里干什么？"
        },
        {
          "role": "荒泷一斗",
          "text": "哟？好多新的小堇瓜。我懂了——"
        },
        {
          "role": "荒泷一斗",
          "text": "你们在玩过家家！哈哈，本大爷正好有空，要不要我陪你们玩？"
        },
        {
          "role": "可莉",
          "text": "大块头叔叔，你可以演长角的大魔王。"
        },
        {
          "role": "荒泷一斗",
          "text": "叫哥哥！是帅气的大哥哥！"
        },
        {
          "role": "早柚",
          "text": "大家快躲起来，保护好脑袋！被这个很吵的家伙摸了头就长不高啦！"
        },
        {
          "role": "派蒙",
          "text": "你们快跑！我来牵制住他！放牛的，先过了我这关再说！"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈，有意思。飞行矮堇瓜很嚣张嘛，信不信本大爷先摸你的头！"
        },
        {
          "role": "派蒙",
          "text": "哼哼，小魔女派蒙对放牛的使用咒语：摸一次头，你的口袋就少一万摩拉！"
        },
        {
          "role": "荒泷一斗",
          "text": "哈哈哈哈哈哈，本大爷口袋里从来就没有超过500摩拉！"
        },
        {
          "role": "派蒙",
          "text": "可恶，失算了。跑！"
        },
        {
          "role": "荒泷一斗",
          "text": "慢点跑小堇瓜们，别摔跤了。本大爷数到十再来找你们——"
        },
        {
          "role": "荒泷一斗",
          "text": "一…二…三四五六七八九十！哈哈！"
        },
        {
          "role": "布伦妮",
          "text": "……？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别见怪，小朋友爱玩很正常。",
              "dialogues": []
            },
            {
              "text": "我这位大朋友恰巧很有童心。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "啊，我想到了！"
        },
        {
          "role": "布伦妮",
          "text": "鬼兜虫反常的行为就是一种提示。除非原来的栖息地出了问题，否则没理由冒险在白天迁移。"
        },
        {
          "role": "布伦妮",
          "text": "倒推一下，只要沿着它们出走的路线往前找…"
        },
        {
          "role": "布伦妮",
          "text": "这里真的有噩梦碎片！我们赶紧捡起来吧。"
        },
        {
          "role": "布伦妮",
          "text": "这样一来，就只剩下一枚碎片了，胜利在望。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这一枚又是布伦妮找到的呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "别调侃我了…多亏小魔女们发现了这些鬼兜虫，其实立功的是她们。"
        },
        {
          "role": "布伦妮",
          "text": "只有小孩子才会被小虫子吸引住吧。换作是我，还不一定能注意到…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "所以用小孩子的角度看世界…",
              "dialogues": []
            },
            {
              "text": "会有意外收获哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "再、再说吧！先把正事做完。要不要把小魔女们喊回来？该去下一个地方了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你也习惯了跟她们一起行动了吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布伦妮",
          "text": "总不能把她们留在这里玩吧，那个大高个一看就不靠谱。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好啦，我把她们叫回来就出发！",
              "dialogues": [
                {
                  "role": "布伦妮",
                  "text": "我看看…就只剩下绀田村北边的沙滩了…出发！"
                }
              ]
            },
            {
              "text": "让她们玩好再出发吧，我看着呢。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "选择「让她们玩好再出发吧，我看着呢。」"
        },
        {
          "type": "subtitle",
          "text": "与布伦妮对话，查看情况"
        },
        {
          "type": "subtitle",
          "text": "额外对话（荒泷一斗）"
        },
        {
          "role": "荒泷一斗",
          "text": "你看见她们了吗？奇怪，这群小堇瓜居然比鬼兜虫还难找！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（可莉）"
        },
        {
          "role": "可莉",
          "text": "如果长角大魔王找过来，可莉就把他炸飞！"
        },
        {
          "role": "派蒙",
          "text": "不至于不至于…他其实不坏。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（七七&瑶瑶）"
        },
        {
          "role": "七七",
          "text": "七七不怕长不高。瑶瑶，站我身后，我保护你。"
        },
        {
          "role": "瑶瑶",
          "text": "不行，我们一定会一起长高长大。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（早柚）"
        },
        {
          "role": "早柚",
          "text": "看不见我。看不见我。"
        },
        {
          "role": "布伦妮",
          "text": "我观察了好一会，大高个比她们还像个小孩，他光长个吗？"
        },
        {
          "role": "布伦妮",
          "text": "其实他只要站在高处看看就能发现她们几个…咳。我没说想玩，要出发了就叫我吧！我看书去了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那现在就出发吧！",
              "dialogues": [
                {
                  "role": "布伦妮",
                  "text": "好、好。我看看…就只剩下绀田村北边的沙滩了…出发！"
                }
              ]
            },
            {
              "text": "玩尽兴了再出发！",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "寻找噩梦碎片"
        },
        {
          "role": "派蒙",
          "text": "最后一个地方了，要从哪里找起才好呢…"
        },
        {
          "role": "派蒙",
          "text": "太明显了吧！都已经引来一堆魔物了呀！"
        },
        {
          "role": "布伦妮",
          "text": "只是几只史莱姆。你们退后，我来对付它们。"
        },
        {
          "role": "可莉",
          "text": "小魔女们，我们一起帮布伦妮姐姐！"
        },
        {
          "role": "派蒙",
          "text": "好！加油！我负责在旁边给你们加油打气。"
        },
        {
          "role": "派蒙",
          "text": "别小看拉拉队的作用啊，我们经历过很多艰难的战斗，场外的支持都是非常非常重要的一环！"
        },
        {
          "role": "派蒙",
          "text": "甚至可以说是制胜关键！你说对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没错！看来一场苦战无可避免…",
              "dialogues": []
            },
            {
              "text": "我来当安全员，大家放手去干！",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "击败魔物"
        },
        {
          "type": "subtitle",
          "text": "气泡文字"
        },
        {
          "role": "派蒙",
          "text": "加油！加油！"
        },
        {
          "role": "派蒙",
          "text": "太厉害啦！"
        },
        {
          "role": "旅行者",
          "text": "压倒性的优势！"
        },
        {
          "role": "旅行者",
          "text": "完美的配合！"
        },
        {
          "role": "派蒙",
          "text": "加油，加油！可莉，使用蹦蹦炸弹！"
        },
        {
          "role": "派蒙",
          "text": "早柚把它们耍得团团转吧！月桂快给它们点颜色看看！"
        },
        {
          "role": "派蒙",
          "text": "干得好呀七七！让大家元气大恢复！"
        },
        {
          "role": "布伦妮",
          "text": "（没想到她们战斗力这么强…得认真研究应对方案才行。）"
        },
        {
          "role": "派蒙",
          "text": "就是这样布伦妮，给它们一锤！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|大型水史莱姆}}'''咕噜咕噜大王'''",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|小|大型雷史莱姆}}'''噼里啪啦大王'''",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "战斗胜利，回收噩梦碎片"
        },
        {
          "role": "派蒙",
          "text": "你们配合得真好！就这样嚯嚯嚯，再哈哈哈，然后唰唰唰就把魔物消灭了！"
        },
        {
          "role": "布伦妮",
          "text": "哈哈…你们几个还挺厉害的嘛。派蒙也不赖，嗓门很大。"
        },
        {
          "role": "可莉",
          "text": "因为我们是很了不起的小魔女噢。"
        },
        {
          "role": "早柚",
          "text": "打完架开始困了…"
        },
        {
          "role": "七七",
          "text": "饿了。"
        },
        {
          "role": "瑶瑶",
          "text": "留云阿姨说过天黑了不要在野外闲逛。这就是最后一枚碎片了吧，我们赶紧收好回去吧。"
        },
        {
          "type": "subtitle",
          "text": "返回秘密基地"
        },
        {
          "role": "可莉",
          "text": "爆米花，面团大王，我们回来了！"
        },
        {
          "role": "派蒙",
          "text": "哇…好多好吃的！是你给我们准备的吗？"
        },
        {
          "role": "面团大王",
          "text": "！"
        },
        {
          "type": "subtitle",
          "text": "大家一边享用美餐一边总结今日见闻，收集噩梦碎片的过程比预期中顺利，也比想象中更有趣，也许这正是小魔女们聚在一起的奇妙效果吧。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "瑶瑶",
          "text": "爆米花，我们跟面团大王约好了，明天就能让你恢复正常了！"
        },
        {
          "role": "早柚",
          "text": "而且小焰的噩梦被吃掉后，她也会好起来的，别担心。"
        },
        {
          "role": "面团大王",
          "text": "~"
        },
        {
          "role": "可莉",
          "text": "然后我们就帮爆米花找回小焰，大家一起玩！"
        },
        {
          "role": "七七",
          "text": "所有幻想朋友能出来一起玩，就更好了。"
        },
        {
          "role": "可莉",
          "text": "妈妈的魔法可以做到！"
        },
        {
          "role": "布伦妮",
          "text": "可莉有学过这种魔法吗？你会吗？"
        },
        {
          "role": "可莉",
          "text": "可莉只学了怎么给其他小魔女传递登场魔法，还没开始学别的魔法…"
        },
        {
          "role": "瑶瑶",
          "text": "这么说的话，师父、留云阿姨、理水叔叔他们也能做到！他们是神通广大的仙人，非常厉害哦。"
        },
        {
          "role": "早柚",
          "text": "那我的老师也能做到！伟大的忍者不会输！"
        },
        {
          "role": "派蒙",
          "text": "那！那…你能做到吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么想都做不到吧！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "也是哈。那——都是很了不起的前辈呢。"
        },
        {
          "role": "派蒙",
          "text": "嘻嘻，想象一下大家的幻想朋友齐聚一堂的画面…太有意思了吧！"
        },
        {
          "role": "七七",
          "text": "派蒙有没有幻想朋友？"
        },
        {
          "role": "派蒙",
          "text": "虽然我没有幻想朋友，但日常生活里有旅行者陪着我，什么都可以对他说，我已经觉得非常幸福了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
