{
  "quest_id": 24016,
  "chapter_num": null,
  "chapter_title": "资料整理学",
  "type": "iq",
  "route": "Science of Data Management",
  "stories": [
    {
      "story_id": 24016,
      "title": "资料整理学",
      "description": "沙尔梅似乎依然在资料院之中做着各类杂务…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与沙尔梅对话"
        },
        {
          "role": "沙尔梅",
          "text": "这样就差不多了…希望这些资料真能派上用场。"
        },
        {
          "role": "旅行者",
          "text": "你还在这里整理资料？"
        },
        {
          "role": "沙尔梅",
          "text": "哎呀，很高兴见到您，荣誉高级研究员。"
        },
        {
          "role": "沙尔梅",
          "text": "没错，按照雷蒙多先生的指示，我还在继续整理资料和卷宗呢…欸，我之前是不是说过一遍了？"
        },
        {
          "role": "派蒙",
          "text": "这地方这么大，就你一个人工作的话也太辛苦了，雷蒙多怎么都没派人来帮你呀。"
        },
        {
          "role": "沙尔梅",
          "text": "科学院现在诸事繁忙，分不出人来帮我也是情理之中。"
        },
        {
          "role": "旅行者",
          "text": "亏你还是「主任」呢…"
        },
        {
          "role": "沙尔梅",
          "text": "您是说「枫丹科学院文材回收组主任」这个头衔吗？唉，还请您别笑话我…"
        },
        {
          "role": "沙尔梅",
          "text": "我哪里是什么「主任」呀。从一开始，我就只是一个负责整理卷宗的普通职员。"
        },
        {
          "role": "沙尔梅",
          "text": "自从被雷蒙多先生指派来这里整理之后，就突然被告知，多了这么一个头衔。"
        },
        {
          "role": "沙尔梅",
          "text": "有人告诉我，这是舒瓦瑟尔先生的意见，说他觉得我们工作很辛苦，这么做主要是方便给我们多发点补贴…"
        },
        {
          "role": "沙尔梅",
          "text": "哎呀！您可别告诉别人，我…我怎么说出来了…"
        },
        {
          "role": "旅行者",
          "text": "我不会告诉别人的，放心。"
        },
        {
          "role": "派蒙",
          "text": "听起来像是好事呢。辛苦做了很多事的人，拿多一点报酬也没问题呀。"
        },
        {
          "role": "派蒙",
          "text": "不过，为什么要用这么绕的方法呢？直接把报酬发给大家不就好了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "在科学院，倒也正常。",
              "dialogues": []
            },
            {
              "text": "总之，只要能拿到手就好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "沙尔梅",
          "text": "唉，我是不能理解舒瓦瑟尔先生和雷蒙多先生在想什么呢…"
        },
        {
          "role": "沙尔梅",
          "text": "但无论如何，我都得继续工作才行，还有很多事要做。"
        },
        {
          "role": "沙尔梅",
          "text": "荣誉高级研究员，如果您愿意的话，能帮帮我吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "责无旁贷。",
              "dialogues": []
            },
            {
              "text": "就再给我的荣誉多添一笔吧！",
              "dialogues": [
                {
                  "role": "沙尔梅",
                  "text": "哈哈哈，没问题，我会给您的好心肠做证的。"
                }
              ]
            }
          ]
        },
        {
          "role": "沙尔梅",
          "text": "那么就请您帮我去清理一下周围的污渍吧。"
        },
        {
          "role": "沙尔梅",
          "text": "清理的时候，还请您尽量<color=#00E1FFFF>不要碰到旁边那些卷宗</color>。要是它们被污损的话，就糟糕了。"
        },
        {
          "role": "沙尔梅",
          "text": "那就拜托您啦，我还得继续在这里整理卷宗。唉，平时我怎么没觉得院里有这么多卷宗…"
        },
        {
          "type": "subtitle",
          "text": "清理污渍"
        },
        {
          "role": "沙尔梅",
          "text": "唉，平时我怎么没觉得院里有这么多卷宗…"
        },
        {
          "type": "subtitle",
          "text": "向沙尔梅回报"
        },
        {
          "role": "沙尔梅",
          "text": "呼…多谢您帮忙。要是没您帮忙，我都不知道要收拾到什么时候去了。"
        },
        {
          "role": "沙尔梅",
          "text": "真不愧是荣誉高级研究员，无论做什么事都这么利落。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我一向身手不凡。",
              "dialogues": []
            },
            {
              "text": "我对打扫略有心得。",
              "dialogues": [
                {
                  "role": "沙尔梅",
                  "text": "欸？那您还真是多才多艺。不愧是荣誉高级研究员！"
                }
              ]
            }
          ]
        },
        {
          "role": "沙尔梅",
          "text": "再次感谢您帮忙啦，荣誉高级研究员，这些东西请收下吧。"
        },
        {
          "role": "沙尔梅",
          "text": "呼…多谢您帮忙。要是没您帮忙，我都不知道要收拾到什么时候去了。"
        },
        {
          "role": "沙尔梅",
          "text": "不过，要是您帮忙时用的力度能小一点的话，就更好了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不好意思…",
              "dialogues": []
            },
            {
              "text": "我下次一定轻一点…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "沙尔梅",
          "text": "您别误会！我没有责怪的意思，这已经帮了我大忙了。"
        },
        {
          "role": "沙尔梅",
          "text": "这些东西给您，多谢您帮忙了，荣誉高级研究员。"
        }
      ]
    }
  ]
}