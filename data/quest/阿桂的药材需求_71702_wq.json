      "title": "阿桂的药材需求",
      "description": "璃月港的阿桂需要三份琉璃袋。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将三份琉璃袋交给阿桂"
        },
        {
          "role": "旅行者",
          "text": "关于琉璃袋…"
        },
        {
          "role": "阿桂",
          "text": "你是看到我的委托了吧。来得正及时，怎么样，三份琉璃袋搜集齐了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "搜集齐了。",
              "dialogues": []
            },
            {
              "text": "还没有…",
              "dialogues": [
                {
                  "role": "阿桂",
                  "text": "那你搜集齐了之后，就请快些带过来吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与阿桂对话"
        },
        {
          "role": "阿桂",
          "text": "我看看…嗯，这些琉璃袋的品质不错，应该够用了。"
        },
        {
          "role": "阿桂",
          "text": "这些东西给你，谢谢你帮我跑这么一趟。"
        }
      ]
    }
  ]
