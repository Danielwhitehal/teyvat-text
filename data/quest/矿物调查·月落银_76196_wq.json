  "chapter_title": "矿物调查·月落银",
  "type": "wq",
  "route": "Mineral Research: Moonfall Silver",
  "stories": [
    {
      "story_id": 76196,
      "title": "矿物调查·月落银",
      "description": "那夏镇的广场似乎在举办什么活动…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "（好像还没到开始的时间…）"
        },
        {
          "role": "旅行者",
          "text": "（等一会儿。）"
        },
        {
          "role": "？？？",
          "text": "等到了鉴赏大会开始的时间…"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点开启调查"
        },
        {
          "role": "莉奈娅",
          "text": "多洛妲！你怎么在这里？"
        },
        {
          "role": "多洛妲",
          "text": "莉奈娅，你来得正好！我刚才在向大家说明月落银的美妙之处呢。"
        },
        {
          "role": "多洛妲",
          "text": "月落银啊月落银，月下世界还有比你更完美的宝石吗？"
        },
        {
          "role": "多洛妲",
          "text": "看！无可挑剔的造型，珠圆玉润的感触！还有它那五彩斑斓的白，无与伦比的元素亲和力！"
        },
        {
          "role": "多洛妲",
          "text": "在我心目中，只有天上的月亮能与你媲美！"
        },
        {
          "role": "莉奈娅",
          "text": "月落银的确是很漂亮的矿石，我也收集了一些做标本。"
        },
        {
          "role": "多洛妲",
          "text": "对吧对吧！我就知道你会懂我的！"
        },
        {
          "role": "多洛妲",
          "text": "不过呢，最懂月落银的一定还是我！就算你是协会的顾问，这个第一的位置我也不会让给你的，哼哼。"
        },
        {
          "role": "多洛妲",
          "text": "对了，平时都是你来给冒险家讲课，今天就让我考考你吧。"
        },
        {
          "role": "多洛妲",
          "text": "我这儿有三颗月落银，非常遗憾，其中两颗有些细微的瑕疵，而另一颗则是我的珍藏，是月落银中的月落银！"
        },
        {
          "role": "多洛妲",
          "text": "你能够分辨出哪一颗才是最完美的月落银吗？"
        },
        {
          "role": "莉奈娅",
          "text": "让我看看…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "左边这个…",
              "dialogues": [
                {
                  "role": "莉奈娅",
                  "text": "（咦？露米这是在…）"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "就选这个了！",
                      "dialogues": []
                    },
                    {
                      "text": "我再想想…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "莉奈娅",
                  "text": "就选这个了！"
                },
                {
                  "role": "多洛妲",
                  "text": "莉奈娅也会有看走眼的时候呀，其实这颗在很不起眼的地方有一点点微小的瑕疵呢。"
                },
                {
                  "role": "莉奈娅",
                  "text": "唔，我认输了…不过下次，下次我可不会这么轻易输掉了！"
                },
                {
                  "role": "多洛妲",
                  "text": "好啊，随时奉陪！"
                },
                {
                  "role": "？？？",
                  "text": "顺势参加了多洛妲主办的月落银鉴赏大会，度过了一段愉快的时光…"
                },
                {
                  "role": "多洛妲",
                  "text": "没想到大家都这么热情，可惜像这样美好的时光总是转瞬即逝…差不多该收拾收拾了。"
                },
                {
                  "role": "莉奈娅",
                  "text": "我来帮你吧。"
                },
                {
                  "role": "多洛妲",
                  "text": "那太好了！"
                }
              ]
            },
            {
              "text": "中间这个…",
              "dialogues": [
                {
                  "role": "莉奈娅",
                  "text": "（露米好像很喜欢这个呢。）"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "就选这个了！",
                      "dialogues": []
                    },
                    {
                      "text": "我再想想…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "莉奈娅",
                  "text": "就选这个了！"
                },
                {
                  "role": "多洛妲",
                  "text": "啊，你也可以感受到吧！来自完美之物的不可抵抗的魅力…"
                }
              ]
            },
            {
              "text": "右边这个…",
              "dialogues": [
                {
                  "role": "莉奈娅",
                  "text": "（咦？露米这是在…）"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "就选这个了！",
                      "dialogues": []
                    },
                    {
                      "text": "我再想想…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "莉奈娅",
                  "text": "就选这个了！"
                },
                {
                  "role": "多洛妲",
                  "text": "莉奈娅也会有看走眼的时候呀，其实这颗在很不起眼的地方有一点点微小的瑕疵呢。"
                },
                {
                  "role": "莉奈娅",
                  "text": "唔，我认输了…不过下次，下次我可不会这么轻易输掉了！"
                },
                {
                  "role": "多洛妲",
                  "text": "好啊，随时奉陪！"
                }
              ]
            }
          ]
        },
        {
          "role": "莉奈娅",
          "text": "我再想想…"
        },
        {
          "type": "subtitle",
          "text": "与多洛妲对话"
        },
        {
          "role": "查看",
          "text": "「如果你也曾为月落银的七彩虹光而着迷，请加入我们，成为月落银同好会的一员吧！」"
        },
        {
          "type": "subtitle",
          "text": "回收展出用的月落银"
        },
        {
          "role": "旅行者",
          "text": "（附近似乎有些值得调查的，如果是对本地生态十分了解的<color=#FFCC33FF>莉奈娅</color>，或许会有所收获…）"
        },
        {
          "type": "subtitle",
          "text": "与多洛妲对话"
        },
        {
          "role": "多洛妲",
          "text": "如果是加工过的工艺品是不是会吸引更多人呢…"
        },
        {
          "role": "莉奈娅",
          "text": "你看看，应该没有遗漏吧？"
        },
        {
          "role": "多洛妲",
          "text": "嗯——没问题，不多也不少！"
        },
        {
          "role": "莉奈娅",
          "text": "我看到你用月落银在地上摆出了有趣的图案。"
        },
        {
          "role": "多洛妲",
          "text": "是呀！花费了不少心思呢，我觉得这样更能激起大家对于月落银的喜爱。"
        },
        {
          "role": "莉奈娅",
          "text": "说起来，我听说纳塔的民间故事里有这么一条…"
        },
        {
          "role": "莉奈娅",
          "text": "说的是原本住在星星上的少女坠落大地后，为了重返上天而在大地之上留下了巨大的涂鸦。"
        },
        {
          "role": "莉奈娅",
          "text": "之后，她在天上的太阳父亲果然看到了她的请求，将她带回了天上。"
        },
        {
          "role": "莉奈娅",
          "text": "说不定他也能看到多洛妲摆出的图案，就此成为月落银的粉丝呢！"
        },
        {
          "role": "多洛妲",
          "text": "哈哈哈！如果是这样，那我就是最了不起的月落银推广大使了！"
        },
        {
          "role": "多洛妲",
          "text": "不过比起那个，我还是更担心被天上的飞鸟盯上，你也知道，乌鸦之类的不是很喜欢亮晶晶的东西嘛。"
        },
        {
          "role": "莉奈娅",
          "text": "说得也是，而且除了乌鸦，也得小心地上的嗅嗅鼹鼠和盗宝鼬之类的。"
        },
        {
          "role": "多洛妲",
          "text": "还有露米！"
        },
        {
          "role": "莉奈娅",
          "text": "哈哈，对！还有露米！"
        },
        {
          "role": "露米",
          "text": "呀吼？"
        },
        {
          "role": "多洛妲",
          "text": "刚才谢谢你帮忙，虽然只是我收藏中的一小部分，这些就送给你了，就当是送给露米的吧！"
        },
        {
          "role": "莉奈娅",
          "text": "露米，今天真是个好日子呀！"
        },
        {
          "role": "露米",
          "text": "呀吼吼！"
        }
      ]
    }
  ]
}