{
  "quest_id": 72214,
  "chapter_num": null,
  "chapter_title": "寝子是只猫·神社食堂",
  "type": "wq",
  "route": "Neko Is a Cat: Shrine Canteen",
  "stories": [
    {
      "story_id": 72214,
      "title": "寝子是只猫·神社食堂",
      "description": "「浅濑神社代宫司」寝子似乎有事找你…",
      "dialogues": [
        {
          "role": "「寝子」",
          "text": "还真是…不可思议哪…"
        },
        {
          "role": "旅行者",
          "text": "雕像雕好了吗？"
        },
        {
          "role": "「寝子」",
          "text": "那个石头，一开始的时候，一点也不像奴家。但是，每次看到，都变得更像了一点。"
        },
        {
          "role": "「寝子」",
          "text": "汝等人类真是不可思议呢。"
        },
        {
          "role": "「寝子」",
          "text": "虽然很吵，但是奴家是代宫司大人，所以不会在意这种小事。"
        },
        {
          "role": "「寝子」",
          "text": "汝等帮奴家把这些鱼带过去给那个高高的人类吧。"
        },
        {
          "role": "「寝子」",
          "text": "这是好东西。就当做给他的…「抱愁」吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只有鱼吗？",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "唔喵，奴家也让「昆布丸」带着那群孩子们试着抓抓团雀什么的，但总是抓不到太多…"
                },
                {
                  "role": "「寝子」",
                  "text": "对那群孩子来说，还是抓鱼比较简单呢。"
                }
              ]
            },
            {
              "text": "是「报酬」吧。",
              "dialogues": [
                {
                  "role": "「寝子」",
                  "text": "喵喵喵，好烦。"
                },
                {
                  "role": "「寝子」",
                  "text": "快去交给他吧。这可是好东西。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "将鱼肉带给大岛纯平"
        },
        {
          "role": "大岛纯平",
          "text": "总算是有点样子了…"
        },
        {
          "role": "大岛纯平",
          "text": "哈哈，是你们啊，快看看这雕像，是不是有点代宫司大人的模样了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "确实有点模样了。",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "对吧？哈哈哈，不枉我连续好几天熬夜工作…"
                }
              ]
            },
            {
              "text": "雕像比寝子大很多。",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "那是当然啦，虽然代宫司大人比一般的猫也大很多…但是想要有气势的话，雕像的尺寸还得再进一步放大，毕竟是摆在神社里的雕像嘛。"
                }
              ]
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "哎呀，肚子也饿了…我得自己再去找点吃的了…"
        },
        {
          "role": "旅行者",
          "text": "这是寝子给你的鱼肉。"
        },
        {
          "role": "大岛纯平",
          "text": "唔…呃，谢谢代宫司大人的好意，但我还是…我还是自己去找吃的吧…"
        },
        {
          "role": "大岛纯平",
          "text": "我已经连续吃了好几天鱼肉了，实在是受不了了…"
        },
        {
          "role": "大岛纯平",
          "text": "我只能每天出去自己找吃的，运气好的时候能打到点团雀或者鸽子…"
        },
        {
          "role": "大岛纯平",
          "text": "唉，但是我还是想吃点兽肉啊，那种紧致的，多汁的兽肉…"
        },
        {
          "role": "大岛纯平",
          "text": "呃…旅行者…"
        },
        {
          "role": "大岛纯平",
          "text": "如果你们愿意的话，能请你帮我去找三份…兽肉来吗？"
        },
        {
          "role": "大岛纯平",
          "text": "我对捕猎实在是不在行，这么多天了也没弄到一份兽肉…只能拜托你们了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧…",
              "dialogues": []
            },
            {
              "text": "你为什么不回鸣神岛吃一顿？",
              "dialogues": [
                {
                  "role": "大岛纯平",
                  "text": "一方面是太远了，另一方面…我雕刻的手感正好，要是去鸣神岛的话…这一来一回的，手感说不定就没了。"
                },
                {
                  "role": "大岛纯平",
                  "text": "我还是就在这里迅速吃一顿，然后继续回去雕刻吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "大岛纯平",
          "text": "那就拜托你们了，只要三份兽肉就好。"
        },
        {
          "type": "subtitle",
          "text": "将三份兽肉带给大岛纯平"
        },
        {
          "type": "subtitle",
          "text": "将三份兽肉带给大岛纯平"
        },
        {
          "role": "大岛纯平",
          "text": "怎么样，你们拿到兽肉了吗？"
        },
        {
          "role": "大岛纯平",
          "text": "喔！这兽肉的品质…太感谢你们了！"
        },
        {
          "role": "大岛纯平",
          "text": "我等会就去好好做几道好菜！吃了这些肉，我肯定能雕得更快一点！"
        },
        {
          "role": "旅行者",
          "text": "这两件事之间有关系吗？"
        },
        {
          "role": "大岛纯平",
          "text": "吃了好肉，就有力气干活了嘛！之前总是吃鱼，我都感觉提锤子的手没什么力气了…"
        },
        {
          "role": "大岛纯平",
          "text": "我还在担心，一直这样的话，说不定整个雕像的工期都会延长…还好你帮我找了这些肉过来。"
        },
        {
          "role": "大岛纯平",
          "text": "毕竟是为人…呃，为猫工作嘛，延期这种事，能避免最好还是避免吧。"
        },
        {
          "role": "大岛纯平",
          "text": "总之，我会尽快做好这尊雕像的，代宫司大人说，那尊雕像做好了之后，一定会有什么好事发生。"
        },
        {
          "role": "大岛纯平",
          "text": "虽然不知道是什么好事，不过…嘿嘿，我还是挺期待的。"
        },
        {
          "role": "大岛纯平",
          "text": "过段时间，你们也要来神社看看我的作品啊。"
        }
      ]
    }
  ]
}