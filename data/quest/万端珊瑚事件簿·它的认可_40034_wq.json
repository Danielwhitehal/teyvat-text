{
  "quest_id": 40034,
  "chapter_num": null,
  "chapter_title": "万端珊瑚事件簿·它的认可",
  "type": "wq",
  "route": "Bantan Sango Case File: Recognition",
  "stories": [
    {
      "story_id": 40034,
      "title": "万端珊瑚事件簿·它的认可",
      "description": "探案似乎接近了尾声，真相应该就在前方…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往万端珊瑚侦探社"
        },
        {
          "role": "珊瑚",
          "text": "嗯，你们果然来了。"
        },
        {
          "role": "珊瑚",
          "text": "龙二的话，按照目前收集到的线索和我的推理，他已经去八酝岛调查了。"
        },
        {
          "role": "珊瑚",
          "text": "我把方位标记在你的地图上，如果你赶紧动身，应该还可以和他会合。"
        },
        {
          "role": "派蒙",
          "text": "怎么突然这么急急忙忙的，之前不还在侦探社等我们一起的吗？"
        },
        {
          "role": "珊瑚",
          "text": "因为已经接近尾声了。你们也快点动身，一同见证真相的浮现吧。"
        },
        {
          "role": "派蒙",
          "text": "这么一说，我也有点迫不及待了。我们快走吧，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "寻找龙二并与龙二对话"
        },
        {
          "role": "派蒙",
          "text": "龙二！我们来了！"
        },
        {
          "role": "龙二",
          "text": "啊，是你们。珊瑚社长让我先过来调查，说你们晚点就会过来。果然如此。"
        },
        {
          "role": "派蒙",
          "text": "还多亏了她告诉我们，你在这里呢！龙二调查得怎么样啦？"
        },
        {
          "role": "派蒙",
          "text": "咦，这里怎么都是些关着小动物的笼子，没有人吗？"
        },
        {
          "role": "龙二",
          "text": "刚刚走开了，是盗宝团。珊瑚社长告诉我，他们打算偷狗来训练成「寻宝犬」。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就像盗宝鼬？",
              "dialogues": [
                 {
          "role": "龙二",
          "text": "没错，就像盗宝鼬。只不过鼬因为太过调皮，不服管教，所以失败了。这次，他们就以更加忠心的「狗」为目标。"
        }
              ]
            },
            {
              "text": "就像派蒙？",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "喂！"
        }
              ]
            }
          ]
        },
        {
          "role": "龙二",
          "text": "以前处理过不少盗宝团的相关委托。这么一想，珊瑚社长说得果然没错。"
        },
        {
          "role": "龙二",
          "text": "就像人有脚印，组织也会留下自己独有的痕迹。整个事件中，虽然有着其他迷失、被困的小动物，但痕迹最终还是指向了盗宝团。"
        },
        {
          "role": "龙二",
          "text": "参考了一下当时的解决办法，然后我就调查到了这里。"
        },
        {
          "role": "龙二",
          "text": "不过居然不派个人留守，比起之前的案件，这次的作案者们心也太大了。"
        },
        {
          "role": "派蒙",
          "text": "嗯，真是一群心大的坏家伙！不过嘛，旅行者，你打了这么多天架也累了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "所以趁他们不在…",
            "我们偷偷把它们给救出来？"
          ]
        },
        {
          "role": "派蒙",
          "text": "没错，就这么办吧！嘿嘿，我们好默契哦！"
        },
         {
          "type": "subtitle",
          "text": "打开笼子"
        },
        {
          "role": "派蒙",
          "text": "奇怪，这只狗狗怎么不走？"
        },
        {
          "role": "派蒙",
          "text": "是病了吗？"
        },
         {
          "type": "subtitle",
          "text": "击败盗宝团"
        },
         {
          "type": "subtitle",
          "text": "奇怪的狗狗"
        },
        {
          "role": "影狼丸",
          "text": "……"
        },
        {
          "role": "影狼丸",
          "text": "汪呜！"
        },
        {
          "role": "派蒙",
          "text": "这、这是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "帽子狗。",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "才不是啦！这算什么外号啦！"
        }
              ]
            },
            {
              "text": "刀子狗。",
              "dialogues": [
                 {
          "role": "龙二",
          "text": "是帽子狗才对！"
        }
              ]
            },
            {
              "text": "黑影。",
              "dialogues": []
            }
          ]
        },
       
        {
          "role": "龙二",
          "text": "不管怎么说，好像没有攻击我们的意思…"
        },
        {
          "role": "影狼丸",
          "text": "汪汪——"
        },
        {
          "role": "派蒙",
          "text": "呜哇，它跑了。"
        },
        {
          "role": "龙二",
          "text": "边跑边回头看我们，或许是让我们跟上去的意思？"
        },
        {
          "role": "旅行者",
          "text": "我们快跟上吧。"
        },
        {
          "role": "龙二",
          "text": "嗯，说不定真相就在前面…或许就如同珊瑚社长预料的那样…"
        },
        {
          "type": "subtitle",
          "text": "跟上跑开的狗狗"
        },
        {
          "role": "派蒙",
          "text": "呼——终于追上了。"
        },
        {
          "role": "龙二",
          "text": "嗯？它面前的是…一封信？"
        },
        {
          "role": "龙二",
          "text": "我们先看看吧，这是目前唯一的线索了。"
        },
        {
          "role": "派蒙",
          "text": "嗯！让我看看，里面写的是什么……"
        },
        {
          "role": "派蒙",
          "text": "「致有缘…」呃，太破了看不清楚。"
        },
        {
          "role": "龙二",
          "text": "可能是「致有缘之人」吧。"
        },
        {
          "role": "派蒙",
          "text": "哦哦，然后是…「我们家是专门训练忍犬的世家，为忍者们带来了许许多多可靠的伙伴。」"
        },
        {
          "role": "派蒙",
          "text": "「……此番征兵令下来，怕是凶多吉少。我此生没什么遗憾，唯一放心不下的只有影狼丸。」"
        },
        {
          "role": "派蒙",
          "text": "「小时候，它太弱了，所以忍者们来进行契约的时候，它被剩了下来。但是没关系，身为训练师，我不会放弃任何一只狗。」"
        },
        {
          "role": "派蒙",
          "text": "「经过日复一日的努力，影狼丸真的变得越来越厉害了。只可惜，它完全不想和任何忍者契约。」"
        },
        {
          "role": "派蒙",
          "text": "「虽然战争还未开始，但奉行所的催促越来越急，我已无暇顾及其他，现在到了不得不离开的时候了。」"
        },
        {
          "role": "派蒙",
          "text": "「只好留下这一封信，若是日后有人能找到这里，请代替我照顾一下影狼丸。」"
        },
        {
          "role": "派蒙",
          "text": "「它脸上有一道疤痕，是年幼时留下的，气场也与其他普通狗狗不同，很好辨认。」"
        },
        {
          "role": "龙二",
          "text": "信里说的这只影狼丸应该就是…"
        },
        {
          "role": "旅行者",
          "text": "带我们来的这只。"
        },
        {
          "role": "派蒙",
          "text": "确实很好辨认呢！信上还有行内容，我看看…"
        },
        {
          "role": "派蒙",
          "text": "「我知道这是不情之请，但也实在没有别的办法。还有，若是今后它愿意契约了，能带着自己中意的人来到这里的话，那么契约方法是…」"
        },
        {
          "role": "派蒙",
          "text": "哎呀，最重要的地方怎么划掉了！"
        },
        {
          "role": "旅行者",
          "text": "大概是觉得不可能吧。"
        },
        {
          "role": "龙二",
          "text": "的确，毕竟一开始影狼丸完全不想和人契约。"
        },
        {
          "role": "影狼丸",
          "text": "汪汪——"
        },
        {
          "role": "派蒙",
          "text": "欸，它怎么又突然跑掉了，还往屋子里跑了。旅行者，快跟上吧。"
        },
        {
          "type": "subtitle",
          "text": "跟上再次跑开的影狼丸"
        },
        {
          "type": "subtitle",
          "text": "击败影狼丸"
        },

        {
          "type": "subtitle",
          "text": "与龙二对话"
        },

        {
          "role": "派蒙",
          "text": "呼，总算结束了。真是搞不懂，怎么突然就开始战斗了，明明影狼丸之前看起来还挺友好的，还好有旅行者在。"
        },
        {
          "role": "派蒙",
          "text": "咦，为什么影狼丸会跟着旅行者？"
        },
        {
          "role": "影狼丸",
          "text": "汪呜汪呜！"
        },
        {
          "role": "旅行者",
          "text": "这叫声好像听起来有点高兴？"
        },
        {
          "role": "派蒙",
          "text": "你怎么听出来的！我还一头雾水呢！"
        },
        {
          "role": "龙二",
          "text": "如果我的猜想没错的话，影狼丸应该已经成为旅行者的忍犬了。"
        },
        {
          "role": "派蒙",
          "text": "欸！"
        },
        {
          "role": "旅行者",
          "text": "欸！"
        },
        {
          "role": "龙二",
          "text": "关于忍犬的契约方法，我也只是略有耳闻罢了。据说忍者看中忍犬后，需要打败它，才能得到忍犬的认可。"
        },
        {
          "role": "龙二",
          "text": "忍者渴望强大的伙伴，忍犬也是一样的，只有互相认可，才能完成契约。看来确实是这样子。"
        },
        {
          "role": "派蒙",
          "text": "可是旅行者又不是忍者…而且…"
        },
        {
          "role": "派蒙",
          "text": "呜。"
        },
        {
          "role": "旅行者",
          "text": "派蒙怎么了？"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你先同意答应我一件事情！"
        },
        {
          "role": "旅行者",
          "text": "什么事情？"
        },
        {
          "role": "派蒙",
          "text": "你先说答应嘛！"
        },
        {
          "role": "旅行者",
          "text": "好吧，我答应你。"
        },
        {
          "role": "派蒙",
          "text": "就算你现在已经契约了影狼丸，你也不能忘记派蒙是你最最最好的伙伴哦！"
        },
        {
          "role": "旅行者",
          "text": "嗯，派蒙是我最好的伙伴。"
        },
        {
          "role": "派蒙",
          "text": "太好了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "比起猫和狗…",
            "还是派蒙更可靠。"
          ]
        },
        {
          "role": "派蒙",
          "text": "欸嘿嘿。我们永远都是最最最好的伙伴！"
        },
        {
          "role": "龙二",
          "text": "咳咳，两位关系真好…"
        },
        {
          "role": "龙二",
          "text": "不过话又说回来，既然影狼丸实力那么强，为什么之前那个人还要留信下来，让别人照顾它呢？"
        },
        {
          "role": "派蒙",
          "text": "这个我知道哦！旅行者，很强对吧。"
        },
        {
          "role": "龙二",
          "text": "确实实力超群。"
        },
        {
          "role": "派蒙",
          "text": "但是如果有一天，万一有什么意外，我不得不和旅行者分开，我也会很担心的。这和旅行者强不强，其实没什么关系啦。"
        },
        {
          "role": "派蒙",
          "text": "呸呸，我在说什么不吉利的事情！总之只是打个比方！我和旅行者是最好的伙伴，我们是不会分开的！"
        },
        {
          "role": "旅行者",
          "text": "派蒙…"
        },
        {
          "role": "龙二",
          "text": "派蒙的推理很合理。那么接下来唯一的问题是，为什么这只狗狗会偷走村民们的小动物，并守着呢？"
        },
        {
          "role": "派蒙",
          "text": "呃…唔…这个机智的派蒙也想不出来了。"
        },
        {
          "role": "派蒙",
          "text": "可惜，影狼丸也没办法说话，不然让旅行者去问问就知道了。"
        },
        {
          "role": "旅行者",
          "text": "我们去找找珊瑚吧。"
        },
        {
          "role": "派蒙",
          "text": "对哦，还有珊瑚！这个时候总该轮到头脑派出场了，我们去找她吧！"
        },
        {
          "role": "龙二",
          "text": "嗯，我先去把藏起来的小动物还回去，我们到时候侦探社汇合吧。"
        },
        {
          "type": "subtitle",
          "text": "向珊瑚回报"
        },
        {
          "role": "龙二",
          "text": "珊瑚社长，我们回来了，事情是这样子的……"
        },
        {
          "role": "珊瑚",
          "text": "原来如此。我大概知道为什么影狼丸会守着小动物了。"
        },
        {
          "role": "珊瑚",
          "text": "是想要带着其他小动物变强吧。"
        },
        {
          "role": "珊瑚",
          "text": "它小的时候很弱，然后又变强了，对吧。所以它就想通过训练，也带着别的小动物变强。"
        },
        {
          "role": "珊瑚",
          "text": "后来它看到愿意保护弱小的旅行者之后，又认可了旅行者作为主人。"
        },
        {
          "role": "珊瑚",
          "text": "这也是出于它对弱小的同情心。"
        },
        {
          "role": "珊瑚",
          "text": "不过这只是我通过线索进行的推理罢了。"
        },
        {
          "role": "珊瑚",
          "text": "至于真实情况嘛，应该也八九不离十了。但由于影狼丸不会说话，我们也没办法得到一个肯定的回答了。"
        },
        {
          "role": "派蒙",
          "text": "珊瑚说话也很有道理呢！不愧是头脑派。"
        },
        {
          "role": "影狼丸",
          "text": "汪汪汪！"
        },
        {
          "role": "派蒙",
          "text": "呜哇，你也是在肯定珊瑚说的话吗？"
        },
        {
          "role": "珊瑚",
          "text": "不要以为奉承我，下次你们有委托的时候我就会打折哦。不过呢，这个案子算是办结了。"
        },
        {
          "role": "龙二",
          "text": "感谢旅行者和派蒙，多亏了你们才能办结这个案子。"
        },
        {
          "role": "珊瑚",
          "text": "哦，差点忘了，「四方之网」你们用着感觉如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "挺好用的。",
            "总担心它会破掉…"
          ]
        },
        {
          "role": "珊瑚",
          "text": "嗯，我记下来了。我会和我的那位朋友说的，谢啦。"
        },
        {
          "role": "派蒙",
          "text": "不客气！以后有什么困难，随时来找我们哦！旅行者可厉害了！"
        },
        {
          "role": "珊瑚",
          "text": "旅行者确实实力不俗，但是不用和我说这些客套话，毕竟感情是真相的敌人。"
        }
      ]
    }
  ]
}