{
  "quest_id": 10169,
  "chapter_num": "蔷薇与铳枪 后日谈",
  "chapter_title": "两个铳枪手的凯旋",
  "type": "eq",
  "route": "The Two Musketeers' Triumph",
  "stories": [
    {
      "story_id": 40136,
      "title": "两个铳枪手的凯旋",
      "description": "今天是揭晓千灵映影节「芙宁娜」奖的日子，事不宜迟，去会场看看吧！",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待到两天后"
        },
        {
          "type": "subtitle",
          "text": "前往千灵映影节会场"
        },
        {
          "type": "subtitle",
          "text": "自那之后又过了一阵子…",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "影片顺利上映，铳枪杀人事件也正式结案…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "泽维尔！有一段时间没见到你了！"
        },
        {
          "role": "泽维尔",
          "text": "两位好，这不是，剪辑完成之后，我又开始着手于宣传与放映的工作了，实在忙不过来。"
        },
        {
          "role": "派蒙",
          "text": "今天就是颁奖的日子了吧？也不知道我们的映影能不能夺得「芙宁娜奖」。"
        },
        {
          "role": "芙宁娜",
          "text": "我倒是有九成的把握。"
        },
        {
          "role": "派蒙",
          "text": "芙宁娜！原来你已经到现场了呀，来得比其他人都早呢！"
        },
        {
          "role": "芙宁娜",
          "text": "其他人应该也很快就到。对了，泽维尔，说到领奖，你是不是该为我们的团队起个名字呀？"
        },
        {
          "role": "泽维尔",
          "text": "啊？可我还不知道能不能得奖…我、我可不敢做这种提前打开美酒的事啊…"
        },
        {
          "role": "芙宁娜",
          "text": "睁大眼睛，看看人们离开剧场的反应吧！没有一个不叫好的。"
        },
        {
          "role": "芙宁娜",
          "text": "你自己也知道吧？剧场的工作人员一定找过你，说要增加这部映影的放映次数。"
        },
        {
          "role": "芙宁娜",
          "text": "这次的票房回报，都够你开一家正经的映影公司了吧？"
        },
        {
          "role": "泽维尔",
          "text": "但这不是我一个人的功劳！是诸位好先生与好女士们共同的心血，绝不能由我一个人来取这个名字！"
        },
        {
          "role": "芙宁娜",
          "text": "总之你就好好想想吧，我相信大家会同意的。"
        },
        {
          "role": "泽维尔",
          "text": "好吧…但在那之前，旅行者和派蒙，可以麻烦您二位去一趟梅洛彼得堡吗？"
        },
        {
          "role": "派蒙",
          "text": "咦？可不是还有颁奖典礼吗？"
        },
        {
          "role": "泽维尔",
          "text": "我想请二位去找我们的女主角之一，夏沃蕾小姐来这边。"
        },
        {
          "role": "泽维尔",
          "text": "我最近都见不到她，也没机会通知她来参加今天的颁奖典礼。"
        },
        {
          "role": "泽维尔",
          "text": "但报纸上说，铳枪杀人案的犯人今天会由特巡队队长亲自押送至梅洛彼得堡…"
        },
        {
          "role": "派蒙",
          "text": "哦，原来是这样。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "举手之劳。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！泽维尔在这里等着就好，争取想出个好听的名字！"
        },
        {
          "role": "泽维尔",
          "text": "好，拜托二位了。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（泽维尔&芙宁娜）"
        },
        {
          "role": "泽维尔",
          "text": "真的能得奖吗…"
        },
        {
          "role": "芙宁娜",
          "text": "你就安心吧。我的眼光能有错？"
        },
        {
          "type": "subtitle",
          "text": "前往梅洛彼得堡找夏沃蕾"
        },
        {
          "role": "夏沃蕾",
          "text": "…押送程序结束。他们三个，接下来就交给你了。"
        },
        {
          "role": "莱欧斯利",
          "text": "看样子后边还有别的事？"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯，得去赶一场派对。"
        },
        {
          "role": "莱欧斯利",
          "text": "真少见，在培养新爱好吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "只是这场比较特殊。"
        },
        {
          "role": "派蒙",
          "text": "夏沃蕾，公爵！"
        },
        {
          "role": "莱欧斯利",
          "text": "过节就是好，连我这都变热闹了。"
        },
        {
          "role": "夏沃蕾",
          "text": "这就是千灵节。"
        },
        {
          "role": "莱欧斯利",
          "text": "是啊，护士长甚至准备了豪华版营养奶昔…健康程度也是豪华版的。"
        },
        {
          "role": "派蒙",
          "text": "你们刚才在聊工作吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "已经聊完了。我也向莱欧斯利先生打了「招呼」，对吗？"
        },
        {
          "role": "莱欧斯利",
          "text": "我没有明确回应哦。"
        },
        {
          "role": "夏沃蕾",
          "text": "但你也没拒绝。"
        },
        {
          "role": "夏沃蕾",
          "text": "我有个好主意，给他们每人发一份报纸吧，比如，一份头版印着一段二十年前往事的报纸。"
        },
        {
          "role": "莱欧斯利",
          "text": "那我猜有一个人要倒霉了。"
        },
        {
          "role": "夏沃蕾",
          "text": "我猜有两个人要被当成英雄了。"
        },
        {
          "role": "莱欧斯利",
          "text": "说到英雄，你们两位是有什么事要找我吗？"
        },
        {
          "role": "派蒙",
          "text": "哦，我们是来…"
        },
        {
          "role": "夏沃蕾",
          "text": "来邀请我去派对的，对吧？我可没忘记今天是什么日子。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，那我们赶快回去吧！"
        },
        {
          "role": "派蒙",
          "text": "公爵再见！千灵节快乐！"
        },
        {
          "role": "莱欧斯利",
          "text": "嗯，节日快乐。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（莱欧斯利）"
        },
        {
          "role": "莱欧斯利",
          "text": "去享受节日吧。"
        },
        {
          "type": "subtitle",
          "text": "返回千灵映影节会场"
        },
        {
          "role": "会场主持人",
          "text": "我宣布，获得首届千灵映影节「芙宁娜」奖的影片是——"
        },
        {
          "role": "会场主持人",
          "text": "《两个铳枪手》！"
        },
        {
          "role": "派蒙",
          "text": "是我们耶！真的是我们耶！"
        },
        {
          "role": "神里绫华",
          "text": "恭喜你，泽维尔先生。"
        },
        {
          "role": "泽维尔",
          "text": "天哪，我…我…真是太谢谢各位了！"
        },
        {
          "role": "芙宁娜",
          "text": "我对枫丹娱乐界的判断从不出错。"
        },
        {
          "role": "会场主持人",
          "text": "现在有请《两个铳枪手》的制片人，泽维尔先生，上台领奖！"
        },
        {
          "role": "泽维尔",
          "text": "谢谢…非常感谢大家对我们影片的认可。我在此，要特别感谢——"
        },
        {
          "role": "夏沃蕾",
          "text": "时间过得真快。"
        },
        {
          "role": "神里绫华",
          "text": "嗯，就好像夏沃蕾你教我握枪只是几天前的事一样。"
        },
        {
          "role": "夏沃蕾",
          "text": "还会来枫丹吗？"
        },
        {
          "role": "神里绫华",
          "text": "当然！我喜欢这个城市，新奇的东西看都看不过来。"
        },
        {
          "role": "神里绫华",
          "text": "夏沃蕾会来稻妻吗？"
        },
        {
          "role": "夏沃蕾",
          "text": "…以前从没有过这个打算。不过，现在可以考虑一下。"
        },
        {
          "role": "神里绫华",
          "text": "我期待你的到来。到时候，还想邀请你来家里做客，给你尝尝我们家的茶点。"
        },
        {
          "role": "夏沃蕾",
          "text": "嗯，保持联系。"
        },
        {
          "role": "千织",
          "text": "如你所愿？"
        },
        {
          "role": "神里绫人",
          "text": "你也该回稻妻看看了。"
        },
        {
          "role": "千织",
          "text": "「小仓屋」怎么样？"
        },
        {
          "role": "神里绫人",
          "text": "一切都好。"
        },
        {
          "role": "千织",
          "text": "代我向她问好。"
        },
        {
          "role": "神里绫人",
          "text": "我会的。"
        },
        {
          "role": "千织",
          "text": "听说岛上不下雷暴了。"
        },
        {
          "role": "神里绫人",
          "text": "也不打仗了。和平安治。"
        },
        {
          "role": "千织",
          "text": "听起来真好，是适合晒布料的天气。"
        },
        {
          "role": "泽维尔",
          "text": "——再次感谢我提到的所有人。是你们带我走上了领奖台，是你们铸就了这部映影。"
        },
        {
          "role": "泽维尔",
          "text": "另外，经过团队成员的一致认可，我正式将泽维尔剧组，命名为「铳枪影业」！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，这么喊出来还真帅气！"
        },
        {
          "role": "会场主持人",
          "text": "那么，下面就有请「铳枪影业」的所有成员，上台合影！"
        },
        {
          "role": "派蒙",
          "text": "哦！还有合影环节！"
        },
        {
          "role": "泽维尔",
          "text": "芙宁娜导演，我认为，你才是应该举起这个奖杯的人。"
        },
        {
          "role": "芙宁娜",
          "text": "欸？不、不要啦…好丢人的…"
        },
        {
          "role": "夏沃蕾",
          "text": "没人比导演您更合适。"
        },
        {
          "role": "神里绫华",
          "text": "当之无愧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "非你莫属。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "千织",
          "text": "你就认命吧。"
        },
        {
          "role": "会场主持人",
          "text": "准备好了吗？三、二、一…"
        },
        {
          "role": "众人",
          "text": "铳枪影业！！"
        },
        {
          "role": "[[File",
          "text": "活动任务-两个铳枪手的凯旋-cg.png|center]]"
        },
        {
          "type": "subtitle",
          "text": "额外对话（泽维尔&芙宁娜）"
        },
        {
          "role": "泽维尔",
          "text": "芙宁娜大人，请容许我再为您拍摄一张画片吧！我还想要您的签名…作为我们本次合作的留念。"
        },
        {
          "role": "芙宁娜",
          "text": "领奖的时候我可是已经被闪烁的留影机拍够了。"
        },
        {
          "role": "泽维尔",
          "text": "噢…芙宁娜大人，我见过的最好的导演！最上镜的人！您正适合这样热闹又喜庆的场面，我相信所有的摄影师都是这么想的。"
        },
        {
          "role": "泽维尔",
          "text": "来吧，亲爱的大明星，展现！展现您的光芒，留影机正在翘首以待呢！"
        },
        {
          "role": "芙宁娜",
          "text": "就算你把我夸成这个样子…"
        },
        {
          "role": "芙宁娜",
          "text": "唉…好吧，我就勉为其难再摆几个不一样的姿势好了。"
        },
        {
          "role": "芙宁娜",
          "text": "奖杯总可以不拿着吧？"
        },
        {
          "role": "泽维尔",
          "text": "啊…啊！当然！您想怎么来就怎么来！"
        },
        {
          "role": "泽维尔",
          "text": "万分感谢，万分感谢！天啊，我的运气真是好得让我自己都惊讶了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（夏沃蕾&宵宫）"
        },
        {
          "role": "夏沃蕾",
          "text": "宵宫小姐，之前没找到机会说。这几天的事，我很感谢你。"
        },
        {
          "role": "宵宫",
          "text": "欸？我不记得我做了什么特别的事呀。"
        },
        {
          "role": "夏沃蕾",
          "text": "最后那场特殊的演出，我很感谢你的配合。"
        },
        {
          "role": "夏沃蕾",
          "text": "我明白。跟莫里斯单独接触…多少是有些风险的。"
        },
        {
          "role": "夏沃蕾",
          "text": "你并不像我们特巡队，没有经过专业训练…"
        },
        {
          "role": "宵宫",
          "text": "别这么说。我是导演助理，当然就该为剧组里的所有事情出力！能帮夏沃蕾破案，我还觉得荣幸呢。"
        },
        {
          "role": "宵宫",
          "text": "虽然…那时候躺在地上，心跳声是扑通扑通响了好一阵子，我都怕被听出来呢，嘿嘿。"
        },
        {
          "role": "夏沃蕾",
          "text": "你做得很好。"
        },
        {
          "role": "宵宫",
          "text": "对了！如果你要来稻妻的话，记得来长野原烟花店找我哦，我给你做烟花。造型都想好了呢！"
        },
        {
          "role": "夏沃蕾",
          "text": "铳枪？"
        },
        {
          "role": "宵宫",
          "text": "嘿嘿，现在可不告诉你。想知道的话，就亲眼来稻妻看吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（神里绫人）"
        },
        {
          "type": "subtitle",
          "text": "神里绫人在露泽咖啡厅",
          "narration": true
        },
        {
          "role": "神里绫人",
          "text": "没想到会在这里碰见你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于你正在喝的东西…",
              "dialogues": [
                {
                  "role": "神里绫人",
                  "text": "哦，这种叫做「枫达」的饮料，口感新颖，我很喜欢。"
                },
                {
                  "role": "神里绫人",
                  "text": "「畅饮世界」的宣传语也不错，有点想把它也列做「文化交流」的项目之一了。"
                },
                {
                  "role": "神里绫人",
                  "text": "如果往「枫达」里加一些薄荷会怎么样呢？我很在意。"
                },
                {
                  "role": "神里绫人",
                  "text": "不如再勇敢一些，往「枫达」里兑等比例的什锦奶茶…"
                },
                {
                  "role": "神里绫人",
                  "text": "呵呵，感觉并不会好喝呢。"
                }
              ]
            },
            {
              "text": "关于映影…",
              "dialogues": [
                {
                  "role": "神里绫人",
                  "text": "多亏你们，映影顺利上映，社奉行也同沫芒宫达成了合作。"
                },
                {
                  "role": "神里绫人",
                  "text": "如果下次还有机会的话，我是不是真的该尝试担任一部电影的主演呢？"
                },
                {
                  "role": "神里绫人",
                  "text": "还是说…在你看来，「反派」这类角色要更适合我？"
                }
              ]
            },
            {
              "text": "希望回程顺利。",
              "dialogues": [
                {
                  "role": "神里绫人",
                  "text": "谢谢，我会照顾好绫华和宵宫她们的。"
                },
                {
                  "role": "神里绫人",
                  "text": "也愿你今后的旅途顺利。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（千织）"
        },
        {
          "type": "subtitle",
          "text": "千织在「千织屋」，凯瑟琳那条街的另一头",
          "narration": true
        },
        {
          "role": "千织",
          "text": "是你们，有什么事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「千织屋」…",
              "dialogues": [
                {
                  "role": "千织",
                  "text": "想要定制服务吗？随时欢迎。"
                },
                {
                  "role": "千织",
                  "text": "托你们的福，映影也如期上映，我的品牌能被更多人看到。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "我们也没做什么…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "千织",
                  "text": "别那么谦虚，你帮了泽维尔、帮了夏沃蕾、绮良良也说她之前受你们照顾…他们都是我朋友。"
                },
                {
                  "role": "千织",
                  "text": "你们所做的，远比你们所认为的多。"
                }
              ]
            },
            {
              "text": "关于千织的工作…",
              "dialogues": [
                {
                  "role": "千织",
                  "text": "我就是个服装设计师而已，没什么奇怪的副业。"
                },
                {
                  "role": "千织",
                  "text": "只不过做生意的缘故，结交的朋友越来越多，遇到的破事也越来越多。"
                },
                {
                  "role": "千织",
                  "text": "你帮我一个忙，我帮你一个忙…今天你照顾我，明天我照顾你…这就是生意。"
                }
              ]
            },
            {
              "text": "关于映影…",
              "dialogues": [
                {
                  "role": "千织",
                  "text": "夺得了「芙宁娜」奖，泽维尔可要高兴坏了。说不定下次真会在喷泉里找到他。"
                },
                {
                  "role": "千织",
                  "text": "来找我定制服装的人也越来越多，店里的人手都不够了。"
                },
                {
                  "role": "千织",
                  "text": "这么一来，我的梦想…或许又近了一步…"
                },
                {
                  "role": "千织",
                  "text": "不论如何，「千织屋」永远欢迎你们。不久后的枫丹时装周，也请你们多多捧场。"
                }
              ]
            },
            {
              "text": "没什么事了…",
              "dialogues": [
                {
                  "role": "千织",
                  "text": "嗯，回头见。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（神里绫华）"
        },
        {
          "type": "subtitle",
          "text": "神里绫华在「冰风组曲」东侧看台",
          "narration": true
        },
        {
          "role": "神里绫华",
          "text": "映影终于成功拍完了，我很高兴。这段时间…也承蒙你的关照。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "绫华的演技很出色。",
              "dialogues": [
                {
                  "role": "神里绫华",
                  "text": "欸？谢谢…"
                },
                {
                  "role": "神里绫华",
                  "text": "一开始，我抱着不能拖大家后腿的心情努力，想着如果是因为我的原因喊「停」就太丢人了。"
                },
                {
                  "role": "神里绫华",
                  "text": "芙宁娜导演既专业又耐心，夏沃蕾和埃兰小姐也给了我很多细节上的帮助…这才渐渐得心应手起来。"
                },
                {
                  "role": "神里绫华",
                  "text": "虽然这么说，但到了最后，大家…包括你也在夸奖我，我心里还是会有些不好意思的…"
                }
              ]
            },
            {
              "text": "最近玩得开心吗？",
              "dialogues": [
                {
                  "role": "神里绫华",
                  "text": "嗯，空下来的时候，我和宵宫一起逛了枫丹廷很多地方。"
                },
                {
                  "role": "神里绫华",
                  "text": "优雅的街景，美丽的绿植与花卉，还有像身处梦中一般的海底世界…留下了闪闪发光的回忆。"
                },
                {
                  "role": "神里绫华",
                  "text": "一想到在不久之前，或许你也曾恰好走过这些地方…就有些开心。"
                }
              ]
            },
            {
              "text": "绫华也辛苦了。",
              "dialogues": [
                {
                  "role": "神里绫华",
                  "text": "哪里。我平时…不太容易得到这样出门的机会。"
                },
                {
                  "role": "神里绫华",
                  "text": "这次不仅交到了新朋友，还跟着大家学到了不少东西，非常有收获。我很珍惜。"
                },
                {
                  "role": "神里绫华",
                  "text": "啊，对了，我还给社奉行的大家带了晶螺糕作为伴手礼。"
                },
                {
                  "role": "神里绫华",
                  "text": "配着咖啡喝，呵呵…说不定就和现在在枫丹的感觉一样呢。"
                }
              ]
            },
            {
              "text": "回去路上慢点。",
              "dialogues": [
                {
                  "role": "神里绫华",
                  "text": "嗯，谢谢你的关心，你在冒险途中也要照顾好自己哦。"
                },
                {
                  "role": "神里绫华",
                  "text": "有机会的话…我们稻妻再见。"
                }
              ]
            }
          ]
        }
