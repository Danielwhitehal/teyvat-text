{
  "quest_id": 20103,
  "chapter_num": null,
  "chapter_title": "诗歌交流",
  "type": "iq",
  "route": "Poetry Exchange",
  "stories": [
    {
      "story_id": 20103,
      "title": "诗歌交流",
      "description": "艾拉·马斯克又想出了一个和丘丘人交流的新方法。她正在寻找一个人，来帮助她进行这次的实践…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与艾拉·马斯克对话"
        },
        {
          "role": "艾拉·马斯克",
          "text": "又见面啦，你还记得我吗？忘了的话…你总记得上次我们和丘丘人进行的那些「友好交流」吧。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "唔，别这么看着我嘛，语言学习这种事情，就是要不断的练习才行啦。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "你放心，我可没有让你的努力白费，上次回来之后，我的丘丘人语口语水平已经有了很大的提升…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "但是口语水平是提升了，书写水平也不能落下呀。所以，在经过严谨研究之后…我用丘丘人语完全原创了几首诗歌。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "不过…这些诗歌里面，还有几句我没办法确定意义，你能帮我去「查证」一下吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…「查证」的意思是？",
              "dialogues": [
                {
                  "role": "艾拉·马斯克",
                  "text": "当，当然就是去念给丘丘人听，看看它做什么反应啦！"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "不过，别担心！那些具体意义存疑的单句，我都<color=#00E1FFFF>做了标注</color>，意义应该偏差不了太远…"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "我已经挑好了目标，那几位丘丘人看上去脾气很好，你就把那几句单句念给它们听吧。"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "那就拜托你了！把我写的诗念给丘丘人听之后，再回来告诉我详细情况吧。"
                }
              ]
            },
            {
              "text": "…又要去念给丘丘人听？",
              "dialogues": [
                {
                  "role": "艾拉·马斯克",
                  "text": "对啊，你看你已经很熟练了嘛。别担心啦，那些具体意义存疑的单句，我都<color=#00E1FFFF>做了标注</color>，意义应该差不了太远…"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "我已经挑好了目标，那几位丘丘人看上去脾气很好，你就把那几句单句念给它们听吧。"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "那就拜托你了！把我写的诗念给丘丘人听之后，再回来告诉我详细情况吧。"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "如，如果有什么意外的话，我相信你们应该处理得好…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "接近丘丘人"
        },
        {
          "role": "派蒙",
          "text": "这些丘丘人，看起来确实有点不一样…"
        },
        {
          "role": "派蒙",
          "text": "总之，快点念诗给它们听吧，要是有脾气不这么好的丘丘人来了就糟了…"
        },
        {
          "role": "派蒙",
          "text": "那么，我们先念哪一句呢？"
        },
        {
          "type": "subtitle",
          "text": "念诗给丘丘人听"
        },
        {
          "role": "旅行者",
          "text": "Celi dada, mimi nunu!"
        },
        {
          "role": "旅行者",
          "text": "Muhe ye!"
        },
        {
          "role": "旅行者",
          "text": "Ye dada!"
        },
        {
          "role": "旅行者",
          "text": "Ya yika!"
        },
        {
          "role": "派蒙",
          "text": "咦？看起来，似乎情况还不错…"
        },
        {
          "role": "派蒙",
          "text": "这个丘丘人，好像还挺高兴的呢，我们接着往下念吧。"
        },
        {
          "role": "旅行者",
          "text": "Nini zido!"
        },
        {
          "role": "派蒙",
          "text": "呜哇，这些丘丘人全都开始跳舞了，看起来确实很高兴呢。"
        },
        {
          "role": "派蒙",
          "text": "这样子应该就可以了，我们回去和艾拉·马斯克说说具体情况吧。"
        },
        {
          "role": "派蒙",
          "text": "咦？这是什么反应，难道是太高兴了…艾拉·马斯克的诗真有这么好吗？"
        },
        {
          "role": "派蒙",
          "text": "不，不对！看后面！小心后面！有丘丘人袭击过来了！"
        },
        {
          "type": "subtitle",
          "text": "击败生气的丘丘人"
        },
        {
          "role": "派蒙",
          "text": "好像有回应了，不过，它好像没说话的意思。"
        },
        {
          "type": "subtitle",
          "text": "与艾拉·马斯克对话"
        },
        {
          "role": "派蒙",
          "text": "没办法了，只能从动作来猜测它想表达什么了…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "怎么样？你把那几句话念给丘丘人听了吗？"
        },
        {
          "role": "旅行者",
          "text": "念完了。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "效果怎么样？看你这幅样子，想必效果很不错吧？"
        },
        {
          "role": "旅行者",
          "text": "效果还不错。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "我对那些单词的理解果然没错，太好了。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "这下，我对丘丘人语的研究又迈进了一大步。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "总有一天，我能和丘丘人们自由交流，然后，从它们自己嘴里，把丘丘人的秘密全都挖掘出来，到那个时候…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "…我就可以说，我没有辱没「马斯克」这个姓氏了。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "哦对了，请收下这个吧，就当做是答谢了。"
        },
        {
          "type": "subtitle",
          "text": "与艾拉·马斯克对话"
        },
        {
          "role": "艾拉·马斯克",
          "text": "不知道我写的这几个句子，丘丘人会不会喜欢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么要用丘丘人语写诗？",
              "dialogues": [
                {
                  "role": "艾拉·马斯克",
                  "text": "嗯…老实说，丘丘人语我并没有完全掌握，语法啦，句式啦，还有单词之间的组合方式，都还没有理解透彻…"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "虽然这些句子都是我很认真写出来的，但在丘丘人看来，也许还是会感觉很拙劣吧。"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "而且，只要一个字不同，整个句子的意义说不定就会改变…这种微妙的变化，如果不去实践，也就是和丘丘人交流，是绝对学习不到的。"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "不过，「向丘丘人学习丘丘人语」这件事，一般人也接受不了吧。"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "但我能接受，嗯…不如说，为了掌握丘丘人语，理解丘丘人，我必须接受才行。"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "而且我想，用诗歌来和蒙德城周围的丘丘人们交流，这种方式也再好不过了吧。"
                }
              ]
            },
            {
              "text": "那些标注…",
              "dialogues": [
                {
                  "role": "艾拉·马斯克",
                  "text": "你说后面的那些标注啊。嗯…这么说吧，这些诗歌的单词，都是我从书籍里找到的。"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "虽然我遵循着那些书上曾经用过的运词方式，勉强拼出了这些句子…"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "但语言这件事很复杂…就算是同一个单词，放在不同的环境里，具体含义说不定就会发生改变，甚至会影响到整个单句的句意…"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "这些单句，已经是我写的诗句里相对来说最能摸清意义的了…"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "还有一些「诗句」，我写出来自己都不知道怎么翻译…就不给你看了…"
                }
              ]
            },
            {
              "text": "看这些标注，你已经大致弄清楚了啊…",
              "dialogues": [
                {
                  "role": "艾拉·马斯克",
                  "text": "也只是…「大致」啊。虽然说是要和丘丘人友好相处…"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "但要是出错了，丘丘人应该也不会给我解释的余地。要是它们突然袭击我，我可没办法全身而退…"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "所以，只能拜托你啦，嘿嘿…没，没关系，只要按照我的标注来，应该不会出问题的，放心啦。"
                },
                {
                  "role": "艾拉·马斯克",
                  "text": "嗯，应该…"
                }
              ]
            }
          ]
        },
        {
          "role": "艾拉·马斯克",
          "text": "怎么样？你把我的诗念给丘丘人听了吗？"
        },
        {
          "role": "旅行者",
          "text": "念完了。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "效果怎么样？呃，看你这幅样子…好像是，很糟糕呢…"
        },
        {
          "role": "旅行者",
          "text": "出了点小问题…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "你是没有注意看我的标注吗？还是说，我的标注也出错了…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "抱歉啊，看来我还是学艺不精，要继续学习才行。谢谢你帮我忙，这些请收下，就当做是答谢吧。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "…必须要再抓紧一些，绝不能辱没了「马斯克」这个姓氏。"
        }
      ]
    }
  ]
}