{
  "quest_id": 70503,
  "chapter_num": null,
  "chapter_title": "坚冰，易溶于酒",
  "type": "wq",
  "route": "Solid Ice, Soluble in Wine",
  "stories": [
    {
      "story_id": 70503,
      "title": "坚冰，易溶于酒",
      "description": "「啧，怎么劳伦斯家的人也在这里喝酒…真是…」「咳咳，你还是少说两句吧。好歹人家也是骑士团的人…」",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与优菈对话",
          "narration": true
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "优菈？",
              "dialogues": [
                {
                  "role": "优菈",
                  "text": "我…我没事…"
                }
              ]
            },
            {
              "text": "你怎么了？",
              "dialogues": [
                {
                  "role": "优菈",
                  "text": "我…我没事…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…优菈的样子不太对劲，是来之前就喝了不少酒吗？"
        },
        {
          "role": "派蒙",
          "text": "我记得远礁浮沫是用咖啡泡的。喝完酒之后喝咖啡，哇，肚子会不会爆炸啊。"
        },
        {
          "role": "派蒙",
          "text": "为了肚子着想，端上去之前，偷偷帮她兑点水吧！"
        },
        {
          "type": "subtitle",
          "text": "为优菈调制饮品",
          "narration": true
        },
        {
          "role": "优菈",
          "text": "味道…不错…"
        },
        {
          "role": "派蒙",
          "text": "哇，兑了那么多水都没察觉，优菈果然喝多了。"
        },
        {
          "role": "优菈",
          "text": "酒保，再来…等、等等，怎么是你们？"
        },
        {
          "role": "旅行者",
          "text": "正巧在体验酒保…"
        },
        {
          "role": "旅行者",
          "text": "现在才发现吗…"
        },
        {
          "role": "优菈",
          "text": "……"
        },
        {
          "role": "优菈",
          "text": "不好意思。刚刚从猫尾酒馆过来，喝得可能稍微多了一些…"
        },
        {
          "role": "旅行者",
          "text": "有什么烦心事吗？"
        },
        {
          "role": "旅行者",
          "text": "陪你聊聊吧。"
        },
        {
          "role": "派蒙",
          "text": "对啊。一个人喝闷酒多孤单，还是说出来，大家一起聊聊比较开心！"
        },
        {
          "role": "优菈",
          "text": "……"
        },
        {
          "role": "优菈",
          "text": "的确只有一个人喝。"
        },
        {
          "role": "优菈",
          "text": "只要在蒙德，无论到哪个酒馆都不受待见。今天难得心情好，想喝上几杯，最后又被指指点点…"
        },
        {
          "role": "优菈",
          "text": "旅行者，你是怎么交到那么多朋友的呢？"
        },
        {
          "role": "优菈",
          "text": "大家谈论你时，语气中总是很憧憬，脸上还带着笑容。"
        },
        {
          "role": "优菈",
          "text": "而我，哪怕只是提到我的姓氏，都会…"
        },
        {
          "role": "旅行者",
          "text": "别这样想。"
        },
        {
          "role": "派蒙",
          "text": "出生在劳伦斯家族不是优菈自己能决定的事。但我们又不在乎这些，我们认识的优菈是个很好的人哦！"
        },
        {
          "role": "派蒙",
          "text": "不过优菈就是不坦率，总爱装作记仇，把自己温柔的一面藏起来…"
        },
        {
          "role": "优菈",
          "text": "喂，谁说是装作…"
        },
        {
          "role": "旅行者",
          "text": "除了我们以外…"
        },
        {
          "role": "旅行者",
          "text": "也会有更多的人认可优菈…"
        },
        {
          "role": "优菈",
          "text": "真的吗？我喝醉了都不敢这么想…"
        },
        {
          "role": "优菈",
          "text": "那么久以来，哪怕加入了西风骑士团，大家都还…"
        },
        {
          "role": "旅行者",
          "text": "「风向是会转变的。」"
        },
        {
          "role": "派蒙",
          "text": "哦！那个卖唱的，也说过这种有道理的话啊。"
        },
        {
          "role": "派蒙",
          "text": "优菈，你就继续按你的方式前进吧。"
        },
        {
          "role": "派蒙",
          "text": "总有一天，你会改变大家对劳伦斯家族的印象！"
        },
        {
          "role": "旅行者",
          "text": "要耐心哦。"
        },
        {
          "role": "优菈",
          "text": "嗯，谢谢你们…"
        },
        {
          "role": "优菈",
          "text": "我，我…咳！就聊到这里吧，我先回去了。"
        },
        {
          "role": "旅行者",
          "text": "要送送你吗？"
        },
        {
          "role": "优菈",
          "text": "不必。我现在不能想别的事…得好好记住这些话，回去赶紧写在纸上…"
        },
        {
          "role": "派蒙",
          "text": "喝醉后的优菈，比平时坦率了不少。"
        },
        {
          "role": "派蒙",
          "text": "但没有听到那句标志性的话，总感觉缺了点什么。"
        },
        {
          "role": "派蒙",
          "text": "啊！等她酒醒之后，会不会气鼓鼓地威胁我们要把今天的事全部忘掉？"
        },
        {
          "role": "旅行者",
          "text": "说不定呢。"
        }
      ]
    }
  ]
}