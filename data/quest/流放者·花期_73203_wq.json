{
  "quest_id": 73203,
  "chapter_num": null,
  "chapter_title": "流放者·花期",
  "type": "wq",
  "route": "The Exile: Blooming",
  "stories": [
    {
      "story_id": 73203,
      "title": "流放者·花期",
      "description": "曾在须弥城里绽放的蔷薇，离开了须弥城未必就不能绽放。",
      "dialogues": [
        {
          "role": "赛芭",
          "text": "如果不是遇到你们，恐怕我很难看到那些蔷薇发芽。"
        },
        {
          "role": "赛芭",
          "text": "早知道会这样，比起种子，当初我更应该带些书来这里。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你不是本地人？",
              "dialogues": [
                {
                  "role": "赛芭",
                  "text": "很意外吗？这算是说明我适应得很好吧。"
                },
                {
                  "role": "赛芭",
                  "text": "当初刚来这里的时候，从衣食到起居习惯，每一样我都没办法适应。"
                },
                {
                  "role": "赛芭",
                  "text": "但过了这么久，慢慢也就接受了。"
                },
                {
                  "role": "赛芭",
                  "text": "只不过表面适应，并不代表内心就接受了自己的处境。"
                },
                {
                  "role": "赛芭",
                  "text": "能在须弥城里盛放的蔷薇，在这里始终还是难以开花。"
                },
                {
                  "role": "旅行者",
                  "text": "你是学者吗？"
                },
                {
                  "role": "赛芭",
                  "text": "我…曾经被称为学者，但现在不是了。"
                },
                {
                  "role": "赛芭",
                  "text": "我说了以我的身份不该说的话，了解了以我的身份不该了解的知识。"
                },
                {
                  "role": "赛芭",
                  "text": "这是有违教令院禁忌的，所以我就不再是学者了。"
                },
                {
                  "role": "旅行者",
                  "text": "你说了什么？"
                },
                {
                  "role": "赛芭",
                  "text": "好奇心是我们寻求智慧的原动力，但也是招致罪罚的源头。"
                },
                {
                  "role": "赛芭",
                  "text": "这是我被驱逐到这里来之后才明白的。"
                },
                {
                  "role": "赛芭",
                  "text": "安全起见，我认为不向你细说最好。"
                },
                {
                  "role": "旅行者",
                  "text": "那好吧。"
                },
                {
                  "role": "赛芭",
                  "text": "咳咳，不过…那个…"
                }
              ]
            },
            {
              "text": "为什么要种须弥蔷薇？",
              "dialogues": [
                {
                  "role": "赛芭",
                  "text": "你可能不太了解须弥蔷薇，这种植物的用途非常广泛。"
                },
                {
                  "role": "赛芭",
                  "text": "它可以食用、可以药用，作为礼品，也有很高的经济价值。"
                },
                {
                  "role": "赛芭",
                  "text": "这还仅仅是它在我们日常生活中的常见用途。"
                },
                {
                  "role": "赛芭",
                  "text": "须弥蔷薇的花、叶、茎并不总是我们今天见到的这样，它曾经也有过不同的形态。"
                },
                {
                  "role": "赛芭",
                  "text": "我认为地理条件的改变，促使须弥蔷薇的形态特征也发生过改变。"
                },
                {
                  "role": "赛芭",
                  "text": "从它的形态演化过程，我们能得到很多历史地理方面的信息。"
                },
                {
                  "role": "赛芭",
                  "text": "这不是一两句话说得清的事，向一位路过的冒险家解释恐怕也不合规定。"
                },
                {
                  "role": "赛芭",
                  "text": "如果你对植物演化感兴趣，就去教令院吧，那里的植物学教育更加完备。"
                },
                {
                  "role": "旅行者",
                  "text": "所以是为了研究？"
                },
                {
                  "role": "赛芭",
                  "text": "我已经不是学者了，没有做研究的条件和资格。"
                },
                {
                  "role": "赛芭",
                  "text": "非要说为什么的话…唉，你的好奇心可真重。"
                },
                {
                  "role": "赛芭",
                  "text": "我以前的居所里种了很多须弥蔷薇，它们开花的时候很漂亮，我每天都看得到。"
                },
                {
                  "role": "赛芭",
                  "text": "有可能的话，我还想像以前一样，每天都有它们作陪。"
                },
                {
                  "role": "赛芭",
                  "text": "…只是这样而已。"
                },
                {
                  "role": "旅行者",
                  "text": "我能理解。"
                }
              ]
            }
          ]
        },
        {
          "role": "赛芭",
          "text": "我以为冒险家都是来去匆匆的人，帮过一次忙，你大概就不会回来了。"
        },
        {
          "role": "赛芭",
          "text": "没想到，又跟你说了这么多话。"
        },
        {
          "role": "赛芭",
          "text": "嗯…在这里，我能敞开聊天的朋友不是很多。"
        },
        {
          "role": "赛芭",
          "text": "你认为…之后…你有空来帮忙给它们施肥吗？"
        },
        {
          "role": "旅行者",
          "text": "可以。"
        },
        {
          "role": "赛芭",
          "text": "那…好，我会等你来的。"
        },
        {
          "role": "赛芭",
          "text": "你们来了啊，很守约呢。"
        },
        {
          "role": "赛芭",
          "text": "我做了一些黄油鸡，如果你们肚子饿的话，可以一起坐下来吃。"
        },
        {
          "role": "派蒙",
          "text": "黄油鸡！好耶，我要吃一大盘！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，这样不好…",
              "dialogues": []
            },
            {
              "text": "抱歉，派蒙是这样的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…对不起嘛。"
        },
        {
          "role": "赛芭",
          "text": "没关系的，请不用跟我客气，喜爱食物也是人之常情。"
        },
        {
          "role": "赛芭",
          "text": "待会儿我就去把菜拿出来热一热，再给你们装好，也算是答谢你们之前帮我的忙了。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，赛芭小姐，你真好！你种的蔷薇花一定会顺着你的心意，好好生长的。"
        },
        {
          "role": "赛芭",
          "text": "哈哈，这段时间，我一直在尽量保持土壤湿润，植株幼苗状态还算良好。"
        },
        {
          "role": "赛芭",
          "text": "只是它们的生长速度有点慢，让人担心。"
        },
        {
          "role": "赛芭",
          "text": "一般来说，如果胚芽状态良好，很快就应该萌发了，但这几株到现在也没有动静…"
        },
        {
          "role": "赛芭",
          "text": "不知道是不是土壤肥力不够，它们还是这个状态的话，我最好继续从外部施肥。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "再施一次肥吧。",
              "dialogues": []
            },
            {
              "text": "用草元素的力量试试。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "赛芭",
          "text": "那就又要麻烦你们了。"
        },
        {
          "role": "派蒙",
          "text": "小事一桩，包在我们身上。"
        },
        {
          "type": "subtitle",
          "text": "使用草元素的力量为幼苗「施肥」"
        },
        {
          "type": "subtitle",
          "text": "和赛芭聊聊"
        },
        {
          "role": "赛芭",
          "text": "这次也谢谢你们了，能在这里看到须弥蔷薇生长，我真的很开心。"
        },
        {
          "role": "？？？",
          "text": "在赛芭和你们说话的同时，一簇簇新叶从旧叶中伸出…"
        },
        {
          "role": "？？？",
          "text": "新叶逐渐舒展，结出了饱满的花苞…"
        },
        {
          "role": "？？？",
          "text": "花苞缓缓绽放，赛芭种下的须弥蔷薇终于吐蕊。"
        },
        {
          "role": "？？？",
          "text": "她折下一支须弥蔷薇，交给了你和派蒙。"
        },
        {
          "role": "派蒙",
          "text": "这不好吧，本来赛芭小姐种的蔷薇就不多，现在还折了一支给我们…"
        },
        {
          "role": "赛芭",
          "text": "没关系哦，如果不是你们帮忙，须弥蔷薇是没办法在这里开出花来的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一点小忙。",
              "dialogues": []
            },
            {
              "text": "别放心上。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "赛芭",
          "text": "一座蔷薇园当然很壮观，不过单支蔷薇也有自己的美。以前我还是学者的时候，就对蔷薇感兴趣。"
        },
        {
          "role": "派蒙",
          "text": "欸，原来赛芭小姐是位学者吗？"
        },
        {
          "role": "赛芭",
          "text": "对了，我还没有告诉过派蒙呢。我并不是一直居住在阿如村的居民，我是从教令院里…「搬」过来的。"
        },
        {
          "role": "派蒙",
          "text": "我就说嘛，赛芭小姐说话的方式好文雅，真的很像学者。"
        },
        {
          "role": "派蒙",
          "text": "我明白啦，赛芭小姐是想继续研究蔷薇，所以才会种植它们的吧。"
        },
        {
          "role": "赛芭",
          "text": "倒不能这么说，学者们对研究对象的兴趣不该是为了做研究才刻意培养出来的。"
        },
        {
          "role": "赛芭",
          "text": "是因为喜爱这个世界，所以才想了解它，想理解草木的生命轨迹。"
        },
        {
          "role": "赛芭",
          "text": "拿我举例的话，以前我有个课题——须弥地理环境演化对蔷薇物种形态的影响。"
        },
        {
          "role": "赛芭",
          "text": "你想，如果须弥的地理环境演化方向和今天完全不同，为了适应自然条件，蔷薇会演化成什么形态呢？"
        },
        {
          "role": "赛芭",
          "text": "会不会演化成爬藤植物？那样的话，今天的教令院墙壁上说不定就会爬满蔷薇。"
        },
        {
          "role": "赛芭",
          "text": "会不会演化出族生花？一开一大捧，很有气派吧？"
        },
        {
          "role": "赛芭",
          "text": "说不定还会有各种各样的颜色，白的、红的、金的…那会是一个全新的品种。"
        },
        {
          "role": "赛芭",
          "text": "当然咯，现在很少有人能发现新物种了，像过去某些顶尖学者那样培育新物种，就更别提了。"
        },
        {
          "role": "赛芭",
          "text": "我想说明的是：每一支蔷薇身上都蕴含着大量的可能性。"
        },
        {
          "role": "赛芭",
          "text": "探索这些可能性是一件很开心的事，那时候我每天都怀着兴趣开开心心地收集着标本。"
        },
        {
          "role": "赛芭",
          "text": "回想起来，真是一段纯粹又愉快的时光。"
        },
        {
          "role": "赛芭",
          "text": "总而言之，你们拿着就好了，对我来说，这可不是损失，而是快乐的分享。"
        },
        {
          "role": "赛芭",
          "text": "如果实在觉得心里别扭，以后就多带些须弥蔷薇来看我吧。"
        },
        {
          "role": "赛芭",
          "text": "和你们说话的时候，感觉很放松。"
        },
        {
          "role": "赛芭",
          "text": "不管我说些什么，你们都不会觉得我是在说「闲话」，打断我说话。"
        },
        {
          "role": "赛芭",
          "text": "我也会送你们一些小礼物的，虽然对现在的我基本没用处，但你们说不定会喜欢。"
        },
        {
          "role": "旅行者",
          "text": "会常来的。"
        },
        {
          "role": "赛芭",
          "text": "一定要常来看我呀。"
        }
      ]
    }
  ]
}