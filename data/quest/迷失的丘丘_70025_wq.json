{
  "quest_id": 70025,
  "chapter_num": null,
  "chapter_title": "迷失的丘丘",
  "type": "wq",
  "route": "The Lost Hilichurl",
  "stories": [
    {
      "story_id": 70025,
      "title": "迷失的丘丘",
      "description": "尽管最后还是让那个奇怪的家伙跑掉了，但至少商路重又恢复了安全。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "向冒险家协会回报"
        },
        {
          "role": "凯瑟琳",
          "text": "您好，冒险家！关于委托的完成情况我都已经了解了，感谢您为冒险家协会的付出！这里是您应得的报酬。"
        },
        {
          "role": "凯瑟琳",
          "text": "虽然没能捕获那介奇怪的丘丘人，也没能找到这次骚乱的原因…但野外的安全至少得到了保障，辛苦您了。"
        },
        {
          "role": "凯瑟琳",
          "text": "顺便一提，艾拉·马斯克小姐在图书馆等您。"
        },
        {
          "type": "subtitle",
          "text": "与艾拉·马斯克对话"
        },
        {
          "role": "艾拉·马斯克",
          "text": "Homu…mimi tomo…唔…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好？",
              "dialogues": [
                {
                  "role": "艾拉·马斯克",
                  "text": "Ya ika！！啊…是你们啊…吓我一跳…请不要打扰我。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸，不是你叫我们来的吗?"
        },
        {
          "role": "艾拉·马斯克",
          "text": "嗯？哦哦…是你们啊！多谢你们的帮助。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "举手之劳。",
              "dialogues": [
                {
                  "role": "艾拉·马斯克",
                  "text": "哼哼，我的词典工作又前进了一大步！人类能与丘丘人和平共存的论据又增加了！"
                }
              ]
            },
            {
              "text": "我还是更喜欢自己的方式。",
              "dialogues": [
                {
                  "role": "艾拉·马斯克",
                  "text": "哼哼，我的词典工作又前进了一大步！人类能与丘丘人和平共存的论据又增加了！"
                }
              ]
            }
          ]
        },
        {
          "role": "艾拉·马斯克",
          "text": "只可惜没能和那个奇怪的丘丘人搭上话…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "从我收集的语料来看，或许它也只是很想在这片陌生的大地上结交新朋友吧"
        },
        {
          "role": "艾拉·马斯克",
          "text": "没能好好交流，真是遗憾。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "啊，顺便，这里是给你的谢礼。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "先前麻烦了你们那么多，实在不好意思。有机会还希望能够一起合作。"
        },
        {
          "role": "派蒙",
          "text": "什么嘛，原来这家伙还是会好好说话的…"
        }
      ]
    }
  ]
}