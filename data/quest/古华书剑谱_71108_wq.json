  "stories": [
    {
      "story_id": 71108,
      "title": "古华书剑谱",
      "description": "探索古华留下的秘密。",
      "dialogues": [
        {
          "role": "《古华手记》",
          "text": "「…修习刺明之法。木人不慎尽毁…无钱资…自思一良策，何不束草为人…」"
        },
        {
          "role": "《古华手记》",
          "text": "「收揽稻草。」"
        },
        {
          "role": "《古华手记》",
          "text": "「束草。甚疲。」"
        },
        {
          "role": "《古华手记》",
          "text": "「…修习刺明之法。草人不慎尽毁…不妨先习剑。」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "继续阅读。",
            "不读了，什么乱七八糟的…"
          ]
        },
        {
          "role": "旅行者",
          "text": "继续阅读。"
        },
        {
          "role": "《古华手记》",
          "text": "「…无事。闲坐庭前观雨，腹中稍饥…思悟前日所见，忽得启感，若以剑…（模糊不清）自名『裁雨』，改日当试。」"
        },
        {
          "role": "《古华手记》",
          "text": "「…修习裁雨之法，不慎跌坠，所幸伤不甚重…自思一良策，不妨凿地浚池于桩下，既可使不复跌伤，又可养鱼以为食…」"
        },
        {
          "role": "《古华手记》",
          "text": "「…往见渔者，市数十鱼…试烹之，甚肥美，众鱼莫可与比…」"
        },
        {
          "role": "《古华手记》",
          "text": "（此后十余页均为鱼肉的各种烹饪方法，记载无比详细，有些甚至还搭配了插图。）"
        },
        {
          "role": "《古华手记》",
          "text": "「…修习裁雨之法，不慎跌坠。」"
        },
        {
          "role": "《古华手记》",
          "text": "「…成。」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "继续阅读。",
            "不读了，完全没写练习过程…"
          ]
        },
        {
          "role": "旅行者",
          "text": "继续阅读。"
        },
        {
          "role": "《古华手记》",
          "text": "「…使枪剑当如使（模糊不清，旁有第三代掌门批注：当如使指）…所止，即是妙理之相…然彼无…何以予之？何以告之？」"
        },
        {
          "role": "《古华手记》",
          "text": "「…改修藏书阁。设…于内，待…」"
        },
        {
          "role": "《古华手记》",
          "text": "「…以目视之，使四方之卷合于四方之阁，便可…」"
        },
        {
          "role": "《古华手记》",
          "text": "（此后数页均被涂抹，无法阅读。旁有第三代掌门批注：此为劝诫后世之人博览四方书卷。）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "继续阅读。",
            "不读了，涂得乱七八糟的…"
          ]
        },
        {
          "role": "旅行者",
          "text": "继续阅读。"
        },
        {
          "role": "《古华手记》",
          "text": "「…伤愈。白小三烹羊脍鲤来见。肥美无膻。遂问其术…传以生克之法…于此记之。」"
        },
        {
          "role": "《古华手记》",
          "text": "（此后数页详细记录了羊肉的各种烹饪方法。）"
        },
        {
          "role": "《古华手记》",
          "text": "「…修习刺明之法。木人不慎尽毁…无钱资…自思一良策，何不束草为人…」"
        },
