{
  "quest_id": 70664,
  "chapter_num": null,
  "chapter_title": "秘境来风",
  "type": "wq",
  "route": "Windswept Domain",
  "stories": [
    {
      "story_id": 70664,
      "title": "秘境来风",
      "description": "在璃月，你遇见了一位冒险家…",
      "dialogues": [
        {
          "role": "宏朗",
          "text": "每次都派我来解决这种麻烦事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "咦？你是…",
              "dialogues": []
            },
            {
              "text": "又见面了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宏朗",
          "text": "是你啊！这可真是太巧了，没想到会在这里遇见你。"
        },
        {
          "role": "旅行者",
          "text": "你在这里做什么？"
        },
        {
          "role": "宏朗",
          "text": "唉，别提了。你还记得上次那个奇怪的秘境吧？就是…就是那个内部结构会随人心意变化的秘境。"
        },
        {
          "role": "宏朗",
          "text": "多亏了你帮我进入那个秘境探索，我才获得了不少的情报。在那个秘境消失之后，我就回去向岚姐复命了。"
        },
        {
          "role": "宏朗",
          "text": "我反复和她说，这件事都是多亏了你帮忙，我只是做了一点微不足道的辅助工作。"
        },
        {
          "role": "宏朗",
          "text": "但岚姐根本不听我的，还说什么她很认可我的工作，然后要我带一队人继续负责探索这类未知的秘境。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听上去不错啊。",
              "dialogues": []
            },
            {
              "text": "这应该是好事。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宏朗",
          "text": "好什么啊。我原本就是一个普普通通的冒险家，无拘无束，爱干嘛就干嘛。"
        },
        {
          "role": "宏朗",
          "text": "虽然之前是赚得少了点，但胜在自由啊。现在岚姐给我安了这么个头衔，我推也推不掉，唉…"
        },
        {
          "role": "宏朗",
          "text": "先不说这些，我们说正事。你看见我旁边这道门了吗？门后也是一个奇怪的秘境。"
        },
        {
          "role": "宏朗",
          "text": "这个秘境里面，布满了「风场」。"
        },
        {
          "role": "旅行者",
          "text": "是我理解的那种「风场」吗？"
        },
        {
          "role": "宏朗",
          "text": "对，就是野外那种…呼呼呼吹来吹去的风场，冒险家们使用风之翼的时候，经常借助它们飞得更高。"
        },
        {
          "role": "宏朗",
          "text": "不过这座秘境里的「风场」的分布十分混乱，有些风场发出的风甚至会彼此冲撞，形成一个阻飞区。"
        },
        {
          "role": "宏朗",
          "text": "我请了几位擅长操控风之翼的冒险家进去探索，但他们都没有探索多远就被迫退了回来。"
        },
        {
          "role": "宏朗",
          "text": "据他们说，这座秘境里还分布着一些机关。在启动这些机关后，一些风场的状态好像也发生了变化…"
        },
        {
          "role": "宏朗",
          "text": "但还没等他们弄清楚那些机关的具体用途，大量的魔物就突然出现，他们只能撤退了。"
        },
        {
          "role": "宏朗",
          "text": "我们讨论之后认为，如果能活用这些机关，也许就能更加顺利地探索这座秘境…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你进去探索过吗？",
              "dialogues": []
            },
            {
              "text": "你没有打头阵吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "宏朗",
          "text": "哎呀，你又不是不知道，我那个…身体素质不太行，也不太会操纵风之翼。"
        },
        {
          "role": "宏朗",
          "text": "一般的飞行行动我倒是能够应付，但以这座秘境里的风场分布情况…"
        },
        {
          "role": "宏朗",
          "text": "如果我进去探索，大概只会被吹得漫天乱飞，然后再一头扎进魔物堆里吧。"
        },
        {
          "role": "宏朗",
          "text": "旅行者，我上次见识过你的实力。你的体力不错，头脑也很灵活…"
        },
        {
          "role": "宏朗",
          "text": "如果你愿意的话，能再帮忙我探索一下这座秘境吗？"
        },
        {
          "role": "宏朗",
          "text": "报酬的话你不用担心，和上次一样，我保证给你备足报酬。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我试试。",
              "dialogues": [
                {
                  "role": "宏朗",
                  "text": "太好了，那就拜托你了！"
                }
              ]
            },
            {
              "text": "里面有宝物吗？",
              "dialogues": [
                {
                  "role": "宏朗",
                  "text": "这我可说不准，毕竟我们还没有在这秘境里探索多远…"
                },
                {
                  "role": "宏朗",
                  "text": "呃…放心！如果你在探索的过程里发现了任何宝物，都可以直接收下。"
                },
                {
                  "role": "宏朗",
                  "text": "那就拜托你了，旅行者。"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}