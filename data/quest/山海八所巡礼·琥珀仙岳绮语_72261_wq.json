{
  "quest_id": 72261,
  "chapter_num": null,
  "chapter_title": "山海八所巡礼·琥珀仙岳绮语",
  "type": "wq",
  "route": "Eight Locales Over Mountains and Seas: The Wonders of Adeptal Amber",
  "stories": [
    {
      "story_id": 72261,
      "title": "山海八所巡礼·琥珀仙岳绮语",
      "description": "之前答应了五百藏「带吉法师去外面修行」的请求。这回或许可以带他去看看仙家居所的景色吧。琥牢山或许是个不错的选择…？",
      "dialogues": [
         {
          "type": "subtitle",
          "text": "前往琥牢山的仙家洞府"
        },
        {
          "role": "派蒙",
          "text": "喂——理水叠山真君——"
        },
        {
          "role": "「吉法师」",
          "text": "喂——理理真——"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "伤脑筋，仙人好像不在哪…"
        },
        {
          "role": "旅行者",
          "text": "对仙人不能无礼。"
        },
        {
          "role": "「吉法师」",
          "text": "派蒙，仙人是什么？"
        },
        {
          "role": "派蒙",
          "text": "嗯…应该说是很特别的人，或者是动物吧？"
        },
        {
          "role": "「吉法师」",
          "text": "就像吉法师？"
        },
        {
          "role": "派蒙",
          "text": "不对不对！应该说，有神奇的力量…"
        },
        {
          "role": "「吉法师」",
          "text": "也会砰砰？那，吉法师也是仙人。"
        },
        {
          "role": "派蒙",
          "text": "唔…仙人，是更加古老、更有威严的…"
        },
        {
          "role": "「吉法师」",
          "text": "知道了，吉法师不是仙人。五百藏是仙人！"
        },
        {
          "role": "派蒙",
          "text": "呜哇，要怎么解释…"
        },
        {
          "role": "旅行者",
          "text": "仙人是守护璃月的古老存在…"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师知道了。五百藏守护的是镇守之森，所以不是仙人。"
        },
        {
          "role": "派蒙",
          "text": "虽然道理不是这么一回事，不过能撇清误会就好…"
        },
        {
          "role": "派蒙",
          "text": "不过难得眼前有仙府，就在这里给吉法师拍照吧！"
        },
        {
          "role": "「吉法师」",
          "text": "呶！吉法师乖乖站好拍照。"
        },
        {
          "role": "派蒙",
          "text": "吉法师乖！"
        },
        {
          "type": "subtitle",
          "text": "为吉法师拍照"
        },
        {
          "type": "subtitle",
          "text": "与吉法师对话"
        },

        {
          "role": "派蒙",
          "text": "拍得真好！"
        },
        {
          "role": "「吉法师」",
          "text": "呶哈哈，吉法师帅。"
        },
        {
          "role": "派蒙",
          "text": "这孩子，一点也不谦虚…"
        },
        {
          "role": "「吉法师」",
          "text": "对了，派蒙。仙人有什么法术？"
        },
        {
          "role": "派蒙",
          "text": "仙人的力量很强的！不过要具体举例的话…"
        },
        {
          "role": "旅行者",
          "text": "这周边的琥珀吧。"
        },
        {
          "role": "「吉法师」",
          "text": "琥珀，那是什么？"
        },
        {
          "role": "派蒙",
          "text": "嗯！我记得是说，理水叠山真君有能生出琥珀的花，把入侵的坏东西都困在里面。"
        },
        {
          "role": "「吉法师」",
          "text": "理理真好厉害。守护璃月，所以把坏东西困住。"
        },
        {
          "role": "「吉法师」",
          "text": "好久好久以前，有很坏很坏的绪方四鬼，闯到森林里到处打打。欺负狸子。五百藏变成公家大人的样子，给他们吃妖狸饭。"
        },
        {
          "role": "「吉法师」",
          "text": "后来，和御伽大王一起，把他们丢到画纸里，封印了。"
        },
        {
          "role": "派蒙",
          "text": "还有这样的故事啊。难怪五百藏看到吉法师相片的时候，吓得不轻。"
        },
        {
          "role": "「吉法师」",
          "text": "五百藏不是仙人，不保护璃月。但五百藏保护森林，保护狸子。"
        },
        {
          "role": "旅行者",
          "text": "不同的人，要保护不同的东西。"
        },
        {
          "role": "「吉法师」",
          "text": "呶？"
        },
        {
          "role": "旅行者",
          "text": "吉法师长大以后就知道了。"
        },
        {
          "role": "派蒙",
          "text": "所以，吉法师要努力修行，变成了不起的大妖狸！"
        },
        {
          "role": "「吉法师」",
          "text": "呶！当然了。名震天下的妖狸吉法师！"
        },
        {
          "role": "派蒙",
          "text": "很好奇五百藏没被封印的时候的样子呢！感觉应该很好玩。"
        },
        {
          "role": "派蒙",
          "text": "啊，突然想起，之前也有盗宝团的人被琥珀定身…"
        },
        {
          "role": "旅行者",
          "text": "我们还被当成了「仙使」。"
        },
        {
          "role": "派蒙",
          "text": "感觉是好久以前发生的事情了呢…但好像，也没有过多久？"
        },
        {
          "role": "「吉法师」",
          "text": "呶？"
        },
        {
          "role": "派蒙",
          "text": "咳咳。我们来到璃月之后…"
        },
        {
          "role": "派蒙",
          "text": "「是一年一度的请仙典仪耶。哇哈哈，我和旅行者应该可以吃好多好多好吃的。派蒙，我们走！」"
        },
        {
          "role": "派蒙",
          "text": "「还有贡品！我派蒙马上飞过去！」"
        },
        {
          "role": "「吉法师」",
          "text": "？？"
        },
        {
          "role": "旅行者",
          "text": "别乱说…"
        },
        {
          "role": "派蒙",
          "text": "好啦…"
        },
        {
          "type": "subtitle",
          "text": "以比较简单的语言讲述了一些在璃月的冒险经历，一直讲到在珉林绝云地方寻访众仙为止。"
        },
        {
          "role": "派蒙",
          "text": "…接下来的事情，就是我和旅行者，一起去之前那个「琉璃亭」吃饭啦。"
        },
        {
          "role": "「吉法师」",
          "text": "理理真好厉害，留留真也好厉害！还能做出会动的房子！"
        },
        {
          "role": "派蒙",
          "text": "留留真…呸，留云借风真君好像也很喜欢美食呢！当时，做了好多菜才见到她。"
        },
        {
          "role": "「吉法师」",
          "text": "好贪吃哦，像派蒙。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这点确实像派蒙。",
            "而且也会飞。"
          ]
        },
        {
          "role": "派蒙",
          "text": "喂！"
        },
        {
          "role": "「吉法师」",
          "text": "派蒙是仙人？派蒙好厉害。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，心情好复杂。虽然被吉法师夸了，但感觉又很不是滋味…"
        },
        {
          "role": "派蒙",
          "text": "不过，派蒙不是仙人啦！"
        },
        {
          "role": "「吉法师」",
          "text": "想和仙人玩！"
        },
        {
          "role": "派蒙",
          "text": "仙人一般不会随意现身…不过，四处看看也挺好的。"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师出发！"
        },
         {
          "type": "subtitle",
          "text": "跟随吉法师"
        },
         {
          "type": "subtitle",
          "text": "寻找吉法师"
        },
         {
          "type": "subtitle",
          "text": "与吉法师对话"
        },
        {
          "role": "派蒙",
          "text": "幸好找到了…吉法师，你没受伤吧？"
        },
        {
          "role": "「吉法师」",
          "text": "呜呜…"
        },
        {
          "role": "派蒙",
          "text": "没事就好，没事就好。不过，以后别乱跑啦。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙好像姐姐。",
              "dialogues": [
                  {
          "role": "派蒙",
          "text": "派蒙本来就比吉法师大，当然是姐姐啦。"
        }
              ]
            },
            {
              "text": "派蒙好像妈妈。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "喂！"
        }
              ]
            },
            {
              "text": "派蒙好像老奶奶。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "「旅行者，再多吃点。还在长身体呢，不多吃点，怎么长高。」"
        }
              ]
            }         
          ]
        },
        
        {
          "role": "「吉法师」",
          "text": "呜呶呶。谢谢旅行者，谢谢派蒙。"
        },
        {
          "role": "「吉法师」",
          "text": "还以为，吉法师又被封印了哩，很害怕。但是，能听见派蒙在叫吉法师，所以又没那么害怕。"
        },
        {
          "role": "派蒙",
          "text": "啊，五百藏说过，有的小狸子也曾经被封印过…"
        },
        {
          "role": "派蒙",
          "text": "琥珀里好可怕。都是黑色的，什么都看不见，没办法说话，也不能动、不能砰砰。就像变成石头一样。"
        },
        {
          "role": "「吉法师」",
          "text": "五百藏就算变成石头，也很厉害，所以可以说话、可以看见。但还是不能动。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "吉法师想帮助五百藏？",
              "dialogues": [
                {
          "role": "「吉法师」",
          "text": "嗯。然后，还帮助其他还在石头里的妖狸。"
        }
              ]
            },
            {
              "text": "我们会保护吉法师的。",
              "dialogues": []
            }      
            
            
          ]
        },
        {
          "role": "派蒙",
          "text": "不过，现在我们在吉法师身边，我们不会让你被封印的！"
        },
        {
          "role": "「吉法师」",
          "text": "耶！"
        },
        {
          "role": "派蒙",
          "text": "不过，吉法师要听话，不要太调皮才行。"
        },
        {
          "role": "「吉法师」",
          "text": "嗯。知道了。"
        },
        {
          "role": "派蒙",
          "text": "好乖好乖。那今天就先到此为止吧？吉法师也累了吧，该休息了。"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师不累！"
        },
        {
          "role": "派蒙",
          "text": "哎呀，真伤脑筋。要是吉法师不听话，派蒙就不知道之后去哪修行了呢…"
        },
        {
          "role": "「吉法师」",
          "text": "呶…"
        },
        {
          "type": "subtitle",
          "text": "虽然不太情愿，但吉法师似乎也玩累了…"
        },
        {
          "role": "派蒙",
          "text": "哎呀，吉法师真是和小孩子一样。"
        },
        {
          "role": "旅行者",
          "text": "派蒙对付小孩子越来越熟练了。"
        },
        {
          "role": "派蒙",
          "text": "是吗？毕竟和你一起旅行这么久了，嘿嘿。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当我是小孩子喔？",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "不是啦！我们不是一起陪很多小孩子玩过吗？像是小冥、畅畅…"
        }
              ]
            },
            {
              "text":  "确实一起照顾过很多小孩子。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "嗯，我们一起陪很多小孩子玩过！像是小冥、畅畅…"
        }
              ]
            }      
          ]
        },
        
        {
          "role": "派蒙",
          "text": "跟你一起旅行，确实能学到很多事情呢。"
        },
        {
          "role": "派蒙",
          "text": "嗯~这次学到的是…妖狸和仙人，不一定合得来。"
        },
        {
          "role": "派蒙",
          "text": "接下来，要好好想想下一个目的地…"
        }
      ]
    }
  ]
}