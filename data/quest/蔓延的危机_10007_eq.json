{
  "quest_id": 10007,
  "chapter_num": "未归的熄星 其二",
  "chapter_title": "蔓延的危机",
  "type": "eq",
  "route": "The Crisis Deepens",
  "stories": [
    {
      "story_id": 41112,
      "title": "蔓延的危机",
      "description": "随着调查深入，你逐渐发觉，这些陨石背后似乎藏有某种神秘力量。为了让陷入昏迷的大家醒来，你和同伴们不断清理着各地的陨石…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "找杜拉夫聊聊清泉镇的情况"
        },
        {
          "role": "派蒙",
          "text": "杜拉夫先生！镇上情况如何？"
        },
        {
          "role": "杜拉夫",
          "text": "噢，是你们！托几位的福，情况稍好些了。"
        },
        {
          "role": "派蒙",
          "text": "太好了，清理陨石果然是正确的做法！"
        },
        {
          "role": "菲谢尔",
          "text": "来得正好，旅人。看来是本皇女守护尘世一切灵魂的崇高梦想将你感召至此。做好准备，随我一同会晤使者吧！"
        },
        {
          "role": "派蒙",
          "text": "使者？外交使者？"
        },
        {
          "role": "杜拉夫",
          "text": "哈哈，二位还不知道吧。有人送来口信，一位名叫{{颜色|蓝|爱德琳}}的女士想请你们到{{颜色|蓝|晨曦酒庄}}作客。"
        },
        {
          "role": "派蒙",
          "text": "爱德琳！那不是晨曦酒庄的女仆长吗？"
        },
        {
          "role": "杜拉夫",
          "text": "看来，这位爱德琳是你们的朋友。"
        },
        {
          "role": "奥兹",
          "text": "荣幸之至。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，这位皇女说的那些话，你都能懂吗？为什么我总是听不太明白…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "其实我知道是怎么回事，但…",
              "dialogues": []
            },
            {
              "text": "解释起来很复杂…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "好吧好吧…"
        },
        {
          "role": "奥兹",
          "text": "各位，我们该动身了。"
        },
        {
          "role": "派蒙",
          "text": "不知道爱德琳小姐有没有给我们准备好吃的点心呢！"
        },
        {
          "type": "subtitle",
          "text": "前往晨曦酒庄寻找爱德琳"
        },
        {
          "role": "爱德琳",
          "text": "冒险家们，欢迎来到晨曦酒庄，我是邀请你们来这里的女仆长爱德琳。"
        },
        {
          "role": "派蒙",
          "text": "谢谢你邀请我们来！"
        },
        {
          "role": "菲谢尔",
          "text": "你就是爱德琳？很好，赐予你与皇女同享下午茶的荣耀。"
        },
        {
          "role": "奥兹",
          "text": "爱德琳女士，感谢您邀请我的主人，断罪的皇女菲谢尔，以及我…"
        },
        {
          "role": "派蒙",
          "text": "好了好了，自报家门到此为止吧！你们的头衔都太长了！"
        },
        {
          "role": "爱德琳",
          "text": "啊呀，是这么有来头的冒险家吗？"
        },
        {
          "role": "菲谢尔",
          "text": "洁白的小使徒，你竟敢打断皇女的外交谈话！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你请我们过来喝茶。",
              "dialogues": []
            },
            {
              "text": "爱德琳小姐找我们有什么事吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "爱德琳",
          "text": "事实上，晨曦酒庄有位名叫哈特曼的工人被卷入了清泉镇的陨石危机。"
        },
        {
          "role": "爱德琳",
          "text": "我听说几位帮着清理了附近的陨石。托你们的福，哈特曼已经醒来了。"
        },
        {
          "role": "爱德琳",
          "text": "于情于理，我都应当请你们过来喝杯茶。此外，还有一些想要麻烦各位的事…"
        },
        {
          "role": "派蒙",
          "text": "爱德琳小姐太客气了，我们只是做了冒险家的分内事而已。"
        },
        {
          "role": "菲谢尔",
          "text": "恩准你为本皇女的恩泽尽情顶礼！喜悦吧，吾之辉光将在清泉小镇永恒闪烁！"
        },
        {
          "role": "旅行者",
          "text": "到底是要永恒还是要闪烁啦。"
        },
        {
          "role": "派蒙",
          "text": "奥兹你先不要翻译，让我猜猜！唔…她的意思是，不用谢！"
        },
        {
          "role": "奥兹",
          "text": "派蒙阁下果真善解人意，这么快就参透了小姐的风格。"
        },
        {
          "role": "旅行者",
          "text": "还有什么需要我们帮忙的吗？"
        },
        {
          "role": "爱德琳",
          "text": "我们晨曦酒庄的产业横跨蒙德璃月两地，有些工人需要来回送货，一走就是好几天。"
        },
        {
          "role": "爱德琳",
          "text": "其中有两位原定昨天回来，但到现在也还没跟我联系。我担心，他们是不是因为这次事件困在哪里了…"
        },
        {
          "role": "爱德琳",
          "text": "最近酒庄里人手不足，我也抽不开身，只能厚着脸皮请各位帮忙了。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样，不用担心，找人我们很在行！"
        },
        {
          "role": "爱德琳",
          "text": "那太好了。从{{颜色|蓝|璃月}}回来一定会经过{{颜色|蓝|石门}}，几位可以去打听一番。"
        },
        {
          "role": "爱德琳",
          "text": "运货用的马车一共有两辆，工人的名字是{{颜色|蓝|弗里茨}}和{{颜色|蓝|本}}。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们会尽力。",
              "dialogues": []
            },
            {
              "text": "放心交给我们吧。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（爱德琳）"
        },
        {
          "role": "爱德琳",
          "text": "希望大家都能平安…"
        },
        {
          "type": "subtitle",
          "text": "前往石门"
        },
        {
          "type": "subtitle",
          "text": "向附近的人打听消息（0/3）"
        },
        {
          "role": "派蒙",
          "text": "你好，我们在找两辆蒙德的马车，上头放满了酒，你有见过吗？"
        },
        {
          "role": "花初",
          "text": "我想想…似乎没有。"
        },
        {
          "role": "派蒙",
          "text": "这样啊，那我们再问问。"
        },
        {
          "type": "subtitle",
          "text": "向附近的人打听消息（1/3）"
        },
        {
          "role": "派蒙",
          "text": "你好！请问你有见过来自蒙德的商队吗？运酒的那种。"
        },
        {
          "role": "老周叔",
          "text": "我…眼睛不好…你找别人…再问问吧…"
        },
        {
          "role": "派蒙",
          "text": "好、好吧…"
        },
        {
          "type": "subtitle",
          "text": "向附近的人打听消息（2/3）"
        },
        {
          "role": "派蒙",
          "text": "你好！我们在找两辆蒙德的马车，你有见过吗？"
        },
        {
          "role": "鉴秋",
          "text": "蒙德的马车？之前好像有一辆，从这儿过去了。"
        },
        {
          "role": "派蒙",
          "text": "真的吗？往哪个方向走的？"
        },
        {
          "role": "鉴秋",
          "text": "我想想啊…应该是往{{颜色|蓝|蒙德}}那个方向。"
        },
        {
          "role": "派蒙",
          "text": "非常感谢，我们这就过去！"
        },
        {
          "type": "subtitle",
          "text": "寻找晨曦酒庄的送货工人"
        },
        {
          "type": "subtitle",
          "text": "解救被怪物围攻的工人"
        },
        {
          "type": "subtitle",
          "text": "与送货工人对话"
        },
        {
          "role": "工人打扮的男子",
          "text": "天哪，吓死我了…谢谢你们！要不是你们刚好路过，我恐怕已经死了。"
        },
        {
          "role": "派蒙",
          "text": "你是本还是弗里茨？"
        },
        {
          "role": "本",
          "text": "哎？我是{{颜色|蓝|本}}！你怎么知道我的名字？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我们不是刚好路过。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我们是专程来找你的哦~"
                }
              ]
            },
            {
              "text": "我们是专程来找你的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥兹",
          "text": "我们受爱德琳小姐要求，特意赶来救助你。"
        },
        {
          "role": "本",
          "text": "看来是路上耽误太久，让她担心了…"
        },
        {
          "role": "本",
          "text": "各位，弗里茨的货车被陨石砸坏了，还停在{{颜色|蓝|荻花洲}}到{{颜色|蓝|石门}}那条大路上。"
        },
        {
          "role": "本",
          "text": "我们说好我先把货运回去，再带人来接他，没想到，半路冒出这么多怪物…"
        },
        {
          "role": "本",
          "text": "耽搁这么久，也不知道弗里茨怎么样了。我担心他也遇上同样的麻烦，你们能救救他吗？"
        },
        {
          "role": "派蒙",
          "text": "{{颜色|蓝|荻花洲}}到{{颜色|蓝|石门}}的路上对吧，包在我们身上！"
        },
        {
          "type": "subtitle",
          "text": "寻找晨曦酒庄的工人弗里茨"
        },
        {
          "type": "subtitle",
          "text": "靠近并确认情况"
        },
        {
          "role": "派蒙",
          "text": "地上这个人是睡着了吗？"
        },
        {
          "role": "？？？",
          "text": "恐怕是的。我用了很多办法，也没能叫醒他。"
        },
        {
          "role": "派蒙",
          "text": "看来，他也摸了这里的陨石…"
        },
        {
          "role": "？？？",
          "text": "是说车上那块石头吗？不必担心，我用法术处理掉了。"
        },
        {
          "role": "？？？",
          "text": "你刚才说「也」的意思是，你们见过其他陷入沉睡的人？"
        },
        {
          "role": "菲谢尔",
          "text": "本皇女的断罪之眼亲眼见证了梦魇从魔骸之谷涌出，清泉镇居民深受其害，正在痛苦中辗转。"
        },
        {
          "role": "奥兹",
          "text": "如您所见，我们刚从其他地方过来。蒙德也有不少人长睡不醒，症状和这位先生一模一样。"
        },
        {
          "role": "？？？",
          "text": "这样啊…看来，陨石造成的影响不小。"
        },
        {
          "role": "派蒙",
          "text": "看打扮，这个人就是晨曦酒庄的工人…我们已经见过本了，那他就是弗里茨吧！"
        },
        {
          "role": "奥兹",
          "text": "工人的衣着可没有太多特征，派蒙阁下眼力真好。"
        },
        {
          "role": "派蒙",
          "text": "我的记性比眼力更好！不过，确实是没什么特征呢…尤其对比身旁这位。"
        },
        {
          "role": "？？？",
          "text": "哈哈，我吗？"
        },
        {
          "role": "派蒙",
          "text": "是啊，我还是头一次见到你这种打扮呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "帽子很大，很有个性。",
              "dialogues": []
            },
            {
              "text": "衣服很特别，很漂亮。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "我是来自稻妻的浮浪人。刚才我正在救助地上这位先生，你们就出现了。"
        },
        {
          "role": "？？？",
          "text": "几位是在调查陨石事件吗？"
        },
        {
          "role": "派蒙",
          "text": "我们是受人所托。"
        },
        {
          "role": "菲谢尔",
          "text": "我乃断罪的皇女菲谢尔，应民众的呼唤挺身而出！"
        },
        {
          "role": "奥兹",
          "text": "我是小姐的眷属夜鸦，奥兹。"
        },
        {
          "role": "派蒙",
          "text": "我是西风骑士团荣誉骑士最好的朋友，派蒙！"
        },
        {
          "role": "？？？",
          "text": "哦？那你就是西风骑士团的荣誉骑士了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我是协会下属的冒险家。",
              "dialogues": []
            },
            {
              "text": "我确实是荣誉骑士。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲谢尔",
          "text": "皇女已经出征，期待吧，昭告命运的圣裁之雷将会肃清这卷携灾厄的噩梦之种！"
        },
        {
          "role": "？？？",
          "text": "呃…呃…？"
        },
        {
          "role": "派蒙",
          "text": "别介意，她就是这个风格。"
        },
        {
          "role": "旅行者",
          "text": "菲谢尔是个很热心的好人呢。"
        },
        {
          "role": "牛志",
          "text": "各位，发生什么事了吗？"
        },
        {
          "role": "派蒙",
          "text": "是千岩军！来得正好，这里有睡着的人！"
        },
        {
          "role": "？？？",
          "text": "既然有千岩军，这里就不需要我了。"
        },
        {
          "role": "？？？",
          "text": "很高兴认识你们。我还有事要办，先走一步。"
        },
        {
          "role": "？？？",
          "text": "祝你们一切顺利，冒险家们。"
        },
        {
          "role": "派蒙",
          "text": "再见！"
        },
        {
          "role": "派蒙",
          "text": "是这样的，我们到这里找人，发现他倒在地上…"
        },
        {
          "role": "牛志",
          "text": "感谢各位，这位患者将由我们千岩军护送至{{颜色|蓝|临时收容点}}。"
        },
        {
          "role": "派蒙",
          "text": "临时收容点？是那种大大的帐篷，旁边有人看护？"
        },
        {
          "role": "牛志",
          "text": "是的。我们在{{颜色|蓝|望舒客栈}}设立了{{颜色|蓝|临时收容点}}，集中收治陷入沉睡的患者。"
        },
        {
          "role": "奥兹",
          "text": "原来如此。明智的决定。"
        },
        {
          "role": "派蒙",
          "text": "我还是有些担心{{颜色|蓝|弗里茨}}的情况…我们过去看看吧！"
        },
        {
          "role": "菲谢尔",
          "text": "没办法了，本皇女屈尊陪你们多走一程吧。"
        },
        {
          "type": "subtitle",
          "text": "前往望舒客栈确认弗里茨的情况"
        },
        {
          "role": "派蒙",
          "text": "果然…这里的情况和清泉镇差不多。"
        },
        {
          "role": "菲谢尔",
          "text": "冷冽的诅咒竟已蔓延至此…天空啊，你因何而愤怒！"
        },
        {
          "role": "派蒙",
          "text": "啊啊，不要在人多的地方大喊大叫啦！"
        },
        {
          "role": "奥兹",
          "text": "{{颜色|蓝|四处打听}}一番，应该会有收获。"
        },
        {
          "type": "subtitle",
          "text": "在客栈的病患中寻找弗里茨"
        },
        {
          "role": "天成",
          "text": "站住！你们是什么人？"
        },
        {
          "role": "派蒙",
          "text": "我们受冒险家协会来调查陨石雨，可以看看他的情况吗？"
        },
        {
          "role": "天成",
          "text": "原来是冒险家，好的！"
        },
        {
          "role": "昏睡的病患",
          "text": "呜…呜…"
        },
        {
          "role": "旅行者",
          "text": "这个人也还没醒来。"
        },
        {
          "role": "派蒙",
          "text": "他现在做着怎样的梦呢？唔…大概也是那个雪山的梦吧。"
        },
        {
          "role": "奥兹",
          "text": "弗里茨似乎不在这里，再打听一下吧。"
        },
        {
          "type": "subtitle",
          "text": "继续打听弗里茨的下落"
        },
        {
          "role": "派蒙",
          "text": "这里也有睡着的人！"
        },
        {
          "role": "菲谢尔",
          "text": "苦痛的荆棘缠绕着这条灵魂…可怜的人，愿你获得宁静。"
        },
        {
          "role": "派蒙",
          "text": "获得宁静？"
        },
        {
          "role": "奥兹",
          "text": "皇女当然没有别的意思了，她衷心希望这位患者能好起来。"
        },
        {
          "role": "派蒙",
          "text": "弗里茨，你到底在哪里啊？"
        },
        {
          "type": "subtitle",
          "text": "在剩余病患中寻找弗里茨"
        },
        {
          "role": "奥兹",
          "text": "又是沉睡者。"
        },
        {
          "role": "菲谢尔",
          "text": "被罪恶之桩钉在灾难之柱上的人，太不幸了。"
        },
        {
          "role": "旅行者",
          "text": "一定要想办法唤醒大家。"
        },
        {
          "role": "菲谢尔",
          "text": "唤醒这些人的唯一办法，便是降下圣裁之雷。"
        },
        {
          "role": "奥兹",
          "text": "皇女所言极是！清理掉各地的陨石，患者自然会醒来。"
        },
        {
          "role": "派蒙",
          "text": "奇怪，弗里茨不是被千岩军送过来了吗？怎么到处都没找到他？"
        },
        {
          "role": "派蒙",
          "text": "唔…去问问{{颜色|蓝|掌柜}}好了！"
        },
        {
          "type": "subtitle",
          "text": "向掌柜淮安打听弗里茨的事"
        },
        {
          "role": "派蒙",
          "text": "掌柜的，这里有没有一个蒙德工人打扮的男人？"
        },
        {
          "role": "淮安",
          "text": "几位找的人刚被千岩军送来不久。底下帐篷有限，我已将他安置在楼上客房。"
        },
        {
          "role": "派蒙",
          "text": "等他醒来，请掌柜转告他，尽快回晨曦酒庄向爱德琳小姐报个平安。"
        },
        {
          "role": "淮安",
          "text": "自当如此。"
        },
        {
          "role": "淮安",
          "text": "说起这事，冒险家们，在下有个不情之请。"
        },
        {
          "role": "奥兹",
          "text": "这位先生有什么烦恼吗？"
        },
        {
          "role": "菲谢尔",
          "text": "尽管说吧，让本皇女知晓你的困境。"
        },
        {
          "role": "淮安",
          "text": "听千岩军的将士们说，你们是专程过来调查陨石雨的。"
        },
        {
          "role": "淮安",
          "text": "各位方才说的话提点了我，莫非蒙德方面已经找到治疗昏睡症的办法？"
        },
        {
          "role": "派蒙",
          "text": "我们的经验是，清理掉陨石，就能唤醒附近的人。"
        },
        {
          "role": "淮安",
          "text": "原来如此…意思是，昏睡的主因就是这些陨石？"
        },
        {
          "role": "派蒙",
          "text": "没错！"
        },
        {
          "role": "淮安",
          "text": "我想委托各位的就是这件事。你们看，能不能帮着把{{颜色|蓝|客栈附近}}的{{颜色|蓝|陨石}}清一清？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只要能找到，就能清理。",
              "dialogues": []
            },
            {
              "text": "还请您告知陨石的所在地。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "淮安",
          "text": "太感谢了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（淮安）"
        },
        {
          "role": "淮安",
          "text": "我会空一间客房给您，以防您也睡着了的情况…"
        },
        {
          "role": "淮安",
          "text": "不对，好像这么说有些太晦气了，还是祝您好运吧。"
        },
        {
          "type": "subtitle",
          "text": "寻找望舒客栈附近的陨石"
        },
        {
          "type": "subtitle",
          "text": "清理陨石"
        },
        {
          "type": "subtitle",
          "text": "确认附近是否有残留陨石"
        },
        {
          "type": "subtitle",
          "text": "清理残留陨石"
        },
        {
          "role": "愚人众先遣队",
          "text": "可恶…别以为就这么算了。我们的执行官也在附近，大家走着瞧！"
        },
        {
          "role": "派蒙",
          "text": "愚人众也在调查陨石？而且连执行官都出动了！"
        },
        {
          "role": "派蒙",
          "text": "真奇怪…我们最好小心一些。"
        },
        {
          "role": "菲谢尔",
          "text": "没想到噩梦之种如此难缠…就算用至夜的魔箭于须臾间肃清，可它卷土重来的态势也过于险恶…哼，这样下去，实在有损断罪皇女的威仪！"
        },
        {
          "role": "奥兹",
          "text": "确实。虽说我们始终忙于清理，陨石雨却陆续降落在大陆各处，这样下去，恐怕…"
        },
        {
          "role": "派蒙",
          "text": "清理的速度很难跟上降落的速度呢。"
        },
        {
          "role": "旅行者",
          "text": "看来，得找找方法了。"
        },
        {
          "role": "菲谢尔",
          "text": "我菲谢尔·冯·露弗施洛斯·那菲多特行遍一千宇宙，也从未遇见过如此棘手的敌人。"
        },
        {
          "role": "菲谢尔",
          "text": "既不是纯粹的恶魔，也不是单调的秘术…这片大地，正在诅咒人间。"
        },
        {
          "role": "派蒙",
          "text": "诅咒？！"
        },
        {
          "role": "菲谢尔",
          "text": "只有求而不得的连绵嗟叹，交织在无常变幻的命运之中，才会产生这种邪咒…"
        },
        {
          "role": "奥兹",
          "text": "太可悲了，这就是人类的宿命吗？无论多少次，我都觉得痛心。"
        },
        {
          "role": "派蒙",
          "text": "什么跟什么…难道这些陨石真的是诅咒吗？"
        },
        {
          "role": "菲谢尔",
          "text": "如果不是「人」的诅咒，为什么会令「人」长眠不醒？生者陷入梦境，成为了不死亦不活的亡者，多么可畏。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "（难道一切真如菲谢尔所说吗？）",
              "dialogues": []
            },
            {
              "text": "（那些人梦见的事…是诅咒？）",
              "dialogues": []
            }
          ]
        },
        {
          "role": "菲谢尔",
          "text": "不能再掉以轻心了！就算拼上你我所有力量，也难以抵抗这股黑暗之力。"
        },
        {
          "role": "菲谢尔",
          "text": "旅行者，去为我请来命中注定的{{颜色|蓝|那个人}}吧！"
        },
        {
          "role": "派蒙",
          "text": "谁？"
        },
        {
          "role": "奥兹",
          "text": "小姐认为目前最好的选择是请专家来解决专业问题。关于破除诅咒，你心中有什么人选吗？"
        },
        {
          "role": "旅行者",
          "text": "我不敢确定。"
        },
        {
          "role": "派蒙",
          "text": "唔…唔…"
        },
        {
          "role": "派蒙",
          "text": "啊啊啊可恶，我也想不出来！不然还是去问问{{颜色|蓝|凯瑟琳}}吧？"
        },
        {
          "type": "subtitle",
          "text": "询问蒙德的凯瑟琳"
        },
        {
          "role": "菲谢尔",
          "text": "命定之刻将至，凯瑟琳！祝圣之圣约已向你做出启示，我需要那个答案。"
        },
        {
          "role": "凯瑟琳",
          "text": "让我想想…难道你们需要帮手？"
        },
        {
          "role": "派蒙",
          "text": "居然一听就懂，凯瑟琳真是太厉害了！"
        },
        {
          "role": "旅行者",
          "text": "有没有诅咒、咒术方面的专家？"
        },
        {
          "role": "凯瑟琳",
          "text": "咒术恐怕没有。不过，占星术士倒是有一个。"
        },
        {
          "role": "凯瑟琳",
          "text": "云游的占星术士{{颜色|蓝|莫娜}}恰好也在蒙德。你知道她吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "知道，我们认识哦。 {{#info:完成[[占星术与五十年之约]]|info}}",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "那就好办了，稍等，我这就叫她过来。"
                },
                {
                  "role": "莫娜",
                  "text": "有人找我吗？哪位？"
                },
                {
                  "role": "旅行者",
                  "text": "是莫娜！"
                },
                {
                  "role": "莫娜",
                  "text": "咦，居然是你！"
                },
                {
                  "role": "莫娜",
                  "text": "说吧，找我有什么事？"
                }
              ]
            },
            {
              "text": "不太清楚呢。",
              "dialogues": [
                {
                  "role": "凯瑟琳",
                  "text": "稍等片刻，我这就联系她。"
                },
                {
                  "role": "派蒙",
                  "text": "占星术士，好期待呀！"
                },
                {
                  "role": "莫娜",
                  "text": "凯瑟琳，看你匆匆忙忙的，出什么事了吗？"
                },
                {
                  "role": "凯瑟琳",
                  "text": "莫娜，这几位是协会里的冒险家。他们遇到一些难题，希望能借用你的占星术来解决。"
                },
                {
                  "role": "莫娜",
                  "text": "哦？眼光不错嘛，居然知道我莫娜是大陆上百年难遇的天才占星术士！"
                },
                {
                  "role": "莫娜",
                  "text": "那么，求助的人就是你吗？"
                },
                {
                  "role": "旅行者",
                  "text": "你好。"
                },
                {
                  "role": "莫娜",
                  "text": "说吧，遇到什么困难了？我会根据你的回答决定要不要出手。"
                }
              ]
            }
          ]
        },
        {
          "role": "莫娜",
          "text": "占星术可是非常古老神秘的学科。如果只是一般小事，根本不需要劳烦我。"
        },
        {
          "role": "派蒙",
          "text": "其实是这样的…"
        },
        {
          "role": "莫娜",
          "text": "陨石雨竟然造成这么严重的后果…真没想到。"
        },
        {
          "role": "菲谢尔",
          "text": "黑暗无处不在，唯有皇女与她的伙伴仍在光影交汇处行走。"
        },
        {
          "role": "奥兹",
          "text": "莫娜女士，你的力量很重要。"
        },
        {
          "role": "莫娜",
          "text": "欸？你们也是一起的吗？"
        },
        {
          "role": "菲谢尔",
          "text": "我乃断罪之皇女菲谢尔·冯·露弗施洛斯·那菲多特，你将得到与我同行的殊荣。"
        },
        {
          "role": "莫娜",
          "text": "断罪的皇女？是哪个国家的公主吗？"
        },
        {
          "role": "菲谢尔",
          "text": "幽夜净土，一个古老的、已经灭亡的国度…那就是我的故乡。"
        },
        {
          "role": "莫娜",
          "text": "幽…什么？"
        },
        {
          "role": "菲谢尔",
          "text": "唉，凡人几乎都不知道幽夜净土。"
        },
        {
          "role": "莫娜",
          "text": "凡…你说谁是凡人啊！我可是很厉害的占星术士！"
        },
        {
          "role": "莫娜",
          "text": "不管是幽什么土，只要稍加占卜，就能知道你的来历了，我这就——"
        },
        {
          "role": "奥兹",
          "text": "莫娜女士！还请您不要深究这点。提起灭亡的故国，小姐总会心情低落。"
        },
        {
          "role": "奥兹",
          "text": "您这样伟大的术士，一定能谅解亡国皇女的小小悲伤，对吗？"
        },
        {
          "role": "莫娜",
          "text": "不，这…"
        },
        {
          "role": "旅行者",
          "text": "抱歉打断你们，还是工作优先吧。"
        },
        {
          "role": "莫娜",
          "text": "呃咳咳，说得也是。"
        },
        {
          "role": "莫娜",
          "text": "所以，你们的目的是救醒所有陷入梦境的人，没错吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是的，他们需要帮助。",
              "dialogues": []
            },
            {
              "text": "嗯，不能放着不管。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莫娜",
          "text": "明白了，既然如此，就由我莫娜来助你们一臂之力吧！"
        },
        {
          "role": "莫娜",
          "text": "不过得先挪个地方，蒙德城里魔力干扰太多，到{{颜色|蓝|地脉流动简单些}}的地方去吧。"
        },
        {
          "type": "subtitle",
          "text": "前往莫娜指定的占卜地点"
        },
        {
          "role": "莫娜",
          "text": "嗯，这里地形开阔，天空也很清澈。"
        },
        {
          "role": "莫娜",
          "text": "就选这儿吧！"
        },
        {
          "role": "莫娜",
          "text": "我要开始占卜了，请你们后退，不要占据我的视野。"
        },
        {
          "role": "派蒙",
          "text": "虽然不明白发生了什么，但好厉害的样子呢！"
        },
        {
          "role": "菲谢尔",
          "text": "群星的使者，你的双眼是否已将命运的默示录探寻清楚？"
        },
        {
          "role": "派蒙",
          "text": "对对对，占卜出什么了吗？"
        },
        {
          "role": "莫娜",
          "text": "好神奇，我也是第一次看到。"
        },
        {
          "role": "莫娜",
          "text": "根据占卜结果，这些{{颜色|蓝|陨石}}似乎是某个人的{{颜色|蓝|命之座}}。"
        },
        {
          "role": "派蒙",
          "text": "命之座？可是，命之座不是占星学上的概念吗？"
        },
        {
          "role": "莫娜",
          "text": "一般来说，普通人都会这么想。但我研究占星术已久，知道一些你们不知道的事。"
        },
        {
          "role": "莫娜",
          "text": "「命之座」上的「命星」，是真实存在于天空深处的星体，并不是仅存于概念中的东西。"
        },
        {
          "role": "莫娜",
          "text": "奇怪的是，不知为何，它们化作陨石坠落了…原因暂时还不清楚，给我一点时间。"
        },
        {
          "role": "菲谢尔",
          "text": "是诅咒，有人加了诅咒！"
        },
        {
          "role": "莫娜",
          "text": "诅咒？！"
        },
        {
          "role": "菲谢尔",
          "text": "本皇女驰骋星间，已从黑暗的幕帘之后窥见真相的一角。被诅咒的大地，「人」的恶念…"
        },
        {
          "role": "菲谢尔",
          "text": "唯有死状十分痛苦的人，才会留下如此深重的怨恨。"
        },
        {
          "role": "菲谢尔",
          "text": "应该质问这片土地的住民，究竟是何人犯下不可容赦的罪孽！谁让亡灵诞生，谁就是真正的凶手！"
        },
        {
          "role": "莫娜",
          "text": "等一下，我有点糊涂了…诅咒？凶手？"
        },
        {
          "role": "派蒙",
          "text": "不不，你不用太把她的话放在心上啦！"
        },
        {
          "role": "莫娜",
          "text": "（什么情况，派蒙和旅行者都在疯狂对我眨眼？）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "菲谢尔是一个…活泼的人哦。",
              "dialogues": []
            },
            {
              "text": "菲谢尔是一个…神奇的人哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莫娜",
          "text": "啊…啊！我明白了！"
        },
        {
          "role": "菲谢尔",
          "text": "是吗？你能明白真是太好了，群星的使者！"
        },
        {
          "role": "奥兹",
          "text": "取得共识是团队协作的第一步。莫娜女士，欢迎你加入我们。"
        },
        {
          "role": "菲谢尔",
          "text": "领受这份契约，向皇女献上你的力量，切记，我们有责任拨开黑暗。"
        },
        {
          "role": "莫娜",
          "text": "嗯咳咳！你应该庆幸遇到的是我，我能让你们事半功倍哦！"
        },
        {
          "role": "派蒙",
          "text": "莫娜看起来好可靠啊！"
        },
        {
          "role": "莫娜",
          "text": "啊哈哈哈，当然当然！尽情夸奖我吧！"
        },
        {
          "role": "莫娜",
          "text": "我的星盘已经捕捉到命运的轨迹。接下来，我会为你们算出{{颜色|蓝|陨石坠落的位置}}。"
        },
        {
          "role": "莫娜",
          "text": "关于命之座的详情，我会继续推算。你找到线索记得尽快通知我。"
        },
        {
          "role": "旅行者",
          "text": "莫娜你真棒！谢谢你！"
        },
        {
          "role": "莫娜",
          "text": "哼哼，不用在意，这种程度的占卜对我来说只是小菜一碟。"
        }
      ],
      "collapse_ranges": [
        [
          40,
          41
        ],
        [
          154,
          156
        ]
      ]
    }
  ]
}