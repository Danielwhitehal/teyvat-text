{
  "quest_id": 10154,
  "chapter_num": "水仙的追迹·第三幕",
  "chapter_title": "大梦的醒转",
  "type": "wq",
  "route": "Waking From the Great Dream",
  "stories": [
    {
      "story_id": 74165,
      "title": "大梦的醒转",
      "description": "在原始胎海中，去直面水仙十字的救世梦想。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "进入洋流"
        },
        {
          "type": "subtitle",
          "text": "前进"
        },
        {
          "type": "subtitle",
          "text": "进入场景：某微观宇宙的肇始",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "这里是…胎海？"
        },
        {
          "role": "？？？",
          "text": "归来之日已至…"
        },
        {
          "role": "派蒙",
          "text": "是、是谁的声音？"
        },
        {
          "type": "subtitle",
          "text": "与眼前的巨物对话"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我…感受到了「理性」。到来之人，汝等是水仙十字的后继者，还是齿轮的鹰犬？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "对我拔剑相向了，看来答案不言自明。"
        },
        {
          "role": "安",
          "text": "纳齐森科鲁兹…"
        },
        {
          "role": "派蒙",
          "text": "欸？这个东西就是纳齐森科鲁兹吗？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "既然已听闻我名，那汝等自当理解我救世之道义。既已听闻我名，尔等意识之内便有得救的种子。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "想来尔等对我兵锋相向，应该是被谎言所欺骗。如此时机，我也不想浪费太多力量。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "欣喜吧，喝彩吧。在一切结束之后我来解答，我来展现。现在把圣剑归还到我的手中，然后离开避难吧。"
        },
        {
          "role": "派蒙",
          "text": "才不能把圣剑给你。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "愚蠢啊愚蠢。但是我原谅尔等，就算如此我也会拯救尔等。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我感觉到了，四象限虽然得以逆转，但是涌流之树的全图并没有完成。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "已经没有办法拯救所有人了。我将最大程度延展我的慈悲，透支我的生命。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "然后只能救五成的人，我就尽力去救下六成的人。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "现在，我要来取圣剑了。"
        },
        {
          "type": "subtitle",
          "text": "击败纳齐森科鲁兹"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "为什么要如此决绝地挡在我面前？你们难道不知道末日已经逼近了吗？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "…罢了。拯救世界的巡礼常伴世人之不解。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "啊，凡俗宇宙的暴力不足以和尔等相抗衡。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "给尔等展示超越物质世界法则的「不灭」本质与审判的「锋刃之雨」吧。"
        },
        {
          "role": "派蒙",
          "text": "呜啊，这该怎么办啊！"
        },
        {
          "type": "subtitle",
          "text": "圣剑引导了胎海洋流，进入其中躲避「锋刃之雨」。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "「理性」在引导你们逃避吗？没有用的。你们会在胎海中面对自我的「隙漏」。"
        },
        {
          "role": "派蒙",
          "text": "所以我们需要躲开那个裂隙一样的东西是吧！"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "为什么不敢面对自己缺陷的具象化！这么没有骨气的吗？"
        },
        {
          "role": "派蒙",
          "text": "圣剑似乎在指引我们去触碰这个…气泡？有什么…唔，神秘哲学上的象征意义吗？"
        },
        {
          "type": "subtitle",
          "text": "使用{{颜色|红|重击}}会进行特殊攻击，可有效伤害纳齐森科鲁兹。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "哇，好厉害的招式，我要给它起个厉害的名字！"
        },
        {
          "role": "派蒙",
          "text": "对了，「开辟十字斩」！"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "难道是「理性」让你们如此强大吗？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "不，我已经有所觉察。难道你一直处在我所追求的境界吗？和世界等价的崇高之人啊。"
        },
        {
          "type": "subtitle",
          "text": "击败'''{{图标|纳齐森科鲁兹}}'''",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "与纳齐森科鲁兹对话"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "不可能…我明明已经登达了「不退还」之位阶。为什么，跌落到了如此境界。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "对原始胎海的掌控也彻底丧失了。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "为什么，为什么会这样？为什么，为什么你们要这么做！"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "新世界无法诞生，所有人都要在蛋壳之梦里死去了！"
        },
        {
          "role": "派蒙",
          "text": "你才是早点从自己的梦里醒过来吧。"
        },
        {
          "role": "派蒙",
          "text": "世界末日这种事，当然是全世界的人一起想办法解决的事情啦。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我明白了，是圣剑，它没有站在我这边。它每一次挥动都切削了围聚在我周身的众生意志。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "直到最后，我懦弱的凡人性——我的人格也回到了我的体内。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "胎海泛滥并没有那么快。",
              "dialogues": [
                {
                  "role": "纳齐森科鲁兹",
                  "text": "我已经有所察觉，最早填入「世界式」的输入值出现了变动。"
                },
                {
                  "role": "纳齐森科鲁兹",
                  "text": "有谁掌控了生命之力，又有什么人开辟了兽之国度。"
                },
                {
                  "role": "纳齐森科鲁兹",
                  "text": "还有一个「变量」，那就是你啊。"
                },
                {
                  "role": "纳齐森科鲁兹",
                  "text": "注定见证吞食一切之鲸败走的人，一切的见证者。"
                },
                {
                  "role": "纳齐森科鲁兹",
                  "text": "原来是这样，原来是这样。"
                }
              ]
            },
            {
              "text": "那条鲸已经被打败了。{{#info:完成魔神任务第四章第五幕[[罪人舞步旋]]}}",
              "dialogues": [
                {
                  "role": "纳齐森科鲁兹",
                  "text": "我本该有所察觉，最早填入「世界式」的输入值出现了变动。有「变量」降临此间。"
                },
                {
                  "role": "纳齐森科鲁兹",
                  "text": "并非是所有宇宙外到来的事物都能被叫做「降临」或者「变量」。"
                },
                {
                  "role": "纳齐森科鲁兹",
                  "text": "原来我少算了一个「变量」，那就是你啊。"
                },
                {
                  "role": "纳齐森科鲁兹",
                  "text": "一切的见证者，一切的记录者，一切的设计者。"
                },
                {
                  "role": "纳齐森科鲁兹",
                  "text": "唯有自身等价一个世界的人才能担此头衔。"
                }
              ]
            }
          ]
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我也做过这样的梦，想要成为你这样的事物。不过这个梦，刚刚破碎了。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我所做的一切都毫无意义，就像是一个空虚的梦。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "不，甚至不如一个梦。至少梦是无害的。而我……不，你们，还有他们却为这件事付出了那么多。"
        },
        {
          "role": "安",
          "text": "纳齐森科鲁兹。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "啊，是你。我都没有发现。"
        },
        {
          "role": "安",
          "text": "你能知道我究竟是谁吗？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "名字只是一个称呼。混在你灵魂里的两种颜色，我都是再熟悉不过了。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "莉利丝院长不知道发生了什么，她只是抱住了一息尚存的玛丽安。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "她理解不了过于复杂的当下与未来，是想要留住过去。于是她做了她唯一会做的事情。"
        },
        {
          "role": "安",
          "text": "我叫做安。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "那么，你好，安。"
        },
        {
          "role": "安",
          "text": "我愿意原谅你。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "你在说什么奇怪的话。从一开始我的规划就有着崇高与神圣的目的。这中间没有私心。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "没有人能评价我，没有人能审判我，没有人能原谅我。"
        },
        {
          "role": "安",
          "text": "你的目的或许是崇高的，但是你的疯狂伤害了很多人。"
        },
        {
          "role": "安",
          "text": "你连算式的输入都没填对。犯错然后被原谅，有什么问题吗？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "…你说得对。我很抱歉。"
        },
        {
          "role": "安",
          "text": "然后纳齐森科鲁兹，你和我们回去吧，你需要见一见其他人。"
        },
        {
          "role": "派蒙",
          "text": "虽然这家伙好像变得很好说话了，但是这种要求…"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "没问题。"
        },
        {
          "role": "派蒙",
          "text": "欸！一般不是要做点心理斗争然后让我们劝个半天的吗？"
        },
        {
          "type": "subtitle",
          "text": "未完成「罪人舞步旋」"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "正如我之前所说，我并未觉得自己有任何负罪。如今伟业惜溃，但是世界注定得救。"
        },
        {
          "type": "subtitle",
          "text": "已完成「罪人舞步旋」"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "正如我之前所说，我并未觉得自己有任何负罪。如今伟业惜溃，但是世界已然得救。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "任由他人责骂与嘲笑我吧。我的内心已经空落，徒余一种渴望。"
        },
        {
          "role": "派蒙",
          "text": "是什么呢？"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "我也想回到最开始的时候。水仙的勇者还没有踏上旅程的时候。"
        },
        {
          "role": "纳齐森科鲁兹",
          "text": "不过这已经办不到了。决定人命运的终究不是人自己，如今我连让自己做什么梦的力量也丢失了。"
        },
        {
          "role": "安",
          "text": "那，旅行者骑士，准备好之后我们就去重新封印胎海然后离开这里吧。"
        }
      ]
    }
  ]
}