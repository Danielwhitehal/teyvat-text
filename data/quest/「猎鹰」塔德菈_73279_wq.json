{
  "quest_id": 73279,
  "chapter_num": null,
  "chapter_title": "「猎鹰」塔德菈",
  "type": "wq",
  "route": "Tadhla the Falcon",
  "stories": [
    {
      "story_id": 73279,
      "title": "「猎鹰」塔德菈",
      "description": "马塞拉的「猎鹰」塔德菈去执行任务许久未归，他请求我们去寻找他的「猎鹰」…",
      "dialogues": [
        {
          "role": "马塞拉",
          "text": "啊，旅行者，尊贵的「镇灵主人」，大驾光临，令我受宠若惊。"
        },
        {
          "role": "利露帕尔",
          "text": "好呀，又是一个沙漠奴才。我的大人…唉，算了，您有您自己的判断，我相信您就是了。"
        },
        {
          "role": "马塞拉",
          "text": "不知您是否有闲暇赏光…我如同企盼明月和雨露一般，企望您的到来。"
        },
        {
          "role": "利露帕尔",
          "text": "无事献殷勤，必不怀好意，你不如说得明白些。"
        },
        {
          "role": "马塞拉",
          "text": "很好，镇灵大人…我的确有事相求。"
        },
        {
          "role": "马塞拉",
          "text": "哈哈，没什么大事…是我的猎鹰，塔德菈…她应该是遇险了。"
        },
        {
          "role": "马塞拉",
          "text": "唉…如果不是因为我的腿脚不行，也就不用麻烦您了。"
        },
        {
          "role": "派蒙",
          "text": "我明白了，所以我们要去救她，然后你会谢谢我们，给我们好多摩拉，我们再去大吃一顿庆祝胜利！对吧？"
        },
        {
          "role": "马塞拉",
          "text": "呃…是的，是的。"
        },
        {
          "role": "派蒙",
          "text": "如果是这样的话，就交给我们好啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "每到这种时候，逻辑就格外清晰呢…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "唉…那就这样吧，为了这贪婪的小家伙能大吃一顿。"
        },
        {
          "role": "马塞拉",
          "text": "万分感谢…那么这件事就拜托给您了。"
        },
        {
          "role": "马塞拉",
          "text": "啊…她最后出现的地点，在这里，请让我为您标出来…"
        },
        {
          "role": "马塞拉",
          "text": "你们要找的人，塔德菈…她的个子很高，肤色黝黑，留着浅色的长发，手持长弓…嗯，这些信息应该够了。"
        },
        {
          "role": "马塞拉",
          "text": "怎么样，你们记住了吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯…高个子，深色皮肤的女孩子，浅色长发，还拿着长弓！嘿嘿，我记性很好的！"
        },
        {
          "role": "马塞拉",
          "text": "嗯…愿流风引导您穿越黄沙，避开重重险阻。"
        },
        {
          "role": "派蒙",
          "text": "好，我们走啦！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（马塞拉）"
        },
        {
          "role": "'心声'",
          "text": "（…或许她，太低估这几个小家伙了呢…）"
        },
        {
          "role": "马塞拉",
          "text": "怎么，你们找到她了？"
        },
        {
          "role": "马塞拉",
          "text": "啊，还需要时间，是吧…"
        },
        {
          "role": "马塞拉",
          "text": "那么还要劳烦你们尽快救出塔德菈…时间不等人呀。"
        },
        {
          "type": "subtitle",
          "text": "前往塔德菈最后出现的地方"
        },
        {
          "role": "派蒙",
          "text": "塔德菈不在这里呢…我们再往前找找吧？"
        },
        {
          "role": "利露帕尔",
          "text": "你看，这里有很多脚印，看来盘踞在这座洞里的家伙直到最近还很活跃…哼，这么不谨慎吗？"
        },
        {
          "role": "派蒙",
          "text": "有道理呢，我们也进去调查一下吧！"
        },
        {
          "type": "subtitle",
          "text": "深入探索"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "嘘…！你看…有人在那边…！"
        },
        {
          "role": "利露帕尔",
          "text": "哦…我的大人，这些人…就是此前你们曾反复提及的「蠢人众」吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是「愚人众」…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "利露帕尔",
          "text": "有区别吗？"
        },
        {
          "role": "派蒙",
          "text": "你小声一点啦！万一被发现了…"
        },
        {
          "role": "利露帕尔",
          "text": "没关系的，他们听不到我说话。不信你们看…"
        },
        {
          "role": "利露帕尔",
          "text": "喂！大胖子！我在这边！开饭了，开饭了！"
        },
        {
          "role": "愚人众先遣队员甲",
          "text": "嗯…？你听到什么了吗？"
        },
        {
          "role": "愚人众先遣队员乙",
          "text": "没有，怎么了？"
        },
        {
          "role": "愚人众先遣队员甲",
          "text": "唔…我还以为开饭了呢。"
        },
        {
          "role": "利露帕尔",
          "text": "哼哼，看吧？"
        },
        {
          "role": "派蒙",
          "text": "利露帕尔也会玩这种小孩子把戏呀…嘿嘿，总觉得有点可爱呢！"
        },
        {
          "role": "派蒙",
          "text": "你看…那边！他们关押的那个是不是塔德菈呀！"
        },
        {
          "role": "派蒙",
          "text": "唔我记得她…个子很高，肤色黝黑，留着浅色的长发…应该就是她了。"
        },
        {
          "role": "利露帕尔",
          "text": "记性不错嘛，小家伙。我们动手吧，我的大人。"
        },
        {
          "role": "派蒙",
          "text": "好，旅行者，我们动手吧！"
        },
        {
          "type": "subtitle",
          "text": "击败愚人众"
        },
        {
          "role": "愚人众先遣队员甲",
          "text": "你们又是谁！看好那个女孩，我们上！"
        },
        {
          "role": "愚人众先遣队员甲",
          "text": "是那个沙漠女人部落的客人，可恶…芭别尔在搞什么鬼！"
        },
        {
          "role": "愚人众先遣队员甲",
          "text": "放弃据点，撤退！我们撤退！"
        },
        {
          "role": "利露帕尔",
          "text": "他们逃走了，唉…为何如此心慈手软呢，我的大人？"
        },
        {
          "type": "subtitle",
          "text": "阅读（佐娅·雪奈茨芙娜大尉的行动报告·其一）"
        },
        {
          "type": "subtitle",
          "text": "…到目前为止，我们同塔尼特部族的合作十分顺利。长老芭别尔与阿萨里格明确表示愿意合作，如果帮助她接管整个部族，对沙漠远征队深入勘探「永恒绿洲」的工作将有莫大助益…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "…塔尼特部族内部的权力交接已然完成，其他八位长老都被清理掉了…比我们预计的要快许多。不知道芭别尔用了什么手段，也许是请来了新的杀手…一些人出走了，一些人消失了…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "…塔尼特部族被芭别尔和阿萨里格整顿得井井有条，似乎前不久的动荡并未对部族造成明显的破坏…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "…也许是好事，也许对我们来说并不是好事…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "…无论如何，现在是我们兑现承诺的时候了。塔尼特部族将获得至冬国的物资与技术援助…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "与塔德菈对话"
        },
        {
          "type": "subtitle",
          "text": "心声（塔德菈）"
        },
        {
          "role": "塔德菈",
          "text": "（…可恶，使不上力气…）"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "那个…你就是塔德菈吗？我们是来救你的！"
        },
        {
          "role": "塔德菈",
          "text": "嗯…？嗯。"
        },
        {
          "role": "塔德菈",
          "text": "你把他们放走了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那些人构不成威胁了。",
              "dialogues": []
            },
            {
              "text": "没必要赶尽杀绝。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "塔德菈",
          "text": "…他们会回去，告诉其他人。这样他们都会知道我们在这里。"
        },
        {
          "role": "利露帕尔",
          "text": "你看，智者所见略同。我喜欢这女孩。"
        },
        {
          "role": "派蒙",
          "text": "那些不要紧啦！他们再来，我们就再把他们打跑！不过你受伤了…需要我们帮忙吗？"
        },
        {
          "role": "塔德菈",
          "text": "我还好，还能走，还能找个地方自己死去。"
        },
        {
          "role": "派蒙",
          "text": "哦…那还好啦，她还能找个地方——喂，一点也不好吧！"
        },
        {
          "role": "塔德菈",
          "text": "我开玩笑的。"
        },
        {
          "role": "利露帕尔",
          "text": "哈哈。"
        },
        {
          "role": "利露帕尔",
          "text": "我喜欢这女孩的幽默感…若有似无的。"
        },
        {
          "role": "塔德菈",
          "text": "谢谢你们，我们回去吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你的腿脚方便吗？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "不方便，但也不需要搀扶。"
                }
              ]
            },
            {
              "text": "不休息一下吗？",
              "dialogues": [
                {
                  "role": "塔德菈",
                  "text": "休息…？不，我们还没那么熟。"
                },
                {
                  "role": "利露帕尔",
                  "text": "但我觉得我们可以认识一下，怎么样？"
                },
                {
                  "role": "塔德菈",
                  "text": "谢谢，以后吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与马塞拉对话"
        },
        {
          "role": "利露帕尔",
          "text": "孩子，所以说…你是马塞拉的「女儿」？"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "利露帕尔",
          "text": "哼…不太爱说话，是吧？"
        },
        {
          "role": "派蒙",
          "text": "「女儿」…？我怎么记得，马塞拉说的是「猎鹰」呀？"
        },
        {
          "role": "利露帕尔",
          "text": "噗…毕竟这孩子还是个人类，人类怎么做别人的猎鹰呢？"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "马塞拉",
          "text": "啊，我的小猎鹰回来了！谢谢你们！"
        },
        {
          "role": "塔德菈",
          "text": "抱歉…我遭到了伏击，多亏他们相救，我才能回来见您。"
        },
        {
          "role": "马塞拉",
          "text": "「他们」…？是我们尊贵的「镇灵主人」！"
        },
        {
          "role": "塔德菈",
          "text": "对不起…"
        },
        {
          "role": "派蒙",
          "text": "没关系，没关系啦！塔德菈受伤了，你也对她好些嘛！"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "马塞拉",
          "text": "…你受伤了？"
        },
        {
          "role": "塔德菈",
          "text": "…对不起。"
        },
        {
          "role": "马塞拉",
          "text": "是什么动物把你搞成这样的？是人？"
        },
        {
          "role": "塔德菈",
          "text": "是北方人，我遭到了北方人的伏击…他们发现自己被跟踪了，就设下埋伏…"
        },
        {
          "role": "马塞拉",
          "text": "设下埋伏的应该是你才对。"
        },
        {
          "role": "马塞拉",
          "text": "被猎物反咬成这个样子，对猎鹰来说，像什么样子…"
        },
        {
          "role": "塔德菈",
          "text": "……"
        },
        {
          "role": "马塞拉",
          "text": "…去休息吧，你需要休息。稍后我会为你疗伤。"
        },
        {
          "type": "subtitle",
          "text": "塔德菈只是默默点点头，忍着疼痛缓步离开了。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "马塞拉对塔德菈有点苛刻呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们之间关系…不好吗？",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "嗯？不，怎么会呢！她是我最爱的「猎鹰」…我爱她，但不溺爱她。猎鹰没有给你带回猎物的话，怎么能喂饱它呢？"
                },
                {
                  "role": "利露帕尔",
                  "text": "原来是这样…哼，那女孩不会有好结果的。"
                }
              ]
            },
            {
              "text": "请不要太苛待塔德菈。",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "苛待？不，我太纵容她了，她的本领退步了…我只是在教育她而已，她是个优秀的「猎鹰」，我怎会忍心伤害她呢。"
                },
                {
                  "role": "利露帕尔",
                  "text": "那么猎鹰的结局，往往是什么样呢…"
                }
              ]
            }
          ]
        },
        {
          "role": "马塞拉",
          "text": "这些报酬请您一定收下，感谢您，尊贵的「镇灵主人」。"
        },
        {
          "role": "利露帕尔",
          "text": "咳咳，你是不是忘了什么？这里还有两个人呢？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，其中一个也不算「人」吧…"
        },
        {
          "role": "利露帕尔",
          "text": "哦…我忘了，这个小精灵不是人。不过我们也应该得到感谢吧？"
        },
        {
          "role": "派蒙",
          "text": "喂——！"
        },
        {
          "role": "马塞拉",
          "text": "哈哈，抱歉、抱歉，请您收下额外的报酬。"
        },
        {
          "role": "派蒙",
          "text": "还有额外的报酬！"
        },
        {
          "role": "利露帕尔",
          "text": "…仍是不多，不过既然我的大人没什么意见，那就这样吧。"
        },
        {
          "role": "马塞拉",
          "text": "很好，啊…希望有时间的话，您能再来一趟…我想，我的「猎鹰」仍然需要您的帮助。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（马塞拉）"
        },
        {
          "role": "'心声'",
          "text": "（塔德菈啊…你的成长…太慢了…）"
        },
        {
          "role": "马塞拉",
          "text": "啊，尊贵的「镇灵主人」…如果您是来找塔德菈的话，现在还不是时候呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于塔德菈…",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "我是她的「父亲」，她是我的「猎鹰」…虽然塔尼特不止她一只「猎鹰」是我看着长大的，嘿嘿…但我最信任的是她。"
                },
                {
                  "role": "马塞拉",
                  "text": "「信任」无比宝贵，在这个部族是性命攸关的东西。"
                }
              ]
            },
            {
              "text": "关于你自己…",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "我是部族的猎人，不过我太老了，腿脚也不利索了…你的好朋友婕德，早晚会取代我们这些老一辈人…"
                },
                {
                  "role": "马塞拉",
                  "text": "所以，塔德菈…我在她身上抱了很深的期待。等我不得不退隐的时候，至少能有一个足够信任的「猎鹰」。"
                }
              ]
            },
            {
              "text": "关于部族…",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "塔尼特是我们的部族，是我们的家。"
                },
                {
                  "role": "马塞拉",
                  "text": "在沙漠里，没有人能离开部族的保护…而假如部族要他去死，他又怎能逃避无处不在的「鹰眼」和「鹰爪」呢？"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "马塞拉",
                  "text": "愿沙丘的波纹为您指引方向，尊贵的「镇灵主人」。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（塔德菈）（等候到次日早上（8至12时），与马塞拉对话前）"
        },
        {
          "role": "'心声'",
          "text": "（…为什么不让我一个人完成「成人礼」…）"
        },
        {
