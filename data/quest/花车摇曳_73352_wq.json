{
  "quest_id": 73352,
  "chapter_num": null,
  "chapter_title": "花车摇曳",
  "type": "wq",
  "route": "Rocking Carriage",
  "stories": [
    {
      "story_id": 73352,
      "title": "花车摇曳",
      "description": "「花神诞祭」上，有着「幻之玩具王」之称的麦斯欧德正在向游客们推荐他的新游戏…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与麦斯欧德对话"
        },
        {
          "type": "subtitle",
          "text": "心声（麦斯欧德）"
        },
        {
          "role": "麦斯欧德",
          "text": "（玩具啊，向人们传递更多快乐吧…）"
        },
        {
          "role": "麦斯欧德",
          "text": "异乡的旅者和小朋友，你们好啊，花神诞祭玩得还开心吗？"
        },
        {
          "role": "麦斯欧德",
          "text": "要是两位还有兴致，我「幻之玩具王」诚邀你们来玩玩新游戏——只在花神诞祭期间才开放的「花车摇曳」。"
        },
        {
          "role": "派蒙",
          "text": "花车摇曳？"
        },
        {
          "role": "派蒙",
          "text": "一听这个名字，我好像能想象出…纳西妲坐在花车里开心摇摆的画面！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听得我也有点开心了！",
              "dialogues": []
            },
            {
              "text": "听得我想看纳西妲摇摆…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "麦斯欧德",
          "text": "好呀，「草神大人每天都快快乐乐」是我们这些须弥人的愿望！"
        },
        {
          "role": "麦斯欧德",
          "text": "你们的联想…是何等美妙的画面，值得画成一幅华丽的绘卷。"
        },
        {
          "role": "麦斯欧德",
          "text": "不过，这个游戏的氛围更加活泼，比起欣喜的庆祝，更像是一场历险——"
        },
        {
          "role": "麦斯欧德",
          "text": "「无论聪明与否，不管乖巧还是顽皮，每个拥有美好心灵的孩子，都在花神诞祭的庆祝上得到了一辆自己的花车…」"
        },
        {
          "role": "麦斯欧德",
          "text": "「乘着这辆花车，孩子们开启了自己独一无二的旅程，遭遇了惊险，也成功化险为夷，寻得了千朵鲜花的至宝…」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙聪明又乖巧。",
              "dialogues": []
            },
            {
              "text": "我们都很擅长化险为夷。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，说得对！千朵鲜花的至宝，我们也能拿下。"
        },
        {
          "role": "麦斯欧德",
          "text": "那就请两位尽情游玩，好好享受游戏了！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（麦斯欧德）"
        },
        {
          "role": "麦斯欧德",
          "text": "异乡的旅者，「花车摇曳」的历险体验如何？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "先来一场再说。",
              "dialogues": [
                {
                  "role": "麦斯欧德",
                  "text": "好呀，跟着花车的节奏摇摆吧。"
                }
              ]
            },
            {
              "text": "有一些小建议…",
              "dialogues": [
                {
                  "role": "麦斯欧德",
                  "text": "您请说，我好好记着。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "花车的速度太慢了。",
                      "dialogues": [
                        {
                          "role": "麦斯欧德",
                          "text": "看来您经历过非常惊险的竞速挑战，喜欢速度带来的感官刺激。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "不过，「花车摇曳」是对普通大众开放的游戏，很多孩子、女士和老人的反应力并没有那么快。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "针对您的需求，我可以尝试开发一款「镀金旅团沙漠迷宫大逃亡」，大幅加快行驶速度。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "到时应该能满足您对速度的需求。"
                        }
                      ]
                    },
                    {
                      "text": "历险中的难题有点少。",
                      "dialogues": [
                        {
                          "role": "麦斯欧德",
                          "text": "我想想，您似乎更倾向于高难度的挑战，对克服难题抱有极大的热情。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "不过，「花车摇曳」毕竟是在悠闲节日开放的活动，很多游客只想玩些简单轻松的小游戏。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "毕竟大部分人不会花特别多的时间去钻研一个刚看到的游戏，玩法太复杂的话，玩一小下就把人家吓跑了。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "针对您的需求，我可以尝试开发一款「巡林员蘑菇大冒险」，增加各种障碍，甚至移动解谜。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "到时应该能满足您对难度的需求。"
                        }
                      ]
                    },
                    {
                      "text": "行驶中没有战斗。",
                      "dialogues": [
                        {
                          "role": "麦斯欧德",
                          "text": "啊呀，看来您比较喜欢在冒险中击败强敌的体验。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "不过，要是在这款游戏中加入与敌人战斗的环节，重点似乎就不再是花车的行驶了，而是载具射击的综合体验。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "有人喜欢单纯的行驶体验，有人喜欢载具战斗， 都可以理解！"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "针对您的需求，我可以尝试开发一款「大风纪官疾速追杀」，设计各种追逐战和拦截战环节。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "到时应该能满足您对战斗的需求。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "「幻之玩具王」的称号很威风。",
              "dialogues": [
                {
                  "role": "麦斯欧德",
                  "text": "是吗？多谢夸赞！这是我从祖母那里继承来的称号，我非常喜欢！"
                },
                {
                  "role": "麦斯欧德",
                  "text": "一听别人提到「幻之玩具王」，我就想起自己童年时期就确定的人生目标——做出让大家都快乐的玩具。"
                },
                {
                  "role": "麦斯欧德",
                  "text": "这把老骨头也能迸发出无尽的活力。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "你的祖母？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "麦斯欧德",
                  "text": "很久很久以前，祖母曾意外造访一处秘境，在那里结识了奇妙的朋友，获得了近乎无限的灵感。"
                },
                {
                  "role": "麦斯欧德",
                  "text": "回到须弥后，她就开发了许多种特色玩具。"
                },
                {
                  "role": "麦斯欧德",
                  "text": "可惜，她只想着实现华丽、复杂的玩法，没太注意须弥孩子们的接受能力，对市场的经济条件也缺乏全面考察。"
                },
                {
                  "role": "麦斯欧德",
                  "text": "真要客观评价，她的作品只在有限的客人群体中得到了认可，虽然名声不错，但暂时没法给广义的大众带来简单的快乐。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "接受能力？",
                      "dialogues": [
                        {
                          "role": "麦斯欧德",
                          "text": "简单来说，来买玩具的孩子分布在各个年龄段，学习能力不能一概而论。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "有的玩具太复杂，或游玩规则太多样，青少年甚至都要花上不少时间来记忆，孩子们看了当然会一头雾水。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "祖母太过热情，在这一点上有所疏忽，做的有些过火，导致玩具的销量不怎么出彩。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "我觉得，这既不是祖母的错，也不是孩子们的错，只是双方彼此不适应。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "要是祖母把玩具的定位改为成年人市场，情况也许就会不一样了。"
                        }
                      ]
                    },
                    {
                      "text": "经济条件？",
                      "dialogues": [
                        {
                          "role": "麦斯欧德",
                          "text": "这个问题非常复杂，老实说，我查阅了很多学者的著作，也不知道该怎么评估——"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "想把玩具做得更精致更巧妙，就需要投入更多资金，导致玩具涨价…就像发条玩具不可能和一般的折纸模型卖相同的价钱。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "可到底涨价多少，我和祖母都没搞明白。大家腰包里到底有多少摩拉，愿意出多少钱买玩具，这件事只有他们自己清楚。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "客人的心情也很重要，要是对玩具有眼缘，一些客人甚至愿意多出几成价钱，要是没眼缘，客人就等着打折，不存在客观标准。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "祖母就犯了这样的错，虽然她已经尽量压低玩具的售价了，但还是多次碰壁，所以我要尽可能在品质、成本和售价间找到平衡。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "总之，我这几十年来一直过得很快乐，都要多谢祖母，她设计或买来的玩具多到我玩不过来。"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "她还在世时，只要有空，就会陪我一起玩玩具…"
                        },
                        {
                          "role": "麦斯欧德",
                          "text": "咳，不回忆过去了…总之，我要尽全力把这种快乐带给更多人！"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "以后再说，还有别的事…",
              "dialogues": [
                {
                  "role": "麦斯欧德",
                  "text": "无妨，玩具的快乐随时等候着您！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          1,
