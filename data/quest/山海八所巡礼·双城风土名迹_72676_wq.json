{
  "quest_id": 72676,
  "chapter_num": null,
  "chapter_title": "山海八所巡礼·双城风土名迹",
  "type": "wq",
  "route": "Eight Locales Over Mountains and Seas: Two Cities' Recommendations",
  "stories": [
    {
      "story_id": 72676,
      "title": "山海八所巡礼·双城风土名迹",
      "description": "之前答应了五百藏「带吉法师去外面修行」的请求。这回不妨领着他去见识见识异国的美食。毕竟，唯有美食与宝藏绝不辜负。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往蒙德城的「猎鹿人」餐馆"
        },
        {
          "role": "派蒙",
          "text": "莎拉小姐！你好！"
        },
        {
          "role": "莎拉",
          "text": "哎呀，欢迎光临，派蒙和旅行者！还有这位…是新型兔兔伯爵么…？"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这位是吉法师。",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "嗯，是我们在稻妻认识的新朋友喔！"
        }
              ]
            },
            {
              "text": "这位是兔兔伯爵。",
              "dialogues": [
                 {
          "role": "「吉法师」",
          "text": "臭臭伯爵？"
        },
         {
          "role": "派蒙",
          "text": "喂！别听的。这位是吉法师，我们在稻妻认识的新朋友！"
        }
              ]
            },
            {
              "text": "这位是锅巴。",
              "dialogues": [
                  {
          "role": "「吉法师」",
          "text": "锅巴？"
        },
         {
          "role": "莎拉",
          "text": "「锅巴」？锅巴是指，璃月的名菜「绝云锅巴」么…？"
        },
         {
          "role": "派蒙",
          "text": "喂！别听的。这位是吉法师，我们在稻妻认识的新朋友！"
        }
              ]
            }
            
          ]
        },    
        {
          "role": "「吉法师」",
          "text": "嗯，好朋友！"
        },
        {
          "role": "莎拉",
          "text": "原来是这样，真是不好意思。欢迎光临猎鹿人，吉法师。"
        },
        {
          "role": "莎拉",
          "text": "稻妻呀，真了不起…之前听塞琉斯先生说过，那是雷暴包围的国度，到处都会打雷，有点像丽莎小姐生气时候的天空。非常恐怖。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "非常恐怖。",
            "也没那么夸张啦…",
            "和丽莎小姐有什么关系…？"
          ]
        },
        {
          "role": "派蒙",
          "text": "今天来猎鹿人，是想请吉法师品尝最——正宗的蒙德美食！莎拉小姐，我要一份甜甜花酿鸡，和…"
        },
        {
          "role": "莎拉",
          "text": "啊，不好意思。猎鹿人今天没办法接待客人…该怎么说呢…"
        },
        {
          "role": "莎拉",
          "text": "某种意义而言，算是被包场了？"
        },
        {
          "role": "派蒙",
          "text": "欸？但是，周围没有人…"
        },
        {
          "role": "莎拉",
          "text": "凯亚队长今天突然下了一笔很大的外送订单，要往歌德大酒店送几十人份的菜肴。现在后厨都忙得不可开交…"
        },
        {
          "role": "派蒙",
          "text": "凯亚？感觉有点可疑…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可能有什么计划…",
              "dialogues": [
                  {
          "role": "派蒙",
          "text": "没关系！毕竟…"
        }
              ]
            },
            {
              "text": "那么，我来做也行…",
              "dialogues": []
            }
          ]
        }, 
        {
          "role": "派蒙",
          "text": "嗯！旅行者的手艺这么好，只要有你在，就不愁没有好吃的。嘿嘿。"
        },
        {
          "role": "「吉法师」",
          "text": "要做菫瓜？菫瓜烧？"
        },
        {
          "role": "派蒙",
          "text": "不对啦！不过，你到底有多喜欢菫瓜…"
        },
        {
          "role": "莎拉",
          "text": "如果要用敝店的开放炉灶，随时都可以哦。"
        },
        {
          "role": "派蒙",
          "text": "谢谢莎拉小姐！那么，旅行者，就来个外焦里嫩、香气可人的甜甜花酿鸡如何！吉法师一定会喜欢的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "是派蒙想吃吧。",
            "没问题。这个我会做。"
          ]
        },
        {
          "role": "「吉法师」",
          "text": "咕噜…听起来好吃。"
        },
        {
          "role": "派蒙",
          "text": "你看你看，吉法师也想吃。不要让我…我是说，不要让吉法师失望啦！"
        },
        {
          "role": "「吉法师」",
          "text": "耶！失望！"
        },
        {
          "type": "subtitle",
          "text": "烹饪「美味的甜甜花酿鸡」"
        },
        {
          "type": "subtitle",
          "text": "坐下与派蒙和吉法师一同享用美食"
        },
        {
          "role": "「吉法师」",
          "text": "没见过的东西。不过，好香。咕噜。"
        },
        {
          "role": "派蒙",
          "text": "这就是美味的「甜甜花酿鸡」！应该算是旅行者的拿手菜吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text":  "旅行过程中，确实做了很多。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "嗯，毕竟野外材料很充实呢！"
        }
              ]
            },
            {
              "text": "还好吧。也不算很拿手。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "既然刚刚提到凯亚…"
        },
        {
          "role": "派蒙",
          "text": "嗯，旅行者「连骑士般的谦虚品德也已经具备了！」"
        }
              ]
            }
          ]
        },
        
        {
          "type": "subtitle",
          "text": "一同开始享用「美味的甜甜花酿鸡」。吉法师似乎有些警惕，但最终还是禁不起香气的诱惑，吃了起来。"
        },
        {
          "role": "「吉法师」",
          "text": "…咕噜。"
        },
        {
          "role": "派蒙",
          "text": "吉法师，怎么了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "该不会是吃坏肚子了…",
            "吉法师，你没事吧？"
          ]
        },

        {
          "role": "「吉法师」",
          "text": "呶！好吃！厉害！"
        },
        {
          "role": "「吉法师」",
          "text": "竟然有比菫瓜还好吃的东西呶！"
        },
        {
          "role": "派蒙",
          "text": "嗯！确实好吃…喂！给我留一点呀！"
        },
        {
          "type": "subtitle",
          "text": "派蒙与吉法师风卷残云般地吃完了甜甜花酿鸡。"
        },
        {
          "role": "「吉法师」",
          "text": "噗哈，真好吃。旅行者，厉害。"
        },
        {
          "role": "派蒙",
          "text": "欸！居然记住旅行者的名字了！难道妖狸是吃了美味的东西，就会变聪明的生物？"
        },
        {
          "role": "「吉法师」",
          "text": "呶？白毛说什么？"
        },
        {
          "role": "派蒙",
          "text": "……"
        },
        {
          "role": "旅行者",
          "text": "她叫派蒙。"
        },
        {
          "role": "「吉法师」",
          "text": "白蒙。"
        },
        {
          "role": "派蒙",
          "text": "是派蒙啦！"
        },
        {
          "role": "「吉法师」",
          "text": "斯派毛拉。"
        },
        {
          "role": "派蒙",
          "text": "呜哇，气死我了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "派蒙要习惯…",
            "之后给派蒙做好吃的…"
          ]
        },
        {
          "role": "旅行者",
          "text": "吉法师也要好好记住别人的名字。"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师会努力。对不起，派毛。"
        },
        {
          "role": "派蒙",
          "text": "…不是派毛，是派蒙。好啦，我不生气了。"
        },
        {
          "role": "「吉法师」",
          "text": "美味的甜甜花酿鸡，好吃。谢谢。"
        },
        {
          "role": "派蒙",
          "text": "…反倒是菜品的名字，能记得这么清喔！"
        },
        {
          "role": "「吉法师」",
          "text": "好吃呶。不是菫瓜、不是海草、也不是树莓，竟然这么好吃。"
        },
        {
          "role": "旅行者",
          "text": "喜欢就好。"
        },
        {
          "role": "「吉法师」",
          "text": "修行，真开心。"
        },
        {
          "role": "派蒙",
          "text": "这么说来，既然难得来一趟蒙德…"
        },
         {
          "role": "派蒙",
          "text": "吉法师，我们去看看风神像吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "说得也对…",
            "去看看风神像吧。"
          ]
        },
        {
          "role": "「吉法师」",
          "text": "风神？是像雷神那样的神吗？"
        },
        {
          "role": "派蒙",
          "text": "这孩子，很有悟性嘛！风神就是蒙德的神，和雷神就是稻妻的神一样。"
        },
        {
          "role": "「吉法师」",
          "text": "呜呶呶，好可怕。"
        },
        {
          "role": "派蒙",
          "text": "不用担心啦，是个雕像，不是真正的神。"
        },
        {
          "type": "subtitle",
          "text": "登上神像的掌心"
        },
        {
          "role": "派蒙",
          "text": "你看，没什么好怕的吧。"
        },
        {
          "role": "「吉法师」",
          "text": "嗯。风神好高，比五百藏还高。而且，好硬。又高又硬。"
        },
        {
          "role": "派蒙",
          "text": "…我已经懒得解释石像和本尊的区别了。"
        },
        {
          "role": "旅行者",
          "text": "风神是很好的人。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "虽然有时候不可靠，但很温柔。",
            "虽然很温柔，但也有不可靠的时候…"
          ]
        },
        {
          "role": "派蒙",
          "text": "这么说来，芭芭拉小姐发现了没有，天空之琴的事情…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text":  "「欸嘿。」",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "欸嘿是什么意思啦！喂！"
        }
              ]
            },
            {
              "text": "希望没有发现。",
              "dialogues": []
            },
            {
              "text": "希望已经发现了。",
              "dialogues": []
            }
          ]
        },
        
        {
          "role": "「吉法师」",
          "text": "呶！拍照！"
        },
        {
          "role": "派蒙",
          "text": "嗯！吉法师站好别动喔！"
        },
        {
          "role": "「吉法师」",
          "text": "看看！"
        },
        {
          "role": "派蒙",
          "text": "别着急啦！"
        },
        {
          "type": "subtitle",
          "text": "向吉法师与派蒙展示刚刚拍的相片。"
        },
        {
          "role": "「吉法师」",
          "text": "好帅，好大的手。"
        },
        {
          "role": "「吉法师」",
          "text": "回去以后，给五百藏看，风神的手比五百藏还大。"
        },
        {
          "role": "旅行者",
          "text": "五百藏的尺寸，和这个没办法比吧…"
        },
        {
          "role": "旅行者",
          "text": "「五百藏，好弱。」"
        },
        {
          "role": "「吉法师」",
          "text": "五百藏，好弱好弱，呶哈哈。"
        },
        {
          "role": "派蒙",
          "text": "喂！这样对吉法师影响不好啦！"
        },
        {
          "role": "「吉法师」",
          "text": "五百藏认真的时候，可以变得好大好大。比一百个八叠还大。"
        },
        {
          "role": "「吉法师」",
          "text": "五百藏很厉害。不过，吉法师要变得更厉害。"
        },
        {
          "role": "派蒙",
          "text": "唔…吉法师为什么要变得更厉害呢？"
        },
        {
          "role": "派蒙",
          "text": "吉法师现在也很厉害呀，还能变出可以滑翔的气囊。差不多有派蒙一半厉害吧！"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师变得更厉害，就可以用更厉害的法术。"
        },
        {
          "role": "「吉法师」",
          "text": "可以用更厉害的法术，就可以把五百藏变成不是石头。"
        },
        {
          "role": "「吉法师」",
          "text": "所以，吉法师要修行呶，和旅行者和派蒙一起。"
        },
        {
          "role": "派蒙",
          "text": "是这样啊…"
        },
        {
          "role": "派蒙",
          "text": "——欸！记住我的名字了！好开心！"
        },
        {
          "role": "「吉法师」",
          "text": "开心！呶哈哈。"
        },
        {
          "role": "旅行者",
          "text": "吉法师要加油。"
        },
        {
          "role": "「吉法师」",
          "text": "加油！耶！"
        },
        {
          "role": "旅行者",
          "text": "那么，接下来去什么地方呢？"
        },
        {
          "role": "派蒙",
          "text": "嗯…既然已经吃过了蒙德的东西，接下来去璃月港吧！"
        },
        {
          "role": "派蒙",
          "text": "万民堂的美味，也好久没尝过了呢。"
        },
        {
          "role": "旅行者",
          "text": "刚刚才吃了一顿…"
        },
        {
          "role": "派蒙",
          "text": "哼哼，蒙德的菜，和璃月的菜，当然是装在不同的胃袋里的。"
        },
        {
          "role": "「吉法师」",
          "text": "吃！出发！"
        },
        {
          "role": "派蒙",
          "text": "出发！目标——万民堂！"
        },
        {
          "type": "subtitle",
          "text": "前往璃月港的「万民堂」餐馆"
        },
        {
          "role": "派蒙",
          "text": "卯师傅你好！首先，要一份水煮黑背鲈…"
        },
        {
          "role": "卯师傅",
          "text": "哎，偏偏这时候来客人啊…对不住了，现在暂时不能点单。"
        },
        {
          "role": "派蒙",
          "text": "欸？怎么会这样…"
        },
        {
          "role": "卯师傅",
          "text": "早些时候打蒙德来了个骑士，下了老大一笔外带单。要咱们做几十个人分量的吃食，他要带去…什么地方来着？"
        },
        {
          "role": "旅行者",
          "text": "蒙德城的歌德大酒店？"
        },
        {
          "role": "卯师傅",
          "text": "哎，没错！你怎么知道？"
        },
        {
          "role": "派蒙",
          "text": "凯亚这家伙…"
        },
        {
          "role": "卯师傅",
          "text": "实在是对不住，这单一时半会也没办法做完。你瞧，锅里正烧着菜呢。也不晓得那家伙，带着那么多菜要怎么走…不要浪费才好…"
        },
        {
          "role": "卯师傅",
          "text": "生意来得太突然，连伙房里的材料都不够了，这会儿我闺女也在外头帮忙找绝云椒椒呢。"
        },
        {
          "role": "派蒙",
          "text": "呜呜…"
        },
        {
          "role": "「吉法师」",
          "text": "呜呶呶…"
        },
        {
          "role": "卯师傅",
          "text": "欸？这位…小朋友是？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这位是吉法师。",
              "dialogues": [
                {
          "role": "卯师傅",
          "text": "你好！"
        },
        {
          "role": "派蒙",
          "text": "嗯！他是正在旅行修行的妖狸。"
        }
              ]
            },
            {
              "text": "这位是兔兔伯爵。",
              "dialogues": [
                {
          "role": "卯师傅",
          "text": "兔什么…？"
        },
         {
          "role": "「吉法师」",
          "text": "秃秃伯爵？"
        },
        {
          "role": "派蒙",
          "text": "喂！别听的。这位是吉法师，正在旅行修行的妖狸喔！"
        }
       
              ]
            },
            {
              "text": "这位是锅巴。",
              "dialogues": [
                 {
          "role": "派蒙",
          "text": "——「绝云锅巴」爱好者吉法师！他是正在旅行修行的妖狸。哎呀，因为听说万民堂的锅巴很好吃，想来尝尝看。"
        },
         {
          "role": "「吉法师」",
          "text": "绝云锅巴！"
        }
              ]
            }       
          ]
        },
        
        {
          "role": "卯师傅",
          "text": "这样啊，真是对不住了，吉法师。"
        },
        {
          "role": "卯师傅",
          "text": "这么说来，我闺女也有个爱吃东西的朋友，叫锅巴。看样子，应该能和吉法师交个朋友…"
        },
        {
          "role": "派蒙",
          "text": "没办法了，要不还是旅行者做…"
        },
        {
          "role": "杰里",
          "text": "…糟糕，完全忘了！"
        },
        {
          "role": "派蒙",
          "text": "欸？他们怎么了？"
        },
        {
          "role": "弗莱琪",
          "text": "真是的，当初怎么就没有确认日期…"
        },
        {
          "role": "旅行者",
          "text": "发生什么事了？"
        },
        {
          "role": "杰里",
          "text": "我们提前几个月分别预订了「琉璃亭」和「新月轩」的位子…"
        },
        {
          "role": "弗莱琪",
          "text": "想着，在回蒙德前，我们姐弟一定要将所谓「璃菜」和「月菜」的顶点都品尝过…"
        },
        {
          "role": "杰里",
          "text": "结果俩家店的位子，都定在了今天！"
        },
        {
          "role": "弗莱琪",
          "text": "要是当初确认了时间就好了！现在要怎么办才好…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要不两家都去？",
              "dialogues": [
                {
          "role": "杰里",
          "text": "不，这可不行。"
        },
        {
          "role": "弗莱琪",
          "text": "无论先吃哪一家，都会因为饱足影响另一家的体验。"
        },
        {
          "role": "杰里",
          "text": "无论先去琉璃亭还是新月轩，对另一家都是不公平的，对它所代表的菜系更是如此！"
        },
        {
          "role": "弗莱琪",
          "text": "这样的话，对美食实在是太不敬了！"
        }
              ]
            },
            {
              "text": "要不你们分别去一家？",
              "dialogues": [
                {
          "role": "杰里",
          "text": "不，这可不行。"
        },
        {
          "role": "弗莱琪",
          "text": "无论是哪种菜系，我们都要一起体验。"
        },
        {
          "role": "杰里",
          "text": "不然，我们姐弟就可能会忍不住对对方片面地评论「璃菜」或是「月菜」！"
        },
        {
          "role": "弗莱琪",
          "text": "这样的话，对美食实在是太不敬了！"
        }
              ]
            }
          ]
        },
        
        {
          "role": "派蒙",
          "text": "…喂！不要轮流说话啦！听着好累喔！"
        },
        {
          "role": "旅行者",
          "text": "好麻烦。"
        },
        {
          "role": "派蒙",
          "text": "总之，你们定了琉璃亭和新月轩今天的位置，但是只能去其中一家对吧…"
        },
        {
          "role": "「吉法师」",
          "text": "呶。吉法师帮忙。帮棕毛叔叔和棕毛阿姨去，就行了。"
        },
        {
          "role": "弗莱琪",
          "text": "咦，这个…小动物，好像想说什么？"
        },
        {
          "role": "派蒙",
          "text": "是说我们可以替棕毛叔叔和棕毛阿姨去！"
        },
        {
          "role": "弗莱琪",
          "text": "喂！不是阿姨，是姐姐！！"
        },
        {
          "role": "派蒙",
          "text": "不、不是我说的啦！"
        },
        {
          "role": "弗莱琪",
          "text": "替我们去吗？也不是不行，但总感觉很不甘心…"
        },
        {
          "role": "杰里",
          "text": "…我倒觉得是个好主意。毕竟，如果临时取消预约，也对不住店家。"
        },
        {
          "role": "弗莱琪",
          "text": "呜呜，但是，好不容易等到位置了…"
        },
        {
          "role": "杰里",
          "text": "弗莱琪，我们有的是时间，下次再预约就是了。昨天你不是还说，想吃新月轩的海鲜吗？"
        },
        {
          "role": "杰里",
          "text": "我们就去新月轩吧。琉璃亭预订的位置，就交给这几位…"
        },
        {
          "role": "杰里",
          "text": "看上去…很特别…的旅行者，还有…小动物？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "真的可以吗？",
            "交给我吧。"
          ]
        },
        {
          "role": "杰里",
          "text": "嗯。我是杰里，到琉璃亭，找璃彩报我的名字就可以了。菜肴也预订好了。"
        },
        {
          "role": "派蒙",
          "text": "好耶！谢谢杰里！"
        },
        {
          "role": "「吉法师」",
          "text": "好耶！谢谢姐姐狸！"
        },
        {
          "type": "subtitle",
          "text": "前往琉璃亭，与璃彩对话"
        },

        {
          "role": "璃彩",
          "text": "欢迎光临「琉璃亭」，请问客官有预订吗？"
        },
        {
          "role": "旅行者",
          "text": "是杰里替我们定的位。"
        },
        {
          "role": "璃彩",
          "text": "杰里先生是吗…请稍等片刻，我看看…"
        },
        {
          "role": "璃彩",
          "text": "确实定了今天的位子没错。久等了，里边请。"
        },
        {
          "role": "派蒙",
          "text": "虽然之前杰里说菜已经订好了…"
        },
        {
          "role": "派蒙",
          "text": "没想到居然这么丰盛…杰里和弗莱琪，真的打算就凭他们两个人，吃下这么多东西吗？"
        },
        {
          "role": "「吉法师」",
          "text": "咕噜。好香。"
        },
        {
          "type": "subtitle",
          "text": "与派蒙、吉法师一同心怀感激地享用「琉璃亭」的美食…"
        },
        {
          "role": "派蒙",
          "text": "呜哇，好美味。吉法师觉得如何？"
        },
        {
          "role": "「吉法师」",
          "text": "呶！好吃！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看着吉法师的吃相，就觉得美味。",
              "dialogues": [
                {
          "role": "「吉法师」",
          "text": "呶哈哈，美味。真好吃。"
        }
              ]
            },
            {
              "text": "看着派蒙的吃相，就觉得美味。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "喂！这是在夸我吗？"
        }
              ]
            }       
          ]
        },
        
        {
          "role": "「吉法师」",
          "text": "人类好厉害。能做这么好吃的东西，比妖狸的饭更好吃。"
        },
        {
          "role": "派蒙",
          "text": "这么说来，妖狸的饭是用什么做的呢？"
        },
        {
          "role": "派蒙",
          "text": "虽然看起来很美味，吃起来也很不错，但就是感觉有点怪…有点空虚？"
        },
        {
          "role": "旅行者",
          "text": "我也很好奇。"
        },
        {
          "role": "「吉法师」",
          "text": "妖狸的饭，是用叶子砰砰做的。"
        },
        {
          "role": "派蒙",
          "text": "叶子砰砰…是蔬菜的意思吗？"
        },
        {
          "role": "「吉法师」",
          "text": "叶子砰砰就是叶子砰砰。叶子，砰砰，好吃。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "总感觉有点微妙…",
            "最好不要深究妖狸的法术…"
          ]
        },
        {
          "role": "派蒙",
          "text": "唔…感觉好在意哦！"
        },
        {
          "role": "派蒙",
          "text": "这么说来，也好在意凯亚的事情。猎鹿人和万民堂…送到歌德大酒店的订单…"
        },
        {
          "role": "派蒙",
          "text": "这个人，到底在打什么主意呀？"
        },
        {
          "role": "旅行者",
          "text": "说不定，是这样的情况："
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「咚咚咚，给愚人众先生的外送！」",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "「外送？是什么东西呀？」"
        },
        {
          "role": "旅行者",
          "text": "「蒙德、璃月的全套大餐！」"
        },
        {
          "role": "派蒙",
          "text": "「好耶！是大餐！谢谢！」"
        },
        {
          "role": "旅行者",
          "text": "「多谢惠顾，一共五百万摩拉！」"
        },
        {
          "role": "派蒙",
          "text": "「哎吔，怎、怎会如此！我们的活动经费怎么办？只能乖乖离开蒙德城了，呜呜呜！」"
        }
              ]
            },
            {
              "text": "「你好，是骑士团的礼物！」",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "「礼物？哼哼，骑士团总算知道，我们愚人众的厉害了吗！」"
        },
        {
          "role": "派蒙",
          "text": "「虽然现在才来讨好我们，有点太晚了！不过…咳咳，是什么好东西呀？」"
        },
        {
          "role": "旅行者",
          "text": "「蒙德、璃月的冷盘大餐！」"
        },
        {
          "role": "派蒙",
          "text": "「好耶！是冷盘大餐！兄弟们，吃饭啦！」"
        },
        {
          "role": "旅行者",
          "text": "「咿呀！冻结吧！」"
        },
        {
          "role": "派蒙",
          "text": "「哎吔！竟然将持有冰元素神之眼的骑兵队长藏在大餐里，啊吧！再见啦——！」"
        }
              ]
            }               
          ]
        },
        
        {
          "role": "派蒙",
          "text": "…仔细想想，应该不会发生这么幼稚的事情吧…"
        },
        {
          "role": "「吉法师」",
          "text": "噗哈哈，好像妖狸喔。"
        },
        {
          "role": "旅行者",
          "text": "确实像妖狸的作风…"
        },
        {
          "role": "派蒙",
          "text": "说起来，感觉这次比上次来更美味呢！这是为什么呢？"
        },
        {
          "role": "旅行者",
          "text": "之前来，是来谈正事。"
        },
        {
          "role": "派蒙",
          "text": "嗯，确实。什么客卿、什么送仙的，聊得饭都不香了…"
        },
        {
          "role": "派蒙",
          "text": "啊，这么说来，吉法师，我们以前在这里和「愚人众」的执行官，还有岩王帝君一起吃饭呢！"
        },
        {
          "role": "「吉法师」",
          "text": "吉法师以前听五百藏说过，人鱼的故事呶。"
        },
        {
          "role": "「吉法师」",
          "text": "在大海里面，有好多人鱼。人鱼会和鲸鱼和大海蛇一起游。"
        },
        {
          "role": "派蒙",
          "text": "是「愚人」，不是「人鱼」啦！"
        },
        {
          "role": "旅行者",
          "text": "愚人众的事情，妖狸应该不知道吧。"
        },
        {
          "role": "派蒙",
          "text": "说、说得也是…"
        },
        {
          "role": "派蒙",
          "text": "既然到了璃月，也找个地方给吉法师拍照做个纪念吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "找个能看到璃月全景的地方…",
            "有什么适合拍照的地方吗？"
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯！璃月港北边的入口，不是一段好长好长的坡道吗？"
        },
        {
          "role": "派蒙",
          "text": "在那边，应该很合适！"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点"
        },
        {
          "role": "派蒙",
          "text": "吉法师，对着旅行者站好别动喔！"
        },
        {
          "role": "「吉法师」",
          "text": "耶！拍照纪念！"
        },
        {
          "type": "subtitle",
          "text": "与吉法师对话"
        },
        {
          "role": "派蒙",
          "text": "嗯，拍得真不错。旅行者还挺有天赋的嘛。"
        },
        {
          "role": "「吉法师」",
          "text": "这里好漂亮。和森林不一样。"
        },
        {
          "role": "「吉法师」",
          "text": "但是，下面好多船，不会沉到水里？"
        },
        {
          "role": "旅行者",
          "text": "不会的，不用担心。"
        },
        {
          "role": "「吉法师」",
          "text": "好耶！好厉害！"
        },
        {
          "role": "派蒙",
          "text": "吉法师，今天的修行，好玩吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "明明是修行…",
            "修行应该不算玩…"
          ]
        },
        {
          "role": "「吉法师」",
          "text": "五百藏说过，玩也是修行。不能偏离狸道。"
        },
        {
          "role": "「吉法师」",
          "text": "如果忘记玩，就会偏离狸道。"
        },
        {
          "role": "派蒙",
          "text": "偏离狸道…会怎么样呢？"
        },
        {
          "role": "「吉法师」",
          "text": "偏离狸道的狸子，就会爆炸。"
        },
        {
          "role": "派蒙",
          "text": "？"
        },
        {
          "role": "旅行者",
          "text": "…？"
        },
        {
          "role": "「吉法师」",
          "text": "八叠会爆炸，叶子也会不见。身上的毛都变成海草，腹鼓变成大茶壶。然后狸子就会变得和鼬一样瘦，没有法力。"
        },
        {
          "role": "派蒙",
          "text": "…我很确定五百藏是骗人的。"
        },
        {
          "role": "「吉法师」",
          "text": "修行很好玩、很开心呶！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "好玩就好。",
            "开心就好。"
          ]
        },
        {
          "role": "「吉法师」",
          "text": "前进！去哪？"
        },
        {
          "role": "派蒙",
          "text": "嗯…今天的话，就到此为止吧！"
        },
        {
          "role": "旅行者",
          "text": "吉法师也该休息了。"
        },
        {
          "role": "「吉法师」",
          "text": "不想休息，吉法师还想和派蒙和旅行者修行。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "休息也是修行的一种。",
            "如果不休息，修行就修不好。"
          ]
        },
        {
          "role": "「吉法师」",
          "text": "呶…"
        },
        {
          "role": "派蒙",
          "text": "别担心！我和旅行者一起想想，接下来去什么地方。"
        },
        {
          "role": "「吉法师」",
          "text": "嗯！"
        }
      ]
    }
  ]
}