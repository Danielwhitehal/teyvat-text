{
  "quest_id": 10052,
  "chapter_num": "飞彩镌流年 其一",
  "chapter_title": "吉星似火，福禄成喜",
  "type": "eq",
  "route": "The Blazing Stars Ring in Fortune",
  "stories": [
    {
      "story_id": 40035,
      "title": "吉星似火，福禄成喜",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "又是一年海灯节，派蒙和你前去打听璃月人今年的节日安排…",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "真没想到，重建群玉阁居然会引出那么大的怪物。"
        },
        {
          "role": "派蒙",
          "text": "说实话，我还以为群玉阁要再砸下去一次呢…"
        },
        {
          "role": "派蒙",
          "text": "事情是解决了，但出了那种大乱子，真不知道海灯节能不能接着办下去…"
        },
        {
          "role": "派蒙",
          "text": "<旅行者>，我们去问问凝光小姐今年海灯节的情况吧。"
        },
        {
          "type": "subtitle",
          "text": "前往玉京台"
        },
        {
          "type": "subtitle",
          "text": "与凝光对话",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "凝光",
          "text": "…这份通知送去总务司，让他们把上面列出的各项工作整理安排给各部门。"
        },
        {
          "role": "凝光",
          "text": "转告他们，海灯节诸事繁杂，但无论大小工作都要办妥办好。"
        },
        {
          "role": "派蒙",
          "text": "凝光小姐！嘿嘿，我们又来玩啦！"
        },
        {
          "role": "旅行者",
          "text": "没有打扰你吧？"
        },
        {
          "role": "凝光",
          "text": "贵客来访，怎么能说是打扰。"
        },
        {
          "role": "凝光",
          "text": "看你们的样子，是来璃月过海灯节的吧？"
        },
        {
          "role": "凝光",
          "text": "是呀！今年海灯节你们都在忙什么？"
        },
        {
          "role": "凝光",
          "text": "还是老样子，各种杂事。对了，总务司今年策划了一场「烟花会」，值得一看哦。"
        },
        {
          "role": "凝光",
          "text": "海灯节向来以放飞「明霄灯」为节日重点，但最近璃月发生了许多事。我想，人们需要更多温暖与团结感。"
        },
        {
          "role": "凝光",
          "text": "所以我认为，至少今年我们要采取更特别也更贴近每一个人的庆祝方式。"
        },
        {
          "role": "凝光",
          "text": "将「烟花」送至璃月各处，选择合适的时间全数点燃。让更为炽热的光与热连接起人们的情感，这便是总务司的决定。"
        },
        {
          "role": "派蒙",
          "text": "烟花？我们在别的地方似乎也见过烟花哦。"
        },
        {
          "role": "派蒙",
          "text": "璃月的烟花有什么特别之处吗？"
        },
        {
          "role": "凝光",
          "text": "烟花这一事物，最早是从璃月的某种发明演变而来的。"
        },
        {
          "role": "凝光",
          "text": "璃月祖先创造烟花时，为它取名「爆竹」。它能发出强光与巨响，可用于驱赶毒蛇猛兽或是警示他人。"
        },
        {
          "role": "凝光",
          "text": "早年人们在外耕种，联络不便。「爆竹」一物因能发出巨晌，必要时会被用来传递信号。"
        },
        {
          "role": "凝光",
          "text": "璃月正式建立后，人们生活好转，不再赶往白里之外的土地耕种。渐渐地，也不再靠「爆竹」防身。"
        },
        {
          "role": "凝光",
          "text": "但先民手持「爆竹」艰苦垦荒的精神被延续下来，作为一种习俗流传在民间。"
        },
        {
          "role": "凝光",
          "text": "「爆竹」便是烟花的前身。我们改良了「爆竹」，放到海灯节期间燃放，以这种形式来纪念先民们的奋斗精神。"
        },
        {
          "role": "旅行者",
          "text": "不愧是璃月。"
        },
        {
          "role": "派蒙",
          "text": "真厉害…璃月的东西都好有历史渊源啊…"
        },
        {
          "role": "凝光",
          "text": "相信你们也已经习惯了。历史越久远，土地上的每一件事物就会承载越多价值。这便是璃月。"
        },
        {
          "role": "凝光",
          "text": "烟花相关的事务，我交由刻晴负责了。如果你们对烟花感兴趣，就随我同去见她吧。"
        },
        {
          "type": "subtitle",
          "text": "前往璃月烟花摊"
        },
        {
          "role": "刻晴",
          "text": "唔…布置烟花的地点还得再加几个。眼光要全面，不能局限在城里，难道轻策庄的人就不过海灯节了吗？"
        },
        {
          "role": "朋义",
          "text": "但、但是大人，这样的话，预算就…"
        },
        {
          "role": "刻晴",
          "text": "预算是什么？是「办好某件事最合适的量」。"
        },
        {
          "role": "刻晴",
          "text": "如果你认为现在的预算不够办好这件事，就向总务司提出申请，重新核算审批。"
        },
        {
          "role": "刻晴",
          "text": "我们的目的是办好这届海灯节，预算是为了更好地规划，不能本末倒置啊。"
        },
        {
          "role": "朋义",
          "text": "是，我明白了，刻晴大人。"
        },
        {
          "role": "刻晴",
          "text": "嗯。安全第一，务必保证。"
        },
        {
          "role": "刻晴",
          "text": "凝光，旅行者。难得见你们过来。"
        },
        {
          "role": "刻晴",
          "text": "旅行者是来参加海灯节的吗？刚好再过不久应该就能准备完毕了。"
        },
        {
          "role": "旅行者",
          "text": "刻晴在忙什么？"
        },
        {
          "role": "刻晴",
          "text": "复核烟花布置，再检查一下相关设施。算是日常的小工作。"
        },
        {
          "role": "凝光",
          "text": "恕我直言，这类工作交给下属处理也行。你已经连轴转了好几天，也该休息了。"
        },
        {
          "role": "刻晴",
          "text": "小事而已，无妨。"
        },
        {
          "role": "刻晴",
          "text": "朋义，劳烦你重新做个规划，总结成书面报告递交到总务司。"
        },
        {
          "role": "刻晴",
          "text": "我去城里看看烟花布置点的情况，稍后回来。"
        },
        {
          "role": "刻晴",
          "text": "旅行者，你是贵客，适逢佳节，还请留在城内好好享受节日氛围。"
        },
        {
          "role": "刻晴",
          "text": "朋义，我交代你的事，都记住了吗？"
        },
        {
          "role": "朋义",
          "text": "是，记清楚了！"
        },
        {
          "role": "刻晴",
          "text": "好。凝光，旅行者，告辞。"
        },
        {
          "role": "朋义",
          "text": "凝光大人，还有这位…旅行者，我就先不打扰二位了。"
        },
        {
          "role": "朋义",
          "text": "刻晴大人跟我讲了好多计划，我得重新去写一份计划书…抓紧时间，抓紧时间。"
        },
        {
          "role": "朋义",
          "text": "啊对！差点忘了…"
        },
        {
          "role": "朋义",
          "text": "旅行者，这里有个「烟花筒」，刻晴大人之前提过你可能会感兴趣，让我留着它，等见到你就交给你。"
        },
        {
          "role": "朋义",
          "text": "有动手能力的人，有了这个就能亲手调配制作属于自己的烟花了。你要是有时间，请务必试试！"
        },
        {
          "role": "派蒙",
          "text": "刚才我完全插不上话欸…"
        },
        {
          "role": "派蒙",
          "text": "不对，应该说，我是「完全不敢插话」！"
        },
        {
          "role": "旅行者",
          "text": "刻晴，好强的气势…"
        },
        {
          "role": "派蒙",
          "text": "你也这么觉得对吧？刻晴的气势比之前更强了！"
        },
        {
          "role": "派蒙",
          "text": "而且也比之前更忙…为什么呀？"
        },
        {
          "role": "凝光",
          "text": "众仙家将璃月港交由凡人全权治理，我们七星便担起了引导民众的责任。"
        },
        {
          "role": "凝光",
          "text": "我们接手各个领域的重要工作，紧锣密鼓地安排各项事宜。"
        },
        {
          "role": "凝光",
          "text": "话虽如此，事事亲为仍很费神。"
        },
        {
          "role": "凝光",
          "text": "往年，海灯节相关的统筹事宜都由江舟负责。但她家中老父年迈，今年便请调去了其他部门。"
        },
        {
          "role": "凝光",
          "text": "海灯节的工作，便落到了我和刻晴肩上。我担任总负责人，至于万众瞩目的「烟花会」，就交给刻晴了。"
        },
        {
          "role": "凝光",
          "text": "兹事体大，我认为，应当托付给最可靠的人。而刻晴严于律己，又对工作充满热忱，是最佳人选。"
        },
        {
          "role": "派蒙",
          "text": "确实是非常严格的人呀…"
        },
        {
          "role": "凝光",
          "text": "不错。对人对己都万分严格，以至于投入过度，连续操劳了好些日子。"
        },
        {
          "role": "凝光",
          "text": "我认为，这不是长久之计。"
        },
        {
          "role": "凝光",
          "text": "过犹不及，是璃月人都该懂得的道理。"
        },
        {
          "role": "凝光",
          "text": "我不是没劝过她，但她的性格你们也知道。巧舌如簧的人遇上刻晴，也是要碰一鼻子灰的。"
        },
        {
          "role": "凝光",
          "text": "旅行者，你跟刻晴关系不错，又见识广阔，不如也帮我劝劝她？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": []
            },
            {
              "text": "我会想个办法。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凝光",
          "text": "不愧是旅行者。劝说刻晴绝非易事，有你帮忙我也安心得多。"
        },
        {
          "role": "凝光",
          "text": "我还得回群玉阁处理些事务，先行一步。刻晴的事，就劳你多费心了。"
        },
        {
          "type": "subtitle",
          "text": "凝光离开了…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "你真的有办法说服刻晴吗？连凝光小姐都搞不定她欸…"
        },
        {
          "role": "派蒙",
          "text": "而且，想要说服一个人，至少得理解那个人现在的感受吧。"
        },
        {
          "role": "派蒙",
          "text": "刻晴现在应该是连续操劳，连休息日都没有…"
        },
        {
          "role": "旅行者",
          "text": "感受是…「很累」？"
        },
        {
          "role": "派蒙",
          "text": "这么浅显的理解根本没用吧！再想想，更重要更深入的感受是什么？"
        },
        {
          "role": "派蒙",
          "text": "或者，我们找个有心得的可靠的朋友问问吧？"
        },
        {
          "role": "旅行者",
          "text": "那就找钟离吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯？钟离…？"
        },
        {
          "role": "旅行者",
          "text": "他也比较了解璃月人。"
        },
        {
          "role": "派蒙",
          "text": "嗯，确实很可靠！就问他吧！"
        },
        {
          "role": "派蒙",
          "text": "他现在是「往生堂」的客卿，那我们就去「往生堂」找找他吧！"
        },
        {
          "type": "subtitle",
          "text": "前往往生堂寻找钟离"
        },
        {
          "type": "subtitle",
          "text": "又是一年海灯节，派蒙和你前去打听璃月人今年的节日安排。受凝光所托，你们开始寻找说服刻晴放下工作的办法。",
          "narration": true
        },
        {
          "role": "摆渡人",
          "text": "……"
        },
        {
          "role": "摆渡人",
          "text": "二位好。请问有什么事吗？"
        },
        {
          "role": "旅行者",
          "text": "我想找客卿钟离…"
        },
        {
          "role": "摆渡人",
          "text": "客卿跟堂主一起出门了。"
        },
        {
          "role": "派蒙",
          "text": "两个人都出门了？难、难道他们是去工作…"
        },
        {
          "role": "摆渡人",
          "text": "堂主说，是去散步。"
        },
        {
          "role": "摆渡人",
          "text": "如果二位要找他们，可以去「三碗不过港」看看。"
        },
        {
          "role": "摆渡人",
          "text": "听说，堂主经常去那一带…做宣传。"
        },
        {
          "type": "subtitle",
          "text": "前往「三碗不过港」"
        },
        {
          "role": "胡桃",
          "text": "呼——吃饱了吃饱了！"
        },
        {
          "role": "锅巴",
          "text": "♪！"
        },
        {
          "role": "胡桃",
          "text": "香菱呀，真亏你能想岀那种烤鱼配蘸水的新吃法，特别是那碗蘸水，味道可真好。"
        },
        {
          "role": "香菱",
          "text": "嘿嘿，那可是我的特制蘸水，昧道当然好啦。"
        },
        {
          "role": "钟离",
          "text": "干煸绝云椒椒磨成粉，加蒜泥、葱段拌匀，再加入盐、醋、酱油，最后以滚油钓香。"
        },
        {
          "role": "钟离",
          "text": "看似粗犷的手法背后，是厨师对口味与调料比例的精准理解。多一分则多，少一分则少。"
        },
        {
          "role": "钟离",
          "text": "此谓之「精道」。"
        },
        {
          "role": "胡桃",
          "text": "嗯嗯嗯对对。怎么样香菱，夸到你心坎里了吧？"
        },
        {
          "role": "香菱",
          "text": "嘿嘿…怪害羞的呢…谢谢钟离先生！"
        },
        {
          "role": "胡桃",
          "text": "我觉得吧，我这个人已经很能说会道了，没想到跟你一比，还是不够看。"
        },
        {
          "role": "钟离",
          "text": "堂主何必跟我客气。堂主的口才，整座璃月港有目共睹。"
        },
        {
          "role": "锅巴",
          "text": "♪～♪～"
        },
        {
          "role": "胡桃",
          "text": "锅巴要来点什么吗？不用客气，本堂主请你！账记香菱头上就好。"
        },
        {
          "role": "锅巴",
          "text": "？"
        },
        {
          "type": "subtitle",
          "text": "旅行者、派蒙走来",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "派蒙",
          "text": "你们又在说什么好吃的啦？"
        },
        {
          "role": "胡桃",
          "text": "哟！是旅行者和派蒙啊，什么风把你们吹来啦？"
        },
        {
          "role": "胡桃",
          "text": "慢着！先别说，让本堂主细细算来…唔，是来过海灯节的吧！"
        },
        {
          "role": "派蒙",
          "text": "一看就看出来了吧，还用猜吗？"
        },
        {
          "role": "胡桃",
          "text": "哎呀，这不是跟你们熟，逗你们乐嘛！"
        },
        {
          "role": "香菱",
          "text": "你们来得刚好，我正在请大家试吃新菜呢！"
        },
        {
          "role": "香菱",
          "text": "「三碗不过港」的老板给了好评，钟离先生和胡桃也都满意，但我总觉得，还得请更多人试试才行…"
        },
        {
          "role": "香菱",
          "text": "怎么样，你们要吃吃看吗？"
        },
        {
          "role": "派蒙",
          "text": "要吃要吃！"
        },
        {
          "role": "旅行者",
          "text": "我们是来找钟离先生的。"
        },
        {
          "role": "派蒙",
          "text": "啊？不、不吃吗？好吧…那先办正事…"
        },
        {
          "role": "钟离",
          "text": "许久不见，近来旅行可还顺利？"
        },
        {
          "role": "旅行者",
          "text": "还不错，长了不少见识。"
        },
        {
          "role": "钟离",
          "text": "如此甚好。"
        },
        {
          "role": "胡桃",
          "text": "所以呢所以呢？找咱们客卿有何贵干呀？"
        },
        {
          "role": "胡桃",
          "text": "先说好，我们今天出门也有正事要办哦！试菜只是顺便啦。"
        },
        {
          "role": "派蒙",
          "text": "办、办事，不能是往生堂的事吧？明明在过节呢…"
        },
        {
          "role": "胡桃",
          "text": "过节也有生老病死是不是？别大惊小怪的。好啦，吓唬你的，我是想着今天天气不错，出来看看街景，顺道宣传一下业务…"
        },
        {
          "role": "胡桃",
          "text": "你们聊着吧，我跟香菱去老板那边蹭点茶喝。钟离忙完记得找我就行！"
        },
        {
          "role": "钟离",
          "text": "可以。堂主慢走。"
        },
        {
          "type": "subtitle",
          "text": "香菱、胡桃离开，钟离目送",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "钟离",
          "text": "旅行者，发生什么事了？"
        },
        {
          "role": "旅行者",
          "text": "事情是这样的…"
        },
        {
          "type": "subtitle",
          "text": "向钟离说明了刻晴的情况…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "钟离",
          "text": "玉衡星为人刚正又聪敏勤勉，自是栋梁之才。不过，凡事均有度，还是身体要紧。"
        },
        {
          "role": "旅行者",
          "text": "有什么办法劝劝她吗？"
        },
        {
          "role": "派蒙",
          "text": "对呀对呀，你说话总是很有道理的样子，她应该会听你的吧！"
        },
        {
          "role": "钟离",
          "text": "我若是岩王帝君，尚能说服她几分。但我如今是一介客卿，也得考虑身份了。"
        },
        {
          "role": "钟离",
          "text": "何况玉衡星和我并不算熟识，冒昧进言说教，只会招人反感。"
        },
        {
          "role": "派蒙",
          "text": "欸？那怎么办…"
        },
        {
          "role": "钟离",
          "text": "旁敲侧击，或可一试。"
        },
        {
          "role": "钟离",
          "text": "要是有一个能让她动容的故事，就能将你要说的道理融入其中了。"
        },
        {
          "role": "钟离",
          "text": "取材自生活，便能赢得共鸣。话中谈及亲近的人事，更能事半功倍。"
        },
        {
          "role": "派蒙",
          "text": "呃…是什么意思呀…"
        },
        {
          "role": "旅行者",
          "text": "我们去找熟悉刻晴的人问问。"
        },
        {
          "role": "钟离",
          "text": "旅行者果真是一点就通。"
        },
        {
          "role": "钟离",
          "text": "寻些素材来吧。你若愿意，我也可以帮着提些建议。"
        },
        {
          "role": "钟离",
          "text": "构思妥当后，将此故事经你之口说与玉衡星即可。"
        },
        {
          "role": "旅行者",
          "text": "我？"
        },
        {
          "role": "钟离",
          "text": "玉衡星与你有交情。要说人选，你最是合适。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样！也就是说，找刻晴认识的人多打听对吧？从谁先开始呢？"
        },
        {
          "type": "subtitle",
          "text": "刻晴走来",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "刻晴",
          "text": "原来你们在这里。"
        },
        {
          "role": "派蒙",
          "text": "咦？刻、刻晴！"
        },
        {
          "role": "刻晴",
          "text": "没想到钟离先生也在。上次「送仙典仪」还是多亏了先生帮忙。"
        },
        {
          "role": "钟离",
          "text": "帮了些小忙而已，玉衡星不必客气。"
        },
        {
          "role": "旅行者",
          "text": "你、你怎么来了？"
        },
        {
          "role": "刻晴",
          "text": "怎么了？你们的表情为什么这么奇怪？"
        },
        {
          "role": "刻晴",
          "text": "莫非是我来得太突然，打扰到你和钟离先生谈话了？抱歉…"
        },
        {
          "role": "旅行者",
          "text": "不不，没打扰没打扰。"
        },
        {
          "role": "派蒙",
          "text": "刻晴怎么突然想到要找我们？"
        },
        {
          "role": "刻晴",
          "text": "我来，是想请你们将我引见给仙家。佳节将至，我要代表璃月七星给各路仙家送些礼物。"
        },
        {
          "role": "派蒙",
          "text": "上次跟仙人们并肩作战的时候，他们不都见过你了吗？"
        },
        {
          "role": "派蒙",
          "text": "既然认识，直接去绝云间就行啦。"
        },
        {
          "role": "刻晴",
          "text": "一面之缘而已，仙人们或许已经记不得我了。贸然访问，怕是会惹人不快。"
        },
        {
          "role": "刻晴",
          "text": "所以我想，请你们引见才是最符合礼数的做法。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当然没问题。",
              "dialogues": []
            },
            {
              "text": "刻晴没问过甘雨吗？",
              "dialogues": [
                {
                  "role": "刻晴",
                  "text": "甘雨这几天请假，一时半会儿找不到她。"
                },
                {
                  "role": "刻晴",
                  "text": "还是麻烦你吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "原来还要负责上门送礼，做七星可真辛苦啊…"
        },
        {
          "role": "旅行者",
          "text": "我们会帮忙的。"
        },
        {
          "role": "刻晴",
          "text": "好，那便说定了。我先回去准备礼物。"
        },
        {
          "role": "刻晴",
          "text": "大好的节日却要麻烦你陪着我东奔西跑，实在抱歉…我们速战速决，绝不耽搁你看烟花的行程。"
        },
        {
          "role": "旅行者",
          "text": "那不如一起去看烟花吧！"
        },
        {
          "role": "刻晴",
          "text": "欸？一、一起吗？"
        },
        {
          "role": "刻晴",
          "text": "也好，等我忙完手上的事，就随你一起去。"
        },
        {
          "role": "刻晴",
          "text": "钟离先生也是。今年的「烟花会」质量不错，先生切莫错过。"
        },
        {
          "role": "钟离",
          "text": "当然。多谢提醒。"
        },
        {
          "role": "刻晴",
          "text": "我先去忙了。旅行者，你准备完毕直接来群玉阁找我吧。"
        },
        {
          "type": "subtitle",
          "text": "刻晴离开",
          "narration": true,
          "color": "描述2"
        },
        {
          "role": "派蒙",
          "text": "走掉了呢。"
        },
        {
          "role": "钟离",
          "text": "玉衡星办事向来雷厉风行，令人安心。"
        },
        {
          "role": "派蒙",
          "text": "钟离你也很可靠啊！对吧，旅行者？"
        },
        {
          "role": "钟离",
          "text": "承蒙夸奖。"
        },
        {
          "role": "钟离",
          "text": "刚才说的事，也请二位记在心上。等你们搜集了足够多的素材，我们可以约在此处，再做商讨。"
        }
      ]
    }
  ]
}