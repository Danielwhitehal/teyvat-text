{
  "quest_id": 20013,
  "chapter_num": null,
  "chapter_title": "此路不通？",
  "type": "iq",
  "route": "Blocked?",
  "stories": [
    {
      "story_id": 20013,
      "title": "此路不通？",
      "description": "杰克正去一处新的冒险地点探险，但是在醉汉峡却被路障拦截，遭到丘丘人的围攻。消灭丘丘人，解救杰克。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前去查看详请"
        },
        {
          "role": "杰克",
          "text": "快来救救我！"
        },
        {
          "type": "subtitle",
          "text": "消灭所有魔物并摧毁路障"
        },
        {
          "type": "subtitle",
          "text": "与杰克对话"
        },
        {
          "role": "杰克",
          "text": "太感谢你了，旅行者。"
        },
        {
          "role": "杰克",
          "text": "我本来是想去斯坦利先生冒险过的地方看看，但是没想到半路上遇见了这群家伙…"
        },
        {
          "role": "杰克",
          "text": "我的实力还是太弱了，假如是斯坦利先生，肯定能把这群家伙全部消灭。"
        },
        {
          "role": "杰克",
          "text": "要是你愿意和我一起去冒险…还是算了，不能事事都依靠别人。"
        },
        {
          "role": "杰克",
          "text": "我要接着往前走了，这个给你，我在路上摘了好多做干粮…"
        },
        {
          "role": "杰克",
          "text": "不过，这也不能叫「干粮」，对吧。"
        }
      ]
    }
  ]
}