{
  "quest_id": 73705,
  "chapter_num": null,
  "chapter_title": "稳健知行，完备冲刺！",
  "type": "wq",
  "route": "Fieldwise Mastery, Unyielding Progress!",
  "stories": [
    {
      "story_id": 73705,
      "title": "稳健知行，完备冲刺！",
      "description": "在柯莱的邀请下，你和派蒙来到了全新的教令院机构「稳健知行」的会场，准备参与到这一机构的完善工作中去…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与柯莱对话"
        },
        {
          "role": "柯莱",
          "text": "旅行者和派蒙！这边这边！"
        },
        {
          "role": "柯莱",
          "text": "欢迎来到「稳健知行」机构的主场！"
        },
        {
          "role": "柯莱",
          "text": "请看，几个核心项目的设施已经搭建好了，大家随时都可以投入工作——"
        },
        {
          "role": "派蒙",
          "text": "喔！这种氛围，好像轻小说里提过的…「年轻冒险家们的第一个据点」？"
        },
        {
          "role": "派蒙",
          "text": "唔…又有点学园庆典的感觉，大家聚在一起，仔细研究课题后，组队出发历练自己…让人跃跃欲试！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没错没错，充满干劲！",
              "dialogues": []
            },
            {
              "text": "容我先看看派蒙喜欢的轻小说…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "柯莱",
          "text": "虽然这个场地不像学园庆典那样豪华，但按提纳里师父的说法，教令院会给我们调配「最有效能」的资源。"
        },
        {
          "role": "柯莱",
          "text": "学生和学者们前往危险地带之前，会来我们这里仔细咨询，甚至接受一番紧急训练…"
        },
        {
          "role": "柯莱",
          "text": "如果有必要的话，我们会派遣专人加入他们的队伍，充当可靠的向导和安全员。"
        },
        {
          "role": "安柏",
          "text": "按照时下流行的叫法，这里是一半训练，一半实战的「前进基地」哦。"
        },
        {
          "role": "安柏",
          "text": "让新兵们意识到自己即将面对的挑战，好好锻炼一下拳脚，再踏入未知的领域，才不会手忙脚乱！"
        },
        {
          "role": "派蒙",
          "text": "安柏？居然是你！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "侦察骑士的工作范围拓展了？",
              "dialogues": []
            },
            {
              "text": "柯莱招兵买马的范围这么广？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "嘿嘿，惊喜吧？我也觉得意外！"
        },
        {
          "role": "安柏",
          "text": "本来啊，我只是趁着轮岗的空闲期，来须弥看望柯莱…"
        },
        {
          "role": "安柏",
          "text": "没想到柯莱倒是忙了起来，那我可不能坐在一边呆呆看着，就来扮演柯莱的副手好了！"
        },
        {
          "role": "柯莱",
          "text": "不好意思，安柏，没能让你好好休假…"
        },
        {
          "role": "安柏",
          "text": "没这回事啦，充实和松弛对半分的假期也非常不错嘛！这份临时工让我开了不少眼界哦。"
        },
        {
          "role": "安柏",
          "text": "而且，正是因为来帮你的忙，我才能在意想不到的地方遇上旅行者和派蒙，更值得庆祝了！"
        },
        {
          "role": "安柏",
          "text": "等到这边的工作差不多稳定下来，我们一起去吃顿大餐，好好庆祝下吧？"
        },
        {
          "role": "派蒙",
          "text": "好哦！在须弥和我们冒险最初认识的伙伴碰头，一起聚餐，肯定会像…"
        },
        {
          "role": "派蒙",
          "text": "大份的蜜酱胡萝卜煎肉一样开心！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我们早些开工，早点收工！",
              "dialogues": []
            },
            {
              "text": "为了开心地聚餐，先认真干活！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "好呀！我们言归正传——"
        },
        {
          "role": "安柏",
          "text": "柯莱和我负责的项目是「高速侦察伙伴」，旨在运用机关技术，快速通过危险地带，勘测地形与魔物的详情。"
        },
        {
          "role": "柯莱",
          "text": "根据生论派的研究，在危险的环境中，可爱乖巧的伙伴能让冒险者的心神安定，避免过度紧张…"
        },
        {
          "role": "安柏",
          "text": "所以我们参考柯里安巴和兔兔伯爵的形象，制作了侦察机关「翠星柯里安巴」和「赤红飞兔伯爵」，反馈还不错！"
        },
        {
          "role": "柯莱",
          "text": "收集了充足的信息后，教令院还会对侦察伙伴进行修改，推出各种不同外形的款式。"
        },
        {
          "role": "派蒙",
          "text": "柯里安巴和兔兔伯爵快速冲刺…会是什么样的画面呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很对！两位是让人安心的伙伴！",
              "dialogues": []
            },
            {
              "text": "一时间还无法想象那种情景…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "柯莱",
          "text": "由旅行者来指引两位侦察伙伴行动，肯定能获得非常独特的数据。"
        },
        {
          "role": "柯莱",
          "text": "等你们了解整个「稳健知行」机构后，就可以来尝试一番。"
        },
        {
          "role": "柯莱",
          "text": "接下来，请跟着我去和其他几位顾问见个面。"
        },
        {
          "role": "安柏",
          "text": "那位青色头发的姐姐也有一名很可爱的伙伴机关哦！"
        },
        {
          "role": "安柏",
          "text": "不过，用途和我们的「柯里安巴兔兔伯爵组合」不同呢。"
        },
        {
          "role": "安柏",
          "text": "我很期待她们的表现！"
        },
        {
          "role": "派蒙",
          "text": "第二个项目…也是熟悉的面孔，太好了！"
        },
        {
          "role": "派蒙",
          "text": "我们这就去和老朋友打个招呼吧？"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（安柏）"
        },
        {
          "role": "安柏",
          "text": "（再加把劲，把一切准备做得妥妥当当！）"
        },
        {
          "role": "安柏",
          "text": "嗯，再调整一下双腿，让「赤红兔兔伯爵」跑得更快！"
        },
        {
          "type": "subtitle",
          "text": "与珐露珊对话"
        },
        {
          "type": "subtitle",
          "text": "心声（珐露珊）"
        },
        {
          "role": "珐露珊",
          "text": "（人气真的有那么高吗？）"
        },
        {
          "role": "珐露珊",
          "text": "…人气真的有那么高吗？"
        },
        {
          "role": "珐露珊",
          "text": "内藏行走机构的方法还算巧妙，地形识别、远程控制和重量感应的模块也处理得不错。"
        },
        {
          "role": "珐露珊",
          "text": "但外观上，怎么看都只是普通的布偶，要不然，还是改改吧…"
        },
        {
          "role": "柯莱",
          "text": "珐露珊前辈，我来告诉您一条好消息——"
        },
        {
          "role": "柯莱",
          "text": "旅行者和派蒙加入了我们，「稳健知行」机构的队伍变得更厉害了！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，珐露珊前辈好！我们来帮忙啦！"
        },
        {
          "role": "珐露珊",
          "text": "啊呀呀，这可不得了啊…"
        },
        {
          "role": "珐露珊",
          "text": "真不错，柯莱！居然请来了两位业内公认的顶尖专家，那不管我给出什么评测，协会都要乖乖点头咯！"
        },
        {
          "role": "珐露珊",
          "text": "正好，你们看看这个「解谜伙伴」，感觉怎么样？"
        },
        {
          "role": "派蒙",
          "text": "喔…居然直接用了珐露珊的形象？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉舒适又惬意。",
              "dialogues": []
            },
            {
              "text": "完全看不出是探险装备。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珐露珊",
          "text": "这就要问学院的后辈们，还有解谜协会和遗迹机关研讨会的成员了。"
        },
        {
          "role": "珐露珊",
          "text": "他们通力合作的产物，明明有着相当高的技术含量，却要用孩子气的外表来包装。"
        },
        {
          "role": "珐露珊",
          "text": "尤其是后辈里的[[阿尼斯]]，一个劲地解说采用这个外观的优势，比她给课题答辩时还拼命…"
        },
        {
          "role": "珐露珊",
          "text": "当下的年轻人啊，是不是太过沉迷于可爱的东西了？"
        },
        {
          "role": "派蒙",
          "text": "我可以说嘛？感觉这样还挺不错的！"
        },
        {
          "role": "派蒙",
          "text": "柯莱和安柏刚刚还解释过，可爱的伙伴能让冒险家避免过度紧张，安安心心。"
        },
        {
          "role": "派蒙",
          "text": "如果和珐露珊前辈的布偶一起冒险，哪怕是走进了到处黑咕隆咚的遗迹，应该也不会紧张吧…"
        },
        {
          "role": "珐露珊",
          "text": "这种考虑确实有道理，后辈们选定这个外形，也算是对我的某种尊重吧…咳。"
        },
        {
          "role": "珐露珊",
          "text": "不过，也有相当多的冒险者，更重视机关的可靠性和技术水平。"
        },
        {
          "role": "珐露珊",
          "text": "他们大概会认为，「机关就应该表现得坚硬，要能承受落石轰击，要表现出尖端的科技水平」。"
        },
        {
          "role": "珐露珊",
          "text": "这个「解谜伙伴」的外形太蓬松柔软，反而不会给人…厉害和可靠的印象，说不定还有可能让人分心。"
        },
        {
          "role": "珐露珊",
          "text": "如果换成磨砂金属的厚重外壳，方方正正，并且适当展现复杂的机件，视觉上的鼓舞作用会更强。"
        },
        {
          "role": "珐露珊",
          "text": "哪怕是我，也有过因为外貌年轻而被人质疑的时候。假如我一头白发，他们大概就不会说闲话了。"
        },
        {
          "role": "派蒙",
          "text": "真，真的吗，那我岂不是能让那些人信服？"
        },
        {
          "role": "珐露珊",
          "text": "啊？这…呃…这可不能混为一谈！"
        },
        {
          "role": "柯莱",
          "text": "没想到珐露珊前辈…在这方面意外地严格呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我觉得现在的外形还不错喔。",
              "dialogues": []
            },
            {
              "text": "方方正正的外形下次再说吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珐露珊",
          "text": "欸？连旅行者也支持？"
        },
        {
          "role": "珐露珊",
          "text": "呃咳咳…唔…"
        },
        {
          "role": "珐露珊",
          "text": "好吧！既然旅行者都这么说了…"
        },
        {
          "role": "珐露珊",
          "text": "我提议，之后就由旅行者来操纵「解谜伙伴」，尝试破开几个谜题典例。"
        },
        {
          "role": "珐露珊",
          "text": "我会好好评估旅行者运用这种机关的效率，然后根据你的表现，制作它的使用规范手册…"
        },
        {
          "role": "珐露珊",
          "text": "至于外形的改进，还需要长期观察，我就暂时搁置迭代的建议好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好耶！待会儿我一定好好表现！",
              "dialogues": []
            },
            {
              "text": "我会让解谜机关发挥最佳性能！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珐露珊",
          "text": "等到你们准备停当，就来找我吧。我已经选中了最适合的几个秘境，随时可以开始解谜。"
        },
        {
          "role": "柯莱",
          "text": "辛苦珐露珊前辈了，还请您稍等，接下来，我带旅行者和派蒙去看看最后一个项目…"
        },
        {
          "role": "珐露珊",
          "text": "哪里哪里，柯莱才是费神费力了，注意别累着自己哦。"
        },
        {
          "role": "珐露珊",
          "text": "闲下来了，就叫上旅行者和派蒙来前辈这里坐一坐，歇一歇，吃些古法点心，慢慢聊聊天。"
        },
        {
          "role": "派蒙",
          "text": "古法点心！我我我，我一定会来的！"
        },
        {
          "role": "柯莱",
          "text": "谢谢前辈，我也要带几盒上好的花茶来给您！"
        },
        {
          "role": "珐露珊",
          "text": "去吧去吧，好好表现！"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（珐露珊）"
        },
        {
          "role": "珐露珊",
          "text": "（再仔细看看这机关动起来的模样吧…）"
        },
        {
          "role": "珐露珊",
          "text": "要不然，还是不改了？"
        },
        {
          "type": "subtitle",
          "text": "前往下个项目"
        },
        {
          "role": "柯莱",
          "text": "接下来就是最后的项目了——为了长久发展而建立的「安全分队」。"
        },
        {
          "role": "柯莱",
          "text": "多亏大风纪官赛诺先生从中沟通，「稳健知行」机构请到了迪希雅和坎蒂丝小姐，分别担任教官与协调员。"
        },
        {
          "role": "柯莱",
          "text": "她们两位正在筹备战斗考核的事宜，应该也快回来了…"
        },
        {
          "role": "迪希雅",
          "text": "哟，在找我们？看来我们出现得正是时候？"
        },
        {
          "role": "迪希雅",
          "text": "旅行者和派蒙也要入伙吗？那事情就变得轻松愉快了！"
        },
        {
          "role": "坎蒂丝",
          "text": "久等了，几位，我们带回了合适的情报。"
        },
        {
          "role": "派蒙",
          "text": "收集情报？这么正经？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听起来像是大战前的准备…",
              "dialogues": []
            },
            {
              "text": "难道在筹划什么进攻行动…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪希雅",
          "text": "那可不，毕竟是关乎普通学生安全的大事，不把沙漠里的危险分子犁个干净，说不过去吧？"
        },
        {
          "role": "坎蒂丝",
          "text": "玩笑先放一边吧，迪希雅。"
        },
        {
          "role": "坎蒂丝",
          "text": "说不定旅行者听了你的话，会认真地拔剑出击，从这里打到沙漠尽头…"
        },
        {
          "role": "派蒙",
          "text": "把所有危险分子都干掉…以旅行者的效率，得在沙漠里住上好几年，每天从日出工作到日落才行吧？"
        },
        {
          "role": "派蒙",
          "text": "旅行也得停下来，完全不敢想…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "毕竟沙漠实在太大了…",
              "dialogues": []
            },
            {
              "text": "根本数不清总共有多少敌人…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "柯莱",
          "text": "时间是最简单的问题，很多危险都没法直接用肉眼确认，比如隐藏在地下的毒蝎，睡在树上的恐怖大怪鸟。"
        },
        {
          "role": "柯莱",
          "text": "只有到了它们跳出来拦住去路的时候，才有可能和它们正面过招。"
        },
        {
          "role": "柯莱",
          "text": "这种时候，应该按照珐露珊前辈的叮嘱，结合安柏的侦察思路，好好算一算接敌概率，和行动时间的综合期望…"
        },
        {
          "role": "迪希雅",
          "text": "喂喂，你们两个还真开始盘算了啊！"
        },
        {
          "role": "坎蒂丝",
          "text": "其实远没有那么夸张，「安全分队」的职责，是确保外出考察的学生队伍中，有着可靠的随行护卫。"
        },
        {
          "role": "坎蒂丝",
          "text": "这份差事一部分包给了「炽光猎兽」与合作佣兵，一部分由考察队伍中经过战斗考核的强者自行承接。"
        },
        {
          "role": "坎蒂丝",
          "text": "考察队伍准备前往危险地带前，必须在队伍中编入至少两名通过了战斗考核的专业人员。"
        },
        {
          "role": "坎蒂丝",
          "text": "而我和迪希雅刚刚收集好的情报，就关乎战斗考核的场地。"
        },
        {
          "role": "迪希雅",
          "text": "嘿，找到了一座魔物和贼匪盘踞的秘境，各种水平的坏家伙管够，正好借他们脑袋一用，验证护卫们的本领。"
        },
        {
          "role": "派蒙",
          "text": "这么听起来，只要监督考核的过程就可以了？其实是考官！"
        },
        {
          "role": "坎蒂丝",
          "text": "请放心，我和迪希雅会安排可靠人士轮岗，保证参加者的人身安全。"
        },
        {
          "role": "迪希雅",
          "text": "目前还有个没解决的问题——考核的标准。毕竟，战斗不是做题，没有唯一的解法。"
        },
        {
          "role": "迪希雅",
          "text": "我们每个佣兵都有自己习惯的战斗风格，实战完全不成问题，可要当教官的话，路子略微有点一成不变…"
        },
        {
          "role": "迪希雅",
          "text": "所以需要一位见多识广、战斗思维灵活的专家，来给出一份可供参考的理想答卷。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是我的专长，我来搞定。",
              "dialogues": []
            },
            {
              "text": "我来这里就是为了帮忙。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦对哦，要说眼界宽和灵活变通，我不知道有什么人能比过旅行者了！"
        },
        {
          "role": "迪希雅",
          "text": "爽快！和旅行者合作就是这么顺畅、愉悦，像抹足了油和香料的烤肉排！"
        },
        {
          "role": "坎蒂丝",
          "text": "记得准备好答谢旅行者和派蒙的报酬，迪希雅。你听了合作要求后就答应了，还没仔细算过账。"
        },
        {
          "role": "迪希雅",
          "text": "没事没事！柯莱帮我们和教令院谈下的报酬，二八分成，我一，你一，旅行者和派蒙拿八成。"
        },
        {
          "role": "派蒙",
          "text": "咦！我们居然拿八成吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是不是有点多…",
              "dialogues": []
            },
            {
              "text": "感谢迪希雅关照！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迪希雅",
          "text": "哈哈哈，我们就别见外了！"
        },
        {
          "role": "迪希雅",
          "text": "总之，安全分队的工作，由你们来定标准，我们负责执行和长期经营，你们苦劳最大。"
        },
        {
          "role": "迪希雅",
          "text": "我们以前就谈好过合作的计划了，这次正好开个漂亮的头。"
        },
        {
          "role": "柯莱",
          "text": "那，那我会好好算账的，仔细列出酬金的明细，让你们一眼就能看个明白。"
        },
        {
          "role": "迪希雅",
          "text": "麻烦你啦，柯莱！"
        },
        {
          "role": "柯莱",
          "text": "还有坎蒂丝小姐，也请放心。"
        },
        {
          "role": "柯莱",
          "text": "关于阿如村粮仓这片土地的临时租金，我也成功让教令院点头，在之前的基础上提了三成。"
        },
        {
          "role": "坎蒂丝",
          "text": "感谢理解，这笔钱会被用来修缮村内的设施。考察队伍在阿如村落脚时，也能得到更舒适的体验。"
        },
        {
          "role": "坎蒂丝",
          "text": "那我们就在「安全分队」的小站稍作整理，以便旅行者开展行动。"
        },
        {
          "role": "迪希雅",
          "text": "待会儿见哦！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，柯莱这次可是毋庸置疑的核心人物呢，把大家团结在一起。"
        },
        {
          "role": "柯莱",
          "text": "没有啦没有啦，我只是尽了自己最大的努力而已。"
        },
        {
          "role": "柯莱",
          "text": "还有很多事情要学，很多工作要协调…"
        },
        {
          "role": "柯莱",
          "text": "总之，旅行者和派蒙，我们一起加油吧！"
        },
        {
          "role": "派蒙",
          "text": "好哦好哦！目标是——把「稳健知行」机构办得无可挑剔！"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（哈贾娜德）"
        },
        {
          "role": "哈贾娜德",
          "text": "啊哈…啊哈哈哈…又见面了，我的恩人旅行者。"
        },
        {
          "role": "哈贾娜德",
          "text": "我是悉般多摩学院的新晋学者哈贾娜德，即将带领专门人士入场，协助「稳健知行」机构之后的运作。"
        },
        {
          "role": "哈贾娜德",
          "text": "不过，在此之前，尚需短暂的交接工作，还请您稍作等待。"
        },
        {
          "role": "哈贾娜德",
          "text": "（这次可是正式升为学者后的第一次大任务，一定要好好表现！）"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（安柏&柯莱）"
        },
        {
          "role": "安柏",
          "text": "哟，旅行者！状态还好吗？要不要试试「翠星柯里安巴」和「赤红飞兔伯爵」的全速冲刺？"
        },
        {
          "role": "柯莱",
          "text": "两位「侦察伙伴」已经调试完毕了，一切就绪！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就开始吧！",
              "dialogues": [
                {
                  "role": "安柏",
                  "text": "好呀！有点找回飞行测试那时的感觉了！"
                }
              ]
            },
            {
              "text": "柯莱忙得过来吗？",
              "dialogues": [
                {
                  "role": "柯莱",
                  "text": "请放心，这座小站也兼作「稳健知行」的临时办事处。"
                },
                {
                  "role": "柯莱",
                  "text": "平时，我就一起和安柏处理「侦察伙伴」的实测数据，填填表。"
                },
                {
                  "role": "安柏",
                  "text": "还有还有，给出内部机关的修改建议！"
                },
                {
                  "role": "安柏",
                  "text": "如果考察队伍过来了，我们就去登记信息，确认他们是否需要紧急训练，然后办理出行手续，分配人员和装备…"
                },
                {
                  "role": "安柏",
                  "text": "然后就是时刻注意这个营地的物资补给，和后勤人员沟通…"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "这么多事？好忙！",
                      "dialogues": []
                    },
                    {
                      "text": "应该给你们俩多发几份工资。",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "柯莱",
                  "text": "没事没事，只是暂时的。这个机构刚刚起步不久，一切都在建设中。"
                },
                {
                  "role": "安柏",
                  "text": "不用担心，起码，确认学生们的出行资格，还有关注后勤物资这些活儿，我很拿手！"
                },
                {
                  "role": "柯莱",
                  "text": "教令院还会调遣后续的专家，建立一支正规的文书工作组，根据我们的指示进行工作。"
                },
                {
                  "role": "柯莱",
                  "text": "那边已经有几位专家就位了，等到他们进入状态，学者们给出完备的认证，我们就可以慢慢把工作交接出去。"
                },
                {
                  "role": "安柏",
                  "text": "然后就能开开心心休息一段时间啦！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "安柏去须弥各地玩过了吗？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "安柏",
                  "text": "嘿嘿，出发之前，我找丽莎小姐和凯亚队长好好咨询过一番，做好了旅行计划。"
                },
                {
                  "role": "安柏",
                  "text": "不过，这次时间有点紧，柯莱先带我在须弥城里逛了逛，享受了很棒很棒的本地美食。"
                },
                {
                  "role": "安柏",
                  "text": "看柯莱这么忙，我也不好意思叫她陪我到处跑。相反，应该是我多陪陪她，帮帮忙才对。"
                },
                {
                  "role": "柯莱",
                  "text": "对不起，安柏…"
                },
                {
                  "role": "安柏",
                  "text": "哎呀，你干嘛道歉？我明明很开心！"
                },
                {
                  "role": "安柏",
                  "text": "因为，我亲眼见识到了，现在的柯莱稳重又可靠，是须弥的朋友们信任…甚至依靠的对象！"
                },
                {
                  "role": "安柏",
                  "text": "旅行和玩乐什么的，随时都可以出发嘛，我又不是只来这一次。"
                },
                {
                  "role": "安柏",
                  "text": "你把「稳健知行」的工作办得稳稳当当以后，我们再安安心心去玩也不迟！"
                },
                {
                  "role": "柯莱",
                  "text": "呜…感觉…更有干劲了…"
                },
                {
                  "role": "柯莱",
                  "text": "我一定要好好工作，把一切事务处理得妥妥当当，不让安柏操心！"
                }
              ]
            },
            {
              "text": "待会儿再来试试！",
              "dialogues": [
                {
                  "role": "安柏",
                  "text": "好哦，不着急不着急，你先忙手头的事！"
                },
                {
                  "role": "柯莱",
                  "text": "我们随时等你！"
                }
              ]
            }
          ]
        },
        {
          "role": "安柏",
          "text": "（柯莱好有干劲啊…我的心情也变得超棒了！）"
        },
        {
          "role": "柯莱",
          "text": "（还有哪些工作事项没有处理好呢…要仔细检查备忘录才行！）"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（珐露珊）"
        },
        {
          "role": "珐露珊",
          "text": "来啦，旅行者？是想深入研究一番机关解谜，还是来陪前辈我聊聊天的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "先来解谜吧！",
              "dialogues": [
                {
                  "role": "珐露珊",
                  "text": "不错不错，我在你的眼里看见了旺盛的求知火光，好好表现吧！"
                }
              ]
            },
            {
              "text": "有些想问前辈的事。",
              "dialogues": [
                {
                  "role": "珐露珊",
                  "text": "哼哼，尽管提问吧，仅限于你，前辈我可是有问必答的哦。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "前辈偏好可爱还是精致的玩偶？",
                      "dialogues": [
                        {
                          "role": "珐露珊",
                          "text": "那当然是精致的种类…"
                        },
                        {
                          "role": "珐露珊",
                          "text": "倒也不是「不喜欢」可爱的风格，很少有人会反感胖乎乎、眼睛大大、脸蛋圆圆的小家伙吧。"
                        },
                        {
                          "role": "珐露珊",
                          "text": "但毕竟这把年纪了，还和小孩一样抱着圆圆软软的玩偶，多少有些…有失威严。"
                        },
                        {
                          "role": "珐露珊",
                          "text": "相反，近来有些用料考究，线条优美，五官刻画细致，妆容如宝石般闪亮亮的玩偶。"
                        },
                        {
                          "role": "珐露珊",
                          "text": "在兼顾可爱特质的同时，给人的第一反应是艺术品般的美观，就能两者兼得。"
                        },
                        {
                          "role": "珐露珊",
                          "text": "不对…我以为你想咨询学术上的问题，怎么问的是这些无关问题？"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "欸嘿！知道了前辈的喜好！",
                              "dialogues": []
                            }
                          ]
                        },
                        {
                          "role": "珐露珊",
                          "text": "咳咳，这次就先不计较了，以后再和我「欸嘿」，也没法蒙混过关了哦！"
                        }
                      ]
                    },
                    {
                      "text": "自动和手控的机关谁更好？",
                      "dialogues": [
                        {
                          "role": "珐露珊",
                          "text": "哦，经典的自主行动和手动控制之争问题…"
                        },
                        {
                          "role": "珐露珊",
                          "text": "我不是那种死板的，认准一个道理就不知变通的家伙，这个问题的答案完全取决于应用场景。"
                        },
                        {
                          "role": "珐露珊",
                          "text": "简单来说，需要大量重复机械性行为，稀释了人脑劳动价值的工作，自主行动的机关更好。"
                        },
                        {
                          "role": "珐露珊",
                          "text": "侧重于「辨识」、「分析」和「决策」的场景下，手动控制的机关永远更保险。"
                        },
                        {
                          "role": "珐露珊",
                          "text": "因为人的思维相当复杂，哪怕只是模拟六岁小孩的思维，都需要付出无比巨大的…器件复杂度、系统重量和能量成本。"
                        },
                        {
                          "role": "珐露珊",
                          "text": "在我可预见的一段时间内，以量产化的技术模拟成年人思维的传统设备啊，基本不可能下放到小型化的机关身上。"
                        },
                        {
                          "type": "choice",
                          "role": "旅行者",
                          "options": [
                            {
                              "text": "好精准的概括！",
                              "dialogues": []
                            },
                            {
                              "text": "新知识在脑袋里住下了…",
                              "dialogues": []
                            }
                          ]
                        },
                        {
                          "role": "珐露珊",
                          "text": "我就说嘛，如果你对这样的学术问题感兴趣，你应该来听我的课。"
                        },
                        {
                          "role": "珐露珊",
                          "text": "以你的聪颖才思…嗯，肯定能从居勒什的学生丽莎·敏兹那里，夺走「两百年一见高材生」的荣誉！"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "我先去处理一下别的事…",
              "dialogues": [
                {
                  "role": "珐露珊",
                  "text": "去吧去吧，空闲下来了，就记得来找前辈我哦。"
                }
              ]
            }
          ]
        },
        {
          "role": "珐露珊",
          "text": "（如果旅行者也觉得这个玩偶很可爱，那就让年轻人们放手量产好了…）"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（迪希雅&坎蒂丝）"
        },
        {
          "role": "迪希雅",
          "text": "哟，旅行者！要去检验「考官」们的成色吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "正合我意，这就去会会对手！",
              "dialogues": [
                {
                  "role": "坎蒂丝",
                  "text": "还请注意节奏，不必战斗得太过劳累。"
                },
                {
                  "role": "迪希雅",
                  "text": "没错，按照计划，在一定时间内打败适量的对手就行，留点敌人给接受考核的学员！"
                }
              ]
            },
            {
              "text": "不急不急，先聊聊天。",
              "dialogues": [
                {
                  "role": "迪希雅",
                  "text": "哈哈，好啊！我们确实有些日子没见了。"
                },
                {
                  "role": "迪希雅",
                  "text": "要是提前知道了你会来，我肯定和坎蒂丝准备几道硬菜，先给你来一场新风味的接风宴！"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "新风味？",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "迪希雅",
                  "text": "说来也挺神奇的，上次我去了枫丹长了长见识，带回了几本食谱和几袋香料。{{#info:[[逸闻·迪希雅]]}}"
                },
                {
                  "role": "迪希雅",
                  "text": "我把这些东西送给了坎蒂丝，没想到，她做出了让我惊奇的料理…"
                },
                {
                  "role": "迪希雅",
                  "text": "比如「海露花干烤肉拌饭」，看起来和平时的阿如拌饭完全没有区别…"
                },
                {
                  "role": "迪希雅",
                  "text": "谁能想到，入口后先是一阵肉香和米饭的满足，然后，清凉的回甘就在口腔中弥漫开来，油而不腻…"
                },
                {
                  "role": "迪希雅",
                  "text": "既能狠狠补充体力，又不会口干舌燥，太适合在沙漠野营的时候吃了！"
                },
                {
                  "role": "坎蒂丝",
                  "text": "只要不到离经叛道的程度，我并不反对改良传统菜式。"
                },
                {
                  "role": "坎蒂丝",
                  "text": "毕竟，在沙漠之中，一切食材都弥足珍贵，无论如何，都应该让它们物尽其用。"
                },
                {
                  "role": "迪希雅",
                  "text": "那你倒是收下那身衣服啊？织物也是珍贵的资源嘛。"
                },
                {
                  "role": "迪希雅",
                  "text": "虽然总有人说，我不讲究穿着，不够「时尚」…但我买的时候请人帮忙参考了，应该…还算合身吧？"
                },
                {
                  "role": "迪希雅",
                  "text": "结果最后让给团里的会计小妹了，她倒是开心得跳起来。"
                },
                {
                  "role": "坎蒂丝",
                  "text": "由衷感谢你，迪希雅，你的心意我收下了。"
                },
                {
                  "role": "坎蒂丝",
                  "text": "不过，我作为阿如村的守护者，不应穿得太过显眼。华贵的衣服，也应该在合适的场合发挥作用。"
                },
                {
                  "role": "坎蒂丝",
                  "text": "我推荐你将其赠予会计小妹，也是考虑到她会代表你们「炽光猎兽」去一些商业场合谈生意。"
                },
                {
                  "role": "迪希雅",
                  "text": "喔⋯喔！早说嘛！我还以为我选的款式入不了你的法眼呢！"
                },
                {
                  "role": "坎蒂丝",
                  "text": "下次，如果还想为了「炽光猎兽」在阿如村长期借住的事表示感谢…"
                },
                {
                  "role": "坎蒂丝",
                  "text": "可以带些布匹来，我略懂剪裁，能为大家做些抵御沙尘的披风。"
                },
                {
                  "role": "坎蒂丝",
                  "text": "布料不用太贵重，坚韧耐用就行，相信你的眼光。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "看起来，坎蒂丝是实用派…",
                      "dialogues": []
                    },
                    {
                      "text": "披风确实很适合眼下的场景…",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "坎蒂丝",
                  "text": "为旅行者制作披风时，我必须好好考虑披风的形制，还有得体的花纹。"
                },
                {
                  "role": "坎蒂丝",
                  "text": "这样才能彰显阿如村尊贵客人的身份。"
                },
                {
                  "type": "choice",
                  "role": "旅行者",
                  "options": [
                    {
                      "text": "原来也有我一份！",
                      "dialogues": []
                    },
                    {
                      "text": "谢谢！不用太复杂哦！",
                      "dialogues": []
                    }
                  ]
                },
                {
                  "role": "迪希雅",
                  "text": "啊呀呀，你这么一说，我都有些期待了…"
                },
                {
                  "role": "迪希雅",
                  "text": "要不然，下次出游的目的地，就定在璃月吧？听说那里的布料非常不错，物美价廉…"
                },
                {
                  "role": "迪希雅",
                  "text": "如果想买珍贵的绸缎，也有大把选择。"
                },
                {
                  "role": "迪希雅",
                  "text": "不过，那边的治安非常好，我们过去就接不到活了，只能扮演乖巧礼貌的游客，就当是纯粹的旅行好了。"
                },
                {
                  "role": "迪希雅",
                  "text": "搞定这次的差事后，我就和兄弟们仔细商量一下！"
                }
              ]
            },
            {
              "text": "请稍等，我待会儿再来…",
              "dialogues": [
                {
                  "role": "迪希雅",
                  "text": "好啊，那就等你状态不错再开工！"
                },
                {
                  "role": "坎蒂丝",
                  "text": "如果感到疲倦，还请好好休息。时间相当充裕，不用争这一时。"
                }
              ]
            }
          ]
        },
        {
          "role": "迪希雅",
