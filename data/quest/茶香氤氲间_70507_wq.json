{
  "quest_id": 70507,
  "chapter_num": null,
  "chapter_title": "茶香氤氲间",
  "type": "wq",
  "route": "Surrounded by the Aroma of Tea",
  "stories": [
    {
      "story_id": 70507,
      "title": "茶香氤氲间",
      "description": "「酒馆里好像有一位很不同寻常的客人…」「能让你感兴趣的人物不多见啊。陪你凑个热闹？」「算了算了…去了也不敢搭话的。」",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与钟离对话",
          "narration": true
        },
        {
          "role": "钟离",
          "text": "许久不见，近来可好？"
        },
        {
          "role": "派蒙",
          "text": "不不不对…钟离，你怎么会在这里啊！"
        },
        {
          "role": "钟离",
          "text": "既是闲游，就不该局限于眼前。风之国土自由丰饶，是一大好去处。"
        },
        {
          "role": "钟离",
          "text": "能在这里遇见你们，实属意外之喜。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要来一杯什么吗？",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "一杯烟霞蔽芾。茶浓些更好，有劳你了。"
                }
              ]
            },
            {
              "text": "可以边喝茶边聊。",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "一杯烟霞蔽芾。茶浓些更好，有劳你了。"
                }
              ]
            }
          ]
        },
         {
          "type": "subtitle",
          "text": "为钟离调制饮品",
          "narration": true
        },
        {
          "role": "旅行者",
          "text": "请慢用。"
        },
        {
          "role": "钟离",
          "text": "茶汤透亮，色泽宜人，入口甘醇，更伴有花果香。嗯，相当难得。"
        },
        {
          "role": "派蒙",
          "text": "哇，钟离在喝茶方面也是行家呀。"
        },
        {
          "role": "派蒙",
          "text": "像我「咕嘟」一口就喝下去了，只能说出好喝两个字。"
        },
        {
          "role": "钟离",
          "text": "用心品尝，是对彻茶者的敬意。"
        },
        {
          "role": "钟离",
          "text": "好茶十分难得，能将好茶泡得怡景怡情的彻茶者，更是难得。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谬赞了…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好吧，我明白了。"
                }
              ]
            },
            {
              "text": "有些不好意思…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好吧，我明白了。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那…教教我你是怎么品茶的吧。我看是先闻再喝，对吗？"
        },
        {
          "role": "钟离",
          "text": "不错。"
        },
        {
          "role": "钟离",
          "text": "茶叶各有特征，喝得多了，自然有些心得。茶品好坏，闻香味便可略知一二了。"
        },
        {
          "role": "钟离",
          "text": "有些茶闻起来湿腻，焦香过重，应是次品。另有一些，闻起来甘醇典雅，幽香扑面，这类茶多为上品。"
        },
        {
          "role": "钟离",
          "text": "若想再讲究些，按璃月古时传统，还应备上「品香盏」。这件器皿能盛放茶汤，专用于品香。"
        },
        {
          "role": "派蒙",
          "text": "怎么办，感觉我之前都亏了…"
        },
        {
          "role": "钟离",
          "text": "无妨。学问甚多，何时开始都不算迟。"
        },
        {
          "role": "钟离",
          "text": "初学者可以试着这样品鉴：先观察水色，再轻嗅茶香，最后才是品茗。"
        },
        {
          "role": "钟离",
          "text": "「由浅入深」，对万事万物的掌握皆是如此。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "收获不小…",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "璃月西北的「翘英庄」，以茶业闻名。日后若有机会，不妨前去看看。"
                }
              ]
            },
            {
              "text": "还想学再多…",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "璃月西北的「翘英庄」，以茶业闻名。日后若有机会，不妨前去看看。"
                }
              ]
            }
          ]
        },
        {
          "role": "钟离",
          "text": "今日所说种种，大多是我这个老派璃月人的习惯。"
        },
        {
          "role": "钟离",
          "text": "各地饮茶习惯与茶文化均有不同。身处不同国度，理应尊重当地风俗。"
        },
        {
          "role": "派蒙",
          "text": "我完全理解了！但能不能记住就…"
        },
        {
          "role": "旅行者",
          "text": "意料之中…"
        },
        {
          "role": "钟离",
          "text": "旅行者，今日多谢你了。有幸喝到这等好茶，不虚此行。"
        },
        {
          "role": "钟离",
          "text": "他日你若坐镇茶馆，我定来捧场。"
        },
        {
          "role": "派蒙",
          "text": "但我们很忙，大概没有时间去茶馆打零工吧…"
        },
        {
          "role": "旅行者",
          "text": "谁知道呢。"
        },
        {
          "role": "钟离",
          "text": "总之，如有机会，我一定支持。"
        },
        {
          "role": "钟离",
          "text": "今天就到这里吧。不多叨扰了，祝你工作顺利。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "嗯，慢走。",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "嗯，开销就按习惯，记在往生堂账上吧。"
                }
              ]
            },
            {
              "text": "那个，结账的事…",
              "dialogues": [
                {
                  "role": "钟离",
                  "text": "嗯，开销就按习惯，记在往生堂账上吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "慢走慢走，代我们跟堂主问好！"
        }
      ]
    }
  ]
}