{
  "quest_id": 74695,
  "chapter_num": null,
  "chapter_title": "魔女的谕示·监守之谕",
  "type": "wq",
  "route": "Witch's Revelation: Warden's Instruction",
  "stories": [
    {
      "story_id": 74695,
      "title": "魔女的谕示·监守之谕",
      "description": "在芭比洛斯的占卜摊前，你遇见了莱欧斯利。这位梅洛彼得堡的「公爵」似乎正是芭比洛斯所做出谕示中的一员。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与莱欧斯利对话"
        },
        {
          "role": "莱欧斯利",
          "text": "你好，崔斯梅姬斯图斯女士。"
        },
        {
          "role": "芭比洛斯",
          "text": "哦？能准确说出这个名字，看来我们有共同的朋友。"
        },
        {
          "role": "莱欧斯利",
          "text": "有位哥伦比娅小姐向我推荐了这里。"
        },
        {
          "role": "芭比洛斯",
          "text": "那可是位难以预测的小姐呢，你们的相遇一定充满惊喜。"
        },
        {
          "role": "莱欧斯利",
          "text": "所言极是，我非常认同「难以预测」这个评价。"
        },
        {
          "role": "莱欧斯利",
          "text": "初次见面，我是莱欧斯利。"
        },
        {
          "role": "芭比洛斯",
          "text": "是了，驻守水下的公爵，很高兴认识你。"
        },
        {
          "role": "莱欧斯利",
          "text": "没想到伟大的魔女之一竟然听说过我，真是荣幸之至。"
        },
        {
          "role": "莱欧斯利",
          "text": "还是说，作为占星术士的崔斯梅姬斯图斯女士已经预见了我的到来？"
        },
        {
          "role": "芭比洛斯",
          "text": "呵呵…既然我们都知晓彼此的身份，那就省去这些繁文缛节吧，称呼我为芭比洛斯即可。"
        },
        {
          "role": "莱欧斯利",
          "text": "那也请直接叫我莱欧斯利吧，现在并非公务时间，我也只是一个闲散的枫丹市民罢了。"
        },
        {
          "role": "莱欧斯利",
          "text": "刚刚路上正好碰到新鲜出炉的晶螺糕，听说魔女们都喜欢围着茶桌闲聊，如不嫌弃的话，请收下一份吧。"
        },
        {
          "role": "芭比洛斯",
          "text": "哎呀，这的确是茶会上非常受欢迎的甜点。"
        },
        {
          "role": "芭比洛斯",
          "text": "在这里停留许久，我给不少人送出了属于他们的预言，倒是第一次先收到了礼物呢。"
        },
        {
          "role": "芭比洛斯",
          "text": "谢谢你，莱欧斯利先生，我会和艾莉丝她们分享的。"
        },
        {
          "role": "芭比洛斯？",
          "text": "…我听到了哦，芭比，必须给我留！"
        },
        {
          "role": "艾莉丝",
          "text": "不能像之前那样因为我来晚了就让尼可一声不吭地把所有——"
        },
        {
          "role": "芭比洛斯",
          "text": "咳咳！知道了知道了，这次一定。"
        },
        {
          "role": "芭比洛斯",
          "text": "真是的，你怎么来得这么巧，我还想在新朋友面前维持住魔女会的体面呢。"
        },
        {
          "role": "莱欧斯利",
          "text": "没关系，有什么不好，没有规定说能力强大的人不能拥有活泼的性格。"
        },
        {
          "role": "艾莉丝",
          "text": "正是如此！乐观开朗可是我们魔女会的入会门槛之一。"
        },
        {
          "role": "芭比洛斯",
          "text": "第一次听说有这种门槛！"
        },
        {
          "role": "艾莉丝",
          "text": "我刚刚想的！魔女会可是给世界带来快乐的组织，我们自己当然要先乐观开朗起来啦！"
        },
        {
          "role": "莱欧斯利",
          "text": "仅代表个人，我支持诸位随心所欲地享受生活——当然，要在不违法乱纪的前提下。"
        },
        {
          "role": "芭比洛斯",
          "text": "你这个前提在艾莉丝面前不堪一击。"
        },
        {
          "role": "莱欧斯利",
          "text": "哎呀，那可真是令人担忧。"
        },
        {
          "role": "艾莉丝",
          "text": "嘿，我还在这呢！"
        },
        {
          "role": "艾莉丝",
          "text": "放心放心，我还不至于非要在梅洛彼得堡的管理人面前胡闹。"
        },
        {
          "role": "艾莉丝",
          "text": "而且…就算退一步讲，你那里应该比西风骑士团的禁闭室要更宽敞一些吧？"
        },
        {
          "role": "莱欧斯利",
          "text": "哈哈，难道一间禁闭室就能关住传说中的魔女吗？"
        },
        {
          "role": "莱欧斯利",
          "text": "艾莉丝女士甘愿受罚，肯定是因为她为人谦和且守信啊。"
        },
        {
          "role": "艾莉丝",
          "text": "这话说得——真是太对了。"
        },
        {
          "role": "芭比洛斯",
          "text": "停，停，莱欧斯利先生，请不要再助长她的气焰了。"
        },
        {
          "role": "芭比洛斯",
          "text": "一个心情愉悦的艾莉丝，可不一定会做出什么事来。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "深有体会。",
              "dialogues": []
            },
            {
              "text": "还请对禁闭室保持敬畏之心。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦，说起来旅行者可是骑士团的荣誉骑士，那么肯定是要维护禁闭室的尊严才对！"
        },
        {
          "role": "莱欧斯利",
          "text": "由荣誉骑士来阻拦逃跑的魔女吗？听起来像是很不错的话剧，请务必叫我围观。"
        },
        {
          "role": "派蒙",
          "text": "你也真是看热闹不嫌事大啊！"
        },
        {
          "role": "派蒙",
          "text": "不过没想到公爵已经提前过来了，省去了我们往水下跑一趟呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这就是占卜的力量吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "芭比洛斯",
          "text": "啊，说到这个，也该做些正事了。"
        },
        {
          "role": "芭比洛斯",
          "text": "莱欧斯利先生，无论是看在哥伦比娅小姐的面上，还是作为茶会糕点的回礼，都请你抽取一张「月谕圣牌」吧。"
        },
        {
          "role": "芭比洛斯",
          "text": "或许命运的馈赠就暗藏其中。"
        },
        {
          "role": "莱欧斯利",
          "text": "这算是一种预言吗？"
        },
        {
          "role": "芭比洛斯",
          "text": "可以这么说。"
        },
        {
          "role": "莱欧斯利",
          "text": "那没有枫丹人会不认真对待的。"
        },
        {
          "type": "subtitle",
          "text": "说是要「认真对待」，莱欧斯利直接拿起了最上面的一张牌…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "莱欧斯利",
          "text": "我对这种牌不甚了解，这似乎是…"
        },
        {
          "role": "芭比洛斯",
          "text": "是正位的「皇帝」呢…"
        },
        {
          "role": "莱欧斯利",
          "text": "您这样欲言又止，难道是坏消息？请不必介意，直言相告就好。"
        },
        {
          "role": "芭比洛斯",
          "text": "不，恰恰相反，这张牌意味着永恒的统辖与难以撼动的权威。"
        },
        {
          "role": "芭比洛斯",
          "text": "如果这代表未来的路，那其实你早已抵达了目的地。"
        },
        {
          "role": "芭比洛斯",
          "text": "不过…呵呵呵，你的「命运」显然还会滚滚向前，变化不止，那么就意味着…"
        },
        {
          "role": "莱欧斯利",
          "text": "或许变化的不是人，而是环境？"
        },
        {
          "role": "芭比洛斯",
          "text": "嗯…就目前而言，是有这种倾向。"
        },
        {
          "role": "莱欧斯利",
          "text": "那看来我可以对自己的直觉更加自信一些了。"
        },
        {
          "role": "莱欧斯利",
          "text": "之前我曾因公务拜访挪德卡莱，长了不少见识，此后也不免关注了一些当地的新闻。{{#info:[[「秘闻馆」委托留言板]]}}"
        },
        {
          "role": "莱欧斯利",
          "text": "而有那么一个晚上，我看着格外明亮的月亮，不由得想，这个世界正在产生变化，对吗？"
        },
        {
          "role": "芭比洛斯",
          "text": "正确的回答是，世间万物每时每刻都在变化，而在巨大变量的介入后，我们都要做好迎接未知的准备。"
        },
        {
          "role": "芭比洛斯",
          "text": "不过从这张牌的结果来看，你似乎不用太过担心。无论环境如何改变，你都将拥有适应它或与之对抗的能力。"
        },
        {
          "role": "莱欧斯利",
          "text": "那可真是皆大欢喜。看来那一拳没有白挨？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是带着美好祝愿的一拳。",
              "dialogues": []
            },
            {
              "text": "大难不死，必有后福。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱欧斯利",
          "text": "不过出于好奇，我有个相当冒昧的问题想要请教，不知能否直说…"
        },
        {
          "role": "芭比洛斯",
          "text": "真是狡猾，莱欧斯利先生这样说就是在故意引起我们的好奇心嘛！这下就算你不说，我也偏要问了。"
        },
        {
          "role": "莱欧斯利",
          "text": "那就恕我直言了。"
        },
        {
          "role": "莱欧斯利",
          "text": "我一直很想知道，一个真正的预言究竟要如何保证它的实现？"
        },
        {
          "role": "莱欧斯利",
          "text": "就以我为例，当下的占卜称我会长期处于一个稳定的状态。"
        },
        {
          "role": "莱欧斯利",
          "text": "但如果我在得知了这个预言后叛逆心肆起，立即去做一些出格的事情，结果又会如何呢？"
        },
        {
          "role": "莱欧斯利",
          "text": "就比如…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "比如把梅洛彼得堡炸上天？{{#info:魔神任务第四章第四幕[[谕示胎动的终焉之刻]]-[[守秘者与禁区]]}}",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱欧斯利",
          "text": "行，就这个。"
        },
        {
          "role": "派蒙",
          "text": "还惦记着这回事呢？！"
        },
        {
          "role": "艾莉丝",
          "text": "欸。"
        },
        {
          "role": "芭比洛斯",
          "text": "不，你等会儿…"
        },
        {
          "role": "艾莉丝",
          "text": "哈哈！真是巧了！我这边正好有一位实力强劲的爆破专家可以介绍给你——"
        },
        {
          "role": "艾莉丝",
          "text": "而荣誉骑士会作为那位爆破专家的随行监护人，在关键时刻阻拦一切坏事的发生！"
        },
        {
          "role": "芭比洛斯",
          "text": "…你看，预言就是这样达成的。"
        },
        {
          "role": "莱欧斯利",
          "text": "看来是位破坏力很强的专家啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "而且非常可爱。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "啊，是小可莉吧！公爵可能不知道，可莉是艾莉丝的女儿哦。"
        },
        {
          "role": "艾莉丝",
          "text": "不，准确地说，应当是「诸世界的大冒险家」「很坏很坏的大魔王」「旧蒙德的守护者」…"
        },
        {
          "role": "芭比洛斯",
          "text": "太长了！"
        },
        {
          "role": "芭比洛斯",
          "text": "…总之就是大魔王艾莉丝最可爱的孩子，名副其实的「火花骑士」——可莉！"
        },
        {
          "role": "芭比洛斯",
          "text": "唉，就应该按照原定的计划，大家一起好好办一场聚会，还能介绍你们认识呢。"
        },
        {
          "role": "芭比洛斯",
          "text": "那样等可莉去枫丹玩的时候，还能有新朋友一起开茶会。"
        },
        {
          "role": "莱欧斯利",
          "text": "听上去是个不错的计划，我已经开始期待了。"
        },
        {
          "role": "莱欧斯利",
          "text": "毕竟我是不会对一壶好茶说不的。"
        },
        {
          "type": "subtitle",
          "text": "聆听莱欧斯利的故事…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "聆听故事…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "听完莱欧斯利的故事"
        },
        {
          "type": "subtitle",
          "text": "击败4只怪物"
        },
        {
          "type": "subtitle",
          "text": "解锁额外天赋「魔女的谕示·冤苦终有显明之期」",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}