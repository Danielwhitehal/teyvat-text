{
  "quest_id": 10040,
  "chapter_num": "谜境悬兵 其三",
  "chapter_title": "痴念虚错拂袖去",
  "type": "eq",
  "route": "Away With Obsessions and Falsehood",
  "stories": [
    {
      "story_id": 40022,
      "title": "痴念虚错拂袖去",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "最关键的一战即将到来，你们将回到「诀箓阴阳寮」中，会合「公子」与「式大将」，解开所有谜题…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "等待至翌日8点至12点"
        },
        {
          "type": "subtitle",
          "text": "与辛焱碰面"
        },
        {
          "role": "辛焱",
          "text": "旅行者，这段时间我从驻兵们那里打听到一个好消息！"
        },
        {
          "role": "辛焱",
          "text": "听说九条裟罗被城中事务困住了，她的部下暂时没有动静。"
        },
        {
          "role": "辛焱",
          "text": "说到底，这个秘境已经很久没有放出魔物了，他们小心地把守着重要关口，没必要急着向秘境内进军。"
        },
        {
          "role": "辛焱",
          "text": "给我们争取了不少时间呢。"
        },
        {
          "role": "派蒙",
          "text": "那我们赶快进去吧，那两个家伙一定等得不耐烦了！"
        },
        {
          "type": "subtitle",
          "text": "进入「仇忌森动之寮」"
        },
        {
          "type": "subtitle",
          "text": "与「式大将」对话"
        },
        {
          "role": "「式大将」",
          "text": "三位，你们回来了！"
        },
        {
          "role": "公子",
          "text": "人到齐，就该去找最后的答案了。"
        },
        {
          "role": "辛焱",
          "text": "你们好像恶战了一场啊。"
        },
        {
          "role": "公子",
          "text": "一场？哼…已经不知多少场了。"
        },
        {
          "role": "公子",
          "text": "我打得还不错吧，「式大将」！"
        },
        {
          "role": "「式大将」",
          "text": "达达利亚先生对这类秘境很是熟悉，无论多强的魔物，他都能完美应对。"
        },
        {
          "role": "「式大将」",
          "text": "我认为，我们有望突入秘境最深处。"
        },
        {
          "role": "派蒙",
          "text": "哦？一起待了几天，关系亲近了不少嘛。"
        },
        {
          "role": "公子",
          "text": "哈哈，已经是战友了哦。"
        },
        {
          "role": "公子",
          "text": "重组期间，我听「式大将」说，它感到最关键的「拓本」出现了，就在那边。"
        },
        {
          "role": "「式大将」",
          "text": "那枚「拓本」中蕴含的符法之力远超其他拓本。只要回收顺利，我应该就能回想起这座秘境的真相了。"
        },
        {
          "role": "派蒙",
          "text": "不是就在那里吗？你们怎么不过去？"
        },
        {
          "role": "辛焱",
          "text": "「式大将」…你是在等我们吗？"
        },
        {
          "role": "「式大将」",
          "text": "多亏各位陪伴，我才能走到这里。"
        },
        {
          "role": "「式大将」",
          "text": "我的记忆是靠着你们一点点找回的，至于这最后也最重要的时刻…我想请大家一起为我见证。"
        },
        {
          "type": "subtitle",
          "text": "进入「仇忌森动之寮」"
        },
        {
          "type": "subtitle",
          "text": "回收「式大将」的「拓本」"
        },
        {
          "type": "subtitle",
          "text": "与「式大将」对话"
        },
        {
          "role": "「式大将」",
          "text": "一直以来零散破碎的记忆，总算汇聚成型了。"
        },
        {
          "role": "「式大将」",
          "text": "我全都想起来了…这座「诀箓阴阳寮」的过去…它的本质。"
        },
        {
          "role": "「式大将」",
          "text": "它不是用来试验「阴阳术」的场所，也不是滋生邪祟之物的巢穴。晴之介创造我和这座秘境的目的…是为了「守护」。"
        },
        {
          "role": "派蒙",
          "text": "「守护」？"
        },
        {
          "role": "「式大将」",
          "text": "我们的国度曾遭到某种灾害的侵袭。那次变故夺去了晴之介最珍视的人…"
        },
        {
          "role": "「式大将」",
          "text": "晴之介十分悔恨，因此，他开始渴求能够抵御邪祟的力量。"
        },
        {
          "role": "「式大将」",
          "text": "他渡海前往璃月，寻访仙人，修习仙法，将这种奥妙之术与自身研习多年的「神通」相结合，缔造出了最早的「阴阳术」。"
        },
        {
          "role": "「式大将」",
          "text": "随后，他召集有志报国的武士，又创造出我和这座阴阳寮，以我为原型制作众多「拓本」，将它们分发给武士。"
        },
        {
          "role": "「式大将」",
          "text": "武士和「式神」组成搭档，用符法配合武艺，更为稳妥地对抗魔物。"
        },
        {
          "role": "「式大将」",
          "text": "他们两两成组，外出与魔物战斗。战败魔物的信息会被「式神」拓写下来。"
        },
        {
          "role": "「式大将」",
          "text": "返回秘境后，这些信息借由「镜返魔物」的姿态重现于世，充当武士训练的对手。"
        },
        {
          "role": "「式大将」",
          "text": "我作为「式神」的统筹者，会不断吸收「拓本」们的见闻与经验，调整秘境的架构，为武士们提供更有效的训练。"
        },
        {
          "role": "「式大将」",
          "text": "长此以往，这些志向高远的武士都能锻炼出傲人武艺。等他们离开，下一批新人又会到来。新的见闻、新的对手…循环不息。"
        },
        {
          "role": "旅行者",
          "text": "演武的秘境？"
        },
        {
          "role": "公子",
          "text": "难怪能无止境地战斗下去…这里本就是一座训练场。"
        },
        {
          "role": "派蒙",
          "text": "也就是说，惟神晴之介建立这座阴阳寮是为了训练武士，让他们更好地对抗魔物？"
        },
        {
          "role": "派蒙",
          "text": "那他不就是个彻彻底底的大好人吗？"
        },
        {
          "role": "辛焱",
          "text": "如果是这样的话，他为什么要躲在秘境深处呢？"
        },
        {
          "role": "「式大将」",
          "text": "不，晴之介早已不在寮内。"
        },
        {
          "role": "「式大将」",
          "text": "不知为何，晴之介遣散了所有武士，废弃了整座秘境。"
        },
        {
          "role": "「式大将」",
          "text": "这段记忆，这最后的碎片，还没能补全…我甚至想不起晴之介离去前对我说过什么。"
        },
        {
          "role": "辛焱",
          "text": "离开的意思是…他还活着？"
        },
        {
          "role": "「式大将」",
          "text": "也许吧。至少…我希望是这样。"
        },
        {
          "role": "「式大将」",
          "text": "我是被晴之介创造出来的一种「兵器」。我与阴阳寮的使命，是不断创造战斗，锤炼自己也锤炼他人。"
        },
        {
          "role": "「式大将」",
          "text": "可如今这座秘境已经没用了。除了你们，没有人会来这里…被主人抛弃的兵器，还有什么价值可言呢…"
        },
        {
          "role": "派蒙",
          "text": "他好难过的样子…"
        },
        {
          "role": "公子",
          "text": "被主人抛弃的兵器…哈哈。"
        },
        {
          "role": "公子",
          "text": "做一把兵器也没啥不好的吧？每个在战斗中沉沦的人，都渴求着自身的意义与价值。"
        },
        {
          "role": "「式大将」",
          "text": "是这样吗…"
        },
        {
          "role": "公子",
          "text": "你不是对我的秘密很好奇吗？为什么我能坚持抵抗秘境的排斥，为什么我能从容面对复杂无比的战局。"
        },
        {
          "role": "公子",
          "text": "我不过是在「树根」的缝隙中战斗过而已。无止境的险境、夺命的危险…只有得到这些养分，我才能更快地变强。"
        },
        {
          "role": "公子",
          "text": "我要的不是胜利，而是打磨。我想要的，就只是让自己变得锋利，变得让人畏惧。我和你一样，也是「兵器」啊。"
        },
        {
          "role": "「式大将」",
          "text": "若是如此…你所追逐的战斗，它的终点在哪里？"
        },
        {
          "role": "公子",
          "text": "渴望结束的人才会寻找终点。我不一样，我根本不在乎这些虚无缥缈的事。"
        },
        {
          "role": "公子",
          "text": "我是为战斗而生的，只要我还活着，终点就不会出现…我选择的路，每一步都是极限。"
        },
        {
          "role": "公子",
          "text": "舍弃困惑吧。带着忧愁和犹豫，可没法成为无情的兵器啊。"
        },
        {
          "role": "「式大将」",
          "text": "我要怎么做才能舍弃？"
        },
        {
          "role": "辛焱",
          "text": "我倒觉得，舍弃只是一种形容，不是真的要你丢弃什么。"
        },
        {
          "role": "辛焱",
          "text": "「式大将」，你不需要丢弃任何东西。"
        },
        {
          "role": "辛焱",
          "text": "你才刚找回记忆，现在正是捡起过去的大好机会，只要找回那件对你来说正确又重要的事就行。"
        },
        {
          "role": "「式大将」",
          "text": "正确又重要…的事？"
        },
        {
          "role": "辛焱",
          "text": "我有哦。我喜欢摇滚乐。"
        },
        {
          "role": "辛焱",
          "text": "很少有人喜欢摇滚乐对吧？确实是冷门了些，但没关系，我高兴就好！"
        },
        {
          "role": "辛焱",
          "text": "别人喜不喜欢，与我何干？我只做自己想做的事！"
        },
        {
          "role": "「式大将」",
          "text": "曲子…我记得你弹给我的那个「测试」。"
        },
        {
          "role": "辛焱",
          "text": "你说你孤独地走在路上，偶尔与人在篝火旁相遇，大伙儿还会一起吃些烤鱼什么的。"
        },
        {
          "role": "辛焱",
          "text": "能理解这一点，说明你已经很了解人的情感了。"
        },
        {
          "role": "辛焱",
          "text": "我们每个人或多或少都走过这条孤独的路，你也在那里，自然是我们的同伴。所以我们会在篝火旁相遇，然后，成为朋友。"
        },
        {
          "role": "辛焱",
          "text": "路很难走，但我们并不孤单。「式大将」，这是我音乐中的语言，是我坚持正确之事的收获。你呢？"
        },
        {
          "role": "辛焱",
          "text": "一定也有必须去做的事吧？"
        },
        {
          "role": "「式大将」",
          "text": "辛焱小姐…也许我现在还拿不出你那样的豁达。但我知道，我不能停留在此。"
        },
        {
          "role": "「式大将」",
          "text": "前进吧，各位！我想…不，我要找回最后的「拓本」，重新掌控这座秘境。"
        },
        {
          "role": "「式大将」",
          "text": "一定…一定还存在着只有我能做到的事。"
        },
        {
          "role": "派蒙",
          "text": "没错，振作起来，我们还要战斗呢！"
        },
        {
          "role": "派蒙",
          "text": "大家一起前进，就没问题啦！"
        },
        {
          "type": "subtitle",
          "text": "进入「仇忌森动之寮」"
        },
        {
          "type": "subtitle",
          "text": "前往「仇忌森动之寮」的深处"
        },
        {
          "type": "subtitle",
          "text": "进入「仇忌森动之寮」"
        },
        {
          "type": "subtitle",
          "text": "与「式大将」对话"
        },
        {
          "role": "「式大将」",
          "text": "并不是晴之介抛弃了我，而是我开导了他，让他放下背负了太久的重担。"
        },
        {
          "role": "「式大将」",
          "text": "对于我和「诀箓阴阳寮」，晴之介有着美好的祝愿。非要说的话，可能是我们都有些生不逢时吧。"
        },
        {
          "role": "「式大将」",
          "text": "武士们竭尽全力锻炼，这种锻炼也被证明是小有成效的，然而，凡人的力量终究有着极限，我们所创造的进步…太慢了。"
        },
        {
          "role": "「式大将」",
          "text": "就在我们苦修时，那位掌握着「无想的一刀」的神明，带领着其他勤奋又强大的战士，拔除了埋藏在这片土地上的隐患。"
        },
        {
          "role": "「式大将」",
          "text": "毕生的心血突然成了不被需要之物…想必，任何人都无法轻易接受这种结果。"
        },
        {
          "role": "旅行者",
          "text": "神明的力量有时很残忍。"
        },
        {
          "role": "派蒙",
          "text": "根本没法想象那种事，但好像又听说过相似的例子…"
        },
        {
          "role": "「式大将」",
          "text": "我迷茫过，消沉过，怀疑一切。"
        },
        {
          "role": "「式大将」",
          "text": "可我们创造的结果，我们付出的代价，即使再怎么渺小，也是真实存在过的事物。"
        },
        {
          "role": "「式大将」",
          "text": "不管怎么说，晴之介和武士们渴望的「目标」已经达成了，武士们不用再埋头苦练了…"
        },
        {
          "role": "「式大将」",
          "text": "这本该是一件值得庆贺的事。晴之介是因为太有感情，太过在乎世间的一切，才会拘泥于自己失去的东西。"
        },
        {
          "role": "「式大将」",
          "text": "「守护」是我们共同的心愿。晴之介想要「守护」大家…那么，我就「守护」晴之介吧。"
        },
        {
          "role": "「式大将」",
          "text": "作为晴之介最得意的造物，也是他在这「诀箓阴阳寮」中唯一的挚友，我劝导了他。"
        },
        {
          "role": "「式大将」",
          "text": "他告诉我，他要去寻找新的「意义」，也许需要一个月，一年，或是几百年。无论多久，我都期盼着有朝一日他能完成心愿回到这里。"
        },
        {
          "role": "「式大将」",
          "text": "日复一日的等待中，我陷入了沉睡…"
        },
        {
          "role": "「式大将」",
          "text": "晴之介啊…你应该是不会回来了吧。"
        },
        {
          "role": "辛焱",
          "text": "别太难过，「式大将」…"
        },
        {
          "role": "派蒙",
          "text": "惟神晴之介学到了那么强大的仙法，又会「神通」，也许他能长生不老吧？"
        },
        {
          "role": "「式大将」",
          "text": "各位，我想明白了一件事。无论晴之介是否还在世上，我都不该只为他而活了。"
        },
        {
          "role": "「式大将」",
          "text": "遇见你们之后，我学会了一件事，那就是相信。相信晴之介正走在他自己的路上…相信我也会拥有这样一条路。"
        },
        {
          "role": "「式大将」",
          "text": "自从诞生于世，我们便开始向着孤独的尽头行走，但迷雾之中会有火光，夜空之下会有新的伙伴…"
        },
        {
          "role": "「式大将」",
          "text": "我们的使命，从不因远行而告终。"
        },
        {
          "role": "「式大将」",
          "text": "晴之介所做的一切都有价值。而我的「意义」，正是我的使命。这一点从未改变，更不会被剥夺。"
        },
        {
          "role": "「式大将」",
          "text": "我是辅佐武人的「式神」之首「式大将」，这座「诀箓阴阳寮」不变的「寮司」。"
        },
        {
          "role": "「式大将」",
          "text": "我的职责是辅佐武人，帮助他们锤炼极致的武艺。"
        },
        {
          "role": "「式大将」",
          "text": "世间一定还有正在攀登高山的人，我很乐意成为山间的绳索，成为他们的兵器，陪伴他们走向山顶。"
        },
        {
          "role": "辛焱",
          "text": "好极了，就是这种态度！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：你已经找到答案了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "记忆完全恢复的「式大将」…给人一种坚定又可靠的印象呢！"
                }
              ]
            },
            {
              "text": "旅行者：我也很受启发哦。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "记忆完全恢复的「式大将」…给人一种坚定又可靠的印象呢！"
                }
              ]
            }
          ]
        },
        {
          "role": "「式大将」",
          "text": "我已重新掌控「诀箓阴阳寮」，今后不会再有任何「镜返魔物」外逃。本次风波，就到此为止了。"
        },
        {
          "role": "「式大将」",
          "text": "只需几日时间，我就能理清符法之力的脉络，将「诀箓阴阳寮」恢复成原貌。"
        },
        {
          "role": "「式大将」",
          "text": "这里是变幻莫测却安全可靠的试炼之地。今后我会一直守在这里，为渴求极致武艺的人提供最为有效的试炼。"
        },
        {
          "role": "「式大将」",
          "text": "天领奉行那边应该也准备好进入秘境了吧。等他们过来，我会和他们详细说明这次事件。交涉方面，几位大可放心交给我。"
        },
        {
          "role": "派蒙",
          "text": "好好好，意思是我们都不用善后了对吧？嗯~我就喜欢这种一身轻的感觉。"
        },
        {
          "role": "「式大将」",
          "text": "多亏你们，我才能找回真正的自己…"
        },
        {
          "role": "「式大将」",
          "text": "我准备了一点薄礼。虽说无法与各位的恩情相比，应该也能派上些用场。"
        },
        {
          "role": "辛焱",
          "text": "「拓本」？"
        },
        {
          "role": "「式大将」",
          "text": "你们可以称呼他为「式小将」。"
        },
        {
          "role": "「式大将」",
          "text": "「式小将」与其他「拓本」不同，不管在大陆哪一处，它都能与我保持联系。"
        },
        {
          "role": "「式大将」",
          "text": "离开「诀箓阴阳寮」后，他无法再运用「式札」和符法，不过，也还是能为你们带去加护。"
        },
        {
          "role": "「式大将」",
          "text": "带着他游历各地，就相当于把我带在身边…"
        },
        {
          "role": "辛焱",
          "text": "（「式大将」的口吻有些悲伤…是担心我们不会再见面吗？）"
        },
        {
          "role": "辛焱",
          "text": "喂！别说丧气话，我们不是还在嘛。"
        },
        {
          "role": "辛焱",
          "text": "而且托旅行者、九条裟罗和北斗姐的福，我来稻妻也不是那么困难。说不定隔三差五就到这里来看你了。"
        },
        {
          "role": "「式大将」",
          "text": "辛焱小姐…这样不会太耽搁你的时间吗？"
        },
        {
          "role": "辛焱",
          "text": "我问你，摇滚怎么样？"
        },
        {
          "role": "「式大将」",
          "text": "摇滚…对我来说，是非常好的音乐。"
        },
        {
          "role": "辛焱",
          "text": "那就够了。我从来只为懂得欣赏的人演奏音乐。"
        },
        {
          "role": "辛焱",
          "text": "大家，准备好耳朵，我要露一手！"
        },
        {
          "role": "派蒙",
          "text": "哦？！居然要弹曲子吗？！"
        },
        {
          "role": "派蒙",
          "text": "原来这首曲子还有这么振奋人心的部分啊…"
        },
        {
          "role": "派蒙",
          "text": "达达利亚不是会跳舞吗？让他跟着…哎？达达利亚人呢？"
        },
        {
          "role": "派蒙",
          "text": "喂——！达达利亚！你要去哪儿啊，不会是想偷偷溜走吧！"
        },
        {
          "role": "公子",
          "text": "溜走？我只是找个地方休息一下，想想问题而已。"
        },
        {
          "role": "公子",
          "text": "旅行者，是时候告诉你我在调查的事了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：……",
              "dialogues": [
                {
                  "role": "公子",
                  "text": "还是那么敏锐啊。有时候真怀疑你的眼睛能看透人心。"
                }
              ]
            },
            {
              "text": "旅行者：和我之前的经历有关吗？",
              "dialogues": [
                {
                  "role": "公子",
                  "text": "还是那么敏锐啊。有时候真怀疑你的眼睛能看透人心。"
                }
              ]
            }
          ]
        },
        {
          "role": "公子",
          "text": "这次我玩得很开心，说真的，我挺喜欢稻妻的呢。只要不去想那些小小的麻烦…和它们带来的后患就行。"
        },
        {
          "role": "公子",
          "text": "本以为这座秘境与「散兵」有瓜葛，我才会来这里。没想到，他根本不在里面。"
        },
        {
          "role": "公子",
          "text": "带着「神之心」的「散兵」与我们失去了联络…这背后恐怕还有故事。"
        },
        {
          "role": "公子",
          "text": "就让那颗「心」再逃一会儿吧。你迟早会知道它去了哪里。届时，你会怎么选择呢？旅行者，你的终点又是哪里？"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "公子",
          "text": "真想再多停留一会儿啊。驻足越久，下一次见面时喜悦就越大。"
        },
        {
          "role": "公子",
          "text": "就像晚星一般…你总是令人倍感惊喜，我的伙伴。"
        },
        {
          "type": "subtitle",
          "text": "离开「仇忌森动之寮」"
        },
        {
          "role": "「式大将」",
          "text": "此刻心境不同，音乐带来的体悟也有所不同了。"
        },
        {
          "role": "「式大将」",
          "text": "辛焱，谢谢你让我领略到音乐的深邃与宽广。这份情谊，我会牢牢铭记。"
        },
        {
          "role": "辛焱",
          "text": "小意思。下次见面时，我会给你带来更棒的摇滚乐！"
        }
      ]
    }
  ]
}