  "chapter_title": "曲生酌微梦·后记",
  "type": "wq",
  "route": "Of Drink A-Dreaming: Afterword",
  "stories": [
    {
      "story_id": 70510,
      "title": "曲生酌微梦·后记",
      "description": "「酒保体验周」接近尾声，是时候和卢卡道别了…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与卢卡对话"
        },
        {
          "role": "卢卡",
          "text": "哎呀呀…这几天，酒馆里的人可以说是络绎不绝啊。"
        },
        {
          "role": "卢卡",
          "text": "有冲着酒来的，更多的还是冲着你来的。"
        },
        {
          "role": "派蒙",
          "text": "这话…听着怎么那么奇怪。"
        },
        {
          "role": "卢卡",
          "text": "我还没见过那么成功的「酒保体验周」活动，这下生意和口碑都有了。"
        },
        {
          "role": "卢卡",
          "text": "总之…干得漂亮，伙计。"
        },
        {
          "role": "派蒙",
          "text": "才几天，怎么就变成伙计了啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "某种意义上…",
              "dialogues": []
            },
            {
              "text": "他也没说错…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卢卡",
          "text": "我说，要不要留下来接着干？"
        },
        {
          "role": "派蒙",
          "text": "这可不行。虽然无限畅饮的诱惑力很大，但我可是答应过，要陪她一直旅行下去的。"
        },
        {
          "role": "卢卡",
          "text": "好吧，那就不勉强啦，毕竟查尔斯也跟我说过这一点…"
        },
        {
          "role": "卢卡",
          "text": "总之，有机会的话，常来「天使的馈赠」坐坐，带上朋友一起！"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "卢卡",
          "text": "再见啦，祝你们一路顺利。"
        }
      ]
    }
  ]
}