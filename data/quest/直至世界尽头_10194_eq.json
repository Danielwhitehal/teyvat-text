        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那是…水？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "role": "？？？",
          "text": "……！——！"
        },
        {
          "role": "？？？",
          "text": "……"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…这是，星轨王城上空？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "王城的居民",
          "text": "是…是邪龙！是那只摧毁了积木矿窟的邪龙！"
        },
        {
          "role": "王城的居民",
          "text": "救命——！救命啊——！"
        },
        {
          "role": "「王城的卫兵」",
          "text": "士兵们！拿起武器！消灭他——！"
        },
        {
          "role": "？？？",
          "text": "……！"
        },
        {
          "type": "subtitle",
          "text": "深入邪龙的巢穴"
        },
        {
          "role": "娜维娅",
          "text": "……"
        },
        {
          "role": "妮露",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "…嘁，还要我救你们几次才行？"
        },
        {
          "role": "妮露",
          "text": "谢谢你，阿帽…"
        },
        {
          "role": "派蒙",
          "text": "唔…脑袋晕乎乎的…我说，你们有没有看到什么奇怪的东西？就像…就像…呃…"
        },
        {
          "role": "流浪者",
          "text": "「邪龙」的回忆？"
        },
        {
          "role": "娜维娅",
          "text": "嗯，这么说大家都看到了。"
        },
        {
          "role": "派蒙",
          "text": "这头龙，好像和我们的印象不太一样啊，看的时候，不知道为什么心里还有些难过…"
        },
        {
          "role": "娜维娅",
          "text": "这个世界发生的事，似乎没有那么简单。"
        },
        {
          "role": "妮露",
          "text": "下次遇见他的时候，试试看能不能自然地和他交流吧？"
        },
        {
          "role": "派蒙",
          "text": "嗯，我也这么想…不过话说回来，我们这是掉到了什么地方呀…"
        },
        {
          "role": "娜维娅",
          "text": "如果说上面是一个童话世界的话，我们简直就像掉到了书的下一页呢…"
        },
        {
          "role": "流浪者",
          "text": "继续走就行了。别掉队。"
        },
        {
          "role": "派蒙",
          "text": "欸！你等等我们呀！"
        },
        {
          "role": "派蒙",
          "text": "哇——这里的景色，和上面龙的巢穴很不一样呢。"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "是预言中的勇者！我们有救了！"
        },
        {
          "role": "黄色积木小人（气泡文字）",
          "text": "遇到困难就试试这个！"
        },
        {
          "role": "红色积木小人（气泡文字）",
          "text": "那天，巨龙将我们带到了这里…"
        },
        {
          "role": "巨人卫兵（气泡文字）",
          "text": "喝下力量药水…保护大家…"
        },
        {
          "role": "黄色积木小人（气泡文字）",
          "text": "你受伤了吗？"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "来这里治疗一下吧！"
        },
        {
          "role": "两位红色积木小人（气泡文字）",
          "text": "快跑啊！"
        },
        {
          "role": "两位红色积木小人（气泡文字）",
          "text": "邪龙来了！快回家！"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "（你们不该出现在这里——！）"
        },
        {
          "role": "妮露",
          "text": "他好像很生气。"
        },
        {
          "role": "娜维娅",
          "text": "我们想和你好好谈谈——！"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "（别再靠近我了——！）"
        },
        {
          "role": "紧闭的门",
          "text": "龙…那头龙又来了！"
        },
        {
          "role": "紧闭的门",
          "text": "别敲了，家里没人！"
        },
        {
          "role": "紧闭的门",
          "text": "呜呜…什么时候才能回到星轨王城…"
        },
        {
          "role": "红色积木小人（气泡文字）",
          "text": "来这里吧！"
        },
        {
          "role": "蓝色积木小人（气泡文字）",
          "text": "来这里治疗一下吧！"
        },
        {
          "role": "黄色积木小人（气泡文字）",
          "text": "邪龙就在前面，小心啊！"
        },
        {
          "role": "雾中的影子",
          "text": "我们的家园…被那头邪龙给…"
        },
        {
          "role": "雾中的影子",
          "text": "星星！王城的星星被夺走了！"
        },
        {
          "role": "雾中的影子",
          "text": "不…我想回家…"
        },
        {
          "role": "雾中的影子",
          "text": "我们…我们没被龙吃掉？"
        },
        {
          "role": "雾中的影子",
          "text": "那头邪龙…把我们放到了这里…？"
        },
        {
          "role": "妮露",
          "text": "…阿帽！"
        },
        {
          "role": "派蒙",
          "text": "你一个人冲太前啦！"
        },
        {
          "role": "流浪者",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "他就在前面。"
        },
        {
          "role": "妮露",
          "text": "是在等着我们吗？"
        },
        {
          "role": "娜维娅",
          "text": "不如说，是被我们逼到这里来的吧…"
        },
        {
          "role": "派蒙",
          "text": "但是…我们只是想和他好好说两句，问问清楚到底发生了什么…"
        },
        {
          "role": "流浪者",
          "text": "这么长时间过去，来这的人都是为了讨伐他。他的反应也是自然。"
        },
        {
          "role": "妮露",
          "text": "就没有什么办法让他冷静下来吗？"
        },
        {
          "role": "流浪者",
          "text": "我劝你们不要抱此希望。之前他的攻击都可以看成「警告」，但现在他已经生气了。"
        },
        {
          "role": "流浪者",
          "text": "做好决战的准备吧，有时候…就是要被揍一顿，才能清醒过来…"
        },
        {
          "role": "巨人卫兵（气泡文字）",
          "text": "这次…一定要打败邪龙！"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "噫！"
        },
        {
          "role": "巨人卫兵（气泡文字）",
          "text": "呀！"
        },
        {
          "role": "巨人卫兵（气泡文字）",
          "text": "怎么回事？身子不听使唤，力量消失了！"
        },
        {
          "role": "另一个积木卫兵（气泡文字）",
          "text": "快跑啊！"
        },
        {
          "type": "subtitle",
          "text": "受到邪龙之息的影响，似乎无法使出原本的力量…",
          "narration": true
        },
        {
          "role": "红色积木小人（气泡文字）",
          "text": "是勇者！帮帮我们吧！"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "要是能拿到炸弹的话…"
        },
        {
          "role": "红色积木小人（气泡文字）",
          "text": "请千万小心！"
        },
        {
          "role": "派蒙",
          "text": "他把我们困住了！"
        },
        {
          "role": "流浪者",
          "text": "啧…不听劝的家伙，就这么想挨打吗？"
        },
        {
          "role": "派蒙",
          "text": "呜哇！他的嘴巴张得好大呀！"
        },
        {
          "role": "流浪者",
          "text": "..非要我们塞个炸弹到他嘴里才满意吗？"
        },
        {
          "type": "subtitle",
          "text": "抓住巨龙张嘴的时机，将炸弹放到他嘴里吧！",
          "narration": true
        },
        {
          "role": "流浪者",
          "text": "小心点！"
        },
        {
          "role": "流浪者",
          "text": "掉下去了我可不管！"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "——！"
        },
        {
          "role": "派蒙",
          "text": "这是真的冷静不下来了呀！"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "邪龙！看这边！"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "冲啊！"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "唉呦！"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "援军什么时候才到…"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "我们…胜利了吗？"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "振作点！"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "…"
        },
        {
          "role": "红色积木小人（气泡文字）",
          "text": "我们准备好了！地鼠补给员也会和你并肩作战！"
        },
        {
          "role": "地鼠（气泡文字）",
          "text": "吱吱！"
        },
        {
          "role": "派蒙",
          "text": "怎么又出现了两只！"
        },
        {
          "role": "流浪者",
          "text": "他也认真起来了吗…注意躲避！"
        },
        {
          "role": "地鼠（气泡文字）",
          "text": "吱吱！"
        },
        {
          "role": "派蒙",
          "text": "看！那边有炸弹可以用！"
        },
        {
          "role": "派蒙",
          "text": "像刚才一样，把炸弹塞他嘴里吧！"
        },
        {
          "role": "流浪者",
          "text": "你在犹豫什么？"
        },
        {
          "role": "派蒙",
          "text": "他张嘴了！趁现在！"
        },
        {
          "role": "派蒙",
          "text": "有机会！"
        },
        {
          "role": "流浪者",
          "text": "…！等等！"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "……？"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "——！"
        },
        {
          "role": "流浪者",
          "text": "嘁…！"
        },
        {
          "role": "流浪者",
          "text": "这里是…他的黑雾之中吗…"
        },
        {
          "role": "流浪者",
          "text": "…嗯？前面…有东西。"
        },
        {
          "role": "女人的声音",
          "text": "…你真的要创造这孩子吗？M。我已经和你说了他的「命运」。"
        },
        {
          "role": "「M」",
          "text": "……"
        },
        {
          "role": "女人的声音",
          "text": "他将会被自己的造物主所抛弃，最终…"
        },
        {
          "role": "「M」",
          "text": "我知道，B。你和我说过了，是个遗憾的故事。但那是在现实中发生的事，不是吗？"
        },
        {
          "role": "「M」",
          "text": "正因如此，我才想让他在不同的世界，有个幸福的结局。他是个心中饱含「爱」的孩子。"
        },
        {
          "role": "「B」",
          "text": "我理解，安雅。但你若要赐予他那个名字，他在「希穆兰卡」的命运，也会或多或少成为现实的「映射」…"
        },
        {
          "role": "「M」",
          "text": "但不是绝对的，对吗？哪怕有一点可能性也好，我认为他值得拥有一段不同的人生。"
        },
        {
          "role": "「M」",
          "text": "虽然…到时候可能需要一些他人的帮助。"
        },
        {
          "role": "「B」",
          "text": "好吧，亲爱的。我也不再说什么了。"
        },
        {
          "role": "「B」",
          "text": "看在你这么执着的份上，我就告诉你一个秘密吧…"
        },
        {
          "role": "流浪者",
          "text": "哼…又是无聊的「命运」…"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "……"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "（妈妈…）"
        },
        {
          "role": "「M」",
          "text": "…抱歉啊，我的孩子。"
        },
        {
          "role": "「M」",
          "text": "我的生命不像我的朋友们，也不像这本童话书那么漫长…恐怕没法一直陪伴在你身边了。"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "……"
        },
        {
          "role": "「M」",
          "text": "没事的，没事的。我走后，会化作希穆兰卡的一颗星星守护你们。要是孤单了，抬头看看就好。"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "……"
        },
        {
          "role": "「M」",
          "text": "去见证这个世界吧，我的孩子…要和大家好好相处哦…"
        },
        {
          "role": "「M」",
          "text": "在不久的将来，你一定会交到好朋友的，这是我对你的祝福。"
        },
        {
          "role": "「M」",
          "text": "这个世界…就拜托你了…"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "到头来，你还是被「背叛」了吗…"
        },
        {
          "role": "小飞鼠",
          "text": "你好呀，大龙龙。我给你带了些吃的，你应该饿了吧？"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "……"
        },
        {
          "role": "小飞鼠",
          "text": "嘘…！小点声，可不能让其他人听到了。大家都说你是坏龙龙，但你明明愿意和我一起玩，还给我摘好高好高的花。"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "……"
        },
        {
          "role": "小飞鼠",
          "text": "没事的，你在这里藏好了，我明天…"
        },
        {
          "role": "飞鼠妈妈",
          "text": "天哪！我的孩子！"
        },
        {
          "role": "飞鼠妈妈",
          "text": "来人啊！快救救我的孩子！她要被邪龙抓走了——！"
        },
        {
          "role": "小飞鼠",
          "text": "不是的！妈妈！你听我说…！"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "——！"
        },
        {
          "role": "流浪者",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "你也被人们所「厌恶」吗…"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "…是吗？这就是你许下的「愿望」？"
        },
        {
          "role": "流浪者",
          "text": "…「希望自己从未存在过」，可不是什么好愿望。"
        },
        {
          "type": "subtitle",
          "text": "过场动画"
        },
        {
          "role": "流浪者",
          "text": "任何人都不能定义你是谁……"
        },
        {
          "role": "流浪者",
          "text": "任何人都不能否定你的心……"
        },
        {
          "role": "流浪者",
          "text": "回想起你自己的名字吧——"
        },
        {
          "role": "流浪者",
          "text": "——杜林"
        },
        {
          "role": "流浪者",
          "text": "没事了……"
        },
        {
          "role": "娜维娅",
          "text": "小心！"
        },
        {
          "role": "娜维娅",
          "text": "刚才好险！你们没磕哪碰哪吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…多亏绮良良。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "绮良良",
          "text": "我听王城的人说你们去讨伐巨龙了，就一路跟了过来。结果好不容易追上的时候，却看见旅行者摔了下去。"
        },
        {
          "role": "绮良良",
          "text": "欸对了，刚才好像还有一个人掉到了下面，不要紧吗？"
        },
        {
          "role": "派蒙",
          "text": "阿帽他会飞…应该不要紧吧…"
        },
        {
          "role": "妮露",
          "text": "但他刚刚好像叫那头龙…"
        },
        {
          "role": "流浪者",
          "text": "——杜林。这是他的名字。"
        },
        {
          "role": "娜维娅",
          "text": "你没事就好，那头龙…杜林呢？"
        },
        {
          "role": "流浪者",
          "text": "他没事。"
        },
        {
          "role": "派蒙",
          "text": "杜林…难道不是蒙德雪山那头邪龙的名字吗？他被特瓦林打败后，就一直在那里了，我记得他好像是那谁…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「黄金」的莱茵多特…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对，是「黄金」莱茵多特的造物…"
        },
        {
          "role": "流浪者",
          "text": "造物…呵…"
        },
        {
          "role": "派蒙",
          "text": "所以到底发生什么了吗？你从刚才开始就不太对劲。"
        },
        {
          "role": "流浪者",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "流浪者向你们讲述了他在迷雾中看到的景象…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "妮露",
          "text": "原来这才是关于希穆兰卡「邪龙」的真相…"
        },
        {
          "role": "娜维娅",
          "text": "雾气中的那些不是幻觉，而是巨龙的回忆…"
        },
        {
          "role": "旅行者",
          "text": "（所以我在下落中听到的，其实是杜林记忆中的话语…）"
        },
        {
          "role": "绮良良",
          "text": "我还奇怪呢，虽然破碎之海这边的人回不了家，但从没听说过巨龙袭击村庄的事件发生。"
        },
        {
          "role": "妮露",
          "text": "我们一路上遇到的居民，恐怕是曾经矿窟中的人，还有前来讨伐「邪龙」的人…他迫不得已才把大家安置在这里吧…"
        },
        {
          "role": "流浪者",
          "text": "我来到这个世界的时候，脑中的声音是这么对我说的——「你是这个世界的勇者，去拯救这个世界的巨龙吧」。"
        },
        {
          "role": "派蒙",
          "text": "所以，这到底是谁的声音啦？我们又为什么会被带到这个世界呢？"
        },
        {
          "role": "流浪者",
          "text": "跟我来吧，下面有这一切的答案。"
        },
        {
          "role": "娜维娅",
          "text": "这里是…一间书房？"
        },
        {
          "role": "流浪者",
          "text": "是「命运女神」的书房。"
        },
        {
          "role": "派蒙",
          "text": "欸？是传说中创造了希穆兰卡的三个女神中的「命运女神」？"
        },
        {
          "role": "流浪者",
          "text": "准确来说，是「魔女会」中代号为「M」的魔女。"
        },
        {
          "role": "派蒙",
          "text": "「魔女会」…？！"
        },
        {
          "role": "派蒙",
          "text": "呃…我好像一直在重复…可能实在是太惊讶了…"
        },
        {
          "role": "流浪者",
          "text": "她创造了「杜林」的故事，准确来说是希穆兰卡的「杜林」。"
        },
        {
          "role": "流浪者",
          "text": "很多事情都写在这里了，包括其他两位女神的身份，你们自己翻吧。"
        },
        {
          "role": "老旧的日记",
          "text": "「…明明我名字两头也都是A，但艾莉丝说先来后到，硬是从我中间名里取了个M。哈哈，还真是受不了她。」"
        },
        {
          "role": "老旧的日记",
          "text": "「但艾莉丝的魔法总能让我感到惊讶。她居然让我随手折的一只小青蛙说话了。」"
        },
        {
          "role": "老旧的日记",
          "text": "「嗯…不如，就写一些以折纸小动物为主角的故事吧。从前，他们生活在一座魔法森林里…」"
        },
        {
          "role": "老旧的日记",
          "text": "「芭比喜欢看未来的事，虽说她借此为希穆兰卡的生灵划定了轨迹，但知晓结局的故事可不有趣…」"
        },
        {
          "role": "老旧的日记",
          "text": "「干脆和她打个赌吧，我相信总有一天，希穆兰卡的子民会选择自己的道路。」"
        },
        {
          "role": "老旧的日记",
          "text": "「…听说她要在王城建一座自己的雕像？哈哈，她还是那么爱赶时髦。」"
        },
        {
          "role": "发黄的信件",
          "text": "「亲爱的姐妹们，我有些写不动了，就连给你们写信的手都有些不听使唤…谢谢你们喜欢我的故事，为我创造了这个世界…」"
        },
        {
          "role": "发黄的信件",
          "text": "「我和你们度过了无比美好的青春，哈哈，是的，和你们在一起的时候，我觉得自己总是那么年轻…」"
        },
        {
          "role": "发黄的信件",
          "text": "「『A』说我走后，希穆兰卡的命运女神也依旧会存在，像现在这样实现着大家的愿望。嗯，这样也不错…」"
        },
        {
          "role": "发黄的信件",
          "text": "「你们想聊天的时候，就到神像下面来说说话吧。别许什么奇怪的愿望就行…」"
        },
        {
          "role": "娜维娅",
          "text": "这是…希穆兰卡的杜林？他在抬头看着什么，一颗星星…"
        },
        {
          "role": "妮露",
          "text": "看样子…这是「M」女士离开后的事呢…"
        },
        {
          "role": "妮露",
          "text": "这次是…一个矿洞？"
        },
        {
          "role": "绮良良",
          "text": "难道说，是积木矿窟的工人挖得太深，挖到了下一页的世界吗？"
        },
        {
          "role": "妮露",
          "text": "这么说来…这矿灯和上一页天上的星星好像…"
        },
        {
          "role": "妮露",
          "text": "赐福森林…这本书，一直都在记录希穆兰卡发生的事…"
        },
        {
          "role": "绮良良",
          "text": "光是落在一个地方，都会留下这么大的脚印…也难怪人们会害怕他…"
        },
        {
          "role": "娜维娅",
          "text": "…这就是你去抓星星的原因吗？你想妈妈了。"
        },
        {
          "role": "派蒙",
          "text": "咦？那是…和星轨王城不一样的神像？"
        },
        {
          "role": "流浪者",
          "text": "是「命运女神」的神像。"
        },
        {
          "role": "杜林",
          "text": "呜……"
        },
        {
          "role": "流浪者",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "…没事了，杜林。这里没有人会伤害你。"
        },
        {
          "role": "杜林",
          "text": "为什么…为什么要这么说？会伤害到你们的是我…"
        },
        {
          "role": "派蒙",
          "text": "别这么说嘛，我承认我之前错怪你了，但只要冷静下来的话，我们不还是能这样好好说话吗？"
        },
        {
          "role": "杜林",
          "text": "不…没用的，就算你们愿意和我说话…上面的世界，也一样害怕着我…"
        },
        {
          "role": "流浪者",
          "text": "所以才许下了那样的愿望吗…嘁…愚蠢…"
        },
        {
          "role": "杜林",
          "text": "唔…"
        },
        {
          "role": "派蒙",
          "text": "喂…！"
        },
        {
          "role": "流浪者",
          "text": "明明谁都看得出，你想和大家一起相处。"
        },
        {
          "role": "杜林",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "想要像朋友一样和他们聊天、玩耍…希望他们接受你，或者…至少接受你的「道歉」。"
        },
        {
          "role": "旅行者",
          "text": "（可是…希穆兰卡的子民，似乎还没准备好迎接这么一位巨大的邻居…）"
        },
        {
          "role": "娜维娅",
          "text": "你从没有伤害过，也没有想去伤害过任何人！虽然被吓到的可能不少，可那是因为不了解你才会那样。"
        },
        {
          "role": "绮良良",
          "text": "嗯，如果和大家坐下来谈谈的话，我相信他们还是会理解你的。"
        },
        {
          "role": "杜林",
          "text": "但只要这副受「诅咒」的身躯还在，我就永远无法和大家生活在一起…"
        },
        {
          "role": "杜林",
          "text": "我碰到的地方全都会变成积木…我休息过的地方连一根小草也长不出来…"
        },
        {
          "role": "旅行者",
          "text": "（就算理解了…也无法相处吗…）"
        },
        {
          "role": "妮露",
          "text": "……"
        },
        {
          "role": "妮露",
          "text": "诅咒…"
        },
        {
          "role": "派蒙",
          "text": "嗯？妮露…？"
        },
        {
          "role": "妮露",
          "text": "…和希穆兰卡的人们共同相处，是你真正的愿望吗？"
        },
        {
          "role": "杜林",
          "text": "……"
        },
        {
          "role": "杜林",
          "text": "…是的。"
        },
        {
          "role": "妮露",
          "text": "那就闭上眼睛，向命运女神许愿吧。我们会帮你实现这个愿望的。"
        },
        {
          "role": "杜林",
          "text": "欸？可是…要怎么…"
        },
        {
          "role": "妮露",
          "text": "相信我…"
        },
        {
          "role": "杜林",
          "text": "…"
        },
        {
          "role": "妮露",
          "text": "…"
        },
        {
          "role": "妮露",
          "text": "我，妮露。愿作为森林的仙子，赐予你祝福…承认你为赐福森林的一员…"
        },
        {
          "role": "旅行者",
          "text": "（…！那是…！）"
        },
        {
          "role": "妮露",
          "text": "愿大家接受你的到来，愿你在此寻得容身一隅…"
        },
        {
          "role": "娜维娅",
          "text": "我，娜维娅。愿作为星轨王城的国王，赐予你祝福！承认你为王国的一员！"
        },
        {
          "role": "绮良良",
          "text": "我也愿意作为这个世界…呃，穿靴子的猫又，给予你我的祝福！"
        },
        {
          "role": "旅行者",
          "text": "（光…在慢慢聚到一起？）"
        },
        {
          "role": "派蒙",
          "text": "…！这是怎么回事？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道是「语言」的魔法…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "流浪者",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "…我作为这个世界的勇者，赐予你祝福。承认你为希穆兰卡的一员，愿你获得这个世界的认可。"
        },
        {
          "role": "流浪者",
          "text": "同时…我愿作为你的朋友，祝你找到前进的路…"
        },
        {
          "role": "旅行者",
          "text": "（…！流浪者…）"
        },
        {
          "role": "旅行者",
          "text": "我作为游历诸多世界的旅者，赐予你祝福。愿你不论身处何处，都有同伴与善意相随。"
        },
        {
          "role": "杜林",
          "text": "……"
        },
        {
          "role": "杜林",
          "text": "妈妈…"
        },
        {
          "type": "subtitle",
          "text": "这个世界…就拜托你了…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "杜林",
          "text": "…唔。怎么了？你们为什么都这样看着我？"
        },
        {
          "role": "杜林",
          "text": "…欸！我的…我的爪子？这是我的爪子？还有翅膀和尾巴？我的身体…难道说…！"
        },
        {
          "role": "娜维娅",
          "text": "哇！很可爱嘛！和以前的感觉完全不一样呢！"
        },
        {
          "role": "娜维娅",
          "text": "呃…我倒不是说以前不好，只是…哎呀，你懂的吧？"
        },
        {
          "role": "妮露",
          "text": "感觉怎么样？还满意现在的样子吗？"
        },
        {
          "role": "杜林",
          "text": "你们…你们身上有花吗？或者这个世界的水、纸也行！"
        },
        {
          "role": "绮良良",
          "text": "哦，我这里刚好有一些，给。"
        },
        {
          "role": "杜林",
          "text": "真的…真的不会变了！我碰到的东西不会变了！"
        },
        {
          "role": "派蒙",
          "text": "那真是太好了呢，我遇到的会飞的同伴又多了一个！"
        },
        {
          "role": "妮露",
          "text": "这样一来，希穆兰卡的居民就不会再害怕你了。"
        },
        {
          "role": "杜林",
          "text": "唔…可是…我以前做的那些事…"
        },
        {
          "role": "流浪者",
          "text": "乖乖去「赎罪」吧。不论是填你的脚印，还是送破碎之海的人回家。"
        },
        {
          "role": "杜林",
          "text": "嗯…你会陪在我身边吗？阿帽。"
        },
        {
          "role": "流浪者",
          "text": "啊？为什么我要陪你做这些？"
        },
        {
          "role": "杜林",
          "text": "欸？可你刚才说…要做我的朋友…"
        },
        {
          "role": "流浪者",
          "text": "…我！啰嗦…你不喜欢就不做好了！"
        },
        {
          "role": "杜林",
          "text": "欸？我…呜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "……",
              "dialogues": []
            },
            {
              "text": "阿帽…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "流浪者",
          "text": "…嘁。好了好了，我陪就是了！"
        },
        {
          "role": "杜林",
          "text": "…真的？"
        },
        {
          "role": "流浪者",
          "text": "用不着拿这种事欺负你。"
        },
        {
          "role": "杜林",
          "text": "谢谢你！你是第一个称呼我名字的朋友。"
        },
        {
          "role": "流浪者",
          "text": "……"
        },
        {
          "role": "流浪者",
          "text": "回上面去吧，这里简直闷的慌…"
        },
        {
          "role": "派蒙",
          "text": "嘻嘻，终于有个他不擅长对付的角色了呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙…",
              "dialogues": []
            },
            {
              "text": "别幸灾乐祸…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我知道啦，但总觉得是很新鲜的事嘛。"
        },
        {
          "role": "娜维娅",
          "text": "那我们也上去吧。"
        },
        {
          "role": "杜林",
          "text": "……"
        },
        {
          "role": "妮露",
          "text": "别害怕，杜林，我们会陪在你身边的。"
        },
        {
          "role": "杜林",
          "text": "嗯，谢谢你们给予我的祝福。这是我这么久以来…最幸福的一天。"
        },
        {
          "type": "subtitle",
          "text": "返回破碎之海，与众人对话"
        },
        {
          "role": "？？？",
          "text": "铛铛——给你们一个惊喜！"
        },
        {
          "role": "派蒙",
          "text": "唔呃！路灯说话了！"
        },
        {
          "role": "？？？",
          "text": "路灯…？哎呀，我们一起聊过多少次天，怎么还是把我忘了呀？"
        },
        {
          "role": "杜林",
          "text": "这声音…是妈妈的朋友！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "艾莉丝女士…",
              "dialogues": []
            }
          ]
        },
        {
