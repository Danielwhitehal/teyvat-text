{
  "quest_id": 10194,
  "chapter_num": "欢夏！邪龙？童话国！第三页",
  "chapter_title": "直至世界尽头",
  "type": "eq",
  "route": "Until the End of the World",
  "stories": [
    {
      "story_id": 40164,
      "title": "直至世界尽头",
      "description": "「届时我将起舞，将众生脚下的轨道还予千星…」于是后世的史诗如此记述——群杰举目眺云霄，悬车衔灯琼城绕。千星复归风始动，唯余邪龙孤影遥。————书卷旁的批注：我觉得那位穿靴子说人话的猫又小姐也值得两句这样的诗。批注下的批注：我改天找补找补，但说真的，你们到底往我杯子里加了什么？批注下批注的批注：我不知道，不是我放的。批注下批注的批注：也不是我放的。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至次日上午（8~12点）"
        },
        {
          "role": "派蒙",
          "text": "终于要去讨伐邪龙了呢，你紧张吗？"
        },
        {
          "role": "派蒙",
          "text": "也不知道世界尽头是个什么样的地方，我们快去车站集合吧。"
        },
        {
          "type": "subtitle",
          "text": "前往星轨王城站台"
        },
        {
          "role": "威尔",
          "text": "车厢检查，完成…轮轴检查…完成…动力检查…"
        },
        {
          "role": "妮露",
          "text": "早上好，威尔先生。"
        },
        {
          "role": "威尔",
          "text": "早上好，各位希穆兰卡的英雄。"
        },
        {
          "role": "派蒙",
          "text": "今天的驾驶员又是威尔呢，嘿嘿，看到老面孔真是放心不少！"
        },
        {
          "role": "蒙塔纳",
          "text": "真不需要我们与您同行吗？国王陛下。"
        },
        {
          "role": "娜维娅",
          "text": "不用，讨伐恶龙这种事，还是交给我们来吧。特别是我的好搭档，听说他对付龙可有经验了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不敢当不敢当…",
              "dialogues": []
            },
            {
              "text": "也就打过两三只…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "毕塞尔特",
          "text": "不愧是国王陛下的朋友，有此等英雄相伴，我们也不再多言。"
        },
        {
          "role": "娜维娅",
          "text": "嗯，那么星轨王城就拜托你们了。"
        },
        {
          "role": "蒙塔纳",
          "text": "遵命。"
        },
        {
          "role": "毕塞尔特",
          "text": "请国王陛下放心。"
        },
        {
          "role": "娜维娅",
          "text": "好像这边也准备得差不多了，我们出发吧。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，下一站是——世界尽头！"
        },
        {
          "type": "subtitle",
          "text": "搭乘「海上列车」，前往世界尽头"
        },
        {
          "role": "娜维娅",
          "text": "哈哈！坐在玩具小车里原来是这样的感觉！"
        },
        {
          "role": "派蒙",
          "text": "你还真是到哪都玩得起来…"
        },
        {
          "role": "妮露",
          "text": "唔…前面的雾变浓了…"
        },
        {
          "role": "威尔",
          "text": "中转站到了，请各位乘客下车。"
        },
        {
          "type": "subtitle",
          "text": "抵达中转站，准备换乘"
        },
        {
          "role": "妮露",
          "text": "我们接下来要去乘坐另一辆列车了吧…咦？"
        },
        {
          "role": "派蒙",
          "text": "是丘丘人！它们把那边的站台占领了！"
        },
        {
          "role": "威尔",
          "text": "啊？这…这可怎么办？"
        },
        {
          "role": "娜维娅",
          "text": "威尔先生，这里交给我们，你找个地方躲起来。"
        },
        {
          "type": "subtitle",
          "text": "击败魔物并连接列车车厢"
        },
        {
          "type": "subtitle",
          "text": "与列车员对话，准备发车"
        },
        {
          "role": "娜维娅",
          "text": "呼，解决了！"
        },
        {
          "role": "威尔",
          "text": "辛苦各位了。我这就检查一下列车…"
        },
        {
          "role": "威尔",
          "text": "嗯，虽然车厢有些细微的剐蹭，但整体没遭到什么破坏，车头也运行正常…没问题，可以开动。"
        },
        {
          "role": "娜维娅",
          "text": "那就好，我们继续前进。"
        },
        {
          "type": "subtitle",
          "text": "继续搭乘「海上列车」，前往世界尽头"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "type": "subtitle",
          "text": "「…去见证这个世界吧，我的…」",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "「…要和大家好好相处哦。」",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "「…就拜托你了。」",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "娜维娅",
          "text": "妮露小姐你没事吧？"
        },
        {
          "role": "妮露",
          "text": "我没事，但旅行者好像晕过去了…"
        },
        {
          "role": "娜维娅",
          "text": "还好下落途中这位小哥接住了我们呢！"
        },
        {
          "role": "？？？",
          "text": "…哼，羸弱不堪。才这点小场面就晕过去了？"
        },
        {
          "role": "娜维娅",
          "text": "也别这么说嘛，旅行者这两天可是很辛苦的，要不就让他这么睡一会儿？"
        },
        {
          "role": "妮露",
          "text": "欸？可是…他现在…我…我的腿…好痒…"
        },
        {
          "role": "妮露",
          "text": "阿帽你…你刚才怎么不把他放到旁边的草地上？"
        },
        {
          "role": "流浪者",
          "text": "…哈？既要我救莫名其妙掉下来的四个人，又要我顾及摆放伤员的位置，我还从没见过这么不讲理的要求。"
        },
        {
          "role": "旅行者",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "啊，他醒了！"
        },
        {
          "role": "流浪者",
          "text": "早上好，赖床鬼。你刚才一定做了个香甜的美梦吧？看你这么高兴，我也为你感到开心。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刚才…",
              "dialogues": []
            },
            {
              "text": "发生了什么…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "流浪者",
          "text": "你们一群人突然就从瀑布上掉了下来，其中有一个还不争气地晕了过去。"
        },
        {
          "role": "流浪者",
          "text": "我先提醒你，那种摔到地上就能去其他世界的桥段，只在稻妻某些可笑的轻小说里管用。"
        },
        {
          "role": "派蒙",
          "text": "把你放下来后，你在妮露腿上昏迷了一小会，然后就醒过来了。"
        },
        {
          "role": "妮露",
          "text": "派…派蒙…！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "抱…抱歉…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "妮露",
          "text": "呃…没关系…你…你没事就好。"
        },
        {
          "role": "娜维娅",
          "text": "有撞到哪里吗？现在还觉得晕吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "现在还好…",
              "dialogues": []
            },
            {
              "text": "刚才似乎有人在我脑中说话…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "娜维娅",
          "text": "真的吗？说了些什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「去见证这个世界…」",
              "dialogues": []
            },
            {
              "text": "「和大家好好相处…」",
              "dialogues": []
            }
          ]
        },
        {
          "role": "流浪者",
          "text": "这里的雾气会让人{{颜色|蓝|产生幻觉}}，据说是那头邪龙的杰作。你该不会是因为害怕吸进太多了吧？"
        },
        {
          "role": "娜维娅",
          "text": "说起来…这位阿帽先生是你们认识的人吗？"
        },
        {
          "role": "妮露",
          "text": "哦，没错。阿帽是须弥教令院的学生，我们在学院争霸赛上认识的。他当时是因论派代表。"
        },
        {
          "role": "娜维娅",
          "text": "你好你好，我是枫丹刺玫会会长娜维娅，请多指教啦。既然大家都叫你阿帽，那我也这么叫吧？"
        },
        {
          "role": "流浪者",
          "text": "随你便。"
        },
        {
          "role": "妮露",
          "text": "咦？阿帽你腰上的那把剑是…"
        },
        {
          "role": "流浪者",
          "text": "嘁，醒来的时候这碍事东西就挂着了，就算丢得远远的，过一阵子又会出现在身上，真是麻烦。"
        },
        {
          "role": "流浪者",
          "text": "谁要是喜欢，这把「勇者之剑」就送给他都行。"
        },
        {
          "role": "派蒙",
          "text": "等等…你说这把剑叫什么？"
        },
        {
          "role": "流浪者",
          "text": "啧，给勇者的「勇者之剑」，挂到了最不该被挂到的人身上。"
        },
        {
          "role": "派蒙",
          "text": "欸？！原来你是这个世界的勇者？"
        },
        {
          "role": "流浪者",
          "text": "一个傻气的名号而已，至于那么惊讶吗？"
        },
        {
          "role": "派蒙",
          "text": "呃…只是，这一路过来，我还以为我们才是预言中的勇者…"
        },
        {
          "role": "流浪者",
          "text": "既然你们这么想当，那让给你们当不就得了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "倒也没那么在意…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "反倒是你，明明拿着「勇者」的身份，但怎么一路过来连你的影子都没见到？"
        },
        {
          "role": "流浪者",
          "text": "我只是在寻找出去的办法罢了。"
        },
        {
          "role": "流浪者",
          "text": "听说这附近有能够前往其他世界的小船，就过来调查一下。"
        },
        {
          "role": "流浪者",
          "text": "但瞧瞧周围这副破碎的惨状——灯塔倒了，船也动不了。我看还是别想用这方法出去了。"
        },
        {
          "role": "派蒙",
          "text": "按照之前的规律，你在这边醒来的时候应该也听到有人对你说话，告诉你该怎么做了吧？"
        },
        {
          "role": "流浪者",
          "text": "啊？我可不想理会那种莫名其妙的声音。"
        },
        {
          "role": "派蒙",
          "text": "欸！等等，你要去哪里呀？"
        },
        {
          "role": "流浪者",
          "text": "去会会把这里搅得一团糟的家伙，人们口中的「罪魁祸首」，这个世界的巨龙。"
        },
        {
          "role": "娜维娅",
          "text": "咦？那不是和我们的目的地一样吗？咱们一起去不就好了？"
        },
        {
          "role": "流浪者",
          "text": "…啧。走的时候去把那边的{{颜色|蓝|龙鳞}}拿上，等下有用。"
        },
        {
          "role": "派蒙",
          "text": "啊？哪有龙鳞？你怎么知道的？有什么用呀…"
        },
        {
          "role": "流浪者",
          "text": "如果真要我回答所有的问题，我们恐怕得准备在这里参加下一次学院争霸赛了。"
        },
        {
          "role": "派蒙",
          "text": "你…！气死我了，这么久没见，这家伙说话还是那么难听！"
        },
        {
          "type": "subtitle",
          "text": "寻找龙鳞"
        },
        {
          "type": "subtitle",
          "text": "获取龙鳞"
        },
        {
          "role": "矿工积木小人（气泡文字）",
          "text": "水流通畅了！"
        },
        {
          "type": "subtitle",
          "text": "与众人对话"
        },
        {
          "role": "派蒙",
          "text": "这样就可以了吧？这块鳞片好神奇啊，它接触到的东西都变得像积木一样了呢，虽然对我们无效。"
        },
        {
          "role": "娜维娅",
          "text": "喷吐毒物，污染碰到的东西…怪不得被这个世界的人称作「邪龙」。"
        },
        {
          "role": "威尔",
          "text": "国王陛下！还有森林仙子和勇者大人！"
        },
        {
          "role": "流浪者",
          "text": "看我干嘛？叫的是你。"
        },
        {
          "role": "妮露",
          "text": "威尔先生！你刚才没摔到哪里吧？"
        },
        {
          "role": "威尔",
          "text": "没有没有，还好那位戴帽子的好心人出手相救。"
        },
        {
          "role": "流浪者",
          "text": "嘁…"
        },
        {
          "role": "威尔",
          "text": "这边似乎是一个村庄，住的都是当初在积木矿窟工作的人，还有那些和我们一样来讨伐邪龙但回不去的人。"
        },
        {
          "role": "妮露",
          "text": "是这样吗，大家没事就好，我可以试着用魔法折一艘小船送你们回去。"
        },
        {
          "role": "娜维娅",
          "text": "嗯，到时候我也来帮忙！不过还是先去解决邪龙吧，要是他在我们救人的时候出来捣乱就麻烦了。"
        },
        {
          "role": "威尔",
          "text": "这里的居民说，邪龙似乎生活在{{颜色|蓝|瀑布后面的巢穴}}里，他们经常看到龙飞进去。"
        },
        {
          "role": "派蒙",
          "text": "那就得在周围找找，有没有去瀑布里面的路了呢。"
        },
        {
          "role": "威尔",
          "text": "总之请国王陛下和几位英雄千万小心，我会在此处等待各位的凯旋。"
        },
        {
          "type": "subtitle",
          "text": "前往邪龙栖息的瀑布附近"
        },
        {
          "role": "蓝色积木小人（气泡文字）",
          "text": "邪龙…"
        },
        {
          "role": "矿工积木小人（气泡文字）",
          "text": "士兵没有回来…"
        },
        {
          "role": "红色积木小人（气泡文字）",
          "text": "他们去讨伐邪龙了！"
        },
        {
          "role": "矿工积木小人（气泡文字）",
          "text": "灯塔也被撞倒了…"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "保卫村庄！"
        },
        {
          "role": "派蒙",
          "text": "到是到了…但这瀑布的水好凶啊，根本走不过去吧…"
        },
        {
          "role": "流浪者",
          "text": "把那块龙鳞拿出来。"
        },
        {
          "role": "派蒙",
          "text": "啊？为什…不对！我才不问你呢！我想想…龙鳞能把碰到的东西变成积木…哦！你是要用它阻隔瀑布的水对吧！"
        },
        {
          "role": "派蒙",
          "text": "哼！不问你我也能自己想明白！"
        },
        {
          "type": "subtitle",
          "text": "使用龙鳞进入瀑布"
        },
        {
          "type": "subtitle",
          "text": "探索瀑布内的空间"
        },
        {
          "role": "妮露",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "怎么了？妮露。"
        },
        {
          "role": "妮露",
          "text": "没什么，只是…感受到了一股强大的魔力…"
        },
        {
          "role": "娜维娅",
          "text": "看来这个后面就是邪龙的老巢了。"
        },
        {
          "role": "派蒙",
          "text": "欸？你什么时候把帽子戴上的？"
        },
        {
          "role": "娜维娅",
          "text": "嗯？这不是要去战斗了嘛，还是换回平时的装扮比较舒服。阿帽不也把腰上的剑收起来了吗？"
        },
        {
          "role": "流浪者",
          "text": "碍事的东西就该早点消失。"
        },
        {
          "role": "派蒙",
          "text": "你…你有什么要准备的吗？看大家突然认真起来了，我也有些紧张。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没什么了，出发吧。",
              "dialogues": []
            },
            {
              "text": "再等一会儿…",
              "dialogues": [
                {
                  "role": "娜维娅",
                  "text": "嗯，确保万无一失再前进吧。"
                }
              ]
            }
          ]
        },
        {
          "role": "流浪者",
          "text": "好了没有？还要我等到什么时候？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好了，出发吧。",
              "dialogues": []
            },
            {
              "text": "再等一会儿…",
              "dialogues": [
                {
                  "role": "娜维娅",
                  "text": "嗯，确保万无一失再前进吧。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "深入邪龙的巢穴"
        },
        {
          "role": "派蒙",
          "text": "咦？前面好像已经有人进来了。"
        },
        {
          "role": "积木卫兵（气泡文字）",
          "text": "冲啊！这次一定要消灭那头邪龙！"
        },
        {
          "role": "两位积木卫兵（气泡文字）",
          "text": "冲啊！"
        },
        {
          "role": "娜维娅",
          "text": "欸！你们冷静点！我们可以一起行动！"
        },
        {
          "role": "派蒙",
          "text": "他们走远了，我们也快跟上去吧。"
        },
        {
          "role": "派蒙",
          "text": "唔啊！什么声音！地…地震了吗？"
        },
        {
          "role": "派蒙",
          "text": "咦？他们…他们人呢？"
        },
        {
          "role": "流浪者",
          "text": "有勇无谋的家伙…"
        },
        {
          "role": "被埋矿工积木小人（气泡文字）",
          "text": "好黑啊！"
        },
        {
          "role": "矿工积木小人（气泡文字）",
          "text": "可恶…力气不够…"
        },
        {
          "role": "被埋矿工积木小人（气泡文字）",
          "text": "得救了！"
        },
        {
          "role": "矿工积木小人（气泡文字）",
          "text": "帮帮我！"
        },
        {
          "role": "矿工积木小人（气泡文字）",
          "text": "来这里吧！"
        },
        {
          "role": "矿工积木小人（气泡文字）",
          "text": "用这个！"
        },
        {
          "role": "妮露",
          "text": "前面，好空旷啊…"
        },
        {
          "role": "派蒙",
          "text": "简直就像是龙平时用来睡觉的地方呢…"
        },
        {
          "role": "派蒙",
          "text": "呃啊！后面，后面的路被拍断了！"
        },
        {
          "role": "流浪者",
          "text": "注意前面！他要来了！"
        },
        {
          "role": "希穆兰卡的「邪龙」",
          "text": "——！"
        },
        {
          "type": "subtitle",
          "text": "似乎无法对邪龙造成有效伤害，先尽量躲避他的攻击吧！",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "好大一只！怎么二话不说就攻击我们呀！"
        },
        {
          "type": "subtitle",
          "text": "聆听耳旁的声音"
        },
        {
          "type": "subtitle",
          "text": "脚下传来地面碎裂的失重感，你们向下落入了一片黑雾之中…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "女人的声音",
          "text": "瞧啊，他出生了。"
        },
        {
          "role": "另一位女人的声音",
          "text": "这世界又多了一位新成员呢。"
        },
        {
          "role": "女人的声音",
          "text": "不过…你确定他的命运是那样的吗…"
        },
        {
          "role": "另一位女人的声音",
          "text": "当然，我算的能有错？"
        },
        {
          "role": "女人的声音",
          "text": "我不喜欢那样的故事…"
        },
        {
          "role": "另一位女人的声音",
          "text": "那就像你说的，让他在你的童话里，寻找自己的故事吧。"
        },
        {
          "role": "女人的声音",
          "text": "哈，你说得对。那么听好了，我的孩子…你的名字是——"
        },
        {
          "role": "？？？",
          "text": "……？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…这里是哪儿？",
              "dialogues": []
            }
