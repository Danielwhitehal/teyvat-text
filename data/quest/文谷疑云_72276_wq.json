{
  "quest_id": 72276,
  "chapter_num": null,
  "chapter_title": "文谷疑云",
  "type": "wq",
  "route": "The Bunkoku Enigma",
  "stories": [
    {
      "story_id": 72276,
      "title": "文谷疑云",
      "description": "你还是有点好奇「文谷案」究竟是个什么事情，所以准备找矢部问问清楚…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与矢部对话"
        },

        {
          "role": "矢部",
          "text": "嘿，你是叫旅行者对吧。"
        },
        {
          "role": "矢部",
          "text": "不知道你有没有记住我的名字。我叫做矢部。"
        },
        {
          "role": "旅行者",
          "text": "你好，矢部。"
        },
        {
          "role": "矢部",
          "text": "你好你好，嘿嘿嘿。"
        },
        {
          "role": "矢部",
          "text": "说来，你应该身手挺厉害的吧。又是直面雷电将军又是纵横渊下宫的。"
        },
        {
          "role": "旅行者",
          "text": "确有其事。"
        },
        {
          "role": "矢部",
          "text": "那太好了。我这里有个关于宝藏的线索，但是可能很危险。你有兴趣吗？"
        },
        {
          "role": "矢部",
          "text": "我虽然天生喜欢一些神神叨叨的东西，但是终究还是爱惜这条小命的。"
        },
        {
          "role": "旅行者",
          "text": "有兴趣，讲讲。"
        },
        {
          "role": "矢部",
          "text": "我在大日御舆趁着巡查之便，找到了这个。"
        },
        {
          "role": "矢部",
          "text": "看起来只是一个石板。但是我觉得它应该就是找到「文谷秘宝」的关键。"
        },
        {
          "role": "旅行者",
          "text": "文谷秘宝？"
        },
        {
          "role": "矢部",
          "text": "白夜国具体的历史在海祇岛是不怎么流传的。我也不是很清楚啦。"
        },
        {
          "role": "矢部",
          "text": "有个故事说，文谷是第二任宰相，和「太阳之子」一起横征暴敛。然后他把财宝藏在了大日御舆的秘密房间里。"
        },
        {
          "role": "矢部",
          "text": "最后他利用阳炎幻法把宝藏密室藏起来了，还召唤了地脉里的秽鬼和怨念看守财宝。"
        },
        {
          "role": "矢部",
          "text": "照理来说，文谷应该也有个什么忒什么斯的古代名字。但是小人和佞臣的故事也没谁去记录得这么清楚。"
        },
        {
          "role": "旅行者",
          "text": "说回石板吧。"
        },
        {
          "role": "矢部",
          "text": "这个石板应该就是解锁文谷藏宝室的关键。我对怪谈传说、神秘案件之类的事情，可是有着长年累月的积累——"
        },
        {
          "role": "矢部",
          "text": "这一块石板上面的…呃…就是那个…"
        },
        {
          "role": "旅行者",
          "text": "说实话。"
        },
        {
          "role": "矢部",
          "text": "其实我在大日御舆储藏间找到这块石板的时候，旁边就有双语写的说明纸条。"
        },
        {
          "role": "矢部",
          "text": "过渡时期归档的文物好像都会用双语进行说明登记。而说明就写了，这个石板和「文谷案」直接相关。"
        },
        {
          "role": "矢部",
          "text": "说明还提到了石板的总数是八块，目前只回收了这一个。文谷密室根据记载也就在附近的那个位置。"
        },
        {
          "role": "矢部",
          "text": "那就麻烦你们过去看看了。宝藏我倒是真的无所谓，能见证「文谷案」的结局我就很开心了。"
        },
        {
          "type": "subtitle",
          "text": "根据矢部指示的方向，寻找线索"
        },
        {
          "role": "矢部",
          "text": "那就麻烦你们过去看看了。千万别勉强自己啊，这种玄乎的事情还挺危险的。"
        },
        {
          "type": "subtitle",
          "text": "调查该区域，寻找线索"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "咦，你听到了吗？上面似乎传来了什么奇怪的声音。"
        },
        {
          "role": "派蒙",
          "text": "顺着声音的方向抬头看，天花板上还有个奇怪的纹路。"
        },
        {
          "role": "派蒙",
          "text": "唔，我们去上面看看吧。"
        },
        {
          "type": "subtitle",
          "text": "前往声音源头，寻找线索"
        },
        {
          "type": "subtitle",
          "text": "调查前方的秘密通道"
        },
        {
          "role": "派蒙",
          "text": "看起来，通向藏宝室的关键就是这个了。"
        },
        {
          "role": "派蒙",
          "text": "石板的大小也还算合适。刚好是…唔，三分之一？"
        },
        {
          "role": "旅行者",
          "text": "九分之一。"
        },
        {
          "role": "派蒙",
          "text": "哎呀，我就是这个意思啦。你明白就好。"
        },
        {
          "role": "派蒙",
          "text": "也就是只要再找到八个石板放进这里就行了吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "再找七个。",
            "一共八个。"
          ]
        },
        {
          "role": "派蒙",
          "text": "烦欸，知道了啦！"
        },
        {
          "role": "派蒙",
          "text": "既然全都在手上了，我们就直接放进去吧。"
        },
        {
          "type": "subtitle",
          "text": "与矢部对话"
        },
        {
          "role": "矢部",
          "text": "你们回来了，有什么发现吗？"
        },
        {
          "role": "旅行者",
          "text": "确实有个密室。"
        },
        {
          "role": "矢部",
          "text": "哦哦，那看起来确有其事咯？"
        },
        {
          "role": "矢部",
          "text": "根据说明上的描述，剩下的石板都被集中放在了三个区域里。"
        },
        {
          "role": "矢部",
          "text": "你手上有阿祇小姐的简易地图吧？我来给你指指。"
        },
        {
          "role": "旅行者",
          "text": "你为什么刚才不说？"
        },
        {
          "role": "矢部",
          "text": "这不是因为这三片地都位于险境之中嘛？要是密室本身就是无稽之谈，后面当然就不用看了。"
        },
        {
          "role": "矢部",
          "text": "如果这只是先祖大人们留下的恶作剧，我哪好意思让你深入黑雾呢。"
        },
        {
          "role": "矢部",
          "text": "好了，就是这些地方。"
        },
        {
          "role": "矢部",
          "text": "希、希望我没理解错吧…"
        },
        {
          "type": "subtitle",
          "text": "启动装置"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "呜啊！"
        },
        {
          "role": "派蒙",
          "text": "我也期待过拼好之后密室会怎么打开…比如说出现传送门啊，或者石壁开出一个密道啊。"
        },
        {
          "role": "派蒙",
          "text": "结果是图案变成真的门了！"
        },
        {
          "role": "旅行者",
          "text": "下面不就是之前的房间…"
        },
        {
          "role": "派蒙",
          "text": "也不能这么说，这个大洞可是「呼！叮！」一下出现的，肯定非比寻常。"
        },
        {
          "role": "派蒙",
          "text": "仔细想想，矢部好像确实也说过密室是用「阳炎幻法」封住的。"
        },
        {
          "role": "派蒙",
          "text": "我们下去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "前往下方的房间"
        },
        {
          "type": "subtitle",
          "text": "和眼前的残影对话"
        },
        {
          "role": "小柳",
          "text": "奇了怪了。他去哪里了？"
        },
        {
          "role": "派蒙",
          "text": "居然有一个「常世之灵」在这里…他难道就是文谷？"
        },
        {
          "role": "小柳",
          "text": "我才不是文谷那种万世罪人啊，我叫小柳。"
        },
        {
          "role": "小柳",
          "text": "不过你们既然知道文谷这个名字，难道是尾随着我俩进来的宵小之辈吗？"
        },
        {
          "role": "小柳",
          "text": "文谷之秘宝可是我的友人破解秘闻、考据文献才找到的。不会让给你们的！"
        },
        {
          "role": "派蒙",
          "text": "不是的，我们只是…呃，误打误撞下来了这里。"
        },
        {
          "role": "小柳",
          "text": "哼，那就快点离开吧。"
        },
        {
          "role": "派蒙",
          "text": "（在以前这里居然有人来过欸。）"
        },
        {
          "role": "派蒙",
          "text": "（有没有可能，秘宝已经被他们拿走了？）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不太可能。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "想想也是，如果他们成功了。「文谷秘宝」就不会是一个流传到今天的谜了。"
        }
              ]
            },
            {
              "text":  "确实可能。",
              "dialogues": [
                {
          "role": "派蒙",
          "text": "不对不对。如果他们成功了，「文谷秘宝」应该就已经结案了才对。那就不会变成流传至今的谜了。"
        }
              ]
            }      
            
           
          ]
        },
        
        {
          "role": "小柳",
          "text": "你们鬼鬼祟祟又在讨论什么？"
        },
        {
          "role": "派蒙",
          "text": "没什么没什么。"
        },
        {
          "role": "派蒙",
          "text": "（总之，我们在这里继续调查一下吧？）"
        },
        {
          "type": "subtitle",
          "text": "与派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "啊，这是最后一块碎片！为什么会有第九块？"
        },
        {
          "role": "派蒙",
          "text": "而且似乎也没有看到文谷秘宝在哪里…"
        },
        {
          "role": "派蒙",
          "text": "唔，我们之后拿回上面的拼图那里再试试吧。"
        },
       {
          "type": "subtitle",
          "text": "再次启动装置"
        },
        {
          "type": "subtitle",
          "text": "与小柳的残影对话"
        },
        {
          "role": "小柳",
          "text": "怎么…怎么会这样…"
        },
        {
          "role": "派蒙",
          "text": "发生了什么？"
        },
        {
          "role": "小柳",
          "text": "我居然对我的朋友下手了…"
        },
        {
          "role": "小柳",
          "text": "一定是文谷布下的怨灵上了我的身，控制了我的神智…"
        },
        {
          "role": "小柳",
          "text": "这么点秘宝，如何能比得上我和他的友谊。我、我绝对不会因为这么点财宝就动了歹念的。"
        },
        {
          "role": "小柳",
          "text": "他那么信任我，找到了文谷之宝都会约我一同前来见证…我…"
        },
        {
          "role": "小柳",
          "text": "我不是这样的人…"
        },
        {
          "role": "派蒙",
          "text": "唔，所以最后一块碎片掩盖了这个真相吗？"
        },
        {
          "role": "旅行者",
          "text": "让他自己静一静吧。"
        },
        {
          "role": "派蒙",
          "text": "说的也是呢。"
        },
        {
          "role": "派蒙",
          "text": "我们回去和矢部说一声吧。"
        },
        {
          "type": "subtitle",
          "text": "与矢部对话"
        },
        {
          "role": "矢部",
          "text": "你们回来啦。"
        },
        {
          "role": "旅行者",
          "text": "你好，什么来着…"
        },
        {
          "role": "矢部",
          "text": "矢部啊矢部！我叫矢部！"
        },
        {
          "role": "矢部",
          "text": "唉，好好把我名字记住啊。我说，你该不会把我委托的事情忘了吧？"
        },
        {
          "role": "派蒙",
          "text": "旅行者在开玩笑啦。我们已经找到了文谷秘宝的真相了。"
        },
        {
          "role": "？？？",
          "text": "和矢部讲述了整个事情的经过…"
        },
        {
          "role": "矢部",
          "text": "所以说，阳炎幻法和宝藏密室确有其事？但是中途还发生过别的故事？"
        },
        {
          "role": "矢部",
          "text": "怨灵和污秽也确有其事，还能控制人的心智。哎哟，吓坏我了。还好没和你们一起去。"
        },
        {
          "role": "旅行者",
          "text": "害怕伤害我们？"
        },
        {
          "role": "矢部",
          "text": "害怕被你们摁在地上打。"
        },
        {
          "role": "矢部",
          "text": "总之有点满足又有点遗憾，谢谢你们啦。虽然确实很玄乎，但是好像也都是元素力能解释的，有点不带劲儿啊。"
        },
        {
          "role": "矢部",
          "text": "文谷的迷案终于可以结掉了，我回去就让全世界知道。"
        }
      ]
    }
  ]
}