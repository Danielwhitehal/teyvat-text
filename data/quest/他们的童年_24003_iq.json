  "stories": [
    {
      "story_id": 24003,
      "title": "他们的童年",
      "description": "在「灰河」之中，你遇见了两位似乎正在做游戏的小孩…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与韦吕对话"
        },
        {
          "role": "韦吕",
          "text": "我这次藏的地方，你一定找不到！"
        },
        {
          "role": "奥雷勒",
          "text": "如果你藏在那些地方，去找你的人就不是我，而是爸和妈了。"
        },
        {
          "role": "旅行者",
          "text": "你们在做什么？"
        },
        {
          "role": "韦吕",
          "text": "我正在和哥哥捉迷藏呢！但是…我藏的每一个地方他都知道…"
        },
        {
          "role": "奥雷勒",
          "text": "韦吕…我们都在这里玩多久了，每一个能藏的角落都被你藏过了。"
        },
        {
          "role": "奥雷勒",
          "text": "至于那些不能藏的地方…我已经和你说过很多次不能藏那里的原因了。"
        },
        {
          "role": "韦吕",
          "text": "那些地方又没什么危险，爸和妈总是说得那么夸张…"
        },
        {
          "role": "奥雷勒",
          "text": "但你藏到那种地方会把衣服和裤子弄脏或者弄破，爸和妈工作已经很辛苦了，别让他们再费这种心。"
        },
        {
          "role": "韦吕",
          "text": "唔…好吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不然…我陪你们玩玩？",
              "dialogues": []
            },
            {
              "text": "我应该找不到你。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "韦吕",
          "text": "真的吗？！大哥哥，你愿意陪我玩吗？"
        },
        {
          "role": "奥雷勒",
          "text": "韦吕，别给人家添麻烦！抱歉，我弟弟满脑子都想着玩…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没关系，我正好有空。",
              "dialogues": []
            },
            {
              "text": "没关系，不算添麻烦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "韦吕",
          "text": "好欸！哥哥你看，人家都答应了！我一定躲得比你好！"
        },
        {
          "role": "奥雷勒",
          "text": "好吧…那就麻烦您了，大哥哥。"
        },
        {
          "role": "奥雷勒",
          "text": "韦吕，不要躲在我和你说过的那些地方，今天晚上爸妈会晚点回来，把衣服弄破了可没人帮你补。"
        },
        {
          "role": "韦吕",
          "text": "知道啦，哥哥真唠叨…我先去躲着了，哥哥也一起玩嘛，快点快点。"
        },
        {
          "role": "奥雷勒",
          "text": "你先去吧，我已经想好躲在哪了。"
        },
        {
          "role": "韦吕",
          "text": "真的？哥哥又吹牛…肯定第一个被大哥哥找到！"
        },
        {
          "role": "？？？",
          "text": "奥雷勒和韦吕先分别去躲了起来…"
        },
        {
          "type": "subtitle",
          "text": "寻找奥雷勒和韦吕"
        },
        {
          "role": "韦吕",
          "text": "呜哇！被找到了！是不是哥哥告诉你这个地方的呀…"
        },
        {
          "role": "韦吕",
          "text": "好吧…算你厉害！我去集合点啦。"
        },
        {
          "type": "subtitle",
          "text": "寻找奥雷勒和韦吕"
        },
        {
          "role": "韦吕",
          "text": "呜哇！被找到了！是不是哥哥告诉你这个地方的呀…"
        },
        {
          "role": "韦吕",
          "text": "好吧…算你厉害！我去集合点啦。"
        },
        {
          "type": "subtitle",
          "text": "寻找奥雷勒和韦吕"
        },
        {
          "role": "韦吕",
          "text": "呜哇！被找到了！是不是哥哥告诉你这个地方的呀…"
        },
        {
          "role": "韦吕",
          "text": "好吧…算你厉害！我去集合点啦。"
        },
        {
          "type": "subtitle",
          "text": "寻找奥雷勒和韦吕"
        },
        {
          "role": "奥雷勒",
          "text": "韦吕什么时候能懂点事呢，唉…"
        },
        {
          "role": "旅行者",
          "text": "你不躲着吗？"
        },
        {
          "role": "奥雷勒",
          "text": "我本来就不怎么想玩。如果不是韦吕吵着要出来玩捉迷藏，我还想多看一会书呢。"
        },
        {
          "role": "奥雷勒",
          "text": "爸和妈工作很辛苦了，我要快点长大…这样才能为他们分担点压力。"
        },
        {
          "role": "奥雷勒",
          "text": "但韦吕一直说很想妈妈…我只能陪他玩会游戏，这样他就不会哭了。"
        },
        {
          "role": "奥雷勒",
          "text": "抱歉，我说太多了，大哥哥。我先去集合点等着了。"
        },
        {
          "role": "奥雷勒",
          "text": "希望韦吕不要把衣服弄脏了…"
        },
        {
          "type": "subtitle",
          "text": "与韦吕对话"
        },
        {
          "role": "韦吕",
          "text": "哥！你是不是把我藏的地方告诉大哥哥了，他怎么找到得这么快呀？"
        },
        {
          "role": "奥雷勒",
          "text": "我都说过了，是你藏的地方太明显了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我经验很丰富的。",
              "dialogues": []
            },
            {
              "text": "我很擅长捉迷藏的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "韦吕",
          "text": "是吗？那大哥哥，你以后会不会经常来呀？我们一起玩好不好！"
        },
        {
          "role": "韦吕",
          "text": "爸妈白天都不在家，哥哥又老是在看书…都没什么时间陪我玩…"
        },
        {
          "role": "奥雷勒",
          "text": "你也可以和我一样，多看看书柜里的那些书，这可比玩捉迷藏好，也有用多了。"
        },
        {
          "role": "韦吕",
          "text": "那…那我还不如去找妈妈学缝衣服呢…"
        }
      ]
    }
