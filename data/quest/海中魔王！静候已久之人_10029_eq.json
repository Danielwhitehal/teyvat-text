{
  "quest_id": 10029,
  "chapter_num": "盛夏！海岛？大冒险！ 其三",
  "chapter_title": "海中魔王！静候已久之人",
  "type": "eq",
  "route": "Dodo-King of the Sea: Lying in Wait",
  "stories": [
    {
      "story_id": 40012,
      "title": "海中魔王！静候已久之人",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "众人从芭芭拉口中得知，周围似乎又有了新的变化。这一次，线索会指向什么？这片海岛背后究竟藏有多少故事，又会在什么时候放出新的「惊喜」呢？",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "◆回到营地"
        },
        {
          "type": "subtitle",
          "text": "◆休息至翌日清晨（次日早6点-8点）"
        },
        {
          "type": "subtitle",
          "text": "◆与芭芭拉对话"
        },
        {
          "role": "芭芭拉",
          "text": "荣誉骑士…荣誉骑士！"
        },
        {
          "role": "旅行者",
          "text": "唔…？"
        },
        {
          "role": "芭芭拉",
          "text": "你醒了，早上好啊。"
        },
        {
          "role": "芭芭拉",
          "text": "休息得好吗？"
        },
        {
          "role": "旅行者",
          "text": "咦，芭芭拉的样子…？"
        },
        {
          "role": "琴",
          "text": "早安，旅行者。"
        },
        {
          "role": "派蒙",
          "text": "琴团长，衣服怎么？！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：芭芭拉把衣服换回来了？",
              "dialogues": [
                {
                  "role": "芭芭拉",
                  "text": "嗯，姐…呃不，琴团长说，这一带情况超出了预计。虽然气氛适合度假，但我们的首要任务还是保护大家。"
                },
                {
                  "role": "芭芭拉",
                  "text": "保险起见，我们换上了原本的服装，也算是从度假的氛围中切换回来。"
                }
              ]
            },
            {
              "text": "旅行者：琴把衣服换回来了？",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "嗯。这一带情况复杂，不知还会发生什么事，安全起见，我们都换回了更适合战斗的服饰。"
                },
                {
                  "role": "琴",
                  "text": "虽然有些浪费这里的风景就是了…抱歉。"
                },
                {
                  "role": "芭芭拉",
                  "text": "没什么，也是为了大家嘛。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "和之前的氛围完全不一样了…一下就回到工作状态，真不愧是西风骑士团代理团长。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：琴严于律己，真厉害。",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "旅行者太客气了，你的优秀不亚于任何人，我们对你的信赖也来源于此。"
                }
              ]
            },
            {
              "text": "旅行者：我也想成为这样自律的人。",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "旅行者太客气了，你的优秀不亚于任何人，我们对你的信赖也来源于此。"
                }
              ]
            }
          ]
        },
        {
          "role": "芭芭拉",
          "text": "啊，我们不是故意打扰你们休息的！刚刚我看见附近的岛上有白烟升起，觉得很奇怪…我想，大家最好一起去现场查看。"
        },
        {
          "role": "可莉",
          "text": "是嘟嘟大魔王来了！"
        },
        {
          "role": "派蒙",
          "text": "怎么办，连我也开始相信嘟嘟大魔王要来了…"
        },
        {
          "role": "琴",
          "text": "我也想见识一下所谓的魔王究竟是什么人。各位，请随我一同到旁边的岛屿调查。"
        },
        {
          "type": "subtitle",
          "text": "◆前往芭芭拉说的位置"
        },
        {
          "type": "subtitle",
          "text": "◆与迪卢克和凯亚对话"
        },
        {
          "role": "派蒙",
          "text": "那边有两道人影！"
        },
        {
          "role": "派蒙",
          "text": "嗯…嗯？好像是…"
        },
        {
          "role": "迪卢克",
          "text": "……"
        },
        {
          "role": "凯亚",
          "text": "……"
        },
        {
          "role": "派蒙",
          "text": "完全就是认识的人呀！"
        },
        {
          "role": "可莉",
          "text": "是凯亚哥哥和奇怪的大人。"
        },
        {
          "role": "凯亚",
          "text": "哟！没想到会在这种地方遇见各位，真是意外之喜啊。"
        },
        {
          "role": "琴",
          "text": "凯亚和迪卢克前辈？你们也来这里了？"
        },
        {
          "role": "芭芭拉",
          "text": "哎？不是大魔王吗？"
        },
        {
          "role": "迪卢克",
          "text": "大魔王…果然吗。"
        },
        {
          "role": "凯亚",
          "text": "看来，你们也是被那个大魔王请到这片群岛来的。"
        },
        {
          "role": "凯亚",
          "text": "这可巧了，我们也是哦。"
        },
        {
          "role": "琴",
          "text": "「也」的意思是…？"
        },
        {
          "role": "凯亚",
          "text": "这件事一会儿再说，我想先享受享受海岛的阳光。"
        },
        {
          "role": "派蒙",
          "text": "凯亚，迪卢克，你们是坐船来的？不是说海域附近有暴风雨和浓雾吗？"
        },
        {
          "role": "凯亚",
          "text": "暴风雨和浓雾？那我们运气不错，来时雾气已经散尽，现在是最适合度假的好天气了呢。"
        },
        {
          "role": "凯亚",
          "text": "不过如你所知，普通的船只到不了这里。迫于无奈，我们只好采用了跟你们一样的交通工具。"
        },
        {
          "role": "派蒙",
          "text": "哎？！你们也是骑在特瓦林背上来的吗？！"
        },
        {
          "role": "迪卢克",
          "text": "不必惊讶，巨龙飞行是非常显眼的事情，早就传遍大街小巷了。"
        },
        {
          "role": "琴",
          "text": "呜哇…难道大家都知道了…"
        },
        {
          "role": "迪卢克",
          "text": "不过民众都没看见龙背上的人，只知道有龙来过。"
        },
        {
          "role": "琴",
          "text": "呼，太好了。"
        },
        {
          "role": "凯亚",
          "text": "没想到那位吟游诗人有请动龙的力量，好有本事，我想…"
        },
        {
          "role": "旅行者",
          "text": "（糟糕，难道他发现温迪…？！）"
        },
        {
          "role": "凯亚",
          "text": "我想，特瓦林应该是古典曲调的忠实爱好者吧。"
        },
        {
          "role": "芭芭拉",
          "text": "原来是这样！"
        },
        {
          "role": "琴",
          "text": "哈啊…"
        },
        {
          "role": "琴",
          "text": "请问，二位是结伴来的吗？"
        },
        {
          "role": "凯亚",
          "text": "哈哈哈，代理团长好会开玩笑，我在你心里是会专程跟他结伴的人吗？"
        },
        {
          "role": "迪卢克",
          "text": "嘁。"
        },
        {
          "role": "凯亚",
          "text": "其实跟我们一起到岛上来的还有两个人，不过出于种种原因已经走散了。"
        },
        {
          "role": "琴",
          "text": "种种原因？"
        },
        {
          "role": "凯亚",
          "text": "缺乏团队凝聚力、个性太过鲜明…之类的。"
        },
        {
          "role": "旅行者",
          "text": "也就是说，你们被丢下了？"
        },
        {
          "role": "凯亚",
          "text": "哈哈哈哈，旅行者好犀利，一下就看出了问题所在。"
        },
        {
          "role": "派蒙",
          "text": "那两个人是谁啊？"
        },
        {
          "role": "迪卢克",
          "text": "阿贝多和雷泽。"
        },
        {
          "role": "派蒙",
          "text": "咦？！"
        },
        {
          "role": "可莉",
          "text": "阿贝多哥哥和雷泽？太好了！"
        },
        {
          "role": "派蒙",
          "text": "你们、你们是结伴来度假的吧！"
        },
        {
          "role": "琴",
          "text": "等等，连凯亚都跑出来了，西风骑士团现在由谁管理？"
        },
        {
          "role": "凯亚",
          "text": "自然是伟大的图书管理员丽莎了。"
        },
        {
          "role": "凯亚",
          "text": "放心吧，从某种角度来说，她比你我都严厉。这几天在蒙德城里做坏事的人，可得小心啦。"
        },
        {
          "role": "琴",
          "text": "还好，还有丽莎在…"
        },
        {
          "role": "琴",
          "text": "咳咳！阿贝多和雷泽哪儿去了？"
        },
        {
          "role": "芭芭拉",
          "text": "还有，我刚才看到的白烟是什么？"
        },
        {
          "role": "凯亚",
          "text": "这个嘛…就要从我们为什么被留在这里说起了。"
        },
        {
          "role": "凯亚",
          "text": "我们是骑龙过来的，但进入海岛区域不久后，雷泽就被不知什么东西吸引了注意力，直接跳下龙背消失在海上。"
        },
        {
          "role": "凯亚",
          "text": "我们担心他遭遇危险，也纷纷跳下龙背，靠着风之翼降落在这片岛屿上。但如你们所见，这里只是一座光秃秃的小岛。"
        },
        {
          "role": "凯亚",
          "text": "根据经验，我判断此时应当原地等待联络，迪卢克则认为，雷泽不会回来找我们。而在我们争论时，阿贝多居然一个人悄悄地走了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：不愧是他。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "等一下！为什么他走得了，你们却被困住了？"
                }
              ]
            },
            {
              "text": "旅行者：一定是投入更感兴趣的事物了。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "等一下！为什么他走得了，你们却被困住了？"
                }
              ]
            },
            {
              "text": "阿贝多很有规避困境的能力。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "等一下！为什么他走得了，你们却被困住了？"
                }
              ]
            }
          ]
        },
        {
          "role": "凯亚",
          "text": "哈哈哈…谁知道呢，或许是我命中注定要跟迪卢克老爷一起倒霉吧。"
        },
        {
          "role": "迪卢克",
          "text": "是吗？"
        },
        {
          "role": "凯亚",
          "text": "阿贝多是炼金术士，擅长造物，凭借着那些漂亮的人造花，轻易就去到了别的岛屿。本来我也可以踩着冻成冰的海水走到对面…"
        },
        {
          "role": "迪卢克",
          "text": "我怎么记得我的目的地是那边山势较高的岛屿，你坚持，我们才会临时变更方向降落在这里。"
        },
        {
          "role": "凯亚",
          "text": "哎呀哎呀，我费尽元素力冻起来的海水被你一踩就化。谁让冰火元素不容呢，你的神之眼要是岩元素，我早就在其他岛上睡午觉了。"
        },
        {
          "role": "芭芭拉",
          "text": "我看到的…难道是融化蒸发冒出的水汽？"
        },
        {
          "role": "派蒙",
          "text": "该说你们是感情太好，还是感情太差呢…"
        },
        {
          "role": "芭芭拉",
          "text": "不、不管怎么说，气氛热闹起来了，也是好事。"
        },
        {
          "role": "琴",
          "text": "是啊。面对未知的困境，有同伴在绝对是好事。二位，请跟我们一起行动。"
        },
        {
          "role": "迪卢克",
          "text": "可以。"
        },
        {
          "role": "凯亚",
          "text": "当然啦。"
        },
        {
          "role": "琴",
          "text": "当务之急是找到阿贝多和雷泽，你们知道他俩往哪个方向去了吗？"
        },
        {
          "role": "迪卢克",
          "text": "暂时还无法确定雷泽的去向。找阿贝多的话，他往那边去了。"
        },
        {
          "role": "派蒙",
          "text": "我们也快点出发吧！"
        },
        {
          "type": "subtitle",
          "text": "◆寻找阿贝多"
        },
        {
          "role": "派蒙",
          "text": "这座岛面积可不小，他会在哪里呢？"
        },
        {
          "role": "旅行者",
          "text": "阿贝多——"
        },
        {
          "role": "可莉",
          "text": "阿贝多哥哥——"
        },
        {
          "role": "派蒙",
          "text": "阿贝多——快出来——"
        },
        {
          "role": "阿贝多",
          "text": "嗯？是旅行者和派蒙吗？"
        },
        {
          "role": "派蒙",
          "text": "呜哇，悄悄出现在背后了！"
        },
        {
          "role": "可莉",
          "text": "阿贝多哥哥！"
        },
        {
          "role": "阿贝多",
          "text": "可莉，各位。"
        },
        {
          "role": "阿贝多",
          "text": "跟我估算的时间差不多，果然已经汇合了啊。"
        },
        {
          "role": "凯亚",
          "text": "还得感谢你先走一步，把我们抛弃在隔壁岛上。"
        },
        {
          "role": "阿贝多",
          "text": "不必客气。给爱聊天的人制造一些聊天空间罢了。"
        },
        {
          "role": "琴",
          "text": "阿贝多，你为什么会来这里？"
        },
        {
          "role": "阿贝多",
          "text": "我收到了信。"
        },
        {
          "role": "凯亚",
          "text": "来的路上我们交换了信息，第二批包括我在内的四个人，都收到了不知何时放在门前的神秘来信。"
        },
        {
          "role": "迪卢克",
          "text": "署名是「嘟嘟大魔王」。"
        },
        {
          "role": "凯亚",
          "text": "这个词从你嘴里说出来未免太过奇怪。"
        },
        {
          "role": "阿贝多",
          "text": "每个人收到的来信内容都不同，但都能吸引人来到这片群岛。"
        },
        {
          "role": "旅行者",
          "text": "信上写了什么？"
        },
        {
          "role": "阿贝多",
          "text": "我那封信的内容很简单：「你的妹妹可莉在我手上，想见她就到金苹果群岛来。」"
        },
        {
          "role": "派蒙",
          "text": "已经是恐吓信了啊！大魔王在要挟你！"
        },
        {
          "role": "阿贝多",
          "text": "没错。显然我被要挟了。"
        },
        {
          "role": "凯亚",
          "text": "我那封也很好理解。「海盗沉船就在无人岛，有宝藏和失传多年的珍奇古董花瓶。」"
        },
        {
          "role": "凯亚",
          "text": "啊哈哈，看来有人打探到了我爷爷遗传眼罩给我的事。"
        },
        {
          "role": "派蒙",
          "text": "凯亚这家伙，又在胡言乱语了。"
        },
        {
          "role": "派蒙",
          "text": "那迪卢克老爷的呢？"
        },
        {
          "role": "迪卢克",
          "text": "「无人岛上有深渊教团的据点，速往。」"
        },
        {
          "role": "凯亚",
          "text": "非常高明，对症下药。"
        },
        {
          "role": "派蒙",
          "text": "太奇怪了，完全是冲着个人去的…可大魔王把大家叫到这里到底是为了什么？"
        },
        {
          "role": "琴",
          "text": "…唉，整件事的疑点太多了。"
        },
        {
          "role": "凯亚",
          "text": "像我们这些没有梦想的成年人，完全是为确认实际情况而来的。"
        },
        {
          "role": "芭芭拉",
          "text": "对了，雷泽也收到信了吗？"
        },
        {
          "role": "凯亚",
          "text": "是啊，他说他不擅长读写，特地请路上遇到的好心猫耳叔叔帮忙转达了信件内容。"
        },
        {
          "role": "琴",
          "text": "路上遇到的…好心猫耳叔叔…"
        },
        {
          "role": "派蒙",
          "text": "我知道我知道，就是杜拉夫先生嘛。"
        },
        {
          "role": "凯亚",
          "text": "雷泽收到的内容也很简单，「红色、很烫的女孩子去了海岛，她需要朋友的帮助。」"
        },
        {
          "role": "迪卢克",
          "text": "得知其他人收到的信件内容后，我就知道这件事有蹊跷。"
        },
        {
          "role": "迪卢克",
          "text": "我可不相信世上有什么魔王，对方一定别有所图。到这里来，就是为了处理潜在危机。"
        },
        {
          "role": "可莉",
          "text": "不对不对，有魔王！嘟嘟大魔王就是…就是大魔王！"
        },
        {
          "role": "迪卢克",
          "text": "…好吧。"
        },
        {
          "role": "阿贝多",
          "text": "雷泽是被某件事物吸引，提前跃下龙背才跟我们走散的。"
        },
        {
          "role": "阿贝多",
          "text": "我在这座岛上检查过了，没有他的脚印，也没有开船的痕迹。"
        },
        {
          "role": "阿贝多",
          "text": "根据他跃下时的方位，如果不是降落在这座岛上，就是去了那一边。"
        },
        {
          "role": "旅行者",
          "text": "是那个平台！"
        },
        {
          "role": "阿贝多",
          "text": "你们去过？"
        },
        {
          "role": "派蒙",
          "text": "前几天去过哦，平台上有台神奇的机械，琴团长说它来自稻妻。"
        },
        {
          "role": "阿贝多",
          "text": "难道就是那个吸引了雷泽？"
        },
        {
          "role": "琴",
          "text": "各位，我们去中央平台确认情况吧。"
        },
        {
          "type": "subtitle",
          "text": "◆回到中央的岛屿"
        },
        {
          "type": "subtitle",
          "text": "◆寻找雷泽"
        },
        {
          "role": "派蒙",
          "text": "看，在那边！"
        },
        {
          "role": "可莉",
          "text": "雷泽——！"
        },
        {
          "role": "雷泽",
          "text": "啊…大家。"
        },
        {
          "role": "雷泽",
          "text": "我来了。"
        },
        {
          "role": "琴",
          "text": "雷泽，你没事吧？"
        },
        {
          "role": "芭芭拉",
          "text": "有没有受伤？需要治疗吗？"
        },
        {
          "role": "雷泽",
          "text": "没有。没事。"
        },
        {
          "role": "旅行者",
          "text": "你在这里做什么？"
        },
        {
          "role": "雷泽",
          "text": "我…闻到味道。"
        },
        {
          "role": "雷泽",
          "text": "这个，给你。"
        },
        {
          "role": "派蒙",
          "text": "这是什么？机械零件吗？"
        },
        {
          "role": "雷泽",
          "text": "味道…很明显。和信上一样。"
        },
        {
          "role": "迪卢克",
          "text": "雷泽确实提过他收到的信上有股奇怪的气味。"
        },
        {
          "role": "派蒙",
          "text": "雷泽的鼻子特别灵，那个魔王连这一点都算到了吗？"
        },
        {
          "role": "雷泽",
          "text": "嗯，这个和那个…味道一样。"
        },
        {
          "role": "阿贝多",
          "text": "哦？"
        },
        {
          "role": "雷泽",
          "text": "把这个小东西…放到那个人里面。他们，一样。"
        },
        {
          "role": "雷泽",
          "text": "给你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：给我吗？",
              "dialogues": [
                {
                  "role": "雷泽",
                  "text": "嗯！我、我不懂…"
                }
              ]
            },
            {
              "text": "旅行者：由我来放？",
              "dialogues": [
                {
                  "role": "雷泽",
                  "text": "嗯！我、我不懂…"
                }
              ]
            }
          ]
        },
        {
          "role": "雷泽",
          "text": "你…可靠，放心。"
        },
        {
          "role": "可莉",
          "text": "嗯，可莉也觉得荣誉骑士姐姐很可靠！"
        },
        {
          "role": "迪卢克",
          "text": "慢着。好好想一想，放入零件后会发生什么事？"
        },
        {
          "role": "琴",
          "text": "这台稻妻机械多半也是魔王的布设，看来，是想让我们激活它。"
        },
        {
          "role": "芭芭拉",
          "text": "也许，魔王要醒来了。"
        },
        {
          "role": "凯亚",
          "text": "那就得做好应战准备了吧。旅行者，注意安全哦。"
        },
        {
          "role": "派蒙",
          "text": "见到魔王是小可莉的愿望，我们正是为此而来的，对吧空？"
        },
        {
          "role": "旅行者",
          "text": "是的。我要上了！"
        },
        {
          "type": "subtitle",
          "text": "◆放入零件激活稻妻装置"
        },
        {
          "type": "subtitle",
          "text": "◆击败苏醒的稻妻装置"
        },
        {
          "type": "subtitle",
          "text": "◆听听大家的看法"
        },
        {
          "role": "派蒙",
          "text": "呼，终于打败它了…"
        },
        {
          "role": "可莉",
          "text": "好像有东西！"
        },
        {
          "role": "琴",
          "text": "是水晶吗？"
        },
        {
          "role": "旅行者",
          "text": "问问行家就知道了。"
        },
        {
          "role": "阿贝多",
          "text": "想不到你对我这么有信心。"
        },
        {
          "role": "阿贝多",
          "text": "要说晶体，首先得说说这台机械本身。"
        },
        {
          "role": "阿贝多",
          "text": "各位的猜想很正确。刚才那名稻妻打扮的巨人，是一台仿造人的形态动作制作而成的机械。"
        },
        {
          "role": "派蒙",
          "text": "是用来打架的那种机械吗？就像遗迹守卫那样。"
        },
        {
          "role": "阿贝多",
          "text": "恐怕是的。它具备相当的作战能力，又不听指挥，应该是损坏已久，只会无差别攻击所有人。"
        },
        {
          "role": "阿贝多",
          "text": "从外观来看，它也确实出自稻妻。"
        },
        {
          "role": "琴",
          "text": "但据我所知，稻妻眼下正处于锁国状态。如此庞大的战斗机械，如何才能从稻妻内部流出？"
        },
        {
          "role": "阿贝多",
          "text": "那就要问这座岛上曾经存在过的人了。"
        },
        {
          "role": "可莉",
          "text": "人？"
        },
        {
          "role": "阿贝多",
          "text": "凭各位的眼力，肯定已经发现了。这一带看似无人岛，却有过人类存在的痕迹。"
        },
        {
          "role": "阿贝多",
          "text": "我大胆推测这座岛从前有过原住民，但比起原生人类，他们是外部来客的可能性更大。"
        },
        {
          "role": "阿贝多",
          "text": "或许这些人花费了很长时间，总算找到离开海域的办法。如今人去岛空，只在局部地区留有残存痕迹。"
        },
        {
          "role": "阿贝多",
          "text": "至于水晶…嗯，这是一种较为罕见的矿石制成的晶体。能透光，我想也许是有什么特殊用处。"
        },
        {
          "role": "派蒙",
          "text": "我们在附近找到过石头搭起的塔和小花，你觉得有关系吗？"
        },
        {
          "role": "阿贝多",
          "text": "听起来像是有什么人在祭奠它。"
        },
        {
          "role": "芭芭拉",
          "text": "是的，我去看了那块布置，该怎么说呢…像是某个人心怀感谢献上的礼物。"
        },
        {
          "role": "阿贝多",
          "text": "原来如此…"
        },
        {
          "role": "阿贝多",
          "text": "各位觉得呢？什么人会为这样一台机械送上纪念品？"
        },
        {
          "role": "凯亚",
          "text": "受过恩惠的人才会心怀感激，我认为…这些缅怀之物来自与它有利益关系的人群。"
        },
        {
          "role": "阿贝多",
          "text": "如果它曾经与这里的原住民共同生活过，就不难解释这些了吧。当然了，这只是我的猜想。"
        },
        {
          "role": "芭芭拉",
          "text": "共同生活…是在它坏掉之前吗？它究竟做过些什么呢…"
        },
        {
          "role": "迪卢克",
          "text": "这一带常有丘丘人出没。或许，它的无差别攻击对象也囊括了丘丘人，从而保护到了原住民。"
        },
        {
          "role": "凯亚",
          "text": "有趣的巧合。但说到底，这些都只是猜测而已。想深入了解背后的故事，恐怕需要更多证据。"
        },
        {
          "role": "琴",
          "text": "嗯，目前还不清楚线索在哪里…各位，稍后我们可以一起调查附近，现在的话，还是先把精力集中在眼前的问题上吧。"
        },
        {
          "role": "可莉",
          "text": "呀，这里还有一封信！肯定又是嘟嘟大魔王！"
        },
        {
          "role": "派蒙",
          "text": "信？快看看写了什么！"
        },
        {
          "role": "可莉",
          "text": "「神秘的魔王，神秘的魔王，独自睡在西南方的小岛上；坏孩子让他等得太久，天黑了，星星爬上夜空。」"
        },
        {
          "role": "可莉",
          "text": "「贪婪的精灵，贪婪的精灵，让月亮跑起了圈；三色的钥匙由奇异之鱼保管，秘密就在这里，你敢来吗？」"
        },
        {
          "role": "琴",
          "text": "是新的暗示吗？"
        },
        {
          "role": "芭芭拉",
          "text": "是什么意思呢…跟刚才那些水晶有关吗？"
        },
        {
          "role": "凯亚",
          "text": "「西南边的小岛」，指的是哪一座岛？"
        },
        {
          "role": "迪卢克",
          "text": "与其站着瞎猜，不如沿途调查。"
        },
        {
          "role": "派蒙",
          "text": "这片群岛我们几乎都走过一遍了，要说有什么值得在意的事…"
        },
        {
          "role": "可莉",
          "text": "有哦，那边有个好奇怪的岛。"
        },
        {
          "role": "可莉",
          "text": "上面有个大大的圆圆的东西！"
        },
        {
          "role": "琴",
          "text": "可莉，你又擅自行动了吗？"
        },
        {
          "role": "可莉",
          "text": "啊…对不起，可莉只是到处看看…"
        },
        {
          "role": "阿贝多",
          "text": "只要没触动什么机关就行。"
        },
        {
          "role": "琴",
          "text": "就算这里很空旷，一个人行动也可能遇到危险…可莉，下次如果你想去什么地方就叫我，我们一起过去，这样可以吗？"
        },
        {
          "role": "可莉",
          "text": "可以吗？可莉担心琴团长还有其他的事要忙…"
        },
        {
          "role": "琴",
          "text": "当然可以了。"
        },
        {
          "role": "可莉",
          "text": "嗯，知道了！"
        },
        {
          "role": "迪卢克",
          "text": "一如既往的认真啊。"
        },
        {
          "role": "派蒙",
          "text": "琴团长，简直像是可莉的家长一样呀！"
        },
        {
          "role": "凯亚",
          "text": "你说得很对，我也有同感哦。"
        },
        {
          "role": "琴",
          "text": "…凯亚…"
        },
        {
          "role": "凯亚",
          "text": "哈哈，抱歉抱歉，不该这样开团长玩笑。那旅行者，我们过去看看吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往西南方的岛屿"
        },
        {
          "type": "subtitle",
          "text": "◆与众人讨论眼前的封印"
        },
        {
          "role": "派蒙",
          "text": "咦，这是罩子吗？好像不是硬的…"
        },
        {
          "role": "琴",
          "text": "……"
        },
        {
          "role": "可莉",
          "text": "这——么大的罩子！哼，可莉知道你就在里面！"
        },
        {
          "role": "可莉",
          "text": "喂——我来了！我就是可莉，嘟嘟大魔王，出来见我！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：对对！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "没有回音…难道他也不在这里面？"
                }
              ]
            },
            {
              "text": "旅行者：出来见她，听见没有！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "没有回音…难道他也不在这里面？"
                }
              ]
            }
          ]
        },
        {
          "role": "可莉",
          "text": "不会的，他一定在！"
        },
        {
          "role": "可莉",
          "text": "罩子越大，嘟嘟大魔王越坏！"
        },
        {
          "role": "派蒙",
          "text": "这是什么逻辑呀…"
        },
        {
          "role": "芭芭拉",
          "text": "各位，我觉得可莉说得没错，这么巨大的能量罩，想必有它存在的原因吧。"
        },
        {
          "role": "阿贝多",
          "text": "合理的推测，我同意。"
        },
        {
          "role": "琴",
          "text": "既然是能量罩，就需要能量源。找到源头，应该就能破解它。"
        },
        {
          "role": "琴",
          "text": "先在附近找找可能存在关联的装置吧，有劳各位了。"
        },
        {
          "role": "可莉",
          "text": "可莉先出发！"
        },
        {
          "role": "琴",
          "text": "等等可莉，跑慢一点！"
        },
        {
          "role": "派蒙",
          "text": "空，我们也不要输！快跟上去！"
        },
        {
          "type": "subtitle",
          "text": "◆研究神秘装置"
        },
        {
          "role": "可莉",
          "text": "快来看，这个这个！"
        },
        {
          "role": "派蒙",
          "text": "唔…看起来确实是装置一类的东西呢…"
        },
        {
          "role": "琴",
          "text": "一共三套装置，发出的光线汇聚在同一处。阿贝多，它会是解除能量罩的关键吗？"
        },
        {
          "role": "阿贝多",
          "text": "唔…"
        },
        {
          "role": "阿贝多",
          "text": "这里的光线发射器前都布置了一个小型支架。看形状，似乎是要嵌入某种东西。"
        },
        {
          "role": "派蒙",
          "text": "这是什么形状呀？"
        },
        {
          "role": "可莉",
          "text": "可莉看不懂，快说给可莉听…"
        },
        {
          "role": "迪卢克",
          "text": "不规则的圆形，也可以说是扇形。"
        },
        {
          "role": "凯亚",
          "text": "会是什么呢？出现在海边，具有这一形状的物品…贝壳？"
        },
        {
          "role": "芭芭拉",
          "text": "但我们见到的贝壳，不是比这个形状小，就是比这个形状大…"
        },
        {
          "role": "凯亚",
          "text": "不是贝壳，多半就是鱼鳞了吧。"
        },
        {
          "role": "派蒙",
          "text": "鱼鳞…但是这里为什么要放鱼鳞呢？"
        },
        {
          "role": "琴",
          "text": "或者，还有其他线索吗？"
        },
        {
          "role": "阿贝多",
          "text": "既然是安置在光线发射器前的装置，就意味着…"
        },
        {
          "role": "旅行者",
          "text": "要能透光？"
        },
        {
          "role": "派蒙",
          "text": "对哦！"
        },
        {
          "role": "琴",
          "text": "我还是第一次见到这样的东西。"
        },
        {
          "role": "芭芭拉",
          "text": "居然是这种用法吗…"
        },
        {
          "role": "迪卢克",
          "text": "没猜错的话，这是利用光线完成的特殊装置。"
        },
        {
          "role": "迪卢克",
          "text": "我曾在一些地方见过类似的设计，光线的布置必须符合条件或路径，正确布置后才能开启机关。"
        },
        {
          "role": "凯亚",
          "text": "照这么说，这三台装置就是打开能量罩的钥匙。"
        },
        {
          "role": "阿贝多",
          "text": "各位发现了吗？装置发射的光线虽然是白色，它们本身却是有颜色的。红、蓝、黄，一共三种。"
        },
        {
          "role": "雷泽",
          "text": "是，信上的。"
        },
        {
          "role": "派蒙",
          "text": "「三色的钥匙由奇异之鱼保管」！"
        },
        {
          "role": "凯亚",
          "text": "嗯，很有道理呢。"
        },
        {
          "role": "芭芭拉",
          "text": "荣誉骑士，刚才那个大家伙是不是掉过什么东西？"
        },
        {
          "role": "旅行者",
          "text": "嗯，三块水晶。"
        },
        {
          "role": "芭芭拉",
          "text": "花瓣般的浅红色、海浪般的浅蓝色、秋叶般的浅黄色…"
        },
        {
          "role": "迪卢克",
          "text": "看来，这三块水晶就是解开谜题的关键道具。"
        },
        {
          "role": "琴",
          "text": "把贵重的东西交给海中贪婪的精灵…是这个意思吗？"
        },
        {
          "role": "琴",
          "text": "如果是我想的那个意思，旅行者，我建议把水晶布置在海边。"
        },
        {
          "role": "琴",
          "text": "贪婪的精灵，很可能是指海中的游鱼。鱼被水晶吸引，带来鱼鳞。"
        },
        {
          "role": "派蒙",
          "text": "原来是这样！那我有话要说哦！"
        },
        {
          "role": "派蒙",
          "text": "刚才来的路上，我有看到那边有个巨大的海螺，周围有很多鱼在游。"
        },
        {
          "role": "派蒙",
          "text": "如果要放置水晶，就放在那里吧！那里的水比较浅，万一失败也能把东西捡回来…"
        },
        {
          "role": "可莉",
          "text": "不会失败的，不要说这种话啦！"
        },
        {
          "role": "派蒙",
          "text": "对对对，一定成功！那我现在就带大家过去吧。"
        },
        {
          "type": "subtitle",
          "text": "◆前往巨大海螺所在处"
        },
        {
          "type": "subtitle",
          "text": "◆布置水晶并等待"
        },
        {
          "type": "subtitle",
          "text": "◆与可莉对话"
        },
        {
          "role": "派蒙",
          "text": "这样就可以了吧？"
        },
        {
          "role": "派蒙",
          "text": "可是，没看到有鱼过来呢…"
        },
        {
          "role": "芭芭拉",
          "text": "可莉，信上还有其他提示吗？"
        },
        {
          "role": "可莉",
          "text": "呃，呃…是什么来着…"
        },
        {
          "role": "琴",
          "text": "「贪婪的精灵，贪婪的精灵，让月亮跑起了圈」…"
        },
        {
          "role": "旅行者",
          "text": "「天黑了，星星爬上夜空」…"
        },
        {
          "role": "芭芭拉",
          "text": "难道说，这种鱼只在夜晚出现？"
        },
        {
          "role": "迪卢克",
          "text": "还要等一整晚的意思吗，哼。"
        },
        {
          "role": "雷泽",
          "text": "抓鱼…吃。"
        },
        {
          "role": "可莉",
          "text": "好呀好呀！跟可莉去炸鱼！"
        },
        {
          "role": "雷泽",
          "text": "嗯。"
        },
        {
          "role": "琴",
          "text": "等等，可莉…"
        },
        {
          "role": "可莉",
          "text": "琴团长要一起去吗？你说过哦，如果可莉要去别的地方就告诉你，我们一起去！"
        },
        {
          "role": "琴",
          "text": "…也是。"
        },
        {
          "role": "琴",
          "text": "那么，我就破例跟可莉一起去炸鱼吧。"
        },
        {
          "role": "派蒙",
          "text": "我听到了什么，琴团长要去炸鱼？！"
        },
        {
          "role": "可莉",
          "text": "鱼很好吃，所以值得！"
        },
        {
          "role": "琴",
          "text": "这里是无人岛，使用炸弹应该不会给他人造成困扰…稍稍放松一下，我想，没关系吧。"
        },
        {
          "role": "可莉",
          "text": "去找鱼喽！出发！"
        },
        {
          "role": "雷泽",
          "text": "那边，很多鱼。"
        },
        {
          "role": "可莉",
          "text": "可莉来啦——！"
        },
        {
          "role": "琴",
          "text": "等等！"
        },
        {
          "role": "派蒙",
          "text": "那两个人，一溜烟地跑掉了哦。"
        },
        {
          "role": "琴",
          "text": "算了…有雷泽在应该没关系。等安顿完大家，我就过去找他们。"
        },
        {
          "role": "凯亚",
          "text": "到自由活动时间了吗？太好了，刚好我也想到处转转。"
        },
        {
          "role": "派蒙",
          "text": "该不会又要去找海盗的宝藏了吧？"
        },
        {
          "role": "凯亚",
          "text": "哈哈，谁知道呢？这么大的海岛，上面一定有许多秘密。"
        },
        {
          "role": "凯亚",
          "text": "就让我凯亚来一探究竟吧！"
        },
        {
          "role": "迪卢克",
          "text": "…呼。"
        },
        {
          "role": "派蒙",
          "text": "迪卢克老爷该不会也贪财吧？"
        },
        {
          "role": "迪卢克",
          "text": "怎么可能。我只想一个人静静。"
        },
        {
          "role": "派蒙",
          "text": "可我觉得你也不会闲着的…"
        },
        {
          "role": "迪卢克",
          "text": "各位自便，我先告辞了。"
        },
        {
          "role": "旅行者",
          "text": "他早就跑了…"
        },
        {
          "role": "芭芭拉",
          "text": "阿贝多先生刚才说要一个人去写生。"
        },
        {
          "role": "派蒙",
          "text": "呜…这些家伙！装得比谁都稳重，却这么爱度假吗！"
        },
        {
          "role": "琴",
          "text": "难得的海岛，大家一定也很向往自由时间吧。"
        },
        {
          "role": "琴",
          "text": "没关系，请尽情游玩，等鱼回来我再召集大家。"
        },
        {
          "role": "琴",
          "text": "虽然来海岛的缘由已经不那么单纯…不，无论我心中怎么想，都必须承认这片海景确实不错。"
        },
        {
          "role": "琴",
          "text": "旅行者，你也不要太操劳，有时间多放松一下吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：琴团长，谢谢你。",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "不是的，我只是…"
                }
              ]
            },
            {
              "text": "旅行者：琴，你真温柔。",
              "dialogues": [
                {
                  "role": "琴",
                  "text": "不是的，我只是…"
                }
              ]
            }
          ]
        },
        {
          "role": "琴",
          "text": "……"
        },
        {
          "role": "琴",
          "text": "总之…希望你在这里能够开心。"
        },
        {
          "role": "琴",
          "text": "无论之后等着我们的是什么，我都会守护大家，守护可莉。这是我身为西风骑士团代理团长的责任。"
        },
        {
          "role": "派蒙",
          "text": "琴团长，永远都那么可靠呀。"
        },
        {
          "role": "旅行者",
          "text": "琴平时一直很辛苦。"
        },
        {
          "role": "旅行者",
          "text": "这次，希望你也能好好休息。"
        },
        {
          "role": "琴",
          "text": "…旅行者…"
        },
        {
          "role": "琴",
          "text": "谢谢你。你能这么说，我非常开心。"
        },
        {
          "role": "琴",
          "text": "闲聊就到这里吧。亲爱的旅行者，愿我们都能在这片沙滩上找到片刻的快乐与安宁。"
        }
      ]
    }
  ]
}