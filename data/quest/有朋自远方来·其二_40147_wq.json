{
  "quest_id": 40147,
  "chapter_num": null,
  "chapter_title": "有朋自远方来·其二",
  "type": "wq",
  "route": "Receiver of Friends From Afar: Part II",
  "stories": [
    {
      "story_id": 40147,
      "title": "有朋自远方来·其二",
      "description": "经历了一天的忙碌，你和派蒙已然可以应付日常的后厨工作，除非有口味挑剔且要求严苛的客人上门…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至次日的6时至8时"
        },
        {
          "type": "subtitle",
          "text": "与言笑对话"
        },
        {
          "role": "言笑",
          "text": "早啊，旅行者！掌柜的跟我说了，上回来的新老顾客，对你的评价都非常好！"
        },
        {
          "role": "言笑",
          "text": "我之前还担心你适应不了呢，现在看起来以你的本事，日常工作是足够应付了。"
        },
        {
          "role": "言笑",
          "text": "除非来位口味又挑剔，要求又严苛的客人，否则还真难不倒你…"
        },
        {
          "role": "派蒙",
          "text": "哇，还会有这种客人吗？"
        },
        {
          "role": "言笑",
          "text": "那可不，尤其是那些菜没做几道，书读了一堆的老学究！"
        },
        {
          "role": "言笑",
          "text": "没事就来挑你哪里做的不合古法、哪里做的跟几百年前的老味道有区别…"
        },
        {
          "role": "？？？",
          "text": "——这里就是望舒客栈？也算是一家老字号了吧…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这声音是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珐露珊",
          "text": "店家！有什么招牌名菜，就快点招待上来吧！要最贵的！{{黑幕|甜妹wink☆}}"
        },
        {
          "role": "派蒙",
          "text": "珐露珊！…前！前辈好…"
        },
        {
          "role": "珐露珊",
          "text": "呀！旅行者，派蒙？你们怎么在这儿？"
        },
        {
          "role": "派蒙",
          "text": "我们还想问呢，你怎么突然就有经费来旅游了？还直接点了最贵的菜…"
        },
        {
          "role": "珐露珊",
          "text": "哼哼，这可不是旅游哦。像我这样的学者，受邀成为「随船顾问」满世界出差，也只是家常便饭而已…"
        },
        {
          "role": "莱依拉",
          "text": "珐露珊前辈…请…请慢一点…呼…明明昨晚大家都在熬夜，怎么就前辈还这么精神？她真有一百来岁了吗…"
        },
        {
          "role": "多莉",
          "text": "哈…哈…从我说要请客开始，她就一直这样了…真是失策…"
        },
        {
          "role": "派蒙",
          "text": "莱依拉！还有多莉？真是少见的组合…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "总之先歇一会儿吧…",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "你们招待三人入座，并说明了自己正在望舒客栈帮忙的事情…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "珐露珊",
          "text": "原来是这样…你还真是个大忙人呢。"
        },
        {
          "role": "珐露珊",
          "text": "不过既然连这里的主厨都认可你的话，也不用担心吃不上正宗的招牌菜了吧！"
        },
        {
          "role": "派蒙",
          "text": "所以你们又是为什么来璃月的啊？刚才好像听到了什么「随船顾问」…"
        },
        {
          "role": "多莉",
          "text": "嚯嚯，我前阵子从枫丹弄了一条新船，上面装了最先进的导航机关！如果能推广出去，那可是大大的商机！"
        },
        {
          "role": "多莉",
          "text": "最近几天正在试行呢：从奥摩斯港到离岛，从离岛到璃月港，后面还打算去荆夫港…"
        },
        {
          "role": "莱依拉",
          "text": "我跟前辈就是受雇来帮忙调试罗盘、调整机关的。昨晚为了压力测试，还在云来海上漂了一整夜…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是非法加班吗…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "多莉",
          "text": "会…会有加班补贴的！两位也都是自愿的，签合同的时候特意提过的！"
        },
        {
          "role": "派蒙",
          "text": "你还真是滴水不漏…所以「请客」也算是补贴之一吗？难怪一上来就点贵的。"
        },
        {
          "role": "珐露珊",
          "text": "哼哼，「想吃什么就吃什么！」——这种机会可不多见！那就先来一份…"
        },
        {
          "role": "多莉",
          "text": "咳！珐露珊…前辈，我当然也很想用最~贵的菜慰劳你们啦，但贵，不一定就是好嘛！"
        },
        {
          "role": "多莉",
          "text": "我听说璃月菜里最贵的几样，不是要用很多海鲜，就是要费很长的功夫…"
        },
        {
          "role": "多莉",
          "text": "可是我们都在海上晃了这么多天，再吃什么鱼啊虾啊，也尝不出好味道来吧？"
        },
        {
          "role": "珐露珊",
          "text": "呃，你这么一说，还真是这样…"
        },
        {
          "role": "多莉",
          "text": "——而且莱依拉小姐，看着都快饿晕了！"
        },
        {
          "role": "莱依拉",
          "text": "欸？我不是因为饿…"
        },
        {
          "role": "多莉",
          "text": "…想必年高德劭的珐露珊前辈，一定不忍心让后辈继续饿着肚子等吧！"
        },
        {
          "role": "珐露珊",
          "text": "唔，要照顾后辈的话，我是没意见…不过怎么总觉得上套了…"
        },
        {
          "role": "多莉",
          "text": "所以，需要花大把时间来熬的菜也别上了！除此以外，有什么贵就上什么吧。交给你咯，旅行者！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（须弥三人）"
        },
        {
          "role": "多莉",
          "text": "不要海鲜、不要费时。别的就都交给你啦，嘿嘿！"
        },
        {
          "role": "珐露珊",
          "text": "唔…仙跳墙腌笃鲜金丝虾球黄金蟹…都只能下次再试了吗？下次还得等多少年呢…"
        },
        {
          "role": "莱依拉",
          "text": "珐露珊前辈一下子变得好消沉…旅行者，能麻烦你尽量选贵点的菜吗？"
        },
        {
          "type": "subtitle",
          "text": "与言笑对话"
        },
        {
          "role": "言笑",
          "text": "…既要贵，又不能见海鲜，还不能花时间…这大半的老菜就都被排除了吧？究竟是谁提的要求，居然这么刁钻？"
        },
        {
          "role": "派蒙",
          "text": "多莉这家伙！该不会是故意的吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "估计就是故意的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "言笑",
          "text": "我们客栈跟琉璃亭、新月轩也不一样，不会常备什么名贵的食材，一般都是有客人预定才会去准备。"
        },
        {
          "role": "言笑",
          "text": "要用寻常食材，在短时间内做一道货真价实的高价菜…那贵的就只能是厨师的「功夫」跟菜肴的「创意」了。"
        },
        {
          "role": "言笑",
          "text": "旅行者，我知道一道叫做「繁弦急管」的菜，用现成的食材就能做，出菜也不费时，一盘售价…三万摩拉！"
        },
        {
          "role": "派蒙",
          "text": "——三万！不是说用料普通，也不费时间吗？为什么会那么贵？"
        },
        {
          "role": "言笑",
          "text": "这道菜的「功夫」不在于时间，而在于厨师对刀工跟火候的把控。"
        },
        {
          "role": "言笑",
          "text": "要用多种不同的肉类切作细丝，揉制成条，最后再下锅煎炒，主打口味多变，层层递进。"
        },
        {
          "role": "言笑",
          "text": "如何令几种不同的肉凝而不散，一起达到各自合适的熟度，味道又不相互冲突，才是这道菜真正可贵的地方！"
        },
        {
          "role": "言笑",
          "text": "做好了，就是一等一的名菜；做糟了，可就成一盘肉末了。"
        },
        {
          "role": "派蒙",
          "text": "哦——我懂了，所以这道菜贵的不是菜，而是你的出场费啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说得我都不太自信了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "言笑",
          "text": "没事，揉条之类的琐碎工序，我可以帮你搞定。你专心对付最紧要的环节就好。"
        },
        {
          "role": "派蒙",
          "text": "放心大胆地去试吧，就算做糟了，你做的肉末我也喜欢吃！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（言笑）"
        },
        {
          "role": "言笑",
          "text": "据说当年曾有高人可以调和整整五种肉类，而我这道菜才只用到三种，实在惭愧。"
        },
        {
          "type": "subtitle",
          "text": "烹制「繁弦急管」"
        },
        {
          "type": "subtitle",
          "text": "繁弦急管"
        },
        {
          "type": "subtitle",
          "text": "◆'所需食材'：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "◆'菜肴简述'：",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "口味多变，层层递进的复合型美食，以多种肉类的肉丝揉制煎炒而成。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "此菜虽然用料简单，但因其创意独特，制作繁复，故而成为了不可多得的珍馐，适合追求极致佳味的老饕品鉴。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "据说在璃月有着「琴有五弦，笛有七窍」的说法，因此在传说中「繁弦急管」这道菜也是用五种肉类与七种辅菜制成。只不过，估计现今没有厨师可以烹制出如传说中那么复杂的菜式了…",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "为等待已久的须弥一行人上菜"
        },
        {
          "role": "派蒙",
          "text": "菜来咯！各位慢用——"
        },
        {
          "role": "珐露珊",
          "text": "哦哦，闻着很香呀！"
        },
        {
          "role": "多莉",
          "text": "…啊，对了对了，派蒙跟旅行者也没吃早餐吧，干脆一块坐下？"
        },
        {
          "role": "派蒙",
          "text": "咦，多莉什么时候这么好心了…居然会有免费的早餐…"
        },
        {
          "role": "多莉",
          "text": "嚯嚯，大生意都是在宴席上谈成的嘛…来来来坐坐坐！大家都不用客气！"
        },
        {
          "role": "多莉",
          "text": "（这道菜看起来平平无奇，我又事先做过调查，应该不会花很多摩拉吧！不怕一万，就怕三万…）"
        },
        {
          "role": "珐露珊",
          "text": "（这道菜，能抵得过一晚上的熬夜吗？…能不能吃回本，可就看你了啊，旅行者！）"
        },
        {
          "role": "莱依拉",
          "text": "（好累…好困…好想睡…快点吃完回去睡…）"
        },
        {
          "type": "subtitle",
          "text": "几人各怀心事，各自动筷…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "莱依拉",
          "text": "这是…鸡腿肉？不对，又好像是蕈猪的口感…"
        },
        {
          "role": "珐露珊",
          "text": "每嚼一口都是不同的滋味…仔细尝起来，还有点烟熏的风味…真是不可思议，到底是怎么做出来的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是火腿，我加了火腿。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珐露珊",
          "text": "火腿？可是这盘菜里哪里有——啊！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，已经有人发现了？没错，每根肉条都是用不同的肉丝揉成的！费了我跟言笑好大的劲呢！"
        },
        {
          "role": "莱依拉",
          "text": "可是，虽然我也不太清楚…不同的肉类，熟透的时间应该也不一样吧？可这道菜搭配得却很和谐…"
        },
        {
          "role": "派蒙",
          "text": "呃…呃…这就是旅行者的商业机密了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没别的，只是熟练了。",
              "dialogues": []
            },
            {
              "text": "我有独特的烹饪手法。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "珐露珊",
          "text": "没想到这还是你的独门菜式呢，算是没白来一趟。对了，这道菜有名字吗？"
        },
        {
          "role": "派蒙",
          "text": "啊，我都忘了介绍了，这道菜的名字叫「繁弦急管」——既是在描述丝条交错的外观，也是在…"
        },
        {
          "role": "珐露珊",
          "text": "…描述复杂多变的口感？是从璃月的俗语里起的吧？"
        },
        {
          "role": "珐露珊",
          "text": "原意应该是多种乐器同时演奏，热闹纷呈…嗯，放到这里也算贴切。"
        },
        {
          "role": "派蒙",
          "text": "欸…原来你知道啊…"
        },
        {
          "role": "珐露珊",
          "text": "每个年轻人在毕业前都该学会至少二十种语言吧。咦…难道现在没这要求了？"
        },
        {
          "role": "莱依拉",
          "text": "——欸？以前有过的吗！"
        },
        {
          "role": "派蒙",
          "text": "差点忘了你也是知论派的…"
        },
        {
          "role": "多莉",
          "text": "那…那个…这道菜的价格是…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿——不多不多，承惠摩拉三万！"
        },
        {
          "role": "多莉",
          "text": "三…三万！哈…哈哈…"
        },
        {
          "role": "多莉",
          "text": "话说回来…派蒙、旅行者，我之前是让你们「一块坐下」…没说要连你们一起请客吧？"
        },
        {
          "role": "多莉",
          "text": "…所以这是不是得算…拼桌？"
        },
        {
          "role": "派蒙",
          "text": "——果然没有免费的早餐啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "三万而已，对你来说不算破费吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "就是就是！商人要重信誉！"
                },
                {
                  "role": "多莉",
                  "text": "呜…一枚摩拉也是钱啊！"
                }
              ]
            },
            {
              "text": "打八折吧，回头我跟掌柜说一声。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "你啊…行吧，反正贵的也是你的出场费。"
                },
                {
                  "role": "多莉",
                  "text": "三万打八折…呜，还是有点心疼…"
                }
              ]
            }
          ]
        },
        {
          "role": "多莉",
          "text": "唉，成吧…就当作交学费了。"
        },
        {
          "role": "多莉",
          "text": "…等回了须弥，我一定要请人把这菜复现出来，再狠狠地赚一笔！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（莱依拉）"
        },
        {
          "role": "莱依拉",
          "text": "吃完饭感觉精神多了，好吃的东西确实可以提神呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没想到你会接这么费神的委托…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "莱依拉",
          "text": "哈哈…导师说，年轻人不该一直埋在论文和书本里，让我抓住机会出来，看看各地的星空。"
        },
        {
          "role": "莱依拉",
          "text": "嗯…就当作「提前实习」了？不过还真是累人啊…呼…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（多莉）"
        },
        {
          "role": "多莉",
          "text": "该怎么把便宜的食材做成高价的菜呢…先从起一个好名字开始吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "话说你一开始提的条件…",
              "dialogues": []
            },
            {
              "text": "还有选择望舒客栈的原因…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "多莉",
          "text": "啊…哈哈——果然被你发现了。"
        },
        {
          "role": "多莉",
          "text": "唉，昨晚答应下来的时候，看大家又熬夜又晕船，我就想着第二天也吃不了多少…结果嘛，你也看见了。"
        },
        {
          "role": "多莉",
          "text": "后来又加了那么多限制，没想到照样难不倒你！唉，不事先做好市场调查，就是会变成这样啦。"
        },
        {
          "role": "派蒙",
