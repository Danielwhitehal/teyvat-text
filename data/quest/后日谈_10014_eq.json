{
  "quest_id": 10014,
  "chapter_num": "白垩与黑龙 第五幕",
  "chapter_title": "后日谈",
  "type": "eq",
  "route": "Afterword",
  "stories": [
    {
      "story_id": 41214,
      "title": "后日谈",
      "description": "",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "经过漫长战斗，最终完成「成长」的剑有了新去处。",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "寻找阿贝多"
        },
        {
          "type": "subtitle",
          "text": "与阿贝多对话"
        },
        {
          "role": "派蒙",
          "text": "又来了哦！又是我们哦！"
        },
        {
          "role": "阿贝多",
          "text": "旅行者，派蒙。你们来了。"
        },
        {
          "role": "派蒙",
          "text": "已经习惯像这样和阿贝多见面了呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我完成你的委托了。",
              "dialogues": []
            },
            {
              "text": "答应你的事，我都做完了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "非常感谢，找你果然是正确的选择。"
        },
        {
          "role": "旅行者",
          "text": "帮上你的忙了吗？"
        },
        {
          "role": "阿贝多",
          "text": "当然，你对我的研究工作给予了极大帮助。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，你知道就好~"
        },
        {
          "role": "阿贝多",
          "text": "这份恩情我会牢记在心。"
        },
        {
          "role": "旅行者",
          "text": "这把剑还给你。"
        },
        {
          "role": "派蒙",
          "text": "应该足够强了吧？"
        },
        {
          "role": "阿贝多",
          "text": "差不多了。你身体感觉如何？"
        },
        {
          "role": "旅行者",
          "text": "和平时一样。"
        },
        {
          "role": "阿贝多",
          "text": "那就行，没有副作用，也没有污染和毒。"
        },
        {
          "role": "阿贝多",
          "text": "看来…我的认知是正确的。"
        },
        {
          "role": "派蒙",
          "text": "摆出了一副料事如神的表情呢，这家伙！"
        },
        {
          "role": "阿贝多",
          "text": "剑好用吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好用。",
              "dialogues": []
            },
            {
              "text": "不好用。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "是吗。不管怎么说，它也达到了我想要的状态"
        },
        {
          "role": "派蒙",
          "text": "把剑拿起来了…阿贝多，你要用它吗？你、你不要做傻事啊！"
        },
        {
          "role": "阿贝多",
          "text": "我要把被你净化过的纯粹生命之力提取出来。"
        },
        {
          "role": "派蒙",
          "text": "力量也能单独存在吗？"
        },
        {
          "role": "阿贝多",
          "text": "或许别人做不到，但我可以。"
        },
        {
          "role": "阿贝多",
          "text": "…好了。"
        },
        {
          "role": "派蒙",
          "text": "哇，这种力量，好像一个光球…"
        },
        {
          "role": "派蒙",
          "text": "啊！放到神秘的瓶子里了！"
        },
        {
          "role": "阿贝多",
          "text": "虽然这把剑算不上神兵利器…"
        },
        {
          "role": "阿贝多",
          "text": "做个纪念吧。希望以后它也能在旅途中帮助你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真的可以吗？",
              "dialogues": []
            },
            {
              "text": "你不需要它了吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "阿贝多",
          "text": "我要的是与它有关的实验结果，现在我得到了我要的东西，剑应该留给擅长使用它的你。"
        },
        {
          "role": "阿贝多",
          "text": "旅行者，谢谢你帮我完成这次研究。那么，再见了。"
        },
        {
          "role": "阿贝多",
          "text": "能与我发生共鸣的，龙的生命之力…"
        },
        {
          "role": "阿贝多",
          "text": "并非因为它是龙，而是因为我的缘故。"
        },
        {
          "role": "阿贝多",
          "text": "莱茵多特…师父…这就是你曾经创造的巨龙「杜林」吗？"
        },
        {
          "role": "阿贝多",
          "text": "……"
        },
        {
          "role": "阿贝多",
          "text": "我与它的相会，真的是一件好事吗？"
        }
      ]
    }
  ]
}