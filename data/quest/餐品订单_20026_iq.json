{
  "quest_id": 20026,
  "chapter_num": null,
  "chapter_title": "餐品订单",
  "type": "iq",
  "route": "Food Delivery",
  "stories": [
    {
      "story_id": 20026,
      "title": "餐品订单",
      "description": "为了满足顾客的需要，猎鹿人餐馆持续提供着送餐服务。但是因为顾客众多，餐馆里的人手严重不足，莎拉小姐想要找一个人来帮忙送餐。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往猎鹿人餐馆询问莎拉"
        },
        {
          "type": "subtitle",
          "text": "与莎拉对话"
        },
        {
          "role": "莎拉",
          "text": "餐品外送订单"
        },
        {
          "role": "莎拉",
          "text": "旅行者，你来的正好——"
        },
        {
          "role": "莎拉",
          "text": "咦？你说你只是来吃东西的…"
        },
        {
          "role": "莎拉",
          "text": "我，我知道了，但是请你帮我个忙吧，我一定会把最好吃的料理给你！"
        },
        {
          "role": "莎拉",
          "text": "晨曦酒庄的恩内斯特先生经常在我们这里订下酒菜，而且总是会提出各种奇怪的加料要求。"
        },
        {
          "role": "莎拉",
          "text": "嗯…这次他虽然订的是<color=#00E1FFFF>炸萝卜丸子</color>，但他一定要我们多加蛋类，可我们的蛋类料理材料都用光了。"
        },
        {
          "role": "莎拉",
          "text": "所以，请你帮我们找两颗鸟蛋回来吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好吧，但是…",
              "dialogues": [
                {
                  "role": "莎拉",
                  "text": "在风起地，应该可以找到很多鸟蛋。"
                },
                {
                  "role": "莎拉",
                  "text": "那么，就拜托你了！"
                }
              ]
            },
            {
              "text": "太饿了，我只是来吃饭的。",
              "dialogues": [
                {
                  "role": "莎拉",
                  "text": "在风起地，应该可以找到很多鸟蛋。"
                },
                {
                  "role": "莎拉",
                  "text": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "找到两颗鸟蛋"
        },
        {
          "type": "subtitle",
          "text": "取得制作好的餐品"
        },
        {
          "role": "旅行者",
          "text": "已经找好了。"
        },
        {
          "role": "莎拉",
          "text": "这下子材料就够了，稍等一下…"
        },
        {
          "role": "莎拉",
          "text": "好啦，拜托你把这份特制的<color=#00E1FFFF>炸萝卜丸子</color>送给恩内斯特先生吧。"
        },
        {
          "role": "莎拉",
          "text": "别这么看着我嘛，我知道你肚子很饿了。"
        },
        {
          "role": "莎拉",
          "text": "回来的时候，我会用猎鹿人餐馆特制料理来答谢你的！"
        },
        {
          "type": "subtitle",
          "text": "找到恩内斯特"
        },
        {
          "role": "恩内斯特",
          "text": "嗯——满溢的蛋香，和胡萝卜的味道完美搭配，果然我是个美食行家啊。"
        },
        {
          "type": "subtitle",
          "text": "把餐费交给莎拉"
        },
        {
          "role": "莎拉",
          "text": "交付餐费"
        },
        {
          "role": "莎拉",
          "text": "你回来了，餐品送到了吗？"
        },
        {
          "role": "旅行者",
          "text": "这是餐费。"
        },
        {
          "role": "莎拉",
          "text": "我看看…没错，太感谢了！"
        },
        {
          "role": "莎拉",
          "text": "还有，这份<color=#00E1FFFF>蟹黄火腿焗时蔬</color>给你，刚刚做好的，赶紧趁热吃了吧。"
        }
      ]
    }
  ]
}