{
  "quest_id": 73355,
  "chapter_num": null,
  "chapter_title": "重逢，蕈兽伙伴！",
  "type": "wq",
  "route": "Reunite, My Shroom Buddies!",
  "stories": [
    {
      "story_id": 73355,
      "title": "重逢，蕈兽伙伴！",
      "description": "有位朋友在冒险家协会留了言，邀请你和派蒙前往拜达港，参观她的新店铺…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "说起来，有人在冒险家协会留了言，请我们去拜达港参观新店铺…拜达港的新店铺？"
        },
        {
          "role": "派蒙",
          "text": "会是谁呢？我有种碰上了好事的预感…去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "前往拜达港"
        },
        {
          "role": "派蒙",
          "text": "咦，那边有只蕈兽飘过去了欸，没问题吗？"
        },
        {
          "role": "派蒙",
          "text": "一般来说，蕈兽在城区活动，还是有点危险的吧！除非是特别听话，受过训练的特例…"
        },
        {
          "role": "派蒙",
          "text": "不对呀，怎么好像有点熟悉，以前我们是不是经历过类似的情景。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "等等，是「咚咚小圆帽」吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对！「咚咚小圆帽」！我们在须弥结识的蕈兽伙伴！"
                }
              ]
            },
            {
              "text": "是什么特例来着？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好像是…「咚咚小圆帽」？我们在须弥结识的蕈兽伙伴！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！"
        },
        {
          "type": "subtitle",
          "text": "心声（海妮耶）"
        },
        {
          "role": "海妮耶",
          "text": "（待会儿一定要用最佳面貌迎接「黄金流星」和「白银伴星」…）"
        },
        {
          "type": "subtitle",
          "text": "心声（左右加）"
        },
        {
          "role": "左右加",
          "text": "（让人期待的重逢，快要上演啦！）"
        },
        {
          "type": "subtitle",
          "text": "与海妮耶对话"
        },
        {
          "role": "海妮耶",
          "text": "看来留言转达得很顺利。"
        },
        {
          "role": "海妮耶",
          "text": "终于又见面了，「黄金流星」和「白银伴星」。"
        },
        {
          "role": "海妮耶",
          "text": "你们容光焕发的模样，让我有种时间停滞的美好感觉。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "久违了，海妮耶！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "真的是你们啊，海妮耶和「咚咚小圆帽」！"
                },
                {
                  "role": "派蒙",
                  "text": "难怪看过留言，我就有种奇妙的熟悉感…说明我和「咚咚小圆帽」的默契还在！"
                }
              ]
            },
            {
              "text": "虽然不太记得了，但你们好。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "确实是海妮耶和「咚咚小圆帽」！我们好久之前在「月莲杯驯兽师大赛」认识的朋友！"
                },
                {
                  "role": "派蒙",
                  "text": "印象里，之后我们还在奥摩斯港附近，还有枫丹廷见过面！不知不觉，已经过去这么长时间了…"
                }
              ]
            }
          ]
        },
        {
          "role": "咚咚小圆帽",
          "text": "♪~"
        },
        {
          "role": "海妮耶",
          "text": "我设想过许多重逢的情景，比如举办丰盛的宴会，或是富有创意的欢迎仪式，给你们个巨大的惊喜。"
        },
        {
          "role": "海妮耶",
          "text": "但感觉都有些见外，考虑到你们一直很忙，说不定占用太长时间，反而会让你们觉得麻烦。"
        },
        {
          "role": "海妮耶",
          "text": "而且，现在的蕈兽伙伴们也喜欢宁静的环境，所以，就让我们以松弛自然的方式重逢吧。"
        },
        {
          "role": "左右加",
          "text": "没错没错，海妮耶读的散文派上用场啦，平静的心态对生活有益！"
        },
        {
          "role": "左右加",
          "text": "还是像这样，轻轻松松聊天最开心。"
        },
        {
          "role": "欢腾之火",
          "text": "♫~"
        },
        {
          "role": "派蒙",
          "text": "左右加小姐也在，还有「欢腾之火」和…这位是？"
        },
        {
          "role": "左右加",
          "text": "是我自己的蕈兽伙伴「信风舞姬」哦，当时在三十二强赛上，被你们和「咚咚小圆帽」一下就打败了！"
        },
        {
          "role": "派蒙",
          "text": "哎呀，还是你记得清楚！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "熟悉的感觉逐渐回来了…",
              "dialogues": []
            },
            {
              "text": "亲切的氛围让我放松下来了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "左右加",
          "text": "总之，两位大老板，就像你看到的这样，我们再也不用约定什么下次见面的时间和地点啦——"
        },
        {
          "role": "左右加",
          "text": "海妮耶和我已经买下了这片商区，将它改造成一直开设的「小小灵蕈乐园」！"
        },
        {
          "role": "派蒙",
          "text": "等等，你的意思是，现在这里的设施，不是为了新的桌上游戏租用的，而是…"
        },
        {
          "role": "海妮耶",
          "text": "没错，以后我们就会一直生活在拜达港，向人们推广蕈兽的桌上游戏，以及和动物们交流的理论。"
        },
        {
          "role": "海妮耶",
          "text": "只要你们有空，随时可以来这里找蕈兽伙伴们玩。"
        },
        {
          "role": "咚咚小圆帽",
          "text": "♪~"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好耶！蕈兽伙伴！",
              "dialogues": []
            },
            {
              "text": "以后可以经常见面啦！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "这这这，这是我今天听过最好的消息之一！"
        },
        {
          "role": "派蒙",
          "text": "第一次蕈兽大赛后，我就想过好多好多…和「咚咚小圆帽」一起玩的点子，这下可以慢慢做到啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说起来，这里的花销不低吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "左右加",
          "text": "放心啦，摩拉目前不是问题！"
        },
        {
          "role": "海妮耶",
          "text": "这段时间，除了在[[贝尔福]]先生的帮助下运营「灵蕈棋阵」和「小小灵蕈大幻戏」这款桌上游戏，挣取资金…"
        },
        {
          "role": "海妮耶",
          "text": "我们还总结了以往的经验，将驯兽和蕈兽的许多知识总结成系统的理论，试着刊印了一些书籍。"
        },
        {
          "role": "海妮耶",
          "text": "甚至，有些学者也因此给了我资金资助。"
        },
        {
          "role": "海妮耶",
          "text": "用我积累的学问为更多人提供便捷，换取摩拉，让蕈兽伙伴们过得更好，一切都进入了正向的循环。"
        },
        {
          "role": "派蒙",
          "text": "有，有点厉害！"
        },
        {
          "role": "派蒙",
          "text": "感觉海妮耶已经变成了稳重的…「驯兽理论专家」，能把一切问题统统搞定！"
        },
        {
          "role": "海妮耶",
          "text": "多亏左右加引导得好，她让我按学生们的方法，挑战了自己应该学会的技能。"
        },
        {
          "role": "左右加",
          "text": "喂喂！这种谦虚倒是别学啊，我可不是什么超级老师，夸你就好好接着！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "说得轻松，其实有过困难吧？",
              "dialogues": []
            },
            {
              "text": "感觉略过了很多吃苦的部分…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海妮耶",
          "text": "确实也遇上过许多难题，但过去的、不好的事情，就让它们随时间走远吧。"
        },
        {
          "role": "海妮耶",
          "text": "我最大的遗憾是——这一年来，没怎么带蕈兽伙伴们好好在外游玩，"
        },
        {
          "role": "海妮耶",
          "text": "从我开始归纳自己的驯兽理论开始，大多时间，我们都在洞窟和树屋里，过着昼夜混乱的写稿生活。"
        },
        {
          "role": "海妮耶",
          "text": "商务生活太累人，赶稿的日子也真是难熬，我更理解左右加的一些想法了。"
        },
        {
          "role": "左右加",
          "text": "倒也不全是负面反馈嘛！写完稿子的一瞬间，还是非常有满足感的！"
        },
        {
          "role": "海妮耶",
          "text": "嗯，我同意，每次完稿都值得吃一顿放纵餐来庆祝。"
        },
        {
          "role": "海妮耶",
          "text": "可是，蕈兽伙伴们也享受不了我们的食物，或许在它们看来，生活变得越来越枯燥了。"
        },
        {
          "role": "海妮耶",
          "text": "长期如此，伙伴们的精神状况也会变差，很不妙。"
        },
        {
          "role": "派蒙",
          "text": "那，既然现在你们的状况稳定下来了，也有了固定的住所…"
        },
        {
          "role": "派蒙",
          "text": "其实可以由我们两个带着蕈兽伙伴们出去玩玩，玩到尽兴就送它们回来。"
        },
        {
          "role": "派蒙",
          "text": "这样，你们就可以忙手头的工作，蕈兽伙伴们也能好好玩乐！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙这个主意好！",
              "dialogues": []
            },
            {
              "text": "我也想带蕈兽伙伴去玩！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "左右加",
          "text": "我支持！"
        },
        {
          "role": "左右加",
          "text": "谈到赏玩的地点，我是纯粹的理论派，只能从书上找去处。第一次到枫丹的时候，其实还闹过迷路的笑话…"
        },
        {
          "role": "左右加",
          "text": "海妮耶更是个呆瓜，连须弥有哪些好玩的地方都不知道，以前光顾着工作去了！"
        },
        {
          "role": "左右加",
          "text": "上次在枫丹待了那么久，行程规划也不到位，最后连想去的甜品店都没去成，错过了好奇好久的马卡龙…"
        },
        {
          "role": "海妮耶",
          "text": "咳咳…换成「黄金流星」和「白银伴星」的话，肯定可以找到各种好地方，让蕈兽伙伴们大开眼界，畅玩一番。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那我确实要好好物色地点！",
              "dialogues": []
            },
            {
              "text": "我会选出好玩又好看的地方！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "海妮耶",
          "text": "稍等啊，请带上这个小留影机…"
        },
        {
          "type": "subtitle",
          "text": "海妮耶取出一部平平无奇的留影机，将其放在了「咚咚小圆帽」的头上，「咚咚小圆帽」居然能稳稳顶着留影机，似乎已经习惯了托举这种东西飞行…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "海妮耶",
          "text": "虽然外观很普通，但这是一件特别的纪念品——"
        },
        {
          "role": "海妮耶",
          "text": "「咚咚小圆帽」曾在水天丛林南部救下一位迷路商人的孩子，商人送了「咚咚小圆帽」许多谢礼，其中一件就是这部留影机。"
        },
        {
          "role": "海妮耶",
          "text": "「咚咚小圆帽」很喜欢这个留影机拍摄的画片，这次去玩时，也可以用它来留念。"
        },
        {
          "role": "海妮耶",
          "text": "我找到了器材专家伊莲小姐，密封了留影机的外壳，使得它能在「咚咚小圆帽」喜欢的潮湿环境…甚至是水下工作。"
        },
        {
          "role": "派蒙",
          "text": "也就是说，这个留影机也是「咚咚小圆帽」的荣誉象征之一了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "咚咚小圆帽，棒！",
              "dialogues": []
            },
            {
              "text": "干得漂亮，小圆帽！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "咚咚小圆帽",
          "text": "♪~"
        },
        {
          "role": "派蒙",
          "text": "至于留影的问题，放心放心，我和旅行者也是专家！设备的外观不要紧，拍得好就行！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们准备准备，然后就出发吧？"
        },
        {
          "role": "派蒙",
          "text": "除了行李，还有蕈兽伙伴们特别的食物…"
        },
        {
          "role": "海妮耶",
          "text": "没错，这一点派蒙也记得很清楚，请带上足够的「妙妙琼脂」。"
        },
        {
          "role": "海妮耶",
          "text": "最新改良版的版本有着更美味的口感，还很耐储存，无论在多炎热的环境下，都不用担心变质。"
        },
        {
          "role": "左右加",
          "text": "小心，不要一次给伙伴们吃太多哦，暴饮暴食可不好！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，都记住啦，琼脂要收进小背包…"
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（海妮耶）"
        },
        {
          "role": "海妮耶",
          "text": "接下来，我会好好处理「小小灵蕈乐园」的后续事务，你们就带着蕈兽伙伴尽情去玩耍吧。"
        },
        {
          "type": "subtitle",
          "text": "心声：（总算又见到了「黄金流星」和「白银伴星」…这种前所未有的鼓舞感… 更有动力了！）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "额外对话&心声（左右加&信风舞姬）"
        },
        {
          "role": "左右加",
          "text": "好啦，「信风舞姬」，今天下午我们要把拜达港的主要街道和码头栈桥打扫干净！"
        },
        {
          "role": "左右加",
          "text": "这是我们两个现在最轻松、最稳定的差事了，一天能赚够十份「妙妙琼脂」的钱哦，我们都要加油！"
        },
        {
          "role": "信风舞姬",
          "text": "！"
        },
        {
          "type": "subtitle",
          "text": "心声：（刚刚经历了令人感动的重逢桥段…有的小说可能会写得声泪俱下？但像这样自然、从容一点，不是更好嘛！）",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "前往游览地点"
        },
        {
          "role": "派蒙",
          "text": "我想到几个不错的地方，对蕈兽伙伴们来说，一定很新奇！"
        },
        {
          "role": "派蒙",
          "text": "虽然有点远，但长途旅行也别有一番风味嘛…就从纳塔开始吧？"
        },
        {
          "role": "派蒙",
          "text": "呼啊…总算到了！"
        },
        {
          "role": "派蒙",
          "text": "虽然路途非常遥远，但我觉得，「悬木人」这边超有特色的彩石顶，对蕈兽伙伴们来说，肯定无比新奇！"
        },
        {
          "role": "派蒙",
          "text": "我这里有几张风景画，可以让蕈兽伙伴们对比图画和眼前的景象…"
        },
        {
          "role": "派蒙",
          "text": "如果伙伴们仔细观察，把两者对上号后，慢慢注意到不起眼的细节，对这里感兴趣…就说明这里适合我们深度游玩！"
        },
        {
          "role": "咚咚小圆帽",
          "text": "♪♫！"
        },
        {
          "role": "欢腾之火",
          "text": "♫…♩？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "还有这种办法？",
              "dialogues": []
            },
            {
              "text": "派蒙很懂嘛！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我闲下来没事的时候，也会翻看导览图册，观察一些游览胜地。"
        },
        {
          "role": "派蒙",
          "text": "这可是好向导的必修课！"
        },
        {
          "role": "派蒙",
          "text": "好啦，让蕈兽伙伴也试试看吧？"
        }
      ],
      "collapse_ranges": [
        [
          8,
          9
        ],
        [
          10,
          11
        ],
        [
          82,
          84
        ],
        [
          85,
          89
        ]
      ]
    }
  ]
}