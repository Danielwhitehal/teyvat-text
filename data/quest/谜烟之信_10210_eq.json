{
  "quest_id": 10210,
  "chapter_num": "暝视寻灵织卷·上",
  "chapter_title": "谜烟之信",
  "type": "eq",
  "route": "Night-Wind Letter",
  "stories": [
    {
      "story_id": 40171,
      "title": "谜烟之信",
      "description": "收到了一封来自烟谜主的求救信，署名是欧洛伦，发生什么事了呢…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "来自欧洛伦的求援信"
        },
        {
          "role": "欧洛伦",
          "text": "旅行者，冒昧来信，请见谅。实在是遇上了棘手的事，非你帮忙不可。"
        },
        {
          "role": "欧洛伦",
          "text": "若你恰好有时间，有心情，又不介意抬抬小腿、走两步远路，就请来烟谜主一趟。"
        },
        {
          "role": "欧洛伦",
          "text": "我相信只要你出现，一切就会好起来。"
        },
        {
          "role": "欧洛伦",
          "text": "拜托了。"
        },
        {
          "type": "subtitle",
          "text": "前往欧洛伦处"
        },
        {
          "role": "欧洛伦",
          "text": "只要旅行者出现，一切就会好起来…"
        },
        {
          "role": "派蒙",
          "text": "嘿！欧洛伦，这边！"
        },
        {
          "role": "欧洛伦",
          "text": "啊，旅行者，派蒙。你们好。"
        },
        {
          "role": "派蒙",
          "text": "听说你有事找我们，所以就立刻过来啦。"
        },
        {
          "role": "欧洛伦",
          "text": "原来是这样…让我心里很温暖，这就是幸福的感觉吗？"
        },
        {
          "role": "派蒙",
          "text": "噫！干嘛突然说这种话…"
        },
        {
          "role": "欧洛伦",
          "text": "你们是真正的好朋友。如果我家的蔬菜见到你们，一定也会长得更茂盛。"
        },
        {
          "role": "派蒙",
          "text": "那又是什么原理啊？"
        },
        {
          "role": "欧洛伦",
          "text": "是夸奖，听说夸奖别人会让人快乐。你快乐了吗？"
        },
        {
          "role": "旅行者",
          "text": "谢谢。但你好像不是很快乐？"
        },
        {
          "role": "欧洛伦",
          "text": "被你发现了。确实，我现在就跟产蜜困难的蜜虫一样烦恼。奶奶堵住了我的前路。"
        },
        {
          "role": "旅行者",
          "text": "茜特菈莉？"
        },
        {
          "role": "欧洛伦",
          "text": "是的，你们知道，奶奶是个天才，天才总会堵住别人的路，让别人绝望。"
        },
        {
          "role": "欧洛伦",
          "text": "而我又是她的孙子，她让别人有多绝望，在我这个孙子身上都是要加倍的…"
        },
        {
          "role": "欧洛伦",
          "text": "应该说得很严重了吧，嗯，所以，请你们帮忙搞定奶奶。"
        },
        {
          "role": "派蒙",
          "text": "你经历了什么哦？说得这么严重，到底是怎么回事…"
        },
        {
          "role": "欧洛伦",
          "text": "我需要拉拢你们，毕竟，能搞定奶奶的人…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text":  "那个人就是我。",
              "dialogues": [
                {
          "role": "欧洛伦",
          "text": "没错，我也是第一个就想到了爷爷你。"
        }
              ]
            },
            {
              "text": "哈哈，不可能是我吧？",
              "dialogues": [
                {
          "role": "欧洛伦",
          "text": "就是你，我第一个就想到了爷爷你。"
        }
              ]
            }      
          ]
        },
        
        {
          "role": "欧洛伦",
          "text": "爷爷，最开始见面的时候，我就是这么叫你的。虽然被批评了，但请允许我再叫一次。"
        },
        {
          "role": "欧洛伦",
          "text": "你给人的感觉不太一样，茜特菈莉奶奶对你的态度也不一样。后来的事情也证明了这两点。"
        },
        {
          "role": "欧洛伦",
          "text": "我想，如果翻开名为「搞定茜特菈莉的四十人」的织卷，排在首位的就会是旅行者。"
        },
        {
          "role": "派蒙",
          "text": "那后面不是还有三十九个吗？"
        },
        {
          "role": "欧洛伦",
          "text": "后面的也是旅行者，三十九个旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
             {
              "text":  "就算你这么说，我也还不想认孙子。",
              "dialogues": [
                {
          "role": "欧洛伦",
          "text": "拜托了，请帮帮我，真的很重要。"
        }
              ]
            },
            {
              "text":  "乖孙，爷爷我啊，已经心花怒放了。",
              "dialogues": [
                {
          "role": "欧洛伦",
          "text": "好的，那爷爷你一定愿意帮忙了吧？这真的很重要。"
        }
              ]
            }
          ]
        },
        
        {
          "role": "欧洛伦",
          "text": "我只是看上去无所事事，其实在为前路感到烦恼，奶奶她成了拦路虎，让我无路可走。"
        },
        {
          "role": "欧洛伦",
          "text": "但现在你们到了，就可以开始行动起来了，时间不会一直等着我。"
        },
        {
          "role": "旅行者",
          "text": "那我要怎么帮你？"
        },
        {
          "role": "欧洛伦",
          "text": "你肯定知道奶奶喜欢看轻小说，喝闷酒，睡大觉，如果是你，一定可以对症下药，把她引走。"
        },
        {
          "role": "派蒙",
          "text": "所以就是让我们像钓鱼那样钓走茜特菈莉，这样她就没空管你了？"
        },
        {
          "role": "欧洛伦",
          "text": "是的。我当然没有闲着，去做了不少功课，说辞我也准备了一些。你们可以走到奶奶面前说："
        },
        {
          "role": "欧洛伦",
          "text": "「亲爱的奶奶，我有一本《蜃楼战记》最新卷，还有一本《奥西兹小姐事件簿》特别番外，要来一起看看吗？」"
        },
        {
          "role": "欧洛伦",
          "text": "她就会假矜持几句，然后马上给自己找台阶下，满口答应。旅行者，如果是你抛出的诱饵，奶奶一定会上钩。"
        },
        {
          "role": "旅行者",
          "text": "可我真的有这种功效？"
        },
        {
          "role": "派蒙",
          "text": "是场面话啦！连我都听出来了，欧洛伦说的都是好听的场面话。"
        },
        {
          "role": "欧洛伦",
          "text": "不对。奶奶嘴上不说而已，我能看得出来，她正在关注旅行者。"
        },
        {
          "role": "派蒙",
          "text": "好吧…虽然我还是觉得欧洛伦在病急乱投医，但如果只是和茜特菈莉说几句话什么的，倒也不费劲。"
        },
        {
          "role": "欧洛伦",
          "text": "简直就像给蔬菜浇水一样轻松，如果我家的蔬菜在这里…啊…抱歉，没时间再讲蔬菜了…"
        },
        {
          "role": "欧洛伦",
          "text": "请相信我，跟我来一趟吧，只要旅行者出现，一切就会好起来。"
        },
         {
          "type": "subtitle",
          "text": "前往欧洛伦指出的位置"
        },
        {
          "role": "欧洛伦",
          "text": "好爷爷！拜托了，请你们先进去看看吧？"
        },
        {
          "role": "欧洛伦",
          "text": "咦？"
        },
        {
          "role": "派蒙",
          "text": "怎么了？"
        },
        {
          "role": "欧洛伦",
          "text": "奶奶…居然不见了…"
        },
        {
          "role": "欧洛伦",
          "text": "她原本就站在那个洞口，防止我进去。我的前路就是这样被阻断的。"
        },
        {
          "role": "派蒙",
          "text": "原来是字面意义上的拦路虎啊！我还以为这也是比喻呢。"
        },
        {
          "role": "欧洛伦",
          "text": "奶奶说，一个段落比喻两次的轻小说是二流。我不想变成二流。"
        },
        {
          "role": "派蒙",
          "text": "喂，你把自己比成轻小说了吧？这是第二次比喻了吧？"
        },
        {
          "role": "欧洛伦",
          "text": "什么？糟糕…"
        },
        {
          "role": "旅行者",
          "text": "总之，现在欧洛伦应该畅行无阻了。"
        },
        {
          "role": "派蒙",
          "text": "对哦，看来茜特菈莉已经想通了。欧洛伦，不管想干什么，你都可以大展身手啦。"
        },
        {
          "role": "欧洛伦",
          "text": "我觉得没那么简单…奶奶不会这么轻易放弃抓我的。"
        },
        {
          "role": "欧洛伦",
          "text": "也许我一走进去洞里，就会被奶奶的监视法术发现，又或者踩中她留下的陷阱…"
        },
        {
          "role": "旅行者",
          "text": "可她干嘛要抓你呢？"
        },
        {
          "role": "派蒙",
          "text": "是啊，甚至还布置了陷阱！不会你又像之前那样…干了什么引人怀疑的事吧？"
        },
        {
          "role": "欧洛伦",
          "text": "我只是想救人而已…是奶奶不让。"
        },
        {
          "role": "派蒙",
          "text": "救、救人？！谁出事了？"
        },
        {
          "role": "欧洛伦",
          "text": "能请你们先去洞里面看看吗？虽然现在应该还安全，但是拖得越久，有危险的人就会越有危险。"
        },
        {
          "role": "派蒙",
          "text": "那你怎么办？"
        },
        {
          "role": "欧洛伦",
          "text": "我只能先在门口等一会，以防自投奶奶的罗网。"
        },
        {
          "role": "派蒙",
          "text": "可如果有陷阱的话，踩中的人岂不就是我们了？"
        },
        {
          "role": "欧洛伦",
          "text": "不会有事的，奶奶的陷阱认得旅行者，不会把你们怎么样的。"
        },
        {
          "role": "旅行者",
          "text": "有这回事？"
        },
        {
          "role": "欧洛伦",
          "text": "嗯，我跟我家的蜜虫讲过你的丰功伟绩，奶奶应该也跟她的陷阱讲过。"
        },
        {
          "role": "派蒙",
          "text": "不要以为所有人都像你啊！"
        },
        {
          "role": "欧洛伦",
          "text": "总而言之，拜托了，好爷爷。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，既然事关人命，我们还是先进去看看吧！"
        },
         
        {
          "type": "subtitle",
          "text": "额外对话（欧洛伦）"
        },
        {
          "role": "欧洛伦",
          "text": "好爷爷！拜托了，请你们先进去看看吧？"
        },

        {
          "type": "subtitle",
          "text": "进入山洞内查看情况"
        },
        {
          "role": "派蒙",
          "text": "呼~顺利地走进来了，什么都没发生。也许茜特菈莉的陷阱真的认识我们！"
        },
        {
          "role": "派蒙",
          "text": "呜哇！快看！那里有个人！"
        },
        {
          "role": "派蒙",
          "text": "嗨！你还好吗？喂！听得见我们说话吗？"
        },
        {
          "role": "旅行者",
          "text": "似乎没反应。"
        },
        {
          "role": "派蒙",
          "text": "睡着了吗？还是生病了…会不会这就是欧洛伦说要救的人？"
        },
        {
          "role": "派蒙",
          "text": "这个营地也是神神秘秘的，是干什么的？"
        },
        {
          "role": "旅行者",
          "text": "像是什么仪式。"
        },
        {
          "role": "派蒙",
          "text": "唔…我们去叫欧洛伦进来吧，他肯定知道这是什么。"
        },
        {
          "role": "欧洛伦",
          "text": "对不起，奶奶。"
        },
        {
          "role": "茜特菈莉",
          "text": "翅膀硬了啊？"
        },
        {
          "role": "欧洛伦",
          "text": "…真的对不起。"
        },
        {
          "role": "茜特菈莉",
          "text": "是不是觉得自己当上了六个英雄之一，可以无法无天了？嗯？"
        },
        {
          "role": "茜特菈莉",
          "text": "给我解释一下，臭小子，凭什么插手那个灵性白痴的事？"
        },
        {
          "role": "派蒙",
          "text": "欧洛伦！还有茜特菈莉…哈哈…你也来了啊。"
        },
        {
          "role": "茜特菈莉",
          "text": "欸？欸欸欸？你们怎么…"
        },
        {
          "role": "茜特菈莉",
          "text": "（糟糕，他们怎么现在就来了，我刚才凶巴巴的样子不会被旅行者看见了吧？哦天，我的形象！）"
        },
        {
          "role": "茜特菈莉",
          "text": "哈哈…你们好啊，那什么…刚才我和欧洛伦在玩，模仿游戏…"
        },
        {
          "role": "茜特菈莉",
          "text": "就是模仿轻小说里的人物和情节，背他们的台词，我说的话都不是我的本意，对吧，欧洛伦？"
        },
        {
          "role": "欧洛伦",
          "text": "啊？啊…对的，对的，奶奶。"
        },
        {
          "role": "欧洛伦",
          "text": "旅行者，也对不起你，本来是请你来帮忙的，结果我却没有注意身后，先被奶奶抓住了，和她一起玩模仿游戏。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这种事就不用道歉了。",
            "下次注意。",
            "模仿游戏？带我一个。"
          ]
        },
        {
          "role": "派蒙",
          "text": "茜特菈莉和欧洛伦，你们到底在干什么呀？是不是这个人出了问题？"
        },
        {
          "role": "茜特菈莉",
          "text": "嗯，他叫勒拉，在一次暝视中出了岔子，变成了现在这个样子。"
        },
        {
          "role": "旅行者",
          "text": "暝视是什么？"
        },
        {
          "role": "茜特菈莉",
          "text": "一种操纵灵性出体、用来获知神秘的法术，你有在小说里见到过通灵这种事吗？跟那个就很像。"
        },
        {
          "role": "茜特菈莉",
          "text": "而现在他的问题是，他的灵性在某处迷路了，无法返回身体。"
        },
        {
          "role": "派蒙",
          "text": "也就是说，他只是身体在这，但灵魂不在了！"
        },
        {
          "role": "茜特菈莉",
          "text": "虽说灵魂和灵性不完全是一回事，但现在可以简单这么理解。"
        },
        {
          "role": "欧洛伦",
          "text": "嗯，我就是想把勒拉失踪的灵性找回来…"
        },
        {
          "role": "茜特菈莉",
          "text": "哼，如果这个勒拉是一般人就罢了，我不会阻止欧洛伦。可问题在于，勒拉是个灵性白痴。"
        },
        {
          "role": "派蒙",
          "text": "灵性白痴又是什么？"
        },
        {
          "role": "茜特菈莉",
          "text": "就是对灵性完全脱敏的人，他们无法感知、操控灵性，更无法使用相关的法术。"
        },
        {
          "role": "茜特菈莉",
          "text": "反过来，如果他们用特殊方式强行施法…后果你们看到了，就是这位勒拉。"
        },
        {
          "role": "茜特菈莉",
          "text": "我们烟谜主的法术与灵性密不可分，解决问题的手段也如此，所以对灵性白痴而言，一般的治疗手段都不起效。"
        },
        {
          "role": "茜特菈莉",
          "text": "他们一旦因为施法出现问题，就约等于无药可救。"
        },
        {
          "role": "欧洛伦",
          "text": "有药可救的，只要是灵魂层面的事，我就还有办法…"
        },
        {
          "role": "茜特菈莉",
          "text": "听明白了吧？你们应该都知道欧洛伦这小子想干嘛了吧？"
        },
        {
          "role": "派蒙",
          "text": "噢！欧洛伦，你是想用你的特殊体质…会不会对你比较危险？"
        },
        {
          "role": "欧洛伦",
          "text": "不会有事的，奶奶太操心了。我的身体基本没问题了，现在应该能找到安全的办法。我想，只有这样才能找回勒拉的灵性。"
        },
        {
          "role": "茜特菈莉",
          "text": "你想你想，想都别想。如果勒拉的问题有点难办，你会做到什么程度，我还不知道吗？我看你也是个白痴。"
        },
        {
          "role": "派蒙",
          "text": "唔…欧洛伦确实是很会舍己为人的那种，这点让人担忧。但茜特菈莉也是操心的性格，真难办啊…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
             {
              "text": "我支持茜特菈莉，欧洛伦是白痴。",
              "dialogues": [
                   {
          "role": "欧洛伦",
          "text": "说我是白痴也无所谓，只要你们支持我，我就能把勒拉的灵性找回来。"
        },
        {
          "role": "茜特菈莉",
          "text": "喂！你把奶奶我当成什么了？什么时候轮到孙子来撑场面了？我当然还有办法。"
        }
              ]
            },
            {
              "text": "我支持欧洛伦，茜特菈莉才是白痴。",
              "dialogues": [              
        {
          "role": "茜特菈莉",
          "text": "喂！喂！你们都把黑曜石奶奶当成什么了？我当然也有办法！"
        }
              ]
            },
            {
              "text": "茜特菈莉一定还有办法的吧？",
              "dialogues": [
                {
          "role": "茜特菈莉",
          "text": "哼哼，那是当然，不然黑曜石奶奶我在这里干什么？"
        }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "噢？！哦？！"
        },
        {
          "role": "欧洛伦",
          "text": "欸？奶奶真的还有办法吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "笨办法也是办法！真是会给人找麻烦，你这臭小子。"
        },
        {
          "role": "茜特菈莉",
          "text": "旅行者，其实我本来就打算联系你的，因为我的办法动静比较大，可能需要你搭把手。"
        },
        {
          "role": "派蒙",
          "text": "那正好呀，欧洛伦已经把我们先找来了！"
        },
        {
          "role": "旅行者",
          "text": "没问题，要怎么帮忙？"
        },
        {
          "role": "茜特菈莉",
          "text": "我打算从两个方向开始，一个就是大海捞针的笨办法。"
        },
        {
          "role": "茜特菈莉",
          "text": "我在勒拉的周围画下了通往夜神之国的边界之门。就是这个。"
        },
        {
          "role": "茜特菈莉",
          "text": "边界之门发动后，会吸引附近所有游离的灵性，运气好的话，就能找到属于勒拉的部分。"
        },
        {
          "role": "茜特菈莉",
          "text": "旅行者，和之前一样，我会把能力暂时借给你，与你共享暝视，但要依靠这个出神香炉才能实现，别忘了先用。"
        },
        {
          "role": "茜特菈莉",
          "text": "放心，不会再有上次那种意外！你只会感觉自己到了夜神之国，能看见很多游灵，只要把它们都集中起来就好。"
        },
        {
          "role": "茜特菈莉",
          "text": "至于之后的分辨工作，就交给欧洛伦吧，既然他执意要管这件事，就让他干最辛苦的活。"
        },
        {
          "role": "旅行者",
          "text": "另一个方向呢？"
        },
        {
          "role": "茜特菈莉",
          "text": "利用灵性的本能聚合性质。众所周知，暝视一般都是为了探寻某种神秘。"
        },
        {
          "role": "茜特菈莉",
          "text": "如果我们能够知道勒拉原本想知道的事，就有可能把他失散的灵性吸引过来。"
        },
        {
          "role": "茜特菈莉",
          "text": "我会以勒拉的身体为媒介进行暝视，多少能探查出一些勒拉的所思所想。"
        },
        {
          "role": "派蒙",
          "text": "噢！我有点听明白了，如果说第一个方法是网鱼，第二个方法就是钓鱼。就像前面欧洛伦让旅行者用轻小说来钓你一样！"
        },
        {
          "role": "欧洛伦",
          "text": "唔…派蒙，不举这个例子也没关系的。"
        },
        {
          "role": "茜特菈莉",
          "text": "哈？回头再来收拾你们…"
        },
        {
          "role": "欧洛伦",
          "text": "但是奶奶，你真厉害，居然可以用人为媒介来进行暝视，我一直以为只能用物品。"
        },
        {
          "role": "茜特菈莉",
          "text": "拍马屁也没用，哼哼。一个人如果失去了灵性，剩下的不过是躯壳，和物品也没什么区别。"
        },
        {
          "role": "茜特菈莉",
          "text": "旅行者，那边是我的灵性织机，能记录我暝视出的一些破碎片段，在我开始的时候，请你帮忙把它们拼接到织物上。"
        },
        {
          "role": "茜特菈莉",
          "text": "准备好了就和我说一声，现在要开始干活了。"
        },
        {
          "role": "欧洛伦",
          "text": "加油，旅行者，我们一起把勒拉找回来！"
        },
          
        {
          "type": "subtitle",
          "text": "额外对话（欧洛伦）"
        },
        {
          "role": "欧洛伦",
          "text": "加油，旅行者，我们一起把勒拉找回来！"
        },
          
        {
          "type": "subtitle",
          "text": "额外对话（勒拉）"
        },
        {
          "role": "勒拉",
          "text": "……"
        },
        {
          "type": "subtitle",
          "text": "使用灵性织机编织织物"
        },
        {
          "type": "subtitle",
          "text": "与茜特菈莉交谈"
        },

        {
          "role": "派蒙",
          "text": "噢！织物出来了！这好像是个人…是谁啊？"
        },
        {
          "role": "茜特菈莉",
          "text": "……"
        },
        {
          "role": "欧洛伦",
          "text": "……"
        },
        {
          "role": "茜特菈莉",
          "text": "是桑哈杰·康波雷…"
        },
        {
          "role": "派蒙",
          "text": "欸？是之前欧洛伦古名里出来的那个英杰桑哈杰吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "没错，他不仅是英杰，还是烟谜主历史上有名的边界大师，即使已经逝去五百年，他的灵性残留也依然强大…"
        },
        {
          "role": "欧洛伦",
          "text": "补充说明，边界大师是一种尊称，专门给像奶奶这样厉害的人物。"
        },
        {
          "role": "茜特菈莉",
          "text": "不，强大的边界大师能够拓展夜神之国的边界，让其部分短暂降临现世。"
        },
        {
          "role": "茜特菈莉",
          "text": "虽然奶奶我的边界法术也不差，但比桑哈杰还差得远。"
        },
        {
          "role": "茜特菈莉",
          "text": "传说中，五百年前烬寂海大战，桑哈杰就是使出了这样的法术，召唤并引爆一个微型夜神空间，才得以击退漆黑灾厄。"
        },
        {
          "role": "派蒙",
          "text": "好…好强大！"
        },
        {
          "role": "茜特菈莉",
          "text": "不是没有代价的，据我所知，除了桑哈杰本人，部族联军的牵头人特诺切也是因这道法术而牺牲。"
        },
        {
          "role": "茜特菈莉",
          "text": "这个勒拉到底想干什么，连我也不敢轻易暝视桑哈杰·康波雷，这个灵性白痴居然…该说无知者无畏吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "我有一种预感，事情没有这么简单，我打算去他家一趟，最好能找到什么线索。"
        },
        {
          "role": "旅行者",
          "text": "那之前说的还要继续吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "嗯，聚集那些游灵并没有影响，如果能正好找出勒拉的灵性，我们也不用这么麻烦了。"
        },
        {
          "role": "茜特菈莉",
          "text": "不过现在好像又多了一个问题。暝视桑哈杰·康波雷动静不小，周遭的魔物可能已经被惊动了。"
        },
        {
          "role": "茜特菈莉",
          "text": "旅行者，如果你有时间，能去让它们安静一点吗？防止危害到往来的路人。"
        },
        {
          "role": "欧洛伦",
          "text": "这种事让我来就行了。"
        },
        {
          "role": "茜特菈莉",
          "text": "凭你的身手还是省省吧，旅行者已经够辛苦了，我可不想听到他去救你的消息。"
        },
        {
          "role": "欧洛伦",
          "text": "那好吧…旅行者，看来还是要麻烦你了。"
        },
        {
          "role": "旅行者",
          "text": "小事一桩。"
        },
        {
          "role": "派蒙",
          "text": "嗯，现在还是把这个家伙的灵性找回来最重要！"
        },
        {
          "role": "茜特菈莉",
          "text": "那我就先离开了，回见。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（欧洛伦）"
        },
        {
          "role": "欧洛伦",
          "text": "旅行者，这几天还要继续辛苦你聚集游灵了，用这个香炉就好，奶奶在上面留下了法术。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于灵性织机……",
              "dialogues": [
                 {
          "role": "欧洛伦",
          "text": "噢，你喜欢玩那个吗？可以随时试试，里面应该有别的暝视记录。你可以把它们都拼接到织物上。还挺有趣的。"
        },
        {
          "role": "欧洛伦",
          "text": "不用担心别的，既然奶奶把它留在这里，应该就有给你练手的意思。"
        }
              ]
            },
            {
              "text": "关于烬寂海……",
              "dialogues": [
                {
          "role": "欧洛伦",
          "text": "烬寂海？据我所知，那里不适合蔬菜生长。"
        },
        {
          "role": "欧洛伦",
          "text": "我怎么知道的？是奶奶说的啦，要是你想了解更多，还是等奶奶来了问她比较好。"
        },
        {
          "role": "欧洛伦",
          "text": "奶奶家里有一些相关的织卷，只是我对种不出蔬菜的地方实在提不起兴趣，所以一幅都没看过，真对不起。"
        }
              ]
            }      
          ]
        }
      ],
