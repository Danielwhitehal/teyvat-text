{
  "quest_id": 71532,
  "chapter_num": null,
  "chapter_title": "熠光云行",
  "type": "wq",
  "route": "Iridescent Cloud-Striding",
  "stories": [
    {
      "story_id": 71532,
      "title": "熠光云行",
      "description": "路过遗珑埠的某条街道时，一位诚恳的说书人学徒挽留住了你们，讲述了一个与你们密切相关的故事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与卷舒对话"
        },
        {
          "role": "卷舒",
          "text": "两位，说书人学徒卷舒恳请你们留步——"
        },
        {
          "role": "卷舒",
          "text": "你们可曾听说过这样一则传闻？「海灯节的良宵之时，曾有蹈跃的焰光在夜空中挥笔作画，描绘盛美的图卷…」"
        },
        {
          "role": "派蒙",
          "text": "没，没听懂！"
        },
        {
          "role": "派蒙",
          "text": "焰光？在天空中作画？一般人根本做不到这种事吧…就算坐着那什么飞艇，也没有可以浮在天上的神奇颜料。"
        },
        {
          "role": "派蒙",
          "text": "听起来像是很夸张的比方！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉不是一般的画？",
              "dialogues": []
            },
            {
              "text": "难不成说的是烟花？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卷舒",
          "text": "总之！这则传闻的主角就是你们两位，闻名遐迩的旅行者旅行者和他(她)的伙伴派蒙！"
        },
        {
          "role": "派蒙",
          "text": "咦？怎么话题突然转向了我们？"
        },
        {
          "role": "卷舒",
          "text": "也许你们已经忘记了，去年你们接受了冒险家甜甜的委托，参与了一场特别的竞速挑战。"
        },
        {
          "role": "卷舒",
          "text": "那场竞速挑战被漂亮的烟花点缀，蔚为壮观，成了难得一见的美景。"
        },
        {
          "role": "派蒙",
          "text": "这么说来，我隐约记得，当时我们只是举手之劳，帮了帮那位冒险家协会的宣传员…"
        },
        {
          "role": "派蒙",
          "text": "她说要借助那场活动来吸引新的成员，也不知道她后来有没有成功。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像有这事？",
              "dialogues": []
            },
            {
              "text": "那么重点是？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卷舒",
          "text": "当时我在望舒客栈附近喝闷酒，仰望到了你们被烟花点亮的身影…"
        },
        {
          "role": "卷舒",
          "text": "一瞬间，考试落榜的哀愁，对前路的迷茫，都被你们那充满朝气、光芒万丈的身姿给驱散了！"
        },
        {
          "role": "卷舒",
          "text": "所以我才打起精神，继续我的民俗研究，来到这沉玉谷，深入探索我热爱的课题…感谢你们的鼓励！"
        },
        {
          "role": "卷舒",
          "text": "除了我以外，还有不少被你们的身影吸引，加入冒险家协会的人，他们也找到了人生的新方向！"
        },
        {
          "role": "派蒙",
          "text": "完，完全没想到！我们当时都没注意到远处有人在看，也没想过，我们只是参与了竞速挑战，就能给别人加油打气！"
        },
        {
          "role": "派蒙",
          "text": "你说得这么夸张，我们都有点不好意思了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "打起精神就好啦。",
              "dialogues": []
            },
            {
              "text": "恭喜你振作起来。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卷舒",
          "text": "今天偶遇两位，实属三生有幸。我想麻烦两位一件事，并对两位表示真挚的感谢——"
        },
        {
          "role": "卷舒",
          "text": "请两位将你们的光辉传递下去，继续鼓舞更多人吧！"
        },
        {
          "role": "派蒙",
          "text": "虽然我们好像没有你说得那么伟大啦，但你的想法很好很好，能让更多人心情变好的话，我们当然超级乐意！"
        },
        {
          "role": "派蒙",
          "text": "话说回来，我们要怎么做呢？"
        },
        {
          "role": "卷舒",
          "text": "遵循惯例，我参考了甜甜规划的竞速挑战，联合被你们鼓舞的冒险家们，共同规划了一种全新的活动「熠光云行」。"
        },
        {
          "role": "卷舒",
          "text": "在这沉玉谷之中，也有着诸多奇妙之物，其中就有一种奇妙的鲤鱼，能让人借助它的力量快速穿行。"
        },
        {
          "role": "卷舒",
          "text": "两位只需要像往常那样，尽情在山间与空中穿梭，将你们的利落身姿和朝气展示给更多人就好了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "举手之劳！",
              "dialogues": []
            },
            {
              "text": "非常乐意！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "卷舒",
          "text": "当然，除了我这份摩拉的谢礼，我们还给两位准备了各种酬劳，聊表我们的心意。"
        },
        {
          "role": "卷舒",
          "text": "对于两位传递希望，令人振奋的事迹而言，这些谢礼或许并不丰厚，但并不是全部。我们以后还会找机会报答两位的！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，你也太客气啦！就算拿不到多少好处，我和旅行者也会一直旅行下去，尽量帮助每个迷茫的人！"
        },
        {
          "role": "派蒙",
          "text": "听卷舒小姐这么一说，总觉得冒险都更有干劲了！我们就试试她说的「熠光云行」吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（卷舒）"
        },
        {
          "role": "卷舒",
          "text": "可敬的旅行者玩家，有什么需要我做的吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「熠光云行」的地点…",
              "dialogues": [
                {
                  "role": "卷舒",
                  "text": "嗯！这个问题很有讲究，我和受你鼓舞的冒险家们仔细研究了很久才选出合适的地点——"
                },
                {
                  "role": "卷舒",
                  "text": "「心情低落的人时常在静谧的野外徘徊，远离喧嚣」。"
                },
                {
                  "role": "卷舒",
                  "text": "所以「熠光云行」距离遗珑埠和翘英庄大多不近不远，这样正能让你的光芒照顾更多需要鼓舞的人。"
                }
              ]
            },
            {
              "text": "关于你自己…",
              "dialogues": [
                {
                  "role": "卷舒",
                  "text": "啊，我自己的经历其实很普通。"
                },
                {
                  "role": "卷舒",
                  "text": "我只是个没有任何特长的民俗研究者，曾在课题陷入停滞时想过改行，为此报考了总务司的岗位，结果落榜了。"
                },
                {
                  "role": "卷舒",
                  "text": "好在，被你鼓舞后，我咬咬牙挺过了资金和认知上的双重难关，才发现完全没有那个必要。"
                },
                {
                  "role": "卷舒",
                  "text": "来到遗珑埠后，我发现沉玉谷有着数不尽的研究题材，一边当说书人学徒，一边钻研文献和民俗故事，每天都过得很充实！"
                },
                {
                  "role": "卷舒",
                  "text": "这一切都多亏了你，再次感谢你！"
                }
              ]
            },
            {
              "text": "我先走啦，节日快乐！",
              "dialogues": [
                {
                  "role": "卷舒",
                  "text": "海灯节快乐！期待下次与你再见！"
                }
              ]
            }
          ]
        }
      ],
      "collapse_ranges": [
        [
          33,
          35
        ]
      ]
    }
  ]
}