  "chapter_title": "仿生摹行",
  "type": "wq",
  "route": "Mimetic Replication",
  "stories": [
    {
      "story_id": 73692,
      "title": "仿生摹行",
      "description": "阿弥利多学院的帕兹似乎正在因为某事而忙碌着…",
      "dialogues": [
        {
          "role": "帕兹",
          "text": "啊…你好，旅行者，看样子，你也是来参加学院游乐会的吧。"
        },
        {
          "role": "帕兹",
          "text": "如果有兴趣的话，您愿意来试玩一下我们阿弥利多学院推出的小游戏吗？"
        },
        {
          "role": "旅行者",
          "text": "是什么小游戏？"
        },
        {
          "role": "帕兹",
          "text": "我们学院在学院游乐会期间推出了小游戏「仿生摹行」。"
        },
        {
          "role": "帕兹",
          "text": "在这个游戏中，我会向您介绍一些动物的规律性行为。"
        },
        {
          "role": "帕兹",
          "text": "当然了，这些「规律性」都经过了我们的简化和概括，很容易理解。"
        },
        {
          "role": "帕兹",
          "text": "您需要做的，就是用这个我们已经准备好的模型来模仿对应动物的行为。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "听着还蛮简单的…",
            "感觉倒是不难。"
          ]
        },
        {
          "role": "旅行者",
          "text": "听着还蛮简单的…"
        },
        {
          "role": "帕兹",
          "text": "是的。「动物具有规律性的习性」是一句很容易理解和接受的话。"
        },
        {
          "role": "帕兹",
          "text": "但在这句看似简单的话背后，却包含着探究不尽的谜题。"
        },
        {
          "role": "帕兹",
          "text": "不过…这段时间内，我们就暂时放下学术性的观察眼光，轻松地体会一下动物们的习性吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "想要试玩一下。",
            "还有别的事。"
          ]
        },
        {
          "role": "旅行者",
          "text": "想要试玩一下。"
        },
        {
          "role": "帕兹",
          "text": "好的，请您到这边来。"
        }
      ]
    }
  ]
}