{
  "quest_id": 75238,
  "chapter_num": null,
  "chapter_title": "小小的心意",
  "type": "wq",
  "route": "A Small Token",
  "stories": [
    {
      "story_id": 75238,
      "title": "小小的心意",
      "description": "前往烟谜主放置茶桌并使用桑多涅落座后，与茜特菈莉共度茶会时光吧…",
      "dialogues": [
        {
          "role": "「木偶」",
          "text": "茶的口味还满意吗？还是说我该准备些酒类饮料？"
        },
        {
          "role": "茜特菈莉",
          "text": "不了，茶挺好。白天喝酒有些太罪恶了，那种事还是少干两次吧。"
        },
        {
          "role": "茜特菈莉",
          "text": "倒是吉约丹小姐，怎么跑这么远到纳塔来？"
        },
        {
          "role": "「木偶」",
          "text": "四处走走，看看过去的同伴而已。我也想感谢你在千灵节期间愿意接下那份工作。"
        },
        {
          "role": "茜特菈莉",
          "text": "你也太客气了，就为了这跑一趟吗？"
        },
        {
          "role": "「木偶」",
          "text": "另外，虽然你上次没提，但我知道曾经给你们增添过一些不愉快。"
        },
        {
          "role": "茜特菈莉",
          "text": "啊…你部下的那事是吧。和那个名叫伊涅芙的机器人有关的那次。"
        },
        {
          "role": "茜特菈莉",
          "text": "呵…这不正是生活奇妙的地方吗？曾经敌人的老板或许也会变为你的同伴，或是你的老板…"
        },
        {
          "role": "「木偶」",
          "text": "希望你能收下这些。聊表心意。"
        },
        {
          "role": "茜特菈莉",
          "text": "这…这是…限定版，不对，珍藏版轻小说？！而且还是我喜欢的题材？你…你怎么会知道…"
        },
        {
          "role": "「木偶」",
          "text": "我向旅行者询问你可能会喜欢的东西，并听取了他的意见。"
        },
        {
          "role": "茜特菈莉",
          "text": "旅行者…？！"
        },
        {
          "role": "茜特菈莉",
          "text": "（可恶…！这种又高兴又有些别扭的感觉是怎么回事？！）"
        },
        {
          "role": "茜特菈莉",
          "text": "（虽然他了解我喜欢什么自然是高兴啦，但能不能不要随便告诉别人，倒是来亲自送给我呀！）"
        },
        {
          "role": "「木偶」",
          "text": "还算中意吗？"
        },
        {
          "role": "茜特菈莉",
          "text": "啊…谢谢谢谢。吉约丹小姐真的太客气了。"
        },
        {
          "role": "「木偶」",
          "text": "喜欢的话，我下次也再给你带些。当然，到时候恐怕又得麻烦旅行者一起去选一选了。"
        },
        {
          "role": "茜特菈莉",
          "text": "一起？！你们是一起逛…逛书店选的吗？！"
        },
        {
          "role": "「木偶」",
          "text": "嗯，他很认真地为你挑选了这本。下次或许…"
        },
        {
          "role": "茜特菈莉",
          "text": "不要再有下次了！！"
        },
        {
          "role": "「木偶」",
          "text": "啊…啊？"
        },
        {
          "role": "茜特菈莉",
          "text": "哼…看我下次怎么收拾他。"
        },
        {
          "type": "choice",
          "role": "「木偶」",
          "options": [
            "（再这么坐一会儿吧。）",
            "茶会时间该结束了。"
          ]
        },
        {
          "role": "茜特菈莉",
          "text": "已经这么晚了？好吧，吉约丹小姐回去路上小心。"
        }
      ]
    }
  ]
}