{
  "quest_id": 73098,
  "chapter_num": null,
  "chapter_title": "静态风景",
  "type": "wq",
  "route": "Static Views",
  "stories": [
    {
      "story_id": 73098,
      "title": "静态风景",
      "description": "在桓那兰那，派蒙找到了「说不定是藏宝图」的画像…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "我看看我看看…嗯？这是兰那罗的画吗…"
        },
        {
          "role": "旅行者",
          "text": "随便翻别人的东西不好…"
        },
        {
          "role": "派蒙",
          "text": "是喔？明明，一路上冒险家的营地、遗迹的宝箱什么的，我们都清理过不知道多少回啦！"
        },
        {
          "role": "派蒙",
          "text": "嗯…不如这么说吧！这个房子周围没见到兰那罗，我们很担心，所以想看看有没有什么线索。说不定，还能帮助受困的兰那罗呢！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你说得对。",
              "dialogues": []
            },
            {
              "text": "哦。那可真是太有道理了！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼哼，那当然！不管怎么说，这幅画看上去…好像是附近的风景，对吧？不得了，说不定是藏宝图…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，我们去画出来的地方看看吧！或许真的有兰那罗留下的宝藏呢！"
        },
        {
          "type": "subtitle",
          "text": "领取邮件"
        },
        {
          "type": "subtitle",
          "text": "前往画中描绘的地点"
        },
        {
          "type": "subtitle",
          "text": "回到兰那罗的小屋"
        },
        {
          "type": "subtitle",
          "text": "和派蒙对话"
        },
        {
          "role": "派蒙",
          "text": "嗯…让我看看…好像又出现新的藏宝图了！"
        },
        {
          "role": "旅行者",
          "text": "不是说要帮助「受困的兰那罗」吗？"
        },
        {
          "role": "派蒙",
          "text": "咳咳！对，我们这回没有找到屋主，真是令人担心！所以，旅行者，我觉得，我们多去图画里描绘的地方看看！"
        },
        {
          "role": "派蒙",
          "text": "到了那些地方以后，我们就能根据上面描绘的地点…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "找到更多宝藏？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "对！啊，不对！找到需要帮助的兰那罗！"
                }
              ]
            },
            {
              "text": "找到「受困的兰那罗」？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯！而且，说不定还能得到宝藏呢！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯…感觉这个「邮箱」很神奇，说不定之后还会有新的图画传回来。之后，我们多留意一下吧！"
        }
      ]
    }
  ]
}