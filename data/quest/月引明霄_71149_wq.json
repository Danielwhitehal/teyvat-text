{
  "quest_id": 71149,
  "chapter_num": null,
  "chapter_title": "月引明霄",
  "type": "wq",
  "route": "Bright Moon, Lantern Glow",
  "stories": [
    {
      "story_id": 71149,
      "title": "月引明霄",
      "description": "在璃月港，人们正在欢度着海灯节。一位名为萍溪的总务司工作人员，似乎正担任着接待的工作…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与萍溪对话"
        },
        {
          "role": "萍溪",
          "text": "今年的安排应该没问题，呼…总算不用麻烦[[刻晴]]大人再来亲自核算了…"
        },
        {
          "role": "萍溪",
          "text": "呃！不能想着这些，我是招财神我是招财神我是招财神…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "请问您是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "萍溪",
          "text": "我是招财神！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看、看得出来…",
              "dialogues": []
            },
            {
              "text": "很吉利的服装…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "萍溪",
          "text": "欸？这不是旅行者吗？嗨，早知道是你过来，我就不用背那么多词了…"
        },
        {
          "role": "萍溪",
          "text": "看你的样子，也是来璃月过海灯节的，对吧？"
        },
        {
          "role": "萍溪",
          "text": "今年你算是来着了，瞧瞧周围的氛围，是不是比去年的海灯节更热闹了？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉每一年的海灯节…",
              "dialogues": []
            },
            {
              "text": "都比前一年更厉害…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "萍溪",
          "text": "那是当然，俗话说「霄灯飞起节节高」，无论做什么事都要求一个进步嘛。"
        },
        {
          "role": "萍溪",
          "text": "哎呀，大过节的不说这些，来来来，我给你指指哪里有好玩的。"
        },
        {
          "role": "萍溪",
          "text": "我看看喔…嗯…有了！来海灯节，当然要先放霄灯了。"
        },
        {
          "role": "萍溪",
          "text": "然后呢，我们今年还在璃月港的各处放了许多「吉事宝树」，只要为它好好修剪枝干，里面的「吉语钱」就归你啦。"
        },
        {
          "role": "萍溪",
          "text": "我们一共放了多少个来着？好像是…21，对，就是21个。"
        },
        {
          "role": "萍溪",
          "text": "而且…其实在这附近，就有一棵「吉事宝树」喔，要是有兴趣的话，你就直接去修剪一下吧，很简单的。"
        },
        {
          "role": "萍溪",
          "text": "最后…嗯，要是你有兴趣的话，也可以去旁边的「告事板」那边看看，喏，就在我旁边。"
        },
        {
          "role": "萍溪",
          "text": "最近几年的海灯节有许多外国游客参加，我们总务司也专门为他们设置了「告事板」。"
        },
        {
          "role": "萍溪",
          "text": "无论他们有什么问题，或者是遇见了需要解决的麻烦，都可以写下来挂在「告事板」上。"
        },
        {
          "role": "萍溪",
          "text": "哼哼，我们总务司，绝对会让所有来璃月过海灯节的人，都满意而归！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不愧是总务司。",
              "dialogues": []
            },
            {
              "text": "不愧是璃月…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "萍溪",
          "text": "那是当然！"
        },
        {
          "role": "萍溪",
          "text": "对了，旅行者，我记得你很擅长留影，对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "略懂而已。",
              "dialogues": []
            },
            {
              "text": "根本不明白。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "萍溪",
          "text": "哈哈哈，别这么谦虚嘛。我就是…想拜托你帮一个小小的忙。"
        },
        {
          "role": "萍溪",
          "text": "很简单的，我保证！你只需要帮几位游客拍一张「纪念留影」就好。"
        },
        {
          "role": "萍溪",
          "text": "本来我们雇了几位留影师，专门为大家拍「纪念留影」，但没想到，今年来了这么多游客，留影师一下子就不够用了。"
        },
        {
          "role": "萍溪",
          "text": "临时雇新的留影师已经来不及了，所以，我就只能拜托你了，旅行者！"
        },
        {
          "role": "萍溪",
          "text": "拜托！为了各位游客，为了海灯节，为了璃月！只有你能帮我们这个忙了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "包在我身上！",
              "dialogues": []
            },
            {
              "text": "为了海灯节！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "萍溪",
          "text": "哦！不愧是旅行者，我就把那几位游客的名字，还有预定的地点告诉你。"
        },
        {
          "role": "萍溪",
          "text": "那就拜托你了，有你帮忙，今年的海灯节一定会完美无缺的！"
        },
        {
          "role": "萍溪",
          "text": "这几盏霄灯送给你，嘿嘿，海灯节快乐！"
        }
      ]
    }
  ]
}