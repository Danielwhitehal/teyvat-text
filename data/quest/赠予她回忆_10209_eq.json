{
  "quest_id": 10209,
  "chapter_num": "彩糖与蔷薇的幻色颂 第三份礼物",
  "chapter_title": "赠予她回忆",
  "type": "eq",
  "route": "Give Her Memories",
  "stories": [
    {
      "story_id": 40168,
      "title": "赠予她回忆",
      "description": "当回想起一个又一个生日的时候，这会是她最难忘的那个吗？",
      "dialogues": [
        {
          "role": "赛诺",
          "text": "…会不会是睡过了？"
        },
        {
          "role": "提纳里",
          "text": "不像…以前还从没出现过这种情况…"
        },
        {
          "role": "坎蒂丝",
          "text": "来的路上见到过吗…"
        },
        {
          "role": "派蒙",
          "text": "我们到啦！咦？你们怎么一脸担忧的表情？"
        },
        {
          "role": "坎蒂丝",
          "text": "妮露小姐还没到。"
        },
        {
          "role": "派蒙",
          "text": "嗯？不就是可能迟到了一小会儿吗？"
        },
        {
          "role": "提纳里",
          "text": "有些反常。以往几次她都是提早到的。何况今天赛诺原本想去大巴扎叫妮露一起过来…"
        },
        {
          "role": "赛诺",
          "text": "但却被告知她早早就出门了。"
        },
        {
          "role": "派蒙",
          "text": "结果就是赛诺到了，妮露却没到？"
        },
        {
          "role": "坎蒂丝",
          "text": "所以我们对此有些担心…"
        },
        {
          "role": "旅行者",
          "text": "那伙商队怎么样了？"
        },
        {
          "role": "赛诺",
          "text": "我们当天就审了那伙运送「危险品」的商队…"
        },
        {
          "role": "赛诺",
          "text": "但一来他们货物被洗劫一空，没有物证可查，二来单从这起事件来说，他们属于受害者…"
        },
        {
          "role": "赛诺",
          "text": "他们口中的货物的确可疑，但在追回失物前，只能借保护的名义对他们进行监视观察。"
        },
        {
          "role": "赛诺",
          "text": "关于宝石，我们也联系了卖家，他只说另一块宝石在沙漠中被一位年轻男子买走了。"
        },
        {
          "role": "提纳里",
          "text": "总之现在的情况是——危险品和另一块宝石下落不明，妮露小姐也不见踪影。"
        },
        {
          "role": "派蒙",
          "text": "但妮露为什么会被卷进来呀？"
        },
        {
          "role": "提纳里",
          "text": "我们还不确定这三件事是否有联系，但要做假设的话…妮露小姐的「花神之舞」，是花神诞祭上的重要节目。"
        },
        {
          "role": "提纳里",
          "text": "如果对方意在破坏花神诞祭，妮露小姐很可能成为其目标。"
        },
        {
          "role": "赛诺",
          "text": "……"
        },
        {
          "role": "赛诺",
          "text": "旅行者，坎蒂丝，事不宜迟，我们还是循着踪迹去找一趟吧。"
        },
        {
          "role": "赛诺",
          "text": "提纳里就留在禅那园，等其他人到了和他们说明情况。"
        },
        {
          "role": "提纳里",
          "text": "好，也不排除妮露被急事绊住的情况。我会在这里多等等的。"
        },

        {
          "type": "subtitle",
          "text": "额外对话（提纳里）"
        },
        {
          "role": "心声",
          "text": "（会去哪里了呢…）"
        },
        {
          "role": "提纳里",
          "text": "你们放心去吧，我在这里等着。"
        },
         {
          "type": "subtitle",
          "text": "额外对话（拉沙鲁）"
        },
        {
          "role": "拉沙鲁",
          "text": "呼…妮露…不来了…呼噜…"
        },
        {
          "role": "拉沙鲁",
          "text": "她…跳舞…呼噜…"
        },
        {
          "type": "subtitle",
          "text": "前往祖拜尔广场"
        },
        {
          "role": "派蒙",
          "text": "祖拜尔先生！"
        },
        {
          "role": "谢赫祖拜尔",
          "text": "是你们啊，有什么事吗？"
        },
        {
          "role": "派蒙",
          "text": "您知道妮露去哪儿了吗？"
        },
        {
          "role": "谢赫祖拜尔",
          "text": "妮露？她说今天要去帮朋友忙，早早就出去了。"
        },
        {
          "role": "赛诺",
          "text": "就她一个人吗？您有看到她从哪个门出去的吗？"
        },
        {
          "role": "谢赫祖拜尔",
          "text": "嗯，就她一个。我想想…好像是从北门出去的。"
        },
        {
          "role": "赛诺",
          "text": "…居然是和禅那园完全相反的方向。"
        },
        {
          "role": "谢赫祖拜尔",
          "text": "出什么事了吗？这节骨眼可开不得玩笑。"
        },
        {
          "role": "赛诺",
          "text": "祖拜尔先生，如果妮露回到大巴扎的话，能派人到禅那园送个口信吗？"
        },
        {
          "role": "谢赫祖拜尔",
          "text": "没问题，我觉得她或许是被什么事给绊住了。总之你们快去吧，事情解决了给我送个话。"
        },
        {
          "role": "赛诺",
          "text": "一定。"
        },
        {
          "role": "赛诺",
          "text": "走吧，我们沿北门出去后再找人问问。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（谢赫祖拜尔）"
        },
        {
          "role": "心声",
          "text": "（哎…希望不要出什么乱子…）"
        },
        {
          "role": "谢赫祖拜尔",
          "text": "你们快去吧，别耽搁时间了。"
        },
        {
          "type": "subtitle",
          "text": "沿途询问妮露的行踪"
        },
        {
          "role": "赛诺",
          "text": "妮维妲小姐，请问您早上有见到妮露吗？"
        },
        {
          "role": "妮维妲",
          "text": "妮露？哦，见到了见到了，她穿着可漂亮的一身衣服往城外去了。"
        },
        {
          "role": "派蒙",
          "text": "城外？"
        },
        {
          "role": "妮维妲",
          "text": "对，就是那边的方向。"
        },
        {
          "role": "赛诺",
          "text": "有其他人跟着她吗？她看起来怎么样？"
        },
        {
          "role": "妮维妲",
          "text": "没有…我见到的时候她就一个人，还和我打招呼呢。精神不错。"
        },
        {
          "role": "赛诺",
          "text": "好，谢谢您。"
        },
        {
          "role": "赛诺",
          "text": "打扰问一下，你们早上有看到祖拜尔剧场的妮露小姐往这边出城吗？"
        },
        {
          "role": "城门守卫",
          "text": "是，赛诺先生，看见了。妮露小姐早上出城后过了桥，有位男士在桥的另一边等她。"
        },
        {
          "role": "派蒙",
          "text": "该不会是沙漠里买另一块宝石的人吧！"
        },
        {
          "role": "赛诺",
          "text": "你们有看清那位男子的面貌吗？"
        },
        {
          "role": "城门守卫",
          "text": "抱歉，当时距离太远，没看清。"
        },
        {
          "role": "赛诺",
          "text": "…我明白了。如果她从这道门回来的话，告诉她去禅那园找我。"
        },
        {
          "role": "城门守卫",
          "text": "明白！"
        },
        {
          "role": "赛诺",
          "text": "我们继续往前。"
        },
        {
          "type": "subtitle",
          "text": "根据线索寻找妮露"
        },
        {
          "role": "派蒙",
          "text": "线索断了呢…这里没人可问了。"
        },
        {
          "role": "坎蒂丝",
          "text": "地上倒是有几处脚印错综交杂，要试着沿途追踪一下吗？"
        },
        {
          "role": "赛诺",
          "text": "痕迹太多…很容易走错方向。我看看…"
        },
        {
          "role": "旅行者",
          "text": "（…！那是…）"
        },
        {
          "role": "旅行者",
          "text": "二位，稍微失陪一下。"
        },
        {
          "role": "赛诺",
          "text": "好，我们就在这边分析痕迹。"
        },
        {
          "role": "坎蒂丝",
          "text": "旅行者要是有什么发现，也记得及时告诉我们。"
        },

        {
          "type": "subtitle",
          "text": "额外对话（坎蒂斯&赛诺）"
        },
        {
          "role": "心声（坎蒂斯）",
          "text": "（前方的目的地…）"
        },
        {
          "role": "心声（赛诺）",
          "text": "（沙漠中的男子…）"
        },
        {
          "role": "坎蒂斯",
          "text": "看痕迹是往左边去了…"
        },
        {
          "role": "赛诺",
          "text": "脚印太多，还是再确认一下。"
        },
        {
          "type": "subtitle",
          "text": "与兰那罗对话"
        },
        {
          "role": "派蒙",
          "text": "兰萨卡！是兰萨卡对吧？"
        },
        {
          "role": "兰萨卡",
          "text": "…噫！是…是金色的好那菈！兰萨卡…快躲起来！"
        },
        {
          "role": "派蒙",
          "text": "嗯？为什么要躲起来啦？我们不是朋友吗？"
        },
        {
          "role": "兰萨卡",
          "text": "朋友…兰萨卡和金色那菈是朋友，但是…兰阿帕斯最近不让我随便说话…"
        },
        {
          "role": "派蒙",
          "text": "嗯？这是为什么？"
        },
        {
          "role": "兰萨卡",
          "text": "他觉得兰萨卡会说漏嘴…"
        },
        {
          "role": "兰萨卡",
          "text": "噫！兰萨卡不能再说了！"
        },
        {
          "role": "派蒙",
          "text": "说漏嘴…哎呀不管这个了，兰萨卡有看到一位女孩子从这边路过吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "红头发的那菈。",
            "像花朵一样的那菈。"
          ]
        },
        {
          "role": "兰萨卡",
          "text": "红色的，像帕蒂沙兰那样好看的那菈？兰萨卡看见了。"
        },
        {
          "role": "派蒙",
          "text": "真的吗！她往哪里走了？"
        },
        {
          "role": "兰萨卡",
          "text": "和另一位兰萨卡不认识的那菈往乱糟糟石块那边走了。"
        },
        {
          "role": "派蒙",
          "text": "乱糟糟石块？"
        },
        {
          "role": "旅行者",
          "text": "是说觉王之殿附近的废墟吧…"
        },
        {
          "role": "派蒙",
          "text": "哦！有道理。谢谢兰萨卡！"
        },
        {
          "role": "兰萨卡",
          "text": "兰萨卡愿意帮金色好那菈，金色好那菈以前也帮了兰萨卡。"
        },
        {
          "role": "派蒙",
          "text": "不过你刚才说的另一件事…"
        },
        {
          "role": "兰萨卡",
          "text": "噫！兰萨卡不知道！不能说！"
        },
        {
          "role": "派蒙",
          "text": "啊！兰萨卡走掉了…"
        },
        {
          "role": "派蒙",
          "text": "不管怎样，先把这个消息告诉赛诺和坎蒂丝吧。"
        },
        {
          "type": "subtitle",
          "text": "与坎蒂斯和赛诺对话"
        },
        {
          "role": "赛诺",
          "text": "…觉王之殿的方向？"
        },
        {
          "role": "坎蒂丝",
          "text": "这和地上痕迹所指示的地方相同。"
        },
        {
          "role": "赛诺",
          "text": "你们是怎么知道的？"
        },
        {
          "role": "派蒙",
          "text": "呃…突然受到了些朋友的指点。我保证是可靠的啦。"
        },
        {
          "role": "赛诺",
          "text": "…好，我相信你们。"
        },
        {
          "role": "坎蒂丝",
          "text": "那就出发吧，希望…呃…！哈…"
        },
        {
          "role": "赛诺",
          "text": "又看到了那种「预示」吗？"
        },
        {
          "role": "坎蒂丝",
          "text": "对…不过这次只有模糊的声音…"
        },
        {
          "role": "旅行者",
          "text": "说了些什么？"
        },
        {
          "role": "坎蒂丝",
          "text": "像是两个人在对话…说着「她会不会发现」、「应该会顺着踪迹过来」什么的…"
        },
        {
          "role": "赛诺",
          "text": "是妮露的声音吗？"
        },
        {
          "role": "坎蒂丝",
          "text": "声音过于模糊不清，我无法分辨。"
        },
        {
          "role": "赛诺",
          "text": "嗯…总之先去那边的废墟看看，「预示」的出现，或许也意味着我们的方向没错。"
        },
        {
          "type": "subtitle",
          "text": "前往线索指示的地方"
        },
        {
          "role": "赛诺",
          "text": "应该就是这附近了。"
        },
        {
          "role": "派蒙",
          "text": "唔…这边经常有盗宝团出没，妮露不会有危险吧？"
        },
        {
          "role": "坎蒂丝",
          "text": "…！你们看那边！"
        },
        {
          "role": "派蒙",
          "text": "是妮露！真的是妮露欸！妮露——！"
        },
        {
          "role": "赛诺",
          "text": "太远了，她好像听不到。"
        },
        {
          "role": "派蒙",
          "text": "我们快过去吧！"
        },
        {
          "type": "subtitle",
          "text": "追上妮露"
        },
        {
          "role": "赛索斯",
          "text": "居然都走这么远了…"
        },
        {
          "role": "妮露",
          "text": "是不是快到了呢…"
        },
        {
          "role": "派蒙",
          "text": "妮露——！"
        },
        {
          "role": "妮露",
          "text": "欸？"
        },
        {
          "role": "派蒙",
          "text": "妮露！我们来啦！千万别被坏人…啊？"
        },
        {
          "role": "赛索斯",
          "text": "嗯？「坏人」…是说我吗？"
        },
        {
          "role": "赛诺",
          "text": "怎么是你小子…"
        },
        {
          "role": "赛索斯",
          "text": "我怎么了吗？"
        },
        {
          "role": "妮露",
          "text": "你们怎么来了？"
        },
        {
          "role": "派蒙",
          "text": "怎么都在问问题？呃…我也被传染了…"
        },
        {
          "role": "斯露莎",
          "text": "真是何等聒噪！吾等想要找个清净的地方练习都不行吗？"
        },
        {
          "role": "派蒙",
          "text": "斯露莎？！"
        },
        {
          "role": "旅行者",
          "text": "好久不见！"
        },
        {
          "role": "斯露莎",
          "text": "是吾之「谒颂主」和白飘飘！"
        },
        {
          "role": "赛诺",
          "text": "你们和这个红飘飘认识？"
        },
        {
          "role": "斯露莎",
          "text": "喂，你说谁红飘飘呢！吾斯露莎乃高贵的花灵！灵光之勇者！"
        },
        {
          "role": "派蒙",
          "text": "呃…她是我们在甘露花海认识的花灵，人其实挺好的，就是说话有些奇怪。"
        },
        {
          "role": "坎蒂丝",
          "text": "嗯？赛索斯先生身上的是…"
        },
        {
          "role": "赛索斯",
          "text": "哦？是说这碎裂的「乌婕特之眼」吗？"
        },
        {
          "role": "派蒙",
          "text": "欸！原来买下了另一块宝石的是你？"
        },
        {
          "role": "赛诺",
          "text": "「乌婕特之眼」…还有「花灵」…我好像在书中读到过…"
        },
        {
          "role": "赛索斯",
          "text": "那你应该猜到事情的来龙去脉了吧？"
        },
        {
          "role": "赛诺",
          "text": "现在不是猜谜的时候，城里的大家都在为妮露担心。"
        },
        {
          "role": "妮露",
          "text": "欸…？担心我？可我不是…给大家留了口信吗？"
        },
        {
          "role": "派蒙",
          "text": "口信？什么口信…"
        },
        {
          "role": "坎蒂丝",
          "text": "我们没有收到类似的东西…"
        },
        {
          "role": "斯露莎",
          "text": "啊？！拉沙鲁这家伙…该不会半途又睡着了吧！"
        },
        {
          "role": "派蒙",
          "text": "呃…听到这名字之后，我好像猜到发生了什么…"
        },
        {
          "role": "赛诺",
          "text": "拉沙鲁是谁？"
        },
        {
          "role": "妮露",
          "text": "就是我拜托传达口信的花灵。只不过…她看起来一直很没精神呢…"
        },
        {
          "role": "派蒙",
          "text": "等等等等…事情太多了，我们一件件来…先说妮露为什么会和斯露莎还有赛索斯一起来这里吧？"
        },
        {
          "role": "赛索斯",
          "text": "这个要解释起来的话…嗯，那就从我遇到斯露莎那时说起吧。"
        },
        {
          "type": "subtitle",
          "text": "阻拦商队"
        },
        {
          "role": "米希尔",
          "text": "斯露莎，他们来了。"
        },
        {
          "role": "斯露莎",
          "text": "哼，这群贪得无厌的家伙，前阵子在沙漠里轰隆隆搞破坏的就是他们！"
        },
        {
          "role": "拉沙鲁",
          "text": "呼…呼…呼…"
        },
        {
          "role": "斯露莎",
          "text": "打起精神来啊！不给他们些教训的话以后可睡不了安稳觉！"
        },
        {
          "role": "拉沙鲁",
          "text": "呼…呼…呼…"
        },
        {
          "role": "斯露莎",
          "text": "……"
        },
        {
          "role": "米希尔",
          "text": "那么，斯露莎，一会儿等那些家伙经过时，我会驱使荆棘困住他们，接下来就交给你…"
        },
        {
          "role": "斯露莎",
          "text": "嗯嗯，这点小事不在话下！"
        },
        {
          "role": "斯露莎",
          "text": "就让那些家伙尝尝，颤栗与恐惧为何物吧！"
        },
        {
          "role": "雅库普",
          "text": "……"
        },
        {
          "role": "海兹尔",
          "text": "啊！怎么回事！荆…荆棘！"
        },
        {
          "role": "阿鲁吉",
          "text": "老大！车动不了了！"
        },
        {
          "role": "雅库普",
          "text": "…啊？"
        },
        {
          "role": "斯露莎",
          "text": "就是此刻！"
        },
        {
          "type": "subtitle",
          "text": "破坏商队的货车"
        },
        {
          "type": "subtitle",
          "text": "与赛索斯对话"
        },
        {
          "role": "斯露莎",
          "text": "哼哼哼，汝等受死吧！"
        },
        {
          "role": "赛索斯",
          "text": "意思意思就差不多了吧？"
        },
        {
          "role": "斯露莎",
          "text": "嗯？汝是何人？"
        },
        {
          "role": "赛索斯",
          "text": "我叫赛索斯，散步途中听见了这边的动静，就来凑凑热闹。"
        },
        {
          "role": "赛索斯",
          "text": "我看他们的货物已经全被你给销毁了，不如就此收手？事情闹大了可不好收场。"
        },
        {
          "role": "斯露莎",
          "text": "小小后辈，汝可识得吾为何人？"
        },
        {
          "role": "赛索斯",
          "text": "尊贵而伟大的花灵，沙漠之子无人不识你们的名字。更何况是名为斯露莎的勇者呢？"
        },
        {
          "role": "斯露莎",
          "text": "哦？看来你还挺有眼光的嘛。也罢，那今天就到此为止。"
        },
        {
          "role": "斯露莎",
          "text": "但若是再有下次，吾灵光之勇者绝不会再对此等破坏沙漠安宁的恶徒手下留情！"
        },
        {
          "type": "subtitle",
          "text": "回到当下……"
        },
        {
          "role": "赛索斯",
          "text": "后来，我和斯露莎聊得还挺投缘，就干脆当起了她在须弥城的向导。"
        },
        {
          "role": "派蒙",
          "text": "你还真是对谁都能自来熟…"
        },
        {
          "role": "斯露莎",
          "text": "嗯！我十分满意这位向导的工作。此番前来，我可是身怀重任！"
        },
        {
          "role": "派蒙",
          "text": "嗯？什么重任…"
        },
        {
          "role": "斯露莎",
          "text": "我从过路人口中听闻小吉祥草王大人正于城内庆生，吾等花灵乃小吉祥草王大人之眷属，便想为之准备一份特殊的贺礼。"
        },
        {
          "role": "斯露莎",
          "text": "祖尔宛前辈思来想去，最终决定由花灵中的勇者——也就是我，为小吉祥草王大人献上传承了数百年的「花神之舞」。"
        },
        {
          "role": "赛索斯",
          "text": "我半路提醒斯露莎，花神之舞的人选已定，但她说什么都要去见见妮露小姐。"
        },
        {
          "role": "斯露莎",
          "text": "哼！不见倒还好，没想到现在的花神之舞竟早已不是当年的模样！"
        },
        {
          "role": "派蒙",
          "text": "毕竟都传了几百年…有区别也正常嘛…"
        },
        {
          "role": "妮露",
          "text": "但听说能看到很久以前的花神之舞，我就请斯露莎前辈务必教一教我。"
        },
        {
          "role": "妮露",
          "text": "这个机会实在太难得了！如果我能为今年的花神诞祭献上这支特别的舞蹈，草神大人和参加节日的人们一定也会高兴的。"
        },
        {
          "role": "斯露莎",
          "text": "嗯，看小姑娘觉悟不错，我便邀她前来此处，寻个安静的地方练舞。"
        },
        {
          "role": "派蒙",
          "text": "原来是这么回事…"
        },
        {
          "role": "派蒙",
          "text": "搞半天我们追来追去，根本就没有什么坏人嘛！大家都只是想为纳西妲献上自己的「惊喜」。"
        },
        {
          "role": "赛索斯",
          "text": "慢慢慢，别把那一众商队的人给忘了，还不知道他们究竟做了什么呢。"
        },
        {
          "role": "坎蒂丝",
          "text": "沙漠中搞破坏…恐怕是为了一己私利，非法盗掘遗迹陵墓之人吧。"
        },
        {
          "role": "赛诺",
          "text": "所以才选择了如此偏僻，不会经过阿如村的方向吗…要是被你发现的话…"
        },
        {
          "role": "坎蒂丝",
          "text": "那就不仅仅是恐惧与战栗这么简单了…我会让他们想念起白日的太阳…"
        },
        {
          "role": "派蒙",
          "text": "坎蒂丝…突然变得好可怕…"
        },
        {
          "role": "赛索斯",
          "text": "对了，坎蒂丝小姐，我注意到你身上携带着另一半「乌婕特之眼」。"
        },
        {
          "role": "派蒙",
          "text": "对哦！这到底是什么东西啊？"
        },
        {
          "role": "赛诺",
          "text": "是赤王阿赫玛尔大人当年赠予小吉祥草王纳西妲大人的礼物。"
        },
        {
          "role": "旅行者",
          "text": "（他们说的…其实是大慈树王吧？只不过现在的世界树已经…）"
        },
        {
          "role": "赛索斯",
          "text": "没错，看来你也读到过那段传说。"
        },
        {
          "role": "赛诺",
          "text": "但仅仅是有印象而已，在此之前，我都没将这两块宝石与传说中的神物联系到一起。"
        },
        {
          "role": "赛索斯",
          "text": "嗯，我也是见这石头有些特殊，从商人手中买下带回缄默之殿后，查询了诸多文献才确定的。"
        },
        {
          "role": "赛索斯",
          "text": "——传说在那「第一次花神诞祭」的时候，赤王阿赫玛尔大人与花神玛莉卡塔大人为小吉祥草王准备了惊喜。"
        },
        {
          "role": "赛索斯",
          "text": "他们沿途散落糖果作为线索，引小吉祥草王前往宴会之地。"
        },
        {
          "role": "赛索斯",
          "text": "好奇的小吉祥草王来到一处湖边。忽闻一声琴音，原来是阿赫玛尔大人开始拨弦奏乐…而玛莉卡塔大人则跳起了美丽的舞蹈。"
        },
        {
          "role": "赛索斯",
          "text": "他们一同祝愿亲爱的草神能在这伟大的日子感到诞生之喜，并各自送给她一件珍贵的礼物…"
        },
        {
          "role": "赛索斯",
          "text": "玛莉卡塔大人献出了「灵光」，用以守护雨林。阿赫玛尔大人则赠出「乌婕特之眼」，用以记录三人共处的美好时光。"
        },
        {
          "role": "赛诺",
          "text": "但坎瑞亚灾变后，「乌婕特之眼」就已佚失，被掩埋进了黄沙之中。"
        },
        {
          "role": "斯露莎",
          "text": "「灵光」则由小吉祥草王塑成神鸟，护佑生死两界…直至其破碎，最终化为吾等花灵。"
        },
        {
          "role": "派蒙",
          "text": "所以坎蒂丝看到的，其实是记录在「乌婕特之眼」中的景象！"
        },
        {
          "role": "赛索斯",
          "text": "我刚拿到的时候也很惊讶，没想到如此长时间过去，传说中的「乌婕特之眼」依旧在记录所见之物。"
        },
        {
          "role": "赛索斯",
          "text": "它的力量奇特，似乎只有阿赫玛尔的子民，也就是俗说的「赤王后裔」才能与之共鸣。"
        },
        {
          "role": "赛索斯",
          "text": "虽然如今已然破损，但往日的景象仍存续于其中某处。"
        },
        {
          "role": "坎蒂丝",
          "text": "（难道我先前听到的模糊话语，是阿赫玛尔大人与花神大人的对话…）"
        },
        {
          "role": "坎蒂丝",
          "text": "你打算如何处理这两块「乌婕特之眼」的碎片？"
        },
        {
          "role": "赛索斯",
          "text": "如果坎蒂丝小姐允许，我想将它们归入到缄默之殿的保管范畴内。"
        },
        {
          "role": "坎蒂丝",
          "text": "嗯，我赞同此种处理方法。"
        },
        {
          "role": "斯露莎",
          "text": "按理说这是小吉祥草王所有之物，你们不打算还给她吗？"
        },
        {
          "role": "旅行者",
          "text": "（……）"
        },
        {
          "role": "坎蒂丝",
          "text": "还是不了吧…"
        },
        {
          "role": "坎蒂丝",
          "text": "不论草神大人记得与否，这份破碎的回忆，如今恐怕只余哀伤…"
        },
        {
          "role": "旅行者",
          "text": "（旧日悲伤的往事…作为纳西妲如今的朋友，我也不希望她在生日这天感到难过…）"
        },
        {
          "role": "斯露莎",
          "text": "我还无法完全理解你们话语中的考量，但既是你们，以及吾之「谒颂主」的决定，我也不再多言。"
        },
        {
          "role": "斯露莎",
          "text": "倒是从刚才起便慢慢吞吞说到现在，还让不让我教她「花神之舞」了！"
        },
        {
          "role": "派蒙",
          "text": "也是呢，既然都知道了是虚惊一场，我们就回去告诉大家原委吧，别让他们担心。"
        },
        {
          "role": "赛诺",
          "text": "我也去给其他风纪官提个醒，仔细查查那伙商队的犯罪证据，如有劣迹，绝不轻饶。"
        },
        {
          "role": "赛索斯",
          "text": "我就继续待在这里吧，附近魔物也不少，多个人当护卫肯定不是坏事。"
        },
        {
          "role": "妮露",
          "text": "抱歉让大家担心了，等我学会这支舞，就回去给大家帮忙。"
        },
        {
          "role": "斯露莎",
          "text": "注意力集中！别再走神了！好好跟随我的舞姿！"
        },
        {
          "role": "妮露",
          "text": "是！斯露莎老师！"
        },

        {
          "type": "subtitle",
          "text": "额外对话（斯露莎&妮露）"
        },
        {
          "role": "心声（妮露）",
          "text": "（从前的花神之舞…原来是这样…）"
        },
        {
          "role": "斯露莎",
          "text": "看好——先这样，然后是这样…"
        },
        {
          "role": "妮露",
          "text": "先这样…然后这样…"
        },
         {
          "type": "subtitle",
          "text": "额外对话（赛索斯）"
        },
        {
          "role": "心声（赛索斯）",
          "text": "（「乌婕特之眼」中埋藏的历史…）"
        },
        {
          "role": "赛索斯",
          "text": "你们去忙吧，这里有我在。"
        },


        {
          "type": "subtitle",
          "text": "返回禅那园"
        },
        {
          "role": "迪希雅",
          "text": "哎！你们总算回来了！我都急到要去通知我的佣兵兄弟了！"
        },
        {
          "role": "柯莱",
          "text": "没出什么事吧？"
        },
        {
          "role": "派蒙",
          "text": "没什么没什么，虚惊一场！"
        },
        {
          "role": "提纳里",
          "text": "…呼，忙半天是这么回事。都解决了就好。"
        },
        {
          "role": "派蒙",
          "text": "这边呢？给纳西妲的惊喜准备得怎么样了？"
        },
        {
          "role": "提纳里",
          "text": "卡维把图纸交给我们后，就回去睡觉了。看他那样子，昨晚恐怕是通宵了吧。"
        },
        {
          "role": "迪希雅",
          "text": "你们不在的时间里，我们已经把糖塔的框架搭出来了。"
        },
        {
          "role": "迪娜泽黛",
          "text": "但稍后我还是再检查一遍吧，刚才我们都是一边担心着你们一边搭的…"
        },
        {
          "role": "提纳里",
          "text": "总之，剩下的事情已经不多了，大家齐心协力的话，很快就能完成。"
        },
        {
          "role": "派蒙",
          "text": "好欸！这么说不用担心赶不上花车巡游了！"
        },
        {
          "role": "提纳里",
          "text": "哦，说到花车巡游。旅行者，能拜托你件事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "只要能帮上忙…",
            "不必客气。"
          ]
        },
        {
          "role": "提纳里",
          "text": "教令院那边希望各学院代表推举一名人选，去担任花车巡游当天的「花之骑士」一职。"
        },
        {
          "role": "提纳里",
          "text": "我们商量之后，一致觉得应该由你来担任这个角色。你意下如何？"
        },
        {
          "role": "旅行者",
          "text": "荣幸之至。"
        },
        {
          "role": "提纳里",
          "text": "那就太好了。你是草神大人的朋友，也是拯救了须弥的英雄，大家都觉得你是最合适的人选。"
        },
        {
          "role": "迪希雅",
          "text": "到时候可得好好表现哟！"
        },
        {
          "role": "柯莱",
          "text": "不用给他压力啦。"
        },
        {
          "role": "迪希雅",
          "text": "哎，坎蒂丝这次不也在花车队伍里吗？我记得…是去弹琴来着？"
        },
        {
          "role": "坎蒂丝",
          "text": "没错，我负责为妮露小姐的舞步予以伴奏。"
        },
        {
          "role": "派蒙",
          "text": "哇！我都还没听过坎蒂丝的演奏呢！"
        },
        {
          "role": "坎蒂丝",
          "text": "哈…你们要是喜欢的话，欢迎常来阿如村找我，我会用琴声伴你们入眠的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "一定常来。",
            "期待你的琴声。"
          ]
        },
        {
          "role": "迪娜泽黛",
          "text": "对了 ，旅行者，我也有事想拜托你。"
        },
        {
          "role": "迪娜泽黛",
          "text": "这是我们为草神大人的花车做的装饰，能请你晚些时候到净善宫去，把它们挂在花车上吗？"
        },
        {
          "role": "迪娜泽黛",
          "text": "由花之骑士亲自装饰花车，一定会更有仪式感。"
        },
        {
          "role": "旅行者",
          "text": "好，我明白了。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，这点小事尽管交给我们！"
        },
        {
          "type": "subtitle",
          "text": "大家分工合作，怀着期待的心情一丝不苟地干起活来…",
          "narration": true,
          "color": "介绍"
        },
        {
          "type": "subtitle",
          "text": "很快便到了夜晚，大家各自散去…",
          "narration": true,
          "color": "介绍"
        },
        {
          "type": "subtitle",
          "text": "前往净善宫装饰花车"
        },

        {
          "role": "派蒙",
          "text": "这样就可以了吧？接下来就只需要等待明早的花车巡游了！"
        },
        {
          "type": "subtitle",
          "text": "等待花车巡游开始"
        },
        {
          "type": "subtitle",
          "text": "等待到明天",
          "narration": true,
          "color": "介绍"
        },
        {
          "role": "纳西妲",
          "text": "……"
        },
        {
          "role": "纳西妲",
          "text": "（…总觉得最近大家都躲着我呢，就像秋天树洞里的松鼠一样，一个劲地在藏东西。）"
        },
        {
          "role": "纳西妲",
          "text": "（不行不行，花车巡游结束后，一定要找机会问个明白！）"
        },
        {
          "role": "纳西妲",
          "text": "（生日啊…这个特殊的日子里，有漂亮的花车、好吃的糖果，还有…）"
        },
        {
          "role": "纳西妲",
          "text": "啊…！"
        },
        {
          "role": "旅行者",
          "text": "久等了，我的神明。"
        },
        {
          "role": "纳西妲",
          "text": "嗯！出发吧，我的骑士！"
        },


        {
          "type": "subtitle",
          "text": "过场动画「花与美梦」"
        },
        {
          "role": "纳西妲",
          "text": "花车颠呀颠，纳西妲睁开眼"
        },
         {
          "role": "纳西妲",
          "text": "她说，纳西妲的生日就是今天"
        },
         {
          "role": "纳西妲",
          "text": "花之骑士和侍从们将她发现"
        },
         {
          "role": "纳西妲",
          "text": "「神明啊，可算找到你了，大家都期待与你见面。」"
        },
         {
          "role": "旅行者",
          "text": "花神诞祭开幕了，人们围着她快乐地转着圈"
        },
        {
          "type": "subtitle",
          "text": "坎蒂丝演奏着乐器与旅行者一起走在花车前，妮露跳起花神之舞，踏过的地方长出帕蒂沙兰…",
          "narration": true,
          "color": "描述"
        },
         {
          "role": "路人",
          "text": "那是…帕蒂沙兰？"
        },
         {
          "role": "纳西妲",
          "text": "花之骑士和侍从们为她准备了惊喜"
        },
        {
          "type": "subtitle",
          "text": "斯露莎出现在草神身旁，和花灵们一起变出了许多糖果…",
          "narration": true,
          "color": "描述"
        },
         {
          "role": "纳西妲",
          "text": "甜蜜的糖果，像烟花一般绽放在她身边"
        },
         {
          "role": "卡维",
          "text": "准备好，三、二、一…！"
        },
         {
          "role": "纳西妲",
          "text": "花车碰上了缤纷的鸟雀，七彩的喜悦飞旋于人们眼前"
        },
         {
          "role": "纳西妲",
          "text": "其实…我也有惊喜要送给你们哟"
        },
         {
          "role": "纳西妲",
          "text": "出来吧~"
        },
        {
          "type": "subtitle",
          "text": "许许多多的兰那罗出现在人们的身旁，纳西妲赠予了民众一场美丽的梦境…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "纳西妲",
          "text": "花车颠呀颠，纳西妲睁开眼"
        },
         {
          "role": "纳西妲",
          "text": "她说刚刚就像做了个梦"
        },
         {
          "role": "纳西妲",
          "text": "因为自己从没见过如此美妙的庆典…"
        },
        
       

























        {
          "type": "subtitle",
          "text": "回到禅那园"
        },
        {
          "type": "subtitle",
          "text": "花车巡游顺利结束，大家一起回到了禅那园…",
          "narration": true,
          "color": "介绍"
        },
        {
          "role": "卡维",
          "text": "庆祝我们的「生日惊喜」计划，圆满成功！"
        },
        {
          "role": "卡维",
          "text": "干杯——！"
        },
        {
          "role": "珐露珊",
          "text": "我知道——我就知道自己的眼光没有错！"
        },
        {
          "role": "珐露珊",
          "text": "卡维，你果然是位建筑天才！"
        },
        {
          "role": "卡维",
          "text": "呃，前…前辈，你好像喝得有些多了…"
        },
        {
          "role": "提纳里",
          "text": "珐露珊前辈自从看到糖塔撞上花车后，就异常兴奋。刚才悄悄多喝了几杯，我可是看见了。"
        },
        {
          "role": "迪希雅",
          "text": "这不是正好吗！节日就该开开心心才对嘛！"
        },
        {
          "role": "迪希雅",
          "text": "哎我说，坎蒂丝你琴弹得也太好了吧！怎么平时不多拿出来露两手？"
        },
        {
          "role": "坎蒂丝",
          "text": "啊，我多半是在守夜时闲来无事，才一边望着夜晚的星空弹上两曲。"
        },
        {
          "role": "妮露",
          "text": "好羡慕那些星星啊…"
        },
        {
          "role": "坎蒂丝",
          "text": "比起我的琴声，妮露小姐的舞姿，才是节日里人们目不转睛的焦点啊。"
        },
        {
          "role": "妮露",
          "text": "欸？怎么又夸到我身上了…"
        },
        {
          "role": "艾尔海森",
          "text": "原来如此，「乌婕特之眼」现已交由缄默之殿保管。"
        },
        {
          "role": "赛索斯",
          "text": "要借给你研究研究吗？"
        },
        {
          "role": "艾尔海森",
          "text": "没必要。这类物件仅仅代表一段历史，一旦其所象征的往事被阐明，它就恢复成原本的介质了。"
        },
        {
          "role": "卡维",
          "text": "真的？我还以为你挺想看看这东西的呢，一块宝石能叫这个名字，一定非常漂亮，看一眼不亏啊。"
        },
        {
          "role": "艾尔海森",
          "text": "看一眼得特地去一趟缄默之殿，有点远。"
        },
        {
          "role": "卡维",
          "text": "我说，你多出门走走行不行？"
        },
        {
          "role": "艾尔海森",
          "text": "如果有人带它去教令院做品质鉴定和宝石等级公证，我倒是可以顺便看一眼。"
        },
        {
          "role": "赛诺",
          "text": "你别说，我还真想知道这东西值多少钱。"
        },
        {
          "role": "赛索斯",
          "text": "好问题，我都没想过…就像古代王宫的城墙，你也不会突然掰下一块拿去估值对吧。"
        },
        {
          "role": "卡维",
          "text": "嘶…我们院的人很可能会干这种事…听说这几届学弟学妹都挺有好奇心的呢。"
        },
        {
          "role": "艾尔海森",
          "text": "如果真有这种砖，记得写份报告书发到我办公室。"
        },
        {
          "role": "卡维",
          "text": "咦？这些流程需要报告给你吗？"
        },
        {
          "role": "艾尔海森",
          "text": "不需要，但能有效通知我砖头到了，快去看一眼。"
        },
        {
          "role": "卡维",
          "text": "我到底为什么要问…真的不能再随口接话了…"
        },
        {
          "role": "提纳里",
          "text": "原来报告还能当闹钟用，倒是个思路。"
        },
        {
          "role": "赛诺",
          "text": "闹钟，我现在也感受到了闹钟！朋友们，一个伟大的时刻降临了。"
        },
        {
          "role": "赛索斯",
          "text": "有吗？我没感觉到啊，赫曼努比斯叫你不叫我？"
        },
        {
          "role": "赛诺",
          "text": "现在，应该是七圣…"
        },
        {
          "role": "提纳里",
          "text": "柯莱好像在叫我，我先走一步。"
        },
        {
          "role": "赛索斯",
          "text": "唉…牌牌牌，就知道打牌…柯莱能不能也叫叫我？"
        },
        {
          "role": "纳西妲",
          "text": "大家都玩得很开心呢。"
        },
        {
          "role": "旅行者",
          "text": "纳西妲开心吗？"
        },
        {
          "role": "纳西妲",
          "text": "嗯！这会是我所过的，最难忘的一次生日！"
        },
        {
          "role": "斯露莎",
          "text": "草神大人您拥有漫长的生命旅途，现在下此结论是否为时过早？"
        },
        {
          "role": "纳西妲",
          "text": "不会的哦，有些事，在发生的那一刻，你就知道自己永远都不会忘记。"
        },
        {
          "role": "纳西妲",
          "text": "你叫斯露莎对吧？你和你的朋友，考虑来须弥城里住吗？"
        },
        {
          "role": "斯露莎",
          "text": "这…感谢您的好意，草神大人，但吾辈花灵也有自己的职责…而且对于我们来说，城里实在是太吵闹了。"
        },
        {
          "role": "纳西妲",
          "text": "是这样吗？不过…要是和人们待得多了你就会发现，有些时候还是很有趣的哦。"
        },
        {
          "role": "斯露莎",
          "text": "唔…我承认这点。我经常回忆起和吾之「谒颂主」还有白飘飘在一起的时光。"
        },
        {
          "role": "派蒙",
          "text": "哇！真的吗？听你这么说我好高兴！"
        },
        {
          "role": "派蒙",
          "text": "这么一想的话，这次花神诞祭，还真是所有人都获得了「惊喜」呢！"
        },
        {
          "role": "派蒙",
          "text": "特别是纳西妲你叫兰那罗们出来的时候，我都吓一跳呢！"
        },
        {
          "role": "纳西妲",
          "text": "你们喜欢就好，我还悄悄嘱咐过他们不要被你们发现呢。"
        },
        {
          "role": "派蒙",
          "text": "怪不得我们遇到兰萨卡的时候他那么慌张，原来怕说漏嘴的是这个！"
        },
        {
          "role": "派蒙",
          "text": "不过须弥的大家，都以为那只是纳西妲送给他们的一场梦呢。"
        },
        {
          "role": "纳西妲",
          "text": "梦啊…"
        },
        {
          "role": "派蒙",
          "text": "纳西妲？"
        },
        {
          "role": "纳西妲",
          "text": "哦，没事。我只是在想…现在的我们，会不会也只是在一场梦里呢…"
        },
        {
          "role": "旅行者",
          "text": "（……）"
        },
        {
          "role": "旅行者",
          "text": "那就去记下这场梦吧！"
        },
        {
          "role": "纳西妲",
          "text": "欸？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "将此刻永远留驻。",
            "让它变成醒来都不会忘的梦。"
          ]
        },
        {
          "role": "旅行者",
          "text": "（当初阿赫玛尔送出「乌婕特之眼」时，一定也是这么想的吧…）"
        },
        {
          "role": "旅行者",
          "text": "（虽然不及「乌婕特之眼」，但我们此刻也有让时间停驻的方法。）"
        },
        {
          "role": "纳西妲",
          "text": "可是…要怎么做才…"
        },
        {
          "role": "旅行者",
          "text": "（嘿嘿…）"
        },
        {
          "role": "卡维",
          "text": "好了好了，大家靠一靠，左边的人，再站过来一些！"
        },
        {
          "role": "珐露珊",
          "text": "…谁踩着我鞋子了！"
        },
        {
          "role": "柯莱",
          "text": "呃！抱歉…前辈，是我…人有些多…"
        },
        {
          "role": "斯露莎",
          "text": "白飘飘！这里是属于尊贵花灵的位置！"
        },
        {
          "role": "派蒙",
          "text": "哼！旅行者旁边飘着的只能有我一个！"
        },
        {
          "role": "纳西妲",
          "text": "原来是「留影」吗？哈哈…真是奇妙的思考角度。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "以后每当看向画片的时候…",
            "都能回想起此刻的幸福…"
          ]
        },
        {
          "role": "纳西妲",
          "text": "虽然我没有这种事情的「经验」，不过，我相信你。"
        },
        {
          "role": "纳西妲",
          "text": "我相信此刻的时间，会为我们而停驻。"
        },
        {
          "role": "提纳里",
          "text": "卡维，你也过来吧！"
        },
        {
          "role": "卡维",
          "text": "好！我调个时间…来了来了！"
        },
        {
          "role": "卡维",
          "text": "大家准备好！三——二——一！"
        },
        {
          "role": "柯莱",
          "text": "生日快乐——！"
        }
      ],
