{
  "quest_id": 76030,
  "chapter_num": null,
  "chapter_title": "归家的微光",
  "type": "wq",
  "route": "Homecoming's Faint Glow",
  "stories": [
    {
      "story_id": 76030,
      "title": "归家的微光",
      "description": "在「银月之庭」，月灵们似乎在做一些有趣的事…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "同「少女」见面"
        },
        {
          "role": "「少女」",
          "text": "往左边一点。"
        },
        {
          "role": "「少女」",
          "text": "那边往右一些。"
        },
        {
          "role": "「少女」",
          "text": "嗯，不错。"
        },
        {
          "role": "派蒙",
          "text": "哦~今天这里的氛围有些不寻常嘛，哥伦比娅你在装点这处花田吗？"
        },
        {
          "role": "「少女」",
          "text": "不是我，是它们。"
        },
        {
          "role": "派蒙",
          "text": "它们…月灵？"
        },
        {
          "role": "「少女」",
          "text": "这种石头在吸收了月矩力之后会泛出微光，月灵们很喜欢。"
        },
        {
          "role": "派蒙",
          "text": "所以它们就…把石头放在地上玩？"
        },
        {
          "role": "「少女」",
          "text": "你们到这里来。"
        },
        {
          "role": "派蒙",
          "text": "嗯？"
        },
        {
          "role": "派蒙",
          "text": "哦！原来从高处看的话是一幅画欸！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "但好像缺了一块…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "有些不够了，我去采一点吧。"
        },
        {
          "role": "派蒙",
          "text": "咦？你要出去采？"
        },
        {
          "role": "「少女」",
          "text": "我知道一处不错的地方，那里月光照拂，有很多这样的石头。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "要我们陪你吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "好啊。"
        },
        {
          "role": "派蒙",
          "text": "嗯，那就多采一些吧，我们也想看看完整的画呢。"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点采集矿石"
        },
        {
          "type": "subtitle",
          "text": "采集矿石"
        },
        {
          "type": "subtitle",
          "text": "采集附近的特殊矿石",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "同「少女」对话"
        },
        {
          "role": "派蒙",
          "text": "这样就够了吧。总觉得已经采了好多好多。"
        },
        {
          "role": "派蒙",
          "text": "我们回去吧，也不能老让那画缺一块。"
        },
        {
          "role": "莉洁卡",
          "text": "呜呜…呜呜…"
        },
        {
          "role": "派蒙",
          "text": "呀！有人过来了，先躲起来！"
        },
        {
          "role": "莉洁卡",
          "text": "呜呜…这里是哪里呀…妈妈…我想回家…"
        },
        {
          "role": "派蒙",
          "text": "看起来是「霜月之子」的人欸，她迷路了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我去帮帮她吧…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「少女」",
          "text": "真的吗？"
        },
        {
          "role": "派蒙",
          "text": "啊？这怎么看都得帮吧！"
        },
        {
          "role": "「少女」",
          "text": "我记得「霜月之子」对「外来者」很戒备。这么晚了，你头上没有角冠，如果她反倒被吓跑…"
        },
        {
          "role": "派蒙",
          "text": "你…你说得倒的确有可能，但也不能就这么不管吧！"
        },
        {
          "role": "「少女」",
          "text": "唔…跟我来。"
        },
        {
          "role": "派蒙",
          "text": "欸？"
        },
        {
          "type": "subtitle",
          "text": "帮助迷路的孩子"
        },
        {
          "type": "subtitle",
          "text": "利用矿石搭建道路的指引"
        },
        {
          "type": "subtitle",
          "text": "同「少女」合作，利用矿石搭建道路的指引",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "莉洁卡",
          "text": "呜呜…咦？这是…"
        },
        {
          "role": "莉洁卡",
          "text": "好漂亮…"
        },
        {
          "role": "「少女」",
          "text": "这样就好了。"
        },
        {
          "role": "派蒙",
          "text": "她一路捡着石头回去了，那边是「霜月之坊」的方向呢。"
        },
        {
          "role": "旅行者",
          "text": "（哥伦比娅…虽说自己不想被当作「神明」，但还是会帮助遇到困难的人…）"
        },
        {
          "role": "派蒙",
          "text": "啊，但这么一来，那幅画是不是就…"
        },
        {
          "role": "「少女」",
          "text": "没关系。"
        },
        {
          "role": "「少女」",
          "text": "残缺的画可以之后再添上。"
        },
        {
          "role": "「少女」",
          "text": "我喜欢看人们找到「回家」的路，回到属于他们的「家」。"
        }
      ]
    }
  ]
}