{
  "quest_id": 70007,
  "chapter_num": null,
  "chapter_title": "图书馆请安静！",
  "type": "wq",
  "route": "\"Quiet, please, this is a library!\"",
  "stories": [
    {
      "story_id": 70007,
      "title": "图书馆请安静！",
      "description": "在图书馆进行研究的艾拉·马斯克好像遇到了很让人困扰的事…",
      "dialogues": [
        {
          "role": "艾拉·马斯克",
          "text": "Ye ika gusha mosi！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "感觉你心情不太好…",
            "语气比平常更凶了。"
          ]
        },
        {
          "role": "旅行者",
          "text": "感觉你心情不太好…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "不好意思，因为最近图书馆实在非常吵闹，我很难安静下来研究丘丘人语。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "风花节开始之后，有很多人到这里来约会。他们一开始还能保持安静地看看书，后来就聊起来了。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "而且…而且他们还做了各种可怕的事…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "把书的书角折坏…在书页里塞各种奇奇怪怪的东西…甚至、甚至他们还把书倒着插进书架！"
        },
        {
          "role": "艾拉·马斯克",
          "text": "图书馆可不是谈情说爱的地方！这样只会打扰到真正在这里看书做研究的人！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "威拉格应该来维持秩序。",
            "可以找丽莎…"
          ]
        },
        {
          "role": "旅行者",
          "text": "威拉格应该来维持秩序。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "他也没什么好办法，把人赶走也只是治标不治本。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "总之，麻烦你帮帮忙，让这里的人都安静下来吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "交给我吧。",
            "我试试看。"
          ]
        },
        {
          "role": "旅行者",
          "text": "交给我吧。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "谢谢你，最吵闹的就是那边的三对，只要让他们注意到影响，我就能继续研究了。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "不过当心点，他们都没那么好对付…"
        },
        {
          "role": "热恋中的青年",
          "text": "真是感人的故事啊，可惜最后没有一个圆满的结局。"
        },
        {
          "role": "热恋中的少女",
          "text": "我们以后不会变成那样的，对吧？"
        },
        {
          "role": "热恋中的青年",
          "text": "那是当然的，就算我们天各一方，我也会想办法把你带回我的身边。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "图书馆应该保持安静。",
            "有人说你们太吵了。"
          ]
        },
        {
          "role": "旅行者",
          "text": "图书馆应该保持安静。"
        },
        {
          "role": "热恋中的少女",
          "text": "欸？我应该很克制我的声音了。"
        },
        {
          "role": "热恋中的青年",
          "text": "唉，或许这也是恋爱的阻碍吧…"
        },
        {
          "role": "派蒙",
          "text": "看过的故事书，也应该放回正确的地方。"
        },
        {
          "role": "派蒙",
          "text": "像现在这样随便乱放，负责整理书架的人会很头疼的。"
        },
        {
          "role": "热恋中的青年",
          "text": "知道了，知道了，请不要再打扰我们了，正在关键的时候呢。"
        },
        {
          "role": "派蒙",
          "text": "关键的时候…？"
        },
        {
          "role": "热恋中的少女",
          "text": "不管有多少阻碍，你都会像现在这样，永远不变吧？"
        },
        {
          "role": "热恋中的青年",
          "text": "是的，我以我的生命起誓。"
        },
        {
          "role": "热恋中的少女",
          "text": "也不用这么夸张…生命什么的，我会心疼的。"
        },
        {
          "role": "热恋中的青年",
          "text": "啊，就是你这样的温柔，令人沉醉…"
        },
        {
          "role": "派蒙",
          "text": "我觉得，他们完全没听进去。"
        },
        {
          "role": "陷入爱河的女性",
          "text": "嗯？请问有是什么事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "图书馆应该保持安静。",
            "有人说你们太吵了。"
          ]
        },
        {
          "role": "旅行者",
          "text": "图书馆应该保持安静。"
        },
        {
          "role": "陷入爱河的女性",
          "text": "抱歉，我会注意的，但有时候，这都属于不可抗力。"
        },
        {
          "role": "变魔术的男性",
          "text": "比如，在你没注意到的时候，我从书页的背后取出了一朵玫瑰。"
        },
        {
          "role": "变魔术的男性",
          "text": "从书中诞生的玫瑰，就像你一样，充满了温柔和知性美…"
        },
        {
          "role": "陷入爱河的女性",
          "text": "哇？！好厉害！"
        },
        {
          "role": "派蒙",
          "text": "声音太大了！还有，不能用书本来变魔术！会折坏的！"
        },
        {
          "role": "旅行者",
          "text": "派蒙你的声音也大起来了…"
        },
        {
          "role": "派蒙",
          "text": "哦，对不起，一不小心就…"
        },
        {
          "role": "陷入爱河的女性",
          "text": "你也明白了吧，有时候这就是不可抗力。"
        },
        {
          "role": "陷入爱河的女性",
          "text": "我会注意控制我的声音的，实在不好意思。"
        },
        {
          "role": "派蒙",
          "text": "看起来，他们完全没听进去呢…"
        },
        {
          "role": "看似理性的女性",
          "text": "你所主张的「情感波动会影响研究分析的准确性」，还是没有确切的论据。"
        },
        {
          "role": "看似理性的男性",
          "text": "唉，我明白，我现在可能是陷入了一种奇怪的瓶颈…"
        },
        {
          "role": "看似理性的男性",
          "text": "你们来得正好，我有一个困扰需要听听看外人的意见。"
        },
        {
          "role": "看似理性的男性",
          "text": "如果我要证明我理论的正确性，就要保证我没有情感的波动。"
        },
        {
          "role": "看似理性的男性",
          "text": "但我总是做不到这件事，尤其是和她在讨论的时候，我总是不能冷静下来好好思考。"
        },
        {
          "role": "看似理性的女性",
          "text": "我也觉得有点奇怪，难道是睡眠不足吗？还是昨天酒精摄入过头了呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "总之，图书馆不可以大声讲话。",
            "总之，先压低音量吧。"
          ]
        },
        {
          "role": "旅行者",
          "text": "总之，图书馆不可以大声讲话。"
        },
        {
          "role": "旅行者",
          "text": "总之，先压低音量吧。"
        },
        {
          "role": "看似理性的男性",
          "text": "抱歉，但在弄明白这件事之前，我就是不甘心。"
        },
        {
          "role": "派蒙",
          "text": "完、完全听不明白…"
        },
        {
          "role": "派蒙",
          "text": "呃，总之，不能打扰别人，还有，看过的书不能倒着塞进书架！"
        },
        {
          "role": "派蒙",
          "text": "好吧…他们好像不搭理我们了…"
        },
        {
          "role": "派蒙",
          "text": "唉，好像没人听我们的劝告。"
        },
        {
          "role": "派蒙",
          "text": "他们的用书习惯都不太好，我们只能去找威拉格商量一下了。"
        },
        {
          "role": "旅行者",
          "text": "关于图书馆的吵闹声…"
        },
        {
          "role": "威拉格",
          "text": "原来如此，那应该可以用「那个办法」了。"
        },
        {
          "role": "威拉格",
          "text": "丽莎小姐说过，如果有人违反了图书馆的规定，就必须要受到惩罚…"
        },
        {
          "role": "威拉格",
          "text": "麻烦你们去图书馆里，传达一下丽莎小姐的意思吧。"
        },
        {
          "role": "派蒙",
          "text": "折坏书页、塞玫瑰花进书里、把书倒着插进书架…肯定算是违反了图书馆的规则吧。"
        },
        {
          "role": "派蒙",
          "text": "我们走，去向那些来图书馆却不读书的人传达一下丽莎小姐的意思吧。"
        },
        {
          "role": "派蒙",
          "text": "欸——什么？丽莎小姐马上就要回来了？"
        },
        {
          "role": "派蒙",
          "text": "要是她知道，有人把书乱用乱放的话，还折页损坏，一定会很生气吧？"
        },
        {
          "role": "旅行者",
          "text": "是啊，怎么办呢，真是糟糕啊。"
        },
        {
          "role": "派蒙",
          "text": "要怎么办呢？如果现在开始收拾，还有机会补救吧？"
        },
        {
          "role": "艾拉·马斯克",
          "text": "没想到你们能想到这么好的办法。"
        },
        {
          "role": "旅行者",
          "text": "都是威拉格的主意…"
        },
        {
          "role": "旅行者",
          "text": "还是多亏了丽莎小姐…"
        },
        {
          "role": "艾拉·马斯克",
          "text": "不过要是丽莎小姐看到刚刚的场面，确实会生气吧，这可是图书馆，是学习的地方。"
        },
        {
          "role": "艾拉·马斯克",
          "text": "我终于可以安心做研究了，这是给你们的报酬，谢谢你们。"
        }
      ]
    }
  ]
}