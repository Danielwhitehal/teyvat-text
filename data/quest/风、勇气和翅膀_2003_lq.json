        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "难道有可以来回的机关？",
              "dialogues": [
                {
                  "role": "安柏",
                  "text": "以我的眼力，也看不出这种机关的痕迹。"
                },
                {
                  "role": "安柏",
                  "text": "而且周围也没有能建机关的岩壁。"
