{
  "quest_id": 2003,
  "chapter_num": "小兔之章 第一幕",
  "chapter_title": "风、勇气和翅膀",
  "type": "lq",
  "route": "Wind, Courage, and Wings",
  "stories": [
    {
      "story_id": 481,
      "title": "风之翼随风而起",
      "description": "安柏想要与你讨论关于使用风之翼的问题…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与安柏对话"
        },
        {
          "role": "安柏",
          "text": "旅行者！找你好久了，上次给你的风之翼，用起来怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉还不错。",
              "dialogues": []
            },
            {
              "text": "总是不自觉飞太高。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "看来你用风之翼玩得很开心的样子。"
        },
        {
          "role": "安柏",
          "text": "不过话说回来，你现在肯定还没有飞行执照吧。"
        },
        {
          "role": "派蒙",
          "text": "飞行执照？那是什么东西？"
        },
        {
          "role": "安柏",
          "text": "从名字看也已经很明显了吧？只有拿到飞行执照，才能在蒙德城合法飞行。"
        },
        {
          "role": "派蒙",
          "text": "唔…旅行者都飞了这么久了，之前都没有听说这种东西…"
        },
        {
          "role": "安柏",
          "text": "就是因为你们成天在城里飞来飞去，弄得大家都注意到了！"
        },
        {
          "role": "派蒙",
          "text": "欸嘿。"
        },
        {
          "role": "派蒙",
          "text": "所以，你今天是特意来把飞行执照送来的吗？"
        },
        {
          "role": "安柏",
          "text": "怎么可能！骑士是很有原则的。"
        },
        {
          "role": "安柏",
          "text": "飞行执照先要考试合格，然后再由骑士团统一签发。"
        },
        {
          "role": "安柏",
          "text": "我今天是专门来做你的考官，监督旅行者进行飞行执照考试的！"
        },
        {
          "role": "安柏",
          "text": "毕竟是我把风之翼给你的嘛，要负起责任来——琴团长一定会这么说吧。"
        },
        {
          "role": "派蒙",
          "text": "考试…听起来就很麻烦。但既然是安柏监考，那么…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "能不能稍微通融…",
              "dialogues": [
                {
                  "role": "安柏",
                  "text": "别这么看着人家，绝·对·不·行。"
                }
              ]
            },
            {
              "text": "我靠自己考就好了。",
              "dialogues": [
                {
                  "role": "安柏",
                  "text": "旅行者肯定能顺利通过啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "安柏",
          "text": "只是一点小小的测验，你击退风魔龙时的飞行能力全蒙德有目共睹，肯定没问题的。"
        },
        {
          "role": "安柏",
          "text": "不过，规章制度和飞行标准还是需要遵守的。"
        },
        {
          "role": "安柏",
          "text": "这本飞行指南给你，虽然不用背下来，但还是要熟悉一遍才行。"
        },
        {
          "role": "安柏",
          "text": "比如不允许双人共用一架风之翼，不允许携带超规格重物起飞，不允许使用风史莱姆起飞什么什么的…"
        },
        {
          "role": "安柏",
          "text": "总之，你就好好读一下吧，丽莎姐姐教我魔法的时候，也是要我先看很多厚厚的书的…"
        },
        {
          "role": "派蒙",
          "text": "看起来好厚…没办法了，总之先读读看吧。"
        },
        {
          "role": "安柏",
          "text": "嗯！读完以后就来风起地找我吧。"
        },
        {
          "role": "派蒙",
          "text": "西风骑士团的飞行指南，听起来就很难读…"
        },
        {
          "role": "旅行者",
          "text": "总之先读读看吧。"
        },
        {
          "type": "subtitle",
          "text": "你们不抱期待地打开飞行指南，却惊讶地发现这部本该枯燥乏味的指南语言明快轻松，用浪漫的口吻讲述了鸟儿们学习飞翔的故事。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "是个很好的故事呢…但是骑士团的飞行指南…是这种风格的么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "完全是一本寓言。",
              "dialogues": []
            },
            {
              "text": "蒙德人学习飞行的方式真浪漫…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "不管了，我们还是快去找安柏吧。"
        }
      ]
    },
    {
      "story_id": 480,
      "title": "飞行的许可",
      "description": "安柏专门为你准备了一场考试，在那之前，她还给了你一本「飞行指南」，要你考试前通读一遍。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往考试地点"
        },
        {
          "type": "subtitle",
          "text": "与安柏对话"
        },
        {
          "role": "安柏",
          "text": "啊，你来了。已经把飞行指南好好看过了吗?规章制度都熟悉了吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "倒是看完了，但…",
              "dialogues": []
            },
            {
              "text": "规章制度…实在熟悉不了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "唔，这个勉强的语气，我了解我了解。"
        },
        {
          "role": "安柏",
          "text": "飞行指南就是这么枯燥无趣啦，我也一点都看不下去…呀，别告诉琴团长我说过这话。"
        },
        {
          "role": "派蒙",
          "text": "是吗？我觉得这本「飞行指南」里讲的故事其实还蛮有趣的？"
        },
        {
          "role": "安柏",
          "text": "有趣的故事？哦——你是说后面附录的案例啊？"
        },
        {
          "role": "安柏",
          "text": "有些我也挺喜欢，最喜欢的是用风史莱姆违规起飞的那个。"
        },
        {
          "role": "安柏",
          "text": "借助风史莱姆被打破的时候爆发的气流，说是能一下子飞得很高很高，真想试试看哪——"
        },
        {
          "role": "派蒙",
          "text": "不是这个啦！是一只小鸟想要学会飞行的故事…"
        },
        {
          "role": "安柏",
          "text": "咦…啊？！"
        },
        {
          "role": "安柏",
          "text": "我看看…呀！这不是我小时候最喜欢读的寓言书吗？"
        },
        {
          "role": "安柏",
          "text": "对不起！我昨天把它和骑士团飞行指南放在一起，肯定是出门的时候拿错了。"
        },
        {
          "role": "派蒙",
          "text": "这两本书…有拿错的可能性吗？"
        },
        {
          "role": "安柏",
          "text": "呃…事到如今再聊这个，实在有些不好意思。"
        },
        {
          "role": "安柏",
          "text": "但拿错的原因，也许是因为在我心里，这本书才是教会我飞行的指南吧…"
        },
        {
          "role": "安柏",
          "text": "「重要的不是强风而是勇气，是它让你们成为世上最初的飞鸟」。"
        },
        {
          "role": "安柏",
          "text": "就是这句话给了我飞行的勇气，让我成为侦察骑士，和蒙德城的飞行冠军…"
        },
        {
          "role": "安柏",
          "text": "好了好了，不说这些了，我们赶紧开始考试吧。"
        },
        {
          "role": "安柏",
          "text": "别紧张，只要发挥出你平时的飞行水准就好啦。"
        },
        {
          "role": "旅行者",
          "text": "我准备好了。"
        },
        {
          "role": "安柏",
          "text": "按照我给你标记好的路线，一路平稳地飞到终点吧。"
        },
        {
          "type": "subtitle",
          "text": "按指定路线限时飞抵终点"
        },
        {
          "type": "subtitle",
          "text": "与安柏对话"
        },
        {
          "role": "安柏",
          "text": "很好！不愧是在暴风里也能掌握平衡的你，顺利通过了。"
        },
        {
          "role": "安柏",
          "text": "接下来的测验是在蒙德城，那么我先去城里了，你也快点过来吧。"
        },
        {
          "role": "派蒙",
          "text": "好，我们也快点回蒙德城吧，可别让她等急了。"
        }
      ]
    },
    {
      "story_id": 427,
      "title": "蒙德城的飞行者",
      "description": "原来那本书不是指南，而是童话…这之后你在蒙德野外接受了第一场考试，第二场考试则是在蒙德城。为此，安柏正在城内等你。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "到达蒙德大教堂门前"
        },
        {
          "type": "subtitle",
          "text": "与安柏对话"
        },
        {
          "role": "安柏",
          "text": "喂——我在这我在这。"
        },
        {
          "role": "安柏",
          "text": "我已经布置好了，我们继续考试。"
        },
        {
          "role": "安柏",
          "text": "还是和之前的考试形式一样，穿过标记，一口气飞到终点吧。"
        },
        {
          "role": "旅行者",
          "text": "我准备好了。"
        },
        {
          "type": "subtitle",
          "text": "按指定路线限时飞抵终点"
        },
        {
          "type": "subtitle",
          "text": "与安柏对话"
        },
        {
          "role": "安柏",
          "text": "看来你已经掌握了用风之翼飞行的诀窍，那么我们就开始最后一环吧。"
        },
        {
          "role": "派蒙",
          "text": "毕竟这条路已经飞过一次了呢…"
        },
        {
          "role": "安柏",
          "text": "那么，这是最后一项测试，通过了之后就可以等着飞行执照签发啦。"
        },
        {
          "role": "安柏",
          "text": "朝着飞行执照，预备…"
        },
        {
          "role": "旅行者",
          "text": "…开始！"
        },
        {
          "type": "subtitle",
          "text": "跟随标识，在规定时间内飞到终点"
        },
        {
          "type": "subtitle",
          "text": "按指定路线限时飞抵终点"
        },
        {
          "type": "subtitle",
          "text": "到达冒险家协会门口"
        },
        {
          "role": "奥特",
          "text": "上面正在飞的人！立即就地降落！接受骑士团检查！"
        },
        {
          "role": "奥特",
          "text": "您好，我是西风骑士团的骑士。"
        },
        {
          "role": "派蒙",
          "text": "哇，发生什么了？！"
        },
        {
          "role": "奥特",
          "text": "请出示一下您的飞行执照。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "飞，飞行执照…",
              "dialogues": []
            },
            {
              "text": "被，被兔兔伯爵吃掉…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥特",
          "text": "无证非法飞行，依据蒙德城治安管理法第七条第十二款，请跟我走一趟！"
        },
        {
          "role": "奥特",
          "text": "你有权保持沉默，但是风会牢记你所说的每一句话。"
        },
        {
          "role": "安柏",
          "text": "等等！我们正在进行飞行执照考试。"
        },
        {
          "role": "奥特",
          "text": "啊，是这样吗…"
        },
        {
          "role": "奥特",
          "text": "但在这个时候进行飞行执照考试，真是不巧啊。"
        },
        {
          "role": "安柏",
          "text": "发生什么了吗？"
        },
        {
          "role": "奥特",
          "text": "骑士团刚收到教堂修女的报案，「怪鸟」又用风之翼逃走了，所以刚才我还以为你的考生是那家伙的同伙。"
        },
        {
          "role": "派蒙",
          "text": "怪鸟？那是什么？"
        },
        {
          "role": "奥特",
          "text": "是蒙德城里的一个惯犯。他总是用风之翼作案，所以得到了「怪鸟」这种外号。"
        },
        {
          "role": "安柏",
          "text": "唔，那家伙飞得很快吗？"
        },
        {
          "role": "奥特",
          "text": "目前…我们一次都没能追上过他，这一次本来是想用教堂里的文物做诱饵，把这家伙抓住的。"
        },
        {
          "role": "奥特",
          "text": "可是还是让他带着文物跑了。"
        },
        {
          "role": "奥特",
          "text": "不过，这次修女们已经提前用元素魔法在文物上做好标记了！"
        },
        {
          "role": "奥特",
          "text": "但那家伙飞行的速度太快了，跟着元素痕迹也追不上他。"
        },
        {
          "role": "安柏",
          "text": "居然是个飞行高手，那就摆明了非我安柏出马不可了——嗯，那家伙往哪边逃了？"
        },
        {
          "role": "奥特",
          "text": "据我所知，他最后出现的地点是清泉镇附近，但现在已经过去了这么长时间…"
        },
        {
          "role": "安柏",
          "text": "就放心交给我吧，正好旅行者也在，我们一起追上去，把这只怪鸟抓捕归案吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题。",
              "dialogues": []
            },
            {
              "text": "那飞行执照的考试是不是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "安柏",
          "text": "别担心啦，等抓到怪鸟之后，我就直接…"
        },
        {
          "role": "安柏",
          "text": "…去帮你向琴团长说明情况，咳。"
        }
      ]
    },
    {
      "story_id": 484,
      "title": "那家伙叫「怪鸟」",
      "description": "考试途中骑士奥特错将你当成文物盗贼「怪鸟」的同伙拦下。你们向他澄清误会后，自告奋勇帮忙缉捕「怪鸟」。一场追踪开始了。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "追踪「怪鸟」"
        },
        {
          "type": "subtitle",
          "text": "与安柏对话"
        },
        {
          "role": "安柏",
          "text": "前面就是清泉镇了，周围一定有关于「怪鸟」的线索。"
        },
        {
          "role": "安柏",
          "text": "他带着的文物上，有修女们偷偷标记的风元素痕迹…"
        },
        {
          "role": "派蒙",
          "text": "那就开启元素视野，仔细留意周围吧。"
        },
        {
          "type": "subtitle",
          "text": "搜集线索，追踪「怪鸟」"
        },
        {
          "role": "安柏",
          "text": "这是…碎掉的布片，有风元素的痕迹。"
        },
        {
          "role": "安柏",
          "text": "看图案和编织方式，可能是风之翼的碎片。"
        },
        {
          "role": "派蒙",
          "text": "这样就能看出来是风之翼了吗？不愧是侦察骑士。"
        },
        {
          "role": "安柏",
          "text": "嗯，如果真是怪鸟，那他的风之翼应该已经坏掉了。"
        },
        {
          "type": "subtitle",
          "text": "搜集线索，追踪「怪鸟」"
        },
        {
          "role": "派蒙",
          "text": "这痕迹，会是怪鸟还是风史莱姆呢…"
        },
        {
          "role": "安柏",
          "text": "风史莱姆是漂浮的。除非有人在这里踩着它起飞，不然不可能啦。"
        },
        {
          "role": "派蒙",
          "text": "…有人用风史莱姆做过这种事吗？！"
        },
        {
          "role": "安柏",
          "text": "总之，很清晰的痕迹，把这里先记下来吧。"
        },
        {
          "type": "subtitle",
          "text": "搜集线索，追踪「怪鸟」"
        },
        {
          "role": "安柏",
          "text": "元素的痕迹一直指向了前面。"
        },
        {
          "role": "派蒙",
          "text": "难道怪鸟一直往前方逃走了？"
        },
        {
          "role": "安柏",
          "text": "光是这么猜不会得出结论。"
        },
        {
          "role": "安柏",
          "text": "旅行者，我们顺着痕迹追下去吧。"
        },
        {
          "role": "派蒙",
          "text": "咦，前面好像有什么动静…"
        },
        {
          "role": "安柏",
          "text": "好像是战斗的声音，难道是怪鸟？！"
        },
        {
          "role": "安柏",
          "text": "快，我们赶紧过去吧。"
        },
        {
          "type": "subtitle",
          "text": "上前查看前方异响"
        },
        {
          "type": "subtitle",
          "text": "与法拉对话"
        },
        {
          "role": "法拉",
          "text": "太好了，是西风骑士团的人！丘丘人应该不敢追过来了…"
        },
        {
          "role": "安柏",
          "text": "发生什么了？"
        },
        {
          "role": "法拉",
          "text": "真是倒霉…我们的车队被丘丘人袭击了，还好我们跑得比较快。"
        },
        {
          "role": "安柏",
          "text": "丘丘人袭击？可周围的丘丘人营地，几乎都已经被骑士团清理干净了吧？"
        },
        {
          "role": "法拉",
          "text": "是一个很小的丘丘人营地，和镇里隔着不远，我平时进货摆摊的时候也会特意绕开。"
        },
        {
          "role": "法拉",
          "text": "但是今天，突然从天上飞下来一个人，正好落在那个丘丘人营地里面！"
        },
        {
          "role": "派蒙",
          "text": "嗯…总感觉是某人经常做的事情呢。"
        },
        {
          "role": "法拉",
          "text": "丘丘人一下子就炸了锅了，跟着那个逃跑的怪人就追了出来！"
        },
        {
          "role": "法拉",
          "text": "我是跑了，可我运水果的车全都被砸了！明天商队来的时候，我可怎么开张啊——"
        },
        {
          "role": "安柏",
          "text": "怪人？是什么样子的怪人？"
        },
        {
          "role": "法拉",
          "text": "抱着个什么东西，飞得歪歪扭扭的…嗯，一定是因为抱着这东西他才掉下来了。"
        },
        {
          "role": "法拉",
          "text": "真是的，没考过飞行执照吗？不许带重物懂不懂？！我一定要去举报，吊销他的飞行执照！"
        },
        {
          "role": "安柏",
          "text": "抱着重物…说不定就是带着文物逃跑的怪鸟。"
        },
        {
          "role": "安柏",
          "text": "你看见那个怪人往哪里跑了吗？"
        },
        {
          "role": "法拉",
          "text": "我跑的时候就来得及看了一眼，他们好像…是往前面跑了。"
        },
        {
          "role": "安柏",
          "text": "总算抓住线索了，旅行者，我们快点追上去吧。"
        },
        {
          "role": "安柏",
          "text": "哦对了，别担心，我回去也会报告骑士团，把残留的丘丘人营地尽快处理掉的。"
        },
        {
          "type": "subtitle",
          "text": "向前寻找「怪鸟」"
        },
        {
          "type": "subtitle",
          "text": "消灭埋伏的敌人"
        },
        {
          "role": "派蒙",
          "text": "除了丘丘人之外，还有一群怪模怪样的人！"
        },
        {
          "role": "安柏",
          "text": "看那群人风之翼的制式，说不定是怪鸟的同伙吧。"
        },
        {
          "role": "派蒙",
          "text": "但是，他们为什么会留在这里呢？"
        },
        {
          "role": "安柏",
          "text": "确实…这样的几个杂兵，是绝对不可能拦住我们的。"
        },
        {
          "role": "安柏",
          "text": "而且也没有找到文物，也就是说，文物还被怪鸟带在身上。"
        },
        {
          "role": "安柏",
          "text": "算了…旅行者，我们跟着元素的痕迹继续前进吧。"
        },
        {
          "type": "subtitle",
          "text": "寻找「怪鸟」遗留的痕迹"
        },
        {
          "type": "subtitle",
          "text": "「怪鸟」的去向"
        },
        {
          "role": "派蒙",
          "text": "居然跑到这里来了…"
        },
        {
          "role": "旅行者",
          "text": "前面已经没有元素痕迹了。"
        },
        {
          "role": "安柏",
          "text": "文物上面的元素力要耗尽了。"
        },
        {
          "role": "安柏",
          "text": "原来是这样，怪鸟一伙知道自己没法处理元素的痕迹，才让手下拖住我们。"
        },
        {
          "role": "安柏",
          "text": "是想等元素的痕迹自然消失吧。"
        },
        {
          "role": "安柏",
          "text": "他不会得逞的，我们赶紧追上去。"
        }
      ]
    },
    {
      "story_id": 485,
      "title": "侦察骑士的作风",
      "description": "循着踪迹，你们一路追至「怪鸟藏身地」。为了将他抓捕归案，你们毫不犹豫向深处挺进。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "进入「怪鸟藏身地」"
        },
        {
          "type": "subtitle",
          "text": "与安柏对话"
        },
        {
          "role": "安柏",
          "text": "这里只有一条路，看来怪鸟就在前面。"
        },
        {
          "role": "安柏",
          "text": "看前面的情况，想要追上去只能用飞的了。"
        },
        {
          "role": "派蒙",
          "text": "但是底下有这么多敌人，飞起来一定会被攻击的。"
        },
        {
          "role": "安柏",
          "text": "如果想要过去，必须{{颜色|蓝|一边飞一边消灭这些敌人}}呢…"
        },
        {
          "role": "安柏",
          "text": "对了，旅行者还差最后一项考试没考对吧？"
        },
        {
          "role": "派蒙",
          "text": "是啊，怎么突然问这个？"
        },
        {
          "role": "安柏",
          "text": "那么旅行者的第三项考试，就以这个为主题怎么样？"
