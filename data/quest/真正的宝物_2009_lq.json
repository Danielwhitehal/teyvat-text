          "role": "旅行者",
          "options": [
            {
              "text": "旅行者：很有勇气呢。",
              "dialogues": []
            },
            {
              "text": "旅行者：但是秘境很危险哦。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "可莉",
          "text": "嘿嘿，可莉是很厉害的！"
        },
        {
          "role": "可莉",
          "text": "荣誉骑士姐姐，我们走我们走。"
        },
        {
          "type": "subtitle",
