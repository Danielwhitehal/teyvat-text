        },
        {
          "role": "派蒙",
          "text": "你想要做什么？"
        },
        {
          "role": "深渊法师",
          "text": "哈哈哈哈哈哈。"
        },
        {
          "role": "深渊法师",
          "text": "我们可是在人类的传言里，收集到了详细的战力情报。"
        },
        {
          "role": "深渊法师",
          "text": "这个红衣服的小女孩，拥有蒙德城最厉害的宝物。"
