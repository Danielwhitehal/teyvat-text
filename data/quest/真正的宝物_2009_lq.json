{
  "quest_id": 2009,
  "chapter_num": "四叶草之章 第一幕",
  "chapter_title": "真正的宝物",
  "type": "lq",
  "route": "True Treasure",
  "stories": [
    {
      "story_id": 10200,
      "title": "「蒙德最强战力」之争",
      "description": "「天使的馈赠」的酒客们，议论起了蒙德街头巷尾的热门话题…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待夜晚降临"
        },
        {
          "type": "subtitle",
          "text": "向巴顿了解最近的话题"
        },
        {
          "role": "巴顿",
          "text": "唉，只能从窗外听到大家的讨论，连发言的机会都没有，好想参加他们的话题啊…"
        },
        {
          "role": "派蒙",
          "text": "欸？什么什么？有什么好玩的事情吗？我也想听！"
        },
        {
          "role": "巴顿",
          "text": "酒馆里的客人们，最近激烈地讨论起了一个话题——「谁，才是蒙德城最强战力」。"
        },
        {
          "role": "派蒙",
          "text": "「最强」…？"
        },
        {
          "role": "派蒙",
          "text": "强到一拳能放倒几只丘丘人，算最强吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "应该没有那么简单吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…看来「最强」的称号，并不好拿啊。"
                }
              ]
            },
            {
              "text": "我也可以。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "好，那我要提名你。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对了，巴顿先生，关于这个话题，大家讨论出什么共识了吗？"
        },
        {
          "role": "巴顿",
          "text": "嗯…指望「自由之都」的人轻而易举达成共识，就像期待天上掉渔人吐司一样难。"
        },
        {
          "role": "巴顿",
          "text": "每个人都有自己的想法，但谁手里的信息都不全面，所以讨论才会变得激烈又有趣吧。"
        },
        {
          "role": "巴顿",
          "text": "现在市面上占据主流的提名…我想想…"
        },
        {
          "role": "巴顿",
          "text": "应该是「蒲公英骑士派」和「暗夜英雄派」吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙要把票投给谁？",
              "dialogues": []
            },
            {
              "text": "有人支持我吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我支持你哦。"
        },
        {
          "role": "派蒙",
          "text": "不过，我们还是进{{颜色|蓝|酒馆}}打听看看吧。说不定会有什么逸闻呢？"
        },
        {
          "role": "巴顿",
          "text": "哈，这份悠闲真让人羡慕。"
        },
        {
          "role": "巴顿",
          "text": "你们不用管我…呜呜，我也得…继续工作了…"
        },
        {
          "type": "subtitle",
          "text": "进入酒馆"
        },
        {
          "type": "subtitle",
          "text": "向酒客们打听「最强战力」的事（4/4）"
        },
        {
          "role": "杰克",
          "text": "你好！我在锻炼身为冒险家的酒量…你要不要一起？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「蒙德最强战力」。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "杰克",
          "text": "你问我心目中的「最强战力」？"
        },
        {
          "role": "杰克",
          "text": "那应该就是光辉万丈的大冒险家——斯坦利先生了吧。"
        },
        {
          "role": "杰克",
          "text": "虽然协会的塞琉斯会长也很厉害，但能够直面烬寂海魔兽的，只有斯坦利先生一个吧！"
        },
        {
          "role": "派蒙",
          "text": "「烬寂海的魔兽」，听上去很凶猛呢。"
        },
        {
          "role": "派蒙",
          "text": "要是出现在你面前，你会害怕吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我会把它打倒。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦哦！真不愧是你呢。"
                }
              ]
            },
            {
              "text": "我会逃走。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔，没错。毕竟，那个，安全第一。"
                }
              ]
            }
          ]
        },
        {
          "role": "布鲁斯",
          "text": "哦！你也是来品尝蒙德著名的好酒吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「蒙德最强战力」。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "布鲁斯",
          "text": "嗝…要说最强的话。"
        },
        {
          "role": "布鲁斯",
          "text": "那当然是我们的琴团长了…嗝。"
        },
        {
          "role": "布鲁斯",
          "text": "就是因为…琴团长太厉害，甩几下剑…就能…击败遗迹守卫…"
        },
        {
          "role": "布鲁斯",
          "text": "一个人就能…扫平达达乌帕谷的三大部族…"
        },
        {
          "role": "布鲁斯",
          "text": "才会，让我们过得太安逸…无所事事…"
        },
        {
          "role": "派蒙",
          "text": "嗯，琴团长给人的感觉，的确很可靠。"
        },
        {
          "role": "派蒙",
          "text": "但是，总觉得这个家伙已经醉醺醺的了…"
        },
        {
          "role": "查尔斯",
          "text": "今天想喝点儿什么？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「蒙德最强战力」。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "查尔斯",
          "text": "「最强战力」？我不太关心这类话题…"
        },
        {
          "role": "派蒙",
          "text": "欸。我还以为会有什么，只有酒保先生才知道的消息渠道呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就像专供的酒源一样？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "没错没错！就是这样。"
        },
        {
          "role": "查尔斯",
          "text": "我可不做情报方面的工作。"
        },
        {
          "role": "查尔斯",
          "text": "但真要我推选一个人选的话，「暗夜英雄」吧。"
        },
        {
          "role": "查尔斯",
          "text": "我听人提起他的事迹，好像是从深渊教团手里救出过平民。"
        },
        {
          "role": "派蒙",
          "text": "出现了，是隐藏情报！"
        },
        {
          "role": "派蒙",
          "text": "话说回来，那些深渊教团的怪物，还真是四处作乱啊。"
        },
        {
          "role": "六指乔瑟",
          "text": "嘿~朋友你好！"
        },
        {
          "role": "六指乔瑟",
          "text": "怎么样？想听听六指乔瑟呕心沥血的最新作吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「蒙德最强战力」。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "六指乔瑟",
          "text": "唔…「蒙德的最强战力」…"
        },
        {
          "role": "六指乔瑟",
          "text": "我想…那是一个红衣服的小女孩。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "红衣服的小女孩？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "六指乔瑟",
          "text": "没错。这就要说起半个月前的某一天，我去望风山地寻找新作的灵感，结果…"
        },
        {
          "role": "六指乔瑟",
          "text": "你猜怎么着？"
        },
        {
          "role": "派蒙",
          "text": "怎么着？"
        },
        {
          "role": "六指乔瑟",
          "text": "我发现了一位极具破坏力的强者！"
        },
        {
          "role": "六指乔瑟",
          "text": "望风山地的一大片地貌，都被那位强者改变了！"
        },
        {
          "role": "派蒙",
          "text": "哇！！"
        },
        {
          "role": "六指乔瑟",
          "text": "那时我躲在灌木丛后面，看到一个红衣服的小女孩跑远了，只留下面目全非的山地。"
        },
        {
          "role": "六指乔瑟",
          "text": "唔…但是这样说了别人也不相信。"
        },
        {
          "role": "派蒙",
          "text": "嗯…小女孩和那么强大的破坏力，很难联系在一起呢。"
        },
        {
          "role": "六指乔瑟",
          "text": "要我说，她一定有什么大家都不知道的宝物。"
        },
        {
          "role": "六指乔瑟",
          "text": "说不好，还是全蒙德最厉害的宝物！"
        },
        {
          "role": "派蒙",
          "text": "你是说…宝物？！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你听见了吗。"
        },
        {
          "role": "六指乔瑟",
          "text": "…这是我的猜测。唔…不对，是吟游诗人敏锐的感觉！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "听上去没什么说服力。",
              "dialogues": [
                {
                  "role": "六指乔瑟",
                  "text": "怎么这样…"
                }
              ]
            },
            {
              "text": "姑且相信你吧。",
              "dialogues": [
                {
                  "role": "六指乔瑟",
                  "text": "谢谢你！啊，难得的知音？！我是多么喜悦， 居然在…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "那个小女孩，叫什么名字呢？"
        },
        {
          "role": "六指乔瑟",
          "text": "唔…名字我就不知道了。不怎么在蒙德城里见过她。"
        },
        {
          "role": "六指乔瑟",
          "text": "唉，别不相信啊，我说的可都是实话！"
        },
        {
          "role": "派蒙",
          "text": "嗯唔…听上去还有点神神秘秘的呢。"
        },
        {
          "role": "派蒙",
          "text": "不过，谢谢你的情报！"
        },
        {
          "type": "subtitle",
          "text": "和派蒙一起总结情报"
        },
        {
          "role": "派蒙",
          "text": "果然就跟巴顿先生说得一样呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "大家都有自己的看法。",
              "dialogues": []
            },
            {
              "text": "还听到了一些特别的人选。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "但是，如果像这样，谁都说服不了谁的话…"
        },
        {
          "role": "派蒙",
          "text": "岂不是永远都不能知道「蒙德的最强战力」到底是谁了。"
        },
        {
          "role": "派蒙",
          "text": "啊，有了！"
        },
        {
          "role": "派蒙",
          "text": "我们去找{{颜色|蓝|琴团长}}问问看吧？"
        },
        {
          "role": "派蒙",
          "text": "说不定会有，「西风骑士团认证的官方排行榜」！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真会有那种东西吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "走嘛走嘛，不试试怎么知道呢。"
                }
              ]
            },
            {
              "text": "我也可以有名次吗？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那就要看他们有没有算上你的事迹了吧？"
                },
                {
                  "role": "派蒙",
                  "text": "放心，我还是很信得过你的实力的！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "前往骑士团"
        },
        {
          "type": "subtitle",
          "text": "向琴了解「最强战力」的情报"
        },
        {
          "role": "派蒙",
          "text": "琴团长！打扰你啦，我们在收集「蒙德最强战力」的情报。"
        },
        {
          "role": "派蒙",
          "text": "有没有…那种…西风骑士团认证过的官方排名呢？"
        },
        {
          "role": "琴",
          "text": "「蒙德最强战力」…？"
        },
        {
          "role": "琴",
          "text": "抱歉，不能帮上忙了。我身边并没有这方面的资料…"
        },
        {
          "role": "派蒙",
          "text": "欸…好可惜。"
        },
        {
          "role": "派蒙",
          "text": "我还希望看他排上前五呢。"
        },
        {
          "role": "琴",
          "text": "哈哈。即使没有这方面的统计，我对这位荣誉骑士的实力也从未质疑过。"
        },
        {
          "role": "琴",
          "text": "对了，说到这个…"
        },
        {
          "role": "琴",
          "text": "最近又有深渊教团的法师，在蒙德城附近鬼鬼祟祟地出没。"
        },
        {
          "role": "琴",
          "text": "如果你们在蒙德周边逗留，也希望能够帮忙留意一下。"
        },
        {
          "role": "琴",
          "text": "以你的「战力」，守护人们的安全，应当不成问题。"
        },
        {
          "role": "派蒙",
          "text": "好！如果能够把深渊教团解决掉的话，他的排名又会上升一点吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没有那样的排名啦。",
              "dialogues": []
            },
            {
              "text": "会变成「最强」？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "总之，打倒他们就对了啦！"
        },
        {
          "role": "琴",
          "text": "哈，感觉被你们的干劲激励了呢。"
        },
        {
          "role": "琴",
          "text": "那么，一路小心。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（琴）"
        },
        {
          "role": "琴",
          "text": "深渊教团近期活跃的原因，还需要更进一步探明…"
        },
        {
          "role": "琴",
          "text": "旅行者，旅途中还请小心。"
        },
        {
          "type": "subtitle",
          "text": "离开骑士团办公室"
        },
        {
          "type": "subtitle",
          "text": "你们刚刚离开骑士团办公室，却撞上了一个冒冒失失路过的小女孩。担心着这孩子的状况，你赶快扶起了她，询问她是否受伤…",
          "narration": true,
          "color": "gray"
        },
        {
          "role": "派蒙",
          "text": "你没事吧？"
        },
        {
          "type": "subtitle",
          "text": "询问小女孩的情况"
        },
        {
          "role": "？？？",
          "text": "唔！我，我很好！对不起，撞到了你们。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你有东西掉了。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "生存守则"
        },
        {
          "type": "subtitle",
          "text": "城里放炮禁闭室报到",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "炸弹伤人琴找上门",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "放火烧山可莉完蛋",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "嗯唔…这上面写的是…"
        },
        {
          "role": "派蒙",
          "text": "「城里放炮禁闭室报到」、「炸弹伤人琴找上门」、「放火烧山可莉完蛋」？"
        },
        {
          "role": "？？？",
          "text": "呀？！"
        },
        {
          "role": "？？？",
          "text": "这…这是凯亚哥哥帮我总结出的…总结出的…唔，生存守则！"
        },
        {
          "role": "派蒙",
          "text": "生存守则？"
        },
        {
          "role": "？？？",
          "text": "就…就是不论如何千万不能违反的东西。"
        },
        {
          "role": "？？？",
          "text": "不然会发生很可怕、很可怕的事情。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "凯亚哥哥？",
              "dialogues": []
            },
            {
              "text": "可怕的事情？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "嗯！"
        },
        {
          "role": "？？？",
          "text": "啊啊啊，忘记做自我介绍了。"
        },
        {
          "role": "可莉",
          "text": "我的名字叫作可莉。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你好。",
              "dialogues": []
            },
            {
              "text": "我是旅行者。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "叫我派蒙就好啦。"
                }
              ]
            }
          ]
        },
        {
          "role": "可莉",
          "text": "我知道你们的事情，是帮助了蒙德的荣誉骑士！"
        },
        {
          "role": "派蒙",
          "text": "哇？！"
        },
        {
          "role": "派蒙",
          "text": "好感动，又一次得到了肯定！"
        },
        {
          "role": "可莉",
          "text": "我是听安柏…嗷呜。不对不对，来不及说这些了。"
        },
        {
