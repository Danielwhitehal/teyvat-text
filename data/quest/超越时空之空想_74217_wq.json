{
  "quest_id": 74217,
  "chapter_num": null,
  "chapter_title": "超越时空之空想",
  "type": "wq",
  "route": "Daydreams Beyond Space and Time",
  "stories": [
    {
      "story_id": 74217,
      "title": "超越时空之空想",
      "description": "加尔恰一行人正筹备着回到佩特莉可镇…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与加尔恰对话"
        },
        {
          "role": "加尔恰",
          "text": "…我们必须立刻出发！立刻出发！"
        },
        {
          "role": "迦雅",
          "text": "冷静点，加尔恰，梅莘警官不都说了，佩特莉可镇已经恢复了正常吗？"
        },
        {
          "role": "路通",
          "text": "先生，相信俱乐部里那几位好先生吧，他们是足智多谋的人，这么一点危机必然影响不了他们。"
        },
        {
          "role": "加尔恰",
          "text": "是的，是的。巴比斯是聪明的，梅康顿也颇有些计策，但他们都不懂如何对付坏心思！"
        },
        {
          "role": "加尔恰",
          "text": "虽然我已经给他们寄了信，告诫了他们，但那卑劣的商人太明白如何转动坏脑筋！"
        },
        {
          "role": "加尔恰",
          "text": "好人们，唉！好人们总是会在坏蛋面前受挫！"
        },
        {
          "role": "路通",
          "text": "那咱们想必只能寄希望于博絮埃先生了，希望枫丹科学院的智慧能带着俱乐部里的人们度过难关。"
        },
        {
          "role": "加尔恰",
          "text": "哦，得了吧！我可不想空想俱乐部飞上天…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那看来，只能我亲自出马了。",
              "dialogues": []
            },
            {
              "text": "就算飞上天了，我也能把它拽下来。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "加尔恰",
          "text": "亲爱的旅行者！太好了，您总算来了！咱们出发！快快快！"
        },
        {
          "role": "迦雅",
          "text": "很高兴见到您，旅行者，还有派蒙，看见你们如此健康，真是太好了。"
        },
        {
          "role": "派蒙",
          "text": "你好呀，迦雅小姐！嘿嘿，总觉得迦雅小姐越来越漂亮了，是我的错觉吗？"
        },
        {
          "role": "路通",
          "text": "唔，有一句璃月诗是怎么说的来着？好像是…"
        },
        {
          "role": "迦雅",
          "text": "我记得，好像是…什么花丛懒回顾…我上次在一本诗集里读到过。"
        },
        {
          "role": "加尔恰",
          "text": "谢谢，路通，你们璃月的诗真是包罗万象啊！那看在璃月诗文的份上，咱们快些出发吧。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你脸红了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "加尔恰",
          "text": "没有！天哪，是我担心风浪，多穿了些衣服，这时候觉得太热了而已！"
        },
        {
          "role": "派蒙",
          "text": "是这样吗？嘻嘻…从外面完全看不出加尔恰先生穿了很厚的衣服呢。"
        },
        {
          "role": "梅莘",
          "text": "噗…几位，我们去那边吧，都已经准备好了。"
        },
        {
          "role": "梅莘",
          "text": "抱歉，如果一开始就知道加尔恰先生这么怕冷，我就会去帮你们多准备些衣服了。"
        },
        {
          "role": "梅莘",
          "text": "请您先去佩特莉可镇吧，我要在这里等几位同事，过一会我们也会过去。"
        },
        {
          "type": "subtitle",
          "text": "一行人很快踏上了前往佩特莉可镇的路…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "加尔恰",
          "text": "啊…佩特莉可镇！我的故乡，多么美丽，多么熟悉！多么…"
        },
        {
          "role": "路通",
          "text": "多么安静…先生，您的故乡是以寂静出名的吗？"
        },
        {
          "role": "加尔恰",
          "text": "当然不是，先不论别人，巴比斯和梅康顿每天都会弄出轰隆隆的响声…"
        },
        {
          "role": "加尔恰",
          "text": "梅康顿，巴比斯…我们得先去俱乐部，跟我来！快！"
        },
        {
          "role": "梅康顿",
          "text": "…那是真的？抑或是虚幻，我、我看见了…"
        },
        {
          "role": "巴比斯",
          "text": "我也无法分辨，但…"
        },
        {
          "role": "？？？",
          "text": "我…我都做了什么…多么可怕…"
        },
        {
          "role": "加尔恰",
          "text": "梅康顿！巴比斯！看在俱乐部的份上，我还以为你们出事了！埃斯特在哪？格里斯潘呢？"
        },
        {
          "role": "梅康顿",
          "text": "加尔恰？我是做梦了，还是说一直在梦中？老兄，你怎么回来了？"
        },
        {
          "role": "巴比斯",
          "text": "你们是…雷穆利亚…见鬼，不是，不是。我现在满脑子都是这些东西！"
        },
        {
          "role": "？？？",
          "text": "你是…加尔恰？"
        },
        {
          "role": "加尔恰",
          "text": "…戈伦德兰，你又在打什么主意，你又抓住了这次机会？嗯？要把我们的研究据为己有？"
        },
        {
          "role": "戈伦德兰",
          "text": "我…我曾经是这么想，但是…但是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他就是之前觊觎你研究的人？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "加尔恰",
          "text": "是的！就是他，他雇人跟踪我们，派人进我的房间翻找，要把推数机据为己有。"
        },
        {
          "role": "加尔恰",
          "text": "我就知道，在你意识到无法从我这里讨到好之后，你一定会来佩特莉可镇等我。我早就写了信…"
        },
        {
          "role": "迦雅",
          "text": "加尔恰，稍等。他好像有点不太对。"
        },
        {
          "role": "派蒙",
          "text": "旅行者，这里的所有人，好像都不太对…难、难道…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "(他们一定也被「福波斯」影响了。)",
              "dialogues": []
            },
            {
              "text": "(难道「福波斯」的影响还没消退吗？)",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸？你是说，他们也做了那种梦，在梦里变成了…其他的雷穆利亚人？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就像埃斯特一样。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对…对喔！如果他们一直都待在岛上，应该也被「福波斯」给…"
        },
        {
          "role": "戈伦德兰",
          "text": "我…我的确这么想，加尔恰，我向你忏悔，我之前是一个粗陋的坏人，我…"
        },
        {
          "role": "路通",
          "text": "呃，先生，您的计划就是将他诱导来佩特莉可镇，然后用您这几位好朋友的人性光辉感化他吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "看起来计划挺成功的。",
              "dialogues": []
            },
            {
              "text": "我不知道你还有这方面的天赋。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "路通",
          "text": "我得说，如果您之前就愿意展现如此天赋，那咱们的工作一定会更加顺利。"
        },
        {
          "role": "迦雅",
          "text": "哦…那我可要好好重新审视一下我们之间的关系了，亲爱的。"
        },
        {
          "role": "派蒙",
          "text": "喔——"
        },
        {
          "role": "加尔恰",
          "text": "现、现在可不是开玩笑的时候！"
        },
        {
          "role": "戈伦德兰",
          "text": "我为什么之前只想着掌控一切？我简直…我简直无药可救！"
        },
        {
          "role": "加尔恰",
          "text": "别想着打什么鬼主意，戈伦德兰，梅康顿和巴比斯早就在镇子里放了留声机。"
        },
        {
          "role": "加尔恰",
          "text": "你打的一切鬼主意，一定都被录下来了。巴比斯，梅康顿，你们…"
        },
        {
          "role": "梅康顿",
          "text": "留声机？我…我放了，没错，我们散步，聊天，然后光聊着些只和赚钱有关的蠢事…"
        },
        {
          "role": "巴比斯",
          "text": "投资、占股、推广…钱和钱，钱滚滚向前，但脑子却愈加像一个大号水包…"
        },
        {
          "role": "梅康顿",
          "text": "但是…我把它们放在哪了？巴比斯，你记得吗？"
        },
        {
          "role": "巴比斯",
          "text": "放在…花盆里？镇子里的花盆？那口钟旁边？还是那个大厅，石像，大厅…还有博絮埃先生…呃，他去哪了？"
        },
        {
          "role": "路通",
          "text": "…先生，这周围既没有钟，也没有大厅和石像。唉，看样子，我们暂时是无法和他们沟通了…"
        },
        {
          "role": "路通",
          "text": "旅行者，请您和我一起，去镇子里各处找找留声机吧，比起其他的词汇，这是咱们现在唯一的线索了。"
        },
        {
          "role": "路通",
          "text": "迦雅小姐，请您陪着加尔恰先生，还有这几位好先生，成吗？"
        },
        {
          "role": "迦雅",
          "text": "包在我身上。他们的确需要照顾。"
        },
        {
          "role": "迦雅",
          "text": "首先，得想办法让他们的精神镇定下来…"
        },
        {
          "role": "迦雅",
          "text": "让我想想…嗯、一碗好喝的热汤肯定能起大作用。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（戈伦德兰）"
        },
        {
          "role": "戈伦德兰",
          "text": "我真是无药可救…为什么我之前…天哪…我之前做出了那种事…"
        },
        {
          "role": "戈伦德兰",
          "text": "我就像那个人一样，想捏着别人的心弦，只让他们听自己号令，不…不不不…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（巴比斯&梅康顿）"
        },
        {
          "role": "梅康顿",
          "text": "是的，你们就是学不会空想…现实，现实谁都不缺，你们只缺空想…"
        },
        {
          "role": "巴比斯",
          "text": "你们得…我们得仰头看天，别总瞅着摩拉和高楼，空无一物的地方才是研究者的归宿…"
        },
        {
          "type": "subtitle",
          "text": "额外对话（加尔恰&迦雅）"
        },
        {
          "role": "加尔恰",
          "text": "这镇子到底经历了什么？难道是格里斯潘那个白痴把所有人都催眠了？"
        },
        {
          "role": "加尔恰",
          "text": "但他去哪了？他连格罗贝尔都带走了…不会真是这家伙犯的事吧…"
        },
        {
          "role": "加尔恰",
          "text": "看在俱乐部的份上，梅康顿！巴比斯，你们清醒点！"
        },
        {
          "role": "迦雅",
          "text": "冷静点，加尔恰，我们先去煮点汤吧。喝一点暖和的东西有助于他们的精神健康。"
        },
        {
          "role": "加尔恰",
          "text": "好的…我真不知道如何是好了，一切都一团糟，迦雅。"
        },
        {
          "role": "迦雅",
          "text": "没关系，亲爱的，没关系。我陪着你呢，这件事绝对清清楚楚，无可置疑。"
        },
        {
          "type": "subtitle",
          "text": "拿回留声机"
        },
        {
          "type": "subtitle",
          "text": "在没有留声机的花盆寻找",
          "narration": true
        },
        {
          "role": "路通",
          "text": "花盆…花盆…好吧，什么也没有，它就只是一个花盆。"
        },
        {
          "type": "subtitle",
          "text": "在俱乐部西侧花盆寻找",
          "narration": true
        },
        {
          "role": "断断续续的声音",
          "text": "…这些研究…大价钱…愉快的合作，相信我。"
        },
        {
          "role": "断断续续的声音",
          "text": "俱乐部的初衷…无偿提供…研究属于所有人…"
        },
        {
          "role": "断断续续的声音",
          "text": "与我合作…提供给更多人…专业的商贸渠道…"
        },
        {
          "role": "路通",
          "text": "无偿提供…哼，真是让人尊敬的品德。"
        },
        {
          "type": "subtitle",
          "text": "在俱乐部东北角花盆寻找",
          "narration": true
        },
        {
          "role": "断断续续的声音",
          "text": "我们无法说服所有人…研究成果很多…"
        },
        {
          "role": "断断续续的声音",
          "text": "…只要您合作…保证您…第一位…最多分红…"
        },
        {
          "role": "断断续续的声音",
          "text": "…成为最有钱的研究者…想研究什么就研究什么…"
        },
        {
          "role": "断断续续的声音",
          "text": "前提…您得让加尔恰…原始资料…"
        },
        {
          "role": "路通",
          "text": "看来这位老兄还没搞清楚，「空想俱乐部」到底是为什么而存在…真让人遗憾。"
        },
        {
          "type": "subtitle",
          "text": "在俱乐部门口猫窝一侧花盆寻找",
          "narration": true
        },
        {
          "role": "断断续续的声音",
          "text": "…蠢货研究者…他们不及您智慧的万分之一…"
        },
        {
          "role": "断断续续的声音",
          "text": "合作…摩拉…大生意…实在不行，我们就让他吃点苦头…"
        },
        {
          "role": "断断续续的声音",
          "text": "…合同在这…在这签字…"
        },
        {
          "role": "断断续续的声音",
          "text": "…呃！？发生了什……"
        },
        {
          "role": "断断续续的声音",
          "text": "（留声机中传来了几声沉闷的倒地声，此后就再无人说话了。）"
        },
        {
          "role": "路通",
          "text": "看起来，他们谈到一半，佩特莉可镇就出现了意外。这件事可以称得上是好坏参半。"
        },
        {
          "type": "subtitle",
          "text": "找到三个留声机",
          "narration": true
        },
        {
          "role": "路通",
          "text": "感谢梅康顿和巴比斯这两位先生的才智，戈伦德兰先生这下可不太好为自己辩护了。"
        },
        {
          "role": "路通",
          "text": "我们回去吧。无论如何…我相信梅莘警官会对这些录音感兴趣的。"
        },
        {
          "type": "subtitle",
          "text": "与戈伦德兰对话"
        },
        {
          "role": "戈伦德兰",
          "text": "感谢您，好心的小姐…但我的脑袋还是晕乎乎的…"
        },
        {
          "role": "迦雅",
          "text": "瞧，我就说有用，他们的脸色好看了不少。"
        },
        {
          "role": "路通",
          "text": "那您可得抓紧时间恢复了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不然就得让警官帮你恢复了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "就是就是，我们可是已经拿到证据，证明你是坏蛋了！"
        },
        {
          "role": "加尔恰",
          "text": "感谢佩特莉可镇，你们回来了，拿到那些留声机了吗？"
        },
        {
          "role": "路通",
          "text": "当然，先生。我们的计划奏效了，巴比斯兄弟把这位聪明人的话全套了出来，就录在这些留声机里。"
        },
        {
          "role": "戈伦德兰",
          "text": "你们…你们误会了，我不否认我之前做的那些坏事，我是个彻头彻尾的混球，现在我只想补偿！"
        },
        {
          "role": "路通",
          "text": "…迦雅小姐，您的汤里，是否放了某些须弥的特色蘑菇？能让人眨眼间就回心转意的那种？"
        },
        {
          "role": "迦雅",
          "text": "没有，我只是简单地煮了锅鱼汤呀，就连香料也没放，只放了些盐。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "一定是迦雅小姐的人格魅力。",
              "dialogues": [
                {
                  "role": "迦雅",
                  "text": "谢谢您的夸奖，如果我真的有如此魅力…唔，想必也只能对某一个人生效。"
                }
              ]
            },
            {
              "text": "一定是佩特莉可镇的镇子魅力。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "这镇子确实很漂亮，但也没漂亮到那个程度啦…"
                }
              ]
            }
          ]
        },
        {
          "role": "加尔恰",
          "text": "戈伦德兰，你又在打什么鬼主意？我明着和您说了吧。"
        },
        {
          "role": "加尔恰",
          "text": "空想俱乐部的研究，绝不会用于赚一分钱，我们是研究者，不是见钱眼开的守财奴！"
        },
        {
          "role": "梅康顿",
          "text": "加尔恰，等等，我…我愿意相信戈伦德兰。愿意相信他想要变成好人。"
        },
        {
          "role": "巴比斯",
          "text": "是的，我也赞同。无论如何，我愿意给他个机会。"
        },
        {
          "role": "路通",
          "text": "好吧，现在情况更复杂了，我们得把你们一起送给医生看看。"
        },
        {
          "role": "梅康顿",
          "text": "不，不，加尔恰，你听我说。我们…我们曾经一同经历了一场巨大的梦境。"
        },
        {
          "role": "巴比斯",
          "text": "在梦境里，我们变成了石头雕像，也不全是石头雕像，我们依然能思考，能看，能听。"
        },
        {
          "role": "梅康顿",
          "text": "我能感觉到，那石头雕像里除了我之外，还有另外一个人。"
        },
        {
          "role": "梅康顿",
          "text": "我通过他的眼睛在看，通过他的耳朵在听，通过他的灵魂跟着他思考…我是他，但又不是他！"
        },
        {
          "role": "戈伦德兰",
          "text": "我也是，我…我感受着那人，他是个富有理想和智慧的好人，一直在研究，在工作，但却不是为了自己。"
        },
        {
          "role": "戈伦德兰",
          "text": "他就像是跟随着某人的指挥棒转圈，自己却毫无察觉。他…他度过了多么可怕的一生，呜呜呜呜…"
        },
        {
          "role": "派蒙",
          "text": "呜哇，旅行者，他说的这个「指挥棒」难道就是…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "统辖着雷穆利亚的大乐章…",
              "dialogues": []
            },
            {
              "text": "他们果然被「福波斯」影响了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "加尔恰",
          "text": "亲爱的旅行者，您刚才说什么？看在镇子的份上，请您保持着正常啊！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我知道他们的症状是由何而来。",
              "dialogues": []
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "用最容易理解的方式，努力向众人简短讲述了有关雷穆利亚与福波斯的事…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "梅康顿",
          "text": "这么说，咱们梦见的事物并非虚幻，而是确实存在着的？"
        },
        {
          "role": "巴比斯",
          "text": "难以置信，但旅行者的叙述确实合情合理。"
        },
        {
          "role": "加尔恰",
          "text": "等等，雷穆利亚？这…这只是传说中的城市啊。就算它存在，距离现在也有·呃…数百年？我算不清了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他确实存在，我拜访过那座城市。",
              "dialogues": []
            },
            {
              "text": "他就在水下，我目睹过它的乐章。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "加尔恰",
          "text": "…如果是从别人嘴里听到的消息，我一定会认为那人疯了。但…如果是您说的，我愿意相信。您向来诚实。"
        },
        {
          "role": "戈伦德兰",
          "text": "您去过那里？！那地方确实存在？！天哪，请您务必带我过去！我必须得去！"
        },
        {
          "role": "梅康顿",
          "text": "我也是！我…我必须得去看看那尊石像！"
        },
        {
          "role": "巴比斯",
          "text": "可不能漏了我！我得去见见他！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那个地方在水底很深…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "巴比斯",
          "text": "不用担心，俱乐部里有好几套潜水服，足够我们下去了。"
        },
        {
          "role": "派蒙",
          "text": "你们这里到底是俱乐部还是百宝屋呀，怎么什么东西都有？"
        },
        {
          "role": "梅康顿",
          "text": "这几套潜水服得归功于亲爱的格里斯潘先生，他为了研究水下催眠术，自己出资购买了所有设备。"
        },
        {
          "role": "巴比斯",
          "text": "愿他健康，无论他在哪。"
        },
        {
          "role": "加尔恰",
          "text": "好了，闲话到此为止！我也要跟着去，我可不相信戈伦德兰这家伙能轻易改邪归正。"
        },
        {
          "role": "迦雅",
          "text": "那看来我也要随行了。"
        },
        {
          "role": "加尔恰",
          "text": "迦雅，水下太危险了，你…"
        },
        {
          "role": "迦雅",
          "text": "亲爱的，相信我，你的身手一定不如我。路通，潜水服的数量还够吗？"
        },
        {
          "role": "路通",
          "text": "我刚去数了数，即使把我们全都算上，潜水服的数量也有富余，小姐。"
        },
        {
          "role": "路通",
          "text": "如果恰巧缺一套，那么我的潜水服就是您的，我擅长无设备潜水。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "路通，你有什么是不擅长的吗？",
              "dialogues": [
                {
                  "role": "路通",
                  "text": "唔，这就要看您怎么定义「不擅长」这件事了，旅行者。"
                }
              ]
            },
            {
              "text": "你一个璃月人，在哪学的潜水？",
              "dialogues": [
                {
                  "type": "subtitle",
                  "text": "哈哈哈，旅行者，我的老师是汹涌的大海，和饿得咕咕叫的肚子。后者还教会了我许多东西。",
                  "narration": true
                }
              ]
            }
          ]
        },
        {
          "role": "加尔恰",
          "text": "好吧…看来咱们这个探险团算是组成了。至于领头人，我认为非旅行者莫属。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "下水之后跟紧我。",
              "dialogues": []
            },
            {
              "text": "乱游的话会被龙蜥之王吃掉喔。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "加尔恰",
          "text": "全听你指挥，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "前往雷穆利亚"
        },
        {
          "role": "迦雅",
          "text": "没想到我们第一次潜水，居然是为了寻找一个梦里的城市，多么有趣。"
        },
        {
          "role": "加尔恰",
          "text": "是啊…而且还是一座距离现在不知道多久，应该早已被埋没在时光里的城市…"
        },
        {
          "role": "加尔恰",
          "text": "…虽然我们还没找到那座城市，但这座…钟，已经足够震撼了。"
        },
        {
          "role": "派蒙",
          "text": "巴比斯先生，你们对周围的环境有什么熟悉感吗？"
        },
        {
          "role": "巴比斯",
          "text": "不，抱歉…我们当时似乎处于某个室内，一动也不能动。"
        },
        {
          "role": "梅康顿",
          "text": "就像是一座石像。"
        },
        {
          "role": "派蒙",
          "text": "石像？但按你们的说法，那尊石像还有着不同于你们的意识？那你们简直就像…"
        },
        {
          "role": "迦雅",
          "text": "就像是一个跨越了时空与梦境，附着在「石像」身后的「影子」…真可惜，我没有做那场梦。"
        },
        {
          "role": "路通",
          "text": "小姐，要是您也变成了石像的影子，那我和先生就不得不去询问枫丹廷的每一块石头了。"
        },
        {
          "role": "加尔恰",
          "text": "咳…咱们还是继续往前走走，找找梅康顿兄弟的「石像」吧。"
        },
        {
          "role": "戈伦德兰",
          "text": "…就在前面！我记起来了，我曾经从这里走过！"
        },
        {
          "role": "加尔恰",
          "text": "喂！戈伦德兰！见鬼，站住！"
        },
        {
          "role": "加尔恰",
          "text": "旅行者！拜托你和梅康顿他们一起走，我去抓住戈伦德兰！"
        },
        {
          "role": "路通",
          "text": "是的，先生，我会看好迦雅小姐的…虽然您还没来得及对我说这句话。"
        },
        {
          "role": "迦雅",
          "text": "噗…他这么有精神真是太好了。旅行者，那咱们就继续往前走吧。"
        },
        {
          "role": "迦雅",
          "text": "希望梅康顿兄弟的「石像」不会太难找。"
        },
        {
          "type": "subtitle",
          "text": "寻找众人的「影子」"
        },
        {
          "role": "梅康顿",
          "text": "是你，没错，我梦见过你。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他就是…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梅康顿",
          "text": "是的。在梦里，我就是他的「影子」。"
        },
        {
          "role": "梅康顿",
          "text": "他似乎是在研究着「高空水道」，即使是在石像里，他也不断在脑子里思考着各种工程细节。"
        },
        {
          "role": "梅康顿",
          "text": "如何在复杂地形上架设道路，建设轨道时要选用什么材料，水道的长度，宽度…"
        },
        {
          "role": "梅康顿",
          "text": "这就是他整个人生中真正的幸福…除此之外，他别无所想。"
        },
        {
          "role": "巴比斯",
          "text": "而我在这里。思考着某种奇怪巡轨船的设计方案…这也是…真正的幸福。"
        },
        {
          "role": "巴比斯",
          "text": "他思索着巡轨船的规格，样式，制作所需的时间…"
        },
        {
          "role": "派蒙",
          "text": "你们就算是变成了石像也待在一起啊，这是什么不解的缘分…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "他们还挺热爱工作的…",
              "dialogues": []
            },
            {
              "text": "听起来就像是一般的研究员。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梅康顿",
          "text": "我尊敬他们对研究的热爱，但我同样…也为他们感到难过。"
        },
        {
          "role": "巴比斯",
          "text": "我也一样，我向他致敬，但也同样要为他默哀。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是因为他们的研究最终没有成功？",
              "dialogues": []
            },
            {
              "text": "是因为他们的研究成果有缺陷？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梅康顿",
          "text": "并不是，是因为他们的研究缺少了一个关键的东西…"
        },
        {
          "role": "加尔恰",
          "text": "嘿！各位，能来帮个忙吗？戈伦德兰的石像似乎沉在水里，还被水草被缠住了。"
        },
        {
          "role": "加尔恰",
          "text": "这些倒霉的水草，我们根本没办法解开，旅行者，能来搭把手吗？"
        },
        {
          "type": "subtitle",
          "text": "额外对话（巴比斯）"
        },
        {
          "role": "巴比斯",
          "text": "巡轨船…你的设计精妙无比，这一点无可置疑。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（梅康顿）"
        },
        {
          "role": "梅康顿",
          "text": "高空水道…真是个好想法…这绝对是一个好想法。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（迦雅&路通）"
        },
        {
          "role": "迦雅",
          "text": "但愿咱们不会遇见什么危险…"
        },
        {
          "role": "路通",
          "text": "我也如此期望，小姐。所以请您再往后面站站，离水边远点吧。"
        },
        {
          "type": "subtitle",
          "text": "捞起石像"
        },
        {
          "type": "subtitle",
          "text": "拾取石像",
          "narration": true
        },
        {
          "type": "subtitle",
          "text": "返回岸上与众人对话"
        },
        {
          "type": "subtitle",
          "text": "和加尔恰合力将石像搬到了岸上…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "戈伦德兰",
          "text": "是你…是你，没错，我梦里的那个人就是你。"
        },
        {
          "role": "戈伦德兰",
          "text": "你…你是「雷穆利亚科学院」的院长，统管着所有研究项目，一切都并井有条，这就是真正的幸福…"
        },
        {
          "role": "派蒙",
          "text": "咦？等一下，你们怎么都在重复「这就是真正的幸福」呀？"
        },
        {
          "role": "派蒙",
          "text": "喜欢研究是很不错啦，但一般来说，不会总是强调这是真正的幸福…吧。总觉得有点可怕…"
        },
        {
          "role": "巴比斯",
          "text": "但是，这就是石像里的人不断向自己强调的念头。而且他们全身心地相信着这个念头。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "统辖一切的大乐章…原来是这个意思。",
              "dialogues": []
            },
            {
              "text": "这就是「福波斯」控制人的方式吗…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "戈伦德兰",
          "text": "他是个好人，即使变成了石像，也在担心着其他研究员，也担心着未完成的研究项目，还不断为此自责…"
        },
        {
          "role": "戈伦德兰",
          "text": "但这不对劲，但我就是说不出来！等到梦醒了之后，巴比斯先生才告诉了我究竟哪里不对劲。"
        },
        {
          "role": "戈伦德兰",
          "text": "他们满脑子研究事务，就是从来没有考虑过自己啊！"
        },
        {
          "role": "巴比斯",
          "text": "这个好人和石像里的所有人一样，都身不由己，只是跟随着那根无形的指挥棒绕来绕去。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你们怎么发现他们「身不由己」的？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对呀，你们最开始也不知道「福波斯」的事吧？"
        },
        {
          "role": "梅康顿",
          "text": "因为我们发现了，他们所缺少的一件东西。"
        },
        {
          "role": "巴比斯",
          "text": "他们缺少的，正是「空想」的念头。这是每一位研究者绝无可能缺少的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没、没明白！",
              "dialogues": []
            },
            {
              "text": "「空想」是这么关键的东西吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "梅康顿",
          "text": "当然了。如果说研究者的思维是顺流直去的河水，那「空想」就是让河水激荡出灵感浪花的礁石啊。"
        },
        {
          "role": "梅康顿",
          "text": "为什么鸟会飞？为什么树会生长？为什么雨水会从天空落下？世界为什么有颜色？"
        },
        {
          "role": "梅康顿",
          "text": "没了这些莫名出现的「空想」，研究就是一潭死水。"
        },
        {
          "role": "巴比斯",
          "text": "「空想」即是每一位研究者时刻追寻，却又不知道如何把握的灵感火花。"
        },
        {
          "role": "巴比斯",
          "text": "这两位研究员的知识能力无可置疑。但他们长久的研究历程中，居然没有过一丝「空想」，也不对其他事物好奇。"
        },
        {
          "role": "巴比斯",
          "text": "在聆听他的研究思路时，我至少想到了三种减缓巡轨船船体水蚀的方法，两种改善船体外型的方案。"
        },
        {
          "role": "巴比斯",
          "text": "由此，我又开始想，综合以上的方案，也许能造出一种可以在各种水体上快速飞驰的小型舰船。"
        },
        {
          "role": "梅康顿",
          "text": "而我，则被那些水道建设的细节所启发，开始构思一种能架设在山与山之间，能让各种大型运输载具通过的大型陆桥！"
        },
        {
          "role": "巴比斯",
          "text": "但他们就只是研究水道和巡轨船，对其他的事压根不好奇，也没有其他灵感产生。对一个研究者来说，这绝不可能。"
        },
        {
          "role": "梅康顿",
          "text": "在您为我们讲述雷穆利亚的事后，这件怪事终于有了答案。"
        },
        {
          "role": "巴比斯",
          "text": "他们的确是「身不由己」…所以我们才要为这两位研究员默哀。那根盲目的指挥棒毁了他们的灵感，也毁了他们的研究。"
        },
        {
          "role": "戈伦德兰",
          "text": "呜呜呜…我差点成为了那个握着指挥棒的恶徒…为什么…我不是，我从来都不是…"
        },
        {
          "role": "加尔恰",
          "text": "…谁来帮我一把，让他别对着石像哭个不停了？"
        },
        {
          "role": "派蒙",
          "text": "呜哇…戈伦德兰先生看起来好难过…"
        },
        {
          "role": "路通",
          "text": "我来帮您，先生。这里不是一个谈话的好地方，我建议咱们先回镇上吧。"
        },
        {
          "role": "路通",
          "text": "二位先生，您希望拿走什么纪念品吗？"
        },
        {
          "role": "巴比斯",
          "text": "没有，我们已经拿走了足够的纪念品了。"
        },
        {
          "role": "派蒙",
          "text": "咦？你们拿走了什么，难道要把这几尊大石像都搬回去吗？"
        },
        {
          "role": "梅康顿",
          "text": "当然不是，我们拿走的并非如此沉重的事物。"
        },
        {
          "role": "戈伦德兰",
          "text": "真高兴你们现在的精神状态还算正常。路通，帮我扛着他的胳膊，把这老兄带走，他哭得都没力气走路了。"
        },
        {
          "role": "加尔恰",
          "text": "旅行者，带路就拜托你了。"
        },
        {
          "type": "subtitle",
          "text": "返回佩特莉可镇"
        },
        {
          "role": "戈伦德兰",
          "text": "我不是…我不会成为那种折磨你的人，绝不会，绝不会…呜呜呜…"
        },
        {
          "role": "派蒙",
          "text": "情绪…真的完全崩溃了呢…"
        },
        {
          "role": "迦雅",
          "text": "在梦里经历了他人的人生…又回到现实里，明白了那人经历着怎样的痛苦…"
        },
        {
          "role": "迦雅",
          "text": "本以为是大梦一场，却又被告知，梦里的经历都是真实的，自己所知晓的那个人的人生也是真实的"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就像是过了第二次人生一样。",
              "dialogues": []
            },
            {
              "text": "让他好好缓缓吧。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "迦雅",
          "text": "唉，我再去煮点喝的，加尔恰，你能来帮我吗？"
        },
        {
          "role": "加尔恰",
          "text": "好的，这就来。路通，你就在这里看着戈伦德兰，如果他是在装疯卖傻…"
        },
        {
          "role": "路通",
          "text": "我就会让他真的变傻。"
        },
        {
          "role": "派蒙",
          "text": "不过，巴比斯先生和梅康顿先生却很正常呢，也不哭也不闹的。"
        },
        {
          "role": "巴比斯",
          "text": "因为这种在研究工作中身不由己的研究员，我们已经见过不少了。"
        },
        {
          "role": "梅康顿",
          "text": "当然，被如此直接地控制的研究员还是第一次见。"
        },
        {
          "role": "巴比斯",
          "text": "至于戈伦德兰为什么反应如此剧烈…从人情世故的角度出发，我们有一个猜想。"
        },
        {
          "role": "梅康顿",
          "text": "就像那句「卑劣者向来闭目」， 即使戈伦德兰已经用各种方式控制过不计其数的人…"
        },
        {
          "role": "巴比斯",
          "text": "…但他也从未留意，也从未亲身体验过，被人控制是一种怎样的感觉。"
        },
        {
          "role": "梅康顿",
          "text": "这次他不得不亲身体验一番这种痛苦了。"
        },
        {
          "role": "巴比斯",
          "text": "看这位先生的表现，想必印象十分深刻啊。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这下不得不体验了。",
              "dialogues": []
            },
            {
              "text": "希望他一直保留这份印象。",
              "dialogues": [
                {
                  "role": "梅康顿",
                  "text": "我们也如此希望。毕竟不是人人都能拥有这种体验。"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对了，你们之前还说，已经从那里拿走的纪念品，你们带走了什么呀？"
        },
        {
          "role": "巴比斯",
          "text": "我们记住了那两位研究员的研究成果。并且决定…顺着他们的思路继续开展研究。"
        },
        {
          "role": "梅康顿",
          "text": "我们可是「空想俱乐部」的成员，在研究思路里添加点「空想」是我们的特长。"
        },
        {
          "role": "巴比斯",
          "text": "哈哈哈，我已经等不及去设计那种小型舰船了！我一定要把最新的推进装置装上去！"
        },
        {
          "role": "梅康顿",
          "text": "我等会就去找加尔恰借推数机，精细计算一下那种大型桥梁的各项参数…还要考察地形！"
        },
        {
          "role": "巴比斯",
          "text": "希望那两位研究员前辈能够喜欢我们的「空想」。"
        },
        {
          "role": "梅康顿",
          "text": "如果他们不喜欢的话，欢迎这二位造访我们的梦境，我们可以一起详细讨论研究方案。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "「空想」真是一种强大的力量。",
              "dialogues": []
            },
            {
              "text": "不愧是「空想俱乐部」。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "路通",
          "text": "而我嘛…等戈伦德兰先生能走了，我会把他带给梅莘警官。"
        },
        {
          "role": "路通",
          "text": "梅莘警官一定猜不到，这件复杂的事务会如此结束…"
        },
        {
          "role": "戈伦德兰",
          "text": "我…呜呜呜…我绝不会成为那种…不、不对，我已经是那种人了！"
        },
        {
          "role": "戈伦德兰",
          "text": "呜呜呜呜呜呜——"
        }
