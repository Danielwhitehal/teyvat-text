{
  "quest_id": 467,
  "chapter_num": null,
  "chapter_title": "烹饪的诀窍",
  "type": "iq",
  "route": "The Art of Cooking",
  "stories": [
    {
      "story_id": 467,
      "title": "烹饪的诀窍",
      "description": "在蒙德城外，冒险家琳小姐似乎正在准备进行烹饪…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与琳对话"
        },
        {
          "role": "琳",
          "text": "材料都到手了吗？"
        },
        {
          "role": "琳",
          "text": "快去<color=#00E1FFFF>锅子</color>那边吧，借你随意地用。"
        },
        {
          "role": "琳",
          "text": "下一道菜做什么好呢…"
        },
        {
          "role": "琳",
          "text": "嗯？你们也是附近的冒险家吗？"
        },
        {
          "role": "派蒙",
          "text": "是路过的旅行者哦。你是在准备做饭吗？"
        },
        {
          "role": "琳",
          "text": "是旅行者呀，欢迎欢迎。"
        },
        {
          "role": "琳",
          "text": "我是琳，冒险家协会的生存专家，如你所见正在研究烹饪。"
        },
        {
          "role": "琳",
          "text": "毕竟「吃饱了再上路」，是「野外生存守则」的第一条呢。"
        },
        {
          "role": "派蒙",
          "text": "野餐！我也很喜欢。"
        },
        {
          "role": "派蒙",
          "text": "我的旅伴也很擅长烹饪哦，对吧对吧？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "只会一些最简单的…",
              "dialogues": [
                {
                  "role": "琳",
                  "text": "没关系，锅子已经架好了，让我看看你的手艺吧！"
                },
                {
                  "role": "琳",
                  "text": "生存专家亲自指导，机会可不多哦！"
                }
              ]
            },
            {
              "text": "没错，我也喜欢烹饪。",
              "dialogues": [
                {
                  "role": "琳",
                  "text": "哦！锅子已经架好了，让我看看你的手艺吧！"
                },
                {
                  "role": "琳",
                  "text": "有这样切磋厨艺的机会真是难得。"
                }
              ]
            }
          ]
        },
        {
          "role": "琳",
          "text": "我放了些蘑菇和肉在那边的桶里，试着做一份<color=#00E1FFFF>「野菇鸡肉串」</color>给我吧。"
        },
        {
          "type": "subtitle",
          "text": "将「野菇鸡肉串」交给琳"
        },
        {
          "role": "琳",
          "text": "已经做好了吗？嗯…闻起来好像不错！"
        },
        {
          "role": "琳",
          "text": "那我就不客气啦…"
        },
        {
          "role": "琳",
          "text": "嗯…"
        },
        {
          "role": "琳",
          "text": "（嚼嚼）"
        },
        {
          "role": "琳",
          "text": "唔…"
        },
        {
          "role": "派蒙",
          "text": "（咽口水）"
        },
        {
          "role": "琳",
          "text": "唔…一言难尽的味道，勉强及格吧~！"
        },
        {
          "role": "派蒙",
          "text": "咦？旅行者应该只是没发挥好，不算不算~！"
        },
        {
          "role": "琳",
          "text": "嗯，只要多加练习，你还是很有潜力的！"
        },
        {
          "role": "琳",
          "text": "我的包裹里还有一些生的食材，送给你吧，就当做这一餐的回礼。"
        },
        {
          "role": "派蒙",
          "text": "咦？这不太好吧，你自己没东西下锅了怎么办？"
        },
        {
          "role": "琳",
          "text": "没关系哦，<color=#00E1FFFF>野外探险</color>时可以搜集到很多食材，你们也可以多多留意。"
        },
        {
          "role": "琳",
          "text": "<color=#00E1FFFF>「猎鹿人」餐馆</color>也会有食材和料理出售，有空就去转转吧。"
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，谢谢你的情报…喂！「野菇鸡肉串」给我留一点呀！"
        }
      ]
    }
  ]
}