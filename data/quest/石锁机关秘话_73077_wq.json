{
  "quest_id": 73077,
  "chapter_num": null,
  "chapter_title": "石锁机关秘话",
  "type": "wq",
  "route": "Legends of the Stone Lock",
  "stories": [
    {
      "story_id": 73077,
      "title": "石锁机关秘话",
      "description": "在须弥解开石头锁，解决封印中的怪物后，受出现的兰那罗委托，解决其他被锁住的怪物…",
      "dialogues": [
        {
          "role": "兰提沙",
          "text": "那菈旅行者，很厉害，有你在，我们一定能够打倒「大方方铁块」的！"
        },
        {
          "role": "兰耶多",
          "text": "能不能打倒「大方方铁块」呢…这可是故事里出现的可怕怪物，有些紧张…"
        },
        {
          "role": "兰沙陀",
          "text": "故事里，「大方方铁块」变化多端，还会如蘑菇一般，分裂成好几个「大大铁块」…"
        },
        {
          "role": "兰沙陀",
          "text": "但只要打倒其中关键的一只，就能让「大方方铁块」露出破绽。要小心观察，那菈旅行者。"
        },
        {
          "role": "兰沙诃",
          "text": "…很少和那菈说话。"
        },
        {
          "role": "兰沙诃",
          "text": "…谢谢你，好那菈。"
        },
        {
          "role": "兰提沙",
          "text": "啊呀，石头锁！石头锁不见了！"
        },
        {
          "role": "兰提沙",
          "text": "到底是谁呀，是谁破坏了石头锁呀…难道是「大大铁块」…"
        },
        {
          "role": "派蒙",
          "text": "是兰那罗…"
        },
        {
          "role": "兰提沙",
          "text": "啊呀，能看见兰提沙，是金色的那菈和银色的鸟。"
        },
        {
          "role": "派蒙",
          "text": "我才不是什么银色的鸟呢！我是派蒙…金色的是旅行者。"
        },
        {
          "role": "兰提沙",
          "text": "是那菈旅行者和派蒙，兰提沙记住了，兰提沙的名字是兰提沙…"
        },
        {
          "role": "兰提沙",
          "text": "欸嘿嘿，是跟故事里那菈法留纳一样的金色的那菈，金色那菈，有着阳光晒过的树叶那样温暖的味道…"
        },
        {
          "role": "兰提沙",
          "text": "啊呀，现在不是交朋友时间，石头锁！石头锁，那菈旅行者和派蒙在这儿…有没有看到破坏石头锁的坏家伙！"
        },
        {
          "role": "派蒙",
          "text": "石头锁，应该说的就是刚才我们打开的…"
        },
        {
          "role": "旅行者",
          "text": "确实是我们破坏的…"
        },
        {
          "role": "兰提沙",
          "text": "什么呀，原来破坏石头锁的是那菈旅行者…兰提沙还以为是「大大铁块」自己跑出来了呢…啊！"
        },
        {
          "role": "兰提沙",
          "text": "石头锁没了！「大大铁块」要跑出来了！"
        },
        {
          "role": "兰提沙",
          "text": "那菈旅行者和派蒙，你们快躲起来，「大大铁块」，又大又坚硬，有的眼睛还会冒火，危险危险！"
        },
        {
          "role": "派蒙",
          "text": "兰提沙你说的是被困在里面的怪物吗，已经被我们消灭啦…"
        },
        {
          "role": "兰提沙",
          "text": "什么呀，原来「大大铁块」们被消灭了…欸嘿嘿，好呀好呀，想到「大大铁块」跑出来，兰提沙差点吓得叶子快要掉了…"
        },
        {
          "role": "兰提沙",
          "text": "咦！是那菈旅行者和派蒙把这里的「大大铁块」们解决掉的吗！"
        },
        {
          "role": "派蒙",
          "text": "我们已经解决掉过很多这样的怪物啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "已经是熟练工了…",
              "dialogues": []
            },
            {
              "text": "派蒙最好有出手过哦…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘿嘿，我有好好躲起来，不让你担心嘛！"
                }
              ]
            }
          ]
        },
        {
          "role": "兰提沙",
          "text": "没想到那菈旅行者居然有这样的力量…欸嘿嘿，兰提沙有件事想拜托那菈旅行者帮忙…"
        },
        {
          "role": "派蒙",
          "text": "什么事呀，不会是，和这些石头锁有关…"
        },
        {
          "role": "兰提沙",
          "text": "派蒙，好聪明！兰提沙有点惊讶…"
        },
        {
          "role": "派蒙",
          "text": "你惊讶什么呀！"
        },
        {
          "role": "兰提沙",
          "text": "欸嘿嘿，确实和石头锁有关…"
        },
        {
          "role": "兰提沙",
          "text": "石头锁，在森林里，有十六个石头锁，里面有「大大铁块」，旅行者能帮忙打倒那些「大大铁块」吗…"
        },
        {
          "role": "旅行者",
          "text": "只有十六个？已经处理完了。"
        },
        {
          "role": "兰提沙",
          "text": "欸！那菈旅行者和派蒙，真是太厉害了！难怪，兰提沙，感觉到森林里的大气和土都变得更加干净了。"
        },
        {
          "role": "兰提沙",
          "text": "等一下兰提沙，兰提沙叫朋友来一起！"
        },
        {
          "type": "subtitle",
          "text": "前往兰提沙之前所在的洞窟"
        },
        {
          "role": "兰提沙",
          "text": "啊呀，是那菈旅行者和派蒙，你们果然来了！"
        },
        {
          "role": "派蒙",
          "text": "嗯，我们把所有被石头锁住的怪物都打倒啦。"
        },
        {
          "role": "兰提沙",
          "text": "欸嘿嘿，兰提沙相信那菈旅行者和派蒙一定能做到的，了不起！"
        },
        {
          "role": "兰提沙",
          "text": "你们看，这就是兰提沙说的那菈旅行者…"
        },
        {
          "role": "兰提沙",
          "text": "那菈旅行者和派蒙，在这里的是兰沙陀，兰沙诃和兰耶多…"
        },
        {
          "role": "派蒙",
          "text": "兰那罗的名字又变多了，兰提沙，兰沙陀，兰沙诃和…"
        },
        {
          "role": "兰耶多",
          "text": "兰耶多，我的名字是兰耶多啦！"
        },
        {
          "role": "派蒙",
          "text": "是，我记住啦！兰耶多！"
        },
        {
          "role": "兰耶多",
          "text": "我的名字被派蒙记住啦，真是开心。"
        },
        {
          "role": "兰沙陀",
          "text": "嗯…我是，兰沙陀…"
        },
        {
          "role": "兰沙诃",
          "text": "…兰沙诃。"
        },
        {
          "role": "旅行者",
          "text": "你们好。"
        },
        {
          "role": "派蒙",
          "text": "不过兰提沙，你说十六个石头锁里的「大大铁块」全打倒了，就来找你，是为了什么呀…"
        },
        {
          "role": "兰提沙",
          "text": "啊呀…这件事要从很久很久以前说起…"
        },
        {
          "role": "兰提沙",
          "text": "在树木枯荣了数百次，那么久的以前，地上突然出现了各种各样的铁怪物，有的是大铁块那菈，有的是没有脚的大铁块那菈…"
        },
        {
          "role": "兰提沙",
          "text": "这些怪物有山那么高，喷出像火一样的光芒，那个时候，森林也发出哀叹，灌木在熊熊燃烧的烈焰中哭泣…"
        },
        {
          "role": "派蒙",
          "text": "就是那些「大大铁块」吗…"
        },
        {
          "role": "兰提沙",
          "text": "是的…"
        },
        {
          "role": "兰耶多",
          "text": "后面的故事我来说，我最喜欢后面的故事。"
        },
        {
          "role": "兰耶多",
          "text": "就在很危险很危险的时候，了不起的兰帝裟出现了。"
        },
        {
          "role": "兰耶多",
          "text": "了不起的兰帝裟用他的「兰迦拉梨」打倒了许多许多的「大大铁块」，并将他们用石头锁锁了起来。"
        },
        {
          "role": "兰耶多",
          "text": "就这样，了不起的兰帝裟让诸多叶荫覆盖之处恢复往日的平静，让那菈和兰那罗都能在夜晚回到森林里休息。"
        },
        {
          "role": "派蒙",
          "text": "哇，所以我们解开石头锁里，出现的那些遗迹重机，遗迹龙兽什么的，以前全是被兰帝裟打倒并封印的吗！"
        },
        {
          "role": "兰耶多",
          "text": "是呀，兰帝裟了不起，和那么多「大大铁块」周旋战斗！我最喜欢兰帝裟的故事…"
        },
        {
          "role": "派蒙",
          "text": "所以，兰帝裟锁住的那些「大大铁块」，全都被旅行者打倒了，为什么还要我们过来呢…"
        },
        {
          "role": "兰沙陀",
          "text": "唔…其实，兰帝裟将「大大铁块」用石头锁锁住，然而再牢固的山崖也会因狂风崩落土石，再雄伟的蚁穴也会因暴雨坍塌成泥…"
        },
        {
          "role": "兰沙陀",
          "text": "石头锁也是一样…产生裂隙，掉落碎块，直到最终，化为巴螺迦。"
        },
        {
          "role": "兰沙陀",
          "text": "到那时，「大大铁块」挣脱石头锁，森林里灾厄丛生…所以，要看管石头锁。"
        },
        {
          "role": "兰提沙",
          "text": "啊呀，不过即使小心看管，要是一不小心没发现石头锁被挣开，那就不好了，所以兰提沙，兰沙陀，兰沙诃和兰耶多要变强。"
        },
        {
          "role": "兰提沙",
          "text": "要是和守护法留纳神机的兰百梨迦一样，能够用兰迦拉梨打倒「大大铁块」，就不用害怕石头锁化为巴螺迦了…"
        },
        {
          "role": "派蒙",
          "text": "所以你们原本打算自己打倒那些「大大铁块」的嘛…"
        },
        {
          "role": "派蒙",
          "text": "怎么就变成我们去解决那些「大大铁块」了！"
        },
        {
          "role": "兰提沙",
          "text": "唔，「大大铁块」，传说中的怪物，要是修炼了，打不过，却打开了石头锁…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那确实会变得很危险…",
              "dialogues": []
            },
            {
              "text": "会造成很严重后果呢…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰提沙",
          "text": "但那菈旅行者很厉害，能打倒「大大铁块」…有那菈旅行者的帮助，就能打倒最厉害的「大方方铁块」！"
        },
        {
          "role": "派蒙",
          "text": "对哦，所以你叫我们过来，是为了「大方方铁块」？"
        },
        {
          "role": "兰提沙",
          "text": "「大方方铁块」比「大大铁块」还厉害…我们的兰迦拉梨只能困住它…"
        },
        {
          "role": "兰提沙",
          "text": "所以兰提沙看见能够打败「大大铁块」的那菈旅行者，就觉得那菈旅行者一定能打赢「大方方铁块」…"
        },
        {
          "role": "兰提沙",
          "text": "兰提沙还想拜托那菈旅行者一次…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "无论是什么铁块都行。",
              "dialogues": []
            },
            {
              "text": "我会帮你们的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰提沙",
          "text": "呜呜，那菈旅行者真是好那菈…"
        },
        {
          "role": "兰耶多",
          "text": "那菈旅行者，金光闪闪，跟故事里的那菈法留纳一样！"
        },
        {
          "role": "兰沙陀",
          "text": "那菈旅行者愿意帮助，正如久旱的卷草遇到天降的甘霖…"
        },
        {
          "role": "兰沙诃",
          "text": "…谢谢。"
        },
        {
          "role": "派蒙",
          "text": "可是，你们之前说，「大方方铁块」在湖底，我们要怎么到湖底去呢？"
        },
        {
          "role": "兰提沙",
          "text": "没有关系，让水变低低，露出道路就好了！"
        },
        {
          "role": "兰提沙",
          "text": "那就请那菈旅行者稍等一下…我们在湖水之下见面吧…"
        },
        {
          "type": "subtitle",
          "text": "前往湖底的封印之处"
        },
        {
          "role": "派蒙",
          "text": "原来这个就是「大方方铁块」啊…"
        },
        {
          "role": "派蒙",
          "text": "「大大铁块」是遗迹重机，遗迹龙兽之类的…「大方方铁块」是恒常机关阵列也不意外呢…"
        },
        {
          "role": "兰耶多",
          "text": "好奇怪，明明「大方方铁块」并不长，却叫「很长机关阵列」。"
        },
        {
          "role": "派蒙",
          "text": "待会儿就会分裂出很长的东西啦，不对，不是那个「很长」…算了，还是暂时叫它「大方方铁块」吧…"
        },
        {
          "role": "兰耶多",
          "text": "「大方方铁块」！"
        },
        {
          "role": "兰沙陀",
          "text": "「大方方铁块」，会飞到空中，再如流星般砸下…那菈旅行者务必小心…"
        },
        {
          "role": "兰沙诃",
          "text": "…小心。"
        },
        {
          "role": "兰提沙",
          "text": "那菈旅行者，我们也用兰迦拉梨，帮助你！"
        },
        {
          "role": "兰提沙",
          "text": "如果准备好了，就打开锁住「大方方铁块」的石头锁吧！"
        },
        {
          "type": "subtitle",
          "text": "与「大方方铁块」战斗"
        },
        {
          "type": "subtitle",
          "text": "与兰提沙对话"
        },
        {
          "role": "兰提沙",
          "text": "…啊呀，没想到，就算使用「兰迦拉梨」，「大方方铁块」还有那么强的力量。"
        },
        {
          "role": "兰提沙",
          "text": "就算我们的兰迦拉梨能够打倒「大大铁块」，但肯定打不倒「大方方铁块」…"
        },
        {
          "role": "兰提沙",
          "text": "如果不是那菈旅行者在场…"
        },
        {
          "role": "派蒙",
          "text": "没有关系啦，反正现在恒常机关阵列…不对，反正「大方方铁块」已经被打倒了，现在已经不会再有铁怪物来破坏森林了！"
        },
        {
          "role": "旅行者",
          "text": "嗯，你们可以放心了…"
        },
        {
          "role": "兰沙诃",
          "text": "…不行。"
        },
        {
          "role": "兰沙诃",
          "text": "…得靠自己。"
        },
        {
          "role": "兰沙陀",
          "text": "兰沙诃说得对，看到那菈旅行者和「大方方铁块」对战，如同幼鸟见识到峰巅之高，砾石触及大地之广。"
        },
        {
          "role": "兰耶多",
          "text": "我们离了不起的兰帝裟，还有很远的距离…"
        },
        {
          "role": "兰耶多",
          "text": "一定要更加努力的修炼，下一次森林陷入危机时，才能成为兰帝裟那样的英雄！"
        },
        {
          "role": "兰提沙",
          "text": "我们要在梦境里，和想象出来的「大方方铁块」进行战斗！"
        },
        {
          "role": "派蒙",
          "text": "加油啊！"
        },
        {
          "role": "旅行者",
          "text": "你们一定能成功的。"
        },
        {
          "role": "兰提沙",
          "text": "那菈旅行者，如果你想来的话，就跟进入桓那兰那时一样，在这里吹响「大梦的曲调」吧…"
        },
        {
          "role": "兰提沙",
          "text": "那样就能进入我们的梦，与我们共享一个有「大方方铁块」的梦境了…"
        },
        {
          "role": "派蒙",
          "text": "呜哇，听上去不像是个好梦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙会做战斗的梦吗…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "我才不要做呢，我要做有很多好吃的食物的那种梦。"
                }
              ]
            },
            {
              "text": "梦里不会有真的危险…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是呢，毕竟是他们自己的梦…他们想象的恒常机关阵列也不会跑出来，就算在梦里打不过也不会受伤…"
                }
              ]
            }
          ]
        },
        {
          "role": "兰提沙",
          "text": "那兰提沙和兰沙陀，兰耶多，兰沙诃，就先去梦境中修炼了！"
        },
        {
          "role": "兰沙陀",
          "text": "嗯，那菈旅行者，为表感谢，我将用清晨时的第一缕阳光铭记你。"
        },
        {
          "role": "兰耶多",
          "text": "那菈旅行者，就跟那菈法留纳一样了不起！"
        },
        {
          "role": "兰沙诃",
          "text": "…不会忘记你。"
        },
        {
          "role": "兰提沙",
          "text": "啊呀，如果可以的话，在梦中再次相遇吧！"
        },
        {
          "role": "兰提沙",
          "text": "啊呀，石头锁！石头锁不见了！"
        },
        {
          "role": "兰提沙",
          "text": "到底是谁呀，是谁破坏了石头锁呀…难道是「大大铁块」…"
        },
        {
          "role": "派蒙",
          "text": "是兰那罗…"
        },
        {
          "role": "兰提沙",
          "text": "啊呀，能看见兰提沙，是金色的那菈和银色的鸟。"
        },
        {
          "role": "派蒙",
          "text": "我才不是什么银色的鸟呢！我是派蒙…金色的是旅行者。"
        },
        {
          "role": "兰提沙",
          "text": "是那菈旅行者和派蒙，兰提沙记住了，兰提沙的名字是兰提沙…"
        },
        {
          "role": "兰提沙",
          "text": "欸嘿嘿，是跟故事里那菈法留纳一样的金色的那菈，金色那菈，有着阳光晒过的树叶那样温暖的味道…"
        },
        {
          "role": "兰提沙",
          "text": "啊呀，现在不是交朋友时间，石头锁！石头锁，那菈旅行者和派蒙在这儿…有没有看到破坏石头锁的坏家伙！"
        },
        {
          "role": "派蒙",
          "text": "石头锁，应该说的就是刚才我们打开的…"
        },
        {
          "role": "旅行者",
          "text": "确实是我们破坏的…"
        },
        {
          "role": "兰提沙",
          "text": "什么呀，原来破坏石头锁的是那菈旅行者…兰提沙还以为是「大大铁块」自己跑出来了呢…啊！"
        },
        {
          "role": "兰提沙",
          "text": "石头锁没了！「大大铁块」要跑出来了！"
        },
        {
          "role": "兰提沙",
          "text": "那菈旅行者和派蒙，你们快躲起来，「大大铁块」，又大又坚硬，有的眼睛还会冒火，危险危险！"
        },
        {
          "role": "派蒙",
          "text": "兰提沙你说的是被困在里面的怪物吗，已经被我们消灭啦…"
        },
        {
          "role": "兰提沙",
          "text": "什么呀，原来「大大铁块」们被消灭了…欸嘿嘿，好呀好呀，想到「大大铁块」跑出来，兰提沙差点吓得叶子快要掉了…"
        },
        {
          "role": "兰提沙",
          "text": "咦！是那菈旅行者和派蒙把这里的「大大铁块」们解决掉的吗！"
        },
        {
          "role": "派蒙",
          "text": "我们已经解决掉过很多这样的怪物啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "已经是熟练工了…",
              "dialogues": []
            },
            {
              "text": "派蒙最好有出手过哦…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嘿嘿，我有好好躲起来，不让你担心嘛！"
                }
              ]
            }
          ]
        },
        {
          "role": "兰提沙",
          "text": "没想到那菈旅行者居然有这样的力量…欸嘿嘿，兰提沙有件事想拜托那菈旅行者帮忙…"
        },
        {
          "role": "派蒙",
          "text": "什么事呀，不会是，和这些石头锁有关…"
        },
        {
          "role": "兰提沙",
          "text": "派蒙，好聪明！兰提沙有点惊讶…"
        },
        {
          "role": "派蒙",
          "text": "你惊讶什么呀！"
        },
        {
          "role": "兰提沙",
          "text": "欸嘿嘿，确实和石头锁有关…"
        },
        {
          "role": "兰提沙",
          "text": "石头锁，在森林里，有十六个石头锁，里面有「大大铁块」，旅行者能帮忙打倒那些「大大铁块」吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "当然可以…",
              "dialogues": []
            },
            {
              "text": "如果看到的话…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰提沙",
          "text": "呜呜，那菈旅行者真是好那菈，兰提沙，在这里由衷感谢那菈旅行者…"
        },
        {
          "role": "兰提沙",
          "text": "如果所有石头锁里的「大大铁块」都被打倒了，就来找我吧。"
        },
        {
          "role": "兰提沙",
          "text": "你们要是能打倒所有「大大铁块」的话，一定也可以…"
        },
        {
          "role": "派蒙",
          "text": "？"
        },
        {
          "role": "兰提沙",
          "text": "欸嘿嘿，不过等那菈旅行者来了，到时候兰提沙再和你们说吧！"
        },
        {
          "role": "派蒙",
          "text": "叫朋友是指…"
        },
        {
          "role": "派蒙",
          "text": "哇！一下变出这么多个兰那罗…"
        },
        {
          "role": "兰提沙",
          "text": "那菈旅行者和派蒙，在这里的是兰沙陀，兰沙诃和兰耶多…"
        },
        {
          "role": "派蒙",
          "text": "兰那罗的名字又变多了，兰提沙，兰沙陀，兰沙诃和…"
        },
        {
          "role": "兰耶多",
          "text": "兰耶多，我的名字是兰耶多啦！"
        },
        {
          "role": "派蒙",
          "text": "是，我记住啦！兰耶多！"
        },
        {
          "role": "兰耶多",
          "text": "我的名字被派蒙记住啦，真是开心。"
        },
        {
          "role": "兰沙陀",
          "text": "嗯…我是，兰沙陀…"
        },
        {
          "role": "兰沙诃",
          "text": "…兰沙诃。"
        },
        {
          "role": "旅行者",
          "text": "你们好。"
        },
        {
          "role": "派蒙",
          "text": "不过兰提沙，你说十六个石头锁里的「大大铁块」全打倒了，就来找你，是为了什么呀…"
        },
        {
          "role": "兰提沙",
          "text": "啊呀…这件事要从很久很久以前说起…"
        },
        {
          "role": "兰提沙",
          "text": "在树木枯荣了数百次，那么久的以前，地上突然出现了各种各样的铁怪物，有的是大铁块那菈，有的是没有脚的大铁块那菈…"
        },
        {
          "role": "兰提沙",
          "text": "这些怪物有山那么高，喷出像火一样的光芒，那个时候，森林也发出哀叹，灌木在熊熊燃烧的烈焰中哭泣…"
        },
        {
          "role": "派蒙",
          "text": "就是那些「大大铁块」吗…"
        },
        {
          "role": "兰提沙",
          "text": "是的…"
        },
        {
          "role": "兰耶多",
          "text": "后面的故事我来说，我最喜欢后面的故事。"
        },
        {
          "role": "兰耶多",
          "text": "就在很危险很危险的时候，了不起的兰帝裟出现了。"
        },
        {
          "role": "兰耶多",
          "text": "了不起的兰帝裟用他的「兰迦拉梨」打倒了许多许多的「大大铁块」，并将他们用石头锁锁了起来。"
        },
        {
          "role": "兰耶多",
          "text": "就这样，了不起的兰帝裟让诸多叶荫覆盖之处恢复往日的平静，让那菈和兰那罗都能在夜晚回到森林里休息。"
        },
        {
          "role": "派蒙",
          "text": "哇，所以我们解开石头锁里，出现的那些遗迹重机，遗迹龙兽什么的，以前全是被兰帝裟打倒并封印的吗！"
        },
        {
          "role": "兰耶多",
          "text": "是呀，兰帝裟了不起，和那么多「大大铁块」周旋战斗！我最喜欢兰帝裟的故事…"
        },
        {
          "role": "派蒙",
          "text": "所以，兰帝裟锁住的那些「大大铁块」，全都被旅行者打倒了，为什么还要我们过来呢…"
        },
        {
          "role": "兰沙陀",
          "text": "唔…其实，兰帝裟将「大大铁块」用石头锁锁住，然而再牢固的山崖也会因狂风崩落土石，再雄伟的蚁穴也会因暴雨坍塌成泥…"
        },
        {
          "role": "兰沙陀",
          "text": "石头锁也是一样…产生裂隙，掉落碎块，直到最终，化为巴螺迦。"
        },
        {
          "role": "兰沙陀",
          "text": "到那时，「大大铁块」挣脱石头锁，森林里灾厄丛生…所以，要看管石头锁。"
        },
        {
          "role": "兰提沙",
          "text": "啊呀，不过即使小心看管，要是一不小心没发现石头锁被挣开，那就不好了，所以兰提沙，兰沙陀，兰沙诃和兰耶多要变强。"
        },
        {
          "role": "兰提沙",
          "text": "要是和守护法留纳神机的兰百梨迦一样，能够用兰迦拉梨打倒「大大铁块」，就不用害怕石头锁化为巴螺迦了…"
        },
        {
          "role": "派蒙",
          "text": "所以你们原本打算自己打倒那些「大大铁块」的嘛…"
        },
        {
          "role": "派蒙",
          "text": "怎么就变成我们去解决那些「大大铁块」了！"
        },
        {
          "role": "兰提沙",
          "text": "唔，「大大铁块」，传说中的怪物，要是修炼了，打不过，却打开了石头锁…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那确实会变得很危险…",
              "dialogues": []
            },
            {
              "text": "会造成很严重后果呢…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰提沙",
          "text": "但那菈旅行者很厉害，能打倒「大大铁块」…有那菈旅行者的帮助，就能打倒最厉害的「大方方铁块」！"
        },
        {
          "role": "派蒙",
          "text": "对哦，所以你叫我们过来，是为了「大方方铁块」？"
        },
        {
          "role": "兰提沙",
          "text": "「大方方铁块」比「大大铁块」还厉害…我们的兰迦拉梨只能困住它…"
        },
        {
          "role": "兰提沙",
          "text": "所以兰提沙看见能够打败「大大铁块」的那菈旅行者，就觉得那菈旅行者一定能打赢「大方方铁块」…"
        },
        {
          "role": "兰提沙",
          "text": "兰提沙还想拜托那菈旅行者一次…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "无论是什么铁块都行。",
              "dialogues": []
            },
            {
              "text": "我会帮你们的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰提沙",
          "text": "呜呜，那菈旅行者真是好那菈…"
        },
        {
          "role": "兰耶多",
          "text": "那菈旅行者，金光闪闪，跟故事里的那菈法留纳一样！"
        },
        {
          "role": "兰沙陀",
          "text": "那菈旅行者愿意帮助，正如久旱的卷草遇到天降的甘霖…"
        },
        {
          "role": "兰沙诃",
          "text": "…谢谢。"
        },
        {
          "role": "派蒙",
          "text": "可是，你们之前说，「大方方铁块」在湖底，我们要怎么到湖底去呢？"
        },
        {
          "role": "兰提沙",
          "text": "没有关系，让水变低低，露出道路就好了！"
        },
        {
          "role": "兰提沙",
          "text": "那就请那菈旅行者稍等一下…我们在湖水之下见面吧…"
        }
      ]
    }
  ]
}