  "type": "iq",
  "route": "The Gourmet Supremos: Extreme Cookery",
  "stories": [
    {
      "story_id": 22030,
      "title": "全能美食队·厨道的极意",
      "description": "全能美食队的龟井宗久似乎有什么事想要找人帮忙…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与龟井宗久对话"
        },
        {
          "role": "龟井宗久",
          "text": "阁下，又见面了。"
        },
        {
          "role": "龟井宗久",
          "text": "恕在下唐突，今天有一事想请阁下帮助。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "什么事？",
              "dialogues": []
            },
            {
              "text": "不用这么客气…",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "是在下有求于阁下，这种礼节也是应当。"
                }
              ]
            }
          ]
        },
        {
          "role": "龟井宗久",
          "text": "在受旭东阁下雇佣后，我一直与他们同行。"
        },
        {
          "role": "龟井宗久",
          "text": "为了报答旭东阁下收留我之恩，我想做些谢礼赠予他。"
        },
        {
          "role": "龟井宗久",
          "text": "但旭东阁下比起武艺，更喜欢美食，所以我想要亲手制作些食品。"
        },
        {
          "role": "龟井宗久",
          "text": "在下本来已经看好了两处食材的所在地，打算等这些食材成熟后再去取用。"
        },
        {
          "role": "龟井宗久",
          "text": "可是，却有两股魔物分别占据了那两处食材所在地，而且还都已经把食材取下了。"
        },
        {
          "role": "龟井宗久",
          "text": "我所要制作的那道菜，最重要的就是食材新鲜，我本来打算先取一处，再去另外一处…"
        },
        {
          "role": "龟井宗久",
          "text": "但现在两边魔物都已经取下了食材，想要烹制那道菜，在下必须快些把那两道食材都拿到手才行。"
        },
        {
          "role": "龟井宗久",
          "text": "但在下…分身乏术，就算能对付一处的魔物，另一处的食材想必也早已被魔物糟蹋殆尽。"
        },
        {
          "role": "龟井宗久",
          "text": "所以，我想请阁下与我共同出手，一起击倒那些魔物，取得食材。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我了。",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "多谢阁下，在下感激不尽。"
                }
              ]
            },
            {
              "text": "做完了食物之后能分我点吗？",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "那是自然，阁下当取第一份。"
                }
              ]
            }
          ]
        },
        {
          "role": "龟井宗久",
          "text": "唔…在这里说也无用，阁下，请与我一同去前面一些的地方看看，然后我们再做商议吧。"
        },
        {
          "type": "subtitle",
          "text": "跟随龟井宗久"
        },
        {
          "role": "龟井宗久",
          "text": "就是这里了。两处魔物分别在左右两边扎了营。"
        },
        {
          "role": "龟井宗久",
          "text": "在下悄悄去侦察了一番，左边营地的魔物虽然弱小，但数量众多。"
        },
        {
          "role": "龟井宗久",
          "text": "右边营地的魔物虽然数量略少，但却格外强壮。"
        },
        {
          "role": "龟井宗久",
          "text": "有劳阁下清剿一处魔物，另一处交给在下即可。"
        },
        {
          "role": "旅行者",
          "text": "我去左边。"
        },
        {
          "role": "龟井宗久",
          "text": "那就有劳阁下了，在下这就去另一处营地。"
        },
        {
          "role": "旅行者",
          "text": "你一个人能对付它们吗？"
        },
        {
          "role": "龟井宗久",
          "text": "只是些许魔物罢了，无需担心，若不是担心食材，我一人就能对付这两处魔物。"
        },
        {
          "role": "龟井宗久",
          "text": "好了，阁下清剿完魔物，拿到食材后，再到另外一处营地寻我就是。"
        },
        {
          "role": "龟井宗久",
          "text": "我们快些出发吧，要是食材坏了，做出来的菜只怕无法入口了。"
        },
        {
          "role": "旅行者",
          "text": "我去右边。"
        },
        {
          "role": "龟井宗久",
          "text": "那就有劳阁下了，在下这就去另一处营地。"
        },
        {
          "role": "旅行者",
          "text": "你一个人能对付它们吗？"
        },
        {
          "role": "龟井宗久",
          "text": "只是些许魔物罢了，无需担心，若不是担心食材，我一人就能对付这两处魔物。"
        },
        {
          "role": "龟井宗久",
          "text": "好了，阁下清剿完魔物，拿到食材后，再到另外一处营地寻我就是。"
        },
        {
          "role": "龟井宗久",
          "text": "我们快些出发吧，要是食材坏了，做出来的菜只怕无法入口了。"
        },
        {
          "type": "subtitle",
          "text": "打倒左侧魔物营地内所有魔物"
        },
        {
          "role": "龟井宗久",
          "text": "阁下，您已经取到食材了吗？"
        },
        {
          "type": "subtitle",
          "text": "打倒右侧魔物营地内所有魔物"
        },
        {
          "type": "subtitle",
          "text": "在左侧魔物营地内寻找食材"
        },
        {
          "type": "subtitle",
          "text": "在右侧魔物营地内寻找食材"
        },
        {
          "type": "subtitle",
          "text": "将食材交给龟井宗久"
        },
        {
          "type": "subtitle",
          "text": "将食材交给龟井宗久"
        },
        {
          "type": "subtitle",
          "text": "与龟井宗久对话"
        },
        {
          "role": "龟井宗久",
          "text": "多谢阁下！这些食材还可以用，但不能再拖下去了…我现在就开始烹饪。"
        },
        {
          "role": "龟井宗久",
          "text": "完成了，呼…多亏了阁下，这道菜才能顺利完成。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还真是追求极致…",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "那是自然。无论是插花、茶道、烹饪，还是挥剑，如果不想追求极致，那就失去了从事其中的意义。"
                },
                {
                  "role": "龟井宗久",
                  "text": "「极意」之道，乃是我为人之道。但是…旭东阁下却似乎和我不同…"
                },
                {
                  "role": "龟井宗久",
                  "text": "旭东阁下曾和我说，璃月有两字，叫做「中庸」。"
                },
                {
                  "role": "龟井宗久",
                  "text": "意思是，无论是为人还是做事，切不可走极端，需不偏不倚，中庸平和才好。"
                },
                {
                  "role": "龟井宗久",
                  "text": "我是不太理解旭东阁下的这句话。"
                },
                {
                  "role": "龟井宗久",
                  "text": "但我想…也许旭东阁下也是经历了许多事，才能有这样的为人道理吧…"
                }
              ]
            },
            {
              "text": "那些魔物…",
              "dialogues": [
                {
                  "role": "龟井宗久",
                  "text": "已经被在下解决掉了，阁下无需担心。"
                }
              ]
            }
          ]
        },
        {
          "role": "龟井宗久",
          "text": "既然已经取得食材，也做好了美食，在下就不耽误阁下时间了。"
        },
        {
          "role": "龟井宗久",
          "text": "这份请阁下收好，在下会把其余的带回去给旭东阁下，他应该会愿意尝尝的。"
        },
        {
          "type": "subtitle",
