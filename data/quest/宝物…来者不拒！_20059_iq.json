{
  "quest_id": 20059,
  "chapter_num": null,
  "chapter_title": "宝物…来者不拒！",
  "type": "iq",
  "route": "The More Treasures the Merrier",
  "stories": [
    {
      "story_id": 20059,
      "title": "宝物…来者不拒！",
      "description": "玛乔丽小姐似乎正因为货物不足而发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与玛乔丽对话"
        },
        {
          "role": "玛乔丽",
          "text": "这下可糟糕了，怎么办呢…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "玛乔丽",
          "text": "旅行者！你来得正好！你知道，这里是我家开的纪念品商店。"
        },
        {
          "role": "玛乔丽",
          "text": "之前，我老爹会收购其他的冒险家带回来的战利品，然后摆在店里卖。"
        },
        {
          "role": "玛乔丽",
          "text": "但是自从冒险家协会…不是那么热闹之后，我能收购的东西也越来越少。"
        },
        {
          "role": "玛乔丽",
          "text": "而且还尽是一些不怎么值钱的东西，根本没有客人愿意买。"
        },
        {
          "role": "玛乔丽",
          "text": "旅行者，你会四处冒险对吧？能不能帮帮我，去找点好卖的战利品回来？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白了。",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "那就拜托你了！找到之后，我一定把它卖个好价钱。"
                }
              ]
            },
            {
              "text": "派蒙其实就…",
              "dialogues": [
                {
                  "role": "玛乔丽",
                  "text": "抱歉，应该没人会买哦。"
                },
                {
                  "role": "玛乔丽",
                  "text": "因为…肯定会自己跑掉。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与玛乔丽对话"
        },
        {
          "role": "玛乔丽",
          "text": "记住了吗？那就快去吧，我就在这等着你。"
        },
        {
          "type": "subtitle",
          "text": "向玛乔丽小姐领取报酬"
        },
        {
          "type": "subtitle",
          "text": "向玛乔丽交付丘丘人有关的战利品"
        }
      ]
    }
  ]
}