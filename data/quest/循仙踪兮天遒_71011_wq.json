  "stories": [
    {
      "story_id": 71011,
      "title": "循仙踪兮天遒",
      "description": "在天遒谷中有一块奇怪的石碑，上面似乎记录着一些与天遒谷有关的往事…",
      "dialogues": [
        {
          "role": "古老的碑文",
          "text": "「循仙踪兮天遒，顾宫墟兮怆仆。徽若陀兮叡后，恨繁囿兮作土。」"
        },
        {
          "role": "派蒙",
          "text": "呜哇…这座石碑上的字好难读。"
        },
        {
          "role": "派蒙",
          "text": "而且又是「仙踪」，又是「宫墟」的，到底是什么意思呢？"
        },
        {
          "role": "派蒙",
          "text": "不过，上面说「循仙踪兮天遒」…我们至少能确定，这座石碑上记录的事，就发生在这片「天遒谷」。"
        },
        {
          "role": "派蒙",
          "text": "唔…没办法，我们去周围看看吧，说不定会有什么发现呢。"
        },
        {
          "type": "subtitle",
          "text": "解开天遒谷的秘密"
        },
        {
          "type": "subtitle",
          "text": "打倒盗宝团"
        },
        {
          "type": "subtitle",
          "text": "获得宝藏"
        }
      ]
    }
  ]
}