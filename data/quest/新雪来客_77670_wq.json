{
  "quest_id": 77670,
  "chapter_num": null,
  "chapter_title": "新雪来客",
  "type": "wq",
  "route": "Newcomers in the Snow",
  "stories": [
    {
      "story_id": 77670,
      "title": "新雪来客",
      "description": "不知道曙光车站现在的情况如何，不如现在就去看看吧…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与沃雅妮莎对话"
        },
        {
          "role": "沃雅妮莎",
          "text": "阿——罗——夏——"
        },
        {
          "role": "沃雅妮莎",
          "text": "果然没来啊，还真是够「守信」的。"
        },
        {
          "role": "沃雅妮莎",
          "text": "昨天他和我说，今天要去处理紧急事务，说不定赶不过来，今天果然就没来。"
        },
        {
          "role": "沃雅妮莎",
          "text": "估计又是忙着去狩猎了吧，天天忙得不见人影…我还是先把挂饰挂上去吧。"
        },
        {
          "role": "柳明娜",
          "text": "汪！"
        },
        {
          "role": "沃雅妮莎",
          "text": "柳明娜！你在就好，等一下帮我去找找阿罗夏好吗？"
        },
        {
          "role": "柳明娜",
          "text": "汪汪！汪！"
        },
        {
          "role": "派蒙",
          "text": "呜哇，柳明娜一副驾轻就熟的样子，怎么感觉之前就经常做这种事…"
        },
        {
          "role": "沃雅妮莎",
          "text": "是啊，我之前想要送信给阿罗夏的时候，都是让柳明娜帮忙的。"
        },
        {
          "role": "沃雅妮莎",
          "text": "不然的话，谁能在野外找到潜伏下来的阿罗夏嘛…"
        },
        {
          "role": "沃雅妮莎",
          "text": "来，这个给你吃，稍等一下喔…"
        },
        {
          "role": "沃雅妮莎",
          "text": "旅行者，派蒙，你们也在这里等一下，我去找找留影机。"
        },
        {
          "role": "沃雅妮莎",
          "text": "既然阿罗夏人不在这里，那我们就和他的雪人合一张影吧。"
        },
        {
          "role": "旅行者",
          "text": "沃雅妮莎风急火燎地跑回去取来了留影机，和她一起回来的，还有奥黛塔和蕾托娃…"
        },
        {
          "role": "沃雅妮莎",
          "text": "好了！大家一起合一张影吧，蕾托娃，就拜托你留影啦。"
        },
        {
          "role": "蕾托娃",
          "text": "好、好的！沃雅妮莎小姐！"
        },
        {
          "role": "奥黛塔",
          "text": "…行吧。"
        },
        {
          "role": "沃雅妮莎",
          "text": "蕾托娃很有留影的天赋啊，拍得真好看。"
        },
        {
          "role": "蕾托娃",
          "text": "就是…自己随便研究了一下啦，嘿嘿…我回去练习啦！"
        },
        {
          "role": "蕾托娃",
          "text": "再见，沃雅妮莎首席，奥黛塔姐姐，旅行者和小派蒙！"
        },
        {
          "role": "沃雅妮莎",
          "text": "好了，柳明娜，这张画片就拜托你了，快带去给阿罗夏吧。"
        },
        {
          "role": "柳明娜",
          "text": "汪汪！汪！"
        },
        {
          "role": "沃雅妮莎",
          "text": "好了，大功告成，旅行者和派蒙，谢谢你们陪我。"
        },
        {
          "role": "沃雅妮莎",
          "text": "喏，这些挂饰是送给你们的，就当做是纪念吧。"
        },
        {
          "role": "沃雅妮莎",
          "text": "无论是挂在身上还是雪人上，应该都会很好看的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "谢谢…",
            "你是做了不止一个吗？"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "是啊，反正有多的材料，顺手就做了。有朋友在身边，也顺手就送了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "好好保管，千万别弄丢，不然的话…"
        },
        {
          "role": "旅行者",
          "text": "不然的话…"
        },
        {
          "role": "沃雅妮莎",
          "text": "你们就要来找我，拜托我重新做一份给你们了。我平时的演出那么多，可是很难找的。"
        },
        {
          "role": "沃雅妮莎",
          "text": "总之，好好保管这些挂饰吧。我也该回去，准备下一场演出了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "可惜啊，就算把留声机埋在这些雪人里，让它们学会了唱歌，雪人也无法登上舞台。"
        },
        {
          "role": "沃雅妮莎",
          "text": "在台上的灯光和观众的目光下…它们只会迅速融化。"
        },
        {
          "role": "沃雅妮莎",
          "text": "…这样，这样…然后再这样…"
        },
        {
          "role": "沃雅妮莎",
          "text": "哈！好啦！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "这是…",
            "沃雅妮莎在堆雪人？"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "是啊，怎么样？堆得还行吧，我是不是该往上再浇一盆水，让它冻得再结实点…"
        },
        {
          "role": "沃雅妮莎",
          "text": "算了算了，要是谁脚一滑，一头狠狠撞在被冻结实的雪人上就糟糕了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "没事没事。",
            "世界之大无奇不有。",
            "被雪人击晕的概率也不为零嘛。"
          ]
        },
        {
          "role": "派蒙",
          "text": "哈哈哈…听着虽然很稀奇，但也不像是什么好事呢…"
        },
        {
          "role": "沃雅妮莎",
          "text": "喔，这么一说还挺有趣的。但…还是算了，我可不想让「哐哐当当雀雀球」因为这种事而出名…"
        },
        {
          "role": "派蒙",
          "text": "（…旅行者，是、是我的错觉吗？但我感觉有一瞬间…）"
        },
        {
          "role": "派蒙",
          "text": "（沃雅妮莎好像真的在认真考虑这件事…）"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "（没、没事…）",
            "（还是摊子比较重要…）"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "这样子就堆好了，最后再挂上这个挂饰…"
        },
        {
          "role": "沃雅妮莎",
          "text": "好嘞，雪人版的我大功告成，以后我不在这里的时候，就拜托它来看摊子和招揽顾客了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "我也和奥黛塔和阿罗夏说了，他们也各自堆好了雪人。"
        },
        {
          "role": "沃雅妮莎",
          "text": "我本来还想在雪人里埋点留声机之类，能发出声音的东西，让它能不间断地唱歌和说话。"
        },
        {
          "role": "沃雅妮莎",
          "text": "但挑来挑去，现在市面上的留声器材，都不太能在雪地里长时间运转…"
        },
        {
          "role": "沃雅妮莎",
          "text": "唉，可惜我也不认识擅长改造机械的人，只能…"
        },
        {
          "role": "派蒙",
          "text": "擅长改造机械的人？嗯…我们认识呀，有好多好多。"
        },
        {
          "role": "派蒙",
          "text": "桑多涅、爱诺、伊涅芙、希诺宁、菲米尼、闲云…这还没算上枫丹科学院的人呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "有机会的话…",
            "我介绍几个你认识？"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "（桑多涅，不就是那位愚人众执行官么？呵…算了，也与我无关。）"
        },
        {
          "role": "沃雅妮莎",
          "text": "不愧是鼎鼎大名的旅行者，人脉可真广。"
        },
        {
          "role": "沃雅妮莎",
          "text": "那就说好了，等有空的时候，你把那几位擅长改造机械的朋友请来至冬——当然，「木偶」大人我就不麻烦了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "食宿什么的就由我包了，只要能帮我做一台耐寒的留声机就行！"
        },
        {
          "role": "沃雅妮莎",
          "text": "哈哈哈哈哈，到时候我就在剧院门口堆一大堆雪人…"
        },
        {
          "role": "沃雅妮莎",
          "text": "然后，在每一个雪人里都塞一台留声机！"
        },
        {
          "role": "沃雅妮莎",
          "text": "周一周三和周五放我唱的歌，周二周四和周六放奥黛塔跳舞时的伴奏…"
        },
        {
          "role": "旅行者",
          "text": "周日休息？"
        },
        {
          "role": "沃雅妮莎",
          "text": "不，周日放我们俩演出时台下的掌声。"
        },
        {
          "role": "沃雅妮莎",
          "text": "嗯！就这么定了，我先不告诉奥黛塔，到时候给她一个惊喜。"
        },
        {
          "role": "沃雅妮莎",
          "text": "啊…先不说这些，我也给奥黛塔和阿罗夏的雪人做了挂饰，说好了今天拿去给他们。"
        },
        {
          "role": "沃雅妮莎",
          "text": "他们现在应该来了…走吧旅行者，我们一起过去。"
        },
        {
          "role": "奥黛塔",
          "text": "…不需要挂饰。"
        },
        {
          "role": "沃雅妮莎",
          "text": "需要！很好看的！"
        },
        {
          "role": "奥黛塔",
          "text": "我知道好看，但我不需要。"
        },
        {
          "role": "沃雅妮莎",
          "text": "我知道你不需要，但你的雪人需要！"
        },
        {
          "role": "奥黛塔",
          "text": "……"
        },
        {
          "role": "沃雅妮莎",
          "text": "不然我们去问问雪人？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "雪人没回答欸。",
            "雪人说需要。"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "奥黛塔，你都把她吓着了。"
        },
        {
          "role": "奥黛塔",
          "text": "如果她回答了，那我们就要被吓着了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "哎呀，挂上嘛挂上嘛，这样子雪人就可以替你监督蕾托娃了。"
        },
        {
          "role": "奥黛塔",
          "text": "如果她的练习需要监督，那她的练习就毫无意义。"
        },
        {
          "role": "沃雅妮莎",
          "text": "那就是…让你的雪人陪着她，蕾托娃肯定会高兴的。"
        },
        {
          "role": "奥黛塔",
          "text": "…好吧。"
        },
        {
          "role": "沃雅妮莎",
          "text": "嗯！果然很好看，这样子蕾托娃练习的时候，一定会更有劲头的！"
        },
        {
          "role": "派蒙",
          "text": "已经挂好了？到底是什么时候——"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "妖精的身手不凡…",
            "身手不凡啊…"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "过几天，我也给蕾托娃做一份挂饰，就作为…嗯，辛苦练习的奖励吧。"
        },
        {
          "role": "奥黛塔",
          "text": "对她来说，练习本身就是最好的奖励。"
        },
        {
          "role": "奥黛塔",
          "text": "…但这样也没什么不好，等你做好了，我会转交给她的。"
        },
        {
          "role": "沃雅妮莎",
          "text": "或者，你亲手做？"
        },
        {
          "role": "奥黛塔",
          "text": "我做的是另一份，不冲突。"
        },
        {
          "role": "奥黛塔",
          "text": "时间到了，我要去指导蕾托娃了，如果你们想旁观，跟上来也行。"
        },
        {
          "role": "沃雅妮莎",
          "text": "我们还要去阿罗夏那边呢，就先走了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "替我和蕾托娃说一声，如果她想的话，我可以带她偷偷进剧院熟悉一下舞台。"
        },
        {
          "role": "奥黛塔",
          "text": "提前登上舞台，只会让蕾托娃志得意满，骄纵轻狂。"
        },
        {
          "role": "奥黛塔",
          "text": "现在，她只需要在雪地上练习就好。"
        },
        {
          "role": "奥黛塔",
          "text": "继续。"
        },
        {
          "role": "蕾托娃",
          "text": "是！"
        }
      ]
    }
  ]
}