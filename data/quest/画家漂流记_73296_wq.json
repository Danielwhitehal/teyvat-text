{
  "quest_id": 73296,
  "chapter_num": null,
  "chapter_title": "画家漂流记",
  "type": "wq",
  "route": "An Artist Adrift",
  "stories": [
    {
      "story_id": 73296,
      "title": "画家漂流记",
      "description": "自称枫丹知名画家的于连仍在须弥滞留…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往水边营地"
        },
        {
          "role": "于连",
          "text": "派蒙，还有旅行者，你们果然来了！出门在外还是得靠朋友啊。"
        },
        {
          "role": "派蒙",
          "text": "因为答应了给你带路嘛，而且带路也不是什么难事！举手之劳…这时候该说是举足之劳吗？"
        },
        {
          "role": "派蒙",
          "text": "不过，你真的这么快就回枫丹吗？难得到了须弥，其实须弥可看的风景还是很多的…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "雨林的风景很不错。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "有很多树，很多河！"
                }
              ]
            },
            {
              "text": "沙漠的景观很特别。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "有很多沙，很多遗迹！"
                }
              ]
            }
          ]
        },
        {
          "role": "于连",
          "text": "听起来确实很诱人，但是我想…我其实还没有做好远游的准备。这次虽然是一次失败的旅行，但是也算是收获了一些教训吧…"
        },
        {
          "role": "派蒙",
          "text": "唔…那…那这附近也有很值得一看的景观呢！要是错过就太可惜啦。"
        },
        {
          "role": "旅行者",
          "text": "派蒙推荐的地方准没错。"
        },
        {
          "role": "于连",
          "text": "既然两位坚持，我再推辞就显得对好朋友失礼了。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我可是提瓦特的最佳向导，带路就交给我吧！你们可不要掉队啦。"
        },
        {
          "type": "subtitle",
          "text": "前往甘露花海"
        },
        {
          "role": "派蒙",
          "text": "听说画家在动笔之前都会从不同角度观察…这应该不是什么「刻板印象」吧？"
        },
        {
          "role": "派蒙",
          "text": "我们一起在附近转转？还可以去视野更好的高处观察一下！"
        },
        {
          "role": "于连",
          "text": "听起来是个不错的主意，我已经准备好出发了。"
        },
        {
          "role": "派蒙",
          "text": "对了，不如我们比比谁先到终点？旅行者，准备好出发了吗？"
        },
        {
          "type": "subtitle",
          "text": "与于连对话"
        },
        {
          "role": "派蒙",
          "text": "充满了大自然的气息…是不是很适合写生和寻找灵感？"
        },
        {
          "role": "旅行者",
          "text": "这是刻板印象啦。"
        },
        {
          "role": "派蒙",
          "text": "唔…可是如果是我就会很想提起画笔呢，这里的景物都有种充满生命力的美，而且色彩也都很绚丽…"
        },
        {
          "role": "旅行者",
          "text": "咳。"
        },
        {
          "role": "派蒙",
          "text": "啊…"
        },
        {
          "role": "派蒙",
          "text": "对不起…我不是…"
        },
        {
          "role": "于连",
          "text": "哈哈，没关系，我只是看到了不同的景色。但是美是共通的，对吧？"
        },
        {
          "role": "派蒙",
          "text": "嗯！我很喜欢这里的景色呢，感觉心灵都被净化了。"
        },
        {
          "role": "旅行者",
          "text": "派蒙的心灵应该不需要净化吧。"
        },
        {
          "role": "于连",
          "text": "两位好朋友，给了我这样一个一开始甚至没有说实话的陌生人这么多的善意…"
        },
        {
          "role": "于连",
          "text": "两位都是有着纯洁心灵的好人。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿…倒也不用这么夸奖啦。对了，其实还有更特别的景色呢！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，你一定知道我在说什么，也让于连见识一下吧！"
        },
        {
          "type": "subtitle",
          "text": "与于连对话"
        },
        {
          "role": "旅行者",
          "text": "我们出发吧！"
        },
        {
          "role": "派蒙",
          "text": "出发咯！"
        },
        {
          "type": "subtitle",
          "text": "前往视野更好的高处"
        },
        {
          "type": "subtitle",
          "text": "与于连对话"
        },
        {
          "role": "于连",
          "text": "呼…想…想不到画画对体力的要求也这么高，早知道我就…"
        },
        {
          "role": "派蒙",
          "text": "看来对于连来说还是太勉强了…"
        },
        {
          "role": "于连",
          "text": "毕…毕竟是刚养好伤…呼…"
        },
        {
          "role": "于连",
          "text": "不过这里的风景的确很独特，真奇怪，为什么之前都没注意到…"
        },
        {
          "role": "派蒙",
          "text": "前边视野应该也不错，我们去那边看看吧，要小心一点哦！"
        },
        {
          "type": "subtitle",
          "text": "离开高处，继续向前"
        },
        {
          "type": "subtitle",
          "text": "向于连展示特别的景色"
        },
        {
          "type": "subtitle",
          "text": "与于连对话"
        },
        {
          "role": "派蒙",
          "text": "怎么样，风景很不错吧？「胡椒」刚才也很高兴呢。"
        },
        {
          "role": "于连",
          "text": "面对这样的景色，语言已经显得多余了。卡特皮拉说得对，铁格子之外还有广阔的世界…"
        },
        {
          "role": "派蒙",
          "text": "铁格子…于连之前说自己在枫丹的住处很小…"
        },
        {
          "role": "旅行者",
          "text": "咳，须弥的自然风物挺多的。"
        },
        {
          "role": "派蒙",
          "text": "…啊，对对！他已经决定要当个堂堂正正的画家了，换个环境也挺好的，那话怎么说的来着…拓宽视野！"
        },
        {
          "role": "派蒙",
          "text": "虽然于连自己说想要放弃…但我觉得没必要那么快就下结论嘛！可以再多考虑考虑…"
        },
        {
          "role": "派蒙",
          "text": "想一想还有很多和眼前的景色一样，或者比这还要壮美的绝景你都还没见识过呢，说不定…说不定看过之后就有灵感了！"
        },
        {
          "role": "派蒙",
          "text": "至于辨别颜色…于连自己也说了，「只是看到了不同的景色」…"
        },
        {
          "role": "旅行者",
          "text": "「但是美是共通的。」"
        },
        {
          "role": "派蒙",
          "text": "对吧？"
        },
        {
          "role": "于连",
          "text": "的确…你们的话很有道理。"
        },
        {
          "role": "派蒙",
          "text": "是你自己的话啦！"
        },
        {
          "role": "于连",
          "text": "我…哈哈，原来这道理我是明白的，只是…只是我总是走上错误的路…"
        },
        {
          "role": "派蒙",
          "text": "「胡椒」带你走了这条路，我们才能认识呢，所以这也不完全是「错误的路」吧？"
        },
        {
          "role": "派蒙",
          "text": "虽然没能帮你找到纯水精灵的朝圣之路挺遗憾的…唔…"
        },
        {
          "role": "旅行者",
          "text": "这种东西真的存在吗…"
        },
        {
          "role": "于连",
          "text": "我到现在也相信朝圣之路的确存在，不过…对我来说，能否找到它的终点已经不再重要了吧。"
        },
        {
          "role": "于连",
          "text": "因为我已经找到我想要的答案了。"
        },
        {
          "role": "于连",
          "text": "谢谢两位好朋友，唉，我该怎么感谢你们呢。"
        },
        {
          "role": "于连",
          "text": "要是之前买下了那枚神奇鸟蛋就好了…能够抵消掉一天的厄运的神奇道具，送给你们这样的冒险家正合适呢。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是啊，真可惜。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "旅行者居然真的相信有这样方便的神奇道具吗？"
                }
              ]
            },
            {
              "text": "多谢，不过还是不用了吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "为什么呀！就算不能抵消厄运…说不定…说不定它是比普通鸟蛋好吃一百倍的鸟蛋呢！"
                }
              ]
            }
          ]
        },
        {
          "role": "于连",
          "text": "我打算在这里多留一下，这里让人心绪宁静，很适合思考。"
        },
        {
          "role": "于连",
          "text": "有种能够画出点什么不一样的东西的预感…"
        },
        {
          "role": "于连",
          "text": "谢谢两位的帮助，也祝好朋友旅途顺利！"
        },
        {
          "role": "旅行者",
          "text": "还需要做一下准备。"
        },
        {
          "role": "派蒙",
          "text": "唔…那准备好之后再出发吧！"
        }
      ]
    }
  ]
}