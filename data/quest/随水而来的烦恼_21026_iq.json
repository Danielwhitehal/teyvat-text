{
  "quest_id": 21026,
  "chapter_num": null,
  "chapter_title": "随水而来的烦恼",
  "type": "iq",
  "route": "Troubles Traveling Through Tributaries",
  "stories": [
    {
      "story_id": 21026,
      "title": "随水而来的烦恼",
      "description": "岳川似乎捡到了小蒙的漂流瓶…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与岳川对话"
        },
        {
          "role": "岳川",
          "text": "这漂流瓶里信的字迹，看着像是个小孩子写的…"
        },
        {
          "role": "岳川",
          "text": "小蒙？这孩子是谁啊…"
        },
        {
          "role": "旅行者",
          "text": "咦？这个漂流瓶是…"
        },
        {
          "role": "岳川",
          "text": "旅行者？听你这口气，你是认识写这封信的人？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "算认识吧…",
              "dialogues": []
            },
            {
              "text": "是璃月港里的一个孩子…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "岳川",
          "text": "原来是这样。这孩子想得倒挺多的。想要变得成熟…"
        },
        {
          "role": "岳川",
          "text": "我想，他只要能去外面旅行一次，开开自己的眼界，这些烦恼说不定就能迎刃而解。"
        },
        {
          "role": "派蒙",
          "text": "这么一说，小蒙自己也说过，想要去璃月港外面看看呢。"
        },
        {
          "role": "派蒙",
          "text": "不过，我们明明也邀请过他，为什么他不直接答应呢？"
        },
        {
          "role": "岳川",
          "text": "哈哈哈，也许这是那位小小男子汉的一点「倔强」吧。"
        },
        {
          "role": "岳川",
          "text": "既然是自己的烦恼，当然是要自己亲手解决，不能一味依靠别人来帮忙。"
        },
        {
          "role": "派蒙",
          "text": "那小蒙光是丢漂流瓶，也不能解决问题啊…"
        },
        {
          "role": "岳川",
          "text": "所以，这个时候就要有一位可靠的成年人来帮帮他了。"
        },
        {
          "role": "岳川",
          "text": "来，旅行者，我们一起给这位小朋友写一封信吧。"
        },
        {
          "role": "岳川",
          "text": "用这封信来告诉他，外面的世界会有什么新奇的事物在等着他。"
        },
        {
          "role": "岳川",
          "text": "不过…嘿嘿，我没去过多少地方，具体要写什么地方的新奇事物，还是由你来决定吧，旅行者。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于被暴风围绕的高塔废墟…",
              "dialogues": []
            },
            {
              "text": "关于被雷暴围绕的海外群岛…",
              "dialogues": []
            },
            {
              "text": "关于被雷神一刀斩开的岛屿…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "岳川",
          "text": "说慢点，说慢点。我还没记完…"
        },
        {
          "role": "岳川",
          "text": "唔，这里…要这么写…"
        },
        {
          "role": "岳川",
          "text": "好！完成了，不知不觉居然写了这么多…"
        },
        {
          "role": "岳川",
          "text": "哈哈哈，听着你说的这些，我都有点想去外面旅行了。"
        },
        {
          "role": "旅行者",
          "text": "出去旅行也不错。"
        },
        {
          "role": "岳川",
          "text": "我都这个年纪了，有太多的事要做，已经没有随意出去旅行的权利啦。"
        },
        {
          "role": "岳川",
          "text": "这封信我已经装在漂流瓶里了，你快去放进河里吧。"
        },
        {
          "type": "subtitle",
          "text": "放出漂流瓶"
        },
        {
          "type": "subtitle",
          "text": "与岳川对话"
        },
        {
          "role": "岳川",
          "text": "怎么样，你把漂流瓶放出去了吗？"
        },
        {
          "role": "旅行者",
          "text": "小蒙真的能捡到吗…"
        },
        {
          "role": "岳川",
          "text": "嗯…应该很难吧。一般来说都是捡不到的。"
        },
        {
          "role": "派蒙",
          "text": "那不就完全没有意义了吗！"
        },
        {
          "role": "岳川",
          "text": "哎呀，别急嘛。我都说了，某位可靠的成年人会帮他的。"
        },
        {
          "role": "岳川",
          "text": "你们知道「须弥」这个地方吗？"
        },
        {
          "role": "岳川",
          "text": "我正好有几个做生意的兄弟。他们正在筹划做点蘑菇生意，最近正准备去那边考察一下呢。"
        },
        {
          "role": "岳川",
          "text": "哈哈哈，你们也知道。说是去须弥「考察」，其实也就是去那边玩一趟。"
        },
        {
          "role": "岳川",
          "text": "既然那位叫小蒙的小朋友有外出旅行的念头，那我也正好帮他联系一下，看我的那些兄弟们能不能多带个人。"
        },
        {
          "role": "岳川",
          "text": "你们就别操心了，这件事我来安排吧。"
        },
        {
          "role": "岳川",
          "text": "这封信我抄了一份，还有别的用途。至于那个漂流瓶…就随它去吧。我估计也不会有人捡到。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "谢谢你愿意帮忙。",
              "dialogues": []
            },
            {
              "text": "你为什么愿意帮小蒙？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "岳川",
          "text": "成年人帮小孩子圆梦，这不是很正常的事吗？这件事就交给我了，你们放心吧。"
        },
        {
          "role": "岳川",
          "text": "对了，我还得让我那几位兄弟穿正式点，别吓着人家…"
        }
      ]
    }
  ]
}