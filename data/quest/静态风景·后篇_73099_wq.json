  "stories": [
    {
      "story_id": 73099,
      "title": "静态风景·后篇",
      "description": "通过「邮箱」的图画找到了更多的宝藏后，很久以前在层岩巨渊拾获的「种子」开始发出震颤…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "哎呀，兰那罗的世界可真奇妙…看看图画就能找到宝藏…"
        },
        {
          "role": "派蒙",
          "text": "这么一来，就找到了所有图画的地点了呢！不知道画这些藏宝图的兰那罗在什么地方呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "并不是所有…",
              "dialogues": []
            },
            {
              "text": "还有一个地方…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对喔，这么说来，还有那副有好几个兰那罗一起的画，我们在那边没有找到宝藏…"
        },
        {
          "role": "派蒙",
          "text": "（行囊中似乎有什么东西发出了轻微的震颤。）"
        },
        {
          "role": "旅行者",
          "text": "（找到震颤的物品。）"
        },
        {
          "role": "派蒙",
          "text": "咦？这是…之前我们在层岩巨渊地下，找到的种子吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像在指引我们去什么地方…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯…说不定真是这样呢！之后如果种子再发出震动的话，我们就留意一下吧！"
                }
              ]
            },
            {
              "text": "真是莫名其妙。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…我觉得可能这个种子是想要去什么地方！之后如果种子再发出震动的话，我们就留意一下吧！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "说不定真的有「受困的兰那罗」呢！或者是什么，「兰那罗宝库」之类的…而种子就是钥匙？"
        },
        {
          "role": "派蒙",
          "text": "哎呀，兰那罗的世界可真奇妙…看看图画就能找到宝藏…"
        },
        {
          "role": "派蒙",
          "text": "这么一来，就找到了所有图画的地点了呢！不知道画这些藏宝图的兰那罗在什么地方呢…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "并不是所有…",
              "dialogues": []
            },
            {
              "text": "还有一个地方…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对喔，这么说来，还有那副有好几个兰那罗一起的画，我们在那边没有找到宝藏…"
        },
        {
          "role": "旅行者",
          "text": "（行囊中似乎有什么东西发出了轻微的震颤。）"
        },
        {
          "role": "旅行者",
          "text": "（找到震颤的物品。）"
        },
        {
          "role": "派蒙",
          "text": "咦？这是…之前我们在层岩巨渊地下，找到的种子吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像在指引我们去什么地方…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "嗯…说不定真是这样呢！之后如果种子再发出震动的话，我们就留意一下吧！"
                }
              ]
            },
            {
              "text": "真是莫名其妙。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "唔…我觉得可能这个种子是想要去什么地方！之后如果种子再发出震动的话，我们就留意一下吧！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "说不定真的有「受困的兰那罗」呢！或者是什么，「兰那罗宝库」之类的…而种子就是钥匙？"
        },
        {
          "type": "subtitle",
          "text": "根据种子的震动与图画的内容，找到最后的地点"
        },
        {
          "type": "subtitle",
          "text": "与兰那罗对话"
        },
        {
          "role": "兰宁巴",
          "text": "谢谢那菈旅行者和派蒙把兰宁巴带回来，桓那兰那的水果然是最好喝的水！不过，兰宁巴已经准备好了，很快就出发。"
        },
        {
          "role": "兰弥那离",
          "text": "咿！是金色的那菈！而且，有风的味道，土的味道，还有兰那罗的味道！"
        },
        {
          "role": "兰弥那离",
          "text": "金色的那菈，也破解了兰雅玛的兰迦拉梨？"
        },
        {
          "role": "兰弥那离",
          "text": "可怕，可怕！阻碍，没了用处，任谁都能闯进来，兰弥那离的「快乐小窝」，要被「踏破」了！"
        },
        {
          "role": "派蒙",
          "text": "哇，你不要着急嘛，我们没有恶意的。"
        },
        {
          "role": "兰弥那离",
          "text": "没有「恶意」是什么意思？是说不「贪婪」吗？"
        },
        {
          "role": "派蒙",
          "text": "唔…算是吧！我和旅行者可是站在兰那罗那边的，我们想当兰那罗的好朋友。"
        },
        {
          "role": "旅行者",
          "text": "派蒙虽然贪吃，但本质不坏。"
        },
        {
          "role": "派蒙",
          "text": "喂！虽然是这样没错啦…"
        },
        {
          "role": "兰弥那离",
          "text": "兰那罗的好朋友…金色的那菈身上，有兰那罗的味道，熟悉的味道，但是很久没有闻到了…"
        },
        {
          "role": "派蒙",
          "text": "啊，对了，那颗怪怪的种子！旅行者，把种子给兰弥那离看看吧，说不定他知道些什么呢。"
        },
        {
          "role": "兰弥那离",
          "text": "唔！好渴！他要喝很多水，才能变回原来的样子…快，这边有很多水，让他喝饱，才能恢复。"
        },
        {
          "role": "？？？",
          "text": "将种子放进了水里…"
        },
        {
          "role": "兰宁巴",
          "text": "…噗！回来了！"
        },
        {
          "role": "派蒙",
          "text": "哇！种子变成兰那罗了！真的找到了，「受困的兰那罗」！你看，我说的没错吧，旅行者？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "居然真的存在「受困的兰那罗」…",
              "dialogues": []
            },
            {
              "text": "你还好吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "兰弥那离",
          "text": "是兰宁巴！和兰弥那离不一样，兰宁巴喜欢四处周游，之前，会把在远方看到的景色画下来，送回桓那兰那，但是后来…"
        },
        {
          "role": "兰宁巴",
          "text": "后来到了很硬、很暗的地方，很少泥土，但是很多石头…泥土之下，很少草，很少树，不过有很多蘑菇！"
        },
        {
          "role": "派蒙",
          "text": "唔…说的应该就是层岩巨渊吧？不过，兰宁巴一个兰那罗居然跑到那么远的地方去啦，甚至离开了须弥…"
        },
        {
          "role": "兰宁巴",
          "text": "嗯！路途很远，而且危险，遇到黑色的那菈，好险！不过，兰宁巴有兰穆护昆达看顾，变成种子，「逃过一劫」。"
        },
        {
          "role": "兰宁巴",
          "text": "现在兰宁巴又安全回来，多亏了金色的那菈，还有白色飞飞。"
        },
        {
          "role": "派蒙",
          "text": "是旅行者和派蒙啦！"
        },
        {
          "role": "兰弥那离",
          "text": "对，那菈旅行者还有派蒙，是兰那罗的好朋友。"
        },
        {
          "role": "兰宁巴",
          "text": "兰弥那离是兰宁巴的「好朋友」，所以，那菈旅行者和派蒙也是兰宁巴的「好朋友」，唔，懂了！"
        },
        {
          "role": "兰宁巴",
          "text": "兰宁巴要出发了，这次，不光是画，兰宁巴会送回「礼物」，给兰弥那离，装进「宝箱」。"
        },
        {
          "role": "兰弥那离",
          "text": "这里的「宝箱」，都是兰弥那离的，兰弥那离是「宝箱」的主人。"
        },
        {
          "role": "兰弥那离",
          "text": "如果真的是兰那罗的好朋友，帮助过很多兰那罗的话…兰那罗「知恩图报」，会把「宝」放进「箱」里。"
        },
        {
          "role": "派蒙",
          "text": "原来箱子原本是空的吗！"
        },
        {
          "role": "兰弥那离",
          "text": "兰那罗诞生之时就知道有关桓那的一切，但「箱」诞生之时，却是肚里空空的！兰弥那离也不懂为什么。"
        },
        {
          "role": "派蒙",
          "text": "派蒙也搞不懂欸…"
        },
        {
          "role": "兰弥那离",
          "text": "…等兰弥那离放好了，那菈旅行者可以打开「宝箱」，然后像绿绿的那菈那样，有时「好呀！」有时「唉…」"
        },
        {
          "role": "派蒙",
          "text": "为什么要多此一举呢？兰弥那离和兰宁巴也可以直接把要放进宝箱里的东西当作报酬交给我们嘛。"
        },
        {
          "role": "兰弥那离",
          "text": "兰弥那离知道，绿绿的那菈，都喜欢进到洞里，或者屋子里，打开「宝箱」。那菈旅行者，还有派蒙，不喜欢？"
        },
        {
          "role": "派蒙",
          "text": "哦…很难说不喜欢呢…感觉有种…莫名的吸引力？"
        },
        {
          "role": "兰弥那离",
          "text": "嗯，那菈喜欢「宝箱」，兰弥那离也喜欢，所以允许帮助过兰那罗的好那菈打开「宝箱」。"
        },
        {
          "role": "兰弥那离",
          "text": "桓那有很多兰那罗，有的需要帮助，有的想和那菈玩耍，实现他们愿望的那菈，才是兰那罗的朋友。"
        },
        {
          "role": "兰弥那离",
          "text": "这样的那菈，可以打开兰弥那离准备好的「宝箱」。"
        },
        {
          "role": "兰宁巴",
          "text": "所以兰宁巴应该现在就出发，为了把「宝箱」填满。"
        },
        {
          "role": "派蒙",
          "text": "欸？可是兰宁巴不是刚回来没多久吗？这么快就要离开了吗？真是风风火火呀…"
        },
        {
          "role": "兰宁巴",
          "text": "咿！有风很好，但不要火，离火太近，兰宁巴就又会很渴很渴了…"
        },
        {
          "role": "派蒙",
          "text": "啊，我的意思是说，兰宁巴怎么走得这么急，明明可以多留一下，和兰弥那离叙叙旧嘛。"
        },
        {
          "role": "派蒙",
          "text": "兰弥那离也是，很久不见兰宁巴，不会有很多话想说吗？"
        },
        {
          "role": "兰弥那离",
          "text": "兰宁巴是停不下来的兰那罗，所以当不了「宝箱」的主人。"
        },
        {
          "role": "兰弥那离",
          "text": "兰宁巴四处周游的消息，只要桓那知道，风知道，花跟草知道，兰弥那离就知道。"
        },
        {
          "role": "兰弥那离",
          "text": "所以，没关系，不需要太多话。兰宁巴想说，兰弥那离就听。"
        },
        {
          "role": "派蒙",
          "text": "唔…这就是兰那罗的友谊吗？如果是我的话，肯定有说不完的话要和旅行者分享呢…"
        }
      ]
    }
  ]
}