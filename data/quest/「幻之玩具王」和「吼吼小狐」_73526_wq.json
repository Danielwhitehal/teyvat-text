{
  "quest_id": 73526,
  "chapter_num": null,
  "chapter_title": "「幻之玩具王」和「吼吼小狐」",
  "type": "wq",
  "route": "The Phantom Toy Master and the Barking Fox",
  "stories": [
    {
      "story_id": 73526,
      "title": "「幻之玩具王」和「吼吼小狐」",
      "description": "在「琉形蜃境」中漫步之时，你和派蒙发现了一位困顿之中的商人，或许有效帮助她以后，你们也能得到少见的回报…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与奇怪的商人对话"
        },
        {
          "role": "派蒙",
          "text": "不好了，旅行者！那边有人倒在地上，看起来很不妙…我们去帮帮她吧！"
        },
        {
          "role": "玛蒂哈",
          "text": "早知道就找人帮忙跑腿了…"
        },
        {
          "role": "玛蒂哈",
          "text": "只不过是第一次测试，居然就要翻山越岭，这是什么人间疾苦！"
        },
        {
          "role": "派蒙",
          "text": "你不要紧吧？说话都有气无力的…"
        },
        {
          "role": "派蒙",
          "text": "旅行者，她看起来完全虚脱了，我们做点东西给她吃吧！"
        },
        {
          "type": "subtitle",
          "text": "在附近的炉灶做好了热气腾腾的炸萝卜丸子和烤肉排，让这位虚脱的陌生人补充了体能…",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "玛蒂哈",
          "text": "哈哈哈哈！我又活过来了！"
        },
        {
          "role": "玛蒂哈",
          "text": "手艺还不错，可惜食材和调料的品质不好，导致食物的口感干巴巴的。"
        },
        {
          "role": "派蒙",
          "text": "这种时候就不要挑三拣四了啦，吃饱肚子不就行了吗！"
        },
        {
          "role": "玛蒂哈",
          "text": "错了错了！越是困苦的时候，越要想象奢侈的生活，这样才能给自己奋斗的动力！"
        },
        {
          "role": "玛蒂哈",
          "text": "越是资金周转不开时，越要想办法高额借款，这样才能大开大合，抓住破局的机会！"
        },
        {
          "role": "玛蒂哈",
          "text": "这就是我，「幻之玩具王·玛蒂哈」给你们的回报——逆转局势的商业秘诀。"
        },
        {
          "role": "派蒙",
          "text": "幻…之玩具王？听起来倒是挺威风的，不过看你狼狈的样子，总感觉有蹊跷…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "玩具还没造好吧？",
              "dialogues": []
            },
            {
              "text": "也许已经破产了？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛蒂哈",
          "text": "你们！你们是怎么看穿的！"
        },
        {
          "role": "派蒙",
          "text": "刚才你都饿得快昏倒了啦，神志不清的时候还在自言自语，说什么测试，找人跑腿…"
        },
        {
          "role": "派蒙",
          "text": "一看就知道，你还没做好你的招牌玩具吧？甚至连饭都顾不上吃了，未免也太惨了嘛！"
        },
        {
          "role": "玛蒂哈",
          "text": "可…可恶，被你这么一说，我好不甘心！我的「吼吼小狐」已经进入生产前的最终阶段了！"
        },
        {
          "role": "玛蒂哈",
          "text": "只要测出了「吼吼小狐」的飞行包线，就能完成蕈兽都能看懂的说明书。再借一大笔钱批量生产，就能盈利了！"
        },
        {
          "role": "派蒙",
          "text": "什么飞行包线？什么说明书？不要对我们讲这么多术语啦！"
        },
        {
          "role": "玛蒂哈",
          "text": "空谈无益，就让你们见识一下吧！"
        },
        {
          "type": "subtitle",
          "text": "玛蒂哈从行囊中取出了一个蓝色的包裹，对它快速充气。\n片刻过后，造型奇妙的玩具便在你们的面前成形了，稳稳地飘浮在半空中。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这就是你说的王牌玩具吗？明明一点都不像狐狸啦！还不如起个…「大耳朵日落果炸弹·青之星星限定版」之类的名字！"
        },
        {
          "role": "派蒙",
          "text": "还有，「吼吼」是怎么回事？它的表情也不像在笑啊？"
        },
        {
          "role": "玛蒂哈",
          "text": "不不不，是因为它的喷气装置工作时的动静听起来像是人在吼吼大笑！不信你们听听看！"
        },
        {
          "role": "玛蒂哈",
          "text": "（发出难以名状的低频啸叫，大概也许勉强可以用「吼吼」来打比方）"
        },
        {
          "role": "派蒙",
          "text": "她到底从哪听到的这种笑声…旅行者，我有点担心她的精神状态…"
        },
        {
          "role": "玛蒂哈",
          "text": "总之，「吼吼小狐」由小型热气球提供升力，隐藏的小喷气口提供推力，有着不错的操作性。"
        },
        {
          "role": "玛蒂哈",
          "text": "想象一下，它可是能灵活飞行的玩具！别说一般的小孩了，就连大人也无法抵抗它的诱惑！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这么一说，确实很新奇。",
              "dialogues": []
            },
            {
              "text": "说不定能卖得很好。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "我闻到了熟悉的味道…"
        },
        {
          "role": "派蒙",
          "text": "让我猜猜看，玛蒂哈的下一句话是——「拜托你们帮我完成最后的测试吧，我会给你们一笔报酬的」。"
        },
        {
          "role": "派蒙",
          "text": "但我和旅行者还得好好商量一下，毕竟我们很忙，只拿一点点报酬可是吃亏的事…"
        },
        {
          "role": "玛蒂哈",
          "text": "不不不，只是一点奖金可不够，让我算算看…"
        },
        {
          "role": "玛蒂哈",
          "text": "「吼吼小狐」一年内总销售额的六成，哦不，七成分红，你们觉得足够吗？"
        },
        {
          "role": "派蒙",
          "text": "七成！这未免也太多…"
        },
        {
          "role": "派蒙",
          "text": "咳咳…这才像话嘛，「幻之玩具王」！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这一年内能量产吗？",
              "dialogues": []
            },
            {
              "text": "量产了也未必能盈利。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "玛蒂哈",
          "text": "这就是关键所在了，两位！你们尽快完成测试，就能让「吼吼小狐」提前投入生产和销售，拿到更多分红！"
        },
        {
          "role": "玛蒂哈",
          "text": "我们一起努力，把产品做到最好，才能达成双赢！"
        },
        {
          "role": "派蒙",
          "text": "也对哦，越想越有道理…"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，旅行者，这样一来，我们也算是进军玩具产业，称得上是商业人士了吧？"
        },
        {
          "role": "玛蒂哈",
          "text": "事不宜迟，我之前请教过不少冒险家，根据他们的经验，布置了几个测试飞行包线的挑战，先给你们大概指示一下方位…"
        },
        {
          "role": "玛蒂哈",
          "text": "「吼吼小狐」的未来，还有「幻之玩具王」的招牌，全都拜托你们了！"
        }
      ]
    }
  ]
}