  "chapter_title": "清籁旧宝",
  "type": "wq",
  "route": "Relics of Seirai",
  "stories": [
    {
      "story_id": 72162,
      "title": "清籁旧宝",
      "description": "在清籁岛上，你解救了一位名叫藤原俊子的人，她似乎正在此处寻找家中的传家宝…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "解救被魔物围困的人"
        },
        {
          "type": "subtitle",
          "text": "与藤原俊子对话"
        },
        {
          "role": "藤原俊子",
          "text": "这机关，到底是怎么解的呢…"
        },
        {
          "role": "藤原俊子",
          "text": "谢、谢谢你们，呼…这些家伙居然趁我不注意偷袭我…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你是谁？",
              "dialogues": []
            },
            {
              "text": "你在这做什么？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "藤原俊子",
          "text": "我叫藤原俊子，正在这里…嗯…"
        },
        {
          "role": "藤原俊子",
          "text": "算了，你们救了我…我就告诉你们吧。"
        },
        {
          "role": "藤原俊子",
          "text": "其实，我正在这里寻找我祖上留下来的宝藏！"
        },
        {
          "role": "派蒙",
          "text": "宝、宝藏！"
        },
        {
          "role": "旅行者",
          "text": "你找到了吗？"
        },
        {
          "role": "藤原俊子",
          "text": "哈哈哈，那是当然，我顺着线索找到了宝藏所在地，也确定了进入的方法。"
        },
        {
          "role": "藤原俊子",
          "text": "但是…在我准备启动开关，进入藏宝地的时候，就被那群魔物偷袭了。"
        },
        {
          "role": "藤原俊子",
          "text": "多亏你们击退了那群魔物，谢谢你们。"
        },
        {
          "role": "藤原俊子",
          "text": "然后…那个，虽然有点不好意思…"
        },
        {
          "role": "藤原俊子",
          "text": "但是，能不能请你们接着保护我一段时间？"
        },
        {
          "role": "藤原俊子",
          "text": "我还得继续寻宝，这周围又有那么多魔物，我一个人肯定没法对付…"
        },
        {
          "role": "藤原俊子",
          "text": "如果你们愿意帮忙的话，我可以把…把宝藏分给你们一些！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真的有宝藏吗？",
              "dialogues": []
            },
            {
              "text": "真的找得到吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "藤原俊子",
          "text": "肯定能找到！你们就相信我吧！"
        },
        {
          "role": "藤原俊子",
          "text": "我连进入藏宝地的开关都找到了，就在那边。"
        },
        {
          "role": "藤原俊子",
          "text": "但那座机关似乎不能直接打开，得用一种特殊的方法才能启动…"
        },
        {
          "role": "藤原俊子",
          "text": "虽然我手上有祖上留下的一张图，里面似乎有解开这座机关的线索…"
        },
        {
          "role": "藤原俊子",
          "text": "但是…哈哈哈…我还是不知道怎么才能打开。"
        },
        {
          "role": "藤原俊子",
          "text": "哦，你们也看看吧，说不定你们能从这张图里看出什么来。"
        },
        {
          "role": "藤原俊子",
          "text": "唉，这个机关到底是怎么解的呢…"
        },
        {
          "type": "subtitle",
          "text": "启动开关"
        },
        {
          "type": "subtitle",
          "text": "查看并启动机关"
        },
        {
          "type": "subtitle",
          "text": "与藤原俊子对话"
        },
        {
          "role": "藤原俊子",
          "text": "突、突然响起了什么声音…"
        },
        {
          "role": "藤原俊子",
          "text": "看那边！那边…怎么突然出现了一个大洞？"
        },
        {
          "role": "藤原俊子",
          "text": "底下…好像是一个地下室，我们进去看看吧！快！"
        },
        {
          "type": "subtitle",
          "text": "进入地下室"
        },
        {
          "role": "藤原俊子",
          "text": "唉，这回真是…"
        },
        {
          "role": "盗宝团",
          "text": "真是大发横财了？"
        },
        {
          "role": "藤原俊子",
          "text": "你、你们…"
        },
        {
          "role": "盗宝团",
          "text": "嘿嘿…少废话，把宝贝交出来！兄弟们跟着你这么久，可不能白跑一趟！"
        },
        {
          "role": "藤原俊子",
          "text": "什么？等一下！我就只找到了一幅画！"
        },
        {
          "role": "盗宝团",
          "text": "一幅画？那也得给我交出来！兄弟们，上！"
        },
        {
          "role": "藤原俊子",
          "text": "救、救命啊！旅行者！"
        },
        {
          "type": "subtitle",
          "text": "与藤原俊子对话"
        },
        {
          "role": "藤原俊子",
          "text": "这座机关…好像和我们进来的时候解开的那座机关是同一类型。"
        },
        {
          "role": "藤原俊子",
          "text": "不过，好像复杂了不少…"
        },
        {
          "role": "藤原俊子",
          "text": "但是没关系！我祖上的那张图上一定有解开这座机关的线索！"
        },
        {
          "type": "subtitle",
          "text": "启动开关"
        },
        {
          "type": "subtitle",
          "text": "启动机关"
        },
        {
          "type": "subtitle",
          "text": "再次启动机关"
        },
        {
          "type": "subtitle",
          "text": "等待藤原俊子开启宝箱"
        },
        {
          "role": "藤原俊子",
          "text": "这帮人怎么这么不讲道理啊！都说了我只找到一幅画了啊！"
        },
        {
          "role": "藤原俊子",
          "text": "我们继续走吧，必须快点回营地去…"
        },
        {
          "type": "subtitle",
          "text": "与藤原俊子对话"
        },
        {
          "role": "藤原俊子",
          "text": "这里面…怎么只有这个…"
        },
        {
          "role": "旅行者",
          "text": "怎么了？"
        },
        {
          "role": "藤原俊子",
          "text": "那个箱子里只装着这一幅画。"
        },
        {
          "role": "藤原俊子",
          "text": "这个就是宝藏吗？真是莫名其妙。"
        },
        {
          "role": "藤原俊子",
          "text": "唉，只找到了这一幅画，也没办法分给你…"
        },
        {
          "role": "藤原俊子",
          "text": "这样吧，你们跟我来，我们先回我的营地去。"
        },
        {
          "role": "藤原俊子",
          "text": "去了那里之后，我再把报酬给你们。"
        },
        {
          "role": "藤原俊子",
          "text": "行了，我们快点出发吧。"
        },
        {
          "role": "藤原俊子",
          "text": "就一幅画，真奇怪…"
        },
        {
          "type": "subtitle",
          "text": "跟上藤原俊子"
        },
        {
          "role": "藤原俊子",
          "text": "为、为什么所有人都不相信我只拿到了这一幅画，呜…"
        },
        {
          "role": "藤原俊子",
          "text": "就算是抢劫…也要好好听人讲话吧！"
        },
        {
          "role": "旅行者",
          "text": "我们还是快走吧…"
        },
        {
          "role": "藤原俊子",
          "text": "呜呜呜…好、好…我们快点回营地吧，我真是受不了了…"
        },
        {
          "type": "subtitle",
          "text": "跟随藤原俊子前往营地"
        },
        {
          "role": "猫咪",
          "text": "喵！"
        },
        {
          "role": "藤原俊子",
          "text": "呜哇！又是谁啊！我真的只拿到了这一幅画而已！"
        },
        {
          "role": "藤原俊子",
          "text": "对不起！对不起！我以后绝对不会再来寻宝了！"
        },
        {
          "role": "旅行者",
          "text": "是猫啦…"
        },
        {
          "role": "藤原俊子",
          "text": "欸？是吗？好吧…"
        },
        {
          "type": "subtitle",
          "text": "跟随藤原俊子前往营地"
        },
        {
          "type": "subtitle",
          "text": "战胜埋伏的盗宝团"
        },
        {
          "type": "subtitle",
          "text": "与藤原俊子对话"
        },
        {
          "role": "藤原俊子",
          "text": "这帮盗宝团到底是什么时候盯上我的…"
        },
        {
          "role": "藤原俊子",
          "text": "谢谢你，旅行者，我们快点回营地吧。"
        },
        {
          "type": "subtitle",
          "text": "跟随藤原俊子前往营地"
        },
        {
          "type": "subtitle",
          "text": "跟随藤原俊子前往营地"
        },
        {
          "role": "藤原俊子",
          "text": "唉，真是没想…"
        },
        {
          "role": "野武士",
          "text": "还请各位，稍微留步。"
        },
        {
          "role": "野武士",
          "text": "能劳烦你们，把刚刚找到的宝物拿出来吗？"
        },
        {
          "role": "藤原俊子",
          "text": "什么…"
        },
        {
          "role": "野武士",
          "text": "刚才你们不是为了保护宝物，连盗宝团都击退了吗？"
        },
        {
          "role": "野武士",
          "text": "想必，肯定是找到了什么贵重的宝物吧。"
        },
        {
          "role": "藤原俊子",
          "text": "都说了只有一幅画啊！"
        },
        {
          "role": "野武士",
          "text": "看来是说不通了…但我们也不能白跟着那群盗宝团这么久，动手！"
        },
        {
          "role": "藤原俊子",
          "text": "你们给我好好听人说话啊！旅行者！救命啊！"
        },
        {
          "type": "subtitle",
          "text": "战胜埋伏的野武士"
        },
        {
          "type": "subtitle",
          "text": "与藤原俊子对话"
        },
        {
          "type": "subtitle",
          "text": "跟随藤原俊子前往营地"
        },
        {
          "type": "subtitle",
          "text": "跟随藤原俊子前往营地"
        },
        {
          "role": "藤原俊子",
          "text": "唉，真是不知道…"
        },
        {
          "role": "愚人众",
          "text": "把那幅画，拿出来吧。"
        },
        {
          "role": "派蒙",
          "text": "愚人众？！他、他们来这里做什么？！"
        },
        {
          "role": "藤原俊子",
          "text": "那就是一幅普通的画而已啦！你们要就给你们好了！给你们啦！"
        },
        {
          "role": "愚人众",
          "text": "还有其余的东西，也一并拿出来！"
        },
        {
          "role": "藤原俊子",
          "text": "其余的？没有其余的东西了！我就只找到这一幅画而已啊！"
        },
        {
          "role": "愚人众",
          "text": "哼，只有一幅画…还能用那么复杂的机关保护着的？"
        },
        {
          "role": "愚人众",
          "text": "要不是发现了那群野武士的踪迹，我们还发现不了那个地下室。"
        },
        {
          "role": "愚人众",
          "text": "等了这么久，总归要有点收获才行…上！"
        },
        {
          "role": "藤原俊子",
          "text": "我…我真是…旅行者！救命啊！"
        },
        {
          "type": "subtitle",
          "text": "战胜埋伏的愚人众"
        },
        {
          "type": "subtitle",
          "text": "与藤原俊子对话"
        },
        {
          "type": "subtitle",
          "text": "跟随藤原俊子前往营地"
        },
        {
          "type": "subtitle",
          "text": "跟随藤原俊子前往营地"
        },
        {
          "type": "subtitle",
          "text": "跟随藤原俊子前往营地"
        },
        {
          "type": "subtitle",
          "text": "与藤原俊子对话"
        },
        {
          "role": "藤原俊子",
          "text": "呼…总算是到了，你们稍等一下，我去准备报酬。"
        },
        {
          "role": "藤原俊子",
          "text": "好了。这些东西请你们收下吧，虽然不多…但也算是我的一点心意。"
        },
        {
          "role": "藤原俊子",
          "text": "这次的寻宝行动真是乱七八糟，而且还就拿到了一幅画。"
        },
        {
          "role": "藤原俊子",
          "text": "唉，为什么我家的祖先，会专门为一张画设计那么多机关呢？"
        },
        {
          "role": "藤原俊子",
          "text": "完全搞不明白…我还是带着这幅画，回去稻妻城里找人问问看吧。"
        },
        {
          "role": "藤原俊子",
          "text": "唔，不如…直接去问问太田太郎先生吧…"
        }
      ]
    }
  ]
}