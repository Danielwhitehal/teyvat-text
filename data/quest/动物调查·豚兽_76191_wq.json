  "stories": [
    {
      "story_id": 76191,
      "title": "动物调查·豚兽",
      "description": "根据「旗舰」的消息，有一伙走私贩在纳塔劫掠了颜色罕见的豚兽…",
      "dialogues": [
        {
          "role": "？？？",
          "text": "蹲守了一段时间…"
        },
        {
          "type": "subtitle",
          "text": "前往指定地点开启调查"
        },
        {
          "type": "subtitle",
          "text": "制止盗宝团"
        },
        {
          "role": "艾霍玛",
          "text": "三番五次提醒你，让你招子放亮点，这压箱底的尖货，可是至冬堡的熟客点名要的。"
        },
        {
          "role": "艾霍玛",
          "text": "得，你倒好，到我手下改吃素了还是怎么？突然就善心大发，给它放生了？"
        },
        {
          "role": "耶洛",
          "text": "大哥，你听我解释，这真怨不得我，是那丘丘人…"
        },
        {
          "role": "艾霍玛",
          "text": "丘丘人？亏你还好意思说呢！咱们盗宝团的招牌都要砸你手里了！"
        },
        {
          "role": "耶洛",
          "text": "打不过啊，大哥，真打不过！它们那一个蓝的一个绿的下手比债务处理人还狠…"
        },
        {
          "role": "莉奈娅",
          "text": "（这两个家伙看起来就是走私贩了…）"
        },
        {
          "role": "艾霍玛",
          "text": "…谁在那儿？！"
        },
        {
          "role": "莉奈娅",
          "text": "哎呀露米！还没到出场的时候呢！"
        },
        {
          "role": "艾霍玛",
          "text": "这是个什么玩意儿…看着挺稀罕。"
        },
        {
          "role": "艾霍玛",
          "text": "喂，小姑娘你总应付得来了吧？我看这货也够尖，就拿它替了吧。"
        },
        {
          "role": "耶洛",
          "text": "是。"
        },
        {
          "role": "莉奈娅",
          "text": "居然还想打露米的主意！盗宝团的名声就是被你们这种人败坏的…"
        },
        {
          "role": "耶洛",
          "text": "呃，盗宝团有什么名声？"
        },
        {
          "role": "艾霍玛",
          "text": "少跟她废话！"
        },
        {
          "type": "subtitle",
          "text": "击败敌人"
        },
        {
          "role": "旅行者",
          "text": "（附近似乎有些值得调查的，如果是对本地生态十分了解的<color=#FFCC33FF>莉奈娅</color>，或许会有所收获…）"
        },
        {
          "type": "subtitle",
          "text": "调查笼子"
        },
        {
          "role": "莉奈娅",
          "text": "落荒而逃了…真没出息啊。"
        },
        {
          "role": "莉奈娅",
          "text": "（走私的豚兽看起来不在这里…和丘丘人有什么关系吗？）"
        },
        {
          "role": "莉奈娅",
          "text": "（在附近找找看有没有线索吧。）"
        },
        {
          "type": "subtitle",
          "text": "寻找豚兽"
        },
        {
          "type": "subtitle",
          "text": "击败敌人"
        },
        {
          "type": "subtitle",
          "text": "调查豚兽"
        },
        {
          "role": "莉奈娅",
          "text": "真的是银色的豚兽，不是染色的也不是看错，太少见了，不可思议…"
        },
        {
          "role": "莉奈娅",
          "text": "之前在纳塔费尽心思也没找到，原来是被走私贩给抓到了。"
        },
        {
          "role": "莉奈娅",
          "text": "不过看起来好像没受伤…嘿嘿，银色的豚兽，真没想到能亲眼见到，让我摸摸看，银色的和普通的有没有区别…"
        },
        {
          "role": "莉奈娅",
          "text": "…好烫！"
        },
        {
          "role": "豚兽",
          "text": "？"
        },
        {
          "role": "莉奈娅",
          "text": "差点忘了，你还在锅里呢！"
        },
        {
          "role": "莉奈娅",
          "text": "难道是已经习惯了纳塔的液态燃素，所以这点温度不算什么吗？"
        },
        {
          "role": "莉奈娅",
          "text": "不管怎么说，你先跟我回去吧！"
        },
        {
          "role": "豚兽",
          "text": "♪～"
        },
        {
          "type": "subtitle",
          "text": "调查豚兽"
        },
