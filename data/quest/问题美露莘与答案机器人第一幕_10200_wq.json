{
  "quest_id": 10200,
  "chapter_num": "",
  "chapter_title": "问题美露莘与答案机器人第一幕",
  "type": "wq",
  "route": "Questioning Melusine and Answering Machine: Act I",
  "stories": [
    {
      "story_id": 74113,
      "title": "流浪汉与小屁孩",
      "description": "蒸汽鸟报社似乎发生了一桩案子…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往蒸汽鸟报社"
        },
        {
          "type": "subtitle",
          "text": "打听发生了什么"
        },
        {
          "role": "托萝莎",
          "text": "你这是什么态度啊？让克编辑！"
        },
        {
          "role": "让克",
          "text": "你又是什么态度啊？托萝莎探员！"
        },
        {
          "role": "托萝莎",
          "text": "我是在帮你解决麻烦啊！"
        },
        {
          "role": "让克",
          "text": "但我也没请你帮我解决麻烦啊！"
        },
        {
          "role": "旅行者",
          "text": "你们在吵什么？"
        },
        {
          "role": "托萝莎",
          "text": "你们来的好，快来帮我评评理！我是逐影庭的探员托萝莎，正在调查蒸汽鸟报社的一件案子。"
        },
        {
          "role": "托萝莎",
          "text": "可这个外行，总在我推理的时候指手画脚，到底谁是查案子的人啊？"
        },
        {
          "role": "派蒙",
          "text": "原来是外行指导内行，那确实不太好…"
        },
        {
          "role": "让克",
          "text": "我只是建议她不要随便下结论，她什么也没有调查就声称我是凶手啊，这不是诬陷吗？"
        },
        {
          "role": "派蒙",
          "text": "居然是诬陷…这种事也该强烈谴责！等下…凶手？发生了凶案？！"
        },
        {
          "role": "托萝莎",
          "text": "嗯…也许有位可怜的报社员工被那个了…真让人伤心！"
        },
        {
          "role": "让克",
          "text": "…怎么就那个了？明明就只是失踪而已。"
        },
        {
          "role": "托萝莎",
          "text": "就算只是失踪，肯定也跟你脱不了关系吧？让克编辑，他一定是被你逼迫出走的！"
        },
        {
          "role": "托萝莎",
          "text": "让我们试想一下！一位正义的年轻人加入了憧憬许久的报社，立志要用笔刃与邪恶的社会斗争。"
        },
        {
          "role": "托萝莎",
          "text": "但最后他却难过地发现，报社的每根笔杆里流出的全都是粉饰黑暗的墨水！"
        },
        {
          "role": "托萝莎",
          "text": "真正的苦痛无人关心，流行的娱乐新闻才是制胜法宝。理想被谎言驱逐，尊严也被上司践踏…哦！真叫人难过！"
        },
        {
          "role": "托萝莎",
          "text": "终于在一个夜里，他从噩梦中惊醒，看着因泪水而不堪重负的枕头，他决心逃离这个让人梦碎的地方…"
        },
        {
          "role": "让克",
          "text": "…你怎么像只乌鸦一样，这也太夸张了吧？"
        },
        {
          "role": "托萝莎",
          "text": "让克编辑！这就是他失踪的真相吧？你就是他的上司吧？你还说跟你没关系！"
        },
        {
          "role": "让克",
          "text": "托萝莎探员，要我说，您的想象力真是远胜群星，不如立刻脱下警备服，成为本社幻想文学栏目的撰稿人吧。"
        },
        {
          "role": "托萝莎",
          "text": "什么？幻想文学？难道我的推理不够现实吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "…挺现实的…",
              "dialogues": []
            },
            {
              "text": "…挺幻想的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "让克",
          "text": "托萝莎探员，请你搞清楚，失踪的员工可是亚瑟先生，你不知道吗？"
        },
        {
          "role": "派蒙",
          "text": "亚瑟先生？这个名字好像有点耳熟。"
        },
        {
          "role": "让克",
          "text": "亚瑟先生就是那只蒸汽鸟，它是本社的标志，也是「蒸汽鸟报社」名头的由来。"
        },
        {
          "role": "派蒙",
          "text": "啊！是那个每天都在报社门口播报新闻的亚瑟先生！"
        },
        {
          "role": "让克",
          "text": "是啊，那家伙既不会走也不会飞，怎么可能被逼离开啊？"
        },
        {
          "role": "托萝莎",
          "text": "可恶…这么重要的信息怎么不早说？你故意跟本探员过不去吧？"
        },
        {
          "role": "让克",
          "text": "明明你一上来就在说我是凶手，到底谁跟谁过不去啊？"
        },
        {
          "role": "派蒙",
          "text": "哎呀，别再吵啦，当务之急是赶紧找到亚瑟先生吧…"
        },
        {
          "role": "欧芙",
          "text": "没错，派蒙说的对。"
        },
        {
          "role": "让克",
          "text": "啊，欧芙主编，曲线探员，你们回来了。"
        },
        {
          "role": "欧芙",
          "text": "让克，辛苦了，你先去忙吧。"
        },
        {
          "role": "派蒙",
          "text": "欧芙主编你好呀！你身边这位是…"
        },
        {
          "role": "欧芙",
          "text": "你们好，旅行者，派蒙，至于这位…"
        },
        {
          "role": "「曲线」",
          "text": "诸位好，鄙人曲线，是托萝莎探员的探案助手。"
        },
        {
          "role": "派蒙",
          "text": "你…你也会说话？！像亚瑟先生那样的吗？！"
        },
        {
          "role": "欧芙",
          "text": "不，曲线探员是逐影庭的特类探案机器人，它的背后有人在远程操纵。是这样吧？托萝莎探员。"
        },
        {
          "role": "托萝莎",
          "text": "啊？啊！对对对！就是这样…"
        },
        {
          "role": "旅行者",
          "text": "枫丹的技术已经到了这种程度？"
        },
        {
          "role": "欧芙",
          "text": "呵呵，如果不是时机不对，我很乐意分享一些前沿的科技新闻。而眼下，我更想要委托二位，协助本社找回亚瑟先生。"
        },
        {
          "role": "派蒙",
          "text": "欸？委托我们吗？可是这里已经有了两位探员…"
        },
        {
          "role": "托萝莎",
          "text": "就是！这个案子我们已经先接手了！"
        },
        {
          "role": "欧芙",
          "text": "呵呵，托萝莎探员，其实你们两位并不算逐影庭的正式探员吧？"
        },
        {
          "role": "托萝莎",
          "text": "不…不要乱说…我这身制服可是正版！"
        },
        {
          "role": "欧芙",
          "text": "但据我所知，你们只是意外路过，顺便才用探员的名义介入本案的吧？虽然不清楚为何，但如果我就此事询问逐影庭…"
        },
        {
          "role": "托萝莎",
          "text": "不行不行！别去问庭里…哎呀，我承认就是了…"
        },
        {
          "role": "派蒙",
          "text": "什么？！你们两个真是冒牌货？"
        },
        {
          "role": "欧芙",
          "text": "他们只是身份比较特殊而已。还要多谢这位曲线探员，刚刚我们走访居民时，他告知了我一些趣事。"
        },
        {
          "role": "托萝莎",
          "text": "曲线！你都说了什么呀？"
        },
        {
          "role": "「曲线」",
          "text": "托萝莎探员，如您所知，由于「莫索协议」，鄙人只能如实回答欧芙主编的询问。"
        },
        {
          "role": "派蒙",
          "text": "「莫索协议」？那是什么有问必答协议吗？"
        },
        {
          "role": "托萝莎",
          "text": "真可恶…"
        },
        {
          "role": "欧芙",
          "text": "两位探员，无意冒犯，只是亚瑟先生对本社意义重大，我需要更多专业人士的协助，比如旅行者阁下和派蒙小姐。"
        },
        {
          "role": "派蒙",
          "text": "所以欧芙主编希望我们一起调查吗？"
        },
        {
          "role": "欧芙",
          "text": "正是如此，至于酬劳，以蒸汽鸟报社之名，请尽管放心。不知你们意下如何？"
        },
        {
          "role": "旅行者",
          "text": "没问题。"
        },
        {
          "role": "欧芙",
          "text": "太好了。希望几位能精诚合作，本社将不胜感激。"
        },
        {
          "role": "托萝莎",
          "text": "好吧，只要不上报庭里我们偷偷溜出来，怎样都可以…"
        },
        {
          "role": "旅行者",
          "text": "你们偷偷溜出来的？"
        },
        {
          "role": "托萝莎",
          "text": "不要一上来就打听女孩子的私生活啦！那种事熟了以后才可以…"
        },
        {
          "role": "托萝莎",
          "text": "对了，曲线，既然要一起行动，就把我们的笔记分享出来吧…"
        },
        {
          "role": "「曲线」",
          "text": "两位，请收下笔记，其中记录了附近居民的口供。"
        },
        {
          "role": "派蒙",
          "text": "哇！已经有情报了吗？"
        },
        {
          "role": "托萝莎",
          "text": "哼，我们厉害着呢。"
        },
        {
          "role": "托萝莎",
          "text": "好了，接着就再调查一下案发现场吧。亚瑟先生的失踪是在昨晚，这里一定留下了什么线索！"
        },
        {
          "type": "subtitle",
          "text": "居民的证言"
        },
        {
          "type": "subtitle",
          "text": "在现场搜查线索"
        },
        {
          "type": "subtitle",
          "text": "底座上的刻痕"
        },
        {
          "role": "底座上的刻痕",
          "text": "（空空如也的底座。仔细看，有一道锐器留下的刻痕。）"
        },
        {
          "role": "派蒙",
          "text": "这是什么？"
        },
        {
          "role": "「曲线」",
          "text": "从形态和深度观测，痕迹是由匕首类小型利器造成的。"
        },
        {
          "role": "派蒙",
          "text": "那匕首怎么没有了···"
        },
        {
          "role": "托萝莎",
          "text": "先把它记录进探案笔记吧！"
        },
        {
          "type": "subtitle",
          "text": "底座上的刻痕  一道锐器留下的刻痕，似乎曾经插入过一把短刀或匕首。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "凌乱的脚印"
        },
        {
          "role": "凌乱的脚印",
          "text": "（ 互相交叠，深浅、纹路不一的脚印。）"
        },
        {
          "role": "派蒙",
          "text": "呜哇！有这么多脚印，看来有不少人来过呢···"
        },
        {
          "role": "「曲线」",
          "text": "从纹路分析，这些脚印或许属于四位不同的主人。"
        },
        {
          "role": "「曲线」",
          "text": "报社今早已经封锁了消息，隔绝了无关人士。可以认为这些脚印都是案发时留下的。"
        },
        {
          "role": "托萝莎",
          "text": "先把它记录进探案笔记吧！"
        },
        {
          "type": "subtitle",
          "text": "凌乱的脚印  互相交叠，深浅、纹路不一的脚印。应当属于四个不同的主人。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "脏兮兮的空酒瓶"
        },
        {
          "role": "派蒙",
          "text": "唔···这个瓶子臭臭的，还有点鱼腥味···"
        },
        {
          "role": "「曲线」",
          "text": "检索到信息：这件物品与一条居民证言存在相关性。"
        },
        {
          "role": "托萝莎",
          "text": "先把它记录进探案笔记吧！"
        },
        {
          "type": "subtitle",
          "text": "脏兮兮的空酒瓶，散发着微妙的气味，像是装着咸鱼的大海。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "朴素的纽扣"
        },
        {
          "role": "朴素的纽扣",
          "text": "（一枚常见款纽扣，扣眼上留有丝线被扯断的痕迹。）"
        },
        {
          "role": "派蒙",
          "text": "咦？一颗扣子？看起来倒是没什么特别的···除了它出现的位置以外。"
        },
        {
          "role": "托萝莎",
          "text": "先把它记录进探案笔记吧！"
        },
        {
          "type": "subtitle",
          "text": "朴素的纽扣  一枚常见款纽扣，扣眼上留有丝线被扯断的痕迹。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "被拆封的信封"
        },
        {
          "role": "被拆封的信封",
          "text": "（一个信封，但已经被人打开过，作者的殷切期望也已随风而去了。）"
        },
        {
          "role": "派蒙",
          "text": "搞不懂···这个被打开的信封是怎么回事···"
        },
        {
          "role": "托萝莎",
          "text": "先把它记录进探案笔记吧！"
        },
        {
          "type": "subtitle",
          "text": "被拆封的信封  没有什么特殊信息的信封，如果一定要有，那就是里面的信已经不见了。",
          "narration": true,
          "color": "描述"
        },
        {
          "type": "subtitle",
          "text": "梳理当前的线索"
        },
        {
          "role": "托萝莎",
          "text": "已经全部搜查一遍了吧？没有漏掉的线索了吧？"
        },
        {
          "role": "派蒙",
          "text": "一下就多了好多证据啊，又是脚印，又是酒瓶···哎呀，我的脑袋快要冒烟了！"
        },
        {
          "role": "派蒙",
          "text": "旅行者，快想一想，这些东西里是不是藏着什么线索，最好能直接告诉我接下来要怎么办！"
        },
        {
          "type": "subtitle",
          "text": "你选择了「凌乱的脚印」和关于罗谢的证言。推理成立。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这下总算清楚了一些，虽然搜到的东西不少，但是好像都没什么用···最有用的应该就是这个叫做罗谢的流浪汉了。"
        },
        {
          "role": "托萝莎",
          "text": "我也这样想！这四个脚印里，一定有一个是他的吧？而且他就是最可疑的那个！"
        },
        {
          "role": "派蒙",
          "text": "为什么啊？"
        },
        {
          "role": "托萝莎",
          "text": "哪有流浪汉不好好流浪，天天在一个地方溜达的？他一定图谋不轨！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好像也有点道理。",
              "dialogues": []
            },
            {
              "text": "好像也不是很有道理。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "托萝莎",
          "text": "听我的，准没错！走，我们去码头找找看，有人说在那里见过他。"
        },
        {
          "type": "subtitle",
          "text": "前往码头"
        },
        {
          "type": "subtitle",
          "text": "与红发的不明人士交谈"
        },
        {
          "role": "「勇猛落落莓」",
          "text": "兄弟们！罗谢老狗一定就躲在这！欠债还钱，天经地义！给老子把他揪出来！"
        },
        {
          "role": "「勇猛落落莓」",
          "text": "欠钱不还就算了，还想让老子跑几趟啊？老子要把他的狗腿和狗窝一起都拆了！"
        },
        {
          "role": "自由的小狗",
          "text": "汪！汪！"
        },
        {
          "role": "「勇猛落落莓」",
          "text": "你又在狗叫什么？"
        },
        {
          "role": "自由的小狗",
          "text": "呜···"
        },
        {
          "role": "托萝莎",
          "text": "住手！你们在干什么！"
        },
        {
          "role": "「勇猛落落莓」",
          "text": "哪来的乱七八糟的家伙？少来碍老子的事！"
        },
        {
          "role": "「勇猛落落莓」的同伙",
          "text": "四十二当家···看那小东西的制服，好像是逐影庭的啊，要不咱们先撤吧？"
        },
        {
          "role": "「勇猛落落莓」",
          "text": "什么这个庭那个庭的，给老子拿出点男子气啊！跟老子上！"
        },
        {
          "type": "subtitle",
          "text": "击退红发的不明人士"
        },
        {
          "role": "「勇猛落落莓」的同伙",
          "text": "四十二当家，那个金毛和机器人太扎手了…"
        },
        {
          "role": "「勇猛落落莓」",
          "text": "都怪这泥巴太软，害老子脚直打滑…就算罗谢老狗走运，兄弟们，先撤！"
        },
        {
          "role": "托萝莎",
          "text": "原来旅行者很能打嘛！"
        },
        {
          "role": "派蒙",
          "text": "这对旅行者来说都是小意思啦！"
        },
        {
          "role": "自由的小狗",
          "text": "汪！汪！"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，小狗，不用谢！我们是来找你的主人的，他欠了别人钱吧？"
        },
        {
          "role": "托萝莎",
          "text": "喂！小狗，一定是你主人把亚瑟先生偷走抵债了吧？快说！他藏哪去了？"
        },
        {
          "role": "「曲线」",
          "text": "依鄙人分析，我等与犬类的语言并不兼容。"
        },
        {
          "role": "自由的小狗",
          "text": "（小狗望着你们，好像在说「就是这样！」）"
        },
        {
          "role": "托萝莎",
          "text": "那…那我们先搜查一下附近好了，那个小偷肯定就住在这里。"
        },
        {
          "type": "subtitle",
          "text": "搜索流浪汉罗谢的痕迹"
        },
        {
          "type": "subtitle",
          "text": "隐藏会话：破烂的衣服"
        },
        {
          "role": "破烂的衣服",
          "text": "（不知道从哪捡来的破旧衣物…散发微妙的气味…）"
        },
        {
          "role": "托萝莎",
          "text": "这些衣服怎么像是女孩穿的…"
        },
        {
          "type": "subtitle",
          "text": "隐藏会话：旧照片"
        },
        {
          "role": "旧照片",
          "text": "（一张男人和女人的甜蜜合影。）"
        },
        {
          "role": "派蒙",
          "text": "这里面是…罗谢和他的妻子吗？"
        },
        {
          "role": "「曲线」",
          "text": "检索到信息：画片里的这位夫人…"
        },
        {
          "type": "subtitle",
          "text": "与躲在箱子里的人交谈"
        },
        {
          "type": "subtitle",
          "text": "你击破了海边的木箱。从箱子里走出了一个人。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "呜哇！箱子里居然躲了个人！"
        },
        {
          "role": "？？？",
          "text": "别…别打我！"
        },
        {
          "role": "托萝莎",
          "text": "就你叫罗谢啊？"
        },
        {
          "role": "？？？",
          "text": "我没钱！我真没钱！"
        },
        {
          "role": "托萝莎",
          "text": "你别怕，我们帮你把讨债的赶走了。"
        },
        {
          "role": "罗谢",
          "text": "哦！太好了！原来是一位这么迷人的美露莘小姐…没错，我就是罗谢…等我飞黄腾达，一定不忘记重金酬谢！"
        },
        {
          "role": "托萝莎",
          "text": "好你个小偷罗谢！我们是逐影庭的探员！我们是来抓你的！"
        },
        {
          "role": "托萝莎",
          "text": "就是你昨晚偷走了亚瑟先生吧？老实交代！把它卖去哪了？"
        },
        {
          "role": "罗谢",
          "text": "…偷走亚瑟先生？水神大人在上！像我这样的人，怎么会干那种事。从昨晚起，我可就一直躲在这箱子里！"
        },
        {
          "role": "托萝莎",
          "text": "哦？真的吗？曲线，你怎么看？"
        },
        {
          "role": "「曲线」",
          "text": "检测到生理数据异常：罗谢先生，您在说谎。"
        },
        {
          "role": "罗谢",
          "text": "说…说谎？胡言乱语！信口雌黄！瞎说八道！有证据吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于报社门口的酒瓶…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "大叔，报社门口的酒瓶和你这的一模一样，就是你留下的吧？"
        },
        {
          "role": "罗谢",
          "text": "就算酒瓶一样，也不能证明是我留下的啊！枫丹那么大，酒鬼当然是满地乱爬…"
        },
        {
          "role": "「曲线」",
          "text": "重复确认，生理数据异常：罗谢先生，您在说谎。"
        },
        {
          "role": "罗谢",
          "text": "喂喂！这大铁棍子是怎么回事啊？仗着自己不是人，就可以随便羞辱我的诚信，我的高洁了吗？"
        },
        {
          "role": "托萝莎",
          "text": "少嚷嚷了！你这小偷，我们现在就把你的老窝翻个底朝天，等我们找到证据，你可别掉眼泪。"
        },
        {
          "role": "罗谢",
          "text": "找就是了，找就是了！没有强而有力的证据，你们就是在羞辱我的人格。"
        },
        {
          "type": "subtitle",
          "text": "想办法突破罗谢的狡辩"
        },
        {
          "type": "subtitle",
          "text": "前去与自由的小狗对话。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "自由的小狗",
          "text": "（小狗望着你们，好像在期待什么。）"
        },
        {
          "type": "subtitle",
          "text": "选择“脏兮兮的空酒瓶”。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "自由的小狗",
          "text": "汪！汪！"
        },
        {
          "role": "派蒙",
          "text": "咦？它怎么走起来了？"
        },
        {
          "role": "托萝莎",
          "text": "我知道了，小狗认出了熟悉的气味！报社门口的酒瓶上有罗谢大叔的气味！"
        },
        {
          "role": "自由的小狗",
          "text": "汪！汪！"
        },
        {
          "role": "罗谢",
          "text": "郎勃罗梭，你不要这时候凑过来啊…"
        },
        {
          "role": "托萝莎",
          "text": "罗谢小偷！你看！你的狗都承认了你的气味，还说你没去过报社！"
        },
        {
          "role": "罗谢",
          "text": "别…别这么凶…郎勃罗梭，你把我暴露了呀！"
        },
        {
          "role": "郎勃罗梭",
          "text": "（郎勃罗梭兴奋地摇着尾巴，好像在说「我不懂耶。」）"
        },
        {
          "role": "罗谢",
          "text": "唉…好吧，我承认…"
        },
        {
          "role": "派蒙",
          "text": "哇，曲线…真的被你说中了，你怎么知道的？难道你会测谎吗？"
        },
        {
          "role": "「曲线」",
          "text": "派蒙小姐，您的判断正确。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真的假的？你是测谎机？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "托萝莎",
          "text": "哎呀！不是说了，不要随便打听别人的私生活吗？那种事要熟了才可以！"
        },
        {
          "role": "托萝莎",
          "text": "小偷罗谢…你赶快交代，你做了什么！？"
        },
        {
          "role": "罗谢",
          "text": "可…可这也是我的私生活吧…"
        },
        {
          "role": "托萝莎",
          "text": "大胆！再不交代，就送你去梅洛彼得堡找私生活。"
        },
        {
          "role": "罗谢",
          "text": "别！别！唉…我说，我承认我是说了一些小慌，可我真没偷走亚瑟先生！"
        },
        {
          "role": "罗谢",
          "text": "我昨晚只是在报社门口睡了一觉而已…我睡着时亚瑟先生还好好的，醒来它就不见了！我怕被人怀疑，就感觉跑了回来…"
        },
        {
          "role": "托萝莎",
          "text": "没这么简单吧？有人说最近总在报社附近看见你，你肯定早就图谋不轨！"
        },
        {
          "role": "罗谢",
          "text": "不是那样的！我那只是在寻找工作机会！就像那种，细心地捡起垃圾，然后被大人物相中，最后飞黄腾达的故事…"
        },
        {
          "role": "派蒙",
          "text": "可你不是制造垃圾的那个吗？你的酒瓶可臭了。大人物肯定相不中你的。"
        },
        {
          "role": "托萝莎",
          "text": "我才不信，这家伙肯定又在骗人了！"
        },
        {
          "role": "罗谢",
          "text": "真是这样的，请听我说完…别看我现在这样子，我以前其实也是在沫芒宫工作的…"
        },
        {
          "role": "罗谢",
          "text": "只不过那是我妻子的安排，嗯…她家以前是大户，还留有些余荫…总之，我体面过…"
        },
        {
          "role": "托萝莎",
          "text": "什么嘛，软饭大叔跟流浪大叔，很难说哪个更体面吧。"
        },
        {
          "role": "罗谢",
          "text": "别…别说那两个字！唉…我何尝不想自己亲手成就非凡人生呢？但问题就出在了这…"
        },
        {
          "role": "罗谢",
          "text": "前段时间有伙人找上我，说可以合伙做生意，还不用担心启动资金，货款可以先赊账…我们一拍即合！"
        },
        {
          "role": "罗谢",
          "text": "可没多久我就发现，从他们那进的货都是垃圾，完全卖不出去…后来账期一到，他们立马就来讨债了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "就是刚刚那帮人？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "罗谢",
          "text": "嗯…我被逼得没办法，就在家里找了些东西抵出去，结果没注意有一件是我妻子的嫁妆，还是她爷爷的遗物…"
        },
        {
          "role": "罗谢",
          "text": "被发现后，我没敢说实话，就骗她说是赌钱输了…我妻子非常生气，一下就把我扫地出门了。"
        },
        {
          "role": "派蒙",
          "text": "啊？为什么不说实话呢？要是老实交代，说不定她还能原谅你…"
        },
        {
          "role": "托萝莎",
          "text": "哼，这家伙才不会老实交代呢。要说是赌钱输光，还能怪运气不好。可要是说做生意亏光，那就坐实废物大叔的身份了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可这些和报社有什么关系？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "罗谢",
          "text": "因为一个月前，蒸汽鸟报曝光了一个叫「优雅餐具商会」的诈骗团伙…就是找上我的那帮人，原来他们是专业骗子！"
        },
        {
          "role": "派蒙",
          "text": "没想到…报社还挺厉害的！"
        },
        {
          "role": "罗谢",
          "text": "我也这么认为，所以我就想去那找份工作，一方面比较体面…一方面也能赚点钱，把我妻子的东西赎回来…"
        },
        {
          "role": "托萝莎",
          "text": "哼，曲线，你觉得呢？"
        },
        {
          "role": "「曲线」",
          "text": "检测到生理数据恢复至正常区间：罗谢先生没有说谎。"
        },
        {
          "role": "托萝莎",
          "text": "啊？真不是这家伙啊…大叔，那你昨晚还有看见别的什么可疑的吗？"
        },
        {
          "role": "罗谢",
          "text": "有！昨晚我是被一阵动静弄醒的，醒来后，我好像看见了一个小小的人影，飞快跑掉了…你们说，是不是很可疑？"
        },
        {
          "role": "派蒙",
          "text": "小小的人影？居民的口供好像提到了一个小朋友，会不会是他？"
        },
        {
          "role": "派蒙",
          "text": "不过也不知道要去哪里找，要是能像刚才一样，再有一只小狗带路就好了。"
        },
        {
          "role": "郎勃罗梭",
          "text": "（郎勃罗梭好像听见了有人在说自己，高兴地摇着尾巴。）"
        },
        {
          "role": "托萝莎",
          "text": "说起来…这家伙的鼻子倒是很灵，我们把东西也给它闻一闻怎么样？"
        },
        {
          "role": "派蒙",
          "text": "虽然不知道有没有用，但感觉可以试一试！"
        },
        {
          "type": "subtitle",
          "text": "让小狗闻一闻线索"
        },
        {
          "type": "subtitle",
          "text": "前去与郎勃罗梭对话。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "郎勃罗梭",
          "text": "（小狗望着你们，好像在期待着什么。）"
        },
        {
          "type": "subtitle",
          "text": "选择「朴素的纽扣」。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "郎勃罗梭",
          "text": "汪！汪！"
        },
        {
          "role": "托萝莎",
          "text": "它要去哪？我们快跟上它！"
        },
        {
          "type": "subtitle",
          "text": "跟随小狗…"
        },
        {
          "type": "subtitle",
          "text": "一段时间后，你们跟着郎勃罗梭来到了一个地方…",
          "narration": true
        },
        {
          "role": "派蒙",
          "text": "小狗停下了，难道扣子的主人在附近吗？"
        },
        {
          "role": "托萝莎",
          "text": "快看那座房子，那里有人！我们过去问问！"
        },
        {
          "role": "郎勃罗梭",
          "text": "汪！汪！"
        },
        {
          "type": "subtitle",
          "text": "前往前方的小屋"
        },
        {
          "role": "凯万",
          "text": "骗子！妈妈也是！那个人也是！"
        },
        {
          "role": "马德莱娜",
          "text": "不是那样的，凯万…"
        },
        {
          "role": "凯万",
          "text": "我什么都知道！我讨厌你们！"
        },
        {
          "role": "马德莱娜",
          "text": "别跑，凯万！唉…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "打扰一下。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马德莱娜",
          "text": "你们…你们要干什么？"
        },
        {
          "role": "托萝莎",
          "text": "夫人，别紧张，我们是逐影庭的探员，在一桩失窃案的现场发现了一枚纽扣，调查显示与你们家有关。有什么想说的吗？"
        },
        {
          "role": "马德莱娜",
          "text": "这是我给凯万新缝的扣子…凯万是个乖孩子，怎么会跟失窃案有关？"
        },
        {
          "role": "托萝莎",
          "text": "果然！夫人，你家小孩就是小偷吧！"
        },
        {
          "role": "马德莱娜",
          "text": "探员大人，请您慎言！就算是凯万的扣子，也只能说明那孩子去过报社而已…"
        },
        {
          "role": "托萝莎",
          "text": "不是他偷的，他为什么要去？"
        },
        {
          "role": "派蒙",
          "text": "呃…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "夫人刚才说了「报社」两个字吧？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦！要是夫人不知情，怎么可能知道案发现场在报社呢？"
        },
        {
          "role": "马德莱娜",
          "text": "这…不…一定是你们听错了…"
        },
        {
          "role": "托萝莎",
          "text": "铁证如山！你再狡辩就是罪加一等，给你家小孩也罪加一等！"
        },
        {
          "role": "马德莱娜",
          "text": "不！我孩子真的没有偷东西！那把刀只是他捡来防身的！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刀？丢的不是亚瑟先生吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马德莱娜",
          "text": "亚瑟先生？可那孩子只拿了一把刀回来…"
        },
        {
          "role": "托萝莎",
          "text": "马德莱娜夫人！你家小孩为什么去报社？去报社干嘛了？把你知道的都告诉我们！"
        },
        {
          "role": "马德莱娜",
          "text": "唉…凯万那孩子，只是很喜欢报社那只蒸汽鸟而已。我们每次进城，他都会专门跑去和它诉苦。"
        },
        {
          "role": "马德莱娜",
          "text": "昨晚我和凯万有些争执，他就跑出了家门…又去了报社…"
        },
        {
          "role": "马德莱娜",
          "text": "但这次他却拿回来了一把刀…他说是插在亚瑟先生的底座上的…"
        },
        {
          "role": "派蒙",
          "text": "原来底座上的刻痕是这么回事啊，凯万为什么要把刀拿下来？"
        },
        {
          "role": "马德莱娜",
          "text": "他说亚瑟先生不见了，想找一找，结果发现了一个醉醺醺的大叔朝他靠近，他很害怕，就把刀拿下来防身。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "刀可以给我们看看吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "马德莱娜",
          "text": "…我让凯万把刀丢掉了…我担心引来不必要的麻烦…"
        },
        {
          "role": "托萝莎",
          "text": "那把刀上说不定有什么线索，我们得问问凯万把刀丢哪了。"
        },
        {
          "role": "马德莱娜",
          "text": "真抱歉，那孩子刚才又跑出去了，因为他爸爸的事，我们总是争吵…他爸爸是外派机械工程师，很长时间都不在家…"
        },
        {
          "role": "马德莱娜",
          "text": "凯万的叛逆期来的有点早，一点都不体谅他爸爸…"
        },
        {
          "role": "托萝莎",
          "text": "原来是个问题小孩啊，这种家伙最麻烦了。算了，为了找到刀，我们还是得先去见见他…"
        },
        {
          "type": "subtitle",
          "text": "去问凯万询问刀的事"
        },
        {
          "type": "subtitle",
          "text": "隐藏会话"
        },
        {
          "role": "马德莱娜",
          "text": "凯万绝对不会是小偷。"
        },
        {
          "type": "subtitle",
          "text": "击退凯万附近的魔物"
        },
        {
          "role": "凯万",
          "text": "来啊！该死的魔物，我才不怕你们！有本事就把我吃掉啊！"
        },
        {
          "role": "派蒙",
          "text": "糟了！凯万被魔物抓住了！"
        },
        {
          "role": "托萝莎",
          "text": "不挺好吗？吃掉问题小孩的魔物也会变得有问题。这样两边都解决了，一举两得！"
        },
        {
          "role": "派蒙",
          "text": "喂喂！我们只要解决问题就好了吧？谁要解决小孩啊？"
        },
        {
          "type": "subtitle",
          "text": "与凯万交谈"
        },
        {
          "role": "凯万",
          "text": "你们是谁啊？叮呤哐啷的吵死了。"
        },
        {
          "role": "派蒙",
          "text": "你…你都不说声谢谢吗?亏我们还救了你。"
        },
        {
          "role": "凯万",
          "text": "谢谢？哈哈哈哈哈！怎样？你们那是什么表情啊？要打我吗？"
        },
        {
          "role": "托萝莎",
          "text": "小鬼，你真的很欠打啊。但我们是逐影庭的专业探员，我们一般不在大庭广众之下打人。"
        },
        {
          "role": "托萝莎",
          "text": "我们现在要问你几个问题，不好好交代就把你抓走！那样可就不是大庭广众了。"
        },
        {
          "role": "凯万",
          "text": "抓走？赶紧来抓吧，最好把那个人也一起抓走！"
        },
        {
          "role": "派蒙",
          "text": "呃…那个人？"
        },
        {
          "role": "凯万",
          "text": "博兰德！那个人叫这个名字，赶紧把他抓起来！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这是你爸爸？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯万",
          "text": "谁要他当爸爸？我都快一年没见到他了！"
        },
        {
          "role": "派蒙",
          "text": "唔…难怪马德莱娜夫人说他会经常和亚瑟先生诉苦…估计这就是问题的根源了吧？"
        },
        {
          "role": "凯万",
          "text": "诉苦？真好笑，我是在研究设置语音的方法！你们不知道吧，亚瑟先生说的话，可都是提前设置好的语音。"
        },
        {
          "role": "凯万",
          "text": "等我破解了设置方法，我就要让亚瑟先生天天在报社门口播放：「博兰德是个大混蛋！」"
        },
        {
          "role": "派蒙",
          "text": "这…这就是你靠近亚瑟先生的目的？不愧是问题小孩啊…"
        },
        {
          "role": "凯万",
          "text": "可我还没研究明白，亚瑟先生就没了，就在昨晚，我也不知道是谁带走了。"
        },
        {
          "role": "凯万",
          "text": "你们不会就是来找亚瑟先生的吧？我要说明，我承认我有问题，但那只鸟的问题和我没关系。"
        },
        {
          "role": "「曲线」",
          "text": "依鄙人分析，凯万先生，您与一把刀有关系。"
        },
        {
          "role": "凯方",
          "text": "这…这机器人会说话？怎么说话的？和亚瑟先生一样吗？"
        },
        {
          "role": "托萝莎",
          "text": "没见识，曲线比亚瑟先生强多了，他可不用提前设置什么语音。"
        },
        {
          "role": "凯万",
          "text": "那…这位曲线大哥…你这么厉害，你能不能代替亚瑟先生说一句：「博兰德是个大混蛋」？你一定可以吧！"
        },
        {
          "role": "「曲线」",
          "text": "您需要先证明这是一句真言。"
        },
        {
          "role": "凯万",
          "text": "证明？什么嘛…那就是办不到咯？真差劲…连亚瑟先生都可以办到！"
        },
        {
          "role": "托萝莎",
          "text": "不要把曲线和别人混为一谈，他可不是会说谎的家伙！"
        },
        {
          "role": "凯万",
          "text": "哼…我还打算等曲线大哥说完，就告诉你们关于刀的事呢，这是一个交易哦！"
        },
        {
          "role": "托罗莎",
          "text": "小鬼，你有没有搞清情况？"
        },
        {
          "role": "托萝莎",
          "text": "如果我们找到了亚瑟先生，你不就可以继续你的抨击爸爸计划了吗？我们可是一边的欸！"
        },
        {
          "role": "凯万",
          "text": "啊！这样说…好像也没错…那…那…"
        },
        {
          "role": "凯万",
          "text": "那就告诉你们好了！刀被我丢去海里了，我把位置标在你们的地图上吧，你们要快点把亚瑟先生找回来！"
        },
        {
          "role": "托萝莎",
          "text": "这样才对嘛，小鬼，还有什么能告诉我们的吗？消息越多，我们越快找到亚瑟先生哦！"
        },
        {
          "role": "凯万",
          "text": "我想想…我去了报社，没看见亚瑟先生，只看见这把刀，因为有个醉鬼大叔靠近我,我一着急就拿着刀吓唬他，只有这些了…"
        },
        {
          "role": "派蒙",
          "text": "看来就是这样了吧。曲线曲线！凯万说的有问题吗？"
        },
        {
          "role": "「曲线」",
          "text": "依鄙人分析，凯万先生没有说谎。不过先前，马德莱娜夫人的瞳孔与呼吸变化有异常。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她在说谎？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「曲线」",
          "text": "鄙人未能确认。但马德莱娜夫人在说出「他爸爸是外派机械工程师」时,数据出现了轻微波动。"
        },
        {
          "role": "凯万",
          "text": "哈哈，不用想，那肯定是骗你们的，我爸爸连发条和发条盒都分不清，还机械工程师…我妈妈是骗人骗习惯了，你们才看不出来的，她天天拿我练手，经验丰富着呢。"
        },
        {
          "role": "凯万",
          "text": "前段时间她还带回来了一只小狗，说是我爸爸送我的礼物。但我偷看了她的信，其实是另一个男人送的啦！"
        },
        {
          "role": "托萝莎",
          "text": "那也没说错吧？新爸爸也是爸爸呀，对不对？小鬼，恭喜你！但愿你的新爸爸不要是个只会吃软饭的酒鬼。"
        },
        {
          "role": "凯万",
          "text": "哼哼…这位姐姐，虽然你讲话难听，但你很坦诚，我宁愿妈妈像你这样…"
        },
        {
          "role": "派蒙",
          "text": "凯万，你别想太多啦。你妈妈还是很维护你的，她是怕你一下知道太多事接受不了。"
        },
        {
          "role": "凯万",
          "text": "我也不想知道啊…就是因为知道的事多了，才会有问题。"
        },
        {
          "role": "托萝莎",
          "text": "大错特错！是因为你知道的还不够多，才会有问题。"
        },
        {
          "role": "凯万",
          "text": "知道的还不够多？"
        },
        {
          "role": "托萝莎",
          "text": "你看，你都还不知道人类是谎话连篇的生物呢，你爸爸，你妈妈，还有你自己都是。"
        },
        {
          "role": "托罗莎",
          "text": "小鬼，这就是问题的答案，等你理解了，你就不会再对谁失望了。你就会从问题小孩变成答案小孩！"
        },
        {
          "role": "凯万",
          "text": "答…答案小孩？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "感觉我也被攻击到了…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "托罗莎",
          "text": "咦？你有反对意见吗？难道…你一次谎都没有说过？"
        },
        {
          "role": "托罗莎",
          "text": "算了，别告诉我你的答案了，至少现在我还挺喜欢你的，先不要打破这个美好印象了。"
        },
        {
          "role": "托罗莎",
          "text": "现在还是快点去找刀比较重要。小鬼，我们走了哦，好好想想我说的，你就会变成答案小孩。"
        },
        {
          "role": "派蒙",
          "text": "凯万，你别听她乱说啦。你听我的，回去和妈妈好好沟通一下吧，她肯定不是因为想骗你才骗你的。"
        },
        {
          "role": "凯万",
          "text": "我知道了，也许我是该回去了…"
        },
        {
          "type": "subtitle",
          "text": "前往凯万丢刀的地方"
        },
        {
          "role": "派蒙",
          "text": "这就是凯万丢刀的地方了吧？我们是不是要下水去找？"
        },
        {
          "role": "托罗莎",
          "text": "我是没问题！不过曲线现在的状况不太适合下水…我得在这里陪着他。"
        },
        {
          "role": "「曲线」",
          "text": "抱歉，给诸位添麻烦了。"
        },
        {
          "role": "派蒙",
          "text": "搞不懂…机器人下水会有什么问题吗？你们两个不会是想偷懒吧？"
        },
        {
          "role": "派蒙",
          "text": "算了，旅行者，还是我们去吧，找到线索要紧。"
        },
        {
          "type": "subtitle",
          "text": "去水下搜寻刀的下落"
        },
        {
          "type": "subtitle",
          "text": "隐藏会话"
        },
        {
          "role": "托罗莎",
          "text": "曲线，今天你感觉还好吗？"
        },
        {
          "role": "「曲线」",
          "text": "主板温度：低于预警线。核心残值：20%。"
        },
        {
          "role": "托罗莎",
          "text": "嗯…跟昨天比，没有减少很多，要保持住！"
        },
        {
          "type": "subtitle",
          "text": "你潜入海中，找到线索。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "刀肯定是被冲到这附近了，我们就在这片区域找一找吧。"
        },
        {
          "type": "subtitle",
          "text": "（第一个点位：海底小径上，任务区域的南侧）",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这里什么也没有…看来应该在别的地方。"
        },
        {
          "type": "subtitle",
          "text": "（第二个点位：海底小径旁，沉船船壳内）",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "这里什么也没有…看来应该在别的地方。"
        },
        {
          "type": "subtitle",
          "text": "（第三个点位：沉船船壳的背面，打破蓝色裂缝的石头）",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "居然在这里！是不是这只蟹蟹把刀带过来了…"
        },
        {
          "type": "subtitle",
          "text": "染有水渍的餐刀   染有水渍的餐刀，看起来是高档的银制品，但不知为何，似乎有些生锈的痕迹。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "太好了，就是这把刀吧？我们快拿回去给他们看看。"
        },
        {
          "type": "subtitle",
          "text": "返回岸上"
        },
        {
          "type": "subtitle",
          "text": "你去找曲线和托罗莎。",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "托罗莎，曲线，我们找到刀啦！给你们看看。"
        },
        {
          "role": "托罗莎",
          "text": "咦？这把刀确实能和底座上的痕迹吻合。不过…这是餐刀吧？为什么餐刀会出现在案发现场？"
        },
        {
          "role": "派蒙",
          "text": "唔…犯人从饭店吃完饭，顺走了一把餐刀…然后丢在了报社门口？"
        },
        {
          "role": "托罗莎",
          "text": "你的推理我给一分，满分一千。"
        },
        {
          "role": "「曲线」",
          "text": "检索到相关信息：一月前，蒸汽鸟报社曾曝光「优雅餐具商会」诈骗案件。"
        },
        {
          "role": "托罗莎",
          "text": "「优雅餐具商会」…啊！我也想起来了，他们的留档证物里，好像有这种类似的餐刀…一定是他们干的！"
        },
        {
          "role": "派蒙",
          "text": "你又开始「一定是他们干的！」了。"
        },
        {
          "role": "托萝莎",
          "text": "干嘛啦，大不了我们回庭内确认一下。今天剩下的时间应该足够了。"
        },
        {
          "role": "派蒙",
          "text": "欸？你们不是不算正式探员吗？可以查看其他的案件吗？"
        },
        {
          "role": "托萝莎",
          "text": "…看在我们已经熟了一点的份上，就告诉你们好了…"
        },
        {
          "role": "托萝莎",
          "text": "其实我是逐影庭的证物管理员啦，查看其他案件的证物当然没问题！"
        },
        {
          "role": "派蒙",
          "text": "证…证物管理员？还有这种岗位吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那曲线…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「曲线」",
          "text": "是的，鄙人是一件证物。"
        },
        {
          "role": "派蒙",
          "text": "哇！证物跑出来查案子啦！"
        },
        {
          "role": "托萝莎",
          "text": "怎么啦？你们连证物都不是，不也在查案子吗？"
        },
        {
          "role": "派蒙",
          "text": "但我记得欧芙主编好像说过…曲线是一个远程操纵的探案机器…"
        },
        {
          "role": "托萝莎",
          "text": "那是她在帮曲线打掩护，她好像也知道曲线的来历…曲线就是一台测谎机器！"
        },
        {
          "role": "派蒙",
          "text": "有点超乎想象了…我们居然一直没听说过这么厉害的机器。"
        },
        {
          "role": "托萝莎",
          "text": "那是因为他一直待在证物管理室，他可是一桩三十年前的案子的关键证物。"
        },
        {
          "role": "派蒙",
          "text": "噫，你们不会是在暗中调查什么三十年前的惊天幕后案件吧？"
        },
        {
          "role": "托萝莎",
          "text": "哪有那么多惊天幕后案件，本探员就是闲得无聊，才带曲线出来放放风。"
        },
        {
          "role": "派蒙",
          "text": "就只是这样吗?"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "曲线，你怎么看？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「曲线」",
          "text": "检测到生理数据异常：托萝莎探员，您说谎了。"
        },
        {
          "role": "托萝莎",
          "text": "哎呀！旅行者！我刚才还在说你老实，你居然钻「莫索协议」的空子！"
        },
        {
          "role": "派蒙",
          "text": "「莫索协议」…这个词好像之前听你们说过，那是什么？"
        },
        {
          "role": "「曲线」",
          "text": "那是鄙人的创造者莫索博士，在鄙人核心内写下的规则，功能为确保测谎结果的真实性。"
        },
        {
          "role": "「曲线」",
          "text": "依照「莫索协议」的逻辑，鄙人需要真实地回应一切询问。"
        },
        {
          "role": "派蒙",
          "text": "就是说…你能测谎，但不能说谎，只要别人问了，你就要回答？"
        },
        {
          "role": "「曲线」",
          "text": "派蒙小姐，判断正确。"
        },
        {
          "role": "派蒙",
          "text": "好厉害的协议！这个莫索博士是枫丹科学院的顶级科学家吧？"
        },
        {
          "role": "托萝莎",
          "text": "是已逝的顶级科学家。他在三十年前就死掉了，所以曲线才变成了证物。"
        },
        {
          "role": "派蒙",
          "text": "死了？！怎么死的？！"
        },
        {
          "role": "「曲线」",
          "text": "检索到相关信息：莫索博士死于为自己抗辩的决斗。他在一场审判中被判有罪。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "为什么被判罪?",
              "dialogues": []
            }
          ]
        },
        {
          "role": "「曲线」",
          "text": "检索到相关信息：三十年前…"
        },
        {
          "role": "托萝莎",
          "text": "停停停！你们的问题太多啦，要是你们不停问，曲线就会不停回答。"
        },
        {
          "role": "托萝莎",
          "text": "现在最要紧的是亚瑟先生，不找到它，欧芙主编会急得吃不下饭的！"
        },
        {
          "role": "派蒙",
          "text": "我觉得…她不会…"
        },
        {
          "role": "托萝莎",
          "text": "总之…总之我要带曲线回去找找关于餐刀的情报了，我们明天一早在沫芒宫见！"
        },
        {
          "role": "派蒙",
          "text": "可我还是很好奇，你就不能满足我一下吗？"
        },
        {
          "role": "托萝莎",
          "text": "明天再满足你！给你准备美味早餐好不好？"
        },
        {
          "role": "派蒙",
          "text": "啊…是美味早餐！这个我也很期待…"
        },
        {
          "role": "托萝莎",
          "text": "那明早见了哦！"
        },
        {
          "role": "派蒙",
