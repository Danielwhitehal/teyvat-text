{
  "quest_id": 79008,
  "chapter_num": null,
  "chapter_title": "夏日赠礼",
  "type": "wq",
  "route": "Summer Gift",
  "stories": [
    {
      "story_id": 79008,
      "title": "夏日赠礼",
      "description": "带来快乐的神秘礼物正在某处静候…",
      "dialogues": [
        {
          "role": "派蒙",
          "text": "应该就是这个了吧！"
        },
        {
          "role": "派蒙",
          "text": "嗯？旁边还有一封信…"
        },
        {
          "role": "派蒙",
          "text": "致有缘来到这里的朋友，"
        },
        {
          "role": "派蒙",
          "text": "你好呀，远方的人。如果你能看到这封信，应该是找到了我留下的羽球。"
        },
        {
          "role": "派蒙",
          "text": "金苹果群岛上有不少跟羽球有关的游戏，我和我的朋友们在这里度过了一个非常快乐的夏天。"
        },
        {
          "role": "派蒙",
          "text": "所以我在这里留下我制作的羽球，但愿偶然发现这个羽球的你也能体验到与我相同的快乐。"
        },
        {
          "role": "派蒙",
          "text": "请尽情享受阳光、海风与夏日游戏吧。"
        },
        {
          "role": "派蒙",
          "text": "——芭芭拉"
        },
        {
          "role": "派蒙",
          "text": "不愧是芭芭拉，托她的福，我们也有羽球啦！走吧，让我们玩个痛快！"
        }
      ]
    }
  ]
}