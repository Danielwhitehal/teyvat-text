{
  "quest_id": 24005,
  "chapter_num": null,
  "chapter_title": "他们的童年·游城记",
  "type": "iq",
  "route": "Their Childhood: City Caper",
  "stories": [
    {
      "story_id": 24005,
      "title": "他们的童年·游城记",
      "description": "在枫丹廷里，你又遇见了奥雷勒，韦吕和洛薇，但他们这次似乎没有玩游戏…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与韦吕对话"
        },
        {
          "role": "韦吕",
          "text": "哥哥，快点快点，走这边啦。那边的大房子我们还没看过。"
        },
        {
          "role": "奥雷勒",
          "text": "走慢点，别又摔着了。洛薇你也是，你爸爸说你身体不好，可不要着凉了。"
        },
        {
          "role": "洛薇",
          "text": "呜哇，你哥哥好啰嗦，和我妈妈一样。"
        },
        {
          "role": "韦吕",
          "text": "我也这么觉得！"
        },
        {
          "role": "奥雷勒",
          "text": "你们两个…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "又见面了。",
              "dialogues": []
            },
            {
              "text": "你们在做什么呢？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "洛薇",
          "text": "大哥哥好！又见面啦，这次我们可没有玩捉迷藏了。"
        },
        {
          "role": "奥雷勒",
          "text": "准确地来说，是刚刚已经玩过了…还被诺尔小姐给训斥了一顿。"
        },
        {
          "role": "洛薇",
          "text": "诺尔姐姐在工作的时候一直那么严肃，总是爱教训人，亏我还请她吃过饼干呢！"
        },
        {
          "role": "洛薇",
          "text": "不过，反正也玩累了，我正想带奥雷勒和韦吕到处逛逛，吃点好吃的呢。"
        },
        {
          "role": "洛薇",
          "text": "大哥哥，你想和我们一起…嗯…那个叫什么来着？"
        },
        {
          "role": "奥雷勒",
          "text": "散步。"
        },
        {
          "role": "洛薇",
          "text": "对，和我们一起散步吧！"
        },
        {
          "role": "韦吕",
          "text": "我们快去那边的广场看看吧，我还想去看看喷泉！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "那就麻烦小姐带路了。",
              "dialogues": []
            },
            {
              "text": "那就麻烦各位带路了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "洛薇",
          "text": "好呀，那我们就…先去那边的广场吧，里面的喷泉确实都很好看呢。"
        },
        {
          "type": "subtitle",
          "text": "前往广场"
        },
        {
          "role": "韦吕",
          "text": "哇…好想进去踩水，或者用喷泉洗个澡？"
        },
        {
          "role": "奥雷勒",
          "text": "这样肯定会挨骂的啦，在外面看看就好了。"
        },
        {
          "role": "韦吕",
          "text": "但是，既然不让人进去玩，那把喷泉做这么大干嘛呀？"
        },
        {
          "role": "韦吕",
          "text": "就算它再好看，如果只能看的话，那也就是一池子普通的水而已，一点意思也没有。"
        },
        {
          "role": "洛薇",
          "text": "这里可不是普通的喷泉啦。不过…爸爸倒是说过其他的普通喷泉，他怎么说来着…"
        },
        {
          "role": "奥雷勒",
          "text": "「枫丹廷市政美化工程最大的作用，是灵活地解决报税问题。」"
        },
        {
          "role": "奥雷勒",
          "text": "今天德勒吕叔叔刚和我讲解过这方面的问题。"
        },
        {
          "role": "洛薇",
          "text": "就连说话的语气，和我爸爸一模一样…怪不得爸爸这么喜欢奥雷勒哥哥，每次都要拿一大堆书去和你聊天。"
        },
        {
          "role": "韦吕",
          "text": "虽然听不懂，但哥哥肯定又在说扫兴的话了。"
        },
        {
          "role": "韦吕",
          "text": "洛薇，我们快去下个地方玩吧，今天你好不容易不用学习了。"
        },
        {
          "role": "洛薇",
          "text": "嗯，我们接下来去看看其他地方吧，我想想…报社应该还开着门，我们去那里吧！"
        },
        {
          "type": "subtitle",
          "text": "前往「蒸汽鸟报」报社"
        },
        {
          "role": "奥雷勒",
          "text": "这里就是「蒸汽鸟报」报社吗，看起来是不是…完全没什么特别的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "很普通的房子。",
              "dialogues": []
            },
            {
              "text": "确实没什么特别的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "韦吕",
          "text": "哇！居然真的有机械鸟！好厉害！"
        },
        {
          "role": "洛薇",
          "text": "厉害吧？爸爸经常带我来这里买报纸。"
        },
        {
          "role": "洛薇",
          "text": "他可喜欢「蒸汽鸟报」了，每天早上都会拿着报纸看个不停。偶尔还会把报纸上的一部分剪下来，贴在一个本子上保存起来。"
        },
        {
          "role": "洛薇",
          "text": "爸爸说这是他所发表的「评论」，有时候他甚至会自己读那些评论给我和妈妈听。"
        },
        {
          "role": "洛薇",
          "text": "我们俩可不喜欢听，一直用「好啊」，「是吗」或者「原来如此」来回答他，但爸爸根本没察觉到，自己读得可开心了。"
        },
        {
          "role": "旅行者",
          "text": "「评论」是什么？"
        },
        {
          "role": "奥雷勒",
          "text": "如果简单来说，「评论」就是从评论家自己的观点出发，对某件事发表一些意见。"
        },
        {
          "role": "奥雷勒",
          "text": "洛薇的父亲，德勒吕叔叔是一位枫丹科学院的科学家。"
        },
        {
          "role": "奥雷勒",
          "text": "同时，也是一位经常在「蒸汽鸟报」上发表「评论」的「评论家」。"
        },
        {
          "role": "洛薇",
          "text": "对呀，爸爸对任何事情都喜欢长篇大论地发表「评论」。"
        },
        {
          "role": "洛薇",
          "text": "有时候说着说着，他就会和想起什么一样，冲回屋里闷头写稿，连饭都不吃，只是一个劲地喝茶。"
        },
        {
          "role": "韦吕",
          "text": "欸…还有这种只用发表意见就能赚钱的职业吗？"
        },
        {
          "role": "奥雷勒",
          "text": "光是发表意见可称不上是「评论家」。如果想要发表一篇值得被认可的评论，首先要遵循几个要素…"
        },
        {
          "role": "洛薇",
          "text": "那个…那个…韦吕！还有大哥哥，你们肚子饿了吗？"
        },
        {
          "role": "洛薇",
          "text": "路易哥哥前几天和我说，他最近会卖泡泡桔味的薯条，我们快去买了尝尝吧，我们请你们！"
        },
        {
          "role": "韦吕",
          "text": "喔…哦！好！哥哥别唠叨了，快走啦！"
        },
        {
          "role": "奥雷勒",
          "text": "你们啊…"
        },
        {
          "type": "subtitle",
          "text": "与路易对话"
        },
        {
          "role": "洛薇",
          "text": "路易哥哥！我要买几份泡泡桔味的薯条！"
        },
        {
          "role": "路易",
          "text": "是洛薇啊，真不好意思，今天港口上的人特别多，我准备的泡泡桔全用光了。"
        },
        {
          "role": "洛薇",
          "text": "我，我都提前好久说过了，我还专门带了朋友过来吃呢…"
        },
        {
          "role": "路易",
          "text": "唉，客人太多，我一下子给忘记了…这里还剩下一些普通的薯条，就不收你们钱了，拿去吃吧。"
        },
        {
          "role": "洛薇",
          "text": "好吧，谢谢路易哥哥…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你只缺泡泡桔吗？",
              "dialogues": []
            },
            {
              "text": "我可以去拿点泡泡桔回来。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "路易",
          "text": "如果真有泡泡桔的话，我倒是可以马上做一批泡泡桔酱出来，其他的调味料也剩下一些…"
        },
        {
          "role": "洛薇",
          "text": "好欸！大哥哥最厉害了！"
        },
        {
          "role": "韦吕",
          "text": "谢谢大哥哥！"
        },
        {
          "role": "奥雷勒",
          "text": "真是不好意思，每次遇见我们的时候，都要麻烦你一阵。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不用这么客气。",
              "dialogues": []
            },
            {
              "text": "可不能扫了兴。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "奥雷勒",
          "text": "好吧…我得向您学习才是，德勒吕叔叔也经常说我太古板了，如果未来也想做评论家的话，职业道路会很艰难…"
        },
        {
          "role": "奥雷勒",
          "text": "咳！不提这些，我会在这里照顾他们的，泡泡桔的事就麻烦您了。"
        },
        {
          "type": "subtitle",
          "text": "将泡泡桔带给路易"
        },
        {
          "role": "路易",
          "text": "你已经把泡泡桔拿回来了吗？"
        },
        {
          "type": "subtitle",
          "text": "将泡泡桔带给路易"
        },
        {
          "role": "路易",
          "text": "这些就足够了，稍等一会啊…"
        },
        {
          "role": "？？？",
          "text": "路易开始制作泡泡桔酱…"
        },
        {
          "role": "路易",
          "text": "行了！刚刚出炉的泡泡桔薯条，这几份不收你们钱，直接吃吧，小心烫！"
        },
        {
          "role": "洛薇",
          "text": "好欸！大哥哥，韦吕还有奥雷勒哥哥，快尝尝吧，可好吃了。"
        },
        {
          "role": "洛薇",
          "text": "对了，奥雷勒哥哥，你可不能告诉我爸爸，不然他又要训我了…"
        },
        {
          "role": "奥雷勒",
          "text": "噗…放心吧，我觉得德勒吕叔叔应该对薯条不感兴趣。"
        },
        {
          "role": "韦吕",
          "text": "哥，那…我呢？"
        },
        {
          "role": "奥雷勒",
          "text": "你也快点吃吧，我的那一份你们分掉就好，我不太喜欢吃这东西。"
        },
        {
          "role": "韦吕",
          "text": "嘿嘿嘿，那我可要开吃了！大哥哥，快尝尝吧。"
        },
        {
          "role": "奥雷勒",
          "text": "对了，等会我还要去买点咖啡带给德勒吕叔叔…"
        },
        {
          "role": "洛薇",
          "text": "等下，这可不行！妈妈已经禁止爸爸喝咖啡好久啦。"
        },
        {
          "role": "洛薇",
          "text": "每次爸爸喝完咖啡之后，都会整夜在屋子里咳嗽个不停，说话的声音也会哑掉。"
        },
        {
          "role": "洛薇",
          "text": "爸爸说这都是为了工作，但有哪份工作会让人难受成这样呀？"
        },
        {
          "role": "奥雷勒",
          "text": "…这就是德勒吕叔叔和我说的，写出优秀「评论」的代价吗？"
        },
        {
          "role": "奥雷勒",
          "text": "评论家这种职业，可真是难做啊…"
        }
      ]
    }
  ]
}