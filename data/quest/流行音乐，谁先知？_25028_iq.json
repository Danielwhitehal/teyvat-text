{
  "quest_id": 25028,
  "chapter_num": null,
  "chapter_title": "流行音乐，谁先知？",
  "type": "iq",
  "route": "Prophets of Pop",
  "stories": [
    {
      "story_id": 25028,
      "title": "流行音乐，谁先知？",
      "description": "在纳塔，你遇见了一位名为米卢·努伊的音乐人。但他似乎遇见了一些麻烦…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与米卢·努伊对话"
        },
        {
          "role": "不耐烦的部族成员",
          "text": "啧，这个唱片听起来也没什么意思，没什么流行元素。"
        },
        {
          "role": "利洛",
          "text": "擅自把人家的唱片拿过来，这样不对。快点还回去吧。"
        },
        {
          "role": "不耐烦的部族成员",
          "text": "我说你啊，跟着那个璃月人工作了一段时间之后，就变得婆婆妈妈的。"
        },
        {
          "role": "不耐烦的部族成员",
          "text": "再说了，这种唱片本来就卖得不好，我这不是在帮他拓展销量吗？"
        },
        {
          "role": "不耐烦的部族成员",
          "text": "哈哈哈哈，你瞧，龙宝宝们也很喜欢这唱片的味道。"
        },
        {
          "role": "利洛",
          "text": "够了。把唱片给我，我会亲自还回去。"
        },
        {
          "role": "不耐烦的部族成员",
          "text": "…你有完没完。怎么？想试试拳头了？"
        },
        {
          "role": "不耐烦的部族成员",
          "text": "好啊，我正愁最近没东西练手，想舒展一下筋骨呢！"
        },
        {
          "type": "subtitle",
          "text": "与米卢·努伊对话"
        },
        {
          "role": "米卢·努伊",
          "text": "好，利洛老兄。咱们今天的目标就是那群家伙了，做好准备！"
        },
        {
          "role": "利洛",
          "text": "没问题，都准备好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "又在忙着做唱片？",
              "dialogues": []
            },
            {
              "text": "你们在取材吗？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "米卢·努伊",
          "text": "您好啊，居然能在这里见到您。没错，咱们正在为新的歌曲取材呢。"
        },
        {
          "role": "米卢·努伊",
          "text": "上次的事情之后，我和利洛老兄仔细谈了谈有关唱片的问题，收获了不少新的灵感。"
        },
        {
          "role": "利洛",
          "text": "您说得太夸张了。我只是建议米卢·努伊先生换一个方法，或者是找其他素材来制作音乐。"
        },
        {
          "role": "利洛",
          "text": "我之前在部族中所听到的音乐，有些甚至把武器的碰撞声、战斗的呐喊声、人奔跑的脚步声加进了歌曲之中。"
        },
        {
          "role": "利洛",
          "text": "这样子做出的歌曲很受欢迎，传播的速度也很快…我想，也许这就是米卢·努伊先生想要的「流行感」。"
        },
        {
          "role": "米卢·努伊",
          "text": "没错！所以我们一直在寻找战士，想要瞧瞧他们是如何战斗的。"
        },
        {
          "role": "旅行者",
          "text": "那你们找到取材对象了吗？"
        },
        {
          "role": "米卢·努伊",
          "text": "找到了！就是前面那几位。我们在部族里打听到，这群人一直在外面寻找对手，实力也很强…"
        },
        {
          "role": "利洛",
          "text": "咳。简单来说，这群人成天在外面惹事，遇见人就上去问「要不要切磋」。"
        },
        {
          "role": "米卢·努伊",
          "text": "只要输给了他们，还会被逼着拿出东西作为输掉的赌注。"
        },
        {
          "role": "米卢·努伊",
          "text": "我也有好几位音乐家朋友被他们劫掠…真是不可原谅！"
        },
        {
          "role": "利洛",
          "text": "没错，部族里的人也快受不了了。想要找人去教训一下他们。"
        },
        {
          "role": "旅行者",
          "text": "听着不像是什么正常人…"
        },
        {
          "role": "米卢·努伊",
          "text": "谁知道他们怎么想的？说真的，我从来都不理解这种人的想法。"
        },
        {
          "role": "米卢·努伊",
          "text": "要是您愿意的话，就和利洛老兄一起去教训他们吧。"
        },
        {
          "role": "米卢·努伊",
          "text": "您的身手我早有见识。如果能看见您施展拳脚，我肯定能找到更多，更好的灵感！"
        },
        {
          "role": "米卢·努伊",
          "text": "但…我请您注意！如果那群家伙手里有唱片的话，您可千万别弄坏了！"
        },
        {
          "role": "米卢·努伊",
          "text": "不然我那些音乐家朋友，一定会再晕过去一次…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "没问题，你看好了。",
              "dialogues": []
            },
            {
              "text": "让你见识一下我的身手。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "米卢·努伊",
          "text": "好啊！哈哈哈，那就太好了，有您帮忙，我一定能做出最优秀的歌曲！"
        },
        {
          "role": "米卢·努伊",
          "text": "好，利洛老兄。咱们今天的目标就是那群家伙了，做好准备！"
        },
        {
          "role": "旅行者",
          "text": "你们还在取材啊…"
        },
        {
          "role": "旅行者",
          "text": "唱片做得怎么样了？"
        },
        {
          "role": "米卢·努伊",
          "text": "这不是旅行者吗？托您和利洛老兄，还有我那几位音乐人朋友的福，我的新唱片马上就要做好了。"
        },
        {
          "role": "米卢·努伊",
          "text": "这份唱片里，融合了战斗声、呐喊声，还有各种来自大自然的声音…绝对是一份独一无二的唱片！"
        },
        {
          "role": "米卢·努伊",
          "text": "而且在取材过程中，我们还顺便帮各位音乐人朋友们取回了许多被「借」走不还的唱片。"
        },
        {
          "role": "米卢·努伊",
          "text": "总而言之，一切顺利。所有事情都在朝着好的方向发展。"
        },
        {
          "role": "米卢·努伊",
          "text": "对了，我们正打算去取回另外一张被「借」走不还的唱片。旅行者，如果你愿意的话，能再帮我们一把吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "交给我吧。",
              "dialogues": [
                {
                  "role": "米卢·努伊",
                  "text": "感谢您！等我把唱片制作完了，一定要把您的名字署在第一位！"
                }
              ]
            },
            {
              "text": "我这也算是帮你制作唱片了…",
              "dialogues": [
                {
                  "role": "米卢·努伊",
                  "text": "那当然！您绝对是我最重要的帮手。等我把唱片制作完了，一定要把您的名字署在第一位！"
                }
              ]
            }
          ]
        },
        {
          "role": "米卢·努伊",
          "text": "利洛老兄嘛…就署在第二位吧。"
        },
        {
          "role": "利洛",
          "text": "我的荣幸。那我们就出发吧，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "教训那些惹事生非的部族成员"
        },
        {
          "role": "米卢·努伊",
          "text": "您把我的唱片拿回来了吗？"
        },
        {
          "role": "旅行者",
          "text": "你的唱片为什么会被它们抢走？"
        },
        {
          "role": "米卢·努伊",
          "text": "这个，说来话长…我本来刚刚做出一首全新的歌曲。主题是歌颂春天和动物之类的…"
        },
        {
          "role": "米卢·努伊",
          "text": "结果帕卡那小子听完之后，伸手就把我的歌又放到了儿童区！"
        },
        {
          "role": "米卢·努伊",
          "text": "还说什么，这种有趣又简洁的曲调，孩子们和龙宝宝们一定会喜欢的…"
        },
        {
          "role": "米卢·努伊",
          "text": "可恶！我做的可是正经的流行乐，不是什么儿童歌曲！"
        },
        {
          "role": "米卢·努伊",
          "text": "我气不过，就带着唱片来这里，想要自己享受一下自己做的音乐。"
        },
        {
          "role": "米卢·努伊",
          "text": "结果…听着听着，一群小鳍游龙就聚集了过来。"
        },
        {
          "role": "米卢·努伊",
          "text": "还没等我反应过来，它们就一下子窜了过去，一口咬起唱片跑掉了！"
        },
        {
          "role": "米卢·努伊",
          "text": "我本来想要追着它们过去。但追到一半，却发现有一群看起来很暴躁的人聚在一起…"
        },
        {
          "role": "米卢·努伊",
          "text": "说不定，就是这群家伙指使小鳍游龙抢走了我的唱片，他们一定在觊觎我的音乐！"
        },
        {
          "role": "米卢·努伊",
          "text": "啊啊啊——不能再说了！冒险家，算我米卢·努伊求求你了，快去把我的唱片拿回来吧！"
        },
        {
          "role": "米卢·努伊",
          "text": "如，如果可以的话…还请您尽量让我的唱片保持完整。不然，我这些天的努力…全都白费了…"
        },
        {
          "type": "subtitle",
          "text": "向米卢·努伊回报"
        },
        {
          "role": "米卢·努伊",
          "text": "很好！二位战斗的英姿真是让人印象深刻！"
        },
        {
          "role": "米卢·努伊",
          "text": "不仅很有力，而且非常有节奏，简直就像是拿着指挥棒在指挥这场战斗啊。"
        },
        {
          "role": "米卢·努伊",
          "text": "最重要的是…唱片也非常完整！感谢您，我的那些朋友们总算能睡个好觉了。"
        },
        {
          "role": "米卢·努伊",
          "text": "咦，等等…节奏？没错，我要找的就是这种节奏感！"
        },
        {
          "role": "米卢·努伊",
          "text": "用这种节奏作为基础旋律…不对，要选用声音更沉的乐器…"
        },
        {
          "role": "米卢·努伊",
          "text": "这些东西给您，请您收下吧！利洛老兄，我们快回部族去，我有灵感了！"
        },
        {
          "role": "米卢·努伊",
          "text": "见鬼，我得把那些节奏记下来…对了，衣服，我要把它们记在衣服上！"
        },
        {
          "role": "米卢·努伊",
          "text": "很好！二位战斗的英姿真是让人印象深刻！"
        },
        {
          "role": "米卢·努伊",
          "text": "不仅很有力，而且非常有节奏，简直就像是拿着指挥棒在指挥这场战斗啊！但是…"
        },
        {
          "role": "米卢·努伊",
          "text": "…那些碎成不知道多少片的唱片。实在是这场演奏中的，不和谐音符。"
        },
        {
          "role": "米卢·努伊",
          "text": "愿大灵保佑我那些倒霉的朋友们…无论如何，我至少能把一部分唱片带回去给他们了。"
        },
        {
          "role": "米卢·努伊",
          "text": "这些东西给您，请您收下吧！利洛老兄，我们回部族去吧。"
        },
        {
          "role": "米卢·努伊",
          "text": "希望我的好朋友们不会晕倒。唉…"
        },
        {
          "type": "subtitle",
          "text": "与米卢·努伊对话"
        },
        {
          "role": "米卢·努伊",
          "text": "完了，完了！我的流行大作…要被吃光了…"
        },
        {
          "role": "米卢·努伊",
          "text": "早知道这样，我还不如让帕卡把它放在儿童歌曲区…"
        },
        {
          "role": "旅行者",
          "text": "发生什么了？"
        },
        {
          "role": "米卢·努伊",
          "text": "你是…等等，旅行者！太好了，你来了！"
        },
        {
          "role": "米卢·努伊",
          "text": "我有重要的事情要委托给你！纳塔的…不对，世界流行音乐的未来！就等着你去拯救了！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你，你慢慢说！",
              "dialogues": []
            },
            {
              "text": "欸？你怎么看出来我擅长唱歌的？",
              "dialogues": [
                {
                  "role": "米卢·努伊",
                  "text": "呃…那个…我很高兴您有这种特长，之后我们也许可以合作…但现在…"
                }
              ]
            }
          ]
        },
        {
          "role": "米卢·努伊",
          "text": "请您快点去拯救我的唱片！不然他们就要被那群小鳍游龙吃掉…或者被那些不懂音乐的家伙毁掉了！"
        },
        {
          "type": "subtitle",
          "text": "拿回米卢·努伊的唱片"
        },
        {
          "role": "米卢·努伊",
          "text": "「流行感」到底是什么呢？哎哟，真难想…"
        },
        {
          "type": "subtitle",
          "text": "拿回米卢·努伊的唱片"
        },
        {
          "type": "subtitle",
          "text": "和冷静的部族成员对话"
        },
        {
          "role": "派蒙",
          "text": "呼啊，还好没弄坏唱片…"
        },
        {
          "role": "利洛",
          "text": "应该是那家伙把我们往那边引的。还好你们的身手高强。"
        },
        {
          "role": "利洛",
          "text": "你们是被米卢·努伊先生拜托来取唱片的吧？我之前看见你们在和他谈话，能猜出你们的来意。"
        },
        {
          "role": "利洛",
          "text": "我们都是「流泉之众」的人。那家伙…之前还算是好人，最近不知道从哪学来了一身坏毛病。"
        },
        {
          "role": "利洛",
          "text": "抱歉，忘了自我介绍。我是利洛，再次替我的…同伴，向您道歉。"
        },
        {
          "role": "利洛",
          "text": "…这谈话场面实在不太讲究。如果是在部族里的话，我至少能请您喝上一杯水。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "作为冒险家。我已经习惯了…",
              "dialogues": [
                {
                  "role": "利洛",
                  "text": "是吗？看您的模样，和刚才的身手，确实也像是一位经验丰富的冒险家。"
                }
              ]
            },
            {
              "text": "你曾经和璃月人一起工作？",
              "dialogues": [
                {
                  "role": "利洛",
                  "text": "是的。我曾经被一位璃月的先生雇佣，陪着他一起进山去探查矿脉。"
                },
                {
                  "role": "利洛",
                  "text": "在和他一起工作的那段时间里，我受益良多。他在离开纳塔时，还送给我了一个璃月的名字，「逸扬」。"
                },
                {
                  "role": "利洛",
                  "text": "据他说，这是代表着「在空中飘逸飞扬」的意思。呃…虽然我是不太明白…"
                }
              ]
            }
          ]
        },
        {
          "role": "利洛",
          "text": "咳。先不说这些，我们先收拾一下周围吧。我先去把唱片装起来，免得又碰坏了…"
        },
        {
          "role": "利洛",
          "text": "我和你们一起去见米卢·努伊先生。必须要向他当面道歉才行。"
        },
        {
          "role": "派蒙",
          "text": "啊…箱子好像被打坏了…上面的唱片也…"
        },
        {
          "role": "利洛",
          "text": "应该是那家伙把我们往那边引的。唉，他到底是从哪学的这一身毛病。"
        },
        {
          "role": "利洛",
          "text": "你们是被米卢·努伊先生拜托来取唱片的吧？我之前看见你们在和他谈话，能猜出你们的来意。"
        },
        {
          "role": "利洛",
          "text": "我们都是「流泉之众」的人。那家伙…之前还算是好人，最近不知道从哪学来了一身坏毛病。"
        },
        {
          "role": "利洛",
          "text": "抱歉，忘了自我介绍。我是利洛，再次替我的…同伴，向您道歉。"
        },
        {
          "role": "利洛",
          "text": "…这谈话场面实在不太讲究。如果是在部族里的话，我至少能请您喝上一杯水。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "作为冒险家。我已经习惯了…",
              "dialogues": [
                {
                  "role": "利洛",
                  "text": "是吗？看您的模样，和刚才的身手，确实也像是一位经验丰富的冒险家。"
                }
              ]
            },
            {
              "text": "你曾经和璃月人一起工作？",
              "dialogues": [
                {
                  "role": "利洛",
                  "text": "是的。我曾经被一位璃月的先生雇佣，陪着他一起进山去探查矿脉。"
                },
                {
                  "role": "利洛",
                  "text": "在和他一起工作的那段时间里，我受益良多。他在离开纳塔时，还送给我了一个璃月的名字，「逸扬」。"
                },
                {
                  "role": "利洛",
                  "text": "据他说，这是代表着「在空中飘逸飞扬」的意思。呃…虽然我是不太明白…"
                }
              ]
            }
          ]
        },
        {
          "role": "利洛",
          "text": "…咳。先不说这些，我们先收拾一下周围吧。我会把唱片碎片搜集好的。"
        },
        {
          "role": "利洛",
          "text": "我和你们一起去见米卢·努伊先生。必须要向他当面道歉才行。"
        },
        {
          "type": "subtitle",
          "text": "向米卢·努伊回报"
        },
        {
          "role": "米卢·努伊",
          "text": "我的唱片！太好了，这些唱片没有损坏…"
