{
  "quest_id": 20051,
  "chapter_num": null,
  "chapter_title": "蒙德城的酒",
  "type": "iq",
  "route": "Wines of Mondstadt",
  "stories": [
    {
      "story_id": 20051,
      "title": "蒙德城的酒",
      "description": "『天使的馈赠』酒馆生意一直很红火，但最近酒保查尔斯却有些发愁…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与查尔斯对话"
        },
        {
          "role": "查尔斯",
          "text": "该不该向迪卢克老爷说呢…"
        },
        {
          "role": "旅行者",
          "text": "发生什么了？"
        },
        {
          "role": "查尔斯",
          "text": "是这样的，这家「天使的馈赠」酒馆是由「晨曦酒庄」出资建立，酒品也都是从「晨曦酒庄」里来的高质量酒品。"
        },
        {
          "role": "查尔斯",
          "text": "虽然蒙德城里的酒馆很多，但是要说第一，那还是只有我们「天使的馈赠」。"
        },
        {
          "role": "查尔斯",
          "text": "每位顾客对于酒的口味都各有需求，最开始店里的酒还能兼顾，但客人越来越多，酒的口味也逐渐照顾不过来了…"
        },
        {
          "role": "查尔斯",
          "text": "我是想向迪卢克老爷说，请酒庄开发一些新口味的酒，免得顾客都流失了。"
        },
        {
          "role": "查尔斯",
          "text": "但就算迪卢克老爷同意了，也还是需要很长时间来开发，而且，也不知道蒙德的人们现在喜欢什么样的酒…"
        },
        {
          "role": "查尔斯",
          "text": "我听说蒙德城里有四个<color=#00E1FFFF>「酒豪」</color>，我在想，不如先听听他们的意见。"
        },
        {
          "role": "查尔斯",
          "text": "旅行者你能帮我去请一位<color=#00E1FFFF>酒豪</color>到店里来吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "我明白了。",
              "dialogues": [
                {
                  "role": "查尔斯",
                  "text": "那就拜托你了，去请一位<color=#00E1FFFF>酒豪</color>来吧。"
                }
              ]
            },
            {
              "text": "直接问我就好。",
              "dialogues": [
                {
                  "role": "查尔斯",
                  "text": "旅行者，你还没有到喝酒的年纪吧。"
                },
                {
                  "role": "查尔斯",
                  "text": "想必对酒也没什么了解，还是听听权威们的意见吧…"
                },
                {
                  "role": "查尔斯",
                  "text": "如果不知道酒豪们在哪，可以去问问宁禄先生，他对酒的热爱是出了名的，有关于酒的事情，他肯定清楚得很。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "向宁禄询问酒豪的信息"
        },
        {
          "role": "昆恩",
          "text": "今天水果的品质…"
        },
        {
          "role": "昆恩",
          "text": "旅行者？找我有什么事吗？"
        },
        {
          "role": "宁禄",
          "text": "优律真是…"
        },
        {
          "role": "宁禄",
          "text": "咦？旅行者，你找我有事吗？"
        },
        {
          "role": "旅行者",
          "text": "关于酒豪…"
        },
        {
          "role": "宁禄",
          "text": "想知道关于酒豪的事？你还没有到喝酒的年纪吧？"
        },
        {
          "role": "宁禄",
          "text": "不过，只是说说故事的话倒是无所谓啦。"
        },
        {
          "role": "宁禄",
          "text": "在这座蒙德城的酒客里，有公认酒量、品味和酒品都上佳的四位「酒豪」。"
        },
        {
          "role": "宁禄",
          "text": "哈哈哈，听了他们的名字之后可不要吓一跳，也许你平时都遇见过他们呢。"
        },
        {
          "role": "宁禄",
          "text": "在蒙德城门口开水果摊的<color=#00E1FFFF>昆恩</color>先生，对于「果酒」十分有心得，所以他对自己水果摊上的水果也格外严格。"
        },
        {
          "role": "宁禄",
          "text": "总在街上闲逛着的<color=#00E1FFFF>玛格丽特</color>小姐，对「蒲公英酒」的理解和其他人都不一样。"
        },
        {
          "role": "宁禄",
          "text": "还有在蒙德城里的<color=#00E1FFFF>杰克</color>，你肯定经常遇见他，他对「啤酒」的热爱没有人能比得上。"
        },
        {
          "role": "宁禄",
          "text": "最后一位则是「金布伦」…也就是「蒸馏酒」的权威，清泉镇的<color=#00E1FFFF>杜拉夫</color>先生，这个倒是不怎么出乎意料，对吧？"
        },
        {
          "role": "宁禄",
          "text": "这些就是蒙德的四位「酒豪」了。怎么样？还有什么想问的？"
        },
        {
          "role": "旅行者",
          "text": "我知道了."
        },
        {
          "role": "宁禄",
          "text": "这就是四位酒豪了。如果要我推荐一个，你不如先去<color=#00E1FFFF>清泉镇</color>找<color=#00E1FFFF>杜拉夫</color>先生，对于酒这个话题，他可是很好说话的。"
        },
        {
          "role": "宁禄",
          "text": "不过，其他的酒豪也都在<color=#00E1FFFF>蒙德城</color>里，具体需要找哪位，你就自己判断一下吧。"
        },
        {
          "role": "玛格丽特",
          "text": "小王子怎么又不见了…"
        },
        {
          "role": "玛格丽特",
          "text": "咦？旅行者，你找我有什么事吗？想要喝酒的话，去酒馆就好了。"
        },
        {
          "role": "旅行者",
          "text": "想请你去调酒…"
        },
        {
          "role": "昆恩",
          "text": "酒豪…喂！不要在大街上说这个啊！"
        },
        {
          "role": "昆恩",
          "text": "对，我是对果酒稍微有点研究，但是突然要我去调酒，我这还要看摊子呢…"
        },
        {
          "role": "旅行者",
          "text": "酒豪…"
        },
        {
          "role": "昆恩",
          "text": "都说了不要在大街上说这个了啊！我怕了你了，好了好了，我等会就去「天使的馈赠」。"
        },
        {
          "role": "昆恩",
          "text": "但这可是你请我去调酒的，材料就交给你去找了。"
        },
        {
          "role": "昆恩",
          "text": "我想想，我的特调…果然还是<color=#00E1FFFF>苹果</color>，找到了之后就去「天使的馈赠」吧，我在那等你。"
        },
        {
          "role": "杜拉夫",
          "text": "猎人们！抓紧了！"
        },
        {
          "role": "杜拉夫",
          "text": "嗯？旅行者，你是来收猎物的吗？"
        },
        {
          "role": "旅行者",
          "text": "想请你去调酒…"
        },
        {
          "role": "玛格丽特",
          "text": "酒豪，这个称号真是…我知道了，想要请我去调酒对吧？"
        },
        {
          "role": "玛格丽特",
          "text": "但是你居然会来找我，「天使的馈赠」和我家的「猫尾酒馆」可是竞争关系啊。"
        },
        {
          "role": "玛格丽特",
          "text": "别紧张，开个玩笑啦，说是竞争关系，但是这座蒙德城里，谁竞争得过有「晨曦酒庄」撑腰的「天使的馈赠」呢？"
        },
        {
          "role": "玛格丽特",
          "text": "去「天使的馈赠」里调酒，说不定还挺有趣的。"
        },
        {
          "role": "玛格丽特",
          "text": "我就先过去了，你帮我搜集些材料吧，我想想…他们的招牌就是「蒲公英酒」…"
        },
        {
          "role": "玛格丽特",
          "text": "决定了，你去帮我搜集点<color=#00E1FFFF>蒲公英</color>回来吧。"
        },
        {
          "role": "玛格丽特",
          "text": "同样是「蒲公英酒」，我家的酒可是不一样的。你找好材料之后，我们「天使的馈赠」见。"
        },
        {
          "role": "杰克",
          "text": "什么时候才能去冒险呢…"
        },
        {
          "role": "杰克",
          "text": "旅行者，你有什么新故事和我说吗？"
        },
        {
          "role": "旅行者",
          "text": "想请你去调酒…"
        },
        {
          "role": "杜拉夫",
          "text": "调酒？哈哈哈，我喝的酒可从来不调。"
        },
        {
          "role": "杜拉夫",
          "text": "只有不掺杂任何杂质，味道最单纯的酒，才是最好喝的酒。"
        },
        {
          "role": "杜拉夫",
          "text": "不过，去指导指导也行，就让你们见识一下，什么叫猎人们喝的酒吧。"
        },
        {
          "role": "杜拉夫",
          "text": "哦对了，去「天使的馈赠」之前，你先去帮我找点<color=#00E1FFFF>树莓</color>来。"
        },
        {
          "role": "杜拉夫",
          "text": "有什么用？到时候你就知道了。"
        },
        {
          "role": "旅行者",
          "text": "想请你去调酒…"
        },
        {
          "role": "杰克",
          "text": "酒…可是我可不会「调酒」，而且，你听说过有人用「啤酒」调酒的吗？"
        },
        {
          "role": "杰克",
          "text": "不过，我倒是知道怎么让啤酒更加好喝。首先，你要有一个愿意和你用力碰杯的朋友…"
        },
        {
          "role": "杰克",
          "text": "啤酒这种酒，和人碰杯之后才最美味，无论怎么调制，都没办法与这种味道相比，所以啤酒是冒险家们的最爱。"
        },
        {
          "role": "杰克",
          "text": "哈哈哈，好了好了，你别露出这种表情，我看你朋友不挺多嘛…"
        },
        {
          "role": "杰克",
          "text": "这样，我们退而求其次，你先帮我去找点<color=#00E1FFFF>甜甜花</color>，然后我们在「天使的馈赠」里面碰头吧。"
        },
        {
          "role": "旅行者",
          "text": "我再想想。"
        },
        {
          "role": "查尔斯",
          "text": "有什么不明白的，再去请教一下也更保险。"
        },
        {
          "role": "查尔斯",
          "text": "众口难调啊…"
        },
        {
          "role": "昆恩",
          "text": "等等，这杯酒不如请旅行者来调吧。我在旁边指导指导就好。"
        },
        {
          "role": "昆恩",
          "text": "这种酒我调了无数次，这味道我自己都喝得不耐烦了。"
        },
        {
          "role": "昆恩",
          "text": "虽然肯定不会差到哪去，但是我是觉得没什么新意。"
        },
        {
          "role": "昆恩",
          "text": "旅行者，你是从来没喝过酒，也没调过酒的，对吧？"
        },
        {
          "role": "昆恩",
          "text": "由你来调酒，说不定会调出什么意外美味的酒呢。"
        },
        {
          "role": "昆恩",
          "text": "我本来要调制一杯「蒙德落日」。「蒙德落日」的基酒是「金布伦」，要用到苹果。"
        },
        {
          "role": "昆恩",
          "text": "首先把这些水果榨汁后加入酒里，先用力摇晃，再充分搅拌，让果汁与酒液充分融合。"
        },
        {
          "role": "昆恩",
          "text": "最后静置一段时间，让果肉屑和一些没有和酒液融合的果汁沉淀下来。"
        },
        {
          "role": "昆恩",
          "text": "从透明的酒杯看进去，果汁如同夕阳的光辉一般垂落在杯底，所以，这杯酒的名字是「蒙德落日」。"
        },
        {
          "role": "昆恩",
          "text": "好了，你快点去试试吧。"
        },
        {
          "role": "玛格丽特",
          "text": "唔…这杯酒，我倒是想让旅行者来调调看呢。"
        },
        {
          "role": "玛格丽特",
          "text": "「蒲公英酒」也不是什么新鲜的酒，就算是我的制作方法特殊，味道也不会变到哪里去。"
        },
        {
          "role": "玛格丽特",
          "text": "毕竟是蒙德的招牌酒，无论味道和口感再怎么变化，它本身都可以说得上是「不可动摇」呢。"
        },
        {
          "role": "玛格丽特",
          "text": "所以，这次调酒就由旅行者来试试看吧，看看你能不能从这种「不可动摇」的酒里另辟蹊径。"
        },
        {
          "role": "玛格丽特",
          "text": "我先和你说说我的特调酒「玛格丽特」的做法吧，唔…算是特制版的蒲公英酒吧。"
        },
        {
          "role": "玛格丽特",
          "text": "「玛格丽特」的基酒是「金布伦」，还有蒲公英种子。"
        },
        {
          "role": "玛格丽特",
          "text": "首先，你要均匀搅拌金布伦酒液，让酒液充分融合，再放入蒲公英种子。"
        },
        {
          "role": "玛格丽特",
          "text": "然后，你要用力摇晃，让金布伦酒液充分接触空气，还有让蒲公英种子清凉的口感和酒液得以融合。"
        },
        {
          "role": "玛格丽特",
          "text": "最后把酒杯静置，让杂质沉淀，蒲公英种子浮起，趁这时候一口气把酒喝下，让自然的清凉冲上舌尖…这可是我的招牌特调哦。"
        },
        {
          "role": "玛格丽特",
          "text": "好了，你自己去试试看吧。"
        },
        {
          "role": "杜拉夫",
          "text": "旅行者，来，我说你做，调一杯酒我看看。"
        },
        {
          "role": "杜拉夫",
          "text": "不要这么一脸茫然，说是调酒，酒有什么好调的？"
        },
        {
          "role": "杜拉夫",
          "text": "最能感受酒味道的喝法，就是原原本本地喝下它！"
        },
        {
          "role": "杜拉夫",
          "text": "唔，但是…这种喝法喝太久，也逐渐没劲了。"
        },
        {
          "role": "杜拉夫",
          "text": "旅行者，你试试看调一调吧，能调出我没喝过的酒就最好了。"
        },
        {
          "role": "杜拉夫",
          "text": "哦…差点忘了，我先给你说说猎人喝酒的方式。"
        },
        {
          "role": "杜拉夫",
          "text": "你有树莓吧，对不？很好，把树莓放在一边吧，先别管它。"
        },
        {
          "role": "杜拉夫",
          "text": "倒一杯金布伦放在一旁，随便去做点什么…总之是一直静置，到你觉得够了的时候。"
        },
        {
          "role": "杜拉夫",
          "text": "然后把处理好的树莓放在杯口，一口气把酒喝下去！"
        },
        {
          "role": "杜拉夫",
          "text": "一定要保证，树莓汁和酒会一起入口。"
        },
        {
          "role": "杜拉夫",
          "text": "哈哈，这么一口下去，无论是面对什么猎物，我都能给它们一记「重击」。"
        },
        {
          "role": "杜拉夫",
          "text": "好了，就这么简单，你赶紧去试试吧。"
        },
        {
          "role": "杰克",
          "text": "旅行者，那么这个任务就交给你了。"
        },
        {
          "role": "杰克",
          "text": "别紧张啦，啤酒是不用调的，最多调整一下制作的方法。"
        },
        {
          "role": "杰克",
          "text": "唔…最能影响啤酒味道的东西？当然是和你一起喝酒的人啊。"
        },
        {
          "role": "杰克",
          "text": "哈哈哈，我们说正经的，最能影响啤酒口感的，当然就是啤酒上的泡沫了。"
        },
        {
          "role": "杰克",
          "text": "可以在打啤酒时溅起，可以在碰杯时摇晃，还可以粘在脸上，逗朋友们哈哈大笑。"
        },
        {
          "role": "杰克",
          "text": "我制作啤酒的方法很简单，只需要啤酒和甜甜花就行了。"
        },
        {
          "role": "杰克",
          "text": "首先，把甜甜花放在杯底，然后去打上一杯啤酒，用力地摇晃，直到泡沫溢出来。"
        },
        {
          "role": "杰克",
          "text": "这时候去吸一口，能够把甜甜花和泡沫一起喝到。"
        },
        {
          "role": "杰克",
          "text": "要是有人和你碰杯的话，这些满溢出来的泡沫就会溅出来，就像「明珠」一样，这也是这杯啤酒的名字。"
        },
        {
          "role": "杰克",
          "text": "怎么样？很简单吧，快去试试看吧。"
        },
        {
          "type": "subtitle",
          "text": "将调酒材料交给查尔斯"
        },
        {
          "role": "昆恩",
          "text": "唔…我要思考一下，到底调什么酒好…"
        },
        {
          "type": "subtitle",
          "text": "与查尔斯对话"
        },
        {
          "role": "玛格丽特",
          "text": "在「天使的馈赠」调我的特调酒，有种微妙的感觉…"
        },
        {
          "role": "查尔斯",
          "text": "既然都这么说了，那么好吧，我会期待你调出的酒的，旅行者。"
        },
        {
          "type": "subtitle",
          "text": "向一位酒豪询问特色酒品"
        },
        {
          "role": "查尔斯",
          "text": "旅行者，你总算回来了。"
        },
        {
          "role": "旅行者",
          "text": "这是调酒的材料。"
        },
        {
          "role": "查尔斯",
          "text": "这些能用来调酒吗？"
        },
        {
          "type": "subtitle",
          "text": "与查尔斯对话，准备开始调酒"
        },
        {
          "role": "昆恩",
          "text": "嗯？有什么事吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于「蒙德落日」…",
              "dialogues": [
                {
                  "role": "昆恩",
                  "text": "「蒙德落日」的基酒是「金布伦」，要用到的材料是苹果。"
                },
                {
                  "role": "昆恩",
                  "text": "首先把这些水果榨汁后加入酒里，先用力摇晃，再充分搅拌，让果汁与酒液充分融合。"
                },
                {
                  "role": "昆恩",
                  "text": "最后静置一段时间，让果肉屑和一些没有和酒液融合的果汁沉淀下来。"
                },
                {
                  "role": "昆恩",
                  "text": "这就是「蒙德落日」的做法，听明白了吗？"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "昆恩",
                  "text": "快去试试吧，有不懂的来问我就是了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与查尔斯对话完成调酒"
        },
        {
          "role": "旅行者",
          "text": "金布伦"
        },
        {
          "role": "查尔斯",
          "text": "金布伦啊，这种辛辣的蒸馏酒算是城里很常见的基酒了，这个选择很谨慎。"
        },
        {
          "role": "旅行者",
          "text": "啤酒"
        },
        {
          "role": "查尔斯",
          "text": "啤酒？很不错，简单又快捷，很多人都喜欢它。但是…啤酒真的用得着调吗？"
        },
        {
          "role": "查尔斯",
          "text": "那么就用它来做基酒吧。"
        },
        {
          "role": "旅行者",
          "text": "加入材料"
        },
        {
          "role": "查尔斯",
          "text": "材料我已经处理好了，就这么加入吧。"
        },
        {
          "role": "旅行者",
          "text": "没什么。"
        },
        {
          "role": "玛格丽特",
          "text": "再见。有空的话，记得去猫尾酒馆坐坐。"
        },
        {
          "role": "查尔斯",
          "text": "这种酒…我从来都没见过，说不定味道不错…"
        },
        {
          "role": "查尔斯",
          "text": "是很不错的一杯酒，我记下了…希望能让客人们满意，谢谢你，旅行者。"
        },
        {
          "role": "旅行者",
          "text": "摇晃"
        },
        {
          "role": "查尔斯",
          "text": "唔…很有力的动作，看来酒液都已经摇匀了。"
        },
        {
          "role": "查尔斯",
          "text": "也许会有客人喜欢这杯酒的，谢谢你，旅行者。"
        },
        {
          "role": "旅行者",
          "text": "搅拌"
        },
        {
          "role": "查尔斯",
          "text": "还算细致的搅拌，嗯…你的动作很不错。"
        },
        {
          "role": "查尔斯",
          "text": "这杯酒…应该不会有人愿意喝下去。但还是辛苦你了，旅行者，我自己再想一想吧。"
        },
        {
          "role": "旅行者",
          "text": "静置"
        },
        {
          "role": "查尔斯",
          "text": "那么就放在这吧，调酒偶尔也要耐心等待。"
        },
        {
          "role": "旅行者",
          "text": "没什么。"
        },
        {
          "role": "杜拉夫",
          "text": "再见。想收猎物的话，就和我说。"
        },
        {
          "role": "查尔斯",
          "text": "唔，这样也许不错…"
        },
        {
          "role": "旅行者",
          "text": "没什么。"
        },
        {
          "role": "杰克",
          "text": "再见。我还以为你有什么冒险故事要讲给我听呢。"
        },
        {
          "type": "subtitle",
          "text": "先询问查尔斯对酒的意见"
        },
        {
          "role": "查尔斯",
          "text": "旅行者，请你…以后尽量控制住自己。"
        },
        {
          "role": "旅行者",
          "text": "我知道了。"
        },
        {
          "role": "查尔斯",
          "text": "这杯酒会得到什么评价呢…"
        },
        {
          "type": "subtitle",
          "text": "将调好的酒给昆恩尝试"
        },
        {
          "role": "查尔斯",
          "text": "看上去不错，唔…真想要尝一尝。"
        },
        {
          "role": "查尔斯",
          "text": "总之…先听听别人对这杯酒的意见吧。"
        },
        {
          "type": "subtitle",
          "text": "将调好的酒给玛格丽特尝试"
        },
        {
          "role": "查尔斯",
          "text": "唔…也许，会有人喜欢这杯酒吧…"
        },
        {
          "role": "查尔斯",
          "text": "总之…先听听别人对这杯酒的意见吧。"
        },
        {
          "type": "subtitle",
          "text": "将调好的酒给杜拉夫尝试"
        },
        {
          "role": "旅行者",
          "text": "我想重新调制。"
        },
        {
          "role": "查尔斯",
          "text": "重新调制吗？倒是没问题。"
        },
        {
          "role": "查尔斯",
          "text": "刚才的材料倒是还有剩下，但是准备新的肯定来不及了。"
        },
        {
          "type": "subtitle",
          "text": "将调好的酒给杰克尝试"
        },
        {
          "type": "subtitle",
          "text": "与查尔斯对话"
        },
        {
          "role": "查尔斯",
          "text": "这次就这样吧，期待你下次调的酒。"
        }
      ]
    }
  ]
}