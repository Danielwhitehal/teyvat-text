  "stories": [
    {
      "story_id": 40145,
      "title": "工艺突破",
      "description": "炼金店铺顺利开业，你和派蒙忙得晕头转向…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "等待至两天后"
        },
        {
          "type": "subtitle",
          "text": "与丽莎对话"
        },
        {
          "type": "subtitle",
          "text": "经过一段时间的试营业，炼金店铺红红火火地开起来了……",
          "narration": true,
          "color": "描述"
        },
        {
          "role": "派蒙",
          "text": "呼，这段时间客人越来越多，我都要忙得头晕了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "生意好起来了…",
              "dialogues": []
            },
            {
              "text": "打响名号了呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "现在这个订单量，光靠我俩果然还是有点勉强吧？"
        },
        {
          "role": "派蒙",
          "text": "是不是该找点新的帮手了…"
        },
        {
          "role": "丽莎",
          "text": "小可爱，你们现在在休息吗？"
        },
        {
          "role": "丽莎",
          "text": "我刚刚看了最近的营收数据，你们果然很有经营天赋，这段时间卖出了不少药剂呢。"
        },
        {
          "role": "派蒙",
          "text": "丽莎你来了！我们正好在商量找帮手的事情呢。"
        },
        {
          "role": "丽莎",
          "text": "哦？是不是现在订单多起来了，你们逐渐忙不过来了？"
        },
        {
          "role": "派蒙",
          "text": "是啊，一开始没想到会有这么多客人…"
        },
        {
          "role": "丽莎",
          "text": "呵呵，我对此倒是有所预料呢。"
        },
        {
          "role": "丽莎",
          "text": "其实在你们忙着开店的同时，我和芙里达讨论了一下提升经营效率的事情。"
        },
        {
          "role": "丽莎",
          "text": "我观察了你们的经营情况，发现不管是炼金工艺，还是培育药材和售卖环节，都有不少的提升空间呢。"
        },
        {
          "role": "派蒙",
          "text": "哇，丽莎居然在悄悄关注这些事情吗？"
        },
        {
          "role": "派蒙",
          "text": "我还以为你一直在偷懒呢…"
        },
        {
          "role": "丽莎",
          "text": "说什么呢，姐姐在关键时候也是很可靠的哦。"
        },
        {
          "role": "派蒙",
          "text": "那你说的提升效率，具体要怎么做呀？"
        },
        {
          "role": "丽莎",
          "text": "这个嘛，具体的升级方案，我已经跟芙里达讨论过了。"
        },
        {
          "role": "丽莎",
          "text": "详细的情况，你们直接去找她聊聊吧。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（丽莎）"
        },
        {
          "role": "丽莎",
          "text": "小可爱有什么疑问吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于提升经营效率。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "我观察了你们的经营情况，发现不管是炼金工艺，还是培育药材和售卖环节，都有不少的提升空间呢。"
                },
                {
                  "role": "丽莎",
                  "text": "具体的升级方式，可以去找那边的芙里达聊聊哦。"
                }
              ]
            },
            {
              "text": "没什么了。",
              "dialogues": [
                {
                  "role": "丽莎",
                  "text": "呵呵，有问题的话要及时跟姐姐说哦。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与芙里达对话"
        },
        {
          "role": "芙里达",
          "text": "旅行者和派蒙，你们好呀！有什么可以帮到你们吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯，我们最近有点人手不足呢，丽莎建议我们提升一下经营效率…"
        },
        {
          "role": "芙里达",
          "text": "哦，这件事呀，丽莎已经跟我详细地探讨过了。"
        },
        {
          "role": "芙里达",
          "text": "目前可以提升的方向有炼金工艺、培育技术和销售规模。"
        },
        {
          "role": "芙里达",
          "text": "效率提升之后，你们经营起来也会更轻松哦。"
        },
        {
          "role": "派蒙",
          "text": "哇，听起来好厉害…我们赶快试试看吧！"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "提升经营效率。",
              "dialogues": [
                {
                  "role": "芙里达",
                  "text": "升级所需的准备已经做好了，请多多尝试！"
                }
              ]
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "芙里达",
                  "text": "祝你们经营顺利！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（芙里达）"
        },
        {
          "role": "芙里达",
          "text": "你们好！芙里达今天也会全力为你们应援的。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "提升经营效率。",
              "dialogues": []
            },
            {
              "text": "物资采购。",
              "dialogues": []
            },
            {
              "text": "再见。",
              "dialogues": [
                {
                  "role": "芙里达",
                  "text": "祝你们经营顺利！"
                }
              ]
            }
          ]
        }
      ],
