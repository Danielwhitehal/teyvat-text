{
  "quest_id": 74149,
  "chapter_num": null,
  "chapter_title": "勒鲁瓦·回光返照",
  "type": "wq",
  "route": "Leroy: Dying Flash",
  "stories": [
    {
      "story_id": 74149,
      "title": "勒鲁瓦·回光返照",
      "description": "你们接到了一份新工作…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "关于新工作…"
        },
        {
          "role": "欧芙",
          "text": "哦？看来对你而言，「人间百态」的委托工作太没挑战性了。还是说最近你手头紧，缺摩拉了呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "摩拉永远不嫌多。",
              "dialogues": [
                {
                  "role": "欧芙",
                  "text": "嗯哼，这种心态倒是常见。"
                }
              ]
            },
            {
              "text": "都有。",
              "dialogues": [
                {
                  "role": "欧芙",
                  "text": "还真是个努力的年轻人啊，也好。"
                }
              ]
            }
          ]
        },
        {
          "role": "欧芙",
          "text": "我这里最不缺的就是委托工作，除了冒险家协会，蒸汽鸟报社大概算是全枫丹廷最大的雇佣信息集散地了。"
        },
        {
          "role": "欧芙",
          "text": "虽然理论上来说，我们没必要承担这样的社会功能。"
        },
        {
          "role": "欧芙",
          "text": "总之，既然你需要摩拉，那我给你推荐一个长期的工作吧。"
        },
        {
          "role": "欧芙",
          "text": "这是勒鲁瓦先生大半年前给我们「人间百态」版块的留言，勒鲁瓦先生我们这条街的人都认识。"
        },
        {
          "role": "欧芙",
          "text": "虽然他年轻的时候名声不太好，不过这些年我倒是没再听说过他有什么不好的传闻。"
        },
        {
          "role": "欧芙",
          "text": "他一辈子独身，唯一的女儿又不在身边，身边没人照顾，确实需要一位钟点工帮忙。"
        },
        {
          "role": "欧芙",
          "text": "据我所知，勒鲁瓦先生不缺钱，所以给的报酬应该不会太低。"
        },
        {
          "role": "欧芙",
          "text": "我想这份工作没什么风险，报酬也不错，不妨考虑看看。"
        },
        {
          "role": "派蒙",
          "text": "只要帮忙做做家务就好了吗？我觉得这份工作好！"
        },
        {
          "role": "旅行者",
          "text": "请给我联络地址。"
        },
        {
          "role": "欧芙",
          "text": "好啊，勒鲁瓦先生的房子你转过两个街角，然后再绕到…啊算了，我给你一张地图吧。"
        },
        {
          "role": "欧芙",
          "text": "记得跟他说是我介绍你们去的哦。"
        },
        {
          "type": "subtitle",
          "text": "寻找勒鲁瓦先生"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "阿托斯的衬衫一千摩拉…莫蒂西娅的项链…啧啧，现在的年轻人真会花钱啊。"
        },
        {
          "role": "旅行者",
          "text": "你好，勒鲁瓦先生。"
        },
        {
          "role": "派蒙",
          "text": "你好呀，我们是从欧芙小姐那里来的。"
        },
        {
          "role": "？？？",
          "text": "你们向勒鲁瓦先生说明了来意。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "哈哈，这都是大半年之前的事情了，欧芙小姐居然还留着我当时的委托记录。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "没错，我的确是有过招募钟点工的想法。人不管年轻的时候多能干，到老了总归需要别人照顾。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "我辛苦了一辈子赚了这么一栋房子，到老了，发现自己孤零零一个人。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "之前我的确是为这件事难受过一阵，好在这会儿我有女儿和女婿来照顾我了。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "这两个好孩子乖巧又相爱，有他们陪伴，我没有什么不满意的了。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "所以说呢，年轻人，我现在已经不需要招募护工了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可惜白跑一趟…",
              "dialogues": []
            },
            {
              "text": "欧芙小姐真是的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "你们也别失望嘛，我最不喜欢看到年轻人失落的样子，年轻人就应该微笑着享受一切美好的东西。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "毕竟你们特意跑了这一趟，又是报社的欧芙小姐推荐你们来的，我这里还是有些活请你们做的。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "正好，我的孩子们出门去了，这会儿不在家，我一个人也忙不动。当然，报酬一样会给。"
        },
        {
          "role": "派蒙",
          "text": "哇，勒鲁瓦先生，你真是个大好人！"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "哈哈哈，这孩子嘴巴真甜。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "去吧，帮我清扫一下门口和屋后的污迹，顺便喂娜娜点鱼肉。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "哦，娜娜是我的猫，就是门口那只。我先代它感谢你们了。"
        },
        {
          "role": "派蒙",
          "text": "听起来很简单嘛，没问题，交给我们吧。"
        },
        {
          "type": "subtitle",
          "text": "完成打工"
        },
        {
          "type": "subtitle",
          "text": "完成打工"
        },
        {
          "type": "subtitle",
          "text": "完成打工"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "忘了我请你们做什么事了吗？小孩子的记性啊，哈哈。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "一件是帮我清理家门口和屋后的污迹，一件是喂我的猫，娜娜，一点鱼肉。"
        },
        {
          "type": "subtitle",
          "text": "向勒鲁瓦先生回报"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "你们忙完了啊？"
        },
        {
          "role": "派蒙",
          "text": "是的，勒鲁瓦先生。那个…"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "想要糖果还是想要报酬当零花钱使啊？"
        },
        {
          "role": "派蒙",
          "text": "都、都想要，嘿嘿。"
        },
        {
          "role": "旅行者",
          "text": "派蒙…"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "贪心的孩子，哈哈哈。没关系，小孩子嘛，就是这样的。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "尤其是像派蒙这样可爱的小姑娘，就应该吃着马卡龙，穿着漂亮的小裙子，住在漂亮的屋子里。"
        },
        {
          "role": "派蒙",
          "text": "我也这么觉得！旅行者，旅行者，我可不可以买…"
        },
        {
          "role": "旅行者",
          "text": "不可以。"
        },
        {
          "role": "派蒙",
          "text": "呜呜，讨厌，旅行者好吝啬。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "派蒙，我们是冒险家…",
              "dialogues": []
            },
            {
              "text": "派蒙，不要忘记旅行的目的…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "但是这跟马卡龙、小裙子还有漂亮的大房子有什么矛盾嘛。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "看你们两个，怎么斗起嘴来了？真是孩子气。不过能像这样斗嘴也很好，证明你们还是孩子。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "其实我的年纪…",
              "dialogues": []
            },
            {
              "text": "这是关系好的证明。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "童年是不长久的，要珍惜啊。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "好了好了，报酬和甜点都给你们，这下别闹了。"
        },
        {
          "role": "派蒙",
          "text": "好耶，有点心！谢谢勒鲁瓦先生！"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "称呼我伯努瓦就可以了，勒鲁瓦是我的姓氏。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "整个枫丹廷现在只有我一个勒鲁瓦了，特地强调姓氏只会让我这个老人寂寞，还是称呼名字吧。"
        },
        {
          "role": "派蒙",
          "text": "勒…伯努瓦的女儿难道不姓勒鲁瓦吗？"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "莫蒂西娅她不是我血缘上的女儿，只是我半年前收养的女儿。不过对我来说，她就和亲生的女儿一样。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "你们乐意的话，明天也可以来，那时候莫蒂西娅和阿托斯就回来了。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "请两个可爱的孩子帮点小忙，吃些点心，我想莫蒂西娅是不会有意见的。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "偶尔也会有其他孩子到我这里来，你们可以一起玩。我很喜欢小孩子，小孩子多，家里热闹。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "以后你们来的时候，如果没有见到我就敲门问问，阿托斯会给你们开门的。"
        },
        {
          "role": "派蒙",
          "text": "那就说好啦，明天我们会再来的哦。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "好，好，正好我也要进屋了。"
        },
        {
          "role": "旅行者",
          "text": "明天再见。"
        },
        {
          "role": "伯努瓦·勒鲁瓦",
          "text": "再会，孩子们。"
        }
      ]
    }
  ]
}