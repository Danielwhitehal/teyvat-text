  "stories": [
    {
      "story_id": 70689,
      "title": "游逸诸地，曾听旅闻",
      "description": "冒险家协会的凯瑟琳似乎有事找你…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与凯瑟琳对话"
        },
        {
          "role": "旅行者",
          "text": "<color=#FFCC33FF>有什么新鲜事吗？</color>"
        },
        {
          "role": "凯瑟琳",
          "text": "旅行者，您来得正好，请留步。我有一件东西需要交给您。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是求援信还是宝藏线索？",
              "dialogues": []
            },
            {
              "text": "是护送委托还是找人委托？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "…您确实已经对本协会的各项事务很熟悉了。但很遗憾，这件东西和以上委托皆无关系。"
        },
        {
          "role": "凯瑟琳",
          "text": "请拿好这本协会制作的新型笔记本。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不是有冒险手册了么？",
              "dialogues": []
            },
            {
              "text": "怎么又发我一本？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "冒险手册的主要作用，是记录各位冒险家完成委托的情况，和一些有关魔物的情报。"
        },
        {
          "role": "凯瑟琳",
          "text": "而这一本笔记本的作用，则是方便各位冒险家记录自己所遇见的奇人异事。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "这样啊…",
              "dialogues": []
            },
            {
              "text": "确实能派上用场。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "凯瑟琳",
          "text": "能帮上您的忙就最好了。那么，本次委托也已经完成了。"
        },
        {
          "role": "凯瑟琳",
          "text": "请继续自由冒险吧，旅行者，向着星辰与深渊。"
        },
