    {
      "story_id": 71703,
      "title": "阿桂的药材需求",
      "description": "璃月港的阿桂需要十朵甜甜花。",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "将十朵甜甜花交给阿桂"
        },
        {
          "role": "旅行者",
          "text": "关于甜甜花…"
        },
        {
          "role": "阿桂",
          "text": "哦，是我的委托，你已经把十朵甜甜花都搜集齐了吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "搜集齐了。",
              "dialogues": []
            },
            {
              "text": "还没有…",
              "dialogues": [
                {
                  "role": "阿桂",
                  "text": "那你搜集齐了之后，就快点拿过来吧。那群孩子们可等不得…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与阿桂对话"
        },
        {
          "role": "阿桂",
          "text": "我看看…这些甜甜花应该够用了。"
        },
        {
          "role": "阿桂",
          "text": "这些东西给你，请收下吧，谢谢你帮我的忙。"
        },
        {
          "role": "阿桂",
          "text": "唉，希望那些孩子们别再闹了…"
        }
      ]
    }
  ]
