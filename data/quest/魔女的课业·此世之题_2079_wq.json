{
  "quest_id": 2079,
  "chapter_num": "",
  "chapter_title": "魔女的课业·此世之题",
  "type": "wq",
  "route": "Witch's Homework: Of This World",
  "stories": [
    {
      "story_id": 10006,
      "title": "行于世间的孩子",
      "description": "在魔女的辞典里，你们发现了一条非比寻常的「口信」，要将它带给杜林…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "前往西风骑士团总部"
        },
        {
          "role": "派蒙",
          "text": "你好呀，杜林，原来你在这里。"
        },
        {
          "role": "杜林",
          "text": "是旅行者和派蒙，你们怎么来了？"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，外面天气这么好，你怎么一个人在这里看书啊？"
        },
        {
          "role": "杜林",
          "text": "是这样的，自从在蒙德和大家「社交」的机会变多了之后，我就经常会把大家说的玩笑话当真。"
        },
        {
          "role": "杜林",
          "text": "比如上次我在花店看到了一束非常美丽的花，告诉店主之后，她说："
        },
        {
          "role": "杜林",
          "text": "「呼呼，你要是看上了这些杂草，那不如拿薄荷和甜甜花跟它一起插个花束好了。」"
        },
        {
          "role": "杜林",
          "text": "结果，等我按照她的说法，把做好的花束拿去给她看的时候，她却露出了非常可怕的表情…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "杜林的眼光很独特呢。",
              "dialogues": []
            },
            {
              "text": "总感觉是她的问题。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "杜林",
          "text": "后来阿贝多说，这是因为我还没办法听懂大家话语中的「言外之意」。"
        },
        {
          "role": "杜林",
          "text": "在学会蒙德的文字后，他就跟我说可以多看看这里的书。"
        },
        {
          "role": "杜林",
          "text": "因为我是从故事书里诞生的，所以应该也能从这些书中学到这个世界的「规则」。"
        },
        {
          "role": "杜林",
          "text": "结果我不知不觉就看到了现在…对了，还没问你们找我有什么事情呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "朋友之间应该经常互相拜访。",
              "dialogues": [
                {
                  "role": "杜林",
                  "text": "原来是这样，这也是「规则」的一部分吧，又学到了。"
                },
                {
                  "role": "派蒙",
                  "text": "虽然是这样没错，不过我们还有正事要说吧。"
                }
              ]
            },
            {
              "text": "我们是为了魔女…",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "是这样的，其实我们带来了莱茵多特要交给你的「口信」。"
        },
        {
          "role": "杜林",
          "text": "居然是…莱茵多特阿姨吗…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怎么了？",
              "dialogues": []
            },
            {
              "text": "别紧张。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "杜林",
          "text": "嗯，我只是有些意外…莱茵多特是妈妈的朋友，也是曾经存在于这个世界的「魔龙」的母亲。"
        },
        {
          "role": "杜林",
          "text": "而我取代了原本属于它的命运。"
        },
        {
          "role": "杜林",
          "text": "所以如果她讨厌我的话…我也不知道该怎么办才好了。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "她应该没那么小气。",
              "dialogues": []
            },
            {
              "text": "有我们在呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "嗯嗯，杜林你别担心，一定不会是什么坏事的。而且还有我们在呢！"
        },
        {
          "role": "杜林",
          "text": "听到你们这样说，我就安心多了。"
        },
        {
          "role": "杜林",
          "text": "既然如此，那我就拆开来看看…"
        },
        {
          "type": "subtitle",
          "text": "与杜林对话"
        },
        {
          "type": "subtitle",
          "text": "你们来到了幻想真境剧诗的剧场…",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "派蒙",
          "text": "呜啊，这是哪里啦？这本辞典又把我们带到什么奇怪的地方来了！"
        },
        {
          "role": "杜林",
          "text": "这里好像有…妈妈的味道。"
        },
        {
          "role": "派蒙",
          "text": "哇，有一只奇怪的猫出现了。"
        },
        {
          "type": "subtitle",
          "text": "未完成任务「旧识与新知」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "已经习惯了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "？？？",
          "text": "咳，受莱茵多特主人所命，我带来了要传达的口信。"
        },
        {
          "role": "？？？",
          "text": "咳咳…"
        },
        {
          "type": "subtitle",
          "text": "已完成任务「旧识与新知」"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "又见面了赛巴斯。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "赛巴斯",
          "text": "咳，受莱茵多特主人所命，我带来了要传达的口信。"
        },
        {
          "role": "赛巴斯",
          "text": "咳咳…"
        },
        {
          "role": "「莱茵多特」",
          "text": "「初次见面，我还不知道应该怎么称呼你呢。既然是M的孩子，就姑且继续叫你小杜林了。」"
        },
        {
          "role": "「莱茵多特」",
          "text": "「虽然看上去身体是小得多了，不过你的血液中所残留的，那孩子留下来的力量可是一点也不小。」"
        },
        {
          "role": "「莱茵多特」",
          "text": "「那孩子是『腐殖层』的不完全造物，因此缺乏能够支配自身力量的『意志』。」"
        },
        {
          "role": "「莱茵多特」",
          "text": "「缺乏『意志』的孩子，却得到了超过自身承受能力的力量，于是便被那力量所扭曲、吞噬，走向命定的结局。」"
        },
        {
          "role": "「莱茵多特」",
          "text": "「阿贝多说，你是超越了腐殖之血，与他相近的同类。但这是他个人意见，还没能得到我的认可。」"
        },
        {
          "role": "「莱茵多特」",
          "text": "「我只会被绝对的事实说服。我需要『看见』。趁着这次机会，M的孩子，就在这里证明给我看吧。」"
        },
        {
          "type": "subtitle",
          "text": "击败出现的魔物"
        },
        {
          "role": "派蒙",
          "text": "呜哇，怎么突然冒出来这么多魔物！"
        },
        {
          "role": "杜林",
          "text": "这就是您所需要的证明吗？莱茵多特阿姨，就请好好看着吧。"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|大型冰史莱姆|2}}{{图标|旋转冰蕈兽|2}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|丘丘水行游侠|1}}",
          "narration": true,
          "color": "灰"
        },
        {
          "role": "杜林",
          "text": "身体里的力量似乎正在逐渐释放出来…"
        },
        {
          "role": "杜林",
          "text": "感觉越来越轻松了呢！"
        },
        {
          "type": "subtitle",
          "text": "击败{{图标|浊水粉碎幻灵|1}}{{图标|浊水喷吐幻灵|1}}",
          "narration": true,
          "color": "灰"
        },
        {
          "type": "subtitle",
          "text": "与赛巴斯对话"
        },
        {
          "role": "「莱茵多特」",
          "text": "「嗯，看来这次阿贝多没有搞错嘛。」"
        },
        {
          "role": "派蒙",
          "text": "喂，下次能不能不要再搞这种突然袭击了啊！"
        },
        {
          "role": "杜林",
          "text": "不过感觉击败它们之后，我好像能更自如地控制身体里的力量了。"
        },
        {
          "role": "「莱茵多特」",
          "text": "「其实，听说了你的事情后，我原本准备了能够封印住你血液中那些黑暗力量的术式，打算趁此机会交给你。」"
        },
        {
          "role": "「莱茵多特」",
          "text": "「当然，使用那个术式会付出相应的代价，它虽然能维持你在提瓦特的存在，但却会削弱你与世界的联系。」"
        },
        {
          "role": "「莱茵多特」",
          "text": "「毕竟你可是M的孩子，要是因为那些没有处理好的力量，而使你步上和那孩子同样的命运，可就太对不起她了。」"
        },
        {
          "role": "「莱茵多特」",
          "text": "「不过现在看来我的担心是多余的。M是个了不起的母亲呢，比我要称职多了。」"
        },
        {
          "role": "「莱茵多特」",
          "text": "「现在，我很期待你能成长到什么样的地步。一个真正融入这个世界的炼金生命，要如何在人类社会找到属于自己的位置。」"
        },
        {
          "role": "「莱茵多特」",
          "text": "「这样的实验我还从没做过，或许从你的身上，我能得到意料之外的『答案』。」"
        },
        {
          "role": "派蒙",
          "text": "唔，不过杜林可不是什么实验，他是我们重要的朋友。"
        },
        {
          "role": "杜林",
          "text": "虽然不是很明白，不过谢谢你的好意，莱茵多特阿姨。"
        },
        {
          "type": "subtitle",
          "text": "未完成任务「旧识与新知」"
        },
        {
          "role": "？？？",
          "text": "咳…以上，莱茵多特主人就说了这些，咳咳。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "你还没自我介绍呢。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对哦，虽然猫会说话这种事已经习惯了，不过能模仿别人说话的猫还是第一次见。"
        },
        {
          "role": "赛巴斯",
          "text": "我吗？这不重要。我叫赛巴斯，只是一位管家罢了。"
        },
        {
          "role": "赛巴斯",
          "text": "你们是阿贝多的朋友，对吧。严格来说，我可是他的「长辈」呢，所以不要把我和普通的猫相提并论。"
        },
        {
          "type": "subtitle",
          "text": "已完成任务「旧识与新知」"
        },
        {
          "role": "赛巴斯",
          "text": "咳…以上，莱茵多特主人就说了这些，咳咳。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "真是辛苦你了。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "虽然已经不是第一次见了，不过能模仿别人说话的猫感觉还挺稀奇的。"
        },
        {
          "role": "赛巴斯",
          "text": "可不要把我和普通的猫相提并论啊。"
        },
        {
          "role": "赛巴斯",
          "text": "况且从生物学上看，我作为炼金生物也不能算是「猫」，就像你和那些飞来飞去的飘浮灵也不能算是同类，不是吗？"
        },
        {
          "role": "派蒙",
          "text": "嗯？什么飘浮灵？总感觉这家伙话里有话…"
        },
        {
          "role": "杜林",
          "text": "我知道，这就是「言外之意」对吧？所以赛巴斯应该是想说…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "别说出来啊，杜林。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "喂，你们什么意思啦！"
        },
        {
          "role": "赛巴斯",
          "text": "哦对，既然莱茵多特主人这样说了，那么这个已经没有用的术式我就销毁了。"
        },
        {
          "role": "赛巴斯",
          "text": "能让莱茵多特主人多虑的机会可不多，小哥我很看好你啊。"
        },
        {
          "role": "赛巴斯",
          "text": "好了，现在我得走了。我还有别的口信要送，说不定我们还会再见面的。"
        },
        {
          "type": "subtitle",
          "text": "解锁额外天赋「魔女的前夜礼·升华赞歌」",
          "narration": true,
          "color": "描述"
        }
      ]
    }
  ]
}