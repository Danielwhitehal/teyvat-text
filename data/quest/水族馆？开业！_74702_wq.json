{
  "quest_id": 74702,
  "chapter_num": null,
  "chapter_title": "水族馆？开业！",
  "type": "wq",
  "route": "Fisharium Open For Business!",
  "stories": [
    {
      "story_id": 74702,
      "title": "水族馆？开业！",
      "description": "桑多涅似乎有事找我们…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与桑多涅对话"
        },
        {
          "role": "「木偶」",
          "text": "哟，最近带回来不少鱼嘛。水族箱也装点得越来越像那么回事了。"
        },
        {
          "role": "派蒙",
          "text": "嘿嘿，我们这方面可是很在行的！"
        },
        {
          "role": "「木偶」",
          "text": "你们好像很有成就感的样子。"
        },
        {
          "role": "派蒙",
          "text": "那当然！不过除了成就感之外，总觉得心中有些…有些…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "可惜？",
              "dialogues": []
            },
            {
              "text": "孤独？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "对对对，差不多就是你那个意思。"
        },
        {
          "role": "「木偶」",
          "text": "这是为什么？"
        },
        {
          "role": "派蒙",
          "text": "我也不知道…总觉得这里还少了什么…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "少了餐厅？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "喂！肯定不是啦！这么漂亮的鱼儿怎么舍得吃呀！"
                }
              ]
            },
            {
              "text": "少了客人？",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦！没错！"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "少的是来欣赏我们成果的客人呀！"
        },
        {
          "role": "「木偶」",
          "text": "你的意思是…想让这个水族馆开业接待游客？"
        },
        {
          "role": "派蒙",
          "text": "你有什么顾虑吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "怕这里变得太热闹？",
              "dialogues": []
            },
            {
              "text": "怕事情变得麻烦？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "如果是这样的话，把经营和宣传工作交给我们就好！桑多涅你安心做自己的事，不用操心这边！"
        },
        {
          "role": "「木偶」",
          "text": "既然你们都这么说了…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "营收额三七分！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "欸…？我们才拿七成吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "七成是人家的。",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哦哦…也对，毕竟这船是桑多涅租的…"
        },
        {
          "role": "「木偶」",
          "text": "得了得了，别把我说得像什么不讲道理的地主。你们出的力，你们拿大头。我可没潘塔罗涅那么抠。"
        },
        {
          "role": "派蒙",
          "text": "那也就是…你同意水族馆营业了？"
        },
        {
          "role": "「木偶」",
          "text": "嗯，随你们倒弄去吧。别吵到我研究就行。"
        },
        {
          "role": "派蒙",
          "text": "好欸！维恩歌莱噗噗水族馆，开业！"
        },
        {
          "role": "「木偶」",
          "text": "原来早就把名字想好了吗…"
        }
      ]
    }
  ]
}