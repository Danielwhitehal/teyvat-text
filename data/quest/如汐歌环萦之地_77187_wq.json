{
  "quest_id": 77187,
  "chapter_num": null,
  "chapter_title": "如汐歌环萦之地",
  "type": "wq",
  "route": "Like a Land Where the Tide's Song Surrounds",
  "stories": [
    {
      "story_id": 77187,
      "title": "如汐歌环萦之地",
      "description": "在你的努力下，汐歌洞窟似乎终于成为了符合沃雅妮莎心意的模样…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与沃雅妮莎对话"
        },
        {
          "role": "沃雅妮莎",
          "text": "…哎呀。看来终于完成了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "多谢了，旅行者。现在，我的「私人练歌房」就算是完全建成了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "有这枚贝壳作为中枢，我的歌声肯定能…传得更远。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你等一会。",
            "不应该是「不会外泄」吗？"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "嘻嘻，瞧你说的，我唱歌这么好听，要是外面的人一点都听不见，那不是可惜了？"
        },
        {
          "role": "沃雅妮莎",
          "text": "再说了，还有好多小动物和迷路的人要循着我的歌声过来，在洞穴里面躲避风雪呢。"
        },
        {
          "role": "沃雅妮莎",
          "text": "要是没了我的歌声，他们要怎么在那么一大片荒凉的雪原里找到庇护所呢？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "小动物就算了…",
            "人应该跳不下来吧…"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "对啊。他们就在那口深井旁边待着呗，反正也能避开风雪。"
        },
        {
          "role": "沃雅妮莎",
          "text": "已经有不少冒险家来过啦，他们还在井旁边点起篝火，架起帐篷…然后自顾自地读一些莫名其妙的童话呢。"
        },
        {
          "role": "沃雅妮莎",
          "text": "哼，童话里说什么，有迷路的水妖藏在雪原上的洞穴里，因为回不了家，所以一直唱着忧郁的歌…"
        },
        {
          "role": "沃雅妮莎",
          "text": "然后就是很俗的那一套，什么哭泣的水妖把冒险家囚禁起来啦，什么整个洞穴底下都是珍珠啦…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            "你是怎么听见的？",
            "也是靠着冰层…？"
          ]
        },
        {
          "role": "沃雅妮莎",
          "text": "没有，那样可听不了这么详细，我是直接跑到那口井底下听的。"
        },
        {
          "role": "沃雅妮莎",
          "text": "那个冒险家以为洞穴里没人，所以和他的同伴聊得很大声，我很轻松就听见了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "然后嘛…我就跑回这里，真的开始唱一首阴森森的歌，那两个冒险家一下子就不说话了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "外面的暴雪还没停下，所以他们也不敢走，就只能听我唱了一晚上的歌…嘻嘻嘻。"
        },
        {
          "role": "沃雅妮莎",
          "text": "可惜，当时这枚贝壳还没修好，不然他们肯定能听得更真切！"
        },
        {
          "role": "旅行者",
          "text": "那他们会立刻逃跑…"
        },
        {
          "role": "沃雅妮莎",
          "text": "没事啦，我会叫住他们的。总不能看着他们往风雪里撞吧。"
        },
        {
          "role": "旅行者",
          "text": "那他们就完全不想走了。"
        },
        {
          "role": "沃雅妮莎",
          "text": "哈哈哈哈，那当然，说不定他们还会庆幸遇上了这么一场暴雪，让他们能有机会听我的单独演唱呢。"
        },
        {
          "role": "沃雅妮莎",
          "text": "哎呀，不说了不说了，我先去试试这枚贝壳的扩音效果。"
        },
        {
          "role": "沃雅妮莎",
          "text": "你先捂住耳朵？我等一下会用我的最大音量来发声。"
        },
        {
          "role": "旅行者",
          "text": "最、最大音量？"
        },
        {
          "role": "沃雅妮莎",
          "text": "嘶————————"
        },
        {
          "role": "沃雅妮莎",
          "text": "♪~"
        },
        {
          "role": "沃雅妮莎",
          "text": "♪~~"
        },
        {
          "role": "沃雅妮莎",
          "text": "♪~~~！！！"
        }
      ]
    }
  ]
}