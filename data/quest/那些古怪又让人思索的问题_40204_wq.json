{
  "quest_id": 40204,
  "chapter_num": null,
  "chapter_title": "那些古怪又让人思索的问题",
  "type": "wq",
  "route": "Those Strange and Intriguing Questions",
  "stories": [
    {
      "story_id": 40204,
      "title": "那些古怪又让人思索的问题",
      "description": "在奥摩斯港，似乎听到了几个教令院的学者正在为什么而争吵，靠近听听究竟发生了什么事吧？",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "靠近争执的学者"
        },
        {
          "type": "subtitle",
          "text": "额外对话（？？？）"
        },
        {
          "role": "'心声'",
          "text": "（唔…到底什么时候，达尔维什前辈才能…）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（？？？）"
        },
        {
          "role": "'心声'",
          "text": "（今晚吃什么好呢…总不能还吃树果吧…）"
        },
        {
          "type": "subtitle",
          "text": "额外对话（？？？）"
        },
        {
          "role": "'心声'",
          "text": "（有这样两位可靠的朋友，可真好啊！）"
        },
        {
          "role": "？？？",
          "text": "阿塔希耶，我忍你很久了…你提交的这些东西，根本就没有能够用得上的！"
        },
        {
          "role": "？？？",
          "text": "你看看你写的报告上都是什么东西…「可能」、「大概」、「差不多」，你就这样让我做数学模型？"
        },
        {
          "role": "阿塔希耶",
          "text": "这个、这个，成立课题的时间有限，更何况我是妙论派的，谁知道对生物产生的影响应该怎么测量…比如、比如蕈兽！"
        },
        {
          "role": "阿塔希耶",
          "text": "总、总不能我把手伸到蕈兽嘴巴前面让它们咬一口，然后记录下来说「咬合力确确实实很惊人」吧！"
        },
        {
          "role": "阿塔希耶",
          "text": "达尔维什，你才是那个生论派的，你来评评理！"
        },
        {
          "role": "达尔维什",
          "text": "哈哈，如果要让我来评理，那我得说，阿塔希耶你的基础课程学得不太行，毕竟大家都知道大部分的蕈兽都没有嘴巴。"
        },
        {
          "role": "？？？",
          "text": "哈！"
        },
        {
          "role": "达尔维什",
          "text": "不过，法德瓦，我们这次也不需要这么严谨的数学模型，我们这次的课题面向的也不是院里的那些老学究…"
        },
        {
          "role": "达尔维什",
          "text": "我们要做的是面向那些孩子的课题…嗯，得有趣才行啊，或许适当的想象也是必要的。"
        },
        {
          "role": "法德瓦",
          "text": "唔…唔，既然前辈你这么说了…"
        },
        {
          "role": "阿塔希耶",
          "text": "喂，法德瓦，你对待达尔维什的态度是不是和对我的态度差得有点太大了…"
        },
        {
          "role": "达尔维什",
          "text": "好了好了，我这边的东西都负责的差不多了，阿塔希耶的结论我也经一遍手好了。"
        },
        {
          "role": "达尔维什",
          "text": "而且，数据也可以在测试以后调整，这就是测试的意义嘛。"
        },
        {
          "role": "法德瓦",
          "text": "啊，不愧是达尔维什前辈…条理清晰，比某个人好太多了。"
        },
        {
          "role": "阿塔希耶",
          "text": "是是，我就不问你嘴里的「某个人」是谁了。"
        },
        {
          "role": "达尔维什",
          "text": "好啦好啦，快去做最后的准备吧！"
        },
        {
          "role": "法德瓦",
          "text": "好、好的！前辈！"
        },
        {
          "role": "阿塔希耶",
          "text": "我也去看看画上的漆彩干了没…"
        },
        {
          "role": "达尔维什",
          "text": "不过说到测试…测试的人员啊，那边的那两位，有没有兴趣。"
        },
        {
          "role": "达尔维什",
          "text": "刚才站在那边看了半天了吧。"
        },
        {
          "role": "派蒙",
          "text": "咦，我们吗？"
        },
        {
          "role": "达尔维什",
          "text": "对对，参与测试，还有大量新鲜水果吃哦，怎么样？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "是新水果品种的测试？",
              "dialogues": [
                {
                  "role": "达尔维什",
                  "text": "不是，嗯…让我想想应该从什么地方说起…"
                }
              ]
            },
            {
              "text": "抱歉，只对吵架感兴趣…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "别这么说嘛，听上去好像是什么路过的怪人一样！"
                },
                {
                  "role": "派蒙",
                  "text": "不如我们先听听他想做的测试是什么样再决定嘛。我对新鲜水果…我对他们的研究课题有点好奇…"
                },
                {
                  "role": "达尔维什",
                  "text": "哎呀，这位白色的小小女士有这样的好奇心，旅途中的运气肯定不会太差的。"
                },
                {
                  "role": "达尔维什",
                  "text": "那就让我为两位解释一下这个课题…应该从什么地方说起呢…"
                }
              ]
            }
          ]
        },
        {
          "role": "达尔维什",
          "text": "不如这样，我不如先问两位一个问题吧…嗯，比如…「会滑铲的伸缩火蕈兽和长鬓虎打架谁厉害」？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "会滑铲的伸缩火草兽吧…",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是嘛，我倒是觉得长鬓虎看上去比较能打呢…长鬓虎的爪子呼呼的…"
                },
                {
                  "role": "派蒙",
                  "text": "唔，怎么会有这么奇怪的问题…"
                }
              ]
            },
            {
              "text": "当然是长鬓虎！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "哦哦！我也觉得长鬓虎比较厉害呢！"
                },
                {
                  "role": "派蒙",
                  "text": "唔，怎么会有这么奇怪的问题…"
                }
              ]
            },
            {
              "text": "会滑铲的长鬓虎最厉害！",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "到底什么是会滑铲的长鬓虎啦！"
                },
                {
                  "role": "派蒙",
                  "text": "唔，是谁问的这么奇怪的问题？"
                }
              ]
            }
          ]
        },
        {
          "role": "达尔维什",
          "text": "嗯…还有呢，「浮游风蕈兽和风史莱姆谁更强」，「镀金旅团和纳塔的龙武士谁比较厉害，海乱鬼呢…」…"
        },
        {
          "role": "达尔维什",
          "text": "都是我们在给孩子们讲学的时候，他们问出口的问题。"
        },
        {
          "role": "派蒙",
          "text": "小小年纪就关注这些比来比去的东西！"
        },
        {
          "role": "达尔维什",
          "text": "哈哈，不过孩子们的好奇心就是讲学教育的起点，他们「想要知道」…所以我们才做了这个…"
        },
        {
          "role": "达尔维什",
          "text": "模仿正经的「推演」做的「伙伴冒险大战记」！让孩子们模拟养成他们的冒险队伍，然后和敌人对战！"
        },
        {
          "role": "达尔维什",
          "text": "阿塔希耶正好在做饮食和生活环境对于魔物的影响的课题，而法德瓦则帮忙建立「模拟养成」的模型。"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "模拟养成？",
              "dialogues": []
            }
          ]
        },
        {
          "role": "达尔维什",
          "text": "嗯，毕竟不能真的让孩子去和蕈兽啊，镀金旅团接触嘛…"
        },
        {
          "role": "达尔维什",
          "text": "怎么样，有空的话就来看看吧，嘿嘿，参与测试的话，也能算作参与课题，这样不断积攒，也能有了不起的学历呢！"
        },
        {
          "role": "派蒙",
          "text": "哦哦，听上去好棒哦…旅行者…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "好哦，派蒙积攒学历当贤者！",
              "dialogues": []
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "哼，可别小看我，我可是很了不起的，以后会更了不起。嗯！我们待会儿就来看看吧！"
        },
        {
          "role": "达尔维什",
          "text": "那就欢迎你们来测试，旅行者，当然了，哈哈，还有了不起的未来贤者派蒙！"
        },
        {
          "role": "达尔维什",
          "text": "嗯，你们想要试试的话就跟我说吧，我还得先跟你们交代下「模拟养成」的规则呢。"
        },
        {
          "type": "subtitle",
          "text": "额外对话（法德瓦）"
        },
        {
          "role": "'心声'",
          "text": "（唔…到底什么时候，达尔维什前辈才能…）"
        },
        {
          "role": "法德瓦",
          "text": "唔…唔…既然是前辈给我的工作，可不能懈怠啊…呀！咦，是参与测试的，怎、怎么了，为什么突然靠那么近…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "关于达尔维什…",
              "dialogues": [
                {
                  "role": "法德瓦",
                  "text": "咦…咦为什么突然问达尔维什前辈的事，你也很好奇吗，嘿…嘿，那也没办法，毕竟达尔维什前辈很可靠嘛…"
                },
                {
                  "role": "法德瓦",
                  "text": "而且，看上去也很喜欢小孩子，鸣…哎呀，真希望你能看看他在给孩子们讲学的样子…啊！不行！不行！"
                },
                {
                  "role": "法德瓦",
                  "text": "给孩子们讲学的达尔维什前辈只能属于我，只能属于我！你不许去看，不许去看哦！"
                },
                {
                  "role": "法德瓦",
                  "text": "…呼呼…呼呼…抱歉，有点激动了。"
                },
                {
                  "role": "法德瓦",
                  "text": "…唉，我就是这样…所以朋友很少，你、你不会也在心里觉得我…我很可笑吧…"
                },
                {
                  "role": "法德瓦",
                  "text": "就算你觉得我可笑也没办法…但是就是这样的我，达尔维什前辈也愿意为我说话！"
                }
              ]
            },
            {
              "text": "关于「伙伴冒险大战记」的测试…",
              "dialogues": [
                {
                  "role": "法德瓦",
                  "text": "哼哼，你是说我负责的「模拟养成」的模型，这都是我经过精密的计算建立的…"
                },
                {
                  "role": "法德瓦",
                  "text": "唔，要不是…要不是叫阿塔希耶的那个家伙给的数字很随便，我一定能更好地完成这个工作…"
                },
                {
                  "role": "法德瓦",
                  "text": "真是的，能、能够和达尔维什前辈一起做课题，那个、那个胖胖的家伙，难道没有意识到是多难得的机会吗！"
                },
                {
                  "role": "法德瓦",
                  "text": "…唉，这样说不太好，他也做了很多事，达尔维什前辈总是说我太苛求别人了，这样可不行。"
                },
                {
                  "role": "法德瓦",
                  "text": "虽然看到他提交的报告还是让人感到火大…"
                }
              ]
            },
            {
              "text": "靠得太近了吗？我这就离开…",
              "dialogues": [
                {
                  "role": "法德瓦",
                  "text": "啊，不是，我不是这个意思…唔，但是，谢谢你、谢谢你…的包涵…"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（阿塔希耶）"
        },
        {
          "role": "'心声'",
          "text": "（今晚吃什么好呢…总不能还吃树果吧…）"
        },
        {
          "role": "阿塔希耶",
          "text": "哦…是想来吃新鲜树果，还是有测试有关的问题想要问我？或者，啊，是想帮我处理树果材料的？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "哪来的那么多树果？",
              "dialogues": [
                {
                  "role": "阿塔希耶",
                  "text": "这就说来话长了…我是妙论派的，这一期的课题选择的是拿树果或果皮纤维做建筑材料的尝试…"
                },
                {
                  "role": "阿塔希耶",
                  "text": "虽然课题很好地完结了…但是用来实验的果树，树果，还剩了好多没法处理，因为是学术用途的植株，也没法直接售卖…"
                },
                {
                  "role": "阿塔希耶",
                  "text": "正在头疼的时候，达尔维什不知道从哪里听到了我的情况，就拉着我来做这个课题了。"
                },
                {
                  "role": "阿塔希耶",
                  "text": "真是解了我的燃眉之急啊！"
                }
              ]
            },
            {
              "text": "关于「伙伴冒险大战记」的测试…",
              "dialogues": [
                {
                  "role": "阿塔希耶",
                  "text": "啊，我这里的活，你们只要帮忙收集树果就够了…啊，你是说帮忙收集树果以后，对测试有什么影响吗？"
                },
                {
                  "role": "阿塔希耶",
                  "text": "其实是这样，这些树果收集起来之后，我会定期喂养圈养起来的小动物，然后总结饮食和环境对生物的影响…"
                },
                {
                  "role": "阿塔希耶",
                  "text": "然后提供数据给法德瓦来建立模型，不过，唉…她要的数据是不是有点太过详实了一点啊…"
                }
              ]
            },
            {
              "text": "关于棋子和地图…",
              "dialogues": [
                {
                  "role": "阿塔希耶",
                  "text": "嗯，那些都是我做的，棋子本体用到了一些树果的果皮，然后也有部分树果通过一些工序可以提取出作为染料的汁液…"
                },
                {
                  "role": "阿塔希耶",
                  "text": "怎么样，看上去还行吧。仔细想想，最近几年一直在画设计图，实际上很少参与施工…"
                },
                {
                  "role": "阿塔希耶",
                  "text": "但看来以前做建筑模型留下的手艺还没完全荒废嘛。"
                }
              ]
            },
            {
              "text": "不，没什么事。",
              "dialogues": [
                {
                  "role": "阿塔希耶",
                  "text": "嗯，如果觉得棋子和地图设计有什么问题，随时可以来找我！"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "额外对话（达尔维什）"
        },
        {
          "role": "'心声'",
          "text": "（有这样两位可靠的朋友，可真好啊！）"
        },
        {
          "type": "subtitle",
          "text": "与达尔维什对话"
        },
        {
          "role": "达尔维什",
          "text": "哦，怎么样，要学习一下「伙伴冒险大战记」的规则吗？"
        },
        {
          "role": "旅行者",
          "text": "嗯，现在开始吧！"
        },
        {
          "role": "达尔维什",
          "text": "好，那么…就让我打开一下教学用的地图和棋盘…"
        },
        {
          "type": "subtitle",
          "text": "正在前往雨林",
          "narration": true,
          "color": "草"
        },
        {
          "role": "达尔维什",
          "text": "现在，开始「伙伴冒险大战记」吧！"
        },
        {
          "role": "达尔维什",
          "text": "首先，冒险中，要靠伙伴棋子战斗…"
        },
        {
          "role": "达尔维什",
          "text": "嗯，这样就能招募到伙伴！"
        },
        {
          "role": "达尔维什",
          "text": "好，现在就让伙伴来参战吧！"
        },
        {
          "role": "达尔维什",
          "text": "唔…不过现在我们的伙伴还不够强…"
        },
        {
          "role": "达尔维什",
          "text": "不过只要凑足三只同样的伙伴…"
        },
        {
          "role": "达尔维什",
          "text": "就能让伙伴升阶，一般可以升到三阶。"
        },
        {
          "role": "达尔维什",
          "text": "除了升阶，也可以给伙伴们穿装备！"
        },
        {
          "role": "达尔维什",
          "text": "要注意装备也有不同种类和强度。"
        },
        {
          "role": "达尔维什",
          "text": "嗯，除此之外，就是「族群特性」了…"
        },
        {
          "role": "达尔维什",
          "text": "相同「族群」的伙伴配合会更默契。"
        },
        {
          "role": "达尔维什",
          "text": "当然了，不需要的伙伴也可以遣散…"
        },
        {
          "role": "达尔维什",
          "text": "战斗开始以后就只能看伙伴们的…"
        },
        {
          "role": "达尔维什",
          "text": "所以要在战斗前好好进行战备哦。"
        },
        {
          "role": "达尔维什",
          "text": "嗯，这就是全部了！"
        },
        {
          "role": "达尔维什",
          "text": "现在，就开始属于你的大冒险吧！"
        },
        {
          "type": "subtitle",
          "text": "额外对话（达尔维什）"
        },
        {
          "role": "'心声'",
          "text": "（有这样两位可靠的朋友，可真好啊！）"
        },
        {
          "role": "达尔维什",
          "text": "怎么样，要来进行「伙伴冒险大战记」的测试吗？"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "重新学习教程…",
              "dialogues": [
                {
                  "role": "达尔维什",
                  "text": "嗯，重新巩固已经学习的知识也是非常重要的事…那么，就让我打开一下教学用的地图和棋盘吧！"
                },
                {
                  "type": "subtitle",
                  "text": "进入教程",
                  "narration": true,
                  "color": "描述"
                }
              ]
            },
            {
              "text": "关于「伙伴冒险大战记」…",
              "dialogues": [
                {
                  "role": "达尔维什",
                  "text": "哦，你是想问为什么产生了这样的想法？首先是因为做跨学科的课题研究本身已经很复杂了，不如做点有意思的。"
                },
                {
                  "role": "达尔维什",
                  "text": "而且如果形式本身得到验证，以后引入更准确的信息和数据，即使是「模拟」出来的情况也能够当实际的战斗环境的参考。"
                },
                {
                  "role": "达尔维什",
                  "text": "对「三十人团」应该也能够有帮助吧…"
                },
                {
                  "role": "达尔维什",
                  "text": "这可不是个玩玩的项目，我还是很认真的哦。"
                }
              ]
            },
            {
              "text": "关于编纂的故事背景…",
              "dialogues": [
                {
                  "role": "达尔维什",
                  "text": "你是说编纂的冒险故事吗…哈哈，我们毕竟是教令院的学者，当然还是拿须弥的故事当原型比较有趣…"
                },
                {
                  "role": "达尔维什",
                  "text": "而且，也有前两天，在院内和一位因论派的学弟聊天得到的灵感，我说说不定能够用到和他谈话里的内容…"
                },
                {
                  "role": "达尔维什",
                  "text": "他就点头说「可以可以可以，到时候有成品了一定要拿来给我看看啊！」"
                },
                {
                  "role": "达尔维什",
                  "text": "真是很有活力的人呢。"
                }
              ]
            },
            {
              "text": "关于阿塔希耶和法德瓦…",
              "dialogues": [
                {
                  "role": "达尔维什",
                  "text": "嗯，阿塔希耶和我是一辈的，法德瓦入学比我们要晚一些…"
                },
                {
                  "role": "达尔维什",
                  "text": "别看阿塔希耶平时毛手毛脚，可一旦进入手工作业的领域，没人比他更可靠啦，你看，这些「模拟养成」用到的棋子和棋盘…"
                },
                {
                  "role": "达尔维什",
                  "text": "说到法德瓦…唉，每次看到她的时候都在和别人争吵数字的细节，不过她不是个脾气坏的人，只是对待数字很认真。"
                },
                {
                  "role": "达尔维什",
                  "text": "大概是因为她每次和人吵起来的时候我都愿意帮她调解…所以我们才能成为朋友吧。"
                }
              ]
            },
            {
              "text": "不，之后再说吧…",
              "dialogues": [
                {
                  "role": "达尔维什",
                  "text": "好吧，好吧。"
                }
              ]
            }
          ]
        }
