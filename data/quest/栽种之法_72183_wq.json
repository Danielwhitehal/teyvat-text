{
  "quest_id": 72183,
  "chapter_num": null,
  "chapter_title": "栽种之法",
  "type": "wq",
  "route": "The Art of Horticulture",
  "stories": [
    {
      "story_id": 72183,
      "title": "栽种之法",
      "description": "在稻妻，你们获得了一袋「鸣草」的种子。但如果想要将它种在「尘歌壶」里，似乎还得先向萍姥姥请教些事情…",
      "dialogues": [
        {
          "type": "subtitle",
          "text": "与斑目百兵卫对话"
        },
        {
          "role": "派蒙",
          "text": "这个是…种子？"
        },
        {
          "role": "斑目百兵卫",
          "text": "这是「鸣草」的种子。"
        },
        {
          "role": "旅行者",
          "text": "你知道这种植物？"
        },
        {
          "role": "斑目百兵卫",
          "text": "唔，算是了解一些吧。我之前见过这种植物，也听人讲过它的奇异之处。"
        },
        {
          "role": "斑目百兵卫",
          "text": "我记得…即使是在无风的情况下，这种植物也会随着雷鸣之声微微振动来着…"
        },
        {
          "role": "旅行者",
          "text": "种出来好看吗？"
        },
        {
          "role": "斑目百兵卫",
          "text": "如果光论外表的话…应该还是挺好看的吧。"
        },
        {
          "role": "斑目百兵卫",
          "text": "阁下是想试种一下「鸣草」吗？但这附近可没有什么合适的土地…"
        },
        {
          "role": "旅行者",
          "text": "我有自己的土地。"
        },
        {
          "role": "斑目百兵卫",
          "text": "是、是这样吗？不愧是阁下…连封地都已经拿到了吗？"
        },
        {
          "role": "斑目百兵卫",
          "text": "那敢问阁下，您的封地是在…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "不在稻妻内。",
              "dialogues": [
                {
                  "role": "斑目百兵卫",
                  "text": "喔！我也听闻过阁下在蒙德和璃月的壮举。"
                },
                {
                  "role": "斑目百兵卫",
                  "text": "那样的壮举，获赐封地也是正常，真不愧是阁下！"
                }
              ]
            },
            {
              "text": "在一盏壶里。",
              "dialogues": [
                {
                  "role": "斑目百兵卫",
                  "text": "一盏…壶里？阁下，您就别和我开玩笑了。"
                },
                {
                  "role": "斑目百兵卫",
                  "text": "我也听闻过阁下在蒙德和璃月的壮举。"
                },
                {
                  "role": "斑目百兵卫",
                  "text": "想必您的封地不是在璃月，就是在蒙德吧。"
                },
                {
                  "role": "斑目百兵卫",
                  "text": "唉，真不愧是阁下…"
                }
              ]
            }
          ]
        },
        {
          "role": "派蒙",
          "text": "喂，你说的「土地」，不会是之前婆婆给我们的「尘歌壶」吧？"
        },
        {
          "role": "派蒙",
          "text": "那里面，真的能种东西吗？婆婆之前也没有说过…"
        },
        {
          "type": "choice",
          "role": "旅行者",
          "options": [
            {
              "text": "回去问问吧。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "那好吧，我们回去问问婆婆好了。"
                }
              ]
            },
            {
              "text": "仙人，是很强的。",
              "dialogues": [
                {
                  "role": "派蒙",
                  "text": "是、是这样吗？不过婆婆确实很强就是了…"
                },
                {
                  "role": "派蒙",
                  "text": "那好吧，我们回去问问婆婆好了。"
                }
              ]
            }
          ]
        },
        {
          "type": "subtitle",
          "text": "与萍姥姥对话"
        },
        {
          "role": "萍姥姥",
          "text": "咦？孩子们，你们是来找我的吗？"
        },
        {
          "role": "旅行者",
          "text": "关于「鸣草」的种子…"
        },
        {
          "role": "萍姥姥",
          "text": "种子…喔，你是想要把这种子，种在「尘歌壶」里吗？"
        },
        {
          "role": "萍姥姥",
          "text": "这倒也不是不行，毕竟那大小也是一片天地。"
        },
        {
          "role": "萍姥姥",
          "text": "只不过，你们今天只拿了这一包种子来，难道，你们就只打算种这一包种子吗？"
        },
        {
          "role": "派蒙",
          "text": "对、对喔！我们都不知道怎么搜集种子…"
        },
        {
          "role": "派蒙",
          "text": "这一包种子种完了之后，我们去哪里找其他的种子呢…"
        },
        {
          "role": "萍姥姥",
          "text": "好了，好了，别着急。我这里正好有一个我很多年前用过的小匣子。"
        },
        {
          "role": "萍姥姥",
          "text": "我之前移栽花卉的时候，都是用这个小匣子装的，装在匣子里的花，能够保存很久。"
        },
        {
          "role": "萍姥姥",
          "text": "而且，把花装在匣子里之后，这匣子还能化出几枚花种…这样，想要种植也很方便。"
        },
        {
          "role": "萍姥姥",
          "text": "虽然这匣子现在有些不太好用了…但至少还留着一些「化种」之能。"
        },
        {
          "role": "萍姥姥",
          "text": "唔…反正我老婆子现在也没怎么用过这匣子了…就把它送给你们吧。"
        },
        {
          "role": "萍姥姥",
          "text": "你们无论是想种些花花草草，还是想种点作物，这匣子应该都能派上些用场。"
        },
        {
          "role": "旅行者",
          "text": "谢谢婆婆！"
        },
        {
          "role": "派蒙",
          "text": "谢谢婆婆！"
        },
        {
          "role": "萍姥姥",
          "text": "呵呵，不用这么客气，快点去试试看吧，但侍弄花草可不是件简单的事，你们可要做好心理准备啊。"
        },
        {
          "role": "派蒙",
          "text": "婆婆果然很强啊…但是在试那个匣子之前，我们还是先回去壶里，试试种一下那个种子吧。"
        },
        {
          "role": "派蒙",
          "text": "唔，真希望这种子能快点长大…"
        }
      ]
    }
  ]
}