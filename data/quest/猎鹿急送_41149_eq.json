{
  "quest_id": 41149,
  "chapter_num": null,
  "chapter_title": "猎鹿急送",
  "type": "eq",
  "route": "Good Hunter Express",
  "stories": [
    {
      "story_id": 41149,
      "title": "猎鹿急送",
      "description": "蒙德城的猎鹿人餐馆里有一份特别订单正等待着派送…",
      "dialogues": [
        {
          "role": "旅行者",
          "text": "还有别的事。"
        },
        {
          "role": "",
          "text": "咦？好吧…那我去找别人帮忙。最近是怎么回事啊，怎么大家突然都开始要求外送餐品了…"
        },
        {
          "role": "旅行者",
          "text": "我这就送过去。"
        },
        {
          "role": "",
          "text": "那就太好了，谢谢你愿意帮忙。"
        },
        {
          "role": "",
          "text": "送的时候记得小心点别被撞到，也别跑得太快。要是烤松饼散了的话，那瓦里特先生肯定不会收下的。"
        },
        {
          "role": "",
          "text": "怎么还没送来，我还有正事要做呢！"
        },
        {
          "role": "旅行者",
          "text": "听说有特别订单…"
        },
        {
          "role": "",
          "text": "对啊，你来得正好。早些时候，瓦里特先生在我们这订了一份庄园烤松饼，钱也已经预付好了。"
        },
        {
          "role": "",
          "text": "然后，他让我们晚些时候把餐送到明冠峡南面的一个地方…"
        },
        {
          "role": "",
          "text": "但不知道为什么，最近要求外送的餐品越来越多，我们的人手都不够了。"
        },
        {
          "role": "",
          "text": "如果你愿意的话，就请帮忙跑一趟吧。"
        },
        {
          "role": "旅行者",
          "text": "这是您订的餐。"
        },
        {
          "role": "",
          "text": "总算送来了，快给我，吃完了我还有正事要做。"
        },
        {
          "role": "",
          "text": "这附近，说不定能找到合适的酿酒材料…"
        }
      ]
    }
  ]
}